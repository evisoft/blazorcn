@* ========================================
   Block: product-card-parking
   Title: Product Card Parking
   Description: Parking spot card with location map, hourly rates, and time selector for parking apps
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideCarCn, LucideCheckCn, LucideClockCn, LucideMapPinCn, LucideNavigationCn, LucideShieldCn, LucideZapCn, ToggleGroupCn, ToggleGroupItemCn
   Source: original/blocks/product-card/product-card-parking.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[140px]">
                <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <BadgeCn Class="absolute top-3 left-3">@_product.Type</BadgeCn>
                @if (_product.HasEVCharging)
                {
                    <BadgeCn Class="absolute top-3 right-3" Variant="BadgeVariant.Secondary">
                        <LucideZapCn Class="mr-1 h-3 w-3" Size="12" />
                        EV Charging
                    </BadgeCn>
                }
                <div class="absolute bottom-3 left-3 flex items-center gap-1 rounded-full bg-background/90 px-2 py-1 text-xs font-medium backdrop-blur-sm">
                    <LucideNavigationCn Class="h-3 w-3" Size="12" />
                    @_product.Distance
                </div>
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold">@_product.Name</h3>
                <div class="mt-1 flex items-center gap-1 text-sm text-muted-foreground">
                    <LucideMapPinCn Class="h-3 w-3" Size="12" />
                    <span>@_product.Address</span>
                </div>

                <div class="mt-3 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideCarCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                        <span class="text-sm">
                            <span class="@($"font-semibold {_availabilityColor}")">@_product.SpotsAvailable</span>
                            <span class="text-muted-foreground"> / @_product.TotalSpots spots</span>
                        </span>
                    </div>
                    <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">$@_product.HourlyRate/hr</BadgeCn>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">SELECT DURATION</p>
                    <ToggleGroupCn Class="grid grid-cols-5 gap-1" @bind-Value="_duration">
                        @foreach (var option in _durationOptions)
                        {
                            <ToggleGroupItemCn Class="text-xs" Value="@option.Value">@option.Label</ToggleGroupItemCn>
                        }
                    </ToggleGroupCn>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">AMENITIES</p>
                    <div class="grid grid-cols-2 gap-1">
                        @foreach (var amenity in _product.Amenities)
                        {
                            <div class="flex items-center gap-1.5 text-xs">
                                <LucideCheckCn Class="h-3 w-3 text-primary" Size="12" />
                                <span>@amenity</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4 flex items-center justify-between rounded-lg border p-3">
                    <div class="flex items-center gap-2">
                        <LucideClockCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                        <div>
                            <p class="text-sm font-medium">@_hours hour@(_hours > 1 ? "s" : "")</p>
                            @if (_useDaily && _hours < 24)
                            {
                                <p class="text-xs text-muted-foreground">Daily max applied</p>
                            }
                        </div>
                    </div>
                    <div class="text-right">
                        <p class="text-xl font-bold tabular-nums">$@_totalPrice.ToString("F2")</p>
                        @if (_hours < 8)
                        {
                            <p class="text-xs text-muted-foreground">Max $@_product.DailyRate/day</p>
                        }
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full" Disabled="@(_product.SpotsAvailable == 0)">
                    <LucideShieldCn Class="mr-2 h-4 w-4" Size="16" />
                    Reserve Spot
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    <LucideNavigationCn Class="mr-2 h-4 w-4" Size="16" />
                    Get Directions
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _duration = "2";

    private int _hours => int.Parse(_duration);
    private bool _useDaily => _hours >= 8;
    private decimal _totalPrice => _useDaily
        ? (_hours >= 24 ? _product.DailyRate : Math.Min(_product.HourlyRate * _hours, _product.DailyRate))
        : _product.HourlyRate * _hours;

    private double _availabilityPercent => (double)_product.SpotsAvailable / _product.TotalSpots * 100;
    private string _availabilityColor => _availabilityPercent > 30 ? "text-primary" : _availabilityPercent > 10 ? "text-amber-600" : "text-destructive";

    private record DurationOption(string Value, string Label);
    private static readonly DurationOption[] _durationOptions =
    {
        new("1", "1 hr"), new("2", "2 hrs"), new("4", "4 hrs"), new("8", "8 hrs"), new("24", "24 hrs"),
    };

    private record Product(string Name, string Address, string Distance, string Type, int HourlyRate, int DailyRate, int SpotsAvailable, int TotalSpots, string[] Amenities, bool HasEVCharging, string Image);

    private static readonly Product _product = new(
        "Central Plaza Garage", "123 Main Street, Downtown", "0.3 mi", "Covered",
        4, 25, 47, 200,
        new[] { "24/7 Access", "Security cameras", "Well lit", "Elevator" },
        true, "https://images.unsplash.com/photo-1506521781263-d8422e82f27a?w=400&q=80"
    );
}
