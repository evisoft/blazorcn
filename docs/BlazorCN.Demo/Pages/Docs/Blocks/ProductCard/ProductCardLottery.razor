@* ========================================
   Block: product-card-lottery
   Title: Product Card Lottery
   Description: Lottery ticket card with number picker, draw countdown, and jackpot display for gaming sites
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideSparklesCn, LucideTicketCn, LucideTimerCn, LucideZapCn, SeparatorCn
   Source: original/blocks/product-card/product-card-lottery.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="border-b p-4 text-center">
                <div class="flex items-center justify-center gap-2">
                    <LucideSparklesCn Class="h-5 w-5 text-primary" Size="20" />
                    <span class="text-sm font-medium text-muted-foreground">ESTIMATED JACKPOT</span>
                </div>
                <p class="mt-1 text-4xl font-bold tracking-tight tabular-nums">@FormatJackpot(_product.Jackpot)</p>
                <p class="text-sm text-muted-foreground">@_product.Name</p>
            </div>

            <CardContentCn Class="p-4">
                <div class="flex items-center justify-center gap-1 text-sm">
                    <LucideTimerCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-muted-foreground">Next draw in</span>
                    <span class="font-medium tabular-nums">2d 5h 0m</span>
                </div>

                <SeparatorCn Class="my-4" />

                <div>
                    <div class="mb-2 flex items-center justify-between">
                        <p class="text-xs font-medium text-muted-foreground">SELECT @_product.NumbersToSelect NUMBERS</p>
                        <BadgeCn Class="text-xs tabular-nums" Variant="BadgeVariant.Outline">@_selectedNumbers.Count/@_product.NumbersToSelect</BadgeCn>
                    </div>

                    <div class="grid grid-cols-7 gap-1">
                        @for (var i = 1; i <= _product.MaxNumber; i++)
                        {
                            var num = i;
                            <button type="button"
                                    class="@($"flex h-8 w-8 items-center justify-center rounded-full text-xs font-medium transition-colors {(_selectedNumbers.Contains(num) ? "bg-primary text-primary-foreground" : "border hover:border-primary hover:text-primary disabled:opacity-50 disabled:hover:border-border disabled:hover:text-foreground")}")"
                                    disabled="@(!_selectedNumbers.Contains(num) && _selectedNumbers.Count >= _product.NumbersToSelect)"
                                    @onclick="@(() => ToggleNumber(num))">
                                @num
                            </button>
                        }
                    </div>

                    <div class="mt-3 flex items-center justify-center gap-2">
                        @for (var i = 0; i < _product.NumbersToSelect; i++)
                        {
                            var idx = i;
                            <div class="@($"flex h-9 w-9 items-center justify-center rounded-full border-2 text-sm font-semibold {(idx < _selectedNumbers.Count ? "border-primary bg-primary/10" : "border-dashed")}")">
                                @(idx < _selectedNumbers.Count ? _selectedNumbers[idx].ToString() : "")
                            </div>
                        }
                    </div>
                </div>

                <ButtonCn Class="mt-3 w-full" @onclick="QuickPick" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    <LucideZapCn Class="mr-2 h-3 w-3" Size="12" />
                    Quick Pick
                </ButtonCn>

                <div class="mt-4 rounded-lg border p-2">
                    <p class="text-xs text-muted-foreground">Last winning numbers</p>
                    <div class="mt-1 flex gap-1">
                        @foreach (var num in _product.LastWinningNumbers)
                        {
                            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-muted text-xs font-medium">@num</span>
                        }
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <div class="flex w-full items-center justify-between text-sm">
                    <span class="text-muted-foreground">Ticket price</span>
                    <span class="font-semibold">$@_product.TicketPrice.ToString("F2")</span>
                </div>
                <ButtonCn Class="w-full" Disabled="@(_selectedNumbers.Count < _product.NumbersToSelect)">
                    <LucideTicketCn Class="mr-2 h-4 w-4" Size="16" />
                    Buy Ticket
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private List<int> _selectedNumbers = new();
    private static readonly Random _random = new();

    private void ToggleNumber(int num)
    {
        if (_selectedNumbers.Contains(num))
            _selectedNumbers.Remove(num);
        else if (_selectedNumbers.Count < _product.NumbersToSelect)
        {
            _selectedNumbers.Add(num);
            _selectedNumbers.Sort();
        }
    }

    private void QuickPick()
    {
        _selectedNumbers.Clear();
        while (_selectedNumbers.Count < _product.NumbersToSelect)
        {
            var num = _random.Next(1, _product.MaxNumber + 1);
            if (!_selectedNumbers.Contains(num))
                _selectedNumbers.Add(num);
        }
        _selectedNumbers.Sort();
    }

    private static string FormatJackpot(long amount)
    {
        if (amount >= 1_000_000_000) return $"${amount / 1_000_000_000.0:F1}B";
        return $"${amount / 1_000_000}M";
    }

    private record Product(string Name, long Jackpot, decimal TicketPrice, int NumbersToSelect, int MaxNumber, int[] LastWinningNumbers);

    private static readonly Product _product = new(
        "Mega Millions", 425_000_000, 2.00m, 6, 49,
        new[] { 7, 14, 21, 35, 42, 49 }
    );
}
