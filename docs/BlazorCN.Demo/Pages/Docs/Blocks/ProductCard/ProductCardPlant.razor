@* ========================================
   Block: product-card-plant
   Title: Product Card Plant
   Description: Plant product card with care requirements and growing conditions for nurseries
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideDropletsCn, LucideHeartCn, LucideLeafCn, LucideRulerCn, LucideShoppingCartCn, LucideSunCn
   Source: original/blocks/product-card/product-card-plant.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[280px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[200px]">
                <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <div class="absolute top-3 left-3 flex gap-1">
                    <BadgeCn>@_product.Difficulty Care</BadgeCn>
                </div>
                @if (_product.PetSafe)
                {
                    <BadgeCn Class="absolute top-3 right-3" Variant="BadgeVariant.Secondary">
                        <LucideHeartCn Class="mr-1 h-3 w-3" Size="12" />
                        Pet Safe
                    </BadgeCn>
                }
                else
                {
                    <BadgeCn Class="absolute top-3 right-3 bg-background/90" Variant="BadgeVariant.Outline">Not Pet Safe</BadgeCn>
                }
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold">@_product.Name</h3>
                <p class="text-sm text-muted-foreground italic">@_product.ScientificName</p>

                <div class="mt-4 space-y-2">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-sm">
                            <LucideSunCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            <span>Light</span>
                        </div>
                        <div class="flex items-center gap-1">
                            @for (var i = 1; i <= 4; i++)
                            {
                                <div class="@($"h-2 w-4 rounded-sm {(i <= _lightBars ? "bg-primary" : "bg-muted")}")"></div>
                            }
                            <span class="ml-2 text-xs text-muted-foreground">@_product.Light</span>
                        </div>
                    </div>

                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-sm">
                            <LucideDropletsCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            <span>Water</span>
                        </div>
                        <div class="flex items-center gap-1">
                            @for (var i = 1; i <= 3; i++)
                            {
                                <div class="@($"h-2 w-4 rounded-sm {(i <= _waterBars ? "bg-primary" : "bg-muted")}")"></div>
                            }
                            <span class="ml-2 text-xs text-muted-foreground">@_product.Water</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 flex items-center gap-4 text-sm text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideRulerCn Class="h-3 w-3" Size="12" />
                        <span>Grows to @_product.MatureSize</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideLeafCn Class="h-3 w-3" Size="12" />
                        <span>@_product.PotSize</span>
                    </div>
                </div>

                <div class="mt-4 flex items-center justify-between">
                    <span class="text-2xl font-bold tabular-nums">$@_product.Price</span>
                    @if (_product.InStock)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary">In Stock</BadgeCn>
                    }
                    else
                    {
                        <BadgeCn Variant="BadgeVariant.Outline">Sold Out</BadgeCn>
                    }
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full" Disabled="@(!_product.InStock)">
                    <LucideShoppingCartCn Class="mr-2 h-4 w-4" Size="16" />
                    Add to Cart
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private int _lightBars => _product.Light switch
    {
        "Low" => 1, "Medium" => 2, "Bright indirect" => 3, "Direct sun" => 4, _ => 2
    };

    private int _waterBars => _product.Water switch
    {
        "Low" => 1, "Moderate" => 2, "Frequent" => 3, _ => 2
    };

    private record Product(string Name, string ScientificName, int Price, string Image, string Difficulty, string Light, string Water, bool PetSafe, string MatureSize, string PotSize, bool InStock);

    private static readonly Product _product = new(
        "Monstera Deliciosa", "Swiss Cheese Plant", 45,
        "https://images.unsplash.com/photo-1614594975525-e45190c55d0b?w=400&q=80",
        "Easy", "Bright indirect", "Moderate", false, "6-8 ft", "6\" pot", false
    );
}
