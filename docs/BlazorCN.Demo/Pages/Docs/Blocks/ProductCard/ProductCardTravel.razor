@* ========================================
   Block: product-card-travel
   Title: Product Card Travel
   Description: Travel package product card with departure info and testimonial for booking sites
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, CardCn, CardContentCn, LucideCalendarCn, LucideCheckCn, LucideMapPinCn, LucideStarCn, LucideUsersCn
   Source: original/blocks/product-card/product-card-travel.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[340px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <BadgeCn Class="absolute top-3 left-3">
                    <LucideMapPinCn Class="mr-1 h-3 w-3" Size="12" />
                    @_product.Location
                </BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold">@_product.Name</h3>

                <div class="mt-1 flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideCalendarCn Class="h-3 w-3" Size="12" />
                    <span>@_product.DepartureDate</span>
                    <span>•</span>
                    <span>@_product.Duration</span>
                </div>

                <p class="mt-2 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                <div class="mt-3 grid grid-cols-2 gap-1">
                    @foreach (var feature in _product.Features)
                    {
                        <div class="flex items-center gap-1.5 text-xs">
                            <LucideCheckCn Class="h-3 w-3 text-primary" Size="12" />
                            <span>@feature</span>
                        </div>
                    }
                </div>

                <div class="mt-4 rounded-lg border p-3">
                    <div class="flex items-start gap-2">
                        <AvatarCn Class="h-8 w-8">
                            <AvatarImageCn Src="@_product.Testimonial.Avatar" />
                            <AvatarFallbackCn>@_product.Testimonial.Name[0]</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="flex-1">
                            <div class="flex items-center gap-1">
                                @for (int i = 0; i < _product.Testimonial.Rating; i++)
                                {
                                    <LucideStarCn Class="h-3 w-3 fill-primary text-primary" Size="12" />
                                }
                            </div>
                            <p class="mt-1 text-xs text-muted-foreground line-clamp-2">"@_product.Testimonial.Text"</p>
                            <p class="mt-1 text-xs font-medium">— @_product.Testimonial.Name</p>
                        </div>
                    </div>
                </div>

                <div class="mt-4 flex items-center justify-between">
                    <div>
                        <p class="text-xs text-muted-foreground">per person</p>
                        <p class="text-xl font-bold tabular-nums">$@_product.Price</p>
                    </div>
                    @if (_product.SpotsLeft <= 5)
                    {
                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideUsersCn Class="h-3 w-3" Size="12" />
                            <span>Only @_product.SpotsLeft spots left</span>
                        </div>
                    }
                </div>

                <div class="mt-4 flex gap-2">
                    <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline">Details</ButtonCn>
                    <ButtonCn Class="flex-1">Book Now</ButtonCn>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private record TestimonialData(string Name, string Avatar, int Rating, string Text);
    private record Product(string Name, string Description, int Price, string Image, string Location, string DepartureDate, string Duration, int SpotsLeft, string[] Features, TestimonialData Testimonial);

    private static readonly Product _product = new(
        "Tropical Paradise Getaway",
        "All-inclusive beach resort with activities for all ages and premium dining experiences.",
        1299,
        "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?w=400&q=80",
        "Maldives", "Mar 15, 2025", "7 days / 6 nights", 4,
        new[] { "All meals included", "Airport transfers", "Snorkeling tours", "Spa credit" },
        new TestimonialData("Sarah M.", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80", 5, "Best vacation we've ever had! The resort exceeded all expectations.")
    );
}
