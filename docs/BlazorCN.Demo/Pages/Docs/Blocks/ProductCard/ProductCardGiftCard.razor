@* ========================================
   Block: product-card-gift-card
   Title: Product Card Gift Card
   Description: Gift card product card with denomination selector and delivery options for stores
   Dependencies: ButtonCn, CardCn, CardContentCn, InputCn, LabelCn, LucideGiftCn, LucideMailCn, LucidePackageCn, LucideSparklesCn, ToggleGroupCn, ToggleGroupItemCn
   Source: original/blocks/product-card/product-card-gift-card.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[340px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative flex h-[160px] items-center justify-center bg-gradient-to-br from-primary/10 via-primary/5 to-transparent">
                <div class="rounded-xl border bg-background p-6 shadow-lg">
                    <div class="flex items-center gap-2">
                        <LucideGiftCn Class="h-6 w-6 text-primary" Size="24" />
                        <span class="text-lg font-semibold">Gift Card</span>
                    </div>
                    <p class="mt-2 text-2xl font-bold tabular-nums">$@_finalAmount.ToString("F2")</p>
                </div>
                <LucideSparklesCn Class="absolute top-4 right-4 h-5 w-5 text-primary/40" Size="20" />
                <LucideSparklesCn Class="absolute bottom-4 left-4 h-4 w-4 text-primary/30" Size="16" />
            </div>

            <CardContentCn Class="p-4">
                <div>
                    <LabelCn Class="text-xs font-medium text-muted-foreground">SELECT AMOUNT</LabelCn>
                    <div class="mt-2 grid grid-cols-3 gap-2">
                        @foreach (var amount in _denominations)
                        {
                            <ButtonCn Class="tabular-nums"
                                      @onclick="@(() => { _selectedAmount = amount; _isCustom = false; })"
                                      Size="ButtonSize.Sm"
                                      Variant="@(!_isCustom && _selectedAmount == amount ? ButtonVariant.Default : ButtonVariant.Outline)">
                                $@amount
                            </ButtonCn>
                        }
                    </div>

                    <div class="mt-3">
                        <ButtonCn Class="w-full"
                                  @onclick="@(() => _isCustom = true)"
                                  Size="ButtonSize.Sm"
                                  Variant="@(_isCustom ? ButtonVariant.Default : ButtonVariant.Outline)">
                            Custom Amount
                        </ButtonCn>
                        @if (_isCustom)
                        {
                            <div class="mt-2 relative">
                                <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground">$</span>
                                <InputCn Class="pl-7 tabular-nums" Type="number" @bind-Value="_customAmount" Placeholder="Enter amount" />
                                <p class="mt-1 text-xs text-muted-foreground">Min $10 &bull; Max $500</p>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <LabelCn Class="text-xs font-medium text-muted-foreground">DELIVERY METHOD</LabelCn>
                    <ToggleGroupCn Class="mt-2 grid grid-cols-2 gap-2" @bind-Value="_deliveryMethod">
                        <ToggleGroupItemCn Class="flex-col h-auto py-3 gap-1" Value="email">
                            <LucideMailCn Class="h-4 w-4" Size="16" />
                            <span class="text-xs">Email</span>
                            <span class="text-xs text-muted-foreground">Instant</span>
                        </ToggleGroupItemCn>
                        <ToggleGroupItemCn Class="flex-col h-auto py-3 gap-1" Value="physical">
                            <LucidePackageCn Class="h-4 w-4" Size="16" />
                            <span class="text-xs">Physical</span>
                            <span class="text-xs text-muted-foreground">3-5 days</span>
                        </ToggleGroupItemCn>
                    </ToggleGroupCn>
                </div>

                <ButtonCn Class="mt-4 w-full" Disabled="@(_finalAmount < 10)">
                    <LucideGiftCn Class="mr-2 h-4 w-4" Size="16" />
                    Purchase Gift Card
                </ButtonCn>

                <p class="mt-2 text-center text-xs text-muted-foreground">
                    Never expires &bull; No fees
                </p>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private static readonly int[] _denominations = { 25, 50, 75, 100, 150, 200 };

    private int _selectedAmount = 50;
    private bool _isCustom;
    private string _customAmount = "";
    private string _deliveryMethod = "email";

    private decimal _finalAmount => _isCustom
        ? (decimal.TryParse(_customAmount, out var val) ? val : 0m)
        : _selectedAmount;
}
