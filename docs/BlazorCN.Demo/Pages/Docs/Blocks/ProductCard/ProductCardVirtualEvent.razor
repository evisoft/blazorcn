@* ========================================
   Block: product-card-virtual-event
   Title: Product Card Virtual Event
   Description: Virtual event ticket card with timezone converter, platform badge, and calendar sync
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LabelCn, RadioGroupCn, RadioGroupItemCn, SeparatorCn, LucideCalendarCn, LucideCalendarPlusCn, LucideClockCn, LucideGlobeCn, LucideMonitorCn, LucideRadioCn, LucideUsersCn, LucideVideoCn
   Source: original/blocks/product-card/product-card-virtual-event.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[360px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[140px]">
                <img alt="@_product.Title" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                <div class="absolute top-3 left-3 flex gap-2">
                    <BadgeCn>@_product.Category</BadgeCn>
                    @if (_product.IsLive)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1">
                            <LucideRadioCn Class="h-3 w-3 animate-pulse" Size="12" />
                            Live
                        </BadgeCn>
                    }
                </div>
                <div class="absolute bottom-3 left-3 right-3">
                    <h3 class="font-semibold text-white line-clamp-2">@_product.Title</h3>
                </div>
            </div>

            <CardContentCn Class="p-4">
                <div class="flex flex-wrap gap-x-4 gap-y-1 text-sm">
                    <div class="flex items-center gap-1.5 text-muted-foreground">
                        <LucideCalendarCn Class="h-4 w-4" Size="16" />
                        <span>@_product.Date</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-muted-foreground">
                        <LucideClockCn Class="h-4 w-4" Size="16" />
                        <span>@_product.Time @_product.Timezone</span>
                    </div>
                </div>
                <div class="mt-1 flex flex-wrap gap-x-4 gap-y-1 text-sm">
                    <div class="flex items-center gap-1.5 text-muted-foreground">
                        <LucideGlobeCn Class="h-4 w-4" Size="16" />
                        <span>@_product.Duration</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-muted-foreground">
                        <LucideVideoCn Class="h-4 w-4" Size="16" />
                        <span>@_product.Platform</span>
                    </div>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">SPEAKERS</p>
                    <div class="flex items-center gap-3">
                        <div class="flex -space-x-2">
                            @foreach (var speaker in _product.Speakers)
                            {
                                <AvatarCn Class="h-8 w-8 border-2 border-background">
                                    <AvatarImageCn Src="@speaker.Avatar" />
                                    <AvatarFallbackCn>@speaker.Name[0]</AvatarFallbackCn>
                                </AvatarCn>
                            }
                        </div>
                        <div class="text-sm">
                            <p class="font-medium">@string.Join(", ", _product.Speakers.Select(s => s.Name.Split(' ')[0]))</p>
                            <p class="text-xs text-muted-foreground">+@_product.Speakers.Length speakers</p>
                        </div>
                    </div>
                </div>

                <div class="mt-3 flex items-center gap-2">
                    <LucideUsersCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-sm">
                        <span class="font-medium">@_product.Attendees.ToString("N0")</span>
                        <span class="text-muted-foreground"> registered</span>
                    </span>
                    @if (SpotsLeft < 100)
                    {
                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs text-destructive">@SpotsLeft spots left</BadgeCn>
                    }
                </div>

                <SeparatorCn Class="my-4" />

                <div>
                    <LabelCn Class="text-xs font-medium text-muted-foreground">SELECT TICKET</LabelCn>
                    <RadioGroupCn Class="mt-2 space-y-2" Value="@_selectedTier" ValueChanged="@(v => _selectedTier = v)">
                        @foreach (var t in _product.Tiers)
                        {
                            var tier = t;
                            <LabelCn Class="@($"flex cursor-pointer items-start justify-between rounded-lg border p-3 transition-colors hover:bg-muted/50 {(_selectedTier == tier.Id ? "border-primary bg-muted/50" : "")}")" For="@tier.Id">
                                <div class="flex items-start gap-3">
                                    <RadioGroupItemCn Class="mt-0.5" Id="@tier.Id" Value="@tier.Id" />
                                    <div>
                                        <p class="font-medium">@tier.Name</p>
                                        <p class="text-xs text-muted-foreground">
                                            @string.Join(" • ", tier.Features.Take(2))@(tier.Features.Length > 2 ? $" +{tier.Features.Length - 2} more" : "")
                                        </p>
                                    </div>
                                </div>
                                <p class="font-semibold tabular-nums">@(tier.Price == 0 ? "Free" : $"${tier.Price}")</p>
                            </LabelCn>
                        }
                    </RadioGroupCn>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full" Disabled="@(SpotsLeft == 0)">
                    <LucideMonitorCn Class="mr-2 h-4 w-4" Size="16" />
                    @(CurrentTier.Price == 0 ? "Register Free" : $"Register - ${CurrentTier.Price}")
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    <LucideCalendarPlusCn Class="mr-2 h-4 w-4" Size="16" />
                    Add to Calendar
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _selectedTier = "standard";

    private record Speaker(string Name, string Role, string Avatar);
    private record TicketTier(string Id, string Name, int Price, string[] Features);
    private record Product(string Title, string Category, string Image, bool IsLive, string Date, string Time, string Timezone, string Duration, string Platform, Speaker[] Speakers, int Attendees, int MaxAttendees, TicketTier[] Tiers);

    private static readonly Product _product = new(
        "Design Systems at Scale: Building for the Future", "Design Conference",
        "https://images.unsplash.com/photo-1540575467063-178a50c2df87?w=400&q=80",
        true, "January 18, 2025", "10:00 AM", "PST", "3 hours", "Zoom Webinar",
        new[] {
            new Speaker("Sarah Chen", "Design Lead, Figma", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80"),
            new Speaker("Marcus Johnson", "VP Design, Stripe", "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&q=80"),
            new Speaker("Elena Rodriguez", "Design Systems, Airbnb", "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=100&q=80")
        },
        847, 1000,
        new[] {
            new TicketTier("free", "Free", 0, new[] { "Live access", "Q&A participation" }),
            new TicketTier("standard", "Standard", 49, new[] { "Live access", "Q&A participation", "Recording access", "Slides PDF" }),
            new TicketTier("vip", "VIP", 149, new[] { "Live access", "Q&A participation", "Recording access", "Slides PDF", "1-on-1 speaker session", "Certificate" })
        }
    );

    private TicketTier CurrentTier => _product.Tiers.FirstOrDefault(t => t.Id == _selectedTier) ?? _product.Tiers[1];
    private int SpotsLeft => _product.MaxAttendees - _product.Attendees;
}
