@* ========================================
   Block: product-card-pet
   Title: Product Card Pet
   Description: Pet product card with pet type filters and weight-based sizing for pet stores
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideCheckCn, LucideHeartCn, LucideShoppingCartCn, ToggleGroupCn, ToggleGroupItemCn
   Source: original/blocks/product-card/product-card-pet.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <div class="absolute top-3 left-3 flex gap-1">
                    @foreach (var type in _product.PetTypes)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary">@type</BadgeCn>
                    }
                </div>
                <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="absolute top-3 right-3 rounded-full bg-background/90" @onclick="@(() => _isFavorite = !_isFavorite)">
                    <LucideHeartCn Class="@($"h-4 w-4 {(_isFavorite ? "fill-primary text-primary" : "")}")" Size="16" />
                </ButtonCn>
            </div>

            <CardContentCn Class="p-4">
                <p class="text-xs font-medium text-muted-foreground">@_product.Brand</p>
                <h3 class="font-semibold leading-tight">@_product.Name</h3>

                <p class="mt-2 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                <div class="mt-3 grid grid-cols-2 gap-1">
                    @foreach (var benefit in _product.Benefits)
                    {
                        <div class="flex items-center gap-1.5 text-xs">
                            <LucideCheckCn Class="h-3 w-3 text-primary" Size="12" />
                            <span>@benefit</span>
                        </div>
                    }
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">SELECT SIZE</p>
                    <ToggleGroupCn Class="grid grid-cols-3 gap-1" @bind-Value="_selectedSize">
                        @foreach (var size in _product.Sizes)
                        {
                            <ToggleGroupItemCn Class="flex-col h-auto py-2 text-xs" Value="@size.Id">
                                <span class="font-medium">@size.Weight</span>
                                <span class="text-muted-foreground">$@size.Price</span>
                            </ToggleGroupItemCn>
                        }
                    </ToggleGroupCn>
                </div>

                <div class="mt-4 flex items-baseline justify-between">
                    <span class="text-2xl font-bold tabular-nums">$@_currentSize.Price.ToString("F2")</span>
                    <span class="text-sm text-muted-foreground">@_currentSize.Weight bag</span>
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideShoppingCartCn Class="mr-2 h-4 w-4" Size="16" />
                    Add to Cart
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _selectedSize = "medium";
    private bool _isFavorite;

    private SizeOption _currentSize => _product.Sizes.FirstOrDefault(s => s.Id == _selectedSize) ?? _product.Sizes[1];

    private record SizeOption(string Id, string Weight, decimal Price);
    private record Product(string Name, string Brand, string Description, string Image, decimal Rating, string[] PetTypes, string[] Benefits, List<SizeOption> Sizes);

    private static readonly Product _product = new(
        "Premium Grain-Free Kibble", "Healthy Paws",
        "High-protein formula with real chicken as the first ingredient. Supports healthy digestion and shiny coat.",
        "https://images.unsplash.com/photo-1589924691995-400dc9ecc119?w=400&q=80",
        4.8m, new[] { "Dogs" },
        new[] { "Grain-free formula", "Real chicken #1", "Omega fatty acids", "No artificial colors" },
        new()
        {
            new("small", "5 lb", 24.99m),
            new("medium", "15 lb", 54.99m),
            new("large", "30 lb", 89.99m),
        }
    );
}
