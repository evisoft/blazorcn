@* ========================================
   Block: product-card-book
   Title: Product Card Book
   Description: Book product card with author, ratings, and format options for bookstores
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideBookCn, LucideBookOpenCn, LucideShoppingCartCn, LucideStarCn, LucideTabletCn, ToggleGroupCn, ToggleGroupItemCn
   Source: original/blocks/product-card/product-card-book.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[280px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[200px] p-4">
                <img alt="@_product.Title" class="mx-auto h-full w-auto rounded object-cover shadow-lg" height="400" src="@_product.Image" width="400" />
                <BadgeCn Class="absolute top-3 left-3">@_product.Category</BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold leading-tight">@_product.Title</h3>
                <p class="mt-1 text-sm text-muted-foreground">by @_product.Author</p>

                <div class="mt-2 flex items-center gap-1">
                    <LucideStarCn Class="h-4 w-4 fill-primary text-primary" Size="16" />
                    <span class="text-sm font-medium">@_product.Rating</span>
                    <span class="text-sm text-muted-foreground">(@_product.ReviewCount.ToString("N0") reviews)</span>
                </div>

                <p class="mt-2 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                    <span>@_product.Pages pages</span>
                    <span>&bull;</span>
                    <span>@_product.PublishDate</span>
                </div>

                @* Format selector *@
                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">FORMAT</p>
                    <ToggleGroupCn Class="grid grid-cols-3 gap-1" Type="ToggleGroupType.Single" @bind-Value="_selectedFormat">
                        @foreach (var format in _product.Formats)
                        {
                            <ToggleGroupItemCn Class="flex-col h-auto py-2 text-xs gap-1" Value="@format.Id">
                                @format.Icon
                                <span>@format.Name</span>
                            </ToggleGroupItemCn>
                        }
                    </ToggleGroupCn>
                </div>

                <div class="mt-4 flex items-baseline justify-between">
                    <span class="text-2xl font-bold tabular-nums">$@_currentFormat.Price.ToString("F2")</span>
                    <span class="text-sm text-muted-foreground">@_currentFormat.Name</span>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideShoppingCartCn Class="mr-2 h-4 w-4" Size="16" />
                    Add to Cart
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    Read Sample
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _selectedFormat = "paperback";
    private Format _currentFormat => _product.Formats.FirstOrDefault(f => f.Id == _selectedFormat) ?? _product.Formats[1];

    private record Format(string Id, string Name, decimal Price, RenderFragment Icon);
    private record Product(string Title, string Author, string Image, double Rating, int ReviewCount, string Category, int Pages, string PublishDate, string Description, List<Format> Formats);

    private Product _product => new(
        "The Design of Everyday Things",
        "Don Norman",
        "https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=400&q=80",
        4.6, 2847, "Design", 368, "2013",
        "A powerful primer on how\u2014and why\u2014some products satisfy customers while others only frustrate them.",
        new()
        {
            new("hardcover", "Hardcover", 29.99m, (RenderFragment)(@<LucideBookCn Class="h-4 w-4" Size="16" />)),
            new("paperback", "Paperback", 18.99m, (RenderFragment)(@<LucideBookOpenCn Class="h-4 w-4" Size="16" />)),
            new("ebook", "eBook", 12.99m, (RenderFragment)(@<LucideTabletCn Class="h-4 w-4" Size="16" />)),
        }
    );
}
