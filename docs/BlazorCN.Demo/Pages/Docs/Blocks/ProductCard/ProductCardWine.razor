@* ========================================
   Block: product-card-wine
   Title: Product Card Wine
   Description: Wine product card with tasting notes, pairing suggestions, and ratings for wine shops
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideGrapeCn, LucideMapPinCn, LucideShoppingCartCn, LucideStarCn, LucideWineCn
   Source: original/blocks/product-card/product-card-wine.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[280px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[200px] p-4">
                <img alt="@_product.Name" class="mx-auto h-full w-auto object-contain" height="400" src="@_product.Image" width="400" />
                <BadgeCn Class="absolute top-3 left-3">@_product.Vintage</BadgeCn>
                <div class="absolute top-3 right-3 flex items-center gap-1 rounded-full bg-background/90 px-2 py-1">
                    <LucideStarCn Class="h-3 w-3 fill-primary text-primary" Size="12" />
                    <span class="text-xs font-medium">@_product.Rating</span>
                </div>
            </div>

            <CardContentCn Class="p-4">
                <p class="text-xs font-medium text-muted-foreground">@_product.Winery</p>
                <h3 class="font-semibold leading-tight">@_product.Name</h3>

                <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideMapPinCn Class="h-3 w-3" Size="12" />
                        <span>@_product.Region, @_product.Country</span>
                    </div>
                    <span>•</span>
                    <div class="flex items-center gap-1">
                        <LucideGrapeCn Class="h-3 w-3" Size="12" />
                        <span>@_product.Varietal</span>
                    </div>
                </div>

                <div class="mt-3">
                    <p class="mb-1.5 text-xs font-medium text-muted-foreground">TASTING NOTES</p>
                    <div class="flex flex-wrap gap-1">
                        @foreach (var note in _product.TastingNotes)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@note</BadgeCn>
                        }
                    </div>
                </div>

                <div class="mt-3">
                    <p class="mb-1.5 text-xs font-medium text-muted-foreground">PAIRS WITH</p>
                    <p class="text-xs text-muted-foreground">@string.Join(" • ", _product.Pairings)</p>
                </div>

                <div class="mt-4 flex items-center justify-between">
                    <div>
                        <span class="text-2xl font-bold tabular-nums">$@_product.Price</span>
                        <p class="text-xs text-muted-foreground">@_product.AlcoholContent ABV</p>
                    </div>
                    <div class="text-right">
                        <p class="text-xs font-medium">@_product.Rating pts</p>
                        <p class="text-xs text-muted-foreground">@_product.RatingSource</p>
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideShoppingCartCn Class="mr-2 h-4 w-4" Size="16" />
                    Add to Cart
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    <LucideWineCn Class="mr-2 h-4 w-4" Size="16" />
                    Add to Cellar
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Product(string Name, string Winery, int Vintage, string Region, string Country, int Price, string Image, int Rating, string RatingSource, string Varietal, string[] TastingNotes, string[] Pairings, string AlcoholContent);

    private static readonly Product _product = new(
        "Reserve Cabernet Sauvignon", "Château Margaux", 2019,
        "Bordeaux", "France", 189,
        "https://images.unsplash.com/photo-1510812431401-41d2bd2722f3?w=400&q=80",
        95, "Wine Spectator", "Cabernet Sauvignon",
        new[] { "Blackcurrant", "Cedar", "Tobacco", "Vanilla" },
        new[] { "Ribeye steak", "Aged cheese", "Dark chocolate" },
        "14.5%"
    );
}
