@* ========================================
   Block: product-card-food
   Title: Product Card Food
   Description: Food delivery product card with nutrition info and customization for food apps
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, CheckboxCn, LucideClockCn, LucideFlameCn, LucideLeafCn, LucidePlusCn
   Source: original/blocks/product-card/product-card-food.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <div class="absolute top-3 left-3 flex gap-1">
                    @if (_product.IsVegetarian)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary">
                            <LucideLeafCn Class="mr-1 h-3 w-3" Size="12" />
                            Vegetarian
                        </BadgeCn>
                    }
                    @if (_product.IsSpicy)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary">
                            <LucideFlameCn Class="mr-1 h-3 w-3" Size="12" />
                            Spicy
                        </BadgeCn>
                    }
                </div>
            </div>

            <CardContentCn Class="p-4">
                <div class="flex items-start justify-between gap-2">
                    <h3 class="font-semibold">@_product.Name</h3>
                    <span class="text-lg font-bold tabular-nums">$@_product.Price.ToString("F2")</span>
                </div>

                <p class="mt-1 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                <div class="mt-3 flex items-center gap-3 text-xs text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideClockCn Class="h-3 w-3" Size="12" />
                        <span>@_product.PrepTime</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideFlameCn Class="h-3 w-3" Size="12" />
                        <span>@_product.Calories cal</span>
                    </div>
                </div>

                <div class="mt-3 flex gap-3">
                    <div class="flex-1 rounded-md border p-2 text-center">
                        <p class="text-xs text-muted-foreground">Protein</p>
                        <p class="text-sm font-medium">@_product.Nutrition.Protein</p>
                    </div>
                    <div class="flex-1 rounded-md border p-2 text-center">
                        <p class="text-xs text-muted-foreground">Carbs</p>
                        <p class="text-sm font-medium">@_product.Nutrition.Carbs</p>
                    </div>
                    <div class="flex-1 rounded-md border p-2 text-center">
                        <p class="text-xs text-muted-foreground">Fat</p>
                        <p class="text-sm font-medium">@_product.Nutrition.Fat</p>
                    </div>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">ADD EXTRAS</p>
                    <div class="space-y-2">
                        @foreach (var addon in _product.Addons)
                        {
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <CheckboxCn Checked="@(_selectedAddons.Contains(addon.Id))" Id="@addon.Id" CheckedChanged="@(() => ToggleAddon(addon.Id))" />
                                    <label class="text-sm cursor-pointer" for="@addon.Id">@addon.Name</label>
                                </div>
                                <span class="text-sm text-muted-foreground tabular-nums">+$@addon.Price.ToString("F2")</span>
                            </div>
                        }
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucidePlusCn Class="mr-2 h-4 w-4" Size="16" />
                    Add to Order &mdash; $@_totalPrice.ToString("F2")
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private List<string> _selectedAddons = new();

    private decimal _totalPrice => _product.Price + _selectedAddons.Sum(id =>
    {
        var addon = _product.Addons.FirstOrDefault(a => a.Id == id);
        return addon?.Price ?? 0m;
    });

    private void ToggleAddon(string addonId)
    {
        if (_selectedAddons.Contains(addonId))
            _selectedAddons.Remove(addonId);
        else
            _selectedAddons.Add(addonId);
    }

    private record NutritionInfo(string Protein, string Carbs, string Fat);
    private record Addon(string Id, string Name, decimal Price);
    private record Product(string Name, string Description, decimal Price, string Image, string PrepTime, int Calories, bool IsVegetarian, bool IsSpicy, NutritionInfo Nutrition, List<Addon> Addons);

    private static readonly Product _product = new(
        "Grilled Salmon Bowl",
        "Fresh Atlantic salmon with quinoa, avocado, edamame, and citrus ginger dressing.",
        16.99m, "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&q=80",
        "15-20 min", 520, false, false,
        new("38g", "42g", "18g"),
        new()
        {
            new("extra-salmon", "Extra salmon", 4.99m),
            new("extra-avocado", "Extra avocado", 2.49m),
            new("spicy-mayo", "Spicy mayo", 0.99m),
        }
    );
}
