@* ========================================
   Block: product-card-event
   Title: Product Card Event
   Description: Event ticket card with seat selection and availability for ticketing platforms
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LabelCn, LucideCalendarCn, LucideClockCn, LucideMapPinCn, LucideMinusCn, LucidePlusCn, LucideTicketCn, LucideUsersCn, RadioGroupCn, RadioGroupItemCn
   Source: original/blocks/product-card/product-card-event.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[340px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[160px]">
                <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <BadgeCn Class="absolute top-3 left-3">
                    <LucideTicketCn Class="mr-1 h-3 w-3" Size="12" />
                    On Sale
                </BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold">@_product.Name</h3>
                <p class="text-sm text-muted-foreground">@_product.Artist</p>

                <div class="mt-3 space-y-1 text-sm">
                    <div class="flex items-center gap-2 text-muted-foreground">
                        <LucideCalendarCn Class="h-3 w-3" Size="12" />
                        <span>@_product.Date</span>
                        <LucideClockCn Class="ml-2 h-3 w-3" Size="12" />
                        <span>@_product.Time</span>
                    </div>
                    <div class="flex items-center gap-2 text-muted-foreground">
                        <LucideMapPinCn Class="h-3 w-3" Size="12" />
                        <span>@_product.Venue, @_product.City</span>
                    </div>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">SELECT TICKETS</p>
                    <RadioGroupCn @bind-Value="_selectedTier">
                        <div class="space-y-2">
                            @foreach (var tier in _product.Tiers)
                            {
                                <div class="flex items-center">
                                    <RadioGroupItemCn Class="peer sr-only" Id="@tier.Id" Value="@tier.Id" />
                                    <LabelCn Class="@($"flex flex-1 cursor-pointer items-center justify-between rounded-lg border p-3 peer-data-[state=checked]:border-primary peer-data-[state=checked]:ring-1 peer-data-[state=checked]:ring-primary")" For="@tier.Id">
                                        <div>
                                            <p class="text-sm font-medium">@tier.Name</p>
                                            <p class="text-xs text-muted-foreground">@tier.Description</p>
                                        </div>
                                        <div class="text-right">
                                            <p class="font-semibold tabular-nums">$@tier.Price</p>
                                            @if (tier.Available <= 20)
                                            {
                                                <p class="text-xs text-muted-foreground">@tier.Available left</p>
                                            }
                                        </div>
                                    </LabelCn>
                                </div>
                            }
                        </div>
                    </RadioGroupCn>
                </div>

                <div class="mt-4 flex items-center justify-between">
                    <p class="text-sm font-medium">Quantity</p>
                    <div class="flex items-center gap-2">
                        <ButtonCn Class="h-8 w-8" Disabled="@(_quantity <= 1)" @onclick="@(() => _quantity = Math.Max(1, _quantity - 1))" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline">
                            <LucideMinusCn Class="h-3 w-3" Size="12" />
                        </ButtonCn>
                        <span class="w-8 text-center font-medium tabular-nums">@_quantity</span>
                        <ButtonCn Class="h-8 w-8" Disabled="@(_quantity >= 8)" @onclick="@(() => _quantity = Math.Min(8, _quantity + 1))" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline">
                            <LucidePlusCn Class="h-3 w-3" Size="12" />
                        </ButtonCn>
                    </div>
                </div>

                @if (_currentTier.Available <= 20)
                {
                    <div class="mt-3 flex items-center gap-1 text-xs text-muted-foreground">
                        <LucideUsersCn Class="h-3 w-3" Size="12" />
                        <span>Only @_currentTier.Available tickets remaining</span>
                    </div>
                }
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <div class="flex w-full items-center justify-between">
                    <span class="text-sm text-muted-foreground">Total</span>
                    <span class="text-xl font-bold tabular-nums">$@_total</span>
                </div>
                <ButtonCn Class="w-full">
                    <LucideTicketCn Class="mr-2 h-4 w-4" Size="16" />
                    Get Tickets
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _selectedTier = "ga";
    private int _quantity = 2;

    private TicketTier _currentTier => _product.Tiers.FirstOrDefault(t => t.Id == _selectedTier) ?? _product.Tiers[0];
    private int _total => _currentTier.Price * _quantity;

    private record TicketTier(string Id, string Name, int Price, int Available, string Description);
    private record Product(string Name, string Artist, string Image, string Date, string Time, string Venue, string City, List<TicketTier> Tiers);

    private static readonly Product _product = new(
        "Summer Music Festival", "Multiple Artists",
        "https://images.unsplash.com/photo-1470229722913-7c0e2dbbafd3?w=400&q=80",
        "Aug 15, 2025", "6:00 PM", "Madison Square Garden", "New York, NY",
        new()
        {
            new("ga", "General Admission", 75, 250, "Standing room"),
            new("reserved", "Reserved Seating", 125, 45, "Assigned seat"),
            new("vip", "VIP Experience", 299, 8, "Premium view + perks"),
        }
    );
}
