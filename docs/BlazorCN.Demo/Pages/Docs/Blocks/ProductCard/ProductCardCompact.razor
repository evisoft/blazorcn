@* ========================================
   Block: product-card-compact
   Title: Product Card Compact
   Description: Compact product card with minimal design for product grids and listings
   Dependencies: ButtonCn, CardCn, LucideHeartCn, LucidePlusCn
   Source: original/blocks/product-card/product-card-compact.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[220px] max-w-full">
        <CardCn Class="group overflow-hidden">
            <div class="relative h-[180px]">
                <img alt="@_product.Name" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" height="400" src="@_product.Image" width="400" />
                <div class="absolute inset-0 flex items-end justify-center bg-gradient-to-t from-black/60 to-transparent p-3 opacity-0 transition-opacity group-hover:opacity-100">
                    <div class="flex gap-2">
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Secondary">
                            <LucidePlusCn Class="mr-1 h-4 w-4" Size="16" />
                            Add
                        </ButtonCn>
                        <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Secondary">
                            <LucideHeartCn Class="h-4 w-4" Size="16" />
                        </ButtonCn>
                    </div>
                </div>
            </div>

            <div class="p-3">
                <h3 class="text-sm font-medium truncate">@_product.Name</h3>
                <p class="mt-1 font-semibold tabular-nums">$@_product.Price.ToString("F2")</p>
            </div>
        </CardCn>
    </div>
</section>

@code {
    private record Product(string Name, decimal Price, string Image);

    private static readonly Product _product = new(
        "Classic Watch", 199.00m,
        "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=400&q=80"
    );
}
