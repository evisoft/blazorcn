@* ========================================
   Block: product-card-equipment-rental
   Title: Product Card Equipment Rental
   Description: Equipment rental card with hourly/daily rates and availability calendar for rental sites
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideCalendarCn, LucideCheckCn, LucidePackageCn, LucideShieldCheckCn, TabsCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/product-card/product-card-equipment-rental.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <BadgeCn Class="absolute top-3 left-3">@_product.Category</BadgeCn>
                <BadgeCn Class="@($"absolute top-3 right-3 {_conditionColor}")" Variant="BadgeVariant.Secondary">@_product.Condition</BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <p class="text-xs font-medium text-muted-foreground">@_product.Brand</p>
                <h3 class="font-semibold leading-tight">@_product.Name</h3>

                <div class="mt-3 flex items-center gap-2">
                    @if (_product.IsAvailable)
                    {
                        <div class="h-2 w-2 rounded-full bg-primary"></div>
                        <span class="text-sm text-primary font-medium">Available Now</span>
                    }
                    else
                    {
                        <div class="h-2 w-2 rounded-full bg-muted-foreground"></div>
                        <span class="text-sm text-muted-foreground">Available @_product.NextAvailable</span>
                    }
                </div>

                <div class="mt-4">
                    <TabsCn @bind-Value="_rateType">
                        <TabsListCn Class="grid w-full grid-cols-3">
                            <TabsTriggerCn Class="text-xs" Value="hourly">Hourly</TabsTriggerCn>
                            <TabsTriggerCn Class="text-xs" Value="daily">Daily</TabsTriggerCn>
                            <TabsTriggerCn Class="text-xs" Value="weekly">Weekly</TabsTriggerCn>
                        </TabsListCn>
                    </TabsCn>

                    <div class="mt-3 flex items-baseline justify-between">
                        <div>
                            <span class="text-2xl font-bold tabular-nums">$@_currentRate</span>
                            <span class="text-muted-foreground">/@_rateType.Replace("ly", "")</span>
                        </div>
                        @if (_rateType == "weekly")
                        {
                            var savings = (int)Math.Round((1.0 - (double)_product.Rates.Weekly / (_product.Rates.Daily * 7)) * 100);
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">Save @savings%</BadgeCn>
                        }
                    </div>
                </div>

                <div class="mt-3 flex items-center gap-2 rounded-lg border p-2">
                    <LucideShieldCheckCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <div class="flex-1">
                        <p class="text-xs font-medium">Security Deposit</p>
                        <p class="text-xs text-muted-foreground">$@_product.Deposit (refundable)</p>
                    </div>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">INCLUDED IN RENTAL</p>
                    <div class="space-y-1">
                        @foreach (var item in _product.Included)
                        {
                            <div class="flex items-center gap-2 text-xs">
                                <LucideCheckCn Class="h-3 w-3 text-primary" Size="12" />
                                <span>@item</span>
                            </div>
                        }
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full" Disabled="@(!_product.IsAvailable)">
                    <LucideCalendarCn Class="mr-2 h-4 w-4" Size="16" />
                    Reserve Now
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    <LucidePackageCn Class="mr-2 h-4 w-4" Size="16" />
                    Add Accessories
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _rateType = "daily";

    private int _currentRate => _rateType switch
    {
        "hourly" => _product.Rates.Hourly,
        "daily" => _product.Rates.Daily,
        "weekly" => _product.Rates.Weekly,
        _ => _product.Rates.Daily
    };

    private string _conditionColor => _product.Condition switch
    {
        "Excellent" => "text-primary",
        "Good" => "text-primary",
        _ => "text-muted-foreground"
    };

    private record RentalRates(int Hourly, int Daily, int Weekly);
    private record Product(string Name, string Brand, string Category, string Image, string Condition, RentalRates Rates, int Deposit, bool IsAvailable, string? NextAvailable, string[] Included);

    private static readonly Product _product = new(
        "Canon EOS R5 Mirrorless Camera", "Canon", "Cameras",
        "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=400&q=80",
        "Excellent", new(25, 150, 750), 500, true, null,
        new[] { "Camera body", "Battery & charger", "Strap", "Memory card (64GB)", "Carrying case" }
    );
}
