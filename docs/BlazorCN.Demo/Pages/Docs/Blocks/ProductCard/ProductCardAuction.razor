@* ========================================
   Block: product-card-auction
   Title: Product Card Auction
   Description: Auction product card with current bid, time remaining, and bid history for auction sites
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideBellCn, LucideClockCn, LucideGavelCn, LucideTrendingUpCn, LucideUsersCn, ProgressCn
   Source: original/blocks/product-card/product-card-auction.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn Class="absolute top-3 left-3">
                    <LucideGavelCn Class="mr-1 h-3 w-3" Size="12" />
                    Live Auction
                </BadgeCn>
                <button
                    type="button"
                    class="@($"absolute top-3 right-3 flex h-8 w-8 items-center justify-center rounded-full {(_isWatching ? "bg-primary text-primary-foreground" : "bg-background/90")}")"
                    @onclick="@(() => _isWatching = !_isWatching)">
                    <LucideBellCn Class="@($"h-4 w-4 {(_isWatching ? "fill-current" : "")}")" Size="16" />
                </button>
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold">@_product.Name</h3>
                <p class="mt-1 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                @* Time remaining *@
                <div class="mt-3 flex items-center justify-between rounded-lg border p-2">
                    <div class="flex items-center gap-2">
                        <LucideClockCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                        <span class="text-sm font-medium">@_timeLeft</span>
                    </div>
                    <div class="flex items-center gap-1 text-xs text-muted-foreground">
                        <LucideUsersCn Class="h-3 w-3" Size="12" />
                        <span>@_product.Watchers watching</span>
                    </div>
                </div>

                @* Current bid *@
                <div class="mt-4">
                    <div class="flex items-baseline justify-between">
                        <div>
                            <p class="text-xs text-muted-foreground">Current Bid</p>
                            <p class="text-2xl font-bold tabular-nums">$@_product.CurrentBid.ToString("N0")</p>
                        </div>
                        <div class="text-right">
                            <p class="text-xs text-muted-foreground">Est. Value</p>
                            <p class="text-sm font-medium tabular-nums">$@_product.EstimatedValue.ToString("N0")</p>
                        </div>
                    </div>

                    <ProgressCn Class="mt-2 h-1.5" Value="@Math.Min(_bidProgress, 100)" />

                    <div class="mt-2 flex items-center justify-between text-xs text-muted-foreground">
                        <div class="flex items-center gap-1">
                            <LucideTrendingUpCn Class="h-3 w-3" Size="12" />
                            <span>@_product.BidCount bids</span>
                        </div>
                        <span>Min increment: $@_product.BidIncrement</span>
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideGavelCn Class="mr-2 h-4 w-4" Size="16" />
                    Bid $@_nextBid.ToString("N0")
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    Place Custom Bid
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private bool _isWatching;
    private string _timeLeft = "4h 0m 0s";

    private int _nextBid => _product.CurrentBid + _product.BidIncrement;
    private double _bidProgress => (double)(_product.CurrentBid - _product.StartingBid) / (_product.EstimatedValue - _product.StartingBid) * 100;

    private record Product(string Name, string Description, string Image, int CurrentBid, int StartingBid, int EstimatedValue, int BidCount, int BidIncrement, int Watchers);

    private static readonly Product _product = new(
        "Vintage Rolex Submariner",
        "1967 Rolex Submariner ref. 5513, excellent condition with original box and papers.",
        "https://images.unsplash.com/photo-1587836374828-4dbafa94cf0e?w=400&q=80",
        12500, 8000, 18000, 23, 250, 47
    );
}
