@* ========================================
   Block: product-card-features
   Title: Product Card Features
   Description: Horizontal product card with feature list and stock status for ecommerce
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, LucideCheckCn, LucideShoppingCartCn, LucideTruckCn
   Source: original/blocks/product-card/product-card-features.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="grid md:grid-cols-[200px_1fr]">
                <div class="relative aspect-square md:aspect-square md:h-[200px]">
                    <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                    @if (!string.IsNullOrEmpty(_product.Badge))
                    {
                        <BadgeCn Class="absolute top-3 left-3">@_product.Badge</BadgeCn>
                    }
                </div>

                <CardContentCn Class="flex flex-col p-5">
                    <div class="flex-1">
                        <div class="flex items-start justify-between gap-4">
                            <h3 class="text-lg font-semibold">@_product.Name</h3>
                            <p class="text-xl font-bold tabular-nums">$@_product.Price.ToString("F2")</p>
                        </div>
                        <p class="mt-2 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                        <div class="mt-4 grid grid-cols-2 gap-2">
                            @foreach (var feature in _product.Features)
                            {
                                <div class="flex items-center gap-2 text-sm">
                                    <LucideCheckCn Class="h-4 w-4 text-primary" Size="16" />
                                    <span>@feature</span>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="mt-5 flex items-end justify-between gap-4">
                        <div class="space-y-1">
                            @if (_product.InStock)
                            {
                                @if (_isLowStock)
                                {
                                    <p class="text-xs text-muted-foreground">Only @_product.StockCount left in stock</p>
                                }
                                else
                                {
                                    <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideTruckCn Class="h-3 w-3" Size="12" />
                                        <span>In stock, ships today</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-xs text-destructive">Out of stock</p>
                            }
                        </div>

                        <div class="flex gap-2">
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                                <LucideShoppingCartCn Class="mr-2 h-4 w-4" Size="16" />
                                Add to Cart
                            </ButtonCn>
                            <ButtonCn Size="ButtonSize.Sm">Buy Now</ButtonCn>
                        </div>
                    </div>
                </CardContentCn>
            </div>
        </CardCn>
    </div>
</section>

@code {
    private bool _isLowStock => _product.StockCount <= 20;

    private record Product(string Name, string Description, decimal Price, string Image, string[] Features, bool InStock, int StockCount, string? Badge);

    private static readonly Product _product = new(
        "Portable Bluetooth Speaker",
        "360\u00b0 immersive sound with 24-hour battery life. Waterproof design perfect for outdoor adventures.",
        129.99m, "https://images.unsplash.com/photo-1608043152269-423dbba4e7e1?w=400&q=80",
        new[] { "360\u00b0 Surround Sound", "24-Hour Battery", "IPX7 Waterproof", "Bluetooth 5.0" },
        true, 18, "New Release"
    );
}
