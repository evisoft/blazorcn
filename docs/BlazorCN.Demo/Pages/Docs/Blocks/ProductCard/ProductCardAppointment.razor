@* ========================================
   Block: product-card-appointment
   Title: Product Card Appointment
   Description: Appointment service card with provider selection and time slots for booking apps
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideCalendarCn, LucideClockCn, LucideUserCn, ToggleGroupCn, ToggleGroupItemCn
   Source: original/blocks/product-card/product-card-appointment.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[140px]">
                <img
                    alt="@_product.Name"
                    class="h-full w-full object-cover"
                    height="400"
                    src="@_product.Image"
                    width="400" />
                <BadgeCn Class="absolute top-3 left-3">
                    <LucideClockCn Class="mr-1 h-3 w-3" Size="12" />
                    @_product.Duration
                </BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <div class="flex items-start justify-between gap-2">
                    <div>
                        <h3 class="font-semibold">@_product.Name</h3>
                        <p class="mt-1 text-sm text-muted-foreground">@_product.Description</p>
                    </div>
                    <span class="text-lg font-bold tabular-nums">$@_product.Price</span>
                </div>

                @* Provider selector *@
                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">SELECT PROVIDER</p>
                    <div class="flex gap-2">
                        @foreach (var provider in _product.Providers)
                        {
                            <button
                                type="button"
                                class="@($"flex flex-col items-center gap-1 rounded-lg border p-2 transition-all {(_selectedProvider == provider.Id ? "border-primary ring-1 ring-primary" : "border-border")}")"
                                @onclick="@(() => _selectedProvider = provider.Id)">
                                <AvatarCn Class="h-10 w-10">
                                    <AvatarImageCn Src="@provider.Avatar" />
                                    <AvatarFallbackCn>@provider.Name[0]</AvatarFallbackCn>
                                </AvatarCn>
                                <span class="text-xs font-medium">@provider.Name.Split(" ")[1]</span>
                            </button>
                        }
                    </div>
                    @if (_currentProvider is not null)
                    {
                        <p class="mt-2 text-xs text-muted-foreground">
                            <LucideUserCn Class="mr-1 inline h-3 w-3" Size="12" />
                            @_currentProvider.Name &bull; @_currentProvider.Specialty
                        </p>
                    }
                </div>

                @* Date display *@
                <div class="mt-4 flex items-center gap-2 text-sm">
                    <LucideCalendarCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="font-medium">@_product.SelectedDate</span>
                    <ButtonCn Class="h-auto p-0 text-xs" Variant="ButtonVariant.Link">
                        Change
                    </ButtonCn>
                </div>

                @* Time slots *@
                <div class="mt-3">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">
                        AVAILABLE TIMES (@_availableSlots.Count slots)
                    </p>
                    <ToggleGroupCn Class="flex flex-wrap gap-1" Type="ToggleGroupType.Single" @bind-Value="_selectedTime">
                        @foreach (var slot in _product.TimeSlots)
                        {
                            <ToggleGroupItemCn
                                Class="h-8 px-3 text-xs"
                                Disabled="@(!slot.Available)"
                                Value="@slot.Id">
                                @slot.Time
                            </ToggleGroupItemCn>
                        }
                    </ToggleGroupCn>
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full" Disabled="@(string.IsNullOrEmpty(_selectedTime))">
                    @(string.IsNullOrEmpty(_selectedTime) ? "Select a Time" : "Book Appointment")
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _selectedProvider = "dr-smith";
    private string _selectedTime = "";

    private Provider? _currentProvider => _product.Providers.FirstOrDefault(p => p.Id == _selectedProvider);
    private List<TimeSlot> _availableSlots => _product.TimeSlots.Where(s => s.Available).ToList();

    private record Provider(string Id, string Name, string Avatar, string Specialty);
    private record TimeSlot(string Id, string Time, bool Available);
    private record Product(string Name, string Description, int Price, string Duration, string Image, string SelectedDate, List<Provider> Providers, List<TimeSlot> TimeSlots);

    private static readonly Product _product = new(
        "General Consultation",
        "Comprehensive health assessment with your physician.",
        150,
        "30 min",
        "https://images.unsplash.com/photo-1631217868264-e5b90bb7e133?w=400&q=80",
        "Dec 10, 2025",
        new()
        {
            new("dr-smith", "Dr. Smith", "https://images.unsplash.com/photo-1612349317150-e413f6a5b16d?w=100&q=80", "Primary Care"),
            new("dr-jones", "Dr. Jones", "https://images.unsplash.com/photo-1559839734-2b71ea197ec2?w=100&q=80", "Internal Medicine"),
            new("dr-patel", "Dr. Patel", "https://images.unsplash.com/photo-1537368910025-700350fe46c7?w=100&q=80", "Family Medicine"),
        },
        new()
        {
            new("9am", "9:00 AM", true),
            new("930am", "9:30 AM", false),
            new("10am", "10:00 AM", true),
            new("1030am", "10:30 AM", true),
            new("11am", "11:00 AM", false),
            new("2pm", "2:00 PM", true),
            new("230pm", "2:30 PM", true),
            new("3pm", "3:00 PM", false),
        }
    );
}
