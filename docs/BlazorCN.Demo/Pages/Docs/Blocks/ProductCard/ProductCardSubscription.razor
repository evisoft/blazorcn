@* ========================================
   Block: product-card-subscription
   Title: Product Card Subscription
   Description: Subscription box product card with items preview and billing options for ecommerce
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, ToggleGroupCn, ToggleGroupItemCn, LucideBoxCn, LucideCheckCn, LucideGiftCn, LucideUsersCn
   Source: original/blocks/product-card/product-card-subscription.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <BadgeCn Class="absolute top-3 left-3">
                    <LucideGiftCn Class="mr-1 h-3 w-3" Size="12" />
                    Subscription
                </BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold">@_product.Name</h3>
                <p class="mt-1 text-sm text-muted-foreground">@_product.Description</p>

                <div class="mt-3 flex items-center gap-1 text-xs text-muted-foreground">
                    <LucideUsersCn Class="h-3 w-3" Size="12" />
                    <span>@_product.SubscriberCount.ToString("N0") subscribers</span>
                </div>

                <div class="mt-4">
                    <p class="mb-1.5 text-xs font-medium text-muted-foreground">WHAT'S INCLUDED</p>
                    <div class="space-y-1">
                        @foreach (var item in _product.ItemsIncluded)
                        {
                            <div class="flex items-start gap-1.5 text-xs">
                                <LucideCheckCn Class="mt-0.5 h-3 w-3 shrink-0 text-primary" Size="12" />
                                <span>@item</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">BILLING FREQUENCY</p>
                    <ToggleGroupCn Type="ToggleGroupType.Single" Value="@_selectedBilling" ValueChanged="@(v => { if (!string.IsNullOrEmpty(v)) _selectedBilling = v; })" Class="grid grid-cols-3 gap-1">
                        @foreach (var option in _product.BillingOptions)
                        {
                            <ToggleGroupItemCn Value="@option.Id" Class="flex-col h-auto py-2 text-xs">
                                <span>@option.Label</span>
                                @if (!string.IsNullOrEmpty(option.Savings))
                                {
                                    <span class="text-[10px] text-primary">@option.Savings</span>
                                }
                            </ToggleGroupItemCn>
                        }
                    </ToggleGroupCn>
                </div>

                <div class="mt-4 flex items-baseline justify-between">
                    <div>
                        <span class="text-2xl font-bold tabular-nums">$@CurrentOption.Price</span>
                        <span class="text-sm text-muted-foreground">/@BillingLabel</span>
                    </div>
                    @if (!string.IsNullOrEmpty(CurrentOption.Savings))
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary">@CurrentOption.Savings</BadgeCn>
                    }
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideBoxCn Class="mr-2 h-4 w-4" Size="16" />
                    Subscribe Now
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _selectedBilling = "monthly";

    private record BillingOption(string Id, string Label, int Price, string? Savings = null);
    private record Product(string Name, string Description, string Image, int SubscriberCount, string[] ItemsIncluded, BillingOption[] BillingOptions);

    private static readonly Product _product = new(
        "Artisan Coffee Box",
        "Curated specialty coffees from around the world, delivered fresh to your door.",
        "https://images.unsplash.com/photo-1559056199-641a0ac8b55e?w=400&q=80",
        12500,
        new[] { "3 bags of specialty coffee (12oz each)", "Tasting notes & brewing guide", "Exclusive member discounts", "Free shipping always" },
        new[] {
            new BillingOption("monthly", "Monthly", 39),
            new BillingOption("quarterly", "3 Months", 99, "Save 15%"),
            new BillingOption("annual", "Annual", 349, "Save 25%")
        }
    );

    private BillingOption CurrentOption => _product.BillingOptions.FirstOrDefault(o => o.Id == _selectedBilling) ?? _product.BillingOptions[0];
    private string BillingLabel => _selectedBilling switch { "monthly" => "mo", "quarterly" => "3mo", _ => "yr" };
}
