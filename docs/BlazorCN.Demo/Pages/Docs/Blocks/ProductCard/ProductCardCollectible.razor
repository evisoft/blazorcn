@* ========================================
   Block: product-card-collectible
   Title: Product Card Collectible
   Description: Collectible trading card with rarity, condition grade, and edition info for marketplaces
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideBadgeCheckCn, LucideHashCn, LucideShieldCheckCn, LucideSparklesCn, LucideTrendingUpCn
   Source: original/blocks/product-card/product-card-collectible.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[280px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="@($"relative flex h-[220px] items-center justify-center bg-gradient-to-b {_rarityStyle} p-4")">
                <img alt="@_product.Name" class="h-full w-auto rounded-lg object-contain shadow-xl" height="400" src="@_product.Image" width="400" />
                <BadgeCn Class="absolute top-3 left-3">
                    <LucideSparklesCn Class="mr-1 h-3 w-3" Size="12" />
                    @_product.Rarity
                </BadgeCn>
                <BadgeCn Class="absolute top-3 right-3" Variant="BadgeVariant.Secondary">@_product.Edition</BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <div class="flex items-start justify-between gap-2">
                    <div>
                        <h3 class="font-semibold">@_product.Name</h3>
                        <p class="text-sm text-muted-foreground">@_product.Set &bull; @_product.Year</p>
                    </div>
                    @if (_product.IsVerified)
                    {
                        <div class="flex h-8 w-8 items-center justify-center rounded-full border">
                            <LucideShieldCheckCn Class="h-4 w-4 text-primary" Size="16" />
                        </div>
                    }
                </div>

                <div class="mt-3 flex items-center gap-2">
                    <div class="flex items-center justify-center rounded-lg border bg-muted/50 px-3 py-1.5">
                        <span class="text-lg font-bold">@_product.Grader @_product.Grade</span>
                    </div>
                    <div class="flex-1">
                        <p class="text-xs font-medium">@_product.Condition</p>
                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                            <LucideHashCn Class="h-3 w-3" Size="12" />
                            <span class="font-mono">@_product.SerialNumber</span>
                        </div>
                    </div>
                </div>

                @if (_product.IsVerified)
                {
                    <div class="mt-3 flex items-center gap-2 rounded-lg border p-2">
                        <LucideBadgeCheckCn Class="h-4 w-4 text-primary" Size="16" />
                        <div class="flex-1">
                            <p class="text-xs font-medium">Authenticity Verified</p>
                            <p class="text-xs text-muted-foreground">Graded &amp; certified by @_product.Grader</p>
                        </div>
                    </div>
                }

                <div class="mt-4 flex items-end justify-between">
                    <div>
                        <p class="text-xs text-muted-foreground">Current Price</p>
                        <p class="text-2xl font-bold tabular-nums">$@_product.Price.ToString("N0")</p>
                    </div>
                    <div class="flex items-center gap-1 text-sm text-primary">
                        <LucideTrendingUpCn Class="h-4 w-4" Size="16" />
                        <span class="font-medium">+@_product.PriceChange%</span>
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">Buy Now</ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">Make Offer</ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _rarityStyle => _product.Rarity switch
    {
        "Common" => "from-muted/20 to-muted/5",
        "Uncommon" => "from-primary/20 to-primary/5",
        "Rare" => "from-primary/30 to-primary/10",
        "Ultra Rare" => "from-primary/40 to-primary/15",
        "Legendary" => "from-primary/50 to-primary/20",
        _ => "from-primary/30 to-primary/10"
    };

    private record Product(string Name, string Set, int Year, string Image, int Price, string Rarity, string Condition, int Grade, string Grader, string SerialNumber, string Edition, double PriceChange, bool IsVerified);

    private static readonly Product _product = new(
        "Charizard Holo", "Base Set", 1999,
        "https://images.unsplash.com/photo-1613771404784-3a5686aa2be3?w=400&q=80",
        2850, "Rare", "Near Mint", 9, "PSA", "45892761", "1st Edition", 12.5, true
    );
}
