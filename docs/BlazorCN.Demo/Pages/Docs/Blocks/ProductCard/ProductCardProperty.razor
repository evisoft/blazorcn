@* ========================================
   Block: product-card-property
   Title: Product Card Property
   Description: Real estate property card with key details and virtual tour for property listings
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, CardCn, CardContentCn, LucideBathCn, LucideBedDoubleCn, LucideHeartCn, LucideMapPinCn, LucideMaximizeCn, LucideVideoCn
   Source: original/blocks/product-card/product-card-property.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img alt="@_product.Address" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <div class="absolute top-3 left-3 flex gap-1">
                    @if (_product.IsNew)
                    {
                        <BadgeCn>New Listing</BadgeCn>
                    }
                    <BadgeCn Variant="BadgeVariant.Secondary">@_product.Type</BadgeCn>
                </div>
                <div class="absolute top-3 right-3 flex gap-1">
                    @if (_product.HasVirtualTour)
                    {
                        <button type="button" class="flex h-8 w-8 items-center justify-center rounded-full bg-background/90">
                            <LucideVideoCn Class="h-4 w-4" Size="16" />
                        </button>
                    }
                    <button type="button" class="flex h-8 w-8 items-center justify-center rounded-full bg-background/90" @onclick="@(() => _isSaved = !_isSaved)">
                        <LucideHeartCn Class="@($"h-4 w-4 {(_isSaved ? "fill-primary text-primary" : "")}")" Size="16" />
                    </button>
                </div>
            </div>

            <CardContentCn Class="p-4">
                <p class="text-2xl font-bold tabular-nums">@FormatPrice(_product.Price)</p>

                <div class="mt-1 flex items-center gap-1 text-sm text-muted-foreground">
                    <LucideMapPinCn Class="h-3 w-3" Size="12" />
                    <span>@_product.Address</span>
                </div>
                <p class="text-sm text-muted-foreground">@_product.City</p>

                <div class="mt-3 flex items-center gap-4 text-sm">
                    <div class="flex items-center gap-1">
                        <LucideBedDoubleCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                        <span class="font-medium">@_product.Beds</span>
                        <span class="text-muted-foreground">beds</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideBathCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                        <span class="font-medium">@_product.Baths</span>
                        <span class="text-muted-foreground">baths</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideMaximizeCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                        <span class="font-medium">@_product.Sqft.ToString("N0")</span>
                        <span class="text-muted-foreground">sqft</span>
                    </div>
                </div>

                <div class="mt-4 flex items-center justify-between rounded-lg border p-3">
                    <div class="flex items-center gap-2">
                        <AvatarCn Class="h-9 w-9">
                            <AvatarImageCn Src="@_product.Agent.Avatar" />
                            <AvatarFallbackCn>@_product.Agent.Name[0]</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <p class="text-sm font-medium">@_product.Agent.Name</p>
                            <p class="text-xs text-muted-foreground">@_product.Agent.Phone</p>
                        </div>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm">Contact</ButtonCn>
                </div>

                <div class="mt-3 flex gap-2">
                    <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline">Schedule Tour</ButtonCn>
                    <ButtonCn Class="flex-1">View Details</ButtonCn>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private bool _isSaved;

    private static string FormatPrice(int price) => price.ToString("C0");

    private record AgentInfo(string Name, string Avatar, string Phone);
    private record Product(string Address, string City, int Price, string Image, int Beds, int Baths, int Sqft, string Type, bool IsNew, bool HasVirtualTour, AgentInfo Agent);

    private static readonly Product _product = new(
        "1847 Oakwood Drive", "San Francisco, CA", 1250000,
        "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=400&q=80",
        4, 3, 2450, "Single Family", true, true,
        new("Emily Parker", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80", "(415) 555-0123")
    );
}
