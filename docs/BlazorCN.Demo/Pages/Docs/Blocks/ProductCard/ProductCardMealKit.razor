@* ========================================
   Block: product-card-meal-kit
   Title: Product Card Meal Kit
   Description: Recipe meal kit card with servings adjuster, cook time, and ingredients for food sites
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideChefHatCn, LucideClockCn, LucideFlameCn, LucideMinusCn, LucidePlusCn, LucideShoppingBasketCn, LucideUsersCn, SeparatorCn
   Source: original/blocks/product-card/product-card-meal-kit.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <BadgeCn Class="absolute top-3 left-3">@_product.Cuisine</BadgeCn>
                <BadgeCn Class="absolute top-3 right-3" Variant="BadgeVariant.Secondary">@_product.Difficulty</BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold">@_product.Name</h3>

                <div class="mt-2 flex flex-wrap gap-1">
                    @foreach (var tag in _product.Dietary)
                    {
                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">@tag</BadgeCn>
                    }
                </div>

                <div class="mt-3 flex items-center gap-4 text-sm text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideClockCn Class="h-4 w-4" Size="16" />
                        <span>@_product.PrepTime prep</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideChefHatCn Class="h-4 w-4" Size="16" />
                        <span>@_product.CookTime cook</span>
                    </div>
                </div>

                <SeparatorCn Class="my-3" />

                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideUsersCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                        <span class="text-sm font-medium">Servings</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <ButtonCn Class="h-8 w-8" Disabled="@(_servings <= 1)" @onclick="@(() => _servings = Math.Max(1, _servings - 1))" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline">
                            <LucideMinusCn Class="h-3 w-3" Size="12" />
                        </ButtonCn>
                        <span class="w-8 text-center font-medium tabular-nums">@_servings</span>
                        <ButtonCn Class="h-8 w-8" Disabled="@(_servings >= 8)" @onclick="@(() => _servings = Math.Min(8, _servings + 1))" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline">
                            <LucidePlusCn Class="h-3 w-3" Size="12" />
                        </ButtonCn>
                    </div>
                </div>

                <div class="mt-2 flex items-center justify-between text-sm text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideFlameCn Class="h-4 w-4" Size="16" />
                        <span>@_product.Calories cal/serving</span>
                    </div>
                    <span>@_totalCalories cal total</span>
                </div>

                <SeparatorCn Class="my-3" />

                <div>
                    <p class="mb-2 text-xs font-medium text-muted-foreground">KEY INGREDIENTS</p>
                    <div class="flex flex-wrap gap-1">
                        @foreach (var ingredient in _product.Ingredients)
                        {
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">@ingredient</BadgeCn>
                        }
                    </div>
                </div>

                <div class="mt-4 flex items-baseline justify-between">
                    <div>
                        <span class="text-2xl font-bold tabular-nums">$@_totalPrice.ToString("F2")</span>
                        <p class="text-xs text-muted-foreground">$@_product.PricePerServing.ToString("F2")/serving</p>
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideShoppingBasketCn Class="mr-2 h-4 w-4" Size="16" />
                    Add to Box
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private int _servings = 2;

    private decimal _totalPrice => _product.PricePerServing * _servings;
    private int _totalCalories => _product.Calories * _servings;

    private record Product(string Name, string Cuisine, string Image, decimal BasePrice, int BaseServings, decimal PricePerServing, string PrepTime, string CookTime, string Difficulty, int Calories, string[] Ingredients, string[] Dietary);

    private static readonly Product _product = new(
        "Thai Basil Chicken Stir-Fry", "Thai",
        "https://images.unsplash.com/photo-1562967916-eb82221dfb92?w=400&q=80",
        24.99m, 2, 12.50m, "15 min", "20 min", "Easy", 480,
        new[] { "Chicken thigh", "Thai basil", "Garlic", "Chili", "Jasmine rice", "Fish sauce" },
        new[] { "High Protein", "Dairy-Free" }
    );
}
