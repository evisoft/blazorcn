@* ========================================
   Block: product-card-saas
   Title: Product Card SaaS
   Description: Software product card with pricing tiers and feature comparison for SaaS sites
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideCheckCn, LucideSparklesCn, LucideXCn, LucideZapCn, SwitchCn
   Source: original/blocks/product-card/product-card-saas.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="@($"overflow-hidden {(_product.IsPopular ? "ring-2 ring-primary" : "")}")">
            @if (_product.IsPopular)
            {
                <div class="bg-primary px-4 py-1 text-center text-xs font-medium text-primary-foreground">Most Popular</div>
            }

            <CardContentCn Class="p-5">
                <div class="flex items-center gap-2">
                    <div class="flex h-10 w-10 items-center justify-center rounded-lg border">
                        <LucideZapCn Class="h-5 w-5 text-primary" Size="20" />
                    </div>
                    <div>
                        <h3 class="font-semibold">@_product.Name</h3>
                    </div>
                </div>

                <p class="mt-2 text-sm text-muted-foreground">@_product.Description</p>

                <div class="mt-4 flex items-center justify-between rounded-lg border p-3">
                    <div class="flex items-center gap-2">
                        <span class="@($"text-sm {(_isYearly ? "text-muted-foreground" : "font-medium")}")">Monthly</span>
                        <SwitchCn @bind-Checked="_isYearly" />
                        <span class="@($"text-sm {(_isYearly ? "font-medium" : "text-muted-foreground")}")">Yearly</span>
                    </div>
                    @if (_isYearly)
                    {
                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                            <LucideSparklesCn Class="mr-1 h-3 w-3" Size="12" />
                            Save @_savings%
                        </BadgeCn>
                    }
                </div>

                <div class="mt-4">
                    <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-bold tabular-nums">$@_currentPrice</span>
                        <span class="text-muted-foreground">/@(_isYearly ? "year" : "month")</span>
                    </div>
                    @if (_isYearly)
                    {
                        <p class="text-xs text-muted-foreground">$@((_product.YearlyPrice / 12m).ToString("F2"))/month billed annually</p>
                    }
                </div>

                <div class="mt-5">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">WHAT'S INCLUDED</p>
                    <div class="space-y-2">
                        @foreach (var feature in _product.Features)
                        {
                            <div class="flex items-center gap-2">
                                @if (feature.Included)
                                {
                                    <LucideCheckCn Class="h-4 w-4 text-primary" Size="16" />
                                }
                                else
                                {
                                    <LucideXCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                }
                                <span class="@($"text-sm {(feature.Included ? "" : "text-muted-foreground")}")">
                                    @feature.Name
                                    @if (!string.IsNullOrEmpty(feature.Limit))
                                    {
                                        <span class="text-muted-foreground"> (@feature.Limit)</span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-5 pt-0">
                <ButtonCn Class="w-full">Start Free Trial</ButtonCn>
                <p class="text-xs text-center text-muted-foreground">14-day free trial &bull; No credit card required</p>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private bool _isYearly;

    private int _currentPrice => _isYearly ? _product.YearlyPrice : _product.MonthlyPrice;
    private int _savings => (int)Math.Round((1 - (double)_product.YearlyPrice / (_product.MonthlyPrice * 12)) * 100);

    private record Feature(string Name, bool Included, string? Limit = null);
    private record Product(string Name, string Description, int MonthlyPrice, int YearlyPrice, bool IsPopular, List<Feature> Features);

    private static readonly Product _product = new(
        "Pro Plan", "For growing teams that need more power and flexibility.",
        29, 290, true,
        new()
        {
            new("Unlimited projects", true),
            new("Team members", true, "Up to 10"),
            new("Storage", true, "100 GB"),
            new("API access", true),
            new("Priority support", true),
            new("Custom integrations", false),
        }
    );
}
