@* ========================================
   Block: product-card-testimonials
   Title: Product Card Testimonials
   Description: Product card with customer testimonial carousel for ecommerce stores
   Dependencies: AvatarCn, AvatarFallbackCn, ButtonCn, CardCn, CardContentCn, SeparatorCn, LucideChevronLeftCn, LucideChevronRightCn, LucideShoppingCartCn, LucideStarCn
   Source: original/blocks/product-card/product-card-testimonials.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="grid md:grid-cols-[200px_1fr]">
                <div class="aspect-square md:aspect-square md:h-[200px]">
                    <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                </div>

                <CardContentCn Class="flex flex-col p-5">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <h3 class="text-lg font-semibold">@_product.Name</h3>
                            <div class="mt-1 flex items-center gap-1">
                                <LucideStarCn Class="h-4 w-4 fill-primary text-primary" Size="16" />
                                <span class="text-sm font-medium">@_product.Rating</span>
                                <span class="text-sm text-muted-foreground">(@_product.ReviewCount reviews)</span>
                            </div>
                        </div>
                        <p class="text-xl font-bold tabular-nums">$@_product.Price.ToString("F2")</p>
                    </div>

                    <p class="mt-2 text-sm text-muted-foreground">@_product.Description</p>

                    <div class="mt-4 flex gap-2">
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                            <LucideShoppingCartCn Class="mr-2 h-4 w-4" Size="16" />
                            Add to Cart
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm">Buy Now</ButtonCn>
                    </div>

                    <SeparatorCn Class="my-4" />

                    <div>
                        <p class="mb-3 text-xs font-medium text-muted-foreground">CUSTOMER REVIEWS</p>

                        <div class="flex items-start gap-3">
                            <AvatarCn Class="h-8 w-8">
                                <AvatarFallbackCn Class="text-xs">@CurrentTestimonial.Name[0]</AvatarFallbackCn>
                            </AvatarCn>

                            <div class="flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@CurrentTestimonial.Name</span>
                                    <div class="flex">
                                        @for (int star = 1; star <= 5; star++)
                                        {
                                            var s = star;
                                            <LucideStarCn Class="@(s <= CurrentTestimonial.Rating ? "h-3 w-3 fill-primary text-primary" : "h-3 w-3 fill-muted text-muted")" Size="12" />
                                        }
                                    </div>
                                </div>
                                <p class="mt-1 text-sm text-muted-foreground">"@CurrentTestimonial.Text"</p>
                            </div>
                        </div>

                        <div class="mt-3 flex items-center justify-between">
                            <div class="flex gap-1">
                                @for (int i = 0; i < _product.Testimonials.Length; i++)
                                {
                                    var idx = i;
                                    <button type="button" class="@($"h-1.5 w-4 rounded-full transition-colors {(idx == _activeIndex ? "bg-primary" : "bg-muted")}")" @onclick="@(() => _activeIndex = idx)"></button>
                                }
                            </div>

                            <div class="flex gap-1">
                                <ButtonCn Class="h-7 w-7" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" OnClick="@GoToPrevious">
                                    <LucideChevronLeftCn Class="h-4 w-4" Size="16" />
                                </ButtonCn>
                                <ButtonCn Class="h-7 w-7" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" OnClick="@GoToNext">
                                    <LucideChevronRightCn Class="h-4 w-4" Size="16" />
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                </CardContentCn>
            </div>
        </CardCn>
    </div>
</section>

@code {
    private int _activeIndex;

    private record Testimonial(string Name, int Rating, string Text);
    private record Product(string Name, string Description, decimal Price, string Image, decimal Rating, int ReviewCount, Testimonial[] Testimonials);

    private static readonly Product _product = new(
        "ProCapture X3 Camera",
        "Professional mirrorless camera with 32MP sensor and 4K video recording.",
        1299.99m,
        "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=400&q=80",
        4.8m, 256,
        new[] {
            new Testimonial("Michael R.", 5, "The image quality is exceptional. Best camera I've ever owned."),
            new Testimonial("Sarah C.", 5, "Perfect for my YouTube videos. The autofocus is lightning fast!"),
            new Testimonial("Alex J.", 4, "Worth every penny. The low light performance is incredible.")
        }
    );

    private Testimonial CurrentTestimonial => _product.Testimonials[_activeIndex];

    private void GoToPrevious() => _activeIndex = _activeIndex == 0 ? _product.Testimonials.Length - 1 : _activeIndex - 1;
    private void GoToNext() => _activeIndex = _activeIndex == _product.Testimonials.Length - 1 ? 0 : _activeIndex + 1;
}
