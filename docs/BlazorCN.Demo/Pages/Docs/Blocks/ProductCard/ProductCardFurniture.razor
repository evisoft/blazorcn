@* ========================================
   Block: product-card-furniture
   Title: Product Card Furniture
   Description: Furniture product card with dimensions, materials, and delivery estimate for home stores
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucidePackageCn, LucideRulerCn, LucideShoppingCartCn, LucideTruckCn
   Source: original/blocks/product-card/product-card-furniture.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <BadgeCn Class="absolute top-3 left-3">@_product.Collection</BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold">@_product.Name</h3>
                <p class="mt-1 text-sm text-muted-foreground">@_product.Material</p>

                <div class="mt-3 flex items-center gap-2 rounded-lg border p-2">
                    <LucideRulerCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <div class="flex gap-3 text-xs">
                        <span>W: @_product.Dimensions.Width</span>
                        <span>D: @_product.Dimensions.Depth</span>
                        <span>H: @_product.Dimensions.Height</span>
                    </div>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">
                        COLOR: <span class="text-foreground">@_selectedColor</span>
                    </p>
                    <div class="flex gap-2">
                        @foreach (var color in _product.Colors)
                        {
                            <button type="button"
                                    class="@($"h-8 w-8 rounded-full border-2 transition-all {(_selectedColor == color.Name ? "border-primary ring-2 ring-primary ring-offset-2" : "border-border")}")"
                                    @onclick="@(() => _selectedColor = color.Name)"
                                    style="background-color: @color.Value;"
                                    title="@color.Name"></button>
                        }
                    </div>
                </div>

                <div class="mt-4 flex items-center gap-2 text-sm">
                    <LucideTruckCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-muted-foreground">Delivery in @_product.DeliveryDays days</span>
                </div>

                <div class="mt-4 flex items-center justify-between">
                    <span class="text-2xl font-bold tabular-nums">$@_product.Price</span>
                    @if (_product.InStock)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary">
                            <LucidePackageCn Class="mr-1 h-3 w-3" Size="12" />
                            In Stock
                        </BadgeCn>
                    }
                    else
                    {
                        <BadgeCn Variant="BadgeVariant.Outline">Made to Order</BadgeCn>
                    }
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideShoppingCartCn Class="mr-2 h-4 w-4" Size="16" />
                    Add to Cart
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    View in Room
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _selectedColor = "Charcoal";

    private record DimensionInfo(string Width, string Depth, string Height);
    private record ColorOption(string Name, string Value);
    private record Product(string Name, string Collection, int Price, string Image, DimensionInfo Dimensions, string Material, int DeliveryDays, List<ColorOption> Colors, bool InStock);

    private static readonly Product _product = new(
        "Minimalist Lounge Chair", "Nordic Collection", 899,
        "https://images.unsplash.com/photo-1555041469-a586c61ea9bc?w=400&q=80",
        new("32\"", "34\"", "33\""), "Oak wood, Premium fabric", 14,
        new()
        {
            new("Charcoal", "#374151"),
            new("Cream", "#fef3c7"),
            new("Forest", "#065f46"),
            new("Navy", "#1e3a5f"),
        },
        true
    );
}
