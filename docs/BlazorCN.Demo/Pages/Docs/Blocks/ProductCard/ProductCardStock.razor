@* ========================================
   Block: product-card-stock
   Title: Product Card Stock
   Description: Stock investment card with price chart, key metrics, and trade buttons for finance apps
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideArrowDownCn, LucideArrowUpCn, LucideBarChart3Cn, LucideBuilding2Cn, LucideStarCn, LucideTrendingUpCn, TabsCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/product-card/product-card-stock.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[340px] max-w-full">
        <CardCn Class="overflow-hidden">
            <CardContentCn Class="p-4">
                <div class="flex items-start justify-between">
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-lg border">
                            <LucideBuilding2Cn Class="h-5 w-5 text-muted-foreground" Size="20" />
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-bold">@_product.Ticker</span>
                                <BadgeCn Class="@_ratingColor" Variant="BadgeVariant.Outline">@_product.AnalystRating</BadgeCn>
                            </div>
                            <p class="text-sm text-muted-foreground">@_product.Name</p>
                        </div>
                    </div>
                    <ButtonCn Class="h-8 w-8" @onclick="@(() => _isWatched = !_isWatched)" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                        <LucideStarCn Class="@($"h-4 w-4 {(_isWatched ? "fill-primary text-primary" : "")}")" Size="16" />
                    </ButtonCn>
                </div>

                <div class="mt-4 flex items-baseline justify-between">
                    <span class="text-3xl font-bold tabular-nums">$@_product.Price.ToString("F2")</span>
                    <div class="@($"flex items-center gap-1 {(_isPositive ? "text-primary" : "text-destructive")}")">
                        @if (_isPositive)
                        {
                            <LucideArrowUpCn Class="h-4 w-4" Size="16" />
                        }
                        else
                        {
                            <LucideArrowDownCn Class="h-4 w-4" Size="16" />
                        }
                        <span class="font-medium tabular-nums">$@Math.Abs(_product.Change).ToString("F2") (@Math.Abs(_product.ChangePercent).ToString("F2")%)</span>
                    </div>
                </div>

                <div class="mt-4">
                    <TabsCn @bind-Value="_timeframe">
                        <TabsListCn Class="grid w-full grid-cols-5">
                            <TabsTriggerCn Class="text-xs" Value="1D">1D</TabsTriggerCn>
                            <TabsTriggerCn Class="text-xs" Value="1W">1W</TabsTriggerCn>
                            <TabsTriggerCn Class="text-xs" Value="1M">1M</TabsTriggerCn>
                            <TabsTriggerCn Class="text-xs" Value="1Y">1Y</TabsTriggerCn>
                            <TabsTriggerCn Class="text-xs" Value="ALL">ALL</TabsTriggerCn>
                        </TabsListCn>
                    </TabsCn>

                    <div class="mt-3 flex h-10 items-center justify-center">
                        <svg aria-label="Price chart" class="overflow-visible" height="32" role="img" width="120">
                            <path class="@(_isPositive ? "text-primary" : "text-destructive")" d="@_sparklinePath" fill="none" stroke="currentColor" stroke-width="1.5" />
                        </svg>
                    </div>
                </div>

                <div class="mt-4 grid grid-cols-3 gap-3 text-center">
                    <div class="rounded-lg border p-2">
                        <p class="text-xs text-muted-foreground">Market Cap</p>
                        <p class="font-semibold">@_product.MarketCap</p>
                    </div>
                    <div class="rounded-lg border p-2">
                        <p class="text-xs text-muted-foreground">P/E Ratio</p>
                        <p class="font-semibold tabular-nums">@_product.PeRatio</p>
                    </div>
                    <div class="rounded-lg border p-2">
                        <p class="text-xs text-muted-foreground">Volume</p>
                        <p class="font-semibold">@_product.Volume</p>
                    </div>
                </div>

                <div class="mt-4">
                    <div class="flex items-center justify-between text-xs text-muted-foreground">
                        <span>52W Low: $@_product.Low52w</span>
                        <span>52W High: $@_product.High52w</span>
                    </div>
                    <div class="relative mt-1 h-2 rounded-full bg-muted">
                        <div class="absolute top-1/2 h-3 w-3 -translate-y-1/2 rounded-full border-2 border-primary bg-background" style="left: calc(@_price52wPosition% - 6px)"></div>
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="gap-2 p-4 pt-0">
                <ButtonCn Class="flex-1">
                    <LucideTrendingUpCn Class="mr-2 h-4 w-4" Size="16" />
                    Buy
                </ButtonCn>
                <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline">
                    <LucideBarChart3Cn Class="mr-2 h-4 w-4" Size="16" />
                    Sell
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _timeframe = "1D";
    private bool _isWatched;

    private bool _isPositive => _product.Change >= 0;

    private string _ratingColor => _product.AnalystRating switch
    {
        "Strong Buy" or "Buy" => "text-primary",
        "Hold" => "text-muted-foreground",
        _ => "text-destructive"
    };

    private double _price52wPosition => (_product.Price - _product.Low52w) / (_product.High52w - _product.Low52w) * 100;

    private string _sparklinePath
    {
        get
        {
            var data = _product.Sparkline;
            var min = data.Min();
            var max = data.Max();
            var range = max - min == 0 ? 1.0 : max - min;
            var points = data.Select((val, i) =>
            {
                var x = (double)i / (data.Length - 1) * 120;
                var y = 32.0 - (val - min) / range * 32;
                return $"{x:F0},{y:F0}";
            });
            return $"M{string.Join(" L", points)}";
        }
    }

    private record Product(string Ticker, string Name, double Price, double Change, double ChangePercent, string MarketCap, double PeRatio, string Volume, double High52w, double Low52w, string AnalystRating, double[] Sparkline);

    private static readonly Product _product = new(
        "AAPL", "Apple Inc.", 178.52, 3.24, 1.85, "$2.8T", 28.4, "52.3M",
        198.23, 124.17, "Buy",
        new double[] { 165, 168, 172, 169, 175, 173, 178, 176, 180, 178, 182, 179 }
    );
}
