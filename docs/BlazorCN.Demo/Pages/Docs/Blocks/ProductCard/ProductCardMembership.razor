@* ========================================
   Block: product-card-membership
   Title: Product Card Membership
   Description: Membership pass card with access levels, validity period, and perks for membership sites
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideAwardCn, LucideCalendarCn, LucideCheckCn, LucideUsersCn
   Source: original/blocks/product-card/product-card-membership.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="@($"overflow-hidden {(_product.IsPopular ? "ring-2 ring-primary" : "")}")">
            <div class="relative flex items-center justify-between bg-gradient-to-r from-primary/10 via-primary/5 to-transparent p-4">
                <div class="flex items-center gap-3">
                    <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-primary bg-background">
                        <LucideAwardCn Class="h-5 w-5" Size="20" />
                    </div>
                    <div>
                        <h3 class="font-semibold">@_product.Name</h3>
                        <p class="text-sm text-muted-foreground">@_product.Tier Tier</p>
                    </div>
                </div>
                @if (_product.IsPopular)
                {
                    <BadgeCn>Most Popular</BadgeCn>
                }
            </div>

            <CardContentCn Class="p-4">
                <p class="text-sm text-muted-foreground">@_product.Description</p>

                <div class="mt-4 flex items-center gap-2 rounded-lg border p-2">
                    <LucideCalendarCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    <span class="text-sm">Valid for @_product.ValidityMonths months from purchase</span>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">MEMBERSHIP INCLUDES</p>
                    <div class="space-y-1.5">
                        @foreach (var perk in _product.Perks)
                        {
                            <div class="flex items-center gap-2 text-sm">
                                <LucideCheckCn Class="h-4 w-4 text-primary" Size="16" />
                                <span>@perk</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4 flex items-center gap-2 text-sm text-muted-foreground">
                    <LucideUsersCn Class="h-4 w-4" Size="16" />
                    <span>Join @_product.MemberCount.ToString("N0")+ members</span>
                </div>

                <div class="mt-4 flex items-baseline gap-1">
                    <span class="text-3xl font-bold tabular-nums">$@_product.Price</span>
                    <span class="text-muted-foreground">/@_product.Period</span>
                </div>
                @if (_product.Period == "year")
                {
                    <p class="text-xs text-muted-foreground">$@((_product.Price / 12m).ToString("F2"))/month billed annually</p>
                }
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">Become a Member</ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">Gift Membership</ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Product(string Name, string Tier, int Price, string Period, string Description, int ValidityMonths, int MemberCount, string[] Perks, bool IsPopular);

    private static readonly Product _product = new(
        "Premium Membership", "Premium", 99, "year",
        "Full access to all exhibits, events, and exclusive member experiences.",
        12, 2847,
        new[] { "Unlimited museum entry", "Free guest passes (4/year)", "Members-only events", "10% shop discount", "Early exhibition access", "Quarterly magazine" },
        true
    );
}
