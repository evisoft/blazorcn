@* ========================================
   Block: product-card-concert-ticket
   Title: Product Card Concert Ticket
   Description: Concert ticket card with seat selection, venue map preview, and pricing tiers for ticketing apps
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LabelCn, LucideCalendarCn, LucideClockCn, LucideMapPinCn, LucideMinusCn, LucideMusicCn, LucidePlusCn, LucideTicketCn, RadioGroupCn, RadioGroupItemCn, SeparatorCn
   Source: original/blocks/product-card/product-card-concert-ticket.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[340px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[160px]">
                <img alt="@_product.Artist" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                <div class="absolute bottom-3 left-3 right-3">
                    <BadgeCn Class="mb-1">
                        <LucideMusicCn Class="mr-1 h-3 w-3" Size="12" />
                        Concert
                    </BadgeCn>
                    <h3 class="font-bold text-white">@_product.Artist</h3>
                    <p class="text-sm text-white/80">@_product.Tour</p>
                </div>
            </div>

            <CardContentCn Class="p-4">
                <div class="flex flex-wrap gap-3 text-sm">
                    <div class="flex items-center gap-1.5 text-muted-foreground">
                        <LucideCalendarCn Class="h-4 w-4" Size="16" />
                        <span>@_product.Date</span>
                    </div>
                    <div class="flex items-center gap-1.5 text-muted-foreground">
                        <LucideClockCn Class="h-4 w-4" Size="16" />
                        <span>@_product.Time</span>
                    </div>
                </div>
                <div class="mt-2 flex items-center gap-1.5 text-sm text-muted-foreground">
                    <LucideMapPinCn Class="h-4 w-4 shrink-0" Size="16" />
                    <span>@_product.Venue, @_product.City</span>
                </div>

                <SeparatorCn Class="my-4" />

                <div>
                    <LabelCn Class="text-xs font-medium text-muted-foreground">SELECT SECTION</LabelCn>
                    <RadioGroupCn Class="mt-2 space-y-2" @bind-Value="_selectedTier">
                        @foreach (var t in _product.Tiers)
                        {
                            <LabelCn
                                Class="@($"flex cursor-pointer items-center justify-between rounded-lg border p-3 transition-colors hover:bg-muted/50 {(_selectedTier == t.Id ? "border-primary bg-muted/50" : "")}")"
                                For="@t.Id">
                                <div class="flex items-center gap-3">
                                    <RadioGroupItemCn Id="@t.Id" Value="@t.Id" />
                                    <div>
                                        <p class="font-medium">@t.Name</p>
                                        <p class="text-xs text-muted-foreground">@t.Description</p>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <p class="font-semibold tabular-nums">$@t.Price</p>
                                    <p class="text-xs text-muted-foreground">@t.Available left</p>
                                </div>
                            </LabelCn>
                        }
                    </RadioGroupCn>
                </div>

                <div class="mt-4 flex items-center justify-between">
                    <LabelCn Class="text-sm font-medium">Tickets</LabelCn>
                    <div class="flex items-center gap-2">
                        <ButtonCn Class="h-8 w-8" Disabled="@(_quantity <= 1)" @onclick="@(() => _quantity = Math.Max(1, _quantity - 1))" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline">
                            <LucideMinusCn Class="h-3 w-3" Size="12" />
                        </ButtonCn>
                        <span class="w-8 text-center font-medium tabular-nums">@_quantity</span>
                        <ButtonCn Class="h-8 w-8" Disabled="@(_quantity >= 8 || _quantity >= _tier.Available)" @onclick="@(() => _quantity = Math.Min(8, _quantity + 1))" Size="ButtonSize.Icon" Variant="ButtonVariant.Outline">
                            <LucidePlusCn Class="h-3 w-3" Size="12" />
                        </ButtonCn>
                    </div>
                </div>

                <div class="mt-4 space-y-1 rounded-lg border p-3 text-sm">
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">@_quantity &times; $@_tier.Price</span>
                        <span class="tabular-nums">$@_subtotal.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">Service fee</span>
                        <span class="tabular-nums">$@_serviceFee.ToString("F2")</span>
                    </div>
                    <SeparatorCn Class="my-2" />
                    <div class="flex justify-between font-semibold">
                        <span>Total</span>
                        <span class="tabular-nums">$@_total.ToString("F2")</span>
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full" Disabled="@(_tier.Available == 0)">
                    <LucideTicketCn Class="mr-2 h-4 w-4" Size="16" />
                    Get Tickets
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _selectedTier = "lower";
    private int _quantity = 2;

    private SeatingTier _tier => _product.Tiers.FirstOrDefault(t => t.Id == _selectedTier) ?? _product.Tiers[0];
    private decimal _subtotal => _tier.Price * _quantity;
    private decimal _serviceFee => _subtotal * (_product.ServiceFeePercent / 100m);
    private decimal _total => _subtotal + _serviceFee;

    private record SeatingTier(string Id, string Name, decimal Price, int Available, string Description);
    private record Product(string Artist, string Tour, string Image, string Date, string Time, string Venue, string City, List<SeatingTier> Tiers, int ServiceFeePercent);

    private static readonly Product _product = new(
        "Arctic Monkeys", "The Car World Tour",
        "https://images.unsplash.com/photo-1540039155733-5bb30b53aa14?w=400&q=80",
        "Mar 15, 2025", "8:00 PM", "Madison Square Garden", "New York, NY",
        new()
        {
            new("floor", "Floor", 250, 12, "Standing, closest to stage"),
            new("lower", "Lower Bowl", 175, 48, "Sections 101-120"),
            new("upper", "Upper Bowl", 85, 156, "Sections 201-220"),
        },
        15
    );
}
