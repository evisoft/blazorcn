@* ========================================
   Block: product-card-job-listing
   Title: Product Card Job Listing
   Description: Job listing card with salary, requirements, and quick apply for job boards
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, CardCn, CardContentCn, LucideBookmarkCn, LucideBriefcaseCn, LucideClockCn, LucideDollarSignCn, LucideMapPinCn, LucideUsersCn
   Source: original/blocks/product-card/product-card-job-listing.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[600px] max-w-full">
        <CardCn Class="overflow-hidden">
            <CardContentCn Class="p-5">
                <div class="flex gap-4">
                    <AvatarCn Class="h-14 w-14 rounded-lg">
                        <AvatarImageCn Src="@_product.Logo" />
                        <AvatarFallbackCn Class="rounded-lg">@_product.Company[0]</AvatarFallbackCn>
                    </AvatarCn>

                    <div class="flex-1">
                        <div class="flex items-start justify-between gap-4">
                            <div>
                                <h3 class="text-lg font-semibold">@_product.Title</h3>
                                <p class="text-sm text-muted-foreground">@_product.Company</p>
                            </div>
                            <button type="button" class="flex h-9 w-9 items-center justify-center rounded-full border" @onclick="@(() => _isSaved = !_isSaved)">
                                <LucideBookmarkCn Class="@($"h-4 w-4 {(_isSaved ? "fill-primary text-primary" : "")}")" Size="16" />
                            </button>
                        </div>

                        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
                            <div class="flex items-center gap-1">
                                <LucideMapPinCn Class="h-3 w-3" Size="12" />
                                <span>@_product.Location</span>
                                @if (_product.IsRemote)
                                {
                                    <BadgeCn Class="ml-1 text-xs" Variant="BadgeVariant.Secondary">Remote</BadgeCn>
                                }
                            </div>
                            <div class="flex items-center gap-1">
                                <LucideDollarSignCn Class="h-3 w-3" Size="12" />
                                <span>@FormatSalary(_product.SalaryMin) - @FormatSalary(_product.SalaryMax)</span>
                            </div>
                            <div class="flex items-center gap-1">
                                <LucideBriefcaseCn Class="h-3 w-3" Size="12" />
                                <span>@_product.Type</span>
                            </div>
                        </div>

                        <p class="mt-3 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                        <div class="mt-3 flex flex-wrap gap-1">
                            @foreach (var skill in _product.Skills)
                            {
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">@skill</BadgeCn>
                            }
                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">@_product.Experience</BadgeCn>
                        </div>

                        <div class="mt-4 flex items-center justify-between">
                            <div class="flex items-center gap-4 text-xs text-muted-foreground">
                                <div class="flex items-center gap-1">
                                    <LucideClockCn Class="h-3 w-3" Size="12" />
                                    <span>@(_product.PostedDays)d ago</span>
                                </div>
                                <div class="flex items-center gap-1">
                                    <LucideUsersCn Class="h-3 w-3" Size="12" />
                                    <span>@_product.Applicants applicants</span>
                                </div>
                            </div>
                            <div class="flex gap-2">
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">View Details</ButtonCn>
                                <ButtonCn Size="ButtonSize.Sm">Quick Apply</ButtonCn>
                            </div>
                        </div>
                    </div>
                </div>
            </CardContentCn>
        </CardCn>
    </div>
</section>

@code {
    private bool _isSaved;

    private static string FormatSalary(int amount) => $"${amount / 1000}k";

    private record Product(string Title, string Company, string Logo, string Location, bool IsRemote, int SalaryMin, int SalaryMax, string Type, string Experience, int PostedDays, int Applicants, string[] Skills, string Description);

    private static readonly Product _product = new(
        "Senior Frontend Engineer", "TechFlow Inc",
        "https://images.unsplash.com/photo-1611162617474-5b21e879e113?w=100&q=80",
        "San Francisco, CA", true, 150000, 200000, "Full-time", "5+ years", 2, 47,
        new[] { "React", "TypeScript", "Next.js", "Tailwind CSS" },
        "Join our team to build the next generation of developer tools. You'll work on challenging problems with a talented team."
    );
}
