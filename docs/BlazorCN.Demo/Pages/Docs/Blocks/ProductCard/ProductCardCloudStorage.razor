@* ========================================
   Block: product-card-cloud-storage
   Title: Product Card Cloud Storage
   Description: Cloud storage plan card with storage meter, usage breakdown, and upgrade prompt for SaaS apps
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideCloudCn, LucideFileCn, LucideFileImageCn, LucideFileVideoCn, LucideFolderArchiveCn, LucideHardDriveCn, LucideSparklesCn, ProgressCn
   Source: original/blocks/product-card/product-card-cloud-storage.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <CardContentCn Class="p-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="flex h-10 w-10 items-center justify-center rounded-full border">
                            <LucideCloudCn Class="h-5 w-5 text-primary" Size="20" />
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h3 class="font-semibold">Cloud Storage</h3>
                                <BadgeCn Variant="BadgeVariant.Secondary">@_product.PlanName</BadgeCn>
                            </div>
                            <p class="text-sm text-muted-foreground">$@_product.Price/month</p>
                        </div>
                    </div>
                </div>

                <div class="mt-6">
                    <div class="flex items-end justify-between">
                        <div>
                            <p class="text-3xl font-bold tabular-nums">@FormatSize(_product.UsedStorage)</p>
                            <p class="text-sm text-muted-foreground">of @FormatSize(_product.TotalStorage) used</p>
                        </div>
                        <p class="@($"text-2xl font-semibold tabular-nums {(_isNearLimit ? "text-destructive" : "text-muted-foreground")}")">
                            @_usagePercent.ToString("F0")%
                        </p>
                    </div>
                    <ProgressCn Class="@($"mt-3 h-3 {(_isNearLimit ? "[&>div]:bg-destructive" : "")}")" Value="@_usagePercent" />
                    <p class="mt-2 text-xs text-muted-foreground">@FormatSize(_remainingStorage) remaining</p>
                </div>

                <div class="mt-6">
                    <p class="mb-3 text-xs font-medium text-muted-foreground">STORAGE BREAKDOWN</p>
                    <div class="space-y-3">
                        @foreach (var item in _product.Breakdown)
                        {
                            var itemPercent = item.Size / _product.UsedStorage * 100;
                            <div class="flex items-center gap-3">
                                <div class="flex h-8 w-8 items-center justify-center rounded-lg border">
                                    @item.Icon
                                </div>
                                <div class="flex-1">
                                    <div class="flex items-center justify-between text-sm">
                                        <span>@item.Type</span>
                                        <span class="tabular-nums text-muted-foreground">@FormatSize(item.Size)</span>
                                    </div>
                                    <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                        <div class="@($"h-full rounded-full {item.Color}")" style="width: @(itemPercent.ToString("F1"))%;"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                @if (_isNearLimit)
                {
                    <div class="mt-4 rounded-lg border border-dashed p-3">
                        <div class="flex items-start gap-2">
                            <LucideSparklesCn Class="h-4 w-4 shrink-0 text-primary" Size="16" />
                            <div>
                                <p class="text-sm font-medium">Running low on space?</p>
                                <p class="text-xs text-muted-foreground">
                                    Upgrade to @_product.NextTier for @FormatSize(_product.NextTierStorage) at $@_product.NextTierPrice/mo
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideHardDriveCn Class="mr-2 h-4 w-4" Size="16" />
                    Upgrade Storage
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">Manage Files</ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private double _usagePercent => _product.UsedStorage / _product.TotalStorage * 100;
    private double _remainingStorage => _product.TotalStorage - _product.UsedStorage;
    private bool _isNearLimit => _usagePercent >= 80;

    private static string FormatSize(double gb) => gb >= 1000 ? $"{gb / 1000:F1} TB" : $"{gb:F1} GB";

    private record StorageItem(string Type, RenderFragment Icon, double Size, string Color);
    private record Product(string PlanName, double TotalStorage, double UsedStorage, decimal Price, string NextTier, double NextTierStorage, decimal NextTierPrice, List<StorageItem> Breakdown);

    private Product _product => new(
        "Pro", 100, 78.4, 9.99m, "Business", 500, 19.99m,
        new()
        {
            new("Images", (RenderFragment)(@<LucideFileImageCn Class="h-4 w-4 text-muted-foreground" Size="16" />), 32.1, "bg-blue-500"),
            new("Videos", (RenderFragment)(@<LucideFileVideoCn Class="h-4 w-4 text-muted-foreground" Size="16" />), 28.7, "bg-purple-500"),
            new("Documents", (RenderFragment)(@<LucideFileCn Class="h-4 w-4 text-muted-foreground" Size="16" />), 12.4, "bg-green-500"),
            new("Archives", (RenderFragment)(@<LucideFolderArchiveCn Class="h-4 w-4 text-muted-foreground" Size="16" />), 5.2, "bg-orange-500"),
        }
    );
}
