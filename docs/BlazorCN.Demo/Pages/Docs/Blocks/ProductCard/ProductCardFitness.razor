@* ========================================
   Block: product-card-fitness
   Title: Product Card Fitness
   Description: Fitness class card with instructor, schedule, and booking for gym apps
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideClockCn, LucideDumbbellCn, LucideFlameCn, LucideMapPinCn, LucideUsersCn
   Source: original/blocks/product-card/product-card-fitness.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[160px]">
                <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <BadgeCn Class="absolute top-3 left-3">
                    <LucideDumbbellCn Class="mr-1 h-3 w-3" Size="12" />
                    @_product.Difficulty
                </BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold">@_product.Name</h3>
                <p class="mt-1 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                <div class="mt-3 flex items-center gap-3 text-xs text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideClockCn Class="h-3 w-3" Size="12" />
                        <span>@_product.Duration</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideFlameCn Class="h-3 w-3" Size="12" />
                        <span>@_product.Calories cal</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideMapPinCn Class="h-3 w-3" Size="12" />
                        <span>@_product.Location</span>
                    </div>
                </div>

                <div class="mt-4 flex items-center gap-3">
                    <AvatarCn Class="h-10 w-10">
                        <AvatarImageCn Src="@_product.Instructor.Avatar" />
                        <AvatarFallbackCn>@_product.Instructor.Name[0]</AvatarFallbackCn>
                    </AvatarCn>
                    <div>
                        <p class="text-sm font-medium">@_product.Instructor.Name</p>
                        <p class="text-xs text-muted-foreground">@_product.Instructor.Specialty</p>
                    </div>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">UPCOMING CLASSES</p>
                    <div class="space-y-2">
                        @foreach (var slot in _product.Schedule)
                        {
                            <div class="flex items-center justify-between rounded-lg border p-2">
                                <div class="flex items-center gap-3">
                                    <div class="text-center">
                                        <p class="text-xs font-medium">@slot.Day</p>
                                        <p class="text-xs text-muted-foreground">@slot.Time</p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideUsersCn Class="h-3 w-3" Size="12" />
                                        <span>@slot.SpotsLeft spots</span>
                                    </div>
                                    <ButtonCn Size="ButtonSize.Sm" Variant="@(slot.SpotsLeft <= 5 ? ButtonVariant.Default : ButtonVariant.Outline)">
                                        Book
                                    </ButtonCn>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">
                    View All Times
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record InstructorInfo(string Name, string Avatar, string Specialty);
    private record ScheduleSlot(string Day, string Time, int SpotsLeft);
    private record Product(string Name, string Description, string Image, string Duration, string Calories, string Difficulty, string Location, InstructorInfo Instructor, List<ScheduleSlot> Schedule);

    private static readonly Product _product = new(
        "HIIT Power Hour",
        "High-intensity interval training combining cardio and strength for maximum calorie burn.",
        "https://images.unsplash.com/photo-1534258936925-c58bed479fcb?w=400&q=80",
        "60 min", "500-700", "Intermediate", "Studio A",
        new("Marcus Johnson", "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&q=80", "Certified HIIT Trainer"),
        new()
        {
            new("Mon", "6:00 AM", 3),
            new("Wed", "6:00 AM", 8),
            new("Fri", "6:00 AM", 12),
        }
    );
}
