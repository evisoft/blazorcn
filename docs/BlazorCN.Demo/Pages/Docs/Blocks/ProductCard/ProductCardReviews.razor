@* ========================================
   Block: product-card-reviews
   Title: Product Card Reviews
   Description: Product card with quick review list and average rating for ecommerce stores
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, LucideCheckCn, LucideShoppingCartCn, LucideStarCn, SeparatorCn
   Source: original/blocks/product-card/product-card-reviews.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[700px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="grid md:grid-cols-[200px_1fr]">
                <div class="relative aspect-square md:aspect-square md:h-[200px]">
                    <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                    @if (_product.IsNew)
                    {
                        <BadgeCn Class="absolute top-3 left-3">New</BadgeCn>
                    }
                </div>

                <CardContentCn Class="flex flex-col p-5">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <h3 class="text-lg font-semibold">@_product.Name</h3>
                            <div class="mt-1 flex items-center gap-1">
                                <LucideStarCn Class="h-4 w-4 fill-primary text-primary" Size="16" />
                                <span class="text-sm font-medium">@_avgRating.ToString("F1")</span>
                                <span class="text-sm text-muted-foreground">(@_product.Reviews.Count reviews)</span>
                            </div>
                        </div>
                        <p class="text-xl font-bold tabular-nums">$@_product.Price.ToString("F2")</p>
                    </div>

                    <p class="mt-2 text-sm text-muted-foreground">@_product.Description</p>

                    <div class="mt-4 flex gap-2">
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                            <LucideShoppingCartCn Class="mr-2 h-4 w-4" Size="16" />
                            Add to Cart
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm">Buy Now</ButtonCn>
                    </div>

                    <SeparatorCn Class="my-4" />

                    <div>
                        <div class="mb-3 flex items-center justify-between">
                            <p class="text-xs font-medium text-muted-foreground">RECENT REVIEWS</p>
                            <button type="button" class="text-xs text-primary hover:underline">View all</button>
                        </div>

                        <div class="space-y-2">
                            @foreach (var review in _product.Reviews)
                            {
                                <div class="flex items-center justify-between text-sm">
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium">@review.Name</span>
                                        @if (review.Verified)
                                        {
                                            <BadgeCn Class="gap-0.5 text-xs" Variant="BadgeVariant.Secondary">
                                                <LucideCheckCn Class="h-3 w-3" Size="12" />
                                                Verified
                                            </BadgeCn>
                                        }
                                    </div>

                                    <div class="flex items-center gap-3">
                                        <span class="text-xs text-muted-foreground truncate max-w-[200px]">@review.Text</span>
                                        <div class="flex">
                                            @for (var star = 1; star <= 5; star++)
                                            {
                                                <LucideStarCn Class="@($"h-3 w-3 {(star <= review.Rating ? "fill-primary text-primary" : "fill-muted text-muted")}")" Size="12" />
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <button type="button" class="mt-3 w-full text-center text-xs text-primary hover:underline">Write a review</button>
                    </div>
                </CardContentCn>
            </div>
        </CardCn>
    </div>
</section>

@code {
    private double _avgRating => _product.Reviews.Average(r => r.Rating);

    private record Review(string Name, int Rating, string Text, bool Verified);
    private record Product(string Name, string Description, decimal Price, string Image, bool IsNew, List<Review> Reviews);

    private static readonly Product _product = new(
        "Ultra Tablet Pro",
        "Powerful tablet with stunning display, long battery life, and lightweight design.",
        499.99m, "https://images.unsplash.com/photo-1544244015-0df4b3ffc6b0?w=400&q=80", true,
        new()
        {
            new("David K.", 5, "Perfect for work and entertainment. Fast processor!", true),
            new("Maria L.", 4, "Great device, impressive screen quality.", false),
            new("Jason R.", 5, "Amazing battery life, lasts all day easily.", true),
        }
    );
}
