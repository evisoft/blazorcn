@* ========================================
   Block: product-card-language-course
   Title: Product Card Language Course
   Description: Language course card with proficiency level, lesson progress, and streak tracker for learning apps
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideBookOpenCn, LucideChevronRightCn, LucideFlameCn, LucidePlayCn, LucideStarCn, LucideTrophyCn, LucideZapCn, ProgressCn
   Source: original/blocks/product-card/product-card-language-course.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[320px] max-w-full">
        <CardCn Class="overflow-hidden">
            <CardContentCn Class="p-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="flex h-12 w-12 items-center justify-center rounded-full border text-2xl">
                            @_product.Flag
                        </div>
                        <div>
                            <h3 class="font-semibold">@_product.Language</h3>
                            <BadgeCn Class="@_levelColor">@_product.Level</BadgeCn>
                        </div>
                    </div>
                    <div class="flex items-center gap-1 rounded-full border px-2 py-1">
                        <LucideFlameCn Class="h-4 w-4 text-orange-500" Size="16" />
                        <span class="text-sm font-semibold tabular-nums">@_product.CurrentStreak</span>
                    </div>
                </div>

                <div class="mt-5 flex items-center gap-4">
                    <div class="relative h-20 w-20 shrink-0">
                        <svg aria-label="Lesson progress" class="h-20 w-20 -rotate-90" role="img">
                            <circle class="stroke-muted" cx="40" cy="40" fill="none" r="36" stroke-width="6" />
                            <circle class="stroke-primary" cx="40" cy="40" fill="none" r="36" stroke-dasharray="@($"{_progressPercent * 2.26} 226")" stroke-linecap="round" stroke-width="6" />
                        </svg>
                        <div class="absolute inset-0 flex flex-col items-center justify-center">
                            <span class="text-lg font-bold tabular-nums">@Math.Round(_progressPercent)%</span>
                        </div>
                    </div>

                    <div class="flex-1 space-y-2">
                        <div class="flex items-center justify-between text-sm">
                            <div class="flex items-center gap-1.5">
                                <LucideBookOpenCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                <span>Lessons</span>
                            </div>
                            <span class="font-medium tabular-nums">@_product.CompletedLessons/@_product.TotalLessons</span>
                        </div>
                        <div class="flex items-center justify-between text-sm">
                            <div class="flex items-center gap-1.5">
                                <LucideZapCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                <span>Total XP</span>
                            </div>
                            <span class="font-medium tabular-nums">@_product.TotalXP.ToString("N0")</span>
                        </div>
                        <div class="flex items-center justify-between text-sm">
                            <div class="flex items-center gap-1.5">
                                <LucideTrophyCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                <span>Best streak</span>
                            </div>
                            <span class="font-medium tabular-nums">@_product.LongestStreak days</span>
                        </div>
                    </div>
                </div>

                <div class="mt-4 rounded-lg border p-3">
                    <div class="flex items-center justify-between text-sm">
                        <span class="font-medium">Weekly Goal</span>
                        <span class="text-muted-foreground tabular-nums">@_product.WeeklyXP/@_product.WeeklyGoal XP</span>
                    </div>
                    <ProgressCn Class="mt-2 h-2" Value="@_weeklyProgressPercent" />
                    <p class="mt-1 text-xs text-muted-foreground">@(_product.WeeklyGoal - _product.WeeklyXP) XP to complete this week's goal</p>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">NEXT LESSON</p>
                    <div class="flex items-center justify-between rounded-lg border p-3">
                        <div class="flex items-center gap-3">
                            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-primary/10">
                                <LucidePlayCn Class="h-4 w-4 text-primary" Size="16" />
                            </div>
                            <div>
                                <p class="font-medium">@_product.NextLesson.Title</p>
                                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                    <span>@_product.NextLesson.Type</span>
                                    <span>&bull;</span>
                                    <span>@_product.NextLesson.Duration</span>
                                    <span>&bull;</span>
                                    <span class="flex items-center gap-0.5">
                                        <LucideStarCn Class="h-3 w-3" Size="12" />
                                        @_product.NextLesson.XpReward XP
                                    </span>
                                </div>
                            </div>
                        </div>
                        <LucideChevronRightCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                    </div>
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucidePlayCn Class="mr-2 h-4 w-4" Size="16" />
                    Continue Learning
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private double _progressPercent => (double)_product.CompletedLessons / _product.TotalLessons * 100;
    private double _weeklyProgressPercent => (double)_product.WeeklyXP / _product.WeeklyGoal * 100;

    private string _levelColor => _product.Level switch
    {
        "Beginner" => "bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200",
        "Intermediate" => "bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200",
        "Advanced" => "bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200",
        "Fluent" => "bg-amber-100 text-amber-800 dark:bg-amber-900 dark:text-amber-200",
        _ => ""
    };

    private record NextLesson(string Title, string Type, string Duration, int XpReward);
    private record Product(string Language, string Flag, string Level, int TotalLessons, int CompletedLessons, int CurrentStreak, int LongestStreak, int TotalXP, int WeeklyXP, int WeeklyGoal, NextLesson NextLesson);

    private static readonly Product _product = new(
        "Spanish", "\ud83c\uddea\ud83c\uddf8", "Intermediate",
        120, 47, 12, 28, 4850, 320, 500,
        new("Ordering at a Restaurant", "Conversation", "10 min", 25)
    );
}
