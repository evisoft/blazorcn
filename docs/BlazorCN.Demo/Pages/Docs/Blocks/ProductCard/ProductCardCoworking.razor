@* ========================================
   Block: product-card-coworking
   Title: Product Card Coworking
   Description: Coworking space card with desk type, amenities, and hourly/daily booking for workspace apps
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideCalendarCn, LucideClockCn, LucideCoffeeCn, LucideMapPinCn, LucideMonitorCn, LucidePrinterCn, LucideUsersCn, LucideWifiCn, LucideZapCn, ToggleGroupCn, ToggleGroupItemCn
   Source: original/blocks/product-card/product-card-coworking.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[340px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[160px]">
                <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                @if (_product.AvailableToday)
                {
                    <BadgeCn Class="absolute top-3 left-3">
                        <LucideZapCn Class="mr-1 h-3 w-3" Size="12" />
                        Available Today
                    </BadgeCn>
                }
                <div class="absolute top-3 right-3 flex items-center gap-1 rounded-full bg-background/90 px-2 py-1 text-xs font-medium backdrop-blur-sm">
                    <span class="text-primary">&#9733;</span>
                    <span>@_product.Rating</span>
                    <span class="text-muted-foreground">(@_product.ReviewCount)</span>
                </div>
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold">@_product.Name</h3>
                <div class="mt-1 flex items-center gap-1 text-sm text-muted-foreground">
                    <LucideMapPinCn Class="h-3 w-3" Size="12" />
                    <span>@_product.Location</span>
                </div>
                <div class="mt-1 flex items-center gap-1 text-sm text-muted-foreground">
                    <LucideClockCn Class="h-3 w-3" Size="12" />
                    <span>@_product.OpenHours</span>
                </div>

                <div class="mt-3 flex flex-wrap gap-3">
                    @foreach (var amenity in _amenities)
                    {
                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                            @amenity.Icon
                            <span>@amenity.Name</span>
                        </div>
                    }
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">WORKSPACE TYPE</p>
                    <div class="space-y-2">
                        @foreach (var type in _product.DeskTypes)
                        {
                            <button type="button"
                                class="@($"flex w-full items-center justify-between rounded-lg border p-3 text-left transition-colors hover:bg-muted/50 {(_selectedDesk == type.Id ? "border-primary bg-muted/50" : "")}")"
                                @onclick="@(() => _selectedDesk = type.Id)">
                                <div>
                                    <div class="flex items-center gap-2">
                                        <p class="font-medium">@type.Name</p>
                                        @if (type.Capacity > 1)
                                        {
                                            <span class="flex items-center gap-0.5 text-xs text-muted-foreground">
                                                <LucideUsersCn Class="h-3 w-3" Size="12" />
                                                @type.Capacity
                                            </span>
                                        }
                                    </div>
                                    <p class="text-xs text-muted-foreground">@type.Description</p>
                                </div>
                                <div class="text-right">
                                    <p class="font-semibold tabular-nums">$@type.DailyRate</p>
                                    <p class="text-xs text-muted-foreground">/day</p>
                                </div>
                            </button>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-xs font-medium text-muted-foreground">BOOKING TYPE</p>
                    <ToggleGroupCn Class="grid grid-cols-2" Type="ToggleGroupType.Single" @bind-Value="_bookingType">
                        <ToggleGroupItemCn Value="hourly">$@_desk.HourlyRate/hour</ToggleGroupItemCn>
                        <ToggleGroupItemCn Value="daily">$@_desk.DailyRate/day</ToggleGroupItemCn>
                    </ToggleGroupCn>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex items-center justify-between p-4 pt-0">
                <div>
                    <p class="text-xs text-muted-foreground">Starting from</p>
                    <p class="text-xl font-bold tabular-nums">
                        $@_currentRate
                        <span class="text-sm font-normal text-muted-foreground">/@(_bookingType == "hourly" ? "hr" : "day")</span>
                    </p>
                </div>
                <ButtonCn>
                    <LucideCalendarCn Class="mr-2 h-4 w-4" Size="16" />
                    Book Now
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _selectedDesk = "hot";
    private string _bookingType = "daily";

    private DeskType _desk => _product.DeskTypes.FirstOrDefault(d => d.Id == _selectedDesk) ?? _product.DeskTypes[0];
    private int _currentRate => _bookingType == "hourly" ? _desk.HourlyRate : _desk.DailyRate;

    private record AmenityItem(RenderFragment Icon, string Name);
    private record DeskType(string Id, string Name, string Description, int HourlyRate, int DailyRate, int Capacity);
    private record Product(string Name, string Location, string Image, double Rating, int ReviewCount, string OpenHours, List<DeskType> DeskTypes, bool AvailableToday);

    private List<AmenityItem> _amenities => new()
    {
        new((RenderFragment)(@<LucideWifiCn Class="h-3 w-3" Size="12" />), "High-speed WiFi"),
        new((RenderFragment)(@<LucideCoffeeCn Class="h-3 w-3" Size="12" />), "Free coffee"),
        new((RenderFragment)(@<LucidePrinterCn Class="h-3 w-3" Size="12" />), "Printing"),
        new((RenderFragment)(@<LucideMonitorCn Class="h-3 w-3" Size="12" />), "Monitors"),
    };

    private static readonly Product _product = new(
        "The Hive Downtown", "123 Innovation Blvd, Floor 12",
        "https://images.unsplash.com/photo-1497366216548-37526070297c?w=400&q=80",
        4.8, 124, "7 AM - 10 PM",
        new()
        {
            new("hot", "Hot Desk", "Any available desk", 8, 35, 1),
            new("dedicated", "Dedicated", "Your own desk", 12, 55, 1),
            new("private", "Private Office", "4-person room", 35, 150, 4),
        },
        true
    );
}
