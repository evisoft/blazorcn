@* ========================================
   Block: product-card-digital
   Title: Product Card Digital
   Description: Digital download product card with file info and instant delivery for stores
   Dependencies: BadgeCn, ButtonCn, CardCn, CardContentCn, CardFooterCn, LucideCheckCn, LucideDownloadCn, LucideFileTypeCn, LucideHardDriveCn, LucideZapCn
   Source: original/blocks/product-card/product-card-digital.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="relative h-[180px]">
                <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
                <BadgeCn Class="absolute top-3 left-3">
                    <LucideZapCn Class="mr-1 h-3 w-3" Size="12" />
                    Instant Download
                </BadgeCn>
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold">@_product.Name</h3>
                <p class="mt-1 text-sm text-muted-foreground line-clamp-2">@_product.Description</p>

                <div class="mt-3 flex items-center gap-3 text-xs text-muted-foreground">
                    <div class="flex items-center gap-1">
                        <LucideFileTypeCn Class="h-3 w-3" Size="12" />
                        <span>@_product.FileType</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideHardDriveCn Class="h-3 w-3" Size="12" />
                        <span>@_product.FileSize</span>
                    </div>
                </div>

                <div class="mt-3 flex flex-wrap gap-1">
                    @foreach (var format in _product.Formats)
                    {
                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">@format</BadgeCn>
                    }
                </div>

                <div class="mt-4">
                    <div class="grid grid-cols-2 gap-1">
                        @foreach (var feature in _product.Features)
                        {
                            <div class="flex items-center gap-1.5 text-xs">
                                <LucideCheckCn Class="h-3 w-3 text-primary" Size="12" />
                                <span>@feature</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="mt-4 flex items-center justify-between">
                    <div>
                        <span class="text-2xl font-bold tabular-nums">$@_product.Price</span>
                        <p class="text-xs text-muted-foreground">@_product.Downloads.ToString("N0") downloads</p>
                    </div>
                    <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">v@_product.Version</BadgeCn>
                </div>
            </CardContentCn>

            <CardFooterCn Class="flex-col gap-2 p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideDownloadCn Class="mr-2 h-4 w-4" Size="16" />
                    Purchase &amp; Download
                </ButtonCn>
                <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">Preview Files</ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private record Product(string Name, string Description, int Price, string Image, string FileType, string FileSize, string Version, int Downloads, string[] Formats, string[] Features);

    private static readonly Product _product = new(
        "Premium Icon Pack",
        "500+ pixel-perfect icons in multiple styles. Includes regular, solid, and duotone variants.",
        49, "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=400&q=80",
        "SVG, PNG, Figma", "48 MB", "2.4", 8420,
        new[] { "SVG", "PNG", "Figma", "Sketch" },
        new[] { "500+ unique icons", "3 style variants", "Lifetime updates", "Commercial license" }
    );
}
