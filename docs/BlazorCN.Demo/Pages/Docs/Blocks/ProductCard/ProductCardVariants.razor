@* ========================================
   Block: product-card-variants
   Title: Product Card Variants
   Description: Product card with color and size variant selectors for ecommerce stores
   Dependencies: ButtonCn, CardCn, CardContentCn, CardFooterCn, ToggleGroupCn, ToggleGroupItemCn, LucideShoppingCartCn, LucideStarCn
   Source: original/blocks/product-card/product-card-variants.tsx
   ======================================== *@

<section class="container mx-auto px-4 py-6">
    <div class="mb-6 text-center">
        <h1 class="text-3xl font-bold tracking-tight">Product Card</h1>
    </div>

    <div class="mx-auto w-[300px] max-w-full">
        <CardCn Class="overflow-hidden">
            <div class="h-[200px]">
                <img alt="@_product.Name" class="h-full w-full object-cover" height="400" src="@_product.Image" width="400" />
            </div>

            <CardContentCn Class="p-4">
                <h3 class="font-semibold leading-tight">@_product.Name</h3>

                <div class="mt-2 flex items-center gap-1">
                    <LucideStarCn Class="h-4 w-4 fill-primary text-primary" Size="16" />
                    <span class="text-sm font-medium">@_product.Rating</span>
                    <span class="text-sm text-muted-foreground">(@_product.ReviewCount)</span>
                </div>

                <p class="mt-3 text-2xl font-bold tabular-nums">$@_product.Price.ToString("F2")</p>

                <div class="mt-4">
                    <p class="mb-2 text-sm font-medium">
                        Color: <span class="text-muted-foreground">@_selectedColor</span>
                    </p>
                    <div class="flex gap-2">
                        @foreach (var color in _product.Colors)
                        {
                            var c = color;
                            <button type="button"
                                    class="@($"h-8 w-8 rounded-full border-2 transition-all {(_selectedColor == c.Name ? "border-primary ring-2 ring-primary ring-offset-2" : "border-border")}")"
                                    style="@($"background-color: {c.Value}")"
                                    title="@c.Name"
                                    @onclick="@(() => _selectedColor = c.Name)"></button>
                        }
                    </div>
                </div>

                <div class="mt-4">
                    <p class="mb-2 text-sm font-medium">Size</p>
                    <ToggleGroupCn Type="ToggleGroupType.Single" Value="@_selectedSize" ValueChanged="@(v => { if (!string.IsNullOrEmpty(v)) _selectedSize = v; })" Class="justify-start">
                        @foreach (var size in _product.Sizes)
                        {
                            <ToggleGroupItemCn Value="@size" Class="h-9 w-9 text-sm">@size</ToggleGroupItemCn>
                        }
                    </ToggleGroupCn>
                </div>
            </CardContentCn>

            <CardFooterCn Class="p-4 pt-0">
                <ButtonCn Class="w-full">
                    <LucideShoppingCartCn Class="mr-2 h-4 w-4" Size="16" />
                    Add to Cart
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _selectedColor = "Black";
    private string _selectedSize = "M";

    private record ColorOption(string Name, string Value);
    private record Product(string Name, decimal Price, string Image, decimal Rating, int ReviewCount, ColorOption[] Colors, string[] Sizes);

    private static readonly Product _product = new(
        "Cotton Crew T-Shirt", 39.99m,
        "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=400&q=80",
        4.6m, 189,
        new[] {
            new ColorOption("Black", "#000000"),
            new ColorOption("White", "#FFFFFF"),
            new ColorOption("Navy", "#1e3a5f"),
            new ColorOption("Gray", "#6b7280")
        },
        new[] { "XS", "S", "M", "L", "XL" }
    );
}
