@* ============================================================
   Block: stats-threshold-target-cards
   Title: StatsThresholdTargetCards
   Description: A threshold goal tile grid stats card for React and Next.js with four tiles whose border, status dot, and progress fill are keyed to a three-bucket threshold scale and printed threshold values beneath each label built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-threshold-target-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="mb-3 flex items-end justify-between">
        <div>
            <p class="text-sm font-medium">Service-level targets</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Production — last 5 minutes</p>
        </div>
        <p class="text-xs text-muted-foreground tabular-nums">4 targets monitored</p>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        @foreach (var tgt in _targets)
        {
            var status = StatusFor(tgt);
            var styles = _statusStyles[status];
            var percent = Math.Min(100, (int)Math.Round((tgt.Current / tgt.Max) * 100));

            <div class="@(Cn.Merge("rounded-lg border bg-card px-4 py-4", styles.Border))">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-1.5">
                            <span aria-hidden="true" class="@(Cn.Merge("size-1.5 rounded-full", styles.Dot))"></span>
                            <span class="sr-only">@styles.Label</span>
                            <p class="text-sm font-medium">@tgt.Label</p>
                        </div>
                        <p class="mt-1 text-[10px] font-medium uppercase tracking-widest text-muted-foreground tabular-nums">
                            Warn @(tgt.Warn)@(tgt.Unit) · Critical @(tgt.Critical)@(tgt.Unit)
                        </p>
                    </div>
                    <LucideIconCn Name="@styles.IconName" Size="16" Class="@(Cn.Merge("size-4 shrink-0", styles.Text))" />
                </div>

                <div class="mt-4 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@(tgt.Current)@(tgt.Unit)</span>
                    <span class="@(Cn.Merge("text-xs font-medium capitalize tabular-nums", styles.Text))">
                        @styles.Label
                    </span>
                </div>

                <div aria-valuemax="@((int)tgt.Max)"
                     aria-valuemin="0"
                     aria-valuenow="@((int)tgt.Current)"
                     class="@(Cn.Merge("mt-3 h-1.5 w-full overflow-hidden rounded-full", styles.TrackTint))"
                     role="progressbar">
                    <div class="@(Cn.Merge("h-full rounded-full transition-all duration-700 ease-out", styles.Bar))"
                         style="@($"width:{percent}%")"></div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private enum ThresholdStatus { Within, Observe, Critical }

    private record ThresholdTarget(string Id, string Label, string Unit, double Current, double Max, double Warn, double Critical);

    private record StatusStyleSet(string Border, string Dot, string Text, string Label, string Bar, string TrackTint, string IconName);

    private static readonly ThresholdTarget[] _targets =
    [
        new("cpu",    "CPU utilization",    "%", 38,  100, 70, 90),
        new("memory", "Memory pressure",    "%", 74,  100, 70, 90),
        new("errors", "5xx error rate",     "%",  4.2,  10,  1,  3),
        new("budget", "Monthly budget burn","%", 62,  100, 75, 95),
    ];

    private static readonly Dictionary<ThresholdStatus, StatusStyleSet> _statusStyles = new()
    {
        [ThresholdStatus.Within]   = new("border-emerald-500/40", "bg-emerald-500", "text-emerald-600 dark:text-emerald-400", "Within target", "bg-emerald-500", "bg-emerald-500/10", "circle-check"),
        [ThresholdStatus.Observe]  = new("border-amber-500/40",   "bg-amber-500",   "text-amber-600 dark:text-amber-400",   "Observe",        "bg-amber-500",   "bg-amber-500/10",   "circle-dot"),
        [ThresholdStatus.Critical] = new("border-red-500/40",     "bg-red-500",     "text-red-600 dark:text-red-400",       "Critical",       "bg-red-500",     "bg-red-500/10",     "circle-alert"),
    };

    private static ThresholdStatus StatusFor(ThresholdTarget tgt)
    {
        if (tgt.Current >= tgt.Critical) return ThresholdStatus.Critical;
        if (tgt.Current >= tgt.Warn)     return ThresholdStatus.Observe;
        return ThresholdStatus.Within;
    }
}
