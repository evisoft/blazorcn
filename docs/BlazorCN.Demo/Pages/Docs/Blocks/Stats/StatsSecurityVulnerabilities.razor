@* ========================================
   Block: stats-security-vulnerabilities
   Title: Stats Security Vulnerabilities
   Description: A security vulnerability dashboard displaying severity breakdown, remediation time, and vulnerability tracking
   Dependencies: None
   Source: original/blocks/stats/stats-security-vulnerabilities.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Security Vulnerabilities</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Current security posture</p>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Total</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_totalVulnerabilities</p>
                <p class="mt-0.5 text-xs text-emerald-600">-8 this week</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Critical</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums text-red-600">@(_severityStats[0].Count)</p>
                <p class="mt-0.5 text-xs text-muted-foreground">@_severityStats[0].AvgDays days avg</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">High</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums text-amber-600">@(_severityStats[1].Count)</p>
                <p class="mt-0.5 text-xs text-muted-foreground">@_severityStats[1].AvgDays days avg</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Resolved</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">124</p>
                <p class="mt-0.5 text-xs text-emerald-600">+18 this week</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Severity Distribution</h3>
            <div class="mt-2 flex h-1.5 overflow-hidden rounded-full bg-muted">
                @foreach (var stat in _severityStats)
                {
                    <div class="@($"h-full {stat.Color}")"
                         style="@(FormattableString.Invariant($"width: {(double)stat.Count / _totalVulnerabilities * 100}%"))"></div>
                }
            </div>
            <div class="mt-3 grid grid-cols-4 gap-2">
                @foreach (var stat in _severityStats)
                {
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="@($"h-2 w-2 rounded-full {stat.Color}")"></span>
                            <span class="text-xs capitalize text-muted-foreground">@stat.Severity</span>
                        </div>
                        <p class="mt-0.5 text-sm font-medium tabular-nums">@stat.Count</p>
                        <p class="text-xs text-muted-foreground">@stat.AvgDays.ToString("F1") days</p>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h3 class="text-sm font-medium">Active Vulnerabilities</h3>
                <span class="text-xs text-muted-foreground">@_vulnerabilities.Length open</span>
            </div>
        </div>

        <div class="border-b">
            @for (var i = 0; i < _vulnerabilities.Length; i++)
            {
                var vuln = _vulnerabilities[i];
                var isLast = i == _vulnerabilities.Length - 1;
                var severityColor = vuln.Severity switch { "critical" => "bg-red-500", "high" => "bg-amber-500", "medium" => "bg-blue-500", _ => "bg-emerald-500" };
                var statusColor = vuln.Status switch { "in-progress" => "bg-blue-500", _ => "bg-muted" };
                <div class="@($"px-4 py-2.5 {(isLast ? "" : "border-b")}")">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@($"h-1.5 w-1.5 shrink-0 rounded-full {severityColor}")"></span>
                                <span class="font-mono text-xs text-muted-foreground">@vuln.Id</span>
                                <span class="@($"h-1.5 w-1.5 shrink-0 rounded-full {statusColor}")"></span>
                            </div>
                            <p class="mt-0.5 text-sm font-medium">@vuln.Title</p>
                            <div class="mt-1 flex items-center gap-3">
                                <span class="text-xs text-muted-foreground">@vuln.Category</span>
                                <span class="text-xs text-muted-foreground">&middot;</span>
                                <span class="text-xs tabular-nums text-muted-foreground">
                                    @vuln.DaysOpen days open
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="px-4 py-3">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-xs font-medium text-muted-foreground">MTTR (Mean Time to Remediate)</p>
                    <p class="mt-1 text-sm tabular-nums">12.4 days</p>
                    <p class="mt-0.5 text-xs text-emerald-600">-2.3 days</p>
                </div>
                <div>
                    <p class="text-xs font-medium text-muted-foreground">SLA Compliance</p>
                    <p class="mt-1 text-sm tabular-nums">94.2%</p>
                    <p class="mt-0.5 text-xs text-emerald-600">+3.1%</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record VulnerabilityData(string Id, string Title, string Severity, string Category, int DaysOpen, string Status);
    private record SeverityStat(string Severity, int Count, double AvgDays, string Color);

    private static readonly VulnerabilityData[] _vulnerabilities =
    [
        new("CVE-2026-1234", "SQL Injection in user authentication", "critical", "Injection", 2, "in-progress"),
        new("CVE-2026-5678", "Cross-Site Scripting in search form", "high", "XSS", 8, "in-progress"),
        new("CVE-2026-9012", "Broken access control on API endpoints", "high", "Access Control", 15, "open"),
        new("CVE-2026-3456", "Outdated dependencies with known issues", "medium", "Dependencies", 22, "open"),
    ];

    private static readonly SeverityStat[] _severityStats =
    [
        new("critical", 3, 1.8, "bg-red-500"),
        new("high", 12, 5.2, "bg-amber-500"),
        new("medium", 28, 18.3, "bg-blue-500"),
        new("low", 45, 42.1, "bg-emerald-500"),
    ];

    private static readonly int _totalVulnerabilities = _severityStats.Sum(s => s.Count);
}
