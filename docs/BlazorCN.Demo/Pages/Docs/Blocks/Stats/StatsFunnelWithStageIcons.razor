@* ============================================================
   Block: stats-funnel-with-stage-icons
   Title: StatsFunnelWithStageIcons
   Description: A conversion funnel stats card for React and Next.js with per-stage Lucide icons in muted circle badges, proportional stage bars, and conversion-from-previous percentages built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-funnel-with-stage-icons.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Conversion funnel</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days</p>
            </div>
            <div class="text-right">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Overall
                </p>
                <p class="mt-0.5 text-sm font-semibold tabular-nums">@overallRate%</p>
            </div>
        </div>

        <ol class="divide-y">
            @foreach (var stage in _stages)
            {
                var widthPercent = (double)stage.Count / _topCount * 100;
                <li class="px-4 py-3" id="@stage.Id">
                    <div class="flex items-start gap-3">
                        <div aria-hidden="true"
                             class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted">
                            <LucideIconCn Name="@stage.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-2">
                                <div class="min-w-0">
                                    <p class="truncate text-sm font-medium">@stage.Name</p>
                                    <p class="mt-0.5 truncate text-xs text-muted-foreground">
                                        @stage.Description
                                    </p>
                                </div>
                                <div class="flex shrink-0 items-baseline gap-2">
                                    <span class="text-sm font-semibold tabular-nums">
                                        @stage.Count.ToString("N0")
                                    </span>
                                    @if (stage.ConversionFromPrev.HasValue)
                                    {
                                        <span class="text-xs font-medium tabular-nums text-muted-foreground">
                                            @(stage.ConversionFromPrev.Value.ToString("F1"))%
                                        </span>
                                    }
                                </div>
                            </div>
                            <div aria-label="@stage.Name"
                                 aria-valuemax="100"
                                 aria-valuemin="0"
                                 aria-valuenow="@((int)Math.Round(widthPercent))"
                                 class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted"
                                 role="progressbar">
                                <div class="h-full rounded-full bg-foreground transition-all duration-700 ease-out"
                                     style="@($"width:{widthPercent:F4}%")">
                                </div>
                            </div>
                        </div>
                    </div>
                </li>
            }
        </ol>
    </div>
</section>

@code {
    private record FunnelStage(string Id, string Name, string Description, string Icon, int Count, double? ConversionFromPrev);

    private static readonly FunnelStage[] _stages =
    [
        new("visit",     "Landing page viewed",  "Unique visitors",          "eye",                    48_520, null),
        new("cta",       "CTA clicked",           "Engaged pricing or signup", "mouse-pointer-click",    19_408, 40.0),
        new("signup",    "Account created",       "Completed signup form",    "user-plus",               7_860, 40.5),
        new("activated", "Activated",             "Reached aha moment",       "check-circle-2",          4_221, 53.7),
        new("retained",  "Retained (30 days)",    "Still active after 30d",   "heart",                   2_947, 69.8),
    ];

    private static readonly int _topCount = _stages[0].Count;
    private static readonly string overallRate = ((double)_stages[^1].Count / _topCount * 100).ToString("F2");
}
