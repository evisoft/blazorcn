@* ============================================================
   Block: stats-waterfall-chart-card
   Title: StatsWaterfallChartCard
   Description: A waterfall chart stats card for React and Next.js with Recharts BarChart rendering cumulative additions and subtractions as floating colored bars, emerald gains, red losses, foreground totals, NumberFlow net result, and connector logic built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-waterfall-chart-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">P&amp;L Waterfall</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Q1 2026</p>
            </div>
            <div class="text-right">
                <div class="min-w-[120px]">
                    <span class="text-2xl font-semibold tabular-nums">$160k</span>
                </div>
                <div class="mt-0.5 flex items-center justify-end gap-1">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                    <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                        +8.3% vs Q4
                    </span>
                </div>
            </div>
        </div>
        <div class="px-4 py-4">
            <div class="h-[220px] w-full">
                @{
                    var chartHeight = 200.0;
                    var chartWidth = 560.0;
                    var paddingLeft = 50.0;
                    var paddingRight = 8.0;
                    var paddingTop = 4.0;
                    var paddingBottom = 28.0;
                    var plotWidth = chartWidth - paddingLeft - paddingRight;
                    var plotHeight = chartHeight - paddingTop - paddingBottom;
                    var maxVal = 450_000.0;
                    var yTickStep = 100_000.0;
                    var barCount = _stackedBars.Length;
                    var barGroupWidth = plotWidth / barCount;
                    var barWidth = barGroupWidth * 0.55;
                    var barPadding = (barGroupWidth - barWidth) / 2.0;
                }
                <svg viewBox="0 0 @chartWidth @chartHeight" class="w-full h-full" aria-label="P&amp;L Waterfall Chart">
                    @* Y-axis grid lines and tick labels *@
                    @for (var tick = 0; tick <= 4; tick++)
                    {
                        var tickVal = tick * yTickStep;
                        var yPos = paddingTop + plotHeight - (tickVal / maxVal * plotHeight);
                        var label = $"${(tickVal / 1000):0}k";
                        @((MarkupString)FormattableString.Invariant($"<text x=\"{paddingLeft - 4}\" y=\"{yPos + 4}\" text-anchor=\"end\" font-size=\"11\" fill=\"currentColor\" opacity=\"0.5\">{label}</text>"))
                        <line x1="@paddingLeft" y1="@yPos.ToString(System.Globalization.CultureInfo.InvariantCulture)" x2="@(chartWidth - paddingRight)" y2="@yPos.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              stroke="currentColor" stroke-opacity="0.12" stroke-dasharray="3 3" />
                    }

                    @* Bars *@
                    @for (var i = 0; i < _stackedBars.Length; i++)
                    {
                        var bar = _stackedBars[i];
                        var x = paddingLeft + i * barGroupWidth + barPadding;
                        var invisibleHeight = bar.Invisible / maxVal * plotHeight;
                        var visibleHeight = bar.Visible / maxVal * plotHeight;
                        var barY = paddingTop + plotHeight - invisibleHeight - visibleHeight;
                        var fillColor = GetFillColor(bar.Type);
                        var labelY = paddingTop + plotHeight + 16.0;
                        var labelX = paddingLeft + i * barGroupWidth + barGroupWidth / 2.0;
                        @((MarkupString)FormattableString.Invariant($"<rect x=\"{x}\" y=\"{barY}\" width=\"{barWidth}\" height=\"{visibleHeight}\" fill=\"{fillColor}\" rx=\"3\" ry=\"3\" />"))
                        @((MarkupString)FormattableString.Invariant($"<text x=\"{labelX}\" y=\"{labelY}\" text-anchor=\"middle\" font-size=\"11\" fill=\"currentColor\" opacity=\"0.6\">{bar.Label}</text>"))
                    }
                </svg>
            </div>
        </div>
        <div class="flex items-center gap-4 border-t px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                <span class="size-2.5 rounded-sm" style="background-color: var(--foreground)"></span>
                <span class="text-xs text-muted-foreground">Totals</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-2.5 rounded-sm" style="background-color: oklch(0.6 0.18 155)"></span>
                <span class="text-xs text-muted-foreground">Additions</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-2.5 rounded-sm" style="background-color: oklch(0.6 0.2 25)"></span>
                <span class="text-xs text-muted-foreground">Subtractions</span>
            </div>
        </div>
    </div>
</section>

@code {
    private enum StepType { Addition, Subtraction, Total }

    private record WaterfallStep(string Id, string Label, int Value, StepType Type);

    private record StackedBar(string Label, double Invisible, double Visible, StepType Type, int RawValue);

    private static readonly WaterfallStep[] _waterfallData =
    [
        new("revenue",      "Revenue",      450_000, StepType.Total),
        new("cogs",         "COGS",        -120_000, StepType.Subtraction),
        new("gross",        "Gross Profit", 330_000, StepType.Total),
        new("sales",        "Sales",        -65_000, StepType.Subtraction),
        new("marketing",    "Marketing",    -42_000, StepType.Subtraction),
        new("rd",           "R&D",          -78_000, StepType.Subtraction),
        new("other-income", "Other Income",  15_000, StepType.Addition),
        new("net",          "Net Profit",   160_000, StepType.Total),
    ];

    private static readonly StackedBar[] _stackedBars = ComputeStackedBars(_waterfallData);

    private static StackedBar[] ComputeStackedBars(WaterfallStep[] data)
    {
        var result = new List<StackedBar>();
        double cumulative = 0;

        foreach (var step in data)
        {
            if (step.Type == StepType.Total)
            {
                result.Add(new StackedBar(step.Label, 0, step.Value, step.Type, step.Value));
                cumulative = step.Value;
            }
            else if (step.Type == StepType.Addition)
            {
                result.Add(new StackedBar(step.Label, cumulative, step.Value, step.Type, step.Value));
                cumulative += step.Value;
            }
            else
            {
                var absValue = Math.Abs(step.Value);
                result.Add(new StackedBar(step.Label, cumulative - absValue, absValue, step.Type, step.Value));
                cumulative -= absValue;
            }
        }

        return result.ToArray();
    }

    private static string GetFillColor(StepType stepType) => stepType switch
    {
        StepType.Total        => "var(--foreground)",
        StepType.Addition     => "oklch(0.6 0.18 155)",
        _                     => "oklch(0.6 0.2 25)",
    };
}
