@* ========================================
   Block: stats-targets
   Title: Stats Targets
   Description: Stats cards with target tracking, progress indicators, and status context for React performance dashboards
   Long Description: Support ticket stats with queue counts, SLA tracking, response times, and priority breakdown for React helpdesk dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-targets.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        @foreach (var item in data)
        {
            var config = GetStatusConfig(item.Status);

            <div class="overflow-hidden rounded-lg border bg-card">
                <div class="px-4 py-3">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium text-muted-foreground">@item.Name</span>
                        <div class="flex items-center gap-1.5">
                            <span class="@(Cn.Merge("size-1.5 rounded-full", config.DotColor))"></span>
                            <span class="@(Cn.Merge("text-xs font-medium", config.TextColor))">
                                @config.Label
                            </span>
                        </div>
                    </div>

                    <div class="mt-1 flex items-baseline gap-2">
                        <span class="text-2xl font-semibold tabular-nums">@item.Current</span>
                        <span class="text-sm text-muted-foreground">of @item.Target</span>
                    </div>

                    <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full transition-all", config.BarColor))"
                             style="width: @(Math.Min(item.Percentage, 100))%"></div>
                    </div>

                    <div class="mt-1.5 flex items-center justify-between text-xs">
                        <span class="@(Cn.Merge("font-medium tabular-nums", config.TextColor))">
                            @item.Percentage%
                        </span>
                        <span class="text-muted-foreground">@item.TimeLeft</span>
                    </div>
                </div>

                <div class="border-t px-4 py-2.5">
                    <span class="text-xs text-muted-foreground">@item.Trend</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record TargetItem(string Name, string Current, string Target, int Percentage, string Status, string TimeLeft, string Trend);
    private record StatusConfig(string Label, string DotColor, string TextColor, string BarColor);

    private static readonly TargetItem[] data = new[]
    {
        new TargetItem("Revenue", "$84,232", "$100,000", 84, "on-track", "8 days left", "+12% vs last period"),
        new TargetItem("New Customers", "1,849", "2,500", 74, "behind", "8 days left", "-5% vs last period"),
        new TargetItem("Conversion Rate", "4.2%", "3.5%", 100, "ahead", "Target exceeded", "+0.7% vs target"),
        new TargetItem("Active Users", "12,400", "15,000", 83, "on-track", "8 days left", "On pace"),
    };

    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        "on-track" => new StatusConfig("On track", "bg-emerald-500", "text-emerald-600 dark:text-emerald-400", "bg-primary"),
        "behind" => new StatusConfig("Behind", "bg-red-500", "text-red-600 dark:text-red-400", "bg-red-500"),
        "ahead" => new StatusConfig("Ahead", "bg-emerald-500", "text-emerald-600 dark:text-emerald-400", "bg-emerald-500"),
        _ => new StatusConfig("Unknown", "bg-muted-foreground", "text-muted-foreground", "bg-muted-foreground"),
    };
}
