@* ========================================
   Block: stats-error-rates
   Title: Stats Error Rates
   Description: HTTP error code breakdown and trending analysis showing 4xx and 5xx errors by endpoint
   Dependencies: None
   Source: original/blocks/stats/stats-error-rates.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Error Rate Analysis</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                HTTP error breakdown and failing endpoints
            </p>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Total Errors</div>
                <div class="mt-1 text-2xl font-semibold tabular-nums">
                    @((_overallStats.Total4xx + _overallStats.Total5xx).ToString("N0"))
                </div>
                <div class="mt-1 text-xs text-muted-foreground">
                    @(_overallStats.ErrorRate.ToString("F2"))% error rate
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">4xx Errors</div>
                <div class="mt-1 text-2xl font-semibold tabular-nums text-amber-500">
                    @_overallStats.Total4xx.ToString("N0")
                </div>
                <div class="mt-1 text-xs text-muted-foreground">Client errors</div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">5xx Errors</div>
                <div class="mt-1 text-2xl font-semibold tabular-nums text-red-500">
                    @_overallStats.Total5xx.ToString("N0")
                </div>
                <div class="mt-1 text-xs text-muted-foreground">Server errors</div>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var endpoint in _endpoints)
            {
                var hasHighErrors = endpoint.ErrorRate > 1;
                var has5xxErrors = endpoint.Errors5xx > 0;
                var totalErrors = endpoint.Errors4xx + endpoint.Errors5xx;

                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <code class="font-mono text-xs">@endpoint.Endpoint</code>
                                @if (hasHighErrors)
                                {
                                    <span class="@(Cn.Merge("size-1.5 rounded-full", has5xxErrors ? "bg-red-500" : "bg-amber-500"))"></span>
                                }
                            </div>
                            <div class="mt-1 text-xs text-muted-foreground">
                                @endpoint.TotalRequests.ToString("N0") requests
                            </div>

                            <div class="mt-3 grid grid-cols-3 gap-4">
                                <div>
                                    <div class="text-xs text-muted-foreground">Error Rate</div>
                                    <div class="@(Cn.Merge("mt-1 text-xl font-semibold tabular-nums", hasHighErrors ? "text-red-500" : ""))">
                                        @(endpoint.ErrorRate.ToString("F2"))%
                                    </div>
                                    <div class="mt-0.5 text-xs text-muted-foreground">
                                        @totalErrors total
                                    </div>
                                </div>

                                <div>
                                    <div class="text-xs text-muted-foreground">4xx Errors</div>
                                    <div class="mt-1 text-sm font-semibold tabular-nums">
                                        @endpoint.Errors4xx
                                    </div>
                                </div>

                                <div>
                                    <div class="text-xs text-muted-foreground">5xx Errors</div>
                                    <div class="@(Cn.Merge("mt-1 text-sm font-semibold tabular-nums", has5xxErrors ? "text-red-500" : ""))">
                                        @endpoint.Errors5xx
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 rounded-md bg-muted/50 px-3 py-2">
                                <div class="text-xs text-muted-foreground">Most Common Error</div>
                                <code class="mt-0.5 font-mono text-xs">@endpoint.MostCommon</code>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ErrorMetric(string Endpoint, int TotalRequests, int Errors4xx, int Errors5xx, string MostCommon, double ErrorRate);
    private record OverallStats(int TotalRequests, int Total4xx, int Total5xx, double ErrorRate);

    private static readonly ErrorMetric[] _endpoints =
    [
        new("/api/users", 45230, 234, 12, "404 Not Found", 0.54),
        new("/api/products", 38720, 156, 45, "500 Internal Server Error", 0.52),
        new("/api/orders", 28450, 89, 178, "503 Service Unavailable", 0.94),
        new("/api/analytics", 52340, 1240, 23, "401 Unauthorized", 2.41),
    ];

    private static readonly OverallStats _overallStats = new(164740, 1719, 258, 1.2);
}
