@* ============================================================
   Block: stats-funnel-vertical-stages
   Title: StatsFunnelVerticalStages
   Description: A vertical stacked funnel stats card for React and Next.js with full-width proportional stage bars, inline drop-off connectors, and tabular-nums conversion percentages built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-funnel-vertical-stages.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Subscription funnel</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days · 48,320 visitors</p>
            </div>
            <div class="text-right">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Overall
                </p>
                <div class="min-w-[70px]">
                    <span class="text-sm font-semibold tabular-nums">@($"{_overallConversion:F2}%")</span>
                </div>
            </div>
        </div>

        <div class="px-4 py-4">
            @for (int i = 0; i < _stages.Length; i++)
            {
                var index = i;
                var stage = _stages[index];
                var width = (double)stage.Count / _topCount * 100;
                var hasPrev = index > 0;
                var dropoff = hasPrev ? ((double)(_stages[index - 1].Count - stage.Count) / _stages[index - 1].Count) * 100 : 0.0;
                var tone = hasPrev ? GetDropoffTone(dropoff) : DropoffTone.Ok;
                var toneClass = tone == DropoffTone.Critical
                    ? "text-red-600 dark:text-red-400"
                    : tone == DropoffTone.Warning
                        ? "text-amber-600 dark:text-amber-400"
                        : "text-muted-foreground";

                <div>
                    @if (hasPrev)
                    {
                        <div class="flex items-center gap-2 pl-1 py-1.5">
                            <div aria-hidden="true" class="flex flex-col items-center">
                                <span class="block h-3 w-px bg-border"></span>
                                <LucideIconCn Name="arrow-down" Size="12" Class="@Cn.Merge("size-3", toneClass)" />
                            </div>
                            <div class="@Cn.Merge("flex items-center gap-1 text-xs font-medium tabular-nums", toneClass)">
                                @if (tone != DropoffTone.Ok)
                                {
                                    <LucideIconCn Name="triangle-alert" Size="12" Class="size-3" />
                                }
                                <span>-@($"{dropoff:F1}")%</span>
                                <span class="text-muted-foreground font-normal">drop-off</span>
                            </div>
                        </div>
                    }

                    <div class="py-1.5">
                        <div class="flex items-baseline justify-between gap-4">
                            <p class="text-sm font-medium">@stage.Name</p>
                            <p class="text-sm font-semibold tabular-nums">@stage.Count.ToString("N0")</p>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@stage.Hint</p>
                        <div aria-label="@stage.Name"
                             aria-valuemax="@_topCount"
                             aria-valuemin="0"
                             aria-valuenow="@stage.Count"
                             class="mt-2 h-2 w-full overflow-hidden rounded-sm bg-muted"
                             role="progressbar">
                            <div class="h-full rounded-sm bg-foreground transition-all duration-700 ease-out"
                                 style="@($"width:{width}%")">
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum DropoffTone { Ok, Warning, Critical }

    private record FunnelStage(string Id, string Name, int Count, string Hint);

    private static readonly FunnelStage[] _stages =
    [
        new("visit",      "Landing visit", 48_320, "Unique sessions"),
        new("view-plans", "Viewed plans",  19_840, "Scrolled pricing"),
        new("signup",     "Signed up",      6_210, "Account created"),
        new("activated",  "Activated",      3_580, "First event sent"),
        new("subscribed", "Subscribed",     1_240, "Paid plan upgrade"),
    ];

    private static int _topCount => _stages[0].Count;
    private static double _overallConversion => (double)_stages[^1].Count / _topCount * 100;

    private static DropoffTone GetDropoffTone(double dropoff)
    {
        if (dropoff >= 60) return DropoffTone.Critical;
        if (dropoff >= 40) return DropoffTone.Warning;
        return DropoffTone.Ok;
    }
}
