@* ========================================
   Block: stats-social
   Title: Stats Social
   Description: Social media stats with follower count, engagement rate, and platform breakdown
   Dependencies: None
   Source: original/blocks/stats/stats-social.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-sm font-medium">Total Audience</span>
                <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                    +@(_totalGrowth)%
                </span>
            </div>
            <p class="mt-1 text-2xl font-semibold tabular-nums">@_totalFollowers</p>
            <p class="mt-0.5 text-xs text-muted-foreground">followers across all platforms</p>
        </div>

        @* Engagement rate *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm text-muted-foreground">Engagement Rate</span>
            <span class="text-sm font-semibold tabular-nums">@(_engagementRate)%</span>
        </div>

        @* Platform breakdown *@
        <div class="px-4 py-3">
            <p class="mb-3 text-xs font-medium text-muted-foreground">By Platform</p>
            <div class="space-y-3">
                @foreach (var platform in _platforms)
                {
                    <div class="flex items-center gap-3">
                        <span class="@($"h-2 w-2 shrink-0 rounded-full {platform.Color}")"></span>
                        <span class="flex-1 text-sm font-medium">@platform.Name</span>
                        <span class="text-sm tabular-nums">@platform.Followers</span>
                        <span class="text-xs tabular-nums text-emerald-600 dark:text-emerald-400">
                            +@(platform.Growth)%
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5 text-center text-xs text-muted-foreground">
            Updated 2 hours ago
        </div>
    </div>
</section>

@code {
    private record PlatformData(string Name, string Followers, string Color, double Growth);

    private const string _totalFollowers = "248.5K";
    private const double _totalGrowth = 12.4;
    private const double _engagementRate = 4.8;

    private static readonly PlatformData[] _platforms =
    [
        new("Twitter", "89.2K", "bg-sky-500", 8.2),
        new("Instagram", "124.1K", "bg-pink-500", 15.6),
        new("LinkedIn", "35.2K", "bg-blue-600", 11.3),
    ];
}
