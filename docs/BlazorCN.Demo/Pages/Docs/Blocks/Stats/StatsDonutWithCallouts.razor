@* ============================================================
   Block: stats-donut-with-callouts
   Title: StatsDonutWithCallouts
   Description: A segment breakdown donut stats card for React and Next.js with positioned segment callouts, center total, and ChartContainer-wrapped PieChart built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-donut-with-callouts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Revenue by payment method</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days · 4 segments</p>
            </div>
            <p class="text-sm font-semibold tabular-nums">@_formattedTotal</p>
        </div>

        <div class="px-4 py-6">
            <div class="relative mx-auto aspect-square w-full max-w-[320px]">

                @* SVG donut chart *@
                <svg class="h-full w-full" viewBox="0 0 200 200">
                    @{
                        double cx = 100;
                        double cy = 100;
                        double outerR = 88;
                        double innerR = 60;
                        double startAngle = -90.0;
                        double totalVal = _segments.Sum(s => s.Value);

                        foreach (var seg in _segments)
                        {
                            double sweep = (seg.Value / totalVal) * 360.0;
                            double endAngle = startAngle + sweep;

                            double startRad = startAngle * Math.PI / 180.0;
                            double endRad = endAngle * Math.PI / 180.0;

                            double x1o = cx + outerR * Math.Cos(startRad);
                            double y1o = cy + outerR * Math.Sin(startRad);
                            double x2o = cx + outerR * Math.Cos(endRad);
                            double y2o = cy + outerR * Math.Sin(endRad);
                            double x1i = cx + innerR * Math.Cos(endRad);
                            double y1i = cy + innerR * Math.Sin(endRad);
                            double x2i = cx + innerR * Math.Cos(startRad);
                            double y2i = cy + innerR * Math.Sin(startRad);

                            int largeArc = sweep > 180 ? 1 : 0;

                            string d = FormattableString.Invariant($"M {x1o:F3} {y1o:F3} ") +
                                       FormattableString.Invariant($"A {outerR} {outerR} 0 {largeArc} 1 {x2o:F3} {y2o:F3} ") +
                                       FormattableString.Invariant($"L {x1i:F3} {y1i:F3} ") +
                                       FormattableString.Invariant($"A {innerR} {innerR} 0 {largeArc} 0 {x2i:F3} {y2i:F3} ") +
                                       "Z";

                            <path d="@d" fill="@seg.Fill" stroke="var(--background)" stroke-width="2" />

                            startAngle = endAngle;
                        }
                    }
                </svg>

                @* Center total *@
                <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center">
                    <p class="text-xl font-semibold tabular-nums">@_formattedTotal</p>
                    <p class="mt-0.5 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        Total
                    </p>
                </div>

                @* Positioned callouts — top (credit) *@
                <div class="absolute left-1/2 top-0 -translate-x-1/2 flex flex-col items-center text-center text-xs">
                    @{
                        var creditSeg = _segments.First(s => s.Id == "credit");
                        double creditPct = (creditSeg.Value / _total) * 100;
                    }
                    <div class="flex flex-col leading-tight">
                        <span class="text-xs font-medium">@creditSeg.Label</span>
                        <span class="text-xs tabular-nums text-muted-foreground">@(creditPct.ToString("F1"))%</span>
                    </div>
                    <span aria-hidden="true" class="mt-1 h-3 w-px bg-border"></span>
                </div>

                @* Positioned callouts — right (bank) *@
                <div class="absolute right-0 top-1/2 -translate-y-1/2 flex items-center gap-1 text-right text-xs">
                    @{
                        var bankSeg = _segments.First(s => s.Id == "bank");
                        double bankPct = (bankSeg.Value / _total) * 100;
                    }
                    <span aria-hidden="true" class="h-px w-3 bg-border order-first"></span>
                    <div class="flex flex-col leading-tight">
                        <span class="text-xs font-medium">@bankSeg.Label</span>
                        <span class="text-xs tabular-nums text-muted-foreground">@(bankPct.ToString("F1"))%</span>
                    </div>
                </div>

                @* Positioned callouts — bottom (wallet) *@
                <div class="absolute left-1/2 bottom-0 -translate-x-1/2 flex flex-col items-center text-center text-xs">
                    @{
                        var walletSeg = _segments.First(s => s.Id == "wallet");
                        double walletPct = (walletSeg.Value / _total) * 100;
                    }
                    <span aria-hidden="true" class="mb-1 h-3 w-px bg-border order-first"></span>
                    <div class="flex flex-col leading-tight">
                        <span class="text-xs font-medium">@walletSeg.Label</span>
                        <span class="text-xs tabular-nums text-muted-foreground">@(walletPct.ToString("F1"))%</span>
                    </div>
                </div>

                @* Positioned callouts — left (invoice) *@
                <div class="absolute left-0 top-1/2 -translate-y-1/2 flex items-center gap-1 text-left text-xs">
                    @{
                        var invoiceSeg = _segments.First(s => s.Id == "invoice");
                        double invoicePct = (invoiceSeg.Value / _total) * 100;
                    }
                    <div class="flex flex-col leading-tight">
                        <span class="text-xs font-medium">@invoiceSeg.Label</span>
                        <span class="text-xs tabular-nums text-muted-foreground">@(invoicePct.ToString("F1"))%</span>
                    </div>
                    <span aria-hidden="true" class="h-px w-3 bg-border"></span>
                </div>

            </div>
        </div>
    </div>
</section>

@code {
    private record Segment(string Id, string Label, double Value, string Fill);

    private static readonly Segment[] _segments =
    [
        new("credit",  "Credit card",    48_320, "oklch(0.646 0.222 41.116)"),
        new("bank",    "Bank transfer",  22_140, "oklch(0.6 0.118 184.704)"),
        new("wallet",  "Digital wallet",  9_860, "oklch(0.398 0.07 227.392)"),
        new("invoice", "Invoice",         4_120, "oklch(0.828 0.189 84.429)"),
    ];

    private static readonly double _total = _segments.Sum(s => s.Value);

    private static readonly string _formattedTotal =
        "$" + ((int)_total).ToString("N0");
}
