@* ========================================
   Block: stats-weather
   Title: Stats Weather
   Description: Weather conditions stats with temperature display, conditions icon, and daily forecast
   Dependencies: LucideCloudCn, LucideDropletsCn, LucideSunCn, LucideWindCn
   Source: original/blocks/stats/stats-weather.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header: location + condition *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="text-xs text-muted-foreground">@_location</div>
            <div class="flex items-center gap-1.5">
                <LucideCloudCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                <span class="text-sm font-medium">@_condition</span>
            </div>
        </div>

        @* Temperature + stats *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <div class="text-2xl font-semibold tabular-nums">@(_currentTemp)\u00B0</div>
                    <div class="mt-0.5 text-xs text-muted-foreground">Feels like @(_feelsLike)\u00B0</div>
                </div>
                <div class="flex items-center gap-4">
                    <div class="flex items-center gap-2">
                        <LucideDropletsCn Size="16" Class="h-4 w-4 text-blue-500" />
                        <div>
                            <div class="text-xs text-muted-foreground">Humidity</div>
                            <div class="text-sm font-medium tabular-nums">@(_humidity)%</div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideWindCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                        <div>
                            <div class="text-xs text-muted-foreground">Wind</div>
                            <div class="text-sm font-medium tabular-nums">@_windSpeed km/h</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* 5-day forecast *@
        <div class="px-4 py-3">
            <div class="mb-2 text-xs text-muted-foreground">5-Day Forecast</div>
            <div class="flex justify-between">
                @foreach (var day in _forecast)
                {
                    <div class="text-center">
                        <div class="text-xs text-muted-foreground">@day.Day</div>
                        <div class="mx-auto my-1.5">
                            @if (day.Condition == "sunny")
                            {
                                <LucideSunCn Size="16" Class="mx-auto h-4 w-4 text-amber-500" />
                            }
                            else if (day.Condition == "rainy")
                            {
                                <LucideDropletsCn Size="16" Class="mx-auto h-4 w-4 text-blue-500" />
                            }
                            else
                            {
                                <LucideCloudCn Size="16" Class="mx-auto h-4 w-4 text-muted-foreground" />
                            }
                        </div>
                        <div class="text-xs font-medium tabular-nums">@(day.High)\u00B0</div>
                        <div class="text-xs tabular-nums text-muted-foreground">@(day.Low)\u00B0</div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record DayForecast(string Day, int High, int Low, string Condition);

    private const int _currentTemp = 24;
    private const int _feelsLike = 26;
    private const string _condition = "Partly Cloudy";
    private const int _humidity = 58;
    private const int _windSpeed = 12;
    private const string _location = "San Francisco, CA";

    private static readonly DayForecast[] _forecast =
    [
        new("Mon", 24, 16, "cloudy"),
        new("Tue", 26, 17, "sunny"),
        new("Wed", 22, 15, "rainy"),
        new("Thu", 25, 16, "sunny"),
        new("Fri", 23, 14, "cloudy"),
    ];
}
