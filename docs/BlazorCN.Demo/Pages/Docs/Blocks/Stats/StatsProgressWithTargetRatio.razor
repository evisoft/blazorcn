@* ============================================================
   Block: stats-progress-with-target-ratio
   Title: StatsProgressWithTargetRatio
   Description: A progress list stats card for React and Next.js with per-row current/target tabular ratios, threshold-coloured thin progress bars, and semantic goal status built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-progress-with-target-ratio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Team goals</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Q2 2026 · Snapshot Apr 12</p>
            </div>
            <div class="text-right">
                <p class="text-sm font-semibold tabular-nums">@_onTrack/@_goals.Length</p>
                <p class="mt-0.5 text-xs text-muted-foreground">On track</p>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var goal in _goals)
            {
                var ratio = Math.Min((double)goal.Current / goal.Target, 1.0);
                var status = GetStatus((double)goal.Current / goal.Target);
                var style = _statusStyles[status];
                var percent = (int)Math.Round(ratio * 100);

                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0">
                            <div class="truncate text-sm font-medium">@goal.Label</div>
                            <div class="mt-0.5 flex items-center gap-1.5">
                                <span aria-hidden="true" class="@Cn.Merge("size-1.5 rounded-full", style.Dot)"></span>
                                <span class="@Cn.Merge("text-xs font-medium", style.Text)">@style.Label</span>
                                <span class="text-xs text-muted-foreground">· @goal.Owner</span>
                            </div>
                        </div>
                        <div class="shrink-0 text-right">
                            <div class="flex items-baseline justify-end gap-1 text-sm font-semibold tabular-nums">
                                <span>@FormatValue(goal.Current, goal.Unit)</span>
                                <span class="text-muted-foreground">/</span>
                                <span class="text-muted-foreground">@FormatValue(goal.Target, goal.Unit)</span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground tabular-nums">
                                @(goal.Unit != "$" && goal.Unit != "% met" ? goal.Unit : " ")
                            </p>
                        </div>
                    </div>
                    <div aria-label="@goal.Label"
                         aria-valuemax="@goal.Target"
                         aria-valuemin="0"
                         aria-valuenow="@goal.Current"
                         class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted"
                         role="progressbar">
                        <div class="@Cn.Merge("h-full rounded-full transition-all duration-700 ease-out", style.Bar)"
                             style="@($"width:{percent}%")"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum GoalStatus { OnTrack, Approaching, Missed }

    private record Goal(string Id, string Label, string Owner, double Current, double Target, string Unit);

    private record StatusStyle(string Bar, string Label, string Dot, string Text);

    private static readonly Goal[] _goals =
    [
        new("enterprise", "Enterprise pipeline closed", "Ayo · Enterprise", 38, 45, "deals"),
        new("midmarket", "Mid-market expansion revenue", "Priya · Mid-market", 842_000, 1_100_000, "$"),
        new("onboarding", "Onboarding completion", "Noa · Customer success", 164, 180, "accounts"),
        new("support", "Support first-response SLA", "Diego · Support", 92, 95, "% met"),
        new("nps", "Promoter responses collected", "Maya · Research", 210, 400, "responses"),
    ];

    private static readonly Dictionary<GoalStatus, StatusStyle> _statusStyles = new()
    {
        [GoalStatus.OnTrack]    = new("bg-emerald-500", "On track",    "bg-emerald-500", "text-emerald-600 dark:text-emerald-400"),
        [GoalStatus.Approaching] = new("bg-amber-500",  "Approaching", "bg-amber-500",   "text-amber-600 dark:text-amber-400"),
        [GoalStatus.Missed]     = new("bg-red-500",     "Missed",      "bg-red-500",     "text-red-600 dark:text-red-400"),
    };

    private static GoalStatus GetStatus(double ratio)
    {
        if (ratio >= 0.9) return GoalStatus.OnTrack;
        if (ratio >= 0.7) return GoalStatus.Approaching;
        return GoalStatus.Missed;
    }

    private static string FormatValue(double value, string unit)
    {
        if (unit == "$")
            return value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
        return value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
    }

    private int _onTrack => _goals.Count(g => GetStatus(g.Current / g.Target) == GoalStatus.OnTrack);
}
