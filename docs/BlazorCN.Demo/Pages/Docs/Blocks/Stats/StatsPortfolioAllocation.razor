@* ========================================
   Block: stats-portfolio-allocation
   Title: Stats Portfolio Allocation
   Description: Investment portfolio allocation stats with asset class distribution bars and performance indicators for React finance apps
   Long Description: A podcast analytics dashboard displaying episode downloads, listener retention, completion rate, and subscriber growth with visual breakdowns built with React, Next.js, and Tailwind CSS
   Dependencies: None
   Source: original/blocks/stats/stats-portfolio-allocation.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Portfolio</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@totalValue</p>
            </div>
            <div class="text-right">
                <p class="text-xs text-muted-foreground">YTD Return</p>
                <p class="text-sm font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                    +@(totalReturn)%
                </p>
            </div>
        </div>

        @* Allocation bar *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Allocation</p>
            <div class="flex h-2 overflow-hidden rounded-full">
                @foreach (var asset in assets)
                {
                    <div class="@(Cn.Merge("h-full", asset.Color))"
                         style="width: @(asset.Allocation)%"></div>
                }
            </div>
        </div>

        @* Asset breakdown *@
        <div>
            @for (var i = 0; i < assets.Length; i++)
            {
                var asset = assets[i];
                var isLast = i == assets.Length - 1;

                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", asset.Color))"></span>
                    <span class="flex-1 text-sm font-medium">@asset.Name</span>
                    <span class="text-xs tabular-nums text-muted-foreground">@asset.Value</span>
                    <span class="w-10 text-right text-xs font-medium tabular-nums">
                        @asset.Allocation%
                    </span>
                    <span class="@(Cn.Merge("w-12 text-right text-xs tabular-nums", asset.ReturnYtd >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"))">
                        @(asset.ReturnYtd > 0 ? "+" : "")@(asset.ReturnYtd)%
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AssetClass(string Name, int Allocation, string Value, double ReturnYtd, string Color);

    private const string totalValue = "$248,500";
    private const double totalReturn = 8.4;

    private static readonly AssetClass[] assets = new[]
    {
        new AssetClass("US Equities", 45, "$111,825", 12.3, "bg-blue-500"),
        new AssetClass("Int'l Equities", 20, "$49,700", 6.8, "bg-sky-500"),
        new AssetClass("Fixed Income", 20, "$49,700", 3.2, "bg-amber-500"),
        new AssetClass("Real Estate", 10, "$24,850", -1.4, "bg-purple-500"),
        new AssetClass("Cash", 5, "$12,425", 4.8, "bg-emerald-500"),
    };
}
