@* ============================================================
   Block: stats-hero-metric-with-sparkline
   Title: StatsHeroMetricWithSparkline
   Description: A compact hero metric stats card for React and Next.js with a NumberFlow animated text-4xl headline value, a semantic delta row, and a full-width ChartContainer sparkline AreaChart at the bottom built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-hero-metric-with-sparkline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-md p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-5 py-5">
            <p class="text-sm font-medium">@_metric.Label</p>
            <p class="mt-0.5 text-xs text-muted-foreground">@_metric.Timeframe</p>
            <div class="mt-4 min-w-[160px]">
                <span class="text-4xl font-semibold tabular-nums">@_metric.Value.ToString("N0")</span>
            </div>
            <div class="mt-2 flex items-center gap-1">
                <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
                <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                    +@(_metric.Delta)% vs previous period
                </span>
            </div>
        </div>

        <div class="border-t">
            <div class="h-16 w-full">
                <svg viewBox="0 0 @_svgWidth @_svgHeight" preserveAspectRatio="none" class="h-full w-full" aria-hidden="true">
                    <defs>
                        <linearGradient id="fill-hero-value" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" stop-color="oklch(0.646 0.222 41.116)" stop-opacity="0.35" />
                            <stop offset="100%" stop-color="oklch(0.646 0.222 41.116)" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <path d="@_areaPath" fill="url(#fill-hero-value)" />
                    <polyline points="@_linePath" fill="none" stroke="oklch(0.646 0.222 41.116)" stroke-width="1.75" stroke-linejoin="round" stroke-linecap="round" />
                </svg>
            </div>
        </div>
    </div>
</section>

@code {
    private record Metric(string Label, string Timeframe, int Value, double Delta);
    private record SparkPoint(int X, int ValueY);

    private static readonly Metric _metric = new("Monthly active users", "Last 30 days", 48_372, 12.4);

    private static readonly SparkPoint[] _sparkData =
    [
        new(1, 32_140),
        new(2, 33_820),
        new(3, 34_100),
        new(4, 35_640),
        new(5, 36_220),
        new(6, 37_890),
        new(7, 38_510),
        new(8, 40_140),
        new(9, 41_730),
        new(10, 42_880),
        new(11, 44_620),
        new(12, 46_310),
        new(13, 47_150),
        new(14, 48_372),
    ];

    private const int _svgWidth = 280;
    private const int _svgHeight = 64;

    private string _linePath = "";
    private string _areaPath = "";

    protected override void OnInitialized()
    {
        var minVal = 0;
        var maxVal = 0;
        foreach (var pt in _sparkData)
        {
            if (pt.ValueY < minVal || minVal == 0) minVal = pt.ValueY;
            if (pt.ValueY > maxVal) maxVal = pt.ValueY;
        }

        var range = maxVal - minVal;
        var padding = range * 0.1;
        var lo = minVal - padding;
        var hi = maxVal + padding;
        var totalRange = hi - lo;

        int n = _sparkData.Length;
        var pts = new (double px, double py)[n];
        for (int i = 0; i < n; i++)
        {
            double px = i * (_svgWidth - 1.0) / (n - 1);
            double py = _svgHeight - (_sparkData[i].ValueY - lo) / totalRange * _svgHeight;
            pts[i] = (px, py);
        }

        var lineParts = new System.Text.StringBuilder();
        var areaParts = new System.Text.StringBuilder();

        for (int i = 0; i < n; i++)
        {
            if (i > 0) lineParts.Append(' ');
            lineParts.Append($"{pts[i].px:F1},{pts[i].py:F1}");
        }

        areaParts.Append($"M {pts[0].px:F1},{_svgHeight}");
        for (int i = 0; i < n; i++)
        {
            areaParts.Append($" L {pts[i].px:F1},{pts[i].py:F1}");
        }
        areaParts.Append($" L {pts[n - 1].px:F1},{_svgHeight} Z");

        _linePath = lineParts.ToString();
        _areaPath = areaParts.ToString();
    }
}
