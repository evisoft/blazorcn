@* ============================================================
   Block: stats-quota-tile-grid
   Title: StatsQuotaTileGrid
   Description: A quota tile grid stats card for React and Next.js with six usage tiles, threshold-keyed progress bar colors, reset countdown subtitles, and used-over-limit ratios built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-quota-tile-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var quota in _quotas)
        {
            var percent = Math.Min(100, (int)Math.Round((double)quota.Used / quota.Limit * 100));
            var threshold = GetThreshold(percent);
            <div class="overflow-hidden rounded-lg border bg-card px-4 py-4" key="@quota.Id">
                <div class="flex items-start justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="@quota.IconName" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-sm font-medium">@quota.Label</span>
                    </div>
                    <span aria-label="@threshold"
                          class="@Cn.Merge("size-1.5 rounded-full", DotClass(threshold))"
                          role="img"></span>
                </div>

                <div class="mt-3 flex items-baseline justify-between gap-2">
                    <span class="text-sm font-semibold tabular-nums">
                        @FormatValue(quota.Used, quota.Unit)
                    </span>
                    <span class="text-xs text-muted-foreground tabular-nums">
                        of @FormatValue(quota.Limit, quota.Unit)
                    </span>
                </div>

                <div aria-valuemax="@quota.Limit"
                     aria-valuemin="0"
                     aria-valuenow="@quota.Used"
                     class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted"
                     role="progressbar">
                    <div class="@Cn.Merge("h-full rounded-full transition-all duration-700 ease-out", BarClass(threshold))"
                         style="@($"width:{percent}%")"></div>
                </div>

                <div class="mt-2 flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">@quota.ResetLabel</span>
                    <span class="@Cn.Merge("text-xs font-medium tabular-nums", TextClass(threshold))">
                        @(percent)%
                    </span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record QuotaItem(
        string Id,
        string Label,
        int Used,
        int Limit,
        string Unit,
        string ResetLabel,
        string IconName
    );

    private static readonly QuotaItem[] _quotas =
    [
        new("api",       "API requests",      728400,  1000000, "req", "Resets in 9 days",           "zap"),
        new("seats",     "Team seats",             14,      15, "",    "Resets on plan change",       "users"),
        new("storage",   "Object storage",        412,     500, "GB",  "Billing period · 9 days left","database"),
        new("bandwidth", "Bandwidth",            1120,    2000, "GB",  "Resets in 9 days",           "globe"),
        new("keys",      "API keys",                4,      20, "",    "No reset · hard limit",       "key"),
        new("builds",    "Serverless builds",      96,     100, "",    "Resets in 9 days",            "cloud"),
    ];

    private static string GetThreshold(int percent) =>
        percent >= 90 ? "critical" :
        percent >= 70 ? "observe"  :
                        "within";

    private static string BarClass(string threshold) => threshold switch
    {
        "critical" => "bg-red-500",
        "observe"  => "bg-amber-500",
        _          => "bg-emerald-500",
    };

    private static string DotClass(string threshold) => threshold switch
    {
        "critical" => "bg-red-500",
        "observe"  => "bg-amber-500",
        _          => "bg-emerald-500",
    };

    private static string TextClass(string threshold) => threshold switch
    {
        "critical" => "text-red-600 dark:text-red-400",
        "observe"  => "text-amber-600 dark:text-amber-400",
        _          => "text-emerald-600 dark:text-emerald-400",
    };

    private static string FormatValue(int value, string unit)
    {
        var grouped = value.ToString("N0");
        return string.IsNullOrEmpty(unit) ? grouped : $"{grouped} {unit}";
    }
}
