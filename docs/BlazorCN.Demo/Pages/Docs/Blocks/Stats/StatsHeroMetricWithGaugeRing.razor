@* ============================================================
   Block: stats-hero-metric-with-gauge-ring
   Title: StatsHeroMetricWithGaugeRing
   Description: A hero metric stats card for React and Next.js with a radial gauge ring surrounding a large NumberFlow percent value, Recharts PieChart with startAngle/endAngle, chart-1 progress arc, muted background ring, and a goal target subtext built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-hero-metric-with-gauge-ring.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-md p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Quarterly sales goal</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Q2 2026 · 47 days remaining</p>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                On track
            </span>
        </div>

        <div class="relative px-4 py-5">
            <div class="mx-auto aspect-square max-h-[180px] w-full">
                <svg viewBox="0 0 200 200" class="h-full w-full" aria-hidden="true">
                    <!-- muted background ring -->
                    <circle cx="100" cy="100" r="80" fill="none" stroke="var(--muted)" stroke-width="16" />
                    <!-- progress arc: 82.5% of full circle, starting at top (−90°) going clockwise -->
                    <circle
                        cx="100"
                        cy="100"
                        r="80"
                        fill="none"
                        stroke="oklch(0.646 0.222 41.116)"
                        stroke-width="16"
                        stroke-linecap="round"
                        stroke-dasharray="@($"{_progressDash} {_remainderDash}")"
                        transform="rotate(-90 100 100)" />
                </svg>
            </div>
            <div
                aria-label="Quarterly sales goal"
                aria-valuemax="100"
                aria-valuemin="0"
                aria-valuenow="@_percent"
                class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center"
                role="progressbar">
                <div class="min-w-[120px] text-center">
                    <span class="text-4xl font-semibold tabular-nums">@_percentFormatted</span>
                </div>
                <p class="mt-1 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Attainment
                </p>
            </div>
        </div>

        <div class="grid grid-cols-2 border-t">
            <div class="border-r px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="target" Size="12" Class="size-3 text-muted-foreground" />
                    <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        Booked / target
                    </p>
                </div>
                <p class="mt-1 text-sm font-semibold tabular-nums">
                    $@_currentK / $@_targetK
                </p>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                    <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        vs last qtr
                    </p>
                </div>
                <p class="mt-1 text-sm font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                    +@(_deltaPoints)pp
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private const int CurrentValue = 412_500;
    private const int TargetValue = 500_000;
    private const double DeltaPoints = 8.4;

    // percent = Math.Round((currentValue / targetValue) * 1000) / 10 = 82.5
    private static readonly double _percent = Math.Round((double)CurrentValue / TargetValue * 1000.0) / 10.0;

    private static readonly string _percentFormatted = $"{_percent:0.0}%";

    private static readonly string _currentK = $"{CurrentValue / 1000}k";
    private static readonly string _targetK = $"{TargetValue / 1000}k";
    private static readonly string _deltaPoints = $"{DeltaPoints:0.#}";

    // SVG circle circumference = 2 * π * r = 2 * π * 80 ≈ 502.655
    private static readonly double _circumference = 2.0 * Math.PI * 80.0;
    private static readonly string _progressDash = $"{_circumference * _percent / 100.0:0.###}";
    private static readonly string _remainderDash = $"{_circumference * (1.0 - _percent / 100.0):0.###}";
}
