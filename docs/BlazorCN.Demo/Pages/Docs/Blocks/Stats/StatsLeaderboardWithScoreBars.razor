@* ============================================================
   Block: stats-leaderboard-with-score-bars
   Title: StatsLeaderboardWithScoreBars
   Description: A ranked leaderboard stats card for React and Next.js with numbered rank columns, tabular-nums scores, and thin h-1.5 proportional score bars beneath each row scaled so rank one fills the full width and lower ranks shrink accordingly built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-leaderboard-with-score-bars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="award" Size="14" Class="size-3.5 text-muted-foreground" />
                    <p class="text-sm font-medium">Top sellers</p>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">Closed won Q1 2026</p>
            </div>
            <p class="text-xs font-medium tabular-nums text-muted-foreground">
                @_leaderboard.Length reps
            </p>
        </div>

        <ol>
            @foreach (var row in _leaderboard)
            {
                var percent = (row.Score / (double)_topScore) * 100;
                var isLast = row.Id == _leaderboard[_leaderboard.Length - 1].Id;
                <li class="@(isLast ? "px-4 py-3" : "border-b px-4 py-3")">
                    <div class="flex items-center justify-between gap-4">
                        <div class="flex min-w-0 flex-1 items-center gap-3">
                            <span class="w-5 shrink-0 font-mono text-xs text-muted-foreground tabular-nums">
                                @row.Rank.ToString("D2")
                            </span>
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-sm font-medium">@row.Name</p>
                                <p class="truncate text-xs text-muted-foreground">@row.Team</p>
                            </div>
                        </div>
                        <span class="shrink-0 text-sm font-semibold tabular-nums">
                            @FormatCurrency(row.Score)
                        </span>
                    </div>
                    <div aria-label="@($"{row.Name} score")"
                         aria-valuemax="100"
                         aria-valuemin="0"
                         aria-valuenow="@((int)Math.Round(percent))"
                         class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted"
                         role="progressbar">
                        <div class="h-full rounded-full bg-foreground transition-all duration-700 ease-out"
                             style="@(FormattableString.Invariant($"width: {percent:F2}%"))"></div>
                    </div>
                </li>
            }
        </ol>
    </div>
</section>

@code {
    private record LeaderboardRow(string Id, int Rank, string Name, string Team, int Score);

    private static readonly LeaderboardRow[] _leaderboard =
    [
        new("kira",  1, "Kira Tanaka",   "EMEA",    482_640),
        new("marco", 2, "Marco Leone",   "NA West",  418_290),
        new("aisha", 3, "Aisha Patel",   "APAC",    367_150),
        new("liam",  4, "Liam O'Brien",  "EMEA",    298_720),
        new("nora",  5, "Nora Schmidt",  "NA East",  247_980),
        new("diego", 6, "Diego Ramos",   "LATAM",   184_320),
        new("yuki",  7, "Yuki Mori",     "APAC",    129_450),
    ];

    private static readonly int _topScore = _leaderboard[0].Score;

    private static string FormatCurrency(int value) =>
        value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
}
