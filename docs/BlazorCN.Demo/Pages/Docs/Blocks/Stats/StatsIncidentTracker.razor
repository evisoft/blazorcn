@* ========================================
   Block: stats-incident-tracker
   Title: Stats Incident Tracker
   Description: Incident tracking stats with severity breakdown, open/resolved counts, and MTTR metrics
   Dependencies: None
   Source: original/blocks/stats/stats-incident-tracker.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <p class="text-sm font-medium">Incidents</p>
            <p class="text-xs text-muted-foreground">Last 30 days</p>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-2xl font-semibold tabular-nums">@_totalOpen</p>
                <p class="text-xs text-muted-foreground">Open</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-2xl font-semibold tabular-nums">@_totalResolved</p>
                <p class="text-xs text-muted-foreground">Resolved</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">@_mttr</p>
                <p class="text-xs text-muted-foreground">MTTR</p>
                <p class="mt-0.5 text-xs tabular-nums text-emerald-600 dark:text-emerald-400">
                    @_mttrTrend
                </p>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _severities.Length; i++)
            {
                var sev = _severities[i];
                var total = sev.Open + sev.Resolved;
                var resolvedPercent = total > 0 ? (double)sev.Resolved / total * 100 : 0;

                <div class="@(Cn.Merge("px-4 py-2.5", i < _severities.Length - 1 ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", sev.Color))"></span>
                            <span class="text-sm font-medium">@sev.Level</span>
                        </div>
                        <div class="flex items-center gap-3 text-xs text-muted-foreground">
                            <span>@sev.Open open</span>
                            <span>@sev.Resolved resolved</span>
                        </div>
                    </div>
                    <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-emerald-500 transition-all"
                             style="width: @(resolvedPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SeverityCount(string Level, int Open, int Resolved, string Color);

    private const int _totalOpen = 7;
    private const int _totalResolved = 143;
    private const string _mttr = "2h 18m";
    private const string _mttrTrend = "-12%";

    private static readonly SeverityCount[] _severities =
    [
        new("Critical", 1, 8, "bg-red-500"),
        new("High", 2, 35, "bg-amber-500"),
        new("Medium", 3, 62, "bg-blue-500"),
        new("Low", 1, 38, "bg-muted-foreground/50"),
    ];
}
