@* ========================================
   Block: stats-onboarding-steps
   Title: Stats Onboarding Steps
   Description: User onboarding checklist with completion rates per step, overall activation metrics, and drop-off analysis for optimizing first-run experience
   Long Description: Multi-step funnel visualization
   Dependencies: None
   Source: original/blocks/stats/stats-onboarding-steps.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Onboarding Completion</h3>
            <p class="mt-0.5 text-muted-foreground text-xs">Last 30 days new users</p>
        </div>

        <div class="grid grid-cols-2 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Activation Rate</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@(activationRate.ToString("F1"))%</p>
                <p class="mt-0.5 text-emerald-600 text-xs">+3.2%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">New Signups</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">
                    @onboardingSteps[0].Completed.ToString("N0")
                </p>
                <p class="mt-0.5 text-emerald-600 text-xs">+12.4%</p>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="space-y-3">
                @for (var i = 0; i < onboardingSteps.Length; i++)
                {
                    var step = onboardingSteps[i];
                    var index = i;
                    var completionRate = (double)step.Completed / step.Started * 100;
                    var overallRate = (double)step.Completed / onboardingSteps[0].Completed * 100;
                    var dropOffRate = index > 0 ? (double)(step.Started - step.Completed) / step.Started * 100 : 0;

                    <div>
                        <div class="mb-1.5 flex items-center justify-between">
                            <div class="flex items-center gap-2.5">
                                <div class="flex size-5 items-center justify-center rounded bg-muted text-xs font-medium tabular-nums">
                                    @(index + 1)
                                </div>
                                <div>
                                    <div class="text-sm font-medium">@step.Step</div>
                                    <div class="text-muted-foreground text-xs">@step.Description</div>
                                </div>
                            </div>
                            <div class="text-right">
                                <div class="text-sm font-semibold tabular-nums">
                                    @(completionRate.ToString("F0"))%
                                </div>
                                <div class="text-muted-foreground text-xs">
                                    @step.Completed/@step.Started
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-emerald-500"
                                     style="width: @(overallRate)%"></div>
                            </div>
                            @if (index > 0 && dropOffRate > 15)
                            {
                                <span class="text-red-600 text-xs">@(dropOffRate.ToString("F0"))% drop</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                <div>
                    <div class="text-sm font-medium">Fully Activated Users</div>
                    <div class="mt-0.5 text-muted-foreground text-xs">Completed all steps</div>
                </div>
                <div class="text-right">
                    <div class="text-xl font-semibold tabular-nums">
                        @onboardingSteps[^1].Completed
                    </div>
                    <div class="text-muted-foreground text-xs">
                        @(activationRate.ToString("F1"))% of signups
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record OnboardingStep(string Step, string Description, int Completed, int Started);

    private static readonly OnboardingStep[] onboardingSteps = new[]
    {
        new OnboardingStep("Create account", "Sign up completed", 1000, 1000),
        new OnboardingStep("Verify email", "Email confirmation", 850, 1000),
        new OnboardingStep("Complete profile", "Add name and photo", 680, 850),
        new OnboardingStep("Connect integration", "Link external account", 480, 680),
        new OnboardingStep("Invite team member", "Send first invite", 320, 480),
        new OnboardingStep("Complete first action", "Use core feature", 280, 320),
    };

    private static readonly double activationRate = (double)onboardingSteps[^1].Completed / onboardingSteps[0].Completed * 100;
}
