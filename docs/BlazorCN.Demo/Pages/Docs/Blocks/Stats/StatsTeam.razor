@* ========================================
   Block: stats-team
   Title: Stats Team
   Description: Team performance stats with member list, contribution bars, and role indicators for React team dashboards
   Long Description: Stats cards with target tracking, progress indicators, and status context for React performance dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-team.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header stats *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Team Performance</p>
                <p class="mt-0.5 text-2xl font-semibold tabular-nums">@totalTasks tasks</p>
            </div>
            <div class="text-right">
                <p class="text-xs text-muted-foreground">Avg. Score</p>
                <p class="text-sm font-semibold tabular-nums">@avgContribution%</p>
            </div>
        </div>

        @* Team members *@
        <div>
            @for (var i = 0; i < teamMembers.Length; i++)
            {
                var member = teamMembers[i];
                var isLast = i == teamMembers.Length - 1;

                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : ""))">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @member.Initials
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium truncate">@member.Name</span>
                                <span class="@(Cn.Merge("rounded px-1.5 py-0.5 text-[10px] font-medium", member.Role == "Lead" ? "bg-primary/10 text-primary" : "bg-muted text-muted-foreground"))">
                                    @member.Role
                                </span>
                            </div>
                            <span class="text-xs tabular-nums text-muted-foreground">
                                @member.Tasks tasks
                            </span>
                        </div>
                        <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-primary transition-all"
                                 style="width: @(member.Contribution)%"></div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5 text-xs text-muted-foreground">
            <span>@teamMembers.Length members</span>
            <span>This sprint</span>
        </div>
    </div>
</section>

@code {
    private record TeamMember(string Name, string Role, string Initials, int Contribution, int Tasks);

    private static readonly TeamMember[] teamMembers = new[]
    {
        new TeamMember("Sarah Chen", "Lead", "SC", 94, 47),
        new TeamMember("Alex Rivera", "Senior", "AR", 82, 38),
        new TeamMember("Jordan Lee", "Senior", "JL", 76, 35),
        new TeamMember("Taylor Kim", "Mid", "TK", 68, 29),
        new TeamMember("Morgan Wu", "Junior", "MW", 54, 22),
    };

    private static readonly int totalTasks = teamMembers.Sum(m => m.Tasks);
    private static readonly int avgContribution = (int)Math.Round((double)teamMembers.Sum(m => m.Contribution) / teamMembers.Length);
}
