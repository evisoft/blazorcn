@* ========================================
   Block: stats-project-burndown
   Title: Stats Project Burndown
   Description: A sprint burndown chart displaying total, completed, and remaining story points with velocity tracking
   Long Description: Usage stats with linear progress bars and limit indicators for React quota dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-project-burndown.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Sprint Burndown</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Sprint 24 &#xB7; Jan 15 - Jan 26</p>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Points</p>
                <p class="mt-1 font-semibold tabular-nums text-2xl">@_currentDay.Total</p>
                <p class="mt-0.5 text-amber-600 text-xs">+3 added</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Completed</p>
                <p class="mt-1 font-semibold tabular-nums text-2xl">@_currentDay.Completed</p>
                <p class="mt-0.5 text-emerald-600 text-xs">
                    @(Math.Round((double)_currentDay.Completed / _currentDay.Total * 100))%
                </p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Remaining</p>
                <p class="mt-1 font-semibold tabular-nums text-2xl">@_currentDay.Remaining</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @(Math.Round((double)_currentDay.Remaining / _currentDay.Total * 100))%
                </p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Days Left</p>
                <p class="mt-1 font-semibold tabular-nums text-2xl">@_daysRemaining</p>
                <p class="mt-0.5 text-muted-foreground text-xs">of @_totalDays days</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h3 class="font-medium text-sm">Burndown Chart</h3>
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1.5">
                        <span class="size-2 rounded-full bg-blue-500"></span>
                        <span class="text-muted-foreground text-xs">Actual</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="size-2 rounded-full bg-muted"></span>
                        <span class="text-muted-foreground text-xs">Ideal</span>
                    </div>
                </div>
            </div>
            <div class="relative mt-4 h-40">
                <svg viewBox="@($"0 0 {_sprintData.Length * 50} 100")" class="h-full w-full" preserveAspectRatio="none">
                    <title>Sprint burndown showing actual vs ideal progress</title>
                    @* Ideal line *@
                    <polyline points="@_idealPoints" fill="none" stroke="currentColor" stroke-width="1" class="text-muted" stroke-dasharray="4 4" />
                    @* Actual line *@
                    <polyline points="@_actualPoints" fill="none" stroke="currentColor" stroke-width="2" class="text-blue-500" />
                    @* Current point *@
                    <circle cx="@((_sprintData.Length - 1) * 50 + 25)" cy="@(100 - (double)_currentDay.Remaining / _currentDay.Total * 100)" r="3" class="fill-blue-500" />
                </svg>
                <div class="mt-2 flex justify-between text-xs">
                    @foreach (var d in _sprintData.Where((_, i) => i % 2 == 0))
                    {
                        <span class="text-muted-foreground">@d.Date</span>
                    }
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <h3 class="font-medium text-sm">Task Status</h3>
            <div class="mt-2 flex h-1.5 overflow-hidden rounded-full bg-muted">
                @foreach (var status in _taskStatus)
                {
                    <div class="@Cn.Merge("h-full", status.Color)" style="@($"width: {(double)status.Points / _currentDay.Total * 100}%")"></div>
                }
            </div>
            <div class="mt-3 grid grid-cols-3 gap-3">
                @foreach (var status in _taskStatus)
                {
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="@Cn.Merge("size-2 rounded-full", status.Color)"></span>
                            <span class="text-muted-foreground text-xs">@status.Name</span>
                        </div>
                        <p class="mt-0.5 font-medium tabular-nums text-sm">@status.Points pts</p>
                        <p class="text-muted-foreground text-xs">@status.Count tasks</p>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="font-medium text-muted-foreground text-xs">Velocity</p>
                    <p class="mt-1 tabular-nums text-sm">@_avgVelocity.ToString("F1") pts/day</p>
                </div>
                <div>
                    <p class="font-medium text-muted-foreground text-xs">Projected Completion</p>
                    <p class="@Cn.Merge("mt-1 tabular-nums text-sm", _projectedCompletion <= _daysRemaining ? "text-emerald-600" : "text-amber-600")">
                        @(_projectedCompletion > 0 ? $"{_projectedCompletion:F1} days" : "On track")
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record DayData(int Day, string Date, int Total, int Completed, int Remaining, int Ideal);
    private record TaskStatusItem(string Name, int Count, int Points, string Color);

    private readonly DayData[] _sprintData =
    [
        new(0, "Jan 15", 89, 0, 89, 89),
        new(1, "Jan 16", 89, 8, 81, 80),
        new(2, "Jan 17", 89, 18, 71, 71),
        new(3, "Jan 18", 89, 26, 63, 62),
        new(4, "Jan 19", 89, 35, 54, 53),
        new(5, "Jan 22", 89, 47, 42, 44),
        new(6, "Jan 23", 89, 58, 31, 35),
        new(7, "Jan 24", 92, 65, 27, 26),
    ];

    private readonly TaskStatusItem[] _taskStatus =
    [
        new("Done", 24, 65, "bg-emerald-500"),
        new("In Progress", 8, 18, "bg-blue-500"),
        new("To Do", 5, 9, "bg-muted"),
    ];

    private const int _totalDays = 10;
    private DayData _currentDay => _sprintData[^1];
    private int _daysRemaining => _totalDays - _currentDay.Day;
    private double _avgVelocity => _currentDay.Day > 0 ? (double)_currentDay.Completed / _currentDay.Day : 0;
    private double _projectedCompletion => _daysRemaining > 0 ? _currentDay.Remaining / _avgVelocity : 0;

    private string _idealPoints => string.Join(" ", _sprintData.Select((d, i) => $"{i * 50 + 25},{100 - (double)d.Ideal / _currentDay.Total * 100}"));
    private string _actualPoints => string.Join(" ", _sprintData.Select((d, i) => $"{i * 50 + 25},{100 - (double)d.Remaining / _currentDay.Total * 100}"));
}
