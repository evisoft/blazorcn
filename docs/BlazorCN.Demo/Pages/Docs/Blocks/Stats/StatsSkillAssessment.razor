@* ========================================
   Block: stats-skill-assessment
   Title: Stats Skill Assessment
   Description: A skill assessment dashboard displaying competency ratings, proficiency levels, skill gaps, and development recommendations
   Dependencies: None
   Source: original/blocks/stats/stats-skill-assessment.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Skill Assessment</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Employee competency overview</p>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Total Skills</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_totalSkills</p>
                <p class="mt-0.5 text-xs text-muted-foreground">assessed</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Avg Proficiency</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_avgProficiency.ToString("F0")%</p>
                <p class="mt-0.5 text-xs text-emerald-600">+4.2%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Target Avg</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_avgTarget.ToString("F0")%</p>
                <p class="mt-0.5 text-xs text-muted-foreground">goal level</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Skill Gap</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_skillGap.ToString("F0")%</p>
                <p class="mt-0.5 text-xs text-amber-600">to close</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h3 class="text-sm font-medium">Key Skills</h3>
                <span class="text-xs text-muted-foreground">@_skills.Length tracked</span>
            </div>
        </div>

        <div class="border-b">
            @for (var i = 0; i < _skills.Length; i++)
            {
                var skill = _skills[i];
                var isLast = i == _skills.Length - 1;
                var dotColor = skill.Proficiency >= skill.Target ? "bg-emerald-500" : skill.Proficiency >= skill.Target - 10 ? "bg-blue-500" : "bg-amber-500";
                <div class="@($"px-4 py-2.5 {(isLast ? "" : "border-b")}")">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@skill.Name</span>
                                <span class="@($"h-1.5 w-1.5 shrink-0 rounded-full {dotColor}")"></span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-xs text-muted-foreground">@skill.Category</span>
                                <span class="text-xs text-muted-foreground">&middot;</span>
                                <span class="text-xs text-muted-foreground">@skill.LastAssessed</span>
                            </div>
                            <div class="mt-2 space-y-1">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Current: @(skill.Proficiency)%</span>
                                    <span class="text-muted-foreground">Target: @(skill.Target)%</span>
                                </div>
                                <div class="relative h-1.5 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full bg-blue-500"
                                         style="@($"width: {skill.Proficiency}%")"></div>
                                    <div class="absolute top-0 h-full w-0.5 bg-foreground/30"
                                         style="@($"left: {skill.Target}%")"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Proficiency Distribution</h3>
            <div class="mt-2 flex h-1.5 overflow-hidden rounded-full bg-muted">
                @foreach (var level in _proficiencyLevels)
                {
                    <div class="@($"h-full {level.Color}")"
                         style="@($"width: {level.Percentage}%")"></div>
                }
            </div>
            <div class="mt-3 space-y-2">
                @foreach (var level in _proficiencyLevels)
                {
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@($"h-2 w-2 rounded-full {level.Color}")"></span>
                            <span class="text-sm">@level.Level</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-xs tabular-nums text-muted-foreground">
                                @level.Count skills
                            </span>
                            <span class="w-12 text-right text-sm tabular-nums">@(level.Percentage)%</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <h3 class="mb-2 text-sm font-medium">Recommended Development</h3>
            <div class="space-y-2">
                <div class="rounded-md bg-muted/50 p-3">
                    <p class="text-sm font-medium">System Design Training</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Close 15-point gap to reach target proficiency
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 p-3">
                    <p class="text-sm font-medium">Leadership Workshop</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Develop team management and communication skills
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SkillData(string Name, string Category, int Proficiency, int Target, string LastAssessed);
    private record ProficiencyLevel(string Level, int Count, int Percentage, string Color);

    private static readonly SkillData[] _skills =
    [
        new("React & TypeScript", "Frontend", 85, 90, "2 weeks ago"),
        new("Node.js & Express", "Backend", 78, 85, "1 month ago"),
        new("System Design", "Architecture", 65, 80, "3 weeks ago"),
        new("Team Leadership", "Soft Skills", 72, 85, "1 week ago"),
        new("Database Design", "Backend", 68, 75, "2 weeks ago"),
    ];

    private static readonly ProficiencyLevel[] _proficiencyLevels =
    [
        new("Expert (80-100)", 8, 32, "bg-emerald-500"),
        new("Advanced (60-79)", 12, 48, "bg-blue-500"),
        new("Intermediate (40-59)", 4, 16, "bg-amber-500"),
        new("Beginner (0-39)", 1, 4, "bg-red-500"),
    ];

    private static readonly double _avgProficiency = _skills.Average(s => (double)s.Proficiency);
    private static readonly double _avgTarget = _skills.Average(s => (double)s.Target);
    private static readonly double _skillGap = _avgTarget - _avgProficiency;
    private static readonly int _totalSkills = _proficiencyLevels.Sum(l => l.Count);
}
