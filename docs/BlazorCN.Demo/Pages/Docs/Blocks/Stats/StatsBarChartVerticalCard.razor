@* ============================================================
   Block: stats-bar-chart-vertical-card
   Title: StatsBarChartVerticalCard
   Description: A vertical bar chart stats card for React and Next.js with a ChartContainer-wrapped Recharts BarChart, single-series var(--chart-1) bars, tabular-nums hero total, and a day-of-week category axis built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-bar-chart-vertical-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Orders by day</p>
                <p class="mt-0.5 text-xs text-muted-foreground">This week - Apr 6 to Apr 12</p>
            </div>
            <div class="flex flex-col items-end">
                <div class="min-w-[140px] text-right">
                    <span class="text-2xl font-semibold tabular-nums">@_weeklyTotal.ToString("N0")</span>
                </div>
                <div class="mt-0.5 flex items-center gap-1">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
                    <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                        +18.4% vs last week
                    </span>
                </div>
            </div>
        </div>
        <div class="px-4 py-4">
            <div class="h-[200px] w-full">
                <svg viewBox="0 0 @_svgWidth @_svgHeight" class="h-full w-full overflow-visible" aria-label="Orders by day bar chart">
                    @{
                        var maxOrders = _chartData.Max(d => d.Orders);
                        var chartAreaTop = 8;
                        var chartAreaBottom = _svgHeight - 28;
                        var chartAreaHeight = chartAreaBottom - chartAreaTop;
                        var barCount = _chartData.Length;
                        var barWidth = 28;
                        var totalBarArea = _svgWidth - 32;
                        var barSpacing = (totalBarArea - barWidth * barCount) / (barCount - 1);
                        var startX = 16;

                        @* Horizontal grid lines *@
                        var gridLineCount = 4;
                        for (var gi = 0; gi <= gridLineCount; gi++)
                        {
                            var gy = chartAreaTop + (chartAreaHeight / gridLineCount) * gi;
                            <line x1="0" y1="@gy" x2="@_svgWidth" y2="@gy" stroke="currentColor" stroke-opacity="0.1" stroke-dasharray="3 3" />
                        }

                        @* Bars and X-axis labels *@
                        for (var i = 0; i < barCount; i++)
                        {
                            var pt = _chartData[i];
                            var barH = (double)pt.Orders / maxOrders * chartAreaHeight;
                            var barX = startX + i * (barWidth + barSpacing);
                            var barY = chartAreaTop + (chartAreaHeight - barH);
                            var labelX = barX + barWidth / 2;
                            var labelY = _svgHeight - 4;
                            var idx = i;

                            <rect x="@barX" y="@barY" width="@barWidth" height="@barH" rx="4" ry="4" style="fill:var(--chart-1,oklch(0.646 0.222 41.116))" />
                            @((MarkupString)$"<text x=\"{labelX}\" y=\"{labelY}\" text-anchor=\"middle\" font-size=\"11\" fill=\"currentColor\" opacity=\"0.6\">{pt.Day}</text>")
                        }
                    }
                </svg>
            </div>
        </div>
    </div>
</section>

@code {
    private record BarPoint(string Day, int Orders);

    private static readonly BarPoint[] _chartData =
    [
        new("Mon", 284),
        new("Tue", 312),
        new("Wed", 358),
        new("Thu", 421),
        new("Fri", 496),
        new("Sat", 612),
        new("Sun", 447),
    ];

    private static readonly int _weeklyTotal = _chartData.Sum(d => d.Orders);

    private const int _svgWidth = 480;
    private const int _svgHeight = 200;
}
