@* ============================================================
   Block: stats-progress-with-delta-badges
   Title: StatsProgressWithDeltaBadges
   Description: A progress list stats card for React and Next.js with label-left, pill-shaped delta badge right, and a thin linear progress bar beneath each row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-progress-with-delta-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Quota attainment</p>
                <p class="mt-0.5 text-xs text-muted-foreground">FY26 Q1 · through Apr 11</p>
            </div>
            <p class="text-xs font-medium tabular-nums text-muted-foreground">5 segments</p>
        </div>

        <ul class="divide-y">
            @foreach (var row in _quotas)
            {
                var percent = Math.Min(100.0, (double)row.Current / row.Target * 100.0);
                <li class="px-4 py-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-medium">@row.Label</p>
                            <p class="mt-0.5 truncate text-xs text-muted-foreground">@row.Subtitle</p>
                        </div>
                        <span class="@Cn.Merge("inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-[11px] font-medium tabular-nums", DeltaBadgeClass(row.DeltaType))">
                            @row.Delta
                        </span>
                    </div>

                    <div class="mt-2 flex items-baseline justify-between text-xs tabular-nums">
                        <span class="font-semibold">@FormatCurrency(row.Current)</span>
                        <span class="text-muted-foreground">
                            of @FormatCurrency(row.Target) · @(((int)Math.Round(percent)))%
                        </span>
                    </div>

                    <div aria-valuemax="@row.Target"
                         aria-valuemin="0"
                         aria-valuenow="@row.Current"
                         class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted"
                         role="progressbar">
                        <div class="@Cn.Merge("h-full rounded-full transition-all duration-700 ease-out", BarColorClass(row.Tier))"
                             style="@($"width:{percent:F0}%")"></div>
                    </div>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private enum BarTier { OnTrack, AtRisk, Behind }
    private enum DeltaType { Positive, Negative }

    private record QuotaRow(string Id, string Label, string Subtitle, int Current, int Target, string Delta, DeltaType DeltaType, BarTier Tier);

    private static readonly QuotaRow[] _quotas =
    [
        new("emea",      "EMEA enterprise",  "12 reps · 4 AEs",    2_840_000, 3_000_000, "+8.2%",  DeltaType.Positive, BarTier.OnTrack),
        new("amer",      "AMER mid-market",  "18 reps · 6 AEs",    1_960_000, 2_400_000, "+3.4%",  DeltaType.Positive, BarTier.AtRisk),
        new("apac",      "APAC SMB",         "9 reps · 3 AEs",       684_000, 1_200_000, "-6.8%",  DeltaType.Negative, BarTier.Behind),
        new("partners",  "Channel partners", "14 partners",         1_520_000, 1_600_000, "+12.1%", DeltaType.Positive, BarTier.OnTrack),
        new("selfserve", "Self-serve PLG",   "No assisted sales",     412_000,   600_000, "+1.8%",  DeltaType.Positive, BarTier.AtRisk),
    ];

    private static string BarColorClass(BarTier tier) => tier switch
    {
        BarTier.OnTrack => "bg-emerald-500/70 dark:bg-emerald-400/70",
        BarTier.AtRisk  => "bg-amber-500/70 dark:bg-amber-400/70",
        _               => "bg-red-500/70 dark:bg-red-400/70",
    };

    private static string DeltaBadgeClass(DeltaType deltaType) =>
        deltaType == DeltaType.Positive
            ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
            : "bg-red-500/10 text-red-600 dark:text-red-400";

    private static string FormatCurrency(int value)
    {
        if (value >= 1_000_000)
            return $"${value / 1_000_000.0:F1}M";
        if (value >= 1_000)
            return $"${value / 1_000.0:F0}K";
        return $"${value}";
    }
}
