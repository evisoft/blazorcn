@* ========================================
   Block: stats-help-center
   Title: Stats Help Center
   Description: Knowledge base analytics with article views, search queries, and resolution rates
   Dependencies: None
   Source: original/blocks/stats/stats-help-center.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Help Center Analytics</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days performance</p>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Total Views</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">24.5K</p>
                <p class="mt-0.5 text-xs text-emerald-600">+12.4%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Resolution Rate</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">68%</p>
                <p class="mt-0.5 text-xs text-emerald-600">+5.2%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Avg Rating</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">4.7</p>
                <p class="mt-0.5 text-xs text-emerald-600">+0.3</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <h4 class="text-sm font-medium">Top Articles</h4>
                <span class="text-xs text-muted-foreground">This month</span>
            </div>
            <div class="space-y-2.5">
                @for (var i = 0; i < _topArticles.Length; i++)
                {
                    var article = _topArticles[i];
                    var rank = i + 1;
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <span class="flex h-5 w-5 items-center justify-center rounded bg-muted text-xs font-medium tabular-nums text-muted-foreground">
                                @rank
                            </span>
                            <span class="text-sm">@article.Title</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <div class="flex items-center gap-1">
                                <span class="text-xs text-amber-500">&#x2605;</span>
                                <span class="text-xs font-medium tabular-nums">@article.Rating.ToString("F1")</span>
                            </div>
                            <span class="text-xs tabular-nums text-muted-foreground">
                                @article.Views.ToString("N0")
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <h4 class="text-sm font-medium">Top Search Queries</h4>
                <span class="text-xs text-muted-foreground">Content gaps</span>
            </div>
            <div class="space-y-2">
                @foreach (var query in _searchQueries)
                {
                    <div class="flex items-center justify-between rounded-md border bg-muted/30 px-3 py-2">
                        <div class="flex items-center gap-2">
                            <span class="@($"h-1.5 w-1.5 rounded-full {(query.Resolved ? "bg-emerald-500" : "bg-red-500")}")"></span>
                            <span class="text-sm">@query.Query</span>
                        </div>
                        <span class="text-xs tabular-nums text-muted-foreground">
                            @query.Count searches
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TopArticle(string Title, int Views, double Rating);
    private record SearchQuery(string Query, int Count, bool Resolved);

    private static readonly TopArticle[] _topArticles =
    [
        new("How to reset your password", 3420, 4.8),
        new("Billing and payment FAQs", 2890, 4.6),
        new("Getting started guide", 2450, 4.9),
    ];

    private static readonly SearchQuery[] _searchQueries =
    [
        new("refund policy", 245, true),
        new("cancel subscription", 189, true),
        new("api rate limits", 156, false),
        new("data export", 134, false),
    ];
}
