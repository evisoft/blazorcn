@* ============================================================
   Block: stats-before-after-card
   Title: StatsBeforeAfterCard
   Description: A before-and-after comparison stats card for React and Next.js with a left before value, centered delta callout, right NumberFlow animated after value, and a mini-timeline footer built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-before-after-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Checkout conversion</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Experiment #482 · winning variant
                </p>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                Shipped
            </span>
        </div>

        @* Before / After grid *@
        <dl class="grid grid-cols-[1fr_auto_1fr] items-center gap-4 px-4 py-5">
            <div class="text-center sm:text-right">
                <dt class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Before
                </dt>
                <dd class="mt-1 text-2xl font-semibold tabular-nums text-muted-foreground">
                    @BeforeValue.ToString("F2")%
                </dd>
                <p class="mt-0.5 text-xs text-muted-foreground">Control</p>
            </div>

            <div class="@Cn.Merge("flex size-10 shrink-0 items-center justify-center rounded-full border", DeltaBg)">
                <LucideIconCn Name="arrow-right" Size="16" Class="@Cn.Merge("size-4", DeltaColor)" />
            </div>

            <div class="text-center sm:text-left">
                <dt class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    After
                </dt>
                <dd class="mt-1 min-w-[140px]">
                    <span class="text-3xl font-semibold tabular-nums">
                        @AfterValue.ToString("F2")%
                    </span>
                </dd>
                <p class="mt-0.5 text-xs text-muted-foreground">Variant B</p>
            </div>
        </dl>

        @* Footer: delta + mini-timeline *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between gap-4">
                <p class="text-xs text-muted-foreground">Delta</p>
                <div class="flex items-baseline gap-2">
                    <span class="@Cn.Merge("text-sm font-semibold tabular-nums", DeltaColor)">
                        +@Delta.ToString("F2") pts
                    </span>
                    <span class="@Cn.Merge("text-xs font-medium tabular-nums", DeltaColor)">
                        (+@PercentChange.ToString("F1")%)
                    </span>
                </div>
            </div>

            <div class="mt-2 flex h-6 items-end gap-0.5">
                @foreach (var pt in Timeline)
                {
                    var height = (pt - TimelineMin) / (TimelineMax - TimelineMin) * 100.0;
                    var h = Math.Max(12.0, height);
                    <div class="flex-1 rounded-sm bg-foreground/30" style="@($"height:{h:F0}%")"></div>
                }
            </div>
            <p class="mt-1.5 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                14-day ramp
            </p>
        </div>
    </div>
</section>

@code {
    private const double BeforeValue = 2.14;
    private const double AfterValue = 3.48;
    private static readonly double Delta = AfterValue - BeforeValue;
    private static readonly double PercentChange = (AfterValue - BeforeValue) / BeforeValue * 100.0;
    private static readonly bool IsImprovement = AfterValue > BeforeValue;

    private static readonly double[] Timeline = [2.14, 2.18, 2.22, 2.31, 2.29, 2.4, 2.52, 2.67, 2.83, 3.01, 3.12, 3.24, 3.36, 3.48];
    private static readonly double TimelineMax = 3.48;
    private static readonly double TimelineMin = 2.14;

    private static string DeltaColor => IsImprovement
        ? "text-emerald-600 dark:text-emerald-400"
        : "text-red-600 dark:text-red-400";

    private static string DeltaBg => IsImprovement
        ? "bg-emerald-500/10 border-emerald-500/40"
        : "bg-red-500/10 border-red-500/40";
}
