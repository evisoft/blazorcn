@* ========================================
   Block: stats-employee-overview
   Title: Stats Employee Overview
   Description: HR workforce stats with headcount, department distribution, turnover rate, and open positions
   Dependencies: None
   Source: original/blocks/stats/stats-employee-overview.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Workforce</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Q1 2025 overview</p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-semibold tabular-nums">@_totalHeadcount</p>
                <p class="mt-0.5 text-xs text-emerald-600 dark:text-emerald-400">
                    @_netChange this quarter
                </p>
            </div>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">@_turnoverRate</p>
                <p class="text-xs text-muted-foreground">Turnover</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">@_openPositions</p>
                <p class="text-xs text-muted-foreground">Open Roles</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">@_avgTenure</p>
                <p class="text-xs text-muted-foreground">Avg Tenure</p>
            </div>
        </div>

        <div>
            @for (var i = 0; i < _departments.Length; i++)
            {
                var dept = _departments[i];
                var barWidth = (double)dept.Count / _maxCount * 100;

                <div class="@(Cn.Merge("px-4 py-2.5", i < _departments.Length - 1 ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium">@dept.Name</span>
                        <div class="flex items-center gap-2">
                            <span class="text-sm tabular-nums">@dept.Count</span>
                            @if (dept.Change != 0)
                            {
                                <span class="@(Cn.Merge("text-xs tabular-nums", dept.Change > 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"))">
                                    @(dept.Change > 0 ? "+" : "")@dept.Change
                                </span>
                            }
                        </div>
                    </div>
                    <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-primary transition-all"
                             style="width: @(barWidth.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Department(string Name, int Count, int Change);

    private const int _totalHeadcount = 284;
    private const string _netChange = "+12";
    private const string _turnoverRate = "8.2%";
    private const int _openPositions = 18;
    private const string _avgTenure = "2.4 yrs";

    private static readonly Department[] _departments =
    [
        new("Engineering", 94, 5),
        new("Sales", 52, 3),
        new("Marketing", 38, 2),
        new("Product", 31, 1),
        new("Operations", 28, -1),
        new("Support", 24, 2),
        new("Finance", 17, 0),
    ];

    private static readonly int _maxCount = _departments.Max(d => d.Count);
}
