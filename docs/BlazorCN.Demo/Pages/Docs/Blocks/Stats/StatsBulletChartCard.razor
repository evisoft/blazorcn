@* ============================================================
   Block: stats-bullet-chart-card
   Title: StatsBulletChartCard
   Description: A bullet chart stats card for React and Next.js with four horizontal bullet graphs showing actual values against qualitative range backgrounds and target markers, pure CSS implementation, and tabular-nums value displays built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-bullet-chart-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Performance scorecard</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Q1 2026 vs targets</p>
        </div>
        <div class="divide-y">
            @foreach (var b in _bullets)
            {
                var actualPct = (b.Actual / b.Max) * 100.0;
                var targetPct = (b.Target / b.Max) * 100.0;
                var isAboveTarget = b.Actual >= b.Target;

                <div class="px-4 py-3">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium">@b.Label</span>
                        <div class="flex items-baseline gap-2">
                            <span class="@Cn.Merge("text-sm font-semibold tabular-nums", isAboveTarget ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                @FormatValue(b.Actual, b.Unit)
                            </span>
                            <span class="text-xs text-muted-foreground tabular-nums">
                                / @FormatValue(b.Target, b.Unit)
                            </span>
                        </div>
                    </div>
                    <div class="relative mt-2 h-5 w-full overflow-hidden rounded-sm">
                        @* Qualitative ranges *@
                        <div class="absolute inset-0 flex">
                            <div class="h-full bg-muted/30" style="width:33.33%"></div>
                            <div class="h-full bg-muted/60" style="width:33.33%"></div>
                            <div class="h-full bg-muted" style="width:33.34%"></div>
                        </div>
                        @* Actual bar *@
                        <div class="absolute inset-y-1 left-0 rounded-sm bg-foreground transition-all duration-500"
                             style="@($"width:{Math.Min(actualPct, 100):F2}%")"
                             role="progressbar"
                             aria-valuenow="@b.Actual"
                             aria-valuemin="0"
                             aria-valuemax="@b.Max">
                        </div>
                        @* Target marker *@
                        <div class="absolute inset-y-0 w-0.5 bg-red-600 dark:bg-red-400"
                             style="@($"left:{targetPct:F2}%")"
                             aria-label="@($"Target: {FormatValue(b.Target, b.Unit)}")">
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="flex items-center gap-4 border-t px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                <span class="h-3 w-5 rounded-sm bg-foreground"></span>
                <span class="text-xs text-muted-foreground">Actual</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="h-3 w-0.5 bg-red-600 dark:bg-red-400"></span>
                <span class="text-xs text-muted-foreground">Target</span>
            </div>
            <div class="flex items-center gap-1.5">
                <div class="flex h-3 w-5 overflow-hidden rounded-sm">
                    <div class="h-full w-1/3 bg-muted/30"></div>
                    <div class="h-full w-1/3 bg-muted/60"></div>
                    <div class="h-full w-1/3 bg-muted"></div>
                </div>
                <span class="text-xs text-muted-foreground">Poor / OK / Good</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record BulletMetric(string Id, string Label, string Unit, double Actual, double Target, double Max);

    private static readonly BulletMetric[] _bullets =
    [
        new("revenue",     "Revenue",      "$",  275,  250,  300),
        new("profit",      "Profit margin", "%",   22,   25,   30),
        new("satisfaction","CSAT score",    "",   4.2,  4.5,  5.0),
        new("uptime",      "Uptime SLA",   "%",  99.7, 99.9, 100),
    ];

    private static string FormatValue(double value, string unit)
    {
        if (unit == "$") return $"${value}k";
        if (unit == "%") return $"{value}%";
        return value.ToString("F1");
    }
}
