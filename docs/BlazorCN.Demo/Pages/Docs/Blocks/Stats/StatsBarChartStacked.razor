@* ============================================================
   Block: stats-bar-chart-stacked
   Title: StatsBarChartStacked
   Description: A stacked bar chart stats card for React and Next.js with a ChartContainer-wrapped BarChart, three stacked series in var(--chart-1..3), a compact header with hero total, and a dot-pill legend built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-bar-chart-stacked.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Revenue by channel</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 8 weeks</p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-semibold tabular-nums">@_formattedTotal</p>
                <p class="text-xs text-muted-foreground">Total booked</p>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b px-4 py-2">
            @foreach (var entry in _legend)
            {
                <div class="flex items-center gap-1.5">
                    <span aria-hidden="true" class="size-2 rounded-sm" style="@($"background-color: var(--color-{entry.Key})")"></span>
                    <span class="text-xs text-muted-foreground">@entry.Label</span>
                </div>
            }
        </div>

        <div class="px-4 py-4">
            <div class="h-[200px] w-full">
                <svg class="w-full h-full" viewBox="0 0 560 200" preserveAspectRatio="none">
                    <defs>
                        <style>
                            .chart-bar-subscriptions { fill: var(--chart-1); }
                            .chart-bar-oneTime { fill: var(--chart-2); }
                            .chart-bar-services { fill: var(--chart-3); }
                        </style>
                    </defs>

                    @{
                        var chartW = 560;
                        var chartH = 200;
                        var paddingLeft = 0;
                        var paddingTop = 4;
                        var paddingBottom = 24;
                        var plotH = chartH - paddingTop - paddingBottom;
                        var barCount = _chartData.Length;
                        var groupW = (chartW - paddingLeft) / (double)barCount;
                        var barPad = groupW * 0.3;
                        var barW = groupW - barPad;
                        var maxStack = _chartData.Max(d => d.Subscriptions + d.OneTime + d.Services);

                        /* Grid lines */
                        var gridSteps = 4;
                        for (int gi = 0; gi <= gridSteps; gi++)
                        {
                            var gy = paddingTop + plotH * gi / gridSteps;
                            <line x1="0" y1="@gy.ToString("F1")" x2="@chartW" y2="@gy.ToString("F1")" stroke="currentColor" stroke-opacity="0.1" stroke-dasharray="3 3" />
                        }

                        /* Bars and X axis labels */
                        for (int bi = 0; bi < _chartData.Length; bi++)
                        {
                            var dp = _chartData[bi];
                            var x = paddingLeft + bi * groupW + barPad / 2;
                            var totalStack = dp.Subscriptions + dp.OneTime + dp.Services;

                            var subH = plotH * dp.Subscriptions / maxStack;
                            var otH = plotH * dp.OneTime / maxStack;
                            var srvH = plotH * dp.Services / maxStack;

                            var subY = paddingTop + plotH - subH - otH - srvH;
                            var otY = subY + subH;
                            var srvY = otY + otH;

                            /* Subscriptions bar */
                            <rect x="@x.ToString("F1")" y="@subY.ToString("F1")" width="@barW.ToString("F1")" height="@subH.ToString("F1")" class="chart-bar-subscriptions" />
                            /* OneTime bar */
                            <rect x="@x.ToString("F1")" y="@otY.ToString("F1")" width="@barW.ToString("F1")" height="@otH.ToString("F1")" class="chart-bar-oneTime" />
                            /* Services bar (top, with radius) */
                            <rect x="@x.ToString("F1")" y="@srvY.ToString("F1")" width="@barW.ToString("F1")" height="@srvH.ToString("F1")" rx="4" ry="4" class="chart-bar-services" />

                            /* X axis label */
                            @((MarkupString)$"<text x=\"{(x + barW / 2).ToString("F1")}\" y=\"{(chartH - 6).ToString("F1")}\" text-anchor=\"middle\" font-size=\"10\" fill=\"currentColor\" opacity=\"0.6\">{dp.Week}</text>")
                        }
                    }
                </svg>
            </div>
        </div>
    </div>
</section>

@code {
    private record StackedPoint(string Week, int Subscriptions, int OneTime, int Services);
    private record LegendEntry(string Key, string Label);

    private static readonly StackedPoint[] _chartData =
    [
        new("W1", 42100, 12400, 6800),
        new("W2", 44800, 11200, 7900),
        new("W3", 46200, 13900, 7300),
        new("W4", 48500, 14800, 8600),
        new("W5", 51200, 13200, 9100),
        new("W6", 53400, 15400, 9800),
        new("W7", 56100, 14200, 10200),
        new("W8", 58700, 16100, 11400),
    ];

    private static readonly LegendEntry[] _legend =
    [
        new("subscriptions", "Subscriptions"),
        new("oneTime", "One-time"),
        new("services", "Services"),
    ];

    private static readonly string _formattedTotal = ComputeTotal();

    private static string ComputeTotal()
    {
        int total = 0;
        foreach (var row in _chartData)
            total += row.Subscriptions + row.OneTime + row.Services;
        return $"${(total / 1000.0):F1}k";
    }
}
