@* ========================================
   Block: stats-product-reviews
   Title: Stats Product Reviews
   Description: A product review analytics dashboard showing star rating distribution, average rating, review count, and sentiment breakdown
   Long Description: Investment portfolio allocation stats with asset class distribution bars and performance indicators for React finance apps
   Dependencies: None
   Source: original/blocks/stats/stats-product-reviews.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">Product Reviews</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Customer feedback and ratings</p>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Average Rating</p>
                <div class="mt-1 flex items-baseline gap-1">
                    <p class="font-semibold tabular-nums text-2xl">@_averageRating.ToString("F1")</p>
                    <span class="text-muted-foreground text-sm">/ 5.0</span>
                </div>
                <div class="mt-1 flex gap-0.5">
                    @for (var i = 0; i < 5; i++)
                    {
                        <span class="@Cn.Merge("size-3", i < (int)Math.Round(_averageRating) ? "text-amber-500" : "text-muted")">&#x2605;</span>
                    }
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Reviews</p>
                <p class="mt-1 font-semibold tabular-nums text-2xl">@_totalReviews.ToString("N0")</p>
                <p class="mt-0.5 text-emerald-600 text-xs">+142 this week</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Response Rate</p>
                <p class="mt-1 font-semibold tabular-nums text-2xl">94%</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Avg 4.2 hours</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <h3 class="font-medium text-sm">Rating Distribution</h3>
            <div class="mt-3 space-y-2">
                @foreach (var rating in _starRatings)
                {
                    <div class="flex items-center gap-3">
                        <div class="flex w-12 items-center gap-1">
                            <span class="tabular-nums text-sm">@rating.Stars</span>
                            <span class="text-amber-500 text-sm">&#x2605;</span>
                        </div>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full bg-amber-500" style="@($"width: {rating.Percentage}%")"></div>
                        </div>
                        <span class="w-16 text-right tabular-nums text-muted-foreground text-xs">
                            @rating.Count.ToString("N0")
                        </span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <h3 class="font-medium text-sm">Sentiment Analysis</h3>
            <div class="mt-3 flex h-2 overflow-hidden rounded-full bg-muted">
                @foreach (var sentiment in _sentimentData)
                {
                    <div class="@Cn.Merge("h-full", sentiment.Color)" style="@($"width: {sentiment.Percentage}%")"></div>
                }
            </div>
            <div class="mt-3 grid grid-cols-3 gap-3">
                @foreach (var sentiment in _sentimentData)
                {
                    <div>
                        <div class="flex items-center gap-1.5">
                            <span class="@Cn.Merge("size-2 rounded-full", sentiment.Color)"></span>
                            <span class="text-muted-foreground text-xs">@sentiment.Label</span>
                        </div>
                        <p class="mt-0.5 font-medium tabular-nums text-sm">@sentiment.Count.ToString("N0")</p>
                        <p class="text-muted-foreground text-xs">@(sentiment.Percentage)%</p>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="flex items-center justify-between">
                <h3 class="font-medium text-sm">Recent Reviews</h3>
                <span class="text-muted-foreground text-xs">Last 24 hours</span>
            </div>
            <div class="mt-3 space-y-2.5">
                @foreach (var review in _recentReviews)
                {
                    <div>
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <div class="flex gap-0.5">
                                        @for (var i = 0; i < 5; i++)
                                        {
                                            <span class="@Cn.Merge("text-xs", i < review.Stars ? "text-amber-500" : "text-muted")">&#x2605;</span>
                                        }
                                    </div>
                                    @if (review.Verified)
                                    {
                                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                    }
                                </div>
                                <p class="mt-0.5 font-medium text-sm">@review.Title</p>
                                <p class="mt-0.5 text-muted-foreground text-xs">
                                    @review.Author &#xB7; @review.Date
                                </p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record StarRating(int Stars, int Count, int Percentage);
    private record SentimentItem(string Label, int Count, int Percentage, string Color);
    private record RecentReview(int Stars, string Title, string Author, string Date, bool Verified);

    private readonly StarRating[] _starRatings =
    [
        new(5, 2847, 68), new(4, 892, 21), new(3, 267, 6), new(2, 125, 3), new(1, 84, 2),
    ];

    private readonly SentimentItem[] _sentimentData =
    [
        new("Positive", 3739, 89, "bg-emerald-500"),
        new("Neutral", 267, 6, "bg-blue-500"),
        new("Negative", 209, 5, "bg-red-500"),
    ];

    private readonly RecentReview[] _recentReviews =
    [
        new(5, "Exceeded expectations", "Sarah M.", "2 hours ago", true),
        new(4, "Great product, minor issues", "James K.", "5 hours ago", true),
        new(5, "Best purchase this year", "Maria L.", "1 day ago", false),
        new(3, "Good but overpriced", "Tom R.", "1 day ago", true),
    ];

    private int _totalReviews => _starRatings.Sum(r => r.Count);
    private double _averageRating => (double)_starRatings.Sum(r => r.Stars * r.Count) / _totalReviews;
}
