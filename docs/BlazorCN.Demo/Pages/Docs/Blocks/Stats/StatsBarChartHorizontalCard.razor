@* ============================================================
   Block: stats-bar-chart-horizontal-card
   Title: StatsBarChartHorizontalCard
   Description: A horizontal bar chart stats card for React and Next.js with a ChartContainer-wrapped Recharts BarChart in vertical layout, category labels on the YAxis, tabular-nums value list, and var(--chart-1) rounded bars built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-bar-chart-horizontal-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Requests by endpoint</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 24 hours</p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-semibold tabular-nums">@_totalRequests.ToString("N0")</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Total calls</p>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="h-[240px] w-full flex flex-col justify-between">
                @foreach (var row in _chartData)
                {
                    var pct = (double)row.Requests / _maxRequests * 100.0;
                    <div class="flex items-center gap-3">
                        <span class="w-[110px] shrink-0 text-right text-[11px] text-muted-foreground truncate pr-2">@row.Endpoint</span>
                        <div class="flex-1 h-5 flex items-center">
                            <div class="h-5 rounded-r-md"
                                 style="width: @(pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%; background-color: var(--chart-1);"></div>
                        </div>
                        <span class="w-12 shrink-0 text-right text-xs tabular-nums text-muted-foreground">@row.Requests.ToString("N0")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record EndpointRow(string Endpoint, int Requests);

    private static readonly EndpointRow[] _chartData =
    [
        new("/api/products",  12450),
        new("/api/users",      8720),
        new("/api/orders",     5230),
        new("/api/analytics",  3980),
        new("/api/search",     3210),
        new("/api/auth",       2840),
        new("/api/webhooks",   1560),
    ];

    private static readonly int _totalRequests = _chartData.Sum(r => r.Requests);
    private static readonly int _maxRequests   = _chartData.Max(r => r.Requests);
}
