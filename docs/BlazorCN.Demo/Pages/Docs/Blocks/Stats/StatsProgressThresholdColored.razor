@* ============================================================
   Block: stats-progress-threshold-colored
   Title: StatsProgressThresholdColored
   Description: A threshold-aware progress list stats card for React and Next.js with thin h-1.5 progress bars whose fill color shifts from emerald to amber to red based on utilization tiers built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-progress-threshold-colored.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Resource utilization</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Live capacity by service</p>
            </div>
            <div class="flex items-center gap-3 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                <span class="inline-flex items-center gap-1">
                    <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                    ok
                </span>
                <span class="inline-flex items-center gap-1">
                    <span aria-hidden="true" class="size-1.5 rounded-full bg-amber-500"></span>
                    warn
                </span>
                <span class="inline-flex items-center gap-1">
                    <span aria-hidden="true" class="size-1.5 rounded-full bg-red-500"></span>
                    crit
                </span>
            </div>
        </div>
        <div class="divide-y">
            @foreach (var row in _resources)
            {
                var percent = Math.Min(100, (int)Math.Round((double)row.Current / row.Total * 100));
                var status = GetStatus(percent);
                var barClass = GetBarClass(status);
                var dotClass = GetDotClass(status);
                var textClass = GetTextClass(status);
                <div class="px-4 py-3" key="@row.Id">
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex min-w-0 items-center gap-2">
                            <span aria-label="@($"Status: {status}")"
                                  class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dotClass)"
                                  role="img"></span>
                            <div class="min-w-0">
                                <p class="truncate text-sm font-medium">@row.Label</p>
                                <p class="mt-0.5 truncate text-xs text-muted-foreground">@row.Sublabel</p>
                            </div>
                        </div>
                        <div class="shrink-0 text-right">
                            <p class="text-sm font-semibold tabular-nums">
                                @row.Current.ToString("N0")
                                <span class="text-muted-foreground">
                                    @(" / ")@row.Total.ToString("N0") @row.Unit
                                </span>
                            </p>
                            <p class="@Cn.Merge("mt-0.5 text-xs font-medium tabular-nums", textClass)">
                                @(percent)% used
                            </p>
                        </div>
                    </div>
                    <div aria-label="@($"{row.Label} utilization")"
                         aria-valuemax="@row.Total"
                         aria-valuemin="0"
                         aria-valuenow="@row.Current"
                         class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-muted"
                         role="progressbar">
                        <div class="@Cn.Merge("h-full rounded-full transition-all duration-700 ease-out", barClass)"
                             style="@($"width: {percent}%")"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ResourceRow(string Id, string Label, string Sublabel, int Current, int Total, string Unit);

    private static readonly ResourceRow[] _resources =
    [
        new("api-cpu",   "API service CPU",    "us-east-1 cluster", 34,  100,   "%"),
        new("postgres",  "Postgres storage",   "primary node",      612, 1024,  "GB"),
        new("redis",     "Redis memory",       "cache cluster",     78,  100,   "%"),
        new("bandwidth", "Egress bandwidth",   "cdn pop sfo1",      864, 1000,  "GB"),
        new("queue",     "Background queue",   "worker pool",       961, 1000,  "jobs"),
        new("seats",     "Licensed seats",     "enterprise plan",   42,  120,   "seats"),
    ];

    private static string GetStatus(int percent)
    {
        if (percent >= 90) return "critical";
        if (percent >= 70) return "warning";
        return "healthy";
    }

    private static string GetBarClass(string status) => status switch
    {
        "critical" => "bg-red-500",
        "warning"  => "bg-amber-500",
        _          => "bg-emerald-500",
    };

    private static string GetDotClass(string status) => status switch
    {
        "critical" => "bg-red-500",
        "warning"  => "bg-amber-500",
        _          => "bg-emerald-500",
    };

    private static string GetTextClass(string status) => status switch
    {
        "critical" => "text-red-600 dark:text-red-400",
        "warning"  => "text-amber-600 dark:text-amber-400",
        _          => "text-emerald-600 dark:text-emerald-400",
    };
}
