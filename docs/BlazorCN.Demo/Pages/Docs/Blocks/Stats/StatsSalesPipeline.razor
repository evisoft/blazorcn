@* ========================================
   Block: stats-sales-pipeline
   Title: Stats Sales Pipeline
   Description: Sales pipeline stats with deal stage values, win probability, and weighted forecast for React CRM dashboards
   Long Description: An investment ROI calculator component displaying cost, revenue, net gain, payback period, and ROI percentage for Next.js financial dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-sales-pipeline.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Sales Pipeline</p>
                <p class="mt-0.5 text-xs text-muted-foreground">@totalDeals active deals</p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-semibold tabular-nums">@totalPipeline</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Weighted: @weightedForecast</p>
            </div>
        </div>

        @* Stages *@
        <div>
            @for (var i = 0; i < stages.Length; i++)
            {
                var stage = stages[i];
                var barWidth = (double)stage.RawValue / maxValue * 100;
                var isLast = i == stages.Length - 1;

                <div class="@(Cn.Merge("px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@stage.Name</span>
                            <span class="text-xs text-muted-foreground">@stage.Deals deals</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-sm font-semibold tabular-nums">@stage.Value</span>
                            <span class="w-8 text-right text-xs tabular-nums text-muted-foreground">
                                @stage.Probability%
                            </span>
                        </div>
                    </div>
                    <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-primary transition-all"
                             style="width: @(barWidth)%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PipelineStage(string Name, int Deals, string Value, int RawValue, int Probability);

    private static readonly PipelineStage[] stages = new[]
    {
        new PipelineStage("Prospecting", 42, "$320K", 320000, 10),
        new PipelineStage("Qualification", 28, "$245K", 245000, 25),
        new PipelineStage("Proposal", 15, "$180K", 180000, 50),
        new PipelineStage("Negotiation", 8, "$95K", 95000, 75),
        new PipelineStage("Closing", 4, "$52K", 52000, 90),
    };

    private static readonly int totalDeals = stages.Sum(s => s.Deals);
    private const string totalPipeline = "$892K";
    private const string weightedForecast = "$218K";
    private static readonly int maxValue = stages.Max(s => s.RawValue);
}
