@* ========================================
   Block: stats-nps-trend
   Title: Stats NPS Trend
   Description: Net Promoter Score trend with promoter/passive/detractor breakdown and historical tracking
   Dependencies: None
   Source: original/blocks/stats/stats-nps-trend.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Net Promoter Score</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">Customer loyalty trend</p>
        </div>

        <div class="border-b px-4 py-4">
            <div class="text-center">
                <div class="text-4xl font-semibold tabular-nums">@_current.Nps</div>
                <div class="mt-1 flex items-center justify-center gap-2">
                    <span class="text-xs text-muted-foreground">Current NPS</span>
                    <span class="text-xs font-medium text-emerald-600">+@_npsChange</span>
                </div>
            </div>

            <div class="mt-4 space-y-2.5">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
                        <span class="text-sm">Promoters (9-10)</span>
                    </div>
                    <span class="text-sm font-semibold tabular-nums">@(_current.Promoters)%</span>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="h-2 w-2 rounded-full bg-amber-500"></span>
                        <span class="text-sm">Passives (7-8)</span>
                    </div>
                    <span class="text-sm font-semibold tabular-nums">@(_current.Passives)%</span>
                </div>
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="h-2 w-2 rounded-full bg-red-500"></span>
                        <span class="text-sm">Detractors (0-6)</span>
                    </div>
                    <span class="text-sm font-semibold tabular-nums">@(_current.Detractors)%</span>
                </div>
            </div>

            <div class="mt-3 flex h-3 overflow-hidden rounded-full bg-muted">
                <div class="h-full bg-emerald-500" style="@($"width: {_current.Promoters}%")"></div>
                <div class="h-full bg-amber-500" style="@($"width: {_current.Passives}%")"></div>
                <div class="h-full bg-red-500" style="@($"width: {_current.Detractors}%")"></div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <h4 class="text-sm font-medium">Monthly Trend</h4>
                <span class="text-xs text-muted-foreground">Last 3 months</span>
            </div>
            <div class="space-y-2.5">
                @foreach (var data in _npsData)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-20 text-xs text-muted-foreground">@data.Period</span>
                        <div class="flex-1">
                            <div class="flex h-8 items-center gap-2">
                                <div class="relative h-full flex-1 overflow-hidden rounded bg-muted">
                                    <div class="absolute inset-y-0 left-1/2 w-0.5 bg-border"></div>
                                    <div class="absolute inset-y-0 left-1/2 rounded bg-emerald-500"
                                         style="@($"width: {data.Nps / 2.0}%")"></div>
                                </div>
                                <span class="w-8 text-right text-sm font-semibold tabular-nums">@data.Nps</span>
                            </div>
                        </div>
                        <span class="w-16 text-right text-xs text-muted-foreground">
                            @data.Responses resp
                        </span>
                    </div>
                }
            </div>
        </div>

        <div class="grid grid-cols-2 gap-px bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Total Responses</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_current.Responses</p>
                <p class="mt-0.5 text-xs text-muted-foreground">This month</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Response Rate</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">34%</p>
                <p class="mt-0.5 text-xs text-emerald-600">+2.4%</p>
            </div>
        </div>
    </div>
</section>

@code {
    private record NpsPeriod(string Period, int Nps, int Promoters, int Passives, int Detractors, int Responses);

    private static readonly NpsPeriod[] _npsData =
    [
        new("Jan 2026", 42, 58, 26, 16, 245),
        new("Feb 2026", 38, 54, 30, 16, 289),
        new("Mar 2026", 45, 62, 21, 17, 312),
    ];

    private static readonly NpsPeriod _current = _npsData[^1];
    private static readonly int _npsChange = _current.Nps - _npsData[^2].Nps;
}
