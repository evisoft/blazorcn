    private static string BuildSparkSvg(SparkMetric metric, string gradCurrent, string gradPrevious)
    {
        const int w = 400;
        const int h = 80;
        const int padTop = 4;
        const int padBottom = 0;
        const int padLeft = 0;
        const int padRight = 0;

        var allVals = new System.Collections.Generic.List<double>();
        foreach (var pt in metric.Data)
        {
            allVals.Add(pt.Current);
            allVals.Add(pt.Previous);
        }

        double minVal = allVals[0];
        double maxVal = allVals[0];
        foreach (var v in allVals)
        {
            if (v < minVal) minVal = v;
            if (v > maxVal) maxVal = v;
        }

        double range = maxVal - minVal;
        if (range == 0) range = 1;

        int n = metric.Data.Length;
        double xStep = n > 1 ? (double)(w - padLeft - padRight) / (n - 1) : w;
        int chartH = h - padTop - padBottom;

        double ScaleX(int idx) => padLeft + idx * xStep;
        double ScaleY(double val) => padTop + chartH - ((val - minVal) / range) * chartH;

        string BuildLinePath(System.Func<SparkPoint, double> selector)
        {
            var sb = new System.Text.StringBuilder();
            for (int i = 0; i < metric.Data.Length; i++)
            {
                double x = ScaleX(i);
                double y = ScaleY(selector(metric.Data[i]));
                sb.Append(i == 0 ? $"M {x:F1},{y:F1}" : $" L {x:F1},{y:F1}");
            }
            return sb.ToString();
        }

        string BuildAreaPath(System.Func<SparkPoint, double> selector)
        {
            var line = BuildLinePath(selector);
            double lastX = ScaleX(n - 1);
            double firstX = ScaleX(0);
            double bottom = h;
            return $"{line} L {lastX:F1},{bottom:F1} L {firstX:F1},{bottom:F1} Z";
        }

        var prevLine = BuildLinePath(pt => pt.Previous);
        var prevArea = BuildAreaPath(pt => pt.Previous);
        var currLine = BuildLinePath(pt => pt.Current);
        var currArea = BuildAreaPath(pt => pt.Current);

        return $@"<svg xmlns=""http://www.w3.org/2000/svg"" viewBox=""0 0 {w} {h}"" width=""100%"" height=""100%"" preserveAspectRatio=""none"">
  <defs>
    <linearGradient id=""{gradCurrent}"" x1=""0"" x2=""0"" y1=""0"" y2=""1"">
      <stop offset=""0%"" stop-color=""var(--chart-1)"" stop-opacity=""0.3"" />
      <stop offset=""100%"" stop-color=""var(--chart-1)"" stop-opacity=""0"" />
    </linearGradient>
    <linearGradient id=""{gradPrevious}"" x1=""0"" x2=""0"" y1=""0"" y2=""1"">
      <stop offset=""0%"" stop-color=""var(--chart-2)"" stop-opacity=""0.18"" />
      <stop offset=""100%"" stop-color=""var(--chart-2)"" stop-opacity=""0"" />
    </linearGradient>
  </defs>
  <path d=""{prevArea}"" fill=""url(#{gradPrevious})"" stroke=""none"" />
  <path d=""{prevLine}"" fill=""none"" stroke=""var(--chart-2)"" stroke-width=""1.5"" stroke-dasharray=""3 3"" />
  <path d=""{currArea}"" fill=""url(#{gradCurrent})"" stroke=""none"" />
  <path d=""{currLine}"" fill=""none"" stroke=""var(--chart-1)"" stroke-width=""1.5"" />
</svg>";
    }
}
