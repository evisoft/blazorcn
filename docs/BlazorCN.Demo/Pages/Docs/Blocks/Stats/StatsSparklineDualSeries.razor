@* ============================================================
   Block: stats-sparkline-dual-series
   Title: StatsSparklineDualSeries
   Description: A dual-series sparkline stats card for React and Next.js with two overlapping inline area charts in var(--chart-1) and var(--chart-2), thin 1.5px strokes, layered gradient fills, and current vs previous period comparison built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-sparkline-dual-series.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var metric in _metrics)
        {
            var isPositive = metric.DeltaType == "positive";
            var gradCurrent = $"spark-current-{metric.Id}";
            var gradPrevious = $"spark-previous-{metric.Id}";
            var sparkSvg = BuildSparkSvg(metric, gradCurrent, gradPrevious);

            <div class="overflow-hidden rounded-lg border bg-card" key="@metric.Id">
                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <dt class="truncate text-sm font-medium">@metric.Label</dt>
                            <p class="mt-0.5 truncate text-xs text-muted-foreground">
                                @metric.Timeframe
                            </p>
                        </div>
                        <span class="@(Cn.Merge("inline-flex shrink-0 items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium tabular-nums", isPositive ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-red-500/10 text-red-600 dark:text-red-400"))">
                            @if (isPositive)
                            {
                                <LucideIconCn Name="trending-up" Size="12" Class="size-3" aria-hidden="true" />
                            }
                            else
                            {
                                <LucideIconCn Name="trending-down" Size="12" Class="size-3" aria-hidden="true" />
                            }
                            @metric.DeltaLabel
                        </span>
                    </div>

                    <div class="mt-2 flex items-baseline gap-2">
                        <dd class="text-2xl font-semibold tabular-nums">@metric.Value</dd>
                        <dd class="text-xs text-muted-foreground tabular-nums">
                            from @metric.Previous
                        </dd>
                    </div>
                </div>

                <div class="h-20 w-full">
                    @((MarkupString)sparkSvg)
                </div>

                <div class="flex items-center gap-4 border-t px-4 py-2.5 text-xs text-muted-foreground">
                    <span class="inline-flex items-center gap-1.5">
                        <span aria-hidden="true" class="size-1.5 rounded-full" style="background:var(--chart-1)"></span>
                        Current
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                        <span aria-hidden="true" class="size-1.5 rounded-full" style="background:var(--chart-2)"></span>
                        Previous
                    </span>
                </div>
            </div>
        }
    </dl>
</section>

@code {
    private record SparkPoint(int Index, double Current, double Previous);

    private record SparkMetric(
        string Id,
        string Label,
        string Timeframe,
        string Value,
        string Previous,
        string DeltaLabel,
        string DeltaType,
        SparkPoint[] Data);

    private static readonly SparkMetric[] _metrics =
    [
