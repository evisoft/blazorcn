@* ============================================================
   Block: stats-treemap-card
   Title: StatsTreemapCard
   Description: A treemap stats card for React and Next.js with Recharts Treemap rendering proportional rectangles for category distribution, chart-token colored cells, inside labels with values, NumberFlow animated total, and a compact legend built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-treemap-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Revenue by category</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Current fiscal year</p>
            </div>
            <div class="min-w-[100px] text-right">
                <span class="text-2xl font-semibold tabular-nums">$626K</span>
            </div>
        </div>
        <div class="px-4 py-4">
            <div class="h-[200px] w-full overflow-hidden rounded" style="display:flex;flex-wrap:wrap;gap:2px;">
                @foreach (var item in _treemapData)
                {
                    var pct = (double)item.Size / _total * 100.0;
                    var showLabel = pct > 8.0;
                    var showValue = pct > 8.0;
                    <div style="@($"flex-grow:{item.Size};flex-shrink:0;flex-basis:{pct * 1.5}%;background-color:{item.Fill};opacity:0.8;border-radius:4px;padding:6px 8px;position:relative;min-width:40px;overflow:hidden;")"
                         title="@item.Name">
                        @if (showLabel)
                        {
                            <span style="display:block;font-size:11px;font-weight:500;color:var(--background);line-height:1.2;">@item.Name</span>
                        }
                        @if (showValue)
                        {
                            <span style="display:block;font-size:10px;color:var(--background);opacity:0.8;line-height:1.2;">$@((item.Size / 1000).ToString("0"))k</span>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="flex flex-wrap gap-x-3 gap-y-1 border-t px-4 py-2.5">
            @foreach (var item in _treemapData[..5])
            {
                <div class="flex items-center gap-1.5">
                    <span class="size-2 rounded-sm" style="@($"background-color:{item.Fill};")" aria-hidden="true"></span>
                    <span class="text-xs text-muted-foreground">@item.Name</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TreemapItem(string Name, int Size, string Fill);

    private static readonly TreemapItem[] _treemapData =
    [
        new("SaaS",      245_000, "var(--chart-1)"),
        new("Services",  128_000, "var(--chart-2)"),
        new("Licenses",   95_000, "var(--chart-3)"),
        new("Add-ons",    62_000, "var(--chart-4)"),
        new("Training",   38_000, "var(--chart-5)"),
        new("Support",    27_000, "var(--chart-1)"),
        new("Hosting",    18_500, "var(--chart-2)"),
        new("Other",      12_500, "var(--chart-3)"),
    ];

    private static readonly int _total = _treemapData.Sum(d => d.Size);
}
