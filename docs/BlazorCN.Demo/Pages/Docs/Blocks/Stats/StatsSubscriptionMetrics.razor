@* ========================================
   Block: stats-subscription-metrics
   Title: Stats Subscription Metrics
   Description: SaaS subscription stats with MRR, churn rate, LTV, and subscriber growth
   Dependencies: None
   Source: original/blocks/stats/stats-subscription-metrics.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-lg border bg-border sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var metric in _metrics)
        {
            var changeColor = metric.ChangeType == "positive"
                ? "text-emerald-600 dark:text-emerald-400"
                : "text-red-600 dark:text-red-400";
            <div class="bg-card px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                        @metric.Label
                    </span>
                    <span class="@($"text-xs font-medium tabular-nums {changeColor}")">
                        @metric.Change
                    </span>
                </div>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@metric.Value</p>
                <p class="mt-0.5 text-xs text-muted-foreground">@metric.Context</p>
            </div>
        }
    </div>
</section>

@code {
    private record MetricData(string Label, string Value, string Change, string ChangeType, string Context);

    private static readonly MetricData[] _metrics =
    [
        new("MRR", "$48.2K", "+12.4%", "positive", "vs last month"),
        new("Churn Rate", "2.1%", "-0.3%", "positive", "vs last month"),
        new("LTV", "$2,840", "+8.2%", "positive", "12-month avg"),
        new("Subscribers", "1,247", "+86", "positive", "net new this month"),
    ];
}
