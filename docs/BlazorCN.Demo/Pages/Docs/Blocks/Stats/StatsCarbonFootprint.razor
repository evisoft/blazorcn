@* ========================================
   Block: stats-carbon-footprint
   Title: Stats Carbon Footprint
   Description: Environmental impact stats with emissions breakdown, sustainability score, and reduction tracking
   Dependencies: None
   Source: original/blocks/stats/stats-carbon-footprint.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Carbon Footprint</p>
                <p class="mt-0.5 text-xs text-muted-foreground">tonnes CO&#x2082;e this quarter</p>
            </div>
            <div class="text-right">
                <p class="text-xs text-muted-foreground">Score</p>
                <p class="text-sm font-semibold">B+</p>
            </div>
        </div>

        @* Total with trend *@
        <div class="border-b px-4 py-3">
            <div class="flex items-baseline gap-2">
                <span class="text-2xl font-semibold tabular-nums">@_totalEmissions.ToString("F1")</span>
                <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                    @_changePercent.ToString("F1")%
                </span>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                vs @_previousEmissions.ToString("F1") last quarter
            </p>
        </div>

        @* Breakdown *@
        <div class="border-b px-4 py-3">
            <div class="flex h-1.5 overflow-hidden rounded-full bg-muted">
                @foreach (var cat in _categories)
                {
                    <div class="@($"h-full {cat.Color}")"
                         style="@($"width: {cat.Value / _totalEmissions * 100:F1}%")"></div>
                }
            </div>
            <div class="mt-3 space-y-2">
                @foreach (var cat in _categories)
                {
                    <div class="flex items-center gap-2 text-sm">
                        <span class="@($"h-2 w-2 shrink-0 rounded-full {cat.Color}")"></span>
                        <span class="flex-1">@cat.Name</span>
                        <span class="tabular-nums text-muted-foreground">@(cat.Value)t</span>
                        <span class="w-10 text-right tabular-nums text-muted-foreground">
                            @((int)Math.Round(cat.Value / _totalEmissions * 100))%
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Reduction target *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span>Reduction target: @(_reductionTarget)t</span>
                <span class="tabular-nums">@_targetProgress% progress</span>
            </div>
            <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-emerald-500 transition-all"
                     style="@($"width: {_targetProgress}%")"></div>
            </div>
        </div>
    </div>
</section>

@code {
    private record EmissionCategory(string Name, double Value, string Color);

    private const double _totalEmissions = 142.8;
    private const double _previousEmissions = 168.3;
    private const int _reductionTarget = 100;

    private static readonly double _changePercent = (_totalEmissions - _previousEmissions) / _previousEmissions * 100;
    private static readonly int _targetProgress = (int)Math.Round((_previousEmissions - _totalEmissions) / (_previousEmissions - _reductionTarget) * 100);

    private static readonly EmissionCategory[] _categories =
    [
        new("Energy", 62.4, "bg-amber-500"),
        new("Transport", 38.2, "bg-blue-500"),
        new("Supply Chain", 28.6, "bg-purple-500"),
        new("Operations", 13.6, "bg-emerald-500"),
    ];
}
