@* ========================================
   Block: stats-ab-test
   Title: Stats Ab Test
   Description: A/B test experiment results with variant comparison, statistical significance, and winner indicator for React experimentation dashboards
   Long Description: A/B pricing experiment results with plan selection rates, ARPU impact, and statistical significance indicators for Next.js applications
   Dependencies: None
   Source: original/blocks/stats/stats-ab-test.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">@experimentName</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @((variants[0].Visitors + variants[1].Visitors).ToString("N0")) total visitors
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                    @status
                </span>
            </div>
        </div>

        @* Variants *@
        @for (var i = 0; i < variants.Length; i++)
        {
            var variant = variants[i];
            var isLast = i == variants.Length - 1;

            <div class="@(Cn.Merge("px-4 py-3", !isLast ? "border-b" : ""))">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-medium">@variant.Name</span>
                        @if (variant.IsWinner)
                        {
                            <span class="rounded bg-emerald-500/10 px-1.5 py-0.5 text-[10px] font-medium text-emerald-600 dark:text-emerald-400">
                                Winner
                            </span>
                        }
                    </div>
                    <span class="text-2xl font-semibold tabular-nums">
                        @variant.ConversionRate%
                    </span>
                </div>
                <div class="mt-2 flex items-center gap-4 text-xs text-muted-foreground">
                    <span>@variant.Visitors.ToString("N0") visitors</span>
                    <span>@variant.Conversions.ToString("N0") conversions</span>
                </div>
                <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                    <div
                        class="@(Cn.Merge("h-full rounded-full transition-all", variant.IsWinner ? "bg-emerald-500" : "bg-muted-foreground/30"))"
                        style="width: @(variant.ConversionRate * 10)%">
                    </div>
                </div>
            </div>
        }

        @* Summary *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">
                    Confidence:
                    <span class="font-medium tabular-nums text-foreground">@confidence%</span>
                </span>
                <span class="font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                    +@uplift% uplift
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Variant(string Name, int Visitors, int Conversions, double ConversionRate, bool IsWinner);

    private static readonly string experimentName = "Checkout Flow Redesign";
    private static readonly double confidence = 95.2;
    private static readonly string status = "Significant";

    private static readonly Variant[] variants = new[]
    {
        new Variant("Control", 12480, 374, 3.0, false),
        new Variant("Variant B", 12520, 501, 4.0, true),
    };

    private static readonly string uplift = ((variants[1].ConversionRate - variants[0].ConversionRate) / variants[0].ConversionRate * 100).ToString("F1");
}
