@* ============================================================
   Block: stats-area-chart-gradient-fill
   Title: StatsAreaChartGradientFill
   Description: A single-series area chart stats card for React and Next.js with a multi-stop linearGradient fill, ChartContainer-wrapped Recharts AreaChart at 200px height, NumberFlow animated hero value, and CartesianGrid horizontal dashed lines built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-area-chart-gradient-fill.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <p class="text-sm font-medium">Cumulative revenue</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">Q1 2026 · Week 1 – Week 14</p>
                </div>
            </div>
            <div class="mt-3 flex items-baseline gap-3">
                <div class="min-w-[160px]">
                    <span class="text-3xl font-semibold tabular-nums">$402,780</span>
                </div>
                <div class="flex items-center gap-1">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                    <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                        +183% vs Q4 2025
                    </span>
                </div>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="h-[200px] w-full">
                <svg viewBox="0 0 600 200" preserveAspectRatio="none" class="h-full w-full" aria-hidden="true">
                    <defs>
                        <linearGradient id="fill-revenue-gcf" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" stop-color="oklch(0.646 0.222 41.116)" stop-opacity="0.48" />
                            <stop offset="35%" stop-color="oklch(0.646 0.222 41.116)" stop-opacity="0.28" />
                            <stop offset="70%" stop-color="oklch(0.646 0.222 41.116)" stop-opacity="0.12" />
                            <stop offset="100%" stop-color="oklch(0.646 0.222 41.116)" stop-opacity="0" />
                        </linearGradient>
                    </defs>

                    @* CartesianGrid — 4 horizontal dashed lines *@
                    @foreach (var gridY in _gridLines)
                    {
                        @((MarkupString)$"<line x1=\"0\" y1=\"{gridY}\" x2=\"600\" y2=\"{gridY}\" stroke=\"currentColor\" stroke-opacity=\"0.15\" stroke-dasharray=\"3 3\" />")
                    }

                    @* Area fill *@
                    <path d="@_areaPath" fill="url(#fill-revenue-gcf)" />

                    @* Stroke line *@
                    <path d="@_linePath" fill="none" stroke="oklch(0.646 0.222 41.116)" stroke-width="2" />

                    @* XAxis tick labels *@
                    @foreach (var tick in _xTicks)
                    {
                        @((MarkupString)FormattableString.Invariant($"<text x=\"{tick.X}\" y=\"196\" text-anchor=\"middle\" font-size=\"9\" fill=\"currentColor\" opacity=\"0.5\">{tick.Label}</text>"))
                    }
                </svg>
            </div>
        </div>
    </div>
</section>

@code {
    private record DataPoint(string Date, int Revenue);
    private record XTick(double X, string Label);

    private static readonly DataPoint[] _chartData =
    [
        new("2026-01-05", 142_300),
        new("2026-01-12", 158_420),
        new("2026-01-19", 164_870),
        new("2026-01-26", 181_240),
        new("2026-02-02", 198_650),
        new("2026-02-09", 211_430),
        new("2026-02-16", 227_820),
        new("2026-02-23", 248_910),
        new("2026-03-02", 268_540),
        new("2026-03-09", 291_720),
        new("2026-03-16", 318_480),
        new("2026-03-23", 342_190),
        new("2026-03-30", 371_050),
        new("2026-04-06", 402_780),
    ];

    // SVG canvas: viewBox 0 0 600 200, leave 16px bottom for x-axis labels
    private const double SvgWidth = 600;
    private const double SvgHeight = 184; // usable chart area (200 - 16 for x labels)
    private const double PaddingTop = 4;

    private static readonly double _minRevenue = 142_300;
    private static readonly double _maxRevenue = 402_780;

    private static double MapX(int index) =>
        (index / (double)(_chartData.Length - 1)) * SvgWidth;

    private static double MapY(double value)
    {
        var range = _maxRevenue - _minRevenue;
        var normalized = (value - _minRevenue) / range;
        return SvgHeight - PaddingTop - normalized * (SvgHeight - PaddingTop - 8) + PaddingTop;
    }

    private static string FormatDate(string date)
    {
        // e.g. "2026-01-05" -> "Jan 5"
        var parts = date.Split('-');
        if (parts.Length < 3) return date;
        var month = int.Parse(parts[1]);
        var day = int.Parse(parts[2]);
        var months = new[] { "", "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
        return $"{months[month]} {day}";
    }

    private static readonly double[] _gridLines = BuildGridLines();
    private static double[] BuildGridLines()
    {
        // 4 evenly spaced horizontal grid lines in the chart area
        var lines = new double[4];
        for (var i = 0; i < 4; i++)
        {
            lines[i] = PaddingTop + (i + 1) * (SvgHeight - PaddingTop) / 5.0;
        }
        return lines;
    }

    private static readonly string _linePath = BuildLinePath();
    private static string BuildLinePath()
    {
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < _chartData.Length; i++)
        {
            var x = MapX(i);
            var y = MapY(_chartData[i].Revenue);
            sb.Append(i == 0 ? FormattableString.Invariant($"M {x:F2} {y:F2}") : FormattableString.Invariant($" L {x:F2} {y:F2}"));
        }
        return sb.ToString();
    }

    private static readonly string _areaPath = BuildAreaPath();
    private static string BuildAreaPath()
    {
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < _chartData.Length; i++)
        {
            var x = MapX(i);
            var y = MapY(_chartData[i].Revenue);
            sb.Append(i == 0 ? FormattableString.Invariant($"M {x:F2} {y:F2}") : FormattableString.Invariant($" L {x:F2} {y:F2}"));
        }
        // close the area down to baseline
        var lastX = MapX(_chartData.Length - 1);
        var firstX = MapX(0);
        sb.Append(FormattableString.Invariant($" L {lastX:F2} {SvgHeight:F2} L {firstX:F2} {SvgHeight:F2} Z"));
        return sb.ToString();
    }

    // Show first tick of each month + last data point
    private static readonly XTick[] _xTicks = BuildXTicks();
    private static XTick[] BuildXTicks()
    {
        var ticks = new System.Collections.Generic.List<XTick>();
        var seenMonths = new System.Collections.Generic.HashSet<string>();
        for (var i = 0; i < _chartData.Length; i++)
        {
            var parts = _chartData[i].Date.Split('-');
            var monthKey = parts[1];
            if (seenMonths.Add(monthKey))
            {
                ticks.Add(new XTick(MapX(i), FormatDate(_chartData[i].Date)));
            }
        }
        // always include last point
        var lastIdx = _chartData.Length - 1;
        var lastMonthKey = _chartData[lastIdx].Date.Split('-')[1];
        if (!seenMonths.Contains(lastMonthKey + "_last"))
        {
            ticks.Add(new XTick(MapX(lastIdx), FormatDate(_chartData[lastIdx].Date)));
        }
        return ticks.ToArray();
    }
}
