@* ============================================================
   Block: stats-bar-chart-with-target-line
   Title: StatsBarChartWithTargetLine
   Description: A bar chart stats card for React and Next.js with a horizontal ReferenceLine target threshold, per-bar Cell colors for above/below target, a ChartContainer-wrapped Recharts BarChart, and tabular-nums summary row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-bar-chart-with-target-line.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Tickets resolved</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 14 days vs daily target</p>
            </div>
            <div class="flex items-center gap-1.5 rounded-full bg-muted/60 px-2 py-0.5">
                <LucideIconCn Name="target" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-xs font-medium tabular-nums text-muted-foreground">
                    Target @Target/day
                </span>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="h-[200px] w-full">
                @{
                    var chartWidth = 580;
                    var chartHeight = 180;
                    var paddingLeft = 0;
                    var paddingRight = 0;
                    var paddingTop = 4;
                    var paddingBottom = 24;
                    var plotWidth = chartWidth - paddingLeft - paddingRight;
                    var plotHeight = chartHeight - paddingTop - paddingBottom;
                    var maxValue = 450;
                    var barCount = _days.Length;
                    var gap = 4;
                    var barWidth = (plotWidth - (barCount - 1) * gap) / barCount;
                    var targetY = paddingTop + plotHeight - (plotHeight * Target / maxValue);
                    var gridLines = new[] { 0, 150, 300, 450 };
                }
                <svg viewBox="0 0 @chartWidth @chartHeight" class="h-full w-full" aria-hidden="true">
                    @foreach (var gridVal in gridLines)
                    {
                        var gy = paddingTop + plotHeight - (plotHeight * gridVal / maxValue);
                        @((MarkupString)$"<line x1=\"{paddingLeft}\" y1=\"{gy}\" x2=\"{chartWidth - paddingRight}\" y2=\"{gy}\" stroke=\"currentColor\" stroke-opacity=\"0.1\" stroke-dasharray=\"3 3\" />")
                    }

                    @for (var i = 0; i < _days.Length; i++)
                    {
                        var day = _days[i];
                        var barH = plotHeight * day.Value / maxValue;
                        var x = paddingLeft + i * (barWidth + gap);
                        var y = paddingTop + plotHeight - barH;
                        var fill = day.Value >= Target ? "oklch(0.72 0.17 162)" : "oklch(0.76 0.17 75)";
                        var rx = 4;
                        @((MarkupString)FormattableString.Invariant($"<rect x=\"{x}\" y=\"{y}\" width=\"{barWidth}\" height=\"{barH}\" rx=\"{rx}\" ry=\"{rx}\" fill=\"{fill}\" />"))
                    }

                    @((MarkupString)$"<line x1=\"{paddingLeft}\" y1=\"{targetY}\" x2=\"{chartWidth - paddingRight - 40}\" y2=\"{targetY}\" stroke=\"var(--muted-foreground)\" stroke-dasharray=\"4 4\" stroke-width=\"1\" />")
                    @((MarkupString)$"<text x=\"{chartWidth - paddingRight - 36}\" y=\"{targetY + 4}\" font-size=\"10\" fill=\"var(--muted-foreground)\">Target</text>")

                    @for (var i = 0; i < _days.Length; i++)
                    {
                        var day = _days[i];
                        var x = paddingLeft + i * (barWidth + gap) + barWidth / 2;
                        var label = day.Date.Split(' ').Length > 1 ? day.Date.Split(' ')[1] : day.Date;
                        @((MarkupString)$"<text x=\"{x}\" y=\"{chartHeight - 4}\" text-anchor=\"middle\" font-size=\"10\" fill=\"var(--muted-foreground)\">{label}</text>")
                    }
                </svg>
            </div>
        </div>

        <div class="grid grid-cols-3 border-t">
            <div class="border-r px-4 py-3">
                <div class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Avg/day
                </div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">@_averageValue</div>
            </div>
            <div class="flex items-center gap-2 border-r px-4 py-3">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                <div>
                    <div class="text-[10px] font-medium uppercase tracking-widest text-emerald-600 dark:text-emerald-400">
                        Days hit
                    </div>
                    <div class="mt-0.5 text-sm font-semibold tabular-nums">@_daysHit</div>
                </div>
            </div>
            <div class="flex items-center gap-2 px-4 py-3">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-amber-500"></span>
                <div>
                    <div class="text-[10px] font-medium uppercase tracking-widest text-amber-600 dark:text-amber-400">
                        Days missed
                    </div>
                    <div class="mt-0.5 text-sm font-semibold tabular-nums">@_daysMissed</div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const int Target = 320;

    private record DayPoint(string Date, int Value);

    private static readonly DayPoint[] _days =
    [
        new("Mar 18", 268),
        new("Mar 19", 342),
        new("Mar 20", 388),
        new("Mar 21", 295),
        new("Mar 22", 412),
        new("Mar 23", 356),
        new("Mar 24", 278),
        new("Mar 25", 330),
        new("Mar 26", 248),
        new("Mar 27", 368),
        new("Mar 28", 402),
        new("Mar 29", 315),
        new("Mar 30", 294),
        new("Mar 31", 358),
    ];

    private static readonly int _daysHit = _days.Count(d => d.Value >= Target);
    private static readonly int _daysMissed = _days.Length - _daysHit;
    private static readonly int _averageValue = (int)Math.Round(_days.Average(d => d.Value));
}
