@* ========================================
   Block: stats-ab-pricing
   Title: Stats Ab Pricing
   Description: A/B pricing experiment results with plan selection rates, ARPU impact, and statistical significance indicators for Next.js applications
   Long Description: Conversion funnel metrics with drop-off analysis
   Dependencies: None
   Source: original/blocks/stats/stats-ab-pricing.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Pricing Experiment Results</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Control ($29) vs Value Pricing ($39) • 24,800 visitors • 14 days
            </p>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">ARPU Impact</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">+$@(arpuDiff.ToString("F1"))</span>
                    <span class="text-xs text-emerald-600">+@(arpuDiffPercentage.ToString("F1"))%</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Conversion Rate</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">
                        @(testConversionRate.ToString("F2"))%
                    </span>
                    <span class="text-xs text-amber-600">@(conversionRateDiff.ToString("F2"))%</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Confidence</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">
                        @statisticalSignificance%
                    </span>
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="text-xs font-medium text-muted-foreground">Projected Annual Impact</div>
            <div class="mt-1 text-sm">
                <span class="font-medium">+$@((projectedAnnualImpact / 1000).ToString("N0"))K</span>
                <span class="text-muted-foreground">additional revenue</span>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-px bg-border">
            @foreach (var variant in experimentData)
            {
                var conversionRate = (double)variant.Conversions / variant.Visitors * 100;
                var isTest = variant.Variant != "Control";

                <div class="bg-card">
                    <div class="border-b px-4 py-3">
                        <div class="flex items-center justify-between">
                            <span class="text-sm font-medium">@variant.Variant</span>
                            <span class="text-xs text-muted-foreground">$@variant.Price/mo</span>
                        </div>
                    </div>

                    <div class="space-y-px bg-border">
                        <div class="bg-card px-4 py-2.5">
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">Conversions</span>
                                <span class="font-medium tabular-nums">
                                    @variant.Conversions.ToString("N0")
                                </span>
                            </div>
                        </div>
                        <div class="bg-card px-4 py-2.5">
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">Visitors</span>
                                <span class="font-medium tabular-nums">
                                    @variant.Visitors.ToString("N0")
                                </span>
                            </div>
                        </div>
                        <div class="bg-card px-4 py-2.5">
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">Conv. Rate</span>
                                <span class="font-medium tabular-nums">@(conversionRate.ToString("F2"))%</span>
                            </div>
                        </div>
                        <div class="bg-card px-4 py-2.5">
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">ARPU</span>
                                <span class="@(Cn.Merge("font-medium tabular-nums", isTest ? "text-emerald-600" : ""))">
                                    $@(variant.Arpu.ToString("F1"))
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="border-t px-4 py-3">
                        <div class="mb-2 text-xs font-medium text-muted-foreground">
                            Plan Selection
                        </div>
                        <div class="space-y-2">
                            @foreach (var plan in variant.PlanBreakdown)
                            {
                                <div>
                                    <div class="mb-1 flex items-center justify-between text-xs">
                                        <span class="text-muted-foreground">@plan.Plan</span>
                                        <span class="font-medium tabular-nums">@plan.Percentage%</span>
                                    </div>
                                    <div class="h-1 overflow-hidden rounded-full bg-muted">
                                        <div class="h-full bg-foreground" style="width: @(plan.Percentage)%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PlanBreakdownItem(string Plan, int Percentage, int Count);

    private record ExperimentVariant(string Variant, int Price, int Conversions, int Visitors, double Arpu, PlanBreakdownItem[] PlanBreakdown);

    private static readonly ExperimentVariant[] experimentData = new[]
    {
        new ExperimentVariant("Control", 29, 847, 12420, 34.2, new[]
        {
            new PlanBreakdownItem("Starter", 62, 525),
            new PlanBreakdownItem("Pro", 31, 262),
            new PlanBreakdownItem("Enterprise", 7, 60),
        }),
        new ExperimentVariant("Test (Value Pricing)", 39, 782, 12380, 42.8, new[]
        {
            new PlanBreakdownItem("Starter", 48, 375),
            new PlanBreakdownItem("Pro", 41, 321),
            new PlanBreakdownItem("Enterprise", 11, 86),
        }),
    };

    private static readonly double controlConversionRate = (double)experimentData[0].Conversions / experimentData[0].Visitors * 100;
    private static readonly double testConversionRate = (double)experimentData[1].Conversions / experimentData[1].Visitors * 100;
    private static readonly double conversionRateDiff = testConversionRate - controlConversionRate;
    private static readonly double arpuDiff = experimentData[1].Arpu - experimentData[0].Arpu;
    private static readonly double arpuDiffPercentage = arpuDiff / experimentData[0].Arpu * 100;

    private static readonly double statisticalSignificance = 97.4;
    private static readonly int projectedAnnualImpact = 284000;
}
