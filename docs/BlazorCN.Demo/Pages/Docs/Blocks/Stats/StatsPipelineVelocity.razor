@* ========================================
   Block: stats-pipeline-velocity
   Title: Stats Pipeline Velocity
   Description: Sales velocity metrics with deal size, win rate, cycle length, and deals per month
   Dependencies: None
   Source: original/blocks/stats/stats-pipeline-velocity.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Pipeline Velocity</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">Sales performance metrics</p>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            @foreach (var metric in _velocityMetrics)
            {
                var changeColor = metric.Change > 0 ? "text-emerald-600" : (metric.Label == "Cycle Length" ? "text-emerald-600" : "text-red-600");
                <div class="bg-card px-4 py-3">
                    <p class="text-xs text-muted-foreground">@metric.Label</p>
                    <p class="mt-1 text-xl font-semibold tabular-nums">@metric.Value</p>
                    <div class="mt-0.5 flex items-center gap-1">
                        <p class="@($"text-xs {changeColor}")">
                            @(metric.Change > 0 ? "+" : "")@(metric.Change)%
                        </p>
                        <span class="text-xs text-muted-foreground">@metric.Unit</span>
                    </div>
                </div>
            }
        </div>

        <div class="border-b px-4 py-4">
            <div class="space-y-3.5">
                @foreach (var metric in _pipelineMetrics)
                {
                    var barColor = metric.Percentage >= 95 ? "bg-emerald-500" : metric.Percentage >= 80 ? "bg-amber-500" : "bg-red-500";
                    <div>
                        <div class="mb-1.5 flex items-center justify-between">
                            <span class="text-sm font-medium">@metric.Label</span>
                            <div class="flex items-center gap-2">
                                <span class="text-xs text-muted-foreground">
                                    @metric.Current / @metric.Target
                                </span>
                                <span class="text-sm font-semibold tabular-nums">
                                    @metric.Percentage.ToString("F1")%
                                </span>
                            </div>
                        </div>
                        <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                            <div class="@($"h-full rounded-full {barColor}")"
                                 style="@($"width: {Math.Min(metric.Percentage, 100)}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="rounded-md bg-muted/50 px-4 py-3">
                <div class="flex items-center justify-between">
                    <div>
                        <div class="text-sm font-medium">Forecast (Next 30 Days)</div>
                        <div class="mt-0.5 text-xs text-muted-foreground">
                            Based on current velocity
                        </div>
                    </div>
                    <div class="text-right">
                        <div class="text-2xl font-semibold tabular-nums">$873K</div>
                        <div class="mt-0.5 text-xs text-emerald-600">+15.2% vs last month</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record VelocityMetric(string Label, string Value, string Unit, double Change);
    private record PipelineMetric(string Label, string Current, string Target, double Percentage);

    private static readonly VelocityMetric[] _velocityMetrics =
    [
        new("Avg Deal Size", "$48,500", "ACV", 8.3),
        new("Win Rate", "24", "%", 2.1),
        new("Cycle Length", "42", "days", -8.5),
        new("Deals/Month", "18", "closed", 12.4),
    ];

    private static readonly PipelineMetric[] _pipelineMetrics =
    [
        new("Monthly Velocity", "$284K", "$300K", 94.7),
        new("Pipeline Coverage", "3.2x", "3.5x", 91.4),
    ];
}
