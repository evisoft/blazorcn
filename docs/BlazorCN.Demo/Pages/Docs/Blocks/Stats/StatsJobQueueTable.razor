@* ============================================================
   Block: stats-job-queue-table
   Title: StatsJobQueueTable
   Description: A background job queue stats table for React and Next.js with six job-type rows, semantic status dots, queue depth plus processing rate plus average duration columns, and a saturation progress bar at the bottom of each row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-job-queue-table.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Background job queues</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Updated every 5s · 6 queues</p>
            </div>
            <div class="text-right">
                <p class="text-xs text-muted-foreground">Backlog</p>
                <p class="mt-0.5 text-sm font-semibold tabular-nums">
                    @FormatCount(_totalDepth)
                    @if (_criticalCount > 0)
                    {
                        <span class="ml-1.5 text-[11px] font-medium text-red-600 dark:text-red-400">
                            · @_criticalCount critical
                        </span>
                    }
                </p>
            </div>
        </div>

        <ul class="divide-y">
            @foreach (var job in _jobs)
            {
                var saturation = Math.Min(100.0, (double)job.Depth / job.Capacity * 100.0);
                <li class="px-4 py-3" key="@job.Id">
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex min-w-0 items-center gap-2">
                            <span
                                aria-label="@job.Tier"
                                class="@Cn.Merge("size-1.5 shrink-0 rounded-full", StatusDotClass(job.Tier))"
                                role="img"
                            ></span>
                            <code class="truncate font-mono text-xs">@job.Name</code>
                            <span class="shrink-0 rounded bg-muted px-1.5 py-0.5 text-[10px] font-medium text-muted-foreground">
                                @job.Worker
                            </span>
                        </div>
                    </div>

                    <div class="mt-2 grid grid-cols-3 gap-3">
                        <div>
                            <p class="text-[10px] uppercase tracking-widest text-muted-foreground">
                                Depth
                            </p>
                            <p class="@Cn.Merge("mt-0.5 text-sm font-semibold tabular-nums", job.Tier == "critical" ? "text-red-600 dark:text-red-400" : "")">
                                @FormatCount(job.Depth)
                                <span class="ml-1 text-[10px] font-normal text-muted-foreground">
                                    /@FormatCount(job.Capacity)
                                </span>
                            </p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-widest text-muted-foreground">
                                Rate
                            </p>
                            <p class="mt-0.5 text-sm font-semibold tabular-nums">@job.Rate</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-widest text-muted-foreground">
                                Avg duration
                            </p>
                            <p class="mt-0.5 text-sm font-semibold tabular-nums">
                                @job.AverageDuration
                            </p>
                        </div>
                    </div>

                    <div
                        aria-valuemax="@job.Capacity"
                        aria-valuemin="0"
                        aria-valuenow="@job.Depth"
                        class="mt-2.5 h-1 w-full overflow-hidden rounded-full bg-muted"
                        role="progressbar"
                    >
                        <div
                            class="@Cn.Merge("h-full rounded-full transition-all duration-700 ease-out", BarColorClass(job.Tier))"
                            style="@($"width:{saturation:F1}%")"
                        ></div>
                    </div>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record JobQueue(string Id, string Name, string Worker, int Depth, int Capacity, string Rate, string AverageDuration, string Tier);

    private static readonly JobQueue[] _jobs =
    [
        new("email.transactional", "email.transactional", "web",      128,   1500, "742/min", "84ms",   "healthy"),
        new("image.resize",        "image.resize",        "media",   1204,   2000, "318/min", "612ms",  "warning"),
        new("billing.invoice",     "billing.invoice",     "priority",  18,    500, "42/min",  "1.2s",   "healthy"),
        new("webhook.delivery",    "webhook.delivery",    "default", 2870,   3000, "94/min",  "2.4s",   "critical"),
        new("export.csv",          "export.csv",          "batch",     46,    200, "8/min",   "18.7s",  "healthy"),
        new("search.reindex",      "search.reindex",      "batch",    894,   1200, "26/min",  "4.1s",   "warning"),
    ];

    private static readonly int _totalDepth = _jobs.Sum(j => j.Depth);
    private static readonly int _criticalCount = _jobs.Count(j => j.Tier == "critical");

    private static string FormatCount(int value) => value.ToString("N0");

    private static string StatusDotClass(string tier) => tier switch
    {
        "healthy"  => "bg-emerald-500",
        "warning"  => "bg-amber-500",
        _          => "bg-red-500",
    };

    private static string BarColorClass(string tier) => tier switch
    {
        "healthy"  => "bg-emerald-500/70 dark:bg-emerald-400/70",
        "warning"  => "bg-amber-500/70 dark:bg-amber-400/70",
        _          => "bg-red-500/70 dark:bg-red-400/70",
    };
}
