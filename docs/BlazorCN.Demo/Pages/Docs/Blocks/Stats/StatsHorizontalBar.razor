@* ========================================
   Block: stats-horizontal-bar
   Title: Stats Horizontal Bar
   Description: Horizontal stats bar with profit metrics, change percentages, and connected card layout
   Dependencies: None
   Source: original/blocks/stats/stats-horizontal-bar.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-lg border bg-border sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var stat in _data)
        {
            <div class="bg-card px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-muted-foreground">@stat.Name</span>
                    <span class="@($"text-xs font-medium tabular-nums {(stat.IsPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")}")">
                        @stat.Change
                    </span>
                </div>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@stat.Value</p>
            </div>
        }
    </div>
</section>

@code {
    private record StatItem(string Name, string Value, string Change, bool IsPositive);

    private static readonly StatItem[] _data =
    [
        new("Profit", "$287,654.00", "+8.32%", true),
        new("Late payments", "$9,435.00", "-12.64%", false),
        new("Pending orders", "$173,229.00", "+2.87%", true),
        new("Operating costs", "$52,891.00", "-5.73%", false),
    ];
}
