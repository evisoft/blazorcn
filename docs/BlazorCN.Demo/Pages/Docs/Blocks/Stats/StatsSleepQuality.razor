@* ========================================
   Block: stats-sleep-quality
   Title: Stats Sleep Quality
   Description: A sleep tracking component displaying total sleep duration, sleep stages breakdown, sleep score, and efficiency metrics
   Dependencies: None
   Source: original/blocks/stats/stats-sleep-quality.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-medium">Sleep Quality</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">Last night</p>
                </div>
                <div class="text-right">
                    <div class="@($"text-2xl font-semibold tabular-nums {(_sleepScore >= 80 ? "text-emerald-500" : "text-amber-500")}")">
                        @_sleepScore
                    </div>
                    <p class="text-xs text-muted-foreground">Sleep Score</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <div>
                    <div class="text-2xl font-semibold tabular-nums">@(_totalSleep)h</div>
                    <p class="mt-0.5 text-xs text-muted-foreground">Total Sleep</p>
                </div>
                <div class="text-right">
                    <div class="@($"text-sm font-semibold tabular-nums {(_efficiency >= 85 ? "text-emerald-500" : "text-amber-500")}")">
                        @_efficiency.ToString("F0")%
                    </div>
                    <p class="text-xs text-muted-foreground">Efficiency</p>
                </div>
            </div>

            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span>@_bedtime</span>
                <span>\u2192</span>
                <span>@_wakeTime</span>
                <span class="ml-auto">@(_timeInBed)h in bed</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 text-xs font-medium text-muted-foreground">Sleep Stages</div>
            <div class="mb-3 flex h-2 overflow-hidden rounded-full">
                @foreach (var stage in _sleepStages)
                {
                    <div class="@($"h-full {stage.Color}")"
                         style="@($"width: {stage.Percentage}%")"></div>
                }
            </div>
            <div class="space-y-2">
                @foreach (var stage in _sleepStages)
                {
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@($"h-2 w-2 rounded-full {stage.Color}")"></span>
                            <span class="text-sm font-medium">@stage.Stage</span>
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-xs text-muted-foreground">@(stage.Percentage)%</span>
                            <span class="text-xs font-semibold tabular-nums">
                                @stage.Duration.ToString("F1")h
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="grid grid-cols-4 gap-px bg-border">
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Deep</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">@(_sleepStages[0].Percentage)%</div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Light</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">@(_sleepStages[1].Percentage)%</div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">REM</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">@(_sleepStages[2].Percentage)%</div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Awake</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">@(_sleepStages[3].Percentage)%</div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SleepStage(string Stage, double Duration, int Percentage, string Color);

    private const double _totalSleep = 7.5;
    private const double _timeInBed = 8.2;
    private const int _sleepScore = 84;
    private const string _bedtime = "11:15 PM";
    private const string _wakeTime = "7:27 AM";

    private static readonly double _efficiency = _totalSleep / _timeInBed * 100;

    private static readonly SleepStage[] _sleepStages =
    [
        new("Deep Sleep", 1.8, 24, "bg-blue-500"),
        new("Light Sleep", 3.9, 52, "bg-emerald-500"),
        new("REM Sleep", 1.5, 20, "bg-amber-500"),
        new("Awake", 0.3, 4, "bg-red-500"),
    ];
}
