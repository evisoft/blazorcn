@* ============================================================
   Block: stats-calendar-heatmap-month
   Title: StatsCalendarHeatmapMonth
   Description: A month-view calendar heatmap stats card for React and Next.js with a 6x7 grid of day cells, 5-level emerald intensity ramp, inline date numerals, and an intensity legend built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-calendar-heatmap-month.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Publishing cadence</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    April 2026 · @_totalEvents articles across @_activeDays active days
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="flame" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                    @_activeDays / 30 days
                </span>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="grid grid-cols-7 gap-1">
                @foreach (var label in _dayLabels)
                {
                    <div class="pb-1 text-center text-[10px] font-medium uppercase tracking-wide text-muted-foreground">
                        @label
                    </div>
                }
                @foreach (var cell in _monthData)
                {
                    var level = Math.Min(4, Math.Max(0, cell.Intensity));
                    var cellClass = cell.InMonth ? _intensityClasses[level] : "bg-muted/40 opacity-40";
                    var ariaLabel = cell.InMonth
                        ? $"April {cell.Date}: {cell.Count} articles"
                        : "Outside current month";
                    var spanClass = level >= 3 ? "text-emerald-950 dark:text-emerald-50" : "text-foreground/70";
                    <div aria-label="@ariaLabel"
                         class="@Cn.Merge("relative flex aspect-square items-end justify-end rounded-md p-1", cellClass)"
                         role="img">
                        <span class="@Cn.Merge("text-[10px] font-medium tabular-nums", spanClass)">
                            @cell.Date
                        </span>
                    </div>
                }
            </div>
        </div>

        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-xs text-muted-foreground tabular-nums">
                Total this month: @_totalEvents
            </p>
            <div class="flex items-center gap-1.5">
                <span class="text-[10px] text-muted-foreground">Less</span>
                @foreach (var lvl in _legendLevels)
                {
                    <span aria-hidden="true"
                          class="@Cn.Merge("size-2.5 rounded-sm", _intensityClasses[lvl])"></span>
                }
                <span class="text-[10px] text-muted-foreground">More</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record DayCell(string Id, int Date, int Intensity, bool InMonth, int Count);

    private static readonly string[] _dayLabels = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private static readonly string[] _intensityClasses =
    [
        "bg-muted",
        "bg-emerald-200 dark:bg-emerald-950",
        "bg-emerald-300 dark:bg-emerald-800",
        "bg-emerald-400 dark:bg-emerald-600",
        "bg-emerald-500 dark:bg-emerald-400",
    ];

    private static readonly int[] _legendLevels = [0, 1, 2, 3, 4];

    private static readonly DayCell[] _monthData =
    [
        new("pre-1",  30, 0, false, 0),
        new("pre-2",  31, 0, false, 0),
        new("d-1",    1,  1, true,  3),
        new("d-2",    2,  2, true,  7),
        new("d-3",    3,  3, true,  12),
        new("d-4",    4,  0, true,  0),
        new("d-5",    5,  0, true,  0),
        new("d-6",    6,  2, true,  6),
        new("d-7",    7,  4, true,  18),
        new("d-8",    8,  3, true,  11),
        new("d-9",    9,  2, true,  8),
        new("d-10",   10, 4, true,  21),
        new("d-11",   11, 1, true,  4),
        new("d-12",   12, 0, true,  0),
        new("d-13",   13, 2, true,  7),
        new("d-14",   14, 3, true,  13),
        new("d-15",   15, 4, true,  19),
        new("d-16",   16, 3, true,  12),
        new("d-17",   17, 2, true,  6),
        new("d-18",   18, 1, true,  2),
        new("d-19",   19, 0, true,  0),
        new("d-20",   20, 2, true,  9),
        new("d-21",   21, 3, true,  14),
        new("d-22",   22, 4, true,  22),
        new("d-23",   23, 3, true,  11),
        new("d-24",   24, 2, true,  8),
        new("d-25",   25, 1, true,  3),
        new("d-26",   26, 0, true,  0),
        new("d-27",   27, 3, true,  10),
        new("d-28",   28, 4, true,  24),
        new("d-29",   29, 3, true,  13),
        new("d-30",   30, 2, true,  9),
        new("post-1", 1,  0, false, 0),
        new("post-2", 2,  0, false, 0),
        new("post-3", 3,  0, false, 0),
    ];

    private static readonly int _totalEvents = ComputeTotal();
    private static readonly int _activeDays = ComputeActiveDays();

    private static int ComputeTotal()
    {
        var sum = 0;
        foreach (var cell in _monthData) sum += cell.Count;
        return sum;
    }

    private static int ComputeActiveDays()
    {
        var count = 0;
        foreach (var cell in _monthData)
            if (cell.InMonth && cell.Count > 0) count++;
        return count;
    }
}
