@* ========================================
   Block: stats-release-notes
   Title: Stats Release Notes
   Description: A software release tracking component displaying version numbers, bug fixes, features, and breaking changes for Next.js developer tools and SaaS applications
   Long Description: A referral program analytics dashboard tracking invites sent, signups, conversion rate, and reward payouts built with React, Next.js, and Tailwind CSS
   Dependencies: None
   Source: original/blocks/stats/stats-release-notes.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-medium">Release Notes</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">Version history</p>
                </div>
                <div class="text-right">
                    <div class="text-2xl font-semibold tabular-nums">v@(latestRelease.Version)</div>
                    <p class="text-xs text-muted-foreground">Latest Release</p>
                </div>
            </div>
        </div>

        <div>
            @for (var i = 0; i < releasesData.Length; i++)
            {
                var release = releasesData[i];
                var isLast = i == releasesData.Length - 1;
                var hasBreaking = release.Breaking > 0;
                var changeCount = release.BugFixes + release.Features + release.Improvements + release.Breaking;

                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                    <div class="mb-2 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-sm font-medium">v@(release.Version)</span>
                            <span class="@(Cn.Merge("size-2 rounded-full", GetTypeColor(release.Type)))"></span>
                            @if (hasBreaking)
                            {
                                <span class="size-1.5 rounded-full bg-red-500"></span>
                            }
                        </div>
                        <span class="text-xs text-muted-foreground">@release.Date</span>
                    </div>

                    <div class="mb-2 flex items-center gap-2">
                        <span class="text-xs text-muted-foreground">
                            @(GetTypeLabel(release.Type)) Release
                        </span>
                        <span class="text-xs text-muted-foreground">•</span>
                        <span class="text-xs text-muted-foreground">
                            @changeCount @(changeCount == 1 ? "change" : "changes")
                        </span>
                    </div>

                    <div class="grid grid-cols-4 gap-3">
                        <div>
                            <div class="text-xs text-muted-foreground">Features</div>
                            <div class="mt-0.5 flex items-center gap-1">
                                @if (release.Features > 0)
                                {
                                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                                }
                                <span class="text-xs font-semibold tabular-nums">@release.Features</span>
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-muted-foreground">Bug Fixes</div>
                            <div class="mt-0.5 flex items-center gap-1">
                                @if (release.BugFixes > 0)
                                {
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                }
                                <span class="text-xs font-semibold tabular-nums">@release.BugFixes</span>
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-muted-foreground">Improvements</div>
                            <div class="mt-0.5 text-xs font-semibold tabular-nums">
                                @release.Improvements
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-muted-foreground">Breaking</div>
                            <div class="mt-0.5 flex items-center gap-1">
                                @if (hasBreaking)
                                {
                                    <span class="size-1.5 rounded-full bg-red-500"></span>
                                }
                                <span class="@(Cn.Merge("text-xs font-semibold tabular-nums", hasBreaking ? "text-red-500" : ""))">
                                    @release.Breaking
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="grid grid-cols-3 gap-px border-t bg-border">
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Latest Type</div>
                <div class="mt-0.5 text-sm font-semibold">@(GetTypeLabel(latestRelease.Type))</div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Latest Changes</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">@totalChanges</div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Total Releases</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">@releasesData.Length</div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Release(string Version, string Date, int BugFixes, int Features, int Improvements, int Breaking, string Type);

    private static readonly Release[] releasesData = new[]
    {
        new Release("2.5.0", "2 days ago", 8, 3, 5, 0, "minor"),
        new Release("2.4.2", "1 week ago", 12, 0, 2, 0, "patch"),
        new Release("2.4.1", "2 weeks ago", 5, 0, 1, 0, "patch"),
        new Release("2.4.0", "3 weeks ago", 15, 7, 9, 0, "minor"),
        new Release("2.0.0", "2 months ago", 23, 12, 18, 4, "major"),
    };

    private static readonly Release latestRelease = releasesData[0];
    private static readonly int totalChanges = latestRelease.BugFixes + latestRelease.Features + latestRelease.Improvements + latestRelease.Breaking;

    private static string GetTypeLabel(string type) => type switch
    {
        "major" => "Major",
        "minor" => "Minor",
        "patch" => "Patch",
        _ => type,
    };

    private static string GetTypeColor(string type) => type switch
    {
        "major" => "bg-red-500",
        "minor" => "bg-blue-500",
        "patch" => "bg-emerald-500",
        _ => "bg-muted-foreground",
    };
}
