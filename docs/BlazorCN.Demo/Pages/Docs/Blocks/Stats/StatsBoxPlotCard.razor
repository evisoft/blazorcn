@* ============================================================
   Block: stats-box-plot-card
   Title: StatsBoxPlotCard
   Description: A box plot stats card for React and Next.js with five horizontal box-and-whisker plots showing min Q1 median Q3 max and outliers per category, SVG-positioned elements, and tabular-nums percentile values built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-box-plot-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Latency distribution by endpoint</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Last 24 hours · milliseconds</p>
        </div>
        <div class="divide-y">
            @foreach (var box in _boxes)
            {
                <div class="px-4 py-3">
                    <div class="flex items-center justify-between">
                        <code class="font-mono text-xs">@box.Label</code>
                        <span class="text-xs text-muted-foreground tabular-nums">
                            p50: <span class="font-medium text-foreground">@(box.Median)ms</span>
                        </span>
                    </div>
                    <div class="relative mt-2 h-5">
                        <svg width="100%" height="20" class="overflow-visible">
                            @* Whisker line *@
                            @((MarkupString)$"<line x1=\"{Pct(box.Min).ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}%\" x2=\"{Pct(box.Max).ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}%\" y1=\"10\" y2=\"10\" stroke=\"var(--chart-1)\" stroke-width=\"1\" stroke-opacity=\"0.5\" />")
                            @* Min whisker cap *@
                            @((MarkupString)$"<line x1=\"{Pct(box.Min).ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}%\" x2=\"{Pct(box.Min).ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}%\" y1=\"5\" y2=\"15\" stroke=\"var(--chart-1)\" stroke-width=\"1.5\" />")
                            @* Max whisker cap *@
                            @((MarkupString)$"<line x1=\"{Pct(box.Max).ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}%\" x2=\"{Pct(box.Max).ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}%\" y1=\"5\" y2=\"15\" stroke=\"var(--chart-1)\" stroke-width=\"1.5\" />")
                            @* Box *@
                            @((MarkupString)$"<rect x=\"{Pct(box.Q1).ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}%\" y=\"3\" width=\"{(Pct(box.Q3) - Pct(box.Q1)).ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}%\" height=\"14\" fill=\"var(--chart-1)\" fill-opacity=\"0.2\" stroke=\"var(--chart-1)\" stroke-width=\"1.5\" rx=\"2\" />")
                            @* Median line *@
                            @((MarkupString)$"<line x1=\"{Pct(box.Median).ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}%\" x2=\"{Pct(box.Median).ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}%\" y1=\"3\" y2=\"17\" stroke=\"var(--chart-1)\" stroke-width=\"2\" />")
                            @* Outliers *@
                            @if (box.Outliers != null)
                            {
                                foreach (var o in box.Outliers)
                                {
                                    @((MarkupString)$"<circle cx=\"{Pct(o).ToString("F4", System.Globalization.CultureInfo.InvariantCulture)}%\" cy=\"10\" r=\"2.5\" fill=\"var(--destructive)\" fill-opacity=\"0.7\" />")
                                }
                            }
                        </svg>
                    </div>
                    <div class="mt-1 flex justify-between text-[10px] text-muted-foreground tabular-nums">
                        <span>@(box.Min)ms</span>
                        <span>@(box.Max)ms@(box.Outliers != null ? $" · {box.Outliers.Length} outlier{(box.Outliers.Length > 1 ? "s" : "")}" : "")</span>
                    </div>
                </div>
            }
        </div>
        <div class="flex items-center gap-3 border-t px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                <div class="flex items-center">
                    <span class="h-2 w-4 rounded-sm" style="background-color: var(--chart-1); opacity: 0.2;"></span>
                </div>
                <span class="text-xs text-muted-foreground">Q1–Q3</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="h-3 w-0.5" style="background-color: var(--chart-1);"></span>
                <span class="text-xs text-muted-foreground">Median</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-destructive"></span>
                <span class="text-xs text-muted-foreground">Outlier</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record BoxData(string Id, string Label, int Min, int Q1, int Median, int Q3, int Max, int[]? Outliers = null);

    private static readonly BoxData[] _boxes =
    [
        new("api-users",    "/api/users",    12,  28,  42,  68,  95,  [180, 220]),
        new("api-products", "/api/products",  8,  22,  35,  52,  82,  null),
        new("api-orders",   "/api/orders",   24,  58,  95, 145, 210,  [350]),
        new("api-search",   "/api/search",   45,  92, 138, 195, 280,  null),
        new("api-auth",     "/api/auth",      6,  14,  22,  35,  52,  null),
    ];

    private const double GlobalMin = 0;
    private const double GlobalMax = 350;

    private static double Pct(double value) => (value - GlobalMin) / (GlobalMax - GlobalMin) * 100;
}
