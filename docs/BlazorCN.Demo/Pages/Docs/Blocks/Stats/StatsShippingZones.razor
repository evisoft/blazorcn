@* ========================================
   Block: stats-shipping-zones
   Title: Stats Shipping Zones
   Description: A shipping zone analytics dashboard showing delivery times, costs, and volume per geographic zone
   Dependencies: None
   Source: original/blocks/stats/stats-shipping-zones.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Shipping Performance</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days by zone</p>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Total Orders</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@((_totalOrders / 1000.0).ToString("F1"))K</p>
                <p class="mt-0.5 text-xs text-emerald-600">+8.3%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Avg Cost</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">$@_avgCost.ToString("F2")</p>
                <p class="mt-0.5 text-xs text-red-600">+$0.15</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Avg Delivery</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_avgDelivery.ToString("F1")d</p>
                <p class="mt-0.5 text-xs text-emerald-600">-0.3 days</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">On-Time</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">94.1%</p>
                <p class="mt-0.5 text-xs text-emerald-600">+1.2%</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h3 class="text-sm font-medium">Zone Performance</h3>
                <span class="text-xs text-muted-foreground">4 zones</span>
            </div>
        </div>

        <div class="border-b">
            @for (var i = 0; i < _zones.Length; i++)
            {
                var zone = _zones[i];
                var isLast = i == _zones.Length - 1;
                var rateColor = zone.OnTimeRate >= 95 ? "bg-emerald-500" : zone.OnTimeRate >= 90 ? "bg-blue-500" : "bg-amber-500";
                <div class="@($"px-4 py-2.5 {(isLast ? "" : "border-b")}")">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@zone.Name</span>
                                <span class="@($"h-1.5 w-1.5 shrink-0 rounded-full {rateColor}")"></span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@zone.Region</p>
                            <div class="mt-1.5 grid grid-cols-4 gap-2">
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Orders</p>
                                    <p class="mt-0.5 text-sm tabular-nums">@zone.OrderVolume.ToString("N0")</p>
                                </div>
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Avg Cost</p>
                                    <p class="mt-0.5 text-sm tabular-nums">$@zone.AvgCost.ToString("F2")</p>
                                </div>
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Delivery</p>
                                    <p class="mt-0.5 text-sm tabular-nums">@zone.AvgDeliveryDays.ToString("F1")d</p>
                                </div>
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">On-Time</p>
                                    <p class="mt-0.5 text-sm tabular-nums">@zone.OnTimeRate.ToString("F1")%</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Carrier Distribution</h3>
            <div class="mt-2 flex h-1.5 overflow-hidden rounded-full bg-muted">
                @foreach (var carrier in _carriers)
                {
                    <div class="@($"h-full {carrier.Color}")"
                         style="@($"width: {(double)carrier.Volume / _totalCarrierVolume * 100}%")"></div>
                }
            </div>
            <div class="mt-3 space-y-2.5">
                @foreach (var carrier in _carriers)
                {
                    <div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="@($"h-2 w-2 rounded-full {carrier.Color}")"></span>
                                <span class="text-sm">@carrier.Name</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-xs tabular-nums text-muted-foreground">
                                    @carrier.Volume.ToString("N0") orders
                                </span>
                                <span class="text-sm tabular-nums">$@carrier.AvgCost.ToString("F2")</span>
                            </div>
                        </div>
                        <div class="mt-1 h-1 overflow-hidden rounded-full bg-muted">
                            <div class="@($"h-full {carrier.Color}")"
                                 style="@($"width: {carrier.OnTimeRate}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-xs font-medium text-muted-foreground">Total Shipping Cost</p>
                    <p class="mt-1 text-sm tabular-nums">$@((_totalOrders * _avgCost / 1000).ToString("F1"))K</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days</p>
                </div>
                <div>
                    <p class="text-xs font-medium text-muted-foreground">Cost per Order</p>
                    <p class="mt-1 text-sm tabular-nums">$@_avgCost.ToString("F2")</p>
                    <p class="mt-0.5 text-xs text-red-600">+2.1%</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ShippingZone(string Name, string Region, double AvgDeliveryDays, double AvgCost, int OrderVolume, double OnTimeRate);
    private record CarrierStat(string Name, int Volume, double AvgCost, double OnTimeRate, string Color);

    private static readonly ShippingZone[] _zones =
    [
        new("Zone 1", "Local (0-150 mi)", 1.8, 4.50, 1847, 97.2),
        new("Zone 2", "Regional (151-300 mi)", 2.4, 6.75, 2341, 95.8),
        new("Zone 3", "National (301-600 mi)", 3.2, 8.95, 3156, 93.4),
        new("Zone 4", "Extended (600+ mi)", 4.8, 12.50, 1523, 89.7),
    ];

    private static readonly CarrierStat[] _carriers =
    [
        new("USPS", 4234, 7.25, 94.2, "bg-blue-500"),
        new("UPS", 2847, 9.50, 96.1, "bg-amber-500"),
        new("FedEx", 1786, 10.25, 95.3, "bg-emerald-500"),
    ];

    private static readonly int _totalOrders = _zones.Sum(z => z.OrderVolume);
    private static readonly double _avgCost = _zones.Sum(z => z.AvgCost * z.OrderVolume) / _totalOrders;
    private static readonly double _avgDelivery = _zones.Sum(z => z.AvgDeliveryDays * z.OrderVolume) / _totalOrders;
    private static readonly int _totalCarrierVolume = _carriers.Sum(c => c.Volume);
}
