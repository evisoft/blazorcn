@* ============================================================
   Block: stats-comparison-with-sparklines
   Title: StatsComparisonWithSparklines
   Description: A period comparison stats card for React and Next.js with two side-by-side columns, each showing a NumberFlow animated value and a 48px ChartContainer sparkline, separated by a vertical divider and a delta callout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-comparison-with-sparklines.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Monthly active users</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Mar 2026 vs Feb 2026</p>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-[11px] font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3" aria-hidden="true" />+@(_deltaPercent.ToString("F1"))%
            </span>
        </div>

        <div class="grid grid-cols-2 divide-x">
            <div class="px-4 py-4">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    This month
                </p>
                <div class="mt-2 min-w-[120px]">
                    <span class="text-2xl font-semibold tabular-nums">@_currentTotal.ToString("N0")</span>
                </div>
                <div class="mt-3 h-12">
                    <svg viewBox="0 0 120 48" class="h-full w-full" preserveAspectRatio="none" aria-hidden="true">
                        <defs>
                            <linearGradient id="spark-current" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="oklch(0.646 0.222 41.116)" stop-opacity="0.32" />
                                <stop offset="100%" stop-color="oklch(0.646 0.222 41.116)" stop-opacity="0" />
                            </linearGradient>
                        </defs>
                        <path d="@_currentFill" fill="url(#spark-current)" />
                        <path d="@_currentLine" fill="none" stroke="oklch(0.646 0.222 41.116)" stroke-width="1.5" />
                    </svg>
                </div>
            </div>

            <div class="px-4 py-4">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Last month
                </p>
                <div class="mt-2 min-w-[120px]">
                    <span class="text-2xl font-semibold tabular-nums text-muted-foreground">@_previousTotal.ToString("N0")</span>
                </div>
                <div class="mt-3 h-12">
                    <svg viewBox="0 0 120 48" class="h-full w-full" preserveAspectRatio="none" aria-hidden="true">
                        <defs>
                            <linearGradient id="spark-previous" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="var(--muted-foreground)" stop-opacity="0.2" />
                                <stop offset="100%" stop-color="var(--muted-foreground)" stop-opacity="0" />
                            </linearGradient>
                        </defs>
                        <path d="@_previousFill" fill="url(#spark-previous)" />
                        <path d="@_previousLine" fill="none" stroke="var(--muted-foreground)" stroke-width="1.5" stroke-dasharray="3 3" />
                    </svg>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">Delta vs previous period</span>
            <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                +@(_delta.ToString("N0")) MAU
            </span>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _currentValues = [182, 194, 208, 201, 217, 229, 246, 238, 254, 271, 289, 302];
    private static readonly int[] _previousValues = [164, 171, 168, 176, 182, 179, 184, 190, 186, 194, 198, 205];

    private const int _currentTotal = 48_372;
    private const int _previousTotal = 39_845;

    private static readonly int _delta = _currentTotal - _previousTotal;
    private static readonly double _deltaPercent = ((double)_delta / _previousTotal) * 100;

    private static readonly string _currentLine = BuildLinePath(_currentValues);
    private static readonly string _currentFill = BuildFillPath(_currentValues);
    private static readonly string _previousLine = BuildLinePath(_previousValues);
    private static readonly string _previousFill = BuildFillPath(_previousValues);

    private static string BuildLinePath(int[] values)
    {
        var min = 0;
        var max = 0;
        foreach (var v in values) { if (v > max) max = v; }
        var range = max - min;
        if (range == 0) range = 1;

        var points = new System.Text.StringBuilder();
        for (var i = 0; i < values.Length; i++)
        {
            var x = (double)i / (values.Length - 1) * 120;
            var y = 48 - ((double)(values[i] - min) / range) * 44 - 2;
            if (i == 0)
                points.Append($"M{x:F1},{y:F1}");
            else
                points.Append($" L{x:F1},{y:F1}");
        }
        return points.ToString();
    }

    private static string BuildFillPath(int[] values)
    {
        var line = BuildLinePath(values);
        var lastX = 120.0;
        var firstX = 0.0;
        return line + $" L{lastX:F1},48 L{firstX:F1},48 Z";
    }
}
