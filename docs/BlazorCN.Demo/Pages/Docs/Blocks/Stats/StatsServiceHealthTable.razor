@* ============================================================
   Block: stats-service-health-table
   Title: StatsServiceHealthTable
   Description: A service health stats table for React and Next.js with monospace service names, per-row status dots, tabular-nums uptime, response time, error rate columns, and border-b row dividers built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-service-health-table.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Service health</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Last 24 hours across production regions
                </p>
            </div>
            <p class="text-xs text-muted-foreground tabular-nums">
                <span class="font-medium text-foreground">@_healthyCount</span>
                @(" / ")
                @_services.Length healthy
            </p>
        </div>

        <div class="hidden grid-cols-[1.4fr_0.8fr_0.8fr_0.8fr_auto] items-center gap-3 border-b bg-muted/30 px-4 py-2 text-[10px] font-medium uppercase tracking-widest text-muted-foreground sm:grid">
            <span>Service</span>
            <span class="text-right">Uptime</span>
            <span class="text-right">Latency</span>
            <span class="text-right">Errors</span>
            <span class="sr-only">Status</span>
        </div>

        <div>
            @for (var i = 0; i < _services.Length; i++)
            {
                var svc = _services[i];
                <div class="@(Cn.Merge("px-4 py-3", i < _services.Length - 1 ? "border-b" : ""))">
                    <div class="grid grid-cols-1 items-center gap-2 sm:grid-cols-[1.4fr_0.8fr_0.8fr_0.8fr_auto] sm:gap-3">
                        <div class="min-w-0">
                            <code class="block truncate font-mono text-xs font-medium text-foreground">
                                @svc.Name
                            </code>
                            <span class="mt-0.5 block text-[10px] text-muted-foreground">
                                @svc.Region
                            </span>
                        </div>
                        <div class="flex items-baseline gap-1 sm:justify-end">
                            <span class="text-[10px] text-muted-foreground sm:hidden">Uptime</span>
                            <span class="text-sm font-semibold tabular-nums">
                                @svc.Uptime.ToString("F2")%
                            </span>
                        </div>
                        <div class="flex items-baseline gap-1 sm:justify-end">
                            <span class="text-[10px] text-muted-foreground sm:hidden">Latency</span>
                            <span class="text-sm font-semibold tabular-nums">
                                @svc.ResponseTime ms
                            </span>
                        </div>
                        <div class="flex items-baseline gap-1 sm:justify-end">
                            <span class="text-[10px] text-muted-foreground sm:hidden">Errors</span>
                            <span class="@(Cn.Merge("text-sm font-semibold tabular-nums", svc.Status != ServiceStatus.Healthy ? StatusTextClass(svc.Status) : ""))">
                                @svc.ErrorRate.ToString("F2")%
                            </span>
                        </div>
                        <div class="flex items-center gap-1.5 sm:justify-end">
                            <span aria-hidden="true"
                                  class="@(Cn.Merge("size-1.5 rounded-full", StatusDotClass(svc.Status)))">
                            </span>
                            <span class="@(Cn.Merge("text-xs font-medium", StatusTextClass(svc.Status)))">
                                @StatusLabel(svc.Status)
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum ServiceStatus { Healthy, Degraded, Down }

    private record ServiceRow(string Id, string Name, string Region, double Uptime, int ResponseTime, double ErrorRate, ServiceStatus Status);

    private static readonly ServiceRow[] _services =
    [
        new("api-gateway",          "api-gateway",          "us-east-1", 99.98, 42,  0.03, ServiceStatus.Healthy),
        new("auth-service",         "auth-service",         "us-east-1", 99.95, 68,  0.11, ServiceStatus.Healthy),
        new("billing-worker",       "billing-worker",       "eu-west-1", 99.42, 214, 1.24, ServiceStatus.Degraded),
        new("search-index",         "search-index",         "us-west-2", 97.18, 512, 4.86, ServiceStatus.Down),
        new("media-cdn",            "media-cdn",            "global",    99.99, 18,  0.01, ServiceStatus.Healthy),
        new("analytics-pipeline",   "analytics-pipeline",   "us-east-1", 99.88, 124, 0.42, ServiceStatus.Healthy),
    ];

    private int _healthyCount => System.Linq.Enumerable.Count(_services, s => s.Status == ServiceStatus.Healthy);

    private static string StatusLabel(ServiceStatus status) => status switch
    {
        ServiceStatus.Healthy  => "Healthy",
        ServiceStatus.Degraded => "Degraded",
        ServiceStatus.Down     => "Down",
        _                      => ""
    };

    private static string StatusDotClass(ServiceStatus status) => status switch
    {
        ServiceStatus.Healthy  => "bg-emerald-500",
        ServiceStatus.Degraded => "bg-amber-500",
        ServiceStatus.Down     => "bg-red-500",
        _                      => ""
    };

    private static string StatusTextClass(ServiceStatus status) => status switch
    {
        ServiceStatus.Healthy  => "text-emerald-600 dark:text-emerald-400",
        ServiceStatus.Degraded => "text-amber-600 dark:text-amber-400",
        ServiceStatus.Down     => "text-red-600 dark:text-red-400",
        _                      => ""
    };
}
