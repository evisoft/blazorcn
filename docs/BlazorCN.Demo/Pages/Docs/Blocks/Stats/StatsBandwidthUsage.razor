@* ========================================
   Block: stats-bandwidth-usage
   Title: Stats Bandwidth Usage
   Description: CDN bandwidth monitoring with transfer volume, cache hit ratio, origin requests, and edge location performance
   Dependencies: None
   Source: original/blocks/stats/stats-bandwidth-usage.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">CDN Bandwidth Usage</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Last 30 days &#x2022; @_edgeLocations.Length edge locations
            </p>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Total Transfer</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@_totalBandwidth</span>
                    <span class="text-xs text-muted-foreground">GB</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Cache Hit Rate</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@_cacheEfficiency.ToString("F1")</span>
                    <span class="text-xs text-muted-foreground">%</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Bandwidth Cost</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">$@_cost</span>
                    <span class="text-xs text-muted-foreground">$@_costPerGb.ToString("F3")/GB</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Cache Efficiency</span>
                <span class="text-xs text-muted-foreground">
                    @_edgeRequests.ToString("N0") edge requests
                </span>
            </div>
            <div class="space-y-2">
                <div>
                    <div class="mb-1 flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Cache Hits</span>
                        <span class="font-medium tabular-nums">@_cacheEfficiency.ToString("F1")%</span>
                    </div>
                    <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                        <div class="h-full bg-emerald-500" style="@($"width: {_cacheEfficiency}%")"></div>
                    </div>
                </div>
                <div>
                    <div class="mb-1 flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Cache Misses (Origin)</span>
                        <span class="font-medium tabular-nums">@_cacheMissRatio.ToString("F1")%</span>
                    </div>
                    <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                        <div class="h-full bg-amber-500" style="@($"width: {_cacheMissRatio}%")"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 text-xs font-medium text-muted-foreground">
                Bandwidth by Content Type
            </div>
            <div class="space-y-2.5">
                @foreach (var item in _bandwidthByType)
                {
                    <div>
                        <div class="mb-1 flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">@item.Type</span>
                            <span class="font-medium tabular-nums">
                                @item.Bandwidth GB (@item.Percentage%)
                            </span>
                        </div>
                        <div class="h-1 overflow-hidden rounded-full bg-muted">
                            <div class="@($"h-full {item.Color}")" style="@($"width: {item.Percentage}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-3">
                <div class="text-xs font-medium text-muted-foreground">
                    Edge Location Performance
                </div>
            </div>
            <div>
                @for (var i = 0; i < _edgeLocations.Length; i++)
                {
                    var edge = _edgeLocations[i];
                    var isLast = i == _edgeLocations.Length - 1;
                    <div class="@($"px-4 py-2.5 {(isLast ? "" : "border-b")}")">
                        <div class="flex items-center justify-between">
                            <div class="min-w-0 flex-1">
                                <div class="text-sm font-medium">@edge.Location</div>
                                <div class="mt-0.5 text-xs text-muted-foreground">@edge.Region</div>
                            </div>
                            <div class="ml-4 flex items-center gap-4 text-xs">
                                <div class="text-right">
                                    <div class="font-medium tabular-nums">@edge.Bandwidth GB</div>
                                    <div class="text-muted-foreground">
                                        @edge.Requests.ToString("N0") req
                                    </div>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <span class="@($"h-1.5 w-1.5 rounded-full {(edge.Latency < 35 ? "bg-emerald-500" : edge.Latency < 50 ? "bg-amber-500" : "bg-red-500")}")"></span>
                                    <span class="font-medium tabular-nums">@(edge.Latency)ms</span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record BandwidthType(string Type, int Bandwidth, int Percentage, string Color);
    private record EdgeLocation(string Location, string Region, int Requests, int Bandwidth, int Latency);

    private const int _totalBandwidth = 4287;
    private const double _cacheEfficiency = 84.2;
    private const int _cost = 343;
    private const int _edgeRequests = 10200000;
    private static readonly double _cacheMissRatio = 100 - _cacheEfficiency;
    private static readonly double _costPerGb = 342.96 / _totalBandwidth;

    private static readonly BandwidthType[] _bandwidthByType =
    [
        new("Images", 2145, 50, "bg-blue-500"),
        new("Videos", 1286, 30, "bg-purple-500"),
        new("Static Assets", 600, 14, "bg-emerald-500"),
        new("API Responses", 256, 6, "bg-amber-500"),
    ];

    private static readonly EdgeLocation[] _edgeLocations =
    [
        new("US East (N. Virginia)", "us-east-1", 3580000, 1542, 28),
        new("EU West (Ireland)", "eu-west-1", 2840000, 1158, 32),
        new("Asia Pacific (Tokyo)", "ap-northeast-1", 2120000, 892, 45),
        new("US West (Oregon)", "us-west-2", 1660000, 695, 31),
    ];
}
