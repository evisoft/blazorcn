@* ============================================================
   Block: stats-period-comparison-card
   Title: StatsPeriodComparisonCard
   Description: A period-over-period comparison stats card for React and Next.js with two side-by-side tabular-nums values separated by a large delta callout, NumberFlow on the current value, and a semantic trend header built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-period-comparison-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">@_data.Label</p>
                <p class="mt-0.5 text-xs text-muted-foreground">@_data.Timeframe</p>
            </div>
            <span class="@Cn.Merge("inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium", _deltaBg, _deltaColor)">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                <span class="tabular-nums">
                    @(_isPositive ? "+" : "")@(_percent.ToString("F1"))%
                </span>
            </span>
        </div>

        <dl class="grid grid-cols-2 divide-x">
            <div class="px-4 py-5">
                <dt class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    @_data.CurrentLabel
                </dt>
                <dd class="mt-2 min-w-[140px]">
                    <p class="text-3xl font-semibold tabular-nums">
                        @FormatCurrency(_data.CurrentValue)
                    </p>
                </dd>
            </div>
            <div class="px-4 py-5">
                <dt class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    @_data.PreviousLabel
                </dt>
                <dd class="mt-2">
                    <p class="text-3xl font-semibold tabular-nums text-muted-foreground">
                        @FormatCurrency(_data.PreviousValue)
                    </p>
                </dd>
            </div>
        </dl>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <p class="text-xs text-muted-foreground">Absolute delta</p>
                <p class="@Cn.Merge("text-sm font-semibold tabular-nums", _deltaColor)">
                    @(_isPositive ? "+" : "")@FormatCurrency(_delta)
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record ComparisonData(
        string Label,
        string Timeframe,
        string CurrentLabel,
        string PreviousLabel,
        double CurrentValue,
        double PreviousValue
    );

    private static readonly ComparisonData _data = new(
        Label: "Monthly recurring revenue",
        Timeframe: "April 2026 vs March 2026",
        CurrentLabel: "This month",
        PreviousLabel: "Last month",
        CurrentValue: 187_420,
        PreviousValue: 166_800
    );

    private double _delta => _data.CurrentValue - _data.PreviousValue;
    private double _percent => (_delta / _data.PreviousValue) * 100;
    private bool _isPositive => _delta >= 0;
    private string _deltaColor => _isPositive
        ? "text-emerald-600 dark:text-emerald-400"
        : "text-red-600 dark:text-red-400";
    private string _deltaBg => _isPositive ? "bg-emerald-500/10" : "bg-red-500/10";

    private static string FormatCurrency(double value) =>
        value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
}
