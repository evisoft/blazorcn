@* ========================================
   Block: stats-activity-streak
   Title: Stats Activity Streak
   Description: Activity streak stats with heatmap grid, streak counters, and consistency metrics
   Dependencies: None
   Source: original/blocks/stats/stats-activity-streak.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Activity Streak</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Last 12 weeks of activity</p>
        </div>

        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-orange-500"></span>
                <span class="text-2xl font-semibold tabular-nums">@_currentStreak</span>
                <span class="text-xs text-muted-foreground">Current streak</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                <span class="text-2xl font-semibold tabular-nums">@_longestStreak</span>
                <span class="text-xs text-muted-foreground">Longest</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-2xl font-semibold tabular-nums">@_totalActive</span>
                <span class="text-xs text-muted-foreground">Active days</span>
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="flex gap-1.5">
                <div class="flex flex-col gap-1 pr-1">
                    @for (var i = 0; i < _days.Length; i++)
                    {
                        <div class="@($"h-3 text-[10px] leading-3 text-muted-foreground {(i % 2 == 1 ? "invisible" : "")}")">
                            @_days[i]
                        </div>
                    }
                </div>

                <div class="flex flex-1 gap-1">
                    @foreach (var week in _weeks)
                    {
                        <div class="flex flex-1 flex-col gap-1">
                            @foreach (var intensity in week)
                            {
                                <div class="@($"h-3 w-full rounded-sm transition-colors {_intensityClasses[intensity]}")"
                                     title="@($"Activity level: {intensity}")"></div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="mt-3 flex items-center justify-end gap-1.5">
                <span class="mr-1 text-xs text-muted-foreground">Less</span>
                @foreach (var cls in _intensityClasses)
                {
                    <div class="@($"h-3 w-3 rounded-sm {cls}")"></div>
                }
                <span class="ml-1 text-xs text-muted-foreground">More</span>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _activityData =
    [
        0, 1, 0, 0, 2, 0, 1, 1, 0, 0, 1, 0, 0, 0, 0, 2, 1, 0, 0, 1, 0, 1, 0, 0, 2, 1, 0, 0, 0, 1, 2, 0, 1,
        0, 1, 2, 0, 1, 3, 0, 1, 2, 0, 1, 0, 2, 1, 3, 0, 1, 2, 0, 1, 3, 1, 2, 3, 1, 0, 2, 4, 1, 3, 2, 3, 1,
        4, 2, 0, 3, 4, 2, 3, 1, 4, 3, 2, 3, 4, 2, 3, 3, 2, 4,
    ];

    private static readonly string[] _intensityClasses =
    [
        "bg-muted",
        "bg-emerald-200 dark:bg-emerald-900",
        "bg-emerald-300 dark:bg-emerald-700",
        "bg-emerald-400 dark:bg-emerald-500",
        "bg-emerald-500 dark:bg-emerald-400",
    ];

    private static readonly string[] _days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private static readonly int[][] _weeks = BuildWeeks();
    private static readonly int _currentStreak;
    private static readonly int _longestStreak;
    private static readonly int _totalActive;

    static StatsActivityStreak()
    {
        // Calculate current streak (from end)
        int current = 0;
        for (var i = _activityData.Length - 1; i >= 0; i--)
        {
            if (_activityData[i] > 0) current++;
            else break;
        }
        _currentStreak = current;

        // Calculate longest streak and total active
        int longest = 0, temp = 0, total = 0;
        foreach (var val in _activityData)
        {
            if (val > 0) { temp++; total++; if (temp > longest) longest = temp; }
            else temp = 0;
        }
        _longestStreak = longest;
        _totalActive = total;
    }

    private static int[][] BuildWeeks()
    {
        var weeks = new List<int[]>();
        for (var i = 0; i < _activityData.Length; i += 7)
        {
            var len = Math.Min(7, _activityData.Length - i);
            var week = new int[len];
            Array.Copy(_activityData, i, week, 0, len);
            weeks.Add(week);
        }
        return weeks.ToArray();
    }
}
