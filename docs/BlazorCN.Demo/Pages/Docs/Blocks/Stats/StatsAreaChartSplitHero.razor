@* ============================================================
   Block: stats-area-chart-split-hero
   Title: StatsAreaChartSplitHero
   Description: A split-hero area-chart stats card for React and Next.js with a left metric panel, NumberFlow animated hero value, delta arrow, and a right ChartContainer-wrapped Recharts AreaChart panel built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-area-chart-split-hero.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid grid-cols-1 sm:grid-cols-5">
            @* Left: hero metric panel *@
            <div class="flex flex-col justify-between border-b px-5 py-5 sm:col-span-2 sm:border-b-0 sm:border-r sm:px-6 sm:py-6">
                <div>
                    <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        Daily traffic
                    </p>
                    <p class="mt-2 text-sm font-medium">Unique visitors</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">Last 14 days</p>
                </div>

                <dl class="mt-6">
                    <dt class="sr-only">Unique visitors today</dt>
                    <dd class="min-w-[160px]">
                        <span class="text-4xl font-semibold tabular-nums">38,540</span>
                    </dd>
                    <div class="mt-2 flex items-center gap-1.5">
                        <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
                        <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                            +14.2% vs previous period
                        </span>
                    </div>
                </dl>
            </div>

            @* Right: chart panel *@
            <div class="px-4 py-4 sm:col-span-3 sm:px-5 sm:py-5">
                <div class="h-[200px] w-full">
                    <svg viewBox="0 0 480 200" class="h-full w-full" aria-hidden="true" preserveAspectRatio="none">
                        <defs>
                            <linearGradient id="fill-visitors-split" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="currentColor" stop-opacity="0.4" />
                                <stop offset="100%" stop-color="currentColor" stop-opacity="0" />
                            </linearGradient>
                        </defs>
                        @{
                            /* Chart data: visitors values mapped to SVG coordinates.
                               Data range: 18420 (min) to 38540 (max).
                               SVG: x from 0..480, y from top=8 to bottom=170 (reserving ~30px for x-axis labels). */
                            var pts = _chartData;
                            double minV = 18420;
                            double maxV = 38540;
                            double chartTop = 8.0;
                            double chartBottom = 170.0;
                            double chartHeight = chartBottom - chartTop;
                            double chartLeft = 12.0;
                            double chartRight = 476.0;
                            double chartWidth = chartRight - chartLeft;
                            int n = pts.Length;

                            /* Build SVG path points */
                            var xCoords = new double[n];
                            var yCoords = new double[n];
                            for (int i = 0; i < n; i++)
                            {
                                xCoords[i] = chartLeft + (i / (double)(n - 1)) * chartWidth;
                                yCoords[i] = chartTop + (1.0 - (pts[i].Visitors - minV) / (maxV - minV)) * chartHeight;
                            }

                            /* Polyline points string */
                            var linePoints = new System.Text.StringBuilder();
                            for (int i = 0; i < n; i++)
                            {
                                if (i > 0) linePoints.Append(' ');
                                linePoints.Append(xCoords[i].ToString("F1", System.Globalization.CultureInfo.InvariantCulture));
                                linePoints.Append(',');
                                linePoints.Append(yCoords[i].ToString("F1", System.Globalization.CultureInfo.InvariantCulture));
                            }

                            /* Area fill polygon: line points + close along bottom */
                            var areaPoints = new System.Text.StringBuilder();
                            areaPoints.Append(chartLeft.ToString("F1", System.Globalization.CultureInfo.InvariantCulture));
                            areaPoints.Append(',');
                            areaPoints.Append(chartBottom.ToString("F1", System.Globalization.CultureInfo.InvariantCulture));
                            areaPoints.Append(' ');
                            areaPoints.Append(linePoints.ToString());
                            areaPoints.Append(' ');
                            areaPoints.Append(chartRight.ToString("F1", System.Globalization.CultureInfo.InvariantCulture));
                            areaPoints.Append(',');
                            areaPoints.Append(chartBottom.ToString("F1", System.Globalization.CultureInfo.InvariantCulture));

                            /* X-axis tick labels — show 5 evenly spaced dates */
                            var tickIndices = new[] { 0, 3, 7, 11, 14 };
                        }

                        @* Cartesian grid: horizontal lines *@
                        @for (int row = 0; row <= 4; row++)
                        {
                            var gy = chartTop + (row / 4.0) * chartHeight;
                            <line x1="@chartLeft.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                  y1="@gy.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                  x2="@chartRight.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                  y2="@gy.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                                  stroke="currentColor" stroke-opacity="0.1" stroke-dasharray="3 3" />
                        }

                        @* Area fill *@
                        <polygon points="@areaPoints.ToString()"
                                 fill="url(#fill-visitors-split)"
                                 class="text-orange-500 dark:text-blue-500" />

                        @* Stroke line *@
                        <polyline points="@linePoints.ToString()"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="2"
                                  stroke-linejoin="round"
                                  stroke-linecap="round"
                                  class="text-orange-500 dark:text-blue-500" />

                        @* X-axis tick labels *@
                        @foreach (var ti in tickIndices)
                        {
                            var tx = xCoords[ti];
                            var label = FormatChartDate(pts[ti].Date);
                            var txs = tx.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                            @((MarkupString)$"<text x=\"{txs}\" y=\"188\" text-anchor=\"middle\" font-size=\"11\" fill=\"currentColor\" fill-opacity=\"0.5\" class=\"text-muted-foreground\">{label}</text>")
                        }
                    </svg>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record DataPoint(string Date, int Visitors);

    private static readonly DataPoint[] _chartData =
    [
        new("2026-03-14", 18420),
        new("2026-03-16", 19140),
        new("2026-03-18", 21380),
        new("2026-03-20", 22260),
        new("2026-03-22", 24870),
        new("2026-03-24", 25940),
        new("2026-03-26", 27310),
        new("2026-03-28", 28760),
        new("2026-03-30", 30480),
        new("2026-04-01", 31620),
        new("2026-04-03", 33190),
        new("2026-04-05", 34280),
        new("2026-04-07", 35940),
        new("2026-04-09", 37120),
        new("2026-04-11", 38540),
    ];

    private static string FormatChartDate(string isoDate)
    {
        if (DateTime.TryParse(isoDate, out var d))
            return d.ToString("MMM d", System.Globalization.CultureInfo.InvariantCulture);
        return isoDate;
    }
}
