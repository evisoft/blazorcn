@* ========================================
   Block: stats-score-card
   Title: Stats Score Card
   Description: Balanced scorecard stats with KPI ratings, weighted scores, and performance grades for React executive dashboards
   Long Description: Sales pipeline stats with deal stage values, win probability, and weighted forecast for React CRM dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-score-card.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Scorecard</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Q1 2025 performance</p>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <p class="text-2xl font-semibold tabular-nums">@overallScore</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">out of 100</p>
                </div>
                <div class="flex size-10 items-center justify-center rounded-md bg-muted/50">
                    <span class="text-sm font-semibold">@overallGrade</span>
                </div>
            </div>
        </div>

        @* Perspectives *@
        <div>
            @for (var i = 0; i < perspectives.Length; i++)
            {
                var p = perspectives[i];
                var isLast = i == perspectives.Length - 1;
                var colors = GetScoreColor(p.Score, p.Target);

                <div class="@(Cn.Merge("px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <div>
                            <span class="text-sm font-medium">@p.Name</span>
                            <span class="ml-2 text-xs text-muted-foreground">
                                @p.Weight% weight &middot; @p.Kpis KPIs
                            </span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs text-muted-foreground">target @p.Target</span>
                            <span class="@(Cn.Merge("text-sm font-semibold tabular-nums", colors.Text))">
                                @p.Score
                            </span>
                        </div>
                    </div>
                    <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full transition-all", colors.Bar))"
                             style="width: @(p.Score)%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Perspective(string Name, int Score, int Target, int Weight, int Kpis);
    private record ScoreColors(string Bar, string Text);

    private const int overallScore = 78;
    private const string overallGrade = "B+";

    private static readonly Perspective[] perspectives = new[]
    {
        new Perspective("Financial", 84, 85, 30, 5),
        new Perspective("Customer", 79, 80, 25, 4),
        new Perspective("Internal Process", 72, 75, 25, 6),
        new Perspective("Learning & Growth", 76, 70, 20, 4),
    };

    private static ScoreColors GetScoreColor(int score, int target)
    {
        if (score >= target)
            return new ScoreColors("bg-emerald-500", "text-emerald-600 dark:text-emerald-400");
        if (score >= target - 5)
            return new ScoreColors("bg-amber-500", "text-amber-600 dark:text-amber-400");
        return new ScoreColors("bg-red-500", "text-red-600 dark:text-red-400");
    }
}
