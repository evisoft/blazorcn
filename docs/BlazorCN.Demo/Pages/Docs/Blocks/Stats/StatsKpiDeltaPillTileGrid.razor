@* ============================================================
   Block: stats-kpi-delta-pill-tile-grid
   Title: StatsKpiDeltaPillTileGrid
   Description: A KPI tile grid stats block for React and Next.js with prominent rounded-full semantic delta pill badges beside each value, tabular-nums headline numbers, and a responsive 2-by-2 layout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-kpi-delta-pill-tile-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="mb-3 flex items-baseline justify-between px-1">
        <p class="text-sm font-medium">Growth overview</p>
        <p class="text-xs text-muted-foreground">Last 30 days</p>
    </div>

    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var metric in _metrics)
        {
            var isPositive = metric.ChangeType == "positive";
            <div class="rounded-lg border bg-card px-4 py-4">
                <dt class="text-xs font-medium text-muted-foreground">@metric.Label</dt>
                <dd class="mt-2 flex items-center justify-between gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@metric.Value</span>
                    <span class="@Cn.Merge("inline-flex shrink-0 items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium tabular-nums", isPositive ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-red-500/10 text-red-600 dark:text-red-400")">
                        <LucideIconCn Name="@(isPositive ? "trending-up" : "trending-down")" Size="12" Class="size-3" aria-hidden="true" />
                        @metric.Delta
                    </span>
                </dd>
                <p class="mt-1 text-[11px] text-muted-foreground">vs previous 30 days</p>
            </div>
        }
    </dl>
</section>

@code {
    private record KpiMetric(string Id, string Label, string Value, string Delta, string ChangeType);

    private static readonly KpiMetric[] _metrics =
    [
        new("mrr", "Monthly recurring revenue", "$187,420", "+12.4%", "positive"),
        new("paying-customers", "Paying customers", "4,218", "+6.8%", "positive"),
        new("net-churn", "Net revenue churn", "1.9%", "-0.4%", "positive"),
        new("trial-conversion", "Trial conversion", "23.6%", "-1.8%", "negative"),
    ];
}
