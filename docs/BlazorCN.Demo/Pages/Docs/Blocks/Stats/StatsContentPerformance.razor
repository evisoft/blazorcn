@* ========================================
   Block: stats-content-performance
   Title: Stats Content Performance
   Description: Blog and content metrics with views, read time, shares, and engagement per post for Next.js content marketing dashboards
   Long Description: Regulatory compliance scores by category including GDPR, SOC2, HIPAA with status indicators and audit findings for Next.js dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-content-performance.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Content Performance</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Last 30 days &#x2022; @_contentData.Length published posts
            </p>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Total Views</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">
                        @((_totalViews / 1000.0).ToString("F1"))
                    </span>
                    <span class="text-xs text-muted-foreground">K</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Avg Engagement</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">
                        @((int)_avgEngagement)
                    </span>
                    <span class="text-xs text-muted-foreground">%</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Shares</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">
                        @((_totalShares / 1000.0).ToString("F1"))
                    </span>
                    <span class="text-xs text-muted-foreground">K</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Conversions</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@_totalConversions</span>
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                </div>
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-3">
                <div class="text-xs font-medium text-muted-foreground">Top Performing Posts</div>
            </div>
            <div>
                @for (var i = 0; i < _contentData.Length; i++)
                {
                    var post = _contentData[i];
                    var conversionRate = (double)post.Conversions / post.Views * 100;
                    var isHighEngagement = post.Engagement >= 70;
                    var isHighConversion = conversionRate >= 1.5;

                    <div class="@(Cn.Merge("px-4 py-3", i < _contentData.Length - 1 ? "border-b" : ""))">
                        <div class="mb-2 flex items-start justify-between gap-3">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@post.Title</span>
                                    @if (isHighEngagement)
                                    {
                                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                    }
                                </div>
                                <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                    <span>@post.Category</span>
                                    <span>&#x2022;</span>
                                    <span>@post.PublishedDate</span>
                                </div>
                            </div>
                            <div class="shrink-0 text-right">
                                <div class="text-sm font-medium tabular-nums">
                                    @post.Views.ToString("N0")
                                </div>
                                <div class="text-xs text-muted-foreground">views</div>
                            </div>
                        </div>

                        <div class="grid grid-cols-4 gap-3 text-xs">
                            <div>
                                <div class="text-muted-foreground">Read Time</div>
                                <div class="mt-0.5 font-medium tabular-nums">
                                    @post.AvgReadTime.ToString("F1") min
                                </div>
                            </div>
                            <div>
                                <div class="text-muted-foreground">Engagement</div>
                                <div class="@(Cn.Merge("mt-0.5 font-medium tabular-nums", post.Engagement >= 70 ? "text-emerald-600" : post.Engagement >= 60 ? "text-amber-600" : ""))">
                                    @post.Engagement%
                                </div>
                            </div>
                            <div>
                                <div class="text-muted-foreground">Shares</div>
                                <div class="mt-0.5 font-medium tabular-nums">@post.Shares</div>
                            </div>
                            <div>
                                <div class="text-muted-foreground">Conversions</div>
                                <div class="@(Cn.Merge("mt-0.5 font-medium tabular-nums", isHighConversion ? "text-emerald-600" : ""))">
                                    @post.Conversions
                                </div>
                            </div>
                        </div>

                        <div class="mt-2">
                            <div class="mb-1 flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">Engagement Rate</span>
                                <span class="font-medium tabular-nums">@post.Engagement%</span>
                            </div>
                            <div class="h-1 overflow-hidden rounded-full bg-muted">
                                <div class="@(Cn.Merge("h-full", post.Engagement >= 70 ? "bg-emerald-500" : post.Engagement >= 60 ? "bg-amber-500" : "bg-muted-foreground"))"
                                     style="width: @(post.Engagement)%"></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ContentPost(string Title, string PublishedDate, int Views, double AvgReadTime, int Shares, int Engagement, int Conversions, string Category);

    private static readonly ContentPost[] _contentData =
    [
        new("How to Build a Scalable SaaS Architecture", "3 days ago", 12840, 8.4, 284, 72, 156, "Engineering"),
        new("10 React Performance Tips for Production Apps", "1 week ago", 9620, 6.2, 412, 68, 98, "Development"),
        new("The Complete Guide to Next.js App Router", "2 weeks ago", 18450, 12.8, 586, 81, 242, "Development"),
        new("Converting Trial Users to Paid Customers", "3 weeks ago", 7280, 5.6, 156, 64, 84, "Growth"),
        new("Database Indexing Strategies for Performance", "1 month ago", 5840, 9.2, 92, 58, 48, "Engineering"),
    ];

    private static readonly int _totalViews = _contentData.Sum(p => p.Views);
    private static readonly int _totalShares = _contentData.Sum(p => p.Shares);
    private static readonly int _totalConversions = _contentData.Sum(p => p.Conversions);
    private static readonly double _avgEngagement = _contentData.Average(p => p.Engagement);
}
