@* ========================================
   Block: stats-support-tickets
   Title: Stats Support Tickets
   Description: Support ticket stats with queue counts, SLA tracking, response times, and priority breakdown for React helpdesk dashboards
   Long Description: SaaS subscription stats with MRR, churn rate, LTV, and subscriber growth for React billing dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-support-tickets.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Support Queue</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @totalOpen open &middot; @resolvedToday resolved today
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                    @slaCompliance SLA
                </span>
            </div>
        </div>

        @* Summary *@
        <div class="grid grid-cols-2 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-2xl font-semibold tabular-nums">@firstResponse</p>
                <p class="text-xs text-muted-foreground">Avg First Response</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-2xl font-semibold tabular-nums">@totalOpen</p>
                <p class="text-xs text-muted-foreground">Open Tickets</p>
            </div>
        </div>

        @* Priority breakdown *@
        <div>
            @for (var i = 0; i < queues.Length; i++)
            {
                var queue = queues[i];
                var isLast = i == queues.Length - 1;

                <div class="@(Cn.Merge("px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", queue.Color))"></span>
                            <span class="text-sm font-medium">@queue.Priority</span>
                            <span class="text-xs text-muted-foreground">@queue.Open open</span>
                        </div>
                        <div class="flex items-center gap-3 text-xs text-muted-foreground">
                            <span>@queue.AvgResponse avg</span>
                            <span class="@(Cn.Merge("font-medium tabular-nums", queue.Sla >= 95 ? "text-emerald-600 dark:text-emerald-400" : queue.Sla >= 90 ? "text-amber-600 dark:text-amber-400" : "text-red-600 dark:text-red-400"))">
                                @queue.Sla%
                            </span>
                        </div>
                    </div>
                    <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full transition-all", queue.Sla >= 95 ? "bg-emerald-500" : queue.Sla >= 90 ? "bg-amber-500" : "bg-red-500"))"
                             style="width: @(queue.Sla)%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PriorityQueue(string Priority, int Open, string AvgResponse, int Sla, string Color);

    private const int totalOpen = 47;
    private const int resolvedToday = 23;
    private const string firstResponse = "18m";
    private const string slaCompliance = "94.6%";

    private static readonly PriorityQueue[] queues = new[]
    {
        new PriorityQueue("Urgent", 3, "4m", 100, "bg-red-500"),
        new PriorityQueue("High", 12, "12m", 96, "bg-amber-500"),
        new PriorityQueue("Normal", 24, "22m", 94, "bg-blue-500"),
        new PriorityQueue("Low", 8, "1h 15m", 88, "bg-muted-foreground/50"),
    };
}
