@* ========================================
   Block: stats-kubernetes-pods
   Title: Stats Kubernetes Pods
   Description: Kubernetes pod monitoring showing status, restarts, and resource utilization
   Dependencies: None
   Source: original/blocks/stats/stats-kubernetes-pods.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Kubernetes Pods</h2>
            <p class="mt-1 text-xs text-muted-foreground">Pod status and resource utilization</p>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Total Pods</div>
                <div class="mt-1 text-2xl font-semibold tabular-nums">@_pods.Length</div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Running</div>
                <div class="mt-1 text-2xl font-semibold tabular-nums text-emerald-500">
                    @_runningPods
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Failed</div>
                <div class="mt-1 text-2xl font-semibold tabular-nums text-red-500">
                    @_failedPods
                </div>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var pod in _pods)
            {
                var statusColor = pod.Status == "Running" ? "bg-emerald-500" : pod.Status == "Pending" ? "bg-blue-500" : "bg-red-500";
                var hasRestarts = pod.Restarts > 0;
                var isFailed = pod.Status == "Failed" || pod.Status == "CrashLoopBackOff";
                var cpuPercent = pod.CpuRequest > 0 ? (double)pod.CpuUsage / pod.CpuRequest * 100 : 0;
                var memPercent = pod.MemoryRequest > 0 ? (double)pod.MemoryUsage / pod.MemoryRequest * 100 : 0;

                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@(Cn.Merge("size-2 rounded-full", statusColor))"></span>
                                <code class="truncate font-mono text-xs">@pod.Name</code>
                                @if (hasRestarts || isFailed)
                                {
                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                <span>@pod.Namespace</span>
                                <span>&#x2022;</span>
                                <span>@pod.Status</span>
                                <span>&#x2022;</span>
                                <span>@pod.Age</span>
                            </div>

                            <div class="mt-3 grid grid-cols-2 gap-4">
                                <div>
                                    <div class="text-xs text-muted-foreground">CPU Usage</div>
                                    <div class="mt-1 text-sm font-semibold tabular-nums">
                                        @(pod.CpuUsage)m / @(pod.CpuRequest)m
                                    </div>
                                    @if (pod.CpuRequest > 0)
                                    {
                                        <div class="mt-1 h-1 overflow-hidden rounded-full bg-muted">
                                            <div class="@(Cn.Merge("h-full rounded-full transition-all", cpuPercent > 80 ? "bg-red-500" : cpuPercent > 60 ? "bg-amber-500" : "bg-emerald-500"))"
                                                 style="width: @(Math.Min(cpuPercent, 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                        </div>
                                    }
                                </div>

                                <div>
                                    <div class="text-xs text-muted-foreground">Memory Usage</div>
                                    <div class="mt-1 text-sm font-semibold tabular-nums">
                                        @(pod.MemoryUsage)Mi / @(pod.MemoryRequest)Mi
                                    </div>
                                    @if (pod.MemoryRequest > 0)
                                    {
                                        <div class="mt-1 h-1 overflow-hidden rounded-full bg-muted">
                                            <div class="@(Cn.Merge("h-full rounded-full transition-all", memPercent > 80 ? "bg-red-500" : memPercent > 60 ? "bg-amber-500" : "bg-emerald-500"))"
                                                 style="width: @(Math.Min(memPercent, 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (hasRestarts)
                            {
                                <div class="mt-2 text-xs">
                                    <span class="text-muted-foreground">Restarts:</span>
                                    <span class="@(Cn.Merge("ml-1 font-medium tabular-nums", pod.Restarts > 5 ? "text-red-500" : ""))">
                                        @pod.Restarts
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PodMetric(string Name, string Namespace, string Status, int Restarts, int CpuRequest, int MemoryRequest, int CpuUsage, int MemoryUsage, string Age);

    private static readonly PodMetric[] _pods =
    [
        new("api-gateway-7d9f8b6c4-xj2k9", "production", "Running", 0, 500, 1024, 342, 756, "12d"),
        new("worker-queue-5c8d7f6e9-p4m2x", "production", "Running", 2, 1000, 2048, 890, 1823, "8d"),
        new("database-replica-9f7e6d5c-q8n3k", "production", "Running", 0, 2000, 4096, 1456, 3247, "45d"),
        new("cache-redis-6e5d4c3b-m7l2j", "production", "CrashLoopBackOff", 12, 250, 512, 0, 0, "2h"),
        new("analytics-processor-8f9e7d6c-r5q4p", "staging", "Pending", 0, 750, 1536, 0, 0, "3m"),
    ];

    private static readonly int _runningPods = _pods.Count(p => p.Status == "Running");
    private static readonly int _failedPods = _pods.Count(p => p.Status == "Failed" || p.Status == "CrashLoopBackOff");
}
