@* ============================================================
   Block: stats-cohort-retention-card
   Title: StatsCohortRetentionCard
   Description: A cohort retention table stats card for React and Next.js with a triangular heat-colored grid showing retention percentages by cohort month and period, intensity-mapped cell backgrounds, row and column headers, and tabular-nums values built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-cohort-retention-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Cohort retention</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Monthly cohorts · 2026</p>
            </div>
            <div class="text-right">
                <p class="text-xs text-muted-foreground">Avg M1 retention</p>
                <p class="text-sm font-semibold tabular-nums">@_avgRetentionM1%</p>
            </div>
        </div>
        <div class="overflow-x-auto px-4 py-4">
            <table class="w-full text-xs">
                <thead>
                    <tr>
                        <th class="pb-2 pr-3 text-left font-medium text-muted-foreground">Cohort</th>
                        @foreach (var p in _periods)
                        {
                            <th class="pb-2 text-center font-medium text-muted-foreground tabular-nums">@p</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cohort in _cohorts)
                    {
                        <tr>
                            <td class="py-1 pr-3 font-medium">@cohort.Label</td>
                            @for (var i = 0; i < cohort.Retention.Length; i++)
                            {
                                var val = cohort.Retention[i];
                                var period = _periods[i];
                                var ariaLabel = $"{cohort.Label} {period}: {val}%";
                                <td class="p-0.5 text-center">
                                    @if (val.HasValue)
                                    {
                                        var opacity = GetOpacity(val.Value);
                                        var bgStyle = FormattableString.Invariant($"background-color: color-mix(in oklch, var(--chart-1) {opacity * 100}%, transparent)");
                                        <div class="rounded-sm px-2 py-1.5 font-medium tabular-nums text-foreground"
                                             style="@bgStyle"
                                             aria-label="@ariaLabel" role="img">
                                            @val.Value%
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="rounded-sm px-2 py-1.5 text-muted-foreground/30">—</div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="flex items-center gap-2 border-t px-4 py-2.5 text-[10px] text-muted-foreground">
            <span>Low retention</span>
            <div class="flex gap-0.5">
                @foreach (var op in _legendOpacities)
                {
                    var legendStyle = FormattableString.Invariant($"background-color: color-mix(in oklch, var(--chart-1) {op * 100}%, transparent)");
                    <div class="size-3 rounded-sm" style="@legendStyle"></div>
                }
            </div>
            <span>High retention</span>
        </div>
    </div>
</section>

@code {
    private record Cohort(string Id, string Label, int?[] Retention);

    private static readonly string[] _periods = ["M0", "M1", "M2", "M3", "M4", "M5"];

    private static readonly Cohort[] _cohorts =
    [
        new("jan", "Jan", [100, 68, 52, 41, 35, 30]),
        new("feb", "Feb", [100, 72, 58, 46, 38, null]),
        new("mar", "Mar", [100, 75, 62, 51, null, null]),
        new("apr", "Apr", [100, 70, 55, null, null, null]),
        new("may", "May", [100, 78, null, null, null, null]),
        new("jun", "Jun", [100, null, null, null, null, null]),
    ];

    private static readonly double[] _legendOpacities = [0.15, 0.3, 0.5, 0.7, 0.85];

    private static double GetOpacity(int value) => 0.15 + (value / 100.0) * 0.7;

    private int _avgRetentionM1 = (int)Math.Round(
        (double)_cohorts
            .Where(c => c.Retention[1].HasValue)
            .Sum(c => c.Retention[1] ?? 0) /
        _cohorts.Count(c => c.Retention[1].HasValue)
    );
}
