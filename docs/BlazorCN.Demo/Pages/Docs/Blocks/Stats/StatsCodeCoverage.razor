@* ========================================
   Block: stats-code-coverage
   Title: Stats Code Coverage
   Description: Test coverage metrics by module showing lines, branches, and functions covered with pass/fail counts for Next.js testing dashboards
   Long Description: Student attendance tracking with present, absent, and late counts, weekly patterns, and class performance metrics for Next.js education apps
   Dependencies: None
   Source: original/blocks/stats/stats-code-coverage.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Code Coverage Report</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @coverageData.Length modules • @(totalTestsPassed + totalTestsFailed) total tests
            </p>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Lines</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="@(Cn.Merge("text-2xl font-semibold tabular-nums", overallLineCoverage >= 80 ? "text-emerald-600" : overallLineCoverage >= 60 ? "text-amber-600" : "text-red-600"))">
                        @(overallLineCoverage.ToString("F1"))
                    </span>
                    <span class="text-xs text-muted-foreground">%</span>
                </div>
                <div class="mt-1 text-xs text-muted-foreground">
                    @totalLinesCovered/@totalLines
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Branches</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="@(Cn.Merge("text-2xl font-semibold tabular-nums", overallBranchCoverage >= 80 ? "text-emerald-600" : overallBranchCoverage >= 60 ? "text-amber-600" : "text-red-600"))">
                        @(overallBranchCoverage.ToString("F1"))
                    </span>
                    <span class="text-xs text-muted-foreground">%</span>
                </div>
                <div class="mt-1 text-xs text-muted-foreground">
                    @totalBranchesCovered/@totalBranches
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Functions</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="@(Cn.Merge("text-2xl font-semibold tabular-nums", overallFunctionCoverage >= 80 ? "text-emerald-600" : overallFunctionCoverage >= 60 ? "text-amber-600" : "text-red-600"))">
                        @(overallFunctionCoverage.ToString("F1"))
                    </span>
                    <span class="text-xs text-muted-foreground">%</span>
                </div>
                <div class="mt-1 text-xs text-muted-foreground">
                    @totalFunctionsCovered/@totalFunctions
                </div>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="size-2 rounded-full bg-emerald-500"></span>
                    <span class="text-xs text-muted-foreground">Tests Passed</span>
                </div>
                <div class="mt-1 text-2xl font-semibold tabular-nums">@totalTestsPassed</div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="size-2 rounded-full bg-red-500"></span>
                    <span class="text-xs text-muted-foreground">Tests Failed</span>
                </div>
                <div class="mt-1 text-2xl font-semibold tabular-nums text-red-600">
                    @totalTestsFailed
                </div>
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-3">
                <div class="text-xs font-medium text-muted-foreground">Coverage by Module</div>
            </div>
            <div>
                @for (var i = 0; i < coverageData.Length; i++)
                {
                    var m = coverageData[i];
                    var lineCov = CalculatePercentage(m.LinesCovered, m.LinesTotal);
                    var branchCov = CalculatePercentage(m.BranchesCovered, m.BranchesTotal);
                    var funcCov = CalculatePercentage(m.FunctionsCovered, m.FunctionsTotal);
                    var hasFailed = m.TestsFailed > 0;
                    var lowCoverage = lineCov < 80;

                    <div class="@(Cn.Merge("px-4 py-3", i < coverageData.Length - 1 ? "border-b" : ""))">
                        <div class="mb-2 flex items-start justify-between">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@m.Module</span>
                                    @if (hasFailed)
                                    {
                                        <span class="size-1.5 rounded-full bg-red-500"></span>
                                    }
                                    @if (lowCoverage && !hasFailed)
                                    {
                                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                                    }
                                </div>
                                <div class="mt-0.5 font-mono text-xs text-muted-foreground">
                                    @m.Path
                                </div>
                            </div>
                            <div class="ml-4 text-right">
                                <div class="@(Cn.Merge("text-sm font-medium tabular-nums", lineCov >= 80 ? "text-emerald-600" : lineCov >= 60 ? "text-amber-600" : "text-red-600"))">
                                    @(lineCov.ToString("F1"))%
                                </div>
                                <div class="text-xs text-muted-foreground">
                                    @m.TestsPassed@(hasFailed ? $"/{m.TestsPassed + m.TestsFailed}" : "") tests
                                </div>
                            </div>
                        </div>

                        <div class="space-y-1.5">
                            <div>
                                <div class="mb-1 flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Lines</span>
                                    <span class="font-medium tabular-nums">
                                        @m.LinesCovered/@m.LinesTotal (@(lineCov.ToString("F1"))%)
                                    </span>
                                </div>
                                <div class="h-1 overflow-hidden rounded-full bg-muted">
                                    <div class="@(Cn.Merge("h-full", lineCov >= 80 ? "bg-emerald-500" : lineCov >= 60 ? "bg-amber-500" : "bg-red-500"))" style="width: @(lineCov.ToString("F1"))%"></div>
                                </div>
                            </div>

                            <div>
                                <div class="mb-1 flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Branches</span>
                                    <span class="font-medium tabular-nums">
                                        @m.BranchesCovered/@m.BranchesTotal (@(branchCov.ToString("F1"))%)
                                    </span>
                                </div>
                                <div class="h-1 overflow-hidden rounded-full bg-muted">
                                    <div class="@(Cn.Merge("h-full", branchCov >= 80 ? "bg-emerald-500" : branchCov >= 60 ? "bg-amber-500" : "bg-red-500"))" style="width: @(branchCov.ToString("F1"))%"></div>
                                </div>
                            </div>

                            <div>
                                <div class="mb-1 flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Functions</span>
                                    <span class="font-medium tabular-nums">
                                        @m.FunctionsCovered/@m.FunctionsTotal (@(funcCov.ToString("F1"))%)
                                    </span>
                                </div>
                                <div class="h-1 overflow-hidden rounded-full bg-muted">
                                    <div class="@(Cn.Merge("h-full", funcCov >= 80 ? "bg-emerald-500" : funcCov >= 60 ? "bg-amber-500" : "bg-red-500"))" style="width: @(funcCov.ToString("F1"))%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ModuleCoverage(string Module, string Path, int LinesCovered, int LinesTotal, int BranchesCovered, int BranchesTotal, int FunctionsCovered, int FunctionsTotal, int TestsPassed, int TestsFailed);

    private static double CalculatePercentage(int covered, int total) => total > 0 ? (double)covered / total * 100 : 0;

    private static readonly ModuleCoverage[] coverageData = new[]
    {
        new ModuleCoverage("auth", "src/lib/auth", 342, 358, 87, 96, 48, 52, 56, 0),
        new ModuleCoverage("api", "src/app/api", 524, 580, 142, 168, 78, 86, 94, 2),
        new ModuleCoverage("database", "src/lib/database", 218, 242, 54, 62, 32, 36, 42, 0),
        new ModuleCoverage("ui-components", "src/components/ui", 412, 520, 98, 142, 64, 82, 68, 1),
        new ModuleCoverage("utils", "src/lib/utils", 186, 194, 42, 46, 28, 30, 38, 0),
    };

    private static readonly int totalLines = coverageData.Sum(m => m.LinesTotal);
    private static readonly int totalLinesCovered = coverageData.Sum(m => m.LinesCovered);
    private static readonly int totalBranches = coverageData.Sum(m => m.BranchesTotal);
    private static readonly int totalBranchesCovered = coverageData.Sum(m => m.BranchesCovered);
    private static readonly int totalFunctions = coverageData.Sum(m => m.FunctionsTotal);
    private static readonly int totalFunctionsCovered = coverageData.Sum(m => m.FunctionsCovered);
    private static readonly int totalTestsPassed = coverageData.Sum(m => m.TestsPassed);
    private static readonly int totalTestsFailed = coverageData.Sum(m => m.TestsFailed);

    private static readonly double overallLineCoverage = CalculatePercentage(totalLinesCovered, totalLines);
    private static readonly double overallBranchCoverage = CalculatePercentage(totalBranchesCovered, totalBranches);
    private static readonly double overallFunctionCoverage = CalculatePercentage(totalFunctionsCovered, totalFunctions);
}
