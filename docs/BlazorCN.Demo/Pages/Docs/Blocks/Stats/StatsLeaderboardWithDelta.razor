@* ============================================================
   Block: stats-leaderboard-with-delta
   Title: StatsLeaderboardWithDelta
   Description: A ranked leaderboard stats card for React and Next.js with monospace rank numbers, per-row rank-change indicators in semantic colors, tabular-nums scores, and a header showing the leader and total entries built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-leaderboard-with-delta.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Top sellers</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Week 15 · rank vs week 14</p>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="trophy" Size="12" Class="size-3 text-amber-600 dark:text-amber-400" aria-hidden="true" />
                <span class="text-xs font-medium">@_leaderName</span>
            </div>
        </div>

        <ol class="divide-y">
            @foreach (var row in _rows)
            {
                var delta = row.PreviousRank - row.CurrentRank;
                var direction = delta > 0 ? "up" : delta < 0 ? "down" : "none";
                var deltaClass = direction == "up"
                    ? "inline-flex w-14 shrink-0 items-center justify-end gap-1 rounded-full px-2 py-0.5 text-xs font-medium tabular-nums bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                    : direction == "down"
                        ? "inline-flex w-14 shrink-0 items-center justify-end gap-1 rounded-full px-2 py-0.5 text-xs font-medium tabular-nums bg-red-500/10 text-red-600 dark:text-red-400"
                        : "inline-flex w-14 shrink-0 items-center justify-end gap-1 rounded-full px-2 py-0.5 text-xs font-medium tabular-nums bg-muted text-muted-foreground";
                <li class="flex items-center gap-3 px-4 py-2.5">
                    <span class="w-6 shrink-0 text-right font-mono text-xs text-muted-foreground tabular-nums">
                        @row.CurrentRank.ToString("D2")
                    </span>
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-medium">@row.Name</p>
                        <p class="mt-0.5 truncate text-xs text-muted-foreground">@row.Region</p>
                    </div>
                    <span class="shrink-0 text-sm font-semibold tabular-nums">
                        @FormatCurrency(row.Value)
                    </span>
                    <span class="@deltaClass">
                        @if (direction == "up")
                        {
                            <LucideIconCn Name="arrow-up" Size="12" Class="size-3" aria-hidden="true" />
                            @delta
                        }
                        @if (direction == "down")
                        {
                            <LucideIconCn Name="arrow-down" Size="12" Class="size-3" aria-hidden="true" />
                            @Math.Abs(delta)
                        }
                        @if (direction == "none")
                        {
                            <LucideIconCn Name="minus" Size="12" Class="size-3" aria-hidden="true" />
                            <span class="sr-only">unchanged</span>
                        }
                    </span>
                </li>
            }
        </ol>

        <div class="flex items-center justify-between border-t px-4 py-2.5 text-xs text-muted-foreground">
            <span>@_totalEntries ranked sellers</span>
            <span class="tabular-nums">Total · @FormatCurrency(_rows.Sum(r => r.Value))</span>
        </div>
    </div>
</section>

@code {
    private record LeaderRow(string Id, string Name, string Region, int Value, int PreviousRank, int CurrentRank);

    private static readonly LeaderRow[] _rows =
    [
        new("amelia-chen",   "Amelia Chen",   "APAC",     84320, 3, 1),
        new("marcus-reyes",  "Marcus Reyes",  "Americas", 78540, 1, 2),
        new("priya-shah",    "Priya Shah",    "EMEA",     72110, 2, 3),
        new("leon-okonkwo",  "Leon Okonkwo",  "EMEA",     64890, 4, 4),
        new("sara-ito",      "Sara Ito",      "APAC",     58420, 8, 5),
        new("diego-paredes", "Diego Paredes", "Americas", 51760, 5, 6),
        new("noa-levi",      "Noa Levi",      "EMEA",     48200, 6, 7),
        new("james-park",    "James Park",    "Americas", 44310, 7, 8),
    ];

    private static int _totalEntries => _rows.Length;
    private static string _leaderName => _rows[0].Name;

    private static string FormatCurrency(int value) => $"${value:N0}";
}
