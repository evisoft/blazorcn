@* ============================================================
   Block: stats-comparison-with-delta-callout
   Title: StatsComparisonWithDeltaCallout
   Description: A period comparison stats block for React and Next.js with a centerpiece text-4xl NumberFlow delta, muted from-to labels, side-by-side baseline values, and semantic trend arrow built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-comparison-with-delta-callout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Monthly recurring revenue</p>
                <p class="mt-0.5 text-xs text-muted-foreground">March 2026 vs. February 2026</p>
            </div>
            <span class="@($"inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium tabular-nums {_trendBgClass} {_trendClass}")">
                <LucideIconCn Name="@(_isPositive ? "trending-up" : "trending-down")" Size="12" Class="size-3" />
                @(_isPositive ? "+" : "")@((PercentChange * 100).ToString("F1"))%
            </span>
        </div>

        <div class="flex flex-col items-center px-4 py-8">
            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Net change
            </span>
            <div class="@($"mt-2 flex items-center gap-2 {_trendClass}")">
                <LucideIconCn Name="@(_isPositive ? "trending-up" : "trending-down")" Size="24" Class="size-6" />
                <div class="min-w-[200px] text-center">
                    <span class="text-4xl font-semibold tabular-nums">
                        @(_isPositive ? "+" : "-")@FormatCurrency(Math.Abs(DeltaValue))
                    </span>
                </div>
            </div>
            <p class="mt-2 text-xs text-muted-foreground tabular-nums">
                From @FormatCurrency(PreviousValue) to @FormatCurrency(CurrentValue)
            </p>
        </div>

        <div class="grid grid-cols-2 divide-x border-t">
            <div class="px-4 py-3">
                <p class="text-xs text-muted-foreground">Previous period</p>
                <p class="mt-1 text-xl font-semibold tabular-nums">@FormatCurrency(PreviousValue)</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-xs text-muted-foreground">Current period</p>
                <p class="mt-1 text-xl font-semibold tabular-nums">@FormatCurrency(CurrentValue)</p>
            </div>
        </div>
    </div>
</section>

@code {
    private const int PreviousValue = 166_800;
    private const int CurrentValue = 187_420;
    private const int DeltaValue = CurrentValue - PreviousValue;
    private const double PercentChange = (double)DeltaValue / PreviousValue;

    private bool _isPositive => DeltaValue >= 0;
    private string _trendClass => _isPositive
        ? "text-emerald-600 dark:text-emerald-400"
        : "text-red-600 dark:text-red-400";
    private string _trendBgClass => _isPositive ? "bg-emerald-500/10" : "bg-red-500/10";

    private static string FormatCurrency(int value)
        => "$" + value.ToString("N0");
}
