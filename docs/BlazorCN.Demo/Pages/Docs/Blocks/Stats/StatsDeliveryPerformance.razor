@* ========================================
   Block: stats-delivery-performance
   Title: Stats Delivery Performance
   Description: Delivery tracking stats with on-time rate, average transit time, carrier breakdown, and SLA compliance
   Dependencies: None
   Source: original/blocks/stats/stats-delivery-performance.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Delivery Performance</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_totalShipments shipments this month
                </p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-semibold tabular-nums">@_overallOnTime%</p>
                <p class="mt-0.5 text-xs text-muted-foreground">on-time rate</p>
            </div>
        </div>

        @* Summary *@
        <div class="grid grid-cols-2 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">@_avgTransit</p>
                <p class="text-xs text-muted-foreground">Avg Transit</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">@_slaCompliance</p>
                <p class="text-xs text-muted-foreground">SLA Compliance</p>
            </div>
        </div>

        @* Carriers *@
        <div>
            @for (var i = 0; i < _carriers.Length; i++)
            {
                var carrier = _carriers[i];
                var isLast = i == _carriers.Length - 1;

                <div class="@(Cn.Merge("px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@carrier.Name</span>
                            <span class="text-xs text-muted-foreground">
                                @carrier.Shipments.ToString("N0") shipments
                            </span>
                        </div>
                        <div class="flex items-center gap-3 text-xs">
                            <span class="text-muted-foreground">@(carrier.AvgDays)d avg</span>
                            <span class="@(Cn.Merge("font-medium tabular-nums", carrier.OnTimeRate >= 95 ? "text-emerald-600 dark:text-emerald-400" : carrier.OnTimeRate >= 92 ? "text-amber-600 dark:text-amber-400" : "text-red-600 dark:text-red-400"))">
                                @carrier.OnTimeRate%
                            </span>
                        </div>
                    </div>
                    <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full transition-all", carrier.OnTimeRate >= 95 ? "bg-emerald-500" : carrier.OnTimeRate >= 92 ? "bg-amber-500" : "bg-red-500"))"
                             style="width: @(carrier.OnTimeRate.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Carrier(string Name, int Shipments, double OnTimeRate, string AvgDays);

    private const string _totalShipments = "4,218";
    private const double _overallOnTime = 94.2;
    private const string _avgTransit = "2.8 days";
    private const string _slaCompliance = "97.1%";

    private static readonly Carrier[] _carriers =
    [
        new("FedEx", 1842, 96.4, "2.1"),
        new("UPS", 1256, 94.8, "2.6"),
        new("USPS", 724, 91.2, "3.4"),
        new("DHL", 396, 93.1, "3.8"),
    ];
}