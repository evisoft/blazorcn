@* ============================================================
   Block: stats-bar-chart-weekly-breakdown
   Title: StatsBarChartWeeklyBreakdown
   Description: A 7-day vertical bar chart stats card for React and Next.js with Mon-Sun day-of-week labels, today's bar highlighted via Recharts Cell fills, a ChartContainer-wrapped BarChart and tabular-nums weekly total built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-bar-chart-weekly-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Orders by day</p>
                <p class="mt-0.5 text-xs text-muted-foreground">This week · Thu highlighted</p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-semibold tabular-nums">@_weeklyTotal.ToString("N0")</p>
                <div class="mt-0.5 flex items-center justify-end gap-1">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                    <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                        +@_deltaPct% vs last week
                    </span>
                </div>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="h-[180px] w-full">
                <svg viewBox="0 0 460 180" class="h-full w-full" aria-label="Orders by day of week bar chart">
                    @{
                        var chartWidth = 460;
                        var chartHeight = 180;
                        var marginLeft = 0;
                        var marginRight = 8;
                        var marginTop = 8;
                        var marginBottom = 28;
                        var plotWidth = chartWidth - marginLeft - marginRight;
                        var plotHeight = chartHeight - marginTop - marginBottom;
                        var barCount = _chartData.Length;
                        var slotWidth = plotWidth / barCount;
                        var barWidth = (int)(slotWidth * 0.55);
                        var maxVal = _chartData.Max(d => d.Value);

                        @* Horizontal grid lines *@
                        var gridLines = 4;
                        for (var gi = 0; gi <= gridLines; gi++)
                        {
                            var gy = marginTop + (int)(plotHeight * gi / gridLines);
                            @((MarkupString)$"<line x1=\"{marginLeft}\" y1=\"{gy}\" x2=\"{chartWidth - marginRight}\" y2=\"{gy}\" stroke=\"currentColor\" stroke-opacity=\"0.08\" stroke-dasharray=\"3 3\" />")
                        }

                        @* Bars and labels *@
                        for (var idx = 0; idx < barCount; idx++)
                        {
                            var d = _chartData[idx];
                            var barH = (int)(plotHeight * d.Value / maxVal);
                            var bx = marginLeft + (int)(slotWidth * idx) + (slotWidth - barWidth) / 2;
                            var by = marginTop + plotHeight - barH;
                            var isToday = (idx == _todayIndex);
                            var fillOpacity = isToday ? "1" : "0.22";
                            var labelY = marginTop + plotHeight + 18;
                            var labelX = marginLeft + (int)(slotWidth * idx) + slotWidth / 2;

                            @((MarkupString)FormattableString.Invariant($"<rect x=\"{bx}\" y=\"{by}\" width=\"{barWidth}\" height=\"{barH}\" rx=\"4\" ry=\"4\" fill=\"var(--color-primary)\" fill-opacity=\"{fillOpacity}\" />"))
                            @((MarkupString)$"<text x=\"{labelX}\" y=\"{labelY}\" text-anchor=\"middle\" font-size=\"11\" fill=\"currentColor\" fill-opacity=\"0.6\" font-family=\"inherit\">{d.Day}</text>")
                        }
                    }
                </svg>
            </div>
        </div>

        <div class="grid grid-cols-3 border-t">
            <div class="border-r px-4 py-3">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Best day
                </p>
                <p class="mt-1 text-sm font-semibold tabular-nums">Thu · 643</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Daily avg
                </p>
                <p class="mt-1 text-sm font-semibold tabular-nums">
                    @((int)Math.Round(_weeklyTotal / 7.0))
                </p>
            </div>
            <div class="px-4 py-3">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    vs last wk
                </p>
                <p class="mt-1 text-sm font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                    +@_delta.ToString("N0")
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record WeekDay(string Day, string FullDay, int Value);

    private static readonly WeekDay[] _chartData =
    [
        new("Mon", "Monday", 412),
        new("Tue", "Tuesday", 528),
        new("Wed", "Wednesday", 487),
        new("Thu", "Thursday", 643),
        new("Fri", "Friday", 571),
        new("Sat", "Saturday", 298),
        new("Sun", "Sunday", 214),
    ];

    private const int _todayIndex = 3; // Thursday

    private static readonly int _weeklyTotal = _chartData.Sum(d => d.Value);
    private const int _previousWeekTotal = 2890;
    private static readonly int _delta = _weeklyTotal - _previousWeekTotal;
    private static readonly string _deltaPct = ((_delta / (double)_previousWeekTotal) * 100).ToString("F1");
}
