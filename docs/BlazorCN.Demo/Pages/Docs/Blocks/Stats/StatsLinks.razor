@* ========================================
   Block: stats-links
   Title: Stats Links
   Description: Stats cards with footer links, change indicators, and action navigation
   Dependencies: None
   Source: original/blocks/stats/stats-links.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var item in _data)
        {
            <div class="overflow-hidden rounded-lg border bg-card">
                <div class="px-4 py-3">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium text-muted-foreground">@item.Name</span>
                        <span class="@($"text-xs font-medium tabular-nums {(item.IsPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")}")">
                            @item.Change
                        </span>
                    </div>
                    <p class="mt-1 text-2xl font-semibold tabular-nums">@item.Value</p>
                </div>
                <div class="border-t px-4 py-2.5">
                    <a class="text-sm font-medium text-primary hover:underline" href="#">
                        View more &#x2192;
                    </a>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record StatItem(string Name, string Value, string Change, bool IsPositive);

    private static readonly StatItem[] _data =
    [
        new("Monthly recurring revenue", "$34.1K", "+6.1%", true),
        new("Users", "500.1K", "+19.2%", true),
        new("User growth", "11.3%", "-1.2%", false),
    ];
}
