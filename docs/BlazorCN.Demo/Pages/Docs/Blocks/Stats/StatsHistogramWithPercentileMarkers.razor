@* ============================================================
   Block: stats-histogram-with-percentile-markers
   Title: StatsHistogramWithPercentileMarkers
   Description: A latency histogram stats card for React and Next.js with p50/p95/p99 ReferenceLine markers, bucketed BarChart bars, and ChartContainer-wrapped chart body built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-histogram-with-percentile-markers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Request latency distribution</p>
                <p class="mt-0.5 text-xs text-muted-foreground">/api/checkout · Last hour</p>
            </div>
            <div class="text-right">
                <p class="text-sm font-semibold tabular-nums">@_total.ToString("N0")</p>
                <p class="mt-0.5 text-xs text-muted-foreground">samples</p>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="h-[180px] w-full">
                <svg viewBox="0 0 @(_svgWidth) 180" preserveAspectRatio="none" class="w-full h-full" aria-label="Latency histogram" role="img">
                    @* CartesianGrid horizontal lines *@
                    @for (var gi = 1; gi <= 4; gi++)
                    {
                        var gy = gi * 180 / 5;
                        <line x1="0" y1="@gy" x2="@_svgWidth" y2="@gy" stroke="currentColor" stroke-opacity="0.15" stroke-dasharray="3 3" />
                    }

                    @* Bars *@
                    @foreach (var bucket in _buckets)
                    {
                        var idx = Array.IndexOf(_buckets, bucket);
                        var barH = (int)(bucket.Count * 150.0 / _maxCount);
                        var barX = idx * 24 + 1;
                        var barY = 155 - barH;
                        <rect x="@barX" y="@barY" width="22" height="@barH" rx="2" ry="2" fill="var(--muted-foreground)" fill-opacity="0.35" />
                    }

                    @* ReferenceLine markers for percentiles *@
                    @foreach (var pct in _percentiles)
                    {
                        var bucketVal = int.Parse(pct.Value);
                        var xPos = bucketVal / 500.0 * _svgWidth;
                        @((MarkupString)$"<line x1=\"{xPos:F1}\" y1=\"5\" x2=\"{xPos:F1}\" y2=\"155\" stroke=\"{pct.Color}\" stroke-dasharray=\"4 3\" stroke-width=\"1.5\" />")
                        @((MarkupString)$"<text x=\"{xPos:F1}\" y=\"3\" font-size=\"10\" fill=\"var(--muted-foreground)\" text-anchor=\"middle\" dominant-baseline=\"text-top\">{pct.Label}</text>")
                    }

                    @* XAxis tick labels — every other bucket *@
                    @foreach (var bucket in _buckets)
                    {
                        var idx = Array.IndexOf(_buckets, bucket);
                        if (idx % 2 == 0)
                        {
                            var tickX = idx * 24 + 12;
                            @((MarkupString)$"<text x=\"{tickX}\" y=\"170\" font-size=\"10\" fill=\"var(--muted-foreground)\" text-anchor=\"middle\">{bucket.Label}ms</text>")
                        }
                    }
                </svg>
            </div>
        </div>

        <dl class="grid grid-cols-3 divide-x border-t">
            @foreach (var pct in _percentiles)
            {
                <div class="px-4 py-3">
                    <dt class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">@pct.Label</dt>
                    <dd class="mt-1 text-sm font-semibold tabular-nums">@(pct.Value)ms</dd>
                </div>
            }
        </dl>
    </div>
</section>

@code {
    private record Bucket(string Label, int Count);
    private record Percentile(string Id, string Label, string Value, string Color);

    private static readonly Bucket[] _buckets =
    [
        new("0",   18),
        new("20",  54),
        new("40",  132),
        new("60",  286),
        new("80",  412),
        new("100", 498),
        new("120", 476),
        new("140", 398),
        new("160", 312),
        new("180", 226),
        new("200", 168),
        new("240", 94),
        new("280", 58),
        new("320", 36),
        new("400", 22),
        new("500", 14),
    ];

    private static readonly Percentile[] _percentiles =
    [
        new("p50", "p50", "110", "var(--muted-foreground)"),
        new("p95", "p95", "240", "var(--color-p95)"),
        new("p99", "p99", "400", "var(--color-p99)"),
    ];

    private static readonly int _total = _buckets.Sum(b => b.Count);
    private static readonly int _maxCount = _buckets.Max(b => b.Count);
    private static readonly int _svgWidth = _buckets.Length * 24;
}
