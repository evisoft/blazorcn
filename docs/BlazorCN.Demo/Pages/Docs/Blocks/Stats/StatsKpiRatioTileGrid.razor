@* ============================================================
   Block: stats-kpi-ratio-tile-grid
   Title: StatsKpiRatioTileGrid
   Description: A KPI ratio tile grid stats block for React and Next.js with current/target ratio values, tabular-nums delta pills, and threshold-colored progress bars anchored to each tile built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-kpi-ratio-tile-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="mb-3 flex items-center justify-between">
        <div>
            <p class="text-sm font-medium">Quarterly Targets</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Q2 2026 · Tracked vs goal</p>
        </div>
        <div class="inline-flex items-center gap-1.5 rounded-full border bg-card px-2.5 py-1">
            <LucideIconCn Name="target" Size="12" Class="size-3 text-muted-foreground" />
            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Live
            </span>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var metric in _metrics)
        {
            var ratioRaw = (double)metric.Current / metric.Target;
            var ratioClamped = Math.Min(Math.Max(ratioRaw, 0.0), 1.0);
            var ratioPercent = (int)Math.Round(ratioClamped * 100);
            var barColor = GetBarColorClass(ratioClamped);
            var isPositiveDelta = metric.Delta >= 0;

            <div class="flex flex-col rounded-lg border bg-card px-4 py-3">
                <div class="flex items-center justify-between gap-2">
                    <span class="text-sm font-medium text-muted-foreground">@metric.Label</span>
                    <span class="@(Cn.Merge("inline-flex items-center gap-0.5 rounded-full px-1.5 py-0.5 text-[10px] font-medium tabular-nums", isPositiveDelta ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-red-500/10 text-red-600 dark:text-red-400"))">
                        @if (isPositiveDelta)
                        {
                            <LucideIconCn Name="trending-up" Size="10" Class="size-2.5" />
                        }
                        else
                        {
                            <LucideIconCn Name="trending-down" Size="10" Class="size-2.5" />
                        }
                        @(isPositiveDelta ? "+" : "")@(metric.Delta.ToString("F1"))%
                    </span>
                </div>
                <div class="mt-2 flex items-baseline gap-1.5">
                    <div class="min-w-[72px]">
                        <span class="text-2xl font-semibold tabular-nums">@FormatCurrent(metric)</span>
                    </div>
                    <span class="text-xs text-muted-foreground tabular-nums">
                        / @FormatTarget(metric)
                    </span>
                </div>
                <p class="mt-0.5 text-[10px] text-muted-foreground">@metric.DeltaLabel</p>
                <div class="mt-3 flex items-center gap-2">
                    <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                        <div aria-label="@metric.Label"
                             aria-valuemax="100"
                             aria-valuemin="0"
                             aria-valuenow="@ratioPercent"
                             class="@(Cn.Merge("h-full rounded-full transition-all duration-700 ease-out", barColor))"
                             role="progressbar"
                             style="@($"width:{ratioPercent}%")">
                        </div>
                    </div>
                    <span class="text-[10px] font-medium text-muted-foreground tabular-nums">
                        @ratioPercent%
                    </span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private enum KpiUnit { Count, Currency, Percent }

    private record KpiRatioMetric(string Id, string Label, KpiUnit Unit, double Current, double Target, double Delta, string DeltaLabel);

    private static readonly KpiRatioMetric[] _metrics =
    [
        new("pipeline", "Q2 Pipeline",   KpiUnit.Currency, 842_000,  1_200_000, 12.4,  "vs Q1"),
        new("deals",    "Closed Deals",  KpiUnit.Count,    87,       120,        4.8,  "vs Q1"),
        new("nps",      "NPS Score",     KpiUnit.Count,    62,       70,        -2.1,  "vs Q1"),
        new("retention","Net Retention", KpiUnit.Percent,  118,      125,        3.2,  "vs Q1"),
    ];

    private static string GetBarColorClass(double ratio)
    {
        if (ratio >= 0.85) return "bg-emerald-500";
        if (ratio >= 0.6)  return "bg-amber-500";
        return "bg-red-500";
    }

    private static string FormatCurrent(KpiRatioMetric metric) => metric.Unit switch
    {
        KpiUnit.Currency => $"${metric.Current / 1_000.0:F0}k",
        KpiUnit.Percent  => $"{metric.Current}%",
        _                => metric.Current.ToString("N0"),
    };

    private static string FormatTarget(KpiRatioMetric metric) => metric.Unit switch
    {
        KpiUnit.Currency => $"${metric.Target / 1_000.0:F0}k",
        KpiUnit.Percent  => $"{metric.Target}%",
        _                => metric.Target.ToString("N0"),
    };
}
