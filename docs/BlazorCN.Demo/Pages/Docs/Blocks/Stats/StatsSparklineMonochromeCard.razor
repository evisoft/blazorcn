    private static string BuildSparklinePath(SparklinePoint[] data, double width, double height)
    {
        if (data.Length == 0) return "";
        var minV = double.MaxValue;
        var maxV = double.MinValue;
        foreach (var pt in data)
        {
            if (pt.V < minV) minV = pt.V;
            if (pt.V > maxV) maxV = pt.V;
        }
        var range = maxV - minV;
        if (range == 0) range = 1;
        var padding = height * 0.1;
        var usableH = height - padding * 2;
        var points = new System.Text.StringBuilder();
        for (var i = 0; i < data.Length; i++)
        {
            var x = (i / (double)(data.Length - 1)) * width;
            var y = padding + (1.0 - (data[i].V - minV) / range) * usableH;
            if (i > 0) points.Append(' ');
            points.Append(FormattableString.Invariant($"{x:F1},{y:F1}"));
        }
        return points.ToString();
    }

    private static string BuildSparklineFillPath(SparklinePoint[] data, double width, double height)
    {
        if (data.Length == 0) return "";
        var minV = double.MaxValue;
        var maxV = double.MinValue;
        foreach (var pt in data)
        {
            if (pt.V < minV) minV = pt.V;
            if (pt.V > maxV) maxV = pt.V;
        }
        var range = maxV - minV;
        if (range == 0) range = 1;
        var padding = height * 0.1;
        var usableH = height - padding * 2;
        var sb = new System.Text.StringBuilder();
        var firstX = 0.0;
        var lastX = 0.0;
        sb.Append('M');
        for (var i = 0; i < data.Length; i++)
        {
            var x = (i / (double)(data.Length - 1)) * width;
            var y = padding + (1.0 - (data[i].V - minV) / range) * usableH;
            if (i == 0) { firstX = x; sb.Append(FormattableString.Invariant($"{x:F1},{y:F1}")); }
            else sb.Append(FormattableString.Invariant($" L{x:F1},{y:F1}"));
            lastX = x;
        }
        sb.Append(FormattableString.Invariant($" L{lastX:F1},{height:F1} L{firstX:F1},{height:F1} Z"));
        return sb.ToString();
    }
}
