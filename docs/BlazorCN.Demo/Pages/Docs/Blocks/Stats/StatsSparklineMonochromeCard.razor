@* ============================================================
   Block: stats-sparkline-monochrome-card
   Title: StatsSparklineMonochromeCard
   Description: A monochrome sparkline stats card for React and Next.js with per-metric ChartContainer-wrapped AreaChart, neutral var(--foreground) stroke, and tabular-nums value displays built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-sparkline-monochrome-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var metric in _metrics)
        {
            var isUp = metric.Direction == "up";
            var gradientId = $"mono-fill-{metric.Id}";
            var sparkPath = BuildSparklinePath(metric.Data, 300, 64);
            var fillPath = BuildSparklineFillPath(metric.Data, 300, 64);

            <div class="overflow-hidden rounded-lg border bg-card" key="@metric.Id">
                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <div class="text-sm font-medium">@metric.Label</div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@metric.Unit</p>
                        </div>
                        <span class="inline-flex items-center gap-0.5 rounded-full border px-1.5 py-0.5 text-xs font-medium tabular-nums border-border bg-muted/50 text-muted-foreground">
                            @if (isUp)
                            {
                                <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" aria-hidden="true" />
                            }
                            else
                            {
                                <LucideIconCn Name="arrow-down-right" Size="12" Class="size-3" aria-hidden="true" />
                            }
                            @metric.Delta
                        </span>
                    </div>
                    <div class="mt-2 text-2xl font-semibold tabular-nums">@metric.Value</div>
                </div>

                <div class="h-16 w-full">
                    <svg viewBox="0 0 300 64" preserveAspectRatio="none" class="h-full w-full" aria-hidden="true">
                        <defs>
                            <linearGradient id="@gradientId" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="var(--foreground)" stop-opacity="0.22" />
                                <stop offset="100%" stop-color="var(--foreground)" stop-opacity="0" />
                            </linearGradient>
                        </defs>
                        <path d="@fillPath" fill="@($"url(#{gradientId})")" />
                        <polyline points="@sparkPath" fill="none" stroke="var(--foreground)" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" />
                    </svg>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record SparklinePoint(string T, double V);
    private record MetricTile(string Id, string Label, string Unit, string Value, string Delta, string Direction, SparklinePoint[] Data);

