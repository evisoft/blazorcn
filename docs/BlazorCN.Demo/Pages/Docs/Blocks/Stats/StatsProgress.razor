@* ========================================
   Block: stats-progress
   Title: Stats Progress
   Description: Usage stats with linear progress bars and limit indicators
   Dependencies: None
   Source: original/blocks/stats/stats-progress.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var item in _data)
        {
            <div class="rounded-lg border bg-card px-4 py-3">
                <p class="text-sm font-medium text-muted-foreground">@item.Name</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@item.Stat</p>
                <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                    <div class="@($"h-full rounded-full transition-all {(item.Percentage > 80 ? "bg-amber-500" : "bg-primary")}")"
                         style="@(FormattableString.Invariant($"width: {item.Percentage}%"))"></div>
                </div>
                <div class="mt-1.5 flex items-center justify-between text-xs">
                    <span class="tabular-nums text-muted-foreground">@(item.Percentage)%</span>
                    <span class="text-muted-foreground">
                        @item.Stat of @item.Limit
                    </span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ProgressItem(string Name, string Stat, string Limit, double Percentage);

    private static readonly ProgressItem[] _data =
    [
        new("Requests", "996", "10,000", 9.96),
        new("Credits", "$672", "$1,000", 67.2),
        new("Storage", "1.85", "10GB", 18.5),
        new("API Calls", "4,328", "5,000", 86.56),
    ];
}
