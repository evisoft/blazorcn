@* ========================================
   Block: stats-greenhouse-gas
   Title: Stats Greenhouse Gas
   Description: GHG emissions tracking with scope 1/2/3 breakdown, reduction targets, carbon credits, and sustainability metrics
   Dependencies: None
   Source: original/blocks/stats/stats-greenhouse-gas.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">GHG Emissions</h3>
            <p class="mt-0.5 text-muted-foreground text-xs">Annual CO&#x2082;e emissions by scope</p>
        </div>

        <div class="border-b px-4 py-4">
            <div class="mb-4 text-center">
                <div class="text-2xl font-semibold tabular-nums">
                    @_totalEmissions.ToString("N0")
                </div>
                <div class="mt-0.5 text-muted-foreground text-xs">tonnes CO&#x2082;e total</div>
            </div>

            <div class="mb-3 flex h-3 overflow-hidden rounded-full bg-muted">
                @foreach (var scope in _emissionScopes)
                {
                    var percentage = (double)scope.Emissions / _totalEmissions * 100;
                    <div class="@(Cn.Merge("h-full", scope.Color))"
                         style="width: @(percentage.ToString("F1"))%"></div>
                }
            </div>

            <div class="space-y-2.5">
                @foreach (var scope in _emissionScopes)
                {
                    var percentage = (double)scope.Emissions / _totalEmissions * 100;

                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@(Cn.Merge("size-2 rounded-full", scope.Color))"></span>
                            <div>
                                <div class="text-sm font-medium">@scope.Scope</div>
                                <div class="text-muted-foreground text-xs">@scope.Label</div>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-sm font-semibold tabular-nums">
                                @scope.Emissions.ToString("N0")
                            </div>
                            <div class="text-muted-foreground text-xs">@(percentage.ToString("F1"))%</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="grid grid-cols-3 gap-px bg-border">
            @foreach (var metric in _reductionMetrics)
            {
                <div class="bg-card px-4 py-3">
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                    <p class="mt-1 text-xl font-semibold tabular-nums">@metric.Value</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">@metric.Target</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record EmissionScope(string Scope, string Label, int Emissions, string Color);
    private record ReductionMetric(string Label, string Value, string Target);

    private static readonly EmissionScope[] _emissionScopes =
    [
        new("Scope 1", "Direct Emissions", 2450, "bg-red-500"),
        new("Scope 2", "Energy Indirect", 4820, "bg-amber-500"),
        new("Scope 3", "Value Chain", 12730, "bg-blue-500"),
    ];

    private static readonly int _totalEmissions = _emissionScopes.Sum(s => s.Emissions);

    private static readonly ReductionMetric[] _reductionMetrics =
    [
        new("2030 Target", "50%", "reduction"),
        new("Carbon Credits", "3,200", "tonnes"),
        new("YoY Reduction", "8.4%", "progress"),
    ];
}
