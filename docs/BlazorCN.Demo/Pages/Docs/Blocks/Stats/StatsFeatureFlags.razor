@* ========================================
   Block: stats-feature-flags
   Title: Stats Feature Flags
   Description: Feature flag management dashboard showing status, rollout percentage, and affected users per flag
   Dependencies: None
   Source: original/blocks/stats/stats-feature-flags.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Feature Flags</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Rollout status and affected users by flag
            </p>
        </div>

        <div class="divide-y">
            @foreach (var flag in _flags)
            {
                var statusColor = flag.Status == "active" ? "bg-emerald-500" : flag.Status == "rollout" ? "bg-blue-500" : "bg-muted-foreground/30";
                var statusLabel = flag.Status == "active" ? "Active" : flag.Status == "rollout" ? "Rolling Out" : "Inactive";

                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <code class="font-mono text-xs">@flag.Name</code>
                                <span class="@(Cn.Merge("size-2 rounded-full", statusColor))"></span>
                            </div>
                            <div class="mt-1 text-xs text-muted-foreground">@flag.Description</div>

                            <div class="mt-3 flex items-center gap-4">
                                <div>
                                    <div class="text-xs text-muted-foreground">Status</div>
                                    <div class="mt-0.5 text-sm font-medium">@statusLabel</div>
                                </div>
                                <div>
                                    <div class="text-xs text-muted-foreground">Environment</div>
                                    <div class="mt-0.5 text-sm font-medium capitalize">
                                        @flag.Environment
                                    </div>
                                </div>
                                <div>
                                    <div class="text-xs text-muted-foreground">Affected Users</div>
                                    <div class="mt-0.5 text-sm font-semibold tabular-nums">
                                        @flag.AffectedUsers.ToString("N0")
                                    </div>
                                </div>
                            </div>

                            @if (flag.Status != "inactive")
                            {
                                <div class="mt-3">
                                    <div class="flex items-center justify-between text-xs">
                                        <span class="text-muted-foreground">Rollout</span>
                                        <span class="font-medium tabular-nums">@flag.RolloutPercent%</span>
                                    </div>
                                    <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-muted">
                                        <div class="h-full rounded-full bg-blue-500 transition-all"
                                             style="width: @(flag.RolloutPercent)%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-2.5">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Total Active Flags</span>
                <span class="font-medium tabular-nums">
                    @_flags.Count(f => f.Status != "inactive") / @_flags.Length
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record FeatureFlag(string Name, string Description, string Status, int RolloutPercent, int AffectedUsers, string Environment);

    private static readonly FeatureFlag[] _flags =
    [
        new("new-checkout-flow", "Updated checkout with one-click payment", "rollout", 25, 3240, "production"),
        new("ai-chatbot-support", "AI-powered customer support chatbot", "active", 100, 12450, "production"),
        new("dark-mode-v2", "Redesigned dark mode with new palette", "rollout", 50, 6225, "production"),
        new("team-collaboration", "Real-time collaborative editing features", "inactive", 0, 0, "staging"),
        new("advanced-analytics", "Custom dashboards and data exports", "rollout", 10, 890, "production"),
    ];
}
