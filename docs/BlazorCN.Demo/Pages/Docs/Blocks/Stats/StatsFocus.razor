@* ========================================
   Block: stats-focus
   Title: Stats Focus
   Description: Pomodoro/focus timer stats with session count, focus time, and productivity score
   Dependencies: None
   Source: original/blocks/stats/stats-focus.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with productivity score *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm font-medium">Focus Stats</span>
            <div class="flex items-baseline gap-1.5">
                <span class="text-2xl font-semibold tabular-nums text-amber-600 dark:text-amber-400">78</span>
                <span class="text-xs text-muted-foreground">Good</span>
            </div>
        </div>

        @* Focus and break times *@
        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <div class="text-2xl font-semibold tabular-nums">2h 45m</div>
                <div class="mt-0.5 text-xs text-muted-foreground">Focus time</div>
            </div>
            <div class="px-4 py-3">
                <div class="text-2xl font-semibold tabular-nums">45m</div>
                <div class="mt-0.5 text-xs text-muted-foreground">Break time</div>
            </div>
        </div>

        @* Session blocks *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs text-muted-foreground">Today's sessions</span>
                <span class="text-xs tabular-nums text-muted-foreground">6 / 8</span>
            </div>
            <div class="flex gap-1">
                @foreach (var block in _todayBlocks)
                {
                    var cls = block.Completed
                        ? (block.Type == "focus" ? "bg-primary" : "bg-muted-foreground/30")
                        : "bg-muted";
                    <div class="@($"h-4 flex-1 rounded-sm transition-colors {cls}")"
                         title="@($"{block.Type} {(block.Completed ? "completed" : "pending")}")"></div>
                }
            </div>
            <div class="mt-1.5 flex justify-between text-[10px] text-muted-foreground">
                <span>Focus</span>
                <span>Break</span>
            </div>
        </div>

        @* Bottom stats *@
        <div class="grid grid-cols-2">
            <div class="border-r px-4 py-3">
                <div class="text-sm font-medium tabular-nums">75%</div>
                <div class="mt-0.5 text-xs text-muted-foreground">Daily goal</div>
            </div>
            <div class="px-4 py-3">
                <div class="text-sm font-medium">4 days</div>
                <div class="mt-0.5 text-xs text-muted-foreground">Current streak</div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SessionBlock(string Type, bool Completed);

    private static readonly SessionBlock[] _todayBlocks =
    [
        new("focus", true), new("break", true),
        new("focus", true), new("break", true),
        new("focus", true), new("break", true),
        new("focus", true), new("break", true),
        new("focus", true), new("break", true),
        new("focus", true), new("break", true),
        new("focus", false), new("break", false),
        new("focus", false), new("break", false),
    ];
}
