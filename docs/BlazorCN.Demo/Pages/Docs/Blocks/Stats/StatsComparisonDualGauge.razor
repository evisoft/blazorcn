@* ============================================================
   Block: stats-comparison-dual-gauge
   Title: StatsComparisonDualGauge
   Description: A comparison stats card for React and Next.js with two side-by-side radial gauge charts powered by Recharts PieChart, NumberFlow animated percent values centered in each ring, semantic chart token fills, and a delta callout between the panels built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-comparison-dual-gauge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Checkout completion rate</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Experiment #482, 14-day window</p>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                Winner: Variant
            </span>
        </div>

        @* Dual gauges *@
        <div class="grid grid-cols-2 divide-x">
            @foreach (var side in _sides)
            {
                var filled = Math.Min(100.0, Math.Max(0.0, side.Value));
                var circumference = 2.0 * Math.PI * 52.0;
                var filledDash = circumference * filled / 100.0;
                var emptyDash = circumference - filledDash;
                var strokeColor = side.Id == "control"
                    ? "oklch(0.646 0.222 41.116)"
                    : "oklch(0.6 0.118 184.704)";

                <div class="flex flex-col items-center gap-2 px-4 py-4">
                    <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        @side.Label
                    </p>
                    <p class="text-xs text-muted-foreground">@side.Sublabel</p>

                    <div class="relative mt-1 aspect-square w-full max-w-[160px]">
                        <div class="mx-auto aspect-square max-h-[160px] flex items-center justify-center">
                            <svg viewBox="0 0 160 160" width="160" height="160" style="overflow:visible">
                                @* Background ring (muted) *@
                                @((MarkupString)$"<circle cx=\"80\" cy=\"80\" r=\"52\" fill=\"none\" stroke=\"var(--muted)\" stroke-width=\"20\" stroke-dasharray=\"{(circumference).ToString("F2")} 0\" stroke-linecap=\"round\" />")
                                @* Filled arc — starts at top (rotate -90deg) *@
                                @((MarkupString)$"<circle cx=\"80\" cy=\"80\" r=\"52\" fill=\"none\" stroke=\"{strokeColor}\" stroke-width=\"20\" stroke-dasharray=\"{filledDash.ToString("F2")} {emptyDash.ToString("F2")}\" stroke-linecap=\"round\" transform=\"rotate(-90 80 80)\" />")
                            </svg>
                        </div>
                        <div class="pointer-events-none absolute inset-0 flex items-center justify-center">
                            <div class="min-w-[80px] text-center">
                                <span class="text-2xl font-semibold tabular-nums">
                                    @((side.Value / 100.0).ToString("P1"))
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer delta callout *@
        <div class="flex items-center justify-center gap-2 border-t bg-muted/30 px-4 py-3">
            <span class="text-xs text-muted-foreground">Control</span>
            <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground" aria-hidden="true" />
            <span class="text-xs text-muted-foreground">Variant</span>
            <span class="ml-2 inline-flex items-center rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                @_deltaSign@(_delta.ToString("F1")) pts lift
            </span>
        </div>

    </div>
</section>

@code {
    private record GaugeSide(string Id, string Label, string Sublabel, double Value);

    private static readonly GaugeSide[] _sides =
    [
        new("control", "Control", "Checkout A", 64.2),
        new("variant", "Variant", "Checkout B", 78.9),
    ];

    private static readonly double _delta = _sides[1].Value - _sides[0].Value;
    private static readonly string _deltaSign = _delta >= 0 ? "+" : "";
}
