@* ============================================================
   Block: stats-variant-comparison-card
   Title: StatsVariantComparisonCard
   Description: An A/B variant comparison stats card for React and Next.js with a three-tile KPI summary strip above two side-by-side variant panels, NumberFlow animated conversion rates, and emerald winning-variant accents built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-variant-comparison-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Homepage hero A/B test</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Experiment #482 · Running 9 days</p>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                Significant
            </span>
        </div>

        <dl class="grid grid-cols-1 gap-px border-b bg-border sm:grid-cols-3">
            <div class="bg-card px-4 py-3">
                <dt class="text-xs font-medium text-muted-foreground">Total visitors</dt>
                <dd class="mt-1 min-w-[120px]">
                    <span class="text-2xl font-semibold tabular-nums">@_summary.Visitors.ToString("N0")</span>
                </dd>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 9 days</p>
            </div>
            <div class="bg-card px-4 py-3">
                <dt class="text-xs font-medium text-muted-foreground">Conversion lift</dt>
                <dd class="mt-1 min-w-[100px]">
                    <span class="text-2xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">+@(_summary.Lift.ToString("F1"))%</span>
                </dd>
                <div class="mt-0.5 flex items-center gap-1">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
                    <span class="text-xs text-muted-foreground">Treatment over control</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <dt class="text-xs font-medium text-muted-foreground">Confidence</dt>
                <dd class="mt-1 min-w-[100px]">
                    <span class="text-2xl font-semibold tabular-nums">@(_summary.Confidence.ToString("F1"))%</span>
                </dd>
                <p class="mt-0.5 text-xs text-muted-foreground">Frequentist p-value</p>
            </div>
        </dl>

        <div class="grid grid-cols-1 divide-y sm:grid-cols-2 sm:divide-x sm:divide-y-0">
            @foreach (var v in _variants)
            {
                var variant = v;
                var isWinner = variant.Id == _winnerId;
                var percent = Math.Round(variant.ConversionRate * 10_000) / 100;

                <div class="px-4 py-4">
                    <div class="flex items-start justify-between gap-2">
                        <div>
                            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                                Variant @variant.Id.ToUpperInvariant()
                            </p>
                            <p class="mt-1 text-sm font-medium">@variant.Label</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">@variant.Description</p>
                        </div>
                        @if (isWinner)
                        {
                            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                                <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                                Winner
                            </span>
                        }
                    </div>

                    <div class="mt-4 min-w-[120px]">
                        <span class="@Cn.Merge("text-3xl font-semibold tabular-nums", isWinner ? "text-emerald-600 dark:text-emerald-400" : "")">
                            @(variant.ConversionRate.ToString("P2"))
                        </span>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">Conversion rate</p>

                    <div
                        aria-label="@($"{variant.Label} conversion")"
                        aria-valuemax="20"
                        aria-valuemin="0"
                        aria-valuenow="@percent"
                        class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-muted"
                        role="progressbar">
                        <div
                            class="@Cn.Merge("h-full rounded-full transition-all duration-700 ease-out", isWinner ? "bg-emerald-500" : "bg-foreground/60")"
                            style="@($"width:{Math.Min(100, percent * 5)}%")">
                        </div>
                    </div>

                    <dl class="mt-4 grid grid-cols-2 gap-2 text-xs">
                        <div>
                            <dt class="text-muted-foreground">Visitors</dt>
                            <dd class="mt-0.5 font-medium tabular-nums">@variant.Visitors.ToString("N0")</dd>
                        </div>
                        <div>
                            <dt class="text-muted-foreground">Conversions</dt>
                            <dd class="mt-0.5 font-medium tabular-nums">@variant.Conversions.ToString("N0")</dd>
                        </div>
                    </dl>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record VariantData(string Id, string Label, string Description, int Visitors, int Conversions, double ConversionRate);

    private record SummaryData(int Visitors, double Lift, double Confidence);

    private static readonly VariantData[] _variants =
    [
        new("a", "Control",   "Original hero copy",    14_280, 1_468, 0.1028),
        new("b", "Treatment", "Value-prop hero copy",  14_312, 1_842, 0.1287),
    ];

    private static readonly string _winnerId =
        _variants.Aggregate((acc, v) => v.ConversionRate > acc.ConversionRate ? v : acc).Id;

    private static double ComputeLiftPct()
    {
        var control   = _variants.FirstOrDefault(v => v.Id == "a")?.ConversionRate ?? 0;
        var treatment = _variants.FirstOrDefault(v => v.Id == "b")?.ConversionRate ?? 0;
        return ((treatment - control) / control) * 100;
    }

    private static readonly double _liftPct = ComputeLiftPct();

    private static readonly SummaryData _summary = new(
        Visitors:   _variants.Sum(v => v.Visitors),
        Lift:       _liftPct,
        Confidence: 97.4
    );
}
