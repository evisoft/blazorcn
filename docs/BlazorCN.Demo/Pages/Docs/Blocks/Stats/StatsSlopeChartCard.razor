@* ============================================================
   Block: stats-slope-chart-card
   Title: StatsSlopeChartCard
   Description: A slope chart stats card for React and Next.js with SVG lines connecting two time-point columns showing direction-keyed emerald and red slopes, positioned value dots, delta labels, and a criss-crossing visual pattern built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-slope-chart-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Customers by plan</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Q1 → Q2 2026</p>
        </div>
        <div class="px-4 py-4">
            <div class="flex items-start gap-0">
                @* Q1 labels *@
                <div class="relative flex w-[100px] shrink-0 flex-col" style="@($"height:{SvgHeight}px")">
                    <p class="mb-2 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">Q1</p>
                    @foreach (var item in _slopeData)
                    {
                        var topQ1 = ValueToY(item.Q1) - 8;
                        <div class="absolute text-right" style="@($"top:{topQ1:F1}px;width:90px")">
                            <span class="text-xs text-muted-foreground">@item.Label</span>
                            <span class="ml-1 text-xs font-medium tabular-nums">@item.Q1</span>
                        </div>
                    }
                </div>

                @* SVG lines *@
                <div class="relative flex-1">
                    <svg width="100%" height="@SvgHeight" class="overflow-visible">
                        @foreach (var item in _slopeData)
                        {
                            var y1 = ValueToY(item.Q1);
                            var y2 = ValueToY(item.Q2);
                            var isUp = item.Q2 > item.Q1;
                            var strokeClass = isUp
                                ? "stroke-emerald-600 dark:stroke-emerald-400"
                                : "stroke-red-600 dark:stroke-red-400";
                            var fillClass = isUp
                                ? "fill-emerald-600 dark:fill-emerald-400"
                                : "fill-red-600 dark:fill-red-400";
                            <g>
                                <line x1="0" y1="@y1.ToString("F1")" x2="100%" y2="@y2.ToString("F1")"
                                      class="@strokeClass"
                                      stroke-width="1.5"
                                      stroke-opacity="0.7" />
                                <circle cx="0" cy="@y1.ToString("F1")" r="3" class="@fillClass" />
                                <circle cx="100%" cy="@y2.ToString("F1")" r="3" class="@fillClass" />
                            </g>
                        }
                    </svg>
                </div>

                @* Q2 labels *@
                <div class="relative flex w-[100px] shrink-0 flex-col" style="@($"height:{SvgHeight}px")">
                    <p class="mb-2 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">Q2</p>
                    @foreach (var item in _slopeData)
                    {
                        var isUp2 = item.Q2 > item.Q1;
                        var delta = ((item.Q2 - item.Q1) / (double)item.Q1 * 100).ToString("F1");
                        var topQ2 = ValueToY(item.Q2) - 8;
                        var deltaClass = isUp2
                            ? "ml-1 text-[10px] tabular-nums text-emerald-600 dark:text-emerald-400"
                            : "ml-1 text-[10px] tabular-nums text-red-600 dark:text-red-400";
                        <div class="absolute" style="@($"top:{topQ2:F1}px;width:90px")">
                            <span class="text-xs font-medium tabular-nums">@item.Q2</span>
                            <span class="@deltaClass">@(isUp2 ? "+" : "")@delta%</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record SlopeItem(string Id, string Label, int Q1, int Q2);

    private static readonly SlopeItem[] _slopeData =
    [
        new("enterprise", "Enterprise", 142, 178),
        new("growth",     "Growth",     98,  112),
        new("starter",    "Starter",    67,  54),
        new("free",       "Free",       210, 185),
        new("agency",     "Agency",     45,  89),
        new("edu",        "Education",  33,  41),
    ];

    private const int SvgHeight = 200;
    private const int SvgPadding = 16;

    private static readonly int _minVal = _slopeData.Min(d => Math.Min(d.Q1, d.Q2));
    private static readonly int _maxVal = _slopeData.Max(d => Math.Max(d.Q1, d.Q2));

    private static double ValueToY(int value)
    {
        var range = _maxVal - _minVal == 0 ? 1.0 : (double)(_maxVal - _minVal);
        return SvgPadding + (1.0 - (value - _minVal) / range) * (SvgHeight - SvgPadding * 2);
    }
}
