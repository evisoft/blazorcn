@* ============================================================
   Block: stats-kpi-compact-tile-grid
   Title: StatsKpiCompactTileGrid
   Description: An ultra-dense KPI tile grid stats block for React and Next.js with six narrow tiles, single-line labels, text-lg tabular values, and inline delta badges built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-kpi-compact-tile-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="mb-3 flex items-baseline justify-between px-1">
        <p class="text-sm font-medium">Q3 snapshot</p>
        <p class="text-xs text-muted-foreground">vs previous quarter</p>
    </div>
    <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-lg border bg-border sm:grid-cols-3 lg:grid-cols-6">
        @foreach (var metric in _metrics)
        {
            <div class="bg-card px-3 py-2" key="@metric.Id">
                <dt class="truncate text-[11px] font-medium text-muted-foreground">@metric.Label</dt>
                <dd class="mt-0.5 flex items-baseline justify-between gap-1.5">
                    <span class="text-lg font-semibold tabular-nums">@metric.Value</span>
                    <span class="@Cn.Merge("text-[10px] font-medium tabular-nums", metric.ChangeType == "positive" ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                        @metric.Change
                    </span>
                </dd>
            </div>
        }
    </dl>
</section>

@code {
    private record KpiMetric(string Id, string Label, string Value, string Change, string ChangeType);

    private static readonly KpiMetric[] _metrics =
    [
        new("mrr",   "MRR",           "$184.2K", "+8.4%",  "positive"),
        new("arr",   "ARR",           "$2.21M",  "+11.2%", "positive"),
        new("nrr",   "Net retention", "112%",    "+3.1%",  "positive"),
        new("churn", "Logo churn",    "1.8%",    "-0.4%",  "positive"),
        new("cac",   "CAC payback",   "9.4mo",   "-1.2mo", "positive"),
        new("burn",  "Gross burn",    "$92.8K",  "+4.7%",  "negative"),
    ];
}
