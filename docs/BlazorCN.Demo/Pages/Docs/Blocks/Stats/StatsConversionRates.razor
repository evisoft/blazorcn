@* ========================================
   Block: stats-conversion-rates
   Title: Stats Conversion Rates
   Description: Funnel step conversion rate visualization showing signup to retention journey with drop-off metrics.
   Dependencies: None
   Source: original/blocks/stats/stats-conversion-rates.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Conversion Funnel</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                User journey from signup to retention
            </p>
        </div>

        <div class="divide-y">
            @for (var i = 0; i < _funnelSteps.Length; i++)
            {
                var step = _funnelSteps[i];
                var isFirst = i == 0;
                var hasHighDropOff = step.DropOff > 30;

                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@step.Name</span>
                                @if (hasHighDropOff && !isFirst)
                                {
                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                }
                            </div>
                            <div class="mt-2 flex items-center gap-4">
                                <div>
                                    <div class="text-xs text-muted-foreground">Users</div>
                                    <div class="mt-0.5 text-xl font-semibold tabular-nums">
                                        @step.Users.ToString("N0")
                                    </div>
                                </div>
                                @if (!isFirst)
                                {
                                    <div>
                                        <div class="text-xs text-muted-foreground">Conversion</div>
                                        <div class="mt-0.5 text-xl font-semibold tabular-nums text-emerald-500">
                                            @step.ConversionRate.ToString("F1")%
                                        </div>
                                    </div>
                                    <div>
                                        <div class="text-xs text-muted-foreground">Drop-off</div>
                                        <div class="@(Cn.Merge("mt-0.5 text-xl font-semibold tabular-nums", hasHighDropOff ? "text-red-500" : "text-muted-foreground"))">
                                            @step.DropOff.ToString("F1")%
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @if (!isFirst)
                    {
                        <div class="mt-3">
                            <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                <div class="@(Cn.Merge("h-full rounded-full transition-all", step.ConversionRate >= 70 ? "bg-emerald-500" : step.ConversionRate >= 50 ? "bg-blue-500" : step.ConversionRate >= 30 ? "bg-amber-500" : "bg-red-500"))"
                                     style="width: @(step.ConversionRate.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-2.5">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Overall Conversion</span>
                <span class="font-medium tabular-nums">
                    @(((double)_funnelSteps[4].Users / _funnelSteps[0].Users * 100).ToString("F2"))%
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record FunnelStep(string Name, int Users, double ConversionRate, double DropOff);

    private static readonly FunnelStep[] _funnelSteps =
    [
        new("Signups", 12450, 100, 0),
        new("Trial Started", 6225, 50.0, 50.0),
        new("Active Usage", 4358, 70.0, 30.0),
        new("Paid Conversion", 1742, 40.0, 60.0),
        new("Retained (30d)", 1393, 80.0, 20.0),
    ];
}