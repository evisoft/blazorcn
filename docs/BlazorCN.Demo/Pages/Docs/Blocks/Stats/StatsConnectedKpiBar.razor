@* ============================================================
   Block: stats-connected-kpi-bar
   Title: StatsConnectedKpiBar
   Description: A single-row connected KPI bar stats card for React and Next.js with four unified tiles sharing a border, tabular-nums values, and semantic delta pills built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-connected-kpi-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="mb-3 flex items-end justify-between">
        <div>
            <p class="text-sm font-medium">Finance overview</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Q3 2026 · Updated 4 min ago</p>
        </div>
        <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
            USD · vs Q2
        </p>
    </div>

    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-lg border bg-border sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var metric in _metrics)
        {
            var deltaClass = metric.ChangeType == "positive"
                ? "text-emerald-600 dark:text-emerald-400"
                : "text-red-600 dark:text-red-400";
            var deltaLabel = $"{(metric.Change > 0 ? "+" : "")}{metric.Change:F2}%";
            var iconName = metric.Change >= 0 ? "trending-up" : "trending-down";

            <div class="bg-card px-4 py-3">
                <div class="text-sm font-medium text-muted-foreground">@metric.Label</div>
                <div class="@Cn.Merge("mt-1", metric.MinWidth)">
                    <span class="text-2xl font-semibold tabular-nums">@FormatCurrency(metric.Value)</span>
                </div>
                <div class="@Cn.Merge("mt-1 flex items-center gap-1 text-xs font-medium tabular-nums", deltaClass)">
                    <LucideIconCn Name="@iconName" Size="14" Class="size-3.5" aria-hidden="true" />
                    <span>@deltaLabel</span>
                    <span class="text-muted-foreground font-normal">vs Q2</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record KpiMetric(string Id, string Label, double Value, string Format, double Change, string ChangeType, string MinWidth);

    private static readonly KpiMetric[] _metrics =
    [
        new("net-profit",       "Net profit",       287654, "currency",  8.32,  "positive", "min-w-[120px]"),
        new("late-payments",    "Late payments",      9435, "currency", -12.64, "positive", "min-w-[90px]"),
        new("pending-invoices", "Pending invoices", 173229, "currency",  2.87,  "negative", "min-w-[110px]"),
        new("op-costs",         "Operating costs",  52891, "currency",  -5.73, "positive", "min-w-[100px]"),
    ];

    private static string FormatCurrency(double value)
    {
        return value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"));
    }
}
