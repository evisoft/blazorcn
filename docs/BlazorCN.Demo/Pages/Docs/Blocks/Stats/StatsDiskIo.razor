@* ========================================
   Block: stats-disk-io
   Title: Stats Disk Io
   Description: Disk performance monitoring showing read/write throughput, IOPS, queue depth, and latency metrics.
   Dependencies: None
   Source: original/blocks/stats/stats-disk-io.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Disk I/O Performance</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Throughput, IOPS, queue depth, and latency by volume
            </p>
        </div>

        <div class="divide-y">
            @foreach (var disk in _disks)
            {
                var totalThroughput = disk.ReadThroughput + disk.WriteThroughput;
                var totalIops = disk.ReadIops + disk.WriteIops;
                var hasHighQueue = disk.QueueDepth > 10;
                var hasHighLatency = disk.Latency > 20;

                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <code class="font-mono text-xs">@disk.Volume</code>
                                @if (hasHighQueue || hasHighLatency)
                                {
                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                }
                            </div>

                            <div class="mt-3 grid grid-cols-2 gap-4">
                                <div>
                                    <div class="text-xs text-muted-foreground">Throughput</div>
                                    <div class="mt-1 text-xl font-semibold tabular-nums">
                                        @totalThroughput.ToString("F1")
                                        <span class="ml-1 text-xs font-normal text-muted-foreground">MB/s</span>
                                    </div>
                                    <div class="mt-1 flex items-center gap-2 text-xs tabular-nums">
                                        <span class="text-muted-foreground">R:</span>
                                        <span class="font-medium">@disk.ReadThroughput.ToString("F1")</span>
                                        <span class="text-muted-foreground">W:</span>
                                        <span class="font-medium">@disk.WriteThroughput.ToString("F1")</span>
                                    </div>
                                </div>

                                <div>
                                    <div class="text-xs text-muted-foreground">IOPS</div>
                                    <div class="mt-1 text-xl font-semibold tabular-nums">
                                        @totalIops.ToString("N0")
                                    </div>
                                    <div class="mt-1 flex items-center gap-2 text-xs tabular-nums">
                                        <span class="text-muted-foreground">R:</span>
                                        <span class="font-medium">@disk.ReadIops.ToString("N0")</span>
                                        <span class="text-muted-foreground">W:</span>
                                        <span class="font-medium">@disk.WriteIops.ToString("N0")</span>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 grid grid-cols-2 gap-4">
                                <div>
                                    <div class="text-xs text-muted-foreground">Queue Depth</div>
                                    <div class="@(Cn.Merge("mt-1 text-sm font-semibold tabular-nums", hasHighQueue ? "text-amber-500" : ""))">
                                        @disk.QueueDepth
                                    </div>
                                </div>
                                <div>
                                    <div class="text-xs text-muted-foreground">Latency</div>
                                    <div class="@(Cn.Merge("mt-1 text-sm font-semibold tabular-nums", hasHighLatency ? "text-amber-500" : ""))">
                                        @disk.Latency.ToString("F1")
                                        <span class="ml-1 text-xs font-normal text-muted-foreground">ms</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record DiskMetric(string Volume, double ReadThroughput, double WriteThroughput, int ReadIops, int WriteIops, int QueueDepth, double Latency);

    private static readonly DiskMetric[] _disks =
    [
        new("/dev/nvme0n1", 234.5, 89.2, 1850, 740, 2, 3.4),
        new("/dev/nvme1n1", 445.8, 312.6, 3520, 2610, 8, 8.2),
        new("/dev/sda1", 78.3, 45.7, 620, 380, 12, 24.6),
    ];
}