@* ========================================
   Block: stats-usage-list
   Title: Stats Usage List
   Description: Usage list with progress bars, limits, and compact rows for React resource dashboards
   Long Description: Usage metrics cards with limits, progress bars, warnings, and action buttons for React billing dashboards
   Dependencies: ButtonCn
   Source: original/blocks/stats/stats-usage-list.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Last 30 days</h3>
                <p class="text-xs text-muted-foreground">Updated just now</p>
            </div>
            <ButtonCn Class="h-7 text-xs" Size="ButtonSize.Sm">
                Upgrade
            </ButtonCn>
        </div>

        @* Usage list *@
        <div>
            @for (var i = 0; i < usageData.Length; i++)
            {
                var item = usageData[i];
                var isLast = i == usageData.Length - 1;

                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <div class="h-1 w-8 shrink-0 overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-primary"
                             style="width: @(item.Percentage)%"></div>
                    </div>
                    <span class="flex-1 truncate text-sm">@item.Name</span>
                    <span class="text-xs tabular-nums text-muted-foreground">
                        @item.Current
                        <span class="mx-1">/</span>
                        @item.Limit
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record UsageItem(string Name, string Current, string Limit, double Percentage);

    private static readonly UsageItem[] usageData = new[]
    {
        new UsageItem("ISR Reads", "358K", "1M", 35.8),
        new UsageItem("Edge Requests", "317K", "1M", 31.7),
        new UsageItem("Fast Origin Transfer", "3.07 GB", "10 GB", 30.7),
        new UsageItem("Speed Insights", "791", "10K", 7.9),
        new UsageItem("Fast Data Transfer", "4.98 GB", "100 GB", 5.0),
        new UsageItem("Function Duration", "3.1 GB-Hrs", "100 GB-Hrs", 3.1),
        new UsageItem("Web Analytics", "1.3K", "50K", 2.6),
        new UsageItem("ISR Writes", "4.8K", "200K", 2.4),
    };
}
