@* ========================================
   Block: stats-period-comparison
   Title: Stats Period Comparison
   Description: Period comparison stats with visual change bars, delta indicators, and contextual labels for React analytics dashboards
   Long Description: A payment method breakdown component displaying transaction counts, success rates, and revenue for different payment types in Next.js e-commerce applications
   Dependencies: None
   Source: original/blocks/stats/stats-period-comparison.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var metric in metrics)
        {
            var delta = metric.Current - metric.Previous;
            var percentChange = ((delta / metric.Previous) * 100).ToString("F1");
            var isUp = delta > 0;
            var max = Math.Max(metric.Current, metric.Previous);
            var currentWidth = (metric.Current / max) * 100;
            var previousWidth = (metric.Previous / max) * 100;

            <div class="overflow-hidden rounded-lg border bg-card">
                <div class="px-4 py-3">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium text-muted-foreground">@metric.Label</span>
                        <span class="@(Cn.Merge("text-xs font-medium tabular-nums", isUp ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"))">
                            @(isUp ? "+" : "")@(percentChange)%
                        </span>
                    </div>
                    <p class="mt-1 text-2xl font-semibold tabular-nums">
                        @(FormatValue(metric.Current, metric.Format))
                    </p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        vs @(FormatValue(metric.Previous, metric.Format))
                    </p>
                </div>

                <div class="border-t px-4 py-3">
                    <div class="space-y-1.5">
                        <div class="flex items-center gap-2">
                            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                <div class="@(Cn.Merge("h-full rounded-full transition-all", isUp ? "bg-emerald-500" : "bg-red-500"))"
                                     style="width: @(currentWidth.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <span class="w-7 text-xs text-muted-foreground">Now</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-muted-foreground/30 transition-all"
                                     style="width: @(previousWidth.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <span class="w-7 text-xs text-muted-foreground">Prev</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record PeriodMetric(string Label, double Current, double Previous, string Format);

    private static readonly PeriodMetric[] metrics = new[]
    {
        new PeriodMetric("Revenue", 48250, 42180, "currency"),
        new PeriodMetric("Orders", 1284, 1420, "number"),
        new PeriodMetric("Conversion", 3.8, 3.2, "percent"),
        new PeriodMetric("Avg. Order", 37.58, 29.7, "currency"),
    };

    private static string FormatValue(double value, string format) => format switch
    {
        "currency" => value < 100 ? value.ToString("C2") : value.ToString("C0"),
        "percent" => $"{value}%",
        _ => value.ToString("N0"),
    };
}
