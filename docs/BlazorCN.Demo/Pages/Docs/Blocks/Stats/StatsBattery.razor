@* ========================================
   Block: stats-battery
   Title: Stats Battery
   Description: Battery/energy status stats with segmented gauge, consumption rate, and time remaining for device dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-battery.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="@(Cn.Merge("size-2 rounded-full", _isCharging ? "bg-emerald-500" : "bg-muted-foreground"))"></span>
                <span class="text-sm font-medium">@(_isCharging ? "Charging" : "On Battery")</span>
            </div>
            @if (_isCharging)
            {
                <span class="text-xs text-emerald-600 dark:text-emerald-400">Connected</span>
            }
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex flex-1 gap-1">
                    @for (var i = 0; i < _segments; i++)
                    {
                        <div class="@(Cn.Merge("h-5 flex-1 rounded-sm transition-all", i < _filledSegments ? GetBatteryColor(_batteryLevel) : "bg-muted"))"></div>
                    }
                </div>
                <div class="h-3 w-2 rounded-r-sm bg-muted"></div>
            </div>
            <div class="mt-2 flex items-baseline gap-1">
                <span class="@(Cn.Merge("text-2xl font-semibold tabular-nums", GetBatteryTextColor(_batteryLevel)))">
                    @(_batteryLevel)%
                </span>
            </div>
        </div>

        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-xs text-muted-foreground">
                    @(_isCharging ? "Charge Rate" : "Usage Rate")
                </p>
                <p class="text-sm font-medium tabular-nums">@(_consumptionRate)%/hr</p>
            </div>
            <div class="text-right">
                <p class="text-xs text-muted-foreground">Time Estimate</p>
                <p class="text-sm font-medium">@_timeRemaining</p>
            </div>
        </div>

        <div class="flex items-center justify-between px-4 py-3">
            <span class="text-xs text-muted-foreground">Battery Health</span>
            <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                Good (94%)
            </span>
        </div>
    </div>
</section>

@code {
    private const int _batteryLevel = 73;
    private const bool _isCharging = true;
    private const int _consumptionRate = 12;
    private static readonly string _timeRemaining = _isCharging ? "1h 24m to full" : "5h 48m remaining";
    private const int _segments = 10;
    private static readonly int _filledSegments = (int)Math.Round((double)_batteryLevel / 100 * _segments);

    private static string GetBatteryColor(int level)
    {
        if (level <= 20) return "bg-red-500";
        if (level <= 40) return "bg-amber-500";
        return "bg-emerald-500";
    }

    private static string GetBatteryTextColor(int level)
    {
        if (level <= 20) return "text-red-600 dark:text-red-400";
        if (level <= 40) return "text-amber-600 dark:text-amber-400";
        return "text-emerald-600 dark:text-emerald-400";
    }
}
