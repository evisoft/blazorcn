@* ========================================
   Block: stats-seo-rankings
   Title: Stats Seo Rankings
   Description: A keyword ranking tracker component displaying search positions, search volume, click-through rate, and position changes for Next.js SEO dashboards
   Long Description: A security vulnerability dashboard displaying severity breakdown, remediation time, and vulnerability tracking built with React, Next.js, and Tailwind CSS
   Dependencies: None
   Source: original/blocks/stats/stats-seo-rankings.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-medium">SEO Rankings</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">Last 7 days</p>
                </div>
                <div class="text-right">
                    <div class="text-2xl font-semibold tabular-nums">
                        @totalClicks.ToString("N0")
                    </div>
                    <p class="text-xs text-muted-foreground">Total Clicks</p>
                </div>
            </div>
        </div>

        <div>
            @for (var i = 0; i < keywordData.Length; i++)
            {
                var kw = keywordData[i];
                var isLast = i == keywordData.Length - 1;
                var positionChange = kw.PreviousPosition - kw.Position;
                var isImproved = positionChange > 0;
                var isDeclined = positionChange < 0;
                var isTopThree = kw.Position <= 3;

                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                    <div class="mb-2 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <div class="@(Cn.Merge("flex size-6 items-center justify-center rounded-full text-xs font-semibold tabular-nums", isTopThree ? "bg-emerald-500/10 text-emerald-500" : "bg-muted text-muted-foreground"))">
                                @kw.Position
                            </div>
                            <span class="text-sm font-medium">@kw.Keyword</span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            @if (isImproved)
                            {
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                <span class="text-xs font-semibold text-emerald-500">
                                    +@positionChange
                                </span>
                            }
                            @if (isDeclined)
                            {
                                <span class="size-1.5 rounded-full bg-red-500"></span>
                                <span class="text-xs font-semibold text-red-500">@positionChange</span>
                            }
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <div class="text-xs text-muted-foreground">Search Volume</div>
                            <div class="mt-0.5 text-xs font-semibold tabular-nums">
                                @kw.SearchVolume.ToString("N0")/mo
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-muted-foreground">CTR</div>
                            <div class="mt-0.5 text-xs font-semibold tabular-nums">
                                @(kw.Ctr.ToString("F1"))%
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-muted-foreground">Clicks</div>
                            <div class="mt-0.5 text-xs font-semibold tabular-nums">
                                @kw.Clicks.ToString("N0")
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="grid grid-cols-3 gap-px border-t bg-border">
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Avg Position</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">
                    @(avgPosition.ToString("F1"))
                </div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Improved</div>
                <div class="mt-0.5 flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-sm font-semibold tabular-nums">
                        @improvedCount/@keywordData.Length
                    </span>
                </div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Top 3</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">
                    @topThreeCount
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record KeywordRanking(string Keyword, int Position, int PreviousPosition, int SearchVolume, double Ctr, int Clicks);

    private static readonly KeywordRanking[] keywordData = new[]
    {
        new KeywordRanking("react component library", 3, 5, 18500, 12.4, 2294),
        new KeywordRanking("nextjs dashboard templates", 1, 1, 8200, 34.2, 2804),
        new KeywordRanking("tailwind ui components", 7, 6, 24300, 4.8, 1166),
        new KeywordRanking("shadcn ui examples", 2, 4, 12800, 18.7, 2394),
        new KeywordRanking("react form components", 12, 9, 15600, 2.1, 328),
    };

    private static readonly int totalClicks = keywordData.Sum(kw => kw.Clicks);
    private static readonly double avgPosition = (double)keywordData.Sum(kw => kw.Position) / keywordData.Length;
    private static readonly int improvedCount = keywordData.Count(kw => kw.Position < kw.PreviousPosition);
    private static readonly int topThreeCount = keywordData.Count(kw => kw.Position <= 3);
}
