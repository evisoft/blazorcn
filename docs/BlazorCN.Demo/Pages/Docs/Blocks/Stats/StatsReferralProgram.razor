@* ========================================
   Block: stats-referral-program
   Title: Stats Referral Program
   Description: A referral program analytics dashboard tracking invites sent, signups, conversion rate, and reward payouts built with React, Next.js, and Tailwind CSS
   Dependencies: None
   Source: original/blocks/stats/stats-referral-program.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Referral Program</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days performance</p>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Invites Sent</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_totalInvites.ToString("N0")</p>
                <p class="mt-0.5 text-xs text-emerald-600">+18.2%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Signups</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_totalSignups</p>
                <p class="mt-0.5 text-xs text-emerald-600">+24.5%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Conversion</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_conversionRate.ToString("F1")%</p>
                <p class="mt-0.5 text-xs text-emerald-600">+1.8%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Rewards</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">$@((_totalRewards / 1000.0).ToString("F1"))K</p>
                <p class="mt-0.5 text-xs text-muted-foreground">@_totalPayouts payouts</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h3 class="text-sm font-medium">Top Referrers</h3>
                <span class="text-xs text-muted-foreground">Last 30 days</span>
            </div>
        </div>

        <div class="border-b">
            @for (var i = 0; i < _referrers.Length; i++)
            {
                var referrer = _referrers[i];
                var isLast = i == _referrers.Length - 1;
                var tierColor = referrer.Tier switch { "gold" => "bg-amber-500", "silver" => "bg-blue-500", _ => "bg-red-500" };
                <div class="@($"px-4 py-2.5 {(isLast ? "" : "border-b")}")">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@referrer.Name</span>
                                <span class="@($"h-1.5 w-1.5 shrink-0 rounded-full {tierColor}")"></span>
                            </div>
                            <div class="mt-1.5 grid grid-cols-4 gap-2">
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Invites</p>
                                    <p class="mt-0.5 text-sm tabular-nums">@referrer.Invites</p>
                                </div>
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Signups</p>
                                    <p class="mt-0.5 text-sm tabular-nums">@referrer.Signups</p>
                                </div>
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Rate</p>
                                    <p class="mt-0.5 text-sm tabular-nums">@referrer.Conversion.ToString("F1")%</p>
                                </div>
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Earned</p>
                                    <p class="mt-0.5 text-sm tabular-nums">$@referrer.Rewards</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Reward Distribution</h3>
            <div class="mt-2 flex h-1.5 overflow-hidden rounded-full bg-muted">
                @foreach (var reward in _rewardTypes)
                {
                    <div class="@($"h-full {reward.Color}")"
                         style="@(FormattableString.Invariant($"width: {(double)reward.Amount / _totalRewards * 100}%"))"></div>
                }
            </div>
            <div class="mt-3 space-y-2.5">
                @foreach (var reward in _rewardTypes)
                {
                    <div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="@($"h-2 w-2 rounded-full {reward.Color}")"></span>
                                <span class="text-sm">@reward.Type</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-xs tabular-nums text-muted-foreground">
                                    @reward.Count rewards
                                </span>
                                <span class="text-sm tabular-nums">$@reward.Amount.ToString("N0")</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-xs font-medium text-muted-foreground">Active Referrers</p>
                    <p class="mt-1 text-sm tabular-nums">328</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">+45 this week</p>
                </div>
                <div>
                    <p class="text-xs font-medium text-muted-foreground">Avg Reward Value</p>
                    <p class="mt-1 text-sm tabular-nums">$@_avgRewardValue.ToString("F2")</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">per payout</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ReferrerData(string Name, int Invites, int Signups, double Conversion, int Rewards, string Tier);
    private record RewardType(string Type, int Count, int Amount, string Color);

    private static readonly ReferrerData[] _referrers =
    [
        new("Sarah Chen", 45, 12, 26.7, 360, "gold"),
        new("Michael Torres", 38, 9, 23.7, 270, "silver"),
        new("Emma Wilson", 29, 8, 27.6, 240, "silver"),
        new("James Park", 22, 5, 22.7, 150, "bronze"),
    ];

    private static readonly RewardType[] _rewardTypes =
    [
        new("Account Credit", 156, 4680, "bg-emerald-500"),
        new("Premium Upgrade", 89, 2670, "bg-blue-500"),
        new("Cash Payout", 34, 1020, "bg-amber-500"),
    ];

    private const int _totalInvites = 1847;
    private const int _totalSignups = 456;
    private static readonly double _conversionRate = (double)_totalSignups / _totalInvites * 100;
    private static readonly int _totalRewards = _rewardTypes.Sum(r => r.Amount);
    private static readonly int _totalPayouts = _rewardTypes.Sum(r => r.Count);
    private static readonly double _avgRewardValue = (double)_totalRewards / _totalPayouts;
}
