@* ============================================================
   Block: stats-progress-compact-list
   Title: StatsProgressCompactList
   Description: An ultra-dense progress list stats card for React and Next.js with 10 rows of inline labels, narrow h-1 progress bars, and tabular-nums compact values divided by a subtle divide-y separator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-progress-compact-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Plan usage</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Current billing cycle</p>
            </div>
            <p class="text-xs text-muted-foreground tabular-nums">@_rows.Length resources</p>
        </div>

        <div class="divide-y">
            @foreach (var row in _rows)
            {
                var percent = Math.Min(100.0, (row.Used / row.Total) * 100.0);
                var color = BarColor(percent);
                var unitPart = string.IsNullOrEmpty(row.Unit) ? "" : $" {row.Unit}";
                var label = $"{row.Used}{unitPart} / {row.Total}{unitPart}";

                <div class="grid grid-cols-[7rem_1fr_auto] items-center gap-3 px-4 py-2.5">
                    <div class="truncate text-xs font-medium">@row.Label</div>
                    <div aria-label="@($"{row.Label} usage")"
                         aria-valuemax="@row.Total"
                         aria-valuemin="0"
                         aria-valuenow="@row.Used"
                         class="h-1 overflow-hidden rounded-full bg-muted"
                         role="progressbar">
                        <div class="@Cn.Merge("h-full rounded-full transition-all duration-700 ease-out", color)"
                             style="@(FormattableString.Invariant($"width:{percent}%"))"></div>
                    </div>
                    <div class="text-right text-xs text-muted-foreground tabular-nums">@label</div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ProgressRow(string Id, string Label, double Used, double Total, string Unit);

    private static readonly ProgressRow[] _rows =
    [
        new("postgres",  "Postgres storage",     182,  250,  "GB"),
        new("redis",     "Redis memory",          7.2,  16,   "GB"),
        new("blob",      "Blob storage",          948,  1000, "GB"),
        new("bandwidth", "Bandwidth",             4.1,  5,    "TB"),
        new("funcs",     "Function invocations",  640,  1000, "k"),
        new("images",    "Image optimizations",   2.4,  10,   "k"),
        new("logs",      "Log ingestion",         38,   50,   "GB"),
        new("analytics", "Analytics events",      12.8, 25,   "M"),
        new("domains",   "Custom domains",        14,   50,   ""),
        new("seats",     "Team seats",            18,   25,   ""),
    ];

    private static string BarColor(double percent)
    {
        if (percent >= 95) return "bg-red-500/80";
        if (percent >= 80) return "bg-amber-500/80";
        return "bg-foreground";
    }
}
