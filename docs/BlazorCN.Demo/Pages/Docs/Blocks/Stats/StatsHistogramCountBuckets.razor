@* ============================================================
   Block: stats-histogram-count-buckets
   Title: StatsHistogramCountBuckets
   Description: A bucketed histogram stats card for React and Next.js with a ChartContainer-wrapped Recharts BarChart rendering counts across fixed numeric buckets, rounded bar caps, and a tabular-nums bucket summary built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-histogram-count-buckets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Session duration histogram</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Seconds per session, last 24 hours
                </p>
            </div>
            <p class="text-xs text-muted-foreground tabular-nums">
                @_totalSessions.ToString("N0") sessions
            </p>
        </div>

        <div class="px-4 py-4">
            <div class="h-[170px] w-full flex items-end gap-[3px]">
                @foreach (var bucket in _buckets)
                {
                    var heightPct = (double)bucket.Count / _maxCount * 100.0;
                    <div class="flex-1 flex flex-col justify-end h-full">
                        <div class="w-full rounded-t-sm" style="@($"height:{heightPct:F1}%;background-color:oklch(0.646 0.222 41.116);")"></div>
                    </div>
                }
            </div>
            <div class="mt-2 flex gap-[3px]">
                @foreach (var bucket in _buckets)
                {
                    <div class="flex-1 text-center text-[10px] text-muted-foreground truncate">@bucket.Bucket</div>
                }
            </div>
        </div>

        <div class="grid grid-cols-3 divide-x border-t">
            <div class="px-4 py-3">
                <div class="text-xs text-muted-foreground">Peak bucket</div>
                <div class="mt-1 text-sm font-semibold tabular-nums">@(_peakBucket.Bucket)s</div>
            </div>
            <div class="px-4 py-3">
                <div class="text-xs text-muted-foreground">Peak count</div>
                <div class="mt-1 text-sm font-semibold tabular-nums">@_peakBucket.Count.ToString("N0")</div>
            </div>
            <div class="px-4 py-3">
                <div class="text-xs text-muted-foreground">Buckets</div>
                <div class="mt-1 text-sm font-semibold tabular-nums">@_buckets.Length</div>
            </div>
        </div>
    </div>
</section>

@code {
    private record BucketPoint(string Bucket, int Count);

    private static readonly BucketPoint[] _buckets =
    [
        new("0-50",   42),
        new("50-100",  118),
        new("100-150", 287),
        new("150-200", 462),
        new("200-250", 538),
        new("250-300", 421),
        new("300-350", 294),
        new("350-400", 186),
        new("400-450", 112),
        new("450-500",  64),
        new("500-550",  31),
        new("550-600",  14),
    ];

    private static readonly int _totalSessions = _buckets.Sum(b => b.Count);
    private static readonly int _maxCount = _buckets.Max(b => b.Count);
    private static readonly BucketPoint _peakBucket = _buckets.OrderByDescending(b => b.Count).First();
}
