@* ============================================================
   Block: stats-leaderboard-with-avatars
   Title: StatsLeaderboardWithAvatars
   Description: A ranked leaderboard stats card for React and Next.js with rank numbers, initial-based avatar circles, tabular-nums score columns, and semantic delta badges built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-leaderboard-with-avatars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Top reps this quarter</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Closed-won pipeline · Q2 2026</p>
            </div>
            <div class="text-right">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Team total
                </p>
                <p class="mt-0.5 text-sm font-semibold tabular-nums">
                    $@_totalScore.ToString("N0")
                </p>
            </div>
        </div>

        <ol class="divide-y">
            @foreach (var entry in _entries)
            {
                var rank = Array.IndexOf(_entries, entry) + 1;
                var isUp = entry.Delta > 0;
                var isDown = entry.Delta < 0;
                var deltaClass = isUp
                    ? "text-emerald-600 dark:text-emerald-400"
                    : isDown
                        ? "text-red-600 dark:text-red-400"
                        : "text-muted-foreground";
                var deltaIconName = isUp ? "arrow-up" : isDown ? "arrow-down" : "minus";
                <li class="flex items-center gap-3 px-4 py-2.5">
                    <span class="w-5 shrink-0 text-right font-mono text-xs text-muted-foreground tabular-nums">
                        @rank
                    </span>
                    <span aria-hidden="true"
                          class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] font-medium text-foreground">
                        @entry.Initials
                    </span>
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-medium">@entry.Name</p>
                        <p class="truncate text-[11px] text-muted-foreground">@entry.Team</p>
                    </div>
                    <span class="shrink-0 text-sm font-semibold tabular-nums">
                        $@entry.Score.ToString("N0")
                    </span>
                    <span class="@Cn.Merge("inline-flex w-12 shrink-0 items-center justify-end gap-0.5 text-xs font-medium tabular-nums", deltaClass)">
                        <LucideIconCn Name="@deltaIconName" Size="12" Class="size-3" aria-hidden="true" />
                        @(entry.Delta == 0 ? "–" : Math.Abs(entry.Delta).ToString())
                    </span>
                </li>
            }
        </ol>
    </div>
</section>

@code {
    private record LeaderboardEntry(string Id, string Name, string Initials, string Team, int Score, int Delta);

    private static readonly LeaderboardEntry[] _entries =
    [
        new("ah", "Ava Hernandez",  "AH", "Enterprise",  184_320,  2),
        new("mk", "Mateo Kline",    "MK", "Mid-market",  172_540,  1),
        new("sr", "Sana Rahimi",    "SR", "Enterprise",  168_210, -2),
        new("jo", "Jordan Okafor", "JO", "SMB",         145_870,  0),
        new("el", "Elena Lombardi", "EL", "Mid-market",  138_420,  3),
        new("tc", "Theo Chen",      "TC", "SMB",         126_980, -1),
    ];

    private static readonly int _totalScore = _entries.Sum(e => e.Score);
}
