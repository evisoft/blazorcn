@* ============================================================
   Block: stats-hero-metric-split-subvalues
   Title: StatsHeroMetricSplitSubvalues
   Description: A hero metric stats card for React and Next.js with a NumberFlow animated headline, delta arrow, and a three-column grid of sub-value breakdowns built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-hero-metric-split-subvalues.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-md p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-5 py-5">
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                @_hero.Label
            </p>
            <p class="mt-0.5 text-xs text-muted-foreground">@_hero.Timeframe</p>

            <div class="mt-4 min-w-[160px]">
                <span class="text-4xl font-semibold tabular-nums">@_hero.FormattedValue</span>
            </div>

            <div class="mt-2 inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
                <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                    @_hero.DeltaLabel
                </span>
            </div>
        </div>

        <dl class="grid grid-cols-3 divide-x border-t">
            @foreach (var sub in _subValues)
            {
                <div class="px-3 py-3">
                    <dt class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        @sub.Label
                    </dt>
                    <dd class="mt-1 text-sm font-semibold tabular-nums">@sub.Value</dd>
                    <dd class="mt-0.5 text-xs text-muted-foreground tabular-nums">@sub.Delta</dd>
                </div>
            }
        </dl>
    </div>
</section>

@code {
    private record HeroMetric(string Label, string Timeframe, string FormattedValue, string DeltaLabel);
    private record SubValue(string Id, string Label, string Value, string Delta);

    private static readonly HeroMetric _hero = new(
        Label: "Monthly recurring revenue",
        Timeframe: "As of Apr 11, 2026",
        FormattedValue: "$284,720",
        DeltaLabel: "+12.4% vs last month"
    );

    private static readonly SubValue[] _subValues =
    [
        new("new", "New MRR", "$48,120", "+18.2%"),
        new("expansion", "Expansion", "$21,840", "+6.7%"),
        new("churn", "Churn", "-$9,240", "-3.1%"),
    ];
}
