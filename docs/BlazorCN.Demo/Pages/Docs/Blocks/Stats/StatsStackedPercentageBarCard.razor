@* ============================================================
   Block: stats-stacked-percentage-bar-card
   Title: StatsStackedPercentageBarCard
   Description: A 100% stacked horizontal bar stats card for React and Next.js with a single thick segmented bar showing proportional distribution, chart-token colored flex segments, a legend with percentages, and a dominant-segment header callout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-stacked-percentage-bar-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Traffic sources</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_dominant.Label leads at <span class="font-medium tabular-nums">@(Math.Round((double)_dominant.Value / _total * 100))%</span>
            </p>
        </div>
        <div class="px-4 py-4">
            <div class="flex h-8 w-full overflow-hidden rounded-md"
                 role="img"
                 aria-label="@(string.Join(", ", _segments.Select(s => $"{s.Label}: {Math.Round((double)s.Value / _total * 100)}%")))">
                @foreach (var seg in _segments)
                {
                    var pct = (double)seg.Value / _total * 100;
                    <div class="flex items-center justify-center text-[10px] font-medium text-background transition-all"
                         style="@($"width:{pct}%;background-color:{seg.Color}")">
                        @if (pct >= 15)
                        {
                            @($"{Math.Round(pct)}%")
                        }
                    </div>
                }
            </div>
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-1 border-t px-4 py-2.5">
            @foreach (var seg in _segments)
            {
                var pct = Math.Round((double)seg.Value / _total * 100);
                <div class="flex items-center gap-1.5">
                    <span class="size-2.5 rounded-sm" style="@($"background-color:{seg.Color}")" aria-hidden="true"></span>
                    <span class="text-xs text-muted-foreground">@seg.Label</span>
                    <span class="text-xs font-medium tabular-nums">@(pct)%</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Segment(string Id, string Label, int Value, string Color);

    private static readonly Segment[] _segments =
    [
        new("organic", "Organic search", 42, "var(--chart-1)"),
        new("direct",  "Direct",         28, "var(--chart-2)"),
        new("referral","Referral",        18, "var(--chart-3)"),
        new("social",  "Social",          12, "var(--chart-4)"),
    ];

    private static readonly int _total = _segments.Sum(s => s.Value);

    private static readonly Segment _dominant = _segments.OrderByDescending(s => s.Value).First();
}
