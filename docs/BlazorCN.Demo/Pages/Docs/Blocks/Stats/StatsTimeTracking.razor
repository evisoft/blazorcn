@* ========================================
   Block: stats-time-tracking
   Title: Stats Time Tracking
   Description: Time tracking stats with hours logged, project breakdown, utilization rate, and weekly summary for React productivity dashboards
   Long Description: Team performance stats with member list, contribution bars, and role indicators for React team dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-time-tracking.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Time Tracking</p>
                <p class="mt-0.5 text-xs text-muted-foreground">This week</p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-semibold tabular-nums">@totalHours</p>
                <p class="mt-0.5 text-xs text-muted-foreground">of @capacity capacity</p>
            </div>
        </div>

        @* Summary *@
        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">@utilization</p>
                <p class="text-xs text-muted-foreground">Utilization</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">@billableHours</p>
                <p class="text-xs text-muted-foreground">Billable</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">@billableRate</p>
                <p class="text-xs text-muted-foreground">Bill Rate</p>
            </div>
        </div>

        @* Projects *@
        <div>
            @for (var i = 0; i < projects.Length; i++)
            {
                var project = projects[i];
                var isLast = i == projects.Length - 1;
                var barWidth = project.Hours / maxHours * 100;

                <div class="@(Cn.Merge("px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", project.Color))"></span>
                            <span class="text-sm font-medium">@project.Name</span>
                            @if (!project.Billable)
                            {
                                <span class="text-xs text-muted-foreground">internal</span>
                            }
                        </div>
                        <span class="text-sm tabular-nums">@(project.Hours)h</span>
                    </div>
                    <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full transition-all", project.Color))"
                             style="width: @(barWidth)%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Project(string Name, double Hours, string Color, bool Billable);

    private const string totalHours = "38.5h";
    private const string capacity = "40h";
    private const string utilization = "96%";
    private const string billableHours = "32.0h";
    private const string billableRate = "83%";

    private static readonly Project[] projects = new[]
    {
        new Project("Client Dashboard", 14.5, "bg-blue-500", true),
        new Project("API Integration", 9.0, "bg-emerald-500", true),
        new Project("Mobile App", 8.5, "bg-violet-500", true),
        new Project("Internal Tools", 4.0, "bg-amber-500", false),
        new Project("Meetings", 2.5, "bg-muted-foreground/50", false),
    };

    private static readonly double maxHours = projects.Max(p => p.Hours);
}
