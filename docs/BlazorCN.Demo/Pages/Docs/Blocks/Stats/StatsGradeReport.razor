@* ========================================
   Block: stats-grade-report
   Title: Stats Grade Report
   Description: Performance grade stats with letter grades, score distribution, pass rates, and subject breakdown
   Dependencies: None
   Source: original/blocks/stats/stats-grade-report.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Grade Report</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Spring 2025 &middot; @_totalCredits credits
                </p>
            </div>
            <div class="flex items-center gap-3">
                <div class="text-right">
                    <p class="text-2xl font-semibold tabular-nums">@_overallGpa</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">GPA</p>
                </div>
                <div class="flex size-10 items-center justify-center rounded-md bg-muted/50">
                    <span class="text-sm font-semibold">@_overallGrade</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex h-2 w-full overflow-hidden rounded-full">
                @foreach (var d in _distribution)
                {
                    <div class="@(Cn.Merge("h-full", d.Grade == "A" ? "bg-emerald-500" : d.Grade == "B" ? "bg-blue-500" : d.Grade == "C" ? "bg-amber-500" : d.Grade == "D" ? "bg-orange-500" : "bg-red-500"))"
                         style="width: @(d.Percent)%"></div>
                }
            </div>
            <div class="mt-2 flex justify-between text-xs text-muted-foreground">
                @foreach (var d in _distribution)
                {
                    <span>@d.Grade: @d.Count</span>
                }
            </div>
        </div>

        <div>
            @for (var i = 0; i < _subjects.Length; i++)
            {
                var subject = _subjects[i];

                <div class="@(Cn.Merge("px-4 py-2.5", i < _subjects.Length - 1 ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <div>
                            <span class="text-sm font-medium">@subject.Name</span>
                            <span class="ml-2 text-xs text-muted-foreground">@subject.Credits cr</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-sm tabular-nums">@subject.Score%</span>
                            <span class="@(Cn.Merge("w-6 text-right text-sm font-semibold", GetGradeColor(subject.Score)))">
                                @subject.Grade
                            </span>
                        </div>
                    </div>
                    <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full transition-all", GetBarColor(subject.Score)))"
                             style="width: @(subject.Score)%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Subject(string Name, int Score, string Grade, int Credits);
    private record GradeDistribution(string Grade, int Count, int Percent);

    private const string _overallGpa = "3.42";
    private const string _overallGrade = "B+";
    private const int _totalCredits = 18;

    private static readonly Subject[] _subjects =
    [
        new("Data Structures", 92, "A", 4),
        new("Linear Algebra", 85, "B+", 3),
        new("Operating Systems", 78, "B", 4),
        new("Database Systems", 88, "A-", 3),
        new("Computer Networks", 71, "B-", 4),
    ];

    private static readonly GradeDistribution[] _distribution =
    [
        new("A", 24, 18),
        new("B", 48, 36),
        new("C", 39, 29),
        new("D", 16, 12),
        new("F", 7, 5),
    ];

    private static string GetGradeColor(int score)
    {
        if (score >= 90) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 80) return "text-blue-600 dark:text-blue-400";
        if (score >= 70) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string GetBarColor(int score)
    {
        if (score >= 90) return "bg-emerald-500";
        if (score >= 80) return "bg-blue-500";
        if (score >= 70) return "bg-amber-500";
        return "bg-red-500";
    }
}
