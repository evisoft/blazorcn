@* ========================================
   Block: stats-database-performance
   Title: Stats Database Performance
   Description: Query response times, connection pool usage, slow queries count, and cache hit rate
   Dependencies: None
   Source: original/blocks/stats/stats-database-performance.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Database Performance</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">
                PostgreSQL &#x2022; Last 1 hour &#x2022; Real-time metrics
            </p>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Avg Response</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums text-emerald-600">42</span>
                    <span class="text-xs text-muted-foreground">ms</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">P95 Response</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums text-amber-600">128</span>
                    <span class="text-xs text-muted-foreground">ms</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Cache Hit Rate</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums text-amber-600">94.2</span>
                    <span class="text-xs text-muted-foreground">%</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Connection Pool Usage</span>
                <span class="text-xs text-muted-foreground">18 active / 25 total</span>
            </div>
            <div class="space-y-2">
                <div>
                    <div class="mb-1 flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Active Connections</span>
                        <span class="font-medium tabular-nums">72%</span>
                    </div>
                    <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                        <div class="h-full bg-amber-500" style="width: 72%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 text-xs font-medium text-muted-foreground">Cache Performance</div>
            <div class="space-y-2">
                <div>
                    <div class="mb-1 flex items-center justify-between text-xs">
                        <span class="flex items-center gap-1.5">
                            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                            <span class="text-muted-foreground">Cache Hits</span>
                        </span>
                        <span class="font-medium tabular-nums">94.2%</span>
                    </div>
                    <div class="h-1 overflow-hidden rounded-full bg-muted">
                        <div class="h-full bg-emerald-500" style="width: 94.2%"></div>
                    </div>
                </div>
                <div>
                    <div class="mb-1 flex items-center justify-between text-xs">
                        <span class="flex items-center gap-1.5">
                            <span class="h-1.5 w-1.5 rounded-full bg-amber-500"></span>
                            <span class="text-muted-foreground">Cache Misses</span>
                        </span>
                        <span class="font-medium tabular-nums">5.8%</span>
                    </div>
                    <div class="h-1 overflow-hidden rounded-full bg-muted">
                        <div class="h-full bg-amber-500" style="width: 5.8%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full bg-amber-500"></span>
                    <span class="text-xs text-muted-foreground">Slow Queries</span>
                </div>
                <div class="mt-1 text-2xl font-semibold tabular-nums">12</div>
                <div class="mt-1 text-xs text-muted-foreground">Last hour</div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="h-2 w-2 rounded-full bg-red-500"></span>
                    <span class="text-xs text-muted-foreground">Deadlocks</span>
                </div>
                <div class="mt-1 text-2xl font-semibold tabular-nums">2</div>
                <div class="mt-1 text-xs text-muted-foreground">Last hour</div>
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-3">
                <div class="text-xs font-medium text-muted-foreground">Slow Query Analysis</div>
            </div>
            <div>
                @for (var i = 0; i < _slowQueries.Length; i++)
                {
                    var query = _slowQueries[i];
                    var isLast = i == _slowQueries.Length - 1;
                    <div class="@($"px-4 py-2.5 {(isLast ? "" : "border-b")}")">
                        <div class="mb-1.5 flex items-start justify-between gap-3">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="@($"h-1.5 w-1.5 rounded-full {(query.Impact == "high" ? "bg-red-500" : "bg-amber-500")}")"></span>
                                    <span class="truncate font-mono text-xs text-muted-foreground">
                                        @query.Query
                                    </span>
                                </div>
                            </div>
                            <div class="shrink-0 text-right">
                                <div class="@($"text-sm font-medium tabular-nums {(query.AvgTime >= 500 ? "text-red-600" : query.AvgTime >= 300 ? "text-amber-600" : "")}")">
                                    @(query.AvgTime)ms
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 text-xs">
                            <span class="text-muted-foreground">
                                @query.Executions.ToString("N0") executions
                            </span>
                            <span class="text-muted-foreground">&#x2022;</span>
                            <span class="@($"capitalize {(query.Impact == "high" ? "text-red-600" : "text-amber-600")}")">
                                @query.Impact impact
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record SlowQuery(string Query, int AvgTime, int Executions, string Impact);

    private static readonly SlowQuery[] _slowQueries =
    [
        new("SELECT * FROM orders JOIN users...", 842, 1240, "high"),
        new("SELECT COUNT(*) FROM analytics WHERE...", 624, 2840, "high"),
        new("UPDATE inventory SET stock = stock - 1...", 418, 840, "medium"),
        new("SELECT * FROM products WHERE category...", 284, 4200, "medium"),
    ];
}
