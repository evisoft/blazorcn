@* ============================================================
   Block: stats-heatmap-with-intensity-legend
   Title: StatsHeatmapWithIntensityLegend
   Description: A weekly activity heatmap stats card for React and Next.js with a 7-row x N-week cell grid, a 5-level emerald intensity ramp, a prominent Low-to-High legend row below the grid, and a streak summary header built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-heatmap-with-intensity-legend.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Activity heatmap</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 12 weeks</p>
            </div>
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="flame" Size="14" Class="size-3.5 text-amber-600 dark:text-amber-400" aria-hidden="true" />
                    <span class="text-xs font-medium tabular-nums">14 day streak</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
                    <span class="text-xs font-medium tabular-nums">82 / 84 days</span>
                </div>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="flex flex-col gap-1">
                @for (var dayIndex = 0; dayIndex < _days.Length; dayIndex++)
                {
                    var row = _dayRows[dayIndex];
                    var day = _days[dayIndex];
                    <div class="flex items-center gap-2">
                        <span class="w-8 text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                            @day
                        </span>
                        <div class="flex flex-1 gap-1">
                            @for (var weekIndex = 0; weekIndex < row.Length; weekIndex++)
                            {
                                var level = row[weekIndex];
                                var wi = weekIndex;
                                <div class="@Cn.Merge("h-3.5 flex-1 rounded-sm", _intensityClasses[level])"
                                     title="@($"{day} week {wi + 1}: {_legendLabels[level]}")"></div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <div aria-label="Intensity scale from none to peak"
             class="flex items-center justify-between gap-3 border-t px-4 py-3"
             role="img">
            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Less
            </span>
            <div class="flex flex-1 items-center justify-center gap-2">
                @for (var levelIndex = 0; levelIndex < _intensityClasses.Length; levelIndex++)
                {
                    var cls = _intensityClasses[levelIndex];
                    var label = _legendLabels[levelIndex];
                    <div class="flex flex-col items-center gap-1">
                        <div class="@Cn.Merge("size-5 rounded-sm", cls)"></div>
                        <span class="text-[10px] text-muted-foreground">@label</span>
                    </div>
                }
            </div>
            <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                More
            </span>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private static readonly int[] _activityData =
    [
        1, 0, 2, 1, 0, 0, 0, 2, 1, 2, 3, 2, 0, 1, 2, 3, 3, 2, 4, 1, 2, 3, 2, 4, 3, 3, 2, 1, 2, 3, 4, 4, 3,
        2, 1, 1, 3, 4, 3, 4, 2, 0, 2, 4, 4, 3, 4, 2, 1, 3, 3, 4, 4, 3, 2, 2, 4, 3, 4, 3, 4, 1, 3, 4, 4, 4,
        3, 2, 2, 4, 4, 4, 3, 4, 1, 2, 3, 4, 4, 4, 2, 2, 3, 4,
    ];

    private static readonly string[] _intensityClasses =
    [
        "bg-muted",
        "bg-emerald-200 dark:bg-emerald-950",
        "bg-emerald-300 dark:bg-emerald-800",
        "bg-emerald-400 dark:bg-emerald-600",
        "bg-emerald-500 dark:bg-emerald-400",
    ];

    private static readonly string[] _legendLabels = ["None", "Light", "Moderate", "High", "Peak"];

    private static readonly int WeekCount = (int)Math.Ceiling(_activityData.Length / 7.0);

    // Rows indexed by day (0=Mon..6=Sun), each row has WeekCount entries.
    // Cell [dayIndex][weekIndex] = activityData[weekIndex * 7 + dayIndex]
    private static readonly int[][] _dayRows = BuildDayRows();

    private static int[][] BuildDayRows()
    {
        var rows = new int[_days.Length][];
        for (var dayIndex = 0; dayIndex < _days.Length; dayIndex++)
        {
            var row = new int[WeekCount];
            for (var weekIndex = 0; weekIndex < WeekCount; weekIndex++)
            {
                var dataIndex = weekIndex * 7 + dayIndex;
                row[weekIndex] = dataIndex < _activityData.Length ? _activityData[dataIndex] : 0;
            }
            rows[dayIndex] = row;
        }
        return rows;
    }
}
