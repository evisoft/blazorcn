@* ============================================================
   Block: stats-dumbbell-chart-card
   Title: StatsDumbbellChartCard
   Description: A dumbbell chart stats card for React and Next.js with horizontal rows showing two connected dots per category representing start and end values, a connecting line between dots, delta labels, and semantic direction colors built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-dumbbell-chart-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">NPS score by region</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Q4 2025 → Q1 2026</p>
        </div>
        <div class="divide-y">
            @foreach (var it in _dumbbellData)
            {
                var isImproved = it.Current >= it.Previous;
                var delta = it.Current - it.Previous;
                var prevPct = Pct(it.Previous);
                var currPct = Pct(it.Current);
                var leftPct = Math.Min(prevPct, currPct);
                var rightPct = Math.Max(prevPct, currPct);

                <div class="px-4 py-3">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium">@it.Label</span>
                        <span class="@Cn.Merge("text-xs font-medium tabular-nums", isImproved ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                            @(isImproved ? "+" : "")@delta
                        </span>
                    </div>
                    <div class="relative mt-2 h-4">
                        @* Track *@
                        <div class="absolute inset-y-[7px] left-0 right-0 h-px bg-border"></div>
                        @* Connecting line *@
                        <div class="absolute inset-y-[7px] h-px bg-muted-foreground/40"
                             style="@($"left: {leftPct}%; width: {rightPct - leftPct}%")"></div>
                        @* Previous dot *@
                        <div class="absolute top-0.5 size-3 -translate-x-1/2 rounded-full border-2 border-background"
                             style="@($"left: {prevPct}%; background-color: var(--chart-2)")"
                             aria-label="@($"Q4: {it.Previous}")"></div>
                        @* Current dot *@
                        <div class="absolute top-0.5 size-3 -translate-x-1/2 rounded-full border-2 border-background"
                             style="@($"left: {currPct}%; background-color: var(--chart-1)")"
                             aria-label="@($"Q1: {it.Current}")"></div>
                    </div>
                </div>
            }
        </div>
        <div class="flex items-center gap-4 border-t px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                <span class="size-2.5 rounded-full" style="background-color: var(--chart-2)"></span>
                <span class="text-xs text-muted-foreground">Q4 2025</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-2.5 rounded-full" style="background-color: var(--chart-1)"></span>
                <span class="text-xs text-muted-foreground">Q1 2026</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record DumbbellItem(string Id, string Label, int Previous, int Current);

    private static readonly DumbbellItem[] _dumbbellData =
    [
        new("na",     "North America", 82, 91),
        new("eu",     "Europe",        75, 78),
        new("apac",   "Asia Pacific",  58, 72),
        new("latam",  "Latin America", 45, 52),
        new("mea",    "Middle East",   38, 44),
        new("africa", "Africa",        22, 31),
    ];

    private static readonly double _maxVal = _dumbbellData.Max(d => Math.Max(d.Previous, d.Current));

    private static double Pct(int value) => (value / _maxVal) * 100.0;
}
