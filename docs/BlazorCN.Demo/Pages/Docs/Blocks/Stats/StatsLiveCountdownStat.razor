@* ============================================================
   Block: stats-live-countdown-stat
   Title: StatsLiveCountdownStat
   Description: A live countdown stats card for React and Next.js with per-segment days/hours/minutes/seconds boxes, tabular-nums digits, a hydration-safe useEffect ticker, and a pulsing live indicator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-live-countdown-stat.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Launch countdown</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Product launch · May 1, 2026 · 12:00 UTC
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <span aria-hidden="true" class="relative flex size-2">
                    <span
                        aria-hidden="true"
                        class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500/60 opacity-75">
                    </span>
                    <span
                        aria-hidden="true"
                        class="relative inline-flex size-2 rounded-full bg-emerald-500">
                    </span>
                </span>
                <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">Live</span>
            </div>
        </div>

        <div class="px-4 py-5">
            <div class="grid grid-cols-4 gap-3">
                @foreach (var seg in _segments)
                {
                    <div class="flex flex-col items-center rounded-lg border bg-muted/30 px-2 py-4">
                        <div class="sr-only">@seg.Label</div>
                        <div class="text-3xl font-semibold tabular-nums">
                            @FormatSegment(seg.Value)
                        </div>
                        <p
                            aria-hidden="true"
                            class="mt-2 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                            @seg.Label
                        </p>
                    </div>
                }
            </div>
            <p class="mt-4 text-center text-xs text-muted-foreground">
                Counts down every second until the target deadline
            </p>
        </div>
    </div>
</section>

@code {
    private static readonly DateTime _targetUtc = new DateTime(2026, 5, 1, 12, 0, 0, DateTimeKind.Utc);

    private record Segment(string Id, string Label, int? Value);

    private Segment[] _segments =
    [
        new("days",    "Days",    null),
        new("hours",   "Hours",   null),
        new("minutes", "Minutes", null),
        new("seconds", "Seconds", null),
    ];

    private Timer? _timer;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _segments = ComputeSegments(DateTime.UtcNow);
            _timer = new Timer(_ =>
            {
                _segments = ComputeSegments(DateTime.UtcNow);
                InvokeAsync(StateHasChanged);
            }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
            StateHasChanged();
        }
    }

    private static Segment[] ComputeSegments(DateTime nowUtc)
    {
        var delta = (int)Math.Max(0, Math.Floor((_targetUtc - nowUtc).TotalSeconds));
        var days    = delta / 86400;
        var hours   = (delta % 86400) / 3600;
        var minutes = (delta % 3600) / 60;
        var seconds = delta % 60;
        return
        [
            new("days",    "Days",    days),
            new("hours",   "Hours",   hours),
            new("minutes", "Minutes", minutes),
            new("seconds", "Seconds", seconds),
        ];
    }

    private static string FormatSegment(int? value)
    {
        if (value is null) return "--";
        return value.Value.ToString().PadLeft(2, '0');
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
