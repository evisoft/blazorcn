@* ========================================
   Block: stats-latency-distribution
   Title: Stats Latency Distribution
   Description: Latency distribution stats with P50, P90, P95, and P99 percentiles with histogram-style bars
   Dependencies: None
   Source: original/blocks/stats/stats-latency-distribution.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-medium">Latency Distribution</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">Last 24 hours</p>
                </div>
                <div class="text-right">
                    <div class="text-2xl font-semibold tabular-nums">98ms</div>
                    <p class="text-xs text-muted-foreground">Average</p>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="space-y-4">
                @foreach (var item in _latencyData)
                {
                    var percentage = (double)item.Latency / item.MaxLatency * 100;
                    var isWarning = item.Latency > 300;
                    var isError = item.Latency > 400;

                    <div>
                        <div class="mb-1.5 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@item.Percentile</span>
                                <span class="@(Cn.Merge("size-1.5 rounded-full", isError ? "bg-red-500" : isWarning ? "bg-amber-500" : "bg-emerald-500"))"></span>
                            </div>
                            <span class="text-sm font-semibold tabular-nums">@(item.Latency)ms</span>
                        </div>
                        <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                            <div class="@(Cn.Merge("h-full rounded-full transition-all", isError ? "bg-red-500" : isWarning ? "bg-amber-500" : "bg-emerald-500"))"
                                 style="width: @(percentage.ToString("F1"))%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="grid grid-cols-2 gap-px border-t bg-border">
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Total Requests</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">
                    @_totalRequests.ToString("N0")
                </div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Max Latency</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">
                    500ms
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record LatencyPercentile(string Percentile, int Latency, int MaxLatency);

    private static readonly LatencyPercentile[] _latencyData =
    [
        new("P50", 45, 500),
        new("P90", 120, 500),
        new("P95", 210, 500),
        new("P99", 380, 500),
    ];

    private const int _totalRequests = 124583;
}
