@* ========================================
   Block: stats-financial-summary
   Title: Stats Financial Summary
   Description: Financial overview stats with income, expenses, net profit, and category breakdown
   Dependencies: None
   Source: original/blocks/stats/stats-financial-summary.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Financial Summary</p>
                <p class="mt-0.5 text-xs text-muted-foreground">February 2025</p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-semibold tabular-nums">@_netProfit</p>
                <p class="mt-0.5 text-xs text-emerald-600 dark:text-emerald-400">
                    @_profitMargin margin
                </p>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-xs font-medium text-muted-foreground">Revenue</p>
                <p class="mt-1 text-xl font-semibold tabular-nums">@_revenue</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs font-medium text-muted-foreground">Expenses</p>
                <p class="mt-1 text-xl font-semibold tabular-nums">@_expenses</p>
            </div>
        </div>

        <div class="border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">Expense Breakdown</span>
        </div>
        <div>
            @for (var i = 0; i < _categories.Length; i++)
            {
                var cat = _categories[i];
                var barWidth = (double)cat.RawAmount / _maxAmount * 100;

                <div class="@(Cn.Merge("px-4 py-2.5", i < _categories.Length - 1 ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium">@cat.Name</span>
                        <div class="flex items-center gap-2">
                            <span class="text-sm tabular-nums">@cat.Amount</span>
                            <span class="@(Cn.Merge("text-xs tabular-nums", cat.ChangeType == "positive" ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"))">
                                @cat.Change
                            </span>
                        </div>
                    </div>
                    <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-primary transition-all"
                             style="width: @(barWidth.ToString("F1"))%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ExpenseCategory(string Name, string Amount, int RawAmount, string Change, string ChangeType);

    private const string _revenue = "$284,500";
    private const string _expenses = "$198,200";
    private const string _netProfit = "$86,300";
    private const string _profitMargin = "30.3%";

    private static readonly ExpenseCategory[] _categories =
    [
        new("Payroll", "$124,800", 124800, "+3.2%", "negative"),
        new("Infrastructure", "$32,400", 32400, "-8.1%", "positive"),
        new("Marketing", "$24,600", 24600, "+12.4%", "negative"),
        new("Software", "$9,800", 9800, "+2.1%", "negative"),
        new("Other", "$6,600", 6600, "-4.2%", "positive"),
    ];

    private static readonly int _maxAmount = _categories.Max(c => c.RawAmount);
}
