@* ========================================
   Block: stats-revenue-funnel
   Title: Stats Revenue Funnel
   Description: Sales funnel stats with stage conversion rates, drop-off indicators, and pipeline visualization for React sales dashboards
   Long Description: User retention stats with cohort period bars, retention rates, and drop-off tracking for React product analytics dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-revenue-funnel.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Conversion Funnel</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days</p>
            </div>
            <div class="text-right">
                <p class="text-xs text-muted-foreground">Overall</p>
                <p class="text-sm font-semibold tabular-nums">@overallConversion%</p>
            </div>
        </div>

        <div>
            @for (var i = 0; i < stages.Length; i++)
            {
                var stage = stages[i];
                var barWidth = (double)stage.Count / maxCount * 100;
                var isLast = i == stages.Length - 1;

                <div class="@(Cn.Merge("px-4 py-3", !isLast ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium">@stage.Name</span>
                        <div class="flex items-center gap-3">
                            <span class="text-sm font-semibold tabular-nums">
                                @stage.Count.ToString("N0")
                            </span>
                            @if (stage.ConversionFromPrev.HasValue)
                            {
                                <span class="w-12 text-right text-xs tabular-nums text-muted-foreground">
                                    @(stage.ConversionFromPrev.Value)%
                                </span>
                            }
                        </div>
                    </div>
                    <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-primary transition-all"
                             style="width: @(barWidth)%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FunnelStage(string Name, int Count, double? ConversionFromPrev);

    private static readonly FunnelStage[] stages = new[]
    {
        new FunnelStage("Visitors", 24500, null),
        new FunnelStage("Sign-ups", 4900, 20.0),
        new FunnelStage("Activated", 2450, 50.0),
        new FunnelStage("Subscribed", 735, 30.0),
        new FunnelStage("Retained (90d)", 588, 80.0),
    };

    private static readonly string overallConversion = ((double)stages[^1].Count / stages[0].Count * 100).ToString("F1");
    private static readonly int maxCount = stages[0].Count;
}
