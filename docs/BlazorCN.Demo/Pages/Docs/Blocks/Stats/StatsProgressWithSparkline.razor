@* ============================================================
   Block: stats-progress-with-sparkline
   Title: StatsProgressWithSparkline
   Description: A progress list stats block for React and Next.js where each row pairs a tabular-nums target ratio, a linear progress bar, and a compact inline ChartContainer sparkline AreaChart showing recent trend built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-progress-with-sparkline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Quarterly goals</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Q2 2026 · 62 days remaining</p>
            </div>
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                5 goals
            </p>
        </div>

        <div class="divide-y">
            @foreach (var goal in _goals)
            {
                var ratio = (double)goal.Current / goal.Target;
                var percent = Math.Min(100.0, Math.Max(0.0, ratio * 100.0));
                var barClass = BarClassFor(ratio);
                var sparkPoints = BuildSparkPoints(goal.Spark, 96, 32);

                <div class="grid grid-cols-[1fr_auto] items-center gap-x-4 gap-y-2 px-4 py-3" key="@goal.Id">
                    <div class="min-w-0">
                        <div class="truncate text-sm font-medium">@goal.Label</div>
                        <div class="mt-0.5 text-xs text-muted-foreground tabular-nums">
                            @FormatValue(goal)
                        </div>
                    </div>

                    <div class="w-24 shrink-0">
                        <svg class="h-8 w-full" viewBox="0 0 96 32" preserveAspectRatio="none" aria-hidden="true">
                            <defs>
                                <linearGradient id="@($"spark-grad-{goal.Id}")" x1="0" x2="0" y1="0" y2="1">
                                    <stop offset="0%" stop-color="oklch(0.646 0.222 41.116)" stop-opacity="0.3" />
                                    <stop offset="100%" stop-color="oklch(0.646 0.222 41.116)" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <polygon points="@($"0,32 {sparkPoints} 96,32")" fill="@($"url(#spark-grad-{goal.Id})")" />
                            <polyline points="@sparkPoints" fill="none" stroke="oklch(0.646 0.222 41.116)" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" />
                        </svg>
                    </div>

                    <div class="col-span-2">
                        <div aria-label="@goal.Label"
                             aria-valuemax="100"
                             aria-valuemin="0"
                             aria-valuenow="@((int)Math.Round(percent))"
                             class="h-1.5 w-full overflow-hidden rounded-full bg-muted"
                             role="progressbar">
                            <div class="@Cn.Merge("h-full rounded-full transition-all duration-700 ease-out", barClass)"
                                 style="@(FormattableString.Invariant($"width:{percent}%"))"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SparkPoint(int X, int Y);
    private record GoalRow(string Id, string Label, string Unit, double Current, double Target, SparkPoint[] Spark);

    private static readonly GoalRow[] _goals =
    [
        new("revenue", "Q2 revenue target", "$", 842_300, 1_000_000, [
            new(1, 640), new(2, 672), new(3, 701), new(4, 718), new(5, 742),
            new(6, 768), new(7, 791), new(8, 812), new(9, 824), new(10, 842),
        ]),
        new("signups", "New workspace signups", "", 2_840, 3_500, [
            new(1, 2120), new(2, 2180), new(3, 2260), new(4, 2320), new(5, 2420),
            new(6, 2540), new(7, 2620), new(8, 2720), new(9, 2780), new(10, 2840),
        ]),
        new("nps", "Customer NPS score", "pt", 48, 60, [
            new(1, 52), new(2, 51), new(3, 53), new(4, 50), new(5, 49),
            new(6, 51), new(7, 50), new(8, 49), new(9, 48), new(10, 48),
        ]),
        new("uptime", "API uptime SLO", "%", 9_992, 9_995, [
            new(1, 9988), new(2, 9991), new(3, 9993), new(4, 9990), new(5, 9989),
            new(6, 9992), new(7, 9993), new(8, 9991), new(9, 9994), new(10, 9992),
        ]),
        new("activation", "7-day activation rate", "%", 38, 50, [
            new(1, 32), new(2, 33), new(3, 34), new(4, 34), new(5, 35),
            new(6, 36), new(7, 37), new(8, 37), new(9, 38), new(10, 38),
        ]),
    ];

    private static string FormatValue(GoalRow goal)
    {
        if (goal.Id == "revenue")
            return $"${(goal.Current / 1_000):0}k / ${(goal.Target / 1_000):0}k";
        if (goal.Id == "uptime")
            return $"{(goal.Current / 100):0.00}% / {(goal.Target / 100):0.00}%";
        if (goal.Unit == "$")
            return $"${goal.Current:N0} / ${goal.Target:N0}";
        if (goal.Unit == "%" || goal.Unit == "pt")
            return $"{goal.Current}{goal.Unit} / {goal.Target}{goal.Unit}";
        return $"{goal.Current:N0} / {goal.Target:N0}";
    }

    private static string BarClassFor(double ratio)
    {
        if (ratio >= 0.95) return "bg-emerald-500";
        if (ratio >= 0.75) return "bg-foreground";
        if (ratio >= 0.5)  return "bg-amber-500";
        return "bg-red-500";
    }

    private static string BuildSparkPoints(SparkPoint[] spark, double svgWidth, double svgHeight)
    {
        if (spark.Length == 0) return "";
        var minY = spark[0].Y;
        var maxY = spark[0].Y;
        foreach (var pt in spark)
        {
            if (pt.Y < minY) minY = pt.Y;
            if (pt.Y > maxY) maxY = pt.Y;
        }
        var rangeY = maxY - minY;
        if (rangeY == 0) rangeY = 1;
        var minX = spark[0].X;
        var maxX = spark[spark.Length - 1].X;
        var rangeX = maxX - minX;
        if (rangeX == 0) rangeX = 1;
        var padding = 2.0;
        var parts = new System.Text.StringBuilder();
        for (var i = 0; i < spark.Length; i++)
        {
            var px = (spark[i].X - minX) / (double)rangeX * (svgWidth - 1);
            var py = svgHeight - padding - (spark[i].Y - minY) / (double)rangeY * (svgHeight - padding * 2);
            if (i > 0) parts.Append(' ');
            parts.Append(FormattableString.Invariant($"{px:0.##},{py:0.##}"));
        }
        return parts.ToString();
    }
}
