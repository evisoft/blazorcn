@* ========================================
   Block: stats-queue-depth
   Title: Stats Queue Depth
   Description: A message queue monitoring component displaying pending, processing, and dead-letter queue depths with throughput metrics for Next.js applications
   Long Description: Investment projection list with growth values and percentage badges for React finance dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-queue-depth.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-medium">Queue Depth</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">Message queues</p>
                </div>
                <div class="text-right">
                    <div class="text-2xl font-semibold tabular-nums">@totalPending</div>
                    <p class="text-xs text-muted-foreground">Pending Messages</p>
                </div>
            </div>
        </div>

        <div>
            @for (var i = 0; i < queueData.Length; i++)
            {
                var queue = queueData[i];
                var isLast = i == queueData.Length - 1;
                var utilizationPct = (double)queue.Pending / queue.MaxDepth * 100;
                var isHighUtilization = utilizationPct > 80;
                var hasDeadLetters = queue.DeadLetter > 0;

                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                    <div class="mb-2 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-sm font-medium">@queue.Name</span>
                            @if (hasDeadLetters)
                            {
                                <span class="size-1.5 rounded-full bg-red-500"></span>
                            }
                        </div>
                        <div class="flex items-center gap-3">
                            <span class="text-xs text-muted-foreground">
                                @(utilizationPct.ToString("F0"))% full
                            </span>
                        </div>
                    </div>

                    <div class="mb-2 h-1.5 overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full transition-all", isHighUtilization ? "bg-amber-500" : "bg-blue-500"))"
                             style="width: @(Math.Min(utilizationPct, 100))%"></div>
                    </div>

                    <div class="grid grid-cols-4 gap-3">
                        <div>
                            <div class="text-xs text-muted-foreground">Pending</div>
                            <div class="mt-0.5 text-xs font-semibold tabular-nums">@queue.Pending</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted-foreground">Processing</div>
                            <div class="mt-0.5 text-xs font-semibold tabular-nums">@queue.Processing</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted-foreground">DLQ</div>
                            <div class="mt-0.5 flex items-center gap-1">
                                @if (hasDeadLetters)
                                {
                                    <span class="size-1.5 rounded-full bg-red-500"></span>
                                }
                                <span class="text-xs font-semibold tabular-nums">@queue.DeadLetter</span>
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-muted-foreground">Throughput</div>
                            <div class="mt-0.5 text-xs font-semibold tabular-nums">
                                @(queue.Throughput)/s
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="grid grid-cols-3 gap-px border-t bg-border">
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Processing</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">@totalProcessing</div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Total DLQ</div>
                <div class="mt-0.5 flex items-center gap-1.5">
                    @if (totalDeadLetter > 0)
                    {
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                    }
                    <span class="text-sm font-semibold tabular-nums">@totalDeadLetter</span>
                </div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Total Throughput</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">
                    @(totalThroughput.ToString("F1"))/s
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record QueueMetrics(string Name, int Pending, int Processing, int DeadLetter, int MaxDepth, double Throughput);

    private static readonly QueueMetrics[] queueData = new[]
    {
        new QueueMetrics("order-processing", 234, 12, 3, 1000, 45.2),
        new QueueMetrics("email-notifications", 567, 28, 0, 2000, 128.7),
        new QueueMetrics("image-processing", 89, 8, 1, 500, 12.3),
        new QueueMetrics("analytics-events", 1245, 45, 7, 5000, 234.6),
    };

    private static readonly int totalPending = queueData.Sum(q => q.Pending);
    private static readonly int totalProcessing = queueData.Sum(q => q.Processing);
    private static readonly int totalDeadLetter = queueData.Sum(q => q.DeadLetter);
    private static readonly double totalThroughput = queueData.Sum(q => q.Throughput);
}
