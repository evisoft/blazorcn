@* ========================================
   Block: stats-api-usage
   Title: Stats Api Usage
   Description: API endpoint monitoring dashboard showing call volume, rate limits, error rates, and latency percentiles. A production-ready React stats component for tracking API metrics in Next.js applications.
   Long Description: HTTP error code breakdown and trending
   Dependencies: None
   Source: original/blocks/stats/stats-api-usage.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">API Usage</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Request volume, rate limits, and latency metrics
            </p>
        </div>

        <div class="divide-y">
            @foreach (var endpoint in endpoints)
            {
                var rateLimitPercent = (double)endpoint.Calls / endpoint.RateLimit * 100;
                var isNearLimit = rateLimitPercent > 80;
                var hasHighErrors = endpoint.ErrorRate > 0.2;

                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <code class="font-mono text-xs">@endpoint.Path</code>
                                @if (hasHighErrors)
                                {
                                    <span class="size-1.5 rounded-full bg-red-500"></span>
                                }
                            </div>
                            <div class="mt-2 flex items-center gap-4">
                                <div>
                                    <div class="text-xs text-muted-foreground">Calls</div>
                                    <div class="mt-0.5 text-sm font-semibold tabular-nums">
                                        @endpoint.Calls.ToString("N0")
                                    </div>
                                </div>
                                <div>
                                    <div class="text-xs text-muted-foreground">Error Rate</div>
                                    <div class="@(Cn.Merge("mt-0.5 text-sm font-semibold tabular-nums", hasHighErrors ? "text-red-500" : ""))">
                                        @(endpoint.ErrorRate.ToString("F2"))%
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-xs text-muted-foreground">Latency (ms)</div>
                            <div class="mt-0.5 flex gap-3 text-xs tabular-nums">
                                <div>
                                    <span class="text-muted-foreground">p50</span>
                                    <span class="font-medium"> @endpoint.P50</span>
                                </div>
                                <div>
                                    <span class="text-muted-foreground">p95</span>
                                    <span class="font-medium"> @endpoint.P95</span>
                                </div>
                                <div>
                                    <span class="text-muted-foreground">p99</span>
                                    <span class="font-medium"> @endpoint.P99</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-3">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Rate Limit</span>
                            <span class="@(Cn.Merge("font-medium tabular-nums", isNearLimit ? "text-amber-500" : ""))">
                                @endpoint.Calls.ToString("N0") / @endpoint.RateLimit.ToString("N0")
                            </span>
                        </div>
                        <div class="mt-1 h-1 overflow-hidden rounded-full bg-muted">
                            <div
                                class="@(Cn.Merge("h-full rounded-full transition-all", isNearLimit ? "bg-amber-500" : "bg-emerald-500"))"
                                style="width: @(rateLimitPercent.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%">
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record EndpointMetric(string Path, int Calls, int RateLimit, double ErrorRate, int P50, int P95, int P99);

    private static readonly EndpointMetric[] endpoints = new[]
    {
        new EndpointMetric("/api/users", 8742, 10000, 0.12, 45, 120, 340),
        new EndpointMetric("/api/products", 12453, 15000, 0.05, 32, 89, 210),
        new EndpointMetric("/api/orders", 5231, 8000, 0.34, 67, 180, 450),
        new EndpointMetric("/api/analytics", 3890, 5000, 0.08, 120, 340, 780),
    };
}
