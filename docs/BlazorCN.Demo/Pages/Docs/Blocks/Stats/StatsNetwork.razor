@* ========================================
   Block: stats-network
   Title: Stats Network
   Description: Download/upload speed stats with transfer rates and connection quality
   Dependencies: None
   Source: original/blocks/stats/stats-network.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm font-medium">Connection Speed</span>
            <div class="flex items-center gap-1.5">
                <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                    Excellent
                </span>
            </div>
        </div>

        @* Main speed *@
        <div class="border-b px-4 py-3">
            <div class="flex items-baseline gap-2">
                <span class="text-2xl font-semibold tabular-nums">245.8</span>
                <span class="text-sm text-muted-foreground">Mbps download</span>
            </div>
            <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-primary transition-all"
                     style="width: 81.9%"></div>
            </div>
            <div class="mt-1.5 flex justify-between text-xs text-muted-foreground">
                <span>0</span>
                <span>300 Mbps</span>
            </div>
        </div>

        @* Download / Upload *@
        <div class="grid grid-cols-2 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Download</p>
                <p class="mt-1 text-sm font-semibold tabular-nums">245.8 Mbps</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Upload</p>
                <p class="mt-1 text-sm font-semibold tabular-nums">42.3 Mbps</p>
            </div>
        </div>

        @* Stats row *@
        <div class="grid grid-cols-3 gap-px bg-border">
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">12ms</p>
                <p class="text-xs text-muted-foreground">Ping</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">3ms</p>
                <p class="text-xs text-muted-foreground">Jitter</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">2.4 GB</p>
                <p class="text-xs text-muted-foreground">Today</p>
            </div>
        </div>
    </div>
</section>

