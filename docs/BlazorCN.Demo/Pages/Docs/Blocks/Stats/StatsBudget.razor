@* ========================================
   Block: stats-budget
   Title: Stats Budget
   Description: Budget stats with progress bars, spending totals, and department tracking
   Dependencies: None
   Source: original/blocks/stats/stats-budget.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var item in _data)
        {
            <div class="rounded-lg border bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Budget @item.Name</p>
                <p class="mt-1 text-sm font-medium">
                    @item.Current / @item.Budget
                </p>
                <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-primary transition-all"
                         style="@($"width: {item.Progress}%")"></div>
                </div>
                <p class="mt-1.5 text-xs font-medium tabular-nums text-muted-foreground">
                    @(item.Progress)%
                </p>
            </div>
        }
    </div>
</section>

@code {
    private record BudgetItem(string Name, int Progress, string Budget, string Current);

    private static readonly BudgetItem[] _data =
    [
        new("HR", 25, "$1,000", "$250"),
        new("Marketing", 55, "$1,000", "$550"),
        new("Finance", 85, "$1,000", "$850"),
        new("Engineering", 70, "$2,000", "$1,400"),
    ];
}
