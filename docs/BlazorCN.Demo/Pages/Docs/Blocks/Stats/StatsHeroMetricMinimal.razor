@* ============================================================
   Block: stats-hero-metric-minimal
   Title: StatsHeroMetricMinimal
   Description: An ultra-minimal hero metric stats card for React and Next.js with a tiny uppercase label, a huge NumberFlow value, and a subtle delta row — no chart, no chrome, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-hero-metric-minimal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-sm p-4">
    <div class="rounded-lg border bg-card px-5 py-6">
        <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
            Monthly active users
        </p>
        <div class="mt-2 min-w-[180px]">
            <span class="text-4xl font-semibold tabular-nums">@_metricValue.ToString("N0")</span>
        </div>
        <div class="mt-2 flex items-center gap-1.5">
            <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
            <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                +@_metricDeltaPct% vs previous 30 days
            </span>
        </div>
    </div>
</section>

@code {
    private const int _metricValue = 48_372;
    private const double _metricDeltaPct = 12.4;
}
