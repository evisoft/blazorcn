@* ============================================================
   Block: stats-live-status-grid
   Title: StatsLiveStatusGrid
   Description: A live status grid stats card for React and Next.js with a 3x3 service cell grid, semantic status dots per cell, tabular-nums live values, and a single pulsing live indicator in the header built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-live-status-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="flex items-center gap-2 text-sm font-medium">
                    <LucideIconCn Name="activity" Size="14" Class="size-3.5 text-muted-foreground" />
                    Fleet status
                </p>
                <p class="mt-0.5 text-xs text-muted-foreground tabular-nums">
                    @_healthyCount healthy · @_degradedCount degraded · @_criticalCount critical
                </p>
            </div>
            <span aria-label="Live" class="relative flex size-2" role="img">
                <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500/60 opacity-75"></span>
                <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
            </span>
        </div>

        <div class="grid grid-cols-3 gap-px bg-border">
            @foreach (var svc in _services)
            {
                var dotClass = svc.Status == ServiceStatus.Healthy ? "bg-emerald-500" : svc.Status == ServiceStatus.Degraded ? "bg-amber-500" : "bg-red-500";
                var textClass = svc.Status == ServiceStatus.Healthy ? "text-emerald-600 dark:text-emerald-400" : svc.Status == ServiceStatus.Degraded ? "text-amber-600 dark:text-amber-400" : "text-red-600 dark:text-red-400";
                var statusLabel = svc.Status == ServiceStatus.Healthy ? "healthy" : svc.Status == ServiceStatus.Degraded ? "degraded" : "critical";

                <div class="flex min-h-[96px] flex-col justify-between bg-card px-3 py-3">
                    <div class="flex items-start justify-between gap-2">
                        <div class="truncate text-[11px] font-medium text-muted-foreground">
                            @svc.Label
                        </div>
                        <span aria-label="@statusLabel"
                              class="@(Cn.Merge("mt-0.5 size-2 shrink-0 rounded-full", dotClass))"
                              role="img"></span>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-lg font-semibold tabular-nums">@svc.Value</span>
                        <span class="text-[10px] text-muted-foreground">@svc.Unit</span>
                    </div>
                    <p class="@(Cn.Merge("text-[10px] font-medium capitalize tabular-nums", textClass))">
                        @statusLabel
                    </p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum ServiceStatus { Healthy, Degraded, Critical }

    private record ServiceCell(string Id, string Label, string Value, string Unit, ServiceStatus Status);

    private static readonly ServiceCell[] _services =
    [
        new("api-us-east",  "API · us-east",  "12.4",  "k rps",  ServiceStatus.Healthy),
        new("api-eu-west",  "API · eu-west",  "8.9",   "k rps",  ServiceStatus.Healthy),
        new("api-ap-south", "API · ap-south", "3.2",   "k rps",  ServiceStatus.Degraded),
        new("db-primary",   "DB · primary",   "42",    "ms p95", ServiceStatus.Healthy),
        new("db-replica",   "DB · replica",   "187",   "ms p95", ServiceStatus.Degraded),
        new("cache",        "Redis cache",    "99.4",  "% hit",  ServiceStatus.Healthy),
        new("queue",        "Worker queue",   "1,240", "jobs",   ServiceStatus.Healthy),
        new("webhook",      "Webhooks",       "2.1",   "% err",  ServiceStatus.Critical),
        new("cdn",          "CDN edge",       "28",    "ms",     ServiceStatus.Healthy),
    ];

    private int _healthyCount  => System.Linq.Enumerable.Count(_services, s => s.Status == ServiceStatus.Healthy);
    private int _degradedCount => System.Linq.Enumerable.Count(_services, s => s.Status == ServiceStatus.Degraded);
    private int _criticalCount => System.Linq.Enumerable.Count(_services, s => s.Status == ServiceStatus.Critical);
}
