@* ============================================================
   Block: stats-bar-chart-grouped
   Title: StatsBarChartGrouped
   Description: A grouped bar chart stats card for React and Next.js with two side-by-side series per category via ChartContainer, dual var(--chart-1) and var(--chart-2) fills, tabular-nums hero totals, and a ChartLegendContent legend built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-bar-chart-grouped.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between gap-4">
                <div>
                    <p class="text-sm font-medium">Revenue vs last year</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">Jan – Sep, year over year</p>
                </div>
                <div class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3" aria-hidden="true" />
                    +@(_deltaPct.ToString("F1"))% YoY
                </div>
            </div>

            <div class="mt-3 grid grid-cols-2 gap-4">
                <div>
                    <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        This year
                    </p>
                    <div class="mt-0.5 flex items-center gap-2">
                        <span aria-hidden="true" class="size-2 rounded-sm" style="background-color:var(--chart-1)"></span>
                        <div class="min-w-[140px]">
                            <span class="text-2xl font-semibold tabular-nums">@FormatCompactUsd(_totalsThisYear)</span>
                        </div>
                    </div>
                </div>
                <div>
                    <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        Last year
                    </p>
                    <div class="mt-0.5 flex items-center gap-2">
                        <span aria-hidden="true" class="size-2 rounded-sm" style="background-color:var(--chart-2)"></span>
                        <div class="min-w-[140px]">
                            <span class="text-2xl font-semibold tabular-nums text-muted-foreground">@FormatCompactUsd(_totalsLastYear)</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="h-[200px] w-full">
                <div class="flex h-full gap-1">
                    @* Y-axis *@
                    <div class="flex w-12 shrink-0 flex-col justify-between pb-6 text-right">
                        @foreach (var tick in _yTicks)
                        {
                            <span class="text-[10px] text-muted-foreground">@($"${tick}k")</span>
                        }
                    </div>

                    @* Chart area *@
                    <div class="flex flex-1 flex-col">
                        <div class="flex flex-1 items-end gap-1 border-b border-border/40">
                            @foreach (var row in _chartData)
                            {
                                var thisYearPct = (double)row.ThisYear / _axisMax * 100;
                                var lastYearPct = (double)row.LastYear / _axisMax * 100;
                                <div class="flex flex-1 items-end justify-center gap-0.5">
                                    <div class="w-full max-w-[16px] rounded-t-[4px]"
                                         style="@(FormattableString.Invariant($"height:{thisYearPct:F1}%;background-color:var(--chart-1)"))"
                                         title="@($"This year: ${row.ThisYear:N0}")">
                                    </div>
                                    <div class="w-full max-w-[16px] rounded-t-[4px]"
                                         style="@(FormattableString.Invariant($"height:{lastYearPct:F1}%;background-color:var(--chart-2)"))"
                                         title="@($"Last year: ${row.LastYear:N0}")">
                                    </div>
                                </div>
                            }
                        </div>
                        @* X-axis *@
                        <div class="flex gap-1 pt-2">
                            @foreach (var row in _chartData)
                            {
                                <div class="flex flex-1 items-center justify-center">
                                    <span class="text-[10px] text-muted-foreground">@row.Month</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            @* Legend *@
            <div class="mt-2 flex items-center justify-center gap-4">
                <div class="flex items-center gap-1.5">
                    <span class="size-2 rounded-sm" style="background-color:var(--chart-1)"></span>
                    <span class="text-xs text-muted-foreground">This year</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-2 rounded-sm" style="background-color:var(--chart-2)"></span>
                    <span class="text-xs text-muted-foreground">Last year</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record MonthlyRow(string Month, int ThisYear, int LastYear);

    private static readonly MonthlyRow[] _chartData =
    [
        new("Jan", 142_380, 118_240),
        new("Feb", 156_720, 124_560),
        new("Mar", 168_920, 139_480),
        new("Apr", 172_450, 146_780),
        new("May", 184_360, 152_390),
        new("Jun", 198_720, 161_240),
        new("Jul", 212_480, 168_950),
        new("Aug", 206_310, 174_620),
        new("Sep", 221_840, 182_340),
    ];

    // Y axis: data max rounded UP to a clean tick step, so bar heights read true against the ticks
    // (mirrors the upstream Recharts auto axis, which never tops out below the data max).
    private const int _tickStep = 50_000;
    private static readonly int _dataMax = _chartData.Max(r => Math.Max(r.ThisYear, r.LastYear));
    private static readonly int _axisMax = (_dataMax + _tickStep - 1) / _tickStep * _tickStep;
    private static readonly int[] _yTicks = Enumerable.Range(0, _axisMax / _tickStep + 1)
        .Select(i => (_axisMax - i * _tickStep) / 1000)
        .ToArray();

    private static readonly int _totalsThisYear = _chartData.Sum(r => r.ThisYear);
    private static readonly int _totalsLastYear = _chartData.Sum(r => r.LastYear);
    private static readonly double _deltaPct = (_totalsThisYear - _totalsLastYear) / (double)_totalsLastYear * 100;

    private static string FormatCompactUsd(int value)
    {
        if (value >= 1_000_000) return $"${value / 1_000_000.0:F1}M";
        if (value >= 1_000) return $"${value / 1_000.0:F0}K";
        return $"${value}";
    }
}
