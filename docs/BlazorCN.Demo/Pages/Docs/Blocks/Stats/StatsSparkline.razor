@* ========================================
   Block: stats-sparkline
   Title: Stats Sparkline
   Description: Stats cards with sparkline area charts, price changes, and trend visualization for React finance dashboards
   Long Description: Social media stats with follower count, engagement rate, and platform breakdown for React analytics dashboards
   Dependencies: None (chart dependency omitted - simplified to static display)
   Source: original/blocks/stats/stats-sparkline.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var item in summary)
        {
            var isPositive = item.ChangeType == "positive";

            <div class="overflow-hidden rounded-lg border bg-card">
                <div class="px-4 py-3">
                    <div class="flex items-start justify-between">
                        <div class="text-sm font-medium">
                            @item.Name
                            <span class="ml-1.5 text-sm text-muted-foreground">@item.Symbol</span>
                        </div>
                        <div class="@(Cn.Merge("rounded px-1.5 py-0.5 text-xs font-medium", isPositive ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400" : "bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400"))">
                            @item.PercentageChange
                        </div>
                    </div>

                    <div class="mt-1 flex items-baseline gap-2">
                        <div class="text-2xl font-semibold tabular-nums">@item.Value</div>
                        <div class="@(Cn.Merge("text-xs font-medium", isPositive ? "text-emerald-600 dark:text-emerald-500" : "text-red-600 dark:text-red-500"))">
                            @item.Change
                        </div>
                    </div>
                </div>

                <div class="h-16 border-t bg-muted/20"></div>
            </div>
        }
    </div>
</section>

@code {
    private record StockSummary(string Name, string Symbol, string Value, string Change, string PercentageChange, string ChangeType);

    private static readonly StockSummary[] summary = new[]
    {
        new StockSummary("Alpha Corp", "ACP", "$168.59", "+15.86", "+10.4%", "positive"),
        new StockSummary("Beta Solutions", "BTS", "$78.54", "+4.65", "+6.3%", "positive"),
        new StockSummary("Gamma Industries", "GMI", "$75.68", "-5.74", "-7.1%", "negative"),
    };
}
