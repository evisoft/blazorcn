@* ============================================================
   Block: stats-connected-kpi-bar-minimal
   Title: StatsConnectedKpiBarMinimal
   Description: A minimal connected KPI bar stats card for React and Next.js with four edge-to-edge tiles, hairline gap-px dividers, and tabular-nums values built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-connected-kpi-bar-minimal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-lg border bg-border sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var metric in _metrics)
        {
            <div class="bg-card px-5 py-5">
                <div class="text-sm font-medium text-muted-foreground">@metric.Label</div>
                <div class="mt-2 text-2xl font-semibold tabular-nums text-foreground">
                    @metric.Value
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record KpiMetric(string Id, string Label, string Value);

    private static readonly KpiMetric[] _metrics =
    [
        new("gmv", "Gross volume", "$4.28M"),
        new("orders", "Orders", "18,402"),
        new("aov", "Average order", "$232.61"),
        new("refund", "Refund rate", "1.24%"),
    ];
}
