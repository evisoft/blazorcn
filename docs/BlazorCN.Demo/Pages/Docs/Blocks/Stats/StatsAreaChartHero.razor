@* ============================================================
   Block: stats-area-chart-hero
   Title: StatsAreaChartHero
   Description: A primary area chart stats card for React and Next.js with a ChartContainer-wrapped Recharts AreaChart, NumberFlow animated hero value, PillTabs 7d/30d/90d period selector, and gradient fill via var(--chart-1) built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-area-chart-hero.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Revenue</p>
                <p class="mt-0.5 text-xs text-muted-foreground">@_periods[_period].Label</p>
            </div>
            <div class="flex items-center gap-1 rounded-full bg-muted p-1">
                @foreach (var p in _periodKeys)
                {
                    var key = p;
                    <button
                        type="button"
                        class="@(Cn.Merge("rounded-full px-3 py-1 text-xs font-medium transition-colors", _period == key ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground"))"
                        @onclick="@(() => _period = key)">
                        @key
                    </button>
                }
            </div>
        </div>

        <div class="flex items-start justify-between gap-4 px-4 py-4">
            <div class="min-w-[160px]">
                <div class="text-3xl font-semibold tabular-nums">@FormatCurrency(_periods[_period].Value)</div>
                <div class="mt-1 flex items-center gap-1">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                    <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                        +@(_periods[_period].Change)% vs previous period
                    </span>
                </div>
            </div>
        </div>

        <div class="px-4 pb-4">
            <div class="h-[200px] w-full">
                <svg viewBox="0 0 600 200" class="h-full w-full" preserveAspectRatio="none" aria-hidden="true">
                    <defs>
                        <linearGradient id="fill-revenue-hero" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" stop-color="var(--chart-1)" stop-opacity="0.35" />
                            <stop offset="100%" stop-color="var(--chart-1)" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    @* Horizontal grid lines *@
                    @foreach (var gridY in GetGridLines(200))
                    {
                        @((MarkupString)$"<line x1=\"0\" y1=\"{gridY:F1}\" x2=\"600\" y2=\"{gridY:F1}\" stroke=\"currentColor\" stroke-opacity=\"0.1\" stroke-dasharray=\"3 3\" />")
                    }
                    @* Area fill *@
                    <path d="@GetAreaPath(_period)" fill="url(#fill-revenue-hero)" />
                    @* Stroke line *@
                    <path d="@GetLinePath(_period)" fill="none" stroke="var(--chart-1)" stroke-width="2" />
                    @* X axis tick labels *@
                    @foreach (var lbl in GetXLabels(_period))
                    {
                        @((MarkupString)$"<text x=\"{lbl.X:F1}\" y=\"{lbl.Y:F1}\" text-anchor=\"middle\" font-size=\"10\" fill=\"currentColor\" opacity=\"0.5\">{lbl.Label}</text>")
                    }
                </svg>
            </div>
        </div>
    </div>
</section>

@code {
    private string _period = "30d";

    private static readonly string[] _periodKeys = ["7d", "30d", "90d"];

    private record PeriodMeta(long Value, double Change, string Label);
    private record DataPoint(string Date, int Revenue);
    private record ChartPoint(double X, double Y);
    private record XLabel(double X, double Y, string Label);

    private static readonly Dictionary<string, PeriodMeta> _periods = new()
    {
        ["7d"]  = new(192_870, 8.4,  "Last 7 days"),
        ["30d"] = new(687_420, 12.4, "Last 30 days"),
        ["90d"] = new(1_847_320, 18.2, "Last 90 days"),
    };

    private static readonly Dictionary<string, DataPoint[]> _chartData = new()
    {
        ["7d"] =
        [
            new("2026-04-05", 24_760),
            new("2026-04-06", 26_120),
            new("2026-04-07", 27_480),
            new("2026-04-08", 26_890),
            new("2026-04-09", 28_340),
            new("2026-04-10", 29_120),
            new("2026-04-11", 30_450),
        ],
        ["30d"] =
        [
            new("2026-03-13", 14_200),
            new("2026-03-16", 15_820),
            new("2026-03-19", 16_450),
            new("2026-03-22", 18_320),
            new("2026-03-25", 19_910),
            new("2026-03-28", 21_580),
            new("2026-03-31", 23_120),
            new("2026-04-03", 24_760),
            new("2026-04-06", 26_120),
            new("2026-04-09", 28_340),
            new("2026-04-11", 30_450),
        ],
        ["90d"] =
        [
            new("2026-01-12", 11_200),
            new("2026-01-22", 12_450),
            new("2026-02-01", 13_620),
            new("2026-02-12", 14_200),
            new("2026-02-22", 15_820),
            new("2026-03-04", 16_450),
            new("2026-03-14", 18_320),
            new("2026-03-24", 21_580),
            new("2026-04-03", 24_760),
            new("2026-04-11", 30_450),
        ],
    };

    private static string FormatCurrency(long value)
    {
        if (value >= 1_000_000)
            return $"${value / 1_000_000.0:F2}M".Replace(".00M", "M");
        if (value >= 1_000)
            return $"${value / 1_000.0:F0}K";
        return $"${value:N0}";
    }

    private const double SvgWidth = 600;
    private const double SvgHeight = 200;
    private const double TopPad = 4;
    private const double BottomPad = 16;

    private static List<ChartPoint> GetChartPoints(string period)
    {
        var data = _chartData[period];
        int n = data.Length;
        if (n == 0) return [];

        double minVal = data[0].Revenue;
        double maxVal = data[0].Revenue;
        foreach (var d in data)
        {
            if (d.Revenue < minVal) minVal = d.Revenue;
            if (d.Revenue > maxVal) maxVal = d.Revenue;
        }
        double range = maxVal - minVal;
        if (range == 0) range = 1;

        double chartH = SvgHeight - TopPad - BottomPad;
        var pts = new List<ChartPoint>(n);
        for (int i = 0; i < n; i++)
        {
            double x = n == 1 ? SvgWidth / 2.0 : i * (SvgWidth / (n - 1.0));
            double y = TopPad + chartH - ((data[i].Revenue - minVal) / range) * chartH;
            pts.Add(new ChartPoint(x, y));
        }
        return pts;
    }

    private static string GetLinePath(string period)
    {
        var pts = GetChartPoints(period);
        if (pts.Count == 0) return "";
        var sb = new System.Text.StringBuilder();
        sb.Append($"M {pts[0].X:F1} {pts[0].Y:F1}");
        for (int i = 1; i < pts.Count; i++)
        {
            double cpX = (pts[i - 1].X + pts[i].X) / 2.0;
            sb.Append($" C {cpX:F1} {pts[i - 1].Y:F1}, {cpX:F1} {pts[i].Y:F1}, {pts[i].X:F1} {pts[i].Y:F1}");
        }
        return sb.ToString();
    }

    private static string GetAreaPath(string period)
    {
        var pts = GetChartPoints(period);
        if (pts.Count == 0) return "";
        var line = GetLinePath(period);
        var last = pts[^1];
        var first = pts[0];
        return $"{line} L {last.X:F1} {SvgHeight:F1} L {first.X:F1} {SvgHeight:F1} Z";
    }

    private static List<double> GetGridLines(double height)
    {
        return [height * 0.25, height * 0.5, height * 0.75];
    }

    private static List<XLabel> GetXLabels(string period)
    {
        var data = _chartData[period];
        int n = data.Length;
        var indices = new List<int>();
        if (n <= 4)
        {
            for (int i = 0; i < n; i++) indices.Add(i);
        }
        else
        {
            indices.Add(0);
            indices.Add(n / 3);
            indices.Add(2 * n / 3);
            indices.Add(n - 1);
        }

        var result = new List<XLabel>();
        foreach (var idx in indices)
        {
            double x = n == 1 ? SvgWidth / 2.0 : idx * (SvgWidth / (n - 1.0));
            var parts = data[idx].Date.Split('-');
            string lbl = parts.Length == 3
                ? $"{MonthAbbr(int.Parse(parts[1]))} {int.Parse(parts[2])}"
                : data[idx].Date;
            result.Add(new XLabel(x, SvgHeight - 2, lbl));
        }
        return result;
    }

    private static string MonthAbbr(int month) => month switch
    {
        1 => "Jan", 2 => "Feb", 3 => "Mar", 4 => "Apr",
        5 => "May", 6 => "Jun", 7 => "Jul", 8 => "Aug",
        9 => "Sep", 10 => "Oct", 11 => "Nov", 12 => "Dec",
        _ => ""
    };
}
