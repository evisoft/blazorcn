@* ========================================
   Block: stats-loyalty-program
   Title: Stats Loyalty Program
   Description: Customer loyalty program dashboard with points balance, tier status, and redemption rates
   Dependencies: None
   Source: original/blocks/stats/stats-loyalty-program.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Loyalty Program</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_totalMembers.ToString("N0") total members
            </p>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            @foreach (var metric in _programMetrics)
            {
                <div class="bg-card px-4 py-3">
                    <p class="text-xs text-muted-foreground">@metric.Label</p>
                    <p class="mt-1 text-2xl font-semibold tabular-nums">@metric.Value</p>
                    <p class="mt-0.5 text-xs text-emerald-600">+@(metric.Change)%</p>
                </div>
            }
        </div>

        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <h4 class="text-sm font-medium">Member Distribution by Tier</h4>
            </div>

            <div class="mb-3 flex h-3 overflow-hidden rounded-full bg-muted">
                @foreach (var tier in _tierDistribution)
                {
                    <div class="@($"h-full {tier.Color}")"
                         style="@($"width: {tier.Percentage}%")"
                         title="@($"{tier.Tier}: {tier.Percentage}%")"></div>
                }
            </div>

            <div class="space-y-2.5">
                @foreach (var tier in _tierDistribution)
                {
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@($"h-2 w-2 rounded-full {tier.Color}")"></span>
                            <span class="text-sm font-medium">@tier.Tier</span>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="text-sm tabular-nums">
                                @tier.Members.ToString("N0") members
                            </span>
                            <span class="w-12 text-right text-xs tabular-nums text-muted-foreground">
                                @(tier.Percentage)%
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="grid grid-cols-2 gap-3">
                <div class="rounded-md border bg-muted/30 px-3 py-2.5">
                    <p class="text-xs text-muted-foreground">Avg Points per Member</p>
                    <p class="mt-1 text-xl font-semibold tabular-nums">2,680</p>
                </div>
                <div class="rounded-md border bg-muted/30 px-3 py-2.5">
                    <p class="text-xs text-muted-foreground">Monthly Redeemed</p>
                    <p class="mt-1 text-xl font-semibold tabular-nums">1.4M</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record TierInfo(string Tier, int Members, int Percentage, string Color);
    private record ProgramMetric(string Label, string Value, double Change);

    private static readonly TierInfo[] _tierDistribution =
    [
        new("Bronze", 12450, 62, "bg-amber-700"),
        new("Silver", 5280, 26, "bg-slate-400"),
        new("Gold", 1980, 10, "bg-amber-500"),
        new("Platinum", 420, 2, "bg-purple-500"),
    ];

    private static readonly int _totalMembers = _tierDistribution.Sum(t => t.Members);

    private static readonly ProgramMetric[] _programMetrics =
    [
        new("Points Balance", "4.2M", 8.3),
        new("Redemption Rate", "34%", 5.2),
        new("Active Members", "15.8K", 12.4),
    ];
}
