@* ========================================
   Block: stats-goals
   Title: Stats Goals
   Description: Stats cards with goal progress indicators, status badges, and clickable regions
   Dependencies: None
   Source: original/blocks/stats/stats-goals.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-lg border bg-border sm:grid-cols-2 md:grid-cols-3">
        @foreach (var item in _data)
        {
            var statusColor = item.Status switch { "within" => "bg-emerald-500", "observe" => "bg-amber-500", _ => "bg-red-500" };
            var statusTextColor = item.Status switch { "within" => "text-emerald-600 dark:text-emerald-400", "observe" => "text-amber-600 dark:text-amber-400", _ => "text-red-600 dark:text-red-400" };
            var pct = (int)Math.Round((double)item.GoalsAchieved / item.TotalGoals * 100);
            <div class="bg-card px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-muted-foreground">@item.Name</span>
                    <div class="flex items-center gap-1.5">
                        <span class="@($"h-1.5 w-1.5 rounded-full {statusColor}")"></span>
                        <span class="@($"text-xs font-medium capitalize {statusTextColor}")">
                            @item.Status
                        </span>
                    </div>
                </div>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@item.Stat</p>
                <div class="mt-3">
                    <div class="flex items-center justify-between text-xs text-muted-foreground">
                        <span>@item.GoalsAchieved/@item.TotalGoals goals</span>
                        <span class="tabular-nums">@pct%</span>
                    </div>
                    <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@($"h-full rounded-full transition-all {statusColor}")"
                             style="@($"width: {pct}%")"></div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record GoalItem(string Name, string Stat, int GoalsAchieved, int TotalGoals, string Status);

    private static readonly GoalItem[] _data =
    [
        new("Europe", "$10,023", 3, 5, "observe"),
        new("North America", "$14,092", 5, 5, "within"),
        new("Asia", "$113,232", 1, 5, "critical"),
    ];
}
