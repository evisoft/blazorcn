@* ========================================
   Block: stats-breakdown
   Title: Stats Breakdown
   Description: Stats breakdown with segment bars, percentage distribution, and ranking indicators
   Dependencies: None
   Source: original/blocks/stats/stats-breakdown.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between">
                <div>
                    <p class="text-sm font-medium text-muted-foreground">Revenue by Channel</p>
                    <p class="mt-1 text-2xl font-semibold tabular-nums">$248,500</p>
                </div>
                <span class="text-xs text-muted-foreground">This month</span>
            </div>
            <div class="mt-3 flex h-2 overflow-hidden rounded-full">
                @foreach (var segment in _segments)
                {
                    <div class="@($"h-full {segment.Color}")" style="@($"width: {segment.Percentage}%")"></div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="space-y-3">
                @foreach (var segment in _segments)
                {
                    <div class="group">
                        <div class="flex items-center justify-between text-sm">
                            <div class="flex items-center gap-2">
                                <div class="@($"h-2.5 w-2.5 rounded-full {segment.Color}")"></div>
                                <span class="font-medium">@segment.Name</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-muted-foreground">@segment.Value.ToString("C0")</span>
                                <span class="w-10 text-right font-medium tabular-nums">
                                    @(segment.Percentage)%
                                </span>
                            </div>
                        </div>
                        <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                            <div class="@($"h-full rounded-full transition-all group-hover:opacity-80 {segment.Color}")"
                                 style="@(FormattableString.Invariant($"width: {(double)segment.Percentage / _maxPercentage * 100}%"))"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Segment(string Name, int Value, int Percentage, string Color);

    private static readonly Segment[] _segments =
    [
        new("Direct", 89460, 36, "bg-primary"),
        new("Organic Search", 62125, 25, "bg-chart-2"),
        new("Paid Ads", 49700, 20, "bg-chart-3"),
        new("Referral", 29820, 12, "bg-chart-4"),
        new("Social", 17395, 7, "bg-chart-5"),
    ];

    private static readonly int _maxPercentage = _segments.Max(s => s.Percentage);
}
