@* ========================================
   Block: stats-token-usage
   Title: Stats Token Usage
   Description: An AI token consumption dashboard tracking input/output tokens, cost per model, and daily usage trends
   Long Description: Time tracking stats with hours logged, project breakdown, utilization rate, and weekly summary for React productivity dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-token-usage.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">AI Token Usage</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">Last 30 days consumption</p>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Cost</p>
                <p class="mt-1 font-semibold tabular-nums text-2xl">$@(_totalCost.ToString("F0"))</p>
                <p class="mt-0.5 text-red-600 text-xs">+18.2%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Input Tokens</p>
                <p class="mt-1 font-semibold tabular-nums text-2xl">
                    @((_totalInputTokens / 1000000.0).ToString("F1"))M
                </p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @(((double)_totalInputTokens / (_totalInputTokens + _totalOutputTokens) * 100).ToString("F0"))%
                </p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Output Tokens</p>
                <p class="mt-1 font-semibold tabular-nums text-2xl">
                    @((_totalOutputTokens / 1000000.0).ToString("F1"))M
                </p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @(((double)_totalOutputTokens / (_totalInputTokens + _totalOutputTokens) * 100).ToString("F0"))%
                </p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Requests</p>
                <p class="mt-1 font-semibold tabular-nums text-2xl">
                    @((_totalRequests / 1000.0).ToString("F1"))K
                </p>
                <p class="mt-0.5 text-emerald-600 text-xs">+8.7%</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h3 class="font-medium text-sm">Usage by Model</h3>
                <span class="text-muted-foreground text-xs">@_modelUsage.Length models</span>
            </div>
        </div>

        <div class="border-b">
            @for (var idx = 0; idx < _modelUsage.Length; idx++)
            {
                var m = _modelUsage[idx];
                <div class="@Cn.Merge("px-4 py-2.5", idx != _modelUsage.Length - 1 ? "border-b" : "")">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@m.Model</span>
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetCostColor(m.TotalCost))"></span>
                            </div>
                            <div class="mt-1.5 grid grid-cols-4 gap-2">
                                <div>
                                    <p class="font-medium text-muted-foreground text-xs">Input</p>
                                    <p class="mt-0.5 tabular-nums text-sm">
                                        @((m.InputTokens / 1000000.0).ToString("F1"))M
                                    </p>
                                </div>
                                <div>
                                    <p class="font-medium text-muted-foreground text-xs">Output</p>
                                    <p class="mt-0.5 tabular-nums text-sm">
                                        @((m.OutputTokens / 1000000.0).ToString("F1"))M
                                    </p>
                                </div>
                                <div>
                                    <p class="font-medium text-muted-foreground text-xs">Cost</p>
                                    <p class="mt-0.5 tabular-nums text-sm">$@(m.TotalCost.ToString("F2"))</p>
                                </div>
                                <div>
                                    <p class="font-medium text-muted-foreground text-xs">Requests</p>
                                    <p class="mt-0.5 tabular-nums text-sm">@(m.Requests.ToString("N0"))</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h3 class="font-medium text-sm">Daily Cost Trend</h3>
                <span class="text-muted-foreground text-xs">Last 7 days</span>
            </div>
            <div class="relative mt-4 h-32">
                <svg viewBox="@($"0 0 {_dailyUsage.Length * 50} 100")" class="h-full w-full" preserveAspectRatio="none">
                    <title>Daily token usage cost trend over last 7 days</title>
                    @for (var i = 0; i < _dailyUsage.Length; i++)
                    {
                        var day = _dailyUsage[i];
                        var height = day.Cost / _maxDailyCost * 90;
                        <rect x="@(i * 50 + 12)" y="@(100 - height)" width="26" height="@height" class="fill-blue-500" rx="2"></rect>
                    }
                </svg>
                <div class="mt-2 flex justify-between text-xs">
                    @foreach (var day in _dailyUsage)
                    {
                        <span class="text-muted-foreground">@(day.Date.Substring(4))</span>
                    }
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="font-medium text-muted-foreground text-xs">Avg Cost per Request</p>
                    <p class="mt-1 tabular-nums text-sm">$@((_totalCost / _totalRequests).ToString("F4"))</p>
                    <p class="mt-0.5 text-red-600 text-xs">+8.5%</p>
                </div>
                <div>
                    <p class="font-medium text-muted-foreground text-xs">Monthly Budget</p>
                    <p class="mt-1 tabular-nums text-sm">$@(_totalCost.ToString("F0")) / $500</p>
                    <div class="mt-1 h-1 overflow-hidden rounded-full bg-muted">
                        <div class="h-full bg-blue-500" style="@($"width: {_totalCost / 500 * 100}%")"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ModelUsageItem(string Model, long InputTokens, long OutputTokens, double TotalCost, int Requests);
    private record DailyUsageItem(string Date, long Tokens, double Cost);

    private readonly ModelUsageItem[] _modelUsage =
    [
        new("GPT-4 Turbo", 2847000, 1234000, 142.5, 3421),
        new("GPT-3.5 Turbo", 8901000, 4567000, 28.9, 12847),
        new("Claude Sonnet", 1923000, 892000, 67.8, 2156),
        new("Claude Haiku", 5234000, 2341000, 12.3, 8934),
    ];

    private readonly DailyUsageItem[] _dailyUsage =
    [
        new("Jan 18", 892000, 24.5),
        new("Jan 19", 1023000, 28.1),
        new("Jan 20", 945000, 26.3),
        new("Jan 21", 1156000, 31.8),
        new("Jan 22", 1289000, 35.4),
        new("Jan 23", 1423000, 39.1),
        new("Jan 24", 1567000, 43.2),
    ];

    private long _totalInputTokens => _modelUsage.Sum(m => m.InputTokens);
    private long _totalOutputTokens => _modelUsage.Sum(m => m.OutputTokens);
    private double _totalCost => _modelUsage.Sum(m => m.TotalCost);
    private int _totalRequests => _modelUsage.Sum(m => m.Requests);
    private double _maxDailyCost => _dailyUsage.Max(d => d.Cost);

    private static string GetCostColor(double cost) => cost switch
    {
        > 100 => "bg-red-500",
        > 50 => "bg-amber-500",
        _ => "bg-emerald-500",
    };
}
