@* ============================================================
   Block: stats-half-donut-card
   Title: StatsHalfDonutCard
   Description: A half-circle donut breakdown stats card for React and Next.js with a 180-degree PieChart using startAngle and endAngle, var(--chart-N) segment fills, a centered total label, and legend pills below built with shadcn/ui ChartContainer and Tailwind CSS
   Source: original/blocks/stats/stats-half-donut-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Payment methods</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Gross volume · Last 30 days</p>
            </div>
            <div class="text-right">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Total
                </p>
                <p class="mt-0.5 text-sm font-semibold tabular-nums">
                    @FormatCurrency(_total)
                </p>
            </div>
        </div>

        <div class="relative px-4 pt-4">
            <div class="mx-auto aspect-[2/1] max-h-[180px] w-full">
                <svg viewBox="0 0 260 130" class="w-full h-full overflow-visible">
                    @{
                        var cx = 130.0;
                        var cy = 130.0;
                        var innerR = 70.0;
                        var outerR = 110.0;
                        var startDeg = 180.0;
                        var endDeg = 0.0;
                        var totalAngle = startDeg - endDeg; // 180 degrees

                        var currentAngle = startDeg;
                        foreach (var seg in _segments)
                        {
                            var segAngle = (seg.Value / (double)_total) * totalAngle;
                            var aStart = currentAngle;
                            var aEnd = currentAngle - segAngle;

                            var x1o = cx + outerR * Math.Cos(aStart * Math.PI / 180.0);
                            var y1o = cy + outerR * Math.Sin(aStart * Math.PI / 180.0);
                            var x2o = cx + outerR * Math.Cos(aEnd * Math.PI / 180.0);
                            var y2o = cy + outerR * Math.Sin(aEnd * Math.PI / 180.0);
                            var x1i = cx + innerR * Math.Cos(aEnd * Math.PI / 180.0);
                            var y1i = cy + innerR * Math.Sin(aEnd * Math.PI / 180.0);
                            var x2i = cx + innerR * Math.Cos(aStart * Math.PI / 180.0);
                            var y2i = cy + innerR * Math.Sin(aStart * Math.PI / 180.0);
                            var largeArc = segAngle > 180 ? "1" : "0";

                            var d = $"M {x1o.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} {y1o.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} " +
                                    $"A {outerR.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} {outerR.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} 0 {largeArc} 0 {x2o.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} {y2o.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} " +
                                    $"L {x1i.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} {y1i.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} " +
                                    $"A {innerR.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} {innerR.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} 0 {largeArc} 1 {x2i.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} {y2i.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)} Z";

                            currentAngle = aEnd;
                            <path d="@d" fill="@seg.Fill" stroke="hsl(var(--card))" stroke-width="2" />
                        }
                    }
                </svg>
            </div>
            <div class="pointer-events-none absolute inset-x-0 bottom-3 flex flex-col items-center">
                <p class="text-2xl font-semibold tabular-nums">@_segments.Length</p>
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Methods
                </p>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-x-4 gap-y-2 px-4 pb-4 pt-3 sm:grid-cols-4">
            @foreach (var seg in _segments)
            {
                var share = ((seg.Value / (double)_total) * 100).ToString("F1");
                <div class="flex min-w-0 items-start gap-2 rounded-md border bg-background px-2 py-2">
                    <span aria-hidden="true"
                          class="mt-1 size-2 shrink-0 rounded-full"
                          style="@($"background-color:{seg.Fill}")"></span>
                    <div class="min-w-0">
                        <div class="truncate text-xs font-medium">@seg.Label</div>
                        <div class="mt-0.5 text-xs text-muted-foreground tabular-nums">
                            @share% · @FormatCurrency(seg.Value)
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Segment(string Key, string Label, int Value, string Fill);

    private static readonly Segment[] _segments =
    [
        new("card",  "Credit card",   68_420, "oklch(0.646 0.222 41.116)"),
        new("ach",   "ACH transfer",  24_180, "oklch(0.6 0.118 184.704)"),
        new("wire",  "Wire transfer", 11_650, "oklch(0.398 0.07 227.392)"),
        new("other", "Other",          4_080, "oklch(0.828 0.189 84.429)"),
    ];

    private static readonly int _total = _segments.Sum(s => s.Value);

    private static string FormatCurrency(int value)
    {
        return "$" + value.ToString("N0");
    }
}
