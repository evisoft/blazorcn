@* ============================================================
   Block: stats-histogram-stacked-bins
   Title: StatsHistogramStackedBins
   Description: A stacked-bin histogram stats card for React and Next.js with bucketed BarChart bars subdivided by stackId into three request-size segments, a 180px fixed chart body, and ChartLegendContent pills built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-histogram-stacked-bins.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Response latency by size</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last hour · ms bucket</p>
            </div>
            <div class="text-right">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Requests
                </p>
                <p class="text-sm font-semibold tabular-nums">@_totalRequests.ToString("N0")</p>
            </div>
        </div>

        <div class="px-4 py-4">
            @{
                var maxTotal = _bins.Max(b => b.Small + b.Medium + b.Large);
                var chartH = 145;
                var barW = 22;
                var gap = 10;
                var paddingLeft = 36;
                var totalWidth = paddingLeft + _bins.Length * (barW + gap) - gap + 4;
                var gridLines = new[] { 0, 250, 500, 750, 1000, 1250, 1500, 1750, 2000 };
            }

            <div class="h-[180px] w-full overflow-hidden">
                <svg viewBox="@($"0 0 {totalWidth} {chartH + 30}")" width="100%" height="180" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Stacked histogram of response latency by request size">
                    @* Grid lines *@
                    @foreach (var gl in gridLines)
                    {
                        var y = chartH - (int)Math.Round((double)gl / maxTotal * chartH);
                        if (y >= 0 && y <= chartH)
                        {
                            @((MarkupString)$"<line x1=\"{paddingLeft}\" y1=\"{y}\" x2=\"{totalWidth}\" y2=\"{y}\" stroke=\"hsl(var(--border))\" stroke-dasharray=\"3 3\" />")
                        }
                    }

                    @* Y axis labels *@
                    @foreach (var gl in gridLines)
                    {
                        var y = chartH - (int)Math.Round((double)gl / maxTotal * chartH);
                        if (y >= 0 && y <= chartH && gl > 0)
                        {
                            @((MarkupString)$"<text x=\"{paddingLeft - 4}\" y=\"{y + 4}\" text-anchor=\"end\" font-size=\"9\" fill=\"hsl(var(--muted-foreground))\">{gl}</text>")
                        }
                    }

                    @* Stacked bars *@
                    @for (var i = 0; i < _bins.Length; i++)
                    {
                        var bin = _bins[i];
                        var x = paddingLeft + i * (barW + gap);
                        var total = bin.Small + bin.Medium + bin.Large;
                        var smallH = (int)Math.Round((double)bin.Small / maxTotal * chartH);
                        var mediumH = (int)Math.Round((double)bin.Medium / maxTotal * chartH);
                        var largeH = (int)Math.Round((double)bin.Large / maxTotal * chartH);

                        @* small segment (bottom) *@
                        @((MarkupString)$"<rect x=\"{x}\" y=\"{chartH - smallH}\" width=\"{barW}\" height=\"{smallH}\" fill=\"oklch(0.646 0.222 41.116)\" class=\"dark:fill-[oklch(0.488_0.243_264.376)]\" />")
                        @* medium segment *@
                        @((MarkupString)$"<rect x=\"{x}\" y=\"{chartH - smallH - mediumH}\" width=\"{barW}\" height=\"{mediumH}\" fill=\"oklch(0.6 0.118 184.704)\" class=\"dark:fill-[oklch(0.696_0.17_162.48)]\" />")
                        @* large segment (top, rounded corners) *@
                        @((MarkupString)$"<rect x=\"{x}\" y=\"{chartH - smallH - mediumH - largeH}\" width=\"{barW}\" height=\"{largeH}\" rx=\"2\" ry=\"2\" fill=\"oklch(0.398 0.07 227.392)\" class=\"dark:fill-[oklch(0.769_0.188_70.08)]\" />")

                        @* X axis label *@
                        @((MarkupString)$"<text x=\"{x + barW / 2}\" y=\"{chartH + 14}\" text-anchor=\"middle\" font-size=\"9\" fill=\"hsl(var(--muted-foreground))\">{bin.Bucket}</text>")
                    }
                </svg>
            </div>

            @* Legend *@
            <div class="mt-2 flex flex-wrap items-center justify-center gap-4">
                <div class="flex items-center gap-1.5">
                    <span class="inline-block h-2.5 w-2.5 rounded-sm" style="background-color: oklch(0.646 0.222 41.116);"></span>
                    <span class="text-xs text-muted-foreground">@("<")10 KB</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="inline-block h-2.5 w-2.5 rounded-sm" style="background-color: oklch(0.6 0.118 184.704);"></span>
                    <span class="text-xs text-muted-foreground">10-100 KB</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="inline-block h-2.5 w-2.5 rounded-sm" style="background-color: oklch(0.398 0.07 227.392);"></span>
                    <span class="text-xs text-muted-foreground">@(">")100 KB</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record HistogramBin(string Bucket, int Small, int Medium, int Large);

    private static readonly HistogramBin[] _bins =
    [
        new("0-50",    420,  80,  12),
        new("50-100",  680, 210,  24),
        new("100-150", 910, 380,  48),
        new("150-200",1120, 540,  92),
        new("200-250", 980, 680, 148),
        new("250-300", 740, 620, 186),
        new("300-400", 520, 480, 224),
        new("400-600", 310, 340, 198),
        new("600-900", 180, 220, 142),
        new("900+",     95, 140,  88),
    ];

    private static readonly int _totalRequests = _bins.Sum(b => b.Small + b.Medium + b.Large);
}
