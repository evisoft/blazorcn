@* ============================================================
   Block: stats-okr-target-cards
   Title: StatsOkrTargetCards
   Description: An OKR target stats card grid for React and Next.js with three objective tiles, nested key-result progress bars, threshold-aware bar colors, and an overall completion percentage per objective built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-okr-target-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="mb-3 flex items-end justify-between">
        <div>
            <p class="text-sm font-medium">Q2 2026 objectives</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Halfway through the quarter - 7 weeks remaining
            </p>
        </div>
        <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
            3 objectives - 9 key results
        </span>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
        @foreach (var objective in _objectives)
        {
            var completion = GetObjectiveCompletion(objective);
            <div class="overflow-hidden rounded-lg border bg-card">
                <div class="border-b px-4 py-3">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0">
                            <div class="flex items-center gap-1.5">
                                <LucideIconCn Name="target" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                                    @objective.Owner
                                </span>
                            </div>
                            <p class="mt-1 truncate text-sm font-medium">@objective.Title</p>
                        </div>
                        <span class="text-2xl font-semibold tabular-nums">
                            @completion<span class="text-base text-muted-foreground">%</span>
                        </span>
                    </div>
                </div>

                <div class="divide-y">
                    @foreach (var kr in objective.KeyResults)
                    {
                        var percent = GetPercent(kr);
                        var barColor = GetBarColor(percent);
                        <div class="px-4 py-3">
                            <div class="flex items-center justify-between gap-2">
                                <span class="min-w-0 truncate text-xs font-medium">@kr.Label</span>
                                <span class="shrink-0 text-[10px] text-muted-foreground tabular-nums">
                                    @kr.Current@kr.Unit / @kr.Target@kr.Unit
                                </span>
                            </div>
                            <div
                                aria-label="@kr.Label"
                                aria-valuemax="100"
                                aria-valuemin="0"
                                aria-valuenow="@percent"
                                class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted"
                                role="progressbar">
                                <div
                                    class="@(Cn.Merge("h-full rounded-full transition-all duration-700 ease-out", barColor))"
                                    style="@($"width:{percent}%")">
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record KeyResult(string Id, string Label, double Current, double Target, string Unit);
    private record Objective(string Id, string Title, string Owner, KeyResult[] KeyResults);

    private static readonly Objective[] _objectives =
    [
        new Objective("growth", "Accelerate revenue growth", "Growth team",
        [
            new KeyResult("mrr", "Reach $250K MRR", 187, 250, "K"),
            new KeyResult("signups", "Net new paid accounts", 312, 400, ""),
            new KeyResult("arpa", "Lift ARPA to $55", 43, 55, ""),
        ]),
        new Objective("product", "Ship AI assistant v2", "Product team",
        [
            new KeyResult("beta", "Beta enrollments", 1420, 1500, ""),
            new KeyResult("csat", "CSAT score on new UX", 72, 85, "%"),
            new KeyResult("latency", "Median response under 800ms", 620, 800, "ms"),
        ]),
        new Objective("reliability", "Hit four nines uptime", "Platform team",
        [
            new KeyResult("sla", "99.99% service availability", 99.94, 99.99, "%"),
            new KeyResult("incidents", "Critical incidents under 2", 3, 2, ""),
            new KeyResult("mttr", "MTTR below 15 min", 22, 15, "m"),
        ]),
    ];

    private static int GetPercent(KeyResult kr)
    {
        if (kr.Id == "incidents" || kr.Id == "mttr" || kr.Id == "latency")
        {
            var ratio = Math.Min(100.0, (kr.Target / kr.Current) * 100.0);
            return (int)Math.Round(ratio);
        }
        return (int)Math.Round(Math.Min(100.0, (kr.Current / kr.Target) * 100.0));
    }

    private static string GetBarColor(int percent)
    {
        if (percent < 40) return "bg-red-500/80";
        if (percent < 75) return "bg-amber-500/80";
        return "bg-emerald-500/80";
    }

    private static int GetObjectiveCompletion(Objective objective)
    {
        var total = objective.KeyResults.Sum(kr => GetPercent(kr));
        return (int)Math.Round((double)total / objective.KeyResults.Length);
    }
}
