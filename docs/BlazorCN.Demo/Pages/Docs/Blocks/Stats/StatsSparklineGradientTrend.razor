@* ============================================================
   Block: stats-sparkline-gradient-trend
   Title: StatsSparklineGradientTrend
   Description: A sparkline stats card grid for React and Next.js with trend-keyed emerald/red gradient fills, tabular-nums headline values, and ChartContainer-wrapped AreaChart sparklines built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-sparkline-gradient-trend.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var metric in _metrics)
        {
            var isUp = metric.Trend == "up";
            var color = isUp ? "oklch(0.68 0.17 152)" : "oklch(0.63 0.22 25)";
            var gradientId = $"spark-gradient-{metric.Id}";
            var trendIcon = isUp ? "trending-up" : "trending-down";
            var badgeClass = isUp
                ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                : "bg-red-500/10 text-red-600 dark:text-red-400";
            var deltaClass = isUp
                ? "text-emerald-600 dark:text-emerald-400"
                : "text-red-600 dark:text-red-400";

            var pts = metric.Data;
            var minVal = pts.Min(p => p.Value);
            var maxVal = pts.Max(p => p.Value);
            var range = maxVal - minVal;
            if (range == 0) { range = 1; }
            var svgWidth = 300.0;
            var svgHeight = 64.0;
            var stepX = svgWidth / (pts.Length - 1);

            var pointCoords = new (double X, double Y)[pts.Length];
            for (var i = 0; i < pts.Length; i++)
            {
                pointCoords[i] = (
                    i * stepX,
                    svgHeight - ((pts[i].Value - minVal) / range) * svgHeight
                );
            }

            var pathPoints = string.Join(" ", pointCoords.Select((c, i) =>
                i == 0 ? FormattableString.Invariant($"M {c.X:F1},{c.Y:F1}") : FormattableString.Invariant($"L {c.X:F1},{c.Y:F1}")));
            var areaPath = pathPoints
                + FormattableString.Invariant($" L {pointCoords[pts.Length - 1].X:F1},{svgHeight:F1}")
                + FormattableString.Invariant($" L {pointCoords[0].X:F1},{svgHeight:F1} Z");

            <div class="overflow-hidden rounded-lg border bg-card" key="@metric.Id">
                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <div class="truncate text-sm font-medium">@metric.Label</div>
                            <p class="mt-0.5 truncate text-xs text-muted-foreground">
                                @metric.Sublabel
                            </p>
                        </div>
                        <span class="@Cn.Merge("inline-flex shrink-0 items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium tabular-nums", badgeClass)">
                            <LucideIconCn Name="@trendIcon" Size="12" Class="size-3" />
                            @metric.DeltaPct
                        </span>
                    </div>

                    <div class="mt-2 flex items-baseline gap-2">
                        <div class="text-2xl font-semibold tabular-nums">@metric.Value</div>
                        <span class="@Cn.Merge("text-xs font-medium tabular-nums", deltaClass)">
                            @metric.Delta
                        </span>
                    </div>
                </div>

                <div class="h-16 w-full">
                    <svg viewBox="0 0 300 64" preserveAspectRatio="none" class="h-full w-full" aria-hidden="true">
                        <defs>
                            <linearGradient id="@gradientId" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="@color" stop-opacity="0.35" />
                                <stop offset="100%" stop-color="@color" stop-opacity="0" />
                            </linearGradient>
                        </defs>
                        <path d="@areaPath" fill="url(#@gradientId)" />
                        <path d="@pathPoints" fill="none" stroke="@color" stroke-width="1.75" />
                    </svg>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record SparkPoint(string Day, double Value);

    private record MetricCard(
        string Id,
        string Label,
        string Sublabel,
        string Value,
        string Delta,
        string DeltaPct,
        string Trend,
        SparkPoint[] Data);

