@* ========================================
   Block: stats-water-consumption
   Title: Stats Water Consumption
   Description: A water usage analytics dashboard tracking consumption by zone and source with daily volume, efficiency metrics, and conservation targets
   Dependencies: None
   Source: original/blocks/stats/stats-water-consumption.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Water Consumption</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Daily usage by zone</p>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Daily Volume</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@((_totalVolume / 1000.0).ToString("F1"))K</p>
                <p class="mt-0.5 text-xs text-emerald-600">-8.3% vs target</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Avg Efficiency</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_avgEfficiency.ToString("F0")%</p>
                <p class="mt-0.5 text-xs text-emerald-600">+4.2%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Daily Cost</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">$@((_totalCost / 1000.0).ToString("F1"))K</p>
                <p class="mt-0.5 text-xs text-red-600">+2.1%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Target</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_percentOfTarget.ToString("F0")%</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    of @((_conservationTarget / 1000).ToString("F0"))K gal
                </p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h3 class="text-sm font-medium">Usage by Zone</h3>
                <span class="text-xs text-muted-foreground">@_zones.Length zones</span>
            </div>
        </div>

        <div class="border-b">
            @for (var i = 0; i < _zones.Length; i++)
            {
                var zone = _zones[i];
                var isLast = i == _zones.Length - 1;
                var trendColor = zone.Trend switch { "up" => "bg-emerald-500", "down" => "bg-red-500", _ => "bg-blue-500" };
                var barColor = zone.Efficiency >= zone.Target ? "bg-emerald-500" : "bg-amber-500";
                <div class="@($"px-4 py-2.5 {(isLast ? "" : "border-b")}")">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@zone.Zone</span>
                                <span class="@($"h-1.5 w-1.5 shrink-0 rounded-full {trendColor}")"></span>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@zone.Purpose</p>
                            <div class="mt-1.5 grid grid-cols-3 gap-3">
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Volume</p>
                                    <p class="mt-0.5 text-sm tabular-nums">@zone.DailyVolume.ToString("N0") gal</p>
                                </div>
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Efficiency</p>
                                    <p class="mt-0.5 text-sm tabular-nums">@(zone.Efficiency)%</p>
                                </div>
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Target</p>
                                    <p class="mt-0.5 text-sm tabular-nums">@(zone.Target)%</p>
                                </div>
                            </div>
                            <div class="mt-1.5 h-1 overflow-hidden rounded-full bg-muted">
                                <div class="@($"h-full {barColor}")"
                                     style="@($"width: {zone.Efficiency}%")"></div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Water Sources</h3>
            <div class="mt-2 flex h-1.5 overflow-hidden rounded-full bg-muted">
                @foreach (var source in _sources)
                {
                    <div class="@($"h-full {source.Color}")"
                         style="@($"width: {source.Percentage}%")"></div>
                }
            </div>
            <div class="mt-3 space-y-2.5">
                @foreach (var source in _sources)
                {
                    <div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="@($"h-2 w-2 rounded-full {source.Color}")"></span>
                                <span class="text-sm">@source.Source</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-xs tabular-nums text-muted-foreground">
                                    @source.Volume.ToString("N0") gal
                                </span>
                                <span class="text-sm tabular-nums">
                                    @(source.Cost > 0 ? $"${source.Cost:F0}" : "Free")
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-xs font-medium text-muted-foreground">Conservation Savings</p>
                    <p class="mt-1 text-sm tabular-nums">@((_conservationTarget - _totalVolume).ToString("N0")) gal</p>
                    <p class="mt-0.5 text-xs text-emerald-600">
                        vs @((_conservationTarget / 1000).ToString("F0"))K target
                    </p>
                </div>
                <div>
                    <p class="text-xs font-medium text-muted-foreground">Sustainable Sources</p>
                    <p class="mt-1 text-sm tabular-nums">@_sustainablePercentage%</p>
                    <p class="mt-0.5 text-xs text-emerald-600">+5.2% this month</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ZoneUsage(string Zone, string Purpose, int DailyVolume, int Efficiency, int Target, string Trend);
    private record SourceData(string Source, int Volume, int Percentage, double Cost, string Color);

    private static readonly ZoneUsage[] _zones =
    [
        new("Building A", "Office & Restrooms", 2847, 92, 95, "up"),
        new("Building B", "Manufacturing", 8934, 78, 85, "down"),
        new("Landscaping", "Irrigation", 1523, 68, 75, "stable"),
        new("Cooling Systems", "HVAC", 4256, 85, 90, "up"),
    ];

    private static readonly SourceData[] _sources =
    [
        new("Municipal Water", 12456, 71, 1245.6, "bg-blue-500"),
        new("Rainwater Harvesting", 3234, 18, 0, "bg-emerald-500"),
        new("Recycled Greywater", 1870, 11, 187.0, "bg-amber-500"),
    ];

    private static readonly int _totalVolume = _zones.Sum(z => z.DailyVolume);
    private static readonly double _avgEfficiency = _zones.Average(z => (double)z.Efficiency);
    private static readonly double _totalCost = _sources.Sum(s => s.Cost);
    private const int _conservationTarget = 15000;
    private static readonly double _percentOfTarget = (double)_totalVolume / _conservationTarget * 100;
    private static readonly int _sustainablePercentage = _sources.Where(s => s.Source != "Municipal Water").Sum(s => s.Percentage);
}
