@* ========================================
   Block: stats-language-breakdown
   Title: Stats Language Breakdown
   Description: Codebase language distribution with line counts, file counts, and percentage breakdown
   Dependencies: None
   Source: original/blocks/stats/stats-language-breakdown.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Codebase Language Breakdown</h3>
            <p class="mt-0.5 text-muted-foreground text-xs">Repository composition analysis</p>
        </div>

        <div class="grid grid-cols-2 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Lines</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">
                    @_totalLines.ToString("N0")
                </p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Files</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">
                    @_totalFiles.ToString("N0")
                </p>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <div class="mb-3 flex h-4 overflow-hidden rounded-full bg-muted">
                @foreach (var lang in _languages)
                {
                    var percentage = (double)lang.Lines / _totalLines * 100;
                    <div class="@(Cn.Merge("h-full", lang.Color))"
                         style="width: @(percentage.ToString("F1"))%"
                         title="@lang.Name: @(percentage.ToString("F1"))%"></div>
                }
            </div>

            <div class="space-y-2.5">
                @foreach (var lang in _languages)
                {
                    var percentage = (double)lang.Lines / _totalLines * 100;

                    <div>
                        <div class="mb-1 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="@(Cn.Merge("size-2 rounded-full", lang.Color))"></span>
                                <span class="text-sm font-medium">@lang.Name</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-muted-foreground text-xs">@lang.Files files</span>
                                <span class="text-sm font-medium tabular-nums">
                                    @(percentage.ToString("F1"))%
                                </span>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                                <div class="@(Cn.Merge("h-full rounded-full", lang.Color))"
                                     style="width: @(percentage.ToString("F1"))%"></div>
                            </div>
                            <span class="text-muted-foreground text-xs tabular-nums">
                                @lang.Lines.ToString("N0")
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Language(string Name, int Lines, int Files, string Color);

    private static readonly Language[] _languages =
    [
        new("TypeScript", 45230, 342, "bg-blue-500"),
        new("CSS", 12480, 89, "bg-purple-500"),
        new("JavaScript", 8920, 124, "bg-amber-500"),
        new("JSON", 3450, 67, "bg-emerald-500"),
        new("Markdown", 2340, 45, "bg-slate-500"),
        new("YAML", 890, 23, "bg-red-500"),
    ];

    private static readonly int _totalLines = _languages.Sum(l => l.Lines);
    private static readonly int _totalFiles = _languages.Sum(l => l.Files);
}
