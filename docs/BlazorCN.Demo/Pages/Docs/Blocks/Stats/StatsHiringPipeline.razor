@* ========================================
   Block: stats-hiring-pipeline
   Title: Stats Hiring Pipeline
   Description: Recruitment funnel visualization showing applicants through hired stages with conversion rates
   Dependencies: None
   Source: original/blocks/stats/stats-hiring-pipeline.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Hiring Pipeline</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Candidate progression from application to hire
            </p>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Total Applicants</div>
                <div class="mt-1 text-2xl font-semibold tabular-nums">
                    @_stages[0].Candidates.ToString("N0")
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Hired</div>
                <div class="mt-1 text-2xl font-semibold tabular-nums text-emerald-500">
                    @_stages[6].Candidates
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Avg Time to Hire</div>
                <div class="mt-1 text-2xl font-semibold tabular-nums">
                    @_totalTimeToHire
                    <span class="ml-1 text-xs font-normal text-muted-foreground">days</span>
                </div>
            </div>
        </div>

        <div class="divide-y">
            @for (var i = 0; i < _stages.Length; i++)
            {
                var stage = _stages[i];
                var isFirst = i == 0;
                var hasHighDropOff = stage.DropOff > 50 && !isFirst;

                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@stage.Name</span>
                                @if (hasHighDropOff)
                                {
                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                }
                            </div>

                            <div class="mt-2 flex items-center gap-4">
                                <div>
                                    <div class="text-xs text-muted-foreground">Candidates</div>
                                    <div class="mt-0.5 text-xl font-semibold tabular-nums">
                                        @stage.Candidates
                                    </div>
                                </div>

                                @if (!isFirst)
                                {
                                    <div>
                                        <div class="text-xs text-muted-foreground">Conversion</div>
                                        <div class="mt-0.5 text-xl font-semibold tabular-nums text-emerald-500">
                                            @(stage.ConversionRate.ToString("F1"))%
                                        </div>
                                    </div>
                                    <div>
                                        <div class="text-xs text-muted-foreground">Drop-off</div>
                                        <div class="@(Cn.Merge("mt-0.5 text-xl font-semibold tabular-nums", hasHighDropOff ? "text-amber-500" : "text-muted-foreground"))">
                                            @(stage.DropOff.ToString("F1"))%
                                        </div>
                                    </div>
                                }

                                @if (stage.AvgTimeInStage > 0)
                                {
                                    <div>
                                        <div class="text-xs text-muted-foreground">Avg Time</div>
                                        <div class="mt-0.5 text-sm font-semibold tabular-nums">
                                            @(stage.AvgTimeInStage)d
                                        </div>
                                    </div>
                                }
                            </div>

                            @if (!isFirst)
                            {
                                <div class="mt-3">
                                    <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                        <div class="@(Cn.Merge("h-full rounded-full transition-all", stage.ConversionRate >= 70 ? "bg-emerald-500" : stage.ConversionRate >= 50 ? "bg-blue-500" : stage.ConversionRate >= 30 ? "bg-amber-500" : "bg-red-500"))"
                                             style="width: @(stage.ConversionRate.ToString("F1"))%"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-2.5">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Application-to-Hire Rate</span>
                <span class="font-medium tabular-nums">
                    @(((double)_stages[6].Candidates / _stages[0].Candidates * 100).ToString("F2"))%
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record PipelineStage(string Name, int Candidates, double ConversionRate, int AvgTimeInStage, double DropOff);

    private static readonly PipelineStage[] _stages =
    [
        new("Applications", 1240, 100, 0, 0),
        new("Resume Screen", 310, 25.0, 2, 75.0),
        new("Phone Screen", 186, 60.0, 5, 40.0),
        new("Technical Interview", 93, 50.0, 7, 50.0),
        new("Final Interview", 37, 40.0, 4, 60.0),
        new("Offer Extended", 25, 67.6, 3, 32.4),
        new("Hired", 22, 88.0, 14, 12.0),
    ];

    private static readonly int _totalTimeToHire = _stages.Sum(s => s.AvgTimeInStage);
}
