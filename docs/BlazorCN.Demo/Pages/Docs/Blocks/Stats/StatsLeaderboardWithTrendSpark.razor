@* ============================================================
   Block: stats-leaderboard-with-trend-spark
   Title: StatsLeaderboardWithTrendSpark
   Description: A ranked leaderboard stats card for React and Next.js with monospace rank numbers, entity labels, inline h-8 ChartContainer sparklines showing per-row recent trend, and tabular-nums score columns built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-leaderboard-with-trend-spark.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Top products by revenue</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 10 days</p>
            </div>
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                6 products
            </p>
        </div>

        <ol class="divide-y">
            @foreach (var entry in _entries)
            {
                var isUp = entry.Direction == "up";
                var trendClasses = isUp
                    ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                    : "bg-red-500/10 text-red-600 dark:text-red-400";
                var iconName = isUp ? "trending-up" : "trending-down";
                var sparkPoints = BuildSparkPolyline(entry.Series, 80, 32);
                var sparkArea = BuildSparkArea(entry.Series, 80, 32);
                var strokeColor = "oklch(0.646 0.222 41.116)";

                <li class="flex items-center gap-3 px-4 py-3">
                    <span class="w-6 shrink-0 font-mono text-xs text-muted-foreground tabular-nums">
                        @entry.Rank.ToString().PadLeft(2, '0')
                    </span>
                    <div class="min-w-0 flex-1">
                        <p class="truncate text-sm font-medium">@entry.Label</p>
                        <p class="mt-0.5 truncate text-xs text-muted-foreground">@entry.Category</p>
                    </div>
                    <div class="h-8 w-20 shrink-0">
                        <svg viewBox="0 0 80 32" preserveAspectRatio="none" class="h-full w-full" aria-hidden="true">
                            <defs>
                                <linearGradient id="@($"lb-spark-{entry.Id}")" x1="0" x2="0" y1="0" y2="1">
                                    <stop offset="0%" stop-color="@strokeColor" stop-opacity="0.35" />
                                    <stop offset="100%" stop-color="@strokeColor" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                            <path d="@sparkArea" fill="@($"url(#lb-spark-{entry.Id})")" />
                            <polyline points="@sparkPoints" fill="none" stroke="@strokeColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round" />
                        </svg>
                    </div>
                    <div class="flex w-24 shrink-0 flex-col items-end gap-0.5">
                        <span class="text-sm font-semibold tabular-nums">@entry.Score</span>
                        <span class="@Cn.Merge("inline-flex items-center gap-0.5 rounded-full px-1.5 py-0.5 text-[10px] font-medium tabular-nums", trendClasses)">
                            <LucideIconCn Name="@iconName" Size="10" Class="size-2.5" aria-hidden="true" />
                            @entry.Delta
                        </span>
                    </div>
                </li>
            }
        </ol>
    </div>
</section>

@code {
    private record SparkPoint(int Day, int Value);
    private record LeaderEntry(string Id, int Rank, string Label, string Category, string Score, string Delta, string Direction, SparkPoint[] Series);

    private static readonly LeaderEntry[] _entries =
    [
        new("pro", 1, "Acme Pro", "Workspace", "$84,120", "+18.2%", "up",
        [
            new(1, 62), new(2, 66), new(3, 64), new(4, 71), new(5, 78),
            new(6, 82), new(7, 89), new(8, 92), new(9, 97), new(10, 100),
        ]),
        new("teams", 2, "Acme Teams", "Workspace", "$61,480", "+9.4%", "up",
        [
            new(1, 54), new(2, 58), new(3, 61), new(4, 60), new(5, 66),
            new(6, 71), new(7, 70), new(8, 74), new(9, 78), new(10, 82),
        ]),
        new("starter", 3, "Acme Starter", "Self-serve", "$38,920", "+4.1%", "up",
        [
            new(1, 48), new(2, 50), new(3, 52), new(4, 51), new(5, 53),
            new(6, 54), new(7, 55), new(8, 56), new(9, 57), new(10, 58),
        ]),
        new("solo", 4, "Acme Solo", "Self-serve", "$22,140", "-2.3%", "down",
        [
            new(1, 60), new(2, 59), new(3, 58), new(4, 57), new(5, 56),
            new(6, 54), new(7, 53), new(8, 52), new(9, 51), new(10, 50),
        ]),
        new("legacy", 5, "Acme Legacy", "Archived", "$14,860", "-6.8%", "down",
        [
            new(1, 70), new(2, 68), new(3, 66), new(4, 62), new(5, 60),
            new(6, 56), new(7, 54), new(8, 50), new(9, 48), new(10, 44),
        ]),
        new("free", 6, "Acme Free", "Self-serve", "$0", "0.0%", "up",
        [
            new(1, 30), new(2, 32), new(3, 30), new(4, 31), new(5, 30),
            new(6, 32), new(7, 31), new(8, 30), new(9, 31), new(10, 30),
        ]),
    ];

    private static string BuildSparkPolyline(SparkPoint[] series, double width, double height)
    {
        if (series.Length == 0) return "";
        var minVal = 0.0;
        var maxVal = series.Max(p => (double)p.Value);
        if (maxVal <= minVal) maxVal = minVal + 1;
        var step = width / (series.Length - 1);
        var parts = new System.Text.StringBuilder();
        for (var i = 0; i < series.Length; i++)
        {
            var x = i * step;
            var y = height - (series[i].Value - minVal) / (maxVal - minVal) * (height - 4) - 2;
            if (i > 0) parts.Append(' ');
            parts.Append($"{x:F1},{y:F1}");
        }
        return parts.ToString();
    }

    private static string BuildSparkArea(SparkPoint[] series, double width, double height)
    {
        if (series.Length == 0) return "";
        var minVal = 0.0;
        var maxVal = series.Max(p => (double)p.Value);
        if (maxVal <= minVal) maxVal = minVal + 1;
        var step = width / (series.Length - 1);
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < series.Length; i++)
        {
            var x = i * step;
            var y = height - (series[i].Value - minVal) / (maxVal - minVal) * (height - 4) - 2;
            sb.Append(i == 0 ? $"M{x:F1},{y:F1}" : $" L{x:F1},{y:F1}");
        }
        sb.Append($" L{width:F1},{height:F1} L0,{height:F1} Z");
        return sb.ToString();
    }
}
