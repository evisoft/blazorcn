@* ============================================================
   Block: stats-hero-metric-with-delta-arrow
   Title: StatsHeroMetricWithDeltaArrow
   Description: A hero metric stats card for React and Next.js with an oversized semantically-colored trend arrow, NumberFlow animated headline number, tabular-nums delta pill, and a clean vertical layout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-hero-metric-with-delta-arrow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-5 py-5 sm:px-6 sm:py-6">
            <div class="flex items-center justify-between gap-4">
                <div>
                    <p class="text-sm font-medium">@_metric.Label</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_metric.Timeframe</p>
                </div>
                <span aria-hidden="true"
                      class="inline-flex size-12 shrink-0 items-center justify-center rounded-lg bg-emerald-500/10">
                    <LucideIconCn Name="trending-up" Size="28" StrokeWidth="2"
                                  Class="size-7 text-emerald-600 dark:text-emerald-400" />
                </span>
            </div>

            <div class="mt-6 flex items-end gap-4">
                <div class="min-w-[200px]">
                    <span class="text-4xl font-semibold tabular-nums text-foreground">
                        @FormatCurrency(_metric.Value)
                    </span>
                </div>
            </div>

            <div class="mt-3 flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                    @(_isPositive ? "+" : "")@(_metric.Delta.ToString("F1"))%
                </span>
                <span class="text-xs tabular-nums text-muted-foreground">
                    +$@(_deltaAbs.ToString("N0")) vs March
                </span>
            </div>
        </div>

        <div class="grid grid-cols-2 divide-x border-t">
            <div class="px-5 py-3">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Previous
                </p>
                <p class="mt-0.5 text-sm font-semibold tabular-nums">
                    $@(_metric.Previous.ToString("N0"))
                </p>
            </div>
            <div class="px-5 py-3">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Net change
                </p>
                <p class="mt-0.5 text-sm font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                    +$@(_deltaAbs.ToString("N0"))
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record HeroMetric(
        string Label,
        string Timeframe,
        int Value,
        int Previous,
        double Delta,
        string ChangeType,
        string Unit
    );

    private static readonly HeroMetric _metric = new(
        Label: "Monthly recurring revenue",
        Timeframe: "April 2026",
        Value: 842_340,
        Previous: 748_120,
        Delta: 12.6,
        ChangeType: "positive",
        Unit: "currency"
    );

    private bool _isPositive => _metric.ChangeType == "positive";
    private int _deltaAbs => _metric.Value - _metric.Previous;

    private static string FormatCurrency(int value)
    {
        return "$" + value.ToString("N0");
    }
}
