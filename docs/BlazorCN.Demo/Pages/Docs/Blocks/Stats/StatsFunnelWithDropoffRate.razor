@* ============================================================
   Block: stats-funnel-with-dropoff-rate
   Title: StatsFunnelWithDropoffRate
   Description: A vertical funnel stats card for React and Next.js with proportional width bars per stage, prominent amber and red drop-off percentages beside each row, tabular-nums counts, and an overall conversion summary header built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-funnel-with-dropoff-rate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Signup-to-paid funnel</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days, five stages</p>
            </div>
            <div class="text-right">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Overall
                </p>
                <p class="mt-0.5 text-sm font-semibold tabular-nums">@overallConversion%</p>
            </div>
        </div>

        <ol class="px-4 py-2">
            @for (var i = 0; i < _stages.Length; i++)
            {
                var stage = _stages[i];
                var barWidth = (double)stage.Count / _top * 100;
                var prev = i == 0 ? (FunnelStage?)null : _stages[i - 1];
                var dropoff = prev == null ? (double?)null : ((double)(prev.Value.Count - stage.Count) / prev.Value.Count) * 100;
                var severity = dropoff == null ? DropoffSeverity.Low : GetSeverity(dropoff.Value);

                <li class="py-3">
                    <div class="flex items-baseline justify-between gap-3">
                        <p class="text-sm font-medium">@stage.Name</p>
                        <p class="text-sm font-semibold tabular-nums">
                            @stage.Count.ToString("N0")
                        </p>
                    </div>

                    <div class="mt-2 flex items-center gap-3">
                        <div aria-valuemax="@_top"
                             aria-valuemin="0"
                             aria-valuenow="@stage.Count"
                             class="h-2 flex-1 overflow-hidden rounded-full bg-muted"
                             role="progressbar">
                            <div class="h-full rounded-full bg-foreground transition-[width] duration-700 ease-out"
                                 style="@($"width:{barWidth:F2}%")">
                            </div>
                        </div>
                        @if (dropoff != null)
                        {
                            <span class="@Cn.Merge("inline-flex shrink-0 items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium tabular-nums", SeverityBgClass(severity), SeverityTextClass(severity))">
                                <LucideIconCn Name="arrow-down" Size="12" Class="size-3" aria-hidden="true" />
                                @(dropoff.Value.ToString("F1"))%
                            </span>
                        }
                    </div>
                </li>
            }
        </ol>
    </div>
</section>

@code {
    private record struct FunnelStage(string Id, string Name, int Count);

    private enum DropoffSeverity { Low, Medium, High }

    private static readonly FunnelStage[] _stages =
    [
        new("visit",     "Landing page views",        48_200),
        new("signup",    "Sign-up started",            18_340),
        new("verified",  "Email verified",             12_850),
        new("activated", "First workspace created",    7_640),
        new("paid",      "Upgraded to paid",           1_420),
    ];

    private static readonly int _top = _stages[0].Count;

    private static readonly string overallConversion =
        ((double)_stages[^1].Count / _stages[0].Count * 100).ToString("F2");

    private static DropoffSeverity GetSeverity(double dropoff)
    {
        if (dropoff >= 55) return DropoffSeverity.High;
        if (dropoff >= 30) return DropoffSeverity.Medium;
        return DropoffSeverity.Low;
    }

    private static string SeverityTextClass(DropoffSeverity severity) => severity switch
    {
        DropoffSeverity.High   => "text-red-600 dark:text-red-400",
        DropoffSeverity.Medium => "text-amber-600 dark:text-amber-400",
        _                      => "text-muted-foreground",
    };

    private static string SeverityBgClass(DropoffSeverity severity) => severity switch
    {
        DropoffSeverity.High   => "bg-red-500/10",
        DropoffSeverity.Medium => "bg-amber-500/10",
        _                      => "bg-muted/60",
    };
}
