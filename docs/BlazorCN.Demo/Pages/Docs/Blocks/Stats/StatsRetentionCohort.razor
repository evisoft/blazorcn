@* ========================================
   Block: stats-retention-cohort
   Title: Stats Retention Cohort
   Description: User retention stats with cohort period bars, retention rates, and drop-off tracking for React product analytics dashboards
   Long Description: A software release tracking component displaying version numbers, bug fixes, features, and breaking changes for Next.js developer tools and SaaS applications
   Dependencies: None
   Source: original/blocks/stats/stats-retention-cohort.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Retention</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @cohortMonth cohort &middot; @cohortSize users
                </p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-semibold tabular-nums">@currentRetention%</p>
                <p class="mt-0.5 text-xs text-muted-foreground">at 6 months</p>
            </div>
        </div>

        @* Retention bars *@
        <div>
            @for (var i = 0; i < periods.Length; i++)
            {
                var period = periods[i];
                var isLast = i == periods.Length - 1;

                <div class="@(Cn.Merge("px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <div class="flex items-center justify-between text-sm">
                        <span class="font-medium">@period.Label</span>
                        <div class="flex items-center gap-3">
                            <span class="text-xs text-muted-foreground">@period.Users</span>
                            <span class="w-10 text-right font-semibold tabular-nums">
                                @period.Rate%
                            </span>
                        </div>
                    </div>
                    <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full transition-all", period.Rate >= 50 ? "bg-emerald-500" : period.Rate >= 25 ? "bg-amber-500" : "bg-red-500"))"
                             style="width: @(period.Rate)%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record RetentionPeriod(string Label, int Rate, string Users);

    private const string cohortSize = "2,450";
    private const string cohortMonth = "January 2025";

    private static readonly RetentionPeriod[] periods = new[]
    {
        new RetentionPeriod("Week 1", 100, "2,450"),
        new RetentionPeriod("Week 2", 68, "1,666"),
        new RetentionPeriod("Week 4", 45, "1,103"),
        new RetentionPeriod("Week 8", 32, "784"),
        new RetentionPeriod("Week 12", 28, "686"),
        new RetentionPeriod("Week 24", 22, "539"),
    };

    private static readonly int currentRetention = periods[^1].Rate;
}
