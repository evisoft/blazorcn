@* ========================================
   Block: stats-usage-limits
   Title: Stats Usage Limits
   Description: Usage metrics cards with limits, progress bars, warnings, and action buttons
   Dependencies: ButtonCn, DialogCn, DialogContentCn, DialogDescriptionCn, DialogFooterCn, DialogHeaderCn, DialogTitleCn, InputCn, LabelCn, LucideSettingsCn
   Source: original/blocks/stats/stats-usage-limits.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @* Commands *@
        <div class="flex flex-col overflow-hidden rounded-lg border bg-card">
            <div class="flex-1 px-4 py-3">
                <div class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                    Commands
                </div>
                <div class="mt-2 flex items-baseline gap-1.5">
                    <div class="text-2xl font-semibold tabular-nums text-foreground">13.8M</div>
                    <span class="text-xs text-muted-foreground">/ Unlimited</span>
                </div>
                <div class="mt-4 space-y-3">
                    <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="absolute left-0 h-full bg-emerald-500 transition-all duration-300"
                             style="width: 81.6%"></div>
                        <div class="absolute h-full bg-blue-500 transition-all duration-300"
                             style="left: 81.6%; width: 18.4%"></div>
                    </div>
                    <div class="space-y-2 pt-2">
                        <div class="flex items-center text-xs text-muted-foreground">
                            <span class="mr-2 h-2 w-2 rounded-full bg-emerald-500"></span>
                            <span class="flex-1">Writes</span>
                            <span class="tabular-nums text-foreground">11,276,493</span>
                        </div>
                        <div class="flex items-center text-xs text-muted-foreground">
                            <span class="mr-2 h-2 w-2 rounded-full bg-blue-500"></span>
                            <span class="flex-1">Reads</span>
                            <span class="tabular-nums text-foreground">2,548,921</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="border-t">
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Class="h-10 w-full justify-start gap-2 rounded-none text-xs font-medium">
                    Upgrade
                </ButtonCn>
            </div>
        </div>

        @* Bandwidth *@
        <div class="flex flex-col overflow-hidden rounded-lg border bg-card">
            <div class="flex-1 px-4 py-3">
                <div class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                    Bandwidth
                </div>
                <div class="mt-2 flex items-baseline gap-1.5">
                    <div class="text-2xl font-semibold tabular-nums text-foreground">141 GB</div>
                    <span class="text-xs text-muted-foreground">/ 150 GB</span>
                </div>
                <div class="mt-4 space-y-3">
                    <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-amber-500 transition-all duration-300"
                             style="width: 94%"></div>
                    </div>
                    <p class="text-xs text-amber-600 dark:text-amber-400">
                        Approaching limit. Overage charges may apply.
                    </p>
                </div>
            </div>
            <div class="border-t">
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Class="h-10 w-full justify-start gap-2 rounded-none text-xs font-medium">
                    Upgrade
                </ButtonCn>
            </div>
        </div>

        @* Storage *@
        <div class="flex flex-col overflow-hidden rounded-lg border bg-card">
            <div class="flex-1 px-4 py-3">
                <div class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                    Storage
                </div>
                <div class="mt-2 flex items-baseline gap-1.5">
                    <div class="text-2xl font-semibold tabular-nums text-foreground">37 GB</div>
                    <span class="text-xs text-muted-foreground">/ 500 GB</span>
                </div>
                <div class="mt-4 space-y-3">
                    <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-emerald-500 transition-all duration-300"
                             style="width: 7.4%"></div>
                    </div>
                    <p class="text-xs text-emerald-600 dark:text-emerald-400">
                        Plenty of room available
                    </p>
                </div>
            </div>
            <div class="border-t">
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Class="h-10 w-full justify-start gap-2 rounded-none text-xs font-medium">
                    Upgrade
                </ButtonCn>
            </div>
        </div>

        @* Cost *@
        <div class="flex flex-col overflow-hidden rounded-lg border bg-card">
            <div class="flex-1 px-4 py-3">
                <div class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                    Cost
                </div>
                <div class="mt-2 flex items-baseline gap-1.5">
                    <div class="text-2xl font-semibold tabular-nums text-foreground">$73.42</div>
                    <span class="text-xs text-muted-foreground">/ $150 Budget</span>
                </div>
                <div class="mt-4 space-y-3">
                    <div class="relative h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-emerald-500 transition-all duration-300"
                             style="width: 48.95%"></div>
                    </div>
                    <p class="text-xs text-emerald-600 dark:text-emerald-400">Within budget</p>
                </div>
            </div>
            <div class="border-t">
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Class="h-10 w-full justify-start gap-2 rounded-none text-xs font-medium"
                          OnClick="@(() => _budgetDialogOpen = true)">
                    <LucideSettingsCn Size="14" Class="h-3.5 w-3.5" />
                    Change Budget
                </ButtonCn>
            </div>
        </div>
    </div>

    <DialogCn @bind-Open="_budgetDialogOpen">
        <DialogContentCn Class="sm:max-w-md">
            <DialogHeaderCn>
                <DialogTitleCn>Update budget</DialogTitleCn>
                <DialogDescriptionCn>
                    Set a maximum monthly budget. We'll notify you when you reach the limit.
                </DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="space-y-2 py-2">
                <LabelCn For="budget">Max budget per month</LabelCn>
                <InputCn id="budget" Type="number" Placeholder="150" @bind-Value="_budget" />
            </div>

            <DialogFooterCn>
                <ButtonCn Variant="ButtonVariant.Outline" OnClick="@(() => _budgetDialogOpen = false)">
                    Cancel
                </ButtonCn>
                <ButtonCn OnClick="@(() => _budgetDialogOpen = false)">
                    Update
                </ButtonCn>
            </DialogFooterCn>
        </DialogContentCn>
    </DialogCn>
</section>

@code {
    private bool _budgetDialogOpen;
    private string _budget = "150";
}
