@* ========================================
   Block: stats-roi-calculator
   Title: Stats Roi Calculator
   Description: An investment ROI calculator component displaying cost, revenue, net gain, payback period, and ROI percentage
   Dependencies: None
   Source: original/blocks/stats/stats-roi-calculator.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-medium">@_investment.Name</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">Started @_investment.StartDate</p>
                </div>
                <div class="text-right">
                    <div class="@($"text-2xl font-semibold tabular-nums {(_isPositiveRoi ? "text-emerald-500" : "text-red-500")}")">
                        @(_roi > 0 ? "+" : "")@_roi.ToString("F1")%
                    </div>
                    <p class="text-xs text-muted-foreground">ROI</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-sm font-medium">Net Gain</span>
                <span class="@($"text-2xl font-semibold tabular-nums {(_isPositiveRoi ? "text-emerald-500" : "text-red-500")}")">
                    @(_netGain > 0 ? "+" : "")$@((_netGain / 1000.0).ToString("F1"))K
                </span>
            </div>
            <div class="space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Total Revenue</span>
                    <span class="text-xs font-semibold tabular-nums">
                        $@((_investment.Revenue / 1000.0).ToString("F1"))K
                    </span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">Total Cost</span>
                    <span class="text-xs font-semibold tabular-nums">
                        $@((_investment.Cost / 1000.0).ToString("F1"))K
                    </span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="mb-1.5 flex items-center justify-between">
                    <span class="text-sm font-medium">Revenue/Month</span>
                    <span class="@($"h-2 w-2 rounded-full {(_isHighRoi ? "bg-emerald-500" : "bg-blue-500")}")"></span>
                </div>
                <div class="text-2xl font-semibold tabular-nums">
                    $@((_investment.MonthlyRevenue / 1000.0).ToString("F1"))K
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">Average per month</p>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="mb-1.5 flex items-center justify-between">
                    <span class="text-sm font-medium">Payback Period</span>
                    <span class="@($"h-2 w-2 rounded-full {(_paybackMonths <= 3 ? "bg-emerald-500" : _paybackMonths <= 6 ? "bg-amber-500" : "bg-red-500")}")"></span>
                </div>
                <div class="text-2xl font-semibold tabular-nums">@_paybackMonths.ToString("F1")</div>
                <p class="mt-0.5 text-xs text-muted-foreground">months to break even</p>
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="mb-2 text-xs font-medium text-muted-foreground">Investment Breakdown</div>
            <div class="space-y-2">
                <div>
                    <div class="mb-1 flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Cost Recovery</span>
                        <span class="text-xs font-semibold tabular-nums">
                            @_costRecovery.ToString("F0")%
                        </span>
                    </div>
                    <div class="h-1 overflow-hidden rounded-full bg-muted">
                        <div class="@($"h-full rounded-full transition-all {(_isPositiveRoi ? "bg-emerald-500" : "bg-red-500")}")"
                             style="@($"width: {Math.Min(_costRecovery, 100)}%")"></div>
                    </div>
                </div>
                <div>
                    <div class="mb-1 flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Profit Margin</span>
                        <span class="text-xs font-semibold tabular-nums">
                            @_profitMargin.ToString("F1")%
                        </span>
                    </div>
                    <div class="h-1 overflow-hidden rounded-full bg-muted">
                        <div class="@($"h-full rounded-full transition-all {(_isPositiveRoi ? "bg-blue-500" : "bg-red-500")}")"
                             style="@($"width: {Math.Min(Math.Abs(_profitMargin), 100)}%")"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record InvestmentData(string Name, int Cost, int Revenue, int MonthlyRevenue, string StartDate);

    private static readonly InvestmentData _investment = new("Q1 Marketing Campaign", 48500, 127300, 42433, "3 months ago");

    private static readonly int _netGain = _investment.Revenue - _investment.Cost;
    private static readonly double _roi = (double)_netGain / _investment.Cost * 100;
    private static readonly double _paybackMonths = (double)_investment.Cost / _investment.MonthlyRevenue;
    private static readonly bool _isPositiveRoi = _roi > 0;
    private static readonly bool _isHighRoi = _roi >= 100;
    private static readonly double _costRecovery = (double)_investment.Revenue / _investment.Cost * 100;
    private static readonly double _profitMargin = (double)_netGain / _investment.Revenue * 100;
}
