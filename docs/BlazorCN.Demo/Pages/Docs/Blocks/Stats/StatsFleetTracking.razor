@* ========================================
   Block: stats-fleet-tracking
   Title: Stats Fleet Tracking
   Description: Vehicle fleet status dashboard with active/idle/maintenance counts, fuel efficiency metrics, and mileage tracking
   Dependencies: None
   Source: original/blocks/stats/stats-fleet-tracking.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Fleet Status</h3>
            <p class="mt-0.5 text-muted-foreground text-xs">@_totalVehicles vehicles tracked</p>
        </div>

        <div class="border-b px-4 py-4">
            <div class="space-y-3">
                @foreach (var item in _vehicleStatuses)
                {
                    var percentage = (double)item.Count / _totalVehicles * 100;

                    <div>
                        <div class="mb-1.5 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="@(Cn.Merge("size-2 rounded-full", item.Color))"></span>
                                <span class="text-sm capitalize">@item.Status</span>
                            </div>
                            <span class="tabular-nums text-sm font-medium">@item.Count vehicles</span>
                        </div>
                        <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                            <div class="@(Cn.Merge("h-full rounded-full", item.Color))"
                                 style="width: @(percentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="grid grid-cols-2 gap-px border-b bg-border">
            @foreach (var metric in _fleetMetrics)
            {
                <div class="bg-card px-4 py-3">
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums">@metric.Value</span>
                        <span class="text-muted-foreground text-xs">@metric.Unit</span>
                    </div>
                    <div class="mt-1 flex items-center gap-1">
                        <span class="@(Cn.Merge("text-xs", metric.Trend > 0 ? "text-emerald-600" : metric.Trend < 0 ? "text-red-600" : "text-muted-foreground"))">
                            @(metric.Trend > 0 ? "+" : "")@(metric.Trend)%
                        </span>
                        <span class="text-muted-foreground text-xs">vs last month</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record VehicleStatus(string Status, int Count, string Color);
    private record FleetMetric(string Label, string Value, string Unit, double Trend);

    private static readonly VehicleStatus[] _vehicleStatuses =
    [
        new("active", 42, "bg-emerald-500"),
        new("idle", 18, "bg-amber-500"),
        new("maintenance", 5, "bg-red-500"),
    ];

    private static readonly int _totalVehicles = _vehicleStatuses.Sum(s => s.Count);

    private static readonly FleetMetric[] _fleetMetrics =
    [
        new("Avg Fuel Efficiency", "28.4", "MPG", 2.1),
        new("Total Mileage", "1.2M", "miles", 4.5),
        new("Active Routes", "34", "routes", -1.2),
        new("Utilization Rate", "78", "%", 3.8),
    ];
}
