@* ============================================================
   Block: stats-leaderboard-compact-list
   Title: StatsLeaderboardCompactList
   Description: An ultra-compact leaderboard stats card for React and Next.js with 12 tightly-spaced ranked rows, mono rank column, tabular-nums values, and minimal chrome built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-leaderboard-compact-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-md p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Top products</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 7 days · Sales</p>
            </div>
            <p class="text-sm font-semibold tabular-nums">@FormatCurrency(_total)</p>
        </div>

        <ol class="divide-y">
            @foreach (var entry in _entries)
            {
                var index = System.Array.IndexOf(_entries, entry);
                <li class="flex items-center gap-3 px-4 py-2">
                    <span aria-hidden="true"
                          class="w-5 shrink-0 text-right font-mono text-xs text-muted-foreground tabular-nums">
                        @((index + 1).ToString("D2"))
                    </span>
                    <span class="min-w-0 flex-1 truncate text-sm font-medium" title="@entry.Name">
                        @entry.Name
                    </span>
                    <span class="shrink-0 text-sm font-semibold tabular-nums">
                        @FormatCurrency(entry.Value)
                    </span>
                </li>
            }
        </ol>
    </div>
</section>

@code {
    private record LeaderEntry(string Id, string Name, int Value);

    private static readonly LeaderEntry[] _entries =
    [
        new("vault",     "Acme Vault Pro",   14280),
        new("studio",    "Acme Studio",      11940),
        new("teams",     "Acme Teams",        9620),
        new("analytics", "Acme Analytics",    8740),
        new("flow",      "Acme Flow",         7310),
        new("commerce",  "Acme Commerce",     6185),
        new("inbox",     "Acme Inbox",        5420),
        new("notes",     "Acme Notes",        4060),
        new("compass",   "Acme Compass",      3845),
        new("signal",    "Acme Signal",       2970),
        new("beacon",    "Acme Beacon",       2140),
        new("solo",      "Acme Solo",         1620),
    ];

    private static readonly int _total = System.Linq.Enumerable.Sum(_entries, e => e.Value);

    private static string FormatCurrency(int value) =>
        value.ToString("C0", new System.Globalization.CultureInfo("en-US"));
}
