@* ============================================================
   Block: stats-stacked-donut-card
   Title: StatsStackedDonutCard
   Description: A concentric dual-ring donut stats card for React and Next.js with two stacked Pie components at different radii, outer subcategory ring, inner high-level grouping ring, and a pill legend built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-stacked-donut-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Revenue by region</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Q1 2026 · 2 regions · 6 countries
                </p>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full bg-muted px-2 py-0.5 text-xs font-medium text-muted-foreground">
                $2.4M total
            </span>
        </div>

        <div class="relative px-4 py-4">
            <div class="mx-auto aspect-square max-h-[220px] w-full">
                <svg viewBox="0 0 220 220" class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
                    @* Inner ring: innerRadius=42%, outerRadius=62% of 110 (half of 220) *@
                    @foreach (var arc in _innerArcs)
                    {
                        @((MarkupString)arc)
                    }
                    @* Outer ring: innerRadius=70%, outerRadius=95% of 110 *@
                    @foreach (var arc in _outerArcs)
                    {
                        @((MarkupString)arc)
                    }
                    @* Center text *@
                    @((MarkupString)$"<text x=\"110\" y=\"104\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-size=\"22\" font-weight=\"600\" class=\"tabular-nums\" fill=\"currentColor\">{_totalValue}%</text>")
                    @((MarkupString)"<text x=\"110\" y=\"124\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-size=\"8\" font-weight=\"500\" letter-spacing=\"3\" fill=\"currentColor\" opacity=\"0.5\">GLOBAL</text>")
                </svg>
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Inner · regions
            </p>
            <dl class="mt-2 grid grid-cols-2 gap-2">
                @foreach (var seg in _innerData)
                {
                    <div class="flex items-center justify-between gap-2 rounded-md bg-muted/50 px-2.5 py-1.5">
                        <dt class="flex min-w-0 items-center gap-2">
                            <span aria-hidden="true" class="size-2 shrink-0 rounded-sm" style="@($"background:{seg.Fill}")"></span>
                            <span class="truncate text-xs font-medium">@seg.Label</span>
                        </dt>
                        <dd class="text-xs font-semibold tabular-nums">@(seg.Value)%</dd>
                    </div>
                }
            </dl>
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Outer · countries
            </p>
            <dl class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-3">
                @foreach (var seg in _outerData)
                {
                    <div class="flex items-center justify-between gap-2 rounded-md bg-muted/50 px-2.5 py-1.5">
                        <dt class="flex min-w-0 items-center gap-2">
                            <span aria-hidden="true" class="size-2 shrink-0 rounded-full" style="@($"background:{seg.Fill}")"></span>
                            <span class="truncate text-xs font-medium">@seg.Label</span>
                        </dt>
                        <dd class="text-xs font-semibold tabular-nums">@(seg.Value)%</dd>
                    </div>
                }
            </dl>
        </div>
    </div>
</section>

@code {
    private record Segment(string Key, string Label, int Value, string Fill);

    private static readonly Segment[] _innerData =
    [
        new("americas", "Americas", 58, "oklch(0.646 0.222 41.116)"),
        new("emea",     "EMEA",     42, "oklch(0.6 0.118 184.704)"),
    ];

    private static readonly Segment[] _outerData =
    [
        new("us", "United States",  34, "oklch(0.646 0.222 41.116)"),
        new("ca", "Canada",         14, "oklch(0.398 0.07 227.392)"),
        new("br", "Brazil",         10, "oklch(0.828 0.189 84.429)"),
        new("uk", "United Kingdom", 18, "oklch(0.6 0.118 184.704)"),
        new("de", "Germany",        14, "oklch(0.769 0.188 70.08)"),
        new("fr", "France",         10, "oklch(0.398 0.07 227.392)"),
    ];

    private static readonly int _totalValue = _innerData.Sum(s => s.Value);

    // SVG arc path helpers
    private static readonly string[] _innerArcs = BuildArcs(_innerData, cx: 110, cy: 110, innerR: 46.2, outerR: 68.2, gap: 1.5);
    private static readonly string[] _outerArcs = BuildArcs(_outerData, cx: 110, cy: 110, innerR: 77.0, outerR: 104.5, gap: 1.0);

    private static string[] BuildArcs(Segment[] segments, double cx, double cy, double innerR, double outerR, double gap)
    {
        double total = segments.Sum(s => s.Value);
        var paths = new System.Collections.Generic.List<string>();
        double startAngle = -Math.PI / 2; // start at top

        foreach (var seg in segments)
        {
            double sweep = (seg.Value / total) * 2 * Math.PI;
            // apply tiny gap by shrinking the sweep slightly
            double gapRad = gap * Math.PI / 180.0;
            double halfGap = gapRad / 2;
            double a1 = startAngle + halfGap;
            double a2 = startAngle + sweep - halfGap;

            double x1o = cx + outerR * Math.Cos(a1);
            double y1o = cy + outerR * Math.Sin(a1);
            double x2o = cx + outerR * Math.Cos(a2);
            double y2o = cy + outerR * Math.Sin(a2);
            double x2i = cx + innerR * Math.Cos(a2);
            double y2i = cy + innerR * Math.Sin(a2);
            double x1i = cx + innerR * Math.Cos(a1);
            double y1i = cy + innerR * Math.Sin(a1);

            int largeArc = (sweep - gapRad) > Math.PI ? 1 : 0;

            string d = $"M {F(x1o)} {F(y1o)} A {F(outerR)} {F(outerR)} 0 {largeArc} 1 {F(x2o)} {F(y2o)} L {F(x2i)} {F(y2i)} A {F(innerR)} {F(innerR)} 0 {largeArc} 0 {F(x1i)} {F(y1i)} Z";
            paths.Add($"<path d=\"{d}\" fill=\"{seg.Fill}\" stroke=\"white\" stroke-width=\"2\" />");

            startAngle += sweep;
        }

        return paths.ToArray();
    }

    private static string F(double v) => v.ToString("F3", System.Globalization.CultureInfo.InvariantCulture);
}
