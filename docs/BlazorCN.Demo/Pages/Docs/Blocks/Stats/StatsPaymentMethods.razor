@* ========================================
   Block: stats-payment-methods
   Title: Stats Payment Methods
   Description: A payment method breakdown component displaying transaction counts, success rates, and revenue for different payment types in Next.js e-commerce applications
   Long Description: Category breakdown visualization
   Dependencies: None
   Source: original/blocks/stats/stats-payment-methods.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-medium">Payment Methods</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days</p>
                </div>
                <div class="text-right">
                    <div class="text-2xl font-semibold tabular-nums">
                        $@((totalRevenue / 1000).ToString("F0"))K
                    </div>
                    <p class="text-xs text-muted-foreground">Total Revenue</p>
                </div>
            </div>
        </div>

        <div>
            @for (var i = 0; i < paymentData.Length; i++)
            {
                var item = paymentData[i];
                var isLast = i == paymentData.Length - 1;
                var percentage = (double)item.Revenue / totalRevenue * 100;
                var isHighSuccess = item.SuccessRate >= 98;
                var isLowSuccess = item.SuccessRate < 95;

                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                    <div class="mb-2 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@item.Method</span>
                            <span class="@(Cn.Merge("size-1.5 rounded-full", isHighSuccess ? "bg-emerald-500" : isLowSuccess ? "bg-amber-500" : "bg-blue-500"))"></span>
                        </div>
                        <span class="text-sm font-semibold tabular-nums">
                            $@(((double)item.Revenue / 1000).ToString("F1"))K
                        </span>
                    </div>

                    <div class="mb-2 h-1 overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-foreground transition-all"
                             style="width: @(percentage.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>

                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <div class="text-xs text-muted-foreground">Transactions</div>
                            <div class="mt-0.5 text-xs font-semibold tabular-nums">
                                @item.Transactions.ToString("N0")
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-muted-foreground">Success Rate</div>
                            <div class="mt-0.5 text-xs font-semibold tabular-nums">
                                @(item.SuccessRate.ToString("F1"))%
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-muted-foreground">Avg Amount</div>
                            <div class="mt-0.5 text-xs font-semibold tabular-nums">
                                $@(item.AvgAmount.ToString("F2"))
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="grid grid-cols-2 gap-px border-t bg-border">
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Total Transactions</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">
                    @totalTransactions.ToString("N0")
                </div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Overall Success</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">
                    @(overallSuccessRate.ToString("F1"))%
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record PaymentMethod(string Method, int Transactions, double SuccessRate, int Revenue, double AvgAmount);

    private static readonly PaymentMethod[] paymentData = new[]
    {
        new PaymentMethod("Credit Card", 3421, 97.2, 428600, 125.3),
        new PaymentMethod("PayPal", 1845, 98.5, 183200, 99.35),
        new PaymentMethod("Bank Transfer", 567, 94.8, 142800, 251.94),
        new PaymentMethod("Cryptocurrency", 234, 99.1, 67400, 288.03),
    };

    private static readonly int totalRevenue = paymentData.Sum(p => p.Revenue);
    private static readonly int totalTransactions = paymentData.Sum(p => p.Transactions);
    private static readonly double overallSuccessRate =
        paymentData.Sum(p => p.SuccessRate * p.Transactions) / totalTransactions;
}
