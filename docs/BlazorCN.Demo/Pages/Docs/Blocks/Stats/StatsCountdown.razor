@* ========================================
   Block: stats-countdown
   Title: Stats Countdown
   Description: Countdown timer stats with days/hours/minutes/seconds display and event details
   Dependencies: None
   Source: original/blocks/stats/stats-countdown.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Product Launch</p>
            <p class="mt-0.5 text-xs text-muted-foreground">January 15, 2025</p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-center gap-2">
                @foreach (var unit in _timeUnits)
                {
                    if (unit != _timeUnits[0])
                    {
                        <span class="mb-5 text-lg text-muted-foreground">:</span>
                    }
                    <div class="text-center">
                        <div class="min-w-[52px] rounded-md bg-muted px-3 py-2">
                            <span class="text-2xl font-semibold tabular-nums">
                                @unit.Value.ToString("D2")
                            </span>
                        </div>
                        <p class="mt-1 text-[10px] uppercase tracking-wide text-muted-foreground">@unit.Label</p>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-primary transition-all"
                     style="@($"width: {_progress:F0}%")"></div>
            </div>
            <div class="mt-1.5 flex justify-between text-xs text-muted-foreground">
                <span>@((int)Math.Round(_progress))% elapsed</span>
                <span>@_days days left</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record TimeUnit(int Value, string Label);

    private const int _days = 12;
    private const int _totalDays = 30;
    private static readonly double _progress = (double)(_totalDays - _days) / _totalDays * 100;

    private static readonly TimeUnit[] _timeUnits =
    [
        new(12, "Days"),
        new(8, "Hours"),
        new(42, "Mins"),
        new(15, "Secs"),
    ];
}
