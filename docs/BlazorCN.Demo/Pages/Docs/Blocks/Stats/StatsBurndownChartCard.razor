@* ============================================================
   Block: stats-burndown-chart-card
   Title: StatsBurndownChartCard
   Description: A sprint burndown chart stats card for React and Next.js with Recharts LineChart showing ideal diagonal and actual progress lines, shaded gap area between ideal and actual, NumberFlow animated remaining points, and a sprint days X-axis built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-burndown-chart-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Sprint burndown</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Sprint 24 · Day 14 of 14</p>
            </div>
            <div class="text-right">
                <div class="min-w-[60px]">
                    <span class="text-2xl font-semibold tabular-nums">@_remaining</span>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">points remaining</p>
                @if (_isBehind)
                {
                    <span class="inline-flex rounded-full bg-amber-500/10 px-2 py-0.5 text-[10px] font-medium text-amber-600 dark:text-amber-400">
                        Behind schedule
                    </span>
                }
            </div>
        </div>
        <div class="px-4 py-4">
            <div class="h-[200px] w-full">
                <svg viewBox="0 0 420 200" class="h-full w-full" preserveAspectRatio="none">
                    <title>Sprint burndown showing ideal vs actual progress</title>
                    @* Horizontal grid lines *@
                    @foreach (var yVal in _gridYValues)
                    {
                        var yPx = ScaleY(yVal).ToString(System.Globalization.CultureInfo.InvariantCulture);
                        <line x1="35" x2="420" y1="@yPx" y2="@yPx" stroke="var(--border)" stroke-dasharray="3 3" />
                    }
                    @* Y-axis tick labels — rendered as MarkupString to avoid Razor SVG text attribute bug *@
                    @foreach (var yVal in _gridYValues)
                    {
                        var yPx = ScaleY(yVal);
                        @((MarkupString)FormattableString.Invariant($"<text x=\"30\" y=\"{yPx + 4}\" text-anchor=\"end\" font-size=\"11\" fill=\"var(--muted-foreground)\">{yVal}</text>"))
                    }
                    @* X-axis tick labels *@
                    @foreach (var pt in _burndownData)
                    {
                        var xPx = ScaleX(pt.Day);
                        @((MarkupString)FormattableString.Invariant($"<text x=\"{xPx}\" y=\"195\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--muted-foreground)\">{pt.Day}</text>"))
                    }
                    @* Shaded gap area between ideal and actual *@
                    <polygon points="@_gapPolygonPoints" fill="var(--chart-2)" fill-opacity="0.08" />
                    @* Ideal line — dashed *@
                    <polyline points="@_idealPoints" fill="none" stroke="var(--chart-2)" stroke-width="1.5" stroke-dasharray="6 4" />
                    @* Actual line *@
                    <polyline points="@_actualPoints" fill="none" stroke="var(--chart-1)" stroke-width="2" />
                </svg>
            </div>
        </div>
        <div class="flex items-center gap-4 border-t px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                <span class="h-px w-4 border-t-2 border-dashed" style="border-color: var(--chart-2)"></span>
                <span class="text-xs text-muted-foreground">Ideal</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="h-px w-4 border-t-2" style="border-color: var(--chart-1)"></span>
                <span class="text-xs text-muted-foreground">Actual</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record BurndownPoint(int Day, int Ideal, int Actual);

    private static readonly BurndownPoint[] _burndownData =
    [
        new(1,  80, 80),
        new(2,  74, 78),
        new(3,  69, 72),
        new(4,  63, 65),
        new(5,  57, 60),
        new(6,  51, 52),
        new(7,  46, 48),
        new(8,  40, 42),
        new(9,  34, 35),
        new(10, 29, 30),
        new(11, 23, 28),
        new(12, 17, 22),
        new(13, 11, 18),
        new(14,  0, 12),
    ];

    private static readonly int[] _gridYValues = [0, 20, 40, 60, 80];

    // Chart area: x from 35 to 415, y from 10 to 180 (leaving room for labels)
    private const double _xMin = 35;
    private const double _xMax = 415;
    private const double _yMin = 10;
    private const double _yMax = 180;
    private const int _totalPoints = 80;

    private double ScaleX(int day)
    {
        // day 1..14 mapped to _xMin.._xMax
        var t = (double)(day - 1) / (_burndownData.Length - 1);
        return _xMin + t * (_xMax - _xMin);
    }

    private double ScaleY(int value)
    {
        // 0 at bottom (_yMax), _totalPoints at top (_yMin)
        var t = (double)value / _totalPoints;
        return _yMax - t * (_yMax - _yMin);
    }

    private int _remaining => _burndownData[^1].Actual;
    private int _idealRemaining => _burndownData[^1].Ideal;
    private bool _isBehind => _remaining > _idealRemaining;

    private string _idealPoints => string.Join(" ", _burndownData.Select(p => FormattableString.Invariant($"{ScaleX(p.Day):F1},{ScaleY(p.Ideal):F1}")));
    private string _actualPoints => string.Join(" ", _burndownData.Select(p => FormattableString.Invariant($"{ScaleX(p.Day):F1},{ScaleY(p.Actual):F1}")));

    // Polygon: ideal forward + actual reversed to fill the gap between ideal and actual
    private string _gapPolygonPoints
    {
        get
        {
            var fwd = _burndownData.Select(p => FormattableString.Invariant($"{ScaleX(p.Day):F1},{ScaleY(p.Ideal):F1}"));
            var rev = _burndownData.Reverse().Select(p => FormattableString.Invariant($"{ScaleX(p.Day):F1},{ScaleY(p.Actual):F1}"));
            return string.Join(" ", fwd.Concat(rev));
        }
    }
}
