@* ========================================
   Block: stats-donation-tracker
   Title: Stats Donation Tracker
   Description: Fundraising campaign progress with goal tracking, donor count, average donation, and recurring vs one-time contributions
   Dependencies: None
   Source: original/blocks/stats/stats-donation-tracker.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Annual Fundraising Campaign</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Education Initiative 2026 &#x2022; @_campaign.DonorCount donors
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-baseline justify-between">
                <div>
                    <div class="text-xs text-muted-foreground">Campaign Progress</div>
                    <div class="mt-1 flex items-baseline gap-2">
                        <span class="text-2xl font-semibold tabular-nums">
                            $@((_campaign.Raised / 1000.0).ToString("F1"))K
                        </span>
                        <span class="text-sm text-muted-foreground">
                            of $@((_campaign.Goal / 1000))K goal
                        </span>
                    </div>
                </div>
                <div class="text-right">
                    <div class="text-2xl font-semibold tabular-nums text-emerald-600">
                        @_progressPercentage.ToString("F1")%
                    </div>
                    <div class="text-xs text-muted-foreground">
                        $@((_remaining / 1000.0).ToString("F1"))K to go
                    </div>
                </div>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-muted">
                <div class="h-full bg-emerald-500" style="width: @(_progressPercentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
            </div>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Donors</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@_campaign.DonorCount</span>
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Avg Donation</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">
                        $@((int)_averageDonation)
                    </span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Recurring</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">
                        @((int)_recurringPercentage)
                    </span>
                    <span class="text-xs text-muted-foreground">%</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 text-xs font-medium text-muted-foreground">Donation Type Breakdown</div>
            <div class="space-y-2.5">
                <div>
                    <div class="mb-1 flex items-center justify-between text-xs">
                        <span class="flex items-center gap-1.5">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            <span class="text-muted-foreground">Recurring Monthly</span>
                        </span>
                        <span class="font-medium tabular-nums">
                            $@((_campaign.Recurring / 1000.0).ToString("F1"))K (@((int)_recurringPercentage)%)
                        </span>
                    </div>
                    <div class="h-1 overflow-hidden rounded-full bg-muted">
                        <div class="h-full bg-emerald-500" style="width: @(_recurringPercentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                </div>
                <div>
                    <div class="mb-1 flex items-center justify-between text-xs">
                        <span class="flex items-center gap-1.5">
                            <span class="size-1.5 rounded-full bg-blue-500"></span>
                            <span class="text-muted-foreground">One-Time Gifts</span>
                        </span>
                        <span class="font-medium tabular-nums">
                            $@((_campaign.OneTime / 1000.0).ToString("F1"))K (@((int)(100 - _recurringPercentage))%)
                        </span>
                    </div>
                    <div class="h-1 overflow-hidden rounded-full bg-muted">
                        <div class="h-full bg-blue-500" style="width: @((100 - _recurringPercentage).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 text-xs font-medium text-muted-foreground">Donation Distribution</div>
            <div class="space-y-2">
                @foreach (var range in _donationBreakdown)
                {
                    var percentage = (double)range.Total / _campaign.Raised * 100;

                    <div>
                        <div class="mb-1 flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">@range.Range</span>
                            <span class="font-medium tabular-nums">
                                @range.Count donors &#x00B7; $@((range.Total / 1000.0).ToString("F1"))K
                            </span>
                        </div>
                        <div class="h-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full bg-foreground" style="width: @(percentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-3">
                <div class="text-xs font-medium text-muted-foreground">Recent Major Donors</div>
            </div>
            <div>
                @for (var i = 0; i < _topDonors.Length; i++)
                {
                    var donor = _topDonors[i];

                    <div class="@(Cn.Merge("px-4 py-2.5", i < _topDonors.Length - 1 ? "border-b" : ""))">
                        <div class="flex items-center justify-between">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@donor.Name</span>
                                    <span class="@(Cn.Merge("size-1.5 rounded-full", donor.Type == "recurring" ? "bg-emerald-500" : "bg-blue-500"))"></span>
                                </div>
                                <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                    <span class="capitalize">@donor.Type</span>
                                    <span>&#x2022;</span>
                                    <span>@donor.Date</span>
                                </div>
                            </div>
                            <div class="ml-4 text-right">
                                <div class="text-sm font-medium tabular-nums">
                                    $@donor.Amount.ToString("N0")
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record CampaignData(int Goal, int Raised, int DonorCount, int Recurring, int OneTime);
    private record Donor(string Name, int Amount, string Type, string Date);
    private record DonationRange(string Range, int Count, int Total);

    private static readonly CampaignData _campaign = new(50000, 38420, 284, 18640, 19780);

    private static readonly Donor[] _topDonors =
    [
        new("Sarah Mitchell", 5000, "one-time", "2 days ago"),
        new("Tech Foundation", 3500, "recurring", "1 week ago"),
        new("John Anderson", 2800, "one-time", "3 days ago"),
        new("Community Fund", 2500, "recurring", "5 days ago"),
        new("Anonymous", 2000, "one-time", "Yesterday"),
    ];

    private static readonly DonationRange[] _donationBreakdown =
    [
        new("$1,000+", 12, 18200),
        new("$500-999", 24, 16800),
        new("$100-499", 86, 18640),
        new("$1-99", 162, 4780),
    ];

    private static readonly double _progressPercentage = (double)_campaign.Raised / _campaign.Goal * 100;
    private static readonly double _averageDonation = (double)_campaign.Raised / _campaign.DonorCount;
    private static readonly double _recurringPercentage = (double)_campaign.Recurring / _campaign.Raised * 100;
    private static readonly int _remaining = _campaign.Goal - _campaign.Raised;
}