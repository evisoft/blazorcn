@* ============================================================
   Block: stats-pipeline-stage-strip
   Title: StatsPipelineStageStrip
   Description: A horizontal pipeline stats card for React and Next.js with five connected chevron-shaped stages showing deal flow progression, width-proportional stage widths by count, gradient-darkening colors toward final stage, and NumberFlow animated stage values built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-pipeline-stage-strip.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Sales pipeline</p>
                <p class="mt-0.5 text-xs text-muted-foreground">@_totalCount.ToString("N0") active deals</p>
            </div>
            <div class="min-w-[120px] text-right">
                <p class="text-2xl font-semibold tabular-nums">@FormatCompactCurrency(_totalValue)</p>
                <p class="text-xs text-muted-foreground">Pipeline value</p>
            </div>
        </div>
        <div class="px-4 py-4">
            <div class="flex gap-1">
                @foreach (var stage in _stages)
                {
                    <div class="flex-1 overflow-hidden rounded-md px-3 py-2.5 text-background"
                         style="@(FormattableString.Invariant($"background-color: color-mix(in oklch, var(--chart-1) {stage.Darkness * 100}%, transparent); clip-path: polygon(0 0, calc(100% - 12px) 0, 100% 50%, calc(100% - 12px) 100%, 0 100%, 12px 50%);"))"
                         aria-label="@($"{stage.Label}: {stage.Count} deals worth ${(stage.Value / 1000.0):F0}k")" role="img">
                        <p class="text-[10px] font-medium uppercase tracking-widest opacity-90">@stage.Label</p>
                        <p class="mt-1 text-sm font-semibold tabular-nums">@stage.Count</p>
                        <p class="text-[10px] tabular-nums opacity-90">$@((stage.Value / 1000.0).ToString("F0"))k</p>
                    </div>
                }
            </div>
        </div>
        <div class="border-t px-4 py-2.5">
            <div class="flex justify-between text-[10px] text-muted-foreground tabular-nums">
                @for (int i = 0; i < _stages.Length; i++)
                {
                    var idx = i;
                    var conversion = idx > 0 ? ((double)_stages[idx].Count / _stages[idx - 1].Count * 100).ToString("F0") : null;
                    <div class="flex-1 text-center">
                        @if (conversion != null)
                        {
                            <span>↓ @(conversion)%</span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record PipelineStage(string Id, string Label, int Count, int Value, double Darkness);

    private static readonly PipelineStage[] _stages =
    [
        new("lead", "Lead", 420, 1_260_000, 0.2),
        new("qualified", "Qualified", 168, 672_000, 0.4),
        new("proposal", "Proposal", 64, 384_000, 0.6),
        new("negotiation", "Negotiation", 28, 224_000, 0.8),
        new("closed", "Closed Won", 12, 120_000, 1.0),
    ];

    private static readonly int _totalValue = 0 + 1_260_000 + 672_000 + 384_000 + 224_000 + 120_000;
    private static readonly int _totalCount = 420 + 168 + 64 + 28 + 12;

    private static string FormatCompactCurrency(int value)
    {
        if (value >= 1_000_000)
            return $"${(value / 1_000_000.0).ToString("F1")}M";
        if (value >= 1_000)
            return $"${(value / 1_000.0).ToString("F1")}K";
        return $"${value}";
    }
}
