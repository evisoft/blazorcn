@* ============================================================
   Block: stats-log-frequency-table
   Title: StatsLogFrequencyTable
   Description: A log level frequency table stats card for React and Next.js with monospace level labels, tabular-nums total counts, events-per-minute columns, and inline relative frequency bars tinted by semantic severity built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-log-frequency-table.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Log frequency by level</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Last 15 minutes, ingest-pipeline-prod
                </p>
            </div>
            <div class="text-right">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Total
                </p>
                <p class="mt-0.5 text-sm font-semibold tabular-nums">
                    @_totalCount.ToString("N0")
                </p>
            </div>
        </div>

        <table class="w-full">
            <thead>
                <tr class="border-b text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    <th class="px-4 py-2 text-left font-medium" scope="col">
                        Level
                    </th>
                    <th class="px-2 py-2 text-right font-medium" scope="col">
                        Count
                    </th>
                    <th class="px-2 py-2 text-right font-medium" scope="col">
                        Ev/min
                    </th>
                    <th class="px-4 py-2 text-right font-medium" scope="col">
                        Frequency
                    </th>
                </tr>
            </thead>
            <tbody class="divide-y">
                @foreach (var lvl in _levels)
                {
                    var barWidth = (double)lvl.Count / _maxCount * 100;
                    <tr>
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-2">
                                <span aria-hidden="true" class="@(Cn.Merge("size-1.5 rounded-full", SeverityDotClass(lvl.Severity)))"></span>
                                <code class="@(Cn.Merge("font-mono text-xs font-medium", SeverityTextClass(lvl.Severity)))">
                                    @lvl.Level
                                </code>
                            </div>
                        </td>
                        <td class="px-2 py-3 text-right text-sm font-semibold tabular-nums">
                            @lvl.Count.ToString("N0")
                        </td>
                        <td class="px-2 py-3 text-right text-xs tabular-nums text-muted-foreground">
                            @lvl.PerMinute.ToString("F1")
                        </td>
                        <td class="px-4 py-3">
                            <div aria-label="@($"{lvl.Level} log frequency")"
                                 aria-valuemax="@_maxCount"
                                 aria-valuemin="0"
                                 aria-valuenow="@lvl.Count"
                                 class="ml-auto h-1.5 w-24 overflow-hidden rounded-full bg-muted"
                                 role="progressbar">
                                <div class="@(Cn.Merge("h-full rounded-full transition-[width] duration-700 ease-out", SeverityBarClass(lvl.Severity)))"
                                     style="@(FormattableString.Invariant($"width:{barWidth:F1}%"))">
                                </div>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    private enum Severity { Critical, Warning, Info, Debug, Trace }

    private record LogLevel(string Id, string Level, Severity Severity, int Count, double PerMinute);

    private static readonly LogLevel[] _levels =
    [
        new("error", "ERROR", Severity.Critical, 1284,  8.9),
        new("warn",  "WARN",  Severity.Warning,  6742,  46.8),
        new("info",  "INFO",  Severity.Info,     42310, 293.8),
        new("debug", "DEBUG", Severity.Debug,    18056, 125.3),
        new("trace", "TRACE", Severity.Trace,    3928,  27.2),
    ];

    private static readonly int _totalCount = _levels.Sum(l => l.Count);
    private static readonly int _maxCount   = _levels.Max(l => l.Count);

    private static string SeverityDotClass(Severity s) => s switch
    {
        Severity.Critical => "bg-red-500",
        Severity.Warning  => "bg-amber-500",
        Severity.Info     => "bg-blue-500",
        Severity.Debug    => "bg-muted-foreground/60",
        Severity.Trace    => "bg-muted-foreground/40",
        _                 => ""
    };

    private static string SeverityTextClass(Severity s) => s switch
    {
        Severity.Critical => "text-red-600 dark:text-red-400",
        Severity.Warning  => "text-amber-600 dark:text-amber-400",
        Severity.Info     => "text-blue-600 dark:text-blue-400",
        Severity.Debug    => "text-muted-foreground",
        Severity.Trace    => "text-muted-foreground",
        _                 => ""
    };

    private static string SeverityBarClass(Severity s) => s switch
    {
        Severity.Critical => "bg-red-500/70",
        Severity.Warning  => "bg-amber-500/70",
        Severity.Info     => "bg-blue-500/70",
        Severity.Debug    => "bg-muted-foreground/50",
        Severity.Trace    => "bg-muted-foreground/40",
        _                 => ""
    };
}
