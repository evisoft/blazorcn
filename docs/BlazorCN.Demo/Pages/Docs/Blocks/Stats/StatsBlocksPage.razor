            new(11, 18), new(12, 18),
        ]),
    ];

    private static string FormatValue(Metric metric)
    {
        return metric.Format switch
        {
            MetricFormat.Currency => ""$"" + ((long)metric.Value).ToString(""N0""),
            MetricFormat.Percent => metric.Value.ToString(""F2""),
            MetricFormat.Number => ((long)metric.Value).ToString(""N0""),
            MetricFormat.Duration => ((long)metric.Value).ToString(""N0""),
            _ => metric.Value.ToString()
        };
    }

    private static string BuildSparklinePath(SparklinePoint[] series, double width, double height)
    {
        if (series.Length == 0) return """";
        var minV = double.MaxValue;
        var maxV = double.MinValue;
        foreach (var p in series) { if (p.V < minV) minV = p.V; if (p.V > maxV) maxV = p.V; }
        var range = maxV - minV;
        if (range == 0) range = 1;
        var pad = height * 0.1;
        var usableH = height - pad * 2;
        var xStep = width / (series.Length - 1);
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < series.Length; i++)
        {
            var x = i * xStep;
            var y = pad + usableH * (1 - (series[i].V - minV) / range);
            sb.Append(i == 0 ? $""M {x:F1} {y:F1}"" : $"" L {x:F1} {y:F1}"");
        }
        return sb.ToString();
    }

    private static string BuildSparklineFill(SparklinePoint[] series, double width, double height)
    {
        if (series.Length == 0) return """";
        var linePath = BuildSparklinePath(series, width, height);
        return $""{linePath} L {width:F1} {height:F1} L 0 {height:F1} Z"";
    }
}
";

