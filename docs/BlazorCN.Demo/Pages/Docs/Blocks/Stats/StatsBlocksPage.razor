    private static readonly LabelPoint[] _labelPoints =
    [
        new(""2026-04-01"", ""Apr 1""),
        new(""2026-04-04"", ""Apr 4""),
        new(""2026-04-07"", ""Apr 7""),
        new(""2026-04-10"", ""Apr 10""),
        new(""2026-04-12"", ""Apr 12""),
    ];

    private static readonly int _minLatency = 0;
    private static readonly int _maxLatency = 430;

    private double ValueToY(double value)
    {
        var ratio = 1.0 - (value - _minLatency) / (_maxLatency - _minLatency);
        return _plotTop + ratio * _plotHeight;
    }

    private double DateToX(string date)
    {
        // Map date string to an index among the 12 data points
        var idx = System.Array.FindIndex(_chartData, d => d.Date == date);
        if (idx < 0) idx = 0;
        var step = (_plotRight - _plotLeft) / (_chartData.Length - 1);
        return _plotLeft + idx * step;
    }

    private string _linePath
    {
        get
        {
            var sb = new System.Text.StringBuilder();
            for (var i = 0; i < _chartData.Length; i++)
            {
                var x = DateToX(_chartData[i].Date);
                var y = ValueToY(_chartData[i].Latency);
                sb.Append(i == 0 ? $""M{x:F1},{y:F1}"" : $"" L{x:F1},{y:F1}"");
            }
            return sb.ToString();
        }
    }

    private string _areaPath
    {
        get
        {
            var sb = new System.Text.StringBuilder();
            for (var i = 0; i < _chartData.Length; i++)
            {
                var x = DateToX(_chartData[i].Date);
                var y = ValueToY(_chartData[i].Latency);
                sb.Append(i == 0 ? $""M{x:F1},{y:F1}"" : $"" L{x:F1},{y:F1}"");
            }
            // Close down to baseline
            var lastX = DateToX(_chartData[_chartData.Length - 1].Date);
            var firstX = DateToX(_chartData[0].Date);
            sb.Append($"" L{lastX:F1},{_plotBottom:F1} L{firstX:F1},{_plotBottom:F1} Z"");
            return sb.ToString();
        }
    }
}";

