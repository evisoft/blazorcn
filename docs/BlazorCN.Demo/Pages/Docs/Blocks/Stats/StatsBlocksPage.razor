                    @((MarkupString)$""<line x1=\""{refX:F1}\"" y1=\""8\"" x2=\""{refX:F1}\"" y2=\""208\"" stroke=\""var(--border)\"" stroke-dasharray=\""4 4\"" stroke-width=\""1.5\"" />"")

