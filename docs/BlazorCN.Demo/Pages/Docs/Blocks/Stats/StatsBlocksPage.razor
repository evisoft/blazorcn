        new ModuleCoverage(""utils"", ""src/lib/utils"", 186, 194, 42, 46, 28, 30, 38, 0),
    };

    private static readonly int totalLines = coverageData.Sum(m => m.LinesTotal);
    private static readonly int totalLinesCovered = coverageData.Sum(m => m.LinesCovered);
    private static readonly int totalBranches = coverageData.Sum(m => m.BranchesTotal);
    private static readonly int totalBranchesCovered = coverageData.Sum(m => m.BranchesCovered);
    private static readonly int totalFunctions = coverageData.Sum(m => m.FunctionsTotal);
    private static readonly int totalFunctionsCovered = coverageData.Sum(m => m.FunctionsCovered);
    private static readonly int totalTestsPassed = coverageData.Sum(m => m.TestsPassed);
    private static readonly int totalTestsFailed = coverageData.Sum(m => m.TestsFailed);

    private static readonly double overallLineCoverage = CalculatePercentage(totalLinesCovered, totalLines);
    private static readonly double overallBranchCoverage = CalculatePercentage(totalBranchesCovered, totalBranches);
    private static readonly double overallFunctionCoverage = CalculatePercentage(totalFunctionsCovered, totalFunctions);
}";
