    private record DataPoint(string Date, int Revenue);
    private record XTick(double X, string Label);

    private static readonly DataPoint[] _chartData =
    [
        new(""2026-01-05"", 142_300),
        new(""2026-01-12"", 158_420),
        new(""2026-01-19"", 164_870),
