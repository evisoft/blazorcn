        var sb = new System.Text.StringBuilder();
        var firstX = 0.0;
        var lastX = 0.0;
        sb.Append('M');
        for (var i = 0; i < data.Length; i++)
        {
            var x = (i / (double)(data.Length - 1)) * width;
            var y = padding + (1.0 - (data[i].V - minV) / range) * usableH;
            if (i == 0) { firstX = x; sb.Append($""{x:F1},{y:F1}""); }
            else sb.Append($"" L{x:F1},{y:F1}"");
            lastX = x;
        }
        sb.Append($"" L{lastX:F1},{height:F1} L{firstX:F1},{height:F1} Z"");
