@code {
    private static readonly DateTime _targetUtc = new DateTime(2026, 5, 1, 12, 0, 0, DateTimeKind.Utc);

    private record Segment(string Id, string Label, int? Value);

    private Segment[] _segments =
    [
        new(""days"",    ""Days"",    null),
        new(""hours"",   ""Hours"",   null),
        new(""minutes"", ""Minutes"", null),
        new(""seconds"", ""Seconds"", null),
    ];

    private Timer? _timer;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _segments = ComputeSegments(DateTime.UtcNow);
            _timer = new Timer(_ =>
            {
                _segments = ComputeSegments(DateTime.UtcNow);
                InvokeAsync(StateHasChanged);
            }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
            StateHasChanged();
        }
    }

    private static Segment[] ComputeSegments(DateTime nowUtc)
    {
        var delta = (int)Math.Max(0, Math.Floor((_targetUtc - nowUtc).TotalSeconds));
        var days    = delta / 86400;
        var hours   = (delta % 86400) / 3600;
        var minutes = (delta % 3600) / 60;
        var seconds = delta % 60;
        return
        [
            new(""days"",    ""Days"",    days),
            new(""hours"",   ""Hours"",   hours),
            new(""minutes"", ""Minutes"", minutes),
            new(""seconds"", ""Seconds"", seconds),
        ];
    }

    private static string FormatSegment(int? value)
    {
        if (value is null) return ""--"";
        return value.Value.ToString().PadLeft(2, '0');
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}";

