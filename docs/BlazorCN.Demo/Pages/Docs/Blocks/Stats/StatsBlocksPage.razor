    ];

    private static readonly int _totalVisits = _segments.Sum(s => s.Value);

    // Pre-computed SVG arc paths for the donut chart
    private record ArcPath(string Path);
    private static readonly ArcPath[] _arcs = BuildArcs();

    private static ArcPath[] BuildArcs()
    {
        const double cx = 110;
        const double cy = 110;
        const double outerR = 95;
        const double innerR = 60;
        const double gapDeg = 2.0;
        const double gapRad = gapDeg * Math.PI / 180.0;

        double total = _segments.Sum(s => s.Value);
        var result = new ArcPath[_segments.Length];
        double startAngle = -Math.PI / 2; // start at top

        for (int i = 0; i < _segments.Length; i++)
        {
            var seg = _segments[i];
            double sweep = (seg.Value / total) * (2 * Math.PI) - gapRad;
            if (sweep < 0) sweep = 0;
            double endAngle = startAngle + sweep;

            double ox1 = cx + outerR * Math.Cos(startAngle);
            double oy1 = cy + outerR * Math.Sin(startAngle);
            double ox2 = cx + outerR * Math.Cos(endAngle);
            double oy2 = cy + outerR * Math.Sin(endAngle);
            double ix1 = cx + innerR * Math.Cos(endAngle);
            double iy1 = cy + innerR * Math.Sin(endAngle);
            double ix2 = cx + innerR * Math.Cos(startAngle);
            double iy2 = cy + innerR * Math.Sin(startAngle);

            int largeArc = sweep > Math.PI ? 1 : 0;

            string d = $""M {ox1:F3} {oy1:F3} "" +
                       $""A {outerR} {outerR} 0 {largeArc} 1 {ox2:F3} {oy2:F3} "" +
                       $""L {ix1:F3} {iy1:F3} "" +
                       $""A {innerR} {innerR} 0 {largeArc} 0 {ix2:F3} {iy2:F3} "" +
                       $""Z"";

            string path = $""<path d=\""{d}\"" fill=\""{seg.Fill}\"" stroke=\""white\"" stroke-width=\""2\"" />"";
            result[i] = new ArcPath(path);

            startAngle = endAngle + gapRad;
        }

        return result;
    }

    private static string FormatCompact(int value)
    {
        if (value >= 1_000_000)
            return $""{(value / 1_000_000.0):F1}M"";
        if (value >= 1_000)
            return $""{(value / 1_000.0):F1}k"";
        return value.ToString();
    }
}";

