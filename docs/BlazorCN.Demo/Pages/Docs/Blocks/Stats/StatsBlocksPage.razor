                new SparkPoint(""Sun"", 13870),
            ]
        ),
    ];

    private static (double X, double Y)[] ComputeCoords(SparkPoint[] pts)
    {
        const double svgW = 280.0;
        const double svgH = 64.0;
        const double pad = 4.0;
        var minVal = pts.Min(p => p.Trend);
        var maxVal = pts.Max(p => p.Trend);
        var range = maxVal == minVal ? 1.0 : (double)(maxVal - minVal);
        var count = pts.Length;
        var coords = new (double X, double Y)[count];
        for (var i = 0; i < count; i++)
        {
            coords[i] = (
                pad + i * (svgW - 2 * pad) / (count - 1),
                svgH - pad - (pts[i].Trend - minVal) / range * (svgH - 2 * pad)
            );
        }
        return coords;
    }

    private static string BuildLinePath(SparkPoint[] pts)
    {
        var coords = ComputeCoords(pts);
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < coords.Length; i++)
        {
            sb.Append(i == 0
                ? $""M {coords[i].X:F1},{coords[i].Y:F1}""
                : $"" L {coords[i].X:F1},{coords[i].Y:F1}"");
        }
        return sb.ToString();
    }

    private static string BuildFillPath(SparkPoint[] pts)
    {
        const double svgH = 64.0;
        var coords = ComputeCoords(pts);
        var linePath = BuildLinePath(pts);
        return $""{linePath} L {coords[^1].X:F1},{svgH} L {coords[0].X:F1},{svgH} Z"";
    }
}
";

