        {
            if (pt.V < minV) minV = pt.V;
            if (pt.V > maxV) maxV = pt.V;
        }
        var range = maxV - minV;
        if (range == 0) range = 1;
        var padding = height * 0.1;
        var usableH = height - padding * 2;
        var points = new System.Text.StringBuilder();
        for (var i = 0; i < data.Length; i++)
        {
            var x = (i / (double)(data.Length - 1)) * width;
            var y = padding + (1.0 - (data[i].V - minV) / range) * usableH;
            if (i > 0) points.Append(' ');
            points.Append($""{x:F1},{y:F1}"");
        }
        return points.ToString();
    }

