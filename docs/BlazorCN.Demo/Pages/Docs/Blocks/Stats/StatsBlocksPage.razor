@code {
    private record BurndownPoint(int Day, int Ideal, int Actual);

    private static readonly BurndownPoint[] _burndownData =
    [
        new(1,  80, 80),
        new(2,  74, 78),
        new(3,  69, 72),
        new(4,  63, 65),
        new(5,  57, 60),
        new(6,  51, 52),
        new(7,  46, 48),
        new(8,  40, 42),
        new(9,  34, 35),
        new(10, 29, 30),
        new(11, 23, 28),
        new(12, 17, 22),
        new(13, 11, 18),
        new(14,  0, 12),
    ];

    private static readonly int[] _gridYValues = [0, 20, 40, 60, 80];

    // Chart area: x from 35 to 415, y from 10 to 180 (leaving room for labels)
    private const double _xMin = 35;
    private const double _xMax = 415;
    private const double _yMin = 10;
    private const double _yMax = 180;
    private const int _totalPoints = 80;

    private double ScaleX(int day)
    {
        // day 1..14 mapped to _xMin.._xMax
        var t = (double)(day - 1) / (_burndownData.Length - 1);
        return _xMin + t * (_xMax - _xMin);
    }

    private double ScaleY(int value)
    {
        // 0 at bottom (_yMax), _totalPoints at top (_yMin)
        var t = (double)value / _totalPoints;
        return _yMax - t * (_yMax - _yMin);
    }

    private int _remaining => _burndownData[^1].Actual;
    private int _idealRemaining => _burndownData[^1].Ideal;
    private bool _isBehind => _remaining > _idealRemaining;

    private string _idealPoints => string.Join("" "", _burndownData.Select(p => $""{ScaleX(p.Day):F1},{ScaleY(p.Ideal):F1}""));
    private string _actualPoints => string.Join("" "", _burndownData.Select(p => $""{ScaleX(p.Day):F1},{ScaleY(p.Actual):F1}""));

    // Polygon: ideal forward + actual reversed to fill the gap between ideal and actual
    private string _gapPolygonPoints
    {
        get
        {
            var fwd = _burndownData.Select(p => $""{ScaleX(p.Day):F1},{ScaleY(p.Ideal):F1}"");
            var rev = _burndownData.Reverse().Select(p => $""{ScaleX(p.Day):F1},{ScaleY(p.Actual):F1}"");
            return string.Join("" "", fwd.Concat(rev));
        }
    }
}";

