        ]),
        new KpiMetric(""churn"", ""Monthly churn rate"", ""2.14%"", ""-0.32pt vs last 30d"", TrendType.Positive,
        [
            new SparkPoint(1, 284), new SparkPoint(2, 278), new SparkPoint(3, 271), new SparkPoint(4, 269),
            new SparkPoint(5, 262), new SparkPoint(6, 258), new SparkPoint(7, 249), new SparkPoint(8, 243),
            new SparkPoint(9, 237), new SparkPoint(10, 228), new SparkPoint(11, 221), new SparkPoint(12, 214),
        ]),
        new KpiMetric(""p99"", ""p99 API latency"", ""412ms"", ""+46ms vs last 24h"", TrendType.Negative,
        [
            new SparkPoint(1, 362), new SparkPoint(2, 358), new SparkPoint(3, 365), new SparkPoint(4, 372),
            new SparkPoint(5, 369), new SparkPoint(6, 378), new SparkPoint(7, 384), new SparkPoint(8, 391),
            new SparkPoint(9, 388), new SparkPoint(10, 401), new SparkPoint(11, 408), new SparkPoint(12, 412),
        ]),
    ];

    private static string BuildSparkPath(SparkPoint[] points, double width, double height)
    {
        if (points.Length == 0) return """";
        var minY = double.MaxValue;
        var maxY = double.MinValue;
        foreach (var pt in points) { if (pt.Y < minY) minY = pt.Y; if (pt.Y > maxY) maxY = pt.Y; }
        var rangeY = maxY - minY;
        if (rangeY == 0) rangeY = 1;
        var stepX = width / (points.Length - 1);
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < points.Length; i++)
        {
            var px = i * stepX;
            var py = height - ((points[i].Y - minY) / rangeY * height);
            sb.Append(i == 0 ? $""M {px:F1} {py:F1}"" : $"" L {px:F1} {py:F1}"");
        }
        return sb.ToString();
    }

    private static string BuildAreaPath(SparkPoint[] points, double width, double height)
    {
        if (points.Length == 0) return """";
        var line = BuildSparkPath(points, width, height);
        var lastX = (points.Length - 1) * (width / (points.Length - 1));
        return $""{line} L {lastX:F1} {height:F1} L 0 {height:F1} Z"";
    }
}
";

