    private record DataPoint(string Day, double Uptime);

    private const double SLO_TARGET = 99.9;

    // Chart coordinate constants
    private const double ChartLeft   = 36.0;
    private const double ChartRight  = 552.0;
    private const double ChartTop    = 12.0;
    private const double ChartBottom = 176.0;
    private const double DomainMin   = 99.7;
    private const double DomainMax   = 100.0;

    private static readonly double[] _yTicks = [99.7, 99.8, 99.9, 100.0];

    private static readonly DataPoint[] _chartData =
    [
        new(""Mar 14"", 99.98),
        new(""Mar 15"", 99.96),
        new(""Mar 16"", 99.94),
        new(""Mar 17"", 99.88),
        new(""Mar 18"", 99.82),
        new(""Mar 19"", 99.76),
        new(""Mar 20"", 99.84),
        new(""Mar 21"", 99.92),
        new(""Mar 22"", 99.95),
        new(""Mar 23"", 99.97),
        new(""Mar 24"", 99.98),
        new(""Mar 25"", 99.96),
        new(""Mar 26"", 99.94),
        new(""Mar 27"", 99.99),
    ];

    private static readonly double _latest = _chartData[^1].Uptime;
    private static readonly bool _withinTarget = _latest >= SLO_TARGET;

    private static double ChartX(int idx)
    {
        double w = ChartRight - ChartLeft;
        return ChartLeft + idx * (w / (_chartData.Length - 1));
    }

    private static double ChartY(double val)
    {
        double h = ChartBottom - ChartTop;
        return ChartTop + h - (val - DomainMin) / (DomainMax - DomainMin) * h;
    }

    // Format a double as a fixed-point string for SVG attribute values
    private static string _I(double v) =>
        v.ToString(""F1"", System.Globalization.CultureInfo.InvariantCulture);

    private static readonly string _polylinePoints = BuildPolyline();

    private static string BuildPolyline()
    {
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < _chartData.Length; i++)
        {
            if (i > 0) sb.Append(' ');
            sb.Append(ChartX(i).ToString(""F1"", System.Globalization.CultureInfo.InvariantCulture));
            sb.Append(',');
            sb.Append(ChartY(_chartData[i].Uptime).ToString(""F1"", System.Globalization.CultureInfo.InvariantCulture));
        }
        return sb.ToString();
    }
}";

