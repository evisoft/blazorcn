    private static string _organicLinePath => BuildLinePath(i => OrganicTop(i));
    private static string _organicAreaPath => BuildAreaPath(i => OrganicTop(i), i => PaidTop(i));

    // Direct series sits on top of organic+paid
    private static string _directLinePath  => BuildLinePath(i => DirectTop(i));
    private static string _directAreaPath  => BuildAreaPath(i => DirectTop(i), i => OrganicTop(i));

