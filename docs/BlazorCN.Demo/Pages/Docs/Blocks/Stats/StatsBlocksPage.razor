    {
        [""within""]   = new(""On track"", ""oklch(0.6 0.118 184.704)"",  ""text-emerald-600 dark:text-emerald-400"", ""bg-emerald-500"", ""bg-emerald-500/10""),
        [""observe""]  = new(""Observe"",  ""oklch(0.828 0.189 84.429)"", ""text-amber-600 dark:text-amber-400"",     ""bg-amber-500"",   ""bg-amber-500/10""),
        [""critical""] = new(""Critical"", ""oklch(0.646 0.222 41.116)"", ""text-red-600 dark:text-red-400"",         ""bg-red-500"",     ""bg-red-500/10""),
    };

    private static string FormatValue(Goal goal)
    {
        if (goal.Unit == ""USD"")
            return $""${(goal.Current / 1_000_000.0):F2}M"";
        if (goal.Unit == ""%"")
            return $""{goal.Current:F2}%"";
        return goal.Current.ToString(""N0"");
    }

    private static string FormatTarget(Goal goal)
    {
        if (goal.Unit == ""USD"")
            return $""${(goal.Target / 1_000_000.0):F0}M"";
        if (goal.Unit == ""%"")
            return $""{goal.Target:F2}%"";
        return $""{goal.Target:N0} {goal.Unit}"";
    }

    // Builds an SVG donut arc path for a given percentage.
    // cx/cy = center, innerR/outerR = inner and outer radius of the ring.
    // The SVG viewBox is 0 0 104 104 so center is 52,52.
    private static string BuildRingPath(double pct, double center, double innerR, double outerR)
    {
        // clamp so a full 100% ring closes correctly
        var clampedPct = Math.Min(pct, 99.9999);
        var angle = clampedPct / 100.0 * 360.0;
        var rad = angle * Math.PI / 180.0;

        // start at top (12 o'clock = -90 deg)
        var startAngle = -Math.PI / 2;
        var endAngle = startAngle + rad;

        var sinStart = Math.Sin(startAngle);
        var cosStart = Math.Cos(startAngle);
        var sinEnd = Math.Sin(endAngle);
        var cosEnd = Math.Cos(endAngle);

        var ox1 = center + outerR * cosStart;
        var oy1 = center + outerR * sinStart;
        var ox2 = center + outerR * cosEnd;
        var oy2 = center + outerR * sinEnd;
        var ix1 = center + innerR * cosEnd;
        var iy1 = center + innerR * sinEnd;
        var ix2 = center + innerR * cosStart;
        var iy2 = center + innerR * sinStart;

        var largeArc = angle > 180 ? 1 : 0;

        return $""M {F(ox1)} {F(oy1)} A {F(outerR)} {F(outerR)} 0 {largeArc} 1 {F(ox2)} {F(oy2)} L {F(ix1)} {F(iy1)} A {F(innerR)} {F(innerR)} 0 {largeArc} 0 {F(ix2)} {F(iy2)} Z"";
    }

    private static string F(double v) => v.ToString(""F4"", System.Globalization.CultureInfo.InvariantCulture);
}";

