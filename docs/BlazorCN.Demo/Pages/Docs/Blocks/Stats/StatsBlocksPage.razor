@code {
    private record Metric(string Label, string Timeframe, int Value, double Delta);
    private record SparkPoint(int X, int ValueY);

    private static readonly Metric _metric = new(""Monthly active users"", ""Last 30 days"", 48_372, 12.4);

    private static readonly SparkPoint[] _sparkData =
    [
        new(1, 32_140),
        new(2, 33_820),
        new(3, 34_100),
        new(4, 35_640),
        new(5, 36_220),
        new(6, 37_890),
        new(7, 38_510),
        new(8, 40_140),
        new(9, 41_730),
        new(10, 42_880),
        new(11, 44_620),
        new(12, 46_310),
        new(13, 47_150),
        new(14, 48_372),
    ];

    private const int _svgWidth = 280;
    private const int _svgHeight = 64;

    private string _linePath = """";
    private string _areaPath = """";

    protected override void OnInitialized()
    {
        var minVal = 0;
        var maxVal = 0;
        foreach (var pt in _sparkData)
        {
            if (pt.ValueY < minVal || minVal == 0) minVal = pt.ValueY;
            if (pt.ValueY > maxVal) maxVal = pt.ValueY;
        }

        var range = maxVal - minVal;
        var padding = range * 0.1;
        var lo = minVal - padding;
        var hi = maxVal + padding;
        var totalRange = hi - lo;

        int n = _sparkData.Length;
        var pts = new (double px, double py)[n];
        for (int i = 0; i < n; i++)
        {
            double px = i * (_svgWidth - 1.0) / (n - 1);
            double py = _svgHeight - (_sparkData[i].ValueY - lo) / totalRange * _svgHeight;
            pts[i] = (px, py);
        }

        var lineParts = new System.Text.StringBuilder();
        var areaParts = new System.Text.StringBuilder();

        for (int i = 0; i < n; i++)
        {
            if (i > 0) lineParts.Append(' ');
            lineParts.Append($""{pts[i].px:F1},{pts[i].py:F1}"");
        }

        areaParts.Append($""M {pts[0].px:F1},{_svgHeight}"");
        for (int i = 0; i < n; i++)
        {
            areaParts.Append($"" L {pts[i].px:F1},{pts[i].py:F1}"");
        }
        areaParts.Append($"" L {pts[n - 1].px:F1},{_svgHeight} Z"");

        _linePath = lineParts.ToString();
        _areaPath = areaParts.ToString();
    }
}";

