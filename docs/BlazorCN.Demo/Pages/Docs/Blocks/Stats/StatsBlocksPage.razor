    private record ModuleCoverage(string Module, string Path, int LinesCovered, int LinesTotal, int BranchesCovered, int BranchesTotal, int FunctionsCovered, int FunctionsTotal, int TestsPassed, int TestsFailed);

    private static double CalculatePercentage(int covered, int total) => total > 0 ? (double)covered / total * 100 : 0;

    private static readonly ModuleCoverage[] coverageData = new[]
    {
        new ModuleCoverage(""auth"", ""src/lib/auth"", 342, 358, 87, 96, 48, 52, 56, 0),
