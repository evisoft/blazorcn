@code {
    private enum ThresholdStatus { Within, Observe, Critical }

    private record ThresholdTarget(string Id, string Label, string Unit, double Current, double Max, double Warn, double Critical);

    private record StatusStyleSet(string Border, string Dot, string Text, string Label, string Bar, string TrackTint, string IconName);

    private static readonly ThresholdTarget[] _targets =
    [
        new(""cpu"",    ""CPU utilization"",    ""%"", 38,  100, 70, 90),
        new(""memory"", ""Memory pressure"",    ""%"", 74,  100, 70, 90),
        new(""errors"", ""5xx error rate"",     ""%"",  4.2,  10,  1,  3),
        new(""budget"", ""Monthly budget burn"",""%"", 62,  100, 75, 95),
    ];

    private static readonly Dictionary<ThresholdStatus, StatusStyleSet> _statusStyles = new()
    {
        [ThresholdStatus.Within]   = new(""border-emerald-500/40"", ""bg-emerald-500"", ""text-emerald-600 dark:text-emerald-400"", ""Within target"", ""bg-emerald-500"", ""bg-emerald-500/10"", ""circle-check""),
        [ThresholdStatus.Observe]  = new(""border-amber-500/40"",   ""bg-amber-500"",   ""text-amber-600 dark:text-amber-400"",   ""Observe"",        ""bg-amber-500"",   ""bg-amber-500/10"",   ""circle-dot""),
        [ThresholdStatus.Critical] = new(""border-red-500/40"",     ""bg-red-500"",     ""text-red-600 dark:text-red-400"",       ""Critical"",       ""bg-red-500"",     ""bg-red-500/10"",     ""circle-alert""),
    };

    private static ThresholdStatus StatusFor(ThresholdTarget tgt)
    {
        if (tgt.Current >= tgt.Critical) return ThresholdStatus.Critical;
        if (tgt.Current >= tgt.Warn)     return ThresholdStatus.Observe;
        return ThresholdStatus.Within;
    }
}";

