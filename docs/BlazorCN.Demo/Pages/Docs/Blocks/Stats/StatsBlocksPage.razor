            new(6, 2540), new(7, 2620), new(8, 2720), new(9, 2780), new(10, 2840),
        ]),
        new(""nps"", ""Customer NPS score"", ""pt"", 48, 60, [
            new(1, 52), new(2, 51), new(3, 53), new(4, 50), new(5, 49),
            new(6, 51), new(7, 50), new(8, 49), new(9, 48), new(10, 48),
        ]),
        new(""uptime"", ""API uptime SLO"", ""%"", 9_992, 9_995, [
            new(1, 9988), new(2, 9991), new(3, 9993), new(4, 9990), new(5, 9989),
            new(6, 9992), new(7, 9993), new(8, 9991), new(9, 9994), new(10, 9992),
        ]),
        new(""activation"", ""7-day activation rate"", ""%"", 38, 50, [
            new(1, 32), new(2, 33), new(3, 34), new(4, 34), new(5, 35),
            new(6, 36), new(7, 37), new(8, 37), new(9, 38), new(10, 38),
        ]),
    ];

    private static string FormatValue(GoalRow goal)
    {
        if (goal.Id == ""revenue"")
            return $""${(goal.Current / 1_000):0}k / ${(goal.Target / 1_000):0}k"";
        if (goal.Id == ""uptime"")
            return $""{(goal.Current / 100):0.00}% / {(goal.Target / 100):0.00}%"";
        if (goal.Unit == ""$"")
            return $""${goal.Current:N0} / ${goal.Target:N0}"";
        if (goal.Unit == ""%"" || goal.Unit == ""pt"")
            return $""{goal.Current}{goal.Unit} / {goal.Target}{goal.Unit}"";
        return $""{goal.Current:N0} / {goal.Target:N0}"";
    }

    private static string BarClassFor(double ratio)
    {
        if (ratio >= 0.95) return ""bg-emerald-500"";
        if (ratio >= 0.75) return ""bg-foreground"";
        if (ratio >= 0.5)  return ""bg-amber-500"";
        return ""bg-red-500"";
    }

    private static string BuildSparkPoints(SparkPoint[] spark, double svgWidth, double svgHeight)
    {
        if (spark.Length == 0) return """";
        var minY = spark[0].Y;
        var maxY = spark[0].Y;
        foreach (var pt in spark)
        {
            if (pt.Y < minY) minY = pt.Y;
            if (pt.Y > maxY) maxY = pt.Y;
        }
        var rangeY = maxY - minY;
        if (rangeY == 0) rangeY = 1;
        var minX = spark[0].X;
        var maxX = spark[spark.Length - 1].X;
        var rangeX = maxX - minX;
        if (rangeX == 0) rangeX = 1;
        var padding = 2.0;
        var parts = new System.Text.StringBuilder();
        for (var i = 0; i < spark.Length; i++)
        {
            var px = (spark[i].X - minX) / (double)rangeX * (svgWidth - 1);
            var py = svgHeight - padding - (spark[i].Y - minY) / (double)rangeY * (svgHeight - padding * 2);
            if (i > 0) parts.Append(' ');
            parts.Append($""{px:0.##},{py:0.##}"");
        }
        return parts.ToString();
    }
}";

