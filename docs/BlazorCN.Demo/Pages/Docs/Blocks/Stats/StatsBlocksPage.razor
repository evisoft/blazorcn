            double oy2 = cy + outerR * Math.Sin(e);
            double ix1 = cx + innerR * Math.Cos(e);
            double iy1 = cy + innerR * Math.Sin(e);
            double ix2 = cx + innerR * Math.Cos(s);
            double iy2 = cy + innerR * Math.Sin(s);

            int largeArc = sweepDeg > 180 ? 1 : 0;

            string d = $""M {F(ox1)} {F(oy1)} A {outerR} {outerR} 0 {largeArc} 1 {F(ox2)} {F(oy2)} L {F(ix1)} {F(iy1)} A {innerR} {innerR} 0 {largeArc} 0 {F(ix2)} {F(iy2)} Z"";

            result[i] = new ArcPath(d, fills[i]);
            startDeg = endDeg + paddingDeg;
        }

        return result;
    }

    private static string F(double v) => v.ToString(""F3"", System.Globalization.CultureInfo.InvariantCulture);
}";

