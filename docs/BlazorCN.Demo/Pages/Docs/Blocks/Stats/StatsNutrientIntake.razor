@* ========================================
   Block: stats-nutrient-intake
   Title: Stats Nutrient Intake
   Description: A daily nutrition tracking component displaying macronutrient and micronutrient intake with progress bars for health and fitness apps built with Next.js and React
   Long Description: Net Promoter Score trend visualization with promoter/passive/detractor breakdown per period and historical NPS tracking for customer loyalty analysis
   Dependencies: None
   Source: original/blocks/stats/stats-nutrient-intake.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-medium">Daily Nutrient Intake</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">Today</p>
                </div>
                <div class="text-right">
                    <div class="text-2xl font-semibold tabular-nums">@totalCalories</div>
                    <p class="text-xs text-muted-foreground">of @targetCalories kcal</p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-2 text-xs font-medium text-muted-foreground">Macronutrients</div>
            <div class="space-y-3">
                @foreach (var nutrient in macros)
                {
                    var percentage = (double)nutrient.Current / nutrient.Target * 100;
                    var isComplete = percentage >= 100;

                    <div>
                        <div class="mb-1.5 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@nutrient.Name</span>
                                @if (isComplete)
                                {
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                }
                            </div>
                            <span class="text-xs text-muted-foreground">
                                <span class="font-semibold tabular-nums text-foreground">
                                    @nutrient.Current
                                </span>
                                /@nutrient.Target @nutrient.Unit
                            </span>
                        </div>
                        <div class="h-1 overflow-hidden rounded-full bg-muted">
                            <div class="@(Cn.Merge("h-full rounded-full transition-all", isComplete ? "bg-emerald-500" : "bg-foreground"))"
                                 style="width: @(Math.Min(percentage, 100))%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="mb-2 text-xs font-medium text-muted-foreground">Micronutrients</div>
            <div class="space-y-3">
                @foreach (var nutrient in micros)
                {
                    var percentage = (double)nutrient.Current / nutrient.Target * 100;
                    var isComplete = percentage >= 100;

                    <div>
                        <div class="mb-1.5 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@nutrient.Name</span>
                                @if (isComplete)
                                {
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                }
                            </div>
                            <span class="text-xs text-muted-foreground">
                                <span class="font-semibold tabular-nums text-foreground">
                                    @nutrient.Current
                                </span>
                                /@nutrient.Target @nutrient.Unit
                            </span>
                        </div>
                        <div class="h-1 overflow-hidden rounded-full bg-muted">
                            <div class="@(Cn.Merge("h-full rounded-full transition-all", isComplete ? "bg-emerald-500" : "bg-foreground"))"
                                 style="width: @(Math.Min(percentage, 100))%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Nutrient(string Name, int Current, int Target, string Unit, string Category);

    private static readonly Nutrient[] nutrientData = new[]
    {
        new Nutrient("Protein", 142, 150, "g", "macro"),
        new Nutrient("Carbs", 218, 250, "g", "macro"),
        new Nutrient("Fat", 58, 70, "g", "macro"),
        new Nutrient("Fiber", 24, 30, "g", "macro"),
        new Nutrient("Vitamin C", 78, 90, "mg", "micro"),
        new Nutrient("Vitamin D", 18, 20, "mcg", "micro"),
        new Nutrient("Calcium", 920, 1000, "mg", "micro"),
        new Nutrient("Iron", 14, 18, "mg", "micro"),
    };

    private static readonly Nutrient[] macros = nutrientData.Where(n => n.Category == "macro").ToArray();
    private static readonly Nutrient[] micros = nutrientData.Where(n => n.Category == "micro").ToArray();
    private const int totalCalories = 2143;
    private const int targetCalories = 2400;
}
