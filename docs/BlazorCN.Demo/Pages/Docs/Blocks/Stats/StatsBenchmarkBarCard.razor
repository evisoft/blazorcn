@* ============================================================
   Block: stats-benchmark-bar-card
   Title: StatsBenchmarkBarCard
   Description: A benchmark comparison stats card for React and Next.js with horizontal scale lines per metric showing your position against industry average and top 10 percent markers, semantic positioning dots, and tabular-nums values built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-benchmark-bar-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Industry benchmarks</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Compared to 2,400 SaaS companies</p>
        </div>
        <div class="divide-y">
            @foreach (var b in _benchmarks)
            {
                var exceedsTop = b.BetterHigher ? b.Yours >= b.Top10 : b.Yours <= b.Top10;
                var yourColor = exceedsTop ? "var(--chart-1)" : "var(--muted-foreground)";
                <div class="px-4 py-3">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium">@b.Label</span>
                        <div class="flex items-baseline gap-1.5">
                            <span class="@Cn.Merge("text-sm font-semibold tabular-nums", exceedsTop ? "text-emerald-600 dark:text-emerald-400" : "text-foreground")">
                                @b.Yours@b.Unit
                            </span>
                            @if (exceedsTop)
                            {
                                <span class="text-[10px] font-medium text-emerald-600 dark:text-emerald-400">Top 10%</span>
                            }
                        </div>
                    </div>
                    <div class="relative mt-2 h-3">
                        <div class="absolute inset-y-1 left-0 right-0 h-px bg-border"></div>
                        <div
                            class="absolute top-0 flex size-3 -translate-x-1/2 flex-col items-center"
                            style="@($"left:{Pct(b.Avg, b.Max):F4}%")"
                            aria-label="@($"Industry avg: {b.Avg}{b.Unit}")">
                            <span class="size-2 rounded-full bg-muted-foreground/50"></span>
                        </div>
                        <div
                            class="absolute top-0 flex size-3 -translate-x-1/2 flex-col items-center"
                            style="@($"left:{Pct(b.Top10, b.Max):F4}%")"
                            aria-label="@($"Top 10%: {b.Top10}{b.Unit}")">
                            <span class="size-2 rounded-full bg-muted-foreground/70 ring-2 ring-background"></span>
                        </div>
                        <div
                            class="absolute top-0 flex size-3 -translate-x-1/2 flex-col items-center"
                            style="@($"left:{Pct(b.Yours, b.Max):F4}%")"
                            aria-label="@($"You: {b.Yours}{b.Unit}")">
                            <span
                                class="size-3 rounded-full ring-2 ring-background"
                                style="@($"background-color:{yourColor}")">
                            </span>
                        </div>
                    </div>
                    <div class="mt-1 flex justify-between text-[10px] text-muted-foreground tabular-nums">
                        <span>Avg: @b.Avg@b.Unit</span>
                        <span>Top 10%: @b.Top10@b.Unit</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record BenchmarkMetric(string Id, string Label, double Yours, double Avg, double Top10, double Max, string Unit, bool BetterHigher);

    private static readonly BenchmarkMetric[] _benchmarks =
    [
        new("conversion", "Conversion rate", 3.8, 2.1, 4.2, 6, "%", true),
        new("churn",      "Churn rate",      1.2, 2.8, 1.0, 5, "%", false),
        new("nps",        "NPS score",       52,  32,  60,  100, "", true),
        new("ltv",        "LTV/CAC ratio",   4.8, 3.0, 5.5, 8, "x", true),
        new("arr",        "ARR growth",      85,  45,  100, 150, "%", true),
    ];

    private static double Pct(double value, double max) => (value / max) * 100.0;
}
