@* ========================================
   Block: stats-grid
   Title: Stats Grid
   Description: Stats grid with separate cards, inline change indicators, and responsive layout
   Dependencies: None
   Source: original/blocks/stats/stats-grid.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var item in _data)
        {
            <div class="rounded-lg border bg-card px-4 py-3">
                <div class="text-sm font-medium text-muted-foreground">@item.Name</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@item.Stat</span>
                    <span class="@($"text-xs font-medium tabular-nums {(item.IsPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")}")">
                        @item.Change
                    </span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record StatItem(string Name, string Stat, string Change, bool IsPositive);

    private static readonly StatItem[] _data =
    [
        new("Unique visitors", "10,450", "-12.5%", false),
        new("Bounce rate", "56.1%", "+1.8%", true),
        new("Visit duration", "5.2min", "+19.7%", true),
        new("Conversion rate", "3.2%", "-2.4%", false),
    ];
}
