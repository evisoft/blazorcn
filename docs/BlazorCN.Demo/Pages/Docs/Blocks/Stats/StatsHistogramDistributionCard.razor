@* ============================================================
   Block: stats-histogram-distribution-card
   Title: StatsHistogramDistributionCard
   Description: A histogram distribution stats card for React and Next.js with a ChartContainer-wrapped Recharts BarChart of ten bucketed bars across the X axis, a muted var(--chart-2) fill, a tight 160px chart body, and a mean summary header built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-histogram-distribution-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Response time distribution</p>
                <p class="mt-0.5 text-xs text-muted-foreground">/api/checkout · Last hour</p>
            </div>
            <div class="flex items-center gap-4 text-right">
                <div>
                    <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        Median
                    </p>
                    <p class="mt-0.5 text-sm font-semibold tabular-nums">@_medianLatency</p>
                </div>
                <div>
                    <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        p95
                    </p>
                    <p class="mt-0.5 text-sm font-semibold tabular-nums">@_p95Latency</p>
                </div>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="h-[160px] w-full">
                <div class="flex h-full items-end gap-[3px]">
                    @foreach (var bucket in _buckets)
                    {
                        var heightPct = (double)bucket.Count / _maxCount * 100.0;
                        <div class="flex flex-1 flex-col items-center gap-0">
                            <div class="w-full rounded-t-sm" style="@($"height:{heightPct:F1}%; background-color:var(--chart-2);")"></div>
                        </div>
                    }
                </div>
            </div>
            <div class="mt-1 flex items-end gap-[3px]">
                @foreach (var bucket in _buckets)
                {
                    <div class="flex-1 text-center">
                        <span class="text-[10px] text-muted-foreground">@bucket.BucketLabel</span>
                    </div>
                }
            </div>
            <div class="mt-3 flex items-center justify-between text-[10px] text-muted-foreground">
                <span class="tabular-nums">Sample size @_sampleSize.ToString("N0") requests</span>
                <span>Bucket width 50 ms</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Bucket(string BucketLabel, int Count);

    private static readonly Bucket[] _buckets =
    [
        new("0",   42),
        new("50",  186),
        new("100", 412),
        new("150", 678),
        new("200", 842),
        new("250", 524),
        new("300", 318),
        new("350", 164),
        new("400", 78),
        new("450", 24),
    ];

    private static readonly int _maxCount = 842;
    private static readonly int _sampleSize = 3268;

    private const string _medianLatency = "192 ms";
    private const string _p95Latency = "284 ms";
}
