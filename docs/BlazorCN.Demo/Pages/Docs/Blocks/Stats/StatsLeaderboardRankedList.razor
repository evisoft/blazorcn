@* ============================================================
   Block: stats-leaderboard-ranked-list
   Title: StatsLeaderboardRankedList
   Description: A ranked leaderboard stats card for React and Next.js with a font-mono rank column, subtly highlighted first place row, and tabular-nums values aligned on the right built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-leaderboard-ranked-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Top products by revenue</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 7 days</p>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full bg-muted/60 px-2 py-0.5 text-xs font-medium text-muted-foreground">
                Top 6
            </span>
        </div>

        <ol class="divide-y">
            @foreach (var entry in _entries)
            {
                var rank = Array.IndexOf(_entries, entry) + 1;
                var isFirst = rank == 1;
                <li class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isFirst ? "bg-muted/40" : "")">
                    <div class="flex w-8 shrink-0 items-center justify-center">
                        @if (isFirst)
                        {
                            <LucideIconCn Name="crown" Size="16" Class="size-4 text-foreground" aria-hidden="true" />
                        }
                        else
                        {
                            <span class="font-mono text-xs text-muted-foreground tabular-nums">
                                @rank.ToString().PadLeft(2, '0')
                            </span>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="@Cn.Merge("truncate text-sm", isFirst ? "font-semibold" : "font-medium")">
                            @entry.Name
                        </p>
                        <p class="mt-0.5 truncate text-xs text-muted-foreground">@entry.Subtitle</p>
                    </div>
                    <span class="shrink-0 text-sm tabular-nums font-semibold">
                        @entry.Value
                    </span>
                </li>
            }
        </ol>
    </div>
</section>

@code {
    private record LeaderboardEntry(string Id, string Name, string Subtitle, string Value);

    private static readonly LeaderboardEntry[] _entries =
    [
        new("acme-pro", "Acme Pro Annual", "Subscription", "$128,420"),
        new("acme-teams", "Acme Teams Monthly", "Subscription", "$86,140"),
        new("acme-starter", "Acme Starter Annual", "Subscription", "$54,280"),
        new("support-retainer", "Priority Support Retainer", "Service add-on", "$32,960"),
        new("acme-solo", "Acme Solo Monthly", "Subscription", "$21,480"),
        new("onboarding", "Guided Onboarding", "One-time", "$14,760"),
    ];
}
