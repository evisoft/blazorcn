@* ========================================
   Block: stats-real-estate-listings
   Title: Stats Real Estate Listings
   Description: Real estate listing analytics with average price, days on market, and property views
   Dependencies: None
   Source: original/blocks/stats/stats-real-estate-listings.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Listing Performance</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Active portfolio metrics</p>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Avg Price</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">$@(_avgPrice / 1000)K</p>
                <p class="mt-0.5 text-xs text-red-600">-3.2%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Avg Days</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_avgDays</p>
                <p class="mt-0.5 text-xs text-emerald-600">-5 days</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Total Views</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_totalViews.ToString("N0")</p>
                <p class="mt-0.5 text-xs text-emerald-600">+12.5%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Active</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@_activeCount</p>
                <p class="mt-0.5 text-xs text-muted-foreground">of @_listings.Length</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h3 class="text-sm font-medium">Current Listings</h3>
                <span class="text-xs text-muted-foreground">@_listings.Length properties</span>
            </div>
        </div>

        <div class="border-b">
            @for (var i = 0; i < _listings.Length; i++)
            {
                var listing = _listings[i];
                var isLast = i == _listings.Length - 1;
                var statusColor = listing.Status switch { "active" => "bg-blue-500", "pending" => "bg-amber-500", _ => "bg-emerald-500" };
                <div class="@($"px-4 py-2.5 {(isLast ? "" : "border-b")}")">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@listing.Address</span>
                                <span class="@($"h-1.5 w-1.5 shrink-0 rounded-full {statusColor}")"></span>
                            </div>
                            <div class="mt-1.5 grid grid-cols-4 gap-2">
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Price</p>
                                    <p class="mt-0.5 text-sm tabular-nums">$@(listing.Price / 1000)K</p>
                                </div>
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Days</p>
                                    <p class="mt-0.5 text-sm tabular-nums">@listing.DaysOnMarket</p>
                                </div>
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Views</p>
                                    <p class="mt-0.5 text-sm tabular-nums">@listing.Views</p>
                                </div>
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Change</p>
                                    @if (listing.PriceChange == 0)
                                    {
                                        <p class="mt-0.5 text-sm tabular-nums text-muted-foreground">&#x2014;</p>
                                    }
                                    else
                                    {
                                        <p class="@($"mt-0.5 text-sm tabular-nums {(listing.PriceChange < 0 ? "text-red-600" : "")}")">
                                            @(listing.PriceChange < 0 ? "-" : "+")$@(Math.Abs(listing.PriceChange / 1000))K
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="px-4 py-3">
            <h3 class="text-sm font-medium">Price Distribution</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">Listings by price range</p>
            <div class="mt-3 space-y-2.5">
                @foreach (var range in _priceRanges)
                {
                    <div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="@($"h-2 w-2 rounded-full {range.Color}")"></span>
                                <span class="text-sm">@range.Range</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-xs tabular-nums text-muted-foreground">
                                    @range.Count listings
                                </span>
                                <span class="text-xs tabular-nums text-muted-foreground">
                                    @range.AvgDays days avg
                                </span>
                            </div>
                        </div>
                        <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-muted">
                            <div class="@($"h-full {range.Color}")"
                                 style="@(FormattableString.Invariant($"width: {(double)range.Count / _listings.Length * 100}%"))"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ListingData(string Address, int Price, int DaysOnMarket, int Views, int PriceChange, string Status);
    private record PriceRange(string Range, int Count, int AvgDays, string Color);

    private static readonly ListingData[] _listings =
    [
        new("742 Evergreen Terrace", 485000, 12, 347, -5000, "active"),
        new("1428 Elm Street", 625000, 28, 523, -15000, "pending"),
        new("221B Baker Street", 799000, 45, 289, -25000, "active"),
        new("4 Privet Drive", 550000, 8, 612, 0, "sold"),
    ];

    private static readonly PriceRange[] _priceRanges =
    [
        new("$0-$500K", 18, 24, "bg-emerald-500"),
        new("$500K-$750K", 12, 32, "bg-blue-500"),
        new("$750K-$1M", 8, 48, "bg-amber-500"),
        new("$1M+", 5, 67, "bg-red-500"),
    ];

    private static readonly int _avgPrice = (int)Math.Round(_listings.Average(l => (double)l.Price));
    private static readonly int _avgDays = (int)Math.Round(_listings.Average(l => (double)l.DaysOnMarket));
    private static readonly int _totalViews = _listings.Sum(l => l.Views);
    private static readonly int _activeCount = _listings.Count(l => l.Status == "active");
}
