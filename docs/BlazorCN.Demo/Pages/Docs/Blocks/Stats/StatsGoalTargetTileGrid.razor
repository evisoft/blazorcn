@* ============================================================
   Block: stats-goal-target-tile-grid
   Title: StatsGoalTargetTileGrid
   Description: A goal target tile grid stats card for React and Next.js with four status-coded goal tiles, corner status dots, tabular-nums ratio readouts, and threshold-coloured progress bars built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-goal-target-tile-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="mb-3 flex items-end justify-between">
        <div>
            <p class="text-sm font-medium">Regional goals</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Q3 2026 · Tracking 20 OKRs across 4 regions
            </p>
        </div>
        <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
            USD · 90 days left
        </p>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var goal in _goals)
        {
            var styles = _statusStyles[goal.Status];
            var ratio = (double)goal.GoalsMet / goal.GoalsTotal;
            var pct = ratio * 100;
            <div class="@Cn.Merge("relative rounded-lg border bg-card px-4 py-3", styles.BorderClass)">
                <span aria-label="@styles.Label"
                      class="@Cn.Merge("absolute right-3 top-3 size-1.5 rounded-full", styles.DotClass)"
                      role="img"></span>

                <div class="pr-4 text-sm font-medium">@goal.Label</div>

                <div class="@Cn.Merge("mt-1 inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[10px] font-medium uppercase tracking-widest", styles.BgClass, styles.TextClass)">
                    <LucideIconCn Name="@styles.IconName" Size="12" Class="size-3" />
                    @styles.Label
                </div>

                <div class="mt-2 min-w-[90px]">
                    <span class="text-2xl font-semibold tabular-nums">@FormatCurrency(goal.Value)</span>
                </div>

                <div class="mt-3 flex items-baseline justify-between text-xs text-muted-foreground">
                    <span>Goals</span>
                    <span class="font-medium tabular-nums text-foreground">@goal.GoalsMet/@goal.GoalsTotal</span>
                </div>
                <div aria-label="@($"{goal.Label} goals met")"
                     aria-valuemax="@goal.GoalsTotal"
                     aria-valuemin="0"
                     aria-valuenow="@goal.GoalsMet"
                     class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted"
                     role="progressbar">
                    <div class="@Cn.Merge("h-full rounded-full transition-all duration-700 ease-out", styles.BarClass)"
                         style="@($"width:{pct:F1}%")"></div>
                </div>

                <p class="mt-2 truncate text-xs text-muted-foreground">@goal.NextMilestone</p>
            </div>
        }
    </div>
</section>

@code {
    private enum GoalStatus { Within, Observe, Critical }

    private record GoalTile(string Id, string Label, GoalStatus Status, int Value, int GoalsMet, int GoalsTotal, string NextMilestone);

    private sealed class StatusStyle
    {
        public string IconName { get; init; } = "";
        public string Label { get; init; } = "";
        public string DotClass { get; init; } = "";
        public string TextClass { get; init; } = "";
        public string BgClass { get; init; } = "";
        public string BarClass { get; init; } = "";
        public string BorderClass { get; init; } = "";
    }

    private static readonly Dictionary<GoalStatus, StatusStyle> _statusStyles = new()
    {
        [GoalStatus.Within] = new StatusStyle
        {
            IconName = "check-circle",
            Label = "within",
            DotClass = "bg-emerald-500",
            TextClass = "text-emerald-600 dark:text-emerald-400",
            BgClass = "bg-emerald-500/10",
            BarClass = "bg-emerald-500",
            BorderClass = "border-emerald-500/40",
        },
        [GoalStatus.Observe] = new StatusStyle
        {
            IconName = "eye",
            Label = "observe",
            DotClass = "bg-amber-500",
            TextClass = "text-amber-600 dark:text-amber-400",
            BgClass = "bg-amber-500/10",
            BarClass = "bg-amber-500",
            BorderClass = "border-amber-500/40",
        },
        [GoalStatus.Critical] = new StatusStyle
        {
            IconName = "triangle-alert",
            Label = "critical",
            DotClass = "bg-red-500",
            TextClass = "text-red-600 dark:text-red-400",
            BgClass = "bg-red-500/10",
            BarClass = "bg-red-500",
            BorderClass = "border-red-500/40",
        },
    };

    private static readonly GoalTile[] _goals =
    [
        new("na",    "North America", GoalStatus.Within,   1_408_200, 5, 5, "All Q3 targets met"),
        new("eu",    "Europe",        GoalStatus.Observe,  1_002_300, 3, 5, "Net-new logos: 82/120"),
        new("apac",  "Asia Pacific",  GoalStatus.Critical,   412_080, 1, 5, "JP expansion blocked"),
        new("latam", "Latin America", GoalStatus.Observe,    287_460, 3, 5, "BRL pricing pending"),
    ];

    private static string FormatCurrency(int value)
    {
        if (value >= 1_000_000) return $"${value / 1_000_000.0:F2}M";
        if (value >= 1_000)     return $"${value / 1_000.0:F1}K";
        return $"${value}";
    }
}
