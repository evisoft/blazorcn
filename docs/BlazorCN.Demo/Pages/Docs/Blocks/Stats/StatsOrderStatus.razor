@* ========================================
   Block: stats-order-status
   Title: Stats Order Status
   Description: An e-commerce order pipeline component showing order flow from pending to delivered with counts for each status stage in Next.js applications
   Long Description: User onboarding checklist with completion rates per step, overall activation metrics, and drop-off analysis for optimizing first-run experience
   Dependencies: None
   Source: original/blocks/stats/stats-order-status.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-medium">Order Status</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">Order pipeline</p>
                </div>
                <div class="text-right">
                    <div class="text-2xl font-semibold tabular-nums">@totalOrders</div>
                    <p class="text-xs text-muted-foreground">Total Orders</p>
                </div>
            </div>
        </div>

        <div>
            @for (var i = 0; i < statusData.Length; i++)
            {
                var item = statusData[i];
                var isLast = i == statusData.Length - 1;
                var percentage = (double)item.Count / totalOrders * 100;

                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                    <div class="mb-2 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@(Cn.Merge("size-2 rounded-full", GetColorClass(item.Color)))"></span>
                            <span class="text-sm font-medium">@item.Status</span>
                        </div>
                        <span class="text-sm font-semibold tabular-nums">@item.Count</span>
                    </div>
                    <div class="h-1 overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full transition-all", GetColorClass(item.Color)))"
                             style="width: @(percentage.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                    <div class="mt-1 text-xs text-muted-foreground">
                        @(percentage.ToString("F1"))% of total
                    </div>
                </div>
            }
        </div>

        <div class="grid grid-cols-2 gap-px border-t bg-border">
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Active Orders</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">@activeOrders</div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="text-xs font-medium text-muted-foreground">Completion Rate</div>
                <div class="mt-0.5 text-sm font-semibold tabular-nums">
                    @(completionRate.ToString("F1"))%
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record OrderStatus(string Status, int Count, string Color);

    private static readonly OrderStatus[] statusData = new[]
    {
        new OrderStatus("Pending", 23, "blue"),
        new OrderStatus("Processing", 47, "amber"),
        new OrderStatus("Shipped", 89, "blue"),
        new OrderStatus("Delivered", 234, "emerald"),
        new OrderStatus("Returned", 8, "red"),
    };

    private static readonly int totalOrders = statusData.Sum(s => s.Count);
    private static readonly int activeOrders = statusData
        .Where(s => s.Status != "Delivered" && s.Status != "Returned")
        .Sum(s => s.Count);
    private static readonly double completionRate = (double)(statusData.First(s => s.Status == "Delivered").Count) / totalOrders * 100;

    private static string GetColorClass(string color) => color switch
    {
        "blue" => "bg-blue-500",
        "amber" => "bg-amber-500",
        "emerald" => "bg-emerald-500",
        "red" => "bg-red-500",
        _ => "bg-muted-foreground",
    };
}
