@* ========================================
   Block: stats-electricity-consumption
   Title: Stats Electricity Consumption
   Description: Energy usage tracking by appliance and zone with kWh consumption, cost analysis, and peak demand hours for smart home dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-electricity-consumption.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Electricity Consumption</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">
                This month &#x2022; $@(_monthlyData.CostPerKwh.ToString("F2"))/kWh rate
            </p>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Total Usage</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@_monthlyData.TotalKwh</span>
                    <span class="text-xs text-muted-foreground">kWh</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Total Cost</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">
                        $@(_monthlyData.TotalCost.ToString("F0"))
                    </span>
                    <span class="text-xs text-muted-foreground">
                        $@(_monthlyData.AvgDailyCost.ToString("F2"))/day
                    </span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Peak Demand</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@_monthlyData.PeakDemand</span>
                    <span class="text-xs text-muted-foreground">kW</span>
                </div>
            </div>
        </div>

        @if (_standbyPercentage > 5)
        {
            <div class="border-b bg-amber-500/10 px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="size-2 rounded-full bg-amber-500"></span>
                    <span class="text-sm font-medium">
                        @_standbyPower kWh (@(_standbyPercentage.ToString("F0"))%) from standby devices
                    </span>
                </div>
            </div>
        }

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Daily Usage Pattern</span>
                <span class="text-xs text-muted-foreground">Peak at 6 PM</span>
            </div>
            <div class="flex items-end justify-between gap-1.5">
                @foreach (var hour in _peakHours)
                {
                    var heightPercentage = (hour.Kwh / _maxPeakKwh) * 100;
                    var isPeak = hour.Kwh >= _maxPeakKwh * 0.9;

                    <div class="flex-1 text-center">
                        <div class="mb-2 flex h-20 items-end">
                            <div class="w-full">
                                <div class="@(Cn.Merge("mx-auto w-full rounded-sm", isPeak ? "bg-red-500" : hour.Kwh >= _maxPeakKwh * 0.7 ? "bg-amber-500" : "bg-emerald-500"))"
                                     style="height: @(heightPercentage.ToString("F1"))%"></div>
                            </div>
                        </div>
                        <div class="text-xs font-medium">@hour.Hour</div>
                        <div class="text-xs text-muted-foreground">@(hour.Kwh.ToString("F1"))</div>
                    </div>
                }
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-3">
                <div class="text-xs font-medium text-muted-foreground">
                    Consumption by Appliance
                </div>
            </div>
            <div>
                @for (var i = 0; i < _applianceData.Length; i++)
                {
                    var appliance = _applianceData[i];

                    <div class="@(Cn.Merge("px-4 py-2.5", i < _applianceData.Length - 1 ? "border-b" : ""))">
                        <div class="mb-2 flex items-start justify-between gap-3">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@appliance.Name</span>
                                    <span class="@(Cn.Merge("size-1.5 rounded-full", appliance.Status == "active" ? "bg-emerald-500" : appliance.Status == "standby" ? "bg-amber-500" : "bg-muted-foreground/40"))"></span>
                                </div>
                                <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                    <span>@appliance.Zone</span>
                                    <span>&#x2022;</span>
                                    <span class="capitalize">@appliance.Status</span>
                                </div>
                            </div>
                            <div class="shrink-0 text-right">
                                <div class="text-sm font-medium tabular-nums">
                                    $@(appliance.Cost.ToString("F2"))
                                </div>
                                <div class="text-xs text-muted-foreground">@appliance.Kwh kWh</div>
                            </div>
                        </div>

                        <div>
                            <div class="mb-1 flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">@appliance.Percentage% of total</span>
                                <span class="font-medium tabular-nums">@appliance.Kwh kWh</span>
                            </div>
                            <div class="h-1 overflow-hidden rounded-full bg-muted">
                                <div class="@(Cn.Merge("h-full", appliance.Percentage >= 25 ? "bg-red-500" : appliance.Percentage >= 15 ? "bg-amber-500" : "bg-emerald-500"))"
                                     style="width: @(appliance.Percentage)%"></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record MonthlyData(int TotalKwh, double TotalCost, double AvgDailyCost, double PeakDemand, double CostPerKwh);
    private record ApplianceUsage(string Name, string Zone, int Kwh, double Cost, int Percentage, string Status);
    private record PeakHour(string Hour, double Kwh);

    private static readonly MonthlyData _monthlyData = new(847, 118.58, 3.95, 4.8, 0.14);

    private static readonly ApplianceUsage[] _applianceData =
    [
        new("Air Conditioning", "Whole Home", 284, 39.76, 34, "active"),
        new("Water Heater", "Utility Room", 152, 21.28, 18, "active"),
        new("Refrigerator", "Kitchen", 102, 14.28, 12, "active"),
        new("Lighting", "All Zones", 92, 12.88, 11, "active"),
        new("Washer & Dryer", "Laundry", 84, 11.76, 10, "standby"),
        new("Entertainment", "Living Room", 68, 9.52, 8, "standby"),
        new("Computer & Office", "Home Office", 42, 5.88, 5, "standby"),
        new("Other Devices", "Various", 23, 3.22, 2, "standby"),
    ];

    private static readonly PeakHour[] _peakHours =
    [
        new("12 AM", 1.2),
        new("3 AM", 0.9),
        new("6 AM", 2.4),
        new("9 AM", 2.8),
        new("12 PM", 3.2),
        new("3 PM", 3.8),
        new("6 PM", 4.8),
        new("9 PM", 3.4),
    ];

    private static readonly double _maxPeakKwh = _peakHours.Max(h => h.Kwh);
    private static readonly int _standbyPower = _applianceData.Where(a => a.Status == "standby").Sum(a => a.Kwh);
    private static readonly double _standbyPercentage = (double)_standbyPower / _monthlyData.TotalKwh * 100;
}
