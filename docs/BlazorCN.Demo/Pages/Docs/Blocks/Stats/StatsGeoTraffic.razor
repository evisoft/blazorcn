@* ========================================
   Block: stats-geo-traffic
   Title: Stats Geo Traffic
   Description: Geographic traffic analysis showing visitor counts and bounce rates by country and region
   Dependencies: None
   Source: original/blocks/stats/stats-geo-traffic.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Geographic Traffic</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Visitor distribution and engagement by country
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="text-xs text-muted-foreground">Total Visitors</div>
            <div class="mt-1 text-2xl font-semibold tabular-nums">
                @_totalVisitors.ToString("N0")
            </div>
            <div class="mt-1 text-xs text-muted-foreground">
                Across @_geoData.Length countries
            </div>
        </div>

        <div class="divide-y">
            @foreach (var geo in _geoData)
            {
                var visitorPercent = (double)geo.Visitors / _totalVisitors * 100;
                var hasHighBounce = geo.BounceRate > 50;
                var avgPerUser = ((double)geo.Sessions / geo.Visitors).ToString("F1");
                var durationMinutes = geo.AvgDuration / 60;
                var durationSeconds = geo.AvgDuration % 60;

                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@geo.Country</span>
                                <code class="font-mono text-xs text-muted-foreground">
                                    @geo.CountryCode
                                </code>
                                @if (hasHighBounce)
                                {
                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                }
                            </div>

                            <div class="mt-3 grid grid-cols-2 gap-4">
                                <div>
                                    <div class="text-xs text-muted-foreground">Visitors</div>
                                    <div class="mt-1 text-xl font-semibold tabular-nums">
                                        @geo.Visitors.ToString("N0")
                                    </div>
                                    <div class="mt-0.5 text-xs text-muted-foreground">
                                        @(visitorPercent.ToString("F1"))% of total
                                    </div>
                                </div>

                                <div>
                                    <div class="text-xs text-muted-foreground">Sessions</div>
                                    <div class="mt-1 text-xl font-semibold tabular-nums">
                                        @geo.Sessions.ToString("N0")
                                    </div>
                                    <div class="mt-0.5 text-xs text-muted-foreground">
                                        @avgPerUser avg per user
                                    </div>
                                </div>

                                <div>
                                    <div class="text-xs text-muted-foreground">Avg Duration</div>
                                    <div class="mt-1 text-sm font-semibold tabular-nums">
                                        @(durationMinutes):@(durationSeconds.ToString("D2"))
                                    </div>
                                </div>

                                <div>
                                    <div class="text-xs text-muted-foreground">Bounce Rate</div>
                                    <div class="@(Cn.Merge("mt-1 text-sm font-semibold tabular-nums", hasHighBounce ? "text-amber-500" : ""))">
                                        @(geo.BounceRate.ToString("F1"))%
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="h-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-blue-500 transition-all"
                                         style="width: @(visitorPercent.ToString("F1"))%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record GeoMetric(string Country, string CountryCode, int Visitors, int Sessions, int AvgDuration, double BounceRate);

    private static readonly GeoMetric[] _geoData =
    [
        new("United States", "US", 45230, 67840, 245, 42.3),
        new("United Kingdom", "GB", 18720, 28450, 312, 38.7),
        new("Germany", "DE", 12450, 19230, 198, 51.2),
        new("Canada", "CA", 9680, 15420, 267, 44.8),
        new("Australia", "AU", 7340, 11250, 289, 39.4),
        new("France", "FR", 6225, 9870, 234, 47.6),
    ];

    private static readonly int _totalVisitors = _geoData.Sum(g => g.Visitors);
}
