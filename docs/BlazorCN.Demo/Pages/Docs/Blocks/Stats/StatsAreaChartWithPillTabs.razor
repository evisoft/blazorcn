@* ============================================================
   Block: stats-area-chart-with-pill-tabs
   Title: StatsAreaChartWithPillTabs
   Description: A period-toggled area chart stats card for React and Next.js with a PillTabs day/week/month/year selector, NumberFlow animated summary value, and a ChartContainer-wrapped Recharts AreaChart with gradient fill built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-area-chart-with-pill-tabs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Revenue</p>
                <p class="mt-0.5 text-xs text-muted-foreground">@_summary.Timeframe</p>
            </div>
            <div class="inline-flex items-center rounded-full bg-muted p-1 text-muted-foreground" role="tablist" aria-label="Period">
                @foreach (var p in _periods)
                {
                    var period = p;
                    <button
                        role="tab"
                        aria-selected="@(_period == period ? "true" : "false")"
                        class="@(Cn.Merge("rounded-full px-3 py-1 text-xs font-medium transition-colors", _period == period ? "bg-background text-foreground shadow-sm" : "hover:text-foreground"))"
                        @onclick="@(() => SetPeriod(period))">
                        @period
                    </button>
                }
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="min-w-[180px]">
                <span class="text-3xl font-semibold tabular-nums">@FormatCurrency(_summary.Total)</span>
            </div>
            <div class="mt-1 flex items-center gap-1">
                <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                    +@(_summary.Delta)% vs previous @_period
                </span>
            </div>
        </div>

        <div class="px-4 pb-4">
            <div class="h-[200px] w-full">
                @{
                    var data = _chartData[_period];
                    var maxRevenue = data.Length > 0 ? data.Max(d => d.Revenue) : 1;
                    const int chartW = 560;
                    const int chartH = 200;
                    const int paddingLeft = 40;
                    const int paddingBottom = 24;
                    const int paddingTop = 4;
                    const int paddingRight = 0;
                    var innerW = chartW - paddingLeft - paddingRight;
                    var innerH = chartH - paddingTop - paddingBottom;
                    var stepX = data.Length > 1 ? (double)innerW / (data.Length - 1) : innerW;

                    var points = new System.Text.StringBuilder();
                    var areaPoints = new System.Text.StringBuilder();

                    for (int i = 0; i < data.Length; i++)
                    {
                        var px = paddingLeft + i * stepX;
                        var py = paddingTop + innerH - (data[i].Revenue / (double)maxRevenue) * innerH;
                        if (i == 0) areaPoints.Append(FormattableString.Invariant($"{px:F1},{chartH - paddingBottom} "));
                        points.Append(FormattableString.Invariant($"{px:F1},{py:F1} "));
                        areaPoints.Append(FormattableString.Invariant($"{px:F1},{py:F1} "));
                        if (i == data.Length - 1) areaPoints.Append(FormattableString.Invariant($"{px:F1},{chartH - paddingBottom}"));
                    }
                }
                <svg viewBox="0 0 @chartW @chartH" class="h-full w-full" aria-hidden="true">
                    <defs>
                        <linearGradient id="fill-revenue-pill" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" stop-color="var(--color-chart-1)" stop-opacity="0.35" />
                            <stop offset="100%" stop-color="var(--color-chart-1)" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    @* Horizontal grid lines *@
                    @for (int g = 0; g <= 4; g++)
                    {
                        var gy = paddingTop + (innerH / 4.0) * g;
                        <line x1="@paddingLeft" y1="@gy.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" x2="@(chartW - paddingRight)" y2="@gy.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" stroke="currentColor" stroke-opacity="0.1" stroke-dasharray="3 3" />
                    }
                    @* Area fill *@
                    <polygon points="@areaPoints.ToString()" fill="url(#fill-revenue-pill)" />
                    @* Line *@
                    <polyline points="@points.ToString()" fill="none" stroke="var(--color-chart-1)" stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
                    @* X-axis labels *@
                    @for (int i = 0; i < data.Length; i++)
                    {
                        var lx = paddingLeft + i * stepX;
                        var ly = chartH - 6;
                        @((MarkupString)FormattableString.Invariant($"<text x=\"{lx:F1}\" y=\"{ly:F1}\" text-anchor=\"middle\" font-size=\"10\" fill=\"currentColor\" opacity=\"0.5\">{data[i].Label}</text>"))
                    }
                </svg>
            </div>
        </div>
    </div>
</section>

@code {
    private record DataPoint(string Label, int Revenue);
    private record PeriodSummary(int Total, double Delta, string Timeframe);

    private static readonly string[] _periods = ["day", "week", "month", "year"];

    private static readonly System.Collections.Generic.Dictionary<string, DataPoint[]> _chartData = new()
    {
        ["day"] = [
            new("00:00", 1240),
            new("03:00", 820),
            new("06:00", 1560),
            new("09:00", 3420),
            new("12:00", 4180),
            new("15:00", 4920),
            new("18:00", 5640),
            new("21:00", 3820),
        ],
        ["week"] = [
            new("Mon", 18420),
            new("Tue", 21180),
            new("Wed", 22640),
            new("Thu", 19820),
            new("Fri", 26540),
            new("Sat", 29180),
            new("Sun", 24720),
        ],
        ["month"] = [
            new("W1", 142420),
            new("W2", 156820),
            new("W3", 168640),
            new("W4", 187420),
        ],
        ["year"] = [
            new("Q1", 420180),
            new("Q2", 518440),
            new("Q3", 604720),
            new("Q4", 687420),
        ],
    };

    private static readonly System.Collections.Generic.Dictionary<string, PeriodSummary> _periodSummary = new()
    {
        ["day"]   = new(25600,    4.8,  "Last 24 hours"),
        ["week"]  = new(162500,   8.2,  "Last 7 days"),
        ["month"] = new(655300,   12.4, "Last 30 days"),
        ["year"]  = new(2230760,  18.6, "Last 12 months"),
    };

    private string _period = "month";
    private PeriodSummary _summary => _periodSummary[_period];

    private void SetPeriod(string period)
    {
        _period = period;
    }

    private static string FormatCurrency(int value)
    {
        return value >= 1_000_000
            ? $"${value / 1_000_000.0:F2}M"
            : value >= 1_000
                ? $"${value / 1_000.0:N0}K".Replace(",", "")
                : $"${value:N0}";
    }
}
