@* ========================================
   Block: stats-projections
   Title: Stats Projections
   Description: Investment projection list with growth values and percentage badges for React finance dashboards
   Long Description: A sprint burndown chart displaying total, completed, and remaining story points with velocity tracking and days remaining built with React, Next.js, and Tailwind CSS
   Dependencies: None
   Source: original/blocks/stats/stats-projections.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Investment growth projection</p>
        </div>

        <div>
            @for (var i = 0; i < data.Length; i++)
            {
                var item = data[i];
                var isLast = i == data.Length - 1;

                <div class="@(Cn.Merge("flex items-center justify-between px-4 py-3", !isLast ? "border-b" : ""))">
                    <span class="text-sm text-muted-foreground">@item.Label</span>
                    <div class="flex items-center gap-3">
                        <span class="text-sm font-medium tabular-nums">@item.Value</span>
                        <span class="w-14 rounded bg-emerald-100 px-1.5 py-0.5 text-center text-xs font-medium tabular-nums text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">
                            @item.Percentage
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ProjectionItem(string Label, string Value, string Percentage);

    private static readonly ProjectionItem[] data = new[]
    {
        new ProjectionItem("After 1 year", "$2,400", "+8.2%"),
        new ProjectionItem("After 5 years", "$14,800", "+24.6%"),
        new ProjectionItem("After 10 years", "$38,500", "+52.1%"),
    };
}
