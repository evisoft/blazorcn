@* ========================================
   Block: stats-inventory-levels
   Title: Stats Inventory Levels
   Description: Inventory stock stats with level indicators, reorder alerts, and category tracking
   Dependencies: None
   Source: original/blocks/stats/stats-inventory-levels.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Inventory</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_totalItems.ToString("N0") total units
                </p>
            </div>
            @if (_lowStockCount > 0)
            {
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span class="text-xs font-medium text-amber-600 dark:text-amber-400">
                        @_lowStockCount need attention
                    </span>
                </div>
            }
        </div>

        <div>
            @for (var i = 0; i < _items.Length; i++)
            {
                var item = _items[i];
                var fillPercent = (double)item.Quantity / item.MaxQuantity * 100;
                var color = item.Status == "healthy" ? "bg-emerald-500" : item.Status == "low" ? "bg-amber-500" : "bg-red-500";
                var dotColor = color;

                <div class="@(Cn.Merge("px-4 py-2.5", i < _items.Length - 1 ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <div>
                            <span class="text-sm font-medium">@item.Name</span>
                            <span class="ml-2 font-mono text-xs text-muted-foreground">@item.Sku</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-sm tabular-nums">@item.Quantity.ToString("N0")</span>
                            <span class="@(Cn.Merge("size-1.5 rounded-full", dotColor))"></span>
                        </div>
                    </div>
                    <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full transition-all", color))"
                             style="width: @(fillPercent.ToString("F1"))%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record InventoryItem(string Name, string Sku, int Quantity, int MaxQuantity, string Status);

    private static readonly InventoryItem[] _items =
    [
        new("Wireless Earbuds", "WE-001", 842, 1000, "healthy"),
        new("USB-C Cables", "UC-034", 156, 500, "low"),
        new("Phone Cases", "PC-112", 23, 300, "critical"),
        new("Screen Protectors", "SP-078", 1204, 1500, "healthy"),
        new("Power Banks", "PB-056", 89, 400, "low"),
    ];

    private static readonly int _totalItems = _items.Sum(i => i.Quantity);
    private static readonly int _lowStockCount = _items.Count(i => i.Status != "healthy");
}
