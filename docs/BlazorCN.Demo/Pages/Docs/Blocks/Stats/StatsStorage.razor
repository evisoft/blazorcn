@* ========================================
   Block: stats-storage
   Title: Stats Storage
   Description: Storage usage bar with segmented breakdown and category legend for React file management dashboards
   Long Description: Stats cards with sparkline area charts, price changes, and trend visualization for React finance dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-storage.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm text-muted-foreground">
                Using
                <span class="font-semibold tabular-nums text-foreground">
                    @used.ToString("N0") @usedLabel
                </span>
                of @total @totalLabel
            </p>

            <div class="mt-3 flex h-1.5 w-full overflow-hidden rounded-full bg-muted">
                @foreach (var segment in segments)
                {
                    var percentage = (double)segment.Value / totalValue * 100;

                    <div class="@(Cn.Merge("h-full transition-all", segment.Color))"
                         style="width: @(percentage)%"></div>
                }
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
                @foreach (var segment in segments)
                {
                    <div class="flex items-center gap-2">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-sm", segment.Color))"></span>
                        <span class="text-sm text-muted-foreground">@segment.Label</span>
                        <span class="text-sm tabular-nums">
                            @segment.Value.ToString("N0") @usedLabel
                        </span>
                    </div>
                }
                <div class="flex items-center gap-2">
                    <span class="size-2 shrink-0 rounded-sm bg-muted"></span>
                    <span class="text-sm text-muted-foreground">Free</span>
                    <span class="text-sm tabular-nums">
                        @freeValue.ToString("N0") @usedLabel
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Segment(string Label, int Value, string Color);

    private static readonly Segment[] segments = new[]
    {
        new Segment("Documents", 2400, "bg-blue-500"),
        new Segment("Photos", 1800, "bg-emerald-500"),
        new Segment("Videos", 3200, "bg-amber-500"),
        new Segment("Music", 900, "bg-purple-500"),
    };

    private const int used = 8300;
    private const int total = 15;
    private const string usedLabel = "MB";
    private const string totalLabel = "GB";
    private static readonly int totalValue = total * 1000;
    private static readonly int freeValue = totalValue - used;
}
