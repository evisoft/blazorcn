@* ============================================================
   Block: stats-goal-target-with-status
   Title: StatsGoalTargetWithStatus
   Description: A goal target stats card grid for React and Next.js with per-tile semantic background tints, matching border accents, within/observe/critical statuses, and linear progress bars built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-goal-target-with-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex items-center justify-between pb-3">
        <p class="text-sm font-medium">Regional goals</p>
        <p class="text-xs text-muted-foreground">Q2 2026 · Closing Jun 30</p>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var goal in _goals)
        {
            var style = _statusStyles[goal.Status];
            var percent = (int)Math.Round((double)goal.Current / goal.Target * 100);
            <div class="@($"flex flex-col rounded-lg border px-4 py-3 {style.Tile}")">
                <div class="flex items-center justify-between gap-2">
                    <div class="truncate text-sm font-medium">@goal.Label</div>
                    <span class="@($"inline-flex items-center gap-1 text-xs font-medium capitalize {style.Text}")">
                        <LucideIconCn Name="@style.IconName" Size="12" Class="size-3" />
                        @style.Label
                    </span>
                </div>
                <p class="mt-0.5 truncate text-xs text-muted-foreground">@goal.Subtitle</p>
                <div class="mt-3 text-2xl font-semibold tabular-nums">@goal.Value</div>
                <div class="mt-1 flex items-center justify-between text-xs tabular-nums text-muted-foreground">
                    <span>@goal.Current / @goal.Target goals</span>
                    <span>@percent%</span>
                </div>
                <div aria-label="@goal.Label"
                     aria-valuemax="@goal.Target"
                     aria-valuemin="0"
                     aria-valuenow="@goal.Current"
                     class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-background/60"
                     role="progressbar">
                    <div class="@($"h-full rounded-full transition-all duration-700 ease-out {style.Bar}")"
                         style="@($"width:{percent}%")"></div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Goal(string Id, string Label, string Subtitle, string Value, int Current, int Target, string Status);

    private record StatusStyle(string Label, string IconName, string Tile, string Bar, string Text, string Dot);

    private static readonly Goal[] _goals =
    [
        new("na",    "North America", "5 of 5 goals on track",  "$412,090", 5, 5, "within"),
        new("eu",    "Europe",        "3 of 5 goals observed",  "$268,420", 3, 5, "observe"),
        new("apac",  "Asia Pacific",  "1 of 5 goals at risk",   "$112,840", 1, 5, "critical"),
        new("latam", "Latin America", "4 of 5 goals on track",  "$94,610",  4, 5, "within"),
    ];

    private static readonly Dictionary<string, StatusStyle> _statusStyles = new()
    {
        ["within"]   = new("Within",   "check-circle-2",  "border-emerald-500/40 bg-emerald-500/10", "bg-emerald-500", "text-emerald-700 dark:text-emerald-300", "bg-emerald-500"),
        ["observe"]  = new("Observe",  "clock",           "border-amber-500/40 bg-amber-500/10",     "bg-amber-500",   "text-amber-700 dark:text-amber-300",     "bg-amber-500"),
        ["critical"] = new("Critical", "alert-triangle",  "border-red-500/40 bg-red-500/10",         "bg-red-500",     "text-red-700 dark:text-red-300",         "bg-red-500"),
    };
}
