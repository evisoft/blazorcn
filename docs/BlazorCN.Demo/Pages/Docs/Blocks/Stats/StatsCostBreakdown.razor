@* ========================================
   Block: stats-cost-breakdown
   Title: Stats Cost Breakdown
   Description: Compact usage card with cost breakdown, percentage bar, and category legend
   Dependencies: None
   Source: original/blocks/stats/stats-cost-breakdown.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-sm font-medium">Usage</span>
                <span class="text-xs font-medium tabular-nums text-amber-600 dark:text-amber-400">
                    +12.5%
                </span>
            </div>
            <p class="mt-1 flex items-baseline gap-2">
                <span class="text-2xl font-semibold tabular-nums">$@_total</span>
                <span class="text-xs text-muted-foreground">this month</span>
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-xs font-medium text-muted-foreground">Resource breakdown</p>
            <div class="mt-2 flex h-1.5 overflow-hidden rounded-full bg-muted">
                @foreach (var item in _data)
                {
                    <div class="@($"h-full {item.ColorClass}")" style="@($"width: {item.Percentage}%")"></div>
                }
            </div>

            <ul class="mt-3 space-y-2">
                @foreach (var item in _data)
                {
                    <li class="flex items-center gap-2 text-sm">
                        <span aria-hidden="true" class="@($"h-2 w-2 shrink-0 rounded-sm {item.ColorClass}")"></span>
                        <span class="flex-1">@item.Label</span>
                        <span class="tabular-nums text-muted-foreground">$@item.Amount</span>
                        <span class="w-12 text-right tabular-nums text-muted-foreground">
                            @(item.Percentage)%
                        </span>
                    </li>
                }
            </ul>
        </div>

        <div class="px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Configure limits in
                <a class="text-primary hover:underline" href="#">
                    resource settings
                </a>
            </p>
        </div>
    </div>
</section>

@code {
    private record UsageItem(string Label, int Amount, double Percentage, string ColorClass);

    private static readonly UsageItem[] _data =
    [
        new("Compute", 450, 52.3, "bg-emerald-500"),
        new("Storage", 285, 33.1, "bg-amber-500"),
        new("Bandwidth", 125, 14.6, "bg-rose-500"),
    ];

    private static readonly int _total = _data.Sum(d => d.Amount);
}
