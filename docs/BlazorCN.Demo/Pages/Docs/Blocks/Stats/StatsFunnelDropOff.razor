@* ========================================
   Block: stats-funnel-drop-off
   Title: Stats Funnel Drop Off
   Description: Multi-step conversion funnel visualization with absolute numbers and drop-off rates at each stage for tracking user journey and optimizing conversion paths
   Long Description: Track revenue through funnel stages
   Dependencies: None
   Source: original/blocks/stats/stats-funnel-drop-off.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Conversion Funnel</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days performance</p>
        </div>

        <div class="border-b px-4 py-4">
            <div class="space-y-4">
                @for (int i = 0; i < _funnelSteps.Length; i++)
                {
                    var index = i;
                    var step = _funnelSteps[index];
                    var dropOffRate = GetDropOffRate(index);

                    <div>
                        @if (dropOffRate is not null)
                        {
                            <div class="mb-2 flex items-center gap-2 px-2">
                                <div class="h-px flex-1 bg-border"></div>
                                <span class="text-xs text-red-600">
                                    @($"{dropOffRate:F1}")% drop-off
                                </span>
                                <div class="h-px flex-1 bg-border"></div>
                            </div>
                        }
                        <div class="rounded-md border bg-muted/30 px-4 py-3">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-3">
                                    <div class="flex size-6 items-center justify-center rounded bg-card text-xs font-medium">
                                        @(index + 1)
                                    </div>
                                    <span class="text-sm font-medium">@step.Step</span>
                                </div>
                                <div class="text-right">
                                    <div class="text-sm font-semibold tabular-nums">
                                        @step.Count.ToString("N0")
                                    </div>
                                    <div class="text-xs text-muted-foreground">@step.Percentage%</div>
                                </div>
                            </div>
                            <div class="mt-2 h-1 overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-emerald-500"
                                     style="@($"width: {step.Percentage}%")">
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="grid grid-cols-2 gap-px bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Overall Conversion</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">10%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Total Conversions</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">1,245</p>
            </div>
        </div>
    </div>
</section>

@code {
    private record FunnelStep(string Step, int Count, int Percentage);

    private static readonly FunnelStep[] _funnelSteps =
    [
        new("Landing Page", 12450, 100),
        new("Sign Up Started", 4980, 40),
        new("Email Verified", 3735, 30),
        new("Profile Completed", 2490, 20),
        new("First Purchase", 1245, 10),
    ];

    private static double? GetDropOffRate(int index)
    {
        if (index == 0) return null;
        var current = _funnelSteps[index].Count;
        var previous = _funnelSteps[index - 1].Count;
        return (double)(previous - current) / previous * 100;
    }
}
