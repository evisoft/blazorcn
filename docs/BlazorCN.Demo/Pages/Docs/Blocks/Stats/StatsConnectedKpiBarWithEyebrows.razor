@* ============================================================
   Block: stats-connected-kpi-bar-with-eyebrows
   Title: StatsConnectedKpiBarWithEyebrows
   Description: A connected KPI bar stats strip for React and Next.js with uppercase tracking-widest eyebrows above each tile label, a shared outer border, gap-px dividers, and tabular-nums headline values built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-connected-kpi-bar-with-eyebrows.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="mb-3 flex items-end justify-between">
        <div>
            <p class="text-sm font-medium">Operations snapshot</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Q2 2026 — updated hourly</p>
        </div>
        <p class="text-xs text-muted-foreground">Last 30 days</p>
    </div>

    <dl class="grid grid-cols-1 gap-px overflow-hidden rounded-lg border bg-border sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var kpi in _kpis)
        {
            var deltaColor = kpi.Trend == TrendType.Positive
                ? "text-emerald-600 dark:text-emerald-400"
                : "text-red-600 dark:text-red-400";
            var iconName = kpi.Trend == TrendType.Positive ? "trending-up" : "trending-down";

            <div class="bg-card px-4 py-4">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    @kpi.Category
                </p>
                <dt class="mt-1 text-sm font-medium text-muted-foreground">@kpi.Label</dt>
                <dd class="mt-2 text-2xl font-semibold tabular-nums">@kpi.Value</dd>
                <div class="mt-2 flex items-center gap-1">
                    <LucideIconCn Name="@iconName" Size="14" Class="@Cn.Merge("size-3.5", deltaColor)" aria-hidden="true" />
                    <span class="@Cn.Merge("text-xs font-medium tabular-nums", deltaColor)">
                        @kpi.Delta
                    </span>
                </div>
            </div>
        }
    </dl>
</section>

@code {
    private enum TrendType { Positive, Negative }

    private record Kpi(string Id, string Category, string Label, string Value, string Delta, TrendType Trend);

    private static readonly Kpi[] _kpis =
    [
        new("revenue",   "Revenue",     "Net MRR",         "$287,654", "+8.32%",         TrendType.Positive),
        new("customers", "Customers",   "Paying accounts", "4,218",    "+124 this week", TrendType.Positive),
        new("latepay",   "Outstanding", "Late payments",   "$9,435",   "-12.64%",        TrendType.Negative),
        new("churn",     "Retention",   "Monthly churn",   "2.14%",    "-0.32pt",        TrendType.Negative),
    ];
}
