@* ============================================================
   Block: stats-line-chart-with-threshold
   Title: StatsLineChartWithThreshold
   Description: A line chart stats card for React and Next.js with a horizontal ReferenceLine SLO target, dashed threshold stroke, labeled annotation, and ChartContainer-wrapped Recharts LineChart built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-line-chart-with-threshold.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">API uptime</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 14 days vs. 99.9% SLO</p>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                @(_withinTarget ? "Within target" : "Breach")
            </span>
        </div>

        <div class="flex items-baseline gap-2 px-4 pt-4">
            <span class="text-3xl font-semibold tabular-nums">@(_latest.ToString("F2"))%</span>
            <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                +0.05% vs. yesterday
            </span>
        </div>

        <div class="px-4 pb-4 pt-3">
            <div class="h-[200px] w-full">
                <svg viewBox="0 0 560 200" class="h-full w-full overflow-visible" aria-hidden="true">
                    @* Horizontal grid lines *@
                    @foreach (var tick in _yTicks)
                    {
                        var gy = ChartY(tick);
                        <line x1="@_I(ChartLeft)" y1="@_I(gy)" x2="@_I(ChartRight)" y2="@_I(gy)"
                              stroke="var(--border)" stroke-dasharray="3 3" />
                    }

                    @* Y-axis tick labels *@
                    @foreach (var tick in _yTicks)
                    {
                        var ly = ChartY(tick);
                        @((MarkupString)$"<text x=\"{_I(ChartLeft - 4.0)}\" y=\"{_I(ly)}\" text-anchor=\"end\" dominant-baseline=\"middle\" font-size=\"10\" fill=\"var(--muted-foreground)\">{tick.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}%</text>")
                    }

                    @* X-axis tick labels — first, middle (index 6), last *@
                    @for (int xi = 0; xi < _chartData.Length; xi++)
                    {
                        if (xi == 0 || xi == 6 || xi == _chartData.Length - 1)
                        {
                            var lx = ChartX(xi);
                            @((MarkupString)$"<text x=\"{_I(lx)}\" y=\"{_I(ChartBottom + 14.0)}\" text-anchor=\"middle\" font-size=\"10\" fill=\"var(--muted-foreground)\">{_chartData[xi].Day}</text>")
                        }
                    }

                    @* SLO reference line (dashed) *@
                    @{
                        var sloY = ChartY(SLO_TARGET);
                    }
                    <line x1="@_I(ChartLeft)" y1="@_I(sloY)" x2="@_I(ChartRight)" y2="@_I(sloY)"
                          stroke="var(--muted-foreground)" stroke-dasharray="4 4" stroke-width="1.25" />

                    @* SLO label (insideTopRight) *@
                    @((MarkupString)$"<text x=\"{_I(ChartRight - 4.0)}\" y=\"{_I(sloY - 4.0)}\" text-anchor=\"end\" font-size=\"10\" fill=\"var(--muted-foreground)\">SLO {SLO_TARGET}%</text>")

                    @* Uptime line *@
                    <polyline points="@_polylinePoints"
                              fill="none"
                              stroke="oklch(0.646 0.222 41.116)"
                              stroke-width="2"
                              stroke-linejoin="round"
                              stroke-linecap="round" />
                </svg>
            </div>
        </div>
    </div>
</section>

@code {
    private record DataPoint(string Day, double Uptime);

    private const double SLO_TARGET = 99.9;

    // Chart coordinate constants
    private const double ChartLeft   = 36.0;
    private const double ChartRight  = 552.0;
    private const double ChartTop    = 12.0;
    private const double ChartBottom = 176.0;
    private const double DomainMin   = 99.7;
    private const double DomainMax   = 100.0;

    private static readonly double[] _yTicks = [99.7, 99.8, 99.9, 100.0];

    private static readonly DataPoint[] _chartData =
    [
        new("Mar 14", 99.98),
        new("Mar 15", 99.96),
        new("Mar 16", 99.94),
        new("Mar 17", 99.88),
        new("Mar 18", 99.82),
        new("Mar 19", 99.76),
        new("Mar 20", 99.84),
        new("Mar 21", 99.92),
        new("Mar 22", 99.95),
        new("Mar 23", 99.97),
        new("Mar 24", 99.98),
        new("Mar 25", 99.96),
        new("Mar 26", 99.94),
        new("Mar 27", 99.99),
    ];

    private static readonly double _latest = _chartData[^1].Uptime;
    private static readonly bool _withinTarget = _latest >= SLO_TARGET;

    private static double ChartX(int idx)
    {
        double w = ChartRight - ChartLeft;
        return ChartLeft + idx * (w / (_chartData.Length - 1));
    }

    private static double ChartY(double val)
    {
        double h = ChartBottom - ChartTop;
        return ChartTop + h - (val - DomainMin) / (DomainMax - DomainMin) * h;
    }

    // Format a double as a fixed-point string for SVG attribute values
    private static string _I(double v) =>
        v.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private static readonly string _polylinePoints = BuildPolyline();

    private static string BuildPolyline()
    {
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < _chartData.Length; i++)
        {
            if (i > 0) sb.Append(' ');
            sb.Append(ChartX(i).ToString("F1", System.Globalization.CultureInfo.InvariantCulture));
            sb.Append(',');
            sb.Append(ChartY(_chartData[i].Uptime).ToString("F1", System.Globalization.CultureInfo.InvariantCulture));
        }
        return sb.ToString();
    }
}
