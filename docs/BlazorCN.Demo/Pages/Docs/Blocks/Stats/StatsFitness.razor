@* ========================================
   Block: stats-fitness
   Title: Stats Fitness
   Description: Fitness/health stats with calories, steps, heart rate and daily goals
   Dependencies: None
   Source: original/blocks/stats/stats-fitness.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Today's Activity</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_completedGoals of @_rings.Length goals completed
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                <span class="text-sm font-semibold tabular-nums">@_heartRate</span>
                <span class="text-xs text-muted-foreground">bpm</span>
            </div>
        </div>

        <div class="px-4 py-3">
            <div class="space-y-3">
                @foreach (var ring in _rings)
                {
                    var percentage = Math.Min((double)ring.Value / ring.Goal * 100, 100);

                    <div>
                        <div class="flex items-center justify-between text-sm">
                            <div class="flex items-center gap-2">
                                <span class="@(Cn.Merge("size-2 rounded-full", ring.Color))"></span>
                                <span class="font-medium">@ring.Label</span>
                            </div>
                            <span class="tabular-nums text-muted-foreground">
                                @ring.Value.ToString("N0") / @ring.Goal.ToString("N0") @ring.Unit
                            </span>
                        </div>
                        <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                            <div class="@(Cn.Merge("h-full rounded-full transition-all", ring.Color))"
                                 style="width: @(percentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record RingData(string Label, int Value, int Goal, string Unit, string Color);

    private static readonly RingData[] _rings =
    [
        new("Calories", 420, 500, "kcal", "bg-red-500"),
        new("Steps", 6840, 10000, "steps", "bg-emerald-500"),
        new("Active", 28, 30, "min", "bg-sky-500"),
    ];

    private const int _heartRate = 72;
    private static readonly int _completedGoals = _rings.Count(r => r.Value >= r.Goal);
}
