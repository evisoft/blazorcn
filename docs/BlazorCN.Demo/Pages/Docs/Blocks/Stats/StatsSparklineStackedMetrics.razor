@* ============================================================
   Block: stats-sparkline-stacked-metrics
   Title: StatsSparklineStackedMetrics
   Description: A per-metric sparkline stats card for React and Next.js with a hero value, two stacked sub-metrics, trend-keyed gradient fills, and a ChartContainer-wrapped AreaChart built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-sparkline-stacked-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var prod in _products)
        {
            var isPositive = prod.ChangeType == "positive";
            var deltaClass = isPositive
                ? "text-emerald-600 dark:text-emerald-400"
                : "text-red-600 dark:text-red-400";
            var statusDotClass = prod.Status == "healthy" ? "bg-emerald-500" : "bg-amber-500";
            var statusTextClass = prod.Status == "healthy"
                ? "text-emerald-600 dark:text-emerald-400"
                : "text-amber-600 dark:text-amber-400";
            var trendColor = prod.TrendKey == "chart-1"
                ? "oklch(0.646 0.222 41.116)"
                : "oklch(0.6 0.118 184.704)";
            var gradientId = $"spark-{prod.Id}";
            var sessionsDeltaClass = prod.SessionsDelta.StartsWith("-")
                ? "text-red-600 dark:text-red-400"
                : "text-emerald-600 dark:text-emerald-400";
            var conversionDeltaClass = prod.ConversionDelta.StartsWith("-")
                ? "text-red-600 dark:text-red-400"
                : "text-emerald-600 dark:text-emerald-400";
            var linePath = BuildLinePath(prod.Sparkline);
            var fillPath = BuildFillPath(prod.Sparkline);
            var fillUrl = $"url(#{gradientId})";

            <div class="overflow-hidden rounded-lg border bg-card">
                <div class="flex items-start justify-between px-4 pt-3">
                    <div class="min-w-0">
                        <dt class="truncate text-sm font-medium">@prod.Name</dt>
                        <p class="mt-0.5 truncate text-xs text-muted-foreground">@prod.Category</p>
                    </div>
                    <div class="flex shrink-0 items-center gap-1.5">
                        <span aria-hidden="true" class="@(Cn.Merge("size-1.5 rounded-full", statusDotClass))"></span>
                        <span class="@(Cn.Merge("text-[10px] font-medium uppercase tracking-widest", statusTextClass))">@prod.Status</span>
                    </div>
                </div>

                <div class="px-4 pt-3">
                    <dd class="text-2xl font-semibold tabular-nums">@prod.Revenue</dd>
                    <div class="mt-1 flex items-center gap-1">
                        @if (isPositive)
                        {
                            <LucideIconCn Name="trending-up" Size="14" Class="@(Cn.Merge("size-3.5", deltaClass))" />
                        }
                        else
                        {
                            <LucideIconCn Name="trending-down" Size="14" Class="@(Cn.Merge("size-3.5", deltaClass))" />
                        }
                        <span class="@(Cn.Merge("text-xs font-medium tabular-nums", deltaClass))">@prod.Delta vs previous 7 days</span>
                    </div>
                </div>

                <dl class="mt-3 grid grid-cols-2 border-t">
                    <div class="border-r px-4 py-2.5">
                        <dt class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">Sessions</dt>
                        <dd class="mt-0.5 text-sm font-semibold tabular-nums">@prod.Sessions</dd>
                        <dd class="@(Cn.Merge("text-[11px] font-medium tabular-nums", sessionsDeltaClass))">@prod.SessionsDelta</dd>
                    </div>
                    <div class="px-4 py-2.5">
                        <dt class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">Conversion</dt>
                        <dd class="mt-0.5 text-sm font-semibold tabular-nums">@prod.Conversion</dd>
                        <dd class="@(Cn.Merge("text-[11px] font-medium tabular-nums", conversionDeltaClass))">@prod.ConversionDelta</dd>
                    </div>
                </dl>

                <div class="h-16 w-full border-t">
                    <svg viewBox="0 0 280 64" preserveAspectRatio="none" class="h-full w-full" aria-hidden="true">
                        <defs>
                            <linearGradient id="@gradientId" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="@trendColor" stop-opacity="0.35" />
                                <stop offset="100%" stop-color="@trendColor" stop-opacity="0" />
                            </linearGradient>
                        </defs>
                        <path d="@fillPath" fill="@fillUrl" stroke="none" />
                        <path d="@linePath" fill="none" stroke="@trendColor" stroke-width="1.75" />
                    </svg>
                </div>
            </div>
        }
    </dl>
</section>

@code {
    private record SparkPoint(string Day, int Trend);

    private record ProductCard(
        string Id,
        string Name,
        string Category,
        string Status,
        string Revenue,
        string Delta,
        string ChangeType,
        string Sessions,
        string SessionsDelta,
        string Conversion,
        string ConversionDelta,
        string TrendKey,
        SparkPoint[] Sparkline
    );

    private static readonly ProductCard[] _products =
    [
        new ProductCard(
            "atlas-pro", "Atlas Pro", "Project tracker", "healthy",
            "$48,320", "+12.4%", "positive",
            "18,940", "+6.1%", "4.82%", "+0.4pt", "chart-1",
            [
                new SparkPoint("Mon", 38200),
                new SparkPoint("Tue", 39850),
                new SparkPoint("Wed", 41120),
                new SparkPoint("Thu", 42780),
                new SparkPoint("Fri", 44560),
                new SparkPoint("Sat", 46910),
                new SparkPoint("Sun", 48320),
            ]
        ),
        new ProductCard(
            "forge-cli", "Forge CLI", "Developer tooling", "healthy",
            "$22,145", "+18.7%", "positive",
            "9,412", "+11.3%", "2.35%", "+0.2pt", "chart-1",
            [
                new SparkPoint("Mon", 14200),
                new SparkPoint("Tue", 15880),
                new SparkPoint("Wed", 17640),
                new SparkPoint("Thu", 19120),
                new SparkPoint("Fri", 20580),
                new SparkPoint("Sat", 21470),
                new SparkPoint("Sun", 22145),
            ]
        ),
        new ProductCard(
            "beacon-analytics", "Beacon Analytics", "BI dashboards", "warning",
            "$13,870", "-4.8%", "negative",
            "6,204", "-2.9%", "1.74%", "-0.1pt", "chart-2",
            [
                new SparkPoint("Mon", 15400),
                new SparkPoint("Tue", 15120),
                new SparkPoint("Wed", 14820),
                new SparkPoint("Thu", 14560),
                new SparkPoint("Fri", 14290),
                new SparkPoint("Sat", 14050),
                new SparkPoint("Sun", 13870),
            ]
        ),
    ];

    private static (double X, double Y)[] ComputeCoords(SparkPoint[] pts)
    {
        const double svgW = 280.0;
        const double svgH = 64.0;
        const double pad = 4.0;
        var minVal = pts.Min(p => p.Trend);
        var maxVal = pts.Max(p => p.Trend);
        var range = maxVal == minVal ? 1.0 : (double)(maxVal - minVal);
        var count = pts.Length;
        var coords = new (double X, double Y)[count];
        for (var i = 0; i < count; i++)
        {
            coords[i] = (
                pad + i * (svgW - 2 * pad) / (count - 1),
                svgH - pad - (pts[i].Trend - minVal) / range * (svgH - 2 * pad)
            );
        }
        return coords;
    }

    private static string BuildLinePath(SparkPoint[] pts)
    {
        var coords = ComputeCoords(pts);
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < coords.Length; i++)
        {
            sb.Append(i == 0
                ? $"M {coords[i].X:F1},{coords[i].Y:F1}"
                : $" L {coords[i].X:F1},{coords[i].Y:F1}");
        }
        return sb.ToString();
    }

    private static string BuildFillPath(SparkPoint[] pts)
    {
        const double svgH = 64.0;
        var coords = ComputeCoords(pts);
        var linePath = BuildLinePath(pts);
        return $"{linePath} L {coords[^1].X:F1},{svgH} L {coords[0].X:F1},{svgH} Z";
    }
}
