@* ========================================
   Block: stats-podcast-analytics
   Title: Stats Podcast Analytics
   Description: Podcast analytics with episode downloads, retention, completion, and subscriber growth
   Dependencies: None
   Source: original/blocks/stats/stats-podcast-analytics.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Podcast Analytics</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days performance</p>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Total Downloads</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">42.5K</p>
                <p class="mt-0.5 text-xs text-emerald-600">+12.3%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Avg Retention</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">75.8%</p>
                <p class="mt-0.5 text-xs text-emerald-600">+3.2%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Completion</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">64.0%</p>
                <p class="mt-0.5 text-xs text-amber-600">-1.5%</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-xs text-muted-foreground">Subscribers</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">8.2K</p>
                <p class="mt-0.5 text-xs text-emerald-600">+245</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h3 class="text-sm font-medium">Recent Episodes</h3>
                <span class="text-xs text-muted-foreground">Last 4 episodes</span>
            </div>
        </div>

        <div class="border-b">
            @for (var i = 0; i < _episodes.Length; i++)
            {
                var episode = _episodes[i];
                var isLast = i == _episodes.Length - 1;
                var trendColor = episode.Trend switch { "up" => "bg-emerald-500", "down" => "bg-red-500", _ => "bg-blue-500" };
                <div class="@($"px-4 py-2.5 {(isLast ? "" : "border-b")}")">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@episode.Title</span>
                                <span class="@($"h-1.5 w-1.5 shrink-0 rounded-full {trendColor}")"></span>
                            </div>
                            <div class="mt-1.5 grid grid-cols-3 gap-3">
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Downloads</p>
                                    <p class="mt-0.5 text-sm tabular-nums">@episode.Downloads.ToString("N0")</p>
                                </div>
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Retention</p>
                                    <p class="mt-0.5 text-sm tabular-nums">@(episode.Retention)%</p>
                                </div>
                                <div>
                                    <p class="text-xs font-medium text-muted-foreground">Completion</p>
                                    <p class="mt-0.5 text-sm tabular-nums">@(episode.Completion)%</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="px-4 py-3">
            <h3 class="text-sm font-medium">Listener Retention</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">Episode completion distribution</p>
            <div class="mt-3 space-y-2">
                @foreach (var segment in _listenerSegments)
                {
                    <div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">@segment.Duration</span>
                            <span class="tabular-nums">@segment.Listeners.ToString("N0") listeners</span>
                        </div>
                        <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-muted">
                            <div class="@($"h-full {segment.Color}")" style="@($"width: {segment.Percentage}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record EpisodeData(string Title, int Downloads, int Retention, int Completion, string Trend);
    private record ListenerSegment(string Duration, int Percentage, int Listeners, string Color);

    private static readonly EpisodeData[] _episodes =
    [
        new("Building Scalable APIs", 12847, 78, 65, "up"),
        new("React Server Components Deep Dive", 9234, 82, 71, "up"),
        new("Database Optimization Tips", 8901, 68, 52, "down"),
        new("TypeScript Best Practices", 11543, 75, 68, "stable"),
    ];

    private static readonly ListenerSegment[] _listenerSegments =
    [
        new("0-25%", 15, 2341, "bg-red-500"),
        new("25-50%", 22, 3425, "bg-amber-500"),
        new("50-75%", 28, 4356, "bg-blue-500"),
        new("75-100%", 35, 5445, "bg-emerald-500"),
    ];
}
