@* ========================================
   Block: stats-comparison
   Title: Stats Comparison
   Description: Stats comparison cards with current vs previous values and trend badges
   Dependencies: None
   Source: original/blocks/stats/stats-comparison.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-lg border bg-border sm:grid-cols-2 md:grid-cols-3">
        @foreach (var item in _stats)
        {
            <div class="bg-card px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-muted-foreground">@item.Metric</span>
                    <span class="@($"text-xs font-medium tabular-nums {(item.TrendUp ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")}")">
                        @item.Difference
                    </span>
                </div>
                <p class="mt-1 text-2xl font-semibold tabular-nums">@item.Current</p>
                <p class="mt-0.5 text-xs text-muted-foreground">from @item.Previous</p>
            </div>
        }
    </div>
</section>

@code {
    private record StatItem(string Metric, string Current, string Previous, string Difference, bool TrendUp);

    private static readonly StatItem[] _stats =
    [
        new("Active Users", "128,456", "115,789", "+10.9%", true),
        new("Conversion Rate", "5.32%", "6.18%", "-0.86%", false),
        new("Avg. Session Duration", "3m 42s", "3m 15s", "+13.8%", true),
    ];
}
