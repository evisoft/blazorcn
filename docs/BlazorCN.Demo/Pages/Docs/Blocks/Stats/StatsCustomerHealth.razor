@* ========================================
   Block: stats-customer-health
   Title: Stats Customer Health
   Description: Customer health scores with risk indicators, expansion and contraction signals, and engagement metrics
   Dependencies: None
   Source: original/blocks/stats/stats-customer-health.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Customer Health Overview</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_customerData.Length active customers &#x2022; $@((_totalMRR / 1000.0).ToString("F1"))K total MRR
            </p>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Avg Health</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="@(Cn.Merge("text-2xl font-semibold tabular-nums", _avgHealthScore >= 80 ? "text-emerald-600" : _avgHealthScore >= 60 ? "text-amber-600" : "text-red-600"))">
                        @((int)_avgHealthScore)
                    </span>
                    <span class="text-xs text-muted-foreground">/ 100</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Healthy</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@_healthyCustomers</span>
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">At Risk</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@_atRiskCustomers</span>
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Critical</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@_criticalCustomers</span>
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                </div>
            </div>
        </div>

        @if (_expansionOpportunities > 0)
        {
            <div class="border-b bg-emerald-500/10 px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="size-2 rounded-full bg-emerald-500"></span>
                    <span class="text-sm font-medium">
                        @_expansionOpportunities expansion @(_expansionOpportunities == 1 ? "opportunity" : "opportunities") identified
                    </span>
                </div>
            </div>
        }

        <div>
            <div class="border-b px-4 py-3">
                <div class="text-xs font-medium text-muted-foreground">Customer Health Scores</div>
            </div>
            <div>
                @for (var i = 0; i < _customerData.Length; i++)
                {
                    var customer = _customerData[i];
                    var healthColor = customer.HealthScore >= 80 ? "emerald" : customer.HealthScore >= 60 ? "amber" : "red";

                    <div class="@(Cn.Merge("px-4 py-3", i < _customerData.Length - 1 ? "border-b" : ""))">
                        <div class="mb-2 flex items-start justify-between gap-3">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@customer.Company</span>
                                    <span class="@(Cn.Merge("size-1.5 rounded-full", $"bg-{healthColor}-500"))"></span>
                                    @if (customer.Expansion)
                                    {
                                        <span class="rounded bg-emerald-500/10 px-1.5 py-0.5 font-mono text-xs text-emerald-600">
                                            Expansion
                                        </span>
                                    }
                                    @if (customer.Risk)
                                    {
                                        <span class="rounded bg-red-500/10 px-1.5 py-0.5 font-mono text-xs text-red-600">
                                            Risk
                                        </span>
                                    }
                                </div>
                                <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                    <span>@customer.Plan</span>
                                    <span>&#x2022;</span>
                                    <span>$@customer.Mrr/mo</span>
                                    <span>&#x2022;</span>
                                    <span>@customer.LastActivity</span>
                                </div>
                            </div>
                            <div class="shrink-0 text-right">
                                <div class="@(Cn.Merge("text-sm font-medium tabular-nums", healthColor == "emerald" ? "text-emerald-600" : healthColor == "amber" ? "text-amber-600" : "text-red-600"))">
                                    @customer.HealthScore
                                </div>
                                <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                    <span class="@(Cn.Merge("text-xs", customer.Trend == "up" ? "text-emerald-600" : customer.Trend == "down" ? "text-red-600" : ""))">
                                        @(customer.Trend == "up" ? "\u2191" : customer.Trend == "down" ? "\u2193" : "\u2192")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-3 gap-3 text-xs">
                            <div>
                                <div class="text-muted-foreground">Usage</div>
                                <div class="mt-1">
                                    <div class="h-1 overflow-hidden rounded-full bg-muted">
                                        <div class="@(Cn.Merge("h-full", customer.Usage >= 80 ? "bg-emerald-500" : customer.Usage >= 60 ? "bg-amber-500" : "bg-red-500"))"
                                             style="width: @(customer.Usage)%"></div>
                                    </div>
                                    <div class="mt-0.5 font-medium tabular-nums">@customer.Usage%</div>
                                </div>
                            </div>
                            <div>
                                <div class="text-muted-foreground">Engagement</div>
                                <div class="mt-1">
                                    <div class="h-1 overflow-hidden rounded-full bg-muted">
                                        <div class="@(Cn.Merge("h-full", customer.Engagement >= 80 ? "bg-emerald-500" : customer.Engagement >= 60 ? "bg-amber-500" : "bg-red-500"))"
                                             style="width: @(customer.Engagement)%"></div>
                                    </div>
                                    <div class="mt-0.5 font-medium tabular-nums">@customer.Engagement%</div>
                                </div>
                            </div>
                            <div>
                                <div class="text-muted-foreground">Support</div>
                                <div class="mt-1">
                                    <div class="h-1 overflow-hidden rounded-full bg-muted">
                                        <div class="@(Cn.Merge("h-full", customer.Support >= 80 ? "bg-emerald-500" : customer.Support >= 60 ? "bg-amber-500" : "bg-red-500"))"
                                             style="width: @(customer.Support)%"></div>
                                    </div>
                                    <div class="mt-0.5 font-medium tabular-nums">@customer.Support%</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record CustomerHealth(string Company, string Plan, int HealthScore, int Mrr, string Trend, int Usage, int Engagement, int Support, bool Expansion, bool Risk, string LastActivity);

    private static readonly CustomerHealth[] _customerData =
    [
        new("Acme Corporation", "Enterprise", 94, 4800, "up", 98, 92, 88, true, false, "2 hours ago"),
        new("TechStart Inc", "Pro", 58, 480, "down", 42, 58, 74, false, true, "5 days ago"),
        new("Design Studio Co", "Team", 86, 1200, "stable", 88, 84, 86, false, false, "4 hours ago"),
        new("Global Solutions Ltd", "Enterprise", 72, 6400, "down", 78, 68, 70, false, false, "1 day ago"),
        new("Startup Labs", "Pro", 91, 680, "up", 94, 88, 92, true, false, "1 hour ago"),
    ];

    private static readonly int _healthyCustomers = _customerData.Count(c => c.HealthScore >= 80);
    private static readonly int _atRiskCustomers = _customerData.Count(c => c.HealthScore >= 60 && c.HealthScore < 80);
    private static readonly int _criticalCustomers = _customerData.Count(c => c.HealthScore < 60);
    private static readonly int _expansionOpportunities = _customerData.Count(c => c.Expansion);
    private static readonly double _avgHealthScore = _customerData.Average(c => c.HealthScore);
    private static readonly int _totalMRR = _customerData.Sum(c => c.Mrr);
}