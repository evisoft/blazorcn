@* ============================================================
   Block: stats-kpi-icon-tile-grid
   Title: StatsKpiIconTileGrid
   Description: A KPI tile grid stats block for React and Next.js with muted-square lucide icon badges, tabular-nums metric values, and semantic change deltas built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-kpi-icon-tile-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var metric in _metrics)
        {
            var deltaClass = metric.ChangeType == ChangeType.Positive
                ? "text-emerald-600 dark:text-emerald-400"
                : "text-red-600 dark:text-red-400";
            var trendIcon = metric.ChangeType == ChangeType.Positive ? "trending-up" : "trending-down";

            <div class="rounded-lg border bg-card px-4 py-4">
                <div class="flex items-start justify-between gap-3">
                    <span aria-hidden="true" class="flex size-8 items-center justify-center rounded-md bg-muted">
                        <LucideIconCn Name="@metric.Icon" Size="16" Class="size-4 text-muted-foreground" />
                    </span>
                    <div class="@Cn.Merge("flex items-center gap-1", deltaClass)">
                        <LucideIconCn Name="@trendIcon" Size="12" Class="size-3" aria-hidden="true" />
                        <span class="text-xs font-medium tabular-nums">@metric.Change</span>
                    </div>
                </div>

                <div class="mt-4">
                    <dt class="text-sm font-medium text-muted-foreground">@metric.Label</dt>
                    <dd class="mt-1 text-2xl font-semibold tabular-nums">@metric.Value</dd>
                    <dd class="mt-0.5 text-xs text-muted-foreground">@metric.Sublabel</dd>
                </div>
            </div>
        }
    </dl>
</section>

@code {
    private enum ChangeType { Positive, Negative }

    private record KpiMetric(string Id, string Label, string Value, string Change, ChangeType ChangeType, string Icon, string Sublabel);

    private static readonly KpiMetric[] _metrics =
    [
        new("mrr",        "Monthly recurring revenue", "$187,420", "+12.4%", ChangeType.Positive, "dollar-sign",  "vs. last 30 days"),
        new("dau",        "Daily active users",        "48,372",   "+6.1%",  ChangeType.Positive, "users",        "vs. 7-day avg"),
        new("conversion", "Trial to paid conversion",  "3.82%",    "-0.4%",  ChangeType.Negative, "zap",          "vs. previous cohort"),
        new("churn",      "Net revenue churn",         "1.12%",    "-0.3%",  ChangeType.Positive, "trending-down","vs. last quarter"),
    ];
}
