@* ============================================================
   Block: stats-funnel-split-cohorts
   Title: StatsFunnelSplitCohorts
   Description: A split-cohort funnel stats card for React and Next.js with parallel mobile and desktop bars at every stage, proportional stage widths, inline conversion percentages, and a delta column comparing the two cohorts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-funnel-split-cohorts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Checkout funnel by device</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Last 30 days · Mobile vs desktop cohorts
                </p>
            </div>
            <div class="text-right">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Overall
                </p>
                <p class="mt-0.5 text-xs font-medium tabular-nums text-muted-foreground">
                    <span class="text-emerald-600 dark:text-emerald-400">
                        @overallDesktop%
                    </span>
                    @(" / ")
                    <span class="text-blue-600 dark:text-blue-400">@overallMobile%</span>
                </p>
            </div>
        </div>

        <div class="grid grid-cols-[1fr_auto_1fr_auto] items-center gap-x-3 border-b px-4 py-2">
            <div class="flex items-center justify-end gap-1.5 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                <LucideIconCn Name="monitor" Size="12" Class="size-3" aria-hidden="true" />
                Desktop
            </div>
            <div class="w-16"></div>
            <div class="flex items-center gap-1.5 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                <LucideIconCn Name="smartphone" Size="12" Class="size-3" aria-hidden="true" />
                Mobile
            </div>
            <div class="w-10 text-right text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Δ
            </div>
        </div>

        <div class="divide-y">
            @for (var i = 0; i < _stages.Length; i++)
            {
                var stage = _stages[i];
                var prev = i == 0 ? null : (FunnelStage?)_stages[i - 1];
                var mobilePercent = (double)stage.Mobile / _topMobile * 100;
                var desktopPercent = (double)stage.Desktop / _topDesktop * 100;
                var mobileConv = prev.HasValue ? (double)stage.Mobile / prev.Value.Mobile * 100 : 100.0;
                var desktopConv = prev.HasValue ? (double)stage.Desktop / prev.Value.Desktop * 100 : 100.0;
                var delta = desktopPercent - mobilePercent;
                var deltaPositive = delta >= 0;
                var deltaText = (deltaPositive ? "+" : "") + ((int)Math.Round(delta)).ToString();
                var deltaClass = deltaPositive
                    ? "text-emerald-600 dark:text-emerald-400"
                    : "text-red-600 dark:text-red-400";

                <div class="grid grid-cols-[1fr_auto_1fr_auto] items-center gap-x-3 px-4 py-3">
                    @* Desktop bar (right-aligned) *@
                    <div class="flex items-center justify-end gap-2">
                        <span class="text-xs text-muted-foreground tabular-nums">
                            @(i == 0 ? "—" : ((int)Math.Round(desktopConv)).ToString() + "%")
                        </span>
                        <span class="text-xs font-medium tabular-nums">
                            @stage.Desktop.ToString("N0")
                        </span>
                        <div class="relative h-5 w-28 overflow-hidden rounded-sm bg-muted">
                            <div role="progressbar"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 aria-valuenow="@((int)Math.Round(desktopPercent))"
                                 class="ml-auto h-full rounded-sm bg-emerald-500/80 transition-all duration-700 ease-out"
                                 style="@($"width:{desktopPercent:F1}%")">
                            </div>
                        </div>
                    </div>

                    @* Stage name center column *@
                    <div class="min-w-[88px] text-center">
                        <p class="text-[11px] font-medium">@stage.Name</p>
                    </div>

                    @* Mobile bar (left-aligned) *@
                    <div class="flex items-center gap-2">
                        <div class="relative h-5 w-28 overflow-hidden rounded-sm bg-muted">
                            <div role="progressbar"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 aria-valuenow="@((int)Math.Round(mobilePercent))"
                                 class="h-full rounded-sm bg-blue-500/80 transition-all duration-700 ease-out"
                                 style="@($"width:{mobilePercent:F1}%")">
                            </div>
                        </div>
                        <span class="text-xs font-medium tabular-nums">
                            @stage.Mobile.ToString("N0")
                        </span>
                        <span class="text-xs text-muted-foreground tabular-nums">
                            @(i == 0 ? "—" : ((int)Math.Round(mobileConv)).ToString() + "%")
                        </span>
                    </div>

                    @* Delta *@
                    <span class="@Cn.Merge("w-10 text-right text-xs font-medium tabular-nums", deltaClass)">
                        @deltaText
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record struct FunnelStage(string Id, string Name, int Mobile, int Desktop);

    private static readonly FunnelStage[] _stages =
    [
        new("visit",    "Visited",            48_200, 21_400),
        new("product",  "Viewed product",     24_100, 14_980),
        new("cart",     "Added to cart",       8_420,  6_720),
        new("checkout", "Started checkout",    3_210,  3_890),
        new("purchase", "Completed purchase",  1_240,  2_620),
    ];

    private static readonly int _topMobile  = _stages[0].Mobile;
    private static readonly int _topDesktop = _stages[0].Desktop;

    private static readonly string overallMobile  =
        ((double)_stages[^1].Mobile  / _topMobile  * 100).ToString("F1");
    private static readonly string overallDesktop =
        ((double)_stages[^1].Desktop / _topDesktop * 100).ToString("F1");
}
