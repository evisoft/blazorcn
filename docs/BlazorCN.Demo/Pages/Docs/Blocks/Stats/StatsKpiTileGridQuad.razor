@* ============================================================
   Block: stats-kpi-tile-grid-quad
   Title: StatsKpiTileGridQuad
   Description: A 2x2 KPI tile grid stats block for React and Next.js with four standalone bordered tiles, tabular-nums headline values, semantic delta pills, and lucide trend icons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-kpi-tile-grid-quad.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="mb-3 flex items-end justify-between px-1">
        <div>
            <p class="text-sm font-medium">Overview</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days vs previous period</p>
        </div>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        @foreach (var metric in _metrics)
        {
            var deltaClass = metric.IsPositive
                ? "text-emerald-600 dark:text-emerald-400"
                : "text-red-600 dark:text-red-400";
            var iconName = metric.IsPositive ? "trending-up" : "trending-down";
            <div class="rounded-lg border bg-card px-4 py-4">
                <div class="text-sm font-medium text-muted-foreground">@metric.Label</div>
                <div class="mt-2 flex items-baseline justify-between gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@metric.Value</span>
                    <span class="@($"inline-flex items-center gap-1 text-xs font-medium tabular-nums {deltaClass}")">
                        <LucideIconCn Name="@iconName" Size="14" Class="size-3.5" aria-hidden="true" />
                        @metric.Change
                    </span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record KpiMetric(string Id, string Label, string Value, string Change, bool IsPositive);

    private static readonly KpiMetric[] _metrics =
    [
        new("mrr", "Monthly recurring revenue", "$187,420", "+12.4%", true),
        new("active-accounts", "Active accounts", "8,342", "+4.1%", true),
        new("churn", "Churn rate", "2.18%", "-0.6%", true),
        new("nps", "NPS score", "62", "-3.0%", false),
    ];
}
