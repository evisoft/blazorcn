@* ============================================================
   Block: stats-hero-metric-tile-row
   Title: StatsHeroMetricTileRow
   Description: A hero metric stats card for React and Next.js with a text-4xl NumberFlow animated headline, a semantic delta indicator, and a connected bar of three supporting KPI tiles below split by gap-px borders built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-hero-metric-tile-row.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-5 py-5 sm:px-6 sm:py-6">
            <p class="text-sm font-medium">Monthly recurring revenue</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days vs previous period</p>
            <div class="mt-4 min-w-[180px]">
                <span class="text-4xl font-semibold tabular-nums">@FormatCurrency(HeroValue)</span>
            </div>
            <div class="mt-2 flex items-center gap-1.5">
                <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
                <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                    +@HeroChange% vs previous 30 days
                </span>
            </div>
        </div>

        <dl class="grid grid-cols-1 gap-px overflow-hidden border-t bg-border sm:grid-cols-3">
            @foreach (var tile in SupportingTiles)
            {
                <div class="bg-card px-4 py-3">
                    <div class="flex items-center justify-between">
                        <dt class="text-xs font-medium text-muted-foreground">@tile.Label</dt>
                        <span class="@(tile.ChangeType == "positive" ? "text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400" : "text-xs font-medium tabular-nums text-red-600 dark:text-red-400")">
                            @tile.Change
                        </span>
                    </div>
                    <dd class="mt-1 min-w-[100px]">
                        <span class="text-2xl font-semibold tabular-nums">@FormatTileValue(tile)</span>
                    </dd>
                </div>
            }
        </dl>
    </div>
</section>

@code {
    private record SupportingTile(string Id, string Label, double Value, string Format, string ChangeType, string Change);

    private const int HeroValue = 187_420;
    private const double HeroChange = 12.4;

    private static readonly SupportingTile[] SupportingTiles =
    [
        new("new",       "New MRR",   34_820, "currency", "positive", "+18.2%"),
        new("expansion", "Expansion", 12_640, "currency", "positive", "+6.1%"),
        new("churn",     "Churn rate",   2.3, "percent",  "negative", "+0.4pt"),
    ];

    private static string FormatCurrency(double value) =>
        value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"));

    private static string FormatTileValue(SupportingTile tile) => tile.Format switch
    {
        "currency" => tile.Value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US")),
        "percent"  => tile.Value.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "%",
        _          => tile.Value.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("en-US")),
    };
}
