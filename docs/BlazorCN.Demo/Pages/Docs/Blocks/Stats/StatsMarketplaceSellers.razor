@* ========================================
   Block: stats-marketplace-sellers
   Title: Stats Marketplace Sellers
   Description: A marketplace seller leaderboard component showing top sellers with revenue, items sold, rating, and fulfillment rate for Next.js e-commerce platforms
   Long Description: Customer loyalty program dashboard with points balance, tier status, redemption rates, and active member distribution for retention marketing
   Dependencies: None
   Source: original/blocks/stats/stats-marketplace-sellers.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-medium">Top Sellers</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days</p>
                </div>
                <div class="text-right">
                    <div class="text-2xl font-semibold tabular-nums">
                        $@((totalRevenue / 1000).ToString("F0"))K
                    </div>
                    <p class="text-xs text-muted-foreground">Total Revenue</p>
                </div>
            </div>
        </div>

        <div>
            @for (var i = 0; i < sellersData.Length; i++)
            {
                var seller = sellersData[i];
                var isLast = i == sellersData.Length - 1;

                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                    <div class="mb-2 flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <div class="flex size-6 items-center justify-center rounded-full bg-muted text-xs font-semibold tabular-nums text-muted-foreground">
                                @seller.Rank
                            </div>
                            <span class="text-sm font-medium">@seller.Name</span>
                        </div>
                        <div class="text-sm font-semibold tabular-nums">
                            $@(((double)seller.Revenue / 1000).ToString("F1"))K
                        </div>
                    </div>

                    <div class="ml-9 grid grid-cols-3 gap-3">
                        <div>
                            <div class="text-xs text-muted-foreground">Items Sold</div>
                            <div class="mt-0.5 text-xs font-semibold tabular-nums">
                                @seller.ItemsSold.ToString("N0")
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-muted-foreground">Rating</div>
                            <div class="mt-0.5 flex items-center gap-1">
                                <span class="text-xs font-semibold tabular-nums">@seller.Rating</span>
                                <span class="text-xs text-muted-foreground">/5.0</span>
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-muted-foreground">Fulfillment</div>
                            <div class="mt-0.5 flex items-center gap-1">
                                <span class="@(Cn.Merge("size-1.5 rounded-full", seller.FulfillmentRate >= 95 ? "bg-emerald-500" : seller.FulfillmentRate >= 90 ? "bg-amber-500" : "bg-red-500"))"></span>
                                <span class="text-xs font-semibold tabular-nums">
                                    @seller.FulfillmentRate%
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Seller(string Id, int Rank, string Name, int Revenue, int ItemsSold, double Rating, int FulfillmentRate);

    private static readonly Seller[] sellersData = new[]
    {
        new Seller("1", 1, "TechGear Pro", 284500, 1243, 4.9, 98),
        new Seller("2", 2, "HomeStyle Decor", 198300, 2156, 4.8, 95),
        new Seller("3", 3, "Fashion Forward", 167200, 3421, 4.7, 92),
        new Seller("4", 4, "Outdoor Adventure Co", 143800, 987, 4.9, 97),
        new Seller("5", 5, "Beauty Essentials", 129600, 2834, 4.6, 89),
    };

    private static readonly int totalRevenue = sellersData.Sum(s => s.Revenue);
}
