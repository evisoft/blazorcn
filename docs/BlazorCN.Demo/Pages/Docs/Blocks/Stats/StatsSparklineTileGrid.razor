@* ============================================================
   Block: stats-sparkline-tile-grid
   Title: StatsSparklineTileGrid
   Description: A sparkline tile grid stats component for React and Next.js with independent ChartContainer mini area charts per tile, trend-keyed gradient fills via var(--chart-N), and NumberFlow animated KPI values built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-sparkline-tile-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var metric in _metrics)
        {
            var isPositive = metric.ChangeType == "positive";
            var gradientId = $"spark-{metric.Id}";
            var colorVar = isPositive ? "oklch(0.6 0.118 184.704)" : "oklch(0.646 0.222 41.116)";
            var badgeClass = isPositive
                ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                : "bg-red-500/10 text-red-600 dark:text-red-400";
            var deltaStr = (metric.Delta > 0 ? "+" : "") + metric.Delta.ToString(metric.Format == MetricFormat.Percent ? "F2" : "F1");
            var deltaSuffix = metric.Format == MetricFormat.Percent ? "pp" : "%";
            var formattedValue = FormatValue(metric);
            var svgPath = BuildSparklinePath(metric.Series, 300, 64);
            var svgFill = BuildSparklineFill(metric.Series, 300, 64);

            <div class="overflow-hidden rounded-lg border bg-card" key="@metric.Id">
                <div class="px-4 pt-3">
                    <div class="flex items-start justify-between gap-2">
                        <dt class="text-sm font-medium text-muted-foreground">@metric.Label</dt>
                        <div class="@(Cn.Merge("inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs font-medium tabular-nums", badgeClass))">
                            @if (isPositive)
                            {
                                <LucideIconCn Name="trending-up" Size="12" Class="size-3" aria-hidden="true" />
                            }
                            else
                            {
                                <LucideIconCn Name="trending-down" Size="12" Class="size-3" aria-hidden="true" />
                            }
                            @deltaStr@deltaSuffix
                        </div>
                    </div>

                    <dd class="mt-1 flex items-baseline gap-1">
                        <div class="min-w-[120px]">
                            <span class="text-2xl font-semibold tabular-nums text-foreground">@formattedValue</span>
                        </div>
                        @if (metric.Format == MetricFormat.Percent)
                        {
                            <span class="text-sm font-medium tabular-nums text-muted-foreground">%</span>
                        }
                        @if (!string.IsNullOrEmpty(metric.Unit))
                        {
                            <span class="text-sm font-medium tabular-nums text-muted-foreground">@metric.Unit</span>
                        }
                    </dd>
                </div>

                <div class="mt-2 h-16 w-full">
                    <svg viewBox="0 0 300 64" preserveAspectRatio="none" class="h-full w-full" aria-hidden="true">
                        <defs>
                            <linearGradient id="@gradientId" x1="0" x2="0" y1="0" y2="1">
                                <stop offset="0%" stop-color="@colorVar" stop-opacity="0.35" />
                                <stop offset="100%" stop-color="@colorVar" stop-opacity="0" />
                            </linearGradient>
                        </defs>
                        <path d="@svgFill" fill="url(#@gradientId)" stroke="none" />
                        <path d="@svgPath" fill="none" stroke="@colorVar" stroke-width="1.5" />
                    </svg>
                </div>
            </div>
        }
    </dl>
</section>

@code {
    private enum MetricFormat { Currency, Number, Percent, Duration }

    private record SparklinePoint(int T, int V);

    private record Metric(
        string Id,
        string Label,
        double Value,
        MetricFormat Format,
        string? Unit,
        double Delta,
        string ChangeType,
        SparklinePoint[] Series
    );

    private static readonly Metric[] _metrics =
    [
        new("mrr", "MRR", 187420, MetricFormat.Currency, null, 12.4, "positive", [
            new(1, 142), new(2, 149), new(3, 151), new(4, 148), new(5, 156),
            new(6, 162), new(7, 168), new(8, 171), new(9, 175), new(10, 181),
            new(11, 184), new(12, 187),
        ]),
        new("dau", "Daily active users", 48372, MetricFormat.Number, null, 6.1, "positive", [
            new(1, 41), new(2, 43), new(3, 42), new(4, 44), new(5, 45),
            new(6, 44), new(7, 46), new(8, 47), new(9, 46), new(10, 48),
            new(11, 47), new(12, 48),
        ]),
        new("churn", "Churn rate", 2.4, MetricFormat.Percent, null, -0.6, "positive", [
            new(1, 31), new(2, 30), new(3, 29), new(4, 28), new(5, 29),
            new(6, 27), new(7, 26), new(8, 27), new(9, 25), new(10, 24),
            new(11, 25), new(12, 24),
        ]),
        new("latency", "p99 latency", 412, MetricFormat.Duration, "ms", 8.2, "negative", [
            new(1, 38), new(2, 36), new(3, 37), new(4, 39), new(5, 38),
            new(6, 40), new(7, 39), new(8, 41), new(9, 40), new(10, 41),
            new(11, 40), new(12, 41),
        ]),
        new("conversion", "Conversion rate", 3.8, MetricFormat.Percent, null, 0.5, "positive", [
            new(1, 31), new(2, 32), new(3, 32), new(4, 33), new(5, 34),
            new(6, 35), new(7, 34), new(8, 36), new(9, 37), new(10, 36),
            new(11, 38), new(12, 38),
        ]),
        new("error-rate", "Error rate", 0.18, MetricFormat.Percent, null, -0.04, "positive", [
            new(1, 24), new(2, 26), new(3, 25), new(4, 23), new(5, 22),
            new(6, 24), new(7, 21), new(8, 20), new(9, 22), new(10, 19),
            new(11, 18), new(12, 18),
        ]),
    ];

    private static string FormatValue(Metric metric)
    {
        return metric.Format switch
        {
            MetricFormat.Currency => "$" + ((long)metric.Value).ToString("N0"),
            MetricFormat.Percent => metric.Value.ToString("F2"),
            MetricFormat.Number => ((long)metric.Value).ToString("N0"),
            MetricFormat.Duration => ((long)metric.Value).ToString("N0"),
            _ => metric.Value.ToString()
        };
    }

    private static string BuildSparklinePath(SparklinePoint[] series, double width, double height)
    {
        if (series.Length == 0) return "";
        var minV = double.MaxValue;
        var maxV = double.MinValue;
        foreach (var p in series) { if (p.V < minV) minV = p.V; if (p.V > maxV) maxV = p.V; }
        var range = maxV - minV;
        if (range == 0) range = 1;
        var pad = height * 0.1;
        var usableH = height - pad * 2;
        var xStep = width / (series.Length - 1);
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < series.Length; i++)
        {
            var x = i * xStep;
            var y = pad + usableH * (1 - (series[i].V - minV) / range);
            sb.Append(i == 0 ? $"M {x:F1} {y:F1}" : $" L {x:F1} {y:F1}");
        }
        return sb.ToString();
    }

    private static string BuildSparklineFill(SparklinePoint[] series, double width, double height)
    {
        if (series.Length == 0) return "";
        var linePath = BuildSparklinePath(series, width, height);
        return $"{linePath} L {width:F1} {height:F1} L 0 {height:F1} Z";
    }
}
