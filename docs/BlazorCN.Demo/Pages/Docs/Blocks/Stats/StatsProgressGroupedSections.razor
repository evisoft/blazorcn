@* ============================================================
   Block: stats-progress-grouped-sections
   Title: StatsProgressGroupedSections
   Description: A progress list stats block for React and Next.js with uppercase section eyebrows, grouped linear progress bars, tabular-nums ratios, and threshold-aware bar colors built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-progress-grouped-sections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Q2 quota attainment</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    New deals closed vs. regional target
                </p>
            </div>
            <div class="text-right">
                <p class="text-sm font-semibold tabular-nums">
                    @_totalCurrent / @_totalTarget
                </p>
                <p class="text-xs text-muted-foreground tabular-nums">@_overallPct% overall</p>
            </div>
        </div>

        <div>
            @foreach (var sec in _sections)
            {
                var sectionIndex = Array.IndexOf(_sections, sec);
                <div class="@Cn.Merge("", sectionIndex > 0 ? "border-t" : "")">
                    <div class="bg-muted/30 px-4 py-2">
                        <h3 class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                            @sec.Title
                        </h3>
                    </div>
                    <div>
                        @foreach (var row in sec.Rows)
                        {
                            var rowIndex = Array.IndexOf(sec.Rows, row);
                            var ratio = (double)row.Current / row.Target;
                            var pct = (int)Math.Min(100, Math.Round(ratio * 100));
                            var barClass = GetBarClass(ratio);
                            <div class="@Cn.Merge("px-4 py-3", rowIndex < sec.Rows.Length - 1 ? "border-b" : "")">
                                <div class="flex items-center justify-between gap-4">
                                    <span class="text-sm font-medium">@row.Label</span>
                                    <span class="text-xs text-muted-foreground tabular-nums">
                                        @row.Current / @row.Target
                                    </span>
                                </div>
                                <div class="mt-2 flex items-center gap-3">
                                    <div
                                        aria-valuemax="@row.Target"
                                        aria-valuemin="0"
                                        aria-valuenow="@row.Current"
                                        class="h-1.5 w-full overflow-hidden rounded-full bg-muted"
                                        role="progressbar">
                                        <div
                                            class="@Cn.Merge("h-full rounded-full transition-all duration-700 ease-out", barClass)"
                                            style="@($"width:{pct}%")">
                                        </div>
                                    </div>
                                    <span class="w-10 shrink-0 text-right text-xs font-medium tabular-nums text-muted-foreground">
                                        @(pct)%
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ProgressRow(string Id, string Label, int Current, int Target);
    private record ProgressSection(string Id, string Title, ProgressRow[] Rows);

    private static readonly ProgressSection[] _sections =
    [
        new("na", "North America", [
            new("na-us", "United States", 182, 200),
            new("na-ca", "Canada", 58, 60),
            new("na-mx", "Mexico", 29, 45),
        ]),
        new("eu", "Europe", [
            new("eu-uk", "United Kingdom", 96, 100),
            new("eu-de", "Germany", 71, 90),
            new("eu-fr", "France", 44, 80),
        ]),
        new("apac", "Asia Pacific", [
            new("apac-jp", "Japan", 52, 60),
            new("apac-sg", "Singapore", 18, 40),
        ]),
    ];

    private static readonly int _totalCurrent = _sections.Sum(s => s.Rows.Sum(r => r.Current));
    private static readonly int _totalTarget = _sections.Sum(s => s.Rows.Sum(r => r.Target));
    private static readonly int _overallPct = (int)Math.Round((double)_totalCurrent / _totalTarget * 100);

    private static string GetBarClass(double ratio)
    {
        if (ratio >= 0.9) return "bg-emerald-500/80";
        if (ratio >= 0.6) return "bg-amber-500/80";
        return "bg-red-500/80";
    }
}
