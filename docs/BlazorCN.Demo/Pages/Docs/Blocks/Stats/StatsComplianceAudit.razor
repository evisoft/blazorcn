@* ========================================
   Block: stats-compliance-audit
   Title: Stats Compliance Audit
   Description: Regulatory compliance scores by category including GDPR, SOC2, HIPAA with status indicators and audit findings for Next.js dashboards
   Long Description: Feedback and satisfaction scores
   Dependencies: None
   Source: original/blocks/stats/stats-compliance-audit.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Compliance Audit Overview</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_complianceData.Length frameworks &#x2022; @_totalControls total controls
            </p>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Overall Score</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="@(Cn.Merge("text-2xl font-semibold tabular-nums", _overallScore >= 90 ? "text-emerald-600" : _overallScore >= 75 ? "text-amber-600" : "text-red-600"))">
                        @((int)_overallScore)
                    </span>
                    <span class="text-xs text-muted-foreground">%</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Controls</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@_totalImplemented</span>
                    <span class="text-xs text-muted-foreground">/@_totalControls</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Findings</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@_totalFindings</span>
                    @if (_criticalFindings > 0)
                    {
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                    }
                </div>
            </div>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            <div class="bg-card px-4 py-2.5">
                <div class="flex items-center gap-1.5">
                    <span class="size-2 rounded-full bg-red-500"></span>
                    <span class="text-xs text-muted-foreground">Critical</span>
                </div>
                <div class="mt-1 text-sm font-medium tabular-nums">@_criticalFindings</div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="flex items-center gap-1.5">
                    <span class="size-2 rounded-full bg-amber-500"></span>
                    <span class="text-xs text-muted-foreground">High</span>
                </div>
                <div class="mt-1 text-sm font-medium tabular-nums">@_highFindings</div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="flex items-center gap-1.5">
                    <span class="size-2 rounded-full bg-blue-500"></span>
                    <span class="text-xs text-muted-foreground">Medium</span>
                </div>
                <div class="mt-1 text-sm font-medium tabular-nums">@_mediumFindings</div>
            </div>
            <div class="bg-card px-4 py-2.5">
                <div class="flex items-center gap-1.5">
                    <span class="size-2 rounded-full bg-muted-foreground/40"></span>
                    <span class="text-xs text-muted-foreground">Low</span>
                </div>
                <div class="mt-1 text-sm font-medium tabular-nums">@_lowFindings</div>
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-3">
                <div class="text-xs font-medium text-muted-foreground">
                    Framework Compliance Status
                </div>
            </div>
            <div>
                @for (var i = 0; i < _complianceData.Length; i++)
                {
                    var framework = _complianceData[i];
                    var implementationRate = (double)framework.ControlsImplemented / framework.ControlsTotal * 100;

                    <div class="@(Cn.Merge("px-4 py-3", i < _complianceData.Length - 1 ? "border-b" : ""))">
                        <div class="mb-2 flex items-start justify-between">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@framework.Framework</span>
                                    <span class="@(Cn.Merge("size-1.5 rounded-full", framework.Status == "compliant" ? "bg-emerald-500" : framework.Status == "in-progress" ? "bg-amber-500" : "bg-red-500"))"></span>
                                </div>
                                <div class="mt-0.5 text-xs text-muted-foreground">
                                    @framework.Description
                                </div>
                            </div>
                            <div class="ml-4 text-right">
                                <div class="@(Cn.Merge("text-sm font-medium tabular-nums", framework.Score >= 90 ? "text-emerald-600" : framework.Score >= 75 ? "text-amber-600" : "text-red-600"))">
                                    @framework.Score%
                                </div>
                                <div class="text-xs text-muted-foreground">@framework.LastAudit</div>
                            </div>
                        </div>

                        <div class="mb-2">
                            <div class="mb-1 flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">Control Implementation</span>
                                <span class="font-medium tabular-nums">
                                    @framework.ControlsImplemented/@framework.ControlsTotal (@((int)implementationRate)%)
                                </span>
                            </div>
                            <div class="h-1 overflow-hidden rounded-full bg-muted">
                                <div class="@(Cn.Merge("h-full", implementationRate >= 90 ? "bg-emerald-500" : implementationRate >= 75 ? "bg-amber-500" : "bg-red-500"))"
                                     style="width: @(implementationRate.ToString("F1"))%"></div>
                            </div>
                        </div>

                        <div class="flex items-center gap-3 text-xs">
                            @if (framework.FindingsCritical > 0)
                            {
                                <div class="flex items-center gap-1.5">
                                    <span class="size-1.5 rounded-full bg-red-500"></span>
                                    <span class="text-muted-foreground">
                                        @framework.FindingsCritical critical
                                    </span>
                                </div>
                            }
                            @if (framework.FindingsHigh > 0)
                            {
                                <div class="flex items-center gap-1.5">
                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                    <span class="text-muted-foreground">
                                        @framework.FindingsHigh high
                                    </span>
                                </div>
                            }
                            @if (framework.FindingsMedium > 0)
                            {
                                <div class="flex items-center gap-1.5">
                                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                                    <span class="text-muted-foreground">
                                        @framework.FindingsMedium medium
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ComplianceFramework(string Framework, string Description, int Score, int ControlsImplemented, int ControlsTotal, int FindingsCritical, int FindingsHigh, int FindingsMedium, int FindingsLow, string Status, string LastAudit);

    private static readonly ComplianceFramework[] _complianceData =
    [
        new("SOC 2 Type II", "Security, Availability, Processing Integrity", 94, 142, 148, 0, 2, 4, 8, "compliant", "January 2026"),
        new("GDPR", "General Data Protection Regulation", 88, 78, 86, 1, 3, 6, 12, "in-progress", "December 2025"),
        new("HIPAA", "Health Insurance Portability and Accountability", 92, 64, 68, 0, 1, 5, 6, "compliant", "February 2026"),
        new("ISO 27001", "Information Security Management", 76, 98, 114, 2, 8, 14, 18, "in-progress", "November 2025"),
    ];

    private static readonly int _totalControls = _complianceData.Sum(f => f.ControlsTotal);
    private static readonly int _totalImplemented = _complianceData.Sum(f => f.ControlsImplemented);
    private static readonly double _overallScore = _complianceData.Average(f => f.Score);
    private static readonly int _totalFindings = _complianceData.Sum(f => f.FindingsCritical + f.FindingsHigh + f.FindingsMedium + f.FindingsLow);
    private static readonly int _criticalFindings = _complianceData.Sum(f => f.FindingsCritical);
    private static readonly int _highFindings = _complianceData.Sum(f => f.FindingsHigh);
    private static readonly int _mediumFindings = _complianceData.Sum(f => f.FindingsMedium);
    private static readonly int _lowFindings = _complianceData.Sum(f => f.FindingsLow);
}
