@* ========================================
   Block: stats-plan-overview
   Title: Stats Plan Overview
   Description: Plan overview stats with usage indicators and capacity percentages for React subscription dashboards
   Long Description: Sales velocity metrics dashboard with average deal size, win rate, sales cycle length, and deals per month for revenue forecasting and sales performance
   Dependencies: None
   Source: original/blocks/stats/stats-plan-overview.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Plan overview</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                You are currently on the
                <span class="font-medium text-foreground">starter plan</span>.
                <a class="text-primary hover:underline" href="#">
                    View other plans
                </a>
            </p>
        </div>

        <div>
            @for (var i = 0; i < data.Length; i++)
            {
                var item = data[i];
                var isLast = i == data.Length - 1;

                <div class="@(Cn.Merge("px-4 py-3", !isLast ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium">@item.Name</span>
                        <span class="text-xs tabular-nums text-muted-foreground">
                            @item.Current of @item.Allowed used
                        </span>
                    </div>
                    <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-primary transition-all"
                             style="width: @(item.Capacity)%"></div>
                    </div>
                    <p class="mt-1.5 text-xs tabular-nums text-muted-foreground">
                        @item.Capacity% capacity
                    </p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PlanItem(string Name, int Capacity, int Current, int Allowed);

    private static readonly PlanItem[] data = new[]
    {
        new PlanItem("Workspaces", 20, 1, 5),
        new PlanItem("Dashboards", 10, 2, 20),
        new PlanItem("Chart widgets", 30, 15, 50),
        new PlanItem("Storage", 50, 25, 100),
    };
}
