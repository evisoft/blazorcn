@* ============================================================
   Block: stats-timeline-event-card
   Title: StatsTimelineEventCard
   Description: A vertical timeline stats card for React and Next.js with status-colored circular nodes on a connector line, event details with timestamps and values, a pulsing current-event indicator, and semantic emerald blue muted status encoding built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-timeline-event-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-md p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Deployment pipeline</p>
                <p class="mt-0.5 text-xs text-muted-foreground">deploy-2026-04-12-001</p>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full bg-blue-500/10 px-2 py-0.5 text-xs font-medium text-blue-600 dark:text-blue-400">
                <span class="relative flex size-1.5">
                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-blue-500/60 opacity-75"></span>
                    <span class="relative inline-flex size-1.5 rounded-full bg-blue-500"></span>
                </span>
                In progress
            </span>
        </div>
        <div class="px-4 py-4">
            <ol class="relative space-y-0">
                @foreach (var evtOuter in _events)
                {
                    var evt = evtOuter;
                    var isLast = evt.Id == _events[_events.Length - 1].Id;
                    var style = _statusStyles[evt.Status];

                    <li class="relative flex gap-3 pb-4 last:pb-0">
                        @* Connector line *@
                        @if (!isLast)
                        {
                            <div class="absolute left-[9px] top-5 h-[calc(100%-12px)] w-px bg-border"></div>
                        }
                        @* Node *@
                        <div class="relative z-10 flex size-[18px] shrink-0 items-center justify-center">
                            @if (evt.Status == EventStatus.Current)
                            {
                                <span class="relative flex size-[18px]">
                                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-blue-500/40 opacity-75"></span>
                                    <span class="@Cn.Merge("relative inline-flex size-[18px] items-center justify-center rounded-full", style.Dot)">
                                        <LucideIconCn Name="@style.IconName" Size="10" Class="size-2.5 text-white" aria-hidden="true" />
                                    </span>
                                </span>
                            }
                            else
                            {
                                <span class="@Cn.Merge("flex size-[18px] items-center justify-center rounded-full", style.Dot)">
                                    <LucideIconCn Name="@style.IconName" Size="10" Class="@Cn.Merge("size-2.5", evt.Status == EventStatus.Completed ? "text-white" : "text-muted-foreground")" aria-hidden="true" />
                                </span>
                            }
                        </div>
                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between">
                                <p class="@Cn.Merge("text-sm font-medium", style.Text)">@evt.Label</p>
                                <span class="text-xs text-muted-foreground tabular-nums">@evt.Timestamp</span>
                            </div>
                            @if (!string.IsNullOrEmpty(evt.Value))
                            {
                                <p class="mt-0.5 text-xs text-muted-foreground">@evt.Value</p>
                            }
                        </div>
                    </li>
                }
            </ol>
        </div>
    </div>
</section>

@code {
    private enum EventStatus { Completed, Current, Upcoming }

    private record TimelineEvent(string Id, string Label, string Timestamp, string Value, EventStatus Status);

    private record StatusStyle(string Dot, string Text, string IconName);

    private static readonly TimelineEvent[] _events =
    [
        new("e1", "Build started",          "14:02", "commit a3f8c2d",          EventStatus.Completed),
        new("e2", "Tests passed",           "14:05", "142 tests · 0 failures",  EventStatus.Completed),
        new("e3", "Image built",            "14:08", "245 MB",                  EventStatus.Completed),
        new("e4", "Deploying to staging",   "14:10", "us-east-1",               EventStatus.Current),
        new("e5", "Smoke tests",            "—",     "",                        EventStatus.Upcoming),
        new("e6", "Promote to production",  "—",     "",                        EventStatus.Upcoming),
    ];

    private static readonly Dictionary<EventStatus, StatusStyle> _statusStyles = new()
    {
        [EventStatus.Completed] = new("bg-emerald-500",          "text-foreground",       "check"),
        [EventStatus.Current]   = new("bg-blue-500",             "text-foreground",       "circle-dot"),
        [EventStatus.Upcoming]  = new("bg-muted-foreground/30",  "text-muted-foreground", "clock"),
    };
}
