@* ============================================================
   Block: stats-live-realtime-counter
   Title: StatsLiveRealtimeCounter
   Description: A live realtime counter stats card for React and Next.js with a NumberFlow animated big value, a single pulsing emerald live dot, a client-only setInterval tick, and an em-dash placeholder until first paint built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-live-realtime-counter.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-md p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="radio" Size="14" Class="size-3.5 text-muted-foreground" />
                <p class="text-sm font-medium">Concurrent viewers</p>
            </div>
            <div class="flex items-center gap-1.5">
                <span aria-label="Live" class="relative flex size-2" role="img">
                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-500/60 opacity-75"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
                </span>
                <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">Live</span>
            </div>
        </div>

        <div class="px-5 py-6">
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                Worldwide stream
            </p>
            <div aria-live="polite" class="mt-2 flex min-h-[48px] min-w-[200px] items-baseline">
                @if (!_initialized)
                {
                    <span class="text-4xl font-semibold tabular-nums text-muted-foreground">—</span>
                }
                else
                {
                    <span class="text-4xl font-semibold tabular-nums">@_count.ToString("N0")</span>
                }
            </div>
            <p class="mt-2 text-xs text-muted-foreground">
                Streaming now from 47 countries · Peak today 21,480
            </p>
        </div>
    </div>
</section>

@code {
    private const int InitialCount = 18_742;
    private int _count = InitialCount;
    private bool _initialized = false;
    private Timer? _timer;
    private readonly Random _rng = new();

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _initialized = true;
            _count = InitialCount;
            _timer = new Timer(Tick, null, 1400, 1400);
            StateHasChanged();
        }
    }

    private void Tick(object? _)
    {
        var delta = (int)Math.Floor((_count * 0.0007 + 3) * _rng.NextDouble());
        _count += delta;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
