@* ========================================
   Block: stats-email-metrics
   Title: Stats Email Metrics
   Description: Email campaign performance tracking showing open rates, click rates, bounces, and unsubscribes
   Dependencies: None
   Source: original/blocks/stats/stats-email-metrics.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Email Campaign Performance</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Engagement metrics across all campaigns
            </p>
        </div>

        <div class="divide-y">
            @foreach (var campaign in _campaigns)
            {
                var openRate = (double)campaign.Opened / campaign.Delivered * 100;
                var clickRate = (double)campaign.Clicked / campaign.Delivered * 100;
                var bounceRate = (double)campaign.Bounced / campaign.Sent * 100;
                var unsubRate = (double)campaign.Unsubscribed / campaign.Delivered * 100;
                var hasLowOpen = openRate < 15;
                var hasHighBounce = bounceRate > 2;
                var hasHighUnsub = unsubRate > 0.5;

                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@campaign.Name</span>
                                @if (hasLowOpen || hasHighBounce || hasHighUnsub)
                                {
                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                }
                            </div>
                            <div class="mt-1 text-xs text-muted-foreground">
                                Sent to @campaign.Sent.ToString("N0") recipients
                            </div>

                            <div class="mt-3 grid grid-cols-2 gap-4">
                                <div>
                                    <div class="text-xs text-muted-foreground">Open Rate</div>
                                    <div class="@(Cn.Merge("mt-1 text-xl font-semibold tabular-nums", hasLowOpen ? "text-amber-500" : openRate >= 25 ? "text-emerald-500" : ""))">
                                        @(openRate.ToString("F1"))%
                                    </div>
                                    <div class="mt-0.5 text-xs text-muted-foreground">
                                        @campaign.Opened.ToString("N0") opened
                                    </div>
                                </div>

                                <div>
                                    <div class="text-xs text-muted-foreground">Click Rate</div>
                                    <div class="mt-1 text-xl font-semibold tabular-nums">
                                        @(clickRate.ToString("F1"))%
                                    </div>
                                    <div class="mt-0.5 text-xs text-muted-foreground">
                                        @campaign.Clicked.ToString("N0") clicked
                                    </div>
                                </div>

                                <div>
                                    <div class="text-xs text-muted-foreground">Bounce Rate</div>
                                    <div class="@(Cn.Merge("mt-1 text-sm font-semibold tabular-nums", hasHighBounce ? "text-red-500" : ""))">
                                        @(bounceRate.ToString("F2"))%
                                    </div>
                                    <div class="mt-0.5 text-xs text-muted-foreground">
                                        @campaign.Bounced.ToString("N0") bounced
                                    </div>
                                </div>

                                <div>
                                    <div class="text-xs text-muted-foreground">Unsubscribe Rate</div>
                                    <div class="@(Cn.Merge("mt-1 text-sm font-semibold tabular-nums", hasHighUnsub ? "text-red-500" : ""))">
                                        @(unsubRate.ToString("F2"))%
                                    </div>
                                    <div class="mt-0.5 text-xs text-muted-foreground">
                                        @campaign.Unsubscribed.ToString("N0") unsubscribed
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record EmailCampaign(string Name, int Sent, int Delivered, int Opened, int Clicked, int Bounced, int Unsubscribed);

    private static readonly EmailCampaign[] _campaigns =
    [
        new("Product Launch Announcement", 45230, 44890, 12450, 3240, 340, 89),
        new("Weekly Newsletter #142", 38720, 38520, 9680, 1940, 200, 156),
        new("Flash Sale - 48hr Only", 52340, 51890, 18160, 7260, 450, 234),
        new("Customer Survey Request", 12450, 12380, 4330, 1730, 70, 34),
    ];
}
