@* ========================================
   Block: stats-ranking
   Title: Stats Ranking
   Description: Percentile ranking stats with position indicator, peer comparison, and tier badges
   Dependencies: None
   Source: original/blocks/stats/stats-ranking.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Rank header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-sm font-medium">Your Ranking</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        out of @_totalUsers.ToString("N0")
                    </p>
                </div>
                <div class="text-right">
                    <p class="text-2xl font-semibold tabular-nums">#@_rank</p>
                    <p class="mt-0.5 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                        Up @_rankChange places
                    </p>
                </div>
            </div>
        </div>

        @* Percentile bar *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span>Percentile</span>
                <span class="font-medium text-foreground">Top @(100 - _percentile)%</span>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-primary transition-all"
                     style="@($"width: {_percentile}%")"></div>
            </div>
        </div>

        @* Nearby users *@
        <div class="px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Nearby</p>
            <div class="space-y-1">
                @foreach (var user in _nearbyUsers)
                {
                    <div class="@($"flex items-center gap-3 rounded-md px-2 py-1.5 text-sm {(user.IsYou ? "bg-muted/50" : "")}")">
                        <span class="w-7 tabular-nums text-muted-foreground">@user.Rank</span>
                        <span class="@($"flex-1 truncate {(user.IsYou ? "font-medium" : "text-muted-foreground")}")">
                            @user.Name
                        </span>
                        <span class="tabular-nums text-muted-foreground">@user.Score</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record NearbyUser(string Name, string Score, int Rank, bool IsYou = false);

    private const int _percentile = 87;
    private const int _rank = 142;
    private const int _totalUsers = 1089;
    private const int _rankChange = 14; // 156 - 142

    private static readonly NearbyUser[] _nearbyUsers =
    [
        new("Alex Chen", "8,580", 140),
        new("Sarah Kim", "8,510", 141),
        new("You", "8,420", 142, IsYou: true),
        new("Mike Ross", "8,380", 143),
        new("Emma Liu", "8,290", 144),
    ];
}
