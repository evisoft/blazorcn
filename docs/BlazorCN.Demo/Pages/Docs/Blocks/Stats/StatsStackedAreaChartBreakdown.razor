@* ============================================================
   Block: stats-stacked-area-chart-breakdown
   Title: StatsStackedAreaChartBreakdown
   Description: A stacked area chart stats card for React and Next.js with three cumulative series layered via ChartContainer, var(--chart-1 through 3) gradient fills, a CartesianGrid with horizontal-only dashed lines, and a pill legend below the chart built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-stacked-area-chart-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Sessions by channel</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days, stacked</p>
            </div>
            <p class="text-2xl font-semibold tabular-nums">141,370</p>
        </div>

        <div class="px-4 py-4">
            <div class="h-[200px] w-full">
                <svg viewBox="0 0 600 200" class="h-full w-full" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="fill-direct" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" stop-color="var(--chart-1)" stop-opacity="0.45" />
                            <stop offset="100%" stop-color="var(--chart-1)" stop-opacity="0" />
                        </linearGradient>
                        <linearGradient id="fill-organic" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" stop-color="var(--chart-2)" stop-opacity="0.45" />
                            <stop offset="100%" stop-color="var(--chart-2)" stop-opacity="0" />
                        </linearGradient>
                        <linearGradient id="fill-paid" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" stop-color="var(--chart-3)" stop-opacity="0.45" />
                            <stop offset="100%" stop-color="var(--chart-3)" stop-opacity="0" />
                        </linearGradient>
                    </defs>

                    @* Horizontal grid lines *@
                    @foreach (var gridY in _gridLines)
                    {
                        <line x1="0" y1="@gridY.ToString(System.Globalization.CultureInfo.InvariantCulture)" x2="600" y2="@gridY.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                              stroke="currentColor" stroke-width="0.5" class="text-border"
                              stroke-dasharray="3 3" />
                    }

                    @* Stacked area: paid (bottom) *@
                    <path d="@_paidAreaPath" fill="url(#fill-paid)" />
                    <path d="@_paidLinePath" fill="none" stroke="var(--chart-3)" stroke-width="2" />

                    @* Stacked area: organic (middle) *@
                    <path d="@_organicAreaPath" fill="url(#fill-organic)" />
                    <path d="@_organicLinePath" fill="none" stroke="var(--chart-2)" stroke-width="2" />

                    @* Stacked area: direct (top) *@
                    <path d="@_directAreaPath" fill="url(#fill-direct)" />
                    <path d="@_directLinePath" fill="none" stroke="var(--chart-1)" stroke-width="2" />

                    @* X-axis tick labels *@
                    @foreach (var tick in _xTicks)
                    {
                        @((MarkupString)FormattableString.Invariant($"<text x=\"{tick.X}\" y=\"196\" font-size=\"10\" fill=\"currentColor\" class=\"text-muted-foreground\" text-anchor=\"middle\">{tick.Label}</text>"))
                    }
                </svg>
            </div>
        </div>

        <div class="flex flex-wrap items-center gap-2 border-t px-4 py-3">
            @foreach (var series in _seriesLegend)
            {
                <span class="inline-flex items-center gap-2 rounded-full border bg-background px-2.5 py-1 text-xs">
                    <span aria-hidden="true" class="size-2 rounded-full" style="@($"background-color: var({series.ColorVar})")"></span>
                    <span class="font-medium">@series.Label</span>
                    <span class="text-muted-foreground tabular-nums">@series.Total</span>
                </span>
            }
        </div>
    </div>
</section>

@code {
    private record DataPoint(string Date, int Direct, int Organic, int Paid);
    private record SeriesLegendItem(string Key, string Label, string Total, string ColorVar);
    private record XTick(double X, string Label);

    private static readonly DataPoint[] _chartData =
    [
        new("Mar 14", 1820, 3120, 1240),
        new("Mar 16", 2010, 3240, 1480),
        new("Mar 18", 1940, 3560, 1610),
        new("Mar 20", 2230, 3810, 1790),
        new("Mar 22", 2380, 4120, 1850),
        new("Mar 24", 2560, 4380, 1920),
        new("Mar 26", 2710, 4520, 2040),
        new("Mar 28", 2890, 4740, 2180),
        new("Mar 30", 3020, 4960, 2260),
        new("Apr 1",  3180, 5140, 2310),
        new("Apr 3",  3260, 5360, 2430),
        new("Apr 5",  3410, 5580, 2520),
        new("Apr 7",  3580, 5820, 2610),
        new("Apr 9",  3720, 6040, 2740),
        new("Apr 11", 3890, 6280, 2860),
    ];

    private static readonly SeriesLegendItem[] _seriesLegend =
    [
        new("direct",  "Direct",         "41,620", "--chart-1"),
        new("organic", "Organic search", "68,890", "--chart-2"),
        new("paid",    "Paid ads",       "30,860", "--chart-3"),
    ];

    // SVG viewport: 600 wide, 185 tall for data area (0-185), then 15px for x-axis labels
    private const double _svgWidth  = 600.0;
    private const double _dataHeight = 180.0;
    private const double _topPad    = 4.0;

    private static readonly double[] _gridLines = [_topPad, _topPad + _dataHeight * 0.25, _topPad + _dataHeight * 0.5, _topPad + _dataHeight * 0.75, _topPad + _dataHeight];

    // Compute stacked max to scale Y
    private static readonly double _maxStack = _chartData.Max(d => (double)(d.Direct + d.Organic + d.Paid));

    private static double ScaleY(double value) => _topPad + _dataHeight - (value / _maxStack * _dataHeight);

    private static double XPos(int i) => i * (_svgWidth / (_chartData.Length - 1));

    // Stacked values per point
    private static double PaidTop(int i)    => _chartData[i].Paid;
    private static double OrganicTop(int i) => _chartData[i].Paid + _chartData[i].Organic;
    private static double DirectTop(int i)  => _chartData[i].Paid + _chartData[i].Organic + _chartData[i].Direct;

    // Build smooth monotone-like line using simple linear segments (no cubic needed for static display)
    private static string BuildLinePath(System.Func<int, double> stackedValue)
    {
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < _chartData.Length; i++)
        {
            double x = XPos(i);
            double y = ScaleY(stackedValue(i));
            sb.Append(i == 0 ? FormattableString.Invariant($"M {x:F1},{y:F1}") : FormattableString.Invariant($" L {x:F1},{y:F1}"));
        }
        return sb.ToString();
    }

    private static string BuildAreaPath(System.Func<int, double> topValue, System.Func<int, double> bottomValue)
    {
        var sb = new System.Text.StringBuilder();
        // Forward pass (top line)
        for (int i = 0; i < _chartData.Length; i++)
        {
            double x = XPos(i);
            double y = ScaleY(topValue(i));
            sb.Append(i == 0 ? FormattableString.Invariant($"M {x:F1},{y:F1}") : FormattableString.Invariant($" L {x:F1},{y:F1}"));
        }
        // Reverse pass (bottom line, closing the area)
        for (int i = _chartData.Length - 1; i >= 0; i--)
        {
            double x = XPos(i);
            double y = ScaleY(bottomValue(i));
            sb.Append(FormattableString.Invariant($" L {x:F1},{y:F1}"));
        }
        sb.Append(" Z");
        return sb.ToString();
    }

    // Paid series sits on baseline (0)
    private static string _paidLinePath    => BuildLinePath(i => PaidTop(i));
    private static string _paidAreaPath    => BuildAreaPath(i => PaidTop(i), _ => 0.0);

    // Organic series sits on top of paid
    private static string _organicLinePath => BuildLinePath(i => OrganicTop(i));
    private static string _organicAreaPath => BuildAreaPath(i => OrganicTop(i), i => PaidTop(i));

    // Direct series sits on top of organic+paid
    private static string _directLinePath  => BuildLinePath(i => DirectTop(i));
    private static string _directAreaPath  => BuildAreaPath(i => DirectTop(i), i => OrganicTop(i));

    // X-axis ticks: show first, middle-ish, and last labels
    private static readonly XTick[] _xTicks =
    [
        new(XPos(0),  _chartData[0].Date),
        new(XPos(4),  _chartData[4].Date),
        new(XPos(7),  _chartData[7].Date),
        new(XPos(11), _chartData[11].Date),
        new(XPos(14), _chartData[14].Date),
    ];
}
