@* ========================================
   Block: stats-classroom-attendance
   Title: Stats Classroom Attendance
   Description: Student attendance tracking with present, absent, and late counts, weekly patterns, and class performance metrics for Next.js education apps
   Long Description: Environmental impact stats with emissions breakdown, sustainability score, and reduction tracking for React green dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-classroom-attendance.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Classroom Attendance</h3>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Today • @classData.Length classes • @totalEnrolled students enrolled
            </p>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Present</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@totalPresent</span>
                    <span class="text-xs text-emerald-600">@(overallAttendanceRate.ToString("F1"))%</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Absent</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@totalAbsent</span>
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Late</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@totalLate</span>
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                </div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Excused</div>
                <div class="mt-1 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@totalExcused</span>
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">
                    Weekly Attendance Pattern
                </span>
                <span class="text-xs text-muted-foreground">
                    Avg @(avgWeeklyAttendance.ToString("F1"))%
                </span>
            </div>
            <div class="flex items-end justify-between gap-2">
                @foreach (var day in weeklyPattern)
                {
                    var heightPercentage = day.AttendanceRate / 100.0 * 100;

                    <div class="flex-1 text-center">
                        <div class="mb-2 flex h-24 items-end">
                            <div class="w-full">
                                <div
                                    class="@(Cn.Merge("mx-auto w-full rounded-sm", day.AttendanceRate >= 95 ? "bg-emerald-500" : day.AttendanceRate >= 90 ? "bg-amber-500" : "bg-red-500"))"
                                    style="height: @(heightPercentage.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%">
                                </div>
                            </div>
                        </div>
                        <div class="text-xs font-medium">@day.Day</div>
                        <div class="text-xs text-muted-foreground">
                            @(day.AttendanceRate.ToString("F1"))%
                        </div>
                    </div>
                }
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-3">
                <div class="text-xs font-medium text-muted-foreground">Attendance by Class</div>
            </div>
            <div>
                @for (var i = 0; i < classData.Length; i++)
                {
                    var classItem = classData[i];
                    var attendanceRate = (double)classItem.Present / classItem.Enrolled * 100;
                    var hasIssues = classItem.Absent > 2 || attendanceRate < 90;

                    <div class="@(Cn.Merge("px-4 py-2.5", i < classData.Length - 1 ? "border-b" : ""))">
                        <div class="mb-2 flex items-start justify-between">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@classItem.ClassName</span>
                                    @if (hasIssues)
                                    {
                                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                                    }
                                </div>
                                <div class="mt-0.5 text-xs text-muted-foreground">
                                    @classItem.Period • @classItem.Enrolled enrolled
                                </div>
                            </div>
                            <div class="ml-4 text-right">
                                <div class="@(Cn.Merge("text-sm font-medium tabular-nums", attendanceRate >= 95 ? "text-emerald-600" : attendanceRate >= 90 ? "text-amber-600" : "text-red-600"))">
                                    @(attendanceRate.ToString("F1"))%
                                </div>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 text-xs">
                            <div class="flex items-center gap-1.5">
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                <span class="text-muted-foreground">@classItem.Present present</span>
                            </div>
                            @if (classItem.Absent > 0)
                            {
                                <div class="flex items-center gap-1.5">
                                    <span class="size-1.5 rounded-full bg-red-500"></span>
                                    <span class="text-muted-foreground">@classItem.Absent absent</span>
                                </div>
                            }
                            @if (classItem.Late > 0)
                            {
                                <div class="flex items-center gap-1.5">
                                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                                    <span class="text-muted-foreground">@classItem.Late late</span>
                                </div>
                            }
                            @if (classItem.Excused > 0)
                            {
                                <div class="flex items-center gap-1.5">
                                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                                    <span class="text-muted-foreground">@classItem.Excused excused</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ClassAttendance(string ClassName, string Period, int Enrolled, int Present, int Absent, int Late, int Excused);
    private record WeeklyPatternItem(string Day, double AttendanceRate);

    private static readonly ClassAttendance[] classData = new[]
    {
        new ClassAttendance("Mathematics 101", "Period 1", 28, 26, 1, 1, 0),
        new ClassAttendance("English Literature", "Period 2", 32, 29, 2, 1, 0),
        new ClassAttendance("Biology Lab", "Period 3", 24, 22, 1, 0, 1),
        new ClassAttendance("World History", "Period 4", 30, 27, 2, 1, 0),
        new ClassAttendance("Physical Education", "Period 5", 35, 31, 3, 1, 0),
    };

    private static readonly WeeklyPatternItem[] weeklyPattern = new[]
    {
        new WeeklyPatternItem("Mon", 91.2),
        new WeeklyPatternItem("Tue", 94.8),
        new WeeklyPatternItem("Wed", 95.4),
        new WeeklyPatternItem("Thu", 94.1),
        new WeeklyPatternItem("Fri", 89.7),
    };

    private static readonly int totalEnrolled = classData.Sum(c => c.Enrolled);
    private static readonly int totalPresent = classData.Sum(c => c.Present);
    private static readonly int totalAbsent = classData.Sum(c => c.Absent);
    private static readonly int totalLate = classData.Sum(c => c.Late);
    private static readonly int totalExcused = classData.Sum(c => c.Excused);

    private static readonly double overallAttendanceRate = (double)totalPresent / totalEnrolled * 100;
    private static readonly double avgWeeklyAttendance = weeklyPattern.Average(d => d.AttendanceRate);
}
