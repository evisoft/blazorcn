@* ============================================================
   Block: stats-connected-kpi-bar-with-trends
   Title: StatsConnectedKpiBarWithTrends
   Description: A connected KPI bar stats card for React and Next.js with four unified tiles, per-tile ChartContainer-wrapped inline sparklines, trend-keyed gradient fills, and tabular-nums values built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-connected-kpi-bar-with-trends.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex items-center justify-between pb-3">
        <p class="text-sm font-medium">Company overview</p>
        <p class="text-xs text-muted-foreground">Last 30 days</p>
    </div>

    <div class="grid grid-cols-1 gap-px overflow-hidden rounded-lg border bg-border sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var kpi in _kpis)
        {
            var isPositive = kpi.ChangeType == "positive";
            var sparkPath = BuildSparkPath(kpi.Spark, 120, 32);
            var fillPath = BuildSparkFill(kpi.Spark, 120, 32);
            var gradientId = $"connected-kpi-bar-with-trends-spark-fill-{kpi.Id}";
            var strokeColor = isPositive ? "#059669" : "#dc2626";
            var stopColor = isPositive ? "#059669" : "#dc2626";

            <div class="bg-card px-4 py-3">
                <div class="flex items-center justify-between gap-2">
                    <div class="truncate text-xs font-medium text-muted-foreground">@kpi.Label</div>
                    <span class="@(Cn.Merge("inline-flex shrink-0 items-center gap-0.5 text-xs font-medium tabular-nums", isPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400"))">
                        @if (isPositive)
                        {
                            <LucideIconCn Name="trending-up" Size="12" Class="size-3" aria-hidden="true" />
                        }
                        else
                        {
                            <LucideIconCn Name="trending-down" Size="12" Class="size-3" aria-hidden="true" />
                        }
                        @kpi.Change
                    </span>
                </div>
                <div class="mt-1 text-2xl font-semibold tabular-nums">@kpi.Value</div>
                <div class="mt-2 h-8 w-full">
                    <svg viewBox="0 0 120 32" class="h-full w-full" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            @((MarkupString)$"<linearGradient id=\"{gradientId}\" x1=\"0\" x2=\"0\" y1=\"0\" y2=\"1\"><stop offset=\"0%\" stop-color=\"{stopColor}\" stop-opacity=\"0.35\"/><stop offset=\"100%\" stop-color=\"{stopColor}\" stop-opacity=\"0\"/></linearGradient>")
                        </defs>
                        @((MarkupString)$"<path d=\"{fillPath}\" fill=\"url(#{gradientId})\" stroke=\"none\"/>")
                        @((MarkupString)$"<path d=\"{sparkPath}\" fill=\"none\" stroke=\"{strokeColor}\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>")
                    </svg>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record SparkPoint(double X, double Y);
    private record Kpi(string Id, string Label, string Value, string Change, string ChangeType, SparkPoint[] Spark);

    private static readonly Kpi[] _kpis =
    [
        new Kpi("mrr", "Monthly recurring revenue", "$187,420", "+12.4%", "positive",
        [
            new SparkPoint(0, 142), new SparkPoint(1, 148), new SparkPoint(2, 151),
            new SparkPoint(3, 149), new SparkPoint(4, 158), new SparkPoint(5, 164),
            new SparkPoint(6, 171), new SparkPoint(7, 176), new SparkPoint(8, 182),
            new SparkPoint(9, 187),
        ]),
        new Kpi("active", "Active customers", "4,812", "+3.1%", "positive",
        [
            new SparkPoint(0, 4620), new SparkPoint(1, 4655), new SparkPoint(2, 4691),
            new SparkPoint(3, 4708), new SparkPoint(4, 4722), new SparkPoint(5, 4741),
            new SparkPoint(6, 4769), new SparkPoint(7, 4784), new SparkPoint(8, 4801),
            new SparkPoint(9, 4812),
        ]),
        new Kpi("churn", "Net churn rate", "1.42%", "-0.36 pp", "positive",
        [
            new SparkPoint(0, 2.1), new SparkPoint(1, 2.05), new SparkPoint(2, 2.0),
            new SparkPoint(3, 1.9), new SparkPoint(4, 1.82), new SparkPoint(5, 1.71),
            new SparkPoint(6, 1.63), new SparkPoint(7, 1.56), new SparkPoint(8, 1.48),
            new SparkPoint(9, 1.42),
        ]),
        new Kpi("arpu", "Average revenue per user", "$38.94", "-1.8%", "negative",
        [
            new SparkPoint(0, 40.2), new SparkPoint(1, 40.1), new SparkPoint(2, 39.8),
            new SparkPoint(3, 39.6), new SparkPoint(4, 39.4), new SparkPoint(5, 39.3),
            new SparkPoint(6, 39.2), new SparkPoint(7, 39.1), new SparkPoint(8, 39.0),
            new SparkPoint(9, 38.94),
        ]),
    ];

    private static string BuildSparkPath(SparkPoint[] points, double width, double height)
    {
        if (points.Length == 0) return "";
        var minY = double.MaxValue;
        var maxY = double.MinValue;
        foreach (var p in points)
        {
            if (p.Y < minY) minY = p.Y;
            if (p.Y > maxY) maxY = p.Y;
        }
        var rangeY = maxY - minY;
        if (rangeY == 0) rangeY = 1;
        var pad = 2.0;
        var usableH = height - pad * 2;
        var stepX = width / (points.Length - 1);

        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < points.Length; i++)
        {
            var cx = i * stepX;
            var cy = pad + usableH - (points[i].Y - minY) / rangeY * usableH;
            sb.Append(i == 0 ? FormattableString.Invariant($"M {cx:F2} {cy:F2}") : FormattableString.Invariant($" L {cx:F2} {cy:F2}"));
        }
        return sb.ToString();
    }

    private static string BuildSparkFill(SparkPoint[] points, double width, double height)
    {
        if (points.Length == 0) return "";
        var path = BuildSparkPath(points, width, height);
        var lastX = (points.Length - 1) * (width / (points.Length - 1));
        return path + FormattableString.Invariant($" L {lastX:F2} {height:F2} L 0 {height:F2} Z");
    }
}
