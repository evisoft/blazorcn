@* ============================================================
   Block: stats-progress-bar-list
   Title: StatsProgressBarList
   Description: A linear progress list stats card for React and Next.js with per-row labels, current/total ratios on the right, thin h-1.5 foreground progress bars, and border-b row dividers built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-progress-bar-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Q2 team goals</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last updated 2 hours ago</p>
            </div>
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="target" Size="14" Class="size-3.5" />
                <span class="tabular-nums">6 goals</span>
            </div>
        </div>

        <div class="divide-y">
            @foreach (var goal in _goals)
            {
                var percent = Math.Min(100, (int)Math.Round((double)goal.Current / goal.Target * 100));
                <div class="px-4 py-3" key="@goal.Id">
                    <div class="flex items-center justify-between gap-4">
                        <div class="min-w-0 truncate text-sm font-medium">@goal.Label</div>
                        <div class="shrink-0 text-xs text-muted-foreground tabular-nums">
                            @FormatRatio(goal.Current, goal.Target)
                        </div>
                    </div>
                    <div class="mt-2 flex items-center gap-3">
                        <div
                            aria-label="@($"{goal.Label} progress")"
                            aria-valuemax="@goal.Target"
                            aria-valuemin="0"
                            aria-valuenow="@goal.Current"
                            class="h-1.5 w-full overflow-hidden rounded-full bg-muted"
                            role="progressbar">
                            <div
                                class="h-full rounded-full bg-foreground transition-all duration-700 ease-out"
                                style="@($"width: {percent}%")">
                            </div>
                        </div>
                        <span class="w-10 shrink-0 text-right text-xs font-semibold tabular-nums">
                            @(percent)%
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Goal(string Id, string Label, int Current, int Target, string Unit);

    private static readonly Goal[] _goals =
    [
        new("eng",      "Ship roadmap features",           18,    24,    "features"),
        new("design",   "Design system tokens migrated",   312,   380,   "tokens"),
        new("sales",    "New enterprise logos",            7,     10,    "logos"),
        new("support",  "Tickets resolved within SLA",     892,   1000,  "tickets"),
        new("growth",   "Qualified signups activated",     2140,  3500,  "signups"),
        new("research", "Customer interviews booked",      28,    30,    "interviews"),
    ];

    private static string FormatRatio(int current, int target)
        => $"{current:N0} / {target:N0}";
}
