@* ========================================
   Block: stats-meeting-analytics
   Title: Stats Meeting Analytics
   Description: Meeting time analysis dashboard with weekly hours, recurring vs ad-hoc breakdown, average duration, attendee statistics, and productivity insights
   Long Description: Focus time and productivity tracking
   Dependencies: None
   Source: original/blocks/stats/stats-meeting-analytics.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="text-sm font-medium">Meeting Analytics</h3>
            <p class="mt-0.5 text-muted-foreground text-xs">This week's meeting time</p>
        </div>

        <div class="grid grid-cols-4 gap-px border-b bg-border">
            @foreach (var metric in meetingMetrics)
            {
                <div class="bg-card px-4 py-3">
                    <p class="text-muted-foreground text-xs">@metric.Label</p>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums">@metric.Value</span>
                        <span class="text-muted-foreground text-xs">@metric.Unit</span>
                    </div>
                    @if (metric.Change.HasValue)
                    {
                        <p class="@(Cn.Merge("mt-0.5 text-xs", metric.Change.Value < 0 ? "text-emerald-600" : metric.Change.Value > 0 ? "text-red-600" : "text-muted-foreground"))">
                            @(metric.Change.Value > 0 ? "+" : "")@(metric.Change.Value)%
                        </p>
                    }
                </div>
            }
        </div>

        <div class="border-b px-4 py-4">
            <div class="mb-3">
                <h4 class="text-sm font-medium">Meeting Breakdown</h4>
            </div>

            <div class="space-y-3">
                @foreach (var meeting in meetingBreakdown)
                {
                    var percentage = (meeting.Hours / totalHours) * 100;

                    <div>
                        <div class="mb-1.5 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="@(Cn.Merge("size-2 rounded-full", meeting.Color))"></span>
                                <span class="text-sm font-medium">@meeting.Type</span>
                            </div>
                            <div class="flex items-center gap-3">
                                <span class="text-muted-foreground text-xs">
                                    @meeting.Count meetings
                                </span>
                                <span class="text-sm font-semibold tabular-nums">@(meeting.Hours)h</span>
                            </div>
                        </div>
                        <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                            <div class="@(Cn.Merge("h-full rounded-full", meeting.Color))"
                                 style="width: @(percentage)%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="grid grid-cols-2 gap-px bg-border">
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Focus Time</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">25.5h</p>
                <p class="mt-0.5 text-emerald-600 text-xs">64% of work time</p>
            </div>
            <div class="bg-card px-4 py-3">
                <p class="text-muted-foreground text-xs">Meeting Cost</p>
                <p class="mt-1 text-2xl font-semibold tabular-nums">$2,340</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Estimated salary cost</p>
            </div>
        </div>
    </div>
</section>

@code {
    private record MeetingMetric(string Label, string Value, string Unit, double? Change);
    private record MeetingBreakdown(string Type, double Hours, int Count, string Color);

    private static readonly MeetingMetric[] meetingMetrics = new[]
    {
        new MeetingMetric("Weekly Hours", "14.5", "hrs", -8.2),
        new MeetingMetric("Avg Duration", "38", "min", -5.0),
        new MeetingMetric("Total Meetings", "23", "meetings", -12.5),
        new MeetingMetric("Avg Attendees", "4.2", "people", 2.3),
    };

    private static readonly MeetingBreakdown[] meetingBreakdown = new[]
    {
        new MeetingBreakdown("Recurring", 8.5, 12, "bg-blue-500"),
        new MeetingBreakdown("Ad-hoc", 4.0, 8, "bg-purple-500"),
        new MeetingBreakdown("1-on-1", 2.0, 3, "bg-emerald-500"),
    };

    private static readonly double totalHours = meetingBreakdown.Sum(m => m.Hours);
}
