@* ========================================
   Block: stats-live-metrics
   Title: Stats Live Metrics
   Description: Live metrics dashboard with pulse indicators, activity bars, and real-time status
   Dependencies: None
   Source: original/blocks/stats/stats-live-metrics.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var metric in _metrics)
        {
            var statusColor = metric.Status == "healthy" ? "bg-emerald-500" : metric.Status == "warning" ? "bg-amber-500" : "bg-red-500";
            var statusLabel = metric.Status == "healthy" ? "Healthy" : metric.Status == "warning" ? "Warning" : "Critical";
            var textColor = metric.Status == "healthy" ? "text-emerald-600 dark:text-emerald-400" : metric.Status == "warning" ? "text-amber-600 dark:text-amber-400" : "text-red-600 dark:text-red-400";
            var barColor = metric.Status == "healthy" ? "bg-emerald-500/80" : metric.Status == "warning" ? "bg-amber-500/80" : "bg-red-500/80";
            var maxActivity = metric.Activity.Max();

            <div class="overflow-hidden rounded-lg border bg-card px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                        @metric.Label
                    </span>
                    <div class="flex items-center gap-1.5">
                        <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", statusColor))"></span>
                        <span class="@(Cn.Merge("text-xs font-medium", textColor))">
                            @statusLabel
                        </span>
                    </div>
                </div>

                <div class="mt-2">
                    <span class="text-2xl font-semibold tabular-nums text-foreground">
                        @metric.Value
                    </span>
                </div>

                <div class="mt-3">
                    <div class="flex h-8 items-end gap-0.5">
                        @for (var j = 0; j < metric.Activity.Length; j++)
                        {
                            var val = metric.Activity[j];
                            var heightPct = (double)val / maxActivity * 100;
                            var isLast = j == metric.Activity.Length - 1;

                            <div class="@(Cn.Merge("w-1.5 rounded-sm transition-all", barColor, isLast ? "animate-pulse" : ""))"
                                 style="height: @(heightPct.ToString("F1"))%"></div>
                        }
                    </div>
                </div>

                <div class="mt-2 flex items-center justify-between">
                    <span class="text-xs text-muted-foreground">@metric.Subvalue</span>
                    <span class="text-xs text-muted-foreground">Live</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record LiveMetric(string Label, string Value, string Subvalue, string Status, int[] Activity);

    private static readonly LiveMetric[] _metrics =
    [
        new("Active Users", "2,847", "Peak: 3,201 today", "healthy", [40, 65, 45, 80, 56, 90, 75, 88, 92, 78, 85, 95]),
        new("Requests/min", "14.2K", "Avg: 12.8K", "healthy", [60, 55, 70, 65, 75, 80, 72, 68, 85, 78, 82, 88]),
        new("Response Time", "142ms", "p99: 380ms", "warning", [30, 35, 45, 42, 55, 68, 72, 65, 58, 70, 75, 82]),
        new("Error Rate", "0.02%", "3 errors/min", "healthy", [5, 8, 3, 6, 4, 7, 5, 9, 6, 4, 8, 5]),
    ];
}
