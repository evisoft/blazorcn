@* ============================================================
   Block: stats-waffle-chart-card
   Title: StatsWaffleChartCard
   Description: A waffle chart stats card for React and Next.js with a 10x10 grid of colored squares showing proportional segment distribution, chart-token colored cells, a legend with percentages, and tabular-nums values built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-waffle-chart-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-sm p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Browser distribution</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_dominant.Label leads at&nbsp;<span class="font-medium tabular-nums">@(_dominant.Value)%</span>
            </p>
        </div>
        <div class="px-4 py-4">
            <div class="mx-auto grid gap-1"
                 style="grid-template-columns: repeat(10, 1fr);"
                 role="img"
                 aria-label="@string.Join(", ", _segments.Select(s => $"{s.Label}: {s.Value}%"))">
                @foreach (var cell in _gridCells)
                {
                    <div class="aspect-square rounded-[3px] transition-colors"
                         style="@($"background-color: {cell.Color}")"></div>
                }
            </div>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 border-t px-4 py-2.5">
            @foreach (var seg in _segments)
            {
                <div class="flex items-center gap-1.5">
                    <span class="size-2.5 rounded-sm"
                          style="@($"background-color: {seg.Color}")"
                          aria-hidden="true"></span>
                    <span class="text-xs text-muted-foreground">@seg.Label</span>
                    <span class="text-xs font-medium tabular-nums">@(seg.Value)%</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record WaffleSegment(string Id, string Label, int Value, string Color);

    private static readonly WaffleSegment[] _segments =
    [
        new("chrome",  "Chrome",  45, "var(--chart-1)"),
        new("safari",  "Safari",  25, "var(--chart-2)"),
        new("firefox", "Firefox", 18, "var(--chart-3)"),
        new("other",   "Other",   12, "var(--chart-4)"),
    ];

    private static readonly WaffleSegment[] _gridCells = BuildGrid(_segments);

    private static readonly WaffleSegment _dominant =
        _segments.Aggregate((a, b) => a.Value > b.Value ? a : b);

    private static WaffleSegment[] BuildGrid(WaffleSegment[] segs)
    {
        var cells = new System.Collections.Generic.List<WaffleSegment>();
        foreach (var seg in segs)
        {
            for (var i = 0; i < seg.Value; i++)
                cells.Add(seg);
        }
        return cells.ToArray();
    }
}
