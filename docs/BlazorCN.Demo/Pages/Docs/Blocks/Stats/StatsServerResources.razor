@* ========================================
   Block: stats-server-resources
   Title: Stats Server Resources
   Description: Server utilization stats with CPU, memory, disk usage bars, and load average for React infrastructure dashboards
   Long Description: A keyword ranking tracker component displaying search positions, search volume, click-through rate, and position changes for Next.js SEO dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-server-resources.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <p class="text-sm font-medium">@hostname</p>
            </div>
            <p class="text-xs text-muted-foreground">Up @uptime</p>
        </div>

        @* Load *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Load Average</span>
                <span class="font-mono text-xs tabular-nums">@loadAvg</span>
            </div>
        </div>

        @* Resources *@
        <div>
            @for (var i = 0; i < resources.Length; i++)
            {
                var resource = resources[i];
                var isLast = i == resources.Length - 1;

                <div class="@(Cn.Merge("px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium">@resource.Name</span>
                        <div class="flex items-center gap-2">
                            <span class="text-sm tabular-nums">
                                @resource.Used@resource.Unit
                            </span>
                            <span class="text-xs text-muted-foreground">/ @resource.Total</span>
                        </div>
                    </div>
                    <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="@(Cn.Merge("h-full rounded-full transition-all", GetColor(resource.Percent)))"
                             style="width: @(resource.Percent.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Resource(string Name, double Used, string Total, string Unit, double Percent);

    private const string hostname = "prod-web-01";
    private const string loadAvg = "2.4 / 1.8 / 1.2";
    private const string uptime = "42 days";

    private static readonly Resource[] resources = new[]
    {
        new Resource("CPU", 67, "8 cores", "%", 67),
        new Resource("Memory", 12.4, "16 GB", "GB", 77.5),
        new Resource("Disk", 186, "500 GB", "GB", 37.2),
        new Resource("Swap", 0.8, "4 GB", "GB", 20),
    };

    private static string GetColor(double percent)
    {
        if (percent >= 90) return "bg-red-500";
        if (percent >= 70) return "bg-amber-500";
        return "bg-emerald-500";
    }
}
