@* ============================================================
   Block: stats-concentric-rings-card
   Title: StatsConcentricRingsCard
   Description: A concentric activity rings stats card for React and Next.js with three SVG progress rings inspired by Apple Watch, stroke-dasharray animated arcs, NumberFlow animated center value, and semantic ring colors built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-concentric-rings-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-sm p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Activity rings</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Today&apos;s progress</p>
        </div>
        <div class="flex items-center justify-center px-4 py-6">
            <div class="relative" style="width:180px;height:180px;">
                <svg width="180" height="180" viewBox="0 0 180 180" class="-rotate-90">
                    @foreach (var entry in _ringEntries)
                    {
                        <g>
                            @* Track *@
                            <circle cx="90" cy="90" r="@entry.Radius.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                    fill="none"
                                    stroke="var(--muted)"
                                    stroke-width="14"
                                    stroke-linecap="round" />
                            @* Progress *@
                            <circle cx="90" cy="90" r="@entry.Radius.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                    fill="none"
                                    stroke="@entry.Color"
                                    stroke-width="14"
                                    stroke-linecap="round"
                                    stroke-dasharray="@entry.Circumference.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                    stroke-dashoffset="@entry.Offset.ToString("F4", System.Globalization.CultureInfo.InvariantCulture)"
                                    class="transition-all duration-700 ease-out"
                                    role="progressbar"
                                    aria-valuenow="@entry.Current"
                                    aria-valuemin="0"
                                    aria-valuemax="@entry.Target"
                                    aria-label="@($"{entry.Label}: {entry.Current} of {entry.Target} {entry.Unit}")" />
                        </g>
                    }
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <div class="min-w-[60px] text-center">
                        <span class="text-2xl font-semibold tabular-nums">@_bestPct%</span>
                    </div>
                    <p class="text-[10px] text-muted-foreground">@_bestRing.Label</p>
                </div>
            </div>
        </div>
        <div class="divide-y border-t">
            @foreach (var ring in _rings)
            {
                var pct = (int)Math.Round((double)ring.Current / ring.Target * 100);
                <div class="flex items-center justify-between px-4 py-2.5">
                    <div class="flex items-center gap-2">
                        <span class="size-2 rounded-full"
                              style="background-color:@ring.Color;"
                              aria-hidden="true"></span>
                        <span class="text-sm font-medium">@ring.Label</span>
                    </div>
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-sm font-semibold tabular-nums">@ring.Current</span>
                        <span class="text-xs text-muted-foreground tabular-nums">/ @ring.Target @ring.Unit</span>
                        <span class="@(Cn.Merge("text-xs font-medium tabular-nums", pct >= 100 ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground"))">@(pct)%</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private const int Size = 180;
    private const int StrokeWidth = 14;
    private const int Gap = 4;

    private record RingMetric(string Id, string Label, int Current, int Target, string Unit, string Color);

    private static readonly RingMetric[] _rings =
    [
        new("move",     "Move",     480, 600, "cal", "var(--chart-1)"),
        new("exercise", "Exercise",  25,  30, "min", "var(--chart-2)"),
        new("stand",    "Stand",     10,  12, "hrs", "var(--chart-5)"),
    ];

    private record RingEntry(string Label, int Current, int Target, string Unit, string Color, double Radius, double Circumference, double Offset);

    private static readonly RingEntry[] _ringEntries = BuildEntries();

    private static RingEntry[] BuildEntries()
    {
        var entries = new RingEntry[_rings.Length];
        for (int i = 0; i < _rings.Length; i++)
        {
            var ring = _rings[i];
            double radius = Size / 2.0 - StrokeWidth / 2.0 - i * (StrokeWidth + Gap);
            double circumference = 2 * Math.PI * radius;
            double pct = Math.Min((double)ring.Current / ring.Target, 1.0);
            double offset = circumference * (1 - pct);
            entries[i] = new RingEntry(ring.Label, ring.Current, ring.Target, ring.Unit, ring.Color, radius, circumference, offset);
        }
        return entries;
    }

    private static readonly RingMetric _bestRing = _rings.Aggregate((a, b) =>
        (double)a.Current / a.Target > (double)b.Current / b.Target ? a : b);

    private static readonly int _bestPct = (int)Math.Round((double)_bestRing.Current / _bestRing.Target * 100);
}
