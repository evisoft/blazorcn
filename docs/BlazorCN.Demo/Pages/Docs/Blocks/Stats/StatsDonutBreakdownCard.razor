@* ============================================================
   Block: stats-donut-breakdown-card
   Title: StatsDonutBreakdownCard
   Description: A donut breakdown stats card for React and Next.js with a ChartContainer-wrapped PieChart, centered total, side legend with dots, percentages, and absolute values built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-donut-breakdown-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Payment methods</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days</p>
            </div>
            <span class="inline-flex items-center gap-1 rounded-full bg-muted/60 px-2 py-0.5 text-xs font-medium text-muted-foreground">
                5 segments
            </span>
        </div>

        <div class="grid grid-cols-1 items-center gap-4 px-4 py-4 sm:grid-cols-[220px_1fr]">
            <div class="relative mx-auto w-full max-w-[220px]">
                <div class="mx-auto aspect-square max-h-[220px]">
                    <svg viewBox="0 0 220 220" class="w-full h-full" aria-hidden="true">
                        @{ var startAngle = -90.0; }
                        @foreach (var seg in _segments)
                        {
                            var pct = (double)seg.Value / _total;
                            var sweep = pct * 360.0;
                            var endAngle = startAngle + sweep;

                            var r = 90.0;
                            var ri = 62.0;
                            var cx = 110.0;
                            var cy = 110.0;

                            var x1 = cx + r * Math.Cos(startAngle * Math.PI / 180.0);
                            var y1 = cy + r * Math.Sin(startAngle * Math.PI / 180.0);
                            var x2 = cx + r * Math.Cos(endAngle * Math.PI / 180.0);
                            var y2 = cy + r * Math.Sin(endAngle * Math.PI / 180.0);
                            var xi1 = cx + ri * Math.Cos(endAngle * Math.PI / 180.0);
                            var yi1 = cy + ri * Math.Sin(endAngle * Math.PI / 180.0);
                            var xi2 = cx + ri * Math.Cos(startAngle * Math.PI / 180.0);
                            var yi2 = cy + ri * Math.Sin(startAngle * Math.PI / 180.0);
                            var largeArc = sweep > 180 ? 1 : 0;

                            var d = $"M {x1.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)} {y1.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)} A {r.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)} {r.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)} 0 {largeArc} 1 {x2.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)} {y2.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)} L {xi1.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)} {yi1.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)} A {ri.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)} {ri.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)} 0 {largeArc} 0 {xi2.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)} {yi2.ToString("F3", System.Globalization.CultureInfo.InvariantCulture)} Z";

                            <path d="@d" fill="@seg.Fill" stroke="hsl(var(--card))" stroke-width="2" />
                            startAngle = endAngle;
                        }
                    </svg>
                </div>
                <div class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center">
                    <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                        Total
                    </p>
                    <p class="mt-0.5 text-2xl font-semibold tabular-nums">@FormatCurrency(_total)</p>
                </div>
            </div>

            <div class="flex flex-col gap-2">
                @foreach (var segment in _segments)
                {
                    var pctVal = (double)segment.Value / _total * 100.0;
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex min-w-0 items-center gap-2">
                            <span aria-hidden="true"
                                  class="size-2 shrink-0 rounded-full"
                                  style="@($"background-color:{segment.Fill}")"></span>
                            <span class="truncate text-sm">@segment.Label</span>
                        </div>
                        <div class="flex shrink-0 items-baseline gap-2">
                            <span class="text-xs text-muted-foreground tabular-nums">
                                @(pctVal.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%
                            </span>
                            <span class="text-sm font-semibold tabular-nums">
                                @FormatCurrency(segment.Value)
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Segment(string Id, string Label, int Value, string Fill);

    private static readonly Segment[] _segments =
    [
        new("credit",  "Credit card",       48260, "oklch(0.646 0.222 41.116)"),
        new("wallet",  "Digital wallet",    22180, "oklch(0.6 0.118 184.704)"),
        new("wire",    "Wire transfer",      9420, "oklch(0.398 0.07 227.392)"),
        new("ach",     "ACH / direct debit", 6140, "oklch(0.828 0.189 84.429)"),
        new("other",   "Other",              2380, "oklch(0.769 0.188 70.08)"),
    ];

    private static readonly int _total = 88380;

    private static string FormatCurrency(int value)
    {
        return value.ToString("C0", new System.Globalization.CultureInfo("en-US"));
    }
}
