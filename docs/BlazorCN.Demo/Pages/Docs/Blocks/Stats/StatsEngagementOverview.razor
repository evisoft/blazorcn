@* ========================================
   Block: stats-engagement-overview
   Title: Stats Engagement Overview
   Description: User engagement stats with DAU/MAU ratio, session duration, pages per visit, and feature adoption
   Dependencies: None
   Source: original/blocks/stats/stats-engagement-overview.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Engagement</p>
                <p class="mt-0.5 text-xs text-muted-foreground">Last 30 days</p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-semibold tabular-nums">@_dauMau</p>
                <p class="mt-0.5 text-xs text-emerald-600 dark:text-emerald-400">
                    @_dauMauTrend DAU/MAU
                </p>
            </div>
        </div>

        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">@_avgSession</p>
                <p class="text-xs text-muted-foreground">Avg Session</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">@_pagesPerSession</p>
                <p class="text-xs text-muted-foreground">Pages/Session</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-sm font-semibold tabular-nums">@_bounceRate</p>
                <p class="text-xs text-muted-foreground">Bounce Rate</p>
            </div>
        </div>

        <div class="border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">Feature Adoption</span>
        </div>
        <div>
            @for (var i = 0; i < _features.Length; i++)
            {
                var feature = _features[i];

                <div class="@(Cn.Merge("px-4 py-2.5", i < _features.Length - 1 ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <span class="text-sm font-medium">@feature.Name</span>
                        <div class="flex items-center gap-3 text-xs">
                            <span class="text-muted-foreground">@feature.Sessions sessions</span>
                            <span class="w-8 text-right font-medium tabular-nums">
                                @feature.AdoptionRate%
                            </span>
                        </div>
                    </div>
                    <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-primary transition-all"
                             style="width: @(feature.AdoptionRate)%"></div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Feature(string Name, int AdoptionRate, string Sessions);

    private const string _dauMau = "38%";
    private const string _dauMauTrend = "+2.4%";
    private const string _avgSession = "6m 42s";
    private const string _pagesPerSession = "4.8";
    private const string _bounceRate = "24.1%";

    private static readonly Feature[] _features =
    [
        new("Dashboard", 92, "12.4K"),
        new("Search", 74, "9.8K"),
        new("Reports", 56, "7.2K"),
        new("Settings", 41, "5.3K"),
        new("API", 28, "3.6K"),
    ];
}
