@* ========================================
   Block: stats-campaign-performance
   Title: Stats Campaign Performance
   Description: Marketing campaign stats with ROI, impressions, click-through rates, and spend tracking for React marketing dashboards
   Long Description: Budget stats with progress bars, spending totals, and department tracking for React finance dashboards
   Dependencies: None
   Source: original/blocks/stats/stats-campaign-performance.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Campaign Performance</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    March 2025 &middot; @totalSpend spent
                </p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-semibold tabular-nums">@overallRoas</p>
                <p class="mt-0.5 text-xs text-muted-foreground">ROAS</p>
            </div>
        </div>

        @* Summary *@
        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-2xl font-semibold tabular-nums">
                    @totalConversions.ToString("N0")
                </p>
                <p class="text-xs text-muted-foreground">Conversions</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-2xl font-semibold tabular-nums">@overallCtr</p>
                <p class="text-xs text-muted-foreground">CTR</p>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <p class="text-2xl font-semibold tabular-nums">$13.46</p>
                <p class="text-xs text-muted-foreground">Avg CPA</p>
            </div>
        </div>

        @* Channels *@
        <div>
            @for (var i = 0; i < channels.Length; i++)
            {
                var channel = channels[i];
                var isLast = i == channels.Length - 1;
                var barWidth = channel.RoasValue / maxRoas * 100;

                <div class="@(Cn.Merge("px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@channel.Name</span>
                            <span class="text-xs text-muted-foreground">@channel.Spend</span>
                        </div>
                        <div class="flex items-center gap-3 text-xs text-muted-foreground">
                            <span>@channel.Conversions conv</span>
                            <span class="font-medium tabular-nums text-foreground">@channel.Roas</span>
                        </div>
                    </div>
                    <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                        <div
                            class="@(Cn.Merge("h-full rounded-full transition-all", channel.RoasValue >= 3 ? "bg-emerald-500" : channel.RoasValue >= 2 ? "bg-amber-500" : "bg-red-500"))"
                            style="width: @(barWidth.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%">
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Channel(string Name, string Spend, int Conversions, string Cpa, string Roas, double RoasValue);

    private static readonly string totalSpend = "$24,800";
    private static readonly int totalConversions = 1842;
    private static readonly string overallRoas = "3.2x";
    private static readonly string overallCtr = "4.7%";

    private static readonly Channel[] channels = new[]
    {
        new Channel("Google Ads", "$12,400", 892, "$13.90", "4.1x", 4.1),
        new Channel("Meta Ads", "$7,200", 534, "$13.48", "3.5x", 3.5),
        new Channel("LinkedIn", "$3,600", 287, "$12.54", "2.8x", 2.8),
        new Channel("TikTok", "$1,600", 129, "$12.40", "1.9x", 1.9),
    };

    private static readonly double maxRoas = channels.Max(c => c.RoasValue);
}
