@* ========================================
   Block: stats-badges
   Title: Stats Badges
   Description: Stats cards with trend badges, icons, and header-aligned change indicators
   Dependencies: None
   Source: original/blocks/stats/stats-badges.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var item in _data)
        {
            <div class="rounded-lg border bg-card px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-muted-foreground">@item.Name</span>
                    <span class="@($"text-xs font-medium tabular-nums {(item.IsPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")}")">
                        @item.Change
                    </span>
                </div>
                <p class="mt-2 text-2xl font-semibold tabular-nums text-foreground">@item.Stat</p>
            </div>
        }
    </div>
</section>

@code {
    private record StatItem(string Name, string Stat, string Change, bool IsPositive);

    private static readonly StatItem[] _data =
    [
        new("Daily active users", "3,450", "+12.1%", true),
        new("Weekly sessions", "1,342", "-9.8%", false),
        new("Duration", "5.2min", "+7.7%", true),
    ];
}
