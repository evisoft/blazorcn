@* ============================================================
   Block: stats-kpi-status-tile-grid
   Title: StatsKpiStatusTileGrid
   Description: A KPI status tile grid stats block for React and Next.js with per-tile semantic status dots, border accents at /40 opacity, and tabular-nums values built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-kpi-status-tile-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="mb-3 flex items-end justify-between">
        <div>
            <p class="text-sm font-medium">Platform health</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Last 15 minutes</p>
        </div>
        <p class="text-xs text-muted-foreground tabular-nums">6 services</p>
    </div>

    <dl class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var tile in _tiles)
        {
            var style = _statusStyles[tile.Status];
            var isPositive = tile.ChangeType == "positive";
            <div class="@Cn.Merge("overflow-hidden rounded-lg border bg-card px-4 py-3", style.Border)">
                <div class="flex items-start justify-between">
                    <dt class="text-sm font-medium text-muted-foreground">@tile.Label</dt>
                    <span aria-hidden="true" class="@Cn.Merge("mt-1 size-1.5 shrink-0 rounded-full", style.Dot)"></span>
                </div>

                <dd class="mt-1.5 flex items-baseline gap-2">
                    <span class="text-2xl font-semibold tabular-nums">@tile.Value</span>
                    <span class="@Cn.Merge("inline-flex items-center gap-0.5 text-xs font-medium tabular-nums", isPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                        @if (isPositive)
                        {
                            <LucideIconCn Name="trending-up" Size="12" Class="size-3" aria-hidden="true" />
                        }
                        else
                        {
                            <LucideIconCn Name="trending-down" Size="12" Class="size-3" aria-hidden="true" />
                        }
                        @tile.Change
                    </span>
                </dd>

                <dd class="@Cn.Merge("mt-1 text-xs font-medium", style.Text)">@tile.StatusLabel</dd>
            </div>
        }
    </dl>
</section>

@code {
    private record KpiTile(string Id, string Label, string Value, string Change, string ChangeType, string Status, string StatusLabel);

    private record StatusStyle(string Border, string Dot, string Text);

    private static readonly KpiTile[] _tiles =
    [
        new("api-gateway",  "API gateway p99",      "142ms",   "-18ms",   "positive", "healthy",  "Within SLO"),
        new("checkout",     "Checkout success",     "99.82%",  "+0.04%",  "positive", "healthy",  "Within SLO"),
        new("search",       "Search latency",       "318ms",   "+42ms",   "negative", "observe",  "Observing"),
        new("payments",     "Payments error rate",  "1.24%",   "+0.78%",  "negative", "critical", "Breaching SLO"),
        new("auth",         "Auth uptime",          "99.997%", "+0.002%", "positive", "healthy",  "Within SLO"),
        new("webhooks",     "Webhook delivery",     "94.1%",   "-2.3%",   "negative", "observe",  "Observing"),
    ];

    private static readonly Dictionary<string, StatusStyle> _statusStyles = new()
    {
        ["healthy"]  = new("border-emerald-500/40", "bg-emerald-500", "text-emerald-600 dark:text-emerald-400"),
        ["observe"]  = new("border-amber-500/40",   "bg-amber-500",   "text-amber-600 dark:text-amber-400"),
        ["critical"] = new("border-red-500/40",     "bg-red-500",     "text-red-600 dark:text-red-400"),
    };
}
