@* ============================================================
   Block: stats-lollipop-chart-card
   Title: StatsLollipopChartCard
   Description: A vertical lollipop chart stats card for React and Next.js with thin stem lines topped by circle dots replacing traditional bars, 7-day data points, semantic chart-token coloring, and tabular-nums values built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-lollipop-chart-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-md p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Weekly signups</p>
                <p class="mt-0.5 text-xs text-muted-foreground">This week</p>
            </div>
            <div class="min-w-[60px] text-right">
                <span class="text-2xl font-semibold tabular-nums">@_total.ToString("N0")</span>
            </div>
        </div>
        <div class="px-4 py-4">
            <div class="flex h-[160px] items-end gap-2">
                @foreach (var d in _chartData)
                {
                    var heightPct = (d.Value / _maxValue) * 100.0;
                    <div class="flex flex-1 flex-col items-center" aria-label="@($"{d.Day}: {d.Value}")">
                        <div class="relative flex w-full flex-1 items-end justify-center">
                            <div class="relative flex w-0.5 justify-center bg-foreground/30 transition-all duration-700 ease-out"
                                 style="@($"height:{heightPct:0.##}%")">
                                <span class="absolute -top-1 size-3 rounded-full border-2 border-background"
                                      style="background-color:var(--chart-1)"></span>
                            </div>
                        </div>
                        <div class="mt-2 text-center">
                            <p class="text-[10px] text-muted-foreground">@d.Day</p>
                            <p class="text-[10px] font-medium tabular-nums">@d.Value</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record DataPoint(string Day, int Value);

    private static readonly DataPoint[] _chartData =
    [
        new("Mon", 245),
        new("Tue", 312),
        new("Wed", 287),
        new("Thu", 398),
        new("Fri", 425),
        new("Sat", 178),
        new("Sun", 156),
    ];

    private static readonly double _maxValue = _chartData.Max(d => d.Value);
    private static readonly int _total = _chartData.Sum(d => d.Value);
}
