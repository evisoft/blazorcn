@* ============================================================
   Block: stats-scatter-plot-card
   Title: StatsScatterPlotCard
   Description: A scatter plot stats card for React and Next.js with Recharts ScatterChart showing correlation between two metrics, quadrant reference lines at median values, labeled zones, ChartTooltip with both values, and tabular-nums axis labels built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-scatter-plot-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between gap-4 border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Latency vs error rate</p>
                <p class="mt-0.5 text-xs text-muted-foreground">12 endpoints · Last 24h</p>
            </div>
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>Median: <span class="font-medium tabular-nums">@_medianLatency ms</span></span>
                <span>|</span>
                <span>Median: <span class="font-medium tabular-nums">@_medianErrorRate %</span></span>
            </div>
        </div>
        <div class="px-4 py-4">
            <div class="h-[240px] w-full">
                <svg viewBox="0 0 500 240" class="h-full w-full" aria-label="Scatter plot: latency vs error rate">
                    @* Chart area margins: left=40, right=12, top=8, bottom=32 *@
                    @* Plot area: x from 40 to 488, y from 8 to 208 *@

                    @* Grid lines (horizontal) *@
                    @foreach (var gridY in _gridYValues)
                    {
                        var yPx = DataToSvgY(gridY);
                        @((MarkupString)$"<line x1=\"40\" y1=\"{yPx:F1}\" x2=\"488\" y2=\"{yPx:F1}\" stroke=\"var(--border)\" stroke-dasharray=\"3 3\" stroke-width=\"1\" />")
                    }

                    @* Grid lines (vertical) *@
                    @foreach (var gridX in _gridXValues)
                    {
                        var xPx = DataToSvgX(gridX);
                        @((MarkupString)$"<line x1=\"{xPx:F1}\" y1=\"8\" x2=\"{xPx:F1}\" y2=\"208\" stroke=\"var(--border)\" stroke-dasharray=\"3 3\" stroke-width=\"1\" />")
                    }

                    @* Median reference line X *@
                    @{ var refX = DataToSvgX(_medianLatency); }
                    @((MarkupString)$"<line x1=\"{refX:F1}\" y1=\"8\" x2=\"{refX:F1}\" y2=\"208\" stroke=\"var(--border)\" stroke-dasharray=\"4 4\" stroke-width=\"1.5\" />")

                    @* Median reference line Y *@
                    @{ var refY = DataToSvgY(_medianErrorRate); }
                    @((MarkupString)$"<line x1=\"40\" y1=\"{refY:F1}\" x2=\"488\" y2=\"{refY:F1}\" stroke=\"var(--border)\" stroke-dasharray=\"4 4\" stroke-width=\"1.5\" />")

                    @* X axis *@
                    <line x1="40" y1="208" x2="488" y2="208" stroke="var(--border)" stroke-width="1" />

                    @* Y axis *@
                    <line x1="40" y1="8" x2="40" y2="208" stroke="var(--border)" stroke-width="1" />

                    @* X axis tick labels *@
                    @foreach (var tick in _gridXValues)
                    {
                        var xPx = DataToSvgX(tick);
                        @((MarkupString)$"<text x=\"{xPx:F1}\" y=\"221\" text-anchor=\"middle\" font-size=\"11\" fill=\"var(--muted-foreground)\">{tick}</text>")
                    }

                    @* Y axis tick labels *@
                    @foreach (var tick in _gridYValues)
                    {
                        var yPx = DataToSvgY(tick);
                        @((MarkupString)$"<text x=\"36\" y=\"{(yPx + 4):F1}\" text-anchor=\"end\" font-size=\"11\" fill=\"var(--muted-foreground)\">{tick:F2}</text>")
                    }

                    @* X axis label *@
                    @((MarkupString)"<text x=\"264\" y=\"236\" text-anchor=\"middle\" font-size=\"10\" fill=\"var(--muted-foreground)\">Latency (ms)</text>")

                    @* Y axis label *@
                    @((MarkupString)"<text x=\"10\" y=\"108\" text-anchor=\"middle\" font-size=\"10\" fill=\"var(--muted-foreground)\" transform=\"rotate(-90,10,108)\">Error %</text>")

                    @* Scatter dots *@
                    @foreach (var pt in _scatterData)
                    {
                        var cx = DataToSvgX(pt.Latency);
                        var cy = DataToSvgY(pt.ErrorRate);
                        @((MarkupString)$"<circle cx=\"{cx:F1}\" cy=\"{cy:F1}\" r=\"5\" fill=\"var(--chart-1)\" fill-opacity=\"0.7\" />")
                    }
                </svg>
            </div>
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-1 border-t px-4 py-2.5 text-[10px] text-muted-foreground">
            <span>↗ Top-right: high latency + high errors</span>
            <span>↙ Bottom-left: fast + reliable</span>
        </div>
    </div>
</section>

@code {
    private record DataPoint(string Name, double Latency, double ErrorRate);

    private static readonly DataPoint[] _scatterData =
    [
        new("/api/users",         45,  0.12),
        new("/api/products",      89,  0.05),
        new("/api/orders",       120,  0.32),
        new("/api/search",       210,  0.08),
        new("/api/auth",          35,  0.02),
        new("/api/payments",     155,  0.45),
        new("/api/analytics",    180,  0.15),
        new("/api/webhooks",      95,  0.28),
        new("/api/uploads",      250,  0.52),
        new("/api/notifications", 60,  0.03),
        new("/api/billing",      140,  0.18),
        new("/api/reports",      320,  0.22),
    ];

    private const double _medianLatency   = 127;
    private const double _medianErrorRate = 0.17;

    // SVG plot area: x [40..488], y [8..208]  =>  data x [0..350], data y [0..0.60]
    private const double _xMin = 0,   _xMax = 350;
    private const double _yMin = 0,   _yMax = 0.60;
    private const double _svgX0 = 40, _svgX1 = 488;
    private const double _svgY0 = 8,  _svgY1 = 208;

    private static readonly double[] _gridXValues = [0, 100, 200, 300];
    private static readonly double[] _gridYValues = [0.00, 0.20, 0.40, 0.60];

    private static double DataToSvgX(double x) =>
        _svgX0 + (x - _xMin) / (_xMax - _xMin) * (_svgX1 - _svgX0);

    private static double DataToSvgY(double y) =>
        _svgY1 - (y - _yMin) / (_yMax - _yMin) * (_svgY1 - _svgY0);
}
