@* ============================================================
   Block: stats-sparkline-card-with-range
   Title: StatsSparklineCardWithRange
   Description: A sparkline stats card for React and Next.js with Recharts ReferenceLine min and max range bounds, inline high and low labels on the sparkline edges, and a NumberFlow animated current price built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-sparkline-card-with-range.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start justify-between border-b px-4 py-3">
            <div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="activity" Size="14" Class="size-3.5 text-muted-foreground" />
                    <p class="text-sm font-medium">Brent crude</p>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">30-day range USD/bbl</p>
            </div>
            <div class="text-right">
                <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    In range
                </p>
                <p class="mt-0.5 text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                    @(_positionInRange.ToString("F0"))%
                </p>
            </div>
        </div>

        <div class="flex items-baseline justify-between gap-4 px-4 py-4">
            <div class="min-w-[140px]">
                <p class="text-3xl font-semibold tabular-nums">@(_currentPrice.ToString("C2", _usd))</p>
                <p class="mt-1 text-xs text-muted-foreground tabular-nums">
                    Range $@(_minPrice.ToString("F2")) – $@(_maxPrice.ToString("F2"))
                </p>
            </div>
            <div class="flex flex-col items-end gap-1 text-right">
                <div class="flex items-center gap-1.5">
                    <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                        High @(_maxPrice.ToString("F2"))
                    </span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span aria-hidden="true" class="size-1.5 rounded-full bg-red-500"></span>
                    <span class="text-xs font-medium tabular-nums text-red-600 dark:text-red-400">
                        Low @(_minPrice.ToString("F2"))
                    </span>
                </div>
            </div>
        </div>

        <div class="px-4 pb-4">
            <div class="h-[120px] w-full relative overflow-hidden">
                <svg viewBox="0 0 400 120" preserveAspectRatio="none" class="absolute inset-0 w-full h-full">
                    <defs>
                        <linearGradient id="fill-range-price" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%" stop-color="oklch(0.646 0.222 41.116)" stop-opacity="0.35" />
                            <stop offset="100%" stop-color="oklch(0.646 0.222 41.116)" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    @* Reference line: max price (High) *@
                    <line x1="0" y1="@(_maxY.ToString(System.Globalization.CultureInfo.InvariantCulture))" x2="360" y2="@(_maxY.ToString(System.Globalization.CultureInfo.InvariantCulture))" stroke="var(--muted-foreground)" stroke-dasharray="3 3" stroke-opacity="0.5" />
                    @((MarkupString)FormattableString.Invariant($"<text x=\"364\" y=\"{_maxY + 4}\" font-size=\"10\" fill=\"var(--muted-foreground)\" text-anchor=\"start\">High {_maxPrice:F0}</text>"))
                    @* Reference line: min price (Low) *@
                    <line x1="0" y1="@(_minY.ToString(System.Globalization.CultureInfo.InvariantCulture))" x2="360" y2="@(_minY.ToString(System.Globalization.CultureInfo.InvariantCulture))" stroke="var(--muted-foreground)" stroke-dasharray="3 3" stroke-opacity="0.5" />
                    @((MarkupString)FormattableString.Invariant($"<text x=\"364\" y=\"{_minY + 4}\" font-size=\"10\" fill=\"var(--muted-foreground)\" text-anchor=\"start\">Low {_minPrice:F0}</text>"))
                    @* Area fill *@
                    <path d="@_areaPath" fill="url(#fill-range-price)" />
                    @* Stroke line *@
                    <path d="@_linePath" fill="none" stroke="oklch(0.646 0.222 41.116)" stroke-width="2" />
                </svg>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly (string T, double Price)[] _chartData =
    [
        ("Mar 13", 182.4),
        ("Mar 15", 188.2),
        ("Mar 17", 194.6),
        ("Mar 19", 201.3),
        ("Mar 21", 198.1),
        ("Mar 23", 205.8),
        ("Mar 25", 212.7),
        ("Mar 27", 208.4),
        ("Mar 29", 216.9),
        ("Mar 31", 221.5),
        ("Apr 02", 218.2),
        ("Apr 04", 224.6),
        ("Apr 06", 229.1),
        ("Apr 08", 226.3),
        ("Apr 10", 231.8),
        ("Apr 12", 228.4),
    ];

    private static readonly System.Globalization.CultureInfo _usd =
        System.Globalization.CultureInfo.GetCultureInfo("en-US");

    // Computed stats
    private static readonly double _minPrice = _chartData.Min(d => d.Price);
    private static readonly double _maxPrice = _chartData.Max(d => d.Price);
    private static readonly double _currentPrice = _chartData[^1].Price;
    private static readonly double _rangeSpan = _maxPrice - _minPrice;
    private static readonly double _positionInRange = ((_currentPrice - _minPrice) / _rangeSpan) * 100.0;

    // SVG layout constants — viewBox is 400x120, right margin 40px leaves 360px for the chart
    private const double SvgWidth = 360.0;
    private const double SvgHeight = 120.0;
    private const double SvgPadTop = 12.0;
    private const double SvgPadBottom = 0.0;
    private static readonly double DomainMin = _minPrice - 4.0;
    private static readonly double DomainMax = _maxPrice + 4.0;
    private static readonly double DomainRange = DomainMax - DomainMin;

    // Y pixel for the high/low reference lines
    private static readonly double _maxY = MapY(_maxPrice);
    private static readonly double _minY = MapY(_minPrice);

    private static double MapX(int index) =>
        (index / (double)(_chartData.Length - 1)) * SvgWidth;

    private static double MapY(double price) =>
        SvgPadTop + (1.0 - (price - DomainMin) / DomainRange) * (SvgHeight - SvgPadTop - SvgPadBottom);

    // Build monotone-ish polyline paths
    private static readonly string _linePath = BuildLinePath();
    private static readonly string _areaPath = BuildAreaPath();

    private static string BuildLinePath()
    {
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < _chartData.Length; i++)
        {
            double x = MapX(i);
            double y = MapY(_chartData[i].Price);
            sb.Append(i == 0 ? FormattableString.Invariant($"M{x:F1},{y:F1}") : FormattableString.Invariant($" L{x:F1},{y:F1}"));
        }
        return sb.ToString();
    }

    private static string BuildAreaPath()
    {
        var sb = new System.Text.StringBuilder();
        for (int i = 0; i < _chartData.Length; i++)
        {
            double x = MapX(i);
            double y = MapY(_chartData[i].Price);
            sb.Append(i == 0 ? FormattableString.Invariant($"M{x:F1},{y:F1}") : FormattableString.Invariant($" L{x:F1},{y:F1}"));
        }
        // Close down to baseline
        double lastX = MapX(_chartData.Length - 1);
        double baseline = SvgHeight - SvgPadBottom;
        sb.Append(FormattableString.Invariant($" L{lastX:F1},{baseline:F1} L0,{baseline:F1} Z"));
        return sb.ToString();
    }
}
