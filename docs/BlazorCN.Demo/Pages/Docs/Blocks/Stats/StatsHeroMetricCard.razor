@* ============================================================
   Block: stats-hero-metric-card
   Title: StatsHeroMetricCard
   Description: A single headline hero metric stats card for React and Next.js with a NumberFlow animated text-4xl value, isAnimated mount guard, min-w-[180px] layout stability, and a trend delta with arrow icon built with shadcn/ui and Tailwind CSS
   Source: original/blocks/stats/stats-hero-metric-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-sm p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-5 py-5 sm:px-6 sm:py-6">
            <p class="text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                @MetricLabel
            </p>
            <p class="mt-1 text-xs text-muted-foreground">@TimeframeLabel</p>
            <div class="mt-5 min-w-[180px]">
                <span class="text-4xl font-semibold tabular-nums">@MetricValue.ToString("N0")</span>
            </div>
            <div class="mt-3 flex items-center gap-1.5">
                <span class="inline-flex items-center gap-1 rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                    <span class="tabular-nums">+@ChangePercent%</span>
                </span>
                <span class="text-xs text-muted-foreground tabular-nums">
                    vs @PreviousValue.ToString("N0") previous period
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private const int MetricValue = 48_372;
    private const double ChangePercent = 12.4;
    private const string TimeframeLabel = "Last 30 days";
    private const string MetricLabel = "Monthly active users";
    private const int PreviousValue = 43_037;
}
