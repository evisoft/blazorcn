@* ========================================
   Block: stats-customer-satisfaction
   Title: Stats Customer Satisfaction
   Description: NPS score stats with promoter/passive/detractor breakdown, trend indicator, and response count
   Dependencies: None
   Source: original/blocks/stats/stats-customer-satisfaction.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <p class="text-sm font-medium">Net Promoter Score</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_totalResponses.ToString("N0") responses
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">
                    @_label
                </span>
            </div>
        </div>

        @* Score *@
        <div class="border-b px-4 py-3">
            <div class="flex items-baseline gap-2">
                <span class="text-2xl font-semibold tabular-nums">@_npsScore</span>
                @if (_scoreChange > 0)
                {
                    <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">
                        +@_scoreChange pts
                    </span>
                }
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">vs @_previousScore last quarter</p>
        </div>

        @* Segmented bar *@
        <div class="border-b px-4 py-3">
            <div class="flex h-2 overflow-hidden rounded-full">
                @foreach (var seg in _segments)
                {
                    <div class="@(Cn.Merge("h-full", seg.Color))"
                         style="width: @(seg.Percentage)%"></div>
                }
            </div>
        </div>

        @* Legend *@
        <div>
            @for (var i = 0; i < _segments.Length; i++)
            {
                var seg = _segments[i];
                var isLast = i == _segments.Length - 1;

                <div class="@(Cn.Merge("flex items-center gap-2 px-4 py-2.5", !isLast ? "border-b" : ""))">
                    <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", seg.Color))"></span>
                    <span class="flex-1 text-sm">@seg.Label</span>
                    <span class="text-sm font-medium tabular-nums">@seg.Percentage%</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Segment(string Label, int Percentage, string Color);

    private const int _npsScore = 42;
    private const int _previousScore = 38;
    private const int _totalResponses = 1284;
    private const int _scoreChange = _npsScore - _previousScore;
    private const string _label = "Good";

    private static readonly Segment[] _segments =
    [
        new("Promoters", 58, "bg-emerald-500"),
        new("Passives", 26, "bg-amber-500"),
        new("Detractors", 16, "bg-red-500"),
    ];
}