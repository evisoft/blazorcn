@* ========================================
   Block: stats-invoice-aging
   Title: Stats Invoice Aging
   Description: Accounts receivable tracking showing outstanding invoices by aging bucket with payment status
   Dependencies: None
   Source: original/blocks/stats/stats-invoice-aging.tsx
   ======================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Invoice Aging</h2>
            <p class="mt-1 text-xs text-muted-foreground">Outstanding invoices by aging bucket</p>
        </div>

        <div class="grid grid-cols-2 gap-px border-b bg-border">
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Total Outstanding</div>
                <div class="mt-1 text-2xl font-semibold tabular-nums">
                    $@((_totalOutstanding / 1000.0).ToString("F1"))K
                </div>
                <div class="mt-1 text-xs text-muted-foreground">@_totalInvoices invoices</div>
            </div>
            <div class="bg-card px-4 py-3">
                <div class="text-xs text-muted-foreground">Overdue Amount</div>
                <div class="mt-1 text-2xl font-semibold tabular-nums text-red-500">
                    $@(((_agingBuckets[2].TotalAmount + _agingBuckets[3].TotalAmount) / 1000.0).ToString("F1"))K
                </div>
                <div class="mt-1 text-xs text-muted-foreground">
                    @(_agingBuckets[2].InvoiceCount + _agingBuckets[3].InvoiceCount) invoices
                </div>
            </div>
        </div>

        <div class="divide-y">
            @for (var i = 0; i < _agingBuckets.Length; i++)
            {
                var bucket = _agingBuckets[i];
                var isOverdue = i >= 2;
                var isCritical = i == 3;
                var avgInvoice = (double)bucket.TotalAmount / bucket.InvoiceCount / 1000.0;

                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@bucket.Name</span>
                                @if (isOverdue)
                                {
                                    <span class="@(Cn.Merge("size-1.5 rounded-full", isCritical ? "bg-red-500" : "bg-amber-500"))"></span>
                                }
                            </div>
                            <div class="mt-0.5 text-xs text-muted-foreground">@bucket.Range</div>

                            <div class="mt-3 grid grid-cols-2 gap-4">
                                <div>
                                    <div class="text-xs text-muted-foreground">Total Amount</div>
                                    <div class="@(Cn.Merge("mt-1 text-xl font-semibold tabular-nums", isCritical ? "text-red-500" : !isCritical && isOverdue ? "text-amber-500" : ""))">
                                        $@((bucket.TotalAmount / 1000.0).ToString("F1"))K
                                    </div>
                                    <div class="mt-0.5 text-xs text-muted-foreground">
                                        @(bucket.PercentOfTotal.ToString("F1"))% of total
                                    </div>
                                </div>

                                <div>
                                    <div class="text-xs text-muted-foreground">Invoice Count</div>
                                    <div class="mt-1 text-xl font-semibold tabular-nums">
                                        @bucket.InvoiceCount
                                    </div>
                                    <div class="mt-0.5 text-xs text-muted-foreground">
                                        $@(avgInvoice.ToString("F1"))K avg
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3">
                                <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                    <div class="@(Cn.Merge("h-full rounded-full transition-all", isCritical ? "bg-red-500" : isOverdue ? "bg-amber-500" : "bg-emerald-500"))"
                                         style="width: @(bucket.PercentOfTotal.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="border-t bg-muted/50 px-4 py-2.5">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Average Days Outstanding</span>
                <span class="font-medium tabular-nums">38 days</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record AgingBucket(string Name, string Range, int InvoiceCount, int TotalAmount, double PercentOfTotal);

    private static readonly AgingBucket[] _agingBuckets =
    [
        new("Current", "0-30 days", 45, 234500, 52.3),
        new("30 Days", "31-60 days", 28, 123400, 27.5),
        new("60 Days", "61-90 days", 12, 56780, 12.7),
        new("90+ Days", "90+ days overdue", 8, 33920, 7.5),
    ];

    private static readonly int _totalOutstanding = _agingBuckets.Sum(b => b.TotalAmount);
    private static readonly int _totalInvoices = _agingBuckets.Sum(b => b.InvoiceCount);
}
