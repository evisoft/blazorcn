@* ============================================================
   Block: testimonials-voice-note
   Title: TestimonialsVoiceNote
   Description: A voice note testimonial card list for React and Next.js with static waveform visualizations, play controls, duration labels, and transcript pull quotes built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-voice-note.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Voice notes
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Straight from the source.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Thirty-second voice notes from the designers and engineers who picked our platform and
                lived to talk about it.
            </p>
        </div>

        @* Voice note cards *@
        <div class="mt-12 flex flex-col gap-5">
            @foreach (var t in _testimonials)
            {
                <figure class="overflow-hidden rounded-2xl border bg-card p-6">
                    @* Voice message bar *@
                    <div class="flex items-center gap-4 rounded-xl border bg-muted/40 px-4 py-3">
                        <button type="button"
                                aria-label="@($"Play voice note from {t.Name}")"
                                class="flex size-10 shrink-0 items-center justify-center rounded-full border bg-background shadow-sm transition-transform hover:scale-105">
                            <LucideIconCn Name="play" Size="16" Class="size-4 translate-x-0.5 fill-foreground text-foreground" />
                        </button>
                        <div class="min-w-0 flex-1">
                            @* Waveform bars *@
                            <div aria-hidden="true" class="flex h-6 items-center gap-0.5">
                                @foreach (var h in t.WaveformHeights)
                                {
                                    <div class="w-1 rounded-full bg-foreground/40" style="@($"height:{h}px")"></div>
                                }
                            </div>
                        </div>
                        <span class="shrink-0 font-mono text-xs text-muted-foreground">
                            @t.Duration
                        </span>
                    </div>

                    @* Transcript *@
                    <blockquote class="mt-5 text-base leading-relaxed text-foreground">
                        &ldquo;@t.Transcript&rdquo;
                    </blockquote>

                    @* Attribution *@
                    <figcaption class="mt-5 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record VoiceTestimonial(string Id, string Name, string Initials, string Role, string Company, string Duration, string Transcript, int[] WaveformHeights);

    private static readonly VoiceTestimonial[] _testimonials =
    [
        new("vn1", "Emma Liu", "EL", "Lead Designer", "Figjam", "0:34",
            "Our design-to-code handoff dropped from two days to under an hour. The engineers stopped pinging me in Slack asking what a token meant.",
            [6, 10, 16, 20, 12, 18, 22, 14, 8, 20, 12, 6, 14, 20, 10, 18, 12, 6, 14, 10, 4]),
        new("vn2", "Jordan Reeves", "JR", "Staff Engineer", "Northwind", "0:47",
            "We spent a year building our own design system. We switched to this and shipped better results in a single sprint. I am still processing that.",
            [8, 12, 18, 10, 20, 14, 24, 12, 18, 6, 14, 20, 10, 12, 22, 14, 6, 18, 12, 10, 6]),
        new("vn3", "Priya Sharma", "PS", "VP Product", "Clerkly", "0:28",
            "Support tickets about UI inconsistencies dropped 80% in the first month. Our CX team literally had a party about it.",
            [10, 14, 6, 20, 12, 18, 10, 24, 14, 6, 12, 20, 10, 14, 18, 6, 12, 10, 14, 6, 4]),
    ];
}
