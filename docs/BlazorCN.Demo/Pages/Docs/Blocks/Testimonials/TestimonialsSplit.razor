@* ============================================================
   Block: testimonials-split
   Title: TestimonialsSplit
   Description: A split panel portrait testimonials block for React and Next.js with a full-bleed portrait placeholder, featured marketing-scale quote, secondary supporting quotes, and ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-split.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="font-medium text-muted-foreground text-xs uppercase tracking-widest">
                Customer stories
            </p>
            <h2 class="mt-3 font-bold text-3xl tracking-tight sm:text-4xl lg:text-5xl">
                The teams shipping with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base text-muted-foreground leading-relaxed">
                One story, told properly — from the engineers who rebuilt their frontend and stopped
                fighting their component library.
            </p>
        </div>

        @* Split panel *@
        <figure class="mt-12 grid overflow-hidden rounded-2xl border bg-card lg:grid-cols-2">
            @* Portrait placeholder *@
            <div class="relative aspect-[4/5] overflow-hidden bg-muted lg:aspect-auto">
                <div class="absolute inset-0 bg-gradient-to-br from-muted via-muted to-muted/40"></div>
                <div
                    aria-hidden="true"
                    class="absolute inset-0 opacity-20"
                    style="background-image:radial-gradient(circle at 30% 30%, var(--muted-foreground) 1px, transparent 1px);background-size:14px 14px;">
                </div>
                <div class="absolute bottom-6 left-6 flex items-center gap-3 rounded-xl border bg-card/90 px-4 py-3 backdrop-blur">
                    <div class="flex size-10 shrink-0 items-center justify-center overflow-hidden rounded-full border bg-muted">
                        <span class="font-mono font-semibold text-muted-foreground text-xs">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="font-semibold text-foreground text-sm">@_featured.Name</p>
                        <p class="text-muted-foreground text-xs">
                            @_featured.Role · @_featured.Company
                        </p>
                    </div>
                </div>
            </div>

            @* Quote panel *@
            <div class="flex flex-col justify-center p-8 sm:p-10 lg:p-14">
                <div class="flex items-center gap-0.5" role="img" aria-label="5 out of 5 stars">
                    @foreach (var i in _stars)
                    {
                        <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                    }
                </div>
                <blockquote class="mt-6 font-semibold text-foreground text-xl leading-[1.25] sm:text-2xl">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-4 border-t pt-6">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono font-semibold text-muted-foreground text-sm">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="font-semibold text-base text-foreground">@_featured.Name</p>
                        <p class="text-muted-foreground text-sm">
                            @_featured.Role · @_featured.Company
                        </p>
                    </div>
                </figcaption>
            </div>
        </figure>

        @* Supporting quotes *@
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
            @foreach (var t in _supporting)
            {
                <figure class="rounded-xl border bg-card p-6">
                    <blockquote class="text-base text-foreground leading-relaxed">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-5 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono font-semibold text-muted-foreground text-xs">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate font-semibold text-foreground text-sm">@t.Name</p>
                            <p class="truncate text-muted-foreground text-xs">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Featured(string Name, string Initials, string Role, string Company, string Quote);
    private record Supporting(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly int[] _stars = [0, 1, 2, 3, 4];

    private static readonly Featured _featured = new(
        "Sarah Chen",
        "SC",
        "VP of Engineering",
        "Dataflow",
        "We migrated our entire frontend in under three weeks and cut our bug count by 40%. My team stopped arguing about component APIs and started shipping features again."
    );

    private static readonly Supporting[] _supporting =
    [
        new("s1", "Marcus Rivera", "MR", "Lead Developer", "Stackline", "Our team velocity doubled in the first sprint. Copy, paste, ship — that is actually the workflow now."),
        new("s2", "Emily Zhang", "EZ", "Staff Product Designer", "Novetra", "Finally a library my designers and engineers both love. Zero pixel fights in our last six reviews."),
    ];
}
