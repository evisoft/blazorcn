@* ============================================================
   Block: testimonials-waterfall
   Title: TestimonialsWaterfall
   Description: A cascading two-column waterfall testimonials layout for React and Next.js with offset columns, varied card heights, and marketing-scale quote typography built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-waterfall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Loved by developers
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Six teams, one cascade of proof.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Read the full cascade of customer stories — from one-person shops to engineering orgs
                running thousands of deploys a day.
            </p>
        </div>

        @* Waterfall grid *@
        <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2">
            <div class="flex flex-col gap-5">
                @foreach (var t in _leftColumn)
                {
                    <figure class="rounded-xl border bg-card p-6">
                        <blockquote class="text-base leading-relaxed text-foreground">
                            "@t.Quote"
                        </blockquote>
                        <figcaption class="mt-5 flex items-center gap-3">
                            <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                                <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                    @t.Initials
                                </span>
                            </div>
                            <div class="min-w-0">
                                <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                                <p class="truncate text-xs text-muted-foreground">
                                    @t.Role · @t.Company
                                </p>
                            </div>
                        </figcaption>
                    </figure>
                }
            </div>
            <div class="flex flex-col gap-5 md:pt-16">
                @foreach (var t in _rightColumn)
                {
                    <figure class="rounded-xl border bg-card p-6">
                        <blockquote class="text-base leading-relaxed text-foreground">
                            "@t.Quote"
                        </blockquote>
                        <figcaption class="mt-5 flex items-center gap-3">
                            <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                                <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                    @t.Initials
                                </span>
                            </div>
                            <div class="min-w-0">
                                <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                                <p class="truncate text-xs text-muted-foreground">
                                    @t.Role · @t.Company
                                </p>
                            </div>
                        </figcaption>
                    </figure>
                }
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record WaterfallTestimonial(string Id, string Quote, string Name, string Initials, string Role, string Company);

    private static readonly WaterfallTestimonial[] _leftColumn =
    [
        new("wf1",
            "The migration was seamless. Every component dropped into our codebase without a single conflict and we shipped to production on the same Friday.",
            "Liam Chen", "LC", "Senior Engineer", "Voltaware"),
        new("wf2",
            "We went from a fragmented collection of internal components to a cohesive design system in three weeks. The TypeScript types caught every integration issue at compile time — not in production. Our QA team was genuinely surprised and slightly insulted.",
            "Sofia Andersson", "SA", "Engineering Lead", "Northwind"),
        new("wf3",
            "Best developer experience of any component library we have ever shipped with. Period.",
            "Raj Patel", "RP", "CTO", "Dubsly"),
    ];

    private static readonly WaterfallTestimonial[] _rightColumn =
    [
