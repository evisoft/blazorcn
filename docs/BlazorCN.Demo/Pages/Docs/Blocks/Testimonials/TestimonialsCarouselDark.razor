@* ============================================================
   Block: testimonials-carousel-dark
   Title: TestimonialsCarouselDark
   Description: A dark inset featured quote carousel for React and Next.js with real drag gestures, keyboard navigation, autoplay rotation, pagination dots, and a theme-safe inverted color scheme built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-carousel-dark.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-muted-foreground text-xs font-medium uppercase tracking-widest">
                What leaders say
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Trusted by engineering leaders.
            </h2>
            <p class="text-muted-foreground mx-auto mt-4 max-w-xl text-base leading-relaxed">
                Four executive voices, one consistent story: migrating to our platform is the
                highest-leverage decision their teams made this year.
            </p>
        </div>

        @* Dark inset panel *@
        <div class="bg-foreground text-background relative mt-10 overflow-hidden rounded-2xl p-8 sm:p-14">
            <LucideIconCn Name="quote" Size="128" Class="text-background/15 absolute -right-4 -top-4 size-32 sm:size-40" aria-hidden="true" />

            <figure class="relative cursor-pointer">
                <blockquote class="text-background text-2xl font-semibold leading-[1.15] tracking-tight sm:text-3xl lg:text-4xl">
                    &ldquo;@_testimonials[_index].Quote&rdquo;
                </blockquote>
                <figcaption class="mt-10 flex items-center gap-4">
                    <div class="bg-background/10 border-background/20 relative size-14 shrink-0 overflow-hidden rounded-full border">
                        <span class="text-background absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold">
                            @_testimonials[_index].Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-background text-base font-semibold">@_testimonials[_index].Name</p>
                        <p class="text-background/60 text-sm">
                            @_testimonials[_index].Role · @_testimonials[_index].Company
                        </p>
                    </div>
                </figcaption>
            </figure>

            @* Pagination dots *@
            <div class="relative mt-10 flex items-center justify-center gap-0.5">
                @for (var i = 0; i < _testimonials.Length; i++)
                {
                    var dotIndex = i;
                    <button
                        type="button"
                        aria-label="@($"Go to testimonial from {_testimonials[dotIndex].Name}")"
                        aria-current="@(dotIndex == _index ? "true" : null)"
                        class="inline-flex size-6 items-center justify-center"
                        @onclick="@(() => _index = dotIndex)">
                        <span class="@(Cn.Merge("h-1.5 rounded-full transition-all", dotIndex == _index ? "bg-background w-6" : "bg-background/30 hover:bg-background/60 w-1.5"))"></span>
                    </button>
                }
            </div>
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[200px]">Book a demo</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private int _index;

    private void Advance() => _index = (_index + 1) % _testimonials.Length;
    private void Retreat() => _index = (_index - 1 + _testimonials.Length) % _testimonials.Length;

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Alexandra Chen", "AC", "CTO", "Meridian Labs",
            "We reduced our frontend development cycle from six weeks to two. The component quality and TypeScript definitions eliminated an entire category of bugs from our codebase."),
        new("t2", "Marcus Williams", "MW", "VP of Engineering", "DataFlow Systems",
            "Our operational costs dropped 40 percent while p99 latency improved 60 percent. The ROI was clear within the first quarter of adoption."),
        new("t3", "Sarah Thompson", "ST", "Head of Product", "CloudNine",
            "Our team was productive from day one. The documentation covers every edge case we have encountered and we haven't opened a single support ticket in four months."),
        new("t4", "David Park", "DP", "Engineering Manager", "Baseline Analytics",
            "Evaluated five component libraries. The theming flexibility, bundle size, and accessibility defaults were simply unmatched — this was the obvious choice."),
    ];
}
