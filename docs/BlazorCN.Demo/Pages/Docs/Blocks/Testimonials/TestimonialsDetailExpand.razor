@* ============================================================
   Block: testimonials-detail-expand
   Title: TestimonialsDetailExpand
   Description: An expandable accordion testimonial list for React and Next.js with two-line preview truncation, height-animated reveal, rotating chevron indicators, and large avatar attribution atoms built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-detail-expand.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                What engineers say
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Four quotes. Four shipping teams.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Tap any quote to read the full story from the engineers who pushed their first commit in
                production within a week.
            </p>
        </div>

        @* Accordion list *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            @foreach (var testimonial in _testimonials)
            {
                var t = testimonial;
                var isExpanded = _expanded == t.Id;
                var isLast = t.Id == _testimonials[_testimonials.Length - 1].Id;
                <div class="@Cn.Merge(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-start gap-4 px-6 py-5 text-left transition-colors hover:bg-muted/40"
                            @onclick="@(() => Toggle(t.Id))"
                            aria-expanded="@(isExpanded ? "true" : "false")"
                            aria-label="@($"{(isExpanded ? "Collapse" : "Expand")} testimonial from {t.Name}")">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="@Cn.Merge("text-base leading-relaxed text-foreground", isExpanded ? "" : "line-clamp-2")">
                                @(isExpanded ? "" : $"“{t.Preview}”")
                            </p>
                            @if (!isExpanded)
                            {
                                <p class="mt-2 truncate text-xs text-muted-foreground">
                                    <span class="font-semibold text-foreground">@t.Name</span>
                                    @(" · ")
                                    @t.Role &middot; @t.Company
                                </p>
                            }
                        </div>
                        <LucideIconCn Name="chevron-down"
                                      Size="20"
                                      Class="@Cn.Merge("mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-200", isExpanded ? "rotate-180" : "")"
                                      aria-hidden="true" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <figure class="px-6 pb-6">
                                <blockquote class="text-base leading-relaxed text-foreground">
                                    &ldquo;@t.FullQuote&rdquo;
                                </blockquote>
                                <figcaption class="mt-5 flex items-center gap-4 border-t pt-5">
                                    <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                                            @t.Initials
                                        </span>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="truncate text-sm font-semibold text-foreground">
                                            @t.Name
                                        </p>
                                        <p class="truncate text-xs text-muted-foreground">
                                            @t.Role &middot; @t.Company
                                        </p>
                                    </div>
                                </figcaption>
                            </figure>
                        </div>
                    }
                </div>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(
        string Id,
        string Name,
        string Initials,
        string Role,
        string Company,
        string Preview,
        string FullQuote
    );

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Rachel Kim", "RK", "VP of Engineering", "Linearly",
            "Our frontend velocity doubled within the first sprint. The TypeScript inference is flawless and our accessibility audit passed with zero critical findings.",
            "Our frontend velocity doubled within the first sprint. The TypeScript inference is flawless and our accessibility audit passed with zero critical findings. Designers stopped filing component-level tickets entirely. The animation timing matches our Figma prototypes exactly — that has never happened with any other library we tried. We estimate it saved us three months of engineering time in the first quarter alone."),
        new("t2", "James Okonkwo", "JO", "Lead Designer", "Northwind",
            "We migrated our entire design system in four days instead of the projected three months. Our bundle size actually decreased by 18% after switching.",
            "We migrated our entire design system in four days instead of the projected three months. Every component matched our Figma specs with minimal overrides. Our bundle size actually decreased by 18% after switching from our custom components. The real surprise was how quickly our team adopted it — no resistance, just excitement, and a zero-ticket backlog by the end of the sprint."),
        new("t3", "Sofia Martinez", "SM", "Staff Engineer", "Halide Inc.",
            "Our junior engineers ship production-quality interfaces on their first day. That has never happened before at any company I have worked at.",
            "The best developer experience we have seen in a UI library, full stop. Auto-complete works everywhere, error messages are actionable, and the documentation covers every edge case we ran into. Our junior engineers ship production-quality interfaces on their first day. That has never happened before. The component API is small enough to learn in an afternoon but flexible enough for our most complex dashboard views."),
        new("t4", "Alex Novak", "AN", "Design Systems Manager", "Voltaware",
            "For the first time, all 12 product teams ship consistent UI without a dedicated design-systems team policing every pull request.",
            "For the first time, all 12 product teams ship consistent UI without a dedicated design-systems team policing every pull request. The tokens, the spacing scale, the animation curves — everything aligns. Our brand feels unified across every surface, and engineering velocity has never been higher. We cancelled our plan to build a custom design system because this already does everything we needed and more."),
    ];

    private string? _expanded = "t1";

    private void Toggle(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
