@* ============================================================
   Block: testimonials-quote-large
   Title: TestimonialsQuoteLarge
   Description: A featured hero testimonial block for React and Next.js with an oversized focal quote, decorative quote mark, star rating line, hero attribution, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-quote-large.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The teams shipping with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                One voice, one story, one year in production — here is what changed for the engineering
                teams who switched.
            </p>
        </div>

        @* Featured hero quote card *@
        <figure class="relative mt-12 overflow-hidden rounded-2xl border bg-card p-10 sm:p-14">
            <LucideIconCn Name="quote" Size="96" aria-hidden="true"
                Class="absolute -left-2 -top-2 size-24 fill-muted/60 text-muted/60 sm:-left-4 sm:-top-4 sm:size-32" />

            @* Stars credibility line *@
            <div role="img" aria-label="5 out of 5 stars" class="relative flex items-center gap-0.5">
                @foreach (var i in _stars)
                {
                    <LucideIconCn Name="star" Size="16" aria-hidden="true"
                        Class="size-4 fill-amber-500 text-amber-500" />
                }
            </div>

            @* Hero quote *@
            <blockquote class="relative mt-6 text-2xl font-semibold leading-[1.15] tracking-tight text-foreground sm:text-3xl lg:text-4xl">
                &ldquo;@_quote&rdquo;
            </blockquote>

            @* Attribution *@
            <figcaption class="relative mt-10 flex items-center gap-4">
                <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                        @_initials
                    </span>
                </div>
                <div>
                    <p class="text-base font-semibold text-foreground">@_author</p>
                    <p class="text-sm text-muted-foreground">
                        @_role · @_company
                    </p>
                </div>
            </figcaption>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _stars = [0, 1, 2, 3, 4];

    private const string _quote =
        "We went from monthly releases to weekly, and cut our on-call pager rings in half in the first quarter. The team stopped dreading deploys.";
    private const string _author = "Michael Chen";
    private const string _role = "Chief Technology Officer";
    private const string _company = "DataFlow";
    private const string _initials = "MC";
}
