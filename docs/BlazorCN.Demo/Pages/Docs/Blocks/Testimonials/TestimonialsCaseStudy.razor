@* ============================================================
   Block: testimonials-case-study
   Title: TestimonialsCaseStudy
   Description: An editorial dropcap case study testimonial block for React and Next.js with challenge-solution-result narrative, animated key metric, and pull quote attribution built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-case-study.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer case study
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Three sprints. Zero UI backlog.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                How a 45-engineer team at @_caseStudy.Company reclaimed 40% of their sprint capacity and
                tripled frontend velocity in a single quarter.
            </p>
        </div>

        @* Editorial figure *@
        <figure class="mt-12 overflow-hidden rounded-2xl border bg-card p-8 sm:p-10">
            <div class="flex items-center gap-3 text-xs font-medium uppercase tracking-widest text-muted-foreground">
                <span>@_caseStudy.Company</span>
                <span aria-hidden="true">·</span>
                <span>@_caseStudy.Industry</span>
            </div>

            @* Narrative with dropcap on first section *@
            <div class="mt-6 space-y-6">
                @foreach (var sec in _sections)
                {
                    var sectionIndex = Array.IndexOf(_sections, sec);
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
                            @sec.Label
                        </p>
                        <p class="@(sectionIndex == 0 ? "mt-2 text-xl leading-relaxed text-foreground first-letter:float-left first-letter:mr-3 first-letter:text-7xl first-letter:font-semibold first-letter:leading-[0.8]" : "mt-2 text-xl leading-relaxed text-foreground")">
                            @sec.Content
                        </p>
                    </div>
                }
            </div>

            @* Key metric *@
            <div class="mt-10 flex items-baseline justify-center gap-4 border-y py-8">
                <p class="font-bold text-5xl tabular-nums tracking-tight sm:text-6xl">
                    @(_caseStudy.KeyMetric.Value)@(_caseStudy.KeyMetric.Suffix)
                </p>
                <p class="text-sm text-muted-foreground">@_caseStudy.KeyMetric.Label</p>
            </div>

            @* Pull quote *@
            <blockquote class="mt-10 text-xl font-medium leading-relaxed text-foreground sm:text-2xl">
                &ldquo;@_caseStudy.Quote&rdquo;
            </blockquote>

            <figcaption class="mt-6 flex items-center gap-4">
                <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                        @_caseStudy.Initials
                    </span>
                </div>
                <div>
                    <p class="text-sm font-semibold text-foreground">@_caseStudy.Name</p>
                    <p class="text-xs text-muted-foreground">
                        @_caseStudy.Role · @_caseStudy.Company
                    </p>
                </div>
            </figcaption>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Read the case study</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">
                Talk to sales
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record KeyMetric(int Value, string Suffix, string Label);

    private record CaseStudy(
        string Company,
        string Industry,
        string Challenge,
        string Solution,
        string Result,
        KeyMetric KeyMetric,
        string Quote,
        string Name,
        string Initials,
        string Role);

    private record Section(string Label, string Content);

    private static readonly CaseStudy _caseStudy = new(
        Company: "Stackline",
        Industry: "Developer Tools",
        Challenge: "Stackline's 45-engineer frontend team was burning 40% of sprint capacity building and maintaining 200+ inconsistent UI components. Every new feature meant weeks of design iteration, accessibility testing, and cross-browser QA before a single line of product code shipped.",
        Solution: "A two-person team swapped the internal component library for production-ready blocks in two weeks. They matched their brand through the theming system without touching component internals. Zero forks, zero overrides.",
        Result: "Frontend velocity tripled in a single quarter. The UI inconsistency backlog went to zero. Accessibility audit scores jumped from 62 to 97. Reclaimed capacity now ships core product features instead of buttons.",
        KeyMetric: new KeyMetric(3, "x", "Faster frontend shipping"),
        Quote: "We went from dreading UI work to it being the fastest part of our development cycle. The ROI was visible inside of two weeks.",
        Name: "Alexandra Torres",
        Initials: "AT",
        Role: "VP of Engineering");

    private static readonly Section[] _sections =
    [
        new("Challenge", _caseStudy.Challenge),
        new("Solution", _caseStudy.Solution),
        new("Result", _caseStudy.Result),
    ];
}
