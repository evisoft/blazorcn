@* ============================================================
   Block: testimonials-mobile-review
   Title: TestimonialsMobileReview
   Description: A dark inset featured-quote testimonials block for React and Next.js with inverted color panel, oversized quote typography, credibility star row, and a marketing headline cluster, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-mobile-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                A customer story
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                One quote is worth a thousand reviews.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A single transformative customer story, amplified by an inverted panel so you stop
                scrolling and actually read it.
            </p>
        </div>

        @* Dark inset *@
        <figure class="mt-12 overflow-hidden rounded-2xl bg-foreground p-10 text-background sm:p-14">
            @* Stars *@
            <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                @foreach (var i in _starIndices)
                {
                    <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                }
            </div>

            @* Quote *@
            <blockquote class="mt-6 text-2xl font-semibold leading-[1.2] tracking-tight text-background sm:text-3xl lg:text-4xl">
                &ldquo;@_featured.Quote&rdquo;
            </blockquote>

            @* Attribution *@
            <figcaption class="mt-10 flex items-center gap-4">
                <div class="relative size-14 shrink-0 overflow-hidden rounded-full border border-background/20 bg-background/10">
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-background">
                        @_featured.Initials
                    </span>
                </div>
                <div>
                    <p class="text-base font-semibold text-background">@_featured.Name</p>
                    <p class="text-sm text-background/70">
                        @_featured.Role · @_featured.Company
                    </p>
                </div>
            </figcaption>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Read their story</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FeaturedData(string Id, string Name, string Initials, string Role, string Company, string Quote, int Rating);

    private static readonly FeaturedData _featured = new(
        Id: "f1",
        Name: "Sarah Chen",
        Initials: "SC",
        Role: "Head of Engineering",
        Company: "Linearly",
        Quote: "We shipped five years of backlog in three months. The team debates whether it was the platform or finally having a pipeline that didn't fight us — but the results don't lie.",
        Rating: 5
    );

    private static readonly int[] _starIndices = [0, 1, 2, 3, 4];
}
