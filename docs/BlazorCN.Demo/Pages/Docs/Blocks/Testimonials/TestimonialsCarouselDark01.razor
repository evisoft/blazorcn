@* ============================================================
   Block: testimonials-carousel-dark-01
   Title: Testimonials Carousel Dark 01
   Description: Testimonials carousel with dark background, company logos, and avatar dot navigation for B2B social proof
   Long Description: Testimonials with user statistics
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, ButtonCn, CardCn, CardContentCn, LucideChevronLeftCn, LucideChevronRightCn
   Source: original/blocks/testimonials/testimonials-carousel-dark-01.tsx
   ============================================================ *@

<section class="bg-slate-900 py-20">
    <div class="container mx-auto px-4">
        <div class="mx-auto max-w-4xl">
            <div class="mb-12 text-center">
                <img alt="@(_testimonials[_currentIndex].Company) logo" class="mx-auto mb-8 h-12 invert" height="400" src="@_testimonials[_currentIndex].Logo" width="400" />
            </div>

            <CardCn Class="border-0 bg-slate-800/50 shadow-2xl">
                <CardContentCn Class="p-8 md:p-12">
                    <blockquote class="mb-8 text-center text-xl font-normal leading-relaxed text-white md:text-2xl">
                        &quot;@_testimonials[_currentIndex].Quote&quot;
                    </blockquote>

                    <div class="text-center">
                        <p class="text-lg font-semibold text-white">@_testimonials[_currentIndex].Name</p>
                        <p class="text-slate-400">
                            @_testimonials[_currentIndex].Role, @_testimonials[_currentIndex].Company
                        </p>
                    </div>
                </CardContentCn>
            </CardCn>

            <div class="mt-8 flex items-center justify-center gap-4">
                <ButtonCn Class="text-white hover:bg-slate-800 hover:text-white" @onclick="Prev" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                    <LucideChevronLeftCn class="h-6 w-6" />
                    <span class="sr-only">Previous testimonial</span>
                </ButtonCn>

                <div class="flex gap-3">
                    @for (var i = 0; i < _testimonials.Length; i++)
                    {
                        var index = i;
                        <button type="button" aria-label="@($"View testimonial from {_testimonials[index].Name}")"
                                class="@(Cn.Merge("transition-all", (index == _currentIndex ? "ring-primary ring-2 ring-offset-2 ring-offset-slate-900" : "opacity-50 hover:opacity-100")))"
                                @onclick="() => _currentIndex = index">
                            <AvatarCn Class="h-12 w-12">
                                <AvatarImageCn Alt="@_testimonials[index].Name" Src="@_testimonials[index].Image" />
                                <AvatarFallbackCn>@GetInitials(_testimonials[index].Name)</AvatarFallbackCn>
                            </AvatarCn>
                        </button>
                    }
                </div>

                <ButtonCn Class="text-white hover:bg-slate-800 hover:text-white" @onclick="Next" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                    <LucideChevronRightCn class="h-6 w-6" />
                    <span class="sr-only">Next testimonial</span>
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record TestimonialItem(string Name, string Role, string Company, string Logo, string Image, string Quote);

    private int _currentIndex;

    private static string GetInitials(string name) =>
        string.Join("", name.Split(' ').Select(n => n[0]));

    private void Next() => _currentIndex = (_currentIndex + 1) % _testimonials.Length;
    private void Prev() => _currentIndex = (_currentIndex - 1 + _testimonials.Length) % _testimonials.Length;

    private readonly TestimonialItem[] _testimonials =
    [
        new("Alexandra Chen", "CTO", "TechCorp", "https://v3.material-tailwind.com/logo/google.svg",
            "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=400&h=400",
            "This platform has revolutionized how we manage our infrastructure. The scalability and reliability are unmatched in the industry."),
        new("Marcus Williams", "VP of Engineering", "DataFlow", "https://v3.material-tailwind.com/logo/microsoft.svg",
            "https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&q=80&w=400&h=400",
            "We've reduced our operational costs by 60% while improving performance. The ROI was clear within the first quarter."),
        new("Sarah Thompson", "Head of Product", "CloudNine", "https://v3.material-tailwind.com/logo/netflix.svg",
            "https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&q=80&w=400&h=400",
            "The developer experience is exceptional. Our team was productive from day one, and the documentation is comprehensive."),
    ];
}
