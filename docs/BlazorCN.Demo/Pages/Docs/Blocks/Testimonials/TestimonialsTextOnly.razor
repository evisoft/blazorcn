@* ============================================================
   Block: testimonials-text-only
   Title: TestimonialsTextOnly
   Description: An editorial dropcap testimonials block for React and Next.js with magazine-style typography, an oversized first letter, a long-form pull quote, em-dash attribution, and a featured-in credibility line built with motion/react, shadcn/ui, and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-text-only.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Featured story
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                A letter from Linearly.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                One long-form note from an engineering leader who migrated her team off a stack they had
                spent four years building.
            </p>
        </div>

        @* Editorial quote *@
        <figure class="mt-12 rounded-2xl border bg-card p-8 sm:p-12">
            <blockquote class="text-xl leading-relaxed text-foreground first-letter:float-left first-letter:mr-3 first-letter:text-7xl first-letter:font-semibold first-letter:leading-[0.8] first-letter:text-foreground">
                @_quote
            </blockquote>

            <figcaption class="mt-10 text-base text-muted-foreground">
                &mdash; <span class="font-semibold text-foreground">@_author</span>,
                @_role &middot; @_company
            </figcaption>

            <p class="mt-6 border-l-2 border-border pl-4 text-xs uppercase tracking-widest text-muted-foreground">
                @_featured
            </p>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string _quote =
        "The first platform in five years that my engineers asked to use on their own time. We migrated off a stack we had spent four years building, and nobody filed a single regret issue. Deploy times dropped from fourteen minutes to ninety seconds, our on-call pager has rung twice this quarter instead of twice a day, and two of my staff engineers told me they cancelled their job interviews. I did not ask them to.";

    private const string _author = "Sarah Chen";
    private const string _role = "Head of Engineering";
    private const string _company = "Linearly";
    private const string _featured = "As featured in the Linearly Engineering Blog";
}
