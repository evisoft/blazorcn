@* ============================================================
   Block: testimonials-featured-badge
   Title: TestimonialsFeaturedBadge
   Description: A bento-style testimonial grid for React and Next.js with one featured hero quote spanning two rows and three supporting trio cards built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-featured-badge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Editor&rsquo;s picks
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The stories we can&rsquo;t stop telling.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Hand-picked quotes from teams who moved fast and measured what changed. One headliner,
                three supporting voices.
            </p>
        </div>

        @* Bento grid *@
        <div class="mt-12 grid gap-4 sm:grid-cols-3 sm:grid-rows-2">
            @* Featured cell *@
            <figure class="overflow-hidden rounded-2xl border bg-muted/30 p-8 sm:col-span-2 sm:row-span-2 sm:p-10">
                <div
                    role="img"
                    aria-label="@($"{_featured.Rating} out of 5 stars")"
                    class="flex items-center gap-0.5">
                    @for (var i = 0; i < 5; i++)
                    {
                        <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                    }
                </div>
                <blockquote class="mt-6 text-xl font-semibold leading-[1.25] text-foreground sm:text-2xl">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-foreground">@_featured.Name</p>
                        <p class="text-sm text-muted-foreground">
                            @_featured.Role &middot; @_featured.Company
                        </p>
                    </div>
                </figcaption>
            </figure>

            @* Trio cells *@
            @foreach (var t in _trio)
            {
                <figure class="overflow-hidden rounded-xl border bg-card p-5">
                    <blockquote class="text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-4 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role &middot; @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TestimonialData(string Id, string Name, string Initials, string Role, string Company, string Quote, int Rating, bool Featured = false);

    private static readonly TestimonialData[] _testimonials =
    [
        new("t1", "Alexandra Reeves", "AR", "Head of Product", "Streamline",
            "We evaluated seven component libraries over three weeks. This was the only one where every component worked perfectly out of the box with our tokens. Our team shipped the new settings surface in four days instead of the six weeks we'd budgeted.",
            5, Featured: true),
        new("t2", "David Okonkwo", "DO", "Staff Engineer", "Tessera",
            "New hires are productive on day one. Our onboarding doc shrank from 40 pages to 6.",
            5),
        new("t3", "Mia Johansson", "MJ", "Design Systems Lead", "Vantage",
            "Our designers now prototype directly in code. Prototypes ship to production without a rewrite.",
            5),
        new("t4", "Priya Raman", "PR", "Platform Lead", "Halide Inc.",
            "Cut our design-to-ship cycle from nine days to under two. The savings paid for the tool in a month.",
            5),
    ];

    private TestimonialData _featured = _testimonials.FirstOrDefault(t => t.Featured) ?? _testimonials[0];
    private TestimonialData[] _trio = _testimonials.Where(t => t.Id != (_testimonials.FirstOrDefault(x => x.Featured) ?? _testimonials[0]).Id).Take(3).ToArray();
}
