@* ============================================================
   Block: testimonials-grid-interactive
   Title: TestimonialsGridInteractive
   Description: An asymmetric bento testimonials grid for React and Next.js with one featured quote cell, three supporting cards, a marketing headline cluster, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-grid-interactive.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                One voice. Many reasons.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                One featured story from a team who bet their roadmap on us, plus three more voices from
                across the stack.
            </p>
        </div>

        @* Bento *@
        <div class="mt-12 grid gap-4 sm:grid-cols-3 sm:grid-rows-2">
            @* Featured cell *@
            <figure class="flex flex-col justify-between rounded-2xl border bg-card p-8 sm:col-span-2 sm:row-span-2 sm:p-10">
                <blockquote class="text-xl font-semibold leading-[1.25] tracking-tight text-foreground sm:text-2xl">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-4">
                    <div class="relative flex size-14 shrink-0 items-center justify-center overflow-hidden rounded-full border bg-muted">
                        <span class="font-mono text-sm font-semibold text-muted-foreground">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-foreground">@_featured.Name</p>
                        <p class="text-sm text-muted-foreground">
                            @_featured.Role &middot; @_featured.Company
                        </p>
                    </div>
                </figcaption>
            </figure>

            @* Trio *@
            @foreach (var t in _trio)
            {
                <figure class="flex flex-col justify-between rounded-xl border bg-card p-6">
                    <blockquote class="text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-5 flex items-center gap-3">
                        <div class="relative flex size-10 shrink-0 items-center justify-center overflow-hidden rounded-full border bg-muted">
                            <span class="font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role &middot; @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TestimonialData(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly TestimonialData[] _testimonials =
    [
        new("t1", "Sarah Chen", "SC", "Head of Engineering", "Linearly",
            "We shipped five years of backlog in three months. The team still debates whether it was the platform or finally having a deploy pipeline that didn't fight us — but the results don't lie."),
        new("t2", "Marcus Rivera", "MR", "Staff Engineer", "Northwind",
            "Our on-call pager rang twice last quarter. Before switching, it rang twice a day."),
        new("t3", "Emily Nakamura", "EN", "Design Systems Lead", "Halide Inc.",
            "Migrated our entire design system in two weeks instead of the projected two months."),
        new("t4", "Priya Raman", "PR", "Platform Lead", "Voltaware",
            "Cut our p99 latency from 900ms to 80ms in a weekend. The rollback plan was never needed."),
    ];

    private static readonly TestimonialData _featured = _testimonials[0];
    private static readonly TestimonialData[] _trio = _testimonials[1..];
}
