@* ============================================================
   Block: testimonials-progress-bar
   Title: TestimonialsProgressBar
   Description: A metric bar testimonials block for React and Next.js pairing an animated five-category rating breakdown with two supporting marketing-scale quotes and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-progress-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Rating breakdown
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The numbers back it up.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Eight hundred and forty verified customers, five categories, and two engineers who say
                it better than any chart.
            </p>
        </div>

        @* Metric bar card *@
        <div class="mt-12 overflow-hidden rounded-2xl border bg-card p-8 sm:p-10">
            <div class="flex items-baseline justify-between">
                <p class="text-sm font-semibold text-foreground">Overall satisfaction</p>
                <div class="flex items-baseline gap-1">
                    <span class="text-3xl font-bold tabular-nums tracking-tight">
                        @_overallScore%
                    </span>
                    <span class="text-xs text-muted-foreground">· 840 ratings</span>
                </div>
            </div>

            <div class="mt-6 space-y-4">
                @foreach (var cat in _categories)
                {
                    <div>
                        <div class="mb-1.5 flex items-center justify-between">
                            <span class="text-sm font-medium text-foreground">@cat.Label</span>
                            <span class="font-mono text-xs tabular-nums text-muted-foreground">
                                @cat.Percentage%
                            </span>
                        </div>
                        <div
                            role="progressbar"
                            aria-valuenow="@cat.Percentage"
                            aria-valuemin="0"
                            aria-valuemax="100"
                            aria-label="@($"{cat.Label}: {cat.Percentage}%")"
                            class="h-2 w-full overflow-hidden rounded-full bg-muted">
                            <div
                                class="h-full rounded-full bg-foreground"
                                style="@($"width:{cat.Percentage}%")">
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Supporting quotes *@
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
            @foreach (var q in _quotes)
            {
                <figure class="rounded-xl border bg-card p-6">
                    <blockquote class="text-base leading-relaxed text-foreground">
                        &ldquo;@q.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-3">
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @q.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@q.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @q.Role · @q.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[270px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Category(string Label, int Percentage);

    private record SupportingQuote(string Id, string Quote, string Name, string Initials, string Role, string Company);

    private static readonly Category[] _categories =
    [
        new("Ease of Use", 95),
        new("Customer Support", 92),
        new("Value for Money", 88),
        new("Features", 90),
        new("Reliability", 97),
    ];

    private static readonly SupportingQuote[] _quotes =
    [
        new("q1",
            "Zero downtime incidents in eight months of production. Our SLO dashboards are so boring I stopped checking them on weekends.",
            "Marcus Chen", "MC", "SRE Lead", "Planetscale"),
        new("q2",
            "Our junior engineers shipped features on day one. The API surface is small enough to hold in your head and the defaults are never wrong.",
            "Lisa Huang", "LH", "Engineering Director", "Northwind"),
    ];

    private static readonly int _overallScore =
        (int)Math.Round(_categories.Average(c => c.Percentage));
}
