@* ============================================================
   Block: testimonials-rotating
   Title: TestimonialsRotating
   Description: A draggable layered testimonials swipe stack for React and Next.js with real drag gestures, autoplay rotation, keyboard navigation, and pagination dots built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-rotating.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The teams shipping with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Drag, swipe, or wait &mdash; the stack rotates itself. Real quotes from engineering teams who
                use the platform in production.
            </p>
        </div>

        <div class="relative mt-12 h-[440px]">
            @foreach (var offset in new[] { 2, 1, 0 })
            {
                var cardIdx = (_index + offset) % _testimonials.Length;
                var card = _testimonials[cardIdx];
                var isActive = offset == 0;
                var zIndex = 3 - offset;
                var translateY = offset * 24;
                var scale = 1.0 - offset * 0.06;
                var opacity = 1.0 - offset * 0.3;
                var styleStr = $"z-index:{zIndex};transform:translateY({translateY}px) scale({scale.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)});opacity:{opacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)};transition:transform 0.4s ease,opacity 0.4s ease;";
                <figure class="absolute inset-0 overflow-hidden rounded-2xl border bg-card p-6 shadow-lg sm:p-8"
                        style="@styleStr"
                        aria-hidden="@(isActive ? "false" : "true")">
                    <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                        @for (var i = 0; i < 5; i++)
                        {
                            <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>

                    <blockquote class="mt-6 text-lg font-medium leading-relaxed text-foreground sm:text-xl">
                        &ldquo;@card.Quote&rdquo;
                    </blockquote>

                    <figcaption class="mt-8 flex items-center gap-4">
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                                @card.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@card.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @card.Role &middot; @card.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        <div class="mt-6 flex items-center justify-center gap-2">
            @for (var i = 0; i < _testimonials.Length; i++)
            {
                var idx = i;
                var dotClass = idx == _index
                    ? "h-1.5 w-6 rounded-full bg-foreground transition-all"
                    : "h-1.5 w-1.5 rounded-full bg-muted-foreground/30 hover:bg-muted-foreground/60 transition-all";
                <button type="button"
                        @onclick="@(() => SetIndex(idx))"
                        aria-label="@($"Go to testimonial {idx + 1} of {_testimonials.Length}")"
                        aria-current="@(idx == _index ? "true" : null)"
                        class="@dotClass" />
            }
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Emma Johansson", "EJ", "Frontend Lead", "Arclight",
            "We rebuilt our entire onboarding flow in a single sprint. Conversion went up 28% the month after — our PM still thinks it was the copy."),
        new("t2", "Ryan Zhao", "RZ", "CTO", "Relay Systems",
            "Our four-person frontend team shipped at the pace of a team twice the size. I stopped pretending we needed to hire two more engineers this quarter."),
        new("t3", "Amara Obi", "AO", "Product Designer", "Covalent",
            "I was the skeptic in the room. Two weeks in, I was the one blocking PRs that tried to write custom components instead of using these."),
        new("t4", "Lucas Brennan", "LB", "Engineering Manager", "Nimbus",
            "New hires are productive on day one. We deleted three weeks of frontend onboarding curriculum the Monday after we rolled it out."),
        new("t5", "Priya Raman", "PR", "Platform Lead", "Halide Inc.",
            "Cut our p99 latency from 900ms to 80ms in a weekend migration. The rollback plan was never needed and the pager went quiet."),
    ];

    private int _index = 0;

    private void SetIndex(int idx)
    {
        _index = idx;
    }
}
