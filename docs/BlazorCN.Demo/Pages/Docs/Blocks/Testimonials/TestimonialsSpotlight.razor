@* ============================================================
   Block: testimonials-spotlight
   Title: TestimonialsSpotlight
   Description: A featured hero spotlight testimonials block for React and Next.js with oversized marketing-scale quote, decorative quote mark, large avatar, star credibility line, and ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-spotlight.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="font-medium text-muted-foreground text-xs uppercase tracking-widest">
                In their words
            </p>
            <h2 class="mt-3 font-bold text-3xl tracking-tight sm:text-4xl lg:text-5xl">
                One voice, loud enough.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base text-muted-foreground leading-relaxed">
                The quote we put on every new pitch deck, from the head of engineering who lived the
                migration end to end.
            </p>
        </div>

        @* Featured hero quote *@
        <figure class="relative mt-12 overflow-hidden rounded-2xl border bg-card p-10 sm:p-14">
            <span
                aria-hidden="true"
                class="pointer-events-none absolute top-4 left-6 select-none font-serif text-[140px] leading-none text-muted-foreground/15 sm:top-6 sm:left-10 sm:text-[180px]"
            >
                &ldquo;
            </span>

            <div class="relative">
                <div class="flex items-center gap-0.5" role="img" aria-label="5 out of 5 stars">
                    @foreach (var i in _stars)
                    {
                        <LucideIconCn Name="star" Size="16" aria-hidden="true" Class="size-4 fill-amber-500 text-amber-500" />
                    }
                </div>

                <blockquote class="mt-6 font-semibold text-2xl text-foreground leading-[1.15] tracking-tight sm:text-3xl lg:text-4xl">
                    @_spotlight.Quote
                </blockquote>

                <figcaption class="mt-10 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono font-semibold text-muted-foreground text-sm">
                            @_spotlight.Initials
                        </span>
                    </div>
                    <div>
                        <p class="font-semibold text-base text-foreground">@_spotlight.Name</p>
                        <p class="text-muted-foreground text-sm">
                            @_spotlight.Role &middot; @_spotlight.Company
                        </p>
                    </div>
                </figcaption>
            </div>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[260px]">
                Read the case study
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SpotlightData(string Initials, string Name, string Role, string Company, string Quote);

    private static readonly SpotlightData _spotlight = new(
        Initials: "SC",
        Name: "Sarah Chen",
        Role: "Head of Engineering",
        Company: "Linearly",
        Quote: "We shipped five years of backlog in three months. My engineers still debate whether it was the platform or finally having a pipeline that didn't fight them — but the results don't lie."
    );

    private static readonly int[] _stars = [0, 1, 2, 3, 4];
}
