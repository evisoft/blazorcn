@* ============================================================
   Block: testimonials-dark-minimal
   Title: TestimonialsDarkMinimal
   Description: A dark inset featured testimonial quote panel for React and Next.js with inverted foreground background, oversized quote typography, large avatar, and subtle grid pattern built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-dark-minimal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                One quote that stopped the debate.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                After six months of internal debate and four failed proof-of-concepts, one engineering
                leader's verdict ended every meeting.
            </p>
        </div>

        @* Dark inset panel *@
        <figure class="relative mt-12 overflow-hidden rounded-2xl bg-foreground p-10 text-background sm:p-14">
            @* Subtle dot pattern *@
            <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 opacity-[0.06]"
                style="background-image: radial-gradient(currentColor 1px, transparent 1px); background-size: 20px 20px;"
            ></div>

            @* Oversized quote glyph *@
            <span
                aria-hidden="true"
                class="absolute -top-6 left-8 font-serif text-[160px] leading-none text-background/10 sm:left-12 sm:text-[200px]"
            >
                &ldquo;
            </span>

            <blockquote class="relative text-2xl font-semibold leading-[1.15] tracking-tight text-background sm:text-3xl lg:text-4xl">
                We cut our frontend onboarding from three weeks to two days, shipped a full dashboard
                rebuild in eleven days, and our accessibility audit passed on the first try. This was
                the best frontend investment we have made in five years.
            </blockquote>

            <figcaption class="relative mt-10 flex items-center gap-4">
                <div class="relative size-14 shrink-0 overflow-hidden rounded-full border border-background/20 bg-background/10">
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-background">
                        KW
                    </span>
                </div>
                <div>
                    <p class="text-base font-semibold text-background">Katherine Walsh</p>
                    <p class="text-sm text-background/60">
                        Chief Technology Officer &middot; Raycast
                    </p>
                </div>
            </figcaption>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>
