@* ============================================================
   Block: testimonials-stats
   Title: TestimonialsStats
   Description: A metric bar grid testimonials block for React and Next.js with an animated CountUp statistics banner, three-column card grid, star ratings, and ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="font-medium text-muted-foreground text-xs uppercase tracking-widest">
                By the numbers
            </p>
            <h2 class="mt-3 font-bold text-3xl tracking-tight sm:text-4xl lg:text-5xl">
                Proof you can count.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base text-muted-foreground leading-relaxed">
                Twelve thousand teams, ninety-eight percent retention, and a handful of quotes from the
                engineers who keep coming back.
            </p>
        </div>

        @* Metric bar *@
        <dl class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-4">
            @foreach (var stat in _stats)
            {
                <div class="rounded-xl border bg-card p-6 text-center">
                    <dt class="font-medium text-muted-foreground text-xs uppercase tracking-wider">
                        @stat.Label
                    </dt>
                    <dd class="mt-2 font-bold text-3xl tabular-nums tracking-tight sm:text-4xl">
                        @FormatStatValue(stat)
                    </dd>
                </div>
            }
        </dl>

        @* Testimonial grid *@
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var testimonial in _testimonials)
            {
                <figure class="flex flex-col rounded-xl border bg-card p-6">
                    <div class="flex items-center gap-0.5" role="img" aria-label="@($"{testimonial.Rating} out of 5 stars")">
                        @foreach (var i in Enumerable.Range(0, testimonial.Rating))
                        {
                            <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>
                    <blockquote class="mt-4 flex-1 text-base text-foreground leading-relaxed">
                        &ldquo;@testimonial.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-3 border-t pt-5">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono font-semibold text-muted-foreground text-xs">
                                @testimonial.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate font-semibold text-foreground text-sm">@testimonial.Name</p>
                            <p class="truncate text-muted-foreground text-xs">
                                @testimonial.Role · @testimonial.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Stat(string Id, double Value, string Suffix, string Label, int Decimals);

    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote, int Rating);

    private static readonly Stat[] _stats =
    [
        new("rating", 4.9, "", "Average rating", 1),
        new("teams", 12000, "+", "Teams in production", 0),
        new("csat", 99, "%", "Would recommend", 0),
        new("retention", 98, "%", "Year-over-year retention", 0),
    ];

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "James Holloway", "JH", "Engineering Manager", "Veritas",
            "We replaced three internal tools with this one library and cut our design review cycles by weeks every quarter. Nobody files UI consistency bugs anymore.",
            5),
        new("t2", "Priya Kapoor", "PK", "Frontend Architect", "Nimbus",
            "Copy a block, tweak the tokens, ship. Our time-to-production dropped 60% in the first month and I stopped dreading Monday planning.",
            5),
        new("t3", "Daniel Okafor", "DO", "Product Lead", "Clearpath",
            "Our design team stopped filing inconsistency bugs the week we adopted it. That alone justified the investment inside of 30 days.",
            5),
    ];

    private static string FormatStatValue(Stat stat)
    {
        if (stat.Decimals > 0)
            return stat.Value.ToString($"F{stat.Decimals}") + stat.Suffix;
        var formatted = ((long)stat.Value).ToString("N0");
        return formatted + stat.Suffix;
    }
}
