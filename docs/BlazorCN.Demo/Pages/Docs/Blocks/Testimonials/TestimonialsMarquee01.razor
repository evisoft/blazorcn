@* ============================================================
   Block: testimonials-marquee-01
   Title: Testimonials Marquee 01
   Description: Infinite scrolling marquee of testimonials with automatic animation and hover pause for continuous social proof
   Long Description: Full grid of all testimonials visible
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, CardCn, CardContentCn, LucideStarCn
   Source: original/blocks/testimonials/testimonials-marquee-01.tsx
   ============================================================ *@

<section class="py-16 overflow-hidden">
    <div class="container mx-auto px-4">
        <div class="mb-12 text-center">
            <h2 class="mb-4 text-3xl font-bold md:text-4xl">Trusted by Thousands</h2>
            <p class="text-muted-foreground mx-auto max-w-2xl text-lg">
                See what our customers are saying about their experience
            </p>
        </div>

        <div class="relative">
            <div class="flex animate-marquee gap-6 hover:[animation-play-state:paused]">
                @foreach (var testimonial in _testimonials.Concat(_testimonials))
                {
                    <CardCn Class="min-w-[350px] shrink-0 border-border/50">
                        <CardContentCn Class="p-6">
                            <div class="mb-3 flex items-center gap-1">
                                @for (var i = 0; i < testimonial.Rating; i++)
                                {
                                    <LucideStarCn class="h-4 w-4 fill-yellow-400 text-yellow-400" />
                                }
                            </div>
                            <blockquote class="text-foreground/90 mb-4 text-sm leading-relaxed">
                                &quot;@testimonial.Quote&quot;
                            </blockquote>
                            <div class="flex items-center gap-3">
                                <AvatarCn Class="h-10 w-10">
                                    <AvatarImageCn Alt="@testimonial.Name" Src="@testimonial.Image" />
                                    <AvatarFallbackCn>@GetInitials(testimonial.Name)</AvatarFallbackCn>
                                </AvatarCn>
                                <div>
                                    <p class="text-sm font-semibold">@testimonial.Name</p>
                                    <p class="text-muted-foreground text-xs">@testimonial.Role</p>
                                </div>
                            </div>
                        </CardContentCn>
                    </CardCn>
                }
            </div>

            <div class="pointer-events-none absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-background to-transparent"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-background to-transparent"></div>
        </div>

        <style>
            @@keyframes marquee {
                0% { transform: translateX(0); }
                100% { transform: translateX(-50%); }
            }
            .animate-marquee {
                animation: marquee 30s linear infinite;
            }
            .animate-marquee:hover {
                animation-play-state: paused;
            }
            @@media (prefers-reduced-motion: reduce) {
                .animate-marquee { animation: none; }
            }
        </style>
    </div>
</section>

@code {
    private record TestimonialItem(string Name, string Role, string Image, int Rating, string Quote);

    private static string GetInitials(string name) =>
        string.Join("", name.Split(' ').Select(n => n[0]));

    private readonly TestimonialItem[] _testimonials =
    [
        new("Sarah Chen", "Product Manager", "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=400&h=400", 5, "Game-changer for our workflow. Saved us countless hours."),
        new("Michael Torres", "Developer", "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=400&h=400", 5, "Best investment we made this year. Highly recommend!"),
        new("Emily Watson", "Designer", "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&q=80&w=400&h=400", 5, "Intuitive interface, powerful features. Perfect combination."),
        new("David Kim", "CTO", "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&q=80&w=400&h=400", 5, "Scaled with us from startup to enterprise. Incredible support."),
        new("Jessica Lee", "Marketing Director", "https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?auto=format&fit=crop&q=80&w=400&h=400", 5, "ROI was clear within the first month. Exceeded expectations."),
        new("Ryan Foster", "Founder", "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&q=80&w=400&h=400", 5, "Customer support is unmatched. They truly care about success."),
        new("Amanda Martinez", "Operations Lead", "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=400&h=400", 5, "Streamlined our entire process. Can't imagine working without it."),
