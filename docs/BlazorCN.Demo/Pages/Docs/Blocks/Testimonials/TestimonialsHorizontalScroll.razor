@* ============================================================
   Block: testimonials-horizontal-scroll
   Title: TestimonialsHorizontalScroll
   Description: A draggable layered testimonials swipe stack for React and Next.js with real drag gestures, autoplay, keyboard navigation, pagination dots, and a deep card stack built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-horizontal-scroll.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Swipe through the proof.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Drag the top card, use the arrow keys, or just watch it autoplay. Every voice is a team
                who bet on us.
            </p>
        </div>

        @* Stack *@
        <div class="relative mt-12 h-[380px]">
            @foreach (var offset in new[] { 2, 1, 0 })
            {
                var cardIndex = (_index + offset) % _testimonials.Length;
                var card = _testimonials[cardIndex];
                var isActive = offset == 0;
                var zIndex = 3 - offset;
                var translateY = offset * 24;
                var scale = 1.0 - offset * 0.06;
                var opacity = 1.0 - offset * 0.3;
                var styleStr = $"z-index:{zIndex}; transform: translateY({translateY}px) scale({scale.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}); opacity:{opacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)};";

                <figure class="absolute inset-0 overflow-hidden rounded-2xl border bg-card p-8 shadow-lg sm:p-10 transition-all duration-400"
                        style="@styleStr">
                    <div role="img"
                         aria-label="5 out of 5 stars"
                         class="flex items-center gap-0.5">
                        @for (var i = 0; i < 5; i++)
                        {
                            <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>

                    <blockquote class="mt-5 text-lg font-medium leading-relaxed text-foreground sm:text-xl">
                        &ldquo;@card.Quote&rdquo;
                    </blockquote>

                    <figcaption class="mt-8 flex items-center gap-4">
                        <div class="relative flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-full border bg-muted">
                            <span class="font-mono text-sm font-semibold text-muted-foreground">
                                @card.Initials
                            </span>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-foreground">@card.Name</p>
                            <p class="text-xs text-muted-foreground">
                                @card.Role &middot; @card.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* Pagination dots *@
        <div class="mt-6 flex items-center justify-center gap-0.5">
            @for (var i = 0; i < _testimonials.Length; i++)
            {
                var dotIndex = i;
                var isActive = dotIndex == _index;
                <button type="button"
                        aria-label="@($"Go to testimonial {dotIndex + 1} of {_testimonials.Length}")"
                        aria-current="@(isActive ? "true" : null)"
                        class="inline-flex size-6 items-center justify-center"
                        @onclick="@(() => GoTo(dotIndex))">
                    <span class="@Cn.Merge("h-1.5 rounded-full transition-all", isActive ? "w-6 bg-foreground" : "w-1.5 bg-muted-foreground/30 hover:bg-muted-foreground/60")"></span>
                </button>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(
        string Id,
        string Name,
        string Initials,
        string Role,
        string Company,
        string Quote
    );

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Sarah Mitchell", "SM", "Product Designer", "Linearly",
            "Dropped these components into our app and they looked native from day one. We shipped the redesign in a week."),
        new("t2", "Kevin Park", "KP", "Staff Engineer", "Northwind",
            "We built our entire design system on top of this in two weeks. The composable API makes extending components trivial."),
        new("t3", "Lucia Fernandez", "LF", "Engineering Manager", "Halide Inc.",
            "Sprint velocity jumped 40% after we stopped building UI from scratch. The team now focuses on business logic."),
        new("t4", "David Chen", "DC", "Frontend Lead", "Voltaware",
            "Best TypeScript support I've used. Autocomplete catches errors at compile time so we ship fewer regressions."),
        new("t5", "Emma Thompson", "ET", "Head of Design", "Mori Labs",
            "We went from evaluation to production in under a week. The theming system matched our brand guidelines perfectly."),
        new("t6", "Raj Patel", "RP", "CTO", "Kettle",
            "We evaluated five libraries. This one won on accessibility, bundle size, and developer experience. Clear winner."),
    ];

    private int _index = 0;

    private void GoTo(int i)
    {
        _index = i;
    }
}
