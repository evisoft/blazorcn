@* ============================================================
   Block: testimonials-interview
   Title: TestimonialsInterview
   Description: A long-form interview Q&A testimonial thread for React and Next.js with alternating questions and answers, a single interviewee attribution hero, and marketing-scale typography built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-interview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer interview
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Five teams, one button.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A thirty minute conversation with a VP of Engineering on migrating 180,000 lines of
                frontend code without a rollback.
            </p>
        </div>

        @* Interviewee hero card *@
        <figure class="mt-12 flex items-center gap-4 rounded-2xl border bg-card p-6 sm:p-8">
            <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                    @_interviewee.Initials
                </span>
            </div>
            <figcaption>
                <p class="text-base font-semibold text-foreground">@_interviewee.Name</p>
                <p class="text-sm text-muted-foreground">
                    @_interviewee.Role · @_interviewee.Company
                </p>
            </figcaption>
        </figure>

        @* Q&A thread *@
        <div class="mt-6 space-y-4">
            @foreach (var pair in _qaPairs)
            {
                <figure class="rounded-2xl border bg-card p-6 sm:p-8">
                    <p class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">
                        Q · @pair.Question
                    </p>
                    <blockquote class="mt-3 text-lg leading-relaxed text-foreground sm:text-xl">
                        &ldquo;@pair.Answer&rdquo;
                    </blockquote>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[260px]">Read the full case study</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[250px]">
                Talk to a customer
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Interviewee(string Name, string Role, string Company, string Initials);
    private record QAPair(string Id, string Question, string Answer);

    private static readonly Interviewee _interviewee = new(
        Name: "Samantha Liu",
        Role: "VP Engineering",
        Company: "Arclight",
        Initials: "SL"
    );

    private static readonly QAPair[] _qaPairs =
    [
        new("q1",
            Question: "What problem were you trying to solve before adopting this?",
            Answer: "Five product teams each building their own button, modal, and form. Every design review was a debate. Nothing looked or behaved the same across our platform, and our customers noticed."),
        new("q2",
            Question: "How did the migration process go?",
            Answer: "We ran both systems in parallel for two weeks, then switched team by team. Total migration was three weeks across 180,000 lines of frontend code. The rollback plan was never needed."),
        new("q3",
            Question: "What measurable improvements have you seen?",
            Answer: "Frontend PRs take 40% less time to review. Design inconsistency bugs dropped to essentially zero. Our on-call page for UI regressions has been silent for two months."),
        new("q4",
            Question: "Would you recommend this to other engineering leaders?",
            Answer: "Without hesitation. My only regret is not adopting it a year earlier. Every week we spent on our homegrown components is a week we now wish we had spent on product."),
    ];
}
