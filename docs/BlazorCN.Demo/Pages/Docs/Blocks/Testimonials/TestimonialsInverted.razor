@* ============================================================
   Block: testimonials-inverted
   Title: TestimonialsInverted
   Description: A dark inset featured quote testimonial for React and Next.js with an inverted bg-foreground panel, oversized serif quote mark, marketing-scale typography, and a hero attribution atom built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-inverted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer spotlight
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                One quote. Zero debate.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Sometimes the whole story fits in a single sentence from a single engineer. This is that
                sentence.
            </p>
        </div>

        @* Dark inset panel *@
        <figure class="relative mt-12 overflow-hidden rounded-2xl bg-foreground p-10 text-background sm:p-14">
            @* Decorative serif quote glyph *@
            <span
                aria-hidden="true"
                class="pointer-events-none absolute -left-2 -top-8 select-none font-serif text-[160px] leading-none text-background/10 sm:-left-4 sm:-top-12 sm:text-[220px]"
            >
                &ldquo;
            </span>

            <div class="relative">
                <div class="flex items-center gap-0.5" role="img" aria-label="5 out of 5 stars">
                    @foreach (var i in _stars)
                    {
                        <LucideIconCn Name="star" Size="16" aria-hidden="true" Class="size-4 fill-amber-400 text-amber-400" />
                    }
                </div>

                <blockquote class="mt-8 text-2xl font-semibold leading-[1.15] tracking-tight text-background sm:text-3xl lg:text-4xl">
                    @_featured.Quote
                </blockquote>

                <figcaption class="mt-10 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border border-background/20 bg-background/10">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-background">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-background">@_featured.Name</p>
                        <p class="text-sm text-background/70">
                            @_featured.Role &middot; @_featured.Company
                        </p>
                    </div>
                </figcaption>
            </div>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[260px]">
                Read the case study
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TestimonialData(string Id, string Name, string Role, string Company, string Initials, string Quote);

    private static readonly TestimonialData _featured = new(
        Id: "f1",
        Name: "Liam Harrington",
        Role: "CTO",
        Company: "Fulcrum",
        Initials: "LH",
        Quote: "The first component library in five years that my entire engineering team agreed on without a single debate. We shipped the migration in four days and haven't touched a custom button since."
    );

    private static readonly int[] _stars = [0, 1, 2, 3, 4];
}
