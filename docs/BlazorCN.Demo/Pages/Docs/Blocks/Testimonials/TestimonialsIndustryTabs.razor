@* ============================================================
   Block: testimonials-industry-tabs
   Title: TestimonialsIndustryTabs
   Description: A tab-switched testimonials card grid for React and Next.js with keyboard-accessible category tabs, two-column quote cards per tab, icon accents, and marketing-scale typography built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-industry-tabs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        <!-- Headline cluster -->
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted across industries
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                See yourself in the quote.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Four industries, eight teams, one platform. Pick the tab that looks most like your world
                and read what they shipped.
            </p>
        </div>

        <div class="mt-12">
            <!-- Tab list -->
            <div class="mx-auto flex h-auto w-fit flex-wrap justify-center gap-1 rounded-full border bg-card p-1" role="tablist">
                @foreach (var cat in _categories)
                {
                    var category = cat;
                    <button role="tab"
                            aria-selected="@(_activeTab == category.Id ? "true" : "false")"
                            @onclick="@(() => _activeTab = category.Id)"
                            class="@Cn.Merge("gap-2 rounded-full px-4 py-2 text-sm font-medium inline-flex items-center", _activeTab == category.Id ? "bg-foreground text-background" : "")">
                        <LucideIconCn Name="@category.IconName" Size="16" Class="size-4" aria-hidden="true" />
                        @category.Label
                    </button>
                }
            </div>

            <!-- Tab panels -->
            @foreach (var cat in _categories)
            {
                var category = cat;
                @if (_activeTab == category.Id)
                {
                    <div role="tabpanel" class="mt-8 grid gap-6 sm:grid-cols-2">
                        @foreach (var t in category.Testimonials)
                        {
                            <figure class="flex flex-col justify-between rounded-xl border bg-card p-6 sm:p-8">
                                <blockquote class="text-base leading-relaxed text-foreground sm:text-lg">
                                    &ldquo;@t.Quote&rdquo;
                                </blockquote>
                                <figcaption class="mt-6 flex items-center gap-3">
                                    <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                                        <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                            @t.Initials
                                        </span>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                                        <p class="truncate text-xs text-muted-foreground">
                                            @t.Role · @t.Company
                                        </p>
                                    </div>
                                </figcaption>
                            </figure>
                        }
                    </div>
                }
            }
        </div>

        <!-- CTAs -->
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private record Category(string Id, string Label, string IconName, Testimonial[] Testimonials);

    private string _activeTab = "saas";

    private static readonly Category[] _categories =
    [
        new("saas", "SaaS", "briefcase",
        [
