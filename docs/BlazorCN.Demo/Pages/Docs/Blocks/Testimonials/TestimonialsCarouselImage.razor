@* ============================================================
   Block: testimonials-carousel-image
   Title: TestimonialsCarouselImage
   Description: A split panel portrait carousel testimonials block for React and Next.js with a full-bleed gradient portrait, real drag gestures, keyboard navigation, autoplay, and pagination dots built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-carousel-image.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-muted-foreground text-xs font-medium uppercase tracking-widest">
                Customer portraits
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The people shipping with us.
            </h2>
            <p class="text-muted-foreground mx-auto mt-4 max-w-xl text-base leading-relaxed">
                Four founders and engineers, each with a specific number they can point to — and a face
                to go with the story.
            </p>
        </div>

        @* Split panel *@
        <div class="bg-card mt-10 grid overflow-hidden rounded-2xl border lg:grid-cols-2">
            @* Portrait panel *@
            <div class="@Cn.Merge("relative aspect-[4/5] bg-gradient-to-br lg:aspect-auto", _current.Gradient)">
                <div class="bg-muted absolute inset-0 -z-10"></div>
                <div class="absolute inset-0 flex items-center justify-center">
                    <span class="text-muted-foreground/60 font-mono text-6xl font-semibold sm:text-7xl">
                        @_current.Initials
                    </span>
                </div>
                <div class="bg-card/90 absolute bottom-4 left-4 rounded-md border px-3 py-2 backdrop-blur">
                    <p class="text-foreground text-sm font-semibold">@_current.Name</p>
                    <p class="text-muted-foreground text-xs">
                        @_current.Role · @_current.Company
                    </p>
                </div>
            </div>

            @* Quote panel *@
            <figure class="flex cursor-grab flex-col justify-center p-10 active:cursor-grabbing lg:p-14">
                <blockquote class="text-foreground text-xl font-semibold leading-[1.25] sm:text-2xl">
                    &ldquo;@_current.Quote&rdquo;
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-4">
                    <div class="bg-muted relative size-12 shrink-0 overflow-hidden rounded-full border">
                        <span class="text-muted-foreground absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold">
                            @_current.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-foreground text-sm font-semibold">@_current.Name</p>
                        <p class="text-muted-foreground text-xs">
                            @_current.Role · @_current.Company
                        </p>
                    </div>
                </figcaption>

                @* Pagination dots *@
                <div class="mt-8 flex items-center gap-0.5">
                    @for (var i = 0; i < _testimonials.Length; i++)
                    {
                        var idx = i;
                        <button type="button"
                                aria-label="@($"Go to testimonial from {_testimonials[idx].Name}")"
                                aria-current="@(idx == _index ? "true" : null)"
                                class="inline-flex size-6 items-center justify-center"
                                @onclick="@(() => _index = idx)">
                            <span class="@Cn.Merge("h-1.5 rounded-full transition-all", (idx == _index ? "bg-foreground w-6" : "bg-muted-foreground/30 hover:bg-muted-foreground/60 w-1.5"))"></span>
                        </button>
                    }
                </div>
            </figure>
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">Read all stories</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TestimonialItem(string Id, string Name, string Initials, string Role, string Company, string Quote, string Gradient);

    private int _index;

    private TestimonialItem _current => _testimonials[_index];

    private void Advance() => _index = (_index + 1) % _testimonials.Length;
    private void Retreat() => _index = (_index - 1 + _testimonials.Length) % _testimonials.Length;

    private static readonly TestimonialItem[] _testimonials =
    [
        new("t1", "Jessica Martinez", "JM", "Creative Director", "Finch Studio",
            "We rebuilt our entire product surface in three weeks. Our design-to-dev handoff, which used to take a full sprint per screen, now takes an afternoon.",
            "from-blue-500/30 via-blue-500/10 to-transparent"),
        new("t2", "Ryan Foster", "RF", "Startup Founder", "LaunchPad",
            "Prototype to production in a weekend. We raised our seed round with screens built on this library the week after we adopted it. That is not a coincidence.",
            "from-emerald-500/30 via-emerald-500/10 to-transparent"),
        new("t3", "Amanda Lee", "AL", "Marketing Lead", "Orbit",
            "Our landing-page conversion rate improved 28 percent after the rebuild. Nothing else changed. The attention to spacing and typography is immediately felt by visitors.",
            "from-violet-500/30 via-violet-500/10 to-transparent"),
        new("t4", "Liam Chen", "LC", "Senior Engineer", "Relay",
            "Best library I have worked with in a decade of frontend. TypeScript support is first-class and our bundle actually shrank 12 percent after the migration.",
            "from-amber-500/30 via-amber-500/10 to-transparent"),
    ];
}
