@* ============================================================
   Block: testimonials-cards
   Title: TestimonialsCards
   Description: A symmetric three-column testimonials card grid for React and Next.js with star ratings, verified badges, marketing headline cluster, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-muted-foreground text-xs font-medium uppercase tracking-widest">
                Customer testimonials
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Loved by shipping teams.
            </h2>
            <p class="text-muted-foreground mx-auto mt-4 max-w-xl text-base leading-relaxed">
                Three engineers, three companies, one pattern: teams who adopt our components ship
                faster and file fewer bugs.
            </p>
        </div>

        <div class="mt-10 grid gap-6 md:grid-cols-3">
            @foreach (var t in _testimonials)
            {
                <figure class="bg-card flex flex-col rounded-xl border p-6">
                    <div class="flex items-center justify-between">
                        <div role="img" aria-label="@($"{t.Rating} out of 5 stars")" class="flex items-center gap-0.5">
                            @for (var i = 0; i < 5; i++)
                            {
                                <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                            }
                        </div>
                        @if (t.Verified)
                        {
                            <span class="inline-flex items-center gap-1 rounded-full border bg-emerald-500/10 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:text-emerald-400">
                                <LucideIconCn Name="badge-check" Size="12" Class="size-3" aria-hidden="true" />
                                Verified
                            </span>
                        }
                    </div>
                    <blockquote class="text-foreground mt-4 flex-1 text-base leading-relaxed">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-3">
                        <div class="bg-muted relative size-10 shrink-0 overflow-hidden rounded-full border">
                            <span class="text-muted-foreground absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-foreground truncate text-sm font-semibold">@t.Name</p>
                            <p class="text-muted-foreground truncate text-xs">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote, int Rating, bool Verified = false);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Rachel Kim", "RK", "Engineering Lead", "Veritas",
            "Cut our component build time in half. We shipped three new products in the quarter we migrated — the previous quarter we shipped zero.",
            5, true),
        new("t2", "Tom Brennan", "TB", "Full-Stack Developer", "Arcadia",
            "Our accessibility audit scores jumped 20 points in one afternoon. I didn't rewrite a single aria attribute — it just worked.",
            5),
        new("t3", "Mei Zhang", "MZ", "Head of Design", "Lattice",
            "Finally a library that matches our Figma specs out of the box. Our designers stopped filing UI-drift tickets the week we adopted it.",
            5),
    ];
}
