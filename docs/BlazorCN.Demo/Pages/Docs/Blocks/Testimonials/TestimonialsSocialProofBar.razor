@* ============================================================
   Block: testimonials-social-proof-bar
   Title: TestimonialsSocialProofBar
   Description: A compact social proof credibility bar for React and Next.js with avatar stack, aggregate star rating, review count, and metric tiles built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-social-proof-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="font-medium text-muted-foreground text-xs uppercase tracking-widest">
                Trusted by teams who ship
            </p>
            <h2 class="mt-3 font-bold text-3xl tracking-tight sm:text-4xl lg:text-5xl">
                Loved by 12,000+ teams.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base text-muted-foreground leading-relaxed">
                From two-person startups to public companies, the numbers keep moving in one direction —
                and so do the reviews.
            </p>
        </div>

        @* Credibility row: avatar stack + rating *@
        <div class="mt-10 flex flex-wrap items-center justify-center gap-5 rounded-2xl border bg-card p-6">
            <div aria-hidden="true" class="flex items-center -space-x-2">
                @foreach (var avatar in _avatars)
                {
                    <div class="relative size-10 shrink-0 overflow-hidden rounded-full border-2 border-card bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono font-semibold text-muted-foreground text-[10px]">
                            @avatar.Initials
                        </span>
                    </div>
                }
            </div>

            <div
                role="img"
                aria-label="@($"Rated {_rating} out of 5 stars")"
                class="flex items-center gap-0.5">
                @for (var i = 0; i < 5; i++)
                {
                    <LucideIconCn Name="star" Size="16" aria-hidden="true" Class="size-4 fill-amber-500 text-amber-500" />
                }
            </div>

            <div class="text-sm">
                <span class="font-semibold text-foreground">@_rating/5</span>
                <span class="text-muted-foreground"> from @_reviewCount reviews</span>
            </div>
        </div>

        @* Metric tiles *@
        <dl class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
            @foreach (var m in _metrics)
            {
                <div class="rounded-xl border bg-card p-5 text-center">
                    <dt class="font-medium text-[11px] text-muted-foreground uppercase tracking-wider">
                        @m.Label
                    </dt>
                    <dd class="mt-1 font-bold text-2xl tabular-nums tracking-tight text-foreground">
                        @m.Value
                    </dd>
                    <dd class="mt-0.5 text-muted-foreground text-xs">@m.Sub</dd>
                </div>
            }
        </dl>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all reviews
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record AvatarItem(string Id, string Initials);
    private record MetricItem(string Id, string Label, string Value, string Sub);

    private const double _rating = 4.9;
    private const string _reviewCount = "2,184";

    private static readonly AvatarItem[] _avatars =
    [
        new("a1", "SC"),
        new("a2", "MO"),
        new("a3", "PR"),
        new("a4", "DK"),
        new("a5", "ET"),
    ];

    private static readonly MetricItem[] _metrics =
    [
        new("teams",     "Teams",     "12,000+", "In production"),
        new("rating",    "Rating",    "4.9/5",   "2,184 reviews"),
        new("retention", "Retention", "98%",     "Year over year"),
        new("support",   "Response",  "< 1min",  "First reply"),
    ];
}
