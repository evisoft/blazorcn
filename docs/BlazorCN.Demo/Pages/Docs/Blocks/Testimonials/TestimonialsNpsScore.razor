@* ============================================================
   Block: testimonials-nps-score
   Title: TestimonialsNpsScore
   Description: A dark inset featured testimonial block for React and Next.js with an inverted panel, oversized hero quote, a supporting score credibility metric, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-nps-score.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Loyalty score
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                A score you can feel.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Built from 1,240 promoter responses across three continents — but the score only matters
                because of what they actually said.
            </p>
        </div>

        @* Dark inset panel *@
        <figure class="relative mt-12 overflow-hidden rounded-2xl bg-foreground p-10 text-background sm:p-14">
            <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 opacity-[0.06]"
                style="background-image:radial-gradient(circle at 1px 1px, currentColor 1px, transparent 0);background-size:24px 24px;"
            ></div>

            <div class="relative">
                @* Score rail *@
                <div class="flex items-center gap-4">
                    <div
                        role="img"
                        aria-label="@($"Loyalty score {_score} out of 100")"
                        class="flex items-baseline gap-2"
                    >
                        <span class="font-bold tabular-nums text-5xl leading-none">@_score</span>
                        <span class="text-xs font-medium uppercase tracking-widest text-background/60">
                            /100
                        </span>
                    </div>
                    <span class="inline-flex items-center rounded-full border border-background/20 bg-background/10 px-3 py-1 text-xs font-medium text-background">
                        @_scoreLabel
                    </span>
                </div>

                <blockquote class="mt-8 text-2xl font-semibold leading-[1.15] tracking-tight text-background sm:text-3xl lg:text-4xl">
                    &ldquo;We already recommended this to three engineering teams this month. It&rsquo;s
                    the first tool in five years that my team chose to use on their own time —
                    that&rsquo;s the highest compliment I know how to give.&rdquo;
                </blockquote>

                <figcaption class="mt-10 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border border-background/20 bg-background/10">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-background">
                            RK
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-background">Rachel Kim</p>
                        <p class="text-sm text-background/60">VP of Engineering · Dataflow</p>
                    </div>
                    <div class="ml-auto flex items-center gap-1 border-l border-background/15 pl-4">
                        <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                            @foreach (var i in _stars)
                            {
                                <LucideIconCn Name="star" Size="14" aria-hidden="true" Class="size-3.5 fill-amber-500 text-amber-500" />
                            }
                        </div>
                    </div>
                </figcaption>
            </div>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[260px]">
                Read the case study
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const int _score = 72;
    private const string _scoreLabel = "World-class";

    private static readonly int[] _stars = [0, 1, 2, 3, 4];
}
