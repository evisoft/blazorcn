@* ============================================================
   Block: testimonials-simple
   Title: TestimonialsSimple
   Description: A minimal stacked testimonials column for React and Next.js with marketing-scale headline, three featured quotes, semantic figure markup, and staggered reveals built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-simple.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                What our customers say.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Three quotes from the product and engineering leaders shipping with us in production
                every day.
            </p>
        </div>

        <div class="mt-12 space-y-6">
            @foreach (var t in _testimonials)
            {
                <figure class="overflow-hidden rounded-2xl border bg-card p-6 sm:p-8">
                    <blockquote class="text-lg font-medium leading-relaxed text-foreground sm:text-xl">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-4">
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Quote, string Name, string Initials, string Role, string Company);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "The component quality is outstanding. Our design system migration took days instead of months — and the result looks better than what we had before.", "Sarah Mitchell", "SM", "Product Designer", "Figmatic"),
        new("t2", "We evaluated a dozen alternatives and this was the clear winner. Our team was productive on day one and the code review backlog disappeared by Friday.", "Marcus Chen", "MC", "Engineering Lead", "Stripeline"),
        new("t3", "Shipping speed increased dramatically. The pre-built patterns handle 90% of our use cases — and our customers notice the polish the week we release.", "Emily Rodriguez", "ER", "VP of Product", "Linearly"),
    ];
}
