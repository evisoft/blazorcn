@* ============================================================
   Block: testimonials-duo
   Title: TestimonialsDuo
   Description: A two-column testimonial card grid for React and Next.js with category tag chips, star ratings, and paired attribution atoms built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-duo.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-muted-foreground text-xs font-medium uppercase tracking-widest">
                Two teams, one verdict
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Built for the teams you admire.
            </h2>
            <p class="text-muted-foreground mx-auto mt-4 max-w-xl text-base leading-relaxed">
                From compliance-heavy fintech to frame-perfect creative tools, the same primitives power
                every shipping team.
            </p>
        </div>

        @* Two-column grid *@
        <div class="mt-12 grid gap-6 sm:grid-cols-2">
            @foreach (var t in _testimonials)
            {
                <figure class="bg-card flex h-full flex-col rounded-2xl border p-8">
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground inline-flex items-center rounded-full border bg-muted/50 px-2.5 py-1 text-xs font-medium">
                            @t.Tag
                        </span>
                        <div role="img" aria-label="@($"{t.Rating} out of 5 stars")" class="flex items-center gap-0.5">
                            @for (var i = 0; i < 5; i++)
                            {
                                <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                            }
                        </div>
                    </div>

                    <blockquote class="text-foreground mt-6 flex-1 text-base leading-relaxed">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>

                    <figcaption class="mt-8 flex items-center gap-4 border-t pt-6">
                        <div class="bg-muted relative size-12 shrink-0 overflow-hidden rounded-full border">
                            <span class="text-muted-foreground absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-foreground truncate text-sm font-semibold">@t.Name</p>
                            <p class="text-muted-foreground truncate text-xs">
                                @t.Role &middot; @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Tag, string Quote, int Rating);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "James Okonkwo", "JO", "Head of Engineering", "Northwind Pay", "Fintech",
            "We rebuilt our compliance-heavy dashboard in 11 days. Our infosec audit passed on the first run with zero critical findings — that has never happened with a third-party library.",
            5),
        new("t2", "Mia Zhang", "MZ", "Staff Frontend Engineer", "Halide Studio", "Design Tools",
            "Our canvas tools need primitives most libraries can't handle. This one let us ship drag-and-drop timelines and nested color pickers without fighting the framework. Design velocity tripled.",
            5),
    ];
}
