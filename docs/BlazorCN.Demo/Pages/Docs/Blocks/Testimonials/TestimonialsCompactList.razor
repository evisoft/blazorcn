@* ============================================================
   Block: testimonials-compact-list
   Title: TestimonialsCompactList
   Description: A high-density testimonials wall block for React and Next.js with masonry columns, varying card heights, compact attribution, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-compact-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Ten thousand teams can't be wrong.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Real quotes from the engineers and designers who ship on top of our platform every
                single day.
            </p>
        </div>

        @* Masonry wall *@
        <div class="mt-12 columns-1 gap-4 sm:columns-2 lg:columns-3 xl:columns-4">
            @foreach (var t in _testimonials)
            {
                <figure class="@Cn.Merge("mb-4 break-inside-avoid rounded-xl border bg-card p-5", t.Featured ? "border-foreground/20 bg-muted/40" : "")">
                    <blockquote class="text-sm leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-4 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Join these teams</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Quote, string Name, string Initials, string Role, string Company, bool Featured = false);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "We shipped our redesign in half the projected timeline and the design team still has capacity for the next quarter's roadmap.", "Sarah Chen", "SC", "Eng Lead", "Linearly", true),
