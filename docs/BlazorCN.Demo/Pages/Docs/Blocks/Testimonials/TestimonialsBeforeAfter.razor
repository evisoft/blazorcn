@* ============================================================
   Block: testimonials-before-after
   Title: TestimonialsBeforeAfter
   Description: A two-column before-and-after split panel testimonial for React and Next.js with pain-point and result columns, animated improvement metrics, a bridging customer quote, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-before-after.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer transformation
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Before us. After us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Real results from teams who switched. No cherry-picked quotes, just what changed.
            </p>
        </div>

        @* Split panel *@
        <div class="mt-10 grid grid-cols-1 gap-6 md:grid-cols-2">
            <div class="rounded-2xl border bg-card p-6 sm:p-8">
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    Before
                </p>
                <ul class="mt-5 space-y-4">
                    @foreach (var item in _beforeItems)
                    {
                        <li class="flex items-start gap-3">
                            <span aria-hidden="true" class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-red-500/10">
                                <LucideIconCn Name="x" Size="14" Class="size-3.5 text-red-600 dark:text-red-400" />
                            </span>
                            <span class="text-sm leading-relaxed text-muted-foreground">@item</span>
                        </li>
                    }
                </ul>
            </div>

            <div class="rounded-2xl border bg-card p-6 sm:p-8">
                <p class="text-xs font-medium uppercase tracking-widest text-emerald-700 dark:text-emerald-400">
                    After
                </p>
                <ul class="mt-5 space-y-4">
                    @foreach (var item in _afterItems)
                    {
                        <li class="flex items-start gap-3">
                            <span aria-hidden="true" class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                            </span>
                            <span class="text-sm leading-relaxed text-foreground">@item</span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* Metrics row *@
        <dl class="mt-6 grid grid-cols-3 gap-4 rounded-2xl border bg-card p-6 sm:p-8">
            @foreach (var metric in _metrics)
            {
                <div class="text-center">
                    <dd class="text-3xl font-bold tabular-nums tracking-tight text-foreground sm:text-4xl">
                        @metric.Value@metric.Suffix
                    </dd>
                    <dt class="mt-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @metric.Label
                    </dt>
                </div>
            }
        </dl>

        @* Bridging quote *@
        <figure class="mt-10 text-center">
            <blockquote class="mx-auto max-w-2xl text-xl font-semibold leading-[1.25] text-foreground sm:text-2xl">
                "@(_quote.Text)"
            </blockquote>
            <figcaption class="mt-6 flex items-center justify-center gap-4">
                <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                        @_quote.Initials
                    </span>
                </div>
                <div class="text-left">
                    <p class="text-sm font-semibold text-foreground">@_quote.Name</p>
                    <p class="text-xs text-muted-foreground">
                        @_quote.Role · @_quote.Company
                    </p>
                </div>
            </figcaption>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[260px]">Read the case study</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">
                Book a demo
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _beforeItems =
    [
        "Six-week sprints just to update our button component",
        "Accessibility audits flagged 140+ issues every quarter",
        "Designers and engineers argued about spacing in every review",
        "Three engineers full-time maintaining a custom design system",
    ];

    private static readonly string[] _afterItems =
    [
        "Ship UI updates in hours with drop-in production components",
        "Zero accessibility issues in the last two audits",
        "Design tokens ended the spacing debate permanently",
        "Those three engineers now build product features instead",
    ];

    private record MetricItem(string Id, int Value, string Suffix, string Label);

    private static readonly MetricItem[] _metrics =
    [
        new("m1", 3, "x", "Faster shipping"),
        new("m2", 60, "%", "Less custom CSS"),
        new("m3", 98, "", "Lighthouse score"),
    ];

    private record QuoteItem(string Text, string Name, string Initials, string Role, string Company);

    private static readonly QuoteItem _quote = new(
        "We went from dreading frontend work to shipping features faster than our backend team. I honestly can't remember the last time a designer filed a visual regression bug.",
        "Marcus Chen",
        "MC",
        "CTO",
        "Stackline"
    );
}
