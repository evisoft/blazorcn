@* ============================================================
   Block: testimonials-wall
   Title: TestimonialsWall
   Description: A high-density masonry testimonials wall for React and Next.js with CSS columns, break-inside-avoid cards, sparse star accents, and 12 compact reviews built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-wall.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Loved by 12,000+ teams
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                A wall of people shipping faster.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From solo developers to enterprise platforms, here is what teams have been saying after
                a year in production with our components.
            </p>
        </div>

        @* Masonry wall *@
        <div class="mt-12 columns-1 gap-4 sm:columns-2 lg:columns-3 xl:columns-4">
            @foreach (var rev in _reviews)
            {
                <figure class="mb-4 break-inside-avoid rounded-xl border bg-card p-4">
                    @if (rev.Highlighted)
                    {
                        <div role="img" aria-label="5 out of 5 stars" class="mb-2 flex items-center gap-0.5">
                            @for (var s = 0; s < 5; s++)
                            {
                                <LucideIconCn Name="star" Size="14" aria-hidden="true" Class="size-3.5 fill-amber-500 text-amber-500" />
                            }
                        </div>
                    }
                    <blockquote class="text-sm leading-relaxed text-foreground">
                        @("\"")@rev.Quote@("\"")
                    </blockquote>
                    <figcaption class="mt-4 flex items-center gap-3">
                        <div class="relative size-8 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-[10px] font-semibold text-muted-foreground">
                                @rev.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@rev.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @rev.Role · @rev.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">Read all stories</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Review(string Id, string Name, string Initials, string Role, string Company, string Quote, bool Highlighted = false);

