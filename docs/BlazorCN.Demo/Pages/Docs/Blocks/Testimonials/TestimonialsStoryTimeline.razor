@* ============================================================
   Block: testimonials-story-timeline
   Title: TestimonialsStoryTimeline
   Description: A vertical timeline testimonials block for React and Next.js with dated milestone cards, a connecting rail, avatar attribution, and staggered entrance animations built with motion/react, shadcn/ui, and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-story-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer journey
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                One year, compounding wins.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Five snapshots from teams that adopted the platform and then kept shipping. Every quote
                comes from a real milestone, not a launch-week survey.
            </p>
        </div>

        @* Timeline *@
        <div class="relative mt-12 pl-10">
            <div aria-hidden="true" class="absolute top-2 bottom-2 left-[15px] w-px bg-border"></div>

            <ol class="space-y-6">
                @foreach (var entry in _timeline)
                {
                    <li class="relative">
                        <span aria-hidden="true" class="absolute -left-10 top-5 flex size-[15px] items-center justify-center">
                            <span class="size-2.5 rounded-full bg-foreground ring-4 ring-background"></span>
                        </span>

                        <figure class="overflow-hidden rounded-xl border bg-card p-6 shadow-sm">
                            <time class="font-mono text-xs uppercase tracking-widest text-muted-foreground">
                                @entry.Date
                            </time>
                            <blockquote class="mt-3 text-base leading-relaxed text-foreground">
                                &ldquo;@entry.Quote&rdquo;
                            </blockquote>
                            <figcaption class="mt-5 flex items-center gap-3">
                                <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                                    <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                        @entry.Initials
                                    </span>
                                </div>
                                <div class="min-w-0">
                                    <p class="truncate text-sm font-semibold text-foreground">@entry.Name</p>
                                    <p class="truncate text-xs text-muted-foreground">
                                        @entry.Role &middot; @entry.Company
                                    </p>
                                </div>
                            </figcaption>
                        </figure>
                    </li>
                }
            </ol>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TimelineEntry(string Id, string Date, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly TimelineEntry[] _timeline =
    [
        new("e1", "Jan 2025", "Sarah Chen", "SC", "Head of Engineering", "Linearly",
            "Week one, we shipped three features that had been stuck in design review for eight months. The team kept asking what changed."),
        new("e2", "Apr 2025", "Marcus Rivera", "MR", "Staff Engineer", "Northwind",
            "We cut our build time from 14 minutes to 90 seconds over a weekend migration. Nobody rolled anything back."),
        new("e3", "Aug 2025", "Emily Nakamura", "EN", "Design Systems Lead", "Halide Inc.",
            "Twelve product teams on three continents, one design system. First time in company history we had real visual consistency."),
        new("e4", "Nov 2025", "David Park", "DP", "VP of Engineering", "Voltaware",
            "Thirty new engineers productive in their first week. Our previous ramp was three weeks and a lot of Slack noise."),
        new("e5", "Feb 2026", "Aisha Patel", "AP", "Platform Lead", "Mori Labs",
            "Our first open-source project built on the stack hit 5,000 stars in a month. Reviewers kept asking who our design team was."),
    ];
}
