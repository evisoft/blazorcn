@* ============================================================
   Block: testimonials-fullwidth
   Title: TestimonialsFullwidth
   Description: A dark inset featured testimonial block for React and Next.js with inverted color panel, marketing-scale quote typography, metric strip, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-fullwidth.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer spotlight
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The call that changed their roadmap.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                One engineering leader. One bet. A redesign shipped two months early and a maintenance
                role retired.
            </p>
        </div>

        @* Dark inset panel *@
        <figure class="relative mt-12 overflow-hidden rounded-2xl bg-foreground p-10 text-background sm:p-14">
            <span
                aria-hidden="true"
                class="pointer-events-none absolute -top-8 left-6 font-serif text-[160px] leading-none text-background/10 sm:-top-12 sm:left-10 sm:text-[220px]">
                &ldquo;
            </span>

            <div class="relative">
                <blockquote class="text-2xl font-semibold leading-[1.15] tracking-tight text-background sm:text-3xl lg:text-4xl">
                    @_featured.Quote
                </blockquote>

                <figcaption class="mt-10 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border border-background/20 bg-background/10">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-background">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-background">@_featured.Name</p>
                        <p class="text-sm text-background/60">
                            @_featured.Role &middot; @_featured.Company
                        </p>
                    </div>
                </figcaption>

                @* Metric strip *@
                <dl class="mt-10 flex flex-wrap items-start gap-x-8 gap-y-4 border-t border-background/15 pt-6">
                    @foreach (var m in _metrics)
                    {
                        <div>
                            <dt class="text-[11px] font-medium uppercase tracking-wider text-background/50">
                                @m.Label
                            </dt>
                            <dd class="mt-1 text-lg font-semibold tabular-nums text-background">
                                @m.Value
                            </dd>
                        </div>
                    }
                </dl>
            </div>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[260px]">Read the case study</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FeaturedData(string Quote, string Name, string Initials, string Role, string Company);
    private record MetricData(string Id, string Label, string Value);

    private static readonly FeaturedData _featured = new(
        Quote: "Adopting this was the highest-leverage call our engineering org made last year. We consolidated three design systems, eliminated a full-time maintenance role, and shipped our redesign two months ahead of schedule.",
        Name: "Karen Nakamura",
        Initials: "KN",
        Role: "VP Engineering",
        Company: "Orbital Systems"
    );

    private static readonly MetricData[] _metrics =
    [
        new("stage", "Funding", "Series C"),
        new("engineers", "Engineers", "180+"),
        new("tenure", "Customer since", "14 months"),
    ];
}
