@* ============================================================
   Block: testimonials-blockquote
   Title: TestimonialsBlockquote
   Description: A magazine-style editorial dropcap blockquote testimonial for React and Next.js with an oversized first-letter dropcap, long-form pull quote, em-dash attribution line, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-blockquote.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                A customer story
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                From 62 to 98, overnight.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                How one engineering team rebuilt their frontend in three weeks and shipped the cleanest
                audit they'd ever had.
            </p>
        </div>

        @* Editorial dropcap feature *@
        <figure class="mt-10 rounded-2xl border bg-card p-8 sm:p-10">
            <blockquote class="text-xl leading-relaxed text-foreground first-letter:float-left first-letter:mr-3 first-letter:text-7xl first-letter:font-semibold first-letter:leading-[0.8] first-letter:text-foreground">
                @_feature.Quote
            </blockquote>
            <figcaption class="mt-8 border-l-2 border-foreground pl-4">
                <cite class="block text-sm font-semibold not-italic text-foreground">
                    — @_feature.Name, @_feature.Role at @_feature.Company
                </cite>
                <p class="mt-1 text-xs text-muted-foreground">@_feature.Feature</p>
            </figcaption>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[260px]">Read the case study</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FeatureData(string Quote, string Name, string Role, string Company, string Feature);

    private static readonly FeatureData _feature = new(
        Quote: "We rebuilt our entire frontend in three weeks using these components. Our Lighthouse scores jumped from 62 to 98 overnight, and our accessibility audit — which used to return 140 issues — came back clean on the first run. The TypeScript types are so precise that autocomplete basically writes the components for you, and our team onboarding time dropped from two weeks to two days. This is the closest thing to a design system that ships production-ready code out of the box.",
        Name: "Ava Thornton",
        Role: "Director of Engineering",
        Company: "Loom",
        Feature: "As featured in the Engineering Blog"
    );
}
