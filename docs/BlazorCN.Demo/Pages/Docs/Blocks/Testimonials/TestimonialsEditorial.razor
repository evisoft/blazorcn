@* ============================================================
   Block: testimonials-editorial
   Title: TestimonialsEditorial
   Description: A magazine-style editorial testimonial block for React and Next.js with oversized dropcap first letter, generous leading, em-dash attribution, and featured-in credibility line built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-editorial.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Featured story
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The best decision our frontend team ever made.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A long-form pull-quote from the engineering leader who rebuilt a ten-year-old design
                system in one quarter.
            </p>
        </div>

        @* Editorial figure *@
        <figure class="mt-12 rounded-2xl border bg-card p-10 sm:p-14">
            <blockquote class="text-xl leading-relaxed text-foreground first-letter:float-left first-letter:mr-3 first-letter:text-7xl first-letter:font-semibold first-letter:leading-[0.8]">
                Every engineering team reaches a moment where they must decide whether to build their
                design system from scratch or adopt something proven. We spent six months building our
                own before realizing we were solving problems that had already been solved better.
                Switching cut our component PR review time by 80%, our a11y audit findings from 47 to
                zero, and our designer-to-engineer handoff loop from days to minutes. It is, without
                qualification, the best decision our frontend team has ever made.
            </blockquote>

            <figcaption class="mt-10 border-t pt-6">
                <p class="text-base font-semibold text-foreground">
                    &mdash; David Rosen, VP of Engineering at Notion
                </p>
                <p class="mt-2 border-l-2 border-muted-foreground/40 pl-3 text-sm text-muted-foreground">
                    As featured in the Notion Engineering Blog &middot; November 2025
                </p>
            </figcaption>
        </figure>
    </div>
</section>
