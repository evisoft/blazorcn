@* ============================================================
   Block: testimonials-timeline
   Title: TestimonialsTimeline
   Description: A vertical timeline testimonial story for React and Next.js with milestone markers, progressive marketing-scale quotes, semantic blockquotes, and ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                One year in production
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                From day one to one year later.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Follow one engineering team's journey across five chronological milestones — from first
                install to a mature design system.
            </p>
        </div>

        @* Timeline rail *@
        <ol class="relative mt-12 pl-8">
            <div aria-hidden="true" class="absolute top-2 bottom-2 left-[9px] w-px bg-border"></div>
            @foreach (var m in _milestones)
            {
                var milestone = m;
                var isLast = milestone.Id == _milestones[_milestones.Length - 1].Id;
                <li class="@(isLast ? "" : "pb-8")">
                    <span aria-hidden="true" class="absolute left-0 flex size-[19px] -translate-x-[5px] items-center justify-center rounded-full border-2 border-foreground/30 bg-card">
                        <span class="size-2 rounded-full bg-foreground"></span>
                    </span>

                    <div class="flex items-center gap-2">
                        <span class="text-xs font-semibold uppercase tracking-wider text-foreground">
                            @milestone.Date
                        </span>
                        <span class="text-xs text-muted-foreground">&middot;</span>
                        <span class="text-xs text-muted-foreground">@milestone.Title</span>
                    </div>

                    <figure class="mt-3 rounded-2xl border bg-card p-6">
                        <blockquote class="text-lg font-medium leading-relaxed text-foreground">
                            &ldquo;@milestone.Quote&rdquo;
                        </blockquote>
                    </figure>
                </li>
            }
        </ol>

        @* Author attribution *@
        <figcaption class="mt-8 flex items-center justify-center gap-4">
            <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                <span aria-hidden="true" class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                    @_author.Initials
                </span>
            </div>
            <div>
                <p class="text-sm font-semibold text-foreground">@_author.Name</p>
                <p class="text-xs text-muted-foreground">
                    @_author.Role &middot; @_author.Company
                </p>
            </div>
        </figcaption>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[260px]">Read the case study</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[250px]">
                Talk to a customer
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Milestone(string Id, string Date, string Title, string Quote);
    private record Author(string Name, string Initials, string Role, string Company);

    private static readonly Milestone[] _milestones =
    [
        new("m1", "Day 1", "Initial setup",
            "We had the first component rendering in production before the standup ended. Ten minutes from zero to shipping."),
        new("m2", "Week 2", "Team adoption",
            "The entire frontend team adopted the library in two weeks. Code reviews got 40% shorter because the patterns were finally consistent."),
        new("m3", "Month 1", "First major launch",
            "We launched the redesigned dashboard using these components exclusively. NPS jumped 12 points the week it shipped."),
        new("m4", "Month 6", "Design system maturity",
            "New engineers contribute production-quality UI from their first week. We killed the onboarding deck entirely."),
        new("m5", "1 year later", "Long-term impact",
            "Highest-ROI technical decision we made this year. Velocity is up 40% and I have not been paged about UI once."),
    ];

    private static readonly Author _author = new("Marcus Rivera", "MR", "Staff Engineer", "Linearly");
}
