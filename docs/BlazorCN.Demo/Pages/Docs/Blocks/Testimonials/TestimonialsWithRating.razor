@* ============================================================
   Block: testimonials-with-rating
   Title: TestimonialsWithRating
   Description: A featured rating hero testimonial for React and Next.js with an aggregate star chrome line, hero-scale pull quote, oversized avatar attribution, and marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-with-rating.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Loved by engineering teams
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Built for teams who ship.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Hear from the engineers who rebuilt their frontend on our components and stopped filing
                UI regression bugs.
            </p>
        </div>

        @* Featured quote *@
        <figure class="mx-auto mt-12 max-w-3xl rounded-2xl border bg-card p-10 sm:p-14">
            @* Aggregate rating chrome *@
            <div class="flex items-center justify-center gap-2 text-sm text-muted-foreground">
                <div
                    role="img"
                    aria-label="@($"{_review.Rating} out of 5 stars")"
                    class="flex items-center gap-0.5"
                >
                    @foreach (var i in _stars)
                    {
                        <LucideIconCn Name="star" Size="16" aria-hidden="true" Class="size-4 fill-amber-500 text-amber-500" />
                    }
                </div>
                <span class="font-semibold text-foreground">@_review.Rating</span>
                <span>&middot;</span>
                <span>@_review.ReviewCount engineers</span>
            </div>

            @* Quote *@
            <blockquote class="mt-8 text-center text-2xl font-semibold leading-[1.2] tracking-tight text-foreground sm:text-3xl lg:text-4xl">
                &ldquo;@_review.Quote&rdquo;
            </blockquote>

            @* Attribution *@
            <figcaption class="mt-10 flex items-center justify-center gap-4">
                <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                        @_review.Initials
                    </span>
                </div>
                <div>
                    <p class="text-base font-semibold text-foreground">@_review.Name</p>
                    <p class="text-sm text-muted-foreground">
                        @_review.Role &middot; @_review.Company
                    </p>
                </div>
            </figcaption>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ReviewData(string Quote, string Name, string Initials, string Role, string Company, double Rating, string ReviewCount);

    private static readonly ReviewData _review = new(
        Quote: "We migrated from three different UI libraries to this in a weekend. Six months later we have not filed a single UI regression bug. That is unheard of for our team.",
        Name: "Katherine Wells",
        Initials: "KW",
        Role: "VP of Engineering",
        Company: "Meridian Labs",
        Rating: 4.9,
        ReviewCount: "2,184"
    );

    private static readonly int[] _stars = [0, 1, 2, 3, 4];
}
