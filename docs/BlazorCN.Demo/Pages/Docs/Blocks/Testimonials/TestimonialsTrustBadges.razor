@* ============================================================
   Block: testimonials-trust-badges
   Title: TestimonialsTrustBadges
   Description: A testimonials block for React and Next.js featuring a third-party trust badge strip, one focal customer quote, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-trust-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted by industry leaders
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The proof is on every platform.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Independent review platforms, compliance auditors, and the teams shipping on us every
                day all tell the same story.
            </p>
        </div>

        @* Trust badge strip *@
        <div class="mx-auto mt-10 flex max-w-3xl flex-wrap items-center justify-center gap-3">
            @foreach (var badge in _badges)
            {
                <div class="flex items-center gap-2.5 rounded-xl border bg-card px-4 py-3">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-muted">
                        <LucideIconCn Name="@badge.Icon" Size="16" Class="size-4 text-foreground" aria-hidden="true" />
                    </div>
                    <div class="text-left">
                        <p class="text-xs font-semibold text-foreground">@badge.Label</p>
                        <p class="text-[11px] text-muted-foreground">@badge.Value</p>
                    </div>
                </div>
            }
        </div>

        @* Focal quote *@
        <figure class="mx-auto mt-10 max-w-3xl overflow-hidden rounded-2xl border bg-card">
            <div class="px-8 pt-10 pb-8 sm:px-10 sm:pt-12 sm:pb-10">
                <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                    @for (var i = 0; i < 5; i++)
                    {
                        <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                    }
                </div>
                <blockquote class="mt-5 text-xl font-medium leading-relaxed text-foreground sm:text-2xl sm:leading-[1.3]">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>
            </div>
            <figcaption class="flex items-center gap-4 border-t bg-muted/30 px-8 py-5 sm:px-10">
                <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                        @_featured.Initials
                    </span>
                </div>
                <div class="min-w-0">
                    <p class="truncate text-sm font-semibold text-foreground">@_featured.Name</p>
                    <p class="truncate text-xs text-muted-foreground">
                        @_featured.Role &middot; @_featured.Company
                    </p>
                </div>
            </figcaption>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TrustBadge(string Id, string Icon, string Label, string Value);
    private record TestimonialData(string Name, string Role, string Company, string Quote, string Initials);

    private static readonly TrustBadge[] _badges =
    [
        new("b1", "trophy", "Leader", "Spring 2026"),
        new("b2", "star", "Top Rated", "4.9 / 5"),
        new("b3", "award", "#1 Launch", "of the year"),
        new("b4", "shield-check", "SOC 2", "Type II"),
    ];

    private static readonly TestimonialData _featured = new(
        "Lena Vogt",
        "VP of Engineering",
        "Arctis",
        "We vetted six libraries before committing. Our design-to-code handoff dropped 70% in the first quarter, and our accessibility audit passed on the first review — something that took us three attempts the year before.",
        "LV"
    );
}
