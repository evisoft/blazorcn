@* ============================================================
   Block: testimonials-form
   Title: TestimonialsForm
   Description: A verified-buyer testimonial card grid for React and Next.js with emerald verified badges, five-star ratings, marketing-scale headline, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-form.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Verified customers
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Real buyers. Real outcomes.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every quote below comes from a paying customer we&rsquo;ve verified on our own billing
                records. No fake reviews, no incentivised testimonials.
            </p>
        </div>

        @* Card grid *@
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var t in _testimonials)
            {
                <figure class="overflow-hidden rounded-xl border bg-card p-6">
                    <div class="flex items-center justify-between">
                        <div role="img" aria-label="@($"{t.Rating} out of 5 stars")" class="flex items-center gap-0.5">
                            @for (var s = 0; s < 5; s++)
                            {
                                <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                            }
                        </div>
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-1">
                            <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
                            <span class="text-xs font-medium text-emerald-700 dark:text-emerald-400">
                                Verified
                            </span>
                        </span>
                    </div>

                    <blockquote class="mt-5 text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>

                    <figcaption class="mt-6 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role &middot; @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote, int Rating);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Olivia Martinez", "OM", "Frontend Lead", "Raycast",
            "We rebuilt our settings panel in a weekend and the result was better than the custom implementation we'd been maintaining for two years. Two years of work, replaced in 48 hours.",
            5),
        new("t2", "James Thornton", "JT", "CTO", "Dub",
            "Every prop is typed, every callback documented. New hires ship production code on day one now. Our onboarding runbook shrank from 40 pages to 6.",
            5),
        new("t3", "Priya Raman", "PR", "Platform Lead", "Halide Inc.",
            "I fired my YAML. Kidding — we promoted three engineers into real product work instead of babysitting config. On-call pages down 80% this quarter.",
            5),
    ];
}
