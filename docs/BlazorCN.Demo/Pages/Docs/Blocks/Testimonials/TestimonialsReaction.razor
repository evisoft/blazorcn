@* ============================================================
   Block: testimonials-reaction
   Title: TestimonialsReaction
   Description: A conversation-thread testimonials block for React and Next.js with Slack-style chat messages, emoji reaction counters, author timestamps, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-reaction.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Overheard in the channel
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                What teams say unprompted.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A real thread from a real engineering channel — agreement cascading across four voices
                within six minutes.
            </p>
        </div>

        @* Conversation thread *@
        <div class="mt-12 overflow-hidden rounded-2xl border bg-card">
            @* Channel header *@
            <div class="flex items-center gap-2 border-b bg-muted/30 px-5 py-3">
                <LucideIconCn Name="hash" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-semibold text-foreground">customer-love</span>
                <span class="text-xs text-muted-foreground">· 4 replies</span>
            </div>

            @* Messages *@
            <ul class="divide-y">
                @foreach (var msg in _messages)
                {
                    <li>
                        <figure class="flex gap-3 px-5 py-5">
                            <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                                <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                    @msg.Initials
                                </span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <figcaption class="flex flex-wrap items-baseline gap-x-2">
                                    <span class="text-sm font-semibold text-foreground">@msg.Name</span>
                                    <span class="text-xs text-muted-foreground">
                                        @msg.Role · @msg.Company
                                    </span>
                                    <span class="ml-auto text-xs text-muted-foreground tabular-nums">
                                        @msg.Time
                                    </span>
                                </figcaption>
                                <blockquote class="mt-1.5 text-sm leading-relaxed text-foreground">
                                    @msg.Quote
                                </blockquote>
                                <div class="mt-3 flex flex-wrap items-center gap-1.5" role="group" aria-label="Message reactions">
                                    @foreach (var reaction in msg.Reactions)
                                    {
                                        <span role="img" aria-label="@($"{reaction.Label}: {reaction.Count}")"
                                              class="inline-flex items-center gap-1 rounded-full border bg-muted/50 px-2 py-0.5 text-xs text-muted-foreground">
                                            <span aria-hidden="true">@reaction.Emoji</span>
                                            <span class="tabular-nums">@reaction.Count</span>
                                        </span>
                                    }
                                </div>
                            </div>
                        </figure>
                    </li>
                }
            </ul>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Join the community</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Reaction(string Emoji, string Label, int Count);
    private record Message(string Id, string Name, string Initials, string Handle, string Time, string Role, string Company, string Quote, Reaction[] Reactions);

