@* ============================================================
   Block: testimonials-rating-breakdown
   Title: TestimonialsRatingBreakdown
   Description: A rating breakdown testimonials block for React and Next.js with a focal hero quote, animated star distribution bars, average rating summary, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-rating-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Rated by real teams
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                4.8 out of 5 across 2,340 reviews.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Ratings aggregated from verified customers in production. Below, one story from an
                engineer whose team shipped faster the moment they switched.
            </p>
        </div>

        @* Focal quote + rating panel *@
        <figure class="mt-12 overflow-hidden rounded-2xl border bg-card">
            <div class="grid gap-0 lg:grid-cols-2">
                @* Quote side *@
                <div class="p-8 sm:p-10">
                    <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                        @foreach (var i in _starIndices)
                        {
                            <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>
                    <blockquote class="mt-6 text-xl font-semibold leading-[1.25] text-foreground sm:text-2xl">
                        &ldquo;@_featured.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-8 flex items-center gap-4">
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                                @_featured.Initials
                            </span>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-foreground">@_featured.Name</p>
                            <p class="text-xs text-muted-foreground">
                                @_featured.Role · @_featured.Company
                            </p>
                        </div>
                    </figcaption>
                </div>

                @* Rating breakdown side *@
                <div class="border-t bg-muted/30 p-8 sm:p-10 lg:border-l lg:border-t-0">
                    <div class="flex items-baseline gap-2">
                        <span class="text-5xl font-bold tabular-nums tracking-tight text-foreground">
                            @_averageRating
                        </span>
                        <span class="text-sm text-muted-foreground">/ 5</span>
                    </div>
                    <p class="mt-1 text-xs text-muted-foreground">
                        From @_totalReviews.ToString("N0") verified reviews
                    </p>

                    <div class="mt-6 space-y-2">
                        @foreach (var level in _ratingDistribution)
                        {
                            <div class="flex items-center gap-3">
                                <span class="flex w-8 items-center gap-1 text-xs tabular-nums text-muted-foreground">
                                    @level.Stars
                                    <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" aria-hidden="true" />
                                </span>
                                <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-amber-500" style="@($"width:{level.Percentage}%")"></div>
                                </div>
                                <p class="w-10 text-right text-xs tabular-nums text-muted-foreground">
                                    @(level.Percentage)%
                                </p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all reviews
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record RatingLevel(int Stars, int Percentage, int Count);

    private record Featured(string Quote, string Name, string Initials, string Role, string Company);

    private const double _averageRating = 4.8;
    private const int _totalReviews = 2340;

    private static readonly RatingLevel[] _ratingDistribution =
    [
        new(5, 78, 1825),
        new(4, 15, 351),
        new(3, 4, 94),
        new(2, 2, 47),
        new(1, 1, 23),
    ];

    private static readonly Featured _featured = new(
        "Hands down the best library we have shipped with. We replaced two months of custom UI work in a single sprint, and our Lighthouse score jumped 18 points.",
        "Julia Strand",
        "JS",
        "Staff Engineer",
        "Linearly"
    );

    private static readonly int[] _starIndices = [0, 1, 2, 3, 4];
}
