@* ============================================================
   Block: testimonials-animated-count
   Title: TestimonialsAnimatedCount
   Description: A testimonials block for React and Next.js with an animated CountUp metric bar above a two-column quote grid, star ratings, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-animated-count.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted at scale
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The numbers tell one story.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Our customers tell the rest. From two-person startups to public companies, here's what
                teams say after a year in production.
            </p>
        </div>

        @* Metric bar *@
        <dl class="mt-10 grid grid-cols-3 gap-3 sm:gap-4">
            @foreach (var stat in _stats)
            {
                <div class="rounded-xl border bg-card px-4 py-5 text-center sm:py-6">
                    <dt class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                        @stat.Label
                    </dt>
                    <dd class="mt-1 text-2xl font-bold tabular-nums tracking-tight sm:text-3xl">
                        @FormatStatValue(stat)
                    </dd>
                    <dd class="mt-0.5 text-xs text-muted-foreground">@stat.Sub</dd>
                </div>
            }
        </dl>

        @* Quote grid *@
        <div class="mt-6 grid gap-4 sm:grid-cols-2 sm:gap-6">
            @foreach (var testimonial in _testimonials)
            {
                <figure class="flex flex-col rounded-xl border bg-card p-6">
                    <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                        @foreach (var i in _starIndices)
                        {
                            <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>
                    <blockquote class="mt-4 flex-1 text-base leading-relaxed text-foreground">
                        "@(testimonial.Quote)"
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @testimonial.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">
                                @testimonial.Name
                            </p>
                            <p class="truncate text-xs text-muted-foreground">
                                @testimonial.Role · @testimonial.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Stat(string Id, double Value, string Suffix, string Label, string Sub, int Decimals);

    private record Testimonial(string Id, string Name, string Role, string Company, string Quote, string Initials);

    private static readonly Stat[] _stats =
    [
        new("s1", 12000, "+", "Teams", "In production", 0),
        new("s2", 4.9, "/5", "Rating", "2,184 reviews", 1),
        new("s3", 99, "%", "Retention", "Year over year", 0),
    ];

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Ingrid Larsen", "Head of Engineering", "Orbit",
            "We migrated 40 services in three weeks and cut our p99 latency from 900ms to 80ms. The rollback plan we spent a month writing was never needed.",
            "IL"),
        new("t2", "Nathan Park", "Staff Frontend Engineer", "Relay",
            "Our on-call pager rang twice last quarter. Before switching, it rang twice a day. I haven't been paged at 3am once this year — that alone paid for the migration.",
            "NP"),
    ];

    private static readonly int[] _starIndices = [0, 1, 2, 3, 4];

    private static string FormatStatValue(Stat stat)
    {
        if (stat.Decimals > 0)
            return stat.Value.ToString($"F{stat.Decimals}") + stat.Suffix;
        var formatted = ((long)stat.Value).ToString("N0");
        return formatted + stat.Suffix;
    }
}
