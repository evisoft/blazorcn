@* ============================================================
   Block: testimonials-masonry-01
   Title: Testimonials Masonry 01
   Description: Masonry layout testimonials with staggered heights for varied quote lengths and dynamic Pinterest-style grid
   Long Description: Full grid of all testimonials visible
   Dependencies: CardCn, CardContentCn, LucideStarCn
   Source: original/blocks/testimonials/testimonials-masonry-01.tsx
   ============================================================ *@

<section class="py-16">
    <div class="container mx-auto px-4">
        <div class="mb-12 text-center">
            <h2 class="mb-4 text-3xl font-bold md:text-4xl">Loved by Thousands</h2>
            <p class="text-muted-foreground mx-auto max-w-2xl text-lg">
                Don't just take our word for it—hear from our satisfied customers
            </p>
        </div>

        <div class="columns-1 gap-6 md:columns-2 lg:columns-3">
            @foreach (var testimonial in _testimonials)
            {
                <CardCn Class="mb-6 break-inside-avoid transition-all hover:shadow-lg">
                    <CardContentCn Class="p-6">
                        <div class="mb-3 flex items-center gap-1">
                            @for (var i = 0; i < testimonial.Rating; i++)
                            {
                                <LucideStarCn class="h-4 w-4 fill-yellow-400 text-yellow-400" />
                            }
                        </div>
                        <blockquote class="text-foreground/90 mb-4 text-sm leading-relaxed">
                            &quot;@testimonial.Quote&quot;
                        </blockquote>
                        <div class="flex items-center gap-3">
                            <div class="h-10 w-10 shrink-0 overflow-hidden rounded-full">
                                <img alt="@testimonial.Name" class="h-full w-full object-cover" height="400" src="@testimonial.Image" width="400" />
                            </div>
                            <div>
                                <p class="text-sm font-semibold">@testimonial.Name</p>
                                <p class="text-muted-foreground text-xs">@testimonial.Role</p>
                            </div>
                        </div>
                    </CardContentCn>
                </CardCn>
            }
        </div>
    </div>
</section>

