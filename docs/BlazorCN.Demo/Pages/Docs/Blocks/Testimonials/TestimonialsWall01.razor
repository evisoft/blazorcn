@* ============================================================
   Block: testimonials-wall-01
   Title: Testimonials Wall 01
   Description: Testimonials wall showing all customer reviews in dense grid layout for overwhelming social proof volume
   Long Description: Staggered heights Pinterest-style layout
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, CardCn, CardContentCn, LucideStarCn
   Source: original/blocks/testimonials/testimonials-wall-01.tsx
   ============================================================ *@

<section class="py-16">
    <div class="container mx-auto px-4">
        <div class="mb-12 text-center">
            <h2 class="mb-4 text-3xl font-bold md:text-4xl">Trusted by 10,000+ Customers</h2>
            <p class="text-muted-foreground mx-auto max-w-2xl text-lg">
                Join thousands of satisfied customers worldwide
            </p>
        </div>

        <div class="mb-8 flex items-center justify-center gap-4">
            <BadgeCn Class="text-sm" Variant="BadgeVariant.Secondary">
                All Reviews
            </BadgeCn>
            <BadgeCn Class="text-sm" Variant="BadgeVariant.Outline">
                <LucideStarCn class="mr-1 h-3 w-3 fill-yellow-400 text-yellow-400" />
                5.0 Average
            </BadgeCn>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var testimonial in _testimonials)
            {
                <CardCn Class="transition-all hover:shadow-md">
                    <CardContentCn Class="p-4">
                        <div class="mb-2 flex items-center gap-1">
                            @for (var i = 0; i < testimonial.Rating; i++)
                            {
                                <LucideStarCn class="h-3 w-3 fill-yellow-400 text-yellow-400" />
                            }
                        </div>
                        <p class="text-foreground/90 mb-3 line-clamp-2 text-sm">
                            @testimonial.Quote
                        </p>
                        <div class="flex items-center gap-2">
                            <AvatarCn Class="h-8 w-8">
                                <AvatarImageCn Alt="@testimonial.Name" Src="@testimonial.Image" />
                                <AvatarFallbackCn Class="text-xs">@GetInitials(testimonial.Name)</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-xs font-semibold">@testimonial.Name</p>
                                <p class="text-muted-foreground truncate text-xs">@testimonial.Role</p>
                            </div>
                            @if (testimonial.Verified)
                            {
                                <BadgeCn Class="h-5 shrink-0 px-1.5 text-xs" Variant="BadgeVariant.Secondary">
                                    &#x2713;
                                </BadgeCn>
                            }
                        </div>
                    </CardContentCn>
                </CardCn>
            }
        </div>
    </div>
</section>

@code {
    private record WallTestimonial(string Name, string Role, string Image, int Rating, string Quote, bool Verified);

    private static string GetInitials(string name) =>
        string.Join("", name.Split(' ').Select(n => n[0]));

