@* ============================================================
   Block: testimonials-multi-format
   Title: TestimonialsMultiFormat
   Description: An asymmetric bento testimonial layout for React and Next.js with a featured hero quote, a metric highlight tile, and a video thumbnail tile built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-multi-format.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Quotes, numbers, and faces.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The kinds of proof that move engineering teams from curious to committed — all on one
                screen.
            </p>
        </div>

        @* Bento *@
        <div class="mt-12 grid gap-4 sm:grid-cols-3 sm:grid-rows-2">
            @* Featured quote *@
            <figure class="overflow-hidden rounded-2xl border bg-card p-8 sm:col-span-2 sm:row-span-2 sm:p-10">
                <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                    @for (var i = 0; i < 5; i++)
                    {
                        <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                    }
                </div>
                <blockquote class="mt-6 text-xl font-semibold leading-[1.25] text-foreground sm:text-2xl">
                    &ldquo;We replaced two years of custom component work in a single sprint. The
                    accessibility defaults alone saved our next audit cycle — and our engineers stopped
                    dreading frontend tickets.&rdquo;
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                            JH
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-foreground">James Holloway</p>
                        <p class="text-sm text-muted-foreground">Engineering Manager · Veritas</p>
                    </div>
                </figcaption>
            </figure>

            @* Metric tile *@
            <div class="flex flex-col justify-between rounded-2xl border bg-card p-6">
                <div>
                    <p class="text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                        Faster to prod
                    </p>
                    <p class="mt-2 text-4xl font-bold tabular-nums tracking-tight text-foreground sm:text-5xl">
                        60%
                    </p>
                    <p class="mt-2 text-xs leading-relaxed text-muted-foreground">
                        Average cycle-time cut reported across 140 engineering teams.
                    </p>
                </div>
                <figcaption class="mt-5 flex items-center gap-3">
                    <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                            PK
                        </span>
                    </div>
                    <div class="min-w-0">
                        <p class="truncate text-sm font-semibold text-foreground">Priya Kapoor</p>
                        <p class="truncate text-xs text-muted-foreground">
                            Frontend Architect · Nimbus
                        </p>
                    </div>
                </figcaption>
            </div>

            @* Video tile *@
            <div class="group overflow-hidden rounded-2xl border bg-card">
                <div class="relative aspect-video bg-gradient-to-br from-muted via-muted to-muted/40">
                    <button
                        type="button"
                        aria-label="Play video testimonial from Daniel Okafor"
                        class="absolute inset-0 flex items-center justify-center">
                        <span class="flex size-12 items-center justify-center rounded-full border bg-background/90 shadow-lg backdrop-blur transition-transform group-hover:scale-110">
                            <LucideIconCn Name="play" Size="20" Class="size-5 translate-x-0.5 fill-foreground text-foreground" aria-hidden="true" />
                        </span>
                    </button>
                    <span class="absolute bottom-2 right-2 rounded bg-background/90 px-1.5 py-0.5 font-mono text-[10px] text-foreground">
                        2:34
                    </span>
                </div>
                <div class="p-5">
                    <p class="line-clamp-2 text-sm font-medium italic text-muted-foreground">
                        &ldquo;Our design team stopped filing UI bugs the week we shipped this.&rdquo;
                    </p>
                    <figcaption class="mt-3 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                DO
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">Daniel Okafor</p>
                            <p class="truncate text-xs text-muted-foreground">Product Lead · Clearpath</p>
                        </div>
                    </figcaption>
                </div>
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>
