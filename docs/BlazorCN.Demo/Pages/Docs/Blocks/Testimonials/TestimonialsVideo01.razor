@* ============================================================
   Block: testimonials-video-01
   Title: Testimonials Video 01
   Description: Video testimonials grid with play button overlays and thumbnail previews for authentic customer stories
   Long Description: Carousel with background images
   Dependencies: ButtonCn, CardCn, CardContentCn, DialogCn, DialogContentCn, LucidePlayCn, LucideXCn
   Source: original/blocks/testimonials/testimonials-video-01.tsx
   ============================================================ *@

<section class="py-16">
    <div class="container mx-auto px-4">
        <div class="mb-12 text-center">
            <h2 class="mb-4 text-3xl font-bold md:text-4xl">Customer Success Stories</h2>
            <p class="text-muted-foreground mx-auto max-w-2xl text-lg">
                Hear directly from our customers about how we've helped transform their business
            </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var testimonial in _testimonials)
            {
                <CardCn Class="group cursor-pointer overflow-hidden transition-all hover:shadow-lg" @onclick="() => _selectedVideo = testimonial.VideoUrl">
                    <div class="relative aspect-video overflow-hidden">
                        <img alt="@($"Video testimonial from {testimonial.Name}")" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" height="400" src="@testimonial.Thumbnail" width="400" />
                        <div class="absolute inset-0 flex items-center justify-center bg-black/30 transition-all group-hover:bg-black/40">
                            <div class="bg-primary flex h-16 w-16 items-center justify-center rounded-full shadow-lg transition-transform group-hover:scale-110">
                                <LucidePlayCn class="ml-1 h-6 w-6 fill-white text-white" />
                            </div>
                        </div>
                    </div>
                    <CardContentCn Class="p-4">
                        <p class="text-muted-foreground mb-2 text-sm italic">
                            &quot;@testimonial.Quote&quot;
                        </p>
                        <p class="text-sm font-semibold">@testimonial.Name</p>
                        <p class="text-muted-foreground text-xs">@testimonial.Role</p>
                    </CardContentCn>
                </CardCn>
            }
        </div>

        <DialogCn Open="@(!string.IsNullOrEmpty(_selectedVideo))" OpenChanged="v => { if (!v) _selectedVideo = null; }">
            <DialogContentCn Class="max-w-4xl p-0">
                <ButtonCn Class="absolute right-4 top-4 z-10 rounded-full bg-black/50 text-white hover:bg-black/70" @onclick="() => _selectedVideo = null" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Close">
                    <LucideXCn class="h-4 w-4" />
                </ButtonCn>
                @if (!string.IsNullOrEmpty(_selectedVideo))
                {
                    <div class="aspect-video w-full">
                        <iframe allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen class="h-full w-full" src="@_selectedVideo" title="Customer testimonial video"></iframe>
                    </div>
                }
            </DialogContentCn>
        </DialogCn>
    </div>
</section>

@code {
    private record VideoTestimonial(string Name, string Role, string Thumbnail, string VideoUrl, string Quote);

    private string? _selectedVideo;

    private readonly VideoTestimonial[] _testimonials =
    [
        new("Sarah Mitchell", "CEO, TechStart",
