            "https://www.youtube.com/embed/dQw4w9WgXcQ", "This platform transformed our entire workflow"),
        new("Marcus Johnson", "CTO, DataFlow",
            "https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&q=80&w=800&h=600",
