@* ============================================================
   Block: testimonials-tweet-style
   Title: TestimonialsTweetStyle
   Description: A tweet-style testimonials card grid for React and Next.js with verified profile chrome, engagement metrics, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-tweet-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                From the timeline
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                What developers post about us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The fastest feedback in software is the kind engineers write on their own time. Here is
                a sample from this week.
            </p>
        </div>

        @* Tweet grid *@
        <div class="mt-10 grid gap-5 sm:grid-cols-2">
            @foreach (var tw in _tweets)
            {
                <figure class="rounded-xl border bg-card p-6">
                    @* Header *@
                    <div class="flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @tw.Initials
                            </span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-1">
                                <span class="truncate text-sm font-semibold text-foreground">
                                    @tw.Name
                                </span>
                                @if (tw.Verified)
                                {
                                    <LucideIconCn Name="badge-check" Size="16" Class="size-4 shrink-0 fill-blue-500 text-background" aria-label="Verified account" />
                                }
                            </div>
                            <p class="truncate text-xs text-muted-foreground">
                                @tw.Handle · @tw.Timestamp
                            </p>
                        </div>
                    </div>

                    @* Content *@
                    <blockquote class="mt-4 text-base leading-relaxed text-foreground">
                        @tw.Content
                    </blockquote>

                    @* Engagement *@
                    <figcaption class="mt-5 flex items-center gap-5 text-xs text-muted-foreground">
                        <span class="flex items-center gap-1.5">
                            <LucideIconCn Name="message-circle" Size="14" Class="size-3.5" aria-hidden="true" />
                            <span class="tabular-nums">@tw.Replies</span>
                        </span>
                        <span class="flex items-center gap-1.5">
                            <LucideIconCn Name="repeat-2" Size="14" Class="size-3.5" aria-hidden="true" />
                            <span class="tabular-nums">@tw.Retweets</span>
                        </span>
                        <span class="flex items-center gap-1.5">
                            <LucideIconCn Name="heart" Size="14" Class="size-3.5" aria-hidden="true" />
                            <span class="tabular-nums">@tw.Likes</span>
                        </span>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Tweet(string Id, string Name, string Handle, string Initials, bool Verified, string Content, string Timestamp, int Likes, int Retweets, int Replies);

    private static readonly Tweet[] _tweets =
    [
        new("tw1", "Alex Patel", "@alexpatel", "AP", true,
            "Migrated our entire design system in three weeks instead of a quarter. The TypeScript types caught 14 bugs before they hit prod. I almost feel guilty.",
            "2h", 1284, 247, 62),
        new("tw2", "Mei Zhang", "@meizhang_dev", "MZ", true,
            "Shipped a full SaaS dashboard this weekend. Zero accessibility audits needed. This is what frontend is supposed to feel like in 2026.",
            "5h", 3512, 589, 123),
        new("tw3", "Jordan Beck", "@jordanbeck", "JB", false,
            "Our design team stopped filing spacing bugs entirely after we adopted this. The tokens are that good. Savings: about 6 hours per sprint.",
            "8h", 856, 131, 38),
        new("tw4", "Sofia Rossi", "@sofiarossi_eng", "SR", true,
            "Evaluated five libraries for our startup. Best docs, cleanest API, most active community. The decision took us about eleven minutes.",
            "1d", 1378, 262, 91),
    ];
}
