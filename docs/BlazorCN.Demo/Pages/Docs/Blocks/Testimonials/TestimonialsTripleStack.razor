@* ============================================================
   Block: testimonials-triple-stack
   Title: TestimonialsTripleStack
   Description: A draggable layered testimonial swipe stack for React and Next.js with real drag gestures, autoplay, keyboard navigation, pagination dots, and a deep card stack built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-triple-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Swipe through the stack.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Drag, tap the arrow keys, or let autoplay reveal one story at a time from the engineers
                who ship with us every day.
            </p>
        </div>

        @* Stack *@
        <div class="relative mx-auto mt-12 h-[440px] max-w-xl">
            @foreach (var offset in new[] { 2, 1, 0 })
            {
                var cardIdx = (_index + offset) % _testimonials.Length;
                var card = _testimonials[cardIdx];
                var isActive = offset == 0;
                var zIndex = 3 - offset;
                var translateY = offset * 24;
                var scale = 1.0 - offset * 0.06;
                var opacity = 1.0 - offset * 0.3;
                var styleStr = $"z-index:{zIndex};transform:translateY({translateY}px) scale({scale.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)});opacity:{opacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)};";
                <figure class="absolute inset-0 flex flex-col overflow-hidden rounded-2xl border bg-card p-8 shadow-lg sm:p-10"
                        style="@styleStr"
                        aria-hidden="@(isActive ? "false" : "true")">
                    <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                        @for (var i = 0; i < 5; i++)
                        {
                            <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>

                    <blockquote class="mt-6 flex-1 text-lg font-medium leading-relaxed text-foreground sm:text-xl">
                        &ldquo;@card.Quote&rdquo;
                    </blockquote>

                    <figcaption class="mt-8 flex items-center gap-4">
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span aria-hidden="true"
                                  class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                                @card.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@card.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @card.Role &middot; @card.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* Pagination dots *@
        <div class="mt-6 flex items-center justify-center gap-2">
            @for (var i = 0; i < _testimonials.Length; i++)
            {
                var idx = i;
                var dotClass = idx == _index
                    ? "h-1.5 w-6 rounded-full bg-foreground transition-all"
                    : "h-1.5 w-1.5 rounded-full bg-muted-foreground/30 hover:bg-muted-foreground/60 transition-all";
                <button type="button"
                        @onclick="@(() => SetIndex(idx))"
                        aria-label="@($"Go to testimonial {idx + 1} of {_testimonials.Length}")"
                        aria-current="@(idx == _index ? "true" : null)"
                        class="@dotClass" />
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Sarah Chen", "SC", "Staff Engineer", "Linearly",
            "We shipped five years of backlog in three months. The team still debates whether it was the platform or finally having a pipeline that didn't fight us."),
        new("t2", "Marcus Okonkwo", "MO", "VP of Engineering", "Northwind",
            "Our on-call pager rang twice last quarter. Before switching, it rang twice a day. I haven't been called at 3am once this year."),
        new("t3", "Priya Raman", "PR", "Platform Lead", "Halide Inc.",
            "I fired my DevOps team the week we migrated. Kidding — we promoted them into real engineering work instead of babysitting YAML."),
        new("t4", "Tomás Alvarado", "TA", "CTO", "Voltaware",
            "Cut our p99 latency from 900ms to 80ms in a weekend migration. The rollback plan was never needed."),
        new("t5", "Emi Takeda", "ET", "Head of Platform", "Mori Labs",
            "The first tool in five years that my engineers chose on their own time. Highest compliment I know how to give."),
    ];

    private int _index = 0;

    private void SetIndex(int idx)
    {
        _index = idx;
    }
}
