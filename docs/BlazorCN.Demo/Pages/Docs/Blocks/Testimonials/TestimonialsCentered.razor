@* ============================================================
   Block: testimonials-centered
   Title: TestimonialsCentered
   Description: A centered featured hero quote testimonials block for React and Next.js with oversized typography, dot pagination, animated quote transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-centered.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Loved by engineering teams
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                One voice at a time.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Hear from the engineers and design leads who bet their frontend roadmap on us and never
                looked back.
            </p>
        </div>

        @* Featured hero figure *@
        <figure class="relative mx-auto mt-12 max-w-3xl rounded-2xl border bg-card p-10 sm:p-14">
            <span
                aria-hidden="true"
                class="pointer-events-none absolute -top-8 left-6 select-none font-serif text-[140px] leading-none text-muted-foreground/15 sm:-top-10 sm:left-10 sm:text-[180px]"
            >
                &ldquo;
            </span>

            @* Stars *@
            <div
                role="img"
                aria-label="5 out of 5 stars"
                class="relative flex items-center gap-0.5"
            >
                @foreach (var i in _starIndices)
                {
                    <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                }
            </div>

            @{
                var t = _testimonials[_active];
            }
            <div>
                <blockquote class="relative mt-6 text-2xl font-semibold leading-[1.2] tracking-tight text-foreground sm:text-3xl lg:text-4xl">
                    @t.Quote
                </blockquote>

                <figcaption class="mt-8 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                            @t.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-foreground">@t.Name</p>
                        <p class="text-sm text-muted-foreground">
                            @t.Role · @t.Company
                        </p>
                    </div>
                </figcaption>
            </div>
        </figure>

        @* Pagination dots *@
        <div class="mt-6 flex items-center justify-center gap-2">
            @foreach (var item in _testimonials)
            {
                var idx = Array.IndexOf(_testimonials, item);
                var isActive = idx == _active;
                <button
                    type="button"
                    @onclick="@(() => SetActive(idx))"
                    aria-label="@($"View testimonial {idx + 1} of {_testimonials.Length}")"
                    aria-current="@(isActive ? "true" : null)"
                    class="@Cn.Merge("h-1.5 rounded-full transition-all", isActive ? "w-6 bg-foreground" : "w-1.5 bg-muted-foreground/30 hover:bg-muted-foreground/60")"
                ></button>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Quote, string Name, string Initials, string Role, string Company);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1",
            "We shipped five years of backlog in three months. Our frontend velocity doubled in the first sprint and design consistency has never been better.",
            "Sarah Chen", "SC", "Head of Engineering", "Linearly"),
        new("t2",
            "I evaluated twelve libraries before picking this one. TypeScript inference, accessibility defaults, and docs quality are in a league of their own.",
            "Marcus Rivera", "MR", "Staff Engineer", "Northwind"),
        new("t3",
            "Migrating our design system took two weeks instead of two months. Every component just worked out of the box with our existing Tailwind config.",
            "Emily Nakamura", "EN", "Design Systems Lead", "Halide Inc."),
    ];

    private static readonly int[] _starIndices = [0, 1, 2, 3, 4];

    private int _active = 0;

    private void SetActive(int index)
    {
        _active = index;
    }
}
