@* ============================================================
   Block: testimonials-masonry
   Title: TestimonialsMasonry
   Description: A Pinterest-style masonry testimonials block for React and Next.js using CSS columns with break-inside-avoid, varying card heights, and a marketing headline cluster, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-masonry.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The teams shipping with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Twelve thousand engineering teams in production. Here&rsquo;s a wall of what a few of
                them said after shipping for a year.
            </p>
        </div>

        @* Masonry wall *@
        <div class="mt-12 columns-1 gap-4 sm:columns-2 lg:columns-3 xl:columns-4">
            @foreach (var t in _testimonials)
            {
                <figure class="mb-4 break-inside-avoid rounded-xl border bg-card p-4">
                    @if (t.Rating.HasValue)
                    {
                        <div role="img" aria-label="5 out of 5 stars" class="mb-2 flex items-center gap-0.5">
                            @for (var j = 0; j < 5; j++)
                            {
                                <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" />
                            }
                        </div>
                    }
                    <blockquote class="text-sm leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-4 flex items-center gap-3">
                        <div class="relative size-9 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-[11px] font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Join these teams</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">Read all stories</ButtonCn>
        </div>
    </div>
</section>

