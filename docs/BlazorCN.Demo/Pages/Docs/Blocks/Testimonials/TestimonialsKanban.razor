@* ============================================================
   Block: testimonials-kanban
   Title: TestimonialsKanban
   Description: A three-column sentiment-grouped testimonials grid for React and Next.js with a centered marketing headline, category columns, and breathing-room cards built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-kanban.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer outcomes
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Three ways teams win with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Quality, velocity, impact — pick the dimension that matters most to your team and hear
                from customers who got it.
            </p>
        </div>

        <div class="mt-12 grid gap-6 lg:grid-cols-3">
            @foreach (var col in _columns)
            {
                <div class="flex flex-col gap-4">
                    <div class="px-1">
                        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                            @col.Eyebrow
                        </p>
                        <h3 class="mt-1 text-lg font-semibold tracking-tight text-foreground">
                            @col.Title
                        </h3>
                    </div>

                    @foreach (var t in col.Testimonials)
                    {
                        <figure class="rounded-xl border bg-card p-6">
                            <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                                @for (var i = 0; i < 5; i++)
                                {
                                    <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                                }
                            </div>
                            <blockquote class="mt-4 text-base leading-relaxed text-foreground">
                                &ldquo;@t.Quote&rdquo;
                            </blockquote>
                            <figcaption class="mt-5 flex items-center gap-3">
                                <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                                    <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                        @t.Initials
                                    </span>
                                </div>
                                <div class="min-w-0">
                                    <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                                    <p class="truncate text-xs text-muted-foreground">
                                        @t.Role &middot; @t.Company
                                    </p>
                                </div>
                            </figcaption>
                        </figure>
                    }
                </div>
            }
        </div>

        <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private record Column(string Id, string Eyebrow, string Title, Testimonial[] Testimonials);

    private static readonly Column[] _columns =
    [
        new("quality", "Quality", "Polished by default",
        [
            new("q1", "Sarah Mitchell", "SM", "Product Designer", "Stackline",
                "Every detail — spacing, animation timing, focus rings — feels intentional. We stopped filing UI inconsistency bugs the week we migrated."),
            new("q2", "Lara Nguyen", "LN", "Frontend Lead", "Halide",
                "Accessibility and dark mode handled out of the box. We passed our VPAT audit without a single remediation ticket."),
        ]),
        new("velocity", "Velocity", "Ship in days, not weeks",
        [
            new("v1", "James Park", "JP", "Senior Engineer", "Clearpath",
                "We shipped a complete SaaS dashboard in four days. The second sprint, we caught up on eighteen months of backlog."),
            new("v2", "Elena Rossi", "ER", "Engineering Manager", "Nimbus",
                "Cut our design-to-code handoff from two days to twenty minutes. Paid for itself in the first sprint."),
        ]),
        new("impact", "Impact", "Game-changing outcomes",
        [
            new("i1", "Priya Kapoor", "PK", "Tech Lead", "Veritas",
                "Onboarding new engineers went from two weeks to two days. That alone justified the switch within a quarter."),
            new("i2", "David Kim", "DK", "Founder", "Mori Labs",
                "As a solo founder, this is my unfair advantage. I ship like a team of five without hiring a team of five."),
        ]),
    ];
}
