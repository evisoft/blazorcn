@page "/docs/blocks/testimonials"
@layout DocsLayout

<PageTitle>Testimonials Blocks — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Testimonials</h1>
        <p class="mt-2 text-lg text-muted-foreground">Customer testimonials, reviews, and social proof blocks.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Bento 01" Description="Bento box grid layout with varying card sizes creating visual hierarchy and featured testimonials." Code="@TestimonialsBento01Code">
        <TestimonialsBento01 />
    </ComponentPreview>

    <ComponentPreview Title="Cards 01" Description="Testimonials with card layout featuring verified badges, usernames, Twitter links, and dates for social proof." Code="@TestimonialsCards01Code">
        <TestimonialsCards01 />
    </ComponentPreview>

    <ComponentPreview Title="Carousel Dark 01" Description="Testimonials carousel with dark background, company logos, and avatar dot navigation for B2B social proof." Code="@TestimonialsCarouselDark01Code">
        <TestimonialsCarouselDark01 />
    </ComponentPreview>

    <ComponentPreview Title="Centered 01" Description="Testimonials section with centered cards displaying customer quotes, ratings, and profile images with badge header." Code="@TestimonialsCentered01Code">
        <TestimonialsCentered01 />
    </ComponentPreview>

    <ComponentPreview Title="Marquee 01" Description="Infinite scrolling marquee of testimonials with automatic animation and hover pause for continuous social proof." Code="@TestimonialsMarquee01Code">
        <TestimonialsMarquee01 />
    </ComponentPreview>

    <ComponentPreview Title="Masonry 01" Description="Masonry layout testimonials with staggered heights for varied quote lengths and dynamic Pinterest-style grid." Code="@TestimonialsMasonry01Code">
        <TestimonialsMasonry01 />
    </ComponentPreview>

    <ComponentPreview Title="Video 01" Description="Video testimonials grid with play button overlays and thumbnail previews for authentic customer stories." Code="@TestimonialsVideo01Code">
        <TestimonialsVideo01 />
    </ComponentPreview>

    <ComponentPreview Title="Wall 01" Description="Testimonials wall showing all customer reviews in dense grid layout for overwhelming social proof volume." Code="@TestimonialsWall01Code">
        <TestimonialsWall01 />
    </ComponentPreview>
</div>

@code {
    private const string TestimonialsBento01Code = @"<section class=""py-16"">
    <div class=""container mx-auto px-4"">
        <div class=""mb-12 text-center"">
            <h2 class=""mb-4 text-3xl font-bold md:text-4xl"">What Our Customers Say</h2>
            <p class=""text-muted-foreground mx-auto max-w-2xl text-lg"">
                Trusted by thousands of professionals worldwide
            </p>
        </div>

        <div class=""grid gap-4 sm:grid-cols-2 md:auto-rows-fr md:grid-cols-6"">
            @* Featured Large Card *@
            <CardCn Class=""sm:col-span-2 md:col-span-3 md:row-span-2 transition-all hover:shadow-lg"">
                <CardContentCn Class=""flex h-full flex-col justify-between p-6 md:p-8"">
                    <div>
                        <img alt=""@_featured.Company"" class=""mb-6 h-8 opacity-60"" height=""400"" src=""@_featured.Logo"" width=""400"" />
                        <LucideQuoteCn class=""text-primary/20 mb-4 h-10 w-10"" />
                        <div class=""mb-4 flex items-center gap-1"">
                            @for (var i = 0; i < _featured.Rating; i++)
                            {
                                <LucideStarCn class=""h-4 w-4 fill-yellow-400 text-yellow-400"" />
                            }
                        </div>
                        <blockquote class=""text-foreground mb-6 text-lg leading-relaxed md:text-xl"">
                            @_featured.Quote
                        </blockquote>
                    </div>
                    <div class=""flex items-center gap-3"">
                        <AvatarCn Class=""h-12 w-12"">
                            <AvatarImageCn Alt=""@_featured.Name"" Src=""@_featured.Image"" />
                            <AvatarFallbackCn>@GetInitials(_featured.Name)</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <p class=""font-semibold"">@_featured.Name</p>
                            <p class=""text-muted-foreground text-sm"">@_featured.Role, @_featured.Company</p>
                        </div>
                    </div>
                </CardContentCn>
            </CardCn>

            @* Small Cards (first 2) *@
            @foreach (var testimonial in _testimonials.Take(2))
            {
                <CardCn Class=""sm:col-span-1 md:col-span-3 transition-all hover:shadow-md"">
                    <CardContentCn Class=""p-6"">
                        <div class=""mb-3 flex items-center gap-1"">
                            @for (var i = 0; i < testimonial.Rating; i++)
                            {
                                <LucideStarCn class=""h-3 w-3 fill-yellow-400 text-yellow-400"" />
                            }
                        </div>
                        <p class=""text-foreground/90 mb-4 text-sm"">""@testimonial.Quote""</p>
                        <div class=""flex items-center gap-2"">
                            <AvatarCn Class=""h-8 w-8"">
                                <AvatarImageCn Alt=""@testimonial.Name"" Src=""@testimonial.Image"" />
                                <AvatarFallbackCn Class=""text-xs"">@GetInitials(testimonial.Name)</AvatarFallbackCn>
                            </AvatarCn>
                            <div>
                                <p class=""text-xs font-semibold"">@testimonial.Name</p>
                                <p class=""text-muted-foreground text-xs"">@testimonial.Role</p>
                            </div>
                        </div>
                    </CardContentCn>
                </CardCn>
            }

            @* Medium Card *@
            <CardCn Class=""sm:col-span-1 md:col-span-2 transition-all hover:shadow-md"">
                <CardContentCn Class=""p-6"">
                    <div class=""mb-3 flex items-center gap-1"">
                        @for (var i = 0; i < _testimonials[2].Rating; i++)
                        {
                            <LucideStarCn class=""h-3 w-3 fill-yellow-400 text-yellow-400"" />
                        }
                    </div>
                    <p class=""text-foreground/90 mb-4 text-sm"">""@_testimonials[2].Quote""</p>
                    <div class=""flex items-center gap-2"">
                        <AvatarCn Class=""h-8 w-8"">
                            <AvatarImageCn Alt=""@_testimonials[2].Name"" Src=""@_testimonials[2].Image"" />
                            <AvatarFallbackCn Class=""text-xs"">@GetInitials(_testimonials[2].Name)</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <p class=""text-xs font-semibold"">@_testimonials[2].Name</p>
                            <p class=""text-muted-foreground text-xs"">@_testimonials[2].Role</p>
                        </div>
                    </div>
                </CardContentCn>
            </CardCn>

            @* Remaining Small Cards *@
            @foreach (var testimonial in _testimonials.Skip(3))
            {
                <CardCn Class=""sm:col-span-1 md:col-span-2 transition-all hover:shadow-md"">
                    <CardContentCn Class=""p-6"">
                        <div class=""mb-3 flex items-center gap-1"">
                            @for (var i = 0; i < testimonial.Rating; i++)
                            {
                                <LucideStarCn class=""h-3 w-3 fill-yellow-400 text-yellow-400"" />
                            }
                        </div>
                        <p class=""text-foreground/90 mb-4 text-sm"">""@testimonial.Quote""</p>
                        <div class=""flex items-center gap-2"">
                            <AvatarCn Class=""h-8 w-8"">
                                <AvatarImageCn Alt=""@testimonial.Name"" Src=""@testimonial.Image"" />
                                <AvatarFallbackCn Class=""text-xs"">@GetInitials(testimonial.Name)</AvatarFallbackCn>
                            </AvatarCn>
                            <div>
                                <p class=""text-xs font-semibold"">@testimonial.Name</p>
                                <p class=""text-muted-foreground text-xs"">@testimonial.Role</p>
                            </div>
                        </div>
                    </CardContentCn>
                </CardCn>
            }
        </div>
    </div>
</section>

