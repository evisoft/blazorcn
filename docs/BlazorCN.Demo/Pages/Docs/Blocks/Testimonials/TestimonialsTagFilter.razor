@* ============================================================
   Block: testimonials-tag-filter
   Title: TestimonialsTagFilter
   Description: A high-density testimonials masonry wall block for React and Next.js with a multi-column layout, variable card heights, sparse star accents, and staggered cascade animations built with motion/react, shadcn/ui, and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-tag-filter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer reviews
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Loved by teams who ship.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Nine voices from nine teams in nine time zones. Every quote is real, every metric is
                specific, every person signed off on being named.
            </p>
        </div>

        @* Masonry wall *@
        <div class="mt-12 columns-1 gap-4 sm:columns-2 lg:columns-3">
            @foreach (var t in _testimonials)
            {
                <figure class="mb-4 break-inside-avoid rounded-xl border bg-card p-5">
                    @if (t.Starred)
                    {
                        <div role="img" aria-label="5 out of 5 stars" class="mb-3 flex items-center gap-0.5">
                            @for (var j = 0; j < 5; j++)
                            {
                                <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" />
                            }
                        </div>
                    }
                    <blockquote class="text-sm leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-4 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role &middot; @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">Read all stories</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote, bool Starred = false);

