@* ============================================================
   Block: testimonials-truncated
   Title: TestimonialsTruncated
   Description: A two-column expandable testimonial card grid for React and Next.js with line-clamp preview, read-more toggle, marketing-scale quotes, and ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-truncated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Read the full stories.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Tap any card to expand the full quote. Four engineers, four different migrations, four
                reasons they kept the switch.
            </p>
        </div>

        @* Expandable card grid *@
        <div class="mt-12 grid gap-6 sm:grid-cols-2">
            @foreach (var testimonial in _testimonials)
            {
                var t = testimonial;
                var isExpanded = _expandedId == t.Id;
                <figure class="flex h-full flex-col rounded-2xl border bg-card p-6">
                    <blockquote class="@Cn.Merge("flex-1 text-lg font-medium leading-relaxed text-foreground", isExpanded ? "" : "line-clamp-3")">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <button type="button"
                            @onclick="@(() => SetExpanded(t.Id, isExpanded))"
                            aria-expanded="@(isExpanded ? "true" : "false")"
                            class="mt-3 self-start text-xs font-semibold text-foreground underline-offset-4 hover:underline">
                        @(isExpanded ? "Show less" : "Read more")
                    </button>
                    <figcaption class="mt-6 flex items-center gap-3 border-t pt-5">
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span aria-hidden="true"
                                  class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TruncatedTestimonial(
        string Id,
        string Quote,
        string Name,
        string Initials,
        string Role,
        string Company
    );

    private static readonly TruncatedTestimonial[] _testimonials =
    [
        new("tt-1",
            "We migrated our entire design system in three weeks. Every component was drop-in compatible with our Tailwind config, and TypeScript caught integration issues before they reached production. Our frontend velocity has been consistently higher ever since.",
            "Sarah Chen", "SC", "Head of Engineering", "Linearly"),
        new("tt-2",
            "The accessibility defaults alone justified the switch. We were burning two sprints a quarter on audit remediation, and that dropped to zero after adoption. Screen reader support, keyboard navigation, and focus management all work out of the box.",
            "Daniel Park", "DP", "Staff Engineer", "Northwind"),
        new("tt-3",
            "Onboarding time for new engineers went from two weeks to two days. Junior devs ship production features in their first week now. I have not had to repeat myself in a code review since we made the switch.",
            "Mia Johnson", "MJ", "Engineering Manager", "Halide Inc."),
        new("tt-4",
            "We evaluated eight component libraries before choosing this one. Six months later, not a single engineer has complained about the choice — a first for any tooling decision we have made in my time here.",
            "Alex Rivera", "AR", "CTO", "Voltaware"),
    ];

    private string? _expandedId = null;

    private void SetExpanded(string id, bool isExpanded)
    {
        _expandedId = isExpanded ? null : id;
    }
}
