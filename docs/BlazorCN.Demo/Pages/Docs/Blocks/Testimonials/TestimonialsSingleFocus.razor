@* ============================================================
   Block: testimonials-single-focus
   Title: TestimonialsSingleFocus
   Description: A featured hero testimonial block for React and Next.js with an oversized single quote, large portrait avatar, credibility line, and dual CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-single-focus.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="font-medium text-muted-foreground text-xs uppercase tracking-widest">
                Customer stories
            </p>
            <h2 class="mt-3 font-bold text-3xl tracking-tight sm:text-4xl lg:text-5xl">
                Built for teams who ship.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base text-muted-foreground leading-relaxed">
                Hear from the engineers and product leaders who chose our platform after a year running
                it in production.
            </p>
        </div>

        @* Featured hero card *@
        <figure class="relative mt-12 overflow-hidden rounded-2xl border bg-card p-10 sm:p-14">
            <span
                aria-hidden="true"
                class="absolute -top-8 left-6 font-serif text-[140px] leading-none text-muted-foreground/15 sm:-top-12 sm:left-10 sm:text-[180px]"
            >
                &ldquo;
            </span>

            <div
                role="img"
                aria-label="5 out of 5 stars"
                class="relative flex items-center gap-0.5"
            >
                @foreach (var i in _stars)
                {
                    <LucideIconCn Name="star" Size="16" aria-hidden="true" Class="size-4 fill-amber-500 text-amber-500" />
                }
            </div>

            <blockquote class="relative mt-6 font-semibold text-2xl text-foreground leading-[1.15] tracking-tight sm:text-3xl lg:text-4xl">
                @_testimonial.Quote
            </blockquote>

            <figcaption class="relative mt-10 flex items-center gap-4">
                <div class="relative size-16 shrink-0 overflow-hidden rounded-full border bg-muted">
                    <span class="absolute inset-0 flex items-center justify-center font-mono font-semibold text-muted-foreground text-sm">
                        @_testimonial.Initials
                    </span>
                </div>
                <div>
                    <p class="font-semibold text-base text-foreground">@_testimonial.Name</p>
                    <p class="text-muted-foreground text-sm">
                        @_testimonial.Role &middot; @_testimonial.Company
                    </p>
                </div>
            </figcaption>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[260px]">Read the case study</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[220px]">
                Talk to a customer
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TestimonialData(string Quote, string Name, string Initials, string Role, string Company);

    private static readonly TestimonialData _testimonial = new(
        Quote: "We shipped five years of backlog in three months. The team still debates whether it was the platform or finally having a pipeline that didn't fight us — but the numbers don't lie.",
        Name: "Catherine Whitfield",
        Initials: "CW",
        Role: "VP of Engineering",
        Company: "Liveblocks"
    );

    private static readonly int[] _stars = [0, 1, 2, 3, 4];
}
