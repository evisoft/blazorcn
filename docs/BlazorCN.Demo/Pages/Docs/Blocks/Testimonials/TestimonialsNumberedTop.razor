@* ============================================================
   Block: testimonials-numbered-top
   Title: TestimonialsNumberedTop
   Description: A three-column ranked testimonials card grid for React and Next.js with oversized rank numerals, per-card star ratings, and staggered left-to-right entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-numbered-top.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Top three
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Hand-picked by the teams who ship with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Three quotes from 1,200 verified customers — chosen for what they say about the work,
                not the rating.
            </p>
        </div>

        @* Ranked grid *@
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var t in _testimonials)
            {
                <figure class="relative overflow-hidden rounded-2xl border bg-card p-6 sm:p-8">
                    @* Rank numeral *@
                    <div class="flex items-center justify-between">
                        <span role="img" aria-label="@($"Rank {t.Rank}")"
                              class="font-mono text-5xl font-bold tabular-nums leading-none text-foreground sm:text-6xl">
                            @t.Rank.ToString().PadLeft(2, '0')
                        </span>
                        <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                            @for (var s = 0; s < 5; s++)
                            {
                                <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                            }
                        </div>
                    </div>

                    <blockquote class="mt-6 text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>

                    <figcaption class="mt-6 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, int Rank, string Quote, string Name, string Initials, string Role, string Company);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", 1,
            "We cut our development cycle from weeks to days. Our first production dashboard shipped in four days — the old stack would have taken three weeks.",
            "Priya Sharma", "PS", "VP of Engineering", "Dataflow"),
        new("t2", 2,
            "Deleted 12,000 lines of custom CSS the week we migrated. My team still hasn’t written a single new component — and they don’t miss it.",
            "James Whitaker", "JW", "Lead Frontend Engineer", "Nimbus"),
        new("t3", 3,
            "Design-to-code handoff became trivial. Every component matches our Figma tokens exactly, so our last three releases landed zero visual regressions.",
            "Olivia Torres", "OT", "Head of Product Design", "Meridian"),
    ];
}
