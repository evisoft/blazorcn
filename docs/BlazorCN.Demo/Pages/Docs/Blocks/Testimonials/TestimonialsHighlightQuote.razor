@* ============================================================
   Block: testimonials-highlight-quote
   Title: TestimonialsHighlightQuote
   Description: A featured hero testimonial for React and Next.js with a huge pull quote, a highlighted key phrase, an oversized decorative quote mark, a size-16 avatar, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-highlight-quote.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                What stands out
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                One team. One result.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The story of a ten-person platform team that bet their roadmap on us — and shipped it in
                half the time.
            </p>
        </div>

        @* Featured hero figure *@
        <figure class="relative mt-12 overflow-hidden rounded-2xl border bg-card p-10 sm:p-14">
            @* Oversized decorative quote mark *@
            <span
                aria-hidden="true"
                class="pointer-events-none absolute -left-2 -top-6 select-none font-serif text-[160px] leading-none text-muted-foreground/15 sm:-left-4 sm:-top-10 sm:text-[220px]"
            >
                &ldquo;
            </span>

            <blockquote class="relative text-2xl font-semibold leading-[1.2] tracking-tight text-foreground sm:text-3xl lg:text-4xl">
                @HighlightedQuote(_featured.Quote, _featured.Highlight)
            </blockquote>

            <figcaption class="relative mt-10 flex items-center gap-4">
                <div class="relative flex size-16 shrink-0 items-center justify-center overflow-hidden rounded-full border bg-muted">
                    <span class="font-mono text-base font-semibold text-muted-foreground">
                        @_featured.Initials
                    </span>
                </div>
                <div>
                    <p class="text-base font-semibold text-foreground">@_featured.Name</p>
                    <p class="text-sm text-muted-foreground">
                        @_featured.Role &middot; @_featured.Company
                    </p>
                </div>
            </figcaption>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[260px]">
                Read the case study
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FeaturedData(string Quote, string Highlight, string Name, string Initials, string Role, string Company);

    private static readonly FeaturedData _featured = new(
        Quote: "We cut our development time in half within the first sprint. The components are production-ready out of the box, our WCAG audit passed on the first attempt, and my team stopped filing UI inconsistency bugs entirely.",
        Highlight: "cut our development time in half",
        Name: "Jordan Hayes",
        Initials: "JH",
        Role: "Head of Engineering",
        Company: "Veritas"
    );

    private static MarkupString HighlightedQuote(string text, string highlight)
    {
        var index = text.IndexOf(highlight, StringComparison.Ordinal);
        if (index == -1)
            return (MarkupString)System.Web.HttpUtility.HtmlEncode(text);

        var before = System.Web.HttpUtility.HtmlEncode(text[..index]);
        var marked = System.Web.HttpUtility.HtmlEncode(highlight);
        var after = System.Web.HttpUtility.HtmlEncode(text[(index + highlight.Length)..]);

        return (MarkupString)$"{before}<mark class=\"rounded-md bg-amber-500/15 px-1 text-foreground decoration-clone\">{marked}</mark>{after}";
    }
}
