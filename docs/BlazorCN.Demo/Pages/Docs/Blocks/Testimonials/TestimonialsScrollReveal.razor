@* ============================================================
   Block: testimonials-scroll-reveal
   Title: TestimonialsScrollReveal
   Description: A viewport-triggered scroll-reveal testimonials column for React and Next.js using motion/react whileInView with staggered fade-up reveals, large quote typography, and semantic figure markup built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-scroll-reveal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Scroll to read
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Stories from teams shipping faster.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every quote below fades in as you reach it — a short reading experience built from real
                customer conversations.
            </p>
        </div>

        <div class="mt-12 space-y-6">
            @foreach (var t in _testimonials)
            {
                <figure class="overflow-hidden rounded-2xl border bg-card p-6 sm:p-8">
                    <blockquote class="text-lg font-medium leading-relaxed text-foreground sm:text-xl">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-4">
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Quote, string Name, string Initials, string Role, string Company);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Our team was skeptical about adopting another library. Within one sprint, every engineer was sold — and the PRs that used to take days were landing in hours.", "David Fernandez", "DF", "VP of Engineering", "Loomstitch"),
        new("t2", "The Tailwind integration is not bolted on — it is fundamental. Every component composes with our utilities without a single specificity war.", "Sarah Kim", "SK", "Senior Frontend Developer", "Planetary"),
        new("t3", "We deleted three separate libraries the week we migrated. Fewer dependencies, 41% smaller bundle, and one consistent pattern across every page.", "Luca Bianchi", "LB", "Tech Lead", "Linearly"),
        new("t4", "Our designer hands off a Figma file and I ship it in hours instead of days. The component API mirrors the design structure one-to-one.", "Emma Johansson", "EJ", "Full-Stack Engineer", "Klarity"),
        new("t5", "We serve users in 40 countries. RTL, localization hooks, and accessible-by-default components made our i18n rollout a two-week project instead of two quarters.", "Omar Hassan", "OH", "Internationalization Lead", "Wayfinder"),
    ];
}
