@* ============================================================
   Block: testimonials-featured-hero
   Title: TestimonialsFeaturedHero
   Description: A featured hero single-quote testimonial block for React and Next.js with oversized decorative quote mark, marketing-scale typography, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-featured-hero.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The quote that sold our board.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                One customer. One transformative outcome. The story we tell when a prospect asks what we
                actually do for engineering teams.
            </p>
        </div>

        @* Featured Quote *@
        <figure class="relative mx-auto mt-12 overflow-hidden rounded-2xl border bg-card p-10 sm:p-14">
            @* Oversized decorative quote mark *@
            <span
                aria-hidden="true"
                class="pointer-events-none absolute -top-10 left-6 font-serif text-[180px] leading-none text-muted-foreground/15 sm:-top-16 sm:left-10 sm:text-[240px]"
            >
                &ldquo;
            </span>

            <div class="relative">
                <div
                    role="img"
                    aria-label="@($"{_featured.Rating} out of 5 stars")"
                    class="flex items-center gap-0.5"
                >
                    @foreach (var i in _stars)
                    {
                        <LucideIconCn Name="star" Size="16" aria-hidden="true" Class="size-4 fill-amber-500 text-amber-500" />
                    }
                </div>

                <blockquote class="mt-6 text-2xl font-semibold leading-[1.15] tracking-tight text-foreground sm:text-3xl lg:text-4xl">
                    @_featured.Quote
                </blockquote>

                <figcaption class="mt-10 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-foreground">@_featured.Name</p>
                        <p class="text-sm text-muted-foreground">
                            @_featured.Role &middot; @_featured.Company
                        </p>
                    </div>
                </figcaption>
            </div>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Read the case study</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FeaturedData(string Quote, string Name, string Initials, string Role, string Company, int Rating);

    private static readonly FeaturedData _featured = new(
        Quote: "We shipped five years of backlog in three months. The team still debates whether it was the platform or finally having a pipeline that didn't fight us — but the results don't lie.",
        Name: "Sarah Chen",
        Initials: "SC",
        Role: "Chief Technology Officer",
        Company: "Meridian AI",
        Rating: 5
    );

    private static readonly int[] _stars = [0, 1, 2, 3, 4];
}
