@* ============================================================
   Block: testimonials-pull-quote
   Title: TestimonialsPullQuote
   Description: A featured hero pull quote testimonials block for React and Next.js with an oversized decorative quote mark, marketing-scale serif headline typography, and a centered attribution built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-pull-quote.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Featured story
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Built for teams who ship.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                One quote from a CTO who traded a 40-person DevOps rotation for a weekend migration.
                Here is what she told us.
            </p>
        </div>

        @* Pull quote *@
        <figure class="relative mt-12 overflow-hidden rounded-2xl border bg-card p-10 text-center sm:p-14">
            <span
                aria-hidden="true"
                class="pointer-events-none absolute -top-6 left-6 select-none font-serif text-[120px] leading-none text-muted-foreground/15 sm:-top-10 sm:left-10 sm:text-[180px]"
            >
                &ldquo;
            </span>

            <blockquote class="relative text-2xl font-semibold leading-[1.15] tracking-tight text-foreground sm:text-3xl lg:text-4xl">
                @_pullQuote.Quote
            </blockquote>

            <figcaption class="relative mt-10 flex items-center justify-center gap-4">
                <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                        @_pullQuote.Initials
                    </span>
                </div>
                <div class="text-left">
                    <p class="text-base font-semibold text-foreground">@_pullQuote.Name</p>
                    <p class="text-sm text-muted-foreground">
                        @_pullQuote.Role &middot; @_pullQuote.Company
                    </p>
                </div>
            </figcaption>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[260px]">Read the case study</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record PullQuoteData(string Quote, string Name, string Initials, string Role, string Company);

    private static readonly PullQuoteData _pullQuote = new(
        Quote: "The first platform in five years my engineers chose to use on their own time. Our on-call pager rang twice last quarter — before, it rang twice a day.",
        Name: "Katherine Voss",
        Initials: "KV",
        Role: "Chief Technology Officer",
        Company: "Arclight Systems"
    );
}
