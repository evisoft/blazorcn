@* ============================================================
   Block: testimonials-keyword-bold
   Title: TestimonialsKeywordBold
   Description: A single-column testimonial list with inline bolded keywords for React and Next.js with a centered marketing headline, highlighted feature mentions, and breathing-room cards built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-keyword-bold.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                What customers highlight
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The features they won't stop talking about.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Real quotes from engineers and designers in production, with the capabilities they
                credit for their results highlighted inline.
            </p>
        </div>

        <div class="mt-12 flex flex-col gap-5">
            @foreach (var t in _testimonials)
            {
                <figure class="rounded-xl border bg-card p-6">
                    <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                        @for (var s = 0; s < 5; s++)
                        {
                            <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>
                    <blockquote class="mt-4 text-base leading-relaxed text-muted-foreground">
                        &ldquo;@HighlightKeywords(t.Quote, t.Keywords)&rdquo;
                    </blockquote>
                    <figcaption class="mt-5 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role &middot; @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote, string[] Keywords);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Sarah Mitchell", "SM", "Product Designer", "Stackline",
            "The real-time collaboration saved us six hours a week. Our design-to-code handoff is seamless now, and the TypeScript coverage caught three runtime bugs before they reached staging.",
            ["real-time collaboration", "TypeScript coverage", "design-to-code handoff"]),
        new("t2", "James Park", "JP", "Senior Engineer", "Clearpath",
            "The dark mode implementation is flawless. Every component adapts automatically, and the accessibility defaults passed our WCAG audit without a single remediation.",
            ["dark mode implementation", "accessibility defaults", "WCAG audit"]),
        new("t3", "Elena Rossi", "ER", "Tech Lead", "Nimbus",
            "Copy-paste components that actually work. The responsive layouts handled every edge case QA threw at them, and the API integration hooks saved us a full sprint.",
            ["Copy-paste components", "responsive layouts", "API integration hooks"]),
        new("t4", "Marcus Chen", "MC", "CTO", "Veritas",
            "The performance optimization is noticeable. Our bundle size dropped 40 percent after migrating, and server component support made initial loads feel instant.",
            ["performance optimization", "bundle size dropped 40 percent", "server component support"]),
    ];

    private static MarkupString HighlightKeywords(string text, string[] keywords)
    {
        if (keywords.Length == 0)
            return (MarkupString)System.Net.WebUtility.HtmlEncode(text);

        var result = new System.Text.StringBuilder();
        var remaining = text;

        while (remaining.Length > 0)
        {
            // Find the earliest keyword match (case-insensitive)
            var bestIndex = -1;
            var bestKeyword = string.Empty;
            foreach (var kw in keywords)
            {
                var idx = remaining.IndexOf(kw, System.StringComparison.OrdinalIgnoreCase);
                if (idx >= 0 && (bestIndex < 0 || idx < bestIndex))
                {
                    bestIndex = idx;
                    bestKeyword = remaining.Substring(idx, kw.Length);
                }
            }

            if (bestIndex < 0)
            {
                result.Append(System.Net.WebUtility.HtmlEncode(remaining));
                break;
            }

            // Append text before the match
            if (bestIndex > 0)
                result.Append(System.Net.WebUtility.HtmlEncode(remaining.Substring(0, bestIndex)));

            // Append the bolded keyword
            result.Append("<span class=\"font-semibold text-foreground\">");
            result.Append(System.Net.WebUtility.HtmlEncode(bestKeyword));
            result.Append("</span>");

            remaining = remaining.Substring(bestIndex + bestKeyword.Length);
        }

        return (MarkupString)result.ToString();
    }
}
