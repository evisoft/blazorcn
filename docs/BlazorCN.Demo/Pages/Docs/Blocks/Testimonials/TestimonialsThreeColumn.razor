@* ============================================================
   Block: testimonials-three-column
   Title: TestimonialsThreeColumn
   Description: A three-column testimonial card grid for React and Next.js with marketing-scale headline, semantic figure blockquotes, avatar attribution atoms, and ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-three-column.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The teams shipping with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From two-person startups to public companies, here&rsquo;s what engineers say after a year in
                production with our platform.
            </p>
        </div>

        @* Three column card grid *@
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var t in _testimonials)
            {
                <figure class="flex h-full flex-col rounded-2xl border bg-card p-6">
                    <blockquote class="flex-1 text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span aria-hidden="true"
                                  class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Sarah Chen", "SC", "Head of Engineering", "Linearly",
            "We shipped five years of backlog in three months. The pipeline finally stopped fighting us and the results are undeniable."),
        new("t2", "Marcus Rivera", "MR", "Staff Engineer", "Northwind",
            "Cut our p99 from 900ms to 80ms in a weekend migration. The rollback plan never left the doc."),
        new("t3", "Emi Takeda", "ET", "Design Systems Lead", "Halide Inc.",
            "Migrating our design system took two weeks instead of the projected two months. Zero breaking changes after 14 months in production."),
        new("t4", "David Park", "DP", "CTO", "Voltaware",
            "Junior devs ship with the same quality as staff engineers now. Code review comments dropped 60% in the first sprint."),
        new("t5", "Aisha Patel", "AP", "VP of Platform", "Mori Labs",
            "Our on-call pager rang twice last quarter. Before we switched, it rang twice a day. I haven't been called at 3am once this year."),
        new("t6", "Tomás Alvarado", "TA", "Frontend Lead", "Beacon",
            "Replaced three separate libraries with one and the ROI paid for itself in the first week. I stopped writing YAML entirely."),
    ];
}
