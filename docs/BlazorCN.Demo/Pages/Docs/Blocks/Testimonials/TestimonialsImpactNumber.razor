@* ============================================================
   Block: testimonials-impact-number
   Title: TestimonialsImpactNumber
   Description: An asymmetric bento testimonial grid for React and Next.js with a featured metric hero, three supporting metric cards, tabular numerals, and marketing-scale typography built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-impact-number.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Measured impact
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The numbers don&rsquo;t lie.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every metric below was pulled from a real production deployment. Nobody rounded up.
                Nobody had to.
            </p>
        </div>

        @* Bento grid *@
        <div class="mt-12 grid gap-4 sm:grid-cols-3 sm:grid-rows-2">
            @* Featured *@
            <figure class="flex flex-col justify-between rounded-2xl border bg-card p-8 sm:col-span-2 sm:row-span-2 sm:p-10">
                <div>
                    <div class="flex items-center gap-0.5" role="img" aria-label="5 out of 5 stars">
                        @for (var i = 0; i < 5; i++)
                        {
                            <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>
                    <p class="mt-6 text-5xl font-bold tabular-nums tracking-tight text-foreground sm:text-6xl">
                        @_featured.Metric
                    </p>
                    <p class="mt-2 text-sm font-medium uppercase tracking-wider text-muted-foreground">
                        @_featured.MetricLabel
                    </p>
                    <blockquote class="mt-8 text-xl font-medium leading-relaxed text-foreground sm:text-2xl">
                        &ldquo;@_featured.Quote&rdquo;
                    </blockquote>
                </div>
                <figcaption class="mt-10 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-foreground">@_featured.Name</p>
                        <p class="text-sm text-muted-foreground">
                            @_featured.Role · @_featured.Company
                        </p>
                    </div>
                </figcaption>
            </figure>

            @* Trio *@
            @foreach (var t in _trio)
            {
                <figure class="flex flex-col justify-between rounded-xl border bg-card p-6">
                    <div>
                        <p class="text-3xl font-bold tabular-nums tracking-tight text-foreground">
                            @t.Metric
                        </p>
                        <p class="mt-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            @t.MetricLabel
                        </p>
                        <blockquote class="mt-4 text-base leading-relaxed text-foreground">
                            &ldquo;@t.Quote&rdquo;
                        </blockquote>
                    </div>
                    <figcaption class="mt-5 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TestimonialItem(string Id, string Name, string Role, string Company, string Initials, string Metric, string MetricLabel, string Quote);

    private static readonly TestimonialItem[] _testimonials =
    [
        new("t1", "Elena Volkov", "VP Engineering", "Catalyst", "EV", "40%", "shorter CI builds",
            "Our CI pipeline went from 18 minutes to under 11 in a single afternoon. The tree-shakeable components cut our bundle by 240kb and the build graph finally stopped fighting us."),
        new("t2", "Nathan Brooks", "CTO", "Clearpoint", "NB", "3x", "faster feature velocity",
            "We shipped 14 features last quarter. The quarter before switching we shipped five."),
        new("t3", "Priya Sharma", "Head of Product", "Skyline", "PS", "$2M", "saved in annual eng costs",
            "We reallocated three frontend engineers to product work the month we adopted this."),
        new("t4", "Michael Torres", "Engineering Manager", "Vertex", "MT", "10hrs", "saved per dev per week",
            "Ten fewer hours per engineer per week on UI plumbing. That is a whole headcount we got back."),
    ];

    private static readonly TestimonialItem _featured = _testimonials[0];
    private static readonly TestimonialItem[] _trio = _testimonials[1..];
}
