@* ============================================================
   Block: testimonials-with-cta
   Title: TestimonialsWithCta
   Description: A conversion-focused testimonials block for React and Next.js pairing two anchor quotes with a prominent headline CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-with-cta.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Loved by engineering teams
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Ship faster. Starting today.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Two quotes from the teams who switched last quarter — and the button below is the same
                one they clicked to get started.
            </p>
        </div>

        @* Two anchor testimonials *@
        <div class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2">
            @foreach (var t in _testimonials)
            {
                <figure class="rounded-xl border bg-card p-6">
                    <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                        @for (var s = 0; s < 5; s++)
                        {
                            <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>
                    <blockquote class="mt-3 text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-5 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role &middot; @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* Featured CTA panel *@
        <div class="mt-8 overflow-hidden rounded-2xl border bg-card p-10 sm:p-14">
            <div class="mx-auto max-w-2xl text-center">
                <h3 class="text-2xl font-bold tracking-tight sm:text-3xl">
                    Join thousands of teams shipping faster.
                </h3>
                <p class="mx-auto mt-3 max-w-lg text-base leading-relaxed text-muted-foreground">
                    Start building with production-ready components today. No credit card required, no
                    trial countdown, no surprise invoices.
                </p>
                <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
                    <ButtonCn Class="w-full sm:w-[220px]">
                        Get started free
                        <LucideIconCn Name="arrow-right" Size="16" Class="ml-1.5 size-4" aria-hidden="true" />
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">
                        Book a demo
                    </ButtonCn>
                </div>
                <p class="mt-4 text-xs text-muted-foreground">
                    Free tier available &middot; No credit card required
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly Testimonial[] _testimonials =
    [
        new("cta1", "Elena Vasquez", "EV", "Head of Product", "Streamline",
            "We launched our new product in half the time. The component quality meant fewer design revisions and zero accessibility bugs at launch."),
        new("cta2", "Ben Archer", "BA", "Senior Developer", "Pulsewave",
            "Replaced our entire custom component library in two sprints. The team went from fighting CSS to shipping features — productivity gains were measurable from week one."),
    ];
}
