@* ============================================================
   Block: testimonials-company-logos
   Title: TestimonialsCompanyLogos
   Description: A logo wall and quote split testimonials block for React and Next.js with featured customer quote, company logo grid, trust chrome, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-company-logos.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted by leading teams
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The companies building with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From Series A startups to public companies, engineering teams bet their roadmap on our
                platform every day.
            </p>
        </div>

        @* Quote + logo grid *@
        <div class="mt-12 grid gap-10 rounded-2xl border bg-card p-8 sm:p-10 lg:grid-cols-2 lg:gap-16">
            @* Quote side *@
            <figure>
                <span aria-hidden="true" class="block font-serif text-7xl leading-none text-muted-foreground/20 sm:text-8xl">
                    &ldquo;
                </span>
                <blockquote class="-mt-6 text-xl font-semibold leading-[1.25] text-foreground sm:text-2xl">
                    @_featured.Quote
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-4">
                    <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-foreground">@_featured.Name</p>
                        <p class="text-sm text-muted-foreground">
                            @_featured.Role · @_featured.Company
                        </p>
                    </div>
                </figcaption>
            </figure>

            @* Logo grid *@
            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4">
                @foreach (var company in _companies)
                {
                    <div class="flex h-20 items-center justify-center rounded-lg border bg-background px-4">
                        <div class="flex items-center gap-2 opacity-70 transition-opacity hover:opacity-100">
                            <div aria-hidden="true" class="size-5 rounded bg-muted-foreground/40"></div>
                            <span class="text-sm font-semibold tracking-tight text-foreground">
                                @company
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Join these teams</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">
                Talk to sales
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FeaturedTestimonial(string Quote, string Name, string Initials, string Role, string Company);

    private static readonly string[] _companies =
    [
        "Linearly",
        "Northwind",
        "Halide Inc.",
        "Voltaware",
        "Mori Labs",
        "Atlas Forge",
        "Helios",
        "Planetwise",
    ];

    private static readonly FeaturedTestimonial _featured = new(
        "We rolled this out across our entire frontend team in under a week. The component quality matches our internal design system standards, and it cut our UI development time in half.",
        "David Park",
        "DP",
        "VP of Engineering",
        "Linearly"
    );
}
