@* ============================================================
   Block: testimonials-filterable
   Title: TestimonialsFilterable
   Description: A role-filterable testimonial card grid for React and Next.js with animated category tabs, AnimatePresence layout transitions, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-filterable.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Loved across roles
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Find a voice that sounds like yours.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Filter by role and read what engineers, designers, and managers actually say after a
                year in production.
            </p>
        </div>

        @* Filter pills *@
        <div class="mt-10 flex flex-wrap items-center justify-center gap-2">
            @foreach (var cat in _categories)
            {
                var category = cat;
                var isActive = _active == category;
                <button
                    type="button"
                    aria-pressed="@isActive"
                    @onclick="@(() => _active = category)"
                    class="@Cn.Merge("rounded-full border px-4 py-1.5 text-sm font-medium transition-colors", isActive ? "border-foreground bg-foreground text-background" : "border-border bg-card text-muted-foreground hover:text-foreground")">
                    @category
                </button>
            }
        </div>

        @* Card Grid *@
        <div class="mt-8 grid gap-6 sm:grid-cols-2">
            @foreach (var t in _filtered)
            {
                <figure class="overflow-hidden rounded-xl border bg-card p-6">
                    <blockquote class="text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-5 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role &middot; @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Category, string Quote);

    private static readonly string[] _categories = ["All", "Developers", "Designers", "Managers"];

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Alex Rivera", "AR", "Senior Frontend Engineer", "Vercel", "Developers",
            "We replaced 11,000 lines of custom component code in a single afternoon. The diff was beautiful."),
        new("t2", "Maya Patel", "MP", "Design Lead", "Figma", "Designers",
            "I stopped filing spacing bugs. In six months, zero tickets. Before, we had twelve a sprint."),
        new("t3", "James O'Brien", "JO", "Engineering Manager", "Stripe", "Managers",
            "Our frontend velocity doubled in Q1. My team spends time on product now, not reinventing primitives."),
        new("t4", "Lisa Chen", "LC", "Full-Stack Developer", "Linear", "Developers",
            "Copy, paste, ship. No framework lock-in. I migrated three apps in a weekend without a single regression."),
        new("t5", "Daniel Kim", "DK", "Product Designer", "Raycast", "Designers",
            "Our tokens mapped over in under an hour. The brand guidelines page looks the same but the code is half the size."),
        new("t6", "Rachel Torres", "RT", "VP of Product", "Notion", "Managers",
            "Cut design-to-production handoff by 70%. QA caught zero consistency bugs last quarter — that's a first."),
        new("t7", "Tom Nakamura", "TN", "Staff Engineer", "Supabase", "Developers",
            "Passed our WCAG 2.2 AA audit on the first attempt. Saved us roughly three months of remediation work."),
        new("t8", "Sophia Grant", "SG", "Head of Design", "Dub", "Designers",
            "We went from 200 inconsistent patterns to a cohesive library in one sprint. My designers sleep again."),
    ];

    private string _active = "All";

    private Testimonial[] _filtered => _active == "All"
        ? _testimonials
        : _testimonials.Where(t => t.Category == _active).ToArray();
}
