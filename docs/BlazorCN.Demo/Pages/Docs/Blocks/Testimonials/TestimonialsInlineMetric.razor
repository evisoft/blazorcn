@* ============================================================
   Block: testimonials-inline-metric
   Title: TestimonialsInlineMetric
   Description: A stacked list of testimonials for React and Next.js with bold highlighted metrics embedded directly inside each quote, marketing-scale type, and verified attribution atoms built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-inline-metric.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Results in their words
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Numbers the team actually cares about.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every quote below came with receipts. The highlighted phrase is the metric the customer
                brought to the call.
            </p>
        </div>

        @* Stacked quote cards *@
        <div class="mt-12 space-y-5">
            @foreach (var t in _testimonials)
            {
                <figure class="rounded-2xl border bg-card p-6 sm:p-8">
                    <blockquote class="text-lg font-medium leading-relaxed text-foreground sm:text-xl">
                        &ldquo;@t.Before
                        <span class="rounded bg-amber-500/15 px-1.5 py-0.5 font-semibold text-foreground">
                            @t.Metric
                        </span>
                        @t.After&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-4">
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[260px]">
                Read the case study
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Role, string Company, string Initials, string Before, string Metric, string After);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Rebecca Torres", "VP Engineering", "Meridian", "RT",
            "After migrating our design system, we",
            "reduced frontend build time by 62%",
            "and cut cross-team design reviews from weeks to days."),
        new("t2", "Aiden Park", "CTO", "Stackwise", "AP",
            "Our team",
            "shipped 3x faster",
            "in the first quarter. The pre-built patterns deleted most of our custom UI work entirely."),
        new("t3", "Natasha Okonkwo", "Head of Product", "Lumina", "NO",
            "Customer satisfaction scores",
            "jumped from 72 to 91",
            "within two months of launching the redesigned dashboard with these components."),
        new("t4", "Marcus Lindgren", "Engineering Manager", "Covalent", "ML",
            "We",
            "cut onboarding time by 40%",
            "for new frontend engineers. The consistent patterns made the codebase immediately approachable."),
    ];
}
