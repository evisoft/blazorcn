@* ============================================================
   Block: testimonials-photo-placeholder
   Title: TestimonialsPhotoPlaceholder
   Description: A split panel testimonial block for React and Next.js pairing a full-bleed portrait placeholder with a marketing-scale quote, star rating, and attribution built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-photo-placeholder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The teams shipping with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                One engineer, one quote, and the story of a platform migration that stopped costing
                weekends.
            </p>
        </div>

        @* Split panel *@
        <figure class="mt-12 grid grid-cols-1 overflow-hidden rounded-2xl border bg-card lg:grid-cols-2">
            @* Portrait placeholder *@
            <div aria-hidden="true" class="relative aspect-[4/5] w-full overflow-hidden bg-muted lg:aspect-auto">
                <div class="absolute inset-0 bg-gradient-to-br from-muted via-muted to-muted/30"></div>
                <div
                    class="absolute inset-0 opacity-30"
                    style="background-image:radial-gradient(circle at 30% 40%, var(--muted-foreground) 1px, transparent 1px);background-size:12px 12px;">
                </div>
                <div class="absolute bottom-4 left-4 rounded-md border bg-card/90 px-3 py-2 backdrop-blur">
                    <p class="text-sm font-semibold">@_testimonial.Name</p>
                    <p class="text-xs text-muted-foreground">
                        @_testimonial.Role · @_testimonial.Company
                    </p>
                </div>
            </div>

            @* Quote panel *@
            <div class="flex flex-col justify-center p-10 sm:p-14">
                <div
                    role="img"
                    aria-label="@($"{_testimonial.Rating} out of 5 stars")"
                    class="flex items-center gap-0.5">
                    @foreach (var i in _starIndexes)
                    {
                        <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                    }
                </div>

                <blockquote class="mt-6 text-xl font-semibold leading-[1.25] tracking-tight text-foreground sm:text-2xl">
                    &ldquo;@_testimonial.Quote&rdquo;
                </blockquote>

                <figcaption class="mt-8 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                            @_testimonial.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-foreground">@_testimonial.Name</p>
                        <p class="text-sm text-muted-foreground">
                            @_testimonial.Role · @_testimonial.Company
                        </p>
                    </div>
                </figcaption>
            </div>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TestimonialData(string Id, string Quote, string Name, string Initials, string Role, string Company, int Rating);

    private static readonly TestimonialData _testimonial = new(
        Id: "t1",
        Quote: "We shipped five years of backlog in three months. I stopped counting the YAML files we deleted — it felt like the building had exhaled.",
        Name: "Sofia Andersson",
        Initials: "SA",
        Role: "Staff Engineer",
        Company: "Klarna",
        Rating: 5
    );

    private static readonly int[] _starIndexes = [0, 1, 2, 3, 4];
}
