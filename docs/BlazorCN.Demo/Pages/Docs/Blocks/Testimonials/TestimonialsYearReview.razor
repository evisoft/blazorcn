@* ============================================================
   Block: testimonials-year-review
   Title: TestimonialsYearReview
   Description: A quarterly timeline testimonial grid for React and Next.js with a year-in-review metric bar, four quarter tagged quote cards, avatar attribution, and marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-year-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_year in review
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Four quarters. One story.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every quarter a different team, a different scale, a different win. Here is how @_year
                actually went for the engineers who built on top of us.
            </p>
        </div>

        @* Metric bar *@
        <dl class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
            @foreach (var m in _metrics)
            {
                <div class="rounded-xl border bg-card px-4 py-5 text-center">
                    <dt class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                        @m.Label
                    </dt>
                    <dd class="mt-1 text-3xl font-bold tabular-nums tracking-tight text-foreground">
                        @m.Value
                    </dd>
                    <dd class="mt-0.5 text-xs text-muted-foreground">@m.Sub</dd>
                </div>
            }
        </dl>

        @* Quarter grid *@
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
            @foreach (var t in _testimonials)
            {
                <figure class="rounded-2xl border bg-card p-6">
                    <div class="flex items-center gap-2">
                        <span class="rounded-md border bg-muted px-2 py-0.5 font-mono text-xs font-semibold text-foreground">
                            @t.Quarter
                        </span>
                        <span class="text-xs text-muted-foreground">@t.Context</span>
                    </div>
                    <blockquote class="mt-4 text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-5 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role &middot; @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[230px]">Read the @_year report</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">
                Book a demo
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string _year = "2025";

    private record Metric(string Id, string Label, string Value, string Sub);

    private record QuarterTestimonial(string Id, string Quarter, string Context, string Quote,
        string Name, string Initials, string Role, string Company);

    private static readonly Metric[] _metrics =
    [
        new("m1", "Teams", "12k+", "In production"),
        new("m2", "Deploys", "4.2M", "Across the year"),
        new("m3", "Uptime", "99.99%", "Trailing twelve"),
        new("m4", "NPS", "72", "Highest ever"),
    ];

    private static readonly QuarterTestimonial[] _testimonials =
    [
        new("yr-1", "Q1", "Winter migration sprint",
            "We kicked off the year by migrating our entire product in six weeks. Best engineering decision we made all year — we haven't revisited the build system since.",
            "Akira Tanaka", "AT", "CTO", "Raycast"),
        new("yr-2", "Q2", "Spring product launch",
            "We shipped three major features in six weeks using the pre-built components. Our competitors still cannot figure out how we moved that fast.",
            "Maria Santos", "MS", "VP Product", "Resend"),
        new("yr-3", "Q3", "Peak traffic season",
            "Summer scaling stress test passed with flying colors. Our p99 stayed flat through a 14x traffic spike without a single rendering hiccup.",
            "David Okonkwo", "DO", "Staff Engineer", "Voltaware"),
        new("yr-4", "Q4", "End of year review",
            "Closed the year with our highest NPS ever. Customers called out the UI consistency unprompted in exit surveys. This library paid for itself ten times over.",
            "Elena Volkov", "EV", "Head of Design", "Halide Inc."),
    ];
}
