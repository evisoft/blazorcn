@* ============================================================
   Block: testimonials-list-detailed
   Title: TestimonialsListDetailed
   Description: A detailed testimonial review list for React and Next.js with long-form quotes, review metadata, helpfulness voting, and a centered marketing headline built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-list-detailed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Verified customer reviews
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The long story, in their words.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                These reviews are long on purpose. When a customer spends three paragraphs explaining
                what changed, we want you to hear every word.
            </p>
        </div>

        <div class="mt-12 flex flex-col gap-5">
            @foreach (var t in _testimonials)
            {
                var tItem = t;
                <figure class="rounded-xl border bg-card p-6 sm:p-8">
                    <div class="flex flex-wrap items-center justify-between gap-3">
                        <figcaption class="flex items-center gap-3">
                            <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                                <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                                    @tItem.Initials
                                </span>
                            </div>
                            <div class="min-w-0">
                                <p class="truncate text-sm font-semibold text-foreground">@tItem.Name</p>
                                <p class="truncate text-xs text-muted-foreground">
                                    @tItem.Role &middot; @tItem.Company
                                </p>
                            </div>
                        </figcaption>
                        <time class="text-xs text-muted-foreground">@tItem.Date</time>
                    </div>

                    <div role="img" aria-label="@($"{tItem.Rating} out of 5 stars")" class="mt-5 flex items-center gap-0.5">
                        @for (int i2 = 0; i2 < 5; i2++)
                        {
                            var starIndex = i2;
                            var starClass = starIndex < tItem.Rating
                                ? "size-3.5 fill-amber-500 text-amber-500"
                                : "size-3.5 text-muted-foreground/30";
                            <LucideIconCn Name="star" Size="14" aria-hidden="true" Class="@starClass" />
                        }
                    </div>

                    <blockquote class="mt-4 text-base leading-relaxed text-foreground">
                        &ldquo;@tItem.Quote&rdquo;
                    </blockquote>

                    <div class="mt-6 flex items-center gap-3 border-t pt-4">
                        <span class="text-xs text-muted-foreground">Was this helpful?</span>
                        <button type="button"
                                @onclick="@(() => HandleVote(tItem.Id, true))"
                                aria-label="@($"Mark helpful, currently {tItem.Helpful}")"
                                class="inline-flex items-center gap-1.5 rounded-md border bg-background px-2.5 py-1 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                            <LucideIconCn Name="thumbs-up" Size="14" aria-hidden="true" Class="size-3.5" />
                            @tItem.Helpful
                        </button>
                        <button type="button"
                                @onclick="@(() => HandleVote(tItem.Id, false))"
                                aria-label="@($"Mark not helpful, currently {tItem.NotHelpful}")"
                                class="inline-flex items-center gap-1.5 rounded-md border bg-background px-2.5 py-1 text-xs font-medium text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                            <LucideIconCn Name="thumbs-down" Size="14" aria-hidden="true" Class="size-3.5" />
                            @tItem.NotHelpful
                        </button>
                    </div>
                </figure>
            }
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all reviews
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Date, string Quote, int Rating, int Helpful, int NotHelpful);

    private List<Testimonial> _testimonials =
    [
        new("r1", "James Holloway", "JH", "Engineering Manager", "Veritas", "Mar 12, 2026",
            "We replaced three internal tools with this single library. The TypeScript types caught four bugs before they reached staging, and the accessibility defaults meant we passed our VPAT audit without a single remediation ticket. Our design review cycles dropped from ninety minutes to twenty.",
            5, 24, 2),
        new("r2", "Priya Kapoor", "PK", "Frontend Architect", "Nimbus", "Feb 28, 2026",
            "The best developer experience I've encountered in eight years. Copy a block, customize the tokens, ship. Our time-to-production dropped sixty percent. The responsive behavior eliminated an entire category of QA tickets for our mobile web product.",
            5, 18, 1),
        new("r3", "Daniel Okafor", "DO", "Product Lead", "Clearpath", "Feb 15, 2026",
            "Our design team stopped filing UI inconsistency bugs the week we adopted this. That alone justified the investment inside a month. The dark mode is particularly impressive — every component adapts without any additional configuration.",
            5, 31, 3),
    ];

    private void HandleVote(string id, bool helpful)
    {
        var idx = _testimonials.FindIndex(t => t.Id == id);
        if (idx < 0) return;
        var t = _testimonials[idx];
        _testimonials[idx] = helpful
            ? t with { Helpful = t.Helpful + 1 }
            : t with { NotHelpful = t.NotHelpful + 1 };
    }
}
