@* ============================================================
   Block: testimonials-tab-carousel
   Title: TestimonialsTabCarousel
   Description: A layered swipe tab carousel testimonials block for React and Next.js with category tabs, autoplay rotation, keyboard arrow navigation, real AnimatePresence card transitions, and pagination dots built with motion/react, shadcn/ui, and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-tab-carousel.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer feedback
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                What are you here for?
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Pick the thing you care about. We have a customer who already lived the answer to your
                question.
            </p>
        </div>

        @* Category tabs *@
        <div class="mt-10 flex items-center justify-center gap-2">
            @foreach (var k in _categoryKeys)
            {
                var key = k;
                <button type="button"
                        @onclick="@(() => SelectTab(key))"
                        aria-pressed="@(_tab == key ? "true" : "false")"
                        class="@Cn.Merge("rounded-full border px-5 py-2 text-sm font-medium transition-colors", _tab == key ? "border-foreground bg-foreground text-background" : "border-border bg-card text-muted-foreground hover:border-foreground/40 hover:text-foreground")">
                    @key
                </button>
            }
        </div>

        @* Carousel card *@
        <div class="relative mt-8 min-h-[320px]">
            @{
                var current = _categories[_tab][_index];
            }
            <figure class="overflow-hidden rounded-2xl border bg-card p-8 shadow-sm sm:p-10">
                <blockquote class="text-lg font-medium leading-relaxed text-foreground sm:text-xl">
                    &ldquo;@current.Quote&rdquo;
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-4">
                    <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                            @current.Initials
                        </span>
                    </div>
                    <div class="min-w-0">
                        <p class="truncate text-sm font-semibold text-foreground">@current.Name</p>
                        <p class="truncate text-xs text-muted-foreground">
                            @current.Role &middot; @current.Company
                        </p>
                    </div>
                </figcaption>
            </figure>
        </div>

        @* Pagination dots *@
        <div class="mt-6 flex items-center justify-center gap-2">
            @{
                var items = _categories[_tab];
            }
            @for (int i = 0; i < items.Length; i++)
            {
                var idx = i;
                <button type="button"
                        @onclick="@(() => _index = idx)"
                        aria-label="@($"Go to testimonial {idx + 1} of {items.Length}")"
                        aria-current="@(i == _index ? "true" : null)"
                        class="@Cn.Merge("h-1.5 rounded-full transition-all", i == _index ? "w-6 bg-foreground" : "w-1.5 bg-muted-foreground/30 hover:bg-muted-foreground/60")">
                </button>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly Dictionary<string, Testimonial[]> _categories = new()
    {
        ["Product"] =
        [
            new("p1", "Rachel Kim", "RK", "Engineering Lead", "Linearly",
                "We customized every component to our brand in under an hour. The TypeScript types caught three issues before they hit production."),
            new("p2", "David Chen", "DC", "Frontend Architect", "Northwind",
                "Zero Lighthouse regressions after integrating the full component set. Tree-shaking actually worked the way the docs said it would."),
            new("p3", "Mia Santos", "MS", "Staff Engineer", "Halide Inc.",
                "We passed our WCAG audit without writing a single extra ARIA attribute. That has never happened in my career."),
        ],
        ["Support"] =
        [
            new("s1", "Tom Brennan", "TB", "Developer", "Mori Labs",
                "Every GitHub issue gets a real response within 24 hours. The maintainers actually read the stack trace before replying."),
            new("s2", "Anika Patel", "AP", "Engineering Manager", "Voltaware",
                "Our onboarding time for new hires dropped from two weeks to three days. The docs are genuinely the gold standard."),
        ],
        ["Value"] =
        [
            new("v1", "James Okafor", "JO", "CTO", "Resend",
                "We replaced three UI libraries with this one. That saved us $2,400 a year in licenses and cut our bundle by 40%."),
            new("v2", "Elena Volkov", "EV", "VP Product", "Cal.com",
                "Our design-to-code time dropped 60%. One engineer now does in an afternoon what used to take a designer and a developer a day."),
            new("v3", "Liam Nguyen", "LN", "Founder", "Planetgrid",
                "Three of us launched looking like a team of fifty. Investors asked which agency we hired. None, we just shipped."),
        ],
    };

    private static readonly string[] _categoryKeys = ["Product", "Support", "Value"];

    private string _tab = "Product";
    private int _index = 0;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                var items = _categories[_tab];
                _index = (_index + 1) % items.Length;
                StateHasChanged();
            });
        }, null, 6000, 6000);
    }

    private void SelectTab(string key)
    {
        _tab = key;
        _index = 0;
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
