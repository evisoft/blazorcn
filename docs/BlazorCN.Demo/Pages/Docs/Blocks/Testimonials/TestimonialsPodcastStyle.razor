@* ============================================================
   Block: testimonials-podcast-style
   Title: TestimonialsPodcastStyle
   Description: A waveform audio card grid testimonials block for React and Next.js with play button chrome, static waveform visuals, marketing-scale quotes, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-podcast-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Voices from the field
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Hear it in their own words.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Three customer stories recorded this quarter, each under five minutes and all worth the
                listen.
            </p>
        </div>

        @* Grid *@
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var t in _testimonials)
            {
                <figure class="flex flex-col overflow-hidden rounded-xl border bg-card p-6">
                    @* Play row *@
                    <div class="flex items-center gap-3">
                        <button
                            type="button"
                            aria-label="@($"Listen to {t.Name}'s story")"
                            class="flex size-10 shrink-0 items-center justify-center rounded-full border bg-background transition-colors hover:bg-muted">
                            <LucideIconCn Name="play" Size="16" Class="size-4 translate-x-0.5 fill-foreground text-foreground" />
                        </button>
                        <div aria-hidden="true" class="flex flex-1 items-end gap-0.5">
                            @foreach (var h in t.WaveformHeights)
                            {
                                <div
                                    class="flex-1 rounded-sm bg-muted-foreground/30"
                                    style="@($"height:{h}px")">
                                </div>
                            }
                        </div>
                        <span class="shrink-0 font-mono text-xs tabular-nums text-muted-foreground">
                            @t.Duration
                        </span>
                    </div>

                    @* Quote *@
                    <blockquote class="mt-6 flex-1 text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>

                    @* Attribution *@
                    <figcaption class="mt-6 flex items-center gap-3">
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[270px]">Watch customer videos</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record AudioTestimonial(string Id, string Name, string Initials, string Role, string Company, string Quote, string Duration, int[] WaveformHeights);

    private static readonly AudioTestimonial[] _testimonials =
    [
        new("a1", "Alex Morgan", "AM", "Engineering Manager", "Raycast",
            "We went from prototype to production in a single sprint. I stopped scheduling infra syncs because there was nothing left to argue about.",
            "3:42",
            [4, 8, 12, 6, 16, 10, 14, 8, 18, 6, 12, 10, 8, 14, 6, 10, 16, 8, 12, 4]),
        new("a2", "Nina Patel", "NP", "Staff Designer", "Figma",
            "Our design-to-prod loop dropped from two weeks to two afternoons. Engineers stopped asking 'can we build this' and started asking 'what should we build next'.",
            "2:58",
            [6, 10, 14, 8, 12, 18, 6, 14, 10, 8, 16, 12, 6, 10, 14, 8, 12, 6, 10, 18]),
        new("a3", "Carlos Reyes", "CR", "Founding Engineer", "Arc",
            "The accessibility defaults alone saved us four months of retrofitting. Our first audit came back with zero findings — a first in my career.",
            "4:15",
            [8, 14, 6, 18, 10, 12, 8, 16, 6, 14, 10, 8, 12, 18, 6, 10, 14, 8, 16, 12]),
    ];
}
