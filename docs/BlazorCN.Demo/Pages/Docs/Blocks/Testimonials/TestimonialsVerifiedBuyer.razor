@* ============================================================
   Block: testimonials-verified-buyer
   Title: TestimonialsVerifiedBuyer
   Description: A verified-purchase testimonials block for React and Next.js with one focal review, a verified-badge credibility row, star ratings, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-verified-buyer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Verified customer reviews
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Every review tied to a real receipt.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                We only publish reviews from confirmed purchases. No incentives, no solicitations — just
                paying customers who chose to say something.
            </p>
        </div>

        @* Focal quote *@
        <figure class="mx-auto mt-10 max-w-3xl overflow-hidden rounded-2xl border bg-card">
            <div class="px-8 pt-10 pb-8 sm:px-10 sm:pt-12 sm:pb-10">
                <div class="flex flex-wrap items-center gap-3">
                    @* VerifiedBadge *@
                    <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-1">
                        <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
                        <span class="text-[11px] font-semibold text-emerald-700 dark:text-emerald-400">
                            Verified Purchase
                        </span>
                    </span>
                    <span class="text-xs text-muted-foreground">
                        @_featured.Product &middot; @_featured.PurchaseDate
                    </span>
                </div>
                <div class="mt-5">
                    @* Stars *@
                    <div role="img" aria-label="@($"{_featured.Rating} out of 5 stars")" class="flex items-center gap-0.5">
                        @foreach (var i in _starIndices)
                        {
                            <LucideIconCn Name="star" Size="14" Class="@Cn.Merge("size-3.5", i < _featured.Rating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" aria-hidden="true" />
                        }
                    </div>
                </div>
                <blockquote class="mt-5 text-xl font-medium leading-relaxed text-foreground sm:text-2xl sm:leading-[1.3]">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>
            </div>
            <figcaption class="flex items-center gap-4 border-t bg-muted/30 px-8 py-5 sm:px-10">
                <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                        @_featured.Initials
                    </span>
                </div>
                <div class="min-w-0">
                    <p class="truncate text-sm font-semibold text-foreground">@_featured.Name</p>
                    <p class="truncate text-xs text-muted-foreground">
                        @_featured.Product customer since @_featured.PurchaseDate
                    </p>
                </div>
            </figcaption>
        </figure>

        @* Supporting strip *@
        <div class="mt-6 grid gap-4 sm:grid-cols-3">
            @foreach (var review in _supporting)
            {
                <figure class="flex flex-col rounded-xl border bg-card p-5">
                    <div class="flex items-center justify-between gap-2">
                        @* VerifiedBadge *@
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/20 bg-emerald-500/10 px-2.5 py-1">
                            <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
                            <span class="text-[11px] font-semibold text-emerald-700 dark:text-emerald-400">
                                Verified Purchase
                            </span>
                        </span>
                        @* Stars *@
                        <div role="img" aria-label="@($"{review.Rating} out of 5 stars")" class="flex items-center gap-0.5">
                            @foreach (var i in _starIndices)
                            {
                                <LucideIconCn Name="star" Size="14" Class="@Cn.Merge("size-3.5", i < review.Rating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" aria-hidden="true" />
                            }
                        </div>
                    </div>
                    <blockquote class="mt-4 flex-1 text-sm leading-relaxed text-foreground">
                        &ldquo;@review.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-4 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @review.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@review.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @review.Product &middot; @review.PurchaseDate
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all reviews
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ReviewData(string Id, string Name, string Initials, string Product, string PurchaseDate, int Rating, string Quote);

    private static readonly ReviewData _featured = new(
        "r1", "Carla Mendes", "CM", "Team Plan", "Feb 14, 2026", 5,
        "We upgraded from the free tier and recovered forty hours of engineering time in the first month alone. The dashboard templates were in production the same day we signed up — our CFO asked where the savings came from before I had finished the rollout doc."
    );

    private static readonly ReviewData[] _supporting =
    [
        new("r2", "David Kwon", "DK", "Individual Plan", "Jan 28, 2026", 5,
            "Worth every penny. I shipped three client projects in the time the last one took me."),
        new("r3", "Natasha Volkov", "NV", "Organization Plan", "Mar 3, 2026", 5,
            "Rolled across four product teams in a quarter. A year of design work, compressed."),
        new("r4", "Marcus Chen", "MC", "Individual Plan", "Dec 19, 2025", 5,
            "TypeScript support is thorough and the docs are clear. My freelance velocity doubled."),
    ];

    private static readonly int[] _starIndices = [0, 1, 2, 3, 4];
}
