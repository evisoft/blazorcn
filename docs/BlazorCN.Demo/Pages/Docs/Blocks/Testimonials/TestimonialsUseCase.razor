@* ============================================================
   Block: testimonials-use-case
   Title: TestimonialsUseCase
   Description: A segmented testimonials block for React and Next.js with an audience tab switcher, animated active quote, avatar attribution, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-use-case.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        <!-- Marketing headline cluster -->
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted across every stage
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                From pre-seed to public.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The platform scales with you. Hear from the teams who know both sides of the
                startup-to-enterprise journey.
            </p>
        </div>

        <!-- Segment tabs -->
        <div class="mt-8 flex justify-center">
            <div class="inline-flex flex-wrap items-center gap-1 rounded-full border bg-card p-1">
                @foreach (var sg in _segments)
                {
                    var seg = sg;
                    var isActive = seg.Id == _activeId;
                    <button type="button"
                            aria-pressed="@(isActive ? "true" : "false")"
                            @onclick="@(() => _activeId = seg.Id)"
                            class="@Cn.Merge("flex items-center gap-2 rounded-full px-4 py-2 text-xs font-semibold transition-colors", isActive ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        <LucideIconCn Name="@seg.Icon" Size="14" Class="size-3.5" />
                        @seg.Label
                    </button>
                }
            </div>
        </div>

        <!-- Active segment testimonials -->
        @{
            var activeSeg = _segments.FirstOrDefault(s => s.Id == _activeId) ?? _segments[0];
        }
        <div class="mt-8 grid gap-5 sm:grid-cols-2">
            @foreach (var t in activeSeg.Testimonials)
            {
                <figure class="flex flex-col rounded-2xl border bg-card p-8">
                    <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                        @for (int i = 0; i < 5; i++)
                        {
                            <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" />
                        }
                    </div>
                    <blockquote class="mt-5 flex-1 text-lg font-medium leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-3">
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        <!-- CTAs -->
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">
                Talk to sales
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Role, string Company, string Initials, string Quote);

    private record Segment(string Id, string Label, string Icon, Testimonial[] Testimonials);

    private string _activeId = "startup";

    private static readonly Segment[] _segments =
    [
        new("startup", "For Startups", "rocket",
        [
            new("s1", "Kai Nakamura", "Co-founder", "Radial", "KN",
                "We went from idea to production in three weeks. As a two-person team, having production-grade components out of the box means we ship like a company ten times our size."),
            new("s2", "Lena Vargas", "CTO", "Dubb", "LV",
                "Our seed round demo was built in a weekend. Three investors asked who designed the product — it was just us and the block library."),
        ]),
        new("enterprise", "For Enterprise", "building",
        [
            new("e1", "Michael Torres", "VP Engineering", "Helix CRM", "MT",
                "Rolled out a unified design system across 14 product teams in two months instead of the projected year. Compliance and accessibility were built in from day one."),
            new("e2", "Sarah Lindqvist", "Director of Platform", "Northbound", "SL",
                "Procurement approved in record time. Our security audit passed on the first review, which is the first time that has happened to any vendor in my five years here."),
        ]),
    ];
}
