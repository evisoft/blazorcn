@* ============================================================
   Block: testimonials-search
   Title: TestimonialsSearch
   Description: A six-card testimonial grid for React and Next.js with marketing-scale headline, semantic figure and blockquote markup, star ratings, and staggered reveal animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-search.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Built for teams who ship.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Six quotes from the engineers and designers who use our components in production every
                day.
            </p>
        </div>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var t in _testimonials)
            {
                <figure class="flex flex-col overflow-hidden rounded-xl border bg-card p-6">
                    <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                        @for (var s = 0; s < 5; s++)
                        {
                            <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>
                    <blockquote class="mt-4 flex-1 text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Olivia Martinez", "OM", "Frontend Lead", "Raylight",
            "We rebuilt our entire settings panel in a weekend using these blocks. The result looks better than the custom implementation we spent three months on."),
        new("t2", "James Thornton", "JT", "CTO", "Dublet",
            "TypeScript support is first-class. Every prop is typed, every callback documented — our code review time dropped by half the week we adopted it."),
        new("t3", "Priya Sharma", "PS", "Design Engineer", "Resendr",
            "Accessibility out of the box was the deciding factor. We passed our WCAG 2.1 AA audit without writing a single custom ARIA attribute."),
        new("t4", "Daniel Park", "DP", "Senior Developer", "Clerks",
            "We customized the entire color system in one tailwind.config change and every component picked it up instantly. Zero theme regressions."),
        new("t5", "Sofia Andersson", "SA", "Product Engineer", "Calendr",
            "Shipping landing pages went from a two-week sprint to a two-day task. The hero and pricing blocks alone saved us dozens of engineering hours."),
        new("t6", "Liam O'Brien", "LO", "Engineering Manager", "Baselayer",
            "Our design team prefers these components over Figma mockups now. Code-first with live preview changed our entire handoff workflow."),
    ];
}
