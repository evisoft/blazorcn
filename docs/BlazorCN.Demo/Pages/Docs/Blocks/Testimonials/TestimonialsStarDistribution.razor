@* ============================================================
   Block: testimonials-star-distribution
   Title: TestimonialsStarDistribution
   Description: A star rating distribution credibility testimonials block for React and Next.js with an animated horizontal bar chart, featured quote, verified badge, and ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-star-distribution.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="font-medium text-muted-foreground text-xs uppercase tracking-widest">
                Trusted by 1,737 engineers
            </p>
            <h2 class="mt-3 font-bold text-3xl tracking-tight sm:text-4xl lg:text-5xl">
                The shape of the feedback.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base text-muted-foreground leading-relaxed">
                A single average hides everything. Here is the full distribution — every star, every
                review, nothing filtered.
            </p>
        </div>

        @* Distribution panel *@
        <div class="mt-12 overflow-hidden rounded-2xl border bg-card">
            <div class="grid gap-8 p-8 sm:grid-cols-[auto_1fr] sm:gap-10 sm:p-10">
                @* Average score *@
                <div class="flex flex-col items-center justify-center text-center sm:border-r sm:pr-10">
                    <span class="font-bold text-5xl tabular-nums tracking-tight sm:text-6xl">
                        @_average
                    </span>
                    <div class="mt-3 flex items-center gap-0.5"
                         role="img"
                         aria-label="@($"{_average} out of 5 stars")">
                        @foreach (var i in _starIndices)
                        {
                            <LucideIconCn Name="star" Size="16"
                                          Class="@Cn.Merge("size-4", i < (int)Math.Round(_average) ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")"
                                          aria-hidden="true" />
                        }
                    </div>
                    <p class="mt-2 text-muted-foreground text-xs">
                        @_totalReviews.ToString("N0") reviews
                    </p>
                </div>

                @* Distribution bars *@
                <div class="space-y-3">
                    @foreach (var row in _distribution)
                    {
                        <div class="flex items-center gap-3">
                            <span class="w-12 text-right font-medium text-muted-foreground text-xs">
                                @row.Stars star
                            </span>
                            <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-amber-500" style="@($"width:{row.Percentage}%")"></div>
                            </div>
                            <span class="w-10 text-right font-semibold text-foreground text-xs tabular-nums">
                                @(row.Percentage)%
                            </span>
                            <span class="w-14 text-right text-muted-foreground text-xs tabular-nums">
                                @row.Count.ToString("N0")
                            </span>
                        </div>
                    }
                </div>
            </div>

            @* Featured quote *@
            <figure class="border-t bg-muted/30 p-8 sm:p-10">
                <div class="inline-flex items-center gap-1.5 rounded-full border bg-emerald-500/10 px-2.5 py-1">
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                    <span class="font-medium text-emerald-700 text-xs dark:text-emerald-400">
                        Verified customer
                    </span>
                </div>
                <blockquote class="mt-5 font-medium text-foreground text-lg leading-relaxed sm:text-xl">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>
                <figcaption class="mt-6 flex items-center gap-4">
                    <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono font-semibold text-muted-foreground text-sm">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="font-semibold text-foreground text-sm">@_featured.Name</p>
                        <p class="text-muted-foreground text-xs">
                            @_featured.Role · @_featured.Company
                        </p>
                    </div>
                </figcaption>
            </figure>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all reviews
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record DistributionRow(int Stars, int Count, int Percentage);

    private record FeaturedPerson(string Name, string Initials, string Role, string Company, string Quote);

    private const double _average = 4.6;
    private const int _totalReviews = 1737;

    private static readonly DistributionRow[] _distribution =
    [
        new(5, 1247, 72),
        new(4, 318, 18),
        new(3, 112, 6),
        new(2, 43, 3),
        new(1, 17, 1),
    ];

    private static readonly FeaturedPerson _featured = new(
        "Marcus Okonkwo",
        "MO",
        "Staff Engineer",
        "Northwind",
        "We read every one-star review before switching, then bought it anyway. Six months in: our on-call pager rang twice last quarter. Before: twice a day."
    );

    private static readonly int[] _starIndices = [0, 1, 2, 3, 4];
}
