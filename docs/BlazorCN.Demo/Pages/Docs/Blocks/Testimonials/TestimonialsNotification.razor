@* ============================================================
   Block: testimonials-notification
   Title: TestimonialsNotification
   Description: A Slack-style conversation thread testimonials block for React and Next.js with stacked message cards, colored status dots, timestamps, and staggered cascade animation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-notification.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer channel
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                What teams say in private.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Real messages from the customer channel where engineers brag about their latest ship —
                posted with permission.
            </p>
        </div>

        @* Thread *@
        <div class="mt-12 overflow-hidden rounded-2xl border bg-card">
            @* Channel header *@
            <div class="flex items-center justify-between border-b bg-muted/30 px-5 py-4">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="hash" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-mono text-sm font-semibold text-foreground">customer-love</span>
                </div>
                <span class="text-xs text-muted-foreground">@_messages.Length messages</span>
            </div>

            @* Messages *@
            <div class="divide-y">
                @foreach (var msg in _messages)
                {
                    <figure class="flex gap-4 px-5 py-5 transition-colors hover:bg-muted/30">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @msg.Initials
                            </span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
                                <p class="text-sm font-semibold text-foreground">@msg.Name</p>
                                <span aria-hidden="true" class="@($"size-1.5 rounded-full {msg.Dot}")"></span>
                                <span class="font-mono text-xs text-muted-foreground">@@msg.Username</span>
                                <span class="font-mono text-xs text-muted-foreground">@msg.Time</span>
                            </div>
                            <blockquote class="mt-1.5 text-sm leading-relaxed text-foreground">
                                @msg.Quote
                            </blockquote>
                            <figcaption class="mt-2 flex items-center gap-2">
                                <div role="img" aria-label="@($"{msg.Rating} out of 5 stars")" class="flex items-center gap-0.5">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" />
                                    }
                                </div>
                                <span class="text-xs text-muted-foreground">
                                    @msg.Role · @msg.Company
                                </span>
                            </figcaption>
                        </div>
                    </figure>
                }
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Join the channel</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Message(
        string Id,
        string Name,
        string Username,
        string Role,
        string Company,
        string Quote,
        int Rating,
        string Initials,
        string Time,
        string Dot
    );

    private static readonly Message[] _messages =
    [
        new("n1", "Sarah Mitchell", "sarah.mitchell", "Product Designer", "Stackline",
            "just replaced our entire custom component library in a single sprint. accessibility defaults alone saved us a 3-week audit cycle.",
            5, "SM", "10:42", "bg-emerald-500"),
        new("n2", "James Park", "james.park", "Senior Engineer", "Clearpath",
            "best DX I've seen in 8 years. zero any types, every prop typed, dark mode just worked on day one.",
            5, "JP", "10:44", "bg-blue-500"),
        new("n3", "Elena Rossi", "elena.rossi", "CTO", "Nimbus",
            "we deleted 3 internal libraries the week we migrated. bundle dropped 180kb and the team ships 2x faster.",
            5, "ER", "10:47", "bg-amber-500"),
        new("n4", "Marcus Chen", "marcus.chen", "Tech Lead", "Veritas",
            "shipped a full dashboard in 4 days. would have been 3 weeks the old way. genuinely the best purchase of the quarter.",
            5, "MC", "10:51", "bg-emerald-500"),
    ];
}
