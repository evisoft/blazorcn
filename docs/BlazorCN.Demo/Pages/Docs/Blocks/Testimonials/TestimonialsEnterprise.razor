@* ============================================================
   Block: testimonials-enterprise
   Title: TestimonialsEnterprise
   Description: A testimonial card grid with a top metric bar for React and Next.js featuring four social-proof metrics, three stacked quote cards with large avatars, employee count chips, and ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-enterprise.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Enterprise customers
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Trusted at every scale.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From 500-person startups to 20,000-person enterprises — the same primitives, the same
                velocity, the same renewal rate.
            </p>
        </div>

        @* Metric bar *@
        <dl class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
            @foreach (var m in _metrics)
            {
                <div class="rounded-xl border bg-card px-5 py-5 text-center">
                    <dt class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                        @m.Label
                    </dt>
                    <dd class="mt-2 text-2xl font-bold tabular-nums tracking-tight text-foreground">
                        @m.Value
                    </dd>
                    <dd class="mt-0.5 text-xs text-muted-foreground">@m.Sub</dd>
                </div>
            }
        </dl>

        @* Card grid *@
        <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var t in _testimonials)
            {
                <figure class="flex h-full flex-col rounded-2xl border bg-card p-6">
                    <span class="inline-flex w-fit items-center rounded-full border bg-muted/50 px-2.5 py-1 text-xs font-medium text-muted-foreground">
                        @t.EmployeeCount
                    </span>
                    <blockquote class="mt-5 flex-1 text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-3 border-t pt-5">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Title &middot; @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Talk to sales</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Metric(string Id, string Label, string Value, string Sub);
    private record Testimonial(string Id, string Name, string Initials, string Title, string Company, string EmployeeCount, string Quote);

    private static readonly Metric[] _metrics =
    [
        new("m1", "Teams", "12,000+", "In production"),
        new("m2", "Retention", "98%", "Year over year"),
        new("m3", "NPS", "72", "Enterprise tier"),
        new("m4", "Support", "< 1min", "First response"),
    ];

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Richard Thornton", "RT", "VP of Engineering", "Databridge", "12,000+ employees",
            "We deployed across 14 product teams in three months. The consistency alone eliminated an entire class of cross-team integration bugs that had plagued us for years."),
        new("t2", "Catherine Wei", "CW", "Chief Technology Officer", "Nextera Systems", "8,500+ employees",
            "Security review passed on the first attempt. The accessibility compliance and zero-dependency architecture gave our infosec team confidence we rarely see from third-party libraries."),
        new("t3", "Jonathan Adebayo", "JA", "SVP of Product", "Meridian Cloud", "22,000+ employees",
            "Our dedicated support engineer resolved a complex theming issue in under two hours. That level of responsiveness is why we renewed our enterprise contract without hesitation."),
    ];
}
