@* ============================================================
   Block: testimonials-headline
   Title: TestimonialsHeadline
   Description: A three-column testimonials card grid for React and Next.js with bold summary headlines, supporting quotes, a marketing headline cluster, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-headline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer highlights
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Outcomes, in their words.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every headline is a real number from a real team. Every quote is the story behind it.
            </p>
        </div>

        @* Card grid *@
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var t in _testimonials)
            {
                <figure class="flex flex-col rounded-xl border bg-card p-6">
                    <p class="text-lg font-semibold leading-snug tracking-tight text-foreground">
                        @t.Headline
                    </p>
                    <blockquote class="mt-3 flex-1 text-base leading-relaxed text-muted-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-3">
                        <div class="relative flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-full border bg-muted">
                            <span class="font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role &middot; @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Headline, string Quote);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Rachel Nguyen", "RN", "Engineering Director", "Prism",
            "Replaced three tools in one sprint.",
            "We consolidated our button library, form system, and data table into one source of truth. Maintenance overhead dropped to near zero overnight."),
        new("t2", "Stefan Mueller", "SM", "Lead Developer", "Kinetic",
            "The TypeScript experience is unmatched.",
            "Every prop is typed, every callback is predictable. Our engineers stopped opening the docs because autocomplete tells the whole story."),
        new("t3", "Yuki Tanaka", "YT", "Design Systems Lead", "Helix",
            "Designers now ship straight to prod.",
            "Prototypes become production code without a rewrite. We eliminated an entire handoff phase from our workflow — four hours back per sprint."),
        new("t4", "Carlos Mendez", "CM", "VP Product", "Ascend",
            "Four-hour onboarding, not four weeks.",
            "New frontend engineers go from clone to first pull request in under four hours. The consistent patterns make our codebase immediately approachable."),
        new("t5", "Priya Raman", "PR", "Platform Lead", "Voltaware",
            "Cut p99 latency 91% in a weekend.",
