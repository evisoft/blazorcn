@* ============================================================
   Block: testimonials-logo-bar
   Title: TestimonialsLogoBar
   Description: A logo wall and featured quote split testimonial for React and Next.js with a centered marketing headline, single anchor quote, and a grid of customer company logos built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-logo-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted by leading teams
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The companies shipping with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Hundreds of product teams use our components in production every day. Here's one voice
                and the names you'll recognize.
            </p>
        </div>

        <div class="mt-12 grid gap-10 lg:grid-cols-2 lg:gap-16">
            <figure class="flex flex-col justify-center">
                <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                    @foreach (var i in _stars)
                    {
                        <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                    }
                </div>
                <blockquote class="mt-5 text-xl font-semibold leading-[1.25] text-foreground sm:text-2xl">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-foreground">@_featured.Name</p>
                        <p class="text-sm text-muted-foreground">
                            @_featured.Role &middot; @_featured.Company
                        </p>
                    </div>
                </figcaption>
            </figure>

            <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 lg:grid-cols-2 xl:grid-cols-4">
                @foreach (var company in _companies)
                {
                    <div class="flex h-20 items-center justify-center rounded-xl border bg-card px-4 text-sm font-semibold text-muted-foreground transition-colors hover:text-foreground">
                        @company
                    </div>
                }
            </div>
        </div>

        <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[250px]">
                Talk to a customer
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FeaturedTestimonial(string Quote, string Name, string Initials, string Role, string Company);

    private static readonly int[] _stars = [0, 1, 2, 3, 4];

    private static readonly string[] _companies =
    [
        "Linearly",
        "Northwind",
        "Halide",
        "Voltaware",
        "Mori Labs",
        "Stackline",
        "Nimbus",
        "Veritas",
    ];

    private static readonly FeaturedTestimonial _featured = new(
        "We rebuilt our entire settings interface in a single sprint. Support tickets for UI confusion dropped to near zero, and our next design review took fifteen minutes instead of two hours.",
        "Sofia Andersson",
        "SA",
        "Head of Frontend",
        "Linearly"
    );
}
