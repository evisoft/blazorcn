@* ============================================================
   Block: testimonials-conversation
   Title: TestimonialsConversation
   Description: A chat-style conversation thread testimonials block for React and Next.js with alternating message bubbles, a skeptic-to-advocate customer journey, verified badge, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-conversation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer conversation
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                From skeptic to advocate.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A real back and forth between our team and an engineering lead who had been burned by
                three previous component libraries.
            </p>
        </div>

        @* Conversation thread *@
        <figure class="mt-12 overflow-hidden rounded-2xl border bg-card">
            @* Channel header *@
            <div class="flex items-center justify-between border-b bg-muted/30 px-6 py-4">
                <div class="flex items-center gap-2">
                    <span aria-hidden="true" class="text-base font-semibold text-muted-foreground">
                        #
                    </span>
                    <span class="text-sm font-semibold text-foreground">customer-love</span>
                </div>
                <span class="text-xs text-muted-foreground">7 messages</span>
            </div>

            @* Messages *@
            <div class="flex flex-col gap-3 px-6 py-6">
                @foreach (var m in _messages)
                {
                    var isCustomer = m.Sender == "customer";
                    <div class="@(isCustomer ? "flex justify-end" : "flex justify-start")">
                        <div class="@($"max-w-[85%] rounded-2xl px-4 py-3 {(isCustomer ? "bg-foreground text-background" : "border bg-muted/50 text-foreground")}")">
                            <div class="mb-1 flex items-center gap-2 text-xs font-semibold opacity-70">
                                <span>@(isCustomer ? CustomerName : "Support team")</span>
                                <span aria-hidden="true">·</span>
                                <span class="font-normal">@m.Time</span>
                            </div>
                            <p class="text-sm leading-relaxed">@m.Text</p>
                        </div>
                    </div>
                }
            </div>

            @* Attribution *@
            <figcaption class="flex items-center gap-4 border-t bg-muted/30 px-6 py-5">
                <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                        @CustomerInitials
                    </span>
                </div>
                <div class="min-w-0 flex-1">
                    <p class="truncate text-sm font-semibold text-foreground">@CustomerName</p>
                    <p class="truncate text-xs text-muted-foreground">
                        @CustomerRole · @CustomerCompany
                    </p>
                </div>
                <span class="inline-flex items-center rounded-full border bg-emerald-500/10 px-2.5 py-1 text-xs font-medium text-emerald-700 dark:text-emerald-400">
                    Verified
                </span>
            </figcaption>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[250px]">
                Talk to a customer
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string CustomerName = "Sarah Chen";
    private const string CustomerInitials = "SC";
    private const string CustomerRole = "Engineering Lead";
    private const string CustomerCompany = "Linearly";

    private record Message(string Id, string Sender, string Text, string Time);

    private static readonly Message[] _messages =
    [
        new("m1", "customer", "Honest question: we tried three component libraries last year and none stuck. What makes this different?", "10:42"),
        new("m2", "team", "Fair. Most libraries optimize for demos, not production. We optimize for TypeScript inference, accessibility defaults, and zero-config Tailwind.", "10:43"),
        new("m3", "customer", "Our designers are picky about spacing and animation timing. They always end up overriding everything.", "10:45"),
        new("m4", "team", "Every component reads your Tailwind theme tokens natively. No overrides. The animation curves match what your designers already use in Figma.", "10:46"),
        new("m5", "customer", "We set up a pilot last week. Our junior engineer shipped a complete settings dashboard in two days. That has never happened before.", "10:52"),
        new("m6", "team", "That is the most common feedback we hear. Small API surface, large flexibility.", "10:53"),
        new("m7", "customer", "We are rolling this out across all six product teams. Our quality bar jumped overnight. Best infrastructure investment we have made this year.", "11:04"),
    ];
}
