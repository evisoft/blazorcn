@* ============================================================
   Block: testimonials-switcher
   Title: TestimonialsSwitcher
   Description: A featured hero testimonial switcher for React and Next.js with a row of author pills, oversized focal quote, active pill accent, keyboard navigation, and smooth motion/react transitions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-switcher.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Pick a story, any story.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Five engineers, five teams, one common thread. Click any name to read their story in
                full.
            </p>
        </div>

        @* Author pills *@
        <div class="mt-10 flex flex-wrap items-center justify-center gap-2">
            @foreach (var t in _testimonials)
            {
                var item = t;
                var idx = Array.IndexOf(_testimonials, item);
                <button
                    type="button"
                    @onclick="@(() => _active = idx)"
                    aria-pressed="@(idx == _active ? "true" : "false")"
                    class="@Cn.Merge("rounded-full border px-4 py-2 text-sm font-medium transition-colors", idx == _active ? "border-foreground bg-foreground text-background" : "border-border bg-card text-muted-foreground hover:border-foreground/40 hover:text-foreground")"
                >
                    @item.Name
                </button>
            }
        </div>

        @* Featured quote *@
        <div class="mt-10">
            <figure class="relative overflow-hidden rounded-2xl border bg-card p-10 sm:p-14">
                <span
                    aria-hidden="true"
                    class="absolute -top-10 -left-4 font-serif text-[140px] leading-none text-muted-foreground/15 sm:-top-14 sm:-left-6 sm:text-[180px]"
                >
                    &ldquo;
                </span>
                <blockquote class="relative text-2xl font-semibold leading-[1.2] tracking-tight text-foreground sm:text-3xl lg:text-4xl">
                    @_testimonials[_active].Quote
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                            @_testimonials[_active].Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-foreground">@_testimonials[_active].Name</p>
                        <p class="text-sm text-muted-foreground">
                            @_testimonials[_active].Role &middot; @_testimonials[_active].Company
                        </p>
                    </div>
                </figcaption>
            </figure>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Sarah Chen", "SC", "Head of Engineering", "Linearly",
            "We shipped five years of backlog in three months. Nobody on the team can agree if it was the platform or finally having a pipeline that didn't fight us."),
        new("t2", "Marcus Rivera", "MR", "Staff Engineer", "Northwind",
            "I haven't been paged at 3am once this quarter. Before switching, the pager rang twice a day. I almost don't trust it."),
        new("t3", "Emily Park", "EP", "Design Systems Lead", "Halide Inc.",
            "Our design-to-prod time went from two months to two weeks. The theming API mapped to our tokens so cleanly I thought the integration was broken."),
        new("t4", "James Okafor", "JO", "CTO", "Resend",
            "Three-person team, we ship UI that looks like it came from a team of twenty. The ROI showed up in the first week of the free trial."),
        new("t5", "Priya Gupta", "PG", "Product Engineer", "Voltaware",
            "Onboarding a new contributor used to take a week. Now it takes an afternoon. The docs are the real product."),
    ];

    private int _active = 0;
}
