@* ============================================================
   Block: testimonials-social-media
   Title: TestimonialsSocialMedia
   Description: A social-post styled testimonials grid for React and Next.js with tweet-style cards, engagement metrics, handle attribution, and responsive two-column layout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-social-media.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="font-medium text-muted-foreground text-xs uppercase tracking-widest">
                In the wild
            </p>
            <h2 class="mt-3 font-bold text-3xl tracking-tight sm:text-4xl lg:text-5xl">
                Caught them saying it.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base text-muted-foreground leading-relaxed">
                Unprompted, unpaid, unsolicited. Here&apos;s what developers post about the platform when
                they think we aren&apos;t watching.
            </p>
        </div>

        @* Posts grid *@
        <div class="mt-12 grid gap-5 md:grid-cols-2">
            @foreach (var post in _posts)
            {
                <figure class="rounded-xl border bg-card p-6">
                    @* Author row *@
                    <div class="flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono font-semibold text-muted-foreground text-xs">
                                @post.Initials
                            </span>
                        </div>
                        <figcaption class="min-w-0">
                            <p class="truncate font-semibold text-foreground text-sm">@post.Name</p>
                            <p class="truncate text-muted-foreground text-xs">@post.Handle</p>
                        </figcaption>
                    </div>

                    @* Quote *@
                    <blockquote class="mt-4 text-base text-foreground leading-relaxed">
                        @post.Quote
                    </blockquote>

                    @* Metrics *@
                    <div class="mt-5 flex items-center gap-5 border-t pt-4">
                        <div class="flex items-center gap-1.5 text-muted-foreground text-xs tabular-nums">
                            <LucideIconCn Name="heart" Size="14" Class="size-3.5" aria-hidden="true" />
                            <span>@post.Likes.ToString("N0")</span>
                        </div>
                        <div class="flex items-center gap-1.5 text-muted-foreground text-xs tabular-nums">
                            <LucideIconCn Name="repeat" Size="14" Class="size-3.5" aria-hidden="true" />
                            <span>@post.Reposts.ToString("N0")</span>
                        </div>
                    </div>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Join the community</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[210px]">
                Read all posts
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Post(string Id, string Name, string Initials, string Handle, string Quote, int Likes, int Reposts);

    private static readonly Post[] _posts =
    [
        new("p1", "Sarah Chen", "SC", "@@sarahchen_dev",
            "Migrated our entire design system in under a week. The TypeScript support is flawless and I deleted 3,400 lines of custom wrappers.",
            1247, 238),
        new("p2", "Marcus Rivera", "MR", "@@marcusrivera",
            "Shipped our landing page in a single afternoon. Our CEO thought the staging URL was a competitor's site. That's the compliment I'm stealing.",
            2189, 452),
        new("p3", "Emily Nakamura", "EN", "@@emilynaka",
            "Our team evaluated a dozen libraries. This one won on accessibility, docs, and DX. Not even close — the runner-up got two votes.",
            3412, 691),
        new("p4", "David Park", "DP", "@@dpark_eng",
            "Frontend velocity doubled after adopting this. Our junior devs ship with the same quality as seniors now. I've started trusting the review queue again.",
            956, 127),
    ];
}
