@* ============================================================
   Block: testimonials-with-metric
   Title: TestimonialsWithMetric
   Description: A metric bar testimonials grid for React and Next.js with tabular numeric proof tiles, quote cards, avatar attribution, and a marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-with-metric.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Results that compound
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The numbers teams actually report.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Real outcomes from engineering teams who shipped with us for a year. Every metric is
                paired with the voice that made it happen.
            </p>
        </div>

        @* Metric bar *@
        <dl class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
            @foreach (var m in _metrics)
            {
                <div class="rounded-xl border bg-card px-4 py-5 text-center">
                    <dt class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                        @m.Label
                    </dt>
                    <dd class="mt-1 text-3xl font-bold tabular-nums tracking-tight text-foreground">
                        @m.Value
                    </dd>
                    <dd class="mt-0.5 text-xs text-muted-foreground">@m.Sub</dd>
                </div>
            }
        </dl>

        @* Quote grid *@
        <div class="mt-6 grid gap-6 sm:grid-cols-2">
            @foreach (var t in _testimonials)
            {
                <figure class="rounded-2xl border bg-card p-6">
                    <blockquote class="text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-5 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role &middot; @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record MetricItem(string Id, string Label, string Value, string Sub);
    private record TestimonialItem(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly MetricItem[] _metrics =
    [
        new("m1", "Shipping", "40%", "Faster sprints"),
        new("m2", "Output", "3x", "More features"),
        new("m3", "CSS bugs", "-60%", "In two months"),
        new("m4", "Onboarding", "2 days", "Down from two weeks"),
    ];

    private static readonly TestimonialItem[] _testimonials =
    [
        new("t1", "Aisha Rahman", "AR", "Engineering Lead", "Veritas",
            "Our sprint velocity jumped 40% the first quarter. Engineers stopped rebuilding the same buttons and actually got to work on product."),
        new("t2", "Leo Gustafsson", "LG", "CTO", "Nimbus",
            "We shipped three complete products in the time it used to take us to ship one. The pre-built blocks erased weeks of layout work."),
        new("t3", "Priya Sharma", "PS", "Frontend Architect", "Clearpath",
            "CSS bug reports dropped 60% inside two months. An entire category of tickets just evaporated off our backlog."),
        new("t4", "James Okoro", "JO", "Engineering Manager", "Lattice",
            "New engineers are productive in two days instead of two weeks. Juniors ship meaningful features on day one now."),
    ];
}
