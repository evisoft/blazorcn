@* ============================================================
   Block: testimonials-top-rated
   Title: TestimonialsTopRated
   Description: A featured hero testimonial with aggregate rating for React and Next.js with marketing-scale quote, amber star credibility row, monospace avatar, and ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-top-rated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Top rated by engineers
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The platform they chose.
            </h2>
            <div class="mt-5 flex items-center justify-center gap-2 text-sm text-muted-foreground">
                <div
                    role="img"
                    aria-label="@($"{_averageRating} out of 5 stars")"
                    class="flex items-center gap-0.5"
                >
                    @foreach (var i in _stars)
                    {
                        <LucideIconCn Name="star" Size="16" aria-hidden="true" Class="size-4 fill-amber-500 text-amber-500" />
                    }
                </div>
                <span class="font-semibold text-foreground tabular-nums">@_averageRating</span>
                <span>&middot;</span>
                <span>@_reviewCount engineers</span>
            </div>
        </div>

        @* Featured quote *@
        <figure class="relative mt-12 rounded-2xl border bg-card p-8 sm:p-14">
            <span
                aria-hidden="true"
                class="absolute -top-6 left-6 font-serif text-8xl leading-none text-muted-foreground/25 sm:-top-10 sm:left-10 sm:text-[120px]"
            >
                &ldquo;
            </span>
            <blockquote class="relative text-2xl font-semibold leading-[1.15] tracking-tight text-foreground sm:text-3xl lg:text-4xl">
                @_featured.Quote
            </blockquote>
            <figcaption class="mt-10 flex items-center gap-4">
                <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                    <span
                        aria-hidden="true"
                        class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground"
                    >
                        @_featured.Initials
                    </span>
                </div>
                <div>
                    <p class="text-base font-semibold text-foreground">@_featured.Name</p>
                    <p class="text-sm text-muted-foreground">
                        @_featured.Role &middot; @_featured.Company
                    </p>
                </div>
            </figcaption>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all reviews
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FeaturedData(string Quote, string Name, string Initials, string Role, string Company);

    private const double _averageRating = 4.9;
    private const string _reviewCount = "2,184";

    private static readonly FeaturedData _featured = new(
        Quote: "The first platform in five years that my engineers chose to use on their own time. We replaced three libraries with one and shipped a redesigned dashboard in two weeks.",
        Name: "Rachel Kim",
        Initials: "RK",
        Role: "VP of Engineering",
        Company: "Loomline"
    );

    private static readonly int[] _stars = [0, 1, 2, 3, 4];
}
