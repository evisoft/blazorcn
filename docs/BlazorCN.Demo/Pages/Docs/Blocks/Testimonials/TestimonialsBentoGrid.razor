@* ============================================================
   Block: testimonials-bento-grid
   Title: TestimonialsBentoGrid
   Description: A bento featured-plus-trio testimonials grid for React and Next.js with an asymmetric col-span layout, one oversized featured quote, three supporting cards, star ratings, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-bento-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The teams shipping with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                One headline story. Three more reasons engineering teams don't go back.
            </p>
        </div>

        @* Bento grid *@
        <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3 sm:grid-rows-2">
            @* Featured *@
            <figure class="flex flex-col justify-between rounded-2xl border bg-card p-8 sm:col-span-2 sm:row-span-2">
                <div>
                    <div
                        role="img"
                        aria-label="@($"{_featured.Rating} out of 5 stars")"
                        class="flex items-center gap-0.5">
                        @for (var i = 0; i < _featured.Rating; i++)
                        {
                            <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>
                    <blockquote class="mt-6 text-xl font-semibold leading-[1.3] text-foreground sm:text-2xl">
                        @("\"")@_featured.Quote@("\"")
                    </blockquote>
                </div>
                <figcaption class="mt-8 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-foreground">@_featured.Name</p>
                        <p class="text-sm text-muted-foreground">
                            @_featured.Role · @_featured.Company
                        </p>
                    </div>
                </figcaption>
            </figure>

            @* Trio *@
            @foreach (var t in _trio)
            {
                <figure class="flex flex-col justify-between rounded-2xl border bg-card p-5">
                    <div>
                        <div
                            role="img"
                            aria-label="@($"{t.Rating} out of 5 stars")"
                            class="flex items-center gap-0.5">
                            @for (var si = 0; si < t.Rating; si++)
                            {
                                <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                            }
                        </div>
                        <blockquote class="mt-4 text-base leading-relaxed text-foreground">
                            @("\"")@t.Quote@("\"")
                        </blockquote>
                    </div>
                    <figcaption class="mt-5 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TestimonialData(string Id, string Name, string Initials, string Role, string Company, string Quote, int Rating, bool Featured = false);

    private static readonly TestimonialData[] _testimonials =
    [
        new("t1", "Sarah Chen", "SC", "VP of Engineering", "Meridian Labs",
            "We migrated 40 engineers to this design system in two weeks. Build times dropped 35%, our p99 dropped from 900ms to 80ms, and our designers finally speak the same language as frontend. The ROI conversation was over in the first sprint.",
            5, Featured: true),
        new("t2", "James Morton", "JM", "Lead Developer", "Stackframe",
            "Closed 47 accessibility bugs in one afternoon. That's not hyperbole — that's what the before/after Jira query returned.",
            5),
        new("t3", "Priya Sharma", "PS", "Product Designer", "Novu",
            "The design token scale ended six months of back-and-forth between design and eng. We ship in hours now, not days.",
            5),
        new("t4", "Elena Vasquez", "EV", "Frontend Architect", "Relay Health",
            "Best developer experience I've seen in eight years. Junior engineers ship production features their first week.",
            5),
    ];

    private TestimonialData _featured = _testimonials.FirstOrDefault(t => t.Featured) ?? _testimonials[0];
    private TestimonialData[] _trio = _testimonials.Where(t => t.Id != (_testimonials.FirstOrDefault(x => x.Featured) ?? _testimonials[0]).Id).ToArray();
}
