@* ============================================================
   Block: testimonials-mini-cards
   Title: TestimonialsMiniCards
   Description: A compact three-column testimonials card grid for React and Next.js with short pull-quotes, font-mono initial avatars, star ratings, and a marketing headline cluster, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-mini-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4" aria-label="Compact testimonial card grid">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                What developers are saying
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Developers who stopped yak shaving.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Short and blunt. Here&rsquo;s what engineers say after a year of shipping with the
                library in production.
            </p>
        </div>

        @* Card grid *@
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var t in _testimonials)
            {
                <figure class="flex flex-col rounded-xl border bg-card p-6">
                    <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                        @for (var j = 0; j < 5; j++)
                        {
                            <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>
                    <blockquote class="mt-4 flex-1 text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly Testimonial[] _testimonials =
    [
        new("c1", "Anna Kowalski", "AK", "Staff Engineer", "Linearly",
            "Cut our frontend build time in half. The components just work out of the box — no yak shaving."),
        new("c2", "David Lin", "DL", "Engineering Lead", "Northwind",
            "Best component library we've adopted in a decade. Onboarding new devs takes an afternoon."),
        new("c3", "Priya Raman", "PR", "Design Systems Lead", "Halide",
            "Our designers stopped filing consistency bugs. Literally zero in the last six weeks."),
        new("c4", "James Holloway", "JH", "Principal Engineer", "Voltaware",
            "TypeScript support is flawless. Zero runtime surprises in three months of production."),
        new("c5", "Chen Wei", "CW", "Frontend Lead", "Mori Labs",
            "Shipped our entire admin dashboard in two weeks. The estimate was two months."),
        new("c6", "Maria Santos", "MS", "Head of Platform", "Kestrel",
            "Accessibility defaults saved us an entire audit cycle. That alone paid for the year."),
    ];
}
