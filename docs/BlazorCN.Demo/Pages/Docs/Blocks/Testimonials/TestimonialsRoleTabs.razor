@* ============================================================
   Block: testimonials-role-tabs
   Title: TestimonialsRoleTabs
   Description: A tabbed role switcher testimonials block for React and Next.js with persona tabs, animated panel transitions, hero attribution, and a ShadcnioButton CTA pair built with shadcn/ui Tabs and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-role-tabs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        <!-- Marketing headline cluster -->
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Feedback by role
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Pick your seat at the table.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Developers, designers, product managers, and founders — each persona cares about
                different things. Hear from the people who sit in your chair.
            </p>
        </div>

        <!-- Tabs switcher -->
        <div class="mt-12">
            <div class="mx-auto grid h-auto w-full max-w-md grid-cols-4 rounded-md bg-muted p-1" role="tablist">
                @foreach (var rl in _roles)
                {
                    var role = rl;
                    <button role="tab"
                            aria-selected="@(_activeTab == role.Id ? "true" : "false")"
                            @onclick="@(() => _activeTab = role.Id)"
                            class="@Cn.Merge("inline-flex items-center justify-center rounded-sm px-3 py-1.5 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2", _activeTab == role.Id ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                        @role.Label
                    </button>
                }
            </div>

            <!-- Tab panels -->
            @foreach (var rl in _roles)
            {
                var role = rl;
                @if (_activeTab == role.Id)
                {
                    <div role="tabpanel" class="mt-8 focus-visible:outline-none">
                        <div class="grid gap-6 sm:grid-cols-2">
                            @foreach (var t in role.Testimonials)
                            {
                                <figure class="flex flex-col rounded-xl border bg-card p-6">
                                    <blockquote class="flex-1 text-base leading-relaxed text-foreground">
                                        &ldquo;@t.Quote&rdquo;
                                    </blockquote>
                                    <figcaption class="mt-6 flex items-center gap-3 border-t pt-5">
                                        <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                                @t.Initials
                                            </span>
                                        </div>
                                        <div class="min-w-0">
                                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                                            <p class="truncate text-xs text-muted-foreground">
                                                @t.Role · @t.Company
                                            </p>
                                        </div>
                                    </figcaption>
                                </figure>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        <!-- CTAs -->
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record RoleTestimonial(string Name, string Initials, string Role, string Company, string Quote);

    private record RoleEntry(string Id, string Label, RoleTestimonial[] Testimonials);

    private string _activeTab = "developer";

    private static readonly RoleEntry[] _roles =
    [
        new("developer", "Developer",
        [
            new("Alex Rivera", "AR", "Senior Engineer", "Stackwise",
                "TypeScript types are impeccable. We catch integration errors at compile time instead of in QA at 2am. The composable API feels natural."),
            new("Yuki Tanaka", "YT", "Staff Engineer", "Neonwave",
                "Stopped writing custom hooks for common patterns. Built-in state and animation utilities cover 95% of what I used to hand-roll each sprint."),
        ]),
        new("designer", "Designer",
        [
            new("Clara Mendez", "CM", "Lead Product Designer", "Figment Studio",
                "Components match our Figma designs pixel-for-pixel. Spacing, typography, color tokens — consistent across every surface in the product."),
            new("Finn Larsen", "FL", "Design Systems Lead", "Meridian Design",
                "Our design-to-dev handoff time dropped to near zero. Engineers implement mockups without a single revision. That has never happened before."),
        ]),
        new("product", "Product",
        [
            new("Priya Sharma", "PS", "Senior Product Manager", "Lumina AI",
                "Feature velocity tripled after adoption. Sprint capacity effectively doubled because engineers spend less time rebuilding UI primitives."),
            new("Jordan Blake", "JB", "Group Product Manager", "Covalent",
                "Polished defaults mean we ship features that look production-ready from the first PR. Customer feedback on UI quality jumped in one quarter."),
        ]),
        new("founder", "Founder",
        [
            new("Hannah Voss", "HV", "Co-founder & CEO", "Arclight",
