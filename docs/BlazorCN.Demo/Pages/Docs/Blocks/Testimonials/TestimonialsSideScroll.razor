@* ============================================================
   Block: testimonials-side-scroll
   Title: TestimonialsSideScroll
   Description: A horizontal snap-scroll testimonials carousel for React and Next.js with CSS snap points, gradient edge masks, arrow navigation, touch swipe, and marketing-scale headline built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-side-scroll.tsx
   ============================================================ *@

@inject IJSRuntime JS

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Swipe through the teams shipping with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Drag, swipe, or use the arrows — quotes from engineering teams running the platform in
                production today.
            </p>
        </div>

        <div class="relative mt-12">
            <div id="@_scrollId"
                 class="scrollbar-none flex snap-x snap-mandatory gap-5 overflow-x-auto pb-2"
                 style="scrollbar-width:none; -ms-overflow-style:none;">
                @foreach (var t in _testimonials)
                {
                    <figure class="flex min-w-[320px] max-w-[320px] shrink-0 snap-center flex-col overflow-hidden rounded-2xl border bg-card p-6 sm:min-w-[360px] sm:max-w-[360px]">
                        <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                            @for (var s = 0; s < 5; s++)
                            {
                                <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                            }
                        </div>
                        <blockquote class="mt-4 flex-1 text-base leading-relaxed text-foreground">
                            &ldquo;@t.Quote&rdquo;
                        </blockquote>
                        <figcaption class="mt-6 flex items-center gap-3">
                            <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                                <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                    @t.Initials
                                </span>
                            </div>
                            <div class="min-w-0">
                                <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                                <p class="truncate text-xs text-muted-foreground">
                                    @t.Role &middot; @t.Company
                                </p>
                            </div>
                        </figcaption>
                    </figure>
                }
            </div>

            <div aria-hidden="true"
                 class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-background to-transparent">
            </div>
            <div aria-hidden="true"
                 class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-background to-transparent">
            </div>
        </div>

        <div class="mt-6 flex items-center justify-center gap-2">
            <button type="button"
                    @onclick="@(() => ScrollAsync("left"))"
                    aria-label="Scroll left"
                    class="flex size-10 items-center justify-center rounded-full border bg-card text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                <LucideIconCn Name="chevron-left" Size="16" Class="size-4" aria-hidden="true" />
            </button>
            <button type="button"
                    @onclick="@(() => ScrollAsync("right"))"
                    aria-label="Scroll right"
                    class="flex size-10 items-center justify-center rounded-full border bg-card text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                <LucideIconCn Name="chevron-right" Size="16" Class="size-4" aria-hidden="true" />
            </button>
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private readonly string _scrollId = "tss-scroll-" + Guid.NewGuid().ToString("N")[..8];

    private record Testimonial(
        string Id,
        string Name,
        string Initials,
        string Role,
        string Company,
        string Quote
    );

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Ava Thompson", "AT", "Product Manager", "Linearly",
            "Our team adopted these components in under a day. The API was obvious and the docs covered every edge case we hit in production."),
        new("t2", "Noah Williams", "NW", "Staff Engineer", "Vercelled",
            "We migrated our entire dashboard to server components without a single hydration error. That alone justified the switch."),
        new("t3", "Emma Chen", "EC", "Design Lead", "Figment",
            "Design tokens map one-to-one with our Figma variables. Our designers can inspect any component and trust what they see."),
        new("t4", "Lucas Patel", "LP", "Frontend Architect", "Stripeline",
            "Bundle size impact was zero. Every component tree-shakes and our Lighthouse scores stayed pinned at 100 after the migration."),
        new("t5", "Isabella Garcia", "IG", "Engineering Manager", "Notionway",
            "New hires are productive on day one. They build production-quality UI without touching our legacy component library."),
        new("t6", "Ethan Miller", "EM", "Senior Developer", "Planetary",
            "The form components alone saved us three weeks. Validation, errors, and accessibility — all handled with zero configuration."),
    ];

    private async Task ScrollAsync(string direction)
    {
        const int amount = 340;
        var delta = direction == "left" ? -amount : amount;
        await JS.InvokeVoidAsync("eval",
            $"(function(){{var el=document.getElementById('{_scrollId}');if(el)el.scrollBy({{left:{delta},behavior:'smooth'}});}})()");
    }
}
