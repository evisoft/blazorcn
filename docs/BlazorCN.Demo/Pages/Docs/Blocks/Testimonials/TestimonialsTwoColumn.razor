@* ============================================================
   Block: testimonials-two-column
   Title: TestimonialsTwoColumn
   Description: A balanced two-column testimonials card grid for React and Next.js with star ratings, avatar attribution, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-two-column.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                What teams say after a year in production.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From two-person startups to public companies, here is what engineering teams tell us
                after shipping on the platform.
            </p>
        </div>

        @* Two-column grid *@
        <div class="mt-10 grid gap-5 sm:grid-cols-2">
            @foreach (var t in _testimonials)
            {
                <figure class="flex flex-col rounded-xl border bg-card p-6">
                    <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                        @for (var i = 0; i < 5; i++)
                        {
                            <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>
                    <blockquote class="mt-4 flex-1 text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Hannah Kline", "HK", "Staff Engineer", "Meridian",
            "We cut component build time in half and passed our first accessibility audit without any rework. Every engineer on the team stopped rebuilding date pickers from scratch."),
        new("t2", "Thomas Berger", "TB", "Frontend Lead", "Axiom",
            "Migrated a 200-page marketing site in three weeks. The block patterns saved us from starting every layout from scratch — that alone paid for the license ten times over."),
        new("t3", "Oscar Nilsson", "ON", "CTO", "Flowstate",
            "Evaluated this against building in-house. The ROI was obvious within the first week. Our engineers shipped features instead of arguing about spacing tokens."),
        new("t4", "Diana Reyes", "DR", "VP of Product", "Clearbit",
            "Our NPS for the developer portal jumped 18 points after the redesign. Customers noticed the polish immediately — three of them asked which agency we hired."),
        new("t5", "Amara Osei", "AO", "Design Systems Lead", "Lattice",
            "Finally a component library where the tokens match what we actually need. Our Figma library and our codebase speak the same language for the first time in five years."),
        new("t6", "Kenji Watanabe", "KW", "Engineering Manager", "Novu",
            "Onboarding new engineers went from two weeks to two days. Our last three junior hires shipped production code on their first afternoon. Unheard of."),
    ];
}
