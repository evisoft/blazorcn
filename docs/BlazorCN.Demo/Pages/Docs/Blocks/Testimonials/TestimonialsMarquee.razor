@* ============================================================
   Block: testimonials-marquee
   Title: TestimonialsMarquee
   Description: A dual-row infinite marquee testimonials block for React and Next.js with opposite-direction CSS keyframe scrolling, gradient edge masks, reduced-motion support, and hover pause, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-marquee.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4" aria-label="Customer testimonials marquee">

    <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Loved by engineering teams
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            Built for teams who ship.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
            From two-person startups to public companies, here&rsquo;s what engineers say after a
            year in production.
        </p>
    </div>

    <div class="relative mt-12 overflow-hidden">

        @* Row 1 — left *@
        <div class="overflow-hidden py-3">
            <div class="marquee-testimonials-row flex gap-4">
                @foreach (var item in _doubledOne)
                {
                    <figure class="flex min-w-[320px] shrink-0 flex-col gap-3 rounded-xl border bg-card p-5">
                        <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                            @for (var i = 0; i < 5; i++)
                            {
                                <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                            }
                        </div>
                        <blockquote class="text-sm leading-snug text-foreground">
                            &ldquo;@item.Quote&rdquo;
                        </blockquote>
                        <figcaption class="flex items-center gap-3">
                            <div class="relative size-9 shrink-0 overflow-hidden rounded-full border bg-muted">
                                <span class="absolute inset-0 flex items-center justify-center font-mono text-[11px] font-semibold text-muted-foreground">
                                    @item.Initials
                                </span>
                            </div>
                            <div class="min-w-0">
                                <p class="truncate text-sm font-semibold text-foreground">@item.Name</p>
                                <p class="truncate text-xs text-muted-foreground">
                                    @item.Role · @item.Company
                                </p>
                            </div>
                        </figcaption>
                    </figure>
                }
            </div>
        </div>

        @* Row 2 — right *@
        <div class="overflow-hidden py-3">
            <div class="marquee-testimonials-row-reverse flex gap-4">
                @foreach (var item in _doubledTwo)
                {
                    <figure class="flex min-w-[320px] shrink-0 flex-col gap-3 rounded-xl border bg-card p-5">
                        <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                            @for (var i = 0; i < 5; i++)
                            {
                                <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                            }
                        </div>
                        <blockquote class="text-sm leading-snug text-foreground">
                            &ldquo;@item.Quote&rdquo;
                        </blockquote>
                        <figcaption class="flex items-center gap-3">
                            <div class="relative size-9 shrink-0 overflow-hidden rounded-full border bg-muted">
                                <span class="absolute inset-0 flex items-center justify-center font-mono text-[11px] font-semibold text-muted-foreground">
                                    @item.Initials
                                </span>
                            </div>
                            <div class="min-w-0">
                                <p class="truncate text-sm font-semibold text-foreground">@item.Name</p>
                                <p class="truncate text-xs text-muted-foreground">
                                    @item.Role · @item.Company
                                </p>
                            </div>
                        </figcaption>
                    </figure>
                }
            </div>
        </div>

        @* Gradient edge masks *@
        <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent"></div>
        <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent"></div>
    </div>

    <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
        <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">Read all stories</ButtonCn>
    </div>

    <style>
        @@keyframes marquee-testimonials-left {
            0% { transform: translateX(0); }
            100% { transform: translateX(-50%); }
        }
        @@keyframes marquee-testimonials-right {
            0% { transform: translateX(-50%); }
            100% { transform: translateX(0); }
        }
        .marquee-testimonials-row {
            animation: marquee-testimonials-left 35s linear infinite;
            width: max-content;
        }
        .marquee-testimonials-row:hover { animation-play-state: paused; }
        .marquee-testimonials-row-reverse {
            animation: marquee-testimonials-right 40s linear infinite;
            width: max-content;
        }
        .marquee-testimonials-row-reverse:hover { animation-play-state: paused; }
        @@media (prefers-reduced-motion: reduce) {
            .marquee-testimonials-row,
            .marquee-testimonials-row-reverse {
                animation: none;
            }
        }
    </style>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly Testimonial[] _rowOne =
    [
        new("m1", "Sarah Chen",     "SC", "Head of Engineering",  "Linearly",    "We shipped five years of backlog in three months. The pipeline stopped fighting us."),
        new("m2", "Marcus Rivera",  "MR", "Staff Engineer",        "Northwind",   "Cut our p99 latency from 900ms to 80ms in a weekend migration."),
        new("m3", "Emily Nakamura", "EN", "Design Systems Lead",   "Halide",      "Migrated our entire design system in two weeks instead of two quarters."),
        new("m4", "James Walker",   "JW", "Frontend Lead",         "Voltaware",   "Junior devs productive on day one. That has literally never happened before."),
        new("m5", "Priya Sharma",   "PS", "Product Designer",      "Mori Labs",   "The first tool in five years my engineers chose on their own time."),
        new("m6", "Tomás Alvarado", "TA", "Platform Lead",         "Kestrel",     "Our on-call pager rang twice last quarter. Before: twice a day."),
    ];

    private static readonly Testimonial[] _rowTwo =
    [
        new("m7",  "Alex Petrov",    "AP", "CTO",                  "Sonderly",    "Saved us four engineer-months on the dashboard rebuild. Zero regressions."),
        new("m8",  "Rachel Kim",     "RK", "Design Director",      "Borealis",    "Replaced three internal tools and six custom hooks with one import."),
        new("m9",  "Daniel Costa",   "DC", "Senior Developer",     "Planetforge", "Dark mode, a11y, responsive — the boring wins we used to re-litigate every sprint."),
        new("m10", "Lisa Thompson",  "LT", "VP of Product",        "Clerkwise",   "Reduced UI bug tickets by 70% in the first month. Support stopped crying."),
        new("m11", "Ryan Foster",    "RF", "Engineering Manager",  "Resendly",    "The best investment we made for our frontend. Paid for itself in week one."),
        new("m12", "Emi Takeda",     "ET", "Head of Platform",     "Yuki Systems","I stopped writing YAML. Didn't know that was allowed. Not going back."),
