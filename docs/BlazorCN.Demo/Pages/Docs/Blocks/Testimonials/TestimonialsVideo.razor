@* ============================================================
   Block: testimonials-video
   Title: TestimonialsVideo
   Description: A video thumbnail testimonial grid for React and Next.js with aspect-video placeholders, play button overlays, duration badges, and hover scale built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-video.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer videos
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Hear it from the teams who shipped.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Six recorded conversations with the engineers and product leads who deploy thousands of
                times a day with our platform.
            </p>
        </div>

        @* Video grid *@
        <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var t in _testimonials)
            {
                <figure class="group overflow-hidden rounded-xl border bg-card">
                    @* Thumbnail *@
                    <button type="button" aria-label="@($"Play video testimonial from {t.Name}")" class="relative block aspect-video w-full overflow-hidden bg-muted">
                        <div class="absolute inset-0 bg-gradient-to-br from-muted via-muted to-muted/40"></div>
                        <div aria-hidden="true" class="absolute inset-0 opacity-30" style="background-image:radial-gradient(circle at 30% 40%, var(--muted-foreground) 1px, transparent 1px);background-size:12px 12px;"></div>
                        <div class="absolute inset-0 flex items-center justify-center">
                            <div class="flex size-14 items-center justify-center rounded-full border bg-background/90 shadow-lg backdrop-blur transition-transform group-hover:scale-110">
                                <LucideIconCn Name="play" Size="24" Class="size-6 translate-x-0.5 fill-foreground text-foreground" aria-hidden="true" />
                            </div>
                        </div>
                        <span class="absolute bottom-2 right-2 rounded bg-background/90 px-1.5 py-0.5 font-mono text-[10px] font-medium text-foreground backdrop-blur">
                            @t.Duration
                        </span>
                    </button>

                    @* Body *@
                    <div class="p-5">
                        <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                            @foreach (var s in _stars)
                            {
                                <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                            }
                        </div>
                        <blockquote class="mt-3 text-sm leading-snug italic text-muted-foreground">
                            @("\"")@t.Quote@("\"")
                        </blockquote>
                        <figcaption class="mt-4 flex items-center gap-3">
                            <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                                <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                    @t.Initials
                                </span>
                            </div>
                            <div class="min-w-0">
                                <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                                <p class="truncate text-xs text-muted-foreground">
                                    @t.Role · @t.Company
                                </p>
                            </div>
                        </figcaption>
                    </div>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[270px]">Watch customer videos</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record VideoTestimonial(string Id, string Name, string Initials, string Role, string Company, string Quote, string Duration);

    private static readonly int[] _stars = [0, 1, 2, 3, 4];

    private static readonly VideoTestimonial[] _testimonials =
    [
        new("vt1", "Laura Bennett", "LB", "CTO", "Streamline",
            "We cut frontend build time 62% in the first quarter after switching. Nobody on the team wants to go back.",
            "2:34"),
        new("vt2", "Alex Nguyen", "AN", "Head of Product", "Orbiter",
            "Our design system went from fragmented Figma files to a unified codebase in two weeks. We have never shipped faster.",
            "1:48"),
        new("vt3", "Rachel Kim", "RK", "Engineering Lead", "Pinpoint",
            "Our accessibility audit returned zero findings. The first time in six years that has happened to us.",
            "3:12"),
        new("vt4", "Tomás Alvarado", "TA", "Staff Engineer", "Voltaware",
            "Cut our p99 latency from 900ms to 80ms in a weekend migration. The rollback plan was never needed.",
            "2:07"),
        new("vt5", "Priya Raman", "PR", "Platform Lead", "Halide Inc.",
            "I stopped writing YAML. I genuinely did not know that was allowed in 2026.",
