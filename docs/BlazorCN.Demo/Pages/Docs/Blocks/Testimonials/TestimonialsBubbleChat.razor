@* ============================================================
   Block: testimonials-bubble-chat
   Title: TestimonialsBubbleChat
   Description: A Slack-style conversation thread testimonials block for React and Next.js with alternating chat bubbles, staggered message reveal, and a marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-bubble-chat.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Overheard in #customer-love
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The teams shipping with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From two-person startups to public companies, here is what engineers actually say to
                each other after a month in production.
            </p>
        </div>

        @* Slack-style thread *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            <div class="flex items-center justify-between border-b px-5 py-3">
                <div class="flex items-center gap-2">
                    <span class="font-mono text-sm text-muted-foreground">#</span>
                    <span class="text-sm font-semibold">customer-love</span>
                </div>
                <span class="text-xs text-muted-foreground">5 replies</span>
            </div>

            <div class="space-y-5 px-5 py-6 sm:px-6">
                @foreach (var msg in _messages)
                {
                    var isRight = msg.Index % 2 == 1;
                    <figure class="@Cn.Merge("flex gap-3", isRight ? "flex-row-reverse" : "")">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @msg.Initials
                            </span>
                        </div>
                        <div class="@Cn.Merge("max-w-xs sm:max-w-sm", isRight ? "text-right" : "")">
                            <div class="@Cn.Merge("rounded-2xl px-4 py-3", isRight ? "rounded-tr-sm bg-primary/5" : "rounded-tl-sm bg-muted/60")">
                                <blockquote class="text-sm leading-relaxed text-foreground">
                                    @msg.Text
                                </blockquote>
                            </div>
                            <figcaption class="@Cn.Merge("mt-2 flex items-center gap-2", isRight ? "justify-end" : "")">
                                <span class="text-sm font-semibold text-foreground">@msg.Name</span>
                                <span class="text-xs text-muted-foreground">
                                    @msg.Role · @msg.Company
                                </span>
                                <span class="font-mono text-xs text-muted-foreground">@msg.Time</span>
                            </figcaption>
                        </div>
                    </figure>
                }
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Message(int Index, string Id, string Name, string Initials, string Role, string Company, string Text, string Time);

    private static readonly Message[] _messages =
    [
        new(0, "m1", "Olivia Grant", "OG", "Design Engineer", "Raycast",
            "just dropped the library into our Next app and shipped three screens before lunch. zero overrides.", "10:42"),
        new(1, "m2", "David Park", "DP", "Frontend Lead", "Vercel",
            "^ this. our design debt backlog went from 47 tickets to 6 in a week. I am not exaggerating.", "10:43"),
        new(2, "m3", "Anya Petrova", "AP", "Product Manager", "Linear",
            "our designers stopped filing UI-inconsistency bugs the day we adopted these. that is the highest compliment I know how to give.", "10:45"),
        new(3, "m4", "James Wu", "JW", "Staff Engineer", "Stripe",
            "we evaluated five libraries. accessibility defaults and the composable API saved us six months of platform work. six.", "10:47"),
        new(4, "m5", "Elena Rossi", "ER", "CTO", "Dub",
            "prototype to production in a weekend. our bundle size actually dropped 18 percent after the switch.", "10:51"),
    ];
}
