@* ============================================================
   Block: testimonials-cards-01
   Title: Testimonials Cards 01
   Description: Testimonials with card layout featuring verified badges, usernames, Twitter links, and dates for social proof
   Long Description: Card-based centered testimonials
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, CardCn, CardContentCn, CardFooterCn, CardHeaderCn, LucideBadgeCheckCn, LucideTwitterCn
   Source: original/blocks/testimonials/testimonials-cards-01.tsx
   ============================================================ *@

<section class="py-16">
    <div class="container mx-auto px-4">
        <div class="mb-16">
            <p class="mb-2 text-sm font-semibold tracking-wide uppercase">Testimonials</p>
            <h2 class="mb-4 text-3xl font-bold">Think about us</h2>
            <p class="text-muted-foreground max-w-lg text-lg">
                That's the main thing people are controlled by! Thoughts - their perception of themselves!
            </p>
        </div>
        <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var item in _testimonials)
            {
                <CardCn>
                    <CardHeaderCn Class="flex flex-row items-center gap-4 px-6">
                        <AvatarCn>
                            <AvatarImageCn Alt="@($"{item.Name} image")" Src="@item.Image" />
                            <AvatarFallbackCn>@GetInitials(item.Name)</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="flex-1">
                            <div class="flex items-center gap-1.5">
                                <p class="font-semibold">@item.Name</p>
                                <LucideBadgeCheckCn class="h-4 w-4 text-blue-500" />
                            </div>
                            <p class="text-muted-foreground text-sm">@item.Username</p>
                        </div>
                    </CardHeaderCn>
                    <CardContentCn Class="px-6">
                        <blockquote class="text-muted-foreground">@item.Quote</blockquote>
                    </CardContentCn>
                    <CardFooterCn Class="flex items-center justify-between gap-4 px-6">
                        <a class="flex items-center gap-1.5 text-sm font-semibold hover:underline" href="#">
                            See on <LucideTwitterCn class="h-3.5 w-3.5" />
                        </a>
                        <p class="text-muted-foreground text-sm">@item.Date</p>
                    </CardFooterCn>
                </CardCn>
            }
        </div>
    </div>
</section>

@code {
    private record TestimonialItem(string Image, string Name, string Username, string Quote, string Date);

    private static string GetInitials(string name) =>
        string.Join("", name.Split(' ').Select(n => n[0]));

