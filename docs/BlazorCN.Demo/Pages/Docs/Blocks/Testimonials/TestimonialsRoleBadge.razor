@* ============================================================
   Block: testimonials-role-badge
   Title: TestimonialsRoleBadge
   Description: A role-badged testimonials card grid for React and Next.js with colored role pills for engineers, designers, PMs, and founders, hero attribution, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-role-badge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted across roles
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Built for every seat at the table.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Engineers, designers, product managers, and founders — four teams, four stories, one
                platform they all kept using.
            </p>
        </div>

        @* Card grid *@
        <div class="mt-12 grid gap-6 sm:grid-cols-2">
            @foreach (var t in _testimonials)
            {
                var cfg = GetRoleConfig(t.Role);
                <figure class="flex flex-col rounded-xl border bg-card p-6">
                    <span class="@($"inline-flex w-fit items-center rounded-full px-2.5 py-1 text-xs font-medium {cfg.BgClass} {cfg.TextClass}")">
                        @cfg.Label
                    </span>
                    <blockquote class="mt-4 flex-1 text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-3 border-t pt-5">
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.JobTitle · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record RoleConfig(string Label, string BgClass, string TextClass);

    private record Testimonial(string Id, TestimonialRole Role, string Initials, string Quote, string Name, string JobTitle, string Company);

    private enum TestimonialRole { Engineer, Designer, Pm, Founder }

    private static RoleConfig GetRoleConfig(TestimonialRole role) => role switch
    {
        TestimonialRole.Engineer => new("Engineer", "bg-blue-500/10", "text-blue-600 dark:text-blue-400"),
        TestimonialRole.Designer => new("Designer", "bg-violet-500/10", "text-violet-600 dark:text-violet-400"),
        TestimonialRole.Pm      => new("Product", "bg-amber-500/10", "text-amber-600 dark:text-amber-400"),
        TestimonialRole.Founder => new("Founder", "bg-emerald-500/10", "text-emerald-600 dark:text-emerald-400"),
        _                       => new("Unknown", "", ""),
    };

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", TestimonialRole.Engineer, "JM",
            "Tree-shaking works perfectly and every component follows the same API pattern. We deleted 11,000 lines of custom UI code on day one.",
            "Jake Morrison", "Senior Frontend Engineer", "Linearly"),
        new("t2", TestimonialRole.Designer, "AY",
            "Components match our Figma designs pixel-for-pixel. Design-to-dev handoff time dropped from two days to zero in the first sprint.",
            "Aiko Yamamoto", "Lead Product Designer", "Framewise"),
        new("t3", TestimonialRole.Pm, "MT",
            "Feature velocity tripled after adoption. Engineers spend time on product logic instead of rebuilding dropdowns for the fourth time.",
            "Michael Torres", "Senior Product Manager", "Halide Inc."),
        new("t4", TestimonialRole.Founder, "HC",
            "We launched our MVP in 10 days. The quality is enterprise-grade, which meant we focused entirely on our core differentiator, not buttons.",
            "Hannah Cho", "Co-founder & CEO", "Mintlify"),
    ];
}
