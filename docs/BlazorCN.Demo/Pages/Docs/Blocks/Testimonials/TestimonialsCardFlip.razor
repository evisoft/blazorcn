@* ============================================================
   Block: testimonials-card-flip
   Title: TestimonialsCardFlip
   Description: An asymmetric bento grid testimonials block for React and Next.js with one featured hero quote, three supporting cards, star ratings, and a marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-card-flip.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div>
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-muted-foreground text-xs font-medium uppercase tracking-widest">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Built for teams who ship.
            </h2>
            <p class="text-muted-foreground mx-auto mt-4 max-w-xl text-base leading-relaxed">
                One featured voice, three supporting stories. Every quote from a real team running our
                platform in production today.
            </p>
        </div>

        <div class="mt-10 grid gap-4 sm:grid-cols-3 sm:grid-rows-2">
            @* Featured cell *@
            <figure class="bg-card rounded-2xl border p-8 sm:col-span-2 sm:row-span-2">
                <div role="img" aria-label="@($"{_featured.Rating} out of 5 stars")" class="flex items-center gap-0.5">
                    @for (var i = 0; i < 5; i++)
                    {
                        <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                    }
                </div>
                <blockquote class="text-foreground mt-6 text-xl font-semibold leading-[1.25] tracking-tight sm:text-2xl">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-4">
                    <div class="bg-muted relative size-14 shrink-0 overflow-hidden rounded-full border">
                        <span class="text-muted-foreground absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-foreground text-base font-semibold">@_featured.Name</p>
                        <p class="text-muted-foreground text-sm">
                            @_featured.Role · @_featured.Company
                        </p>
                    </div>
                </figcaption>
            </figure>

            @* Trio cells *@
            @foreach (var t in _trio)
            {
                <figure class="bg-card rounded-xl border p-5">
                    <div role="img" aria-label="@($"{t.Rating} out of 5 stars")" class="flex items-center gap-0.5">
                        @for (var i = 0; i < 5; i++)
                        {
                            <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>
                    <blockquote class="text-foreground mt-3 text-base leading-relaxed">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-4 flex items-center gap-3">
                        <div class="bg-muted relative size-10 shrink-0 overflow-hidden rounded-full border">
                            <span class="text-muted-foreground absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="text-foreground truncate text-sm font-semibold">@t.Name</p>
                            <p class="text-muted-foreground truncate text-xs">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TestimonialItem(string Id, string Name, string Initials, string Role, string Company, string Quote, int Rating, bool Featured = false);

    private static readonly TestimonialItem[] _testimonials =
    [
        new("t1", "Rachel Kim", "RK", "VP of Engineering", "Vercel",
            "Our frontend velocity doubled within the first sprint. The TypeScript inference is flawless, the accessibility audit passed with zero issues, and our designers stopped filing component tickets entirely. This library paid for itself in the first week.",
            5, Featured: true),
        new("t2", "James Okonkwo", "JO", "Lead Designer", "Stripe",
            "Migrated our entire design system in four days instead of three months. Bundle size dropped 18 percent.",
            5),
        new("t3", "Sofia Martinez", "SM", "Staff Engineer", "Linear",
            "Our junior engineers ship production-quality UI on their first day. That has never happened before.",
            5),
        new("t4", "Alex Novak", "AN", "Design Systems Lead", "Shopify",
            "All 12 product teams ship consistent UI without a design-systems team policing every pull request.",
            5),
    ];

    private static readonly TestimonialItem _featured = _testimonials[0];
    private static readonly TestimonialItem[] _trio = _testimonials[1..];
}
