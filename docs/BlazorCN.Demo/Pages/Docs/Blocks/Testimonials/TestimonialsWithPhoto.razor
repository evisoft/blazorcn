@* ============================================================
   Block: testimonials-with-photo
   Title: TestimonialsWithPhoto
   Description: A split panel portrait testimonial for React and Next.js with a full-bleed gradient portrait, caption overlay, hero-scale pull quote, and marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-with-photo.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The teams shipping with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Hear from the product leaders and engineers who rebuilt their frontend on our components
                and never looked back.
            </p>
        </div>

        @* Split panel *@
        <figure class="mt-12 grid overflow-hidden rounded-2xl border bg-card lg:grid-cols-2">
            @* Portrait panel *@
            <div aria-hidden="true" class="relative aspect-[4/5] overflow-hidden lg:aspect-auto">
                <div class="absolute inset-0 bg-gradient-to-br from-muted via-muted to-muted/30"></div>
                <div
                    class="absolute inset-0 opacity-30"
                    style="background-image:radial-gradient(circle at 30% 40%, var(--muted-foreground) 1px, transparent 1px);background-size:10px 10px;">
                </div>
                @* Caption overlay *@
                <div class="absolute bottom-4 left-4 rounded-lg border bg-card/90 px-4 py-3 backdrop-blur">
                    <p class="text-sm font-semibold text-foreground">@_featured.Name</p>
                    <p class="text-xs text-muted-foreground">
                        @_featured.Role · @_featured.Company
                    </p>
                </div>
            </div>

            @* Quote panel *@
            <div class="flex flex-col justify-center p-10 sm:p-14">
                <blockquote class="text-xl font-semibold leading-[1.25] tracking-tight text-foreground sm:text-2xl">
                    &ldquo;We cut our frontend cycle from six weeks to two. The design consistency across
                    our entire product suite improved overnight &mdash; customers actually noticed and
                    started writing in about it.&rdquo;
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-foreground">@_featured.Name</p>
                        <p class="text-sm text-muted-foreground">
                            @_featured.Role · @_featured.Company
                        </p>
                    </div>
                </figcaption>
            </div>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Read their story</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">
                Book a demo
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Name, string Initials, string Role, string Company, string Quote);

    private static readonly Testimonial _featured = new(
        "Claire Dubois",
        "CD",
        "Head of Product",
        "Figma",
        "We cut our frontend cycle from six weeks to two. The design consistency across our entire product suite improved overnight — customers actually noticed and started writing in about it."
    );
}
