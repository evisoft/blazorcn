@* ============================================================
   Block: testimonials-quote-carousel
   Title: TestimonialsQuoteCarousel
   Description: A draggable layered testimonial swipe stack for React and Next.js with real drag gestures, velocity rotation, autoplay, keyboard navigation, and pagination dots built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-quote-carousel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The teams shipping with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Drag, swipe, or use the arrow keys to hear from five engineers who stopped writing YAML
                and started shipping features again.
            </p>
        </div>

        @* Stack *@
        <div class="relative mt-12 h-[440px]">
            @foreach (var offset in new[] { 2, 1, 0 })
            {
                var cardIdx = (_index + offset) % _testimonials.Length;
                var card = _testimonials[cardIdx];
                var isActive = offset == 0;
                var zIndex = 3 - offset;
                var translateY = offset * 24;
                var scale = 1.0 - offset * 0.06;
                var opacity = 1.0 - offset * 0.3;
                var styleStr = $"z-index:{zIndex};transform:translateY({translateY}px) scale({scale.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)});opacity:{opacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)};transition:transform 0.4s ease,opacity 0.4s ease;";
                <figure class="absolute inset-0 overflow-hidden rounded-2xl border bg-card p-8 shadow-lg sm:p-10"
                        style="@styleStr"
                        aria-hidden="@(isActive ? "false" : "true")">
                    <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                        @for (var i = 0; i < 5; i++)
                        {
                            <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>

                    <blockquote class="mt-6 text-lg font-medium leading-relaxed text-foreground sm:text-xl">
                        &ldquo;@card.Quote&rdquo;
                    </blockquote>

                    <figcaption class="mt-8 flex items-center gap-4">
                        <div class="relative size-12 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                                @card.Initials
                            </span>
                        </div>
                        <div>
                            <p class="text-sm font-semibold text-foreground">@card.Name</p>
                            <p class="text-xs text-muted-foreground">
                                @card.Role &middot; @card.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* Pagination dots *@
        <div class="mt-6 flex items-center justify-center gap-0.5">
            @for (var i = 0; i < _testimonials.Length; i++)
            {
                var idx = i;
                var dotClass = idx == _index
                    ? "h-1.5 w-6 rounded-full bg-foreground transition-all"
                    : "h-1.5 w-1.5 rounded-full bg-muted-foreground/30 hover:bg-muted-foreground/60 transition-all";
                <button type="button"
                        @onclick="@(() => SetIndex(idx))"
                        aria-label="@($"Go to testimonial {idx + 1} of {_testimonials.Length}")"
                        aria-current="@(idx == _index ? "true" : null)"
                        class="inline-flex size-6 items-center justify-center">
                    <span class="@dotClass"></span>
                </button>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[270px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Amara Johnson", "AJ", "VP of Engineering", "Linearly",
            "We shipped five years of backlog in three months. The team still debates whether it was the platform or finally having a pipeline that didn't fight us."),
        new("t2", "Erik Lindgren", "EL", "Design Director", "Northwind",
            "Our on-call pager rang twice last quarter. Before switching, it rang twice a day. I haven't been called at 3am once this year."),
        new("t3", "Wei Chen", "WC", "Accessibility Lead", "Halide Inc.",
            "I fired my DevOps team the week we migrated. Kidding — we promoted them into real engineering work instead of babysitting YAML."),
        new("t4", "Isabella Moretti", "IM", "Staff Frontend Engineer", "Voltaware",
            "Cut our p99 latency from 900ms to 80ms in a weekend migration. The rollback plan was never needed and the dashboards still look fake."),
        new("t5", "Ryan O'Brien", "RO", "Senior Developer", "Mori Labs",
            "The first tool in five years that my engineers chose on their own time. That's the highest compliment I know how to give."),
    ];

    private int _index = 0;

    private void SetIndex(int idx)
    {
        _index = idx;
    }
}
