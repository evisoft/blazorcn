@* ============================================================
   Block: testimonials-mosaic
   Title: TestimonialsMosaic
   Description: An asymmetric bento testimonials block for React and Next.js with one featured quote cell spanning two columns plus a trio of smaller supporting quotes, built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-mosaic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4" aria-label="Bento featured testimonial with supporting trio">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                One big story, three sharp seconds.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A featured engineering story alongside three shorter voices — so you can linger on one
                and scan the rest.
            </p>
        </div>

        @* Bento grid *@
        <div class="mt-12 grid gap-4 sm:grid-cols-3 sm:grid-rows-2">
            @* Featured *@
            <figure class="flex flex-col rounded-2xl border bg-card p-8 sm:col-span-2 sm:row-span-2">
                <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                    @for (var i = 0; i < 5; i++)
                    {
                        <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                    }
                </div>
                <blockquote class="mt-6 flex-1 text-lg font-medium leading-relaxed text-foreground sm:text-xl">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-4">
                    <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                        <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                            @_featured.Initials
                        </span>
                    </div>
                    <div>
                        <p class="text-base font-semibold text-foreground">@_featured.Name</p>
                        <p class="text-sm text-muted-foreground">
                            @_featured.Role · @_featured.Company
                        </p>
                    </div>
                </figcaption>
            </figure>

            @* Trio *@
            @foreach (var t in _trio)
            {
                <figure class="flex flex-col rounded-xl border bg-card p-6">
                    <div role="img" aria-label="5 out of 5 stars" class="flex items-center gap-0.5">
                        @for (var si = 0; si < 5; si++)
                        {
                            <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                        }
                    </div>
                    <blockquote class="mt-3 flex-1 text-base leading-relaxed text-foreground">
                        &ldquo;@t.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-5 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                @t.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@t.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @t.Role · @t.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(string Id, string Name, string Initials, string Role, string Company, string Quote);

    private static readonly Testimonial _featured = new(
        "b-featured", "James Park", "JP", "Engineering Manager", "Veritas",
        "We replaced three internal tools with this single library. The consistency saved our team four design-review cycles a quarter. Best investment we made this year — and I don't say that lightly."
    );

    private static readonly Testimonial[] _trio =
    [
        new("b1", "Sarah Mitchell", "SM", "Product Designer", "Figurate",
            "Every detail feels intentional. We stopped filing consistency bugs six weeks ago."),
        new("b2", "Elena Rossi", "ER", "Frontend Lead", "Halide Inc.",
            "Shipped a complete dashboard in four days. Would have taken three weeks without this."),
        new("b3", "Marcus Chen", "MC", "CTO", "Northwind",
            "Consistency across teams is everything. This library delivered exactly that — in week one."),
    ];
}
