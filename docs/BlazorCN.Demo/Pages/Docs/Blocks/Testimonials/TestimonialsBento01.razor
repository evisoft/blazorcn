@* ============================================================
   Block: testimonials-bento-01
   Title: Testimonials Bento 01
   Description: Bento box grid layout with varying card sizes creating visual hierarchy and featured testimonials
   Long Description: Staggered heights Pinterest-style layout
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, CardCn, CardContentCn, LucideQuoteCn, LucideStarCn
   Source: original/blocks/testimonials/testimonials-bento-01.tsx
   ============================================================ *@

<section class="py-16">
    <div class="container mx-auto px-4">
        <div class="mb-12 text-center">
            <h2 class="mb-4 text-3xl font-bold md:text-4xl">What Our Customers Say</h2>
            <p class="text-muted-foreground mx-auto max-w-2xl text-lg">
                Trusted by thousands of professionals worldwide
            </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2 md:auto-rows-fr md:grid-cols-6">
            @* Featured Large Card *@
            <CardCn Class="sm:col-span-2 md:col-span-3 md:row-span-2 transition-all hover:shadow-lg">
                <CardContentCn Class="flex h-full flex-col justify-between p-6 md:p-8">
                    <div>
                        <img alt="@_featured.Company" class="mb-6 h-8 opacity-60" height="400" src="@_featured.Logo" width="400" />
                        <LucideQuoteCn class="text-primary/20 mb-4 h-10 w-10" />
                        <div class="mb-4 flex items-center gap-1">
                            @for (var i = 0; i < _featured.Rating; i++)
                            {
                                <LucideStarCn class="h-4 w-4 fill-yellow-400 text-yellow-400" />
                            }
                        </div>
                        <blockquote class="text-foreground mb-6 text-lg leading-relaxed md:text-xl">
                            @_featured.Quote
                        </blockquote>
                    </div>
                    <div class="flex items-center gap-3">
                        <AvatarCn Class="h-12 w-12">
                            <AvatarImageCn Alt="@_featured.Name" Src="@_featured.Image" />
                            <AvatarFallbackCn>@GetInitials(_featured.Name)</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <p class="font-semibold">@_featured.Name</p>
                            <p class="text-muted-foreground text-sm">@_featured.Role, @_featured.Company</p>
                        </div>
                    </div>
                </CardContentCn>
            </CardCn>

            @* Small Cards (first 2) *@
            @foreach (var testimonial in _testimonials.Take(2))
            {
                <CardCn Class="sm:col-span-1 md:col-span-3 transition-all hover:shadow-md">
                    <CardContentCn Class="p-6">
                        <div class="mb-3 flex items-center gap-1">
                            @for (var i = 0; i < testimonial.Rating; i++)
                            {
                                <LucideStarCn class="h-3 w-3 fill-yellow-400 text-yellow-400" />
                            }
                        </div>
                        <p class="text-foreground/90 mb-4 text-sm">"@testimonial.Quote"</p>
                        <div class="flex items-center gap-2">
                            <AvatarCn Class="h-8 w-8">
                                <AvatarImageCn Alt="@testimonial.Name" Src="@testimonial.Image" />
                                <AvatarFallbackCn Class="text-xs">@GetInitials(testimonial.Name)</AvatarFallbackCn>
                            </AvatarCn>
                            <div>
                                <p class="text-xs font-semibold">@testimonial.Name</p>
                                <p class="text-muted-foreground text-xs">@testimonial.Role</p>
                            </div>
                        </div>
                    </CardContentCn>
                </CardCn>
            }

            @* Medium Card *@
            <CardCn Class="sm:col-span-1 md:col-span-2 transition-all hover:shadow-md">
                <CardContentCn Class="p-6">
                    <div class="mb-3 flex items-center gap-1">
                        @for (var i = 0; i < _testimonials[2].Rating; i++)
                        {
                            <LucideStarCn class="h-3 w-3 fill-yellow-400 text-yellow-400" />
                        }
                    </div>
                    <p class="text-foreground/90 mb-4 text-sm">"@_testimonials[2].Quote"</p>
                    <div class="flex items-center gap-2">
                        <AvatarCn Class="h-8 w-8">
                            <AvatarImageCn Alt="@_testimonials[2].Name" Src="@_testimonials[2].Image" />
                            <AvatarFallbackCn Class="text-xs">@GetInitials(_testimonials[2].Name)</AvatarFallbackCn>
                        </AvatarCn>
                        <div>
                            <p class="text-xs font-semibold">@_testimonials[2].Name</p>
                            <p class="text-muted-foreground text-xs">@_testimonials[2].Role</p>
                        </div>
                    </div>
                </CardContentCn>
            </CardCn>

            @* Remaining Small Cards *@
            @foreach (var testimonial in _testimonials.Skip(3))
            {
                <CardCn Class="sm:col-span-1 md:col-span-2 transition-all hover:shadow-md">
                    <CardContentCn Class="p-6">
                        <div class="mb-3 flex items-center gap-1">
                            @for (var i = 0; i < testimonial.Rating; i++)
                            {
                                <LucideStarCn class="h-3 w-3 fill-yellow-400 text-yellow-400" />
                            }
                        </div>
                        <p class="text-foreground/90 mb-4 text-sm">"@testimonial.Quote"</p>
                        <div class="flex items-center gap-2">
                            <AvatarCn Class="h-8 w-8">
                                <AvatarImageCn Alt="@testimonial.Name" Src="@testimonial.Image" />
                                <AvatarFallbackCn Class="text-xs">@GetInitials(testimonial.Name)</AvatarFallbackCn>
                            </AvatarCn>
                            <div>
                                <p class="text-xs font-semibold">@testimonial.Name</p>
                                <p class="text-muted-foreground text-xs">@testimonial.Role</p>
                            </div>
                        </div>
                    </CardContentCn>
                </CardCn>
            }
        </div>
    </div>
</section>

@code {
    private record FeaturedTestimonial(string Name, string Role, string Company, string Image, string Logo, int Rating, string Quote);
    private record TestimonialItem(string Name, string Role, string Image, int Rating, string Quote);

    private static string GetInitials(string name) =>
        string.Join("", name.Split(' ').Select(n => n[0]));

    private readonly FeaturedTestimonial _featured = new(
        "Alexandra Chen", "VP of Product", "TechCorp",
        "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=400&h=400",
        "https://v3.material-tailwind.com/logo/google.svg", 5,
        "This platform has completely transformed how we build products. Our team's productivity increased by 150% in just three months. The support is exceptional and the features keep getting better.");

    private readonly TestimonialItem[] _testimonials =
    [
        new("Marcus Johnson", "CTO", "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=400&h=400", 5, "Best investment we made this year."),
        new("Emily Rodriguez", "Designer", "https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&q=80&w=400&h=400", 5, "Intuitive, powerful, and beautiful. Perfect combination."),
        new("David Park", "Founder", "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&q=80&w=400&h=400", 5, "Game-changer for our startup."),
        new("Lisa Thompson", "Product Manager", "https://images.unsplash.com/photo-1487412720507-e7ab37603c6f?auto=format&fit=crop&q=80&w=400&h=400", 5, "Exceeded all expectations. Highly recommended!"),
        new("Ryan Foster", "Developer", "https://images.unsplash.com/photo-1519345182560-3f2917c472ef?auto=format&fit=crop&q=80&w=400&h=400", 5, "Clean API and excellent docs."),
    ];
}
