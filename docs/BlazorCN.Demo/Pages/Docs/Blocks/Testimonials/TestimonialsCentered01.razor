@* ============================================================
   Block: testimonials-centered-01
   Title: Testimonials Centered 01
   Description: Testimonials section with centered cards displaying customer quotes, ratings, and profile images with badge header
   Long Description: Card-based testimonials with Twitter links
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, CardCn, CardContentCn, LucideSparklesCn
   Source: original/blocks/testimonials/testimonials-centered-01.tsx
   ============================================================ *@

<section class="py-16">
    <div class="container mx-auto px-4">
        <div class="mb-20 text-center">
            <BadgeCn Class="mx-auto mb-8 w-max" Variant="BadgeVariant.Outline">
                <LucideSparklesCn class="mr-2 h-4 w-4" />
                Testimonials
            </BadgeCn>
            <h2 class="mb-4 text-3xl font-bold">What Clients Say</h2>
            <p class="text-muted-foreground mx-auto max-w-lg text-lg">
                We're constantly trying to express ourselves and actualize our dreams. If you have
                the opportunity to play.
            </p>
        </div>
        <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var item in _testimonials)
            {
                <CardCn Class="border-0 bg-transparent shadow-none">
                    <CardContentCn Class="p-0 text-center">
                        <AvatarCn Class="mx-auto mb-4 h-20 w-20">
                            <AvatarImageCn Alt="@($"{item.Name} image")" Src="@item.Image" />
                            <AvatarFallbackCn>@GetInitials(item.Name)</AvatarFallbackCn>
                        </AvatarCn>
                        <p class="mb-1 text-lg font-semibold">@item.Name</p>
                        <p class="text-muted-foreground mb-4 text-sm">@item.Role</p>
                        <blockquote class="text-muted-foreground mx-auto max-w-lg">
                            &quot;@item.Quote&quot;
                        </blockquote>
                    </CardContentCn>
                </CardCn>
            }
        </div>
    </div>
</section>

@code {
    private record TestimonialItem(string Image, string Name, string Role, string Quote);

    private static string GetInitials(string name) =>
        string.Join("", name.Split(' ').Select(n => n[0]));

    private readonly TestimonialItem[] _testimonials =
    [
        new("https://images.unsplash.com/photo-1716662318479-a9c0f1cd1a0e?auto=format&fit=crop&q=80&w=400&h=400",
            "Sarah Johnson", "Product Designer",
            "The attention to detail and component quality is outstanding. These UI blocks have significantly accelerated our design workflow and improved consistency across our products."),
        new("https://images.unsplash.com/photo-1623853434105-8e7a72898180?auto=format&fit=crop&q=80&w=400&h=400",
            "Michael Chen", "Tech Lead at Stripe",
            "Exceptional component library with excellent documentation. The customization options and TypeScript support make it perfect for enterprise applications. Highly recommend!"),
        new("https://images.unsplash.com/photo-1641906840000-4b88f1d44de6?auto=format&fit=crop&q=80&w=400&h=400",
            "Emma Rodriguez", "Frontend Developer",
            "A game-changer for rapid prototyping and production. The components are production-ready, well-tested, and the design system is incredibly cohesive. Love it!"),
    ];
}
