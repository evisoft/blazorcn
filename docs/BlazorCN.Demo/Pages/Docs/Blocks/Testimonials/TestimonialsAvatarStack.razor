@* ============================================================
   Block: testimonials-avatar-stack
   Title: TestimonialsAvatarStack
   Description: A featured hero testimonial with an overlapping avatar stack for React and Next.js with animated customer count, oversized pull quote, star rating, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-avatar-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Built for teams who ship.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Join thousands of engineers who traded fighting their tools for shipping features.
            </p>
        </div>

        @* Avatar stack + count *@
        <div class="mt-10 flex flex-col items-center">
            <div
                class="flex items-center"
                role="group"
                aria-label="@($"{_customerCount:N0}+ happy customers")">
                @foreach (var avatar in _avatars)
                {
                    var isFirst = avatar == _avatars[0];
                    <div
                        aria-hidden="true"
                        class="@Cn.Merge("flex size-11 items-center justify-center rounded-full border-2 border-background font-mono text-xs font-semibold", avatar.Tint, !isFirst ? "-ml-3" : "")">
                        @avatar.Initials
                    </div>
                }
            </div>
            <p class="mt-3 text-sm text-muted-foreground">
                Trusted by
                <span class="font-semibold tabular-nums text-foreground">
                    5,000+
                </span>
                engineering teams
            </p>
        </div>

        @* Featured pull quote *@
        <figure class="mt-10 text-center">
            <div
                role="img"
                aria-label="@($"{_featured.Rating} out of 5 stars")"
                class="flex items-center justify-center gap-0.5">
                @for (var i = 0; i < _featured.Rating; i++)
                {
                    <LucideIconCn Name="star" Size="16" aria-hidden="true" Class="size-4 fill-amber-500 text-amber-500" />
                }
            </div>
            <blockquote class="mt-6 text-2xl font-semibold leading-[1.2] tracking-tight text-foreground sm:text-3xl lg:text-4xl">
                &ldquo;@_featured.Quote&rdquo;
            </blockquote>
            <figcaption class="mt-8 flex items-center justify-center gap-4">
                <div class="relative size-14 shrink-0 overflow-hidden rounded-full border bg-muted">
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-sm font-semibold text-muted-foreground">
                        @_featured.Initials
                    </span>
                </div>
                <div class="text-left">
                    <p class="text-base font-semibold text-foreground">@_featured.Name</p>
                    <p class="text-sm text-muted-foreground">
                        @_featured.Role · @_featured.Company
                    </p>
                </div>
            </figcaption>
        </figure>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record AvatarItem(string Initials, string Tint);
    private record FeaturedItem(string Quote, string Name, string Initials, string Role, string Company, int Rating);

    private static readonly AvatarItem[] _avatars =
    [
        new("SK", "bg-blue-500/15 text-blue-700 dark:text-blue-300"),
        new("JR", "bg-emerald-500/15 text-emerald-700 dark:text-emerald-300"),
        new("AL", "bg-amber-500/15 text-amber-700 dark:text-amber-300"),
        new("MP", "bg-violet-500/15 text-violet-700 dark:text-violet-300"),
        new("TW", "bg-rose-500/15 text-rose-700 dark:text-rose-300"),
    ];

    private static readonly int _customerCount = 5000;

    private static readonly FeaturedItem _featured = new(
        Quote: "We shipped our entire marketing site in two days. Our old redesign took seven months and three agencies. I don't know how to explain the difference other than: we finally stopped fighting our tools.",
        Name: "Sarah Kim",
        Initials: "SK",
        Role: "VP of Engineering",
        Company: "Meridian",
        Rating: 5
    );
}
