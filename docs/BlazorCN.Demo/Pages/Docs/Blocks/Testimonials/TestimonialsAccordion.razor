@* ============================================================
   Block: testimonials-accordion
   Title: TestimonialsAccordion
   Description: An expandable accordion testimonial list for React and Next.js with compact preview rows, full quote reveal on expand, single-open collapse behavior, and a marketing headline with ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-accordion.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Tap any story to read more.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Five engineers, five teams, five reasons they stayed. Expand any row to read the full
                story in their own words.
            </p>
        </div>

        @* Accordion list *@
        <div class="mt-10 overflow-hidden rounded-2xl border bg-card">
            <div class="flex w-full flex-col" data-slot="accordion">
                @foreach (var testimonial in _testimonials)
                {
                    var t = testimonial;
                    var isOpen = _openId == t.Id;
                    <div class="@Cn.Merge("cn-accordion-item border-b last:border-b-0")"
                         data-slot="accordion-item"
                         data-state="@(isOpen ? "open" : "closed")">
                        <h3 class="flex" data-slot="accordion-trigger-wrapper">
                            <button class="@Cn.Merge("cn-accordion-trigger group/accordion-trigger flex flex-1 items-start justify-between outline-none transition-all px-6 py-5 transition-colors hover:bg-muted/40 hover:no-underline", isOpen ? "bg-muted/30" : "")"
                                    type="button"
                                    data-slot="accordion-trigger"
                                    data-state="@(isOpen ? "open" : "closed")"
                                    aria-expanded="@(isOpen ? "true" : "false")"
                                    @onclick="@(() => Toggle(t.Id))">
                                <div class="flex min-w-0 flex-1 items-center gap-4">
                                    <div class="relative size-11 shrink-0 overflow-hidden rounded-full border bg-muted">
                                        <span class="absolute inset-0 flex items-center justify-center font-mono text-xs font-semibold text-muted-foreground">
                                            @t.Initials
                                        </span>
                                    </div>
                                    <div class="min-w-0 flex-1 text-left">
                                        <div class="flex min-w-0 items-center gap-2">
                                            <span class="truncate text-sm font-semibold text-foreground">
                                                @t.Name
                                            </span>
                                            <span class="shrink-0 text-xs text-muted-foreground">
                                                · @t.Role, @t.Company
                                            </span>
                                        </div>
                                        <div class="mt-1.5 flex min-w-0 items-center gap-2">
                                            <div role="img"
                                                 aria-label="@($"{t.Rating} out of 5 stars")"
                                                 class="flex shrink-0 items-center gap-0.5">
                                                @for (var i = 0; i < t.Rating; i++)
                                                {
                                                    <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                                                }
                                            </div>
                                            <p class="truncate text-xs text-muted-foreground">
                                                "@t.Preview"
                                            </p>
                                        </div>
                                    </div>
                                </div>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-slot="accordion-trigger-icon" class="@Cn.Merge("pointer-events-none shrink-0", isOpen ? "hidden" : "")" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-slot="accordion-trigger-icon" class="@Cn.Merge("pointer-events-none shrink-0", isOpen ? "" : "hidden")" aria-hidden="true"><path d="m18 15-6-6-6 6" /></svg>
                            </button>
                        </h3>
                        @if (isOpen)
                        {
                            <div class="cn-accordion-content overflow-hidden transition-all px-6 pb-6"
                                 role="region"
                                 data-slot="accordion-content"
                                 data-state="open">
                                <div class="cn-accordion-content-inner">
                                    <figure class="pl-[60px]">
                                        <blockquote class="text-base leading-relaxed text-foreground">
                                            "@t.Quote"
                                        </blockquote>
                                    </figure>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Testimonial(
        string Id,
        string Name,
        string Role,
        string Company,
        string Quote,
        string Preview,
        int Rating,
        string Initials
    );

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Rachel Kim", "Staff Engineer", "Figma",
            "We rebuilt our entire internal tools dashboard in three weeks using these components. The TypeScript types caught integration issues before they reached staging, and the accessibility defaults meant zero remediation work post-launch.",
            "Rebuilt our internal tools dashboard in three weeks",
            5, "RK"),
        new("t2", "Andre Santos", "Frontend Lead", "Notion",
            "We closed an entire Jira board of spacing and alignment bugs within the first sprint of adoption. Our designers stopped filing visual regression tickets on Monday mornings, which has honestly done more for team morale than any offsite.",
            "Closed an entire Jira board of spacing bugs in one sprint",
            5, "AS"),
        new("t3", "Mia Johansson", "Product Designer", "Stripe",
            "As a designer, I was skeptical about a component library matching our Figma system. These components map to our tokens perfectly. The handoff friction between design and engineering is essentially gone — we ship in hours now instead of days.",
            "Components map to our Figma tokens perfectly",
            5, "MJ"),
        new("t4", "Derek Huang", "CTO", "Resend",
            "We evaluated five options and this was the only one where every component worked with our existing Tailwind config out of the box. No theme conflicts, no CSS specificity battles, no custom wrappers — we dropped it in on a Friday and shipped on Monday.",
            "The only option that worked out of the box",
            5, "DH"),
        new("t5", "Zara Okafor", "Engineering Manager", "Linear",
            "Junior engineers ramp up in days instead of weeks. The API surface is consistent enough across components that learning one teaches you the patterns for all of them. Our onboarding doc shrunk from 40 pages to 6.",
            "Juniors ramp up in days instead of weeks",
            5, "ZO"),
    ];

    private string? _openId;

    private void Toggle(string id)
    {
        _openId = _openId == id ? null : id;
    }
}
