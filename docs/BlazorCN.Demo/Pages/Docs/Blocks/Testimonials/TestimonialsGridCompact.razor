@* ============================================================
   Block: testimonials-grid-compact
   Title: TestimonialsGridCompact
   Description: A dense masonry testimonial wall for React and Next.js with a centered marketing headline, multi-column break-inside layout, sparse star accents, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-grid-compact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Loved by engineering teams
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The teams shipping with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From two-person startups to public companies, here&rsquo;s what teams say after a year of
                deploying with us in production.
            </p>
        </div>

        @* Masonry wall *@
        <div class="mt-12 columns-1 gap-4 sm:columns-2 lg:columns-3 xl:columns-4">
            @foreach (var review in _reviews)
            {
                <figure class="mb-4 break-inside-avoid rounded-xl border bg-card p-5">
                    @if (review.Starred)
                    {
                        <div role="img" aria-label="5 out of 5 stars" class="mb-3 flex items-center gap-0.5">
                            @for (var s = 0; s < 5; s++)
                            {
                                <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" aria-hidden="true" />
                            }
                        </div>
                    }
                    <blockquote class="text-sm leading-relaxed text-foreground">
                        &ldquo;@review.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-4 flex items-center gap-3">
                        <div class="relative flex size-10 shrink-0 items-center justify-center overflow-hidden rounded-full border bg-muted">
                            <span class="font-mono text-xs font-semibold text-muted-foreground">
                                @review.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">@review.Name</p>
                            <p class="truncate text-xs text-muted-foreground">
                                @review.Role &middot; @review.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Review(string Id, string Name, string Initials, string Role, string Company, string Quote, bool Starred = false);

