@* ============================================================
   Block: testimonials-snippet
   Title: TestimonialsSnippet
   Description: A compact testimonials card grid for React and Next.js with short specific quotes, three-column responsive layout, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/testimonials/testimonials-snippet.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div>
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="font-medium text-muted-foreground text-xs uppercase tracking-widest">
                What developers say
            </p>
            <h2 class="mt-3 font-bold text-3xl tracking-tight sm:text-4xl lg:text-5xl">
                Short quotes. Specific numbers.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base text-muted-foreground leading-relaxed">
                Every line is a real engineer, a real team, a real before-and-after. No lorem ipsum, no
                marketing polish — just the receipts.
            </p>
        </div>

        @* Grid *@
        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var snip in _snippets)
            {
                <figure class="rounded-xl border bg-card p-6">
                    <blockquote class="text-base text-foreground leading-relaxed">
                        &ldquo;@snip.Quote&rdquo;
                    </blockquote>
                    <figcaption class="mt-6 flex items-center gap-3">
                        <div class="relative size-10 shrink-0 overflow-hidden rounded-full border bg-muted">
                            <span class="absolute inset-0 flex items-center justify-center font-mono font-semibold text-muted-foreground text-xs">
                                @snip.Initials
                            </span>
                        </div>
                        <div class="min-w-0">
                            <p class="truncate font-semibold text-foreground text-sm">@snip.Name</p>
                            <p class="truncate text-muted-foreground text-xs">
                                @snip.Role · @snip.Company
                            </p>
                        </div>
                    </figcaption>
                </figure>
            }
        </div>

        @* CTAs *@
        <div class="mt-10 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[220px]">Start your free trial</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[230px]">
                Read all stories
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Snippet(string Id, string Quote, string Name, string Initials, string Role, string Company);

    private static readonly Snippet[] _snippets =
    [
        new("s1",
            "We shipped our redesign in half the time we estimated. The PMs keep checking our math.",
            "Alex Rivera", "AR", "Staff Engineer", "Vercel"),
        new("s2",
            "Best TypeScript support of any library we evaluated. Our error count dropped 70% in a week.",
            "Maya Patel", "MP", "Engineering Lead", "Linear"),
        new("s3",
            "Our Lighthouse accessibility score jumped from 72 to 98 overnight. No regressions since.",
            "Jordan Lee", "JL", "Frontend Lead", "Clerk"),
        new("s4",
            "New engineers ship a real feature in their first week now. That used to take a month.",
            "Sam Okafor", "SO", "VP Engineering", "Resend"),
        new("s5",
            "Replaced three internal libraries with one package. Deleted 14,000 lines of code that day.",
            "David Kim", "DK", "Platform Engineer", "Supabase"),
        new("s6",
            "Bundle size dropped 40% after the migration. Time-to-interactive fell from 4.2s to 1.1s.",
            "Ravi Gupta", "RG", "Performance Lead", "Stripe"),
    ];
}
