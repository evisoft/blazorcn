@* ============================================================
   Block: map-space-launch-sites
   Title: MapSpaceLaunchSites
   Description: Interactive space launch facility globe map with launch pad markers, upcoming launch badges, agency info, and facility detail cards built with mapcn, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-space-launch-sites.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Launch Sites</span>
                <span class="text-xs text-muted-foreground">@_launchSites.Length facilities</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_activeSites active
                </span>
                <span class="text-xs text-muted-foreground">·</span>
                <span class="text-xs font-medium tabular-nums text-muted-foreground">
                    @_totalLaunches.ToString("N0") total launches
                </span>
            </div>
        </div>

        @* Globe Map placeholder *@
        <div class="relative h-[500px] overflow-hidden bg-muted/20">
            @* Subtle grid background to suggest a map *@
            <div class="absolute inset-0" style="background-image: linear-gradient(rgba(0,0,0,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.05) 1px, transparent 1px); background-size: 40px 40px;"></div>

            @* Map label *@
            <div class="absolute bottom-3 left-3 rounded-md bg-background/80 px-2 py-1 text-xs text-muted-foreground backdrop-blur-sm">
                Global Launch Facilities
            </div>

            @* Markers *@
            @foreach (var site in _launchSites)
            {
                var s = site;
                var leftPct = MapLonToPercent(s.Longitude) * 100;
                var topPct = MapLatToPercent(s.Latitude) * 100;
                <div class="absolute" style="@(FormattableString.Invariant($"left:{leftPct:F2}%; top:{topPct:F2}%; transform:translate(-50%,-50%)"))">
                    @* Marker *@
                    <button aria-label="View details for @s.Name"
                        type="button"
                        @onclick="@(() => _selected = (_selected == s.Id ? null : s.Id))"
                        class="relative flex size-5 items-center justify-center rounded-full border-2 border-white shadow-md @(AgencyColor(s.Agency))">
                        <LucideIconCn Name="rocket" Size="10" Class="size-2.5 text-white" />
                        @if (s.Status == "active")
                        {
                            <span class="absolute -right-0.5 -top-0.5 size-2 rounded-full border border-white bg-emerald-400"></span>
                        }
                    </button>

                    @* Tooltip *@
                    <div class="pointer-events-none absolute left-1/2 top-full mt-1 -translate-x-1/2 whitespace-nowrap rounded border bg-popover px-2 py-1 text-xs shadow-md">
                        <div class="flex items-center gap-1.5">
                            <span class="font-medium">@s.Name</span>
                            <span class="text-muted-foreground">@s.Agency</span>
                        </div>
                    </div>

                    @* Popup *@
                    @if (_selected == s.Id)
                    {
                        <div class="absolute left-1/2 top-full z-10 mt-7 w-60 -translate-x-1/2 rounded-md border bg-popover p-3 shadow-lg">
                            <div class="mb-2 flex items-start justify-between">
                                <div>
                                    <p class="text-sm font-medium">@s.Name</p>
                                    <p class="text-xs text-muted-foreground">@s.Country</p>
                                </div>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">@s.Agency</BadgeCn>
                            </div>
                            <div class="mb-2 flex items-center gap-2 text-xs text-muted-foreground">
                                <span class="flex items-center gap-1">
                                    <span class="@Cn.Merge("size-1.5 rounded-full", StatusDot(s.Status))"></span>
                                    @StatusLabel(s.Status)
                                </span>
                                <span>·</span>
                                <span>@s.Pads pads</span>
                                <span>·</span>
                                <span class="tabular-nums">@s.TotalLaunches launches</span>
                            </div>
                            <div class="rounded-md bg-muted/50 p-2">
                                <p class="text-xs font-medium text-muted-foreground">Next mission</p>
                                <p class="mt-0.5 text-sm font-medium">@s.NextMission</p>
                                <p class="text-xs text-muted-foreground">@s.NextDate</p>
                            </div>
                        </div>
                    }
                </div>
            }

            @* Controls placeholder *@
            <div class="absolute bottom-3 right-3 flex flex-col gap-1">
                <button type="button" class="flex size-7 items-center justify-center rounded border bg-background shadow-sm text-xs font-bold">+</button>
                <button type="button" class="flex size-7 items-center justify-center rounded border bg-background shadow-sm text-xs font-bold">−</button>
                <button aria-label="Reset map orientation" type="button" class="flex size-7 items-center justify-center rounded border bg-background shadow-sm">
                    <LucideIconCn Name="compass" Size="14" Class="size-3.5 text-muted-foreground" />
                </button>
            </div>
        </div>

        @* Site list *@
        <div>
            @for (var i = 0; i < _launchSites.Length; i++)
            {
                var site = _launchSites[i];
                var isLast = i == _launchSites.Length - 1;
                var isExpanded = _expanded == site.Id;
                var s = site;
                <div class="@(isLast && !isExpanded ? "" : "border-t")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = (isExpanded ? null : s.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", AgencyDot(s.Agency))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@s.Name</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @s.Agency · @s.Country
                            </p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">@StatusLabel(s.Status)</BadgeCn>
                        <span class="text-xs font-medium tabular-nums text-muted-foreground">
                            @s.TotalLaunches
                        </span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="grid grid-cols-3 gap-4 px-4 pb-4 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Launch pads</span>
                                <p class="mt-1 text-lg font-semibold tabular-nums">@s.Pads</p>
                            </div>
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Total launches</span>
                                <p class="mt-1 text-lg font-semibold tabular-nums">@s.TotalLaunches.ToString("N0")</p>
                            </div>
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Next mission</span>
                                <p class="mt-1 text-sm font-medium">@s.NextMission</p>
                                <p class="text-xs text-muted-foreground">@s.NextDate</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record LaunchSite(
        string Id,
        string Name,
        string Agency,
        string Country,
        double Longitude,
        double Latitude,
        int Pads,
        bool OrbitalCapable,
        int TotalLaunches,
        string NextMission,
        string NextDate,
        string Status
    );

    private static readonly LaunchSite[] _launchSites =
    [
        new("ls1", "Kennedy Space Center",    "NASA",      "United States", -80.6041,  28.5721, 4, true, 237,  "Artemis IV",              "Jun 2026", "active"),
        new("ls2", "Starbase Boca Chica",     "SpaceX",    "United States", -97.1561,  25.9974, 2, true,  48,  "Starship Flight 14",      "Apr 2026", "active"),
        new("ls3", "Guiana Space Centre",     "ESA",       "French Guiana", -52.7683,   5.2322, 3, true, 312,  "Ariane 6 VA264",          "May 2026", "active"),
        new("ls4", "Satish Dhawan Centre",    "ISRO",      "India",          80.2305,  13.7199, 2, true,  89,  "Gaganyaan G2",            "Jul 2026", "active"),
        new("ls5", "Tanegashima Space Center","JAXA",      "Japan",         131.0046,  30.4,    2, true,  54,  "H3 Flight 6",             "Aug 2026", "active"),
        new("ls6", "Baikonur Cosmodrome",     "Roscosmos", "Kazakhstan",     63.3425,  45.965,  6, true, 1543, "Soyuz MS-28",             "May 2026", "active"),
        new("ls7", "Vandenberg SFB",          "SpaceX",    "United States", -120.6103, 34.7561, 2, true, 102,  "Falcon 9 Starlink G12-8", "Apr 2026", "active"),
        new("ls8", "Wenchang Launch Site",    "ISRO",      "China",         110.9511,  19.6145, 3, true,  31,  "CZ-5B Y6",                "Jun 2026", "under-construction"),
    ];

    // World map bounding box (approx Web Mercator visible range)
    private const double _lonMin = -180.0;
    private const double _lonMax =  180.0;
    private const double _latMin = -60.0;
    private const double _latMax =  75.0;

    private string? _selected;
    private string? _expanded;

    private int _activeSites => _launchSites.Count(s => s.Status == "active");
    private int _totalLaunches => _launchSites.Sum(s => s.TotalLaunches);

    private static string AgencyColor(string agency) => agency switch
    {
        "NASA"      => "bg-blue-500",
        "SpaceX"    => "bg-slate-700 dark:bg-slate-400",
        "ESA"       => "bg-indigo-500",
        "ISRO"      => "bg-orange-500",
        "JAXA"      => "bg-rose-500",
        "Roscosmos" => "bg-red-600",
        _           => "bg-muted-foreground",
    };

    private static string AgencyDot(string agency) => agency switch
    {
        "NASA"      => "bg-blue-500",
        "SpaceX"    => "bg-slate-500",
        "ESA"       => "bg-indigo-500",
        "ISRO"      => "bg-orange-500",
        "JAXA"      => "bg-rose-500",
        "Roscosmos" => "bg-red-600",
        _           => "bg-muted-foreground",
    };

    private static string StatusLabel(string status) => status switch
    {
        "active"             => "Active",
        "standby"            => "Standby",
        "under-construction" => "Construction",
        _                    => status,
    };

    private static string StatusDot(string status) => status switch
    {
        "active"             => "bg-emerald-500",
        "standby"            => "bg-amber-500",
        "under-construction" => "bg-blue-400",
        _                    => "bg-muted-foreground",
    };

    private static double MapLonToPercent(double lon) => (lon - _lonMin) / (_lonMax - _lonMin);
    private static double MapLatToPercent(double lat) => 1.0 - (lat - _latMin) / (_latMax - _latMin);
}
