@* ============================================================
   Block: map-real-estate-listings
   Title: MapRealEstateListings
   Description: Interactive real estate map with price-colored markers, property type filters, listing cards with details, and detailed property popups built with mapcn, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-real-estate-listings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with filters *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="home" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Listings</span>
                <span class="text-xs text-muted-foreground">@_filtered.Length properties</span>
            </div>
            <div class="flex items-center gap-1.5">
                <button
                    type="button"
                    @onclick="@(() => _filter = null)"
                    class="@Cn.Merge("rounded-full px-2.5 py-0.5 text-xs transition-colors", _filter == null ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")">
                    All
                </button>
                @foreach (var t in _types)
                {
                    var typeVal = t;
                    <button
                        type="button"
                        @onclick="@(() => _filter = _filter == typeVal ? null : typeVal)"
                        class="@Cn.Merge("flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs transition-colors", _filter == typeVal ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")">
                        <span class="@Cn.Merge("size-1.5 rounded-full", TypeColor(typeVal))"></span>
                        @typeVal
                    </button>
                }
            </div>
        </div>

        @* Map *@
        <div class="relative h-[500px] bg-muted/30">
            @* Map background grid *@
            <div class="absolute inset-0 overflow-hidden">
                <svg class="h-full w-full opacity-10" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <pattern id="re-grid" width="40" height="40" patternUnits="userSpaceOnUse">
                            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1" />
                        </pattern>
                    </defs>
                    <rect width="100%" height="100%" fill="url(#re-grid)" />
                </svg>
            </div>

            @* Map controls (bottom-right) *@
            <div class="absolute bottom-3 right-3 z-10 flex flex-col gap-1">
                <button aria-label="Zoom in" type="button" class="flex size-8 items-center justify-center rounded border bg-card shadow-sm hover:bg-muted/50">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5 text-foreground" />
                </button>
                <button aria-label="Zoom out" type="button" class="flex size-8 items-center justify-center rounded border bg-card shadow-sm hover:bg-muted/50">
                    <LucideIconCn Name="minus" Size="14" Class="size-3.5 text-foreground" />
                </button>
                <button aria-label="Center map on current location" type="button" class="flex size-8 items-center justify-center rounded border bg-card shadow-sm hover:bg-muted/50">
                    <LucideIconCn Name="locate" Size="14" Class="size-3.5 text-foreground" />
                </button>
            </div>

            @* Listing markers *@
            @foreach (var l in _filtered)
            {
                var listing = l;
                var leftPct = (int)Math.Round((listing.Longitude - (-97.800)) / ((-97.730) - (-97.800)) * 82 + 5);
                var topPct = (int)Math.Round((30.280 - listing.Latitude) / (30.280 - 30.244) * 82 + 5);
                <div class="absolute z-10" style="@($"left:{leftPct}%;top:{topPct}%")">
                    <div class="relative">
                        @* Marker button *@
                        <button aria-label="View @listing.Type listing at @FormatPrice(listing.Price)"
                            type="button"
                            class="flex size-7 items-center justify-center rounded-full border-2 border-white shadow-md @(PriceColor(listing.Price))"
                            @onclick="@(() => ToggleSelected(listing.Id))">
                            <LucideIconCn Name="@TypeIcon(listing.Type)" Size="14" Class="size-3.5 text-white" />
                        </button>

                        @* Tooltip (always visible below marker as a small label) *@
                        <div class="pointer-events-none absolute left-1/2 top-full mt-1 -translate-x-1/2 whitespace-nowrap rounded bg-card/90 px-1.5 py-0.5 text-[10px] shadow">
                            <span class="font-medium">@FormatPrice(listing.Price)</span>
                            <span class="ml-1 text-muted-foreground">@listing.Type</span>
                        </div>

                        @* Popup card *@
                        @if (_selected == listing.Id)
                        {
                            <div class="absolute bottom-full left-1/2 mb-2 -translate-x-1/2 w-60 rounded-md border bg-card p-3 shadow-md z-20">
                                <div class="mb-2 flex items-start justify-between">
                                    <div>
                                        <p class="text-sm font-medium">@FormatPrice(listing.Price)</p>
                                        <p class="text-xs text-muted-foreground">@listing.Address</p>
                                    </div>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">@listing.Type</BadgeCn>
                                </div>
                                @if (listing.Type != "Land")
                                {
                                    <div class="mb-2 flex items-center gap-3">
                                        <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                            <LucideIconCn Name="bed-double" Size="12" Class="size-3" />
                                            @listing.Bedrooms bd
                                        </span>
                                        <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                            <LucideIconCn Name="bath" Size="12" Class="size-3" />
                                            @listing.Bathrooms ba
                                        </span>
                                        <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                            <LucideIconCn Name="maximize" Size="12" Class="size-3" />
                                            @listing.Sqft.ToString("N0") sqft
                                        </span>
                                    </div>
                                }
                                @if (listing.Type == "Land")
                                {
                                    <div class="mb-2 flex items-center gap-1 text-xs text-muted-foreground">
                                        <LucideIconCn Name="maximize" Size="12" Class="size-3" />
                                        @listing.Sqft.ToString("N0") sqft lot
                                    </div>
                                }
                                <div class="border-t pt-2">
                                    <span class="text-xs text-muted-foreground">
                                        @listing.DaysOnMarket days on market
                                    </span>
                                    @if (listing.DaysOnMarket <= 7)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-2 text-xs font-normal text-emerald-600 dark:text-emerald-400">New</BadgeCn>
                                    }
                                </div>
                                @* Close button *@
                                <button aria-label="Close details"
                                    type="button"
                                    class="absolute right-1.5 top-1.5 flex size-5 items-center justify-center rounded text-muted-foreground hover:bg-muted/50"
                                    @onclick="@(() => _selected = null)">
                                    <LucideIconCn Name="x" Size="12" Class="size-3" />
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer stats *@
        <div class="flex items-center gap-4 border-t px-4 py-2.5">
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Under $500K
            </span>
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                $500K - $750K
            </span>
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                Over $750K
            </span>
            <span class="ml-auto text-xs text-muted-foreground">
                Median: @FormatPrice(_medianPrice)
            </span>
        </div>
    </div>
</section>

@code {
    private record Listing(
        string Id, string Address, int Price,
        int Bedrooms, int Bathrooms, int Sqft,
        string Type, int DaysOnMarket,
        double Longitude, double Latitude);

    private static readonly string[] _types = ["House", "Condo", "Townhouse", "Land"];

    private static readonly Listing[] _listings =
    [
        new("l1", "742 Evergreen Terrace, Austin TX", 485000, 3, 2, 1850, "House", 4, -97.7431, 30.2672),
        new("l2", "1200 Congress Ave #14B, Austin TX", 725000, 2, 2, 1340, "Condo", 12, -97.7405, 30.2747),
        new("l3", "308 W 5th St, Austin TX", 1150000, 4, 3, 2800, "House", 2, -97.7489, 30.2669),
        new("l4", "55 Rainey St Unit 22, Austin TX", 560000, 1, 1, 890, "Condo", 21, -97.7389, 30.2588),
        new("l5", "4210 Barton Creek Blvd, Austin TX", 950000, 4, 3, 3200, "Townhouse", 7, -97.7955, 30.2605),
        new("l6", "12 Zilker Park Rd, Austin TX", 320000, 0, 0, 8500, "Land", 45, -97.773, 30.2665),
        new("l7", "901 E 6th St, Austin TX", 675000, 3, 2, 1720, "Townhouse", 9, -97.7328, 30.2655),
        new("l8", "2305 S Lamar Blvd, Austin TX", 415000, 2, 1, 1100, "House", 30, -97.7712, 30.2485),
    ];

    private string? _filter = null;
    private string? _selected = null;

    private Listing[] _filtered => _filter == null
        ? _listings
        : _listings.Where(l => l.Type == _filter).ToArray();

    private static int _medianPrice
    {
        get
        {
            var sorted = _listings.OrderBy(l => l.Price).ToArray();
            return sorted[sorted.Length / 2].Price;
        }
    }

    private void ToggleSelected(string id)
    {
        _selected = _selected == id ? null : id;
    }

    private static string PriceColor(int price)
    {
        if (price < 500000) return "bg-emerald-500";
        if (price < 750000) return "bg-amber-500";
        return "bg-red-500";
    }

    private static string TypeColor(string type) => type switch
    {
        "House" => "bg-blue-500",
        "Condo" => "bg-violet-500",
        "Townhouse" => "bg-amber-500",
        "Land" => "bg-emerald-500",
        _ => "bg-muted-foreground",
    };

    private static string TypeIcon(string type) => type switch
    {
        "House" => "home",
        "Condo" => "building",
        "Townhouse" => "building",
        "Land" => "trees",
        _ => "home",
    };

    private static string FormatPrice(int price)
    {
        if (price >= 1000000) return $"${(price / 1000000.0):F2}M";
        return $"${(price / 1000.0):F0}K";
    }
}
