@* ============================================================
   Block: map-broadband-coverage
   Title: MapBroadbandCoverage
   Description: Broadband coverage map with ISP markers, speed tier indicators, availability zones, and plan comparison popups built with mapcn, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-broadband-coverage.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="wifi" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Broadband Coverage</span>
                <span class="text-xs text-muted-foreground">San Francisco, CA</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="flex items-center gap-1 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Gigabit
                </span>
                <span class="flex items-center gap-1 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    Fast
                </span>
                <span class="flex items-center gap-1 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    Standard
                </span>
                <span class="flex items-center gap-1 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    Basic
                </span>
            </div>
        </div>

        <div class="flex">
            @* Provider sidebar *@
            <div class="w-64 shrink-0 border-r">
                <div class="border-b px-3 py-2">
                    <span class="text-xs font-medium text-muted-foreground">
                        @_providers.Length providers
                    </span>
                </div>
                <div class="divide-y">
                    @foreach (var prov in _providers)
                    {
                        var provider = prov;
                        bool isSelected = _selectedId == provider.Id;
                        <button
                            type="button"
                            @onclick="@(() => SelectProvider(provider))"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-3 py-2.5 text-left transition-colors hover:bg-muted/50", isSelected ? "bg-muted/50" : "")">
                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", SpeedTierColor(provider.DownloadMbps))"></span>
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">@provider.Name</span>
                                <div class="mt-0.5 flex items-center gap-2">
                                    <span class="text-[10px] text-muted-foreground">
                                        @TechLabel(provider.Tech)
                                    </span>
                                    <span class="text-[10px] text-muted-foreground">
                                        @provider.Subscribers users
                                    </span>
                                </div>
                                <div class="mt-0.5 flex items-center gap-2 text-[10px] text-muted-foreground">
                                    <span class="flex items-center gap-0.5">
                                        <LucideIconCn Name="arrow-down" Size="10" Class="size-2.5" />
                                        @provider.DownloadMbps Mbps
                                    </span>
                                    <span class="flex items-center gap-0.5">
                                        <LucideIconCn Name="arrow-up" Size="10" Class="size-2.5" />
                                        @provider.UploadMbps Mbps
                                    </span>
                                </div>
                            </div>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px] font-normal">
                                @SpeedTierLabel(provider.DownloadMbps)
                            </BadgeCn>
                        </button>
                    }
                </div>
            </div>

            @* Map placeholder — Map/MapRoute/MapMarker/MapPopup are React-only; rendered as styled placeholder *@
            <div class="relative h-[500px] flex-1 bg-muted/30 flex items-center justify-center">
                <div class="flex flex-col items-center gap-3 text-muted-foreground">
                    <LucideIconCn Name="map" Size="48" Class="size-12 opacity-30" />
                    <div class="text-center">
                        <p class="text-sm font-medium">Interactive Broadband Map</p>
                        <p class="text-xs opacity-70">San Francisco, CA · Coverage circles + ISP markers</p>
                    </div>
                    @* Provider marker dots legend *@
                    <div class="flex items-center gap-4 mt-2">
                        @foreach (var prov in _providers)
                        {
                            var provider = prov;
                            <div class="flex flex-col items-center gap-1">
                                <div class="@Cn.Merge("flex size-7 items-center justify-center rounded-full border-2 border-white shadow-md", SpeedTierColor(provider.DownloadMbps))">
                                    <LucideIconCn Name="@TechIcon(provider.Tech)" Size="14" Class="size-3.5 text-white" />
                                </div>
                                <span class="text-[9px]">@provider.Name.Split(' ')[0]</span>
                            </div>
                        }
                    </div>
                </div>

                @* Plan comparison popup *@
                @if (_popupProvider != null)
                {
                    var popup = _popupProvider;
                    <div class="absolute top-4 right-4 z-10 rounded-lg border bg-popover p-3 shadow-md">
                        <div class="w-60">
                            <div class="mb-1 flex items-center justify-between">
                                <span class="text-sm font-medium">@popup.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                    @TechLabel(popup.Tech)
                                </BadgeCn>
                            </div>
                            <div class="mb-2 flex items-center gap-3 text-xs text-muted-foreground">
                                <span class="flex items-center gap-0.5">
                                    <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                    @popup.DownloadMbps Mbps
                                </span>
                                <span class="flex items-center gap-0.5">
                                    <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                                    @popup.UploadMbps Mbps
                                </span>
                            </div>
                            <div class="border-t pt-2">
                                <span class="mb-1 block text-xs font-medium text-muted-foreground">
                                    Available plans
                                </span>
                                <div class="space-y-1.5">
                                    @foreach (var pl in popup.Plans)
                                    {
                                        var plan = pl;
                                        <div class="flex items-center justify-between rounded-md bg-muted/50 px-2 py-1.5">
                                            <div>
                                                <span class="text-xs font-medium">@plan.Name</span>
                                                <p class="text-[10px] text-muted-foreground">@plan.Speed</p>
                                            </div>
                                            <div class="text-right">
                                                <span class="text-xs font-medium tabular-nums">@plan.Price</span>
                                                <p class="text-[10px] text-muted-foreground">@plan.Contract</p>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                            <button
                                type="button"
                                @onclick="@(() => { _popupProvider = null; })"
                                class="mt-2 flex w-full items-center justify-center gap-1 rounded-md px-2 py-1 text-xs text-muted-foreground hover:bg-muted/50 transition-colors">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                                Close
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center gap-4 border-t px-4 py-2.5">
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                @_providers.Count(p => p.DownloadMbps >= 1000) gigabit
            </span>
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="size-1.5 rounded-full bg-blue-500"></span>
                @_providers.Count(p => p.DownloadMbps >= 500 && p.DownloadMbps < 1000) fast
            </span>
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                @_providers.Count(p => p.DownloadMbps >= 100 && p.DownloadMbps < 500) standard
            </span>
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                @_providers.Count(p => p.DownloadMbps < 100) basic
            </span>
            <span class="ml-auto text-xs text-muted-foreground">FCC Broadband Data</span>
        </div>
    </div>
</section>

@code {
    private string? _selectedId = null;
    private Provider? _popupProvider = null;

    private record Plan(string Name, string Speed, string Price, string Contract);
    private record Provider(string Id, string Name, string Tech, int DownloadMbps, int UploadMbps, double CoverageRadiusKm, double[] Center, string Subscribers, Plan[] Plans);

    private static readonly Provider[] _providers =
    [
        new("isp1", "LightStream Fiber", "fiber", 2000, 2000, 3.5, [-122.4194, 37.7749], "142K",
        [
            new("Starter", "500/500 Mbps", "$49/mo", "No contract"),
            new("Pro", "1000/1000 Mbps", "$69/mo", "No contract"),
            new("Ultra", "2000/2000 Mbps", "$99/mo", "No contract"),
        ]),
        new("isp2", "BayNet Cable", "cable", 600, 35, 4.0, [-122.4594, 37.7649], "98K",
        [
            new("Essentials", "200/10 Mbps", "$39/mo", "12 months"),
            new("Performance", "400/20 Mbps", "$59/mo", "12 months"),
            new("Gigabit", "600/35 Mbps", "$79/mo", "No contract"),
        ]),
        new("isp3", "Pacific DSL", "dsl", 80, 10, 5.0, [-122.3994, 37.7849], "31K",
        [
            new("Basic", "25/3 Mbps", "$29/mo", "No contract"),
            new("Plus", "50/5 Mbps", "$39/mo", "No contract"),
            new("Max", "80/10 Mbps", "$49/mo", "No contract"),
        ]),
        new("isp4", "SkyLink Wireless", "fixed-wireless", 300, 50, 6.0, [-122.4394, 37.8049], "17K",
        [
            new("Home", "100/20 Mbps", "$45/mo", "No contract"),
            new("Home Plus", "200/30 Mbps", "$65/mo", "No contract"),
            new("Home Max", "300/50 Mbps", "$85/mo", "No contract"),
        ]),
        new("isp5", "Golden Gate Fiber", "fiber", 5000, 5000, 2.5, [-122.4094, 37.7549], "58K",
        [
            new("Gig", "1000/1000 Mbps", "$59/mo", "No contract"),
            new("2 Gig", "2000/2000 Mbps", "$89/mo", "No contract"),
            new("5 Gig", "5000/5000 Mbps", "$149/mo", "No contract"),
        ]),
    ];

    private void SelectProvider(Provider provider)
    {
        _selectedId = provider.Id;
        _popupProvider = _popupProvider?.Id == provider.Id ? null : provider;
    }

    private static string SpeedTierColor(int mbps)
    {
        if (mbps >= 1000) return "bg-emerald-500";
        if (mbps >= 500) return "bg-blue-500";
        if (mbps >= 100) return "bg-amber-500";
        return "bg-red-500";
    }

    private static string SpeedTierLabel(int mbps)
    {
        if (mbps >= 1000) return "Gigabit";
        if (mbps >= 500) return "Fast";
        if (mbps >= 100) return "Standard";
        return "Basic";
    }

    private static string TechLabel(string tech) => tech switch
    {
        "fiber" => "Fiber",
        "cable" => "Cable",
        "dsl" => "DSL",
        "fixed-wireless" => "Fixed Wireless",
        _ => tech,
    };

    private static string TechIcon(string tech) => tech switch
    {
        "fiber" => "zap",
        "cable" => "globe",
        "dsl" => "signal",
        "fixed-wireless" => "wifi",
        _ => "wifi",
    };
}
