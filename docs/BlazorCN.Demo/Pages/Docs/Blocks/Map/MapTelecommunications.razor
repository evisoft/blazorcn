@* ============================================================
   Block: map-telecommunications
   Title: MapTelecommunications
   Description: Interactive telecommunications tower network map with tower markers, coverage zone indicators, 5G and 4G technology badges, signal strength data, and tower detail popups built with mapcn, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-telecommunications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="radio-tower" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Tower Network</span>
                <span class="text-xs text-muted-foreground">
                    San Francisco · @_activeCount/@_towers.Length active
                </span>
            </div>
            <div class="flex items-center gap-1.5">
                <button
                    type="button"
                    @onclick="@(() => _filter = null)"
                    class="@Cn.Merge("rounded-full px-2.5 py-0.5 text-xs transition-colors", _filter == null ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")">
                    All
                </button>
                @foreach (var tech in _techOptions)
                {
                    var t = tech;
                    <button
                        type="button"
                        @onclick="@(() => _filter = (_filter == t ? null : t))"
                        class="@Cn.Merge("flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs transition-colors", _filter == t ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")">
                        <span class="@Cn.Merge("size-1.5 rounded-full", TechColor(t))"></span>
                        @TechLabel(t)
                    </button>
                }
            </div>
        </div>

        @* Map + Sidebar *@
        <div class="flex">
            @* Map placeholder — Map/MapMarker/MarkerContent/MarkerTooltip/MarkerPopup are React-only; rendered as styled placeholder *@
            <div class="relative h-[500px] flex-1 bg-muted/30 flex items-center justify-center">
                <div class="flex flex-col items-center gap-3 text-muted-foreground">
                    <LucideIconCn Name="map" Size="48" Class="size-12 opacity-30" />
                    <div class="text-center">
                        <p class="text-sm font-medium">Interactive Tower Network Map</p>
                        <p class="text-xs opacity-70">San Francisco · Downtown, Mission, Sunset, Embarcadero, Golden Gate, SOMA, Potrero</p>
                    </div>
                    @* Tower marker dots *@
                    <div class="flex flex-wrap items-center justify-center gap-3 mt-2 max-w-xs">
                        @foreach (var tower in _filtered)
                        {
                            var tw = tower;
                            <div class="flex flex-col items-center gap-1">
                                <div class="@Cn.Merge("flex size-6 items-center justify-center rounded-full border-2 border-white shadow-md", tw.Status == "offline" ? "bg-muted-foreground/40" : TechColor(tw.Technology))">
                                    <LucideIconCn Name="radio-tower" Size="12" Class="size-3 text-white" />
                                </div>
                                <span class="text-[9px]">@tw.Name.Split(' ')[0]</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Tower list sidebar *@
            <div class="w-64 shrink-0 border-l">
                <div class="border-b px-4 py-3">
                    <span class="text-sm font-medium">Tower Sites</span>
                    <p class="text-xs text-muted-foreground">
                        @_filtered.Length towers · Metro Wireless
                    </p>
                </div>
                <div class="max-h-[430px] overflow-y-auto">
                    @foreach (var (tower, index) in _filtered.Select((t, i) => (t, i)))
                    {
                        var tw = tower;
                        bool isExpanded = _expandedSidebar == tw.Id;
                        bool isLast = index == _filtered.Length - 1;
                        <div class="@(isLast ? "" : "border-b")">
                            <button
                                type="button"
                                @onclick="@(() => { var id = tw.Id; _expandedSidebar = isExpanded ? null : id; _selected = id; })"
                                class="flex w-full items-center gap-2.5 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                                <span class="@Cn.Merge("size-2 shrink-0 rounded-full", tw.Status == "offline" ? StatusDot("offline") : TechColor(tw.Technology))"></span>
                                <div class="min-w-0 flex-1">
                                    <span class="text-xs font-medium">@tw.Name</span>
                                    <p class="truncate font-mono text-xs text-muted-foreground">
                                        @tw.SiteId · @StatusLabel(tw.Status)
                                    </p>
                                </div>
                                <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                            </button>
                            @if (isExpanded)
                            {
                                <div class="space-y-1 px-4 pb-3 pl-9">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">Technology</span>
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs font-normal">
                                            @TechLabel(tw.Technology)
                                        </BadgeCn>
                                    </div>
                                    @if (tw.Status != "offline")
                                    {
                                        <div class="flex items-center justify-between">
                                            <span class="text-xs text-muted-foreground">Signal</span>
                                            <span class="@Cn.Merge("text-xs font-medium tabular-nums", SignalColor(tw.SignalDbm))">
                                                @tw.SignalDbm dBm
                                            </span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-xs text-muted-foreground">Capacity</span>
                                            <span class="text-xs tabular-nums">@tw.Capacity</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-xs text-muted-foreground">Coverage</span>
                                            <span class="text-xs tabular-nums">@tw.CoverageKm km</span>
                                        </div>
                                    }
                                    <p class="pt-0.5 text-xs text-muted-foreground">
                                        Inspected @tw.LastInspection
                                    </p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center gap-4 border-t px-4 py-2.5">
            @foreach (var tech in _techOptions)
            {
                var t = tech;
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="@Cn.Merge("size-1.5 rounded-full", TechColor(t))"></span>
                    @TechLabel(t) (@TechCount(t))
                </span>
            }
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                Offline (@_towers.Count(tw => tw.Status == "offline"))
            </span>
        </div>
    </div>
</section>

@code {
    private string? _selected = null;
    private string? _filter = null;
    private string? _expandedSidebar = null;

    private record Tower(
        string Id, string Name, string SiteId, string Technology, string Status,
        int SignalDbm, double CoverageKm, int HeightM, string[] Bands,
        string Backhaul, string Capacity, string Carrier, string LastInspection,
        double Longitude, double Latitude);

    private static readonly Tower[] _towers =
    [
        new("tw1", "Downtown Core",      "SF-001", "5g", "active",   -62,  0.8, 45, ["n77", "n258", "n261"], "10G Fiber",  "4.2 Gbps", "Metro Wireless", "14 days ago",  -122.4014, 37.7879),
        new("tw2", "Mission District",   "SF-014", "4g", "active",   -78,  2.1, 35, ["B2", "B4", "B66"],     "1G Fiber",   "850 Mbps", "Metro Wireless", "8 days ago",   -122.4194, 37.7599),
        new("tw3", "Sunset Heights",     "SF-028", "4g", "degraded", -94,  1.8, 30, ["B2", "B12"],           "Microwave",  "420 Mbps", "Metro Wireless", "3 days ago",   -122.4937, 37.7539),
        new("tw4", "Embarcadero Plaza",  "SF-003", "5g", "active",   -58,  0.6, 52, ["n77", "n258"],         "10G Fiber",  "5.1 Gbps", "Metro Wireless", "21 days ago",  -122.3927, 37.7936),
        new("tw5", "Golden Gate Heights","SF-042", "3g", "active",  -105,  3.2, 28, ["B5"],                  "Microwave",  "42 Mbps",  "Metro Wireless", "30 days ago",  -122.4642, 37.7559),
        new("tw6", "SOMA Tech Hub",      "SF-007", "5g", "active",   -65,  0.9, 48, ["n77", "n258", "n261"], "10G Fiber",  "3.8 Gbps", "Metro Wireless", "10 days ago",  -122.3994, 37.7786),
        new("tw7", "Potrero Hill",       "SF-019", "4g", "offline",    0,  0.0, 32, ["B2", "B4"],            "1G Fiber",   "0 Mbps",   "Metro Wireless", "1 day ago",    -122.3914, 37.7614),
    ];

    private static readonly string[] _techOptions = ["5g", "4g", "3g"];

    private Tower[] _filtered => _filter == null ? _towers : _towers.Where(t => t.Technology == _filter).ToArray();
    private int _activeCount => _towers.Count(t => t.Status == "active");

    private static string TechColor(string tech) => tech switch
    {
        "5g" => "bg-blue-500",
        "4g" => "bg-emerald-500",
        "3g" => "bg-amber-500",
        _    => "bg-muted-foreground",
    };

    private static string TechLabel(string tech) => tech switch
    {
        "5g" => "5G NR",
        "4g" => "4G LTE",
        "3g" => "3G UMTS",
        _    => tech,
    };

    private static string StatusDot(string status) => status switch
    {
        "active"   => "bg-emerald-500",
        "degraded" => "bg-amber-500",
        "offline"  => "bg-red-500",
        _          => "bg-muted-foreground",
    };

    private static string StatusLabel(string status) => status switch
    {
        "active"   => "Active",
        "degraded" => "Degraded",
        "offline"  => "Offline",
        _          => status,
    };

    private static string SignalColor(int dbm)
    {
        if (dbm > -80) return "text-emerald-600 dark:text-emerald-400";
        if (dbm > -100) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private int TechCount(string tech) => _towers.Count(t => t.Technology == tech);
}
