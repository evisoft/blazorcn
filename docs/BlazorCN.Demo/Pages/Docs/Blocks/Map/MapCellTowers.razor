@* ============================================================
   Block: map-cell-towers
   Title: MapCellTowers
   Description: React cell tower coverage map block for Next.js with signal strength zones, tower markers, carrier badges, and coverage detail overlays using mapcn and shadcn/ui
   Source: original/blocks/map/map-cell-towers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="radio-tower" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Cell Tower Coverage</span>
                <span class="text-xs text-muted-foreground">· @_filtered.Length towers</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_counts["strong"]
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_counts["moderate"]
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_counts["weak"]
                </span>
            </div>
        </div>

        @* Carrier filter *@
        <div class="flex items-center gap-1.5 border-b px-4 py-2">
            <ButtonCn Variant="@(_filter == "all" ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" OnClick="@(() => _filter = "all")">
                All
            </ButtonCn>
            @foreach (var carrier in _carriers)
            {
                var c = carrier;
                <ButtonCn Variant="@(_filter == c ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" OnClick="@(() => _filter = (_filter == c ? "all" : c))">
                    @c
                </ButtonCn>
            }
        </div>

        @* Map placeholder — Map/MapMarker/MarkerContent/MarkerPopup are React-only components; rendered as a styled placeholder *@
        <div class="relative h-[460px] bg-muted/30 flex items-center justify-center">
            <div class="flex flex-col items-center gap-3 text-muted-foreground">
                <LucideIconCn Name="map" Size="48" Class="size-12 opacity-30" />
                <div class="text-center">
                    <p class="text-sm font-medium">Interactive Cell Tower Map</p>
                    <p class="text-xs opacity-70">San Francisco · Market St, Mission, SoMa, Sunset, Richmond, Bayview, Nob Hill, Potrero</p>
                </div>
                @* Tower dots legend *@
                <div class="flex items-center gap-4 mt-2">
                    @foreach (var tower in _filtered)
                    {
                        var towerItem = tower;
                        <div class="flex flex-col items-center gap-1">
                            <div class="flex items-center justify-center">
                                <div class="@Cn.Merge("size-3 rounded-full border-2 border-background shadow-sm", _signalDot[towerItem.Level])"></div>
                            </div>
                            <span class="text-[9px]">@towerItem.Name.Split(' ')[0]</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Tower list *@
        <div>
            @foreach (var (tower, index) in _filtered.Select((t, i) => (t, i)))
            {
                var towerItem = tower;
                bool isSelected = _selected == towerItem.Id;
                bool isLast = index == _filtered.Length - 1;
                <div class="@(isLast ? "" : "border-t")">
                    <button
                        type="button"
                        @onclick="@(() => { var id = towerItem.Id; _selected = isSelected ? null : id; })"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", _signalDot[towerItem.Level])"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@towerItem.Name</span>
                            <p class="mt-0.5 font-mono text-xs text-muted-foreground">@towerItem.Band</p>
                        </div>
                        <BadgeCn Class="@Cn.Merge("text-[10px] font-normal", _carrierColor[towerItem.Carrier])">
                            @towerItem.Carrier
                        </BadgeCn>
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="signal" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="@Cn.Merge("text-xs font-medium tabular-nums", _signalText[towerItem.Level])">
                                @towerItem.Signal dBm
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isSelected ? "rotate-90" : "")" />
                    </button>

                    @if (isSelected)
                    {
                        <div class="w-56 px-4 pb-4 pl-9">
                            <div class="mb-2 flex items-center gap-2">
                                <BadgeCn Class="@Cn.Merge("text-[10px] font-normal", _carrierColor[towerItem.Carrier])">
                                    @towerItem.Carrier
                                </BadgeCn>
                                <span class="font-mono text-[10px] text-muted-foreground">
                                    @towerItem.Band
                                </span>
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                                <div class="rounded bg-muted/50 p-2">
                                    <span class="text-[10px] text-muted-foreground">Signal</span>
                                    <p class="@Cn.Merge("text-sm font-semibold tabular-nums", _signalText[towerItem.Level])">
                                        @towerItem.Signal dBm
                                    </p>
                                </div>
                                <div class="rounded bg-muted/50 p-2">
                                    <span class="text-[10px] text-muted-foreground">Coverage</span>
                                    <p class="text-sm font-semibold tabular-nums">
                                        @towerItem.CoverageKm km
                                    </p>
                                </div>
                                <div class="rounded bg-muted/50 p-2">
                                    <span class="text-[10px] text-muted-foreground">Subscribers</span>
                                    <p class="text-sm font-semibold tabular-nums">
                                        @towerItem.Subscribers.ToString("N0")
                                    </p>
                                </div>
                                <div class="rounded bg-muted/50 p-2">
                                    <span class="text-[10px] text-muted-foreground">Uptime</span>
                                    <p class="text-sm font-semibold tabular-nums">@towerItem.Uptime</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _selected = null;
    private string _filter = "all";

    private record Tower(string Id, string Name, string Carrier, int Signal, string Level, string Band, int Subscribers, string Uptime, double CoverageKm);

    private static readonly Tower[] _towers =
    [
        new("t1", "Market St Tower",  "Verizon",  -62, "strong",   "C-Band 3.7 GHz",  14200, "99.97%", 2.4),
        new("t2", "Mission District", "T-Mobile", -74, "moderate", "n41 2.5 GHz",      9800, "99.91%", 3.1),
        new("t3", "SoMa Tower",       "AT&T",     -58, "strong",   "B14 700 MHz",     18400, "99.99%", 4.2),
        new("t4", "Sunset Relay",     "Verizon",  -88, "moderate", "B13 700 MHz",      6200, "99.84%", 3.8),
        new("t5", "Richmond Node",    "T-Mobile", -95, "weak",     "n71 600 MHz",      3100, "98.72%", 5.1),
        new("t6", "Bayview Tower",    "AT&T",     -81, "moderate", "B30 2.3 GHz",      7600, "99.88%", 2.8),
        new("t7", "Nob Hill Relay",   "Verizon",  -55, "strong",   "mmWave 28 GHz",   22100, "99.95%", 0.8),
        new("t8", "Potrero Hill",     "T-Mobile", -93, "weak",     "n25 1.9 GHz",      4100, "99.12%", 2.2),
    ];

    private static readonly string[] _carriers = ["Verizon", "T-Mobile", "AT&T"];

    private static readonly Dictionary<string, string> _signalDot = new()
    {
        ["strong"]   = "bg-emerald-500",
        ["moderate"] = "bg-amber-500",
        ["weak"]     = "bg-red-500",
    };

    private static readonly Dictionary<string, string> _signalText = new()
    {
        ["strong"]   = "text-emerald-600 dark:text-emerald-400",
        ["moderate"] = "text-amber-600 dark:text-amber-400",
        ["weak"]     = "text-red-600 dark:text-red-400",
    };

    private static readonly Dictionary<string, string> _carrierColor = new()
    {
        ["Verizon"]  = "bg-red-500/10 text-red-700 dark:text-red-400",
        ["T-Mobile"] = "bg-pink-500/10 text-pink-700 dark:text-pink-400",
        ["AT&T"]     = "bg-blue-500/10 text-blue-700 dark:text-blue-400",
    };

    private Tower[] _filtered => _filter == "all" ? _towers : _towers.Where(t => t.Carrier == _filter).ToArray();

    private Dictionary<string, int> _counts => new()
    {
        ["strong"]   = _filtered.Count(t => t.Level == "strong"),
        ["moderate"] = _filtered.Count(t => t.Level == "moderate"),
        ["weak"]     = _filtered.Count(t => t.Level == "weak"),
    };
}
