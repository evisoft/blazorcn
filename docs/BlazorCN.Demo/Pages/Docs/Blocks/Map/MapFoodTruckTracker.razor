@* ============================================================
   Block: map-food-truck-tracker
   Title: MapFoodTruckTracker
   Description: Food truck location tracker map block for Next.js with cuisine type markers, operating hours, menu preview popups, and real-time status indicators using mapcn map components and Tailwind CSS
   Source: original/blocks/map/map-food-truck-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="utensils" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Food Trucks</span>
                <span class="text-muted-foreground text-xs">San Francisco</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_openCount open
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_closingSoonCount closing soon
                </span>
            </div>
        </div>

        @* Cuisine filters *@
        <div class="flex items-center gap-1.5 border-b px-4 py-2">
            <button
                type="button"
                class="@(_selectedCuisine == null ? "rounded-md px-2 py-1 text-xs transition-colors bg-foreground text-background font-medium" : "rounded-md px-2 py-1 text-xs transition-colors text-muted-foreground hover:bg-muted/50")"
                @onclick="@(() => _selectedCuisine = null)">
                All
            </button>
            @foreach (var cuisine in _allCuisines)
            {
                var c = cuisine;
                var cfg = GetCuisineConfig(c);
                <button
                    type="button"
                    class="@(_selectedCuisine == c ? "flex items-center gap-1.5 rounded-md px-2 py-1 text-xs transition-colors bg-foreground text-background font-medium" : "flex items-center gap-1.5 rounded-md px-2 py-1 text-xs transition-colors text-muted-foreground hover:bg-muted/50")"
                    @onclick="@(() => _selectedCuisine = _selectedCuisine == c ? null : c)">
                    <span class="size-1.5 rounded-full" style="@($"background-color:{cfg.Color}")"></span>
                    @cfg.Label
                </button>
            }
        </div>

        @* Map + List *@
        <div class="flex">
            @* Map *@
            <div class="relative h-[480px] flex-1">
                <div class="absolute inset-0 overflow-hidden">
                    @* Simulated map background *@
                    <div class="h-full w-full bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900"></div>

                    @* Truck markers *@
                    @foreach (var truck in FilteredTrucks)
                    {
                        var t = truck;
                        var cfg = GetCuisineConfig(t.Cuisine);
                        var status = GetStatusConfig(t.Status);
                        var pos = GetMarkerPosition(t.Longitude, t.Latitude);
                        var isSelected = _selectedTruck == t.Id;
                        <div
                            class="absolute -translate-x-1/2 -translate-y-1/2"
                            style="@($"left:{pos.X:F1}%;top:{pos.Y:F1}%")">
                            <button
                                type="button"
                                class="relative"
                                title="@t.Name"
                                @onclick="@(() => ToggleTruck(t.Id))">
                                <div
                                    class="flex size-7 items-center justify-center rounded-full border-2 border-white font-bold text-white text-[10px] shadow-md"
                                    style="@($"background-color:{cfg.Color}")">
                                    @cfg.Emoji
                                </div>
                                <span class="@($"absolute -top-0.5 -right-0.5 size-2.5 rounded-full border border-white {status.Dot}")"></span>
                            </button>

                            @if (isSelected)
                            {
                                @* Popup *@
                                <div class="absolute left-1/2 top-full z-50 mt-1 w-60 -translate-x-1/2 rounded-lg border bg-card p-2.5 shadow-lg">
                                    <div class="mb-1 flex items-center justify-between">
                                        <span class="font-medium text-sm">@t.Name</span>
                                        <span class="flex items-center gap-0.5 text-xs">
                                            <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-400 text-amber-400" />
                                            @t.Rating
                                        </span>
                                    </div>
                                    <div class="mb-2 flex items-center gap-2">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">@cfg.Label</BadgeCn>
                                        <span class="flex items-center gap-1">
                                            <span class="@($"size-1.5 rounded-full {status.Dot}")"></span>
                                            <span class="text-[10px]">@status.Label</span>
                                        </span>
                                    </div>
                                    @* Menu preview *@
                                    <div class="mb-2 space-y-1">
                                        @foreach (var item in t.Menu)
                                        {
                                            var mi = item;
                                            <div class="flex items-center justify-between text-xs">
                                                <span class="flex items-center gap-1">
                                                    @mi.Name
                                                    @if (mi.Popular)
                                                    {
                                                        <LucideIconCn Name="flame" Size="10" Class="size-2.5 text-orange-500" />
                                                    }
                                                </span>
                                                <span class="font-medium tabular-nums">@mi.Price</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="flex items-center gap-1.5 text-muted-foreground text-[10px]">
                                        <LucideIconCn Name="clock" Size="10" Class="size-2.5" />
                                        @t.Hours
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <div class="absolute bottom-2 left-1/2 z-10 -translate-x-1/2 select-none rounded bg-background/70 px-2 py-1 text-xs text-muted-foreground pointer-events-none">
                        Map view — San Francisco
                    </div>
                </div>
            </div>

            @* Truck list *@
            <div class="w-60 shrink-0 border-l">
                <div class="max-h-[480px] overflow-y-auto">
                    @{ var filteredList = FilteredTrucks; }
                    @for (int i = 0; i < filteredList.Length; i++)
                    {
                        var truck = filteredList[i];
                        var t = truck;
                        var cfg = GetCuisineConfig(t.Cuisine);
                        var status = GetStatusConfig(t.Status);
                        var isSelected = _selectedTruck == t.Id;
                        var isLast = i == filteredList.Length - 1;
                        <div class="@(isLast ? "" : "border-b")">
                            <button
                                type="button"
                                class="@($"flex w-full items-start gap-2.5 px-4 py-3 text-left transition-colors hover:bg-muted/50{(isSelected ? " bg-muted/30" : "")}")"
                                @onclick="@(() => ToggleTruck(t.Id))">
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-1.5">
                                        <span
                                            class="size-1.5 shrink-0 rounded-full"
                                            style="@($"background-color:{cfg.Color}")"></span>
                                        <span class="font-medium text-xs">@t.Name</span>
                                    </div>
                                    <div class="mt-0.5 flex items-center gap-1.5 pl-3">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">@cfg.Label</BadgeCn>
                                        <span class="flex items-center gap-1 text-[10px]">
                                            <span class="@($"size-1.5 rounded-full {status.Dot}")"></span>
                                            <span class="text-muted-foreground">@status.Label</span>
                                        </span>
                                    </div>
                                    <div class="mt-1 flex items-center gap-2 pl-3">
                                        <span class="flex items-center gap-0.5 text-[10px]">
                                            <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-amber-400 text-amber-400" />
                                            @t.Rating
                                            <span class="text-muted-foreground">(@t.Reviews)</span>
                                        </span>
                                    </div>
                                    <div class="mt-1 flex items-center gap-1 pl-3 text-muted-foreground text-[10px]">
                                        <LucideIconCn Name="map-pin" Size="10" Class="size-2.5" />
                                        @t.Location
                                    </div>
                                </div>
                                <LucideIconCn
                                    Name="chevron-right"
                                    Size="14"
                                    Class="@($"mt-1 size-3.5 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isSelected ? " rotate-90" : "")}")" />
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record MenuItem(string Name, string Price, bool Popular = false);

    private record FoodTruck(
        string Id,
        string Name,
        string Cuisine,
        double Longitude,
        double Latitude,
        double Rating,
        int Reviews,
        string Status,
        string Hours,
        string Location,
        MenuItem[] Menu
    );

    private record CuisineConfig(string Color, string Label, string Emoji);
    private record StatusConfig(string Dot, string Label);

    private static readonly FoodTruck[] _trucks =
    [
        new("ft1", "Taco Libre",    "mexican",       -122.4194, 37.7749, 4.8, 342, "open",         "11 AM - 9 PM",     "Market St & 5th",          [new("Carnitas Tacos (3)", "$12", true), new("Birria Quesadilla", "$14", true), new("Elote Cup", "$6"), new("Horchata", "$4")]),
        new("ft2", "Bao Down",      "asian",         -122.4094, 37.7849, 4.6, 218, "open",         "11:30 AM - 8 PM",  "Union Square, Post St",    [new("Pork Belly Bao (2)", "$11", true), new("Crispy Chicken Bao (2)", "$10"), new("Dan Dan Noodles", "$13", true), new("Matcha Latte", "$5")]),
        new("ft3", "Smoke & Ember", "bbq",           -122.3994, 37.7699, 4.9, 456, "closing-soon", "11 AM - 3 PM",     "SoMa, Folsom & 4th",       [new("Brisket Plate", "$18", true), new("Pulled Pork Sandwich", "$14"), new("Mac & Cheese", "$7", true), new("Sweet Tea", "$3")]),
        new("ft4", "Pita Palace",   "mediterranean", -122.4294, 37.7799, 4.5, 167, "open",         "10 AM - 8 PM",     "Hayes Valley, Octavia",    [new("Lamb Shawarma Wrap", "$15", true), new("Falafel Plate", "$13"), new("Hummus & Pita", "$8"), new("Baklava", "$5")]),
        new("ft5", "Sugar Rush",    "dessert",       -122.4144, 37.7899, 4.7, 289, "closed",       "12 PM - 10 PM",    "Nob Hill, California St",  [new("Churro Ice Cream", "$9", true), new("Crème Brûlée Donut", "$7", true), new("Brownie Sundae", "$11"), new("Hot Chocolate", "$5")]),
        new("ft6", "Burger Bloc",   "american",      -122.4244, 37.7729, 4.4, 198, "open",         "11 AM - 9 PM",     "Mission, Valencia & 16th", [new("Classic Smash Burger", "$13", true), new("Truffle Fries", "$8", true), new("Nashville Hot Chicken", "$15"), new("Milkshake", "$7")]),
    ];

    private static readonly string[] _allCuisines = ["mexican", "asian", "bbq", "mediterranean", "dessert", "american"];

    private string? _selectedCuisine = null;
    private string? _selectedTruck = null;

    private int _openCount        => Array.FindAll(_trucks, t => t.Status == "open").Length;
    private int _closingSoonCount => Array.FindAll(_trucks, t => t.Status == "closing-soon").Length;

    private FoodTruck[] FilteredTrucks =>
        _selectedCuisine == null
            ? _trucks
            : Array.FindAll(_trucks, t => t.Cuisine == _selectedCuisine);

    private void ToggleTruck(string id)
    {
        _selectedTruck = _selectedTruck == id ? null : id;
    }

    private static CuisineConfig GetCuisineConfig(string cuisine) => cuisine switch
    {
        "mexican"       => new CuisineConfig("#ef4444", "Mexican",       "M"),
        "asian"         => new CuisineConfig("#f97316", "Asian",         "A"),
        "bbq"           => new CuisineConfig("#a855f7", "BBQ",           "B"),
        "mediterranean" => new CuisineConfig("#22c55e", "Mediterranean", "E"),
        "dessert"       => new CuisineConfig("#ec4899", "Dessert",       "D"),
        "american"      => new CuisineConfig("#3b82f6", "American",      "U"),
        _               => new CuisineConfig("#888888", cuisine,          "?"),
    };

    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        "open"         => new StatusConfig("bg-emerald-500", "Open"),
        "closing-soon" => new StatusConfig("bg-amber-500",   "Closing soon"),
        "closed"       => new StatusConfig("bg-red-500",     "Closed"),
        _              => new StatusConfig("bg-muted",       status),
    };

    // Map longitude/latitude to CSS percentage positions.
    // Viewport: lon [-122.44, -122.39], lat [40.765, 37.795]
    private static (double X, double Y) GetMarkerPosition(double longitude, double latitude)
    {
        const double lonMin = -122.44, lonMax = -122.39;
        const double latMin = 37.765,  latMax = 37.795;
        var x = (longitude - lonMin) / (lonMax - lonMin) * 100.0;
        var y = (1.0 - (latitude - latMin) / (latMax - latMin)) * 100.0;
        x = Math.Clamp(x, 3, 97);
        y = Math.Clamp(y, 3, 97);
        return (x, y);
    }
}
