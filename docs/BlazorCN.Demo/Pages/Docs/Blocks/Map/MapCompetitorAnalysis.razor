@* ============================================================
   Block: map-competitor-analysis
   Title: MapCompetitorAnalysis
   Description: React competitor analysis map block for Next.js with your store vs competitor markers, market share indicators, overlap zones, and comparison panel using mapcn map components, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-competitor-analysis.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="target" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Competitor Analysis</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_ownStores.Length ours
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_competitorStores.Length competitors
                </span>
                <span class="text-xs text-muted-foreground">·</span>
                <span class="flex items-center gap-1.5 text-xs text-amber-600 dark:text-amber-400">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_overlapCount overlaps
                </span>
            </div>
        </div>

        @* Filter bar *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            @foreach (var f in _filters)
            {
                var filterVal = f;
                <button
                    type="button"
                    @onclick="@(() => _filter = filterVal)"
                    class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _filter == filterVal ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:text-foreground")"
                >
                    @(filterVal == "all" ? "All locations" : filterVal == "own" ? "Our stores" : "Competitors")
                </button>
            }
            <div class="ml-auto flex items-center gap-2">
                @foreach (var b in _brands)
                {
                    var brand = b;
                    var dot = GetBrandDot(brand);
                    <span class="flex items-center gap-1 text-[10px] text-muted-foreground">
                        <span class="@($"size-1.5 rounded-full {dot}")"></span>
                        @brand
                    </span>
                }
            </div>
        </div>

        <div class="flex">
            @* Map placeholder *@
            <div class="relative h-[500px] flex-1">
                <div class="absolute inset-0 overflow-hidden">
                    @* Simulated map background *@
                    <div class="h-full w-full bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900"></div>
                    @* Store markers *@
                    @foreach (var loc in _filtered)
                    {
                        var location = loc;
                        var isSelected = _selected == location.Id;
                        var bg = GetBrandBg(location.Brand);
                        var pos = GetMarkerPosition(location.Longitude, location.Latitude);
                        <div
                            class="absolute -translate-x-1/2 -translate-y-1/2"
                            style="@(FormattableString.Invariant($"left:{pos.X}%;top:{pos.Y}%"))"
                        >
                            <button
                                type="button"
                                class="@Cn.Merge("relative flex items-center justify-center rounded-full border-2 border-background shadow-md transition-all", isSelected ? "size-8" : "size-6")"
                                style="@($"background-color:{bg}")"
                                @onclick="@(() => ToggleSelected(location.Id))"
                                title="@location.Name"
                            >
                                @if (location.Owner == "own")
                                {
                                    <LucideIconCn Name="store" Size="@(isSelected ? 16 : 12)" Class="@Cn.Merge("text-white", isSelected ? "size-4" : "size-3")" />
                                }
                                else
                                {
                                    <LucideIconCn Name="building" Size="@(isSelected ? 16 : 12)" Class="@Cn.Merge("text-white", isSelected ? "size-4" : "size-3")" />
                                }
                                @if (location.Overlap)
                                {
                                    <span class="absolute -top-0.5 -right-0.5 size-2 rounded-full border border-background bg-amber-500"></span>
                                }
                            </button>
                            @* Tooltip on select *@
                            @if (isSelected)
                            {
                                <div class="absolute left-1/2 z-10 mt-1.5 w-52 -translate-x-1/2 rounded-md border bg-popover p-2.5 shadow-lg text-popover-foreground">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium">@location.Name</span>
                                        <span class="text-xs text-muted-foreground">@location.Brand</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="pointer-events-none select-none absolute bottom-2 left-2 z-10 rounded bg-background/70 px-2 py-1 text-xs text-muted-foreground">
                    Map view — New York, NY
                </div>
            </div>

            @* Sidebar *@
            <div class="w-56 shrink-0 border-l">
                <div class="border-b px-3 py-2">
                    <span class="text-xs font-medium text-muted-foreground">
                        @_filtered.Length locations
                    </span>
                </div>
                <div class="max-h-[462px] overflow-y-auto">
                    @foreach (var loc in _filtered)
                    {
                        var location = loc;
                        var isExpanded = _selected == location.Id;
                        var dot = GetBrandDot(location.Brand);
                        <div class="border-b">
                            <button
                                type="button"
                                @onclick="@(() => ToggleSelected(location.Id))"
                                class="@Cn.Merge("flex w-full flex-col gap-0.5 px-3 py-2.5 text-left transition-colors hover:bg-muted/50", isExpanded ? "bg-muted/50" : "")"
                            >
                                <div class="flex items-center gap-2">
                                    <span class="@($"size-1.5 shrink-0 rounded-full {dot}")"></span>
                                    <span class="truncate text-sm font-medium">@location.Name</span>
                                </div>
                                <div class="flex items-center gap-2 pl-3.5">
                                    <span class="text-xs text-muted-foreground">@location.Brand</span>
                                    @if (location.Overlap)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-3.5 px-1 text-[9px] font-normal text-amber-600 dark:text-amber-400">overlap</BadgeCn>
                                    }
                                </div>
                            </button>

                            @if (isExpanded)
                            {
                                <div class="space-y-2 px-3 pb-3">
                                    <div class="rounded-md bg-muted/50 p-2.5">
                                        <div class="flex items-center justify-between">
                                            <span class="text-xs text-muted-foreground">Revenue</span>
                                            <span class="text-xs font-medium tabular-nums">@location.Revenue</span>
                                        </div>
                                        <div class="mt-1.5 flex items-center justify-between">
                                            <span class="text-xs text-muted-foreground">Foot traffic</span>
                                            <span class="text-xs font-medium tabular-nums">@location.FootTraffic.ToString("N0")/wk</span>
                                        </div>
                                        <div class="mt-1.5 flex items-center justify-between">
                                            <span class="text-xs text-muted-foreground">Rating</span>
                                            <span class="text-xs font-medium tabular-nums">@location.Rating/5.0</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record StoreLocation(
        string Id,
        string Name,
        string Owner,
        string Brand,
        double Longitude,
        double Latitude,
        string Revenue,
        int FootTraffic,
        double Rating,
        bool Overlap
    );

    private static readonly StoreLocation[] _locations =
    [
        new("s1", "Downtown Flagship",  "own",        "Our Brand",  -73.9857, 40.7484, "$2.4M/yr", 14200, 4.6, true),
        new("s2", "Midtown Express",    "own",        "Our Brand",  -73.9787, 40.7589, "$1.8M/yr",  9800, 4.3, false),
        new("s3", "Brooklyn Heights",   "own",        "Our Brand",  -73.9936, 40.6959, "$1.1M/yr",  6400, 4.5, true),
        new("s4", "Upper East Store",   "own",        "Our Brand",  -73.9565, 40.7736, "$1.5M/yr",  8100, 4.4, false),
        new("c1", "QuickMart Herald Sq","competitor", "QuickMart",  -73.9876, 40.7497, "$1.9M/yr", 11500, 4.1, true),
        new("c2", "QuickMart Dumbo",    "competitor", "QuickMart",  -73.9877, 40.7033, "$1.3M/yr",  7200, 3.9, true),
        new("c3", "FreshStop Tribeca",  "competitor", "FreshStop",  -74.0084, 40.7163, "$2.1M/yr", 12800, 4.4, false),
        new("c4", "FreshStop Chelsea",  "competitor", "FreshStop",  -74.0014, 40.7465, "$1.6M/yr",  9100, 4.2, false),
        new("c5", "GreenGrocer SoHo",   "competitor", "GreenGrocer",-73.9992, 40.7234, "$1.4M/yr",  8600, 4.5, false),
        new("c6", "GreenGrocer UWS",    "competitor", "GreenGrocer",-73.9762, 40.7831, "$1.7M/yr", 10300, 4.3, false),
    ];

    private static readonly string[] _filters = ["all", "own", "competitor"];

    private static readonly string[] _brands = ["Our Brand", "QuickMart", "FreshStop", "GreenGrocer"];

    private static string GetBrandDot(string brand) => brand switch
    {
        "Our Brand"   => "bg-blue-500",
        "QuickMart"   => "bg-red-500",
        "FreshStop"   => "bg-amber-500",
        "GreenGrocer" => "bg-emerald-500",
        _             => "bg-muted",
    };

    private static string GetBrandBg(string brand) => brand switch
    {
        "Our Brand"   => "#3b82f6",
        "QuickMart"   => "#ef4444",
        "FreshStop"   => "#f59e0b",
        "GreenGrocer" => "#22c55e",
        _             => "#6b7280",
    };

    private string _filter   = "all";
    private string? _selected = null;

    private StoreLocation[] _filtered => _filter switch
    {
        "own"        => Array.FindAll(_locations, l => l.Owner == "own"),
        "competitor" => Array.FindAll(_locations, l => l.Owner == "competitor"),
        _            => _locations,
    };

    private StoreLocation[] _ownStores        => Array.FindAll(_locations, l => l.Owner == "own");
    private StoreLocation[] _competitorStores => Array.FindAll(_locations, l => l.Owner == "competitor");
    private int             _overlapCount     => Array.FindAll(_locations, l => l.Overlap && l.Owner == "own").Length;

    private void ToggleSelected(string id)
    {
        _selected = _selected == id ? null : id;
    }

    // Map longitude/latitude to CSS percentage positions within the placeholder div.
    // Viewport: lon [-74.03, -73.94], lat [40.68, 40.80]
    private static (double X, double Y) GetMarkerPosition(double longitude, double latitude)
    {
        const double lonMin = -74.03, lonMax = -73.94;
        const double latMin = 40.68,  latMax = 40.80;
        var x = (longitude - lonMin) / (lonMax - lonMin) * 100.0;
        var y = (1.0 - (latitude - latMin) / (latMax - latMin)) * 100.0;
        x = Math.Clamp(x, 5, 90);
        y = Math.Clamp(y, 5, 90);
        return (x, y);
    }
}
