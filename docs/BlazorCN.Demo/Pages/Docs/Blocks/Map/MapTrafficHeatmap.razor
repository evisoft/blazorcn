@* ============================================================
   Block: map-traffic-heatmap
   Title: MapTrafficHeatmap
   Description: Interactive website traffic origin heatmap with globe view, country-sized markers, visitor count tooltips, and top countries panel built with mapcn, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-traffic-heatmap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Traffic Origins</span>
                <span class="text-xs text-muted-foreground">@_countries.Length countries</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-2xl font-semibold tabular-nums">
                    @((_totalVisitors / 1000.0).ToString("0"))k
                </span>
                <span class="text-xs text-muted-foreground">visitors this month</span>
            </div>
        </div>

        @* Globe Map — Map/MapMarker/MarkerContent/MarkerTooltip/MarkerPopup are not available in BlazorCN; rendered as a styled world-map placeholder with positioned markers *@
        <div class="relative h-[500px]">
            <div class="absolute inset-0 overflow-hidden">
                @* Simulated globe map background *@
                <div class="h-full w-full bg-gradient-to-br from-sky-100 via-blue-100 to-indigo-200 dark:from-slate-800 dark:via-slate-800 dark:to-slate-900"></div>

                @* Country markers *@
                @foreach (var country in _countries)
                {
                    var c = country;
                    var size = GetMarkerSize(c.Visitors);
                    var opacity = GetOpacity(c.Visitors);
                    var pos = GetCountryPosition(c.Id);
                    var isSelected = _selected == c.Id;
                    <button
                        type="button"
                        class="absolute flex size-6 items-center justify-center -translate-x-1/2 -translate-y-1/2 transition-transform hover:scale-110 focus:outline-none"
                        style="@(FormattableString.Invariant($"left:{pos.X}%;top:{pos.Y}%;outline:none"))"
                        @onclick="@(() => _selected = (_selected == c.Id ? null : c.Id))"
                        title="@c.Name — @((c.Visitors / 1000.0).ToString("0.0"))k visitors"
                    >
                        <span
                            class="rounded-full bg-blue-500 shadow-md"
                            style="@($"width:{size}px;height:{size}px;opacity:{opacity.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)}")"
                        ></span>
                    </button>
                }

                @* Marker popup for selected country *@
                @if (_activeCountry != null)
                {
                    var active = _activeCountry;
                    var pos = GetCountryPosition(active.Id);
                    <div
                        class="absolute z-20 w-56 rounded-md border bg-popover p-3 shadow-md text-popover-foreground"
                        style="@(FormattableString.Invariant($"left:{pos.X}%;top:{pos.Y}%;transform:translate(-50%, calc(-100% - 16px))"))"
                    >
                        <div class="mb-2 flex items-start justify-between">
                            <div>
                                <p class="text-sm font-medium">@active.Name</p>
                                <p class="text-xs text-muted-foreground">@active.Code</p>
                            </div>
                            <span class="@Cn.Merge("text-xs font-medium tabular-nums", active.PctChange >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                @(active.PctChange >= 0 ? "+" : "")@(active.PctChange)%
                            </span>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <div class="rounded-md bg-muted/50 p-2">
                                <p class="text-xs text-muted-foreground">Visitors</p>
                                <p class="text-sm font-semibold tabular-nums">@active.Visitors.ToString("N0")</p>
                            </div>
                            <div class="rounded-md bg-muted/50 p-2">
                                <p class="text-xs text-muted-foreground">Sessions</p>
                                <p class="text-sm font-semibold tabular-nums">@active.Sessions.ToString("N0")</p>
                            </div>
                            <div class="rounded-md bg-muted/50 p-2">
                                <p class="text-xs text-muted-foreground">Bounce</p>
                                <p class="text-sm font-semibold tabular-nums">@active.BounceRate%</p>
                            </div>
                            <div class="rounded-md bg-muted/50 p-2">
                                <p class="text-xs text-muted-foreground">Avg time</p>
                                <p class="text-sm font-semibold tabular-nums">@active.AvgDuration</p>
                            </div>
                        </div>
                        <button aria-label="Close details" type="button" class="absolute right-2 top-2 text-muted-foreground hover:text-foreground" @onclick="@(() => _selected = null)">
                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                        </button>
                    </div>
                }
            </div>
            <div class="absolute bottom-2 right-2 z-10 pointer-events-none select-none rounded bg-background/70 px-2 py-1 text-xs text-muted-foreground">
                Globe view — World traffic
            </div>
        </div>

        @* Top countries list *@
        <div>
            @{
                var sorted = _countries.OrderByDescending(c => c.Visitors).ToArray();
            }
            @for (int idx = 0; idx < sorted.Length; idx++)
            {
                var country = sorted[idx];
                var index = idx;
                var isExpanded = _expanded == country.Id;
                var isLast = index == sorted.Length - 1;
                var share = (int)Math.Round((double)country.Visitors / _totalVisitors * 100);
                var opacityVal = GetOpacity(country.Visitors);
                <div class="@((isLast && !isExpanded) ? "" : "border-t")">
                    <button
                        type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expanded = (_expanded == country.Id ? null : country.Id))"
                    >
                        <span class="w-5 text-xs font-medium tabular-nums text-muted-foreground">@(index + 1)</span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@country.Name</span>
                            <div class="mt-1 flex items-center gap-2">
                                <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div
                                        class="h-full rounded-full bg-blue-500"
                                        style="@($"width:{share}%;opacity:{opacityVal.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)}")"
                                    ></div>
                                </div>
                                <span class="w-8 text-right text-xs tabular-nums text-muted-foreground">@(share)%</span>
                            </div>
                        </div>
                        <span class="text-xs font-medium tabular-nums">@((country.Visitors / 1000.0).ToString("0.0"))k</span>
                        <span class="@Cn.Merge("text-xs tabular-nums", country.PctChange >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                            @(country.PctChange >= 0 ? "+" : "")@(country.PctChange)%
                        </span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="grid grid-cols-4 gap-3 px-4 pb-4 pl-12">
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Sessions</span>
                                <p class="mt-1 text-sm font-semibold tabular-nums">@country.Sessions.ToString("N0")</p>
                            </div>
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Bounce rate</span>
                                <p class="mt-1 text-sm font-semibold tabular-nums">@country.BounceRate%</p>
                            </div>
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Avg duration</span>
                                <p class="mt-1 text-sm font-semibold tabular-nums">@country.AvgDuration</p>
                            </div>
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Top page</span>
                                <p class="mt-1 truncate font-mono text-xs">@country.TopPage</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TrafficCountry(
        string Id, string Name, string Code,
        double Longitude, double Latitude,
        int Visitors, int Sessions,
        double BounceRate, string AvgDuration,
        string TopPage, double PctChange);

    private static readonly TrafficCountry[] _countries =
    [
        new("c1",  "United States", "US",  -98.5795,  39.8283, 142800, 218400, 38.2, "4m 12s", "/pricing",             12.4),
        new("c2",  "United Kingdom","GB",   -3.436,   55.3781,  48200,  71300, 41.6, "3m 48s", "/docs",                 8.1),
        new("c3",  "Germany",       "DE",   10.4515,  51.1657,  36500,  52100, 35.9, "4m 32s", "/blog",                15.7),
        new("c4",  "India",         "IN",   78.9629,  20.5937,  31200,  43800, 52.1, "2m 56s", "/docs/getting-started",24.3),
        new("c5",  "Canada",        "CA", -106.3468,  56.1304,  27800,  39200, 39.8, "3m 59s", "/pricing",              6.2),
        new("c6",  "Brazil",        "BR",  -51.9253, -14.235,   19400,  26100, 48.3, "2m 41s", "/templates",           31.5),
        new("c7",  "France",        "FR",    2.2137,  46.2276,  22100,  31600, 37.4, "4m 05s", "/docs",                 9.8),
        new("c8",  "Japan",         "JP",  138.2529,  36.2048,  18700,  25400, 33.2, "5m 18s", "/components",           4.6),
        new("c9",  "Australia",     "AU",  133.7751, -25.2744,  15900,  22800, 40.1, "3m 34s", "/pricing",             11.2),
        new("c10", "South Korea",   "KR",  127.7669,  35.9078,  12400,  17600, 36.7, "4m 44s", "/docs/api",            18.9),
    ];

    private static readonly int _maxVisitors = _countries.Max(c => c.Visitors);
    private static readonly int _totalVisitors = _countries.Sum(c => c.Visitors);

    private string? _selected = null;
    private string? _expanded = null;

    private TrafficCountry? _activeCountry => _selected != null
        ? Array.Find(_countries, c => c.Id == _selected)
        : null;

    private static int GetMarkerSize(int visitors)
    {
        const int min = 8;
        const int max = 28;
        return (int)Math.Round(min + (double)visitors / _maxVisitors * (max - min));
    }

    private static double GetOpacity(int visitors) =>
        0.5 + (double)visitors / _maxVisitors * 0.5;

    // Approximate world-map % positions (lon [-180,180] -> x [0,100], lat [85,-85] -> y [0,100])
    private static (double X, double Y) GetCountryPosition(string id) => id switch
    {
        "c1"  => (18.0, 35.0),  // United States
        "c2"  => (47.5, 22.0),  // United Kingdom
        "c3"  => (51.0, 24.0),  // Germany
        "c4"  => (72.0, 40.0),  // India
        "c5"  => (16.0, 20.0),  // Canada
        "c6"  => (29.0, 65.0),  // Brazil
        "c7"  => (50.0, 26.0),  // France
        "c8"  => (82.5, 27.0),  // Japan
        "c9"  => (76.5, 68.0),  // Australia
        "c10" => (81.0, 28.5),  // South Korea
        _     => (50.0, 50.0),
    };
}
