@* ============================================================
   Block: map-restaurant-finder
   Title: MapRestaurantFinder
   Description: Interactive restaurant discovery map with cuisine type markers, rating stars, price range indicators, and restaurant detail popups built with mapcn, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-restaurant-finder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="utensils" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Restaurants</span>
                <span class="text-xs text-muted-foreground">@_filtered.Length places</span>
            </div>
            <div class="flex items-center gap-1.5">
                <button
                    type="button"
                    class="@Cn.Merge("rounded-full px-2.5 py-0.5 text-xs transition-colors", _filter == null ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")"
                    @onclick="@(() => _filter = null)">
                    All
                </button>
                @foreach (var cuisine in _cuisines)
                {
                    var c = cuisine;
                    <button
                        type="button"
                        class="@Cn.Merge("flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs transition-colors", _filter == c ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")"
                        @onclick="@(() => _filter = (_filter == c ? null : c))">
                        <span class="@Cn.Merge("size-1.5 rounded-full", CuisineColor(c))" />
                        @c
                    </button>
                }
            </div>
        </div>

        @* Map *@
        <div class="relative h-[500px] bg-muted/30">
            @* Map background grid to suggest map tiles *@
            <div class="absolute inset-0 overflow-hidden">
                <svg class="h-full w-full opacity-10" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <pattern id="restaurant-grid" width="40" height="40" patternUnits="userSpaceOnUse">
                            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1" />
                        </pattern>
                    </defs>
                    <rect width="100%" height="100%" fill="url(#restaurant-grid)" />
                </svg>
            </div>

            @* Map controls placeholder (bottom-right) *@
            <div class="absolute bottom-3 right-3 z-10 flex flex-col gap-1">
                <button type="button" class="flex size-8 items-center justify-center rounded border bg-card shadow-sm hover:bg-muted/50">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5 text-foreground" />
                </button>
                <button type="button" class="flex size-8 items-center justify-center rounded border bg-card shadow-sm hover:bg-muted/50">
                    <LucideIconCn Name="minus" Size="14" Class="size-3.5 text-foreground" />
                </button>
                <button type="button" class="flex size-8 items-center justify-center rounded border bg-card shadow-sm hover:bg-muted/50">
                    <LucideIconCn Name="locate" Size="14" Class="size-3.5 text-foreground" />
                </button>
            </div>

            @* Restaurant markers *@
            @* Map bounds: lng [-74.008, -73.986], lat [40.720, 40.734] *@
            @foreach (var restaurant in _filtered)
            {
                var r = restaurant;
                var leftPct = (int)Math.Round((r.Longitude - (-74.008)) / ((-73.986) - (-74.008)) * 80 + 5);
                var topPct  = (int)Math.Round((40.734 - r.Latitude) / (40.734 - 40.720) * 80 + 5);
                <div class="absolute z-10" style="@($"left:{leftPct}%;top:{topPct}%")">
                    <div class="relative">
                        @* Marker *@
                        <button
                            type="button"
                            class="@Cn.Merge("flex size-6 items-center justify-center rounded-full border-2 border-white shadow-md", CuisineColor(r.Cuisine))"
                            @onclick="@(() => _selected = (_selected == r.Id ? null : r.Id))">
                            <LucideIconCn Name="utensils" Size="12" Class="size-3 text-white" />
                        </button>

                        @* Popup card *@
                        @if (_selected == r.Id)
                        {
                            <div class="absolute bottom-full left-1/2 mb-2 -translate-x-1/2 w-56 rounded-md border bg-card p-3 shadow-md">
                                <div class="mb-2 flex items-start justify-between">
                                    <div>
                                        <p class="text-sm font-medium">@r.Name</p>
                                        <p class="text-xs text-muted-foreground">@r.Cuisine</p>
                                    </div>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">@PriceLabel(r.PriceRange)</BadgeCn>
                                </div>
                                <div class="mb-2 flex items-center gap-2">
                                    <div class="flex items-center gap-0.5">
                                        <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-400 text-amber-400" />
                                        <span class="text-xs font-medium tabular-nums">@r.Rating</span>
                                    </div>
                                    <span class="text-xs text-muted-foreground">·</span>
                                    <div class="flex items-center gap-1">
                                        <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="text-xs text-muted-foreground">@r.Hours</span>
                                    </div>
                                </div>
                                <div class="mb-2 flex items-start gap-1">
                                    <LucideIconCn Name="map-pin" Size="12" Class="mt-0.5 size-3 shrink-0 text-muted-foreground" />
                                    <span class="text-xs text-muted-foreground">@r.Address</span>
                                </div>
                                <div class="border-t pt-2">
                                    <p class="mb-1 text-xs font-medium text-muted-foreground">Popular dishes</p>
                                    <div class="flex flex-wrap gap-1">
                                        @foreach (var dish in r.TopDishes)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs font-normal">@dish</BadgeCn>
                                        }
                                    </div>
                                </div>
                                @* Close button *@
                                <button
                                    type="button"
                                    class="absolute right-1.5 top-1.5 flex size-5 items-center justify-center rounded text-muted-foreground hover:bg-muted/50"
                                    @onclick="@(() => _selected = null)">
                                    <LucideIconCn Name="x" Size="12" Class="size-3" />
                                </button>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer stats *@
        <div class="flex items-center gap-4 border-t px-4 py-2.5">
            @foreach (var cuisine in _cuisines)
            {
                var c = cuisine;
                var cnt = _restaurants.Count(r => r.Cuisine == c);
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="@Cn.Merge("size-1.5 rounded-full", CuisineColor(c))" />
                    @c (@cnt)
                </span>
            }
        </div>
    </div>
</section>

@code {
    private record Restaurant(
        string Id, string Name, string Cuisine,
        double Rating, int PriceRange,
        string Address, string Hours, string[] TopDishes,
        double Longitude, double Latitude);

    private static readonly Restaurant[] _restaurants =
    [
        new("r1", "Trattoria Bella",  "Italian",  4.7, 3, "142 W Houston St, New York",  "11:30 AM - 10:00 PM", ["Truffle Risotto", "Osso Buco", "Tiramisu"],          -74.0005, 40.7282),
        new("r2", "Sakura Omakase",   "Japanese", 4.9, 4, "87 E 4th St, New York",       "5:30 PM - 11:00 PM",  ["Omakase Set", "A5 Wagyu", "Uni Sashimi"],            -73.9905, 40.7265),
        new("r3", "Casa Oaxaca",      "Mexican",  4.5, 2, "236 E 9th St, New York",      "12:00 PM - 11:00 PM", ["Mole Negro", "Birria Tacos", "Churros"],             -73.9865, 40.7302),
        new("r4", "Lotus Bangkok",    "Thai",     4.3, 2, "54 Carmine St, New York",     "11:00 AM - 10:30 PM", ["Pad See Ew", "Green Curry", "Mango Sticky Rice"],    -74.003,  40.7305),
        new("r5", "Le Petit Bistro",  "French",   4.6, 3, "310 Bleecker St, New York",   "5:00 PM - 11:00 PM",  ["Duck Confit", "Bouillabaisse", "Creme Brulee"],      -74.0045, 40.7325),
        new("r6", "Saffron Palace",   "Indian",   4.4, 2, "101 E 6th St, New York",      "11:30 AM - 10:30 PM", ["Butter Chicken", "Lamb Biryani", "Garlic Naan"],     -73.993,  40.727),
        new("r7", "Nonna Rosa",       "Italian",  4.2, 2, "178 Mulberry St, New York",   "12:00 PM - 10:00 PM", ["Margherita Pizza", "Penne Arrabbiata", "Cannoli"],   -73.9975, 40.7225),
    ];

    private static readonly string[] _cuisines = ["Italian", "Japanese", "Mexican", "Thai", "French", "Indian"];

    private string? _filter = null;
    private string? _selected = null;

    private Restaurant[] _filtered =>
        _filter == null
            ? _restaurants
            : _restaurants.Where(r => r.Cuisine == _filter).ToArray();

    private static string PriceLabel(int level) => new string('$', level);

    private static string CuisineColor(string cuisine) => cuisine switch
    {
        "Italian"  => "bg-red-500",
        "Japanese" => "bg-rose-400",
        "Mexican"  => "bg-amber-500",
        "Thai"     => "bg-emerald-500",
        "French"   => "bg-blue-500",
        "Indian"   => "bg-orange-500",
        _          => "bg-muted",
    };
}
