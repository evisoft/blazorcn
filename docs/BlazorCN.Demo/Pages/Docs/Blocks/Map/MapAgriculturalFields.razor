@* ============================================================
   Block: map-agricultural-fields
   Title: MapAgriculturalFields
   Description: Interactive agricultural field map with crop type colored markers, soil moisture indicators, harvest schedule badges, and field detail cards built with mapcn, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-agricultural-fields.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sprout" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Field Management</span>
                <span class="text-xs text-muted-foreground">@_filtered.Length fields</span>
            </div>
            <div class="flex items-center gap-1.5">
                <button
                    type="button"
                    @onclick="@(() => SetFilter(null))"
                    class="@Cn.Merge("rounded-full px-2.5 py-0.5 text-xs transition-colors", _filter == null ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")"
                >
                    All
                </button>
                @foreach (var crop in _crops)
                {
                    var c = crop;
                    <button
                        type="button"
                        @onclick="@(() => SetFilter(c))"
                        class="@Cn.Merge("flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs transition-colors", _filter == c ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")"
                    >
                        <span class="@Cn.Merge("size-1.5 rounded-full", CropColors[c])"></span>
                        @CropLabels[c]
                    </button>
                }
            </div>
        </div>

        @* Summary *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <span class="text-xs text-muted-foreground">Total acreage</span>
                <p class="text-2xl font-semibold tabular-nums">@_totalAcreage.ToString("N0")</p>
            </div>
            <div>
                <span class="text-xs text-muted-foreground">Avg moisture</span>
                <p class="@Cn.Merge("text-2xl font-semibold tabular-nums", GetMoistureColor(_avgMoisture))">@_avgMoisture%</p>
            </div>
            <div>
                <span class="text-xs text-muted-foreground">Fields</span>
                <p class="text-2xl font-semibold tabular-nums">@_fields.Length</p>
            </div>
        </div>

        @* Map placeholder — MapCn is not yet available; render a styled grid of field cards *@
        <div class="relative h-[500px] overflow-y-auto bg-muted/20 p-4">
            <div class="mb-3 flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="map" Size="14" Class="size-3.5" />
                <span>Agricultural Fields Map</span>
            </div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                @foreach (var field in _filtered)
                {
                    var f = field;
                    <div
                        class="@Cn.Merge("cursor-pointer rounded-lg border bg-card p-3 shadow-sm transition-shadow hover:shadow-md", _selected == f.Id ? "ring-2 ring-foreground" : "")"
                        @onclick="@(() => ToggleSelected(f.Id))"
                    >
                        <div class="mb-2 flex items-start justify-between">
                            <div class="flex items-center gap-2">
                                <div class="@Cn.Merge("flex size-8 items-center justify-center rounded-full border-2 border-white shadow-md", CropColors[f.Crop])">
                                    <LucideIconCn Name="leaf" Size="14" Class="size-3.5 text-white" />
                                </div>
                                <div>
                                    <p class="text-sm font-medium">@f.Name</p>
                                    <p class="text-xs text-muted-foreground">@CropLabels[f.Crop] · @f.Acreage acres</p>
                                </div>
                            </div>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-xs font-normal", StageColors[f.GrowthStage])">
                                @StageLabels[f.GrowthStage]
                            </BadgeCn>
                        </div>

                        @if (_selected == f.Id)
                        {
                            <div class="mt-2">
                                <div class="mb-2 grid grid-cols-2 gap-2">
                                    <div class="rounded-md bg-muted/50 p-2">
                                        <div class="flex items-center gap-1">
                                            <LucideIconCn Name="droplet" Size="12" Class="size-3 text-blue-500" />
                                            <span class="text-[10px] text-muted-foreground">Moisture</span>
                                        </div>
                                        <p class="@Cn.Merge("text-sm font-medium tabular-nums", GetMoistureColor(f.Moisture))">@f.Moisture%</p>
                                    </div>
                                    <div class="rounded-md bg-muted/50 p-2">
                                        <div class="flex items-center gap-1">
                                            <LucideIconCn Name="thermometer" Size="12" Class="size-3 text-red-400" />
                                            <span class="text-[10px] text-muted-foreground">Temp</span>
                                        </div>
                                        <p class="text-sm font-medium tabular-nums">@f.Temperature@("°")F</p>
                                    </div>
                                </div>
                                <div class="space-y-1.5 border-t pt-2">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">Est. yield</span>
                                        <span class="text-xs font-medium">@f.EstimatedYield</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">Harvest</span>
                                        <span class="text-xs font-medium">@f.HarvestDate</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">Irrigation</span>
                                        <span class="text-xs font-medium">@f.IrrigationStatus</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center gap-4 border-t px-4 py-2.5">
            @foreach (var crop in _crops)
            {
                var c = crop;
                var count = _fields.Count(f => f.Crop == c);
                if (count > 0)
                {
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="@Cn.Merge("size-1.5 rounded-full", CropColors[c])"></span>
                        @CropLabels[c] (@count)
                    </span>
                }
            }
        </div>
    </div>
</section>

@code {
    private record Field(
        string Id,
        string Name,
        string Crop,
        int Acreage,
        int Moisture,
        int Temperature,
        string GrowthStage,
        string EstimatedYield,
        string HarvestDate,
        string IrrigationStatus,
        double Longitude,
        double Latitude
    );

    private static readonly Dictionary<string, string> CropColors = new()
    {
        ["corn"] = "bg-amber-500",
        ["wheat"] = "bg-yellow-600",
        ["soybean"] = "bg-emerald-500",
        ["cotton"] = "bg-slate-400",
        ["rice"] = "bg-teal-500",
    };

    private static readonly Dictionary<string, string> CropLabels = new()
    {
        ["corn"] = "Corn",
        ["wheat"] = "Wheat",
        ["soybean"] = "Soybean",
        ["cotton"] = "Cotton",
        ["rice"] = "Rice",
    };

    private static readonly Dictionary<string, string> StageColors = new()
    {
        ["seedling"] = "border-blue-500/20 bg-blue-500/10 text-blue-600 dark:text-blue-400",
        ["growing"] = "border-emerald-500/20 bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        ["harvest-ready"] = "border-amber-500/20 bg-amber-500/10 text-amber-600 dark:text-amber-400",
    };

    private static readonly Dictionary<string, string> StageLabels = new()
    {
        ["seedling"] = "Seedling",
        ["growing"] = "Growing",
        ["harvest-ready"] = "Harvest Ready",
    };

    private static readonly Field[] _fields =
    [
        new("f1", "North Ridge Field", "corn", 240, 68, 72, "growing", "182 bu/ac", "Sep 15", "Active - Zone 3", -93.245, 41.588),
        new("f2", "Prairie West Plot", "wheat", 180, 42, 78, "harvest-ready", "58 bu/ac", "Jul 20", "Idle", -93.268, 41.601),
        new("f3", "Riverside Section", "soybean", 320, 74, 70, "growing", "52 bu/ac", "Oct 5", "Active - Zone 1", -93.222, 41.575),
        new("f4", "South Valley", "cotton", 150, 38, 84, "growing", "1,120 lb/ac", "Oct 20", "Scheduled 6 AM", -93.256, 41.562),
        new("f5", "Creek Bottom Field", "rice", 200, 92, 76, "seedling", "7,200 lb/ac", "Nov 1", "Flooded", -93.208, 41.592),
        new("f6", "Hilltop East", "corn", 280, 55, 74, "seedling", "175 bu/ac", "Sep 28", "Active - Zone 5", -93.198, 41.608),
        new("f7", "Windmill Quarter", "wheat", 160, 36, 80, "harvest-ready", "62 bu/ac", "Jul 18", "Idle", -93.282, 41.585),
    ];

    private static readonly string[] _crops = ["corn", "wheat", "soybean", "cotton", "rice"];

    private string? _filter = null;
    private string? _selected = null;

    private Field[] _filtered => _filter == null ? _fields : _fields.Where(f => f.Crop == _filter).ToArray();
    private int _totalAcreage => _fields.Sum(f => f.Acreage);
    private int _avgMoisture => (int)Math.Round(_fields.Average(f => f.Moisture));

    private static string GetMoistureColor(int pct)
    {
        if (pct >= 70) return "text-blue-500";
        if (pct >= 45) return "text-emerald-500";
        return "text-amber-500";
    }

    private void SetFilter(string? crop)
    {
        _filter = crop;
        _selected = null;
    }

    private void ToggleSelected(string id)
    {
        _selected = _selected == id ? null : id;
    }
}
