@* ============================================================
   Block: map-bike-lanes
   Title: MapBikeLanes
   Description: React bike lane and cycling path map block for Next.js with route quality colors, bike station markers, elevation highlights, and path detail info using mapcn and shadcn/ui
   Source: original/blocks/map/map-bike-lanes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bike" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Bike Lanes &amp; Stations</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Protected
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    Bike lane
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    Shared
                </span>
            </div>
        </div>

        @* Stats bar *@
        <div class="flex items-center gap-4 border-b px-4 py-2">
            <span class="text-xs text-muted-foreground">
                @_bikeRoutes.Length routes · @_totalDistance mi total
            </span>
            <span class="text-xs text-muted-foreground">·</span>
            <span class="text-xs text-muted-foreground">
                @_stations.Length stations · @_totalStationBikes bikes available
            </span>
        </div>

        @* Map placeholder — Map/MapRoute/MapMarker are React-only components; rendered as a styled placeholder *@
        <div class="relative h-[460px] bg-muted/30 flex items-center justify-center">
            <div class="flex flex-col items-center gap-3 text-muted-foreground">
                <LucideIconCn Name="map" Size="48" Class="size-12 opacity-30" />
                <div class="text-center">
                    <p class="text-sm font-medium">Interactive Bike Map</p>
                    <p class="text-xs opacity-70">Chicago · Lakefront, Milwaukee Ave, Dearborn, Halsted, 606 Trail</p>
                </div>
                @* Station dots legend *@
                <div class="flex items-center gap-4 mt-2">
                    @foreach (var station in _stations)
                    {
                        var stationItem = station;
                        int total = stationItem.Bikes + stationItem.Docks;
                        string dotClass = Cn.Merge("size-2.5 rounded-full", StationAvailColor(stationItem.Bikes, total));
                        <div class="flex flex-col items-center gap-1">
                            <div class="flex size-5 items-center justify-center rounded-full border border-background bg-background shadow-sm">
                                <div class="@dotClass"></div>
                            </div>
                            <span class="text-[9px]">@stationItem.Name.Split(' ')[0]</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Route list *@
        <div>
            @foreach (var (route, index) in _bikeRoutes.Select((r, i) => (r, i)))
            {
                var routeItem = route;
                bool isSelected = _selectedRoute == routeItem.Id;
                bool isLast = index == _bikeRoutes.Length - 1;
                string rowClass = (isLast && !isSelected) ? "" : "border-t";
                string dotClass = Cn.Merge("size-2 shrink-0 rounded-full", _qualityDot[routeItem.Quality]);
                string chevronClass = Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isSelected ? "rotate-90" : "");
                <div class="@rowClass">
                    <button
                        type="button"
                        @onclick="@(() => { var id = routeItem.Id; _selectedRoute = (_selectedRoute == id) ? null : id; })"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@dotClass"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@routeItem.Name</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @routeItem.Distance · @routeItem.Surface
                            </p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                            @_qualityLabel[routeItem.Quality]
                        </BadgeCn>
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="mountain" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-xs tabular-nums text-muted-foreground">
                                @routeItem.Elevation
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isSelected)
                    {
                        <div class="grid grid-cols-3 gap-4 px-4 pb-4 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Distance</span>
                                <p class="mt-1 text-lg font-semibold tabular-nums">@routeItem.Distance</p>
                            </div>
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Elevation</span>
                                <p class="mt-1 text-lg font-semibold tabular-nums">@routeItem.Elevation</p>
                            </div>
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Surface</span>
                                <p class="mt-1 text-sm font-medium">@routeItem.Surface</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _selectedRoute = null;

    private record BikeRoute(string Id, string Name, string Quality, string Distance, string Elevation, string Surface);
    private record BikeStation(string Id, string Name, int Bikes, int Docks, int Ebikes);

    private static readonly BikeRoute[] _bikeRoutes =
    [
        new("br1", "Lakefront Trail North", "protected", "5.2 mi", "+42 ft", "Asphalt"),
        new("br2", "Milwaukee Ave Corridor", "standard", "3.8 mi", "+18 ft", "Asphalt"),
        new("br3", "Dearborn St Protected", "protected", "2.1 mi", "+8 ft", "Asphalt"),
        new("br4", "Halsted St Shared", "shared", "2.6 mi", "+12 ft", "Mixed"),
        new("br5", "606 Trail", "protected", "2.7 mi", "+6 ft", "Concrete"),
    ];

    private static readonly BikeStation[] _stations =
    [
        new("s1", "Millennium Park", 12, 23, 4),
        new("s2", "Wicker Park", 8, 15, 2),
        new("s3", "Lincoln Park Zoo", 15, 19, 6),
        new("s4", "Union Station", 3, 27, 1),
        new("s5", "Navy Pier", 18, 24, 7),
        new("s6", "Logan Square", 6, 12, 3),
        new("s7", "Hyde Park", 9, 16, 2),
    ];

    private static readonly Dictionary<string, string> _qualityDot = new()
    {
        ["protected"] = "bg-emerald-500",
        ["standard"] = "bg-amber-500",
        ["shared"] = "bg-red-500",
    };

    private static readonly Dictionary<string, string> _qualityLabel = new()
    {
        ["protected"] = "Protected",
        ["standard"] = "Bike lane",
        ["shared"] = "Shared road",
    };

    private string _totalDistance =>
        _bikeRoutes.Sum(r => double.Parse(r.Distance.Replace(" mi", ""), System.Globalization.CultureInfo.InvariantCulture))
                   .ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    private int _totalStationBikes =>
        _stations.Sum(s => s.Bikes);

    private static string StationAvailColor(int bikes, int total)
    {
        double pct = (double)bikes / total;
        if (pct >= 0.5) return "bg-emerald-500";
        if (pct >= 0.2) return "bg-amber-500";
        return "bg-red-500";
    }
}
