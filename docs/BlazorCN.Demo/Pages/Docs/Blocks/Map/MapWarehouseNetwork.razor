@* ============================================================
   Block: map-warehouse-network
   Title: MapWarehouseNetwork
   Description: React warehouse network map block for Next.js with hub markers, connection routes, capacity gauges, throughput metrics, and facility tooltips using mapcn and shadcn/ui
   Source: original/blocks/map/map-warehouse-network.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="warehouse" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Warehouse Network</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideIconCn Name="truck" Size="12" Class="size-3" />
                    @_totalShipments.ToString("N0") active
                </span>
                <span class="text-xs text-muted-foreground">·</span>
                <span class="@Cn.Merge("text-xs font-medium tabular-nums", CapacityTextColor(_avgCapacity))">
                    @_avgCapacity% avg capacity
                </span>
            </div>
        </div>

        @* Map placeholder — Map/MapMarker/MapRoute are React-only; rendered as a styled placeholder *@
        <div class="relative h-[500px] bg-muted/30 flex items-center justify-center">
            <div class="flex flex-col items-center gap-4 text-muted-foreground">
                <LucideIconCn Name="map" Size="48" Class="size-12 opacity-30" />
                <div class="text-center">
                    <p class="text-sm font-medium">Interactive Warehouse Map</p>
                    <p class="text-xs opacity-70">US Network · @_warehouses.Length facilities · @_routes.Length routes</p>
                </div>
                @* Facility markers legend *@
                <div class="flex flex-wrap items-center justify-center gap-4 mt-1">
                    @foreach (var wh in _warehouses)
                    {
                        var w = wh;
                        int pct = (int)Math.Round((double)w.Used / w.Capacity * 100);
                        <div class="flex flex-col items-center gap-1">
                            <div class="@Cn.Merge("rounded-full bg-background shadow-sm flex items-center justify-center", FacilitySize(w.Type), FacilityBorder(w.Type))">
                            </div>
                            <span class="text-[9px]">@w.Name.Split(' ')[0]</span>
                            <span class="@Cn.Merge("text-[9px] tabular-nums", CapacityTextColor(pct))">@pct%</span>
                        </div>
                    }
                </div>
                @* Routes legend *@
                <div class="flex flex-wrap items-center justify-center gap-3">
                    <span class="flex items-center gap-1 text-xs text-muted-foreground">
                        <span class="inline-block h-0.5 w-6 rounded" style="background:#3b82f6;opacity:0.5"></span>
                        Primary routes
                    </span>
                    <span class="flex items-center gap-1 text-xs text-muted-foreground">
                        <span class="inline-block h-0.5 w-6 rounded" style="background:#8b5cf6;opacity:0.5"></span>
                        Secondary routes
                    </span>
                </div>

                @* Selected facility popup *@
                @if (_selected != null)
                {
                    var sel = _warehouses.FirstOrDefault(w => w.Id == _selected);
                    if (sel != null)
                    {
                        int selPct = (int)Math.Round((double)sel.Used / sel.Capacity * 100);
                        <div class="mt-2 rounded-lg border bg-card p-3 shadow-md w-56">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="font-medium text-sm">@sel.Name</span>
                                <span class="@Cn.Merge("text-[10px] tabular-nums", CapacityTextColor(selPct))">@selPct%</span>
                            </div>
                            <div class="space-y-1.5 text-xs">
                                <div class="flex items-center justify-between">
                                    <span class="text-muted-foreground">Capacity</span>
                                    <span class="tabular-nums font-medium">@sel.Used.ToString("N0")/@sel.Capacity.ToString("N0")</span>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="text-muted-foreground">Throughput</span>
                                    <span class="tabular-nums font-medium">@sel.Throughput</span>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="text-muted-foreground">Shipments</span>
                                    <span class="tabular-nums font-medium">@sel.Shipments</span>
                                </div>
                            </div>
                            <button type="button" @onclick="@(() => _selected = null)" class="mt-2 text-[10px] text-muted-foreground hover:text-foreground">Close</button>
                        </div>
                    }
                }
            </div>
        </div>

        @* Facility list *@
        <div>
            @foreach (var wh in _warehouses)
            {
                var w = wh;
                int pct = (int)Math.Round((double)w.Used / w.Capacity * 100);
                bool isExpanded = _selected == w.Id;
                bool isLast = w.Id == _warehouses[_warehouses.Length - 1].Id;
                <div class="@(isLast && !isExpanded ? "" : "border-t")">
                    <button
                        type="button"
                        @onclick="@(() => _selected = (isExpanded ? null : w.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", CapacityColor(pct))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@w.Name</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @w.Throughput · @w.Shipments shipments
                            </p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @w.Type
                        </BadgeCn>
                        <div class="flex items-center gap-2">
                            <div class="h-1.5 w-16 overflow-hidden rounded-full bg-muted">
                                <div
                                    class="@Cn.Merge("h-full rounded-full", CapacityColor(pct))"
                                    style="@($"width:{pct}%")">
                                </div>
                            </div>
                            <span class="@Cn.Merge("w-8 text-right text-xs font-medium tabular-nums", CapacityTextColor(pct))">
                                @pct%
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="grid grid-cols-3 gap-4 px-4 pb-4 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Capacity</span>
                                <p class="mt-1 text-lg font-semibold tabular-nums">
                                    @w.Used.ToString("N0")
                                    <span class="text-sm font-normal text-muted-foreground">
                                        /@w.Capacity.ToString("N0")
                                    </span>
                                </p>
                            </div>
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Throughput</span>
                                <p class="mt-1 text-lg font-semibold tabular-nums">@w.Throughput</p>
                            </div>
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="text-xs font-medium text-muted-foreground">Active shipments</span>
                                <p class="mt-1 text-lg font-semibold tabular-nums">@w.Shipments</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _selected = null;

    private record Warehouse(string Id, string Name, string Type, double Longitude, double Latitude, int Capacity, int Used, string Throughput, int Shipments);
    private record Route(string Id, string From, string To, string Volume, string Color);

    private static readonly Warehouse[] _warehouses =
    [
        new("w1", "Chicago Hub",       "hub",      -87.6298, 41.8781, 50000, 42500, "12,400 units/day", 847),
        new("w2", "Atlanta Regional",  "regional", -84.3880, 33.7490, 30000, 18900, "7,200 units/day",  523),
        new("w3", "Denver Regional",   "regional", -104.9903, 39.7392, 25000, 22100, "5,800 units/day", 412),
        new("w4", "Dallas Local",      "local",    -96.7970, 32.7767, 15000, 9750,  "3,100 units/day",  289),
        new("w5", "Columbus Local",    "local",    -82.9988, 39.9612, 12000, 10800, "2,600 units/day",  198),
        new("w6", "Phoenix Local",     "local",    -112.074, 33.4484, 18000, 7200,  "2,900 units/day",  234),
    ];

    private static readonly Route[] _routes =
    [
        new("r1", "w1", "w2", "3,200 units/day", "#3b82f6"),
        new("r2", "w1", "w3", "2,100 units/day", "#3b82f6"),
        new("r3", "w1", "w5", "1,800 units/day", "#8b5cf6"),
        new("r4", "w2", "w4", "1,500 units/day", "#8b5cf6"),
        new("r5", "w3", "w6", "1,200 units/day", "#8b5cf6"),
    ];

    private int _totalShipments => _warehouses.Sum(w => w.Shipments);

    private int _avgCapacity => (int)Math.Round(
        _warehouses.Average(w => (double)w.Used / w.Capacity * 100));

    private static string CapacityColor(int pct)
    {
        if (pct >= 90) return "bg-red-500";
        if (pct >= 70) return "bg-amber-500";
        return "bg-emerald-500";
    }

    private static string CapacityTextColor(int pct)
    {
        if (pct >= 90) return "text-red-600 dark:text-red-400";
        if (pct >= 70) return "text-amber-600 dark:text-amber-400";
        return "text-emerald-600 dark:text-emerald-400";
    }

    private static string FacilitySize(string facilityType) => facilityType switch
    {
        "hub"      => "size-4",
        "regional" => "size-3",
        _          => "size-2.5",
    };

    private static string FacilityBorder(string facilityType) => facilityType switch
    {
        "hub"      => "border-2 border-blue-400",
        "regional" => "border-2 border-violet-400",
        _          => "border border-muted-foreground/40",
    };
}
