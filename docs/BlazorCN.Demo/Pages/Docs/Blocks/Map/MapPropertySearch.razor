@* ============================================================
   Block: map-property-search
   Title: MapPropertySearch
   Description: React interactive property search map block for Next.js with filterable listing markers, price badges, bedroom and bathroom counts, and a sidebar filter panel using mapcn map components, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-property-search.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="house" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Property Search</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_filtered.Length listings
            </BadgeCn>
        </div>

        <div class="flex">
            @* Sidebar filters *@
            <div class="w-64 shrink-0 border-r">
                <div class="border-b px-3 py-2.5">
                    <div class="relative">
                        <LucideIconCn Name="search" Size="14" Class="absolute top-1/2 left-2.5 size-3.5 -translate-y-1/2 text-muted-foreground" />
                        <InputCn
                            Value="@_search"
                            ValueChanged="@((string v) => { _search = v; })"
                            Placeholder="Search listings..."
                            Class="h-8 border-0 bg-transparent pl-8 shadow-none focus-visible:ring-0" />
                    </div>
                </div>

                <div class="space-y-3 px-3 py-3">
                    <div>
                        <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Type</span>
                        <SelectCn Value="@_typeFilter" ValueChanged="@((string? v) => SetTypeFilter(v))">
                            <SelectTriggerCn aria-label="Property type" Class="h-8 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="all">All types</SelectItemCn>
                                <SelectItemCn Value="house">House</SelectItemCn>
                                <SelectItemCn Value="apartment">Apartment</SelectItemCn>
                                <SelectItemCn Value="condo">Condo</SelectItemCn>
                                <SelectItemCn Value="townhouse">Townhouse</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>

                    <div>
                        <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Min bedrooms</span>
                        <SelectCn Value="@_bedsFilter" ValueChanged="@((string? v) => SetBedsFilter(v))">
                            <SelectTriggerCn aria-label="Minimum bedrooms" Class="h-8 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="any">Any</SelectItemCn>
                                <SelectItemCn Value="1">1+</SelectItemCn>
                                <SelectItemCn Value="2">2+</SelectItemCn>
                                <SelectItemCn Value="3">3+</SelectItemCn>
                                <SelectItemCn Value="4">4+</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>

                @* Listing cards *@
                <div class="max-h-[360px] overflow-y-auto border-t">
                    @foreach (var p in _filtered)
                    {
                        var prop = p;
                        <button
                            type="button"
                            class="@Cn.Merge("flex w-full flex-col gap-1 border-b px-3 py-2.5 text-left transition-colors hover:bg-muted/50", _selectedId == prop.Id ? "bg-muted/50" : "")"
                            @onclick="@(() => ToggleSelected(prop.Id))">
                            <div class="flex items-center justify-between">
                                <span class="text-sm font-medium">@prop.Title</span>
                                <span class="text-sm font-semibold tabular-nums">@FormatPrice(prop.Price)</span>
                            </div>
                            <span class="truncate text-xs text-muted-foreground">@prop.Address</span>
                            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="bed-double" Size="12" Class="size-3" />
                                    @prop.Beds
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="bath" Size="12" Class="size-3" />
                                    @prop.Baths
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="ruler" Size="12" Class="size-3" />
                                    @prop.Sqft.ToString("N0") sqft
                                </span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto h-4 px-1.5 font-normal text-[10px]">
                                    @TypeLabel(prop.PropertyType)
                                </BadgeCn>
                            </div>
                        </button>
                    }
                    @if (_filtered.Length == 0)
                    {
                        <div class="px-3 py-8 text-center text-xs text-muted-foreground">
                            No listings match your filters.
                        </div>
                    }
                </div>
            </div>

            @* Map area — rendered as a styled mock since BlazorCN has no MapCn component *@
            <div class="relative h-[500px] flex-1 bg-muted/30">
                @* Map background grid to suggest a map tile *@
                <div class="absolute inset-0 overflow-hidden">
                    <svg class="h-full w-full opacity-10" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <pattern id="ps-grid" width="40" height="40" patternUnits="userSpaceOnUse">
                                <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1" />
                            </pattern>
                        </defs>
                        <rect width="100%" height="100%" fill="url(#ps-grid)" />
                    </svg>
                </div>

                @* Map controls placeholder (bottom-right) *@
                <div class="absolute bottom-3 right-3 z-10 flex flex-col gap-1">
                    <button aria-label="Zoom in" type="button" class="flex size-8 items-center justify-center rounded border bg-card shadow-sm hover:bg-muted/50">
                        <LucideIconCn Name="plus" Size="14" Class="size-3.5 text-foreground" />
                    </button>
                    <button aria-label="Zoom out" type="button" class="flex size-8 items-center justify-center rounded border bg-card shadow-sm hover:bg-muted/50">
                        <LucideIconCn Name="minus" Size="14" Class="size-3.5 text-foreground" />
                    </button>
                </div>

                @* Property markers *@
                @foreach (var p in _filtered)
                {
                    var prop = p;
                    @* Convert lat/lng to approximate CSS positions within the viewport *@
                    @* Longitude range: ~-122.49 to ~-122.39, Latitude range: ~37.745 to ~37.810 *@
                    var leftPct = (int)Math.Round((prop.Lng - (-122.49)) / ((-122.39) - (-122.49)) * 80 + 5);
                    var topPct = (int)Math.Round((37.810 - prop.Lat) / (37.810 - 37.745) * 80 + 5);
                    <div class="absolute z-10" style="@($"left:{leftPct}%;top:{topPct}%")">
                        <div class="relative">
                            @* Price badge marker *@
                            <button
                                type="button"
                                class="@Cn.Merge("flex items-center rounded-full px-2 py-1 text-xs font-semibold shadow-md transition-colors", _selectedId == prop.Id ? "bg-foreground text-background" : "border bg-background text-foreground")"
                                @onclick="@(() => ToggleSelected(prop.Id))">
                                @FormatPrice(prop.Price)
                            </button>

                            @* Popup card *@
                            @if (_selectedId == prop.Id)
                            {
                                <div class="absolute bottom-full left-1/2 mb-2 -translate-x-1/2 w-56 rounded-md border bg-card p-3 shadow-md">
                                    <div class="mb-1 text-sm font-medium">@prop.Title</div>
                                    <div class="mb-2 text-xs text-muted-foreground">@prop.Address</div>
                                    <div class="mb-2 flex items-center gap-3 text-xs text-muted-foreground">
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="bed-double" Size="12" Class="size-3" />
                                            @prop.Beds bd
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="bath" Size="12" Class="size-3" />
                                            @prop.Baths ba
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="ruler" Size="12" Class="size-3" />
                                            @prop.Sqft.ToString("N0") sqft
                                        </span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-sm font-semibold tabular-nums">@FormatPrice(prop.Price)</span>
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-6 text-xs">View details</ButtonCn>
                                    </div>
                                    @* Close button *@
                                    <button aria-label="Close details" type="button"
                                        class="absolute right-1.5 top-1.5 flex size-5 items-center justify-center rounded text-muted-foreground hover:bg-muted/50"
                                        @onclick="@(() => _selectedId = null)">
                                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Property(
        string Id, string Title, string Address, int Price,
        int Beds, int Baths, int Sqft, string PropertyType,
        double Lng, double Lat);

    private static readonly Property[] _properties =
    [
        new("p1", "Modern Loft in SoMa", "455 Mission St, San Francisco, CA", 895000, 2, 2, 1150, "apartment", -122.3968, 37.7905),
        new("p2", "Victorian Townhouse", "1847 Page St, San Francisco, CA", 1425000, 3, 2, 1820, "townhouse", -122.4505, 37.7712),
        new("p3", "Marina District Condo", "2100 Chestnut St, San Francisco, CA", 1150000, 2, 1, 980, "condo", -122.4368, 37.8005),
        new("p4", "Sunset Family Home", "1530 30th Ave, San Francisco, CA", 1680000, 4, 3, 2450, "house", -122.4888, 37.7602),
        new("p5", "Noe Valley Gem", "4100 24th St, San Francisco, CA", 2100000, 3, 2, 1650, "house", -122.4338, 37.7515),
        new("p6", "Downtown Studio", "100 Van Ness Ave, San Francisco, CA", 625000, 1, 1, 540, "apartment", -122.4194, 37.7749),
        new("p7", "Pacific Heights Penthouse", "2200 Sacramento St, San Francisco, CA", 3250000, 4, 3, 2800, "condo", -122.433, 37.79),
    ];

    private string _search = "";
    private string _typeFilter = "all";
    private string _bedsFilter = "any";
    private string? _selectedId = null;

    private Property[] _filtered => _properties
        .Where(p =>
        {
            if (!string.IsNullOrEmpty(_search) &&
                !p.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) &&
                !p.Address.Contains(_search, StringComparison.OrdinalIgnoreCase))
                return false;
            if (_typeFilter != "all" && p.PropertyType != _typeFilter)
                return false;
            if (_bedsFilter != "any" && p.Beds < int.Parse(_bedsFilter))
                return false;
            return true;
        })
        .ToArray();

    private void ToggleSelected(string id)
    {
        _selectedId = _selectedId == id ? null : id;
    }

    private void SetTypeFilter(string? val)
    {
        _typeFilter = val ?? "all";
        _selectedId = null;
    }

    private void SetBedsFilter(string? val)
    {
        _bedsFilter = val ?? "any";
        _selectedId = null;
    }

    private static string FormatPrice(int price)
    {
        if (price >= 1000000)
            return $"${(price / 1000000.0):F1}M";
        return $"${(price / 1000.0):F0}K";
    }

    private static string TypeLabel(string type) => type switch
    {
        "house" => "House",
        "apartment" => "Apartment",
        "condo" => "Condo",
        "townhouse" => "Townhouse",
        _ => type,
    };
}
