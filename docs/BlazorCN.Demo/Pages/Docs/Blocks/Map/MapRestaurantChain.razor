@* ============================================================
   Block: map-restaurant-chain
   Title: MapRestaurantChain
   Description: Interactive restaurant chain location map with brand markers, daily special badges, drive-thru indicators, and location detail popups built with mapcn, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-restaurant-chain.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="store" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Burger Barn locations</span>
                <span class="text-xs text-muted-foreground">@_filtered.Length of @_locations.Length</span>
            </div>
            <div class="flex items-center gap-1.5">
                @foreach (var fv in _filterOptions)
                {
                    var f = fv;
                    <button
                        type="button"
                        @onclick="@(() => _filter = f)"
                        class="@Cn.Merge("flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs transition-colors", _filter == f ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")">
                        @if (f == "drive-thru")
                        {
                            <LucideIconCn Name="car" Size="12" Class="size-3" />
                        }
                        @if (f == "open")
                        {
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        }
                        @if (f == "all")
                        {
                            @:All
                        }
                        else if (f == "open")
                        {
                            @:Open now
                        }
                        else
                        {
                            @:Drive-thru
                        }
                    </button>
                }
            </div>
        </div>

        @* Map placeholder — Map/MapMarker/MarkerPopup/MarkerTooltip are React-only; rendered as a styled placeholder *@
        <div class="relative h-[500px] bg-muted/30 flex items-center justify-center">
            <div class="flex flex-col items-center gap-4 text-muted-foreground">
                <LucideIconCn Name="map" Size="48" Class="size-12 opacity-30" />
                <div class="text-center">
                    <p class="text-sm font-medium">Interactive Restaurant Chain Map</p>
                    <p class="text-xs opacity-70">New York Area · @_filtered.Length locations</p>
                </div>

                @* Location markers *@
                <div class="flex flex-wrap items-center justify-center gap-3 mt-1">
                    @foreach (var lr in _filtered)
                    {
                        var loc = lr;
                        <div
                            @onclick="@(() => _selected = (_selected == loc.Id ? null : loc.Id))"
                            class="flex cursor-pointer flex-col items-center gap-1">
                            <div class="relative">
                                <div class="@Cn.Merge("flex size-7 items-center justify-center rounded-full border-2 border-white shadow-md", loc.Status == "closed" ? "bg-zinc-400" : "bg-orange-500")">
                                    <LucideIconCn Name="utensils" Size="14" Class="size-3.5 text-white" />
                                </div>
                                @if (loc.HasDriveThru)
                                {
                                    <span class="absolute -right-1 -top-1 flex size-3.5 items-center justify-center rounded-full bg-blue-500 shadow-sm">
                                        <LucideIconCn Name="car" Size="8" Class="size-2 text-white" />
                                    </span>
                                }
                            </div>
                            <span class="text-[9px] max-w-[64px] truncate text-center">@loc.Name.Split('-')[^1].Trim()</span>
                        </div>
                    }
                </div>

                @* Popup preview *@
                @if (_selected != null)
                {
                    var popup = System.Array.Find(_locations, x => x.Id == _selected);
                    @if (popup != null)
                    {
                        <div class="mt-2 w-60 rounded-lg border bg-card p-3 shadow-md">
                            <div class="mb-2 flex items-start justify-between">
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-medium">@popup.Name</p>
                                    <div class="mt-0.5 flex items-center gap-1.5">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", StatusDot(popup.Status))"></span>
                                        <span class="text-xs text-muted-foreground">@StatusText(popup.Status)</span>
                                    </div>
                                </div>
                                <span class="text-xs font-medium tabular-nums">@popup.AvgRating</span>
                            </div>
                            <div class="mb-2 space-y-1">
                                <div class="flex items-start gap-1.5">
                                    <LucideIconCn Name="map-pin" Size="12" Class="mt-0.5 size-3 shrink-0 text-muted-foreground" />
                                    <span class="text-xs text-muted-foreground">@popup.Address</span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <LucideIconCn Name="phone" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="text-xs text-muted-foreground">@popup.Phone</span>
                                </div>
                                <div class="flex items-center gap-1.5">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="text-xs text-muted-foreground">@popup.Hours</span>
                                </div>
                            </div>
                            <div class="mb-2 flex flex-wrap gap-1">
                                @if (popup.HasDineIn)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-[10px] font-normal">
                                        <LucideIconCn Name="utensils" Size="10" Class="size-2.5" />
                                        Dine-in
                                    </BadgeCn>
                                }
                                @if (popup.HasDriveThru)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-[10px] font-normal">
                                        <LucideIconCn Name="car" Size="10" Class="size-2.5" />
                                        Drive-thru
                                    </BadgeCn>
                                }
                                @if (popup.HasWifi)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-[10px] font-normal">
                                        <LucideIconCn Name="wifi" Size="10" Class="size-2.5" />
                                        Wi-Fi
                                    </BadgeCn>
                                }
                            </div>
                            <div class="rounded-md bg-muted/50 p-2">
                                <div class="mb-0.5 flex items-center gap-1">
                                    <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-amber-500" />
                                    <span class="text-[10px] font-medium text-muted-foreground">Daily special</span>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="text-xs font-medium">@popup.DailySpecial</span>
                                    <span class="text-xs font-medium tabular-nums text-emerald-600 dark:text-emerald-400">@popup.DailySpecialPrice</span>
                                </div>
                            </div>
                            <button type="button" @onclick="@(() => _selected = null)" class="mt-2 text-[10px] text-muted-foreground hover:text-foreground">Close</button>
                        </div>
                    }
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center gap-4 border-t px-4 py-2.5">
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                @_openCount open
            </span>
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="size-1.5 rounded-full bg-amber-500"></span>
                @_closingSoonCount closing soon
            </span>
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                @_closedCount closed
            </span>
            <span class="ml-auto flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="car" Size="12" Class="size-3" />
                @_driveThruCount drive-thru
            </span>
        </div>
    </div>
</section>

@code {
    private string? _selected = null;
    private string _filter = "all";

    private static readonly string[] _filterOptions = ["all", "open", "drive-thru"];

    private record ChainLocation(
        string Id,
        string Name,
        string Address,
        string Phone,
        string Status,
        string Hours,
        double Longitude,
        double Latitude,
        bool HasDriveThru,
        bool HasWifi,
        bool HasDineIn,
        string DailySpecial,
        string DailySpecialPrice,
        double AvgRating
    );

    private static readonly ChainLocation[] _locations =
    [
        new("l1", "Burger Barn - Times Square",   "1560 Broadway, New York, NY 10036",      "(212) 555-0142", "open",         "6:00 AM - 12:00 AM", -73.9857, 40.7589, false, true,  true, "Double Smash Burger Combo",   "$9.99",  4.3),
        new("l2", "Burger Barn - Midtown East",   "420 Lexington Ave, New York, NY 10170",   "(212) 555-0198", "open",         "7:00 AM - 11:00 PM", -73.9754, 40.7527, false, true,  true, "BBQ Bacon Ranch Meal",        "$11.49", 4.5),
        new("l3", "Burger Barn - Chelsea",        "675 6th Ave, New York, NY 10010",         "(212) 555-0267", "closing-soon", "7:00 AM - 10:00 PM", -73.9942, 40.7409, false, true,  true, "Spicy Chicken Sandwich",      "$8.49",  4.1),
        new("l4", "Burger Barn - Williamsburg",   "234 Bedford Ave, Brooklyn, NY 11249",     "(718) 555-0334", "open",         "8:00 AM - 11:00 PM", -73.9572, 40.7143, true,  true,  true, "Truffle Mushroom Burger",     "$12.99", 4.7),
        new("l5", "Burger Barn - Astoria",        "31-15 Broadway, Astoria, NY 11106",       "(718) 555-0412", "open",         "6:30 AM - 11:30 PM", -73.9235, 40.7627, true,  true,  true, "Classic Combo + Shake",       "$10.99", 4.4),
        new("l6", "Burger Barn - Jersey City",    "90 Hudson St, Jersey City, NJ 07302",     "(201) 555-0518", "closed",       "7:00 AM - 10:00 PM", -74.0341, 40.7178, true,  false, true, "Veggie Deluxe Combo",         "$9.49",  3.9),
    ];

    private ChainLocation[] _filtered => _filter switch
    {
        "drive-thru" => System.Array.FindAll(_locations, l => l.HasDriveThru),
        "open"       => System.Array.FindAll(_locations, l => l.Status == "open"),
        _            => _locations,
    };

    private int _openCount        => System.Array.FindAll(_locations, l => l.Status == "open").Length;
    private int _closingSoonCount => System.Array.FindAll(_locations, l => l.Status == "closing-soon").Length;
    private int _closedCount      => System.Array.FindAll(_locations, l => l.Status == "closed").Length;
    private int _driveThruCount   => System.Array.FindAll(_locations, l => l.HasDriveThru).Length;

    private static string StatusDot(string status) => status switch
    {
        "open"         => "bg-emerald-500",
        "closing-soon" => "bg-amber-500",
        "closed"       => "bg-red-500",
        _              => "bg-gray-400",
    };

    private static string StatusText(string status) => status switch
    {
        "open"         => "Open",
        "closing-soon" => "Closing soon",
        "closed"       => "Closed",
        _              => status,
    };
}
