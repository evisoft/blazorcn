@* ============================================================
   Block: map-school-districts
   Title: MapSchoolDistricts
   Description: React school district map block for Next.js with boundary overlays, school markers, rating badges, enrollment stats, and school detail cards using mapcn and shadcn/ui
   Source: original/blocks/map/map-school-districts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="graduation-cap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">School District Map</span>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var type in _typeKeys)
                {
                    var t = type;
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", TypeColor(t))"></span>
                        @TypeLabel(t)
                    </span>
                }
            </div>
        </div>

        @* Map area — rendered as a styled mock since BlazorCN has no MapCn component *@
        <div class="relative h-[400px] border-b bg-muted/30">
            @* Map background grid *@
            <div class="absolute inset-0 overflow-hidden">
                <svg class="h-full w-full opacity-10" xmlns="http://www.w3.org/2000/svg">
                    <defs>
                        <pattern id="school-grid" width="40" height="40" patternUnits="userSpaceOnUse">
                            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1" />
                        </pattern>
                    </defs>
                    <rect width="100%" height="100%" fill="url(#school-grid)" />
                </svg>
                @* District 2 overlay (blue tint) *@
                <div class="absolute" style="left:5%;top:45%;width:45%;height:45%;background:rgba(59,130,246,0.15);border:2px dashed rgba(59,130,246,0.6);border-radius:2px;">
                    <span class="absolute left-1 top-1 text-[10px] font-medium text-blue-600 dark:text-blue-400">District 2</span>
                </div>
                @* District 4 overlay (green tint) *@
                <div class="absolute" style="left:50%;top:5%;width:45%;height:45%;background:rgba(16,185,129,0.15);border:2px dashed rgba(16,185,129,0.6);border-radius:2px;">
                    <span class="absolute left-1 top-1 text-[10px] font-medium text-emerald-600 dark:text-emerald-400">District 4</span>
                </div>
            </div>

            @* Map controls placeholder (top-right) *@
            <div class="absolute right-3 top-3 z-10 flex flex-col gap-1">
                <button aria-label="Zoom in" type="button" class="flex size-8 items-center justify-center rounded border bg-card shadow-sm hover:bg-muted/50">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5 text-foreground" />
                </button>
                <button aria-label="Zoom out" type="button" class="flex size-8 items-center justify-center rounded border bg-card shadow-sm hover:bg-muted/50">
                    <LucideIconCn Name="minus" Size="14" Class="size-3.5 text-foreground" />
                </button>
            </div>

            @* School markers *@
            @foreach (var school in _schools)
            {
                var s = school;
                var leftPct = (int)Math.Round((s.Longitude - (-73.995)) / ((-73.955) - (-73.995)) * 80 + 5);
                var topPct = (int)Math.Round((40.775 - s.Latitude) / (40.775 - 40.730) * 80 + 5);
                <div class="absolute z-10" style="@($"left:{leftPct}%;top:{topPct}%")">
                    <button
                        type="button"
                        class="@Cn.Merge("flex size-7 items-center justify-center rounded-full border-2 border-white shadow-md transition-transform", TypeColor(s.Type), _selected == s.Id ? "scale-125 ring-2 ring-foreground/20" : "")"
                        @onclick="@(() => SelectSchool(s.Id))">
                        <span class="font-semibold text-white text-xs">@s.Rating</span>
                    </button>
                </div>
            }
        </div>

        @* Selected school detail *@
        @if (_selectedSchool != null)
        {
            var sel = _selectedSchool;
            var fillPct = (int)Math.Min(100, Math.Round((double)sel.Enrollment / sel.Capacity * 100));
            <div class="border-b px-4 py-3">
                <div class="flex items-start gap-3">
                    <div class="@Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-md", RatingBg(sel.Rating))">
                        <span class="@Cn.Merge("font-semibold text-lg tabular-nums", RatingColor(sel.Rating))">
                            @sel.Rating
                        </span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@sel.Name</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">@TypeLabel(sel.Type)</BadgeCn>
                        </div>
                        <div class="mt-1 flex items-center gap-1.5 text-muted-foreground text-xs">
                            <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                            @sel.Address
                            <span>·</span>
                            @sel.District
                        </div>
                        <div class="mt-2 flex items-center gap-2">
                            <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-xs tabular-nums">
                                @sel.Enrollment.ToString("N0") / @sel.Capacity.ToString("N0")
                            </span>
                            <div class="h-1.5 flex-1 rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground/60" style="@($"width:{fillPct}%")"></div>
                            </div>
                            <span class="text-muted-foreground text-xs tabular-nums">@fillPct%</span>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* School list *@
        <div>
            @for (var i = 0; i < _schools.Length; i++)
            {
                var school = _schools[i];
                var isLast = i == _schools.Length - 1;
                var isExpanded = _expanded == school.Id;
                var expandedPct = (int)Math.Min(100, Math.Round((double)school.Enrollment / school.Capacity * 100));
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", _selected == school.Id ? "bg-muted/30" : "")"
                        @onclick="@(() => ToggleExpand(school.Id))">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", TypeColor(school.Type))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@school.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@TypeLabel(school.Type) · @school.District</p>
                        </div>
                        <span class="@Cn.Merge("font-semibold text-sm tabular-nums", RatingColor(school.Rating))">
                            @school.Rating/10
                        </span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Enrollment</span>
                                    <span class="tabular-nums">@school.Enrollment.ToString("N0") / @school.Capacity.ToString("N0") seats</span>
                                </div>
                                <div class="mt-2 h-1.5 rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground/60" style="@($"width:{expandedPct}%")"></div>
                                </div>
                                <div class="mt-2 flex items-center gap-1.5 text-muted-foreground text-xs">
                                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                    @school.Address
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record School(
        string Id, string Name, string Type,
        int Rating, int Enrollment, int Capacity,
        double Longitude, double Latitude,
        string Address, string District);

    private static readonly School[] _schools =
    [
        new("s1", "Lincoln Elementary",      "elementary", 9,  420,  500,  -73.985, 40.748, "145 W 32nd St",    "District 2"),
        new("s2", "Jefferson Middle School", "middle",     7,  680,  750,  -73.978, 40.752, "220 E 42nd St",    "District 2"),
        new("s3", "Roosevelt High School",   "high",       8,  1250, 1400, -73.968, 40.763, "500 Park Ave",     "District 4"),
        new("s4", "Washington Elementary",   "elementary", 6,  380,  400,  -73.992, 40.735, "88 University Pl", "District 2"),
        new("s5", "Hamilton Prep Academy",   "high",       10, 890,  1000, -73.958, 40.77,  "1025 5th Ave",     "District 4"),
        new("s6", "Adams Middle School",     "middle",     5,  590,  600,  -73.995, 40.742, "310 W 18th St",    "District 2"),
    ];

    private static readonly string[] _typeKeys = ["elementary", "middle", "high"];

    private string _selected = "s5";
    private string? _expanded = null;

    private School? _selectedSchool => Array.Find(_schools, s => s.Id == _selected);

    private void SelectSchool(string id)
    {
        _selected = id;
        _expanded = null;
    }

    private void ToggleExpand(string id)
    {
        _expanded = _expanded == id ? null : id;
        _selected = id;
    }

    private static string TypeLabel(string type) => type switch
    {
        "elementary" => "Elementary",
        "middle"     => "Middle",
        "high"       => "High School",
        _            => type,
    };

    private static string TypeColor(string type) => type switch
    {
        "elementary" => "bg-blue-500",
        "middle"     => "bg-violet-500",
        "high"       => "bg-emerald-500",
        _            => "bg-muted",
    };

    private static string RatingColor(int rating)
    {
        if (rating >= 9) return "text-emerald-600 dark:text-emerald-400";
        if (rating >= 7) return "text-blue-600 dark:text-blue-400";
        if (rating >= 5) return "text-amber-600 dark:text-amber-400";
        return "text-red-600 dark:text-red-400";
    }

    private static string RatingBg(int rating)
    {
        if (rating >= 9) return "bg-emerald-500/10";
        if (rating >= 7) return "bg-blue-500/10";
        if (rating >= 5) return "bg-amber-500/10";
        return "bg-red-500/10";
    }
}
