@* ============================================================
   Block: map-coral-reefs
   Title: MapCoralReefs
   Description: Interactive coral reef health monitoring map with reef markers, bleaching severity colors, marine species counts, and reef detail popups built with mapcn, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-coral-reefs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="waves" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Reef Health Monitor</span>
                <span class="text-xs text-muted-foreground">@_filtered.Length reefs</span>
            </div>
            <div class="flex items-center gap-1.5">
                <button
                    type="button"
                    @onclick="@(() => _filter = null)"
                    class="@Cn.Merge("rounded-full px-2.5 py-0.5 text-xs transition-colors", _filter == null ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")">
                    All
                </button>
                @foreach (var statusVal in new[] { "healthy", "stressed", "bleached" })
                {
                    var sv = statusVal;
                    <button
                        type="button"
                        @onclick="@(() => _filter = (_filter == sv ? null : sv))"
                        class="@Cn.Merge("flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs transition-colors", _filter == sv ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")">
                        <span class="@Cn.Merge("size-1.5 rounded-full", StatusColor(sv))" />
                        @StatusLabel(sv)
                    </button>
                }
            </div>
        </div>

        @* Map + Sidebar *@
        <div class="flex">
            @* Map placeholder *@
            <div class="relative h-[500px] flex-1 overflow-hidden bg-muted/20">
                @* Subtle grid background to suggest a map *@
                <div class="absolute inset-0" style="background-image: linear-gradient(rgba(0,0,0,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(0,0,0,0.05) 1px, transparent 1px); background-size: 40px 40px;"></div>

                @* Map label *@
                <div class="absolute bottom-3 left-3 rounded-md bg-background/80 px-2 py-1 text-xs text-muted-foreground backdrop-blur-sm">
                    Great Barrier Reef Region
                </div>

                @* Markers *@
                @foreach (var reefItem in _filtered)
                {
                    var reef = reefItem;
                    var leftPct = MapLonToPercent(reef.Longitude) * 100;
                    var topPct = MapLatToPercent(reef.Latitude) * 100;
                    <div class="absolute" style="@($"left:{leftPct:F2}%; top:{topPct:F2}%; transform:translate(-50%,-50%)")">
                        @* Marker dot *@
                        <button
                            type="button"
                            @onclick="@(() => _selected = (_selected == reef.Id ? null : reef.Id))"
                            class="@Cn.Merge("flex size-6 items-center justify-center rounded-full border-2 border-white shadow-md", StatusColor(reef.Status))">
                            <LucideIconCn Name="waves" Size="12" Class="size-3 text-white" />
                        </button>

                        @* Tooltip (always shown below marker) *@
                        <div class="pointer-events-none absolute left-1/2 top-full mt-1 -translate-x-1/2 whitespace-nowrap rounded border bg-popover px-2 py-1 text-xs shadow-md">
                            <div class="flex items-center gap-1.5">
                                <span class="font-medium">@reef.Name</span>
                                <span class="text-muted-foreground">@reef.BleachingPercent% bleached</span>
                            </div>
                        </div>

                        @* Popup *@
                        @if (_selected == reef.Id)
                        {
                            <div class="absolute left-1/2 top-full z-10 mt-7 w-64 -translate-x-1/2 rounded-md border bg-popover p-3 shadow-lg">
                                <div class="mb-2 flex items-start justify-between">
                                    <div>
                                        <p class="text-sm font-medium">@reef.Name</p>
                                        <p class="text-xs text-muted-foreground">@reef.Region</p>
                                    </div>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">@StatusLabel(reef.Status)</BadgeCn>
                                </div>
                                <div class="mb-2 flex items-center gap-3">
                                    <div class="flex items-center gap-1">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", StatusColor(reef.Status))" />
                                        <span class="text-xs font-medium tabular-nums">@reef.BleachingPercent%</span>
                                        <span class="text-xs text-muted-foreground">bleached</span>
                                    </div>
                                    <span class="text-xs text-muted-foreground">·</span>
                                    <div class="flex items-center gap-1">
                                        <LucideIconCn Name="thermometer" Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="text-xs tabular-nums">@reef.WaterTemp°C</span>
                                    </div>
                                </div>
                                <div class="mb-2 flex flex-wrap gap-1">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-xs font-normal">
                                        <LucideIconCn Name="waves" Size="10" Class="size-2.5" />
                                        @reef.CoralSpecies coral
                                    </BadgeCn>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-xs font-normal">
                                        <LucideIconCn Name="fish" Size="10" Class="size-2.5" />
                                        @reef.FishSpecies fish
                                    </BadgeCn>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-xs font-normal">
                                        <LucideIconCn Name="droplets" Size="10" Class="size-2.5" />
                                        @reef.InvertSpecies invert.
                                    </BadgeCn>
                                </div>
                                <div class="border-t pt-2">
                                    <p class="mb-0.5 text-xs font-medium text-muted-foreground">Outlook</p>
                                    <p class="text-xs leading-relaxed">@reef.Outlook</p>
                                    <p class="mt-1 text-xs text-muted-foreground">Surveyed @reef.LastSurvey</p>
                                </div>
                            </div>
                        }
                    </div>
                }

                @* Controls placeholder *@
                <div class="absolute bottom-3 right-3 flex flex-col gap-1">
                    <button type="button" class="flex size-7 items-center justify-center rounded border bg-background shadow-sm text-xs font-bold">+</button>
                    <button type="button" class="flex size-7 items-center justify-center rounded border bg-background shadow-sm text-xs font-bold">−</button>
                    <button type="button" class="flex size-7 items-center justify-center rounded border bg-background shadow-sm">
                        <LucideIconCn Name="locate" Size="14" Class="size-3.5 text-muted-foreground" />
                    </button>
                </div>
            </div>

            @* Detail sidebar *@
            <div class="w-64 shrink-0 border-l">
                <div class="border-b px-4 py-3">
                    <span class="text-sm font-medium">Reef Sites</span>
                    <p class="text-xs text-muted-foreground">Click a reef for details</p>
                </div>
                <div class="max-h-[430px] overflow-y-auto">
                    @for (var i = 0; i < _filtered.Length; i++)
                    {
                        var reef = _filtered[i];
                        var isLast = i == _filtered.Length - 1;
                        var isExpanded = _expandedSidebar == reef.Id;
                        var r = reef;
                        <div class="@(isLast ? "" : "border-b")">
                            <button
                                type="button"
                                @onclick="@(() => { _expandedSidebar = (isExpanded ? null : r.Id); _selected = r.Id; })"
                                class="flex w-full items-center gap-2.5 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                                <span class="@Cn.Merge("size-2 shrink-0 rounded-full", StatusColor(reef.Status))" />
                                <div class="min-w-0 flex-1">
                                    <span class="text-xs font-medium">@reef.Name</span>
                                    <p class="truncate text-xs text-muted-foreground">
                                        @reef.CoralCover cover · @reef.WaterTemp°C
                                    </p>
                                </div>
                                <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                            </button>
                            @if (isExpanded)
                            {
                                <div class="space-y-1 px-4 pb-3 pl-9">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">Bleaching</span>
                                        <span class="text-xs font-medium tabular-nums">@reef.BleachingPercent%</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">Coral species</span>
                                        <span class="text-xs tabular-nums">@reef.CoralSpecies</span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">Fish species</span>
                                        <span class="text-xs tabular-nums">@reef.FishSpecies</span>
                                    </div>
                                    <p class="pt-1 text-xs text-muted-foreground">@reef.Outlook</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center gap-4 border-t px-4 py-2.5">
            @foreach (var statusVal in new[] { "healthy", "stressed", "bleached" })
            {
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="@Cn.Merge("size-1.5 rounded-full", StatusColor(statusVal))" />
                    @StatusLabel(statusVal) (@StatusCount(statusVal))
                </span>
            }
            <span class="ml-auto text-xs text-muted-foreground">
                @(_reefs.Sum(r => r.CoralSpecies + r.FishSpecies + r.InvertSpecies).ToString("N0")) species tracked
            </span>
        </div>
    </div>
</section>

@code {
    private record Reef(
        string Id,
        string Name,
        string Region,
        string Status,
        int BleachingPercent,
        double WaterTemp,
        string CoralCover,
        int CoralSpecies,
        int FishSpecies,
        int InvertSpecies,
        string LastSurvey,
        string Outlook,
        double Longitude,
        double Latitude
    );

    private static readonly Reef[] _reefs =
    [
        new("rf1", "Osprey Reef", "Coral Sea, Australia", "healthy", 3, 26.4, "58%", 184, 312, 97, "12 days ago", "Stable with strong recovery indicators", 146.55, -13.88),
        new("rf2", "Ribbon Reef No. 10", "Great Barrier Reef", "stressed", 28, 29.1, "34%", 156, 274, 83, "5 days ago", "Moderate risk if temperatures persist", 145.79, -15.45),
        new("rf3", "Hardy Reef", "Whitsundays, Australia", "bleached", 67, 30.8, "11%", 102, 198, 54, "2 days ago", "Critical — mass bleaching event underway", 149.23, -19.72),
        new("rf4", "Lizard Island Reef", "Far North Queensland", "healthy", 5, 27.2, "62%", 201, 345, 112, "8 days ago", "Excellent biodiversity and coral cover", 145.46, -14.67),
        new("rf5", "Heron Island Reef", "Capricorn Bunker Group", "stressed", 19, 28.6, "29%", 143, 231, 76, "3 days ago", "Early stress signals in staghorn colonies", 151.91, -23.44),
        new("rf6", "Moore Reef", "Cairns Section", "bleached", 52, 30.2, "15%", 118, 210, 61, "1 day ago", "Severe bleaching in shallow table corals", 146.27, -16.87),
        new("rf7", "Agincourt Reef", "Port Douglas", "healthy", 7, 27.5, "51%", 178, 289, 91, "6 days ago", "Good conditions with minor thermal stress", 146.02, -16.08),
    ];

    // Bounding box for the visible map area (with padding)
    private const double _lonMin = 144.5;
    private const double _lonMax = 153.0;
    private const double _latMin = -24.5;
    private const double _latMax = -12.5;

    private string? _selected;
    private string? _filter;
    private string? _expandedSidebar;

    private Reef[] _filtered => _filter != null
        ? _reefs.Where(r => r.Status == _filter).ToArray()
        : _reefs;

    private static string StatusColor(string status) => status switch
    {
        "healthy" => "bg-emerald-500",
        "stressed" => "bg-amber-500",
        "bleached" => "bg-red-500",
        _ => "bg-muted-foreground",
    };

    private static string StatusLabel(string status) => status switch
    {
        "healthy" => "Healthy",
        "stressed" => "Stressed",
        "bleached" => "Bleached",
        _ => status,
    };

    private int StatusCount(string status) => _reefs.Count(r => r.Status == status);

    private double MapLonToPercent(double lon) => (lon - _lonMin) / (_lonMax - _lonMin);

    private double MapLatToPercent(double lat) => 1.0 - (lat - _latMin) / (_latMax - _latMin);
}
