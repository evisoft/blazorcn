@* ============================================================
   Block: map-construction-sites
   Title: MapConstructionSites
   Description: React construction project tracker map block for Next.js with site markers, project phase badges, completion progress bars, and project detail popups using mapcn and shadcn/ui
   Source: original/blocks/map/map-construction-sites.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="hard-hat" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Construction Projects</span>
                <span class="text-xs text-muted-foreground">· @_filtered.Length sites</span>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var ph in _phases)
                {
                    var phase = ph;
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="@($"size-1.5 rounded-full {PhaseDot(phase)}")"></span>
                        @PhaseCounts(phase)
                    </span>
                }
            </div>
        </div>

        @* Filter bar *@
        <div class="flex items-center gap-1.5 border-b px-4 py-2">
            <ButtonCn
                Variant="@(_filter == "all" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                Size="ButtonSize.Sm"
                Class="h-6 px-2 text-xs"
                OnClick="@(() => SetFilter("all"))"
            >
                All
            </ButtonCn>
            @foreach (var ph in _phases)
            {
                var phase = ph;
                <ButtonCn
                    Variant="@(_filter == phase ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                    Size="ButtonSize.Sm"
                    Class="h-6 px-2 text-xs"
                    OnClick="@(() => ToggleFilter(phase))"
                >
                    @PhaseLabel(phase)
                </ButtonCn>
            }
        </div>

        @* Map *@
        <div class="relative h-[460px]">
            <div class="absolute inset-0 overflow-hidden">
                @* Simulated map background *@
                <div class="h-full w-full bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900"></div>
                @* Site markers *@
                @foreach (var proj in _filtered)
                {
                    var project = proj;
                    var pos = GetMarkerPosition(project.Longitude, project.Latitude);
                    var isSelected = _selected == project.Id;
                    <div
                        class="absolute -translate-x-1/2 -translate-y-1/2"
                        style="@($"left:{pos.X.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}%;top:{pos.Y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}%")"
                    >
                        <button
                            type="button"
                            class="flex items-center justify-center"
                            @onclick="@(() => ToggleSelected(project.Id))"
                            title="@project.Name"
                        >
                            <div class="@Cn.Merge("size-3.5 rounded-sm border-2 border-background shadow-sm", PhaseDot(project.Phase))"></div>
                        </button>
                        @* Popup *@
                        @if (isSelected)
                        {
                            <div class="absolute left-1/2 z-10 mt-1.5 w-64 -translate-x-1/2 rounded-md border bg-popover p-3 shadow-lg text-popover-foreground">
                                <div class="mb-1 flex items-center justify-between">
                                    <span class="text-sm font-medium">@project.Name</span>
                                    <button aria-label="Close details"
                                        type="button"
                                        @onclick:stopPropagation
                                        @onclick="@(() => _selected = null)"
                                        class="rounded-sm p-0.5 text-muted-foreground hover:text-foreground"
                                    >
                                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                                    </button>
                                </div>
                                <p class="mb-2 text-xs text-muted-foreground leading-relaxed">
                                    @project.Description
                                </p>
                                <div class="mb-2 flex items-center gap-2">
                                    <BadgeCn Class="@Cn.Merge("text-[10px] font-normal", PhaseText(project.Phase))">
                                        @PhaseLabel(project.Phase)
                                    </BadgeCn>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                        @project.Type
                                    </BadgeCn>
                                </div>
                                @* Progress *@
                                <div class="mb-2">
                                    <div class="mb-1 flex items-center justify-between">
                                        <span class="text-[10px] text-muted-foreground">Completion</span>
                                        <span class="text-[10px] font-medium tabular-nums">@(project.Completion)%</span>
                                    </div>
                                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                        <div
                                            class="@Cn.Merge("h-full rounded-full", ProgressColor(project.Completion, project.Phase))"
                                            style="@($"width:{project.Completion}%")"
                                        ></div>
                                    </div>
                                </div>
                                <div class="grid grid-cols-2 gap-2">
                                    <div class="rounded bg-muted/50 p-2">
                                        <span class="text-[10px] text-muted-foreground">Budget</span>
                                        <p class="text-xs font-semibold tabular-nums">@project.Budget</p>
                                    </div>
                                    <div class="rounded bg-muted/50 p-2">
                                        <span class="text-[10px] text-muted-foreground">Spent</span>
                                        <p class="text-xs font-semibold tabular-nums">@project.Spent</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="pointer-events-none select-none absolute bottom-2 left-2 z-10 rounded bg-background/70 px-2 py-1 text-xs text-muted-foreground">
                Map view — New York, NY
            </div>
        </div>

        @* Project list *@
        <div>
            @foreach (var (proj, index) in _filtered.Select((p, i) => (p, i)))
            {
                var project = proj;
                var isExpanded = _selected == project.Id;
                var isLast = index == _filtered.Length - 1;
                <div class="@(isLast && !isExpanded ? "" : "border-t")">
                    <button
                        type="button"
                        @onclick="@(() => ToggleSelected(project.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    >
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", PhaseDot(project.Phase))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@project.Name</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @project.Contractor · @project.Type
                            </p>
                        </div>
                        <BadgeCn Class="@Cn.Merge("text-[10px] font-normal", PhaseText(project.Phase))">
                            @PhaseLabel(project.Phase)
                        </BadgeCn>
                        <div class="flex items-center gap-2">
                            <div class="h-1.5 w-12 overflow-hidden rounded-full bg-muted">
                                <div
                                    class="@Cn.Merge("h-full rounded-full", ProgressColor(project.Completion, project.Phase))"
                                    style="@($"width:{project.Completion}%")"
                                ></div>
                            </div>
                            <span class="w-7 text-right text-xs font-medium tabular-nums">@(project.Completion)%</span>
                        </div>
                        <LucideIconCn
                            Name="chevron-right"
                            Size="16"
                            Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")"
                        />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <p class="mb-3 text-sm text-muted-foreground leading-relaxed">
                                @project.Description
                            </p>
                            <div class="grid grid-cols-4 gap-3">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="text-xs font-medium text-muted-foreground">Budget</span>
                                    <p class="mt-1 text-sm font-semibold tabular-nums">@project.Budget</p>
                                </div>
                                <div class="rounded-md bg-muted/50 p-3">
                                    <span class="text-xs font-medium text-muted-foreground">Spent</span>
                                    <p class="mt-1 text-sm font-semibold tabular-nums">@project.Spent</p>
                                </div>
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="flex items-center gap-1">
                                        <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="text-xs font-medium text-muted-foreground">Start</span>
                                    </div>
                                    <p class="mt-1 text-sm font-medium">@project.StartDate</p>
                                </div>
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="flex items-center gap-1">
                                        <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="text-xs font-medium text-muted-foreground">End</span>
                                    </div>
                                    <p class="mt-1 text-sm font-medium">@project.EndDate</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Project(
        string Id,
        string Name,
        string Type,
        string Phase,
        double Longitude,
        double Latitude,
        int Completion,
        string Budget,
        string Spent,
        string Contractor,
        string StartDate,
        string EndDate,
        string Description
    );

    private static readonly string[] _phases = ["planning", "in-progress", "completed", "delayed"];

    private static readonly Project[] _projects =
    [
        new("p1", "Midtown Tower Complex",        "Commercial",    "in-progress", -73.9857, 40.7484,  64, "$42.5M", "$27.2M", "Turner Construction", "Mar 2025", "Sep 2027", "Mixed-use 32-story tower with retail podium and 280 residential units."),
        new("p2", "Hudson Yards Phase 4",          "Mixed Use",     "planning",    -74.0013, 40.7536,  12, "$128M",  "$15.4M", "Skanska USA",         "Jan 2026", "Dec 2029", "Final phase of Hudson Yards including office space and public gardens."),
        new("p3", "East River Greenway Extension", "Infrastructure","in-progress", -73.9712, 40.7128,  78, "$18.3M", "$14.3M", "AECOM",               "Jun 2024", "Apr 2026", "1.2-mile waterfront path extension with protected cycling lanes and rest areas."),
        new("p4", "Williamsburg School Renovation","Public",        "completed",   -73.9574, 40.7148, 100, "$8.7M",  "$8.4M",  "Lendlease",           "Sep 2024", "Feb 2026", "Full interior renovation with seismic retrofit and ADA compliance upgrades."),
        new("p5", "Chelsea Market Expansion",      "Commercial",    "delayed",     -74.0063, 40.7424,  35, "$22.1M", "$12.8M", "Gilbane Building",    "Nov 2024", "Aug 2026", "Ground-floor retail expansion with rooftop event space. Delayed by permitting issues."),
        new("p6", "Harlem Affordable Housing",     "Residential",   "in-progress", -73.9465, 40.8116,  52, "$34.6M", "$18.0M", "L+M Development",     "Apr 2025", "Nov 2027", "12-story affordable housing complex with 148 units and community center."),
        new("p7", "Battery Park Seawall",          "Infrastructure","planning",    -74.0173, 40.7033,   8, "$96M",   "$7.7M",  "Bechtel",             "Mar 2026", "Jun 2029", "Climate resilience seawall protecting lower Manhattan from storm surge flooding."),
    ];

    private string _filter   = "all";
    private string? _selected = null;

    private Project[] _filtered => _filter == "all"
        ? _projects
        : Array.FindAll(_projects, p => p.Phase == _filter);

    private int PhaseCounts(string phase) =>
        Array.FindAll(_projects, p => p.Phase == phase).Length;

    private static string PhaseDot(string phase) => phase switch
    {
        "planning"    => "bg-blue-500",
        "in-progress" => "bg-amber-500",
        "completed"   => "bg-emerald-500",
        "delayed"     => "bg-red-500",
        _             => "bg-muted",
    };

    private static string PhaseText(string phase) => phase switch
    {
        "planning"    => "text-blue-700 dark:text-blue-400 bg-blue-500/10",
        "in-progress" => "text-amber-700 dark:text-amber-400 bg-amber-500/10",
        "completed"   => "text-emerald-700 dark:text-emerald-400 bg-emerald-500/10",
        "delayed"     => "text-red-700 dark:text-red-400 bg-red-500/10",
        _             => "",
    };

    private static string PhaseLabel(string phase) => phase switch
    {
        "planning"    => "Planning",
        "in-progress" => "In Progress",
        "completed"   => "Completed",
        "delayed"     => "Delayed",
        _             => phase,
    };

    private static string ProgressColor(int pct, string phase)
    {
        if (phase == "delayed")   return "bg-red-500";
        if (phase == "completed") return "bg-emerald-500";
        if (pct >= 70) return "bg-emerald-500";
        if (pct >= 40) return "bg-amber-500";
        return "bg-blue-500";
    }

    private void SetFilter(string value)
    {
        _filter = value;
        _selected = null;
    }

    private void ToggleFilter(string phase)
    {
        _filter = _filter == phase ? "all" : phase;
        _selected = null;
    }

    private void ToggleSelected(string id)
    {
        _selected = _selected == id ? null : id;
    }

    // Map lon/lat to CSS % within the placeholder.
    // Viewport: lon [-74.04, -73.93], lat [41.69, 41.83]
    private static (double X, double Y) GetMarkerPosition(double longitude, double latitude)
    {
        const double lonMin = -74.04, lonMax = -73.93;
        const double latMin = 41.69,  latMax = 41.83;
        var x = (longitude - lonMin) / (lonMax - lonMin) * 100.0;
        var y = (1.0 - (latitude - latMin) / (latMax - latMin)) * 100.0;
        x = Math.Clamp(x, 5, 90);
        y = Math.Clamp(y, 5, 90);
        return (x, y);
    }
}
