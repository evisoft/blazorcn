@* ============================================================
   Block: map-meetup-locations
   Title: MapMeetupLocations
   Description: React meetup and gathering spot finder map block for Next.js with event type markers, attendee count badges, date and time info, and meetup detail popups using mapcn map components, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-meetup-locations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Upcoming Meetups</span>
                <span class="text-xs text-muted-foreground">@_filtered.Length events</span>
            </div>
            <div class="flex items-center gap-1">
                <button
                    type="button"
                    @onclick="@(() => SetFilter(null))"
                    class="@Cn.Merge("rounded-md px-2 py-1 text-xs transition-colors", _filter == null ? "bg-muted font-medium" : "text-muted-foreground hover:bg-muted/50")"
                >
                    All
                </button>
                @foreach (var c in _categories)
                {
                    var cat = c;
                    var cfg = GetCategoryConfig(cat);
                    <button
                        type="button"
                        @onclick="@(() => ToggleFilter(cat))"
                        class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-2 py-1 text-xs transition-colors", _filter == cat ? "bg-muted font-medium" : "text-muted-foreground hover:bg-muted/50")"
                    >
                        <span class="@($"size-1.5 rounded-full {cfg.Dot}")"></span>
                        @cfg.Label
                    </button>
                }
            </div>
        </div>

        <div class="flex">
            @* Sidebar *@
            <div class="w-60 shrink-0 border-r">
                <div class="max-h-[500px] overflow-y-auto">
                    @foreach (var m in _filtered)
                    {
                        var meetup = m;
                        var cfg = GetCategoryConfig(meetup.Category);
                        var isSelected = _selectedId == meetup.Id;
                        <button
                            type="button"
                            @onclick="@(() => ToggleSelected(meetup.Id))"
                            class="@Cn.Merge("flex w-full flex-col gap-1 border-b px-3 py-2.5 text-left transition-colors hover:bg-muted/50", isSelected ? "bg-muted/50" : "")"
                        >
                            <div class="flex items-center gap-2">
                                <span class="@($"size-1.5 shrink-0 rounded-full {cfg.Dot}")"></span>
                                <span class="min-w-0 flex-1 truncate text-sm font-medium">@meetup.Title</span>
                            </div>
                            <div class="flex items-center gap-2 pl-3.5 text-xs text-muted-foreground">
                                <span>@meetup.Date</span>
                                <span>·</span>
                                <span>@meetup.Time</span>
                            </div>
                            <div class="flex items-center gap-2 pl-3.5 text-xs text-muted-foreground">
                                <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                <span class="truncate">@meetup.Venue</span>
                                <span class="ml-auto flex items-center gap-1">
                                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                                    <span class="tabular-nums">@meetup.Attendees</span>
                                </span>
                            </div>
                        </button>
                    }
                </div>
            </div>

            @* Map *@
            <div class="relative h-[500px] flex-1">
                <div class="absolute inset-0 overflow-hidden">
                    @* Simulated map background *@
                    <div class="h-full w-full bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-800 dark:to-slate-900"></div>
                    @* Meetup markers *@
                    @foreach (var m in _filtered)
                    {
                        var meetup = m;
                        var cfg = GetCategoryConfig(meetup.Category);
                        var isSelected = _selectedId == meetup.Id;
                        var pos = GetMarkerPosition(meetup.Longitude, meetup.Latitude);
                        <div
                            class="absolute -translate-x-1/2 -translate-y-1/2"
                            style="@($"left:{pos.X.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}%;top:{pos.Y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}%")"
                        >
                            <button
                                type="button"
                                @onclick="@(() => ToggleSelected(meetup.Id))"
                                class="@Cn.Merge("flex items-center justify-center rounded-full border-2 border-background shadow-lg transition-all", isSelected ? "size-9" : "size-7")"
                                style="@($"background-color:{cfg.Color}")"
                                title="@meetup.Title"
                            >
                                <LucideIconCn Name="@cfg.Icon" Size="@(isSelected ? 16 : 12)" Class="@(isSelected ? "size-4 text-white" : "size-3 text-white")" />
                            </button>
                            @* Popup *@
                            @if (isSelected)
                            {
                                var selCfg = GetCategoryConfig(meetup.Category);
                                <div class="absolute left-1/2 z-10 mt-1.5 w-56 -translate-x-1/2 rounded-md border bg-popover p-3 shadow-lg text-popover-foreground">
                                    <div class="flex items-center gap-2">
                                        <span class="@($"size-1.5 rounded-full {selCfg.Dot}")"></span>
                                        <span class="text-sm font-medium">@meetup.Title</span>
                                    </div>
                                    <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">@meetup.Description</p>
                                    <div class="mt-2 space-y-1">
                                        <div class="flex items-center gap-1.5 text-xs">
                                            <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground" />
                                            <span>@meetup.Venue</span>
                                        </div>
                                        <div class="flex items-center gap-1.5 text-xs">
                                            <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                                            <span>@meetup.Date at @meetup.Time</span>
                                        </div>
                                        <div class="flex items-center gap-1.5 text-xs">
                                            <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                                            <span class="tabular-nums">@meetup.Attendees/@meetup.Capacity</span>
                                            <span class="text-muted-foreground">attending</span>
                                        </div>
                                    </div>
                                    <div class="mt-2.5 flex items-center justify-between">
                                        <span class="text-xs text-muted-foreground">@meetup.Organizer</span>
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-6 text-xs">RSVP</ButtonCn>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="absolute bottom-2 left-2 z-10 rounded bg-background/70 px-2 py-1 text-xs text-muted-foreground pointer-events-none select-none">
                    Map view — New York, NY
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Meetup(
        string Id,
        string Title,
        string Category,
        string Venue,
        string Address,
        double Longitude,
        double Latitude,
        string Date,
        string Time,
        int Attendees,
        int Capacity,
        string Organizer,
        string Description
    );

    private record CategoryConfig(string Label, string Dot, string Color, string Icon);

    private static CategoryConfig GetCategoryConfig(string category) => category switch
    {
        "tech"     => new("Tech",     "bg-blue-500",    "#3b82f6", "code"),
        "design"   => new("Design",   "bg-purple-500",  "#a855f7", "palette"),
        "business" => new("Business", "bg-emerald-500", "#22c55e", "briefcase"),
        "social"   => new("Social",   "bg-amber-500",   "#eab308", "party-popper"),
        _          => new(category,   "bg-muted",       "#888888", "circle"),
    };

    private static readonly string[] _categories = ["tech", "design", "business", "social"];

    private static readonly Meetup[] _meetups =
    [
        new("m1", "React NYC Monthly",       "tech",     "TechHub NYC",        "335 Madison Ave, Floor 4", -73.9787, 40.7549, "Apr 3",  "6:30 PM",  124, 150, "NYC React Community",    "Monthly meetup covering React 19 Server Components, the new compiler, and community projects. Lightning talks welcome."),
        new("m2", "Design Systems Roundtable","design",  "WeWork Soho",        "154 Grand St",             -73.9996, 40.7215, "Apr 5",  "12:00 PM",  42,  60, "Design Systems NYC",     "Lunch roundtable on scaling design systems across product teams. Bring your challenges and wins."),
        new("m3", "Startup Pitch Night",      "business","Galvanize",          "303 Spring St",            -74.0052, 40.7263, "Apr 7",  "7:00 PM",   89, 120, "NYC Founders Network",   "Five early-stage startups pitch to a panel of angel investors and VCs. Networking reception follows."),
        new("m4", "TypeScript Deep Dive",     "tech",    "Microsoft Reactor",  "11 Times Square",          -73.9907, 40.7569, "Apr 9",  "6:00 PM",   76, 100, "TypeScript NYC",         "Advanced TypeScript patterns: conditional types, template literals, and type-safe API design with Zod."),
        new("m5", "Freelancer Social",        "social",  "The Bean",           "824 Broadway",             -73.9918, 40.7340, "Apr 10", "5:00 PM",   31,  40, "NYC Freelancers",        "Casual meetup for freelancers and indie developers. Share leads, swap stories, make friends."),
        new("m6", "UX Research Workshop",     "design",  "General Assembly",   "10 E 21st St",             -73.9894, 40.7395, "Apr 12", "10:00 AM",  28,  35, "UXR Collective",         "Hands-on workshop on conducting moderated usability tests. Bring a laptop with Zoom installed."),
        new("m7", "SaaS Growth Breakfast",    "business","Alley Chelsea",      "119 W 24th St",            -73.9935, 40.7441, "Apr 14", "8:00 AM",   55,  70, "SaaS Founders NYC",      "Breakfast session on PLG strategies, churn reduction, and pricing experiments. Case studies from local founders."),
    ];

    private string? _selectedId = null;
    private string? _filter     = null;

    private Meetup[] _filtered => _filter == null
        ? _meetups
        : Array.FindAll(_meetups, m => m.Category == _filter);

    private void SetFilter(string? cat)
    {
        _filter = cat;
        _selectedId = null;
    }

    private void ToggleFilter(string cat)
    {
        _filter = _filter == cat ? null : cat;
        _selectedId = null;
    }

    private void ToggleSelected(string id)
    {
        _selectedId = _selectedId == id ? null : id;
    }

    // Map lon/lat to CSS percentage positions.
    // NYC viewport: lon [-74.02, -73.97], lat [40.715, 40.765]
    private static (double X, double Y) GetMarkerPosition(double longitude, double latitude)
    {
        const double lonMin = -74.02, lonMax = -73.97;
        const double latMin = 40.715, latMax = 40.765;
        var x = (longitude - lonMin) / (lonMax - lonMin) * 100.0;
        var y = (1.0 - (latitude - latMin) / (latMax - latMin)) * 100.0;
        x = Math.Clamp(x, 5, 92);
        y = Math.Clamp(y, 5, 92);
        return (x, y);
    }
}
