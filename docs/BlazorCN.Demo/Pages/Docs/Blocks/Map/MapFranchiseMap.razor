@* ============================================================
   Block: map-franchise-map
   Title: MapFranchiseMap
   Description: Interactive franchise network map with revenue-sized markers, territory type badges, performance metrics popups, and region filtering built with mapcn, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-franchise-map.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="building" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Franchise Network</span>
                <span class="text-xs text-muted-foreground">@_filtered.Length locations</span>
            </div>
            <div class="flex items-center gap-1.5">
                <button
                    type="button"
                    @onclick="@(() => _filter = null)"
                    class="@Cn.Merge("rounded-full px-2.5 py-0.5 text-xs transition-colors", _filter == null ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")">
                    All
                </button>
                @foreach (var tp in _types)
                {
                    var t = tp;
                    <button
                        type="button"
                        @onclick="@(() => _filter = (_filter == t ? null : t))"
                        class="@Cn.Merge("flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs transition-colors", _filter == t ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")">
                        <span class="@Cn.Merge("size-1.5 rounded-full", TypeColor(t))"></span>
                        @TypeLabel(t)
                    </button>
                }
            </div>
        </div>

        @* Summary stats *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <span class="text-xs text-muted-foreground">Total monthly</span>
                <p class="text-2xl font-semibold tabular-nums">@FormatRevenue(_totalRevenue)</p>
            </div>
            <div>
                <span class="text-xs text-muted-foreground">Avg satisfaction</span>
                <p class="text-2xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">@_avgSatisfaction</p>
            </div>
            <div>
                <span class="text-xs text-muted-foreground">Locations</span>
                <p class="text-2xl font-semibold tabular-nums">@_franchises.Length</p>
            </div>
        </div>

        @* Map placeholder — Map/MapMarker/MarkerPopup/MarkerTooltip are React-only; rendered as a styled placeholder *@
        <div class="relative h-[500px] bg-muted/30 flex items-center justify-center">
            <div class="flex flex-col items-center gap-4 text-muted-foreground">
                <LucideIconCn Name="map" Size="48" Class="size-12 opacity-30" />
                <div class="text-center">
                    <p class="text-sm font-medium">Interactive Franchise Map</p>
                    <p class="text-xs opacity-70">New York · @_filtered.Length locations</p>
                </div>
                @* Franchise markers legend *@
                <div class="flex flex-wrap items-center justify-center gap-3 mt-1">
                    @foreach (var fr in _filtered)
                    {
                        var f = fr;
                        var size = GetMarkerSize(f.MonthlyRevenue);
                        <div
                            @onclick="@(() => _selected = (_selected == f.Id ? null : f.Id))"
                            class="flex cursor-pointer flex-col items-center gap-1">
                            <div
                                class="@Cn.Merge("flex items-center justify-center rounded-full border-2 border-white shadow-md", TypeColor(f.Type))"
                                style="@(FormattableString.Invariant($"width:{size}px;height:{size}px"))">
                                <span class="text-[10px] font-medium text-white tabular-nums">
                                    @FormatRevenue(f.MonthlyRevenue)
                                </span>
                            </div>
                            <span class="text-[9px]">@f.Name.Split(' ')[0]</span>
                        </div>
                    }
                </div>

                @* Popup preview *@
                @if (_selected != null)
                {
                    var popup = System.Array.Find(_franchises, x => x.Id == _selected);
                    @if (popup != null)
                    {
                        <div class="mt-2 rounded-lg border bg-card p-3 shadow-md w-60">
                            <div class="mb-2 flex items-start justify-between">
                                <div>
                                    <p class="text-sm font-medium">@popup.Name</p>
                                    <p class="text-xs text-muted-foreground">@popup.Address</p>
                                </div>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                    @TypeLabel(popup.Type)
                                </BadgeCn>
                            </div>
                            <div class="mb-2 grid grid-cols-2 gap-2">
                                <div class="rounded-md bg-muted/50 p-2">
                                    <span class="text-[10px] text-muted-foreground">Revenue/mo</span>
                                    <p class="text-sm font-medium tabular-nums">
                                        @FormatRevenue(popup.MonthlyRevenue)
                                    </p>
                                </div>
                                <div class="rounded-md bg-muted/50 p-2">
                                    <span class="text-[10px] text-muted-foreground">Customers</span>
                                    <p class="text-sm font-medium tabular-nums">
                                        @popup.Customers.ToString("N0")
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 border-t pt-2">
                                <div class="flex items-center gap-1">
                                    <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                                    <span class="text-xs font-medium tabular-nums">
                                        @popup.Satisfaction
                                    </span>
                                </div>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="text-xs text-muted-foreground">@popup.TopProduct</span>
                            </div>
                            <button type="button" @onclick="@(() => _selected = null)" class="mt-2 text-[10px] text-muted-foreground hover:text-foreground">Close</button>
                        </div>
                    }
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center gap-4 border-t px-4 py-2.5">
            @foreach (var tp in _types)
            {
                var t = tp;
                var cnt = System.Array.FindAll(_franchises, f => f.Type == t).Length;
                var rev = System.Array.FindAll(_franchises, f => f.Type == t).Sum(f => f.MonthlyRevenue);
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="@Cn.Merge("size-1.5 rounded-full", TypeColor(t))"></span>
                    @TypeLabel(t) (@cnt) · @FormatRevenue(rev)
                </span>
            }
        </div>
    </div>
</section>

@code {
    private string? _selected = null;
    private string? _filter = null;

    private static readonly string[] _types = ["flagship", "standard", "express"];

    private record Franchise(string Id, string Name, string Type, string Address, int MonthlyRevenue, int Customers, double Satisfaction, string TopProduct, double Longitude, double Latitude);

    private static readonly Franchise[] _franchises =
    [
        new("f1", "Midtown Flagship",       "flagship", "350 5th Ave, New York",        284000, 12400, 4.8, "Premium Bundle", -73.9857, 40.7484),
        new("f2", "SoHo Standard",          "standard", "580 Broadway, New York",        168000,  7800, 4.5, "Classic Package",-73.9969, 40.7234),
        new("f3", "Chelsea Express",        "express",  "75 9th Ave, New York",           92000,  5200, 4.3, "Quick Service",  -74.0048, 40.7425),
        new("f4", "Union Square",           "standard", "33 E 17th St, New York",        196000,  8900, 4.6, "Premium Bundle", -73.9903, 40.7371),
        new("f5", "East Village Express",   "express",  "51 Astor Pl, New York",          78000,  4600, 4.2, "Quick Service",  -73.9911, 40.7299),
        new("f6", "Times Square Flagship",  "flagship", "1560 Broadway, New York",       342000, 15200, 4.7, "Premium Bundle", -73.9845, 40.7589),
        new("f7", "Gramercy Standard",      "standard", "281 Park Ave S, New York",      145000,  6400, 4.4, "Classic Package",-73.9866, 40.7382),
        new("f8", "FiDi Express",           "express",  "120 Broadway, New York",        104000,  5800, 4.1, "Quick Service",  -74.0105, 40.7082),
    ];

    private Franchise[] _filtered => _filter == null
        ? _franchises
        : System.Array.FindAll(_franchises, f => f.Type == _filter);

    private int _totalRevenue => _franchises.Sum(f => f.MonthlyRevenue);

    private string _avgSatisfaction => (_franchises.Sum(f => f.Satisfaction) / _franchises.Length).ToString("F1");

    private static double GetMarkerSize(int revenue)
    {
        const double min = 70000;
        const double max = 350000;
        var clamped = Math.Max(min, Math.Min(max, revenue));
        return 16 + ((clamped - min) / (max - min)) * 16;
    }

    private static string FormatRevenue(int amount) => $"${amount / 1000}K";

    private static string TypeColor(string franchiseType) => franchiseType switch
    {
        "flagship" => "bg-blue-500",
        "standard" => "bg-emerald-500",
        "express"  => "bg-amber-500",
        _          => "bg-gray-400",
    };

    private static string TypeLabel(string franchiseType) => franchiseType switch
    {
        "flagship" => "Flagship",
        "standard" => "Standard",
        "express"  => "Express",
        _          => franchiseType,
    };
}
