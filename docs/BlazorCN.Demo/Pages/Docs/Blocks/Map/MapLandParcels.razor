@* ============================================================
   Block: map-land-parcels
   Title: MapLandParcels
   Description: Interactive land parcel boundary viewer map with parcel markers, size information, zoning type badges, ownership data, and parcel detail cards built with mapcn, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-land-parcels.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="land-plot" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Land parcels</span>
                <span class="text-xs text-muted-foreground">@_filtered.Length parcels</span>
            </div>
            <div class="flex items-center gap-1.5">
                <button
                    type="button"
                    @onclick="@(() => SetFilter(null))"
                    class="@Cn.Merge("rounded-full px-2.5 py-0.5 text-xs transition-colors", _zFilter == null ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")"
                >
                    All
                </button>
                @foreach (var zt in _types)
                {
                    var z = zt;
                    <button
                        type="button"
                        @onclick="@(() => SetFilter(z))"
                        class="@Cn.Merge("flex items-center gap-1 rounded-full px-2.5 py-0.5 text-xs capitalize transition-colors", _zFilter == z ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")"
                    >
                        <span class="@Cn.Merge("size-1.5 rounded-full", ZDot[z])"></span>
                        @z
                    </button>
                }
            </div>
        </div>

        @* Map placeholder — MapCn is not yet available; render a styled grid of parcel cards *@
        <div class="relative h-[500px] overflow-y-auto bg-muted/20 p-4">
            <div class="mb-3 flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="map" Size="14" Class="size-3.5" />
                <span>Land Parcels Map</span>
            </div>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
                @foreach (var parcel in _filtered)
                {
                    var p = parcel;
                    <div
                        class="@Cn.Merge("cursor-pointer rounded-lg border bg-card p-3 shadow-sm transition-shadow hover:shadow-md", _selected == p.Id ? "ring-2 ring-foreground" : "")"
                        @onclick="@(() => ToggleSelected(p.Id))"
                    >
                        <div class="mb-2 flex items-start justify-between">
                            <div class="flex items-center gap-2">
                                <div
                                    class="flex size-6 items-center justify-center rounded-full border-2 border-white shadow-md"
                                    style="@($"background-color:{ZColors[p.Zoning]}")"
                                >
                                    <LucideIconCn Name="@ZIcon[p.Zoning]" Size="12" Class="size-3 text-white" />
                                </div>
                                <div>
                                    <p class="font-mono text-sm font-medium">@p.Apn</p>
                                    <p class="text-xs text-muted-foreground">@p.Address</p>
                                </div>
                            </div>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal capitalize">
                                @p.Zoning
                            </BadgeCn>
                        </div>

                        @if (_selected == p.Id)
                        {
                            <div class="mb-2 space-y-1">
                                <div class="flex justify-between text-xs">
                                    <span class="text-muted-foreground">Owner</span>
                                    <span class="flex items-center gap-1 font-medium">
                                        <LucideIconCn Name="user" Size="12" Class="size-3 text-muted-foreground" />
                                        @p.Owner
                                    </span>
                                </div>
                                <div class="flex justify-between text-xs">
                                    <span class="text-muted-foreground">Lot size</span>
                                    <span class="font-medium tabular-nums">@p.Acreage acres</span>
                                </div>
                                <div class="flex justify-between text-xs">
                                    <span class="text-muted-foreground">Assessed</span>
                                    <span class="font-medium tabular-nums">@Fmt(p.Value)</span>
                                </div>
                                <div class="flex justify-between text-xs">
                                    <span class="text-muted-foreground">Annual tax</span>
                                    <span class="font-medium tabular-nums">@Fmt(p.Tax)</span>
                                </div>
                            </div>
                            <div class="rounded-md bg-muted/50 p-2">
                                <span class="text-[10px] font-medium text-muted-foreground">
                                    Permitted use
                                </span>
                                <div class="mt-1 flex flex-wrap gap-1">
                                    @foreach (var use in p.Uses)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal">
                                            @use
                                        </BadgeCn>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center gap-4 border-t px-4 py-2.5">
            @foreach (var zt in _types)
            {
                var z = zt;
                var count = _parcels.Count(p => p.Zoning == z);
                <span class="flex items-center gap-1.5 text-xs capitalize text-muted-foreground">
                    <span class="@Cn.Merge("size-1.5 rounded-full", ZDot[z])"></span>
                    @z (@count)
                </span>
            }
            <span class="ml-auto text-xs text-muted-foreground tabular-nums">
                @(_parcels.Sum(p => p.Acreage).ToString("F1")) total acres
            </span>
        </div>
    </div>
</section>

@code {
    private record Parcel(
        string Id,
        string Apn,
        string Owner,
        string Zoning,
        double Acreage,
        int Value,
        int Tax,
        string Address,
        string[] Uses
    );

    private static readonly Dictionary<string, string> ZColors = new()
    {
        ["residential"] = "#3b82f6",
        ["commercial"] = "#f59e0b",
        ["industrial"] = "#8b5cf6",
        ["mixed-use"] = "#22c55e",
        ["agricultural"] = "#84cc16",
    };

    private static readonly Dictionary<string, string> ZDot = new()
    {
        ["residential"] = "bg-blue-500",
        ["commercial"] = "bg-amber-500",
        ["industrial"] = "bg-violet-500",
        ["mixed-use"] = "bg-emerald-500",
        ["agricultural"] = "bg-lime-500",
    };

    private static readonly Dictionary<string, string> ZIcon = new()
    {
        ["residential"] = "house",
        ["commercial"] = "building",
        ["industrial"] = "factory",
        ["mixed-use"] = "building",
        ["agricultural"] = "trees",
    };

    private static readonly Parcel[] _parcels =
    [
        new("p1", "012-345-678", "Westfield Properties LLC", "commercial", 2.4, 4850000, 58200,
            "1200 Market St, Denver, CO", ["Retail", "Office", "Restaurant"]),
        new("p2", "012-345-712", "Sarah M. Chen", "residential", 0.35, 725000, 8700,
            "438 Vine St, Denver, CO", ["Single-family", "ADU"]),
        new("p3", "012-346-001", "Industrial Park Holdings", "industrial", 8.7, 3200000, 38400,
            "5500 Brighton Blvd, Denver, CO", ["Warehouse", "Manufacturing"]),
        new("p4", "012-347-204", "Capitol Hill Development Co", "mixed-use", 1.1, 2100000, 25200,
            "800 E Colfax Ave, Denver, CO", ["Residential", "Retail"]),
        new("p5", "012-348-089", "Green Valley Farms Inc", "agricultural", 24.5, 980000, 5880,
            "16200 E 56th Ave, Denver, CO", ["Farming", "Livestock"]),
    ];

    private static readonly string[] _types = ["residential", "commercial", "industrial", "mixed-use", "agricultural"];

    private string? _zFilter = null;
    private string? _selected = null;

    private Parcel[] _filtered => _zFilter == null ? _parcels : _parcels.Where(p => p.Zoning == _zFilter).ToArray();

    private static string Fmt(int v)
    {
        if (v >= 1_000_000) return $"${(v / 1_000_000.0).ToString("F1")}M";
        if (v >= 1_000) return $"${(v / 1_000.0).ToString("F0")}K";
        return $"${v}";
    }

    private void SetFilter(string? zoning)
    {
        _zFilter = zoning;
        _selected = null;
    }

    private void ToggleSelected(string id)
    {
        _selected = _selected == id ? null : id;
    }
}
