@* ============================================================
   Block: map-revenue-by-region
   Title: MapRevenueByRegion
   Description: React revenue breakdown map block for Next.js with region-sized markers, revenue badges, growth indicators, and regional performance panel using mapcn and shadcn/ui
   Source: original/blocks/map/map-revenue-by-region.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="dollar-sign" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Revenue by Region</span>
            </div>
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>Q4 2025</span>
                <span>·</span>
                <span>@_regions.Length regions</span>
            </div>
        </div>

        @* Summary bar *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">
                    @FormatCurrency(_totalRevenue)
                </span>
                <span class="text-muted-foreground text-xs">total</span>
            </div>
            <div class="flex items-center gap-1">
                @if (_weightedGrowth >= 0)
                {
                    <LucideIconCn Name="arrow-up-right" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                }
                else
                {
                    <LucideIconCn Name="arrow-down-right" Size="14" Class="size-3.5 text-red-600 dark:text-red-400" />
                }
                <span class="@Cn.Merge("text-xs font-medium tabular-nums", _weightedGrowth >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                    @(_weightedGrowth >= 0 ? "+" : "")@(_weightedGrowth.ToString("F1"))%
                </span>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">
                @(_regions.Sum(r => r.Deals).ToString("N0")) deals
            </span>
        </div>

        @* Map placeholder — Map/MapMarker/MarkerContent/MarkerTooltip are React-only; rendered as a styled placeholder *@
        <div class="relative h-[350px] border-b bg-muted/30 flex items-center justify-center">
            <div class="flex flex-col items-center gap-4 text-muted-foreground">
                <LucideIconCn Name="map" Size="48" Class="size-12 opacity-30" />
                <div class="text-center">
                    <p class="text-sm font-medium">Interactive Revenue Map</p>
                    <p class="text-xs opacity-70">World · @_regions.Length regions</p>
                </div>
                @* Marker legend *@
                <div class="flex flex-wrap items-center justify-center gap-4 mt-1">
                    @foreach (var reg in _regions)
                    {
                        var region = reg;
                        int size = MarkerSize(region.Revenue);
                        <button
                            type="button"
                            @onclick="@(() => _selected = region.Id)"
                            class="flex flex-col items-center gap-1">
                            <div
                                class="@Cn.Merge("flex items-center justify-center rounded-full border-2 border-white/80 bg-foreground/80 shadow-lg transition-transform", _selected == region.Id ? "ring-2 ring-foreground/30 scale-110" : "")"
                                style="@($"width:{size}px;height:{size}px")">
                                <span class="font-semibold text-background text-[10px] tabular-nums">
                                    @FormatCurrency(region.Revenue)
                                </span>
                            </div>
                            <span class="text-[9px]">@region.Name.Split(' ')[0]</span>
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Selected region detail *@
        @if (_selectedRegion != null)
        {
            var sr = _selectedRegion;
            int pct = (int)Math.Round((double)sr.Revenue / _totalRevenue * 100);
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <div>
                        <span class="font-medium text-sm">@sr.Name</span>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span class="tabular-nums">@sr.Deals deals</span>
                            <span>·</span>
                            <span>Top: @sr.TopProduct</span>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="font-semibold text-lg tabular-nums">
                            @FormatCurrency(sr.Revenue)
                        </span>
                        <div class="flex items-center justify-end gap-1">
                            @if (sr.Growth >= 0)
                            {
                                <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                            }
                            else
                            {
                                <LucideIconCn Name="arrow-down-right" Size="12" Class="size-3 text-red-600 dark:text-red-400" />
                            }
                            <span class="@Cn.Merge("text-xs tabular-nums font-medium", sr.Growth >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                @(sr.Growth >= 0 ? "+" : "")@sr.Growth%
                            </span>
                        </div>
                    </div>
                </div>
                @* Revenue proportion bar *@
                <div class="mt-2 h-1.5 rounded-full bg-muted">
                    <div
                        class="h-full rounded-full bg-foreground/60"
                        style="@($"width:{pct}%")">
                    </div>
                </div>
                <span class="mt-1 block text-muted-foreground text-xs tabular-nums">
                    @pct% of total revenue
                </span>
            </div>
        }

        @* Region list *@
        <div>
            @foreach (var reg in _sortedRegions)
            {
                var region = reg;
                bool isExpanded = _expanded == region.Id;
                bool isLast = region.Id == _sortedRegions[^1].Id;
                int sharePct = (int)Math.Round((double)region.Revenue / _totalRevenue * 100);
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => { _expanded = (isExpanded ? null : region.Id); _selected = region.Id; })"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", _selected == region.Id ? "bg-muted/30" : "")">
                        <LucideIconCn Name="trending-up" Size="14" Class="@Cn.Merge("size-3.5 shrink-0", region.Growth >= 0 ? "text-emerald-500" : "rotate-90 text-red-500")" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@region.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @region.Deals deals · @region.TopProduct
                            </p>
                        </div>
                        <span class="font-medium text-sm tabular-nums">
                            @FormatCurrency(region.Revenue)
                        </span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Revenue share</span>
                                    <span class="tabular-nums">@sharePct%</span>
                                </div>
                                <div class="mt-2 h-1.5 rounded-full bg-muted">
                                    <div
                                        class="h-full rounded-full bg-foreground/60"
                                        style="@($"width:{sharePct}%")">
                                    </div>
                                </div>
                                <div class="mt-2 flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Growth</span>
                                    <span class="@Cn.Merge("font-medium tabular-nums", region.Growth >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                        @(region.Growth >= 0 ? "+" : "")@region.Growth%
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _selected = "na-east";
    private string? _expanded = null;

    private record Region(string Id, string Name, int Revenue, double Growth, int Deals, string TopProduct, double Longitude, double Latitude);

    private static readonly Region[] _regions =
    [
        new("na-east", "North America East", 4_250_000, 12.4, 342, "Enterprise Suite", -74.006,   40.7128),
        new("na-west", "North America West", 3_780_000,  8.1, 287, "Cloud Platform",  -122.4194,  37.7749),
        new("europe",  "Western Europe",     2_930_000, 15.7, 198, "Enterprise Suite",  2.3522,   48.8566),
        new("apac",    "Asia Pacific",       1_850_000, 23.2, 156, "Cloud Platform",  103.8198,    1.3521),
        new("latam",   "Latin America",        920_000, -3.5,  74, "Starter Plan",    -43.1729,  -22.9068),
        new("mea",     "Middle East & Africa",  680_000, 31.6,  48, "Cloud Platform",   55.2708,   25.2048),
    ];

    private static readonly int _totalRevenue = _regions.Sum(r => r.Revenue);
    private static readonly int _maxRevenue = _regions.Max(r => r.Revenue);

    private Region[] _sortedRegions => _regions.OrderByDescending(r => r.Revenue).ToArray();

    private Region? _selectedRegion => _regions.FirstOrDefault(r => r.Id == _selected);

    private double _weightedGrowth => _regions.Sum(r => r.Growth * r.Revenue) / _totalRevenue;

    private static string FormatCurrency(int amount)
    {
        if (amount >= 1_000_000) return $"${(amount / 1_000_000.0):F1}M";
        if (amount >= 1_000)     return $"${(amount / 1_000.0):F0}K";
        return $"${amount}";
    }

    private static int MarkerSize(int revenue)
    {
        double ratio = (double)revenue / _maxRevenue;
        return (int)Math.Round(20 + ratio * 24);
    }
}
