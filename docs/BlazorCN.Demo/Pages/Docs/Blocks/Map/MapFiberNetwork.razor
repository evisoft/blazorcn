@* ============================================================
   Block: map-fiber-network
   Title: MapFiberNetwork
   Description: React fiber optic network map block for Next.js with backbone route lines, exchange markers, connection density clusters, and network capacity indicators using mapcn map components, shadcn/ui, and Tailwind CSS
   Source: original/blocks/map/map-fiber-network.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="network" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Fiber Network</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideIconCn Name="wifi" Size="12" Class="size-3" />
                    @_totalSubscribers.ToString("N0") subscribers
                </span>
                <span class="text-xs text-muted-foreground">·</span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_onlineCount online
                </span>
                @if (_issueCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-xs text-amber-600 dark:text-amber-400">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        @_issueCount issues
                    </span>
                }
            </div>
        </div>

        @* Map placeholder — Map/MapRoute/MapMarker/MarkerContent/MarkerTooltip are React-only; rendered as styled placeholder *@
        <div class="relative h-[420px] bg-muted/30 flex items-center justify-center">
            <div class="flex flex-col items-center gap-3 text-muted-foreground">
                <LucideIconCn Name="map" Size="48" Class="size-12 opacity-30" />
                <div class="text-center">
                    <p class="text-sm font-medium">Interactive Fiber Network Map</p>
                    <p class="text-xs opacity-70">New York City · Backbone routes + exchange markers</p>
                </div>
                @* Exchange marker dots legend *@
                <div class="flex flex-wrap items-center justify-center gap-4 mt-2">
                    @foreach (var ex in _exchanges)
                    {
                        var exch = ex;
                        var tc = TypeConfig(exch.Type);
                        var sc = StatusConfig(exch.Status);
                        <div class="flex flex-col items-center gap-1">
                            <button aria-label="View details for @exch.Name"
                                type="button"
                                @onclick="@(() => ToggleSelected(exch.Id))"
                                class="@Cn.Merge("flex items-center justify-center rounded-full bg-background shadow-md transition-all", _selected == exch.Id ? "size-9" : tc.Size, tc.Border)">
                                @if (_selected == exch.Id)
                                {
                                    <LucideIconCn Name="radio-tower" Size="16" Class="size-4 text-muted-foreground" />
                                }
                            </button>
                            <span class="text-[9px]">@exch.Name.Split(' ')[0]</span>
                            @if (exch.Status != "online")
                            {
                                <span class="@Cn.Merge("size-1.5 rounded-full", sc.Dot)"></span>
                            }
                        </div>
                    }
                </div>
                @* Trunk legend *@
                <div class="flex items-center gap-4 mt-1">
                    <span class="flex items-center gap-1.5 text-[10px] text-muted-foreground">
                        <span class="h-0.5 w-6 bg-emerald-500 rounded"></span>
                        Low
                    </span>
                    <span class="flex items-center gap-1.5 text-[10px] text-muted-foreground">
                        <span class="h-0.5 w-6 bg-amber-500 rounded"></span>
                        Medium
                    </span>
                    <span class="flex items-center gap-1.5 text-[10px] text-muted-foreground">
                        <span class="h-0.5 w-6 bg-red-500 rounded"></span>
                        High
                    </span>
                    <span class="flex items-center gap-1.5 text-[10px] text-muted-foreground">
                        <span class="h-px w-6 border border-dashed border-zinc-400 rounded"></span>
                        Offline
                    </span>
                </div>
            </div>
        </div>

        @* Exchange list *@
        <div>
            @for (int i = 0; i < _exchanges.Length; i++)
            {
                var exch = _exchanges[i];
                var index = i;
                int bwPct = exch.BandwidthTotal > 0 ? (int)Math.Round((double)exch.BandwidthUsed / exch.BandwidthTotal * 100) : 0;
                var sc = StatusConfig(exch.Status);
                var tc = TypeConfig(exch.Type);
                bool isExpanded = _selected == exch.Id;
                bool isLast = index == _exchanges.Length - 1;
                <div class="@((isLast && !isExpanded) ? "" : "border-t")">
                    <button
                        type="button"
                        @onclick="@(() => ToggleSelected(exch.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", sc.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@exch.Name</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @tc.Label · @exch.Subscribers.ToString("N0") subscribers
                            </p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @sc.Label
                        </BadgeCn>
                        <div class="flex items-center gap-2">
                            <div class="h-1.5 w-14 overflow-hidden rounded-full bg-muted">
                                <div
                                    class="@Cn.Merge("h-full rounded-full", UtilizationBarColor(bwPct))"
                                    style="@($"width:{bwPct}%")">
                                </div>
                            </div>
                            <span class="@Cn.Merge("w-8 text-right text-xs font-medium tabular-nums", UtilizationTextColor(bwPct))">
                                @(bwPct)%
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="grid grid-cols-3 gap-3 px-4 pb-4 pl-9">
                            <div class="rounded-md bg-muted/50 p-2.5">
                                <span class="text-xs font-medium text-muted-foreground">Bandwidth</span>
                                <p class="mt-1 text-lg font-semibold tabular-nums">
                                    @exch.BandwidthUsed
                                    <span class="text-sm font-normal text-muted-foreground">
                                        /@(exch.BandwidthTotal) Gbps
                                    </span>
                                </p>
                            </div>
                            <div class="rounded-md bg-muted/50 p-2.5">
                                <span class="text-xs font-medium text-muted-foreground">Ports</span>
                                <p class="mt-1 text-lg font-semibold tabular-nums">
                                    @exch.PortsActive
                                    <span class="text-sm font-normal text-muted-foreground">
                                        /@(exch.PortsTotal) active
                                    </span>
                                </p>
                            </div>
                            <div class="rounded-md bg-muted/50 p-2.5">
                                <span class="text-xs font-medium text-muted-foreground">Uptime</span>
                                <p class="mt-1 text-lg font-semibold tabular-nums">@exch.Uptime</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _selected = null;

    private record TypeCfg(string Label, string Size, string Border);
    private record StatusCfg(string Label, string Dot, string Color);

    private record Exchange(
        string Id,
        string Name,
        string Type,
        string Status,
        int Subscribers,
        int BandwidthUsed,
        int BandwidthTotal,
        string Uptime,
        int PortsActive,
        int PortsTotal
    );

    private static readonly Exchange[] _exchanges =
    [
        new("e1", "Downtown Core",    "core",         "online",   48200, 720, 1000, "99.98%", 892, 1024),
        new("e2", "Midtown Hub",      "core",         "online",   35600, 580, 1000, "99.99%", 724, 1024),
        new("e3", "Brooklyn Gateway", "distribution", "online",   22400, 340,  500, "99.95%", 412,  512),
        new("e4", "Queens North",     "distribution", "degraded", 18900, 445,  500, "98.72%", 486,  512),
        new("e5", "Harlem Access",    "access",       "online",   12300,  85,  200, "99.91%", 198,  256),
        new("e6", "LIC Access Point", "access",       "offline",   8700,   0,  200, "0%",       0,  256),
        new("e7", "UWS Distribution", "distribution", "online",   26100, 290,  500, "99.97%", 368,  512),
    ];

    private int _totalSubscribers => _exchanges.Sum(e => e.Subscribers);
    private int _onlineCount => _exchanges.Count(e => e.Status == "online");
    private int _issueCount => _exchanges.Count(e => e.Status != "online");

    private void ToggleSelected(string id)
    {
        _selected = _selected == id ? null : id;
    }

    private static TypeCfg TypeConfig(string type) => type switch
    {
        "core"         => new TypeCfg("Core",         "size-4",   "border-2 border-blue-400"),
        "distribution" => new TypeCfg("Distribution", "size-3.5", "border-2 border-violet-400"),
        "access"       => new TypeCfg("Access",       "size-3",   "border border-muted-foreground/40"),
        _              => new TypeCfg(type,            "size-3",   "border border-muted-foreground/40"),
    };

    private static StatusCfg StatusConfig(string status) => status switch
    {
        "online"   => new StatusCfg("Online",   "bg-emerald-500", "#22c55e"),
        "degraded" => new StatusCfg("Degraded", "bg-amber-500",   "#eab308"),
        "offline"  => new StatusCfg("Offline",  "bg-red-500",     "#ef4444"),
        _          => new StatusCfg(status,     "bg-zinc-400",    "#a1a1aa"),
    };

    private static string UtilizationBarColor(int pct)
    {
        if (pct >= 85) return "bg-red-500";
        if (pct >= 60) return "bg-amber-500";
        return "bg-emerald-500";
    }

    private static string UtilizationTextColor(int pct)
    {
        if (pct >= 85) return "text-red-600 dark:text-red-400";
        if (pct >= 60) return "text-amber-600 dark:text-amber-400";
        return "text-emerald-600 dark:text-emerald-400";
    }
}
