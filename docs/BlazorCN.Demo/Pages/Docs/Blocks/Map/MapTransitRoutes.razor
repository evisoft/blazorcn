@* ============================================================
   Block: map-transit-routes
   Title: MapTransitRoutes
   Description: Public transit route map block for Next.js with bus and metro line routes in different colors, stop markers, schedule info, and line detail panel using mapcn map components and Tailwind CSS
   Source: original/blocks/map/map-transit-routes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-sm font-medium">Transit Routes</span>
                <p class="text-xs text-muted-foreground">Midtown Manhattan</p>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var line in _transitLines)
                {
                    var lineItem = line;
                    bool isActive = _selectedLine == lineItem.Id;
                    string btnClass = Cn.Merge(
                        "flex items-center gap-1.5 rounded-md px-2 py-1 text-xs transition-colors",
                        isActive ? "bg-muted font-medium" : "text-muted-foreground hover:bg-muted/50"
                    );
                    <button
                        type="button"
                        @onclick="@(() => _selectedLine = lineItem.Id)"
                        class="@btnClass">
                        <span class="size-2 rounded-full" style="@($"background-color:{lineItem.Color}")"></span>
                        @lineItem.Name
                    </button>
                }
            </div>
        </div>

        @* Map + Detail Panel *@
        <div class="flex">
            @* Map area — Map/MapRoute/MapMarker are React-only; rendered as a styled placeholder *@
            <div class="relative h-[500px] flex-1 bg-muted/30 flex items-center justify-center">
                <div class="flex flex-col items-center gap-3 text-muted-foreground">
                    <LucideIconCn Name="map" Size="48" Class="size-12 opacity-30" />
                    <div class="text-center">
                        <p class="text-sm font-medium">Interactive Transit Map</p>
                        <p class="text-xs opacity-70">Midtown Manhattan</p>
                    </div>
                    @* Route color legend *@
                    <div class="flex items-center gap-4 mt-2">
                        @foreach (var line in _transitLines)
                        {
                            var lineItem = line;
                            bool isActive = _selectedLine == lineItem.Id;
                            <div class="flex flex-col items-center gap-1">
                                <div class="flex items-center gap-1.5">
                                    <span class="rounded-full" style="@($"width:{(isActive ? 16 : 8)}px; height:{(isActive ? 4 : 2)}px; background-color:{lineItem.Color}; opacity:{(isActive ? 0.9 : 0.3)}")"></span>
                                </div>
                                @if (ActiveLine != null && lineItem.Id == ActiveLine.Id)
                                {
                                    @foreach (var stop in lineItem.Stops)
                                    {
                                        var stopItem = stop;
                                        <div class="flex size-4 items-center justify-center rounded-full border-2 border-white shadow-sm mt-1"
                                             style="@($"background-color:{lineItem.Color}")">
                                            <span class="size-1.5 rounded-full bg-white"></span>
                                        </div>
                                        <span class="text-[9px]">@stopItem.Name.Split(' ')[0]</span>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* Detail Panel *@
            @if (ActiveLine != null)
            {
                var al = ActiveLine;
                <div class="w-64 shrink-0 border-l">
                    <div class="border-b px-4 py-3">
                        <div class="flex items-center gap-2">
                            @if (al.Type == "metro")
                            {
                                <LucideIconCn Name="train-front" Size="16" Class="size-4 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideIconCn Name="bus" Size="16" Class="size-4 text-muted-foreground" />
                            }
                            <span class="text-sm font-medium">@al.Name</span>
                        </div>
                        <div class="mt-2 flex flex-wrap gap-1.5">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @(al.Type == "metro" ? "Metro" : "Bus")
                            </BadgeCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @al.Frequency
                            </BadgeCn>
                        </div>
                        <div class="mt-2 flex items-center gap-1.5 text-xs text-muted-foreground">
                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                            @al.Hours
                        </div>
                    </div>

                    @* Stops list *@
                    <div class="max-h-[380px] overflow-y-auto">
                        @foreach (var (stop, index) in al.Stops.Select((s, i) => (s, i)))
                        {
                            var stopItem = stop;
                            bool isExpanded = _expandedStop == stopItem.Id;
                            bool isLast = index == al.Stops.Length - 1;
                            string rowClass = isLast ? "" : "border-b";
                            string chevronClass = Cn.Merge(
                                "size-3.5 shrink-0 text-muted-foreground/60 transition-transform duration-200",
                                isExpanded ? "rotate-90" : ""
                            );
                            <div class="@rowClass">
                                <button
                                    type="button"
                                    @onclick="@(() => { var sid = stopItem.Id; _expandedStop = (_expandedStop == sid) ? null : sid; })"
                                    class="flex w-full items-center gap-2.5 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                                    <span
                                        class="size-1.5 shrink-0 rounded-full"
                                        style="@($"background-color:{al.Color}")">
                                    </span>
                                    <div class="min-w-0 flex-1">
                                        <span class="text-xs font-medium">@stopItem.Name</span>
                                    </div>
                                    <LucideIconCn Name="chevron-right" Size="14" Class="@chevronClass" />
                                </button>
                                @if (isExpanded)
                                {
                                    <div class="px-4 pb-3 pl-8">
                                        <span class="mb-1 block text-xs font-medium text-muted-foreground">
                                            Next arrivals
                                        </span>
                                        <div class="flex flex-wrap gap-1.5">
                                            @foreach (var arrival in stopItem.Arrivals)
                                            {
                                                <span class="rounded-md bg-muted/50 px-2 py-0.5 font-mono text-xs">
                                                    @arrival
                                                </span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _selectedLine = "metro-red";
    private string? _expandedStop = null;

    private record TransitStop(string Id, string Name, double Longitude, double Latitude, string[] Arrivals);
    private record TransitLine(string Id, string Name, string Type, string Color, string Frequency, string Hours, double[][] Coordinates, TransitStop[] Stops);

    private TransitLine? ActiveLine => System.Array.Find(_transitLines, l => l.Id == _selectedLine);

