<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-md border bg-muted/30">
                    <LucideIconCn Name="life-buoy" Size="16" Class="size-4 text-emerald-600" />
                </div>
                <div>
                    <p class="text-sm font-medium">Zendesk</p>
                    <div class="flex items-center gap-1.5 mt-0.5">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="text-[10px] text-muted-foreground">Connected 2 days ago</span>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <SwitchCn id="zendesk-toggle" Checked="true" />
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 size-7 p-0">
                    <LucideIconCn Name="settings-2" Size="14" Class="size-3.5 text-muted-foreground" />
                </ButtonCn>
            </div>
        </div>
        <div class="px-4 py-2.5 bg-muted/10">
            <p class="text-[10px] text-muted-foreground text-center">
                Syncing 42 active resources from Zendesk
            </p>
        </div>
    </div>
</section>
