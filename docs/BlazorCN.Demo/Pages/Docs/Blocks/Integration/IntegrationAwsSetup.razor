@* ============================================================
   Block: integration-aws-setup
   Title: IntegrationAwsSetup
   Description: A production-ready AWS integration block for React and Next.js, featuring the setup layout built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/integration/integration-aws-setup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <span class="text-sm font-medium">Setup AWS</span>
        </div>
        <div class="p-6">
            <div class="flex flex-col items-center text-center">
                <div class="flex size-10 items-center justify-center rounded-full border bg-muted/30">
                    <LucideIconCn Name="settings-2" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <h3 class="mt-4 text-sm font-medium">Configure API Key</h3>
                <p class="mt-1 text-xs text-muted-foreground">
                    Enter your AWS API key below to enable the integration. You can find this in your
                    AWS developer portal.
                </p>
            </div>
            <div class="mt-6 space-y-4">
                <div class="space-y-1.5">
                    <label
                        for="aws-key"
                        class="text-[10px] font-medium uppercase text-muted-foreground">
                        Secret Key
                    </label>
                    <div class="flex gap-2">
                        <input
                            id="aws-key"
                            type="password"
                            placeholder="sk_live_••••••••••••"
                            class="flex h-8 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring" />
                        <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                            Verify
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>
        <div class="flex items-center justify-end gap-2 border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                Cancel
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                Finish Setup
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>
    </div>
</section>
