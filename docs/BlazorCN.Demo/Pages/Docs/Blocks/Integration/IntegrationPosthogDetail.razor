<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-6 py-6 text-center">
            <div class="mx-auto flex size-14 items-center justify-center rounded-xl border bg-muted/30">
                <LucideIconCn Name="zap" Size="32" Class="size-8 text-orange-600" />
            </div>
            <h2 class="mt-4 text-sm font-medium">PostHog Integration</h2>
            <p class="mx-auto mt-1 max-w-xs text-sm text-muted-foreground">
                Product analytics and feature flag management.
            </p>
        </div>
        <div class="space-y-4 p-6">
            <div class="space-y-3">
                <h4 class="text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                    Permissions
                </h4>
                <div class="grid gap-2">
                    @foreach (var i in _permissionItems)
                    {
                        <div class="flex items-center gap-2.5">
                            <div class="flex size-4 items-center justify-center rounded-full bg-emerald-500/10">
                                <LucideIconCn Name="check" Size="10" Class="size-2.5 text-emerald-600" />
                            </div>
                            <span class="text-xs text-muted-foreground">
                                Access and read core posthog data
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="flex items-center justify-between border-t bg-muted/5 px-6 py-4">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs text-red-600 hover:bg-red-50 hover:text-red-700">
                Disconnect
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                Configure Settings
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _permissionItems = [1, 2, 3];
}
