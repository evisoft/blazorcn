<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="triangle" Size="16" Class="size-4 text-zinc-600" />
                <span class="text-sm font-medium">Vercel Metrics</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 text-[9px] font-medium uppercase tracking-widest text-emerald-600 border-emerald-200 bg-emerald-50 dark:bg-emerald-950/20">
                Operational
            </BadgeCn>
        </div>
        <div class="grid grid-cols-3 divide-x border-b">
            <div class="px-4 py-5 text-center">
                <p class="text-[10px] font-medium uppercase text-muted-foreground">Sync Rate</p>
                <p class="mt-1 text-xl font-semibold tabular-nums">99.9%</p>
            </div>
            <div class="px-4 py-5 text-center">
                <p class="text-[10px] font-medium uppercase text-muted-foreground">Latancy</p>
                <p class="mt-1 text-xl font-semibold tabular-nums">124ms</p>
            </div>
            <div class="px-4 py-5 text-center">
                <p class="text-[10px] font-medium uppercase text-muted-foreground">Requests</p>
                <p class="mt-1 text-xl font-semibold tabular-nums">12.4k</p>
            </div>
        </div>
        <div class="px-4 py-3 bg-muted/5 flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="alert-circle" Size="12" Class="size-3" />
                <span>Next sync in 4 minutes</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs px-2">
                View Logs
            </ButtonCn>
        </div>
    </div>
</section>
