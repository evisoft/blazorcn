@* ============================================================
   Block: logos-bento-wide-featured-top
   Title: LogosBentoWideFeaturedTop
   Description: A bento logo block with a wide featured cell spanning the top row above three supporting cells for React and Next.js with horizontal flagship layout, industry pills, metrics, and attribution built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-bento-wide-featured-top.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                One flagship story. Three supporting proofs.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Halide led the weekend migration. Three more teams followed the same path with numbers
                that speak for themselves.
            </p>
        </div>

        @* Bento grid — wide featured top + 3 supporting *@
        <div class="mt-12 grid gap-4 sm:grid-cols-3">

            @* Featured cell — spans full top row *@
            <figure class="group relative flex flex-col gap-6 overflow-hidden rounded-2xl border-2 border-foreground/15 bg-card p-6 shadow-sm sm:col-span-3 sm:flex-row sm:items-center sm:gap-10 sm:p-8">

                @* Corner accent *@
                <div aria-hidden="true" class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Flagship story
                </div>

                @* Left: flagship mark + wordmark + industry *@
                <div class="flex shrink-0 flex-col items-start gap-4 sm:w-[220px]">
                    <div class="flex size-16 items-center justify-center rounded-2xl bg-foreground text-background shadow-sm">
                        <LucideIconCn Name="shield" Size="32" Class="size-8 transition-transform group-hover:scale-110" aria-hidden="true" />
                    </div>
                    <div>
                        <p class="text-2xl font-bold tracking-tight text-foreground">@_featured.Name</p>
                        <p class="mt-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            @_featured.Industry
                        </p>
                    </div>
                </div>

                @* Right: quote + metric + attribution *@
                <div class="flex-1">
                    <blockquote class="text-base leading-relaxed text-foreground sm:text-lg">
                        &ldquo;@_featured.Quote&rdquo;
                    </blockquote>

                    <div class="mt-6 flex flex-col gap-4 border-t pt-5 sm:flex-row sm:items-end sm:justify-between">
                        <div class="flex items-baseline gap-3">
                            <p class="text-3xl font-bold tracking-tight tabular-nums text-foreground">
                                @_featured.Metric
                            </p>
                            <p class="text-sm text-muted-foreground">@_featured.MetricLabel</p>
                        </div>

                        <figcaption class="flex items-center gap-3">
                            <div aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full border bg-muted font-mono text-xs font-semibold text-muted-foreground">
                                @_featured.AuthorInitials
                            </div>
                            <div class="min-w-0">
                                <p class="truncate text-sm font-semibold text-foreground">
                                    @_featured.AuthorName
                                </p>
                                <p class="truncate text-xs text-muted-foreground">@_featured.AuthorRole</p>
                            </div>
                        </figcaption>
                    </div>
                </div>
            </figure>

            @* Supporting cells — 3 content-rich cells in the bottom row *@
            @foreach (var logo in _supporting)
            {
                <div class="group flex flex-col justify-between gap-5 rounded-2xl border bg-card p-6 transition-colors hover:border-foreground/20">

                    @* Top cluster: icon + industry pill *@
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex size-11 items-center justify-center rounded-xl border bg-muted/40 text-muted-foreground transition-colors group-hover:border-foreground/20 group-hover:text-foreground">
                            <LucideIconCn Name="@logo.IconName" Size="20" Class="size-5 transition-transform group-hover:scale-110" aria-hidden="true" />
                        </div>
                        <span class="rounded-full border bg-muted/50 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                            @logo.Industry
                        </span>
                    </div>

                    @* Bottom cluster: wordmark + metric *@
                    <div>
                        <p class="text-base font-semibold text-foreground">@logo.Name</p>
                        <p class="mt-1 text-xs tabular-nums text-muted-foreground">@logo.Metric</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FeaturedLogo(
        string Name,
        string IconName,
        string Industry,
        string Quote,
        string Metric,
        string MetricLabel,
        string AuthorName,
        string AuthorRole,
        string AuthorInitials
    );

    private record SupportingLogo(string Id, string Name, string IconName, string Industry, string Metric);

    private static readonly FeaturedLogo _featured = new(
        Name: "Halide",
        IconName: "shield",
        Industry: "Fintech",
        Quote: "We cut our p99 latency from 900ms to 80ms in a weekend migration, deprecated three internal services, and gave our on-call team their weekends back.",
        Metric: "91%",
        MetricLabel: "latency reduction",
        AuthorName: "Sarah Chen",
        AuthorRole: "Staff Engineer · Halide",
        AuthorInitials: "SC"
    );

    private static readonly SupportingLogo[] _supporting =
    [
        new("s1", "Northwind", "compass", "Logistics", "12× throughput"),
        new("s2", "Ion",       "atom",    "Dev Tools", "99.99% uptime"),
        new("s3", "LaunchPad", "rocket",  "Deploy",    "3.2M deploys"),
    ];
}
