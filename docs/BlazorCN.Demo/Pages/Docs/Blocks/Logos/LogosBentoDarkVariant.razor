@* ============================================================
   Block: logos-bento-dark-variant
   Title: LogosBentoDarkVariant
   Description: A dark inverted bento featured case study logo block for React and Next.js with a rounded dark panel containing a tall featured cell plus four content-rich supporting cells, inverted palette throughout, and monochrome icon marks with industry pills built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-bento-dark-variant.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl bg-foreground px-6 py-14 sm:px-10 sm:py-20">
        @* Marketing headline cluster — inverted *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-background/60">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-background sm:text-4xl lg:text-5xl">
                One weekend. Ninety-one percent faster.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-background/70">
                Bastion cut latency by an order of magnitude in a single weekend migration — and four
                more teams are on the same path.
            </p>
        </div>

        @* Bento grid: 3 cols × 2 rows, featured spans rows 1-2 on the left *@
        <div class="mt-12 grid gap-4 sm:grid-cols-3 sm:grid-rows-2">
            @* Featured cell *@
            <figure class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-background/25 bg-background/[0.05] p-8 sm:col-span-1 sm:row-span-2">
                @* Corner accent *@
                <div aria-hidden="true"
                     class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full border border-background/20 bg-background/10 px-2.5 py-1 text-[11px] font-medium text-background/80">
                    <span class="size-1.5 rounded-full bg-emerald-400"></span>
                    Case study
                </div>

                @* Top: logo + name + industry *@
                <div>
                    <div class="flex size-14 items-center justify-center rounded-2xl bg-background text-foreground shadow-sm">
                        <LucideIconCn Name="shield" Size="28" Class="size-7" aria-hidden="true" />
                    </div>
                    <p class="mt-5 text-2xl font-bold tracking-tight text-background">
                        @_featured.Name
                    </p>
                    <p class="mt-1 text-xs font-medium uppercase tracking-wider text-background/60">
                        @_featured.Industry
                    </p>
                </div>

                @* Quote *@
                <blockquote class="mt-6 text-base leading-relaxed text-background">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>

                @* Metric highlight *@
                <div class="mt-6 flex items-baseline gap-3 border-t border-background/15 pt-5">
                    <p class="text-4xl font-bold tracking-tight tabular-nums text-background">
                        @_featured.Metric
                    </p>
                    <p class="text-sm text-background/70">@_featured.MetricLabel</p>
                </div>

                @* Attribution *@
                <div class="mt-5 flex items-end justify-between gap-3 border-t border-background/15 pt-5">
                    <figcaption class="flex min-w-0 items-center gap-3">
                        <div aria-hidden="true"
                             class="flex size-10 shrink-0 items-center justify-center rounded-full border border-background/20 bg-background/10 font-mono text-xs font-semibold text-background">
                            @_featured.AuthorInitials
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-background">
                                @_featured.AuthorName
                            </p>
                            <p class="truncate text-xs text-background/60">@_featured.AuthorRole</p>
                        </div>
                    </figcaption>
                    <span aria-hidden="true"
                          class="inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-background opacity-60 transition-opacity group-hover:opacity-100">
                        Read
                        <LucideIconCn Name="arrow-up-right" Size="14" Class="size-3.5" />
                    </span>
                </div>
            </figure>

            @* Supporting cells *@
            @foreach (var logo in _supporting)
            {
                <div class="group flex flex-col justify-between gap-5 rounded-2xl border border-background/15 bg-background/[0.05] p-6 transition-colors hover:border-background/30 hover:bg-background/[0.08]">
                    @* Top: icon + industry pill *@
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex size-11 items-center justify-center rounded-xl border border-background/15 bg-background/10 text-background/80 transition-colors group-hover:text-background">
                            <LucideIconCn Name="@logo.IconName" Size="20" Class="size-5" aria-hidden="true" />
                        </div>
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-background/15 bg-background/10 px-2.5 py-1 text-[11px] font-medium text-background/80">
                            <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-400/80"></span>
                            @logo.Industry
                        </span>
                    </div>

                    @* Bottom: wordmark + metric *@
                    <div>
                        <p class="text-base font-semibold text-background">@logo.Name</p>
                        <p class="mt-1.5 text-xs tabular-nums text-background/60">@logo.Metric</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FeaturedLogo(string Name, string IconName, string Industry, string Quote, string Metric, string MetricLabel, string AuthorName, string AuthorRole, string AuthorInitials);
    private record SupportingLogo(string Id, string Name, string IconName, string Industry, string Metric);

    private static readonly FeaturedLogo _featured = new(
        Name: "Bastion",
        IconName: "shield",
        Industry: "Fintech",
        Quote: "We cut our p99 latency from 900ms to 80ms in a weekend migration. The rollback plan was never needed.",
        Metric: "91%",
        MetricLabel: "latency reduction",
        AuthorName: "Priya Raman",
        AuthorRole: "Platform Lead · Bastion",
        AuthorInitials: "PR"
    );

    private static readonly SupportingLogo[] _supporting =
    [
        new("s1", "Meridian", "compass", "Logistics", "12× throughput"),
        new("s2", "Nucleo",   "atom",    "Dev Tools",  "99.99% uptime"),
        new("s3", "Evergreen","tree-pine","Climate",   "40+ regions"),
        new("s4", "Apogee",   "rocket",  "Deploy",     "3.2M deploys"),
    ];
}
