@* ============================================================
   Block: logos-single-row-marquee
   Title: LogosSingleRowMarquee
   Description: A single row infinite marquee logo wall for React and Next.js with gradient edge masks, reduced-motion media query handling, monochrome-to-color hover states, and a calm 45 second loop duration built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-single-row-marquee.tsx
   ============================================================ *@

<style>
    @@keyframes logos-single-row-marquee-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    @@media (prefers-reduced-motion: reduce) {
        [data-logos-single-row-marquee] {
            animation: none !important;
            transform: none !important;
        }
    }
</style>

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-muted-foreground">
                <span aria-hidden="true" class="size-1 rounded-full bg-emerald-500"></span>
                Trusted worldwide
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Teams at 12,000+ companies ship with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From two-person startups to public companies across 60 countries, engineering teams
                trust our platform in production every day.
            </p>
        </div>

        @* Single marquee row *@
        <div aria-hidden="true" class="relative mt-12 overflow-hidden py-4">
            @* Gradient edge masks *@
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent sm:w-40"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40"></div>

            <div class="flex">
                <div data-logos-single-row-marquee="true"
                     class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                     style="animation-name: logos-single-row-marquee-left; animation-duration: 45s; animation-timing-function: linear; animation-iteration-count: infinite;">
                    @foreach (var logo in _doubled)
                    {
                        <div class="flex items-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                            <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                            <span class="text-sm font-semibold whitespace-nowrap">@logo.Name</span>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",     "shield"),
        new("l2",  "Northwind",  "compass"),
        new("l3",  "Ion",        "atom"),
        new("l4",  "Rookery",    "feather"),
        new("l5",  "LaunchPad",  "rocket"),
        new("l6",  "Lumen",      "star"),
        new("l7",  "Loam",       "tree-pine"),
        new("l8",  "Strata",     "layers"),
        new("l9",  "Telemark",   "mountain"),
        new("l10", "Bastion",    "key"),
        new("l11", "Honeycomb",  "hexagon"),
        new("l12", "Ember",      "flame"),
    ];

    private static readonly Logo[] _doubled = [.. _logos, .. _logos];
}
