@* ============================================================
   Block: logos-triple-row-marquee
   Title: LogosTripleRowMarquee
   Description: A triple row infinite marquee logo wall for React and Next.js with three alternating-direction rows, tiered per-row speeds, gradient edge masks, and reduced-motion handling built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-triple-row-marquee.tsx
   ============================================================ *@

<style>
    @@keyframes logos-triple-row-1-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    @@keyframes logos-triple-row-2-right {
        from { transform: translateX(-50%); }
        to { transform: translateX(0); }
    }
    @@keyframes logos-triple-row-3-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    @@media (prefers-reduced-motion: reduce) {
        [data-logos-triple-row="row-one"],
        [data-logos-triple-row="row-two"],
        [data-logos-triple-row="row-three"] {
            animation: none !important;
            transform: none !important;
        }
    }
</style>

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted worldwide
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Loved by engineering teams at every scale.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From two-person startups to public companies, thirty-six thousand teams across sixty
                countries ship to production with us every day.
            </p>
        </div>

        @* Triple marquee rows *@
        <div aria-hidden="true" class="relative mt-12 overflow-hidden py-4">
            @* Gradient edge masks *@
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent sm:w-40"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40"></div>

            <div class="space-y-8">

                @* Row One — scrolls left, 40s *@
                <div class="flex">
                    <div data-logos-triple-row="row-one"
                         class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                         style="animation-name: logos-triple-row-1-left; animation-duration: 40s; animation-timing-function: linear; animation-iteration-count: infinite;">
                        @foreach (var logo in _rowOneDoubled)
                        {
                            <div class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                                <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                            </div>
                        }
                    </div>
                </div>

                @* Row Two — scrolls right, 50s *@
                <div class="flex">
                    <div data-logos-triple-row="row-two"
                         class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                         style="animation-name: logos-triple-row-2-right; animation-duration: 50s; animation-timing-function: linear; animation-iteration-count: infinite;">
                        @foreach (var logo in _rowTwoDoubled)
                        {
                            <div class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                                <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                            </div>
                        }
                    </div>
                </div>

                @* Row Three — scrolls left, 60s *@
                <div class="flex">
                    <div data-logos-triple-row="row-three"
                         class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                         style="animation-name: logos-triple-row-3-left; animation-duration: 60s; animation-timing-function: linear; animation-iteration-count: infinite;">
                        @foreach (var logo in _rowThreeDoubled)
                        {
                            <div class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                                <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>

