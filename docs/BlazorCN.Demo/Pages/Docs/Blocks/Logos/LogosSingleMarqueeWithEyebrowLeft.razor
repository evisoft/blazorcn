@* ============================================================
   Block: logos-single-marquee-with-eyebrow-left
   Title: LogosSingleMarqueeWithEyebrowLeft
   Description: A horizontal split layout with a left-aligned trust eyebrow and a single row marquee filling the remaining width for React and Next.js with right-side gradient edge mask and reduced-motion guards built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-single-marquee-with-eyebrow-left.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <style>
        @@keyframes logos-eyebrow-side-marquee-left {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }
        @@media (prefers-reduced-motion: reduce) {
            [data-logos-eyebrow-marquee="true"] {
                animation: none !important;
                transform: none !important;
            }
        }
    </style>

    <div class="py-12 sm:py-16">
        <div class="grid items-center gap-8 lg:grid-cols-[auto_1fr]">
            @* Eyebrow on the left (stacks above on mobile) *@
            <div class="lg:border-r lg:border-dashed lg:border-border/60 lg:pr-8">
                <p class="text-[11px] font-semibold uppercase tracking-widest text-muted-foreground">
                    Trusted worldwide
                </p>
                <p class="mt-2 text-sm font-semibold tabular-nums text-foreground lg:whitespace-nowrap">
                    12,000+ teams ship with us
                </p>
            </div>

            @* Marquee fills the remaining column *@
            <div aria-hidden="true" class="relative min-w-0 overflow-hidden py-2">
                @* Gradient edge masks — left fades into eyebrow background, right fades into row end *@
                <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-background to-transparent sm:w-24"></div>
                <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40"></div>

                <div class="flex">
                    <div
                        data-logos-eyebrow-marquee="true"
                        class="flex w-max shrink-0 items-center gap-10 sm:gap-14"
                        style="animation: logos-eyebrow-side-marquee-left 40s linear infinite;">
                        @foreach (var logo in _doubled)
                        {
                            <div class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                                <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Citadel", "shield"),
        new("l2",  "Bearing", "compass"),
        new("l3",  "Helios",  "atom"),
        new("l4",  "Boost",   "rocket"),
        new("l5",  "Stellar", "star"),
        new("l6",  "Canopy",  "tree-pine"),
        new("l7",  "Tier",    "layers"),
        new("l8",  "Summit",  "mountain"),
        new("l9",  "Apiary",  "hexagon"),
        new("l10", "Hearth",  "flame"),
    ];

    private static readonly Logo[] _doubled = [.._logos, .._logos];
}
