@* ============================================================
   Block: logos-single-marquee-icon-only
   Title: LogosSingleMarqueeIconOnly
   Description: A single row icon-only marquee logo wall for React and Next.js with bordered square icon containers, aria-labeled brand names, gradient edge masks, and a prefers-reduced-motion CSS guard built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-single-marquee-icon-only.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <style>
        @@keyframes logos-single-icon-only-left {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }
        @@media (prefers-reduced-motion: reduce) {
            [data-logos-single-icon-only="true"] {
                animation: none !important;
                transform: none !important;
            }
        }
    </style>

    <div class="py-12 sm:py-16">
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                In good company
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The marks of teams who ship.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A single row of twelve customer marks on a continuous loop — no wordmarks, just the
                tactile rhythm of recognizable icons.
            </p>
        </div>

        @* Icon-only marquee row *@
        <div class="relative mt-12 overflow-hidden py-4">
            @* Gradient edge masks *@
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent sm:w-40"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40"></div>

            <div aria-hidden="true" class="flex">
                <div
                    data-logos-single-icon-only="true"
                    class="flex w-max shrink-0 items-center gap-6 sm:gap-8"
                    style="animation: logos-single-icon-only-left 40s linear infinite;">
                    @foreach (var logo in _doubled)
                    {
                        <div
                            role="img"
                            aria-label="@logo.Name"
                            class="group flex size-12 shrink-0 items-center justify-center rounded-xl border bg-card text-muted-foreground transition-colors duration-200 hover:border-foreground/20 hover:text-foreground">
                            <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 transition-transform duration-200 group-hover:scale-110" aria-hidden="true" />
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",    "shield"),
        new("l2",  "Northwind", "compass"),
        new("l3",  "Ion",       "atom"),
        new("l4",  "Rookery",   "feather"),
        new("l5",  "LaunchPad", "rocket"),
        new("l6",  "Lumen",     "star"),
        new("l7",  "Strata",    "layers"),
        new("l8",  "Honeycomb", "hexagon"),
        new("l9",  "Bastion",   "key"),
        new("l10", "Telemark",  "mountain"),
        new("l11", "Ember",     "flame"),
        new("l12", "Facet",     "gem"),
    ];

    private static readonly Logo[] _doubled = [.._logos, .._logos];
}
