@* ============================================================
   Block: logos-split-headline-bordered-logo-grid
   Title: LogosSplitHeadlineBorderedLogoGrid
   Description: A split layout logo block for React and Next.js with a left-aligned hero-scale headline paired with a right-side six-cell dashed-bordered logo grid, ShadcnioButton CTA pair, and split directional entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-split-headline-bordered-logo-grid.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="grid items-center gap-12 py-12 sm:py-16 lg:grid-cols-[5fr_6fr] lg:gap-16">

        @* Left — headline cluster with CTA pair *@
        <div>
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Framed by customers
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight leading-[1.1] sm:text-4xl lg:text-5xl">
                Every team
                <br class="hidden sm:block" /> picks us on purpose.
            </h2>
            <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Six teams who chose us after long evaluation cycles — each one framed here as a reminder
                that every logo represents a considered decision.
            </p>

            <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                <ButtonCn Class="w-full sm:w-[240px]">Read case studies</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[170px]">
                    Learn more
                </ButtonCn>
            </div>
        </div>

        @* Right — dashed bordered logo grid *@
        <ul aria-label="Customer logos" class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5">
            @foreach (var logo in _logos)
            {
                <li class="group flex h-28 items-center justify-center gap-3 rounded-2xl border-2 border-dashed border-border/60 bg-card text-muted-foreground transition-all duration-200 hover:border-foreground/20 hover:bg-card/80 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="32" Class="size-8 shrink-0 transition-colors duration-200 group-hover:text-foreground" aria-hidden="true" />
                    <span class="text-base font-semibold whitespace-nowrap transition-colors duration-200 group-hover:text-foreground">
                        @logo.Name
                    </span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "LaunchPad", "rocket"),
        new("l5", "Lumen",     "star"),
        new("l6", "Strata",    "layers"),
    ];
}
