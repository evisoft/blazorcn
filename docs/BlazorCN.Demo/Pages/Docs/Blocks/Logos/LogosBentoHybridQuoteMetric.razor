@* ============================================================
   Block: logos-bento-hybrid-quote-metric
   Title: LogosBentoHybridQuoteMetric
   Description: A bento logo block with a featured case study cell plus four supporting cells alternating between quote and metric types for React and Next.js with mixed-shape proof, industry pills, and attribution rows built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-bento-hybrid-quote-metric.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer proof
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                One flagship. Four kinds of proof.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Halide leads. Two supporting teams bring voice, two bring numbers. Different shapes of
                proof, one compound story.
            </p>
        </div>

        @* Bento grid — 3 cols × 2 rows, featured spans rows 1-2 on the left *@
        <div class="mt-12 grid gap-4 sm:grid-cols-3 sm:grid-rows-2">
            @* Featured cell *@
            <figure class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border-2 border-foreground/15 bg-card p-8 shadow-sm sm:col-span-1 sm:row-span-2">
                @* Corner accent *@
                <div aria-hidden="true" class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Flagship
                </div>

                @* Top *@
                <div>
                    <div class="flex size-14 items-center justify-center rounded-2xl bg-foreground text-background shadow-sm">
                        <LucideIconCn Name="shield" Size="28" Class="size-7" aria-hidden="true" />
                    </div>
                    <p class="mt-5 text-2xl font-bold tracking-tight text-foreground">
                        @_featured.Name
                    </p>
                    <p class="mt-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @_featured.Industry
                    </p>
                </div>

                @* Quote *@
                <blockquote class="mt-6 text-base leading-relaxed text-foreground">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>

                @* Metric *@
                <div class="mt-6 flex items-baseline gap-3 border-t pt-5">
                    <p class="text-4xl font-bold tracking-tight tabular-nums text-foreground">
                        @_featured.Metric
                    </p>
                    <p class="text-sm text-muted-foreground">@_featured.MetricLabel</p>
                </div>

                @* Attribution *@
                <figcaption class="mt-5 flex items-center gap-3 border-t pt-5">
                    <div aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full border bg-muted font-mono text-xs font-semibold text-muted-foreground">
                        @_featured.AuthorInitials
                    </div>
                    <div class="min-w-0">
                        <p class="truncate text-sm font-semibold text-foreground">
                            @_featured.AuthorName
                        </p>
                        <p class="truncate text-xs text-muted-foreground">@_featured.AuthorRole</p>
                    </div>
                </figcaption>
            </figure>

            @* Supporting cells — alternating quote and metric in 2×2 *@
            @foreach (var cell in _supporting)
            {
                var isQuote = cell.Type == "quote";
                <div class="@(isQuote ? "group flex flex-col justify-between gap-5 rounded-2xl border bg-muted/30 p-6 transition-colors hover:border-foreground/20 hover:bg-muted/40" : "group flex flex-col justify-between gap-5 rounded-2xl border bg-card p-6 transition-colors hover:border-foreground/20 hover:shadow-sm")">
                    @* Top cluster: icon + industry pill *@
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex size-11 items-center justify-center rounded-xl border bg-background text-muted-foreground transition-colors group-hover:text-foreground">
                            <LucideIconCn Name="@cell.IconName" Size="20" Class="size-5" aria-hidden="true" />
                        </div>
                        <span class="inline-flex items-center gap-1.5 rounded-full border bg-background px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                            <span aria-hidden="true" class="@(isQuote ? "size-1.5 rounded-full bg-foreground/40" : "size-1.5 rounded-full bg-emerald-500")"></span>
                            @cell.Industry
                        </span>
                    </div>

                    @* Bottom cluster: varies by type *@
                    @if (isQuote)
                    {
                        <figure>
                            <blockquote class="text-sm leading-relaxed text-foreground">
                                &ldquo;@cell.Quote&rdquo;
                            </blockquote>
                            <figcaption class="mt-4 flex items-center gap-2">
                                <span class="text-sm font-semibold text-foreground">@cell.Name</span>
                                <span aria-hidden="true" class="text-muted-foreground/60">·</span>
                                <span class="text-xs text-muted-foreground">@cell.AuthorName</span>
                            </figcaption>
                        </figure>
                    }
                    else
                    {
                        <div>
                            <p class="text-3xl font-bold leading-none tracking-tight tabular-nums text-foreground">
                                @cell.Metric
                            </p>
                            <p class="mt-1.5 text-xs text-muted-foreground">@cell.MetricLabel</p>
                            <div aria-hidden="true" class="mt-4 h-px w-8 bg-border"></div>
                            <p class="mt-4 text-sm font-semibold text-foreground">@cell.Name</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FeaturedCell(
        string Name,
        string Industry,
        string Quote,
        string Metric,
        string MetricLabel,
        string AuthorName,
        string AuthorRole,
        string AuthorInitials
    );

    private record SupportingCell(
        string Id,
        string Type,
        string Name,
        string IconName,
        string Industry,
        string Quote,
        string? AuthorName,
        string? AuthorInitials,
        string Metric,
        string MetricLabel
    );

    private static readonly FeaturedCell _featured = new(
        Name: "Halide",
        Industry: "Fintech",
        Quote: "We cut our p99 latency from 900ms to 80ms in a weekend migration. The rollback plan was never needed.",
        Metric: "91%",
        MetricLabel: "latency reduction",
        AuthorName: "Sarah Chen",
        AuthorRole: "Staff Engineer · Halide",
        AuthorInitials: "SC"
    );

    private static readonly SupportingCell[] _supporting =
    [
        new("s1", "quote", "Northwind", "compass", "Logistics",
            "Our pager rang twice last quarter. Before: twice a day.",
            "Marcus Okonkwo", "MO", "", ""),
        new("s2", "metric", "Ion", "atom", "Dev Tools",
            "", null, null, "99.99%", "uptime year over year"),
        new("s3", "metric", "Loam", "tree-pine", "Climate",
            "", null, null, "40+", "regions in production"),
        new("s4", "quote", "LaunchPad", "rocket", "Deploy",
            "We stopped writing YAML. I didn't know that was allowed.",
            "Tomás Alvarado", "TA", "", ""),
    ];
}
