@* ============================================================
   Block: logos-single-marquee-with-pipe-dividers
   Title: LogosSingleMarqueeWithPipeDividers
   Description: A single row marquee logo wall with thin vertical pipe dividers between each mark for React and Next.js with gradient edge masks, reduced-motion guards, and a calm forty-five second loop built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-single-marquee-with-pipe-dividers.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <style>
        @@keyframes logos-single-pipe-left {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }
        @@media (prefers-reduced-motion: reduce) {
            [data-logos-single-pipe="true"] {
                animation: none !important;
                transform: none !important;
            }
        }
    </style>

    <div class="py-12 sm:py-16">
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Built for production
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Shipping in production for 12,000+ teams.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From two-person startups to public companies across sixty countries, engineering teams
                trust our platform for mission-critical workloads every day.
            </p>
            <div class="mt-6 flex items-center justify-center">
                <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/30 px-2.5 py-0.5 text-[11px] font-medium text-muted-foreground">
                    <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="tabular-nums">12,000+</span> teams in production
                </span>
            </div>
        </div>

        @* Single marquee row with pipe dividers *@
        <div aria-hidden="true" class="relative mt-12 overflow-hidden py-4">
            @* Gradient edge masks *@
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent sm:w-40"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40"></div>

            <div class="flex">
                <div
                    data-logos-single-pipe="true"
                    class="flex w-max shrink-0 items-center gap-10 sm:gap-14"
                    style="animation: logos-single-pipe-left 55s linear infinite;">
                    @foreach (var logo in _doubled)
                    {
                        var isLast = logo.Index == _doubled.Length - 1;
                        <div class="flex items-center gap-10 sm:gap-14">
                            <div class="flex items-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                                <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                            </div>
                            @if (!isLast)
                            {
                                <span aria-hidden="true" class="block h-4 w-px shrink-0 bg-border"></span>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Logo(int Index, string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new(0,  "l1",  "Bastion",    "shield"),
        new(1,  "l2",  "Meridian",   "compass"),
        new(2,  "l3",  "Quanta",     "atom"),
        new(3,  "l4",  "Apogee",     "rocket"),
        new(4,  "l5",  "Polaris",    "star"),
        new(5,  "l6",  "Heartwood",  "layers"),
        new(6,  "l7",  "Cairn",      "mountain"),
        new(7,  "l8",  "Latchkey",   "key"),
        new(8,  "l9",  "Tessellate", "hexagon"),
        new(9,  "l10", "Tinder",     "flame"),
        new(10, "l11", "Aquifer",    "droplets"),
        new(11, "l12", "Facet",      "gem"),
    ];

    private static readonly Logo[] _doubled = BuildDoubled();

    private static Logo[] BuildDoubled()
    {
        var result = new Logo[_logos.Length * 2];
        for (int i = 0; i < _logos.Length; i++)
        {
            var l = _logos[i];
            result[i] = new(i, l.Id, l.Name, l.IconName);
            result[i + _logos.Length] = new(i + _logos.Length, l.Id + "-b", l.Name, l.IconName);
        }
        return result;
    }
}
