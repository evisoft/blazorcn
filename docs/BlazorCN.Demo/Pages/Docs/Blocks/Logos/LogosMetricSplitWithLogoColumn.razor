@* ============================================================
   Block: logos-metric-split-with-logo-column
   Title: LogosMetricSplitWithLogoColumn
   Description: A metric split logo column for React and Next.js with an oversized left-side metric, a right-side vertical logo column separated by dashed dividers, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-metric-split-with-logo-column.tsx
   ============================================================ *@

<section aria-label="Customer logos and scale metric" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">
        <div class="grid items-center gap-12 lg:grid-cols-[5fr_4fr] lg:gap-16">

            @* Left — metric block *@
            <div>
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    By the numbers
                </p>
                <p class="mt-4 text-5xl font-bold tracking-tight tabular-nums leading-[1.1] text-foreground sm:text-6xl lg:text-7xl">
                    @MetricValue<span class="text-foreground/60">@MetricSuffix</span>
                </p>
                <p class="mt-5 max-w-md text-base leading-relaxed text-muted-foreground sm:text-lg">
                    @MetricSubtitle
                </p>

                @* Tenure micro-line *@
                <p class="mt-4 inline-flex items-center gap-2 text-xs text-muted-foreground">
                    <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="tabular-nums">Since 2019 · 60 countries</span>
                </p>

                @* CTA pair *@
                <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row">
                    <ButtonCn Class="w-full sm:w-[240px]">Read case studies</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">Book a demo</ButtonCn>
                </div>
            </div>

            @* Right — vertical logo column *@
            <ul aria-label="Customer logos" class="flex flex-col">
                @foreach (var logo in _columnLogos)
                {
                    var isLast = logo.Id == _columnLogos[_columnLogos.Length - 1].Id;
                    <li class="@(isLast
                        ? "group -mx-2 flex items-center gap-3 rounded-md px-2 py-4 text-muted-foreground transition-colors hover:bg-muted/20 hover:text-foreground"
                        : "group -mx-2 flex items-center gap-3 rounded-md border-b border-dashed border-border/40 px-2 py-4 text-muted-foreground transition-colors hover:bg-muted/20 hover:text-foreground")">
                        <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0 transition-transform duration-200 group-hover:scale-110" aria-hidden="true" />
                        <span class="text-sm font-semibold">@logo.Name</span>
                        <span aria-hidden="true" class="ml-auto text-xs text-muted-foreground/0 transition-colors group-hover:text-muted-foreground">
                            →
                        </span>
                    </li>
                }
            </ul>

        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private const string MetricValue = "12,000";
    private const string MetricSuffix = "+";
    private const string MetricSubtitle =
        "engineering teams across sixty countries depend on our platform to ship every single day.";

    private static readonly Logo[] _columnLogos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "LaunchPad", "rocket"),
        new("l5", "Loam",      "tree-pine"),
        new("l6", "Bastion",   "key"),
    ];
}
