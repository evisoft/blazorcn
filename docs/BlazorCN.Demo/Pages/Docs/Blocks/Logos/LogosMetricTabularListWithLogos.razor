@* ============================================================
   Block: logos-metric-tabular-list-with-logos
   Title: LogosMetricTabularListWithLogos
   Description: A tabular metric list paired with a vertical logo column for React and Next.js with a four-row metric table, a column of five bordered logo cells, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-metric-tabular-list-with-logos.tsx
   ============================================================ *@

<section aria-label="Customer logos and scale metrics" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                By the numbers
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The receipts, in plain language.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Four numbers that separate claim from proof — and five of the teams holding us to every
                one of them.
            </p>
        </div>

        @* Split — table left, logo column right *@
        <div class="mt-12 grid items-start gap-12 lg:grid-cols-[3fr_2fr]">

            @* Metric tabular list *@
            <dl>
                @foreach (var metric in _metrics)
                {
                    <div class="flex items-baseline justify-between border-b border-dashed border-border/40 py-4 last:border-0">
                        <dt class="text-2xl font-bold tracking-tight tabular-nums leading-none text-foreground">
                            @metric.Value
                        </dt>
                        <dd class="text-sm text-muted-foreground">@metric.Label</dd>
                    </div>
                }
            </dl>

            @* Vertical logo cells *@
            <ul aria-label="Customer logos" class="flex flex-col gap-3">
                @foreach (var logo in _logos)
                {
                    <li class="group flex h-16 items-center justify-center gap-3 rounded-xl border bg-card text-muted-foreground transition-colors duration-200 hover:border-foreground/20 hover:text-foreground">
                        <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0 transition-transform duration-200 group-hover:scale-110" aria-hidden="true" />
                        <span class="text-sm font-semibold">@logo.Name</span>
                    </li>
                }
            </ul>

        </div>

        @* CTA pair *@
        <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[240px]">Read case studies</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">
                Contact sales
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Metric(string Id, string Value, string Label);
    private record Logo(string Id, string Name, string IconName);

    private static readonly Metric[] _metrics =
    [
        new("teams",     "12,000+", "engineering teams"),
        new("countries", "60",      "countries served"),
        new("rating",    "4.9/5",   "product rating"),
        new("uptime",    "99.99%",  "platform uptime"),
    ];

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "LaunchPad", "rocket"),
        new("l5", "Bastion",   "key"),
    ];
}
