@* ============================================================
   Block: logos-featured-with-animated-counter
   Title: LogosFeaturedWithAnimatedCounter
   Description: An animated count up metric hero logo block for React and Next.js with a hydration-safe zero-to-target interval animation, tabular-nums hero display, supporting logo strip, and reduced motion respect built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-featured-with-animated-counter.tsx
   ============================================================ *@

@implements IAsyncDisposable

<section aria-label="Customer logos and scale metrics" class="mx-auto w-full max-w-4xl p-4">
    <div class="py-12 sm:py-16">

        @* Headline cluster with animated hero metric *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Teams shipping every day
            </p>

            <p aria-live="polite"
               aria-atomic="true"
               class="mt-4 text-5xl font-bold tracking-tight tabular-nums leading-[1.05] text-foreground sm:text-6xl lg:text-7xl">
                @_count.ToString("N0")<span class="text-foreground/60">+</span>
            </p>

            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
                Engineering teams count on us to keep shipping, from two-person startups to
                thousand-person platform orgs.
            </p>

            <div class="mt-5 inline-flex items-center gap-2 rounded-full border bg-muted/30 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="tabular-nums">Live · Updated daily</span>
            </div>
        </div>

        @* Logo strip *@
        <ul aria-label="Customer logos"
            class="mt-12 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
            @foreach (var logo in _logos)
            {
                <li class="group flex items-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0 transition-transform duration-200 group-hover:scale-110" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private const int MetricTarget = 12000;
    private const int AnimationFrames = 60;

    private static readonly Logo[] _allLogos =
    [
        new("l1", "Halide",     "shield"),
        new("l2", "Northwind",  "compass"),
        new("l3", "Ion",        "atom"),
        new("l4", "Rookery",    "feather"),
        new("l5", "LaunchPad",  "rocket"),
        new("l6", "Loam",       "tree-pine"),
        new("l7", "Strata",     "layers"),
        new("l8", "Honeycomb",  "hexagon"),
        new("l9", "Bastion",    "key"),
    ];

    // Show first 8 logos (matching TSX: LOGOS.slice(0, 8))
    private static readonly Logo[] _logos = _allLogos[..8];

    private int _count = 0;
    private int _frame = 0;
    private System.Threading.Timer? _timer;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;

        var frameIntervalMs = 1200 / AnimationFrames; // 20 ms per frame

        _timer = new System.Threading.Timer(_ =>
        {
            _frame += 1;
            if (_frame >= AnimationFrames)
            {
                _count = MetricTarget;
                _timer?.Change(System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
            }
            else
            {
                _count = (int)((MetricTarget / (double)AnimationFrames) * _frame);
            }
            InvokeAsync(StateHasChanged);
        }, null, frameIntervalMs, frameIntervalMs);
    }

    public async ValueTask DisposeAsync()
    {
        if (_timer is not null)
        {
            await _timer.DisposeAsync();
        }
    }
}
