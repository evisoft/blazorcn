@* ============================================================
   Block: logos-split-logo-left-headline-right
   Title: LogosSplitLogoLeftHeadlineRight
   Description: A reversed split layout logo block for React and Next.js with a left-side six-cell bordered logo grid paired with a right-aligned hero-scale headline and ShadcnioButton CTA pair, split directional entrance animation, and monochrome-to-color hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-split-logo-left-headline-right.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="grid items-center gap-12 py-12 sm:py-16 lg:grid-cols-[6fr_5fr] lg:gap-16">

        @* Left — logo grid *@
        <ul aria-label="Customer logos" class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6">
            @foreach (var logo in _logos)
            {
                <li class="group flex h-24 items-center justify-center gap-2.5 rounded-xl border bg-card text-muted-foreground transition-colors duration-200 hover:border-foreground/20 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="32" Class="size-8 shrink-0 transition-colors duration-200 group-hover:text-foreground" aria-hidden="true" />
                    <span class="whitespace-nowrap text-base font-semibold transition-colors duration-200 group-hover:text-foreground">
                        @logo.Name
                    </span>
                </li>
            }
        </ul>

        @* Right — headline cluster with CTA pair *@
        <div>
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight leading-[1.1] sm:text-4xl lg:text-5xl">
                Proof before
                <br class="hidden sm:block" /> the pitch.
            </h2>
            <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Six flagship engineering teams ship with our platform in production — read how they cut
                deploy time, consolidated infrastructure, and rebuilt their on-call rotation.
            </p>

            <div class="mt-5">
                <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/30 px-2.5 py-0.5 text-[11px] font-medium text-muted-foreground">
                    <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="tabular-nums">6</span> flagship customers
                </span>
            </div>

            <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                <ButtonCn Class="w-full sm:w-[240px]">Read case studies</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">
                    Book a demo
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "LaunchPad", "rocket"),
        new("l5", "Lumen",     "star"),
        new("l6", "Strata",    "layers"),
    ];
}
