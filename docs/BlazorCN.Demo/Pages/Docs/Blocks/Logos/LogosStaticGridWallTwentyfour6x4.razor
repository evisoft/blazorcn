@* ============================================================
   Block: logos-static-grid-wall-twentyfour-6x4
   Title: LogosStaticGridWallTwentyfour6x4
   Description: A maximum-density static grid wall logo block for React and Next.js with twenty-four borderless logo cells arranged in a responsive six-by-four desktop grid, a fast per-cell staggered cascade, and monochrome-to-color hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-static-grid-wall-twentyfour-6x4.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Flagship customers
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Every team refuses to ship slow.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Twenty-four engineering teams run the platform in production across every continent,
                every stack, and every compliance regime you can think of.
            </p>
        </div>

        @* Twenty-four cell static grid wall *@
        <ul class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-3 sm:gap-8 lg:grid-cols-4 xl:grid-cols-6">
            @foreach (var logo in _logos)
            {
                <li class="group flex h-20 items-center justify-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0 transition-colors group-hover:text-foreground" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold transition-colors group-hover:text-foreground">
                        @logo.Name
                    </span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

