@* ============================================================
   Block: logos-static-grid-wall-twelve-4x3
   Title: LogosStaticGridWallTwelve4x3
   Description: A curated static grid wall logo block for React and Next.js with exactly twelve borderless partner cells arranged in a four column by three row layout, monochrome-to-color hover states, and staggered entrance animation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-static-grid-wall-twelve-4x3.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                The curated short list
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Twelve teams defining the new standard.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Hand-picked flagship partners whose feedback shapes every release we ship. Small by
                design, intentional by choice.
            </p>
        </div>

        @* Borderless 4x3 grid wall *@
        <ul class="mt-12 grid grid-cols-2 gap-8 sm:grid-cols-4 sm:gap-10">
            @foreach (var logo in _logos)
            {
                <li class="group flex h-20 items-center justify-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0 transition-colors group-hover:text-foreground" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold transition-colors group-hover:text-foreground">
                        @logo.Name
                    </span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("t1",  "Halide",    "shield"),
        new("t2",  "Northwind", "compass"),
        new("t3",  "Ion",       "atom"),
        new("t4",  "LaunchPad", "rocket"),
        new("t5",  "Lumen",     "star"),
        new("t6",  "Loam",      "tree-pine"),
        new("t7",  "Strata",    "layers"),
        new("t8",  "Honeycomb", "hexagon"),
        new("t9",  "Bastion",   "key"),
        new("t10", "Meridian",  "globe"),
        new("t11", "Ember",     "flame"),
        new("t12", "Facet",     "gem"),
    ];
}
