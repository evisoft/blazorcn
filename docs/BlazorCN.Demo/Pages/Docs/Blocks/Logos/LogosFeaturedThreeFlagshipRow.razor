@* ============================================================
   Block: logos-featured-three-flagship-row
   Title: LogosFeaturedThreeFlagshipRow
   Description: A three flagship row logo block for React and Next.js with three equal-weight hero cards on a single row, inverted size-20 rounded mark containers, text-2xl bold wordmarks, and tenure metrics built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-featured-three-flagship-row.tsx
   ============================================================ *@

<section aria-label="Flagship partners" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-14 sm:py-20">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Anchor partnerships
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Three flagship partners power the platform.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every deployment runs on an ecosystem anchored by these three flagship partners — each
                chosen for reliability, reach, and long-term commitment.
            </p>
        </div>

        @* Three flagship cards row *@
        <ul aria-label="Flagship partner cards" class="mt-14 grid grid-cols-1 gap-6 sm:grid-cols-3 sm:gap-5">
            @foreach (var flagship in _flagships)
            {
                <li class="group relative flex flex-col items-center rounded-2xl border-2 border-foreground/15 bg-card px-8 py-10 shadow-sm transition-all duration-200 hover:shadow-md">

                    @* Per-card partnership pill *@
                    <span class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-2.5 py-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                        @flagship.PartnershipLabel
                    </span>

                    @* Inverted mark container *@
                    <div class="mt-4 flex size-20 items-center justify-center rounded-3xl bg-foreground text-background shadow-sm transition-transform duration-200 group-hover:scale-105">
                        <LucideIconCn Name="@flagship.IconName" Size="48" Class="size-12" aria-hidden="true" />
                    </div>

                    @* Wordmark *@
                    <p class="mt-6 text-2xl font-bold tracking-tight text-foreground">
                        @flagship.Name
                    </p>

                    @* Tenure metric *@
                    <p class="mt-2 text-xs tabular-nums text-muted-foreground">
                        @flagship.TenureMetric
                    </p>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Flagship(string Id, string Name, string IconName, string PartnershipLabel, string TenureMetric);

    private static readonly Flagship[] _flagships =
    [
        new("f1", "Halide",    "shield",  "Security partner",  "Since 2020 · 200+ teams"),
        new("f2", "Northwind", "compass", "Platform partner",  "Since 2019 · 340+ teams"),
        new("f3", "Ion",       "atom",    "Data partner",      "Since 2021 · 180+ teams"),
    ];
}
