@* ============================================================
   Block: logos-single-marquee-reverse-direction
   Title: LogosSingleMarqueeReverseDirection
   Description: A right-scrolling single row marquee logo wall for React and Next.js with reversed keyframe direction, gradient edge masks, monochrome-to-color hover promotion, and a fifty second loop built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-single-marquee-reverse-direction.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <style>
        @@keyframes logos-single-reverse-right {
            from { transform: translateX(-50%); }
            to { transform: translateX(0); }
        }
        @@media (prefers-reduced-motion: reduce) {
            [data-logos-single-reverse="true"] {
                animation: none !important;
                transform: none !important;
            }
        }
    </style>

    <div class="py-12 sm:py-16">
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                On the frontier
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Teams building what's next.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Innovators and incumbents alike ship on our platform — from two-person startups to
                household names shaping the next decade of software.
            </p>
        </div>

        @* Reverse direction marquee row *@
        <div aria-hidden="true" class="relative mt-12 overflow-hidden py-4">
            @* Gradient edge masks *@
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent sm:w-40"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40"></div>

            <div class="flex">
                <div
                    data-logos-single-reverse="true"
                    class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                    style="animation: logos-single-reverse-right 50s linear infinite;">
                    @foreach (var logo in _doubled)
                    {
                        <div class="flex items-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                            <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                            <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Aegis",     "shield"),
        new("l2",  "Plotline",  "compass"),
        new("l3",  "Nucleo",    "atom"),
        new("l4",  "Trajector", "rocket"),
        new("l5",  "Codex",     "book"),
        new("l6",  "Sediment",  "layers"),
        new("l7",  "Ridgeline", "mountain"),
        new("l8",  "Pivot",     "key"),
        new("l9",  "Lattice",   "hexagon"),
        new("l10", "Forge",     "flame"),
        new("l11", "Tidal",     "waves"),
        new("l12", "Brilliant", "gem"),
    ];

    private static readonly Logo[] _doubled = [.._logos, .._logos];
}
