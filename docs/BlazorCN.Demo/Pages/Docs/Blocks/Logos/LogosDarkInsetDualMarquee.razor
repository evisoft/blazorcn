@* ============================================================
   Block: logos-dark-inset-dual-marquee
   Title: LogosDarkInsetDualMarquee
   Description: A dark inset dual row opposing marquee logo block for React and Next.js with a rounded bg-foreground inverted panel, two rows scrolling in opposite directions at 40 and 50 seconds, dark edge masks using from-foreground to transparent, and inverted logo hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-dark-inset-dual-marquee.tsx
   ============================================================ *@

<style>
    @@keyframes logos-dark-inset-dual-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    @@keyframes logos-dark-inset-dual-right {
        from { transform: translateX(-50%); }
        to { transform: translateX(0); }
    }
    @@media (prefers-reduced-motion: reduce) {
        [data-logos-dark-inset-dual="row-one"],
        [data-logos-dark-inset-dual="row-two"] {
            animation: none !important;
            transform: none !important;
        }
    }
</style>

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="relative overflow-hidden rounded-2xl bg-foreground px-6 py-14 sm:px-10 sm:py-20">

        @* Top-right corner accent pill *@
        <div class="absolute right-6 top-6 hidden sm:block">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-background/15 bg-background/[0.05] px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-background/60">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-400"></span>
                24 logos in motion
            </span>
        </div>

        @* Inverted marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-background/40">
                Always shipping
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-background sm:text-4xl lg:text-5xl">
                Two rows, zero downtime.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-background/60">
                Two dozen flagship engineering teams scrolling past in opposing directions — a small
                taste of the thousands deploying with us.
            </p>
        </div>

        @* Dual marquee rows *@
        <div class="mt-12 space-y-6 sm:space-y-8">

            @* Row One — scrolls left, 40s *@
            <div class="relative overflow-hidden">
                <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 z-10 w-20 bg-gradient-to-r from-foreground to-transparent sm:w-32"></div>
                <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 z-10 w-20 bg-gradient-to-l from-foreground to-transparent sm:w-32"></div>
                <ul data-logos-dark-inset-dual="row-one"
                    class="flex w-max items-center gap-12 sm:gap-16"
                    style="animation: logos-dark-inset-dual-left 40s linear infinite;">
                    @foreach (var logo in _rowOneDoubled)
                    {
                        <li class="group flex shrink-0 items-center gap-2.5 text-background/60 transition-colors duration-200 hover:text-background">
                            <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0 transition-colors duration-200 group-hover:text-background" aria-hidden="true" />
                            <span class="whitespace-nowrap text-sm font-semibold text-background/80 transition-colors duration-200 group-hover:text-background">@logo.Name</span>
                        </li>
                    }
                </ul>
            </div>

            @* Row Two — scrolls right, 50s *@
            <div class="relative overflow-hidden">
                <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 z-10 w-20 bg-gradient-to-r from-foreground to-transparent sm:w-32"></div>
                <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 z-10 w-20 bg-gradient-to-l from-foreground to-transparent sm:w-32"></div>
                <ul data-logos-dark-inset-dual="row-two"
                    class="flex w-max items-center gap-12 sm:gap-16"
                    style="animation: logos-dark-inset-dual-right 50s linear infinite;">
                    @foreach (var logo in _rowTwoDoubled)
                    {
                        <li class="group flex shrink-0 items-center gap-2.5 text-background/60 transition-colors duration-200 hover:text-background">
                            <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0 transition-colors duration-200 group-hover:text-background" aria-hidden="true" />
                            <span class="whitespace-nowrap text-sm font-semibold text-background/80 transition-colors duration-200 group-hover:text-background">@logo.Name</span>
                        </li>
                    }
                </ul>
            </div>

        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _rowOne =
    [
        new("r1-1",  "Halide",     "shield"),
        new("r1-2",  "Northwind",  "compass"),
        new("r1-3",  "Ion",        "atom"),
        new("r1-4",  "Rookery",    "feather"),
        new("r1-5",  "LaunchPad",  "rocket"),
        new("r1-6",  "Lumen",      "star"),
        new("r1-7",  "Loam",       "tree-pine"),
        new("r1-8",  "Strata",     "layers"),
        new("r1-9",  "Telemark",   "mountain"),
        new("r1-10", "Bastion",    "key"),
        new("r1-11", "Honeycomb",  "hexagon"),
        new("r1-12", "Ember",      "flame"),
    ];

    private static readonly Logo[] _rowTwo =
    [
        new("r2-1",  "Meridian",   "globe"),
        new("r2-2",  "Tidal",      "waves"),
        new("r2-3",  "Zephyr",     "wind"),
        new("r2-4",  "Solaris",    "sun"),
        new("r2-5",  "Nocturne",   "moon"),
        new("r2-6",  "Facet",      "gem"),
        new("r2-7",  "Aquifer",    "droplets"),
        new("r2-8",  "Aperture",   "camera"),
        new("r2-9",  "Codex",      "book"),
        new("r2-10", "Glimmer",    "sparkles"),
