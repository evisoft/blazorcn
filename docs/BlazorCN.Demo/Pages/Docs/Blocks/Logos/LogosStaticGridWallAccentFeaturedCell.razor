@* ============================================================
   Block: logos-static-grid-wall-accent-featured-cell
   Title: LogosStaticGridWallAccentFeaturedCell
   Description: A static grid wall logo block for React and Next.js with twelve cells in a four-column grid where one flagship cell is promoted with a border, shadow, and FLAGSHIP badge, monochrome-to-color hover states on standard cells, and staggered entrance animation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-static-grid-wall-accent-featured-cell.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer roster
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Led by our flagship customer, trusted by eleven more.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Our flagship customer ships five years of backlog in three months on our platform — and
                eleven more engineering teams follow close behind.
            </p>
        </div>

        @* Accent-featured grid wall *@
        <ul class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4">
            @foreach (var logo in _logos)
            {
                var isFeatured = logo.Featured;
                <li class="@(isFeatured
                    ? "relative flex h-20 items-center justify-center gap-3 rounded-xl border-2 border-foreground/15 bg-card text-foreground shadow-sm transition-colors duration-200"
                    : "flex h-20 items-center justify-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground")">
                    @if (isFeatured)
                    {
                        <span class="absolute left-3 top-2 inline-flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-wider text-foreground">
                            <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                            Flagship
                        </span>
                    }
                    <LucideIconCn Name="@logo.IconName" Size="@(isFeatured ? 36 : 28)" Class="@(isFeatured ? "size-9 shrink-0" : "size-7 shrink-0")" aria-hidden="true" />
                    <span class="@(isFeatured ? "whitespace-nowrap text-base font-semibold" : "whitespace-nowrap text-sm font-semibold")">
                        @logo.Name
                    </span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName, bool Featured = false);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",     "shield",    Featured: true),
        new("l2",  "Northwind",  "compass"),
        new("l3",  "Ion",        "atom"),
        new("l4",  "LaunchPad",  "rocket"),
        new("l5",  "Lumen",      "star"),
        new("l6",  "Strata",     "layers"),
        new("l7",  "Telemark",   "mountain"),
        new("l8",  "Bastion",    "key"),
        new("l9",  "Honeycomb",  "hexagon"),
        new("l10", "Loam",       "tree-pine"),
        new("l11", "Ember",      "flame"),
        new("l12", "Facet",      "gem"),
    ];
}
