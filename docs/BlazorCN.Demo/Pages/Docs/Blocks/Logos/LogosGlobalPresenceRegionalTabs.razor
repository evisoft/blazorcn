@* ============================================================
   Block: logos-global-presence-regional-tabs
   Title: LogosGlobalPresenceRegionalTabs
   Description: A region-filtered logo grid for React and Next.js with four pill tabs filtering by geography All, Americas, EMEA, and APAC, balanced eight-logo rosters per tab, a reserved minimum grid height that prevents layout shift, and AnimatePresence crossfade between regions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-global-presence-regional-tabs.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Global customer footprint
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Trusted in every region.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Filter by geography to see the engineering teams shipping with us in your market — from
                the Americas to EMEA to APAC.
            </p>
        </div>

        @* Pill tabs *@
        <nav aria-label="Filter logos by region" class="mt-10 flex justify-center">
            <div role="tablist" class="inline-flex items-center gap-1 rounded-full border bg-muted/50 p-1">
                @foreach (var region in _regions)
                {
                    var reg = region;
                    var isActive = _active == reg.Id;
                    <button
                        type="button"
                        role="tab"
                        aria-selected="@isActive"
                        aria-controls="logos-region-grid"
                        @onclick="@(() => SetActive(reg.Id))"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-semibold transition-colors duration-200", isActive ? "border border-border bg-background text-foreground shadow-sm" : "border border-transparent text-muted-foreground hover:text-foreground")">
                        @reg.Label
                    </button>
                }
            </div>
        </nav>

        @* Filtered grid with reserved min-height *@
        <div id="logos-region-grid" class="mt-10 min-h-[240px] sm:min-h-[200px]">
            <ul aria-label="@($"Customer logos in {ActiveTab.Label}")" class="grid grid-cols-2 gap-6 sm:grid-cols-4 sm:gap-8">
                @foreach (var logo in GetLogosForRegion(_active))
                {
                    <li class="group flex h-20 items-center justify-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                        <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0 transition-transform group-hover:rotate-3" aria-hidden="true" />
                        <span class="text-sm font-semibold whitespace-nowrap">@logo.Name</span>
                    </li>
                }
            </ul>
        </div>

        @* Region caption *@
        <p class="mt-6 text-center text-xs font-medium uppercase tracking-widest text-muted-foreground">
            @ActiveTab.Caption
        </p>
    </div>
</section>

@code {
    private record RegionTab(string Id, string Label, string Caption);
    private record LogoData(string Id, string Name, string IconName, string Region, bool Featured = false);

    private static readonly RegionTab[] _regions =
    [
        new("all",      "All",      "Teams across every region"),
        new("americas", "Americas", "North and South America"),
        new("emea",     "EMEA",     "Europe, Middle East, and Africa"),
        new("apac",     "APAC",     "Asia-Pacific and Oceania"),
    ];

    private static readonly LogoData[] _logos =
    [
        // Americas — 8
        new("l1",  "Atlas",     "globe",     "americas", true),
        new("l2",  "Summit",    "mountain",  "americas", true),
        new("l3",  "Tidal",     "waves",     "americas"),
        new("l4",  "Ember",     "flame",     "americas"),
        new("l5",  "Lumen",     "star",      "americas"),
        new("l6",  "Halide",    "shield",    "americas"),
        new("l7",  "Rookery",   "feather",   "americas"),
        new("l8",  "Facet",     "gem",       "americas"),
        // EMEA — 8
        new("l9",  "Meridian",  "compass",   "emea",     true),
        new("l10", "Zephyr",    "wind",      "emea",     true),
        new("l11", "Solaris",   "sun",       "emea"),
        new("l12", "Codex",     "book",      "emea"),
        new("l13", "Strata",    "layers",    "emea"),
        new("l14", "Bastion",   "key",       "emea"),
        new("l15", "Glimmer",   "sparkles",  "emea"),
        new("l16", "Loam",      "tree-pine", "emea"),
        // APAC — 8
        new("l17", "Ion",       "atom",      "apac",     true),
        new("l18", "Honeycomb", "hexagon",   "apac",     true),
        new("l19", "Nocturne",  "moon",      "apac"),
        new("l20", "LaunchPad", "rocket",    "apac"),
        new("l21", "Aquifer",   "droplets",  "apac"),
        new("l22", "Telemark",  "mountain",  "apac"),
        new("l23", "Evergreen", "tree-pine", "apac"),
        new("l24", "Polaris",   "star",      "apac"),
    ];

    private string _active = "all";

    private RegionTab ActiveTab => Array.Find(_regions, r => r.Id == _active) ?? _regions[0];

    private void SetActive(string regionId)
    {
        _active = regionId;
    }

    private static LogoData[] GetLogosForRegion(string active)
    {
        if (active == "all")
        {
            var featured = Array.FindAll(_logos, l => l.Featured);
            var fillers = Array.FindAll(_logos, l => !l.Featured);
            var combined = new List<LogoData>(featured);
            for (var i = 0; combined.Count < 8 && i < fillers.Length; i++)
                combined.Add(fillers[i]);
            return combined.Count > 8
                ? combined.GetRange(0, 8).ToArray()
                : combined.ToArray();
        }
        var regionLogos = Array.FindAll(_logos, l => l.Region == active);
        return regionLogos.Length > 8
            ? regionLogos[..8]
            : regionLogos;
    }
}
