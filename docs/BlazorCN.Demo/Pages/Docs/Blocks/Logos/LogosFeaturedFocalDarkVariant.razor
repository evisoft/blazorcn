@* ============================================================
   Block: logos-featured-focal-dark-variant
   Title: LogosFeaturedFocalDarkVariant
   Description: A dark inset featured focal hub logo block for React and Next.js with an inverted flagship card, dashed integrates-with divider, and six supporting integration cells inside a bg-foreground panel built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-featured-focal-dark-variant.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-4xl p-4">
    <div class="rounded-2xl bg-foreground px-6 py-14 sm:px-10 sm:py-20">

        @* Marketing headline cluster — inverted *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-background/40">
                Core ecosystem
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-background sm:text-4xl lg:text-5xl">
                Built on world-class foundations.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-background/60">
                Our platform is anchored by a flagship partnership and extends across an ecosystem of
                six best-in-class integrations.
            </p>
        </div>

        @* Central flagship card — inverted treatment *@
        <div class="relative mx-auto mt-14 flex max-w-md flex-col items-center rounded-3xl border-2 border-background/20 bg-background/[0.05] px-10 py-12 shadow-md">

            @* Flagship pill *@
            <span class="inline-flex items-center gap-1.5 rounded-full border border-background/20 bg-background/[0.05] px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-background/70">
                <span class="size-1.5 rounded-full bg-emerald-400"></span>
                @_featured.PartnershipLabel
            </span>

            @* Central inverted mark *@
            <div class="mt-6 flex size-24 items-center justify-center rounded-3xl bg-background text-foreground shadow-sm">
                <LucideIconCn Name="@_featured.IconName" Size="56" Class="size-14" aria-hidden="true" />
            </div>

            @* Wordmark *@
            <p class="mt-6 text-3xl font-bold tracking-tight text-background sm:text-4xl">
                @_featured.Name
            </p>

            @* Tenure metric *@
            <p class="mt-3 text-sm text-background/60">@_featured.TenureMetric</p>
        </div>

        @* Dashed connecting divider with centered label *@
        <div class="relative mt-12 flex items-center justify-center" aria-hidden="true">
            <div class="h-px w-full border-t border-dashed border-background/20"></div>
            <span class="absolute bg-foreground px-4 text-[11px] font-medium uppercase tracking-widest text-background/40">
                Integrates with
            </span>
        </div>

        @* Supporting integration strip — inverted *@
        <ul aria-label="Integration partners" class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
            @foreach (var logo in _supporting)
            {
                <li class="flex h-16 flex-col items-center justify-center gap-1.5 rounded-xl border border-background/15 bg-background/[0.05] text-background/60 transition-colors hover:border-background/30 hover:text-background">
                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record FeaturedLogo(string Id, string Name, string IconName, string PartnershipLabel, string TenureMetric);
    private record SupportingLogo(string Id, string Name, string IconName);

    private static readonly FeaturedLogo _featured = new(
        "central",
        "Halide",
        "shield",
        "Flagship partner",
        "Since 2019 · 500+ teams built on this"
    );

    private static readonly SupportingLogo[] _supporting =
    [
        new("s1", "Northwind", "compass"),
        new("s2", "Ion",       "atom"),
        new("s3", "Rookery",   "feather"),
        new("s4", "LaunchPad", "rocket"),
        new("s5", "Strata",    "layers"),
        new("s6", "Honeycomb", "hexagon"),
    ];
}
