@* ============================================================
   Block: logos-featured-quote-with-supporting-trio
   Title: LogosFeaturedQuoteWithSupportingTrio
   Description: A featured quote split logo block for React and Next.js with a flagship mark and blockquote on top plus a horizontal trio of supporting customer cells below built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-featured-quote-with-supporting-trio.tsx
   ============================================================ *@

<section aria-label="Featured customer quote with supporting logo trio" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-14 sm:py-20">

        @* Featured split *@
        <div class="grid items-center gap-12 lg:grid-cols-2 lg:gap-16">

            @* Left — flagship logo card *@
            <div class="flex flex-col items-center rounded-2xl border-2 border-foreground/15 bg-card p-8 shadow-sm sm:p-10">
                <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Featured customer
                </span>
                <div class="mt-5 flex size-20 items-center justify-center rounded-3xl border bg-muted/40 sm:size-24">
                    <LucideIconCn Name="shield" Size="48" Class="size-12 text-foreground sm:size-14" aria-hidden="true" />
                </div>
                <p class="mt-5 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                    @_featured.Name
                </p>
                <p class="mt-2 text-xs tabular-nums text-muted-foreground">@_featured.Tenure</p>
            </div>

            @* Right — semantic quote *@
            <figure>
                <blockquote class="text-xl font-medium leading-relaxed text-foreground sm:text-2xl">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>
                <figcaption class="mt-6 flex items-center gap-4">
                    <div
                        aria-hidden="true"
                        class="flex size-12 shrink-0 items-center justify-center rounded-full border bg-muted font-mono text-sm font-semibold text-muted-foreground">
                        @_featured.AuthorInitials
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-foreground">@_featured.AuthorName</p>
                        <p class="text-xs text-muted-foreground">@_featured.AuthorRole</p>
                    </div>
                </figcaption>
            </figure>

        </div>

        @* Supporting trio *@
        <div class="mt-12 sm:mt-16">
            <p class="mb-3 text-center text-xs text-muted-foreground">
                Similar teams ship with us
            </p>
            <ul class="grid grid-cols-1 gap-4 sm:grid-cols-3">
                @foreach (var logo in _supporting)
                {
                    <li class="flex items-center gap-2.5 rounded-xl border bg-card px-5 py-3 text-muted-foreground transition-colors hover:text-foreground">
                        <LucideIconCn Name="@logo.Icon" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                        <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                    </li>
                }
            </ul>
        </div>

    </div>
</section>

@code {
    private record FeaturedCustomer(
        string Name,
        string Quote,
        string AuthorName,
        string AuthorRole,
        string AuthorInitials,
        string Tenure
    );

    private record SupportingLogo(string Id, string Name, string Icon);

    private static readonly FeaturedCustomer _featured = new(
        "Halide",
        "We cut our p99 latency from 900ms to 80ms in a weekend migration. Our on-call pager has been silent for three months and counting.",
        "Sarah Chen",
        "Staff Engineer · Halide",
        "SC",
        "Customer since 2021"
    );

    private static readonly SupportingLogo[] _supporting =
    [
        new("s1", "Northwind", "compass"),
        new("s2", "Strata",    "layers"),
        new("s3", "Tidal",     "waves"),
    ];
}
