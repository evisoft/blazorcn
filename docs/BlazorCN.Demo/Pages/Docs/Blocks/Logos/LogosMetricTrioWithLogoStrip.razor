@* ============================================================
   Block: logos-metric-trio-with-logo-strip
   Title: LogosMetricTrioWithLogoStrip
   Description: A metric trio logo strip for React and Next.js with three equal-weight tabular-num metric tiles, a monochrome-to-color logo hover row, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-metric-trio-with-logo-strip.tsx
   ============================================================ *@

<section aria-label="Customer logos and scale metrics" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                By the numbers
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Three numbers. One story.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The teams who ship with us operate at global scale with enterprise reliability — here
                are the receipts.
            </p>
        </div>

        @* Metric trio *@
        <div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 items-center gap-8 sm:grid-cols-[1fr_auto_1fr_auto_1fr]">
            @foreach (var metric in _metrics)
            {
                var idx = System.Array.IndexOf(_metrics, metric);
                var colClass = idx == 0 ? "text-center sm:col-start-1" : idx == 1 ? "text-center sm:col-start-3" : "text-center sm:col-start-5";
                <div class="@colClass">
                    <p class="text-4xl font-bold tracking-tight tabular-nums text-foreground sm:text-5xl">
                        @metric.Value
                    </p>
                    <p class="mt-2 text-sm text-muted-foreground">@metric.Label</p>
                </div>
            }
            <span aria-hidden="true" class="hidden h-12 w-px bg-border sm:col-start-2 sm:row-start-1 sm:inline-block"></span>
            <span aria-hidden="true" class="hidden h-12 w-px bg-border sm:col-start-4 sm:row-start-1 sm:inline-block"></span>
        </div>

        @* Divider *@
        <div aria-hidden="true" class="mx-auto mt-12 h-px w-full max-w-4xl bg-border"></div>

        @* Logo strip *@
        <ul aria-label="Customer logos" class="mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
            @foreach (var logo in _logos)
            {
                <li class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>

        @* CTA pair *@
        <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[240px]">Read case studies</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">
                Book a demo
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Metric(string Id, string Value, string Label);
    private record Logo(string Id, string Name, string IconName);

    private static readonly Metric[] _metrics =
    [
        new("teams",     "12,000+", "engineering teams"),
        new("countries", "60",      "countries served"),
        new("uptime",    "99.99%",  "platform uptime"),
    ];

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",    "shield"),
        new("l2",  "Northwind", "compass"),
        new("l3",  "Ion",       "atom"),
        new("l4",  "Rookery",   "feather"),
        new("l5",  "LaunchPad", "rocket"),
        new("l6",  "Loam",      "tree-pine"),
        new("l7",  "Strata",    "layers"),
        new("l8",  "Honeycomb", "hexagon"),
        new("l9",  "Bastion",   "key"),
        new("l10", "Telemark",  "mountain"),
    ];
}
