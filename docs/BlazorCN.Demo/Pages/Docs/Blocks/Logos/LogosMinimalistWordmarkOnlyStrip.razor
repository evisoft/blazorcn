@* ============================================================
   Block: logos-minimalist-wordmark-only-strip
   Title: LogosMinimalistWordmarkOnlyStrip
   Description: A typographic wordmark only logo strip for React and Next.js with eight placeholder brand names rendered as bold tracking-tight text, no icons, and monochrome-to-color hover built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-minimalist-wordmark-only-strip.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-4xl p-4">
    <div class="border-y border-dashed border-border/60 py-10 sm:py-14">
        <p class="text-center text-xs font-medium uppercase tracking-widest text-muted-foreground">
            @_eyebrow
        </p>

        <ul aria-label="Customer wordmarks"
            class="mt-8 flex flex-wrap items-center justify-center gap-x-12 gap-y-5 sm:gap-x-16">
            @foreach (var wordmark in _wordmarks)
            {
                <li class="whitespace-nowrap text-base font-bold tracking-tight text-muted-foreground transition-all duration-200 hover:tracking-normal hover:text-foreground">
                    @wordmark.Name
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Wordmark(string Id, string Name);

    private const string _eyebrow = "The teams shipping every day";

    private static readonly Wordmark[] _wordmarks =
    [
        new("w1", "Halide"),
        new("w2", "Northwind"),
        new("w3", "Ion"),
        new("w4", "LaunchPad"),
        new("w5", "Loam"),
        new("w6", "Strata"),
        new("w7", "Honeycomb"),
        new("w8", "Bastion"),
    ];
}
