@* ============================================================
   Block: logos-dual-marquee-with-metric-divider
   Title: LogosDualMarqueeWithMetricDivider
   Description: A dual row infinite marquee logo wall for React and Next.js with a centered metric chip divider between the two rows, opposing scroll directions, gradient edge masks, and reduced-motion handling built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-dual-marquee-with-metric-divider.tsx
   ============================================================ *@

<style>
    @@keyframes logos-divider-row-1-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    @@keyframes logos-divider-row-2-right {
        from { transform: translateX(-50%); }
        to { transform: translateX(0); }
    }
    @@media (prefers-reduced-motion: reduce) {
        [data-logos-divider-metric="row-one"],
        [data-logos-divider-metric="row-two"] {
            animation: none !important;
            transform: none !important;
        }
    }
</style>

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Global scale
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The numbers behind the names.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Twelve thousand teams across sixty countries deploy on the same platform with four-nines
                uptime every quarter for the past two years.
            </p>
        </div>

        @* Top marquee row *@
        <div class="relative mt-12 overflow-hidden py-4">
            <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent sm:w-40"></div>
            <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40"></div>
            <div aria-hidden="true" class="flex">
                <div data-logos-divider-metric="row-one"
                     class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                     style="animation-name: logos-divider-row-1-left; animation-duration: 40s; animation-timing-function: linear; animation-iteration-count: infinite;">
                    @foreach (var logo in _doubledRow1)
                    {
                        <div class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                            <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                            <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Metric divider *@
        <div class="mt-8 flex items-center justify-center gap-x-6 sm:gap-x-8">
            @foreach (var (metric, i) in _metrics.Select((m, idx) => (m, idx)))
            {
                <div class="flex items-center gap-x-6 sm:gap-x-8">
                    @if (i > 0)
                    {
                        <span aria-hidden="true" class="h-4 w-px bg-border"></span>
                    }
                    <div class="text-center">
                        <p class="text-2xl font-bold tabular-nums tracking-tight text-foreground">@metric.Value</p>
                        <span class="mt-0.5 block text-[11px] font-medium uppercase tracking-wider text-muted-foreground">@metric.Label</span>
                    </div>
                </div>
            }
        </div>

        @* Bottom marquee row *@
        <div class="relative mt-8 overflow-hidden py-4">
            <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent sm:w-40"></div>
            <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40"></div>
            <div aria-hidden="true" class="flex">
                <div data-logos-divider-metric="row-two"
                     class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                     style="animation-name: logos-divider-row-2-right; animation-duration: 50s; animation-timing-function: linear; animation-iteration-count: infinite;">
                    @foreach (var logo in _doubledRow2)
                    {
                        <div class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                            <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                            <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);
    private record Metric(string Id, string Value, string Label);

    private static readonly Logo[] _row1 =
    [
        new("d1-1",  "Halide",    "shield"),
        new("d1-2",  "Northwind", "compass"),
        new("d1-3",  "Ion",       "atom"),
        new("d1-4",  "LaunchPad", "rocket"),
        new("d1-5",  "Lumen",     "star"),
        new("d1-6",  "Loam",      "tree-pine"),
        new("d1-7",  "Strata",    "layers"),
        new("d1-8",  "Honeycomb", "hexagon"),
        new("d1-9",  "Bastion",   "key"),
        new("d1-10", "Meridian",  "globe"),
        new("d1-11", "Ember",     "flame"),
        new("d1-12", "Rookery",   "feather"),
    ];

    private static readonly Logo[] _row2 =
    [
        new("d2-1",  "Telemark",  "mountain"),
        new("d2-2",  "Tidal",     "waves"),
        new("d2-3",  "Zephyr",    "wind"),
        new("d2-4",  "Solaris",   "sun"),
        new("d2-5",  "Glimmer",   "sparkles"),
        new("d2-6",  "Nocturne",  "moon"),
        new("d2-7",  "Plume",     "feather"),
        new("d2-8",  "Summit",    "mountain"),
        new("d2-9",  "Helios",    "sun"),
        new("d2-10", "Nucleo",    "atom"),
        new("d2-11", "Atlas",     "globe"),
        new("d2-12", "Citadel",   "shield"),
    ];

    private static readonly Metric[] _metrics =
    [
        new("m-1", "12,000+", "Teams"),
        new("m-2", "60",      "Countries"),
        new("m-3", "99.99%",  "Uptime"),
    ];

    private static readonly Logo[] _doubledRow1 = [.. _row1, .. _row1];
    private static readonly Logo[] _doubledRow2 = [.. _row2, .. _row2];
}
