@* ============================================================
   Block: logos-minimalist-strip-with-dividers
   Title: LogosMinimalistStripWithDividers
   Description: A minimalist single-row logo strip for React and Next.js with vertical divider rules between each logo, an uppercase eyebrow, and monochrome-to-color hover built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-minimalist-strip-with-dividers.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-4xl p-4">
    <div class="border-y border-dashed border-border/60 py-10 sm:py-14">
        @* Eyebrow-only — Minimalist Strip archetype *@
        <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                @_eyebrow
            </p>
            <span aria-hidden="true" class="hidden h-3 w-px bg-border sm:inline-block"></span>
            <span class="text-[11px] tabular-nums text-muted-foreground">
                7 verified partners
            </span>
        </div>

        @* Logo strip with vertical dividers *@
        <ul aria-label="Customer logos" class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-5 sm:gap-x-8">
            @foreach (var logo in _logos)
            {
                var logoItem = logo;
                <li class="flex items-center gap-x-6 sm:gap-x-8">
                    <div class="flex items-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                        <LucideIconCn Name="@logoItem.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                        <span class="whitespace-nowrap text-sm font-semibold">@logoItem.Name</span>
                    </div>
                    @if (logoItem.Id != _logos[_logos.Length - 1].Id)
                    {
                        <span aria-hidden="true" class="hidden h-4 w-px bg-border sm:inline-block"></span>
                    }
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private const string _eyebrow = "Trusted by teams at";

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "LaunchPad", "rocket"),
        new("l5", "Loam",      "tree-pine"),
        new("l6", "Strata",    "layers"),
        new("l7", "Honeycomb", "hexagon"),
    ];
}
