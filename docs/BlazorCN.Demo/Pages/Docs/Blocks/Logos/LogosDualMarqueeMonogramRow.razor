@* ============================================================
   Block: logos-dual-marquee-monogram-row
   Title: LogosDualMarqueeMonogramRow
   Description: A dual row infinite marquee logo wall using two-letter monogram cells for React and Next.js with opposing scroll directions, bordered card tiles, compact cell density, and reduced-motion handling built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-dual-marquee-monogram-row.tsx
   ============================================================ *@

<style>
    @@keyframes logos-monogram-dual-marquee-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    @@keyframes logos-monogram-dual-marquee-right {
        from { transform: translateX(-50%); }
        to { transform: translateX(0); }
    }
    @@media (prefers-reduced-motion: reduce) {
        [data-logos-monogram-dual="row-one"],
        [data-logos-monogram-dual="row-two"] {
            animation: none !important;
            transform: none !important;
        }
    }
</style>

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Partners at scale
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Twenty-eight teams. One platform.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every tile is a production partner shipping daily on our infrastructure. Hover any
                monogram to reveal the brand behind the letters.
            </p>
        </div>

        @* Dual monogram marquee rows *@
        <div aria-hidden="true" class="relative mt-12 overflow-hidden py-4">
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-20 bg-gradient-to-r from-background to-transparent sm:w-32"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-20 bg-gradient-to-l from-background to-transparent sm:w-32"></div>

            <div class="space-y-5">

                @* Row One — scrolls left, 45s *@
                <div class="flex">
                    <div data-logos-monogram-dual="row-one"
                         class="flex w-max shrink-0 items-center gap-4 sm:gap-5"
                         style="animation-name: logos-monogram-dual-marquee-left; animation-duration: 45s; animation-timing-function: linear; animation-iteration-count: infinite;">
                        @foreach (var logo in _doubledRow1)
                        {
                            <div role="img"
                                 aria-label="@logo.Name"
                                 class="flex size-14 shrink-0 items-center justify-center rounded-xl border bg-card font-mono text-sm font-bold text-muted-foreground transition-colors hover:border-foreground/20 hover:text-foreground">
                                @logo.Text
                            </div>
                        }
                    </div>
                </div>

                @* Row Two — scrolls right, 55s *@
                <div class="flex">
                    <div data-logos-monogram-dual="row-two"
                         class="flex w-max shrink-0 items-center gap-4 sm:gap-5"
                         style="animation-name: logos-monogram-dual-marquee-right; animation-duration: 55s; animation-timing-function: linear; animation-iteration-count: infinite;">
                        @foreach (var logo in _doubledRow2)
                        {
                            <div role="img"
                                 aria-label="@logo.Name"
                                 class="flex size-14 shrink-0 items-center justify-center rounded-xl border bg-card font-mono text-sm font-bold text-muted-foreground transition-colors hover:border-foreground/20 hover:text-foreground">
                                @logo.Text
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>

@code {
    private record Monogram(string Id, string Name, string Text);

    private static readonly Monogram[] _row1 =
    [
        new("mr1-1",  "Halide",     "HL"),
        new("mr1-2",  "Northwind",  "NW"),
        new("mr1-3",  "Ion",        "IO"),
        new("mr1-4",  "LaunchPad",  "LP"),
        new("mr1-5",  "Strata",     "ST"),
        new("mr1-6",  "Honeycomb",  "HC"),
        new("mr1-7",  "Bastion",    "BS"),
        new("mr1-8",  "Meridian",   "MD"),
        new("mr1-9",  "Lumen",      "LM"),
        new("mr1-10", "Telemark",   "TM"),
        new("mr1-11", "Tidal",      "TD"),
        new("mr1-12", "Zephyr",     "ZP"),
        new("mr1-13", "Loam",       "LO"),
        new("mr1-14", "Ember",      "EM"),
    ];

    private static readonly Monogram[] _row2 =
    [
        new("mr2-1",  "Solaris",    "SL"),
