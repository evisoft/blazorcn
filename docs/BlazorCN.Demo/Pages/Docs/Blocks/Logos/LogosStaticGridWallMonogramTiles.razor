@* ============================================================
   Block: logos-static-grid-wall-monogram-tiles
   Title: LogosStaticGridWallMonogramTiles
   Description: A monogram-tile static grid wall logo block for React and Next.js with sixteen bordered square tiles rendering brand monograms in a monospace display face, a responsive two-to-eight column grid, and monochrome-to-color hover promotion built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-static-grid-wall-monogram-tiles.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted rosters
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Sixteen teams that trust our platform.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A typographic wall of customer monograms — every tile a company shipping with us in
                production every day.
            </p>
        </div>

        @* Monogram tile grid wall *@
        <ul class="mx-auto mt-12 grid max-w-3xl grid-cols-2 gap-4 sm:grid-cols-4 sm:gap-5 lg:max-w-none lg:grid-cols-8">
            @foreach (var logo in _logos)
            {
                <li class="group flex justify-center">
                    <div
                        role="img"
                        aria-label="@logo.Name"
                        class="flex size-20 items-center justify-center rounded-xl border bg-card text-muted-foreground transition-colors group-hover:border-foreground/20 group-hover:text-foreground">
                        <span class="font-mono text-lg font-bold transition-transform duration-300 group-hover:rotate-1">
                            @logo.Monogram
                        </span>
                    </div>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string Monogram);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",     "HL"),
        new("l2",  "Northwind",  "NW"),
        new("l3",  "Ion",        "IO"),
        new("l4",  "Rookery",    "RK"),
        new("l5",  "LaunchPad",  "LP"),
        new("l6",  "Lumen",      "LM"),
        new("l7",  "Loam",       "LO"),
        new("l8",  "Strata",     "ST"),
        new("l9",  "Telemark",   "TM"),
        new("l10", "Bastion",    "BA"),
        new("l11", "Honeycomb",  "HC"),
        new("l12", "Tidal",      "TD"),
        new("l13", "Meridian",   "MR"),
        new("l14", "Ember",      "EM"),
        new("l15", "Nocturne",   "NC"),
        new("l16", "Solaris",    "SO"),
    ];
}
