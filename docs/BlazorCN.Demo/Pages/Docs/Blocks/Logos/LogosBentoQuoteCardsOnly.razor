@* ============================================================
   Block: logos-bento-quote-cards-only
   Title: LogosBentoQuoteCardsOnly
   Description: A bento logo block with four equal-weight quote cards arranged in a two-by-two grid for React and Next.js with small logo marks, semantic blockquotes, and avatar attribution rows built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-bento-quote-cards-only.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-4xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer voices
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Four teams. Four sentences that stuck.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                No flagship, no hierarchy. Just four voices worth hearing in full, each anchoring their
                own corner of the grid.
            </p>
        </div>

        @* Bento grid — 2×2 equal quote cards *@
        <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-2">
            @foreach (var card in _quotes)
            {
                <figure class="group flex flex-col justify-between gap-6 rounded-2xl border bg-card p-6 transition-colors hover:border-foreground/20">

                    @* Top cluster: logo mark + wordmark *@
                    <div class="flex items-center gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border bg-muted/40 text-muted-foreground transition-colors group-hover:border-foreground/20 group-hover:text-foreground">
                            <LucideIconCn Name="@card.IconName" Size="20" Class="size-5 transition-transform group-hover:scale-110" />
                        </div>
                        <p class="text-base font-semibold text-foreground">@card.Name</p>
                    </div>

                    @* Middle: blockquote *@
                    <blockquote class="flex-1 text-sm leading-relaxed text-foreground">
                        &ldquo;@card.Quote&rdquo;
                    </blockquote>

                    @* Bottom cluster: attribution *@
                    <figcaption class="flex items-center gap-3 border-t pt-4">
                        <div aria-hidden="true"
                             class="flex size-8 shrink-0 items-center justify-center rounded-full border bg-muted font-mono text-[10px] font-semibold text-muted-foreground">
                            @card.AuthorInitials
                        </div>
                        <p class="truncate text-sm font-semibold text-foreground">@card.AuthorName</p>
                    </figcaption>

                </figure>
            }
        </div>

    </div>
</section>

@code {
    private record QuoteCard(string Id, string Name, string IconName, string Quote, string AuthorName, string AuthorInitials);

    private static readonly QuoteCard[] _quotes =
    [
        new("q1", "Halide", "shield", "We cut p99 latency from 900ms to 80ms in a weekend. The rollback plan was never needed.", "Sarah Chen", "SC"),
        new("q2", "Northwind", "compass", "Our on-call pager rang twice last quarter. Before the migration, it rang twice a day.", "Marcus Okonkwo", "MO"),
        new("q3", "Ion", "atom", "The first platform in five years that my engineers chose on their own time. That's the highest compliment I know.", "Priya Raman", "PR"),
        new("q4", "Loam", "tree-pine", "We shipped five years of backlog in three months. The team still debates whether to believe it.", "Emi Takeda", "ET"),
    ];
}
