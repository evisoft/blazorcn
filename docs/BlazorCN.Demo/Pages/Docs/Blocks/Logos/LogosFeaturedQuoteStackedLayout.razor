@* ============================================================
   Block: logos-featured-quote-stacked-layout
   Title: LogosFeaturedQuoteStackedLayout
   Description: A vertically stacked featured quote logo block for React and Next.js with a centered flagship mark on top, a centered blockquote in the middle, and a centered attribution figcaption at the bottom built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-featured-quote-stacked-layout.tsx
   ============================================================ *@

<section aria-label="Featured customer logo and quote stacked vertically" class="mx-auto w-full max-w-4xl p-4">
    <div class="flex flex-col items-center space-y-10 py-14 sm:py-20">

        @* Top — flagship logo card *@
        <div class="flex flex-col items-center rounded-2xl border-2 border-foreground/15 bg-card p-8 shadow-sm sm:p-10">
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Featured customer
            </span>
            <div class="mt-5 flex size-24 items-center justify-center rounded-3xl border bg-muted/40">
                <LucideIconCn Name="mountain" Size="56" Class="size-14 text-foreground" aria-hidden="true" />
            </div>
            <p class="mt-5 text-3xl font-bold tracking-tight text-foreground">@_featured.Name</p>
            <p class="mt-2 text-xs tabular-nums text-muted-foreground">@_featured.Tenure</p>
        </div>

        @* Middle — centered quote *@
        <figure class="flex flex-col items-center">
            <blockquote class="mx-auto max-w-2xl text-center text-xl font-medium leading-relaxed text-foreground sm:text-2xl">
                &ldquo;@_featured.Quote&rdquo;
            </blockquote>

            @* Bottom — centered attribution *@
            <figcaption class="mt-10 flex items-center gap-4">
                <div
                    aria-hidden="true"
                    class="flex size-12 shrink-0 items-center justify-center rounded-full border bg-muted font-mono text-sm font-semibold text-muted-foreground">
                    @_featured.AuthorInitials
                </div>
                <div class="text-left">
                    <p class="text-sm font-semibold text-foreground">@_featured.AuthorName</p>
                    <p class="text-xs text-muted-foreground">@_featured.AuthorRole</p>
                </div>
            </figcaption>
        </figure>

    </div>
</section>

@code {
    private record FeaturedCustomer(
        string Name,
        string Quote,
        string AuthorName,
        string AuthorRole,
        string AuthorInitials,
        string Tenure
    );

    private static readonly FeaturedCustomer _featured = new(
        "Summit",
        "I fired my DevOps team the week we migrated. Kidding — we promoted them into real engineering work instead of babysitting YAML for forty hours a week.",
        "Priya Raman",
        "Platform Lead · Summit",
        "PR",
        "Customer since 2020"
    );
}
