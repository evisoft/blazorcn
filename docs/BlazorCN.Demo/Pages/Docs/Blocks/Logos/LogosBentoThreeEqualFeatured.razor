@* ============================================================
   Block: logos-bento-three-equal-featured
   Title: LogosBentoThreeEqualFeatured
   Description: A bento logo block with three equal-weight featured case study cells for React and Next.js with flagship icon containers, industry pills, inline quotes, highlighted metrics, and attribution rows built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-bento-three-equal-featured.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Three teams. Three transformations.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Fintech, logistics, and developer tools — the same platform, three different shapes of
                proof. None of these stories is the hero; all of them are.
            </p>
        </div>

        @* Bento grid — three equal-weight featured cells *@
        <div class="mt-12 grid grid-cols-1 gap-5 sm:grid-cols-3">
            @foreach (var cell in _featured)
            {
                <figure class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border-2 border-foreground/15 bg-card p-6 shadow-sm transition-colors hover:border-foreground/25 sm:p-7">

                    @* Top cluster: icon + industry pill *@
                    <div>
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex size-12 items-center justify-center rounded-xl bg-foreground text-background shadow-sm">
                                <LucideIconCn Name="@cell.IconName" Size="24" Class="size-6 transition-transform group-hover:scale-110" aria-hidden="true" />
                            </div>
                            <span class="rounded-full border bg-muted/50 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                                @cell.Industry
                            </span>
                        </div>

                        @* Wordmark *@
                        <p class="mt-5 text-xl font-bold tracking-tight text-foreground">
                            @cell.Name
                        </p>

                        @* Quote *@
                        <blockquote class="mt-4 text-sm leading-relaxed text-foreground">
                            &ldquo;@cell.Quote&rdquo;
                        </blockquote>
                    </div>

                    @* Bottom cluster: metric + attribution *@
                    <div class="mt-6">
                        <div class="flex items-baseline gap-2 border-t pt-5">
                            <p class="text-2xl font-bold tracking-tight tabular-nums text-foreground">
                                @cell.Metric
                            </p>
                            <p class="text-xs text-muted-foreground">@cell.MetricLabel</p>
                        </div>

                        <figcaption class="mt-4 flex items-center gap-3">
                            <div aria-hidden="true" class="flex size-9 shrink-0 items-center justify-center rounded-full border bg-muted font-mono text-xs font-semibold text-muted-foreground">
                                @cell.AuthorInitials
                            </div>
                            <div class="min-w-0">
                                <p class="truncate text-sm font-semibold text-foreground">
                                    @cell.AuthorName
                                </p>
                                <p class="truncate text-xs text-muted-foreground">@cell.AuthorRole</p>
                            </div>
                        </figcaption>
                    </div>
                </figure>
            }
        </div>
    </div>
</section>

@code {
    private record FeaturedCell(
        string Id,
        string Name,
        string IconName,
        string Industry,
        string Quote,
        string Metric,
        string MetricLabel,
        string AuthorName,
        string AuthorRole,
        string AuthorInitials
    );

    private static readonly FeaturedCell[] _featured =
    [
        new(
            Id: "f1",
