@* ============================================================
   Block: logos-double-headline-with-grid
   Title: LogosDoubleHeadlineWithGrid
   Description: A double-headline logo grid for React and Next.js with a stacked main and sub headline, a borderless four-column logo grid of twelve marks, and monochrome hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-double-headline-with-grid.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">
        @* Double headline cluster *@
        <div class="mx-auto max-w-4xl text-center">
            <h2 class="text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl">
                @_mainHeadline
            </h2>
            <p class="mt-3 text-xl font-medium leading-snug text-muted-foreground sm:text-2xl">
                @_subHeadline
            </p>
        </div>

        @* Borderless 4-column grid *@
        <ul class="mx-auto mt-14 grid max-w-5xl grid-cols-2 gap-x-10 gap-y-10 sm:grid-cols-3 lg:grid-cols-4">
            @foreach (var logo in _logos)
            {
                <li class="flex items-center justify-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private const string _mainHeadline = "The teams shipping every day.";
    private const string _subHeadline = "And trusting our platform with their production workloads.";

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",     "shield"),
        new("l2",  "Northwind",  "compass"),
        new("l3",  "Ion",        "atom"),
        new("l4",  "Rookery",    "feather"),
        new("l5",  "LaunchPad",  "rocket"),
        new("l6",  "Loam",       "tree-pine"),
        new("l7",  "Strata",     "layers"),
        new("l8",  "Honeycomb",  "hexagon"),
        new("l9",  "Bastion",    "key"),
        new("l10", "Telemark",   "mountain"),
        new("l11", "Codex",      "book"),
        new("l12", "Aperture",   "camera"),
    ];
}
