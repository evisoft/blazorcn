@* ============================================================
   Block: logos-timeline-horizontal-with-logos
   Title: LogosTimelineHorizontalWithLogos
   Description: A horizontal timeline logo block for React and Next.js with a six-node yearly timeline, per-year icon marks above each node, centered baseline rule, and static monochrome logo marks built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-timeline-horizontal-with-logos.tsx
   ============================================================ *@

<section aria-label="Customer timeline by year" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer milestones
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                From 2019 to today.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Six years of teams shipping with us, one marquee customer at a time. Here is when each
                of our flagship accounts came onboard.
            </p>
        </div>

        @* Timeline *@
        <div class="relative mt-14 sm:mt-20">
            <ol class="relative grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-6 sm:gap-x-4 sm:gap-y-0">
                @foreach (var node in _timeline)
                {
                    <li class="group relative flex cursor-default flex-col items-center">

                        @* Logo mark above the node: icon cell + wordmark *@
                        <div class="flex flex-col items-center gap-2.5">
                            <div class="flex size-12 shrink-0 items-center justify-center rounded-full border bg-card text-muted-foreground shadow-sm transition-all duration-200 group-hover:-translate-y-0.5 group-hover:border-foreground/30 group-hover:text-foreground">
                                <LucideIconCn Name="@node.IconName" Size="20" Class="size-5" aria-hidden="true" />
                            </div>
                            <span class="text-sm font-semibold text-foreground">@node.Name</span>
                        </div>

                        @* Spacer that positions the dot on the baseline rule *@
                        <div class="relative mt-5 h-3 w-full sm:mt-6">
                            @* Horizontal rule segment (hidden at the edges) *@
                            <span
                                aria-hidden="true"
                                class="absolute left-0 right-0 top-1/2 hidden h-px -translate-y-1/2 bg-border sm:block"
                            ></span>
                            @* Pin dot with ring *@
                            <span
                                aria-hidden="true"
                                class="absolute left-1/2 top-1/2 size-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-foreground ring-4 ring-background transition-transform duration-200 group-hover:scale-125"
                            ></span>
                        </div>

                        @* Year label *@
                        <span class="mt-3 text-xs font-medium uppercase tracking-wider tabular-nums text-muted-foreground transition-colors group-hover:text-foreground">
                            @node.Year
                        </span>
                    </li>
                }
            </ol>
        </div>
    </div>
</section>

@code {
    private record TimelineNode(string Id, string Year, string Name, string IconName);

    private static readonly TimelineNode[] _timeline =
    [
        new("n1", "2019", "Halide",     "shield"),
        new("n2", "2020", "Northwind",  "compass"),
        new("n3", "2021", "Ion",        "atom"),
        new("n4", "2022", "Summit",     "mountain"),
        new("n5", "2023", "Honeycomb",  "hexagon"),
        new("n6", "2024", "LaunchPad",  "rocket"),
    ];
}
