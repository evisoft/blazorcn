@* ============================================================
   Block: logos-global-presence-dot-grid-map
   Title: LogosGlobalPresenceDotGridMap
   Description: A global presence dot grid map logo block for React and Next.js with a quiet radial dot pattern map canvas, six prominent pin badges with ring outlines and reduced-motion-aware pulse rings, and pill-style region chips below the map built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-global-presence-dot-grid-map.tsx
   ============================================================ *@

<style>
    @@keyframes logos-global-pin-pulse {
        0% { transform: scale(1); opacity: 0.5; }
        80% { transform: scale(2.2); opacity: 0; }
        100% { transform: scale(2.2); opacity: 0; }
    }
    .logos-global-pin-pulse {
        animation: logos-global-pin-pulse 2.6s ease-out infinite;
    }
    @@media (prefers-reduced-motion: reduce) {
        .logos-global-pin-pulse {
            animation: none;
            opacity: 0;
        }
    }
</style>

<section aria-label="Global customer presence map" class="mx-auto w-full max-w-4xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Global customer footprint
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Teams on every continent ship with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From São Paulo to Singapore, from Cape Town to Stockholm — engineering teams in
                forty-two countries rely on our platform in production every day.
            </p>
        </div>

        @* Map canvas *@
        <div
            role="img"
            aria-label="World map showing customer regions"
            class="relative mt-12 aspect-[16/9] overflow-hidden rounded-2xl border bg-card">

            @* Quiet dot pattern background *@
            <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 opacity-40"
                style="background-image: radial-gradient(circle, var(--muted-foreground) 1px, transparent 1px); background-size: 14px 14px;">
            </div>

            @* Subtle equator guide *@
            <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-x-8 top-1/2 h-px border-t border-dashed border-border/60">
            </div>

            @* Subtle meridian guide *@
            <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-y-8 left-1/2 w-px border-l border-dashed border-border/60">
            </div>

            @* Corner location count chip *@
            <div class="pointer-events-none absolute left-4 top-4 inline-flex items-center gap-1.5 rounded-full border bg-background/90 px-2.5 py-1 text-[11px] font-medium text-muted-foreground backdrop-blur-sm">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                42 countries · 6 continents
            </div>

            @* Overlaid logo pins *@
            @foreach (var pin in _pins)
            {
                <div
                    key="@pin.Id"
                    title="@pin.Name"
                    class="group absolute -translate-x-1/2 -translate-y-1/2"
                    style="@($"top:{pin.Top}; left:{pin.Left}")">

                    @* Pulse halo *@
                    <span aria-hidden="true" class="logos-global-pin-pulse absolute inset-0 rounded-full bg-foreground/30"></span>

                    @* Pin badge *@
                    <div class="relative flex size-10 items-center justify-center rounded-full bg-foreground text-background shadow-md ring-4 ring-background transition-transform duration-200 group-hover:scale-110 motion-reduce:group-hover:scale-100">
                        <LucideIconCn Name="@pin.IconName" Size="16" Class="size-4" aria-hidden="true" />
                    </div>
                    <span class="sr-only">@pin.Name</span>
                </div>
            }
        </div>

        @* Region chips *@
        <ul aria-label="Regions served" class="mt-8 flex flex-wrap items-center justify-center gap-2">
            @foreach (var region in _regions)
            {
                <li>
                    <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground transition-colors hover:border-foreground/20 hover:text-foreground">
                        <span aria-hidden="true" class="size-1.5 rounded-full bg-foreground/60"></span>
                        @region
                    </span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record PinData(string Id, string Name, string Region, string IconName, string Top, string Left);

    private static readonly PinData[] _pins =
    [
        new("p1", "Atlas",   "North America", "globe",     "32%", "20%"),
        new("p2", "Halide",  "Europe",        "shield",    "26%", "50%"),
        new("p3", "Meridian","APAC",          "compass",   "34%", "76%"),
        new("p4", "Loam",    "Africa",        "tree-pine", "60%", "54%"),
        new("p5", "Summit",  "LATAM",         "mountain",  "68%", "32%"),
        new("p6", "Ion",     "Oceania",       "atom",      "70%", "82%"),
    ];

    private static readonly string[] _regions =
    [
        "North America",
        "Europe",
        "APAC",
        "LATAM",
        "Africa",
        "Oceania",
    ];
}
