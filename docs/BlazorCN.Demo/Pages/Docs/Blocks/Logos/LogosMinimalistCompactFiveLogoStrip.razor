@* ============================================================
   Block: logos-minimalist-compact-five-logo-strip
   Title: LogosMinimalistCompactFiveLogoStrip
   Description: A bare minimum compact five logo strip for React and Next.js with a tight eyebrow, no dividers, no subtitle, and monochrome-to-color hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-minimalist-compact-five-logo-strip.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-4xl p-4">
    <div class="py-8 sm:py-12">
        @* Eyebrow-only — Minimalist Strip archetype *@
        <p class="text-center text-xs font-medium uppercase tracking-widest text-muted-foreground">
            @_eyebrow
        </p>

        @* Bare minimum compact five-logo strip — confident, not squished *@
        <ul aria-label="Customer logos" class="mt-7 flex flex-wrap items-center justify-center gap-x-8 gap-y-5">
            @foreach (var logo in _logos)
            {
                <li class="flex items-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private const string _eyebrow = "Shipping with";

    private static readonly Logo[] _logos =
    [
        new("l1", "Bastion",   "shield"),
        new("l2", "Meridian",  "compass"),
        new("l3", "Lodestar",  "star"),
        new("l4", "Strata",    "layers"),
        new("l5", "Honeycomb", "hexagon"),
    ];
}
