@* ============================================================
   Block: logos-split-headline-monogram-grid
   Title: LogosSplitHeadlineMonogramGrid
   Description: A split headline monogram grid logo block for React and Next.js with a left-side marketing headline cluster, a right-side three by three monogram tile grid using font-mono initials, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-split-headline-monogram-grid.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">
        <div class="grid items-center gap-12 lg:grid-cols-[5fr_6fr]">
            @* Left: headline cluster *@
            <div class="text-center lg:text-left">
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    Trusted partners
                </p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight leading-[1.1] sm:text-4xl lg:text-5xl">
                    Teams that move fast.
                </h2>
                <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground lg:mx-0">
                    Nine of the industry's most respected engineering teams build on our platform every
                    day — from two-person startups to public companies.
                </p>

                <div class="mt-5 flex justify-center lg:justify-start">
                    <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/30 px-2.5 py-0.5 text-[11px] font-medium text-muted-foreground">
                        <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="tabular-nums">9</span> partner teams
                    </span>
                </div>

                <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center lg:justify-start">
                    <ButtonCn Class="w-full sm:w-[180px]">Book a demo</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[240px]">
                        Read case studies
                    </ButtonCn>
                </div>
            </div>

            @* Right: 3x3 monogram tile grid *@
            <ul aria-label="Customer brands" class="mx-auto grid grid-cols-3 gap-4 sm:gap-5">
                @foreach (var logo in _logos)
                {
                    <li>
                        <div
                            role="img"
                            aria-label="@logo.Name"
                            class="group flex size-20 items-center justify-center rounded-xl border bg-card text-muted-foreground transition-colors duration-200 hover:border-foreground/20 hover:text-foreground">
                            <span class="font-mono text-base font-bold transition-transform duration-200 group-hover:rotate-3">
                                @logo.Monogram
                            </span>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string Monogram);

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",     "HA"),
        new("l2", "Northwind",  "NW"),
        new("l3", "Ion",        "IO"),
        new("l4", "LaunchPad",  "LP"),
        new("l5", "Lumen",      "LU"),
        new("l6", "Strata",     "ST"),
        new("l7", "Honeycomb",  "HC"),
        new("l8", "Summit",     "SM"),
        new("l9", "Zephyr",     "ZE"),
    ];
}
