@* ============================================================
   Block: logos-static-grid-wall-square-cells
   Title: LogosStaticGridWallSquareCells
   Description: A static grid wall logo block for React and Next.js with twelve bordered square aspect cells arranged in a two-to-four column grid, stacked icon plus wordmark layout, and monochrome-to-color hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-static-grid-wall-square-cells.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Flagship customers
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Twelve teams that define the standard.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A curated roster of twelve flagship engineering teams whose production deployments set
                the bar for every customer that follows.
            </p>
        </div>

        @* Square-cell grid wall *@
        <ul class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4">
            @foreach (var logo in _logos)
            {
                <li class="group flex aspect-square flex-col items-center justify-center gap-2 rounded-2xl border bg-card text-muted-foreground transition-colors duration-200 hover:border-foreground/20 hover:bg-card/80 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="32" Class="size-8 shrink-0 transition-transform duration-200 group-hover:scale-110" aria-hidden="true" />
                    <span class="text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>

    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",    "shield"),
        new("l2",  "Northwind", "compass"),
        new("l3",  "Ion",       "atom"),
        new("l4",  "LaunchPad", "rocket"),
        new("l5",  "Lumen",     "star"),
        new("l6",  "Strata",    "layers"),
        new("l7",  "Telemark",  "mountain"),
        new("l8",  "Bastion",   "key"),
        new("l9",  "Honeycomb", "hexagon"),
        new("l10", "Loam",      "tree-pine"),
        new("l11", "Ember",     "flame"),
        new("l12", "Facet",     "gem"),
    ];
}
