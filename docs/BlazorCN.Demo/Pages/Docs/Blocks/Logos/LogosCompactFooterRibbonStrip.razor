@* ============================================================
   Block: logos-compact-footer-ribbon-strip
   Title: LogosCompactFooterRibbonStrip
   Description: An ultra minimal footer ribbon logo strip for React and Next.js with an eyebrow left split, eight compact logo marks, and a horizontal flex-wrap layout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-compact-footer-ribbon-strip.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="flex flex-col items-center gap-6 border-y border-dashed border-border/60 py-8 md:flex-row md:gap-12 md:py-10">
        <p class="inline-flex shrink-0 items-center gap-2 text-xs font-medium uppercase tracking-widest text-muted-foreground md:border-r md:pr-12">
            <span>@_eyebrow</span>
            <span aria-hidden="true" class="text-muted-foreground/40">
                ·
            </span>
            <span class="tabular-nums normal-case tracking-normal">@_logos.Length partners</span>
        </p>
        <ul class="flex flex-wrap items-center justify-center gap-x-10 gap-y-5 md:justify-start md:gap-x-12">
            @foreach (var logo in _logos)
            {
                <li class="flex items-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private const string _eyebrow = "In good company";

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "LaunchPad", "rocket"),
        new("l5", "Loam",      "tree-pine"),
        new("l6", "Strata",    "layers"),
        new("l7", "Honeycomb", "hexagon"),
        new("l8", "Telemark",  "mountain"),
    ];
}
