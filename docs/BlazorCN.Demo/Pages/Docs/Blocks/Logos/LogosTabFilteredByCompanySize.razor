@* ============================================================
   Block: logos-tab-filtered-by-company-size
   Title: LogosTabFilteredByCompanySize
   Description: A company size tab-filtered logo grid for React and Next.js with four pill tabs covering All, Startups, Mid-Market, and Enterprise, balanced eight-logo rosters per tab, a reserved minimum grid height that prevents layout shift, and AnimatePresence crossfade between sizes built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-tab-filtered-by-company-size.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Scales with your team
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Every team size ships with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From two-person weekend startups to Fortune 100 platform teams — filter to see the
                customers that look like your org chart.
            </p>
        </div>

        @* Pill tabs *@
        <nav aria-label="Filter logos by company size" class="mt-10 flex justify-center">
            <div role="tablist" class="inline-flex items-center gap-1 rounded-full border bg-muted/50 p-1">
                @foreach (var sizeTab in _sizes)
                {
                    var tab = sizeTab;
                    var isActive = _active == tab.Id;
                    <button
                        type="button"
                        role="tab"
                        aria-selected="@isActive"
                        aria-controls="logos-size-grid"
                        @onclick="@(() => SetActive(tab.Id))"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-semibold transition-colors duration-200", isActive ? "border border-border bg-background text-foreground shadow-sm" : "border border-transparent text-muted-foreground hover:text-foreground")">
                        @tab.Label
                    </button>
                }
            </div>
        </nav>

        @* Filtered grid with reserved min-height *@
        <div id="logos-size-grid" class="mt-10 min-h-[240px] sm:min-h-[200px]">
            <ul aria-label="@($"Customer logos for {(_active == "all" ? "all company sizes" : _active)}")" class="grid grid-cols-2 gap-6 sm:grid-cols-4 sm:gap-8">
                @foreach (var logo in GetLogosForSize(_active))
                {
                    <li class="group flex h-20 items-center justify-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                        <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0 transition-transform group-hover:rotate-3" aria-hidden="true" />
                        <span class="text-sm font-semibold whitespace-nowrap">@logo.Name</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

@code {
    private record SizeTabData(string Id, string Label);
    private record LogoData(string Id, string Name, string IconName, string Size, bool Featured = false);

    private static readonly SizeTabData[] _sizes =
    [
        new("all",        "All"),
        new("startup",    "Startups"),
        new("mid",        "Mid-Market"),
        new("enterprise", "Enterprise"),
    ];

    private static readonly LogoData[] _logos =
    [
        // Startups — 8
        new("l1",  "LaunchPad", "rocket",    "startup",    true),
        new("l2",  "Glimmer",   "sparkles",  "startup",    true),
        new("l3",  "Ion",       "atom",      "startup"),
        new("l4",  "Ember",     "flame",     "startup"),
        new("l5",  "Facet",     "gem",       "startup"),
        new("l6",  "Rookery",   "feather",   "startup"),
        new("l7",  "Lumen",     "star",      "startup"),
        new("l8",  "Zephyr",    "wind",      "startup"),
        // Mid-Market — 8
        new("l9",  "Meridian",  "compass",   "mid",        true),
        new("l10", "Honeycomb", "hexagon",   "mid",        true),
        new("l11", "Strata",    "layers",    "mid"),
        new("l12", "Codex",     "book",      "mid"),
        new("l13", "Tidal",     "waves",     "mid"),
        new("l14", "Nucleo",    "atom",      "mid"),
        new("l15", "Solaris",   "sun",       "mid"),
        new("l16", "Nocturne",  "moon",      "mid"),
        // Enterprise — 8
        new("l17", "Halide",    "shield",    "enterprise", true),
        new("l18", "Atlas",     "globe",     "enterprise", true),
        new("l19", "Bastion",   "key",       "enterprise"),
        new("l20", "Summit",    "mountain",  "enterprise"),
        new("l21", "Citadel",   "shield",    "enterprise"),
        new("l22", "Telemark",  "mountain",  "enterprise"),
        new("l23", "Aquifer",   "droplets",  "enterprise"),
        new("l24", "Evergreen", "tree-pine", "enterprise"),
    ];

    private string _active = "all";

    private void SetActive(string sizeId)
    {
        _active = sizeId;
    }

    private static LogoData[] GetLogosForSize(string active)
    {
        if (active == "all")
        {
            var featured = Array.FindAll(_logos, l => l.Featured);
            var fillers = Array.FindAll(_logos, l => !l.Featured);
            var combined = new List<LogoData>(featured);
            for (var i = 0; combined.Count < 8 && i < fillers.Length; i++)
                combined.Add(fillers[i]);
            return combined.Count > 8
                ? combined.GetRange(0, 8).ToArray()
                : combined.ToArray();
        }
        var sizeLogos = Array.FindAll(_logos, l => l.Size == active);
        return sizeLogos.Length > 8
            ? sizeLogos[..8]
            : sizeLogos;
    }
}
