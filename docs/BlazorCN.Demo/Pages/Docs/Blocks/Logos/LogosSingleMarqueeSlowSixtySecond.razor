@* ============================================================
   Block: logos-single-marquee-slow-sixty-second
   Title: LogosSingleMarqueeSlowSixtySecond
   Description: A calm single row logo marquee for React and Next.js with a slow sixty second loop duration, fourteen placeholder brand marks, subdued muted-foreground default color, gradient edge masks, and a prefers-reduced-motion CSS guard built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-single-marquee-slow-sixty-second.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <style>
        @@keyframes logos-slow-calm-marquee-left {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }
        @@media (prefers-reduced-motion: reduce) {
            [data-logos-slow-marquee="true"] {
                animation: none !important;
                transform: none !important;
            }
        }
    </style>

    <div class="py-12 sm:py-16">
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                A considered roster
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Built for teams who refuse to rush.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Fourteen placeholder brands on a deliberate sixty second loop — the pace matches the
                mindset of teams who value considered work over frenetic output.
            </p>
        </div>

        @* Slow single marquee row *@
        <div aria-hidden="true" class="relative mt-12 overflow-hidden py-4">
            @* Gradient edge masks *@
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent sm:w-40"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40"></div>

            <div class="flex">
                <div
                    data-logos-slow-marquee="true"
                    class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                    style="animation: logos-slow-calm-marquee-left 60s linear infinite;">
                    @foreach (var logo in _doubled)
                    {
                        <div class="flex items-center gap-2.5 text-muted-foreground/80 transition-colors duration-200 hover:text-foreground">
                            <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                            <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",      "shield"),
        new("l2",  "Northwind",   "compass"),
        new("l3",  "Valence",     "atom"),
        new("l4",  "Quill",       "feather"),
        new("l5",  "Apogee",      "rocket"),
        new("l6",  "Heartwood",   "tree-pine"),
        new("l7",  "Bedrock",     "layers"),
        new("l8",  "Lattice",     "hexagon"),
        new("l9",  "Latchkey",    "key"),
        new("l10", "Ridgeline",   "mountain"),
        new("l11", "Hearth",      "flame"),
        new("l12", "Wellspring",  "droplets"),
        new("l13", "Lapidary",    "gem"),
        new("l14", "Marginalia",  "book"),
    ];

    private static readonly Logo[] _doubled = [.._logos, .._logos];
}
