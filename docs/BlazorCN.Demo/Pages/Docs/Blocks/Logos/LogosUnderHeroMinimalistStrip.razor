@* ============================================================
   Block: logos-under-hero-minimalist-strip
   Title: LogosUnderHeroMinimalistStrip
   Description: A single row under-hero minimalist logo strip for React and Next.js with an eyebrow-only headline, flex-wrap layout, monochrome-to-color hover, and zero widget chrome built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-under-hero-minimalist-strip.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-4xl p-4">
    <div class="py-8 sm:py-12">
        @* Eyebrow only — no headline, no subtitle (archetype A) *@
        <div class="text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted by teams at
            </p>
        </div>

        @* Single-row flex-wrap strip *@
        <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
            @foreach (var logo in _logos)
            {
                <li class="flex items-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "Rookery",   "feather"),
        new("l5", "Strata",    "layers"),
        new("l6", "Honeycomb", "hexagon"),
    ];
}
