@* ============================================================
   Block: logos-underhero-with-trust-eyebrow
   Title: LogosUnderheroWithTrustEyebrow
   Description: An under hero minimalist logo strip for React and Next.js with an uppercase trust eyebrow, secondary trust indicator row featuring rating, count, and compliance, and a six mark flex wrap logo row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-underhero-with-trust-eyebrow.tsx
   ============================================================ *@

<section aria-label="Under hero customer logos" class="mx-auto w-full max-w-4xl p-4">
    <div class="py-8 sm:py-12">
        @* Trust eyebrow cluster *@
        <div class="flex flex-col items-center gap-2 text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted by teams at
            </p>

            <ul aria-label="Trust indicators" class="flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-xs text-muted-foreground">
                <li aria-label="Rated 4.9 out of 5" class="inline-flex items-center gap-1">
                    <span aria-hidden="true" class="text-amber-500">★</span>
                    <span class="tabular-nums">4.9/5</span>
                </li>
                @foreach (var indicator in _trustIndicators)
                {
                    <li class="inline-flex items-center gap-2.5">
                        <span aria-hidden="true" class="text-muted-foreground/50">·</span>
                        <span>@indicator</span>
                    </li>
                }
            </ul>
        </div>

        @* Logo row *@
        <ul aria-label="Customer logos" class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-4 sm:gap-x-10">
            @foreach (var logo in _logos)
            {
                <li class="flex items-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    // TRUST_INDICATORS.slice(1) — skip the first "4.9/5" entry (rendered inline above)
    private static readonly string[] _trustIndicators = ["12,000+ teams", "SOC 2 certified"];

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "Rookery",   "feather"),
        new("l5", "LaunchPad", "rocket"),
        new("l6", "Honeycomb", "hexagon"),
    ];
}
