@* ============================================================
   Block: logos-stacked-rows-with-category-labels
   Title: LogosStackedRowsWithCategoryLabels
   Description: A category-labeled stacked logo rows block for React and Next.js with three industry-tagged horizontal strips, uppercase row labels, and monochrome hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-stacked-rows-with-category-labels.tsx
   ============================================================ *@

<section aria-label="Customer logos grouped by industry" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Across every vertical
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Teams in every industry ship with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From regulated fintech to developer platforms to climate tech, our platform powers
                production workloads across sectors.
            </p>
        </div>

        @* Stacked rows *@
        <div class="mt-14 space-y-10">
            @foreach (var rowItem in _rows)
            {
                var row = rowItem;
                var rowIndex = System.Array.IndexOf(_rows, row);
                <div class="@Cn.Merge("grid items-center gap-6 lg:grid-cols-[120px_1fr]", rowIndex > 0 ? "border-t border-dashed border-border/40 pt-10" : "")">
                    <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">
                        @row.Label
                    </p>
                    <ul class="flex flex-wrap items-center gap-x-8 gap-y-4">
                        @foreach (var logo in row.Logos)
                        {
                            <li class="flex items-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                                <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record LogoData(string Id, string Name, string IconName);
    private record RowData(string Id, string Label, LogoData[] Logos);

    private static readonly RowData[] _rows =
    [
        new("fintech", "Fintech",
        [
            new("f1", "Telemark", "mountain"),
            new("f2", "Bastion",  "key"),
            new("f3", "Bedrock",  "layers"),
            new("f4", "Facet",    "gem"),
            new("f5", "Halide",   "shield"),
        ]),
        new("devtools", "Dev Tools",
        [
            new("d1", "LaunchPad",  "rocket"),
            new("d2", "Ion",        "atom"),
            new("d3", "Honeycomb",  "hexagon"),
            new("d4", "Northwind",  "compass"),
        ]),
        new("climate", "Climate",
        [
            new("c1", "Loam",    "tree-pine"),
            new("c2", "Tidal",   "waves"),
            new("c3", "Zephyr",  "wind"),
            new("c4", "Aquifer", "droplets"),
            new("c5", "Ember",   "flame"),
        ]),
    ];
}
