@* ============================================================
   Block: logos-regional-breakdown-rows
   Title: LogosRegionalBreakdownRows
   Description: A regional breakdown logo rows block for React and Next.js with four region-labeled rows, per-region team counts, a sidecar label column, and monochrome hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-regional-breakdown-rows.tsx
   ============================================================ *@

<section aria-label="Customer logos by region" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Global footprint
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                12,000 teams across four regions.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From Seattle to Stockholm to Singapore, our platform runs in production across every
                major geography.
            </p>
        </div>

        @* Regional rows *@
        <div class="mx-auto mt-14 max-w-5xl">
            @foreach (var region in _regions)
            {
                <div class="group grid items-center gap-6 rounded-lg border-b border-dashed border-border/40 px-3 py-6 -mx-3 transition-colors duration-200 last:border-0 hover:bg-muted/20 lg:grid-cols-[200px_1fr]">
                    <div>
                        <p class="text-2xl font-bold tracking-tight text-foreground">@region.Name</p>
                        <p class="mt-0.5 text-xs tabular-nums text-muted-foreground">@region.Count</p>
                    </div>
                    <ul class="flex flex-wrap items-center gap-x-8 gap-y-4">
                        @foreach (var logo in region.Logos)
                        {
                            <li class="flex items-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                                <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record LogoData(string Id, string Name, string IconName);
    private record RegionData(string Id, string Name, string Count, LogoData[] Logos);

    private static readonly RegionData[] _regions =
    [
        new("na", "North America", "4,200 teams",
        [
            new("na1", "Halide",    "shield"),
            new("na2", "LaunchPad", "rocket"),
            new("na3", "Bastion",   "key"),
            new("na4", "Telemark",  "mountain"),
        ]),
        new("eu", "Europe", "3,800 teams",
        [
            new("eu1", "Northwind", "compass"),
            new("eu2", "Loam",      "tree-pine"),
            new("eu3", "Codex",     "book"),
            new("eu4", "Facet",     "gem"),
        ]),
        new("apac", "APAC", "2,600 teams",
        [
            new("apac1", "Ion",       "atom"),
            new("apac2", "Honeycomb", "hexagon"),
            new("apac3", "Tidal",     "waves"),
            new("apac4", "Aperture",  "camera"),
        ]),
        new("row", "Rest of World", "1,400 teams",
        [
            new("row1", "Strata",   "layers"),
            new("row2", "Rookery",  "feather"),
            new("row3", "Ember",    "flame"),
            new("row4", "Aquifer",  "droplets"),
        ]),
    ];
}
