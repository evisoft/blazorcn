@* ============================================================
   Block: logos-dual-marquee-dark-inset
   Title: LogosDualMarqueeDarkInset
   Description: A dual row infinite marquee logo wall inside a dark inset panel for React and Next.js with opposing scroll directions, inverted headline cluster, foreground edge masks, and reduced-motion handling built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-dual-marquee-dark-inset.tsx
   ============================================================ *@

<style>
    @@keyframes logos-dark-dual-marquee-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    @@keyframes logos-dark-dual-marquee-right {
        from { transform: translateX(-50%); }
        to { transform: translateX(0); }
    }
    @@media (prefers-reduced-motion: reduce) {
        [data-logos-dual-dark="row-one"],
        [data-logos-dual-dark="row-two"] {
            animation: none !important;
            transform: none !important;
        }
    }
</style>

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Dark inset panel *@
        <div class="relative overflow-hidden rounded-2xl bg-foreground px-6 py-14 sm:px-10 sm:py-20">

            @* Inverted headline cluster *@
            <div class="mx-auto max-w-2xl text-center">
                <p class="text-xs font-medium uppercase tracking-widest text-background/40">
                    Trusted by the best
                </p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-background sm:text-4xl lg:text-5xl">
                    Built for teams that ship.
                </h2>
                <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-background/60">
                    Twenty-four flagship engineering teams deploy to production on our platform every
                    single day across every continent and every stack.
                </p>
            </div>

            @* Dual marquee rows *@
            <div aria-hidden="true" class="relative mt-12 overflow-hidden py-4">
                @* Edge masks use from-foreground to fade into the dark panel *@
                <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-16 bg-gradient-to-r from-foreground to-transparent sm:w-28"></div>
                <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-foreground to-transparent sm:w-28"></div>

                <div class="space-y-8">

                    @* Row One — scrolls left, 40s *@
                    <div class="flex">
                        <div data-logos-dual-dark="row-one"
                             class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                             style="animation-name: logos-dark-dual-marquee-left; animation-duration: 40s; animation-timing-function: linear; animation-iteration-count: infinite;">
                            @foreach (var logo in _doubledRowOne)
                            {
                                <div class="flex items-center gap-2.5 text-background/60 transition-colors hover:text-background">
                                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                    <span class="whitespace-nowrap text-sm font-semibold text-background/80 transition-colors hover:text-background">@logo.Name</span>
                                </div>
                            }
                        </div>
                    </div>

                    @* Row Two — scrolls right, 50s *@
                    <div class="flex">
                        <div data-logos-dual-dark="row-two"
                             class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                             style="animation-name: logos-dark-dual-marquee-right; animation-duration: 50s; animation-timing-function: linear; animation-iteration-count: infinite;">
                            @foreach (var logo in _doubledRowTwo)
                            {
                                <div class="flex items-center gap-2.5 text-background/60 transition-colors hover:text-background">
                                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                    <span class="whitespace-nowrap text-sm font-semibold text-background/80 transition-colors hover:text-background">@logo.Name</span>
                                </div>
                            }
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _rowOne =
    [
        new("dr1-1",  "Halide",     "shield"),
        new("dr1-2",  "Northwind",  "compass"),
        new("dr1-3",  "Ion",        "atom"),
        new("dr1-4",  "LaunchPad",  "rocket"),
        new("dr1-5",  "Lumen",      "star"),
        new("dr1-6",  "Loam",       "tree-pine"),
        new("dr1-7",  "Strata",     "layers"),
        new("dr1-8",  "Honeycomb",  "hexagon"),
        new("dr1-9",  "Bastion",    "key"),
        new("dr1-10", "Meridian",   "globe"),
        new("dr1-11", "Ember",      "flame"),
        new("dr1-12", "Rookery",    "feather"),
    ];

    private static readonly Logo[] _rowTwo =
    [
        new("dr2-1",  "Telemark",   "mountain"),
