@* ============================================================
   Block: logos-featured-quote-dark-variant
   Title: LogosFeaturedQuoteDarkVariant
   Description: A dark inset featured quote split logo block for React and Next.js with an inverted palette panel, flagship brand mark, hero-scale blockquote, and attribution figcaption built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-featured-quote-dark-variant.tsx
   ============================================================ *@

<section aria-label="Featured customer logo and quote on dark panel" class="mx-auto w-full max-w-6xl p-4">

    @* Marketing headline cluster (inverted palette mirrors the dark inset below) *@
    <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
            Flagship customer story
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            One quote. One brand. One outcome.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
            When the surrounding page is a sea of white cards, we step into a darker room and let a
            single engineering team carry the proof.
        </p>
    </div>

    @* Dark inset panel *@
    <div class="relative mt-10 overflow-hidden rounded-2xl bg-foreground px-6 py-14 sm:px-10 sm:py-20">

        @* Subtle dotted background texture *@
        <div
            aria-hidden="true"
            class="pointer-events-none absolute inset-0 opacity-[0.06]"
            style="background-image:radial-gradient(circle, var(--background) 1px, transparent 1px);background-size:16px 16px;">
        </div>

        @* Corner accent pill *@
        <div class="pointer-events-none absolute right-6 top-6 inline-flex items-center gap-1.5 rounded-full border border-background/15 bg-background/[0.05] px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-background/60 backdrop-blur-sm">
            <LucideIconCn Name="sparkles" Size="12" Class="size-3" aria-hidden="true" />
            Flagship story
        </div>

        <div class="relative grid items-center gap-12 lg:grid-cols-2 lg:gap-14">

            @* Left — flagship mark + outcome metric + tenure *@
            <div class="flex flex-col items-center text-center lg:items-start lg:pr-8 lg:text-left">
                <div class="flex size-20 items-center justify-center rounded-3xl bg-background text-foreground shadow-sm sm:size-24">
                    <LucideIconCn Name="compass" Size="48" Class="size-12 sm:size-14" aria-hidden="true" />
                </div>
                <p class="mt-6 text-3xl font-bold tracking-tight text-background sm:text-4xl">
                    @_featured.Name
                </p>
                <p class="mt-1.5 text-xs text-background/55">@_featured.Tenure</p>

                @* Outcome metric card *@
                <dl class="mt-8 w-full max-w-[260px] rounded-2xl border border-background/15 bg-background/[0.05] px-5 py-4 backdrop-blur-sm lg:max-w-xs">
                    <dt class="text-[11px] font-medium uppercase tracking-wider text-background/55">
                        Outcome
                    </dt>
                    <dd class="mt-1 flex items-baseline gap-1">
                        <span class="text-3xl font-bold tabular-nums tracking-tight text-background sm:text-4xl">
                            @_featured.MetricValue
                        </span>
                        <span class="text-2xl font-bold text-background/60 sm:text-3xl">
                            @_featured.MetricSuffix
                        </span>
                        <span class="ml-2 text-xs font-medium text-background/70">
                            @_featured.MetricLabel
                        </span>
                    </dd>
                </dl>
            </div>

            @* Right — semantic quote *@
            <figure class="lg:border-l lg:border-dashed lg:border-background/20 lg:pl-12">
                <blockquote class="text-xl font-medium leading-relaxed text-background sm:text-2xl">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>
                <figcaption class="mt-8 flex items-center gap-4 border-t border-dashed border-background/15 pt-6">
                    <div
                        aria-hidden="true"
                        class="flex size-12 shrink-0 items-center justify-center rounded-full border border-background/20 bg-background/10 font-mono text-sm font-semibold text-background">
                        @_featured.AuthorInitials
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-background">@_featured.AuthorName</p>
                        <p class="text-xs text-background/60">@_featured.AuthorRole</p>
                    </div>
                </figcaption>
            </figure>

        </div>
    </div>

</section>

@code {
    private record FeaturedItem(
        string Name,
        string Quote,
        string AuthorName,
        string AuthorRole,
        string AuthorInitials,
        string MetricValue,
        string MetricSuffix,
        string MetricLabel,
        string Tenure
    );

    private static readonly FeaturedItem _featured = new(
        "Northwind",
        "We shipped five years of backlog in three months. The team still debates whether it was the platform or finally having a pipeline that didn't fight us.",
        "Marcus Okonkwo",
        "VP of Engineering · Northwind",
        "MO",
        "91",
        "%",
        "Faster deploys",
        "Customer since 2019 · 480+ engineers"
    );
}
