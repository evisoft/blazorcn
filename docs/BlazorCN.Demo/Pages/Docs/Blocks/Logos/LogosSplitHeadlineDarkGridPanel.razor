@* ============================================================
   Block: logos-split-headline-dark-grid-panel
   Title: LogosSplitHeadlineDarkGridPanel
   Description: A split layout logo block for React and Next.js with a left-aligned hero-scale headline on light background paired with a right-side dark inset logo grid panel featuring inverted colors, six cells, and split directional entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-split-headline-dark-grid-panel.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="grid items-center gap-12 py-12 sm:py-16 lg:grid-cols-[5fr_6fr] lg:gap-16">

        @* Left — headline cluster on light background *@
        <div>
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Premium platform
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight leading-[1.1] sm:text-4xl lg:text-5xl">
                A premium platform
                <br class="hidden sm:block" /> for teams that ship.
            </h2>
            <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Six flagship customers chose us after year-long evaluations against every competitor in
                the category — and stayed after the honeymoon phase.
            </p>

            <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                <ButtonCn Class="w-full sm:w-[240px]">Read case studies</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">
                    Book a demo
                </ButtonCn>
            </div>
        </div>

        @* Right — dark inset logo panel *@
        <div class="rounded-2xl bg-foreground px-6 py-10 sm:px-8 sm:py-12">
            <ul aria-label="Customer logos" class="grid grid-cols-2 gap-4 sm:grid-cols-3">
                @foreach (var logo in _logos)
                {
                    <li class="group flex h-24 items-center justify-center gap-2.5 rounded-xl border border-background/15 bg-background/[0.05] text-background/60 transition-colors duration-200 hover:border-background/30 hover:bg-background/[0.08] hover:text-background">
                        <LucideIconCn Name="@logo.IconName" Size="32" Class="size-8 shrink-0 transition-colors duration-200 group-hover:text-background" aria-hidden="true" />
                        <span class="text-base font-semibold whitespace-nowrap transition-colors duration-200 group-hover:text-background">@logo.Name</span>
                    </li>
                }
            </ul>
        </div>

    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "LaunchPad", "rocket"),
        new("l5", "Lumen",     "star"),
        new("l6", "Strata",    "layers"),
    ];
}
