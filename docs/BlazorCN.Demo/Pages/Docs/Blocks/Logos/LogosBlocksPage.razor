        new(""l24"", ""Polaris"",   ""star"",      ""apac""),
    ];

    private string _active = ""all"";

    private RegionTab ActiveTab => Array.Find(_regions, r => r.Id == _active) ?? _regions[0];

    private void SetActive(string regionId)
    {
        _active = regionId;
    }

    private static LogoData[] GetLogosForRegion(string active)
    {
        if (active == ""all"")
        {
            var featured = Array.FindAll(_logos, l => l.Featured);
            var fillers = Array.FindAll(_logos, l => !l.Featured);
            var combined = new List<LogoData>(featured);
            for (var i = 0; combined.Count < 8 && i < fillers.Length; i++)
                combined.Add(fillers[i]);
            return combined.Count > 8
                ? combined.GetRange(0, 8).ToArray()
                : combined.ToArray();
        }
        var regionLogos = Array.FindAll(_logos, l => l.Region == active);
        return regionLogos.Length > 8
            ? regionLogos[..8]
            : regionLogos;
    }
}";

