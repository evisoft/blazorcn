@code {
    private record Logo(string Id, string Name, string IconName);

    private const int MetricTarget = 12000;
    private const int AnimationFrames = 60;

    private static readonly Logo[] _allLogos =
    [
        new(""l1"", ""Halide"",     ""shield""),
        new(""l2"", ""Northwind"",  ""compass""),
        new(""l3"", ""Ion"",        ""atom""),
        new(""l4"", ""Rookery"",    ""feather""),
        new(""l5"", ""LaunchPad"",  ""rocket""),
        new(""l6"", ""Loam"",       ""tree-pine""),
        new(""l7"", ""Strata"",     ""layers""),
        new(""l8"", ""Honeycomb"",  ""hexagon""),
        new(""l9"", ""Bastion"",    ""key""),
    ];

    // Show first 8 logos (matching TSX: LOGOS.slice(0, 8))
    private static readonly Logo[] _logos = _allLogos[..8];

    private int _count = 0;
    private int _frame = 0;
    private System.Threading.Timer? _timer;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;

        var frameIntervalMs = 1200 / AnimationFrames; // 20 ms per frame

        _timer = new System.Threading.Timer(_ =>
        {
            _frame += 1;
            if (_frame >= AnimationFrames)
            {
                _count = MetricTarget;
                _timer?.Change(System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
            }
            else
            {
                _count = (int)((MetricTarget / (double)AnimationFrames) * _frame);
            }
            InvokeAsync(StateHasChanged);
        }, null, frameIntervalMs, frameIntervalMs);
    }

    public async ValueTask DisposeAsync()
    {
        if (_timer is not null)
        {
            await _timer.DisposeAsync();
        }
    }
}";

