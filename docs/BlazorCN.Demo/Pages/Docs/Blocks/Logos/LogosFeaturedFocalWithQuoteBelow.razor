@* ============================================================
   Block: logos-featured-focal-with-quote-below
   Title: LogosFeaturedFocalWithQuoteBelow
   Description: A featured focal logo block for React and Next.js with a flagship card on top, a stacked dashed divider, and a customer quote card below containing a blockquote plus figcaption attribution built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-featured-focal-with-quote-below.tsx
   ============================================================ *@

<section aria-label="Flagship partner" class="mx-auto w-full max-w-4xl p-4">
    <div class="py-14 sm:py-20">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Flagship partnership
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Anchored by teams who ship.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Our platform is anchored by a flagship partnership — and the engineers behind it aren't
                shy about why.
            </p>
        </div>

        @* Central flagship card *@
        <div class="relative mx-auto mt-14 flex max-w-md flex-col items-center rounded-3xl border-2 border-foreground/15 bg-card px-10 py-12 shadow-md">
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                @_featured.PartnershipLabel
            </span>

            <div class="mt-6 flex size-24 items-center justify-center rounded-3xl bg-foreground text-background shadow-sm">
                <LucideIconCn Name="@_featured.IconName" Size="56" Class="size-14" aria-hidden="true" />
            </div>

            <p class="mt-6 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_featured.Name
            </p>

            <p class="mt-3 text-sm text-muted-foreground">@_featured.TenureMetric</p>
        </div>

        @* Dashed connecting divider with centered label *@
        <div class="relative mt-12 flex items-center justify-center" aria-hidden="true">
            <div class="h-px w-full border-t border-dashed border-border"></div>
            <span class="absolute bg-background px-4 text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                Hear from them
            </span>
        </div>

        @* Quote card below *@
        <figure class="mt-10 rounded-xl border bg-muted/30 p-6 transition-colors duration-200 hover:border-foreground/20 sm:p-8">
            <blockquote class="text-lg font-medium leading-relaxed text-foreground sm:text-xl">
                &ldquo;@_quote.Text&rdquo;
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-4 border-t border-dashed border-border/60 pt-5">
                <div class="relative flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-full border bg-muted">
                    <span class="font-mono text-sm font-semibold text-muted-foreground">
                        @_quote.Initials
                    </span>
                </div>
                <div>
                    <p class="text-sm font-semibold text-foreground">@_quote.Name</p>
                    <p class="text-xs text-muted-foreground">
                        @_quote.Role · @_quote.Company
                    </p>
                </div>
            </figcaption>
        </figure>
    </div>
</section>

@code {
    private record FeaturedLogo(string Id, string Name, string IconName, string PartnershipLabel, string TenureMetric);
    private record QuoteData(string Text, string Name, string Role, string Company, string Initials);

    private static readonly FeaturedLogo _featured = new(
        "central",
        "Halide",
        "shield",
        "Flagship partner",
        "Since 2019 · 500+ teams built on this"
    );

    private static readonly QuoteData _quote = new(
        "We shipped five years of backlog in three months after standardizing on Halide. The team still debates whether it was the platform or finally having a pipeline that didn't fight us — but the results don't lie.",
        "Sarah Chen",
        "Staff Engineer",
        "Linearly",
        "SC"
    );
}
