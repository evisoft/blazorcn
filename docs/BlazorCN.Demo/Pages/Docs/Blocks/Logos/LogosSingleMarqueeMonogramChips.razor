@* ============================================================
   Block: logos-single-marquee-monogram-chips
   Title: LogosSingleMarqueeMonogramChips
   Description: A single row marquee of bordered monogram chips for React and Next.js with square monogram badges, wordmark labels, gradient edge masks, and a prefers-reduced-motion CSS guard built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-single-marquee-monogram-chips.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <style>
        @@keyframes logos-single-monogram-left {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }
        @@media (prefers-reduced-motion: reduce) {
            [data-logos-single-monogram-marquee="true"] {
                animation: none !important;
                transform: none !important;
            }
        }
    </style>

    <div class="py-12 sm:py-16">
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-widest text-muted-foreground">
                <span aria-hidden="true" class="size-1 rounded-full bg-emerald-500"></span>
                Customer roster
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The brands that trust our platform.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From fintech pioneers to infrastructure veterans, engineering teams across every
                industry ship with confidence using our platform.
            </p>
        </div>

        @* Monogram chip marquee row *@
        <div aria-hidden="true" class="relative mt-12 overflow-hidden py-4">
            @* Gradient edge masks *@
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent sm:w-40"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40"></div>

            <div class="flex">
                <div
                    data-logos-single-monogram-marquee="true"
                    class="flex w-max shrink-0 items-center gap-4 sm:gap-5"
                    style="animation: logos-single-monogram-left 45s linear infinite;">
                    @foreach (var logo in _doubled)
                    {
                        <div class="flex items-center gap-2 rounded-lg border bg-card px-3 py-2 text-muted-foreground transition-colors duration-200 hover:border-foreground/20 hover:bg-muted/50 hover:text-foreground">
                            <span class="flex size-7 shrink-0 items-center justify-center rounded-md bg-muted font-mono text-xs font-bold text-foreground">
                                @logo.Monogram
                            </span>
                            <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string Monogram);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",     "HL"),
        new("l2",  "Northwind",  "NW"),
        new("l3",  "Ion",        "IO"),
        new("l4",  "LaunchPad",  "LP"),
        new("l5",  "Lumen",      "LU"),
        new("l6",  "Loam",       "LM"),
        new("l7",  "Strata",     "ST"),
        new("l8",  "Telemark",   "TM"),
        new("l9",  "Keyring",    "KR"),
        new("l10", "Honeycomb",  "HC"),
        new("l11", "Ember",      "EM"),
        new("l12", "Wellspring", "WS"),
    ];

    private static readonly Logo[] _doubled = [.._logos, .._logos];
}
