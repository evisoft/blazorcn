@* ============================================================
   Block: logos-tab-filtered-dark-variant
   Title: LogosTabFilteredDarkVariant
   Description: A tab-filtered logo grid for React and Next.js wrapped in a dark inverted inset panel with inverted pill tabs, balanced eight-logo rosters per tab, a reserved minimum grid height, AnimatePresence crossfade, and inverted monochrome-to-highlight hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-tab-filtered-dark-variant.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-8 sm:py-12">
        <div class="relative overflow-hidden rounded-2xl bg-foreground px-6 py-14 sm:px-10 sm:py-20">
            @* Corner pill accent *@
            <div aria-hidden="true"
                 class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full border border-background/20 bg-background/10 px-2.5 py-1 text-[11px] font-medium text-background/70 sm:right-6 sm:top-6">
                <span class="size-1.5 rounded-full bg-emerald-400"></span>
                Live in production
            </div>

            @* Inverted headline cluster *@
            <div class="mx-auto max-w-2xl text-center">
                <p class="text-xs font-medium uppercase tracking-widest text-background/60">
                    Trusted across industries
                </p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-background sm:text-4xl lg:text-5xl">
                    Teams in every sector ship with us.
                </h2>
                <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-background/70">
                    From regulated fintech to open-source developer tooling to climate infrastructure —
                    engineering teams trust our platform in production.
                </p>
            </div>

            @* Inverted pill tabs *@
            <nav aria-label="Filter logos by industry" class="mt-10 flex justify-center">
                <div role="tablist"
                     class="inline-flex items-center gap-1 rounded-full border border-background/20 bg-background/10 p-1">
                    @foreach (var cat in _categories)
                    {
                        var catItem = cat;
                        var isActive = _active == catItem.Id;
                        <button type="button"
                                role="tab"
                                aria-selected="@isActive"
                                aria-controls="logos-tab-grid"
                                @onclick="@(() => _active = catItem.Id)"
                                class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-semibold transition-colors", isActive ? "bg-background text-foreground shadow-sm" : "text-background/60 hover:text-background")">
                            @catItem.Label
                        </button>
                    }
                </div>
            </nav>

            @* Filtered grid with reserved min-height *@
            <div id="logos-tab-grid" class="mt-10 min-h-[360px] sm:min-h-[200px]">
                <ul aria-label="@($"Customer logos in {(_active == "all" ? "all industries" : _active)}")"
                    class="grid grid-cols-2 gap-6 sm:grid-cols-4 sm:gap-8">
                    @foreach (var logo in GetLogosForTab(_active))
                    {
                        <li class="group flex h-20 items-center justify-center gap-2.5 rounded-xl border border-background/10 bg-background/[0.04] text-background/60 transition-colors hover:border-background/20 hover:bg-background/[0.08] hover:text-background">
                            <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0 transition-transform group-hover:scale-110" aria-hidden="true" />
                            <span class="text-sm font-semibold whitespace-nowrap">@logo.Name</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</section>

@code {
    private record CategoryTab(string Id, string Label);
    private record Logo(string Id, string Name, string IconName, string Category, bool Featured = false);

    private string _active = "all";

    private static readonly CategoryTab[] _categories =
    [
        new("all",       "All"),
        new("fintech",   "Fintech"),
        new("developer", "Developer"),
        new("climate",   "Climate"),
    ];

    private static readonly Logo[] _logos =
    [
        // Fintech — 8
        new("l1",  "Halide",    "shield",     "fintech",   Featured: true),
        new("l2",  "Bastion",   "key",        "fintech",   Featured: true),
        new("l3",  "Meridian",  "compass",    "fintech"),
        new("l4",  "Strata",    "layers",     "fintech"),
        new("l5",  "Facet",     "gem",        "fintech"),
        new("l6",  "Atlas",     "globe",      "fintech"),
        new("l7",  "Citadel",   "shield",     "fintech"),
        new("l8",  "Lumen",     "star",       "fintech"),
        // Developer — 8
        new("l9",  "Ion",       "atom",       "developer", Featured: true),
        new("l10", "LaunchPad", "rocket",     "developer", Featured: true),
        new("l11", "Honeycomb", "hexagon",    "developer"),
        new("l12", "Nocturne",  "moon",       "developer"),
        new("l13", "Glimmer",   "sparkles",   "developer"),
        new("l14", "Nucleo",    "atom",       "developer"),
        new("l15", "Summit",    "mountain",   "developer"),
        new("l16", "Ember",     "flame",      "developer"),
        // Climate — 8
        new("l17", "Loam",      "tree-pine",  "climate",   Featured: true),
        new("l18", "Rookery",   "feather",    "climate",   Featured: true),
        new("l19", "Telemark",  "mountain",   "climate"),
        new("l20", "Solaris",   "sun",        "climate"),
        new("l21", "Tidal",     "waves",      "climate"),
        new("l22", "Zephyr",    "wind",       "climate"),
        new("l23", "Aquifer",   "droplets",   "climate"),
        new("l24", "Evergreen", "tree-pine",  "climate"),
    ];

    private static Logo[] GetLogosForTab(string active)
    {
        if (active == "all")
        {
            var featured = _logos.Where(l => l.Featured).ToArray();
            var fillers = _logos.Where(l => !l.Featured).Take(8 - featured.Length).ToArray();
            return featured.Concat(fillers).Take(8).ToArray();
        }
        return _logos.Where(l => l.Category == active).Take(8).ToArray();
    }
}
