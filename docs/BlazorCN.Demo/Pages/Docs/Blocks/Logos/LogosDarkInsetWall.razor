@* ============================================================
   Block: logos-dark-inset-wall
   Title: LogosDarkInsetWall
   Description: A dark inset logo wall block for React and Next.js with a rounded bg-foreground inverted panel, sixteen logos in a four-column grid, inverted ShadcnioButton primary and ghost CTAs, and monochrome-to-color hover states using background opacity tiers built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-dark-inset-wall.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="rounded-2xl bg-foreground px-6 py-14 sm:px-10 sm:py-20">
        @* Marketing headline cluster — inverted palette *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-background/40">
                Trusted worldwide
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-background sm:text-4xl lg:text-5xl">
                Teams that refuse to ship slow.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-background/60">
                Sixteen flagship customers span six continents and every stack — deploying thousands of
                times a day on our platform.
            </p>

            <div class="mt-5 inline-flex items-center gap-2 rounded-full border border-background/15 bg-background/[0.08] px-2.5 py-1 text-[11px] font-medium text-background/70">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-400"></span>
                <span class="tabular-nums">16 flagship customers · 6 continents</span>
            </div>
        </div>

        @* Logo grid *@
        <ul class="mt-12 grid grid-cols-2 gap-8 sm:grid-cols-3 sm:gap-10 lg:grid-cols-4">
            @foreach (var logo in _logos)
            {
                <li class="group flex h-20 items-center justify-center gap-2.5 text-background/60 transition-colors duration-200 hover:text-background">
                    <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0 transition-transform duration-200 group-hover:scale-110" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold text-background/80 transition-colors duration-200 group-hover:text-background">@logo.Name</span>
                </li>
            }
        </ul>

        @* CTA pair — dark variant *@
        <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[240px]">
                Read case studies
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[180px]">
                Book a demo
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",     "shield"),
        new("l2",  "Northwind",  "compass"),
        new("l3",  "Ion",        "atom"),
        new("l4",  "Rookery",    "feather"),
        new("l5",  "LaunchPad",  "rocket"),
        new("l6",  "Lumen",      "star"),
        new("l7",  "Loam",       "tree-pine"),
        new("l8",  "Strata",     "layers"),
        new("l9",  "Telemark",   "mountain"),
        new("l10", "Bastion",    "key"),
        new("l11", "Honeycomb",  "hexagon"),
        new("l12", "Meridian",   "globe"),
        new("l13", "Ember",      "flame"),
        new("l14", "Nocturne",   "moon"),
        new("l15", "Solaris",    "sun"),
        new("l16", "Glimmer",    "sparkles"),
    ];
}
