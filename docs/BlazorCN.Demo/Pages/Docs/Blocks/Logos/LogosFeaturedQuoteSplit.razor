@* ============================================================
   Block: logos-featured-quote-split
   Title: LogosFeaturedQuoteSplit
   Description: A featured quote split logo block for React and Next.js with a single flagship logo on the left paired with a customer testimonial on the right, hero-scale wordmark, semantic blockquote, and attribution figcaption built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-featured-quote-split.tsx
   ============================================================ *@

<section aria-label="Featured customer logo and quote" class="mx-auto w-full max-w-6xl p-4">
    <div class="grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-2 lg:gap-16">

        @* Left — large central logo mark *@
        <div class="flex flex-col items-center lg:border-r lg:border-dashed lg:pr-12">
            @* Featured customer pill *@
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                Featured customer
            </span>

            @* Inverted mark container *@
            <div class="mt-6 flex size-20 items-center justify-center rounded-3xl bg-foreground text-background shadow-md sm:size-24">
                <LucideIconCn Name="shield" Size="48" Class="size-12 sm:size-14" aria-hidden="true" />
            </div>

            @* Wordmark *@
            <p class="mt-6 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_featured.Name
            </p>

            @* Tenure metric *@
            <p class="mt-3 text-sm text-muted-foreground">
                Since 2019 · 500+ teams built on this
            </p>
        </div>

        @* Right — semantic quote *@
        <figure>
            <blockquote class="text-xl font-medium leading-relaxed text-foreground sm:text-2xl">
                &ldquo;@_featured.Quote&rdquo;
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-4">
                <div
                    aria-hidden="true"
                    class="flex size-12 shrink-0 items-center justify-center rounded-full border bg-muted font-mono text-sm font-semibold text-muted-foreground">
                    @_featured.AuthorInitials
                </div>
                <div>
                    <p class="text-sm font-semibold text-foreground">@_featured.AuthorName</p>
                    <p class="text-xs text-muted-foreground">@_featured.AuthorRole</p>
                </div>
            </figcaption>
        </figure>

    </div>
</section>

@code {
    private record FeaturedCustomer(
        string Name,
        string Quote,
        string AuthorName,
        string AuthorRole,
        string AuthorInitials
    );

    private static readonly FeaturedCustomer _featured = new(
        "Halide",
        "We cut our p99 latency from 900ms to 80ms in a weekend migration. Our on-call pager has been silent for three months and counting.",
        "Sarah Chen",
        "Staff Engineer · Halide",
        "SC"
    );
}
