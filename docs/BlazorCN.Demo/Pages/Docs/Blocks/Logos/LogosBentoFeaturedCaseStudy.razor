@* ============================================================
   Block: logos-bento-featured-case-study
   Title: LogosBentoFeaturedCaseStudy
   Description: A bento featured case study logo block for React and Next.js with a hero-weight featured cell holding a flagship logo plus quote plus metric plus attribution, four content-rich supporting cells each carrying an industry tag and retention metric, a subtle featured border accent, and monochrome-to-color hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-bento-featured-case-study.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                One weekend. Ninety-one percent faster.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Halide cut latency by an order of magnitude in a single weekend migration — and four
                more teams are on the same path.
            </p>
        </div>

        @* Bento grid: 3 cols x 2 rows, featured spans rows 1-2 on the left *@
        <div class="mt-12 grid gap-4 sm:grid-cols-3 sm:grid-rows-2">

            @* Featured cell — tall, content-rich case study *@
            <figure class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border-2 border-foreground/15 bg-card p-8 shadow-sm sm:col-span-1 sm:row-span-2">

                @* Corner accent *@
                <div aria-hidden="true" class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Case study
                </div>

                @* Top: logo + name + industry *@
                <div>
                    <div class="flex size-14 items-center justify-center rounded-2xl bg-foreground text-background shadow-sm">
                        <LucideIconCn Name="shield" Size="28" Class="size-7" aria-hidden="true" />
                    </div>
                    <p class="mt-5 text-2xl font-bold tracking-tight text-foreground">
                        @_featured.Name
                    </p>
                    <p class="mt-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @_featured.Industry
                    </p>
                </div>

                @* Quote *@
                <blockquote class="mt-6 text-base leading-relaxed text-foreground">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>

                @* Metric highlight strip *@
                <div class="mt-6 flex items-baseline gap-3 border-t pt-5">
                    <p class="text-4xl font-bold tracking-tight tabular-nums text-foreground">
                        @_featured.Metric
                    </p>
                    <p class="text-sm text-muted-foreground">@_featured.MetricLabel</p>
                </div>

                @* Attribution + read more *@
                <div class="mt-5 flex items-end justify-between gap-3 border-t pt-5">
                    <figcaption class="flex min-w-0 items-center gap-3">
                        <div aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full border bg-muted font-mono text-xs font-semibold text-muted-foreground">
                            @_featured.AuthorInitials
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">
                                @_featured.AuthorName
                            </p>
                            <p class="truncate text-xs text-muted-foreground">@_featured.AuthorRole</p>
                        </div>
                    </figcaption>
                    <span aria-hidden="true" class="inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-foreground opacity-60 transition-opacity group-hover:opacity-100">
                        Read
                        <LucideIconCn Name="arrow-up-right" Size="14" Class="size-3.5" />
                    </span>
                </div>
            </figure>

            @* Supporting cells — 4 content-rich cells in a 2x2 layout *@
            @foreach (var logo in _supporting)
            {
                <div class="group flex flex-col justify-between gap-5 rounded-2xl border bg-card p-6 transition-colors hover:border-foreground/20">

                    @* Top: icon + industry pill *@
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex size-11 items-center justify-center rounded-xl border bg-muted/40 text-muted-foreground transition-colors group-hover:border-foreground/20 group-hover:text-foreground">
                            <LucideIconCn Name="@logo.IconName" Size="20" Class="size-5 transition-transform group-hover:scale-110" aria-hidden="true" />
                        </div>
                        <span class="rounded-full border bg-muted/50 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                            @logo.Industry
                        </span>
                    </div>

                    @* Bottom: wordmark + metric *@
                    <div>
                        <p class="text-base font-semibold text-foreground">@logo.Name</p>
                        <p class="mt-1 text-xs tabular-nums text-muted-foreground">@logo.Metric</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FeaturedLogo(
        string Name,
        string Industry,
        string Quote,
        string Metric,
        string MetricLabel,
        string AuthorName,
        string AuthorRole,
        string AuthorInitials
    );

    private record SupportingLogo(string Id, string Name, string IconName, string Industry, string Metric);

    private static readonly FeaturedLogo _featured = new(
        Name: "Halide",
        Industry: "Fintech",
        Quote: "We cut our p99 latency from 900ms to 80ms in a weekend migration. The rollback plan was never needed.",
        Metric: "91%",
        MetricLabel: "latency reduction",
        AuthorName: "Sarah Chen",
        AuthorRole: "Staff Engineer · Halide",
        AuthorInitials: "SC"
    );

    private static readonly SupportingLogo[] _supporting =
    [
        new("s1", "Northwind", "compass",    "Logistics", "12× throughput"),
        new("s2", "Ion",       "atom",       "Dev Tools", "99.99% uptime"),
        new("s3", "Loam",      "tree-pine",  "Climate",   "40+ regions"),
        new("s4", "LaunchPad", "rocket",     "Deploy",    "3.2M deploys"),
    ];
}
