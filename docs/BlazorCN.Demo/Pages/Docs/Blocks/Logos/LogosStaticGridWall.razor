@* ============================================================
   Block: logos-static-grid-wall
   Title: LogosStaticGridWall
   Description: A static grid wall logo block for React and Next.js with eighteen borderless logo cells arranged in a responsive two-to-six column grid, monochrome-to-color hover states, and staggered entrance animation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-static-grid-wall.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted worldwide
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The teams shipping every day.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Engineering teams at eighteen flagship customers trust our platform in production across
                six continents and every stack.
            </p>
        </div>

        @* Static grid wall *@
        <ul class="mt-12 grid grid-cols-2 gap-8 sm:grid-cols-3 sm:gap-10 lg:grid-cols-4 xl:grid-cols-6">
            @foreach (var logo in _logos)
            {
                <li class="group flex h-20 items-center justify-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0 transition-colors group-hover:text-foreground" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold transition-colors group-hover:text-foreground">
                        @logo.Name
                    </span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",    "shield"),
        new("l2",  "Northwind", "compass"),
        new("l3",  "Ion",       "atom"),
        new("l4",  "Rookery",   "feather"),
        new("l5",  "LaunchPad", "rocket"),
        new("l6",  "Lumen",     "star"),
        new("l7",  "Loam",      "tree-pine"),
        new("l8",  "Strata",    "layers"),
        new("l9",  "Telemark",  "mountain"),
        new("l10", "Bastion",   "key"),
        new("l11", "Honeycomb", "hexagon"),
        new("l12", "Tidal",     "waves"),
        new("l13", "Meridian",  "globe"),
        new("l14", "Ember",     "flame"),
        new("l15", "Nocturne",  "moon"),
        new("l16", "Solaris",   "sun"),
        new("l17", "Glimmer",   "sparkles"),
        new("l18", "Facet",     "gem"),
    ];
}
