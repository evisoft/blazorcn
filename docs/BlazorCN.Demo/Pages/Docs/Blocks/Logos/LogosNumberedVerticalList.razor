@* ============================================================
   Block: logos-numbered-vertical-list
   Title: LogosNumberedVerticalList
   Description: A numbered vertical logo list for React and Next.js with tabular 01 through 10 row counters, dashed separators, industry tag column, and monochrome hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-numbered-vertical-list.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-4xl p-4">
    <div class="py-12 sm:py-16">

        @* Headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Launch cohort
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The first ten teams who bet on us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Ten companies signed up the week we launched. Five years later, every single one is
                still shipping with us in production.
            </p>
        </div>

        @* Numbered vertical list *@
        <ol class="mx-auto mt-12 max-w-2xl">
            @foreach (var logo in _logos)
            {
                var rank = logo.Rank.ToString().PadLeft(2, '0');
                <li class="group flex items-center gap-6 border-b border-dashed border-border/40 py-4 last:border-0">
                    <span aria-hidden="true" class="text-3xl font-bold tabular-nums text-muted-foreground/60 transition-colors duration-200 group-hover:text-foreground">
                        @rank
                    </span>
                    <div class="flex flex-1 items-center justify-between gap-4">
                        <div class="flex items-center gap-2.5 text-muted-foreground transition-colors duration-200 group-hover:text-foreground">
                            <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true" />
                            <span class="whitespace-nowrap text-base font-semibold">@logo.Name</span>
                        </div>
                        <span class="text-sm text-muted-foreground transition-colors duration-200 group-hover:text-foreground/70">
                            @logo.Industry
                        </span>
                    </div>
                </li>
            }
        </ol>
    </div>
</section>

@code {
    private record Logo(string Id, int Rank, string Name, string IconName, string Industry);

    private static readonly Logo[] _logos =
    [
        new("l1",  1,  "Halide",    "shield",      "Security"),
        new("l2",  2,  "Northwind", "compass",     "Logistics"),
        new("l3",  3,  "Ion",       "atom",        "Energy"),
        new("l4",  4,  "Rookery",   "feather",     "Media"),
        new("l5",  5,  "LaunchPad", "rocket",      "Developer Tools"),
        new("l6",  6,  "Loam",      "tree-pine",   "Climate"),
        new("l7",  7,  "Strata",    "layers",      "Data Infrastructure"),
        new("l8",  8,  "Honeycomb", "hexagon",     "Biotech"),
        new("l9",  9,  "Bastion",   "key",         "Identity"),
        new("l10", 10, "Telemark",  "mountain",    "Fintech"),
    ];
}
