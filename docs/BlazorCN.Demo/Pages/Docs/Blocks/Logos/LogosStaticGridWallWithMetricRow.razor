@* ============================================================
   Block: logos-static-grid-wall-with-metric-row
   Title: LogosStaticGridWallWithMetricRow
   Description: A static grid wall logo block for React and Next.js with eighteen borderless logo cells and an inline four-metric chip row between the headline and the grid, tabular numeric alignment, and monochrome-to-color hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-static-grid-wall-with-metric-row.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted at scale
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Numbers the teams stand behind.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Twelve thousand teams shipping across sixty countries with four nines of uptime — the
                numbers behind the eighteen flagship walls below.
            </p>
        </div>

        @* Metric chip row *@
        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                var isLast = i == _metrics.Length - 1;
                <div class="flex items-center gap-x-8">
                    <div class="flex items-baseline gap-2">
                        <span class="text-2xl font-bold tabular-nums leading-none tracking-tight sm:text-3xl">
                            @metric.Value
                        </span>
                        <span class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                            @metric.Label
                        </span>
                    </div>
                    @if (!isLast)
                    {
                        <span class="h-4 w-px bg-border" aria-hidden="true"></span>
                    }
                </div>
            }
        </div>

        @* Static grid wall *@
        <ul class="mt-14 grid grid-cols-2 gap-8 sm:grid-cols-3 sm:gap-10 lg:grid-cols-4 xl:grid-cols-6">
            @foreach (var logo in _logos)
            {
                <li class="flex h-20 items-center justify-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);
    private record Metric(string Id, string Value, string Label);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",    "shield"),
        new("l2",  "Northwind", "compass"),
        new("l3",  "Ion",       "atom"),
        new("l4",  "Rookery",   "feather"),
        new("l5",  "LaunchPad", "rocket"),
        new("l6",  "Lumen",     "star"),
        new("l7",  "Loam",      "tree-pine"),
        new("l8",  "Strata",    "layers"),
        new("l9",  "Telemark",  "mountain"),
        new("l10", "Bastion",   "key"),
        new("l11", "Honeycomb", "hexagon"),
        new("l12", "Tidal",     "waves"),
        new("l13", "Meridian",  "globe"),
        new("l14", "Ember",     "flame"),
        new("l15", "Nocturne",  "moon"),
        new("l16", "Solaris",   "sun"),
        new("l17", "Glimmer",   "sparkles"),
        new("l18", "Facet",     "gem"),
    ];

    private static readonly Metric[] _metrics =
    [
        new("m1", "12,000+", "teams"),
        new("m2", "60",      "countries"),
        new("m3", "4.9/5",   "rating"),
        new("m4", "99.99%",  "uptime"),
    ];
}
