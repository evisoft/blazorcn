@* ============================================================
   Block: logos-featured-quote-with-rating-chip
   Title: LogosFeaturedQuoteWithRatingChip
   Description: A featured quote split logo block for React and Next.js with a flagship mark on the left and a five-star rating credibility chip above a semantic blockquote on the right built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-featured-quote-with-rating-chip.tsx
   ============================================================ *@

<section
    aria-label="Featured customer logo and quote with rating chip"
    class="mx-auto w-full max-w-6xl p-4">

    <div class="grid items-center gap-12 py-14 sm:py-20 lg:grid-cols-2 lg:gap-16">

        @* Left — flagship logo card *@
        <div class="flex flex-col items-center rounded-2xl border-2 border-foreground/15 bg-card p-8 shadow-sm sm:p-10">
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Featured customer
            </span>
            <div class="mt-5 flex size-20 items-center justify-center rounded-3xl border bg-muted/40 sm:size-24">
                <LucideIconCn Name="gem" Size="48" Class="size-12 text-foreground sm:size-14" aria-hidden="true" />
            </div>
            <p class="mt-5 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_featured.Name
            </p>
            <p class="mt-2 text-xs tabular-nums text-muted-foreground">@_featured.Tenure</p>
        </div>

        @* Right — rating chip + semantic quote *@
        <figure>
            @* Rating chip *@
            <div
                role="img"
                aria-label="@($"{_rating.Value} stars from {_rating.Reviewers}")"
                class="flex items-center gap-2 text-sm text-muted-foreground">
                <div class="flex items-center gap-0.5">
                    @foreach (var i in _starIndices)
                    {
                        <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" aria-hidden="true" />
                    }
                </div>
                <span class="font-semibold text-foreground">@_ratingLabel</span>
            </div>

            <blockquote class="mt-4 text-xl font-medium leading-relaxed text-foreground sm:text-2xl">
                &ldquo;@_featured.Quote&rdquo;
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-4">
                <div
                    aria-hidden="true"
                    class="flex size-12 shrink-0 items-center justify-center rounded-full border bg-muted font-mono text-sm font-semibold text-muted-foreground">
                    @_featured.AuthorInitials
                </div>
                <div>
                    <p class="text-sm font-semibold text-foreground">@_featured.AuthorName</p>
                    <p class="text-xs text-muted-foreground">@_featured.AuthorRole</p>
                </div>
            </figcaption>
        </figure>

    </div>
</section>

@code {
    private record FeaturedCustomer(
        string Name,
        string Quote,
        string AuthorName,
        string AuthorRole,
        string AuthorInitials,
        string Tenure
    );

    private record RatingInfo(string Value, string Reviewers);

    private static readonly FeaturedCustomer _featured = new(
        "Facet",
        "The first platform in five years that my engineers chose to use on their own time. That is the highest compliment I know how to give a tool.",
        "Emi Takeda",
        "Head of Platform · Facet",
        "ET",
        "Customer since 2022"
    );

    private static readonly RatingInfo _rating = new("4.9/5", "2,184 engineers");

    private static readonly int[] _starIndices = [0, 1, 2, 3, 4];

    private string _ratingLabel => $"{_rating.Value} from {_rating.Reviewers}";
}
