@* ============================================================
   Block: logos-global-presence-with-region-metrics
   Title: LogosGlobalPresenceWithRegionMetrics
   Description: A global presence dot grid map logo block for React and Next.js paired with four region metric cards showing team counts per continent, a wide 16 by 7 dot-grid world map container, and a centered marketing headline cluster built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-global-presence-with-region-metrics.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Global customer footprint
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Twelve thousand teams. Six continents.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From São Paulo to Singapore, here's where the engineers shipping with our platform
                actually work — broken down by the regions that matter.
            </p>
        </div>

        @* Dot-grid world map *@
        <div
            role="img"
            aria-label="World map showing customer regions"
            class="relative mt-12 aspect-[16/7] overflow-hidden rounded-xl border bg-muted/30 p-4">

            @* Dot grid *@
            <div
                class="grid h-full w-full gap-1"
                style="grid-template-columns: repeat(16, minmax(0, 1fr))"
                aria-hidden="true">
                @for (int i = 0; i < _totalCells; i++)
                {
                    var cellIndex = i;
                    <div class="@($"aspect-square rounded-full {(_highlighted.Contains(cellIndex) ? "bg-foreground" : "bg-muted-foreground/20")}")"></div>
                }
            </div>

            @* Overlaid logo pins *@
            @foreach (var pin in _pins)
            {
                <div
                    title="@pin.Name"
                    class="group absolute flex size-9 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border bg-background shadow-md ring-2 ring-background transition-transform hover:scale-110"
                    style="@($"top:{pin.Top}; left:{pin.Left}")">
                    <LucideIconCn Name="@pin.IconName" Size="16" Class="size-4 text-foreground transition-transform group-hover:rotate-3" aria-hidden="true" />
                    <span class="sr-only">@pin.Name</span>
                </div>
            }
        </div>

        @* Region metric cards *@
        <dl class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
            @foreach (var metric in _metrics)
            {
                <div class="group rounded-xl border bg-card p-5 transition-colors hover:border-foreground/20">
                    <dt class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground">
                        @metric.Region
                    </dt>
                    <dd class="mt-2 text-3xl font-bold tabular-nums tracking-tight text-foreground transition-colors group-hover:text-foreground">
                        @metric.Value
                    </dd>
                    <dd class="mt-1 text-xs leading-relaxed text-muted-foreground">@metric.Label</dd>
                </div>
            }
        </dl>
    </div>
</section>

@code {
    private const int _gridCols = 16;
    private const int _gridRows = 7;
    private const int _totalCells = _gridCols * _gridRows; // 112

    private static readonly HashSet<int> _highlighted = new()
    {
        // Row 1
        17, 18, 19, 20, 21, 22, 23, 24,
        // Row 2 — Americas / Europe / Asia top band
        32, 33, 34, 35, 38, 39, 40, 41, 42, 43, 44,
        // Row 3
        48, 49, 50, 51, 54, 55, 56, 57, 58, 59, 60, 61,
        // Row 4 — equator band
        65, 66, 67, 72, 73, 74, 75, 76, 77, 78,
        // Row 5 — Africa / S. America
        82, 83, 84, 88, 89, 90, 91, 92,
        // Row 6
        99, 100, 105, 106, 107,
    };

    private record PinData(string Id, string Name, string IconName, string Top, string Left);

    private static readonly PinData[] _pins =
    [
        new("p1", "Atlas",    "globe",     "26%", "20%"),
        new("p2", "Halide",   "shield",    "20%", "48%"),
        new("p3", "Meridian", "compass",   "30%", "74%"),
        new("p4", "Loam",     "tree-pine", "58%", "50%"),
        new("p5", "Summit",   "mountain",  "66%", "28%"),
        new("p6", "Ion",      "atom",      "60%", "80%"),
    ];

    private record MetricData(string Id, string Region, string Value, string Label);

    private static readonly MetricData[] _metrics =
    [
        new("m1", "North America", "4,200", "teams in production"),
        new("m2", "Europe",        "3,800", "teams across 24 countries"),
        new("m3", "APAC",          "2,600", "teams across 18 countries"),
        new("m4", "Rest of World", "1,400", "teams in LATAM + MEA"),
    ];
}
