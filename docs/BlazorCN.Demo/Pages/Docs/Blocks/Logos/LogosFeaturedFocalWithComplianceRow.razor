@* ============================================================
   Block: logos-featured-focal-with-compliance-row
   Title: LogosFeaturedFocalWithComplianceRow
   Description: A featured focal hub logo block for React and Next.js with a stacked flagship card, dashed integrates-with divider, supporting integration strip, and a four-badge compliance row built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-featured-focal-with-compliance-row.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-4xl p-4">
    <div class="py-14 sm:py-20">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Core ecosystem
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Trusted foundations. Verified compliance.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Our platform is anchored by a flagship partnership, extends across six best-in-class
                integrations, and meets the compliance bar regulated industries demand.
            </p>
        </div>

        @* Central flagship card *@
        <div class="relative mx-auto mt-14 flex max-w-md flex-col items-center rounded-3xl border-2 border-foreground/15 bg-card px-10 py-12 shadow-md">
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                @_featured.PartnershipLabel
            </span>

            <div class="mt-6 flex size-24 items-center justify-center rounded-3xl bg-foreground text-background shadow-sm">
                <LucideIconCn Name="@_featured.IconName" Size="56" Class="size-14" aria-hidden="true" />
            </div>

            <p class="mt-6 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_featured.Name
            </p>
            <p class="mt-3 text-sm text-muted-foreground">@_featured.TenureMetric</p>
        </div>

        @* Dashed connecting divider *@
        <div class="relative mt-12 flex items-center justify-center" aria-hidden="true">
            <div class="h-px w-full border-t border-dashed border-border"></div>
            <span class="absolute bg-background px-4 text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                Integrates with
            </span>
        </div>

        @* Supporting integration strip *@
        <ul aria-label="Integration partners" class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
            @foreach (var logo in _supporting)
            {
                <li class="group flex h-20 flex-col items-center justify-center gap-2 rounded-xl border bg-card text-muted-foreground transition-all duration-200 hover:border-foreground/20 hover:text-foreground hover:shadow-sm">
                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0 transition-transform duration-200 group-hover:scale-110" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>

        @* Compliance badge row *@
        <div class="mt-12 flex flex-col items-center gap-4">
            <p class="text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                Certified and compliant
            </p>
            <ul aria-label="Compliance certifications" class="flex flex-wrap items-center justify-center gap-3">
                @foreach (var label in _compliance)
                {
                    <li class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1.5 text-xs font-medium text-muted-foreground transition-colors duration-200 hover:border-foreground/20 hover:text-foreground">
                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                        @label
                    </li>
                }
            </ul>
        </div>

    </div>
</section>

@code {
    private record FeaturedLogo(string Id, string Name, string IconName, string PartnershipLabel, string TenureMetric);
    private record SupportingLogo(string Id, string Name, string IconName);

    private static readonly FeaturedLogo _featured = new(
        "central",
        "Halide",
        "shield",
        "Flagship partner",
        "Since 2019 · 500+ teams built on this"
    );

    private static readonly SupportingLogo[] _supporting =
    [
        new("s1", "Northwind", "compass"),
        new("s2", "Ion",       "atom"),
        new("s3", "Rookery",   "feather"),
        new("s4", "LaunchPad", "rocket"),
        new("s5", "Strata",    "layers"),
        new("s6", "Honeycomb", "hexagon"),
    ];

    private static readonly string[] _compliance = ["SOC 2 Type II", "ISO 27001", "HIPAA", "GDPR"];
}
