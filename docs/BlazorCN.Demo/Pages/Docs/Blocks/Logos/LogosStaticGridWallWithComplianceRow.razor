@* ============================================================
   Block: logos-static-grid-wall-with-compliance-row
   Title: LogosStaticGridWallWithComplianceRow
   Description: A static grid wall logo block for React and Next.js with eighteen borderless logo cells and a four-badge compliance row rendered below the grid, emerald check icons on pill badges, and monochrome-to-color hover promotion built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-static-grid-wall-with-compliance-row.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Enterprise ready
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Built for regulated teams.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Eighteen customers in healthcare, finance, and the public sector ship on our platform —
                audited, certified, and reviewed by the teams that would know.
            </p>
        </div>

        @* Static grid wall *@
        <ul class="mt-12 grid grid-cols-2 gap-8 sm:grid-cols-3 sm:gap-10 lg:grid-cols-4 xl:grid-cols-6">
            @foreach (var logo in _logos)
            {
                <li class="flex h-20 items-center justify-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>

        @* Compliance badge row *@
        <ul aria-label="Compliance posture" class="mt-10 flex flex-wrap items-center justify-center gap-3">
            @foreach (var label in _compliance)
            {
                <li>
                    <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-xs font-medium text-muted-foreground transition-colors duration-200 hover:border-foreground/20 hover:text-foreground">
                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-500" aria-hidden="true" />
                        @label
                    </span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",    "shield"),
        new("l2",  "Northwind", "compass"),
        new("l3",  "Ion",       "atom"),
        new("l4",  "Rookery",   "feather"),
        new("l5",  "LaunchPad", "rocket"),
        new("l6",  "Lumen",     "star"),
        new("l7",  "Loam",      "tree-pine"),
        new("l8",  "Strata",    "layers"),
        new("l9",  "Telemark",  "mountain"),
        new("l10", "Bastion",   "key"),
        new("l11", "Honeycomb", "hexagon"),
        new("l12", "Tidal",     "waves"),
        new("l13", "Meridian",  "globe"),
        new("l14", "Ember",     "flame"),
