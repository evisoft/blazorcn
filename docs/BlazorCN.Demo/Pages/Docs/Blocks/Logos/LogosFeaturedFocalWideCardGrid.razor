@* ============================================================
   Block: logos-featured-focal-wide-card-grid
   Title: LogosFeaturedFocalWideCardGrid
   Description: A featured focal wide card logo block for React and Next.js with a horizontal full-width flagship card on top containing an inverted mark, wordmark, and metric, and a six-cell integration grid below built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-featured-focal-wide-card-grid.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-4xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Core ecosystem
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Built on world-class foundations.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Our platform is anchored by a flagship partnership and extends across an ecosystem of
                six best-in-class integrations.
            </p>
        </div>

        @* Horizontal flagship card *@
        <div class="mt-12 flex flex-col items-center gap-8 rounded-2xl border-2 border-foreground/15 bg-card p-10 shadow-md sm:flex-row">

            @* Left — inverted mark container *@
            <div class="flex size-24 shrink-0 items-center justify-center rounded-3xl bg-foreground text-background shadow-sm">
                <LucideIconCn Name="@_featured.IconName" Size="64" Class="size-16" aria-hidden="true" />
            </div>

            @* Right — wordmark + metric *@
            <div class="flex flex-col items-center text-center sm:items-start sm:text-left">
                <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_featured.PartnershipLabel
                </span>
                <p class="mt-3 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                    @_featured.Name
                </p>
                <p class="mt-2 text-sm text-muted-foreground">@_featured.TenureMetric</p>
            </div>
        </div>

        @* Dashed divider with centered label *@
        <div class="relative mt-10 flex items-center justify-center" aria-hidden="true">
            <div class="h-px w-full border-t border-dashed border-border"></div>
            <span class="absolute bg-background px-4 text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                Integrates with
            </span>
        </div>

        @* Supporting integration grid *@
        <ul aria-label="Integration partners" class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
            @foreach (var logo in _supporting)
            {
                <li class="group flex h-20 flex-col items-center justify-center gap-2 rounded-xl border bg-card text-muted-foreground transition-all duration-200 hover:border-foreground/20 hover:text-foreground hover:shadow-sm">
                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0 transition-transform duration-200 group-hover:scale-110" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record FeaturedLogo(string Id, string Name, string IconName, string PartnershipLabel, string TenureMetric);
    private record SupportingLogo(string Id, string Name, string IconName);

    private static readonly FeaturedLogo _featured = new(
        "central",
        "Halide",
        "shield",
        "Flagship partner",
        "Since 2019 · 500+ teams built on this"
    );

    private static readonly SupportingLogo[] _supporting =
    [
        new("s1", "Northwind", "compass"),
        new("s2", "Ion",       "atom"),
        new("s3", "Rookery",   "feather"),
        new("s4", "LaunchPad", "rocket"),
        new("s5", "Strata",    "layers"),
        new("s6", "Honeycomb", "hexagon"),
    ];
}
