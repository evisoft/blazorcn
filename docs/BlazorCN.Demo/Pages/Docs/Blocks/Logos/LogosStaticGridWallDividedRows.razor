@* ============================================================
   Block: logos-static-grid-wall-divided-rows
   Title: LogosStaticGridWallDividedRows
   Description: A static grid wall logo block for React and Next.js with eighteen borderless cells arranged in three rows separated by dashed divider lines, monochrome-to-color hover states, and staggered entrance animation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-static-grid-wall-divided-rows.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted worldwide
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Every team shipping in every tier.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Eighteen flagship customers across three product tiers — from solo founders on the free
                plan to global engineering orgs on enterprise.
            </p>
        </div>

        @* Divided grid wall *@
        <div class="mt-12">
            @foreach (var rowEntry in _rows)
            {
                var rowIndex = rowEntry.Index;
                var row = rowEntry.Logos;
                <ul aria-label="@($"Customer logos row {rowIndex + 1}")"
                    class="@(rowIndex == 0
                        ? "grid grid-cols-2 gap-x-8 gap-y-6 py-2 sm:grid-cols-3 sm:gap-10 sm:py-4 lg:grid-cols-6"
                        : "mt-6 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-dashed border-border/50 pt-8 sm:grid-cols-3 sm:gap-10 sm:pt-10 lg:grid-cols-6")">
                    @foreach (var logo in row)
                    {
                        <li class="flex h-16 items-center justify-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                            <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0" aria-hidden="true" />
                            <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);
    private record IndexedRow(int Index, Logo[] Logos);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",     "shield"),
        new("l2",  "Northwind",  "compass"),
        new("l3",  "Ion",        "atom"),
        new("l4",  "Rookery",    "feather"),
        new("l5",  "LaunchPad",  "rocket"),
        new("l6",  "Lumen",      "star"),
        new("l7",  "Loam",       "tree-pine"),
        new("l8",  "Strata",     "layers"),
        new("l9",  "Telemark",   "mountain"),
        new("l10", "Bastion",    "key"),
        new("l11", "Honeycomb",  "hexagon"),
        new("l12", "Tidal",      "waves"),
        new("l13", "Meridian",   "globe"),
        new("l14", "Ember",      "flame"),
        new("l15", "Nocturne",   "moon"),
        new("l16", "Solaris",    "sun"),
        new("l17", "Glimmer",    "sparkles"),
        new("l18", "Facet",      "gem"),
    ];

    private static readonly IndexedRow[] _rows =
    [
        new(0, _logos[0..6]),
        new(1, _logos[6..12]),
        new(2, _logos[12..18]),
    ];
}
