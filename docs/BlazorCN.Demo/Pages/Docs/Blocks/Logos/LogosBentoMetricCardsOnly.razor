@* ============================================================
   Block: logos-bento-metric-cards-only
   Title: LogosBentoMetricCardsOnly
   Description: A bento logo block with six equal-weight metric cards in a three-by-two grid for React and Next.js with icon-topped containers, tabular-nums metrics, descriptive labels, and brand attribution built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-bento-metric-cards-only.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer outcomes
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Six teams. Six numbers that moved.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Every card is a shipped outcome, measured in production. No quotes, no averages — just
                what changed after the migration.
            </p>
        </div>

        @* Bento grid — 3×2 equal metric cards *@
        <dl class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3">
            @foreach (var card in _metrics)
            {
                <div class="group flex flex-col justify-between gap-6 rounded-2xl border bg-card p-6 transition-colors hover:border-foreground/20">
                    @* Top cluster: icon *@
                    <div class="flex size-11 items-center justify-center rounded-xl border bg-muted/40 text-muted-foreground transition-colors group-hover:border-foreground/20 group-hover:text-foreground">
                        <LucideIconCn Name="@card.IconName" Size="24" Class="size-6 transition-transform group-hover:scale-110" aria-hidden="true" />
                    </div>

                    @* Bottom cluster: metric + label + brand *@
                    <div>
                        <dd class="text-3xl font-bold tracking-tight tabular-nums text-foreground">
                            @card.Metric
                        </dd>
                        <dt class="mt-1 text-sm text-muted-foreground">@card.Label</dt>
                        <p class="mt-3 text-xs font-medium text-muted-foreground">— @card.Brand</p>
                    </div>
                </div>
            }
        </dl>
    </div>
</section>

@code {
    private record MetricCard(string Id, string Brand, string IconName, string Metric, string Label);

    private static readonly MetricCard[] _metrics =
    [
        new("m1", "Halide",    "shield",    "91%",  "faster p99 latency"),
        new("m2", "Northwind", "compass",   "12×",  "throughput increase"),
        new("m3", "Ion",       "atom",      "Zero", "downtime this year"),
        new("m4", "Loam",      "tree-pine", "$2M",  "infra cost savings"),
        new("m5", "LaunchPad", "rocket",    "4×",   "headcount productivity"),
        new("m6", "Atlas",     "globe",     "6",    "regions in production"),
    ];
}
