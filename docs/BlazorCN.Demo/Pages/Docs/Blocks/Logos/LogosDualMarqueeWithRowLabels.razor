@* ============================================================
   Block: logos-dual-marquee-with-row-labels
   Title: LogosDualMarqueeWithRowLabels
   Description: A dual row infinite marquee logo wall for React and Next.js with category labels beside each row, opposing scroll directions, gradient edge masks, and reduced-motion handling built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-dual-marquee-with-row-labels.tsx
   ============================================================ *@

<style>
    @@keyframes logos-labeled-row-1-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    @@keyframes logos-labeled-row-2-right {
        from { transform: translateX(-50%); }
        to { transform: translateX(0); }
    }
    @@media (prefers-reduced-motion: reduce) {
        [data-logos-labeled-row="row-1"],
        [data-logos-labeled-row="row-2"] {
            animation: none !important;
            transform: none !important;
        }
    }
</style>

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Every vertical
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Built for the teams you already admire.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Twenty-four leading fintech and developer tooling companies run on the same platform —
                here is a sample from both categories.
            </p>
        </div>

        @* Dual marquee rows with category labels *@
        <div class="relative mt-12 overflow-hidden py-4">

            @* Gradient edge masks *@
            <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent sm:w-40"></div>
            <div aria-hidden="true" class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40"></div>

            <div class="space-y-8">

                @* Row 1 — Fintech *@
                <div class="grid items-center gap-6 lg:grid-cols-[auto_1fr]">
                    <p class="relative z-20 pl-6 text-[11px] font-semibold uppercase tracking-widest text-muted-foreground sm:pl-10 lg:pl-0 lg:pr-2 lg:text-right">
                        Fintech
                    </p>
                    <div aria-hidden="true" class="flex overflow-hidden">
                        <div data-logos-labeled-row="row-1"
                             class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                             style="animation: logos-labeled-row-1-left 40s linear infinite;">
                            @foreach (var logo in _fintechDoubled)
                            {
                                <div class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* Row 2 — Dev tools *@
                <div class="grid items-center gap-6 lg:grid-cols-[auto_1fr]">
                    <p class="relative z-20 pl-6 text-[11px] font-semibold uppercase tracking-widest text-muted-foreground sm:pl-10 lg:pl-0 lg:pr-2 lg:text-right">
                        Dev tools
                    </p>
                    <div aria-hidden="true" class="flex overflow-hidden">
                        <div data-logos-labeled-row="row-2"
                             class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                             style="animation: logos-labeled-row-2-right 50s linear infinite;">
                            @foreach (var logo in _devToolsDoubled)
                            {
                                <div class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _fintechRow =
    [
        new("ft-1",  "Bastion",    "shield"),
        new("ft-2",  "VaultGuard", "key"),
        new("ft-3",  "Meridian",   "compass"),
        new("ft-4",  "Citadel",    "shield"),
        new("ft-5",  "Facet",      "gem"),
        new("ft-6",  "Atlas",      "globe"),
        new("ft-7",  "Aegis",      "shield"),
        new("ft-8",  "Brilliant",  "gem"),
        new("ft-9",  "Rampart",    "shield"),
        new("ft-10", "Latchkey",   "key"),
        new("ft-11", "Bearing",    "compass"),
        new("ft-12", "Carat",      "gem"),
    ];

    private static readonly Logo[] _devToolsRow =
    [
