        new("dt-6",  "Lumen",      "star"),
        new("dt-7",  "Codex",      "book"),
        new("dt-8",  "Forge",      "flame"),
        new("dt-9",  "Lattice",    "hexagon"),
        new("dt-10", "Quill",      "feather"),
        new("dt-11", "Spark",      "sparkles"),
        new("dt-12", "Nucleo",     "atom"),
