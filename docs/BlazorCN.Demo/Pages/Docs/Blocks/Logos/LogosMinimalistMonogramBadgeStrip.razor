@* ============================================================
   Block: logos-minimalist-monogram-badge-strip
   Title: LogosMinimalistMonogramBadgeStrip
   Description: A minimalist monogram badge logo strip for React and Next.js with seven two-letter monogram tiles rendered in rounded bordered containers, an eyebrow label, and monochrome-to-color hover built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-minimalist-monogram-badge-strip.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-4xl p-4">
    <div class="border-y border-dashed border-border/60 py-10 sm:py-14">
        <p class="text-center text-xs font-medium uppercase tracking-widest text-muted-foreground">
            @_eyebrow
        </p>

        <ul aria-label="Customer monogram badges"
            class="mt-8 flex flex-wrap items-center justify-center gap-x-4 gap-y-4 sm:gap-x-6">
            @foreach (var monogram in _monograms)
            {
                <li>
                    <div role="img"
                         aria-label="@($"{monogram.Name} logo")"
                         class="group flex size-12 items-center justify-center rounded-xl border bg-card text-muted-foreground transition-colors duration-200 hover:border-foreground/20 hover:text-foreground">
                        <span class="font-mono text-sm font-bold transition-transform duration-200 group-hover:scale-110">
                            @monogram.Letters
                        </span>
                    </div>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Monogram(string Id, string Name, string Letters);

    private const string _eyebrow = "Built by teams at";

    private static readonly Monogram[] _monograms =
    [
        new("m1", "Halide",    "HL"),
        new("m2", "Northwind", "NW"),
        new("m3", "Ion",       "IO"),
        new("m4", "LaunchPad", "LP"),
        new("m5", "Strata",    "ST"),
        new("m6", "Honeycomb", "HC"),
        new("m7", "Bastion",   "BS"),
    ];
}
