@* ============================================================
   Block: logos-tab-filtered-by-use-case
   Title: LogosTabFilteredByUseCase
   Description: A use case tab-filtered logo grid for React and Next.js with four pill tabs covering All, Build, Deploy, and Monitor, balanced eight-logo rosters per tab, a reserved minimum grid height that prevents layout shift, and AnimatePresence crossfade between use cases built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-tab-filtered-by-use-case.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted across the stack
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                However your team ships, we're in the loop.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From first commit to production rollout to 3 AM incidents — engineering teams use our
                platform at every stage of the workflow.
            </p>
        </div>

        @* Pill tabs *@
        <nav aria-label="Filter logos by use case" class="mt-10 flex justify-center">
            <div role="tablist" class="inline-flex items-center gap-1 rounded-full border bg-muted/50 p-1">
                @foreach (var useCase in _useCases)
                {
                    var uc = useCase;
                    var isActive = _active == uc.Id;
                    <button
                        type="button"
                        role="tab"
                        aria-selected="@isActive"
                        aria-controls="logos-usecase-grid"
                        @onclick="@(() => SetActive(uc.Id))"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-semibold transition-colors duration-200", isActive ? "border border-border bg-background text-foreground shadow-sm" : "border border-transparent text-muted-foreground hover:text-foreground")">
                        @uc.Label
                    </button>
                }
            </div>
        </nav>

        @* Filtered grid with reserved min-height *@
        <div id="logos-usecase-grid" class="mt-10 min-h-[240px] sm:min-h-[200px]">
            <ul aria-label="@($"Customer logos for {(_active == "all" ? "all use cases" : _active)}")" class="grid grid-cols-2 gap-6 sm:grid-cols-4 sm:gap-8">
                @foreach (var logo in GetLogosForUseCase(_active))
                {
                    <li class="group flex h-20 items-center justify-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                        <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0 transition-transform group-hover:rotate-3" aria-hidden="true" />
                        <span class="text-sm font-semibold whitespace-nowrap">@logo.Name</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

@code {
    private record UseCaseTab(string Id, string Label);
    private record LogoData(string Id, string Name, string IconName, string UseCase, bool Featured = false);

    private static readonly UseCaseTab[] _useCases =
    [
        new("all",     "All"),
        new("build",   "Build"),
        new("deploy",  "Deploy"),
        new("monitor", "Monitor"),
    ];

    private static readonly LogoData[] _logos =
    [
        // Build — 8
        new("l1",  "LaunchPad", "rocket",    "build",   true),
        new("l2",  "Ion",       "atom",      "build",   true),
        new("l3",  "Honeycomb", "hexagon",   "build"),
        new("l4",  "Codex",     "book",      "build"),
        new("l5",  "Glimmer",   "sparkles",  "build"),
        new("l6",  "Nucleo",    "atom",      "build"),
        new("l7",  "Strata",    "layers",    "build"),
        new("l8",  "Facet",     "gem",       "build"),
        // Deploy — 8
        new("l9",  "Halide",    "shield",    "deploy",  true),
        new("l10", "Bastion",   "key",       "deploy",  true),
        new("l11", "Meridian",  "compass",   "deploy"),
        new("l12", "Atlas",     "globe",     "deploy"),
        new("l13", "Summit",    "mountain",  "deploy"),
        new("l14", "Ember",     "flame",     "deploy"),
        new("l15", "Zephyr",    "wind",      "deploy"),
        new("l16", "Telemark",  "mountain",  "deploy"),
        // Monitor — 8
        new("l17", "Lumen",     "star",      "monitor", true),
        new("l18", "Nocturne",  "moon",      "monitor", true),
        new("l19", "Solaris",   "sun",       "monitor"),
        new("l20", "Polaris",   "star",      "monitor"),
        new("l21", "Tidal",     "waves",     "monitor"),
        new("l22", "Aquifer",   "droplets",  "monitor"),
        new("l23", "Rookery",   "feather",   "monitor"),
        new("l24", "Loam",      "tree-pine", "monitor"),
    ];

    private string _active = "all";

    private void SetActive(string useCaseId)
    {
        _active = useCaseId;
    }

    private static LogoData[] GetLogosForUseCase(string active)
    {
        if (active == "all")
        {
            var featured = Array.FindAll(_logos, l => l.Featured);
            var fillers = Array.FindAll(_logos, l => !l.Featured);
            var combined = new List<LogoData>(featured);
            for (var i = 0; combined.Count < 8 && i < fillers.Length; i++)
                combined.Add(fillers[i]);
            return combined.Count > 8
                ? combined.GetRange(0, 8).ToArray()
                : combined.ToArray();
        }
        var useCaseLogos = Array.FindAll(_logos, l => l.UseCase == active);
        return useCaseLogos.Length > 8
            ? useCaseLogos[..8]
            : useCaseLogos;
    }
}
