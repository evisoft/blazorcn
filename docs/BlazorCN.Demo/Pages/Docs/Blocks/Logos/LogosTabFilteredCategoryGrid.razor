@* ============================================================
   Block: logos-tab-filtered-category-grid
   Title: LogosTabFilteredCategoryGrid
   Description: A tab-filtered category grid logo block for React and Next.js with hand-rolled pill tab navigation, balanced per-category rosters, a reserved minimum grid height that prevents layout shift between tabs, AnimatePresence grid swap, and monochrome-to-color hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-tab-filtered-category-grid.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted across industries
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Teams in every sector ship with us.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                From regulated fintech to open-source developer tooling to climate infrastructure —
                engineering teams trust our platform in production.
            </p>
        </div>

        @* Pill tabs *@
        <nav aria-label="Filter logos by industry" class="mt-10 flex justify-center">
            <div role="tablist" class="inline-flex items-center gap-1 rounded-full border bg-muted/50 p-1">
                @foreach (var category in _categories)
                {
                    var cat = category;
                    var isActive = _active == cat.Id;
                    <button
                        type="button"
                        role="tab"
                        aria-selected="@isActive"
                        aria-controls="tab-filtered-category-grid-logos-tab-grid"
                        @onclick="@(() => SetActive(cat.Id))"
                        class="@Cn.Merge("rounded-full px-4 py-1.5 text-sm font-semibold transition-colors duration-200", isActive ? "border border-border bg-background text-foreground shadow-sm" : "border border-transparent text-muted-foreground hover:text-foreground")">
                        @cat.Label
                    </button>
                }
            </div>
        </nav>

        @* Filtered grid with reserved min-height to prevent layout shift *@
        <div id="tab-filtered-category-grid-logos-tab-grid" class="mt-10 min-h-[240px] sm:min-h-[200px]">
            <ul aria-label="@($"Customer logos in {(_active == "all" ? "all industries" : _active)}")" class="grid grid-cols-2 gap-6 sm:grid-cols-4 sm:gap-8">
                @foreach (var logo in GetLogosForTab(_active))
                {
                    <li class="group flex h-20 items-center justify-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                        <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0 transition-transform group-hover:rotate-3" aria-hidden="true" />
                        <span class="text-sm font-semibold whitespace-nowrap">@logo.Name</span>
                    </li>
                }
            </ul>
        </div>

    </div>
</section>

@code {
    private record CategoryTab(string Id, string Label);
    private record LogoData(string Id, string Name, string IconName, string Category, bool Featured = false);

    private static readonly CategoryTab[] _categories =
    [
        new("all",       "All"),
        new("fintech",   "Fintech"),
        new("developer", "Developer"),
        new("climate",   "Climate"),
    ];

    private static readonly LogoData[] _logos =
    [
        // Fintech — 8
        new("l1",  "Halide",    "shield",    "fintech",   true),
        new("l2",  "Bastion",   "key",       "fintech",   true),
        new("l3",  "Meridian",  "compass",   "fintech"),
        new("l4",  "Strata",    "layers",    "fintech"),
        new("l5",  "Facet",     "gem",       "fintech"),
        new("l6",  "Atlas",     "globe",     "fintech"),
        new("l7",  "Citadel",   "shield",    "fintech"),
        new("l8",  "Lumen",     "star",      "fintech"),
        // Developer — 8
        new("l9",  "Ion",       "atom",      "developer", true),
        new("l10", "LaunchPad", "rocket",    "developer", true),
        new("l11", "Honeycomb", "hexagon",   "developer"),
        new("l12", "Nocturne",  "moon",      "developer"),
        new("l13", "Glimmer",   "sparkles",  "developer"),
        new("l14", "Nucleo",    "atom",      "developer"),
        new("l15", "Summit",    "mountain",  "developer"),
        new("l16", "Ember",     "flame",     "developer"),
        // Climate — 8
        new("l17", "Loam",      "tree-pine", "climate",   true),
        new("l18", "Rookery",   "feather",   "climate",   true),
        new("l19", "Telemark",  "mountain",  "climate"),
        new("l20", "Solaris",   "sun",       "climate"),
        new("l21", "Tidal",     "waves",     "climate"),
        new("l22", "Zephyr",    "wind",      "climate"),
        new("l23", "Aquifer",   "droplets",  "climate"),
        new("l24", "Evergreen", "tree-pine", "climate"),
    ];

    private string _active = "all";

    private void SetActive(string categoryId)
    {
        _active = categoryId;
    }

    private static LogoData[] GetLogosForTab(string active)
    {
        if (active == "all")
        {
            var featured = Array.FindAll(_logos, l => l.Featured);
            var fillers = Array.FindAll(_logos, l => !l.Featured);
            var combined = new List<LogoData>(featured);
            for (var i = 0; combined.Count < 8 && i < fillers.Length; i++)
                combined.Add(fillers[i]);
            return combined.Count > 8
                ? combined.GetRange(0, 8).ToArray()
                : combined.ToArray();
        }
        var catLogos = Array.FindAll(_logos, l => l.Category == active);
        return catLogos.Length > 8
            ? catLogos[..8]
            : catLogos;
    }
}
