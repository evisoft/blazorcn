@* ============================================================
   Block: logos-minimalist-icon-circles-strip
   Title: LogosMinimalistIconCirclesStrip
   Description: A minimalist icon circles logo strip for React and Next.js with six circular bordered icon badges, an uppercase eyebrow label, per-badge aria labels, and monochrome-to-color hover built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-minimalist-icon-circles-strip.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-4xl p-4">
    <div class="py-8 sm:py-12">
        @* Eyebrow-only — Minimalist Strip archetype *@
        <p class="text-center text-xs font-medium uppercase tracking-widest text-muted-foreground">
            @_eyebrow
        </p>

        @* Icon circles strip — variant 1, no wordmark *@
        <ul aria-label="Customer icon badges"
            class="mt-8 flex flex-wrap items-center justify-center gap-x-4 gap-y-4 sm:gap-x-6">
            @foreach (var logo in _logos)
            {
                <li>
                    <div role="img"
                         aria-label="@($"{logo.Name} logo")"
                         class="group flex size-12 items-center justify-center rounded-full border bg-card text-muted-foreground transition-colors duration-200 hover:border-foreground/20 hover:text-foreground">
                        <LucideIconCn Name="@logo.IconName" Size="20" Class="size-5 transition-transform duration-200 group-hover:scale-110" aria-hidden="true" />
                    </div>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private const string _eyebrow = "Trusted by";

    private static readonly Logo[] _logos =
    [
        new("l1", "Bastion",   "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "LaunchPad", "rocket"),
        new("l4", "Evergreen", "tree-pine"),
        new("l5", "Honeycomb", "hexagon"),
        new("l6", "Lodestar",  "star"),
    ];
}
