@* ============================================================
   Block: logos-split-headline-three-col-grid
   Title: LogosSplitHeadlineThreeColGrid
   Description: A split layout logo block for React and Next.js with a left-aligned hero-scale headline paired with a borderless nine-cell three-by-three logo grid, ShadcnioButton CTA pair, and split directional entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-split-headline-three-col-grid.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="grid items-center gap-12 py-12 sm:py-16 lg:grid-cols-[5fr_6fr] lg:gap-16">

        @* Left — headline cluster with CTA pair *@
        <div>
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted by engineers
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight leading-[1.1] sm:text-4xl lg:text-5xl">
                Engineering teams
                <br class="hidden sm:block" /> ship with us.
            </h2>
            <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Nine teams — from two-person startups shipping their first product to public-company
                platform orgs — pick us to deploy thousands of times a day.
            </p>

            <div class="mt-5">
                <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/30 px-2.5 py-0.5 text-[11px] font-medium text-muted-foreground">
                    <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="tabular-nums">9</span> teams shipping daily
                </span>
            </div>

            <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                <ButtonCn Class="w-full sm:w-[240px]">Read case studies</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">
                    Book a demo
                </ButtonCn>
            </div>
        </div>

        @* Right — borderless 3x3 logo grid *@
        <ul aria-label="Customer logos" class="grid grid-cols-3 gap-4">
            @foreach (var logo in _logos)
            {
                <li class="group flex h-20 items-center justify-center gap-2 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0 transition-colors duration-200 group-hover:text-foreground" aria-hidden="true" />
                    <span class="text-sm font-semibold whitespace-nowrap transition-colors duration-200 group-hover:text-foreground">@logo.Name</span>
                </li>
            }
        </ul>

    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "LaunchPad", "rocket"),
        new("l5", "Lumen",     "star"),
        new("l6", "Strata",    "layers"),
        new("l7", "Honeycomb", "hexagon"),
        new("l8", "Summit",    "mountain"),
        new("l9", "Tidal",     "waves"),
    ];
}
