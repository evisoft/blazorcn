@* ============================================================
   Block: logos-split-headline-vertical-logo-list
   Title: LogosSplitHeadlineVerticalLogoList
   Description: A split layout logo block for React and Next.js with a left-aligned hero-scale headline paired with a right-side vertical five-row logo list featuring dashed row dividers, industry tags, and split directional entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-split-headline-vertical-logo-list.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="grid items-center gap-12 py-12 sm:py-16 lg:grid-cols-2">

        @* Left — headline cluster with CTA pair *@
        <div>
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer roster
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight leading-[1.1] sm:text-4xl lg:text-5xl">
                Five teams.
                <br class="hidden sm:block" /> Five different stories.
            </h2>
            <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Each of these five customer teams came to us from a different industry, with a different
                stack, and the same problem — shipping software that fights back.
            </p>

            <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                <ButtonCn Class="w-full sm:w-[240px]">Read case studies</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">
                    Contact sales
                </ButtonCn>
            </div>
        </div>

        @* Right — vertical logo list *@
        <ul aria-label="Customer logos" class="flex flex-col">
            @foreach (var logo in _logos)
            {
                <li class="group flex items-center gap-4 border-b border-dashed border-border/50 py-4 transition-colors duration-200 last:border-0 hover:border-border">
                    <div aria-hidden="true"
                         class="flex size-12 shrink-0 items-center justify-center rounded-lg border bg-muted/40 text-muted-foreground transition-colors duration-200 group-hover:border-foreground/20 group-hover:text-foreground">
                        <LucideIconCn Name="@logo.IconName" Size="32" Class="size-8" aria-hidden="true" />
                    </div>
                    <span class="flex-1 text-base font-semibold text-foreground whitespace-nowrap">
                        @logo.Name
                    </span>
                    <span class="text-xs text-muted-foreground transition-all duration-200 group-hover:translate-x-0.5 group-hover:text-foreground">
                        @logo.Industry
                    </span>
                </li>
            }
        </ul>

    </div>
</section>

@code {
    private record Logo(string Id, string Name, string Industry, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "Cybersecurity", "shield"),
        new("l2", "Northwind", "Logistics",     "compass"),
        new("l3", "Ion",       "Energy",        "atom"),
        new("l4", "LaunchPad", "Aerospace",     "rocket"),
        new("l5", "Strata",    "Geoscience",    "layers"),
    ];
}
