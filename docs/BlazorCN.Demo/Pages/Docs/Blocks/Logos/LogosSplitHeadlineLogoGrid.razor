@* ============================================================
   Block: logos-split-headline-logo-grid
   Title: LogosSplitHeadlineLogoGrid
   Description: A split layout logo block for React and Next.js with a left-aligned hero-scale headline paired with a right-side six-cell logo grid, ShadcnioButton CTA pair, and monochrome-to-color hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-split-headline-logo-grid.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="grid items-center gap-12 py-12 sm:py-16 lg:grid-cols-[5fr_6fr] lg:gap-16">

        @* Left — headline cluster with CTA pair *@
        <div>
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted worldwide
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Trusted by the
                <br class="hidden sm:block" /> teams you admire.
            </h2>
            <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Engineering teams at six thousand companies ship in production with our platform — from
                two-person startups to public companies.
            </p>

            <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                <ButtonCn Class="w-full sm:w-[240px]">Read case studies</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[170px]">
                    Learn more
                </ButtonCn>
            </div>
        </div>

        @* Right — logo grid *@
        <ul aria-label="Customer logos" class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6">
            @foreach (var logo in _logos)
            {
                <li class="group flex h-24 items-center justify-center gap-2.5 rounded-xl border bg-card text-muted-foreground transition-colors duration-200 hover:border-foreground/20 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="32" Class="size-8 shrink-0 transition-transform duration-200 group-hover:scale-110" aria-hidden="true" />
                    <span class="whitespace-nowrap text-base font-semibold">@logo.Name</span>
                </li>
            }
        </ul>

    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "LaunchPad", "rocket"),
        new("l5", "Lumen",     "star"),
        new("l6", "Strata",    "layers"),
    ];
}
