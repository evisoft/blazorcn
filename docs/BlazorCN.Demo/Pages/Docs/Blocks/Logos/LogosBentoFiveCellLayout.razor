@* ============================================================
   Block: logos-bento-five-cell-layout
   Title: LogosBentoFiveCellLayout
   Description: A variant bento logo block for React and Next.js with a four-column two-row grid, a wide two-by-two featured cell, four single-cell supporting logos with industry pills and metrics, and monochrome-to-color hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-bento-five-cell-layout.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Customer stories
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Thirty-two times faster alerting.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Lodestar consolidated three vendors into one platform — and four more teams are shipping
                on the same rails.
            </p>
        </div>

        @* Bento grid: 4 cols × 2 rows, featured is 2×2 wide on the left *@
        <div class="mt-12 grid gap-4 sm:grid-cols-4 sm:grid-rows-2">
            @* Featured cell — wider 2×2 case study *@
            <figure class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border-2 border-foreground/15 bg-card p-8 shadow-sm sm:col-span-2 sm:row-span-2">
                @* Corner accent *@
                <div aria-hidden="true" class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Case study
                </div>

                @* Top: logo + name + industry *@
                <div>
                    <div class="flex size-14 items-center justify-center rounded-2xl bg-foreground text-background shadow-sm">
                        <LucideIconCn Name="star" Size="28" Class="size-7" aria-hidden="true" />
                    </div>
                    <p class="mt-5 text-2xl font-bold tracking-tight text-foreground">
                        @_featured.Name
                    </p>
                    <p class="mt-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @_featured.Industry
                    </p>
                </div>

                @* Quote *@
                <blockquote class="mt-6 max-w-xl text-base leading-relaxed text-foreground sm:text-lg">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>

                @* Metric highlight *@
                <div class="mt-6 flex items-baseline gap-3 border-t pt-5">
                    <p class="text-4xl font-bold tracking-tight tabular-nums text-foreground">
                        @_featured.Metric
                    </p>
                    <p class="text-sm text-muted-foreground">@_featured.MetricLabel</p>
                </div>

                @* Attribution *@
                <div class="mt-5 flex items-end justify-between gap-3 border-t pt-5">
                    <figcaption class="flex min-w-0 items-center gap-3">
                        <div aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full border bg-muted font-mono text-xs font-semibold text-muted-foreground">
                            @_featured.AuthorInitials
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">
                                @_featured.AuthorName
                            </p>
                            <p class="truncate text-xs text-muted-foreground">@_featured.AuthorRole</p>
                        </div>
                    </figcaption>
                    <span aria-hidden="true" class="inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-foreground opacity-60 transition-opacity group-hover:opacity-100">
                        Read
                        <LucideIconCn Name="arrow-up-right" Size="14" Class="size-3.5" />
                    </span>
                </div>
            </figure>

            @* 4 supporting cells — each 1×1 in the remaining slots *@
            @foreach (var logo in _supporting)
            {
                <div class="group flex flex-col justify-between gap-5 rounded-2xl border bg-card p-6 transition-colors hover:border-foreground/20 hover:shadow-sm sm:col-span-1 sm:row-span-1">
                    @* Top: icon + industry pill *@
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex size-11 items-center justify-center rounded-xl border bg-muted/40 text-muted-foreground transition-colors group-hover:text-foreground">
                            <LucideIconCn Name="@logo.IconName" Size="20" Class="size-5" aria-hidden="true" />
                        </div>
                        <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                            <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                            @logo.Industry
                        </span>
                    </div>

                    @* Bottom: wordmark + metric *@
                    <div>
                        <p class="text-base font-semibold text-foreground">@logo.Name</p>
                        <p class="mt-1.5 text-xs tabular-nums text-muted-foreground">@logo.Metric</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FeaturedLogo(
        string Name,
        string Industry,
        string Quote,
        string Metric,
        string MetricLabel,
        string AuthorName,
        string AuthorRole,
        string AuthorInitials);

    private record SupportingLogo(string Id, string Name, string IconName, string Industry, string Metric);

    private static readonly FeaturedLogo _featured = new(
        Name: "Lodestar",
        Industry: "Observability",
        Quote: "We replaced three monitoring vendors with one and cut our p99 alert latency from six minutes to eleven seconds. The on-call team cheered.",
        Metric: "32×",
        MetricLabel: "faster alerting",
        AuthorName: "Marcus Okonkwo",
        AuthorRole: "VP of Engineering · Lodestar",
        AuthorInitials: "MO");

    private static readonly SupportingLogo[] _supporting =
    [
        new("s1", "Strata",   "layers",   "Data",      "98% retention"),
        new("s2", "Tidal",    "waves",    "Streaming", "4.1B events/day"),
        new("s3", "Alpine",   "mountain", "Infra",     "99.99% uptime"),
        new("s4", "Honeycomb","hexagon",  "Platform",  "60+ clusters"),
    ];
}
