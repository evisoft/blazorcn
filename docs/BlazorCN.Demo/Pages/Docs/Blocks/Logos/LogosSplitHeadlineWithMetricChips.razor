@* ============================================================
   Block: logos-split-headline-with-metric-chips
   Title: LogosSplitHeadlineWithMetricChips
   Description: A split layout logo block for React and Next.js with a left-aligned hero-scale headline paired with a three-metric chip row, ShadcnioButton CTA pair, a six-cell bordered logo grid, and split directional entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-split-headline-with-metric-chips.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="grid items-center gap-12 py-12 sm:py-16 lg:grid-cols-[5fr_6fr]">

        @* Left — headline cluster with metric chips and CTA pair *@
        <div>
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted at scale
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight leading-[1.1] sm:text-4xl lg:text-5xl">
                The platform
                <br class="hidden sm:block" /> teams scale on.
            </h2>
            <p class="mt-4 max-w-md text-base leading-relaxed text-muted-foreground">
                Twelve thousand engineering teams across sixty countries ship in production with our
                platform — with the uptime numbers to prove it.
            </p>

            @* Metric chip row *@
            <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm tabular-nums">
                @foreach (var metric in _metrics)
                {
                    var idx = System.Array.IndexOf(_metrics, metric);
                    <div class="flex items-center gap-x-6">
                        @if (idx > 0)
                        {
                            <span aria-hidden="true" class="h-4 w-px bg-border"></span>
                        }
                        <div class="flex items-baseline gap-1.5">
                            <span class="font-bold tabular-nums tracking-tight text-foreground">
                                @metric.Value
                            </span>
                            <span class="text-muted-foreground">@metric.Label</span>
                        </div>
                    </div>
                }
            </div>

            <div class="mt-8 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center">
                <ButtonCn Class="w-full sm:w-[240px]">Read case studies</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[200px]">
                    Contact sales
                </ButtonCn>
            </div>
        </div>

        @* Right — 2x3 bordered logo grid *@
        <ul aria-label="Customer logos" class="grid grid-cols-2 gap-4 sm:grid-cols-3">
            @foreach (var logo in _logos)
            {
                <li class="group flex h-24 items-center justify-center gap-2.5 rounded-xl border bg-card text-muted-foreground transition-colors duration-200 hover:border-foreground/20 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="32" Class="size-8 shrink-0 transition-colors duration-200 group-hover:text-foreground" aria-hidden="true" />
                    <span class="text-base font-semibold whitespace-nowrap transition-colors duration-200 group-hover:text-foreground">
                        @logo.Name
                    </span>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);
    private record Metric(string Id, string Value, string Label);

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "LaunchPad", "rocket"),
        new("l5", "Lumen",     "star"),
        new("l6", "Strata",    "layers"),
    ];

    private static readonly Metric[] _metrics =
    [
        new("m1", "12,000+", "teams"),
        new("m2", "60",      "countries"),
        new("m3", "99.99%",  "uptime"),
    ];
}
