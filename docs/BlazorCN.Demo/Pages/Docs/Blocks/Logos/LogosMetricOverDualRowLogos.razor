@* ============================================================
   Block: logos-metric-over-dual-row-logos
   Title: LogosMetricOverDualRowLogos
   Description: A hero metric over dual opposing marquees for React and Next.js with an oversized tabular-nums count, two infinite scrolling logo rows in opposing directions, gradient edge masks, and a reduced-motion CSS guard built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-metric-over-dual-row-logos.tsx
   ============================================================ *@

<style>
    @@keyframes logos-metric-over-dual-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    @@keyframes logos-metric-over-dual-right {
        from { transform: translateX(-50%); }
        to { transform: translateX(0); }
    }
    @@media (prefers-reduced-motion: reduce) {
        [data-marquee="logos-metric-over-dual-left"],
        [data-marquee="logos-metric-over-dual-right"] {
            animation: none !important;
            transform: none !important;
        }
    }
</style>

<section aria-label="Customer logos and scale metric" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Hero metric cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                By the numbers
            </p>

            <p class="mt-4 text-5xl font-bold tracking-tight tabular-nums leading-[1.05] text-foreground sm:text-6xl lg:text-7xl">
                12,000<span class="text-foreground/60">+</span>
            </p>

            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground sm:text-lg">
                engineering teams across sixty countries ship with us every day.
            </p>

            <div class="mt-5 flex items-center justify-center gap-2 text-xs text-muted-foreground">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="tabular-nums">99.99% uptime · 60 countries · Since 2019</span>
            </div>
        </div>

        @* Dual row marquee *@
        <div class="relative mt-12 space-y-6 overflow-hidden">
            @* Edge masks *@
            <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent sm:w-40">
            </div>
            <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40">
            </div>

            @* Top row — scrolls left *@
            <ul
                aria-label="Customer logos — top row"
                data-marquee="logos-metric-over-dual-left"
                class="flex min-w-max items-center gap-10"
                style="animation: logos-metric-over-dual-left 40s linear infinite;">
                @foreach (var logo in _topRowDoubled)
                {
                    var ariaHidden = logo.IsDuplicate ? "true" : null;
                    <li aria-hidden="@ariaHidden"
                        class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                        <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                        <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                    </li>
                }
            </ul>

            @* Bottom row — scrolls right *@
            <ul
                aria-label="Customer logos — bottom row"
                data-marquee="logos-metric-over-dual-right"
                class="flex min-w-max items-center gap-10"
                style="animation: logos-metric-over-dual-right 50s linear infinite;">
                @foreach (var logo in _bottomRowDoubled)
                {
                    var ariaHidden = logo.IsDuplicate ? "true" : null;
                    <li aria-hidden="@ariaHidden"
                        class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                        <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                        <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                    </li>
                }
            </ul>

        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName, bool IsDuplicate = false);

    private static readonly Logo[] _topRow =
    [
        new("t1",  "Halide",    "shield"),
        new("t2",  "Northwind", "compass"),
        new("t3",  "Ion",       "atom"),
        new("t4",  "LaunchPad", "rocket"),
        new("t5",  "Loam",      "tree-pine"),
        new("t6",  "Strata",    "layers"),
        new("t7",  "Honeycomb", "hexagon"),
        new("t8",  "Bastion",   "key"),
        new("t9",  "Telemark",  "mountain"),
        new("t10", "Rookery",   "feather"),
    ];

    private static readonly Logo[] _bottomRow =
    [
        new("b1",  "Tidal",    "waves"),
        new("b2",  "Zephyr",   "wind"),
        new("b3",  "Solaris",  "sun"),
        new("b4",  "Lunar",    "moon"),
        new("b5",  "Atlas",    "globe"),
        new("b6",  "Facet",    "gem"),
        new("b7",  "Aquifer",  "droplets"),
        new("b8",  "Aperture", "camera"),
        new("b9",  "Codex",    "book"),
        new("b10", "Ember",    "flame"),
        new("b11", "Glimmer",  "sparkles"),
    ];

    private static readonly Logo[] _topRowDoubled =
    [
        .. _topRow,
        .. System.Linq.Enumerable.Select(_topRow, l => l with { IsDuplicate = true }),
    ];

    private static readonly Logo[] _bottomRowDoubled =
    [
        .. _bottomRow,
        .. System.Linq.Enumerable.Select(_bottomRow, l => l with { IsDuplicate = true }),
    ];
}
