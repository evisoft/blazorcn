@* ============================================================
   Block: logos-featured-focal-with-metric-trio
   Title: LogosFeaturedFocalWithMetricTrio
   Description: A featured focal logo block for React and Next.js with a flagship card on top, a stacked dashed divider, and a three-metric tabular row below using text-4xl tabular-nums built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-featured-focal-with-metric-trio.tsx
   ============================================================ *@

<section aria-label="Flagship partner" class="mx-auto w-full max-w-4xl p-4">
    <div class="py-14 sm:py-20">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Flagship partnership
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Backed by the numbers.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Our flagship partnership isn't decorative — it runs in production for hundreds of teams
                with an uptime guarantee you can bet a launch on.
            </p>
        </div>

        @* Central flagship card *@
        <div class="relative mx-auto mt-14 flex max-w-md flex-col items-center rounded-3xl border-2 border-foreground/15 bg-card px-10 py-12 shadow-md">
            <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                <span class="size-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
                @_featured.PartnershipLabel
            </span>

            <div class="mt-6 flex size-24 items-center justify-center rounded-3xl bg-foreground text-background shadow-sm">
                <LucideIconCn Name="@_featured.IconName" Size="56" Class="size-14" aria-hidden="true" />
            </div>

            <p class="mt-6 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">
                @_featured.Name
            </p>

            <p class="mt-3 text-sm text-muted-foreground">@_featured.TenureMetric</p>
        </div>

        @* Dashed connecting divider with centered label *@
        <div class="relative mt-12 flex items-center justify-center" aria-hidden="true">
            <div class="h-px w-full border-t border-dashed border-border"></div>
            <span class="absolute bg-background px-4 text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                By the numbers
            </span>
        </div>

        @* Metric trio row *@
        <dl class="mt-10 grid grid-cols-1 divide-y divide-border rounded-xl border bg-card shadow-sm sm:grid-cols-3 sm:divide-x sm:divide-y-0">
            @foreach (var metric in _metrics)
            {
                <div class="flex flex-col items-center justify-center px-6 py-10 text-center">
                    <dd class="text-4xl font-bold tabular-nums tracking-tight text-foreground sm:text-5xl">
                        @metric.Value
                    </dd>
                    <dt class="mt-3 text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                        @metric.Label
                    </dt>
                </div>
            }
        </dl>
    </div>
</section>

@code {
    private record FeaturedLogo(string Id, string Name, string IconName, string PartnershipLabel, string TenureMetric);
    private record Metric(string Id, string Value, string Label);

    private static readonly FeaturedLogo _featured = new(
        "central",
        "Halide",
        "shield",
        "Flagship partner",
        "Since 2019 · Trusted across every region"
    );

    private static readonly Metric[] _metrics =
    [
        new("m1", "500+",   "Teams in production"),
        new("m2", "99.99%", "Uptime guarantee"),
        new("m3", "2019",   "Partnership since"),
    ];
}
