@* ============================================================
   Block: logos-metric-ring-chart-with-logos
   Title: LogosMetricRingChartWithLogos
   Description: A metric ring chart logo block for React and Next.js with an inline SVG ring chart visualizing a percentage metric, centered tabular-nums count inside the ring, a supporting logo strip below, and a ShadcnioButton CTA pair built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-metric-ring-chart-with-logos.tsx
   ============================================================ *@

<section aria-label="Customer retention ring chart and logos"
         class="mx-auto w-full max-w-4xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Retention, not churn
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Teams that stick around.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Our flagship customers renew at rates the industry can barely pronounce. Here's what
                loyalty looks like at scale.
            </p>
        </div>

        @* Ring chart *@
        <div class="mt-12 flex flex-col items-center">
            <div class="relative">
                <svg role="img"
                     aria-label="@($"{MetricPercent} percent {MetricLabel}")"
                     viewBox="0 0 120 120"
                     class="size-40 sm:size-48">
                    <title>@($"{MetricPercent}% {MetricLabel}")</title>
                    @* Background ring *@
                    <circle cx="60"
                            cy="60"
                            r="@RingRadius"
                            fill="none"
                            stroke-width="8"
                            class="stroke-muted-foreground/20" />
                    @* Foreground arc *@
                    <circle cx="60"
                            cy="60"
                            r="@RingRadius"
                            fill="none"
                            stroke-width="8"
                            stroke-linecap="round"
                            transform="rotate(-90 60 60)"
                            stroke-dasharray="@RingCircumference.ToString("F3")"
                            stroke-dashoffset="@RingOffset.ToString("F3")"
                            class="stroke-foreground" />
                </svg>
                @* Center label *@
                <div aria-hidden="true"
                     class="pointer-events-none absolute inset-0 flex items-center justify-center">
                    <span class="text-3xl font-bold tabular-nums tracking-tight text-foreground sm:text-4xl">
                        @MetricPercent%
                    </span>
                </div>
            </div>

            <p class="mt-6 max-w-sm text-center text-sm leading-relaxed text-muted-foreground sm:text-base">
                @MetricLabel
            </p>

            <div class="mt-4 inline-flex items-center gap-2 rounded-full border bg-muted/30 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="tabular-nums">12,000+ teams renewing</span>
            </div>
        </div>

        @* Logo strip *@
        <ul aria-label="Customer logos"
            class="mt-12 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
            @foreach (var logo in _logos)
            {
                <li class="group flex items-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0 transition-transform duration-200 group-hover:scale-110" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>

        @* CTA pair *@
        <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full sm:w-[240px]">Read case studies</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full sm:w-[180px]">Book a demo</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private const int MetricPercent = 92;
    private const string MetricLabel = "customer retention, year over year";
    private const double RingRadius = 46;
    private static readonly double RingCircumference = 2 * Math.PI * RingRadius;
    private static readonly double RingOffset = RingCircumference - (MetricPercent / 100.0) * RingCircumference;

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",     "shield"),
        new("l2", "Northwind",  "compass"),
        new("l3", "Ion",        "atom"),
        new("l4", "LaunchPad",  "rocket"),
        new("l5", "Strata",     "layers"),
        new("l6", "Honeycomb",  "hexagon"),
    ];
}
