@* ============================================================
   Block: logos-ticker-inline-headline-strip
   Title: LogosTickerInlineHeadlineStrip
   Description: A creative inline logo headline strip for React and Next.js with six wordmark logos interspersed between the words of a single flowing trust sentence, no separate headline cluster, and a flex-wrap responsive fallback built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-ticker-inline-headline-strip.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-4xl p-4">
    <div class="py-12 sm:py-16">
        <p class="flex flex-wrap items-baseline justify-center gap-x-4 gap-y-3 text-xl font-medium leading-relaxed text-muted-foreground sm:text-2xl">
            @foreach (var part in _sentence)
            {
                if (part.Kind == "text")
                {
                    <span>@part.Text</span>
                }
                else
                {
                    <span class="group inline-flex items-center gap-1.5 text-foreground/80 transition-colors duration-200 hover:text-foreground">
                        <LucideIconCn Name="@part.IconName" Size="24" Class="size-6 shrink-0 transition-transform duration-200 group-hover:-translate-y-0.5 sm:size-7" aria-hidden="true" />
                        <span class="text-xl font-bold tracking-tight sm:text-2xl">@part.Name</span>
                    </span>
                }
            }
        </p>
    </div>
</section>

@code {
    private record SentencePart(string Kind, string Id, string Text, string IconName, string Name);

    private static readonly SentencePart[] _sentence =
    [
        new("text", "t1", "Trusted by",                         "",           ""),
        new("logo", "l1", "",                                   "shield",     "Bastion"),
        new("logo", "l2", "",                                   "compass",    "Meridian"),
        new("logo", "l3", "",                                   "star",       "Lodestar"),
        new("logo", "l4", "",                                   "tree-pine",  "Evergreen"),
        new("logo", "l5", "",                                   "mountain",   "Alpine"),
        new("logo", "l6", "",                                   "hexagon",    "Honeycomb"),
        new("text", "t2", "and thousands more engineering teams.", "",        ""),
    ];
}
