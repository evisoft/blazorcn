@* ============================================================
   Block: logos-static-grid-wall-bordered-cells
   Title: LogosStaticGridWallBorderedCells
   Description: A static grid wall logo block with bordered card cells for React and Next.js with twelve flagship partners arranged in a responsive two-to-four column grid, monochrome-to-color hover states, and staggered entrance animation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-static-grid-wall-bordered-cells.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Flagship partners
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The twelve teams defining our roadmap.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Each tile is a long-term design partner shipping production workloads on our platform
                every day of the week.
            </p>
        </div>

        @* Bordered grid wall *@
        <ul class="mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4">
            @foreach (var logo in _logos)
            {
                <li class="flex h-24 items-center justify-center gap-2.5 rounded-xl border bg-card text-muted-foreground transition-colors hover:border-foreground/20 hover:text-foreground">
                    <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                </li>
            }
        </ul>

    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("bc1",  "Halide",    "shield"),
        new("bc2",  "Northwind", "compass"),
        new("bc3",  "Ion",       "atom"),
        new("bc4",  "LaunchPad", "rocket"),
        new("bc5",  "Lumen",     "star"),
        new("bc6",  "Loam",      "tree-pine"),
        new("bc7",  "Strata",    "layers"),
        new("bc8",  "Honeycomb", "hexagon"),
        new("bc9",  "Bastion",   "key"),
        new("bc10", "Meridian",  "globe"),
        new("bc11", "Ember",     "flame"),
        new("bc12", "Facet",     "gem"),
    ];
}
