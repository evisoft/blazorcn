@* ============================================================
   Block: logos-dark-inset-split-headline
   Title: LogosDarkInsetSplitHeadline
   Description: A dark inset split headline logo block for React and Next.js with a rounded bg-foreground panel, an inverted left-aligned headline cluster plus ShadcnioButton primary and ghost CTAs, and a six-cell bordered logo grid on the right built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-dark-inset-split-headline.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="relative overflow-hidden rounded-2xl bg-foreground px-6 py-14 sm:px-10 sm:py-20">

        @* Top-right corner accent pill *@
        <div class="absolute right-6 top-6 hidden sm:block">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-background/15 bg-background/[0.05] px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-background/60">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-400"></span>
                Six flagships
            </span>
        </div>

        <div class="grid gap-12 lg:grid-cols-[5fr_6fr] lg:items-center lg:gap-16">

            @* Left: inverted headline cluster + CTAs *@
            <div>
                <p class="text-xs font-medium uppercase tracking-widest text-background/40">
                    Trusted worldwide
                </p>
                <h2 class="mt-3 text-3xl font-bold tracking-tight text-background sm:text-4xl lg:text-5xl">
                    The teams who refuse to ship slow.
                </h2>
                <p class="mt-4 max-w-xl text-base leading-relaxed text-background/60">
                    Six flagship customers span three continents and every stack — deploying thousands of
                    times a day on our platform.
                </p>

                @* CTA pair — dark variant *@
                <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                    <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[240px]">
                        Read case studies
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[180px]">
                        Book a demo
                    </ButtonCn>
                </div>
            </div>

            @* Right: six-cell bordered logo grid *@
            <ul class="grid grid-cols-2 gap-3 sm:grid-cols-2 lg:grid-cols-2">
                @foreach (var logo in _logos)
                {
                    <li class="group flex h-24 items-center justify-center gap-2.5 rounded-xl border border-background/15 bg-background/[0.05] text-background/60 transition-colors duration-200 hover:border-background/30 hover:bg-background/[0.08] hover:text-background">
                        <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0 transition-transform duration-200 group-hover:scale-110" aria-hidden="true" />
                        <span class="text-sm font-semibold whitespace-nowrap">@logo.Name</span>
                    </li>
                }
            </ul>

        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "LaunchPad", "rocket"),
        new("l5", "Strata",    "layers"),
        new("l6", "Honeycomb", "hexagon"),
    ];
}
