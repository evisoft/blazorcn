@* ============================================================
   Block: logos-tab-filtered-sidebar-nav
   Title: LogosTabFilteredSidebarNav
   Description: A tab-filtered logo grid for React and Next.js with a vertical sidebar navigation on desktop that collapses to a horizontal pill scroll on mobile, balanced six-logo rosters per category, a reserved minimum grid height, AnimatePresence crossfade, and monochrome-to-color hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-tab-filtered-sidebar-nav.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted across industries
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Browse by the industries we serve.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Pick a vertical from the sidebar to see the teams shipping with us in that sector today.
                Every category has production customers.
            </p>
        </div>

        @* Mobile horizontal pill scroll *@
        <nav aria-label="Filter logos by industry (mobile)" class="mt-10 lg:hidden">
            <div role="tablist" class="flex items-center gap-2 overflow-x-auto pb-2">
                @foreach (var cat in _categories)
                {
                    var catItem = cat;
                    var isActive = _active == catItem.Id;
                    <button
                        type="button"
                        role="tab"
                        aria-selected="@isActive"
                        aria-controls="tab-filtered-sidebar-nav-logos-tab-grid"
                        @onclick="@(() => SetActive(catItem.Id))"
                        class="@Cn.Merge("shrink-0 rounded-full border px-4 py-1.5 text-sm font-semibold transition-colors duration-200", isActive ? "border-foreground bg-foreground text-background shadow-sm" : "border-border text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                        @catItem.Label
                    </button>
                }
            </div>
        </nav>

        @* Desktop: sidebar + grid *@
        <div class="mt-10 grid gap-10 lg:grid-cols-[200px_1fr]">

            @* Sidebar nav *@
            <nav aria-label="Filter logos by industry" class="hidden lg:block">
                <p class="mb-3 text-[11px] font-medium uppercase tracking-widest text-muted-foreground">
                    Industries
                </p>
                <div role="tablist" class="flex flex-col gap-1">
                    @foreach (var cat in _categories)
                    {
                        var catItem = cat;
                        var isActive = _active == catItem.Id;
                        <button
                            type="button"
                            role="tab"
                            aria-selected="@isActive"
                            aria-controls="tab-filtered-sidebar-nav-logos-tab-grid"
                            @onclick="@(() => SetActive(catItem.Id))"
                            class="@Cn.Merge("w-full rounded-md border-l-2 px-3 py-2 text-left text-sm transition-colors duration-200", isActive ? "border-l-foreground bg-muted font-medium text-foreground" : "border-l-transparent font-normal text-muted-foreground hover:bg-muted/50 hover:text-foreground")">
                            @catItem.Label
                        </button>
                    }
                </div>
            </nav>

            @* Filtered grid with reserved min-height *@
            <div id="tab-filtered-sidebar-nav-logos-tab-grid" class="min-h-[280px]">
                <ul aria-label="@($"Customer logos in {(_active == "all" ? "all industries" : _active)}")" class="grid grid-cols-2 gap-6 sm:grid-cols-3 sm:gap-8">
                    @foreach (var logo in GetLogosForTab(_active))
                    {
                        <li class="group flex h-20 items-center justify-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                            <LucideIconCn Name="@logo.IconName" Size="28" Class="size-7 shrink-0 transition-transform group-hover:rotate-3" aria-hidden="true" />
                            <span class="text-sm font-semibold whitespace-nowrap">@logo.Name</span>
                        </li>
                    }
                </ul>
            </div>

        </div>
    </div>
</section>

@code {
    private record CategoryTab(string Id, string Label);
    private record LogoData(string Id, string Name, string IconName, string Category, bool Featured = false);

    private static readonly CategoryTab[] _categories =
    [
        new("all",       "All industries"),
        new("fintech",   "Fintech"),
        new("developer", "Developer tools"),
        new("climate",   "Climate"),
    ];

    private static readonly LogoData[] _logos =
    [
        // Fintech — 6
        new("l1",  "Halide",    "shield",    "fintech",   true),
        new("l2",  "Bastion",   "key",       "fintech",   true),
        new("l3",  "Meridian",  "compass",   "fintech"),
        new("l4",  "Strata",    "layers",    "fintech"),
        new("l5",  "Facet",     "gem",       "fintech"),
        new("l6",  "Atlas",     "globe",     "fintech"),
        // Developer — 6
        new("l7",  "Ion",       "atom",      "developer", true),
        new("l8",  "LaunchPad", "rocket",    "developer", true),
        new("l9",  "Honeycomb", "hexagon",   "developer"),
        new("l10", "Nocturne",  "moon",      "developer"),
        new("l11", "Glimmer",   "sparkles",  "developer"),
        new("l12", "Summit",    "mountain",  "developer"),
        // Climate — 6
        new("l13", "Loam",      "tree-pine", "climate",   true),
        new("l14", "Rookery",   "feather",   "climate",   true),
        new("l15", "Solaris",   "sun",       "climate"),
        new("l16", "Tidal",     "waves",     "climate"),
        new("l17", "Zephyr",    "wind",      "climate"),
        new("l18", "Aquifer",   "droplets",  "climate"),
        // Extra for all-tab filler
        new("l19", "Ember",     "flame",     "developer"),
        new("l20", "Lumen",     "star",      "fintech"),
    ];

    private string _active = "all";

    private void SetActive(string categoryId)
    {
        _active = categoryId;
    }

    private static LogoData[] GetLogosForTab(string active)
    {
        if (active == "all")
        {
            var featured = Array.FindAll(_logos, l => l.Featured);
            return featured.Length > 6 ? featured[..6] : featured;
        }
        var filtered = Array.FindAll(_logos, l => l.Category == active);
        return filtered.Length > 6 ? filtered[..6] : filtered;
    }
}
