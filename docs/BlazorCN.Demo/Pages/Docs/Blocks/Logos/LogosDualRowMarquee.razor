@* ============================================================
   Block: logos-dual-row-marquee
   Title: LogosDualRowMarquee
   Description: A dual row infinite marquee logo wall for React and Next.js with opposing scroll directions, distinct per-row speeds, gradient edge masks, reduced-motion handling, and monochrome-to-color hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-dual-row-marquee.tsx
   ============================================================ *@

<style>
    @@keyframes logos-dual-row-1-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    @@keyframes logos-dual-row-2-right {
        from { transform: translateX(-50%); }
        to { transform: translateX(0); }
    }
    @@media (prefers-reduced-motion: reduce) {
        [data-logos-dual-row="row-one"],
        [data-logos-dual-row="row-two"] {
            animation: none !important;
            transform: none !important;
        }
    }
</style>

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trusted worldwide
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Loved by teams at every scale.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Twenty-four thousand engineering teams across sixty countries trust our platform to
                deploy thousands of times a day.
            </p>
        </div>

        @* Dual marquee rows *@
        <div aria-hidden="true" class="relative mt-12 overflow-hidden py-4">
            @* Gradient edge masks *@
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent sm:w-40"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40"></div>

            <div class="space-y-8">

                @* Row One — scrolls left, 40s *@
                <div class="flex">
                    <div data-logos-dual-row="row-one"
                         class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                         style="animation-name: logos-dual-row-1-left; animation-duration: 40s; animation-timing-function: linear; animation-iteration-count: infinite;">
                        @foreach (var logo in _rowOneDoubled)
                        {
                            <div class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                                <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                <span class="text-sm font-semibold whitespace-nowrap">@logo.Name</span>
                            </div>
                        }
                    </div>
                </div>

                @* Row Two — scrolls right, 50s *@
                <div class="flex">
                    <div data-logos-dual-row="row-two"
                         class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                         style="animation-name: logos-dual-row-2-right; animation-duration: 50s; animation-timing-function: linear; animation-iteration-count: infinite;">
                        @foreach (var logo in _rowTwoDoubled)
                        {
                            <div class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                                <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                <span class="text-sm font-semibold whitespace-nowrap">@logo.Name</span>
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _rowOne =
    [
        new("r1-1",  "Halide",     "shield"),
        new("r1-2",  "Northwind",  "compass"),
        new("r1-3",  "Ion",        "atom"),
        new("r1-4",  "LaunchPad",  "rocket"),
        new("r1-5",  "Lumen",      "star"),
        new("r1-6",  "Loam",       "tree-pine"),
        new("r1-7",  "Strata",     "layers"),
        new("r1-8",  "Honeycomb",  "hexagon"),
        new("r1-9",  "Bastion",    "key"),
        new("r1-10", "Meridian",   "globe"),
        new("r1-11", "Ember",      "flame"),
        new("r1-12", "Rookery",    "feather"),
    ];

    private static readonly Logo[] _rowTwo =
    [
        new("r2-1",  "Telemark",   "mountain"),
        new("r2-2",  "Tidal",      "waves"),
        new("r2-3",  "Zephyr",     "wind"),
        new("r2-4",  "Solaris",    "sun"),
        new("r2-5",  "Glimmer",    "sparkles"),
        new("r2-6",  "Nocturne",   "moon"),
        new("r2-7",  "Plume",      "feather"),
        new("r2-8",  "Summit",     "mountain"),
        new("r2-9",  "Helios",     "sun"),
        new("r2-10", "Nucleo",     "atom"),
        new("r2-11", "Atlas",      "globe"),
        new("r2-12", "Citadel",    "shield"),
    ];

    private static readonly Logo[] _rowOneDoubled = [.. _rowOne, .. _rowOne];
    private static readonly Logo[] _rowTwoDoubled = [.. _rowTwo, .. _rowTwo];
}
