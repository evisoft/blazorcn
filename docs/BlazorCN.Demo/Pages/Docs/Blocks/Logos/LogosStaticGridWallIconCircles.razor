@* ============================================================
   Block: logos-static-grid-wall-icon-circles
   Title: LogosStaticGridWallIconCircles
   Description: An icon-only static grid wall logo block for React and Next.js with sixteen bordered circle cells rendering just the brand icon mark, a responsive three-to-eight column grid, and monochrome-to-color hover promotion built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-static-grid-wall-icon-circles.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">
        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                In production today
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                The teams shipping right now.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Sixteen engineering teams, sixteen distinct brand marks — every circle a company
                deploying with us at this moment.
            </p>
        </div>

        @* Icon-only circle grid wall *@
        <ul class="mx-auto mt-12 grid max-w-3xl grid-cols-3 gap-6 sm:grid-cols-4 sm:gap-8 lg:max-w-none lg:grid-cols-8">
            @foreach (var logo in _wall)
            {
                <li class="flex justify-center">
                    <div role="img"
                         aria-label="@logo.Name"
                         class="group flex size-16 items-center justify-center rounded-full border bg-card text-muted-foreground transition-colors duration-200 hover:border-foreground/20 hover:text-foreground">
                        <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0 transition-transform duration-200 group-hover:scale-110" aria-hidden="true" />
                    </div>
                </li>
            }
        </ul>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",    "shield"),
        new("l2",  "Northwind", "compass"),
        new("l3",  "Ion",       "atom"),
        new("l4",  "Rookery",   "feather"),
        new("l5",  "LaunchPad", "rocket"),
        new("l6",  "Lumen",     "star"),
        new("l7",  "Loam",      "tree-pine"),
        new("l8",  "Strata",    "layers"),
        new("l9",  "Telemark",  "mountain"),
        new("l10", "Bastion",   "key"),
        new("l11", "Honeycomb", "hexagon"),
        new("l12", "Tidal",     "waves"),
        new("l13", "Meridian",  "globe"),
        new("l14", "Ember",     "flame"),
        new("l15", "Nocturne",  "moon"),
        new("l16", "Solaris",   "sun"),
        new("l17", "Glimmer",   "sparkles"),
        new("l18", "Facet",     "gem"),
        new("l19", "Aquifer",   "droplets"),
        new("l20", "Aperture",  "camera"),
        new("l21", "Codex",     "book"),
        new("l22", "Anchor",    "anchor"),
    ];

    // Use first sixteen for the wall
    private Logo[] _wall => _logos[..16];
}
