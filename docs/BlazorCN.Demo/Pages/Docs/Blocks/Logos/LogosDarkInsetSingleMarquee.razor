@* ============================================================
   Block: logos-dark-inset-single-marquee
   Title: LogosDarkInsetSingleMarquee
   Description: A dark inset single row marquee logo block for React and Next.js with a rounded bg-foreground inverted panel, a single infinite row marquee at 45 seconds, dark edge masks using from-foreground to transparent, and inverted text colors with background opacity tiers built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-dark-inset-single-marquee.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <style>
        @@keyframes logos-dark-single-marquee-left {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }
        @@media (prefers-reduced-motion: reduce) {
            [data-logos-dark-single-marquee="true"] {
                animation: none !important;
                transform: none !important;
            }
        }
    </style>

    <div class="relative overflow-hidden rounded-2xl bg-foreground px-6 py-14 sm:px-10 sm:py-20">
        @* Top-right corner accent pill *@
        <div class="absolute right-6 top-6 hidden sm:block">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-background/15 bg-background/[0.05] px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-background/60">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-400"></span>
                Live worldwide
            </span>
        </div>

        @* Inverted marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-background/40">
                Trusted in motion
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight text-background sm:text-4xl lg:text-5xl">
                The teams never stop shipping.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-background/60">
                A continuous roll call of the engineering teams deploying on our platform — around the
                clock, around the world.
            </p>
        </div>

        @* Single marquee row *@
        <div class="relative mt-12 overflow-hidden">
            @* Left edge mask *@
            <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-y-0 left-0 z-10 w-20 bg-gradient-to-r from-foreground to-transparent sm:w-32">
            </div>
            @* Right edge mask *@
            <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-y-0 right-0 z-10 w-20 bg-gradient-to-l from-foreground to-transparent sm:w-32">
            </div>

            <ul
                data-logos-dark-single-marquee="true"
                class="flex w-max items-center gap-12 sm:gap-16"
                style="animation: logos-dark-single-marquee-left 45s linear infinite;">
                @foreach (var logo in _doubled)
                {
                    <li class="group flex shrink-0 items-center gap-2.5 text-background/60 transition-colors duration-200 hover:text-background">
                        <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0 transition-colors duration-200 group-hover:text-background" aria-hidden="true" />
                        <span class="whitespace-nowrap text-sm font-semibold text-background/80 transition-colors duration-200 group-hover:text-background">
                            @logo.Name
                        </span>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _logos =
    [
        new("l1",  "Halide",    "shield"),
        new("l2",  "Northwind", "compass"),
        new("l3",  "Ion",       "atom"),
        new("l4",  "Rookery",   "feather"),
        new("l5",  "LaunchPad", "rocket"),
        new("l6",  "Lumen",     "star"),
        new("l7",  "Loam",      "tree-pine"),
        new("l8",  "Strata",    "layers"),
        new("l9",  "Telemark",  "mountain"),
        new("l10", "Bastion",   "key"),
        new("l11", "Honeycomb", "hexagon"),
        new("l12", "Ember",     "flame"),
    ];

    private static readonly Logo[] _doubled = [.._logos, .._logos];
}
