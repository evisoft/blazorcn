@* ============================================================
   Block: logos-dual-marquee-mixed-variants
   Title: LogosDualMarqueeMixedVariants
   Description: A dual row infinite marquee logo wall for React and Next.js mixing icon-plus-wordmark cells in the top row with icon-only badge chips in the bottom row, opposing directions, gradient edge masks, and reduced-motion handling built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-dual-marquee-mixed-variants.tsx
   ============================================================ *@

<style>
    @@keyframes logos-mixed-cell-row-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    @@keyframes logos-mixed-badge-row-right {
        from { transform: translateX(-50%); }
        to { transform: translateX(0); }
    }
    @@media (prefers-reduced-motion: reduce) {
        [data-logos-mixed="cell-row"],
        [data-logos-mixed="badge-row"] {
            animation: none !important;
            transform: none !important;
        }
    }
</style>

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Partner network
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Two ways to say the same thing.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                A row of named partners above, a row of recognizable marks below — twenty-six brands
                that ship with us every day.
            </p>
        </div>

        @* Mixed variant dual marquee rows *@
        <div aria-hidden="true" class="relative mt-12 overflow-hidden py-4">
            @* Gradient edge masks *@
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent sm:w-40"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40"></div>

            <div class="space-y-8">

                @* Cell row — icon + wordmark, scrolls left at 40s *@
                <div class="flex">
                    <div data-logos-mixed="cell-row"
                         class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                         style="animation: logos-mixed-cell-row-left 40s linear infinite;">
                        @foreach (var logo in _doubledCellRow)
                        {
                            <div class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                                <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                            </div>
                        }
                    </div>
                </div>

                @* Badge row — icon-only rounded chips, scrolls right at 50s *@
                <div class="flex">
                    <div data-logos-mixed="badge-row"
                         class="flex w-max shrink-0 items-center gap-6 sm:gap-8"
                         style="animation: logos-mixed-badge-row-right 50s linear infinite;">
                        @foreach (var logo in _doubledBadgeRow)
                        {
                            <div role="img"
                                 aria-label="@logo.Name"
                                 class="group flex size-12 shrink-0 items-center justify-center rounded-full border bg-card text-muted-foreground transition-colors hover:border-foreground/20 hover:text-foreground">
                                <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 transition-transform group-hover:scale-110" aria-hidden="true" />
                            </div>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _cellRow =
    [
        new("c-1",  "Halide",     "shield"),
        new("c-2",  "Northwind",  "compass"),
        new("c-3",  "Ion",        "atom"),
        new("c-4",  "LaunchPad",  "rocket"),
        new("c-5",  "Lumen",      "star"),
        new("c-6",  "Loam",       "tree-pine"),
        new("c-7",  "Strata",     "layers"),
        new("c-8",  "Honeycomb",  "hexagon"),
        new("c-9",  "Bastion",    "key"),
        new("c-10", "Meridian",   "globe"),
        new("c-11", "Ember",      "flame"),
        new("c-12", "Rookery",    "feather"),
    ];

    private static readonly Logo[] _badgeRow =
    [
        new("b-1",  "Telemark",  "mountain"),
        new("b-2",  "Tidal",     "waves"),
        new("b-3",  "Zephyr",    "wind"),
        new("b-4",  "Solaris",   "sun"),
        new("b-5",  "Glimmer",   "sparkles"),
        new("b-6",  "Nocturne",  "moon"),
        new("b-7",  "Plume",     "feather"),
        new("b-8",  "Facet",     "gem"),
        new("b-9",  "Aquifer",   "droplets"),
        new("b-10", "Aperture",  "camera"),
        new("b-11", "Codex",     "book"),
        new("b-12", "Atlas",     "globe"),
