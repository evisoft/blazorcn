@* ============================================================
   Block: logos-dual-marquee-fast-slow-speeds
   Title: LogosDualMarqueeFastSlowSpeeds
   Description: A dual row infinite marquee logo wall for React and Next.js with dramatic fast and slow row speed contrast, opposing directions, gradient edge masks, and reduced-motion handling built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-dual-marquee-fast-slow-speeds.tsx
   ============================================================ *@

<style>
    @@keyframes logos-speed-fast-row-left {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }
    @@keyframes logos-speed-slow-row-right {
        from { transform: translateX(-50%); }
        to { transform: translateX(0); }
    }
    @@media (prefers-reduced-motion: reduce) {
        [data-logos-speed-dual="fast-row"],
        [data-logos-speed-dual="slow-row"] {
            animation: none !important;
            transform: none !important;
        }
    }
</style>

<section aria-label="Customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Kinetic proof
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Move fast. Build at scale.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                The teams shipping at every tempo — from weekly cadence startups to daily-deploy public
                companies — all run on the same platform.
            </p>
        </div>

        @* Fast-slow dual marquee rows *@
        <div aria-hidden="true" class="relative mt-12 overflow-hidden py-4">
            @* Gradient edge masks *@
            <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 bg-gradient-to-r from-background to-transparent sm:w-40"></div>
            <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 bg-gradient-to-l from-background to-transparent sm:w-40"></div>

            <div class="space-y-8">

                @* Fast row — scrolls left, 30s *@
                <div class="flex">
                    <ul data-logos-speed-dual="fast-row"
                        class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                        style="animation: logos-speed-fast-row-left 30s linear infinite;">
                        @foreach (var logo in _doubledFastRow)
                        {
                            <li class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                                <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                            </li>
                        }
                    </ul>
                </div>

                @* Slow row — scrolls right, 70s *@
                <div class="flex">
                    <ul data-logos-speed-dual="slow-row"
                        class="flex w-max shrink-0 items-center gap-12 sm:gap-16"
                        style="animation: logos-speed-slow-row-right 70s linear infinite;">
                        @foreach (var logo in _doubledSlowRow)
                        {
                            <li class="flex items-center gap-2.5 text-muted-foreground transition-colors hover:text-foreground">
                                <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                                <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                            </li>
                        }
                    </ul>
                </div>

            </div>
        </div>

    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private static readonly Logo[] _fastRow =
    [
        new("f-1",  "Apogee",    "rocket"),
        new("f-2",  "Stellar",   "star"),
        new("f-3",  "Zephyr",    "wind"),
        new("f-4",  "Ion",       "atom"),
        new("f-5",  "Boost",     "rocket"),
        new("f-6",  "Tesla",     "atom"),
        new("f-7",  "Pyre",      "flame"),
        new("f-8",  "Spark",     "sparkles"),
        new("f-9",  "Gale",      "wind"),
        new("f-10", "Lumen",     "star"),
        new("f-11", "Trajector", "rocket"),
        new("f-12", "Kindle",    "sparkles"),
    ];

    private static readonly Logo[] _slowRow =
    [
        new("s-1",  "Bedrock",   "layers"),
        new("s-2",  "Heartwood", "tree-pine"),
        new("s-3",  "Alpine",    "mountain"),
        new("s-4",  "Cairn",     "mountain"),
        new("s-5",  "Reservoir", "droplets"),
        new("s-6",  "Canopy",    "tree-pine"),
        new("s-7",  "Sediment",  "layers"),
        new("s-8",  "Halcyon",   "moon"),
        new("s-9",  "Lapidary",  "gem"),
        new("s-10", "Tome",      "hexagon"),
        new("s-11", "Summit",    "mountain"),
        new("s-12", "Evergreen", "tree-pine"),
    ];

    private static readonly Logo[] _doubledFastRow = [.. _fastRow, .. _fastRow];
    private static readonly Logo[] _doubledSlowRow = [.. _slowRow, .. _slowRow];
}
