@* ============================================================
   Block: logos-bento-with-compliance-cells
   Title: LogosBentoWithComplianceCells
   Description: A bento featured case study logo block for React and Next.js with a tall featured cell plus four compliance-focused supporting cells each carrying an emerald check badge, compliance standard name, and context line built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-bento-with-compliance-cells.tsx
   ============================================================ *@

<section aria-label="Customer logos and compliance" class="mx-auto w-full max-w-6xl p-4">
    <div class="py-12 sm:py-16">

        @* Marketing headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                Trust and compliance
            </p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
                Zero audit findings. Four certifications.
            </h2>
            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-muted-foreground">
                Aegis passed their audit with zero findings this year — because every control is
                enforced by the platform, not a checklist.
            </p>
        </div>

        @* Bento grid: 3 cols x 2 rows *@
        <div class="mt-12 grid gap-4 sm:grid-cols-3 sm:grid-rows-2">

            @* Featured cell *@
            <figure class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border-2 border-foreground/15 bg-card p-8 shadow-sm sm:col-span-1 sm:row-span-2">

                @* Corner accent *@
                <div aria-hidden="true" class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Case study
                </div>

                @* Top: logo + name + industry *@
                <div>
                    <div class="flex size-14 items-center justify-center rounded-2xl bg-foreground text-background shadow-sm">
                        <LucideIconCn Name="shield" Size="28" Class="size-7" aria-hidden="true" />
                    </div>
                    <p class="mt-5 text-2xl font-bold tracking-tight text-foreground">
                        @_featured.Name
                    </p>
                    <p class="mt-1 text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        @_featured.Industry
                    </p>
                </div>

                @* Quote *@
                <blockquote class="mt-6 text-base leading-relaxed text-foreground">
                    &ldquo;@_featured.Quote&rdquo;
                </blockquote>

                @* Metric highlight *@
                <div class="mt-6 flex items-baseline gap-3 border-t pt-5">
                    <p class="text-4xl font-bold tracking-tight tabular-nums text-foreground">
                        @_featured.Metric
                    </p>
                    <p class="text-sm text-muted-foreground">@_featured.MetricLabel</p>
                </div>

                @* Attribution *@
                <div class="mt-5 flex items-end justify-between gap-3 border-t pt-5">
                    <figcaption class="flex min-w-0 items-center gap-3">
                        <div aria-hidden="true" class="flex size-10 shrink-0 items-center justify-center rounded-full border bg-muted font-mono text-xs font-semibold text-muted-foreground">
                            @_featured.AuthorInitials
                        </div>
                        <div class="min-w-0">
                            <p class="truncate text-sm font-semibold text-foreground">
                                @_featured.AuthorName
                            </p>
                            <p class="truncate text-xs text-muted-foreground">@_featured.AuthorRole</p>
                        </div>
                    </figcaption>
                    <span aria-hidden="true" class="inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-foreground opacity-60 transition-opacity group-hover:opacity-100">
                        Read
                        <LucideIconCn Name="arrow-up-right" Size="14" Class="size-3.5" />
                    </span>
                </div>
            </figure>

            @* Compliance cells — 4 in a 2x2 block *@
            @foreach (var cell in _compliance)
            {
                <div class="group flex flex-col justify-between gap-5 rounded-2xl border bg-card p-6 transition-colors hover:border-emerald-500/30 hover:shadow-sm">

                    @* Top: emerald check badge + "Certified" pill *@
                    <div class="flex items-start justify-between gap-3">
                        <div class="flex size-11 items-center justify-center rounded-xl border border-emerald-500/20 bg-emerald-500/10 transition-colors group-hover:border-emerald-500/40 group-hover:bg-emerald-500/15">
                            <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
                        </div>
                        <span class="inline-flex items-center gap-1.5 rounded-full border bg-muted/50 px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                            <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-500"></span>
                            Certified
                        </span>
                    </div>

                    @* Bottom: compliance name + context *@
                    <div>
                        <p class="text-base font-semibold text-foreground">@cell.Title</p>
                        <p class="mt-1.5 text-xs text-muted-foreground">@cell.Context</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FeaturedData(
        string Name,
        string Industry,
        string Quote,
        string Metric,
        string MetricLabel,
        string AuthorName,
        string AuthorRole,
        string AuthorInitials
    );

    private record ComplianceCell(string Id, string Title, string Context);

    private static readonly FeaturedData _featured = new(
        Name: "Aegis",
        Industry: "Healthcare",
        Quote: "Passing our SOC 2 audit went from a six-month fire drill to a weekly automated report. Our auditor sent us a compliment this year.",
        Metric: "0",
        MetricLabel: "audit findings in 2025",
        AuthorName: "Emi Takeda",
        AuthorRole: "Head of Security · Aegis",
        AuthorInitials: "ET"
    );

    private static readonly ComplianceCell[] _compliance =
    [
        new("c1", "SOC 2 Type II", "Annual audit since 2020"),
        new("c2", "ISO 27001",     "International certified"),
        new("c3", "HIPAA",         "Healthcare compliant"),
        new("c4", "GDPR",          "EU data sovereignty"),
    ];
}
