@* ============================================================
   Block: logos-minimalist-eyebrow-split-strip
   Title: LogosMinimalistEyebrowSplitStrip
   Description: A minimalist split horizontal logo strip for React and Next.js with a left-aligned TRUSTED BY eyebrow label, a right-aligned flex-wrap row of six placeholder logo marks, and monochrome-to-color hover states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-minimalist-eyebrow-split-strip.tsx
   ============================================================ *@

<section aria-label="Customer logos" class="mx-auto w-full max-w-4xl p-4">
    <div class="py-8 sm:py-12">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-10 md:gap-12">
            @* Left-aligned eyebrow — anchored with right border on md+ *@
            <div class="shrink-0 md:border-r md:pr-12">
                <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">
                    @_eyebrow
                </p>
                <p class="mt-1.5 text-[11px] tabular-nums text-muted-foreground/80">
                    6 partners · since 2019
                </p>
            </div>

            @* Right-aligned flex-wrap logo row *@
            <ul aria-label="Customer logos" class="flex flex-1 flex-wrap items-center gap-x-8 gap-y-5 sm:justify-end">
                @foreach (var logo in _logos)
                {
                    <li class="flex items-center gap-2.5 text-muted-foreground transition-colors duration-200 hover:text-foreground">
                        <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0" aria-hidden="true" />
                        <span class="whitespace-nowrap text-sm font-semibold">@logo.Name</span>
                    </li>
                }
            </ul>
        </div>
    </div>
</section>

@code {
    private record Logo(string Id, string Name, string IconName);

    private const string _eyebrow = "Trusted by";

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "Rookery",   "feather"),
        new("l5", "LaunchPad", "rocket"),
        new("l6", "Loam",      "tree-pine"),
    ];
}
