@* ============================================================
   Block: logos-dark-inset-metric-hero
   Title: LogosDarkInsetMetricHero
   Description: A dark inset metric hero logo block for React and Next.js with a rounded bg-foreground inverted panel, a hero-scale tabular-nums count headline, a secondary metric chip row with background opacity dividers, a logo strip of eight inverted marks, and inverted primary plus ghost ShadcnioButton CTAs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/logos/logos-dark-inset-metric-hero.tsx
   ============================================================ *@

<section aria-label="Scale metrics and customer logos" class="mx-auto w-full max-w-6xl p-4">
    <div class="relative overflow-hidden rounded-2xl bg-foreground px-6 py-14 sm:px-10 sm:py-20">

        @* Top-right corner accent pill *@
        <div class="absolute right-6 top-6 hidden sm:block">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-background/15 bg-background/[0.05] px-3 py-1 text-[11px] font-medium uppercase tracking-wider text-background/60">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-emerald-400"></span>
                Updated daily
            </span>
        </div>

        @* Inverted metric headline cluster *@
        <div class="mx-auto max-w-2xl text-center">
            <p class="text-xs font-medium uppercase tracking-widest text-background/40">
                By the numbers
            </p>

            <p class="mt-4 text-5xl font-bold tracking-tight tabular-nums text-background sm:text-6xl lg:text-7xl">
                @_metricValue<span class="text-background/60">@_metricSuffix</span>
            </p>

            <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-background/60 sm:text-lg">
                @_metricLabel
            </p>
        </div>

        @* Secondary metric chip row *@
        <div class="mt-8 flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
            @foreach (var entry in _secondaryMetrics)
            {
                var metric = entry;
                var idx = System.Array.IndexOf(_secondaryMetrics, metric);
                <div class="flex items-center gap-x-8">
                    <div class="flex items-baseline gap-2">
                        <span class="text-2xl font-bold tabular-nums tracking-tight text-background">
                            @metric.Value
                        </span>
                        <span class="text-xs text-background/60">@metric.Label</span>
                    </div>
                    @if (idx < _secondaryMetrics.Length - 1)
                    {
                        <span aria-hidden="true" class="hidden h-4 w-px bg-background/15 sm:inline-block"></span>
                    }
                </div>
            }
        </div>

        @* Logo strip *@
        <ul aria-label="Customer logos" class="mt-12 flex flex-wrap items-center justify-center gap-x-10 gap-y-6">
            @foreach (var logo in _logos)
            {
                <li class="group flex items-center gap-2.5 text-background/60 transition-colors duration-200 hover:text-background">
                    <LucideIconCn Name="@logo.IconName" Size="24" Class="size-6 shrink-0 transition-colors duration-200 group-hover:text-background" aria-hidden="true" />
                    <span class="whitespace-nowrap text-sm font-semibold text-background/80 transition-colors duration-200 group-hover:text-background">
                        @logo.Name
                    </span>
                </li>
            }
        </ul>

        @* CTA pair — dark variant *@
        <div class="mt-12 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
            <ButtonCn Class="w-full bg-background text-foreground hover:bg-background/90 sm:w-[240px]">
                Read case studies
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full border border-background/20 bg-transparent text-background hover:bg-background/10 hover:text-background sm:w-[180px]">
                Book a demo
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record SecondaryMetric(string Id, string Value, string Label);
    private record Logo(string Id, string Name, string IconName);

    private const string _metricValue = "12,000";
    private const string _metricSuffix = "+";
    private const string _metricLabel = "engineering teams ship with us every day";

    private static readonly SecondaryMetric[] _secondaryMetrics =
    [
        new("countries", "60",     "countries"),
        new("uptime",    "99.99%", "uptime"),
        new("since",     "2019",   "shipping since"),
    ];

    private static readonly Logo[] _logos =
    [
        new("l1", "Halide",    "shield"),
        new("l2", "Northwind", "compass"),
        new("l3", "Ion",       "atom"),
        new("l4", "Rookery",   "feather"),
        new("l5", "LaunchPad", "rocket"),
        new("l6", "Loam",      "tree-pine"),
        new("l7", "Strata",    "layers"),
        new("l8", "Honeycomb", "hexagon"),
    ];
}
