@* ============================================================
   Block: onboarding-privacy-controls
   Title: OnboardingPrivacyControls
   Description: Privacy settings onboarding with toggle switches, privacy level indicator, and save action for React and Next.js apps built with shadcn/ui and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-privacy-controls.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Privacy Settings</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Control how your data is used and shared. Disabling options increases your privacy
                level.
            </p>
        </div>

        @* Privacy level indicator *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Privacy level</span>
            <span class="@($"size-1.5 rounded-full {PrivacyLevel.Dot}")"></span>
            <span class="@($"font-medium text-xs {PrivacyLevel.Color}")">@PrivacyLevel.Label</span>
            <span class="ml-auto text-muted-foreground text-xs">
                @EnabledCount of @_options.Length sharing options enabled
            </span>
        </div>

        @* Toggle Rows *@
        <div>
            @for (var i = 0; i < _options.Length; i++)
            {
                var opt = _options[i];
                var isLast = i == _options.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <label for="@($"privacy-{opt.Id}")" class="flex cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50 text-muted-foreground" aria-hidden="true">
                            <LucideIconCn Name="@opt.IconName" Size="16" Class="size-4" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@opt.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@opt.Description</p>
                        </div>
                        <SwitchCn Id="@($"privacy-{opt.Id}")" Checked="@opt.Enabled" CheckedChanged="@(() => ToggleOption(opt.Id))" />
                    </label>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-end border-t px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">Save Privacy Settings</ButtonCn>
        </div>
    </div>
</section>

@code {
    private class PrivacyOption
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public string IconName { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private class PrivacyLevelInfo
    {
        public string Label { get; set; } = "";
        public string Color { get; set; } = "";
        public string Dot { get; set; } = "";
    }

    private readonly PrivacyOption[] _options =
    [
        new() { Id = "analytics",        Label = "Share usage analytics",          Description = "Help us improve by sharing anonymous usage data",      IconName = "line-chart",  Enabled = true  },
        new() { Id = "recommendations",  Label = "Personalized recommendations",   Description = "Allow us to tailor content based on your activity",    IconName = "sparkles",    Enabled = true  },
        new() { Id = "third-party",      Label = "Third-party integrations data",  Description = "Share data with connected third-party services",       IconName = "globe",       Enabled = false },
        new() { Id = "public-profile",   Label = "Public profile visibility",      Description = "Make your profile visible to other users on the platform", IconName = "eye",    Enabled = false },
    ];

    private int EnabledCount => _options.Count(o => o.Enabled);

    private PrivacyLevelInfo PrivacyLevel => GetPrivacyLevel(EnabledCount);

    private static PrivacyLevelInfo GetPrivacyLevel(int enabledCount)
    {
        if (enabledCount <= 1)
            return new() { Label = "High",   Color = "text-emerald-600 dark:text-emerald-400", Dot = "bg-emerald-500" };
        if (enabledCount <= 2)
            return new() { Label = "Medium", Color = "text-amber-600 dark:text-amber-400",     Dot = "bg-amber-500"   };
        return     new() { Label = "Low",    Color = "text-red-600 dark:text-red-400",          Dot = "bg-red-500"     };
    }

    private void ToggleOption(string id)
    {
        var opt = _options.FirstOrDefault(o => o.Id == id);
        if (opt != null) opt.Enabled = !opt.Enabled;
    }
}
