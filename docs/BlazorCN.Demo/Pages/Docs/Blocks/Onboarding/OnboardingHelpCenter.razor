@* ============================================================
   Block: onboarding-help-center
   Title: OnboardingHelpCenter
   Description: A help resources onboarding component for React and Next.js with documentation, video tutorials, community forum, and support links built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-help-center.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="life-buoy" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Help Center</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Here are some resources to help you get the most out of your workspace.
            </p>
        </div>

        @* Resource links *@
        <div>
            @foreach (var res in _resources)
            {
                var item = res;
                var isLast = item.Id == _resources[_resources.Length - 1].Id;
                <div class="@(!isLast ? "border-b" : "")">
                    <a href="@item.Href" class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="@item.Icon" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@item.Title</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                        </div>
                        <LucideIconCn Name="arrow-up-right" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                    </a>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-end border-t px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">I'm ready, skip help</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record HelpResource(string Id, string Icon, string Title, string Description, string Href);

    private static readonly HelpResource[] _resources =
    [
        new("docs",      "book-open",       "Documentation",    "Guides, API reference, and best practices for every feature", "#"),
        new("videos",    "play-circle",     "Video tutorials",  "Step-by-step walkthroughs for common workflows",              "#"),
        new("community", "message-circle",  "Community forum",  "Ask questions and share tips with other users",               "#"),
        new("support",   "life-buoy",       "Contact support",  "Reach our team for help with your account or billing",        "#"),
    ];
}
