@* ============================================================
   Block: onboarding-invite-link
   Title: OnboardingInviteLink
   Description: A shareable invite link onboarding component for React and Next.js with copyable link display, regenerate action, and share counter built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-invite-link.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="link-2" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Invite Link</span>
            </div>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Share this link with your team. Anyone with the link can join your workspace directly.
            </p>
        </div>

        @* Invite link display *@
        <div class="border-b px-4 py-3">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                Your invite link
            </span>
            <div class="flex items-center gap-2">
                <div class="min-w-0 flex-1 overflow-x-auto rounded-md bg-muted/50 px-3 py-2">
                    <code class="whitespace-nowrap font-mono text-xs">@_inviteLink</code>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1 px-2 text-xs"
                          OnClick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Share stats + regenerate *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                    <span>0 people joined via this link</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                Regenerate
            </ButtonCn>
        </div>

        @* Expiry info *@
        <div class="flex items-center justify-between px-4 py-3">
            <span class="text-muted-foreground text-xs">
                This link expires in 7 days. Regenerate to create a new one.
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Continue
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private const string _inviteLink = "https://acme.co/invite/wks-a3f8c2d1e9b7";
    private bool _copied = false;
    private System.Threading.CancellationTokenSource? _copyCts;

    private async Task HandleCopy()
    {
        _copied = true;
        _copyCts?.Cancel();
        _copyCts = new System.Threading.CancellationTokenSource();
        var cts = _copyCts;
        try
        {
            await Task.Delay(2000, cts.Token);
            _copied = false;
        }
        catch (TaskCanceledException)
        {
            // cancelled by a subsequent copy; ignore
        }
    }
}
