@* ============================================================
   Block: onboarding-webhook-setup
   Title: OnboardingWebhookSetup
   Description: A React and Next.js webhook configuration onboarding block with URL input, event type selector, test delivery button with status indicators, and test log display built with TypeScript, shadcn/ui, and Tailwind CSS for API integration setup.
   Source: original/blocks/onboarding/onboarding-webhook-setup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="link" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Webhook Setup</span>
            </div>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Enter your webhook endpoint URL and select which events to send. Test the connection
                before saving.
            </p>
        </div>

        @* URL input *@
        <div class="border-b px-4 py-3">
            <label for="webhook-url" class="mb-1.5 block font-medium text-muted-foreground text-xs">
                Endpoint URL
            </label>
            <InputCn id="webhook-url" type="url" Placeholder="https://your-api.com/webhooks"
                     @bind-Value="_url" Class="h-8 font-mono text-xs" />
        </div>

        @* Event type + test *@
        <div class="flex items-end gap-2 border-b px-4 py-3">
            <div class="flex-1">
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                    Event type
                </span>
                <SelectCn Value="@_eventType" ValueChanged="@((string v) => _eventType = v)">
                    <SelectTriggerCn Class="h-8 text-xs" aria-label="Event type">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var evType in _eventTypes)
                        {
                            <SelectItemCn Value="@evType.Value" Class="text-xs">@evType.Label</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs"
                          @onclick="HandleTest" Disabled="@(string.IsNullOrWhiteSpace(_url))">
                    Test Webhook
                </ButtonCn>
                @if (_testResult == "success")
                {
                    <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                }
                @if (_testResult == "failed")
                {
                    <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-500" />
                }
            </div>
        </div>

        @* Test log *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent tests</span>
            </div>
            @for (int i = 0; i < _testLogs.Length; i++)
            {
                var log = _testLogs[i];
                var isLast = i == _testLogs.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _statusDot.ContainsKey(log.Status) ? _statusDot[log.Status] : "")"
                          aria-hidden="true"></span>
                    <span class="min-w-0 flex-1 truncate font-mono text-muted-foreground text-xs">
                        @log.Event
                    </span>
                    <span class="shrink-0 text-muted-foreground text-xs">@log.Time</span>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Skip
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs"
                      Disabled="@(string.IsNullOrWhiteSpace(_url))">
                Save Webhook
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record EventTypeItem(string Value, string Label);

    private record TestLogEntry(string Id, string Url, string Status, string Event, string Time);

    private static readonly EventTypeItem[] _eventTypes =
    [
        new("all", "All events"),
        new("user.created", "New user"),
        new("payment.completed", "Payment"),
        new("error.triggered", "Error"),
    ];

    private static readonly TestLogEntry[] _testLogs =
    [
        new("log1", "https://api.acme.co/webhooks", "success", "payment.completed", "2 min ago"),
        new("log2", "https://api.acme.co/webhooks", "failed", "user.created", "5 min ago"),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["success"] = "bg-emerald-500",
        ["failed"] = "bg-red-500",
    };

    private string _url = "https://api.acme.co/webhooks";
    private string _eventType = "all";
    private string _testResult = "idle";

    private void HandleTest()
    {
        _testResult = "success";
    }
}
