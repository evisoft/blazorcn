@* ============================================================
   Block: onboarding-brand-kit
   Title: OnboardingBrandKit
   Description: A React brand kit onboarding block for Next.js with logo upload, hex color inputs, font selector, and live preview. Built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-brand-kit.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="palette" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Brand Kit</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Upload your brand assets to customize the look and feel of your workspace.
            </p>
        </div>

        @* Logo upload *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Logo</span>
            <div class="flex items-center justify-center rounded-md border border-dashed p-6">
                <div class="text-center">
                    <LucideIconCn Name="upload" Size="20" Class="mx-auto size-5 text-muted-foreground/60" />
                    <p class="mt-2 text-muted-foreground text-xs">
                        Drop your logo here or click to upload
                    </p>
                    <p class="mt-0.5 text-muted-foreground/60 text-xs">SVG, PNG up to 2MB</p>
                </div>
            </div>
        </div>

        @* Brand colors *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Brand colors</span>
            <div class="space-y-2">
                <div class="flex items-center gap-3">
                    <div class="size-6 shrink-0 rounded border" style="@($"background-color:{_primaryColor}")"></div>
                    <div class="min-w-0 flex-1">
                        <label for="color-primary" class="mb-1 block text-muted-foreground text-xs">Primary</label>
                        <InputCn
                            id="color-primary"
                            @bind-Value="_primaryColor"
                            Placeholder="#000000"
                            Class="h-7 font-mono text-xs border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <div class="size-6 shrink-0 rounded border" style="@($"background-color:{_secondaryColor}")"></div>
                    <div class="min-w-0 flex-1">
                        <label for="color-secondary" class="mb-1 block text-muted-foreground text-xs">Secondary</label>
                        <InputCn
                            id="color-secondary"
                            @bind-Value="_secondaryColor"
                            Placeholder="#6366F1"
                            Class="h-7 font-mono text-xs border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                    </div>
                </div>
            </div>
        </div>

        @* Font selection *@
        <div class="border-b px-4 py-3">
            <label for="brand-font" class="mb-2 block font-medium text-muted-foreground text-xs">Font family</label>
            <SelectCn TValue="string" @bind-Value="_font">
                <SelectTriggerCn id="brand-font" Class="h-8 text-xs">
                    <SelectValueCn Placeholder="Select a font" />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var opt in _fontOptions)
                    {
                        var optVal = opt.Value;
                        <SelectItemCn Value="@optVal" Class="text-xs">@opt.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Preview *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Preview</span>
            <div class="flex items-center gap-3 rounded-md bg-muted/50 p-3">
                <div class="flex size-10 shrink-0 items-center justify-center rounded-md border border-dashed">
                    <span class="text-muted-foreground/60 text-xs">Logo</span>
                </div>
                <div class="flex items-center gap-2">
                    <div class="size-5 rounded border" style="@($"background-color:{_primaryColor}")"></div>
                    <div class="size-5 rounded border" style="@($"background-color:{_secondaryColor}")"></div>
                    <span class="ml-1 text-muted-foreground text-xs">@_activeFontLabel</span>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                Skip
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                Save Brand Kit
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record FontOption(string Value, string Label);

    private static readonly FontOption[] _fontOptions =
    [
        new("inter",        "Inter"),
        new("dm-sans",      "DM Sans"),
        new("geist",        "Geist"),
        new("plus-jakarta", "Plus Jakarta Sans"),
    ];

    private string _primaryColor   = "#0F172A";
    private string _secondaryColor = "#6366F1";
    private string _font           = "inter";

    private string _activeFontLabel =>
        Array.Find(_fontOptions, f => f.Value == _font)?.Label ?? "Inter";
}
