@* ============================================================
   Block: onboarding-learning-path
   Title: OnboardingLearningPath
   Description: Course track selector with quick start, full course, and self-paced exploration options for React and Next.js. Built with TypeScript, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-learning-path.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="graduation-cap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Choose your learning path</span>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                Pick the track that fits your schedule and experience level
            </p>
        </div>

        @* Path options *@
        <div class="border-b">
            @foreach (var path in _paths)
            {
                var isSelected = _selected == path.Id;
                var isLast = path.Id == _paths[_paths.Length - 1].Id;
                <button
                    type="button"
                    class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", isSelected ? "bg-muted/30 ring-1 ring-inset ring-foreground/10" : "")"
                    @onclick="@(() => _selected = path.Id)"
                    aria-pressed="@(isSelected ? "true" : "false")">
                    <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50 text-muted-foreground" aria-hidden="true">
                        <LucideIconCn Name="@path.IconName" Size="16" Class="size-4" />
                    </span>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@path.Title</span>
                        <p class="mt-0.5 text-xs text-muted-foreground">@path.Description</p>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@path.EstimatedTime</BadgeCn>
                        <span class="text-xs text-muted-foreground">@path.LessonCount lessons</span>
                    </div>
                </button>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @(_selected != null ? "1 path selected" : "No path selected")
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(_selected == null)">
                Start Learning
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record LearningPath(string Id, string Title, string Description, string EstimatedTime, int LessonCount, string IconName);

    private static readonly LearningPath[] _paths =
    [
        new("quickstart", "Quick start guide", "Get up and running in under 10 minutes with the essentials", "10 min", 4, "rocket"),
        new("full-course", "Full course", "Comprehensive walkthrough of every feature and workflow", "2 hours", 18, "book-open"),
        new("self-paced", "Self-paced exploration", "Browse topics at your own pace with searchable modules", "Flexible", 32, "compass"),
    ];

    private string? _selected = null;
}
