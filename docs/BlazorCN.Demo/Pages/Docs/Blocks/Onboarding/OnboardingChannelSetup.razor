@* ============================================================
   Block: onboarding-channel-setup
   Title: OnboardingChannelSetup
   Description: A React communication channel setup block with configure buttons and connected count tracking. Built with Next.js, TypeScript, shadcn/ui Button, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-channel-setup.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="radio" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Communication Channels</span>
                </div>
                <span class="text-muted-foreground text-xs">@_configuredCount of @_channels.Length connected</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Choose how your team receives notifications and alerts
            </p>
        </div>

        @* Channel list *@
        <div>
            @foreach (var ch in _channels)
            {
                var channel = ch;
                var isLast = channel.Id == _channels[_channels.Length - 1].Id;
                var isConfiguring = _configuring == channel.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                            <LucideIconCn Name="@channel.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@channel.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@channel.Description</p>
                        </div>
                        <div class="shrink-0">
                            @if (channel.Configured)
                            {
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 gap-1 px-2 text-xs text-muted-foreground" Disabled="true">
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                    Configured
                                </ButtonCn>
                            }
                            else
                            {
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" Disabled="@isConfiguring" OnClick="@(() => HandleConfigure(channel.Id))">
                                    @if (isConfiguring)
                                    {
                                        <LucideIconCn Name="loader-2" Size="12" Class="size-3 animate-spin" />
                                    }
                                    else
                                    {
                                        <span>Configure</span>
                                    }
                                </ButtonCn>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs text-muted-foreground">Skip for now</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Save Channels</ButtonCn>
        </div>
    </div>
</section>

@code {
    private class ChannelItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
        public bool Configured { get; set; }
    }

    private readonly ChannelItem[] _channels =
    [
        new() { Id = "email",    Name = "Email",    Description = "Receive notifications via email digest",           Icon = "mail",    Configured = true  },
        new() { Id = "slack",    Name = "Slack",    Description = "Post alerts to your Slack workspace channels",     Icon = "hash",    Configured = false },
        new() { Id = "in-app",   Name = "In-app",   Description = "Show real-time notifications inside the app",     Icon = "bell",    Configured = true  },
        new() { Id = "webhooks", Name = "Webhooks", Description = "Send events to your custom endpoint via HTTP",    Icon = "webhook", Configured = false },
    ];

    private string? _configuring = null;

    private int _configuredCount => _channels.Count(c => c.Configured);

    private async Task HandleConfigure(string id)
    {
        _configuring = id;
        StateHasChanged();
        await Task.Delay(1200);
        var channel = _channels.FirstOrDefault(c => c.Id == id);
        if (channel != null) channel.Configured = true;
        _configuring = null;
    }
}
