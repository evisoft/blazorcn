        2 => ""text-amber-500"",
        3 => ""text-primary"",
        _ => ""text-emerald-500"",
    };

    private string StrengthColor => PassedChecks switch
    {
        <= 1 => ""bg-destructive"",
        2 => ""bg-amber-500"",
        3 => ""bg-primary"",
        _ => ""bg-emerald-500"",
    };
}
";

