    private ApprovalStage[] _stages =
    [
        new ApprovalStage { Id = ""manager"",   Title = ""Manager Review"",     Role = ""Direct manager"", Threshold = ""1000"",  AutoApprove = true  },
        new ApprovalStage { Id = ""finance"",   Title = ""Finance Approval"",   Role = ""Finance team"",   Threshold = ""5000"",  AutoApprove = false },
        new ApprovalStage { Id = ""executive"", Title = ""Executive Sign-off"", Role = ""VP or C-level"",  Threshold = ""25000"", AutoApprove = false },
    ];

    private class ApprovalStage
    {
        public string Id { get; set; } = """";
        public string Title { get; set; } = """";
        public string Role { get; set; } = """";
        public string Threshold { get; set; } = """";
        public bool AutoApprove { get; set; }
    }

    private void UpdateThreshold(string id, string threshold)
    {
        foreach (var s in _stages)
        {
            if (s.Id == id) s.Threshold = threshold;
        }
    }

    private void ToggleAutoApprove(string id)
    {
        foreach (var s in _stages)
        {
            if (s.Id == id) s.AutoApprove = !s.AutoApprove;
        }
    }
}";

