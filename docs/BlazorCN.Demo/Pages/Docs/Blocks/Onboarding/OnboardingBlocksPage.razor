                                <div class=""@Cn.Merge(""h-0.5 flex-1 mx-2 sm:mx-4"", step.Id < _currentStep ? ""bg-primary"" : ""bg-muted"")""></div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Current step content *@
            @{ var currentStepData = _steps.FirstOrDefault(s => s.Id == _currentStep); }
            <div class=""text-center py-8"">
                <h2 class=""text-2xl font-semibold text-foreground mb-2"">@currentStepData?.Title</h2>
                <p class=""text-muted-foreground max-w-md mx-auto"">@currentStepData?.Description</p>
                <div class=""mt-8 p-8 border border-dashed border-border rounded-lg"">
                    <p class=""text-sm text-muted-foreground"">Step @_currentStep content goes here</p>
                </div>
            </div>

            @* Navigation *@
            <div class=""flex items-center justify-between pt-4 border-t"">
                <ButtonCn Disabled=""@(_currentStep == 1)"" @onclick=""@(() => { if (_currentStep > 1) _currentStep--; })"" Variant=""ButtonVariant.Outline"">
                    Previous
                </ButtonCn>
                <div class=""text-sm text-muted-foreground"">
                    Step @_currentStep of @_steps.Length
                </div>
                <ButtonCn @onclick=""@(() => { if (_currentStep < _steps.Length) _currentStep++; })"">
                    @(_currentStep == _steps.Length ? ""Complete"" : ""Next"")
                </ButtonCn>
            </div>
        </CardContentCn>
    </CardCn>
</div>

