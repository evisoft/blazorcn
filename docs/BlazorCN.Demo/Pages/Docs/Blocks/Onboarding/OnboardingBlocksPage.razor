@code {
    private const int TotalSeats = 10;

    private record Department(string Id, string Name, int Seats)
    {
        public Department WithSeats(int seats) => this with { Seats = seats };
    }

    private List<Department> _departments =
    [
        new(""eng"", ""Engineering"", 3),
        new(""design"", ""Design"", 1),
        new(""marketing"", ""Marketing"", 1),
    ];

    private int _allocated => _departments.Sum(d => d.Seats);
    private int _remaining => TotalSeats - _allocated;

    private void UpdateSeats(string id, int delta)
    {
        for (int i = 0; i < _departments.Count; i++)
        {
            var dept = _departments[i];
            if (dept.Id != id) continue;
            var next = dept.Seats + delta;
            if (next < 0 || _allocated + delta > TotalSeats) return;
            _departments[i] = dept.WithSeats(next);
            return;
        }
    }
}";

