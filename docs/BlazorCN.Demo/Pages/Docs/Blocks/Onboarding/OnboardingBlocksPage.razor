@code {
    private record InviteItem(string Id, string Email, string Role, string Status, string SentAt);

    private string _email = """";
    private string _role = ""member"";
    private bool _sending;

    private List<InviteItem> _invites =
    [
        new(""1"", ""sarah@@example.com"", ""Admin"", ""accepted"", ""2 days ago""),
        new(""2"", ""mike@@example.com"", ""Member"", ""pending"", ""1 hour ago""),
    ];

    private int PendingCount => _invites.Count(i => i.Status == ""pending"");

    private async Task HandleSendInvite()
    {
        if (string.IsNullOrEmpty(_email)) return;
        _sending = true;
        StateHasChanged();
        await Task.Delay(1000);
        _invites.Add(new(Guid.NewGuid().ToString(), _email, _role, ""pending"", ""Just now""));
        _email = """";
        _sending = false;
    }

    private void RemoveInvite(string id)
    {
        _invites.RemoveAll(i => i.Id == id);
    }
}";
