@code {
    private record CreationStep(string Id, string Label);

    private static readonly CreationStep[] _creationSteps =
    [
        new(""init"", ""Initializing project""),
        new(""config"", ""Setting up configuration""),
        new(""files"", ""Creating files""),
        new(""done"", ""Ready to go""),
    ];

    private string _projectName = """";
    private bool _isPrivate = true;
    private bool _enableAnalytics = true;
    private bool _creating;
    private int _currentStep;
    private bool _created;

    private async Task HandleCreate()
    {
        if (string.IsNullOrEmpty(_projectName)) return;
        _creating = true;
        StateHasChanged();

        for (var i = 0; i < _creationSteps.Length; i++)
        {
            _currentStep = i;
            StateHasChanged();
            await Task.Delay(800);
        }

        _created = true;
        _creating = false;
    }
}";

