@code {
    private const string _inviteLink = ""https://acme.co/invite/wks-a3f8c2d1e9b7"";
    private bool _copied = false;
    private System.Threading.CancellationTokenSource? _copyCts;

    private async Task HandleCopy()
    {
        _copied = true;
        _copyCts?.Cancel();
        _copyCts = new System.Threading.CancellationTokenSource();
        var cts = _copyCts;
        try
        {
            await Task.Delay(2000, cts.Token);
            _copied = false;
        }
        catch (TaskCanceledException)
        {
            // cancelled by a subsequent copy; ignore
        }
    }
}";

