@code {
    private record Requirement(string Label, bool Met);

    private static readonly int[] _levels = [1, 2, 3, 4];

    private string _password = """";
    private string _confirm = """";

    private Requirement[] Requirements =>
    [
        new(""At least 8 characters"", _password.Length >= 8),
        new(""One uppercase letter"", _password.Any(char.IsUpper)),
        new(""One number"", _password.Any(char.IsDigit)),
        new(""One special character"", _password.Any(c => ""!@#$%^&*(),.?\"":{}|<>"".Contains(c))),
    ];

    private int MetCount => Requirements.Count(r => r.Met);

    private bool AllMet => Requirements.All(r => r.Met);

    private bool PasswordsMatch => _password.Length > 0 && _password == _confirm;

    private int StrengthLevel => MetCount switch
    {
        <= 1 => 1,
        2 => 2,
        3 => 3,
        _ => 4,
    };

    private string StrengthLabel => MetCount switch
    {
        <= 1 => ""Weak"",
        2 => ""Fair"",
        3 => ""Good"",
        _ => ""Strong"",
    };

    private string StrengthColor => MetCount switch
    {
        <= 1 => ""text-red-500"",
        2 => ""text-amber-500"",
        3 => ""text-amber-500"",
        _ => ""text-emerald-500"",
    };

    private string StrengthBarColor => MetCount switch
    {
        <= 1 => ""bg-red-500"",
        2 => ""bg-amber-500"",
        3 => ""bg-amber-500"",
        _ => ""bg-emerald-500"",
    };
}";

