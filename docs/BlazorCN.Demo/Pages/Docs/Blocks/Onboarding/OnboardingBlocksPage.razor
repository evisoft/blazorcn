@code {
    private record CheckItem(string Label, bool Valid);

    private string _password = """";
    private bool _showPassword;
    private bool _enable2FA;
    private string _recoveryEmail = """";

    private CheckItem[] PasswordChecks =>
    [
        new(""8+ characters"", _password.Length >= 8),
        new(""Uppercase letter"", _password.Any(char.IsUpper)),
        new(""Lowercase letter"", _password.Any(char.IsLower)),
        new(""Number"", _password.Any(char.IsDigit)),
    ];

    private int PassedChecks => PasswordChecks.Count(c => c.Valid);

    private int StrengthPercent => PassedChecks * 25;

    private string StrengthLabel => PassedChecks switch
    {
        <= 1 => ""Weak"",
        2 => ""Fair"",
        3 => ""Good"",
        _ => ""Strong"",
    };

    private string StrengthColorText => PassedChecks switch
    {
