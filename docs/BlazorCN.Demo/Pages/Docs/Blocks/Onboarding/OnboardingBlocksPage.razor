@code {
    private record Permission(string Id, string Label, bool DefaultChecked);
    private record Role(string Id, string Name, string Description, int MemberCount, Permission[] Permissions);

    private string? _expanded = ""editor"";

    private static readonly Role[] _roles =
    [
        new(""admin"", ""Admin"", ""Full access to all settings and data"", 2,
        [
            new(""admin-manage-members"", ""Manage team members"", true),
            new(""admin-billing"", ""Access billing and payments"", true),
            new(""admin-delete"", ""Delete workspace data"", true),
            new(""admin-integrations"", ""Configure integrations"", true),
        ]),
        new(""editor"", ""Editor"", ""Create and edit content, limited settings access"", 5,
        [
            new(""editor-create"", ""Create and edit content"", true),
            new(""editor-publish"", ""Publish content"", true),
            new(""editor-comments"", ""Manage comments"", true),
            new(""editor-analytics"", ""View analytics"", false),
        ]),
        new(""viewer"", ""Viewer"", ""Read-only access to published content"", 12,
        [
            new(""viewer-read"", ""View published content"", true),
            new(""viewer-comments"", ""Add comments"", true),
            new(""viewer-export"", ""Export reports"", false),
        ]),
    ];

    private Dictionary<string, bool> _permissions = InitPermissions();

    private static Dictionary<string, bool> InitPermissions()
    {
        var dict = new Dictionary<string, bool>();
        foreach (var role in _roles)
            foreach (var perm in role.Permissions)
                dict[perm.Id] = perm.DefaultChecked;
        return dict;
    }

    private void TogglePermission(string permId)
    {
        if (_permissions.TryGetValue(permId, out var current))
            _permissions[permId] = !current;
    }
}";

