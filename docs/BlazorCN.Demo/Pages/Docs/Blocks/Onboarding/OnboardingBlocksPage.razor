                        {
                            <LucideEyeOffCn Size=""16"" />
                        }
                        else
                        {
                            <LucideEyeCn Size=""16"" />
                        }
                    </button>
                </div>

                @* Strength meter *@
                @if (!string.IsNullOrEmpty(_password))
                {
                    <div class=""space-y-1"">
                        <div class=""flex items-center justify-between text-xs"">
                            <span class=""text-muted-foreground"">Password strength</span>
                            <span class=""@(Cn.Merge(""font-medium"", StrengthColorText))"">
                                @StrengthLabel
                            </span>
                        </div>
                        <div class=""h-1.5 bg-muted rounded-full overflow-hidden"">
                            <div
                                class=""@(Cn.Merge(""h-full transition-all duration-300"", StrengthColor))""
                                style=""@($""width: {StrengthPercent}%"")"">
                            </div>
                        </div>
                    </div>

                    @* Checklist *@
                    <div class=""grid grid-cols-2 gap-1.5"">
                        @foreach (var check in PasswordChecks)
                        {
                            <div class=""flex items-center gap-1.5 text-xs"">
                                @if (check.Valid)
                                {
                                    <LucideCheckCn Size=""12"" Class=""text-emerald-500"" />
                                }
                                else
                                {
                                    <LucideXCn Size=""12"" Class=""text-muted-foreground"" />
