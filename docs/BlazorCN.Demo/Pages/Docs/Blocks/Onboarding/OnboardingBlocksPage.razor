@code {
    private string _cardNumber = """";
    private string _expiry = """";
}";
    private const string OnboardingCardsCode = @"<div class=""flex items-center justify-center p-10 w-full"">
    <div class=""w-full max-w-2xl"">
        <div class=""mb-6"">
            <h2 class=""text-xl font-semibold text-foreground"">Welcome! Let's get you set up</h2>
            <p class=""text-sm text-muted-foreground mt-1"">Complete these tasks to get the most out of your account</p>
        </div>

        <div class=""mb-6"">
            <div class=""flex items-center justify-between text-sm mb-2"">
                <span class=""text-muted-foreground"">Setup progress</span>
                <span class=""font-medium text-foreground"">@_completedCount of @_tasks.Length completed</span>
            </div>
            <ProgressCn Class=""h-2"" Value=""@_progress"" />
        </div>

        <div class=""grid grid-cols-1 sm:grid-cols-2 gap-3"">
            @foreach (var task in _tasks)
            {
                <CardCn Class=""@Cn.Merge(""cursor-pointer transition-all hover:border-primary/50"", task.Completed ? ""bg-muted/50"" : """")""
                        @onclick=""@(() => task.Completed = !task.Completed)"">
                    <CardContentCn Class=""p-4"">
                        <div class=""flex items-start gap-3"">
                            <div class=""@Cn.Merge(""flex h-10 w-10 shrink-0 items-center justify-center rounded-lg"", task.Completed ? ""bg-primary text-primary-foreground"" : ""bg-muted text-muted-foreground"")"">
                                @if (task.Completed)
                                {
                                    <LucideCheckCn Class=""h-5 w-5"" Size=""20"" />
                                }
                                else
                                {
                                    @switch (task.Icon)
                                    {
                                        case ""settings"": <LucideSettingsCn Class=""h-5 w-5"" Size=""20"" /> break;
                                        case ""users"": <LucideUsersCn Class=""h-5 w-5"" Size=""20"" /> break;
                                        case ""file-text"": <LucideFileTextCn Class=""h-5 w-5"" Size=""20"" /> break;
                                        case ""key"": <LucideKeyCn Class=""h-5 w-5"" Size=""20"" /> break;
                                        case ""palette"": <LucidePaletteCn Class=""h-5 w-5"" Size=""20"" /> break;
                                        case ""link"": <LucideLinkCn Class=""h-5 w-5"" Size=""20"" /> break;
                                    }
                                }
                            </div>
                            <div class=""min-w-0"">
                                <h3 class=""@Cn.Merge(""font-medium"", task.Completed ? ""text-muted-foreground line-through"" : ""text-foreground"")"">
                                    @task.Title
                                </h3>
                                <p class=""text-sm text-muted-foreground truncate"">@task.Description</p>
                            </div>
                        </div>
                    </CardContentCn>
                </CardCn>
            }
        </div>

        @if (_completedCount == _tasks.Length)
        {
            <div class=""mt-6 p-4 rounded-lg border border-primary/20 bg-primary/5 text-center"">
                <p class=""font-medium text-primary"">You're all set! Start exploring your dashboard.</p>
            </div>
        }
    </div>
</div>

@code {
    private class TaskItem
    {
        public string Id { get; set; } = """";
        public string Title { get; set; } = """";
        public string Description { get; set; } = """";
        public string Icon { get; set; } = """";
        public bool Completed { get; set; }
    }

    private readonly TaskItem[] _tasks =
    [
        new() { Id = ""profile"", Title = ""Complete your profile"", Description = ""Add your photo and bio"", Icon = ""settings"", Completed = true },
        new() { Id = ""team"", Title = ""Invite team members"", Description = ""Collaborate with your team"", Icon = ""users"", Completed = true },
        new() { Id = ""document"", Title = ""Create first document"", Description = ""Start with a template"", Icon = ""file-text"", Completed = false },
        new() { Id = ""api"", Title = ""Generate API key"", Description = ""Enable integrations"", Icon = ""key"", Completed = false },
        new() { Id = ""branding"", Title = ""Customize branding"", Description = ""Add your logo and colors"", Icon = ""palette"", Completed = false },
        new() { Id = ""integrations"", Title = ""Connect integrations"", Description = ""Link your favorite tools"", Icon = ""link"", Completed = false },
    ];

    private int _completedCount => _tasks.Count(t => t.Completed);
    private int _progress => (int)((double)_completedCount / _tasks.Length * 100);
}";
    private const string OnboardingCarouselCode = @"<div class=""flex items-center justify-center p-10 w-full"">
    <CardCn Class=""w-full max-w-md overflow-hidden"">
        <CardContentCn Class=""p-0"">
            @{ var slide = _slides[_currentSlide]; var isLastSlide = _currentSlide == _slides.Length - 1; }
            <div class=""p-8 text-center"">
                <div class=""@Cn.Merge(""mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-full"", slide.Bg)"">
                    <div class=""@slide.Color"">
                        @switch (slide.Icon)
                        {
                            case ""zap"":
                                <LucideZapCn Class=""h-12 w-12"" Size=""48"" />
                                break;
                            case ""share2"":
                                <LucideShare2Cn Class=""h-12 w-12"" Size=""48"" />
                                break;
                            case ""shield"":
                                <LucideShieldCn Class=""h-12 w-12"" Size=""48"" />
                                break;
                            case ""file-text"":
                                <LucideFileTextCn Class=""h-12 w-12"" Size=""48"" />
                                break;
                        }
                    </div>
                </div>
                <h2 class=""text-xl font-semibold text-foreground mb-2"">@slide.Title</h2>
                <p class=""text-sm text-muted-foreground leading-relaxed"">@slide.Description</p>
            </div>

            <div class=""px-8 pb-8"">
                <div class=""flex items-center justify-center gap-2 mb-6"">
                    @for (var i = 0; i < _slides.Length; i++)
                    {
                        var idx = i;
                        <button type=""button""
                                aria-label=""@($""Go to slide {idx + 1}"")""
                                class=""@Cn.Merge(""h-2 rounded-full transition-all"", idx == _currentSlide ? ""w-6 bg-primary"" : ""w-2 bg-muted hover:bg-muted-foreground/30"")""
                                @onclick=""@(() => _currentSlide = idx)""></button>
                    }
                </div>
                <div class=""flex items-center gap-3"">
                    @if (!isLastSlide)
                    {
                        <ButtonCn Class=""flex-1"" @onclick=""@(() => _currentSlide = _slides.Length - 1)"" Variant=""ButtonVariant.Ghost"">
                            Skip
                        </ButtonCn>
                    }
                    <ButtonCn Class=""@Cn.Merge(""flex-1"", isLastSlide ? ""w-full"" : """")""
                              @onclick=""@(() => { if (isLastSlide) _currentSlide = 0; else _currentSlide++; })"">
                        @if (isLastSlide)
                        {
                            <span>Get Started</span>
                        }
                        else
                        {
                            <span>Next</span>
                            <LucideArrowRightCn Class=""ml-2 h-4 w-4"" Size=""16"" />
                        }
                    </ButtonCn>
                </div>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
