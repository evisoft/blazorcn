@code {
    private class IntegrationItem
    {
        public string Id { get; set; } = """";
        public string Name { get; set; } = """";
        public string Description { get; set; } = """";
        public string Icon { get; set; } = """";
        public string Color { get; set; } = """";
        public bool Connected { get; set; }
    }

    private readonly IntegrationItem[] _integrations =
    [
        new() { Id = ""slack"", Name = ""Slack"", Description = ""Get notifications in Slack"", Icon = ""message-square"", Color = ""bg-[#4A154B]"", Connected = true },
        new() { Id = ""github"", Name = ""GitHub"", Description = ""Sync issues and PRs"", Icon = ""github"", Color = ""bg-[#24292F]"", Connected = false },
        new() { Id = ""google"", Name = ""Google Drive"", Description = ""Import and sync files"", Icon = ""cloud"", Color = ""bg-[#4285F4]"", Connected = true },
        new() { Id = ""zoom"", Name = ""Zoom"", Description = ""Schedule video meetings"", Icon = ""video"", Color = ""bg-[#2D8CFF]"", Connected = false },
        new() { Id = ""trello"", Name = ""Trello"", Description = ""Sync boards and cards"", Icon = ""cloud"", Color = ""bg-[#0052CC]"", Connected = false },
        new() { Id = ""gmail"", Name = ""Gmail"", Description = ""Send emails from app"", Icon = ""mail"", Color = ""bg-[#EA4335]"", Connected = false },
    ];

    private string? _connecting;
    private int _connectedCount => _integrations.Count(i => i.Connected);

    private async Task HandleConnect(IntegrationItem integration)
    {
        _connecting = integration.Id;
        StateHasChanged();
        await Task.Delay(1500);
        integration.Connected = true;
        _connecting = null;
    }
}";
    private const string OnboardingKeyboardShortcutsCode = @"<div class=""flex items-center justify-center p-10 w-full"">
    <CardCn Class=""w-full max-w-md"">
        <CardHeaderCn Class=""text-center"">
            <div class=""mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10"">
                <LucideKeyboardCn Size=""24"" Class=""text-primary"" />
            </div>
            <CardTitleCn>Learn the shortcuts</CardTitleCn>
            <CardDescriptionCn>Master these keyboard shortcuts to work faster</CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn Class=""space-y-4"">
            @* Shortcuts list *@
            <div class=""space-y-2"">
                @foreach (var shortcut in _shortcuts)
                {
                    var isPracticed = _practicedShortcuts.Contains(shortcut.Id);
                    <button
                        type=""button""
                        class=""@(Cn.Merge(
                            ""flex items-center justify-between w-full p-3 rounded-lg border transition-all"",
                            isPracticed ? ""bg-muted/50 border-primary/20"" : ""hover:bg-muted/50 hover:border-primary/50""
                        ))""
                        @onclick=""@(() => PracticeShortcut(shortcut.Id))""
                        disabled=""@isPracticed"">
                        <div class=""flex items-center gap-3"">
                            <div class=""@(Cn.Merge(
                                ""flex h-8 w-8 items-center justify-center rounded-md"",
                                isPracticed ? ""bg-primary/10 text-primary"" : ""bg-muted text-muted-foreground""
                            ))"">
                                @if (isPracticed)
                                {
                                    <LucideCheckCircle2Cn Size=""16"" />
                                }
                                else
                                {
                                    <LucideCommandCn Size=""16"" />
                                }
                            </div>
                            <span class=""@(Cn.Merge(
                                ""text-sm font-medium"",
                                isPracticed ? ""text-muted-foreground"" : ""text-foreground""
                            ))"">
                                @shortcut.Action
                            </span>
                        </div>
                        <div class=""flex items-center gap-1"">
                            @foreach (var key in shortcut.Keys)
                            {
                                <kbd class=""rounded border bg-muted px-1.5 py-0.5 text-xs font-mono"">@key</kbd>
                            }
                        </div>
                    </button>
                }
            </div>

            @* Progress *@
            <div class=""pt-4 border-t"">
                <div class=""flex items-center justify-between text-sm mb-2"">
                    <span class=""text-muted-foreground"">Progress</span>
                    <span class=""font-medium text-foreground"">
                        @_practicedShortcuts.Count / @_shortcuts.Length
                    </span>
                </div>
                <div class=""h-2 bg-muted rounded-full overflow-hidden"">
                    <div
                        class=""h-full bg-primary transition-all duration-300""
                        style=""@($""width: {(_shortcuts.Length > 0 ? (_practicedShortcuts.Count * 100 / _shortcuts.Length) : 0)}%"")"">
                    </div>
                </div>
            </div>

            @* Actions *@
            <div class=""flex items-center justify-between pt-2"">
                <ButtonCn Variant=""ButtonVariant.Ghost"">Skip tutorial</ButtonCn>
                <ButtonCn Disabled=""@(!AllPracticed)"">
                    @(AllPracticed ? ""Continue"" : ""Practice all to continue"")
                </ButtonCn>
            </div>
        </CardContentCn>
    </CardCn>
</div>

