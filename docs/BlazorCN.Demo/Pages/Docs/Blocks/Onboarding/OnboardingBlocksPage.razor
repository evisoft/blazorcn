@code {
    private record Field(string Id, string Name, string Type, bool Editable);

    private static readonly string[] _fieldTypes = [""Text"", ""Number"", ""Date"", ""Select""];

    private List<Field> _fields =
    [
        new(""name"",   ""Name"",   ""Text"",   false),
        new(""email"",  ""Email"",  ""Text"",   false),
        new(""status"", ""Status"", ""Select"", false),
    ];

    private int _fieldCounter = 0;

    private void AddField()
    {
        _fieldCounter += 1;
        _fields.Add(new Field($""custom-{_fieldCounter}"", """", ""Text"", true));
    }

    private void UpdateFieldName(string id, string name)
    {
        var idx = _fields.FindIndex(f => f.Id == id);
        if (idx >= 0)
            _fields[idx] = _fields[idx] with { Name = name };
    }

    private void UpdateFieldType(string id, string? type)
    {
        if (type is null) return;
        var idx = _fields.FindIndex(f => f.Id == id);
        if (idx >= 0)
            _fields[idx] = _fields[idx] with { Type = type };
    }

    private void RemoveField(string id)
    {
        _fields.RemoveAll(f => f.Id == id);
    }
}";

