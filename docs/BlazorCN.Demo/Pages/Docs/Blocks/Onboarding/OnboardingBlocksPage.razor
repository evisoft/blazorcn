@code {
    private record RateLimitOption(string Value, string Label);

    private static readonly RateLimitOption[] _rateLimitOptions =
    [
        new(""100"",  ""100 RPM""),
        new(""500"",  ""500 RPM""),
        new(""1000"", ""1,000 RPM""),
        new(""5000"", ""5,000 RPM""),
    ];

    private static readonly RateLimitOption[] _overageOptions =
    [
        new(""queue"",    ""Queue — hold and retry later""),
        new(""reject"",   ""Reject — return 429 immediately""),
        new(""throttle"", ""Throttle — slow down requests""),
    ];

    private const int _currentUsage = 342;

    private string _rateLimit = ""1000"";
    private string _overage = ""throttle"";

    private int _limit => int.TryParse(_rateLimit, out var v) ? v : 1000;
    private int _usagePercent => Math.Min((int)Math.Round((double)_currentUsage / _limit * 100), 100);

    private string _usageColor =>
        _usagePercent >= 90 ? ""text-red-600 dark:text-red-400"" :
        _usagePercent >= 70 ? ""text-amber-600 dark:text-amber-400"" :
        ""text-muted-foreground"";

    private void SetRateLimit(string v) => _rateLimit = v;
    private void SetOverage(string v) => _overage = v;
}
";

