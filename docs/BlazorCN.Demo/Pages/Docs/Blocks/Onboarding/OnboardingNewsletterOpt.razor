@* ============================================================
   Block: onboarding-newsletter-opt
   Title: OnboardingNewsletterOpt
   Description: A newsletter preference onboarding block for React and Next.js with checkbox toggles, frequency badges, select all controls, and save action built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-newsletter-opt.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Newsletter preferences</span>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                Choose the emails you'd like to receive
            </p>
        </div>

        @* Select all / Deselect all *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" OnClick="SelectAll">
                Select all
            </ButtonCn>
            <span class="text-muted-foreground text-xs">/</span>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" OnClick="DeselectAll">
                Deselect all
            </ButtonCn>
        </div>

        @* Newsletter rows *@
        <div class="border-b">
            @for (var i = 0; i < _newsletters.Length; i++)
            {
                var newsletter = _newsletters[i];
                var isLast = i == _newsletters.Length - 1;
                var rowClass = Cn.Merge("flex cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "");
                <label for="@($"newsletter-{newsletter.Id}")" class="@rowClass">
                    <CheckboxCn
                        id="@($"newsletter-{newsletter.Id}")"
                        Checked="@newsletter.Subscribed"
                        CheckedChanged="@(() => ToggleNewsletter(newsletter.Id))" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@newsletter.Title</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @newsletter.Frequency
                            </BadgeCn>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@newsletter.Description</p>
                    </div>
                </label>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @SubscribedCount of @_newsletters.Length selected
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Save Preferences
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private class NewsletterItem
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Frequency { get; set; } = "";
        public bool Subscribed { get; set; }
    }

    private int SubscribedCount => _newsletters.Count(n => n.Subscribed);

    private readonly NewsletterItem[] _newsletters =
    [
        new() { Id = "weekly-digest",   Title = "Weekly digest",    Description = "Top stories, tips, and community highlights every Monday",  Frequency = "Weekly",       Subscribed = true  },
        new() { Id = "product-updates", Title = "Product updates",  Description = "New features, improvements, and changelog summaries",        Frequency = "Bi-weekly",    Subscribed = true  },
        new() { Id = "engineering-blog",Title = "Engineering blog", Description = "Deep dives into architecture, performance, and tooling",     Frequency = "Monthly",      Subscribed = false },
        new() { Id = "event-invites",   Title = "Event invites",    Description = "Webinars, meetups, and conference discount codes",           Frequency = "As scheduled", Subscribed = false },
    ];

    private void ToggleNewsletter(string id)
    {
        var item = System.Array.Find(_newsletters, n => n.Id == id);
        if (item != null) item.Subscribed = !item.Subscribed;
    }

    private void SelectAll()
    {
        foreach (var n in _newsletters) n.Subscribed = true;
    }

    private void DeselectAll()
    {
        foreach (var n in _newsletters) n.Subscribed = false;
    }
}
