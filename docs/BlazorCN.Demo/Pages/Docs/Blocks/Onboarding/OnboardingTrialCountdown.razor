@* ============================================================
   Block: onboarding-trial-countdown
   Title: OnboardingTrialCountdown
   Description: A free trial information component for React and Next.js with animated countdown number, feature list with dot indicators, usage progress bar, and upgrade CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-trial-countdown.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Your Free Trial</span>
        </div>

        @* Countdown *@
        <div class="border-b px-4 py-6 text-center">
            <span class="font-semibold text-5xl tabular-nums text-foreground">@_remainingDays</span>
            <p class="mt-1 text-muted-foreground text-sm">days remaining in your free trial</p>
        </div>

        @* Trial features *@
        <div>
            @foreach (var feature in _trialFeatures)
            {
                <div class="border-b">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <span class="size-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"></span>
                        <span class="text-sm">@feature.Label</span>
                    </div>
                </div>
            }
        </div>

        @* Progress bar *@
        <div class="border-b px-4 py-3">
            <div class="mb-1.5 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Trial usage</span>
                <span class="text-muted-foreground text-xs tabular-nums">@_usedDays of @_trialDays days</span>
            </div>
            <ProgressCn Value="@_progressPercent" Class="h-1.5" aria-label="Progress" />
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Continue with trial</ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Upgrade Now</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TrialFeature(string Id, string Label);

    private const int _trialDays = 14;
    private const int _usedDays = 2;
    private int _remainingDays => _trialDays - _usedDays;
    private int _progressPercent => (int)Math.Round((double)_usedDays / _trialDays * 100);

    private static readonly TrialFeature[] _trialFeatures =
    [
        new("f1", "Unlimited projects and workspaces"),
        new("f2", "All integrations and API access"),
        new("f3", "Priority support and onboarding"),
    ];
}
