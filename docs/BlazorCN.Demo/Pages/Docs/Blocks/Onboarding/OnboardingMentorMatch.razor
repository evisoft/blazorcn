@* ============================================================
   Block: onboarding-mentor-match
   Title: OnboardingMentorMatch
   Description: Mentor preference selector with profile reveal for React and Next.js. Features industry, role, and random matching options. Built with TypeScript, shadcn/ui, Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-mentor-match.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="text-sm font-medium">We'll match you with a mentor</span>
            <p class="mt-1 text-xs text-muted-foreground">Choose how you'd like to be paired</p>
        </div>

        @* Preference options *@
        <div class="border-b">
            @foreach (var pref in _preferences)
            {
                var isSelected = _selected == pref.Id;
                var isLast = pref.Id == _preferences[_preferences.Length - 1].Id;
                <button
                    type="button"
                    class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", isSelected ? "bg-muted/30 ring-1 ring-inset ring-foreground/10" : "")"
                    @onclick="@(() => SetSelected(pref.Id))"
                    aria-pressed="@(isSelected ? "true" : "false")">
                    <span
                        class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50 text-muted-foreground"
                        aria-hidden="true">
                        <LucideIconCn Name="@pref.IconName" Size="16" Class="size-4" />
                    </span>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm font-medium">@pref.Label</span>
                        <p class="mt-0.5 text-xs text-muted-foreground">@pref.Description</p>
                    </div>
                    <span class="@Cn.Merge("size-2 shrink-0 rounded-full transition-colors", isSelected ? "bg-foreground" : "bg-muted")"></span>
                </button>
            }
        </div>

        @* Mentor profile reveal *@
        @if (_selected != null && _mentorProfiles.TryGetValue(_selected, out var mentor))
        {
            <div class="border-b px-4 py-3">
                <div class="rounded-md bg-muted/50 p-3">
                    <span class="text-xs font-medium text-muted-foreground">Suggested mentor</span>
                    <div class="mt-2 flex items-center gap-3">
                        <AvatarCn Class="size-8">
                            <AvatarFallbackCn Class="text-xs">@mentor.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@mentor.Name</span>
                            <p class="text-xs text-muted-foreground">@mentor.Role at @mentor.Company</p>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Skip</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(_selected == null)">Request Mentor</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Preference(string Id, string Label, string Description, string IconName);
    private record MentorProfile(string Initials, string Name, string Role, string Company);

    private static readonly Preference[] _preferences =
    [
        new("industry", "Same industry", "Matched by your sector for domain-specific guidance", "briefcase"),
        new("role", "Same role", "Matched by job function for relevant career advice", "users"),
        new("random", "Random match", "Discover fresh perspectives from a different background", "shuffle"),
    ];

    private static readonly Dictionary<string, MentorProfile> _mentorProfiles = new()
    {
        ["industry"] = new("JL", "Jamie Lin", "Senior Engineer", "Stripe"),
        ["role"] = new("MR", "Morgan Reeves", "Staff Engineer", "Vercel"),
        ["random"] = new("AK", "Anya Kowalski", "Design Lead", "Linear"),
    };

    private string? _selected = null;

    private void SetSelected(string id)
    {
        _selected = id;
    }
}
