@* ============================================================
   Block: onboarding-layout-preference
   Title: OnboardingLayoutPreference
   Description: Dashboard density selector with compact, comfortable, and spacious wireframe previews for React and Next.js. Built with TypeScript, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-layout-preference.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Layout preference</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Choose how much space elements take up in your dashboard. You can adjust this later in
                display settings.
            </p>
        </div>

        @* Layout options *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-3 gap-3">
                @foreach (var layout in _layouts)
                {
                    var layoutItem = layout;
                    <button
                        type="button"
                        @onclick="@(() => _selected = layoutItem.Id)"
                        class="@Cn.Merge("flex flex-col items-center gap-2 rounded-md border p-3 transition-all", _selected == layoutItem.Id ? "ring-2 ring-foreground ring-offset-2 ring-offset-background" : "hover:bg-muted/50")">
                        @* Wireframe *@
                        <div class="@($"flex w-full {layoutItem.Gap} h-12")">
                            <div class="@($"{layoutItem.SidebarW} shrink-0 rounded-sm bg-muted")"></div>
                            <div class="@($"flex flex-1 flex-col {layoutItem.Gap}")">
                                <div class="@($"{layoutItem.RowH} w-full rounded-sm bg-muted")"></div>
                                <div class="@($"{layoutItem.RowH} w-full rounded-sm bg-muted/60")"></div>
                                <div class="@($"{layoutItem.RowH} w-3/4 rounded-sm bg-muted/40")"></div>
                                <div class="@($"{layoutItem.RowH} w-full rounded-sm bg-muted/60")"></div>
                            </div>
                        </div>
                        <span class="font-medium text-xs">@layoutItem.Label</span>
                    </button>
                }
            </div>
        </div>

        @* Dynamic description *@
        <div class="border-b px-4 py-3">
            <p class="text-muted-foreground text-sm">@ActiveLayout.Description</p>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Continue</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record LayoutOption(string Id, string Label, string Description, string Gap, string RowH, string SidebarW);

    private static readonly LayoutOption[] _layouts =
    [
        new("compact", "Compact",
            "Maximum content density with minimal spacing. Best for power users who want to see more data at a glance.",
            "gap-0.5", "h-1.5", "w-6"),
        new("comfortable", "Comfortable",
            "Balanced spacing that works for most users. Enough room to breathe without wasting screen space.",
            "gap-1", "h-2", "w-7"),
        new("spacious", "Spacious",
            "Generous whitespace for a relaxed feel. Ideal for presentations, demos, and users who prefer less visual clutter.",
            "gap-1.5", "h-2.5", "w-8"),
    ];

    private string _selected = "comfortable";

    private LayoutOption ActiveLayout => Array.Find(_layouts, l => l.Id == _selected) ?? _layouts[1];
}
