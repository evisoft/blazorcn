@* ============================================================
   Block: onboarding-export-format
   Title: OnboardingExportFormat
   Description: A React export format selection onboarding block with selectable format rows, file type icons, monospace preview, and set default action. Built with Next.js, TypeScript, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-export-format.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Default export format</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Select your preferred export format. This will be used as the default when downloading
                data.
            </p>
        </div>

        @* Format options *@
        <div>
            @foreach (var fmt in _formats)
            {
                var format = fmt;
                var isSelected = _selected == format.Id;
                <div class="border-b">
                    <button
                        type="button"
                        @onclick="@(() => _selected = format.Id)"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-all", isSelected ? "bg-foreground/[0.02] ring-2 ring-inset ring-foreground/10" : "hover:bg-muted/50")">
                        <span class="shrink-0">
                            <LucideIconCn Name="@format.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@format.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@format.Description</p>
                        </div>
                        @if (isSelected)
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-foreground"></span>
                        }
                    </button>
                </div>
            }
        </div>

        @* Preview *@
        @{
            var selectedFormat = _formats.FirstOrDefault(f => f.Id == _selected);
        }
        @if (selectedFormat is not null)
        {
            <div class="border-b px-4 py-3">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">Preview</span>
                <div class="overflow-x-auto rounded-md bg-zinc-950 p-3">
                    <pre class="whitespace-pre font-mono text-xs text-zinc-300">@selectedFormat.Preview</pre>
                </div>
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-end px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">Set Default</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record ExportFormat(string Id, string Name, string Description, string IconName, string Preview);

    private string _selected = "csv";

    private static readonly ExportFormat[] _formats =
    [
        new("csv",   "CSV",   "Comma-separated values for spreadsheets",         "file-spreadsheet",
            "name,email,role\n\"Alice\",\"alice@@acme.com\",\"Admin\"\n\"Bob\",\"bob@@acme.com\",\"Editor\""),
        new("json",  "JSON",  "Structured data for APIs and developers",          "file-json-2",
            "[\n  { \"name\": \"Alice\", \"email\": \"alice@@acme.com\" },\n  { \"name\": \"Bob\", \"email\": \"bob@@acme.com\" }\n]"),
        new("pdf",   "PDF",   "Formatted document for printing and sharing",      "file-type",
            "Report — Acme Team Members\n\nName        Email              Role\nAlice       alice@@acme.com     Admin\nBob         bob@@acme.com       Editor"),
        new("excel", "Excel", "XLSX workbook with formatting and formulas",       "file-text",
            "Sheet1: Team Members\n| Name  | Email            | Role   |\n| Alice | alice@@acme.com   | Admin  |\n| Bob   | bob@@acme.com     | Editor |"),
    ];
}
