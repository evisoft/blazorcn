@* ============================================================
   Block: onboarding-api-key-setup
   Title: OnboardingApiKeySetup
   Description: React API key generation onboarding block with generate button, masked key display in dark code box, copy button with check icon state swap, and security warning. Built with Next.js, shadcn/ui Button, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-api-key-setup.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="key" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Generate Your API Key</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-3">
            <p class="text-muted-foreground text-sm">
                Create an API key to authenticate requests from your application. Keep it secret and
                never expose it in client-side code.
            </p>
        </div>

        @* Key area *@
        <div class="border-b px-4 py-4">
            @if (_hasGenerated)
            {
                <div class="flex items-center gap-2 rounded-md bg-zinc-950 p-3">
                    <code class="min-w-0 flex-1 font-mono text-sm text-zinc-200">
                        @_maskedKey
                    </code>
                    <ButtonCn
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Sm"
                        Class="h-6 shrink-0 gap-1 px-2 text-xs text-zinc-400 hover:text-zinc-200"
                        @onclick="HandleCopy">
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                            <span>Copied</span>
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            <span>Copy</span>
                        }
                    </ButtonCn>
                </div>
            }
            else
            {
                <div class="flex justify-center">
                    <ButtonCn
                        Variant="ButtonVariant.Outline"
                        Size="ButtonSize.Sm"
                        Class="h-8 gap-1.5 text-xs"
                        @onclick="@(() => _hasGenerated = true)">
                        <LucideIconCn Name="key" Size="12" Class="size-3" />
                        Generate API Key
                    </ButtonCn>
                </div>
            }
        </div>

        @* Security warning *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-2">
                <LucideIconCn Name="triangle-alert" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-amber-500" />
                <p class="text-muted-foreground text-xs leading-relaxed">
                    This key will only be shown once. Store it securely in your environment variables.
                    Never commit API keys to version control or include them in client-side bundles.
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">
                Skip for now
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(!_hasGenerated)">
                Continue
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private const string _maskedKey = "sk_live_••••••••••••4f2a";
    private const string _fullKey = "sk_live_a1b2c3d4e5f6g7h84f2a";

    private bool _hasGenerated;
    private bool _copied;

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
