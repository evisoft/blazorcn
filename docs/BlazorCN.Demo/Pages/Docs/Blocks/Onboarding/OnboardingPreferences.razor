@* ========================================
   Block: onboarding-preferences
   Title: Onboarding Preferences
   Description: Preferences panel with toggle options, category groups, and personalization settings for user customization
   Long Description: React Onboarding Plan Selection
   Dependencies: LucideBellCn, LucideLockCn, LucideSparklesCn
   Source: original/blocks/onboarding/onboarding-preferences.tsx
   ======================================== *@
<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-lg">
        <CardHeaderCn>
            <CardTitleCn>Set your preferences</CardTitleCn>
            <CardDescriptionCn>
                Customize your experience. You can change these anytime in settings.
            </CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn Class="space-y-6">
            @for (var gi = 0; gi < _groups.Length; gi++)
            {
                var group = _groups[gi];
                <div>
                    @if (gi > 0)
                    {
                        <SeparatorCn Class="mb-6" />
                    }
                    <div class="flex items-center gap-2 mb-4">
                        <div class="text-muted-foreground">
                            @if (group.Title == "Notifications")
                            {
                                <LucideBellCn Size="16" />
                            }
                            else if (group.Title == "Privacy")
                            {
                                <LucideLockCn Size="16" />
                            }
                            else
                            {
                                <LucideSparklesCn Size="16" />
                            }
                        </div>
                        <h3 class="font-medium text-foreground">@group.Title</h3>
                    </div>
                    <div class="space-y-4">
                        @foreach (var pref in group.Preferences)
                        {
                            <div class="flex items-center justify-between gap-4">
                                <div class="space-y-0.5">
                                    <LabelCn Class="text-sm font-medium cursor-pointer" For="@($"preferences-{pref.Id}")">
                                        @pref.Label
                                    </LabelCn>
                                    <p class="text-xs text-muted-foreground">@pref.Description</p>
                                </div>
                                <SwitchCn
                                    Checked="@pref.Enabled"
                                    CheckedChanged="@(() => pref.Enabled = !pref.Enabled)"
                                    id="@($"preferences-{pref.Id}")" />
                            </div>
                        }
                    </div>
                </div>
            }

            @* Footer *@
            <div class="pt-4 border-t">
                <div class="flex items-center justify-between text-sm text-muted-foreground mb-4">
                    <span>
                        @EnabledCount of @TotalCount enabled
                    </span>
                    <button
                        type="button"
                        class="text-primary hover:underline"
                        @onclick="EnableAll">
                        Enable all
                    </button>
                </div>
                <ButtonCn Class="w-full">Save preferences</ButtonCn>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private class PrefItem
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private record GroupItem(string Title, PrefItem[] Preferences);

    private int EnabledCount => _groups.SelectMany(g => g.Preferences).Count(p => p.Enabled);
    private int TotalCount => _groups.SelectMany(g => g.Preferences).Count();

    private readonly GroupItem[] _groups =
    [
        new("Notifications",
        [
            new() { Id = "email", Label = "Email notifications", Description = "Receive updates via email", Enabled = true },
            new() { Id = "push", Label = "Push notifications", Description = "Get alerts on your device", Enabled = true },
            new() { Id = "weekly", Label = "Weekly digest", Description = "Summary of activity each week", Enabled = false },
        ]),
        new("Privacy",
        [
            new() { Id = "profile", Label = "Public profile", Description = "Allow others to see your profile", Enabled = true },
            new() { Id = "activity", Label = "Show activity status", Description = "Display when you're online", Enabled = false },
            new() { Id = "analytics", Label = "Usage analytics", Description = "Help us improve with anonymous data", Enabled = true },
        ]),
        new("Experience",
        [
            new() { Id = "tips", Label = "Show tips & hints", Description = "Display helpful suggestions", Enabled = true },
            new() { Id = "shortcuts", Label = "Keyboard shortcuts", Description = "Enable power user shortcuts", Enabled = true },
        ]),
    ];

    private void EnableAll()
    {
        foreach (var pref in _groups.SelectMany(g => g.Preferences))
            pref.Enabled = true;
    }
}
