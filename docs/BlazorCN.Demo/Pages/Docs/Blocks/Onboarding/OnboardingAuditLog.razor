@* ============================================================
   Block: onboarding-audit-log
   Title: OnboardingAuditLog
   Description: Audit log preferences onboarding for React and Next.js with log type toggles, retention period select, sample log preview, and configure action. Built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-audit-log.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Audit Log</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Choose which events to log and how long to retain them. Audit logs help you track
                activity and maintain compliance.
            </p>
        </div>

        @* Log Type Toggles *@
        <div>
            @foreach (var lt in _logTypes)
            {
                var logType = lt;
                <div class="border-b">
                    <label for="@($"log-{logType.Id}")" class="flex cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@logType.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@logType.Description</p>
                        </div>
                        <SwitchCn Id="@($"log-{logType.Id}")" Checked="@logType.Enabled" CheckedChanged="@(() => ToggleLogType(logType.Id))" />
                    </label>
                </div>
            }
        </div>

        @* Retention select *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Log retention
            </span>
            <SelectCn Value="@_retention" ValueChanged="@((string? v) => SetRetention(v))">
                <SelectTriggerCn Class="h-8 text-xs" aria-label="Log retention">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var opt in _retentionOptions)
                    {
                        var item = opt;
                        <SelectItemCn Value="@item.Value" Class="text-xs">@item.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Sample log preview *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Sample log entries
            </span>
            <div class="overflow-x-auto rounded-md bg-zinc-950 p-3">
                @foreach (var log in _sampleLogs)
                {
                    <p class="whitespace-nowrap font-mono text-white text-xs leading-relaxed">@log</p>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @_enabledCount of @_logTypes.Length log types enabled
            </span>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">Configure Logging</ButtonCn>
        </div>

    </div>
</section>

@code {
    private class LogType
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private class RetentionOption
    {
        public string Value { get; set; } = "";
        public string Label { get; set; } = "";
    }

    private readonly LogType[] _logTypes =
    [
        new() { Id = "auth",  Label = "Authentication events", Description = "Login attempts, password changes, session activity",         Enabled = true  },
        new() { Id = "data",  Label = "Data changes",          Description = "Create, update, and delete operations on records",           Enabled = true  },
        new() { Id = "api",   Label = "API calls",             Description = "External API requests with method, endpoint, and status",    Enabled = false },
        new() { Id = "admin", Label = "Admin actions",         Description = "Role changes, permission updates, configuration edits",      Enabled = true  },
    ];

    private static readonly RetentionOption[] _retentionOptions =
    [
        new() { Value = "30", Label = "30 days" },
        new() { Value = "60", Label = "60 days" },
        new() { Value = "90", Label = "90 days" },
    ];

    private static readonly string[] _sampleLogs =
    [
        "2026-03-24 09:14:22  AUTH   user.login      admin@acme.com     success  192.168.1.42",
        "2026-03-24 09:15:08  DATA   record.update   project/settings   updated  admin@acme.com",
        "2026-03-24 09:16:45  ADMIN  role.assign     dev@acme.com       editor   admin@acme.com",
    ];

    private string _retention = "30";

    private int _enabledCount => _logTypes.Count(lt => lt.Enabled);

    private void ToggleLogType(string id)
    {
        var lt = _logTypes.FirstOrDefault(x => x.Id == id);
        if (lt != null) lt.Enabled = !lt.Enabled;
    }

    private void SetRetention(string? v)
    {
        if (v != null) _retention = v;
    }
}
