@* ============================================================
   Block: onboarding-sso-config
   Title: OnboardingSsoConfig
   Description: An SSO configuration onboarding block for React and Next.js with provider select, metadata URL input, entity ID display, and test connection with loading states. Built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-sso-config.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="lock" Size="16" Class="text-muted-foreground" />
                <span class="font-medium text-sm">Configure SSO</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Connect your identity provider for single sign-on access
            </p>
        </div>

        @* Provider select *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Identity provider</span>
            <SelectCn Value="@_provider" ValueChanged="@((string? v) => SetProvider(v))" Class="mt-2">
                <SelectTriggerCn Class="h-8 text-xs" aria-label="Identity provider">
                    <SelectValueCn Placeholder="Select provider" />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var p in _providers)
                    {
                        var prov = p;
                        <SelectItemCn Value="@prov.Value" Class="text-xs">@prov.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Metadata URL *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Metadata URL</span>
            <InputCn
                Class="mt-2 h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0"
                Placeholder="@("https://your-idp.com/saml/metadata")"
                aria-label="SAML metadata URL"
                Value="@_metadataUrl"
                ValueChanged="@((string v) => _metadataUrl = v)" />
        </div>

        @* Entity ID *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Entity ID</span>
                <ButtonCn
                    Variant="ButtonVariant.Ghost"
                    Size="ButtonSize.Sm"
                    Class="h-6 gap-1 px-2 text-xs"
                    @onclick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
            <div class="mt-2 rounded-md bg-muted/50 px-3 py-2">
                <span class="font-mono text-muted-foreground text-xs">@_entityId</span>
            </div>
        </div>

        @* Test connection + footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs text-muted-foreground">
                Skip for now
            </ButtonCn>
            <ButtonCn
                Variant="ButtonVariant.Outline"
                Size="ButtonSize.Sm"
                Class="h-7 gap-1 text-xs"
                Disabled="@_testing"
                @onclick="HandleTest">
                @if (_testing)
                {
                    <LucideIconCn Name="loader-2" Size="12" Class="size-3 animate-spin" />
                    <span>Testing</span>
                }
                else if (_connected)
                {
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    <span>Connected</span>
                }
                else
                {
                    <span>Test Connection</span>
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Provider(string Value, string Label);

    private static readonly Provider[] _providers =
    [
        new("okta", "Okta"),
        new("auth0", "Auth0"),
        new("azure", "Azure AD"),
        new("google", "Google Workspace"),
    ];

    private const string _entityId = "https://app.acme.com/saml/metadata";

    private string _provider = "okta";
    private string _metadataUrl = "";
    private bool _testing;
    private bool _connected;
    private bool _copied;

    private void SetProvider(string? v)
    {
        if (v is not null) _provider = v;
    }

    private async Task HandleTest()
    {
        _testing = true;
        await Task.Delay(1500);
        _testing = false;
        _connected = true;
    }

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
