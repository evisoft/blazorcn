@* ============================================================
   Block: onboarding-email-signature
   Title: OnboardingEmailSignature
   Description: A React email signature setup onboarding block with live preview, input fields for name/title/company, and save action. Built with Next.js, TypeScript, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-email-signature.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Email Signature</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Create your email signature. It will be automatically appended to outgoing messages.
            </p>
        </div>

        @* Live preview *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Preview</span>
            <div class="rounded-md bg-muted/50 p-3">
                <p class="font-mono text-sm">@(string.IsNullOrEmpty(_name) ? "Your Name" : _name)</p>
                <p class="font-mono text-muted-foreground text-xs">
                    @(string.IsNullOrEmpty(_title) ? "Your Title" : _title)@((!string.IsNullOrEmpty(_title) || !string.IsNullOrEmpty(_company)) ? " · " : "")@(string.IsNullOrEmpty(_company) ? "Your Company" : _company)
                </p>
            </div>
        </div>

        @* Form fields *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                <div>
                    <label for="sig-name" class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        Full name
                    </label>
                    <InputCn
                        id="sig-name"
                        Value="@_name"
                        ValueChanged="@((string v) => _name = v)"
                        Placeholder="Your full name"
                        Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                </div>
                <div>
                    <label for="sig-title" class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        Job title
                    </label>
                    <InputCn
                        id="sig-title"
                        Value="@_title"
                        ValueChanged="@((string v) => _title = v)"
                        Placeholder="Your job title"
                        Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                </div>
                <div>
                    <label for="sig-company" class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        Company
                    </label>
                    <InputCn
                        id="sig-company"
                        Value="@_company"
                        ValueChanged="@((string v) => _company = v)"
                        Placeholder="Your company name"
                        Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                Skip
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                Save Signature
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private string _name = "Sarah Chen";
    private string _title = "Product Designer";
    private string _company = "Acme Inc";
}
