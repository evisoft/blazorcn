@* ============================================================
   Block: onboarding-milestone-targets
   Title: OnboardingMilestoneTargets
   Description: A milestone targets onboarding block for React and Next.js with 30, 60, and 90 day milestone inputs, metric select dropdowns, and timeline visual built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-milestone-targets.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="flag" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">
                    Set your first milestones
                </span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Define targets for the next 90 days to track your progress.
            </p>
        </div>

        @* Milestone rows with timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @* Connecting line *@
                <div class="absolute left-[7px] top-3 bottom-3 w-px bg-border" />

                <div class="space-y-0">
                    @foreach (var ms in _milestones)
                    {
                        var milestone = ms;
                        var idx = _milestones.IndexOf(milestone);
                        <div class="relative pl-7">
                            @* Timeline dot *@
                            <div class="absolute left-0 top-1.5 flex size-[15px] items-center justify-center rounded-full border bg-card">
                                <span class="size-1.5 rounded-full bg-foreground" />
                            </div>

                            <div class="@(idx < _milestones.Count - 1 ? "pb-5" : "")">
                                <div class="flex items-center justify-between gap-3">
                                    <span class="font-medium text-sm">@milestone.Days-day target</span>
                                    <div class="flex items-baseline gap-1">
                                        <span class="font-semibold text-sm tabular-nums">@milestone.Target.ToString("N0")</span>
                                        <span class="text-muted-foreground text-xs">
                                            @milestone.Metric.ToLower()
                                        </span>
                                    </div>
                                </div>

                                <div class="mt-2.5 flex items-center gap-2">
                                    <input
                                        class="h-7 flex-1 border-0 bg-transparent px-0 text-xs shadow-none focus-visible:ring-0 outline-none"
                                        value="@milestone.Description"
                                        @oninput="@((ChangeEventArgs e) => UpdateDescription(milestone.Id, e.Value?.ToString() ?? ""))"
                                        placeholder="Describe this milestone..."
                                        aria-label="@($"Description for {milestone.Days}-day milestone")" />
                                    <SelectCn Value="@milestone.Metric" ValueChanged="@((string v) => UpdateMetric(milestone.Id, v))">
                                        <SelectTriggerCn Class="h-7 w-24 text-xs" aria-label="@($"Metric type for {milestone.Days}-day milestone")">
                                            <SelectValueCn />
                                        </SelectTriggerCn>
                                        <SelectContentCn>
                                            @foreach (var opt in _metricOptions)
                                            {
                                                var option = opt;
                                                <SelectItemCn Value="@option" Class="text-xs">@option</SelectItemCn>
                                            }
                                        </SelectContentCn>
                                    </SelectCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_milestones.Count milestones configured
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Save Milestones
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private sealed class MilestoneItem
    {
        public string Id { get; init; } = "";
        public int Days { get; init; }
        public string Description { get; set; } = "";
        public string Metric { get; set; } = "";
        public int Target { get; init; }
    }

    private static readonly string[] _metricOptions = ["Users", "Revenue", "Features"];

    private List<MilestoneItem> _milestones =
    [
        new() { Id = "m30", Days = 30, Description = "Launch beta to early adopters", Metric = "Users", Target = 100 },
        new() { Id = "m60", Days = 60, Description = "Reach first revenue milestone", Metric = "Revenue", Target = 5000 },
        new() { Id = "m90", Days = 90, Description = "Ship core feature set", Metric = "Features", Target = 12 },
    ];

    private void UpdateDescription(string id, string description)
    {
        var item = _milestones.Find(m => m.Id == id);
        if (item is not null) item.Description = description;
    }

    private void UpdateMetric(string id, string metric)
    {
        var item = _milestones.Find(m => m.Id == id);
        if (item is not null) item.Metric = metric;
    }
}
