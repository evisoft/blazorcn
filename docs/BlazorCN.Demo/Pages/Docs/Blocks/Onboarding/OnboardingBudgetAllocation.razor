@* ============================================================
   Block: onboarding-budget-allocation
   Title: OnboardingBudgetAllocation
   Description: A React budget allocation onboarding block for Next.js with NumberFlow animated total, category rows with progress bars, and set budgets action. Built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-budget-allocation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="wallet" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Set your budget</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Allocate spending limits across categories.
            </p>
        </div>

        @* Total budget *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="text-muted-foreground text-sm">$</span>
                <span class="text-2xl font-semibold tabular-nums">@_totalBudget.ToString("N0")</span>
                <span class="text-muted-foreground text-xs">/mo</span>
            </div>
            <div class="ml-auto">
                <span class="text-muted-foreground text-xs tabular-nums">
                    $<span class="inline font-medium tabular-nums">@((_totalBudget - _allocated).ToString("N0"))</span> unallocated
                </span>
            </div>
        </div>

        @* Category rows *@
        <div>
            @for (var i = 0; i < _categories.Length; i++)
            {
                var category = _categories[i];
                var percentage = (int)Math.Round((double)category.Amount / _totalBudget * 100);
                var isLast = i == _categories.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-center justify-between">
                            <span class="font-medium text-sm">@category.Name</span>
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-sm tabular-nums">$@category.Amount.ToString("N0")</span>
                                <span class="text-muted-foreground text-xs tabular-nums">@percentage%</span>
                            </div>
                        </div>
                        <div class="mt-2">
                            <ProgressCn Value="@percentage" Class="h-1.5" aria-label="Progress" />
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs tabular-nums">
                $@_allocated.ToString("N0") of $@_totalBudget.ToString("N0") allocated
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Set Budgets
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record BudgetCategory(string Id, string Name, int Amount);

    private static readonly BudgetCategory[] _categories =
    [
        new("infra",     "Infrastructure", 3500),
        new("marketing", "Marketing",      2500),
        new("tools",     "Tools",          2000),
        new("team",      "Team",           2000),
    ];

    private const int _totalBudget = 10000;

    private int _allocated => _categories.Sum(c => c.Amount);
}
