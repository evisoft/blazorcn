@* ============================================================
   Block: onboarding-status-page
   Title: OnboardingStatusPage
   Description: A status page configuration onboarding block for React and Next.js with domain input, service component rows, status selectors, and publish button. Built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-status-page.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Set Up Your Status Page</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Publish a public status page for your services
            </p>
        </div>

        @* Domain input *@
        <div class="border-b px-4 py-3">
            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                Status page URL
            </span>
            <InputCn Value="@_domain"
                     ValueChanged="@((string v) => { _domain = v; })"
                     Placeholder="status.yourcompany.com"
                     Class="h-8 font-mono text-xs" />
        </div>

        @* Component rows *@
        <div>
            @foreach (var comp in _components)
            {
                var isLast = comp.Id == _components[_components.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetStatusDot(comp.Status))"></span>
                        <span class="min-w-0 flex-1 font-medium text-sm">@comp.Name</span>
                        <SelectCn Value="@comp.Status"
                                  ValueChanged="@((string? v) => UpdateStatus(comp.Id, v ?? comp.Status))">
                            <SelectTriggerCn Class="h-7 w-32 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="operational" Class="text-xs">Operational</SelectItemCn>
                                <SelectItemCn Value="degraded" Class="text-xs">Degraded</SelectItemCn>
                                <SelectItemCn Value="down" Class="text-xs">Down</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @(_components.Length) components configured
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Publish Status Page
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record StatusComponent(string Id, string Name, string Status);

    private StatusComponent[] _components =
    [
        new("api",       "API",       "operational"),
        new("dashboard", "Dashboard", "operational"),
        new("database",  "Database",  "operational"),
        new("cdn",       "CDN",       "operational"),
    ];

    private string _domain = "status.acme.com";

    private static string GetStatusDot(string status) => status switch
    {
        "operational" => "bg-emerald-500",
        "degraded"    => "bg-amber-500",
        "down"        => "bg-red-500",
        _             => "bg-emerald-500",
    };

    private void UpdateStatus(string id, string status)
    {
        _components = [.. _components.Select(c => c.Id == id ? c with { Status = status } : c)];
    }
}
