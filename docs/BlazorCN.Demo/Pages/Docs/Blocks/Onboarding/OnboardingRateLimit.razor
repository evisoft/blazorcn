@* ============================================================
   Block: onboarding-rate-limit
   Title: OnboardingRateLimit
   Description: A React onboarding API rate limit configuration with requests per minute selector, usage progress bar, overage handling, and apply action built with Next.js, TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-rate-limit.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Rate Limits</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Configure API rate limits to control request throughput and protect your services from
                traffic spikes.
            </p>
        </div>

        @* Rate limit select *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Requests per minute
            </span>
            <SelectCn TValue="string" Value="@_rateLimit" ValueChanged="@((string v) => SetRateLimit(v))">
                <SelectTriggerCn Class="h-8 text-xs">
                    <SelectValueCn Placeholder="Select limit" />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var opt in _rateLimitOptions)
                    {
                        var item = opt;
                        <SelectItemCn Value="@item.Value" Class="text-xs">@item.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Current usage *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Current usage</span>
                <span class="@Cn.Merge("font-mono text-xs tabular-nums", _usageColor)">
                    @_currentUsage / @_limit.ToString("N0") RPM
                </span>
            </div>
            <ProgressCn Value="@((double)_usagePercent)" Class="h-1.5" />
            <p class="mt-1.5 text-muted-foreground text-xs">@_usagePercent% of limit used</p>
        </div>

        @* Overage handling *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Overage handling
            </span>
            <SelectCn TValue="string" Value="@_overage" ValueChanged="@((string v) => SetOverage(v))">
                <SelectTriggerCn Class="h-8 text-xs">
                    <SelectValueCn Placeholder="Select handling" />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var opt in _overageOptions)
                    {
                        var item = opt;
                        <SelectItemCn Value="@item.Value" Class="text-xs">@item.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-end px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                Apply Limits
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record RateLimitOption(string Value, string Label);

    private static readonly RateLimitOption[] _rateLimitOptions =
    [
        new("100",  "100 RPM"),
        new("500",  "500 RPM"),
        new("1000", "1,000 RPM"),
        new("5000", "5,000 RPM"),
    ];

    private static readonly RateLimitOption[] _overageOptions =
    [
        new("queue",    "Queue — hold and retry later"),
        new("reject",   "Reject — return 429 immediately"),
        new("throttle", "Throttle — slow down requests"),
    ];

    private const int _currentUsage = 342;

    private string _rateLimit = "1000";
    private string _overage = "throttle";

    private int _limit => int.TryParse(_rateLimit, out var v) ? v : 1000;
    private int _usagePercent => Math.Min((int)Math.Round((double)_currentUsage / _limit * 100), 100);

    private string _usageColor =>
        _usagePercent >= 90 ? "text-red-600 dark:text-red-400" :
        _usagePercent >= 70 ? "text-amber-600 dark:text-amber-400" :
        "text-muted-foreground";

    private void SetRateLimit(string v) => _rateLimit = v;
    private void SetOverage(string v) => _overage = v;
}
