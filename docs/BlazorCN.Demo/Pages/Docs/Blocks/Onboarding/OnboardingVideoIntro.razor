@* ============================================================
   Block: onboarding-video-intro
   Title: OnboardingVideoIntro
   Description: A React and Next.js video introduction onboarding block featuring 16:9 video placeholder, chapter progress indicators, and skip/continue actions built with TypeScript, shadcn/ui, and Tailwind CSS for product walkthroughs.
   Source: original/blocks/onboarding/onboarding-video-intro.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="video" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Quick Introduction</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Watch a quick video to learn how everything works. It only takes 2 minutes.
            </p>
        </div>

        @* Video placeholder *@
        <div class="border-b px-4 py-3">
            <div class="flex aspect-video items-center justify-center rounded-md bg-muted/50">
                <div class="text-center">
                    <LucideIconCn Name="play-circle" Size="40" Class="mx-auto size-10 text-muted-foreground/40" />
                    <p class="mt-2 font-medium text-muted-foreground text-sm">Watch 2 min intro</p>
                    <p class="mt-0.5 text-muted-foreground/60 text-xs">
                        Learn the basics in a quick walkthrough
                    </p>
                </div>
            </div>
        </div>

        @* Chapter dots *@
        <div class="flex items-center justify-center gap-4 border-b px-4 py-3">
            @foreach (var chap in _chapters)
            {
                var idx = chap.Index;
                var dotClass = idx == _activeChapter
                    ? "bg-foreground"
                    : idx < _activeChapter
                        ? "bg-foreground/40"
                        : "bg-muted-foreground/30";
                var labelClass = idx == _activeChapter
                    ? "font-medium text-foreground"
                    : "text-muted-foreground";
                var ariaCurrent = idx == _activeChapter ? "step" : null;
                <button type="button"
                        @onclick="@(() => _activeChapter = idx)"
                        class="flex items-center gap-1.5"
                        aria-current="@ariaCurrent">
                    <span class="@($"size-2 rounded-full transition-colors {dotClass}")" />
                    <span class="@($"text-xs {labelClass}")">@chap.Label</span>
                </button>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Skip Video</ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Continue</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record ChapterItem(int Index, string Id, string Label);

    private static readonly ChapterItem[] _chapters =
    [
        new(0, "c1", "Welcome"),
        new(1, "c2", "Navigation"),
        new(2, "c3", "Features"),
        new(3, "c4", "Next steps"),
    ];

    private int _activeChapter = 0;
}
