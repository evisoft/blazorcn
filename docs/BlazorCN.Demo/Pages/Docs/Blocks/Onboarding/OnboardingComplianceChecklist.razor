@* ============================================================
   Block: onboarding-compliance-checklist
   Title: OnboardingComplianceChecklist
   Description: A compliance requirements onboarding block for React and Next.js with five checklist items, checkbox toggles, progress bar, and mark all complete action built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-compliance-checklist.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="clipboard-check" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Compliance Checklist</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Complete these requirements to ensure your workspace meets compliance standards. All
                items must be addressed before going live.
            </p>
        </div>

        @* Progress *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">@_completedCount of @_items.Length complete</span>
                <span class="font-medium text-xs tabular-nums">@_progressPercent%</span>
            </div>
            <ProgressCn Value="@_progressPercent" Class="h-1.5" />
        </div>

        @* Checklist Items *@
        <div>
            @for (int i = 0; i < _items.Length; i++)
            {
                var item = _items[i];
                var isLast = i == _items.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <label for="@($"compliance-{item.Id}")" class="flex cursor-pointer items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <CheckboxCn
                            id="@($"compliance-{item.Id}")"
                            Checked="@item.IsChecked"
                            CheckedChanged="@((bool v) => ToggleItem(item.Id))"
                            Class="mt-0.5" />
                        <div class="min-w-0 flex-1">
                            <span class="@Cn.Merge("font-medium text-sm", item.IsChecked ? "text-muted-foreground line-through" : "")">
                                @item.Title
                            </span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                        </div>
                    </label>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="MarkAllComplete">
                Mark All Complete
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                Continue
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record ComplianceItem(string Id, string Title, string Description, bool IsChecked);

    private ComplianceItem[] _items =
    [
        new("gdpr", "GDPR consent", "User consent collection and management configured", true),
        new("encryption", "Data encryption", "Data encrypted at rest and in transit with AES-256", true),
        new("logging", "Access logging", "All data access events recorded and auditable", false),
        new("audits", "Regular audits", "Quarterly security audits scheduled with third-party firm", false),
        new("incident", "Incident response plan", "Documented procedures for security incident handling", false),
    ];

    private int _completedCount => _items.Count(i => i.IsChecked);
    private int _progressPercent => (int)Math.Round((double)_completedCount / _items.Length * 100);

    private void ToggleItem(string id)
    {
        _items = _items
            .Select(item => item.Id == id ? item with { IsChecked = !item.IsChecked } : item)
            .ToArray();
    }

    private void MarkAllComplete()
    {
        _items = _items.Select(item => item with { IsChecked = true }).ToArray();
    }
}
