@* ============================================================
   Block: onboarding-ai-assistant
   Title: OnboardingAiAssistant
   Description: React AI assistant introduction onboarding block with capability highlights, dot indicators, try-it-now input with send button, and skip action. Built with Next.js, shadcn/ui Input and Button, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-ai-assistant.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Meet your AI assistant</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Your AI assistant can help you work faster. Here is what it can do.
            </p>
        </div>

        @* Capabilities *@
        <div>
            @foreach (var cap in _capabilities)
            {
                <div class="border-b">
                    <div class="flex items-start gap-3 px-4 py-3">
                        <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-emerald-500" aria-hidden="true"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@cap.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@cap.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Try it now input *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Try it now</span>
            <div class="flex items-center gap-2">
                <InputCn @bind-Value="_query"
                         Placeholder="Ask anything..."
                         Class="h-8 flex-1 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                <ButtonCn Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Sm"
                          Class="h-7 shrink-0 px-2"
                          Disabled="@(string.IsNullOrWhiteSpace(_query))"
                          aria-label="Send message">
                    <LucideIconCn Name="send" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-end px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                Skip intro
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Capability(string Id, string Label, string Description);

    private static readonly Capability[] _capabilities =
    [
        new("answers", "Answer questions", "Get instant answers about your data, docs, and workspace settings"),
        new("generate", "Generate content", "Create drafts, summaries, and reports from your existing materials"),
        new("analyze", "Analyze data", "Surface insights, trends, and anomalies across your datasets"),
    ];

    private string _query = "";
}
