@* ========================================
   Block: onboarding-welcome
   Title: Onboarding Welcome
   Description: Welcome modal with feature highlights, benefits list, and get started CTA for first-time users
   Long Description: Use case selection with option cards, icons, and multi-select support for experience personalization
   Dependencies: LucideCheckCircle2Cn, LucideShieldCn, LucideSparklesCn, LucideUsersCn, LucideZapCn
   Source: original/blocks/onboarding/onboarding-welcome.tsx
   ======================================== *@

<div class="flex items-center justify-center p-10 w-full min-h-[500px]">
    <ButtonCn @onclick="@(() => _open = true)">Open Welcome Modal</ButtonCn>

    <DialogCn @bind-Open="_open">
        <DialogContentCn Class="sm:max-w-lg">
            <DialogHeaderCn Class="text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10">
                    <LucideSparklesCn Class="h-8 w-8 text-primary" Size="32" />
                </div>
                <DialogTitleCn Class="text-2xl">Welcome to Acme</DialogTitleCn>
                <DialogDescriptionCn Class="text-base">
                    You're all set up and ready to go. Here's what you can do with your new account.
                </DialogDescriptionCn>
            </DialogHeaderCn>

            <div class="grid grid-cols-3 gap-4 py-4">
                <div class="text-center">
                    <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-lg bg-muted text-muted-foreground">
                        <LucideZapCn Class="h-5 w-5" Size="20" />
                    </div>
                    <h4 class="text-sm font-medium text-foreground">Lightning fast</h4>
                    <p class="text-xs text-muted-foreground mt-0.5">Built for speed and performance</p>
                </div>
                <div class="text-center">
                    <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-lg bg-muted text-muted-foreground">
                        <LucideShieldCn Class="h-5 w-5" Size="20" />
                    </div>
                    <h4 class="text-sm font-medium text-foreground">Secure by default</h4>
                    <p class="text-xs text-muted-foreground mt-0.5">Enterprise-grade security</p>
                </div>
                <div class="text-center">
                    <div class="mx-auto mb-2 flex h-10 w-10 items-center justify-center rounded-lg bg-muted text-muted-foreground">
                        <LucideUsersCn Class="h-5 w-5" Size="20" />
                    </div>
                    <h4 class="text-sm font-medium text-foreground">Team collaboration</h4>
                    <p class="text-xs text-muted-foreground mt-0.5">Work together seamlessly</p>
                </div>
            </div>

            <div class="rounded-lg border p-4">
                <h4 class="text-sm font-medium text-foreground mb-3">Your account includes:</h4>
                <ul class="space-y-2">
                    @foreach (var benefit in _benefits)
                    {
                        <li class="flex items-center gap-2 text-sm">
                            <LucideCircleCheckCn Class="h-4 w-4 text-primary shrink-0" Size="16" />
                            <span class="text-muted-foreground">@benefit</span>
                        </li>
                    }
                </ul>
            </div>

            <DialogFooterCn Class="flex-col gap-2 sm:flex-col">
                <ButtonCn Class="w-full" @onclick="@(() => _open = false)">Get started</ButtonCn>
                <ButtonCn Class="w-full" @onclick="@(() => _open = false)" Variant="ButtonVariant.Ghost">
                    I'll explore on my own
                </ButtonCn>
            </DialogFooterCn>
        </DialogContentCn>
    </DialogCn>
</div>

@code {
    private static readonly string[] _benefits =
    [
        "Unlimited projects and workspaces",
        "Real-time collaboration features",
        "Advanced analytics and reporting",
        "Priority customer support",
    ];

    private bool _open;
}
