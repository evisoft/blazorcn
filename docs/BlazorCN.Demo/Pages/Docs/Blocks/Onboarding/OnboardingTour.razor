@* ========================================
   Block: onboarding-tour
   Title: Onboarding Tour
   Description: Interactive tour with spotlight highlights, step tooltips, and guided walkthrough for feature education
   Long Description: React Onboarding Template Selection
   Dependencies: LucideBarChart3Cn, LucideBellCn, LucideChevronLeftCn, LucideChevronRightCn, LucideFileTextCn, LucideHomeCn, LucideSearchCn, LucideSettingsCn, LucideUsersCn, LucideXCn
   Source: original/blocks/onboarding/onboarding-tour.tsx
   ======================================== *@

<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-2xl overflow-hidden">
        <CardContentCn Class="p-0">
            <div class="flex">
                @* Mock sidebar *@
                <div class="w-48 border-r bg-muted/30 p-3">
                    <div class="flex items-center gap-2 px-2 py-1.5 mb-4">
                        <div class="h-6 w-6 rounded bg-primary"></div>
                        <span class="font-semibold text-sm">Acme Inc</span>
                    </div>
                    @* Search *@
                    <div class="@Cn.Merge("flex items-center gap-2 px-2 py-1.5 rounded-md mb-2 text-sm text-muted-foreground", _tourActive && _step.Target == "search" ? "ring-2 ring-primary ring-offset-2 bg-background" : "")">
                        <LucideSearchCn Class="h-4 w-4" Size="16" />
                        <span>Search...</span>
                    </div>
                    @* Nav items *@
                    <div class="space-y-1">
                        @foreach (var item in _sidebarItems)
                        {
                            <div class="@Cn.Merge("flex items-center gap-2 px-2 py-1.5 rounded-md text-sm", item.Id == "dashboard" ? "bg-primary/10 text-primary font-medium" : "text-muted-foreground hover:bg-muted", _tourActive && _step.Target == item.Id ? "ring-2 ring-primary ring-offset-2 bg-background" : "")">
                                @switch (item.Icon)
                                {
                                    case "home": <LucideHouseCn Class="h-4 w-4" Size="16" /> break;
                                    case "file-text": <LucideFileTextCn Class="h-4 w-4" Size="16" /> break;
                                    case "users": <LucideUsersCn Class="h-4 w-4" Size="16" /> break;
                                    case "bar-chart-3": <LucideChartColumnCn Class="h-4 w-4" Size="16" /> break;
                                    case "settings": <LucideSettingsCn Class="h-4 w-4" Size="16" /> break;
                                }
                                <span>@item.Label</span>
                            </div>
                        }
                    </div>
                </div>

                @* Mock content area *@
                <div class="flex-1 p-4 relative min-h-[300px]">
                    <div class="flex items-center justify-between mb-4">
                        <h2 class="font-semibold">Dashboard</h2>
                        <LucideBellCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        @for (var i = 0; i < 4; i++)
                        {
                            <div class="h-16 rounded-lg border bg-muted/30"></div>
                        }
                    </div>

                    @if (_tourActive)
                    {
                        <div class="absolute bottom-4 left-4 right-4 z-10">
                            <CardCn Class="shadow-lg border-primary/20">
                                <CardContentCn Class="p-4">
                                    <div class="flex items-start justify-between gap-4">
                                        <div class="flex-1">
                                            <div class="flex items-center gap-2 mb-1">
                                                <span class="text-xs font-medium text-primary">
                                                    Step @(_currentStep + 1) of @_tourSteps.Length
                                                </span>
                                            </div>
                                            <h3 class="font-semibold text-foreground mb-1">@_step.Title</h3>
                                            <p class="text-sm text-muted-foreground">@_step.Description</p>
                                        </div>
                                        <ButtonCn Class="h-6 w-6 shrink-0" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                                                  @onclick="@(() => _tourActive = false)" aria-label="Close">
                                            <LucideXCn Class="h-4 w-4" Size="16" />
                                        </ButtonCn>
                                    </div>
                                    <div class="flex items-center justify-between mt-4">
                                        <ButtonCn Disabled="@(_currentStep == 0)" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                                                  @onclick="@(() => _currentStep--)">
                                            <LucideChevronLeftCn Class="h-4 w-4 mr-1" Size="16" />
                                            Back
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Sm"
                                                  @onclick="@(() => { if (_currentStep < _tourSteps.Length - 1) _currentStep++; else _tourActive = false; })">
                                            @if (_currentStep == _tourSteps.Length - 1)
                                            {
                                                <span>Finish</span>
                                            }
                                            else
                                            {
                                                <span>Next</span>
                                                <LucideChevronRightCn Class="h-4 w-4 ml-1" Size="16" />
                                            }
                                        </ButtonCn>
                                    </div>
                                </CardContentCn>
                            </CardCn>
                        </div>
                    }

                    @if (!_tourActive)
                    {
                        <div class="absolute inset-0 flex items-center justify-center bg-background/80">
                            <div class="text-center">
                                <p class="text-muted-foreground mb-3">Tour completed!</p>
                                <ButtonCn @onclick="@(() => { _currentStep = 0; _tourActive = true; })">Restart Tour</ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private record TourStep(string Target, string Title, string Description);
    private record SidebarItem(string Id, string Icon, string Label);

    private static readonly TourStep[] _tourSteps =
    [
        new("dashboard", "Your Dashboard", "This is your home base. View key metrics and recent activity at a glance."),
        new("search", "Quick Search", "Find anything instantly. Press Ctrl+K to open search from anywhere."),
        new("documents", "Documents", "Create, edit, and organize all your documents in one place."),
        new("team", "Team Management", "Invite members, manage permissions, and collaborate effectively."),
        new("analytics", "Analytics", "Track performance with detailed charts and exportable reports."),
    ];

    private static readonly SidebarItem[] _sidebarItems =
    [
        new("dashboard", "home", "Dashboard"),
        new("documents", "file-text", "Documents"),
        new("team", "users", "Team"),
        new("analytics", "bar-chart-3", "Analytics"),
        new("settings", "settings", "Settings"),
    ];

    private int _currentStep;
    private bool _tourActive = true;
    private TourStep _step => _tourSteps[_currentStep];
}
