@* ========================================
   Block: onboarding-completion
   Title: Onboarding Completion
   Description: Completion celebration with success animation, achievement stats, and next step suggestions
   Long Description: Expandable checklist with progress indicator, step descriptions, and action buttons for guided setup flows
   Dependencies: LucideArrowRightCn, LucideRocketCn, LucideStarCn, LucideTrophyCn
   Source: original/blocks/onboarding/onboarding-completion.tsx
   ======================================== *@
<div class="flex items-center justify-center p-10 w-full">
      <CardCn Class="w-full max-w-md overflow-hidden">
        <CardContentCn Class="p-0">
          @* Celebration header *@
          <div class="relative bg-gradient-to-br from-primary/20 via-primary/10 to-transparent p-8 text-center">
            @* Decorative stars *@
            <LucideStarCn Size="16" Class="absolute top-4 left-8 text-amber-400 fill-amber-400" />
            <LucideStarCn Size="12" Class="absolute top-12 right-12 text-amber-400 fill-amber-400" />
            <LucideStarCn Size="12" Class="absolute bottom-8 left-16 text-amber-400 fill-amber-400" />
            <LucideStarCn Size="20" Class="absolute top-6 right-6 text-amber-400 fill-amber-400" />

            @* Trophy icon *@
            <div class="relative mx-auto mb-4 flex h-20 w-20 items-center justify-center">
              <div class="absolute inset-0 rounded-full bg-amber-400/20 animate-ping" ></div>
              <div class="relative flex h-20 w-20 items-center justify-center rounded-full bg-amber-100 dark:bg-amber-900/50">
                <LucideTrophyCn Size="40" Class="text-amber-500" />
              </div>
            </div>

            <h2 class="text-2xl font-bold text-foreground mb-2">You're all set!</h2>
            <p class="text-muted-foreground">Congratulations on completing your setup</p>
          </div>

          @* Stats *@
          <div class="grid grid-cols-3 divide-x border-b">
            @foreach (var stat in _stats)
            {
                <div class="p-4 text-center">
                <div class="text-lg font-bold text-foreground">@stat.Value</div>
                <div class="text-xs text-muted-foreground">@stat.Label</div>
              </div>
            }
          </div>

          @* What's next *@
          <div class="p-6">
            <h3 class="font-medium text-foreground mb-4">What's next?</h3>
            <div class="space-y-3">
              <button
                type="button"
                class="flex items-center gap-3 w-full p-3 rounded-lg border hover:bg-muted/50 transition-colors text-left"
              >
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-primary/10">
                  <LucideRocketCn Size="20" Class="text-primary" />
                </div>
                <div class="flex-1">
                  <div class="font-medium text-foreground text-sm">
                    Create your first project
                  </div>
                  <div class="text-xs text-muted-foreground">
                    Start building something amazing
                  </div>
                </div>
                <LucideArrowRightCn Size="16" Class="text-muted-foreground" />
              </button>

              <button
                type="button"
                class="flex items-center gap-3 w-full p-3 rounded-lg border hover:bg-muted/50 transition-colors text-left"
              >
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-muted">
                  <LucidePartyPopperCn Class="h-5 w-5 text-muted-foreground" />
                </div>
                <div class="flex-1">
                  <div class="font-medium text-foreground text-sm">Explore templates</div>
                  <div class="text-xs text-muted-foreground">
                    Get started with pre-built designs
                  </div>
                </div>
                <LucideArrowRightCn Size="16" Class="text-muted-foreground" />
              </button>
            </div>

            <ButtonCn Class="w-full mt-6">
              Go to dashboard
              <LucideArrowRightCn Size="16" Class="ml-2" />
            </ButtonCn>
          </div>
        </CardContentCn>
      </CardCn>
    </div>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record StatItem(string Label, string Value);

    private readonly StatItem[] _stats =
    [
        new("Tasks completed", "7"),
        new("Time taken", "12 min"),
        new("Achievement", "Fast Starter"),
    ];
}
