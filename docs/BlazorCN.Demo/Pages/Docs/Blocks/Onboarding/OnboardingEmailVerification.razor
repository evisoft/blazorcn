@* ========================================
   Block: onboarding-email-verification
   Title: Onboarding Email Verification
   Description: Email verification with OTP input, resend timer, and verification status for secure authentication
   Long Description: Data import with file upload, source selection, and progress indicator for migration flows
   Dependencies: LucideCircleCheckCn, LucideLoaderCn, LucideMailCn, LucideRefreshCwCn
   Source: original/blocks/onboarding/onboarding-email-verification.tsx
   ======================================== *@

<div class="flex w-full items-center justify-center p-10">
    @if (_verified)
    {
        <CardCn Class="w-full max-w-sm">
            <CardContentCn Class="pt-6 text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100 dark:bg-emerald-900/30">
                    <LucideCircleCheckCn Size="32" Class="h-8 w-8 text-emerald-600 dark:text-emerald-400" />
                </div>
                <h3 class="mb-2 text-xl font-semibold text-foreground">Email verified!</h3>
                <p class="mb-6 text-sm text-muted-foreground">
                    Your email has been successfully verified. You can now continue.
                </p>
                <ButtonCn Class="w-full">Continue to dashboard</ButtonCn>
            </CardContentCn>
        </CardCn>
    }
    else
    {
        <CardCn Class="w-full max-w-sm">
            <CardHeaderCn Class="text-center">
                <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
                    <LucideMailCn Size="24" Class="h-6 w-6 text-primary" />
                </div>
                <CardTitleCn>Verify your email</CardTitleCn>
                <CardDescriptionCn>
                    We sent a 6-digit code to
                    <span class="font-medium text-foreground">@_userEmail</span>
                </CardDescriptionCn>
            </CardHeaderCn>
            <CardContentCn Class="space-y-6">
                @* OTP Input *@
                <div class="flex justify-center">
                    <InputOtpCn MaxLength="6" @bind-Value="_otp" Disabled="@_verifying">
                        <InputOtpGroupCn>
                            <InputOtpSlotCn Index="0" />
                            <InputOtpSlotCn Index="1" />
                            <InputOtpSlotCn Index="2" />
                        </InputOtpGroupCn>
                        <InputOtpSeparatorCn />
                        <InputOtpGroupCn>
                            <InputOtpSlotCn Index="3" />
                            <InputOtpSlotCn Index="4" />
                            <InputOtpSlotCn Index="5" />
                        </InputOtpGroupCn>
                    </InputOtpCn>
                </div>

                @* Error message *@
                @if (!string.IsNullOrEmpty(_error))
                {
                    <p class="text-center text-sm text-destructive">@_error</p>
                }

                @* Verifying state *@
                @if (_verifying)
                {
                    <div class="flex items-center justify-center gap-2 text-sm text-muted-foreground">
                        <LucideLoaderCn Size="16" Class="h-4 w-4 animate-spin" />
                        Verifying...
                    </div>
                }

                @* Resend *@
                <div class="text-center">
                    <p class="mb-2 text-sm text-muted-foreground">Didn't receive the code?</p>
                    @if (_canResend)
                    {
                        <ButtonCn Class="text-primary" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" @onclick="HandleResend">
                            <LucideRefreshCwCn Size="16" Class="mr-2 h-4 w-4" />
                            Resend code
                        </ButtonCn>
                    }
                    else
                    {
                        <p class="text-sm text-muted-foreground">Resend in @(_resendTimer)s</p>
                    }
                </div>

                @* Change email *@
                <div class="border-t pt-2 text-center">
                    <button type="button" class="text-sm text-primary hover:underline">
                        Use a different email
                    </button>
                </div>
            </CardContentCn>
        </CardCn>
    }
</div>

@code {
    private string _otp = "";
    private bool _verifying;
    private bool _verified;
    private string _error = "";
    private int _resendTimer = 60;
    private bool _canResend;

    private const string _userEmail = "john@example.com";

    private void HandleResend()
    {
        _canResend = false;
        _resendTimer = 60;
        _error = "";
    }
}
