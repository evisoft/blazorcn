@* ========================================
   Block: onboarding-goal-setting
   Title: Onboarding Goal Setting
   Description: Goal setting with objective input, priority selector, and goal list management for productivity flows
   Long Description: First project creation with name input, settings toggles, and step-by-step creation progress
   Dependencies: LucideCalendarCn, LucideFlagCn, LucidePlusCn, LucideTargetCn, LucideXCn
   Source: original/blocks/onboarding/onboarding-goal-setting.tsx
   ======================================== *@
<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-md">
        <CardHeaderCn Class="text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
                <LucideTargetCn Size="24" Class="text-primary" />
            </div>
            <CardTitleCn>Set your goals</CardTitleCn>
            <CardDescriptionCn>What do you want to achieve? We'll help you get there.</CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn Class="space-y-6">
            @* Existing goals *@
            @if (_goals.Count > 0)
            {
                <div class="space-y-2">
                    @foreach (var goal in _goals)
                    {
                        var colorClass = _priorityColors[goal.Priority];
                        <div class="flex items-center gap-3 p-3 rounded-lg border bg-card">
                            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-muted">
                                <LucideFlagCn Class="@(Cn.Merge("h-4 w-4", colorClass))" Size="16" />
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-sm font-medium text-foreground truncate">@goal.Title</p>
                                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                    <LucideCalendarCn Size="12" />
                                    @goal.Deadline
                                </div>
                            </div>
                            <ButtonCn
                                Class="h-8 w-8 shrink-0"
                                @onclick="@(() => RemoveGoal(goal.Id))"
                                Size="ButtonSize.Icon"
                                Variant="ButtonVariant.Ghost">
                                <LucideXCn Size="16" />
                            </ButtonCn>
                        </div>
                    }
                </div>
            }

            @* Add new goal *@
            <div class="space-y-3">
                <div class="space-y-2">
                    <LabelCn For="goal">Add a goal</LabelCn>
                    <InputCn
                        id="goal"
                        Placeholder="e.g., Increase revenue by 20%"
                        Value="@_newGoal"
                        ValueChanged="@((string v) => _newGoal = v)" />
                </div>

                <div class="flex items-center gap-3">
                    <div class="flex-1 space-y-2">
                        <LabelCn For="priority">Priority</LabelCn>
                        <SelectCn Value="@_newPriority" ValueChanged="@((string v) => _newPriority = v)">
                            <SelectTriggerCn id="priority">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="low">
                                    <span class="flex items-center gap-2">
                                        <LucideFlagCn Size="12" Class="text-muted-foreground" />
                                        Low
                                    </span>
                                </SelectItemCn>
                                <SelectItemCn Value="medium">
                                    <span class="flex items-center gap-2">
                                        <LucideFlagCn Size="12" Class="text-amber-500" />
                                        Medium
                                    </span>
                                </SelectItemCn>
                                <SelectItemCn Value="high">
                                    <span class="flex items-center gap-2">
                                        <LucideFlagCn Size="12" Class="text-destructive" />
                                        High
                                    </span>
                                </SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>

                    <ButtonCn
                        Class="mt-7"
                        Disabled="@(string.IsNullOrWhiteSpace(_newGoal))"
                        @onclick="AddGoal"
                        Variant="ButtonVariant.Outline">
                        <LucidePlusCn Size="16" Class="mr-2" />
                        Add
                    </ButtonCn>
                </div>
            </div>

            @* Summary *@
            @if (_goals.Count > 0)
            {
                <div class="flex items-center justify-between p-3 rounded-lg bg-muted/50 text-sm">
                    <span class="text-muted-foreground">
                        @_goals.Count goal@(_goals.Count != 1 ? "s" : "") set
                    </span>
                    <span class="font-medium text-foreground">
                        @(_goals.Count(g => g.Priority == "high")) high priority
                    </span>
                </div>
            }

            @* Actions *@
            <div class="flex items-center justify-between pt-4 border-t">
                <ButtonCn Variant="ButtonVariant.Ghost">Skip for now</ButtonCn>
                <ButtonCn Disabled="@(_goals.Count == 0)">Continue</ButtonCn>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private record GoalItem(string Id, string Title, string Priority, string Deadline);

    private readonly Dictionary<string, string> _priorityColors = new()
    {
        ["low"] = "text-muted-foreground",
        ["medium"] = "text-amber-500",
        ["high"] = "text-destructive",
    };

    private List<GoalItem> _goals =
    [
        new("1", "Launch MVP", "high", "Q1 2025"),
    ];
    private string _newGoal = "";
    private string _newPriority = "medium";

    private void AddGoal()
    {
        if (string.IsNullOrWhiteSpace(_newGoal)) return;
        _goals.Add(new(Guid.NewGuid().ToString(), _newGoal, _newPriority, "Q2 2025"));
        _newGoal = "";
    }

    private void RemoveGoal(string id)
    {
        _goals.RemoveAll(g => g.Id == id);
    }
}
