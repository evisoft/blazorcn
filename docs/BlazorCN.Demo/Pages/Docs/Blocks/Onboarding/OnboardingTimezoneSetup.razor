@* ============================================================
   Block: onboarding-timezone-setup
   Title: OnboardingTimezoneSetup
   Description: A timezone configuration onboarding component for React and Next.js with IANA timezone dropdown, auto-detect badge, time preview, and confirm button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-timezone-setup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Timezone</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Set your timezone so notifications and scheduled events appear at the correct local
                time.
            </p>
        </div>

        @* Timezone select *@
        <div class="border-b px-4 py-4">
            <div class="mb-2 flex items-center gap-2">
                <span class="font-medium text-muted-foreground text-xs">Select timezone</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Auto-detected
                </BadgeCn>
            </div>
            <SelectCn Value="@_selected" ValueChanged="@((string v) => _selected = v)">
                <SelectTriggerCn Class="h-8 text-sm" aria-label="Select timezone">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var tz in _timezones)
                    {
                        <SelectItemCn Value="@tz.Value">
                            <span class="flex items-center gap-2">
                                <span>@tz.Label</span>
                                <span class="text-muted-foreground text-xs">(@tz.Offset)</span>
                            </span>
                        </SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Time preview *@
        <div class="border-b px-4 py-4">
            <div class="rounded-md bg-muted/50 p-3">
                <span class="font-medium text-muted-foreground text-xs">Your local time</span>
                <p class="mt-1 font-semibold text-2xl tabular-nums">@ActiveTimezone.Time</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @ActiveTimezone.Label (@ActiveTimezone.Offset)
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Confirm Timezone
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record TimezoneOption(string Value, string Label, string Offset, string Time);

    private static readonly TimezoneOption[] _timezones =
    [
        new("America/New_York",   "Eastern Time",            "UTC-5",  "2:30 PM"),
        new("America/Chicago",    "Central Time",            "UTC-6",  "1:30 PM"),
        new("America/Denver",     "Mountain Time",           "UTC-7",  "12:30 PM"),
        new("America/Los_Angeles","Pacific Time",            "UTC-8",  "11:30 AM"),
        new("Europe/London",      "Greenwich Mean Time",     "UTC+0",  "7:30 PM"),
        new("Europe/Berlin",      "Central European Time",   "UTC+1",  "8:30 PM"),
        new("Asia/Tokyo",         "Japan Standard Time",     "UTC+9",  "4:30 AM"),
        new("Australia/Sydney",   "Australian Eastern Time", "UTC+11", "6:30 AM"),
    ];

    private string _selected = "America/New_York";

    private TimezoneOption ActiveTimezone =>
        Array.Find(_timezones, t => t.Value == _selected) ?? _timezones[0];
}
