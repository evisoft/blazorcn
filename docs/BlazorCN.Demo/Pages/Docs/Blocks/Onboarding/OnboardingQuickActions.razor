@* ============================================================
   Block: onboarding-quick-actions
   Title: OnboardingQuickActions
   Description: A React onboarding quick actions tutorial with tryable action items, completion tracking, and progress indicator built with Next.js, TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-quick-actions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="zap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Quick Actions</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_tried.Count of @_quickActions.Length tried
            </span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Try these actions to get familiar with your workspace. Each one takes less than a
                minute.
            </p>
        </div>

        @* Action items *@
        <div>
            @foreach (var action in _quickActions)
            {
                var isDone = _tried.Contains(action.Id);
                var isLast = action.Id == _quickActions[_quickActions.Length - 1].Id;
                var captured = action;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            @if (isDone)
                            {
                                <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="@action.IconName" Size="16" Class="size-4 text-muted-foreground" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="@Cn.Merge("font-medium text-sm", isDone ? "text-muted-foreground line-through" : "")">
                                @action.Label
                            </span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@action.Description</p>
                        </div>
                        @if (isDone)
                        {
                            <span class="shrink-0 text-emerald-600 text-xs dark:text-emerald-400">Done</span>
                        }
                        else
                        {
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs" OnClick="@(() => HandleTry(captured.Id))">Try it</ButtonCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @(_tried.Count == _quickActions.Length ? "All actions completed" : "Try each action to continue")
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(_tried.Count == 0)">Continue</ButtonCn>
        </div>

    </div>
</section>

@code {
    private readonly HashSet<string> _tried = new();

    private record QuickAction(string Id, string IconName, string Label, string Description);

    private static readonly QuickAction[] _quickActions =
    [
        new("document", "file-text", "Create a document", "Start with a blank document or choose from templates"),
        new("invite",   "user-plus", "Invite a teammate",  "Collaborate in real time with your team members"),
        new("connect",  "plug",      "Connect an app",     "Link Slack, GitHub, or Linear to your workspace"),
        new("reminder", "bell",      "Set a reminder",     "Schedule a notification for an upcoming deadline"),
    ];

    private void HandleTry(string id)
    {
        _tried.Add(id);
    }
}
