@* ========================================
   Block: onboarding-stepper
   Title: Onboarding Stepper
   Description: Linear stepper with numbered steps, progress line, and navigation controls for sequential setup flows
   Long Description: React Onboarding Security Setup
   Dependencies: LucideCheckCn
   Source: original/blocks/onboarding/onboarding-stepper.tsx
   ======================================== *@

<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-2xl">
        <CardContentCn Class="p-6">
            @* Stepper *@
            <div class="mb-8">
                <div class="flex items-center justify-between">
                    @for (var i = 0; i < _steps.Length; i++)
                    {
                        var step = _steps[i];
                        var index = i;
                        <div class="flex items-center">
                            <div class="flex flex-col items-center">
                                <div class="@Cn.Merge("flex h-10 w-10 items-center justify-center rounded-full border-2 text-sm font-medium transition-colors", step.Id < _currentStep ? "border-primary bg-primary text-primary-foreground" : step.Id == _currentStep ? "border-primary text-primary" : "border-muted text-muted-foreground")">
                                    @if (step.Id < _currentStep)
                                    {
                                        <LucideCheckCn Class="h-5 w-5" Size="20" />
                                    }
                                    else
                                    {
                                        @step.Id
                                    }
                                </div>
                                <span class="@Cn.Merge("mt-2 text-xs font-medium hidden sm:block", step.Id == _currentStep ? "text-foreground" : "text-muted-foreground")">
                                    @step.Title
                                </span>
                            </div>
                            @if (index < _steps.Length - 1)
                            {
                                <div class="@Cn.Merge("h-0.5 flex-1 mx-2 sm:mx-4", step.Id < _currentStep ? "bg-primary" : "bg-muted")"></div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Current step content *@
            @{ var currentStepData = _steps.FirstOrDefault(s => s.Id == _currentStep); }
            <div class="text-center py-8">
                <h2 class="text-2xl font-semibold text-foreground mb-2">@currentStepData?.Title</h2>
                <p class="text-muted-foreground max-w-md mx-auto">@currentStepData?.Description</p>
                <div class="mt-8 p-8 border border-dashed border-border rounded-lg">
                    <p class="text-sm text-muted-foreground">Step @_currentStep content goes here</p>
                </div>
            </div>

            @* Navigation *@
            <div class="flex items-center justify-between pt-4 border-t">
                <ButtonCn Disabled="@(_currentStep == 1)" @onclick="@(() => { if (_currentStep > 1) _currentStep--; })" Variant="ButtonVariant.Outline">
                    Previous
                </ButtonCn>
                <div class="text-sm text-muted-foreground">
                    Step @_currentStep of @_steps.Length
                </div>
                <ButtonCn @onclick="@(() => { if (_currentStep < _steps.Length) _currentStep++; })">
                    @(_currentStep == _steps.Length ? "Complete" : "Next")
                </ButtonCn>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private record StepInfo(int Id, string Title, string Description);

    private static readonly StepInfo[] _steps =
    [
        new(1, "Create account", "Set up your account with your email and password to get started."),
        new(2, "Company details", "Tell us about your company so we can personalize your experience."),
        new(3, "Invite team", "Add team members to collaborate on projects together."),
        new(4, "Connect tools", "Link your existing tools to streamline your workflow."),
        new(5, "Get started", "You're all set! Start exploring and building amazing things."),
    ];

    private int _currentStep = 2;
}
