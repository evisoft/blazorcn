@* ========================================
   Block: onboarding-mobile-app-download
   Title: Onboarding Mobile App Download
   Description: Mobile app download with QR code, app store badges, and SMS link option for cross-platform adoption
   Long Description: Minimal floating widget with collapsible task list and compact progress indicator for unobtrusive setup
   Dependencies: LucideCheckCircle2Cn, LucideLoader2Cn, LucideMessageSquareCn, LucideQrCodeCn, LucideSmartphoneCn
   Source: original/blocks/onboarding/onboarding-mobile-app-download.tsx
   ======================================== *@
<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-sm">
        <CardHeaderCn Class="text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
                <LucideSmartphoneCn Size="24" Class="text-primary" />
            </div>
            <CardTitleCn>Get the mobile app</CardTitleCn>
            <CardDescriptionCn>Access your workspace on the go</CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn Class="space-y-6">
            <TabsCn Class="w-full" DefaultValue="qr">
                <TabsListCn Class="grid w-full grid-cols-2">
                    <TabsTriggerCn Class="gap-2" Value="qr">
                        <LucideQrCodeCn Size="16" />
                        QR Code
                    </TabsTriggerCn>
                    <TabsTriggerCn Class="gap-2" Value="sms">
                        <LucideMessageSquareCn Size="16" />
                        SMS
                    </TabsTriggerCn>
                </TabsListCn>

                <TabsContentCn Class="mt-4" Value="qr">
                    <div class="flex flex-col items-center space-y-4">
                        @* QR Code placeholder *@
                        <div class="flex h-40 w-40 items-center justify-center rounded-lg border-2 border-dashed bg-muted/50">
                            <div class="grid grid-cols-5 gap-1 p-4">
                                @for (var i = 0; i < 25; i++)
                                {
                                    <div class="@(Cn.Merge("h-4 w-4 rounded-sm", i % 2 == 0 ? "bg-foreground" : "bg-transparent"))"></div>
                                }
                            </div>
                        </div>
                        <p class="text-sm text-muted-foreground text-center">
                            Scan with your phone camera to download
                        </p>
                    </div>
                </TabsContentCn>

                <TabsContentCn Class="mt-4 space-y-4" Value="sms">
                    @if (_linkSent)
                    {
                        <div class="flex flex-col items-center py-4 text-center">
                            <LucideCircleCheckBigCn Size="32" Class="text-primary" />
                            <p class="mt-3 font-medium text-foreground">Link sent!</p>
                            <p class="text-sm text-muted-foreground mt-1">
                                Check your phone for the download link
                            </p>
                            <ButtonCn
                                Class="mt-3"
                                Size="ButtonSize.Sm"
                                Variant="ButtonVariant.Ghost"
                                @onclick="@(() => _linkSent = false)">
                                Send to another number
                            </ButtonCn>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2">
                            <InputCn
                                Placeholder="+1 (555) 000-0000"
                                type="tel"
                                Value="@_phoneNumber"
                                ValueChanged="@((string v) => _phoneNumber = v)" />
                            <p class="text-xs text-muted-foreground">
                                We'll send a link to download the app
                            </p>
                        </div>
                        <ButtonCn
                            Class="w-full"
                            Disabled="@(string.IsNullOrEmpty(_phoneNumber) || _sendingLink)"
                            @onclick="HandleSendLink">
                            @if (_sendingLink)
                            {
                                <LucideLoaderCircleCn Size="16" Class="mr-2 animate-spin" />
                                <span>Sending...</span>
                            }
                            else
                            {
                                <span>Send download link</span>
                            }
                        </ButtonCn>
                    }
                </TabsContentCn>
            </TabsCn>

            @* App store badges *@
            <div class="space-y-3">
                <p class="text-xs text-muted-foreground text-center">Or download directly</p>
                <div class="flex items-center justify-center gap-3">
                    <button
                        type="button"
                        class="flex h-10 items-center gap-2 rounded-lg border px-4 hover:bg-muted/50 transition-colors">
                        <svg aria-label="Apple App Store" class="h-5 w-5" fill="currentColor" role="img" viewBox="0 0 24 24">
                            <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.08zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
                        </svg>
                        <span class="text-sm font-medium">App Store</span>
                    </button>
                    <button
                        type="button"
                        class="flex h-10 items-center gap-2 rounded-lg border px-4 hover:bg-muted/50 transition-colors">
                        <svg aria-label="Google Play Store" class="h-5 w-5" fill="currentColor" role="img" viewBox="0 0 24 24">
                            <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z" />
                        </svg>
                        <span class="text-sm font-medium">Play Store</span>
                    </button>
                </div>
            </div>

            @* Skip *@
            <div class="text-center pt-4 border-t">
                <button type="button" class="text-sm text-muted-foreground hover:text-foreground">
                    I'll do this later
                </button>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private string _phoneNumber = "";
    private bool _sendingLink;
    private bool _linkSent;

    private async Task HandleSendLink()
    {
        _sendingLink = true;
        StateHasChanged();
        await Task.Delay(1500);
        _sendingLink = false;
        _linkSent = true;
    }
}
