@* ============================================================
   Block: onboarding-skill-assessment
   Title: OnboardingSkillAssessment
   Description: Skill level self-assessment onboarding with three experience levels, selectable rows, personalized message, and continue action built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-skill-assessment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="graduation-cap" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">How experienced are you?</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Tell us your experience level so we can personalize the interface, tutorials, and
                feature recommendations for you.
            </p>
        </div>

        @* Level Options *@
        <div>
            @foreach (var level in _levels)
            {
                var lv = level;
                var isSelected = _selected == lv.Id;
                var isLast = lv.Id == _levels[_levels.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _selected = lv.Id)"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isSelected ? "bg-muted/30" : "")">
                        <span class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full font-medium text-xs", isSelected ? "bg-foreground text-background ring-2 ring-foreground ring-offset-2 ring-offset-card" : "bg-muted/50 text-muted-foreground")">
                            @lv.Name[0]
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@lv.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@lv.Description</p>
                        </div>
                    </button>
                </div>
            }
        </div>

        @* Personalized message *@
        @if (_selectedLevel is not null)
        {
            <div class="border-t px-4 py-3">
                <div class="rounded-md bg-muted/50 p-3">
                    <p class="text-sm leading-relaxed">@_selectedLevel.PersonalizedMessage</p>
                </div>
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-end border-t px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" Disabled="@(_selected is null)">
                Continue
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record SkillLevel(string Id, string Name, string Description, string PersonalizedMessage);

    private string? _selected = null;

    private SkillLevel? _selectedLevel => Array.Find(_levels, l => l.Id == _selected);

    private static readonly SkillLevel[] _levels =
    [
        new(
            "beginner",
            "Beginner",
            "New to the platform or just getting started with similar tools",
            "We will walk you through everything step by step with guided tutorials, tooltips, and a simplified interface. You will be productive in no time."
        ),
        new(
            "intermediate",
            "Intermediate",
            "Comfortable with the basics and ready to explore advanced features",
            "We will skip the basics and highlight powerful features like keyboard shortcuts, bulk actions, and integrations to accelerate your workflow."
        ),
        new(
            "advanced",
            "Advanced",
            "Experienced power user looking for full control and customization",
            "We will give you the full toolkit from day one — API access, custom workflows, advanced settings, and developer documentation upfront."
        ),
    ];
}
