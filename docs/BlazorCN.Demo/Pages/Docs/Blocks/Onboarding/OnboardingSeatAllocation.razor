@* ============================================================
   Block: onboarding-seat-allocation
   Title: OnboardingSeatAllocation
   Description: Team seat allocation onboarding with NumberFlow animated counter, department increment/decrement controls, and confirm action built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-seat-allocation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Allocate your seats</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Distribute seats across departments in your workspace.
            </p>
        </div>

        @* Seat counter *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="text-2xl font-semibold tabular-nums">@_allocated</span>
                <span class="text-muted-foreground text-xs">of @TotalSeats used</span>
            </div>
            <div class="ml-auto">
                <span class="text-muted-foreground text-xs tabular-nums">
                    <span class="inline font-medium tabular-nums">@_remaining</span>
                    remaining
                </span>
            </div>
        </div>

        @* Department rows *@
        <div>
            @for (int i = 0; i < _departments.Count; i++)
            {
                var dept = _departments[i];
                var isLast = i == _departments.Count - 1;
                var deptId = dept.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@dept.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @dept.Seats @(dept.Seats == 1 ? "member" : "members")
                            </p>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <ButtonCn
                                Variant="ButtonVariant.Outline"
                                Size="ButtonSize.Sm"
                                Class="size-7 p-0"
                                @onclick="@(() => UpdateSeats(deptId, -1))"
                                Disabled="@(dept.Seats <= 0)"
                                aria-label="@($"Remove seat from {dept.Name}")">
                                <LucideIconCn Name="minus" Size="12" Class="size-3" />
                            </ButtonCn>
                            <span class="w-6 text-center font-mono text-sm tabular-nums">@dept.Seats</span>
                            <ButtonCn
                                Variant="ButtonVariant.Outline"
                                Size="ButtonSize.Sm"
                                Class="size-7 p-0"
                                @onclick="@(() => UpdateSeats(deptId, 1))"
                                Disabled="@(_remaining <= 0)"
                                aria-label="@($"Add seat to {dept.Name}")">
                                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs tabular-nums">@_allocated seats allocated</span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Confirm Allocation
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private const int TotalSeats = 10;

    private record Department(string Id, string Name, int Seats)
    {
        public Department WithSeats(int seats) => this with { Seats = seats };
    }

    private List<Department> _departments =
    [
        new("eng", "Engineering", 3),
        new("design", "Design", 1),
        new("marketing", "Marketing", 1),
    ];

    private int _allocated => _departments.Sum(d => d.Seats);
    private int _remaining => TotalSeats - _allocated;

    private void UpdateSeats(string id, int delta)
    {
        for (int i = 0; i < _departments.Count; i++)
        {
            var dept = _departments[i];
            if (dept.Id != id) continue;
            var next = dept.Seats + delta;
            if (next < 0 || _allocated + delta > TotalSeats) return;
            _departments[i] = dept.WithSeats(next);
            return;
        }
    }
}
