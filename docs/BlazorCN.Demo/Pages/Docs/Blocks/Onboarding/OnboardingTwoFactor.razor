@* ============================================================
   Block: onboarding-two-factor
   Title: OnboardingTwoFactor
   Description: A two-factor authentication setup component for React and Next.js with QR code placeholder, six-digit OTP input, backup codes display, and verification state transition built with shadcn/ui and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-two-factor.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Two-factor authentication</span>
        </div>

        @if (!_verified)
        {
            @* Setup panel *@
            <div>
                @* Description *@
                <div class="border-b px-4 py-4">
                    <p class="text-muted-foreground text-sm">
                        Scan the QR code with your authenticator app, then enter the 6-digit
                        verification code below.
                    </p>
                </div>

                @* QR code placeholder *@
                <div class="flex justify-center border-b px-4 py-6">
                    <div class="flex size-40 flex-col items-center justify-center rounded-md border-2 border-dashed">
                        <LucideIconCn Name="qr-code" Size="40" Class="size-10 text-muted-foreground/40" />
                        <span class="mt-2 text-muted-foreground text-xs">Scan with app</span>
                    </div>
                </div>

                @* OTP input *@
                <div class="flex flex-col items-center gap-3 border-b px-4 py-4">
                    <span class="font-medium text-muted-foreground text-xs">Verification code</span>
                    <div class="flex items-center gap-2">
                        @* Group 1: slots 0-2 *@
                        <div class="flex">
                            @for (int i = 0; i < 3; i++)
                            {
                                var idx = i;
                                <input
                                    id="@($"otp-{idx}")"
                                    type="text"
                                    aria-label="@($"Digit {idx + 1}")"
                                    inputmode="numeric"
                                    maxlength="1"
                                    value="@(_otpDigits[idx])"
                                    @oninput="@((ChangeEventArgs e) => HandleOtpInput(idx, e.Value?.ToString() ?? ""))"
                                    class="@(Cn.Merge("h-10 w-10 rounded-md border border-input bg-background text-center text-sm font-medium shadow-sm focus:outline-none focus:ring-1 focus:ring-ring", idx > 0 ? "-ml-px" : ""))" />
                            }
                        </div>

                        @* Separator *@
                        <div class="text-muted-foreground">-</div>

                        @* Group 2: slots 3-5 *@
                        <div class="flex">
                            @for (int i = 3; i < 6; i++)
                            {
                                var idx = i;
                                <input
                                    id="@($"otp-{idx}")"
                                    type="text"
                                    aria-label="@($"Digit {idx + 1}")"
                                    inputmode="numeric"
                                    maxlength="1"
                                    value="@(_otpDigits[idx])"
                                    @oninput="@((ChangeEventArgs e) => HandleOtpInput(idx, e.Value?.ToString() ?? ""))"
                                    class="@(Cn.Merge("h-10 w-10 rounded-md border border-input bg-background text-center text-sm font-medium shadow-sm focus:outline-none focus:ring-1 focus:ring-ring", idx > 3 ? "-ml-px" : ""))" />
                            }
                        </div>
                    </div>
                </div>

                @* Footer *@
                <div class="px-4 py-3">
                    <div class="flex items-center justify-between">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                            Skip for now
                        </ButtonCn>
                        <ButtonCn
                            Size="ButtonSize.Sm"
                            Class="h-7 text-xs"
                            Disabled="@(_code.Length < 6)"
                            @onclick="HandleEnable">
                            Enable 2FA
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }
        else
        {
            @* Verified panel *@
            <div>
                @* Success message *@
                <div class="flex flex-col items-center gap-2 border-b px-4 py-6">
                    <LucideIconCn Name="check-circle-2" Size="32" Class="size-8 text-emerald-500" />
                    <span class="font-medium text-sm">Two-factor authentication enabled</span>
                    <p class="text-center text-muted-foreground text-xs">
                        Your account is now protected with an additional layer of security.
                    </p>
                </div>

                @* Backup codes *@
                <div class="border-b px-4 py-4">
                    <div class="mb-2 flex items-center gap-2">
                        <span class="font-medium text-muted-foreground text-xs">Backup codes</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            Save these
                        </BadgeCn>
                    </div>
                    <div class="grid grid-cols-2 gap-2 rounded-md bg-zinc-950 p-3">
                        @foreach (var bc in _backupCodes)
                        {
                            <span class="font-mono text-white text-xs">@bc</span>
                        }
                    </div>
                    <p class="mt-2 text-muted-foreground text-xs">
                        Store these codes in a safe place. Each code can only be used once.
                    </p>
                </div>

                @* Footer *@
                <div class="px-4 py-3">
                    <div class="flex items-center justify-end">
                        <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                            Continue
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private static readonly string[] _backupCodes = ["X4K9-M2P7", "B8N3-Q5W1", "C6J2-R9Y4", "D1V8-S3T6"];

    private string[] _otpDigits = ["", "", "", "", "", ""];
    private bool _verified;

    private string _code => string.Concat(_otpDigits);

    private void HandleOtpInput(int index, string value)
    {
        // Accept only a single digit
        var digit = value.Length > 0 ? value[^1].ToString() : "";
        if (digit.Length == 1 && !char.IsDigit(digit[0]))
            digit = "";
        _otpDigits[index] = digit;
    }

    private void HandleEnable()
    {
        if (_code.Length == 6)
            _verified = true;
    }
}
