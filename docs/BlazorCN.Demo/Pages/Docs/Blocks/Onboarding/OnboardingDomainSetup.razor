@* ============================================================
   Block: onboarding-domain-setup
   Title: OnboardingDomainSetup
   Description: A React custom domain onboarding block for Next.js with DNS verification, live URL preview, and status indicators. Built with TypeScript, shadcn/ui Button and Input, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-domain-setup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Custom Domain</span>
        </div>

        @* Domain input *@
        <div class="border-b px-4 py-3">
            <label for="domain-input" class="mb-1.5 block font-medium text-muted-foreground text-xs">
                Domain name
            </label>
            <InputCn Id="domain-input"
                     Placeholder="app.example.com"
                     @bind-Value="_domain"
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
        </div>

        @* Live preview *@
        <div class="border-b px-4 py-3">
            <span class="mb-1 block font-medium text-muted-foreground text-xs">Preview</span>
            <p class="truncate font-mono text-sm">@_displayUrl</p>
        </div>

        @* DNS records *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                DNS Verification
            </span>
            <div class="space-y-0">
                @foreach (var rec in _dnsRecords)
                {
                    var isLast = rec.Id == _dnsRecords[_dnsRecords.Length - 1].Id;
                    <div class="@Cn.Merge("flex items-center gap-3 py-2", isLast ? "" : "border-b")">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _statusDot[rec.Status])"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-xs">@rec.Type</span>
                                <span class="text-muted-foreground text-xs">@rec.Name</span>
                            </div>
                            <p class="mt-0.5 truncate font-mono text-muted-foreground text-xs">
                                @rec.Value
                            </p>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs capitalize">
                            @rec.Status
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">
                Skip
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(string.IsNullOrWhiteSpace(_domain))">
                Verify Domain
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private string _domain = "";

    private string _displayUrl => string.IsNullOrWhiteSpace(_domain)
        ? "https://your-domain.com"
        : $"https://{System.Text.RegularExpressions.Regex.Replace(_domain.Trim(), @"^https?://", "")}";

    private record DnsRecord(string Id, string Type, string Name, string Value, string Status);

    private static readonly DnsRecord[] _dnsRecords =
    [
        new("a",    "A",     "@@", "76.76.21.21",             "pending"),
        new("cname","CNAME", "www","cname.acme-hosting.com",  "pending"),
        new("txt",  "TXT",   "@@", "acme-verify=a1b2c3d4e5",  "pending"),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["pending"]  = "bg-amber-500",
        ["verified"] = "bg-emerald-500",
    };
}
