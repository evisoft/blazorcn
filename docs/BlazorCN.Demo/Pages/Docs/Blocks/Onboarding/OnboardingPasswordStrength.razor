@* ============================================================
   Block: onboarding-password-strength
   Title: OnboardingPasswordStrength
   Description: React and Next.js password creation onboarding block with TypeScript, animated strength meter, real-time requirement checks, shadcn/ui inputs, and Tailwind CSS for secure credential setup.
   Source: original/blocks/onboarding/onboarding-password-strength.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="lock" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Create password</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Choose a strong password to protect your account. Make sure it meets all the
                requirements below.
            </p>
        </div>

        @* Password input *@
        <div class="border-b px-4 py-4">
            <div class="space-y-3">
                <div>
                    <label
                        for="new-password"
                        class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        Password
                    </label>
                    <InputCn
                        id="new-password"
                        type="password"
                        Placeholder="Enter your password"
                        Class="h-8 text-sm"
                        Value="@_password"
                        ValueChanged="@((string v) => _password = v)" />
                </div>
                <div>
                    <label
                        for="confirm-password"
                        class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        Confirm password
                    </label>
                    <InputCn
                        id="confirm-password"
                        type="password"
                        Placeholder="Re-enter your password"
                        Class="h-8 text-sm"
                        Value="@_confirm"
                        ValueChanged="@((string v) => _confirm = v)" />
                    @if (_confirm.Length > 0 && !PasswordsMatch)
                    {
                        <p class="mt-1 text-red-500 text-xs">Passwords do not match</p>
                    }
                </div>
            </div>
        </div>

        @* Strength meter *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Strength</span>
                @if (_password.Length > 0)
                {
                    <span class="@Cn.Merge("font-medium text-xs", StrengthColor)">@StrengthLabel</span>
                }
            </div>
            <div class="flex gap-1.5">
                @foreach (var lvl in _levels)
                {
                    <div class="@Cn.Merge("h-1.5 flex-1 rounded-full", (_password.Length > 0 && lvl <= StrengthLevel) ? StrengthBarColor : "bg-muted")"></div>
                }
            </div>
        </div>

        @* Requirements *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2">
                @foreach (var req in Requirements)
                {
                    <div class="flex items-center gap-2">
                        @if (req.Met)
                        {
                            <LucideIconCn Name="check" Size="14" Class="size-3.5 shrink-0 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="x" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/40" />
                        }
                        <span class="@(req.Met ? "text-xs text-foreground" : "text-xs text-muted-foreground")">
                            @req.Label
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" Disabled="@(!AllMet || !PasswordsMatch)">
                    Set Password
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Requirement(string Label, bool Met);

    private static readonly int[] _levels = [1, 2, 3, 4];

    private string _password = "";
    private string _confirm = "";

    private Requirement[] Requirements =>
    [
        new("At least 8 characters", _password.Length >= 8),
        new("One uppercase letter", _password.Any(char.IsUpper)),
        new("One number", _password.Any(char.IsDigit)),
        new("One special character", _password.Any(c => "!@#$%^&*(),.?\":{}|<>".Contains(c))),
    ];

    private int MetCount => Requirements.Count(r => r.Met);

    private bool AllMet => Requirements.All(r => r.Met);

    private bool PasswordsMatch => _password.Length > 0 && _password == _confirm;

    private int StrengthLevel => MetCount switch
    {
        <= 1 => 1,
        2 => 2,
        3 => 3,
        _ => 4,
    };

    private string StrengthLabel => MetCount switch
    {
        <= 1 => "Weak",
        2 => "Fair",
        3 => "Good",
        _ => "Strong",
    };

    private string StrengthColor => MetCount switch
    {
        <= 1 => "text-red-500",
        2 => "text-amber-500",
        3 => "text-amber-500",
        _ => "text-emerald-500",
    };

    private string StrengthBarColor => MetCount switch
    {
        <= 1 => "bg-red-500",
        2 => "bg-amber-500",
        3 => "bg-amber-500",
        _ => "bg-emerald-500",
    };
}
