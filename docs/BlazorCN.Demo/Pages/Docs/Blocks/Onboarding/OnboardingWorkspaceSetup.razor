@* ========================================
   Block: onboarding-workspace-setup
   Title: Onboarding Workspace Setup
   Description: Workspace creation form with name input, URL slug, icon selector, and visibility options
   Long Description: Welcome modal with feature highlights, benefits list, and get started CTA for first-time users
   Dependencies: LucideBuilding2Cn, LucideGlobeCn, LucideLockCn, LucideUsersCn
   Source: original/blocks/onboarding/onboarding-workspace-setup.tsx
   ======================================== *@

<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-md">
        <CardHeaderCn>
            <CardTitleCn>Create your workspace</CardTitleCn>
            <CardDescriptionCn>Set up a workspace to organize your projects and team</CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn Class="space-y-6">
            @* Icon and name *@
            <div class="flex gap-4">
                <div class="@Cn.Merge("flex h-16 w-16 shrink-0 items-center justify-center rounded-xl text-white", _iconColors.FirstOrDefault(c => c.Id == _selectedColor)?.Color ?? "bg-blue-500")">
                    <LucideBuilding2Cn Class="h-8 w-8" Size="32" />
                </div>
                <div class="flex-1 space-y-2">
                    <LabelCn For="name">Workspace name</LabelCn>
                    <InputCn Id="name" Placeholder="Acme Inc"
                             Value="@_name" ValueChanged="@((string v) => { _name = v; if (!_slugEdited) _slug = Slugify(v); })" />
                </div>
            </div>

            @* Color picker *@
            <div class="space-y-2">
                <LabelCn>Icon color</LabelCn>
                <div class="flex gap-2">
                    @foreach (var color in _iconColors)
                    {
                        <button type="button"
                                aria-label="@($"Select {color.Id} color")"
                                class="@Cn.Merge("h-8 w-8 rounded-full transition-all", color.Color, _selectedColor == color.Id ? "ring-2 ring-offset-2 ring-primary" : "hover:scale-110")"
                                @onclick="@(() => _selectedColor = color.Id)"></button>
                    }
                </div>
            </div>

            @* URL slug *@
            <div class="space-y-2">
                <LabelCn For="slug">Workspace URL</LabelCn>
                <div class="flex">
                    <span class="inline-flex items-center px-3 rounded-l-md border border-r-0 bg-muted text-muted-foreground text-sm">
                        app.acme.com/
                    </span>
                    <InputCn Class="rounded-l-none" Id="slug" Placeholder="my-workspace"
                             Value="@_slug" ValueChanged="@((string v) => { _slug = Slugify(v); _slugEdited = true; })" />
                </div>
                <p class="text-xs text-muted-foreground">This will be your workspace's unique URL</p>
            </div>

            @* Visibility *@
            <div class="space-y-3">
                <LabelCn>Visibility</LabelCn>
                <RadioGroupCn Value="@_visibility" ValueChanged="@(v => _visibility = v ?? "private")">
                    <div class="flex items-start gap-3 p-3 rounded-lg border hover:bg-muted/50 cursor-pointer">
                        <RadioGroupItemCn Class="mt-0.5" Id="private" Value="private" />
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <LucideLockCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                <LabelCn Class="cursor-pointer font-medium" For="private">Private</LabelCn>
                            </div>
                            <p class="text-xs text-muted-foreground mt-0.5">Only invited members can access</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-3 rounded-lg border hover:bg-muted/50 cursor-pointer">
                        <RadioGroupItemCn Class="mt-0.5" Id="team" Value="team" />
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <LucideUsersCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                <LabelCn Class="cursor-pointer font-medium" For="team">Team</LabelCn>
                            </div>
                            <p class="text-xs text-muted-foreground mt-0.5">All organization members can access</p>
                        </div>
                    </div>
                    <div class="flex items-start gap-3 p-3 rounded-lg border hover:bg-muted/50 cursor-pointer">
                        <RadioGroupItemCn Class="mt-0.5" Id="public" Value="public" />
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <LucideGlobeCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                                <LabelCn Class="cursor-pointer font-medium" For="public">Public</LabelCn>
                            </div>
                            <p class="text-xs text-muted-foreground mt-0.5">Anyone with the link can view</p>
                        </div>
                    </div>
                </RadioGroupCn>
            </div>

            <ButtonCn Class="w-full" Disabled="@(string.IsNullOrEmpty(_name) || string.IsNullOrEmpty(_slug))">
                Create workspace
            </ButtonCn>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private record IconColor(string Id, string Color);

    private static readonly IconColor[] _iconColors =
    [
        new("blue", "bg-blue-500"),
        new("emerald", "bg-emerald-500"),
        new("purple", "bg-purple-500"),
        new("amber", "bg-amber-500"),
        new("rose", "bg-rose-500"),
        new("cyan", "bg-cyan-500"),
    ];

    private string _name = "";
    private string _slug = "";
    private bool _slugEdited;
    private string _selectedColor = "blue";
    private string _visibility = "private";

    private static string Slugify(string text) =>
        System.Text.RegularExpressions.Regex.Replace(
            System.Text.RegularExpressions.Regex.Replace(text.ToLowerInvariant(), "[^a-z0-9]+", "-"),
            "(^-|-$)", "");
}
