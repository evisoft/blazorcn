@* ============================================================
   Block: onboarding-workflow-builder
   Title: OnboardingWorkflowBuilder
   Description: A React and Next.js workflow builder onboarding block with connected vertical steps, trigger/condition/action flow, expandable step rows, and activation button built with TypeScript, shadcn/ui, and Tailwind CSS for automation setup.
   Source: original/blocks/onboarding/onboarding-workflow-builder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="workflow" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Set Up Your First Workflow</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Automate repetitive tasks with a simple trigger, condition, and action
            </p>
        </div>

        @* Workflow steps *@
        <div class="px-4 py-3">
            @foreach (var step in _steps)
            {
                var isExpanded = _expanded == step.Id;
                var isLast = step.Id == _steps[_steps.Length - 1].Id;
                <div>
                    <div class="flex gap-3">
                        @* Connecting line + dot *@
                        <div class="flex flex-col items-center">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                                <LucideIconCn Name="@step.Icon" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                            @if (!isLast)
                            {
                                <div class="my-1 h-full w-px bg-border" aria-hidden="true"></div>
                            }
                        </div>

                        @* Step content *@
                        <div class="@Cn.Merge("min-w-0 flex-1", !isLast ? "pb-3" : "")">
                            @{
                                var capturedStep = step;
                            }
                            <button type="button"
                                    @onclick="@(() => ToggleExpanded(capturedStep.Id))"
                                    class="-ml-1 flex w-full items-center gap-2 rounded-md px-1 py-0.5 text-left transition-colors hover:bg-muted/50">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">@step.Type</BadgeCn>
                                <span class="flex-1 truncate font-medium text-sm">@step.Title</span>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                            </button>
                            @if (isExpanded)
                            {
                                <p class="mt-1.5 pl-1 text-muted-foreground text-xs leading-relaxed">
                                    @step.Description
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">3 steps configured</span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Activate Workflow</ButtonCn>
        </div>

    </div>
</section>

@code {
    private string? _expanded = "trigger";

    private record WorkflowStep(string Id, string Type, string Title, string Description, string Icon);

    private static readonly WorkflowStep[] _steps =
    [
        new("trigger",   "Trigger",   "New form submission",  "Fires when a visitor submits any form on your site",      "zap"),
        new("condition", "Condition", "If priority is high",  "Checks the priority field value before continuing",       "filter"),
        new("action",    "Action",    "Send notification",    "Sends an alert to the assigned team channel",             "bell"),
    ];

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
