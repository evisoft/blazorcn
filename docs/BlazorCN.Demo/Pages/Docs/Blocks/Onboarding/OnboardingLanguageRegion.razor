@* ========================================
   Block: onboarding-language-region
   Title: Onboarding Language Region
   Description: Language and region settings with locale selector, timezone picker, date format, and currency options
   Long Description: React Onboarding Keyboard Shortcuts
   Dependencies: LucideClockCn, LucideDollarSignCn, LucideGlobeCn, LucideLanguagesCn
   Source: original/blocks/onboarding/onboarding-language-region.tsx
   ======================================== *@

<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-md">
        <CardHeaderCn Class="text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
                <LucideGlobeCn Class="h-6 w-6 text-primary" Size="24" />
            </div>
            <CardTitleCn>Set your preferences</CardTitleCn>
            <CardDescriptionCn>We'll personalize your experience based on your location</CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn Class="space-y-6">
            @* Language *@
            <div class="space-y-2">
                <LabelCn Class="flex items-center gap-2">
                    <LucideLanguagesCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    Language
                </LabelCn>
                <SelectCn Value="@_language" ValueChanged="@((string v) => _language = v)">
                    <SelectTriggerCn aria-label="Language">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var lang in _languages)
                        {
                            <SelectItemCn Value="@lang.Code">@lang.Name</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>

            @* Timezone *@
            <div class="space-y-2">
                <LabelCn Class="flex items-center gap-2">
                    <LucideClockCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    Timezone
                </LabelCn>
                <SelectCn Value="@_timezone" ValueChanged="@((string v) => _timezone = v)">
                    <SelectTriggerCn aria-label="Timezone">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var tz in _timezones)
                        {
                            <SelectItemCn Value="@tz.Value">@tz.Label</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
                <p class="text-xs text-muted-foreground">Detected from your browser. Change if incorrect.</p>
            </div>

            @* Date format *@
            <div class="space-y-3">
                <LabelCn>Date format</LabelCn>
                <RadioGroupCn Class="flex gap-4" Value="@_dateFormat" ValueChanged="@(v => _dateFormat = v ?? "mdy")">
                    <div class="flex items-center space-x-2">
                        <RadioGroupItemCn Id="mdy" Value="mdy" />
                        <LabelCn Class="font-normal cursor-pointer" For="mdy">MM/DD/YYYY</LabelCn>
                    </div>
                    <div class="flex items-center space-x-2">
                        <RadioGroupItemCn Id="dmy" Value="dmy" />
                        <LabelCn Class="font-normal cursor-pointer" For="dmy">DD/MM/YYYY</LabelCn>
                    </div>
                    <div class="flex items-center space-x-2">
                        <RadioGroupItemCn Id="ymd" Value="ymd" />
                        <LabelCn Class="font-normal cursor-pointer" For="ymd">YYYY-MM-DD</LabelCn>
                    </div>
                </RadioGroupCn>
            </div>

            @* Currency *@
            <div class="space-y-2">
                <LabelCn Class="flex items-center gap-2">
                    <LucideDollarSignCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                    Currency
                </LabelCn>
                <SelectCn Value="@_currency" ValueChanged="@((string v) => _currency = v)">
                    <SelectTriggerCn aria-label="Currency">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var curr in _currencies)
                        {
                            <SelectItemCn Value="@curr.Code">@curr.Symbol @curr.Name (@curr.Code)</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>

            @* Preview *@
            <div class="p-3 rounded-lg bg-muted/50 space-y-1">
                <p class="text-xs text-muted-foreground">Preview</p>
                <p class="text-sm text-foreground">
                    @(_dateFormat == "mdy" ? "12/07/2025" : _dateFormat == "dmy" ? "07/12/2025" : "2025-12-07")
                    &bull; @(_currencies.FirstOrDefault(c => c.Code == _currency)?.Symbol)1,234.56
                </p>
            </div>

            @* Actions *@
            <div class="flex items-center justify-between pt-4 border-t">
                <ButtonCn Variant="ButtonVariant.Ghost">Use defaults</ButtonCn>
                <ButtonCn>Save &amp; continue</ButtonCn>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private record Language(string Code, string Name);
    private record Timezone(string Value, string Label);
    private record Currency(string Code, string Symbol, string Name);

    private static readonly Language[] _languages =
    [
        new("en", "English"),
        new("es", "Espanol"),
        new("fr", "Francais"),
        new("de", "Deutsch"),
    ];

    private static readonly Timezone[] _timezones =
    [
        new("America/New_York", "Eastern Time (ET)"),
        new("America/Chicago", "Central Time (CT)"),
        new("America/Denver", "Mountain Time (MT)"),
        new("America/Los_Angeles", "Pacific Time (PT)"),
        new("Europe/London", "Greenwich Mean Time (GMT)"),
        new("Europe/Paris", "Central European Time (CET)"),
        new("Asia/Tokyo", "Japan Standard Time (JST)"),
    ];

    private static readonly Currency[] _currencies =
    [
        new("USD", "$", "US Dollar"),
        new("EUR", "\u20ac", "Euro"),
        new("GBP", "\u00a3", "British Pound"),
        new("JPY", "\u00a5", "Japanese Yen"),
    ];

    private string _language = "en";
    private string _timezone = "America/New_York";
    private string _dateFormat = "mdy";
    private string _currency = "USD";
}
