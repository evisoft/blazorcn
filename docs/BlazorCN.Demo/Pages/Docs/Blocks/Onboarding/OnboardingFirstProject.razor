@* ========================================
   Block: onboarding-first-project
   Title: Onboarding First Project
   Description: First project creation with name input, settings toggles, and step-by-step creation progress
   Long Description: React Onboarding Feedback Survey
   Dependencies: LucideCheckCircle2Cn, LucideGlobeCn, LucideLoader2Cn, LucideLockCn, LucideRocketCn, LucideSettingsCn, LucideSparklesCn
   Source: original/blocks/onboarding/onboarding-first-project.tsx
   ======================================== *@

<div class="flex items-center justify-center p-10 w-full">
    @if (_created)
    {
        <CardCn Class="w-full max-w-sm">
            <CardContentCn Class="pt-6 text-center">
                <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary/10">
                    <LucideRocketCn Class="h-8 w-8 text-primary" Size="32" />
                </div>
                <h3 class="text-xl font-semibold text-foreground mb-2">Project created!</h3>
                <p class="text-sm text-muted-foreground mb-6">
                    <span class="font-medium text-foreground">@_projectName</span> is ready. Let's start building.
                </p>
                <div class="space-y-2">
                    <ButtonCn Class="w-full">
                        <LucideSparklesCn Class="mr-2 h-4 w-4" Size="16" />
                        Open project
                    </ButtonCn>
                    <ButtonCn Class="w-full" Variant="ButtonVariant.Outline">Create another project</ButtonCn>
                </div>
            </CardContentCn>
        </CardCn>
    }
    else if (_creating)
    {
        <CardCn Class="w-full max-w-sm">
            <CardContentCn Class="py-8">
                <div class="text-center mb-6">
                    <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
                        <LucideLoader2Cn Class="h-6 w-6 text-primary animate-spin" Size="24" />
                    </div>
                    <h3 class="text-lg font-semibold text-foreground">Creating @_projectName</h3>
                </div>
                <div class="space-y-3">
                    @for (var i = 0; i < _creationSteps.Length; i++)
                    {
                        var step = _creationSteps[i];
                        var index = i;
                        var isComplete = index < _currentStep;
                        var isCurrent = index == _currentStep;
                        <div class="@Cn.Merge("flex items-center gap-3 p-3 rounded-lg transition-colors", isCurrent ? "bg-muted" : "")">
                            <div class="@Cn.Merge("flex h-6 w-6 items-center justify-center rounded-full transition-colors", isComplete ? "bg-primary text-primary-foreground" : isCurrent ? "bg-primary/20 text-primary" : "bg-muted text-muted-foreground")">
                                @if (isComplete)
                                {
                                    <LucideCircleCheckCn Class="h-4 w-4" Size="16" />
                                }
                                else if (isCurrent)
                                {
                                    <LucideLoader2Cn Class="h-3 w-3 animate-spin" Size="12" />
                                }
                                else
                                {
                                    <span class="text-xs">@(index + 1)</span>
                                }
                            </div>
                            <span class="@Cn.Merge("text-sm", isComplete || isCurrent ? "text-foreground" : "text-muted-foreground")">
                                @step.Label
                            </span>
                        </div>
                    }
                </div>
            </CardContentCn>
        </CardCn>
    }
    else
    {
        <CardCn Class="w-full max-w-sm">
            <CardHeaderCn Class="text-center">
                <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
                    <LucideFolderPlusCn Class="h-6 w-6 text-primary" Size="24" />
                </div>
                <CardTitleCn>Create your first project</CardTitleCn>
                <CardDescriptionCn>Projects help you organize your work</CardDescriptionCn>
            </CardHeaderCn>
            <CardContentCn Class="space-y-6">
                <div class="space-y-2">
                    <LabelCn For="projectName">Project name</LabelCn>
                    <InputCn Id="projectName" Placeholder="My awesome project"
                             Value="@_projectName" ValueChanged="@((string v) => _projectName = v)" />
                </div>

                <div class="space-y-4">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            @if (_isPrivate)
                            {
                                <LucideLockCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            }
                            else
                            {
                                <LucideGlobeCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            }
                            <div>
                                <LabelCn Class="cursor-pointer">Private project</LabelCn>
                                <p class="text-xs text-muted-foreground">Only you and invited members can access</p>
                            </div>
                        </div>
                        <SwitchCn Checked="@_isPrivate" CheckedChanged="@((bool v) => _isPrivate = v)" />
                    </div>

                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <LucideSettingsCn Class="h-4 w-4 text-muted-foreground" Size="16" />
                            <div>
                                <LabelCn Class="cursor-pointer">Enable analytics</LabelCn>
                                <p class="text-xs text-muted-foreground">Track project performance</p>
                            </div>
                        </div>
                        <SwitchCn Checked="@_enableAnalytics" CheckedChanged="@((bool v) => _enableAnalytics = v)" />
                    </div>
                </div>

                <div class="flex items-center justify-between pt-4 border-t">
                    <ButtonCn Variant="ButtonVariant.Ghost">Skip for now</ButtonCn>
                    <ButtonCn Disabled="@(string.IsNullOrEmpty(_projectName))" @onclick="HandleCreate">
                        Create project
                    </ButtonCn>
                </div>
            </CardContentCn>
        </CardCn>
    }
</div>

@code {
    private record CreationStep(string Id, string Label);

    private static readonly CreationStep[] _creationSteps =
    [
        new("init", "Initializing project"),
        new("config", "Setting up configuration"),
        new("files", "Creating files"),
        new("done", "Ready to go"),
    ];

    private string _projectName = "";
    private bool _isPrivate = true;
    private bool _enableAnalytics = true;
    private bool _creating;
    private int _currentStep;
    private bool _created;

    private async Task HandleCreate()
    {
        if (string.IsNullOrEmpty(_projectName)) return;
        _creating = true;
        StateHasChanged();

        for (var i = 0; i < _creationSteps.Length; i++)
        {
            _currentStep = i;
            StateHasChanged();
            await Task.Delay(800);
        }

        _created = true;
        _creating = false;
    }
}
