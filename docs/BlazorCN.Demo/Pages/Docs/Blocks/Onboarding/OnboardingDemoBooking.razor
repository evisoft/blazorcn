@* ============================================================
   Block: onboarding-demo-booking
   Title: OnboardingDemoBooking
   Description: A React demo booking onboarding block for Next.js with time slot selection, contact form, and skip option. Built with TypeScript, shadcn/ui Input and Button, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-demo-booking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Want a guided walkthrough?</span>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">Book a 15-minute demo with our team</p>
        </div>

        @* Time slots *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Available slots this week</span>
            <div class="mt-2 flex flex-wrap gap-2">
                @foreach (var slot in _timeSlots)
                {
                    var isSelected = _selectedSlot == slot.Id;
                    <button type="button"
                            class="@Cn.Merge("rounded-md border px-3 py-1.5 text-xs font-medium transition-colors hover:bg-muted/50", isSelected ? "border-foreground/20 bg-muted/30 ring-1 ring-foreground/10" : "border-border")"
                            @onclick="@(() => _selectedSlot = slot.Id)"
                            aria-pressed="@isSelected.ToString().ToLowerInvariant()">
                        @slot.Label
                    </button>
                }
            </div>
        </div>

        @* Contact inputs *@
        <div class="space-y-2 border-b px-4 py-3">
            <InputCn @bind-Value="_name" Placeholder="Your name" Class="h-8 text-sm" />
            <InputCn @bind-Value="_email" Placeholder="@("you@company.com")" Type="email" Class="h-8 text-sm" />
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Skip</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(!_canBook)">Book Demo</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record TimeSlot(string Id, string Label);

    private static readonly TimeSlot[] _timeSlots =
    [
        new("mon-10", "Mon 10am"),
        new("tue-2",  "Tue 2pm"),
        new("wed-11", "Wed 11am"),
        new("thu-3",  "Thu 3pm"),
        new("fri-9",  "Fri 9am"),
    ];

    private string? _selectedSlot;
    private string _name = "";
    private string _email = "";

    private bool _canBook => _selectedSlot != null && _name.Trim().Length > 0 && _email.Trim().Length > 0;
}
