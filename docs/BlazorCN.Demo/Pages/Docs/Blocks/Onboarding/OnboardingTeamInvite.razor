@* ========================================
   Block: onboarding-team-invite
   Title: Onboarding Team Invite
   Description: Team invite form with email input, role selector, and pending invites list for collaboration setup
   Long Description: Linear stepper with numbered steps, progress line, and navigation controls for sequential setup flows
   Dependencies: LucideClockCn, LucideLoader2Cn, LucideMailCn, LucideSendCn, LucideXCn
   Source: original/blocks/onboarding/onboarding-team-invite.tsx
   ======================================== *@
<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-lg">
        <CardHeaderCn>
            <CardTitleCn>Invite your team</CardTitleCn>
            <CardDescriptionCn>
                Collaborate with others by inviting them to your workspace
            </CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn Class="space-y-6">
            @* Invite form *@
            <div class="flex gap-2">
                <div class="flex-1">
                    <InputCn
                        Placeholder="@("colleague@company.com")"
                        type="email"
                        Value="@_email"
                        ValueChanged="@((string v) => _email = v)" />
                </div>
                <SelectCn Value="@_role" ValueChanged="@((string v) => _role = v)">
                    <SelectTriggerCn class="w-28">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="admin">Admin</SelectItemCn>
                        <SelectItemCn Value="member">Member</SelectItemCn>
                        <SelectItemCn Value="viewer">Viewer</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
                <ButtonCn Disabled="@(string.IsNullOrEmpty(_email) || _sending)" @onclick="HandleSendInvite">
                    @if (_sending)
                    {
                        <LucideLoader2Cn Size="16" Class="animate-spin" />
                    }
                    else
                    {
                        <LucideSendCn Size="16" />
                    }
                </ButtonCn>
            </div>

            @* Pending invites *@
            @if (_invites.Count > 0)
            {
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <h4 class="text-sm font-medium text-foreground">Team members</h4>
                        @if (PendingCount > 0)
                        {
                            <span class="text-xs text-muted-foreground">@PendingCount pending</span>
                        }
                    </div>
                    <div class="space-y-2">
                        @foreach (var invite in _invites)
                        {
                            <div class="flex items-center gap-3 p-2 rounded-lg border bg-card">
                                <AvatarCn Class="h-8 w-8">
                                    <AvatarFallbackCn Class="text-xs">
                                        @invite.Email[0].ToString().ToUpper()
                                    </AvatarFallbackCn>
                                </AvatarCn>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium text-foreground truncate">
                                            @invite.Email
                                        </span>
                                        @if (invite.Status == "pending")
                                        {
                                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">
                                                <LucideClockCn Size="12" Class="mr-1" />
                                                Pending
                                            </BadgeCn>
                                        }
                                        else
                                        {
                                            <BadgeCn Class="text-xs text-emerald-600" Variant="BadgeVariant.Outline">
                                                Accepted
                                            </BadgeCn>
                                        }
                                    </div>
                                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                        <span>@invite.Role</span>
                                        <span>&bull;</span>
                                        <span>@invite.SentAt</span>
                                    </div>
                                </div>
                                @if (invite.Status == "pending")
                                {
                                    <ButtonCn
                                        Class="h-8 w-8 shrink-0"
                                        @onclick="@(() => RemoveInvite(invite.Id))"
                                        Size="ButtonSize.Icon"
                                        Variant="ButtonVariant.Ghost">
                                        <LucideXCn Size="16" />
                                    </ButtonCn>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                @* Empty state *@
                <div class="text-center py-6">
                    <LucideMailCn Size="40" Class="text-muted-foreground mx-auto mb-3" />
                    <p class="text-sm text-muted-foreground">
                        No invites sent yet. Add team members above.
                    </p>
                </div>
            }

            @* Actions *@
            <div class="flex items-center justify-between pt-4 border-t">
                <ButtonCn Variant="ButtonVariant.Ghost">Skip for now</ButtonCn>
                <ButtonCn>Continue</ButtonCn>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private record InviteItem(string Id, string Email, string Role, string Status, string SentAt);

    private string _email = "";
    private string _role = "member";
    private bool _sending;

    private List<InviteItem> _invites =
    [
        new("1", "sarah@@example.com", "Admin", "accepted", "2 days ago"),
        new("2", "mike@@example.com", "Member", "pending", "1 hour ago"),
    ];

    private int PendingCount => _invites.Count(i => i.Status == "pending");

    private async Task HandleSendInvite()
    {
        if (string.IsNullOrEmpty(_email)) return;
        _sending = true;
        StateHasChanged();
        await Task.Delay(1000);
        _invites.Add(new(Guid.NewGuid().ToString(), _email, _role, "pending", "Just now"));
        _email = "";
        _sending = false;
    }

    private void RemoveInvite(string id)
    {
        _invites.RemoveAll(i => i.Id == id);
    }
}
