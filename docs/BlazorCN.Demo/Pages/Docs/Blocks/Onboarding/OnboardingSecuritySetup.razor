@* ========================================
   Block: onboarding-security-setup
   Title: Onboarding Security Setup
   Description: Security setup with password strength meter, 2FA toggle, and recovery email for account protection
   Long Description: Progress bar with vertical task list, percentage indicator, and time estimates for trackable setup flows
   Dependencies: LucideCheckCn, LucideEyeCn, LucideEyeOffCn, LucideKeyCn, LucideLockCn, LucideMailCn, LucideShieldCn, LucideShieldCheckCn, LucideXCn
   Source: original/blocks/onboarding/onboarding-security-setup.tsx
   ======================================== *@
<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-md">
        <CardHeaderCn Class="text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
                <LucideShieldCn Size="24" Class="text-primary" />
            </div>
            <CardTitleCn>Secure your account</CardTitleCn>
            <CardDescriptionCn>Set up security options to protect your account</CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn Class="space-y-6">
            @* Password *@
            <div class="space-y-3">
                <LabelCn For="password">Create a strong password</LabelCn>
                <div class="relative">
                    <LucideLockCn Size="16" Class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground" />
                    <InputCn
                        Class="pl-10 pr-10"
                        id="password"
                        Placeholder="Enter your password"
                        type="@(_showPassword ? "text" : "password")"
                        Value="@_password"
                        ValueChanged="@((string v) => _password = v)" />
                    <ButtonCn
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.IconSm"
                        Class="absolute right-3 top-1/2 -translate-y-1/2"
                        Type="button"
                        @onclick="@(() => _showPassword = !_showPassword)">
                        @if (_showPassword)
                        {
                            <LucideEyeOffCn Size="16" />
                        }
                        else
                        {
                            <LucideEyeCn Size="16" />
                        }
                    </ButtonCn>
                </div>

                @* Strength meter *@
                @if (!string.IsNullOrEmpty(_password))
                {
                    <div class="space-y-1">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Password strength</span>
                            <span class="@(Cn.Merge("font-medium", StrengthColorText))">
                                @StrengthLabel
                            </span>
                        </div>
                        <div class="h-1.5 bg-muted rounded-full overflow-hidden">
                            <div
                                class="@(Cn.Merge("h-full transition-all duration-300", StrengthColor))"
                                style="@($"width: {StrengthPercent}%")">
                            </div>
                        </div>
                    </div>

                    @* Checklist *@
                    <div class="grid grid-cols-2 gap-1.5">
                        @foreach (var check in PasswordChecks)
                        {
                            <div class="flex items-center gap-1.5 text-xs">
                                @if (check.Valid)
                                {
                                    <LucideCheckCn Size="12" Class="text-emerald-500" />
                                }
                                else
                                {
                                    <LucideXCn Size="12" Class="text-muted-foreground" />
                                }
                                <span class="@(check.Valid ? "text-foreground" : "text-muted-foreground")">
                                    @check.Label
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>

            @* 2FA toggle *@
            <div class="flex items-start justify-between gap-4 p-4 rounded-lg border">
                <div class="flex items-start gap-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-muted">
                        <LucideKeyCn Size="20" Class="text-muted-foreground" />
                    </div>
                    <div>
                        <p class="font-medium text-foreground">Two-factor authentication</p>
                        <p class="text-xs text-muted-foreground mt-0.5">
                            Add an extra layer of security
                        </p>
                    </div>
                </div>
                <SwitchCn Checked="@_enable2FA" CheckedChanged="@((bool v) => _enable2FA = v)" />
            </div>

            @* Recovery email *@
            <div class="space-y-2">
                <LabelCn Class="flex items-center gap-2" For="recovery">
                    <LucideMailCn Size="16" Class="text-muted-foreground" />
                    Recovery email
                </LabelCn>
                <InputCn
                    id="recovery"
                    Placeholder="@("backup@example.com")"
                    type="email"
                    Value="@_recoveryEmail"
                    ValueChanged="@((string v) => _recoveryEmail = v)" />
                <p class="text-xs text-muted-foreground">
                    Used to recover your account if you lose access
                </p>
            </div>

            @* Security summary *@
            <div class="flex items-center gap-2 p-3 rounded-lg bg-muted/50">
                <LucideShieldCheckCn Size="20" Class="text-primary" />
                <span class="text-sm text-muted-foreground">
                    @(PassedChecks == 4 && _enable2FA
                        ? "Your account is well protected"
                        : "Complete all steps for maximum security")
                </span>
            </div>

            @* Actions *@
            <div class="flex items-center justify-between pt-4 border-t">
                <ButtonCn Variant="ButtonVariant.Ghost">Skip for now</ButtonCn>
                <ButtonCn Disabled="@(PassedChecks < 4)">Continue</ButtonCn>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private record CheckItem(string Label, bool Valid);

    private string _password = "";
    private bool _showPassword;
    private bool _enable2FA;
    private string _recoveryEmail = "";

    private CheckItem[] PasswordChecks =>
    [
        new("8+ characters", _password.Length >= 8),
        new("Uppercase letter", _password.Any(char.IsUpper)),
        new("Lowercase letter", _password.Any(char.IsLower)),
        new("Number", _password.Any(char.IsDigit)),
    ];

    private int PassedChecks => PasswordChecks.Count(c => c.Valid);

    private int StrengthPercent => PassedChecks * 25;

    private string StrengthLabel => PassedChecks switch
    {
        <= 1 => "Weak",
        2 => "Fair",
        3 => "Good",
        _ => "Strong",
    };

    private string StrengthColorText => PassedChecks switch
    {
        <= 1 => "text-destructive",
        2 => "text-amber-500",
        3 => "text-primary",
        _ => "text-emerald-500",
    };

    private string StrengthColor => PassedChecks switch
    {
        <= 1 => "bg-destructive",
        2 => "bg-amber-500",
        3 => "bg-primary",
        _ => "bg-emerald-500",
    };
}
