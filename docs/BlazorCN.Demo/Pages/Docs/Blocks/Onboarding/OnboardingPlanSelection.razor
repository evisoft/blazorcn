@* ========================================
   Block: onboarding-plan-selection
   Title: Onboarding Plan Selection
   Description: Plan selection with pricing cards, feature comparison, and recommended badge for subscription flows
   Long Description: React Onboarding Notification Permissions
   Dependencies: LucideCheckCn
   Source: original/blocks/onboarding/onboarding-plan-selection.tsx
   ======================================== *@

<div class="flex items-center justify-center p-10 w-full">
    <div class="w-full max-w-4xl">
        <div class="text-center mb-8">
            <h2 class="text-2xl font-semibold text-foreground">Choose your plan</h2>
            <p class="text-muted-foreground mt-1">Start with a 14-day free trial. Cancel anytime.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            @foreach (var plan in _plans)
            {
                <CardCn Class="@Cn.Merge("relative cursor-pointer transition-all", _selectedPlan == plan.Id ? "border-primary ring-1 ring-primary" : "hover:border-primary/50", plan.Recommended ? "border-primary" : "")"
                        @onclick="@(() => _selectedPlan = plan.Id)">
                    @if (plan.Recommended)
                    {
                        <div class="absolute -top-3 left-1/2 -translate-x-1/2">
                            <BadgeCn Class="bg-primary text-primary-foreground">Recommended</BadgeCn>
                        </div>
                    }
                    <CardHeaderCn Class="text-center pb-2">
                        <CardTitleCn Class="text-lg">@plan.Name</CardTitleCn>
                        <CardDescriptionCn>@plan.Description</CardDescriptionCn>
                    </CardHeaderCn>
                    <CardContentCn Class="text-center">
                        <div class="mb-4">
                            <span class="text-4xl font-bold text-foreground">$@plan.Price</span>
                            <span class="text-muted-foreground text-sm ml-1">/@plan.Period</span>
                        </div>
                        <ul class="space-y-2 mb-6 text-left">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-center gap-2 text-sm">
                                    <LucideCheckCn Class="h-4 w-4 text-primary shrink-0" Size="16" />
                                    <span class="text-muted-foreground">@feature</span>
                                </li>
                            }
                        </ul>
                        <ButtonCn Class="w-full" Variant="@(_selectedPlan == plan.Id ? ButtonVariant.Default : ButtonVariant.Outline)">
                            @plan.Cta
                        </ButtonCn>
                    </CardContentCn>
                </CardCn>
            }
        </div>

        <p class="text-center text-sm text-muted-foreground mt-6">
            All plans include SSL, 99.9% uptime, and automatic backups.
        </p>
    </div>
</div>

@code {
    private record PlanInfo(string Id, string Name, int Price, string Period, string Description, string[] Features, string Cta, bool Recommended = false);

    private static readonly PlanInfo[] _plans =
    [
        new("free", "Free", 0, "forever", "For individuals getting started",
            ["Up to 3 projects", "Basic analytics", "48-hour support response", "1GB storage"], "Start free"),
        new("pro", "Pro", 19, "per month", "For professionals and small teams",
            ["Unlimited projects", "Advanced analytics", "Priority support", "100GB storage", "Custom domains", "Team collaboration"],
            "Start free trial", true),
        new("enterprise", "Enterprise", 99, "per month", "For large teams with custom needs",
            ["Everything in Pro", "Unlimited storage", "Dedicated support", "Custom integrations", "SLA guarantee", "Advanced security"],
            "Contact sales"),
    ];

    private string _selectedPlan = "pro";
}
