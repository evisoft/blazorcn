@* ============================================================
   Block: onboarding-dashboard-config
   Title: OnboardingDashboardConfig
   Description: A dashboard widget selection block for React and Next.js with toggleable icon cards in a grid, ring selection state, and build action using shadcn/ui and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-dashboard-config.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Configure dashboard</span>
                <span class="text-muted-foreground text-xs">@_selected.Count selected</span>
            </div>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Choose the widgets you want on your dashboard. You can add or remove them later in settings.
            </p>
        </div>

        @* Widget grid *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-2">
                @foreach (var widget in _widgets)
                {
                    var w = widget;
                    var isSelected = _selected.Contains(w.Id);
                    <button
                        type="button"
                        @onclick="@(() => ToggleWidget(w.Id))"
                        class="@Cn.Merge("flex flex-col items-start gap-2 rounded-md border p-3 text-left transition-all", isSelected ? "border-foreground/20 ring-2 ring-foreground/10" : "border-border hover:bg-muted/50")">
                        <LucideIconCn Name="@w.IconName" Size="20" Class="size-5 text-muted-foreground" />
                        <div class="min-w-0">
                            <span class="font-medium text-sm">@w.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@w.Description</p>
                        </div>
                    </button>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-end px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">Build Dashboard</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record WidgetItem(string Id, string Name, string Description, string IconName);

    private static readonly WidgetItem[] _widgets =
    [
        new("analytics",      "Analytics",      "Traffic and engagement metrics",  "bar-chart-3"),
        new("tasks",          "Tasks",           "Active tasks and deadlines",       "check-square"),
        new("calendar",       "Calendar",        "Upcoming events and meetings",     "calendar"),
        new("team",           "Team activity",   "Recent team member actions",       "users"),
        new("revenue",        "Revenue",         "Sales and subscription data",      "dollar-sign"),
        new("notifications",  "Notifications",   "Alerts and system messages",       "bell"),
    ];

    private readonly HashSet<string> _selected = new() { "analytics", "tasks", "revenue" };

    private void ToggleWidget(string id)
    {
        if (!_selected.Remove(id))
            _selected.Add(id);
    }
}
