@* ============================================================
   Block: onboarding-referral-code
   Title: OnboardingReferralCode
   Description: A React onboarding referral code entry with code input, apply button, animated discount reveal using Framer Motion AnimatePresence, and continue action built with Next.js, TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-referral-code.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="ticket" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Referral Code</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Have a referral code? Enter it below to unlock your discount. Codes are
                case-insensitive.
            </p>
        </div>

        @* Code input *@
        <div class="border-b px-4 py-3">
            <label for="referral-code" class="mb-1.5 block font-medium text-muted-foreground text-xs">
                Referral code
            </label>
            <div class="flex items-center gap-2">
                <InputCn Id="referral-code"
                         Type="text"
                         Placeholder="e.g. FRIEND2026"
                         Value="@_code"
                         ValueChanged="@((string v) => _code = v)"
                         Disabled="@_applied"
                         Class="h-8 flex-1 font-mono text-xs uppercase"
                         @onkeydown="HandleKeyDown" />
                <ButtonCn Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Sm"
                          Class="h-8 text-xs"
                          OnClick="HandleApply"
                          Disabled="@(!_code.Trim().Any() || _applied)">
                    Apply
                </ButtonCn>
            </div>
        </div>

        @* Discount reveal *@
        @if (_applied)
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2 rounded-md bg-emerald-500/10 px-3 py-2.5">
                    <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
                    <span class="font-medium text-emerald-600 text-sm dark:text-emerald-400">
                        10% discount applied
                    </span>
                </div>
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                Continue without code
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" Disabled="@(!_applied)">
                Continue
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private string _code = "";
    private bool _applied = false;

    private void HandleApply()
    {
        if (_code.Trim().Length > 0)
        {
            _applied = true;
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleApply();
        }
    }
}
