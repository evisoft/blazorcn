@* ============================================================
   Block: onboarding-calendar-sync
   Title: OnboardingCalendarSync
   Description: A React calendar sync onboarding block for Next.js with Google, Outlook, and Apple Calendar connection rows and sync action. Built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-calendar-sync.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Calendar Sync</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_connected.Count connected
            </span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Connect your calendars to keep events in sync across all your devices and services.
            </p>
        </div>

        @* Calendar providers *@
        <div>
            @for (int i = 0; i < _calendarProviders.Length; i++)
            {
                var provider = _calendarProviders[i];
                var isConnected = _connected.Contains(provider.Id);
                var isLast = i == _calendarProviders.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                            <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@provider.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@provider.Description</p>
                        </div>
                        @if (isConnected)
                        {
                            var pid = provider.Id;
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="h-7 gap-1 px-2 text-xs text-emerald-600 dark:text-emerald-400"
                                      @onclick="@(() => ToggleConnect(pid))">
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                                Connected
                            </ButtonCn>
                        }
                        else
                        {
                            var pid = provider.Id;
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                      Class="h-7 px-2 text-xs"
                                      @onclick="@(() => ToggleConnect(pid))">
                                Connect
                            </ButtonCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                Skip
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs"
                      Disabled="@(_connected.Count == 0)">
                <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                Sync Now
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record CalendarProvider(string Id, string Name, string Description);

    private static readonly CalendarProvider[] _calendarProviders =
    [
        new("google",  "Google Calendar",  "Sync events from your Google account"),
        new("outlook", "Outlook Calendar", "Connect your Microsoft 365 calendar"),
        new("apple",   "Apple Calendar",   "Import events from iCloud Calendar"),
    ];

    private HashSet<string> _connected = ["google"];

    private void ToggleConnect(string id)
    {
        if (_connected.Contains(id))
            _connected.Remove(id);
        else
            _connected.Add(id);
    }
}
