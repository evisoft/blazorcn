@* ============================================================
   Block: onboarding-environment-setup
   Title: OnboardingEnvironmentSetup
   Description: A React development environment configuration onboarding block with three environment rows, colored status dots, URL inputs, and create action. Built with Next.js, TypeScript, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-environment-setup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="server" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Configure Environments</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Set up the URLs for each deployment environment
            </p>
        </div>

        @* Environment rows *@
        <div>
            @foreach (var env in _environments)
            {
                var isLast = env.Id == _environments[_environments.Length - 1].Id;
                <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", env.Color)"></span>
                        <span class="w-24 shrink-0 font-medium text-sm">@env.Name</span>
                        <InputCn Value="@env.Url"
                                 ValueChanged="@((string v) => UpdateUrl(env.Id, v))"
                                 Placeholder="@("https://...")"
                                 Class="h-8 border-0 bg-muted/50 font-mono text-xs shadow-none focus-visible:ring-1" />
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_environments.Length environments configured
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Create Environments
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Environment(string Id, string Name, string Color, string Url);

    private Environment[] _environments =
    [
        new("development", "Development", "bg-blue-500",    "https://dev.acme.com"),
        new("staging",     "Staging",     "bg-amber-500",   "https://staging.acme.com"),
        new("production",  "Production",  "bg-emerald-500", "https://acme.com"),
    ];

    private void UpdateUrl(string id, string url)
    {
        _environments = [.. _environments.Select(e => e.Id == id ? e with { Url = url } : e)];
    }
}
