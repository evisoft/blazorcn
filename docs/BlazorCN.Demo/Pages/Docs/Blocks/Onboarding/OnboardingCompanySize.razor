@* ============================================================
   Block: onboarding-company-size
   Title: OnboardingCompanySize
   Description: A company size selector onboarding block for React and Next.js with four employee range tiers, icon and description per tier, single-select with ring highlight, and continue button built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-company-size.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Company Size</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-3">
            <p class="text-muted-foreground text-sm">
                How large is your organization? This helps us recommend the right plan and features.
            </p>
        </div>

        @* Tier options *@
        <div>
            @foreach (var tier in _tiers)
            {
                var t = tier;
                var isSelected = _selectedTier == t.Id;
                var isLast = t.Id == _tiers[_tiers.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _selectedTier = t.Id)"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isSelected ? "ring-2 ring-inset ring-foreground" : "")">
                        <LucideIconCn Name="users" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@t.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@t.Range &middot; @t.Description</p>
                        </div>
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full transition-colors", isSelected ? "bg-foreground" : "bg-muted")" />
                    </button>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Step 2 of 3</span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" Disabled="@(_selectedTier == null)">
                Continue
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record SizeTier(string Id, string Label, string Range, string Description);

    private string? _selectedTier = null;

    private static readonly SizeTier[] _tiers =
    [
        new("startup", "1-10 employees", "Startup", "Small team shipping fast with minimal process"),
        new("small", "11-50 employees", "Small business", "Growing team with dedicated roles and departments"),
        new("medium", "51-200 employees", "Mid-market", "Established organization with structured workflows"),
        new("enterprise", "200+ employees", "Enterprise", "Large organization with compliance and governance needs"),
    ];
}
