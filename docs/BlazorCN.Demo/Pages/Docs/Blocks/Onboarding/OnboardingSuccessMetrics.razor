@* ============================================================
   Block: onboarding-success-metrics
   Title: OnboardingSuccessMetrics
   Description: A success metrics definition onboarding block for React and Next.js with multi-select KPI options, checkbox indicators, and goal-setting CTA. Built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-success-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="target" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">What does success look like?</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Select the metrics that matter most to your team
            </p>
        </div>

        @* Metric options *@
        <div>
            @foreach (var metric in _metrics)
            {
                var m = metric;
                var isSelected = _selected.Contains(m.Id);
                var isLast = m.Id == _metrics[_metrics.Length - 1].Id;

                <div class="@(isLast ? "" : "border-b")">
                    <label class="flex w-full cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <input type="checkbox" class="sr-only" checked="@isSelected" @onchange="@(() => Toggle(m.Id))" />
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                            <LucideIconCn Name="@m.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@m.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@m.Description</p>
                        </div>
                        <div class="@(Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded border transition-colors", isSelected ? "border-foreground bg-foreground" : "border-muted-foreground/30"))">
                            @if (isSelected)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-background" />
                            }
                        </div>
                    </label>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_selected.Count metric@(_selected.Count != 1 ? "s" : "") selected
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Set Goals
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record MetricItem(string Id, string Label, string Description, string IconName);

    private readonly HashSet<string> _selected = new(["revenue"]);

    private void Toggle(string id)
    {
        if (!_selected.Remove(id))
            _selected.Add(id);
    }

    private static readonly MetricItem[] _metrics =
    [
        new("revenue", "Revenue growth", "Track MRR, ARR, and revenue targets over time", "trending-up"),
        new("acquisition", "User acquisition", "Monitor signups, activation rates, and growth velocity", "users"),
        new("productivity", "Team productivity", "Measure output, velocity, and cycle time improvements", "bar-chart-3"),
        new("satisfaction", "Customer satisfaction", "Track NPS, CSAT scores, and retention metrics", "smile"),
    ];
}
