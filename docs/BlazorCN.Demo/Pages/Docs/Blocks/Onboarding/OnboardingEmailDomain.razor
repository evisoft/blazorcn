@* ============================================================
   Block: onboarding-email-domain
   Title: OnboardingEmailDomain
   Description: A React email domain verification onboarding block for Next.js with SPF, DKIM, and DMARC DNS records. Built with TypeScript, shadcn/ui Button and Input, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-email-domain.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Verify your email domain</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Add DNS records to authenticate your sending domain.
            </p>
        </div>

        @* Domain input *@
        <div class="border-b px-4 py-3">
            <label for="domain-input" class="mb-1.5 block font-medium text-muted-foreground text-xs">
                Domain
            </label>
            <InputCn id="domain-input" @bind-Value="_domain" Placeholder="@("yourdomain.com")" Class="h-8 font-mono text-sm" />
        </div>

        @* DNS records table *@
        <div>
            @foreach (var record in _dnsRecords)
            {
                var isLast = record.Id == _dnsRecords[_dnsRecords.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <span class="@($"size-1.5 shrink-0 rounded-full {StatusDotClass(record.Status)}")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@record.Name</span>
                                <span class="rounded bg-muted px-1.5 py-0.5 font-mono text-muted-foreground text-xs">
                                    @record.Type
                                </span>
                            </div>
                            <p class="mt-0.5 truncate font-mono text-muted-foreground text-xs">
                                @record.Value
                            </p>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">
                            @StatusLabelText(record.Status)
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @(_dnsRecords.Count(r => r.Status == "verified")) of @(_dnsRecords.Length) verified
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Verify Domain
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private string _domain = "acme.com";

    private record DnsRecord(string Id, string Type, string Name, string Value, string Status);

    private static readonly DnsRecord[] _dnsRecords =
    [
        new("spf",  "TXT",   "SPF",  "v=spf1 include:_spf.acme.com ~all",                   "verified"),
        new("dkim", "CNAME", "DKIM", "dk1._domainkey.acme.com",                              "pending"),
        new("dmarc","TXT",   "DMARC","v=DMARC1; p=quarantine; rua=mailto:dmarc@@acme.com",   "verified"),
    ];

    private static string StatusDotClass(string status) => status switch
    {
        "verified" => "bg-emerald-500",
        "pending"  => "bg-amber-500",
        _          => ""
    };

    private static string StatusLabelText(string status) => status switch
    {
        "verified" => "Verified",
        "pending"  => "Pending",
        _          => ""
    };
}
