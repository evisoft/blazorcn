@* ========================================
   Block: onboarding-notification-permissions
   Title: Onboarding Notification Permissions
   Description: Notification permissions with channel toggles, preview examples, and consent management
   Long Description: React Onboarding Mobile App Download
   Dependencies: LucideBellCn, LucideMailCn, LucideMessageSquareCn, LucideSmartphoneCn, LucideZapCn
   Source: original/blocks/onboarding/onboarding-notification-permissions.tsx
   ======================================== *@
<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-md">
        <CardHeaderCn Class="text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
                <LucideZapCn Size="24" Class="text-primary" />
            </div>
            <CardTitleCn>Stay in the loop</CardTitleCn>
            <CardDescriptionCn>Choose how you'd like to receive notifications</CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn Class="space-y-6">
            @* Channels *@
            <div class="space-y-3">
                @foreach (var channel in _channels)
                {
                    <div class="@(Cn.Merge("rounded-lg border p-4 transition-colors", channel.Enabled ? "border-primary/50 bg-primary/5" : ""))">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex items-start gap-3">
                                <div class="@(Cn.Merge(
                                    "flex h-10 w-10 shrink-0 items-center justify-center rounded-lg transition-colors",
                                    channel.Enabled ? "bg-primary text-primary-foreground" : "bg-muted text-muted-foreground"
                                ))">
                                    @if (channel.Id == "email")
                                    {
                                        <LucideMailCn Size="20" />
                                    }
                                    else if (channel.Id == "push")
                                    {
                                        <LucideSmartphoneCn Size="20" />
                                    }
                                    else
                                    {
                                        <LucideMessageSquareCn Size="20" />
                                    }
                                </div>
                                <div>
                                    <p class="font-medium text-foreground">@channel.Title</p>
                                    <p class="text-xs text-muted-foreground mt-0.5">@channel.Description</p>
                                </div>
                            </div>
                            <SwitchCn Checked="@channel.Enabled" CheckedChanged="@(() => ToggleChannel(channel.Id))" />
                        </div>

                        @* Preview *@
                        @if (channel.Enabled)
                        {
                            <div class="mt-3 pl-13">
                                <div class="flex items-center gap-2 p-2 rounded bg-muted/50 text-xs">
                                    <LucideBellCn Size="12" Class="text-muted-foreground" />
                                    <span class="text-muted-foreground italic">"@channel.Preview"</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Summary *@
            <div class="text-center text-sm text-muted-foreground">
                @if (EnabledCount == 0)
                {
                    <p>You won't receive any notifications</p>
                }
                else
                {
                    <p>
                        You'll receive notifications via
                        <span class="font-medium text-foreground">
                            @EnabledCount channel@(EnabledCount != 1 ? "s" : "")
                        </span>
                    </p>
                }
            </div>

            @* Privacy note *@
            <div class="p-3 rounded-lg bg-muted/50 text-xs text-muted-foreground text-center">
                You can change these settings anytime in your preferences. We respect your inbox.
            </div>

            @* Actions *@
            <div class="flex items-center justify-between pt-4 border-t">
                <ButtonCn Variant="ButtonVariant.Ghost">Skip</ButtonCn>
                <ButtonCn>Save preferences</ButtonCn>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private class ChannelItem
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Preview { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private int EnabledCount => _channels.Count(c => c.Enabled);

    private readonly ChannelItem[] _channels =
    [
        new() { Id = "email", Title = "Email", Description = "Important updates and weekly digest", Preview = "You have 3 new comments on your project", Enabled = true },
        new() { Id = "push", Title = "Push notifications", Description = "Real-time alerts on your device", Preview = "Sarah mentioned you in a task", Enabled = true },
        new() { Id = "sms", Title = "SMS", Description = "Critical alerts and security codes", Preview = "Your deploy completed successfully", Enabled = false },
    ];

    private void ToggleChannel(string id)
    {
        var channel = _channels.FirstOrDefault(c => c.Id == id);
        if (channel != null) channel.Enabled = !channel.Enabled;
    }
}
