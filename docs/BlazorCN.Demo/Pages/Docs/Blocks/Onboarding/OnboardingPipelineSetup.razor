@* ============================================================
   Block: onboarding-pipeline-setup
   Title: OnboardingPipelineSetup
   Description: React and Next.js pipeline configuration onboarding block with TypeScript, draggable stage rows, colored indicators, shadcn/ui components, and Tailwind CSS for CRM setup.
   Source: original/blocks/onboarding/onboarding-pipeline-setup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Set up your pipeline</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Define the stages that deals move through from first contact to close. Drag to
                reorder.
            </p>
        </div>

        @* Stage rows *@
        <div>
            @foreach (var stage in _stages)
            {
                <div class="border-b">
                    <div class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="grip-vertical" Size="16" Class="size-4 shrink-0 cursor-grab text-muted-foreground/40" aria-hidden="true" />
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", stage.Color)"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@stage.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@stage.Description</p>
                        </div>
                        <span class="font-mono text-muted-foreground/60 text-xs">@(_stages.IndexOf(stage) + 1)</span>
                    </div>
                </div>
            }
        </div>

        @* Add stage *@
        <div class="border-b px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs text-muted-foreground">
                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                Add Stage
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <span class="text-muted-foreground text-xs">@(_stages.Count) stages configured</span>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">Save Pipeline</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Stage(string Id, string Name, string Description, string Color);

    private List<Stage> _stages =
    [
        new("lead",      "Lead",      "New inbound contacts and prospects",              "bg-blue-500"),
        new("qualified", "Qualified", "Vetted leads with confirmed budget and timeline", "bg-amber-500"),
        new("proposal",  "Proposal",  "Proposals sent and awaiting client review",       "bg-purple-500"),
        new("closed",    "Closed",    "Deals won and contracts signed",                  "bg-emerald-500"),
    ];
}
