@* ============================================================
   Block: onboarding-plugin-install
   Title: OnboardingPluginInstall
   Description: Plugin installation onboarding with toggle states, install tracking, and continue action for React and Next.js apps built with shadcn/ui and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-plugin-install.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Install Plugins</span>
                </div>
                <span class="text-muted-foreground text-xs">
                    @_installedCount of @_plugins.Length installed
                </span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Add functionality to your project with plugins
            </p>
        </div>

        @* Plugin rows *@
        <div>
            @for (var i = 0; i < _plugins.Length; i++)
            {
                var plugin = _plugins[i];
                var isLast = i == _plugins.Length - 1;
                <div class="@Cn.Merge(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                            <LucideIconCn Name="@plugin.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@plugin.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@plugin.Description</p>
                        </div>
                        <div class="shrink-0">
                            @if (plugin.Installed)
                            {
                                var pid = plugin.Id;
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 gap-1 px-2 text-xs"
                                          @onclick="@(() => ToggleInstall(pid))">
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                    Installed
                                </ButtonCn>
                            }
                            else
                            {
                                var pid = plugin.Id;
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs"
                                          @onclick="@(() => ToggleInstall(pid))">
                                    Install
                                </ButtonCn>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs">
                Skip for now
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Continue
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private class PluginItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
        public bool Installed { get; set; }
    }

    private PluginItem[] _plugins =
    [
        new() { Id = "analytics", Name = "Analytics", Description = "Track page views, events, and conversions", Icon = "bar-chart-3", Installed = false },
        new() { Id = "seo", Name = "SEO", Description = "Meta tags, sitemaps, and structured data", Icon = "search", Installed = false },
        new() { Id = "forms", Name = "Forms", Description = "Drag-and-drop form builder with validation", Icon = "file-text", Installed = false },
        new() { Id = "chat", Name = "Chat", Description = "Live chat widget for visitor support", Icon = "message-circle", Installed = false },
        new() { Id = "payments", Name = "Payments", Description = "Accept payments with Stripe integration", Icon = "credit-card", Installed = false },
        new() { Id = "email", Name = "Email", Description = "Transactional and marketing email campaigns", Icon = "mail", Installed = false },
    ];

    private int _installedCount => _plugins.Count(p => p.Installed);

    private void ToggleInstall(string id)
    {
        var plugin = _plugins.FirstOrDefault(p => p.Id == id);
        if (plugin is not null)
        {
            plugin.Installed = !plugin.Installed;
        }
    }
}
