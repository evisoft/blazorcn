@* ========================================
   Block: onboarding-carousel
   Title: Onboarding Carousel
   Description: Multi-slide carousel with feature highlights, dot navigation, and skip option for feature introductions
   Long Description: Card grid with task cards, completion badges, and progress bar for non-linear setup tasks
   Dependencies: LucideArrowRightCn, LucideFileTextCn, LucideShare2Cn, LucideShieldCn, LucideZapCn
   Source: original/blocks/onboarding/onboarding-carousel.tsx
   ======================================== *@

<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-md overflow-hidden">
        <CardContentCn Class="p-0">
            @{ var slide = _slides[_currentSlide]; var isLastSlide = _currentSlide == _slides.Length - 1; }
            <div class="p-8 text-center">
                <div class="@Cn.Merge("mx-auto mb-6 flex h-24 w-24 items-center justify-center rounded-full", slide.Bg)">
                    <div class="@slide.Color">
                        @switch (slide.Icon)
                        {
                            case "zap":
                                <LucideZapCn Class="h-12 w-12" Size="48" />
                                break;
                            case "share2":
                                <LucideShare2Cn Class="h-12 w-12" Size="48" />
                                break;
                            case "shield":
                                <LucideShieldCn Class="h-12 w-12" Size="48" />
                                break;
                            case "file-text":
                                <LucideFileTextCn Class="h-12 w-12" Size="48" />
                                break;
                        }
                    </div>
                </div>
                <h2 class="text-xl font-semibold text-foreground mb-2">@slide.Title</h2>
                <p class="text-sm text-muted-foreground leading-relaxed">@slide.Description</p>
            </div>

            <div class="px-8 pb-8">
                <div class="flex items-center justify-center gap-0.5 mb-6">
                    @for (var i = 0; i < _slides.Length; i++)
                    {
                        var idx = i;
                        <button type="button"
                                aria-label="@($"Go to slide {idx + 1}")"
                                class="inline-flex size-6 items-center justify-center"
                                @onclick="@(() => _currentSlide = idx)">
                            <span class="@Cn.Merge("h-2 rounded-full transition-all", idx == _currentSlide ? "w-6 bg-primary" : "w-2 bg-muted hover:bg-muted-foreground/30")"></span>
                        </button>
                    }
                </div>
                <div class="flex items-center gap-3">
                    @if (!isLastSlide)
                    {
                        <ButtonCn Class="flex-1" @onclick="@(() => _currentSlide = _slides.Length - 1)" Variant="ButtonVariant.Ghost">
                            Skip
                        </ButtonCn>
                    }
                    <ButtonCn Class="@Cn.Merge("flex-1", isLastSlide ? "w-full" : "")"
                              @onclick="@(() => { if (isLastSlide) _currentSlide = 0; else _currentSlide++; })">
                        @if (isLastSlide)
                        {
                            <span>Get Started</span>
                        }
                        else
                        {
                            <span>Next</span>
                            <LucideArrowRightCn Class="ml-2 h-4 w-4" Size="16" />
                        }
                    </ButtonCn>
                </div>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private record SlideInfo(string Icon, string Title, string Description, string Color, string Bg);

    private static readonly SlideInfo[] _slides =
    [
        new("zap", "Lightning Fast Performance", "Experience blazing fast load times and smooth interactions. Our optimized infrastructure ensures your work is never slowed down.", "text-amber-500", "bg-amber-500/10"),
        new("share2", "Seamless Collaboration", "Work together in real-time with your team. Share documents, leave comments, and stay in sync no matter where you are.", "text-blue-500", "bg-blue-500/10"),
        new("shield", "Enterprise Security", "Your data is protected with bank-level encryption. SOC 2 compliant with advanced access controls and audit logs.", "text-emerald-500", "bg-emerald-500/10"),
        new("file-text", "Smart Templates", "Get started quickly with professionally designed templates. Customize them to match your brand and workflow.", "text-purple-500", "bg-purple-500/10"),
    ];

    private int _currentSlide;
}
