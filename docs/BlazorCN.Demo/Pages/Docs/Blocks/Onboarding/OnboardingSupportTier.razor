@* ============================================================
   Block: onboarding-support-tier
   Title: OnboardingSupportTier
   Description: A support tier selection onboarding block for React and Next.js with three pricing tiers, animated NumberFlow prices, response time labels, and feature lists. Built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-support-tier.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="headphones" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Choose Your Support Plan</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Select the level of support that matches your needs
            </p>
        </div>

        @* Tier rows *@
        <div>
            @foreach (var tier in _tiers)
            {
                var isSelected = _selectedId == tier.Id;
                var isLast = tier.Id == _tiers[_tiers.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="@Cn.Merge("w-full px-4 py-3 text-left transition-all", isSelected ? "ring-2 ring-inset ring-foreground bg-muted/30" : "hover:bg-muted/50")"
                            @onclick="@(() => _selectedId = tier.Id)">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full border transition-colors", isSelected ? "border-foreground bg-foreground text-background" : "border-muted-foreground/30")">
                                    @if (isSelected)
                                    {
                                        <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                    }
                                </div>
                                <div>
                                    <span class="font-medium text-sm">@tier.Name</span>
                                    <p class="mt-0.5 text-muted-foreground text-xs">@tier.ResponseTime</p>
                                </div>
                            </div>
                            <div class="flex items-baseline gap-0.5">
                                <span class="font-semibold text-sm tabular-nums">
                                    @if (tier.Price == 0)
                                    {
                                        @:Free
                                    }
                                    else
                                    {
                                        @:$@tier.Price
                                    }
                                </span>
                                @if (tier.Price > 0)
                                {
                                    <span class="text-muted-foreground text-xs">@tier.Period</span>
                                }
                            </div>
                        </div>
                        <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 pl-11">
                            @foreach (var feature in tier.Features)
                            {
                                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                    <span class="size-1 shrink-0 rounded-full bg-muted-foreground/50" aria-hidden="true"></span>
                                    @feature
                                </span>
                            }
                        </div>
                    </button>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                You can change this later in settings
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Select Support Plan
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record SupportTier(string Id, string Name, int Price, string Period, string ResponseTime, string[] Features);

    private static readonly SupportTier[] _tiers =
    [
        new("community", "Community", 0, "free", "48h response time",
            ["Community forums", "Knowledge base access", "GitHub issues"]),
        new("priority", "Priority", 29, "/mo", "4h response time",
            ["Email support", "Priority queue", "Shared Slack channel"]),
        new("dedicated", "Dedicated", 99, "/mo", "1h response time",
            ["Dedicated account manager", "Phone support", "Custom SLA"]),
    ];

    private string _selectedId = "priority";
}
