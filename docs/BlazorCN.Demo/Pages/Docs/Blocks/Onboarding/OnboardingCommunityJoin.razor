@* ============================================================
   Block: onboarding-community-join
   Title: OnboardingCommunityJoin
   Description: A community channel joining onboarding block for React and Next.js with four toggleable channels, member counts, join state toggle, and continue action built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-community-join.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Join the community</span>
                @if (_joinedCount > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_joinedCount joined
                    </BadgeCn>
                }
            </div>
            <p class="mt-1 text-xs text-muted-foreground">Pick the channels that interest you</p>
        </div>

        @* Channel rows *@
        <div class="border-b">
            @foreach (var ch in _channels)
            {
                var channel = ch;
                var isLast = _channels[_channels.Length - 1].Id == channel.Id;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                    <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50 text-muted-foreground" aria-hidden="true">
                        <LucideIconCn Name="hash" Size="16" Class="size-4" />
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@channel.Name</span>
                            <span class="text-xs text-muted-foreground">@channel.MemberCount.ToString("N0") members</span>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@channel.Description</p>
                    </div>
                    <ButtonCn
                        Variant="@(channel.Joined ? ButtonVariant.Outline : ButtonVariant.Ghost)"
                        Size="ButtonSize.Sm"
                        Class="h-7 shrink-0 text-xs"
                        @onclick="@(() => ToggleChannel(channel.Id))">
                        @(channel.Joined ? "Joined" : "Join")
                    </ButtonCn>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_joinedCount of @_channels.Length channels joined
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Continue to Community
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record CommunityChannel(string Id, string Name, string Description, int MemberCount, bool Joined);

    private CommunityChannel[] _channels =
    [
        new("general",     "General",     "Announcements, introductions, and open discussion",          4218, false),
        new("engineering", "Engineering", "Technical discussions, code reviews, and architecture",      2847, false),
        new("design",      "Design",      "UI/UX feedback, design systems, and accessibility",          1536, false),
        new("product",     "Product",     "Feature requests, roadmap updates, and user research",       1923, false),
    ];

    private int _joinedCount => _channels.Count(c => c.Joined);

    private void ToggleChannel(string id)
    {
        _channels = _channels
            .Select(c => c.Id == id ? c with { Joined = !c.Joined } : c)
            .ToArray();
    }
}
