@* ============================================================
   Block: onboarding-feature-flags
   Title: OnboardingFeatureFlags
   Description: A React feature toggle setup onboarding block with five configurable switches, icons, descriptions, and save action. Built with Next.js, TypeScript, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-feature-flags.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="settings" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Feature Configuration</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">@_enabledCount enabled</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Choose which features to enable for your workspace. You can change these at any time
                from settings.
            </p>
        </div>

        @* Toggles *@
        <div>
            @for (var i = 0; i < _features.Length; i++)
            {
                var feature = _features[i];
                var isLast = i == _features.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="@feature.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <label for="@($"toggle-{feature.Id}")" class="block cursor-pointer font-medium text-sm">
                                @feature.Label
                            </label>
                            <p class="mt-0.5 text-muted-foreground text-xs">@feature.Description</p>
                        </div>
                        <SwitchCn
                            id="@($"toggle-{feature.Id}")"
                            Checked="@feature.Enabled"
                            CheckedChanged="@(() => feature.Enabled = !feature.Enabled)" />
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-end border-t px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">Save Configuration</ButtonCn>
        </div>
    </div>
</section>

@code {
    private class FeatureToggle
    {
        public string Id { get; set; } = "";
        public string IconName { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
    }

    private readonly FeatureToggle[] _features =
    [
        new() { Id = "beta",      IconName = "flask-conical", Label = "Beta features",       Description = "Try experimental features before they are generally available",          Enabled = false },
        new() { Id = "ai",        IconName = "brain",          Label = "AI suggestions",      Description = "Get intelligent suggestions and autocomplete powered by AI",             Enabled = true  },
        new() { Id = "analytics", IconName = "chart-bar",      Label = "Advanced analytics",  Description = "Access detailed usage reports, funnels, and cohort analysis",            Enabled = false },
        new() { Id = "workflows", IconName = "workflow",        Label = "Custom workflows",    Description = "Build automated workflows with triggers, conditions, and actions",       Enabled = true  },
        new() { Id = "api",       IconName = "code",            Label = "API access",          Description = "Enable REST and GraphQL API access for programmatic integrations",      Enabled = false },
    ];

    private int _enabledCount => _features.Count(f => f.Enabled);
}
