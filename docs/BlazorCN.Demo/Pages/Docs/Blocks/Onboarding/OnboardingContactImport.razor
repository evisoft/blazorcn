@* ============================================================
   Block: onboarding-contact-import
   Title: OnboardingContactImport
   Description: A contact import onboarding block for React and Next.js with CSV upload, Google Contacts, Salesforce integration, progress bar, and result count using shadcn/ui and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-contact-import.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Import your contacts</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Bring your existing contacts into your workspace to get started.
            </p>
        </div>

        @* Source options *@
        <div>
            @foreach (var src in _sources)
            {
                var source = src;
                var isSelected = _selected == source.Id;
                <div class="border-b">
                    <button
                        type="button"
                        @onclick="@(() => { _selected = source.Id; _imported = false; })"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isSelected ? "bg-muted/30" : "")">
                        <LucideIconCn Name="@source.Icon" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@source.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@source.Description</p>
                        </div>
                        <span class="@Cn.Merge("size-3 shrink-0 rounded-full border-2 transition-colors", isSelected ? "border-foreground bg-foreground" : "border-muted-foreground/40")" />
                    </button>
                </div>
            }
        </div>

        @* Upload area (shown when CSV selected) *@
        @if (_selected == "csv")
        {
            <div class="border-b px-4 py-4">
                <div class="rounded-md border-2 border-dashed p-6 text-center">
                    <LucideIconCn Name="upload" Size="16" Class="mx-auto mb-2 size-4 text-muted-foreground" />
                    <p class="font-medium text-xs">Drop your CSV here or click to browse</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">CSV files up to 25 MB</p>
                </div>
            </div>
        }

        @* Import progress / result *@
        <div class="border-b px-4 py-3">
            @if (_imported)
            {
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                    <span class="font-medium text-sm">142 contacts found</span>
                    <span class="text-muted-foreground text-xs">Ready to import</span>
                </div>
            }
            else
            {
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-muted-foreground text-xs">Import progress</span>
                        <span class="font-mono text-muted-foreground text-xs tabular-nums">0%</span>
                    </div>
                    <ProgressCn Value="0" Class="h-1.5" aria-label="Progress" />
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">
                Skip
            </ButtonCn>
            <ButtonCn
                Variant="ButtonVariant.Outline"
                Size="ButtonSize.Sm"
                Class="h-7 text-xs"
                @onclick="@(() => _imported = true)"
                Disabled="@(_selected == null)">
                Import Contacts
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ImportSource(string Id, string Label, string Description, string Icon);

    private static readonly ImportSource[] _sources =
    [
        new("csv", "CSV File", "Upload a .csv file from your computer", "file-spreadsheet"),
        new("google", "Google Contacts", "Import from your Google account", "cloud"),
        new("salesforce", "Salesforce", "Sync contacts from your Salesforce CRM", "users"),
    ];

    private string? _selected = "csv";
    private bool _imported = false;
}
