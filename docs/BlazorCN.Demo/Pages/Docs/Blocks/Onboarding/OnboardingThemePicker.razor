@* ============================================================
   Block: onboarding-theme-picker
   Title: OnboardingThemePicker
   Description: Theme selection onboarding block for React and Next.js with light, dark, and system options, live preview, and continue action built with TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-theme-picker.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Choose your theme</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Select how you want the interface to appear. You can change this later in settings.
            </p>
        </div>

        @* Theme options *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-3 gap-3">
                @foreach (var theme in _themes)
                {
                    var themeId = theme.Id;
                    <button
                        type="button"
                        @onclick="@(() => _selected = themeId)"
                        class="@Cn.Merge("flex flex-col items-center gap-2 rounded-md border p-3 transition-all", _selected == theme.Id ? "ring-2 ring-foreground ring-offset-2 ring-offset-background" : "hover:bg-muted/50")">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@theme.IconName" Size="16" Class="size-4" />
                        </span>
                        <span class="font-medium text-xs">@theme.Label</span>
                    </button>
                }
            </div>
        </div>

        @* Preview *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Preview</span>
            <div class="@Cn.Merge("rounded-md p-4 border", _activeTheme.PreviewBg)">
                <div class="@Cn.Merge("mb-3 rounded-md p-3", _activeTheme.PreviewCardBg)">
                    <div class="@Cn.Merge("mb-2 h-2 w-24 rounded", _activeTheme.PreviewText)"></div>
                    <div class="@Cn.Merge("h-2 w-36 rounded", _activeTheme.PreviewMuted)"></div>
                </div>
                <div class="flex gap-2">
                    <div class="@Cn.Merge("h-2 w-16 rounded", _activeTheme.PreviewMuted)"></div>
                    <div class="@Cn.Merge("h-2 w-12 rounded", _activeTheme.PreviewMuted)"></div>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Continue
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ThemeOption(
        string Id,
        string Label,
        string IconName,
        string PreviewBg,
        string PreviewCardBg,
        string PreviewText,
        string PreviewMuted
    );

    private static readonly ThemeOption[] _themes =
    [
        new("light", "Light", "sun", "bg-white", "bg-zinc-100", "bg-zinc-900", "bg-zinc-300"),
        new("dark",  "Dark",  "moon", "bg-zinc-950", "bg-zinc-900", "bg-zinc-100", "bg-zinc-700"),
        new("system", "System", "monitor", "bg-muted/50", "bg-muted", "bg-foreground", "bg-muted-foreground/30"),
    ];

    private string _selected = "light";

    private ThemeOption _activeTheme => Array.Find(_themes, t => t.Id == _selected) ?? _themes[0];
}
