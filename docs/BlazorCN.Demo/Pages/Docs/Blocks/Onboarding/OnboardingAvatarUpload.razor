@* ============================================================
   Block: onboarding-avatar-upload
   Title: OnboardingAvatarUpload
   Description: Avatar upload onboarding for React and Next.js with circle placeholder showing user initials, upload and remove photo buttons, AnimatePresence transitions, and save action. Built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-avatar-upload.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="camera" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Profile Photo</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-3">
            <p class="text-muted-foreground text-sm">
                Add a profile photo so your team can recognize you. This is optional and can be
                changed later.
            </p>
        </div>

        @* Avatar area *@
        <div class="flex flex-col items-center gap-4 border-b px-4 py-6">
            @if (_uploaded)
            {
                <div class="flex size-20 items-center justify-center rounded-full bg-violet-500"
                     aria-label="@($"Avatar for {_userName}")">
                    <span class="font-semibold text-lg text-white">@_initials</span>
                </div>
            }
            else
            {
                <div class="flex size-20 items-center justify-center rounded-full bg-muted"
                     aria-label="Avatar placeholder">
                    <LucideIconCn Name="user" Size="32" Class="size-8 text-muted-foreground" />
                </div>
            }

            <div class="flex items-center gap-2">
                @if (_uploaded)
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                              @onclick="@(() => _uploaded = false)">
                        <LucideIconCn Name="trash" Size="12" Class="size-3" />
                        Remove
                    </ButtonCn>
                }
                else
                {
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                              @onclick="@(() => _uploaded = true)">
                        <LucideIconCn Name="camera" Size="12" Class="size-3" />
                        Upload Photo
                    </ButtonCn>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">
                Skip
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Save &amp; Continue
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private bool _uploaded = false;
    private const string _userName = "Jane Doe";
    private string _initials = GetInitials("Jane Doe");

    private static string GetInitials(string name)
    {
        var parts = name.Trim().Split(' ', System.StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "";
        if (parts.Length == 1) return parts[0][0].ToString().ToUpper();
        return (parts[0][0].ToString() + parts[parts.Length - 1][0].ToString()).ToUpper();
    }
}
