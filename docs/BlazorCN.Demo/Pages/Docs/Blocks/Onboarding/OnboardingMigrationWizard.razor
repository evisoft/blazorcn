@* ============================================================
   Block: onboarding-migration-wizard
   Title: OnboardingMigrationWizard
   Description: Multi-platform data import wizard with OAuth connect, progress tracking, and state animations for React and Next.js. Built with TypeScript, shadcn/ui, Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-migration-wizard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="arrow-right-left" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Migrate from...</span>
                </div>
                @if (_doneCount > 0)
                {
                    <span class="text-muted-foreground text-xs">@_doneCount of @_platforms.Length imported</span>
                }
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Import your existing data from another platform
            </p>
        </div>

        @* Platform rows *@
        <div>
            @for (var i = 0; i < _platforms.Length; i++)
            {
                var platform = _platforms[i];
                var isLast = i == _platforms.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted font-medium text-muted-foreground text-xs">
                            @platform.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@platform.Name</span>
                            @if (platform.Status == "importing")
                            {
                                <div class="mt-1.5 flex items-center gap-2">
                                    <ProgressCn Value="@platform.Progress" Class="h-1.5 flex-1" />
                                    <span class="font-mono text-muted-foreground text-xs tabular-nums">@(platform.Progress)%</span>
                                </div>
                            }
                            else
                            {
                                <p class="mt-0.5 text-muted-foreground text-xs">
                                    @(platform.Status == "done" ? "Import complete" : platform.Description)
                                </p>
                            }
                        </div>
                        <div class="shrink-0">
                            @if (platform.Status == "done")
                            {
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 gap-1 px-2 text-muted-foreground text-xs" Disabled="true">
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                    Done
                                </ButtonCn>
                            }
                            else if (platform.Status == "connecting" || platform.Status == "importing")
                            {
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" Disabled="true">
                                    <LucideIconCn Name="loader-2" Size="12" Class="size-3 animate-spin" />
                                </ButtonCn>
                            }
                            else
                            {
                                var pid = platform.Id;
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" @onclick="@(() => HandleConnect(pid))">
                                    Connect
                                </ButtonCn>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs">Skip migration</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Continue</ButtonCn>
        </div>

    </div>
</section>

@code {
    private class Platform
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Initials { get; set; } = "";
        public string Status { get; set; } = "idle";
        public int Progress { get; set; }
    }

    private Platform[] _platforms =
    [
        new() { Id = "asana",  Name = "Asana",  Description = "Import projects, tasks, and assignees",      Initials = "AS", Status = "idle", Progress = 0 },
        new() { Id = "trello", Name = "Trello", Description = "Import boards, lists, and cards",            Initials = "TR", Status = "idle", Progress = 0 },
        new() { Id = "jira",   Name = "Jira",   Description = "Import epics, stories, and sprints",         Initials = "JR", Status = "idle", Progress = 0 },
        new() { Id = "notion", Name = "Notion", Description = "Import pages, databases, and documents",     Initials = "NT", Status = "idle", Progress = 0 },
    ];

    private int _doneCount => _platforms.Count(p => p.Status == "done");

    private async Task HandleConnect(string id)
    {
        var platform = _platforms.FirstOrDefault(p => p.Id == id);
        if (platform is null) return;

        platform.Status = "connecting";
        await InvokeAsync(StateHasChanged);

        await Task.Delay(800);

        platform.Status = "importing";
        platform.Progress = 0;
        await InvokeAsync(StateHasChanged);

        while (platform.Progress < 100)
        {
            await Task.Delay(400);
            platform.Progress = Math.Min(platform.Progress + 20, 100);
            await InvokeAsync(StateHasChanged);
        }

        platform.Status = "done";
        await InvokeAsync(StateHasChanged);
    }
}
