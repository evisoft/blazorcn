@* ========================================
   Block: onboarding-profile-setup
   Title: Onboarding Profile Setup
   Description: Profile setup form with avatar upload, form fields, and validation for user registration flows
   Long Description: Preferences panel with toggle options, category groups, and personalization settings for user customization
   Dependencies: LucideCameraCn, LucideCheckCn, LucideLoader2Cn
   Source: original/blocks/onboarding/onboarding-profile-setup.tsx
   ======================================== *@
<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-md">
        <CardHeaderCn Class="text-center">
            <CardTitleCn>Complete your profile</CardTitleCn>
            <CardDescriptionCn>Help others get to know you better</CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn Class="space-y-6">
            @* Avatar upload *@
            <div class="flex flex-col items-center">
                <div class="relative group">
                    <AvatarCn Class="h-24 w-24">
                        <AvatarFallbackCn Class="text-2xl bg-primary/10 text-primary">
                            @(string.IsNullOrEmpty(_name) ? "?" : _name[0].ToString().ToUpper())
                        </AvatarFallbackCn>
                    </AvatarCn>
                    <button
                        type="button"
                        aria-label="Change profile photo"
                        class="absolute inset-0 flex items-center justify-center rounded-full bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity">
                        <LucideCameraCn Size="24" Class="text-white" />
                    </button>
                </div>
                <button type="button" class="mt-2 text-sm text-primary hover:underline">
                    Upload photo
                </button>
            </div>

            @* Form fields *@
            <div class="space-y-4">
                <div class="space-y-2">
                    <LabelCn For="profile-setup-name">
                        Full name <span class="text-destructive">*</span>
                    </LabelCn>
                    <InputCn
                        id="profile-setup-name"
                        Placeholder="John Doe"
                        Value="@_name"
                        ValueChanged="@((string v) => _name = v)" />
                </div>

                <div class="space-y-2">
                    <LabelCn For="username">
                        Username <span class="text-destructive">*</span>
                    </LabelCn>
                    <div class="flex">
                        <span class="inline-flex items-center px-3 rounded-l-md border border-r-0 bg-muted text-muted-foreground text-sm">
                            @@
                        </span>
                        <InputCn
                            Class="rounded-l-none"
                            id="username"
                            Placeholder="johndoe"
                            Value="@_username"
                            ValueChanged="@((string v) => _username = v)" />
                    </div>
                </div>

                <div class="space-y-2">
                    <LabelCn For="bio">Bio</LabelCn>
                    <TextareaCn
                        id="bio"
                        Placeholder="Tell us about yourself..."
                        Rows="3"
                        Value="@_bio"
                        ValueChanged="@((string v) => _bio = v)" />
                    <p class="text-xs text-muted-foreground">@_bio.Length/160 characters</p>
                </div>

                <div class="space-y-2">
                    <LabelCn For="website">Website</LabelCn>
                    <InputCn
                        id="website"
                        Placeholder="https://yourwebsite.com"
                        type="url"
                        Value="@_website"
                        ValueChanged="@((string v) => _website = v)" />
                </div>
            </div>

            @* Actions *@
            <div class="flex items-center gap-3 pt-2">
                <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline">
                    Skip for now
                </ButtonCn>
                <ButtonCn Class="flex-1" Disabled="@(!IsValid || _saving)">
                    @if (_saving)
                    {
                        <LucideLoaderCircleCn Size="16" Class="mr-2 animate-spin" />
                        <span>Saving...</span>
                    }
                    else if (_saved)
                    {
                        <LucideCheckCn Size="16" Class="mr-2" />
                        <span>Saved!</span>
                    }
                    else
                    {
                        <span>Save &amp; continue</span>
                    }
                </ButtonCn>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private string _name = "";
    private string _username = "";
    private string _bio = "";
    private string _website = "";
    private bool _saving;
    private bool _saved;

    private bool IsValid => !string.IsNullOrWhiteSpace(_name) && !string.IsNullOrWhiteSpace(_username);
}
