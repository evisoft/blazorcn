@* ============================================================
   Block: onboarding-tag-creation
   Title: OnboardingTagCreation
   Description: Tag creation onboarding block for React and Next.js with dynamic input, removable badges, and live count built with TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-tag-creation.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Create tags</span>
                <span class="text-muted-foreground text-xs">@_tags.Count tags</span>
            </div>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Tags help you organize and filter items across your workspace. Add custom tags or keep
                the defaults.
            </p>
        </div>

        @* Input *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <InputCn
                    Value="@_input"
                    ValueChanged="@((string v) => _input = v)"
                    Placeholder="Type a tag name..."
                    Class="h-8 flex-1 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0"
                    @onkeydown="HandleKeyDown" />
                <ButtonCn
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.Sm"
                    Class="h-7 gap-1 shrink-0 text-xs"
                    @onclick="AddTag">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    Add
                </ButtonCn>
            </div>
        </div>

        @* Tags *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap gap-2">
                @foreach (var tag in _tags.ToList())
                {
                    var capturedTag = tag;
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 pr-1 text-xs">
                        @capturedTag
                        <button
                            type="button"
                            @onclick="@(() => RemoveTag(capturedTag))"
                            class="ml-0.5 rounded-sm p-0.5 transition-colors hover:bg-muted-foreground/20">
                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                        </button>
                    </BadgeCn>
                }
                @if (_tags.Count == 0)
                {
                    <span class="text-muted-foreground text-xs">No tags yet. Add one above.</span>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-end px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">Done</ButtonCn>
        </div>

    </div>
</section>

@code {
    private List<string> _tags = ["Design", "Engineering", "Marketing", "Sales", "Support"];
    private string _input = "";

    private void AddTag()
    {
        var trimmed = _input.Trim();
        if (!string.IsNullOrEmpty(trimmed) && !_tags.Contains(trimmed))
        {
            _tags.Add(trimmed);
            _input = "";
        }
    }

    private void RemoveTag(string tag)
    {
        _tags.Remove(tag);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTag();
        }
    }
}
