@* ============================================================
   Block: onboarding-report-schedule
   Title: OnboardingReportSchedule
   Description: A React onboarding scheduled report configuration with frequency select, day-of-week picker, time select, email recipients list, and schedule action built with Next.js, TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-report-schedule.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-bar-chart" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Schedule reports</span>
            </div>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Set up automatic report delivery. Choose when and how often reports are sent to your
                team.
            </p>
        </div>

        @* Frequency *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-4">
                <span class="font-medium text-muted-foreground text-xs">Frequency</span>
                <SelectCn Value="@_frequency" ValueChanged="@((string v) => _frequency = v)">
                    <SelectTriggerCn Class="h-8 w-[140px] text-xs" aria-label="Frequency">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var f in _frequencies)
                        {
                            <SelectItemCn Value="@f.Value" Class="text-xs">@f.Label</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Day picker *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Days</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var day in _days)
                {
                    var dayKey = day.Key;
                    <button
                        type="button"
                        @onclick="@(() => ToggleDay(dayKey))"
                        class="@Cn.Merge("flex h-8 w-12 items-center justify-center rounded-md border text-xs transition-all", _selectedDays.Contains(dayKey) ? "border-foreground/20 bg-foreground/5 font-medium text-foreground ring-1 ring-foreground/10" : "border-border text-muted-foreground hover:bg-muted/50")">
                        @day.Label
                    </button>
                }
            </div>
        </div>

        @* Time *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-4">
                <span class="font-medium text-muted-foreground text-xs">Time</span>
                <SelectCn Value="@_time" ValueChanged="@((string v) => _time = v)">
                    <SelectTriggerCn Class="h-8 w-[140px] text-xs" aria-label="Time">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var slot in _timeSlots)
                        {
                            var slotVal = slot;
                            <SelectItemCn Value="@slotVal" Class="text-xs">@slotVal</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Recipients *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Recipients</span>
            <div class="space-y-1.5">
                @foreach (var email in _recipients.ToArray())
                {
                    var recipientEmail = email;
                    <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2">
                        <span class="font-mono text-xs">@recipientEmail</span>
                        <button
                            type="button"
                            aria-label="Remove @recipientEmail"
                            @onclick="@(() => RemoveRecipient(recipientEmail))"
                            class="rounded-sm p-0.5 text-muted-foreground transition-colors hover:text-foreground">
                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                        </button>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-end px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">Schedule Report</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record FrequencyOption(string Value, string Label);
    private record DayOption(string Key, string Label);

    private static readonly FrequencyOption[] _frequencies =
    [
        new("daily", "Daily"),
        new("weekly", "Weekly"),
        new("monthly", "Monthly"),
    ];

    private static readonly DayOption[] _days =
    [
        new("mon", "Mon"),
        new("tue", "Tue"),
        new("wed", "Wed"),
        new("thu", "Thu"),
        new("fri", "Fri"),
    ];

    private static readonly string[] _timeSlots = ["08:00", "09:00", "10:00", "12:00", "14:00", "17:00"];

    private string _frequency = "weekly";
    private HashSet<string> _selectedDays = ["mon", "wed", "fri"];
    private string _time = "09:00";
    private List<string> _recipients = ["alice@acme.com", "bob@acme.com"];

    private void ToggleDay(string key)
    {
        if (_selectedDays.Contains(key))
            _selectedDays.Remove(key);
        else
            _selectedDays.Add(key);
    }

    private void RemoveRecipient(string email)
    {
        _recipients.Remove(email);
    }
}
