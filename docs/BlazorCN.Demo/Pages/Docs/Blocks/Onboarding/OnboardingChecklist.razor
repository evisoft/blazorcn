<svg
      aria-label="Progress indicator"
      class="-rotate-90"
      height="14"
      role="img"
      viewBox="0 0 14 14"
      width="14"
    >
      <circle class="stroke-muted" cx="7" cy="7" fill="none" r="6" strokeWidth="2" ></circle>
      <circle
        class="stroke-primary transition-all"
        cx="7"
        cy="7"
        fill="none"
        r="6"
        strokeDasharray={$"{progress * 0.377} 100"}
        strokeLinecap="round"
        strokeWidth="2"
      />
    </svg>
  
@code {
    private readonly int _year = DateTime.Now.Year;

    private record StepItem(string Id, string Title, string Description, string Completed, string ActionLabel);

    private readonly StepItem[] _steps =
    [
        new("document", "Send your first document", "Upload a PDF and send it for signature. You'll see how easy it is to get documents signed.", "#", "Upload document"),
        new("template", "Create a reusable template", "Save time by creating templates for documents you send frequently, like NDAs or contracts.", "#", "Create template"),
        new("team", "Invite your team", "Add team members to collaborate on documents and manage signing workflows together.", "#", "Invite team"),
        new("branding", "Customize your branding", "Add your logo and brand colors to create a professional signing experience for recipients.", "#", "Add branding"),
        new("api", "Explore the API", "Integrate document signing directly into your application with our developer-friendly API.", "#", "View API docs"),
        new("integrations", "Connect your tools", "Link with Zapier, Slack, or your CRM to automate your document workflows.", "#", "Browse integrations"),
    ];
}
