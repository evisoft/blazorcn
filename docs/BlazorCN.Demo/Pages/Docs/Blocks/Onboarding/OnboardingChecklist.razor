@* ========================================
   Block: onboarding-checklist
   Title: Onboarding Checklist
   Description: Expandable checklist with progress indicator, step descriptions, and action buttons for guided setup flows
   Dependencies: ProgressCn, ButtonCn, LucideCheckCn, LucideChevronRightCn
   Source: original/blocks/onboarding/onboarding-checklist.tsx
   ======================================== *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-sm font-medium">Setup checklist</span>
                <span class="text-xs text-muted-foreground">@CompletedCount of @_steps.Length complete</span>
            </div>
            <div class="mt-2">
                <ProgressCn Value="ProgressValue" Class="h-1" />
            </div>
        </div>

        <div>
            @for (var i = 0; i < _steps.Length; i++)
            {
                var step = _steps[i];
                var isExpanded = _expanded == step.Id;
                <div class="@(i == _steps.Length - 1 ? null : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            aria-expanded="@(isExpanded ? "true" : "false")"
                            @onclick="() => ToggleExpanded(step.Id)">
                        <span class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded-full border", step.Completed ? "border-emerald-500 bg-emerald-500 text-white" : "border-muted-foreground/30")">
                            @if (step.Completed)
                            {
                                <LucideCheckCn Class="size-3" />
                            }
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="@Cn.Merge("text-sm font-medium", step.Completed ? "text-muted-foreground line-through" : null)">@step.Title</span>
                        </div>
                        <LucideChevronRightCn Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : null)" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-12">
                            <p class="text-sm leading-relaxed text-muted-foreground">@step.Description</p>
                            <div class="mt-2.5 flex items-center gap-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="() => ToggleStep(step.Id)">
                                    @(step.Completed ? "Mark incomplete" : "Mark complete")
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">@step.ActionLabel</ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">Complete all steps to finish setup</span>
        </div>
    </div>
</section>

@code {
    private sealed class StepItem
    {
        public required string Id { get; init; }
        public required string Title { get; init; }
        public required string Description { get; init; }
        public required string ActionLabel { get; init; }
        public bool Completed { get; set; }
    }

    private readonly StepItem[] _steps =
    [
        new() { Id = "profile", Title = "Complete your profile", Description = "Add your display name, avatar, and role so your team can identify you across the workspace.", ActionLabel = "Edit profile", Completed = true },
        new() { Id = "workspace", Title = "Configure workspace settings", Description = "Set your workspace name, timezone, and default notification preferences for all members.", ActionLabel = "Open settings" },
        new() { Id = "invite", Title = "Invite your team members", Description = "Send email invitations to colleagues who will collaborate with you on projects and documents.", ActionLabel = "Send invites" },
        new() { Id = "integration", Title = "Connect an integration", Description = "Link tools like Slack, GitHub, or Linear to receive notifications and sync data automatically.", ActionLabel = "Browse integrations" },
        new() { Id = "project", Title = "Create your first project", Description = "Start a new project to organize tasks, documents, and conversations in one place.", ActionLabel = "New project" },
    ];

    private string? _expanded = "workspace";

    private int CompletedCount => _steps.Count(s => s.Completed);

    private double ProgressValue => (double)CompletedCount / _steps.Length * 100;

    private void ToggleExpanded(string id) => _expanded = _expanded == id ? null : id;

    private void ToggleStep(string id)
    {
        var step = _steps.First(s => s.Id == id);
        step.Completed = !step.Completed;
    }
}
