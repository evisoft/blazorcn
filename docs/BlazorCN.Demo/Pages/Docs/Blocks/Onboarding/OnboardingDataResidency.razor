@* ============================================================
   Block: onboarding-data-residency
   Title: OnboardingDataResidency
   Description: A React data residency onboarding block for Next.js with region selection, latency display, and compliance notes. Built with TypeScript, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-data-residency.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="database" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Data Residency</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Choose where your data is stored. This affects latency and compliance with regional
                data protection regulations.
            </p>
        </div>

        @* Region Options *@
        <div>
            @foreach (var region in _regions)
            {
                var isLast = region.Id == _regions[^1].Id;
                var isSelected = _selected == region.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _selected = region.Id)"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isSelected ? "bg-muted/30" : "")">
                        <span class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-md font-mono font-medium text-xs", isSelected ? "bg-foreground text-background ring-2 ring-foreground ring-offset-2 ring-offset-card" : "bg-muted/50 text-muted-foreground")">
                            @region.Flag
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@region.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@region.Location</p>
                        </div>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs">
                            @region.Latency
                        </span>
                    </button>
                </div>
            }
        </div>

        @* Compliance note *@
        <div class="border-t px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-muted-foreground text-xs leading-relaxed">
                    Your data will be stored exclusively in the selected region. This choice cannot be
                    changed after provisioning without contacting support. Ensure your selection complies
                    with your organization's data residency requirements.
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-end px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">Confirm Region</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Region(string Id, string Flag, string Name, string Location, string Latency);

    private static readonly Region[] _regions =
    [
        new("us-east",     "US", "US East",      "Virginia, United States", "~12ms"),
        new("eu-west",     "EU", "EU West",       "Frankfurt, Germany",      "~18ms"),
        new("ap-southeast","AP", "Asia Pacific",  "Singapore",               "~45ms"),
        new("au-east",     "AU", "Australia",     "Sydney, Australia",       "~62ms"),
    ];

    private string _selected = "us-east";
}
