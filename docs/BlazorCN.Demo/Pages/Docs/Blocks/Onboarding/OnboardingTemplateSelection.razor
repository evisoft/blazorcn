@* ========================================
   Block: onboarding-template-selection
   Title: Onboarding Template Selection
   Description: Template selection with preview cards, category filters, and popular badges for quick project starts
   Long Description: Team invite form with email input, role selector, and pending invites list for collaboration setup
   Dependencies: LucideArrowRightCn, LucideCheckCn, LucideFileTextCn, LucideLayoutCn, LucideLineChartCn, LucideMessageSquareCn, LucideSparklesCn, LucideUsersCn
   Source: original/blocks/onboarding/onboarding-template-selection.tsx
   ======================================== *@
<div class="flex items-center justify-center p-10 w-full">
    <div class="w-full max-w-2xl">
        @* Header *@
        <div class="text-center mb-6">
            <h2 class="text-2xl font-semibold text-foreground">Choose a template</h2>
            <p class="text-muted-foreground mt-1">
                Start with a pre-built template or begin from scratch
            </p>
        </div>

        @* Category filters *@
        <div class="flex flex-wrap justify-center gap-2 mb-6">
            @foreach (var category in _categories)
            {
                var cat = category;
                <ButtonCn
                    Size="ButtonSize.Sm"
                    Variant="@(_selectedCategory == cat ? ButtonVariant.Default : ButtonVariant.Outline)"
                    @onclick="@(() => _selectedCategory = cat)">
                    @cat
                </ButtonCn>
            }
        </div>

        @* Template grid *@
        <div class="grid grid-cols-2 gap-3 mb-6">
            @foreach (var template in FilteredTemplates)
            {
                var t = template;
                var isSelected = _selectedTemplate == t.Id;

                <CardCn
                    Class="@(Cn.Merge("cursor-pointer transition-all hover:border-primary/50", isSelected ? "border-primary ring-1 ring-primary" : ""))"
                    @onclick="@(() => _selectedTemplate = t.Id)">
                    <CardContentCn Class="p-4">
                        <div class="flex items-start justify-between mb-3">
                            <div class="@(Cn.Merge("flex h-10 w-10 items-center justify-center rounded-lg transition-colors", isSelected ? "bg-primary text-primary-foreground" : "bg-muted text-muted-foreground"))">
                                @if (isSelected)
                                {
                                    <LucideCheckCn Size="20" />
                                }
                                else
                                {
                                    <LucideLayoutCn Size="20" />
                                }
                            </div>
                            @if (t.Popular)
                            {
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                    Popular
                                </BadgeCn>
                            }
                        </div>
                        <h3 class="font-medium text-foreground">@t.Name</h3>
                        <p class="text-xs text-muted-foreground mt-1">@t.Description</p>
                    </CardContentCn>
                </CardCn>
            }
        </div>

        @* Actions *@
        <div class="flex items-center justify-between">
            <ButtonCn Variant="ButtonVariant.Ghost">Skip</ButtonCn>
            <ButtonCn Disabled="@(string.IsNullOrEmpty(_selectedTemplate))">
                Use template
                <LucideArrowRightCn Size="16" Class="ml-2" />
            </ButtonCn>
        </div>
    </div>
</div>

@code {
    private record TemplateItem(string Id, string Name, string Description, string Category, bool Popular = false);

    private string _selectedCategory = "All";
    private string? _selectedTemplate;

    private IEnumerable<TemplateItem> FilteredTemplates =>
        _selectedCategory == "All"
            ? _templates
            : _templates.Where(t => t.Category == _selectedCategory);

    private static readonly string[] _categories = ["All", "Marketing", "Dashboard", "Documentation", "Community"];

    private static readonly TemplateItem[] _templates =
    [
        new("landing", "Landing Page", "Hero, features, testimonials, and CTA sections", "Marketing", true),
        new("dashboard", "Analytics Dashboard", "Charts, metrics, and data visualization", "Dashboard", true),
        new("docs", "Documentation", "Sidebar navigation with markdown content", "Documentation"),
        new("community", "Community Forum", "Discussions, threads, and user profiles", "Community"),
        new("team", "Team Directory", "Member profiles and org chart", "Dashboard"),
        new("blank", "Blank Canvas", "Start from scratch with minimal setup", "All"),
    ];
}
