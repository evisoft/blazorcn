@* ============================================================
   Block: onboarding-backup-config
   Title: OnboardingBackupConfig
   Description: Backup configuration onboarding for React and Next.js with frequency select, retention period select, auto-backup toggle switch, and last backup timestamp. Built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-backup-config.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="database" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Backup Configuration</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Set up automated backups to protect your data. Choose how often to back up and how
                long to keep snapshots.
            </p>
        </div>

        @* Frequency select *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Backup frequency
            </span>
            <SelectCn Value="@_frequency" ValueChanged="@((string? v) => SetFrequency(v))">
                <SelectTriggerCn Class="h-8 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var opt in _frequencyOptions)
                    {
                        var item = opt;
                        <SelectItemCn Value="@item.Value" Class="text-xs">@item.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Retention select *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Retention period
            </span>
            <SelectCn Value="@_retention" ValueChanged="@((string? v) => SetRetention(v))">
                <SelectTriggerCn Class="h-8 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var opt in _retentionOptions)
                    {
                        var item = opt;
                        <SelectItemCn Value="@item.Value" Class="text-xs">@item.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Auto-backup toggle *@
        <div class="border-b">
            <label for="auto-backup" class="flex cursor-pointer items-center justify-between gap-4 px-4 py-3 transition-colors hover:bg-muted/50">
                <div class="min-w-0">
                    <span class="font-medium text-sm">Auto-backup</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Automatically run backups on the selected schedule
                    </p>
                </div>
                <SwitchCn id="auto-backup" Checked="@_autoBackup" CheckedChanged="@((bool v) => _autoBackup = v)" />
            </label>
        </div>

        @* Last backup *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Last backup</span>
                <span class="font-mono text-muted-foreground text-xs">No backups yet</span>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-end px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">Enable Backups</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record SelectOption(string Value, string Label);

    private static readonly SelectOption[] _frequencyOptions =
    [
        new("hourly", "Hourly"),
        new("daily", "Daily"),
        new("weekly", "Weekly"),
    ];

    private static readonly SelectOption[] _retentionOptions =
    [
        new("7", "7 days"),
        new("30", "30 days"),
        new("90", "90 days"),
    ];

    private string _frequency = "daily";
    private string _retention = "30";
    private bool _autoBackup = true;

    private void SetFrequency(string? v) => _frequency = v ?? _frequency;
    private void SetRetention(string? v) => _retention = v ?? _retention;
}
