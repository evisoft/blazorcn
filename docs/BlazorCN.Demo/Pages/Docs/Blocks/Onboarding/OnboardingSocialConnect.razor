@* ============================================================
   Block: onboarding-social-connect
   Title: OnboardingSocialConnect
   Description: Social account connection onboarding with Twitter, LinkedIn, GitHub, website platform rows, connect/connected toggle buttons, and skip/continue footer built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-social-connect.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="link" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Connect Accounts</span>
            <span class="ml-auto text-muted-foreground text-xs tabular-nums">
                @_connected.Count/@_platforms.Length connected
            </span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-3">
            <p class="text-muted-foreground text-sm">
                Link your social accounts to enrich your profile and help teammates find you.
            </p>
        </div>

        @* Platform rows *@
        <div>
            @foreach (var platform in _platforms)
            {
                var isConnected = _connected.Contains(platform.Id);
                var isLast = platform.Id == _platforms[_platforms.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <LucideIconCn Name="@platform.Icon" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <span class="min-w-0 flex-1 font-medium text-sm">@platform.Label</span>
                        <ButtonCn Variant="@(isConnected ? ButtonVariant.Ghost : ButtonVariant.Outline)"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 gap-1 text-xs"
                                  OnClick="@(() => Toggle(platform.Id))">
                            @if (isConnected)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                                <span>Connected</span>
                            }
                            else
                            {
                                <span>Connect</span>
                            }
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">
                Skip
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                Continue
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record PlatformItem(string Id, string Label, string Icon);

    private static readonly PlatformItem[] _platforms =
    [
        new("twitter",  "Twitter / X",       "twitter"),
        new("linkedin", "LinkedIn",           "linkedin"),
        new("github",   "GitHub",             "github"),
        new("website",  "Personal Website",   "globe"),
    ];

    private readonly HashSet<string> _connected = [];

    private void Toggle(string id)
    {
        if (!_connected.Add(id))
            _connected.Remove(id);
    }
}
