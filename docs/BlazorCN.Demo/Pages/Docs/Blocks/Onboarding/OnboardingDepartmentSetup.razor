@* ============================================================
   Block: onboarding-department-setup
   Title: OnboardingDepartmentSetup
   Description: A React department setup onboarding block for Next.js with add/edit/delete actions and member count badges. Built with TypeScript, shadcn/ui Badge, Button, and Input, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-department-setup.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="building" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Set up departments</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Create departments to organize your team members.
            </p>
        </div>

        @* Add department input *@
        <div class="border-b px-4 py-3">
            <label for="dept-name" class="mb-1.5 block font-medium text-muted-foreground text-xs">
                Department name
            </label>
            <div class="flex items-center gap-2">
                <InputCn
                    Id="dept-name"
                    Value="@_name"
                    ValueChanged="@((string v) => _name = v)"
                    Placeholder="@("e.g. Operations")"
                    Class="h-8 flex-1 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0"
                    @onkeydown="HandleKeyDown" />
                <ButtonCn
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.Sm"
                    Class="h-7 gap-1 px-2 text-xs"
                    @onclick="HandleAdd"
                    Disabled="@(string.IsNullOrWhiteSpace(_name))">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    Add
                </ButtonCn>
            </div>
        </div>

        @* Department rows *@
        <div>
            @foreach (var dept in _departments)
            {
                var deptItem = dept;
                var isLast = _departments.IndexOf(deptItem) == _departments.Count - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@deptItem.Name</span>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs font-normal">
                            @deptItem.Members @(deptItem.Members == 1 ? "member" : "members")
                        </BadgeCn>
                        <ButtonCn
                            Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Sm"
                            Class="size-6 shrink-0 p-0"
                            aria-label="@($"Edit {deptItem.Name}")">
                            <LucideIconCn Name="pencil" Size="12" Class="size-3 text-muted-foreground" />
                        </ButtonCn>
                        <ButtonCn
                            Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Sm"
                            Class="size-6 shrink-0 p-0"
                            @onclick="@(() => HandleRemove(deptItem.Id))"
                            aria-label="@($"Delete {deptItem.Name}")">
                            <LucideIconCn Name="trash" Size="12" Class="size-3 text-muted-foreground" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_departments.Count department@(_departments.Count != 1 ? "s" : "")
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Save Departments
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Department(string Id, string Name, int Members);

    private int _nextId = 4;

    private List<Department> _departments =
    [
        new("eng", "Engineering", 12),
        new("design", "Design", 5),
        new("product", "Product", 4),
    ];

    private string _name = "";

    private void HandleAdd()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        var id = $"dept-{_nextId++}";
        _departments.Add(new(id, _name.Trim(), 0));
        _name = "";
    }

    private void HandleRemove(string id)
    {
        _departments.RemoveAll(d => d.Id == id);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            HandleAdd();
        }
    }
}
