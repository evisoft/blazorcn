@* ============================================================
   Block: onboarding-terms-consent
   Title: OnboardingTermsConsent
   Description: Terms acceptance onboarding block for React and Next.js with consent checkboxes, read links, and conditional agree button built with TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-terms-consent.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Terms &amp; consent</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Please review and accept the following agreements before continuing. Items marked with
                an asterisk are required.
            </p>
        </div>

        @* Consent items *@
        <div>
            @foreach (var item in _consentItems)
            {
                var isLast = item.Id == _consentItems[_consentItems.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <label for="@item.Id" class="flex cursor-pointer items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <CheckboxCn Id="@item.Id"
                                    Checked="@_checked[item.Id]"
                                    CheckedChanged="@(() => HandleToggle(item.Id))"
                                    Class="mt-0.5" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-1.5">
                                <span class="font-medium text-sm">@item.Label</span>
                                @if (item.Required)
                                {
                                    <span class="text-red-500 text-xs">*</span>
                                }
                                else
                                {
                                    <span class="text-muted-foreground text-xs">Optional</span>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                            <a href="@item.Href"
                               class="mt-1 inline-block font-medium text-foreground text-xs underline underline-offset-2 hover:no-underline">
                                Read
                            </a>
                        </div>
                    </label>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" Disabled="@(!_allRequiredChecked)">
                    I Agree &amp; Continue
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private class ConsentItem
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
        public string Href { get; set; } = "";
        public bool Required { get; set; }
    }

    private static readonly ConsentItem[] _consentItems =
    [
        new() { Id = "terms",     Label = "Terms of Service",  Description = "You agree to our terms governing use of the platform and services.",           Href = "#terms",     Required = true  },
        new() { Id = "privacy",   Label = "Privacy Policy",    Description = "You acknowledge how we collect, use, and protect your personal data.",           Href = "#privacy",   Required = true  },
        new() { Id = "marketing", Label = "Marketing emails",  Description = "Receive product updates, tips, and promotional offers. Unsubscribe anytime.",   Href = "#marketing", Required = false },
    ];

    private readonly Dictionary<string, bool> _checked = new()
    {
        ["terms"]     = false,
        ["privacy"]   = false,
        ["marketing"] = false,
    };

    private bool _allRequiredChecked =>
        _consentItems
            .Where(item => item.Required)
            .All(item => _checked[item.Id]);

    private void HandleToggle(string id)
    {
        if (_checked.ContainsKey(id))
            _checked[id] = !_checked[id];
    }
}
