@* ========================================
   Block: onboarding-use-case
   Title: Onboarding Use Case
   Description: Use case selection with option cards, icons, and multi-select support for experience personalization
   Long Description: Interactive tour with spotlight highlights, step tooltips, and guided walkthrough for feature education
   Dependencies: LucideCheckCn, LucideCodeCn, LucideGraduationCapCn, LucideHeartCn, LucideRocketCn, LucideUsersCn
   Source: original/blocks/onboarding/onboarding-use-case.tsx
   ======================================== *@

<div class="flex items-center justify-center p-10 w-full">
    <div class="w-full max-w-lg">
        @* Header *@
        <div class="text-center mb-8">
            <h2 class="text-2xl font-semibold text-foreground">How will you use Acme?</h2>
            <p class="text-muted-foreground mt-2">
                Select all that apply. We'll customize your experience.
            </p>
        </div>

        @* Options grid *@
        <div class="grid grid-cols-2 gap-3 mb-8">
            @foreach (var useCase in _useCases)
            {
                var uc = useCase;
                var isSelected = _selected.Contains(uc.Id);

                <CardCn
                    Class="@(Cn.Merge("cursor-pointer transition-all hover:border-primary/50", isSelected ? "border-primary ring-1 ring-primary" : ""))"
                    @onclick="@(() => ToggleSelection(uc.Id))">
                    <CardContentCn Class="p-4">
                        <div class="flex items-start gap-3">
                            <div class="@(Cn.Merge("flex h-10 w-10 shrink-0 items-center justify-center rounded-lg transition-colors", isSelected ? "bg-primary text-primary-foreground" : "bg-muted text-muted-foreground"))">
                                @if (isSelected)
                                {
                                    <LucideCheckCn Size="20" />
                                }
                                else
                                {
                                    <LucideRocketCn Size="20" />
                                }
                            </div>
                            <div>
                                <h3 class="font-medium text-foreground">@uc.Title</h3>
                                <p class="text-xs text-muted-foreground mt-0.5">@uc.Description</p>
                            </div>
                        </div>
                    </CardContentCn>
                </CardCn>
            }
        </div>

        @* Selection count *@
        @if (_selected.Count > 0)
        {
            <p class="text-center text-sm text-muted-foreground mb-4">
                @_selected.Count selected
            </p>
        }

        @* Actions *@
        <div class="flex items-center gap-3">
            <ButtonCn Class="flex-1" Variant="ButtonVariant.Outline">
                Skip
            </ButtonCn>
            <ButtonCn Class="flex-1" Disabled="@(_selected.Count == 0)">
                Continue
            </ButtonCn>
        </div>
    </div>
</div>

@code {
    private record UseCaseItem(string Id, string Title, string Description);

    private readonly HashSet<string> _selected = new();

    private void ToggleSelection(string id)
    {
        if (!_selected.Remove(id))
            _selected.Add(id);
    }

    private static readonly UseCaseItem[] _useCases =
    [
        new("startup", "Startup", "Building a new product or company"),
        new("enterprise", "Enterprise", "Large organization with teams"),
        new("agency", "Agency", "Managing multiple clients"),
        new("developer", "Developer", "Building apps and integrations"),
        new("education", "Education", "Teaching or learning"),
        new("personal", "Personal", "Individual projects and tasks"),
    ];
}
