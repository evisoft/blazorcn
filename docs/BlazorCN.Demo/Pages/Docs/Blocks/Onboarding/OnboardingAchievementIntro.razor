@* ============================================================
   Block: onboarding-achievement-intro
   Title: OnboardingAchievementIntro
   Description: React achievements introduction onboarding block with sample badges, locked and unlocked states, progress counter, and start earning action. Built with Next.js, shadcn/ui Button, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-achievement-intro.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Header *@
    <div class="border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="trophy" Size="16" Class="size-4 text-muted-foreground" />
        <span class="text-sm font-medium">Earn achievements as you go</span>
      </div>
      <p class="mt-1 text-xs text-muted-foreground">
        Complete milestones to unlock badges and track your progress
      </p>
    </div>

    @* Achievement rows *@
    <div class="border-b">
      @foreach (var achievement in _achievements)
      {
        var isLast = achievement.Id == _achievements[_achievements.Length - 1].Id;
        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "", achievement.Unlocked ? "" : "opacity-60")">
          <span class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-md", achievement.Unlocked ? "bg-foreground/10 text-foreground" : "bg-muted/50 text-muted-foreground")"
                aria-hidden="true">
            <LucideIconCn Name="@achievement.IconName" Size="16" Class="size-4" />
          </span>
          <div class="min-w-0 flex-1">
            <span class="text-sm font-medium">@achievement.Title</span>
            <p class="mt-0.5 text-xs text-muted-foreground">@achievement.Description</p>
          </div>
          <span aria-hidden="true">
            @if (achievement.Unlocked)
            {
              <LucideIconCn Name="unlock" Size="14" Class="size-3.5 text-emerald-500" />
            }
            else
            {
              <LucideIconCn Name="lock" Size="14" Class="size-3.5 text-muted-foreground/40" />
            }
          </span>
        </div>
      }
    </div>

    @* Progress + CTA *@
    <div class="flex items-center justify-between px-4 py-2.5">
      <span class="text-xs text-muted-foreground">
        @_unlockedCount of @_totalAchievements unlocked
      </span>
      <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
        Start Earning
      </ButtonCn>
    </div>

  </div>
</section>

@code {
    private record Achievement(string Id, string Title, string Description, bool Unlocked, string IconName);

    private static readonly Achievement[] _achievements =
    [
        new("first-project", "First project", "Create your first project and start building", false, "folder"),
        new("team-player", "Team player", "Invite a teammate to collaborate on a project", false, "users"),
        new("power-user", "Power user", "Use 5 different features in a single session", false, "zap"),
    ];

    private static readonly int _totalAchievements = 12;
    private static readonly int _unlockedCount = _achievements.Where(a => a.Unlocked).Count();
}
