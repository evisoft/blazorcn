@* ============================================================
   Block: onboarding-certification
   Title: OnboardingCertification
   Description: A React certification enrollment block with three skill tiers and selection states. Built with Next.js, TypeScript, shadcn/ui Badge and Button, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-certification.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="award" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Earn a certification</span>
            </div>
            <p class="mt-1 text-xs text-muted-foreground">
                Choose a track to validate your skills and unlock your certificate
            </p>
        </div>

        @* Certification options *@
        <div class="border-b">
            @foreach (var cert in _certifications)
            {
                var item = cert;
                var isSelected = _selected == item.Id;
                var isLast = item.Id == _certifications[_certifications.Length - 1].Id;
                <button type="button"
                        @onclick="@(() => _selected = item.Id)"
                        aria-pressed="@isSelected.ToString().ToLowerInvariant()"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", isSelected ? "bg-muted/30 ring-1 ring-inset ring-foreground/10" : "")">
                    <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50 text-muted-foreground"
                          aria-hidden="true">
                        <LucideIconCn Name="@item.IconName" Size="16" Class="size-4" />
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-medium">@item.Title</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@item.Tier</BadgeCn>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">@item.Description</p>
                    </div>
                    <span class="shrink-0 text-xs text-muted-foreground">@item.TimeEstimate</span>
                </button>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @if (_selected is not null)
                {
                    var found = Array.Find(_certifications, c => c.Id == _selected);
                    @(found is not null ? $"{found.TimeEstimate} to complete" : "Select a track")
                }
                else
                {
                    @("Select a track")
                }
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" Disabled="@(_selected is null)">
                Enroll
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Certification(string Id, string Title, string Description, string TimeEstimate, string Tier, string IconName);

    private string? _selected = null;

    private static readonly Certification[] _certifications =
    [
        new("fundamentals", "Fundamentals", "Core concepts, basic workflows, and essential features to get certified", "4 hours", "Beginner", "shield"),
        new("advanced", "Advanced", "Deep dives into integrations, automation, and performance optimization", "12 hours", "Intermediate", "star"),
        new("expert", "Expert", "Architecture design, custom extensions, and enterprise-scale deployment", "24 hours", "Senior", "zap"),
    ];
}
