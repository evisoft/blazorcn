@* ========================================
   Block: onboarding-content-personalization
   Title: Onboarding Content Personalization
   Description: Content personalization with topic grid, interest tags, and recommendation preview for tailored feeds
   Long Description: Completion celebration with success animation, achievement stats, and next step suggestions
   Dependencies: LucideCheckCn, LucideLightbulbCn, LucideSparklesCn
   Source: original/blocks/onboarding/onboarding-content-personalization.tsx
   ======================================== *@
<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-lg">
        <CardHeaderCn Class="text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-primary/10">
                <LucideLightbulbCn Size="24" Class="text-primary" />
            </div>
            <CardTitleCn>What interests you?</CardTitleCn>
            <CardDescriptionCn>
                Select topics to personalize your feed. Choose at least 3.
            </CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn Class="space-y-6">
            @* Topic grid *@
            <div class="grid grid-cols-3 gap-2">
                @foreach (var topic in _topics)
                {
                    var isSelected = _selectedTopics.Contains(topic.Id);
                    <button type="button" @onclick="() => ToggleTopic(topic.Id)"
                            class="@Cn.Merge("flex flex-col items-center gap-2 p-3 rounded-lg border transition-all", isSelected ? "border-primary bg-primary/5 text-primary" : "hover:border-primary/50 text-muted-foreground hover:text-foreground")">
                        <div class="@Cn.Merge("flex h-10 w-10 items-center justify-center rounded-full transition-colors", isSelected ? "bg-primary text-primary-foreground" : "bg-muted")">
                            @if (isSelected)
                            {
                                <LucideCheckCn Size="20" />
                            }
                            else
                            {
                                <LucideSparklesCn Size="20" />
                            }
                        </div>
                        <span class="text-xs font-medium">@topic.Name</span>
                    </button>
                }
            </div>

            @* Selected tags *@
            @if (_selectedTopics.Count > 0)
            {
                <div class="space-y-2">
                    <p class="text-sm text-muted-foreground">Selected topics:</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var topicId in _selectedTopics)
                        {
                            var topic = _topics.FirstOrDefault(t => t.Id == topicId);
                            if (topic is not null)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary">@topic.Name</BadgeCn>
                            }
                        }
                    </div>
                </div>
            }

            @* Preview *@
            <div class="p-4 rounded-lg border bg-muted/30">
                <div class="flex items-center gap-2 mb-3">
                    <LucideSparklesCn Size="16" Class="text-primary" />
                    <span class="text-sm font-medium text-foreground">
                        Your personalized feed preview
                    </span>
                </div>
                <div class="space-y-2">
                    @if (_selectedTopics.Count == 0)
                    {
                        <p class="text-sm text-muted-foreground text-center py-2">
                            Select topics to see preview
                        </p>
                    }
                    else
                    {
                        @foreach (var topicId in _selectedTopics.Take(3))
                        {
                            <div class="flex items-center gap-3 p-2 rounded bg-background border">
                                <div class="h-8 w-8 rounded bg-muted flex items-center justify-center">
                                    <LucideSparklesCn Size="16" />
                                </div>
                                <div class="flex-1">
                                    <div class="h-2 w-24 bg-muted rounded"></div>
                                    <div class="h-2 w-16 bg-muted/50 rounded mt-1"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            @* Actions *@
            <div class="flex items-center justify-between pt-4 border-t">
                <ButtonCn Variant="ButtonVariant.Ghost">Skip</ButtonCn>
                <ButtonCn Disabled="@(_selectedTopics.Count < 3)">
                    @(_selectedTopics.Count < 3 ? $"Select {3 - _selectedTopics.Count} more" : "Continue")
                </ButtonCn>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private readonly int _year = DateTime.Now.Year;

    private readonly HashSet<string> _selectedTopics = new();

    private void ToggleTopic(string id)
    {
        if (!_selectedTopics.Remove(id))
            _selectedTopics.Add(id);
    }

    private record TopicInfo(string Id, string Name);

    private readonly TopicInfo[] _topics =
    [
        new("tech", "Technology"), new("business", "Business"), new("design", "Design"),
        new("health", "Health"), new("fitness", "Fitness"), new("travel", "Travel"),
        new("food", "Food"), new("music", "Music"), new("movies", "Movies"),
        new("gaming", "Gaming"), new("books", "Books"), new("finance", "Finance"),
    ];
}
