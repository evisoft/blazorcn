@* ============================================================
   Block: onboarding-role-selection
   Title: OnboardingRoleSelection
   Description: A React onboarding role picker with five selectable role options, icon and description per role, single-select dot indicator with ring highlight, and disabled continue button built with Next.js, TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-role-selection.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">What's your role?</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                This helps us personalize your experience
            </p>
        </div>

        @* Role options *@
        <div>
            @foreach (var role in _roles)
            {
                var r = role;
                var isSelected = _selectedRole == r.Id;
                var isLast = r.Id == _roles[_roles.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _selectedRole = r.Id)"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isSelected ? "ring-2 ring-inset ring-foreground" : "")">
                        <LucideIconCn Name="@r.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@r.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@r.Description</p>
                        </div>
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full transition-colors", isSelected ? "bg-foreground" : "bg-muted")" />
                    </button>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Step 1 of 3</span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" Disabled="@(_selectedRole == null)">
                Continue
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record RoleItem(string Id, string Label, string Description, string IconName);

    private string? _selectedRole = null;

    private static readonly RoleItem[] _roles =
    [
        new("developer", "Developer", "Building features, writing code, and shipping products", "code"),
        new("designer", "Designer", "Crafting interfaces, prototyping, and design systems", "brush"),
        new("product-manager", "Product Manager", "Defining roadmaps, prioritizing features, and coordinating teams", "package"),
        new("marketing", "Marketing", "Growing audience, running campaigns, and analyzing metrics", "megaphone"),
        new("founder", "Founder", "Leading vision, strategy, and cross-functional execution", "rocket"),
    ];
}
