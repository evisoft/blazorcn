@* ============================================================
   Block: onboarding-branch-strategy
   Title: OnboardingBranchStrategy
   Description: Git branch strategy selection onboarding for React and Next.js with three strategy options, diagram descriptions, pros lists, and single-select ring highlight. Built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-branch-strategy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="git-branch" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Choose Branch Strategy</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Select a branching model for your repositories
            </p>
        </div>

        @* Strategy rows *@
        <div>
            @foreach (var strategy in _strategies)
            {
                var strat = strategy;
                var isSelected = _selectedId == strat.Id;
                var isLast = strat.Id == _strategies[_strategies.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _selectedId = strat.Id)"
                        class="@Cn.Merge("w-full px-4 py-3 text-left transition-all", isSelected ? "ring-2 ring-inset ring-foreground bg-muted/30" : "hover:bg-muted/50")">
                        <div class="flex items-center gap-3">
                            <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full border transition-colors", isSelected ? "border-foreground bg-foreground text-background" : "border-muted-foreground/30")">
                                @if (isSelected)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@strat.Name</span>
                                <p class="mt-0.5 font-mono text-muted-foreground text-xs">@strat.Description</p>
                            </div>
                        </div>
                        <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 pl-11">
                            @foreach (var pro in strat.Pros)
                            {
                                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                    <span class="size-1 shrink-0 rounded-full bg-muted-foreground/50" aria-hidden="true"></span>
                                    @pro
                                </span>
                            }
                        </div>
                    </button>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Can be changed per repository later</span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Apply Strategy
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Strategy(string Id, string Name, string Description, string[] Pros);

    private string _selectedId = "github-flow";

    private static readonly Strategy[] _strategies =
    [
        new("git-flow", "Git Flow", "main → develop → feature branches → release branches → hotfix branches",
            ["Structured release cycles", "Parallel development tracks", "Clear hotfix path"]),
        new("github-flow", "GitHub Flow", "main → feature branches → pull request → merge to main → deploy",
            ["Simple and lightweight", "Continuous deployment friendly", "Easy to learn"]),
        new("trunk-based", "Trunk-based", "main (trunk) → short-lived branches → merge within hours → feature flags",
            ["Fastest integration speed", "Reduces merge conflicts", "Enables continuous delivery"]),
    ];
}
