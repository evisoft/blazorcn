@* ============================================================
   Block: onboarding-ci-cd-setup
   Title: OnboardingCiCdSetup
   Description: A React CI/CD pipeline configuration block with vertical stages and connecting lines. Built with Next.js, TypeScript, shadcn/ui Button, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-ci-cd-setup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="workflow" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Set Up CI/CD Pipeline</span>
                </div>
                <span class="text-muted-foreground text-xs">@_configuredCount of @_stages.Length configured</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Configure each stage of your deployment pipeline
            </p>
        </div>

        @* Pipeline stages *@
        <div class="px-4 py-3">
            @for (int i = 0; i < _stages.Length; i++)
            {
                var stage = _stages[i];
                var isLast = i == _stages.Length - 1;
                <div class="relative">
                    @* Connecting line *@
                    @if (!isLast)
                    {
                        <div class="absolute left-4 top-10 h-[calc(100%-16px)] w-px bg-border" aria-hidden="true"></div>
                    }

                    <div class="relative flex items-center gap-3 py-2">
                        <div class="@Cn.Merge("relative z-10 flex size-8 shrink-0 items-center justify-center rounded-full border", stage.Configured ? "border-foreground bg-foreground text-background" : "border-muted-foreground/30 bg-card")">
                            @if (stage.Configured)
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                            }
                            else
                            {
                                <LucideIconCn Name="@stage.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@stage.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@stage.Description</p>
                        </div>
                        <div class="shrink-0">
                            @if (stage.Configured)
                            {
                                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                    Configured
                                </span>
                            }
                            else
                            {
                                var stageId = stage.Id;
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs" OnClick="@(() => HandleConfigure(stageId))">
                                    Configure
                                </ButtonCn>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Configure all stages to activate</span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Activate Pipeline
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record PipelineStage(string Id, string Name, string Description, string Icon, bool Configured);

    private PipelineStage[] _stages =
    [
        new("build",   "Build",   "Compile source code and create artifacts",         "hammer",               true),
        new("test",    "Test",    "Run unit, integration, and e2e test suites",        "test-tube-diagonal",   true),
        new("deploy",  "Deploy",  "Push artifacts to target environments",             "rocket",               false),
        new("monitor", "Monitor", "Track errors, performance, and uptime",             "activity",             false),
    ];

    private int _configuredCount => _stages.Count(s => s.Configured);

    private void HandleConfigure(string id)
    {
        _stages = _stages
            .Select(s => s.Id == id ? s with { Configured = true } : s)
            .ToArray();
    }
}
