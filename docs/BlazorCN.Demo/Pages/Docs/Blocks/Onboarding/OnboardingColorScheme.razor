@* ============================================================
   Block: onboarding-color-scheme
   Title: OnboardingColorScheme
   Description: A brand color picker onboarding block for React and Next.js with six color swatches, selected ring state, live preview text, and apply action built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-color-scheme.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Brand color</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Choose a primary color for your workspace. This color will be used for buttons, links,
                and accents throughout the interface.
            </p>
        </div>

        @* Color swatches *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-center gap-4">
                @foreach (var col in _colors)
                {
                    var colorId = col.Id;
                    <button
                        type="button"
                        aria-label="@col.Label"
                        @onclick="@(() => _selected = colorId)"
                        class="flex flex-col items-center gap-1.5">
                        <span class="@Cn.Merge("size-8 rounded-full transition-all", col.Swatch, _selected == col.Id ? "ring-2 ring-foreground ring-offset-2 ring-offset-background" : "hover:scale-110")"></span>
                        <span class="@Cn.Merge("text-xs", _selected == col.Id ? "font-medium" : "text-muted-foreground")">@col.Label</span>
                    </button>
                }
            </div>
        </div>

        @* Preview *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Preview</span>
            <div class="@Cn.Merge("rounded-md p-3", _activeColor.Bg)">
                <span class="@Cn.Merge("font-medium text-sm", _activeColor.Text)">
                    Your brand color is @_activeColor.Label
                </span>
                <p class="mt-1 text-muted-foreground text-xs">
                    Buttons, links, and accent elements will use this color
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Apply &amp; Continue
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ColorOption(string Id, string Label, string Swatch, string Text, string Bg);

    private static readonly ColorOption[] _colors =
    [
        new("slate",   "Slate",   "bg-slate-500",   "text-slate-600 dark:text-slate-400",   "bg-slate-500/10"),
        new("blue",    "Blue",    "bg-blue-500",    "text-blue-600 dark:text-blue-400",    "bg-blue-500/10"),
        new("emerald", "Emerald", "bg-emerald-500", "text-emerald-600 dark:text-emerald-400", "bg-emerald-500/10"),
        new("amber",   "Amber",   "bg-amber-500",   "text-amber-600 dark:text-amber-400",   "bg-amber-500/10"),
        new("rose",    "Rose",    "bg-rose-500",    "text-rose-600 dark:text-rose-400",    "bg-rose-500/10"),
        new("violet",  "Violet",  "bg-violet-500",  "text-violet-600 dark:text-violet-400",  "bg-violet-500/10"),
    ];

    private string _selected = "blue";

    private ColorOption _activeColor => Array.Find(_colors, c => c.Id == _selected) ?? _colors[1];
}
