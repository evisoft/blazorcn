@* ============================================================
   Block: onboarding-approval-workflow
   Title: OnboardingApprovalWorkflow
   Description: React approval workflow setup onboarding block with three vertical approval stages, threshold inputs, auto-approve toggles, and activate action. Built with Next.js, shadcn/ui Button, Input, Switch, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-approval-workflow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Set up approval workflow</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Define approval stages and spending thresholds for your organization.
            </p>
        </div>

        @* Approval stages *@
        <div class="px-4 py-4">
            <div class="relative">
                @* Connecting line *@
                <div class="absolute left-[7px] top-3 bottom-3 w-px bg-border"></div>

                <div class="space-y-0">
                    @foreach (var stg in _stages)
                    {
                        var stage = stg;
                        var isLast = stage.Id == _stages[_stages.Length - 1].Id;
                        <div class="relative pl-7">
                            @* Timeline dot *@
                            <div class="absolute left-0 top-1.5 flex size-[15px] items-center justify-center rounded-full border bg-card">
                                <span class="size-1.5 rounded-full bg-foreground"></span>
                            </div>

                            <div class="@(isLast ? "" : "pb-5")">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="min-w-0 flex-1">
                                        <span class="font-medium text-sm">@stage.Title</span>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@stage.Role</p>
                                    </div>
                                </div>

                                <div class="mt-2.5 flex items-center gap-3">
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-muted-foreground text-xs">Threshold</span>
                                        <div class="flex items-center">
                                            <span class="text-muted-foreground text-xs">$</span>
                                            <InputCn Value="@stage.Threshold"
                                                     ValueChanged="@((string v) => UpdateThreshold(stage.Id, v))"
                                                     Class="h-7 w-20 border-0 bg-transparent px-1 font-mono text-xs shadow-none focus-visible:ring-0"
                                                     aria-label="@($"Threshold for {stage.Title}")" />
                                        </div>
                                    </div>
                                    <div class="ml-auto flex items-center gap-1.5">
                                        <span class="text-muted-foreground text-xs">Auto-approve</span>
                                        <SwitchCn Checked="@stage.AutoApprove"
                                                  CheckedChanged="@((bool _) => ToggleAutoApprove(stage.Id))"
                                                  aria-label="@($"Auto-approve for {stage.Title}")" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">@_stages.Length approval stages</span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Activate Workflow</ButtonCn>
        </div>

    </div>
</section>

@code {
    private ApprovalStage[] _stages =
    [
        new ApprovalStage { Id = "manager",   Title = "Manager Review",     Role = "Direct manager", Threshold = "1000",  AutoApprove = true  },
        new ApprovalStage { Id = "finance",   Title = "Finance Approval",   Role = "Finance team",   Threshold = "5000",  AutoApprove = false },
        new ApprovalStage { Id = "executive", Title = "Executive Sign-off", Role = "VP or C-level",  Threshold = "25000", AutoApprove = false },
    ];

    private class ApprovalStage
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Role { get; set; } = "";
        public string Threshold { get; set; } = "";
        public bool AutoApprove { get; set; }
    }

    private void UpdateThreshold(string id, string threshold)
    {
        foreach (var s in _stages)
        {
            if (s.Id == id) s.Threshold = threshold;
        }
    }

    private void ToggleAutoApprove(string id)
    {
        foreach (var s in _stages)
        {
            if (s.Id == id) s.AutoApprove = !s.AutoApprove;
        }
    }
}
