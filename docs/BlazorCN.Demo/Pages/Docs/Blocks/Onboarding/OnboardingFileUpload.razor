@* ============================================================
   Block: onboarding-file-upload
   Title: OnboardingFileUpload
   Description: File upload onboarding block for React and Next.js with dashed border drop zone, upload cloud icon, file type restrictions, progress bar, and remove action using shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-file-upload.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="upload-cloud" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Upload Files</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Import your existing data to get started quickly
            </p>
        </div>

        @* Drop zone *@
        <div class="border-b px-4 py-4">
            <label class="flex cursor-pointer flex-col items-center gap-2 rounded-lg border border-dashed border-muted-foreground/25 px-4 py-8 transition-colors hover:border-muted-foreground/50 hover:bg-muted/30">
                <input type="file" class="sr-only" multiple accept=".csv,.xlsx,.json" />
                <LucideIconCn Name="upload-cloud" Size="32" Class="size-8 text-muted-foreground/60" />
                <div class="text-center">
                    <span class="font-medium text-sm">Click to upload or drag and drop</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_acceptedTypes</p>
                </div>
            </label>
        </div>

        @* Uploaded files *@
        @if (_files.Count > 0)
        {
            <div>
                @foreach (var file in _files)
                {
                    var isLast = _files.IndexOf(file) == _files.Count - 1;
                    <div class="@(isLast ? "" : "border-b")">
                        <div class="flex items-center gap-3 px-4 py-3">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                                <LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="truncate font-medium text-sm">@file.Name</span>
                                    <span class="shrink-0 text-muted-foreground text-xs">@file.Size</span>
                                </div>
                                @if (file.Progress < 100)
                                {
                                    <div class="mt-1.5">
                                        <ProgressCn Value="@file.Progress" Class="h-1" />
                                        <span class="mt-0.5 text-muted-foreground text-xs">
                                            @file.Progress% uploaded
                                        </span>
                                    </div>
                                }
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 shrink-0 p-0"
                                      @onclick="@(() => RemoveFile(file.Id))"
                                      aria-label="@($"Remove {file.Name}")">
                                <LucideIconCn Name="x" Size="14" Class="size-3.5 text-muted-foreground" />
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_files.Count file@(_files.Count != 1 ? "s" : "") uploaded
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Continue
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private const string _acceptedTypes = "CSV, XLSX, JSON up to 10 MB";

    private record UploadedFile(string Id, string Name, string Size, int Progress);

    private readonly List<UploadedFile> _files =
    [
        new("1", "team-members.csv", "24 KB", 100),
        new("2", "project-data.xlsx", "156 KB", 68),
    ];

    private void RemoveFile(string id)
    {
        var toRemove = _files.FirstOrDefault(f => f.Id == id);
        if (toRemove is not null)
            _files.Remove(toRemove);
    }
}
