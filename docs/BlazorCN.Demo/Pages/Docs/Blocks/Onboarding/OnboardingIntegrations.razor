@* ========================================
   Block: onboarding-integrations
   Title: Onboarding Integrations
   Description: Integration connection with app icons, connection status badges, and OAuth connect buttons
   Long Description: React Onboarding Guided Walkthrough
   Dependencies: LucideCheckCn, LucideCloudCn, LucideGithubCn, LucideLoader2Cn, LucideMailCn, LucideMessageSquareCn, LucideVideoCn
   Source: original/blocks/onboarding/onboarding-integrations.tsx
   ======================================== *@

<div class="flex items-center justify-center p-10 w-full">
    <div class="w-full max-w-2xl">
        <div class="mb-6">
            <h2 class="text-xl font-semibold text-foreground">Connect your tools</h2>
            <p class="text-sm text-muted-foreground mt-1">
                Integrate with the apps you already use. @_connectedCount connected.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            @foreach (var integration in _integrations)
            {
                <CardCn Class="@Cn.Merge("transition-all", integration.Connected ? "bg-muted/30" : "")">
                    <CardContentCn Class="p-4">
                        <div class="flex items-start gap-3">
                            <div class="@Cn.Merge("flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-white", integration.Color)">
                                @switch (integration.Icon)
                                {
                                    case "message-square": <LucideMessageSquareCn Class="h-6 w-6" Size="24" /> break;
                                    case "github": <LucideGithubCn Class="h-6 w-6" Size="24" /> break;
                                    case "cloud": <LucideCloudCn Class="h-6 w-6" Size="24" /> break;
                                    case "video": <LucideVideoCn Class="h-6 w-6" Size="24" /> break;
                                    case "mail": <LucideMailCn Class="h-6 w-6" Size="24" /> break;
                                }
                            </div>
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    <h3 class="font-medium text-foreground">@integration.Name</h3>
                                    @if (integration.Connected)
                                    {
                                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">
                                            <LucideCheckCn Class="h-3 w-3 mr-1" Size="12" />
                                            Connected
                                        </BadgeCn>
                                    }
                                </div>
                                <p class="text-sm text-muted-foreground truncate">@integration.Description</p>
                            </div>
                            <div class="shrink-0">
                                @if (integration.Connected)
                                {
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                                              @onclick="@(() => integration.Connected = false)">
                                        Disconnect
                                    </ButtonCn>
                                }
                                else
                                {
                                    <ButtonCn Disabled="@(_connecting == integration.Id)" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                                              @onclick="@(() => HandleConnect(integration))">
                                        @if (_connecting == integration.Id)
                                        {
                                            <LucideLoader2Cn Class="h-4 w-4 animate-spin" Size="16" />
                                        }
                                        else
                                        {
                                            <span>Connect</span>
                                        }
                                    </ButtonCn>
                                }
                            </div>
                        </div>
                    </CardContentCn>
                </CardCn>
            }
        </div>

        <div class="flex items-center justify-between mt-6 pt-4 border-t">
            <ButtonCn Variant="ButtonVariant.Ghost">Skip for now</ButtonCn>
            <ButtonCn>Continue</ButtonCn>
        </div>
    </div>
</div>

@code {
    private class IntegrationItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string Icon { get; set; } = "";
        public string Color { get; set; } = "";
        public bool Connected { get; set; }
    }

    private readonly IntegrationItem[] _integrations =
    [
        new() { Id = "slack", Name = "Slack", Description = "Get notifications in Slack", Icon = "message-square", Color = "bg-[#4A154B]", Connected = true },
        new() { Id = "github", Name = "GitHub", Description = "Sync issues and PRs", Icon = "github", Color = "bg-[#24292F]", Connected = false },
        new() { Id = "google", Name = "Google Drive", Description = "Import and sync files", Icon = "cloud", Color = "bg-[#4285F4]", Connected = true },
        new() { Id = "zoom", Name = "Zoom", Description = "Schedule video meetings", Icon = "video", Color = "bg-[#2D8CFF]", Connected = false },
        new() { Id = "trello", Name = "Trello", Description = "Sync boards and cards", Icon = "cloud", Color = "bg-[#0052CC]", Connected = false },
        new() { Id = "gmail", Name = "Gmail", Description = "Send emails from app", Icon = "mail", Color = "bg-[#EA4335]", Connected = false },
    ];

    private string? _connecting;
    private int _connectedCount => _integrations.Count(i => i.Connected);

    private async Task HandleConnect(IntegrationItem integration)
    {
        _connecting = integration.Id;
        StateHasChanged();
        await Task.Delay(1500);
        integration.Connected = true;
        _connecting = null;
    }
}
