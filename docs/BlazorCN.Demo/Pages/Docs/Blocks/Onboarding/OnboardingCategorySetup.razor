@* ============================================================
   Block: onboarding-category-setup
   Title: OnboardingCategorySetup
   Description: A React category organization onboarding block with expandable tree hierarchy and chevron rotation. Built with Next.js, TypeScript, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-category-setup.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="folder" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Organize categories</span>
                <span class="ml-auto text-muted-foreground text-xs">@_totalCount items</span>
            </div>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Set up your category tree to organize content. Expand categories to see subcategories.
            </p>
        </div>

        @* Category tree *@
        <div>
            @foreach (var cat in _categories)
            {
                var category = cat;
                var isExpanded = _expanded.Contains(category.Id);
                var isLast = category.Id == _categories[_categories.Length - 1].Id;
                <div class="@Cn.Merge(isLast && !isExpanded ? "" : "border-b")">
                    @* Parent row *@
                    <button
                        type="button"
                        @onclick="@(() => ToggleExpanded(category.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn
                            Name="chevron-right"
                            Size="16"
                            Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        <LucideIconCn Name="folder" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <span class="font-medium text-sm">@category.Name</span>
                        <span class="ml-auto text-muted-foreground text-xs">@category.Children.Length</span>
                    </button>

                    @* Children *@
                    @if (isExpanded)
                    {
                        @foreach (var ch in category.Children)
                        {
                            var child = ch;
                            var childIndex = Array.IndexOf(category.Children, child);
                            var isLastChild = childIndex == category.Children.Length - 1;
                            var isLastCategory = isLast;
                            <div class="@Cn.Merge("flex items-center gap-3 py-2.5 pr-4 pl-8 transition-colors hover:bg-muted/50", !(isLastChild && isLastCategory) ? "border-b" : "")">
                                <span class="size-1.5 shrink-0 rounded-full bg-muted-foreground/30" aria-hidden="true"></span>
                                <span class="text-muted-foreground text-sm">@child.Name</span>
                            </div>
                        }
                    }
                </div>
            }
        </div>

        @* Add category *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs text-muted-foreground">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    Add Category
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">Save Categories</ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record CategoryChild(string Id, string Name);
    private record Category(string Id, string Name, CategoryChild[] Children);

    private static readonly Category[] _categories =
    [
        new("product", "Product", [new("features", "Features"), new("roadmap", "Roadmap")]),
        new("engineering", "Engineering", [new("frontend", "Frontend"), new("backend", "Backend")]),
        new("marketing", "Marketing", [new("campaigns", "Campaigns"), new("analytics", "Analytics")]),
    ];

    private HashSet<string> _expanded = ["product"];

    private int _totalCount => _categories.Length + _categories.Sum(c => c.Children.Length);

    private void ToggleExpanded(string id)
    {
        if (_expanded.Contains(id))
            _expanded.Remove(id);
        else
            _expanded.Add(id);
    }
}
