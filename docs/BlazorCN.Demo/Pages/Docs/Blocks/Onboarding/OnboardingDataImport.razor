@* ========================================
   Block: onboarding-data-import
   Title: Onboarding Data Import
   Description: Data import with file upload, source selection, and progress indicator for migration flows
   Long Description: React Onboarding Content Personalization
   Dependencies: LucideCheckCircle2Cn, LucideCloudCn, LucideLoader2Cn, LucideUploadCn, LucideXCn
   Source: original/blocks/onboarding/onboarding-data-import.tsx
   ======================================== *@

<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-lg">
        <CardHeaderCn>
            <CardTitleCn>Import your data</CardTitleCn>
            <CardDescriptionCn>Bring your existing data into your new workspace</CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn Class="space-y-6">
            @* Import sources *@
            <div>
                <div class="text-sm font-medium text-foreground mb-3 block">Import from</div>
                <div class="grid grid-cols-4 gap-2">
                    @foreach (var source in _importSources)
                    {
                        <button type="button" class="flex flex-col items-center gap-1.5 p-3 rounded-lg border hover:border-primary hover:bg-muted/50 transition-colors">
                            @if (source.IconType == "spreadsheet")
                            {
                                <LucideFileSpreadsheetCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                            }
                            else
                            {
                                <LucideCloudCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                            }
                            <span class="text-xs text-muted-foreground">@source.Name</span>
                        </button>
                    }
                </div>
            </div>

            @* Upload area *@
            <div class="border-2 border-dashed rounded-lg p-8 text-center transition-colors border-muted-foreground/25 hover:border-muted-foreground/50">
                <LucideUploadCn Class="h-8 w-8 text-muted-foreground mx-auto mb-3" Size="32" />
                <p class="text-sm font-medium text-foreground mb-1">Drop files here or click to upload</p>
                <p class="text-xs text-muted-foreground">Supports CSV, Excel, and JSON files up to 50MB</p>
                <ButtonCn Class="mt-4" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Browse files</ButtonCn>
            </div>

            @* File list *@
            @if (_files.Count > 0)
            {
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <div class="text-sm font-medium text-foreground">Files (@_files.Count)</div>
                        @if (_completedCount > 0)
                        {
                            <span class="text-xs text-muted-foreground">@_completedCount complete</span>
                        }
                    </div>
                    <div class="space-y-2">
                        @foreach (var file in _files)
                        {
                            <div class="flex items-center gap-3 p-3 rounded-lg border bg-card">
                                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-muted">
                                    <LucideFileCn Class="h-5 w-5 text-muted-foreground" Size="20" />
                                </div>
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-2">
                                        <span class="text-sm font-medium text-foreground truncate">@file.Name</span>
                                        <span class="text-xs text-muted-foreground">@file.Size</span>
                                    </div>
                                    @if (file.Status == "importing")
                                    {
                                        <div class="mt-1.5">
                                            <ProgressCn Class="h-1" Value="@file.Progress" />
                                        </div>
                                    }
                                    @if (file.Status == "complete")
                                    {
                                        <div class="flex items-center gap-1 text-xs text-emerald-600 dark:text-emerald-400 mt-1">
                                            <LucideCircleCheckCn Class="h-3 w-3" Size="12" />
                                            Import complete
                                        </div>
                                    }
                                </div>
                                <div class="shrink-0">
                                    @if (file.Status == "importing")
                                    {
                                        <LucideLoader2Cn Class="h-4 w-4 animate-spin text-muted-foreground" Size="16" />
                                    }
                                    else
                                    {
                                        <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                                                  @onclick="@(() => _files.Remove(file))">
                                            <LucideXCn Class="h-4 w-4" Size="16" />
                                        </ButtonCn>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* Actions *@
            <div class="flex items-center justify-between pt-4 border-t">
                <ButtonCn Variant="ButtonVariant.Ghost">Skip for now</ButtonCn>
                <ButtonCn Disabled="@(_importingCount > 0)">
                    @if (_importingCount > 0)
                    {
                        <LucideLoader2Cn Class="h-4 w-4 mr-2 animate-spin" Size="16" />
                        <span>Importing...</span>
                    }
                    else
                    {
                        <span>Continue</span>
                    }
                </ButtonCn>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private record ImportSource(string Id, string Name, string IconType);

    private class ImportFile
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Size { get; set; } = "";
        public string Status { get; set; } = "pending";
        public int Progress { get; set; }
    }

    private static readonly ImportSource[] _importSources =
    [
        new("csv", "CSV File", "spreadsheet"),
        new("excel", "Excel", "spreadsheet"),
        new("notion", "Notion", "cloud"),
        new("airtable", "Airtable", "cloud"),
    ];

    private readonly List<ImportFile> _files =
    [
        new() { Id = "1", Name = "contacts.csv", Size = "2.4 MB", Status = "complete", Progress = 100 },
        new() { Id = "2", Name = "projects.csv", Size = "1.1 MB", Status = "importing", Progress = 65 },
    ];

    private int _completedCount => _files.Count(f => f.Status == "complete");
    private int _importingCount => _files.Count(f => f.Status == "importing");
}
