@* ========================================
   Block: onboarding-billing-setup
   Title: Onboarding Billing Setup
   Description: Billing setup with payment method tabs, card input formatting, and secure form fields
   Long Description: React Login Workspace Picker Block
   Dependencies: LucideBuilding2Cn, LucideCreditCardCn, LucideLockCn, LucideShieldCn
   Source: original/blocks/onboarding/onboarding-billing-setup.tsx
   ======================================== *@

<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-md">
        <CardHeaderCn>
            <CardTitleCn>Add payment method</CardTitleCn>
            <CardDescriptionCn>Your payment info is encrypted and secure</CardDescriptionCn>
        </CardHeaderCn>
        <CardContentCn Class="space-y-6">
            <TabsCn Class="w-full" DefaultValue="card">
                <TabsListCn Class="grid w-full grid-cols-2">
                    <TabsTriggerCn Class="gap-2" Value="card">
                        <LucideCreditCardCn Class="h-4 w-4" Size="16" />
                        Card
                    </TabsTriggerCn>
                    <TabsTriggerCn Class="gap-2" Value="bank">
                        <LucideBuilding2Cn Class="h-4 w-4" Size="16" />
                        Bank
                    </TabsTriggerCn>
                </TabsListCn>

                <TabsContentCn Class="space-y-4 mt-4" Value="card">
                    <div class="space-y-2">
                        <LabelCn For="cardNumber">Card number</LabelCn>
                        <div class="relative">
                            <InputCn Id="cardNumber" Placeholder="1234 5678 9012 3456"
                                     Value="@_cardNumber" ValueChanged="@((string v) => _cardNumber = v)" />
                            <LucideCreditCardCn Class="absolute right-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <LabelCn For="expiry">Expiry date</LabelCn>
                            <InputCn Id="expiry" Placeholder="MM/YY"
                                     Value="@_expiry" ValueChanged="@((string v) => _expiry = v)" />
                        </div>
                        <div class="space-y-2">
                            <LabelCn For="cvc">CVC</LabelCn>
                            <div class="relative">
                                <InputCn Id="cvc" Placeholder="123" Type="password" />
                                <LucideLockCn Class="absolute right-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" Size="16" />
                            </div>
                        </div>
                    </div>
                    <div class="space-y-2">
                        <LabelCn For="billing-setup-name">Name on card</LabelCn>
                        <InputCn Id="billing-setup-name" Placeholder="John Doe" />
                    </div>
                </TabsContentCn>

                <TabsContentCn Class="space-y-4 mt-4" Value="bank">
                    <div class="space-y-2">
                        <LabelCn For="routingNumber">Routing number</LabelCn>
                        <InputCn Id="routingNumber" Placeholder="110000000" />
                    </div>
                    <div class="space-y-2">
                        <LabelCn For="accountNumber">Account number</LabelCn>
                        <InputCn Id="accountNumber" Placeholder="000123456789" Type="password" />
                    </div>
                    <div class="space-y-2">
                        <LabelCn For="accountName">Account holder name</LabelCn>
                        <InputCn Id="accountName" Placeholder="John Doe" />
                    </div>
                </TabsContentCn>
            </TabsCn>

            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideShieldCn Class="h-4 w-4" Size="16" />
                <span>256-bit SSL encryption. Your data is safe.</span>
            </div>

            <div class="flex items-center justify-between pt-4 border-t">
                <ButtonCn Variant="ButtonVariant.Ghost">Skip for now</ButtonCn>
                <ButtonCn>Add payment method</ButtonCn>
            </div>
        </CardContentCn>
    </CardCn>
</div>

@code {
    private string _cardNumber = "";
    private string _expiry = "";
}
