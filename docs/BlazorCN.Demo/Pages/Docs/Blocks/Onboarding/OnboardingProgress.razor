@* ========================================
   Block: onboarding-progress
   Title: Onboarding Progress
   Description: Progress bar with vertical task list, percentage indicator, and time estimates for trackable setup flows
   Long Description: Profile setup form with avatar upload, form fields, and validation for user registration flows
   Dependencies: LucideClockCn
   Source: original/blocks/onboarding/onboarding-progress.tsx
   ======================================== *@
<div class="flex items-center justify-center p-10 w-full">
    <CardCn Class="w-full max-w-md">
        <CardHeaderCn Class="pb-3">
            <div class="flex items-center justify-between">
                <CardTitleCn Class="text-lg">Setup Progress</CardTitleCn>
                <span class="text-2xl font-bold text-primary tabular-nums">@Progress%</span>
            </div>
            <ProgressCn Class="h-2 mt-2" Value="@Progress" aria-label="Progress" />
            @if (!IsComplete)
            {
                <div class="flex items-center gap-1.5 mt-2 text-sm text-muted-foreground">
                    <LucideClockCn Size="16" />
                    <span>~@RemainingTime min remaining</span>
                </div>
            }
        </CardHeaderCn>
        <CardContentCn>
            @if (IsComplete)
            {
                <div class="py-8 text-center">
                    <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-primary/10 mb-4">
                        <LucideCheckCn class="h-6 w-6 text-primary" />
                    </div>
                    <h3 class="font-semibold text-foreground">All done!</h3>
                    <p class="text-sm text-muted-foreground mt-1">You've completed all setup tasks</p>
                </div>
            }
            else
            {
                <div class="space-y-1">
                    @foreach (var task in _tasks)
                    {
                        <div class="@(Cn.Merge(
                            "flex items-center gap-3 py-2.5 px-2 -mx-2 rounded-md transition-colors hover:bg-muted/50",
                            task.Completed ? "opacity-60" : ""
                        ))">
                            <CheckboxCn
                                Checked="@task.Completed"
                                CheckedChanged="@(() => task.Completed = !task.Completed)"
                                id="@($"progress-{task.Id}")" />
                            <label
                                class="@(Cn.Merge(
                                    "flex-1 text-sm cursor-pointer",
                                    task.Completed ? "line-through text-muted-foreground" : "text-foreground"
                                ))"
                                for="@($"progress-{task.Id}")">
                                @task.Title
                            </label>
                            <span class="text-xs text-muted-foreground tabular-nums">
                                @(task.Duration)m
                            </span>
                        </div>
                    }
                </div>
            }
        </CardContentCn>
    </CardCn>
</div>

@code {
    private class TaskItem
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public int Duration { get; set; }
        public bool Completed { get; set; }
    }

    private int Progress => _tasks.Length > 0 ? (_tasks.Count(t => t.Completed) * 100 / _tasks.Length) : 0;
    private bool IsComplete => _tasks.All(t => t.Completed);
    private int RemainingTime => _tasks.Where(t => !t.Completed).Sum(t => t.Duration);

    private readonly TaskItem[] _tasks =
    [
        new() { Id = "verify", Title = "Verify your email address", Duration = 1, Completed = true },
        new() { Id = "profile", Title = "Complete your profile information", Duration = 3, Completed = true },
        new() { Id = "preferences", Title = "Set your notification preferences", Duration = 2, Completed = false },
        new() { Id = "workspace", Title = "Create your first workspace", Duration = 2, Completed = false },
        new() { Id = "invite", Title = "Invite at least one team member", Duration = 2, Completed = false },
        new() { Id = "project", Title = "Create your first project", Duration = 3, Completed = false },
        new() { Id = "integration", Title = "Connect an integration", Duration = 2, Completed = false },
    ];
}
