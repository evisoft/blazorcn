@* ============================================================
   Block: onboarding-industry-picker
   Title: OnboardingIndustryPicker
   Description: An industry selection onboarding component for React and Next.js with multi-select chip buttons, ring highlight states, and selected count built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-industry-picker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Your Industry</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-3">
            <p class="text-muted-foreground text-sm">
                Select the industries you work in. You can choose multiple options to help us tailor
                your experience.
            </p>
        </div>

        @* Industry chips *@
        <div class="border-b px-4 py-4">
            <div class="flex flex-wrap gap-2">
                @foreach (var industry in _industries)
                {
                    var ind = industry;
                    var isSelected = _selected.Contains(ind.Id);
                    <button
                        type="button"
                        @onclick="@(() => Toggle(ind.Id))"
                        class="@Cn.Merge("rounded-md px-3 py-1.5 font-medium text-xs transition-colors", isSelected ? "bg-foreground text-background ring-2 ring-foreground" : "bg-muted/50 text-foreground hover:bg-muted")">
                        @ind.Label
                    </button>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <span class="text-muted-foreground text-xs">@_selected.Count selected</span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" Disabled="@(_selected.Count == 0)">
                Continue (@_selected.Count)
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Industry(string Id, string Label);

    private static readonly Industry[] _industries =
    [
        new("technology", "Technology"),
        new("healthcare", "Healthcare"),
        new("finance", "Finance"),
        new("education", "Education"),
        new("ecommerce", "E-commerce"),
        new("other", "Other"),
    ];

    private readonly HashSet<string> _selected = [];

    private void Toggle(string id)
    {
        if (!_selected.Remove(id))
            _selected.Add(id);
    }
}
