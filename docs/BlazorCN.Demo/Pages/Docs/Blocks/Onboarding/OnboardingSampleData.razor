@* ============================================================
   Block: onboarding-sample-data
   Title: OnboardingSampleData
   Description: Sample data loading onboarding with selectable datasets, ring-highlighted selection, and load action built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-sample-data.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="database" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Sample Data</span>
            </div>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="font-semibold text-lg tabular-nums">
                Want to explore with sample data?
            </p>
            <p class="mt-1 text-muted-foreground text-sm">
                Load a pre-built dataset to see how everything works before adding your own data.
            </p>
        </div>

        @* Dataset options *@
        <div>
            @foreach (var dataset in _datasets)
            {
                var ds = dataset;
                <div class="border-b">
                    <button
                        type="button"
                        aria-pressed="@(_selected == ds.Id ? "true" : "false")"
                        @onclick="@(() => _selected = (_selected == ds.Id ? null : ds.Id))"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-all hover:bg-muted/50", _selected == ds.Id ? "ring-2 ring-ring ring-inset" : "")">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="@ds.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@ds.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@ds.Description</p>
                        </div>
                        @if (_selected == ds.Id)
                        {
                            <span class="size-2 shrink-0 rounded-full bg-emerald-500"></span>
                        }
                    </button>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                Start empty
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" Disabled="@(_selected == null)">
                Load Sample Data
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Dataset(string Id, string Icon, string Label, string Description);

    private static readonly Dataset[] _datasets =
    [
        new("ecommerce", "shopping-cart", "E-commerce store", "Products, orders, customers, and inventory with 500 sample records"),
        new("projects", "folder-kanban", "Project tracker", "Tasks, sprints, team assignments, and milestones across 3 projects"),
        new("crm", "users", "CRM contacts", "Contacts, companies, deals, and activity logs with realistic data"),
    ];

    private string? _selected = null;
}
