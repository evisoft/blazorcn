@* ============================================================
   Block: onboarding-custom-fields
   Title: OnboardingCustomFields
   Description: A custom field configuration block for React and Next.js with pre-defined fields, type badges, dynamic add field input, and Select component using shadcn/ui and Tailwind CSS
   Source: original/blocks/onboarding/onboarding-custom-fields.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="list" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Configure Fields</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Set up the fields your team will use to organize data
            </p>
        </div>

        @* Field list *@
        <div>
            @foreach (var field in _fields.ToList())
            {
                var f = field;
                <div class="border-b">
                    <div class="flex items-center gap-3 px-4 py-3">
                        @if (f.Editable)
                        {
                            <InputCn
                                Value="@f.Name"
                                ValueChanged="@((string v) => UpdateFieldName(f.Id, v))"
                                Placeholder="Field name"
                                Class="h-8 flex-1 text-sm" />
                            <SelectCn Value="@f.Type" ValueChanged="@((string? v) => UpdateFieldType(f.Id, v))">
                                <SelectTriggerCn Class="h-8 w-28 text-xs" aria-label="@($"Field type for {f.Name}")">
                                    <SelectValueCn />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    @foreach (var ft in _fieldTypes)
                                    {
                                        var fieldType = ft;
                                        <SelectItemCn Value="@fieldType" Class="text-xs">@fieldType</SelectItemCn>
                                    }
                                </SelectContentCn>
                            </SelectCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 shrink-0 p-0" aria-label="@($"Remove field {f.Name}")" @onclick="@(() => RemoveField(f.Id))">
                                <LucideIconCn Name="x" Size="14" Class="size-3.5 text-muted-foreground" />
                            </ButtonCn>
                        }
                        else
                        {
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@f.Name</span>
                            </div>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">@f.Type</BadgeCn>
                        }
                    </div>
                </div>
            }

            @* Add field button *@
            <button
                type="button"
                @onclick="AddField"
                class="flex w-full items-center gap-2 px-4 py-3 text-left text-muted-foreground text-xs transition-colors hover:bg-muted/50">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Add Field
            </button>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                @_fields.Count field@(_fields.Count != 1 ? "s" : "") configured
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Save Fields
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Field(string Id, string Name, string Type, bool Editable);

    private static readonly string[] _fieldTypes = ["Text", "Number", "Date", "Select"];

    private List<Field> _fields =
    [
        new("name",   "Name",   "Text",   false),
        new("email",  "Email",  "Text",   false),
        new("status", "Status", "Select", false),
    ];

    private int _fieldCounter = 0;

    private void AddField()
    {
        _fieldCounter += 1;
        _fields.Add(new Field($"custom-{_fieldCounter}", "", "Text", true));
    }

    private void UpdateFieldName(string id, string name)
    {
        var idx = _fields.FindIndex(f => f.Id == id);
        if (idx >= 0)
            _fields[idx] = _fields[idx] with { Name = name };
    }

    private void UpdateFieldType(string id, string? type)
    {
        if (type is null) return;
        var idx = _fields.FindIndex(f => f.Id == id);
        if (idx >= 0)
            _fields[idx] = _fields[idx] with { Type = type };
    }

    private void RemoveField(string id)
    {
        _fields.RemoveAll(f => f.Id == id);
    }
}
