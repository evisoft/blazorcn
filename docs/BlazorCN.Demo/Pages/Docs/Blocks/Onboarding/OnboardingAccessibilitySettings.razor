@* ============================================================
   Block: onboarding-accessibility-settings
   Title: OnboardingAccessibilitySettings
   Description: React accessibility preferences onboarding block with five toggle switches, icon labels, and apply action. Built with Next.js, shadcn/ui Switch and Button components, and Tailwind CSS.
   Source: original/blocks/onboarding/onboarding-accessibility-settings.tsx
   ============================================================ *@
<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="eye" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Accessibility</span>
                @if (_enabledCount > 0)
                {
                    <span class="ml-auto text-muted-foreground text-xs">@_enabledCount enabled</span>
                }
            </div>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Adjust accessibility settings to customize your experience. These preferences can be
                changed anytime in settings.
            </p>
        </div>

        @* Options *@
        <div>
            @foreach (var opt in _options)
            {
                var isLast = opt.Id == _options[_options.Length - 1].Id;
                var option = opt;
                <div class="@(isLast ? "" : "border-b")">
                    <label for="@option.Id" class="flex cursor-pointer items-center justify-between gap-4 px-4 py-3 transition-colors hover:bg-muted/50">
                        <div class="flex items-start gap-3">
                            <span class="mt-0.5 shrink-0">
                                <LucideIconCn Name="@option.IconName" Size="16" Class="size-4 text-muted-foreground" />
                            </span>
                            <div class="min-w-0">
                                <span class="font-medium text-sm">@option.Label</span>
                                <p class="mt-0.5 text-muted-foreground text-xs">@option.Description</p>
                            </div>
                        </div>
                        <SwitchCn Id="@option.Id" Checked="@_toggles[option.Id]" CheckedChanged="@(() => HandleToggle(option.Id))" />
                    </label>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-end border-t px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">Apply Settings</ButtonCn>
        </div>
    </div>
</section>

@code {
    private class AccessibilityOption
    {
        public string Id { get; set; } = "";
        public string IconName { get; set; } = "";
        public string Label { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private static readonly AccessibilityOption[] _options =
    [
        new() { Id = "high-contrast", IconName = "contrast", Label = "High contrast", Description = "Increase contrast between text and background colors" },
        new() { Id = "reduce-motion", IconName = "monitor", Label = "Reduce motion", Description = "Minimize animations and transitions throughout the interface" },
        new() { Id = "large-text", IconName = "type", Label = "Large text", Description = "Increase the base font size for improved readability" },
        new() { Id = "screen-reader", IconName = "eye", Label = "Screen reader optimizations", Description = "Enhance ARIA labels and announce dynamic content changes" },
        new() { Id = "keyboard-hints", IconName = "keyboard", Label = "Keyboard navigation hints", Description = "Show shortcut indicators on focusable elements" },
    ];

    private readonly Dictionary<string, bool> _toggles = new()
    {
        ["high-contrast"] = false,
        ["reduce-motion"] = false,
        ["large-text"] = false,
        ["screen-reader"] = false,
        ["keyboard-hints"] = false,
    };

    private int _enabledCount => _toggles.Values.Count(v => v);

    private void HandleToggle(string id)
    {
        if (_toggles.ContainsKey(id))
            _toggles[id] = !_toggles[id];
    }
}
