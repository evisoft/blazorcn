@* ============================================================
   Block: onboarding-payment-method
   Title: OnboardingPaymentMethod
   Description: React and Next.js payment method onboarding block with TypeScript, masked card inputs, AnimatePresence transitions, shadcn/ui components, and Tailwind CSS for billing setup flows.
   Source: original/blocks/onboarding/onboarding-payment-method.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @if (!_submitted)
        {
            <div>
                @* Header *@
                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="credit-card" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="font-medium text-sm">Add Payment Method</span>
                    </div>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Your card will not be charged until the trial ends
                    </p>
                </div>

                @* Card number display *@
                <div class="border-b px-4 py-3">
                    <span class="font-medium text-muted-foreground text-xs">Card number</span>
                    <div class="mt-2 flex items-center gap-3 rounded-md bg-muted/50 px-3 py-2.5">
                        <LucideIconCn Name="credit-card" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <span class="font-mono text-muted-foreground text-sm tracking-wider">
                            **** **** **** ****
                        </span>
                    </div>
                </div>

                @* Cardholder name *@
                <div class="border-b px-4 py-3">
                    <span class="font-medium text-muted-foreground text-xs">Cardholder name</span>
                    <InputCn Class="mt-2 h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0"
                             Placeholder="Full name on card"
                             Value="@_name"
                             ValueChanged="@((string v) => _name = v)"
                             aria-label="Cardholder name" />
                </div>

                @* Expiry + CVC *@
                <div class="border-b px-4 py-3">
                    <div class="flex gap-4">
                        <div class="flex-1">
                            <span class="font-medium text-muted-foreground text-xs">Expiry date</span>
                            <InputCn Class="mt-2 h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0"
                                     Placeholder="MM / YY"
                                     Value="@_expiry"
                                     ValueChanged="@((string v) => _expiry = v)"
                                     aria-label="Expiry date" />
                        </div>
                        <div class="w-24">
                            <span class="font-medium text-muted-foreground text-xs">CVC</span>
                            <InputCn Class="mt-2 h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0"
                                     Placeholder="123"
                                     Value="@_cvc"
                                     ValueChanged="@((string v) => _cvc = v)"
                                     aria-label="CVC" />
                        </div>
                    </div>
                </div>

                @* Security note *@
                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="shield" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-muted-foreground text-xs">
                            256-bit SSL encrypted. Your payment details are secure.
                        </span>
                    </div>
                </div>

                @* Footer *@
                <div class="flex items-center justify-between px-4 py-2.5">
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 text-xs text-muted-foreground">
                        Skip for now
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="HandleSubmit">
                        Add Card
                    </ButtonCn>
                </div>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center justify-center px-4 py-12">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
                </div>
                <span class="mt-3 font-medium text-sm">Payment method added</span>
                <p class="mt-1 text-center text-muted-foreground text-xs">
                    Your card has been securely saved. You will not be charged until your trial ends.
                </p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-7 text-xs">
                    Continue
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private bool _submitted = false;
    private string _name = "";
    private string _expiry = "";
    private string _cvc = "";

    private void HandleSubmit()
    {
        _submitted = true;
    }
}
