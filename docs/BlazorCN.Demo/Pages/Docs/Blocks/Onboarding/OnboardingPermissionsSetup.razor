@* ============================================================
   Block: onboarding-permissions-setup
   Title: OnboardingPermissionsSetup
   Description: React and Next.js permissions configuration onboarding block with TypeScript, expandable role rows, member counts, shadcn/ui checkboxes, and Tailwind CSS for RBAC setup.
   Source: original/blocks/onboarding/onboarding-permissions-setup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Permissions</span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-sm">
                Configure what each role can do in your workspace. You can change these later in
                settings.
            </p>
        </div>

        @* Role rows *@
        <div>
            @foreach (var roleItem in _roles)
            {
                var role = roleItem;
                var isExpanded = _expanded == role.Id;
                var isLast = role.Id == _roles[_roles.Length - 1].Id;
                <div class="@(!isLast || isExpanded ? "border-b" : "")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = (isExpanded ? null : role.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        aria-expanded="@isExpanded">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@role.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@role.Description</p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs tabular-nums">@role.MemberCount</BadgeCn>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="space-y-1 px-4 pb-3">
                            @foreach (var permItem in role.Permissions)
                            {
                                var perm = permItem;
                                var isChecked = _permissions.TryGetValue(perm.Id, out var val) && val;
                                <label
                                    for="@perm.Id"
                                    class="flex cursor-pointer items-center gap-2.5 rounded-md px-2 py-1.5 transition-colors hover:bg-muted/50">
                                    <CheckboxCn
                                        Id="@perm.Id"
                                        Checked="@isChecked"
                                        CheckedChanged="@((bool v) => TogglePermission(perm.Id))" />
                                    <span class="text-sm">@perm.Label</span>
                                </label>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                Skip
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                Save Permissions
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Permission(string Id, string Label, bool DefaultChecked);
    private record Role(string Id, string Name, string Description, int MemberCount, Permission[] Permissions);

    private string? _expanded = "editor";

    private static readonly Role[] _roles =
    [
        new("admin", "Admin", "Full access to all settings and data", 2,
        [
            new("admin-manage-members", "Manage team members", true),
            new("admin-billing", "Access billing and payments", true),
            new("admin-delete", "Delete workspace data", true),
            new("admin-integrations", "Configure integrations", true),
        ]),
        new("editor", "Editor", "Create and edit content, limited settings access", 5,
        [
            new("editor-create", "Create and edit content", true),
            new("editor-publish", "Publish content", true),
            new("editor-comments", "Manage comments", true),
            new("editor-analytics", "View analytics", false),
        ]),
        new("viewer", "Viewer", "Read-only access to published content", 12,
        [
            new("viewer-read", "View published content", true),
            new("viewer-comments", "Add comments", true),
            new("viewer-export", "Export reports", false),
        ]),
    ];

    private Dictionary<string, bool> _permissions = InitPermissions();

    private static Dictionary<string, bool> InitPermissions()
    {
        var dict = new Dictionary<string, bool>();
        foreach (var role in _roles)
            foreach (var perm in role.Permissions)
                dict[perm.Id] = perm.DefaultChecked;
        return dict;
    }

    private void TogglePermission(string permId)
    {
        if (_permissions.TryGetValue(permId, out var current))
            _permissions[permId] = !current;
    }
}
