@* ============================================================
   Block: tables-integration-status
   Title: TablesIntegrationStatus
   Description: Integration monitoring table with uptime, sync status, and error tracking. Built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/tables/tables-integration-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="plug" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <h3 class="text-sm font-medium">Integrations</h3>
                    <p class="text-xs text-muted-foreground">
                        @_healthyCount healthy
                        @if (_issueCount > 0)
                        {
                            <span class="text-amber-600"> · @_issueCount with issues</span>
                        }
                    </p>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="zap" Size="14" Class="size-3.5" />
                Add Integration
            </ButtonCn>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="w-8 text-xs font-medium text-muted-foreground"></TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Integration</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Status</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground text-right">Uptime</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Last Sync</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground text-center">Errors</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground text-center">Enabled</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var intg in _integrations)
                {
                    var integration = intg;
                    var isExpanded = _expanded == integration.Id;
                    <TableRowCn Class="cursor-pointer hover:bg-muted/50" @onclick="@(() => ToggleExpanded(integration.Id))">
                        <TableCellCn Class="w-8 px-2">
                            <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </TableCellCn>
                        <TableCellCn>
                            <div>
                                <span class="text-sm font-medium">@integration.Name</span>
                                <p class="text-xs text-muted-foreground">@integration.Description</p>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            @switch (integration.Status)
                            {
                                case HealthStatus.Healthy:
                                    <div class="flex items-center gap-1.5">
                                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                        <span class="text-xs text-muted-foreground">Healthy</span>
                                    </div>
                                    break;
                                case HealthStatus.Degraded:
                                    <div class="flex items-center gap-1.5">
                                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                                        <span class="text-xs text-amber-600">Degraded</span>
                                    </div>
                                    break;
                                case HealthStatus.Down:
                                    <div class="flex items-center gap-1.5">
                                        <span class="size-1.5 rounded-full bg-red-500"></span>
                                        <span class="text-xs font-medium text-red-600">Down</span>
                                    </div>
                                    break;
                                case HealthStatus.Disabled:
                                    <div class="flex items-center gap-1.5">
                                        <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                                        <span class="text-xs text-muted-foreground">Disabled</span>
                                    </div>
                                    break;
                            }
                        </TableCellCn>
                        <TableCellCn Class="text-right">
                            @if (integration.Enabled)
                            {
                                <span class="@Cn.Merge("font-mono tabular-nums text-xs", integration.Uptime >= 99.9 ? "text-emerald-600" : integration.Uptime >= 99.0 ? "text-muted-foreground" : "text-red-600")">
                                    @integration.Uptime.ToString("F2")%
                                </span>
                            }
                            else
                            {
                                <span class="text-xs text-muted-foreground">-</span>
                            }
                        </TableCellCn>
                        <TableCellCn>
                            <span class="text-xs text-muted-foreground">@integration.LastSync</span>
                        </TableCellCn>
                        <TableCellCn Class="text-center">
                            @if (integration.ErrorCount > 0)
                            {
                                <div class="flex items-center justify-center gap-1">
                                    <LucideIconCn Name="triangle-alert" Size="12" Class="size-3 text-amber-600" />
                                    <span class="text-xs font-medium text-amber-600">@integration.ErrorCount</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-muted-foreground">0</span>
                            }
                        </TableCellCn>
                        <TableCellCn Class="text-center">
                            <div @onclick:stopPropagation="true">
                                <SwitchCn Checked="@integration.Enabled" CheckedChanged="@((bool v) => ToggleEnabled(integration.Id))" />
                            </div>
                        </TableCellCn>
                    </TableRowCn>
                    @if (isExpanded)
                    {
                        <TableRowCn>
                            <TableCellCn ColSpan="7" Class="bg-muted/30 px-6 py-3">
                                <div class="flex items-center gap-6 text-xs">
                                    <div>
                                        <span class="text-muted-foreground">API Version</span>
                                        <p class="mt-0.5 font-mono font-medium">@integration.ApiVersion</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Rate Limit</span>
                                        <p class="mt-0.5 font-mono font-medium">@integration.RateLimit</p>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <span class="text-muted-foreground">Webhook URL</span>
                                        <p class="mt-0.5 truncate font-mono font-medium">@integration.WebhookUrl</p>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                            <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                                            Sync
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                            <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                            Docs
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">
                                            Configure
                                        </ButtonCn>
                                    </div>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private enum HealthStatus { Healthy, Degraded, Down, Disabled }

    private sealed class IntegrationItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public HealthStatus Status { get; set; }
        public bool Enabled { get; set; }
        public double Uptime { get; set; }
        public string LastSync { get; set; } = "";
        public int ErrorCount { get; set; }
        public string ApiVersion { get; set; } = "";
        public string WebhookUrl { get; set; } = "";
        public string RateLimit { get; set; } = "";
    }

    private string? _expanded = null;

    private int _healthyCount => _integrations.Count(i => i.Status == HealthStatus.Healthy);
    private int _issueCount => _integrations.Count(i => i.Status == HealthStatus.Degraded || i.Status == HealthStatus.Down);

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private void ToggleEnabled(string id)
    {
        var item = _integrations.FirstOrDefault(i => i.Id == id);
        if (item is null) return;
        item.Enabled = !item.Enabled;
        item.Status = item.Enabled ? HealthStatus.Healthy : HealthStatus.Disabled;
    }

    private readonly List<IntegrationItem> _integrations =
    [
        new IntegrationItem { Id = "int-001", Name = "Stripe", Description = "Payment processing", Status = HealthStatus.Healthy, Enabled = true, Uptime = 99.98, LastSync = "2 min ago", ErrorCount = 0, ApiVersion = "v2024-12-18", WebhookUrl = "https://app.example.com/api/webhooks/stripe", RateLimit = "100 req/sec" },
        new IntegrationItem { Id = "int-002", Name = "GitHub", Description = "Source control & CI/CD", Status = HealthStatus.Healthy, Enabled = true, Uptime = 99.95, LastSync = "5 min ago", ErrorCount = 0, ApiVersion = "v4 (GraphQL)", WebhookUrl = "https://app.example.com/api/webhooks/github", RateLimit = "5,000 req/hr" },
        new IntegrationItem { Id = "int-003", Name = "Slack", Description = "Team notifications", Status = HealthStatus.Degraded, Enabled = true, Uptime = 98.5, LastSync = "12 min ago", ErrorCount = 3, ApiVersion = "v2", WebhookUrl = "https://app.example.com/api/webhooks/slack", RateLimit = "1 msg/sec" },
        new IntegrationItem { Id = "int-004", Name = "Salesforce", Description = "CRM sync", Status = HealthStatus.Healthy, Enabled = true, Uptime = 99.9, LastSync = "8 min ago", ErrorCount = 0, ApiVersion = "v59.0", WebhookUrl = "https://app.example.com/api/webhooks/salesforce", RateLimit = "250 req/sec" },
        new IntegrationItem { Id = "int-005", Name = "SendGrid", Description = "Transactional email", Status = HealthStatus.Down, Enabled = true, Uptime = 94.2, LastSync = "45 min ago", ErrorCount = 18, ApiVersion = "v3", WebhookUrl = "https://app.example.com/api/webhooks/sendgrid", RateLimit = "600 req/min" },
        new IntegrationItem { Id = "int-006", Name = "Twilio", Description = "SMS & voice", Status = HealthStatus.Healthy, Enabled = true, Uptime = 99.99, LastSync = "1 min ago", ErrorCount = 0, ApiVersion = "2010-04-01", WebhookUrl = "https://app.example.com/api/webhooks/twilio", RateLimit = "100 req/sec" },
        new IntegrationItem { Id = "int-007", Name = "Datadog", Description = "Monitoring & APM", Status = HealthStatus.Disabled, Enabled = false, Uptime = 0, LastSync = "3 days ago", ErrorCount = 0, ApiVersion = "v2", WebhookUrl = "https://app.example.com/api/webhooks/datadog", RateLimit = "300 req/min" },
        new IntegrationItem { Id = "int-008", Name = "Intercom", Description = "Customer support", Status = HealthStatus.Degraded, Enabled = true, Uptime = 97.8, LastSync = "20 min ago", ErrorCount = 7, ApiVersion = "2.11", WebhookUrl = "https://app.example.com/api/webhooks/intercom", RateLimit = "83 req/10sec" },
    ];
}
