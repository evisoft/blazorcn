@* ============================================================
   Block: tables-nested-rows
   Title: Tables Nested Rows
   Description: Table component with hierarchical nested rows for displaying parent-child data
   Dependencies: ButtonCn, TableCn
   Source: original/blocks/tables/tables-nested-rows.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Project Files</h3>
                <p class="text-sm text-muted-foreground">@_totalItems items in project</p>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="ToggleAll">
                    @if (_allExpanded)
                    {
                        <LucideChevronsDownUpCn Size="16" Class="mr-1 h-4 w-4" />
                        @:Collapse All
                    }
                    else
                    {
                        <LucideChevronsUpDownCn Size="16" Class="mr-1 h-4 w-4" />
                        @:Expand All
                    }
                </ButtonCn>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-96 font-semibold text-foreground">Name</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground text-right">Size</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Modified</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @{ RenderTreeNodes(_flatNodes); }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Click arrows to expand folders. Use Expand All to see full tree.
        </p>
    </div>
</div>

@{
    void RenderTreeNodes(List<FlatNode> nodes)
    {
        foreach (var node in nodes)
        {
            if (!IsNodeVisible(node))
                continue;

            var isExpanded = _expandedIds.Contains(node.Id);
            var hasChildren = node.NodeType == "folder" && node.ChildCount > 0;
            var paddingLeft = node.Depth * 20;

            <TableRowCn Class="hover:bg-muted/50">
                <TableCellCn Class="py-2">
                    <div class="flex items-center gap-2" style="@($"padding-left: {paddingLeft}px")">
                        @if (hasChildren)
                        {
                            <ButtonCn Class="h-6 w-6 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => ToggleExpand(node.Id)">
                                @if (isExpanded)
                                {
                                    <LucideChevronDownCn Size="16" Class="h-4 w-4" />
                                }
                                else
                                {
                                    <LucideChevronRightCn Size="16" Class="h-4 w-4" />
                                }
                            </ButtonCn>
                        }
                        else
                        {
                            <span class="w-6"></span>
                        }
                        @if (node.NodeType == "folder")
                        {
                            if (isExpanded)
                            {
                                <LucideFolderOpenCn Size="16" Class="h-4 w-4 text-primary" />
                            }
                            else
                            {
                                <LucideFolderCn Size="16" Class="h-4 w-4 text-primary" />
                            }
                        }
                        else
                        {
                            <LucideFileTextCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                        }
                        <span class="@(node.NodeType == "folder" ? "font-medium" : "")">@node.Name</span>
                        @if (hasChildren)
                        {
                            <span class="text-xs text-muted-foreground">(@node.ChildCount @(node.ChildCount == 1 ? "item" : "items"))</span>
                        }
                    </div>
                </TableCellCn>
                <TableCellCn Class="text-right font-mono text-sm text-muted-foreground">@(node.Size ?? "\u2014")</TableCellCn>
                <TableCellCn Class="text-muted-foreground">@node.Modified</TableCellCn>
            </TableRowCn>
        }
    }
}

@code {
    private record TreeNode(string Id, string Name, string NodeType, string? Size, string Modified, TreeNode[]? Children);
    private record FlatNode(string Id, string Name, string NodeType, string? Size, string Modified, int Depth, string? ParentId, int ChildCount);

    private static readonly TreeNode[] _tree =
    [
        new("1", "src", "folder", null, "2 hours ago", [
            new("1-1", "components", "folder", null, "1 hour ago", [
                new("1-1-1", "Button.tsx", "file", "2.4 KB", "3 days ago", null),
                new("1-1-2", "Card.tsx", "file", "1.8 KB", "1 week ago", null),
                new("1-1-3", "Input.tsx", "file", "3.1 KB", "2 days ago", null),
            ]),
            new("1-2", "hooks", "folder", null, "5 days ago", [
                new("1-2-1", "useAuth.ts", "file", "1.2 KB", "1 week ago", null),
                new("1-2-2", "useQuery.ts", "file", "2.8 KB", "5 days ago", null),
            ]),
            new("1-3", "index.ts", "file", "0.5 KB", "2 hours ago", null),
        ]),
        new("2", "public", "folder", null, "1 week ago", [
            new("2-1", "favicon.ico", "file", "4.2 KB", "1 month ago", null),
            new("2-2", "logo.svg", "file", "1.1 KB", "2 weeks ago", null),
        ]),
        new("3", "config", "folder", null, "3 days ago", [
            new("3-1", "eslint.config.js", "file", "0.8 KB", "3 days ago", null),
            new("3-2", "tsconfig.json", "file", "0.6 KB", "1 week ago", null),
        ]),
        new("4", "package.json", "file", "1.9 KB", "1 day ago", null),
        new("5", "README.md", "file", "3.4 KB", "4 days ago", null),
    ];

    private static readonly List<FlatNode> _flatNodes;
    private static readonly int _totalItems;
    private static readonly List<string> _allFolderIds;

    static TablesNestedRows()
    {
        _flatNodes = new List<FlatNode>();
        Flatten(_tree, 0, null);
        _totalItems = _flatNodes.Count;
        _allFolderIds = _flatNodes.Where(n => n.NodeType == "folder").Select(n => n.Id).ToList();
    }

    private static void Flatten(TreeNode[] nodes, int depth, string? parentId)
    {
        foreach (var node in nodes)
        {
            var childCount = node.Children?.Length ?? 0;
            _flatNodes.Add(new FlatNode(node.Id, node.Name, node.NodeType, node.Size, node.Modified, depth, parentId, childCount));
            if (node.Children != null)
                Flatten(node.Children, depth + 1, node.Id);
        }
    }

    private HashSet<string> _expandedIds = new(["1"]);
    private bool _allExpanded => _allFolderIds.All(id => _expandedIds.Contains(id));

    private bool IsNodeVisible(FlatNode node)
    {
        if (node.ParentId == null) return true;
        var current = node;
        while (current.ParentId != null)
        {
            if (!_expandedIds.Contains(current.ParentId))
                return false;
            current = _flatNodes.First(n => n.Id == current.ParentId);
        }
        return true;
    }

    private void ToggleExpand(string id)
    {
        if (!_expandedIds.Remove(id))
            _expandedIds.Add(id);
    }

    private void ToggleAll()
    {
        if (_allExpanded)
            _expandedIds.Clear();
        else
            _expandedIds = new HashSet<string>(_allFolderIds);
    }
}
