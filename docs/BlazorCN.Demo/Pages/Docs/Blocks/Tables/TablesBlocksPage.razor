    private record RateLimit(string Id, string Endpoint, string Method, int Limit, int Used, string Window, string ResetIn, string Plan);

    private static readonly RateLimit[] _rateLimits =
    [
        new(""1"", ""/api/users"",    ""GET"",    1000, 423, ""1 hour"", ""34m"", ""Pro""),
        new(""2"", ""/api/users"",    ""POST"",    100,  87, ""1 hour"", ""34m"", ""Pro""),
        new(""3"", ""/api/search"",   ""GET"",     500, 498, ""1 hour"", ""12m"", ""Pro""),
        new(""4"", ""/api/exports"",  ""POST"",     50,  50, ""1 hour"", ""48m"", ""Pro""),
        new(""5"", ""/api/webhooks"", ""POST"",    200,  45, ""1 hour"", ""34m"", ""Pro""),
        new(""6"", ""/api/uploads"",  ""POST"",    100,  72, ""1 hour"", ""22m"", ""Pro""),
        new(""7"", ""/api/analytics"",""GET"",     300, 156, ""1 hour"", ""34m"", ""Pro""),
        new(""8"", ""/api/billing"",  ""GET"",     200,  12, ""1 hour"", ""34m"", ""Pro""),
    ];

    private static readonly int _throttledCount =
        _rateLimits.Count(r => GetThrottleStatus(r.Used, r.Limit) == ""throttled"");

    private string _sortKey = ""remaining"";
    private string _sortDir = ""asc"";

    private IEnumerable<RateLimit> SortedData
    {
        get
        {
            if (_sortKey == ""remaining"")
            {
                return _sortDir == ""asc""
                    ? _rateLimits.OrderBy(r => r.Limit - r.Used)
                    : _rateLimits.OrderByDescending(r => r.Limit - r.Used);
            }
            return _sortDir == ""asc""
                ? _rateLimits.OrderBy(r => r.Used)
                : _rateLimits.OrderByDescending(r => r.Used);
        }
    }

    private void HandleSort(string key)
    {
        if (_sortKey == key)
            _sortDir = _sortDir == ""desc"" ? ""asc"" : ""desc"";
        else
        {
            _sortKey = key;
            _sortDir = ""asc"";
        }
    }

    private static string GetThrottleStatus(int used, int limit)
    {
        var pct = (double)used / limit * 100;
        if (pct >= 100) return ""throttled"";
        if (pct >= 80) return ""warning"";
        return ""normal"";
    }

    private static string GetMethodStyle(string method) => method switch
    {
        ""GET""    => ""bg-blue-500/10 text-blue-700"",
        ""POST""   => ""bg-green-500/10 text-green-700"",
        ""PUT""    => ""bg-amber-500/10 text-amber-700"",
        ""DELETE"" => ""bg-red-500/10 text-red-700"",
        ""PATCH""  => ""bg-purple-500/10 text-purple-700"",
        _        => """",
    };
}";

