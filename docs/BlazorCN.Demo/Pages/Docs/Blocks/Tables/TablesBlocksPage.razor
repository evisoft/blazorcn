@code {
    private record Order(string Id, string Customer, string Product, double Amount, string Status, string Date);

    private static readonly string[] _customers = [""John Smith"", ""Emma Wilson"", ""Michael Brown"", ""Sarah Davis"", ""James Johnson"", ""Lisa Anderson"", ""Robert Taylor"", ""Jennifer Martin""];
    private static readonly string[] _products = [""Laptop Pro 15"", ""Wireless Mouse"", ""Mechanical Keyboard"", ""4K Monitor"", ""USB Hub"", ""Webcam HD"", ""Desk Lamp"", ""Phone Stand""];
    private static readonly string[] _statuses = [""completed"", ""processing"", ""pending"", ""cancelled""];
    private static readonly int[] _pageSizes = [10, 20, 50];

    private static readonly Order[] _orders = Enumerable.Range(0, 47).Select(i =>
        new Order(
            $""ORD-{(i + 1):D4}"",
            _customers[i % 8],
            _products[i % 8],
            Math.Round(50 + (i * 37.7 % 500), 2),
            _statuses[i % 4],
            $""2024-01-{(i % 28) + 1:D2}""
        )
    ).ToArray();

    private int _currentPage = 1;
    private int _rowsPerPage = 10;

    private int TotalPages => (int)Math.Ceiling((double)_orders.Length / _rowsPerPage);
    private int StartIndex => (_currentPage - 1) * _rowsPerPage;
    private int ShowingStart => StartIndex + 1;
    private int ShowingEnd => Math.Min(StartIndex + _rowsPerPage, _orders.Length);
    private Order[] CurrentPageData => _orders.Skip(StartIndex).Take(_rowsPerPage).ToArray();

    private void GoToPage(int page)
    {
        _currentPage = Math.Max(1, Math.Min(page, TotalPages));
    }

    private void SetRowsPerPage(int size)
    {
        _rowsPerPage = size;
        _currentPage = 1;
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        var total = TotalPages;

        if (total <= 7)
            return Enumerable.Range(1, total).ToList();

        pages.Add(1);
        if (_currentPage > 3) pages.Add(-1); // ellipsis

        for (var i = Math.Max(2, _currentPage - 1); i <= Math.Min(total - 1, _currentPage + 1); i++)
            pages.Add(i);

        if (_currentPage < total - 2) pages.Add(-1); // ellipsis
        pages.Add(total);

        return pages;
    }

    private static (string Label, BadgeVariant Variant, string ClassName) GetStatusConfig(string status) => status switch
    {
        ""completed"" => (""Completed"", BadgeVariant.Outline, ""border-green-200 text-green-700""),
        ""processing"" => (""Processing"", BadgeVariant.Outline, ""border-blue-200 text-blue-700""),
        ""pending"" => (""Pending"", BadgeVariant.Outline, ""border-orange-200 text-orange-700""),
        ""cancelled"" => (""Cancelled"", BadgeVariant.Secondary, """"),
        _ => (status, BadgeVariant.Secondary, """"),
    };
}";
