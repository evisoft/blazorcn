    private void ToggleRow(string taskId)
    {
        if (!_expandedRows.Remove(taskId))
            _expandedRows.Add(taskId);

        var task = _tasks.FirstOrDefault(t => t.Id == taskId);
        if (task != null) task.HasUnread = false;
