    private IEnumerable<Ticket> GetFiltered()
    {
        return _tickets
            .Where(t => _priorityFilter == ""all"" || t.Priority == _priorityFilter)
            .Where(t => _search == """" ||
                t.Subject.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                t.Id.Contains(_search, StringComparison.OrdinalIgnoreCase));
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ');
