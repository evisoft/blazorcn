    private const string TablesVirtualizedCode = @"<div style=""width: 900px"">
    <div class=""space-y-4"">
        <div class=""flex items-center justify-between"">
            <div class=""flex items-center gap-4"">
                <p class=""text-sm text-muted-foreground"">
                    @_filteredLogs.Length.ToString(""N0"") log entries
                </p>
                <div class=""flex gap-1"">
                    @foreach (var level in _levels)
                    {
                        var lvl = level;
                        <button type=""button""
                                class=""@Cn.Merge(""rounded-md px-2 py-1 text-xs font-medium transition-colors"", _levelFilter == lvl ? ""bg-primary text-primary-foreground"" : ""bg-muted text-muted-foreground hover:bg-muted/80"")""
                                @onclick=""() => SetFilter(lvl)"">
                            @lvl.ToUpper()
                        </button>
                    }
                </div>
            </div>
            <p class=""text-xs text-muted-foreground"">
                Showing @Math.Min(_filteredLogs.Length, _pageSize) of @_filteredLogs.Length.ToString(""N0"") rows
            </p>
        </div>

        <div class=""overflow-hidden rounded-lg border border-border bg-card shadow-sm"">
            <div class=""border-b border-border bg-card"">
                <div class=""flex"" style=""width: 850px"">
                    <div class=""w-16 shrink-0 px-4 py-3 text-sm font-semibold text-foreground"">#</div>
                    <div class=""w-44 shrink-0 px-4 py-3 text-sm font-semibold text-foreground"">Timestamp</div>
                    <div class=""w-20 shrink-0 px-4 py-3 text-sm font-semibold text-foreground"">Level</div>
                    <div class=""w-36 shrink-0 px-4 py-3 text-sm font-semibold text-foreground"">Service</div>
                    <div class=""flex-1 px-4 py-3 text-sm font-semibold text-foreground"">Message</div>
                </div>
            </div>

            <div class=""max-h-[400px] overflow-auto"">
                @foreach (var log in _filteredLogs.Take(_pageSize))
                {
                    var (levelLabel, levelClass) = GetLevelConfig(log.Level);

                    <div class=""flex border-b border-border hover:bg-muted/50"" style=""height: 40px; width: 850px"">
                        <div class=""w-16 shrink-0 px-4 py-2 font-mono text-xs text-muted-foreground flex items-center"">@log.Id</div>
                        <div class=""w-44 shrink-0 px-4 py-2 font-mono text-xs flex items-center"">@log.Timestamp</div>
                        <div class=""w-20 shrink-0 px-4 py-2 flex items-center"">
                            <BadgeCn Class=""@levelClass"" Variant=""BadgeVariant.Outline"">@levelLabel</BadgeCn>
                        </div>
                        <div class=""w-36 shrink-0 px-4 py-2 text-sm text-muted-foreground flex items-center"">@log.Service</div>
                        <div class=""flex-1 px-4 py-2 text-sm truncate flex items-center"">@log.Message</div>
                    </div>
                }
            </div>
        </div>

        <p class=""text-xs text-muted-foreground"">
            Showing first @_pageSize rows. Use filters to narrow results.
        </p>
    </div>
</div>

@code {
    private record LogEntry(int Id, string Timestamp, string Level, string Service, string Message);

    private static readonly string[] _levels = [""all"", ""info"", ""warning"", ""error"", ""debug""];
    private static readonly string[] _levelValues = [""info"", ""warning"", ""error"", ""debug""];
    private static readonly string[] _services = [""api-gateway"", ""auth-service"", ""user-service"", ""payment-service"", ""notification-service""];
    private static readonly string[] _messages =
    [
        ""Request processed successfully"",
        ""Connection timeout after 30s"",
        ""Database query completed in 45ms"",
        ""Cache miss for key user:12345"",
        ""Rate limit exceeded for IP"",
        ""Authentication token validated"",
        ""Failed to connect to upstream"",
        ""Retry attempt 3 of 5"",
        ""Graceful shutdown initiated"",
        ""Health check passed"",
    ];

    private const int _pageSize = 100;

    private static readonly LogEntry[] _allLogs = Enumerable.Range(0, 5000).Select(i => new LogEntry(
        i + 1,
        $""{(i / 3600 % 24).ToString().PadLeft(2, '0')}:{(i / 60 % 60).ToString().PadLeft(2, '0')}:{(i % 60).ToString().PadLeft(2, '0')}"",
        _levelValues[i % 4],
        _services[i % 5],
        _messages[i % 10]
    )).ToArray();

    private string _levelFilter = ""all"";
    private LogEntry[] _filteredLogs = _allLogs;

    private void SetFilter(string level)
    {
        _levelFilter = level;
        _filteredLogs = _levelFilter == ""all""
            ? _allLogs
            : _allLogs.Where(l => l.Level == _levelFilter).ToArray();
    }

    private static (string Label, string ClassName) GetLevelConfig(string level) => level switch
    {
        ""info"" => (""INFO"", ""border-blue-200 text-blue-700""),
        ""warning"" => (""WARN"", ""border-orange-200 text-orange-700""),
        ""error"" => (""ERROR"", ""border-red-200 text-red-700""),
        ""debug"" => (""DEBUG"", """"),
        _ => (level.ToUpper(), """"),
    };
}";
