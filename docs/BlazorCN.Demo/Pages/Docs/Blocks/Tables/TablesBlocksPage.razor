    private static (string Label, BadgeVariant Variant) GetPriorityConfig(string priority) => priority switch
    {
        ""high"" => (""High"", BadgeVariant.Default),
        ""medium"" => (""Medium"", BadgeVariant.Secondary),
        ""low"" => (""Low"", BadgeVariant.Outline),
        _ => (priority, BadgeVariant.Secondary),
    };
}";
