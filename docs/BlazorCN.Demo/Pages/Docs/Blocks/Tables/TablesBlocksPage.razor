    private record MetricRow(string Id, string Period, double Revenue, int Orders, double AvgOrderValue, double ConversionRate, int Visitors);
    private record ComparisonMetric(string Label, double Baseline, double Comparison, string BaselineFormatted, string ComparisonFormatted, bool HigherIsBetter);

    private static readonly MetricRow[] _metrics =
    [
        new(""jan"", ""January 2024"", 125_000, 842, 148.46, 3.2, 26_312),
        new(""feb"", ""February 2024"", 142_000, 923, 153.85, 3.5, 26_371),
        new(""mar"", ""March 2024"", 138_000, 895, 154.19, 3.4, 26_323),
        new(""apr"", ""April 2024"", 156_000, 1021, 152.79, 3.7, 27_594),
        new(""may"", ""May 2024"", 168_000, 1105, 152.04, 3.9, 28_333),
        new(""jun"", ""June 2024"", 175_000, 1156, 151.38, 4.1, 28_195),
    ];

    private HashSet<string> _selectedRows = new();
    private bool _isComparing;

    private MetricRow? _baselineData => _selectedRows.Count >= 1 ? _metrics.FirstOrDefault(m => m.Id == _selectedRows.ElementAt(0)) : null;
    private MetricRow? _comparisonData => _selectedRows.Count >= 2 ? _metrics.FirstOrDefault(m => m.Id == _selectedRows.ElementAt(1)) : null;

    private void ToggleRow(string id)
    {
        if (!_selectedRows.Remove(id) && _selectedRows.Count < 2)
            _selectedRows.Add(id);
    }

    private void ClearSelection()
    {
        _selectedRows.Clear();
        _isComparing = false;
    }

    private ComparisonMetric[] GetComparisonMetrics()
    {
        if (_baselineData == null || _comparisonData == null) return [];
        var b = _baselineData;
        var c = _comparisonData;
        return
        [
            new(""Revenue"", b.Revenue, c.Revenue, b.Revenue.ToString(""C0""), c.Revenue.ToString(""C0""), true),
            new(""Orders"", b.Orders, c.Orders, b.Orders.ToString(""N0""), c.Orders.ToString(""N0""), true),
            new(""Avg Order Value"", b.AvgOrderValue, c.AvgOrderValue, b.AvgOrderValue.ToString(""C2""), c.AvgOrderValue.ToString(""C2""), true),
            new(""Conversion Rate"", b.ConversionRate, c.ConversionRate, $""{b.ConversionRate:F1}%"", $""{c.ConversionRate:F1}%"", true),
            new(""Visitors"", b.Visitors, c.Visitors, b.Visitors.ToString(""N0""), c.Visitors.ToString(""N0""), true),
        ];
    }
}";

