        new(""8"", ""Henry Moore"", ""henry.moore@example.com"", ""User"", ""pending""),
    ];

    private SortCol _sortColumn = SortCol.Name;
    private bool _ascending = true;

    private void HandleSort(SortCol column)
    {
        if (_sortColumn == column)
        {
            _ascending = !_ascending;
        }
        else
        {
            _sortColumn = column;
            _ascending = true;
        }
    }

    private User[] GetSortedUsers()
    {
        var sorted = _sortColumn switch
        {
            SortCol.Name => _ascending ? _users.OrderBy(u => u.Name) : _users.OrderByDescending(u => u.Name),
            SortCol.Email => _ascending ? _users.OrderBy(u => u.Email) : _users.OrderByDescending(u => u.Email),
            SortCol.Role => _ascending ? _users.OrderBy(u => u.Role) : _users.OrderByDescending(u => u.Role),
            SortCol.Status => _ascending ? _users.OrderBy(u => u.Status) : _users.OrderByDescending(u => u.Status),
            _ => _users.AsEnumerable(),
        };
        return sorted.ToArray();
    }

    private RenderFragment GetSortIcon(SortCol column)
    {
        if (_sortColumn != column)
            return @<LucideArrowUpDownCn Size=""16"" Class=""ml-2 h-4 w-4 text-muted-foreground"" />;
        return _ascending
            ? @<LucideArrowUpCn Size=""16"" Class=""ml-2 h-4 w-4"" />
            : @<LucideArrowDownCn Size=""16"" Class=""ml-2 h-4 w-4"" />;
