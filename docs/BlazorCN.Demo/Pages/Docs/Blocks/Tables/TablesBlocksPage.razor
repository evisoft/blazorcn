                    <div class=""flex items-center gap-1"" style=""@($""padding-left: {paddingLeft}px"")"">
                        @if (node.NodeType == ""folder"")
                        {
                            <ButtonCn Class=""h-6 w-6 p-0"" Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Ghost"" OnClick=""() => ToggleExpand(node.Id)"" aria-label=""@($""Expand {node.Name}"")"">
                                @if (isExpanded)
                                {
                                    <LucideChevronDownCn Size=""16"" Class=""h-4 w-4"" />
                                }
                                else
                                {
                                    <LucideChevronRightCn Size=""16"" Class=""h-4 w-4"" />
                                }
                            </ButtonCn>
                        }
                        else
                        {
                            <span class=""w-6""></span>
                        }
                        @if (node.NodeType == ""folder"")
                        {
                            if (isExpanded)
                            {
                                <LucideFolderOpenCn Size=""16"" Class=""h-4 w-4 text-yellow-500"" />
                            }
                            else
                            {
                                <LucideFolderCn Size=""16"" Class=""h-4 w-4 text-yellow-500"" />
                            }
                        }
                        else
                        {
                            @GetFileIcon(node.FileType)
                        }
                        <span class=""@Cn.Merge(""ml-1.5"", node.NodeType == ""folder"" ? ""font-medium"" : """")"">@node.Name</span>
                    </div>
                </TableCellCn>
                <TableCellCn Class=""text-right text-sm text-muted-foreground tabular-nums"">@(node.Size ?? ""--"")</TableCellCn>
                <TableCellCn Class=""text-sm text-muted-foreground"">@node.Modified</TableCellCn>
            </TableRowCn>
        }
    }
}

@code {
    private record FileNode(string Id, string Name, string NodeType, string? Size, string Modified, string? FileType, FileNode[]? Children);
    private record FlatNode(string Id, string Name, string NodeType, string? Size, string Modified, string? FileType, int Depth, string? ParentId);

    private static readonly FileNode[] _fileTree =
    [
        new(""src"", ""src"", ""folder"", null, ""Today"", null, [
            new(""src/components"", ""components"", ""folder"", null, ""Today"", null, [
