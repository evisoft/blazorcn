@code {
    private enum SortKey { ExecutionTime, RowsExamined, Calls }
    private enum Severity { Critical, Warning, Info }

    private record SlowQuery(
        string Id,
        string Query,
        string FullQuery,
        string Database,
        int ExecutionTime,
        int RowsExamined,
        int RowsReturned,
        int Calls,
        int AvgTime,
        string LastSeen
    );

    private static readonly SlowQuery[] _queries =
    [
        new(""1"",
            ""SELECT * FROM users WHERE email LIKE '%@gmail.com'"",
            ""SELECT u.*, p.name AS plan_name\nFROM users u\nLEFT JOIN plans p ON u.plan_id = p.id\nWHERE u.email LIKE '%@gmail.com'\nORDER BY u.created_at DESC\nLIMIT 100"",
            ""production"", 4523, 1240000, 8420, 342, 4200, ""2 min ago""),
        new(""2"",
            ""SELECT COUNT(*) FROM orders WHERE created_at > ..."",
            ""SELECT COUNT(*) FROM orders\nWHERE created_at > '2026-01-01'\nAND status IN ('completed', 'refunded')\nGROUP BY DATE(created_at)"",
            ""production"", 2890, 890000, 84, 128, 2650, ""5 min ago""),
        new(""3"",
            ""UPDATE sessions SET last_active = NOW() WHERE ..."",
            ""UPDATE sessions\nSET last_active = NOW()\nWHERE user_id = ?\nAND expired_at IS NULL"",
            ""production"", 1245, 450000, 1, 8942, 980, ""30 sec ago""),
        new(""4"",
            ""SELECT p.*, r.avg_rating FROM products p JOIN ..."",
            ""SELECT p.*, r.avg_rating, r.review_count\nFROM products p\nJOIN (\n  SELECT product_id, AVG(rating) as avg_rating, COUNT(*) as review_count\n  FROM reviews\n  GROUP BY product_id\n) r ON p.id = r.product_id\nWHERE p.active = true\nORDER BY r.avg_rating DESC"",
            ""production"", 3210, 2100000, 1500, 67, 3100, ""15 min ago""),
        new(""5"",
            ""DELETE FROM audit_logs WHERE created_at < ..."",
            ""DELETE FROM audit_logs\nWHERE created_at < DATE_SUB(NOW(), INTERVAL 90 DAY)\nLIMIT 10000"",
            ""production"", 890, 340000, 0, 24, 780, ""1 hr ago""),
        new(""6"",
            ""SELECT DISTINCT tags FROM posts WHERE ..."",
            ""SELECT DISTINCT tags\nFROM posts\nWHERE published = true\nAND category_id IN (SELECT id FROM categories WHERE active = true)"",
            ""analytics"", 1567, 560000, 234, 456, 1400, ""8 min ago""),
    ];

    private string? _expanded = null;
    private SortKey _sortKey = SortKey.ExecutionTime;
    private bool _sortDesc = true;

    private void ToggleExpand(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private void HandleSort(SortKey key)
    {
        if (_sortKey == key)
            _sortDesc = !_sortDesc;
        else
        {
            _sortKey = key;
            _sortDesc = true;
        }
    }

    private IEnumerable<SlowQuery> Sorted()
    {
        IEnumerable<SlowQuery> ordered = _sortKey switch
        {
            SortKey.ExecutionTime => _sortDesc
                ? _queries.OrderByDescending(q => q.ExecutionTime)
                : _queries.OrderBy(q => q.ExecutionTime),
            SortKey.RowsExamined => _sortDesc
                ? _queries.OrderByDescending(q => q.RowsExamined)
                : _queries.OrderBy(q => q.RowsExamined),
            SortKey.Calls => _sortDesc
                ? _queries.OrderByDescending(q => q.Calls)
                : _queries.OrderBy(q => q.Calls),
            _ => _queries,
        };
        return ordered;
    }

    private static Severity GetSeverity(int ms)
    {
        if (ms >= 3000) return Severity.Critical;
        if (ms >= 1000) return Severity.Warning;
        return Severity.Info;
    }

    private static string GetDotClass(Severity s) => s switch
    {
        Severity.Critical => ""bg-red-500"",
        Severity.Warning  => ""bg-amber-500"",
