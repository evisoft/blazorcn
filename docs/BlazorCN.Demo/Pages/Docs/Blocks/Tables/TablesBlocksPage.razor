@code {
    private record TaskItem(string Id, string Title, string Assignee, string Priority, string Status, string DueDate);
    private record FilterOption(string Key, string Label, string ActiveClass);

    private static readonly TaskItem[] _tasks =
    [
        new(""TASK-001"", ""Update landing page design"", ""Alice Johnson"", ""high"", ""in-progress"", ""2024-01-20""),
        new(""TASK-002"", ""Fix navigation menu bug"", ""Bob Smith"", ""urgent"", ""todo"", ""2024-01-16""),
        new(""TASK-003"", ""Write API documentation"", ""Carol White"", ""medium"", ""review"", ""2024-01-22""),
        new(""TASK-004"", ""Implement dark mode"", ""David Brown"", ""low"", ""todo"", ""2024-01-25""),
        new(""TASK-005"", ""Optimize database queries"", ""Eve Davis"", ""high"", ""in-progress"", ""2024-01-18""),
        new(""TASK-006"", ""Set up CI/CD pipeline"", ""Frank Miller"", ""medium"", ""done"", ""2024-01-15""),
        new(""TASK-007"", ""Design mobile app mockups"", ""Alice Johnson"", ""medium"", ""in-progress"", ""2024-01-24""),
        new(""TASK-008"", ""Security audit review"", ""Bob Smith"", ""urgent"", ""review"", ""2024-01-17""),
        new(""TASK-009"", ""Update dependencies"", ""Carol White"", ""low"", ""done"", ""2024-01-14""),
        new(""TASK-010"", ""Create onboarding flow"", ""David Brown"", ""high"", ""todo"", ""2024-01-21""),
    ];

    private static readonly FilterOption[] _priorityOptions =
    [
        new(""low"", ""Low"", ""border-gray-200 text-gray-700 bg-gray-50""),
        new(""medium"", ""Medium"", ""border-blue-200 text-blue-700 bg-blue-50""),
        new(""high"", ""High"", ""border-orange-200 text-orange-700 bg-orange-50""),
        new(""urgent"", ""Urgent"", ""border-red-200 text-red-700 bg-red-50""),
    ];

    private static readonly FilterOption[] _statusOptions =
    [
        new(""todo"", ""Todo"", ""border-gray-200 text-gray-700""),
        new(""in-progress"", ""In Progress"", ""border-blue-200 text-blue-700""),
        new(""review"", ""Review"", ""border-orange-200 text-orange-700""),
        new(""done"", ""Done"", ""border-green-200 text-green-700""),
    ];

    private HashSet<string> _activePriorities = new();
    private HashSet<string> _activeStatuses = new();
    private TaskItem[] _filteredTasks = _tasks;

    private void TogglePriority(string priority)
    {
        if (!_activePriorities.Remove(priority))
            _activePriorities.Add(priority);
        ApplyFilters();
    }

    private void ToggleStatus(string status)
    {
        if (!_activeStatuses.Remove(status))
            _activeStatuses.Add(status);
        ApplyFilters();
    }

    private void ClearAllFilters()
    {
        _activePriorities.Clear();
        _activeStatuses.Clear();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        _filteredTasks = _tasks.Where(t =>
        {
            var priorityMatch = _activePriorities.Count == 0 || _activePriorities.Contains(t.Priority);
            var statusMatch = _activeStatuses.Count == 0 || _activeStatuses.Contains(t.Status);
            return priorityMatch && statusMatch;
        }).ToArray();
    }
}";

