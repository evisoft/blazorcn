        new(""5"", ""SMTP_HOST"", ""smtp.mailgun.org"", ""all"", false, ""Emma Wilson"", ""Mar 15, 2026""),
        new(""6"", ""SMTP_PASSWORD"", ""mg-key-a1b2c3d4e5f6"", ""production"", true, ""Emma Wilson"", ""Mar 15, 2026""),
        new(""7"", ""SENTRY_DSN"", ""https://abc123@sentry.io/456789"", ""all"", false, ""Ryan Lee"", ""Mar 12, 2026""),
        new(""8"", ""JWT_SECRET"", ""super-secret-jwt-signing-key-2026"", ""production"", true, ""Sarah Chen"", ""Mar 10, 2026""),
    ];

    private string _search = """";
    private HashSet<string> _revealedIds = new();
    private string? _copiedId = null;
    private System.Threading.CancellationTokenSource? _copyCts;

    private void SetSearch(string v) => _search = v;

    private IEnumerable<EnvVar> Filtered() =>
        string.IsNullOrEmpty(_search)
            ? _envVars
            : _envVars.Where(v => v.Key.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void ToggleReveal(string id)
    {
        if (!_revealedIds.Remove(id))
            _revealedIds.Add(id);
    }

    private async void HandleCopy(string id, string value)
    {
        _copyCts?.Cancel();
        _copyCts = new System.Threading.CancellationTokenSource();
        var token = _copyCts.Token;
        _copiedId = id;
        StateHasChanged();
        try
        {
            await Task.Delay(2000, token);
            _copiedId = null;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private static string GetScopeStyle(string scope) => scope switch
    {
        ""production"" => ""bg-red-500/10 text-red-700"",
        ""staging"" => ""bg-amber-500/10 text-amber-700"",
        ""development"" => ""bg-blue-500/10 text-blue-700"",
        ""all"" => ""bg-slate-500/10 text-slate-700"",
        _ => """",
    };
}";

