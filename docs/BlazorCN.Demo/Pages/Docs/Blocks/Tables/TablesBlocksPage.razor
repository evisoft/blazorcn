        _editingRowId == rowId && _editingColumn == column;

    private void StartEdit(string rowId, string column, string currentValue)
    {
        _editingRowId = rowId;
        _editingColumn = column;
        _editValue = currentValue;
    }

    private void SaveEdit(string rowId, string column)
    {
        var product = _products.FirstOrDefault(p => p.Id == rowId);
        if (product != null)
        {
            switch (column)
            {
                case ColName: product.Name = _editValue; break;
                case ColSku: product.Sku = _editValue; break;
                case ColPrice: if (double.TryParse(_editValue, out var price)) product.Price = price; break;
                case ColStock: if (int.TryParse(_editValue, out var stock)) product.Stock = stock; break;
            }
        }
        CancelEdit();
    }

    private void CancelEdit()
    {
        _editingRowId = null;
        _editingColumn = null;
        _editValue = """";
    }
}";
