        public string Id { get; set; } = """";
        public string Name { get; set; } = """";
        public string Sku { get; set; } = """";
        public double Price { get; set; }
        public int Stock { get; set; }
        public string Category { get; set; } = """";
    }

    private List<ProductItem> _products =
    [
        new() { Id = ""1"", Name = ""Wireless Mouse"", Sku = ""WM-001"", Price = 29.99, Stock = 150, Category = ""Electronics"" },
        new() { Id = ""2"", Name = ""USB-C Cable"", Sku = ""UC-002"", Price = 12.99, Stock = 300, Category = ""Accessories"" },
        new() { Id = ""3"", Name = ""Laptop Stand"", Sku = ""LS-003"", Price = 49.99, Stock = 75, Category = ""Accessories"" },
        new() { Id = ""4"", Name = ""Mechanical Keyboard"", Sku = ""MK-004"", Price = 129.99, Stock = 45, Category = ""Electronics"" },
        new() { Id = ""5"", Name = ""Monitor 27 inch"", Sku = ""MN-005"", Price = 299.99, Stock = 30, Category = ""Electronics"" },
        new() { Id = ""6"", Name = ""Webcam HD"", Sku = ""WC-006"", Price = 79.99, Stock = 60, Category = ""Electronics"" },
    ];

    private string? _editingRowId;
    private string? _editingColumn;
    private string _editValue = """";

    private bool IsEditing(string rowId, string column) =>
        _editingRowId == rowId && _editingColumn == column;

    private void StartEdit(string rowId, string column, string currentValue)
    {
        _editingRowId = rowId;
        _editingColumn = column;
        _editValue = currentValue;
    }

    private void SaveEdit(string rowId, string column)
    {
        var product = _products.FirstOrDefault(p => p.Id == rowId);
        if (product != null)
        {
            switch (column)
            {
                case ColName: product.Name = _editValue; break;
                case ColSku: product.Sku = _editValue; break;
                case ColPrice: if (double.TryParse(_editValue, out var price)) product.Price = price; break;
                case ColStock: if (int.TryParse(_editValue, out var stock)) product.Stock = stock; break;
            }
        }
        CancelEdit();
    }

    private void CancelEdit()
    {
        _editingRowId = null;
        _editingColumn = null;
        _editValue = """";
    }
}";

