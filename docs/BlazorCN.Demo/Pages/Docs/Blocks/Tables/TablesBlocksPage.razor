    private record ServerMetric(string Id, string ServerName, string Region, int Cpu, int Memory, int Disk, string Status, string LastCheck);

    private static readonly ServerMetric[] _servers =
    [
        new(""1"", ""prod-web-01"", ""us-east-1"", 45, 62, 54, ""online"", ""2 min ago""),
        new(""2"", ""prod-web-02"", ""us-east-1"", 92, 88, 71, ""degraded"", ""1 min ago""),
        new(""3"", ""prod-api-01"", ""us-west-2"", 38, 45, 32, ""online"", ""3 min ago""),
        new(""4"", ""prod-api-02"", ""us-west-2"", 78, 82, 65, ""online"", ""1 min ago""),
        new(""5"", ""prod-db-01"", ""eu-west-1"", 95, 94, 89, ""degraded"", ""30 sec ago""),
        new(""6"", ""prod-db-02"", ""eu-west-1"", 22, 35, 28, ""online"", ""2 min ago""),
        new(""7"", ""prod-cache-01"", ""ap-south-1"", 15, 42, 18, ""online"", ""4 min ago""),
        new(""8"", ""prod-worker-01"", ""us-east-1"", 100, 98, 92, ""offline"", ""5 min ago""),
    ];

    private static readonly int _criticalCount = _servers.Count(s => GetRowSeverity(s) == ""critical"");
    private static readonly int _warningCount = _servers.Count(s => GetRowSeverity(s) == ""warning"");

    private static string GetRowSeverity(ServerMetric server)
    {
        if (server.Status == ""offline"" || server.Cpu >= 95 || server.Memory >= 95)
            return ""critical"";
        if (server.Status == ""degraded"" || server.Cpu >= 80 || server.Memory >= 80 || server.Disk >= 85)
            return ""warning"";
        return ""healthy"";
    }

    private static (string Bg, RenderFragment Icon) GetSeverityConfig(string severity) => severity switch
    {
        ""critical"" => (""bg-destructive/10 hover:bg-destructive/15"", @<LucideXCircleCn Size=""16"" Class=""h-4 w-4 text-destructive"" />),
        ""warning"" => (""bg-yellow-500/10 hover:bg-yellow-500/15"", @<LucideAlertTriangleCn Size=""16"" Class=""h-4 w-4 text-yellow-600"" />),
        _ => (""hover:bg-muted/50"", @<LucideCheckCircle2Cn Size=""16"" Class=""h-4 w-4 text-muted-foreground"" />),
    };

    private static RenderFragment RenderMetric(int value, int warning, int critical)
    {
        var metricSeverity = value >= critical ? ""critical"" : value >= warning ? ""warning"" : ""healthy"";
        var cssClass = metricSeverity switch
        {
            ""critical"" => ""text-destructive font-semibold"",
            ""warning"" => ""text-yellow-600 font-medium"",
            _ => """",
        };
        return @<span class=""@Cn.Merge(""font-mono"", cssClass)"">@value%</span>;
    }

    private static (string Label, BadgeVariant Variant, string ClassName) GetServerStatusConfig(string status) => status switch
    {
        ""online"" => (""Online"", BadgeVariant.Default, """"),
        ""degraded"" => (""Degraded"", BadgeVariant.Outline, ""border-yellow-300 text-yellow-700""),
        ""offline"" => (""Offline"", BadgeVariant.Destructive, """"),
        _ => (status, BadgeVariant.Secondary, """"),
    };
}";
