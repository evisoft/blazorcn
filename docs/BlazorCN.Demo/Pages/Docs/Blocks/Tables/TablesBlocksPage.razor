                            </div>
                        </TableHeadCn>
                        <TableHeadCn Class=""w-20 font-semibold text-foreground text-center"">Reserved</TableHeadCn>
                        <TableHeadCn Class=""w-20 font-semibold text-foreground text-center"">Incoming</TableHeadCn>
                        <TableHeadCn Class=""font-semibold text-foreground"">Total Sold</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var product in _products)
                    {
                        var rowClass = product.InStock == 0
                            ? ""bg-red-50/50""
                            : product.InStock > 0 && product.InStock <= product.ReorderPoint
                                ? ""bg-yellow-50/30""
                                : """";
                        <TableRowCn Class=""@rowClass"">
                            <TableCellCn Class=""font-medium truncate"" title=""@product.Name"">
                                @product.Name
                            </TableCellCn>
                            <TableCellCn Class=""font-mono text-sm text-muted-foreground"">
                                @product.Sku
                            </TableCellCn>
                            <TableCellCn Class=""text-sm text-muted-foreground"">
                                @product.Category
                            </TableCellCn>
                            <TableCellCn>
                                @if (product.InStock == 0)
                                {
                                    <div class=""flex items-center gap-2"">
                                        <BadgeCn Class=""tabular-nums font-medium min-w-[2rem] justify-center bg-red-100 text-red-700 hover:bg-red-100"" Variant=""BadgeVariant.Secondary"">0</BadgeCn>
                                        <span class=""text-xs font-medium text-destructive"">Out of stock</span>
                                    </div>
                                }
                                else if (product.InStock <= product.ReorderPoint)
                                {
                                    <div class=""flex items-center gap-2"">
                                        <BadgeCn Class=""tabular-nums font-medium min-w-[2rem] justify-center bg-yellow-100 text-yellow-700 hover:bg-yellow-100"" Variant=""BadgeVariant.Secondary"">@product.InStock</BadgeCn>
                                        <LucideTriangleAlertCn Size=""14"" Class=""h-3.5 w-3.5 text-yellow-600"" />
                                    </div>
                                }
                                else
                                {
                                    <BadgeCn Class=""tabular-nums font-medium min-w-[2rem] justify-center bg-green-100 text-green-700 hover:bg-green-100"" Variant=""BadgeVariant.Secondary"">@FormatCount(product.InStock)</BadgeCn>
                                }
                            </TableCellCn>
                            <TableCellCn Class=""text-center"">
                                @if (product.Reserved == 0)
                                {
                                    <span class=""text-muted-foreground"">&mdash;</span>
                                }
                                else
                                {
                                    <BadgeCn Class=""tabular-nums font-medium min-w-[2rem] justify-center bg-muted text-muted-foreground hover:bg-muted"" Variant=""BadgeVariant.Secondary"">@product.Reserved</BadgeCn>
                                }
                            </TableCellCn>
                            <TableCellCn Class=""text-center"">
                                @if (product.Incoming == 0)
                                {
                                    <span class=""text-muted-foreground"">&mdash;</span>
                                }
                                else
                                {
                                    <BadgeCn Class=""tabular-nums font-medium min-w-[2rem] justify-center bg-green-100 text-green-700 hover:bg-green-100"" Variant=""BadgeVariant.Secondary"">@product.Incoming</BadgeCn>
                                }
                            </TableCellCn>
                            <TableCellCn>
                                <div class=""flex items-center gap-2"">
                                    <BadgeCn Class=""tabular-nums font-medium min-w-[2rem] justify-center"" Variant=""BadgeVariant.Secondary"">@FormatCount(product.Sold)</BadgeCn>
                                    @if (product.Sold > 1500)
                                    {
                                        <LucideTrendingUpCn Size=""14"" Class=""h-3.5 w-3.5 text-green-600"" />
                                    }
                                    else if (product.Sold > 800)
                                    {
                                        <LucideMinusCn Size=""14"" Class=""h-3.5 w-3.5 text-muted-foreground"" />
                                    }
                                    else
                                    {
                                        <LucideTrendingDownCn Size=""14"" Class=""h-3.5 w-3.5 text-orange-600"" />
                                    }
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class=""text-xs text-muted-foreground"">
            Yellow indicates low stock, red indicates out of stock.
        </p>
    </div>
</div>

