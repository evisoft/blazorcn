@code {
    private record Permission(bool Read, bool Write, bool Delete, bool Admin);
    private record UserPermission(string Id, string Name, string Email, string Role, Permission Permissions, string LastActive);

    private static readonly string[] _permissionKeys = [""read"", ""write"", ""delete"", ""admin""];

    private List<UserPermission> _users =
    [
        new(""1"", ""Sarah Chen"",  ""sarah@company.com"",  ""admin"",     new(true,  true,  true,  true),  ""2 min ago""),
        new(""2"", ""Alex Kumar"",  ""alex@company.com"",   ""developer"", new(true,  true,  false, false), ""15 min ago""),
        new(""3"", ""Emma Wilson"", ""emma@company.com"",   ""editor"",    new(true,  true,  false, false), ""1 hr ago""),
        new(""4"", ""James Park"",  ""james@company.com"",  ""developer"", new(true,  true,  true,  false), ""30 min ago""),
        new(""5"", ""Maya Patel"",  ""maya@company.com"",   ""viewer"",    new(true,  false, false, false), ""3 hr ago""),
        new(""6"", ""Ryan Lee"",    ""ryan@company.com"",   ""editor"",    new(true,  true,  false, false), ""5 hr ago""),
        new(""7"", ""Lina Torres"", ""lina@company.com"",   ""viewer"",    new(true,  false, false, false), ""1 day ago""),
    ];

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ');
        return string.Concat(parts.Select(p => p.Length > 0 ? p[0].ToString() : """"));
    }

    private static string GetRoleLabel(string role) => role switch
    {
        ""admin""     => ""Admin"",
        ""developer"" => ""Developer"",
        ""editor""    => ""Editor"",
        ""viewer""    => ""Viewer"",
        _           => role,
    };

    private static string GetRoleClass(string role) => role switch
    {
        ""admin""     => ""bg-red-500/10 text-red-700"",
        ""developer"" => ""bg-blue-500/10 text-blue-700"",
        ""editor""    => ""bg-purple-500/10 text-purple-700"",
        ""viewer""    => ""bg-slate-500/10 text-slate-700"",
        _           => """",
    };

    private static bool GetPermission(UserPermission user, string perm) => perm switch
    {
        ""read""   => user.Permissions.Read,
        ""write""  => user.Permissions.Write,
        ""delete"" => user.Permissions.Delete,
        ""admin""  => user.Permissions.Admin,
        _        => false,
    };

    private void TogglePermission(string userId, string perm)
    {
        var idx = _users.FindIndex(u => u.Id == userId);
        if (idx < 0) return;
        var u = _users[idx];
        var updated = perm switch
        {
            ""read""   => u with { Permissions = u.Permissions with { Read   = !u.Permissions.Read   } },
            ""write""  => u with { Permissions = u.Permissions with { Write  = !u.Permissions.Write  } },
            ""delete"" => u with { Permissions = u.Permissions with { Delete = !u.Permissions.Delete } },
            ""admin""  => u with { Permissions = u.Permissions with { Admin  = !u.Permissions.Admin  } },
            _        => u,
        };
        _users[idx] = updated;
    }
}";

