@code {
    private static readonly string[] _days = [""Mon"", ""Tue"", ""Wed"", ""Thu"", ""Fri""];

    private class SlotInfo
    {
        public string Status { get; set; } = ""available"";
        public string? BookedBy { get; set; }
        public string? Title { get; set; }
    }

    private class TimeRow
    {
        public string Time { get; set; } = """";
        public Dictionary<string, SlotInfo> Slots { get; set; } = new();
    }

    private List<TimeRow> _schedule = null!;
    private int _availableCount;
    private int _bookedCount;

    protected override void OnInitialized()
    {
        _schedule = new List<TimeRow>
        {
            MakeRow(""9:00 AM"", (""booked"",""Sarah Chen"",""Project Review""), (""available"",null,null), (""booked"",""Team"",""Standup""), (""available"",null,null), (""booked"",""Team"",""Standup"")),
            MakeRow(""9:30 AM"", (""booked"",""Sarah Chen"",""Project Review""), (""available"",null,null), (""available"",null,null), (""available"",null,null), (""available"",null,null)),
            MakeRow(""10:00 AM"", (""available"",null,null), (""booked"",""Marcus Johnson"",""1:1 Meeting""), (""available"",null,null), (""booked"",""Emily Rodriguez"",""Design Review""), (""available"",null,null)),
            MakeRow(""10:30 AM"", (""available"",null,null), (""booked"",""Marcus Johnson"",""1:1 Meeting""), (""available"",null,null), (""booked"",""Emily Rodriguez"",""Design Review""), (""unavailable"",null,null)),
            MakeRow(""11:00 AM"", (""booked"",""Client"",""Client Call""), (""available"",null,null), (""booked"",""David Kim"",""Tech Sync""), (""available"",null,null), (""unavailable"",null,null)),
            MakeRow(""11:30 AM"", (""booked"",""Client"",""Client Call""), (""available"",null,null), (""available"",null,null), (""available"",null,null), (""unavailable"",null,null)),
            MakeRow(""12:00 PM"", (""unavailable"",null,null), (""unavailable"",null,null), (""unavailable"",null,null), (""unavailable"",null,null), (""unavailable"",null,null)),
            MakeRow(""12:30 PM"", (""unavailable"",null,null), (""unavailable"",null,null), (""unavailable"",null,null), (""unavailable"",null,null), (""unavailable"",null,null)),
            MakeRow(""1:00 PM"", (""available"",null,null), (""available"",null,null), (""available"",null,null), (""booked"",""Lisa Thompson"",""Interview""), (""available"",null,null)),
            MakeRow(""1:30 PM"", (""available"",null,null), (""booked"",""James Wilson"",""Planning""), (""available"",null,null), (""booked"",""Lisa Thompson"",""Interview""), (""available"",null,null)),
            MakeRow(""2:00 PM"", (""booked"",""Anna Martinez"",""Sprint Review""), (""booked"",""James Wilson"",""Planning""), (""available"",null,null), (""available"",null,null), (""booked"",""Team"",""Retrospective"")),
            MakeRow(""2:30 PM"", (""booked"",""Anna Martinez"",""Sprint Review""), (""available"",null,null), (""available"",null,null), (""available"",null,null), (""booked"",""Team"",""Retrospective"")),
        };
        RecalcCounts();
    }

    private static TimeRow MakeRow(string time, params (string status, string? bookedBy, string? title)[] daySlots)
    {
        var row = new TimeRow { Time = time };
        for (var i = 0; i < _days.Length && i < daySlots.Length; i++)
        {
            var (s, b, t) = daySlots[i];
            row.Slots[_days[i]] = new SlotInfo { Status = s, BookedBy = b, Title = t };
        }
        return row;
    }

    private void RecalcCounts()
    {
        _availableCount = _schedule.Sum(r => r.Slots.Values.Count(s => s.Status == ""available""));
        _bookedCount = _schedule.Sum(r => r.Slots.Values.Count(s => s.Status == ""booked""));
    }

    private void HandleBook(string day, string time)
    {
        var row = _schedule.FirstOrDefault(r => r.Time == time);
        if (row != null && row.Slots.TryGetValue(day, out var slot) && slot.Status == ""available"")
        {
            slot.Status = ""booked"";
            slot.BookedBy = ""You"";
            slot.Title = ""New Booking"";
            RecalcCounts();
        }
    }

    private static string GetDatePart(string day) => day switch
    {
        ""Mon"" => "" Jan 15"",
        ""Tue"" => "" Jan 16"",
        ""Wed"" => "" Jan 17"",
        ""Thu"" => "" Jan 18"",
        ""Fri"" => "" Jan 19"",
        _ => """",
    };
}";

