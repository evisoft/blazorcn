@code {
    private record Employee(string Id, string Name, string Email, string Department, string Role, string Status);
    private record StatusFilter(string Label, string Value);

    private static readonly Employee[] _allEmployees =
    [
        new(""1"", ""Alice Johnson"", ""alice.johnson@company.com"", ""Engineering"", ""Senior Developer"", ""active""),
        new(""2"", ""Bob Smith"", ""bob.smith@company.com"", ""Design"", ""UX Designer"", ""active""),
        new(""3"", ""Carol Williams"", ""carol.williams@company.com"", ""Marketing"", ""Marketing Manager"", ""on-leave""),
        new(""4"", ""David Brown"", ""david.brown@company.com"", ""Engineering"", ""DevOps Engineer"", ""active""),
        new(""5"", ""Eve Davis"", ""eve.davis@company.com"", ""Sales"", ""Sales Representative"", ""inactive""),
        new(""6"", ""Frank Miller"", ""frank.miller@company.com"", ""Engineering"", ""Junior Developer"", ""active""),
        new(""7"", ""Grace Wilson"", ""grace.wilson@company.com"", ""HR"", ""HR Manager"", ""active""),
        new(""8"", ""Henry Moore"", ""henry.moore@company.com"", ""Finance"", ""Accountant"", ""on-leave""),
        new(""9"", ""Ivy Taylor"", ""ivy.taylor@company.com"", ""Design"", ""UI Designer"", ""active""),
        new(""10"", ""Jack Anderson"", ""jack.anderson@company.com"", ""Engineering"", ""Tech Lead"", ""inactive""),
    ];

    private static readonly StatusFilter[] _statusFilters =
    [
        new(""All"", ""all""),
        new(""Active"", ""active""),
        new(""Inactive"", ""inactive""),
        new(""On Leave"", ""on-leave""),
    ];

    private string _searchQuery = """";
    private string _statusFilter = ""all"";
    private Employee[] _filteredEmployees = _allEmployees;

    private void SetStatusFilter(string filter)
    {
        _statusFilter = filter;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        _filteredEmployees = _allEmployees.Where(e =>
        {
            var matchesStatus = _statusFilter == ""all"" || e.Status == _statusFilter;
            var matchesSearch = string.IsNullOrEmpty(_searchQuery) ||
                e.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                e.Email.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                e.Department.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                e.Role.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase);
            return matchesStatus && matchesSearch;
        }).ToArray();
    }

    private static (string Label, BadgeVariant Variant, string ClassName) GetStatusConfig(string status) => status switch
    {
        ""active"" => (""Active"", BadgeVariant.Outline, ""border-green-200 text-green-700""),
        ""inactive"" => (""Inactive"", BadgeVariant.Secondary, """"),
        ""on-leave"" => (""On Leave"", BadgeVariant.Outline, ""border-orange-200 text-orange-700""),
        _ => (status, BadgeVariant.Secondary, """"),
    };
}";

