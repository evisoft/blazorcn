                                <TableCellCn Class=""font-medium"">@row.Period</TableCellCn>
                                <TableCellCn Class=""text-right tabular-nums"">@row.Revenue.ToString(""C0"")</TableCellCn>
                                <TableCellCn Class=""text-right tabular-nums"">@row.Orders.ToString(""N0"")</TableCellCn>
                                <TableCellCn Class=""text-right tabular-nums"">@row.AvgOrderValue.ToString(""C2"")</TableCellCn>
