    {
        if (_showEmpty)
        {
            _filteredContacts = [];
            return;
        }

        _filteredContacts = string.IsNullOrEmpty(_searchQuery)
            ? _contacts
            : _contacts.Where(c =>
                c.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                c.Email.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                c.Company.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
            ).ToArray();
    }

    private void ClearSearch()
    {
        _searchQuery = """";
        ApplyFilter();
    }

    private void ClearAll()
    {
        _contacts = [];
        _showEmpty = true;
        ApplyFilter();
    }

    private void ResetDemo()
    {
        _contacts = _allContacts;
        _searchQuery = """";
        _showEmpty = false;
        ApplyFilter();
    }
}";
