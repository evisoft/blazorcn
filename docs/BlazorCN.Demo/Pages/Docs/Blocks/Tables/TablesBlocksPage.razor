                new(""src/pages/about.tsx"", ""about.tsx"", ""file"", ""890 B"", ""1 week ago"", ""code"", null),
            ]),
            new(""src/App.tsx"", ""App.tsx"", ""file"", ""2.1 KB"", ""Today"", ""code"", null),
            new(""src/index.css"", ""index.css"", ""file"", ""4.5 KB"", ""3 days ago"", ""code"", null),
        ]),
        new(""public"", ""public"", ""folder"", null, ""1 week ago"", null, [
            new(""public/images"", ""images"", ""folder"", null, ""1 week ago"", null, [
                new(""public/images/logo.png"", ""logo.png"", ""file"", ""24 KB"", ""1 month ago"", ""image"", null),
                new(""public/images/hero.jpg"", ""hero.jpg"", ""file"", ""156 KB"", ""2 weeks ago"", ""image"", null),
            ]),
            new(""public/favicon.ico"", ""favicon.ico"", ""file"", ""4 KB"", ""2 months ago"", ""image"", null),
        ]),
        new(""docs"", ""docs"", ""folder"", null, ""3 days ago"", null, [
            new(""docs/README.md"", ""README.md"", ""file"", ""3.2 KB"", ""3 days ago"", ""document"", null),
            new(""docs/CHANGELOG.md"", ""CHANGELOG.md"", ""file"", ""8.7 KB"", ""1 week ago"", ""document"", null),
        ]),
        new(""package.json"", ""package.json"", ""file"", ""1.4 KB"", ""Today"", ""code"", null),
        new(""tsconfig.json"", ""tsconfig.json"", ""file"", ""682 B"", ""1 month ago"", ""code"", null),
        new("".gitignore"", "".gitignore"", ""file"", ""312 B"", ""2 months ago"", ""other"", null),
    ];

    private static readonly List<FlatNode> _flatNodes;
    private static readonly int _folderCount;
    private static readonly int _fileCount;

    // Map from folder id to list of direct children ids
    private static readonly Dictionary<string, List<string>> _childrenMap = new();

    static TablesFileTree()
    {
        _flatNodes = new List<FlatNode>();
        Flatten(_fileTree, 0, null);
        _folderCount = _flatNodes.Count(n => n.NodeType == ""folder"");
        _fileCount = _flatNodes.Count(n => n.NodeType == ""file"");
    }

    private static void Flatten(FileNode[] nodes, int depth, string? parentId)
    {
        foreach (var node in nodes)
        {
            _flatNodes.Add(new FlatNode(node.Id, node.Name, node.NodeType, node.Size, node.Modified, node.FileType, depth, parentId));
            if (parentId != null)
            {
                if (!_childrenMap.ContainsKey(parentId))
                    _childrenMap[parentId] = new List<string>();
                _childrenMap[parentId].Add(node.Id);
            }
            if (node.Children != null)
            {
                Flatten(node.Children, depth + 1, node.Id);
            }
        }
    }

    private HashSet<string> _expandedIds = new([""src"", ""src/components""]);
    private HashSet<string> _selectedIds = new();

    private bool IsVisible(FlatNode node)
    {
        if (node.ParentId == null) return true;
        // Walk up the parent chain; all ancestors must be expanded
        var current = node;
        while (current.ParentId != null)
        {
            if (!_expandedIds.Contains(current.ParentId))
                return false;
            current = _flatNodes.First(n => n.Id == current.ParentId);
        }
        return true;
    }

    private void ToggleExpand(string id)
    {
        if (!_expandedIds.Remove(id))
            _expandedIds.Add(id);
    }

    private void ToggleSelect(string id)
    {
        if (!_selectedIds.Remove(id))
            _selectedIds.Add(id);
    }

    private static RenderFragment GetFileIcon(string? fileType) => fileType switch
    {
        ""document"" => @<LucideFileTextCn Size=""16"" Class=""h-4 w-4 text-blue-500"" />,
        ""image"" => @<LucideFileImageCn Size=""16"" Class=""h-4 w-4 text-green-500"" />,
        ""code"" => @<LucideFileCodeCn Size=""16"" Class=""h-4 w-4 text-orange-500"" />,
        _ => @<LucideFileCn Size=""16"" Class=""h-4 w-4 text-muted-foreground"" />,
    };
}";
