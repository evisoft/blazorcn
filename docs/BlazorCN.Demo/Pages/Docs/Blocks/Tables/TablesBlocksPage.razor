    void RenderNodes(List<FlatNode> nodes)
    {
        foreach (var node in nodes)
        {
            if (!IsVisible(node))
                continue;

            var isExpanded = _expandedIds.Contains(node.Id);
            var isSelected = _selectedIds.Contains(node.Id);
            var paddingLeft = node.Depth * 20;

            <TableRowCn Class=""@(isSelected ? ""bg-primary/5"" : """")"">
                <TableCellCn Class=""w-8"">
                    <CheckboxCn Checked=""isSelected"" CheckedChanged=""() => ToggleSelect(node.Id)"" />
                </TableCellCn>
                <TableCellCn>
                    <div class=""flex items-center gap-1"" style=""@($""padding-left: {paddingLeft}px"")"">
                        @if (node.NodeType == ""folder"")
                        {
                            <ButtonCn Class=""h-6 w-6 p-0"" Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Ghost"" OnClick=""() => ToggleExpand(node.Id)"">
                                @if (isExpanded)
                                {
                                    <LucideChevronDownCn Size=""16"" Class=""h-4 w-4"" />
                                }
