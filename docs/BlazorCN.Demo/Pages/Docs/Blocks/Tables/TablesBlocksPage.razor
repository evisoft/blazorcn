        new(""ref-006"", ""youtube.com"",      ""video"",    ""tutorial-series"", 4150,  166, 4.0, 4980,  Trend.Up,      8),
        new(""ref-007"", ""newsletter"",       ""email"",    ""weekly-digest"",   2890,  260, 9.0, 7800,  Trend.Stable,  2),
        new(""ref-008"", ""reddit.com"",       ""social"",   null,              3650,  110, 3.0, 3300,  Trend.Down,   22),
        new(""ref-009"", ""github.com"",       ""referral"", null,              7230,  434, 6.0, 13020, Trend.Up,      9),
        new(""ref-010"", ""bing.com"",         ""organic"",  null,              1840,   74, 4.0, 2220,  Trend.Stable,  0),
    ];

    private SortField _sortField = SortField.Visitors;
    private bool _sortAsc = false;

    private int _totalVisitors     => _sources.Sum(r => r.Visitors);
    private int _totalConversions  => _sources.Sum(r => r.Conversions);
    private int _totalRevenue      => _sources.Sum(r => r.Revenue);

    private void HandleSort(SortField field)
    {
        if (_sortField == field)
            _sortAsc = !_sortAsc;
        else
        {
            _sortField = field;
            _sortAsc = false;
        }
    }

    private ReferralSource[] GetSorted()
    {
        IEnumerable<ReferralSource> ordered = _sortField switch
        {
            SortField.Visitors       => _sortAsc ? _sources.OrderBy(r => r.Visitors)       : _sources.OrderByDescending(r => r.Visitors),
            SortField.Conversions    => _sortAsc ? _sources.OrderBy(r => r.Conversions)    : _sources.OrderByDescending(r => r.Conversions),
            SortField.ConversionRate => _sortAsc ? _sources.OrderBy(r => r.ConversionRate) : _sources.OrderByDescending(r => r.ConversionRate),
            SortField.Revenue        => _sortAsc ? _sources.OrderBy(r => r.Revenue)        : _sources.OrderByDescending(r => r.Revenue),
            _                        => _sources.AsEnumerable(),
        };
        return ordered.ToArray();
    }

    private RenderFragment RenderSortIcon(SortField field)
    {
        if (_sortField != field) return @<text></text>;
        return _sortAsc
            ? @<LucideArrowUpCn Size=""12"" Class=""size-3"" />
            : @<LucideArrowDownCn Size=""12"" Class=""size-3"" />;
    }

    private RenderFragment RenderTrend(Trend trend, int percent) => trend switch
    {
        Trend.Up     => @<div class=""flex items-center justify-end gap-1 text-emerald-600""><LucideTrendingUpCn Size=""12"" Class=""size-3"" /><span class=""text-xs"">+@(percent)%</span></div>,
        Trend.Down   => @<div class=""flex items-center justify-end gap-1 text-red-600""><LucideTrendingDownCn Size=""12"" Class=""size-3"" /><span class=""text-xs"">-@(percent)%</span></div>,
        Trend.Stable => @<div class=""flex items-center justify-end gap-1 text-muted-foreground""><LucideMinusCn Size=""12"" Class=""size-3"" /><span class=""text-xs"">@(percent)%</span></div>,
        _            => @<text></text>,
    };

    private static string FormatNumber(int n) =>
        n >= 1000 ? $""{(n / 1000.0):F1}k"" : n.ToString();

    private static string FormatCurrency(int n) =>
        n.ToString(""C0"", new System.Globalization.CultureInfo(""en-US""));
}";

