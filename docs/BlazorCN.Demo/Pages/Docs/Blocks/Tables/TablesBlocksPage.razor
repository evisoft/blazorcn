@code {
    private const string TablesActionsCode = @"<div style=""width: 900px"">
    <div class=""overflow-hidden rounded-lg border border-border bg-card shadow-sm"">
        <TableCn Class=""table-fixed"" style=""width: 850px"">
            <TableHeaderCn>
                <TableRowCn Class=""bg-muted/50"">
                    <TableHeadCn Class=""w-24 font-semibold text-foreground"">ID</TableHeadCn>
                    <TableHeadCn Class=""min-w-48 font-semibold text-foreground"">Task</TableHeadCn>
                    <TableHeadCn Class=""w-40 font-semibold text-foreground"">Assignee</TableHeadCn>
                    <TableHeadCn Class=""w-32 font-semibold text-foreground"">Status</TableHeadCn>
                    <TableHeadCn Class=""w-24 font-semibold text-foreground"">Priority</TableHeadCn>
                    <TableHeadCn Class=""w-32 font-semibold text-foreground"">Due Date</TableHeadCn>
                    <TableHeadCn Class=""min-w-48 font-semibold text-foreground"">Notes</TableHeadCn>
                    <TableHeadCn Class=""w-48 text-right font-semibold text-foreground"">Actions</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var task in _tasks)
                {
                    var (statusLabel, statusVariant, statusClass) = GetStatusBadge(task.Status);

                    <TableRowCn>
                        <TableCellCn Class=""font-mono text-sm text-muted-foreground"">@task.Id</TableCellCn>
                        <TableCellCn Class=""font-medium"">@task.Title</TableCellCn>
                        <TableCellCn>
                            <div class=""flex items-center gap-2"">
                                <div class=""flex h-8 w-8 items-center justify-center rounded-full bg-muted text-xs font-medium"">
                                    @GetInitials(task.Assignee)
                                </div>
                                <span class=""text-sm"">@task.Assignee</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Class=""@Cn.Merge(""font-normal"", statusClass)"" Variant=""@statusVariant"">@statusLabel</BadgeCn>
                        </TableCellCn>
                        <TableCellCn Class=""capitalize text-sm"">@task.Priority</TableCellCn>
                        <TableCellCn Class=""text-sm text-muted-foreground"">@task.DueDate</TableCellCn>
                        <TableCellCn Class=""text-sm text-muted-foreground"">@task.Notes</TableCellCn>
                        <TableCellCn>
                            <div class=""flex justify-end gap-1"">
                                @if (task.Status == ""pending"")
                                {
                                    <ButtonCn Size=""ButtonSize.Icon"" Variant=""ButtonVariant.Ghost"" aria-label=""Start task"" title=""Start task"">
                                        <LucidePlayCn Size=""16"" Class=""h-4 w-4"" />
                                    </ButtonCn>
                                }
                                @if (task.Status == ""in-progress"")
                                {
                                    <ButtonCn Size=""ButtonSize.Icon"" Variant=""ButtonVariant.Ghost"" aria-label=""Pause task"" title=""Pause task"">
                                        <LucidePauseCn Size=""16"" Class=""h-4 w-4"" />
                                    </ButtonCn>
                                    <ButtonCn Size=""ButtonSize.Icon"" Variant=""ButtonVariant.Ghost"" aria-label=""Complete task"" title=""Complete task"">
                                        <LucideCheckCircleCn Size=""16"" Class=""h-4 w-4"" />
                                    </ButtonCn>
                                }
                                <ButtonCn Size=""ButtonSize.Icon"" Variant=""ButtonVariant.Ghost"" aria-label=""Delete task"" title=""Delete task"">
                                    <LucideTrashCn Size=""16"" Class=""h-4 w-4"" />
                                </ButtonCn>
                                <ButtonCn Size=""ButtonSize.Icon"" Variant=""ButtonVariant.Ghost"" aria-label=""View details"" title=""View details"">
                                    <LucideFileTextCn Size=""16"" Class=""h-4 w-4"" />
                                </ButtonCn>
                            </div>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</div>

@code {
    private record TaskItem(string Id, string Title, string Assignee, string Status, string Priority, string DueDate, string Notes);

    private static readonly TaskItem[] _tasks =
    [
        new(""TSK-001"", ""Design new landing page"", ""Sarah Chen"", ""in-progress"", ""high"", ""2024-02-15"", ""Follow brand guidelines v2.0""),
        new(""TSK-002"", ""Implement authentication flow"", ""Alex Kumar"", ""pending"", ""high"", ""2024-02-18"", ""Use OAuth 2.0 with JWT""),
        new(""TSK-003"", ""Write API documentation"", ""Emma Wilson"", ""completed"", ""medium"", ""2024-02-10"", ""Include code examples""),
        new(""TSK-004"", ""Fix mobile responsive issues"", ""James Park"", ""blocked"", ""high"", ""2024-02-12"", ""Waiting for design assets""),
        new(""TSK-005"", ""Optimize database queries"", ""Maya Patel"", ""in-progress"", ""medium"", ""2024-02-20"", ""Focus on user table first""),
        new(""TSK-006"", ""Set up CI/CD pipeline"", ""Ryan Lee"", ""pending"", ""low"", ""2024-02-25"", ""Use GitHub Actions""),
    ];

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();

    private static (string Label, BadgeVariant Variant, string ClassName) GetStatusBadge(string status) => status switch
    {
        ""pending"" => (""Pending"", BadgeVariant.Secondary, """"),
        ""in-progress"" => (""In Progress"", BadgeVariant.Default, """"),
        ""completed"" => (""Completed"", BadgeVariant.Outline, ""border-green-200 text-green-700""),
        ""blocked"" => (""Blocked"", BadgeVariant.Destructive, """"),
        _ => (status, BadgeVariant.Secondary, """"),
    };
}";
    private const string TablesActivityLogCode = @"<div style=""width: 900px"">
    <div class=""space-y-4"">
        <div class=""flex items-center justify-between"">
            <div>
                <h3 class=""text-lg font-semibold"">Activity Log</h3>
                <p class=""text-sm text-muted-foreground"">
                    @_activities.Length entries - @_todayCount today
                </p>
            </div>
            <div class=""flex items-center gap-2"">
                <div class=""flex items-center gap-1 text-xs text-muted-foreground"">
                    <span class=""h-2 w-2 rounded-full bg-primary""></span>
                    @_createCount created
                </div>
                <div class=""flex items-center gap-1 text-xs text-muted-foreground"">
                    <span class=""h-2 w-2 rounded-full bg-muted-foreground""></span>
                    @_updateCount updated
                </div>
                <div class=""flex items-center gap-1 text-xs text-muted-foreground"">
                    <span class=""h-2 w-2 rounded-full bg-destructive""></span>
                    @_deleteCount deleted
                </div>
            </div>
        </div>

        <div class=""overflow-hidden rounded-lg border border-border bg-card shadow-sm"">
            <TableCn Class=""table-fixed"" style=""width: 850px"">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class=""w-24 font-semibold text-foreground"">Action</TableHeadCn>
                        <TableHeadCn Class=""w-48 font-semibold text-foreground"">Description</TableHeadCn>
                        <TableHeadCn Class=""w-36 font-semibold text-foreground"">User</TableHeadCn>
                        <TableHeadCn Class=""w-40 font-semibold text-foreground"">Resource</TableHeadCn>
                        <TableHeadCn Class=""w-28 font-semibold text-foreground"">
                            <div class=""flex items-center gap-1"">
                                <LucideGlobeCn Size=""14"" Class=""h-3.5 w-3.5"" />
                                IP Address
                            </div>
                        </TableHeadCn>
                        <TableHeadCn Class=""font-semibold text-foreground"">Time</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var activity in _activities)
                    {
                        var (actionLabel, actionVariant) = GetActionConfig(activity.Action);

                        <TableRowCn>
                            <TableCellCn>
                                <BadgeCn Class=""gap-1"" Variant=""@actionVariant"">
                                    @GetActionIcon(activity.Action)
                                    @actionLabel
                                </BadgeCn>
                            </TableCellCn>
                            <TableCellCn Class=""text-sm truncate"" title=""@activity.Description"">
                                @activity.Description
                            </TableCellCn>
                            <TableCellCn>
                                <div class=""flex items-center gap-2"">
                                    <div class=""flex h-6 w-6 items-center justify-center rounded-full bg-muted text-[10px] font-medium"">
                                        @GetInitials(activity.UserName)
                                    </div>
                                    <span class=""text-sm truncate"">@activity.UserName.Split(' ')[0]</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                @if (activity.ResourceName is not null)
                                {
                                    <span class=""text-sm text-primary truncate block text-left"" title=""@($""{activity.ResourceType}: {activity.ResourceId}"")"">
                                        @activity.ResourceName
                                    </span>
                                }
                                else
                                {
                                    <span class=""text-sm text-muted-foreground"">-</span>
                                }
                            </TableCellCn>
                            <TableCellCn Class=""font-mono text-xs text-muted-foreground"">
                                @activity.IpAddress
                            </TableCellCn>
                            <TableCellCn>
                                <span class=""text-sm text-muted-foreground"" title=""@activity.Timestamp"">
                                    @activity.RelativeTime
                                </span>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class=""text-xs text-muted-foreground"">
            Hover over user names for email, resources for IDs, and times for full timestamp.
        </p>
    </div>
</div>

@code {
    private record ActivityEntry(string Id, string Action, string Description, string UserName, string UserEmail, string? ResourceType, string? ResourceName, string? ResourceId, string IpAddress, string Timestamp, string RelativeTime);

    private static readonly ActivityEntry[] _activities =
    [
        new(""act-001"", ""create"", ""Created new project"", ""Sarah Chen"", ""sarah@company.com"", ""Project"", ""Website Redesign"", ""PRJ-042"", ""192.168.1.105"", ""Jan 15, 2024 2:34 PM"", ""2 minutes ago""),
        new(""act-002"", ""update"", ""Updated user permissions"", ""Marcus Johnson"", ""marcus@company.com"", ""User"", ""Emily Rodriguez"", ""USR-128"", ""192.168.1.112"", ""Jan 15, 2024 2:28 PM"", ""8 minutes ago""),
        new(""act-003"", ""login"", ""Logged in from new device"", ""Emily Rodriguez"", ""emily@company.com"", null, null, null, ""203.45.67.89"", ""Jan 15, 2024 2:15 PM"", ""21 minutes ago""),
        new(""act-004"", ""upload"", ""Uploaded design assets"", ""David Kim"", ""david@company.com"", ""File"", ""hero-banner-v2.png"", ""FILE-891"", ""192.168.1.108"", ""Jan 15, 2024 1:45 PM"", ""51 minutes ago""),
        new(""act-005"", ""delete"", ""Deleted draft document"", ""Lisa Thompson"", ""lisa@company.com"", ""Document"", ""Q4 Report Draft"", ""DOC-234"", ""192.168.1.115"", ""Jan 15, 2024 1:30 PM"", ""1 hour ago""),
        new(""act-006"", ""invite"", ""Invited team member"", ""James Wilson"", ""james@company.com"", ""User"", ""anna.m@company.com"", ""INV-056"", ""192.168.1.102"", ""Jan 15, 2024 12:15 PM"", ""2 hours ago""),
        new(""act-007"", ""settings"", ""Changed notification preferences"", ""Anna Martinez"", ""anna@company.com"", ""Settings"", ""Notifications"", ""SET-001"", ""192.168.1.120"", ""Jan 15, 2024 11:30 AM"", ""3 hours ago""),
        new(""act-008"", ""view"", ""Viewed sensitive report"", ""Michael Brown"", ""michael@company.com"", ""Report"", ""Financial Summary"", ""RPT-078"", ""192.168.1.118"", ""Jan 15, 2024 10:45 AM"", ""4 hours ago""),
        new(""act-009"", ""logout"", ""Logged out"", ""Sarah Chen"", ""sarah@company.com"", null, null, null, ""192.168.1.105"", ""Jan 15, 2024 10:00 AM"", ""5 hours ago""),
        new(""act-010"", ""create"", ""Created API key"", ""David Kim"", ""david@company.com"", ""API Key"", ""Production Key"", ""KEY-012"", ""192.168.1.108"", ""Jan 15, 2024 9:30 AM"", ""5 hours ago""),
    ];

    private static readonly int _todayCount = _activities.Length;
    private static readonly int _createCount = _activities.Count(a => a.Action == ""create"");
    private static readonly int _updateCount = _activities.Count(a => a.Action == ""update"");
    private static readonly int _deleteCount = _activities.Count(a => a.Action == ""delete"");

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();

    private static RenderFragment GetActionIcon(string action) => action switch
    {
