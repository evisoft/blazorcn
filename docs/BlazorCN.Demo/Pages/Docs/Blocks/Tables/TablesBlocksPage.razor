    private static readonly Role[] _roles =
    [
        new(""admin"", ""Admin"", ""Full system access"", true),
        new(""manager"", ""Manager"", ""Team management access"", false),
        new(""editor"", ""Editor"", ""Content editing access"", false),
        new(""viewer"", ""Viewer"", ""Read-only access"", false),
    ];

    private static readonly Permission[] _permissions =
    [
        new(""users.view"", ""View users"", ""See user list and profiles"", ""User Management""),
        new(""users.create"", ""Create users"", ""Add new user accounts"", ""User Management""),
        new(""users.edit"", ""Edit users"", ""Modify user information"", ""User Management""),
        new(""users.delete"", ""Delete users"", ""Remove user accounts"", ""User Management""),
        new(""content.view"", ""View content"", ""Access published content"", ""Content""),
        new(""content.create"", ""Create content"", ""Add new content items"", ""Content""),
        new(""content.edit"", ""Edit content"", ""Modify existing content"", ""Content""),
        new(""content.publish"", ""Publish content"", ""Make content live"", ""Content""),
        new(""content.delete"", ""Delete content"", ""Remove content items"", ""Content""),
        new(""settings.view"", ""View settings"", ""See system configuration"", ""Settings""),
        new(""settings.edit"", ""Edit settings"", ""Modify system configuration"", ""Settings""),
        new(""analytics.view"", ""View analytics"", ""Access reports and dashboards"", ""Analytics""),
        new(""analytics.export"", ""Export data"", ""Download analytics data"", ""Analytics""),
    ];

    private static readonly string[] _modules = _permissions.Select(p => p.Module).Distinct().ToArray();

    private Dictionary<string, HashSet<string>> _permissionState = new()
    {
        [""admin""] = new(_permissions.Select(p => p.Id)),
        [""manager""] = new([""users.view"", ""users.create"", ""users.edit"", ""content.view"", ""content.create"", ""content.edit"", ""content.publish"", ""content.delete"", ""settings.view"", ""analytics.view"", ""analytics.export""]),
        [""editor""] = new([""users.view"", ""content.view"", ""content.create"", ""content.edit"", ""analytics.view""]),
        [""viewer""] = new([""users.view"", ""content.view"", ""analytics.view""]),
    };

    private int GetPermissionCount(string roleId) =>
        _permissionState.ContainsKey(roleId) ? _permissionState[roleId].Count : 0;

    private void TogglePermission(string roleId, string permId)
    {
        if (!_permissionState.ContainsKey(roleId)) return;
        if (!_permissionState[roleId].Remove(permId))
        {
            _permissionState[roleId].Add(permId);
        }
    }

    private static RenderFragment GetRoleIcon(string roleId) => roleId switch
    {
        ""admin"" => @<LucideCrownCn Size=""16"" Class=""h-4 w-4"" />,
        ""manager"" => @<LucideShieldCheckCn Size=""16"" Class=""h-4 w-4"" />,
        ""editor"" => @<LucideShieldCn Size=""16"" Class=""h-4 w-4"" />,
        _ => @<LucideUserCn Size=""16"" Class=""h-4 w-4"" />,
    };
}";

