        public bool IsLocked { get; set; }
        public string? LockReason { get; set; }
    }

    private List<PermissionItem> _permissions = new()
    {
        new() { Id = ""1"", Name = ""User Profiles"", Description = ""Access to user profile data"", IconName = ""Eye"", CanView = true, CanEdit = true, CanDelete = false, CanShare = true, IsLocked = false },
        new() { Id = ""2"", Name = ""Financial Reports"", Description = ""Revenue and expense reports"", IconName = ""Download"", CanView = true, CanEdit = false, CanDelete = false, CanShare = false, IsLocked = true, LockReason = ""Requires admin approval"" },
        new() { Id = ""3"", Name = ""Team Settings"", Description = ""Team configuration options"", IconName = ""Shield"", CanView = true, CanEdit = true, CanDelete = true, CanShare = true, IsLocked = false },
        new() { Id = ""4"", Name = ""Notifications"", Description = ""Email and push notifications"", IconName = ""Bell"", CanView = true, CanEdit = true, CanDelete = false, CanShare = false, IsLocked = false },
        new() { Id = ""5"", Name = ""API Access"", Description = ""API keys and webhooks"", IconName = ""Lock"", CanView = true, CanEdit = false, CanDelete = false, CanShare = false, IsLocked = true, LockReason = ""Enterprise plan required"" },
        new() { Id = ""6"", Name = ""Audit Logs"", Description = ""Activity and security logs"", IconName = ""Eye"", CanView = true, CanEdit = false, CanDelete = false, CanShare = true, IsLocked = false },
        new() { Id = ""7"", Name = ""Integrations"", Description = ""Third-party app connections"", IconName = ""Share2"", CanView = true, CanEdit = true, CanDelete = true, CanShare = false, IsLocked = false },
        new() { Id = ""8"", Name = ""Billing Info"", Description = ""Payment and subscription data"", IconName = ""Mail"", CanView = false, CanEdit = false, CanDelete = false, CanShare = false, IsLocked = true, LockReason = ""Owner access only"" },
    };

    private int _enabledCount => _permissions.Count(p => p.CanView || p.CanEdit || p.CanDelete || p.CanShare);

    private RenderFragment GetIcon(string name) => name switch
    {
        ""Eye"" => @<LucideEyeCn Size=""16"" Class=""h-4 w-4 text-muted-foreground"" />,
        ""Download"" => @<LucideDownloadCn Size=""16"" Class=""h-4 w-4 text-muted-foreground"" />,
        ""Shield"" => @<LucideShieldCn Size=""16"" Class=""h-4 w-4 text-muted-foreground"" />,
        ""Bell"" => @<LucideBellCn Size=""16"" Class=""h-4 w-4 text-muted-foreground"" />,
        ""Lock"" => @<LucideLockCn Size=""16"" Class=""h-4 w-4 text-muted-foreground"" />,
        ""Share2"" => @<LucideShare2Cn Size=""16"" Class=""h-4 w-4 text-muted-foreground"" />,
        ""Mail"" => @<LucideMailCn Size=""16"" Class=""h-4 w-4 text-muted-foreground"" />,
        _ => @<LucideEyeCn Size=""16"" Class=""h-4 w-4 text-muted-foreground"" />,
    };

    private void TogglePermission(string id, string key, bool value)
    {
        var perm = _permissions.FirstOrDefault(p => p.Id == id);
        if (perm == null || perm.IsLocked) return;
        switch (key)
        {
            case ""CanView"": perm.CanView = value; break;
            case ""CanEdit"": perm.CanEdit = value; break;
            case ""CanDelete"": perm.CanDelete = value; break;
            case ""CanShare"": perm.CanShare = value; break;
        }
    }

    private void ToggleAll(string id, bool value)
    {
        var perm = _permissions.FirstOrDefault(p => p.Id == id);
        if (perm == null || perm.IsLocked) return;
        perm.CanView = value;
        perm.CanEdit = false;
        perm.CanDelete = false;
        perm.CanShare = false;
    }
}";

