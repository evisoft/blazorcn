@* ============================================================
   Block: tables-density
   Title: Tables Density
   Description: Data table component with density toggle for compact, comfortable, and spacious row heights
   Dependencies: BadgeCn, TableCn, ToggleGroupCn
   Source: original/blocks/tables/tables-density.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <p class="text-sm text-muted-foreground">@_contacts.Length contacts</p>
            <ToggleGroupCn Type="ToggleGroupType.Single" Value="@_density" ValueChanged="v => _density = v ?? _density">
                <ToggleGroupItemCn Value="@("compact")" Class="gap-2" aria-label="Compact density">
                    <LucideAlignJustifyCn Size="16" Class="h-4 w-4" />
                    <span class="hidden sm:inline">Compact</span>
                </ToggleGroupItemCn>
                <ToggleGroupItemCn Value="@("comfortable")" Class="gap-2" aria-label="Comfortable density">
                    <LucideAlignVerticalJustifyCenterCn Size="16" Class="h-4 w-4" />
                    <span class="hidden sm:inline">Comfortable</span>
                </ToggleGroupItemCn>
                <ToggleGroupItemCn Value="@("spacious")" Class="gap-2" aria-label="Spacious density">
                    <LucideAlignVerticalSpaceAroundCn Size="16" Class="h-4 w-4" />
                    <span class="hidden sm:inline">Spacious</span>
                </ToggleGroupItemCn>
            </ToggleGroupCn>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="@Cn.Merge("font-semibold text-foreground", GetHeaderClass())">Name</TableHeadCn>
                        <TableHeadCn Class="@Cn.Merge("font-semibold text-foreground", GetHeaderClass())">Email</TableHeadCn>
                        <TableHeadCn Class="@Cn.Merge("font-semibold text-foreground", GetHeaderClass())">Role</TableHeadCn>
                        <TableHeadCn Class="@Cn.Merge("font-semibold text-foreground", GetHeaderClass())">Department</TableHeadCn>
                        <TableHeadCn Class="@Cn.Merge("font-semibold text-foreground", GetHeaderClass())">Status</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var contact in _contacts)
                    {
                        var (statusLabel, statusClass) = GetStatusBadge(contact.Status);

                        <TableRowCn>
                            <TableCellCn Class="@Cn.Merge("font-medium", GetCellClass())">@contact.Name</TableCellCn>
                            <TableCellCn Class="@Cn.Merge("text-muted-foreground", GetCellClass())">@contact.Email</TableCellCn>
                            <TableCellCn Class="@GetCellClass()">@contact.Role</TableCellCn>
                            <TableCellCn Class="@Cn.Merge("text-muted-foreground", GetCellClass())">@contact.Department</TableCellCn>
                            <TableCellCn Class="@GetCellClass()">
                                <BadgeCn Class="@statusClass" Variant="BadgeVariant.Outline">@statusLabel</BadgeCn>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>
    </div>
</div>

@code {
    private record ContactItem(string Id, string Name, string Email, string Role, string Department, string Status);

    private string _density = "comfortable";

    private static readonly ContactItem[] _contacts =
    [
        new("1", "Alice Johnson", "alice.j@company.com", "Senior Developer", "Engineering", "active"),
        new("2", "Bob Smith", "bob.s@company.com", "Product Manager", "Product", "active"),
        new("3", "Carol White", "carol.w@company.com", "UX Designer", "Design", "away"),
        new("4", "David Brown", "david.b@company.com", "DevOps Engineer", "Engineering", "active"),
        new("5", "Eve Davis", "eve.d@company.com", "Marketing Lead", "Marketing", "offline"),
        new("6", "Frank Miller", "frank.m@company.com", "Data Analyst", "Analytics", "active"),
        new("7", "Grace Lee", "grace.l@company.com", "HR Manager", "HR", "away"),
        new("8", "Henry Taylor", "henry.t@company.com", "Sales Director", "Sales", "active"),
    ];

    private string GetCellClass() => _density switch
    {
        "compact" => "py-1 px-2 text-xs",
        "spacious" => "py-4 px-6 text-base",
        _ => "py-2 px-4 text-sm",
    };

    private string GetHeaderClass() => _density switch
    {
        "compact" => "py-2 px-2 text-xs",
        "spacious" => "py-4 px-6 text-base",
        _ => "py-3 px-4 text-sm",
    };

    private static (string Label, string ClassName) GetStatusBadge(string status) => status switch
    {
        "active" => ("Active", "border-green-200 text-green-700"),
        "away" => ("Away", "border-orange-200 text-orange-700"),
        _ => ("Offline", ""),
    };
}
