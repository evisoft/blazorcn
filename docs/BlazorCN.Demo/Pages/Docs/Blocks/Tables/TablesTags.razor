@* ============================================================
   Block: tables-tags
   Title: Tables Tags
   Description: Table component with inline tag badges for multi-category labeling in content management systems
   Dependencies: BadgeCn, ButtonCn, TableCn, TooltipCn
   Source: original/blocks/tables/tables-tags.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Articles</h3>
                <p class="text-sm text-muted-foreground">
                    @_filteredArticles.Length articles
                    @if (_activeTag != null)
                    {
                        <span>
                            tagged with
                            <BadgeCn Class="ml-1" Variant="BadgeVariant.Secondary">@_activeTag</BadgeCn>
                            <ButtonCn Class="h-5 px-1 ml-1" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="ClearFilter">Clear</ButtonCn>
                        </span>
                    }
                </p>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-sm text-muted-foreground">@_allTagNames.Length tags</span>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    <LucidePlusCn Size="16" Class="mr-1 h-4 w-4" />
                    New Article
                </ButtonCn>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-64 font-semibold text-foreground">Title</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Author</TableHeadCn>
                        <TableHeadCn Class="w-52 font-semibold text-foreground">Tags</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-right">Views</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-right">Comments</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Published</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var article in _filteredArticles)
                    {
                        var visibleTags = article.Tags.Take(3).ToArray();
                        var remainingTags = article.Tags.Skip(3).ToArray();

                        <TableRowCn>
                            <TableCellCn Class="font-medium truncate" title="@article.Title">@article.Title</TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@article.Author</TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-1 flex-wrap">
                                    @foreach (var tag in visibleTags)
                                    {
                                        var tagName = tag.Name;
                                        <BadgeCn Class="@Cn.Merge("cursor-pointer text-xs font-normal", GetTagColor(tag.Color))" Variant="BadgeVariant.Secondary" @onclick="() => FilterByTag(tagName)">
                                            @tag.Name
                                        </BadgeCn>
                                    }
                                    @if (remainingTags.Length > 0)
                                    {
                                        <TooltipCn>
                                            <TooltipTriggerCn>
                                                <BadgeCn Class="cursor-pointer text-xs font-normal" Variant="BadgeVariant.Outline">+@remainingTags.Length</BadgeCn>
                                            </TooltipTriggerCn>
                                            <TooltipContentCn>
                                                <div class="flex flex-col gap-1">
                                                    @foreach (var tag in remainingTags)
                                                    {
                                                        <span>@tag.Name</span>
                                                    }
                                                </div>
                                            </TooltipContentCn>
                                        </TooltipCn>
                                    }
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <div class="flex items-center justify-end gap-1 text-muted-foreground">
                                    <LucideEyeCn Size="14" Class="h-3.5 w-3.5" />
                                    <span class="text-sm">@FormatNumber(article.Views)</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <div class="flex items-center justify-end gap-1 text-muted-foreground">
                                    <LucideMessageSquareCn Size="14" Class="h-3.5 w-3.5" />
                                    <span class="text-sm">@article.CommentCount</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@article.Published</TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Click tags to filter articles. Hover +N to see all tags.
        </p>
    </div>
</div>

@code {
    private record TagItem(string Id, string Name, string Color);
    private record Article(string Id, string Title, string Author, TagItem[] Tags, int Views, int CommentCount, string Published);

    private static readonly Article[] _allArticles =
    [
        new("1", "Getting Started with React Server Components", "Sarah Chen",
            [new("t1","React","blue"), new("t2","Next.js","purple"), new("t3","Tutorial","green")],
            12453, 89, "Jan 15"),
        new("2", "Building Type-Safe APIs with tRPC", "Marcus Johnson",
            [new("t4","TypeScript","blue"), new("t5","API","orange"), new("t6","Backend","purple"), new("t7","Tutorial","green"), new("t8","Advanced","pink")],
            8721, 56, "Jan 12"),
        new("3", "CSS Grid vs Flexbox: When to Use Each", "Emily Rodriguez",
            [new("t9","CSS","pink"), new("t10","Design","purple")],
            15234, 124, "Jan 10"),
        new("4", "State Management in 2024: A Comparison", "David Kim",
            [new("t11","React","blue"), new("t12","State","orange"), new("t13","Zustand","green"), new("t14","Redux","purple"), new("t15","Jotai","pink"), new("t16","Comparison","default")],
            9876, 203, "Jan 8"),
        new("5", "Optimizing Database Queries in Prisma", "Lisa Thompson",
            [new("t17","Database","orange"), new("t18","Prisma","purple"), new("t19","Performance","green")],
            6543, 47, "Jan 5"),
        new("6", "Authentication Patterns for Modern Apps", "James Wilson",
            [new("t20","Auth","orange"), new("t21","Security","pink"), new("t22","JWT","blue"), new("t23","OAuth","purple")],
            11234, 78, "Jan 3"),
        new("7", "Introduction to Edge Computing", "Anna Martinez",
            [new("t24","Edge","blue"), new("t25","Serverless","green")],
            4521, 32, "Jan 1"),
        new("8", "Testing React Components: Best Practices", "Michael Brown",
            [new("t26","React","blue"), new("t27","Testing","green"), new("t28","Jest","orange"), new("t29","Best Practices","default")],
            7892, 65, "Dec 28"),
    ];

    private static readonly string[] _allTagNames = _allArticles.SelectMany(a => a.Tags).Select(t => t.Name).Distinct().ToArray();

    private string? _activeTag;
    private Article[] _filteredArticles = _allArticles;

    private void FilterByTag(string tagName)
    {
        _activeTag = _activeTag == tagName ? null : tagName;
        _filteredArticles = _activeTag != null
            ? _allArticles.Where(a => a.Tags.Any(t => t.Name == _activeTag)).ToArray()
            : _allArticles;
    }

    private void ClearFilter()
    {
        _activeTag = null;
        _filteredArticles = _allArticles;
    }

    private static string GetTagColor(string color) => color switch
    {
        "blue" => "bg-blue-100 text-blue-700 hover:bg-blue-200",
        "green" => "bg-green-100 text-green-700 hover:bg-green-200",
        "orange" => "bg-orange-100 text-orange-700 hover:bg-orange-200",
        "purple" => "bg-purple-100 text-purple-700 hover:bg-purple-200",
        "pink" => "bg-pink-100 text-pink-700 hover:bg-pink-200",
        _ => "",
    };

    private static string FormatNumber(int num) =>
        num >= 1000 ? $"{num / 1000.0:F1}K" : num.ToString();
}
