@* ============================================================
   Block: tables-expandable
   Title: Tables Expandable
   Description: Expandable table rows component with chevron toggle and animated details panel for React data displays
   Long Description: Action buttons with status badges
   Dependencies: BadgeCn, ButtonCn, TableCn, LucideChevronDownCn
   Source: original/blocks/tables/tables-expandable.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
        <TableCn Class="table-fixed" style="width: 850px">
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn Class="w-12"></TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Date</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Merchant</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Type</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Amount</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Status</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var transaction in _transactions)
                {
                    var isExpanded = _expandedIds.Contains(transaction.Id);
                    <TableRowCn>
                        <TableCellCn>
                            <ButtonCn
                                Class="h-8 w-8 p-0"
                                @onclick="@(() => ToggleRow(transaction.Id))"
                                Size="ButtonSize.Sm"
                                Variant="ButtonVariant.Ghost">
                                <LucideChevronDownCn Size="16" Class="@Cn.Merge(Cn.Merge("h-4 w-4 transition-transform duration-200", isExpanded ? "rotate-180" : ""))" />
                            </ButtonCn>
                        </TableCellCn>
                        <TableCellCn Class="text-muted-foreground">@transaction.Date</TableCellCn>
                        <TableCellCn Class="font-medium">@transaction.Merchant</TableCellCn>
                        <TableCellCn>
                            @switch (transaction.Type)
                            {
                                case "purchase":
                                    <BadgeCn>Purchase</BadgeCn>
                                    break;
                                case "refund":
                                    <BadgeCn Class="border-green-200 text-green-700" Variant="BadgeVariant.Outline">Refund</BadgeCn>
                                    break;
                                case "subscription":
                                    <BadgeCn Class="border-purple-200 text-purple-700" Variant="BadgeVariant.Outline">Subscription</BadgeCn>
                                    break;
                            }
                        </TableCellCn>
                        <TableCellCn Class="font-mono font-semibold">
                            @(transaction.Type == "refund" ? "+" : "-")$@transaction.Amount.ToString("F2")
                        </TableCellCn>
                        <TableCellCn>
                            @switch (transaction.Status)
                            {
                                case "completed":
                                    <BadgeCn Class="border-green-200 text-green-700" Variant="BadgeVariant.Outline">Completed</BadgeCn>
                                    break;
                                case "pending":
                                    <BadgeCn Class="border-orange-200 text-orange-700" Variant="BadgeVariant.Outline">Pending</BadgeCn>
                                    break;
                                case "failed":
                                    <BadgeCn Class="border-red-200 text-red-700" Variant="BadgeVariant.Outline">Failed</BadgeCn>
                                    break;
                            }
                        </TableCellCn>
                    </TableRowCn>
                    <TableRowCn Class="hover:bg-transparent">
                        <TableCellCn Class="p-0" ColSpan="6">
                            <div class="@(Cn.Merge("overflow-hidden transition-all duration-300 ease-in-out", isExpanded ? "max-h-96 opacity-100" : "max-h-0 opacity-0"))">
                                <div class="border-border border-t bg-muted/30 p-4">
                                    <div class="grid gap-3">
                                        <div>
                                            <p class="text-sm font-medium">Description</p>
                                            <p class="text-sm text-muted-foreground">@transaction.Description</p>
                                        </div>
                                        <div class="grid grid-cols-3 gap-4">
                                            <div>
                                                <p class="text-sm font-medium">Payment Method</p>
                                                <p class="text-sm text-muted-foreground">@transaction.PaymentMethod</p>
                                            </div>
                                            <div>
                                                <p class="text-sm font-medium">Transaction ID</p>
                                                <p class="font-mono text-sm text-muted-foreground">@transaction.TransactionId</p>
                                            </div>
                                            <div>
                                                <p class="text-sm font-medium">Category</p>
                                                <BadgeCn Variant="BadgeVariant.Secondary">@transaction.Category</BadgeCn>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</div>

@code {
    private record TransactionItem(string Id, string Type, string Merchant, decimal Amount, string Date, string Status, string Description, string PaymentMethod, string TransactionId, string Category);

    private HashSet<string> _expandedIds = new();

    private void ToggleRow(string id)
    {
        if (!_expandedIds.Add(id))
            _expandedIds.Remove(id);
    }

    private static readonly TransactionItem[] _transactions =
    [
        new("1", "purchase", "Amazon", 157.99m, "2024-01-15", "completed", "Wireless mechanical keyboard with RGB backlighting and hot-swappable switches", "Visa \u2022\u2022\u2022\u2022 4242", "TXN-2024-001-ABC", "Electronics"),
        new("2", "subscription", "Netflix", 15.99m, "2024-01-14", "completed", "Monthly subscription - Premium plan with 4K streaming", "Mastercard \u2022\u2022\u2022\u2022 5555", "TXN-2024-002-DEF", "Entertainment"),
        new("3", "purchase", "Whole Foods", 87.43m, "2024-01-13", "completed", "Weekly grocery shopping including organic produce and essentials", "Visa \u2022\u2022\u2022\u2022 4242", "TXN-2024-003-GHI", "Groceries"),
        new("4", "refund", "Best Buy", 45.00m, "2024-01-12", "pending", "Refund for returned HDMI cable that was incompatible", "Visa \u2022\u2022\u2022\u2022 4242", "TXN-2024-004-JKL", "Electronics"),
        new("5", "purchase", "Uber", 23.50m, "2024-01-11", "completed", "Ride from downtown to airport terminal 2", "Amex \u2022\u2022\u2022\u2022 1234", "TXN-2024-005-MNO", "Transportation"),
        new("6", "purchase", "Starbucks", 12.75m, "2024-01-10", "failed", "Morning coffee and pastry - payment declined due to insufficient funds", "Visa \u2022\u2022\u2022\u2022 4242", "TXN-2024-006-PQR", "Food & Dining"),
    ];
}
