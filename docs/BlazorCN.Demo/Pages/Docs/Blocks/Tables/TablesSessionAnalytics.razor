@* ============================================================
   Block: tables-session-analytics
   Title: TablesSessionAnalytics
   Description: User session analytics table with duration, device, bounce rate for React product dashboards built with shadcn/ui.
   Source: original/blocks/tables/tables-session-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Session Analytics</h3>
                <p class="text-xs text-muted-foreground">
                    @_sessions.Length sessions · @_avgPageViews avg pages · @_avgBounce% bounce rate
                </p>
            </div>
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <div class="flex items-center gap-1.5">
                    <span class="text-2xl font-semibold tabular-nums text-foreground">
                        @_avgDuration s
                    </span>
                    <span>avg duration</span>
                </div>
            </div>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Session</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Device</TableHeadCn>
                    <TableHeadCn Class="cursor-pointer text-xs font-medium text-muted-foreground" @onclick="@(() => HandleSort(SortField.PageViews))">
                        <div class="flex items-center gap-1">
                            Pages
                            @RenderSortIndicator(SortField.PageViews)
                        </div>
                    </TableHeadCn>
                    <TableHeadCn Class="cursor-pointer text-xs font-medium text-muted-foreground" @onclick="@(() => HandleSort(SortField.Duration))">
                        <div class="flex items-center gap-1">
                            Duration
                            @RenderSortIndicator(SortField.Duration)
                        </div>
                    </TableHeadCn>
                    <TableHeadCn Class="cursor-pointer text-xs font-medium text-muted-foreground" @onclick="@(() => HandleSort(SortField.BounceRate))">
                        <div class="flex items-center gap-1">
                            Bounce
                            @RenderSortIndicator(SortField.BounceRate)
                        </div>
                    </TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Location</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Referrer</TableHeadCn>
                    <TableHeadCn Class="text-right text-xs font-medium text-muted-foreground">Started</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var session in GetSorted())
                {
                    var sess = session;
                    <TableRowCn Class="hover:bg-muted/50">
                        <TableCellCn>
                            <div>
                                <span class="font-mono text-xs text-muted-foreground">@sess.UserId</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1.5">
                                @GetDeviceIcon(sess.Device)
                                <span class="text-xs text-muted-foreground">@sess.Browser</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="text-sm font-medium tabular-nums">@sess.PageViews</span>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="font-mono text-xs text-muted-foreground">@sess.Duration</span>
                        </TableCellCn>
                        <TableCellCn>
                            @if (sess.BounceRate > 0)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-red-500/10 text-xs font-normal text-red-700">@sess.BounceRate%</BadgeCn>
                            }
                            else
                            {
                                <span class="text-xs text-muted-foreground">-</span>
                            }
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1.5">
                                <LucideGlobeCn Size="12" Class="size-3 text-muted-foreground/60" />
                                <span class="text-xs text-muted-foreground">@sess.CountryCode</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">@sess.Referrer</BadgeCn>
                        </TableCellCn>
                        <TableCellCn Class="whitespace-nowrap text-right text-xs text-muted-foreground">@sess.StartedAt</TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private enum SortField { PageViews, Duration, BounceRate }

    private record Session(
        string Id, string UserId, int PageViews, string Duration, int DurationSeconds,
        int BounceRate, string Device, string Browser, string Country, string CountryCode,
        string Referrer, string StartedAt);

    private static readonly Session[] _sessions =
    [
        new("ses-001", "usr-8f2k", 12, "8m 42s", 522, 0, "desktop", "Chrome 122", "United States", "US", "google.com", "Mar 24, 2026 14:32"),
        new("ses-002", "usr-3m7n", 1, "0m 08s", 8, 100, "mobile", "Safari 19", "United Kingdom", "GB", "twitter.com", "Mar 24, 2026 14:28"),
        new("ses-003", "usr-9k4j", 6, "4m 15s", 255, 0, "laptop", "Firefox 124", "Germany", "DE", "direct", "Mar 24, 2026 14:15"),
        new("ses-004", "usr-2x8v", 3, "1m 32s", 92, 0, "tablet", "Safari 19", "Canada", "CA", "linkedin.com", "Mar 24, 2026 13:45"),
        new("ses-005", "usr-7w3r", 18, "14m 05s", 845, 0, "desktop", "Chrome 122", "Australia", "AU", "google.com", "Mar 24, 2026 13:12"),
        new("ses-006", "usr-1p6m", 1, "0m 03s", 3, 100, "mobile", "Chrome 122", "India", "IN", "facebook.com", "Mar 24, 2026 12:58"),
        new("ses-007", "usr-5h9n", 8, "5m 48s", 348, 0, "desktop", "Edge 122", "France", "FR", "producthunt.com", "Mar 24, 2026 12:30"),
        new("ses-008", "usr-4f8k", 2, "0m 45s", 45, 50, "mobile", "Safari 19", "Japan", "JP", "direct", "Mar 24, 2026 11:55"),
    ];

    private SortField _sortField = SortField.PageViews;
    private bool _ascending = false;

    private string _avgPageViews => (_sessions.Sum(s => s.PageViews) / (double)_sessions.Length).ToString("F1");
    private int _avgDuration => (int)Math.Round(_sessions.Sum(s => s.DurationSeconds) / (double)_sessions.Length);
    private string _avgBounce => (_sessions.Sum(s => s.BounceRate) / (double)_sessions.Length).ToString("F0");

    private void HandleSort(SortField field)
    {
        if (_sortField == field)
        {
            _ascending = !_ascending;
        }
        else
        {
            _sortField = field;
            _ascending = false;
        }
    }

    private Session[] GetSorted()
    {
        IEnumerable<Session> ordered = _sortField switch
        {
            SortField.PageViews => _ascending ? _sessions.OrderBy(s => s.PageViews) : _sessions.OrderByDescending(s => s.PageViews),
            SortField.Duration => _ascending ? _sessions.OrderBy(s => s.DurationSeconds) : _sessions.OrderByDescending(s => s.DurationSeconds),
            SortField.BounceRate => _ascending ? _sessions.OrderBy(s => s.BounceRate) : _sessions.OrderByDescending(s => s.BounceRate),
            _ => _sessions.AsEnumerable(),
        };
        return ordered.ToArray();
    }

    private RenderFragment RenderSortIndicator(SortField field)
    {
        if (_sortField != field)
            return builder => { };
        return _ascending
            ? @<LucideArrowUpCn Size="12" Class="size-3" />
            : @<LucideArrowDownCn Size="12" Class="size-3" />;
    }

    private RenderFragment GetDeviceIcon(string device) => device switch
    {
        "desktop" => @<LucideMonitorCn Size="14" Class="size-3.5 text-muted-foreground" />,
        "mobile" => @<LucideSmartphoneCn Size="14" Class="size-3.5 text-muted-foreground" />,
        "tablet" => @<LucideTabletCn Size="14" Class="size-3.5 text-muted-foreground" />,
        "laptop" => @<LucideLaptopCn Size="14" Class="size-3.5 text-muted-foreground" />,
        _ => builder => { },
    };
}
