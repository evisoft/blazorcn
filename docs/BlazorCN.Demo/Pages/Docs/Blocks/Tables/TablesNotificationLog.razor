@* ============================================================
   Block: tables-notification-log
   Title: TablesNotificationLog
   Description: Multi-channel notification delivery log with status tracking. Built with shadcn/ui Table, React, Next.js, and Tailwind CSS.
   Source: original/blocks/tables/tables-notification-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Notification Log</h3>
                <p class="text-xs text-muted-foreground">
                    @_deliveredCount delivered · @_failedCount failed of @_notifications.Length total
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                @foreach (var ch in _channels)
                {
                    var channel = ch;
                    <ButtonCn
                        Variant="@(_channelFilter == channel ? ButtonVariant.Default : ButtonVariant.Outline)"
                        Size="ButtonSize.Sm"
                        Class="h-6 px-2 text-xs"
                        OnClick="@(() => _channelFilter = channel)">
                        @GetChannelLabel(channel)
                    </ButtonCn>
                }
            </div>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="w-8 text-xs font-medium text-muted-foreground"><span class="sr-only">Expand</span></TableHeadCn>
                    <TableHeadCn Class="w-10 text-xs font-medium text-muted-foreground"><span class="sr-only">Channel</span></TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Subject</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Recipient</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Status</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground text-right">Sent</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var ntf in GetFiltered())
                {
                    var item = ntf;
                    <TableRowCn Class="cursor-pointer hover:bg-muted/50" @onclick="@(() => ToggleExpanded(item.Id))">
                        <TableCellCn Class="w-8 px-2">
                            <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground transition-transform duration-200", _expanded == item.Id ? "rotate-90" : "")" />
                        </TableCellCn>
                        <TableCellCn Class="w-10 px-2">
                            @GetChannelIcon(item.Channel)
                        </TableCellCn>
                        <TableCellCn>
                            <span class="truncate text-sm font-medium max-w-60 block">@item.Subject</span>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="text-xs text-muted-foreground font-mono">@item.Recipient</span>
                        </TableCellCn>
                        <TableCellCn>
                            @GetStatusIndicator(item.Status)
                        </TableCellCn>
                        <TableCellCn Class="text-right text-xs text-muted-foreground whitespace-nowrap">
                            @item.SentAt
                        </TableCellCn>
                    </TableRowCn>
                    @if (_expanded == item.Id)
                    {
                        <TableRowCn>
                            <TableCellCn ColSpan="6" Class="bg-muted/30 px-6 py-3">
                                <div class="flex items-center gap-6 text-xs">
                                    <div>
                                        <span class="text-muted-foreground">Template</span>
                                        <p class="mt-0.5 font-mono font-medium">@item.Template</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Opened</span>
                                        <p class="mt-0.5 font-medium">@(item.OpenedAt ?? "Not opened")</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">ID</span>
                                        <p class="mt-0.5 font-mono font-medium">@item.Id</p>
                                    </div>
                                    @if (item.Status == "failed" || item.Status == "bounced")
                                    {
                                        <div class="ml-auto">
                                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">Retry</ButtonCn>
                                        </div>
                                    }
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record NotificationEntry(string Id, string Subject, string Channel, string Recipient, string Status, string SentAt, string? OpenedAt, string Template);

    private static readonly NotificationEntry[] _notifications =
    [
        new("ntf-001", "Your invoice is ready", "email", "sarah@example.com", "opened", "Mar 24, 2026 14:32", "Mar 24, 2026 14:35", "invoice-ready"),
        new("ntf-002", "Verification code: 482910", "sms", "+1 (555) 012-3456", "delivered", "Mar 24, 2026 14:28", null, "otp-code"),
        new("ntf-003", "New comment on your post", "push", "marcus.johnson", "delivered", "Mar 24, 2026 14:15", null, "comment-notification"),
        new("ntf-004", "Welcome to the platform", "email", "emily.r@company.io", "bounced", "Mar 24, 2026 13:45", null, "welcome-email"),
        new("ntf-005", "Your trial expires in 3 days", "in-app", "david.kim", "delivered", "Mar 24, 2026 12:00", null, "trial-expiry"),
        new("ntf-006", "Password reset request", "email", "james@startup.co", "opened", "Mar 24, 2026 11:22", "Mar 24, 2026 11:24", "password-reset"),
        new("ntf-007", "Order shipped - tracking #TRK892", "sms", "+1 (555) 987-6543", "failed", "Mar 24, 2026 10:55", null, "order-shipped"),
        new("ntf-008", "Weekly usage report", "email", "anna.m@enterprise.com", "pending", "Mar 24, 2026 10:30", null, "weekly-report"),
        new("ntf-009", "Team member joined workspace", "in-app", "lisa.thompson", "delivered", "Mar 24, 2026 09:48", null, "team-join"),
        new("ntf-010", "Security alert: new login", "push", "michael.brown", "delivered", "Mar 24, 2026 09:12", null, "security-alert"),
    ];

    private static readonly string[] _channels = ["all", "email", "sms", "push", "in-app"];

    private static readonly int _deliveredCount = _notifications.Count(n => n.Status == "delivered" || n.Status == "opened");
    private static readonly int _failedCount = _notifications.Count(n => n.Status == "failed" || n.Status == "bounced");

    private string _channelFilter = "all";
    private string? _expanded = null;

    private IEnumerable<NotificationEntry> GetFiltered() =>
        _channelFilter == "all" ? _notifications : _notifications.Where(n => n.Channel == _channelFilter);

    private void ToggleExpanded(string id) =>
        _expanded = _expanded == id ? null : id;

    private static string GetChannelLabel(string ch) => ch switch
    {
        "all" => "All",
        "in-app" => "In-App",
        _ => ch.ToUpperInvariant(),
    };

    private RenderFragment GetChannelIcon(string channel) => channel switch
    {
        "email" => @<LucideIconCn Name="mail" Size="14" Class="size-3.5 text-blue-600" />,
        "sms" => @<LucideIconCn Name="message-square" Size="14" Class="size-3.5 text-emerald-600" />,
        "push" => @<LucideIconCn Name="smartphone" Size="14" Class="size-3.5 text-purple-600" />,
        "in-app" => @<LucideIconCn Name="bell" Size="14" Class="size-3.5 text-amber-600" />,
        _ => @<span></span>,
    };

    private static RenderFragment GetStatusIndicator(string status) => status switch
    {
        "delivered" => @<div class="flex items-center gap-1.5">
                           <span class="size-1.5 rounded-full bg-emerald-500"></span>
                           <span class="text-xs text-muted-foreground">Delivered</span>
                       </div>,
        "opened" => @<div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                        <span class="text-xs text-muted-foreground">Opened</span>
                    </div>,
        "bounced" => @<div class="flex items-center gap-1.5">
                         <span class="size-1.5 rounded-full bg-amber-500"></span>
                         <span class="text-xs text-muted-foreground">Bounced</span>
                     </div>,
        "failed" => @<div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        <span class="text-xs text-muted-foreground">Failed</span>
                    </div>,
        "pending" => @<div class="flex items-center gap-1.5">
                         <span class="size-1.5 animate-pulse rounded-full bg-muted-foreground"></span>
                         <span class="text-xs text-muted-foreground">Pending</span>
                     </div>,
        _ => @<span></span>,
    };
}
