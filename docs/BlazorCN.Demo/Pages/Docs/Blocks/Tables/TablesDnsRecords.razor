@* ============================================================
   Block: tables-dns-records
   Title: TablesDnsRecords
   Description: DNS record management table with record types, TTL values, and status indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/tables/tables-dns-records.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">DNS Records</h3>
                <p class="text-xs text-muted-foreground">
                    example.com &middot; @_dnsRecords.Length records
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Add Record
            </ButtonCn>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="w-16 text-xs font-medium text-muted-foreground">Type</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Name</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Value</TableHeadCn>
                    <TableHeadCn Class="w-16 text-xs font-medium text-muted-foreground">TTL</TableHeadCn>
                    <TableHeadCn Class="w-20 text-xs font-medium text-muted-foreground">Status</TableHeadCn>
                    <TableHeadCn Class="w-24 text-right text-xs font-medium text-muted-foreground">Actions</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var rec in _dnsRecords)
                {
                    var record = rec;
                    var statusCfg = GetStatusConfig(record.Status);
                    <TableRowCn Class="hover:bg-muted/50">
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-mono text-xs font-normal", GetTypeColor(record.Type))">
                                @record.Type
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="font-mono text-sm">@record.Name</span>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1.5">
                                <span class="max-w-64 truncate font-mono text-xs text-muted-foreground">@record.Value</span>
                                @if (record.Priority.HasValue)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal">
                                        pri:@record.Priority.Value
                                    </BadgeCn>
                                }
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1">
                                <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="font-mono text-xs text-muted-foreground">@FormatTTL(record.Ttl)</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1">
                                @if (record.Status == "propagated")
                                {
                                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-green-600" />
                                }
                                else
                                {
                                    <span class="size-1.5 animate-pulse rounded-full bg-amber-500"></span>
                                }
                                <span class="@Cn.Merge("text-xs", statusCfg.ClassName)">@statusCfg.Label</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center justify-end gap-0.5">
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0" OnClick="@(() => HandleCopy(record.Id, record.Value))">
                                    @if (_copied == record.Id)
                                    {
                                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-green-600" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                    }
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0">
                                    <LucideIconCn Name="pencil" Size="12" Class="size-3" />
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0 text-muted-foreground hover:text-red-600">
                                    <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                                </ButtonCn>
                            </div>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record DnsRecord(string Id, string Type, string Name, string Value, int Ttl, int? Priority, string Status, string LastModified);
    private record StatusConfig(string Label, string ClassName);

    private static readonly DnsRecord[] _dnsRecords =
    [
        new("1",  "A",     "@",    "76.76.21.21",                    300,   null, "propagated", "Mar 20, 2026"),
        new("2",  "A",     "www",  "76.76.21.21",                    300,   null, "propagated", "Mar 20, 2026"),
        new("3",  "CNAME", "api",  "api-gateway.provider.com",       3600,  null, "propagated", "Mar 18, 2026"),
        new("4",  "MX",    "@",    "mail.provider.com",              3600,  10,   "propagated", "Mar 15, 2026"),
        new("5",  "MX",    "@",    "backup-mail.provider.com",       3600,  20,   "propagated", "Mar 15, 2026"),
        new("6",  "TXT",   "@",    "v=spf1 include:_spf.provider.com ~all", 3600, null, "propagated", "Mar 12, 2026"),
        new("7",  "AAAA",  "@",    "2606:4700:3030::6815:1521",      300,   null, "pending",    "Mar 24, 2026"),
        new("8",  "CNAME", "docs", "hosting.gitbook.io",             3600,  null, "pending",    "Mar 24, 2026"),
        new("9",  "NS",    "@",    "ns1.provider.com",               86400, null, "propagated", "Feb 28, 2026"),
    ];

    private string? _copied;

    private void HandleCopy(string id, string value)
    {
        _copied = id;
        // In a real implementation: await JS.InvokeVoidAsync("navigator.clipboard.writeText", value);
    }

    private static string GetTypeColor(string type) => type switch
    {
        "A"     => "bg-blue-500/10 text-blue-700",
        "AAAA"  => "bg-indigo-500/10 text-indigo-700",
        "CNAME" => "bg-purple-500/10 text-purple-700",
        "MX"    => "bg-amber-500/10 text-amber-700",
        "TXT"   => "bg-emerald-500/10 text-emerald-700",
        "NS"    => "bg-slate-500/10 text-slate-700",
        _       => "",
    };

    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        "propagated" => new StatusConfig("Propagated", "text-green-600"),
        "pending"    => new StatusConfig("Pending",    "text-amber-600"),
        "error"      => new StatusConfig("Error",      "text-red-600"),
        _            => new StatusConfig(status,       ""),
    };

    private static string FormatTTL(int seconds)
    {
        if (seconds >= 86400) return $"{seconds / 86400}d";
        if (seconds >= 3600)  return $"{seconds / 3600}h";
        return $"{seconds / 60}m";
    }
}
