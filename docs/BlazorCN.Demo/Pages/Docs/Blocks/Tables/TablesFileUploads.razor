@* ============================================================
   Block: tables-file-uploads
   Title: TablesFileUploads
   Description: File upload history table with status and user attribution. Built with shadcn/ui Table, Badge, and Avatar for React and Next.js using Tailwind CSS.
   Source: original/blocks/tables/tables-file-uploads.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">File Uploads</h3>
                <p class="text-xs text-muted-foreground">
                    @_uploads.Length files · @_totalSizeMB MB total
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                @foreach (var filterType in _filterTypes)
                {
                    var ft = filterType;
                    <ButtonCn
                        Variant="@(_typeFilter == ft ? ButtonVariant.Default : ButtonVariant.Outline)"
                        Size="ButtonSize.Sm"
                        Class="h-6 px-2 text-xs"
                        @onclick="@(() => _typeFilter = ft)">
                        @(ft == "all" ? "All" : (ft.Length > 0 ? char.ToUpper(ft[0]) + ft.Substring(1) : ft))
                    </ButtonCn>
                }
            </div>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">File</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Type</TableHeadCn>
                    <TableHeadCn Class="text-right text-xs font-medium text-muted-foreground">Size</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Status</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Uploaded By</TableHeadCn>
                    <TableHeadCn Class="text-right text-xs font-medium text-muted-foreground">Date</TableHeadCn>
                    <TableHeadCn Class="w-20 text-xs font-medium text-muted-foreground"><span class="sr-only">Actions</span></TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var upload in GetFiltered())
                {
                    var file = upload;
                    <TableRowCn Class="hover:bg-muted/50">
                        <TableCellCn>
                            <div class="flex items-center gap-2">
                                @GetFileIcon(file.Type)
                                <span class="truncate text-sm font-medium max-w-48">@file.Name</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px] font-normal">
                                @GetMimeSubtype(file.MimeType)
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn Class="text-right font-mono text-xs text-muted-foreground">
                            @file.Size
                        </TableCellCn>
                        <TableCellCn>
                            @GetStatusIndicator(file.Status)
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-2">
                                <AvatarCn Class="size-5">
                                    <AvatarFallbackCn Class="text-[9px]">@GetInitials(file.Uploader)</AvatarFallbackCn>
                                </AvatarCn>
                                <span class="text-xs text-muted-foreground">@file.Uploader.Split(' ')[0]</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn Class="text-right text-xs text-muted-foreground whitespace-nowrap">
                            @file.UploadedAt
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center justify-end gap-1">
                                <ButtonCn
                                    Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.Sm"
                                    Class="h-6 w-6 p-0"
                                    Disabled="@(file.Status != "completed")" aria-label="@($"Download {file.Name}")">
                                    <LucideDownloadCn Size="14" Class="size-3.5" />
                                </ButtonCn>
                                <ButtonCn
                                    Variant="ButtonVariant.Ghost"
                                    Size="ButtonSize.Sm"
                                    Class="h-6 w-6 p-0 text-muted-foreground hover:text-red-600" aria-label="@($"Delete {file.Name}")">
                                    <LucideTrash2Cn Size="14" Class="size-3.5" />
                                </ButtonCn>
                            </div>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record UploadedFile(string Id, string Name, string Type, string MimeType, string Size, long SizeBytes, string Status, string Uploader, string UploadedAt);

    private static readonly UploadedFile[] _uploads =
    [
        new("file-001", "hero-banner-2026.png",         "image",       "image/png",          "2.4 MB",  2516582,  "completed",  "Sarah Chen",      "Mar 24, 2026 14:32"),
        new("file-002", "Q1-financial-report.pdf",      "document",    "application/pdf",    "845 KB",  865280,   "completed",  "Marcus Johnson",  "Mar 24, 2026 13:15"),
        new("file-003", "product-demo.mp4",             "video",       "video/mp4",          "48.2 MB", 50537882, "processing", "Emily Rodriguez", "Mar 24, 2026 12:48"),
        new("file-004", "user-analytics-export.csv",    "spreadsheet", "text/csv",           "1.1 MB",  1153434,  "completed",  "David Kim",       "Mar 24, 2026 11:30"),
        new("file-005", "brand-guidelines-v3.pdf",      "document",    "application/pdf",    "12.7 MB", 13316506, "completed",  "Lisa Thompson",   "Mar 23, 2026 16:22"),
        new("file-006", "team-photo-offsite.jpg",       "image",       "image/jpeg",         "3.8 MB",  3984589,  "completed",  "James Wilson",    "Mar 23, 2026 15:05"),
        new("file-007", "revenue-projections.xlsx",     "spreadsheet", "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "524 KB", 536576, "failed", "Anna Martinez", "Mar 23, 2026 14:18"),
        new("file-008", "architecture-diagram.svg",     "image",       "image/svg+xml",      "89 KB",   91136,    "completed",  "Sarah Chen",      "Mar 23, 2026 10:45"),
    ];

    private static readonly string[] _filterTypes = ["all", "image", "document", "video", "spreadsheet"];

    private static readonly long _totalBytes = _uploads.Sum(f => f.SizeBytes);
    private static readonly string _totalSizeMB = (_totalBytes / (1024.0 * 1024.0)).ToString("F1");

    private string _typeFilter = "all";

    private IEnumerable<UploadedFile> GetFiltered() =>
        _typeFilter == "all" ? _uploads : _uploads.Where(f => f.Type == _typeFilter);

    private static string GetMimeSubtype(string mimeType)
    {
        var idx = mimeType.IndexOf('/');
        return idx >= 0 ? mimeType.Substring(idx + 1) : mimeType;
    }

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();

    private static RenderFragment GetFileIcon(string type) => type switch
    {
        "image"       => @<LucideFileImageCn Size="16" Class="size-4 text-blue-600" />,
        "document"    => @<LucideFileTextCn Size="16" Class="size-4 text-red-600" />,
        "video"       => @<LucideFileVideoCameraCn Size="16" Class="size-4 text-purple-600" />,
        "spreadsheet" => @<LucideFileSpreadsheetCn Size="16" Class="size-4 text-emerald-600" />,
        _             => @<LucideFileCn Size="16" Class="size-4 text-muted-foreground" />,
    };

    private static RenderFragment GetStatusIndicator(string status) => status switch
    {
        "completed"  => @<div class="flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-emerald-500"></span><span class="text-xs text-muted-foreground">Completed</span></div>,
        "processing" => @<div class="flex items-center gap-1.5"><span class="size-1.5 animate-pulse rounded-full bg-blue-500"></span><span class="text-xs text-muted-foreground">Processing</span></div>,
        "failed"     => @<div class="flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-red-500"></span><span class="text-xs text-muted-foreground">Failed</span></div>,
        _            => @<div class="flex items-center gap-1.5"><span class="size-1.5 rounded-full bg-muted-foreground"></span><span class="text-xs text-muted-foreground">Unknown</span></div>,
    };
}
