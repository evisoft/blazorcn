@* ============================================================
   Block: tables-referral-tracking
   Title: TablesReferralTracking
   Description: Track referral sources with conversion rates and revenue attribution for React marketing dashboards using shadcn/ui and Next.js.
   Source: original/blocks/tables/tables-referral-tracking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Referral Sources</h3>
                <p class="text-xs text-muted-foreground">
                    @FormatNumber(_totalVisitors) visitors · @FormatNumber(_totalConversions) conversions · @FormatCurrency(_totalRevenue) revenue
                </p>
            </div>
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span>Organic</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    <span>Social</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-purple-500"></span>
                    <span>Referral</span>
                </div>
            </div>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground">Source</TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground">Medium</TableHeadCn>
                    <TableHeadCn Class="cursor-pointer font-medium text-xs text-muted-foreground text-right" @onclick="@(() => HandleSort(SortField.Visitors))">
                        <div class="flex items-center justify-end gap-1">
                            Visitors
                            @RenderSortIcon(SortField.Visitors)
                        </div>
                    </TableHeadCn>
                    <TableHeadCn Class="cursor-pointer font-medium text-xs text-muted-foreground text-right" @onclick="@(() => HandleSort(SortField.Conversions))">
                        <div class="flex items-center justify-end gap-1">
                            Conv.
                            @RenderSortIcon(SortField.Conversions)
                        </div>
                    </TableHeadCn>
                    <TableHeadCn Class="cursor-pointer font-medium text-xs text-muted-foreground text-right" @onclick="@(() => HandleSort(SortField.ConversionRate))">
                        <div class="flex items-center justify-end gap-1">
                            Rate
                            @RenderSortIcon(SortField.ConversionRate)
                        </div>
                    </TableHeadCn>
                    <TableHeadCn Class="cursor-pointer font-medium text-xs text-muted-foreground text-right" @onclick="@(() => HandleSort(SortField.Revenue))">
                        <div class="flex items-center justify-end gap-1">
                            Revenue
                            @RenderSortIcon(SortField.Revenue)
                        </div>
                    </TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground text-right">
                        Trend
                    </TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var src in GetSorted())
                {
                    var mediumClass = src.Medium == "organic"
                        ? "bg-emerald-500/10 text-emerald-700"
                        : src.Medium == "social"
                            ? "bg-blue-500/10 text-blue-700"
                            : src.Medium == "referral"
                                ? "bg-purple-500/10 text-purple-700"
                                : src.Medium == "email"
                                    ? "bg-amber-500/10 text-amber-700"
                                    : "";
                    var rateClass = src.ConversionRate >= 6
                        ? "text-emerald-600"
                        : src.ConversionRate >= 4
                            ? "text-foreground"
                            : "text-muted-foreground";

                    <TableRowCn Class="hover:bg-muted/50">
                        <TableCellCn>
                            <div class="flex items-center gap-2">
                                @if (src.Source == "direct" || src.Source == "newsletter")
                                {
                                    <LucideGlobeCn Size="14" Class="size-3.5 text-muted-foreground/60" />
                                }
                                else
                                {
                                    <LucideExternalLinkCn Size="14" Class="size-3.5 text-muted-foreground/60" />
                                }
                                <div>
                                    <span class="text-sm font-medium">@src.Source</span>
                                    @if (src.Campaign != null)
                                    {
                                        <p class="text-[10px] text-muted-foreground font-mono">@src.Campaign</p>
                                    }
                                </div>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"font-normal text-xs {mediumClass}")">
                                @src.Medium
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn Class="text-right font-medium tabular-nums text-sm">
                            @FormatNumber(src.Visitors)
                        </TableCellCn>
                        <TableCellCn Class="text-right tabular-nums text-sm text-muted-foreground">
                            @FormatNumber(src.Conversions)
                        </TableCellCn>
                        <TableCellCn Class="text-right">
                            <span class="@($"text-xs font-medium tabular-nums {rateClass}")">
                                @src.ConversionRate.ToString("F1")%
                            </span>
                        </TableCellCn>
                        <TableCellCn Class="text-right font-medium tabular-nums text-sm">
                            @FormatCurrency(src.Revenue)
                        </TableCellCn>
                        <TableCellCn Class="text-right">
                            @RenderTrend(src.Trend, src.TrendPercent)
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private enum SortField { Visitors, Conversions, ConversionRate, Revenue }
    private enum Trend { Up, Down, Stable }

    private record ReferralSource(
        string Id,
        string Source,
        string Medium,
        string? Campaign,
        int Visitors,
        int Conversions,
        double ConversionRate,
        int Revenue,
        Trend Trend,
        int TrendPercent
    );

    private static readonly ReferralSource[] _sources =
    [
        new("ref-001", "google.com",       "organic",  null,              12480, 624, 5.0, 18720, Trend.Up,     12),
        new("ref-002", "twitter.com",      "social",   "launch-2026",     5340,  214, 4.0, 6420,  Trend.Up,     28),
        new("ref-003", "direct",           "none",     null,              8920,  535, 6.0, 16050, Trend.Stable,  1),
        new("ref-004", "linkedin.com",     "social",   "b2b-outreach",    3210,  225, 7.0, 11250, Trend.Up,     18),
        new("ref-005", "producthunt.com",  "referral", null,              6780,  339, 5.0, 10170, Trend.Down,   15),
        new("ref-006", "youtube.com",      "video",    "tutorial-series", 4150,  166, 4.0, 4980,  Trend.Up,      8),
        new("ref-007", "newsletter",       "email",    "weekly-digest",   2890,  260, 9.0, 7800,  Trend.Stable,  2),
        new("ref-008", "reddit.com",       "social",   null,              3650,  110, 3.0, 3300,  Trend.Down,   22),
        new("ref-009", "github.com",       "referral", null,              7230,  434, 6.0, 13020, Trend.Up,      9),
        new("ref-010", "bing.com",         "organic",  null,              1840,   74, 4.0, 2220,  Trend.Stable,  0),
    ];

    private SortField _sortField = SortField.Visitors;
    private bool _sortAsc = false;

    private int _totalVisitors     => _sources.Sum(r => r.Visitors);
    private int _totalConversions  => _sources.Sum(r => r.Conversions);
    private int _totalRevenue      => _sources.Sum(r => r.Revenue);

    private void HandleSort(SortField field)
    {
        if (_sortField == field)
            _sortAsc = !_sortAsc;
        else
        {
            _sortField = field;
            _sortAsc = false;
        }
    }

    private ReferralSource[] GetSorted()
    {
        IEnumerable<ReferralSource> ordered = _sortField switch
        {
            SortField.Visitors       => _sortAsc ? _sources.OrderBy(r => r.Visitors)       : _sources.OrderByDescending(r => r.Visitors),
            SortField.Conversions    => _sortAsc ? _sources.OrderBy(r => r.Conversions)    : _sources.OrderByDescending(r => r.Conversions),
            SortField.ConversionRate => _sortAsc ? _sources.OrderBy(r => r.ConversionRate) : _sources.OrderByDescending(r => r.ConversionRate),
            SortField.Revenue        => _sortAsc ? _sources.OrderBy(r => r.Revenue)        : _sources.OrderByDescending(r => r.Revenue),
            _                        => _sources.AsEnumerable(),
        };
        return ordered.ToArray();
    }

    private RenderFragment RenderSortIcon(SortField field)
    {
        if (_sortField != field) return @<text></text>;
        return _sortAsc
            ? @<LucideArrowUpCn Size="12" Class="size-3" />
            : @<LucideArrowDownCn Size="12" Class="size-3" />;
    }

    private RenderFragment RenderTrend(Trend trend, int percent) => trend switch
    {
        Trend.Up     => @<div class="flex items-center justify-end gap-1 text-emerald-600"><LucideTrendingUpCn Size="12" Class="size-3" /><span class="text-xs">+@(percent)%</span></div>,
        Trend.Down   => @<div class="flex items-center justify-end gap-1 text-red-600"><LucideTrendingDownCn Size="12" Class="size-3" /><span class="text-xs">-@(percent)%</span></div>,
        Trend.Stable => @<div class="flex items-center justify-end gap-1 text-muted-foreground"><LucideMinusCn Size="12" Class="size-3" /><span class="text-xs">@(percent)%</span></div>,
        _            => @<text></text>,
    };

    private static string FormatNumber(int n) =>
        n >= 1000 ? $"{(n / 1000.0):F1}k" : n.ToString();

    private static string FormatCurrency(int n) =>
        n.ToString("C0", new System.Globalization.CultureInfo("en-US"));
}
