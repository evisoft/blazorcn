@* ============================================================
   Block: tables-rating
   Title: Tables Rating
   Description: Table component with inline star ratings and review scores for product and review dashboards
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-rating.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Product Ratings</h3>
                <p class="text-sm text-muted-foreground">
                    Average @_avgRating stars &middot; @FormatReviews(_totalReviews) total reviews
                </p>
            </div>
            <div class="flex items-center gap-2">
                @RenderStars(_avgRatingValue, "sm")
                <span class="text-sm font-medium">@_avgRating</span>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-64 font-semibold text-foreground">Product</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Category</TableHeadCn>
                        <TableHeadCn Class="w-36 font-semibold text-foreground">Rating</TableHeadCn>
                        <TableHeadCn Class="w-16 font-semibold text-foreground">Score</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground text-right">Reviews</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground">Trend</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground text-right">Price</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var product in _products)
                    {
                        <TableRowCn>
                            <TableCellCn Class="font-medium truncate" title="@product.Name">@product.Name</TableCellCn>
                            <TableCellCn Class="text-muted-foreground text-sm">@product.Category</TableCellCn>
                            <TableCellCn>
                                @RenderStars(product.Rating, "default")
                            </TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@Cn.Merge("font-semibold", GetBadgeColor(product.Rating))" Variant="BadgeVariant.Secondary">
                                    @product.Rating.ToString("F1")
                                </BadgeCn>
                            </TableCellCn>
                            <TableCellCn Class="text-right text-muted-foreground">
                                @FormatReviews(product.Reviews)
                            </TableCellCn>
                            <TableCellCn>
                                @if (product.Trend == "stable")
                                {
                                    <span class="text-sm text-muted-foreground">&mdash;</span>
                                }
                                else
                                {
                                    var trendColor = product.Trend == "up" ? "text-green-600" : "text-destructive";
                                    var trendPrefix = product.Trend == "up" ? "+" : "";

                                    <div class="@Cn.Merge("flex items-center gap-1 text-sm", trendColor)">
                                        @if (product.Trend == "up")
                                        {
                                            <LucideTrendingUpCn Size="16" Class="h-4 w-4" />
                                        }
                                        else
                                        {
                                            <LucideTrendingDownCn Size="16" Class="h-4 w-4" />
                                        }
                                        <span>@trendPrefix@product.TrendValue.ToString("F1")</span>
                                    </div>
                                }
                            </TableCellCn>
                            <TableCellCn Class="text-right font-medium">$@product.Price</TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Ratings shown with half-star precision. Trend shows change from last month.
        </p>
    </div>
</div>

@code {
    private record Product(string Id, string Name, string Category, double Rating, int Reviews, string Trend, double TrendValue, int Price);

    private static readonly Product[] _products =
    [
        new("1", "Wireless Noise-Canceling Headphones", "Audio", 4.8, 2847, "up", 0.3, 299),
        new("2", "Mechanical Gaming Keyboard", "Peripherals", 4.6, 1523, "stable", 0, 149),
        new("3", "Ultra-Wide Curved Monitor", "Displays", 4.5, 892, "up", 0.2, 599),
        new("4", "Portable SSD 2TB", "Storage", 4.9, 3241, "up", 0.1, 179),
        new("5", "Ergonomic Office Chair", "Furniture", 4.2, 567, "down", -0.4, 449),
        new("6", "Smart Home Hub", "Smart Home", 3.9, 1089, "down", -0.2, 129),
        new("7", "Wireless Charging Pad", "Accessories", 4.4, 2156, "stable", 0, 39),
        new("8", "4K Webcam with Microphone", "Peripherals", 4.7, 743, "up", 0.5, 199),
    ];

    private static readonly string _avgRating = (_products.Average(p => p.Rating)).ToString("F1");
    private static readonly double _avgRatingValue = _products.Average(p => p.Rating);
    private static readonly int _totalReviews = _products.Sum(p => p.Reviews);

    private static string FormatReviews(int count) =>
        count >= 1000 ? $"{(count / 1000.0):F1}K" : count.ToString();

    private static string GetBadgeColor(double rating) => rating switch
    {
        >= 4.5 => "bg-green-100 text-green-700",
        >= 4.0 => "bg-blue-100 text-blue-700",
        >= 3.5 => "bg-yellow-100 text-yellow-700",
        _ => "bg-orange-100 text-orange-700",
    };

    private static RenderFragment RenderStars(double rating, string size)
    {
        var fullStars = (int)Math.Floor(rating);
        var hasHalfStar = rating % 1 >= 0.5;
        var emptyStars = 5 - fullStars - (hasHalfStar ? 1 : 0);
        var starSize = size == "sm" ? "h-3.5 w-3.5" : "h-4 w-4";

        return builder =>
        {
            var seq = 0;

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "flex items-center gap-0.5");

            for (var i = 0; i < fullStars; i++)
            {
                builder.OpenComponent<LucideStarCn>(seq++);
                builder.AddAttribute(seq++, "Size", 16);
                builder.AddAttribute(seq++, "Class", Cn.Merge(starSize, "fill-yellow-400 text-yellow-400"));
                builder.CloseComponent();
            }

            if (hasHalfStar)
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "relative");

                builder.OpenComponent<LucideStarCn>(seq++);
                builder.AddAttribute(seq++, "Size", 16);
                builder.AddAttribute(seq++, "Class", Cn.Merge(starSize, "text-muted-foreground/30"));
                builder.CloseComponent();

                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "absolute inset-0 overflow-hidden w-1/2");
                builder.OpenComponent<LucideStarCn>(seq++);
                builder.AddAttribute(seq++, "Size", 16);
                builder.AddAttribute(seq++, "Class", Cn.Merge(starSize, "fill-yellow-400 text-yellow-400"));
                builder.CloseComponent();
                builder.CloseElement();

                builder.CloseElement();
            }

            for (var i = 0; i < emptyStars; i++)
            {
                builder.OpenComponent<LucideStarCn>(seq++);
                builder.AddAttribute(seq++, "Size", 16);
                builder.AddAttribute(seq++, "Class", Cn.Merge(starSize, "text-muted-foreground/30"));
                builder.CloseComponent();
            }

            builder.CloseElement();
        };
    }
}
