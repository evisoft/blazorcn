@* ============================================================
   Block: tables-audit-trail
   Title: TablesAuditTrail
   Description: React table with user actions, timestamps, IP tracking, and resource filtering for Next.js compliance dashboards using shadcn/ui and Tailwind CSS
   Source: original/blocks/tables/tables-audit-trail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Audit Trail</h3>
                <p class="text-xs text-muted-foreground">@Filtered.Count() events recorded</p>
            </div>
            <div class="flex items-center gap-2">
                <div class="relative">
                    <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-2.5 size-3.5 text-muted-foreground" />
                    <InputCn Class="h-8 w-48 pl-8 text-xs" Placeholder="Search events..." @bind-Value="_search" />
                </div>
            </div>
        </div>
        <div class="flex items-center gap-1.5 border-b px-4 py-2">
            <LucideIconCn Name="filter" Size="14" Class="size-3.5 text-muted-foreground" />
            <span class="text-xs text-muted-foreground mr-1">Action:</span>
            @foreach (var fa in _filterActions)
            {
                var action = fa;
                <ButtonCn Variant="@(_filterAction == action ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" @onclick="@(() => { _filterAction = action; })">
                    @(action == "all" ? "All" : (char.ToUpper(action[0]) + action[1..]))
                </ButtonCn>
            }
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">User</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Action</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Resource</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Details</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">IP Address</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">
                        <button type="button" class="flex items-center gap-1" @onclick="ToggleSort">
                            Timestamp
                            @if (_sortDir == "desc")
                            {
                                <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideIconCn Name="chevron-up" Size="12" Class="size-3" />
                            }
                        </button>
                    </TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var evt in Filtered)
                {
                    <TableRowCn Class="hover:bg-muted/50">
                        <TableCellCn>
                            <div class="flex items-center gap-2">
                                <AvatarCn Class="size-6">
                                    <AvatarFallbackCn Class="text-[10px]">@GetInitials(evt.User.Name)</AvatarFallbackCn>
                                </AvatarCn>
                                <div>
                                    <p class="text-sm font-medium">@evt.User.Name</p>
                                    <p class="text-xs text-muted-foreground">@evt.User.Email</p>
                                </div>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="@GetActionVariant(evt.Action)" Class="text-xs font-normal">
                                @GetActionLabel(evt.Action)
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn>
                            <div>
                                <p class="text-sm">@evt.Resource</p>
                                <p class="font-mono text-xs text-muted-foreground">@evt.ResourceId</p>
                            </div>
                        </TableCellCn>
                        <TableCellCn Class="text-sm text-muted-foreground">@evt.Details</TableCellCn>
                        <TableCellCn Class="font-mono text-xs text-muted-foreground">@evt.IpAddress</TableCellCn>
                        <TableCellCn Class="text-xs text-muted-foreground whitespace-nowrap">@evt.Timestamp</TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record AuditUser(string Name, string Email);
    private record AuditEvent(string Id, AuditUser User, string Action, string Resource, string ResourceId, string Details, string IpAddress, string Timestamp);

    private string _search = "";
    private string _sortDir = "desc";
    private string _filterAction = "all";

    private static readonly string[] _filterActions = ["all", "create", "update", "delete", "login", "export", "permission"];

    private static readonly AuditEvent[] _auditEvents =
    [
        new("EVT-001", new AuditUser("Sarah Chen", "sarah@company.com"), "create", "User", "USR-847", "Created new user account", "192.168.1.42", "Mar 24, 2026 14:32:05"),
        new("EVT-002", new AuditUser("James Park", "james@company.com"), "update", "Project", "PRJ-221", "Updated project settings", "10.0.0.15", "Mar 24, 2026 14:28:41"),
        new("EVT-003", new AuditUser("Maya Patel", "maya@company.com"), "delete", "Invoice", "INV-1092", "Deleted draft invoice", "172.16.0.88", "Mar 24, 2026 14:15:22"),
        new("EVT-004", new AuditUser("Alex Kumar", "alex@company.com"), "login", "Session", "SES-4401", "Logged in via SSO", "203.0.113.5", "Mar 24, 2026 13:58:10"),
        new("EVT-005", new AuditUser("Emma Wilson", "emma@company.com"), "export", "Report", "RPT-067", "Exported Q1 financials as CSV", "192.168.1.30", "Mar 24, 2026 13:42:55"),
        new("EVT-006", new AuditUser("Ryan Lee", "ryan@company.com"), "permission", "Role", "ROL-012", "Granted admin access to team", "10.0.0.22", "Mar 24, 2026 13:30:18"),
        new("EVT-007", new AuditUser("Sarah Chen", "sarah@company.com"), "update", "User", "USR-312", "Changed email address", "192.168.1.42", "Mar 24, 2026 13:15:07"),
        new("EVT-008", new AuditUser("James Park", "james@company.com"), "create", "API Key", "KEY-089", "Generated production API key", "10.0.0.15", "Mar 24, 2026 12:58:33"),
    ];

    private IEnumerable<AuditEvent> Filtered
    {
        get
        {
            var q = _auditEvents.AsEnumerable();
            if (_filterAction != "all")
                q = q.Where(e => e.Action == _filterAction);
            if (!string.IsNullOrEmpty(_search))
                q = q.Where(e =>
                    e.User.Name.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    e.Resource.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    e.Details.Contains(_search, StringComparison.OrdinalIgnoreCase));
            return _sortDir == "desc"
                ? q.OrderByDescending(e => e.Id)
                : q.OrderBy(e => e.Id);
        }
    }

    private void ToggleSort() => _sortDir = _sortDir == "desc" ? "asc" : "desc";

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();

    private static BadgeVariant GetActionVariant(string action) => action switch
    {
        "create" => BadgeVariant.Default,
        "update" => BadgeVariant.Secondary,
        "delete" => BadgeVariant.Destructive,
        "login" => BadgeVariant.Outline,
        "export" => BadgeVariant.Outline,
        "permission" => BadgeVariant.Secondary,
        _ => BadgeVariant.Default,
    };

    private static string GetActionLabel(string action) => action switch
    {
        "create" => "Create",
        "update" => "Update",
        "delete" => "Delete",
        "login" => "Login",
        "export" => "Export",
        "permission" => "Permission",
        _ => action,
    };
}
