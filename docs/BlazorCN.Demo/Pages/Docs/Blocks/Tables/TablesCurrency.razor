@* ============================================================
   Block: tables-currency
   Title: Tables Currency
   Description: Table component with formatted currency values and financial metrics for finance dashboards
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-currency.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Financial Transactions</h3>
                <p class="text-sm text-muted-foreground">
                    @_transactions.Length transactions this period
                </p>
            </div>
            <div class="flex items-center gap-6 text-sm">
                <div>
                    <p class="text-muted-foreground">Revenue</p>
                    <p class="font-semibold text-green-600 font-mono">@FormatCurrency(_totalRevenue)</p>
                </div>
                <div>
                    <p class="text-muted-foreground">Expenses</p>
                    <p class="font-semibold text-destructive font-mono">@FormatCurrency(Math.Abs(_totalExpenses))</p>
                </div>
                <div>
                    <p class="text-muted-foreground">Net</p>
                    <p class="@Cn.Merge("font-semibold font-mono", _netAmount >= 0 ? "text-green-600" : "text-destructive")">
                        @(_netAmount < 0 ? "-" : "")@FormatCurrency(Math.Abs(_netAmount))
                    </p>
                </div>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">ID</TableHeadCn>
                        <TableHeadCn Class="w-48 font-semibold text-foreground">Description</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Category</TableHeadCn>
                        <TableHeadCn Class="w-32 font-semibold text-foreground text-right">Amount</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Change</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Date</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Status</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var txn in _transactions)
                    {
                        var isNegative = txn.Amount < 0;
                        var change = txn.PreviousAmount != 0
                            ? ((Math.Abs(txn.Amount) - Math.Abs(txn.PreviousAmount)) / Math.Abs(txn.PreviousAmount)) * 100
                            : 0.0;
                        var absChange = Math.Abs(change);
                        var isChangePositive = change > 0;
                        var isGood = txn.Amount < 0 ? !isChangePositive : isChangePositive;

                        <TableRowCn>
                            <TableCellCn Class="font-mono text-sm text-muted-foreground">@txn.Id</TableCellCn>
                            <TableCellCn Class="font-medium truncate" title="@txn.Description">@txn.Description</TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="font-normal" Variant="BadgeVariant.Outline">@txn.Category</BadgeCn>
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <span class="@Cn.Merge("font-mono tabular-nums", isNegative ? "text-destructive" : "text-foreground")">
                                    @(isNegative ? "(" : "")@FormatCurrency(Math.Abs(txn.Amount))@(isNegative ? ")" : "")
                                </span>
                            </TableCellCn>
                            <TableCellCn>
                                @if (absChange < 0.1)
                                {
                                    <div class="flex items-center gap-1 text-muted-foreground">
                                        <LucideMinusCn Size="14" Class="h-3.5 w-3.5" />
                                        <span class="text-sm">0%</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="@Cn.Merge("flex items-center gap-1", isGood ? "text-green-600" : "text-destructive")">
                                        @if (isChangePositive)
                                        {
                                            <LucideArrowUpRightCn Size="14" Class="h-3.5 w-3.5" />
                                        }
                                        else
                                        {
                                            <LucideArrowDownRightCn Size="14" Class="h-3.5 w-3.5" />
                                        }
                                        <span class="text-sm font-medium">@($"{absChange:F1}")%</span>
                                    </div>
                                }
                            </TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@txn.Date</TableCellCn>
                            <TableCellCn>
                                @{
                                    var (statusLabel, statusVariant, statusClass) = GetStatusConfig(txn.Status);
                                }
                                <BadgeCn Class="@statusClass" Variant="@statusVariant">@statusLabel</BadgeCn>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
                <TableFooterCn>
                    <TableRowCn Class="bg-muted/50">
                        <TableCellCn Class="font-semibold" colspan="3">Total</TableCellCn>
                        <TableCellCn Class="text-right">
                            <span class="@Cn.Merge("font-mono tabular-nums font-bold", _netAmount >= 0 ? "text-green-600" : "text-destructive")">
                                @(_netAmount < 0 ? "(" : "")@FormatCurrency(Math.Abs(_netAmount))@(_netAmount < 0 ? ")" : "")
                            </span>
                        </TableCellCn>
                        <TableCellCn colspan="3"></TableCellCn>
                    </TableRowCn>
                </TableFooterCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Negative values shown in parentheses. Change compares to previous period.
        </p>
    </div>
</div>

@code {
    private record Transaction(string Id, string Description, string Category, double Amount, double PreviousAmount, string Date, string Status);

    private static readonly Transaction[] _transactions =
    [
        new("TXN-001", "Enterprise License Q1", "Revenue", 125_000, 115_000, "Jan 15, 2024", "completed"),
        new("TXN-002", "Cloud Infrastructure", "Expenses", -45_230.50, -42_100, "Jan 14, 2024", "completed"),
        new("TXN-003", "Consulting Services", "Revenue", 38_500, 38_500, "Jan 14, 2024", "completed"),
        new("TXN-004", "Marketing Campaign", "Expenses", -28_750, -32_000, "Jan 13, 2024", "completed"),
        new("TXN-005", "SaaS Subscriptions", "Revenue", 89_200, 78_400, "Jan 12, 2024", "pending"),
        new("TXN-006", "Employee Payroll", "Expenses", -156_800, -156_800, "Jan 10, 2024", "completed"),
        new("TXN-007", "Hardware Purchase", "Expenses", -12_450, -8200, "Jan 8, 2024", "failed"),
        new("TXN-008", "Support Contract", "Revenue", 24_000, 22_000, "Jan 5, 2024", "completed"),
    ];

    private static readonly double _totalRevenue = _transactions.Where(t => t.Amount > 0).Sum(t => t.Amount);
    private static readonly double _totalExpenses = _transactions.Where(t => t.Amount < 0).Sum(t => t.Amount);
    private static readonly double _netAmount = _totalRevenue + _totalExpenses;

    private static string FormatCurrency(double value) => value.ToString("C2");

    private static (string Label, BadgeVariant Variant, string ClassName) GetStatusConfig(string status) => status switch
    {
        "completed" => ("Completed", BadgeVariant.Secondary, "bg-green-100 text-green-700"),
        "pending" => ("Pending", BadgeVariant.Secondary, ""),
        "failed" => ("Failed", BadgeVariant.Destructive, ""),
        _ => ("Unknown", BadgeVariant.Secondary, ""),
    };
}
