@* ============================================================
   Block: tables-inline-edit
   Title: Tables Inline Edit
   Description: Inline editable table component with click-to-edit and save/cancel buttons
   Dependencies: ButtonCn, InputCn, TableCn
   Source: original/blocks/tables/tables-inline-edit.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
        <TableCn Class="table-fixed" style="width: 850px">
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn Class="font-semibold text-foreground">Product Name</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">SKU</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Price</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Stock</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Category</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var product in _products)
                {
                    var pid = product.Id;
                    var colName = ColName;
                    var colSku = ColSku;
                    var colPrice = ColPrice;
                    var colStock = ColStock;
                    var priceStr = product.Price.ToString("F2");
                    var stockStr = product.Stock.ToString();

                    <TableRowCn>
                        <TableCellCn>
                            @if (IsEditing(pid, colName))
                            {
                                <div class="flex items-center gap-2">
                                    <InputCn Class="h-8" @bind-Value="_editValue" />
                                    <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => SaveEdit(pid, colName)" aria-label="Save name">
                                        <LucideCheckCn Size="16" Class="h-4 w-4 text-green-600" />
                                    </ButtonCn>
                                    <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="CancelEdit" aria-label="Cancel editing">
                                        <LucideXCn Size="16" Class="h-4 w-4 text-red-600" />
                                    </ButtonCn>
                                </div>
                            }
                            else
                            {
                                <div class="group flex items-center gap-2 cursor-pointer" @onclick="() => StartEdit(pid, colName, product.Name)">
                                    <span class="font-medium">@product.Name</span>
                                    <LucidePencilCn Size="12" Class="h-3 w-3 text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity" />
                                </div>
                            }
                        </TableCellCn>
                        <TableCellCn>
                            @if (IsEditing(pid, colSku))
                            {
                                <div class="flex items-center gap-2">
                                    <InputCn Class="h-8 w-24" @bind-Value="_editValue" />
                                    <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => SaveEdit(pid, colSku)" aria-label="Save SKU">
                                        <LucideCheckCn Size="16" Class="h-4 w-4 text-green-600" />
                                    </ButtonCn>
                                    <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="CancelEdit" aria-label="Cancel editing">
                                        <LucideXCn Size="16" Class="h-4 w-4 text-red-600" />
                                    </ButtonCn>
                                </div>
                            }
                            else
                            {
                                <div class="group flex items-center gap-2 cursor-pointer" @onclick="() => StartEdit(pid, colSku, product.Sku)">
                                    <span class="font-mono text-muted-foreground">@product.Sku</span>
                                    <LucidePencilCn Size="12" Class="h-3 w-3 text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity" />
                                </div>
                            }
                        </TableCellCn>
                        <TableCellCn>
                            @if (IsEditing(pid, colPrice))
                            {
                                <div class="flex items-center gap-2">
                                    <InputCn Class="h-8 w-24" type="number" @bind-Value="_editValue" />
                                    <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => SaveEdit(pid, colPrice)" aria-label="Save price">
                                        <LucideCheckCn Size="16" Class="h-4 w-4 text-green-600" />
                                    </ButtonCn>
                                    <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="CancelEdit" aria-label="Cancel editing">
                                        <LucideXCn Size="16" Class="h-4 w-4 text-red-600" />
                                    </ButtonCn>
                                </div>
                            }
                            else
                            {
                                <div class="group flex items-center gap-2 cursor-pointer" @onclick="() => StartEdit(pid, colPrice, priceStr)">
                                    <span class="font-mono font-semibold">@product.Price.ToString("C2")</span>
                                    <LucidePencilCn Size="12" Class="h-3 w-3 text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity" />
                                </div>
                            }
                        </TableCellCn>
                        <TableCellCn>
                            @if (IsEditing(pid, colStock))
                            {
                                <div class="flex items-center gap-2">
                                    <InputCn Class="h-8 w-20" type="number" @bind-Value="_editValue" />
                                    <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => SaveEdit(pid, colStock)" aria-label="Save stock">
                                        <LucideCheckCn Size="16" Class="h-4 w-4 text-green-600" />
                                    </ButtonCn>
                                    <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="CancelEdit" aria-label="Cancel editing">
                                        <LucideXCn Size="16" Class="h-4 w-4 text-red-600" />
                                    </ButtonCn>
                                </div>
                            }
                            else
                            {
                                <div class="group flex items-center gap-2 cursor-pointer" @onclick="() => StartEdit(pid, colStock, stockStr)">
                                    <span class="text-muted-foreground">@product.Stock</span>
                                    <LucidePencilCn Size="12" Class="h-3 w-3 text-muted-foreground opacity-0 group-hover:opacity-100 transition-opacity" />
                                </div>
                            }
                        </TableCellCn>
                        <TableCellCn Class="text-muted-foreground">@product.Category</TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</div>

@code {
    private const string ColName = "name";
    private const string ColSku = "sku";
    private const string ColPrice = "price";
    private const string ColStock = "stock";

    private class ProductItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Sku { get; set; } = "";
        public double Price { get; set; }
        public int Stock { get; set; }
        public string Category { get; set; } = "";
    }

    private List<ProductItem> _products =
    [
        new() { Id = "1", Name = "Wireless Mouse", Sku = "WM-001", Price = 29.99, Stock = 150, Category = "Electronics" },
        new() { Id = "2", Name = "USB-C Cable", Sku = "UC-002", Price = 12.99, Stock = 300, Category = "Accessories" },
        new() { Id = "3", Name = "Laptop Stand", Sku = "LS-003", Price = 49.99, Stock = 75, Category = "Accessories" },
        new() { Id = "4", Name = "Mechanical Keyboard", Sku = "MK-004", Price = 129.99, Stock = 45, Category = "Electronics" },
        new() { Id = "5", Name = "Monitor 27 inch", Sku = "MN-005", Price = 299.99, Stock = 30, Category = "Electronics" },
        new() { Id = "6", Name = "Webcam HD", Sku = "WC-006", Price = 79.99, Stock = 60, Category = "Electronics" },
    ];

    private string? _editingRowId;
    private string? _editingColumn;
    private string _editValue = "";

    private bool IsEditing(string rowId, string column) =>
        _editingRowId == rowId && _editingColumn == column;

    private void StartEdit(string rowId, string column, string currentValue)
    {
        _editingRowId = rowId;
        _editingColumn = column;
        _editValue = currentValue;
    }

    private void SaveEdit(string rowId, string column)
    {
        var product = _products.FirstOrDefault(p => p.Id == rowId);
        if (product != null)
        {
            switch (column)
            {
                case ColName: product.Name = _editValue; break;
                case ColSku: product.Sku = _editValue; break;
                case ColPrice: if (double.TryParse(_editValue, out var price)) product.Price = price; break;
                case ColStock: if (int.TryParse(_editValue, out var stock)) product.Stock = stock; break;
            }
        }
        CancelEdit();
    }

    private void CancelEdit()
    {
        _editingRowId = null;
        _editingColumn = null;
        _editValue = "";
    }
}
