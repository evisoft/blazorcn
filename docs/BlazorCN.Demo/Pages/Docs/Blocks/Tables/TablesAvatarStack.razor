@* ============================================================
   Block: tables-avatar-stack
   Title: Tables Avatar Stack
   Description: Table component with stacked avatar groups showing team members for collaboration dashboards
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-avatar-stack.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Project Teams</h3>
                <p class="text-sm text-muted-foreground">
                    @_projects.Length projects &middot; @_totalMembers team members
                </p>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-44 font-semibold text-foreground">Project</TableHeadCn>
                        <TableHeadCn Class="w-52 font-semibold text-foreground">Description</TableHeadCn>
                        <TableHeadCn Class="w-40 font-semibold text-foreground">Team</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Priority</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Status</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var project in _projects)
                    {
                        var visibleMembers = project.Team.Take(MaxVisibleAvatars).ToArray();
                        var remainingCount = project.Team.Length - MaxVisibleAvatars;
                        var (statusLabel, statusVariant, statusClass) = GetStatusConfig(project.Status);
                        var (prioLabel, prioClass) = GetPriorityConfig(project.Priority);

                        <TableRowCn>
                            <TableCellCn Class="font-medium">@project.Name</TableCellCn>
                            <TableCellCn Class="text-muted-foreground truncate">@project.Description</TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center">
                                    <div class="flex -space-x-2">
                                        @foreach (var member in visibleMembers)
                                        {
                                            <div class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-background bg-muted text-xs font-medium"
                                                 title="@member.Name">
                                                @member.Initials
                                            </div>
                                        }
                                        @if (remainingCount > 0)
                                        {
                                            <div class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-background bg-muted text-xs font-medium"
                                                 title="@string.Join(", ", project.Team.Skip(MaxVisibleAvatars).Select(m => m.Name))">
                                                +@remainingCount
                                            </div>
                                        }
                                    </div>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <div class="@Cn.Merge("h-2 w-2 rounded-full", prioClass)"></div>
                                    <span class="text-sm text-muted-foreground">@prioLabel</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@statusClass" Variant="@statusVariant">@statusLabel</BadgeCn>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Hover over avatars to see team member names. +N shows additional members.
        </p>
    </div>
</div>

@code {
    private const int MaxVisibleAvatars = 4;

    private record TeamMember(string Id, string Name, string Initials);
    private record ProjectItem(string Id, string Name, string Description, TeamMember[] Team, string Status, string Priority);

    private static readonly TeamMember _sarah = new("1", "Sarah Chen", "SC");
    private static readonly TeamMember _marcus = new("2", "Marcus Johnson", "MJ");
    private static readonly TeamMember _emily = new("3", "Emily Rodriguez", "ER");
    private static readonly TeamMember _david = new("4", "David Kim", "DK");
    private static readonly TeamMember _lisa = new("5", "Lisa Thompson", "LT");
    private static readonly TeamMember _james = new("6", "James Wilson", "JW");
    private static readonly TeamMember _anna = new("7", "Anna Martinez", "AM");
    private static readonly TeamMember _michael = new("8", "Michael Brown", "MB");

    private static readonly ProjectItem[] _projects =
    [
        new("1", "Website Redesign", "Complete overhaul of marketing site", [_sarah, _marcus, _emily, _david, _lisa], "active", "high"),
        new("2", "Mobile App v2", "iOS and Android feature update", [_david, _james, _anna], "active", "high"),
        new("3", "API Documentation", "Developer portal and docs", [_emily, _michael], "review", "medium"),
        new("4", "Analytics Dashboard", "Real-time metrics visualization", [_sarah, _lisa, _james, _anna, _michael, _marcus], "active", "medium"),
        new("5", "Security Audit", "Quarterly security assessment", [_marcus, _david], "completed", "high"),
        new("6", "CRM Integration", "Salesforce data sync", [_anna, _emily, _james, _lisa], "on-hold", "low"),
        new("7", "Performance Optimization", "Core web vitals improvements", [_michael], "active", "medium"),
        new("8", "User Research", "Customer interview analysis", [_lisa, _sarah, _marcus], "review", "low"),
    ];

    private static readonly int _totalMembers = _projects.SelectMany(p => p.Team).Select(m => m.Id).Distinct().Count();

    private static (string Label, BadgeVariant Variant, string ClassName) GetStatusConfig(string status) => status switch
    {
        "active" => ("Active", BadgeVariant.Default, ""),
        "review" => ("In Review", BadgeVariant.Secondary, ""),
        "completed" => ("Completed", BadgeVariant.Outline, "border-green-300 text-green-700"),
        "on-hold" => ("On Hold", BadgeVariant.Outline, "border-yellow-300 text-yellow-700"),
        _ => ("Unknown", BadgeVariant.Secondary, ""),
    };

    private static (string Label, string ClassName) GetPriorityConfig(string priority) => priority switch
    {
        "high" => ("High", "bg-destructive"),
        "medium" => ("Medium", "bg-yellow-500"),
        "low" => ("Low", "bg-muted-foreground"),
        _ => ("Unknown", "bg-muted"),
    };
}
