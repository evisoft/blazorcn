@* ============================================================
   Block: tables-selection
   Title: Tables Selection
   Description: Data table component with row selection checkboxes and bulk action toolbar
   Dependencies: BadgeCn, ButtonCn, CheckboxCn, TableCn
   Source: original/blocks/tables/tables-selection.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        @if (_selectedIds.Count > 0)
        {
            <div class="flex items-center justify-between rounded-lg border border-border bg-muted/50 p-3">
                <p class="text-sm font-medium">
                    @_selectedIds.Count item@(_selectedIds.Count != 1 ? "s" : "") selected
                </p>
                <div class="flex gap-2">
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                        <LucideDownloadCn Size="16" Class="mr-2 h-4 w-4" />
                        Export
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                        <LucideArchiveCn Size="16" Class="mr-2 h-4 w-4" />
                        Archive
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Destructive" OnClick="ClearSelection">
                        <LucideTrash2Cn Size="16" Class="mr-2 h-4 w-4" />
                        Delete
                    </ButtonCn>
                </div>
            </div>
        }

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-12">
                            <CheckboxCn Checked="_allSelected" CheckedChanged="ToggleAll" Class="translate-y-[2px]" />
                        </TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Product</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Category</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Price</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Stock</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Status</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var product in _products)
                    {
                        var isSelected = _selectedIds.Contains(product.Id);
                        var (statusLabel, statusVariant, statusClass) = GetStatusConfig(product.Status);

                        <TableRowCn Class="@(isSelected ? "bg-muted/50" : "")">
                            <TableCellCn>
                                <CheckboxCn Checked="isSelected" CheckedChanged="() => ToggleRow(product.Id)" Class="translate-y-[2px]" />
                            </TableCellCn>
                            <TableCellCn Class="font-medium">@product.Name</TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@product.Category</TableCellCn>
                            <TableCellCn Class="font-mono font-semibold">@product.Price.ToString("C2")</TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@product.Stock</TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@statusClass" Variant="@statusVariant">@statusLabel</BadgeCn>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>
    </div>
</div>

@code {
    private record Product(string Id, string Name, string Category, double Price, int Stock, string Status);

    private static readonly Product[] _products =
    [
        new("1", "Wireless Headphones", "Electronics", 79.99, 45, "in-stock"),
        new("2", "Laptop Stand", "Accessories", 34.99, 12, "low-stock"),
        new("3", "Mechanical Keyboard", "Electronics", 129.99, 0, "out-of-stock"),
        new("4", "USB-C Cable", "Accessories", 12.99, 156, "in-stock"),
        new("5", "Monitor 27 inch", "Electronics", 299.99, 8, "low-stock"),
        new("6", "Desk Mat", "Accessories", 24.99, 67, "in-stock"),
        new("7", "Webcam HD", "Electronics", 89.99, 23, "in-stock"),
        new("8", "Phone Holder", "Accessories", 15.99, 0, "out-of-stock"),
    ];

    private HashSet<string> _selectedIds = new();
    private bool _allSelected => _selectedIds.Count == _products.Length;

    private void ToggleRow(string id)
    {
        if (!_selectedIds.Remove(id))
        {
            _selectedIds.Add(id);
        }
    }

    private void ToggleAll()
    {
        if (_allSelected)
        {
            _selectedIds.Clear();
        }
        else
        {
            _selectedIds = new HashSet<string>(_products.Select(p => p.Id));
        }
    }

    private void ClearSelection()
    {
        _selectedIds.Clear();
    }

    private static (string Label, BadgeVariant Variant, string ClassName) GetStatusConfig(string status) => status switch
    {
        "in-stock" => ("In Stock", BadgeVariant.Outline, "border-green-200 text-green-700"),
        "low-stock" => ("Low Stock", BadgeVariant.Outline, "border-orange-200 text-orange-700"),
        "out-of-stock" => ("Out of Stock", BadgeVariant.Outline, "border-red-200 text-red-700"),
        _ => (status, BadgeVariant.Secondary, ""),
    };
}
