@* ============================================================
   Block: tables-loading
   Title: Tables Loading
   Description: Table component with skeleton loading states for async data fetching
   Dependencies: ButtonCn, SkeletonCn, TableCn
   Source: original/blocks/tables/tables-loading.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
                <p class="text-sm text-muted-foreground">
                    @(_isLoading ? "Loading projects..." : $"{_projects.Length} projects")
                </p>
                @if (_isLoading)
                {
                    <LucideRefreshCwCn Size="16" Class="h-4 w-4 animate-spin text-muted-foreground" />
                }
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Disabled="_isLoading" OnClick="LoadData">
                <LucideRefreshCwCn Size="16" Class="mr-2 h-4 w-4" />
                Reload
            </ButtonCn>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="font-semibold text-foreground">Project ID</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Name</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Client</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Budget</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Progress</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Deadline</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @if (_isLoading)
                    {
                        @for (var i = 0; i < 6; i++)
                        {
                            <TableRowCn>
                                <TableCellCn><SkeletonCn Class="h-4 w-16" /></TableCellCn>
                                <TableCellCn><SkeletonCn Class="h-4 w-32" /></TableCellCn>
                                <TableCellCn><SkeletonCn Class="h-4 w-24" /></TableCellCn>
                                <TableCellCn><SkeletonCn Class="h-4 w-16" /></TableCellCn>
                                <TableCellCn>
                                    <div class="flex items-center gap-2">
                                        <SkeletonCn Class="h-2 w-24 rounded-full" />
                                        <SkeletonCn Class="h-4 w-8" />
                                    </div>
                                </TableCellCn>
                                <TableCellCn><SkeletonCn Class="h-4 w-20" /></TableCellCn>
                            </TableRowCn>
                        }
                    }
                    else
                    {
                        @foreach (var project in _projects)
                        {
                            <TableRowCn>
                                <TableCellCn Class="font-mono text-xs">@project.Id</TableCellCn>
                                <TableCellCn Class="font-medium">@project.Name</TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@project.Client</TableCellCn>
                                <TableCellCn Class="font-mono font-semibold">@project.Budget.ToString("C0")</TableCellCn>
                                <TableCellCn>
                                    <div class="flex items-center gap-2">
                                        <div class="h-2 w-24 overflow-hidden rounded-full bg-muted">
                                            <div class="h-full bg-primary transition-all" style="@($"width: {project.Progress}%")"></div>
                                        </div>
                                        <span class="text-xs text-muted-foreground">@project.Progress%</span>
                                    </div>
                                </TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@project.Deadline</TableCellCn>
                            </TableRowCn>
                        }
                    }
                </TableBodyCn>
            </TableCn>
        </div>
    </div>
</div>

@code {
    private record Project(string Id, string Name, string Client, double Budget, int Progress, string Deadline);

    private static readonly Project[] _allProjects =
    [
        new("PRJ-001", "Website Redesign", "Acme Corp", 45_000, 75, "2024-03-15"),
        new("PRJ-002", "Mobile App Development", "TechStart", 120_000, 40, "2024-05-20"),
        new("PRJ-003", "Brand Identity", "Fashion Hub", 25_000, 90, "2024-02-28"),
        new("PRJ-004", "E-commerce Platform", "RetailMax", 85_000, 55, "2024-04-10"),
        new("PRJ-005", "Dashboard Analytics", "DataFlow Inc", 60_000, 20, "2024-06-01"),
        new("PRJ-006", "API Integration", "ConnectPro", 35_000, 100, "2024-01-30"),
    ];

    private bool _isLoading;
    private Project[] _projects = _allProjects;

    private async Task LoadData()
    {
        _isLoading = true;
        _projects = [];
        StateHasChanged();
        await Task.Delay(2000);
        _projects = _allProjects;
        _isLoading = false;
    }
}
