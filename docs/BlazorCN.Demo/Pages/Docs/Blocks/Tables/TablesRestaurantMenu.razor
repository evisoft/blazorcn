@* ============================================================
   Block: tables-restaurant-menu
   Title: Tables Restaurant Menu
   Description: Table component with restaurant menu showing dishes, dietary tags, prices and availability
   Dependencies: BadgeCn, ButtonCn, TableCn
   Source: original/blocks/tables/tables-restaurant-menu.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Our Menu</h3>
                <p class="text-sm text-muted-foreground">
                    @_menuItems.Length dishes &middot; @_vegetarianCount vegetarian options
                </p>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Class="gap-1" Variant="BadgeVariant.Outline">
                    <LucideLeafCn Size="12" Class="h-3 w-3 text-green-600" />
                    Vegetarian
                </BadgeCn>
                <BadgeCn Class="gap-1" Variant="BadgeVariant.Outline">
                    <LucideWheatOffCn Size="12" Class="h-3 w-3 text-amber-600" />
                    Gluten-Free
                </BadgeCn>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-56 font-semibold text-foreground">Dish</TableHeadCn>
                        <TableHeadCn Class="w-64 font-semibold text-foreground">Description</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Dietary</TableHeadCn>
                        <TableHeadCn Class="w-16 font-semibold text-foreground text-center">Cal</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-right">Price</TableHeadCn>
                        <TableHeadCn Class="w-16"><span class="sr-only">Actions</span></TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var category in _categories)
                    {
                        <TableRowCn Class="bg-muted/30">
                            <TableCellCn Class="font-semibold text-sm py-2" colspan="6">@category</TableCellCn>
                        </TableRowCn>

                        @foreach (var item in _menuItems.Where(i => i.Category == category))
                        {
                            var dietaryTags = item.DietaryTags.Where(t => t != "popular" && t != "spicy").Take(2).ToArray();
                            var remaining = item.DietaryTags.Count(t => t != "popular" && t != "spicy") - 2;

                            <TableRowCn Class="@(!item.IsAvailable ? "opacity-50" : "")">
                                <TableCellCn>
                                    <div class="space-y-1">
                                        <div class="flex items-center gap-2">
                                            <span class="@Cn.Merge("font-medium text-sm", !item.IsAvailable ? "line-through" : "")">@item.Name</span>
                                            @if (item.IsNew)
                                            {
                                                <BadgeCn Class="text-[10px] px-1.5 py-0 bg-blue-100 text-blue-700 hover:bg-blue-100" Variant="BadgeVariant.Secondary">New</BadgeCn>
                                            }
                                            @if (item.DietaryTags.Contains("popular"))
                                            {
                                                <LucideStarCn Size="14" Class="h-3.5 w-3.5 text-yellow-500 fill-yellow-500" />
                                            }
                                        </div>
                                        @if (item.SpiceLevel > 0)
                                        {
                                            <div class="flex items-center gap-0.5" title="@(item.SpiceLevel == 1 ? "Mild" : item.SpiceLevel == 2 ? "Medium" : "Hot") spice level">
                                                @for (var i = 0; i < item.SpiceLevel; i++)
                                                {
                                                    <LucideFlameCn Size="12" Class="h-3 w-3 text-red-500 fill-red-500" />
                                                }
                                            </div>
                                        }
                                    </div>
                                </TableCellCn>
                                <TableCellCn>
                                    <p class="text-xs text-muted-foreground line-clamp-2">@item.Description</p>
                                </TableCellCn>
                                <TableCellCn>
                                    @if (dietaryTags.Length > 0)
                                    {
                                        <div class="flex items-center gap-1">
                                            @foreach (var tag in dietaryTags)
                                            {
                                                var (tagIcon, tagClass, tagLabel) = GetDietaryConfig(tag);
                                                <BadgeCn Class="@Cn.Merge("text-[10px] px-1.5 py-0 gap-0.5", tagClass)" Variant="BadgeVariant.Secondary" title="@tagLabel">
                                                    @tagIcon
                                                </BadgeCn>
                                            }
                                            @if (remaining > 0)
                                            {
                                                <span class="text-[10px] text-muted-foreground">+@remaining</span>
                                            }
                                        </div>
                                    }
                                </TableCellCn>
                                <TableCellCn Class="text-center">
                                    <span class="text-xs text-muted-foreground">@item.Calories</span>
                                </TableCellCn>
                                <TableCellCn Class="text-right">
                                    <span class="font-mono font-bold">@item.Price.ToString("C2")</span>
                                </TableCellCn>
                                <TableCellCn>
                                    @if (item.IsAvailable)
                                    {
                                        <ButtonCn Class="h-7 w-7 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" aria-label="@($"Add {item.Name} to order")">
                                            <LucidePlusCn Size="16" Class="h-4 w-4" />
                                        </ButtonCn>
                                    }
                                    else
                                    {
                                        <BadgeCn Class="text-[10px]" Variant="BadgeVariant.Outline">Sold Out</BadgeCn>
                                    }
                                </TableCellCn>
                            </TableRowCn>
                        }
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex items-center gap-6 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
                <LucideLeafCn Size="14" Class="h-3.5 w-3.5 text-green-600" />
                <span>Vegetarian</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideSparklesCn Size="14" Class="h-3.5 w-3.5 text-emerald-600" />
                <span>Vegan</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideWheatOffCn Size="14" Class="h-3.5 w-3.5 text-amber-600" />
                <span>Gluten-Free</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideFlameCn Size="14" Class="h-3.5 w-3.5 text-red-500" />
                <span>Spicy</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideStarCn Size="14" Class="h-3.5 w-3.5 text-yellow-500 fill-yellow-500" />
                <span>Popular</span>
            </div>
        </div>
    </div>
</div>

@code {
    private record MenuItem(string Id, string Name, string Description, string Category, double Price, int Calories, string[] DietaryTags, int SpiceLevel, bool IsAvailable, bool IsNew);

    private static readonly MenuItem[] _menuItems =
    [
        new("1", "Crispy Calamari", "Lightly breaded squid rings with marinara sauce and lemon aioli", "Appetizers", 14.95, 380, [], 0, true, false),
        new("2", "Bruschetta Trio", "Toasted baguette with tomato basil, mushroom, and olive tapenade", "Appetizers", 12.50, 290, ["vegetarian", "vegan"], 0, true, false),
        new("3", "Buffalo Cauliflower", "Crispy cauliflower florets tossed in spicy buffalo sauce", "Appetizers", 11.95, 320, ["vegetarian", "vegan", "gluten_free", "spicy", "popular"], 2, true, true),
        new("4", "Soup of the Day", "Ask your server for today's selection", "Appetizers", 8.95, 180, ["gluten_free"], 0, true, false),
        new("5", "Grilled Salmon", "Atlantic salmon with herb butter, roasted vegetables and wild rice", "Main Courses", 28.95, 520, ["gluten_free", "popular"], 0, true, false),
        new("6", "Filet Mignon", "8oz center-cut beef tenderloin with truffle mashed potatoes", "Main Courses", 42.95, 680, ["gluten_free"], 0, true, false),
        new("7", "Mushroom Risotto", "Creamy arborio rice with wild mushrooms, parmesan and truffle oil", "Main Courses", 22.95, 580, ["vegetarian", "gluten_free"], 0, true, false),
        new("8", "Thai Basil Stir Fry", "Wok-tossed vegetables and tofu with spicy Thai basil sauce", "Main Courses", 19.95, 420, ["vegetarian", "vegan", "spicy"], 3, true, true),
        new("9", "Classic Burger", "Angus beef patty with cheddar, lettuce, tomato and house sauce", "Main Courses", 18.95, 750, ["popular"], 0, false, false),
        new("10", "Truffle Fries", "Crispy fries with parmesan, truffle oil and fresh herbs", "Sides", 9.95, 380, ["vegetarian", "gluten_free"], 0, true, false),
        new("11", "Grilled Asparagus", "Fresh asparagus with lemon zest and olive oil", "Sides", 8.50, 90, ["vegetarian", "vegan", "gluten_free"], 0, true, false),
        new("12", "Mac & Cheese", "Four-cheese blend with crispy breadcrumb topping", "Sides", 10.95, 520, ["vegetarian"], 0, true, false),
        new("13", "Chocolate Lava Cake", "Warm chocolate cake with molten center and vanilla ice cream", "Desserts", 12.95, 680, ["vegetarian", "popular"], 0, true, false),
        new("14", "Creme Brulee", "Classic vanilla custard with caramelized sugar crust", "Desserts", 10.95, 420, ["vegetarian", "gluten_free"], 0, true, false),
        new("15", "Vegan Tiramisu", "Dairy-free coffee-soaked layers with cashew mascarpone", "Desserts", 11.95, 380, ["vegetarian", "vegan"], 0, true, true),
        new("16", "Fresh Lemonade", "House-made with fresh lemons and a hint of mint", "Beverages", 4.95, 120, ["vegetarian", "vegan", "gluten_free"], 0, true, false),
        new("17", "Espresso", "Double shot of premium Italian roast", "Beverages", 3.95, 5, ["vegetarian", "vegan", "gluten_free"], 0, true, false),
    ];

    private static readonly string[] _categories = _menuItems.Select(i => i.Category).Distinct().ToArray();
    private static readonly int _vegetarianCount = _menuItems.Count(i => i.DietaryTags.Contains("vegetarian") || i.DietaryTags.Contains("vegan"));

    private static (RenderFragment Icon, string ClassName, string Label) GetDietaryConfig(string tag) => tag switch
    {
        "vegetarian" => (@<LucideLeafCn Size="10" Class="h-2.5 w-2.5" />, "bg-green-100 text-green-700 hover:bg-green-100", "Vegetarian"),
        "vegan" => (@<LucideSparklesCn Size="10" Class="h-2.5 w-2.5" />, "bg-emerald-100 text-emerald-700 hover:bg-emerald-100", "Vegan"),
        "gluten_free" => (@<LucideWheatOffCn Size="10" Class="h-2.5 w-2.5" />, "bg-amber-100 text-amber-700 hover:bg-amber-100", "Gluten-Free"),
        _ => (@<LucideCircleCn Size="10" Class="h-2.5 w-2.5" />, "", tag),
    };
}
