@* ============================================================
   Block: tables-social-analytics
   Title: TablesSocialAnalytics
   Description: Social media post analytics with engagement metrics for React marketing dashboards built with shadcn/ui.
   Source: original/blocks/tables/tables-social-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Social Analytics</h3>
                <p class="text-xs text-muted-foreground">
                    @_posts.Length posts &middot; Last 7 days
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                @foreach (var p in _filterOptions)
                {
                    var pCopy = p;
                    <ButtonCn Variant="@(_platformFilter == pCopy ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" @onclick="@(() => _platformFilter = pCopy)">
                        @(pCopy == "all" ? "All" : GetPlatformLabel(pCopy))
                    </ButtonCn>
                }
            </div>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Post</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Platform</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">
                        <button type="button" class="flex items-center gap-1" @onclick="@(() => HandleSort("impressions"))">
                            Impr.
                            @if (_sortKey == "impressions")
                            {
                                @if (_sortDir == "desc")
                                {
                                    <LucideChevronDownCn Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideChevronUpCn Size="12" Class="size-3" />
                                }
                            }
                        </button>
                    </TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Engagement</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">
                        <button type="button" class="flex items-center gap-1" @onclick="@(() => HandleSort("engagementRate"))">
                            Rate
                            @if (_sortKey == "engagementRate")
                            {
                                @if (_sortDir == "desc")
                                {
                                    <LucideChevronDownCn Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideChevronUpCn Size="12" Class="size-3" />
                                }
                            }
                        </button>
                    </TableHeadCn>
                    <TableHeadCn Class="text-right text-xs font-medium text-muted-foreground">
                        <button type="button" class="ml-auto flex items-center gap-1" @onclick="@(() => HandleSort("clicks"))">
                            Clicks
                            @if (_sortKey == "clicks")
                            {
                                @if (_sortDir == "desc")
                                {
                                    <LucideChevronDownCn Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideChevronUpCn Size="12" Class="size-3" />
                                }
                            }
                        </button>
                    </TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var post in GetFiltered())
                {
                    var platformInfo = GetPlatformInfo(post.Platform);
                    var rateClass = post.EngagementRate >= 7 ? "text-green-600" : post.EngagementRate >= 5 ? "text-foreground" : "text-muted-foreground";
                    <TableRowCn Class="hover:bg-muted/50">
                        <TableCellCn>
                            <p class="max-w-64 truncate text-sm">@post.Content</p>
                            <p class="text-xs text-muted-foreground">@post.PublishedAt</p>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] font-normal", platformInfo.ClassName)">
                                @platformInfo.Label
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn Class="font-mono text-sm tabular-nums">
                            @FormatNumber(post.Impressions)
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                <span class="flex items-center gap-0.5">
                                    <LucideHeartCn Size="12" Class="size-3" /> @FormatNumber(post.Likes)
                                </span>
                                <span class="flex items-center gap-0.5">
                                    <LucideMessageCircleCn Size="12" Class="size-3" /> @post.Comments
                                </span>
                                <span class="flex items-center gap-0.5">
                                    <LucideRepeat2Cn Size="12" Class="size-3" /> @post.Shares
                                </span>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="@Cn.Merge("font-mono text-sm font-medium tabular-nums", rateClass)">
                                @post.EngagementRate%
                            </span>
                        </TableCellCn>
                        <TableCellCn Class="text-right font-mono text-sm tabular-nums">
                            @FormatNumber(post.Clicks)
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record SocialPost(string Id, string Content, string Platform, string PublishedAt, int Impressions, int Reach, int Likes, int Comments, int Shares, double EngagementRate, int Clicks);
    private record PlatformInfo(string Label, string ClassName);

    private static readonly SocialPost[] _posts =
    [
        new("1", "Introducing our new dashboard redesign with real-time analytics...", "twitter", "Mar 24, 2026", 45200, 32100, 892, 134, 267, 5.8, 1240),
        new("2", "5 lessons we learned scaling to 1M users in 2025...", "linkedin", "Mar 23, 2026", 28900, 21400, 1247, 89, 342, 7.8, 890),
        new("3", "Behind the scenes of our engineering team's hackathon...", "instagram", "Mar 22, 2026", 18700, 15200, 2341, 178, 89, 17.1, 456),
        new("4", "Full tutorial: Building a real-time chat with WebSockets...", "youtube", "Mar 21, 2026", 12400, 9800, 567, 234, 123, 9.4, 3210),
        new("5", "We just hit 50K stars on GitHub! Here's our open source story...", "twitter", "Mar 20, 2026", 89300, 67200, 4521, 312, 1892, 7.5, 5670),
        new("6", "Join our next webinar: Modern auth patterns for SaaS apps...", "linkedin", "Mar 19, 2026", 15600, 11200, 423, 56, 134, 5.5, 2100),
        new("7", "New release: Dark mode, keyboard shortcuts, and 20+ components...", "twitter", "Mar 18, 2026", 34500, 25800, 1789, 201, 567, 7.4, 3450),
    ];

    private static readonly string[] _filterOptions = ["all", "twitter", "linkedin", "instagram", "youtube"];

    private string _platformFilter = "all";
    private string _sortKey = "impressions";
    private string _sortDir = "desc";

    private void HandleSort(string key)
    {
        if (_sortKey == key)
            _sortDir = _sortDir == "desc" ? "asc" : "desc";
        else
        {
            _sortKey = key;
            _sortDir = "desc";
        }
    }

    private IEnumerable<SocialPost> GetFiltered()
    {
        var filtered = _platformFilter == "all"
            ? (IEnumerable<SocialPost>)_posts
            : _posts.Where(p => p.Platform == _platformFilter);

        var sorted = _sortKey switch
        {
            "impressions" => filtered.OrderBy(p => p.Impressions),
            "engagementRate" => filtered.OrderBy(p => p.EngagementRate),
            "clicks" => filtered.OrderBy(p => p.Clicks),
            _ => filtered.OrderBy(p => p.Impressions)
        };

        return _sortDir == "desc" ? sorted.Reverse() : sorted;
    }

    private static string FormatNumber(int n) =>
        n >= 1000 ? $"{(n / 1000.0):F1}K" : n.ToString();

    private static string GetPlatformLabel(string platform) => platform switch
    {
        "twitter" => "Twitter",
        "linkedin" => "LinkedIn",
        "instagram" => "Instagram",
        "youtube" => "YouTube",
        _ => platform
    };

    private static PlatformInfo GetPlatformInfo(string platform) => platform switch
    {
        "twitter" => new("Twitter", "bg-sky-500/10 text-sky-700"),
        "linkedin" => new("LinkedIn", "bg-blue-500/10 text-blue-700"),
        "instagram" => new("Instagram", "bg-pink-500/10 text-pink-700"),
        "youtube" => new("YouTube", "bg-red-500/10 text-red-700"),
        _ => new(platform, "")
    };
}
