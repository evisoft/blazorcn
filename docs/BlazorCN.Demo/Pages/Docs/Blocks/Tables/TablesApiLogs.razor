@* ============================================================
   Block: tables-api-logs
   Title: Tables Api Logs
   Description: Table component with API request logs showing endpoints, methods, status codes and response times
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-api-logs.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">API Request Logs</h3>
                <p class="text-sm text-muted-foreground">
                    @_apiLogs.Length requests &middot; @_avgResponseTime ms avg response
                </p>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Class="gap-1 border-green-200 text-green-700" Variant="BadgeVariant.Outline">
                    <LucideCheckCircle2Cn Size="12" Class="size-3" />
                    @_successCount success
                </BadgeCn>
                @if (_errorCount > 0)
                {
                    <BadgeCn Class="gap-1 border-red-200 text-red-700" Variant="BadgeVariant.Outline">
                        <LucideAlertCircleCn Size="12" Class="size-3" />
                        @_errorCount errors
                    </BadgeCn>
                }
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground">Method</TableHeadCn>
                        <TableHeadCn Class="w-56 font-semibold text-foreground">Endpoint</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Status</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-right">Time</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">
                            <LucideClockCn Size="16" Class="mx-auto size-4" />
                        </TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Request ID</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var log in _apiLogs)
                    {
                        var statusCat = GetStatusCategory(log.StatusCode);
                        <TableRowCn Class="@Cn.Merge(statusCat == "server_error" ? "bg-red-50/50" : "", statusCat == "client_error" ? "bg-yellow-50/30" : "")">
                            <TableCellCn>
                                <BadgeCn Class="@Cn.Merge("font-mono text-xs", GetMethodClass(log.Method))" Variant="BadgeVariant.Secondary">
                                    @log.Method
                                </BadgeCn>
                            </TableCellCn>
                            <TableCellCn>
                                <code class="block truncate font-mono text-sm">@log.Endpoint</code>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="@Cn.Merge("flex items-center gap-1.5", GetStatusClass(log.StatusCode))">
                                    @if (statusCat == "success")
                                    {
                                        <LucideCheckCircle2Cn Size="16" Class="size-4" />
                                    }
                                    else
                                    {
                                        <LucideAlertCircleCn Size="16" Class="size-4" />
                                    }
                                    <span class="font-mono font-medium">@log.StatusCode</span>
                                    <span class="truncate text-xs">@log.StatusText</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <span class="@Cn.Merge("font-mono text-sm", log.ResponseTime > 1000 ? "font-medium text-red-600" : log.ResponseTime > 500 ? "text-yellow-600" : "")">
                                    @(log.ResponseTime)ms
                                </span>
                            </TableCellCn>
                            <TableCellCn Class="text-center font-mono text-sm text-muted-foreground">
                                @log.Timestamp
                            </TableCellCn>
                            <TableCellCn>
                                <code class="text-xs text-muted-foreground">@log.RequestId</code>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>
    </div>
</div>

@code {
    private record ApiLog(string Id, string RequestId, string Method, string Endpoint, int StatusCode, string StatusText, int ResponseTime, string Timestamp, string UserAgent);

    private static readonly ApiLog[] _apiLogs =
    [
        new("1", "req_8f2k9x", "GET", "/api/v1/users", 200, "OK", 45, "14:32:15", "Chrome/120"),
        new("2", "req_3m7n2p", "POST", "/api/v1/orders", 201, "Created", 128, "14:32:12", "Safari/17"),
        new("3", "req_9k4j6h", "GET", "/api/v1/products/search", 200, "OK", 234, "14:32:08", "Firefox/121"),
        new("4", "req_2x8v5q", "PUT", "/api/v1/users/128", 200, "OK", 67, "14:32:05", "Chrome/120"),
        new("5", "req_7w3r9t", "DELETE", "/api/v1/cart/items/45", 204, "No Content", 38, "14:32:01", "Mobile Safari"),
        new("6", "req_1p6m4k", "POST", "/api/v1/auth/login", 401, "Unauthorized", 23, "14:31:58", "Chrome/120"),
        new("7", "req_5h9n2j", "GET", "/api/v1/inventory", 500, "Internal Error", 1250, "14:31:54", "Node/20"),
        new("8", "req_4f8k3x", "PATCH", "/api/v1/settings", 200, "OK", 89, "14:31:50", "Chrome/120"),
        new("9", "req_6v2m7p", "GET", "/api/v1/analytics/dashboard", 304, "Not Modified", 12, "14:31:47", "Safari/17"),
        new("10", "req_8j5n1q", "POST", "/api/v1/webhooks/stripe", 200, "OK", 156, "14:31:42", "Stripe/1.0"),
        new("11", "req_3k9x4h", "GET", "/api/v1/users/me", 404, "Not Found", 31, "14:31:38", "Chrome/120"),
        new("12", "req_7m2p6v", "POST", "/api/v1/uploads", 413, "Payload Too Large", 8, "14:31:35", "Firefox/121"),
    ];

    private static readonly int _successCount = _apiLogs.Count(l => l.StatusCode >= 200 && l.StatusCode < 300);
    private static readonly int _errorCount = _apiLogs.Count(l => l.StatusCode >= 400);
    private static readonly int _avgResponseTime = (int)Math.Round(_apiLogs.Average(l => (double)l.ResponseTime));

    private static string GetMethodClass(string method) => method switch
    {
        "GET" => "bg-green-100 text-green-700 hover:bg-green-100",
        "POST" => "bg-blue-100 text-blue-700 hover:bg-blue-100",
        "PUT" => "bg-yellow-100 text-yellow-700 hover:bg-yellow-100",
        "PATCH" => "bg-purple-100 text-purple-700 hover:bg-purple-100",
        "DELETE" => "bg-red-100 text-red-700 hover:bg-red-100",
        _ => "",
    };

    private static string GetStatusCategory(int statusCode) => statusCode switch
    {
        >= 200 and < 300 => "success",
        >= 300 and < 400 => "redirect",
        >= 400 and < 500 => "client_error",
        _ => "server_error",
    };

    private static string GetStatusClass(int statusCode) => GetStatusCategory(statusCode) switch
    {
        "success" => "text-green-600",
        "redirect" => "text-blue-600",
        "client_error" => "text-yellow-600",
        _ => "text-red-600",
    };
}
