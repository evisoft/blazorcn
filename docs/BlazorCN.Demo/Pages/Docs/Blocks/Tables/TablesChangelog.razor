@* ============================================================
   Block: tables-changelog
   Title: Tables Changelog
   Description: Table component with field-by-field changelog showing before and after values for audit dashboards
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-changelog.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Change History</h3>
                <p class="text-sm text-muted-foreground">
                    @_changes.Length changes across @_uniqueRecords records
                </p>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline">@_todayCount changes today</BadgeCn>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-32 font-semibold text-foreground">Record</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Field</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground">Type</TableHeadCn>
                        <TableHeadCn Class="w-36 font-semibold text-foreground">Old Value</TableHeadCn>
                        <TableHeadCn Class="w-8"></TableHeadCn>
                        <TableHeadCn Class="w-36 font-semibold text-foreground">New Value</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Changed By</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">When</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var change in _changes)
                    {
                        var (typeLabel, typeVariant, typeClass) = GetChangeTypeConfig(change.ChangeType);

                        <TableRowCn>
                            <TableCellCn>
                                <div class="space-y-0.5">
                                    <p class="font-medium text-sm truncate" title="@change.RecordName">@change.RecordName</p>
                                    <p class="text-xs text-muted-foreground font-mono">@change.RecordId</p>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="font-medium text-sm">@change.Field</TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@Cn.Merge("gap-1", typeClass)" Variant="@typeVariant">
                                    @GetChangeIcon(change.ChangeType)
                                    @typeLabel
                                </BadgeCn>
                            </TableCellCn>
                            <TableCellCn>
                                @if (change.OldValue is null)
                                {
                                    <span class="text-muted-foreground italic">Empty</span>
                                }
                                else
                                {
                                    <span class="font-mono text-sm text-red-600 line-through">@change.OldValue</span>
                                }
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <LucideArrowRightCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                            </TableCellCn>
                            <TableCellCn>
                                @if (change.NewValue is null)
                                {
                                    <span class="text-muted-foreground italic">Empty</span>
                                }
                                else
                                {
                                    <span class="font-mono text-sm text-green-600">@change.NewValue</span>
                                }
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <div class="flex h-6 w-6 items-center justify-center rounded-full bg-muted text-[10px] font-medium">
                                        @GetInitials(change.ChangedBy)
                                    </div>
                                    <span class="text-sm truncate">@change.ChangedBy.Split(' ')[0]</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-sm text-muted-foreground">@change.RelativeTime</TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex items-center gap-6 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
                <LucidePlusCn Size="14" Class="h-3.5 w-3.5 text-green-600" />
                <span>Field added</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideRefreshCwCn Size="14" Class="h-3.5 w-3.5" />
                <span>Value changed</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideMinusCn Size="14" Class="h-3.5 w-3.5 text-destructive" />
                <span>Field removed</span>
            </div>
        </div>
    </div>
</div>

@code {
    private record ChangeRecord(string Id, string RecordId, string RecordName, string Field, string ChangeType, string? OldValue, string? NewValue, string ChangedBy, string RelativeTime);

    private static readonly ChangeRecord[] _changes =
    [
        new("ch-001", "USR-128", "Emily Rodriguez", "Email", "modified", "emily.r@oldmail.com", "emily.rodriguez@company.com", "Sarah Chen", "5 minutes ago"),
        new("ch-002", "USR-128", "Emily Rodriguez", "Department", "modified", "Marketing", "Product", "Sarah Chen", "5 minutes ago"),
        new("ch-003", "USR-128", "Emily Rodriguez", "Title", "modified", "Marketing Manager", "Product Manager", "Sarah Chen", "5 minutes ago"),
        new("ch-004", "PRJ-042", "Website Redesign", "Status", "modified", "In Progress", "In Review", "Marcus Johnson", "1 hour ago"),
        new("ch-005", "PRJ-042", "Website Redesign", "Due Date", "modified", "Jan 20, 2024", "Jan 25, 2024", "Marcus Johnson", "1 hour ago"),
        new("ch-006", "DOC-891", "Q4 Report", "Access Level", "added", null, "Confidential", "David Kim", "3 hours ago"),
        new("ch-007", "TASK-234", "API Integration", "Assignee", "modified", "Unassigned", "Lisa Thompson", "James Wilson", "4 hours ago"),
        new("ch-008", "TASK-234", "API Integration", "Priority", "modified", "Medium", "High", "James Wilson", "4 hours ago"),
        new("ch-009", "USR-156", "Michael Brown", "Phone", "removed", "+1 555-0123", null, "Michael Brown", "5 hours ago"),
        new("ch-010", "PRJ-038", "Mobile App v2", "Budget", "modified", "$50,000", "$75,000", "Anna Martinez", "Yesterday"),
    ];

    private static readonly int _todayCount = _changes.Count(c => !c.RelativeTime.Contains("Yesterday"));
    private static readonly int _uniqueRecords = _changes.Select(c => c.RecordId).Distinct().Count();

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();

    private static RenderFragment GetChangeIcon(string changeType) => changeType switch
    {
        "added" => @<LucidePlusCn Size="12" Class="h-3 w-3" />,
        "modified" => @<LucideRefreshCwCn Size="12" Class="h-3 w-3" />,
        "removed" => @<LucideMinusCn Size="12" Class="h-3 w-3" />,
        _ => @<LucideCircleCn Size="12" Class="h-3 w-3" />,
    };

    private static (string Label, BadgeVariant Variant, string ClassName) GetChangeTypeConfig(string changeType) => changeType switch
    {
        "added" => ("Added", BadgeVariant.Default, "bg-green-100 text-green-700 hover:bg-green-100"),
        "modified" => ("Changed", BadgeVariant.Secondary, ""),
        "removed" => ("Removed", BadgeVariant.Destructive, ""),
        _ => ("Unknown", BadgeVariant.Secondary, ""),
    };
}
