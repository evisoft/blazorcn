@* ========================================
   Block: tables-column-reorder
   Title: Tables Column Reorder
   Description: Table component with draggable column headers for custom column ordering in React data grids
   Long Description: Table component with color dot indicators and category labels for React project management dashboards
   Dependencies: ButtonCn, TableCn, LucideGripVerticalCn, LucideRotateCcwCn
   Source: original/blocks/tables/tables-column-reorder.tsx
   ======================================== *@

<section class="container mx-auto py-16">
    <div style="width: 900px">
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-semibold">Team Directory</h3>
                    <p class="text-sm text-muted-foreground">Drag column headers to reorder</p>
                </div>
                @if (_isReordered)
                {
                    <ButtonCn @onclick="ResetColumns" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                        <LucideRotateCcwCn Size="16" Class="mr-1 h-4 w-4" />
                        Reset Order
                    </ButtonCn>
                }
            </div>

            <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
                <TableCn Class="table-fixed" style="width: 850px">
                    <TableHeaderCn>
                        <TableRowCn>
                            @foreach (var column in _columns)
                            {
                                <TableHeadCn
                                    Class="@Cn.Merge(Cn.Merge(column.Width, "cursor-grab select-none font-semibold text-foreground transition-colors"))">
                                    <div class="flex items-center gap-1.5">
                                        <LucideGripVerticalCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                                        @column.Label
                                    </div>
                                </TableHeadCn>
                            }
                        </TableRowCn>
                    </TableHeaderCn>
                    <TableBodyCn>
                        @foreach (var employee in _employees)
                        {
                            <TableRowCn>
                                @foreach (var column in _columns)
                                {
                                    <TableCellCn Class="@Cn.Merge(Cn.Merge(column.Id == "name" ? "font-medium" : "", column.Id == "email" || column.Id == "startDate" ? "text-muted-foreground" : ""))">
                                        @GetValue(employee, column.Id)
                                    </TableCellCn>
                                }
                            </TableRowCn>
                        }
                    </TableBodyCn>
                </TableCn>
            </div>

            <div class="flex items-center justify-between">
                <p class="text-xs text-muted-foreground">
                    Current order: @(string.Join(" \u2192 ", _columns.Select(c => c.Label)))
                </p>
                <p class="text-xs text-muted-foreground">@_employees.Length employees</p>
            </div>
        </div>
    </div>
</section>

@code {
    private record ColumnDef(string Id, string Label, string Width);
    private record Employee(string Id, string Name, string Email, string Department, string Role, string Location, string StartDate);

    private static readonly ColumnDef[] _defaultColumns =
    [
        new("name", "Name", "w-36"),
        new("email", "Email", "w-48"),
        new("department", "Department", "w-28"),
        new("role", "Role", "w-36"),
        new("location", "Location", "w-28"),
        new("startDate", "Start Date", "w-24"),
    ];

    private ColumnDef[] _columns = _defaultColumns.ToArray();

    private bool _isReordered => !_columns.Select(c => c.Id).SequenceEqual(_defaultColumns.Select(c => c.Id));

    private static readonly Employee[] _employees =
    [
        new("1", "Sarah Chen", "sarah.chen@@company.com", "Engineering", "Senior Developer", "San Francisco", "Mar 2021"),
        new("2", "Marcus Johnson", "m.johnson@@company.com", "Design", "Lead Designer", "New York", "Jun 2020"),
        new("3", "Emily Rodriguez", "e.rodriguez@@company.com", "Marketing", "Marketing Manager", "Austin", "Jan 2022"),
        new("4", "David Kim", "d.kim@@company.com", "Engineering", "DevOps Engineer", "Seattle", "Sep 2021"),
        new("5", "Lisa Thompson", "l.thompson@@company.com", "Sales", "Account Executive", "Chicago", "Apr 2023"),
        new("6", "James Wilson", "j.wilson@@company.com", "Product", "Product Manager", "San Francisco", "Nov 2020"),
    ];

    private void ResetColumns()
    {
        _columns = _defaultColumns.ToArray();
    }

    private static string GetValue(Employee employee, string columnId) => columnId switch
    {
        "name" => employee.Name,
        "email" => employee.Email,
        "department" => employee.Department,
        "role" => employee.Role,
        "location" => employee.Location,
        "startDate" => employee.StartDate,
        _ => ""
    };
}
