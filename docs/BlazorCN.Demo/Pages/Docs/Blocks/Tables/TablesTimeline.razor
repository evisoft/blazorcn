@* ============================================================
   Block: tables-timeline
   Title: Tables Timeline
   Description: Timeline table component with date grouping and status indicators for React activity feeds
   Long Description: Table component with inline image thumbnails for React media galleries and content management systems
   Dependencies: AvatarCn, BadgeCn, TableCn
   Source: original/blocks/tables/tables-timeline.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <div style="width: 900px">
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <h3 class="text-lg font-semibold">Activity Timeline</h3>
                <p class="text-sm text-muted-foreground">@events.Length events</p>
            </div>

            <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
                <TableCn style="width: 850px">
                    <TableBodyCn>
                        @foreach (var date in dateOrder)
                        {
                            <TableRowCn Class="bg-muted/50 hover:bg-muted/50">
                                <TableCellCn Class="py-2" ColSpan="3">
                                    <span class="text-sm font-semibold text-foreground">@date</span>
                                </TableCellCn>
                            </TableRowCn>

                            @foreach (var evt in GetEventsForDate(date))
                            {
                                var config = GetEventConfig(evt.Type);

                                <TableRowCn>
                                    <TableCellCn Class="w-24">
                                        <BadgeCn Class="@Cn.Merge(Cn.Merge("gap-1", config.Color))" Variant="BadgeVariant.Outline">
                                            @config.Label
                                        </BadgeCn>
                                    </TableCellCn>
                                    <TableCellCn>
                                        <div class="flex items-center gap-3">
                                            <AvatarCn Class="h-8 w-8">
                                                <AvatarFallbackCn Class="text-xs">
                                                    @GetInitials(evt.ActorName)
                                                </AvatarFallbackCn>
                                            </AvatarCn>
                                            <div class="flex-1 min-w-0">
                                                <p class="text-sm">
                                                    <span class="font-medium">@evt.ActorName</span>
                                                    <span class="text-muted-foreground"> @evt.Action </span>
                                                    <span class="font-medium">@evt.Target</span>
                                                </p>
                                            </div>
                                        </div>
                                    </TableCellCn>
                                    <TableCellCn Class="w-24 text-right">
                                        <span class="text-sm text-muted-foreground">@evt.Timestamp</span>
                                    </TableCellCn>
                                </TableRowCn>
                            }
                        }
                    </TableBodyCn>
                </TableCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record TimelineEvent(string Id, string Type, string ActorName, string Action, string Target, string Timestamp, string Date);
    private record EventConfig(string Color, string Label);

    private static readonly TimelineEvent[] events = new[]
    {
        new TimelineEvent("1", "commented", "Sarah Chen", "commented on", "Project Roadmap Q1", "10:45 AM", "Today"),
        new TimelineEvent("2", "uploaded", "Alex Kim", "uploaded", "design-specs-v2.pdf", "09:32 AM", "Today"),
        new TimelineEvent("3", "updated", "Jordan Lee", "updated", "API Documentation", "09:15 AM", "Today"),
        new TimelineEvent("4", "login", "Morgan Davis", "signed in from", "San Francisco, CA", "08:20 AM", "Today"),
        new TimelineEvent("5", "created", "Taylor Smith", "created", "New Feature Request", "04:30 PM", "Yesterday"),
        new TimelineEvent("6", "invited", "Sarah Chen", "invited", "jamie@@company.com to the team", "02:15 PM", "Yesterday"),
        new TimelineEvent("7", "deleted", "Alex Kim", "deleted", "Outdated Template", "11:45 AM", "Yesterday"),
        new TimelineEvent("8", "settings", "Jordan Lee", "changed", "notification preferences", "10:00 AM", "Yesterday"),
        new TimelineEvent("9", "created", "Morgan Davis", "created", "Sprint Planning Doc", "03:20 PM", "January 14, 2024"),
        new TimelineEvent("10", "commented", "Taylor Smith", "commented on", "Bug Report #234", "01:45 PM", "January 14, 2024"),
        new TimelineEvent("11", "updated", "Sarah Chen", "updated", "Team Guidelines", "11:30 AM", "January 14, 2024"),
        new TimelineEvent("12", "uploaded", "Alex Kim", "uploaded", "quarterly-report.xlsx", "09:00 AM", "January 14, 2024"),
    };

    private static readonly string[] dateOrder = new[] { "Today", "Yesterday", "January 14, 2024" };

    private static TimelineEvent[] GetEventsForDate(string date) =>
        events.Where(e => e.Date == date).ToArray();

    private static string GetInitials(string name) =>
        string.Join("", name.Split(' ').Select(n => n[0]));

    private static EventConfig GetEventConfig(string type) => type switch
    {
        "created" => new EventConfig("border-green-200 text-green-700", "Created"),
        "updated" => new EventConfig("border-blue-200 text-blue-700", "Updated"),
        "deleted" => new EventConfig("border-red-200 text-red-700", "Deleted"),
        "commented" => new EventConfig("border-purple-200 text-purple-700", "Comment"),
        "login" => new EventConfig("border-gray-200 text-gray-700", "Login"),
        "uploaded" => new EventConfig("border-orange-200 text-orange-700", "Upload"),
        "settings" => new EventConfig("border-gray-200 text-gray-700", "Settings"),
        "invited" => new EventConfig("border-teal-200 text-teal-700", "Invite"),
        _ => new EventConfig("border-gray-200 text-gray-700", type),
    };
}
