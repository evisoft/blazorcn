@* ============================================================
   Block: tables-crypto-portfolio
   Title: Tables Crypto Portfolio
   Description: Table component with cryptocurrency portfolio showing holdings, prices, gains and allocation percentages for finance dashboards
   Dependencies: TableCn
   Source: original/blocks/tables/tables-crypto-portfolio.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Crypto Portfolio</h3>
                <p class="text-sm text-muted-foreground">
                    @_portfolio.Length assets &middot; Updated just now
                </p>
            </div>
            <div class="text-right">
                <p class="text-2xl font-bold">$@_totalValue.ToString("N2")</p>
                <div class="@Cn.Merge("flex items-center justify-end gap-1 text-sm", _totalProfit >= 0 ? "text-green-600" : "text-red-600")">
                    @if (_totalProfit >= 0)
                    {
                        <LucideTrendingUpCn Size="16" Class="h-4 w-4" />
                    }
                    else
                    {
                        <LucideTrendingDownCn Size="16" Class="h-4 w-4" />
                    }
                    <span>@(_totalProfit >= 0 ? "+" : "")$@_totalProfit.ToString("N2") (@($"{_totalProfitPercent:F1}")%)</span>
                </div>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-44 font-semibold text-foreground">Asset</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground text-right">Price</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">24h</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground text-right">Holdings</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground text-right">Value</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">P/L</TableHeadCn>
                        <TableHeadCn Class="w-32 font-semibold text-foreground">Allocation</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var coin in _portfolio)
                    {
                        var costBasis = coin.AvgBuyPrice * coin.Holdings;
                        var profit = coin.Value - costBasis;
                        var profitPct = costBasis != 0 ? (profit / costBasis) * 100 : 0;
                        var isProfitable = profit >= 0;
                        var isPositive24h = coin.Change24h >= 0;

                        <TableRowCn>
                            <TableCellCn>
                                <div class="flex items-center gap-3">
                                    <div class="flex h-8 w-8 items-center justify-center rounded-full text-white text-xs font-bold"
                                         style="@($"background-color: {coin.Color}")">
                                        @coin.Symbol[..2]
                                    </div>
                                    <div>
                                        <p class="font-medium">@coin.Name</p>
                                        <p class="text-xs text-muted-foreground">@coin.Symbol</p>
                                    </div>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <span class="font-mono font-medium">$@FormatPrice(coin.Price)</span>
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <div class="@Cn.Merge("flex items-center justify-center gap-0.5 text-xs font-medium", isPositive24h ? "text-green-600" : "text-red-600")">
                                    @if (isPositive24h)
                                    {
                                        <LucideArrowUpCn Size="12" Class="h-3 w-3" />
                                    }
                                    else
                                    {
                                        <LucideArrowDownCn Size="12" Class="h-3 w-3" />
                                    }
                                    @($"{Math.Abs(coin.Change24h):F2}")%
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <div>
                                    <p class="font-mono text-sm">@coin.Holdings.ToString("N4").TrimEnd('0').TrimEnd('.') @coin.Symbol</p>
                                    <p class="text-xs text-muted-foreground">Avg $@FormatPrice(coin.AvgBuyPrice)</p>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <span class="font-mono font-bold">$@coin.Value.ToString("N2")</span>
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <div class="@Cn.Merge("flex items-center justify-center gap-1", isProfitable ? "text-green-600" : "text-red-600")">
                                    @if (isProfitable)
                                    {
                                        <LucideTrendingUpCn Size="16" Class="h-4 w-4" />
                                    }
                                    else
                                    {
                                        <LucideTrendingDownCn Size="16" Class="h-4 w-4" />
                                    }
                                    <span class="font-medium">@(isProfitable ? "+" : "")@($"{profitPct:F1}")%</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="space-y-1">
                                    <div class="flex items-center justify-between text-xs">
                                        <span class="text-muted-foreground">@($"{coin.Allocation:F1}")%</span>
                                    </div>
                                    <div class="h-1.5 w-full rounded-full bg-muted">
                                        <div class="h-full rounded-full bg-primary" style="@($"width: {coin.Allocation}%")"></div>
                                    </div>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex items-center gap-6 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
                <LucideWalletCn Size="14" Class="h-3.5 w-3.5" />
                <span>@_portfolio.Length assets</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideTrendingUpCn Size="14" Class="h-3.5 w-3.5 text-green-600" />
                <span>Profitable</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideTrendingDownCn Size="14" Class="h-3.5 w-3.5 text-red-600" />
                <span>At loss</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideArrowUpCn Size="14" Class="h-3.5 w-3.5 text-green-600" />
                <LucideArrowDownCn Size="14" Class="h-3.5 w-3.5 text-red-600" />
                <span>24h change</span>
            </div>
        </div>
    </div>
</div>

@code {
    private record CryptoHolding(string Id, string Symbol, string Name, string Color, double Price, double Change24h, double Holdings, double AvgBuyPrice, double Value, double Allocation);

    private static readonly CryptoHolding[] _portfolio =
    [
        new("btc", "BTC", "Bitcoin", "#F7931A", 43250.0, 2.34, 0.5432, 38500, 23493.90, 42.5),
        new("eth", "ETH", "Ethereum", "#627EEA", 2285.50, -1.28, 4.215, 2100, 9633.38, 17.4),
        new("sol", "SOL", "Solana", "#00FFA3", 98.45, 5.67, 85.0, 65.0, 8368.25, 15.1),
        new("bnb", "BNB", "BNB", "#F3BA2F", 312.80, 0.89, 12.5, 280.0, 3910.00, 7.1),
        new("xrp", "XRP", "XRP", "#23292F", 0.62, -2.45, 5000, 0.55, 3100.00, 5.6),
        new("ada", "ADA", "Cardano", "#0033AD", 0.58, 1.23, 4500, 0.45, 2610.00, 4.7),
        new("doge", "DOGE", "Dogecoin", "#C2A633", 0.085, 8.92, 25000, 0.065, 2125.00, 3.8),
        new("dot", "DOT", "Polkadot", "#E6007A", 7.85, -0.56, 250, 8.5, 1962.50, 3.5),
    ];

    private static readonly double _totalValue = _portfolio.Sum(c => c.Value);
    private static readonly double _totalCost = _portfolio.Sum(c => c.AvgBuyPrice * c.Holdings);
    private static readonly double _totalProfit = _totalValue - _totalCost;
    private static readonly double _totalProfitPercent = _totalCost != 0 ? (_totalProfit / _totalCost) * 100 : 0;

    private static string FormatPrice(double price) =>
        price < 1 ? price.ToString("F4") : price.ToString("N2");
}
