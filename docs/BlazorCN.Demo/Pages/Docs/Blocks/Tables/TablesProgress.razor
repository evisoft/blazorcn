@* ============================================================
   Block: tables-progress
   Title: Tables Progress
   Description: Table component with inline progress bars showing completion percentages for project dashboards
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-progress.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Project Progress</h3>
                <p class="text-sm text-muted-foreground">
                    @_completedCount completed &middot; @_atRiskCount need attention
                </p>
            </div>
            <div class="flex items-center gap-4 text-sm">
                <div class="flex items-center gap-1.5">
                    <div class="h-2 w-2 rounded-full bg-green-500"></div>
                    <span class="text-muted-foreground">Completed</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <div class="h-2 w-2 rounded-full bg-primary"></div>
                    <span class="text-muted-foreground">On Track</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <div class="h-2 w-2 rounded-full bg-yellow-500"></div>
                    <span class="text-muted-foreground">At Risk</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <div class="h-2 w-2 rounded-full bg-destructive"></div>
                    <span class="text-muted-foreground">Behind</span>
                </div>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-44 font-semibold text-foreground">Project</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Client</TableHeadCn>
                        <TableHeadCn Class="w-48 font-semibold text-foreground">Progress</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Tasks</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Due Date</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Status</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var project in _projects)
                    {
                        var (statusLabel, statusVariant, statusClass, progressColor, statusColor) = GetStatusConfig(project.Status);

                        <TableRowCn>
                            <TableCellCn Class="font-medium">@project.Name</TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@project.Client</TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-3">
                                    <div class="relative w-32">
                                        <div class="h-2 w-full rounded-full bg-muted"></div>
                                        <div class="@Cn.Merge("absolute inset-y-0 left-0 rounded-full transition-all duration-500", progressColor)"
                                             style="@($"width: {Math.Min(project.Progress, 100)}%")"></div>
                                    </div>
                                    <span class="@Cn.Merge("text-sm font-medium tabular-nums w-12", statusColor)">@project.Progress%</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <span class="text-sm">
                                    <span class="font-medium">@project.TasksCompleted</span><span class="text-muted-foreground">/@project.TasksTotal</span>
                                </span>
                            </TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@project.DueDate</TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@Cn.Merge("gap-1", statusClass)" Variant="@statusVariant">
                                    @GetStatusIcon(project.Status)
                                    @statusLabel
                                </BadgeCn>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Progress bars show task completion percentage with status-based colors
        </p>
    </div>
</div>

@code {
    private record ProjectItem(string Id, string Name, string Client, int Progress, int TasksCompleted, int TasksTotal, string DueDate, string Status);

    private static readonly ProjectItem[] _projects =
    [
        new("1", "Website Redesign", "Acme Corp", 100, 24, 24, "Jan 15", "completed"),
        new("2", "Mobile App v2", "TechStart", 78, 18, 23, "Feb 28", "on-track"),
        new("3", "API Integration", "DataFlow", 45, 9, 20, "Jan 20", "at-risk"),
        new("4", "Dashboard Analytics", "MetricsPro", 92, 11, 12, "Jan 18", "on-track"),
        new("5", "E-commerce Platform", "ShopEasy", 23, 7, 30, "Jan 10", "behind"),
        new("6", "CRM Migration", "SalesForce", 67, 14, 21, "Mar 15", "on-track"),
        new("7", "Security Audit", "SecureBank", 55, 11, 20, "Feb 05", "at-risk"),
        new("8", "Cloud Infrastructure", "CloudNine", 88, 22, 25, "Jan 25", "on-track"),
    ];

    private static readonly int _completedCount = _projects.Count(p => p.Status == "completed");
    private static readonly int _atRiskCount = _projects.Count(p => p.Status is "at-risk" or "behind");

    private static (string Label, BadgeVariant Variant, string ClassName, string ProgressColor, string StatusColor) GetStatusConfig(string status) => status switch
    {
        "completed" => ("Completed", BadgeVariant.Default, "bg-green-100 text-green-700 hover:bg-green-100", "bg-green-500", "text-green-600"),
        "on-track" => ("On Track", BadgeVariant.Secondary, "", "bg-primary", "text-primary"),
        "at-risk" => ("At Risk", BadgeVariant.Outline, "border-yellow-300 text-yellow-700", "bg-yellow-500", "text-yellow-600"),
        "behind" => ("Behind", BadgeVariant.Destructive, "", "bg-destructive", "text-destructive"),
        _ => ("Unknown", BadgeVariant.Secondary, "", "bg-muted", "text-muted-foreground"),
    };

    private static RenderFragment GetStatusIcon(string status) => status switch
    {
        "completed" => @<LucideCircleCheckBigCn Size="12" Class="h-3 w-3" />,
        "on-track" => @<LucideClockCn Size="12" Class="h-3 w-3" />,
        "at-risk" => @<LucideTriangleAlertCn Size="12" Class="h-3 w-3" />,
        "behind" => @<LucideTriangleAlertCn Size="12" Class="h-3 w-3" />,
        _ => @<LucideCircleCn Size="12" Class="h-3 w-3" />,
    };
}
