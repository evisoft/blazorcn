@* ============================================================
   Block: tables-priority
   Title: Tables Priority
   Description: Table component with priority indicators and urgency levels for task and issue tracking
   Dependencies: BadgeCn, ButtonCn, TableCn
   Source: original/blocks/tables/tables-priority.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Issue Tracker</h3>
                <p class="text-sm text-muted-foreground">
                    @_issues.Length issues &middot; @_criticalCount critical &middot; @_escalatedCount escalated
                </p>
            </div>
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-3 text-sm">
                    <div class="flex items-center gap-1">
                        <LucideFlameCn Size="14" Class="h-3.5 w-3.5 text-red-600" />
                        <span class="text-muted-foreground">@_issues.Count(i => i.Priority == "critical")</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideArrowUpCn Size="14" Class="h-3.5 w-3.5 text-orange-600" />
                        <span class="text-muted-foreground">@_issues.Count(i => i.Priority == "high")</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideMinusCn Size="14" Class="h-3.5 w-3.5 text-yellow-600" />
                        <span class="text-muted-foreground">@_issues.Count(i => i.Priority == "medium")</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <LucideArrowDownCn Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                        <span class="text-muted-foreground">@_issues.Count(i => i.Priority == "low")</span>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                    <LucideCalendarCn Size="16" Class="mr-2 h-4 w-4" />
                    Filter
                </ButtonCn>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground">ID</TableHeadCn>
                        <TableHeadCn Class="w-72 font-semibold text-foreground">Title</TableHeadCn>
                        <TableHeadCn Class="w-32 font-semibold text-foreground">Priority</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Status</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Assignee</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Due Date</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var issue in _issues)
                    {
                        var (prioLabel, prioIcon, prioClassName, prioBadgeClass) = GetPriorityConfig(issue.Priority);
                        var (statusLabel, statusVariant) = GetStatusConfig(issue.Status);
                        var (dueDateColorClass, dueDateFontClass) = GetDueDateStyle(issue.DaysUntilDue);

                        <TableRowCn Class="@Cn.Merge(issue.Priority == "critical" ? "bg-red-50/50" : "", issue.IsEscalated ? "border-l-2 border-l-red-500" : "")">
                            <TableCellCn Class="font-mono text-sm text-muted-foreground">@issue.Id</TableCellCn>
                            <TableCellCn Class="font-medium truncate" title="@issue.Title">@issue.Title</TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <BadgeCn Class="@Cn.Merge("gap-1 font-medium", prioBadgeClass)" Variant="BadgeVariant.Outline">
                                        @prioIcon
                                        @prioLabel
                                    </BadgeCn>
                                    @if (issue.IsEscalated)
                                    {
                                        <div class="flex h-5 w-5 items-center justify-center rounded-full bg-red-100 animate-pulse" title="Escalated - requires immediate attention">
                                            <LucideTriangleAlertCn Size="12" Class="h-3 w-3 text-red-600" />
                                        </div>
                                    }
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <BadgeCn Variant="@statusVariant">@statusLabel</BadgeCn>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <LucideUserCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                                    <span class="text-sm truncate">@issue.Assignee.Split(' ')[0]</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <LucideClockCn Size="16" Class="@Cn.Merge("h-4 w-4", dueDateColorClass)" />
                                    <span class="@Cn.Merge("text-sm", dueDateColorClass, dueDateFontClass)">@issue.DueDate</span>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Critical issues highlighted. Escalated items marked with pulsing indicator.
        </p>
    </div>
</div>

@code {
    private record Issue(string Id, string Title, string Priority, string Status, string Assignee, string DueDate, int DaysUntilDue, bool IsEscalated);

    private static readonly Issue[] _issues =
    [
        new("ISS-001", "Production database connection timeout", "critical", "in-progress", "Sarah Chen", "Today", 0, true),
        new("ISS-002", "Payment gateway returning 500 errors", "critical", "open", "Marcus Johnson", "Today", 0, false),
        new("ISS-003", "User authentication fails after password reset", "high", "in-progress", "Emily Rodriguez", "Tomorrow", 1, true),
        new("ISS-004", "Dashboard charts not loading on Safari", "high", "review", "David Kim", "Jan 18", 3, false),
        new("ISS-005", "Email notifications delayed by 30 minutes", "medium", "open", "Lisa Thompson", "Jan 20", 5, false),
        new("ISS-006", "Export CSV missing column headers", "medium", "blocked", "James Wilson", "Jan 22", 7, false),
        new("ISS-007", "Dark mode toggle not persisting", "low", "open", "Anna Martinez", "Jan 25", 10, false),
        new("ISS-008", "Update copyright year in footer", "low", "open", "Michael Brown", "Jan 30", 15, false),
    ];

    private static readonly int _criticalCount = _issues.Count(i => i.Priority == "critical");
    private static readonly int _escalatedCount = _issues.Count(i => i.IsEscalated);

    private static (string Label, RenderFragment Icon, string ClassName, string BadgeClass) GetPriorityConfig(string priority) => priority switch
    {
        "critical" => ("Critical", @<LucideFlameCn Size="14" Class="h-3.5 w-3.5 text-red-600" />, "text-red-600", "bg-red-100 text-red-700 border-red-200"),
        "high" => ("High", @<LucideArrowUpCn Size="14" Class="h-3.5 w-3.5 text-orange-600" />, "text-orange-600", "bg-orange-100 text-orange-700 border-orange-200"),
        "medium" => ("Medium", @<LucideMinusCn Size="14" Class="h-3.5 w-3.5 text-yellow-600" />, "text-yellow-600", "bg-yellow-100 text-yellow-700 border-yellow-200"),
        _ => ("Low", @<LucideArrowDownCn Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />, "text-muted-foreground", "bg-muted text-muted-foreground border-border"),
    };

    private static (string Label, BadgeVariant Variant) GetStatusConfig(string status) => status switch
    {
        "open" => ("Open", BadgeVariant.Outline),
        "in-progress" => ("In Progress", BadgeVariant.Default),
        "review" => ("Review", BadgeVariant.Secondary),
        "blocked" => ("Blocked", BadgeVariant.Destructive),
        _ => (status, BadgeVariant.Secondary),
    };

    private static (string ColorClass, string FontClass) GetDueDateStyle(int daysUntilDue) => daysUntilDue switch
    {
        < 0 => ("text-destructive", "font-medium"),
        <= 1 => ("text-orange-600", "font-medium"),
        <= 3 => ("text-yellow-600", ""),
        _ => ("text-muted-foreground", ""),
    };
}
