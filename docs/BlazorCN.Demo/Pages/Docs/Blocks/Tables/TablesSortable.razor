@* ============================================================
   Block: tables-sortable
   Title: Tables Sortable
   Description: Sortable table component with clickable column headers and direction indicators
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-sortable.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
        <TableCn Class="table-fixed" style="width: 850px">
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn>
                        <button type="button" class="flex items-center font-semibold text-foreground hover:text-foreground/80" @onclick="() => HandleSort(SortCol.Name)">
                            Name
                            @GetSortIcon(SortCol.Name)
                        </button>
                    </TableHeadCn>
                    <TableHeadCn>
                        <button type="button" class="flex items-center font-semibold text-foreground hover:text-foreground/80" @onclick="() => HandleSort(SortCol.Email)">
                            Email
                            @GetSortIcon(SortCol.Email)
                        </button>
                    </TableHeadCn>
                    <TableHeadCn>
                        <button type="button" class="flex items-center font-semibold text-foreground hover:text-foreground/80" @onclick="() => HandleSort(SortCol.Role)">
                            Role
                            @GetSortIcon(SortCol.Role)
                        </button>
                    </TableHeadCn>
                    <TableHeadCn>
                        <button type="button" class="flex items-center font-semibold text-foreground hover:text-foreground/80" @onclick="() => HandleSort(SortCol.Status)">
                            Status
                            @GetSortIcon(SortCol.Status)
                        </button>
                    </TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var user in GetSortedUsers())
                {
                    var (statusLabel, statusVariant, statusClass) = GetStatusConfig(user.Status);

                    <TableRowCn>
                        <TableCellCn Class="font-medium">@user.Name</TableCellCn>
                        <TableCellCn Class="text-muted-foreground">@user.Email</TableCellCn>
                        <TableCellCn>@user.Role</TableCellCn>
                        <TableCellCn>
                            <BadgeCn Class="@statusClass" Variant="@statusVariant">@statusLabel</BadgeCn>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</div>

@code {
    private enum SortCol { Name, Email, Role, Status }

    private record User(string Id, string Name, string Email, string Role, string Status);

    private static readonly User[] _users =
    [
        new("1", "Alice Johnson", "alice.johnson@example.com", "Admin", "active"),
        new("2", "Bob Smith", "bob.smith@example.com", "User", "active"),
        new("3", "Carol Williams", "carol.williams@example.com", "Manager", "inactive"),
        new("4", "David Brown", "david.brown@example.com", "User", "pending"),
        new("5", "Eve Davis", "eve.davis@example.com", "Admin", "active"),
        new("6", "Frank Miller", "frank.miller@example.com", "User", "inactive"),
        new("7", "Grace Wilson", "grace.wilson@example.com", "Manager", "active"),
        new("8", "Henry Moore", "henry.moore@example.com", "User", "pending"),
    ];

    private SortCol _sortColumn = SortCol.Name;
    private bool _ascending = true;

    private void HandleSort(SortCol column)
    {
        if (_sortColumn == column)
        {
            _ascending = !_ascending;
        }
        else
        {
            _sortColumn = column;
            _ascending = true;
        }
    }

    private User[] GetSortedUsers()
    {
        var sorted = _sortColumn switch
        {
            SortCol.Name => _ascending ? _users.OrderBy(u => u.Name) : _users.OrderByDescending(u => u.Name),
            SortCol.Email => _ascending ? _users.OrderBy(u => u.Email) : _users.OrderByDescending(u => u.Email),
            SortCol.Role => _ascending ? _users.OrderBy(u => u.Role) : _users.OrderByDescending(u => u.Role),
            SortCol.Status => _ascending ? _users.OrderBy(u => u.Status) : _users.OrderByDescending(u => u.Status),
            _ => _users.AsEnumerable(),
        };
        return sorted.ToArray();
    }

    private RenderFragment GetSortIcon(SortCol column)
    {
        if (_sortColumn != column)
            return @<LucideArrowUpDownCn Size="16" Class="ml-2 h-4 w-4 text-muted-foreground" />;
        return _ascending
            ? @<LucideArrowUpCn Size="16" Class="ml-2 h-4 w-4" />
            : @<LucideArrowDownCn Size="16" Class="ml-2 h-4 w-4" />;
    }

    private static (string Label, BadgeVariant Variant, string ClassName) GetStatusConfig(string status) => status switch
    {
        "active" => ("Active", BadgeVariant.Outline, "border-green-200 text-green-700"),
        "inactive" => ("Inactive", BadgeVariant.Secondary, ""),
        "pending" => ("Pending", BadgeVariant.Outline, "border-orange-200 text-orange-700"),
        _ => (status, BadgeVariant.Secondary, ""),
    };
}
