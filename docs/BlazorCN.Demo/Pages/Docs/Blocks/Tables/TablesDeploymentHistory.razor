@* ============================================================
   Block: tables-deployment-history
   Title: TablesDeploymentHistory
   Description: CI/CD deployment history table with status indicators, duration tracking, commit hashes, and environment badges built with shadcn/ui and Tailwind CSS
   Source: original/blocks/tables/tables-deployment-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Deployment History</h3>
                <p class="text-xs text-muted-foreground">
                    @_deployments.Length deployments this week
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                @foreach (var env in _envFilters)
                {
                    var envCapture = env;
                    <ButtonCn
                        Variant="@(_envFilter == envCapture ? ButtonVariant.Default : ButtonVariant.Outline)"
                        Size="ButtonSize.Sm"
                        Class="h-6 px-2 text-xs"
                        @onclick="@(() => _envFilter = envCapture)">
                        @(envCapture == "all" ? "All" : (envCapture[0].ToString().ToUpperInvariant() + envCapture.Substring(1)))
                    </ButtonCn>
                }
            </div>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Deploy ID</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Environment</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Status</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Commit</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Deployer</TableHeadCn>
                    <TableHeadCn Class="text-right text-xs font-medium text-muted-foreground">Duration</TableHeadCn>
                    <TableHeadCn Class="text-right text-xs font-medium text-muted-foreground">Time</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var deploy in _deployments.Where(d => _envFilter == "all" || d.Environment == _envFilter))
                {
                    var statusCfg = GetStatusConfig(deploy.Status);
                    <TableRowCn Class="hover:bg-muted/50">
                        <TableCellCn Class="font-mono text-xs text-muted-foreground">
                            @deploy.Id
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"text-xs font-normal {GetEnvStyle(deploy.Environment)}")">
                                @deploy.Environment
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1.5">
                                <LucideIconCn Name="@statusCfg.IconName" Size="14" Class="@($"size-3.5 {statusCfg.ClassName}{(deploy.Status == "in-progress" ? " animate-spin" : "")}")" />
                                <span class="@($"text-sm {statusCfg.ClassName}")">@statusCfg.Label</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1.5">
                                <LucideIconCn Name="git-commit-horizontal" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="font-mono text-xs">@deploy.Commit</span>
                            </div>
                            <p class="mt-0.5 max-w-48 truncate text-xs text-muted-foreground">
                                @deploy.Message
                            </p>
                        </TableCellCn>
                        <TableCellCn Class="text-sm">@deploy.Deployer</TableCellCn>
                        <TableCellCn Class="text-right">
                            <div class="flex items-center justify-end gap-1">
                                <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="font-mono text-xs text-muted-foreground">@deploy.Duration</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn Class="whitespace-nowrap text-right text-xs text-muted-foreground">
                            @deploy.Timestamp
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record Deployment(string Id, string Environment, string Status, string Branch, string Commit, string Message, string Deployer, string Duration, string Timestamp);

    private record StatusConfig(string Label, string IconName, string ClassName);

    private string _envFilter = "all";

    private static readonly string[] _envFilters = ["all", "production", "staging", "preview"];

    private static readonly Deployment[] _deployments =
    [
        new("deploy-284", "production", "success",     "main",            "a3f8c21", "feat: add user onboarding flow",          "Sarah Chen",   "2m 34s", "Mar 24, 2026 14:32"),
        new("deploy-283", "staging",    "in-progress", "feat/payments",   "e7b4d09", "feat: stripe integration v2",             "Alex Kumar",   "1m 12s", "Mar 24, 2026 14:28"),
        new("deploy-282", "production", "failed",      "main",            "f1c9e82", "fix: resolve memory leak in worker",       "Emma Wilson",  "0m 48s", "Mar 24, 2026 13:15"),
        new("deploy-281", "preview",    "success",     "feat/dark-mode",  "b5a2f77", "feat: dark mode theme support",           "James Park",   "1m 56s", "Mar 24, 2026 12:42"),
        new("deploy-280", "production", "rolled-back", "main",            "d4e1a93", "refactor: database connection pool",       "Maya Patel",   "3m 08s", "Mar 24, 2026 11:20"),
        new("deploy-279", "staging",    "success",     "fix/auth-bug",    "c8f3b16", "fix: session expiry race condition",       "Ryan Lee",     "2m 01s", "Mar 24, 2026 10:55"),
        new("deploy-278", "production", "success",     "main",            "9a2d5e4", "chore: upgrade dependencies",             "Sarah Chen",   "2m 22s", "Mar 24, 2026 09:30"),
    ];

    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        "success"     => new StatusConfig("Success",     "circle-check-big", "text-green-600"),
        "failed"      => new StatusConfig("Failed",      "x-circle",         "text-red-600"),
        "in-progress" => new StatusConfig("Deploying",   "loader-2",         "text-blue-600"),
        "rolled-back" => new StatusConfig("Rolled Back", "rotate-ccw",       "text-amber-600"),
        _             => new StatusConfig(status,        "circle",           "text-muted-foreground"),
    };

    private static string GetEnvStyle(string env) => env switch
    {
        "production" => "bg-red-500/10 text-red-700",
        "staging"    => "bg-amber-500/10 text-amber-700",
        "preview"    => "bg-blue-500/10 text-blue-700",
        _            => "",
    };
}
