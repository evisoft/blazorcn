@* ============================================================
   Block: tables-order-history
   Title: Tables Order History
   Description: Table component with e-commerce order history showing order details, status tracking, items and totals
   Dependencies: BadgeCn, ButtonCn, TableCn
   Source: original/blocks/tables/tables-order-history.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Order History</h3>
                <p class="text-sm text-muted-foreground">
                    @_orders.Length orders &middot; @_totalSpent.ToString("C2") total spent
                </p>
            </div>
            <BadgeCn Class="gap-1" Variant="BadgeVariant.Outline">
                <LucideTruckCn Size="12" Class="h-3 w-3" />
                @_inTransitCount in transit
            </BadgeCn>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-32 font-semibold text-foreground">Order</TableHeadCn>
                        <TableHeadCn Class="w-44 font-semibold text-foreground">Items</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Status</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground text-right">Total</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">Payment</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Tracking</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var order in _orders)
                    {
                        var (statusLabel, statusClass, statusIcon) = GetStatusConfig(order.Status);
                        var isFaded = order.Status is "cancelled" or "refunded";
                        var paymentLabel = GetPaymentLabel(order.PaymentMethod);

                        <TableRowCn Class="@(isFaded ? "opacity-60" : "")">
                            <TableCellCn>
                                <div>
                                    <p class="font-mono text-sm font-medium">@order.OrderNumber</p>
                                    <p class="text-xs text-muted-foreground">@order.Date</p>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <div class="flex -space-x-2">
                                        @foreach (var item in order.Items.Take(2))
                                        {
                                            <div class="flex h-8 w-8 items-center justify-center rounded-full border-2 border-card bg-muted text-[10px]" title="@item.Name (Qty: @item.Quantity)">
                                                <LucideBoxCn Size="12" Class="h-3 w-3" />
                                            </div>
                                        }
                                    </div>
                                    <div class="min-w-0">
                                        <p class="text-sm font-medium truncate">@order.Items[0].Name</p>
                                        @if (order.Items.Length > 1)
                                        {
                                            <p class="text-xs text-muted-foreground">+@(order.Items.Length - 1) more item@(order.Items.Length > 2 ? "s" : "")</p>
                                        }
                                    </div>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@Cn.Merge("gap-1 text-xs", statusClass)" Variant="BadgeVariant.Secondary">
                                    @statusIcon
                                    @statusLabel
                                </BadgeCn>
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <span class="font-mono font-bold">@order.Total.ToString("C2")</span>
                                @if (order.Shipping > 0)
                                {
                                    <p class="text-[10px] text-muted-foreground">+@order.Shipping.ToString("C2") shipping</p>
                                }
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <span class="text-sm" title="@paymentLabel">@GetPaymentIcon(order.PaymentMethod)</span>
                            </TableCellCn>
                            <TableCellCn>
                                @if (order.TrackingNumber != null)
                                {
                                    <ButtonCn Class="h-7 gap-1 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" title="@($"{order.Carrier}: {order.TrackingNumber}")">
                                        <LucideTruckCn Size="12" Class="h-3 w-3" />
                                        Track
                                        <LucideExternalLinkCn Size="12" Class="h-3 w-3" />
                                    </ButtonCn>
                                }
                                else
                                {
                                    <span class="text-xs text-muted-foreground">&mdash;</span>
                                }
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex items-center gap-6 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
                <LucideCircleCheckBigCn Size="14" Class="h-3.5 w-3.5 text-green-600" />
                <span>Delivered</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideTruckCn Size="14" Class="h-3.5 w-3.5 text-purple-600" />
                <span>Shipped</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucidePackageCn Size="14" Class="h-3.5 w-3.5 text-blue-600" />
                <span>Processing</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideCreditCardCn Size="14" Class="h-3.5 w-3.5" />
                <span>Multiple payment methods</span>
            </div>
        </div>
    </div>
</div>

@code {
    private record OrderItem(string Id, string Name, int Quantity, double Price);
    private record Order(string Id, string OrderNumber, string Date, string Status, OrderItem[] Items, double Subtotal, double Shipping, double Total, string PaymentMethod, string? TrackingNumber, string? Carrier);

    private static readonly Order[] _orders =
    [
        new("1", "ORD-2024-1847", "Mar 12, 2024", "delivered",
            [new("i1", "Wireless Headphones Pro", 1, 199.99), new("i2", "USB-C Charging Cable", 2, 14.99)],
            229.97, 0, 229.97, "card", "1Z999AA10123456784", "UPS"),
        new("2", "ORD-2024-1832", "Mar 8, 2024", "shipped",
            [new("i3", "Mechanical Keyboard", 1, 149.99)],
            149.99, 9.99, 159.98, "paypal", "9400111899223033005", "USPS"),
        new("3", "ORD-2024-1798", "Mar 5, 2024", "processing",
            [new("i4", "27\" 4K Monitor", 1, 399.99), new("i5", "Monitor Stand", 1, 79.99), new("i6", "HDMI Cable 2m", 1, 19.99)],
            499.97, 0, 499.97, "apple_pay", null, null),
        new("4", "ORD-2024-1756", "Feb 28, 2024", "delivered",
            [new("i7", "Laptop Backpack", 1, 89.99)],
            89.99, 5.99, 95.98, "card", "794644790132", "FedEx"),
        new("5", "ORD-2024-1701", "Feb 20, 2024", "refunded",
            [new("i8", "Bluetooth Speaker", 1, 79.99)],
            79.99, 4.99, 84.98, "google_pay", null, null),
        new("6", "ORD-2024-1689", "Feb 15, 2024", "cancelled",
            [new("i9", "Webcam HD 1080p", 1, 69.99), new("i10", "Ring Light", 1, 34.99)],
            104.98, 7.99, 112.97, "card", null, null),
    ];

    private static readonly double _totalSpent = _orders.Where(o => o.Status is not "cancelled" and not "refunded").Sum(o => o.Total);
    private static readonly int _inTransitCount = _orders.Count(o => o.Status == "shipped");

    private static (string Label, string ClassName, RenderFragment Icon) GetStatusConfig(string status) => status switch
    {
        "pending" => ("Pending", "bg-yellow-100 text-yellow-700 hover:bg-yellow-100", @<LucideClockCn Size="12" Class="h-3 w-3" />),
        "processing" => ("Processing", "bg-blue-100 text-blue-700 hover:bg-blue-100", @<LucidePackageCn Size="12" Class="h-3 w-3" />),
        "shipped" => ("Shipped", "bg-purple-100 text-purple-700 hover:bg-purple-100", @<LucideTruckCn Size="12" Class="h-3 w-3" />),
        "delivered" => ("Delivered", "bg-green-100 text-green-700 hover:bg-green-100", @<LucideCircleCheckBigCn Size="12" Class="h-3 w-3" />),
        "cancelled" => ("Cancelled", "bg-muted text-muted-foreground hover:bg-muted", @<LucideCircleXCn Size="12" Class="h-3 w-3" />),
        "refunded" => ("Refunded", "bg-orange-100 text-orange-700 hover:bg-orange-100", @<LucideRefreshCwCn Size="12" Class="h-3 w-3" />),
        _ => ("Unknown", "", @<LucideCircleCn Size="12" Class="h-3 w-3" />),
    };

    private static string GetPaymentIcon(string method) => method switch
    {
        "card" => "CC",
        "paypal" => "PP",
        "apple_pay" => "AP",
        "google_pay" => "GP",
        _ => "?",
    };

    private static string GetPaymentLabel(string method) => method switch
    {
        "card" => "Credit Card",
        "paypal" => "PayPal",
        "apple_pay" => "Apple Pay",
        "google_pay" => "Google Pay",
        _ => method,
    };
}
