@* ============================================================
   Block: tables-file-tree
   Title: Tables File Tree
   Description: Table component with expandable file tree structure showing folders and files for file browser interfaces
   Dependencies: ButtonCn, CheckboxCn, TableCn
   Source: original/blocks/tables/tables-file-tree.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Project Files</h3>
                <p class="text-sm text-muted-foreground">
                    @_folderCount folders, @_fileCount files
                    @if (_selectedIds.Count > 0)
                    {
                        @($" - {_selectedIds.Count} selected")
                    }
                </p>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-12"><span class="sr-only">Select</span></TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Name</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground text-right">Size</TableHeadCn>
                        <TableHeadCn Class="w-32 font-semibold text-foreground">Modified</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @{ RenderNodes(_flatNodes); }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex items-center gap-6 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
                <LucideFolderCn Size="14" Class="h-3.5 w-3.5 text-yellow-500" />
                <span>Click chevron to expand</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideFileCodeCn Size="14" Class="h-3.5 w-3.5 text-orange-500" />
                <span>Code files</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideFileImageCn Size="14" Class="h-3.5 w-3.5 text-green-500" />
                <span>Images</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideFileTextCn Size="14" Class="h-3.5 w-3.5 text-blue-500" />
                <span>Documents</span>
            </div>
        </div>
    </div>
</div>

@{
    void RenderNodes(List<FlatNode> nodes)
    {
        foreach (var node in nodes)
        {
            if (!IsVisible(node))
                continue;

            var isExpanded = _expandedIds.Contains(node.Id);
            var isSelected = _selectedIds.Contains(node.Id);
            var paddingLeft = node.Depth * 20;

            <TableRowCn Class="@(isSelected ? "bg-primary/5" : "")">
                <TableCellCn Class="w-8">
                    <CheckboxCn Checked="isSelected" CheckedChanged="() => ToggleSelect(node.Id)" aria-label="@($"Select {node.Name}")" />
                </TableCellCn>
                <TableCellCn>
                    <div class="flex items-center gap-1" style="@($"padding-left: {paddingLeft}px")">
                        @if (node.NodeType == "folder")
                        {
                            <ButtonCn Class="h-6 w-6 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="() => ToggleExpand(node.Id)" aria-label="@($"Expand {node.Name}")">
                                @if (isExpanded)
                                {
                                    <LucideChevronDownCn Size="16" Class="h-4 w-4" />
                                }
                                else
                                {
                                    <LucideChevronRightCn Size="16" Class="h-4 w-4" />
                                }
                            </ButtonCn>
                        }
                        else
                        {
                            <span class="w-6"></span>
                        }
                        @if (node.NodeType == "folder")
                        {
                            if (isExpanded)
                            {
                                <LucideFolderOpenCn Size="16" Class="h-4 w-4 text-yellow-500" />
                            }
                            else
                            {
                                <LucideFolderCn Size="16" Class="h-4 w-4 text-yellow-500" />
                            }
                        }
                        else
                        {
                            @GetFileIcon(node.FileType)
                        }
                        <span class="@Cn.Merge("ml-1.5", node.NodeType == "folder" ? "font-medium" : "")">@node.Name</span>
                    </div>
                </TableCellCn>
                <TableCellCn Class="text-right text-sm text-muted-foreground tabular-nums">@(node.Size ?? "--")</TableCellCn>
                <TableCellCn Class="text-sm text-muted-foreground">@node.Modified</TableCellCn>
            </TableRowCn>
        }
    }
}

@code {
    private record FileNode(string Id, string Name, string NodeType, string? Size, string Modified, string? FileType, FileNode[]? Children);
    private record FlatNode(string Id, string Name, string NodeType, string? Size, string Modified, string? FileType, int Depth, string? ParentId);

    private static readonly FileNode[] _fileTree =
    [
        new("src", "src", "folder", null, "Today", null, [
            new("src/components", "components", "folder", null, "Today", null, [
                new("src/components/Button.tsx", "Button.tsx", "file", "2.4 KB", "2 hours ago", "code", null),
                new("src/components/Card.tsx", "Card.tsx", "file", "1.8 KB", "Yesterday", "code", null),
                new("src/components/Input.tsx", "Input.tsx", "file", "3.1 KB", "3 days ago", "code", null),
            ]),
            new("src/pages", "pages", "folder", null, "Yesterday", null, [
                new("src/pages/index.tsx", "index.tsx", "file", "1.2 KB", "Today", "code", null),
                new("src/pages/about.tsx", "about.tsx", "file", "890 B", "1 week ago", "code", null),
            ]),
            new("src/App.tsx", "App.tsx", "file", "2.1 KB", "Today", "code", null),
            new("src/index.css", "index.css", "file", "4.5 KB", "3 days ago", "code", null),
        ]),
        new("public", "public", "folder", null, "1 week ago", null, [
            new("public/images", "images", "folder", null, "1 week ago", null, [
                new("public/images/logo.png", "logo.png", "file", "24 KB", "1 month ago", "image", null),
                new("public/images/hero.jpg", "hero.jpg", "file", "156 KB", "2 weeks ago", "image", null),
            ]),
            new("public/favicon.ico", "favicon.ico", "file", "4 KB", "2 months ago", "image", null),
        ]),
        new("docs", "docs", "folder", null, "3 days ago", null, [
            new("docs/README.md", "README.md", "file", "3.2 KB", "3 days ago", "document", null),
            new("docs/CHANGELOG.md", "CHANGELOG.md", "file", "8.7 KB", "1 week ago", "document", null),
        ]),
        new("package.json", "package.json", "file", "1.4 KB", "Today", "code", null),
        new("tsconfig.json", "tsconfig.json", "file", "682 B", "1 month ago", "code", null),
        new(".gitignore", ".gitignore", "file", "312 B", "2 months ago", "other", null),
    ];

    private static readonly List<FlatNode> _flatNodes;
    private static readonly int _folderCount;
    private static readonly int _fileCount;

    // Map from folder id to list of direct children ids
    private static readonly Dictionary<string, List<string>> _childrenMap = new();

    static TablesFileTree()
    {
        _flatNodes = new List<FlatNode>();
        Flatten(_fileTree, 0, null);
        _folderCount = _flatNodes.Count(n => n.NodeType == "folder");
        _fileCount = _flatNodes.Count(n => n.NodeType == "file");
    }

    private static void Flatten(FileNode[] nodes, int depth, string? parentId)
    {
        foreach (var node in nodes)
        {
            _flatNodes.Add(new FlatNode(node.Id, node.Name, node.NodeType, node.Size, node.Modified, node.FileType, depth, parentId));
            if (parentId != null)
            {
                if (!_childrenMap.ContainsKey(parentId))
                    _childrenMap[parentId] = new List<string>();
                _childrenMap[parentId].Add(node.Id);
            }
            if (node.Children != null)
            {
                Flatten(node.Children, depth + 1, node.Id);
            }
        }
    }

    private HashSet<string> _expandedIds = new(["src", "src/components"]);
    private HashSet<string> _selectedIds = new();

    private bool IsVisible(FlatNode node)
    {
        if (node.ParentId == null) return true;
        // Walk up the parent chain; all ancestors must be expanded
        var current = node;
        while (current.ParentId != null)
        {
            if (!_expandedIds.Contains(current.ParentId))
                return false;
            current = _flatNodes.First(n => n.Id == current.ParentId);
        }
        return true;
    }

    private void ToggleExpand(string id)
    {
        if (!_expandedIds.Remove(id))
            _expandedIds.Add(id);
    }

    private void ToggleSelect(string id)
    {
        if (!_selectedIds.Remove(id))
            _selectedIds.Add(id);
    }

    private static RenderFragment GetFileIcon(string? fileType) => fileType switch
    {
        "document" => @<LucideFileTextCn Size="16" Class="h-4 w-4 text-blue-500" />,
        "image" => @<LucideFileImageCn Size="16" Class="h-4 w-4 text-green-500" />,
        "code" => @<LucideFileCodeCn Size="16" Class="h-4 w-4 text-orange-500" />,
        _ => @<LucideFileCn Size="16" Class="h-4 w-4 text-muted-foreground" />,
    };
}
