@* ============================================================
   Block: tables-bulk-actions
   Title: Tables Bulk Actions
   Description: Table component with floating bulk action toolbar for multi-row operations
   Dependencies: BadgeCn, ButtonCn, CheckboxCn, TableCn
   Source: original/blocks/tables/tables-bulk-actions.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Contacts</h3>
                <p class="text-sm text-muted-foreground">Select rows to perform bulk actions</p>
            </div>
            <p class="text-sm text-muted-foreground">@_contacts.Length contacts</p>
        </div>

        <div class="relative">
            <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
                <TableCn Class="table-fixed" style="width: 850px">
                    <TableHeaderCn>
                        <TableRowCn>
                            <TableHeadCn Class="w-12">
                                <CheckboxCn Checked="_allSelected" CheckedChanged="ToggleAll" aria-label="Select all" />
                            </TableHeadCn>
                            <TableHeadCn Class="w-40 font-semibold text-foreground">Name</TableHeadCn>
                            <TableHeadCn Class="w-48 font-semibold text-foreground">Email</TableHeadCn>
                            <TableHeadCn Class="w-36 font-semibold text-foreground">Company</TableHeadCn>
                            <TableHeadCn Class="w-24 font-semibold text-foreground">Status</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground">Last Contact</TableHeadCn>
                        </TableRowCn>
                    </TableHeaderCn>
                    <TableBodyCn>
                        @foreach (var contact in _contacts)
                        {
                            var isSelected = _selectedIds.Contains(contact.Id);
                            var (statusLabel, statusVariant) = GetStatusConfig(contact.Status);

                            <TableRowCn Class="@Cn.Merge(isSelected ? "bg-muted/50" : "")">
                                <TableCellCn>
                                    <CheckboxCn Checked="isSelected" CheckedChanged="() => ToggleRow(contact.Id)" aria-label="@($"Select {contact.Name}")" />
                                </TableCellCn>
                                <TableCellCn Class="font-medium">@contact.Name</TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@contact.Email</TableCellCn>
                                <TableCellCn>@contact.Company</TableCellCn>
                                <TableCellCn>
                                    <BadgeCn Variant="@statusVariant">@statusLabel</BadgeCn>
                                </TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@contact.LastContact</TableCellCn>
                            </TableRowCn>
                        }
                    </TableBodyCn>
                </TableCn>
            </div>

            @* Floating bulk action toolbar *@
            <div class="@Cn.Merge("absolute bottom-4 left-1/2 -translate-x-1/2 transition-all duration-200", _selectedIds.Count > 0 ? "translate-y-0 opacity-100" : "translate-y-4 opacity-0 pointer-events-none")">
                <div class="flex items-center gap-2 rounded-lg border bg-card px-4 py-2 shadow-lg">
                    <span class="text-sm font-medium">@_selectedIds.Count selected</span>
                    <ButtonCn Class="h-7 px-2" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="ClearSelection">
                        <LucideXCn Size="16" Class="h-4 w-4" />
                    </ButtonCn>
                    <div class="h-4 w-px bg-border"></div>
                    <ButtonCn Class="h-7" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                        <LucideMailCn Size="16" Class="mr-1 h-4 w-4" />
                        Email
                    </ButtonCn>
                    <ButtonCn Class="h-7" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                        <LucideDownloadCn Size="16" Class="mr-1 h-4 w-4" />
                        Export
                    </ButtonCn>
                    <ButtonCn Class="h-7" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                        <LucideArchiveCn Size="16" Class="mr-1 h-4 w-4" />
                        Archive
                    </ButtonCn>
                    <div class="h-4 w-px bg-border"></div>
                    <ButtonCn Class="h-7 text-destructive hover:text-destructive" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                        <LucideTrash2Cn Size="16" Class="mr-1 h-4 w-4" />
                        Delete
                    </ButtonCn>
                </div>
            </div>
        </div>

        <p class="text-xs text-muted-foreground">
            Use checkbox to select rows. Bulk actions appear when rows are selected.
        </p>
    </div>
</div>

@code {
    private record Contact(string Id, string Name, string Email, string Company, string Status, string LastContact);

    private static readonly Contact[] _contacts =
    [
        new("1", "Emma Thompson", "emma.t@acme.com", "Acme Corp", "active", "2 days ago"),
        new("2", "James Wilson", "j.wilson@globex.io", "Globex Inc", "active", "1 week ago"),
        new("3", "Sofia Garcia", "sofia@initech.com", "Initech", "pending", "3 days ago"),
        new("4", "Marcus Chen", "mchen@umbrella.co", "Umbrella Co", "inactive", "1 month ago"),
        new("5", "Olivia Brown", "o.brown@stark.ind", "Stark Industries", "active", "Yesterday"),
        new("6", "Lucas Miller", "lucas.m@wayne.ent", "Wayne Enterprises", "active", "4 days ago"),
        new("7", "Ava Davis", "ava.d@oscorp.net", "Oscorp", "pending", "2 weeks ago"),
        new("8", "Noah Martinez", "noah@lexcorp.com", "LexCorp", "inactive", "3 weeks ago"),
    ];

    private HashSet<string> _selectedIds = new();
    private bool _allSelected => _selectedIds.Count == _contacts.Length;

    private void ToggleAll()
    {
        if (_selectedIds.Count > 0)
        {
            _selectedIds.Clear();
        }
        else
        {
            _selectedIds = new HashSet<string>(_contacts.Select(c => c.Id));
        }
    }

    private void ToggleRow(string id)
    {
        if (!_selectedIds.Remove(id))
        {
            _selectedIds.Add(id);
        }
    }

    private void ClearSelection() => _selectedIds.Clear();

    private static (string Label, BadgeVariant Variant) GetStatusConfig(string status) => status switch
    {
        "active" => ("Active", BadgeVariant.Default),
        "inactive" => ("Inactive", BadgeVariant.Secondary),
        "pending" => ("Pending", BadgeVariant.Outline),
        _ => ("Unknown", BadgeVariant.Secondary),
    };
}
