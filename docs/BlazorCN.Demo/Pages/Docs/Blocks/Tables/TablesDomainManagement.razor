@* ============================================================
   Block: tables-domain-management
   Title: TablesDomainManagement
   Description: React domain table with DNS status, SSL tracking, and verification for Next.js hosting dashboards built with shadcn/ui and Tailwind CSS
   Source: original/blocks/tables/tables-domain-management.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Domains</h3>
                <p class="text-xs text-muted-foreground">
                    @_activeCount active of @_domains.Length domains@((_sslIssues > 0) ? $" · {_sslIssues} SSL issue{(_sslIssues > 1 ? "s" : "")}" : "")
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="globe" Size="14" Class="size-3.5" />
                Add Domain
            </ButtonCn>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="w-8 text-xs text-muted-foreground"></TableHeadCn>
                    <TableHeadCn Class="text-xs text-muted-foreground">Domain</TableHeadCn>
                    <TableHeadCn Class="text-xs text-muted-foreground">DNS</TableHeadCn>
                    <TableHeadCn Class="text-xs text-muted-foreground">SSL</TableHeadCn>
                    <TableHeadCn Class="text-xs text-muted-foreground">Expiry</TableHeadCn>
                    <TableHeadCn Class="text-xs text-muted-foreground">Verified</TableHeadCn>
                    <TableHeadCn Class="text-right text-xs text-muted-foreground">Added</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var dom in _domains)
                {
                    var domain = dom;
                    var isExpanded = _expanded == domain.Id;
                    <TableRowCn Class="cursor-pointer hover:bg-muted/50" @onclick="@(() => ToggleExpanded(domain.Id))">
                        <TableCellCn Class="w-8 px-2">
                            <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="lock" Size="14" Class="size-3.5 text-muted-foreground/60" />
                                <span class="text-sm font-medium">@domain.Name</span>
                                @if (domain.IsPrimary)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal px-1.5 py-0">Primary</BadgeCn>
                                }
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            @switch (domain.DnsStatus)
                            {
                                case DnsStatusKind.Active:
                                    <div class="flex items-center gap-1.5">
                                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                        <span class="text-xs text-muted-foreground">Active</span>
                                    </div>
                                    break;
                                case DnsStatusKind.Pending:
                                    <div class="flex items-center gap-1.5">
                                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                                        <span class="text-xs text-muted-foreground">Pending</span>
                                    </div>
                                    break;
                                case DnsStatusKind.Error:
                                    <div class="flex items-center gap-1.5">
                                        <span class="size-1.5 rounded-full bg-red-500"></span>
                                        <span class="text-xs text-muted-foreground">Error</span>
                                    </div>
                                    break;
                            }
                        </TableCellCn>
                        <TableCellCn>
                            @switch (domain.SslStatus)
                            {
                                case SslStatusKind.Valid:
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 bg-emerald-500/10 font-normal text-emerald-700 text-xs">
                                        <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                                        Valid
                                    </BadgeCn>
                                    break;
                                case SslStatusKind.Expiring:
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 bg-amber-500/10 font-normal text-amber-700 text-xs">
                                        <LucideIconCn Name="shield-alert" Size="12" Class="size-3" />
                                        Expiring
                                    </BadgeCn>
                                    break;
                                case SslStatusKind.Expired:
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 bg-red-500/10 font-normal text-red-700 text-xs">
                                        <LucideIconCn Name="x-circle" Size="12" Class="size-3" />
                                        Expired
                                    </BadgeCn>
                                    break;
                                case SslStatusKind.None:
                                    <span class="text-xs text-muted-foreground">-</span>
                                    break;
                            }
                        </TableCellCn>
                        <TableCellCn Class="text-xs text-muted-foreground">@domain.SslExpiry</TableCellCn>
                        <TableCellCn>
                            @if (domain.Verified)
                            {
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-600" />
                            }
                            else
                            {
                                <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-muted-foreground/40" />
                            }
                        </TableCellCn>
                        <TableCellCn Class="text-right text-xs text-muted-foreground">@domain.AddedOn</TableCellCn>
                    </TableRowCn>
                    @if (isExpanded)
                    {
                        <TableRowCn>
                            <TableCellCn ColSpan="7" Class="bg-muted/30 px-6 py-3">
                                <div class="flex items-center gap-6 text-xs">
                                    <div>
                                        <span class="text-muted-foreground">Record Type</span>
                                        <p class="mt-0.5 font-mono font-medium">@domain.DnsRecordType</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Target</span>
                                        <p class="mt-0.5 font-mono font-medium">@domain.DnsTarget</p>
                                    </div>
                                    <div class="ml-auto flex items-center gap-2">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                            <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                            Visit
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">
                                            Configure
                                        </ButtonCn>
                                    </div>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private enum DnsStatusKind { Active, Pending, Error }
    private enum SslStatusKind { Valid, Expiring, Expired, None }

    private record DomainItem(
        string Id,
        string Name,
        bool IsPrimary,
        DnsStatusKind DnsStatus,
        string DnsRecordType,
        string DnsTarget,
        SslStatusKind SslStatus,
        string SslExpiry,
        bool Verified,
        string AddedOn
    );

    private string? _expanded = null;

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static readonly DomainItem[] _domains =
    [
        new("dom-001", "app.example.com", true,  DnsStatusKind.Active,   "CNAME", "proxy.hosting.dev", SslStatusKind.Valid,    "Sep 15, 2026", true,  "Jan 10, 2026"),
        new("dom-002", "example.com",     false, DnsStatusKind.Active,   "A",     "76.76.21.21",        SslStatusKind.Valid,    "Sep 15, 2026", true,  "Jan 10, 2026"),
        new("dom-003", "staging.example.com", false, DnsStatusKind.Active, "CNAME", "proxy.hosting.dev", SslStatusKind.Expiring, "Apr 02, 2026", true,  "Feb 03, 2026"),
        new("dom-004", "api.newproject.io",   false, DnsStatusKind.Pending, "CNAME", "proxy.hosting.dev", SslStatusKind.None,    "-",            false, "Mar 22, 2026"),
        new("dom-005", "docs.oldsite.org",    false, DnsStatusKind.Error,   "CNAME", "proxy.hosting.dev", SslStatusKind.Expired, "Feb 28, 2026", true,  "Nov 14, 2025"),
        new("dom-006", "shop.example.com",    false, DnsStatusKind.Active,  "CNAME", "proxy.hosting.dev", SslStatusKind.Valid,   "Dec 01, 2026", true,  "Mar 01, 2026"),
    ];

    private int _activeCount => Array.FindAll(_domains, d => d.DnsStatus == DnsStatusKind.Active).Length;
    private int _sslIssues  => Array.FindAll(_domains, d => d.SslStatus == SslStatusKind.Expiring || d.SslStatus == SslStatusKind.Expired).Length;
}
