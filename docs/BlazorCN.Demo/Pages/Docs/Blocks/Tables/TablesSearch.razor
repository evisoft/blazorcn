@* ============================================================
   Block: tables-search
   Title: Tables Search
   Description: Searchable table component with real-time search input and status filter for employee directories
   Dependencies: BadgeCn, InputCn, TableCn
   Source: original/blocks/tables/tables-search.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center gap-4">
            <div class="relative flex-1">
                <LucideSearchCn Size="16" Class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="pl-9" placeholder="Search by name, email, department, or role..." @bind-Value="_searchQuery" @bind-Value:after="ApplyFilters" />
            </div>
            <div class="flex gap-1">
                @foreach (var filter in _statusFilters)
                {
                    <ButtonCn Size="ButtonSize.Sm"
                              Variant="@(_statusFilter == filter.Value ? ButtonVariant.Default : ButtonVariant.Outline)"
                              OnClick="() => SetStatusFilter(filter.Value)">
                        @filter.Label
                    </ButtonCn>
                }
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="font-semibold text-foreground">Name</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Email</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Department</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Role</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Status</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @if (_filteredEmployees.Length == 0)
                    {
                        <TableRowCn>
                            <TableCellCn Class="h-32 text-center" colspan="5">
                                <div class="flex flex-col items-center justify-center text-muted-foreground">
                                    <LucideSearchCn Size="32" Class="mb-2 h-8 w-8" />
                                    <p class="text-sm">No employees found</p>
                                    <p class="text-xs">Try adjusting your search or filters</p>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                    else
                    {
                        @foreach (var emp in _filteredEmployees)
                        {
                            var (statusLabel, statusVariant, statusClass) = GetStatusConfig(emp.Status);

                            <TableRowCn>
                                <TableCellCn Class="font-medium">@emp.Name</TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@emp.Email</TableCellCn>
                                <TableCellCn>@emp.Department</TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@emp.Role</TableCellCn>
                                <TableCellCn>
                                    <BadgeCn Class="@statusClass" Variant="@statusVariant">@statusLabel</BadgeCn>
                                </TableCellCn>
                            </TableRowCn>
                        }
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-sm text-muted-foreground">
            Showing @_filteredEmployees.Length of @_allEmployees.Length employees
        </p>
    </div>
</div>

@code {
    private record Employee(string Id, string Name, string Email, string Department, string Role, string Status);
    private record StatusFilter(string Label, string Value);

    private static readonly Employee[] _allEmployees =
    [
        new("1", "Alice Johnson", "alice.johnson@company.com", "Engineering", "Senior Developer", "active"),
        new("2", "Bob Smith", "bob.smith@company.com", "Design", "UX Designer", "active"),
        new("3", "Carol Williams", "carol.williams@company.com", "Marketing", "Marketing Manager", "on-leave"),
        new("4", "David Brown", "david.brown@company.com", "Engineering", "DevOps Engineer", "active"),
        new("5", "Eve Davis", "eve.davis@company.com", "Sales", "Sales Representative", "inactive"),
        new("6", "Frank Miller", "frank.miller@company.com", "Engineering", "Junior Developer", "active"),
        new("7", "Grace Wilson", "grace.wilson@company.com", "HR", "HR Manager", "active"),
        new("8", "Henry Moore", "henry.moore@company.com", "Finance", "Accountant", "on-leave"),
        new("9", "Ivy Taylor", "ivy.taylor@company.com", "Design", "UI Designer", "active"),
        new("10", "Jack Anderson", "jack.anderson@company.com", "Engineering", "Tech Lead", "inactive"),
    ];

    private static readonly StatusFilter[] _statusFilters =
    [
        new("All", "all"),
        new("Active", "active"),
        new("Inactive", "inactive"),
        new("On Leave", "on-leave"),
    ];

    private string _searchQuery = "";
    private string _statusFilter = "all";
    private Employee[] _filteredEmployees = _allEmployees;

    private void SetStatusFilter(string filter)
    {
        _statusFilter = filter;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        _filteredEmployees = _allEmployees.Where(e =>
        {
            var matchesStatus = _statusFilter == "all" || e.Status == _statusFilter;
            var matchesSearch = string.IsNullOrEmpty(_searchQuery) ||
                e.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                e.Email.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                e.Department.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                e.Role.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase);
            return matchesStatus && matchesSearch;
        }).ToArray();
    }

    private static (string Label, BadgeVariant Variant, string ClassName) GetStatusConfig(string status) => status switch
    {
        "active" => ("Active", BadgeVariant.Outline, "border-green-200 text-green-700"),
        "inactive" => ("Inactive", BadgeVariant.Secondary, ""),
        "on-leave" => ("On Leave", BadgeVariant.Outline, "border-orange-200 text-orange-700"),
        _ => (status, BadgeVariant.Secondary, ""),
    };
}
