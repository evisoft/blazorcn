@* ============================================================
   Block: tables-resizable
   Title: Tables Resizable
   Description: Table component with static column layout showing file assets with status badges
   Dependencies: BadgeCn, ButtonCn, TableCn
   Source: original/blocks/tables/tables-resizable.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <p class="text-sm text-muted-foreground">
                Asset management table with @_assets.Length files
            </p>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">ID</TableHeadCn>
                        <TableHeadCn Class="w-56 font-semibold text-foreground">File Name</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Type</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground">Size</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Owner</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Modified</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Status</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var asset in _assets)
                    {
                        var (statusLabel, statusVariant, statusClass) = GetStatusConfig(asset.Status);

                        <TableRowCn>
                            <TableCellCn Class="font-mono text-xs">
                                <span class="block truncate">@asset.Id</span>
                            </TableCellCn>
                            <TableCellCn Class="font-medium">
                                <span class="block truncate">@asset.Name</span>
                            </TableCellCn>
                            <TableCellCn Class="text-muted-foreground">
                                <span class="block truncate">@asset.FileType</span>
                            </TableCellCn>
                            <TableCellCn Class="font-mono text-xs text-muted-foreground">
                                <span class="block truncate">@asset.Size</span>
                            </TableCellCn>
                            <TableCellCn Class="text-muted-foreground">
                                <span class="block truncate">@asset.Owner</span>
                            </TableCellCn>
                            <TableCellCn Class="text-muted-foreground">
                                <span class="block truncate">@asset.Modified</span>
                            </TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@statusClass" Variant="@statusVariant">@statusLabel</BadgeCn>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>
    </div>
</div>

@code {
    private record Asset(string Id, string Name, string FileType, string Size, string Owner, string Modified, string Status);

    private static readonly Asset[] _assets =
    [
        new("AST-001", "Q4 Financial Report.pdf", "PDF", "2.4 MB", "Finance Team", "2024-01-15", "active"),
        new("AST-002", "Product Roadmap 2024.xlsx", "Spreadsheet", "856 KB", "Product Team", "2024-01-14", "active"),
        new("AST-003", "Brand Guidelines v3.pdf", "PDF", "15.2 MB", "Design Team", "2024-01-12", "active"),
        new("AST-004", "Customer Survey Results.csv", "CSV", "124 KB", "Marketing", "2024-01-10", "processing"),
        new("AST-005", "Old Marketing Materials.zip", "Archive", "245 MB", "Marketing", "2023-12-20", "archived"),
        new("AST-006", "Employee Handbook.docx", "Document", "1.8 MB", "HR Team", "2024-01-08", "active"),
    ];

    private static (string Label, BadgeVariant Variant, string ClassName) GetStatusConfig(string status) => status switch
    {
        "active" => ("Active", BadgeVariant.Outline, "border-green-200 text-green-700"),
        "processing" => ("Processing", BadgeVariant.Outline, "border-blue-200 text-blue-700"),
        "archived" => ("Archived", BadgeVariant.Secondary, ""),
        _ => (status, BadgeVariant.Secondary, ""),
    };
}
