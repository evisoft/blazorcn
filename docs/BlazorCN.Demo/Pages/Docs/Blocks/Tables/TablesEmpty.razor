@* ============================================================
   Block: tables-empty
   Title: Tables Empty
   Description: Table component with contextual empty states and call-to-action buttons for zero-data scenarios
   Dependencies: ButtonCn, InputCn, TableCn
   Source: original/blocks/tables/tables-empty.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between gap-4">
            <div class="relative flex-1">
                <LucideSearchCn Size="16" Class="absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="pl-9" placeholder="Search contacts..." @bind-Value="_searchQuery" @bind-Value:after="ApplyFilter" />
            </div>
            <div class="flex gap-2">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="ClearAll">
                    Clear All (Demo)
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="ResetDemo">
                    Reset Demo
                </ButtonCn>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="font-semibold text-foreground">Name</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Email</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Company</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Phone</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Last Contact</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @if (_filteredContacts.Length == 0)
                    {
                        <TableRowCn>
                            <TableCellCn colspan="5">
                                <div class="flex flex-col items-center justify-center py-16 text-center">
                                    <div class="rounded-full bg-muted p-4">
                                        @if (_showEmpty)
                                        {
                                            <LucideInboxCn Size="32" Class="h-8 w-8 text-muted-foreground" />
                                        }
                                        else
                                        {
                                            <LucideSearchCn Size="32" Class="h-8 w-8 text-muted-foreground" />
                                        }
                                    </div>
                                    <h3 class="mt-4 text-lg font-medium">
                                        @if (_showEmpty)
                                        {
                                            @:No contacts yet
                                        }
                                        else
                                        {
                                            @:No results for "@_searchQuery"
                                        }
                                    </h3>
                                    <p class="mt-1 max-w-sm text-sm text-muted-foreground">
                                        @if (_showEmpty)
                                        {
                                            @:Get started by adding your first contact to the list.
                                        }
                                        else
                                        {
                                            @:We couldn't find any contacts matching your search. Try different keywords.
                                        }
                                    </p>
                                    <div class="mt-6 flex gap-3">
                                        @if (_showEmpty)
                                        {
                                            <ButtonCn>
                                                <LucidePlusCn Size="16" Class="mr-2 h-4 w-4" />
                                                Add Contact
                                            </ButtonCn>
                                        }
                                        else
                                        {
                                            <ButtonCn Variant="ButtonVariant.Outline" OnClick="ClearSearch">
                                                <LucideXCn Size="16" Class="mr-2 h-4 w-4" />
                                                Clear Search
                                            </ButtonCn>
                                            <ButtonCn>
                                                <LucidePlusCn Size="16" Class="mr-2 h-4 w-4" />
                                                Add Contact
                                            </ButtonCn>
                                        }
                                    </div>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                    else
                    {
                        @foreach (var contact in _filteredContacts)
                        {
                            <TableRowCn>
                                <TableCellCn Class="font-medium">@contact.Name</TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@contact.Email</TableCellCn>
                                <TableCellCn>@contact.Company</TableCellCn>
                                <TableCellCn Class="font-mono text-sm text-muted-foreground">@contact.Phone</TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@contact.LastContact</TableCellCn>
                            </TableRowCn>
                        }
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        @if (_filteredContacts.Length > 0)
        {
            <p class="text-sm text-muted-foreground">
                Showing @_filteredContacts.Length of @_contacts.Length contacts
            </p>
        }
    </div>
</div>

@code {
    private record Contact(string Id, string Name, string Email, string Company, string Phone, string LastContact);

    private static readonly Contact[] _allContacts =
    [
        new("1", "Sarah Mitchell", "sarah.m@techcorp.com", "TechCorp", "+1-555-0101", "2024-01-15"),
        new("2", "James Wilson", "j.wilson@innovate.io", "Innovate.io", "+1-555-0102", "2024-01-12"),
        new("3", "Emily Chen", "emily.chen@startup.co", "StartUp Co", "+1-555-0103", "2024-01-10"),
        new("4", "Michael Brown", "m.brown@enterprise.com", "Enterprise Inc", "+1-555-0104", "2024-01-08"),
    ];

    private string _searchQuery = "";
    private bool _showEmpty;
    private Contact[] _contacts = _allContacts;
    private Contact[] _filteredContacts = _allContacts;

    private void ApplyFilter()
    {
        if (_showEmpty)
        {
            _filteredContacts = [];
            return;
        }

        _filteredContacts = string.IsNullOrEmpty(_searchQuery)
            ? _contacts
            : _contacts.Where(c =>
                c.Name.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                c.Email.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase) ||
                c.Company.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)
            ).ToArray();
    }

    private void ClearSearch()
    {
        _searchQuery = "";
        ApplyFilter();
    }

    private void ClearAll()
    {
        _contacts = [];
        _showEmpty = true;
        ApplyFilter();
    }

    private void ResetDemo()
    {
        _contacts = _allContacts;
        _searchQuery = "";
        _showEmpty = false;
        ApplyFilter();
    }
}
