@* ============================================================
   Block: tables-checkbox-toggle
   Title: Tables Checkbox Toggle
   Description: Table component with inline checkbox and toggle controls for settings and permissions dashboards
   Dependencies: BadgeCn, CheckboxCn, SwitchCn, TableCn
   Source: original/blocks/tables/tables-checkbox-toggle.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Role Permissions</h3>
                <p class="text-sm text-muted-foreground">
                    Configure access permissions for this role
                </p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary">
                @_enabledCount of @_permissions.Count resources configured
            </BadgeCn>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-48 font-semibold text-foreground">Resource</TableHeadCn>
                        <TableHeadCn Class="w-48 font-semibold text-foreground">Description</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">View</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">Edit</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">Delete</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">Share</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground text-center">Enabled</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var perm in _permissions)
                    {
                        var hasAny = perm.CanView || perm.CanEdit || perm.CanDelete || perm.CanShare;
                        <TableRowCn Class="@Cn.Merge(perm.IsLocked ? "bg-muted/30" : "", !hasAny ? "opacity-60" : "")">
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    @GetIcon(perm.IconName)
                                    <span class="font-medium">@perm.Name</span>
                                    @if (perm.IsLocked)
                                    {
                                        <LucideLockCn Size="12" Class="h-3 w-3 text-muted-foreground" />
                                    }
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-sm text-muted-foreground">
                                @perm.Description
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <CheckboxCn Checked="@perm.CanView"
                                            CheckedChanged="@(v => TogglePermission(perm.Id, "CanView", v))"
                                            Disabled="@perm.IsLocked"
                                            Class="@(perm.IsLocked ? "opacity-50 cursor-not-allowed" : "")" />
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <CheckboxCn Checked="@perm.CanEdit"
                                            CheckedChanged="@(v => TogglePermission(perm.Id, "CanEdit", v))"
                                            Disabled="@perm.IsLocked"
                                            Class="@(perm.IsLocked ? "opacity-50 cursor-not-allowed" : "")" />
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <CheckboxCn Checked="@perm.CanDelete"
                                            CheckedChanged="@(v => TogglePermission(perm.Id, "CanDelete", v))"
                                            Disabled="@perm.IsLocked"
                                            Class="@(perm.IsLocked ? "opacity-50 cursor-not-allowed" : "")" />
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <CheckboxCn Checked="@perm.CanShare"
                                            CheckedChanged="@(v => TogglePermission(perm.Id, "CanShare", v))"
                                            Disabled="@perm.IsLocked"
                                            Class="@(perm.IsLocked ? "opacity-50 cursor-not-allowed" : "")" />
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <SwitchCn Checked="@hasAny"
                                          CheckedChanged="@(v => ToggleAll(perm.Id, v))"
                                          Disabled="@perm.IsLocked"
                                          Class="@(perm.IsLocked ? "opacity-50 cursor-not-allowed" : "")" />
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex items-center gap-4 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
                <LucideLockCn Size="12" Class="h-3 w-3" />
                <span>Locked items require elevated permissions</span>
            </div>
        </div>
    </div>
</div>

@code {
    private class PermissionItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string IconName { get; set; } = "";
        public bool CanView { get; set; }
        public bool CanEdit { get; set; }
        public bool CanDelete { get; set; }
        public bool CanShare { get; set; }
        public bool IsLocked { get; set; }
        public string? LockReason { get; set; }
    }

    private List<PermissionItem> _permissions = new()
    {
        new() { Id = "1", Name = "User Profiles", Description = "Access to user profile data", IconName = "Eye", CanView = true, CanEdit = true, CanDelete = false, CanShare = true, IsLocked = false },
        new() { Id = "2", Name = "Financial Reports", Description = "Revenue and expense reports", IconName = "Download", CanView = true, CanEdit = false, CanDelete = false, CanShare = false, IsLocked = true, LockReason = "Requires admin approval" },
        new() { Id = "3", Name = "Team Settings", Description = "Team configuration options", IconName = "Shield", CanView = true, CanEdit = true, CanDelete = true, CanShare = true, IsLocked = false },
        new() { Id = "4", Name = "Notifications", Description = "Email and push notifications", IconName = "Bell", CanView = true, CanEdit = true, CanDelete = false, CanShare = false, IsLocked = false },
        new() { Id = "5", Name = "API Access", Description = "API keys and webhooks", IconName = "Lock", CanView = true, CanEdit = false, CanDelete = false, CanShare = false, IsLocked = true, LockReason = "Enterprise plan required" },
        new() { Id = "6", Name = "Audit Logs", Description = "Activity and security logs", IconName = "Eye", CanView = true, CanEdit = false, CanDelete = false, CanShare = true, IsLocked = false },
        new() { Id = "7", Name = "Integrations", Description = "Third-party app connections", IconName = "Share2", CanView = true, CanEdit = true, CanDelete = true, CanShare = false, IsLocked = false },
        new() { Id = "8", Name = "Billing Info", Description = "Payment and subscription data", IconName = "Mail", CanView = false, CanEdit = false, CanDelete = false, CanShare = false, IsLocked = true, LockReason = "Owner access only" },
    };

    private int _enabledCount => _permissions.Count(p => p.CanView || p.CanEdit || p.CanDelete || p.CanShare);

    private RenderFragment GetIcon(string name) => name switch
    {
        "Eye" => @<LucideEyeCn Size="16" Class="h-4 w-4 text-muted-foreground" />,
        "Download" => @<LucideDownloadCn Size="16" Class="h-4 w-4 text-muted-foreground" />,
        "Shield" => @<LucideShieldCn Size="16" Class="h-4 w-4 text-muted-foreground" />,
        "Bell" => @<LucideBellCn Size="16" Class="h-4 w-4 text-muted-foreground" />,
        "Lock" => @<LucideLockCn Size="16" Class="h-4 w-4 text-muted-foreground" />,
        "Share2" => @<LucideShare2Cn Size="16" Class="h-4 w-4 text-muted-foreground" />,
        "Mail" => @<LucideMailCn Size="16" Class="h-4 w-4 text-muted-foreground" />,
        _ => @<LucideEyeCn Size="16" Class="h-4 w-4 text-muted-foreground" />,
    };

    private void TogglePermission(string id, string key, bool value)
    {
        var perm = _permissions.FirstOrDefault(p => p.Id == id);
        if (perm == null || perm.IsLocked) return;
        switch (key)
        {
            case "CanView": perm.CanView = value; break;
            case "CanEdit": perm.CanEdit = value; break;
            case "CanDelete": perm.CanDelete = value; break;
            case "CanShare": perm.CanShare = value; break;
        }
    }

    private void ToggleAll(string id, bool value)
    {
        var perm = _permissions.FirstOrDefault(p => p.Id == id);
        if (perm == null || perm.IsLocked) return;
        perm.CanView = value;
        perm.CanEdit = false;
        perm.CanDelete = false;
        perm.CanShare = false;
    }
}
