@* ============================================================
   Block: tables-payment-transactions
   Title: TablesPaymentTransactions
   Description: Payment transaction table with amount formatting, payment method icons, status badges, and expandable row details for billing dashboards
   Source: original/blocks/tables/tables-payment-transactions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Transactions</h3>
                <p class="text-xs text-muted-foreground">
                    @_transactions.Length transactions · @FormatAmount(_totalRevenue, "USD") revenue
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                @foreach (var s in _filterOptions)
                {
                    var filter = s;
                    <ButtonCn
                        Variant="@(_statusFilter == filter ? ButtonVariant.Default : ButtonVariant.Outline)"
                        Size="ButtonSize.Sm"
                        Class="h-6 px-2 text-xs"
                        @onclick="@(() => _statusFilter = filter)">
                        @Capitalize(filter)
                    </ButtonCn>
                }
            </div>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="w-8 text-xs font-medium text-muted-foreground"><span class="sr-only">Expand</span></TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Customer</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Description</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Method</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Status</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground text-right">Amount</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground text-right">Date</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var txn in Filtered())
                {
                    var t = txn;
                    var isExpanded = _expanded == t.Id;
                    <TableRowCn Class="cursor-pointer hover:bg-muted/50" @onclick="@(() => _expanded = (isExpanded ? null : t.Id))">
                        <TableCellCn Class="w-8 px-2">
                            <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </TableCellCn>
                        <TableCellCn>
                            <div>
                                <span class="text-sm font-medium">@t.Customer</span>
                                <p class="text-xs text-muted-foreground">@t.Email</p>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="text-xs text-muted-foreground">@t.Description</span>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1.5">
                                <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground/60" />
                                <span class="text-xs text-muted-foreground font-mono">@GetMethodLabel(t.Method, t.CardLast4)</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            @{ var statusInfo = GetStatusInfo(t.Status); }
                            <div class="flex items-center gap-1.5">
                                <span class="@statusInfo.DotClass"></span>
                                <span class="text-xs text-muted-foreground">@statusInfo.Label</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn Class="text-right">
                            <span class="@Cn.Merge("text-sm font-medium tabular-nums", t.Status == "refunded" ? "text-muted-foreground line-through" : "")">
                                @FormatAmount(t.Amount, t.Currency)
                            </span>
                        </TableCellCn>
                        <TableCellCn Class="text-right text-xs text-muted-foreground whitespace-nowrap">
                            @t.ProcessedAt
                        </TableCellCn>
                    </TableRowCn>
                    @if (isExpanded)
                    {
                        <TableRowCn>
                            <TableCellCn ColSpan="7" Class="bg-muted/30 px-6 py-3">
                                <div class="flex items-center gap-6 text-xs">
                                    <div>
                                        <span class="text-muted-foreground">Transaction ID</span>
                                        <p class="mt-0.5 font-mono font-medium">@t.Id</p>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Invoice</span>
                                        <p class="mt-0.5 font-mono font-medium">@t.InvoiceId</p>
                                    </div>
                                    <div class="ml-auto flex items-center gap-2">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                            <LucideIconCn Name="receipt" Size="12" Class="size-3" />
                                            Invoice
                                        </ButtonCn>
                                        @if (t.Status == "completed")
                                        {
                                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                                <LucideIconCn Name="dollar-sign" Size="12" Class="size-3" />
                                                Refund
                                            </ButtonCn>
                                        }
                                    </div>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record Transaction(string Id, string InvoiceId, string Customer, string Email, decimal Amount, string Currency, string Method, string? CardLast4, string Status, string Description, string ProcessedAt);

    private record StatusInfo(string DotClass, string Label);

    private string _statusFilter = "all";
    private string? _expanded = null;

    private static readonly string[] _filterOptions = ["all", "completed", "pending", "refunded", "failed"];

    private static readonly Transaction[] _transactions =
    [
        new("txn-001", "INV-2026-0342", "Acme Corp",       "billing@acmecorp.com",      299.0m, "USD", "visa",          "4242", "completed", "Pro Plan - Monthly",        "Mar 24, 2026 14:32"),
        new("txn-002", "INV-2026-0341", "TechStart Inc",   "pay@techstart.io",           79.0m, "USD", "mastercard",    "8910", "completed", "Team Plan - Monthly",       "Mar 24, 2026 13:15"),
        new("txn-003", "INV-2026-0340", "Design Studio",   "accounts@designstudio.co",  599.0m, "USD", "paypal",        null,   "pending",   "Enterprise - Yearly",       "Mar 24, 2026 12:48"),
        new("txn-004", "INV-2026-0339", "Sarah Chen",      "sarah@freelance.dev",        39.0m, "USD", "visa",          "1234", "refunded",  "Individual - Monthly",      "Mar 24, 2026 11:30"),
        new("txn-005", "INV-2026-0338", "Global Retail Ltd","finance@globalretail.com",  949.0m, "USD", "bank_transfer", null,   "completed", "Organization - Yearly",     "Mar 24, 2026 10:22"),
        new("txn-006", "INV-2026-0337", "DevOps Agency",   "billing@devopsagency.io",   159.0m, "USD", "amex",          "3782", "failed",    "Organization - Monthly",    "Mar 24, 2026 09:45"),
        new("txn-007", "INV-2026-0336", "Marcus Johnson",  "marcus@indie.dev",          229.0m, "USD", "visa",          "5678", "completed", "Individual - Yearly",       "Mar 23, 2026 16:10"),
        new("txn-008", "INV-2026-0335", "CloudNine SaaS",  "ap@cloudnine.app",          469.0m, "USD", "mastercard",    "6543", "disputed",  "Team - Yearly",             "Mar 23, 2026 14:55"),
    ];

    private decimal _totalRevenue => _transactions
        .Where(t => t.Status == "completed")
        .Sum(t => t.Amount);

    private IEnumerable<Transaction> Filtered() =>
        _statusFilter == "all" ? _transactions : _transactions.Where(t => t.Status == _statusFilter);

    private static string GetMethodLabel(string method, string? last4) => method switch
    {
        "visa"          => $"Visa •••• {last4}",
        "mastercard"    => $"MC •••• {last4}",
        "amex"          => $"Amex •••• {last4}",
        "paypal"        => "PayPal",
        "bank_transfer" => "Bank Transfer",
        _               => method,
    };

    private static StatusInfo GetStatusInfo(string status) => status switch
    {
        "completed" => new("size-1.5 rounded-full bg-emerald-500",  "Completed"),
        "pending"   => new("size-1.5 animate-pulse rounded-full bg-amber-500", "Pending"),
        "refunded"  => new("size-1.5 rounded-full bg-blue-500",     "Refunded"),
        "failed"    => new("size-1.5 rounded-full bg-red-500",      "Failed"),
        "disputed"  => new("size-1.5 rounded-full bg-purple-500",   "Disputed"),
        _           => new("size-1.5 rounded-full bg-muted",        status),
    };

    private static string FormatAmount(decimal amount, string currency) =>
        currency == "USD" ? $"${amount:F2}" : $"{amount:F2} {currency}";

    private static string Capitalize(string s) =>
        s.Length == 0 ? s : char.ToUpperInvariant(s[0]) + s[1..];
}
