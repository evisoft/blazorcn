@* ============================================================
   Block: tables-status-history
   Title: Tables Status History
   Description: Table component with status progression timeline showing state changes for workflow tracking
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-status-history.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold">Order Tracking</h3>
            <p class="text-sm text-muted-foreground">@_orders.Length orders</p>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Order ID</TableHeadCn>
                        <TableHeadCn Class="w-32 font-semibold text-foreground">Customer</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Product</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground text-right">Amount</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Status</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Progression</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var order in _orders)
                    {
                        var (statusLabel, statusVariant, statusClass) = GetCurrentStatusBadge(order.CurrentStatus);
                        var isCancelled = order.CurrentStatus == "cancelled";
                        var completedStatuses = new HashSet<string>(order.StatusHistory.Select(h => h.Status));

                        <TableRowCn>
                            <TableCellCn Class="font-mono text-sm">@order.Id</TableCellCn>
                            <TableCellCn Class="font-medium">@order.Customer</TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@order.Product</TableCellCn>
                            <TableCellCn Class="text-right font-mono font-semibold">$@order.Amount</TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@statusClass" Variant="@statusVariant">@statusLabel</BadgeCn>
                            </TableCellCn>
                            <TableCellCn>
                                @if (isCancelled)
                                {
                                    <div class="flex items-center gap-2">
                                        <BadgeCn Variant="BadgeVariant.Destructive">Cancelled</BadgeCn>
                                        <span class="text-xs text-muted-foreground">@order.StatusHistory.Last().Timestamp</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center gap-1">
                                        @for (var si = 0; si < _statusOrder.Length; si++)
                                        {
                                            var status = _statusOrder[si];
                                            var isCompleted = completedStatuses.Contains(status);
                                            var isCurrent = status == order.CurrentStatus;
                                            var dotColor = GetDotColor(status);
                                            var historyEntry = order.StatusHistory.FirstOrDefault(h => h.Status == status);

                                            <div class="flex items-center">
                                                <div class="group relative flex flex-col items-center">
                                                    <div class="@Cn.Merge("h-3 w-3 rounded-full transition-all", isCompleted ? dotColor : "bg-muted", isCurrent ? "ring-2 ring-offset-2 ring-primary" : "")"></div>
                                                    <div class="absolute bottom-full mb-2 hidden group-hover:block z-10">
                                                        <div class="rounded bg-popover px-2 py-1 text-xs shadow-md border whitespace-nowrap">
                                                            <div class="font-medium">@GetStatusLabel(status)</div>
                                                            @if (historyEntry != null)
                                                            {
                                                                <div class="text-muted-foreground">@historyEntry.Timestamp</div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                @if (si < _statusOrder.Length - 1)
                                                {
                                                    var nextCompleted = completedStatuses.Contains(_statusOrder[si + 1]);
                                                    <div class="@Cn.Merge("h-0.5 w-6", nextCompleted ? "bg-gray-300" : "bg-muted")"></div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Hover over status dots to see transition timestamps
        </p>
    </div>
</div>

@code {
    private record StatusEntry(string Status, string Timestamp);
    private record Order(string Id, string Customer, string Product, int Amount, string CurrentStatus, StatusEntry[] StatusHistory);

    private static readonly string[] _statusOrder = ["placed", "confirmed", "processing", "shipped", "delivered"];

    private static readonly Order[] _orders =
    [
        new("ORD-7291", "Emma Wilson", "MacBook Pro 14\"", 1999, "delivered",
            [new("placed","Jan 10, 9:00 AM"), new("confirmed","Jan 10, 9:15 AM"), new("processing","Jan 10, 2:00 PM"), new("shipped","Jan 11, 10:30 AM"), new("delivered","Jan 13, 3:45 PM")]),
        new("ORD-7292", "James Chen", "iPhone 15 Pro", 1199, "shipped",
            [new("placed","Jan 12, 11:00 AM"), new("confirmed","Jan 12, 11:05 AM"), new("processing","Jan 12, 3:00 PM"), new("shipped","Jan 13, 9:00 AM")]),
        new("ORD-7293", "Sarah Miller", "AirPods Pro", 249, "processing",
            [new("placed","Jan 14, 2:30 PM"), new("confirmed","Jan 14, 2:35 PM"), new("processing","Jan 14, 5:00 PM")]),
        new("ORD-7294", "Michael Brown", "iPad Air", 799, "confirmed",
            [new("placed","Jan 15, 10:00 AM"), new("confirmed","Jan 15, 10:10 AM")]),
        new("ORD-7295", "Lisa Taylor", "Apple Watch Ultra", 899, "cancelled",
            [new("placed","Jan 14, 8:00 AM"), new("confirmed","Jan 14, 8:05 AM"), new("cancelled","Jan 14, 9:30 AM")]),
        new("ORD-7296", "David Kim", "Magic Keyboard", 299, "placed",
            [new("placed","Jan 15, 11:45 AM")]),
    ];

    private static (string Label, BadgeVariant Variant, string ClassName) GetCurrentStatusBadge(string status) => status switch
    {
        "placed" => ("Placed", BadgeVariant.Secondary, ""),
        "confirmed" => ("Confirmed", BadgeVariant.Outline, "border-blue-200 text-blue-700"),
        "processing" => ("Processing", BadgeVariant.Outline, "border-yellow-200 text-yellow-700"),
        "shipped" => ("Shipped", BadgeVariant.Outline, "border-purple-200 text-purple-700"),
        "delivered" => ("Delivered", BadgeVariant.Outline, "border-green-200 text-green-700"),
        "cancelled" => ("Cancelled", BadgeVariant.Destructive, ""),
        _ => (status, BadgeVariant.Secondary, ""),
    };

    private static string GetDotColor(string status) => status switch
    {
        "placed" => "bg-gray-400",
        "confirmed" => "bg-blue-500",
        "processing" => "bg-yellow-500",
        "shipped" => "bg-purple-500",
        "delivered" => "bg-green-500",
        _ => "bg-muted",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "placed" => "Placed",
        "confirmed" => "Confirmed",
        "processing" => "Processing",
        "shipped" => "Shipped",
        "delivered" => "Delivered",
        _ => status,
    };
}
