@* ============================================================
   Block: tables-course-curriculum
   Title: Tables Course Curriculum
   Description: Table component with course curriculum showing modules, lessons, duration and completion progress for e-learning platforms
   Dependencies: BadgeCn, ButtonCn, TableCn
   Source: original/blocks/tables/tables-course-curriculum.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Course Curriculum</h3>
                <p class="text-sm text-muted-foreground">
                    @_curriculum.Length modules &middot; @_totalLessons lessons
                </p>
            </div>
            <div class="flex items-center gap-4">
                <div class="text-right">
                    <p class="text-sm font-medium">@((int)Math.Round(_overallProgress))% complete</p>
                    <p class="text-xs text-muted-foreground">
                        @_completedLessons of @_totalLessons lessons
                    </p>
                </div>
                <div class="w-32">
                    <div class="h-2 w-full rounded-full bg-muted">
                        <div class="h-full rounded-full bg-primary" style="@($"width: {_overallProgress:F0}%")"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-96 font-semibold text-foreground">Lesson</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Type</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Duration</TableHeadCn>
                        <TableHeadCn Class="w-24"></TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var mod in _curriculum)
                    {
                        var isExpanded = _expandedModules.Contains(mod.Id);
                        var completedCount = mod.Lessons.Count(l => l.Status == "completed");
                        var totalCount = mod.Lessons.Length;
                        var progress = totalCount > 0 ? (completedCount / (double)totalCount) * 100 : 0;
                        var isComplete = completedCount == totalCount;

                        <TableRowCn Class="bg-muted/30 hover:bg-muted/50">
                            <TableCellCn colspan="4">
                                <button type="button"
                                        Class="flex items-center gap-3 w-full text-left"
                                        @onclick="@(() => ToggleModule(mod.Id))">
                                    @if (isExpanded)
                                    {
                                        <LucideChevronDownCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                                    }
                                    else
                                    {
                                        <LucideChevronRightCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                                    }
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-center gap-2">
                                            <span class="font-semibold">@mod.Title</span>
                                            @if (isComplete)
                                            {
                                                <BadgeCn Class="text-[10px] px-1.5 py-0 bg-green-100 text-green-700 hover:bg-green-100" Variant="BadgeVariant.Secondary">Complete</BadgeCn>
                                            }
                                        </div>
                                        <p class="text-xs text-muted-foreground">@mod.Description</p>
                                    </div>
                                    <div class="flex items-center gap-4">
                                        <div class="text-right">
                                            <p class="text-sm font-medium">@completedCount/@totalCount lessons</p>
                                            <p class="text-xs text-muted-foreground">~@GetModuleDuration(mod) min</p>
                                        </div>
                                        <div class="w-24">
                                            <div class="h-2 w-full rounded-full bg-muted">
                                                <div class="h-full rounded-full bg-primary" style="@($"width: {progress:F0}%")"></div>
                                            </div>
                                        </div>
                                    </div>
                                </button>
                            </TableCellCn>
                        </TableRowCn>

                        @if (isExpanded)
                        {
                            @foreach (var lesson in mod.Lessons)
                            {
                                var isLocked = lesson.Status == "locked";
                                var isInProgress = lesson.Status == "in_progress";
                                <TableRowCn Class="@Cn.Merge(isLocked ? "opacity-50" : "", isInProgress ? "bg-primary/5" : "")">
                                    <TableCellCn Class="pl-12">
                                        <div class="flex items-center gap-3">
                                            @GetStatusIcon(lesson.Status)
                                            <span class="@Cn.Merge("text-sm", lesson.Status == "completed" ? "text-muted-foreground" : "", isInProgress ? "font-medium" : "")">
                                                @lesson.Title
                                            </span>
                                            @if (isInProgress)
                                            {
                                                <BadgeCn Class="text-[10px] px-1.5 py-0" Variant="BadgeVariant.Secondary">Continue</BadgeCn>
                                            }
                                        </div>
                                    </TableCellCn>
                                    <TableCellCn>
                                        <div class="flex items-center gap-1.5 text-sm text-muted-foreground">
                                            @GetTypeIcon(lesson.Type)
                                            <span>@GetTypeLabel(lesson.Type)</span>
                                        </div>
                                    </TableCellCn>
                                    <TableCellCn>
                                        <div class="flex items-center gap-1.5 text-sm text-muted-foreground">
                                            <LucideClockCn Size="14" Class="h-3.5 w-3.5" />
                                            <span>@lesson.Duration</span>
                                        </div>
                                    </TableCellCn>
                                    <TableCellCn>
                                        @if (!isLocked)
                                        {
                                            <ButtonCn Class="h-7 text-xs gap-1" Size="ButtonSize.Sm"
                                                      Variant="@(isInProgress ? ButtonVariant.Default : ButtonVariant.Ghost)">
                                                <LucidePlayCn Size="12" Class="h-3 w-3" />
                                                @(isInProgress ? "Continue" : lesson.Status == "completed" ? "Review" : "Start")
                                            </ButtonCn>
                                        }
                                    </TableCellCn>
                                </TableRowCn>
                            }
                        }
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex items-center gap-6 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
                <LucideCheckCircle2Cn Size="14" Class="h-3.5 w-3.5 text-green-600" />
                <span>Completed</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucidePlayCircleCn Size="14" Class="h-3.5 w-3.5 text-primary" />
                <span>In Progress</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideCircleCn Size="14" Class="h-3.5 w-3.5 text-muted-foreground/30" />
                <span>Available</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideLockCn Size="14" Class="h-3.5 w-3.5 text-muted-foreground/50" />
                <span>Locked</span>
            </div>
        </div>
    </div>
</div>

@code {
    private record Lesson(string Id, string Title, string Type, string Duration, string Status);
    private record Module(string Id, string Title, string Description, Lesson[] Lessons);

    private readonly HashSet<string> _expandedModules = ["m1", "m2"];

    private static readonly Module[] _curriculum =
    [
        new("m1", "Getting Started", "Introduction and setup",
        [
            new("l1", "Welcome to the Course", "video", "5:30", "completed"),
            new("l2", "Course Overview & Goals", "reading", "8 min", "completed"),
            new("l3", "Setting Up Your Environment", "video", "12:45", "completed"),
            new("l4", "Knowledge Check", "quiz", "10 min", "completed"),
        ]),
        new("m2", "Core Fundamentals", "Essential concepts and patterns",
        [
            new("l5", "Understanding the Basics", "video", "18:20", "completed"),
            new("l6", "Deep Dive: Key Concepts", "reading", "15 min", "completed"),
            new("l7", "Hands-on Practice", "exercise", "25 min", "in_progress"),
            new("l8", "Common Patterns", "video", "22:10", "available"),
            new("l9", "Module Assessment", "quiz", "15 min", "available"),
        ]),
        new("m3", "Advanced Techniques", "Taking it to the next level",
        [
            new("l10", "Advanced Patterns", "video", "28:45", "locked"),
            new("l11", "Performance Optimization", "video", "24:30", "locked"),
            new("l12", "Real-world Case Study", "reading", "20 min", "locked"),
            new("l13", "Coding Challenge", "exercise", "45 min", "locked"),
            new("l14", "Final Assessment", "quiz", "30 min", "locked"),
        ]),
        new("m4", "Project & Certification", "Apply your knowledge",
        [
            new("l15", "Project Requirements", "reading", "10 min", "locked"),
            new("l16", "Building Your Project", "exercise", "2 hrs", "locked"),
            new("l17", "Final Exam", "quiz", "1 hr", "locked"),
            new("l18", "Course Completion", "video", "3:00", "locked"),
        ]),
    ];

    private static readonly int _totalLessons = _curriculum.SelectMany(m => m.Lessons).Count();
    private static readonly int _completedLessons = _curriculum.SelectMany(m => m.Lessons).Count(l => l.Status == "completed");
    private static readonly double _overallProgress = _totalLessons > 0 ? (_completedLessons / (double)_totalLessons) * 100 : 0;

    private void ToggleModule(string moduleId)
    {
        if (!_expandedModules.Remove(moduleId)) _expandedModules.Add(moduleId);
    }

    private static int GetModuleDuration(Module mod)
    {
        var total = 0;
        foreach (var l in mod.Lessons)
        {
            var match = System.Text.RegularExpressions.Regex.Match(l.Duration, @"(\d+)");
            if (match.Success) total += int.Parse(match.Groups[1].Value);
        }
        return total;
    }

    private static RenderFragment GetStatusIcon(string status) => status switch
    {
        "completed" => @<LucideCheckCircle2Cn Size="16" Class="h-4 w-4 text-green-600" />,
        "in_progress" => @<LucidePlayCircleCn Size="16" Class="h-4 w-4 text-primary" />,
        "locked" => @<LucideLockCn Size="16" Class="h-4 w-4 text-muted-foreground/50" />,
        _ => @<LucideCircleCn Size="16" Class="h-4 w-4 text-muted-foreground/30" />,
    };

    private static RenderFragment GetTypeIcon(string type) => type switch
    {
        "video" => @<LucidePlayCircleCn Size="14" Class="h-3.5 w-3.5" />,
        "reading" => @<LucideFileTextCn Size="14" Class="h-3.5 w-3.5" />,
        "quiz" => @<LucideHelpCircleCn Size="14" Class="h-3.5 w-3.5" />,
        "exercise" => @<LucideCodeCn Size="14" Class="h-3.5 w-3.5" />,
        _ => @<LucideCircleCn Size="14" Class="h-3.5 w-3.5" />,
    };

    private static string GetTypeLabel(string type) => type switch
    {
        "video" => "Video",
        "reading" => "Reading",
        "quiz" => "Quiz",
        "exercise" => "Exercise",
        _ => "Other",
    };
}
