@* ============================================================
   Block: tables-compliance-checklist
   Title: TablesComplianceChecklist
   Description: Compliance tracking table for governance dashboards in React with risk indicators, status badges, progress bars using shadcn/ui Table, Checkbox, Progress components with Tailwind CSS.
   Source: original/blocks/tables/tables-compliance-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideShieldCheckCn Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h3 class="text-sm font-medium">Compliance Checklist</h3>
                        <p class="text-xs text-muted-foreground">
                            @CompletedCount of @_items.Count complete
                            @if (OverdueCount > 0)
                            {
                                <span class="text-red-600"> · @OverdueCount overdue</span>
                            }
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-2 w-32">
                        <ProgressCn Value="@ProgressPercent" Class="h-1.5" />
                        <span class="text-xs font-medium tabular-nums text-muted-foreground">
                            @ProgressPercent%
                        </span>
                    </div>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-1.5 border-b px-4 py-2">
            @foreach (var opt in _filterOptions)
            {
                var catValue = opt.Value;
                <button type="button"
                        class="@Cn.Merge("rounded-md px-2 py-1 text-xs transition-colors", _categoryFilter == catValue ? "bg-foreground text-background" : "text-muted-foreground hover:bg-muted/50")"
                        @onclick="@(() => { _categoryFilter = catValue; })">
                    @opt.Label
                </button>
            }
        </div>
        <TableCn Class="w-full">
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="w-10 font-medium text-xs text-muted-foreground" />
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground">Requirement</TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground">Risk</TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground">Status</TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground">Owner</TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground">Due</TableHeadCn>
                    <TableHeadCn Class="w-16 font-medium text-xs text-muted-foreground text-center">
                        <LucidePaperclipCn Size="12" Class="size-3 mx-auto text-muted-foreground" />
                    </TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var it in FilteredItems)
                {
                    var item = it;
                    <TableRowCn Class="hover:bg-muted/50">
                        <TableCellCn Class="w-10 px-3">
                            <CheckboxCn Checked="@item.Completed" CheckedChanged="@((bool v) => ToggleItem(item.Id))" />
                        </TableCellCn>
                        <TableCellCn>
                            <div>
                                <span class="@Cn.Merge("text-sm", item.Completed ? "text-muted-foreground line-through" : "font-medium")">
                                    @item.Requirement
                                </span>
                                <p class="mt-0.5 text-[10px] text-muted-foreground font-mono">
                                    @GetCategoryLabel(item.Category)
                                </p>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1.5">
                                @GetRiskIndicator(item.Risk)
                                <span class="text-xs capitalize text-muted-foreground">@item.Risk</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn>@GetStatusIndicator(item.Status)</TableCellCn>
                        <TableCellCn>
                            <span class="text-xs text-muted-foreground">@item.Assignee</span>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="@Cn.Merge("text-xs whitespace-nowrap", item.Status == "overdue" ? "text-red-600 font-medium" : "text-muted-foreground")">
                                @item.DueDate
                            </span>
                        </TableCellCn>
                        <TableCellCn Class="text-center">
                            @if (item.EvidenceCount > 0)
                            {
                                <div class="flex items-center justify-center gap-1">
                                    <LucideFileCheckCn Size="12" Class="size-3 text-emerald-600" />
                                    <span class="text-xs text-muted-foreground">@item.EvidenceCount</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-muted-foreground/40">-</span>
                            }
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private class ComplianceItem
    {
        public string Id { get; set; } = "";
        public string Requirement { get; set; } = "";
        public string Category { get; set; } = "";
        public string Status { get; set; } = "";
        public string Risk { get; set; } = "";
        public string Assignee { get; set; } = "";
        public string DueDate { get; set; } = "";
        public int EvidenceCount { get; set; }
        public bool Completed { get; set; }
    }

    private record FilterOption(string Value, string Label);

    private static readonly FilterOption[] _filterOptions =
    [
        new("all", "All"),
        new("data-protection", "Data Protection"),
        new("access-control", "Access Control"),
        new("incident-response", "Incident Response"),
        new("encryption", "Encryption"),
        new("audit-logging", "Audit Logging"),
    ];

    private List<ComplianceItem> _items = new()
    {
        new() { Id = "comp-001", Requirement = "Implement data encryption at rest for all PII fields", Category = "encryption", Status = "completed", Risk = "critical", Assignee = "Security Team", DueDate = "Feb 15, 2026", EvidenceCount = 3, Completed = true },
        new() { Id = "comp-002", Requirement = "Enable multi-factor authentication for admin accounts", Category = "access-control", Status = "completed", Risk = "critical", Assignee = "Platform Team", DueDate = "Feb 28, 2026", EvidenceCount = 2, Completed = true },
        new() { Id = "comp-003", Requirement = "Establish incident response playbook with escalation paths", Category = "incident-response", Status = "in-progress", Risk = "high", Assignee = "DevOps Team", DueDate = "Apr 01, 2026", EvidenceCount = 1, Completed = false },
        new() { Id = "comp-004", Requirement = "Configure audit logging for all database access events", Category = "audit-logging", Status = "completed", Risk = "high", Assignee = "Backend Team", DueDate = "Mar 15, 2026", EvidenceCount = 4, Completed = true },
        new() { Id = "comp-005", Requirement = "Implement GDPR data subject access request workflow", Category = "data-protection", Status = "overdue", Risk = "critical", Assignee = "Product Team", DueDate = "Mar 01, 2026", EvidenceCount = 0, Completed = false },
        new() { Id = "comp-006", Requirement = "Review and rotate API keys every 90 days", Category = "access-control", Status = "in-progress", Risk = "medium", Assignee = "Security Team", DueDate = "Apr 15, 2026", EvidenceCount = 1, Completed = false },
        new() { Id = "comp-007", Requirement = "Enable TLS 1.3 for all external-facing endpoints", Category = "encryption", Status = "completed", Risk = "high", Assignee = "Infrastructure Team", DueDate = "Feb 20, 2026", EvidenceCount = 2, Completed = true },
        new() { Id = "comp-008", Requirement = "Document data retention and deletion policies", Category = "data-protection", Status = "not-started", Risk = "medium", Assignee = "Legal Team", DueDate = "May 01, 2026", EvidenceCount = 0, Completed = false },
        new() { Id = "comp-009", Requirement = "Conduct quarterly penetration testing", Category = "incident-response", Status = "overdue", Risk = "high", Assignee = "Security Team", DueDate = "Mar 10, 2026", EvidenceCount = 0, Completed = false },
        new() { Id = "comp-010", Requirement = "Implement role-based access control for dashboard", Category = "access-control", Status = "in-progress", Risk = "medium", Assignee = "Platform Team", DueDate = "Apr 20, 2026", EvidenceCount = 1, Completed = false },
    };

    private string _categoryFilter = "all";

    private int CompletedCount => _items.Count(i => i.Completed);
    private int OverdueCount => _items.Count(i => i.Status == "overdue");
    private int ProgressPercent => _items.Count == 0 ? 0 : (int)Math.Round((double)CompletedCount / _items.Count * 100);
    private IEnumerable<ComplianceItem> FilteredItems =>
        _categoryFilter == "all" ? _items : _items.Where(i => i.Category == _categoryFilter);

    private static string GetCategoryLabel(string category) => category switch
    {
        "data-protection" => "Data Protection",
        "access-control" => "Access Control",
        "incident-response" => "Incident Response",
        "encryption" => "Encryption",
        "audit-logging" => "Audit Logging",
        _ => category,
    };

    private static RenderFragment GetRiskIndicator(string risk) => risk switch
    {
        "critical" => @<span class="size-2 rounded-full bg-red-500"></span>,
        "high" => @<span class="size-2 rounded-full bg-amber-500"></span>,
        "medium" => @<span class="size-2 rounded-full bg-blue-500"></span>,
        _ => @<span class="size-2 rounded-full bg-emerald-500"></span>,
    };

    private static RenderFragment GetStatusIndicator(string status) => status switch
    {
        "completed" => @<div class="flex items-center gap-1.5"><LucideCheckCircle2Cn Size="14" Class="size-3.5 text-emerald-600" /><span class="text-xs text-muted-foreground">Done</span></div>,
        "in-progress" => @<div class="flex items-center gap-1.5"><LucideClockCn Size="14" Class="size-3.5 text-blue-600" /><span class="text-xs text-muted-foreground">In Progress</span></div>,
        "not-started" => @<div class="flex items-center gap-1.5"><LucideCircleCn Size="14" Class="size-3.5 text-muted-foreground/40" /><span class="text-xs text-muted-foreground">Not Started</span></div>,
        _ => @<div class="flex items-center gap-1.5"><LucideClockCn Size="14" Class="size-3.5 text-red-600" /><span class="text-xs text-red-600 font-medium">Overdue</span></div>,
    };

    private void ToggleItem(string id)
    {
        var item = _items.FirstOrDefault(i => i.Id == id);
        if (item == null) return;
        item.Completed = !item.Completed;
        item.Status = item.Completed ? "completed" : "not-started";
    }
}
