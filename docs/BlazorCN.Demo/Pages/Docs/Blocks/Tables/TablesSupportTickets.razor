@* ============================================================
   Block: tables-support-tickets
   Title: TablesSupportTickets
   Description: Support ticket queue with priority, SLA, status for React dashboards built with shadcn/ui, Tailwind CSS, and Next.js
   Source: original/blocks/tables/tables-support-tickets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Support Tickets</h3>
                <p class="text-xs text-muted-foreground">
                    @_tickets.Count(t => t.Status == "open") open &middot;
                    @_tickets.Count(t => t.SlaBreached) SLA breached
                </p>
            </div>
            <div class="relative">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-2.5 size-3.5 text-muted-foreground" />
                <InputCn Class="h-8 w-48 pl-8 text-xs"
                         Placeholder="Search tickets..."
                         Value="@_search"
                         ValueChanged="@((string v) => _search = v)" />
            </div>
        </div>
        <div class="flex items-center gap-1.5 border-b px-4 py-2">
            @foreach (var p in _priorityOptions)
            {
                var pVal = p;
                <ButtonCn Variant="@(_priorityFilter == pVal ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-6 px-2 text-xs"
                          OnClick="@(() => _priorityFilter = pVal)">
                    @if (pVal == "all")
                    {
                        <span>All</span>
                    }
                    else
                    {
                        <span class="flex items-center gap-1">
                            <span class="@Cn.Merge("size-1.5 rounded-full", GetDotClass(pVal))"></span>
                            @GetPriorityLabel(pVal)
                        </span>
                    }
                </ButtonCn>
            }
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Ticket</TableHeadCn>
                    <TableHeadCn Class="w-20 text-xs font-medium text-muted-foreground">Priority</TableHeadCn>
                    <TableHeadCn Class="w-24 text-xs font-medium text-muted-foreground">Status</TableHeadCn>
                    <TableHeadCn Class="w-20 text-xs font-medium text-muted-foreground">Category</TableHeadCn>
                    <TableHeadCn Class="w-28 text-xs font-medium text-muted-foreground">Assignee</TableHeadCn>
                    <TableHeadCn Class="w-20 text-xs font-medium text-muted-foreground text-right">SLA</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var ticket in GetFiltered())
                {
                    var t = ticket;
                    <TableRowCn Class="@Cn.Merge("hover:bg-muted/50", t.SlaBreached ? "bg-red-500/5" : "")">
                        <TableCellCn>
                            <div>
                                <div class="flex items-center gap-1.5">
                                    <span class="font-mono text-xs text-muted-foreground">@t.Id</span>
                                    <span class="text-xs text-muted-foreground">&middot;</span>
                                    <span class="text-xs text-muted-foreground">@t.Customer</span>
                                </div>
                                <p class="text-sm font-medium mt-0.5">@t.Subject</p>
                                <p class="text-xs text-muted-foreground">@t.CreatedAt</p>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1.5">
                                <span class="@Cn.Merge("size-1.5 rounded-full", GetDotClass(t.Priority))"></span>
                                <span class="text-xs">@GetPriorityLabel(t.Priority)</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary"
                                     Class="@Cn.Merge("text-[10px] font-normal", GetStatusClass(t.Status))">
                                @GetStatusLabel(t.Status)
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="text-xs text-muted-foreground">@t.Category</span>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1.5">
                                <AvatarCn Class="size-5">
                                    <AvatarFallbackCn Class="text-[8px]">@GetInitials(t.Assignee)</AvatarFallbackCn>
                                </AvatarCn>
                                <span class="text-xs">@t.Assignee</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn Class="text-right">
                            <div class="@Cn.Merge("flex items-center justify-end gap-1", t.SlaBreached ? "text-red-600" : "text-muted-foreground")">
                                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                <span class="font-mono text-xs">@(t.SlaBreached ? "Breached" : t.SlaRemaining)</span>
                            </div>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record Ticket(string Id, string Subject, string Customer, string Priority, string Status,
        string Category, string Assignee, string SlaRemaining, bool SlaBreached, string CreatedAt);

    private static readonly Ticket[] _tickets =
    [
        new("TKT-4201", "Cannot process payment with Visa card", "Acme Corp", "urgent", "open", "Billing", "Sarah Chen", "28m", false, "14 min ago"),
        new("TKT-4200", "API rate limit exceeded without warning", "TechStart Inc", "high", "in-progress", "API", "Alex Kumar", "1h 42m", false, "45 min ago"),
        new("TKT-4199", "SSO login fails with SAML assertion error", "Enterprise Ltd", "high", "open", "Authentication", "James Park", "2h 15m", false, "1 hr ago"),
        new("TKT-4198", "Dashboard charts not loading on Safari", "Design Co", "medium", "in-progress", "Bug", "Emma Wilson", "5h 30m", false, "2 hr ago"),
        new("TKT-4197", "Request for bulk user import feature", "GrowFast", "low", "waiting", "Feature Request", "Maya Patel", "23h", false, "4 hr ago"),
        new("TKT-4196", "Invoice PDF shows incorrect tax amount", "Global Services", "high", "in-progress", "Billing", "Ryan Lee", "0m", true, "6 hr ago"),
        new("TKT-4195", "Webhook events delayed by 30+ minutes", "DataSync", "medium", "open", "API", "Sarah Chen", "3h 10m", false, "3 hr ago"),
        new("TKT-4194", "Custom domain SSL certificate not renewing", "WebHost Pro", "urgent", "in-progress", "Infrastructure", "Alex Kumar", "0m", true, "8 hr ago"),
    ];

    private static readonly string[] _priorityOptions = ["all", "urgent", "high", "medium", "low"];

    private string _priorityFilter = "all";
    private string _search = "";

    private IEnumerable<Ticket> GetFiltered()
    {
        return _tickets
            .Where(t => _priorityFilter == "all" || t.Priority == _priorityFilter)
            .Where(t => _search == "" ||
                t.Subject.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                t.Id.Contains(_search, StringComparison.OrdinalIgnoreCase));
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ');
        return string.Concat(parts.Select(p => p.Length > 0 ? p[0].ToString() : ""));
    }

    private static string GetDotClass(string priority) => priority switch
    {
        "urgent" => "bg-red-500",
        "high" => "bg-orange-500",
        "medium" => "bg-amber-500",
        "low" => "bg-blue-500",
        _ => "",
    };

    private static string GetPriorityLabel(string priority) => priority switch
    {
        "urgent" => "Urgent",
        "high" => "High",
        "medium" => "Medium",
        "low" => "Low",
        _ => priority,
    };

    private static string GetStatusClass(string status) => status switch
    {
        "open" => "bg-red-500/10 text-red-700",
        "in-progress" => "bg-blue-500/10 text-blue-700",
        "waiting" => "bg-amber-500/10 text-amber-700",
        "resolved" => "bg-green-500/10 text-green-700",
        _ => "",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "open" => "Open",
        "in-progress" => "In Progress",
        "waiting" => "Waiting",
        "resolved" => "Resolved",
        _ => status,
    };
}
