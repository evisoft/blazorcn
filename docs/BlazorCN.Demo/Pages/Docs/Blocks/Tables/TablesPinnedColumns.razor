@* ============================================================
   Block: tables-pinned-columns
   Title: Tables Pinned Columns
   Description: Table component with pinned left and right columns that stay fixed during horizontal scroll
   Dependencies: BadgeCn, ButtonCn, TableCn
   Source: original/blocks/tables/tables-pinned-columns.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <p class="text-sm text-muted-foreground">
                @_stock.Length inventory items. Scroll horizontally to see pinned columns.
            </p>
            <p class="text-xs text-muted-foreground">SKU and Actions columns stay fixed</p>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <div class="overflow-x-auto">
                <TableCn style="width: 1400px">
                    <TableHeaderCn>
                        <TableRowCn>
                            <TableHeadCn Class="sticky left-0 z-20 bg-card font-semibold text-foreground shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]" style="width: 90px">SKU</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground" style="width: 180px">Product Name</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground" style="width: 120px">Category</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground" style="width: 140px">Supplier</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground" style="width: 100px">Location</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground text-right" style="width: 80px">Qty</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground text-right" style="width: 80px">Reserved</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground text-right" style="width: 80px">Available</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground text-right" style="width: 80px">Min</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground text-right" style="width: 80px">Max</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground text-right" style="width: 100px">Unit Cost</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground text-right" style="width: 120px">Total Value</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground" style="width: 100px">Restocked</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground" style="width: 100px">Status</TableHeadCn>
                            <TableHeadCn Class="sticky right-0 z-20 bg-card font-semibold text-foreground shadow-[-2px_0_5px_-2px_rgba(0,0,0,0.1)]" style="width: 100px">Actions</TableHeadCn>
                        </TableRowCn>
                    </TableHeaderCn>
                    <TableBodyCn>
                        @foreach (var item in _stock)
                        {
                            var (statusLabel, statusClass) = GetStatusBadge(item.Status);

                            <TableRowCn>
                                <TableCellCn Class="sticky left-0 z-10 bg-card font-mono text-xs font-medium shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)]">@item.Sku</TableCellCn>
                                <TableCellCn Class="font-medium">@item.Name</TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@item.Category</TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@item.Supplier</TableCellCn>
                                <TableCellCn Class="font-mono text-xs text-muted-foreground">@item.Location</TableCellCn>
                                <TableCellCn Class="text-right font-mono">@item.Quantity</TableCellCn>
                                <TableCellCn Class="text-right font-mono text-muted-foreground">@item.Reserved</TableCellCn>
                                <TableCellCn Class="text-right font-mono font-semibold">@item.Available</TableCellCn>
                                <TableCellCn Class="text-right font-mono text-muted-foreground">@item.MinStock</TableCellCn>
                                <TableCellCn Class="text-right font-mono text-muted-foreground">@item.MaxStock</TableCellCn>
                                <TableCellCn Class="text-right font-mono">@item.UnitCost.ToString("C2")</TableCellCn>
                                <TableCellCn Class="text-right font-mono font-semibold">@item.TotalValue.ToString("N2")</TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@item.LastRestocked</TableCellCn>
                                <TableCellCn>
                                    <BadgeCn Class="@statusClass" Variant="BadgeVariant.Outline">@statusLabel</BadgeCn>
                                </TableCellCn>
                                <TableCellCn Class="sticky right-0 z-10 bg-card shadow-[-2px_0_5px_-2px_rgba(0,0,0,0.1)]">
                                    <div class="flex gap-1">
                                        <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" aria-label="@($"View {item.Name}")">
                                            <LucideEyeCn Size="16" Class="h-4 w-4" />
                                        </ButtonCn>
                                        <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" aria-label="@($"Edit {item.Name}")">
                                            <LucidePencilCn Size="16" Class="h-4 w-4" />
                                        </ButtonCn>
                                    </div>
                                </TableCellCn>
                            </TableRowCn>
                        }
                    </TableBodyCn>
                </TableCn>
            </div>
        </div>
    </div>
</div>

@code {
    private record StockItem(string Id, string Sku, string Name, string Category, string Supplier, string Location, int Quantity, int Reserved, int Available, int MinStock, int MaxStock, double UnitCost, double TotalValue, string LastRestocked, string Status);

    private static readonly StockItem[] _stock =
    [
        new("1", "WH-001", "Wireless Headphones", "Electronics", "TechSupply Co", "A-12-3", 250, 45, 205, 50, 500, 45.99, 11497.50, "2024-01-10", "in-stock"),
        new("2", "KB-002", "Mechanical Keyboard", "Electronics", "KeyCraft Ltd", "A-15-1", 120, 30, 90, 40, 200, 89.99, 10798.80, "2024-01-08", "in-stock"),
        new("3", "MS-003", "Ergonomic Mouse", "Electronics", "TechSupply Co", "A-12-5", 35, 20, 15, 50, 300, 34.99, 1224.65, "2024-01-05", "low-stock"),
        new("4", "MN-004", "27\" Monitor", "Electronics", "DisplayPro", "B-03-2", 0, 0, 0, 20, 100, 299.99, 0, "2023-12-20", "out-of-stock"),
        new("5", "CH-005", "Office Chair", "Furniture", "ComfortSeating", "C-08-1", 180, 12, 168, 30, 150, 199.99, 35998.20, "2024-01-12", "overstock"),
        new("6", "DS-006", "Standing Desk", "Furniture", "ErgoDesk Inc", "C-10-4", 45, 8, 37, 15, 80, 449.99, 20249.55, "2024-01-09", "in-stock"),
    ];

    private static (string Label, string ClassName) GetStatusBadge(string status) => status switch
    {
        "in-stock" => ("In Stock", "border-green-200 text-green-700"),
        "low-stock" => ("Low Stock", "border-orange-200 text-orange-700"),
        "out-of-stock" => ("Out of Stock", "border-red-200 text-red-700"),
        "overstock" => ("Overstock", "border-blue-200 text-blue-700"),
        _ => (status, ""),
    };
}
