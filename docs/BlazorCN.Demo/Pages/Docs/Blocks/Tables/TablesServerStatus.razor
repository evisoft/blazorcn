@* ============================================================
   Block: tables-server-status
   Title: Tables Server Status
   Description: Table component with server monitoring status showing uptime, CPU, memory and health indicators
   Dependencies: BadgeCn, ProgressCn, TableCn
   Source: original/blocks/tables/tables-server-status.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Server Fleet</h3>
                <p class="text-sm text-muted-foreground">
                    @_servers.Length servers &middot; Last updated just now
                </p>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Class="gap-1 border-green-200 text-green-700" Variant="BadgeVariant.Outline">
                    <LucideCheckCircle2Cn Size="12" Class="h-3 w-3" />
                    @_onlineCount healthy
                </BadgeCn>
                @if (_issueCount > 0)
                {
                    <BadgeCn Class="gap-1 border-red-200 text-red-700" Variant="BadgeVariant.Outline">
                        <LucideAlertTriangleCn Size="12" Class="h-3 w-3" />
                        @_issueCount issues
                    </BadgeCn>
                }
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-40 font-semibold text-foreground">Server</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground">Status</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground">Role</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">CPU</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Memory</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Disk</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">Uptime</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-right">Latency</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var server in _servers)
                    {
                        var (statusLabel, statusBadgeClass) = GetStatusConfig(server.Status);
                        var statusIconClass = GetStatusIconClass(server.Status);
                        var (roleLabel, _) = GetRoleConfig(server.Role);

                        <TableRowCn Class="@Cn.Merge(server.Status == "critical" ? "bg-red-50/50" : "", server.Status == "offline" ? "bg-muted/30 opacity-60" : "")">
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <LucideServerCn Size="16" Class="@Cn.Merge("h-4 w-4", statusIconClass)" />
                                    <div>
                                        <p class="font-medium text-sm">@server.Hostname</p>
                                        <p class="text-xs text-muted-foreground font-mono">@server.Ip</p>
                                    </div>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@Cn.Merge("gap-1 text-xs", statusBadgeClass)" Variant="BadgeVariant.Secondary">
                                    @if (server.Status == "online")
                                    {
                                        <LucideCheckCircle2Cn Size="12" Class="h-3 w-3" />
                                    }
                                    else if (server.Status is "warning" or "critical")
                                    {
                                        <LucideAlertTriangleCn Size="12" Class="h-3 w-3" />
                                    }
                                    else
                                    {
                                        <LucideXCircleCn Size="12" Class="h-3 w-3" />
                                    }
                                    @statusLabel
                                </BadgeCn>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-1.5 text-sm text-muted-foreground">
                                    @if (server.Role == "web")
                                    {
                                        <LucideWifiCn Size="14" Class="h-3.5 w-3.5" />
                                    }
                                    else if (server.Role == "database")
                                    {
                                        <LucideHardDriveCn Size="14" Class="h-3.5 w-3.5" />
                                    }
                                    else if (server.Role == "cache")
                                    {
                                        <LucideActivityCn Size="14" Class="h-3.5 w-3.5" />
                                    }
                                    else
                                    {
                                        <LucideCpuCn Size="14" Class="h-3.5 w-3.5" />
                                    }
                                    <span>@roleLabel</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                @if (server.Status != "offline")
                                {
                                    <div class="flex items-center gap-2">
                                        <ProgressCn Value="@server.Cpu" Class="h-2 w-16" />
                                        <span class="@Cn.Merge("font-mono text-xs w-8", server.Cpu >= 95 ? "text-red-600 font-medium" : "", server.Cpu >= 80 && server.Cpu < 95 ? "text-yellow-600" : "")">@(server.Cpu)%</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-muted-foreground">&mdash;</span>
                                }
                            </TableCellCn>
                            <TableCellCn>
                                @if (server.Status != "offline")
                                {
                                    <div class="flex items-center gap-2">
                                        <ProgressCn Value="@server.Memory" Class="h-2 w-16" />
                                        <span class="@Cn.Merge("font-mono text-xs w-8", server.Memory >= 95 ? "text-red-600 font-medium" : "", server.Memory >= 80 && server.Memory < 95 ? "text-yellow-600" : "")">@(server.Memory)%</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-muted-foreground">&mdash;</span>
                                }
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <ProgressCn Value="@server.Disk" Class="h-2 w-16" />
                                    <span class="@Cn.Merge("font-mono text-xs w-8", server.Disk >= 95 ? "text-red-600 font-medium" : "", server.Disk >= 85 && server.Disk < 95 ? "text-yellow-600" : "")">@(server.Disk)%</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <span class="@Cn.Merge("font-mono text-sm", server.Uptime >= 99.9 ? "text-green-600" : "", server.Uptime < 99 ? "text-yellow-600" : "")">@(server.Uptime)%</span>
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                @if (server.Status != "offline")
                                {
                                    <span class="@Cn.Merge("font-mono text-sm", server.ResponseTime > 200 ? "text-red-600" : "", server.ResponseTime > 100 && server.ResponseTime <= 200 ? "text-yellow-600" : "")">@(server.ResponseTime)ms</span>
                                }
                                else
                                {
                                    <span class="text-xs text-muted-foreground">&mdash;</span>
                                }
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex items-center gap-6 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
                <LucideCheckCircle2Cn Size="14" Class="h-3.5 w-3.5 text-green-600" />
                <span>Healthy</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideAlertTriangleCn Size="14" Class="h-3.5 w-3.5 text-yellow-600" />
                <span>Warning (80%+)</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideAlertTriangleCn Size="14" Class="h-3.5 w-3.5 text-red-600" />
                <span>Critical (95%+)</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideClockCn Size="14" Class="h-3.5 w-3.5" />
                <span>Auto-refresh 5s</span>
            </div>
        </div>
    </div>
</div>

@code {
    private record ServerInfo(string Id, string Hostname, string Ip, string Role, string Status, int Cpu, int Memory, int Disk, double Uptime, int ResponseTime, string LastCheck);

    private static readonly ServerInfo[] _servers =
    [
        new("1", "prod-web-01", "10.0.1.101", "web", "online", 45, 62, 38, 99.99, 23, "5s ago"),
        new("2", "prod-web-02", "10.0.1.102", "web", "online", 52, 58, 41, 99.98, 28, "5s ago"),
        new("3", "prod-db-01", "10.0.2.101", "database", "warning", 78, 85, 72, 99.95, 45, "5s ago"),
        new("4", "prod-db-02", "10.0.2.102", "database", "online", 34, 71, 68, 99.99, 31, "5s ago"),
        new("5", "prod-cache-01", "10.0.3.101", "cache", "online", 12, 45, 15, 100, 8, "5s ago"),
        new("6", "prod-worker-01", "10.0.4.101", "worker", "critical", 98, 94, 55, 99.85, 156, "5s ago"),
        new("7", "prod-worker-02", "10.0.4.102", "worker", "online", 67, 72, 48, 99.97, 42, "5s ago"),
        new("8", "prod-web-03", "10.0.1.103", "web", "offline", 0, 0, 45, 98.5, 0, "2m ago"),
    ];

    private static readonly int _onlineCount = _servers.Count(s => s.Status == "online");
    private static readonly int _issueCount = _servers.Count(s => s.Status is "warning" or "critical" or "offline");

    private static (string Label, string BadgeClass) GetStatusConfig(string status) => status switch
    {
        "online" => ("Online", "bg-green-100 text-green-700 hover:bg-green-100"),
        "warning" => ("Warning", "bg-yellow-100 text-yellow-700 hover:bg-yellow-100"),
        "critical" => ("Critical", "bg-red-100 text-red-700 hover:bg-red-100"),
        "offline" => ("Offline", "bg-muted text-muted-foreground hover:bg-muted"),
        _ => (status, ""),
    };

    private static string GetStatusIconClass(string status) => status switch
    {
        "online" => "text-green-600",
        "warning" => "text-yellow-600",
        "critical" => "text-red-600",
        "offline" => "text-muted-foreground",
        _ => "",
    };

    private static (string Label, string Icon) GetRoleConfig(string role) => role switch
    {
        "web" => ("Web", "wifi"),
        "database" => ("Database", "hard-drive"),
        "cache" => ("Cache", "activity"),
        "worker" => ("Worker", "cpu"),
        _ => (role, ""),
    };
}
