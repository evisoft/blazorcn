@* ============================================================
   Block: tables-column-visibility
   Title: Tables Column Visibility
   Description: Data table component with column visibility toggle for dynamically showing or hiding columns
   Dependencies: BadgeCn, ButtonCn, TableCn
   Source: original/blocks/tables/tables-column-visibility.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <p class="text-sm text-muted-foreground">@_employees.Length employees</p>
            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="gap-2" OnClick="() => _showColumnPicker = !_showColumnPicker">
                    <LucideSettings2Cn Size="16" Class="h-4 w-4" />
                    <span>Columns</span>
                    @if (_hiddenCount > 0)
                    {
                        <BadgeCn Class="ml-1" Variant="BadgeVariant.Secondary">@_hiddenCount hidden</BadgeCn>
                    }
                </ButtonCn>
            </div>
        </div>

        @if (_showColumnPicker)
        {
            <div class="rounded-lg border bg-card p-3 shadow-sm">
                <p class="text-sm font-medium mb-2">Toggle columns</p>
                <div class="flex flex-wrap gap-2">
                    @foreach (var col in _allColumns)
                    {
                        var isVisible = _visibleColumns.Contains(col.Key);
                        <ButtonCn Size="ButtonSize.Sm"
                                  Variant="@(isVisible ? ButtonVariant.Default : ButtonVariant.Outline)"
                                  OnClick="() => ToggleColumn(col.Key)">
                            @col.Label
                        </ButtonCn>
                    }
                </div>
            </div>
        }

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        @foreach (var col in _allColumns)
                        {
                            if (_visibleColumns.Contains(col.Key))
                            {
                                <TableHeadCn Class="font-semibold text-foreground">@col.Label</TableHeadCn>
                            }
                        }
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var emp in _employees)
                    {
                        <TableRowCn>
                            @if (_visibleColumns.Contains("id"))
                            {
                                <TableCellCn Class="font-mono text-xs">@emp.Id</TableCellCn>
                            }
                            @if (_visibleColumns.Contains("name"))
                            {
                                <TableCellCn Class="font-medium">@emp.Name</TableCellCn>
                            }
                            @if (_visibleColumns.Contains("email"))
                            {
                                <TableCellCn Class="text-muted-foreground">@emp.Email</TableCellCn>
                            }
                            @if (_visibleColumns.Contains("department"))
                            {
                                <TableCellCn>@emp.Department</TableCellCn>
                            }
                            @if (_visibleColumns.Contains("role"))
                            {
                                <TableCellCn Class="text-muted-foreground">@emp.Role</TableCellCn>
                            }
                            @if (_visibleColumns.Contains("location"))
                            {
                                <TableCellCn Class="text-muted-foreground">@emp.Location</TableCellCn>
                            }
                            @if (_visibleColumns.Contains("phone"))
                            {
                                <TableCellCn Class="font-mono text-xs">@emp.Phone</TableCellCn>
                            }
                            @if (_visibleColumns.Contains("startDate"))
                            {
                                <TableCellCn Class="text-muted-foreground">@emp.StartDate</TableCellCn>
                            }
                            @if (_visibleColumns.Contains("salary"))
                            {
                                <TableCellCn Class="font-mono font-semibold">@emp.Salary.ToString("C0")</TableCellCn>
                            }
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>
    </div>
</div>

@code {
    private record EmployeeItem(string Id, string Name, string Email, string Department, string Role, string Location, string Phone, string StartDate, double Salary);
    private record ColumnDef(string Key, string Label);

    private bool _showColumnPicker;

    private static readonly ColumnDef[] _allColumns =
    [
        new("id", "ID"),
        new("name", "Name"),
        new("email", "Email"),
        new("department", "Department"),
        new("role", "Role"),
        new("location", "Location"),
        new("phone", "Phone"),
        new("startDate", "Start Date"),
        new("salary", "Salary"),
    ];

    private HashSet<string> _visibleColumns = new(["id", "name", "email", "department", "role"]);

    private int _hiddenCount => _allColumns.Length - _visibleColumns.Count;

    private static readonly EmployeeItem[] _employees =
    [
        new("EMP001", "Alice Johnson", "alice.j@company.com", "Engineering", "Senior Developer", "San Francisco", "+1-555-0101", "2020-03-15", 125_000),
        new("EMP002", "Bob Smith", "bob.s@company.com", "Product", "Product Manager", "New York", "+1-555-0102", "2019-07-22", 135_000),
        new("EMP003", "Carol White", "carol.w@company.com", "Design", "UX Designer", "Remote", "+1-555-0103", "2021-01-10", 105_000),
        new("EMP004", "David Brown", "david.b@company.com", "Engineering", "DevOps Engineer", "Austin", "+1-555-0104", "2020-09-05", 115_000),
        new("EMP005", "Eve Davis", "eve.d@company.com", "Marketing", "Marketing Lead", "Chicago", "+1-555-0105", "2018-11-30", 110_000),
        new("EMP006", "Frank Miller", "frank.m@company.com", "Analytics", "Data Analyst", "Seattle", "+1-555-0106", "2021-05-18", 95_000),
    ];

    private void ToggleColumn(string key)
    {
        if (!_visibleColumns.Remove(key))
        {
            _visibleColumns.Add(key);
        }
    }
}
