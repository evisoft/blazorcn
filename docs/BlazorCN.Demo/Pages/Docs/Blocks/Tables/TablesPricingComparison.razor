@* ============================================================
   Block: tables-pricing-comparison
   Title: Tables Pricing Comparison
   Description: Table component with feature comparison across pricing tiers showing checkmarks and plan highlights for SaaS pricing pages
   Dependencies: BadgeCn, ButtonCn, TableCn, TableBodyCn, TableCellCn, TableHeadCn, TableHeaderCn, TableRowCn, TooltipCn, TooltipContentCn, TooltipTriggerCn, LucideCheckCn, LucideCircleHelpCn, LucideXCn
   Source: original/blocks/tables/tables-pricing-comparison.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="text-center">
            <h3 class="text-2xl font-bold">Compare Plans</h3>
            <p class="text-muted-foreground mt-1">Choose the perfect plan for your team</p>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-48 font-semibold text-foreground">Features</TableHeadCn>
                        @foreach (var tier in _tiers)
                        {
                            <TableHeadCn Class="@Cn.Merge("text-center", tier.IsPopular ? "bg-primary/5 border-x-2 border-t-2 border-primary" : "")">
                                <div class="space-y-2 py-2">
                                    @if (tier.IsPopular)
                                    {
                                        <BadgeCn Class="mb-1">Most Popular</BadgeCn>
                                    }
                                    <div class="font-bold text-lg">@tier.Name</div>
                                    <div class="text-2xl font-bold">
                                        @if (tier.Price == -1)
                                        {
                                            <span>Custom</span>
                                        }
                                        else
                                        {
                                            <span>$@tier.Price</span>
                                        }
                                        @if (tier.Price > 0)
                                        {
                                            <span class="text-sm font-normal text-muted-foreground">/@tier.Period.Replace("per ", "")</span>
                                        }
                                    </div>
                                    <p class="text-xs text-muted-foreground">@tier.Description</p>
                                    <ButtonCn Class="w-full mt-2" Size="ButtonSize.Sm" Variant="@(tier.IsPopular ? ButtonVariant.Default : ButtonVariant.Outline)">@tier.CtaText</ButtonCn>
                                </div>
                            </TableHeadCn>
                        }
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var category in _categories)
                    {
                        <TableRowCn Class="bg-muted/30">
                            <TableCellCn Class="font-semibold text-sm py-2" ColSpan="5">@category</TableCellCn>
                        </TableRowCn>
                        @foreach (var feature in _features.Where(f => f.Category == category))
                        {
                            <TableRowCn>
                                <TableCellCn Class="text-sm">
                                    @if (!string.IsNullOrEmpty(feature.Description))
                                    {
                                        <TooltipCn>
                                            <TooltipTriggerCn>
                                                <div class="flex items-center gap-1.5 cursor-help">
                                                    <span>@feature.Name</span>
                                                    <LucideCircleHelpCn Size="14" Class="text-muted-foreground" />
                                                </div>
                                            </TooltipTriggerCn>
                                            <TooltipContentCn>
                                                <p class="max-w-xs">@feature.Description</p>
                                            </TooltipContentCn>
                                        </TooltipCn>
                                    }
                                    else
                                    {
                                        <span>@feature.Name</span>
                                    }
                                </TableCellCn>
                                @foreach (var tier in _tiers)
                                {
                                    var value = feature.Values.GetValueOrDefault(tier.Id, "false");
                                    <TableCellCn Class="@Cn.Merge("text-center", tier.IsPopular ? "bg-primary/5 border-x-2 border-primary" : "")">
                                        <div class="flex justify-center">
                                            @if (value == "true")
                                            {
                                                <LucideCheckCn Size="20" Class="@Cn.Merge(tier.IsPopular ? "text-primary" : "text-green-600")" />
                                            }
                                            else if (value == "false")
                                            {
                                                <LucideXCn Size="20" Class="text-muted-foreground/40" />
                                            }
                                            else
                                            {
                                                <span class="@($"text-sm font-medium {(tier.IsPopular ? "text-primary" : "")}")">@value</span>
                                            }
                                        </div>
                                    </TableCellCn>
                                }
                            </TableRowCn>
                        }
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground text-center">
            All plans include 14-day free trial. No credit card required. Cancel anytime.
        </p>
    </div>
</div>

@code {
    private record TierItem(string Id, string Name, int Price, string Period, string Description, bool IsPopular, string CtaText);
    private record FeatureItem(string Id, string Name, string Category, Dictionary<string, string> Values, string? Description = null);

    private readonly string[] _categories = ["Core Features", "Collaboration", "Security & Compliance", "Support"];

    private readonly TierItem[] _tiers = [
        new("free", "Free", 0, "forever", "For individuals getting started", false, "Get Started"),
        new("pro", "Pro", 29, "per month", "For growing teams", true, "Start Free Trial"),
        new("business", "Business", 79, "per month", "For larger organizations", false, "Contact Sales"),
        new("enterprise", "Enterprise", -1, "custom", "For enterprise needs", false, "Contact Sales"),
    ];

    private readonly FeatureItem[] _features = [
        new("users", "Team members", "Core Features", new() { ["free"] = "1 user", ["pro"] = "Up to 10", ["business"] = "Up to 50", ["enterprise"] = "Unlimited" }),
