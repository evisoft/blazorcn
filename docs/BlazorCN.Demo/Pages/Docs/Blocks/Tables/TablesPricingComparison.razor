        new("permissions", "Advanced permissions", "Collaboration", new() { ["free"] = "false", ["pro"] = "false", ["business"] = "true", ["enterprise"] = "true" }, "Role-based access control"),
        new("sso", "SSO authentication", "Security & Compliance", new() { ["free"] = "false", ["pro"] = "false", ["business"] = "true", ["enterprise"] = "true" }, "SAML, OIDC support"),
        new("audit", "Audit logs", "Security & Compliance", new() { ["free"] = "false", ["pro"] = "false", ["business"] = "90 days", ["enterprise"] = "Unlimited" }, "Track all user actions"),
