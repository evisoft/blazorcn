        new("storage", "Storage", "Core Features", new() { ["free"] = "1 GB", ["pro"] = "50 GB", ["business"] = "500 GB", ["enterprise"] = "Unlimited" }, "Cloud storage for files and assets"),
        new("api", "API access", "Core Features", new() { ["free"] = "false", ["pro"] = "true", ["business"] = "true", ["enterprise"] = "true" }, "REST and GraphQL API endpoints"),
        new("realtime", "Real-time collaboration", "Collaboration", new() { ["free"] = "false", ["pro"] = "true", ["business"] = "true", ["enterprise"] = "true" }),
        new("comments", "Comments & mentions", "Collaboration", new() { ["free"] = "true", ["pro"] = "true", ["business"] = "true", ["enterprise"] = "true" }),
