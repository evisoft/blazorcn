@* ============================================================
   Block: tables-grouped
   Title: Tables Grouped
   Description: Grouped table component with collapsible category sections and item counts
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-grouped.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
        <TableCn Class="table-fixed" style="width: 850px">
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn Class="font-semibold text-foreground">Item Name</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Price</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Quantity</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Supplier</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var group in _groupedItems)
                {
                    var isExpanded = _expandedGroups.Contains(group.Key);

                    <TableRowCn Class="bg-muted/50 hover:bg-muted/70 cursor-pointer" @onclick="() => ToggleGroup(group.Key)">
                        <TableCellCn colspan="4">
                            <div class="flex items-center gap-3">
                                <LucideChevronDownCn Size="16" Class="@Cn.Merge("h-4 w-4 transition-transform duration-200", !isExpanded ? "-rotate-90" : "")" />
                                <span class="font-semibold">@group.Key</span>
                                <BadgeCn Class="ml-2" Variant="BadgeVariant.Secondary">@group.Value.Length</BadgeCn>
                            </div>
                        </TableCellCn>
                    </TableRowCn>
                    @if (isExpanded)
                    {
                        @foreach (var item in group.Value)
                        {
                            <TableRowCn>
                                <TableCellCn Class="pl-12 font-medium">@item.Name</TableCellCn>
                                <TableCellCn Class="font-mono font-semibold">@item.Price.ToString("C2")</TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@item.Quantity</TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@item.Supplier</TableCellCn>
                            </TableRowCn>
                        }
                    }
                }
            </TableBodyCn>
        </TableCn>
    </div>
</div>

@code {
    private record Item(string Id, string Name, string Category, double Price, int Quantity, string Supplier);

    private static readonly Item[] _items =
    [
        new("1", "Laptop Pro 15", "Electronics", 1299.99, 25, "TechCorp"),
        new("2", "Wireless Mouse", "Electronics", 29.99, 150, "TechCorp"),
        new("3", "USB-C Cable", "Electronics", 12.99, 300, "CableMax"),
        new("10", "Monitor 27 inch", "Electronics", 299.99, 30, "TechCorp"),
        new("4", "Office Chair", "Furniture", 249.99, 40, "ComfortPlus"),
        new("5", "Standing Desk", "Furniture", 599.99, 15, "ComfortPlus"),
        new("6", "Desk Lamp", "Furniture", 49.99, 80, "LightWorks"),
        new("7", "Notebook A5", "Stationery", 4.99, 500, "PaperCo"),
        new("8", "Pen Set", "Stationery", 9.99, 200, "PaperCo"),
        new("9", "Sticky Notes", "Stationery", 3.99, 400, "PaperCo"),
    ];

    private static readonly Dictionary<string, Item[]> _groupedItems = _items
        .GroupBy(i => i.Category)
        .ToDictionary(g => g.Key, g => g.ToArray());

    private HashSet<string> _expandedGroups = new(["Electronics", "Furniture", "Stationery"]);

    private void ToggleGroup(string category)
    {
        if (!_expandedGroups.Remove(category))
        {
            _expandedGroups.Add(category);
        }
    }
}
