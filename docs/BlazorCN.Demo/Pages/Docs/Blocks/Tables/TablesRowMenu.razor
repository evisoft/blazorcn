@* ============================================================
   Block: tables-row-menu
   Title: Tables Row Menu
   Description: Table component with dropdown menu per row for multiple actions in admin panels
   Dependencies: BadgeCn, ButtonCn, DropdownMenuCn, TableCn
   Source: original/blocks/tables/tables-row-menu.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
        <TableCn Class="table-fixed" style="width: 850px">
            <TableHeaderCn>
                <TableRowCn>
                    <TableHeadCn Class="font-semibold text-foreground">Title</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Author</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Status</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Last Modified</TableHeadCn>
                    <TableHeadCn Class="font-semibold text-foreground">Views</TableHeadCn>
                    <TableHeadCn Class="w-12"><span class="sr-only">Actions</span></TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var doc in _documents)
                {
                    var (statusLabel, statusVariant, statusClass) = GetStatusConfig(doc.Status);

                    <TableRowCn>
                        <TableCellCn Class="font-medium">@doc.Title</TableCellCn>
                        <TableCellCn Class="text-muted-foreground">@doc.Author</TableCellCn>
                        <TableCellCn>
                            <BadgeCn Class="@statusClass" Variant="@statusVariant">@statusLabel</BadgeCn>
                        </TableCellCn>
                        <TableCellCn Class="text-muted-foreground">@doc.LastModified</TableCellCn>
                        <TableCellCn Class="text-muted-foreground">@doc.Views</TableCellCn>
                        <TableCellCn>
                            <DropdownMenuCn>
                                <DropdownMenuTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-sm h-8 w-8 p-0" data-variant="ghost" data-size="sm">
                                        <span class="sr-only">Open menu</span>
                                        <LucideEllipsisCn Size="16" Class="h-4 w-4" />
                                    </DropdownMenuTriggerCn>
                                <DropdownMenuContentCn Align="FloatingAlign.End">
                                    <DropdownMenuLabelCn>Actions</DropdownMenuLabelCn>
                                    <DropdownMenuSeparatorCn />
                                    <DropdownMenuItemCn>
                                        <LucideEyeCn Size="16" Class="mr-2 h-4 w-4" />
                                        View
                                    </DropdownMenuItemCn>
                                    <DropdownMenuItemCn>
                                        <LucidePencilCn Size="16" Class="mr-2 h-4 w-4" />
                                        Edit
                                    </DropdownMenuItemCn>
                                    <DropdownMenuItemCn>
                                        <LucideCopyCn Size="16" Class="mr-2 h-4 w-4" />
                                        Duplicate
                                    </DropdownMenuItemCn>
                                    <DropdownMenuSeparatorCn />
                                    <DropdownMenuItemCn>
                                        <LucideShare2Cn Size="16" Class="mr-2 h-4 w-4" />
                                        Share
                                    </DropdownMenuItemCn>
                                    <DropdownMenuItemCn Disabled="@(doc.Status == "archived")">
                                        <LucideArchiveCn Size="16" Class="mr-2 h-4 w-4" />
                                        Archive
                                    </DropdownMenuItemCn>
                                    <DropdownMenuSeparatorCn />
                                    <DropdownMenuItemCn Class="text-destructive focus:text-destructive">
                                        <LucideTrash2Cn Size="16" Class="mr-2 h-4 w-4" />
                                        Delete
                                    </DropdownMenuItemCn>
                                </DropdownMenuContentCn>
                            </DropdownMenuCn>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</div>

@code {
    private record DocItem(string Id, string Title, string Author, string Status, string LastModified, int Views);

    private static readonly DocItem[] _documents =
    [
        new("1", "Q4 Marketing Strategy", "Sarah Chen", "published", "2024-01-15", 234),
        new("2", "Product Roadmap 2024", "Mike Johnson", "draft", "2024-01-14", 45),
        new("3", "Engineering Handbook", "Alex Kumar", "published", "2024-01-13", 567),
        new("4", "Sales Training Guide", "Emma Wilson", "published", "2024-01-12", 189),
        new("5", "Old Brand Guidelines", "David Brown", "archived", "2024-01-10", 12),
        new("6", "Team Building Ideas", "Lisa Anderson", "draft", "2024-01-09", 23),
    ];

    private static (string Label, BadgeVariant Variant, string ClassName) GetStatusConfig(string status) => status switch
    {
        "published" => ("Published", BadgeVariant.Outline, "border-green-200 text-green-700"),
        "draft" => ("Draft", BadgeVariant.Outline, "border-orange-200 text-orange-700"),
        "archived" => ("Archived", BadgeVariant.Secondary, ""),
        _ => (status, BadgeVariant.Secondary, ""),
    };
}
