@* ============================================================
   Block: tables-sparkline
   Title: Tables Sparkline
   Description: Data table component with inline sparkline charts showing trends for analytics dashboards
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-sparkline.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold">Key Metrics</h3>
            <p class="text-sm text-muted-foreground">Last 12 periods</p>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-48 font-semibold text-foreground">Metric</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Category</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground text-right">Current</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground text-right">Previous</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground text-right">Change</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Trend</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var metric in _metrics)
                    {
                        var change = (metric.CurrentValue - metric.PreviousValue) / metric.PreviousValue * 100;
                        var isPositive = change > 0;
                        var invertColors = _invertedMetrics.Contains(metric.Name);
                        var isGood = invertColors ? !isPositive : isPositive;
                        var trendUp = metric.CurrentValue > metric.PreviousValue;
                        var sparklinePath = GetSparklinePath(metric.SparklineData);
                        var lastPoint = GetLastPoint(metric.SparklineData);
                        var strokeColor = trendUp ? "#22c55e" : "#ef4444";

                        <TableRowCn>
                            <TableCellCn Class="font-medium">@metric.Name</TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="font-normal" Variant="BadgeVariant.Secondary">@metric.Category</BadgeCn>
                            </TableCellCn>
                            <TableCellCn Class="text-right font-mono font-semibold">
                                @FormatValue(metric.CurrentValue, metric.Prefix, metric.Unit)
                            </TableCellCn>
                            <TableCellCn Class="text-right font-mono text-muted-foreground">
                                @FormatValue(metric.PreviousValue, metric.Prefix, metric.Unit)
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <div class="@($"flex items-center gap-1 justify-end {(isGood ? "text-green-600" : "text-red-600")}")">
                                    @if (isPositive)
                                    {
                                        <LucideTrendingUpCn Size="16" Class="h-4 w-4" />
                                    }
                                    else
                                    {
                                        <LucideTrendingDownCn Size="16" Class="h-4 w-4" />
                                    }
                                    <span class="text-sm font-medium">@(isPositive ? "+" : "")@change.ToString("F1")%</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <svg width="100" height="28" class="overflow-visible" role="img" aria-label="@(trendUp ? "Trend increasing" : "Trend decreasing")">
                                    <path d="@sparklinePath" fill="none" stroke="@strokeColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                    <circle cx="@lastPoint.X.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" cy="@lastPoint.Y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)" r="3" fill="@strokeColor" />
                                </svg>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>
    </div>
</div>

@code {
    private record MetricData(string Name, string Category, double CurrentValue, double PreviousValue, string Unit, string Prefix, double[] SparklineData);

    private static readonly string[] _invertedMetrics = ["Avg Response Time", "Churn Rate", "Support Tickets"];

    private static readonly MetricData[] _metrics =
    [
        new("Monthly Revenue", "Finance", 284500, 251200, "", "$", [42, 48, 45, 53, 58, 52, 61, 59, 68, 72, 69, 78]),
        new("Active Users", "Growth", 12847, 11203, "", "", [85, 82, 88, 91, 87, 93, 96, 92, 98, 101, 105, 112]),
        new("Conversion Rate", "Marketing", 3.24, 2.89, "%", "", [2.1, 2.3, 2.4, 2.2, 2.6, 2.8, 2.7, 2.9, 3.0, 3.1, 3.0, 3.24]),
        new("Avg Response Time", "Performance", 245, 312, "ms", "", [380, 350, 340, 320, 310, 290, 285, 270, 260, 255, 250, 245]),
        new("Customer Satisfaction", "Support", 4.6, 4.4, "/5", "", [4.2, 4.3, 4.2, 4.4, 4.3, 4.5, 4.4, 4.5, 4.6, 4.5, 4.6, 4.6]),
        new("Churn Rate", "Retention", 2.1, 2.8, "%", "", [3.5, 3.4, 3.2, 3.0, 2.9, 2.8, 2.7, 2.5, 2.4, 2.3, 2.2, 2.1]),
        new("Page Views", "Traffic", 1243000, 1456000, "", "", [165, 158, 152, 148, 142, 138, 135, 130, 128, 125, 122, 124]),
        new("Support Tickets", "Support", 847, 923, "", "", [112, 108, 105, 101, 98, 95, 92, 89, 88, 86, 85, 84]),
    ];

    private static string FormatValue(double value, string prefix, string unit)
    {
        string formatted;
        if (value >= 1_000_000) formatted = $"{value / 1_000_000:F1}M";
        else if (value >= 1000) formatted = $"{value / 1000:F1}K";
        else if (value < 10 && value % 1 != 0) formatted = value.ToString("F2");
        else formatted = value.ToString("N0");
        return $"{prefix}{formatted}{unit}";
    }

    private record PointXY(double X, double Y);

    private static string GetSparklinePath(double[] data)
    {
        const int width = 100;
        const int height = 28;
        const int padding = 2;
        var min = data.Min();
        var max = data.Max();
        var range = max - min;
        if (range == 0) range = 1;

        var parts = new List<string>();
        for (var i = 0; i < data.Length; i++)
        {
            var x = padding + (double)i / (data.Length - 1) * (width - padding * 2);
            var y = height - padding - (data[i] - min) / range * (height - padding * 2);
            parts.Add(FormattableString.Invariant($"{(i == 0 ? "M" : "L")} {x:F1} {y:F1}"));
        }
        return string.Join(" ", parts);
    }

    private static PointXY GetLastPoint(double[] data)
    {
        const int width = 100;
        const int height = 28;
        const int padding = 2;
        var min = data.Min();
        var max = data.Max();
        var range = max - min;
        if (range == 0) range = 1;
        var i = data.Length - 1;
        return new PointXY(
            padding + (double)i / (data.Length - 1) * (width - padding * 2),
            height - padding - (data[i] - min) / range * (height - padding * 2)
        );
    }
}
