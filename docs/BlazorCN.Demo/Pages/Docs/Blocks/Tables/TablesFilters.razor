@* ============================================================
   Block: tables-filters
   Title: Tables Filters
   Description: Data table component with quick filter chips for instant category and status filtering
   Dependencies: BadgeCn, ButtonCn, TableCn
   Source: original/blocks/tables/tables-filters.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="space-y-3">
            <div class="flex items-center justify-between">
                <h3 class="text-sm font-medium">Filters</h3>
                @if (_activePriorities.Count > 0 || _activeStatuses.Count > 0)
                {
                    <ButtonCn Class="h-7 gap-1 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" OnClick="ClearAllFilters">
                        <LucideXCn Size="12" Class="h-3 w-3" />
                        Clear all
                    </ButtonCn>
                }
            </div>

            <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="text-xs font-medium text-muted-foreground">Priority:</span>
                    @foreach (var prio in _priorityOptions)
                    {
                        var isActive = _activePriorities.Contains(prio.Key);
                        var count = _tasks.Count(t => t.Priority == prio.Key);

                        <button class="@Cn.Merge("inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold transition-colors cursor-pointer", isActive ? prio.ActiveClass : "")" @onclick="() => TogglePriority(prio.Key)">
                            @prio.Label
                            <span class="ml-1.5 inline-flex items-center rounded-md bg-secondary px-1 py-0 text-xs text-secondary-foreground">@count</span>
                        </button>
                    }
                </div>

                <div class="flex flex-wrap items-center gap-2">
                    <span class="text-xs font-medium text-muted-foreground">Status:</span>
                    @foreach (var status in _statusOptions)
                    {
                        var isActive = _activeStatuses.Contains(status.Key);
                        var count = _tasks.Count(t => t.Status == status.Key);

                        <button class="@Cn.Merge("inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold transition-colors cursor-pointer", isActive ? status.ActiveClass : "")" @onclick="() => ToggleStatus(status.Key)">
                            @status.Label
                            <span class="ml-1.5 inline-flex items-center rounded-md bg-secondary px-1 py-0 text-xs text-secondary-foreground">@count</span>
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="flex items-center justify-between">
            <p class="text-sm text-muted-foreground">
                @_filteredTasks.Length of @_tasks.Length tasks
            </p>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="font-semibold text-foreground">Task ID</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Title</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Assignee</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Priority</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Status</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Due Date</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @if (_filteredTasks.Length == 0)
                    {
                        <TableRowCn>
                            <TableCellCn Class="h-24 text-center" colspan="6">
                                <div class="flex flex-col items-center gap-2">
                                    <p class="text-sm text-muted-foreground">No tasks match your filters</p>
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="ClearAllFilters">
                                        Clear filters
                                    </ButtonCn>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                    else
                    {
                        @foreach (var task in _filteredTasks)
                        {
                            var prioOpt = _priorityOptions.First(p => p.Key == task.Priority);
                            var statusOpt = _statusOptions.First(s => s.Key == task.Status);

                            <TableRowCn>
                                <TableCellCn Class="font-mono text-xs">@task.Id</TableCellCn>
                                <TableCellCn Class="font-medium">@task.Title</TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@task.Assignee</TableCellCn>
                                <TableCellCn>
                                    <BadgeCn Class="@prioOpt.ActiveClass" Variant="BadgeVariant.Outline">@prioOpt.Label</BadgeCn>
                                </TableCellCn>
                                <TableCellCn>
                                    <BadgeCn Class="@statusOpt.ActiveClass" Variant="BadgeVariant.Outline">@statusOpt.Label</BadgeCn>
                                </TableCellCn>
                                <TableCellCn Class="text-muted-foreground">@task.DueDate</TableCellCn>
                            </TableRowCn>
                        }
                    }
                </TableBodyCn>
            </TableCn>
        </div>
    </div>
</div>

@code {
    private record TaskItem(string Id, string Title, string Assignee, string Priority, string Status, string DueDate);
    private record FilterOption(string Key, string Label, string ActiveClass);

    private static readonly TaskItem[] _tasks =
    [
        new("TASK-001", "Update landing page design", "Alice Johnson", "high", "in-progress", "2024-01-20"),
        new("TASK-002", "Fix navigation menu bug", "Bob Smith", "urgent", "todo", "2024-01-16"),
        new("TASK-003", "Write API documentation", "Carol White", "medium", "review", "2024-01-22"),
        new("TASK-004", "Implement dark mode", "David Brown", "low", "todo", "2024-01-25"),
        new("TASK-005", "Optimize database queries", "Eve Davis", "high", "in-progress", "2024-01-18"),
        new("TASK-006", "Set up CI/CD pipeline", "Frank Miller", "medium", "done", "2024-01-15"),
        new("TASK-007", "Design mobile app mockups", "Alice Johnson", "medium", "in-progress", "2024-01-24"),
        new("TASK-008", "Security audit review", "Bob Smith", "urgent", "review", "2024-01-17"),
        new("TASK-009", "Update dependencies", "Carol White", "low", "done", "2024-01-14"),
        new("TASK-010", "Create onboarding flow", "David Brown", "high", "todo", "2024-01-21"),
    ];

    private static readonly FilterOption[] _priorityOptions =
    [
        new("low", "Low", "border-gray-200 text-gray-700 bg-gray-50"),
        new("medium", "Medium", "border-blue-200 text-blue-700 bg-blue-50"),
        new("high", "High", "border-orange-200 text-orange-700 bg-orange-50"),
        new("urgent", "Urgent", "border-red-200 text-red-700 bg-red-50"),
    ];

    private static readonly FilterOption[] _statusOptions =
    [
        new("todo", "Todo", "border-gray-200 text-gray-700"),
        new("in-progress", "In Progress", "border-blue-200 text-blue-700"),
        new("review", "Review", "border-orange-200 text-orange-700"),
        new("done", "Done", "border-green-200 text-green-700"),
    ];

    private HashSet<string> _activePriorities = new();
    private HashSet<string> _activeStatuses = new();
    private TaskItem[] _filteredTasks = _tasks;

    private void TogglePriority(string priority)
    {
        if (!_activePriorities.Remove(priority))
            _activePriorities.Add(priority);
        ApplyFilters();
    }

    private void ToggleStatus(string status)
    {
        if (!_activeStatuses.Remove(status))
            _activeStatuses.Add(status);
        ApplyFilters();
    }

    private void ClearAllFilters()
    {
        _activePriorities.Clear();
        _activeStatuses.Clear();
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        _filteredTasks = _tasks.Where(t =>
        {
            var priorityMatch = _activePriorities.Count == 0 || _activePriorities.Contains(t.Priority);
            var statusMatch = _activeStatuses.Count == 0 || _activeStatuses.Contains(t.Status);
            return priorityMatch && statusMatch;
        }).ToArray();
    }
}
