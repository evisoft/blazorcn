@* ============================================================
   Block: tables-keyboard-nav
   Title: Tables Keyboard Nav
   Description: Table component with keyboard navigation and focus management for accessible data grids
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-keyboard-nav.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Task List</h3>
                <p class="text-sm text-muted-foreground">
                    @_tasks.Length tasks - @_selectedRows.Count selected
                </p>
            </div>
            <div class="flex items-center gap-4 text-xs text-muted-foreground">
                <div class="flex items-center gap-1">
                    <kbd class="rounded border bg-muted px-1.5 py-0.5 font-mono text-[10px]">Arrow</kbd>
                    <span>Navigate</span>
                </div>
                <div class="flex items-center gap-1">
                    <kbd class="rounded border bg-muted px-1.5 py-0.5 font-mono text-[10px]">Space</kbd>
                    <span>Select</span>
                </div>
                <div class="flex items-center gap-1">
                    <kbd class="rounded border bg-muted px-1.5 py-0.5 font-mono text-[10px]">Esc</kbd>
                    <span>Clear</span>
                </div>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2"
             role="button" tabindex="0" @onkeydown="HandleKeyDown">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">ID</TableHeadCn>
                        <TableHeadCn Class="w-52 font-semibold text-foreground">Title</TableHeadCn>
                        <TableHeadCn Class="w-32 font-semibold text-foreground">Assignee</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Status</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground">Priority</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Due Date</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @for (var ri = 0; ri < _tasks.Length; ri++)
                    {
                        var rowIndex = ri;
                        var task = _tasks[rowIndex];
                        var isRowFocused = _focusedRow == rowIndex;
                        var isSelected = _selectedRows.Contains(rowIndex);
                        var (statusLabel, statusClass) = GetStatusConfig(task.Status);
                        var (prioLabel, prioVariant) = GetPriorityConfig(task.Priority);

                        <TableRowCn Class="@Cn.Merge("transition-colors", isRowFocused ? "bg-muted/50" : "", isSelected ? "bg-primary/10" : "")"
                                    @onclick="() => SetFocusedRow(rowIndex)">
                            <TableCellCn Class="@Cn.Merge("font-mono text-sm text-muted-foreground", isRowFocused && _focusedCol == 0 ? "ring-2 ring-inset ring-primary" : "")">
                                @task.Id
                            </TableCellCn>
                            <TableCellCn Class="@Cn.Merge("font-medium truncate", isRowFocused && _focusedCol == 1 ? "ring-2 ring-inset ring-primary" : "")" title="@task.Title">
                                @task.Title
                            </TableCellCn>
                            <TableCellCn Class="@Cn.Merge("text-sm", isRowFocused && _focusedCol == 2 ? "ring-2 ring-inset ring-primary" : "")">
                                @task.Assignee.Split(' ')[0]
                            </TableCellCn>
                            <TableCellCn Class="@Cn.Merge(isRowFocused && _focusedCol == 3 ? "ring-2 ring-inset ring-primary" : "")">
                                <div class="@Cn.Merge("flex items-center gap-1.5", statusClass)">
                                    @if (task.Status == "in-progress")
                                    {
                                        <LucideClockCn Size="16" Class="h-4 w-4" />
                                    }
                                    else if (task.Status == "done")
                                    {
                                        <LucideCircleCheckBigCn Size="16" Class="h-4 w-4" />
                                    }
                                    else
                                    {
                                        <LucideCircleCn Size="16" Class="h-4 w-4" />
                                    }
                                    <span class="text-sm">@statusLabel</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="@Cn.Merge(isRowFocused && _focusedCol == 4 ? "ring-2 ring-inset ring-primary" : "")">
                                <BadgeCn Variant="@prioVariant">@prioLabel</BadgeCn>
                            </TableCellCn>
                            <TableCellCn Class="@Cn.Merge("text-sm text-muted-foreground", isRowFocused && _focusedCol == 5 ? "ring-2 ring-inset ring-primary" : "")">
                                @task.DueDate
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Click table to focus, then use arrow keys to navigate. Space or Enter to select rows.
        </p>
    </div>
</div>

@code {
    private record TaskItem(string Id, string Title, string Assignee, string Status, string Priority, string DueDate);

    private static readonly TaskItem[] _tasks =
    [
        new("TSK-001", "Review pull request #142", "Sarah Chen", "in-progress", "high", "Today"),
        new("TSK-002", "Update API documentation", "Marcus Johnson", "todo", "medium", "Tomorrow"),
        new("TSK-003", "Fix login page styling", "Emily Rodriguez", "done", "low", "Jan 15"),
        new("TSK-004", "Implement search feature", "David Kim", "in-progress", "high", "Jan 18"),
        new("TSK-005", "Write unit tests for auth", "Lisa Thompson", "todo", "medium", "Jan 20"),
        new("TSK-006", "Deploy to staging server", "James Wilson", "done", "high", "Jan 14"),
        new("TSK-007", "Create user onboarding flow", "Anna Martinez", "todo", "low", "Jan 25"),
        new("TSK-008", "Optimize database queries", "Michael Brown", "in-progress", "medium", "Jan 22"),
    ];

    private int _focusedRow;
    private int _focusedCol;
    private HashSet<int> _selectedRows = new();

    private void SetFocusedRow(int row) => _focusedRow = row;

    private void HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        switch (e.Key)
        {
            case "ArrowDown":
                _focusedRow = Math.Min(_focusedRow + 1, _tasks.Length - 1);
                break;
            case "ArrowUp":
                _focusedRow = Math.Max(_focusedRow - 1, 0);
                break;
            case "ArrowRight":
                _focusedCol = Math.Min(_focusedCol + 1, 5);
                break;
            case "ArrowLeft":
                _focusedCol = Math.Max(_focusedCol - 1, 0);
                break;
            case "Home":
                if (e.CtrlKey || e.MetaKey) _focusedRow = 0;
                _focusedCol = 0;
                break;
            case "End":
                if (e.CtrlKey || e.MetaKey) _focusedRow = _tasks.Length - 1;
                _focusedCol = 5;
                break;
            case " ":
            case "Enter":
                if (!_selectedRows.Remove(_focusedRow))
                    _selectedRows.Add(_focusedRow);
                break;
            case "Escape":
                _selectedRows.Clear();
                break;
        }
    }

    private static (string Label, string ClassName) GetStatusConfig(string status) => status switch
    {
        "todo" => ("To Do", "text-muted-foreground"),
        "in-progress" => ("In Progress", "text-blue-600"),
        "done" => ("Done", "text-green-600"),
        _ => (status, ""),
    };

    private static (string Label, BadgeVariant Variant) GetPriorityConfig(string priority) => priority switch
    {
        "high" => ("High", BadgeVariant.Default),
        "medium" => ("Medium", BadgeVariant.Secondary),
        "low" => ("Low", BadgeVariant.Outline),
        _ => (priority, BadgeVariant.Secondary),
    };
}
