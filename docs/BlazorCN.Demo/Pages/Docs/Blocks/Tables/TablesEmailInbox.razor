@* ========================================
   Block: tables-email-inbox
   Title: Tables Email Inbox
   Description: Table component with email inbox layout showing sender, subject, preview and timestamps for React email client interfaces
   Long Description: Table component with click-to-edit cells and input validation for React spreadsheet interfaces
   Dependencies: AvatarCn, BadgeCn, CheckboxCn, TableCn, LucidePaperclipCn, LucideStarCn
   Source: original/blocks/tables/tables-email-inbox.tsx
   ======================================== *@

<section class="container mx-auto py-16">
    <div style="width: 900px">
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-semibold">Inbox</h3>
                    <p class="text-sm text-muted-foreground">
                        @_emails.Length messages@(_unreadCount > 0 ? $" \u00b7 {_unreadCount} unread" : "")
                    </p>
                </div>
                @if (_selected.Count > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary">@_selected.Count selected</BadgeCn>
                }
            </div>

            <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
                <TableCn Class="table-fixed" style="width: 850px">
                    <TableHeaderCn>
                        <TableRowCn>
                            <TableHeadCn Class="w-10">
                                <CheckboxCn
                                    Checked="@(_selected.Count == _emails.Length)"
                                    CheckedChanged="@ToggleSelectAll" />
                            </TableHeadCn>
                            <TableHeadCn Class="w-8"></TableHeadCn>
                            <TableHeadCn Class="w-44 font-semibold text-foreground">From</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground">Subject</TableHeadCn>
                            <TableHeadCn Class="w-20 font-semibold text-foreground text-right">
                                Date
                            </TableHeadCn>
                        </TableRowCn>
                    </TableHeaderCn>
                    <TableBodyCn>
                        @foreach (var email in _emails)
                        {
                            <TableRowCn Class="@(Cn.Merge("cursor-pointer hover:bg-muted/50", email.IsUnread ? "bg-primary/5" : "", _selected.Contains(email.Id) ? "bg-primary/10" : ""))">
                                <TableCellCn>
                                    <CheckboxCn
                                        Checked="@(_selected.Contains(email.Id))"
                                        CheckedChanged="@(() => ToggleSelect(email.Id))" />
                                </TableCellCn>
                                <TableCellCn>
                                    <ButtonCn
                                        Type="button"
                                        Variant="ButtonVariant.Ghost"
                                        Size="ButtonSize.IconSm"
                                        @onclick="@(() => ToggleStar(email.Id))">
                                        <LucideStarCn Size="16" Class="@(Cn.Merge("h-4 w-4", _starred.Contains(email.Id) ? "fill-yellow-400 text-yellow-400" : "text-muted-foreground/40 hover:text-muted-foreground"))" />
                                    </ButtonCn>
                                </TableCellCn>
                                <TableCellCn>
                                    <div class="flex items-center gap-2">
                                        <AvatarCn Class="h-7 w-7">
                                            <AvatarFallbackCn Class="text-[10px]">
                                                @GetInitials(email.SenderName)
                                            </AvatarFallbackCn>
                                        </AvatarCn>
                                        <span class="@(Cn.Merge("text-sm truncate", email.IsUnread ? "font-semibold" : ""))">
                                            @email.SenderName
                                        </span>
                                    </div>
                                </TableCellCn>
                                <TableCellCn>
                                    <div class="flex items-center gap-2 min-w-0">
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center gap-2">
                                                <span class="@(Cn.Merge("text-sm truncate", email.IsUnread ? "font-semibold" : ""))">
                                                    @email.Subject
                                                </span>
                                                @if (email.HasAttachment)
                                                {
                                                    <LucidePaperclipCn Size="14" Class="h-3.5 w-3.5 text-muted-foreground flex-shrink-0" />
                                                }
                                            </div>
                                            <p class="text-xs text-muted-foreground truncate">@email.Preview</p>
                                        </div>
                                        <div class="flex items-center gap-1 flex-shrink-0">
                                            @foreach (var label in email.Labels.Take(2))
                                            {
                                                <BadgeCn
                                                    Class="@Cn.Merge(Cn.Merge("text-[10px] px-1.5 py-0", GetLabelClass(label)))"
                                                    Variant="BadgeVariant.Secondary">
                                                    @label
                                                </BadgeCn>
                                            }
                                        </div>
                                    </div>
                                </TableCellCn>
                                <TableCellCn Class="text-right">
                                    <span class="@(Cn.Merge("text-xs", email.IsUnread ? "font-medium text-foreground" : "text-muted-foreground"))">
                                        @email.Timestamp
                                    </span>
                                </TableCellCn>
                            </TableRowCn>
                        }
                    </TableBodyCn>
                </TableCn>
            </div>

            <div class="flex items-center gap-6 text-xs text-muted-foreground">
                <div class="flex items-center gap-1.5">
                    <div class="h-2 w-2 rounded-full bg-primary"></div>
                    <span>Unread</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideStarCn Size="14" Class="h-3.5 w-3.5 fill-yellow-400 text-yellow-400" />
                    <span>Starred</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucidePaperclipCn Size="14" Class="h-3.5 w-3.5" />
                    <span>Has attachment</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record EmailItem(string Id, string SenderName, string SenderEmail, string Subject, string Preview, string Timestamp, bool IsUnread, bool IsStarred, bool HasAttachment, string[] Labels);

    private HashSet<string> _selected = new();
    private HashSet<string> _starred = new();
    private int _unreadCount => _emails.Count(e => e.IsUnread);

    private static readonly EmailItem[] _emails =
    [
        new("1", "Sarah Chen", "sarah@@company.com", "Q4 Planning Meeting Notes", "Hi team, here are the key takeaways from our planning session yesterday. Please review the action items...", "10:32 AM", true, true, true, ["work", "important"]),
        new("2", "GitHub", "noreply@@github.com", "[claude-code] New pull request #428", "mergify bot opened a pull request in anthropics/claude-code repository...", "9:15 AM", true, false, false, ["work"]),
        new("3", "Marcus Johnson", "marcus.j@@email.com", "Re: Weekend plans", "Sounds great! Let's meet at the coffee shop around 2pm. I'll bring the documents we discussed...", "Yesterday", false, false, false, ["personal"]),
        new("4", "Stripe", "receipts@@stripe.com", "Your receipt from Acme Corp", "Thank you for your payment. Your receipt for $49.00 is attached to this email...", "Yesterday", false, false, true, ["finance"]),
        new("5", "Emily Rodriguez", "emily.r@@company.com", "Design review feedback", "I've reviewed the latest mockups and have some suggestions. The hero section looks great but...", "Yesterday", true, false, true, ["work"]),
        new("6", "Delta Airlines", "no-reply@@delta.com", "Your trip confirmation - SFO to JFK", "Your booking is confirmed. Flight DL 1842 departing San Francisco on March 15...", "Mar 10", false, true, true, ["travel"]),
        new("7", "David Kim", "david.kim@@company.com", "Quick question about the API", "Hey, do you have a moment to chat about the authentication flow? I'm running into an issue with...", "Mar 10", false, false, false, ["work"]),
        new("8", "LinkedIn", "messages@@linkedin.com", "You have 3 new connection requests", "Sarah Chen, Marcus Johnson, and 1 other want to connect with you on LinkedIn...", "Mar 9", false, false, false, []),
        new("9", "Amazon", "ship-confirm@@amazon.com", "Your order has shipped!", "Great news! Your package is on its way. Track your delivery using the link below...", "Mar 8", false, false, false, ["personal"]),
        new("10", "Lisa Thompson", "lisa.t@@company.com", "Team lunch next Friday?", "Hi everyone! I'm thinking we could do a team lunch next Friday to celebrate the launch. Any preferences...", "Mar 7", false, false, false, ["work", "personal"]),
    ];

    protected override void OnInitialized()
    {
        _starred = new HashSet<string>(_emails.Where(e => e.IsStarred).Select(e => e.Id));
    }

    private void ToggleSelect(string id)
    {
        if (!_selected.Add(id))
            _selected.Remove(id);
    }

    private void ToggleSelectAll()
    {
        if (_selected.Count == _emails.Length)
            _selected.Clear();
        else
            _selected = new HashSet<string>(_emails.Select(e => e.Id));
    }

    private void ToggleStar(string id)
    {
        if (!_starred.Add(id))
            _starred.Remove(id);
    }

    private static string GetInitials(string name) =>
        string.Join("", name.Split(' ').Select(n => n[0])).ToUpper()[..Math.Min(2, name.Split(' ').Length)];

    private static string GetLabelClass(string label) => label switch
    {
        "work" => "bg-blue-100 text-blue-700 hover:bg-blue-100",
        "personal" => "bg-green-100 text-green-700 hover:bg-green-100",
        "important" => "bg-red-100 text-red-700 hover:bg-red-100",
        "finance" => "bg-purple-100 text-purple-700 hover:bg-purple-100",
        "travel" => "bg-orange-100 text-orange-700 hover:bg-orange-100",
        _ => ""
    };
}
