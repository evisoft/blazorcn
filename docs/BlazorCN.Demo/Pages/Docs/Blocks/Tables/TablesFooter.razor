@* ============================================================
   Block: tables-footer
   Title: Tables Footer
   Description: Data table component with summary footer displaying aggregated totals and averages
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-footer.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <p class="text-sm text-muted-foreground">
                @_invoices.Length invoices (@_paidCount paid)
            </p>
            <div class="flex items-center gap-4">
                <div class="text-right">
                    <p class="text-xs text-muted-foreground">Total Billed</p>
                    <p class="text-lg font-semibold">@_totalAmount.ToString("C0")</p>
                </div>
                <div class="text-right">
                    <p class="text-xs text-muted-foreground">Avg Rate</p>
                    <p class="text-lg font-semibold">@($"${_averageRate:F0}")/hr</p>
                </div>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="font-semibold text-foreground">Invoice</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Client</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Service</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground text-right">Hours</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground text-right">Rate</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground text-right">Amount</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Status</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var invoice in _invoices)
                    {
                        var (statusLabel, statusClass) = GetStatusBadge(invoice.Status);

                        <TableRowCn>
                            <TableCellCn Class="font-mono text-xs">@invoice.Id</TableCellCn>
                            <TableCellCn Class="font-medium">@invoice.Client</TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@invoice.Service</TableCellCn>
                            <TableCellCn Class="text-right">@invoice.Hours</TableCellCn>
                            <TableCellCn Class="text-right font-mono">@($"${invoice.Rate}")</TableCellCn>
                            <TableCellCn Class="text-right font-mono font-semibold">@invoice.Amount.ToString("N0")</TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@statusClass" Variant="BadgeVariant.Outline">@statusLabel</BadgeCn>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
                <TableFooterCn>
                    <TableRowCn Class="bg-muted/50">
                        <TableCellCn Class="font-semibold" colspan="3">Total (@_invoices.Length invoices)</TableCellCn>
                        <TableCellCn Class="text-right font-bold">@_totalHours</TableCellCn>
                        <TableCellCn Class="text-right font-mono text-sm text-muted-foreground">Avg @($"${_averageRate:F0}")</TableCellCn>
                        <TableCellCn Class="text-right font-mono text-base font-bold">@_totalAmount.ToString("C0")</TableCellCn>
                        <TableCellCn Class="text-sm text-muted-foreground">@_paidCount paid</TableCellCn>
                    </TableRowCn>
                </TableFooterCn>
            </TableCn>
        </div>
    </div>
</div>

@code {
    private record Invoice(string Id, string Client, string Service, int Hours, int Rate, double Amount, string Status);

    private static readonly Invoice[] _invoices =
    [
        new("INV-001", "Acme Corp", "Web Development", 40, 150, 6000, "paid"),
        new("INV-002", "TechStart Inc", "UI/UX Design", 25, 125, 3125, "paid"),
        new("INV-003", "MegaCorp Ltd", "Consulting", 15, 200, 3000, "pending"),
        new("INV-004", "StartUp Co", "App Development", 60, 150, 9000, "overdue"),
        new("INV-005", "Enterprise LLC", "Web Development", 35, 150, 5250, "paid"),
        new("INV-006", "Global Industries", "SEO Optimization", 20, 100, 2000, "pending"),
        new("INV-007", "Digital Agency", "Brand Strategy", 30, 175, 5250, "paid"),
        new("INV-008", "Local Business", "Social Media", 12, 100, 1200, "paid"),
    ];

    private static readonly int _totalHours = _invoices.Sum(i => i.Hours);
    private static readonly double _totalAmount = _invoices.Sum(i => i.Amount);
    private static readonly double _averageRate = _invoices.Average(i => i.Rate);
    private static readonly int _paidCount = _invoices.Count(i => i.Status == "paid");

    private static (string Label, string ClassName) GetStatusBadge(string status) => status switch
    {
        "paid" => ("Paid", "border-green-200 text-green-700"),
        "pending" => ("Pending", "border-orange-200 text-orange-700"),
        "overdue" => ("Overdue", "border-red-200 text-red-700"),
        _ => (status, ""),
    };
}
