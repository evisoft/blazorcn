@* ============================================================
   Block: tables-ssl-certificates
   Title: TablesSslCertificates
   Description: Track SSL certificate expiry dates with auto-renewal status for React/Next.js infrastructure dashboards built with shadcn/ui and Tailwind CSS
   Source: original/blocks/tables/tables-ssl-certificates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <h3 class="text-sm font-medium">SSL Certificates</h3>
                    <p class="text-xs text-muted-foreground">@_certificates.Length certificates</p>
                </div>
            </div>
            @if (_attentionCount > 0)
            {
                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal border-amber-200 text-amber-700 gap-1">
                    <LucideIconCn Name="triangle-alert" Size="10" Class="size-2.5" />
                    @_attentionCount need attention
                </BadgeCn>
            }
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Domain</TableHeadCn>
                    <TableHeadCn Class="w-24 text-xs font-medium text-muted-foreground">Issuer</TableHeadCn>
                    <TableHeadCn Class="w-12 text-xs font-medium text-muted-foreground">Type</TableHeadCn>
                    <TableHeadCn Class="w-20 text-xs font-medium text-muted-foreground">Status</TableHeadCn>
                    <TableHeadCn Class="w-24 text-xs font-medium text-muted-foreground">
                        <button type="button" class="flex items-center gap-1" @onclick="ToggleSort">
                            Expires
                            @if (_sortDir == "asc")
                            {
                                <LucideIconCn Name="chevron-up" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                            }
                        </button>
                    </TableHeadCn>
                    <TableHeadCn Class="w-20 text-xs font-medium text-muted-foreground text-right">Auto-Renew</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var cert in _sorted)
                {
                    var statusInfo = GetStatusConfig(cert.Status);
                    <TableRowCn Class="@Cn.Merge("hover:bg-muted/50", cert.Status == "expired" ? "bg-red-500/5" : "")">
                        <TableCellCn>
                            <span class="font-mono text-sm">@cert.Domain</span>
                        </TableCellCn>
                        <TableCellCn Class="text-xs text-muted-foreground">@cert.Issuer</TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal">
                                @cert.Type
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"text-[10px] font-normal {statusInfo.ClassName}")">
                                @statusInfo.Label
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn>
                            <div>
                                <p class="@Cn.Merge("font-mono text-sm tabular-nums", cert.DaysRemaining <= 0 ? "text-red-600 font-medium" : cert.DaysRemaining <= 14 ? "text-amber-600 font-medium" : "text-muted-foreground")">
                                    @(cert.DaysRemaining <= 0 ? $"{Math.Abs(cert.DaysRemaining)}d overdue" : $"{cert.DaysRemaining}d left")
                                </p>
                                <p class="text-[10px] text-muted-foreground">@cert.ValidTo</p>
                            </div>
                        </TableCellCn>
                        <TableCellCn Class="text-right">
                            @if (cert.AutoRenew)
                            {
                                <div class="flex items-center justify-end gap-1 text-green-600">
                                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                                    <span class="text-xs">On</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-muted-foreground">Off</span>
                            }
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record SslCertificate(string Id, string Domain, string Issuer, string Type,
        string ValidFrom, string ValidTo, int DaysRemaining, bool AutoRenew, string Status);

    private record StatusConfig(string Label, string ClassName);

    private static readonly SslCertificate[] _certificates =
    [
        new("1", "example.com", "Let's Encrypt", "DV", "Jan 24, 2026", "Apr 24, 2026", 29, true, "valid"),
        new("2", "*.example.com", "Let's Encrypt", "DV", "Jan 24, 2026", "Apr 24, 2026", 29, true, "valid"),
        new("3", "api.example.com", "DigiCert", "OV", "Jun 15, 2025", "Jun 15, 2026", 81, false, "valid"),
        new("4", "app.example.com", "Let's Encrypt", "DV", "Dec 20, 2025", "Mar 28, 2026", 2, true, "expiring"),
        new("5", "docs.example.com", "Cloudflare", "DV", "Feb 1, 2026", "Aug 1, 2026", 128, true, "valid"),
        new("6", "staging.example.com", "Let's Encrypt", "DV", "Sep 15, 2025", "Mar 15, 2026", -11, false, "expired"),
        new("7", "shop.example.com", "DigiCert", "EV", "Jan 1, 2026", "Jan 1, 2027", 281, false, "valid"),
        new("8", "mail.example.com", "Let's Encrypt", "DV", "Mar 10, 2026", "Jun 8, 2026", 74, true, "valid"),
    ];

    private static readonly int _attentionCount =
        _certificates.Count(c => c.Status == "expiring" || c.Status == "expired");

    private string _sortDir = "asc";

    private SslCertificate[] _sorted =>
        _sortDir == "asc"
            ? [.. _certificates.OrderBy(c => c.DaysRemaining)]
            : [.. _certificates.OrderByDescending(c => c.DaysRemaining)];

    private void ToggleSort()
    {
        _sortDir = _sortDir == "asc" ? "desc" : "asc";
    }

    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        "valid" => new("Valid", "bg-green-500/10 text-green-700"),
        "expiring" => new("Expiring", "bg-amber-500/10 text-amber-700"),
        "expired" => new("Expired", "bg-red-500/10 text-red-700"),
        "pending" => new("Pending", "bg-blue-500/10 text-blue-700"),
        _ => new("Unknown", ""),
    };
}
