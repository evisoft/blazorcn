@* ============================================================
   Block: tables-customer-segments
   Title: TablesCustomerSegments
   Description: Customer segment analysis table with user counts, revenue metrics, and growth tracking. Built for React marketing dashboards with Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/tables/tables-customer-segments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Customer Segments</h3>
                <p class="text-xs text-muted-foreground">
                    @_segments.Length segments &middot; @_totalUsers.ToString("N0") total users
                </p>
            </div>
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideUsersCn Size="14" Class="size-3.5" />
                <span>Updated in real-time</span>
            </div>
        </div>
        <TableCn Class="w-full">
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Segment</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Criteria</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">
                        <button type="button" class="flex items-center gap-1" @onclick="@(() => HandleSort(SortKey.UserCount))">
                            Users @GetSortIcon(SortKey.UserCount)
                        </button>
                    </TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">
                        <button type="button" class="flex items-center gap-1" @onclick="@(() => HandleSort(SortKey.AvgRevenue))">
                            Avg Revenue @GetSortIcon(SortKey.AvgRevenue)
                        </button>
                    </TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground text-right">
                        <button type="button" class="flex items-center gap-1 ml-auto" @onclick="@(() => HandleSort(SortKey.Growth))">
                            Growth @GetSortIcon(SortKey.Growth)
                        </button>
                    </TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var segment in GetSorted())
                {
                    <TableRowCn Class="hover:bg-muted/50">
                        <TableCellCn>
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("size-2 rounded-full", segment.Color)"></span>
                                <div>
                                    <p class="text-sm font-medium">@segment.Name</p>
                                    <p class="text-xs text-muted-foreground">@segment.Description</p>
                                </div>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex flex-wrap gap-1">
                                @foreach (var criterion in segment.Criteria)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-mono font-normal">@criterion</BadgeCn>
                                }
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="text-sm font-medium tabular-nums">@segment.UserCount.ToString("N0")</span>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="text-sm tabular-nums">@(segment.AvgRevenue > 0 ? $"${segment.AvgRevenue.ToString("N0")}" : "—")</span>
                        </TableCellCn>
                        <TableCellCn Class="text-right">
                            <div class="flex items-center justify-end gap-1">
                                @if (segment.Growth > 0)
                                {
                                    <LucideArrowUpCn Size="12" Class="size-3 text-green-600" />
                                }
                                else if (segment.Growth < 0)
                                {
                                    <LucideArrowDownCn Size="12" Class="size-3 text-red-600" />
                                }
                                <span class="@Cn.Merge("text-sm font-medium tabular-nums", segment.Growth > 0 ? "text-green-600" : segment.Growth < 0 ? "text-red-600" : "text-muted-foreground")">
                                    @(segment.Growth > 0 ? "+" : "")@(segment.Growth)%
                                </span>
                            </div>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private enum SortKey { UserCount, AvgRevenue, Growth }

    private record Segment(string Id, string Name, string Description, string Color, int UserCount, int AvgRevenue, double Growth, string[] Criteria, string LastUpdated);

    private static readonly Segment[] _segments =
    [
        new("1", "Enterprise",     "Companies with 500+ employees",    "bg-blue-500",   342,  12400, 12.5,  ["employees > 500", "plan = enterprise"],             "Mar 24, 2026"),
        new("2", "High Value",     "Users with LTV above $5,000",      "bg-emerald-500",1247,  8200,  8.3,  ["ltv > 5000", "active = true"],                      "Mar 24, 2026"),
        new("3", "At Risk",        "No login in last 30 days",         "bg-red-500",    456,   2100, -5.2,  ["last_login > 30d", "subscription = active"],         "Mar 24, 2026"),
        new("4", "New Users",      "Signed up in last 7 days",         "bg-purple-500", 189,      0, 23.1,  ["created_at < 7d"],                                   "Mar 24, 2026"),
        new("5", "Power Users",    "Daily active with 50+ actions",    "bg-amber-500",  873,   6500, 15.7,  ["dau = true", "actions > 50"],                        "Mar 24, 2026"),
        new("6", "Free Tier",      "Users on free plan",               "bg-slate-500",  4521,     0,  3.8,  ["plan = free"],                                       "Mar 23, 2026"),
        new("7", "Trial Expired",  "Trial ended without conversion",   "bg-orange-500", 267,      0,-12.4,  ["trial_end < today", "plan = none"],                  "Mar 23, 2026"),
    ];

    private int _totalUsers = _segments.Sum(s => s.UserCount);

    private SortKey _sortKey = SortKey.UserCount;
    private bool _sortDesc = true;

    private void HandleSort(SortKey key)
    {
        if (_sortKey == key)
            _sortDesc = !_sortDesc;
        else
        {
            _sortKey = key;
            _sortDesc = true;
        }
    }

    private IEnumerable<Segment> GetSorted()
    {
        IEnumerable<Segment> ordered = _sortKey switch
        {
            SortKey.UserCount  => _sortDesc ? _segments.OrderByDescending(s => s.UserCount)  : _segments.OrderBy(s => s.UserCount),
            SortKey.AvgRevenue => _sortDesc ? _segments.OrderByDescending(s => s.AvgRevenue) : _segments.OrderBy(s => s.AvgRevenue),
            SortKey.Growth     => _sortDesc ? _segments.OrderByDescending(s => s.Growth)     : _segments.OrderBy(s => s.Growth),
            _ => _segments,
        };
        return ordered;
    }

    private RenderFragment GetSortIcon(SortKey key)
    {
        if (_sortKey != key)
            return builder => { };
        return _sortDesc
            ? @<LucideChevronDownCn Size="12" Class="size-3" />
            : @<LucideChevronUpCn Size="12" Class="size-3" />;
    }
}
