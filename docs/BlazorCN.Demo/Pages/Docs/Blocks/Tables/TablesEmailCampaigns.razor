@* ============================================================
   Block: tables-email-campaigns
   Title: TablesEmailCampaigns
   Description: React email campaign table with metrics and performance tracking for Next.js dashboards built with shadcn/ui and Tailwind CSS
   Source: original/blocks/tables/tables-email-campaigns.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Email Campaigns</h3>
                <p class="text-xs text-muted-foreground">
                    @_sentCount sent &middot; @_scheduledCount scheduled
                </p>
            </div>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="text-xs text-muted-foreground">Campaign</TableHeadCn>
                    <TableHeadCn Class="w-20 text-xs text-muted-foreground">Status</TableHeadCn>
                    <TableHeadCn Class="w-20 text-xs text-muted-foreground">Sent</TableHeadCn>
                    <TableHeadCn Class="w-20 text-xs text-muted-foreground">
                        <button type="button" class="flex items-center gap-1" @onclick="@(() => HandleSort("opened"))">
                            Open %
                            @if (_sortKey == "opened")
                            {
                                @if (_sortDir == "desc")
                                {
                                    <LucideChevronDownCn Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideChevronUpCn Size="12" Class="size-3" />
                                }
                            }
                        </button>
                    </TableHeadCn>
                    <TableHeadCn Class="w-20 text-xs text-muted-foreground">
                        <button type="button" class="flex items-center gap-1" @onclick="@(() => HandleSort("clicked"))">
                            Click %
                            @if (_sortKey == "clicked")
                            {
                                @if (_sortDir == "desc")
                                {
                                    <LucideChevronDownCn Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideChevronUpCn Size="12" Class="size-3" />
                                }
                            }
                        </button>
                    </TableHeadCn>
                    <TableHeadCn Class="w-20 text-right text-xs text-muted-foreground">
                        <button type="button" class="flex items-center gap-1 ml-auto" @onclick="@(() => HandleSort("revenue"))">
                            Revenue
                            @if (_sortKey == "revenue")
                            {
                                @if (_sortDir == "desc")
                                {
                                    <LucideChevronDownCn Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideChevronUpCn Size="12" Class="size-3" />
                                }
                            }
                        </button>
                    </TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var campaign in GetSorted())
                {
                    var openRate = campaign.Delivered > 0
                        ? ((double)campaign.Opened / campaign.Delivered * 100).ToString("F1")
                        : "0.0";
                    var clickRate = campaign.Delivered > 0
                        ? ((double)campaign.Clicked / campaign.Delivered * 100).ToString("F1")
                        : "0.0";
                    var statusInfo = GetStatusInfo(campaign.Status);
                    <TableRowCn Class="@Cn.Merge("hover:bg-muted/50", campaign.Status != "sent" ? "opacity-60" : "")">
                        <TableCellCn>
                            <div>
                                <p class="text-sm font-medium">@campaign.Name</p>
                                <p class="text-xs text-muted-foreground truncate max-w-56">@campaign.Subject</p>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] font-normal", statusInfo.ClassName)">
                                @statusInfo.Label
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn Class="font-mono text-xs tabular-nums">
                            @campaign.SentTo.ToString("N0")
                        </TableCellCn>
                        <TableCellCn>
                            @if (campaign.Status == "sent")
                            {
                                <div class="flex items-center gap-1">
                                    <LucideMailOpenCn Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="@Cn.Merge("font-mono text-sm tabular-nums", double.Parse(openRate) >= 40 ? "text-green-600 font-medium" : "")">
                                        @openRate%
                                    </span>
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-muted-foreground">&mdash;</span>
                            }
                        </TableCellCn>
                        <TableCellCn>
                            @if (campaign.Status == "sent")
                            {
                                <div class="flex items-center gap-1">
                                    <LucideMousePointerClickCn Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="@Cn.Merge("font-mono text-sm tabular-nums", double.Parse(clickRate) >= 20 ? "text-green-600 font-medium" : "")">
                                        @clickRate%
                                    </span>
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-muted-foreground">&mdash;</span>
                            }
                        </TableCellCn>
                        <TableCellCn Class="text-right">
                            @if (campaign.Revenue > 0)
                            {
                                <span class="font-mono text-sm font-medium tabular-nums">$@campaign.Revenue.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="text-xs text-muted-foreground">&mdash;</span>
                            }
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record Campaign(string Id, string Name, string Subject, string Status, int SentTo, int Delivered, int Opened, int Clicked, int Bounced, int Unsubscribed, int Revenue, string SentAt);

    private record StatusInfo(string Label, string ClassName);

    private static readonly Campaign[] _campaigns =
    [
        new("1", "March Newsletter", "What's new in March 2026", "sent", 24500, 24012, 8644, 2161, 488, 34, 12400, "Mar 24, 2026"),
        new("2", "Product Launch", "Introducing V3: A complete redesign", "sent", 18200, 17846, 9280, 4462, 354, 12, 45600, "Mar 20, 2026"),
        new("3", "Win-back Campaign", "We miss you — here's 20% off", "sent", 5600, 5432, 1630, 489, 168, 89, 3200, "Mar 18, 2026"),
        new("4", "Webinar Invite", "Join us: Auth patterns for SaaS", "sent", 12400, 12152, 4861, 1822, 248, 8, 0, "Mar 15, 2026"),
        new("5", "Feature Update", "Dark mode, shortcuts & more", "sent", 22100, 21658, 7580, 3032, 442, 21, 8900, "Mar 12, 2026"),
        new("6", "April Newsletter", "Your April product digest", "scheduled", 25000, 0, 0, 0, 0, 0, 0, "Apr 1, 2026"),
    ];

    private static readonly int _sentCount = _campaigns.Count(c => c.Status == "sent");
    private static readonly int _scheduledCount = _campaigns.Count(c => c.Status == "scheduled");

    private string _sortKey = "revenue";
    private string _sortDir = "desc";

    private void HandleSort(string key)
    {
        if (_sortKey == key)
            _sortDir = _sortDir == "desc" ? "asc" : "desc";
        else
        {
            _sortKey = key;
            _sortDir = "desc";
        }
    }

    private IEnumerable<Campaign> GetSorted()
    {
        var sorted = _campaigns.OrderBy(c => GetSortValue(c, _sortKey));
        return _sortDir == "desc" ? sorted.Reverse() : sorted;
    }

    private static int GetSortValue(Campaign c, string key) => key switch
    {
        "opened" => c.Opened,
        "clicked" => c.Clicked,
        "revenue" => c.Revenue,
        _ => 0
    };

    private static StatusInfo GetStatusInfo(string status) => status switch
    {
        "sent" => new("Sent", "bg-green-500/10 text-green-700"),
        "sending" => new("Sending", "bg-blue-500/10 text-blue-700"),
        "draft" => new("Draft", "bg-slate-500/10 text-slate-700"),
        "scheduled" => new("Scheduled", "bg-amber-500/10 text-amber-700"),
        _ => new("Unknown", "")
    };
}
