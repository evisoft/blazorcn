@* ============================================================
   Block: tables-editable-cells
   Title: Tables Editable Cells
   Description: Table component with click-to-edit cells and input validation for React spreadsheet interfaces
   Long Description: Table component with drag-and-drop row reordering and visual drop indicators for React list management
   Dependencies: InputCn, TableCn
   Source: original/blocks/tables/tables-editable-cells.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <div style="width: 900px">
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-semibold">Budget Planning</h3>
                    <p class="text-sm text-muted-foreground">
                        Click any cell to edit. Tab to navigate.
                    </p>
                </div>
                <div class="text-right">
                    <p class="text-sm text-muted-foreground">Annual Total</p>
                    <p class="text-xl font-bold">@FormatCurrency(_grandTotal)</p>
                </div>
            </div>

            <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
                <TableCn Class="table-fixed" style="width: 850px">
                    <TableHeaderCn>
                        <TableRowCn>
                            <TableHeadCn Class="w-36 font-semibold text-foreground">Category</TableHeadCn>
                            @foreach (var col in _columnKeys)
                            {
                                <TableHeadCn Class="w-28 text-right font-semibold text-foreground">
                                    @_columnLabels[col]
                                </TableHeadCn>
                            }
                            <TableHeadCn Class="w-32 text-right font-semibold text-foreground">
                                Row Total
                            </TableHeadCn>
                        </TableRowCn>
                    </TableHeaderCn>
                    <TableBodyCn>
                        @for (var rowIdx = 0; rowIdx < _data.Length; rowIdx++)
                        {
                            var item = _data[rowIdx];
                            var rowTotal = item.Q1 + item.Q2 + item.Q3 + item.Q4;
                            <TableRowCn>
                                <TableCellCn Class="font-medium">@item.Category</TableCellCn>
                                @foreach (var col in _columnKeys)
                                {
                                    var cellValue = GetQuarterValue(item, col);
                                    <TableCellCn Class="text-right p-0 cursor-pointer hover:bg-muted/50">
                                        <div class="px-4 py-2 font-mono">@FormatCurrency(cellValue)</div>
                                    </TableCellCn>
                                }
                                <TableCellCn Class="text-right font-mono font-semibold bg-muted/30">
                                    @FormatCurrency(rowTotal)
                                </TableCellCn>
                            </TableRowCn>
                        }
                    </TableBodyCn>
                    <TableFooterCn>
                        <TableRowCn Class="bg-muted/50">
                            <TableCellCn Class="font-semibold">Total</TableCellCn>
                            @foreach (var col in _columnKeys)
                            {
                                <TableCellCn Class="text-right font-mono font-bold">
                                    @FormatCurrency(_data.Sum(d => GetQuarterValue(d, col)))
                                </TableCellCn>
                            }
                            <TableCellCn Class="text-right font-mono font-bold">
                                @FormatCurrency(_grandTotal)
                            </TableCellCn>
                        </TableRowCn>
                    </TableFooterCn>
                </TableCn>
            </div>

            <p class="text-xs text-muted-foreground">
                Press Enter to save, Escape to cancel, Tab to move to next cell
            </p>
        </div>
    </div>
</section>

@code {
    private record BudgetItem(string Id, string Category, int Q1, int Q2, int Q3, int Q4);

    private static readonly string[] _columnKeys = ["q1", "q2", "q3", "q4"];

    private static readonly Dictionary<string, string> _columnLabels = new()
    {
        ["q1"] = "Q1 2024",
        ["q2"] = "Q2 2024",
        ["q3"] = "Q3 2024",
        ["q4"] = "Q4 2024",
    };

    private static readonly BudgetItem[] _data =
    [
        new("1", "Marketing", 45_000, 52_000, 48_000, 65_000),
        new("2", "Engineering", 120_000, 125_000, 130_000, 135_000),
        new("3", "Sales", 85_000, 92_000, 88_000, 110_000),
        new("4", "Operations", 35_000, 36_000, 38_000, 40_000),
        new("5", "HR", 28_000, 29_000, 30_000, 32_000),
        new("6", "Legal", 15_000, 15_000, 18_000, 20_000),
    ];

    private int _grandTotal => _data.Sum(d => d.Q1 + d.Q2 + d.Q3 + d.Q4);

    private static int GetQuarterValue(BudgetItem item, string col) => col switch
    {
        "q1" => item.Q1,
        "q2" => item.Q2,
        "q3" => item.Q3,
        "q4" => item.Q4,
        _ => 0
    };

    private static string FormatCurrency(int value) => value.ToString("C0");
}
