@* ============================================================
   Block: tables-employee-directory
   Title: Tables Employee Directory
   Description: Table component with employee directory showing profiles, departments, contact info and reporting structure
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-employee-directory.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Employee Directory</h3>
                <p class="text-sm text-muted-foreground">
                    @_employees.Length employees across @_departmentCount departments
                </p>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Class="gap-1" Variant="BadgeVariant.Outline">
                    <LucideUsersCn Size="12" Class="h-3 w-3" />
                    @_activeCount active
                </BadgeCn>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-52 font-semibold text-foreground">Employee</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Department</TableHeadCn>
                        <TableHeadCn Class="w-40 font-semibold text-foreground">Contact</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Location</TableHeadCn>
                        <TableHeadCn Class="w-32 font-semibold text-foreground">Reports To</TableHeadCn>
                        <TableHeadCn Class="w-16"></TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var emp in _employees)
                    {
                        var status = GetStatusConfig(emp.Status);

                        <TableRowCn>
                            <TableCellCn>
                                <div class="flex items-center gap-3">
                                    <div class="relative">
                                        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-muted text-xs font-medium">
                                            @GetInitials(emp.Name)
                                        </div>
                                        <div class="@Cn.Merge("absolute -bottom-0.5 -right-0.5 h-3 w-3 rounded-full border-2 border-card", status.ClassName)"
                                             title="@status.Label"></div>
                                    </div>
                                    <div class="min-w-0">
                                        <p class="font-medium text-sm truncate">@emp.Name</p>
                                        <p class="text-xs text-muted-foreground truncate">@emp.Title</p>
                                    </div>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@Cn.Merge("text-xs", GetDeptColor(emp.Department))" Variant="BadgeVariant.Secondary">
                                    @emp.Department
                                </BadgeCn>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="space-y-1">
                                    <a class="flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors"
                                       href="@($"mailto:{emp.Email}")">
                                        <LucideMailCn Size="12" Class="h-3 w-3" />
                                        <span class="truncate">@emp.EmailShort</span>
                                    </a>
                                    <a class="flex items-center gap-1.5 text-xs text-muted-foreground hover:text-foreground transition-colors"
                                       href="@($"tel:{emp.Phone}")">
                                        <LucidePhoneCn Size="12" Class="h-3 w-3" />
                                        <span>@emp.Phone</span>
                                    </a>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-1.5 text-sm text-muted-foreground">
                                    <LucideMapPinCn Size="14" Class="h-3.5 w-3.5" />
                                    <span class="truncate">@emp.Location</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                @if (emp.Manager is not null)
                                {
                                    <div class="flex items-center gap-1.5 text-sm">
                                        <LucideUserCn Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                                        <span class="truncate">@emp.Manager</span>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-xs text-muted-foreground">&mdash;</span>
                                }
                            </TableCellCn>
                            <TableCellCn>
                                @if (emp.DirectReports > 0)
                                {
                                    <div class="flex items-center gap-1 text-xs text-muted-foreground" title="@($"{emp.DirectReports} direct reports")">
                                        <LucideUsersCn Size="14" Class="h-3.5 w-3.5" />
                                        <span>@emp.DirectReports</span>
                                    </div>
                                }
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex items-center gap-6 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
                <div class="h-2.5 w-2.5 rounded-full bg-green-500"></div>
                <span>Active</span>
            </div>
            <div class="flex items-center gap-1.5">
                <div class="h-2.5 w-2.5 rounded-full bg-blue-500"></div>
                <span>Remote</span>
            </div>
            <div class="flex items-center gap-1.5">
                <div class="h-2.5 w-2.5 rounded-full bg-yellow-500"></div>
                <span>On Leave</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideBuilding2Cn Size="14" Class="h-3.5 w-3.5" />
                <span>@_departmentCount departments</span>
            </div>
        </div>
    </div>
</div>

@code {
    private record Employee(string Id, string Name, string Title, string Department, string Email, string EmailShort, string Phone, string Location, string? Manager, string Status, int DirectReports);

    private static readonly Employee[] _employees =
    [
        new("1", "Sarah Chen", "VP of Engineering", "Engineering", "sarah.chen@company.com", "sarah.chen", "+1 555-0101", "San Francisco", null, "active", 12),
        new("2", "Marcus Johnson", "Senior Software Engineer", "Engineering", "marcus.j@company.com", "marcus.j", "+1 555-0102", "San Francisco", "Sarah Chen", "active", 0),
        new("3", "Emily Rodriguez", "Product Designer", "Design", "emily.r@company.com", "emily.r", "+1 555-0103", "New York", "David Kim", "remote", 0),
        new("4", "David Kim", "Head of Design", "Design", "david.kim@company.com", "david.kim", "+1 555-0104", "New York", null, "active", 5),
        new("5", "Lisa Thompson", "Marketing Manager", "Marketing", "lisa.t@company.com", "lisa.t", "+1 555-0105", "Chicago", "James Wilson", "on_leave", 3),
        new("6", "James Wilson", "CMO", "Marketing", "james.w@company.com", "james.w", "+1 555-0106", "Chicago", null, "active", 8),
        new("7", "Anna Martinez", "Sales Representative", "Sales", "anna.m@company.com", "anna.m", "+1 555-0107", "Austin", "Robert Taylor", "active", 0),
        new("8", "Robert Taylor", "Sales Director", "Sales", "robert.t@company.com", "robert.t", "+1 555-0108", "Austin", null, "remote", 6),
        new("9", "Jennifer Lee", "HR Specialist", "HR", "jennifer.l@company.com", "jennifer.l", "+1 555-0109", "San Francisco", "Michael Brown", "active", 0),
        new("10", "Michael Brown", "HR Director", "HR", "michael.b@company.com", "michael.b", "+1 555-0110", "San Francisco", null, "active", 4),
    ];

    private static readonly int _activeCount = _employees.Count(e => e.Status == "active");
    private static readonly int _departmentCount = _employees.Select(e => e.Department).Distinct().Count();

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();

    private static string GetDeptColor(string dept) => dept switch
    {
        "Engineering" => "bg-blue-100 text-blue-700 hover:bg-blue-100",
        "Design" => "bg-purple-100 text-purple-700 hover:bg-purple-100",
        "Marketing" => "bg-green-100 text-green-700 hover:bg-green-100",
        "Sales" => "bg-orange-100 text-orange-700 hover:bg-orange-100",
        "HR" => "bg-pink-100 text-pink-700 hover:bg-pink-100",
        "Finance" => "bg-cyan-100 text-cyan-700 hover:bg-cyan-100",
        _ => "",
    };

    private static (string Label, string ClassName) GetStatusConfig(string status) => status switch
    {
        "active" => ("Active", "bg-green-500"),
        "remote" => ("Remote", "bg-blue-500"),
        "on_leave" => ("On Leave", "bg-yellow-500"),
        _ => ("Offline", "bg-gray-400"),
    };
}
