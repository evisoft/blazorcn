@* ============================================================
   Block: tables-sticky-header
   Title: Tables Sticky Header
   Description: Data table component with sticky header that stays fixed while scrolling for long datasets
   Dependencies: BadgeCn
   Source: original/blocks/tables/tables-sticky-header.tsx
   ============================================================ *@

@{
    var thClass = "sticky top-0 z-10 bg-card h-10 px-3 text-left align-middle font-semibold text-foreground whitespace-nowrap border-b";
    var tdClass = "p-3 align-middle whitespace-nowrap";
}

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <p class="text-sm text-muted-foreground">@_transactions.Length transactions</p>
            <p class="text-sm text-muted-foreground">Scroll to see sticky header</p>
        </div>

        <div class="max-h-96 overflow-auto rounded-lg border border-border bg-card shadow-sm" tabindex="0" role="group" aria-label="Transactions table">
            <table class="w-full caption-bottom text-sm" style="width: 850px">
                <thead>
                    <tr>
                        <th class="@thClass">ID</th>
                        <th class="@thClass">Date</th>
                        <th class="@thClass">Description</th>
                        <th class="@thClass">Category</th>
                        <th class="@thClass">Amount</th>
                        <th class="@thClass">Status</th>
                    </tr>
                </thead>
                <tbody class="[&_tr:last-child]:border-0">
                    @foreach (var tx in _transactions)
                    {
                        var (statusLabel, statusClass) = GetStatusConfig(tx.Status);

                        <tr class="border-b transition-colors hover:bg-muted/50">
                            <td class="@Cn.Merge(tdClass, "font-mono text-xs")">@tx.Id</td>
                            <td class="@Cn.Merge(tdClass, "text-muted-foreground")">@tx.Date</td>
                            <td class="@Cn.Merge(tdClass, "font-medium")">@tx.Description</td>
                            <td class="@Cn.Merge(tdClass, "text-muted-foreground")">@tx.Category</td>
                            <td class="@Cn.Merge(tdClass, "font-mono font-semibold")">$@tx.Amount.ToString("N0")</td>
                            <td class="@tdClass">
                                <BadgeCn Class="@statusClass" Variant="BadgeVariant.Outline">@statusLabel</BadgeCn>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private record Transaction(string Id, string Date, string Description, string Category, int Amount, string Status);

    private static readonly int[] _amounts = [1250, 499, 3200, 875, 156, 2100, 1800, 425, 2750, 680, 1450, 920, 3100, 275, 1875, 560, 2400, 1100, 750, 1950, 380, 2600, 1350, 890, 2200, 475, 1650, 720, 2850, 1025];

    private static readonly string[] _descriptions = ["Office Supplies Purchase", "Monthly Software Subscription", "Client Invoice Payment", "Marketing Campaign Expense", "Team Lunch Meeting", "Cloud Infrastructure Costs", "Freelancer Payment", "Equipment Purchase"];
    private static readonly string[] _categories = ["Operations", "Software", "Revenue", "Marketing", "Team", "Infrastructure", "Contractors", "Equipment"];
    private static readonly string[] _statuses = ["completed", "pending", "failed"];

    private static readonly Transaction[] _transactions = Enumerable.Range(0, 30).Select(i => new Transaction(
        $"TXN{(i + 1).ToString().PadLeft(4, '0')}",
        $"Jan {i / 2 + 1}, 2024",
        _descriptions[i % 8],
        _categories[i % 8],
        _amounts[i],
        _statuses[i % 3]
    )).ToArray();

    private static (string Label, string ClassName) GetStatusConfig(string status) => status switch
    {
        "completed" => ("Completed", "border-green-200 text-green-700"),
        "pending" => ("Pending", "border-orange-200 text-orange-700"),
        "failed" => ("Failed", "border-red-200 text-red-700"),
        _ => (status, ""),
    };
}
