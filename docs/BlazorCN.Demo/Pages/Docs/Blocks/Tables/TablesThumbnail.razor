@* ============================================================
   Block: tables-thumbnail
   Title: Tables Thumbnail
   Description: Table component with inline image thumbnails for media galleries and content management systems
   Dependencies: BadgeCn, ButtonCn, TableCn, TooltipCn
   Source: original/blocks/tables/tables-thumbnail.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Media Library</h3>
                <p class="text-sm text-muted-foreground">
                    @_files.Length files &middot; @_imageCount images &middot; @_totalSizeMB.ToString("F1") MB total
                </p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                <LucideImageCn Size="16" Class="mr-2 h-4 w-4" />
                Upload
            </ButtonCn>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground">Preview</TableHeadCn>
                        <TableHeadCn Class="w-48 font-semibold text-foreground">Filename</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Type</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Dimensions</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground">Size</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Uploaded</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Status</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Actions</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var file in _files)
                    {
                        var (typeLabel, typeClass) = GetTypeConfig(file.FileType);
                        var (bgClass, _) = GetThumbnailConfig(file.FileType);
                        var (statusLabel, statusVariant) = GetStatusConfig(file.Status);

                        <TableRowCn>
                            <TableCellCn>
                                <TooltipCn>
                                    <TooltipTriggerCn>
                                        <div class="@Cn.Merge("flex h-12 w-16 items-center justify-center rounded-md border border-border", bgClass)">
                                            @if (file.FileType == "image")
                                            {
                                                <LucideImageCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                                            }
                                            else if (file.FileType == "video")
                                            {
                                                <LucideFileVideoCameraCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                                            }
                                            else if (file.FileType == "audio")
                                            {
                                                <LucideFileMusicCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                                            }
                                            else
                                            {
                                                <LucideFileCn Size="20" Class="h-5 w-5 text-muted-foreground" />
                                            }
                                        </div>
                                    </TooltipTriggerCn>
                                    <TooltipContentCn>
                                        <p class="font-medium">@file.Name</p>
                                        @if (file.Width.HasValue)
                                        {
                                            <p class="text-xs text-muted-foreground">@(file.Width) x @(file.Height)</p>
                                        }
                                    </TooltipContentCn>
                                </TooltipCn>
                            </TableCellCn>
                            <TableCellCn Class="font-medium truncate" title="@file.Name">@file.Name</TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@Cn.Merge("font-normal", typeClass)" Variant="BadgeVariant.Secondary">@typeLabel</BadgeCn>
                            </TableCellCn>
                            <TableCellCn Class="text-muted-foreground text-sm font-mono">
                                @(file.Width.HasValue ? $"{file.Width}x{file.Height}" : "\u2014")
                            </TableCellCn>
                            <TableCellCn Class="text-muted-foreground text-sm">@file.Size</TableCellCn>
                            <TableCellCn Class="text-muted-foreground text-sm">@file.UploadedAt</TableCellCn>
                            <TableCellCn>
                                <BadgeCn Variant="@statusVariant">@statusLabel</BadgeCn>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-1">
                                    <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Show">
                                        <LucideEyeCn Size="16" Class="h-4 w-4" />
                                    </ButtonCn>
                                    <ButtonCn Class="h-8 w-8" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" aria-label="Download">
                                        <LucideDownloadCn Size="16" Class="h-4 w-4" />
                                    </ButtonCn>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Hover over file icons to see filename and dimensions.
        </p>
    </div>
</div>

@code {
    private record MediaFile(string Id, string Name, string FileType, int? Width, int? Height, string Size, string UploadedAt, string Status);

    private static readonly MediaFile[] _files =
    [
        new("1", "hero-banner.jpg", "image", 1920, 1080, "2.4 MB", "Jan 15, 2024", "published"),
        new("2", "product-showcase.png", "image", 1200, 800, "1.8 MB", "Jan 14, 2024", "published"),
        new("3", "team-photo.jpg", "image", 2400, 1600, "3.2 MB", "Jan 13, 2024", "draft"),
        new("4", "promo-video.mp4", "video", 1920, 1080, "45.6 MB", "Jan 12, 2024", "processing"),
        new("5", "background-pattern.svg", "image", 800, 600, "24 KB", "Jan 11, 2024", "published"),
        new("6", "podcast-episode.mp3", "audio", null, null, "28.4 MB", "Jan 10, 2024", "published"),
        new("7", "feature-image.webp", "image", 1600, 900, "890 KB", "Jan 9, 2024", "published"),
        new("8", "brand-guidelines.pdf", "document", null, null, "5.2 MB", "Jan 8, 2024", "published"),
    ];

    private static readonly int _imageCount = _files.Count(f => f.FileType == "image");
    private static readonly double _totalSizeMB = _files.Sum(f =>
    {
        var num = double.Parse(System.Text.RegularExpressions.Regex.Match(f.Size, @"[\d.]+").Value);
        return f.Size.Contains("MB") ? num : f.Size.Contains("KB") ? num / 1000 : 0;
    });

    private static (string Label, string ClassName) GetTypeConfig(string type) => type switch
    {
        "image" => ("Image", "bg-blue-100 text-blue-700"),
        "video" => ("Video", "bg-purple-100 text-purple-700"),
        "audio" => ("Audio", "bg-orange-100 text-orange-700"),
        "document" => ("Document", "bg-green-100 text-green-700"),
        _ => (type, ""),
    };

    private static (string BgClass, string IconType) GetThumbnailConfig(string type) => type switch
    {
        "image" => ("bg-blue-50", "image"),
        "video" => ("bg-purple-50", "video"),
        "audio" => ("bg-orange-50", "audio"),
        "document" => ("bg-green-50", "document"),
        _ => ("bg-muted", "file"),
    };

    private static (string Label, BadgeVariant Variant) GetStatusConfig(string status) => status switch
    {
        "published" => ("Published", BadgeVariant.Default),
        "draft" => ("Draft", BadgeVariant.Secondary),
        "processing" => ("Processing", BadgeVariant.Outline),
        _ => (status, BadgeVariant.Secondary),
    };
}
