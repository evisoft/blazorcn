@* ============================================================
   Block: tables-inventory
   Title: Tables Inventory
   Description: Table component with inventory stock levels showing quantity, reorder alerts and warehouse locations
   Dependencies: BadgeCn, ButtonCn, ProgressCn, TableCn
   Source: original/blocks/tables/tables-inventory.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Inventory Overview</h3>
                <p class="text-sm text-muted-foreground">
                    @_inventory.Length products &middot; @_totalValue.ToString("C0") total value
                </p>
            </div>
            <div class="flex items-center gap-2">
                @if (_lowStockCount > 0)
                {
                    <BadgeCn Class="gap-1" Variant="BadgeVariant.Destructive">
                        <LucideAlertTriangleCn Size="12" Class="h-3 w-3" />
                        @_lowStockCount need restock
                    </BadgeCn>
                }
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground">SKU</TableHeadCn>
                        <TableHeadCn Class="w-44 font-semibold text-foreground">Product</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">Stock</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Level</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Status</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Location</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-right">Value</TableHeadCn>
                        <TableHeadCn Class="w-16"></TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var item in _inventory)
                    {
                        var status = GetStockStatus(item);
                        var (statusLabel, statusVariant, statusClass) = GetStatusConfig(status);
                        var percentage = Math.Min((double)item.Quantity / item.MaxStock * 100, 100);
                        var reorderPercentage = (double)item.ReorderPoint / item.MaxStock * 100;
                        var itemValue = item.Quantity * item.UnitCost;
                        var qtyColor = status switch
                        {
                            "out_of_stock" => "text-destructive",
                            "critical" => "text-destructive",
                            "low_stock" => "text-yellow-600",
                            _ => "",
                        };

                        <TableRowCn Class="@(status == "out_of_stock" ? "bg-destructive/5" : "")">
                            <TableCellCn Class="font-mono text-xs text-muted-foreground">@item.Sku</TableCellCn>
                            <TableCellCn>
                                <div class="space-y-0.5">
                                    <p class="font-medium text-sm truncate" title="@item.Name">@item.Name</p>
                                    <p class="text-xs text-muted-foreground">@item.Category</p>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <div class="flex items-center justify-center gap-1">
                                    <span class="@Cn.Merge("font-mono font-bold", qtyColor)">@item.Quantity</span>
                                    @if (status == "critical")
                                    {
                                        <LucideTrendingDownCn Size="12" Class="h-3 w-3 text-destructive" />
                                    }
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="relative w-24" title="@($"{item.Quantity} / {item.MaxStock} units - Reorder at {item.ReorderPoint}")">
                                    <ProgressCn Value="@((int)percentage)" Class="h-2" />
                                    <div class="absolute top-0 h-2 w-0.5 bg-destructive/60" style="@($"left: {reorderPercentage}%")"></div>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@Cn.Merge("text-xs", statusClass)" Variant="@statusVariant">@statusLabel</BadgeCn>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-1 text-sm text-muted-foreground">
                                    <LucideMapPinCn Size="12" Class="h-3 w-3" />
                                    <span class="truncate">@item.Warehouse</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <span class="font-mono text-sm">@itemValue.ToString("C0")</span>
                            </TableCellCn>
                            <TableCellCn>
                                @if (status is "low_stock" or "critical" or "out_of_stock")
                                {
                                    <ButtonCn Class="h-7 w-7 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" title="Reorder stock">
                                        <LucideRefreshCwCn Size="14" Class="h-3.5 w-3.5" />
                                    </ButtonCn>
                                }
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex items-center gap-6 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
                <LucidePackageCn Size="14" Class="h-3.5 w-3.5 text-green-600" />
                <span>In stock</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideAlertTriangleCn Size="14" Class="h-3.5 w-3.5 text-yellow-600" />
                <span>Below reorder point</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideBoxCn Size="14" Class="h-3.5 w-3.5 text-destructive" />
                <span>Out of stock</span>
            </div>
            <div class="flex items-center gap-1.5">
                <div class="h-2 w-0.5 bg-destructive/60"></div>
                <span>Reorder threshold</span>
            </div>
        </div>
    </div>
</div>

@code {
    private record InventoryItem(string Id, string Sku, string Name, string Category, int Quantity, int ReorderPoint, int MaxStock, string Warehouse, double UnitCost, string LastRestocked);

    private static readonly InventoryItem[] _inventory =
    [
        new("1", "WH-1001", "Wireless Headphones Pro", "Electronics", 145, 50, 200, "Warehouse A", 89.99, "3 days ago"),
        new("2", "KB-2045", "Mechanical Keyboard RGB", "Electronics", 23, 30, 150, "Warehouse A", 129.99, "1 week ago"),
        new("3", "MS-3012", "Ergonomic Mouse", "Electronics", 8, 25, 100, "Warehouse B", 49.99, "2 weeks ago"),
        new("4", "MN-4023", "27\" 4K Monitor", "Electronics", 0, 15, 50, "Warehouse A", 399.99, "1 month ago"),
        new("5", "CH-5067", "Office Chair Premium", "Furniture", 67, 20, 80, "Warehouse C", 299.99, "5 days ago"),
        new("6", "DS-6078", "Standing Desk Frame", "Furniture", 12, 15, 40, "Warehouse C", 449.99, "2 weeks ago"),
        new("7", "WC-7089", "HD Webcam 1080p", "Electronics", 234, 100, 300, "Warehouse B", 79.99, "1 day ago"),
        new("8", "HS-8034", "USB-C Hub 7-in-1", "Accessories", 5, 40, 200, "Warehouse A", 39.99, "3 weeks ago"),
        new("9", "LP-9045", "Laptop Stand Aluminum", "Accessories", 89, 30, 120, "Warehouse B", 59.99, "4 days ago"),
        new("10", "CB-1056", "Braided USB-C Cable 2m", "Accessories", 456, 200, 500, "Warehouse A", 14.99, "2 days ago"),
    ];

    private static readonly double _totalValue = _inventory.Sum(i => i.Quantity * i.UnitCost);
    private static readonly int _lowStockCount = _inventory.Count(i => GetStockStatus(i) is "low_stock" or "critical" or "out_of_stock");

    private static string GetStockStatus(InventoryItem item)
    {
        if (item.Quantity == 0) return "out_of_stock";
        if (item.Quantity <= item.ReorderPoint * 0.5) return "critical";
        if (item.Quantity <= item.ReorderPoint) return "low_stock";
        return "in_stock";
    }

    private static (string Label, BadgeVariant Variant, string ClassName) GetStatusConfig(string status) => status switch
    {
        "in_stock" => ("In Stock", BadgeVariant.Default, "bg-green-100 text-green-700 hover:bg-green-100"),
        "low_stock" => ("Low Stock", BadgeVariant.Secondary, "bg-yellow-100 text-yellow-700 hover:bg-yellow-100"),
        "critical" => ("Critical", BadgeVariant.Destructive, ""),
        "out_of_stock" => ("Out of Stock", BadgeVariant.Outline, "border-destructive text-destructive"),
        _ => ("Unknown", BadgeVariant.Secondary, ""),
    };
}
