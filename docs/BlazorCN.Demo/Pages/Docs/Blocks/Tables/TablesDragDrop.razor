@* ============================================================
   Block: tables-drag-drop
   Title: Tables Drag Drop
   Description: Table component with drag-and-drop row reordering for list management
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-drag-drop.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <p class="text-sm text-muted-foreground">
                @_queue.Length items in queue. Drag to reorder priority.
            </p>
            <p class="text-xs text-muted-foreground">Drop position updates automatically</p>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-12"></TableHeadCn>
                        <TableHeadCn Class="w-12 font-semibold text-foreground">#</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Title</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Type</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground">Priority</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Assignee</TableHeadCn>
                        <TableHeadCn Class="w-16 font-semibold text-foreground">Est.</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var item in _queue)
                    {
                        <TableRowCn>
                            <TableCellCn Class="cursor-grab active:cursor-grabbing">
                                <LucideGripVerticalCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                            </TableCellCn>
                            <TableCellCn Class="font-mono text-xs text-muted-foreground">@item.Position</TableCellCn>
                            <TableCellCn Class="font-medium">@item.Title</TableCellCn>
                            <TableCellCn>
                                @{
                                    var (typeLabel, typeClass, typeVariant) = GetTypeBadge(item.Type);
                                }
                                <BadgeCn Class="@typeClass" Variant="@typeVariant">@typeLabel</BadgeCn>
                            </TableCellCn>
                            <TableCellCn>
                                @{
                                    var (prioLabel, prioClass, prioVariant) = GetPriorityBadge(item.Priority);
                                }
                                <BadgeCn Class="@prioClass" Variant="@prioVariant">@prioLabel</BadgeCn>
                            </TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@item.Assignee</TableCellCn>
                            <TableCellCn Class="font-mono text-xs text-muted-foreground">@item.Estimate</TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>
    </div>
</div>

@code {
    private record QueueItem(string Id, int Position, string Title, string Type, string Priority, string Assignee, string Estimate);

    private static readonly QueueItem[] _queue =
    [
        new("1", 1, "Implement user authentication", "feature", "high", "Sarah Chen", "3d"),
        new("2", 2, "Fix login redirect loop", "bug", "high", "Alex Kim", "4h"),
        new("3", 3, "Add dark mode support", "feature", "medium", "Jordan Lee", "2d"),
        new("4", 4, "Optimize database queries", "improvement", "medium", "Taylor Smith", "1d"),
        new("5", 5, "Write API documentation", "task", "low", "Morgan Davis", "6h"),
        new("6", 6, "Update dependencies", "task", "low", "Casey Wilson", "2h"),
        new("7", 7, "Add email notifications", "feature", "medium", "Riley Brown", "1d"),
        new("8", 8, "Fix mobile layout issues", "bug", "high", "Jamie Garcia", "4h"),
    ];

    private static (string Label, string ClassName, BadgeVariant Variant) GetTypeBadge(string type) => type switch
    {
        "feature" => ("Feature", "border-purple-200 text-purple-700", BadgeVariant.Outline),
        "bug" => ("Bug", "border-red-200 text-red-700", BadgeVariant.Outline),
        "improvement" => ("Improvement", "border-blue-200 text-blue-700", BadgeVariant.Outline),
        _ => ("Task", "", BadgeVariant.Secondary),
    };

    private static (string Label, string ClassName, BadgeVariant Variant) GetPriorityBadge(string priority) => priority switch
    {
        "high" => ("High", "border-red-200 text-red-700", BadgeVariant.Outline),
        "medium" => ("Medium", "border-orange-200 text-orange-700", BadgeVariant.Outline),
        _ => ("Low", "", BadgeVariant.Secondary),
    };
}
