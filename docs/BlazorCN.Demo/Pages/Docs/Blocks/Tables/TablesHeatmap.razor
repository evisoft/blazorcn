@* ============================================================
   Block: tables-heatmap
   Title: Tables Heatmap
   Description: Table component with color-intensity heatmap cells for visualizing data density
   Dependencies: TableCn
   Source: original/blocks/tables/tables-heatmap.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Weekly Traffic Pattern</h3>
                <p class="text-sm text-muted-foreground">Visitor count by hour and day</p>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs text-muted-foreground">@_minValue</span>
                <div class="flex">
                    <div class="h-4 w-6 bg-blue-50"></div>
                    <div class="h-4 w-6 bg-blue-100"></div>
                    <div class="h-4 w-6 bg-blue-300"></div>
                    <div class="h-4 w-6 bg-blue-500"></div>
                    <div class="h-4 w-6 bg-blue-700"></div>
                </div>
                <span class="text-xs text-muted-foreground">@_maxValue</span>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground">Time</TableHeadCn>
                        @foreach (var label in _columnLabels)
                        {
                            <TableHeadCn Class="w-20 text-center font-semibold text-foreground">@label</TableHeadCn>
                        }
                        <TableHeadCn Class="w-20 text-center font-semibold text-foreground">Total</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @for (var rowIndex = 0; rowIndex < _data.Length; rowIndex++)
                    {
                        var row = _data[rowIndex];
                        var rowTotal = _rowTotals[rowIndex];

                        <TableRowCn Class="hover:bg-transparent">
                            <TableCellCn Class="font-medium text-muted-foreground">@row.RowLabel</TableCellCn>
                            @for (var colIndex = 0; colIndex < row.Values.Length; colIndex++)
                            {
                                var value = row.Values[colIndex];
                                var col = colIndex;

                                <TableCellCn Class="@Cn.Merge("text-center font-mono text-sm transition-colors", GetIntensityColor(value))">
                                    <div class="group relative">
                                        @value
                                        <div class="absolute bottom-full left-1/2 mb-2 hidden -translate-x-1/2 group-hover:block z-10">
                                            <div class="rounded bg-popover px-2 py-1 text-xs shadow-md border whitespace-nowrap text-foreground">
                                                <div class="font-medium">@_columnLabels[col] at @row.RowLabel</div>
                                                <div class="text-muted-foreground">@value visitors</div>
                                            </div>
                                        </div>
                                    </div>
                                </TableCellCn>
                            }
                            <TableCellCn Class="text-center font-mono text-sm font-semibold bg-muted/50">@rowTotal</TableCellCn>
                        </TableRowCn>
                    }
                    @* Totals row *@
                    <TableRowCn Class="bg-muted/50 hover:bg-muted/50">
                        <TableCellCn Class="font-semibold">Total</TableCellCn>
                        @foreach (var total in _columnTotals)
                        {
                            <TableCellCn Class="text-center font-mono text-sm font-semibold">@total</TableCellCn>
                        }
                        <TableCellCn Class="text-center font-mono text-sm font-bold">@_columnTotals.Sum()</TableCellCn>
                    </TableRowCn>
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Hover over cells to see detailed information
        </p>
    </div>
</div>

@code {
    private record HeatmapRow(string RowLabel, int[] Values);

    private static readonly string[] _columnLabels = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];

    private static readonly HeatmapRow[] _data =
    [
        new("12 AM", [2, 1, 3, 2, 1, 8, 12]),
        new("3 AM", [1, 0, 1, 1, 0, 4, 6]),
        new("6 AM", [15, 18, 14, 16, 12, 8, 5]),
        new("9 AM", [45, 52, 48, 55, 42, 25, 18]),
        new("12 PM", [62, 58, 65, 60, 55, 42, 35]),
        new("3 PM", [58, 55, 52, 58, 48, 38, 32]),
        new("6 PM", [35, 32, 38, 34, 28, 45, 48]),
        new("9 PM", [22, 18, 24, 20, 15, 52, 55]),
    ];

    private static readonly int _minValue = _data.SelectMany(r => r.Values).Min();
    private static readonly int _maxValue = _data.SelectMany(r => r.Values).Max();

    private static readonly int[] _columnTotals = Enumerable.Range(0, 7)
        .Select(col => _data.Sum(r => r.Values[col]))
        .ToArray();

    private static readonly int[] _rowTotals = _data.Select(r => r.Values.Sum()).ToArray();

    private static string GetIntensityColor(int value)
    {
        var normalized = (double)(value - _minValue) / (_maxValue - _minValue);
        return normalized switch
        {
            < 0.2 => "bg-blue-50 text-blue-900",
            < 0.4 => "bg-blue-100 text-blue-900",
            < 0.6 => "bg-blue-300 text-blue-900",
            < 0.8 => "bg-blue-500 text-white",
            _ => "bg-blue-700 text-white",
        };
    }
}
