@* ============================================================
   Block: tables-badge-count
   Title: Tables Badge Count
   Description: Table component with numeric badge counters showing quantities and metrics for inventory dashboards
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-badge-count.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Inventory Overview</h3>
                <p class="text-sm text-muted-foreground">
                    @_products.Length products &middot; @_totalItems.ToString("N0") total items
                </p>
            </div>
            <div class="flex items-center gap-4 text-sm">
                @if (_outOfStock > 0)
                {
                    <div class="flex items-center gap-1.5">
                        <div class="h-2 w-2 rounded-full bg-red-500"></div>
                        <span class="text-muted-foreground">@_outOfStock out of stock</span>
                    </div>
                }
                @if (_lowStock > 0)
                {
                    <div class="flex items-center gap-1.5">
                        <div class="h-2 w-2 rounded-full bg-yellow-500"></div>
                        <span class="text-muted-foreground">@_lowStock low stock</span>
                    </div>
                }
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-40 font-semibold text-foreground">Product</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground">SKU</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Category</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">
                            <div class="flex items-center gap-1">
                                <LucidePackageCn Size="16" Class="h-4 w-4" />
                                In Stock
                            </div>
                        </TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">Reserved</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">Incoming</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Total Sold</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var product in _products)
                    {
                        var rowClass = product.InStock == 0
                            ? "bg-red-50/50"
                            : product.InStock > 0 && product.InStock <= product.ReorderPoint
                                ? "bg-yellow-50/30"
                                : "";
                        <TableRowCn Class="@rowClass">
                            <TableCellCn Class="font-medium truncate" title="@product.Name">
                                @product.Name
                            </TableCellCn>
                            <TableCellCn Class="font-mono text-sm text-muted-foreground">
                                @product.Sku
                            </TableCellCn>
                            <TableCellCn Class="text-sm text-muted-foreground">
                                @product.Category
                            </TableCellCn>
                            <TableCellCn>
                                @if (product.InStock == 0)
                                {
                                    <div class="flex items-center gap-2">
                                        <BadgeCn Class="tabular-nums font-medium min-w-[2rem] justify-center bg-red-100 text-red-700 hover:bg-red-100" Variant="BadgeVariant.Secondary">0</BadgeCn>
                                        <span class="text-xs font-medium text-destructive">Out of stock</span>
                                    </div>
                                }
                                else if (product.InStock <= product.ReorderPoint)
                                {
                                    <div class="flex items-center gap-2">
                                        <BadgeCn Class="tabular-nums font-medium min-w-[2rem] justify-center bg-yellow-100 text-yellow-700 hover:bg-yellow-100" Variant="BadgeVariant.Secondary">@product.InStock</BadgeCn>
                                        <LucideAlertTriangleCn Size="14" Class="h-3.5 w-3.5 text-yellow-600" />
                                    </div>
                                }
                                else
                                {
                                    <BadgeCn Class="tabular-nums font-medium min-w-[2rem] justify-center bg-green-100 text-green-700 hover:bg-green-100" Variant="BadgeVariant.Secondary">@FormatCount(product.InStock)</BadgeCn>
                                }
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                @if (product.Reserved == 0)
                                {
                                    <span class="text-muted-foreground">&mdash;</span>
                                }
                                else
                                {
                                    <BadgeCn Class="tabular-nums font-medium min-w-[2rem] justify-center bg-muted text-muted-foreground hover:bg-muted" Variant="BadgeVariant.Secondary">@product.Reserved</BadgeCn>
                                }
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                @if (product.Incoming == 0)
                                {
                                    <span class="text-muted-foreground">&mdash;</span>
                                }
                                else
                                {
                                    <BadgeCn Class="tabular-nums font-medium min-w-[2rem] justify-center bg-green-100 text-green-700 hover:bg-green-100" Variant="BadgeVariant.Secondary">@product.Incoming</BadgeCn>
                                }
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <BadgeCn Class="tabular-nums font-medium min-w-[2rem] justify-center" Variant="BadgeVariant.Secondary">@FormatCount(product.Sold)</BadgeCn>
                                    @if (product.Sold > 1500)
                                    {
                                        <LucideTrendingUpCn Size="14" Class="h-3.5 w-3.5 text-green-600" />
                                    }
                                    else if (product.Sold > 800)
                                    {
                                        <LucideMinusCn Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                                    }
                                    else
                                    {
                                        <LucideTrendingDownCn Size="14" Class="h-3.5 w-3.5 text-orange-600" />
                                    }
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Yellow indicates low stock, red indicates out of stock.
        </p>
    </div>
</div>

@code {
    private record Product(string Id, string Name, string Sku, string Category, int InStock, int Reserved, int Incoming, int Sold, int ReorderPoint);

    private static readonly Product[] _products =
    [
        new("1", "Wireless Keyboard", "KB-001", "Peripherals", 245, 12, 100, 1842, 50),
        new("2", "USB-C Hub", "HB-002", "Accessories", 18, 5, 0, 956, 30),
        new("3", "Monitor Stand", "MS-003", "Furniture", 67, 0, 25, 423, 20),
        new("4", "Webcam HD", "WC-004", "Peripherals", 0, 0, 50, 2103, 25),
        new("5", "Laptop Sleeve", "LS-005", "Accessories", 312, 28, 0, 1567, 40),
        new("6", "Desk Lamp", "DL-006", "Furniture", 8, 3, 30, 789, 15),
        new("7", "Mouse Pad XL", "MP-007", "Accessories", 156, 0, 0, 2456, 35),
        new("8", "Cable Organizer", "CO-008", "Accessories", 43, 7, 100, 634, 50),
    ];

    private static readonly int _outOfStock = _products.Count(p => p.InStock == 0);
    private static readonly int _lowStock = _products.Count(p => p.InStock > 0 && p.InStock <= p.ReorderPoint);
    private static readonly int _totalItems = _products.Sum(p => p.InStock);

    private static string FormatCount(int num)
    {
        if (num >= 1_000_000) return $"{num / 1_000_000.0:F1}M";
        if (num >= 1000) return $"{num / 1000.0:F1}K";
        return num.ToString();
    }
}
