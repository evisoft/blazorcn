@* ============================================================
   Block: tables-quick-actions
   Title: Tables Quick Actions
   Description: Table component with hover quick action buttons for React data management interfaces
   Long Description: Table component with project tasks showing priorities, assignees, due dates and status columns for React project management dashboards
   Dependencies: AlertDialogCn, BadgeCn, ButtonCn, TableCn, TooltipCn
   Source: original/blocks/tables/tables-quick-actions.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <div style="width: 900px">
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-semibold">Documents</h3>
                    <p class="text-sm text-muted-foreground">
                        @documents.Length files - @starredCount starred - @sharedCount shared
                    </p>
                </div>
                <p class="text-xs text-muted-foreground">Hover rows to see quick actions</p>
            </div>

            <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
                <TableCn Class="table-fixed" style="width: 850px">
                    <TableHeaderCn>
                        <TableRowCn>
                            <TableHeadCn Class="w-64 font-semibold text-foreground">Name</TableHeadCn>
                            <TableHeadCn Class="w-20 font-semibold text-foreground">Type</TableHeadCn>
                            <TableHeadCn Class="w-24 font-semibold text-foreground">Size</TableHeadCn>
                            <TableHeadCn Class="w-28 font-semibold text-foreground">Modified</TableHeadCn>
                            <TableHeadCn Class="w-20 font-semibold text-foreground">Status</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground text-right">Actions</TableHeadCn>
                        </TableRowCn>
                    </TableHeaderCn>
                    <TableBodyCn>
                        @foreach (var doc in documents)
                        {
                            var typeCfg = GetTypeConfig(doc.Type);
                            var isHovered = _hoveredRow == doc.Id;

                            <TableRowCn Class="group">
                                <TableCellCn Class="font-medium">
                                    <div class="flex items-center gap-2">
                                        @if (doc.Starred)
                                        {
                                            <LucideStarCn Size="16" Class="fill-yellow-400 text-yellow-400" />
                                        }
                                        <span class="truncate">@doc.Name</span>
                                    </div>
                                </TableCellCn>
                                <TableCellCn>
                                    <span class="@(Cn.Merge("font-mono text-xs font-medium", typeCfg.Color))">
                                        @typeCfg.Label
                                    </span>
                                </TableCellCn>
                                <TableCellCn Class="text-sm text-muted-foreground tabular-nums">
                                    @doc.Size
                                </TableCellCn>
                                <TableCellCn Class="text-sm text-muted-foreground">@doc.Modified</TableCellCn>
                                <TableCellCn>
                                    @if (doc.Shared)
                                    {
                                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">
                                            Shared
                                        </BadgeCn>
                                    }
                                </TableCellCn>
                                <TableCellCn>
                                    <div class="flex items-center justify-end gap-1 opacity-0 transition-opacity group-hover:opacity-100">
                                        <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                            <LucideStarCn Size="16" />
                                        </ButtonCn>
                                        <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                            <LucideEditCn Size="16" />
                                        </ButtonCn>
                                        <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                            <LucideCopyCn Size="16" />
                                        </ButtonCn>
                                        <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                            <LucideDownloadCn Size="16" />
                                        </ButtonCn>
                                        <ButtonCn Class="h-8 w-8 p-0" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost">
                                            <LucideExternalLinkCn Size="16" />
                                        </ButtonCn>
                                        <AlertDialogCn>
                                            <AlertDialogTriggerCn>
                                                <ButtonCn Class="h-8 w-8 p-0 hover:bg-destructive/10 hover:text-destructive"
                                                           Size="ButtonSize.Sm"
                                                           Variant="ButtonVariant.Ghost">
                                                    <LucideTrash2Cn Size="16" />
                                                </ButtonCn>
                                            </AlertDialogTriggerCn>
                                            <AlertDialogContentCn>
                                                <AlertDialogHeaderCn>
                                                    <AlertDialogTitleCn>Delete document?</AlertDialogTitleCn>
                                                    <AlertDialogDescriptionCn>
                                                        This will permanently delete "@doc.Name". This action cannot be undone.
                                                    </AlertDialogDescriptionCn>
                                                </AlertDialogHeaderCn>
                                                <AlertDialogFooterCn>
                                                    <AlertDialogCancelCn>Cancel</AlertDialogCancelCn>
                                                    <AlertDialogActionCn Class="bg-destructive text-destructive-foreground hover:bg-destructive/90">
                                                        Delete
                                                    </AlertDialogActionCn>
                                                </AlertDialogFooterCn>
                                            </AlertDialogContentCn>
                                        </AlertDialogCn>
                                    </div>
                                </TableCellCn>
                            </TableRowCn>
                        }
                    </TableBodyCn>
                </TableCn>
            </div>

            <div class="flex items-center gap-6 text-xs text-muted-foreground">
                <div class="flex items-center gap-1.5">
                    <LucideStarCn Size="14" />
                    <span>Star to favorite</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideTrash2Cn Size="14" />
                    <span>Delete requires confirmation</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <kbd class="rounded border bg-muted px-1.5 py-0.5 font-mono text-[10px]">S</kbd>
                    <span>Keyboard shortcuts in tooltips</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string? _hoveredRow;

    private record Document(string Id, string Name, string Type, string Size, string Modified, bool Starred, bool Shared);
    private record TypeConfig(string Label, string Color);

    private static readonly Document[] documents = new[]
    {
        new Document("doc-001", "Q4 Financial Report", "pdf", "2.4 MB", "2 hours ago", true, true),
        new Document("doc-002", "Marketing Strategy 2024", "doc", "1.8 MB", "Yesterday", false, true),
        new Document("doc-003", "Sales Pipeline Analysis", "spreadsheet", "4.2 MB", "3 days ago", true, false),
        new Document("doc-004", "Product Screenshots", "image", "12.5 MB", "1 week ago", false, false),
        new Document("doc-005", "Employee Handbook", "pdf", "856 KB", "2 weeks ago", false, true),
        new Document("doc-006", "Budget Forecast", "spreadsheet", "1.1 MB", "3 weeks ago", false, false),
        new Document("doc-007", "Brand Guidelines", "pdf", "8.9 MB", "1 month ago", true, true),
        new Document("doc-008", "Meeting Notes Archive", "doc", "324 KB", "1 month ago", false, false),
    };

    private static readonly int starredCount = documents.Count(d => d.Starred);
    private static readonly int sharedCount = documents.Count(d => d.Shared);

    private static TypeConfig GetTypeConfig(string type) => type switch
    {
        "pdf" => new TypeConfig("PDF", "text-red-600"),
        "doc" => new TypeConfig("DOC", "text-blue-600"),
        "spreadsheet" => new TypeConfig("XLS", "text-green-600"),
        "image" => new TypeConfig("IMG", "text-purple-600"),
        _ => new TypeConfig(type.ToUpperInvariant(), "text-muted-foreground"),
    };
}
