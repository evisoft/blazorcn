@* ============================================================
   Block: tables-survey-results
   Title: Tables Survey Results
   Description: Table component with survey response breakdown showing question results, percentages and response distribution
   Dependencies: BadgeCn, ProgressCn, TableCn
   Source: original/blocks/tables/tables-survey-results.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Customer Feedback Survey</h3>
                <p class="text-sm text-muted-foreground">342 responses &middot; 87% completion rate</p>
            </div>
            <BadgeCn Class="gap-1" Variant="BadgeVariant.Outline">
                <LucideTrendingUpCn Size="12" Class="h-3 w-3" />
                NPS: 42
            </BadgeCn>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-12 font-semibold text-foreground text-center">#</TableHeadCn>
                        <TableHeadCn Class="w-64 font-semibold text-foreground">Question</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">Type</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Results</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground text-center">Responses</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @for (var qi = 0; qi < _questions.Length; qi++)
                    {
                        var q = _questions[qi];
                        var index = qi + 1;

                        <TableRowCn>
                            <TableCellCn Class="text-center font-mono text-muted-foreground">@index</TableCellCn>
                            <TableCellCn>
                                <p class="text-sm font-medium line-clamp-2">@q.Question</p>
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">@GetTypeLabel(q.QuestionType)</BadgeCn>
                            </TableCellCn>
                            <TableCellCn>
                                @if (q.QuestionType == "rating" && q.AverageRating.HasValue)
                                {
                                    <div class="space-y-2">
                                        <div class="flex items-center gap-2">
                                            <div class="flex items-center gap-0.5">
                                                @for (var s = 1; s <= 5; s++)
                                                {
                                                    <LucideStarCn Size="14" Class="@Cn.Merge("h-3.5 w-3.5", s <= Math.Round(q.AverageRating.Value) ? "fill-yellow-400 text-yellow-400" : "text-muted-foreground/30")" />
                                                }
                                            </div>
                                            <span class="font-mono font-bold">@q.AverageRating.Value.ToString("F1")</span>
                                        </div>
                                        @if (q.Options != null)
                                        {
                                            <div class="space-y-1.5">
                                                @foreach (var opt in q.Options.Take(3))
                                                {
                                                    <div class="flex items-center gap-2">
                                                        <span class="w-28 truncate text-xs text-muted-foreground">@opt.Label</span>
                                                        <ProgressCn Class="h-1.5 flex-1" Value="@opt.Percentage" aria-label="Progress" />
                                                        <span class="w-10 text-right font-mono text-xs">@(opt.Percentage)%</span>
                                                    </div>
                                                }
                                                @if (q.Options.Length > 3)
                                                {
                                                    <p class="text-xs text-muted-foreground">+@(q.Options.Length - 3) more options</p>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else if (q.QuestionType == "multiple_choice" && q.Options != null)
                                {
                                    <div class="space-y-1.5">
                                        @foreach (var opt in q.Options.Take(3))
                                        {
                                            <div class="flex items-center gap-2">
                                                <span class="w-28 truncate text-xs text-muted-foreground">@opt.Label</span>
                                                <ProgressCn Class="h-1.5 flex-1" Value="@opt.Percentage" aria-label="Progress" />
                                                <span class="w-10 text-right font-mono text-xs">@(opt.Percentage)%</span>
                                            </div>
                                        }
                                        @if (q.Options.Length > 3)
                                        {
                                            <p class="text-xs text-muted-foreground">+@(q.Options.Length - 3) more options</p>
                                        }
                                    </div>
                                }
                                else if (q.QuestionType == "nps" && q.NpsScore.HasValue)
                                {
                                    <div class="space-y-2">
                                        <div class="flex items-center gap-2">
                                            <LucideTrendingUpCn Size="16" Class="@Cn.Merge("h-4 w-4", q.NpsScore >= 50 ? "text-green-600" : q.NpsScore >= 0 ? "text-yellow-600" : "text-red-600")" />
                                            <span class="font-mono font-bold text-lg">@q.NpsScore</span>
                                            <span class="text-xs text-muted-foreground">NPS</span>
                                        </div>
                                        <div class="flex h-2 w-full overflow-hidden rounded-full">
                                            <div class="bg-green-500" style="@($"width: {q.Promoters}%")"></div>
                                            <div class="bg-yellow-400" style="@($"width: {q.Passives}%")"></div>
                                            <div class="bg-red-500" style="@($"width: {q.Detractors}%")"></div>
                                        </div>
                                        <div class="flex justify-between text-xs text-muted-foreground">
                                            <span>@(q.Promoters)% promoters</span>
                                            <span>@(q.Detractors)% detractors</span>
                                        </div>
                                    </div>
                                }
                                else if (q.QuestionType == "yes_no" && q.YesPercentage.HasValue)
                                {
                                    var noPercentage = 100 - q.YesPercentage.Value;
                                    <div class="space-y-2">
                                        <div class="flex items-center gap-4">
                                            <div class="flex items-center gap-1.5">
                                                <LucideThumbsUpCn Size="16" Class="h-4 w-4 text-green-600" />
                                                <span class="font-mono font-bold">@(q.YesPercentage)%</span>
                                            </div>
                                            <div class="flex items-center gap-1.5">
                                                <LucideThumbsDownCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                                                <span class="font-mono text-muted-foreground">@(noPercentage)%</span>
                                            </div>
                                        </div>
                                        <div class="flex h-2 w-full overflow-hidden rounded-full bg-muted">
                                            <div class="bg-green-500" style="@($"width: {q.YesPercentage}%")"></div>
                                        </div>
                                    </div>
                                }
                                else if (q.QuestionType == "open_text")
                                {
                                    <div class="flex items-center gap-2">
                                        <LucideMessageSquareCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                                        <span class="text-sm">@q.TotalResponses text responses</span>
                                        <BadgeCn Class="text-xs" Variant="BadgeVariant.Outline">View all</BadgeCn>
                                    </div>
                                }
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <span class="font-mono font-medium">@q.TotalResponses</span>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex items-center gap-6 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
                <LucideStarCn Size="14" Class="h-3.5 w-3.5 fill-yellow-400 text-yellow-400" />
                <span>Rating questions</span>
            </div>
            <div class="flex items-center gap-1.5">
                <div class="flex h-2 w-8 overflow-hidden rounded-full">
                    <div class="w-1/2 bg-green-500"></div>
                    <div class="w-1/4 bg-yellow-400"></div>
                    <div class="w-1/4 bg-red-500"></div>
                </div>
                <span>NPS breakdown</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideThumbsUpCn Size="14" Class="h-3.5 w-3.5 text-green-600" />
                <span>Yes/No responses</span>
            </div>
        </div>
    </div>
</div>

@code {
    private record ChoiceOption(string Label, int Count, int Percentage);

    private record SurveyQuestion(string Id, string Question, string QuestionType, int TotalResponses,
        ChoiceOption[]? Options = null, double? AverageRating = null, int? NpsScore = null,
        int? Promoters = null, int? Passives = null, int? Detractors = null, int? YesPercentage = null);

    private static readonly SurveyQuestion[] _questions =
    [
        new("q1", "How satisfied are you with our product?", "rating", 342,
            Options: [new("5 Stars", 156, 46), new("4 Stars", 98, 29), new("3 Stars", 54, 16), new("2 Stars", 21, 6), new("1 Star", 13, 4)],
            AverageRating: 4.2),
        new("q2", "Which features do you use most often?", "multiple_choice", 328,
            Options: [new("Dashboard Analytics", 245, 75), new("Report Builder", 198, 60), new("Team Collaboration", 156, 48), new("API Integration", 89, 27), new("Mobile App", 67, 20)]),
        new("q3", "How likely are you to recommend us?", "nps", 315,
            NpsScore: 42, Promoters: 58, Passives: 26, Detractors: 16),
        new("q4", "Was the onboarding process helpful?", "yes_no", 298, YesPercentage: 84),
        new("q5", "What improvements would you suggest?", "open_text", 187),
        new("q6", "How would you rate our customer support?", "rating", 256,
            Options: [new("5 Stars", 167, 65), new("4 Stars", 56, 22), new("3 Stars", 23, 9), new("2 Stars", 7, 3), new("1 Star", 3, 1)],
            AverageRating: 4.6),
    ];

    private static string GetTypeLabel(string type) => type switch
    {
        "multiple_choice" => "Choice",
        "rating" => "Rating",
        "nps" => "NPS",
        "yes_no" => "Yes/No",
        "open_text" => "Text",
        _ => type,
    };
}
