@* ============================================================
   Block: tables-datetime
   Title: Tables Datetime
   Description: Table component with formatted datetime cells and relative time indicators for activity dashboards
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-datetime.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Activity Log</h3>
                <p class="text-sm text-muted-foreground">@_activities.Length events this week</p>
            </div>
            <div class="flex items-center gap-2 text-sm text-muted-foreground">
                <LucideClockCn Size="16" Class="h-4 w-4" />
                <span>Last updated: Just now</span>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-12"></TableHeadCn>
                        <TableHeadCn Class="w-40 font-semibold text-foreground">Action</TableHeadCn>
                        <TableHeadCn Class="w-56 font-semibold text-foreground">Description</TableHeadCn>
                        <TableHeadCn Class="w-44 font-semibold text-foreground">User</TableHeadCn>
                        <TableHeadCn Class="w-32 font-semibold text-foreground">
                            <div class="flex items-center gap-1">
                                <LucideCalendarCn Size="16" Class="h-4 w-4" />
                                <span>Timestamp</span>
                            </div>
                        </TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Type</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var activity in _activities)
                    {
                        <TableRowCn>
                            <TableCellCn>
                                <div class="@Cn.Merge("flex h-8 w-8 items-center justify-center rounded-full bg-muted", GetTypeIconClass(activity.Type))">
                                    @GetTypeIcon(activity.Type)
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="font-medium">@activity.Action</TableCellCn>
                            <TableCellCn Class="text-muted-foreground truncate" title="@activity.Description">
                                @activity.Description
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <LucideUserCn Size="16" Class="h-4 w-4 text-muted-foreground" />
                                    <span class="text-sm truncate" title="@activity.User">@activity.UserShort</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex flex-col">
                                    <span class="text-sm font-medium">@activity.RelativeTime</span>
                                    <span class="text-xs text-muted-foreground">@activity.AbsoluteDate</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                @{
                                    var (typeLabel, typeVariant) = GetTypeBadgeConfig(activity.Type);
                                }
                                <BadgeCn Variant="@typeVariant">@typeLabel</BadgeCn>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Recent events show relative time. Older events show absolute dates.
        </p>
    </div>
</div>

@code {
    private record ActivityEvent(string Id, string Action, string Description, string User, string UserShort, string RelativeTime, string AbsoluteDate, string Type);

    private static readonly ActivityEvent[] _activities =
    [
        new("1", "User Login", "Logged in from Chrome on macOS", "sarah.chen@example.com", "sarah.chen", "2 min ago", "Jan 15, 2024", "login"),
        new("2", "Document Created", "Created Q1 Financial Report", "marcus.johnson@example.com", "marcus.johnson", "15 min ago", "Jan 15, 2024", "create"),
        new("3", "Settings Updated", "Changed notification preferences", "sarah.chen@example.com", "sarah.chen", "45 min ago", "Jan 15, 2024", "settings"),
        new("4", "Record Deleted", "Removed draft invoice #1234", "emily.rodriguez@example.com", "emily.rodriguez", "2 hours ago", "Jan 15, 2024", "delete"),
        new("5", "Data Exported", "Exported customer list to CSV", "david.kim@example.com", "david.kim", "5 hours ago", "Jan 15, 2024", "export"),
        new("6", "Profile Updated", "Updated profile photo and bio", "lisa.thompson@example.com", "lisa.thompson", "Yesterday", "Jan 14, 2024", "update"),
        new("7", "User Login", "Logged in from Safari on iOS", "james.wilson@example.com", "james.wilson", "2 days ago", "Jan 13, 2024", "login"),
        new("8", "Document Created", "Created Team Onboarding Guide", "anna.martinez@example.com", "anna.martinez", "5 days ago", "Jan 10, 2024", "create"),
    ];

    private static RenderFragment GetTypeIcon(string type) => type switch
    {
        "create" => @<LucideFileTextCn Size="16" Class="h-4 w-4" />,
        "update" => @<LucideSettingsCn Size="16" Class="h-4 w-4" />,
        "delete" => @<LucideDatabaseCn Size="16" Class="h-4 w-4" />,
        "login" => @<LucideShieldCn Size="16" Class="h-4 w-4" />,
        "export" => @<LucideMailCn Size="16" Class="h-4 w-4" />,
        "settings" => @<LucideSettingsCn Size="16" Class="h-4 w-4" />,
        _ => @<LucideCircleCn Size="16" Class="h-4 w-4" />,
    };

    private static string GetTypeIconClass(string type) => type switch
    {
        "create" => "text-green-600",
        "update" => "text-primary",
        "delete" => "text-destructive",
        "login" => "text-primary",
        "export" => "text-orange-600",
        "settings" => "text-muted-foreground",
        _ => "",
    };

    private static (string Label, BadgeVariant Variant) GetTypeBadgeConfig(string type) => type switch
    {
        "create" => ("Create", BadgeVariant.Default),
        "update" => ("Update", BadgeVariant.Secondary),
        "delete" => ("Delete", BadgeVariant.Destructive),
        "login" => ("Login", BadgeVariant.Outline),
        "export" => ("Export", BadgeVariant.Secondary),
        "settings" => ("Settings", BadgeVariant.Outline),
        _ => ("Other", BadgeVariant.Secondary),
    };
}
