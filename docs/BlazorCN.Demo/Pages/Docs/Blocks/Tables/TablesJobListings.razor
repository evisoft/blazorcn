@* ============================================================
   Block: tables-job-listings
   Title: Tables Job Listings
   Description: Table component with job listings showing positions, departments, locations, salary ranges and application counts
   Dependencies: BadgeCn, ButtonCn, TableCn, TableBodyCn, TableCellCn, TableHeadCn, TableHeaderCn, TableRowCn, TooltipCn, TooltipContentCn, TooltipTriggerCn, LucideBanknoteCn, LucideBriefcaseCn, LucideBuilding2Cn, LucideClockCn, LucideGlobeCn, LucideMapPinCn, LucideUsersCn, LucideZapCn
   Source: original/blocks/tables/tables-job-listings.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <div style="width: 900px">
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-semibold">Open Positions</h3>
                    <p class="text-sm text-muted-foreground">
                        @_jobs.Length roles &#183; @_jobs.Count(j => j.WorkArrangement == "remote") remote
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <BadgeCn Class="gap-1" Variant="BadgeVariant.Outline">
                        <LucideZapCn Size="12" Class="text-orange-500" />
                        @_jobs.Count(j => j.IsUrgent) urgent
                    </BadgeCn>
                </div>
            </div>

            <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
                <TableCn Class="table-fixed" style="width: 850px">
                    <TableHeaderCn>
                        <TableRowCn>
                            <TableHeadCn Class="w-56 font-semibold text-foreground">Position</TableHeadCn>
                            <TableHeadCn Class="w-28 font-semibold text-foreground">Location</TableHeadCn>
                            <TableHeadCn Class="w-24 font-semibold text-foreground">Level</TableHeadCn>
                            <TableHeadCn Class="w-28 font-semibold text-foreground">Salary</TableHeadCn>
                            <TableHeadCn Class="w-24 font-semibold text-foreground">Posted</TableHeadCn>
                            <TableHeadCn Class="w-20 font-semibold text-foreground text-center">Applicants</TableHeadCn>
                            <TableHeadCn Class="w-20"></TableHeadCn>
                        </TableRowCn>
                    </TableHeaderCn>
                    <TableBodyCn>
                        @foreach (var job in _jobs)
                        {
                            var deptColor = GetDepartmentColor(job.Department);
                            var arrangementLabel = job.WorkArrangement switch { "remote" => "Remote", "hybrid" => "Hybrid", _ => "On-site" };
                            var expLabel = job.ExperienceLevel switch { "entry" => "Entry Level", "mid" => "Mid Level", "senior" => "Senior", "lead" => "Lead", _ => "Executive" };
                            <TableRowCn>
                                <TableCellCn>
                                    <div class="space-y-1">
                                        <div class="flex items-center gap-2">
                                            <span class="font-medium text-sm">@job.Title</span>
                                            @if (job.IsNew)
                                            {
                                                <BadgeCn Class="text-[10px] px-1.5 py-0 bg-green-100 text-green-700 hover:bg-green-100" Variant="BadgeVariant.Secondary">New</BadgeCn>
                                            }
                                            @if (job.IsUrgent)
                                            {
                                                <TooltipCn>
                                                    <TooltipTriggerCn>
                                                        <LucideZapCn Size="14" Class="text-orange-500 fill-orange-500" />
                                                    </TooltipTriggerCn>
                                                    <TooltipContentCn>Urgent hire</TooltipContentCn>
                                                </TooltipCn>
                                            }
                                        </div>
                                        <BadgeCn Class="@Cn.Merge($"text-xs {deptColor}")" Variant="BadgeVariant.Secondary">@job.Department</BadgeCn>
                                    </div>
                                </TableCellCn>
                                <TableCellCn>
                                    <div class="space-y-1">
                                        <p class="text-sm truncate">@job.Location</p>
                                        <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                            @if (job.WorkArrangement == "remote")
                                            {
                                                <LucideGlobeCn Size="12" />
                                            }
                                            else if (job.WorkArrangement == "hybrid")
                                            {
                                                <LucideBuilding2Cn Size="12" />
                                            }
                                            else
                                            {
                                                <LucideMapPinCn Size="12" />
                                            }
                                            <span>@arrangementLabel</span>
                                        </div>
                                    </div>
                                </TableCellCn>
                                <TableCellCn>
                                    <div class="flex items-center gap-1.5 text-sm">
                                        <LucideBriefcaseCn Size="14" Class="text-muted-foreground" />
                                        <span>@expLabel</span>
                                    </div>
                                </TableCellCn>
                                <TableCellCn>
                                    <div class="flex items-center gap-1.5 text-sm">
                                        <LucideBanknoteCn Size="14" Class="text-muted-foreground" />
                                        <span class="font-mono">@FormatSalary(job.SalaryMin, job.SalaryMax)</span>
                                    </div>
                                </TableCellCn>
                                <TableCellCn>
                                    <div class="flex items-center gap-1.5 text-sm text-muted-foreground">
                                        <LucideClockCn Size="14" />
                                        <span>@job.PostedDate</span>
                                    </div>
                                </TableCellCn>
                                <TableCellCn Class="text-center">
                                    <TooltipCn>
                                        <TooltipTriggerCn>
                                            <div class="flex items-center justify-center gap-1">
                                                <LucideUsersCn Size="14" Class="text-muted-foreground" />
                                                <span class="@Cn.Merge("font-mono text-sm", job.Applicants > 100 ? "text-orange-600" : "")">@job.Applicants</span>
                                            </div>
                                        </TooltipTriggerCn>
                                        <TooltipContentCn>
                                            <p>@job.Applicants applications received</p>
                                        </TooltipContentCn>
                                    </TooltipCn>
                                </TableCellCn>
                                <TableCellCn>
                                    <ButtonCn Class="h-7 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">Apply</ButtonCn>
                                </TableCellCn>
                            </TableRowCn>
                        }
                    </TableBodyCn>
                </TableCn>
            </div>

            <div class="flex items-center gap-6 text-xs text-muted-foreground">
                <div class="flex items-center gap-1.5"><LucideGlobeCn Size="14" /><span>Remote</span></div>
                <div class="flex items-center gap-1.5"><LucideBuilding2Cn Size="14" /><span>Hybrid</span></div>
                <div class="flex items-center gap-1.5"><LucideMapPinCn Size="14" /><span>On-site</span></div>
                <div class="flex items-center gap-1.5"><LucideZapCn Size="14" Class="text-orange-500 fill-orange-500" /><span>Urgent hire</span></div>
            </div>
        </div>
    </div>
</section>

@code {
    private record JobItem(string Id, string Title, string Department, string Location, string WorkArrangement,
        string JobType, string ExperienceLevel, int SalaryMin, int SalaryMax, string PostedDate, int Applicants,
        bool IsUrgent, bool IsNew);

    private static string GetDepartmentColor(string dept) => dept switch
    {
        "Engineering" => "bg-blue-100 text-blue-700 hover:bg-blue-100",
        "Design" => "bg-purple-100 text-purple-700 hover:bg-purple-100",
        "Marketing" => "bg-green-100 text-green-700 hover:bg-green-100",
        "Sales" => "bg-orange-100 text-orange-700 hover:bg-orange-100",
        "Operations" => "bg-cyan-100 text-cyan-700 hover:bg-cyan-100",
        "Finance" => "bg-emerald-100 text-emerald-700 hover:bg-emerald-100",
        "HR" => "bg-pink-100 text-pink-700 hover:bg-pink-100",
        _ => "",
    };

    private static string FormatSalary(int min, int max) =>
        $"${(min >= 1000 ? $"{min / 1000}k" : $"{min}")} - ${(max >= 1000 ? $"{max / 1000}k" : $"{max}")}";

    private readonly JobItem[] _jobs = [
        new("1", "Senior Software Engineer", "Engineering", "San Francisco, CA", "hybrid", "full_time", "senior", 150000, 200000, "2 days ago", 47, true, true),
        new("2", "Product Designer", "Design", "New York, NY", "remote", "full_time", "mid", 100000, 140000, "5 days ago", 89, false, true),
        new("3", "DevOps Engineer", "Engineering", "Austin, TX", "remote", "full_time", "senior", 140000, 180000, "1 week ago", 32, true, false),
        new("4", "Marketing Manager", "Marketing", "Chicago, IL", "onsite", "full_time", "mid", 90000, 120000, "1 week ago", 156, false, false),
        new("5", "Sales Development Rep", "Sales", "Denver, CO", "hybrid", "full_time", "entry", 55000, 75000, "2 weeks ago", 203, false, false),
        new("6", "UX Researcher", "Design", "Seattle, WA", "remote", "full_time", "mid", 95000, 130000, "3 days ago", 64, false, true),
        new("7", "Engineering Intern", "Engineering", "San Francisco, CA", "onsite", "internship", "entry", 40000, 55000, "1 day ago", 312, false, true),
        new("8", "VP of Engineering", "Engineering", "Remote US", "remote", "full_time", "executive", 250000, 350000, "3 weeks ago", 18, true, false),
        new("9", "Financial Analyst", "Finance", "New York, NY", "hybrid", "full_time", "mid", 85000, 110000, "4 days ago", 78, false, true),
        new("10", "HR Coordinator", "HR", "Austin, TX", "onsite", "full_time", "entry", 50000, 65000, "2 weeks ago", 124, false, false),
    ];
}
