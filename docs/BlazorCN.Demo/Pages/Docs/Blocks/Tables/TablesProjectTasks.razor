@* ============================================================
   Block: tables-project-tasks
   Title: Tables Project Tasks
   Description: Table component with project tasks showing priorities, assignees, due dates and status columns
   Dependencies: AvatarCn, BadgeCn, CheckboxCn, ProgressCn, TableCn
   Source: original/blocks/tables/tables-project-tasks.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Project Tasks</h3>
                <p class="text-sm text-muted-foreground">
                    @_tasks.Length tasks &middot; @_inProgressCount in progress
                </p>
            </div>
            <div class="flex items-center gap-2">
                @if (_overdueCount > 0)
                {
                    <BadgeCn Class="gap-1" Variant="BadgeVariant.Destructive">
                        <LucideCircleAlertCn Size="12" Class="h-3 w-3" />
                        @_overdueCount overdue
                    </BadgeCn>
                }
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-10"><span class="sr-only">Complete</span></TableHeadCn>
                        <TableHeadCn Class="w-64 font-semibold text-foreground">Task</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Status</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">Priority</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Assignees</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Due Date</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Progress</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var task in _tasks)
                    {
                        var isComplete = _completed.Contains(task.Id);
                        var (statusLabel, statusClass) = GetStatusConfig(task.Status);
                        var (prioLabel, prioClass) = GetPriorityConfig(task.Priority);
                        var taskId = task.Id;

                        <TableRowCn Class="@Cn.Merge(task.Status == "blocked" ? "bg-red-50/50" : "", isComplete ? "opacity-60" : "")">
                            <TableCellCn>
                                <CheckboxCn Checked="@isComplete" CheckedChanged="() => ToggleComplete(taskId)" aria-label="@($"Mark {task.Title} complete")" />
                            </TableCellCn>
                            <TableCellCn>
                                <div class="space-y-1">
                                    <p class="@Cn.Merge("font-medium text-sm", isComplete ? "line-through text-muted-foreground" : "")">@task.Title</p>
                                    <div class="flex items-center gap-3 text-xs text-muted-foreground">
                                        @if (task.SubtaskTotal > 0)
                                        {
                                            <div class="flex items-center gap-1">
                                                <LucideListTodoCn Size="12" Class="h-3 w-3" />
                                                <span>@task.SubtaskCompleted/@task.SubtaskTotal</span>
                                            </div>
                                        }
                                        @if (task.Comments > 0)
                                        {
                                            <div class="flex items-center gap-1">
                                                <LucideMessageSquareCn Size="12" Class="h-3 w-3" />
                                                <span>@task.Comments</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@Cn.Merge("gap-1 text-xs", statusClass)" Variant="BadgeVariant.Secondary">
                                    @if (task.Status == "todo")
                                    {
                                        <LucideCircleCn Size="12" Class="h-3 w-3" />
                                    }
                                    else if (task.Status == "in_progress")
                                    {
                                        <LucideLoaderCircleCn Size="12" Class="h-3 w-3 animate-spin" />
                                    }
                                    else if (task.Status == "in_review")
                                    {
                                        <LucideClockCn Size="12" Class="h-3 w-3" />
                                    }
                                    else if (task.Status == "done")
                                    {
                                        <LucideCircleCheckBigCn Size="12" Class="h-3 w-3" />
                                    }
                                    else if (task.Status == "blocked")
                                    {
                                        <LucidePauseCn Size="12" Class="h-3 w-3" />
                                    }
                                    @statusLabel
                                </BadgeCn>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex justify-center" title="@prioLabel priority">
                                    <LucideFlagCn Size="16" Class="@Cn.Merge("h-4 w-4", prioClass)" />
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                @if (task.Assignees.Length == 0)
                                {
                                    <span class="text-xs text-muted-foreground">Unassigned</span>
                                }
                                else
                                {
                                    <div class="flex -space-x-2">
                                        @foreach (var assignee in task.Assignees.Take(3))
                                        {
                                            <AvatarCn Class="h-7 w-7 border-2 border-card">
                                                <AvatarFallbackCn Class="text-[10px]">@GetInitials(assignee)</AvatarFallbackCn>
                                            </AvatarCn>
                                        }
                                        @if (task.Assignees.Length > 3)
                                        {
                                            <div class="flex h-7 w-7 items-center justify-center rounded-full border-2 border-card bg-muted text-[10px] font-medium">
                                                +@(task.Assignees.Length - 3)
                                            </div>
                                        }
                                    </div>
                                }
                            </TableCellCn>
                            <TableCellCn>
                                <div class="@Cn.Merge("flex items-center gap-1.5 text-sm", task.DueDateStatus == "overdue" ? "text-red-600 font-medium" : "", task.DueDateStatus == "today" ? "text-orange-600 font-medium" : "")">
                                    <LucideCalendarCn Size="14" Class="h-3.5 w-3.5" />
                                    <span>@task.DueDate</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="space-y-1">
                                    <ProgressCn Value="@task.Progress" Class="h-1.5" aria-label="Progress" />
                                    <p class="text-xs text-muted-foreground text-right">@(task.Progress)%</p>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex items-center gap-6 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
                <LucideFlagCn Size="14" Class="h-3.5 w-3.5 text-red-600" />
                <span>Urgent</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideFlagCn Size="14" Class="h-3.5 w-3.5 text-orange-600" />
                <span>High</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucidePauseCn Size="14" Class="h-3.5 w-3.5 text-red-600" />
                <span>Blocked</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideCircleCheckBigCn Size="14" Class="h-3.5 w-3.5 text-green-600" />
                <span>Done</span>
            </div>
        </div>
    </div>
</div>

@code {
    private record TaskItem(string Id, string Title, string Priority, string Status, string[] Assignees, string DueDate, string DueDateStatus, int SubtaskCompleted, int SubtaskTotal, int Comments, int Progress);

    private static readonly TaskItem[] _tasks =
    [
        new("1", "Implement user authentication flow", "urgent", "in_progress", ["Sarah Chen", "Marcus Johnson"], "Today", "today", 3, 5, 8, 60),
        new("2", "Design dashboard wireframes", "high", "in_review", ["Emily Rodriguez"], "Tomorrow", "upcoming", 4, 4, 12, 100),
        new("3", "Fix payment gateway integration", "urgent", "blocked", ["Sarah Chen"], "Mar 10", "overdue", 1, 3, 15, 33),
        new("4", "Write API documentation", "medium", "todo", ["David Kim"], "Mar 18", "future", 0, 6, 2, 0),
        new("5", "Set up CI/CD pipeline", "high", "in_progress", ["Lisa Thompson", "David Kim"], "Mar 15", "upcoming", 2, 4, 5, 50),
        new("6", "Optimize database queries", "medium", "todo", [], "Mar 20", "future", 0, 0, 0, 0),
        new("7", "Add dark mode support", "low", "done", ["Emily Rodriguez"], "Mar 8", "future", 3, 3, 7, 100),
        new("8", "Implement search functionality", "high", "in_progress", ["Marcus Johnson"], "Mar 14", "upcoming", 2, 5, 4, 40),
        new("9", "Create onboarding tutorial", "medium", "todo", ["James Wilson"], "Mar 22", "future", 0, 4, 1, 0),
        new("10", "Security audit and fixes", "urgent", "in_review", ["Sarah Chen", "Lisa Thompson"], "Mar 12", "overdue", 5, 6, 18, 83),
    ];

    private static readonly int _inProgressCount = _tasks.Count(t => t.Status == "in_progress");
    private static readonly int _overdueCount = _tasks.Count(t => t.DueDateStatus == "overdue");

    private HashSet<string> _completed = new(_tasks.Where(t => t.Status == "done").Select(t => t.Id));

    private void ToggleComplete(string id)
    {
        if (!_completed.Remove(id))
            _completed.Add(id);
    }

    private static string GetInitials(string name) =>
        string.Join("", name.Split(' ').Select(n => n[0])).ToUpper();

    private static (string Label, string ClassName) GetStatusConfig(string status) => status switch
    {
        "todo" => ("To Do", "bg-muted text-muted-foreground hover:bg-muted"),
        "in_progress" => ("In Progress", "bg-blue-100 text-blue-700 hover:bg-blue-100"),
        "in_review" => ("In Review", "bg-purple-100 text-purple-700 hover:bg-purple-100"),
        "done" => ("Done", "bg-green-100 text-green-700 hover:bg-green-100"),
        "blocked" => ("Blocked", "bg-red-100 text-red-700 hover:bg-red-100"),
        _ => (status, ""),
    };

    private static (string Label, string ClassName) GetPriorityConfig(string priority) => priority switch
    {
        "urgent" => ("Urgent", "text-red-600"),
        "high" => ("High", "text-orange-600"),
        "medium" => ("Medium", "text-yellow-600"),
        "low" => ("Low", "text-muted-foreground"),
        _ => (priority, ""),
    };
}
