@* ============================================================
   Block: tables-user-permissions
   Title: TablesUserPermissions
   Description: User role and permission management table with toggleable access controls for React/Next.js using shadcn/ui and Tailwind CSS.
   Source: original/blocks/tables/tables-user-permissions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">User Permissions</h3>
                <p class="text-xs text-muted-foreground">
                    @_users.Count users &middot; @_users.Count(u => u.Role == "admin") admins
                </p>
            </div>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground">User</TableHeadCn>
                    <TableHeadCn Class="w-24 font-medium text-xs text-muted-foreground">Role</TableHeadCn>
                    @foreach (var perm in _permissionKeys)
                    {
                        <TableHeadCn Class="w-16 text-center font-medium text-xs text-muted-foreground">
                            @(char.ToUpper(perm[0]) + perm.Substring(1))
                        </TableHeadCn>
                    }
                    <TableHeadCn Class="w-24 font-medium text-xs text-muted-foreground text-right">
                        Last Active
                    </TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var user in _users)
                {
                    var u = user;
                    <TableRowCn Class="hover:bg-muted/50">
                        <TableCellCn>
                            <div class="flex items-center gap-2">
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="text-[10px]">@GetInitials(u.Name)</AvatarFallbackCn>
                                </AvatarCn>
                                <div>
                                    <p class="text-sm font-medium">@u.Name</p>
                                    <p class="text-xs text-muted-foreground">@u.Email</p>
                                </div>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] font-normal", GetRoleClass(u.Role))">
                                @GetRoleLabel(u.Role)
                            </BadgeCn>
                        </TableCellCn>
                        @foreach (var perm in _permissionKeys)
                        {
                            var p = perm;
                            var isChecked = GetPermission(u, p);
                            <TableCellCn Class="text-center">
                                <span class="flex items-center justify-center">
                                    <CheckboxCn Checked="isChecked" CheckedChanged="@(() => TogglePermission(u.Id, p))" />
                                </span>
                            </TableCellCn>
                        }
                        <TableCellCn Class="text-right text-xs text-muted-foreground">
                            @u.LastActive
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record Permission(bool Read, bool Write, bool Delete, bool Admin);
    private record UserPermission(string Id, string Name, string Email, string Role, Permission Permissions, string LastActive);

    private static readonly string[] _permissionKeys = ["read", "write", "delete", "admin"];

    private List<UserPermission> _users =
    [
        new("1", "Sarah Chen",  "sarah@company.com",  "admin",     new(true,  true,  true,  true),  "2 min ago"),
        new("2", "Alex Kumar",  "alex@company.com",   "developer", new(true,  true,  false, false), "15 min ago"),
        new("3", "Emma Wilson", "emma@company.com",   "editor",    new(true,  true,  false, false), "1 hr ago"),
        new("4", "James Park",  "james@company.com",  "developer", new(true,  true,  true,  false), "30 min ago"),
        new("5", "Maya Patel",  "maya@company.com",   "viewer",    new(true,  false, false, false), "3 hr ago"),
        new("6", "Ryan Lee",    "ryan@company.com",   "editor",    new(true,  true,  false, false), "5 hr ago"),
        new("7", "Lina Torres", "lina@company.com",   "viewer",    new(true,  false, false, false), "1 day ago"),
    ];

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ');
        return string.Concat(parts.Select(p => p.Length > 0 ? p[0].ToString() : ""));
    }

    private static string GetRoleLabel(string role) => role switch
    {
        "admin"     => "Admin",
        "developer" => "Developer",
        "editor"    => "Editor",
        "viewer"    => "Viewer",
        _           => role,
    };

    private static string GetRoleClass(string role) => role switch
    {
        "admin"     => "bg-red-500/10 text-red-700",
        "developer" => "bg-blue-500/10 text-blue-700",
        "editor"    => "bg-purple-500/10 text-purple-700",
        "viewer"    => "bg-slate-500/10 text-slate-700",
        _           => "",
    };

    private static bool GetPermission(UserPermission user, string perm) => perm switch
    {
        "read"   => user.Permissions.Read,
        "write"  => user.Permissions.Write,
        "delete" => user.Permissions.Delete,
        "admin"  => user.Permissions.Admin,
        _        => false,
    };

    private void TogglePermission(string userId, string perm)
    {
        var idx = _users.FindIndex(u => u.Id == userId);
        if (idx < 0) return;
        var u = _users[idx];
        var updated = perm switch
        {
            "read"   => u with { Permissions = u.Permissions with { Read   = !u.Permissions.Read   } },
            "write"  => u with { Permissions = u.Permissions with { Write  = !u.Permissions.Write  } },
            "delete" => u with { Permissions = u.Permissions with { Delete = !u.Permissions.Delete } },
            "admin"  => u with { Permissions = u.Permissions with { Admin  = !u.Permissions.Admin  } },
            _        => u,
        };
        _users[idx] = updated;
    }
}
