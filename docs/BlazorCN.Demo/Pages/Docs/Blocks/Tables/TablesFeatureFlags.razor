@* ============================================================
   Block: tables-feature-flags
   Title: TablesFeatureFlags
   Description: Feature flag management table with toggles and environment targeting. Built with shadcn/ui Table, Switch, and Badge for React and Next.js using Tailwind CSS.
   Source: original/blocks/tables/tables-feature-flags.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Feature Flags</h3>
                <p class="text-xs text-muted-foreground">
                    @(_flags.Count(f => f.Enabled)) of @_flags.Count flags enabled
                </p>
            </div>
            <div class="relative">
                <LucideSearchCn Size="14" Class="absolute left-2.5 top-2.5 size-3.5 text-muted-foreground" />
                <InputCn Class="h-8 w-48 pl-8 text-xs"
                         Placeholder="Search flags..."
                         Value="@_search"
                         ValueChanged="@((string v) => _search = v)" />
            </div>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="w-12 text-xs font-medium text-muted-foreground">On</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Flag</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Environments</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Rollout</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Owner</TableHeadCn>
                    <TableHeadCn Class="text-right text-xs font-medium text-muted-foreground">Modified</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var flag in Filtered())
                {
                    var flagId = flag.Id;
                    <TableRowCn Class="hover:bg-muted/50">
                        <TableCellCn>
                            <SwitchCn Checked="@flag.Enabled"
                                      CheckedChanged="@((bool v) => ToggleFlag(flagId))" aria-label="@($"Toggle {flag.Name}")"
                                      Class="scale-75" />
                        </TableCellCn>
                        <TableCellCn>
                            <div>
                                <p class="text-sm font-medium">@flag.Name</p>
                                <p class="font-mono text-xs text-muted-foreground">@flag.Key</p>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex flex-wrap gap-1">
                                @if (flag.Environments.Length == 0)
                                {
                                    <span class="text-xs text-muted-foreground">None</span>
                                }
                                else
                                {
                                    @foreach (var env in flag.Environments)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary"
                                                 Class="@Cn.Merge("text-[10px] font-normal px-1.5 py-0", EnvColor(env))">
                                            @env.Substring(0, 4)
                                        </BadgeCn>
                                    }
                                }
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-2">
                                <div class="h-1.5 w-16 rounded-full bg-muted">
                                    <div class="h-1.5 rounded-full bg-foreground"
                                         style="@($"width:{flag.Rollout}%")">
                                    </div>
                                </div>
                                <span class="font-mono text-xs text-muted-foreground">@flag.Rollout%</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn Class="text-sm">@flag.Owner</TableCellCn>
                        <TableCellCn Class="text-right text-xs text-muted-foreground">@flag.LastModified</TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private class FeatureFlag
    {
        public string Id { get; set; } = "";
        public string Key { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public bool Enabled { get; set; }
        public string[] Environments { get; set; } = [];
        public int Rollout { get; set; }
        public string Owner { get; set; } = "";
        public string LastModified { get; set; } = "";
    }

    private List<FeatureFlag> _flags = new()
    {
        new() { Id = "1", Key = "new-checkout-flow",   Name = "New Checkout Flow",        Description = "Redesigned checkout with single-page layout",      Enabled = true,  Environments = ["production", "staging"],              Rollout = 100, Owner = "Sarah Chen",  LastModified = "Mar 24, 2026" },
        new() { Id = "2", Key = "ai-recommendations",  Name = "AI Recommendations",       Description = "ML-powered product recommendations engine",        Enabled = true,  Environments = ["staging"],                            Rollout = 25,  Owner = "Alex Kumar",  LastModified = "Mar 22, 2026" },
        new() { Id = "3", Key = "dark-mode-v2",        Name = "Dark Mode V2",             Description = "Updated dark theme with improved contrast",        Enabled = false, Environments = ["development"],                        Rollout = 0,   Owner = "Emma Wilson", LastModified = "Mar 20, 2026" },
        new() { Id = "4", Key = "real-time-collab",    Name = "Real-time Collaboration",  Description = "Multi-user document editing support",              Enabled = true,  Environments = ["production", "staging", "development"], Rollout = 50,  Owner = "James Park",  LastModified = "Mar 18, 2026" },
        new() { Id = "5", Key = "payment-v3",          Name = "Payment V3",               Description = "Stripe integration with 3D Secure support",       Enabled = true,  Environments = ["staging", "development"],             Rollout = 10,  Owner = "Maya Patel",  LastModified = "Mar 15, 2026" },
        new() { Id = "6", Key = "analytics-dashboard", Name = "Analytics Dashboard",      Description = "New analytics with funnel visualization",          Enabled = false, Environments = [],                                     Rollout = 0,   Owner = "Ryan Lee",    LastModified = "Mar 12, 2026" },
        new() { Id = "7", Key = "batch-export",        Name = "Batch Export",             Description = "Export multiple items as ZIP archive",             Enabled = true,  Environments = ["production", "staging", "development"], Rollout = 100, Owner = "Sarah Chen",  LastModified = "Mar 10, 2026" },
    };

    private string _search = "";

    private IEnumerable<FeatureFlag> Filtered()
    {
        if (string.IsNullOrEmpty(_search)) return _flags;
        var lower = _search.ToLowerInvariant();
        return _flags.Where(f =>
            f.Name.ToLowerInvariant().Contains(lower) ||
            f.Key.ToLowerInvariant().Contains(lower));
    }

    private void ToggleFlag(string id)
    {
        var flag = _flags.FirstOrDefault(f => f.Id == id);
        if (flag != null) flag.Enabled = !flag.Enabled;
    }

    private static string EnvColor(string env) => env switch
    {
        "production"  => "bg-red-500/10 text-red-700",
        "staging"     => "bg-amber-500/10 text-amber-700",
        "development" => "bg-blue-500/10 text-blue-700",
        _             => ""
    };
}
