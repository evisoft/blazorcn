@* ========================================
   Block: tables-comparison
   Title: Tables Comparison
   Description: Comparison table component with feature rows and plan columns for React pricing and product pages
   Long Description: Table component with row comparison and difference highlighting for React analytics dashboards
   Dependencies: BadgeCn, ButtonCn, TableCn, LucideCheckCn, LucideMinusCn
   Source: original/blocks/tables/tables-comparison.tsx
   ======================================== *@

<section class="container mx-auto py-16">
    <div style="width: 900px">
        <div class="space-y-4">
            <div class="text-center">
                <h2 class="text-2xl font-bold tracking-tight">Compare Plans</h2>
                <p class="mt-1 text-muted-foreground">Choose the plan that fits your needs</p>
            </div>

            <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
                <div class="overflow-x-auto">
                    <TableCn style="width: 850px">
                        <TableHeaderCn>
                            <TableRowCn>
                                <TableHeadCn Class="w-48 font-semibold text-foreground">Features</TableHeadCn>
                                @foreach (var plan in _plans)
                                {
                                    <TableHeadCn Class="@Cn.Merge(Cn.Merge("text-center", plan.Recommended ? "bg-primary/5" : ""))">
                                        <div class="space-y-1 py-2">
                                            @if (plan.Recommended)
                                            {
                                                <BadgeCn Class="mb-1">Recommended</BadgeCn>
                                            }
                                            <div class="font-semibold text-foreground">@plan.Name</div>
                                            <div class="text-2xl font-bold text-foreground">
                                                @(plan.Price == 0 ? "Free" : $"${plan.Price}")
                                                @if (plan.Price > 0)
                                                {
                                                    <span class="text-sm font-normal text-muted-foreground">/@plan.Period</span>
                                                }
                                            </div>
                                            <div class="text-xs text-muted-foreground">@plan.Description</div>
                                            <ButtonCn
                                                Class="mt-2 w-full"
                                                Size="ButtonSize.Sm"
                                                Variant="@(plan.Recommended ? ButtonVariant.Default : ButtonVariant.Outline)">
                                                @(plan.Price == 0 ? "Get Started" : "Subscribe")
                                            </ButtonCn>
                                        </div>
                                    </TableHeadCn>
                                }
                            </TableRowCn>
                        </TableHeaderCn>
                        <TableBodyCn>
                            @foreach (var category in _categories)
                            {
                                <TableRowCn Class="bg-muted/50">
                                    <TableCellCn Class="py-2 font-semibold text-foreground" ColSpan="@(_plans.Length + 1)">
                                        @category
                                    </TableCellCn>
                                </TableRowCn>
                                @foreach (var feature in _features.Where(f => f.Category == category))
                                {
                                    <TableRowCn>
                                        <TableCellCn Class="font-medium">@feature.Name</TableCellCn>
                                        @foreach (var plan in _plans)
                                        {
                                            var value = feature.Values.GetValueOrDefault(plan.Id, false);
                                            <TableCellCn Class="@Cn.Merge(Cn.Merge("text-center", plan.Recommended ? "bg-primary/5" : ""))">
                                                <div class="flex justify-center">
                                                    @if (value is bool boolVal)
                                                    {
                                                        if (boolVal)
                                                        {
                                                            <LucideCheckCn Size="20" Class="text-green-600" />
                                                        }
                                                        else
                                                        {
                                                            <LucideMinusCn Size="16" Class="text-muted-foreground/50" />
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="text-sm font-medium">@value</span>
                                                    }
                                                </div>
                                            </TableCellCn>
                                        }
                                    </TableRowCn>
                                }
                            }
                        </TableBodyCn>
                    </TableCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record PlanItem(string Id, string Name, int Price, string Period, string Description, bool Recommended = false);
    private record FeatureItem(string Id, string Name, string Category, Dictionary<string, object> Values);

    private static readonly PlanItem[] _plans =
    [
        new("free", "Free", 0, "forever", "For individuals"),
        new("pro", "Pro", 29, "month", "For professionals", true),
        new("team", "Team", 79, "month", "For small teams"),
        new("enterprise", "Enterprise", 199, "month", "For organizations"),
    ];

    private static readonly string[] _categories = ["Core Features", "Security", "Support"];

    private static readonly FeatureItem[] _features =
    [
        new("projects", "Projects", "Core Features", new() { ["free"] = "3", ["pro"] = "Unlimited", ["team"] = "Unlimited", ["enterprise"] = "Unlimited" }),
        new("storage", "Storage", "Core Features", new() { ["free"] = "1 GB", ["pro"] = "50 GB", ["team"] = "200 GB", ["enterprise"] = "Unlimited" }),
        new("collaborators", "Collaborators", "Core Features", new() { ["free"] = "1", ["pro"] = "5", ["team"] = "25", ["enterprise"] = "Unlimited" }),
        new("api-access", "API Access", "Core Features", new() { ["free"] = false, ["pro"] = true, ["team"] = true, ["enterprise"] = true }),
        new("ssl", "SSL Encryption", "Security", new() { ["free"] = true, ["pro"] = true, ["team"] = true, ["enterprise"] = true }),
        new("2fa", "Two-Factor Auth", "Security", new() { ["free"] = false, ["pro"] = true, ["team"] = true, ["enterprise"] = true }),
        new("sso", "SSO / SAML", "Security", new() { ["free"] = false, ["pro"] = false, ["team"] = true, ["enterprise"] = true }),
        new("audit-logs", "Audit Logs", "Security", new() { ["free"] = false, ["pro"] = false, ["team"] = false, ["enterprise"] = true }),
        new("email-support", "Email Support", "Support", new() { ["free"] = false, ["pro"] = true, ["team"] = true, ["enterprise"] = true }),
        new("priority-support", "Priority Support", "Support", new() { ["free"] = false, ["pro"] = false, ["team"] = true, ["enterprise"] = true }),
        new("dedicated-manager", "Dedicated Manager", "Support", new() { ["free"] = false, ["pro"] = false, ["team"] = false, ["enterprise"] = true }),
        new("sla", "99.9% SLA", "Support", new() { ["free"] = false, ["pro"] = false, ["team"] = false, ["enterprise"] = true }),
    ];
}
