@* ============================================================
   Block: tables-webhook-logs
   Title: TablesWebhookLogs
   Description: Webhook delivery log table with HTTP status codes and retry indicators for React/Next.js using shadcn/ui and Tailwind CSS.
   Source: original/blocks/tables/tables-webhook-logs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Webhook Logs</h3>
                <p class="text-xs text-muted-foreground">
                    @_failedCount failed of @_webhookLogs.Length deliveries
                </p>
            </div>
            <div class="flex items-center gap-1.5">
                @foreach (var s in _filters)
                {
                    var filter = s;
                    <ButtonCn Variant="@((_statusFilter == filter) ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="h-6 px-2 text-xs"
                              @onclick="@(() => _statusFilter = filter)">
                        @(filter.Substring(0, 1).ToUpper() + filter.Substring(1))
                    </ButtonCn>
                }
            </div>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="w-8 font-medium text-xs text-muted-foreground"><span class="sr-only">Expand</span></TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground">Event</TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground">Endpoint</TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground">Status</TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground text-right">Response</TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground text-right">Size</TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground text-right">Retries</TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground text-right">Time</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var lg in GetFiltered())
                {
                    var log = lg;
                    <TableRowCn Class="hover:bg-muted/50 cursor-pointer" @onclick="@(() => ToggleExpanded(log.Id))">
                        <TableCellCn Class="w-8 px-2">
                            <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground transition-transform duration-200", _expanded == log.Id ? "rotate-90" : "")" />
                        </TableCellCn>
                        <TableCellCn>
                            <span class="font-mono text-sm">@log.Event</span>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="truncate text-xs text-muted-foreground max-w-40 block">@log.Endpoint</span>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-xs font-mono font-normal", GetStatusColor(log.StatusCode))">
                                @log.StatusCode
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn Class="text-right font-mono text-xs text-muted-foreground">
                            @(log.ResponseTime)ms
                        </TableCellCn>
                        <TableCellCn Class="text-right text-xs text-muted-foreground">
                            @log.PayloadSize
                        </TableCellCn>
                        <TableCellCn Class="text-right">
                            @if (log.Retries > 0)
                            {
                                <div class="flex items-center justify-end gap-1">
                                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3 text-amber-600" />
                                    <span class="text-xs text-amber-600">@log.Retries</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-xs text-muted-foreground">0</span>
                            }
                        </TableCellCn>
                        <TableCellCn Class="text-right text-xs text-muted-foreground whitespace-nowrap">
                            @log.Timestamp
                        </TableCellCn>
                    </TableRowCn>
                    @if (_expanded == log.Id)
                    {
                        <TableRowCn>
                            <TableCellCn ColSpan="8" Class="bg-muted/30 px-6 py-3">
                                <div class="rounded-md bg-zinc-950 p-3 font-mono text-xs text-zinc-300">
                                    <p>@("{")</p>
                                    <p class="pl-4">@($"\"event\": \"{log.Event}\",")</p>
                                    <p class="pl-4">@($"\"webhook_id\": \"{log.Id}\",")</p>
                                    <p class="pl-4">@($"\"status\": {log.StatusCode},")</p>
                                    <p class="pl-4">@($"\"response_time_ms\": {log.ResponseTime}")</p>
                                    <p>@("}")</p>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record WebhookLog(string Id, string Event, string Endpoint, int StatusCode, int ResponseTime, string PayloadSize, int Retries, string Timestamp);

    private static readonly WebhookLog[] _webhookLogs =
    [
        new("wh-1001", "order.completed",     "https://api.partner.com/webhooks",          200, 142,   "2.4 KB", 0, "Mar 24, 2026 14:32:05"),
        new("wh-1002", "user.created",        "https://crm.example.com/hooks/users",        200,  89,   "1.1 KB", 0, "Mar 24, 2026 14:28:41"),
        new("wh-1003", "payment.failed",      "https://billing.internal/notify",            500, 5023,  "3.8 KB", 3, "Mar 24, 2026 14:15:22"),
        new("wh-1004", "subscription.renewed","https://api.partner.com/webhooks",           200, 156,   "1.9 KB", 0, "Mar 24, 2026 13:58:10"),
        new("wh-1005", "invoice.sent",        "https://accounting.example.com/ingest",      408, 30000, "4.2 KB", 2, "Mar 24, 2026 13:42:55"),
        new("wh-1006", "user.deleted",        "https://crm.example.com/hooks/users",        200,  67,   "0.8 KB", 0, "Mar 24, 2026 13:30:18"),
        new("wh-1007", "order.refunded",      "https://billing.internal/notify",            201, 203,   "2.7 KB", 0, "Mar 24, 2026 13:15:07"),
        new("wh-1008", "payment.succeeded",   "https://api.partner.com/webhooks",           502, 12500, "1.5 KB", 1, "Mar 24, 2026 12:58:33"),
    ];

    private static readonly int _failedCount = _webhookLogs.Count(l => l.StatusCode >= 400);

    private static readonly string[] _filters = ["all", "success", "error"];

    private string _statusFilter = "all";
    private string? _expanded = null;

    private IEnumerable<WebhookLog> GetFiltered()
    {
        return _statusFilter switch
        {
            "success" => _webhookLogs.Where(l => l.StatusCode >= 200 && l.StatusCode < 300),
            "error"   => _webhookLogs.Where(l => l.StatusCode >= 400),
            _         => _webhookLogs,
        };
    }

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetStatusColor(int code)
    {
        if (code >= 200 && code < 300) return "bg-green-500/10 text-green-700";
        if (code >= 400 && code < 500) return "bg-amber-500/10 text-amber-700";
        return "bg-red-500/10 text-red-700";
    }
}
