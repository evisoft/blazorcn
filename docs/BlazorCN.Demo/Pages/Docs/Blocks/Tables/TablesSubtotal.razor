@* ========================================
   Block: tables-subtotal
   Title: Tables Subtotal
   Description: Table component with subtotals and group summaries for React financial and reporting dashboards
   Long Description: Table component with subscription management showing plan details, billing cycles, renewal dates and usage for React SaaS dashboards
   Dependencies: TableCn
   Source: original/blocks/tables/tables-subtotal.tsx
   ======================================== *@

<section class="container mx-auto py-16">
    <div style="width: 900px">
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h3 class="text-lg font-semibold">Q1 Expense Report</h3>
                    <p class="text-sm text-muted-foreground">
                        @expenses.Length line items across @categoryOrder.Length categories
                    </p>
                </div>
                <div class="text-right">
                    <p class="text-2xl font-bold">@FormatCurrency(grandTotal)</p>
                    <p class="text-sm text-muted-foreground">Total expenses</p>
                </div>
            </div>

            <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
                <TableCn Class="table-fixed" style="width: 850px">
                    <TableHeaderCn>
                        <TableRowCn>
                            <TableHeadCn Class="w-24 font-semibold text-foreground">ID</TableHeadCn>
                            <TableHeadCn Class="w-56 font-semibold text-foreground">Description</TableHeadCn>
                            <TableHeadCn Class="w-28 font-semibold text-foreground">Category</TableHeadCn>
                            <TableHeadCn Class="w-20 font-semibold text-foreground text-right">Qty</TableHeadCn>
                            <TableHeadCn Class="w-28 font-semibold text-foreground text-right">Unit Price</TableHeadCn>
                            <TableHeadCn Class="w-28 font-semibold text-foreground text-right">Total</TableHeadCn>
                            <TableHeadCn Class="font-semibold text-foreground text-right">% of Total</TableHeadCn>
                        </TableRowCn>
                    </TableHeaderCn>
                    <TableBodyCn>
                        @foreach (var group in groupedExpenses)
                        {
                            @for (var idx = 0; idx < group.Items.Length; idx++)
                            {
                                var expense = group.Items[idx];

                                <TableRowCn>
                                    <TableCellCn Class="font-mono text-sm text-muted-foreground">
                                        @expense.Id
                                    </TableCellCn>
                                    <TableCellCn Class="truncate" title="@expense.Description">
                                        @expense.Description
                                    </TableCellCn>
                                    <TableCellCn Class="text-sm text-muted-foreground">
                                        @(idx == 0 ? expense.Category : "")
                                    </TableCellCn>
                                    <TableCellCn Class="text-right tabular-nums">@expense.Quantity</TableCellCn>
                                    <TableCellCn Class="text-right tabular-nums">
                                        @FormatCurrency(expense.UnitPrice)
                                    </TableCellCn>
                                    <TableCellCn Class="text-right tabular-nums font-medium">
                                        @FormatCurrency(expense.Total)
                                    </TableCellCn>
                                    <TableCellCn Class="text-right tabular-nums text-muted-foreground">
                                        @FormatPercent((double)expense.Total / grandTotal * 100)
                                    </TableCellCn>
                                </TableRowCn>
                            }
                            <TableRowCn Class="bg-muted/50 border-t-2">
                                <TableCellCn></TableCellCn>
                                <TableCellCn Class="font-semibold">@group.Category Subtotal</TableCellCn>
                                <TableCellCn></TableCellCn>
                                <TableCellCn Class="text-right tabular-nums font-semibold">
                                    @group.SubtotalQty
                                </TableCellCn>
                                <TableCellCn></TableCellCn>
                                <TableCellCn Class="text-right tabular-nums font-semibold">
                                    @FormatCurrency(group.Subtotal)
                                </TableCellCn>
                                <TableCellCn Class="text-right tabular-nums font-semibold">
                                    @FormatPercent((double)group.Subtotal / grandTotal * 100)
                                </TableCellCn>
                            </TableRowCn>
                        }
                    </TableBodyCn>
                    <TableFooterCn>
                        <TableRowCn Class="bg-muted font-bold">
                            <TableCellCn></TableCellCn>
                            <TableCellCn>Grand Total</TableCellCn>
                            <TableCellCn></TableCellCn>
                            <TableCellCn Class="text-right tabular-nums">@totalQuantity</TableCellCn>
                            <TableCellCn></TableCellCn>
                            <TableCellCn Class="text-right tabular-nums">
                                @FormatCurrency(grandTotal)
                            </TableCellCn>
                            <TableCellCn Class="text-right tabular-nums">100%</TableCellCn>
                        </TableRowCn>
                    </TableFooterCn>
                </TableCn>
            </div>

            <p class="text-xs text-muted-foreground">
                Subtotals shown at end of each category. Percentages calculated against grand total.
            </p>
        </div>
    </div>
</section>

@code {
    private record Expense(string Id, string Description, string Category, int Quantity, int UnitPrice, int Total);
    private record ExpenseGroup(string Category, Expense[] Items, int Subtotal, int SubtotalQty);

    private static readonly Expense[] expenses = new[]
    {
        new Expense("EXP-001", "Cloud hosting (Annual)", "Software", 1, 2400, 2400),
        new Expense("EXP-002", "Design tool licenses", "Software", 5, 180, 900),
        new Expense("EXP-003", "Project management SaaS", "Software", 1, 600, 600),
        new Expense("EXP-004", "Laptops for new hires", "Hardware", 3, 1500, 4500),
        new Expense("EXP-005", "Monitor upgrades", "Hardware", 5, 400, 2000),
        new Expense("EXP-006", "Consulting fees", "Services", 40, 150, 6000),
        new Expense("EXP-007", "Security audit", "Services", 1, 3500, 3500),
        new Expense("EXP-008", "Training workshops", "Services", 2, 800, 1600),
        new Expense("EXP-009", "Ad campaign Q1", "Marketing", 1, 5000, 5000),
        new Expense("EXP-010", "Trade show booth", "Marketing", 1, 2500, 2500),
    };

    private static readonly string[] categoryOrder = new[] { "Software", "Hardware", "Services", "Marketing" };

    private static readonly int grandTotal = expenses.Sum(e => e.Total);
    private static readonly int totalQuantity = expenses.Sum(e => e.Quantity);

    private static readonly ExpenseGroup[] groupedExpenses = categoryOrder.Select(category =>
    {
        var items = expenses.Where(e => e.Category == category).ToArray();
        return new ExpenseGroup(category, items, items.Sum(e => e.Total), items.Sum(e => e.Quantity));
    }).ToArray();

    private static string FormatCurrency(int amount) => amount.ToString("C0");
    private static string FormatPercent(double value) => $"{value:F1}%";
}
