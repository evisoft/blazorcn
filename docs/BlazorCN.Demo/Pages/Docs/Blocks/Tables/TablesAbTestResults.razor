@* ============================================================
   Block: tables-ab-test-results
   Title: TablesAbTestResults
   Description: A/B test results table with variant metrics, conversion rates, and statistical significance for React dashboards. Built with Next.js, shadcn/ui, Tailwind CSS.
   Source: original/blocks/tables/tables-ab-test-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">A/B Test Results</h3>
                <p class="text-xs text-muted-foreground">
                    @_tests.Count(t => t.Status == "running") running &middot;
                    @_tests.Count(t => t.Status == "completed") completed
                </p>
            </div>
        </div>
        <div class="divide-y">
            @foreach (var tst in _tests)
            {
                var test = tst;
                <div>
                    <button
                        type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => { _expandedId = _expandedId == test.Id ? null : test.Id; })">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@test.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"text-[10px] font-normal {StatusClass(test.Status)}")">
                                    @StatusLabel(test.Status)
                                </BadgeCn>
                                @if (test.Significance == "significant")
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal border-green-200 text-green-700">
                                        <LucideIconCn Name="check-circle-2" Size="10" Class="mr-0.5 size-2.5" />
                                        Significant
                                    </BadgeCn>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-xs text-muted-foreground">
                                <span>Metric: @test.Metric</span>
                                <span>&middot;</span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3" /> @test.StartDate
                                </span>
                                <span>&middot;</span>
                                <span>Confidence: @test.Confidence.ToString("F1")%</span>
                            </div>
                        </div>
                    </button>
                    @if (_expandedId == test.Id)
                    {
                        <div class="px-4 pb-3">
                            <TableCn>
                                <TableHeaderCn>
                                    <TableRowCn Class="bg-muted/50">
                                        <TableHeadCn Class="font-medium text-xs">Variant</TableHeadCn>
                                        <TableHeadCn Class="font-medium text-xs text-right">Traffic</TableHeadCn>
                                        <TableHeadCn Class="font-medium text-xs text-right">Visitors</TableHeadCn>
                                        <TableHeadCn Class="font-medium text-xs text-right">Conversions</TableHeadCn>
                                        <TableHeadCn Class="font-medium text-xs text-right">Conv. Rate</TableHeadCn>
                                        <TableHeadCn Class="font-medium text-xs text-right">Uplift</TableHeadCn>
                                    </TableRowCn>
                                </TableHeaderCn>
                                <TableBodyCn>
                                    @foreach (var variant in test.Variants)
                                    {
                                        <TableRowCn>
                                            <TableCellCn>
                                                <div class="flex items-center gap-1.5">
                                                    @if (variant.IsWinner)
                                                    {
                                                        <LucideIconCn Name="trophy" Size="14" Class="size-3.5 text-amber-500" />
                                                    }
                                                    <span class="@(variant.IsWinner ? "text-sm font-medium" : "text-sm")">@variant.Name</span>
                                                    @if (variant.IsWinner)
                                                    {
                                                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal border-amber-200 text-amber-700">
                                                            Winner
                                                        </BadgeCn>
                                                    }
                                                </div>
                                            </TableCellCn>
                                            <TableCellCn Class="text-right font-mono text-xs text-muted-foreground">
                                                @variant.Traffic%
                                            </TableCellCn>
                                            <TableCellCn Class="text-right font-mono text-xs tabular-nums">
                                                @variant.Visitors.ToString("N0")
                                            </TableCellCn>
                                            <TableCellCn Class="text-right font-mono text-xs tabular-nums">
                                                @variant.Conversions.ToString("N0")
                                            </TableCellCn>
                                            <TableCellCn Class="text-right">
                                                <span class="font-mono text-sm font-medium tabular-nums">
                                                    @variant.ConversionRate.ToString("F1")%
                                                </span>
                                            </TableCellCn>
                                            <TableCellCn Class="text-right">
                                                @if (variant.Uplift > 0)
                                                {
                                                    <div class="flex items-center justify-end gap-1">
                                                        <LucideIconCn Name="arrow-up" Size="12" Class="size-3 text-green-600" />
                                                        <span class="font-mono text-sm font-medium text-green-600 tabular-nums">
                                                            +@variant.Uplift.ToString("F1")%
                                                        </span>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <span class="text-xs text-muted-foreground">
                                                        <LucideIconCn Name="minus" Size="12" Class="inline size-3" /> Baseline
                                                    </span>
                                                }
                                            </TableCellCn>
                                        </TableRowCn>
                                    }
                                </TableBodyCn>
                            </TableCn>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record VariantData(string Name, int Traffic, int Visitors, int Conversions, double ConversionRate, double Uplift, bool IsWinner);
    private record ABTestData(string Id, string Name, string Metric, string Status, string Significance, double Confidence, string StartDate, VariantData[] Variants);

    private string? _expandedId = "1";

    private static string StatusClass(string status) => status switch
    {
        "running" => "bg-blue-500/10 text-blue-700",
        "completed" => "bg-green-500/10 text-green-700",
        "paused" => "bg-amber-500/10 text-amber-700",
        _ => ""
    };

    private static string StatusLabel(string status) => status switch
    {
        "running" => "Running",
        "completed" => "Completed",
        "paused" => "Paused",
        _ => status
    };

    private static readonly ABTestData[] _tests =
    [
        new("1", "Checkout Button Color", "Purchase rate", "completed", "significant", 97.2, "Mar 10, 2026",
        [
            new("Control", 50, 12400, 496, 4.0, 0, false),
            new("Green CTA", 50, 12380, 619, 5.0, 24.8, true),
        ]),
        new("2", "Pricing Page Layout", "Plan selection", "running", "pending", 82.1, "Mar 18, 2026",
        [
            new("Control", 33, 4200, 252, 6.0, 0, false),
            new("Horizontal", 33, 4180, 268, 6.4, 6.7, false),
            new("Comparison", 34, 4310, 302, 7.0, 16.7, false),
        ]),
        new("3", "Onboarding Steps", "Activation rate", "completed", "not-significant", 68.4, "Mar 5, 2026",
        [
            new("Control (5 steps)", 50, 8900, 3560, 40.0, 0, false),
            new("Short (3 steps)", 50, 8850, 3628, 41.0, 2.5, false),
        ]),
        new("4", "Hero Headline Copy", "Sign-up rate", "completed", "significant", 99.1, "Mar 1, 2026",
        [
            new("Control", 50, 22100, 884, 4.0, 0, false),
            new("Benefit-led", 50, 22050, 1103, 5.0, 25.0, true),
        ]),
    ];
}
