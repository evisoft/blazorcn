@* ============================================================
   Block: tables-environment-vars
   Title: TablesEnvironmentVars
   Description: Environment variable key-value table with masked values, copy actions, and scope badges for React/Next.js DevOps panels using shadcn/ui and Tailwind CSS.
   Source: original/blocks/tables/tables-environment-vars.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Environment Variables</h3>
                <p class="text-xs text-muted-foreground">@_envVars.Length variables configured</p>
            </div>
            <div class="flex items-center gap-2">
                <div class="relative">
                    <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-2.5 size-3.5 text-muted-foreground" />
                    <InputCn Class="h-8 w-40 pl-8 text-xs" Placeholder="Search keys..." Value="@_search" ValueChanged="@((string v) => SetSearch(v))" />
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Add
                </ButtonCn>
            </div>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Key</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Value</TableHeadCn>
                    <TableHeadCn Class="w-24 text-xs font-medium text-muted-foreground">Scope</TableHeadCn>
                    <TableHeadCn Class="w-28 text-xs font-medium text-muted-foreground">Updated</TableHeadCn>
                    <TableHeadCn Class="w-24 text-xs font-medium text-muted-foreground text-right">Actions</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var envVar in Filtered())
                {
                    var ev = envVar;
                    <TableRowCn Class="hover:bg-muted/50">
                        <TableCellCn>
                            <span class="font-mono text-sm font-medium">@ev.Key</span>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-xs text-muted-foreground truncate max-w-64">
                                    @(ev.IsSecret && !_revealedIds.Contains(ev.Id) ? new string('•', 24) : ev.Value)
                                </span>
                                @if (ev.IsSecret)
                                {
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 w-5 p-0 shrink-0" OnClick="@(() => ToggleReveal(ev.Id))">
                                        @if (_revealedIds.Contains(ev.Id))
                                        {
                                            <LucideIconCn Name="eye-off" Size="12" Class="size-3" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="eye" Size="12" Class="size-3" />
                                        }
                                    </ButtonCn>
                                }
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] font-normal", GetScopeStyle(ev.Scope))">
                                @ev.Scope
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn>
                            <div>
                                <p class="text-xs text-muted-foreground">@ev.LastUpdated</p>
                                <p class="text-[10px] text-muted-foreground/60">@ev.UpdatedBy</p>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center justify-end gap-0.5">
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0" OnClick="@(() => HandleCopy(ev.Id, ev.Value))">
                                    @if (_copiedId == ev.Id)
                                    {
                                        <LucideIconCn Name="circle-check" Size="12" Class="size-3 text-green-600" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                    }
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0 text-muted-foreground hover:text-red-600">
                                    <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                                </ButtonCn>
                            </div>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record EnvVar(string Id, string Key, string Value, string Scope, bool IsSecret, string UpdatedBy, string LastUpdated);

    private static readonly EnvVar[] _envVars =
    [
        new("1", "DATABASE_URL", "postgresql://user:pass@db.example.com:5432/app", "production", true, "Sarah Chen", "Mar 24, 2026"),
        new("2", "NEXT_PUBLIC_API_URL", "https://api.example.com/v2", "all", false, "Alex Kumar", "Mar 22, 2026"),
        new("3", "STRIPE_SECRET_KEY", "sk_live_51abc123def456ghi789jkl", "production", true, "Maya Patel", "Mar 20, 2026"),
        new("4", "REDIS_URL", "redis://cache.internal:6379", "production", true, "James Park", "Mar 18, 2026"),
        new("5", "SMTP_HOST", "smtp.mailgun.org", "all", false, "Emma Wilson", "Mar 15, 2026"),
        new("6", "SMTP_PASSWORD", "mg-key-a1b2c3d4e5f6", "production", true, "Emma Wilson", "Mar 15, 2026"),
        new("7", "SENTRY_DSN", "https://abc123@sentry.io/456789", "all", false, "Ryan Lee", "Mar 12, 2026"),
        new("8", "JWT_SECRET", "super-secret-jwt-signing-key-2026", "production", true, "Sarah Chen", "Mar 10, 2026"),
    ];

    private string _search = "";
    private HashSet<string> _revealedIds = new();
    private string? _copiedId = null;
    private System.Threading.CancellationTokenSource? _copyCts;

    private void SetSearch(string v) => _search = v;

    private IEnumerable<EnvVar> Filtered() =>
        string.IsNullOrEmpty(_search)
            ? _envVars
            : _envVars.Where(v => v.Key.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private void ToggleReveal(string id)
    {
        if (!_revealedIds.Remove(id))
            _revealedIds.Add(id);
    }

    private async void HandleCopy(string id, string value)
    {
        _copyCts?.Cancel();
        _copyCts = new System.Threading.CancellationTokenSource();
        var token = _copyCts.Token;
        _copiedId = id;
        StateHasChanged();
        try
        {
            await Task.Delay(2000, token);
            _copiedId = null;
            StateHasChanged();
        }
        catch (TaskCanceledException) { }
    }

    private static string GetScopeStyle(string scope) => scope switch
    {
        "production" => "bg-red-500/10 text-red-700",
        "staging" => "bg-amber-500/10 text-amber-700",
        "development" => "bg-blue-500/10 text-blue-700",
        "all" => "bg-slate-500/10 text-slate-700",
        _ => "",
    };
}
