@* ============================================================
   Block: tables-content-calendar
   Title: TablesContentCalendar
   Description: Editorial calendar table for content planning in React with type badges, platform targeting, status filters using shadcn/ui Table, Badge, Input components with Tailwind CSS.
   Source: original/blocks/tables/tables-content-calendar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Content Calendar</h3>
                <p class="text-xs text-muted-foreground">
                    @_contentItems.Length items · @_scheduledCount scheduled
                </p>
            </div>
            <div class="relative">
                <LucideSearchCn Class="absolute left-2.5 top-2.5 size-3.5 text-muted-foreground" Size="14" />
                <InputCn Class="h-8 w-40 pl-8 text-xs" Placeholder="Search..." @bind-Value="_search" />
            </div>
        </div>
        <div class="flex items-center gap-1.5 border-b px-4 py-2">
            @foreach (var s in _statusFilters)
            {
                var filterVal = s;
                <ButtonCn
                    Variant="@(_statusFilter == filterVal ? ButtonVariant.Default : ButtonVariant.Outline)"
                    Size="ButtonSize.Sm"
                    Class="h-6 px-2 text-xs"
                    @onclick="@(() => _statusFilter = filterVal)">
                    @GetFilterLabel(filterVal)
                </ButtonCn>
            }
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground">Content</TableHeadCn>
                    <TableHeadCn Class="w-20 font-medium text-xs text-muted-foreground">Type</TableHeadCn>
                    <TableHeadCn Class="w-20 font-medium text-xs text-muted-foreground">Status</TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground">Platforms</TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground">Author</TableHeadCn>
                    <TableHeadCn Class="font-medium text-xs text-muted-foreground text-right">Date</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var item in GetFiltered())
                {
                    var typeInfo = GetTypeConfig(item.Type);
                    var statusInfo = GetStatusConfig(item.Status);
                    <TableRowCn Class="hover:bg-muted/50">
                        <TableCellCn>
                            <div>
                                <p class="text-sm font-medium">@item.Title</p>
                                <p class="text-xs text-muted-foreground">@item.Topic</p>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] font-normal gap-1", typeInfo.ClassName)">
                                @GetTypeIcon(item.Type)
                                @typeInfo.Label
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] font-normal", statusInfo.ClassName)">
                                @statusInfo.Label
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex flex-wrap gap-1">
                                @foreach (var p in item.Platforms)
                                {
                                    <span class="rounded bg-muted/50 px-1.5 py-0.5 text-[10px] text-muted-foreground">@p</span>
                                }
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1.5">
                                <AvatarCn Class="size-5">
                                    <AvatarFallbackCn Class="text-[8px]">@GetInitials(item.Author)</AvatarFallbackCn>
                                </AvatarCn>
                                <span class="text-xs">@item.Author</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn Class="text-right text-xs text-muted-foreground whitespace-nowrap">
                            @item.ScheduledDate
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record ContentItem(string Id, string Title, string Type, string Status, string[] Platforms, string Author, string ScheduledDate, string Topic);
    private record TypeInfo(string Label, string IconName, string ClassName);
    private record StatusInfo(string Label, string ClassName);

    private string _statusFilter = "all";
    private string _search = "";

    private static readonly string[] _statusFilters = ["all", "draft", "review", "scheduled", "published"];

    private static readonly ContentItem[] _contentItems =
    [
        new("1", "2026 State of React Report", "blog", "published", ["website", "twitter", "linkedin"], "Sarah Chen", "Mar 24, 2026", "Engineering"),
        new("2", "Building Scalable APIs with tRPC", "video", "scheduled", ["youtube", "twitter"], "Alex Kumar", "Mar 26, 2026", "Tutorial"),
        new("3", "Why We Switched to Bun", "blog", "review", ["website", "linkedin"], "James Park", "Mar 28, 2026", "Engineering"),
        new("4", "Product Launch Teaser", "social", "scheduled", ["twitter", "instagram", "linkedin"], "Emma Wilson", "Mar 25, 2026", "Marketing"),
        new("5", "Developer Podcast Ep. 42", "podcast", "draft", ["website", "youtube"], "Maya Patel", "Mar 30, 2026", "Interview"),
        new("6", "Q1 Performance Metrics", "infographic", "review", ["website", "twitter", "linkedin"], "Ryan Lee", "Mar 29, 2026", "Data"),
        new("7", "Authentication Best Practices", "blog", "draft", ["website"], "Alex Kumar", "Apr 2, 2026", "Security"),
        new("8", "Component Library Tour", "video", "scheduled", ["youtube", "twitter"], "Sarah Chen", "Mar 27, 2026", "Tutorial"),
    ];

    private static readonly int _scheduledCount = _contentItems.Count(i => i.Status == "scheduled");

    private IEnumerable<ContentItem> GetFiltered() =>
        _contentItems
            .Where(i => _statusFilter == "all" || i.Status == _statusFilter)
            .Where(i => _search == "" || i.Title.Contains(_search, StringComparison.OrdinalIgnoreCase));

    private static TypeInfo GetTypeConfig(string type) => type switch
    {
        "blog"        => new("Blog",        "file-text",  "bg-blue-500/10 text-blue-700"),
        "video"       => new("Video",       "film",       "bg-red-500/10 text-red-700"),
        "social"      => new("Social",      "megaphone",  "bg-purple-500/10 text-purple-700"),
        "podcast"     => new("Podcast",     "headphones", "bg-amber-500/10 text-amber-700"),
        "infographic" => new("Infographic", "image",      "bg-emerald-500/10 text-emerald-700"),
        _             => new(type,          "file",       ""),
    };

    private static StatusInfo GetStatusConfig(string status) => status switch
    {
        "draft"     => new("Draft",     "bg-slate-500/10 text-slate-700"),
        "review"    => new("In Review", "bg-amber-500/10 text-amber-700"),
        "scheduled" => new("Scheduled", "bg-blue-500/10 text-blue-700"),
        "published" => new("Published", "bg-green-500/10 text-green-700"),
        _           => new(status,      ""),
    };

    private static RenderFragment GetTypeIcon(string type) => type switch
    {
        "blog"        => @<LucideFileTextCn Size="12" Class="size-3" />,
        "video"       => @<LucideFilmCn Size="12" Class="size-3" />,
        "social"      => @<LucideMegaphoneCn Size="12" Class="size-3" />,
        "podcast"     => @<LucideHeadphonesCn Size="12" Class="size-3" />,
        "infographic" => @<LucideImageCn Size="12" Class="size-3" />,
        _             => @<LucideFileCn Size="12" Class="size-3" />,
    };

    private static string GetFilterLabel(string s) => s switch
    {
        "all"       => "All",
        "review"    => "In Review",
        _           => char.ToUpper(s[0]) + s[1..],
    };

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();
}
