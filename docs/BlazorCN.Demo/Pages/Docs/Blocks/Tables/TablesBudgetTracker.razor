@* ============================================================
   Block: tables-budget-tracker
   Title: TablesBudgetTracker
   Description: React table with budget tracking, progress bars, category grouping, and overspend alerts for Next.js finance dashboards using shadcn/ui and Tailwind CSS
   Source: original/blocks/tables/tables-budget-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Budget Tracker</h3>
                <p class="text-xs text-muted-foreground">
                    Q1 2026 &middot; @FormatCurrency(_totalSpent) of @FormatCurrency(_totalAllocated) spent
                </p>
            </div>
            <div class="flex items-center gap-4 text-xs">
                <div class="text-right">
                    <p class="text-muted-foreground">Remaining</p>
                    <p class="@Cn.Merge("font-medium tabular-nums", _totalRemaining < 0 ? "text-red-600" : "text-green-600")">
                        @FormatCurrency(_totalRemaining)
                    </p>
                </div>
            </div>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Line Item</TableHeadCn>
                    <TableHeadCn Class="text-right text-xs font-medium text-muted-foreground">Allocated</TableHeadCn>
                    <TableHeadCn Class="text-right text-xs font-medium text-muted-foreground">Spent</TableHeadCn>
                    <TableHeadCn Class="text-right text-xs font-medium text-muted-foreground">Pending</TableHeadCn>
                    <TableHeadCn Class="text-right text-xs font-medium text-muted-foreground">Remaining</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Utilization</TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var category in _categories)
                {
                    var catItems = _budgetItems.Where(i => i.Category == category).ToArray();
                    var catTotal = catItems.Sum(i => i.Allocated);
                    var catSpent = catItems.Sum(i => i.Spent);

                    <TableRowCn Class="bg-muted/30">
                        <TableCellCn colspan="6">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-medium text-muted-foreground uppercase tracking-wider">@category</span>
                                <span class="text-xs text-muted-foreground">@FormatCurrency(catSpent) / @FormatCurrency(catTotal)</span>
                            </div>
                        </TableCellCn>
                    </TableRowCn>

                    @foreach (var item in catItems)
                    {
                        var remaining = item.Allocated - item.Spent - item.Pending;
                        var utilization = (int)Math.Round((double)item.Spent / item.Allocated * 100);
                        var isOverBudget = item.Spent > item.Allocated;
                        var barWidth = Math.Min(utilization, 100);

                        <TableRowCn Class="hover:bg-muted/50">
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <span class="text-sm">@item.LineItem</span>
                                    @if (isOverBudget)
                                    {
                                        <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5 text-red-500" />
                                    }
                                </div>
                                <p class="text-xs text-muted-foreground">@item.LastTransaction</p>
                            </TableCellCn>
                            <TableCellCn Class="text-right font-mono text-sm tabular-nums">
                                @FormatCurrency(item.Allocated)
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <span class="@Cn.Merge("font-mono text-sm tabular-nums", isOverBudget ? "text-red-600 font-medium" : "")">
                                    @FormatCurrency(item.Spent)
                                </span>
                            </TableCellCn>
                            <TableCellCn Class="text-right font-mono text-xs text-muted-foreground tabular-nums">
                                @(item.Pending > 0 ? FormatCurrency(item.Pending) : "—")
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <span class="@Cn.Merge("font-mono text-sm tabular-nums", remaining < 0 ? "text-red-600" : "text-muted-foreground")">
                                    @FormatCurrency(remaining)
                                </span>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <div class="h-1.5 w-16 rounded-full bg-muted">
                                        <div class="@Cn.Merge("h-1.5 rounded-full", utilization > 100 ? "bg-red-500" : utilization > 85 ? "bg-amber-500" : "bg-green-500")"
                                             style="width:@(barWidth)%">
                                        </div>
                                    </div>
                                    <span class="@Cn.Merge("font-mono text-xs tabular-nums", utilization > 100 ? "text-red-600" : "text-muted-foreground")">
                                        @(utilization)%
                                    </span>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                }
                <TableRowCn Class="bg-muted/50 font-medium">
                    <TableCellCn Class="text-sm font-medium">Total</TableCellCn>
                    <TableCellCn Class="text-right font-mono text-sm tabular-nums">
                        @FormatCurrency(_totalAllocated)
                    </TableCellCn>
                    <TableCellCn Class="text-right font-mono text-sm tabular-nums">
                        @FormatCurrency(_totalSpent)
                    </TableCellCn>
                    <TableCellCn Class="text-right font-mono text-xs tabular-nums">
                        @FormatCurrency(_totalPending)
                    </TableCellCn>
                    <TableCellCn Class="text-right">
                        <span class="@Cn.Merge("font-mono text-sm tabular-nums", _totalRemaining < 0 ? "text-red-600" : "text-green-600")">
                            @FormatCurrency(_totalRemaining)
                        </span>
                    </TableCellCn>
                    <TableCellCn>
                        <span class="font-mono text-xs text-muted-foreground tabular-nums">
                            @(Math.Round((double)_totalSpent / _totalAllocated * 100))%
                        </span>
                    </TableCellCn>
                </TableRowCn>
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record BudgetItem(string Id, string Category, string LineItem, int Allocated, int Spent, int Pending, string LastTransaction);

    private static readonly BudgetItem[] _budgetItems =
    [
        new("1", "Engineering", "Cloud Infrastructure", 45000, 38200, 2800, "Mar 24, 2026"),
        new("2", "Engineering", "Software Licenses", 18000, 15400, 1200, "Mar 22, 2026"),
        new("3", "Engineering", "Third-party APIs", 12000, 13100, 500, "Mar 23, 2026"),
        new("4", "Marketing", "Paid Advertising", 30000, 22500, 4000, "Mar 24, 2026"),
        new("5", "Marketing", "Content Production", 15000, 8900, 0, "Mar 20, 2026"),
        new("6", "Marketing", "Events & Sponsorships", 20000, 19800, 1500, "Mar 18, 2026"),
        new("7", "Operations", "Office & Facilities", 10000, 7200, 0, "Mar 15, 2026"),
        new("8", "Operations", "Travel & Expenses", 8000, 5600, 800, "Mar 21, 2026"),
    ];

    private static readonly string[] _categories = _budgetItems.Select(i => i.Category).Distinct().ToArray();

    private static readonly int _totalAllocated = _budgetItems.Sum(i => i.Allocated);
    private static readonly int _totalSpent = _budgetItems.Sum(i => i.Spent);
    private static readonly int _totalPending = _budgetItems.Sum(i => i.Pending);
    private static readonly int _totalRemaining = _totalAllocated - _totalSpent - _totalPending;

    private static string FormatCurrency(int amount) => $"${amount:N0}";
}
