@* ============================================================
   Block: tables-color-indicator
   Title: Tables Color Indicator
   Description: Table component with color dot indicators and category labels for project management dashboards
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-color-indicator.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Project Overview</h3>
                <p class="text-sm text-muted-foreground">
                    @_projects.Length projects &ndash; @_activeCount active
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-3">
                @foreach (var cat in _categories)
                {
                    <div class="flex items-center gap-1.5">
                        <span class="@Cn.Merge("h-2 w-2 rounded-full", cat.Color)"></span>
                        <span class="text-xs text-muted-foreground">@cat.Label</span>
                    </div>
                }
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">ID</TableHeadCn>
                        <TableHeadCn Class="w-44 font-semibold text-foreground">Project</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Category</TableHeadCn>
                        <TableHeadCn Class="w-32 font-semibold text-foreground">Lead</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Status</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Due</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Progress</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var project in _projects)
                    {
                        var cat = GetCategoryConfig(project.Category);
                        <TableRowCn Class="@Cn.Merge("border-l-4", cat.BorderColor, project.Status == "completed" ? "opacity-60" : "")">
                            <TableCellCn Class="font-mono text-sm text-muted-foreground">
                                @project.Id
                            </TableCellCn>
                            <TableCellCn Class="font-medium truncate" title="@project.Name">
                                @project.Name
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <span class="@Cn.Merge("h-2.5 w-2.5 rounded-full", cat.Color)"></span>
                                    <span class="text-sm">@cat.Label</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <LucideUserCn Size="14" Class="h-3.5 w-3.5 text-muted-foreground" />
                                    <span class="text-sm truncate">@project.Lead.Split(' ')[0]</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                @{
                                    var (statusLabel, statusVariant) = GetStatusConfig(project.Status);
                                }
                                <BadgeCn Variant="@statusVariant">@statusLabel</BadgeCn>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-1.5 text-sm text-muted-foreground">
                                    <LucideCalendarCn Size="14" Class="h-3.5 w-3.5" />
                                    @project.DueDate
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <div class="h-1.5 w-20 rounded-full bg-muted">
                                        <div class="@Cn.Merge("h-full rounded-full transition-all", project.Progress == 100 ? "bg-emerald-500" : "bg-primary")"
                                             style="@($"width: {project.Progress}%")"></div>
                                    </div>
                                    <span class="text-xs text-muted-foreground tabular-nums">@(project.Progress)%</span>
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Left border and dot colors indicate project category. See legend above for color meanings.
        </p>
    </div>
</div>

@code {
    private record Project(string Id, string Name, string Category, string Lead, string Status, string DueDate, int Progress);
    private record CategoryConfig(string Label, string Color, string BgColor, string BorderColor);

    private static readonly CategoryConfig[] _categories =
    [
        new("Design", "bg-violet-500", "bg-violet-50", "border-l-violet-500"),
        new("Development", "bg-blue-500", "bg-blue-50", "border-l-blue-500"),
        new("Marketing", "bg-pink-500", "bg-pink-50", "border-l-pink-500"),
        new("Research", "bg-amber-500", "bg-amber-50", "border-l-amber-500"),
        new("Operations", "bg-emerald-500", "bg-emerald-50", "border-l-emerald-500"),
        new("Support", "bg-cyan-500", "bg-cyan-50", "border-l-cyan-500"),
    ];

    private static readonly Project[] _projects =
    [
        new("PRJ-001", "Website Redesign", "design", "Sarah Chen", "active", "Jan 30", 65),
        new("PRJ-002", "API v2 Migration", "development", "Marcus Johnson", "active", "Feb 15", 40),
        new("PRJ-003", "Q1 Campaign Launch", "marketing", "Emily Rodriguez", "active", "Jan 20", 85),
        new("PRJ-004", "User Behavior Study", "research", "David Kim", "paused", "Mar 1", 25),
        new("PRJ-005", "Mobile App UI Kit", "design", "Lisa Thompson", "active", "Feb 28", 50),
        new("PRJ-006", "Infrastructure Upgrade", "operations", "James Wilson", "completed", "Jan 10", 100),
        new("PRJ-007", "Customer Portal", "development", "Anna Martinez", "active", "Mar 15", 20),
        new("PRJ-008", "Help Center Revamp", "support", "Michael Brown", "active", "Feb 5", 70),
    ];

    private static readonly int _activeCount = _projects.Count(p => p.Status == "active");

    private static CategoryConfig GetCategoryConfig(string category) => category switch
    {
        "design" => _categories[0],
        "development" => _categories[1],
        "marketing" => _categories[2],
        "research" => _categories[3],
        "operations" => _categories[4],
        "support" => _categories[5],
        _ => _categories[0],
    };

    private static (string Label, BadgeVariant Variant) GetStatusConfig(string status) => status switch
    {
        "active" => ("Active", BadgeVariant.Default),
        "paused" => ("Paused", BadgeVariant.Secondary),
        "completed" => ("Completed", BadgeVariant.Outline),
        _ => ("Unknown", BadgeVariant.Secondary),
    };
}
