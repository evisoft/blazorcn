@* ============================================================
   Block: tables-pagination
   Title: Tables Pagination
   Description: Paginated table component with page navigation and rows per page selector
   Dependencies: BadgeCn, ButtonCn, TableCn
   Source: original/blocks/tables/tables-pagination.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="font-semibold text-foreground">Order ID</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Customer</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Product</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Amount</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Status</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Date</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var order in CurrentPageData)
                    {
                        var (statusLabel, statusVariant, statusClass) = GetStatusConfig(order.Status);

                        <TableRowCn>
                            <TableCellCn Class="font-mono font-medium">@order.Id</TableCellCn>
                            <TableCellCn>@order.Customer</TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@order.Product</TableCellCn>
                            <TableCellCn Class="font-mono font-semibold">@order.Amount.ToString("C2")</TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@statusClass" Variant="@statusVariant">@statusLabel</BadgeCn>
                            </TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@order.Date</TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                <div class="flex items-center gap-2">
                    <p class="text-sm text-muted-foreground whitespace-nowrap">Rows per page</p>
                    @foreach (var size in _pageSizes)
                    {
                        <ButtonCn Size="ButtonSize.Sm"
                                  Variant="@(_rowsPerPage == size ? ButtonVariant.Default : ButtonVariant.Outline)"
                                  Class="h-8 min-w-8"
                                  OnClick="() => SetRowsPerPage(size)">
                            @size
                        </ButtonCn>
                    }
                </div>
                <p class="text-sm text-muted-foreground">
                    Showing @ShowingStart-@ShowingEnd of @_orders.Length
                </p>
            </div>

            <div class="flex items-center justify-center gap-1 flex-wrap">
                <ButtonCn Class="h-8" Disabled="@(_currentPage == 1)" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="() => GoToPage(_currentPage - 1)">
                    <LucideChevronLeftCn Size="16" Class="h-4 w-4" />
                    <span class="hidden sm:inline">Previous</span>
                </ButtonCn>

                @foreach (var page in GetPageNumbers())
                {
                    if (page == -1)
                    {
                        <span class="px-2 text-muted-foreground">...</span>
                    }
                    else
                    {
                        var p = page;
                        <ButtonCn Class="min-w-8 h-8" Size="ButtonSize.Sm"
                                  Variant="@(_currentPage == p ? ButtonVariant.Default : ButtonVariant.Outline)"
                                  OnClick="() => GoToPage(p)">
                            @p
                        </ButtonCn>
                    }
                }

                <ButtonCn Class="h-8" Disabled="@(_currentPage == TotalPages)" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" OnClick="() => GoToPage(_currentPage + 1)">
                    <span class="hidden sm:inline">Next</span>
                    <LucideChevronRightCn Size="16" Class="h-4 w-4" />
                </ButtonCn>
            </div>
        </div>
    </div>
</div>

@code {
    private record Order(string Id, string Customer, string Product, double Amount, string Status, string Date);

    private static readonly string[] _customers = ["John Smith", "Emma Wilson", "Michael Brown", "Sarah Davis", "James Johnson", "Lisa Anderson", "Robert Taylor", "Jennifer Martin"];
    private static readonly string[] _products = ["Laptop Pro 15", "Wireless Mouse", "Mechanical Keyboard", "4K Monitor", "USB Hub", "Webcam HD", "Desk Lamp", "Phone Stand"];
    private static readonly string[] _statuses = ["completed", "processing", "pending", "cancelled"];
    private static readonly int[] _pageSizes = [10, 20, 50];

    private static readonly Order[] _orders = Enumerable.Range(0, 47).Select(i =>
        new Order(
            $"ORD-{(i + 1):D4}",
            _customers[i % 8],
            _products[i % 8],
            Math.Round(50 + (i * 37.7 % 500), 2),
            _statuses[i % 4],
            $"2024-01-{(i % 28) + 1:D2}"
        )
    ).ToArray();

    private int _currentPage = 1;
    private int _rowsPerPage = 10;

    private int TotalPages => (int)Math.Ceiling((double)_orders.Length / _rowsPerPage);
    private int StartIndex => (_currentPage - 1) * _rowsPerPage;
    private int ShowingStart => StartIndex + 1;
    private int ShowingEnd => Math.Min(StartIndex + _rowsPerPage, _orders.Length);
    private Order[] CurrentPageData => _orders.Skip(StartIndex).Take(_rowsPerPage).ToArray();

    private void GoToPage(int page)
    {
        _currentPage = Math.Max(1, Math.Min(page, TotalPages));
    }

    private void SetRowsPerPage(int size)
    {
        _rowsPerPage = size;
        _currentPage = 1;
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        var total = TotalPages;

        if (total <= 7)
            return Enumerable.Range(1, total).ToList();

        pages.Add(1);
        if (_currentPage > 3) pages.Add(-1); // ellipsis

        for (var i = Math.Max(2, _currentPage - 1); i <= Math.Min(total - 1, _currentPage + 1); i++)
            pages.Add(i);

        if (_currentPage < total - 2) pages.Add(-1); // ellipsis
        pages.Add(total);

        return pages;
    }

    private static (string Label, BadgeVariant Variant, string ClassName) GetStatusConfig(string status) => status switch
    {
        "completed" => ("Completed", BadgeVariant.Outline, "border-green-200 text-green-700"),
        "processing" => ("Processing", BadgeVariant.Outline, "border-blue-200 text-blue-700"),
        "pending" => ("Pending", BadgeVariant.Outline, "border-orange-200 text-orange-700"),
        "cancelled" => ("Cancelled", BadgeVariant.Secondary, ""),
        _ => (status, BadgeVariant.Secondary, ""),
    };
}
