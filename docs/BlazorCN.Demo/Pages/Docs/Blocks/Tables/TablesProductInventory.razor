@* ============================================================
   Block: tables-product-inventory
   Title: TablesProductInventory
   Description: Product inventory table with stock alerts for React e-commerce dashboards using shadcn/ui, Next.js, and Tailwind CSS.
   Source: original/blocks/tables/tables-product-inventory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div>
                    <h3 class="text-sm font-medium">Product Inventory</h3>
                    <p class="text-xs text-muted-foreground">@_products.Length products</p>
                </div>
                @if (_lowStockCount > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal border-red-200 text-red-700 gap-1">
                        <LucideIconCn Name="alert-triangle" Size="10" Class="size-2.5" />
                        @_lowStockCount need attention
                    </BadgeCn>
                }
            </div>
            <div class="relative">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-2.5 size-3.5 text-muted-foreground" />
                <InputCn Class="h-8 w-40 pl-8 text-xs" Placeholder="Search..." @bind-Value="_search" />
            </div>
        </div>
        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="bg-muted/50">
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Product</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Status</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">
                        <button type="button" class="flex items-center gap-1" @onclick="@(() => HandleSort("currentStock"))">
                            Stock @if (_sortKey == "currentStock") { @if (_sortDir == "desc") { <LucideIconCn Name="chevron-down" Size="12" Class="size-3" /> } else { <LucideIconCn Name="chevron-up" Size="12" Class="size-3" /> } }
                        </button>
                    </TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Reorder At</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground">Warehouse</TableHeadCn>
                    <TableHeadCn Class="text-xs font-medium text-muted-foreground text-right">
                        <button type="button" class="flex items-center gap-1 ml-auto" @onclick="@(() => HandleSort("unitCost"))">
                            Cost @if (_sortKey == "unitCost") { @if (_sortDir == "desc") { <LucideIconCn Name="chevron-down" Size="12" Class="size-3" /> } else { <LucideIconCn Name="chevron-up" Size="12" Class="size-3" /> } }
                        </button>
                    </TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var product in GetFiltered())
                {
                    var status = GetStockStatus(product);
                    var stockInfo = GetStockStyle(status);
                    var stockClass = Cn.Merge("font-mono text-sm tabular-nums font-medium",
                        status == "low-stock" ? "text-red-600" :
                        status == "out-of-stock" ? "text-muted-foreground" : "");
                    <TableRowCn Class="@Cn.Merge("hover:bg-muted/50", status == "out-of-stock" ? "opacity-60" : "")">
                        <TableCellCn>
                            <div>
                                <p class="text-sm font-medium">@product.Name</p>
                                <div class="flex items-center gap-1.5">
                                    <span class="font-mono text-xs text-muted-foreground">@product.Sku</span>
                                    <span class="text-xs text-muted-foreground">&middot;</span>
                                    <span class="text-xs text-muted-foreground">@product.Category</span>
                                </div>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"text-[10px] font-normal {stockInfo.ClassName}")">
                                @stockInfo.Label
                            </BadgeCn>
                        </TableCellCn>
                        <TableCellCn>
                            <span class="@stockClass">@product.CurrentStock</span>
                        </TableCellCn>
                        <TableCellCn Class="font-mono text-xs text-muted-foreground tabular-nums">@product.ReorderPoint</TableCellCn>
                        <TableCellCn>
                            <div class="flex items-center gap-1">
                                <LucideIconCn Name="package" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-xs text-muted-foreground">@product.Warehouse</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn Class="text-right font-mono text-sm tabular-nums">$@product.UnitCost.ToString("0.00")</TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>
    </div>
</section>

@code {
    private record Product(string Id, string Name, string Sku, string Category, int CurrentStock, int ReorderPoint, int ReorderQty, double UnitCost, string Warehouse, string LastRestocked);

    private static readonly Product[] _products =
    [
        new("1", "Wireless Keyboard Pro", "KB-PRO-001", "Peripherals", 342, 100, 500, 45.99, "Warehouse A", "Mar 20, 2026"),
        new("2", "USB-C Hub 7-in-1", "HUB-7C-002", "Accessories", 78, 150, 300, 32.5, "Warehouse A", "Mar 15, 2026"),
        new("3", "27\" 4K Monitor", "MON-4K-003", "Displays", 0, 25, 50, 389.99, "Warehouse B", "Feb 28, 2026"),
        new("4", "Ergonomic Mouse", "MS-ERG-004", "Peripherals", 567, 200, 600, 29.99, "Warehouse A", "Mar 22, 2026"),
        new("5", "Laptop Stand Aluminum", "STD-ALU-005", "Accessories", 45, 50, 150, 54.99, "Warehouse C", "Mar 10, 2026"),
        new("6", "Webcam 1080p", "CAM-HD-006", "Peripherals", 189, 75, 200, 67.5, "Warehouse B", "Mar 18, 2026"),
        new("7", "Mechanical Keyboard RGB", "KB-RGB-007", "Peripherals", 12, 100, 400, 89.99, "Warehouse A", "Mar 5, 2026"),
        new("8", "Desk Cable Organizer", "ORG-CBL-008", "Accessories", 834, 200, 1000, 12.99, "Warehouse C", "Mar 24, 2026"),
    ];

    private static readonly int _lowStockCount = _products.Count(p =>
        GetStockStatus(p) is "low-stock" or "out-of-stock");

    private string _search = "";
    private string _sortKey = "currentStock";
    private string _sortDir = "asc";

    private static string GetStockStatus(Product p)
    {
        if (p.CurrentStock == 0) return "out-of-stock";
        if (p.CurrentStock <= p.ReorderPoint * 0.5) return "low-stock";
        if (p.CurrentStock <= p.ReorderPoint) return "reorder";
        return "in-stock";
    }

    private record StockStyle(string Label, string ClassName, string DotClass);

    private static StockStyle GetStockStyle(string status) => status switch
    {
        "in-stock" => new("In Stock", "bg-green-500/10 text-green-700", "bg-green-500"),
        "low-stock" => new("Low Stock", "bg-red-500/10 text-red-700", "bg-red-500"),
        "out-of-stock" => new("Out of Stock", "bg-slate-500/10 text-slate-700", "bg-slate-400"),
        "reorder" => new("Reorder", "bg-amber-500/10 text-amber-700", "bg-amber-500"),
        _ => new("Unknown", "", ""),
    };

    private void HandleSort(string key)
    {
        if (_sortKey == key)
            _sortDir = _sortDir == "desc" ? "asc" : "desc";
        else
        {
            _sortKey = key;
            _sortDir = "asc";
        }
    }

    private IEnumerable<Product> GetFiltered()
    {
        var filtered = _products.AsEnumerable();
        if (!string.IsNullOrEmpty(_search))
        {
            var lower = _search.ToLowerInvariant();
            filtered = filtered.Where(p =>
                p.Name.ToLowerInvariant().Contains(lower) ||
                p.Sku.ToLowerInvariant().Contains(lower));
        }
        filtered = _sortKey == "unitCost"
            ? (_sortDir == "asc" ? filtered.OrderBy(p => p.UnitCost) : filtered.OrderByDescending(p => p.UnitCost))
            : (_sortDir == "asc" ? filtered.OrderBy(p => p.CurrentStock) : filtered.OrderByDescending(p => p.CurrentStock));
        return filtered;
    }
}
