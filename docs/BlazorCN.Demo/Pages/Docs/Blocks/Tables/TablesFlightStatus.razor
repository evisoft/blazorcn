@* ============================================================
   Block: tables-flight-status
   Title: Tables Flight Status
   Description: Table component with flight status board showing departures, arrivals, gates, and real-time status updates
   Dependencies: BadgeCn, TableCn
   Source: original/blocks/tables/tables-flight-status.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Flight Information</h3>
                <p class="text-sm text-muted-foreground">
                    @_flights.Length flights &middot; @_departureCount departures &middot; @(_flights.Length - _departureCount) arrivals
                </p>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Class="gap-1 border-green-200 text-green-700" Variant="BadgeVariant.Outline">
                    <LucideCircleCheckBigCn Size="12" Class="h-3 w-3" />
                    @_onTimeCount on time
                </BadgeCn>
                @if (_delayedCount > 0)
                {
                    <BadgeCn Class="gap-1 border-orange-200 text-orange-700" Variant="BadgeVariant.Outline">
                        <LucideTriangleAlertCn Size="12" Class="h-3 w-3" />
                        @_delayedCount delayed
                    </BadgeCn>
                }
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn Class="bg-muted/50">
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Flight</TableHeadCn>
                        <TableHeadCn Class="w-32 font-semibold text-foreground">
                            <div class="flex items-center gap-1">
                                <LucidePlaneTakeoffCn Size="14" Class="h-3.5 w-3.5" />
                                From
                            </div>
                        </TableHeadCn>
                        <TableHeadCn Class="w-32 font-semibold text-foreground">
                            <div class="flex items-center gap-1">
                                <LucidePlaneLandingCn Size="14" Class="h-3.5 w-3.5" />
                                To
                            </div>
                        </TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground text-center">Scheduled</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground text-center">Estimated</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">Gate</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground">Status</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var flight in _flights)
                    {
                        var (statusLabel, statusClass, statusIcon) = GetStatusConfig(flight.Status);
                        var isCancelled = flight.Status == "cancelled";
                        var airlineColor = GetAirlineColor(flight.AirlineCode);

                        <TableRowCn Class="@Cn.Merge(isCancelled ? "bg-red-50/50" : "", flight.Status == "boarding" ? "bg-blue-50/30" : "")">
                            <TableCellCn>
                                <div class="flex items-center gap-2">
                                    <div class="@Cn.Merge("flex h-8 w-8 items-center justify-center rounded text-white text-xs font-bold", airlineColor)">
                                        @flight.AirlineCode
                                    </div>
                                    <div>
                                        <p class="font-mono font-bold text-sm">@flight.FlightNumber</p>
                                        <p class="text-[10px] text-muted-foreground truncate">@flight.Airline</p>
                                    </div>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div>
                                    <p class="font-medium text-sm">@flight.OriginCode</p>
                                    <p class="text-xs text-muted-foreground truncate">@flight.Origin</p>
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div>
                                    <p class="font-medium text-sm">@flight.DestinationCode</p>
                                    <p class="text-xs text-muted-foreground truncate">@flight.Destination</p>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <span class="@Cn.Merge("font-mono text-lg font-bold", isCancelled ? "line-through text-muted-foreground" : "")">
                                    @flight.ScheduledTime
                                </span>
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                @if (flight.ActualTime != null)
                                {
                                    <span class="font-mono text-lg text-muted-foreground">@flight.ActualTime</span>
                                }
                                else if (flight.EstimatedTime != null)
                                {
                                    <span class="@Cn.Merge("font-mono text-lg font-bold", flight.Status == "delayed" ? "text-orange-600" : "")">
                                        @flight.EstimatedTime
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted-foreground">&mdash;</span>
                                }
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                @if (flight.Gate != null)
                                {
                                    <span class="font-mono text-lg font-bold" title="@($"Terminal {flight.Terminal}")">@flight.Gate</span>
                                }
                                else
                                {
                                    <span class="text-xs text-muted-foreground">TBD</span>
                                }
                            </TableCellCn>
                            <TableCellCn>
                                <div class="space-y-1">
                                    <BadgeCn Class="@Cn.Merge("gap-1 text-xs", statusClass)" Variant="BadgeVariant.Secondary">
                                        @statusIcon
                                        @statusLabel
                                    </BadgeCn>
                                    @if (flight.DelayMinutes > 0 && flight.Status == "delayed")
                                    {
                                        <p class="text-[10px] text-orange-600 font-medium">
                                            +@FormatDelay(flight.DelayMinutes) delay
                                        </p>
                                    }
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex items-center gap-6 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
                <LucideCircleCheckBigCn Size="14" Class="h-3.5 w-3.5 text-green-600" />
                <span>On Time</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideClockCn Size="14" Class="h-3.5 w-3.5 text-orange-600" />
                <span>Delayed</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideTimerCn Size="14" Class="h-3.5 w-3.5 text-blue-600" />
                <span>Boarding</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideCircleXCn Size="14" Class="h-3.5 w-3.5 text-red-600" />
                <span>Cancelled</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucidePlaneCn Size="14" Class="h-3.5 w-3.5" />
                <span>Updated live</span>
            </div>
        </div>
    </div>
</div>

@code {
    private record Flight(string Id, string FlightNumber, string Airline, string AirlineCode,
        string Origin, string OriginCode, string Destination, string DestinationCode,
        string ScheduledTime, string? EstimatedTime, string? ActualTime,
        string? Gate, string Terminal, string Status, int DelayMinutes, string FlightType);

    private static readonly Flight[] _flights =
    [
        new("1", "UA 1847", "United Airlines", "UA", "San Francisco", "SFO", "New York JFK", "JFK", "08:30", null, null, "B24", "B", "on_time", 0, "departure"),
        new("2", "DL 482", "Delta Air Lines", "DL", "Los Angeles", "LAX", "San Francisco", "SFO", "08:45", "09:15", null, "A12", "A", "delayed", 30, "arrival"),
        new("3", "AA 1156", "American Airlines", "AA", "San Francisco", "SFO", "Chicago ORD", "ORD", "09:00", null, null, "C8", "C", "boarding", 0, "departure"),
        new("4", "SW 2341", "Southwest Airlines", "WN", "Denver", "DEN", "San Francisco", "SFO", "09:15", null, "09:12", "A5", "A", "arrived", 0, "arrival"),
        new("5", "UA 892", "United Airlines", "UA", "San Francisco", "SFO", "London LHR", "LHR", "09:30", "11:45", null, "G15", "G", "delayed", 135, "departure"),
        new("6", "AS 1432", "Alaska Airlines", "AS", "Seattle", "SEA", "San Francisco", "SFO", "09:45", null, null, "D3", "D", "on_time", 0, "arrival"),
        new("7", "B6 624", "JetBlue Airways", "B6", "San Francisco", "SFO", "Boston BOS", "BOS", "10:00", null, null, null, "B", "on_time", 0, "departure"),
        new("8", "DL 1789", "Delta Air Lines", "DL", "San Francisco", "SFO", "Atlanta ATL", "ATL", "10:15", null, null, "A18", "A", "cancelled", 0, "departure"),
        new("9", "UA 456", "United Airlines", "UA", "Houston", "IAH", "San Francisco", "SFO", "10:30", null, null, "B9", "B", "on_time", 0, "arrival"),
        new("10", "AA 2890", "American Airlines", "AA", "San Francisco", "SFO", "Miami MIA", "MIA", "10:45", "10:55", null, "C12", "C", "delayed", 10, "departure"),
        new("11", "NK 178", "Spirit Airlines", "NK", "Las Vegas", "LAS", "San Francisco", "SFO", "11:00", null, "10:48", "D7", "D", "arrived", 0, "arrival"),
        new("12", "UA 2156", "United Airlines", "UA", "San Francisco", "SFO", "Tokyo NRT", "NRT", "11:15", null, "11:10", "G22", "G", "departed", 0, "departure"),
    ];

    private static readonly int _onTimeCount = _flights.Count(f => f.Status == "on_time");
    private static readonly int _delayedCount = _flights.Count(f => f.Status == "delayed");
    private static readonly int _departureCount = _flights.Count(f => f.FlightType == "departure");

    private static string FormatDelay(int minutes)
    {
        if (minutes < 60) return $"{minutes}m";
        var hours = minutes / 60;
        var mins = minutes % 60;
        return mins > 0 ? $"{hours}h {mins}m" : $"{hours}h";
    }

    private static string GetAirlineColor(string code) => code switch
    {
        "UA" => "bg-blue-600",
        "DL" => "bg-red-600",
        "AA" => "bg-sky-600",
        "WN" => "bg-orange-500",
        "AS" => "bg-teal-600",
        "B6" => "bg-blue-500",
        "NK" => "bg-yellow-500",
        _ => "bg-gray-500",
    };

    private static (string Label, string ClassName, RenderFragment Icon) GetStatusConfig(string status) => status switch
    {
        "on_time" => ("On Time", "bg-green-100 text-green-700 hover:bg-green-100", @<LucideCircleCheckBigCn Size="12" Class="h-3 w-3" />),
        "delayed" => ("Delayed", "bg-orange-100 text-orange-700 hover:bg-orange-100", @<LucideClockCn Size="12" Class="h-3 w-3" />),
        "boarding" => ("Boarding", "bg-blue-100 text-blue-700 hover:bg-blue-100 animate-pulse", @<LucideTimerCn Size="12" Class="h-3 w-3" />),
        "departed" => ("Departed", "bg-muted text-muted-foreground hover:bg-muted", @<LucidePlaneTakeoffCn Size="12" Class="h-3 w-3" />),
        "arrived" => ("Arrived", "bg-muted text-muted-foreground hover:bg-muted", @<LucidePlaneLandingCn Size="12" Class="h-3 w-3" />),
        "cancelled" => ("Cancelled", "bg-red-100 text-red-700 hover:bg-red-100", @<LucideCircleXCn Size="12" Class="h-3 w-3" />),
        _ => ("Unknown", "", @<LucideCircleCn Size="12" Class="h-3 w-3" />),
    };
}
