@* ============================================================
   Block: tables-link-cell
   Title: Tables Link Cell
   Description: Table component with clickable link cells and external URL handling
   Dependencies: BadgeCn, TableCn, TooltipCn
   Source: original/blocks/tables/tables-link-cell.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Site Links</h3>
                <p class="text-sm text-muted-foreground">
                    @_links.Length links &middot; @FormatClicks(_totalClicks) total clicks
                </p>
            </div>
            <div class="flex items-center gap-4 text-sm">
                <div class="flex items-center gap-1.5">
                    <LucideCircleCheckBigCn Size="16" Class="h-4 w-4 text-green-600" />
                    <span class="text-muted-foreground">@_activeCount active</span>
                </div>
                @if (_brokenCount > 0)
                {
                    <div class="flex items-center gap-1.5">
                        <LucideCircleAlertCn Size="16" Class="h-4 w-4 text-destructive" />
                        <span class="text-muted-foreground">@_brokenCount broken</span>
                    </div>
                }
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-40 font-semibold text-foreground">Title</TableHeadCn>
                        <TableHeadCn Class="w-56 font-semibold text-foreground">URL</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Type</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground">Status</TableHeadCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-right">
                            <div class="flex items-center justify-end gap-1">
                                <LucideChartColumnCn Size="16" Class="h-4 w-4" />
                                Clicks
                            </div>
                        </TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Last Checked</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var link in _links)
                    {
                        var isBroken = link.Status == "broken";
                        var (typeIcon, typeLabel) = GetTypeConfig(link.LinkType);
                        var (statusLabel, statusClass) = GetStatusConfig(link.Status);

                        <TableRowCn Class="@Cn.Merge(link.Status == "broken" ? "bg-red-50/50" : "", link.Status == "redirect" ? "bg-yellow-50/30" : "")">
                            <TableCellCn Class="font-medium truncate" title="@link.Title">@link.Title</TableCellCn>
                            <TableCellCn>
                                <TooltipCn>
                                    <TooltipTriggerCn Tabbable="false">
                                        <a class="@Cn.Merge("group flex items-center gap-2 rounded-md transition-colors", isBroken ? "cursor-not-allowed text-muted-foreground line-through" : "text-primary hover:text-primary/80 hover:underline")"
                                           href="@(isBroken ? null : link.Url)"
                                           target="@(link.IsExternal ? "_blank" : null)"
                                           rel="@(link.IsExternal ? "noopener noreferrer" : null)">
                                            <LucideLinkCn Size="14" Class="h-3.5 w-3.5 shrink-0" />
                                            <span class="truncate font-mono text-sm">@FormatUrl(link.Url)</span>
                                            @if (link.IsExternal && !isBroken)
                                            {
                                                <LucideExternalLinkCn Size="12" Class="h-3 w-3 shrink-0 opacity-50 group-hover:opacity-100" />
                                            }
                                        </a>
                                    </TooltipTriggerCn>
                                    <TooltipContentCn Class="max-w-xs" Side="FloatingSide.Bottom">
                                        <p class="font-mono text-xs break-all">@link.Url</p>
                                        @if (link.IsExternal)
                                        {
                                            <p class="text-xs text-muted-foreground mt-1">Opens in new tab</p>
                                        }
                                    </TooltipContentCn>
                                </TooltipCn>
                            </TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="gap-1 font-normal" Variant="BadgeVariant.Outline">
                                    @typeIcon
                                    @typeLabel
                                </BadgeCn>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="@Cn.Merge("flex items-center gap-1.5", statusClass)">
                                    @if (link.Status == "active")
                                    {
                                        <LucideCircleCheckBigCn Size="16" Class="h-4 w-4" />
                                    }
                                    else if (link.Status == "redirect")
                                    {
                                        <LucideClockCn Size="16" Class="h-4 w-4" />
                                    }
                                    else
                                    {
                                        <LucideCircleAlertCn Size="16" Class="h-4 w-4" />
                                    }
                                    <span class="text-sm">@statusLabel</span>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <span class="font-mono text-sm tabular-nums">@FormatClicks(link.Clicks)</span>
                            </TableCellCn>
                            <TableCellCn Class="text-sm text-muted-foreground">@link.LastChecked</TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <p class="text-xs text-muted-foreground">
            Click URLs to navigate. External links open in new tab. Hover for full URL.
        </p>
    </div>
</div>

@code {
    private record SiteLink(string Id, string Title, string Url, string LinkType, string Status, int Clicks, string LastChecked, bool IsExternal);

    private static readonly SiteLink[] _links =
    [
        new("1", "Homepage", "/", "page", "active", 15420, "2 min ago", false),
        new("2", "Product Catalog", "/products", "product", "active", 8932, "5 min ago", false),
        new("3", "Getting Started Guide", "/docs/getting-started", "blog", "active", 4521, "10 min ago", false),
        new("4", "API Documentation", "https://api.example.com/docs", "api", "active", 2341, "15 min ago", true),
        new("5", "Team Directory", "/about/team", "page", "redirect", 1892, "1 hour ago", false),
        new("6", "Analytics Dashboard", "/dashboard/analytics", "page", "active", 6723, "3 min ago", false),
        new("7", "Partner Portal", "https://partners.example.com", "external", "active", 892, "30 min ago", true),
        new("8", "Legacy Support Page", "/support/legacy", "page", "broken", 234, "2 hours ago", false),
    ];

    private static readonly int _activeCount = _links.Count(l => l.Status == "active");
    private static readonly int _brokenCount = _links.Count(l => l.Status == "broken");
    private static readonly int _totalClicks = _links.Sum(l => l.Clicks);

    private static string FormatUrl(string url, int maxLength = 35) =>
        url.Length <= maxLength ? url : url[..(maxLength - 3)] + "...";

    private static string FormatClicks(int num) =>
        num >= 1000 ? $"{num / 1000.0:F1}K" : num.ToString();

    private static (RenderFragment Icon, string Label) GetTypeConfig(string type) => type switch
    {
        "page" => (@<LucideFileTextCn Size="12" Class="h-3 w-3" />, "Page"),
        "product" => (@<LucideShoppingCartCn Size="12" Class="h-3 w-3" />, "Product"),
        "blog" => (@<LucideGlobeCn Size="12" Class="h-3 w-3" />, "Blog"),
        "api" => (@<LucideSettingsCn Size="12" Class="h-3 w-3" />, "API"),
        "external" => (@<LucideExternalLinkCn Size="12" Class="h-3 w-3" />, "External"),
        _ => (@<LucideCircleCn Size="12" Class="h-3 w-3" />, type),
    };

    private static (string Label, string ClassName) GetStatusConfig(string status) => status switch
    {
        "active" => ("Active", "text-green-600"),
        "redirect" => ("Redirect", "text-yellow-600"),
        "broken" => ("Broken", "text-destructive"),
        _ => (status, ""),
    };
}
