@* ============================================================
   Block: tables-leaderboard
   Title: Tables Leaderboard
   Description: Table component with ranked leaderboard showing positions, scores and movement indicators
   Dependencies: AvatarCn, BadgeCn, TableCn
   Source: original/blocks/tables/tables-leaderboard.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold">Weekly Leaderboard</h3>
                <p class="text-sm text-muted-foreground">Top @_players.Length players this week</p>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Class="gap-1" Variant="BadgeVariant.Outline">
                    <LucideTrophyCn Size="12" Class="h-3 w-3 text-yellow-600" />
                    Leader: @_players[0].Name.Split(' ')[0]
                </BadgeCn>
            </div>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="w-20 font-semibold text-foreground text-center">Rank</TableHeadCn>
                        <TableHeadCn Class="w-16 font-semibold text-foreground text-center">+/-</TableHeadCn>
                        <TableHeadCn Class="w-48 font-semibold text-foreground">Player</TableHeadCn>
                        <TableHeadCn Class="w-28 font-semibold text-foreground text-right">Score</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground text-center">Games</TableHeadCn>
                        <TableHeadCn Class="w-24 font-semibold text-foreground text-center">Win Rate</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground text-center">Streak</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var player in _players)
                    {
                        var diff = player.PreviousRank - player.Rank;

                        <TableRowCn Class="@Cn.Merge(player.IsCurrentUser ? "bg-primary/5 border-l-2 border-l-primary" : "", player.Rank <= 3 ? "bg-muted/30" : "")">
                            <TableCellCn Class="text-center">
                                <div class="flex justify-center">
                                    @if (player.Rank == 1)
                                    {
                                        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-yellow-100">
                                            <LucideTrophyCn Size="16" Class="h-4 w-4 text-yellow-600" />
                                        </div>
                                    }
                                    else if (player.Rank == 2)
                                    {
                                        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-gray-100">
                                            <LucideTrophyCn Size="16" Class="h-4 w-4 text-gray-500" />
                                        </div>
                                    }
                                    else if (player.Rank == 3)
                                    {
                                        <div class="flex h-8 w-8 items-center justify-center rounded-full bg-orange-100">
                                            <LucideTrophyCn Size="16" Class="h-4 w-4 text-orange-600" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex h-8 w-8 items-center justify-center">
                                            <span class="text-lg font-bold text-muted-foreground">@player.Rank</span>
                                        </div>
                                    }
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <div class="flex justify-center">
                                    @if (diff == 0)
                                    {
                                        <div class="flex items-center gap-1 text-muted-foreground">
                                            <LucideMinusCn Size="12" Class="h-3 w-3" />
                                        </div>
                                    }
                                    else if (diff > 0)
                                    {
                                        <div class="flex items-center gap-1 text-green-600">
                                            <LucideArrowUpCn Size="12" Class="h-3 w-3" />
                                            <span class="text-xs font-medium">@diff</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-1 text-red-600">
                                            <LucideArrowDownCn Size="12" Class="h-3 w-3" />
                                            <span class="text-xs font-medium">@Math.Abs(diff)</span>
                                        </div>
                                    }
                                </div>
                            </TableCellCn>
                            <TableCellCn>
                                <div class="flex items-center gap-3">
                                    <AvatarCn Class="h-8 w-8">
                                        <AvatarFallbackCn Class="text-xs">@GetInitials(player.Name)</AvatarFallbackCn>
                                    </AvatarCn>
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium">@player.Name</span>
                                        @if (player.IsCurrentUser)
                                        {
                                            <BadgeCn Class="text-xs" Variant="BadgeVariant.Secondary">You</BadgeCn>
                                        }
                                    </div>
                                </div>
                            </TableCellCn>
                            <TableCellCn Class="text-right">
                                <span class="font-mono font-bold">@player.Score.ToString("N0")</span>
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <span class="text-muted-foreground">@player.GamesPlayed</span>
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <span class="@Cn.Merge("font-medium", player.WinRate >= 75 ? "text-green-600" : player.WinRate >= 70 ? "text-foreground" : "text-muted-foreground")">
                                    @(player.WinRate)%
                                </span>
                            </TableCellCn>
                            <TableCellCn Class="text-center">
                                <div class="flex justify-center">
                                    @if (player.Streak > 0)
                                    {
                                        <div class="flex items-center gap-1">
                                            <LucideFlameCn Size="16" Class="@Cn.Merge("h-4 w-4", player.Streak >= 5 ? "text-orange-500" : "text-muted-foreground")" />
                                            <span class="@Cn.Merge("text-xs font-medium", player.Streak >= 5 ? "text-orange-500" : "text-muted-foreground")">@player.Streak</span>
                                        </div>
                                    }
                                </div>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>

        <div class="flex items-center gap-6 text-xs text-muted-foreground">
            <div class="flex items-center gap-1.5">
                <LucideTrophyCn Size="14" Class="h-3.5 w-3.5 text-yellow-600" />
                <span>Top 3 highlighted</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideArrowUpCn Size="14" Class="h-3.5 w-3.5 text-green-600" />
                <span>Position gained</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideFlameCn Size="14" Class="h-3.5 w-3.5 text-orange-500" />
                <span>Win streak</span>
            </div>
        </div>
    </div>
</div>

@code {
    private record Player(string Id, int Rank, int PreviousRank, string Name, int Score, int GamesPlayed, int WinRate, int Streak, bool IsCurrentUser);

    private static readonly Player[] _players =
    [
        new("1", 1, 2, "Sarah Chen", 12450, 89, 78, 7, false),
        new("2", 2, 1, "Marcus Johnson", 11890, 92, 72, 3, false),
        new("3", 3, 3, "Emily Rodriguez", 10750, 76, 75, 5, false),
        new("4", 4, 6, "David Kim", 9820, 84, 68, 4, false),
        new("5", 5, 4, "Lisa Thompson", 9540, 71, 70, 0, false),
        new("6", 6, 5, "James Wilson", 9210, 68, 69, 2, true),
        new("7", 7, 9, "Anna Martinez", 8890, 65, 71, 6, false),
        new("8", 8, 7, "Michael Brown", 8650, 79, 64, 0, false),
        new("9", 9, 8, "Jennifer Lee", 8420, 62, 67, 1, false),
        new("10", 10, 12, "Robert Taylor", 8150, 58, 66, 3, false),
    ];

    private static string GetInitials(string name) =>
        string.Join("", name.Split(' ').Select(n => n[0])).ToUpper();
}
