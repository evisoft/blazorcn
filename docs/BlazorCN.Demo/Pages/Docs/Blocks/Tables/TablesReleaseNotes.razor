@* ============================================================
   Block: tables-release-notes
   Title: TablesReleaseNotes
   Description: Version history table with semantic versioning and changelogs for React product pages using shadcn/ui and Tailwind CSS.
   Source: original/blocks/tables/tables-release-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h3 class="text-sm font-medium">Release Notes</h3>
                <p class="text-xs text-muted-foreground">
                    @_releases.Length releases &middot; Latest: v@(_releases[0].Version)
                </p>
            </div>
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="tag" Size="14" Class="size-3.5" />
                <span>Semantic Versioning</span>
            </div>
        </div>
        <div class="divide-y">
            @foreach (var rel in _releases)
            {
                var release = rel;
                var isExpanded = _expanded == release.Id;
                var typeStyle = GetTypeStyle(release.Type);
                <div>
                    <button
                        type="button"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => _expanded = isExpanded ? null : release.Id)">
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-sm font-medium">v@(release.Version)</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] font-normal", typeStyle.ClassName)">
                                    @typeStyle.Label
                                </BadgeCn>
                                <span class="text-sm text-muted-foreground">@release.Title</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-xs text-muted-foreground">
                                <span>@release.Author</span>
                                <span>&middot;</span>
                                <span>@release.Date</span>
                                <span>&middot;</span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="git-branch" Size="12" Class="size-3" /> @release.Branch
                                </span>
                                <span>&middot;</span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="download" Size="12" Class="size-3" /> @release.Downloads.ToString("N0")
                                </span>
                            </div>
                        </div>
                    </button>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-11">
                            <div class="space-y-1.5">
                                @foreach (var chg in release.Changes)
                                {
                                    var changeColor = GetChangeColor(chg.ChangeType);
                                    <div class="flex items-start gap-2">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] font-normal mt-0.5", changeColor)">
                                            @chg.ChangeType.ToString().ToLowerInvariant()
                                        </BadgeCn>
                                        <span class="text-sm text-muted-foreground">@chg.Description</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum ReleaseType { Major, Minor, Patch, Rc }
    private enum ChangeType { Added, Changed, Fixed, Removed }

    private record ChangeItem(ChangeType ChangeType, string Description);
    private record Release(string Id, string Version, ReleaseType Type, string Title, ChangeItem[] Changes, string Author, string Date, int Downloads, string Branch);

    private record TypeStyle(string Label, string ClassName);

    private static TypeStyle GetTypeStyle(ReleaseType type) => type switch
    {
        ReleaseType.Major => new TypeStyle("Major", "bg-red-500/10 text-red-700"),
        ReleaseType.Minor => new TypeStyle("Minor", "bg-blue-500/10 text-blue-700"),
        ReleaseType.Patch => new TypeStyle("Patch", "bg-green-500/10 text-green-700"),
        ReleaseType.Rc    => new TypeStyle("RC",    "bg-amber-500/10 text-amber-700"),
        _                 => new TypeStyle("",      ""),
    };

    private static string GetChangeColor(ChangeType type) => type switch
    {
        ChangeType.Added   => "text-green-700 bg-green-500/10",
        ChangeType.Changed => "text-blue-700 bg-blue-500/10",
        ChangeType.Fixed   => "text-amber-700 bg-amber-500/10",
        ChangeType.Removed => "text-red-700 bg-red-500/10",
        _                  => "",
    };

    private static readonly Release[] _releases =
    [
        new("1", "3.2.0", ReleaseType.Minor, "Dashboard Redesign",
            [
                new(ChangeType.Added,   "New analytics dashboard with real-time charts"),
                new(ChangeType.Added,   "Export to PDF and CSV from any report"),
                new(ChangeType.Changed, "Improved sidebar navigation layout"),
                new(ChangeType.Fixed,   "Fixed timezone handling in date filters"),
            ],
            "Sarah Chen", "Mar 24, 2026", 1243, "release/3.2"),
        new("2", "3.1.4", ReleaseType.Patch, "Security Patch",
            [
                new(ChangeType.Fixed, "Patched XSS vulnerability in rich text editor"),
                new(ChangeType.Fixed, "Fixed CSRF token validation on API endpoints"),
            ],
            "Alex Kumar", "Mar 20, 2026", 3891, "hotfix/3.1.4"),
        new("3", "3.1.3", ReleaseType.Patch, "Performance Fix",
            [
                new(ChangeType.Fixed,   "Resolved N+1 query in user listing endpoint"),
                new(ChangeType.Changed, "Optimized image loading with lazy loading"),
            ],
            "James Park", "Mar 15, 2026", 5672, "hotfix/3.1.3"),
        new("4", "3.1.0", ReleaseType.Minor, "Team Collaboration",
            [
                new(ChangeType.Added,   "Real-time collaboration with presence indicators"),
                new(ChangeType.Added,   "Team workspace with shared resources"),
                new(ChangeType.Changed, "Updated notification system for mentions"),
                new(ChangeType.Removed, "Deprecated legacy sharing API"),
            ],
            "Emma Wilson", "Mar 8, 2026", 8945, "release/3.1"),
        new("5", "3.0.0", ReleaseType.Major, "Platform V3",
            [
                new(ChangeType.Added,   "Completely redesigned UI with new design system"),
                new(ChangeType.Added,   "Plugin ecosystem with marketplace"),
                new(ChangeType.Changed, "Migrated to React 19 with server components"),
                new(ChangeType.Removed, "Removed support for legacy API v1"),
            ],
            "Maya Patel", "Feb 28, 2026", 15234, "release/3.0"),
    ];

    private string? _expanded = "1";
}
