@* ============================================================
   Block: tables-export
   Title: Tables Export
   Description: Data table component with export buttons for CSV, Excel, and PDF downloads
   Dependencies: BadgeCn, ButtonCn, TableCn
   Source: original/blocks/tables/tables-export.tsx
   ============================================================ *@

<div style="width: 900px">
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <div class="flex flex-col gap-1">
                <p class="text-sm text-muted-foreground">@_sales.Length orders</p>
                <p class="text-lg font-semibold">Total: @_totalRevenue.ToString("C2")</p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="gap-2">
                <LucideDownloadCn Size="16" Class="h-4 w-4" />
                <span>Export</span>
            </ButtonCn>
        </div>

        <div class="overflow-hidden rounded-lg border border-border bg-card shadow-sm">
            <TableCn Class="table-fixed" style="width: 850px">
                <TableHeaderCn>
                    <TableRowCn>
                        <TableHeadCn Class="font-semibold text-foreground">Order ID</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Date</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Product</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Customer</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Quantity</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Price</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Total</TableHeadCn>
                        <TableHeadCn Class="font-semibold text-foreground">Status</TableHeadCn>
                    </TableRowCn>
                </TableHeaderCn>
                <TableBodyCn>
                    @foreach (var sale in _sales)
                    {
                        var (statusLabel, statusClass) = GetStatusBadge(sale.Status);

                        <TableRowCn>
                            <TableCellCn Class="font-mono text-xs">@sale.Id</TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@sale.Date</TableCellCn>
                            <TableCellCn Class="font-medium">@sale.Product</TableCellCn>
                            <TableCellCn Class="text-muted-foreground">@sale.Customer</TableCellCn>
                            <TableCellCn Class="text-center">@sale.Quantity</TableCellCn>
                            <TableCellCn Class="font-mono">@sale.Price.ToString("C2")</TableCellCn>
                            <TableCellCn Class="font-mono font-semibold">@sale.Total.ToString("C2")</TableCellCn>
                            <TableCellCn>
                                <BadgeCn Class="@statusClass" Variant="BadgeVariant.Outline">@statusLabel</BadgeCn>
                            </TableCellCn>
                        </TableRowCn>
                    }
                </TableBodyCn>
            </TableCn>
        </div>
    </div>
</div>

@code {
    private record SalesData(string Id, string Date, string Product, string Customer, int Quantity, double Price, double Total, string Status);

    private static readonly SalesData[] _sales =
    [
        new("ORD001", "2024-01-15", "Premium Widget", "Acme Corp", 50, 29.99, 1499.50, "paid"),
        new("ORD002", "2024-01-14", "Standard Widget", "TechStart Inc", 100, 19.99, 1999.00, "paid"),
        new("ORD003", "2024-01-14", "Deluxe Widget", "MegaCorp Ltd", 25, 49.99, 1249.75, "pending"),
        new("ORD004", "2024-01-13", "Premium Widget", "StartUp Co", 75, 29.99, 2249.25, "paid"),
        new("ORD005", "2024-01-12", "Standard Widget", "Enterprise LLC", 200, 19.99, 3998.00, "overdue"),
        new("ORD006", "2024-01-11", "Deluxe Widget", "Global Industries", 30, 49.99, 1499.70, "paid"),
    ];

    private static readonly double _totalRevenue = _sales.Sum(s => s.Total);

    private static (string Label, string ClassName) GetStatusBadge(string status) => status switch
    {
        "paid" => ("Paid", "border-green-200 text-green-700"),
        "pending" => ("Pending", "border-orange-200 text-orange-700"),
        "overdue" => ("Overdue", "border-red-200 text-red-700"),
        _ => ("Unknown", ""),
    };
}
