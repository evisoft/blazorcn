@* ============================================================
   Block: checkout-course-enrollment
   Title: CheckoutCourseEnrollment
   Description: An online course enrollment checkout for React and Next.js with course details, collapsible curriculum preview, student info form, payment fields, and enrollment terms using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-course-enrollment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Course header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="graduation-cap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Course Enrollment</span>
            </div>
        </div>

        @* Course details *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">@_course.Title</span>
            <div class="mt-2 flex flex-wrap items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="user" Size="12" Class="size-3" />
                    @_course.Instructor
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                    @_course.Duration
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="book-open" Size="12" Class="size-3" />
                    @_course.Modules modules
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="play-circle" Size="12" Class="size-3" />
                    @_course.Students students
                </span>
            </div>
            <div class="mt-2 flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">$@_course.Price</span>
                <span class="text-muted-foreground text-xs">one-time</span>
            </div>
        </div>

        @* Curriculum preview *@
        <div class="border-b">
            <div class="px-4 py-3">
                <span class="font-medium text-sm">Curriculum</span>
                <span class="ml-2 text-muted-foreground text-xs">
                    @(_modules.Sum(m => m.LessonCount)) lessons
                </span>
            </div>
            @foreach (var mod in _modules)
            {
                var isExpanded = _expandedModule == mod.Id;
                var isLast = mod.Id == _modules[_modules.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => ToggleModule(mod.Id))"
                            class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm">@mod.Title</span>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">
                            @mod.LessonCount lessons &middot; @mod.TotalDuration
                        </span>
                    </button>
                    @if (isExpanded)
                    {
                        <div class="pb-2 pl-11 pr-4">
                            @foreach (var lesson in mod.Lessons)
                            {
                                <div class="flex items-center justify-between py-1.5">
                                    <span class="text-muted-foreground text-xs">@lesson.Title</span>
                                    <span class="shrink-0 text-muted-foreground text-xs tabular-nums">@lesson.Duration</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Student info *@
        <div class="border-b px-4 py-4">
            <span class="font-medium text-sm">Student Information</span>
            <div class="mt-3 space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="ce-name" Class="text-xs">Full name</LabelCn>
                    <InputCn Id="ce-name" Placeholder="Sarah Chen" @bind-Value="_fullName" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="ce-email" Class="text-xs">Email</LabelCn>
                    <InputCn Id="ce-email" Type="email" Placeholder="@("sarah@example.com")" @bind-Value="_email" />
                </div>
            </div>
        </div>

        @* Payment *@
        <div class="border-b px-4 py-4">
            <span class="font-medium text-sm">Payment</span>
            <div class="mt-3 space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="ce-card" Class="text-xs">Card number</LabelCn>
                    <InputCn Id="ce-card" Placeholder="4242 4242 4242 4242" @bind-Value="_cardNumber" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="ce-expiry" Class="text-xs">Expiry date</LabelCn>
                        <InputCn Id="ce-expiry" Placeholder="MM / YY" @bind-Value="_expiry" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="ce-cvv" Class="text-xs">CVV</LabelCn>
                        <InputCn Id="ce-cvv" Placeholder="123" @bind-Value="_cvv" />
                    </div>
                </div>
            </div>
        </div>

        @* Enrollment terms *@
        <div class="border-b px-4 py-3">
            <span class="flex items-start gap-3 cursor-pointer">
                <CheckboxCn Id="ce-terms" @bind-Checked="_agreedTerms" Class="mt-0.5" />
                <label for="ce-terms" class="text-muted-foreground text-xs leading-relaxed cursor-pointer">
                    I agree to the enrollment terms and understand that access is granted for the lifetime
                    of the course. Refund requests must be submitted within 30 days of enrollment.
                </label>
            </span>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full" Disabled="@(!_agreedTerms)">
                Enroll Now &middot; $@_course.Price
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Lifetime access with all future updates included
            </p>
        </div>
    </div>
</section>

@code {
    private record Lesson(string Title, string Duration);

    private record Module(string Id, string Title, int LessonCount, string TotalDuration, Lesson[] Lessons);

    private record CourseInfo(string Title, string Instructor, string Duration, int Modules, string Students, int Price);

    private static readonly CourseInfo _course = new(
        "Advanced React Patterns & Performance",
        "Sarah Chen",
        "12 hours",
        8,
        "4,230",
        149
    );

    private static readonly Module[] _modules =
    [
        new("m1", "Compound Components", 5, "1h 24m",
        [
            new("Introduction to compound patterns", "12m"),
            new("Building a flexible Tabs component", "22m"),
            new("Context-based state sharing", "18m"),
            new("Implicit vs explicit API design", "16m"),
            new("Exercise: Accordion compound component", "16m"),
        ]),
        new("m2", "Render Props & Higher-Order Components", 4, "1h 10m",
        [
            new("Render prop fundamentals", "14m"),
            new("HOC patterns and pitfalls", "20m"),
            new("Combining render props with hooks", "18m"),
            new("Exercise: Data fetching abstraction", "18m"),
        ]),
        new("m3", "Performance Optimization", 6, "1h 48m",
        [
            new("React DevTools profiling", "16m"),
            new("useMemo and useCallback deep dive", "22m"),
            new("Virtualization for large lists", "20m"),
            new("Code splitting strategies", "18m"),
            new("Suspense and lazy loading", "16m"),
            new("Exercise: Optimizing a dashboard", "16m"),
        ]),
        new("m4", "State Machines & Reducers", 4, "1h 06m",
        [
            new("useReducer for complex state", "18m"),
            new("State machine fundamentals", "16m"),
            new("XState integration with React", "20m"),
            new("Exercise: Multi-step form machine", "12m"),
        ]),
    ];

    private string? _expandedModule = "m1";
    private string _fullName = "";
    private string _email = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";
    private bool _agreedTerms = false;

    private void ToggleModule(string id)
    {
        _expandedModule = _expandedModule == id ? null : id;
    }
}
