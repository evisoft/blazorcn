@* ============================================================
   Block: checkout-membership
   Title: CheckoutMembership
   Description: A membership tier selection checkout for React and Next.js with tiered benefits, member info form, billing cycle toggle, auto-renewal notice, and terms acceptance using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-membership.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <span class="font-medium text-sm">Membership</span>
        </div>

        @* Tier selection *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Select tier</span>
            <div class="mt-2 space-y-2">
                @foreach (var t in _tiers)
                {
                    var tier = t;
                    <button
                        type="button"
                        @onclick="@(() => _selectedTier = tier.Id)"
                        class="@Cn.Merge("flex w-full items-center gap-3 rounded-md border px-3 py-2.5 text-left transition-colors", _selectedTier == tier.Id ? "border-foreground/20 bg-muted/30" : "hover:bg-muted/50")">
                        <LucideIconCn Name="@tier.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        <div class="flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@tier.Name</span>
                                @if (tier.Popular)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        Popular
                                    </BadgeCn>
                                }
                            </div>
                            <span class="text-muted-foreground text-xs">
                                $@tier.Monthly/mo or $@tier.Yearly/yr
                            </span>
                        </div>
                        @if (_selectedTier == tier.Id)
                        {
                            <span class="flex size-5 items-center justify-center rounded-full bg-foreground">
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-background" />
                            </span>
                        }
                    </button>
                }
            </div>
        </div>

        @* Benefits *@
        @{
            var activeTier = _tiers.FirstOrDefault(t => t.Id == _selectedTier);
        }
        @if (activeTier != null)
        {
            <div class="border-b px-4 py-3">
                <span class="font-medium text-sm">@activeTier.Name benefits</span>
                <div class="mt-2 space-y-1.5">
                    @foreach (var benefit in activeTier.Benefits)
                    {
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="check" Size="14" Class="size-3.5 shrink-0 text-emerald-500" />
                            <span class="text-sm">@benefit</span>
                        </div>
                    }
                </div>
            </div>
        }

        @* Billing cycle toggle *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Billing cycle</span>
            <div class="mt-2 flex gap-2">
                <button
                    type="button"
                    @onclick="@(() => _billingCycle = "monthly")"
                    class="@Cn.Merge("flex-1 rounded-md border px-3 py-2 text-center text-sm transition-colors", _billingCycle == "monthly" ? "border-foreground/20 bg-muted/30 font-medium" : "hover:bg-muted/50")">
                    Monthly
                </button>
                <button
                    type="button"
                    @onclick="@(() => _billingCycle = "yearly")"
                    class="@Cn.Merge("flex-1 rounded-md border px-3 py-2 text-center text-sm transition-colors", _billingCycle == "yearly" ? "border-foreground/20 bg-muted/30 font-medium" : "hover:bg-muted/50")">
                    <span>Yearly</span>
                    @if (activeTier != null)
                    {
                        <span class="ml-1 text-muted-foreground text-xs">
                            Save $@((activeTier.Monthly * 12 - activeTier.Yearly).ToString("F0"))
                        </span>
                    }
                </button>
            </div>
            @if (_billingCycle == "yearly" && activeTier != null)
            {
                <p class="mt-2 text-muted-foreground text-xs">$@((activeTier.Yearly / 12.0).ToString("F2"))/mo billed annually</p>
            }
        </div>

        @* Member info *@
        <div class="border-b px-4 py-4">
            <span class="font-medium text-sm">Member information</span>
            <div class="mt-3 space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="mem-name" Class="text-xs">
                        Full name
                    </LabelCn>
                    <InputCn Id="mem-name"
                             Placeholder="Alex Rivera"
                             @bind-Value="_fullName" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="mem-email" Class="text-xs">
                        Email
                    </LabelCn>
                    <InputCn Id="mem-email"
                             Type="email"
                             Placeholder="@("alex@example.com")"
                             @bind-Value="_email" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="mem-phone" Class="text-xs">
                        Phone
                    </LabelCn>
                    <InputCn Id="mem-phone"
                             Type="tel"
                             Placeholder="(555) 123-4567"
                             @bind-Value="_phone" />
                </div>
            </div>
        </div>

        @* Auto-renewal notice + terms *@
        <div class="border-b px-4 py-3 space-y-3">
            <div class="rounded-md bg-muted/50 p-3">
                <span class="font-medium text-muted-foreground text-xs">Auto-renewal</span>
                <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                    Your membership will automatically renew at $@_price/@(_billingCycle == "monthly" ? "mo" : "yr"). You can cancel anytime from your account settings before the next billing date.
                </p>
            </div>
            <span class="flex items-start gap-3 cursor-pointer">
                <CheckboxCn Id="mem-terms"
                            Checked="@_agreedTerms"
                            CheckedChanged="@((bool v) => _agreedTerms = v)"
                            Class="mt-0.5" />
                <label for="mem-terms" class="text-muted-foreground text-xs leading-relaxed cursor-pointer">
                    I agree to the membership terms, privacy policy, and auto-renewal terms described above.
                </label>
            </span>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full" Disabled="@(!_agreedTerms)">
                Join as @activeTier?.Name Member &middot; $@_price@(_billingCycle == "monthly" ? "/mo" : "/yr")
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Cancel anytime. No long-term commitment required.
            </p>
        </div>
    </div>
</section>

@code {
    private string _selectedTier = "premium";
    private string _billingCycle = "monthly";
    private string _fullName = "";
    private string _email = "";
    private string _phone = "";
    private bool _agreedTerms = false;

    private int _price => _tiers.FirstOrDefault(t => t.Id == _selectedTier) is { } tier
        ? (_billingCycle == "monthly" ? tier.Monthly : tier.Yearly)
        : 0;

    private record Tier(string Id, string Name, int Monthly, int Yearly, string IconName, bool Popular, string[] Benefits);

    private static readonly Tier[] _tiers =
    [
        new("basic", "Basic", 19, 190, "shield", false,
        [
            "Access to main facilities",
            "2 guest passes per month",
            "Member newsletter",
            "Online booking portal",
        ]),
        new("premium", "Premium", 49, 490, "star", true,
        [
            "All Basic benefits",
            "Priority reservations",
            "5 guest passes per month",
            "Access to premium lounges",
            "Quarterly member events",
            "Dedicated support line",
        ]),
        new("vip", "VIP", 99, 990, "crown", false,
        [
            "All Premium benefits",
            "Unlimited guest passes",
            "Private meeting rooms",
            "Concierge service",
            "Early access to new features",
            "Annual appreciation dinner",
            "Complimentary parking",
        ]),
    ];
}
