@* ============================================================
   Block: checkout-b2b-purchase-order
   Title: CheckoutB2bPurchaseOrder
   Description: A B2B purchase order checkout block for React and Next.js with company info fields, department, cost center, PO number, approver email, budget code, approval workflow notice, net terms selector, and company billing address using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-b2b-purchase-order.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Purchase Order</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Enterprise procurement checkout</p>
            </div>
            <span class="font-semibold text-lg tabular-nums">@_orderTotal</span>
        </div>

        @* Approval workflow notice *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3 rounded-md bg-muted/50 p-3">
                <LucideIconCn Name="clock" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Approval required</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        This purchase order will be sent to the designated approver for review. Orders are
                        typically approved within 1-2 business days. You'll receive email notifications for
                        status updates.
                    </p>
                </div>
            </div>
        </div>

        @* Company information *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="building" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-xs text-muted-foreground">Company information</span>
            </div>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="b2b-company" Class="text-xs">Company name</LabelCn>
                    <InputCn id="b2b-company" @bind-Value="_companyName" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="b2b-department" Class="text-xs">Department</LabelCn>
                        <InputCn id="b2b-department" @bind-Value="_department" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="b2b-cost-center" Class="text-xs">Cost center</LabelCn>
                        <InputCn id="b2b-cost-center" Placeholder="e.g. ENG-4200" @bind-Value="_costCenter" />
                    </div>
                </div>
            </div>
        </div>

        @* PO details *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">
                Purchase order details
            </span>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="b2b-po" Class="text-xs">PO number</LabelCn>
                    <InputCn id="b2b-po" Placeholder="e.g. PO-2026-00391" @bind-Value="_poNumber" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="b2b-approver" Class="text-xs">Approver email</LabelCn>
                        <InputCn id="b2b-approver" Type="email" Placeholder="@("manager@company.com")" @bind-Value="_approverEmail" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="b2b-budget" Class="text-xs">Budget code</LabelCn>
                        <InputCn id="b2b-budget" Placeholder="e.g. FY26-Q2-ENG" @bind-Value="_budgetCode" />
                    </div>
                </div>
            </div>
        </div>

        @* Net terms selector *@
        <div class="border-b px-4 py-4">
            <div class="space-y-1.5">
                <LabelCn Class="text-xs">Payment terms</LabelCn>
                <SelectCn @bind-Value="_netTerms">
                    <SelectTriggerCn>
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="net-15">Net 15 — Due within 15 days</SelectItemCn>
                        <SelectItemCn Value="net-30">Net 30 — Due within 30 days</SelectItemCn>
                        <SelectItemCn Value="net-45">Net 45 — Due within 45 days</SelectItemCn>
                        <SelectItemCn Value="net-60">Net 60 — Due within 60 days</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Company billing address *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">
                Billing address
            </span>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="b2b-addr1" Class="text-xs">Address line 1</LabelCn>
                    <InputCn id="b2b-addr1" @bind-Value="_addressLine1" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="b2b-addr2" Class="text-xs">Address line 2</LabelCn>
                    <InputCn id="b2b-addr2" @bind-Value="_addressLine2" />
                </div>
                <div class="grid grid-cols-3 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="b2b-city" Class="text-xs">City</LabelCn>
                        <InputCn id="b2b-city" @bind-Value="_city" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="b2b-state" Class="text-xs">State</LabelCn>
                        <InputCn id="b2b-state" @bind-Value="_state" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="b2b-zip" Class="text-xs">ZIP code</LabelCn>
                        <InputCn id="b2b-zip" @bind-Value="_zip" />
                    </div>
                </div>
            </div>
        </div>

        @* Submit *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @(_netTerms.Replace("-", " ").Replace("net", "Net"))
                    </BadgeCn>
                    <span class="text-muted-foreground text-xs">Invoice sent after approval</span>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="send" Size="12" Class="size-3" />
                    Submit PO
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private const string _orderTotal = "$12,450.00";

    private string _companyName = "Northwind Traders";
    private string _department = "Engineering";
    private string _costCenter = "ENG-4200";
    private string _poNumber = "";
    private string _approverEmail = "";
    private string _budgetCode = "";
    private string _netTerms = "net-30";
    private string _addressLine1 = "1200 Market Street";
    private string _addressLine2 = "Suite 800";
    private string _city = "San Francisco";
    private string _state = "CA";
    private string _zip = "94103";
}
