@* ============================================================
   Block: checkout-installments
   Title: CheckoutInstallments
   Description: A buy now pay later installment checkout block for React and Next.js with plan selector, four equal payment amounts with dates, monthly preview, interest rate display, and APR notice built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-installments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Pay in Installments</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Split your $@_orderTotal.ToString("F2") order into equal monthly payments.
            </p>
        </div>

        @* Plan selector *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Select a plan</span>
            <div class="mt-2 flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                @foreach (var p in _plans)
                {
                    var plan = p;
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-7 flex-1 gap-1.5 text-xs", _selectedPlan == plan.Id ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => SelectPlan(plan.Id))">
                        @plan.Months months
                        @if (plan.InterestRate == 0)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">0%</BadgeCn>
                        }
                    </ButtonCn>
                }
            </div>
        </div>

        @* Monthly amount *@
        <div class="border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">
                    $@_activePlan.MonthlyAmount.ToString("F2")
                </span>
                <span class="text-muted-foreground text-sm">/mo</span>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                for @_activePlan.Months months &middot; $@_activePlan.TotalCost.ToString("F2") total
            </p>
        </div>

        @* Payment schedule *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">
                Payment schedule @if (_showRemaining) { <text>(first 4 of @_activePlan.Months)</text> }
            </span>
            <div class="mt-2 space-y-0">
                @foreach (var item in _schedule)
                {
                    <div class="flex items-center gap-3 py-1.5">
                        <LucideIconCn Name="circle-dot"
                                      Size="14"
                                      Class="@Cn.Merge("size-3.5 shrink-0", item.Status == "next" ? "text-foreground" : "text-muted-foreground/40")" />
                        <span class="flex-1 text-sm">@item.Date</span>
                        <span class="font-medium text-sm tabular-nums">$@item.Amount.ToString("F2")</span>
                    </div>
                }
                @if (_showRemaining)
                {
                    <div class="flex items-center gap-3 py-1.5">
                        <span class="flex size-3.5 shrink-0 items-center justify-center text-muted-foreground/40 text-xs">
                            &hellip;
                        </span>
                        <span class="text-muted-foreground text-xs">
                            + @(_activePlan.Months - 4) more monthly payments
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Cost breakdown *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Cost breakdown</span>
            <div class="mt-2 space-y-1">
                <div class="flex items-center justify-between">
                    <span class="text-sm">Order total</span>
                    <span class="text-sm tabular-nums">$@_orderTotal.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm">
                        Interest
                        @if (_activePlan.InterestRate > 0)
                        {
                            <span class="text-muted-foreground text-xs"> (@(_activePlan.InterestRate)%)</span>
                        }
                    </span>
                    <span class="text-sm tabular-nums">
                        @(_interestAmount > 0.01 ? $"${_interestAmount.ToString("F2")}" : "$0.00")
                    </span>
                </div>
                <div class="flex items-center justify-between border-t pt-1.5">
                    <span class="font-medium text-sm">Total payable</span>
                    <span class="font-semibold text-sm tabular-nums">
                        $@_activePlan.TotalCost.ToString("F2")
                    </span>
                </div>
            </div>
        </div>

        @* APR notice *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="percent" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">APR disclosure</span>
                </div>
                <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                    @if (_activePlan.Apr > 0)
                    {
                        <text>Representative @(_activePlan.Apr)% APR. Total amount payable $@(_activePlan.TotalCost.ToString("F2")) over @(_activePlan.Months) monthly installments of $@(_activePlan.MonthlyAmount.ToString("F2")). Credit subject to approval.</text>
                    }
                    else
                    {
                        <text>0% APR interest-free credit. Total amount payable $@(_activePlan.TotalCost.ToString("F2")) over @(_activePlan.Months) monthly installments of $@(_activePlan.MonthlyAmount.ToString("F2")). No additional fees.</text>
                    }
                </p>
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                Confirm $@_activePlan.MonthlyAmount.ToString("F2")/mo for @_activePlan.Months months
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                First payment due Apr 24, 2026 &middot; Cancel anytime
            </p>
        </div>
    </div>
</section>

@code {
    private record InstallmentPlan(string Id, int Months, double MonthlyAmount, double InterestRate, double Apr, double TotalCost);
    private record PaymentDate(string Id, string Date, double Amount, string Status);

    private const double _orderTotal = 599.99;

    private static readonly InstallmentPlan[] _plans =
    [
        new("plan-3",  3,  204.66, 0,   0,    613.98),
        new("plan-6",  6,  105.83, 5.9, 11.2, 634.98),
        new("plan-12", 12,  55.91, 9.9, 18.6, 670.92),
    ];

    private static readonly Dictionary<string, PaymentDate[]> _scheduleByPlan = new()
    {
        ["plan-3"] =
        [
            new("p1", "Apr 24, 2026", 204.66, "next"),
            new("p2", "May 24, 2026", 204.66, "future"),
            new("p3", "Jun 24, 2026", 204.66, "future"),
        ],
        ["plan-6"] =
        [
            new("p1", "Apr 24, 2026", 105.83, "next"),
            new("p2", "May 24, 2026", 105.83, "future"),
            new("p3", "Jun 24, 2026", 105.83, "future"),
            new("p4", "Jul 24, 2026", 105.83, "future"),
        ],
        ["plan-12"] =
        [
            new("p1", "Apr 24, 2026", 55.91, "next"),
            new("p2", "May 24, 2026", 55.91, "future"),
            new("p3", "Jun 24, 2026", 55.91, "future"),
            new("p4", "Jul 24, 2026", 55.91, "future"),
        ],
    };

    private string _selectedPlan = "plan-6";

    private InstallmentPlan _activePlan => _plans.FirstOrDefault(p => p.Id == _selectedPlan) ?? _plans[1];
    private PaymentDate[] _schedule => _scheduleByPlan[_selectedPlan];
    private double _interestAmount => _activePlan.TotalCost - _orderTotal;
    private bool _showRemaining => _activePlan.Months > 4;

    private void SelectPlan(string planId)
    {
        _selectedPlan = planId;
    }
}
