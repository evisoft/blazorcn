@* ============================================================
   Block: checkout-split-layout
   Title: CheckoutSplitLayout
   Description: A two-panel checkout layout for React and Next.js with cart summary on the left and shipping plus payment form on the right using shadcn/ui Input, Label, Button, Badge, and Tailwind CSS
   Source: original/blocks/checkout/checkout-split-layout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shopping-bag" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Checkout</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_cart.Sum(i => i.Quantity) items
            </BadgeCn>
            <span class="ml-auto flex items-center gap-1 text-muted-foreground text-xs">
                <LucideIconCn Name="lock" Size="12" Class="size-3" />
                Secure
            </span>
        </div>

        @* Two-panel split *@
        <div class="grid grid-cols-1 md:grid-cols-2">
            @* Left: Cart summary *@
            <div class="border-b md:border-b-0 md:border-r">
                <div class="border-b px-4 py-2.5">
                    <span class="font-medium text-muted-foreground text-xs">Your Cart</span>
                </div>

                @{
                    var cartList = _cart.ToList();
                }
                @foreach (var it in cartList)
                {
                    var item = it;
                    var idx = cartList.IndexOf(item);
                    <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", idx < cartList.Count - 1 ? "border-b" : "")">
                        @* Image placeholder *@
                        <div class="size-12 shrink-0 rounded-md bg-muted/50"></div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@item.Name</span>
                            <p class="text-muted-foreground text-xs">@item.Variant</p>
                            <div class="mt-1.5 flex items-center gap-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-6 p-0" aria-label="@($"Decrease quantity of {item.Name}")" OnClick="@(() => UpdateQuantity(item.Id, -1))">
                                    <LucideIconCn Name="minus" Size="12" Class="size-3" />
                                </ButtonCn>
                                <span class="text-xs tabular-nums w-4 text-center">@item.Quantity</span>
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-6 p-0" aria-label="@($"Increase quantity of {item.Name}")" OnClick="@(() => UpdateQuantity(item.Id, 1))">
                                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                </ButtonCn>
                            </div>
                        </div>
                        <span class="shrink-0 font-medium text-sm tabular-nums">
                            $@((item.Price * item.Quantity).ToString("F2"))
                        </span>
                    </div>
                }

                @* Totals *@
                <div class="border-t px-4 py-3 space-y-1.5">
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Subtotal</span>
                        <span class="tabular-nums">$@_subtotal.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Shipping</span>
                        <span class="tabular-nums">$@_shipping.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Tax</span>
                        <span class="tabular-nums">$@_tax.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between border-t pt-1.5 font-medium text-sm">
                        <span>Total</span>
                        <span class="tabular-nums">$@_total.ToString("F2")</span>
                    </div>
                </div>
            </div>

            @* Right: Checkout form *@
            <div>
                @* Shipping *@
                <div class="border-b px-4 py-2.5">
                    <span class="font-medium text-muted-foreground text-xs">Shipping Address</span>
                </div>
                <div class="border-b px-4 py-3 space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="sl-first" Class="text-xs">First name</LabelCn>
                            <InputCn id="sl-first" Placeholder="Jane" @bind-Value="_firstName" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="sl-last" Class="text-xs">Last name</LabelCn>
                            <InputCn id="sl-last" Placeholder="Smith" @bind-Value="_lastName" />
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <LabelCn For="sl-email" Class="text-xs">Email</LabelCn>
                        <InputCn id="sl-email" type="email" Placeholder="@("jane@example.com")" @bind-Value="_email" />
                    </div>

                    <div class="space-y-1.5">
                        <LabelCn For="sl-address" Class="text-xs">Street address</LabelCn>
                        <InputCn id="sl-address" Placeholder="456 Oak Avenue, Suite 2" @bind-Value="_address" />
                    </div>

                    <div class="grid grid-cols-3 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="sl-city" Class="text-xs">City</LabelCn>
                            <InputCn id="sl-city" Placeholder="Austin" @bind-Value="_city" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="sl-state" Class="text-xs">State</LabelCn>
                            <InputCn id="sl-state" Placeholder="TX" @bind-Value="_stateVal" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="sl-zip" Class="text-xs">Zip</LabelCn>
                            <InputCn id="sl-zip" Placeholder="78701" @bind-Value="_zip" />
                        </div>
                    </div>
                </div>

                @* Payment *@
                <div class="border-b px-4 py-2.5">
                    <span class="font-medium text-muted-foreground text-xs">Payment</span>
                </div>
                <div class="border-b px-4 py-3 space-y-3">
                    <div class="space-y-1.5">
                        <LabelCn For="sl-card" Class="text-xs">Card number</LabelCn>
                        <InputCn id="sl-card" Placeholder="4242 4242 4242 4242" @bind-Value="_cardNumber" />
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="sl-expiry" Class="text-xs">Expiry</LabelCn>
                            <InputCn id="sl-expiry" Placeholder="MM / YY" @bind-Value="_expiry" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="sl-cvv" Class="text-xs">CVV</LabelCn>
                            <InputCn id="sl-cvv" Placeholder="123" @bind-Value="_cvv" />
                        </div>
                    </div>
                </div>

                @* Submit *@
                <div class="px-4 py-3">
                    <ButtonCn Class="w-full">Place Order &middot; $@_total.ToString("F2")</ButtonCn>
                    <p class="mt-2 text-center text-muted-foreground text-xs">
                        Encrypted with 256-bit SSL
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record CartItem(string Id, string Name, string Variant, double Price, int Quantity);

    private List<CartItem> _cart =
    [
        new("1", "Wireless Noise-Canceling Headphones", "Midnight Black",    249.0, 1),
        new("2", "Mechanical Keyboard 75%",             "White / Linear Red", 159.0, 1),
        new("3", "Laptop Stand Adjustable",             "Silver Aluminum",     79.0, 1),
        new("4", "Braided USB-C Cable 2m",              "Space Gray",          19.0, 2),
    ];

    private string _firstName  = "";
    private string _lastName   = "";
    private string _email      = "";
    private string _address    = "";
    private string _city       = "";
    private string _stateVal   = "";
    private string _zip        = "";
    private string _cardNumber = "";
    private string _expiry     = "";
    private string _cvv        = "";

    private const double _shipping = 12.99;

    private double _subtotal => _cart.Sum(i => i.Price * i.Quantity);
    private double _tax      => Math.Round(_subtotal * 0.0875, 2);
    private double _total    => Math.Round(_subtotal + _shipping + _tax, 2);

    private void UpdateQuantity(string id, int delta)
    {
        _cart = _cart.Select(i =>
        {
            if (i.Id != id) return i;
            return i with { Quantity = Math.Max(1, i.Quantity + delta) };
        }).ToList();
    }
}
