@* ============================================================
   Block: checkout-multi-step
   Title: CheckoutMultiStep
   Description: A three-step checkout wizard for React and Next.js with shipping, payment, and review steps, progress indicators, and back/next navigation using shadcn/ui Input, Label, Button, and Tailwind CSS
   Source: original/blocks/checkout/checkout-multi-step.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Progress bar *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                @foreach (var step in _steps)
                {
                    var stepIndex = Array.IndexOf(_steps, step);
                    <div class="flex items-center gap-2">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("flex size-6 items-center justify-center rounded-full text-xs font-medium transition-colors", _currentStep > step.Id ? "bg-foreground text-background" : _currentStep == step.Id ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                                @if (_currentStep > step.Id)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    @step.Id
                                }
                            </span>
                            <span class="@Cn.Merge("text-xs font-medium", _currentStep >= step.Id ? "text-foreground" : "text-muted-foreground")">
                                @step.Label
                            </span>
                        </div>
                        @if (stepIndex < _steps.Length - 1)
                        {
                            <div class="@Cn.Merge("mx-2 h-px w-12 sm:w-20", _currentStep > step.Id ? "bg-foreground" : "bg-muted")"></div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Step 1: Shipping *@
        @if (_currentStep == 1)
        {
            <div class="px-4 py-4">
                <div class="flex items-center gap-2 mb-3">
                    <LucideIconCn Name="truck" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Shipping Address</span>
                </div>
                <div class="space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="ms-first" Class="text-xs">First name</LabelCn>
                            <InputCn Id="ms-first" Placeholder="Jane" @bind-Value="_shippingFirstName" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="ms-last" Class="text-xs">Last name</LabelCn>
                            <InputCn Id="ms-last" Placeholder="Smith" @bind-Value="_shippingLastName" />
                        </div>
                    </div>

                    <div class="space-y-1.5">
                        <LabelCn For="ms-email" Class="text-xs">Email</LabelCn>
                        <InputCn Id="ms-email" Type="email" Placeholder="@("jane@example.com")" @bind-Value="_shippingEmail" />
                    </div>

                    <div class="space-y-1.5">
                        <LabelCn For="ms-address" Class="text-xs">Street address</LabelCn>
                        <InputCn Id="ms-address" Placeholder="742 Evergreen Terrace" @bind-Value="_shippingAddress" />
                    </div>

                    <div class="grid grid-cols-3 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="ms-city" Class="text-xs">City</LabelCn>
                            <InputCn Id="ms-city" Placeholder="Portland" @bind-Value="_shippingCity" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="ms-state" Class="text-xs">State</LabelCn>
                            <InputCn Id="ms-state" Placeholder="OR" @bind-Value="_shippingState" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="ms-zip" Class="text-xs">Zip code</LabelCn>
                            <InputCn Id="ms-zip" Placeholder="97201" @bind-Value="_shippingZip" />
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Step 2: Payment *@
        @if (_currentStep == 2)
        {
            <div class="px-4 py-4">
                <div class="flex items-center gap-2 mb-3">
                    <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Payment Details</span>
                </div>
                <div class="space-y-3">
                    <div class="space-y-1.5">
                        <LabelCn For="ms-name-card" Class="text-xs">Name on card</LabelCn>
                        <InputCn Id="ms-name-card" Placeholder="Jane Smith" @bind-Value="_paymentNameOnCard" />
                    </div>

                    <div class="space-y-1.5">
                        <LabelCn For="ms-card" Class="text-xs">Card number</LabelCn>
                        <InputCn Id="ms-card" Placeholder="4242 4242 4242 4242" @bind-Value="_paymentCardNumber" />
                    </div>

                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="ms-expiry" Class="text-xs">Expiry date</LabelCn>
                            <InputCn Id="ms-expiry" Placeholder="MM / YY" @bind-Value="_paymentExpiry" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="ms-cvv" Class="text-xs">CVV</LabelCn>
                            <InputCn Id="ms-cvv" Placeholder="123" @bind-Value="_paymentCvv" />
                        </div>
                    </div>

                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-muted-foreground text-xs">
                            Your card will be charged $241.28 including tax and shipping. All transactions are
                            encrypted with 256-bit SSL.
                        </p>
                    </div>
                </div>
            </div>
        }

        @* Step 3: Review *@
        @if (_currentStep == 3)
        {
            <div class="px-4 py-4">
                <div class="flex items-center gap-2 mb-3">
                    <LucideIconCn Name="package" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Review Your Order</span>
                </div>

                @* Shipping summary *@
                <div class="rounded-md bg-muted/50 p-3 mb-3">
                    <span class="font-medium text-muted-foreground text-xs">Shipping to</span>
                    <p class="mt-1 text-sm">
                        @(string.IsNullOrEmpty(_shippingFirstName) ? "Jane" : _shippingFirstName) @(string.IsNullOrEmpty(_shippingLastName) ? "Smith" : _shippingLastName)
                    </p>
                    <p class="text-muted-foreground text-xs">
                        @(string.IsNullOrEmpty(_shippingAddress) ? "742 Evergreen Terrace" : _shippingAddress), @(string.IsNullOrEmpty(_shippingCity) ? "Portland" : _shippingCity),
                        @(string.IsNullOrEmpty(_shippingState) ? "OR" : _shippingState) @(string.IsNullOrEmpty(_shippingZip) ? "97201" : _shippingZip)
                    </p>
                    <p class="text-muted-foreground text-xs">
                        @(string.IsNullOrEmpty(_shippingEmail) ? "jane@example.com" : _shippingEmail)
                    </p>
                </div>

                @* Payment summary *@
                <div class="rounded-md bg-muted/50 p-3 mb-3">
                    <span class="font-medium text-muted-foreground text-xs">Payment method</span>
                    <p class="mt-1 text-sm">
                        Card ending in @(string.IsNullOrEmpty(_paymentCardNumber) ? "4242" : (_paymentCardNumber.Length >= 4 ? _paymentCardNumber[^4..] : _paymentCardNumber))
                    </p>
                    <p class="text-muted-foreground text-xs">@(string.IsNullOrEmpty(_paymentNameOnCard) ? "Jane Smith" : _paymentNameOnCard)</p>
                </div>

                @* Order items *@
                <div class="space-y-0">
                    <div class="flex items-center justify-between py-2 border-b">
                        <div>
                            <span class="text-sm">Minimal Desk Lamp</span>
                            <p class="text-muted-foreground text-xs">Matte Black &middot; Qty 1</p>
                        </div>
                        <span class="text-sm tabular-nums">$89.00</span>
                    </div>
                    <div class="flex items-center justify-between py-2 border-b">
                        <div>
                            <span class="text-sm">Ergonomic Mouse Pad</span>
                            <p class="text-muted-foreground text-xs">Charcoal / Large &middot; Qty 2</p>
                        </div>
                        <span class="text-sm tabular-nums">$68.00</span>
                    </div>
                    <div class="flex items-center justify-between py-2">
                        <div>
                            <span class="text-sm">USB-C Hub 7-in-1</span>
                            <p class="text-muted-foreground text-xs">Space Gray &middot; Qty 1</p>
                        </div>
                        <span class="text-sm tabular-nums">$59.00</span>
                    </div>
                </div>

                <div class="mt-3 space-y-1 border-t pt-3">
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Subtotal</span>
                        <span class="tabular-nums">$216.00</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Shipping</span>
                        <span class="tabular-nums">$8.99</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Tax</span>
                        <span class="tabular-nums">$16.29</span>
                    </div>
                    <div class="flex justify-between text-sm font-medium pt-1.5 border-t">
                        <span>Total</span>
                        <span class="tabular-nums">$241.28</span>
                    </div>
                </div>
            </div>
        }

        @* Navigation *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                      @onclick="GoBack" Disabled="@(_currentStep == 1)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>

            @if (_currentStep < 3)
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs" @onclick="GoForward">
                    Continue
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                </ButtonCn>
            }
            else
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Place Order
                </ButtonCn>
            }
        </div>

    </div>
</section>

@code {
    private int _currentStep = 1;

    // Shipping fields
    private string _shippingFirstName = "";
    private string _shippingLastName = "";
    private string _shippingEmail = "";
    private string _shippingAddress = "";
    private string _shippingCity = "";
    private string _shippingState = "";
    private string _shippingZip = "";

    // Payment fields
    private string _paymentNameOnCard = "";
    private string _paymentCardNumber = "";
    private string _paymentExpiry = "";
    private string _paymentCvv = "";

    private record StepInfo(int Id, string Label, string Icon);

    private static readonly StepInfo[] _steps =
    [
        new(1, "Shipping", "truck"),
        new(2, "Payment", "credit-card"),
        new(3, "Review", "package"),
    ];

    private void GoBack()
    {
        if (_currentStep > 1)
            _currentStep--;
    }

    private void GoForward()
    {
        if (_currentStep < 3)
            _currentStep++;
    }
}
