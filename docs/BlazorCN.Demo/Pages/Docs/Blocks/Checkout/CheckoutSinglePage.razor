@* ============================================================
   Block: checkout-single-page
   Title: CheckoutSinglePage
   Description: A single-page checkout form for React and Next.js with shipping address, payment method, and order summary sections using shadcn/ui Input, Label, Button, Separator, and Tailwind CSS
   Source: original/blocks/checkout/checkout-single-page.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="lock" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Secure Checkout</span>
            <span class="ml-auto text-muted-foreground text-xs">@(_orderItems.Length) items</span>
        </div>

        @* Shipping section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="truck" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Shipping Address</span>
            </div>

            <div class="space-y-3">
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="sp-first" Class="text-xs">First name</LabelCn>
                        <InputCn Id="sp-first" Placeholder="Jane" @bind-Value="_firstName" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="sp-last" Class="text-xs">Last name</LabelCn>
                        <InputCn Id="sp-last" Placeholder="Smith" @bind-Value="_lastName" />
                    </div>
                </div>

                <div class="space-y-1.5">
                    <LabelCn For="sp-email" Class="text-xs">Email</LabelCn>
                    <InputCn Id="sp-email" Type="email" Placeholder="@("jane@example.com")" @bind-Value="_email" />
                </div>

                <div class="space-y-1.5">
                    <LabelCn For="sp-address" Class="text-xs">Street address</LabelCn>
                    <InputCn Id="sp-address" Placeholder="123 Main St, Apt 4B" @bind-Value="_address" />
                </div>

                <div class="grid grid-cols-3 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="sp-city" Class="text-xs">City</LabelCn>
                        <InputCn Id="sp-city" Placeholder="San Francisco" @bind-Value="_city" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="sp-state" Class="text-xs">State</LabelCn>
                        <SelectCn @bind-Value="_state">
                            <SelectTriggerCn id="sp-state">
                                <SelectValueCn Placeholder="State" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="CA">California</SelectItemCn>
                                <SelectItemCn Value="NY">New York</SelectItemCn>
                                <SelectItemCn Value="TX">Texas</SelectItemCn>
                                <SelectItemCn Value="WA">Washington</SelectItemCn>
                                <SelectItemCn Value="IL">Illinois</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="sp-zip" Class="text-xs">Zip code</LabelCn>
                        <InputCn Id="sp-zip" Placeholder="94102" @bind-Value="_zip" />
                    </div>
                </div>
            </div>
        </div>

        @* Payment section *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Payment Method</span>
            </div>

            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="sp-name-card" Class="text-xs">Name on card</LabelCn>
                    <InputCn Id="sp-name-card" Placeholder="Jane Smith" @bind-Value="_nameOnCard" />
                </div>

                <div class="space-y-1.5">
                    <LabelCn For="sp-card" Class="text-xs">Card number</LabelCn>
                    <InputCn Id="sp-card" Placeholder="4242 4242 4242 4242" @bind-Value="_cardNumber" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="sp-expiry" Class="text-xs">Expiry date</LabelCn>
                        <InputCn Id="sp-expiry" Placeholder="MM / YY" @bind-Value="_expiry" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="sp-cvv" Class="text-xs">CVV</LabelCn>
                        <InputCn Id="sp-cvv" Placeholder="123" @bind-Value="_cvv" />
                    </div>
                </div>
            </div>
        </div>

        @* Order summary *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Order Summary</span>
            <div class="mt-3 space-y-0">
                @foreach (var it in _orderItems)
                {
                    var item = it;
                    var isLast = item.Id == _orderItems[_orderItems.Length - 1].Id;
                    <div class="@Cn.Merge("flex items-center justify-between py-2", isLast ? "" : "border-b")">
                        <div class="min-w-0 flex-1">
                            <span class="text-sm">@item.Name</span>
                            <p class="text-muted-foreground text-xs">@item.Variant &middot; Qty @item.Quantity</p>
                        </div>
                        <span class="font-medium text-sm tabular-nums">$@((item.Price * item.Quantity).ToString("F2"))</span>
                    </div>
                }
            </div>
        </div>

        @* Totals *@
        <div class="border-b px-4 py-3 space-y-1.5">
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Subtotal</span>
                <span class="tabular-nums">$@(_subtotal.ToString("F2"))</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Shipping</span>
                <span class="tabular-nums">$@(_shipping.ToString("F2"))</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Tax</span>
                <span class="tabular-nums">$@(_tax.ToString("F2"))</span>
            </div>
            <div class="flex justify-between text-sm font-medium pt-1.5 border-t">
                <span>Total</span>
                <span class="tabular-nums">$@(_total.ToString("F2"))</span>
            </div>
        </div>

        @* Place order *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">Place Order</ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Your payment is encrypted and secure
            </p>
        </div>

    </div>
</section>

@code {
    private record OrderItem(string Id, string Name, string Variant, double Price, int Quantity);

    private static readonly OrderItem[] _orderItems =
    [
        new("1", "Minimal Desk Lamp", "Matte Black", 89, 1),
        new("2", "Ergonomic Mouse Pad", "Charcoal / Large", 34, 2),
        new("3", "USB-C Hub 7-in-1", "Space Gray", 59, 1),
    ];

    private static readonly double _shipping = 8.99;
    private static readonly double _tax = 17.29;

    private double _subtotal => _orderItems.Sum(i => i.Price * i.Quantity);
    private double _total => _subtotal + _shipping + _tax;

    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private string _address = "";
    private string _city = "";
    private string _state = "";
    private string _zip = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";
    private string _nameOnCard = "";
}
