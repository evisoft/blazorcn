@* ============================================================
   Block: checkout-sidebar-cart
   Title: CheckoutSidebarCart
   Description: A checkout form for React and Next.js with a collapsible cart summary at the top, shipping form, and payment section using shadcn/ui Input, Label, Button, Badge, and Tailwind CSS
   Source: original/blocks/checkout/checkout-sidebar-cart.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Collapsible cart *@
        <div class="border-b">
            <button
                type="button"
                @onclick="@(() => _cartOpen = !_cartOpen)"
                class="flex w-full items-center justify-between px-4 py-3 transition-colors hover:bg-muted/50">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="shopping-cart" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Cart</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_itemCount items</BadgeCn>
                </div>
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm tabular-nums">$@(_total.ToString("F2"))</span>
                    <LucideIconCn Name="chevron-down" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground transition-transform duration-200", _cartOpen ? "rotate-180" : "")" />
                </div>
            </button>

            @if (_cartOpen)
            {
                <div class="border-t">
                    @foreach (var item in _cartItems)
                    {
                        var isLast = item.Id == _cartItems[^1].Id;
                        <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b")">
                            <div class="min-w-0 flex-1">
                                <span class="text-sm">@item.Name</span>
                                <p class="text-muted-foreground text-xs">@item.Variant &middot; Qty @item.Quantity</p>
                            </div>
                            <span class="font-medium text-sm tabular-nums">$@((item.Price * item.Quantity).ToString("F2"))</span>
                        </div>
                    }

                    <div class="border-t px-4 py-3 space-y-1.5">
                        <div class="flex justify-between text-xs text-muted-foreground">
                            <span>Subtotal</span>
                            <span class="tabular-nums">$@(_subtotal.ToString("F2"))</span>
                        </div>
                        <div class="flex justify-between text-xs text-muted-foreground">
                            <span>Shipping</span>
                            <span class="tabular-nums">$@(_shipping.ToString("F2"))</span>
                        </div>
                        <div class="flex justify-between text-xs text-muted-foreground">
                            <span>Tax</span>
                            <span class="tabular-nums">$@(_tax.ToString("F2"))</span>
                        </div>
                        <div class="flex justify-between border-t pt-1.5 font-medium text-sm">
                            <span>Total</span>
                            <span class="tabular-nums">$@(_total.ToString("F2"))</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Shipping *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="truck" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Shipping</span>
            </div>

            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="sc-email" Class="text-xs">Email</LabelCn>
                    <InputCn Id="sc-email" Type="email" Placeholder="@("you@example.com")" @bind-Value="_email" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="sc-first" Class="text-xs">First name</LabelCn>
                        <InputCn Id="sc-first" Placeholder="Jane" @bind-Value="_firstName" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="sc-last" Class="text-xs">Last name</LabelCn>
                        <InputCn Id="sc-last" Placeholder="Smith" @bind-Value="_lastName" />
                    </div>
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="sc-address" Class="text-xs">Street address</LabelCn>
                    <InputCn Id="sc-address" Placeholder="123 Main St, Apt 4B" @bind-Value="_address" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="sc-city" Class="text-xs">City</LabelCn>
                        <InputCn Id="sc-city" Placeholder="San Francisco" @bind-Value="_city" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="sc-zip" Class="text-xs">Zip code</LabelCn>
                        <InputCn Id="sc-zip" Placeholder="94102" @bind-Value="_zip" />
                    </div>
                </div>
            </div>
        </div>

        @* Payment *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Payment</span>
            </div>

            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="sc-name-card" Class="text-xs">Name on card</LabelCn>
                    <InputCn Id="sc-name-card" Placeholder="Jane Smith" @bind-Value="_nameOnCard" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="sc-card" Class="text-xs">Card number</LabelCn>
                    <InputCn Id="sc-card" Placeholder="4242 4242 4242 4242" @bind-Value="_cardNumber" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="sc-expiry" Class="text-xs">Expiry</LabelCn>
                        <InputCn Id="sc-expiry" Placeholder="MM / YY" @bind-Value="_expiry" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="sc-cvv" Class="text-xs">CVV</LabelCn>
                        <InputCn Id="sc-cvv" Placeholder="123" @bind-Value="_cvv" />
                    </div>
                </div>
            </div>
        </div>

        @* Place order *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">Place Order &middot; $@(_total.ToString("F2"))</ButtonCn>
            <p class="mt-2 flex items-center justify-center gap-1 text-muted-foreground text-xs">
                <LucideIconCn Name="lock" Size="12" Class="size-3" />
                Your payment is encrypted and secure
            </p>
        </div>
    </div>
</section>

@code {
    private record CartItem(string Id, string Name, string Variant, double Price, int Quantity);

    private static readonly CartItem[] _cartItems =
    [
        new("1", "Merino Wool Crewneck", "Heather Gray / M", 98, 1),
        new("2", "Slim Chinos", "Navy / 32x32", 79, 1),
        new("3", "Canvas Belt", "Tan / M", 35, 1),
        new("4", "No-Show Socks 3-Pack", "Mixed / One Size", 24, 2),
    ];

    private static readonly double _subtotal = 98 * 1 + 79 * 1 + 35 * 1 + 24 * 2;
    private static readonly double _shipping = 9.99;
    private static readonly double _tax = 25.82;
    private static readonly double _total = _subtotal + _shipping + _tax;
    private static readonly int _itemCount = 1 + 1 + 1 + 2;

    private bool _cartOpen = true;

    private string _email = "";
    private string _firstName = "";
    private string _lastName = "";
    private string _address = "";
    private string _city = "";
    private string _zip = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";
    private string _nameOnCard = "";
}
