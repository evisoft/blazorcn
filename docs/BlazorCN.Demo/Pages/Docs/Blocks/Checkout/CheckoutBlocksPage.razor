@code {
    private record CartItem(string Id, string Name, string Variant, int Price, int Quantity);
    private record AddOn(string Id, string Name, string Description, int Price);
    private record Suggestion(string Id, string Name, int Price);

    private static readonly CartItem[] _cartItems =
    [
        new(""c1"", ""Wireless Noise-Canceling Headphones"", ""Matte Black"", 249, 1),
        new(""c2"", ""USB-C Charging Cable"", ""2m Braided"", 19, 1),
    ];

    private static readonly AddOn[] _addOns =
    [
        new(""a1"", ""Premium Carrying Case"", ""Hard-shell EVA case with cable pocket"", 34),
        new(""a2"", ""Extended Warranty"", ""2-year accidental damage protection"", 29),
        new(""a3"", ""Replacement Ear Cushions"", ""Memory foam, pack of 2"", 18),
    ];

    private static readonly Suggestion[] _suggestions =
    [
        new(""s1"", ""Headphone Stand"", 24),
        new(""s2"", ""Audio Adapter 3.5mm"", 9),
        new(""s3"", ""Microfiber Cleaning Cloth"", 6),
    ];

    private HashSet<string> _selectedAddOns = [];

    private void ToggleAddOn(string id)
    {
        if (!_selectedAddOns.Remove(id))
            _selectedAddOns.Add(id);
    }

    private int _cartSubtotal => _cartItems.Sum(i => i.Price * i.Quantity);

    private int _addOnTotal => _addOns
        .Where(a => _selectedAddOns.Contains(a.Id))
        .Sum(a => a.Price);

    private int _bundleDiscountPercent => _selectedAddOns.Count >= 3 ? 10 : _selectedAddOns.Count >= 2 ? 5 : 0;

    private int _bundleDiscountAmount => _bundleDiscountPercent > 0
        ? (int)Math.Round(_addOnTotal * (_bundleDiscountPercent / 100.0))
        : 0;

    private int _total => _cartSubtotal + _addOnTotal - _bundleDiscountAmount;
}";

