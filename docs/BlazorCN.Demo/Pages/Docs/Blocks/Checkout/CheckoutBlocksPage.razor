                    var phaseIndex = System.Array.IndexOf(_timeline, phase);
                    <div class=""flex items-center gap-2"">
                        <LucideIconCn Name=""circle-dot"" Size=""12"" Class=""@Cn.Merge(""size-3 shrink-0"", phaseIndex == 0 ? ""text-foreground"" : ""text-muted-foreground/50"")"" />
                        <span class=""flex-1 text-sm"">@phase.Label</span>
                        <span class=""text-muted-foreground text-xs"">@phase.Duration</span>
                    </div>
                }
            </div>
        </div>

        @* Payment option *@
        <div class=""border-b px-4 py-3"">
            <span class=""font-medium text-sm"">Payment option</span>
            <div class=""mt-2 flex gap-2"">
                <button type=""button""
                        class=""@Cn.Merge(""flex-1 rounded-md border px-3 py-2 text-left transition-colors"", _paymentOption == ""deposit"" ? ""border-foreground/20 bg-muted/30"" : ""hover:bg-muted/50"")""
                        @onclick=""@(() => _paymentOption = ""deposit"")"">
                    <span class=""block font-medium text-sm"">@_depositPercent% Deposit</span>
                    <span class=""text-muted-foreground text-xs"">
                        $@(DepositAmount.ToString(""N0"")) now, remainder on completion
                    </span>
                </button>
                <button type=""button""
                        class=""@Cn.Merge(""flex-1 rounded-md border px-3 py-2 text-left transition-colors"", _paymentOption == ""full"" ? ""border-foreground/20 bg-muted/30"" : ""hover:bg-muted/50"")""
                        @onclick=""@(() => _paymentOption = ""full"")"">
                    <span class=""block font-medium text-sm"">Full Payment</span>
                    <span class=""text-muted-foreground text-xs"">$@(Total.ToString(""N0"")) today</span>
                </button>
            </div>
        </div>

        @* Totals *@
        <div class=""border-b px-4 py-3 space-y-1.5"">
            <div class=""flex justify-between text-sm"">
                <span class=""text-muted-foreground"">Base package</span>
                <span class=""tabular-nums"">$@(_packagePrice.ToString(""N0""))</span>
            </div>
            @if (AddOnsTotal > 0)
            {
                <div class=""flex justify-between text-sm"">
                    <span class=""text-muted-foreground"">Add-ons (@_selectedAddOns.Count)</span>
                    <span class=""tabular-nums"">$@(AddOnsTotal.ToString(""N0""))</span>
                </div>
            }
            <div class=""flex justify-between border-t pt-1.5 text-sm font-medium"">
                <span>Total</span>
                <span class=""tabular-nums"">$@(Total.ToString(""N0""))</span>
            </div>
            @if (_paymentOption == ""deposit"")
            {
                <div class=""flex justify-between text-sm"">
                    <span class=""text-muted-foreground"">Due today (@_depositPercent% deposit)</span>
                    <span class=""font-medium tabular-nums"">$@(DepositAmount.ToString(""N0""))</span>
                </div>
            }
        </div>

        @* Service agreement *@
        <div class=""border-b px-4 py-3"">
            <span class=""flex items-start gap-3 cursor-pointer"">
                <CheckboxCn id=""sp-terms""
                            Checked=""@_agreedTerms""
                            CheckedChanged=""@((bool val) => _agreedTerms = val)""
                            Class=""mt-0.5"" />
                <label for=""sp-terms""
                       class=""text-muted-foreground text-xs leading-relaxed cursor-pointer"">
                    I agree to the service agreement and understand that the project timeline is an
                    estimate. Deliverables are subject to the revision policy outlined in the package
                    terms. Deposits are non-refundable once work begins.
                </label>
            </span>
        </div>

        @* CTA *@
        <div class=""px-4 py-3"">
            <ButtonCn Class=""w-full"" Disabled=""@(!_agreedTerms)"">
                @(_paymentOption == ""deposit"" ? ""Pay Deposit"" : ""Pay in Full"") &middot; $@(DueToday.ToString(""N0""))
            </ButtonCn>
            <p class=""mt-2 text-center text-muted-foreground text-xs"">
                @(_paymentOption == ""deposit""
                    ? $""Remaining ${(Total - DepositAmount).ToString(""N0"")} due upon project completion""
                    : ""One-time payment for the full project scope"")
            </p>
        </div>

    </div>
</section>

