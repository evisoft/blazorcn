    private record ReferralEntry(string Id, string Name, string Status, int Amount);

    private const int CreditBalance = 45;
    private const int CreditPerReferral = 10;
    private const int OrderSubtotal = 89;
    private const string ReferralLink = ""https://acme.com/ref/sarah-k"";

    private static readonly Dictionary<string, int> _referralCodes = new()
    {
        [""FRIEND-ALEX""] = 10,
        [""FRIEND-MAYA""] = 10,
        [""FRIEND-JORDAN""] = 10,
    };

    private static readonly ReferralEntry[] _referralHistory =
    [
        new(""1"", ""Alex Chen"",       ""credited"", 10),
        new(""2"", ""Maya Rodriguez"",  ""credited"", 10),
        new(""3"", ""Jordan Lee"",      ""credited"", 10),
        new(""4"", ""Sam Taylor"",      ""pending"",  10),
    ];

    private bool _applyCredits = true;
    private string _referralCode = """";
    private string? _error = null;
    private int? _addedCredit = null;
    private bool _linkCopied = false;

    private int _effectiveBalance => CreditBalance + (_addedCredit ?? 0);
    private int _appliedAmount => _applyCredits ? Math.Min(_effectiveBalance, OrderSubtotal) : 0;
    private int _remainingCredit => _effectiveBalance - _appliedAmount;
    private int _amountDue => OrderSubtotal - _appliedAmount;

    private void HandleApplyCode()
    {
        var trimmed = _referralCode.Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(trimmed))
        {
            _error = ""Enter a referral code."";
            return;
        }

        if (!_referralCodes.TryGetValue(trimmed, out var reward))
        {
            _error = ""Invalid referral code. Ask your friend to double-check it."";
            return;
        }

        _addedCredit = reward;
        _referralCode = """";
        _error = null;
    }

    private async Task HandleCopyLink()
    {
        _linkCopied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _linkCopied = false;
    }
}";

