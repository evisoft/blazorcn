    private static readonly Tier[] _tiers =
    [
        new(""Bronze"",  0,    ""text-orange-700 dark:text-orange-400""),
        new(""Silver"",  500,  ""text-zinc-500 dark:text-zinc-400""),
        new(""Gold"",    1500, ""text-amber-600 dark:text-amber-400""),
        new(""Platinum"",5000, ""text-indigo-600 dark:text-indigo-400""),
    ];

    private const int CurrentPoints = 1285;
    private const double OrderSubtotal = 199.99;
    private const int PointsFromOrder = 200;
    private const int ProjectedPoints = CurrentPoints + PointsFromOrder;

    private static readonly Benefit[] _nextTierBenefits =
    [
        new(""1"", ""Free express shipping"",  ""On all orders, no minimum""),
        new(""2"", ""10% member discount"",    ""Applied automatically at checkout""),
        new(""3"", ""Early access to sales"",  ""48-hour head start on new drops""),
        new(""4"", ""Birthday bonus points"",  ""500 bonus points on your birthday""),
    ];

    private int _currentTierIndex => _tiers.Select((t, i) => new { t, i })
        .Where(x => CurrentPoints >= x.t.Threshold)
        .Select(x => x.i)
        .DefaultIfEmpty(0)
        .Last();

    private Tier _currentTier => _tiers[_currentTierIndex];
    private Tier? _nextTier => _currentTierIndex + 1 < _tiers.Length ? _tiers[_currentTierIndex + 1] : null;

    private int _pointsToNext => _nextTier != null ? _nextTier.Threshold - ProjectedPoints : 0;

    private double _progressPercent => _nextTier != null
        ? Math.Min(
            ((double)(ProjectedPoints - _currentTier.Threshold) / (_nextTier.Threshold - _currentTier.Threshold)) * 100,
            100)
        : 100;
}";

