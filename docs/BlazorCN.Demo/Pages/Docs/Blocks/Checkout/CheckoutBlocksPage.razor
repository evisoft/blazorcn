@code {
    private record Product(string Id, string Name, string Description, double Price, string Category);

    private const int BundleSize = 3;
    private const double BundleDiscount = 0.15;

    private static readonly Product[] _products =
    [
        new(""p1"", ""Ceramic Pour-Over Dripper"", ""Hand-thrown stoneware, 2-cup capacity"", 38, ""Brew""),
        new(""p2"", ""Burr Coffee Grinder"", ""15 grind settings, 60g hopper"", 54, ""Grind""),
        new(""p3"", ""Double-Wall Glass Mugs"", ""Set of 2, 350ml borosilicate glass"", 28, ""Serve""),
        new(""p4"", ""Digital Brew Scale"", ""0.1g precision, built-in timer"", 42, ""Measure""),
        new(""p5"", ""Gooseneck Kettle"", ""1.0L, temperature control, matte finish"", 64, ""Heat""),
        new(""p6"", ""Single Origin Sampler"", ""4 x 100g bags, light to dark roast"", 32, ""Beans""),
    ];

    private HashSet<string> _selectedIds = [""p1"", ""p3"", ""p4""];

    private double IndividualTotal => _products.Where(p => _selectedIds.Contains(p.Id)).Sum(p => p.Price);
    private double BundlePrice => IndividualTotal * (1 - BundleDiscount);
    private double Savings => IndividualTotal - BundlePrice;
    private bool _isBundleComplete => _selectedIds.Count == BundleSize;

