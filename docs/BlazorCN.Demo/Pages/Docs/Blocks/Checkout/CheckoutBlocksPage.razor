@code {
    private record CartItem(string Id, string Name, int Price);

    private record CouponDef(string Code, string Type, int Value, string Label);

    private record AppliedCoupon(string Code, string Type, int Value, string Label, int Savings);

    private static readonly CartItem[] _cartItems =
    [
        new(""1"", ""Ceramic Pour-Over Dripper"", 42),
        new(""2"", ""Single Origin Coffee Beans (340g)"", 24),
        new(""3"", ""Insulated Travel Mug"", 38),
        new(""4"", ""Reusable Coffee Filters (3-pack)"", 18),
        new(""5"", ""Digital Coffee Scale"", 34),
    ];

    private static readonly Dictionary<string, CouponDef> _couponDatabase = new()
    {
        [""SAVE15""]   = new(""SAVE15"",   ""percentage"", 15, ""15% off""),
        [""FLAT10""]   = new(""FLAT10"",   ""fixed"",      10, ""$10 off""),
        [""FREESHIP""] = new(""FREESHIP"", ""shipping"",    0, ""Free shipping""),
        [""WELCOME5""] = new(""WELCOME5"", ""fixed"",       5, ""$5 welcome discount""),
        [""EXTRA20""]  = new(""EXTRA20"",  ""percentage"", 20, ""20% off""),
    };

    private const int _orderSubtotal = 156;
    private const int _shippingCost = 12;

    private List<AppliedCoupon> _appliedCoupons =
    [
        new(""SAVE15"", ""percentage"", 15, ""15% off"", 23),
    ];

    private string _code = """";
    private string? _error = null;

    private bool _hasFreeship => _appliedCoupons.Any(c => c.Type == ""shipping"");
    private int _effectiveShipping => _hasFreeship ? 0 : _shippingCost;
    private int _discountFromCoupons => _appliedCoupons.Where(c => c.Type != ""shipping"").Sum(c => c.Savings);
    private int _finalTotal => Math.Max(0, _orderSubtotal - _discountFromCoupons + _effectiveShipping);

    private int CalculateSavings(CouponDef coupon)
    {
        if (coupon.Type == ""percentage"") return (int)Math.Round(_orderSubtotal * (coupon.Value / 100.0));
        if (coupon.Type == ""fixed"")      return coupon.Value;
        if (coupon.Type == ""shipping"")   return _shippingCost;
        return 0;
    }

    private void HandleApply()
    {
        var upperCode = _code.Trim().ToUpperInvariant();

        if (string.IsNullOrEmpty(upperCode))
        {
            _error = ""Enter a coupon code."";
            return;
        }

        if (_appliedCoupons.Any(c => c.Code == upperCode))
        {
            _error = ""This code is already applied."";
            return;
        }

        if (!_couponDatabase.TryGetValue(upperCode, out var couponDef))
        {
            _error = ""Invalid coupon code. Please check and try again."";
            return;
        }

        var savings = CalculateSavings(couponDef);
        _appliedCoupons = [.._appliedCoupons, new(couponDef.Code, couponDef.Type, couponDef.Value, couponDef.Label, savings)];
        _code = """";
        _error = null;
    }

    private void RemoveCoupon(string couponCode)
    {
        _appliedCoupons = _appliedCoupons.Where(c => c.Code != couponCode).ToList();
    }
}";

