    private double _originalTotal => _initialItems.Sum(i => i.OriginalPrice * i.Quantity);
    private double _currentTotal => _items.Sum(i => i.CurrentPrice * i.Quantity);

    private void UpdateQuantity(string id, int delta)
    {
        _items = _items.Select(i =>
        {
            if (i.Id != id) return i;
            return i with { Quantity = Math.Max(1, i.Quantity + delta) };
        }).ToList();
    }

    private void AddToCart(string id)
    {
        _addedItems = [.._addedItems, id];
    }
}";

