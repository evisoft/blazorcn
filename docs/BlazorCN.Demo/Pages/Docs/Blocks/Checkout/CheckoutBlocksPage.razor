@code {
    private record OrderItem(string Id, string Sku, string Name, double UnitPrice, int Quantity, int InStock);

    private const double MinimumOrder = 500.0;
    private readonly double _minimumOrder = MinimumOrder;

    private List<OrderItem> _items =
    [
        new(""1"", ""WH-TEE-001"", ""Classic Cotton Tee"",       8.50,  50,  500),
        new(""2"", ""WH-POL-014"", ""Performance Polo"",        14.25,  30,  200),
        new(""3"", ""WH-HOD-008"", ""Heavyweight Hoodie"",      22.00,  25,  150),
        new(""4"", ""WH-CAP-003"", ""Structured Snapback Cap"",  6.75, 100, 1000),
        new(""5"", ""WH-JKT-021"", ""Softshell Jacket"",        34.50,   0,   80),
        new(""6"", ""WH-BAG-009"", ""Canvas Tote Bag"",          4.25,   0,  600),
    ];

    private IEnumerable<OrderItem> _activeItems => _items.Where(i => i.Quantity > 0);
    private double _subtotal => _items.Sum(i => i.UnitPrice * i.Quantity);
    private int _totalUnits => _items.Sum(i => i.Quantity);
    private bool _belowMinimum => _subtotal < _minimumOrder;

    private void UpdateQuantity(string id, string value)
    {
        if (!int.TryParse(value, out var qty))
            qty = 0;

        _items = _items.Select(i =>
        {
            if (i.Id != id) return i;
            var clamped = Math.Max(0, Math.Min(qty, i.InStock));
            return i with { Quantity = clamped };
        }).ToList();
    }

    private void RemoveItem(string id)
    {
        _items = _items.Where(i => i.Id != id).ToList();
    }
}";

