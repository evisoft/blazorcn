@code {
    private record CartItem(string Id, string Name, double Weight, int Qty, double Price);
    private record ShippingTier(string Id, string Label, double MaxWeight, double Rate);

    private static readonly CartItem[] _items =
    [
        new(""1"", ""Cast Iron Skillet"",         3.6, 1, 54.99),
        new(""2"", ""Ceramic Dinner Plates"",      1.8, 2, 32.00),
        new(""3"", ""Stainless Steel Cutlery Set"",0.9, 1, 45.00),
        new(""4"", ""Cotton Table Runner"",        0.3, 1, 28.00),
    ];

    private static readonly ShippingTier[] _shippingTiers =
    [
        new(""light"",    ""Under 2 lbs"",  2,   5.99),
        new(""standard"", ""2 - 5 lbs"",    5,   9.99),
        new(""heavy"",    ""5 - 10 lbs"",   10, 14.99),
        new(""freight"",  ""Over 10 lbs"",  999, 24.99),
    ];

    private static readonly double _totalWeight = _items.Sum(i => i.Weight * i.Qty);
    private static readonly double _subtotal    = _items.Sum(i => i.Price  * i.Qty);

    private bool _combineShipments = true;

    private ShippingTier _activeTier => _shippingTiers.FirstOrDefault(t => _totalWeight <= t.MaxWeight) ?? _shippingTiers[^1];
    private double _shippingCost => _activeTier.Rate;
    private double _total => _subtotal + _shippingCost;

    private ShippingTier GetShippingRate(double weight) =>
        _shippingTiers.FirstOrDefault(t => weight <= t.MaxWeight) ?? _shippingTiers[^1];
}";

