    private record RestrictedProduct(string Id, string Name, string Category, double Price, int MinAge);

    private static readonly RestrictedProduct _product = new(""1"", ""Reserve Cabernet Sauvignon 2019"", ""Alcohol"", 64.0, 21);

    private string _month = """";
    private string _day = """";
    private string _year = """";
    private string _status = ""pending"";

    private void VerifyAge()
    {
        if (!int.TryParse(_month, out var m) || !int.TryParse(_day, out var d) || !int.TryParse(_year, out var y))
            return;
        if (y < 1900 || y > 2026 || m < 1 || m > 12 || d < 1 || d > 31)
            return;
        var birthDate = new DateTime(y, m, d);
        var cutoff = new DateTime(2026, 3, 24);
        var age = cutoff.Year - birthDate.Year;
        var monthDiff = cutoff.Month - birthDate.Month;
        var dayDiff = cutoff.Day - birthDate.Day;
        var adjustedAge = (monthDiff < 0 || (monthDiff == 0 && dayDiff < 0)) ? age - 1 : age;
        _status = adjustedAge >= _product.MinAge ? ""verified"" : ""blocked"";
    }

    private void ConfirmAge()
    {
        _status = ""verified"";
    }
}";

