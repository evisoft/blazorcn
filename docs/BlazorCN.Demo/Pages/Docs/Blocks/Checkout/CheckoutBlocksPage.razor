    private double _subtotal => _cart.Sum(i => i.Price * i.Quantity);
    private double _tax      => Math.Round(_subtotal * 0.0875, 2);
    private double _total    => Math.Round(_subtotal + _shipping + _tax, 2);

    private void UpdateQuantity(string id, int delta)
    {
        _cart = _cart.Select(i =>
        {
