@code {
    private record CartItem(
        string Id,
        string Name,
        string Image,
        string[] Sizes,
        string[] Colors,
        string SelectedSize,
        string SelectedColor,
        int Quantity,
        double BasePrice,
        Dictionary<string, double> PriceModifiers);

    private List<CartItem> _items =
    [
        new(""1"", ""Merino Wool Crewneck"", ""MW"",
            [""XS"", ""S"", ""M"", ""L"", ""XL""],
            [""Charcoal"", ""Navy"", ""Oatmeal"", ""Burgundy""],
            ""M"", ""Charcoal"", 1, 89.0,
            new Dictionary<string, double> { [""XL""] = 10, [""Burgundy""] = 5 }),
        new(""2"", ""Slim Fit Chinos"", ""SC"",
            [""28"", ""30"", ""32"", ""34"", ""36""],
            [""Khaki"", ""Olive"", ""Slate"", ""Black""],
            ""32"", ""Olive"", 2, 68.0,
            new Dictionary<string, double> { [""36""] = 5, [""Slate""] = 0 }),
        new(""3"", ""Canvas Sneakers"", ""CS"",
            [""8"", ""9"", ""10"", ""11"", ""12""],
            [""White"", ""Off-White"", ""Black"", ""Navy""],
            ""10"", ""White"", 1, 55.0,
            new Dictionary<string, double> { [""12""] = 5, [""Navy""] = 8 }),
    ];

    private const double _shipping = 8.5;

    private double GetItemPrice(CartItem item)
    {
        var price = item.BasePrice;
        if (item.PriceModifiers.TryGetValue(item.SelectedSize, out var sizeMod))
            price += sizeMod;
        if (item.PriceModifiers.TryGetValue(item.SelectedColor, out var colorMod))
            price += colorMod;
        return price;
    }

    private double _subtotal => _items.Sum(i => GetItemPrice(i) * i.Quantity);
    private double _total => _subtotal + _shipping;

    private void UpdateSize(string id, string size)
    {
        _items = _items.Select(i => i.Id == id ? i with { SelectedSize = size } : i).ToList();
    }

    private void UpdateColor(string id, string color)
    {
        _items = _items.Select(i => i.Id == id ? i with { SelectedColor = color } : i).ToList();
    }

    private void UpdateQuantity(string id, int newQty)
    {
        _items = _items.Select(i => i.Id == id ? i with { Quantity = newQty } : i).ToList();
    }

    private void RemoveItem(string id)
    {
        _items = _items.Where(i => i.Id != id).ToList();
    }
}";

