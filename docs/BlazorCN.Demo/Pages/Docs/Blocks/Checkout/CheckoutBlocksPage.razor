@code {
    private record AppliedCard(string Id, string LastFour, int OriginalBalance, int AppliedAmount, int RemainingBalance);

    private static readonly Dictionary<string, (string Pin, int Balance)> _giftCardDatabase = new()
    {
        [""4829-7361-0054-8812""] = (""9921"", 75),
        [""6103-4420-8837-2256""] = (""3347"", 150),
        [""9917-5528-3301-6640""] = (""7712"", 25),
    };

    private const int _orderSubtotal = 214;

    private List<AppliedCard> _appliedCards = [];
    private string _cardNumber = """";
    private string _pin = """";
    private string? _error = null;
    private bool _showForm = true;

    private int _totalApplied => _appliedCards.Sum(c => c.AppliedAmount);
    private int _remainingDue => Math.Max(0, _orderSubtotal - _totalApplied);

    private void HandleCheckAndApply()
    {
        var trimmedCard = _cardNumber.Trim();
        var trimmedPin = _pin.Trim();

        if (string.IsNullOrEmpty(trimmedCard) || string.IsNullOrEmpty(trimmedPin))
        {
            _error = ""Enter both card number and PIN."";
            return;
        }

        if (!_giftCardDatabase.TryGetValue(trimmedCard, out var cardData))
        {
            _error = ""Invalid card number or PIN. Please check and try again."";
            return;
        }

        if (cardData.Pin != trimmedPin)
        {
            _error = ""Invalid card number or PIN. Please check and try again."";
            return;
        }

        var lastFour = trimmedCard.Length >= 4 ? trimmedCard[^4..] : trimmedCard;

        if (_appliedCards.Any(c => c.LastFour == lastFour))
        {
            _error = ""This gift card is already applied."";
            return;
        }

        var currentRemaining = _orderSubtotal - _totalApplied;
        if (currentRemaining <= 0)
        {
            _error = ""Order is already fully covered."";
            return;
        }

        var appliedAmount = Math.Min(cardData.Balance, currentRemaining);
        var newCard = new AppliedCard(
            trimmedCard,
            lastFour,
            cardData.Balance,
            appliedAmount,
            cardData.Balance - appliedAmount
        );

        _appliedCards = [.._appliedCards, newCard];
        _cardNumber = """";
        _pin = """";
        _error = null;
        _showForm = false;
    }

    private void RemoveCard(string id)
    {
        _appliedCards = _appliedCards.Where(c => c.Id != id).ToList();
        _showForm = true;
    }
}";

