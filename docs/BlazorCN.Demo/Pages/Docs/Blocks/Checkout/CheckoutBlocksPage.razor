@code {
    private record EventInfo(string Name, string Date, string Venue);
    private record TicketType(string Id, string Name, int Price, string Description);

    private static readonly EventInfo _event = new(
        ""Synthesis Music Festival 2026"",
        ""Sat, Jun 14, 2026 · 6:00 PM"",
        ""Riverside Amphitheatre, Austin, TX""
    );

    private static readonly TicketType[] _ticketTypes =
    [
        new(""general"", ""General Admission"", 75,  ""Standing area access, food court""),
        new(""vip"",     ""VIP"",               150, ""Reserved seating, lounge access, complimentary drinks""),
        new(""premium"", ""Premium"",           275, ""Front row, backstage meet & greet, premium bar""),
    ];

    private string _selectedType = ""vip"";
    private int _quantity = 2;
    private List<string> _attendees = ["""", """"];

    private TicketType? _selectedTicket => Array.Find(_ticketTypes, t => t.Id == _selectedType);
    private int _subtotal => (_selectedTicket?.Price ?? 0) * _quantity;
    private int _serviceFee => (int)Math.Round(_subtotal * 0.08);
    private int _total => _subtotal + _serviceFee;

    private void SetSelectedType(string id)
    {
        _selectedType = id;
    }

    private void UpdateQuantity(int delta)
    {
        var next = Math.Max(1, Math.Min(10, _quantity + delta));
        _quantity = next;
        if (next > _attendees.Count)
        {
            while (_attendees.Count < next)
                _attendees.Add("""");
        }
        else if (next < _attendees.Count)
        {
            _attendees = _attendees.Take(next).ToList();
        }
    }

    private void UpdateAttendee(int index, string value)
    {
        if (index >= 0 && index < _attendees.Count)
            _attendees[index] = value;
    }
}";

