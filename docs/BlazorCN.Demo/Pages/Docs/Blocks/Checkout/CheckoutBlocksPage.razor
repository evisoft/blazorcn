    {
        if (_slots.Count > 1)
            _slots = _slots.Where(s => s.Id != id).ToList();
    }

    private void UpdateMethod(string id, string value)
    {
        _slots = _slots.Select(s => s.Id == id ? new PaymentSlot(s.Id, value, s.Amount) : s).ToList();
    }

    private void UpdateAmount(string id, string value)
    {
        _slots = _slots.Select(s => s.Id == id ? new PaymentSlot(s.Id, s.Method, value) : s).ToList();
    }
}
