                                    <LucideIconCn Name=""arrow-up"" Size=""10"" Class=""size-2.5"" />
                                }
                                $@priceChange.Amount.ToString(""F2"")
                            </div>
                        }
                    </div>

                    @* Actions *@
                    <div class=""flex shrink-0 items-center gap-1"">
                        @if (!isInCart && item.InStock)
                        {
                            <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""h-7 gap-1 px-2 text-xs"" OnClick=""@(() => AddSingleToCart(item.Id))"">
                                <LucideIconCn Name=""shopping-cart"" Size=""12"" Class=""size-3"" />
                                Add
                            </ButtonCn>
                        }
                        <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""size-6 p-0 text-muted-foreground"" aria-label=""@($""Remove {item.Name} from wishlist"")"" OnClick=""@(() => RemoveItem(item.Id))"">
                            <LucideIconCn Name=""x"" Size=""12"" Class=""size-3"" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record WishlistItem(string Id, string Name, string Description, string Image, double CurrentPrice, double OriginalPrice, bool InStock);
    private record PriceChange(string Type, double Amount);

    private List<WishlistItem> _items =
    [
        new(""1"", ""Ultra-Wide Monitor 34\"""",  ""3440x1440, 144Hz, USB-C"",             ""UM"", 449.99, 499.99, true),
        new(""2"", ""Standing Desk Frame"",      ""Electric, dual motor, 63\"" width"",    ""SD"", 379.00, 379.00, true),
        new(""3"", ""Webcam 4K HDR"",            ""Auto-focus, noise canceling mic"",     ""WC"", 129.99, 109.99, true),
        new(""4"", ""Desk Lamp LED"",            ""5 color temps, auto-dimming, USB"",    ""DL"",  59.99,  74.99, true),
        new(""5"", ""Cable Management Kit"",     ""Under-desk tray, clips, sleeves"",     ""CK"",  34.99,  34.99, false),
        new(""6"", ""Monitor Light Bar"",        ""Auto-brightness, asymmetric, USB"",    ""ML"",  54.99,  64.99, true),
    ];

    private HashSet<string> _selected = [];
    private HashSet<string> _addedToCart = [];

    private IEnumerable<WishlistItem> SelectableItems => _items.Where(i => i.InStock && !_addedToCart.Contains(i.Id));
    private bool _allSelected => SelectableItems.Any() && _selected.Count == SelectableItems.Count();
    private double _selectedTotal => _items.Where(i => _selected.Contains(i.Id)).Sum(i => i.CurrentPrice);

    private PriceChange? GetPriceChange(WishlistItem item)
    {
        var diff = item.CurrentPrice - item.OriginalPrice;
        if (diff < -0.01) return new PriceChange(""drop"", Math.Abs(diff));
        if (diff > 0.01) return new PriceChange(""increase"", diff);
        return null;
    }

    private void ToggleSelect(string id)
    {
        if (!_selected.Add(id))
            _selected.Remove(id);
    }

    private void ToggleAll()
    {
        var selectableIds = SelectableItems.Select(i => i.Id).ToList();
        if (_selected.Count == selectableIds.Count)
            _selected = [];
        else
            _selected = [.. selectableIds];
    }

    private void AddSelectedToCart()
    {
        foreach (var id in _selected)
            _addedToCart.Add(id);
        _selected = [];
    }

    private void AddSingleToCart(string id)
    {
        _addedToCart.Add(id);
        _selected.Remove(id);
    }

    private void RemoveItem(string id)
    {
        _items = _items.Where(i => i.Id != id).ToList();
        _selected.Remove(id);
        _addedToCart.Remove(id);
    }
}";
}
