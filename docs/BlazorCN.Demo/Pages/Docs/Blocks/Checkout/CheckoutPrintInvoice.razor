@* ============================================================
   Block: checkout-print-invoice
   Title: CheckoutPrintInvoice
   Description: A printable invoice and receipt block for React and Next.js with company logo placeholder, invoice number, line items table, tax breakdown, total, and print/download buttons using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-print-invoice.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with invoice number and actions *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Invoice</span>
                <p class="mt-0.5 font-mono text-muted-foreground text-xs">@_invoiceNumber</p>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" @onclick="@(() => { })">
                    <LucideIconCn Name="printer" Size="12" Class="size-3" />
                    Print
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                    Download PDF
                </ButtonCn>
            </div>
        </div>

        @* Company and logo placeholder *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between">
                <div>
                    <span class="font-medium text-sm">@_company.Name</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_company.Address</p>
                    <p class="text-muted-foreground text-xs">@_company.City</p>
                    <p class="text-muted-foreground text-xs">@_company.Email</p>
                </div>
                <div class="flex size-10 items-center justify-center rounded-md bg-muted/50">
                    <span class="font-medium text-muted-foreground text-xs">Logo</span>
                </div>
            </div>
        </div>

        @* Billing details *@
        <div class="grid grid-cols-2 gap-4 border-b px-4 py-3">
            <div>
                <span class="text-muted-foreground text-xs">Bill to</span>
                <p class="mt-1 font-medium text-sm">@_customer.Name</p>
                <p class="text-muted-foreground text-xs">@_customer.Address</p>
                <p class="text-muted-foreground text-xs">@_customer.City</p>
                <p class="text-muted-foreground text-xs">@_customer.Email</p>
            </div>
            <div class="text-right">
                <div class="space-y-2">
                    <div>
                        <span class="text-muted-foreground text-xs">Invoice date</span>
                        <p class="font-medium text-sm">@_invoiceDate</p>
                    </div>
                    <div>
                        <span class="text-muted-foreground text-xs">Due date</span>
                        <p class="font-medium text-sm">@_dueDate</p>
                    </div>
                </div>
            </div>
        </div>

        @* Line items table *@
        <div class="border-b">
            @* Table header *@
            <div class="grid grid-cols-12 gap-2 border-b bg-muted/30 px-4 py-2">
                <span class="col-span-6 text-muted-foreground text-xs">Description</span>
                <span class="col-span-2 text-right text-muted-foreground text-xs">Qty</span>
                <span class="col-span-2 text-right text-muted-foreground text-xs">Unit price</span>
                <span class="col-span-2 text-right text-muted-foreground text-xs">Amount</span>
            </div>

            @* Table rows *@
            @{
                var lineItemList = _lineItems.ToList();
            }
            @foreach (var it in lineItemList)
            {
                var item = it;
                var isLast = lineItemList.IndexOf(item) == lineItemList.Count - 1;
                <div class="@Cn.Merge("grid grid-cols-12 gap-2 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="col-span-6 text-sm">@item.Description</span>
                    <span class="col-span-2 text-right font-mono text-sm tabular-nums">@item.Quantity</span>
                    <span class="col-span-2 text-right font-mono text-sm tabular-nums">@FormatCurrency(item.UnitPrice)</span>
                    <span class="col-span-2 text-right font-mono text-sm tabular-nums">@FormatCurrency(item.Quantity * item.UnitPrice)</span>
                </div>
            }
        </div>

        @* Totals *@
        <div class="px-4 py-3">
            <div class="ml-auto max-w-48 space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Subtotal</span>
                    <span class="font-mono text-sm tabular-nums">@FormatCurrency(_subtotal)</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Tax (8.75%)</span>
                    <span class="font-mono text-sm tabular-nums">@FormatCurrency(_tax)</span>
                </div>
                <div class="border-t pt-1.5">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-sm">Total</span>
                        <span class="font-semibold text-lg tabular-nums">@FormatCurrency(_total)</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record LineItem(string Id, string Description, int Quantity, double UnitPrice);

    private record ContactInfo(string Name, string Address, string City, string Email);

    private const string _invoiceNumber = "INV-2026-00847";
    private const string _invoiceDate = "Mar 20, 2026";
    private const string _dueDate = "Apr 19, 2026";
    private const double _taxRate = 0.0875;

    private static readonly ContactInfo _company = new(
        "Acme Software Inc.",
        "350 Fifth Avenue, Suite 4200",
        "New York, NY 10118",
        "billing@acme.com"
    );

    private static readonly ContactInfo _customer = new(
        "Northwind Traders",
        "1200 Market Street, Suite 800",
        "San Francisco, CA 94103",
        "accounts@northwind.io"
    );

    private static readonly LineItem[] _lineItems =
    [
        new("1", "Pro Plan — Annual License",   5, 229.0),
        new("2", "Priority Support Add-on",     1, 499.0),
        new("3", "Custom SSO Integration",      1, 1200.0),
        new("4", "Data Migration Service",      1, 350.0),
    ];

    private double _subtotal => _lineItems.Sum(i => i.Quantity * i.UnitPrice);
    private double _tax => _subtotal * _taxRate;
    private double _total => _subtotal + _tax;

    private static string FormatCurrency(double amount) =>
        $"${amount:N2}";
}
