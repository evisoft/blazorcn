@* ============================================================
   Block: checkout-terms-consent
   Title: CheckoutTermsConsent
   Description: A terms and conditions consent checkout block for React and Next.js with scrollable terms preview, required checkboxes for terms of service, privacy policy, and return policy, accept all toggle, and full document links using shadcn/ui Checkbox, Button, and Tailwind CSS
   Source: original/blocks/checkout/checkout-terms-consent.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="scroll-text" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Review and Accept</span>
            <span class="ml-auto text-muted-foreground text-xs">
                @(_policies.Count(p => _consents[p.Id]))/@_policies.Length accepted
            </span>
        </div>

        @* Scrollable terms preview *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-xs text-muted-foreground">Terms preview</span>
                <span class="font-mono text-xs text-muted-foreground">v3.2</span>
            </div>
            <div class="h-40 overflow-y-auto rounded-md bg-muted/50 p-3">
                <pre class="whitespace-pre-wrap font-sans text-xs leading-relaxed text-muted-foreground">@_termsPreview</pre>
            </div>
        </div>

        @* Accept all *@
        <div class="border-b px-4 py-3">
            <span class="flex cursor-pointer items-center gap-3 transition-colors hover:bg-muted/50 rounded-md -mx-1 px-1 py-1"
                  role="button"
                  tabindex="0"
                  @onclick="ToggleAll"
                  @onkeydown="@((e) => { if (e.Key == "Enter") ToggleAll(); })">
                <CheckboxCn Checked="@_allChecked" CheckedChanged="@((v) => ToggleAll())" aria-label="Accept all policies" />
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">Accept all</span>
                    <p class="text-muted-foreground text-xs">
                        Agree to all @_policies.Length required policies at once
                    </p>
                </div>
            </span>
        </div>

        @* Individual policies *@
        <div class="border-b">
            @for (int i = 0; i < _policies.Length; i++)
            {
                var policy = _policies[i];
                var isLast = i == _policies.Length - 1;
                var policyId = policy.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3 px-4 py-3">
                        <span class="flex cursor-pointer items-start gap-3 min-w-0 flex-1"
                              role="button"
                              tabindex="0"
                              @onclick="@(() => ToggleOne(policyId))"
                              @onkeydown="@((e) => { if (e.Key == "Enter") ToggleOne(policyId); })">
                            <CheckboxCn Checked="@_consents[policy.Id]" CheckedChanged="@((v) => ToggleOne(policyId))" Class="mt-0.5" aria-label="@($"Accept {policy.Label}")" />
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@policy.Label</span>
                                    @if (policy.Required)
                                    {
                                        <span class="text-red-500 text-xs">Required</span>
                                    }
                                    <span class="font-mono text-muted-foreground text-xs">@policy.Version</span>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">@policy.Description</p>
                            </div>
                        </span>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 shrink-0 gap-1 px-2 text-xs">
                            <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                            Full
                        </ButtonCn>
                    </div>
                    @if (_consents[policy.Id])
                    {
                        <div class="px-4 pb-3 pl-10">
                            <div class="flex items-center gap-1.5 text-emerald-600 text-xs dark:text-emerald-400">
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                                Accepted
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Order total and proceed *@
        <div class="px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-muted-foreground text-sm">Order total</span>
                <span class="font-semibold text-sm tabular-nums">$@_orderTotal.ToString("F2")</span>
            </div>
            <ButtonCn Class="w-full" Disabled="@(!_allRequired)">
                @if (_allRequired)
                {
                    @($"Proceed to Payment — ${_orderTotal.ToString("F2")}")
                }
                else
                {
                    @("Accept required policies to continue")
                }
            </ButtonCn>
            <p class="mt-2 flex items-center justify-center gap-1 text-muted-foreground text-xs">
                <LucideIconCn Name="lock" Size="12" Class="size-3" />
                Your consent is recorded and timestamped
            </p>
        </div>
    </div>
</section>

@code {
    private record PolicyConsent(string Id, string Label, string Description, bool Required, string Version);

    private static readonly PolicyConsent[] _policies =
    [
        new("terms", "Terms of Service", "I agree to the terms of service governing the use of this platform and its products.", true, "v3.2"),
        new("privacy", "Privacy Policy", "I acknowledge and accept the collection and processing of my personal data as described.", true, "v2.8"),
        new("returns", "Return Policy", "I understand the return and refund conditions, including the 30-day return window.", true, "v1.4"),
    ];

    private static readonly string _termsPreview =
        "1. ACCEPTANCE OF TERMS\n" +
        "By placing an order, you agree to these Terms of Service. If you do not agree, do not proceed with your purchase.\n\n" +
        "2. ORDER AND PAYMENT\n" +
        "All prices are in USD. We reserve the right to refuse or cancel any order. Payment is processed securely through our third-party payment provider.\n\n" +
        "3. SHIPPING AND DELIVERY\n" +
        "Estimated delivery times are not guaranteed. Risk of loss passes to you upon delivery to the carrier. International orders may incur customs duties.\n\n" +
        "4. RETURNS AND REFUNDS\n" +
        "Items may be returned within 30 days of delivery in original condition. Refunds are processed within 5-10 business days. Shipping costs are non-refundable.\n\n" +
        "5. LIMITATION OF LIABILITY\n" +
        "Our liability is limited to the purchase price of the product. We are not liable for indirect, incidental, or consequential damages.";

    private static readonly double _orderTotal = 149.0;

    private Dictionary<string, bool> _consents = new()
    {
        ["terms"] = false,
        ["privacy"] = false,
        ["returns"] = false,
    };

    private bool _allChecked => _policies.All(p => _consents[p.Id]);
    private bool _allRequired => _policies.Where(p => p.Required).All(p => _consents[p.Id]);

    private void ToggleOne(string id)
    {
        _consents[id] = !_consents[id];
    }

    private void ToggleAll()
    {
        var nextValue = !_allChecked;
        foreach (var p in _policies)
        {
            _consents[p.Id] = nextValue;
        }
    }
}
