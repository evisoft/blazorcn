@* ============================================================
   Block: checkout-one-click
   Title: CheckoutOneClick
   Description: A one-click purchase checkout for React and Next.js with saved address, saved payment method, order summary, and single buy-now button using shadcn/ui Button, Badge, and Tailwind CSS
   Source: original/blocks/checkout/checkout-one-click.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Quick Checkout</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">
                Returning customer
            </BadgeCn>
        </div>

        @* Saved address *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="map-pin" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Shipping Address</span>
                </div>
                <button
                    type="button"
                    class="text-muted-foreground text-xs underline underline-offset-2 transition-colors hover:text-foreground">
                    Change
                </button>
            </div>
            <div class="mt-2 pl-5.5">
                <p class="text-sm">@_savedAddressName</p>
                <p class="text-muted-foreground text-xs">@_savedAddressLine1</p>
                <p class="text-muted-foreground text-xs">@_savedAddressCity, @_savedAddressState @_savedAddressZip</p>
            </div>
        </div>

        @* Saved payment *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Payment Method</span>
                </div>
                <button
                    type="button"
                    class="text-muted-foreground text-xs underline underline-offset-2 transition-colors hover:text-foreground">
                    Change
                </button>
            </div>
            <div class="mt-2 pl-5.5">
                <p class="text-sm">@_savedPaymentBrand ending in @_savedPaymentLast4</p>
                <p class="text-muted-foreground text-xs">Expires @_savedPaymentExpiry</p>
            </div>
        </div>

        @* Order summary *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Order Summary</span>
            <div class="mt-3">
                @foreach (var item in _orderItems)
                {
                    var isLast = item.Id == _orderItems[^1].Id;
                    <div class="@Cn.Merge("flex items-center justify-between py-2", isLast ? "" : "border-b")">
                        <div class="min-w-0 flex-1">
                            <span class="text-sm">@item.Name</span>
                            <p class="text-muted-foreground text-xs">@item.Variant &middot; Qty @item.Quantity</p>
                        </div>
                        <span class="font-medium text-sm tabular-nums">$@((item.Price * item.Quantity).ToString("F2"))</span>
                    </div>
                }
            </div>
        </div>

        @* Totals *@
        <div class="border-b px-4 py-3 space-y-1.5">
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Subtotal</span>
                <span class="tabular-nums">$@(Subtotal.ToString("F2"))</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Shipping</span>
                <span class="tabular-nums text-emerald-600 dark:text-emerald-400">Free</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Tax</span>
                <span class="tabular-nums">$@(_tax.ToString("F2"))</span>
            </div>
            <div class="flex justify-between border-t pt-1.5 font-medium text-sm">
                <span>Total</span>
                <span class="tabular-nums">$@(Total.ToString("F2"))</span>
            </div>
        </div>

        @* Buy now *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">Buy Now &middot; $@(Total.ToString("F2"))</ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                One-click purchase using your saved details
            </p>
        </div>
    </div>
</section>

@code {
    private const string _savedAddressName = "Alex Chen";
    private const string _savedAddressLine1 = "742 Evergreen Terrace, Apt 3A";
    private const string _savedAddressCity = "San Francisco";
    private const string _savedAddressState = "CA";
    private const string _savedAddressZip = "94102";

    private const string _savedPaymentBrand = "Visa";
    private const string _savedPaymentLast4 = "4242";
    private const string _savedPaymentExpiry = "09/27";

    private record OrderItem(string Id, string Name, string Variant, double Price, int Quantity);

    private static readonly OrderItem[] _orderItems =
    [
        new("1", "Wireless Charging Pad", "Midnight Black", 49, 1),
        new("2", "Braided USB-C Cable 2m", "Space Gray", 19, 2),
    ];

    private const double _tax = 7.83;

    private static double ComputeSubtotal() =>
        _orderItems[0].Price * _orderItems[0].Quantity + _orderItems[1].Price * _orderItems[1].Quantity;

    private static double Subtotal => ComputeSubtotal();
    private static double Total => Subtotal + _tax;
}
