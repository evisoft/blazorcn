@* ============================================================
   Block: checkout-tax-calculator
   Title: CheckoutTaxCalculator
   Description: A checkout tax calculator block for React and Next.js with subtotal display, regional tax breakdown by type, tax-exempt toggle with ID input, and final total with tax built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-tax-calculator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calculator" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Tax calculation</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Based on shipping address: San Francisco, CA 94105
            </p>
        </div>

        @* Line items *@
        @foreach (var it in _orderItems)
        {
            var item = it;
            <div class="flex items-center justify-between border-b px-4 py-2.5">
                <div class="min-w-0 flex-1">
                    <span class="text-sm">@item.Name</span>
                </div>
                <span class="shrink-0 font-mono text-sm tabular-nums">$@item.Price.ToString("F2")</span>
            </div>
        }

        @* Subtotal *@
        <div class="flex items-center justify-between border-b px-4 py-2.5">
            <span class="text-muted-foreground text-sm">Subtotal</span>
            <span class="font-medium text-sm tabular-nums">$@_subtotal.ToString("F2")</span>
        </div>

        @* Tax summary with expandable breakdown *@
        <div class="border-b">
            <button type="button"
                    @onclick="@(() => _showBreakdown = !_showBreakdown)"
                    class="flex w-full items-center justify-between px-4 py-2.5 transition-colors hover:bg-muted/50">
                <div class="flex items-center gap-2">
                    <span class="text-sm">Estimated tax</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_combinedRate.ToString("F2")%
                    </BadgeCn>
                </div>
                <div class="flex items-center gap-2">
                    <span class="@Cn.Merge("font-medium text-sm tabular-nums", _isExempt ? "text-muted-foreground line-through" : "")">
                        $@_totalTax.ToString("F2")
                    </span>
                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _showBreakdown ? "rotate-90" : "")" />
                </div>
            </button>

            @if (_showBreakdown)
            {
                <div class="border-t bg-muted/30 px-4 py-2.5">
                    <div class="space-y-2">
                        @foreach (var tl in _taxLines)
                        {
                            var line = tl;
                            <div class="flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                                    <span class="text-muted-foreground text-xs">@line.Jurisdiction</span>
                                    <span class="rounded bg-muted px-1 py-0.5 font-mono text-muted-foreground text-[10px]">
                                        @line.Type
                                    </span>
                                    <span class="font-mono text-muted-foreground text-xs">@line.Rate%</span>
                                </div>
                                <span class="@Cn.Merge("font-mono text-xs tabular-nums", _isExempt ? "text-muted-foreground line-through" : "text-muted-foreground")">
                                    $@line.Amount.ToString("F2")
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Tax exempt *@
        <div class="border-b px-4 py-3">
            <span class="flex cursor-pointer items-center gap-2.5"
                  @onclick="@(() => _isExempt = !_isExempt)"
                  role="button"
                  tabindex="0">
                <CheckboxCn Checked="@_isExempt" CheckedChanged="@((bool v) => _isExempt = v)" />
                <div>
                    <span class="font-medium text-sm">Tax exempt</span>
                    <p class="text-muted-foreground text-xs">
                        I have a valid tax exemption certificate
                    </p>
                </div>
            </span>

            @if (_isExempt)
            {
                <div class="mt-3 space-y-3 pl-[26px]">
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">
                            Tax exemption ID
                        </span>
                        <InputCn Placeholder="@("XX-XXXXXXX")" Class="h-8 font-mono text-sm" />
                    </div>
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-muted-foreground text-xs leading-relaxed">
                            Enter your EIN or state tax exemption number. Your exemption will be verified
                            before the order is finalized. Processing may take up to 24 hours for new
                            exemption IDs.
                        </p>
                    </div>
                </div>
            }
        </div>

        @* Total *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Total</span>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">$@_total.ToString("F2")</span>
                </div>
            </div>
            @if (_isExempt)
            {
                <p class="mt-1 flex items-center gap-1.5 text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-muted-foreground">Tax exempt applied</span>
                </p>
            }
        </div>

        @* Action *@
        <div class="px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                Continue to payment
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record OrderItem(string Id, string Name, int Quantity, double Price);
    private record TaxLine(string Id, string Jurisdiction, string Type, double Rate, double Amount);

    private static readonly OrderItem[] _orderItems =
    [
        new("item_1", "Pro Plan (Annual)", 1, 229.0),
        new("item_2", "Additional Seats (3)", 3, 36.0),
        new("item_3", "Priority Support", 1, 49.0),
    ];

    private static readonly TaxLine[] _taxLines =
    [
        new("tax_1", "California", "State", 6.0, 18.84),
        new("tax_2", "San Francisco", "Local", 1.25, 3.93),
        new("tax_3", "SF Transit District", "Special", 1.0, 3.14),
    ];

    private static readonly double _subtotal = _orderItems.Sum(i => i.Price);
    private static readonly double _totalTax = _taxLines.Sum(l => l.Amount);
    private static readonly double _combinedRate = _taxLines.Sum(l => l.Rate);

    private bool _isExempt = false;
    private bool _showBreakdown = false;

    private double _effectiveTax => _isExempt ? 0 : _totalTax;
    private double _total => _subtotal + _effectiveTax;
}
