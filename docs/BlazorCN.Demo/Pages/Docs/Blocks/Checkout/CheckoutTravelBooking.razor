@* ============================================================
   Block: checkout-travel-booking
   Title: CheckoutTravelBooking
   Description: A travel and flight booking checkout block for React and Next.js with trip summary, traveler details form, baggage add-on options, travel insurance toggle, and fare breakdown built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-travel-booking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="plane" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Travel Booking</span>
            </div>
        </div>

        @* Trip summary *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Trip summary</span>
            <div class="mt-2 space-y-2">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">@_trip.Departure</p>
                        <p class="text-muted-foreground text-xs">@_trip.DepartDate</p>
                    </div>
                    <div class="flex items-center gap-2 px-3">
                        <SeparatorCn Class="w-8" />
                        <LucideIconCn Name="plane" Size="12" Class="size-3 text-muted-foreground" />
                        <SeparatorCn Class="w-8" />
                    </div>
                    <div class="text-right">
                        <p class="font-medium text-sm">@_trip.Arrival</p>
                        <p class="text-muted-foreground text-xs">@_trip.ReturnDate</p>
                    </div>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_trip.Airline</BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_trip.FlightOut / @_trip.FlightReturn</BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_trip.Cabin</BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_trip.Duration</BadgeCn>
                </div>
            </div>
        </div>

        @* Traveler details *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Traveler details</span>
            </div>
            <div class="mt-2 grid grid-cols-2 gap-2">
                <InputCn aria-label="First name" @bind-Value="_firstName" Placeholder="First name" Class="h-8 text-sm" />
                <InputCn aria-label="Last name" @bind-Value="_lastName" Placeholder="Last name" Class="h-8 text-sm" />
            </div>
            <InputCn aria-label="Passport number" @bind-Value="_passport" Placeholder="Passport number" Class="mt-2 h-8 text-sm" />
            <p class="mt-1.5 text-muted-foreground text-xs">
                Name must match your travel document exactly
            </p>
        </div>

        @* Baggage add-ons *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="briefcase" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Baggage</span>
            </div>
            <div class="mt-2 space-y-1.5">
                @foreach (var bag in _baggageOptions)
                {
                    var b = bag;
                    var isSelected = _selectedBaggage.Contains(b.Id);
                    <label class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-md px-3 py-2 transition-colors", isSelected ? "bg-muted/50" : "hover:bg-muted/30")">
                        <input type="checkbox" checked="@(isSelected ? "checked" : null)" @onclick="@(() => ToggleBaggage(b.Id))" class="sr-only" />
                        <div class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded border", isSelected ? "border-foreground bg-foreground" : "border-muted-foreground/40")">
                            @if (isSelected)
                            {
                                <svg class="size-3 text-background" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                                    <title>Selected</title>
                                    <path d="M5 13l4 4L19 7" />
                                </svg>
                            }
                        </div>
                        <LucideIconCn Name="luggage" Size="14" Class="size-3.5 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm">@b.Name</span>
                            <span class="ml-1.5 text-muted-foreground text-xs">@b.Weight</span>
                        </div>
                        <span class="shrink-0 text-sm tabular-nums">@(b.Price == 0 ? "Included" : $"+${b.Price}")</span>
                    </label>
                }
            </div>
        </div>

        @* Travel insurance *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <span class="font-medium text-sm">Travel insurance</span>
                        <p class="text-muted-foreground text-xs">
                            Trip cancellation, medical, and baggage coverage
                        </p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-muted-foreground text-xs tabular-nums">+$38</span>
                    <SwitchCn aria-label="Travel insurance" Checked="@_insurance" CheckedChanged="@((val) => _insurance = val)" />
                </div>
            </div>
        </div>

        @* Fare breakdown *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Fare breakdown</span>
            <div class="mt-2 space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">Base fare</span>
                    <span class="text-sm tabular-nums">$@_baseFare</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">Taxes &amp; fees</span>
                    <span class="text-sm tabular-nums">$@_taxes</span>
                </div>
                @if (_baggageCost > 0)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground text-sm">Baggage</span>
                        <span class="text-sm tabular-nums">$@_baggageCost</span>
                    </div>
                }
                @if (_insurance)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground text-sm">Insurance</span>
                        <span class="text-sm tabular-nums">$@_insuranceCost</span>
                    </div>
                }
                <SeparatorCn />
                <div class="flex items-center justify-between">
                    <span class="font-medium text-sm">Total</span>
                    <span class="font-semibold text-sm tabular-nums">$@_total</span>
                </div>
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">Confirm booking</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TripData(
        string Departure,
        string Arrival,
        string DepartDate,
        string ReturnDate,
        int Passengers,
        string Cabin,
        string Airline,
        string FlightOut,
        string FlightReturn,
        string Duration
    );

    private record BaggageOption(string Id, string Name, string Weight, int Price);

    private static readonly TripData _trip = new(
        Departure: "San Francisco (SFO)",
        Arrival: "Tokyo Narita (NRT)",
        DepartDate: "Jul 10, 2026",
        ReturnDate: "Jul 24, 2026",
        Passengers: 1,
        Cabin: "Economy",
        Airline: "Pacific Airways",
        FlightOut: "PA 204",
        FlightReturn: "PA 205",
        Duration: "11h 15m"
    );

    private static readonly BaggageOption[] _baggageOptions =
    [
        new("carry-on", "Carry-on bag", "10 kg", 0),
        new("checked-1", "Checked bag", "23 kg", 45),
        new("checked-2", "Extra checked bag", "23 kg", 65),
    ];

    private const int _baseFare = 892;
    private const int _taxes = 124;

    private List<string> _selectedBaggage = ["carry-on", "checked-1"];
    private bool _insurance = false;
    private string _firstName = "";
    private string _lastName = "";
    private string _passport = "";

    private int _baggageCost =>
        _baggageOptions
            .Where(b => _selectedBaggage.Contains(b.Id))
            .Sum(b => b.Price);

    private int _insuranceCost => _insurance ? 38 : 0;

    private int _total => _baseFare + _taxes + _baggageCost + _insuranceCost;

    private void ToggleBaggage(string id)
    {
        if (_selectedBaggage.Contains(id))
            _selectedBaggage = _selectedBaggage.Where(b => b != id).ToList();
        else
            _selectedBaggage = [.. _selectedBaggage, id];
    }
}
