@* ============================================================
   Block: checkout-store-pickup
   Title: CheckoutStorePickup
   Description: An in-store pickup checkout block with a searchable store list showing distance, address, and hours, pickup person name field, ready estimate, and pickup instructions
   Source: original/blocks/checkout/checkout-store-pickup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">In-Store Pickup</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Select a store near you</p>
            </div>
            <LucideIconCn Name="store" Size="16" Class="size-4 text-muted-foreground" />
        </div>

        @* Store list *@
        <div class="border-b">
            @foreach (var s in _stores)
            {
                var store = s;
                var isActive = _selectedStore == store.Id;
                var isLast = store.Id == _stores[^1].Id;
                <label for="@store.Id"
                       class="@Cn.Merge("flex cursor-pointer items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", isActive ? "bg-muted/50" : "")">
                    <div class="pt-0.5">
                        <input type="radio"
                               id="@store.Id"
                               name="store-pickup"
                               value="@store.Id"
                               checked="@(isActive ? "checked" : null)"
                               @onchange="@(() => _selectedStore = store.Id)"
                               class="accent-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between">
                            <span class="font-medium text-sm">@store.Name</span>
                            <span class="shrink-0 text-muted-foreground text-xs">@store.Distance</span>
                        </div>
                        <div class="mt-1 flex items-center gap-1.5">
                            <LucideIconCn Name="map-pin" Size="12" Class="size-3 shrink-0 text-muted-foreground/60" />
                            <span class="text-muted-foreground text-xs">@store.Address</span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-1.5">
                            <LucideIconCn Name="clock" Size="12" Class="size-3 shrink-0 text-muted-foreground/60" />
                            <span class="text-muted-foreground text-xs">Today: @store.Hours</span>
                        </div>
                    </div>
                </label>
            }
        </div>

        @* Ready estimate *@
        @{
            var chosen = _stores.FirstOrDefault(s => s.Id == _selectedStore);
        }
        @if (chosen is not null)
        {
            <div class="flex items-center gap-2 border-b px-4 py-3">
                <span class="size-1.5 rounded-full bg-emerald-500" />
                <span class="text-sm">@chosen.ReadyEstimate</span>
                <span class="text-muted-foreground text-xs">at @chosen.Name</span>
            </div>
        }

        @* Pickup person *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-2">
                <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Pickup person</span>
            </div>
            <InputCn aria-label="Pickup person full name" @bind-Value="_pickupName" Placeholder="Full name of person picking up" Class="h-9" />
            <p class="mt-1.5 text-muted-foreground text-xs">
                Photo ID required at pickup. Must match the name above.
            </p>
        </div>

        @* Pickup instructions *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Pickup instructions</span>
            <div class="mt-2 space-y-1.5">
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1 shrink-0 rounded-full bg-muted-foreground/40" />
                    <span class="text-muted-foreground text-xs">
                        You will receive an email and SMS when your order is ready
                    </span>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1 shrink-0 rounded-full bg-muted-foreground/40" />
                    <span class="text-muted-foreground text-xs">
                        Go to the pickup counter on the ground floor
                    </span>
                </div>
                <div class="flex items-start gap-2">
                    <span class="mt-1 size-1 shrink-0 rounded-full bg-muted-foreground/40" />
                    <span class="text-muted-foreground text-xs">
                        Orders held for 7 days before being returned to stock
                    </span>
                </div>
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="w-full">
                Confirm Store Pickup
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Free pickup &middot; No shipping charges
            </p>
        </div>
    </div>
</section>

@code {
    private record StoreItem(string Id, string Name, string Address, string Distance, string Hours, string ReadyEstimate);

    private static readonly StoreItem[] _stores =
    [
        new("s1", "Downtown Flagship", "245 Market St, San Francisco, CA 94105", "0.8 mi", "9:00 AM - 9:00 PM", "Ready in 2 hours"),
        new("s2", "Mission District", "3120 24th St, San Francisco, CA 94110", "2.1 mi", "10:00 AM - 8:00 PM", "Ready in 3 hours"),
        new("s3", "Westfield Center", "865 Market St, San Francisco, CA 94103", "1.4 mi", "10:00 AM - 9:00 PM", "Ready in 2 hours"),
    ];

    private string _selectedStore = "s1";
    private string _pickupName = "";
}
