@* ============================================================
   Block: checkout-crypto
   Title: CheckoutCrypto
   Description: A cryptocurrency payment checkout block for React and Next.js with coin selector, wallet address display, QR code placeholder, crypto and USD amount conversion, and static payment timer built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-crypto.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="wallet" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Pay with Crypto</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Send cryptocurrency to complete your $@(_orderTotalUsd.ToString("F2")) order.
            </p>
        </div>

        @* Coin selector *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Select currency</span>
            <div class="mt-2 flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                @foreach (var c in _coins)
                {
                    var coin = c;
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-7 flex-1 gap-1 text-xs", _selectedCoinId == coin.Id ? "bg-background shadow-sm" : "text-muted-foreground")"
                              OnClick="@(() => SelectCoin(coin.Id))">
                        @coin.Symbol
                    </ButtonCn>
                }
            </div>
        </div>

        @* Amount display *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <div class="flex items-baseline gap-1.5">
                        <span class="font-semibold text-2xl tabular-nums">
                            @FormatCrypto(_cryptoAmount)
                        </span>
                        <span class="font-medium text-muted-foreground text-sm">@_coin.Symbol</span>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">
                        ≈ $@(_orderTotalUsd.ToString("F2")) USD at $@(_coin.Rate.ToString("N2"))/@_coin.Symbol
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs"
                          OnClick="@(() => CopyToClipboard(FormatCrypto(_cryptoAmount), "amount"))">
                    @if (_copiedAmount)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
        </div>

        @* QR code and address *@
        <div class="border-b px-4 py-3">
            <div class="flex gap-4">
                @* QR placeholder *@
                <div class="flex size-28 shrink-0 flex-col items-center justify-center rounded-md bg-muted/50">
                    <LucideIconCn Name="qr-code" Size="32" Class="size-8 text-muted-foreground/40" />
                    <span class="mt-1 text-muted-foreground/60 text-xs">Scan to pay</span>
                </div>

                @* Address *@
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-muted-foreground text-xs">@_coin.Name address</span>
                    <div class="mt-1.5 rounded-md bg-muted/50 p-2">
                        <p class="break-all font-mono text-xs leading-relaxed">@_coin.Address</p>
                    </div>
                    <div class="mt-2 flex items-center gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs"
                                  OnClick="@(() => CopyToClipboard(_coin.Address, "address"))">
                            @if (_copiedAddress)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                                <span>Copied</span>
                            }
                            else
                            {
                                <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                <span>Copy Address</span>
                            }
                        </ButtonCn>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @_coin.Network
                        </BadgeCn>
                    </div>
                </div>
            </div>
        </div>

        @* Payment timer *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Rate locked for</span>
                <span class="font-mono font-medium text-sm tabular-nums">14:32</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                The @_coin.Symbol amount will be recalculated if the timer expires.
            </p>
        </div>

        @* Instructions *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <span class="font-medium text-muted-foreground text-xs">How to pay</span>
                <ol class="mt-1.5 space-y-1">
                    <li class="text-xs leading-relaxed">
                        <span class="font-medium text-muted-foreground">1.</span> Copy the wallet
                        address or scan the QR code
                    </li>
                    <li class="text-xs leading-relaxed">
                        <span class="font-medium text-muted-foreground">2.</span> Send exactly
                        @FormatCrypto(_cryptoAmount) @_coin.Symbol from your wallet
                    </li>
                    <li class="text-xs leading-relaxed">
                        <span class="font-medium text-muted-foreground">3.</span> Wait for network
                        confirmation (typically 1-10 minutes)
                    </li>
                </ol>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Payments are verified automatically &middot; Send only @_coin.Symbol on @_coin.Network
            </p>
        </div>
    </div>
</section>

@code {
    private record Coin(string Id, string Symbol, string Name, double Rate, string Address, string Network);

    private static readonly Coin[] _coins =
    [
        new("btc", "BTC", "Bitcoin", 67432.18, "bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh", "Bitcoin Mainnet"),
        new("eth", "ETH", "Ethereum", 3521.47, "0x71C7656EC7ab88b098defB751B7401B5f6d8976F", "Ethereum Mainnet"),
        new("usdc", "USDC", "USD Coin", 1.0, "0x71C7656EC7ab88b098defB751B7401B5f6d8976F", "Ethereum Mainnet"),
    ];

    private const double _orderTotalUsd = 149.99;

    private string _selectedCoinId = "eth";
    private bool _copiedAddress = false;
    private bool _copiedAmount = false;

    private Coin _coin => _coins.FirstOrDefault(c => c.Id == _selectedCoinId) ?? _coins[1];
    private double _cryptoAmount => _orderTotalUsd / _coin.Rate;

    private void SelectCoin(string id)
    {
        _selectedCoinId = id;
        _copiedAddress = false;
        _copiedAmount = false;
    }

    private string FormatCrypto(double amount)
    {
        if (_coin.Id == "usdc") return amount.ToString("F2");
        if (_coin.Id == "btc") return amount.ToString("F8");
        return amount.ToString("F6");
    }

    private System.Threading.Timer? _copyAddressTimer;
    private System.Threading.Timer? _copyAmountTimer;

    private void CopyToClipboard(string text, string type)
    {
        if (type == "address")
        {
            _copiedAddress = true;
            _copyAddressTimer?.Dispose();
            _copyAddressTimer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(() =>
                {
                    _copiedAddress = false;
                    StateHasChanged();
                });
            }, null, 2000, System.Threading.Timeout.Infinite);
        }
        else
        {
            _copiedAmount = true;
            _copyAmountTimer?.Dispose();
            _copyAmountTimer = new System.Threading.Timer(_ =>
            {
                InvokeAsync(() =>
                {
                    _copiedAmount = false;
                    StateHasChanged();
                });
            }, null, 2000, System.Threading.Timeout.Infinite);
        }
    }

    public void Dispose()
    {
        _copyAddressTimer?.Dispose();
        _copyAmountTimer?.Dispose();
    }
}
