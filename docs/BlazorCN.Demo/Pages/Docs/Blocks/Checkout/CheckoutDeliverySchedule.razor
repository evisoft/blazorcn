@* ============================================================
   Block: checkout-delivery-schedule
   Title: CheckoutDeliverySchedule
   Description: A delivery date and time scheduler block with a static calendar grid for date selection, morning, afternoon, and evening time slots, preferred date highlight, and a recurring delivery toggle
   Source: original/blocks/checkout/checkout-delivery-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Delivery Schedule</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Choose your preferred date and time
                </p>
            </div>
            <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
        </div>

        @* Date picker grid *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Select a date</span>
            <div class="mt-2 grid grid-cols-7 gap-1.5">
                @foreach (var d in _dates)
                {
                    var dateItem = d;
                    var isSelected = _selectedDate == dateItem.Id;
                    <button type="button"
                            disabled="@(!dateItem.Available)"
                            @onclick="@(() => _selectedDate = dateItem.Id)"
                            class="@Cn.Merge("flex flex-col items-center rounded-md px-1 py-2 text-center transition-colors", !dateItem.Available ? "pointer-events-none opacity-30" : isSelected ? "bg-foreground text-background" : "hover:bg-muted/50")">
                        <span class="text-[10px] uppercase">@dateItem.Day</span>
                        <span class="font-medium text-sm tabular-nums">@dateItem.Date</span>
                        <span class="text-[10px]">@dateItem.Month</span>
                    </button>
                }
            </div>
        </div>

        @* Time slots *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-2">
                <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Available time slots</span>
            </div>
            <RadioGroupCn @bind-Value="_selectedSlot">
                @foreach (var period in _periods)
                {
                    var per = period;
                    var slotsInPeriod = _timeSlots.Where(s => s.Period == per).ToList();
                    <div class="mb-2 last:mb-0">
                        <span class="mb-1 block text-muted-foreground text-xs">
                            @_periodLabels[per]
                        </span>
                        <div class="space-y-1">
                            @foreach (var slot in slotsInPeriod)
                            {
                                var slotItem = slot;
                                var isActive = _selectedSlot == slotItem.Id;
                                <label for="@slotItem.Id"
                                       class="@Cn.Merge("flex cursor-pointer items-center gap-2.5 rounded-md px-2.5 py-2 transition-colors", isActive ? "bg-muted/50" : "hover:bg-muted/30")">
                                    <RadioGroupItemCn Value="@slotItem.Id" />
                                    <span class="text-sm">@slotItem.Label</span>
                                </label>
                            }
                        </div>
                    </div>
                }
            </RadioGroupCn>
        </div>

        @* Recurring delivery toggle *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="repeat" Size="14" Class="size-3.5 text-muted-foreground" />
                <div>
                    <span class="text-sm">Recurring delivery</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Repeat this delivery every week
                    </p>
                </div>
            </div>
            <SwitchCn @bind-Checked="_recurring" />
        </div>

        @* Summary and confirm *@
        <div class="px-4 py-3">
            @{
                var chosenDate = _dates.FirstOrDefault(d => d.Id == _selectedDate);
                var chosenSlot = _timeSlots.FirstOrDefault(s => s.Id == _selectedSlot);
            }
            @if (chosenDate is not null && chosenSlot is not null)
            {
                <div class="mb-3 rounded-md bg-muted/50 p-3">
                    <span class="font-medium text-muted-foreground text-xs">Selected delivery</span>
                    <p class="mt-1 text-sm">
                        @chosenDate.Day, @chosenDate.Month @chosenDate.Date &middot; @chosenSlot.Label
                    </p>
                    @if (_recurring)
                    {
                        <p class="mt-0.5 text-muted-foreground text-xs">Repeats weekly</p>
                    }
                </div>
            }
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                Confirm Delivery Schedule
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record DateOption(string Id, string Day, string Date, string Month, bool Available);
    private record TimeSlot(string Id, string Label, string Window, string Period);

    private static readonly DateOption[] _dates =
    [
        new("d1", "Mon", "28", "Apr", true),
        new("d2", "Tue", "29", "Apr", true),
        new("d3", "Wed", "30", "Apr", true),
        new("d4", "Thu", "1", "May", false),
        new("d5", "Fri", "2", "May", true),
        new("d6", "Sat", "3", "May", true),
        new("d7", "Sun", "4", "May", false),
    ];

    private static readonly TimeSlot[] _timeSlots =
    [
        new("t1", "8:00 AM - 10:00 AM", "Morning", "morning"),
        new("t2", "10:00 AM - 12:00 PM", "Morning", "morning"),
        new("t3", "12:00 PM - 2:00 PM", "Afternoon", "afternoon"),
        new("t4", "2:00 PM - 4:00 PM", "Afternoon", "afternoon"),
        new("t5", "4:00 PM - 6:00 PM", "Evening", "evening"),
        new("t6", "6:00 PM - 8:00 PM", "Evening", "evening"),
    ];

    private static readonly string[] _periods = ["morning", "afternoon", "evening"];

    private static readonly Dictionary<string, string> _periodLabels = new()
    {
        { "morning", "Morning" },
        { "afternoon", "Afternoon" },
        { "evening", "Evening" },
    };

    private string _selectedDate = "d2";
    private string _selectedSlot = "t3";
    private bool _recurring = false;
}
