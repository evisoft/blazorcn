@* ============================================================
   Block: checkout-recurring-order
   Title: CheckoutRecurringOrder
   Description: A recurring subscription order checkout with frequency selector, next delivery date, skip and pause options, subscription discount display, and first order vs recurring price comparison using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-recurring-order.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="refresh-cw" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Subscribe &amp; Save</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">
                Up to @_maxDiscount% off
            </BadgeCn>
        </div>

        @* Order items *@
        <div class="border-b">
            @foreach (var it in _orderItems)
            {
                var item = it;
                var isLast = Array.IndexOf(_orderItems, item) == _orderItems.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <span class="text-sm">@item.Name</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @item.Variant · Qty @item.Quantity
                        </p>
                    </div>
                    <span class="shrink-0 font-medium text-sm tabular-nums">
                        $@((item.Price * item.Quantity).ToString("F2"))
                    </span>
                </div>
            }
        </div>

        @* Frequency selector *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Delivery Frequency</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Choose how often you want this order delivered
            </p>

            <RadioGroupCn Value="@_selectedFrequency" ValueChanged="@((v) => _selectedFrequency = v ?? _selectedFrequency)" Class="mt-3">
                @foreach (var fr in _frequencies)
                {
                    var freq = fr;
                    var isActive = _selectedFrequency == freq.Id;
                    var isLast = Array.IndexOf(_frequencies, freq) == _frequencies.Length - 1;
                    <span role="button"
                          tabindex="0"
                          class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-muted/50", isActive ? "bg-muted/50" : "", isLast ? "" : "mb-1")"
                          @onclick="@(() => _selectedFrequency = freq.Id)">
                        <RadioGroupItemCn Value="@freq.Id" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@freq.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@freq.Interval</p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                            Save @freq.DiscountPercent%
                        </BadgeCn>
                    </span>
                }
            </RadioGroupCn>
        </div>

        @* Next delivery *@
        @if (_frequency != null)
        {
            <div class="flex items-center gap-2 border-b px-4 py-3">
                <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Next delivery:</span>
                <span class="font-medium text-xs">@_frequency.NextDelivery</span>
            </div>
        }

        @* Flexibility options *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="skip-forward" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Skip anytime</span>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="pause" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Pause or cancel anytime</span>
            </div>
        </div>

        @* Pricing summary *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Subtotal</span>
                <span class="text-xs tabular-nums">$@_subtotal.ToString("F2")</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    Subscription discount (@_discountPercent%)
                </span>
                <span class="text-xs tabular-nums text-emerald-600 dark:text-emerald-400">
                    -$@_discount.ToString("F2")
                </span>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Shipping</span>
                <span class="text-xs tabular-nums">Free</span>
            </div>
            <div class="mt-2 flex items-center justify-between border-t pt-2">
                <div>
                    <span class="font-medium text-sm">First order</span>
                    <p class="text-muted-foreground text-xs">
                        Then $@_firstOrderTotal.ToString("F2")/@_recurringLabel
                    </p>
                </div>
                <span class="font-semibold text-sm tabular-nums">
                    $@_firstOrderTotal.ToString("F2")
                </span>
            </div>
            <ButtonCn Class="mt-3 w-full" Size="ButtonSize.Sm">
                Start Subscription
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Free shipping on all subscription orders
            </p>
        </div>
    </div>
</section>

@code {
    private record Frequency(string Id, string Label, string Interval, int DiscountPercent, string NextDelivery);
    private record OrderItem(string Id, string Name, string Variant, double Price, int Quantity);

    private static readonly Frequency[] _frequencies =
    [
        new("weekly",    "Weekly",        "Every 7 days",  10, "Apr 2, 2026"),
        new("biweekly",  "Every 2 Weeks", "Every 14 days", 10, "Apr 9, 2026"),
        new("monthly",   "Monthly",       "Every 30 days", 15, "Apr 24, 2026"),
    ];

    private static readonly OrderItem[] _orderItems =
    [
        new("1", "Organic Ground Coffee", "Dark Roast / 340g",  18.99, 1),
        new("2", "Oat Milk Creamer",      "Vanilla / 946ml",     5.49, 2),
    ];

    private string _selectedFrequency = "biweekly";

    private Frequency? _frequency => Array.Find(_frequencies, f => f.Id == _selectedFrequency);
    private int _discountPercent => _frequency?.DiscountPercent ?? 0;
    private double _subtotal => _orderItems.Sum(i => i.Price * i.Quantity);
    private double _discount => Math.Round(_subtotal * (_discountPercent / 100.0), 2);
    private double _firstOrderTotal => Math.Round(_subtotal - _discount, 2);

    private int _maxDiscount => _frequencies.Max(f => f.DiscountPercent);

    private string _recurringLabel => _frequency?.Id switch
    {
        "weekly"   => "week",
        "biweekly" => "2 weeks",
        _          => "month",
    };
}
