@* ============================================================
   Block: checkout-back-in-stock
   Title: CheckoutBackInStock
   Description: A back-in-stock purchase checkout block with stock badge, limited quantity warning, reserve timer, quick checkout form with urgency indicators, and real-time stock count using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-back-in-stock.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with badges *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Quick Checkout</span>
            <div class="ml-auto flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs text-emerald-600 dark:text-emerald-400">
                    Back in Stock
                </BadgeCn>
            </div>
        </div>

        @* Product details *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between">
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">@_product.Name</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_product.Variant</p>
                </div>
                <div class="shrink-0 pl-4 text-right">
                    <span class="font-semibold text-sm tabular-nums">
                        $@_product.Price.ToString("F2")
                    </span>
                    <p class="text-muted-foreground text-xs tabular-nums line-through">
                        $@_product.OriginalPrice.ToString("F2")
                    </p>
                </div>
            </div>
        </div>

        @* Urgency indicators *@
        <div class="flex items-center gap-4 border-b bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="triangle-alert" Size="14" Class="size-3.5 text-amber-500" />
                <span class="font-medium text-xs">Only @_product.StockLeft left</span>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-mono text-xs tabular-nums">@_reserveTime</span>
                <span class="text-muted-foreground text-xs">reserved</span>
            </div>
        </div>

        @* Stock info *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        <span class="text-muted-foreground text-xs">@_product.StockLeft available</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        <span class="text-muted-foreground text-xs">
                            @_product.WaitlistSize on waitlist
                        </span>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">Qty</span>
                    <select aria-label="Quantity" value="@_quantity" @onchange="@(e => _quantity = int.Parse(e.Value?.ToString() ?? "1"))"
                            class="h-7 rounded border bg-transparent px-2 text-xs">
                        @foreach (var n in Enumerable.Range(1, _maxQuantity))
                        {
                            <option value="@n">@n</option>
                        }
                    </select>
                </div>
            </div>
            <p class="mt-1.5 text-muted-foreground text-xs">
                Limit @_maxQuantity per customer · @(_product.TotalRestock - _product.StockLeft) of
                @_product.TotalRestock already sold
            </p>
        </div>

        @* Quick checkout form *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2 mb-3">
                <LucideIconCn Name="zap" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Express Checkout</span>
            </div>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="bis-email" Class="text-xs">Email</LabelCn>
                    <InputCn Id="bis-email" Type="email" Placeholder="@("you@example.com")" @bind-Value="_email" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="bis-card" Class="text-xs">Card number</LabelCn>
                    <InputCn Id="bis-card" Placeholder="4242 4242 4242 4242" @bind-Value="_cardNumber" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="bis-expiry" Class="text-xs">Expiry date</LabelCn>
                        <InputCn Id="bis-expiry" Placeholder="MM / YY" @bind-Value="_expiry" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="bis-cvv" Class="text-xs">CVV</LabelCn>
                        <InputCn Id="bis-cvv" Placeholder="123" @bind-Value="_cvv" />
                    </div>
                </div>
            </div>
        </div>

        @* Total and action *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    @_product.Name x @_quantity
                </span>
                <span class="text-xs tabular-nums">$@_total.ToString("F2")</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Shipping</span>
                <span class="text-xs">Free</span>
            </div>
            <div class="mt-2 flex items-center justify-between border-t pt-2">
                <span class="font-medium text-sm">Total</span>
                <span class="font-semibold text-sm tabular-nums">$@_total.ToString("F2")</span>
            </div>
            <ButtonCn Class="mt-3 w-full" Size="ButtonSize.Sm">
                <LucideIconCn Name="lock" Size="14" Class="mr-1.5 size-3.5" />
                Complete Purchase
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Your item is reserved for the next 15 minutes
            </p>
        </div>
    </div>
</section>

@code {
    private record ProductInfo(
        string Name, string Variant, double Price, double OriginalPrice,
        int StockLeft, int TotalRestock, int WaitlistSize);

    private static readonly ProductInfo _product = new(
        "Apex Ergonomic Chair", "Graphite / Mesh Back",
        749.0, 849.0, 3, 50, 312);

    private const string _reserveTime = "15:00";

    private string _email = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";
    private int _quantity = 1;

    private int _maxQuantity => Math.Min(_product.StockLeft, 2);
    private double _total => _product.Price * _quantity;
}
