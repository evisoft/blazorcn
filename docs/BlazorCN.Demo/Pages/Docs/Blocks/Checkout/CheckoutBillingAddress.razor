@* ============================================================
   Block: checkout-billing-address
   Title: CheckoutBillingAddress
   Description: A checkout billing address form for React and Next.js with same-as-shipping toggle, separate billing fields, country selector with flag emoji, address validation indicators, and clean form layout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-billing-address.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="map-pin" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Billing address</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Enter the address associated with your payment method
            </p>
        </div>

        @* Shipping address summary *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Shipping to</span>
            <div class="mt-1.5 rounded-md bg-muted/50 p-3">
                <p class="font-medium text-sm">@_shippingAddress.Name</p>
                <p class="mt-0.5 text-muted-foreground text-xs">@_shippingAddress.Street</p>
                <p class="text-muted-foreground text-xs">
                    @_shippingAddress.City, @_shippingAddress.State @_shippingAddress.Postal
                </p>
            </div>
        </div>

        @* Same as shipping toggle *@
        <div class="border-b px-4 py-3">
            <label for="ba-same-as-shipping" class="flex cursor-pointer items-center gap-2.5">
                <CheckboxCn Id="ba-same-as-shipping" aria-label="Same as shipping address" @bind-Checked="_sameAsShipping" />
                <span class="text-sm">Same as shipping address</span>
            </label>
        </div>

        @* Billing form - only visible when not same as shipping *@
        @if (!_sameAsShipping)
        {
            <div class="border-b px-4 py-3">
                <div class="space-y-3">
                    @* Country *@
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">
                            Country
                        </span>
                        <SelectCn @bind-Value="_country">
                            <SelectTriggerCn class="h-8 w-full text-sm" aria-label="Billing country">
                                <SelectValueCn Placeholder="Select country" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                @foreach (var c in _countries)
                                {
                                    var countryItem = c;
                                    <SelectItemCn Value="@countryItem.Code">
                                        <span class="mr-1.5">@countryItem.Flag</span>@countryItem.Name
                                    </SelectItemCn>
                                }
                            </SelectContentCn>
                        </SelectCn>
                    </div>

                    @* Full name *@
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">
                            Full name
                        </span>
                        <InputCn aria-label="Full name" Placeholder="Jane Smith" Class="h-8 text-sm" />
                    </div>

                    @* Street address *@
                    <div>
                        <div class="mb-1 flex items-center justify-between">
                            <span class="font-medium text-muted-foreground text-xs">Street address</span>
                        </div>
                        <InputCn aria-label="Street address" Placeholder="123 Main Street" Class="h-8 text-sm" />
                    </div>

                    @* Apt / Suite *@
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">
                            Apartment, suite, etc. (optional)
                        </span>
                        <InputCn aria-label="Apartment, suite, etc." Placeholder="Apt 4B" Class="h-8 text-sm" />
                    </div>

                    @* City + State *@
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <span class="mb-1 block font-medium text-muted-foreground text-xs">City</span>
                            <InputCn aria-label="City" Placeholder="San Francisco" Class="h-8 text-sm" />
                        </div>
                        <div>
                            <span class="mb-1 block font-medium text-muted-foreground text-xs">
                                State / Province
                            </span>
                            <InputCn aria-label="State / Province" Placeholder="CA" Class="h-8 text-sm" />
                        </div>
                    </div>

                    @* Postal + validation *@
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">
                            Postal code
                        </span>
                        <div class="relative">
                            <InputCn aria-label="Postal code" Placeholder="94105" Class="h-8 pr-8 text-sm" />
                            <div class="absolute top-1/2 right-2.5 -translate-y-1/2">
                                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                            </div>
                        </div>
                        <p class="mt-1 flex items-center gap-1.5 text-xs">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            <span class="text-muted-foreground">Address verified</span>
                        </p>
                    </div>
                </div>
            </div>
        }

        @* Actions *@
        <div class="px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                Continue to payment
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _sameAsShipping = true;
    private string _country = "US";

    private record ShippingAddress(string Name, string Street, string City, string State, string Postal, string Country);

    private static readonly ShippingAddress _shippingAddress = new(
        "Jane Smith",
        "123 Market Street, Apt 4B",
        "San Francisco",
        "CA",
        "94105",
        "US"
    );

    private record CountryOption(string Code, string Flag, string Name);

    private static readonly CountryOption[] _countries =
    [
        new("US", "🇺🇸", "United States"),
        new("CA", "🇨🇦", "Canada"),
        new("GB", "🇬🇧", "United Kingdom"),
        new("DE", "🇩🇪", "Germany"),
        new("FR", "🇫🇷", "France"),
        new("AU", "🇦🇺", "Australia"),
        new("JP", "🇯🇵", "Japan"),
        new("BR", "🇧🇷", "Brazil"),
    ];
}
