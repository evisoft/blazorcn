@* ============================================================
   Block: checkout-receipt-email
   Title: CheckoutReceiptEmail
   Description: An email receipt preview for React and Next.js with order summary, line items table, payment method, shipping address, and support contact using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-receipt-email.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Email header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="store" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <span class="font-medium text-sm">Acme Store</span>
            </div>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="mail" Size="12" Class="size-3" />
                Receipt
            </div>
        </div>

        @* Order info *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Order Confirmed</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Thank you for your purchase</p>
            </div>
            <div class="text-right">
                <span class="font-mono text-sm">@_orderNumber</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_orderDate</p>
            </div>
        </div>

        @* Line items *@
        <div class="border-b">
            @{
                var lineItemList = _lineItems.ToList();
            }
            @foreach (var it in lineItemList)
            {
                var item = it;
                var isLast = lineItemList.IndexOf(item) == lineItemList.Count - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@item.Name</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @item.Variant &middot; Qty @item.Quantity
                        </p>
                    </div>
                    <span class="shrink-0 font-medium text-sm tabular-nums">
                        $@((item.Price * item.Quantity).ToString("F2"))
                    </span>
                </div>
            }
        </div>

        @* Totals *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-muted-foreground text-xs">
                <span>Subtotal</span>
                <span class="tabular-nums">$@_subtotal.ToString("F2")</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-muted-foreground text-xs">
                <span>Shipping</span>
                <span>@(_shipping == 0 ? "Free" : $"${_shipping:F2}")</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-muted-foreground text-xs">
                <span>Tax</span>
                <span class="tabular-nums">$@_tax.ToString("F2")</span>
            </div>
            <SeparatorCn Class="my-2" />
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Total</span>
                <span class="font-semibold text-sm tabular-nums">$@_total.ToString("F2")</span>
            </div>
        </div>

        @* Payment and Shipping *@
        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Payment Method</span>
                <p class="mt-1 text-sm">@_paymentMethod</p>
            </div>
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Ship To</span>
                <div class="mt-1 text-sm">
                    <p>@_shippingAddress.Name</p>
                    <p class="text-muted-foreground text-xs">
                        @_shippingAddress.Line1@(string.IsNullOrEmpty(_shippingAddress.Line2) ? "" : $", {_shippingAddress.Line2}")
                    </p>
                    <p class="text-muted-foreground text-xs">
                        @_shippingAddress.City, @_shippingAddress.State @_shippingAddress.Zip
                    </p>
                </div>
            </div>
        </div>

        @* Support footer *@
        <div class="px-4 py-3 text-center">
            <p class="text-muted-foreground text-xs">
                Questions about your order? Contact us at&#160;<span class="font-medium text-foreground">support@@acme.store</span>
            </p>
        </div>
    </div>
</section>

@code {
    private record LineItem(string Name, string Variant, int Quantity, double Price);

    private record ShippingAddress(string Name, string Line1, string Line2, string City, string State, string Zip);

    private static readonly string _orderNumber = "ORD-2938471";
    private static readonly string _orderDate = "March 20, 2026";

    private static readonly LineItem[] _lineItems =
    [
        new("Merino Wool Crewneck", "Heather Gray / M", 1, 89.0),
        new("Slim Chino Pants",     "Navy / 32x32",     1, 79.0),
        new("Canvas Tote Bag",      "Natural",          2, 24.0),
    ];

    private static readonly double _subtotal = 216.0;
    private static readonly double _shipping = 0;
    private static readonly double _tax = 17.28;
    private static readonly double _total = 233.28;

    private static readonly string _paymentMethod = "Visa ending in 4242";

    private static readonly ShippingAddress _shippingAddress = new(
        Name:  "Alex Morgan",
        Line1: "742 Evergreen Terrace",
        Line2: "Apt 3B",
        City:  "Portland",
        State: "OR",
        Zip:   "97201"
    );
}
