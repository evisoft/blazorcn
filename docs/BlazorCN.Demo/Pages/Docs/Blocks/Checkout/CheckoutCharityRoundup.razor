@* ============================================================
   Block: checkout-charity-roundup
   Title: CheckoutCharityRoundup
   Description: A React charity round-up donation block for Next.js checkout with round-up toggle, charity selection, community donation total, and impact statement using shadcn/ui Button, Switch, and Tailwind CSS
   Source: original/blocks/checkout/checkout-charity-roundup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header with toggle *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="heart" Size="16" Class="size-4 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Round up for charity</span>
                <p class="text-muted-foreground text-xs">Donate the change from your order</p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
                <span class="text-xs text-muted-foreground">@(_enabled ? "On" : "Off")</span>
                <SwitchCn aria-label="Round up for charity" Checked="@_enabled" CheckedChanged="@((bool v) => _enabled = v)" />
            </div>
        </div>

        @* Round-up breakdown *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Order total</span>
                <span class="text-sm tabular-nums">$@OrderTotal.ToString("F2")</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Rounded up to</span>
                <span class="text-sm tabular-nums">$@RoundedTotal.ToString("F2")</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between border-t pt-1.5">
                <span class="font-medium text-xs">Your donation</span>
                <span class="font-medium text-sm tabular-nums text-emerald-600 dark:text-emerald-400">
                    $@DonationAmount.ToString("F2")
                </span>
            </div>
        </div>

        @* Charity selection *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Choose a charity</span>
            <div class="mt-2 space-y-0">
                @foreach (var it in _charities)
                {
                    var charity = it;
                    var isSelected = _selectedCharityId == charity.Id;
                    var isLast = _charities.IndexOf(charity) == _charities.Count - 1;
                    <label class="@Cn.Merge("flex cursor-pointer items-center gap-3 py-2.5 transition-colors", isLast ? "" : "border-b")">
                        <input type="radio"
                               name="charity"
                               value="@charity.Id"
                               checked="@isSelected"
                               @onchange="@(() => _selectedCharityId = charity.Id)"
                               class="accent-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@charity.Name</span>
                                <span class="text-muted-foreground text-xs">@charity.Category</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@charity.Impact</p>
                        </div>
                    </label>
                }
            </div>
        </div>

        @* Community impact *@
        <div class="border-b bg-muted/50 px-4 py-3">
            <div class="flex items-center gap-2 mb-2">
                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">Community impact</span>
            </div>
            <div class="flex items-center gap-6">
                <div>
                    <span class="font-semibold text-lg tabular-nums">
                        $@CommunityTotal.ToString("N1")
                    </span>
                    <p class="text-muted-foreground text-xs">Total donated</p>
                </div>
                <div>
                    <span class="font-semibold text-lg tabular-nums">
                        @CommunityOrders.ToString("N0")
                    </span>
                    <p class="text-muted-foreground text-xs">Orders rounded up</p>
                </div>
            </div>
        </div>

        @* Impact statement + CTA *@
        <div class="px-4 py-3">
            @if (_enabled)
            {
                var selected = _charities.Find(c => c.Id == _selectedCharityId) ?? _charities[0];
                <div class="mb-3 rounded-md bg-muted/50 p-3">
                    <span class="text-xs font-medium text-muted-foreground">Your impact</span>
                    <p class="mt-1 text-sm">@selected.Impact</p>
                </div>
            }
            <ButtonCn Class="w-full"
                      Variant="@(_enabled ? ButtonVariant.Default : ButtonVariant.Outline)"
                      OnClick="@(() => _enabled = !_enabled)">
                @if (_enabled)
                {
                    @($"Continue — ${RoundedTotal.ToString("F2")} total")
                }
                else
                {
                    @($"Round Up for ${DonationAmount.ToString("F2")}")
                }
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                @if (_enabled)
                {
                    var sel = _charities.Find(c => c.Id == _selectedCharityId) ?? _charities[0];
                    @($"${DonationAmount.ToString("F2")} goes to {sel.Name}")
                }
                else
                {
                    @("100% of round-up goes directly to your chosen charity")
                }
            </p>
        </div>

    </div>
</section>

@code {
    private record Charity(string Id, string Name, string Category, string Impact);

    private const double OrderTotal = 47.32;
    private static readonly double RoundedTotal = Math.Ceiling(OrderTotal);
    private static readonly double DonationAmount = RoundedTotal - OrderTotal;
    private const double CommunityTotal = 18472.5;
    private const int CommunityOrders = 31847;

    private readonly List<Charity> _charities =
    [
        new("1", "Meals on Wheels",        "Hunger Relief", "$0.50 provides one meal to a senior in need"),
        new("2", "Code.org",               "Education",     "$1 gives one student access to a computer science lesson"),
        new("3", "Ocean Conservancy",      "Environment",   "$0.75 removes 1 lb of trash from coastal waterways"),
        new("4", "Doctors Without Borders","Healthcare",    "$2 provides a vaccination for a child in crisis"),
    ];

    private bool _enabled = false;
    private string _selectedCharityId = "1";
}
