@* ============================================================
   Block: checkout-accessibility-options
   Title: CheckoutAccessibilityOptions
   Description: An accessible checkout block for React and Next.js with large text toggle, high contrast mode, screen reader hints, properly labeled form fields, descriptive error states, and tab order indicators using shadcn/ui Switch, Input, Label, Button, and Tailwind CSS
   Source: original/blocks/checkout/checkout-accessibility-options.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="@($"overflow-hidden rounded-lg border bg-card {_contrastBorder}")">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="accessibility" Size="16" Class="@($"size-4 {_contrastText}")" />
            <span class="@($"font-medium {_textBase}")">Accessible Checkout</span>
            <span class="@($"ml-auto {_textSmall} {_contrastText}")">$@(OrderTotal.ToString("F2"))</span>
        </div>

        @* Accessibility options *@
        <div class="border-b px-4 py-3">
            <span class="@($"mb-3 block font-medium {_textSmall} {_contrastText}")">
                Accessibility options
            </span>
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="type" Size="14" Class="@($"size-3.5 {_contrastText}")" />
                        <div>
                            <LabelCn For="ac-large-text" Class="@_textSmall">
                                Large text
                            </LabelCn>
                            @if (_srHints)
                            {
                                <p class="@($"{_textSmall} {_contrastText}")" id="ac-large-text-hint">
                                    Increases font size throughout checkout
                                </p>
                            }
                        </div>
                    </div>
                    <SwitchCn Id="ac-large-text"
                              Checked="@_largeText"
                              OnCheckedChange="@((bool v) => _largeText = v)"
                              aria-describedby="@(_srHints ? "ac-large-text-hint" : null)" />
                </div>

                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="eye" Size="14" Class="@($"size-3.5 {_contrastText}")" />
                        <div>
                            <LabelCn For="ac-contrast" Class="@_textSmall">
                                High contrast
                            </LabelCn>
                            @if (_srHints)
                            {
                                <p class="@($"{_textSmall} {_contrastText}")" id="ac-contrast-hint">
                                    Increases border and text contrast ratios
                                </p>
                            }
                        </div>
                    </div>
                    <SwitchCn Id="ac-contrast"
                              Checked="@_highContrast"
                              OnCheckedChange="@((bool v) => _highContrast = v)"
                              aria-describedby="@(_srHints ? "ac-contrast-hint" : null)" />
                </div>

                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="accessibility" Size="14" Class="@($"size-3.5 {_contrastText}")" />
                        <div>
                            <LabelCn For="ac-sr-hints" Class="@_textSmall">
                                Show screen reader hints
                            </LabelCn>
                            @if (_srHints)
                            {
                                <p class="@($"{_textSmall} {_contrastText}")" id="ac-sr-hint">
                                    Displays hidden accessibility text visually
                                </p>
                            }
                        </div>
                    </div>
                    <SwitchCn Id="ac-sr-hints"
                              Checked="@_srHints"
                              OnCheckedChange="@((bool v) => _srHints = v)"
                              aria-describedby="@(_srHints ? "ac-sr-hint" : null)" />
                </div>
            </div>
        </div>

        @* Contact section *@
        <div class="border-b px-4 py-4">
            <span class="@($"mb-3 block font-medium {_textBase}")">Contact</span>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="ac-name" Class="@_textSmall">
                        Full name
                    </LabelCn>
                    @if (_srHints)
                    {
                        <p class="@($"{_textSmall} {_contrastText}")" id="ac-name-hint">
                            Enter your first and last name as it appears on your ID
                        </p>
                    }
                    <InputCn Id="ac-name"
                             Placeholder="Jane Smith"
                             @bind-Value="_name"
                             Class="@(_largeText ? "text-base" : "")"
                             aria-describedby="@(_srHints ? "ac-name-hint" : null)" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="ac-email" Class="@_textSmall">
                        Email address
                    </LabelCn>
                    @if (_srHints)
                    {
                        <p class="@($"{_textSmall} {_contrastText}")" id="ac-email-hint">
                            We will send your receipt to this email
                        </p>
                    }
                    <InputCn Id="ac-email"
                             Type="email"
                             Placeholder="@("jane@example.com")"
                             @bind-Value="_email"
                             Class="@Cn.Merge(_largeText ? "text-base" : "", _emailError != null ? "border-red-500" : "")"
                             aria-invalid="@(_emailError != null ? "true" : "false")"
                             aria-describedby="@(_emailError != null ? "ac-email-error" : _srHints ? "ac-email-hint" : null)" />
                    @if (_emailError != null)
                    {
                        <p id="ac-email-error" role="alert" aria-live="polite"
                           class="flex items-center gap-1 text-red-500 text-xs">
                            <LucideIconCn Name="alert-circle" Size="12" Class="size-3 shrink-0" />
                            @_emailError
                        </p>
                    }
                </div>
            </div>
        </div>

        @* Payment section *@
        <div class="border-b px-4 py-4">
            <span class="@($"mb-3 block font-medium {_textBase}")">Payment</span>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="ac-card" Class="@_textSmall">
                        Card number
                    </LabelCn>
                    @if (_srHints)
                    {
                        <p class="@($"{_textSmall} {_contrastText}")" id="ac-card-hint">
                            Enter 16-digit card number without spaces
                        </p>
                    }
                    <InputCn Id="ac-card"
                             Placeholder="4242 4242 4242 4242"
                             @bind-Value="_cardNumber"
                             Class="@Cn.Merge(_largeText ? "text-base" : "", _cardError != null ? "border-red-500" : "")"
                             aria-invalid="@(_cardError != null ? "true" : "false")"
                             aria-describedby="@(_cardError != null ? "ac-card-error" : _srHints ? "ac-card-hint" : null)" />
                    @if (_cardError != null)
                    {
                        <p id="ac-card-error" role="alert" aria-live="polite"
                           class="flex items-center gap-1 text-red-500 text-xs">
                            <LucideIconCn Name="alert-circle" Size="12" Class="size-3 shrink-0" />
                            @_cardError
                        </p>
                    }
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="ac-expiry" Class="@_textSmall">
                            Expiry date
                        </LabelCn>
                        @if (_srHints)
                        {
                            <p class="@($"{_textSmall} {_contrastText}")" id="ac-expiry-hint">
                                Month and year in MM / YY format
                            </p>
                        }
                        <InputCn Id="ac-expiry"
                                 Placeholder="MM / YY"
                                 @bind-Value="_expiry"
                                 Class="@(_largeText ? "text-base" : "")"
                                 aria-describedby="@(_srHints ? "ac-expiry-hint" : null)" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="ac-cvv" Class="@_textSmall">
                            Security code
                        </LabelCn>
                        @if (_srHints)
                        {
                            <p class="@($"{_textSmall} {_contrastText}")" id="ac-cvv-hint">
                                3-digit code on the back of your card
                            </p>
                        }
                        <InputCn Id="ac-cvv"
                                 Placeholder="123"
                                 @bind-Value="_cvv"
                                 Class="@(_largeText ? "text-base" : "")"
                                 aria-describedby="@(_srHints ? "ac-cvv-hint" : null)" />
                    </div>
                </div>
            </div>
        </div>

        @* Error demo toggle *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="@($"{_textSmall} {_contrastText}")">Preview error states</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs"
                          @onclick="@(() => _showErrors = !_showErrors)">
                    @(_showErrors ? "Hide errors" : "Show errors")
                </ButtonCn>
            </div>
        </div>

        @* Pay button *@
        <div class="px-4 py-3">
            <ButtonCn Class="@($"w-full {(_largeText ? "text-base" : "")}")">
                Pay $@OrderTotal.ToString("F2")
            </ButtonCn>
            <p class="@($"mt-2 flex items-center justify-center gap-1 {_textSmall} {_contrastText}")">
                <LucideIconCn Name="lock" Size="12" Class="size-3" />
                Encrypted and secure
            </p>
        </div>
    </div>
</section>

@code {
    private const double OrderTotal = 89.0;

    private bool _largeText = false;
    private bool _highContrast = false;
    private bool _srHints = false;
    private bool _showErrors = false;

    private string _email = "";
    private string _name = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";

    private string _textBase => _largeText ? "text-base" : "text-sm";
    private string _textSmall => _largeText ? "text-sm" : "text-xs";
    private string _contrastBorder => _highContrast ? "border-foreground/40" : "";
    private string _contrastText => _highContrast ? "text-foreground" : "text-muted-foreground";

    private string? _emailError => _showErrors
        ? "Enter a valid email address, for example: name@company.com"
        : null;

    private string? _cardError => _showErrors
        ? "Card number must be 16 digits. You entered 12 digits."
        : null;
}
