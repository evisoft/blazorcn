@* ============================================================
   Block: checkout-order-tracking
   Title: CheckoutOrderTracking
   Description: A post-checkout order tracking display for React and Next.js with status timeline, tracking number copy button, carrier info, and estimated delivery using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-order-tracking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Order Tracking</span>
                <p class="mt-0.5 text-muted-foreground text-xs">@_orderNumber</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                In Transit
            </BadgeCn>
        </div>

        @* Timeline *@
        <div class="border-b px-4 py-4">
            <div class="space-y-0">
                @foreach (var step in _steps)
                {
                    var index = Array.IndexOf(_steps, step);
                    var isCompleted = index < _currentStep;
                    var isActive = index == _currentStep;
                    var isFuture = index > _currentStep;
                    var isLast = index == _steps.Length - 1;
                    <div class="flex gap-3">
                        @* Dot and line *@
                        <div class="flex flex-col items-center">
                            @if (isCompleted)
                            {
                                <div class="flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500">
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-white" />
                                </div>
                            }
                            else if (isActive)
                            {
                                <div class="relative flex size-5 shrink-0 items-center justify-center">
                                    <span class="absolute size-5 animate-ping rounded-full bg-emerald-500/20"></span>
                                    <span class="size-3 rounded-full bg-emerald-500"></span>
                                </div>
                            }
                            else
                            {
                                <div class="flex size-5 shrink-0 items-center justify-center">
                                    <span class="size-2 rounded-full bg-muted-foreground/30"></span>
                                </div>
                            }
                            @if (!isLast)
                            {
                                <div class="@Cn.Merge("my-1 h-8 w-px", isCompleted ? "bg-emerald-500" : isFuture ? "border-l border-dashed border-muted-foreground/30" : "bg-emerald-500/40")"></div>
                            }
                        </div>

                        @* Content *@
                        <div class="@Cn.Merge("pb-4", isFuture ? "opacity-50" : "")">
                            <span class="font-medium text-sm">@step.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                            @if (!string.IsNullOrEmpty(step.Timestamp))
                            {
                                <p class="mt-0.5 font-mono text-muted-foreground text-xs">@step.Timestamp</p>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Tracking info *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="truck" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <span class="font-medium text-sm">@_carrier</span>
                        <p class="font-mono text-muted-foreground text-xs">@_trackingNumber</p>
                    </div>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="CopyTracking">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        @:Copied
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        @:Copy
                    }
                </ButtonCn>
            </div>
        </div>

        @* Estimated delivery *@
        <div class="flex items-center gap-2 px-4 py-3">
            <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
            <span class="text-muted-foreground text-xs">Estimated delivery</span>
            <span class="font-medium text-sm">@_estimatedDelivery</span>
        </div>
    </div>
</section>

@code {
    private record TrackingStep(string Label, string Description, string Timestamp);

    private static readonly TrackingStep[] _steps =
    [
        new("Order Placed",  "Your order has been confirmed",           "Mar 20, 9:14 AM"),
        new("Processing",    "Items are being prepared for shipment",   "Mar 20, 2:38 PM"),
        new("Shipped",       "Package handed to carrier",               "Mar 21, 10:05 AM"),
        new("Delivered",     "Package delivered to your address",       ""),
    ];

    private const int _currentStep = 2;
    private const string _orderNumber       = "ORD-2938471";
    private const string _trackingNumber    = "1Z999AA10123456784";
    private const string _carrier           = "UPS Ground";
    private const string _estimatedDelivery = "Mar 24 - Mar 25";

    private bool _copied;

    private async Task CopyTracking()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
