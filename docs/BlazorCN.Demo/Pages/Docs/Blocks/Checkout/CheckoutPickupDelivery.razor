@* ============================================================
   Block: checkout-pickup-delivery
   Title: CheckoutPickupDelivery
   Description: A pickup versus delivery checkout block for React and Next.js with fulfillment toggle, store selector with address and hours, delivery address form, time slot picker, and estimated arrival display built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-pickup-delivery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Fulfillment</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Choose how you want to receive your order.
            </p>
        </div>

        @* Mode toggle *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="@Cn.Merge("h-7 flex-1 gap-1.5 text-xs", _mode == "pickup" ? "bg-background shadow-sm" : "text-muted-foreground")"
                          OnClick="@(() => _mode = "pickup")">
                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                    Pickup
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="@Cn.Merge("h-7 flex-1 gap-1.5 text-xs", _mode == "delivery" ? "bg-background shadow-sm" : "text-muted-foreground")"
                          OnClick="@(() => _mode = "delivery")">
                    <LucideIconCn Name="truck" Size="12" Class="size-3" />
                    Delivery
                </ButtonCn>
            </div>
        </div>

        @if (_mode == "pickup")
        {
            @* Store selector *@
            <div class="border-b">
                <div class="px-4 pt-3 pb-1.5">
                    <span class="font-medium text-muted-foreground text-xs">Select a store</span>
                </div>
                @foreach (var s in _stores)
                {
                    var store = s;
                    var isSelected = _selectedStore == store.Id;
                    var isLast = store.Id == _stores[^1].Id;
                    <button type="button"
                            @onclick="@(() => _selectedStore = store.Id)"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", isSelected ? "bg-foreground" : "bg-muted-foreground/30")" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@store.Name</span>
                                <span class="text-muted-foreground text-xs">@store.Distance</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @store.Address, @store.City
                            </p>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                    </button>
                }
            </div>

            @* Selected store details *@
            var activeStore = _stores.FirstOrDefault(s => s.Id == _selectedStore) ?? _stores[0];
            <div class="border-b px-4 py-3">
                <div class="rounded-md bg-muted/50 p-3">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-sm">@activeStore.Name</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @activeStore.ReadyTime
                        </BadgeCn>
                    </div>
                    <div class="mt-2 space-y-1">
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-muted-foreground text-xs">
                                @activeStore.Address, @activeStore.City
                            </span>
                        </div>
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-muted-foreground text-xs">@activeStore.Hours</span>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            @* Delivery address *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Delivery address</span>
                <div class="mt-3 space-y-3">
                    <div>
                        <LabelCn Class="text-xs font-medium text-muted-foreground">
                            Street address
                        </LabelCn>
                        <InputCn @bind-Value="_street" Placeholder="123 Main Street" Class="mt-1 h-8 text-sm" />
                    </div>
                    <div>
                        <LabelCn Class="text-xs font-medium text-muted-foreground">
                            Apt, suite, floor
                        </LabelCn>
                        <InputCn @bind-Value="_apt" Placeholder="Apt 1A" Class="mt-1 h-8 text-sm" />
                    </div>
                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <LabelCn Class="text-xs font-medium text-muted-foreground">City</LabelCn>
                            <InputCn @bind-Value="_city" Placeholder="San Francisco" Class="mt-1 h-8 text-sm" />
                        </div>
                        <div>
                            <LabelCn Class="text-xs font-medium text-muted-foreground">State</LabelCn>
                            <InputCn @bind-Value="_state" Placeholder="CA" Class="mt-1 h-8 text-sm" />
                        </div>
                        <div>
                            <LabelCn Class="text-xs font-medium text-muted-foreground">ZIP code</LabelCn>
                            <InputCn @bind-Value="_zip" Placeholder="94107" Class="mt-1 h-8 text-sm" />
                        </div>
                    </div>
                </div>
            </div>

            @* Delivery time slots *@
            <div class="border-b">
                <div class="px-4 pt-3 pb-1.5">
                    <span class="font-medium text-muted-foreground text-xs">Delivery window</span>
                </div>
                @for (var i = 0; i < _deliverySlots.Length; i++)
                {
                    var idx = i;
                    var slotItem = _deliverySlots[idx];
                    var isSelected = _selectedSlot == slotItem.Id;
                    var isLast = idx == _deliverySlots.Length - 1;
                    var showDateHeader = idx == 0 || _deliverySlots[idx - 1].Date != slotItem.Date;
                    <div>
                        @if (showDateHeader)
                        {
                            <div class="border-b px-4 py-1.5">
                                <span class="font-medium text-muted-foreground text-xs">@slotItem.Date</span>
                            </div>
                        }
                        <button type="button"
                                disabled="@(!slotItem.Available)"
                                @onclick="@(() => { if (slotItem.Available) _selectedSlot = slotItem.Id; })"
                                class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors", slotItem.Available ? "hover:bg-muted/50" : "cursor-not-allowed opacity-50", !isLast ? "border-b" : "")">
                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", isSelected && slotItem.Available ? "bg-foreground" : "bg-muted-foreground/30")" />
                            <span class="flex-1 text-sm">@slotItem.Window</span>
                            @if (!slotItem.Available)
                            {
                                <span class="text-muted-foreground text-xs">Full</span>
                            }
                            @if (slotItem.Available)
                            {
                                <span class="@Cn.Merge("text-xs tabular-nums", slotItem.Fee == "Free" ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                                    @slotItem.Fee
                                </span>
                            }
                        </button>
                    </div>
                }
            </div>

            @* Estimated arrival *@
            var activeSlot = _deliverySlots.FirstOrDefault(s => s.Id == _selectedSlot);
            @if (activeSlot is not null)
            {
                <div class="border-b px-4 py-3">
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="truck" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="font-medium text-muted-foreground text-xs">
                                Estimated arrival
                            </span>
                        </div>
                        <p class="mt-1 text-sm">
                            @activeSlot.Date, @activeSlot.Window
                        </p>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @_street@(string.IsNullOrEmpty(_apt) ? "" : $", {_apt}"), @_city, @_state @_zip
                        </p>
                    </div>
                </div>
            }
        }

        @* Confirm button *@
        <div class="px-4 py-3">
            @{
                var confirmStore = _stores.FirstOrDefault(s => s.Id == _selectedStore) ?? _stores[0];
                var confirmSlot = _deliverySlots.FirstOrDefault(s => s.Id == _selectedSlot);
            }
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                @if (_mode == "pickup")
                {
                    @($"Confirm Pickup at {confirmStore.Name}")
                }
                else
                {
                    @("Confirm Delivery")
                }
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                @if (_mode == "pickup")
                {
                    @($"{confirmStore.ReadyTime} · Bring your order confirmation")
                }
                else if (confirmSlot is not null)
                {
                    @($"{confirmSlot.Date}, {confirmSlot.Window} {(confirmSlot.Fee != "Free" ? $"· {confirmSlot.Fee} delivery fee" : "· Free delivery")}")
                }
                else
                {
                    @("Select a delivery window")
                }
            </p>
        </div>
    </div>
</section>

@code {
    private record Store(string Id, string Name, string Address, string City, string Hours, string ReadyTime, string Distance);
    private record TimeSlot(string Id, string Window, string Date, bool Available, string Fee);

    private static readonly Store[] _stores =
    [
        new("store-1", "Downtown Market", "142 Main Street", "San Francisco, CA 94105", "Mon-Sat 8am-9pm, Sun 9am-7pm", "Ready in 2 hours", "0.4 mi"),
        new("store-2", "Mission District", "783 Valencia Street", "San Francisco, CA 94110", "Mon-Sun 7am-10pm", "Ready in 3 hours", "1.2 mi"),
        new("store-3", "Sunset Location", "2105 Irving Street", "San Francisco, CA 94122", "Mon-Sat 9am-8pm, Sun 10am-6pm", "Ready tomorrow by 10am", "3.8 mi"),
    ];

    private static readonly TimeSlot[] _deliverySlots =
    [
        new("slot-1", "9:00 AM - 12:00 PM", "Tomorrow, Mar 25", true, "Free"),
        new("slot-2", "12:00 PM - 3:00 PM", "Tomorrow, Mar 25", true, "Free"),
        new("slot-3", "3:00 PM - 6:00 PM", "Tomorrow, Mar 25", false, "Free"),
        new("slot-4", "6:00 PM - 9:00 PM", "Tomorrow, Mar 25", true, "$4.99"),
        new("slot-5", "9:00 AM - 12:00 PM", "Wed, Mar 26", true, "Free"),
        new("slot-6", "12:00 PM - 3:00 PM", "Wed, Mar 26", true, "Free"),
    ];

    private string _mode = "pickup";
    private string _selectedStore = "store-1";
    private string _selectedSlot = "slot-1";
    private string _street = "456 Oak Avenue";
    private string _apt = "Apt 3B";
    private string _city = "San Francisco";
    private string _state = "CA";
    private string _zip = "94107";
}
