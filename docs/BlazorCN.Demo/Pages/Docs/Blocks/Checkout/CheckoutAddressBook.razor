@* ============================================================
   Block: checkout-address-book
   Title: CheckoutAddressBook
   Description: An address book checkout block for React and Next.js with saved addresses list, default badge, radio selection, edit and delete options, and an add new address form using shadcn/ui RadioGroup, Input, Label, Button, Badge, and Tailwind CSS
   Source: original/blocks/checkout/checkout-address-book.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Shipping Address</span>
            <span class="ml-auto text-muted-foreground text-xs">@_addresses.Count saved</span>
        </div>

        @* Saved addresses *@
        <div class="border-b">
            <RadioGroupCn @bind-Value="_selectedAddress">
                @foreach (var addr in _addresses)
                {
                    var addrId = addr.Id;
                    var isActive = _selectedAddress == addrId;
                    var isLast = _addresses.IndexOf(addr) == _addresses.Count - 1;
                    <label for="@($"ab-{addrId}")" class="@Cn.Merge("flex cursor-pointer items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", isActive ? "bg-muted/50" : "")">
                        <RadioGroupItemCn Id="@($"ab-{addrId}")" Value="@addrId" aria-label="@($"Select {addr.Label} address")" Class="mt-0.5" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@addr.Label</span>
                                @if (addr.IsDefault)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        Default
                                    </BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@addr.Name</p>
                            <p class="text-muted-foreground text-xs">
                                @addr.Street, @addr.City, @addr.State @addr.Zip
                            </p>
                        </div>
                        <div class="flex shrink-0 gap-1">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="@($"Edit {addr.Label} address")">
                                <LucideIconCn Name="pencil" Size="14" Class="size-3.5 text-muted-foreground" />
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0" aria-label="@($"Delete {addr.Label} address")" @onclick="@(() => HandleDelete(addrId))">
                                <LucideIconCn Name="trash" Size="14" Class="size-3.5 text-muted-foreground" />
                            </ButtonCn>
                        </div>
                    </label>
                }
            </RadioGroupCn>
        </div>

        @* Add new address *@
        @if (!_showNewForm)
        {
            <div class="border-b px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" @onclick="@(() => _showNewForm = true)">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Add new address
                </ButtonCn>
            </div>
        }
        else
        {
            <div class="border-b px-4 py-4">
                <div class="flex items-center justify-between mb-3">
                    <span class="font-medium text-sm">New Address</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => _showNewForm = false)">
                        Cancel
                    </ButtonCn>
                </div>
                <div class="space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="ab-label" Class="text-xs">
                                Label
                            </LabelCn>
                            <InputCn id="ab-label" Placeholder="Home, Office..." @bind-Value="_newLabel" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="ab-name" Class="text-xs">
                                Full name
                            </LabelCn>
                            <InputCn id="ab-name" Placeholder="Jane Smith" @bind-Value="_newName" />
                        </div>
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="ab-street" Class="text-xs">
                            Street address
                        </LabelCn>
                        <InputCn id="ab-street" Placeholder="123 Main St, Apt 4B" @bind-Value="_newStreet" />
                    </div>
                    <div class="grid grid-cols-3 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="ab-city" Class="text-xs">
                                City
                            </LabelCn>
                            <InputCn id="ab-city" Placeholder="Portland" @bind-Value="_newCity" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="ab-state" Class="text-xs">
                                State
                            </LabelCn>
                            <InputCn id="ab-state" Placeholder="OR" @bind-Value="_newState" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="ab-zip" Class="text-xs">
                                ZIP code
                            </LabelCn>
                            <InputCn id="ab-zip" Placeholder="97201" @bind-Value="_newZip" />
                        </div>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="w-full" @onclick="HandleAddAddress">
                        Save Address
                    </ButtonCn>
                </div>
            </div>
        }

        @* Continue button *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                Continue to Payment
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record AddressItem(string Id, string Label, string Name, string Street, string City, string State, string Zip, string Country, bool IsDefault);

    private List<AddressItem> _addresses =
    [
        new("addr-1", "Home", "Jane Smith", "742 Evergreen Terrace", "Portland", "OR", "97201", "United States", true),
        new("addr-2", "Office", "Jane Smith", "100 Market St, Suite 400", "San Francisco", "CA", "94105", "United States", false),
        new("addr-3", "Partner", "Alex Rivera", "55 West 3rd Ave", "Denver", "CO", "80204", "United States", false),
    ];

    private string _selectedAddress = "addr-1";
    private bool _showNewForm;
    private string _newLabel = "";
    private string _newName = "";
    private string _newStreet = "";
    private string _newCity = "";
    private string _newState = "";
    private string _newZip = "";

    private void HandleDelete(string id)
    {
        var remaining = _addresses.Where(a => a.Id != id).ToList();
        if (_selectedAddress == id && remaining.Count > 0)
        {
            _selectedAddress = remaining[0].Id;
        }
        _addresses = remaining;
    }

    private void HandleAddAddress()
    {
        var newId = $"addr-{_addresses.Count + 1}";
        var newAddress = new AddressItem(
            newId,
            string.IsNullOrEmpty(_newLabel) ? "New Address" : _newLabel,
            _newName,
            _newStreet,
            _newCity,
            _newState,
            _newZip,
            "United States",
            false
        );
        _addresses = [.._addresses, newAddress];
        _selectedAddress = newId;
        _showNewForm = false;
        _newLabel = "";
        _newName = "";
        _newStreet = "";
        _newCity = "";
        _newState = "";
        _newZip = "";
    }
}
