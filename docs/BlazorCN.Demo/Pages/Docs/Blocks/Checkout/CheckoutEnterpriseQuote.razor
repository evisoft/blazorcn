@* ============================================================
   Block: checkout-enterprise-quote
   Title: CheckoutEnterpriseQuote
   Description: An enterprise quote acceptance checkout for React and Next.js with quote ID, validity date, itemized line items, custom pricing, accept quote button, and contact sales link using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-enterprise-quote.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Enterprise Quote</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">
                    @_quoteId
                </BadgeCn>
            </div>
        </div>

        @* Quote metadata *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-2 gap-3">
                <div class="flex items-start gap-2">
                    <LucideIconCn Name="building" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                    <div>
                        <span class="font-medium text-muted-foreground text-xs">Prepared for</span>
                        <p class="text-sm">@_companyName</p>
                        <p class="text-muted-foreground text-xs">@_preparedFor</p>
                    </div>
                </div>
                <div class="flex items-start gap-2">
                    <LucideIconCn Name="calendar" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                    <div>
                        <span class="font-medium text-muted-foreground text-xs">Valid until</span>
                        <p class="text-sm">@_validUntil</p>
                        <p class="text-muted-foreground text-xs">@_billingTerm billing</p>
                    </div>
                </div>
            </div>
        </div>

        @* Line items *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Line items</span>
            </div>
            @foreach (var item in _lineItems)
            {
                var isLast = item.Id == _lineItems[_lineItems.Length - 1].Id;
                var lineTotal = item.Quantity * item.UnitPrice;
                <div class="@Cn.Merge("flex items-start justify-between px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@item.Description</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@item.Detail</p>
                        @if (item.Quantity > 1)
                        {
                            <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">
                                @item.Quantity &times; $@item.UnitPrice.ToString("N0")
                            </p>
                        }
                    </div>
                    <span class="shrink-0 pl-4 font-medium text-sm tabular-nums">
                        $@lineTotal.ToString("N0")
                    </span>
                </div>
            }
        </div>

        @* Totals *@
        <div class="border-b px-4 py-3 space-y-1.5">
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Subtotal</span>
                <span class="tabular-nums">$@_subtotal.ToString("N0")</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Enterprise discount</span>
                <span class="tabular-nums text-emerald-600 dark:text-emerald-400">
                    -$@_discount.ToString("N0")
                </span>
            </div>
            <div class="flex justify-between border-t pt-1.5 text-sm font-medium">
                <span>Annual total</span>
                <span class="tabular-nums">$@_total.ToString("N0")</span>
            </div>
            <p class="text-muted-foreground text-xs">
                Billed annually. Prepared by @_preparedBy.
            </p>
        </div>

        @* Accept *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">Accept Quote &amp; Pay</ButtonCn>
            <div class="mt-2 flex items-center justify-center gap-1 text-muted-foreground text-xs">
                <LucideIconCn Name="mail" Size="12" Class="size-3" />
                <span>
                    Need changes? <span class="underline">Contact sales</span> to modify this quote
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private const string _quoteId = "QT-2026-0847";
    private const string _companyName = "Acme Corporation";
    private const string _validUntil = "April 15, 2026";
    private const string _preparedBy = "Sarah Chen, Account Executive";
    private const string _preparedFor = "James Wilson, VP Engineering";
    private const string _billingTerm = "Annual";

    private record QuoteLineItem(string Id, string Description, string Detail, int Quantity, int UnitPrice);

    private static readonly QuoteLineItem[] _lineItems =
    [
        new("li1", "Enterprise Platform License", "Unlimited users, SSO, audit logs, 99.99% SLA", 1, 24000),
        new("li2", "Premium Support Package", "Dedicated CSM, 1-hour response SLA, Slack channel", 1, 6000),
        new("li3", "Data Migration Service", "Full historical data import and validation", 1, 4500),
        new("li4", "Custom Integration Setup", "Salesforce, Jira, and Slack integrations", 3, 1500),
    ];

    private static readonly int _subtotal = _lineItems.Sum(i => i.Quantity * i.UnitPrice);
    private const int _discount = 3900;
    private static readonly int _total = _subtotal - _discount;
}
