@* ============================================================
   Block: checkout-progress-indicator
   Title: CheckoutProgressIndicator
   Description: A checkout flow with a prominent horizontal step progress bar for React and Next.js showing Cart, Shipping, Payment, Review, and Confirm steps with checkmarks, step numbers, and current step highlighting using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-progress-indicator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Progress bar *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                @foreach (var stp in _steps)
                {
                    var idx = Array.IndexOf(_steps, stp);
                    <div class="flex items-center">
                        <div class="flex flex-col items-center gap-1">
                            <span class="@Cn.Merge("flex size-7 items-center justify-center rounded-full text-xs font-medium transition-colors", _currentStep > stp.Id ? "bg-foreground text-background" : _currentStep == stp.Id ? "ring-2 ring-foreground ring-offset-2 ring-offset-card bg-foreground text-background" : "bg-muted text-muted-foreground")">
                                @if (_currentStep > stp.Id)
                                {
                                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    @stp.Id
                                }
                            </span>
                            <span class="@Cn.Merge("hidden text-xs sm:block", _currentStep >= stp.Id ? "font-medium text-foreground" : "text-muted-foreground")">
                                @stp.Label
                            </span>
                        </div>
                        @if (idx < _steps.Length - 1)
                        {
                            <div class="@Cn.Merge("mx-1.5 h-px w-6 sm:mx-3 sm:w-10", _currentStep > stp.Id ? "bg-foreground" : "bg-muted")"></div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Step 1: Cart *@
        @if (_currentStep == 1)
        {
            <div>
                @foreach (var itm in _cartItems)
                {
                    var cartIdx = Array.IndexOf(_cartItems, itm);
                    <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", cartIdx < _cartItems.Length - 1 ? "border-b" : "")">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@itm.Name</span>
                            <p class="text-muted-foreground text-xs">
                                @itm.Variant &middot; Qty @itm.Qty
                            </p>
                        </div>
                        <span class="ml-4 shrink-0 text-sm tabular-nums">$@((itm.Price * itm.Qty).ToString("F2"))</span>
                    </div>
                }
                <div class="border-t px-4 py-3">
                    <div class="flex justify-between font-medium text-sm">
                        <span>Subtotal</span>
                        <span class="tabular-nums">$@_subtotal.ToString("F2")</span>
                    </div>
                </div>
            </div>
        }

        @* Step 2: Shipping *@
        @if (_currentStep == 2)
        {
            <div class="px-4 py-4">
                <div class="mb-3 flex items-center gap-2">
                    <LucideIconCn Name="truck" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Shipping Address</span>
                </div>
                <div class="space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="pi-first" Class="text-xs">First name</LabelCn>
                            <InputCn Id="pi-first" Placeholder="Jane" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="pi-last" Class="text-xs">Last name</LabelCn>
                            <InputCn Id="pi-last" Placeholder="Smith" />
                        </div>
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="pi-address" Class="text-xs">Street address</LabelCn>
                        <InputCn Id="pi-address" Placeholder="742 Evergreen Terrace" />
                    </div>
                    <div class="grid grid-cols-3 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="pi-city" Class="text-xs">City</LabelCn>
                            <InputCn Id="pi-city" Placeholder="Portland" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="pi-state" Class="text-xs">State</LabelCn>
                            <InputCn Id="pi-state" Placeholder="OR" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="pi-zip" Class="text-xs">Zip code</LabelCn>
                            <InputCn Id="pi-zip" Placeholder="97201" />
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Step 3: Payment *@
        @if (_currentStep == 3)
        {
            <div class="px-4 py-4">
                <div class="mb-3 flex items-center gap-2">
                    <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Payment Details</span>
                </div>
                <div class="space-y-3">
                    <div class="space-y-1.5">
                        <LabelCn For="pi-card-name" Class="text-xs">Name on card</LabelCn>
                        <InputCn Id="pi-card-name" Placeholder="Jane Smith" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="pi-card" Class="text-xs">Card number</LabelCn>
                        <InputCn Id="pi-card" Placeholder="4242 4242 4242 4242" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="pi-expiry" Class="text-xs">Expiry</LabelCn>
                            <InputCn Id="pi-expiry" Placeholder="MM / YY" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="pi-cvv" Class="text-xs">CVV</LabelCn>
                            <InputCn Id="pi-cvv" Placeholder="123" />
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Step 4: Review *@
        @if (_currentStep == 4)
        {
            <div class="px-4 py-4">
                <span class="mb-3 block font-medium text-sm">Order Review</span>
                <div class="mb-3 rounded-md bg-muted/50 p-3">
                    <span class="font-medium text-muted-foreground text-xs">Shipping to</span>
                    <p class="mt-1 text-sm">Jane Smith</p>
                    <p class="text-muted-foreground text-xs">
                        742 Evergreen Terrace, Portland, OR 97201
                    </p>
                </div>
                <div class="mb-3 rounded-md bg-muted/50 p-3">
                    <span class="font-medium text-muted-foreground text-xs">Payment</span>
                    <p class="mt-1 text-sm">Card ending in 4242</p>
                </div>
                @foreach (var itm in _cartItems)
                {
                    var reviewIdx = Array.IndexOf(_cartItems, itm);
                    <div class="@Cn.Merge("flex items-center justify-between py-2", reviewIdx < _cartItems.Length - 1 ? "border-b" : "")">
                        <div>
                            <span class="text-sm">@itm.Name</span>
                            <p class="text-muted-foreground text-xs">
                                @itm.Variant &middot; Qty @itm.Qty
                            </p>
                        </div>
                        <span class="text-sm tabular-nums">$@((itm.Price * itm.Qty).ToString("F2"))</span>
                    </div>
                }
                <div class="mt-3 space-y-1 border-t pt-3">
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Subtotal</span>
                        <span class="tabular-nums">$@_subtotal.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Shipping</span>
                        <span class="tabular-nums">$@_shipping.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Tax</span>
                        <span class="tabular-nums">$@_tax.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between border-t pt-1.5 font-medium text-sm">
                        <span>Total</span>
                        <span class="tabular-nums">$@_total.ToString("F2")</span>
                    </div>
                </div>
            </div>
        }

        @* Step 5: Confirm *@
        @if (_currentStep == 5)
        {
            <div class="px-4 py-8 text-center">
                <div class="mx-auto mb-3 flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="check" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
                </div>
                <span class="block font-medium text-sm">Order Confirmed</span>
                <p class="mt-1 text-muted-foreground text-xs">
                    Order #ORD-2847 has been placed. You will receive a confirmation email shortly.
                </p>
                <div class="mt-4 rounded-md bg-muted/50 p-3">
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Total charged</span>
                        <span class="font-medium tabular-nums">$@_total.ToString("F2")</span>
                    </div>
                    <div class="mt-1 flex justify-between text-xs">
                        <span class="text-muted-foreground">Estimated delivery</span>
                        <span class="text-muted-foreground">Mar 28 -- Apr 1</span>
                    </div>
                </div>
            </div>
        }

        @* Navigation *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                      @onclick="GoBack" Disabled="@(_currentStep == 1 || _currentStep == 5)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                Back
            </ButtonCn>

            <span class="text-muted-foreground text-xs">
                Step @_currentStep of @_steps.Length
            </span>

            @if (_currentStep < 4)
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs" @onclick="GoForward">
                    Continue
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                </ButtonCn>
            }
            else if (_currentStep == 4)
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" @onclick="PlaceOrder">
                    Place Order
                </ButtonCn>
            }
            else
            {
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs" @onclick="NewOrder">
                    New Order
                </ButtonCn>
            }
        </div>

    </div>
</section>

@code {
    private int _currentStep = 2;

    private record StepInfo(int Id, string Label, string Icon);

    private static readonly StepInfo[] _steps =
    [
        new(1, "Cart", "shopping-cart"),
        new(2, "Shipping", "truck"),
        new(3, "Payment", "credit-card"),
        new(4, "Review", "clipboard-list"),
        new(5, "Confirm", "package-check"),
    ];

    private record CartItem(string Name, string Variant, int Qty, double Price);

    private static readonly CartItem[] _cartItems =
    [
        new("Wireless Noise-Canceling Headphones", "Matte Black", 1, 249.0),
        new("Braided USB-C Cable 2m", "Space Gray", 2, 18.0),
        new("Laptop Stand — Adjustable", "Silver", 1, 79.0),
    ];

    private double _subtotal => _cartItems.Sum(i => i.Price * i.Qty);
    private double _shipping = 9.99;
    private double _tax = 27.64;
    private double _total => _subtotal + _shipping + _tax;

    private void GoBack()
    {
        if (_currentStep > 1 && _currentStep != 5)
            _currentStep = Math.Max(1, _currentStep - 1);
    }

    private void GoForward()
    {
        _currentStep = Math.Min(5, _currentStep + 1);
    }

    private void PlaceOrder()
    {
        _currentStep = 5;
    }

    private void NewOrder()
    {
        _currentStep = 1;
    }
}
