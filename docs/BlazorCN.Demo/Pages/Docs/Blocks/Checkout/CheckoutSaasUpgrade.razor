@* ============================================================
   Block: checkout-saas-upgrade
   Title: CheckoutSaasUpgrade
   Description: A SaaS plan upgrade checkout for React and Next.js with current vs new plan comparison, prorated billing, feature diff, and payment method on file using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-saas-upgrade.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Upgrade Plan</span>
        </div>

        @* Plan comparison *@
        <div class="flex items-center gap-3 border-b px-4 py-4">
            <div class="flex-1 rounded-md border px-3 py-2.5">
                <span class="text-muted-foreground text-xs">Current plan</span>
                <div class="mt-1 flex items-baseline gap-1">
                    <span class="font-medium text-sm">@_currentPlan.Name</span>
                    <span class="text-muted-foreground text-xs">$@(_currentPlan.Price)/mo</span>
                </div>
            </div>
            <LucideIconCn Name="arrow-right" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <div class="flex-1 rounded-md border border-foreground/20 bg-muted/30 px-3 py-2.5">
                <span class="text-muted-foreground text-xs">New plan</span>
                <div class="mt-1 flex items-baseline gap-1">
                    <span class="font-medium text-sm">@_newPlan.Name</span>
                    <span class="text-muted-foreground text-xs">$@(_newPlan.Price)/mo</span>
                </div>
            </div>
        </div>

        @* Prorated billing *@
        <div class="border-b px-4 py-3 space-y-1.5">
            <span class="font-medium text-sm">Billing adjustment</span>
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">
                    Prorated charge (@_daysRemaining days remaining)
                </span>
                <span class="tabular-nums">$@_proratedAmount.ToString("F2")</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">
                    New monthly rate starting @_nextBillingDate
                </span>
                <span class="tabular-nums">$@_newPlan.Price.ToString("F2")</span>
            </div>
            <div class="flex justify-between border-t pt-1.5 text-sm font-medium">
                <span>Due today</span>
                <span class="tabular-nums">$@_proratedAmount.ToString("F2")</span>
            </div>
        </div>

        @* Feature diff *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">What changes</span>
            <div class="mt-2 space-y-0">
                @foreach (var feature in _features)
                {
                    <div class="flex items-center justify-between py-1.5">
                        <div class="flex items-center gap-2">
                            <span class="text-sm">@feature.Label</span>
                            @if (feature.IsNew)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    New
                                </BadgeCn>
                            }
                        </div>
                        <div class="flex items-center gap-2 text-sm tabular-nums">
                            <span class="text-muted-foreground">@feature.Current</span>
                            <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="font-medium">@feature.Upgraded</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Payment method on file *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Payment method</span>
            <div class="mt-2 flex items-center gap-3 rounded-md bg-muted/50 px-3 py-2.5">
                <LucideIconCn Name="credit-card" Size="16" Class="size-4 text-muted-foreground" />
                <div class="flex-1">
                    <span class="text-sm">Visa ending in 4242</span>
                    <p class="text-muted-foreground text-xs">Expires 08/27</p>
                </div>
                <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-500" />
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">Confirm Upgrade</ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                You will be charged $@_proratedAmount.ToString("F2") today and $@_newPlan.Price.ToString("F2")/mo starting @_nextBillingDate
            </p>
        </div>
    </div>
</section>

@code {
    private record Plan(string Name, int Price);

    private record PlanFeature(string Label, string Current, string Upgraded, bool IsNew);

    private static readonly Plan _currentPlan = new("Starter", 29);
    private static readonly Plan _newPlan = new("Business", 99);

    private const decimal _proratedAmount = 48.33m;
    private const string _nextBillingDate = "Apr 15, 2026";
    private const int _daysRemaining = 21;

    private static readonly PlanFeature[] _features =
    [
        new("Team members",               "5",       "25",       false),
        new("Storage",                    "10 GB",   "100 GB",   false),
        new("API requests",               "10k/mo",  "100k/mo",  false),
        new("Custom domains",             "1",       "10",       false),
        new("Priority support",           "No",      "Yes",      true),
        new("SSO / SAML",                 "No",      "Yes",      true),
        new("Audit logs",                 "No",      "Yes",      true),
        new("Dedicated account manager",  "No",      "Yes",      true),
    ];
}
