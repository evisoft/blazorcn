@* ============================================================
   Block: checkout-guest-account
   Title: CheckoutGuestAccount
   Description: A checkout block for React and Next.js with guest vs sign-in toggle, express checkout buttons for Google Pay and Apple Pay, email and shipping form, and payment section using shadcn/ui Input, Label, Button, Separator, and Tailwind CSS
   Source: original/blocks/checkout/checkout-guest-account.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shopping-cart" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Checkout</span>
        </div>

        @* Express checkout *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Express Checkout</span>
            <div class="mt-2.5 grid grid-cols-2 gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-9 gap-2 text-xs font-medium">
                    <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M17.05 11.97c-.03-2.6 2.13-3.85 2.23-3.91-1.21-1.77-3.1-2.01-3.77-2.04-1.61-.16-3.13.94-3.95.94-.82 0-2.08-.92-3.42-.89-1.76.03-3.38 1.02-4.29 2.59-1.83 3.17-.47 7.86 1.31 10.43.87 1.26 1.91 2.67 3.27 2.62 1.31-.05 1.81-.85 3.4-.85 1.59 0 2.04.85 3.43.82 1.41-.02 2.31-1.28 3.17-2.55.99-1.46 1.4-2.87 1.43-2.95-.03-.01-2.74-1.05-2.77-4.17z" />
                        <path d="M14.46 3.66c.72-.87 1.21-2.08 1.08-3.29-1.04.04-2.3.69-3.05 1.57-.67.77-1.25 2.01-1.1 3.19 1.16.09 2.35-.59 3.07-1.47z" />
                    </svg>
                    Apple Pay
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-9 gap-2 text-xs font-medium">
                    <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" />
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
                    </svg>
                    Google Pay
                </ButtonCn>
            </div>
        </div>

        @* Divider *@
        <div class="flex items-center gap-3 px-4 py-2.5">
            <SeparatorCn Class="flex-1" />
            <span class="text-muted-foreground text-xs">or</span>
            <SeparatorCn Class="flex-1" />
        </div>

        @* Mode toggle *@
        <div class="border-b px-4 py-3">
            <div class="flex rounded-md bg-muted/50 p-0.5">
                <button
                    type="button"
                    @onclick="@(() => _mode = "guest")"
                    class="@Cn.Merge("flex flex-1 items-center justify-center gap-1.5 rounded-sm px-3 py-1.5 text-xs font-medium transition-colors", _mode == "guest" ? "bg-background shadow-sm" : "text-muted-foreground hover:text-foreground")">
                    <LucideIconCn Name="mail" Size="14" Class="size-3.5" />
                    Continue as Guest
                </button>
                <button
                    type="button"
                    @onclick="@(() => _mode = "signin")"
                    class="@Cn.Merge("flex flex-1 items-center justify-center gap-1.5 rounded-sm px-3 py-1.5 text-xs font-medium transition-colors", _mode == "signin" ? "bg-background shadow-sm" : "text-muted-foreground hover:text-foreground")">
                    <LucideIconCn Name="user" Size="14" Class="size-3.5" />
                    Sign In
                </button>
            </div>
        </div>

        @* Sign-in form *@
        @if (_mode == "signin")
        {
            <div class="border-b px-4 py-4 space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="ga-signin-email" Class="text-xs">Email</LabelCn>
                    <InputCn Id="ga-signin-email" Type="email" Placeholder="@("jane@example.com")" @bind-Value="_email" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="ga-signin-pw" Class="text-xs">Password</LabelCn>
                    <InputCn Id="ga-signin-pw" Type="password" Placeholder="Enter your password" @bind-Value="_password" />
                </div>
                <div class="flex items-center justify-between">
                    <span class="cursor-pointer text-xs text-muted-foreground underline underline-offset-2">
                        Forgot password?
                    </span>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">Sign In &amp; Continue</ButtonCn>
                </div>
            </div>
        }

        @* Guest form *@
        @if (_mode == "guest")
        {
            @* Contact *@
            <div class="border-b px-4 py-4 space-y-3">
                <div class="flex items-center gap-2 mb-1">
                    <LucideIconCn Name="mail" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Contact</span>
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="ga-email" Class="text-xs">Email</LabelCn>
                    <InputCn Id="ga-email" Type="email" Placeholder="@("jane@example.com")" @bind-Value="_email" />
                    <p class="text-muted-foreground text-xs">
                        Order confirmation will be sent here
                    </p>
                </div>
            </div>

            @* Shipping *@
            <div class="border-b px-4 py-4 space-y-3">
                <span class="font-medium text-sm">Shipping Address</span>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="ga-first" Class="text-xs">First name</LabelCn>
                        <InputCn Id="ga-first" Placeholder="Jane" @bind-Value="_firstName" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="ga-last" Class="text-xs">Last name</LabelCn>
                        <InputCn Id="ga-last" Placeholder="Smith" @bind-Value="_lastName" />
                    </div>
                </div>

                <div class="space-y-1.5">
                    <LabelCn For="ga-address" Class="text-xs">Street address</LabelCn>
                    <InputCn Id="ga-address" Placeholder="1600 Amphitheatre Parkway" @bind-Value="_address" />
                </div>

                <div class="grid grid-cols-3 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="ga-city" Class="text-xs">City</LabelCn>
                        <InputCn Id="ga-city" Placeholder="Mountain View" @bind-Value="_city" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="ga-state" Class="text-xs">State</LabelCn>
                        <InputCn Id="ga-state" Placeholder="CA" @bind-Value="_stateValue" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="ga-zip" Class="text-xs">Zip</LabelCn>
                        <InputCn Id="ga-zip" Placeholder="94043" @bind-Value="_zip" />
                    </div>
                </div>
            </div>

            @* Payment *@
            <div class="border-b px-4 py-4 space-y-3">
                <div class="flex items-center gap-2 mb-1">
                    <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Payment</span>
                </div>

                <div class="space-y-1.5">
                    <LabelCn For="ga-card" Class="text-xs">Card number</LabelCn>
                    <InputCn Id="ga-card" Placeholder="4242 4242 4242 4242" @bind-Value="_cardNumber" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="ga-expiry" Class="text-xs">Expiry</LabelCn>
                        <InputCn Id="ga-expiry" Placeholder="MM / YY" @bind-Value="_expiry" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="ga-cvv" Class="text-xs">CVV</LabelCn>
                        <InputCn Id="ga-cvv" Placeholder="123" @bind-Value="_cvv" />
                    </div>
                </div>
            </div>
        }

        @* Submit *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">@(_mode == "signin" ? "Sign In & Checkout" : "Place Order")</ButtonCn>
            @if (_mode == "guest")
            {
                <p class="mt-2 text-center text-muted-foreground text-xs">
                    You can create an account after placing your order
                </p>
            }
        </div>
    </div>
</section>

@code {
    private string _mode = "guest";
    private string _email = "";
    private string _password = "";
    private string _firstName = "";
    private string _lastName = "";
    private string _address = "";
    private string _city = "";
    private string _stateValue = "";
    private string _zip = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";
}
