@* ============================================================
   Block: checkout-age-verification
   Title: CheckoutAgeVerification
   Description: An age verification gate checkout block for React and Next.js with date of birth input, one-click confirmation, age requirement notice, and product restriction badge using shadcn/ui Input, Label, Button, Badge, and Tailwind CSS
   Source: original/blocks/checkout/checkout-age-verification.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Age Verification Required</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">
                @_product.MinAge+ Only
            </BadgeCn>
        </div>

        @* Product info *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">@_product.Name</span>
                <div class="mt-0.5 flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">@_product.Category</span>
                    <span class="text-muted-foreground text-xs">·</span>
                    <span class="flex items-center gap-1 text-amber-600 text-xs dark:text-amber-400">
                        <LucideIconCn Name="triangle-alert" Size="12" Class="size-3" />
                        Restricted product
                    </span>
                </div>
            </div>
            <span class="font-semibold text-lg tabular-nums">$@(_product.Price.ToString("F2"))</span>
        </div>

        @if (_status == "pending")
        {
            @* Age requirement notice *@
            <div class="border-b px-4 py-3">
                <div class="rounded-md bg-muted/50 p-3">
                    <p class="text-sm leading-relaxed">
                        This product requires age verification. You must be at least
                        <span class="font-medium">@_product.MinAge years old</span> to purchase.
                        Please verify your age below.
                    </p>
                </div>
            </div>

            @* Date of birth input *@
            <div class="border-b px-4 py-4">
                <span class="mb-3 block font-medium text-sm">Enter your date of birth</span>
                <div class="grid grid-cols-3 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="av-month" Class="text-xs">Month</LabelCn>
                        <InputCn id="av-month" Placeholder="MM" maxlength="2" @bind-Value="_month" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="av-day" Class="text-xs">Day</LabelCn>
                        <InputCn id="av-day" Placeholder="DD" maxlength="2" @bind-Value="_day" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="av-year" Class="text-xs">Year</LabelCn>
                        <InputCn id="av-year" Placeholder="YYYY" maxlength="4" @bind-Value="_year" />
                    </div>
                </div>
                <ButtonCn @onclick="VerifyAge" Class="mt-3 w-full" Size="ButtonSize.Sm">Verify Age</ButtonCn>
            </div>

            @* Quick confirmation *@
            <div class="px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Or confirm quickly</span>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="ConfirmAge">
                        I am @_product.MinAge+
                    </ButtonCn>
                </div>
            </div>
        }

        @if (_status == "verified")
        {
            @* Verified state *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                    <span class="font-medium text-emerald-600 text-sm dark:text-emerald-400">Age verified</span>
                </div>
                <p class="mt-1 text-muted-foreground text-xs">
                    You confirmed you are @_product.MinAge or older. You may proceed to payment.
                </p>
            </div>

            @* Simplified payment *@
            <div class="border-b px-4 py-4">
                <span class="mb-3 block font-medium text-sm">Payment</span>
                <div class="space-y-3">
                    <div class="space-y-1.5">
                        <LabelCn For="av-email" Class="text-xs">Email</LabelCn>
                        <InputCn id="av-email" Type="email" Placeholder="@("you@example.com")" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="av-card" Class="text-xs">Card number</LabelCn>
                        <InputCn id="av-card" Placeholder="4242 4242 4242 4242" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="av-expiry" Class="text-xs">Expiry</LabelCn>
                            <InputCn id="av-expiry" Placeholder="MM / YY" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="av-cvv" Class="text-xs">CVV</LabelCn>
                            <InputCn id="av-cvv" Placeholder="123" />
                        </div>
                    </div>
                </div>
            </div>

            @* Pay button *@
            <div class="px-4 py-3">
                <ButtonCn Class="w-full">Pay $@(_product.Price.ToString("F2"))</ButtonCn>
                <p class="mt-2 flex items-center justify-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="lock" Size="12" Class="size-3" />
                    Encrypted and secure
                </p>
            </div>
        }

        @if (_status == "blocked")
        {
            <div class="px-4 py-4">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-600 dark:text-red-400" />
                    <span class="font-medium text-red-600 text-sm dark:text-red-400">Unable to proceed</span>
                </div>
                <p class="mt-2 text-muted-foreground text-sm leading-relaxed">
                    Based on the date of birth provided, you do not meet the minimum age requirement of
                    @_product.MinAge years to purchase this product. This restriction is required by law.
                </p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-7 text-xs" @onclick="@(() => _status = "pending")">
                    Try again
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private record RestrictedProduct(string Id, string Name, string Category, double Price, int MinAge);

    private static readonly RestrictedProduct _product = new("1", "Reserve Cabernet Sauvignon 2019", "Alcohol", 64.0, 21);

    private string _month = "";
    private string _day = "";
    private string _year = "";
    private string _status = "pending";

    private void VerifyAge()
    {
        if (!int.TryParse(_month, out var m) || !int.TryParse(_day, out var d) || !int.TryParse(_year, out var y))
            return;
        if (y < 1900 || y > 2026 || m < 1 || m > 12 || d < 1 || d > 31)
            return;
        var birthDate = new DateTime(y, m, d);
        var cutoff = new DateTime(2026, 3, 24);
        var age = cutoff.Year - birthDate.Year;
        var monthDiff = cutoff.Month - birthDate.Month;
        var dayDiff = cutoff.Day - birthDate.Day;
        var adjustedAge = (monthDiff < 0 || (monthDiff == 0 && dayDiff < 0)) ? age - 1 : age;
        _status = adjustedAge >= _product.MinAge ? "verified" : "blocked";
    }

    private void ConfirmAge()
    {
        _status = "verified";
    }
}
