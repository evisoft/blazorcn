@* ============================================================
   Block: checkout-subscription
   Title: CheckoutSubscription
   Description: Subscription checkout block for React and Next.js with plan details, monthly and yearly billing toggle with savings badge, payment form, and start subscription CTA using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-subscription.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Plan header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Subscribe to Pro</span>
            <p class="mt-0.5 text-muted-foreground text-xs">Get access to all Pro features</p>
        </div>

        @* Plan features *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">What&apos;s included</span>
            <ul class="mt-2 space-y-2">
                @foreach (var feature in _features)
                {
                    <li class="flex items-center gap-2">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5 shrink-0 text-emerald-600 dark:text-emerald-400" />
                        <span class="text-sm">@feature.Text</span>
                    </li>
                }
            </ul>
        </div>

        @* Billing toggle *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Billing cycle
            </span>
            <div class="flex gap-2">
                <button
                    type="button"
                    @onclick="@(() => _billing = "monthly")"
                    class="@Cn.Merge("flex-1 rounded-md border px-3 py-2 text-center text-sm transition-colors", _billing == "monthly" ? "border-foreground/20 bg-muted/50 font-medium" : "border-transparent text-muted-foreground hover:bg-muted/30")">
                    <span class="block font-semibold tabular-nums">$@_pricingMonthly</span>
                    <span class="text-muted-foreground text-xs">per month</span>
                </button>
                <button
                    type="button"
                    @onclick="@(() => _billing = "yearly")"
                    class="@Cn.Merge("relative flex-1 rounded-md border px-3 py-2 text-center text-sm transition-colors", _billing == "yearly" ? "border-foreground/20 bg-muted/50 font-medium" : "border-transparent text-muted-foreground hover:bg-muted/30")">
                    <span class="block font-semibold tabular-nums">$@_pricingYearly</span>
                    <span class="text-muted-foreground text-xs">per year</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="absolute -top-2 right-2 font-normal text-xs text-emerald-600 dark:text-emerald-400">
                        Save $@_savings
                    </BadgeCn>
                </button>
            </div>
        </div>

        @* Payment form *@
        <div class="space-y-3 border-b px-4 py-4">
            <span class="font-medium text-muted-foreground text-xs">Payment details</span>
            <div class="space-y-1.5">
                <LabelCn For="sub-name" Class="text-xs text-muted-foreground">
                    Name on card
                </LabelCn>
                <InputCn Id="sub-name" Placeholder="Full name" Class="h-9" />
            </div>
            <div class="space-y-1.5">
                <LabelCn For="sub-card" Class="text-xs text-muted-foreground">
                    Card number
                </LabelCn>
                <div class="relative">
                    <InputCn
                        Id="sub-card"
                        Placeholder="1234 1234 1234 1234"
                        Class="h-9 pr-10"
                        @bind-Value="_cardNumber" />
                    <LucideIconCn Name="credit-card" Size="16" Class="absolute top-1/2 right-3 size-4 -translate-y-1/2 text-muted-foreground/60" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1.5">
                    <LabelCn For="sub-expiry" Class="text-xs text-muted-foreground">
                        Expiry
                    </LabelCn>
                    <InputCn
                        Id="sub-expiry"
                        Placeholder="MM / YY"
                        Class="h-9"
                        @bind-Value="_expiry" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="sub-cvc" Class="text-xs text-muted-foreground">
                        CVC
                    </LabelCn>
                    <InputCn
                        Id="sub-cvc"
                        Placeholder="123"
                        Class="h-9"
                        @bind-Value="_cvc" />
                </div>
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    Billed @(_billing == "monthly" ? "monthly" : "annually")
                </span>
                <span class="font-semibold text-sm tabular-nums">
                    $@_price/@_period
                </span>
            </div>
            <ButtonCn Class="h-10 w-full text-sm">
                <LucideIconCn Name="lock" Size="14" Class="mr-1.5 size-3.5" />
                Start subscription
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Cancel anytime. No questions asked.
            </p>
        </div>
    </div>
</section>

@code {
    private const int _pricingMonthly = 29;
    private const int _pricingYearly = 290;
    private static readonly int _savings = _pricingMonthly * 12 - _pricingYearly;

    private string _billing = "monthly";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvc = "";

    private int _price => _billing == "monthly" ? _pricingMonthly : _pricingYearly;
    private string _period => _billing == "monthly" ? "mo" : "yr";

    private record PlanFeature(string Text);

    private static readonly PlanFeature[] _features =
    [
        new("Unlimited projects"),
        new("Priority support"),
        new("Advanced analytics"),
        new("Custom integrations"),
        new("Team collaboration"),
    ];
}
