@* ============================================================
   Block: checkout-restaurant-order
   Title: CheckoutRestaurantOrder
   Description: A restaurant and food delivery checkout block for React and Next.js with order items, item customizations, special instructions, tip selector with custom amount, estimated delivery time, and driver instructions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-restaurant-order.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="utensils" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">@_restaurant.Name</span>
            </div>
        </div>

        @* Estimated delivery *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
            <span class="text-muted-foreground text-sm">Estimated delivery</span>
            <span class="font-medium text-sm">@_restaurant.EstimatedDelivery</span>
        </div>

        @* Order items *@
        <div class="border-b">
            <div class="px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Your order</span>
            </div>
            @{
                var itemList = _orderItems.ToList();
            }
            @foreach (var it in itemList)
            {
                var item = it;
                var isLast = itemList.IndexOf(item) == itemList.Count - 1;
                <div class="@Cn.Merge("px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@item.Name</span>
                                @if (item.Quantity > 1)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        x@item.Quantity
                                    </BadgeCn>
                                }
                            </div>
                            @if (item.Customizations.Length > 0)
                            {
                                <p class="mt-0.5 text-muted-foreground text-xs">@string.Join(" · ", item.Customizations)</p>
                            }
                        </div>
                        <span class="shrink-0 text-sm tabular-nums">$@((item.Price * item.Quantity).ToString("F2"))</span>
                    </div>
                </div>
            }
        </div>

        @* Special instructions *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="message-square" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Special instructions</span>
            </div>
            <TextareaCn aria-label="Special instructions" @bind-Value="_specialInstructions" Placeholder="@("Allergies, dietary preferences, or special requests...")" Class="mt-2 min-h-[60px] resize-none text-sm" rows="2" />
        </div>

        @* Tip selector *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Add a tip</span>
            <div class="mt-2 flex items-center gap-2">
                @foreach (var preset in _tipPresets)
                {
                    var p = preset;
                    <ButtonCn Variant="@(_tipSelection == p.Label ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 flex-1 text-xs" @onclick="@(() => _tipSelection = p.Label)">
                        @p.Label
                    </ButtonCn>
                }
                <ButtonCn Variant="@(_tipSelection == "custom" ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 flex-1 text-xs" @onclick="@(() => _tipSelection = "custom")">
                    Custom
                </ButtonCn>
            </div>
            @if (_tipSelection == "custom")
            {
                <div class="mt-2 flex items-center gap-2">
                    <span class="text-muted-foreground text-sm">$</span>
                    <InputCn aria-label="Custom tip amount" @bind-Value="_customTip" Placeholder="0.00" Class="h-8 text-sm" type="number" min="0" step="0.50" />
                </div>
            }
        </div>

        @* Driver instructions *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Driver instructions</span>
            <InputCn aria-label="Driver instructions" @bind-Value="_driverInstructions" Placeholder="@("Gate code, building entrance, ring doorbell...")" Class="mt-2 h-8 text-sm" />
        </div>

        @* Order summary *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Order summary</span>
            <div class="mt-2 space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">Subtotal</span>
                    <span class="text-sm tabular-nums">$@_subtotal.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">Delivery fee</span>
                    <span class="text-sm tabular-nums">$@_deliveryFee.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">Tax</span>
                    <span class="text-sm tabular-nums">$@_taxes.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">Tip</span>
                    <span class="text-sm tabular-nums">$@_roundedTip.ToString("F2")</span>
                </div>
                <SeparatorCn />
                <div class="flex items-center justify-between">
                    <span class="font-medium text-sm">Total</span>
                    <span class="font-semibold text-sm tabular-nums">$@_total.ToString("F2")</span>
                </div>
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">Place order</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record OrderItem(string Id, string Name, double Price, int Quantity, string[] Customizations);
    private record TipPreset(string Label, double Value);
    private record RestaurantInfo(string Name, string EstimatedDelivery);

    private static readonly OrderItem[] _orderItems =
    [
        new("1", "Spicy Chicken Burger", 14.5,  1, ["Extra cheese", "No onions"]),
        new("2", "Truffle Fries",         8.0,  1, ["Large size"]),
        new("3", "Caesar Salad",         11.0,  1, ["Dressing on the side", "Add grilled chicken"]),
        new("4", "Sparkling Water",       3.5,  2, []),
    ];

    private static readonly TipPreset[] _tipPresets =
    [
        new("15%", 0.15),
        new("18%", 0.18),
        new("20%", 0.20),
    ];

    private static readonly RestaurantInfo _restaurant = new("The Copper Kitchen", "30-40 min");

    private const double _deliveryFee = 4.99;
    private const double _taxRate = 0.0875;

    private string _tipSelection = "18%";
    private string _customTip = "";
    private string _specialInstructions = "";
    private string _driverInstructions = "";

    private double _subtotal => _orderItems.Sum(i => i.Price * i.Quantity);
    private double _taxes => Math.Round(_subtotal * _taxRate, 2);

    private double _roundedTip
    {
        get
        {
            if (_tipSelection == "custom")
            {
                double.TryParse(_customTip, out var parsed);
                return Math.Round(parsed, 2);
            }
            var preset = _tipPresets.FirstOrDefault(t => t.Label == _tipSelection);
            return Math.Round(_subtotal * (preset?.Value ?? 0), 2);
        }
    }

    private double _total => Math.Round(_subtotal + _taxes + _deliveryFee + _roundedTip, 2);
}
