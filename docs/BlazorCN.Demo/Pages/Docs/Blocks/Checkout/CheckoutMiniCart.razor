@* ============================================================
   Block: checkout-mini-cart
   Title: CheckoutMiniCart
   Description: A compact mini cart dropdown widget for React and Next.js with recent item thumbnails, item count badge, subtotal, and quick action buttons for cart view and checkout using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-mini-cart.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with count *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shopping-cart" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Cart</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_totalItemsInCart items
            </BadgeCn>
        </div>

        @* Recent items *@
        <div class="border-b">
            @for (int i = 0; i < _cartItems.Length; i++)
            {
                var item = _cartItems[i];
                var isLast = i == _cartItems.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    @* Thumbnail *@
                    <div class="@Cn.Merge("size-10 shrink-0 rounded-md", item.Color)" />

                    @* Item info *@
                    <div class="min-w-0 flex-1">
                        <span class="truncate text-sm">@item.Name</span>
                        <p class="text-muted-foreground text-xs">
                            @item.Variant
                            @if (item.Quantity > 1)
                            {
                                <span> &middot; Qty @item.Quantity</span>
                            }
                        </p>
                    </div>

                    @* Price *@
                    <span class="shrink-0 font-medium text-sm tabular-nums">$@((item.Price * item.Quantity).ToString("0.00"))</span>
                </div>
            }
        </div>

        @* Subtotal *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-muted-foreground text-sm">Subtotal</span>
            <span class="font-medium text-sm tabular-nums">$@_subtotal.ToString("0.00")</span>
        </div>

        @* Action buttons *@
        <div class="flex gap-2 px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">
                View Cart
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 gap-1.5 text-xs">
                Checkout
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record MiniCartItem(string Id, string Name, string Variant, int Price, int Quantity, string Color);

    private static readonly MiniCartItem[] _cartItems =
    [
        new("mc-1", "Wireless Earbuds Pro", "Matte Black", 129, 1, "bg-zinc-300 dark:bg-zinc-600"),
        new("mc-2", "Charging Dock", "Walnut / USB-C", 65, 1, "bg-amber-200 dark:bg-amber-800"),
        new("mc-3", "Silicone Ear Tips", "Pack of 6 / S-M-L", 18, 2, "bg-stone-200 dark:bg-stone-700"),
    ];

    private static readonly int _totalItemsInCart = 5;

    private static readonly decimal _subtotal = _cartItems.Sum(item => item.Price * item.Quantity);
}
