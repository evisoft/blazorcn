@* ============================================================
   Block: checkout-order-history-reorder
   Title: CheckoutOrderHistoryReorder
   Description: An order history reorder block for React and Next.js with past order items, reorder all button, individual add-to-cart, quantity adjustments, and price change warnings using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-order-history-reorder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Reorder</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_orderNumber &middot; @_orderDate
                </p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="repeat" Size="12" Class="size-3" />
                Reorder All
            </ButtonCn>
        </div>

        @* Items *@
        <div>
            @{
                var itemList = _items.ToList();
            }
            @foreach (var it in itemList)
            {
                var item = it;
                var isLast = itemList.IndexOf(item) == itemList.Count - 1;
                var priceChanged = item.OriginalPrice != item.CurrentPrice;
                var priceIncreased = item.CurrentPrice > item.OriginalPrice;
                var isAdded = _addedItems.Contains(item.Id);
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3 px-4 py-3">
                        @* Image placeholder *@
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <span class="font-mono text-muted-foreground text-xs">@item.Image</span>
                        </div>

                        @* Item details *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0">
                                    <span class="font-medium text-sm">@item.Name</span>
                                    <p class="mt-0.5 text-muted-foreground text-xs">@item.Variant</p>
                                </div>
                                <div class="shrink-0 text-right">
                                    <span class="font-mono text-sm tabular-nums">
                                        $@item.CurrentPrice.ToString("F2")
                                    </span>
                                    @if (priceChanged)
                                    {
                                        <p class="mt-0.5 font-mono text-muted-foreground text-xs tabular-nums line-through">
                                            $@item.OriginalPrice.ToString("F2")
                                        </p>
                                    }
                                </div>
                            </div>

                            @* Price change warning *@
                            @if (priceChanged)
                            {
                                <div class="mt-2 flex items-center gap-1.5">
                                    <LucideIconCn Name="triangle-alert" Size="12" Class="size-3 text-amber-500" />
                                    <span class="text-xs text-amber-600 dark:text-amber-400">
                                        Price @(priceIncreased ? "increased" : "decreased") by $@Math.Abs(item.CurrentPrice - item.OriginalPrice).ToString("F2") since last order
                                    </span>
                                </div>
                            }

                            @* Quantity and add to cart *@
                            <div class="mt-2 flex items-center justify-between">
                                <div class="flex items-center gap-1">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-6 p-0" OnClick="@(() => UpdateQuantity(item.Id, -1))">
                                        <LucideIconCn Name="minus" Size="12" Class="size-3" />
                                    </ButtonCn>
                                    <span class="w-8 text-center font-mono text-xs tabular-nums">
                                        @item.Quantity
                                    </span>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-6 p-0" OnClick="@(() => UpdateQuantity(item.Id, 1))">
                                        <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                    </ButtonCn>
                                </div>
                                <ButtonCn Variant="@(isAdded ? ButtonVariant.Secondary : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="@(() => AddToCart(item.Id))" Disabled="@isAdded">
                                    <LucideIconCn Name="shopping-cart" Size="12" Class="size-3" />
                                    @(isAdded ? "Added" : "Add to Cart")
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer totals *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="text-muted-foreground text-xs">Original order total</span>
                    <p class="font-mono text-muted-foreground text-xs tabular-nums line-through">
                        $@_originalTotal.ToString("F2")
                    </p>
                </div>
                <div class="text-right">
                    <span class="text-muted-foreground text-xs">Current total</span>
                    <p class="font-semibold text-lg tabular-nums">$@_currentTotal.ToString("F2")</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const string _orderNumber = "ORD-2026-04821";
    private const string _orderDate = "Feb 14, 2026";

    private record OrderItem(string Id, string Name, string Variant, double OriginalPrice, double CurrentPrice, int Quantity, string Image);

    private static readonly OrderItem[] _initialItems =
    [
        new("1", "Ergonomic Desk Chair",  "Matte Black / Mesh Back",        449.0, 449.0, 1, "DC"),
        new("2", "USB-C Docking Station", "Triple Display / 100W PD",       179.0, 199.0, 2, "DS"),
        new("3", "Mechanical Keyboard",   "Cherry MX Brown / TKL",          159.0, 149.0, 1, "KB"),
        new("4", "Monitor Light Bar",     "Matte Black / Auto Dimming",      89.0,  89.0, 3, "ML"),
    ];

    private List<OrderItem> _items = _initialItems.ToList();
    private HashSet<string> _addedItems = [];

    private double _originalTotal => _initialItems.Sum(i => i.OriginalPrice * i.Quantity);
    private double _currentTotal => _items.Sum(i => i.CurrentPrice * i.Quantity);

    private void UpdateQuantity(string id, int delta)
    {
        _items = _items.Select(i =>
        {
            if (i.Id != id) return i;
            return i with { Quantity = Math.Max(1, i.Quantity + delta) };
        }).ToList();
    }

    private void AddToCart(string id)
    {
        _addedItems = [.._addedItems, id];
    }
}
