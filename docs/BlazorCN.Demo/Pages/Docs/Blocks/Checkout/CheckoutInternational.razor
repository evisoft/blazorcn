@* ============================================================
   Block: checkout-international
   Title: CheckoutInternational
   Description: An international checkout block for React and Next.js with country selector, currency display, international shipping options, customs duty estimate, and adaptive address format using shadcn/ui Select, Input, Label, Button, RadioGroup, and Tailwind CSS
   Source: original/blocks/checkout/checkout-international.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">International Checkout</span>
            <span class="ml-auto font-mono text-muted-foreground text-xs">
                @_selectedCountry.CurrencyCode
            </span>
        </div>

        @* Country selector *@
        <div class="border-b px-4 py-4">
            <div class="space-y-1.5">
                <LabelCn For="intl-country" Class="text-xs">
                    Country / Region
                </LabelCn>
                <SelectCn @bind-Value="_country">
                    <SelectTriggerCn id="intl-country" class="w-full">
                        <SelectValueCn Placeholder="Select country" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var c in _countries)
                        {
                            <SelectItemCn Value="@c.Code">@c.Name (@c.CurrencyCode)</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Address form *@
        <div class="border-b px-4 py-4">
            <span class="font-medium text-sm">Shipping Address</span>
            <div class="mt-3 space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="intl-name" Class="text-xs">
                        Full name
                    </LabelCn>
                    <InputCn id="intl-name" Placeholder="Jane Smith" @bind-Value="_name" />
                </div>

                <div class="space-y-1.5">
                    <LabelCn For="intl-address" Class="text-xs">
                        Street address
                    </LabelCn>
                    <InputCn id="intl-address" Placeholder="123 Main St" @bind-Value="_address" />
                </div>

                <div class="grid grid-cols-3 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="intl-city" Class="text-xs">
                            City
                        </LabelCn>
                        <InputCn id="intl-city" Placeholder="San Francisco" @bind-Value="_city" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="intl-state" Class="text-xs">
                            @_selectedCountry.StateLabel
                        </LabelCn>
                        <InputCn id="intl-state" Placeholder="@_selectedCountry.StateLabel" @bind-Value="_stateValue" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="intl-postal" Class="text-xs">
                            @_selectedCountry.PostalLabel
                        </LabelCn>
                        <InputCn id="intl-postal" Placeholder="@(_country == "US" ? "94102" : "SW1A 1AA")" @bind-Value="_postal" />
                    </div>
                </div>
            </div>
        </div>

        @* International shipping options *@
        <div class="border-b">
            <div class="px-4 py-3">
                <span class="font-medium text-sm">Shipping Method</span>
            </div>
            <RadioGroupCn Value="@_shipping" ValueChanged="@((v) => _shipping = v ?? "standard")">
                @foreach (var option in _intlShippingOptions)
                {
                    var opt = option;
                    var isActive = _shipping == opt.Id;
                    var isLast = opt.Id == _intlShippingOptions[_intlShippingOptions.Length - 1].Id;
                    <span class="@Cn.Merge("flex cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", isActive ? "bg-muted/50" : "")"
                          role="button"
                          tabindex="0"
                          @onclick="@(() => _shipping = opt.Id)">
                        <RadioGroupItemCn Value="@opt.Id" />
                        <LucideIconCn Name="@opt.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@opt.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@opt.Estimate</p>
                        </div>
                        <span class="shrink-0 font-medium text-sm tabular-nums">
                            @_selectedCountry.CurrencySymbol@opt.Price.ToString("F2")
                        </span>
                    </span>
                }
            </RadioGroupCn>
        </div>

        @* Order totals with VAT/duty *@
        <div class="border-b px-4 py-3 space-y-1.5">
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Subtotal</span>
                <span class="tabular-nums">@_selectedCountry.CurrencySymbol@_subtotal.ToString("F2")</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Shipping</span>
                <span class="tabular-nums">@_selectedCountry.CurrencySymbol@_selectedShipping.Price.ToString("F2")</span>
            </div>
            @if (_selectedCountry.VatRate > 0)
            {
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">
                        @_selectedCountry.VatLabel (@_selectedCountry.VatRate%)
                    </span>
                    <span class="tabular-nums">@_selectedCountry.CurrencySymbol@_vatAmount.ToString("F2")</span>
                </div>
            }
            @if (_isInternational)
            {
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Est. customs duty</span>
                    <span class="tabular-nums">@_selectedCountry.CurrencySymbol@_dutyEstimate.ToString("F2")</span>
                </div>
            }
            <div class="flex justify-between border-t pt-1.5 text-sm font-medium">
                <span>Total</span>
                <span class="tabular-nums">@_selectedCountry.CurrencySymbol@_total.ToString("F2")</span>
            </div>
        </div>

        @* Place order *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                Place Order
            </ButtonCn>
            @if (_isInternational)
            {
                <p class="mt-2 text-center text-muted-foreground text-xs">
                    Customs duties are estimated and may vary at delivery
                </p>
            }
        </div>
    </div>
</section>

@code {
    private record Country(
        string Code,
        string Name,
        string CurrencySymbol,
        string CurrencyCode,
        int VatRate,
        string VatLabel,
        string PostalLabel,
        string StateLabel
    );

    private record ShippingOption(
        string Id,
        string Label,
        string Estimate,
        double Price,
        string IconName
    );

    private static readonly Country[] _countries =
    [
        new("US", "United States", "$", "USD", 0, "Sales Tax", "ZIP code", "State"),
        new("GB", "United Kingdom", "£", "GBP", 20, "VAT", "Postcode", "County"),
        new("DE", "Germany", "€", "EUR", 19, "VAT", "Postal code", "State"),
        new("CA", "Canada", "CA$", "CAD", 5, "GST", "Postal code", "Province"),
        new("AU", "Australia", "A$", "AUD", 10, "GST", "Postcode", "State"),
        new("JP", "Japan", "¥", "JPY", 10, "Consumption Tax", "Postal code", "Prefecture"),
    ];

    private static readonly ShippingOption[] _intlShippingOptions =
    [
        new("standard", "International Standard", "10-15 business days", 12.99, "package"),
        new("express", "International Express", "5-7 business days", 29.99, "ship"),
        new("priority", "International Priority", "2-4 business days", 49.99, "plane"),
    ];

    private const double _subtotal = 189.0;
    private const double _dutyRate = 0.06;

    private string _country = "US";
    private string _shipping = "standard";
    private string _name = "";
    private string _address = "";
    private string _city = "";
    private string _stateValue = "";
    private string _postal = "";

    private Country _selectedCountry => _countries[0] is var first
        ? Array.Find(_countries, c => c.Code == _country) ?? first
        : first;

    private ShippingOption _selectedShipping => Array.Find(_intlShippingOptions, s => s.Id == _shipping) ?? _intlShippingOptions[0];

    private bool _isInternational => _country != "US";

    private double _vatAmount => _subtotal * (_selectedCountry.VatRate / 100.0);

    private double _dutyEstimate => _isInternational ? _subtotal * _dutyRate : 0;

    private double _total => _subtotal + _selectedShipping.Price + _vatAmount + _dutyEstimate;
}
