@* ============================================================
   Block: checkout-multi-currency
   Title: CheckoutMultiCurrency
   Description: A multi-currency checkout block for React and Next.js with currency selector dropdown, real-time price conversion, exchange rate notice, USD base charge clarification, and local currency equivalent display using shadcn/ui Select, Input, Label, Button, and Tailwind CSS
   Source: original/blocks/checkout/checkout-multi-currency.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with currency selector *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="arrow-right-left" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Checkout</span>
            <div class="ml-auto">
                <SelectCn Value="@_selectedCurrency" ValueChanged="@((string v) => _selectedCurrency = v)" TValue="string">
                    <SelectTriggerCn Class="h-7 w-[140px] text-xs" aria-label="Select currency">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var c in _currencies)
                        {
                            var cur = c;
                            <SelectItemCn Value="@cur.Code" Class="text-xs">
                                @cur.Symbol @cur.Code — @cur.Name
                            </SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Cart items *@
        <div class="border-b">
            @for (int i = 0; i < _cartItems.Length; i++)
            {
                var item = _cartItems[i];
                var isLast = i == _cartItems.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@item.Name</span>
                        <p class="text-muted-foreground text-xs">Qty @item.Quantity</p>
                    </div>
                    <div class="text-right">
                        <span class="font-medium text-sm tabular-nums">@Convert(item.PriceUsd * item.Quantity)</span>
                        @if (!_isUsd)
                        {
                            <p class="text-muted-foreground text-xs tabular-nums">$@((item.PriceUsd * item.Quantity).ToString("F2")) USD</p>
                        }
                    </div>
                </div>
            }
        </div>

        @* Exchange rate notice *@
        @if (!_isUsd)
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                    <LucideIconCn Name="info" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                    <div>
                        <p class="text-xs leading-relaxed">
                            Prices shown in @_currency.Name (@_currency.Code) at a rate of@(" ")
                            <span class="font-mono font-medium">1 USD = @_currency.Rate @_currency.Code</span>
                            . Your card will be charged in@(" ")
                            <span class="font-medium">USD ($@(_totalUsd.ToString("F2")))</span>. Your bank may
                            apply its own exchange rate.
                        </p>
                    </div>
                </div>
            </div>
        }

        @* Totals *@
        <div class="border-b px-4 py-3 space-y-1.5">
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Subtotal</span>
                <span class="tabular-nums">@Convert(_subtotalUsd)</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Tax</span>
                <span class="tabular-nums">@Convert(_taxUsd)</span>
            </div>
            <div class="flex justify-between text-sm font-medium pt-1.5 border-t">
                <span>Total</span>
                <div class="text-right">
                    <span class="tabular-nums">@Convert(_totalUsd)</span>
                    @if (!_isUsd)
                    {
                        <p class="font-normal text-muted-foreground text-xs tabular-nums">$@(_totalUsd.ToString("F2")) USD</p>
                    }
                </div>
            </div>
        </div>

        @* Payment *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-sm">Payment</span>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="mc-email" Class="text-xs">
                        Email
                    </LabelCn>
                    <InputCn Id="mc-email" Type="email" Placeholder="@("you@example.com")" @bind-Value="_email" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="mc-card" Class="text-xs">
                        Card number
                    </LabelCn>
                    <InputCn Id="mc-card" Placeholder="4242 4242 4242 4242" @bind-Value="_cardNumber" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="mc-expiry" Class="text-xs">
                            Expiry
                        </LabelCn>
                        <InputCn Id="mc-expiry" Placeholder="MM / YY" @bind-Value="_expiry" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="mc-cvv" Class="text-xs">
                            CVV
                        </LabelCn>
                        <InputCn Id="mc-cvv" Placeholder="123" @bind-Value="_cvv" />
                    </div>
                </div>
            </div>
        </div>

        @* Pay button *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">Pay @Convert(_totalUsd)</ButtonCn>
            <p class="mt-2 flex items-center justify-center gap-1 text-muted-foreground text-xs">
                <LucideIconCn Name="lock" Size="12" Class="size-3" />
                @(_isUsd ? "Encrypted and secure" : $"Charged in USD · {Convert(_totalUsd)} equivalent")
            </p>
        </div>
    </div>
</section>

@code {
    private string _selectedCurrency = "USD";

    private string _email = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";

    private record CurrencyInfo(string Code, string Symbol, string Name, double Rate);

    private record CartItem(string Id, string Name, double PriceUsd, int Quantity);

    private static readonly CurrencyInfo[] _currencies =
    [
        new("USD", "$", "US Dollar", 1.0),
        new("EUR", "€", "Euro", 0.92),
        new("GBP", "£", "British Pound", 0.79),
        new("CAD", "CA$", "Canadian Dollar", 1.36),
        new("AUD", "A$", "Australian Dollar", 1.53),
        new("JPY", "¥", "Japanese Yen", 149.5),
        new("BRL", "R$", "Brazilian Real", 4.97),
        new("INR", "₹", "Indian Rupee", 83.12),
    ];

    private static readonly CartItem[] _cartItems =
    [
        new("1", "Pro License — Annual", 229.0, 1),
        new("2", "Priority Support Add-on", 49.0, 1),
    ];

    private static readonly double _subtotalUsd = 278.0;
    private static readonly double _taxUsd = 24.93;
    private static readonly double _totalUsd = _subtotalUsd + _taxUsd;

    private CurrencyInfo _currency => _currencies.FirstOrDefault(c => c.Code == _selectedCurrency) ?? _currencies[0];
    private bool _isUsd => _currency.Code == "USD";
    private bool _isJpy => _currency.Code == "JPY";

    private string Convert(double usd)
    {
        var converted = usd * _currency.Rate;
        if (_isJpy)
            return $"{_currency.Symbol}{((long)System.Math.Round(converted)).ToString("N0")}";
        return $"{_currency.Symbol}{converted.ToString("F2")}";
    }
}
