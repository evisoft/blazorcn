@* ============================================================
   Block: checkout-comparison-upsell
   Title: CheckoutComparisonUpsell
   Description: A React checkout upsell block for Next.js with side-by-side feature comparison between current and premium products, price difference highlight, and upgrade CTA using shadcn/ui Button, Badge, and Tailwind CSS
   Source: original/blocks/checkout/checkout-comparison-upsell.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Consider upgrading</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Compare your selection with the premium version
            </p>
        </div>

        @* Product headers *@
        <div class="grid grid-cols-[1fr_1fr_1fr] border-b">
            <div class="px-4 py-3"></div>
            <div class="@Cn.Merge("border-l px-4 py-3 transition-colors", _selected == "current" ? "bg-muted/50" : "")">
                <span class="font-medium text-sm">@CurrentProduct.Name</span>
                <div class="mt-1 flex items-center gap-2">
                    <span class="font-semibold text-lg tabular-nums">$@CurrentProduct.Price</span>
                    @if (_selected == "current")
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                            Selected
                        </BadgeCn>
                    }
                </div>
            </div>
            <div class="@Cn.Merge("border-l px-4 py-3 transition-colors", _selected == "premium" ? "bg-muted/50" : "")">
                <span class="font-medium text-sm">@PremiumProduct.Name</span>
                <div class="mt-1 flex items-center gap-2">
                    <span class="font-semibold text-lg tabular-nums">$@PremiumProduct.Price</span>
                    @if (_selected == "premium")
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                            Selected
                        </BadgeCn>
                    }
                </div>
            </div>
        </div>

        @* Feature comparison rows *@
        <div>
            @for (var i = 0; i < _features.Length; i++)
            {
                var feature = _features[i];
                var isLast = i == _features.Length - 1;
                <div class="@Cn.Merge("grid grid-cols-[1fr_1fr_1fr]", !isLast ? "border-b" : "")">
                    <div class="flex items-center px-4 py-2.5">
                        <span class="text-muted-foreground text-xs">@feature.Label</span>
                    </div>
                    <div class="@Cn.Merge("flex items-center border-l px-4 py-2.5 transition-colors", _selected == "current" ? "bg-muted/30" : "")">
                        @if (feature.CurrentBool.HasValue)
                        {
                            @if (feature.CurrentBool.Value)
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-foreground" />
                            }
                            else
                            {
                                <LucideIconCn Name="minus" Size="14" Class="size-3.5 text-muted-foreground/40" />
                            }
                        }
                        else
                        {
                            <span class="text-xs">@feature.CurrentText</span>
                        }
                    </div>
                    <div class="@Cn.Merge("flex items-center border-l px-4 py-2.5 transition-colors", _selected == "premium" ? "bg-muted/30" : "")">
                        @if (feature.PremiumBool.HasValue)
                        {
                            @if (feature.PremiumBool.Value)
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-foreground" />
                            }
                            else
                            {
                                <LucideIconCn Name="minus" Size="14" Class="size-3.5 text-muted-foreground/40" />
                            }
                        }
                        else
                        {
                            <span class="text-xs">@feature.PremiumText</span>
                        }
                    </div>
                </div>
            }
        </div>

        @* Upgrade CTA *@
        <div class="border-t px-4 py-3">
            @if (_selected == "current")
            {
                <ButtonCn Class="w-full" @onclick="@(() => _selected = "premium")">
                    Upgrade for $@PriceDifference more
                </ButtonCn>
            }
            else
            {
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1" @onclick="@(() => _selected = "current")">
                        Keep Standard
                    </ButtonCn>
                    <ButtonCn Class="flex-1">Continue with Pro</ButtonCn>
                </div>
            }
            <p class="mt-2 text-center text-muted-foreground text-xs">
                @(_selected == "current"
                    ? $"Get {_features.Count(f => f.CurrentBool == false && f.PremiumBool == true)} additional features with the Pro"
                    : "Premium version selected")
            </p>
        </div>
    </div>
</section>

@code {
    private record Product(string Name, int Price, string Description);

    private record Feature(string Label, bool? CurrentBool, string? CurrentText, bool? PremiumBool, string? PremiumText);

    private static readonly Product CurrentProduct = new("Studio Monitor SE", 299, "Reference-quality studio monitor with 5-inch woofer");
    private static readonly Product PremiumProduct = new("Studio Monitor Pro", 449, "Professional studio monitor with 8-inch woofer and DSP");

    private static readonly Feature[] _features =
    [
        new("Driver size",          null,  "5-inch",          null,  "8-inch"),
        new("Frequency response",   null,  "55 Hz - 30 kHz",  null,  "35 Hz - 40 kHz"),
        new("Power output",         null,  "70W bi-amp",      null,  "150W bi-amp"),
        new("DSP room correction",  false, null,              true,  null),
        new("XLR balanced input",   true,  null,              true,  null),
        new("Bluetooth 5.3",        false, null,              true,  null),
        new("Auto standby",         true,  null,              true,  null),
        new("Warranty",             null,  "2 years",         null,  "5 years"),
    ];

    private static readonly int PriceDifference = PremiumProduct.Price - CurrentProduct.Price;

    private string _selected = "current";
}
