@* ============================================================
   Block: checkout-trust-badges
   Title: CheckoutTrustBadges
   Description: A checkout block for React and Next.js with SSL security badge, money-back guarantee, secure payment icons, customer review count, and a payment form with trust signals integrated alongside input fields built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-trust-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with lock *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="lock" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Secure checkout</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    SSL encrypted
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Your payment information is protected with bank-level encryption
            </p>
        </div>

        @* Trust signals row *@
        <div class="grid grid-cols-2 gap-px border-b bg-border sm:grid-cols-4">
            @foreach (var signal in _trustSignals)
            {
                <div class="bg-card px-3 py-2.5">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="@signal.Icon" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium text-xs">@signal.Label</span>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-[10px]">@signal.Detail</p>
                </div>
            }
        </div>

        @* Payment form *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Card details</span>
            <div class="space-y-3">
                <div>
                    <span class="mb-1 block font-medium text-muted-foreground text-xs">
                        Cardholder name
                    </span>
                    <InputCn aria-label="Cardholder name" Placeholder="Jane Smith" Class="h-8 text-sm" />
                </div>
                <div>
                    <div class="mb-1 flex items-center justify-between">
                        <span class="font-medium text-muted-foreground text-xs">Card number</span>
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="lock" Size="10" Class="size-2.5 text-muted-foreground/60" />
                            <span class="text-muted-foreground text-[10px]">Encrypted</span>
                        </div>
                    </div>
                    <InputCn aria-label="Card number" Placeholder="1234 5678 9012 3456" Class="h-8 text-sm" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">Expiry</span>
                        <InputCn aria-label="Expiry" Placeholder="MM / YY" Class="h-8 text-sm" />
                    </div>
                    <div>
                        <div class="mb-1 flex items-center justify-between">
                            <span class="font-medium text-muted-foreground text-xs">CVC</span>
                            <div class="flex items-center gap-1">
                                <LucideIconCn Name="shield-check" Size="10" Class="size-2.5 text-muted-foreground/60" />
                                <span class="text-muted-foreground text-[10px]">Secure</span>
                            </div>
                        </div>
                        <InputCn aria-label="CVC" Placeholder="123" Class="h-8 text-sm" />
                    </div>
                </div>
            </div>
        </div>

        @* Accepted methods *@
        <div class="border-b px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">Accepted:</span>
                <div class="flex items-center gap-1.5">
                    @foreach (var method in _paymentMethods)
                    {
                        <span class="rounded bg-muted px-1.5 py-0.5 font-medium text-muted-foreground text-[10px]">
                            @method.Name
                        </span>
                    }
                </div>
            </div>
        </div>

        @* Order total *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-sm">Total</span>
                <span class="font-semibold text-lg tabular-nums">$229.00</span>
            </div>
        </div>

        @* Pay button *@
        <div class="border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                <LucideIconCn Name="lock" Size="12" Class="mr-1.5 size-3" />
                Pay securely
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                30-day money-back guarantee. Cancel anytime.
            </p>
        </div>

        @* Footer trust *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-center gap-3 text-muted-foreground text-xs">
                <span class="flex items-center gap-1">
                    <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                    PCI compliant
                </span>
                <span>·</span>
                <span class="flex items-center gap-1">
                    <LucideIconCn Name="star" Size="12" Class="size-3" />
                    4.9/5 from 2,847 reviews
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record PaymentMethod(string Id, string Name);

    private record TrustSignal(string Id, string Icon, string Label, string Detail);

    private static readonly PaymentMethod[] _paymentMethods =
    [
        new("visa", "Visa"),
        new("mastercard", "Mastercard"),
        new("amex", "Amex"),
        new("apple", "Apple Pay"),
        new("google", "Google Pay"),
    ];

    private static readonly TrustSignal[] _trustSignals =
    [
        new("ssl", "lock", "256-bit SSL", "Encrypted connection"),
        new("guarantee", "refresh-ccw", "30-day guarantee", "Full refund, no questions"),
        new("secure", "shield-check", "Secure checkout", "PCI DSS compliant"),
        new("reviews", "star", "4.9/5 rating", "2,847 verified reviews"),
    ];
}
