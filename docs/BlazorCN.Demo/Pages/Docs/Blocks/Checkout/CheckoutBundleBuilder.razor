@* ============================================================
   Block: checkout-bundle-builder
   Title: CheckoutBundleBuilder
   Description: A build-a-bundle checkout block where customers select items to create a discounted bundle with dynamic pricing, savings badge, and individual vs bundle price comparison using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-bundle-builder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Build Your Bundle</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">
                Save @((BundleDiscount * 100).ToString("F0"))%
            </BadgeCn>
        </div>

        @* Selection counter *@
        <div class="flex items-center justify-between border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                Select @BundleSize items to complete your bundle
            </span>
            <span class="font-medium text-xs tabular-nums">
                @_selectedIds.Count/@BundleSize selected
            </span>
        </div>

        @* Product grid *@
        <div class="border-b">
            @foreach (var prod in _products)
            {
                var product = prod;
                var isSelected = _selectedIds.Contains(product.Id);
                var isDisabled = !isSelected && _selectedIds.Count >= BundleSize;
                var isLast = product.Id == _products[_products.Length - 1].Id;
                <button
                    type="button"
                    @onclick="@(() => ToggleItem(product.Id))"
                    disabled="@isDisabled"
                    class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors", !isLast ? "border-b" : "", isSelected ? "bg-muted/50" : "", isDisabled ? "cursor-not-allowed opacity-50" : "hover:bg-muted/50")">
                    <div class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded border transition-colors", isSelected ? "border-primary bg-primary text-primary-foreground" : "border-muted-foreground/30")">
                        @if (isSelected)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@product.Name</span>
                            <span class="text-muted-foreground text-xs">@product.Category</span>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@product.Description</p>
                    </div>
                    <span class="shrink-0 font-medium text-sm tabular-nums">
                        $@product.Price.ToString("F2")
                    </span>
                </button>
            }
        </div>

        @* Price comparison *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Individual price</span>
                <span class="text-muted-foreground text-xs tabular-nums line-through">
                    $@IndividualTotal.ToString("F2")
                </span>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Bundle discount</span>
                <span class="text-xs tabular-nums text-emerald-600 dark:text-emerald-400">
                    -$@Savings.ToString("F2")
                </span>
            </div>
            <div class="mt-2 flex items-center justify-between border-t pt-2">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Bundle Price</span>
                    @if (_isBundleComplete && Savings > 0)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs text-emerald-600 dark:text-emerald-400">
                            You save $@Savings.ToString("F2")
                        </BadgeCn>
                    }
                </div>
                <span class="font-semibold text-sm tabular-nums">$@BundlePrice.ToString("F2")</span>
            </div>
            <ButtonCn Class="mt-3 w-full" Size="ButtonSize.Sm" Disabled="@(!_isBundleComplete)">
                @(_isBundleComplete ? "Add Bundle to Cart" : $"Select {BundleSize - _selectedIds.Count} more")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Product(string Id, string Name, string Description, double Price, string Category);

    private const int BundleSize = 3;
    private const double BundleDiscount = 0.15;

    private static readonly Product[] _products =
    [
        new("p1", "Ceramic Pour-Over Dripper", "Hand-thrown stoneware, 2-cup capacity", 38, "Brew"),
        new("p2", "Burr Coffee Grinder", "15 grind settings, 60g hopper", 54, "Grind"),
        new("p3", "Double-Wall Glass Mugs", "Set of 2, 350ml borosilicate glass", 28, "Serve"),
        new("p4", "Digital Brew Scale", "0.1g precision, built-in timer", 42, "Measure"),
        new("p5", "Gooseneck Kettle", "1.0L, temperature control, matte finish", 64, "Heat"),
        new("p6", "Single Origin Sampler", "4 x 100g bags, light to dark roast", 32, "Beans"),
    ];

    private HashSet<string> _selectedIds = ["p1", "p3", "p4"];

    private double IndividualTotal => _products.Where(p => _selectedIds.Contains(p.Id)).Sum(p => p.Price);
    private double BundlePrice => IndividualTotal * (1 - BundleDiscount);
    private double Savings => IndividualTotal - BundlePrice;
    private bool _isBundleComplete => _selectedIds.Count == BundleSize;

    private void ToggleItem(string id)
    {
        if (_selectedIds.Contains(id))
        {
            _selectedIds.Remove(id);
        }
        else if (_selectedIds.Count < BundleSize)
        {
            _selectedIds.Add(id);
        }
    }
}
