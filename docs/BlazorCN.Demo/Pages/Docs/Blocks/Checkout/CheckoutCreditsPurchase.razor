@* ============================================================
   Block: checkout-credits-purchase
   Title: CheckoutCreditsPurchase
   Description: A credits and tokens purchase checkout for React and Next.js with credit package selector, per-credit pricing, bonus credits at higher tiers, current balance display, auto-refill toggle, and purchase button using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-credits-purchase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="coins" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Purchase Credits</span>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Select a credit package to top up your account
            </p>
        </div>

        @* Current balance *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Current balance</span>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="zap" Size="14" Class="size-3.5 text-amber-500" />
                    <span class="font-semibold text-lg tabular-nums">@CurrentBalance</span>
                    <span class="text-muted-foreground text-xs">credits</span>
                </div>
            </div>
        </div>

        @* Package selector *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Select package</span>
            </div>
            <RadioGroupCn Value="@_selected" ValueChanged="@((string v) => _selected = v)">
                @foreach (var it in _creditPackages)
                {
                    var pkg = it;
                    var isActive = _selected == pkg.Id;
                    var isLast = Array.IndexOf(_creditPackages, pkg) == _creditPackages.Length - 1;
                    var perCredit = pkg.Price / (double)pkg.Credits;
                    <span role="button"
                          tabindex="0"
                          @onclick="@(() => _selected = pkg.Id)"
                          class="@Cn.Merge("flex cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b", isActive ? "bg-muted/50" : "")">
                        <RadioGroupItemCn Value="@pkg.Id" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm tabular-nums">
                                    @pkg.Credits.ToString("N0") credits
                                </span>
                                @if (pkg.Popular)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                                        Popular
                                    </BadgeCn>
                                }
                                @if (pkg.Bonus > 0)
                                {
                                    <span class="flex items-center gap-0.5 text-emerald-600 text-xs dark:text-emerald-400">
                                        <LucideIconCn Name="sparkles" Size="12" Class="size-3" />+@pkg.Bonus bonus
                                    </span>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">
                                $@perCredit.ToString("F3")/credit
                            </p>
                        </div>
                        <span class="shrink-0 font-medium text-sm tabular-nums">$@pkg.Price</span>
                    </span>
                }
            </RadioGroupCn>
        </div>

        @* Auto-refill *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-sm">Auto-refill</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Automatically purchase this package when balance drops below 10 credits
                    </p>
                </div>
                <SwitchCn Checked="@_autoRefill" CheckedChanged="@((bool v) => _autoRefill = v)" />
            </div>
        </div>

        @* Summary *@
        <div class="border-b px-4 py-3 space-y-1.5">
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">
                    @_activePackage.Credits.ToString("N0") credits
                </span>
                <span class="tabular-nums">$@($"{_activePackage.Price}.00")</span>
            </div>
            @if (_activePackage.Bonus > 0)
            {
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Bonus credits</span>
                    <span class="tabular-nums text-emerald-600 dark:text-emerald-400">
                        +@_activePackage.Bonus
                    </span>
                </div>
            }
            <div class="flex justify-between border-t pt-1.5 text-sm font-medium">
                <span>Total credits</span>
                <span class="tabular-nums">@_totalCredits.ToString("N0")</span>
            </div>
            <div class="flex justify-between text-xs text-muted-foreground">
                <span>New balance after purchase</span>
                <span class="tabular-nums">@_newBalance.ToString("N0") credits</span>
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">Purchase for $@($"{_activePackage.Price}.00")</ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Credits never expire. Secure payment via Stripe.
            </p>
        </div>
    </div>
</section>

@code {
    private record CreditPackage(string Id, int Credits, int Price, int Bonus, bool Popular);

    private const int CurrentBalance = 47;

    private static readonly CreditPackage[] _creditPackages =
    [
        new("pkg-100",  100,  10,   0, false),
        new("pkg-500",  500,  40,  25, true),
        new("pkg-1000", 1000, 70,  75, false),
        new("pkg-5000", 5000, 300, 500, false),
    ];

    private string _selected = "pkg-500";
    private bool _autoRefill = false;

    private CreditPackage _activePackage =>
        _creditPackages.FirstOrDefault(p => p.Id == _selected) ?? _creditPackages[1];

    private int _totalCredits => _activePackage.Credits + _activePackage.Bonus;
    private int _newBalance => CurrentBalance + _totalCredits;
}
