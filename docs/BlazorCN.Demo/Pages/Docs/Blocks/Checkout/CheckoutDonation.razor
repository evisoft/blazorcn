@* ============================================================
   Block: checkout-donation
   Title: CheckoutDonation
   Description: Donation checkout block for React and Next.js with preset amount buttons, custom amount input, optional recurring toggle, donor information form, and tax deductible notice using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-donation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="heart" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Make a donation</span>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Support our mission with a one-time or recurring gift
            </p>
        </div>

        @* Amount selection *@
        <div class="border-b px-4 py-4">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Select amount
            </span>
            <div class="grid grid-cols-4 gap-2">
                @foreach (var val in _presetAmounts)
                {
                    var amount = val;
                    var isSelected = _selectedAmount == amount && string.IsNullOrEmpty(_customAmount);
                    <button type="button"
                            @onclick="@(() => HandlePresetClick(amount))"
                            class="@Cn.Merge("rounded-md border px-3 py-2.5 font-semibold text-sm tabular-nums transition-colors", isSelected ? "border-foreground/20 bg-muted/50" : "border-transparent text-muted-foreground hover:bg-muted/30")">
                        $@amount
                    </button>
                }
            </div>
            <div class="mt-3 space-y-1.5">
                <LabelCn For="donation-custom" Class="text-xs text-muted-foreground">
                    Custom amount
                </LabelCn>
                <div class="relative">
                    <span class="absolute top-1/2 left-3 -translate-y-1/2 text-muted-foreground text-sm">
                        $
                    </span>
                    <InputCn Id="donation-custom"
                             Type="text"
                             Placeholder="0.00"
                             Value="@_customAmount"
                             ValueChanged="@((string v) => HandleCustomChange(v))"
                             Class="pl-7" />
                </div>
            </div>
        </div>

        @* Recurring toggle *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Make it monthly</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Recurring donations help us plan ahead
                </p>
            </div>
            <SwitchCn aria-label="Make it monthly" Checked="@_isRecurring" CheckedChanged="@((bool v) => _isRecurring = v)" />
        </div>

        @* Donor info *@
        <div class="space-y-3 border-b px-4 py-4">
            <span class="font-medium text-muted-foreground text-xs">Your information</span>
            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1.5">
                    <LabelCn For="donor-first" Class="text-xs text-muted-foreground">
                        First name
                    </LabelCn>
                    <InputCn Id="donor-first" Placeholder="Jane" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="donor-last" Class="text-xs text-muted-foreground">
                        Last name
                    </LabelCn>
                    <InputCn Id="donor-last" Placeholder="Smith" />
                </div>
            </div>
            <div class="space-y-1.5">
                <LabelCn For="donor-email" Class="text-xs text-muted-foreground">
                    Email
                </LabelCn>
                <InputCn Id="donor-email" Type="email" Placeholder="@("you@example.com")" />
            </div>
        </div>

        @* Payment form *@
        <div class="space-y-3 border-b px-4 py-4">
            <span class="font-medium text-muted-foreground text-xs">Payment details</span>
            <div class="space-y-1.5">
                <LabelCn For="donation-card" Class="text-xs text-muted-foreground">
                    Card number
                </LabelCn>
                <div class="relative">
                    <InputCn Id="donation-card"
                             Placeholder="1234 1234 1234 1234"
                             Value="@_cardNumber"
                             ValueChanged="@((string v) => _cardNumber = v)"
                             Class="pr-10" />
                    <LucideIconCn Name="credit-card" Size="16" Class="absolute top-1/2 right-3 size-4 -translate-y-1/2 text-muted-foreground/60" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1.5">
                    <LabelCn For="donation-expiry" Class="text-xs text-muted-foreground">
                        Expiry
                    </LabelCn>
                    <InputCn Id="donation-expiry"
                             Placeholder="MM / YY"
                             Value="@_expiry"
                             ValueChanged="@((string v) => _expiry = v)" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="donation-cvc" Class="text-xs text-muted-foreground">
                        CVC
                    </LabelCn>
                    <InputCn Id="donation-cvc"
                             Placeholder="123"
                             Value="@_cvc"
                             ValueChanged="@((string v) => _cvc = v)" />
                </div>
            </div>
        </div>

        @* CTA + Tax notice *@
        <div class="px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    @(_isRecurring ? "Monthly donation" : "One-time donation")
                </span>
                <span class="font-semibold text-sm tabular-nums">
                    $@(Amount > 0 ? Amount.ToString("F2") : "0.00")@(_isRecurring ? "/mo" : "")
                </span>
            </div>
            <ButtonCn Class="h-10 w-full text-sm" Disabled="@(Amount <= 0)">
                <LucideIconCn Name="lock" Size="14" Class="mr-1.5 size-3.5" />
                Donate $@(Amount > 0 ? Amount.ToString("F2") : "0.00")
            </ButtonCn>
            <div class="mt-3 rounded-md bg-muted/50 p-3">
                <p class="text-muted-foreground text-xs leading-relaxed">
                    Your donation is tax deductible. You will receive a receipt via email for your
                    records. Our EIN is 12-3456789.
                </p>
            </div>
        </div>

    </div>
</section>

@code {
    private static readonly int[] _presetAmounts = [10, 25, 50, 100];

    private int? _selectedAmount = 25;
    private string _customAmount = "";
    private bool _isRecurring = false;
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvc = "";

    private double Amount =>
        !string.IsNullOrEmpty(_customAmount)
            ? double.TryParse(_customAmount, out var parsed) ? parsed : 0
            : _selectedAmount ?? 0;

    private void HandlePresetClick(int value)
    {
        _selectedAmount = value;
        _customAmount = "";
    }

    private void HandleCustomChange(string value)
    {
        _customAmount = value;
        _selectedAmount = null;
    }
}
