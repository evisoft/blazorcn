@* ============================================================
   Block: checkout-pre-order
   Title: CheckoutPreOrder
   Description: A pre-order checkout block with expected ship date, pre-order badge, release date information, deferred charge notice, guarantee terms, and estimated delivery window using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-pre-order.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Pre-Order Checkout</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">
                Pre-Order
            </BadgeCn>
        </div>

        @* Product details *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between">
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">@_productName</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_productVariant</p>
                    <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                        @_productDescription
                    </p>
                </div>
                <span class="shrink-0 pl-4 font-semibold text-sm tabular-nums">
                    $@(_productPrice.ToString("F2"))
                </span>
            </div>
        </div>

        @* Release and delivery info *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <span class="text-muted-foreground text-xs">Release date</span>
                        <p class="font-medium text-sm">@_releaseDate</p>
                    </div>
                </div>
                <span class="text-muted-foreground text-xs">·</span>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="truck" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div>
                        <span class="text-muted-foreground text-xs">Estimated delivery</span>
                        <p class="font-medium text-sm">@_deliveryWindow</p>
                    </div>
                </div>
            </div>
        </div>

        @* Charge notice *@
        <div class="flex items-start gap-2 border-b bg-muted/30 px-4 py-3">
            <LucideIconCn Name="info" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
            <p class="text-sm leading-relaxed">
                Your payment method will be saved but
                <span class="font-medium">you won't be charged until the item ships</span>. You can
                cancel anytime before the release date.
            </p>
        </div>

        @* Payment details *@
        <div class="border-b px-4 py-4">
            <span class="font-medium text-sm">Reserve with Payment Method</span>
            <div class="mt-3 space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="po-email" Class="text-xs">
                        Email
                    </LabelCn>
                    <InputCn Id="po-email" Type="email" Placeholder="@("you@example.com")" @bind-Value="_email" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="po-card" Class="text-xs">
                        Card number
                    </LabelCn>
                    <InputCn Id="po-card" Placeholder="4242 4242 4242 4242" @bind-Value="_cardNumber" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="po-expiry" Class="text-xs">
                            Expiry date
                        </LabelCn>
                        <InputCn Id="po-expiry" Placeholder="MM / YY" @bind-Value="_expiry" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="po-cvv" Class="text-xs">
                            CVV
                        </LabelCn>
                        <InputCn Id="po-cvv" Placeholder="123" @bind-Value="_cvv" />
                    </div>
                </div>
            </div>
        </div>

        @* Pre-order guarantees *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Pre-order guarantee</span>
            <div class="mt-2 space-y-2">
                @foreach (var item in _guarantees)
                {
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="@item.Icon" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                        <span class="text-sm">@item.Text</span>
                    </div>
                }
            </div>
        </div>

        @* Total and action *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Due at shipping</span>
                <span class="font-semibold text-sm tabular-nums">$@(_productPrice.ToString("F2"))</span>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">Due today: $0.00</p>
            <ButtonCn Class="mt-3 w-full" Size="ButtonSize.Sm">Place Pre-Order</ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                You will receive a confirmation email with your order details
            </p>
        </div>
    </div>
</section>

@code {
    private const string _productName = "Arc Studio Monitor";
    private const string _productVariant = "Matte White / 27-inch";
    private const double _productPrice = 899.99;
    private const string _releaseDate = "May 15, 2026";
    private const string _deliveryWindow = "May 19 – May 26, 2026";
    private const string _productDescription = "Next-generation studio display with ProMotion, nano-texture glass, and built-in calibration.";

    private string _email = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";

    private record Guarantee(string Icon, string Text);

    private static readonly Guarantee[] _guarantees =
    [
        new("credit-card", "You won't be charged until the item ships"),
        new("calendar", "Cancel your pre-order anytime before release"),
        new("shield-check", "Full refund if we can't fulfill your order"),
    ];
}
