@* ============================================================
   Block: checkout-weight-based-shipping
   Title: CheckoutWeightBasedShipping
   Description: A shipping cost calculator block that displays per-item weight, total package weight, tiered shipping rates by weight range, dimensional weight notice, and a combine shipments toggle
   Source: original/blocks/checkout/checkout-weight-based-shipping.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Shipping Calculator</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Rates based on total package weight
                </p>
            </div>
            <LucideIconCn Name="scale" Size="16" Class="size-4 text-muted-foreground" />
        </div>

        @* Items with weights *@
        <div class="border-b">
            @foreach (var it in _items)
            {
                var item = it;
                var isLast = Array.IndexOf(_items, item) == _items.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", !isLast ? "border-b" : "")">
                    <LucideIconCn Name="package" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                    <div class="min-w-0 flex-1">
                        <span class="text-sm">@item.Name</span>
                        @if (item.Qty > 1)
                        {
                            <span class="ml-1 text-muted-foreground text-xs">x@item.Qty</span>
                        }
                    </div>
                    <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                        @((item.Weight * item.Qty).ToString("F1")) lbs
                    </span>
                </div>
            }
        </div>

        @* Total weight *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="weight" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Total Weight</span>
            </div>
            <span class="font-semibold text-sm tabular-nums">@_totalWeight.ToString("F1") lbs</span>
        </div>

        @* Shipping tiers *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Shipping rates</span>
            <div class="mt-2 space-y-1.5">
                @foreach (var tier in _shippingTiers)
                {
                    var isActive = tier.Id == _activeTier.Id;
                    <div class="@Cn.Merge("flex items-center justify-between rounded-md px-2.5 py-1.5 text-xs", isActive ? "bg-muted/50 font-medium" : "text-muted-foreground")">
                        <div class="flex items-center gap-2">
                            @if (isActive)
                            {
                                <span class="size-1.5 rounded-full bg-foreground"></span>
                            }
                            <span>@tier.Label</span>
                        </div>
                        <span class="tabular-nums">$@tier.Rate.ToString("F2")</span>
                    </div>
                }
            </div>
        </div>

        @* Dimensional weight notice *@
        <div class="flex items-start gap-2 border-b px-4 py-3">
            <LucideIconCn Name="info" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground/60" />
            <p class="text-muted-foreground text-xs leading-relaxed">
                Dimensional weight may apply for bulky items. Final shipping cost is based on the
                greater of actual weight or dimensional weight (L x W x H / 139).
            </p>
        </div>

        @* Combine shipments toggle *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-sm">Combine shipments</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Ship all items together to save on shipping
                </p>
            </div>
            <SwitchCn @bind-Checked="_combineShipments" />
        </div>

        @* Summary *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between text-muted-foreground text-xs">
                <span>Subtotal</span>
                <span class="tabular-nums">$@_subtotal.ToString("F2")</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-muted-foreground text-xs">
                <span>Shipping (@_activeTier.Label)</span>
                <span class="tabular-nums">$@_shippingCost.ToString("F2")</span>
            </div>
            <div class="mt-2 flex items-center justify-between border-t pt-2">
                <span class="font-medium text-sm">Total</span>
                <span class="font-semibold text-sm tabular-nums">$@_total.ToString("F2")</span>
            </div>
            <ButtonCn Class="mt-3 w-full" Size="ButtonSize.Sm">Continue to Payment</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record CartItem(string Id, string Name, double Weight, int Qty, double Price);
    private record ShippingTier(string Id, string Label, double MaxWeight, double Rate);

    private static readonly CartItem[] _items =
    [
        new("1", "Cast Iron Skillet",         3.6, 1, 54.99),
        new("2", "Ceramic Dinner Plates",      1.8, 2, 32.00),
        new("3", "Stainless Steel Cutlery Set",0.9, 1, 45.00),
        new("4", "Cotton Table Runner",        0.3, 1, 28.00),
    ];

    private static readonly ShippingTier[] _shippingTiers =
    [
        new("light",    "Under 2 lbs",  2,   5.99),
        new("standard", "2 - 5 lbs",    5,   9.99),
        new("heavy",    "5 - 10 lbs",   10, 14.99),
        new("freight",  "Over 10 lbs",  999, 24.99),
    ];

    private static readonly double _totalWeight = _items.Sum(i => i.Weight * i.Qty);
    private static readonly double _subtotal    = _items.Sum(i => i.Price  * i.Qty);

    private bool _combineShipments = true;

    private ShippingTier _activeTier => _shippingTiers.FirstOrDefault(t => _totalWeight <= t.MaxWeight) ?? _shippingTiers[^1];
    private double _shippingCost => _activeTier.Rate;
    private double _total => _subtotal + _shippingCost;

    private ShippingTier GetShippingRate(double weight) =>
        _shippingTiers.FirstOrDefault(t => weight <= t.MaxWeight) ?? _shippingTiers[^1];
}
