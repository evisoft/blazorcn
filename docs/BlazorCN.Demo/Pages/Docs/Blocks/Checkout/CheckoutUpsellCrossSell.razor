@* ============================================================
   Block: checkout-upsell-cross-sell
   Title: CheckoutUpsellCrossSell
   Description: A checkout upsell and cross-sell block for React and Next.js with frequently bought together section, add-on checkboxes with prices, complete the look suggestions, and bundle discount indicator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-upsell-cross-sell.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Your Cart</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                @_cartItems.Length items in your cart
            </p>
        </div>

        @* Cart items *@
        <div class="border-b">
            @for (var i = 0; i < _cartItems.Length; i++)
            {
                var item = _cartItems[i];
                var isLast = i == _cartItems.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", !isLast ? "border-b" : "")">
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@item.Name</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @item.Variant &middot; Qty @item.Quantity
                        </p>
                    </div>
                    <span class="shrink-0 font-medium text-sm tabular-nums">$@(item.Price).00</span>
                </div>
            }
        </div>

        @* Frequently bought together *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">
                    Frequently bought together
                </span>
            </div>
            @if (_bundleDiscountPercent > 0)
            {
                <div class="mt-2 flex items-center gap-1.5 rounded-md bg-emerald-500/10 px-2.5 py-1.5">
                    <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                    <span class="text-emerald-600 text-xs dark:text-emerald-400">
                        Bundle discount: @(_bundleDiscountPercent)% off add-ons
                    </span>
                </div>
            }
            <div class="mt-2 space-y-1">
                @foreach (var addOn in _addOns)
                {
                    var ao = addOn;
                    <label class="flex cursor-pointer items-center gap-3 rounded-md px-2.5 py-2 transition-colors hover:bg-muted/50"
                           for="@($"upsell-addon-{ao.Id}")">
                        <CheckboxCn id="@($"upsell-addon-{ao.Id}")" aria-label="@ao.Name" Checked="@(_selectedAddOns.Contains(ao.Id))"
                                    CheckedChanged="@(_ => ToggleAddOn(ao.Id))" />
                        <span class="min-w-0 flex-1">
                            <span class="block font-medium text-sm">@ao.Name</span>
                            <span class="block text-muted-foreground text-xs">@ao.Description</span>
                        </span>
                        <span class="shrink-0 text-sm tabular-nums">+$@(ao.Price).00</span>
                    </label>
                }
            </div>
        </div>

        @* Complete the look *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Complete the look</span>
            <div class="mt-2 flex gap-2">
                @foreach (var suggestion in _suggestions)
                {
                    var sug = suggestion;
                    <div class="flex flex-1 flex-col items-center gap-1.5 rounded-md bg-muted/50 px-3 py-2.5">
                        <span class="text-center font-medium text-xs">@sug.Name</span>
                        <span class="text-muted-foreground text-xs tabular-nums">$@(sug.Price).00</span>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-1 h-6 px-2 text-xs">
                            Add
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        @* Price breakdown *@
        <div class="border-b px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Subtotal</span>
                    <span class="text-xs tabular-nums">$@_cartSubtotal.00</span>
                </div>
                @if (_selectedAddOns.Count > 0)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground text-xs">
                            Add-ons (@(_selectedAddOns.Count))
                        </span>
                        <span class="text-xs tabular-nums">+$@_addOnTotal.00</span>
                    </div>
                }
                @if (_bundleDiscountAmount > 0)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-emerald-600 text-xs dark:text-emerald-400">
                            Bundle discount (@(_bundleDiscountPercent)%)
                        </span>
                        <span class="text-emerald-600 text-xs tabular-nums dark:text-emerald-400">
                            -$@_bundleDiscountAmount.00
                        </span>
                    </div>
                }
                <div class="flex items-center justify-between border-t pt-1.5">
                    <span class="font-medium text-sm">Total</span>
                    <span class="font-semibold text-2xl tabular-nums">$@_total.00</span>
                </div>
            </div>
        </div>

        @* CTA *@
        <div class="border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                Proceed to Payment
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Free shipping on orders over $100 &middot; 30-day returns
            </p>
        </div>
    </div>
</section>

@code {
    private record CartItem(string Id, string Name, string Variant, int Price, int Quantity);
    private record AddOn(string Id, string Name, string Description, int Price);
    private record Suggestion(string Id, string Name, int Price);

    private static readonly CartItem[] _cartItems =
    [
        new("c1", "Wireless Noise-Canceling Headphones", "Matte Black", 249, 1),
        new("c2", "USB-C Charging Cable", "2m Braided", 19, 1),
    ];

    private static readonly AddOn[] _addOns =
    [
        new("a1", "Premium Carrying Case", "Hard-shell EVA case with cable pocket", 34),
        new("a2", "Extended Warranty", "2-year accidental damage protection", 29),
        new("a3", "Replacement Ear Cushions", "Memory foam, pack of 2", 18),
    ];

    private static readonly Suggestion[] _suggestions =
    [
        new("s1", "Headphone Stand", 24),
        new("s2", "Audio Adapter 3.5mm", 9),
        new("s3", "Microfiber Cleaning Cloth", 6),
    ];

    private HashSet<string> _selectedAddOns = [];

    private void ToggleAddOn(string id)
    {
        if (!_selectedAddOns.Remove(id))
            _selectedAddOns.Add(id);
    }

    private int _cartSubtotal => _cartItems.Sum(i => i.Price * i.Quantity);

    private int _addOnTotal => _addOns
        .Where(a => _selectedAddOns.Contains(a.Id))
        .Sum(a => a.Price);

    private int _bundleDiscountPercent => _selectedAddOns.Count >= 3 ? 10 : _selectedAddOns.Count >= 2 ? 5 : 0;

    private int _bundleDiscountAmount => _bundleDiscountPercent > 0
        ? (int)Math.Round(_addOnTotal * (_bundleDiscountPercent / 100.0))
        : 0;

    private int _total => _cartSubtotal + _addOnTotal - _bundleDiscountAmount;
}
