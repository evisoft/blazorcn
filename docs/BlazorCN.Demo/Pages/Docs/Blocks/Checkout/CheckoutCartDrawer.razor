@* ============================================================
   Block: checkout-cart-drawer
   Title: CheckoutCartDrawer
   Description: A slide-over cart drawer block for React and Next.js with item list, product thumbnails, quantity adjusters, remove buttons, shipping estimate, and sticky checkout button using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-cart-drawer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shopping-bag" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Your Cart</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-1 font-normal text-xs">
                @_itemCount
            </BadgeCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto h-7 w-7 px-0">
                <LucideIconCn Name="x" Size="16" Class="size-4" />
            </ButtonCn>
        </div>

        @* Items list - scrollable *@
        <div class="flex-1 overflow-y-auto">
            @foreach (var it in _items)
            {
                var item = it;
                var index = _items.IndexOf(it);
                <div class="@Cn.Merge("flex gap-3 px-4 py-3", index < _items.Count - 1 ? "border-b" : "")">
                    @* Thumbnail *@
                    <div class="@Cn.Merge("size-16 shrink-0 rounded-md", item.Color)"></div>

                    @* Details *@
                    <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0">
                                <span class="font-medium text-sm">@item.Name</span>
                                <p class="text-muted-foreground text-xs">@item.Variant</p>
                            </div>
                            <span class="shrink-0 font-medium text-sm tabular-nums">
                                $@((item.Price * item.Quantity).ToString("F2"))
                            </span>
                        </div>

                        @* Quantity + remove *@
                        <div class="mt-2 flex items-center gap-2">
                            <div class="flex items-center rounded-md border">
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 px-0"
                                          OnClick="@(() => UpdateQuantity(item.Id, -1))"
                                          Disabled="@(item.Quantity <= 1)">
                                    <LucideIconCn Name="minus" Size="12" Class="size-3" />
                                </ButtonCn>
                                <span class="w-8 text-center font-medium text-xs tabular-nums">
                                    @item.Quantity
                                </span>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 px-0"
                                          OnClick="@(() => UpdateQuantity(item.Id, 1))">
                                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                </ButtonCn>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 text-muted-foreground text-xs"
                                      OnClick="@(() => RemoveItem(item.Id))">
                                Remove
                            </ButtonCn>
                            @if (item.Quantity > 1)
                            {
                                <span class="text-muted-foreground text-xs tabular-nums">
                                    $@(item.Price.ToString("F2")) each
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Totals + checkout - sticky bottom *@
        <div class="border-t">
            <div class="space-y-1.5 px-4 py-3">
                <div class="flex items-center justify-between text-sm">
                    <span class="text-muted-foreground">Subtotal</span>
                    <span class="tabular-nums">$@(_subtotal.ToString("F2"))</span>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <span class="text-muted-foreground">Shipping estimate</span>
                    <span class="tabular-nums">$@(_shippingEstimate.ToString("F2"))</span>
                </div>
                <div class="flex items-center justify-between border-t pt-1.5 font-medium text-sm">
                    <span>Total</span>
                    <span class="tabular-nums">$@(_total.ToString("F2"))</span>
                </div>
            </div>
            <div class="px-4 pb-3">
                <ButtonCn Class="w-full">Checkout</ButtonCn>
                <p class="mt-2 text-center text-muted-foreground text-xs">
                    Shipping and taxes calculated at checkout
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record CartItem(string Id, string Name, string Variant, double Price, int Quantity, string Color);

    private static readonly CartItem[] _initialItems =
    [
        new("ci-1", "Wool Blend Overcoat", "Charcoal / M", 289, 1, "bg-zinc-400 dark:bg-zinc-600"),
        new("ci-2", "Cotton Oxford Shirt", "White / L", 78, 2, "bg-stone-200 dark:bg-stone-700"),
        new("ci-3", "Slim Chino Pants", "Navy / 32", 95, 1, "bg-sky-900 dark:bg-sky-800"),
        new("ci-4", "Leather Belt", "Brown / One Size", 55, 1, "bg-amber-700 dark:bg-amber-800"),
    ];

    private const double _shippingEstimate = 12.99;

    private List<CartItem> _items = _initialItems.ToList();

    private double _subtotal => _items.Sum(i => i.Price * i.Quantity);
    private double _total => _subtotal + _shippingEstimate;
    private int _itemCount => _items.Sum(i => i.Quantity);

    private void UpdateQuantity(string id, int delta)
    {
        _items = _items.Select(item =>
            item.Id == id
                ? item with { Quantity = Math.Max(1, item.Quantity + delta) }
                : item
        ).ToList();
    }

    private void RemoveItem(string id)
    {
        _items = _items.Where(item => item.Id != id).ToList();
    }
}
