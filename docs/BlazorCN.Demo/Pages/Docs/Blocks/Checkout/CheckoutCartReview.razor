@* ============================================================
   Block: checkout-cart-review
   Title: CheckoutCartReview
   Description: Cart review checkout block for React and Next.js with editable item quantities, remove buttons, item thumbnails, line item prices, subtotal calculation, and proceed to payment CTA using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-cart-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Your cart</span>
            <span class="text-muted-foreground text-xs">
                @_itemCount @(_itemCount == 1 ? "item" : "items")
            </span>
        </div>

        @* Cart items *@
        <div>
            @{
                var itemList = _items.ToList();
            }
            @foreach (var it in itemList)
            {
                var item = it;
                var isLast = itemList.IndexOf(item) == itemList.Count - 1;
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    @* Thumbnail placeholder *@
                    <div class="flex size-12 shrink-0 items-center justify-center rounded-md bg-muted/50 font-medium text-muted-foreground text-xs">
                        @item.Image
                    </div>

                    @* Item details *@
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@item.Name</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>

                        @* Quantity controls *@
                        <div class="mt-2 flex items-center gap-2">
                            <div class="flex items-center rounded-md border">
                                <button aria-label="Decrease quantity" type="button"
                                        @onclick="@(() => UpdateQuantity(item.Id, -1))"
                                        disabled="@(item.Quantity <= 1)"
                                        class="flex size-7 items-center justify-center text-muted-foreground transition-colors hover:bg-muted/50 disabled:opacity-40">
                                    <LucideIconCn Name="minus" Size="12" Class="size-3" />
                                </button>
                                <span class="flex w-8 items-center justify-center font-medium text-xs tabular-nums">
                                    @item.Quantity
                                </span>
                                <button aria-label="Increase quantity" type="button"
                                        @onclick="@(() => UpdateQuantity(item.Id, 1))"
                                        class="flex size-7 items-center justify-center text-muted-foreground transition-colors hover:bg-muted/50">
                                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                </button>
                            </div>
                            <button aria-label="@($"Remove {item.Name}")" type="button"
                                    @onclick="@(() => RemoveItem(item.Id))"
                                    class="flex size-7 items-center justify-center rounded-md text-muted-foreground transition-colors hover:bg-muted/50 hover:text-destructive">
                                <LucideIconCn Name="trash" Size="14" Class="size-3.5" />
                            </button>
                        </div>
                    </div>

                    @* Price *@
                    <span class="shrink-0 font-medium text-sm tabular-nums">
                        $@((item.Price * item.Quantity).ToString("F2"))
                    </span>
                </div>
            }
        </div>

        @* Empty state *@
        @if (_items.Count == 0)
        {
            <div class="px-4 py-8 text-center">
                <p class="text-muted-foreground text-sm">Your cart is empty</p>
            </div>
        }

        @* Summary + CTA *@
        @if (_items.Count > 0)
        {
            <div class="border-t px-4 py-3">
                <div class="mb-1 flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Subtotal</span>
                    <span class="font-semibold text-sm tabular-nums">$@_subtotal.ToString("F2")</span>
                </div>
                <p class="mb-3 text-muted-foreground text-xs">
                    Shipping and taxes calculated at next step
                </p>
                <ButtonCn Class="h-10 w-full text-sm">Proceed to payment</ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private record CartItem(string Id, string Name, string Description, double Price, int Quantity, string Image);

    private List<CartItem> _items =
    [
        new("1", "Wireless Noise-Canceling Headphones", "Matte Black · Over-ear",   249.0, 1, "WH"),
        new("2", "Mechanical Keyboard",                 "Cherry MX Brown · TKL",    179.0, 1, "MK"),
        new("3", "USB-C Charging Cable",                "2m · Braided Nylon",        19.0, 2, "UC"),
    ];

    private int _itemCount => _items.Sum(i => i.Quantity);
    private double _subtotal => _items.Sum(i => i.Price * i.Quantity);

    private void UpdateQuantity(string id, int delta)
    {
        _items = _items.Select(i =>
        {
            if (i.Id != id) return i;
            return i with { Quantity = Math.Max(1, i.Quantity + delta) };
        }).ToList();
    }

    private void RemoveItem(string id)
    {
        _items = _items.Where(i => i.Id != id).ToList();
    }
}
