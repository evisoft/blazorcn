@* ============================================================
   Block: checkout-loyalty-points
   Title: CheckoutLoyaltyPoints
   Description: A checkout loyalty points redemption block for React and Next.js with points balance display, slider to apply points, conversion rate indicator, remaining points calculation, and points earned from purchase built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-loyalty-points.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="coins" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Redeem Points</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Apply your loyalty points to reduce the amount due.
            </p>
        </div>

        @* Points balance *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Available points</span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-semibold text-2xl tabular-nums">
                            @_pointsBalance.ToString("N0")
                        </span>
                        <span class="text-muted-foreground text-xs">pts</span>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Worth $@(_pointsBalance / PointsPerDollar).00
                    </p>
                </div>
                <div class="text-right">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="star" Size="12" Class="mr-1 size-3" />
                        @_memberTier Member
                    </BadgeCn>
                    <p class="mt-1.5 text-muted-foreground text-xs">
                        @PointsPerDollar pts = $1.00
                    </p>
                </div>
            </div>
        </div>

        @* Cart items *@
        <div class="border-b">
            @{
                var cartList = _cartItems.ToList();
            }
            @foreach (var it in cartList)
            {
                var item = it;
                var idx = cartList.IndexOf(item);
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", idx < cartList.Count - 1 ? "border-b" : "")">
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@item.Name</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@item.Variant</p>
                    </div>
                    <span class="shrink-0 text-sm tabular-nums">$@(item.Price).00</span>
                </div>
            }
        </div>

        @* Points slider *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Points to redeem</span>
                <span class="font-medium text-sm tabular-nums">
                    @_pointsToApply.ToString("N0") pts
                </span>
            </div>
            <div class="mt-3">
                <SliderCn aria-label="Points to redeem" Value="@((double)_pointsToApply)"
                          Min="0"
                          Max="@((double)_maxRedeemablePoints)"
                          Step="100"
                          ValueChanged="@((double v) => { _pointsToApply = (int)(Math.Round(v / 100) * 100); })" />
            </div>
            <div class="mt-2 flex items-center justify-between text-muted-foreground text-xs">
                <span>0 pts</span>
                <span>@_maxRedeemablePoints.ToString("N0") pts</span>
            </div>
            @if (_dollarsFromPoints > 0)
            {
                <div class="mt-2 flex items-center gap-1.5 rounded-md bg-emerald-500/10 px-2.5 py-1.5">
                    <span class="text-emerald-600 text-xs dark:text-emerald-400">
                        Saving $@(_dollarsFromPoints).00 with @_pointsToApply.ToString("N0") points
                    </span>
                </div>
            }
        </div>

        @* Remaining points *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-muted-foreground text-xs">
                        Remaining after redemption
                    </span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-medium text-sm tabular-nums">
                            @_remainingPoints.ToString("N0")
                        </span>
                        <span class="text-muted-foreground text-xs">pts</span>
                    </div>
                </div>
                <div class="text-right">
                    <span class="font-medium text-muted-foreground text-xs">Points earned</span>
                    <div class="mt-1 flex items-center gap-1">
                        <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                        <span class="font-medium text-emerald-600 text-sm tabular-nums dark:text-emerald-400">
                            +@_pointsEarned
                        </span>
                        <span class="text-muted-foreground text-xs">pts</span>
                    </div>
                </div>
            </div>
        </div>

        @* Price breakdown *@
        <div class="border-b px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Subtotal</span>
                    <span class="text-xs tabular-nums">$@(_orderSubtotal).00</span>
                </div>
                @if (_dollarsFromPoints > 0)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-emerald-600 text-xs dark:text-emerald-400">
                            Points redemption
                        </span>
                        <span class="text-emerald-600 text-xs tabular-nums dark:text-emerald-400">
                            -$@(_dollarsFromPoints).00
                        </span>
                    </div>
                }
                <div class="flex items-center justify-between border-t pt-1.5">
                    <span class="font-medium text-sm">Amount due</span>
                    <span class="font-semibold text-2xl tabular-nums">$@(_amountDue).00</span>
                </div>
            </div>
        </div>

        @* CTA *@
        <div class="border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                Pay $@(_amountDue).00
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                You will earn @_pointsEarned points from this purchase &middot; @EarnRate x pts per
                dollar
            </p>
        </div>
    </div>
</section>

@code {
    private const int PointsPerDollar = 100;
    private const int EarnRate = 2;

    private readonly int _orderSubtotal = 189;
    private readonly int _pointsBalance = 12400;
    private readonly string _memberTier = "Gold";

    private record CartItem(string Id, string Name, string Variant, int Price);

    private static readonly CartItem[] _cartItems =
    [
        new("1", "Merino Wool Sweater",        "Charcoal / L",  128),
        new("2", "Cotton Crew Socks (3-pack)", "Mixed",          32),
        new("3", "Leather Belt",               "Tan / 34",       29),
    ];

    private int _pointsToApply = 0;

    private int _maxRedeemablePoints => Math.Min(_pointsBalance, _orderSubtotal * PointsPerDollar);
    private int _dollarsFromPoints => (int)Math.Floor((double)_pointsToApply / PointsPerDollar);
    private int _remainingPoints => _pointsBalance - _pointsToApply;
    private int _amountDue => _orderSubtotal - _dollarsFromPoints;
    private int _pointsEarned => (int)Math.Floor((double)_amountDue * EarnRate);
}
