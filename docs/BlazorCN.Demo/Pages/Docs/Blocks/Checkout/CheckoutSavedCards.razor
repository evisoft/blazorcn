@* ============================================================
   Block: checkout-saved-cards
   Title: CheckoutSavedCards
   Description: A checkout block for React and Next.js with saved payment method selection, card brand display with last four digits, expiry dates, radio selection between stored cards, and an expandable add-new-card form built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-saved-cards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="credit-card" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Payment method</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">Select a saved card or add a new one</p>
        </div>

        @* Saved cards list *@
        <div role="radiogroup">
            @foreach (var card in _savedCards)
            {
                var isLast = card.Id == _savedCards[_savedCards.Length - 1].Id && !_showNewCard;
                <span class="@Cn.Merge("flex cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")"
                      role="button"
                      tabindex="0"
                      @onclick="@(() => _selected = card.Id)">
                    <input type="radio"
                           name="saved-card"
                           value="@card.Id"
                           checked="@(_selected == card.Id)"
                           class="accent-primary size-4 cursor-pointer"
                           @onchange="@(() => _selected = card.Id)" />
                    <div class="flex min-w-0 flex-1 items-center justify-between">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@card.Brand</span>
                                <span class="font-mono text-muted-foreground text-xs">
                                    **** @card.Last4
                                </span>
                                @if (card.IsDefault)
                                {
                                    <span class="rounded-full bg-muted px-1.5 py-0.5 text-muted-foreground text-[10px]">
                                        Default
                                    </span>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                Expires @card.ExpMonth/@card.ExpYear
                            </p>
                        </div>
                    </div>
                </span>
            }
        </div>

        @* Add new card toggle *@
        @if (!_showNewCard)
        {
            <div class="border-t">
                <button type="button"
                        class="flex w-full items-center gap-2 px-4 py-3 text-left text-sm transition-colors hover:bg-muted/50"
                        @onclick="@(() => { _showNewCard = true; _selected = "new"; })">
                    <LucideIconCn Name="plus" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-muted-foreground text-sm">Add new card</span>
                </button>
            </div>
        }

        @* New card form *@
        @if (_showNewCard)
        {
            <div class="border-t px-4 py-3">
                <div class="mb-3 flex items-center justify-between">
                    <span class="font-medium text-sm">New card details</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs"
                              @onclick="@(() => { _showNewCard = false; _selected = "pm_1"; })">
                        Cancel
                    </ButtonCn>
                </div>
                <div class="space-y-3">
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">
                            Card number
                        </span>
                        <InputCn Placeholder="1234 5678 9012 3456" Class="h-8 text-sm" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <span class="mb-1 block font-medium text-muted-foreground text-xs">
                                Expiry
                            </span>
                            <InputCn Placeholder="MM / YY" Class="h-8 text-sm" />
                        </div>
                        <div>
                            <span class="mb-1 block font-medium text-muted-foreground text-xs">CVC</span>
                            <InputCn Placeholder="123" Class="h-8 text-sm" />
                        </div>
                    </div>
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">
                            Name on card
                        </span>
                        <InputCn Placeholder="Jane Smith" Class="h-8 text-sm" />
                    </div>
                </div>
            </div>
        }

        @* Order total & pay *@
        <div class="border-t bg-muted/30 px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-muted-foreground text-sm">Total</span>
                <span class="font-semibold text-lg tabular-nums">$149.00</span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                Pay now
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Your payment info is encrypted and secure
            </p>
        </div>
    </div>
</section>

@code {
    private record SavedCard(string Id, string Brand, string Last4, string ExpMonth, string ExpYear, bool IsDefault);

    private static readonly SavedCard[] _savedCards =
    [
        new("pm_1", "Visa",       "4242", "09", "27", true),
        new("pm_2", "Mastercard", "8210", "03", "28", false),
        new("pm_3", "Amex",       "1003", "12", "26", false),
    ];

    private string _selected = "pm_1";
    private bool _showNewCard = false;
}
