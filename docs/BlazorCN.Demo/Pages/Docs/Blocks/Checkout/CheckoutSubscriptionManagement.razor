@* ============================================================
   Block: checkout-subscription-management
   Title: CheckoutSubscriptionManagement
   Description: A subscription management block for React and Next.js with current plan details, upgrade/downgrade options, pause toggle, cancel confirmation, billing history summary, and next billing date using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-subscription-management.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Subscription</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Manage your plan and billing</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @(_isPaused ? "Paused" : "Active")
            </BadgeCn>
        </div>

        @* Current plan *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-muted-foreground text-xs">Current plan</span>
                <div class="mt-0.5 flex items-baseline gap-1">
                    <span class="font-medium text-sm">@_currentPlan.Name</span>
                    <span class="text-muted-foreground text-xs">&middot;</span>
                    <span class="font-mono text-sm tabular-nums">$@_currentPlan.Price</span>
                    <span class="text-muted-foreground text-xs">/@_currentPlan.Interval</span>
                </div>
            </div>
            <div class="text-right">
                <span class="text-muted-foreground text-xs">Next billing</span>
                <p class="mt-0.5 font-medium text-sm">@_nextBillingDate</p>
            </div>
        </div>

        @* Plan options *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-muted-foreground text-xs">Change plan</span>
            <div class="space-y-2">
                @foreach (var plan in _plans)
                {
                    var planItem = plan;
                    var isSelected = _selectedPlan == planItem.Id;
                    var isCurrent = _currentPlanId == planItem.Id;
                    <button
                        type="button"
                        @onclick="@(() => _selectedPlan = planItem.Id)"
                        class="@Cn.Merge("flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left transition-colors", isSelected ? "bg-muted/50 ring-1 ring-border" : "hover:bg-muted/30")"
                    >
                        <div class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border", isSelected ? "border-foreground bg-foreground" : "border-muted-foreground/40")">
                            @if (isSelected)
                            {
                                <LucideIconCn Name="check" Size="10" Class="size-2.5 text-background" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@planItem.Name</span>
                                @if (isCurrent)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        Current
                                    </BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @string.Join(" · ", planItem.Features)
                            </p>
                        </div>
                        <span class="shrink-0 font-mono text-sm tabular-nums">
                            $@planItem.Price<span class="text-muted-foreground text-xs">/@planItem.Interval</span>
                        </span>
                    </button>
                }
            </div>
            @if (_selectedPlan != _currentPlanId)
            {
                <ButtonCn Size="ButtonSize.Sm" Class="mt-3 h-7 text-xs">
                    @((_plans.FirstOrDefault(p => p.Id == _selectedPlan)?.Price ?? 0) > (_currentPlan.Price) ? "Upgrade Plan" : "Downgrade Plan")
                </ButtonCn>
            }
        </div>

        @* Pause subscription *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="pause" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Pause subscription</span>
                    <p class="text-muted-foreground text-xs">Billing will stop until you resume</p>
                </div>
            </div>
            <SwitchCn @bind-Checked="_isPaused" />
        </div>

        @* Billing history *@
        <div class="border-b">
            <div class="px-4 py-2">
                <span class="text-muted-foreground text-xs">Recent billing</span>
            </div>
            @for (var i = 0; i < _billingHistory.Length; i++)
            {
                var entry = _billingHistory[i];
                var isLast = i == _billingHistory.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _statusDot.TryGetValue(entry.Status, out var dot) ? dot : "")" />
                    <span class="text-sm">@entry.Date</span>
                    <span class="ml-auto font-mono text-sm tabular-nums">@entry.Amount</span>
                    <LucideIconCn Name="chevron-right" Size="16" Class="size-4 text-muted-foreground/60" />
                </div>
            }
        </div>

        @* Cancel section *@
        <div class="px-4 py-3">
            @if (_showCancelConfirm)
            {
                <div class="rounded-md bg-muted/50 p-3">
                    <span class="font-medium text-sm">Cancel subscription?</span>
                    <p class="mt-1 text-muted-foreground text-xs">
                        You'll retain access until @_nextBillingDate. After that, your account will revert
                        to the free tier. This cannot be undone.
                    </p>
                    <div class="mt-3 flex items-center gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs text-red-600 hover:bg-red-500/10 hover:text-red-600 dark:text-red-400 dark:hover:text-red-400">
                            Confirm Cancellation
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => _showCancelConfirm = false)">
                            Keep Subscription
                        </ButtonCn>
                    </div>
                </div>
            }
            else
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground" @onclick="@(() => _showCancelConfirm = true)">
                    Cancel subscription
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record Plan(string Id, string Name, int Price, string Interval, string[] Features);

    private record BillingEntry(string Id, string Date, string Amount, string Status);

    private static readonly Plan[] _plans =
    [
        new("starter", "Starter", 19, "mo", ["5 projects", "10 GB storage", "Email support"]),
        new("pro",     "Pro",     49, "mo", ["Unlimited projects", "100 GB storage", "Priority support", "API access"]),
        new("enterprise", "Enterprise", 149, "mo", ["Unlimited everything", "1 TB storage", "Dedicated support", "SSO", "SLA"]),
    ];

    private const string _currentPlanId = "pro";
    private const string _nextBillingDate = "Apr 15, 2026";

    private static readonly BillingEntry[] _billingHistory =
    [
        new("1", "Mar 15, 2026", "$49.00", "paid"),
        new("2", "Feb 15, 2026", "$49.00", "paid"),
        new("3", "Jan 15, 2026", "$49.00", "paid"),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["paid"]    = "bg-emerald-500",
        ["pending"] = "bg-amber-500",
        ["failed"]  = "bg-red-500",
    };

    private Plan _currentPlan => _plans.First(p => p.Id == _currentPlanId);

    private string _selectedPlan = _currentPlanId;
    private bool _isPaused = false;
    private bool _showCancelConfirm = false;
}
