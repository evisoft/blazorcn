@* ============================================================
   Block: checkout-carbon-offset
   Title: CheckoutCarbonOffset
   Description: A React carbon offset add-on block for Next.js checkout with estimated carbon footprint, offset project details, environmental impact stats, and add offset CTA using shadcn/ui Button, Badge, Switch, and Tailwind CSS
   Source: original/blocks/checkout/checkout-carbon-offset.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="leaf" Size="16" Class="size-4 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Carbon Offset</span>
                <p class="text-muted-foreground text-xs">Make your order carbon neutral</p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
                <span class="text-xs text-muted-foreground">@(_enabled ? "Added" : "Off")</span>
                <SwitchCn aria-label="Carbon Offset" Checked="@_enabled" CheckedChanged="@((bool val) => _enabled = val)" />
            </div>
        </div>

        @* Footprint estimate *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">
                Estimated footprint for this order
            </span>
            <div class="mt-2 flex items-center gap-4">
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">@OrderFootprint</span>
                    <span class="text-muted-foreground text-xs">kg CO2</span>
                </div>
                <span class="text-muted-foreground text-xs">=</span>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="mountain" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">Equivalent to a 26 km car trip</span>
                </div>
            </div>
        </div>

        @* Offset projects *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">
                Choose an offset project
            </span>
            <div class="mt-2 space-y-0">
                @foreach (var proj in _projects)
                {
                    var project = proj;
                    var isSelected = _selectedProject == project.Id;
                    var isLast = project.Id == _projects[^1].Id;
                    <label class="@Cn.Merge("flex cursor-pointer items-start gap-3 rounded-md p-2.5 transition-colors", isSelected ? "bg-muted/50" : "hover:bg-muted/30", !isLast ? "mb-1" : "")">
                        <input type="radio"
                               name="offset-project"
                               value="@project.Id"
                               checked="@(isSelected ? "checked" : null)"
                               @onchange="@((ChangeEventArgs _) => _selectedProject = project.Id)"
                               class="mt-1 accent-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="@(project.Icon == "trees" ? "trees" : "wind")" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="font-medium text-sm">@project.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                    @project.Type
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@project.Location</p>
                            <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                                @project.Description
                            </p>
                        </div>
                    </label>
                }
            </div>
        </div>

        @* Community impact *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Community impact</span>
            <div class="mt-2 flex items-center gap-6">
                @foreach (var stat in _communityStats)
                {
                    <div>
                        <span class="font-medium text-sm tabular-nums">@stat.Value</span>
                        <p class="text-muted-foreground text-xs">@stat.Label</p>
                    </div>
                }
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between mb-3">
                <span class="text-muted-foreground text-sm">Offset cost</span>
                <span class="font-medium text-sm tabular-nums">$@OffsetCost.ToString("F2")</span>
            </div>
            <ButtonCn Class="w-full"
                      Variant="@(_enabled ? ButtonVariant.Default : ButtonVariant.Outline)"
                      OnClick="@(() => _enabled = !_enabled)">
                @(_enabled ? "Offset Added — Continue" : $"Add Offset for ${OffsetCost:F2}")
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                100% of offset funds go directly to verified climate projects
            </p>
        </div>
    </div>
</section>

@code {
    private record OffsetProject(string Id, string Name, string Location, string Type, string Description, string Icon);
    private record ImpactStat(string Id, string Label, string Value);

    private const double OrderFootprint = 4.2;
    private const double OffsetCost = 3.49;

    private static readonly OffsetProject[] _projects =
    [
        new("1", "Amazon Reforestation", "Para, Brazil", "Reforestation",
            "Restoring 12,000 hectares of degraded rainforest with native species. Verified by Gold Standard.",
            "trees"),
        new("2", "Patagonia Wind Farm", "Chubut, Argentina", "Renewable Energy",
            "114 MW wind farm displacing fossil fuel generation. Verified by Verra VCS.",
            "wind"),
    ];

    private static readonly ImpactStat[] _communityStats =
    [
        new("1", "Total CO2 offset", "847 tons"),
        new("2", "Orders with offset", "23,419"),
        new("3", "Trees planted", "12,850"),
    ];

    private bool _enabled = false;
    private string _selectedProject = _projects[0].Id;
}
