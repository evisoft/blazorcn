@* ============================================================
   Block: checkout-referral-credit
   Title: CheckoutReferralCredit
   Description: A checkout referral credit application block for React and Next.js with credit balance display, auto-apply toggle, applied credit amount, referral code input for new credits, and invite friends CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-referral-credit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="gift" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Referral Credits</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Apply your referral credits or enter a friend's code for a discount.
            </p>
        </div>

        @* Credit balance *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Credit balance</span>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="font-semibold text-2xl tabular-nums">$@_effectiveBalance.00</span>
                    </div>
                    @if (_addedCredit != null)
                    {
                        <p class="mt-0.5 text-emerald-600 text-xs dark:text-emerald-400">
                            +$@(_addedCredit.Value).00 added from referral code
                        </p>
                    }
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">Auto-apply</span>
                    <SwitchCn Checked="@_applyCredits" CheckedChanged="@((bool v) => _applyCredits = v)" />
                </div>
            </div>
        </div>

        @* Applied credit detail *@
        @if (_applyCredits && _appliedAmount > 0)
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2 rounded-md bg-emerald-500/10 px-2.5 py-2">
                    <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                    <div class="flex-1">
                        <span class="font-medium text-emerald-600 text-xs dark:text-emerald-400">
                            $@_appliedAmount.00 credit applied to this order
                        </span>
                    </div>
                </div>
                @if (_remainingCredit > 0)
                {
                    <p class="mt-1.5 text-muted-foreground text-xs">
                        Remaining credit after purchase: $@_remainingCredit.00
                    </p>
                }
            </div>
        }

        @* Referral code input *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">
                Have a friend's referral code?
            </span>
            <div class="mt-2 flex items-center gap-2">
                <InputCn @bind-Value="_referralCode"
                         type="text"
                         Placeholder="Enter referral code"
                         Class="h-8 font-mono text-xs uppercase"
                         Disabled="@(_addedCredit != null)" />
                <ButtonCn Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Sm"
                          Class="h-8 px-3 text-xs"
                          @onclick="HandleApplyCode"
                          Disabled="@(_referralCode.Trim().Length == 0 || _addedCredit != null)">
                    Redeem
                </ButtonCn>
            </div>
            @if (_error != null)
            {
                <p class="mt-1.5 text-red-600 text-xs dark:text-red-400">@_error</p>
            }
            @if (_addedCredit != null)
            {
                <div class="mt-1.5 flex items-center gap-1.5">
                    <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                    <span class="text-emerald-600 text-xs dark:text-emerald-400">
                        Referral code redeemed &middot; $@(_addedCredit.Value).00 added
                    </span>
                </div>
            }
        </div>

        @* Referral history *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Your referrals</span>
            <div class="mt-2 space-y-1">
                @foreach (var it in _referralHistory)
                {
                    var ref2 = it;
                    <div class="flex items-center gap-2.5 px-1 py-1">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", ref2.Status == "credited" ? "bg-emerald-500" : "bg-amber-500")"></span>
                        <span class="flex-1 text-sm">@ref2.Name</span>
                        <span class="@Cn.Merge("text-xs tabular-nums", ref2.Status == "credited" ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")">
                            @(ref2.Status == "credited" ? $"+${ref2.Amount}.00" : "Pending")
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Invite friends CTA *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <div class="flex items-start gap-2.5">
                    <LucideIconCn Name="users" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                    <div class="flex-1">
                        <span class="font-medium text-sm">
                            Invite friends, earn $@CreditPerReferral
                        </span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Share your link. When a friend makes their first purchase, you both get $@CreditPerReferral in credits.
                        </p>
                        <div class="mt-2 flex items-center gap-2">
                            <span class="flex-1 truncate rounded bg-background px-2 py-1 font-mono text-muted-foreground text-xs">
                                @ReferralLink
                            </span>
                            <ButtonCn Variant="ButtonVariant.Outline"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 gap-1 shrink-0 px-2 text-xs"
                                      @onclick="HandleCopyLink">
                                @if (_linkCopied)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                    @:Copied
                                }
                                else
                                {
                                    <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                    @:Copy
                                }
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Price breakdown *@
        <div class="border-b px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Subtotal</span>
                    <span class="text-xs tabular-nums">$@OrderSubtotal.00</span>
                </div>
                @if (_appliedAmount > 0)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-emerald-600 text-xs dark:text-emerald-400">
                            Referral credit
                        </span>
                        <span class="text-emerald-600 text-xs tabular-nums dark:text-emerald-400">
                            -$@_appliedAmount.00
                        </span>
                    </div>
                }
                <div class="flex items-center justify-between border-t pt-1.5">
                    <span class="font-medium text-sm">Total</span>
                    <span class="font-semibold text-2xl tabular-nums">$@_amountDue.00</span>
                </div>
            </div>
        </div>

        @* CTA *@
        <div class="border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                @(_amountDue > 0 ? $"Pay ${_amountDue}.00" : "Complete Order")
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Referral credits never expire &middot; No limit on referrals
            </p>
        </div>
    </div>
</section>

@code {
    private record ReferralEntry(string Id, string Name, string Status, int Amount);

    private const int CreditBalance = 45;
    private const int CreditPerReferral = 10;
    private const int OrderSubtotal = 89;
    private const string ReferralLink = "https://acme.com/ref/sarah-k";

    private static readonly Dictionary<string, int> _referralCodes = new()
    {
        ["FRIEND-ALEX"] = 10,
        ["FRIEND-MAYA"] = 10,
        ["FRIEND-JORDAN"] = 10,
    };

    private static readonly ReferralEntry[] _referralHistory =
    [
        new("1", "Alex Chen",       "credited", 10),
        new("2", "Maya Rodriguez",  "credited", 10),
        new("3", "Jordan Lee",      "credited", 10),
        new("4", "Sam Taylor",      "pending",  10),
    ];

    private bool _applyCredits = true;
    private string _referralCode = "";
    private string? _error = null;
    private int? _addedCredit = null;
    private bool _linkCopied = false;

    private int _effectiveBalance => CreditBalance + (_addedCredit ?? 0);
    private int _appliedAmount => _applyCredits ? Math.Min(_effectiveBalance, OrderSubtotal) : 0;
    private int _remainingCredit => _effectiveBalance - _appliedAmount;
    private int _amountDue => OrderSubtotal - _appliedAmount;

    private void HandleApplyCode()
    {
        var trimmed = _referralCode.Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(trimmed))
        {
            _error = "Enter a referral code.";
            return;
        }

        if (!_referralCodes.TryGetValue(trimmed, out var reward))
        {
            _error = "Invalid referral code. Ask your friend to double-check it.";
            return;
        }

        _addedCredit = reward;
        _referralCode = "";
        _error = null;
    }

    private async Task HandleCopyLink()
    {
        _linkCopied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _linkCopied = false;
    }
}
