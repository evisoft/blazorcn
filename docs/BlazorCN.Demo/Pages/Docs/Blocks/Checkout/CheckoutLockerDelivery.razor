@* ============================================================
   Block: checkout-locker-delivery
   Title: CheckoutLockerDelivery
   Description: A package locker and pickup point delivery block with locker locations list, map placeholder area, selected locker details, access code notice, and a 3-day pickup window reminder
   Source: original/blocks/checkout/checkout-locker-delivery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Locker Delivery</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Deliver to a package locker near you
                </p>
            </div>
            <LucideIconCn Name="box" Size="16" Class="size-4 text-muted-foreground" />
        </div>

        @* Map placeholder *@
        <div class="border-b px-4 py-3">
            <div class="flex h-32 items-center justify-center rounded-md bg-muted/50">
                <div class="flex flex-col items-center gap-1.5 text-muted-foreground">
                    <LucideIconCn Name="map-pin" Size="20" Class="size-5" />
                    <span class="text-xs">Locker locations near San Francisco, CA</span>
                </div>
            </div>
        </div>

        @* Locker list *@
        <div class="border-b">
            <div class="px-4 pt-3 pb-1.5">
                <span class="font-medium text-muted-foreground text-xs">Nearby locations</span>
            </div>
            <RadioGroupCn @bind-Value="_selectedLocker">
                @foreach (var locker in _lockers)
                {
                    var loc = locker;
                    var isActive = _selectedLocker == loc.Id;
                    var isLast = loc.Id == _lockers[^1].Id;
                    <label for="@loc.Id"
                           class="@Cn.Merge("flex cursor-pointer items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", isActive ? "bg-muted/50" : "")">
                        <div class="pt-0.5">
                            <RadioGroupItemCn Value="@loc.Id" aria-label="@($"Select {loc.Name} pickup locker")" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between">
                                <span class="font-medium text-sm">@loc.Name</span>
                                <span class="shrink-0 text-muted-foreground text-xs">
                                    @loc.Distance
                                </span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@loc.Address</p>
                            <div class="mt-1 flex items-center gap-3">
                                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                    @loc.Compartments
                                </span>
                                <span class="text-muted-foreground text-xs">@loc.Hours</span>
                            </div>
                        </div>
                    </label>
                }
            </RadioGroupCn>
        </div>

        @* Selected locker details *@
        @{
            var chosen = _lockers.FirstOrDefault(l => l.Id == _selectedLocker);
        }
        @if (chosen is not null)
        {
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Selected locker</span>
                <div class="mt-2 rounded-md bg-muted/50 p-3">
                    <span class="font-medium text-sm">@chosen.Name</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@chosen.Address</p>
                    <div class="mt-2 flex items-center gap-3 text-muted-foreground text-xs">
                        <span>@chosen.Hours</span>
                        <span>&middot;</span>
                        <span>@chosen.Compartments</span>
                    </div>
                </div>
            </div>
        }

        @* Access code notice *@
        <div class="flex items-start gap-2 border-b px-4 py-3">
            <LucideIconCn Name="lock" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground/60" />
            <div>
                <span class="font-medium text-sm">Access code</span>
                <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                    A one-time access code will be sent to your email and phone when your package is
                    delivered. Enter the code on the locker keypad to open your compartment.
                </p>
            </div>
        </div>

        @* Pickup window notice *@
        <div class="flex items-start gap-2 border-b px-4 py-3">
            <LucideIconCn Name="info" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground/60" />
            <div>
                <span class="font-medium text-sm">3-day pickup window</span>
                <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                    Collect your package within 3 business days of delivery. After that, it will be
                    returned to the fulfillment center and you will be notified with rebooking options.
                </p>
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                Confirm Locker Delivery
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Delivery in 2-4 business days &middot; Free
            </p>
        </div>
    </div>
</section>

@code {
    private record LockerLocation(string Id, string Name, string Address, string Distance, string Compartments, string Hours);

    private static readonly LockerLocation[] _lockers =
    [
        new("l1", "Central Station Lockers", "50 Fremont St, San Francisco, CA 94105", "0.3 mi", "8 available", "24/7 access"),
        new("l2", "Whole Foods Market — SoMa", "399 4th St, San Francisco, CA 94107", "0.7 mi", "3 available", "7:00 AM - 10:00 PM"),
        new("l3", "GreenBox Pickup Hub", "1200 Van Ness Ave, San Francisco, CA 94109", "1.5 mi", "12 available", "24/7 access"),
        new("l4", "Parkside Community Lockers", "2200 Taraval St, San Francisco, CA 94116", "3.2 mi", "5 available", "6:00 AM - 11:00 PM"),
    ];

    private string _selectedLocker = "l1";
}
