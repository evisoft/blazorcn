@* ============================================================
   Block: checkout-mobile-optimized
   Title: CheckoutMobileOptimized
   Description: A mobile-first checkout form for React and Next.js with large touch targets, stacked full-width inputs, collapsible order summary, and sticky bottom pay bar using shadcn/ui Input, Label, Button, and Tailwind CSS
   Source: original/blocks/checkout/checkout-mobile-optimized.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex overflow-hidden rounded-lg border bg-card flex-col">
        @* Collapsible order summary *@
        <div class="border-b">
            <button
                type="button"
                @onclick="@(() => _summaryOpen = !_summaryOpen)"
                class="flex w-full items-center justify-between px-4 py-3 transition-colors hover:bg-muted/50">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="shopping-bag" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Order summary (@_orderItems.Length items)</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm tabular-nums">$@_total.ToString("F2")</span>
                    <LucideIconCn Name="chevron-down" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground transition-transform duration-200", _summaryOpen ? "rotate-180" : "")" />
                </div>
            </button>

            @if (_summaryOpen)
            {
                <div class="border-t px-4 py-3">
                    @foreach (var item in _orderItems)
                    {
                        var isLast = item.Id == _orderItems[_orderItems.Length - 1].Id;
                        <div class="@Cn.Merge("flex items-center justify-between py-2", isLast ? "" : "border-b")">
                            <div class="min-w-0 flex-1">
                                <span class="text-sm">@item.Name</span>
                                <p class="text-muted-foreground text-xs">
                                    @item.Variant &middot; Qty @item.Quantity
                                </p>
                            </div>
                            <span class="font-medium text-sm tabular-nums">
                                $@((item.Price * item.Quantity).ToString("F2"))
                            </span>
                        </div>
                    }

                    <div class="mt-2 space-y-1 border-t pt-2">
                        <div class="flex justify-between text-xs text-muted-foreground">
                            <span>Subtotal</span>
                            <span class="tabular-nums">$@_subtotal.ToString("F2")</span>
                        </div>
                        <div class="flex justify-between text-xs text-muted-foreground">
                            <span>Shipping</span>
                            <span class="tabular-nums">$@_shipping.ToString("F2")</span>
                        </div>
                        <div class="flex justify-between text-xs text-muted-foreground">
                            <span>Tax</span>
                            <span class="tabular-nums">$@_tax.ToString("F2")</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Contact *@
        <div class="border-b px-4 py-4">
            <span class="font-medium text-sm">Contact</span>
            <div class="mt-3 space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="mob-email" Class="text-xs">Email</LabelCn>
                    <InputCn Id="mob-email" Type="email" Placeholder="@("you@example.com")" Class="h-11" @bind-Value="_email" />
                </div>
            </div>
        </div>

        @* Shipping *@
        <div class="border-b px-4 py-4">
            <span class="font-medium text-sm">Shipping Address</span>
            <div class="mt-3 space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="mob-first" Class="text-xs">First name</LabelCn>
                    <InputCn Id="mob-first" Placeholder="Jane" Class="h-11" @bind-Value="_firstName" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="mob-last" Class="text-xs">Last name</LabelCn>
                    <InputCn Id="mob-last" Placeholder="Smith" Class="h-11" @bind-Value="_lastName" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="mob-address" Class="text-xs">Street address</LabelCn>
                    <InputCn Id="mob-address" Placeholder="123 Main St, Apt 4B" Class="h-11" @bind-Value="_address" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="mob-city" Class="text-xs">City</LabelCn>
                    <InputCn Id="mob-city" Placeholder="San Francisco" Class="h-11" @bind-Value="_city" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="mob-zip" Class="text-xs">Zip code</LabelCn>
                    <InputCn Id="mob-zip" Placeholder="94102" Class="h-11" @bind-Value="_zip" />
                </div>
            </div>
        </div>

        @* Payment *@
        <div class="border-b px-4 py-4">
            <span class="font-medium text-sm">Payment</span>
            <div class="mt-3 space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="mob-card" Class="text-xs">Card number</LabelCn>
                    <InputCn Id="mob-card" Placeholder="4242 4242 4242 4242" Class="h-11" @bind-Value="_cardNumber" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="mob-expiry" Class="text-xs">Expiry</LabelCn>
                        <InputCn Id="mob-expiry" Placeholder="MM / YY" Class="h-11" @bind-Value="_expiry" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="mob-cvv" Class="text-xs">CVV</LabelCn>
                        <InputCn Id="mob-cvv" Placeholder="123" Class="h-11" @bind-Value="_cvv" />
                    </div>
                </div>
            </div>
        </div>

        @* Sticky bottom bar *@
        <div class="sticky bottom-0 border-t bg-card px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-sm">Total</span>
                <span class="font-semibold text-lg tabular-nums">$@_total.ToString("F2")</span>
            </div>
            <ButtonCn Class="h-12 w-full text-base">Pay $@_total.ToString("F2")</ButtonCn>
            <p class="mt-2 flex items-center justify-center gap-1 text-muted-foreground text-xs">
                <LucideIconCn Name="lock" Size="12" Class="size-3" />
                Secure checkout
            </p>
        </div>
    </div>
</section>

@code {
    private bool _summaryOpen = false;
    private string _email = "";
    private string _firstName = "";
    private string _lastName = "";
    private string _address = "";
    private string _city = "";
    private string _zip = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";

    private record OrderItem(string Id, string Name, string Variant, double Price, int Quantity);

    private static readonly OrderItem[] _orderItems =
    [
        new("1", "Ceramic Pour-Over Set", "White / 600ml", 64, 1),
        new("2", "Hand-Ground Coffee 250g", "Ethiopian Yirgacheffe", 22, 2),
        new("3", "Reusable Filter Cone", "Stainless Steel", 18, 1),
    ];

    private static readonly double _subtotal = _orderItems.Sum(i => i.Price * i.Quantity);
    private const double _shipping = 5.99;
    private const double _tax = 11.34;
    private static readonly double _total = _subtotal + _shipping + _tax;
}
