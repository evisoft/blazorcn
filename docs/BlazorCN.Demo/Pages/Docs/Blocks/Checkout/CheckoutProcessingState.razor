@* ============================================================
   Block: checkout-processing-state
   Title: CheckoutProcessingState
   Description: A payment processing state block for React and Next.js with animated spinner, order details summary, progress steps indicator, and a do-not-close notice using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-processing-state.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Processing Payment</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">
                Secure connection
            </BadgeCn>
        </div>

        @* Spinner and message *@
        <div class="flex flex-col items-center border-b px-4 py-8">
            <div class="flex size-12 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="loader" Size="20" Class="size-5 animate-spin text-muted-foreground" />
            </div>
            <p class="mt-4 font-medium text-sm">Processing your payment...</p>
            <p class="mt-1 text-muted-foreground text-xs">This usually takes a few seconds</p>
        </div>

        @* Progress steps *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Progress</span>
            <div class="mt-3 space-y-0">
                @foreach (var step in _steps)
                {
                    var index = Array.IndexOf(_steps, step);
                    var isCompleted = index < _activeStep;
                    var isActive = index == _activeStep;
                    var isPending = index > _activeStep;
                    var isLast = index == _steps.Length - 1;
                    <div class="@Cn.Merge("flex items-start gap-3 py-2.5", !isLast ? "border-b" : "")">
                        <div class="mt-0.5 flex size-5 shrink-0 items-center justify-center">
                            @if (isCompleted)
                            {
                                <span class="flex size-5 items-center justify-center rounded-full bg-emerald-500/10">
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                                </span>
                            }
                            @if (isActive)
                            {
                                <LucideIconCn Name="loader" Size="16" Class="size-4 animate-spin text-foreground" />
                            }
                            @if (isPending)
                            {
                                <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="@Cn.Merge("text-sm", isCompleted ? "text-muted-foreground" : isActive ? "font-medium" : "text-muted-foreground/60")">
                                @step.Label
                            </span>
                            @if (isActive || isCompleted)
                            {
                                <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                            }
                        </div>
                        @if (isCompleted)
                        {
                            <span class="mt-0.5 text-muted-foreground text-xs">Done</span>
                        }
                    </div>
                }
            </div>
        </div>

        @* Order details *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Order details</span>
            <div class="mt-2 space-y-1.5">
                @foreach (var detail in _orderDetails)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground text-sm">@detail.Label</span>
                        <span class="font-medium text-sm tabular-nums">@detail.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Do not close notice *@
        <div class="px-4 py-3">
            <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2.5">
                <LucideIconCn Name="lock" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                <p class="text-muted-foreground text-xs">
                    Please don't close this page or press the back button while your payment is being
                    processed.
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private record ProcessingStep(string Id, string Label, string Description);
    private record OrderDetail(string Label, string Value);

    private static readonly int _activeStep = 2;

    private static readonly ProcessingStep[] _steps =
    [
        new("validate", "Validating payment details", "Checking card information"),
        new("authorize", "Authorizing payment", "Contacting your bank"),
        new("process", "Processing transaction", "Charging $241.28 to Visa ****4242"),
        new("confirm", "Confirming order", "Generating order confirmation"),
    ];

    private static readonly OrderDetail[] _orderDetails =
    [
        new("Order", "#ORD-2849"),
        new("Amount", "$241.28"),
        new("Payment", "Visa ending in 4242"),
        new("Items", "3 items"),
    ];
}
