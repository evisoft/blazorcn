@* ============================================================
   Block: checkout-reward-tier
   Title: CheckoutRewardTier
   Description: A React checkout block for Next.js with loyalty reward tier progress, points earned, next tier benefits, and motivational spending threshold using shadcn/ui Badge, Button, Progress, and Tailwind CSS
   Source: original/blocks/checkout/checkout-reward-tier.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with current tier *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="trophy" Size="16" Class="size-4 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Rewards Program</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                <LucideIconCn Name="star" Size="12" Class="mr-1 size-3" />
                <span class="@_currentTier.Color">@_currentTier.Name</span> Member
            </BadgeCn>
        </div>

        @* Points summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Current balance</span>
                <span class="font-medium text-sm tabular-nums">
                    @CurrentPoints.ToString("N0") pts
                </span>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Points from this order</span>
                <span class="font-medium text-sm tabular-nums text-emerald-600 dark:text-emerald-400">
                    +@PointsFromOrder pts
                </span>
            </div>
            <div class="mt-1.5 flex items-center justify-between border-t pt-1.5">
                <span class="font-medium text-xs">Projected balance</span>
                <span class="font-medium text-sm tabular-nums">
                    @ProjectedPoints.ToString("N0") pts
                </span>
            </div>
        </div>

        @* Progress to next tier *@
        @if (_nextTier != null)
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-muted-foreground text-xs">Progress to @_nextTier.Name</span>
                    <span class="font-mono text-xs tabular-nums">
                        @ProjectedPoints.ToString("N0") / @_nextTier.Threshold.ToString("N0")
                    </span>
                </div>
                <ProgressCn Value="@_progressPercent" Class="h-1.5" aria-label="Progress" />
                @if (_pointsToNext > 0)
                {
                    <p class="mt-2 text-xs text-muted-foreground">
                        <span class="font-medium text-foreground">$@_pointsToNext</span> more to reach @_nextTier.Name!
                    </p>
                }
            </div>
        }

        @* Next tier benefits *@
        @if (_nextTier != null)
        {
            <div class="border-b px-4 py-3">
                <span class="text-xs font-medium text-muted-foreground">
                    @_nextTier.Name benefits you'll unlock
                </span>
                <div class="mt-2 space-y-0">
                    @{
                        var benefitList = _nextTierBenefits.ToList();
                    }
                    @foreach (var it in benefitList)
                    {
                        var benefit = it;
                        var idx = benefitList.IndexOf(benefit);
                        <div class="@Cn.Merge("flex items-center gap-3 py-2", idx < benefitList.Count - 1 ? "border-b" : "")">
                            <LucideIconCn Name="gift" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm">@benefit.Label</span>
                                <p class="text-muted-foreground text-xs">@benefit.Description</p>
                            </div>
                            <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/40" />
                        </div>
                    }
                </div>
            </div>
        }

        @* Order total + CTA *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between mb-3">
                <span class="text-muted-foreground text-sm">Order total</span>
                <span class="font-medium text-sm tabular-nums">$@OrderSubtotal.ToString("F2")</span>
            </div>
            <ButtonCn Class="w-full">Continue to Payment</ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                You'll earn @PointsFromOrder points with this purchase
            </p>
        </div>
    </div>
</section>

@code {
    private record Tier(string Name, int Threshold, string Color);
    private record Benefit(string Id, string Label, string Description);

    private static readonly Tier[] _tiers =
    [
        new("Bronze",  0,    "text-orange-700 dark:text-orange-400"),
        new("Silver",  500,  "text-zinc-500 dark:text-zinc-400"),
        new("Gold",    1500, "text-amber-600 dark:text-amber-400"),
        new("Platinum",5000, "text-indigo-600 dark:text-indigo-400"),
    ];

    private const int CurrentPoints = 1285;
    private const double OrderSubtotal = 199.99;
    private const int PointsFromOrder = 200;
    private const int ProjectedPoints = CurrentPoints + PointsFromOrder;

    private static readonly Benefit[] _nextTierBenefits =
    [
        new("1", "Free express shipping",  "On all orders, no minimum"),
        new("2", "10% member discount",    "Applied automatically at checkout"),
        new("3", "Early access to sales",  "48-hour head start on new drops"),
        new("4", "Birthday bonus points",  "500 bonus points on your birthday"),
    ];

    private int _currentTierIndex => _tiers.Select((t, i) => new { t, i })
        .Where(x => CurrentPoints >= x.t.Threshold)
        .Select(x => x.i)
        .DefaultIfEmpty(0)
        .Last();

    private Tier _currentTier => _tiers[_currentTierIndex];
    private Tier? _nextTier => _currentTierIndex + 1 < _tiers.Length ? _tiers[_currentTierIndex + 1] : null;

    private int _pointsToNext => _nextTier != null ? _nextTier.Threshold - ProjectedPoints : 0;

    private double _progressPercent => _nextTier != null
        ? Math.Min(
            ((double)(ProjectedPoints - _currentTier.Threshold) / (_nextTier.Threshold - _currentTier.Threshold)) * 100,
            100)
        : 100;
}
