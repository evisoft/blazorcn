@* ============================================================
   Block: checkout-language-selector
   Title: CheckoutLanguageSelector
   Description: A multilingual checkout block for React and Next.js with language toggle switching between English, Spanish, and French, right-to-left layout indicator, localized address format, and locale-driven currency display using shadcn/ui Select, Input, Label, Button, and Tailwind CSS
   Source: original/blocks/checkout/checkout-language-selector.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with language selector *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">@_t["checkout"]</span>
            <div class="ml-auto">
                <SelectCn @bind-Value="_lang">
                    <SelectTriggerCn class="h-7 w-[140px] text-xs" aria-label="@_t["language"]">
                        <SelectValueCn Placeholder="Language" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var loc in _locales)
                        {
                            var locItem = loc;
                            <SelectItemCn Value="@locItem.Code" Class="text-xs">@locItem.NativeName (@locItem.Code.ToUpper())</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Locale info *@
        @if (_lang != "en")
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                    <LucideIconCn Name="info" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                    <div class="space-y-1">
                        <p class="text-xs leading-relaxed">@_t["addressFormat"]</p>
                        <p class="text-xs text-muted-foreground">
                            @_locale.Currency (@_locale.CurrencySymbol) · @_locale.Dir.ToUpper() layout
                        </p>
                    </div>
                </div>
            </div>
        }

        @* Contact section *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-sm">@_t["contact"]</span>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="ls-name" Class="text-xs">@_t["fullName"]</LabelCn>
                    <InputCn id="ls-name" Placeholder="@_t["namePlaceholder"]" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="ls-email" Class="text-xs">@_t["email"]</LabelCn>
                    <InputCn id="ls-email" Type="email" Placeholder="@_t["emailPlaceholder"]" />
                </div>
            </div>
        </div>

        @* Shipping address — localized field order *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-sm">@_t["shippingAddress"]</span>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="ls-street" Class="text-xs">@_t["street"]</LabelCn>
                    <InputCn id="ls-street" Placeholder="@_t["streetPlaceholder"]" />
                </div>

                @if (_isPostalBeforeCity)
                {
                    <div class="grid grid-cols-3 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="ls-postal" Class="text-xs">@_t["postalCode"]</LabelCn>
                            <InputCn id="ls-postal" Placeholder="@_t["postalPlaceholder"]" />
                        </div>
                        <div class="col-span-2 space-y-1.5">
                            <LabelCn For="ls-city" Class="text-xs">@_t["city"]</LabelCn>
                            <InputCn id="ls-city" Placeholder="@_t["cityPlaceholder"]" />
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="ls-state" Class="text-xs">@_t["state"]</LabelCn>
                            <InputCn id="ls-state" Placeholder="@_t["statePlaceholder"]" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="ls-country" Class="text-xs">@_t["country"]</LabelCn>
                            <InputCn id="ls-country" Placeholder="@_t["countryPlaceholder"]" />
                        </div>
                    </div>
                }
                else
                {
                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="ls-city" Class="text-xs">@_t["city"]</LabelCn>
                            <InputCn id="ls-city" Placeholder="@_t["cityPlaceholder"]" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="ls-state" Class="text-xs">@_t["state"]</LabelCn>
                            <InputCn id="ls-state" Placeholder="@_t["statePlaceholder"]" />
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="ls-postal" Class="text-xs">@_t["postalCode"]</LabelCn>
                            <InputCn id="ls-postal" Placeholder="@_t["postalPlaceholder"]" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="ls-country" Class="text-xs">@_t["country"]</LabelCn>
                            <InputCn id="ls-country" Placeholder="@_t["countryPlaceholder"]" />
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Payment section *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-sm">@_t["payment"]</span>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="ls-card" Class="text-xs">@_t["cardNumber"]</LabelCn>
                    <InputCn id="ls-card" Placeholder="@_t["cardPlaceholder"]" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="ls-expiry" Class="text-xs">@_t["expiry"]</LabelCn>
                        <InputCn id="ls-expiry" Placeholder="@_t["expiryPlaceholder"]" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="ls-cvv" Class="text-xs">@_t["cvv"]</LabelCn>
                        <InputCn id="ls-cvv" Placeholder="@_t["cvvPlaceholder"]" />
                    </div>
                </div>
            </div>
        </div>

        @* Totals *@
        <div class="border-b px-4 py-3 space-y-1.5">
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">@_t["subtotal"]</span>
                <span class="tabular-nums">@FormatPrice(_priceUsd)</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">@_t["shipping"]</span>
                <span class="tabular-nums">@FormatPrice(_shippingUsd)</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">@_t["tax"]</span>
                <span class="tabular-nums">@FormatPrice(_taxUsd)</span>
            </div>
            <div class="flex justify-between text-sm font-medium pt-1.5 border-t">
                <span>@_t["total"]</span>
                <span class="tabular-nums">@FormatPrice(_totalUsd)</span>
            </div>
        </div>

        @* Pay button *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">
                @_t["payNow"] — @FormatPrice(_totalUsd)
            </ButtonCn>
            <p class="mt-2 flex items-center justify-center gap-1 text-muted-foreground text-xs">
                <LucideIconCn Name="lock" Size="12" Class="size-3" />
                @_t["secure"]
            </p>
        </div>
    </div>
</section>

@code {
    private string _lang = "en";

    private const double _priceUsd = 149.0;
    private const double _shippingUsd = 12.0;
    private const double _taxUsd = 14.49;
    private const double _totalUsd = _priceUsd + _shippingUsd + _taxUsd;
    private const double _eurRate = 0.92;

    private record LocaleConfig(string Code, string Name, string NativeName, string Currency, string CurrencySymbol, string Dir);

    private static readonly LocaleConfig[] _locales =
    [
        new("en", "English", "English", "USD", "$", "ltr"),
        new("es", "Spanish", "Español", "EUR", "€", "ltr"),
        new("fr", "French", "Français", "EUR", "€", "ltr"),
    ];

    private LocaleConfig _locale => Array.Find(_locales, l => l.Code == _lang) ?? _locales[0];
    private Dictionary<string, string> _t => _translations[_lang];
    private bool _isPostalBeforeCity => _lang == "fr" || _lang == "es";

    private string FormatPrice(double usd)
    {
        if (_locale.Currency == "USD")
            return $"${usd:F2}";
        var converted = usd * _eurRate;
        return $"{_locale.CurrencySymbol}{converted:F2}";
    }

    private static readonly Dictionary<string, Dictionary<string, string>> _translations = new()
    {
        ["en"] = new()
        {
