@* ============================================================
   Block: checkout-hotel-reservation
   Title: CheckoutHotelReservation
   Description: A hotel reservation checkout block for React and Next.js with hotel name, room type, check-in and check-out dates, guest count, nightly rate, extras selection, and cancellation policy notice built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-hotel-reservation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bed-double" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Hotel Reservation</span>
            </div>
        </div>

        @* Hotel and room info *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">@_hotel.Name</p>
            <p class="mt-0.5 text-muted-foreground text-xs">@_hotel.Location</p>
            <div class="mt-2 flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_hotel.RoomType</BadgeCn>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_hotel.RoomDescription</BadgeCn>
            </div>
        </div>

        @* Dates and guests *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-4">
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Check-in</span>
                    <div class="mt-1 flex items-center gap-1.5">
                        <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-sm">@_hotel.CheckIn</span>
                    </div>
                </div>
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Check-out</span>
                    <div class="mt-1 flex items-center gap-1.5">
                        <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-sm">@_hotel.CheckOut</span>
                    </div>
                </div>
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Guests</span>
                    <div class="mt-1 flex items-center gap-1.5">
                        <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-sm">@_hotel.Guests adults</span>
                    </div>
                </div>
            </div>
            <p class="mt-2 text-muted-foreground text-xs">
                @_hotel.Nights nights · $@_hotel.RatePerNight/night
            </p>
        </div>

        @* Extras *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Add extras</span>
            <div class="mt-2 space-y-1.5">
                @foreach (var extra in _extras)
                {
                    var ext = extra;
                    var isSelected = _selectedExtras.Contains(ext.Id);
                    var priceLabel = ext.Id == "late-checkout" ? $"${ext.Price}" : $"${ext.Price}/night";
                    <div class="@Cn.Merge("flex items-center gap-3 rounded-md px-3 py-2 transition-colors", isSelected ? "bg-muted/50" : "")">
                        <LucideIconCn Name="@ext.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm">@ext.Name</span>
                            <p class="text-muted-foreground text-xs">@ext.Description</p>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs tabular-nums">@priceLabel</span>
                        <SwitchCn aria-label="@ext.Name" Checked="@isSelected" CheckedChanged="@((val) => ToggleExtra(ext.Id))" />
                    </div>
                }
            </div>
        </div>

        @* Price breakdown *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Price breakdown</span>
            <div class="mt-2 space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">Room (@_hotel.Nights nights x $@_hotel.RatePerNight)</span>
                    <span class="text-sm tabular-nums">$@_roomSubtotal</span>
                </div>
                @if (_extrasCost > 0)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-muted-foreground text-sm">Extras</span>
                        <span class="text-sm tabular-nums">$@_extrasCost</span>
                    </div>
                }
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">Taxes &amp; resort fee (12%)</span>
                    <span class="text-sm tabular-nums">$@_taxes</span>
                </div>
                <SeparatorCn />
                <div class="flex items-center justify-between">
                    <span class="font-medium text-sm">Total</span>
                    <span class="font-semibold text-sm tabular-nums">$@_total</span>
                </div>
            </div>
        </div>

        @* Cancellation policy *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <span class="font-medium text-muted-foreground text-xs">Cancellation policy</span>
                <p class="mt-1 text-sm leading-relaxed">
                    Free cancellation until Aug 5, 2026. Cancellations after this date will be charged the
                    first night's rate of $@_hotel.RatePerNight. No-shows are charged the full stay.
                </p>
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">Reserve room</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record HotelData(
        string Name,
        string Location,
        string RoomType,
        string RoomDescription,
        string CheckIn,
        string CheckOut,
        int Nights,
        int Guests,
        int RatePerNight
    );

    private record ExtraItem(string Id, string Name, string Description, int Price, string Icon);

    private static readonly HotelData _hotel = new(
        Name: "The Strand Hotel & Spa",
        Location: "Charleston, SC",
        RoomType: "Deluxe King Suite",
        RoomDescription: "Ocean view, king bed, balcony, 45 sqm",
        CheckIn: "Aug 8, 2026",
        CheckOut: "Aug 12, 2026",
        Nights: 4,
        Guests: 2,
        RatePerNight: 289
    );

    private static readonly ExtraItem[] _extras =
    [
        new("breakfast", "Daily breakfast", "Buffet breakfast for 2 guests", 35, "coffee"),
        new("parking", "Valet parking", "Covered garage, in/out privileges", 28, "car"),
        new("late-checkout", "Late checkout", "Extend checkout to 2:00 PM", 50, "moon"),
    ];

    private const double _taxRate = 0.12;

    private List<string> _selectedExtras = ["breakfast"];

    private int _roomSubtotal => _hotel.RatePerNight * _hotel.Nights;

    private int _extrasCost =>
        _extras
            .Where(e => _selectedExtras.Contains(e.Id))
            .Sum(e => e.Id == "late-checkout" ? e.Price : e.Price * _hotel.Nights);

    private int _taxes => (int)Math.Round(_roomSubtotal * _taxRate);

    private int _total => _roomSubtotal + _extrasCost + _taxes;

    private void ToggleExtra(string id)
    {
        if (_selectedExtras.Contains(id))
            _selectedExtras = _selectedExtras.Where(e => e != id).ToList();
        else
            _selectedExtras = [.. _selectedExtras, id];
    }
}
