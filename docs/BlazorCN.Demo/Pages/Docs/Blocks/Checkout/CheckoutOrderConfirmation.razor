@* ============================================================
   Block: checkout-order-confirmation
   Title: CheckoutOrderConfirmation
   Description: A post-checkout order confirmation page with success indicator, order number, thank you message, order summary, shipping address, estimated delivery, and action buttons
   Source: original/blocks/checkout/checkout-order-confirmation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Success header *@
        <div class="border-b px-4 py-6 text-center">
            <div class="mx-auto mb-3 flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                <LucideIconCn Name="check" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
            </div>
            <p class="font-medium text-sm">Thank you for your order</p>
            <p class="mt-1 text-muted-foreground text-xs">
                Confirmation sent to john.doe@@email.com
            </p>
            <p class="mt-2 font-mono text-muted-foreground text-xs">@_orderNumber</p>
        </div>

        @* Order items *@
        <div class="border-b">
            <div class="px-4 py-2.5">
                <span class="font-medium text-muted-foreground text-xs">Order summary</span>
            </div>
            @{
                var itemList = _items.ToList();
            }
            @foreach (var it in itemList)
            {
                var item = it;
                var isLast = itemList.IndexOf(item) == itemList.Count - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucideIconCn Name="shopping-bag" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@item.Name</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @item.Variant &middot; Qty @item.Quantity
                        </p>
                    </div>
                    <span class="shrink-0 font-medium text-sm tabular-nums">
                        $@((item.Price * item.Quantity).ToString("F2"))
                    </span>
                </div>
            }
        </div>

        @* Totals *@
        <div class="border-b px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Subtotal</span>
                    <span class="tabular-nums">$@_subtotal.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Shipping</span>
                    <span class="tabular-nums">@(_shipping == 0 ? "Free" : $"${_shipping:F2}")</span>
                </div>
                @if (_discount > 0)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-emerald-600 dark:text-emerald-400">Discount</span>
                        <span class="tabular-nums text-emerald-600 dark:text-emerald-400">
                            -$@_discount.ToString("F2")
                        </span>
                    </div>
                }
                <div class="flex items-center justify-between border-t pt-2">
                    <span class="font-medium text-sm">Total paid</span>
                    <span class="font-semibold text-sm tabular-nums">$@_total.ToString("F2")</span>
                </div>
            </div>
        </div>

        @* Shipping details *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        Shipping address
                    </span>
                    <p class="text-sm">@_address.Name</p>
                    <p class="text-muted-foreground text-xs">@_address.Line1</p>
                    <p class="text-muted-foreground text-xs">@_address.Line2</p>
                    <p class="text-muted-foreground text-xs">
                        @_address.City, @_address.State @_address.Zip
                    </p>
                    <p class="text-muted-foreground text-xs">@_address.Country</p>
                </div>
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        Estimated delivery
                    </span>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="package" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-sm">Apr 2 - Apr 5</span>
                    </div>
                    <p class="mt-1 text-muted-foreground text-xs">Standard shipping via USPS</p>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="flex gap-2 px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1 text-xs">
                Continue Shopping
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="flex-1 text-xs">
                Track Order
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record OrderItem(string Id, string Name, string Variant, int Quantity, double Price);

    private record ShippingAddress(string Name, string Line1, string Line2, string City, string State, string Zip, string Country);

    private static readonly string _orderNumber = "ORD-2847-FKXN";

    private static readonly OrderItem[] _items =
    [
        new("1", "Merino Wool Sweater", "Charcoal / M",    1, 89.99),
        new("2", "Slim Fit Chinos",     "Navy / 32x32",    2, 59.99),
    ];

    private static readonly double _subtotal = 209.97;
    private static readonly double _shipping = 0;
    private static readonly double _discount = 41.99;
    private static readonly double _total    = 167.98;

    private static readonly ShippingAddress _address = new(
        Name:    "John Doe",
        Line1:   "123 Main Street",
        Line2:   "Apt 4B",
        City:    "San Francisco",
        State:   "CA",
        Zip:     "94102",
        Country: "United States"
    );
}
