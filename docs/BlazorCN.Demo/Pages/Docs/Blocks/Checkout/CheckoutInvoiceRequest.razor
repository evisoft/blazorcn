@* ============================================================
   Block: checkout-invoice-request
   Title: CheckoutInvoiceRequest
   Description: A B2B pay-by-invoice checkout block for React and Next.js with company name, VAT number, PO number fields, invoice delivery email, payment terms selector, and billing contact form built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-invoice-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Request Invoice</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Pay by invoice for your $@(_orderTotal.ToString("F2")) order. We will send a PDF invoice to
                your accounts payable team.
            </p>
        </div>

        @* Company details *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="building" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Company details</span>
            </div>
            <div class="mt-3 space-y-3">
                <div>
                    <LabelCn Class="text-xs font-medium text-muted-foreground">Company name</LabelCn>
                    <InputCn Class="mt-1 h-8 text-sm" Placeholder="Acme Corporation" @bind-Value="_companyName" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <LabelCn Class="text-xs font-medium text-muted-foreground">VAT number</LabelCn>
                        <InputCn Class="mt-1 h-8 font-mono text-sm" Placeholder="DE123456789" @bind-Value="_vatNumber" />
                    </div>
                    <div>
                        <LabelCn Class="text-xs font-medium text-muted-foreground">PO number</LabelCn>
                        <InputCn Class="mt-1 h-8 font-mono text-sm" Placeholder="PO-2026-0001" @bind-Value="_poNumber" />
                    </div>
                </div>
            </div>
        </div>

        @* Invoice delivery *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Invoice delivery</span>
            <div class="mt-3">
                <LabelCn Class="text-xs font-medium text-muted-foreground">Invoice email</LabelCn>
                <InputCn Type="email" Class="mt-1 h-8 text-sm" Placeholder="@("accounts@company.com")" @bind-Value="_invoiceEmail" />
                <p class="mt-1 text-muted-foreground text-xs">
                    PDF invoice will be sent to this address.
                </p>
            </div>
        </div>

        @* Payment terms *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Payment terms</span>
            <div class="mt-3">
                <SelectCn @bind-Value="_paymentTerms">
                    <SelectTriggerCn Class="h-8 text-sm">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var term in _termOptions)
                        {
                            <SelectItemCn Value="@term.Value" Class="text-sm">@term.Label</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
                @{
                    var selectedTerm = Array.Find(_termOptions, t => t.Value == _paymentTerms);
                }
                @if (selectedTerm != null && selectedTerm.Days > 0)
                {
                    <p class="mt-1.5 text-muted-foreground text-xs">
                        Payment due @selectedTerm.Days days from invoice date.
                    </p>
                }
            </div>
        </div>

        @* Billing contact *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Billing contact</span>
            <div class="mt-3 grid grid-cols-2 gap-3">
                <div>
                    <LabelCn Class="text-xs font-medium text-muted-foreground">Contact name</LabelCn>
                    <InputCn Class="mt-1 h-8 text-sm" Placeholder="Jane Doe" @bind-Value="_contactName" />
                </div>
                <div>
                    <LabelCn Class="text-xs font-medium text-muted-foreground">Phone number</LabelCn>
                    <InputCn Type="tel" Class="mt-1 h-8 text-sm" Placeholder="+1 (555) 000-0000" @bind-Value="_contactPhone" />
                </div>
            </div>
        </div>

        @* Invoice preview *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <span class="font-medium text-muted-foreground text-xs">Invoice summary</span>
                <div class="mt-2 space-y-1">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Bill to</span>
                        <span class="text-xs">@(string.IsNullOrEmpty(_companyName) ? "—" : _companyName)</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">PO reference</span>
                        <span class="font-mono text-xs">@(string.IsNullOrEmpty(_poNumber) ? "—" : _poNumber)</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-muted-foreground">Terms</span>
                        @{
                            var summaryTerm = Array.Find(_termOptions, t => t.Value == _paymentTerms);
                        }
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @(summaryTerm?.Label ?? "—")
                        </BadgeCn>
                    </div>
                    <div class="flex items-center justify-between border-t pt-1.5">
                        <span class="font-medium text-sm">Amount due</span>
                        <span class="font-semibold text-sm tabular-nums">$@(_orderTotal.ToString("F2"))</span>
                    </div>
                </div>
            </div>
        </div>

        @* Submit *@
        <div class="px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                Request Invoice
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Invoice will be sent within 1 business day &middot; Subject to credit approval
            </p>
        </div>
    </div>
</section>

@code {
    private const double _orderTotal = 2849.0;

    private string _companyName = "Acme Corporation";
    private string _vatNumber = "DE123456789";
    private string _poNumber = "PO-2026-0847";
    private string _invoiceEmail = "accounts@acme.com";
    private string _paymentTerms = "net-30";
    private string _contactName = "Sarah Chen";
    private string _contactPhone = "+1 (555) 234-5678";

    private record TermOption(string Value, string Label, int Days);

    private static readonly TermOption[] _termOptions =
    [
        new("net-15", "Net 15", 15),
        new("net-30", "Net 30", 30),
        new("net-60", "Net 60", 60),
        new("net-90", "Net 90", 90),
        new("due-receipt", "Due on Receipt", 0),
    ];
}
