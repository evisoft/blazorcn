@* ============================================================
   Block: checkout-shipping-options
   Title: CheckoutShippingOptions
   Description: A shipping method selection block with radio options for Standard, Express, and Overnight delivery including delivery estimates and pricing
   Source: original/blocks/checkout/checkout-shipping-options.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Shipping Method</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Choose how you'd like your order delivered
            </p>
        </div>

        @* Shipping options *@
        <div class="border-b">
            @foreach (var it in _shippingMethods)
            {
                var method = it;
                var isActive = _selected == method.Id;
                var isLast = Array.IndexOf(_shippingMethods, method) == _shippingMethods.Length - 1;
                <label for="@($"so-{method.Id}")"
                      class="@Cn.Merge("flex cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", isActive ? "bg-muted/50" : "")">
                    <input id="@($"so-{method.Id}")" aria-label="@method.Label" type="radio"
                           name="shipping"
                           value="@method.Id"
                           checked="@isActive"
                           class="size-4 shrink-0 accent-foreground"
                           @onchange="@(() => _selected = method.Id)" />
                    <LucideIconCn Name="@method.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@method.Label</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@method.Description</p>
                    </div>
                    <div class="shrink-0 text-right">
                        <span class="font-medium text-sm">
                            @(method.Price == 0 ? "Free" : $"${method.Price:F2}")
                        </span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@method.Estimate</p>
                    </div>
                </label>
            }
        </div>

        @* Summary *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between text-muted-foreground text-xs">
                <span>Subtotal</span>
                <span>$@_subtotal.ToString("F2")</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-muted-foreground text-xs">
                <span>Shipping</span>
                <span>@(_shippingCost == 0 ? "Free" : $"${_shippingCost:F2}")</span>
            </div>
            <div class="mt-2 flex items-center justify-between border-t pt-2">
                <span class="font-medium text-sm">Total</span>
                <span class="font-semibold text-sm tabular-nums">$@_total.ToString("F2")</span>
            </div>
            <ButtonCn Class="mt-3 w-full" Size="ButtonSize.Sm">Continue to Payment</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ShippingMethod(string Id, string Label, string Description, double Price, string Estimate, string IconName);

    private static readonly ShippingMethod[] _shippingMethods =
    [
        new("standard",  "Standard Shipping",  "Delivered by postal service",    0.00,  "5-7 business days",  "package"),
        new("express",   "Express Shipping",   "Priority handling and tracking",  9.99,  "2-3 business days",  "truck"),
        new("overnight", "Overnight Shipping", "Next business day delivery",     24.99,  "Next business day",  "zap"),
    ];

    private const double _subtotal = 149.97;

    private string _selected = "standard";

    private double _shippingCost => _shippingMethods.FirstOrDefault(m => m.Id == _selected)?.Price ?? 0;
    private double _total => _subtotal + _shippingCost;
}
