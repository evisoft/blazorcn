        @* Divider *@
        <div class="flex items-center gap-3 px-4 py-3">
            <div class="h-px flex-1 bg-border"></div>
            <span class="text-muted-foreground text-xs">Or pay with card</span>
            <div class="h-px flex-1 bg-border"></div>
        </div>

        @* Card form *@
        <div class="space-y-3 border-b px-4 pb-4">
            <div class="space-y-1.5">
                <LabelCn For="express-email" Class="text-xs text-muted-foreground">
                    Email
                </LabelCn>
                <InputCn Id="express-email" Type="email" Placeholder="@("you@example.com")" Class="h-9" />
            </div>
            <div class="space-y-1.5">
                <LabelCn For="express-card" Class="text-xs text-muted-foreground">
                    Card number
                </LabelCn>
                <div class="relative">
                    <InputCn
                        Id="express-card"
                        Placeholder="1234 1234 1234 1234"
                        @bind-Value="_cardNumber"
                        Class="h-9 pr-10" />
                    <LucideIconCn Name="credit-card" Size="16" Class="absolute top-1/2 right-3 size-4 -translate-y-1/2 text-muted-foreground/60" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1.5">
                    <LabelCn For="express-expiry" Class="text-xs text-muted-foreground">
                        Expiry
                    </LabelCn>
                    <InputCn
                        Id="express-expiry"
                        Placeholder="MM / YY"
                        @bind-Value="_expiry"
                        Class="h-9" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="express-cvc" Class="text-xs text-muted-foreground">
                        CVC
                    </LabelCn>
                    <InputCn
                        Id="express-cvc"
                        Placeholder="123"
                        @bind-Value="_cvc"
                        Class="h-9" />
                </div>
            </div>
        </div>

        @* Order summary + CTA *@
        <div class="px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Total</span>
                <span class="font-semibold text-sm tabular-nums">$49.00</span>
            </div>
            <ButtonCn Class="h-10 w-full text-sm">
                <LucideIconCn Name="lock" Size="14" Class="mr-1.5 size-3.5" />
                Pay $49.00
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Secured by 256-bit SSL encryption
            </p>
        </div>
    </div>
</section>

@code {
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvc = "";
}
