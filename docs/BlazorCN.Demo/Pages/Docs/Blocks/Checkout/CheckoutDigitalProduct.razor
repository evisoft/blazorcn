@* ============================================================
   Block: checkout-digital-product
   Title: CheckoutDigitalProduct
   Description: Digital product checkout block for React and Next.js with product details, instant download badge, email delivery field, payment form, and license agreement using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-digital-product.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Purchase</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Digital product — no shipping required
            </p>
        </div>

        @* Product details *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between gap-4">
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">@_product.Name</span>
                    <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                        @_product.Description
                    </p>
                    <div class="mt-2 flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                            <LucideIconCn Name="download" Size="12" Class="size-3" />
                            Instant download
                        </BadgeCn>
                        <span class="text-muted-foreground text-xs">
                            @_product.Format · @_product.Size
                        </span>
                    </div>
                </div>
                <span class="shrink-0 font-semibold text-lg tabular-nums">$@_product.Price</span>
            </div>
        </div>

        @* Email for delivery *@
        <div class="border-b px-4 py-4">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Delivery email
            </span>
            <div class="relative">
                <InputCn Id="digital-email"
                         Type="email"
                         Placeholder="@("you@example.com")"
                         @bind-Value="_email"
                         Class="h-9 pr-10" />
                <LucideIconCn Name="mail" Size="16" Class="absolute top-1/2 right-3 size-4 -translate-y-1/2 text-muted-foreground/60" />
            </div>
            <p class="mt-1.5 text-muted-foreground text-xs">
                Download link will be sent to this address
            </p>
        </div>

        @* Payment form *@
        <div class="space-y-3 border-b px-4 py-4">
            <span class="font-medium text-muted-foreground text-xs">Payment details</span>
            <div class="space-y-1.5">
                <LabelCn For="digital-card" Class="text-xs text-muted-foreground">
                    Card number
                </LabelCn>
                <div class="relative">
                    <InputCn Id="digital-card"
                             Placeholder="1234 1234 1234 1234"
                             @bind-Value="_cardNumber"
                             Class="h-9 pr-10" />
                    <LucideIconCn Name="credit-card" Size="16" Class="absolute top-1/2 right-3 size-4 -translate-y-1/2 text-muted-foreground/60" />
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div class="space-y-1.5">
                    <LabelCn For="digital-expiry" Class="text-xs text-muted-foreground">
                        Expiry
                    </LabelCn>
                    <InputCn Id="digital-expiry"
                             Placeholder="MM / YY"
                             @bind-Value="_expiry"
                             Class="h-9" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="digital-cvc" Class="text-xs text-muted-foreground">
                        CVC
                    </LabelCn>
                    <InputCn Id="digital-cvc"
                             Placeholder="123"
                             @bind-Value="_cvc"
                             Class="h-9" />
                </div>
            </div>
        </div>

        @* License agreement + CTA *@
        <div class="px-4 py-3">
            <span class="mb-3 flex cursor-pointer items-start gap-2"
                  role="button"
                  tabindex="0"
                  @onclick="@(() => _agreed = !_agreed)">
                <CheckboxCn @bind-Checked="_agreed" Class="mt-0.5" />
                <span class="text-muted-foreground text-xs leading-relaxed">
                    I agree to the license terms. This product is for personal and commercial use.
                    Redistribution of source files is prohibited.
                </span>
            </span>
            <div class="mb-3 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Total</span>
                <span class="font-semibold text-sm tabular-nums">$@(_product.Price).00</span>
            </div>
            <ButtonCn Class="h-10 w-full text-sm" Disabled="@(!_agreed)">
                <LucideIconCn Name="lock" Size="14" Class="mr-1.5 size-3.5" />
                Purchase — $@(_product.Price).00
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Instant access after payment
            </p>
        </div>
    </div>
</section>

@code {
    private string _email = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvc = "";
    private bool _agreed = false;

    private record ProductInfo(string Name, string Description, int Price, string Format, string Size);

    private static readonly ProductInfo _product = new(
        "Complete Design System Kit",
        "450+ production-ready components, design tokens, and documentation templates for Figma and code.",
        79,
        "Figma + ZIP",
        "24 MB"
    );
}
