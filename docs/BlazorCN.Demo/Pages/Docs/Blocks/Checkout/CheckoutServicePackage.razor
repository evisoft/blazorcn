@* ============================================================
   Block: checkout-service-package
   Title: CheckoutServicePackage
   Description: A service package checkout for React and Next.js with package description, included services checklist, add-on services, project timeline, deposit or full payment option, and service agreement using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-service-package.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <span class="font-medium text-sm">Service Package</span>
        </div>

        @* Package info *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">@_packageName</span>
            <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                @_packageDescription
            </p>
            <div class="mt-2 flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">
                    $@(_packagePrice.ToString("N0"))
                </span>
                <span class="text-muted-foreground text-xs">base price</span>
            </div>
        </div>

        @* Included services *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Included services</span>
            <div class="mt-2 space-y-1.5">
                @foreach (var svc in _includedServices)
                {
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5 shrink-0 text-emerald-500" />
                        <span class="text-sm">@svc</span>
                    </div>
                }
            </div>
        </div>

        @* Add-on services *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Add-on services</span>
            <div class="mt-2 space-y-2">
                @foreach (var it in _addOns)
                {
                    var addOn = it;
                    var isSelected = _selectedAddOns.Contains(addOn.Id);
                    <span class="@Cn.Merge("flex cursor-pointer items-start gap-3 rounded-md border px-3 py-2.5 transition-colors", isSelected ? "border-foreground/20 bg-muted/30" : "hover:bg-muted/50")"
                          role="checkbox"
                          aria-checked="@(isSelected ? "true" : "false")"
                          tabindex="0"
                          @onclick="@(() => ToggleAddOn(addOn.Id))">
                        <CheckboxCn Checked="@isSelected"
                                    CheckedChanged="@(_ => ToggleAddOn(addOn.Id))"
                                    Class="mt-0.5" />
                        <span class="min-w-0 flex-1">
                            <span class="block text-sm">@addOn.Label</span>
                            <span class="block text-muted-foreground text-xs">@addOn.Description</span>
                        </span>
                        <span class="shrink-0 font-medium text-sm tabular-nums">
                            +$@addOn.Price.ToString("N0")
                        </span>
                    </span>
                }
            </div>
        </div>

        @* Project timeline *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Estimated timeline</span>
            </div>
            <div class="mt-2 space-y-1.5">
                @foreach (var it in _timeline)
                {
                    var phase = it;
                    var phaseIndex = System.Array.IndexOf(_timeline, phase);
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="circle-dot" Size="12" Class="@Cn.Merge("size-3 shrink-0", phaseIndex == 0 ? "text-foreground" : "text-muted-foreground/50")" />
                        <span class="flex-1 text-sm">@phase.Label</span>
                        <span class="text-muted-foreground text-xs">@phase.Duration</span>
                    </div>
                }
            </div>
        </div>

        @* Payment option *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Payment option</span>
            <div class="mt-2 flex gap-2">
                <button type="button"
                        class="@Cn.Merge("flex-1 rounded-md border px-3 py-2 text-left transition-colors", _paymentOption == "deposit" ? "border-foreground/20 bg-muted/30" : "hover:bg-muted/50")"
                        @onclick="@(() => _paymentOption = "deposit")">
                    <span class="block font-medium text-sm">@_depositPercent% Deposit</span>
                    <span class="text-muted-foreground text-xs">
                        $@(DepositAmount.ToString("N0")) now, remainder on completion
                    </span>
                </button>
                <button type="button"
                        class="@Cn.Merge("flex-1 rounded-md border px-3 py-2 text-left transition-colors", _paymentOption == "full" ? "border-foreground/20 bg-muted/30" : "hover:bg-muted/50")"
                        @onclick="@(() => _paymentOption = "full")">
                    <span class="block font-medium text-sm">Full Payment</span>
                    <span class="text-muted-foreground text-xs">$@(Total.ToString("N0")) today</span>
                </button>
            </div>
        </div>

        @* Totals *@
        <div class="border-b px-4 py-3 space-y-1.5">
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Base package</span>
                <span class="tabular-nums">$@(_packagePrice.ToString("N0"))</span>
            </div>
            @if (AddOnsTotal > 0)
            {
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Add-ons (@_selectedAddOns.Count)</span>
                    <span class="tabular-nums">$@(AddOnsTotal.ToString("N0"))</span>
                </div>
            }
            <div class="flex justify-between border-t pt-1.5 text-sm font-medium">
                <span>Total</span>
                <span class="tabular-nums">$@(Total.ToString("N0"))</span>
            </div>
            @if (_paymentOption == "deposit")
            {
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Due today (@_depositPercent% deposit)</span>
                    <span class="font-medium tabular-nums">$@(DepositAmount.ToString("N0"))</span>
                </div>
            }
        </div>

        @* Service agreement *@
        <div class="border-b px-4 py-3">
            <span class="flex items-start gap-3 cursor-pointer">
                <CheckboxCn id="sp-terms"
                            Checked="@_agreedTerms"
                            CheckedChanged="@((bool val) => _agreedTerms = val)"
                            Class="mt-0.5" />
                <label for="sp-terms"
                       class="text-muted-foreground text-xs leading-relaxed cursor-pointer">
                    I agree to the service agreement and understand that the project timeline is an
                    estimate. Deliverables are subject to the revision policy outlined in the package
                    terms. Deposits are non-refundable once work begins.
                </label>
            </span>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full" Disabled="@(!_agreedTerms)">
                @(_paymentOption == "deposit" ? "Pay Deposit" : "Pay in Full") &middot; $@(DueToday.ToString("N0"))
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                @(_paymentOption == "deposit"
                    ? $"Remaining ${(Total - DepositAmount).ToString("N0")} due upon project completion"
                    : "One-time payment for the full project scope")
            </p>
        </div>

    </div>
</section>

@code {
    private record AddOn(string Id, string Label, string Description, int Price);
    private record TimelinePhase(string Label, string Duration);

    private const string _packageName = "Brand Identity Package";
    private const string _packageDescription =
        "Complete visual identity system for startups and growing businesses. Includes strategy, design, and deliverables.";
    private const int _packagePrice = 4500;
    private const int _depositPercent = 50;

    private static readonly string[] _includedServices =
    [
        "Brand strategy workshop (2 hours)",
        "Logo design with 3 initial concepts",
        "Color palette and typography system",
        "Business card and letterhead design",
        "Brand guidelines document (PDF)",
        "Social media profile templates",
        "2 rounds of revisions per deliverable",
    ];

    private static readonly AddOn[] _addOns =
    [
        new("a1", "Brand voice guide",        "Tone, messaging, and copy guidelines",       750),
        new("a2", "Website design mockups",   "Homepage and 3 interior page designs",      2200),
        new("a3", "Pitch deck template",      "12-slide branded presentation template",     900),
        new("a4", "Additional revision round","One extra round across all deliverables",    400),
    ];

    private static readonly TimelinePhase[] _timeline =
    [
        new("Discovery & strategy",    "Week 1"),
        new("Initial concepts",        "Week 2-3"),
        new("Revisions & refinement",  "Week 4"),
        new("Final deliverables",      "Week 5"),
    ];

    private HashSet<string> _selectedAddOns = [];
    private string _paymentOption = "deposit";
    private bool _agreedTerms = false;

    private int AddOnsTotal =>
        _addOns.Where(a => _selectedAddOns.Contains(a.Id)).Sum(a => a.Price);

    private int Total => _packagePrice + AddOnsTotal;

    private double DepositAmount => Total * (_depositPercent / 100.0);

    private double DueToday => _paymentOption == "deposit" ? DepositAmount : Total;

    private void ToggleAddOn(string id)
    {
        if (_selectedAddOns.Contains(id))
            _selectedAddOns.Remove(id);
        else
            _selectedAddOns.Add(id);
    }
}
