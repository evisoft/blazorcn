@* ============================================================
   Block: checkout-gift-card
   Title: CheckoutGiftCard
   Description: A checkout gift card and store credit redemption block for React and Next.js with card number input, PIN field, balance check, applied amount display, remaining card balance, multiple gift card support, and remaining payment method indicator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-gift-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="credit-card" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Gift Card &amp; Store Credit</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Redeem a gift card or store credit toward your order.
            </p>
        </div>

        @* Order total context *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Order total</span>
                <span class="font-medium text-sm tabular-nums">$@_orderSubtotal.00</span>
            </div>
        </div>

        @* Applied gift cards *@
        @if (_appliedCards.Count > 0)
        {
            <div class="border-b">
                @foreach (var it in _appliedCards)
                {
                    var card = it;
                    var idx = _appliedCards.IndexOf(card);
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", idx < _appliedCards.Count - 1 ? "border-b" : "")">
                        <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">Gift card ending @card.LastFour</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-muted-foreground text-xs">
                                <span>
                                    Applied:&nbsp;<span class="font-medium text-emerald-600 tabular-nums dark:text-emerald-400">-$@card.AppliedAmount.00</span>
                                </span>
                                <span>&middot;</span>
                                <span>
                                    Card balance remaining:&nbsp;<span class="tabular-nums">$@card.RemainingBalance.00</span>
                                </span>
                            </div>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 shrink-0 px-1.5"
                                  OnClick="@(() => RemoveCard(card.Id))">
                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                }
            </div>
        }

        @* Gift card input form *@
        @if (_showForm && _remainingDue > 0)
        {
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">
                    @(_appliedCards.Count > 0 ? "Add another gift card" : "Enter gift card details")
                </span>
                <div class="mt-2 space-y-2">
                    <InputCn type="text"
                             Placeholder="@("Card number (e.g. 4829-7361-0054-8812)")"
                             @bind-Value="_cardNumber"
                             Class="h-8 font-mono text-xs" />
                    <div class="flex items-center gap-2">
                        <InputCn type="password"
                                 Placeholder="PIN"
                                 @bind-Value="_pin"
                                 Class="h-8 w-24 font-mono text-xs" />
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 px-3 text-xs"
                                  OnClick="HandleCheckAndApply"
                                  Disabled="@(_cardNumber.Trim().Length == 0 || _pin.Trim().Length == 0)">
                            Check &amp; Apply
                        </ButtonCn>
                    </div>
                </div>
                @if (_error != null)
                {
                    <p class="mt-1.5 text-red-600 text-xs dark:text-red-400">@_error</p>
                }
            </div>
        }
        else if (_remainingDue > 0)
        {
            <div class="border-b px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs"
                          OnClick="@(() => _showForm = true)">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    Add another gift card
                </ButtonCn>
            </div>
        }

        @* Payment summary *@
        <div class="border-b px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Order total</span>
                    <span class="text-xs tabular-nums">$@_orderSubtotal.00</span>
                </div>
                @if (_totalApplied > 0)
                {
                    <div class="flex items-center justify-between">
                        <span class="text-emerald-600 text-xs dark:text-emerald-400">
                            Gift card@(_appliedCards.Count > 1 ? "s" : "") applied
                        </span>
                        <span class="text-emerald-600 text-xs tabular-nums dark:text-emerald-400">
                            -$@_totalApplied.00
                        </span>
                    </div>
                }
                <div class="flex items-center justify-between border-t pt-1.5">
                    <span class="font-medium text-sm">Remaining to pay</span>
                    <span class="font-semibold text-2xl tabular-nums">$@_remainingDue.00</span>
                </div>
            </div>
        </div>

        @* CTA *@
        <div class="border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                @(_remainingDue > 0 ? $"Pay remaining ${_remainingDue}.00" : "Complete Order")
            </ButtonCn>
            @if (_remainingDue > 0)
            {
                <p class="mt-1.5 text-center text-muted-foreground text-xs">
                    Remaining amount will be charged to your payment method
                </p>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Gift cards are non-refundable &middot; Check balance at any time in your account
            </p>
        </div>
    </div>
</section>

@code {
    private record AppliedCard(string Id, string LastFour, int OriginalBalance, int AppliedAmount, int RemainingBalance);

    private static readonly Dictionary<string, (string Pin, int Balance)> _giftCardDatabase = new()
    {
        ["4829-7361-0054-8812"] = ("9921", 75),
        ["6103-4420-8837-2256"] = ("3347", 150),
        ["9917-5528-3301-6640"] = ("7712", 25),
    };

    private const int _orderSubtotal = 214;

    private List<AppliedCard> _appliedCards = [];
    private string _cardNumber = "";
    private string _pin = "";
    private string? _error = null;
    private bool _showForm = true;

    private int _totalApplied => _appliedCards.Sum(c => c.AppliedAmount);
    private int _remainingDue => Math.Max(0, _orderSubtotal - _totalApplied);

    private void HandleCheckAndApply()
    {
        var trimmedCard = _cardNumber.Trim();
        var trimmedPin = _pin.Trim();

        if (string.IsNullOrEmpty(trimmedCard) || string.IsNullOrEmpty(trimmedPin))
        {
            _error = "Enter both card number and PIN.";
            return;
        }

        if (!_giftCardDatabase.TryGetValue(trimmedCard, out var cardData))
        {
            _error = "Invalid card number or PIN. Please check and try again.";
            return;
        }

        if (cardData.Pin != trimmedPin)
        {
            _error = "Invalid card number or PIN. Please check and try again.";
            return;
        }

        var lastFour = trimmedCard.Length >= 4 ? trimmedCard[^4..] : trimmedCard;

        if (_appliedCards.Any(c => c.LastFour == lastFour))
        {
            _error = "This gift card is already applied.";
            return;
        }

        var currentRemaining = _orderSubtotal - _totalApplied;
        if (currentRemaining <= 0)
        {
            _error = "Order is already fully covered.";
            return;
        }

        var appliedAmount = Math.Min(cardData.Balance, currentRemaining);
        var newCard = new AppliedCard(
            trimmedCard,
            lastFour,
            cardData.Balance,
            appliedAmount,
            cardData.Balance - appliedAmount
        );

        _appliedCards = [.._appliedCards, newCard];
        _cardNumber = "";
        _pin = "";
        _error = null;
        _showForm = false;
    }

    private void RemoveCard(string id)
    {
        _appliedCards = _appliedCards.Where(c => c.Id != id).ToList();
        _showForm = true;
    }
}
