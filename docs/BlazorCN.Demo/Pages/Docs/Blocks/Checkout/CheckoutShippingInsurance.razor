@* ============================================================
   Block: checkout-shipping-insurance
   Title: CheckoutShippingInsurance
   Description: A shipping insurance add-on block for React and Next.js with coverage details for lost, damaged, and stolen packages, premium cost calculation, toggle to add insurance, and claims process overview using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-shipping-insurance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with toggle *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Shipping Insurance</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Protect your order against loss, damage, and theft
                </p>
            </div>
            <SwitchCn aria-label="Shipping Insurance" Checked="@_insured" CheckedChanged="@((bool val) => _insured = val)" />
        </div>

        @* Coverage amount and premium *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-muted-foreground text-xs">Coverage amount</span>
                <p class="mt-0.5 font-semibold text-2xl tabular-nums">
                    $@CoverageAmount.ToString("F2")
                </p>
            </div>
            <div class="text-right">
                <span class="text-muted-foreground text-xs">Insurance premium</span>
                <div class="mt-0.5 flex items-baseline gap-1">
                    <span class="font-semibold text-lg tabular-nums">+$@Premium.ToString("F2")</span>
                    <span class="text-muted-foreground text-xs">
                        (@((InsuranceRate * 100).ToString("F1"))%)
                    </span>
                </div>
            </div>
        </div>

        @* Coverage types *@
        <div class="border-b">
            <div class="px-4 py-2">
                <span class="text-muted-foreground text-xs">What's covered</span>
            </div>
            @foreach (var cov in _coverageTypes)
            {
                var coverage = cov;
                var isLast = coverage.Id == _coverageTypes[^1].Id;
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <LucideIconCn Name="@GetIconName(coverage.Icon)" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@coverage.Title</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@coverage.Description</p>
                    </div>
                    <LucideIconCn Name="check" Size="16" Class="mt-0.5 size-4 shrink-0 text-emerald-500" />
                </div>
            }
        </div>

        @* Claims process *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-muted-foreground text-xs">Claims process</span>
            <div class="space-y-2">
                @foreach (var (step, index) in _claimsSteps.Select((s, i) => (s, i)))
                {
                    <div class="flex items-start gap-2">
                        <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-muted/50 font-mono text-muted-foreground text-xs">
                            @(index + 1)
                        </span>
                        <span class="text-sm">@step</span>
                    </div>
                }
            </div>
        </div>

        @* Summary *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <span class="@Cn.Merge("size-1.5 rounded-full", _insured ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                    <span class="text-sm">
                        @(_insured ? "Insurance added to order" : "No insurance selected")
                    </span>
                </div>
                @if (_insured)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Protected
                    </BadgeCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record CoverageType(string Id, string Icon, string Title, string Description);

    private const double OrderValue = 847.0;
    private const double InsuranceRate = 0.025;
    private static readonly double Premium = OrderValue * InsuranceRate;
    private static readonly double CoverageAmount = OrderValue;

    private static readonly CoverageType[] _coverageTypes =
    [
        new("lost", "package", "Lost in transit", "Full reimbursement if your package never arrives"),
        new("damaged", "truck", "Shipping damage", "Covers items damaged during carrier handling"),
        new("stolen", "shield", "Porch piracy", "Protection against packages stolen after delivery"),
    ];

    private static readonly string[] _claimsSteps =
    [
        "File a claim within 15 days of delivery (or expected delivery)",
        "Provide photos and a brief description of the issue",
        "Receive resolution within 5-7 business days",
    ];

    private bool _insured = false;

    private static string GetIconName(string icon) => icon switch
    {
        "package" => "package",
        "truck" => "truck",
        "shield" => "shield-check",
        _ => "package",
    };
}
