@* ============================================================
   Block: checkout-address-form
   Title: CheckoutAddressForm
   Description: A detailed shipping address form with autocomplete-style fields, state and country selects, save address checkbox, and same-as-billing toggle
   Source: original/blocks/checkout/checkout-address-form.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-sm">Shipping Address</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Enter where you'd like your order delivered
                    </p>
                </div>
            </div>
        </div>

        @* Form fields *@
        <div class="space-y-3 px-4 py-4">
            @* Name row *@
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        First name
                    </span>
                    <InputCn Placeholder="John" Class="h-8 text-sm" />
                </div>
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        Last name
                    </span>
                    <InputCn Placeholder="Doe" Class="h-8 text-sm" />
                </div>
            </div>

            @* Company *@
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                    Company <span class="font-normal text-muted-foreground/70">(optional)</span>
                </span>
                <InputCn Placeholder="Acme Inc." Class="h-8 text-sm" />
            </div>

            @* Address line 1 *@
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                    Address line 1
                </span>
                <InputCn Placeholder="123 Main Street" Class="h-8 text-sm" />
            </div>

            @* Address line 2 *@
            <div>
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                    Address line 2
                    <span class="font-normal text-muted-foreground/70">(optional)</span>
                </span>
                <InputCn Placeholder="Apt 4B, Suite 200, etc." Class="h-8 text-sm" />
            </div>

            @* City + State *@
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">City</span>
                    <InputCn Placeholder="San Francisco" Class="h-8 text-sm" />
                </div>
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        State / Province
                    </span>
                    <SelectCn @bind-Value="_selectedState">
                        <SelectTriggerCn class="h-8 w-full text-sm">
                            <SelectValueCn Placeholder="Select state" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var state in _states)
                            {
                                var stateValue = state.ToLowerInvariant().Replace(" ", "-");
                                <SelectItemCn Value="@stateValue">@state</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>

            @* ZIP + Country *@
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        ZIP / Postal code
                    </span>
                    <InputCn Placeholder="94102" Class="h-8 text-sm" />
                </div>
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        Country
                    </span>
                    <SelectCn @bind-Value="_selectedCountry">
                        <SelectTriggerCn class="h-8 w-full text-sm">
                            <SelectValueCn Placeholder="Select country" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var country in _countries)
                            {
                                var countryValue = country.ToLowerInvariant().Replace(" ", "-");
                                <SelectItemCn Value="@countryValue">@country</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Options *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="flex cursor-pointer items-center gap-2" @onclick="@(() => _saveAddress = !_saveAddress)">
                    <CheckboxCn @bind-Checked="_saveAddress" />
                    <span class="text-sm">Save this address</span>
                </span>
            </div>
            <div class="mt-3 flex items-center justify-between">
                <span class="text-sm">Same as billing address</span>
                <SwitchCn @bind-Checked="_sameAsBilling" />
            </div>
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                Continue to Shipping
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _saveAddress = false;
    private bool _sameAsBilling = true;
    private string _selectedState = "";
    private string _selectedCountry = "united-states";

    private static readonly string[] _states =
    [
        "Alabama",
        "Alaska",
        "Arizona",
        "California",
        "Colorado",
        "Connecticut",
        "Florida",
        "Georgia",
        "Illinois",
        "Massachusetts",
        "Michigan",
        "New York",
        "North Carolina",
        "Ohio",
        "Oregon",
        "Pennsylvania",
        "Texas",
        "Virginia",
        "Washington",
    ];

    private static readonly string[] _countries =
    [
        "United States",
        "Canada",
        "United Kingdom",
        "Australia",
        "Germany",
        "France",
        "Japan",
        "Netherlands",
    ];
}
