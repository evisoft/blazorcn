@* ============================================================
   Block: checkout-accordion-steps
   Title: CheckoutAccordionSteps
   Description: An accordion-style checkout for React and Next.js with collapsible Contact, Shipping, and Payment sections that show summaries when completed using shadcn/ui Input, Label, Button, and Tailwind CSS
   Source: original/blocks/checkout/checkout-accordion-steps.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Checkout</span>
            <span class="font-medium text-sm tabular-nums">$@(_total.ToString("F2"))</span>
        </div>

        @* Steps *@
        @foreach (var stepDef in _steps)
        {
            var isActive = _activeStep == stepDef.Id;
            var isCompleted = _completedSteps.Contains(stepDef.Id);
            var isLast = stepDef.Id == _steps[_steps.Length - 1].Id;
            <div class="@(isLast ? "" : "border-b")">
                @* Step header *@
                <div class="flex items-center gap-3 px-4 py-3">
                    <div class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full text-xs", isCompleted ? "bg-foreground text-background" : isActive ? "border-2 border-foreground text-foreground" : "border border-muted-foreground/30 text-muted-foreground")">
                        @if (isCompleted)
                        {
                            <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                        }
                        else
                        {
                            @(Array.IndexOf(_steps, stepDef) + 1)
                        }
                    </div>
                    <div class="flex min-w-0 flex-1 items-center gap-2">
                        <span class="text-muted-foreground">
                            <LucideIconCn Name="@stepDef.Icon" Size="14" Class="size-3.5" />
                        </span>
                        <span class="@Cn.Merge("font-medium text-sm", (!isActive && !isCompleted) ? "text-muted-foreground" : "")">
                            @stepDef.Label
                        </span>
                    </div>
                    @if (isCompleted && !isActive)
                    {
                        var capturedId = stepDef.Id;
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="@(() => EditStep(capturedId))">
                            <LucideIconCn Name="pencil" Size="12" Class="size-3" />
                            Edit
                        </ButtonCn>
                    }
                </div>

                @* Completed summary *@
                @if (isCompleted && !isActive)
                {
                    <div class="px-4 pb-3 pl-[3.25rem]">
                        <p class="text-muted-foreground text-xs">@GetSummary(stepDef.Id)</p>
                    </div>
                }

                @* Active step form *@
                @if (isActive)
                {
                    <div class="px-4 pb-4 pl-[3.25rem]">
                        @if (stepDef.Id == "contact")
                        {
                            <div class="space-y-3">
                                <div class="space-y-1.5">
                                    <LabelCn For="acc-email" Class="text-xs">Email</LabelCn>
                                    <InputCn Id="acc-email" Type="email" Placeholder="@("you@example.com")" @bind-Value="_email" />
                                </div>
                                <div class="space-y-1.5">
                                    <LabelCn For="acc-phone" Class="text-xs">Phone (optional)</LabelCn>
                                    <InputCn Id="acc-phone" Type="tel" Placeholder="+1 (555) 123-4567" @bind-Value="_phone" />
                                </div>
                                <ButtonCn Size="ButtonSize.Sm" Class="mt-1 h-8 text-xs" OnClick="@(() => ContinueFrom("contact"))">
                                    Continue to Shipping
                                </ButtonCn>
                            </div>
                        }

                        @if (stepDef.Id == "shipping")
                        {
                            <div class="space-y-3">
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="space-y-1.5">
                                        <LabelCn For="acc-first" Class="text-xs">First name</LabelCn>
                                        <InputCn Id="acc-first" Placeholder="Jane" @bind-Value="_firstName" />
                                    </div>
                                    <div class="space-y-1.5">
                                        <LabelCn For="acc-last" Class="text-xs">Last name</LabelCn>
                                        <InputCn Id="acc-last" Placeholder="Smith" @bind-Value="_lastName" />
                                    </div>
                                </div>
                                <div class="space-y-1.5">
                                    <LabelCn For="acc-address" Class="text-xs">Street address</LabelCn>
                                    <InputCn Id="acc-address" Placeholder="123 Main St, Apt 4B" @bind-Value="_address" />
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="space-y-1.5">
                                        <LabelCn For="acc-city" Class="text-xs">City</LabelCn>
                                        <InputCn Id="acc-city" Placeholder="San Francisco" @bind-Value="_city" />
                                    </div>
                                    <div class="space-y-1.5">
                                        <LabelCn For="acc-zip" Class="text-xs">Zip code</LabelCn>
                                        <InputCn Id="acc-zip" Placeholder="94102" @bind-Value="_zip" />
                                    </div>
                                </div>
                                <ButtonCn Size="ButtonSize.Sm" Class="mt-1 h-8 text-xs" OnClick="@(() => ContinueFrom("shipping"))">
                                    Continue to Payment
                                </ButtonCn>
                            </div>
                        }

                        @if (stepDef.Id == "payment")
                        {
                            <div class="space-y-3">
                                <div class="space-y-1.5">
                                    <LabelCn For="acc-name-card" Class="text-xs">Name on card</LabelCn>
                                    <InputCn Id="acc-name-card" Placeholder="Jane Smith" @bind-Value="_nameOnCard" />
                                </div>
                                <div class="space-y-1.5">
                                    <LabelCn For="acc-card" Class="text-xs">Card number</LabelCn>
                                    <InputCn Id="acc-card" Placeholder="4242 4242 4242 4242" @bind-Value="_cardNumber" />
                                </div>
                                <div class="grid grid-cols-2 gap-3">
                                    <div class="space-y-1.5">
                                        <LabelCn For="acc-expiry" Class="text-xs">Expiry</LabelCn>
                                        <InputCn Id="acc-expiry" Placeholder="MM / YY" @bind-Value="_expiry" />
                                    </div>
                                    <div class="space-y-1.5">
                                        <LabelCn For="acc-cvv" Class="text-xs">CVV</LabelCn>
                                        <InputCn Id="acc-cvv" Placeholder="123" @bind-Value="_cvv" />
                                    </div>
                                </div>
                                <ButtonCn Size="ButtonSize.Sm" Class="mt-1 h-8 text-xs" OnClick="@(() => MarkComplete("payment"))">
                                    Place Order &middot; $@(_total.ToString("F2"))
                                </ButtonCn>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record StepConfig(string Id, string Label, string Icon);

    private static readonly StepConfig[] _steps =
    [
        new("contact", "Contact", "mail"),
        new("shipping", "Shipping", "truck"),
        new("payment", "Payment", "credit-card"),
    ];

    private const double _total = 143.33;

    private string _activeStep = "contact";
    private readonly HashSet<string> _completedSteps = [];

    private string _email = "";
    private string _phone = "";
    private string _firstName = "";
    private string _lastName = "";
    private string _address = "";
    private string _city = "";
    private string _zip = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";
    private string _nameOnCard = "";

    private void MarkComplete(string step)
    {
        _completedSteps.Add(step);
    }

    private void ContinueFrom(string step)
    {
        MarkComplete(step);
        var currentIndex = Array.FindIndex(_steps, s => s.Id == step);
        if (currentIndex < _steps.Length - 1)
        {
            _activeStep = _steps[currentIndex + 1].Id;
        }
    }

    private void EditStep(string step)
    {
        _activeStep = step;
    }

    private string GetSummary(string step) => step switch
    {
        "contact" => !string.IsNullOrEmpty(_email) ? _email : "No email provided",
        "shipping" => !string.IsNullOrEmpty(_address) ? $"{_address}, {_city} {_zip}" : "No address provided",
        "payment" => !string.IsNullOrEmpty(_cardNumber) ? $"Card ending in {(_cardNumber.Length >= 4 ? _cardNumber[^4..] : _cardNumber)}" : "No card provided",
        _ => ""
    };
}
