@* ============================================================
   Block: checkout-refund-request
   Title: CheckoutRefundRequest
   Description: A refund and return request flow for React and Next.js with item selection checkboxes, return reason dropdowns, refund method choice, and estimated refund amount using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-refund-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Request a Return</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Select items you'd like to return and provide a reason
            </p>
        </div>

        @* Item selection *@
        <div class="border-b">
            @foreach (var it in _orderItems)
            {
                var item = it;
                var isLast = item.Id == _orderItems[_orderItems.Length - 1].Id;
                var isSelected = _selectedItems.Contains(item.Id);
                <div class="@Cn.Merge("px-4 py-3", !isLast ? "border-b" : "")">
                    <span class="flex cursor-pointer items-center gap-3"
                          role="button"
                          tabindex="0"
                          @onclick="@(() => ToggleItem(item.Id))">
                        <CheckboxCn Checked="@isSelected" CheckedChanged="@(_ => ToggleItem(item.Id))" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@item.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@item.Variant</p>
                        </div>
                        <span class="shrink-0 text-sm tabular-nums">$@item.Price.ToString("F2")</span>
                    </span>

                    @if (isSelected)
                    {
                        <div class="mt-2 pl-7">
                            <SelectCn Value="@(_reasons.TryGetValue(item.Id, out var r) ? r : "")"
                                      ValueChanged="@((v) => SetReason(item.Id, v ?? ""))">
                                <SelectTriggerCn Class="h-8 text-xs">
                                    <SelectValueCn Placeholder="Select a reason" />
                                </SelectTriggerCn>
                                <SelectContentCn>
                                    @foreach (var reason in _returnReasons)
                                    {
                                        var reasonVal = reason;
                                        <SelectItemCn Value="@reasonVal" Class="text-xs">@reasonVal</SelectItemCn>
                                    }
                                </SelectContentCn>
                            </SelectCn>
                        </div>
                    }
                </div>
            }
        </div>

        @* Refund method *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Refund Method
            </span>
            <RadioGroupCn @bind-Value="_refundMethod">
                <span class="flex cursor-pointer items-center gap-3 rounded-md px-2 py-2 transition-colors hover:bg-muted/50"
                      role="button"
                      tabindex="0"
                      @onclick="@(() => _refundMethod = "original")">
                    <RadioGroupItemCn Value="original" />
                    <div>
                        <span class="font-medium text-sm">Original payment method</span>
                        <p class="text-muted-foreground text-xs">
                            Visa ending in 4242 &middot; 5-10 business days
                        </p>
                    </div>
                </span>
                <span class="flex cursor-pointer items-center gap-3 rounded-md px-2 py-2 transition-colors hover:bg-muted/50"
                      role="button"
                      tabindex="0"
                      @onclick="@(() => _refundMethod = "credit")">
                    <RadioGroupItemCn Value="credit" />
                    <div>
                        <span class="font-medium text-sm">Store credit</span>
                        <p class="text-muted-foreground text-xs">Available instantly after approval</p>
                    </div>
                </span>
            </RadioGroupCn>
        </div>

        @* Refund estimate and submit *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Estimated refund</span>
                <span class="font-semibold text-sm tabular-nums">
                    @(_refundTotal > 0 ? $"${_refundTotal:F2}" : "$0.00")
                </span>
            </div>
            <ButtonCn Class="mt-3 w-full" Size="ButtonSize.Sm" Disabled="@(_selectedItems.Count == 0)">
                Submit Return Request
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                You'll receive a prepaid shipping label via email
            </p>
        </div>
    </div>
</section>

@code {
    private record OrderItem(string Id, string Name, string Variant, double Price);

    private static readonly OrderItem[] _orderItems =
    [
        new("1", "Merino Wool Crewneck", "Heather Gray / M",  89.0),
        new("2", "Slim Chino Pants",     "Navy / 32x32",      79.0),
        new("3", "Canvas Tote Bag",      "Natural",           24.0),
    ];

    private static readonly string[] _returnReasons =
    [
        "Doesn't fit",
        "Wrong item received",
        "Item is damaged",
        "Quality not as expected",
        "Changed my mind",
        "Arrived too late",
    ];

    private HashSet<string> _selectedItems = [];
    private Dictionary<string, string> _reasons = [];
    private string _refundMethod = "original";

    private double _refundTotal =>
        _orderItems
            .Where(i => _selectedItems.Contains(i.Id))
            .Sum(i => i.Price);

    private void ToggleItem(string id)
    {
        if (!_selectedItems.Add(id))
            _selectedItems.Remove(id);
    }

    private void SetReason(string id, string reason)
    {
        _reasons[id] = reason;
    }
}
