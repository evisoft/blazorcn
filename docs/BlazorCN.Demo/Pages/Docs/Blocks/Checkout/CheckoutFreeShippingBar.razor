@* ============================================================
   Block: checkout-free-shipping-bar
   Title: CheckoutFreeShippingBar
   Description: A React and Next.js checkout block with a free shipping progress bar, threshold message, suggested add-on items, shipping cost preview, and order summary using shadcn/ui Progress, Button, Badge, and Tailwind CSS
   Source: original/blocks/checkout/checkout-free-shipping-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Your Cart</span>
            <span class="text-muted-foreground text-xs">
                @_items.Count @(_items.Count == 1 ? "item" : "items")
            </span>
        </div>

        @* Free shipping progress *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="truck" Size="16" Class="@Cn.Merge("size-4 shrink-0", _qualifiesFreeShipping ? "text-emerald-600 dark:text-emerald-400" : "text-muted-foreground")" />
                @if (_qualifiesFreeShipping)
                {
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                        <span class="font-medium text-emerald-700 text-sm dark:text-emerald-300">
                            You qualify for free shipping!
                        </span>
                    </div>
                }
                else
                {
                    <span class="text-sm">
                        Add <span class="font-semibold tabular-nums">$@_remaining.ToString("F2")</span>
                        <span class="text-muted-foreground"> more for free shipping</span>
                    </span>
                }
            </div>
            <div class="mt-2">
                <ProgressCn Value="@((int)_progress)" Class="h-1.5" />
            </div>
            <div class="mt-1 flex items-center justify-between">
                <span class="text-muted-foreground text-[10px] tabular-nums">
                    $@_subtotal.ToString("F2")
                </span>
                <span class="text-muted-foreground text-[10px] tabular-nums">
                    $@FreeShippingThreshold.ToString("F2")
                </span>
            </div>
        </div>

        @* Cart items *@
        <div>
            @{
                var itemList = _items.ToList();
                var hasRelevantSuggestions = _relevantSuggestions.Count > 0;
            }
            @foreach (var it in itemList)
            {
                var item = it;
                var isLast = itemList.IndexOf(item) == itemList.Count - 1 && !hasRelevantSuggestions;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50 font-mono text-muted-foreground text-xs">
                        @item.Image
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@item.Name</span>
                        <p class="text-muted-foreground text-xs tabular-nums">
                            $@item.Price.ToString("F2")
                        </p>
                    </div>
                    <div class="flex items-center gap-1">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-6 p-0" OnClick="@(() => UpdateQuantity(item.Id, -1))">
                            <LucideIconCn Name="minus" Size="12" Class="size-3" />
                        </ButtonCn>
                        <span class="w-6 text-center text-xs tabular-nums">@item.Quantity</span>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-6 p-0" OnClick="@(() => UpdateQuantity(item.Id, 1))">
                            <LucideIconCn Name="plus" Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                    <span class="w-16 shrink-0 text-right font-medium text-sm tabular-nums">
                        $@((item.Price * item.Quantity).ToString("F2"))
                    </span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0 text-muted-foreground" OnClick="@(() => RemoveItem(item.Id))">
                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            }
        </div>

        @* Suggested items *@
        @if (!_qualifiesFreeShipping && _relevantSuggestions.Count > 0)
        {
            <div class="border-t px-4 py-2.5">
                <span class="text-muted-foreground text-xs">
                    Add one of these to qualify for free shipping
                </span>
            </div>
            <div>
                @{
                    var suggList = _relevantSuggestions.ToList();
                }
                @foreach (var sg in suggList)
                {
                    var sugg = sg;
                    var suggIsLast = suggList.IndexOf(sugg) == suggList.Count - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2", suggIsLast ? "" : "border-b")">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded bg-muted/50 font-mono text-muted-foreground text-[10px]">
                            @sugg.Image
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm">@sugg.Name</span>
                        </div>
                        <span class="text-muted-foreground text-xs tabular-nums">
                            $@sugg.Price.ToString("F2")
                        </span>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="@(() => AddSuggested(sugg))">
                            <LucideIconCn Name="plus" Size="12" Class="size-3" />
                            Add
                        </ButtonCn>
                    </div>
                }
            </div>
        }

        @* Shipping cost preview *@
        <div class="border-t bg-muted/30 px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Subtotal</span>
                <span class="text-sm tabular-nums">$@_subtotal.ToString("F2")</span>
            </div>
            <div class="mt-1 flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                    <span class="text-muted-foreground text-xs">Standard Shipping</span>
                    @if (_qualifiesFreeShipping)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-emerald-500/10 font-normal text-[10px] text-emerald-700 dark:text-emerald-300">
                            Free
                        </BadgeCn>
                    }
                </div>
                <span class="@Cn.Merge("text-sm tabular-nums", _qualifiesFreeShipping ? "text-emerald-600 line-through dark:text-emerald-400" : "")">
                    @if (_qualifiesFreeShipping)
                    {
                        <span class="text-emerald-600 no-underline dark:text-emerald-400">$0.00</span>
                    }
                    else
                    {
                        @($"${StandardShipping.ToString("F2")}")
                    }
                </span>
            </div>
            @if (!_qualifiesFreeShipping)
            {
                <div class="mt-1 flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Express Shipping</span>
                    <span class="text-muted-foreground text-sm tabular-nums">
                        $@ExpressShipping.ToString("F2")
                    </span>
                </div>
            }
            <div class="mt-2 flex items-center justify-between border-t pt-2">
                <span class="font-medium text-sm">Total</span>
                <span class="font-semibold text-lg tabular-nums">$@_total.ToString("F2")</span>
            </div>
        </div>

        @* Checkout button *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Disabled="@(_items.Count == 0)">Checkout</ButtonCn>
        </div>
    </div>
</section>

@code {
    private const double FreeShippingThreshold = 75.0;
    private const double StandardShipping = 5.99;
    private const double ExpressShipping = 12.99;

    private record CartItem(string Id, string Name, string Image, double Price, int Quantity);
    private record SuggestedItem(string Id, string Name, string Image, double Price);

    private List<CartItem> _items =
    [
        new("1", "Organic Face Moisturizer", "FM", 28.0,  1),
        new("2", "Vitamin C Serum",          "VC", 34.5,  1),
    ];

    private static readonly SuggestedItem[] _suggestions =
    [
        new("s1", "Lip Balm SPF 30",       "LB", 8.99),
        new("s2", "Travel Size Cleanser",  "TC", 12.5),
        new("s3", "Sheet Mask 3-Pack",     "SM", 14.99),
    ];

    private double _subtotal => _items.Sum(i => i.Price * i.Quantity);
    private bool _qualifiesFreeShipping => _subtotal >= FreeShippingThreshold;
    private double _remaining => Math.Max(0, FreeShippingThreshold - _subtotal);
    private double _progress => Math.Min(100, (_subtotal / FreeShippingThreshold) * 100);
    private double _shippingCost => _qualifiesFreeShipping ? 0 : StandardShipping;
    private double _total => _subtotal + _shippingCost;
    private List<SuggestedItem> _relevantSuggestions => _suggestions.Where(s => !_items.Any(i => i.Id == s.Id)).ToList();

    private void UpdateQuantity(string id, int delta)
    {
        _items = _items.Select(i =>
        {
            if (i.Id != id) return i;
            return i with { Quantity = Math.Max(1, i.Quantity + delta) };
        }).ToList();
    }

    private void RemoveItem(string id)
    {
        _items = _items.Where(i => i.Id != id).ToList();
    }

    private void AddSuggested(SuggestedItem suggestion)
    {
        var existing = _items.FirstOrDefault(i => i.Id == suggestion.Id);
        if (existing is not null)
        {
            _items = _items.Select(i =>
                i.Id == suggestion.Id ? i with { Quantity = i.Quantity + 1 } : i
            ).ToList();
        }
        else
        {
            _items = [.. _items, new CartItem(suggestion.Id, suggestion.Name, suggestion.Image, suggestion.Price, 1)];
        }
    }
}
