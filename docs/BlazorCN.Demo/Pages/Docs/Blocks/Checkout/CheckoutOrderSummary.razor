@* ============================================================
   Block: checkout-order-summary
   Title: CheckoutOrderSummary
   Description: An order summary and review panel for React and Next.js with line items, thumbnail placeholders, subtotal, shipping, tax, promo code input, and total using shadcn/ui Input, Button, Badge, and Tailwind CSS
   Source: original/blocks/checkout/checkout-order-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Order Summary</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_items.Sum(i => i.Quantity) items
            </BadgeCn>
        </div>

        @* Line items *@
        <div>
            @{
                var itemList = _items.ToList();
            }
            @foreach (var it in itemList)
            {
                var item = it;
                var isLast = itemList.IndexOf(item) == itemList.Count - 1;
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    @* Thumbnail placeholder *@
                    <div class="size-10 shrink-0 rounded-md bg-muted/50" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@item.Name</span>
                        <p class="text-muted-foreground text-xs">@item.Variant</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">Qty @item.Quantity</p>
                    </div>
                    <span class="shrink-0 font-medium text-sm tabular-nums">
                        $@((item.Price * item.Quantity).ToString("F2"))
                    </span>
                </div>
            }
        </div>

        @* Promo code *@
        <div class="border-t px-4 py-3">
            @if (_appliedCode != null)
            {
                <div class="flex items-center justify-between rounded-md bg-emerald-500/10 px-3 py-2">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                        <span class="font-medium text-sm">@_appliedCode</span>
                        <span class="text-emerald-600 text-xs dark:text-emerald-400">20% off</span>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0 text-muted-foreground" @onclick="RemovePromo">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            }
            else
            {
                <div class="space-y-1.5">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="tag" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="font-medium text-muted-foreground text-xs">Promo code</span>
                    </div>
                    <div class="flex gap-2">
                        <InputCn @bind-Value="_promoCode" Placeholder="Enter code" Class="h-8 text-sm" />
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 shrink-0 text-xs" @onclick="ApplyPromo" Disabled="@(string.IsNullOrWhiteSpace(_promoCode))">
                            Apply
                        </ButtonCn>
                    </div>
                    @if (_promoError)
                    {
                        <p class="text-xs text-red-500">Invalid promo code. Try DESK20.</p>
                    }
                </div>
            }
        </div>

        @* Totals *@
        <div class="border-t px-4 py-3 space-y-1.5">
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Subtotal</span>
                <span class="tabular-nums">$@_subtotal.ToString("F2")</span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Shipping</span>
                <span class="tabular-nums">
                    @if (_shippingCost == 0)
                    {
                        <span class="text-emerald-600 dark:text-emerald-400">Free</span>
                    }
                    else
                    {
                        @($"${_shippingCost.ToString("F2")}")
                    }
                </span>
            </div>
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">Tax</span>
                <span class="tabular-nums">$@_tax.ToString("F2")</span>
            </div>
            @if (_discount > 0)
            {
                <div class="flex items-center justify-between text-sm">
                    <span class="flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="percent" Size="12" Class="size-3" />
                        Discount
                    </span>
                    <span class="tabular-nums text-emerald-600 dark:text-emerald-400">
                        -$@_discount.ToString("F2")
                    </span>
                </div>
            }
            <div class="flex justify-between border-t pt-2 font-medium text-sm">
                <span>Total</span>
                <span class="tabular-nums">$@_total.ToString("F2")</span>
            </div>
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full">Continue to Payment</ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Free shipping on all orders. 30-day returns.
            </p>
        </div>
    </div>
</section>

@code {
    private record OrderItem(string Id, string Name, string Variant, double Price, int Quantity);

    private static readonly OrderItem[] _items =
    [
        new("1", "Standing Desk Frame",      "Black / Electric / 60in",        449.0, 1),
        new("2", "Bamboo Desktop Surface",   "Natural / 60 x 30 in",           189.0, 1),
        new("3", "Cable Management Tray",    "Under-desk / Black",              29.0, 2),
        new("4", "Monitor Arm Dual",         "Matte Black / 27in max",         139.0, 1),
        new("5", "Desk Pad XL",             "Dark Gray Felt / 36 x 17 in",     39.0, 1),
    ];

    private const double _shippingCost = 0;
    private const double _taxRate = 0.08;

    private double _subtotal => _items.Sum(i => i.Price * i.Quantity);
    private double _tax => Math.Round(_subtotal * _taxRate, 2);

    private string _promoCode = "";
    private string? _appliedCode = null;
    private bool _promoError = false;

    private double _discount => _appliedCode == "DESK20" ? Math.Round(_subtotal * 0.2, 2) : 0;
    private double _total => Math.Round(_subtotal + _shippingCost + _tax - _discount, 2);

    private void ApplyPromo()
    {
        if (_promoCode.ToUpperInvariant() == "DESK20")
        {
            _appliedCode = "DESK20";
            _promoError = false;
            _promoCode = "";
        }
        else
        {
            _promoError = true;
        }
    }

    private void RemovePromo()
    {
        _appliedCode = null;
        _promoError = false;
    }
}
