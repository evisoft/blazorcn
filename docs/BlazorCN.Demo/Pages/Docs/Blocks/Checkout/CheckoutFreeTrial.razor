@* ============================================================
   Block: checkout-free-trial
   Title: CheckoutFreeTrial
   Description: A free trial signup checkout for React and Next.js with plan details, 14-day trial duration, post-trial billing notice, payment method collection, and start trial CTA using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-free-trial.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Start your free trial</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_trialDays days free
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                No charge today. Cancel anytime before your trial ends.
            </p>
        </div>

        @* Plan details *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">@_planName</span>
                <div class="text-right">
                    <span class="font-semibold text-sm tabular-nums">$@_priceAfterTrial</span>
                    <span class="text-muted-foreground text-xs">/@_billingCycle</span>
                </div>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Billing starts after your @_trialDays-day trial on Apr 7, 2026
            </p>
        </div>

        @* What's included *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">What's included</span>
            <div class="mt-2 space-y-2">
                @foreach (var feature in _trialFeatures)
                {
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check" Size="14" Class="size-3.5 shrink-0 text-emerald-500" />
                        <span class="text-sm">@feature.Text</span>
                    </div>
                }
            </div>
        </div>

        @* No charge indicator *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                <div>
                    <span class="font-medium text-sm">$0.00 due today</span>
                    <p class="text-muted-foreground text-xs">
                        Payment method required to start trial. You won't be charged until the trial ends.
                    </p>
                </div>
            </div>
        </div>

        @* Payment method *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Payment method</span>
            </div>

            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="ft-name" Class="text-xs">
                        Name on card
                    </LabelCn>
                    <InputCn Id="ft-name"
                             Placeholder="Jane Smith"
                             @bind-Value="_nameOnCard" />
                </div>

                <div class="space-y-1.5">
                    <LabelCn For="ft-card" Class="text-xs">
                        Card number
                    </LabelCn>
                    <InputCn Id="ft-card"
                             Placeholder="4242 4242 4242 4242"
                             @bind-Value="_cardNumber" />
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="ft-expiry" Class="text-xs">
                            Expiry date
                        </LabelCn>
                        <InputCn Id="ft-expiry"
                                 Placeholder="MM / YY"
                                 @bind-Value="_expiry" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="ft-cvv" Class="text-xs">
                            CVV
                        </LabelCn>
                        <InputCn Id="ft-cvv"
                                 Placeholder="123"
                                 @bind-Value="_cvv" />
                    </div>
                </div>
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">Start Free Trial</ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                You can cancel anytime from your account settings
            </p>
        </div>
    </div>
</section>

@code {
    private string _nameOnCard = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";

    private const string _planName = "Pro Plan";
    private const int _trialDays = 14;
    private const int _priceAfterTrial = 29;
    private const string _billingCycle = "month";

    private record TrialFeature(string Id, string Text);

    private static readonly TrialFeature[] _trialFeatures =
    [
        new("f1", "Unlimited projects and collaborators"),
        new("f2", "Advanced analytics and reporting"),
        new("f3", "Priority email and chat support"),
        new("f4", "Custom integrations and API access"),
        new("f5", "SSO and team management"),
    ];
}
