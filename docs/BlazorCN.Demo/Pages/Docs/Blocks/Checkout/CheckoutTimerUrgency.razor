@* ============================================================
   Block: checkout-timer-urgency
   Title: CheckoutTimerUrgency
   Description: A checkout block with urgency elements for React and Next.js featuring a static countdown timer display, reserved items notice, per-item stock level warnings, social proof viewer count, and a timer progress bar using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-timer-urgency.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Timer banner *@
        <div class="border-b bg-amber-500/5 px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-amber-600 dark:text-amber-400" />
                    <span class="font-medium text-sm">
                        Complete your order in <span class="tabular-nums">@_timerDisplay</span>
                    </span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="eye" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs tabular-nums">
                        @_viewerCount viewing
                    </span>
                </div>
            </div>
            @* Timer bar *@
            <div class="mt-2 h-1 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-amber-500 transition-all"
                     style="@($"width:{_timerPercent:F4}%")">
                </div>
            </div>
            <p class="mt-1.5 text-muted-foreground text-xs">
                Items in your cart are reserved for you during this session
            </p>
        </div>

        @* Cart items *@
        <div>
            @{
                var itemList = _cartItems.ToList();
            }
            @foreach (var it in itemList)
            {
                var item = it;
                var isLast = itemList.IndexOf(item) == itemList.Count - 1;
                var warning = StockWarning(item.Stock);
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@item.Name</span>
                            <p class="text-muted-foreground text-xs">
                                @item.Variant &middot; Qty @item.Qty
                            </p>
                            @if (warning != null)
                            {
                                <div class="mt-1 flex items-center gap-1">
                                    <LucideIconCn Name="triangle-alert" Size="12" Class="@Cn.Merge("size-3", warning.Color)" />
                                    <span class="@Cn.Merge("text-xs font-medium", warning.Color)">
                                        @warning.Message
                                    </span>
                                </div>
                            }
                        </div>
                        <span class="ml-4 shrink-0 text-sm tabular-nums">
                            $@((item.Price * item.Qty).ToString("F2"))
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Email *@
        <div class="border-t px-4 py-4">
            <span class="mb-3 block font-medium text-sm">Contact</span>
            <div class="space-y-1.5">
                <LabelCn For="tu-email" Class="text-xs">Email address</LabelCn>
                <InputCn id="tu-email" type="email" Placeholder="@("you@example.com")" />
            </div>
        </div>

        @* Payment *@
        <div class="border-t px-4 py-4">
            <span class="mb-3 block font-medium text-sm">Payment</span>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="tu-card" Class="text-xs">Card number</LabelCn>
                    <InputCn id="tu-card" Placeholder="4242 4242 4242 4242" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="tu-expiry" Class="text-xs">Expiry</LabelCn>
                        <InputCn id="tu-expiry" Placeholder="MM / YY" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="tu-cvv" Class="text-xs">CVV</LabelCn>
                        <InputCn id="tu-cvv" Placeholder="123" />
                    </div>
                </div>
            </div>
        </div>

        @* Total + Submit *@
        <div class="border-t px-4 py-3">
            <div class="mb-3 space-y-1">
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Subtotal</span>
                    <span class="tabular-nums">$@_subtotal.ToString("F2")</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Shipping</span>
                    <span class="text-emerald-600 text-xs dark:text-emerald-400">Free</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Tax</span>
                    <span class="tabular-nums">$@_tax.ToString("F2")</span>
                </div>
                <div class="flex justify-between border-t pt-1.5 font-medium text-sm">
                    <span>Total</span>
                    <span class="tabular-nums">$@_total.ToString("F2")</span>
                </div>
            </div>
            <ButtonCn Class="h-10 w-full text-sm">
                <LucideIconCn Name="lock" Size="14" Class="mr-1.5 size-3.5" />
                Pay $@_total.ToString("F2")
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Secured by 256-bit SSL encryption
            </p>
        </div>
    </div>
</section>

@code {
    private record CartItem(string Name, string Variant, int Qty, double Price, int Stock);

    private record StockWarningResult(string Message, string Color);

    private static readonly CartItem[] _cartItems =
    [
        new("Limited Edition Sneakers", "White / Size 10", 1, 189.0, 3),
        new("Vintage Denim Jacket",     "Indigo / Medium",  1, 124.0, 7),
        new("Canvas Tote Bag",          "Natural",          2,  28.0, 24),
    ];

    private const int _timerMinutes = 14;
    private const int _timerSeconds = 59;
    private string _timerDisplay => $"{_timerMinutes}:{_timerSeconds:D2}";
    private double _timerPercent => ((_timerMinutes * 60 + _timerSeconds) / (15.0 * 60)) * 100;
    private const int _viewerCount = 23;

    private double _subtotal => _cartItems.Sum(i => i.Price * i.Qty);
    private const double _shipping = 0;
    private const double _tax = 27.69;
    private double _total => _subtotal + _shipping + _tax;

    private static StockWarningResult? StockWarning(int stock)
    {
        if (stock <= 4)
            return new($"Only {stock} left in stock", "text-red-600 dark:text-red-400");
        if (stock <= 10)
            return new($"{stock} left in stock", "text-amber-600 dark:text-amber-400");
        return null;
    }
}
