@* ============================================================
   Block: checkout-product-customization
   Title: CheckoutProductCustomization
   Description: A product customization checkout block for React and Next.js with size selector, color swatches, engraving text input, material upgrade radio, customization summary with price adjustments, and preview section using shadcn/ui RadioGroup, Input, Label, Button, Badge, and Tailwind CSS
   Source: original/blocks/checkout/checkout-product-customization.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="palette" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Customize Your Order</span>
        </div>

        @* Product info *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">@_productName</span>
                <span class="font-medium text-sm tabular-nums">$@_basePrice.ToString("F2")</span>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Base price · Customizations added below
            </p>
        </div>

        @* Size selector *@
        <div class="border-b px-4 py-4">
            <LabelCn Class="text-xs">Size</LabelCn>
            <div class="mt-2 flex gap-2">
                @foreach (var sz in _sizes)
                {
                    var sizeVal = sz;
                    <button
                        type="button"
                        @onclick="@(() => _size = sizeVal.Value)"
                        class="@Cn.Merge("flex h-9 min-w-[2.5rem] items-center justify-center rounded-md border px-3 text-xs font-medium transition-colors", _size == sizeVal.Value ? "border-foreground bg-foreground text-background" : "border-border hover:bg-muted/50")">
                        @sizeVal.Label
                    </button>
                }
            </div>
            @if (_selectedSize.PriceDelta > 0)
            {
                <p class="mt-1.5 text-muted-foreground text-xs">
                    +$@_selectedSize.PriceDelta.ToString("F2") for size @_selectedSize.Label
                </p>
            }
        </div>

        @* Color swatches *@
        <div class="border-b px-4 py-4">
            <LabelCn Class="text-xs">Color</LabelCn>
            <div class="mt-2 flex items-center gap-3">
                @foreach (var cl in _colors)
                {
                    var colorVal = cl;
                    <button
                        type="button"
                        @onclick="@(() => _color = colorVal.Value)"
                        class="group flex flex-col items-center gap-1.5">
                        <span
                            class="@Cn.Merge("block size-8 rounded-full border-2 transition-all", _color == colorVal.Value ? "border-foreground ring-2 ring-foreground ring-offset-2 ring-offset-background" : "border-border group-hover:border-muted-foreground")"
                            style="@($"background-color:{colorVal.Hex}")">
                        </span>
                        <span class="@Cn.Merge("text-xs", _color == colorVal.Value ? "font-medium text-foreground" : "text-muted-foreground")">
                            @colorVal.Label
                        </span>
                    </button>
                }
            </div>
        </div>

        @* Material upgrade *@
        <div class="border-b px-4 py-4">
            <LabelCn Class="text-xs">Material</LabelCn>
            <div class="mt-2">
                @foreach (var mat in _materials)
                {
                    var materialVal = mat;
                    var isActive = _material == materialVal.Value;
                    <span
                        class="@Cn.Merge("flex cursor-pointer items-center gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-muted/50", isActive ? "bg-muted/50" : "")"
                        role="button"
                        tabindex="0"
                        @onclick="@(() => _material = materialVal.Value)">
                        <span class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border-2", isActive ? "border-foreground" : "border-muted-foreground")">
                            @if (isActive)
                            {
                                <span class="size-2 rounded-full bg-foreground"></span>
                            }
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@materialVal.Label</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@materialVal.Description</p>
                        </div>
                        <span class="shrink-0 text-sm tabular-nums">
                            @(materialVal.PriceDelta == 0 ? "Included" : $"+${materialVal.PriceDelta.ToString("F2")}")
                        </span>
                    </span>
                }
            </div>
        </div>

        @* Engraving *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-muted-foreground" />
                <LabelCn For="pc-engraving" Class="text-xs">
                    Engraving
                </LabelCn>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    $@_engravingPricePerChar/char
                </BadgeCn>
            </div>
            <InputCn
                Id="pc-engraving"
                Placeholder="Up to 20 characters"
                MaxLength="20"
                @bind-Value="_engraving"
                Class="mt-2" />
            <div class="mt-1.5 flex items-center justify-between text-muted-foreground text-xs">
                <span>@_engraving.Length/20 characters</span>
                @if (_engravingCost > 0)
                {
                    <span>+$@_engravingCost.ToString("F2")</span>
                }
            </div>
        </div>

        @* Customization summary *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Customization Summary</span>
            <div class="mt-2 rounded-md bg-muted/50 p-3">
                <div class="space-y-1.5 text-sm">
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">Size @_selectedSize.Label</span>
                        <span class="tabular-nums">
                            @(_selectedSize.PriceDelta == 0 ? "Included" : $"+${_selectedSize.PriceDelta.ToString("F2")}")
                        </span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">@_selectedColor.Label</span>
                        <span class="tabular-nums">Included</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-muted-foreground">@_selectedMaterial.Label</span>
                        <span class="tabular-nums">
                            @(_selectedMaterial.PriceDelta == 0 ? "Included" : $"+${_selectedMaterial.PriceDelta.ToString("F2")}")
                        </span>
                    </div>
                    @if (_engraving.Length > 0)
                    {
                        <div class="flex justify-between">
                            <span class="text-muted-foreground">
                                Engraving: &ldquo;@_engraving&rdquo;
                            </span>
                            <span class="tabular-nums">+$@_engravingCost.ToString("F2")</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Total and checkout *@
        <div class="px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Base price</span>
                    <span class="tabular-nums">$@_basePrice.ToString("F2")</span>
                </div>
                @if (_totalAdjustment > 0)
                {
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Customizations</span>
                        <span class="tabular-nums">+$@_totalAdjustment.ToString("F2")</span>
                    </div>
                }
                <div class="flex justify-between border-t pt-1.5 text-sm font-medium">
                    <span>Total</span>
                    <span class="tabular-nums">$@_totalPrice.ToString("F2")</span>
                </div>
            </div>
            <ButtonCn Class="mt-3 w-full" Size="ButtonSize.Sm">Add to Cart</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SizeOption(string Value, string Label, double PriceDelta);
    private record ColorOption(string Value, string Label, string Hex);
    private record MaterialOption(string Value, string Label, string Description, double PriceDelta);

    private const string _productName = "Classic Signet Ring";
    private const double _basePrice = 149.0;
    private const double _engravingPricePerChar = 2;

    private static readonly SizeOption[] _sizes =
    [
        new("xs", "XS", 0),
        new("s", "S", 0),
        new("m", "M", 0),
        new("l", "L", 10),
        new("xl", "XL", 15),
    ];

    private static readonly ColorOption[] _colors =
    [
        new("silver", "Silver", "#C0C0C0"),
        new("gold", "Gold", "#D4AF37"),
        new("rose-gold", "Rose Gold", "#B76E79"),
        new("black", "Matte Black", "#2C2C2C"),
        new("platinum", "Platinum", "#E5E4E2"),
    ];

    private static readonly MaterialOption[] _materials =
    [
        new("standard", "Sterling Silver", "925 sterling silver, rhodium plated", 0),
        new("premium", "14K Gold Fill", "Thick gold layer over sterling base", 60),
        new("luxury", "Solid 14K Gold", "Solid 14-karat gold throughout", 280),
    ];

    private string _size = "m";
    private string _color = "silver";
    private string _material = "standard";
    private string _engraving = "";

    private SizeOption _selectedSize => Array.Find(_sizes, s => s.Value == _size) ?? _sizes[2];
    private ColorOption _selectedColor => Array.Find(_colors, c => c.Value == _color) ?? _colors[0];
    private MaterialOption _selectedMaterial => Array.Find(_materials, m => m.Value == _material) ?? _materials[0];
    private double _engravingCost => _engraving.Length > 0 ? _engraving.Length * _engravingPricePerChar : 0;
    private double _totalAdjustment => _selectedSize.PriceDelta + _selectedMaterial.PriceDelta + _engravingCost;
    private double _totalPrice => _basePrice + _totalAdjustment;
}
