@* ============================================================
   Block: checkout-breadcrumb-nav
   Title: CheckoutBreadcrumbNav
   Description: A checkout flow with breadcrumb navigation for React and Next.js featuring clickable completed steps, current step as plain text, item count display, and a back-to-cart link using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-breadcrumb-nav.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Breadcrumb navigation *@
        <nav aria-label="Checkout steps" class="border-b px-4 py-3">
            <ol class="flex flex-wrap items-center gap-1">
                <li>
                    <button type="button" @onclick="@(() => GoToStep(1))"
                            class="flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground">
                        <LucideIconCn Name="shopping-cart" Size="12" Class="size-3" />
                        <span>Cart</span>
                        <span class="rounded-full bg-muted px-1.5 py-0.5 font-medium text-[10px] tabular-nums">
                            @_itemCount
                        </span>
                    </button>
                </li>
                @foreach (var step in _steps.Skip(1))
                {
                    var s = step;
                    <li class="flex items-center gap-1">
                        <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-muted-foreground/50" />
                        @if (s.Id < _currentStep)
                        {
                            <button type="button" @onclick="@(() => GoToStep(s.Id))"
                                    class="text-xs text-muted-foreground transition-colors hover:text-foreground hover:underline">
                                @s.Label
                            </button>
                        }
                        else if (s.Id == _currentStep)
                        {
                            <span aria-current="step" class="font-medium text-xs">@s.Label</span>
                        }
                        else
                        {
                            <span class="text-muted-foreground/50 text-xs">@s.Label</span>
                        }
                    </li>
                }
            </ol>
        </nav>

        @* Step 1: Cart *@
        @if (_currentStep == 1)
        {
            <div>
                @foreach (var item in _cartItems)
                {
                    var idx = Array.IndexOf(_cartItems, item);
                    <div class="@Cn.Merge("flex items-center justify-between px-4 py-3", idx < _cartItems.Length - 1 ? "border-b" : "")">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@item.Name</span>
                            <p class="text-muted-foreground text-xs">@item.Variant &middot; Qty @item.Qty</p>
                        </div>
                        <span class="ml-4 shrink-0 text-sm tabular-nums">$@((item.Price * item.Qty).ToString("F2"))</span>
                    </div>
                }
                <div class="border-t px-4 py-3">
                    <div class="flex justify-between font-medium text-sm">
                        <span>Subtotal (@_itemCount items)</span>
                        <span class="tabular-nums">$@(_subtotal.ToString("F2"))</span>
                    </div>
                </div>
            </div>
        }

        @* Step 2: Shipping *@
        @if (_currentStep == 2)
        {
            <div class="px-4 py-4">
                <div class="mb-3 flex items-center gap-2">
                    <LucideIconCn Name="truck" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Shipping Address</span>
                </div>
                <div class="space-y-3">
                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="bn-first" Class="text-xs">First name</LabelCn>
                            <InputCn Id="bn-first" Placeholder="Jane" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="bn-last" Class="text-xs">Last name</LabelCn>
                            <InputCn Id="bn-last" Placeholder="Smith" />
                        </div>
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="bn-email" Class="text-xs">Email</LabelCn>
                        <InputCn Id="bn-email" Type="email" Placeholder="@("jane@example.com")" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="bn-address" Class="text-xs">Street address</LabelCn>
                        <InputCn Id="bn-address" Placeholder="742 Evergreen Terrace" />
                    </div>
                    <div class="grid grid-cols-3 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="bn-city" Class="text-xs">City</LabelCn>
                            <InputCn Id="bn-city" Placeholder="Portland" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="bn-state" Class="text-xs">State</LabelCn>
                            <InputCn Id="bn-state" Placeholder="OR" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="bn-zip" Class="text-xs">Zip code</LabelCn>
                            <InputCn Id="bn-zip" Placeholder="97201" />
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Step 3: Payment *@
        @if (_currentStep == 3)
        {
            <div class="px-4 py-4">
                <div class="mb-3 flex items-center gap-2">
                    <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Payment Details</span>
                </div>
                <div class="space-y-3">
                    <div class="space-y-1.5">
                        <LabelCn For="bn-card-name" Class="text-xs">Name on card</LabelCn>
                        <InputCn Id="bn-card-name" Placeholder="Jane Smith" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="bn-card" Class="text-xs">Card number</LabelCn>
                        <InputCn Id="bn-card" Placeholder="4242 4242 4242 4242" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="bn-expiry" Class="text-xs">Expiry</LabelCn>
                            <InputCn Id="bn-expiry" Placeholder="MM / YY" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="bn-cvv" Class="text-xs">CVV</LabelCn>
                            <InputCn Id="bn-cvv" Placeholder="123" />
                        </div>
                    </div>
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-muted-foreground text-xs">
                            Your card will be charged $@(_total.ToString("F2")) including tax and shipping.
                        </p>
                    </div>
                </div>
            </div>
        }

        @* Step 4: Review *@
        @if (_currentStep == 4)
        {
            <div class="px-4 py-4">
                <span class="mb-3 block font-medium text-sm">Order Review</span>

                <div class="mb-3 rounded-md bg-muted/50 p-3">
                    <span class="font-medium text-muted-foreground text-xs">Shipping to</span>
                    <p class="mt-1 text-sm">Jane Smith</p>
                    <p class="text-muted-foreground text-xs">742 Evergreen Terrace, Portland, OR 97201</p>
                </div>

                <div class="mb-3 rounded-md bg-muted/50 p-3">
                    <span class="font-medium text-muted-foreground text-xs">Payment</span>
                    <p class="mt-1 text-sm">Card ending in 4242</p>
                </div>

                @foreach (var item in _cartItems)
                {
                    var idx = Array.IndexOf(_cartItems, item);
                    <div class="@Cn.Merge("flex items-center justify-between py-2", idx < _cartItems.Length - 1 ? "border-b" : "")">
                        <div>
                            <span class="text-sm">@item.Name</span>
                            <p class="text-muted-foreground text-xs">@item.Variant &middot; Qty @item.Qty</p>
                        </div>
                        <span class="text-sm tabular-nums">$@((item.Price * item.Qty).ToString("F2"))</span>
                    </div>
                }

                <div class="mt-3 space-y-1 border-t pt-3">
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Subtotal</span>
                        <span class="tabular-nums">$@(_subtotal.ToString("F2"))</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Shipping</span>
                        <span class="tabular-nums">$@(_shipping.ToString("F2"))</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Tax</span>
                        <span class="tabular-nums">$@(_tax.ToString("F2"))</span>
                    </div>
                    <div class="flex justify-between border-t pt-1.5 font-medium text-sm">
                        <span>Total</span>
                        <span class="tabular-nums">$@(_total.ToString("F2"))</span>
                    </div>
                </div>
            </div>
        }

        @* Navigation *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                      OnClick="@(() => _currentStep = Math.Max(1, _currentStep - 1))"
                      Disabled="@(_currentStep == 1)">
                <LucideIconCn Name="chevron-left" Size="14" Class="size-3.5" />
                @(_currentStep == 1 ? "Back" : _currentStep == 2 ? "Back to cart" : "Back")
            </ButtonCn>

            @if (_currentStep < 4)
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs"
                          OnClick="@(() => _currentStep = Math.Min(4, _currentStep + 1))">
                    Continue
                    <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5" />
                </ButtonCn>
            }
            else
            {
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Place Order &middot; $@(_total.ToString("F2"))
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record StepDef(int Id, string Label);
    private record CartItem(string Name, string Variant, int Qty, double Price);

    private static readonly StepDef[] _steps =
    [
        new(1, "Cart"),
        new(2, "Shipping"),
        new(3, "Payment"),
        new(4, "Review"),
    ];

    private static readonly CartItem[] _cartItems =
    [
        new("Mechanical Keyboard", "Cherry MX Brown", 1, 159.0),
        new("Desk Mat XL", "Dark Gray / 900x400mm", 1, 34.0),
        new("Monitor Light Bar", "Black", 1, 52.0),
    ];

    private int _currentStep = 2;

    private int _itemCount => _cartItems.Sum(i => i.Qty);
    private double _subtotal => _cartItems.Sum(i => i.Price * i.Qty);
    private const double _shipping = 7.99;
    private const double _tax = 18.52;
    private double _total => _subtotal + _shipping + _tax;

    private void GoToStep(int stepId)
    {
        if (stepId < _currentStep)
        {
            _currentStep = stepId;
        }
    }
}
