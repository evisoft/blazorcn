@* ============================================================
   Block: checkout-exchange-flow
   Title: CheckoutExchangeFlow
   Description: A product exchange flow for React and Next.js with current item display, variant selection for size and color, price difference indicator, exchange shipping options, and confirm button using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-exchange-flow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="arrow-right-left" Size="16" Class="size-4 text-muted-foreground" />
            <div>
                <span class="font-medium text-sm">Exchange Item</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Swap for a different size or color
                </p>
            </div>
        </div>

        @* Current item *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Current Item</span>
            <div class="flex items-center justify-between rounded-md bg-muted/50 px-3 py-2.5">
                <div>
                    <span class="font-medium text-sm">@_currentItem.Name</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_currentItem.Color &middot; Size @_currentItem.Size
                    </p>
                </div>
                <span class="text-sm tabular-nums">$@_currentItem.Price.ToString("F2")</span>
            </div>
        </div>

        @* New variant selection *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">New Variant</span>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <span class="text-xs text-muted-foreground">Size</span>
                    <SelectCn Value="@_newSize" ValueChanged="@((v) => { _newSize = v ?? _newSize; })">
                        <SelectTriggerCn Class="h-8 text-xs" aria-label="New size">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var sz in _availableSizes)
                            {
                                var sizeVal = sz;
                                <SelectItemCn Value="@sizeVal" Class="text-xs">@sizeVal</SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="space-y-1.5">
                    <span class="text-xs text-muted-foreground">Color</span>
                    <SelectCn Value="@_newColor" ValueChanged="@((v) => { _newColor = v ?? _newColor; })">
                        <SelectTriggerCn Class="h-8 text-xs" aria-label="New color">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var col in _availableColors)
                            {
                                var colorItem = col;
                                <SelectItemCn Value="@colorItem.Value" Class="text-xs">
                                    @colorItem.Label
                                    @if (colorItem.Price != _currentItem.Price)
                                    {
                                        <span class="ml-1 text-muted-foreground">
                                            (+$@((colorItem.Price - _currentItem.Price).ToString("F2")))
                                        </span>
                                    }
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Price difference *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Price difference</span>
            @if (_priceDiff == 0)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    No difference
                </BadgeCn>
            }
            else if (_priceDiff > 0)
            {
                <span class="flex items-center gap-1 font-medium text-amber-600 text-sm tabular-nums dark:text-amber-400">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />$@_priceDiff.ToString("F2") additional
                </span>
            }
            else
            {
                <span class="flex items-center gap-1 font-medium text-emerald-600 text-sm tabular-nums dark:text-emerald-400">
                    <LucideIconCn Name="minus" Size="12" Class="size-3" />$@Math.Abs(_priceDiff).ToString("F2") credit
                </span>
            }
        </div>

        @* Shipping options *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Exchange Shipping
            </span>
            <RadioGroupCn @bind-Value="_shippingOption">
                <label for="ef-ship-standard" class="flex cursor-pointer items-center justify-between rounded-md px-2 py-2 transition-colors hover:bg-muted/50">
                    <div class="flex items-center gap-3">
                        <RadioGroupItemCn Id="ef-ship-standard" Value="standard" aria-label="Standard exchange shipping" />
                        <div>
                            <span class="font-medium text-sm">Standard</span>
                            <p class="text-muted-foreground text-xs">5-7 business days</p>
                        </div>
                    </div>
                    <span class="text-sm">Free</span>
                </label>
                <label for="ef-ship-express" class="flex cursor-pointer items-center justify-between rounded-md px-2 py-2 transition-colors hover:bg-muted/50">
                    <div class="flex items-center gap-3">
                        <RadioGroupItemCn Id="ef-ship-express" Value="express" aria-label="Express exchange shipping" />
                        <div>
                            <span class="font-medium text-sm">Express</span>
                            <p class="text-muted-foreground text-xs">2-3 business days</p>
                        </div>
                    </div>
                    <span class="text-sm tabular-nums">$9.99</span>
                </label>
            </RadioGroupCn>
        </div>

        @* Confirm *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                Confirm Exchange
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                You'll receive a prepaid return label for the original item
            </p>
        </div>
    </div>
</section>

@code {
    private record CurrentItem(string Name, string Size, string Color, double Price);
    private record ColorOption(string Value, string Label, double Price);

    private static readonly CurrentItem _currentItem = new("Merino Wool Crewneck", "M", "Heather Gray", 89.0);

    private static readonly string[] _availableSizes = ["XS", "S", "M", "L", "XL", "XXL"];

    private static readonly ColorOption[] _availableColors =
    [
        new("heather-gray", "Heather Gray", 89.0),
        new("black",        "Black",        89.0),
        new("navy",         "Navy",         89.0),
        new("oatmeal",      "Oatmeal",      95.0),
        new("burgundy",     "Burgundy",     95.0),
    ];

    private string _newSize = "L";
    private string _newColor = "navy";
    private string _shippingOption = "standard";

    private double _newPrice => _availableColors.FirstOrDefault(c => c.Value == _newColor)?.Price ?? _currentItem.Price;
    private double _priceDiff => _newPrice - _currentItem.Price;
}
