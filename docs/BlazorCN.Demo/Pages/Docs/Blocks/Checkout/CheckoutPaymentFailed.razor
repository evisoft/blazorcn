@* ============================================================
   Block: checkout-payment-failed
   Title: CheckoutPaymentFailed
   Description: A payment failed error state for React and Next.js with error reason display, retry button, alternative payment option, support link, and order preserved notice using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-payment-failed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Error header *@
        <div class="border-b px-4 py-4">
            <div class="flex items-start gap-3">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-red-500/10">
                    <LucideIconCn Name="alert-circle" Size="16" Class="size-4 text-red-500" />
                </div>
                <div>
                    <span class="font-medium text-sm">Payment Failed</span>
                    <p class="mt-0.5 text-muted-foreground text-sm">@_errorDetails.Reason</p>
                </div>
            </div>
        </div>

        @* Order info *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="credit-card" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm">
                    @_errorDetails.CardBrand ending in @_errorDetails.CardLast4
                </span>
            </div>
            <span class="font-medium text-sm tabular-nums">
                $@_errorDetails.OrderTotal.ToString("F2")
            </span>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-4 space-y-2">
            <ButtonCn Size="ButtonSize.Sm" Class="w-full gap-2">
                <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                Retry Payment
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full gap-2">
                <LucideIconCn Name="credit-card" Size="14" Class="size-3.5" />
                Try a Different Payment Method
            </ButtonCn>
        </div>

        @* Order preserved notice *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                <LucideIconCn Name="shield-check" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                <div>
                    <span class="font-medium text-sm">Your order is preserved</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Order @_errorDetails.OrderNumber and your cart items are saved. You have 30 minutes
                        to complete payment before items are released.
                    </p>
                </div>
            </div>
        </div>

        <SeparatorCn />

        @* Support *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <LucideIconCn Name="headphones" Size="14" Class="size-3.5" />
                Need help? Contact support
            </div>
            <span class="font-medium text-xs">support@@acme.store</span>
        </div>
    </div>
</section>

@code {
    private record ErrorDetails(
        string Code,
        string Reason,
        string CardLast4,
        string CardBrand,
        double OrderTotal,
        string OrderNumber
    );

    private static readonly ErrorDetails _errorDetails = new(
        Code: "card_declined",
        Reason: "Your card was declined due to insufficient funds",
        CardLast4: "4242",
        CardBrand: "Visa",
        OrderTotal: 233.28,
        OrderNumber: "ORD-2938471"
    );
}
