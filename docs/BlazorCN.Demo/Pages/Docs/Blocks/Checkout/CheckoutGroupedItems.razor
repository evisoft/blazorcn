@* ============================================================
   Block: checkout-grouped-items
   Title: CheckoutGroupedItems
   Description: A checkout cart block that organizes items by category with collapsible groups, item counts per group, individual item details, and group subtotals for managing large diverse carts
   Source: original/blocks/checkout/checkout-grouped-items.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Your Cart</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_totalItems items across @_groups.Length categories
                </p>
            </div>
            <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
        </div>

        @* Groups *@
        <div>
            @for (var gi = 0; gi < _groups.Length; gi++)
            {
                var grp = _groups[gi];
                var groupIndex = gi;
                var isExpanded = _expandedGroups.Contains(grp.Id);
                var isLastGroup = groupIndex == _groups.Length - 1;
                var subtotal = GroupSubtotal(grp);
                <div class="@Cn.Merge(!isLastGroup || isExpanded ? "border-b" : "")">
                    @* Group header *@
                    <button type="button"
                            @onclick="@(() => ToggleGroup(grp.Id))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right"
                                      Size="16"
                                      Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@grp.Label</span>
                            <span class="ml-2 text-muted-foreground text-xs">
                                @grp.Items.Length @(grp.Items.Length == 1 ? "item" : "items")
                            </span>
                        </div>
                        <span class="shrink-0 font-medium text-sm tabular-nums">
                            $@subtotal.ToString("F2")
                        </span>
                    </button>

                    @* Items *@
                    @if (isExpanded)
                    {
                        <div>
                            @for (var ii = 0; ii < grp.Items.Length; ii++)
                            {
                                var item = grp.Items[ii];
                                var itemIndex = ii;
                                var isLastItem = itemIndex == grp.Items.Length - 1;
                                <div class="@Cn.Merge("flex items-center gap-3 py-2.5 pr-4 pl-11", !isLastItem ? "border-b border-dashed" : "")">
                                    <div class="size-8 shrink-0 rounded bg-muted/50"></div>
                                    <div class="min-w-0 flex-1">
                                        <span class="text-sm">@item.Name</span>
                                        <p class="mt-0.5 truncate text-muted-foreground text-xs">
                                            @item.Variant
                                        </p>
                                    </div>
                                    <div class="shrink-0 text-right">
                                        <span class="text-sm tabular-nums">
                                            $@((item.Price * item.Qty).ToString("F2"))
                                        </span>
                                        @if (item.Qty > 1)
                                        {
                                            <p class="mt-0.5 text-muted-foreground text-xs">
                                                Qty @item.Qty x $@item.Price.ToString("F2")
                                            </p>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Summary *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Order Total</span>
                <span class="font-semibold text-sm tabular-nums">$@_cartTotal.ToString("F2")</span>
            </div>
            <ButtonCn Class="mt-3 w-full" Size="ButtonSize.Sm">Continue to Shipping</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record CartItem(string Id, string Name, string Variant, int Qty, double Price);
    private record ItemGroup(string Id, string Label, CartItem[] Items);

    private static readonly ItemGroup[] _groups =
    [
        new("electronics", "Electronics",
        [
            new("e1", "Wireless Earbuds",   "Midnight Black",          1, 79.99),
            new("e2", "USB-C Hub Adapter",  "Space Gray",               2, 34.99),
            new("e3", "Phone Case",         "Clear / iPhone 15 Pro",    1, 29.99),
        ]),
        new("clothing", "Clothing",
        [
            new("c1", "Merino Crew Neck",   "Heather Gray / L",         1, 68.0),
            new("c2", "Slim Chinos",        "Navy / 32x32",             1, 89.0),
        ]),
        new("home", "Home & Kitchen",
        [
            new("h1", "Pour-Over Coffee Dripper", "Ceramic / White",        1, 42.0),
            new("h2", "Linen Napkin Set",          "Oatmeal / Pack of 4",   1, 36.0),
            new("h3", "Stoneware Mug",             "Sage / 12 oz",           2, 18.0),
        ]),
    ];

    private List<string> _expandedGroups = ["electronics"];

    private static double GroupSubtotal(ItemGroup grp) =>
        grp.Items.Sum(i => i.Price * i.Qty);

    private double _cartTotal => _groups.Sum(g => GroupSubtotal(g));
    private int _totalItems => _groups.Sum(g => g.Items.Sum(i => i.Qty));

    private void ToggleGroup(string id)
    {
        if (_expandedGroups.Contains(id))
            _expandedGroups = _expandedGroups.Where(g => g != id).ToList();
        else
            _expandedGroups = [.._expandedGroups, id];
    }
}
