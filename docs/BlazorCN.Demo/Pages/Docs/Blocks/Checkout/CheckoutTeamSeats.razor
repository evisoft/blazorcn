@* ============================================================
   Block: checkout-team-seats
   Title: CheckoutTeamSeats
   Description: A team seat-based checkout for React and Next.js with seat count selector, per-seat pricing, volume discount tiers, admin email input, bulk invite textarea, and order total using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-team-seats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Team Plan</span>
            </div>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Add seats for your team. Volume discounts applied automatically.
            </p>
        </div>

        @* Seat selector *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Number of seats</span>
                <div class="flex items-center gap-2">
                    <button aria-label="Decrease seats"
                        type="button"
                        @onclick="@(() => DecrementSeats())"
                        disabled="@(_seats <= 1)"
                        class="flex size-8 items-center justify-center rounded-md border transition-colors hover:bg-muted/50 disabled:opacity-50">
                        <LucideIconCn Name="minus" Size="16" Class="size-4" />
                    </button>
                    <span class="w-12 text-center font-semibold text-lg tabular-nums">@_seats</span>
                    <button aria-label="Increase seats"
                        type="button"
                        @onclick="@(() => IncrementSeats())"
                        disabled="@(_seats >= 100)"
                        class="flex size-8 items-center justify-center rounded-md border transition-colors hover:bg-muted/50 disabled:opacity-50">
                        <LucideIconCn Name="plus" Size="16" Class="size-4" />
                    </button>
                </div>
            </div>
            <div class="mt-2 flex items-center gap-2">
                <span class="text-muted-foreground text-xs">
                    $@ActiveTier.PricePerSeat/seat/@BillingCycle
                </span>
                @if (Savings > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs text-emerald-600 dark:text-emerald-400">
                        Save $@Savings/@BillingCycle
                    </BadgeCn>
                }
            </div>
        </div>

        @* Volume discount tiers *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Volume pricing
            </span>
            <div class="space-y-0">
                @{
                    var tierList = _discountTiers.ToList();
                }
                @foreach (var t in tierList)
                {
                    var tier = t;
                    var isActive = ActiveTier.MinSeats == tier.MinSeats;
                    var isLast = tierList.IndexOf(tier) == tierList.Count - 1;
                    <div class="@Cn.Merge("flex items-center justify-between py-1.5", !isLast ? "border-b" : "")">
                        <div class="flex items-center gap-2">
                            @if (isActive)
                            {
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            }
                            <span class="@Cn.Merge("text-xs", isActive ? "font-medium" : "text-muted-foreground")">
                                @tier.Label
                                @if (tier.MinSeats > 1)
                                {
                                    <span class="text-muted-foreground"> (@tier.MinSeats+ seats)</span>
                                }
                            </span>
                        </div>
                        <span class="@Cn.Merge("text-xs tabular-nums", isActive ? "font-medium" : "text-muted-foreground")">
                            $@tier.PricePerSeat/seat
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Admin email *@
        <div class="border-b px-4 py-3">
            <div class="space-y-1.5">
                <LabelCn For="ts-admin" Class="text-xs">
                    Team admin email
                </LabelCn>
                <InputCn Id="ts-admin" Type="email" Placeholder="@("admin@company.com")" @bind-Value="_adminEmail" />
            </div>
        </div>

        @* Bulk invite *@
        <div class="border-b px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <LabelCn For="ts-invites" Class="text-xs">
                        Invite team members
                    </LabelCn>
                    @if (InviteCount > 0)
                    {
                        <span class="text-muted-foreground text-xs tabular-nums">
                            @InviteCount email@(InviteCount != 1 ? "s" : "")
                        </span>
                    }
                </div>
                <TextareaCn Id="ts-invites" Placeholder="@("alice@company.com\nbob@company.com\ncarol@company.com")" @bind-Value="_inviteEmails" Rows="4" Class="resize-none text-sm" />
                <p class="text-muted-foreground text-xs">
                    One email per line. Invites sent after purchase.
                </p>
            </div>
        </div>

        @* Summary *@
        <div class="border-b px-4 py-3 space-y-1.5">
            <div class="flex justify-between text-sm">
                <span class="text-muted-foreground">
                    @_seats seats &times; $@ActiveTier.PricePerSeat/@BillingCycle
                </span>
                <span class="tabular-nums">$@Total.00</span>
            </div>
            @if (Savings > 0)
            {
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Volume discount</span>
                    <span class="tabular-nums text-emerald-600 dark:text-emerald-400">
                        -$@Savings.00
                    </span>
                </div>
            }
            <div class="flex justify-between border-t pt-1.5 text-sm font-medium">
                <span>Total</span>
                <span class="tabular-nums">
                    $@Total.00/@BillingCycle
                </span>
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">Purchase @_seats Seats</ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Need more than 100 seats? <span class="underline">Contact sales</span>
            </p>
        </div>
    </div>
</section>

@code {
    private record DiscountTier(int MinSeats, int PricePerSeat, string Label);

    private const string BillingCycle = "month";

    private static readonly DiscountTier[] _discountTiers =
    [
        new(1,  29, "Standard"),
        new(5,  25, "5+ seats"),
        new(10, 22, "10+ seats"),
        new(25, 18, "25+ seats"),
        new(50, 15, "50+ seats"),
    ];

    private int _seats = 5;
    private string _adminEmail = "";
    private string _inviteEmails = "";

    private DiscountTier ActiveTier => GetActiveTier(_seats);
    private int Total => _seats * ActiveTier.PricePerSeat;
    private int StandardTotal => _seats * _discountTiers[0].PricePerSeat;
    private int Savings => StandardTotal - Total;

    private int InviteCount =>
        _inviteEmails
            .Split(new[] { '\n', ',' }, StringSplitOptions.None)
            .Select(e => e.Trim())
            .Count(e => e.Length > 0);

    private static DiscountTier GetActiveTier(int seats)
    {
        var active = _discountTiers[0];
        foreach (var tier in _discountTiers)
        {
            if (seats >= tier.MinSeats)
                active = tier;
        }
        return active;
    }

    private void DecrementSeats()
    {
        _seats = Math.Max(1, _seats - 1);
    }

    private void IncrementSeats()
    {
        _seats = Math.Min(100, _seats + 1);
    }
}
