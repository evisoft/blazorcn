@* ============================================================
   Block: checkout-persistent-summary
   Title: CheckoutPersistentSummary
   Description: A two-panel checkout block for React and Next.js with a scrollable shipping and payment form on the left and a sticky order summary with items, totals, and pay button on the right using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-persistent-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col md:flex-row">
            @* Left panel - scrollable form *@
            <div class="min-w-0 flex-1 md:border-r">
                @* Header *@
                <div class="flex items-center gap-2 border-b px-4 py-3">
                    <LucideIconCn Name="lock" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Checkout</span>
                </div>

                @* Shipping section *@
                <div class="border-b px-4 py-4">
                    <div class="mb-3 flex items-center gap-2">
                        <LucideIconCn Name="truck" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="font-medium text-sm">Shipping Address</span>
                    </div>

                    <div class="space-y-3">
                        <div class="grid grid-cols-2 gap-3">
                            <div class="space-y-1.5">
                                <LabelCn For="ps-first" Class="text-xs">First name</LabelCn>
                                <InputCn Id="ps-first" Placeholder="Jane" @bind-Value="_firstName" />
                            </div>
                            <div class="space-y-1.5">
                                <LabelCn For="ps-last" Class="text-xs">Last name</LabelCn>
                                <InputCn Id="ps-last" Placeholder="Smith" @bind-Value="_lastName" />
                            </div>
                        </div>

                        <div class="space-y-1.5">
                            <LabelCn For="ps-email" Class="text-xs">Email</LabelCn>
                            <InputCn Id="ps-email" Type="email" Placeholder="@("jane@example.com")" @bind-Value="_email" />
                        </div>

                        <div class="space-y-1.5">
                            <LabelCn For="ps-address" Class="text-xs">Street address</LabelCn>
                            <InputCn Id="ps-address" Placeholder="123 Main St, Apt 4B" @bind-Value="_address" />
                        </div>

                        <div class="grid grid-cols-3 gap-3">
                            <div class="space-y-1.5">
                                <LabelCn For="ps-city" Class="text-xs">City</LabelCn>
                                <InputCn Id="ps-city" Placeholder="San Francisco" @bind-Value="_city" />
                            </div>
                            <div class="space-y-1.5">
                                <LabelCn For="ps-state" Class="text-xs">State</LabelCn>
                                <SelectCn @bind-Value="_state">
                                    <SelectTriggerCn id="ps-state" class="w-full">
                                        <SelectValueCn Placeholder="State" />
                                    </SelectTriggerCn>
                                    <SelectContentCn>
                                        <SelectItemCn Value="CA">California</SelectItemCn>
                                        <SelectItemCn Value="NY">New York</SelectItemCn>
                                        <SelectItemCn Value="TX">Texas</SelectItemCn>
                                        <SelectItemCn Value="WA">Washington</SelectItemCn>
                                        <SelectItemCn Value="IL">Illinois</SelectItemCn>
                                    </SelectContentCn>
                                </SelectCn>
                            </div>
                            <div class="space-y-1.5">
                                <LabelCn For="ps-zip" Class="text-xs">Zip code</LabelCn>
                                <InputCn Id="ps-zip" Placeholder="94102" @bind-Value="_zip" />
                            </div>
                        </div>
                    </div>
                </div>

                @* Payment section *@
                <div class="px-4 py-4">
                    <div class="mb-3 flex items-center gap-2">
                        <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="font-medium text-sm">Payment Method</span>
                    </div>

                    <div class="space-y-3">
                        <div class="space-y-1.5">
                            <LabelCn For="ps-name-card" Class="text-xs">Name on card</LabelCn>
                            <InputCn Id="ps-name-card" Placeholder="Jane Smith" @bind-Value="_nameOnCard" />
                        </div>

                        <div class="space-y-1.5">
                            <LabelCn For="ps-card" Class="text-xs">Card number</LabelCn>
                            <InputCn Id="ps-card" Placeholder="4242 4242 4242 4242" @bind-Value="_cardNumber" />
                        </div>

                        <div class="grid grid-cols-2 gap-3">
                            <div class="space-y-1.5">
                                <LabelCn For="ps-expiry" Class="text-xs">Expiry date</LabelCn>
                                <InputCn Id="ps-expiry" Placeholder="MM / YY" @bind-Value="_expiry" />
                            </div>
                            <div class="space-y-1.5">
                                <LabelCn For="ps-cvv" Class="text-xs">CVV</LabelCn>
                                <InputCn Id="ps-cvv" Placeholder="123" @bind-Value="_cvv" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Right panel - sticky summary *@
            <div class="w-full border-t md:w-72 md:border-t-0 lg:w-80">
                <div class="md:sticky md:top-0">
                    @* Summary header *@
                    <div class="border-b px-4 py-3">
                        <span class="font-medium text-sm">Order Summary</span>
                        <span class="ml-2 text-muted-foreground text-xs">@_orderItems.Length items</span>
                    </div>

                    @* Items *@
                    <div class="border-b">
                        @for (int i = 0; i < _orderItems.Length; i++)
                        {
                            var item = _orderItems[i];
                            var isLast = i == _orderItems.Length - 1;
                            <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                                <div class="@Cn.Merge("size-9 shrink-0 rounded-md", item.Color)"></div>
                                <div class="min-w-0 flex-1">
                                    <span class="truncate text-xs">@item.Name</span>
                                    <p class="text-muted-foreground text-xs">@item.Variant</p>
                                </div>
                                <span class="shrink-0 font-medium text-xs tabular-nums">$@(item.Price.ToString("F2"))</span>
                            </div>
                        }
                    </div>

                    @* Totals *@
                    <div class="space-y-1.5 border-b px-4 py-3">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Subtotal</span>
                            <span class="tabular-nums">$@(_subtotal.ToString("F2"))</span>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Shipping</span>
                            <span class="tabular-nums">$@(_shipping.ToString("F2"))</span>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Tax</span>
                            <span class="tabular-nums">$@(_tax.ToString("F2"))</span>
                        </div>
                        <div class="flex items-center justify-between border-t pt-1.5 font-medium text-sm">
                            <span>Total</span>
                            <span class="tabular-nums">$@(_total.ToString("F2"))</span>
                        </div>
                    </div>

                    @* Pay button *@
                    <div class="px-4 py-3">
                        <ButtonCn Class="w-full">Pay $@(_total.ToString("F2"))</ButtonCn>
                        <p class="mt-2 flex items-center justify-center gap-1 text-muted-foreground text-xs">
                            <LucideIconCn Name="lock" Size="12" Class="size-3" />
                            Encrypted and secure
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record OrderItem(string Id, string Name, string Variant, double Price, int Quantity, string Color);

    private static readonly OrderItem[] _orderItems =
    [
        new("ps-1", "Ergonomic Office Chair", "Graphite / Standard", 449, 1, "bg-zinc-400 dark:bg-zinc-600"),
        new("ps-2", "Monitor Arm Mount", "Dual / Matte Black", 129, 1, "bg-stone-300 dark:bg-stone-700"),
        new("ps-3", "Desk Organizer Set", "Walnut / 5-piece", 65, 1, "bg-amber-200 dark:bg-amber-800"),
        new("ps-4", "LED Desk Lamp", "White / USB-C", 78, 1, "bg-sky-200 dark:bg-sky-800"),
    ];

    private static readonly double _subtotal = _orderItems.Sum(x => x.Price * x.Quantity);
    private const double _shipping = 14.99;
    private const double _tax = 57.68;
    private static readonly double _total = _subtotal + _shipping + _tax;

    private string _firstName = "";
    private string _lastName = "";
    private string _email = "";
    private string _address = "";
    private string _city = "";
    private string _state = "";
    private string _zip = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";
    private string _nameOnCard = "";
}
