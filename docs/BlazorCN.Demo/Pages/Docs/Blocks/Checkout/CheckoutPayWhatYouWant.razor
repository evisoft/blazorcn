@* ============================================================
   Block: checkout-pay-what-you-want
   Title: CheckoutPayWhatYouWant
   Description: A pay-what-you-want checkout for React and Next.js with suggested price, minimum price, average paid indicator, custom price slider, contributor count, and above-average badge using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-pay-what-you-want.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">@_productName</span>
            <p class="mt-0.5 text-muted-foreground text-xs">@_productDescription</p>
        </div>

        @* Pricing context *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="users" Size="14" Class="size-3.5" />
                    <span class="tabular-nums">@_totalContributors.ToString("N0")</span>
                    <span>contributors</span>
                </div>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <span class="text-muted-foreground text-xs">
                    Avg paid <span class="font-medium tabular-nums">$@_averagePaid</span>
                </span>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <span class="text-muted-foreground text-xs">
                    Min <span class="font-medium tabular-nums">$@_minPrice</span>
                </span>
            </div>
        </div>

        @* Price display *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Name your price</span>
                @if (_isAboveAverage)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="heart" Size="12" Class="size-3" />
                        Above average
                    </BadgeCn>
                }
            </div>

            @* Amount input *@
            <div class="mt-3 flex items-center gap-3">
                <span class="font-semibold text-2xl text-muted-foreground">$</span>
                <InputCn aria-label="Payment amount" Type="number"
                         Value="@_price.ToString()"
                         ValueChanged="@((string v) => HandleInputChange(v))"
                         Class="h-10 border-0 bg-transparent px-0 font-semibold text-2xl shadow-none tabular-nums focus-visible:ring-0" />
            </div>

            @* Slider *@
            <div class="mt-4">
                <SliderCn aria-label="Choose your price" Value="@((double)_price)"
                          ValueChanged="@((double v) => _price = (int)v)"
                          Min="@((double)_minPrice)"
                          Max="100"
                          Step="1"
                          Class="w-full" />
                <div class="mt-1.5 flex justify-between text-muted-foreground text-xs tabular-nums">
                    <span>$@_minPrice</span>
                    <span>$@_suggestedPrice suggested</span>
                    <span>$100</span>
                </div>
            </div>
        </div>

        @* Quick presets *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Quick select</span>
            <div class="flex gap-2">
                @foreach (var val in _presets)
                {
                    var amount = val;
                    <button type="button"
                            @onclick="@(() => _price = amount)"
                            class="@Cn.Merge("h-8 flex-1 rounded-md text-sm tabular-nums transition-colors", _price == amount ? "bg-foreground text-background" : "bg-muted/50 text-foreground hover:bg-muted")">
                        $@amount
                    </button>
                }
            </div>
        </div>

        @* Summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-sm">Total</span>
                <span class="font-semibold text-sm tabular-nums">$@($"{_price}.00")</span>
            </div>
            @if (_isAboveAverage)
            {
                <p class="mt-1 text-emerald-600 text-xs dark:text-emerald-400">
                    You're paying $@(_price - _averagePaid) more than average. Thank you for your support!
                </p>
            }
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">Pay $@($"{_price}.00")</ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Secure payment. Instant download after purchase.
            </p>
        </div>

    </div>
</section>

@code {
    private const string _productName = "Indie UI Kit";
    private const string _productDescription = "200+ handcrafted components for your next project";
    private const int _minPrice = 5;
    private const int _suggestedPrice = 25;
    private const int _averagePaid = 19;
    private const int _totalContributors = 1247;

    private static readonly int[] _presets = [10, 15, 25, 50];

    private int _price = _suggestedPrice;

    private bool _isAboveAverage => _price > _averagePaid;

    private void HandleInputChange(string value)
    {
        if (int.TryParse(value, out var num) && num >= _minPrice)
        {
            _price = num;
        }
        else if (string.IsNullOrEmpty(value))
        {
            _price = _minPrice;
        }
    }
}
