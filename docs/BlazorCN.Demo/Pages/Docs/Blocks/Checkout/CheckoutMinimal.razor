@* ============================================================
   Block: checkout-minimal
   Title: CheckoutMinimal
   Description: An ultra-minimal checkout form for React and Next.js with only email, card number, and pay button using shadcn/ui Input, Label, Button, and Tailwind CSS
   Source: original/blocks/checkout/checkout-minimal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with price *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">@_productName</span>
            <span class="font-semibold text-2xl tabular-nums">$@(_price.ToString("F2"))</span>
        </div>

        @* Email field *@
        <div class="border-b px-4 py-4">
            <div class="space-y-1.5">
                <LabelCn For="min-email" Class="text-xs">Email</LabelCn>
                <InputCn Id="min-email" Type="email" Placeholder="@("you@example.com")" @bind-Value="_email" />
            </div>
        </div>

        @* Card fields *@
        <div class="border-b px-4 py-4">
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="min-card" Class="text-xs">Card number</LabelCn>
                    <InputCn Id="min-card" Placeholder="4242 4242 4242 4242" @bind-Value="_cardNumber" />
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="min-expiry" Class="text-xs">Expiry</LabelCn>
                        <InputCn Id="min-expiry" Placeholder="MM / YY" @bind-Value="_expiry" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="min-cvv" Class="text-xs">CVV</LabelCn>
                        <InputCn Id="min-cvv" Placeholder="123" @bind-Value="_cvv" />
                    </div>
                </div>
            </div>
        </div>

        @* Pay button *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">Pay $@(_price.ToString("F2"))</ButtonCn>
            <p class="mt-2 flex items-center justify-center gap-1 text-muted-foreground text-xs">
                <LucideIconCn Name="lock" Size="12" Class="size-3" />
                Encrypted and secure
            </p>
        </div>
    </div>
</section>

@code {
    private const string _productName = "Pro Plan — Annual";
    private const double _price = 229.0;

    private string _email = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";
}
