@* ============================================================
   Block: checkout-save-for-later
   Title: CheckoutSaveForLater
   Description: A React and Next.js cart block with active cart items and a separate saved for later section, move between lists buttons, and order summary using shadcn/ui Button, Badge, and Tailwind CSS
   Source: original/blocks/checkout/checkout-save-for-later.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Cart header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Cart</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_cart.Count @(_cart.Count == 1 ? "item" : "items")
            </BadgeCn>
        </div>

        @* Active cart items *@
        @if (_cart.Count == 0)
        {
            <div class="border-b px-4 py-8 text-center text-muted-foreground text-sm">
                Your cart is empty
            </div>
        }
        else
        {
            <div>
                @foreach (var it in _cart)
                {
                    var item = it;
                    <div class="px-4 py-3 border-b">
                        <div class="flex items-start gap-3">
                            <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50 font-mono text-muted-foreground text-xs">
                                @item.Image
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-start justify-between gap-2">
                                    <div>
                                        <span class="font-medium text-sm">@item.Name</span>
                                        <p class="text-muted-foreground text-xs">@item.Description</p>
                                    </div>
                                    <span class="shrink-0 font-semibold text-sm tabular-nums">
                                        $@((item.Price * item.Quantity).ToString("F2"))
                                    </span>
                                </div>
                                <div class="mt-2 flex items-center gap-2">
                                    <div class="flex items-center gap-1">
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-6 p-0" aria-label="@($"Decrease quantity of {item.Name}")" OnClick="@(() => UpdateQuantity(item.Id, -1))">
                                            <LucideIconCn Name="minus" Size="12" Class="size-3" />
                                        </ButtonCn>
                                        <span class="w-6 text-center text-xs tabular-nums">
                                            @item.Quantity
                                        </span>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-6 p-0" aria-label="@($"Increase quantity of {item.Name}")" OnClick="@(() => UpdateQuantity(item.Id, 1))">
                                            <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                        </ButtonCn>
                                    </div>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-muted-foreground text-xs" OnClick="@(() => MoveToSaved(item.Id))">
                                        <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                        Save for later
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto size-6 p-0 text-muted-foreground" aria-label="@($"Remove {item.Name} from cart")" OnClick="@(() => RemoveFromCart(item.Id))">
                                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* Order summary *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Subtotal</span>
                <span class="font-semibold text-lg tabular-nums">$@_subtotal.ToString("F2")</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">
                Shipping and taxes calculated at checkout
            </p>
        </div>

        @* Checkout button *@
        <div class="border-b px-4 py-3">
            <ButtonCn Class="w-full" Disabled="@(_cart.Count == 0)">Checkout</ButtonCn>
        </div>

        @* Saved for later section *@
        <div class="px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bookmark" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Saved for Later</span>
                <span class="text-muted-foreground text-xs">(@_saved.Count)</span>
            </div>
        </div>

        @if (_saved.Count == 0)
        {
            <div class="px-4 pb-4 text-center text-muted-foreground text-xs">No saved items</div>
        }
        else
        {
            <div>
                @{
                    var savedList = _saved.ToList();
                }
                @foreach (var it in savedList)
                {
                    var item = it;
                    var isLast = savedList.IndexOf(item) == savedList.Count - 1;
                    <div class="@Cn.Merge("px-4 py-2.5", isLast ? "" : "border-t")">
                        <div class="flex items-center gap-3">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded bg-muted/50 font-mono text-muted-foreground text-[10px]">
                                @item.Image
                            </div>
                            <div class="min-w-0 flex-1">
                                <span class="text-sm">@item.Name</span>
                                <span class="ml-2 text-muted-foreground text-xs tabular-nums">
                                    $@item.Price.ToString("F2")
                                </span>
                            </div>
                            <div class="flex items-center gap-1">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="@(() => MoveToCart(item.Id))">
                                    <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                                    Move to Cart
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-0 text-muted-foreground" aria-label="@($"Remove {item.Name} from saved items")" OnClick="@(() => RemoveFromSaved(item.Id))">
                                    <LucideIconCn Name="x" Size="12" Class="size-3" />
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record Product(string Id, string Name, string Description, string Image, double Price, int Quantity);

    private List<Product> _cart =
    [
        new("1", "Wireless Noise-Canceling Headphones", "Over-ear, 30hr battery, USB-C", "WH", 249.99, 1),
        new("2", "Mechanical Keyboard", "75% layout, hot-swap, RGB", "MK", 139.0, 1),
    ];

    private List<Product> _saved =
    [
        new("3", "Ergonomic Mouse", "Vertical design, 6 buttons, wireless", "EM", 69.99, 1),
        new("4", "USB-C Hub Adapter", "7-in-1, 4K HDMI, 100W passthrough", "UH", 45.0, 1),
        new("5", "Desk Mat XL", "900x400mm, stitched edges, non-slip", "DM", 34.99, 1),
    ];

    private double _subtotal => _cart.Sum(i => i.Price * i.Quantity);

    private void UpdateQuantity(string id, int delta)
    {
        _cart = _cart.Select(i =>
        {
            if (i.Id != id) return i;
            return i with { Quantity = Math.Max(1, i.Quantity + delta) };
        }).ToList();
    }

    private void MoveToSaved(string id)
    {
        var item = _cart.FirstOrDefault(i => i.Id == id);
        if (item is null) return;
        _cart = _cart.Where(i => i.Id != id).ToList();
        _saved = new List<Product> { item with { Quantity = 1 } }.Concat(_saved).ToList();
    }

    private void MoveToCart(string id)
    {
        var item = _saved.FirstOrDefault(i => i.Id == id);
        if (item is null) return;
        _saved = _saved.Where(i => i.Id != id).ToList();
        _cart = _cart.Concat(new[] { item with { Quantity = 1 } }).ToList();
    }

    private void RemoveFromCart(string id)
    {
        _cart = _cart.Where(i => i.Id != id).ToList();
    }

    private void RemoveFromSaved(string id)
    {
        _saved = _saved.Where(i => i.Id != id).ToList();
    }
}
