@* ============================================================
   Block: checkout-appointment-booking
   Title: CheckoutAppointmentBooking
   Description: A service appointment booking checkout block for React and Next.js with service type, provider name, date and time slot, duration, price, contact information form, and cancellation policy notice built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-appointment-booking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="scissors" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Appointment Booking</span>
            </div>
        </div>

        @* Service details *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Service</span>
            <p class="mt-1 font-medium text-sm">@_appointment.Service</p>
            <p class="mt-0.5 text-muted-foreground text-xs">@_appointment.Description</p>
            <div class="mt-2 flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    <LucideIconCn Name="clock" Size="12" Class="mr-1 size-3" />
                    @_appointment.Duration
                </BadgeCn>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    $@_appointment.Price
                </BadgeCn>
            </div>
        </div>

        @* Provider *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Provider</span>
            <div class="mt-1.5 flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="user" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div>
                    <p class="font-medium text-sm">@_appointment.Provider</p>
                    <p class="text-muted-foreground text-xs">@_appointment.ProviderRole</p>
                </div>
            </div>
        </div>

        @* Date and time *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Date &amp; time</span>
            <div class="mt-1.5 flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-sm">@_appointment.Date</span>
                </div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-sm">@_appointment.Time</span>
                </div>
            </div>
            <p class="mt-1.5 text-muted-foreground text-xs">
                @_location.Name · @_location.Address
            </p>
        </div>

        @* Contact information *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Contact information</span>
            <div class="mt-2 space-y-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="user" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <InputCn @bind-Value="_fullName" Placeholder="Full name" Class="h-8 text-sm" />
                </div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="mail" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <InputCn Type="email" @bind-Value="_email" Placeholder="Email address" Class="h-8 text-sm" />
                </div>
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="phone" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <InputCn Type="tel" @bind-Value="_phone" Placeholder="Phone number" Class="h-8 text-sm" />
                </div>
            </div>
            <p class="mt-1.5 text-muted-foreground text-xs">
                Confirmation will be sent to your email and phone
            </p>
        </div>

        @* Price breakdown *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Price breakdown</span>
            <div class="mt-2 space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">@_appointment.Service</span>
                    <span class="text-sm tabular-nums">$@_appointment.Price</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">Booking fee</span>
                    <span class="text-sm tabular-nums">$@_bookingFee</span>
                </div>
                <SeparatorCn />
                <div class="flex items-center justify-between">
                    <span class="font-medium text-sm">Total</span>
                    <span class="font-semibold text-sm tabular-nums">$@_total</span>
                </div>
            </div>
        </div>

        @* Cancellation policy *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <span class="font-medium text-muted-foreground text-xs">Cancellation policy</span>
                <p class="mt-1 text-sm leading-relaxed">
                    Free cancellation up to 24 hours before your appointment. Cancellations within 24
                    hours are charged a $25 late cancellation fee. No-shows are charged the full service
                    price.
                </p>
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                Book appointment
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record AppointmentInfo(
        string Service,
        string Description,
        string Provider,
        string ProviderRole,
        string Date,
        string Time,
        string Duration,
        int Price);

    private record LocationInfo(string Name, string Address);

    private static readonly AppointmentInfo _appointment = new(
        Service: "Haircut & Styling",
        Description: "Full haircut with wash, blow-dry, and styling",
        Provider: "Maria Santos",
        ProviderRole: "Senior Stylist",
        Date: "Thu, Apr 3, 2026",
        Time: "2:30 PM",
        Duration: "60 min",
        Price: 85);

    private static readonly LocationInfo _location = new(
        Name: "Studio Nova Salon",
        Address: "142 Market St, San Francisco, CA");

    private const int _bookingFee = 5;
    private int _total => _appointment.Price + _bookingFee;

    private string _fullName = "";
    private string _email = "";
    private string _phone = "";
}
