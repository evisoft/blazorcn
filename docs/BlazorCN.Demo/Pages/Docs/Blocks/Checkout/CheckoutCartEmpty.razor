@* ============================================================
   Block: checkout-cart-empty
   Title: CheckoutCartEmpty
   Description: An empty shopping cart state block for React and Next.js with shopping bag icon, call-to-action, recently viewed product thumbnails, and popular item suggestions using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-cart-empty.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shopping-bag" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Cart</span>
            <span class="ml-auto text-muted-foreground text-xs">0 items</span>
        </div>

        @* Empty state *@
        <div class="flex flex-col items-center border-b px-4 py-10">
            <div class="flex size-12 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="shopping-bag" Size="20" Class="size-5 text-muted-foreground" />
            </div>
            <p class="mt-4 font-medium text-sm">Your cart is empty</p>
            <p class="mt-1 text-muted-foreground text-xs">
                Looks like you haven&apos;t added anything yet.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-4 h-8 gap-1.5 text-xs">
                Continue Shopping
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

        @* Recently viewed *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Recently viewed</span>
            <div class="mt-3 grid grid-cols-4 gap-3">
                @foreach (var item in _recentlyViewed)
                {
                    <div class="group cursor-pointer">
                        <div class="@Cn.Merge("aspect-square rounded-md transition-opacity group-hover:opacity-80", item.Color)" />
                        <p class="mt-1.5 truncate text-xs">@item.Name</p>
                        <p class="text-muted-foreground text-xs tabular-nums">$@item.Price</p>
                    </div>
                }
            </div>
        </div>

        @* Popular items *@
        <div class="px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Popular right now</span>
            <div class="mt-2 space-y-0">
                @for (int i = 0; i < _popularItems.Length; i++)
                {
                    var item = _popularItems[i];
                    var isLast = i == _popularItems.Length - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 py-2.5", isLast ? "" : "border-b")">
                        <div class="@Cn.Merge("size-10 shrink-0 rounded-md", item.Color)" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm">@item.Name</span>
                            <p class="text-muted-foreground text-xs tabular-nums">$@item.Price</p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                            Add to cart
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Product(string Id, string Name, int Price, string Color);

    private static readonly Product[] _recentlyViewed =
    [
        new("rv-1", "Merino Wool Sweater", 128, "bg-zinc-300 dark:bg-zinc-600"),
        new("rv-2", "Canvas Tote Bag", 45, "bg-amber-200 dark:bg-amber-800"),
        new("rv-3", "Ceramic Pour-Over Set", 64, "bg-stone-300 dark:bg-stone-600"),
        new("rv-4", "Linen Shirt", 89, "bg-sky-200 dark:bg-sky-800"),
    ];

    private static readonly Product[] _popularItems =
    [
        new("pop-1", "Minimalist Watch", 195, "bg-zinc-200 dark:bg-zinc-700"),
        new("pop-2", "Leather Card Wallet", 55, "bg-amber-100 dark:bg-amber-900"),
        new("pop-3", "Stainless Water Bottle", 38, "bg-emerald-200 dark:bg-emerald-800"),
    ];
}
