@* ============================================================
   Block: checkout-gift-options
   Title: CheckoutGiftOptions
   Description: A checkout gift options block for React and Next.js with gift toggle, message textarea, gift wrapping selection with pricing, gift receipt switch, and recipient fields built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-gift-options.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="gift" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Gift options</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">Add a personal touch to your order</p>
        </div>

        @* Gift toggle *@
        <div class="border-b px-4 py-3">
            <span class="flex cursor-pointer items-center gap-2.5"
                  @onclick="@(() => _isGift = !_isGift)"
                  role="button"
                  tabindex="0">
                <CheckboxCn @bind-Checked="_isGift" />
                <div>
                    <span class="font-medium text-sm">This is a gift</span>
                    <p class="text-muted-foreground text-xs">
                        Add a message and choose wrapping options
                    </p>
                </div>
            </span>
        </div>

        @if (_isGift)
        {
            @* Recipient details *@
            <div class="border-b px-4 py-3">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">
                    Recipient
                </span>
                <div class="space-y-3">
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">Name</span>
                        <InputCn Placeholder="Alex Johnson" Class="h-8 text-sm" />
                    </div>
                    <div>
                        <span class="mb-1 block font-medium text-muted-foreground text-xs">
                            Email (for delivery notification)
                        </span>
                        <InputCn Type="email" Placeholder="@("alex@example.com")" Class="h-8 text-sm" />
                    </div>
                </div>
            </div>

            @* Gift message *@
            <div class="border-b px-4 py-3">
                <div class="mb-1 flex items-center justify-between">
                    <span class="font-medium text-muted-foreground text-xs">Gift message</span>
                    <span class="font-mono text-muted-foreground text-xs tabular-nums">
                        @_message.Length/@_maxMessageLength
                    </span>
                </div>
                <TextareaCn @bind-Value="_message"
                            Placeholder="Write a personal message for the recipient..."
                            Class="min-h-20 resize-none text-sm" />
            </div>

            @* Gift wrapping *@
            <div class="border-b px-4 py-3">
                <span class="flex cursor-pointer items-center justify-between"
                      @onclick="@(() => _giftWrap = !_giftWrap)"
                      role="button"
                      tabindex="0">
                    <div class="flex items-center gap-2.5">
                        <CheckboxCn @bind-Checked="_giftWrap" />
                        <div>
                            <span class="font-medium text-sm">Gift wrapping</span>
                            <p class="text-muted-foreground text-xs">
                                Premium wrapping with ribbon and tissue paper
                            </p>
                        </div>
                    </div>
                    <span class="shrink-0 font-medium text-sm tabular-nums">+$5.99</span>
                </span>
            </div>

            @* Gift receipt *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <div>
                        <span class="font-medium text-sm">Gift receipt</span>
                        <p class="text-muted-foreground text-xs">
                            Packing slip without prices included
                        </p>
                    </div>
                    <SwitchCn @bind-Checked="_giftReceipt" />
                </div>
            </div>
        }

        @* Summary *@
        @if (_isGift)
        {
            <div class="border-b bg-muted/30 px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">Gift extras</span>
                    <span class="font-medium text-sm tabular-nums">
                        @(_giftWrap ? "$5.99" : "$0.00")
                    </span>
                </div>
                <div class="mt-1 flex flex-wrap items-center gap-2 text-muted-foreground text-xs">
                    @if (_giftWrap)
                    {
                        <span class="flex items-center gap-1.5">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            Wrapping
                        </span>
                    }
                    @if (_giftReceipt)
                    {
                        <span class="flex items-center gap-1.5">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            Gift receipt
                        </span>
                    }
                    @if (_message.Length > 0)
                    {
                        <span class="flex items-center gap-1.5">
                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            Message added
                        </span>
                    }
                </div>
            </div>
        }

        @* Action *@
        <div class="px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                Continue to review
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _isGift = false;
    private bool _giftWrap = false;
    private bool _giftReceipt = true;
    private string _message = "";

    private const int _maxMessageLength = 200;
}
