@* ============================================================
   Block: checkout-payment-methods
   Title: CheckoutPaymentMethods
   Description: A payment method selector block with tabs for Credit Card, PayPal, Bank Transfer, and Buy Now Pay Later, each showing relevant form fields
   Source: original/blocks/checkout/checkout-payment-methods.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Payment Method</span>
            <p class="mt-0.5 text-muted-foreground text-xs">Select how you'd like to pay</p>
        </div>

        @* Tabs *@
        <div class="flex border-b">
            @foreach (var opt in _paymentOptions)
            {
                var option = opt;
                var isActive = _activeTab == option.Id;
                <button type="button"
                        @onclick="@(() => SetActiveTab(option.Id))"
                        class="@Cn.Merge("flex flex-1 items-center justify-center gap-1.5 px-3 py-2.5 text-xs font-medium transition-colors", isActive ? "border-b-2 border-foreground text-foreground" : "text-muted-foreground hover:text-foreground")">
                    <LucideIconCn Name="@option.IconName" Size="14" Class="size-3.5" />
                    @option.Label
                </button>
            }
        </div>

        @* Tab content *@
        <div class="px-4 py-4">
            @if (_activeTab == "card")
            {
                <div class="space-y-3">
                    <div>
                        <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                            Card number
                        </span>
                        <InputCn aria-label="Card number" Placeholder="1234 5678 9012 3456" Class="h-8 text-sm" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                Expiry date
                            </span>
                            <InputCn aria-label="Expiry date" Placeholder="MM / YY" Class="h-8 text-sm" />
                        </div>
                        <div>
                            <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                                Security code
                            </span>
                            <InputCn aria-label="Security code" Placeholder="CVC" Class="h-8 text-sm" />
                        </div>
                    </div>
                    <div>
                        <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                            Name on card
                        </span>
                        <InputCn aria-label="Name on card" Placeholder="John Doe" Class="h-8 text-sm" />
                    </div>
                </div>
            }

            @if (_activeTab == "paypal")
            {
                <div class="space-y-3">
                    <div class="rounded-md bg-muted/50 p-4 text-center">
                        <LucideIconCn Name="wallet" Size="24" Class="mx-auto mb-2 size-6 text-muted-foreground" />
                        <p class="font-medium text-sm">Pay with PayPal</p>
                        <p class="mt-1 text-muted-foreground text-xs">
                            You'll be redirected to PayPal to complete your payment securely. After approval,
                            you'll return here to confirm your order.
                        </p>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Order total</span>
                        <span class="font-medium tabular-nums">$@_orderTotal.ToString("F2")</span>
                    </div>
                </div>
            }

            @if (_activeTab == "bank")
            {
                <div class="space-y-3">
                    <div class="rounded-md bg-muted/50 p-3">
                        <span class="font-medium text-muted-foreground text-xs">Transfer details</span>
                        <div class="mt-2 space-y-1.5">
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">Bank name</span>
                                <span class="font-medium">First National Bank</span>
                            </div>
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">Account number</span>
                                <span class="font-mono font-medium">****4829</span>
                            </div>
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">Routing number</span>
                                <span class="font-mono font-medium">021000021</span>
                            </div>
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">Reference</span>
                                <span class="font-mono font-medium">ORD-7284</span>
                            </div>
                        </div>
                    </div>
                    <p class="text-muted-foreground text-xs leading-relaxed">
                        Transfer the exact amount to the account above. Your order will be processed once
                        the payment is confirmed, typically within 1-2 business days.
                    </p>
                </div>
            }

            @if (_activeTab == "bnpl")
            {
                <div class="space-y-3">
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="flex items-center justify-between">
                            <span class="font-medium text-sm">4 interest-free payments</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                0% APR
                            </BadgeCn>
                        </div>
                        <p class="mt-1 text-muted-foreground text-xs">
                            Split your purchase into 4 equal payments, charged every 2 weeks.
                        </p>
                    </div>
                    <div class="space-y-1.5">
                        @foreach (var i in new[] { 1, 2, 3, 4 })
                        {
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">
                                    @(i == 1 ? "Due today" : $"Payment {i}")
                                </span>
                                <span class="font-medium tabular-nums">$@_installmentAmount</span>
                            </div>
                        }
                    </div>
                    <div class="flex items-center justify-between border-t pt-2 text-xs">
                        <span class="text-muted-foreground">Total</span>
                        <span class="font-medium tabular-nums">$@_orderTotal.ToString("F2")</span>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="w-full">
                @if (_activeTab == "paypal")
                {
                    <text>Continue to PayPal</text>
                }
                else if (_activeTab == "bank")
                {
                    <text>Confirm Bank Transfer</text>
                }
                else
                {
                    <text>Pay $@_orderTotal.ToString("F2")</text>
                }
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-xs">
                Your payment information is encrypted and secure
            </p>
        </div>
    </div>
</section>

@code {
    private record PaymentOption(string Id, string Label, string IconName);

    private const double _orderTotal = 149.97;
    private string _installmentAmount => (_orderTotal / 4).ToString("F2");

    private static readonly PaymentOption[] _paymentOptions =
    [
        new("card",   "Card",     "credit-card"),
        new("paypal", "PayPal",   "wallet"),
        new("bank",   "Bank",     "landmark"),
        new("bnpl",   "Pay Later","banknote"),
    ];

    private string _activeTab = "card";

    private void SetActiveTab(string tab)
    {
        _activeTab = tab;
    }
}
