@* ============================================================
   Block: checkout-event-tickets
   Title: CheckoutEventTickets
   Description: An event ticket checkout block for React and Next.js with event details, ticket type selector, quantity picker, seat selection placeholder, and per-ticket attendee name fields built with shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-event-tickets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Event header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="ticket" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Event Tickets</span>
            </div>
        </div>

        @* Event details *@
        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">@_event.Name</p>
            <div class="mt-1.5 flex flex-wrap items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                    @_event.Date
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                    @_event.Venue
                </span>
            </div>
        </div>

        @* Ticket type selector *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Ticket type</span>
            <div class="mt-2 space-y-2">
                @foreach (var ticketType in _ticketTypes)
                {
                    var tt = ticketType;
                    var isSelected = _selectedType == tt.Id;
                    <button type="button"
                            @onclick="@(() => SetSelectedType(tt.Id))"
                            class="@Cn.Merge("flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left transition-colors", isSelected ? "bg-muted/50 ring-1 ring-border" : "hover:bg-muted/30")">
                        <div class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border", isSelected ? "border-foreground" : "border-muted-foreground/40")">
                            @if (isSelected)
                            {
                                <span class="size-2 rounded-full bg-foreground"></span>
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@tt.Name</span>
                            <p class="text-muted-foreground text-xs">@tt.Description</p>
                        </div>
                        <span class="shrink-0 font-semibold text-sm tabular-nums">$@tt.Price</span>
                    </button>
                }
            </div>
        </div>

        @* Quantity selector *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Quantity</span>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-7 p-0"
                          aria-label="Decrease ticket quantity" OnClick="@(() => UpdateQuantity(-1))" Disabled="@(_quantity <= 1)">
                    <LucideIconCn Name="minus" Size="12" Class="size-3" />
                </ButtonCn>
                <span class="w-8 text-center font-medium text-sm tabular-nums">@_quantity</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="size-7 p-0"
                          aria-label="Increase ticket quantity" OnClick="@(() => UpdateQuantity(1))" Disabled="@(_quantity >= 10)">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        @* Seat selection placeholder *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Seat selection</span>
            <div class="mt-2 flex items-center justify-center rounded-md bg-muted/50 px-4 py-6">
                <p class="text-muted-foreground text-xs">
                    Seat map will be displayed here based on availability
                </p>
            </div>
        </div>

        @* Attendee names *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Attendee details</span>
            <div class="mt-2 space-y-2">
                @for (var i = 0; i < _attendees.Count; i++)
                {
                    var idx = i;
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="user" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                        <InputCn aria-label="@($"Attendee {idx + 1} full name")" Value="@_attendees[idx]"
                                 ValueChanged="@((string v) => UpdateAttendee(idx, v))"
                                 Placeholder="@($"Attendee {idx + 1} full name")"
                                 Class="h-8 text-sm" />
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                            @_selectedTicket?.Name
                        </BadgeCn>
                    </div>
                }
            </div>
        </div>

        @* Order summary *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Order summary</span>
            <div class="mt-2 space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">
                        @_quantity x @_selectedTicket?.Name
                    </span>
                    <span class="text-sm tabular-nums">$@_subtotal</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">Service fee</span>
                    <span class="text-sm tabular-nums">$@_serviceFee</span>
                </div>
                <SeparatorCn />
                <div class="flex items-center justify-between">
                    <span class="font-medium text-sm">Total</span>
                    <span class="font-semibold text-sm tabular-nums">$@_total</span>
                </div>
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">Complete purchase</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record EventInfo(string Name, string Date, string Venue);
    private record TicketType(string Id, string Name, int Price, string Description);

    private static readonly EventInfo _event = new(
        "Synthesis Music Festival 2026",
        "Sat, Jun 14, 2026 · 6:00 PM",
        "Riverside Amphitheatre, Austin, TX"
    );

    private static readonly TicketType[] _ticketTypes =
    [
        new("general", "General Admission", 75,  "Standing area access, food court"),
        new("vip",     "VIP",               150, "Reserved seating, lounge access, complimentary drinks"),
        new("premium", "Premium",           275, "Front row, backstage meet & greet, premium bar"),
    ];

    private string _selectedType = "vip";
    private int _quantity = 2;
    private List<string> _attendees = ["", ""];

    private TicketType? _selectedTicket => Array.Find(_ticketTypes, t => t.Id == _selectedType);
    private int _subtotal => (_selectedTicket?.Price ?? 0) * _quantity;
    private int _serviceFee => (int)Math.Round(_subtotal * 0.08);
    private int _total => _subtotal + _serviceFee;

    private void SetSelectedType(string id)
    {
        _selectedType = id;
    }

    private void UpdateQuantity(int delta)
    {
        var next = Math.Max(1, Math.Min(10, _quantity + delta));
        _quantity = next;
        if (next > _attendees.Count)
        {
            while (_attendees.Count < next)
                _attendees.Add("");
        }
        else if (next < _attendees.Count)
        {
            _attendees = _attendees.Take(next).ToList();
        }
    }

    private void UpdateAttendee(int index, string value)
    {
        if (index >= 0 && index < _attendees.Count)
            _attendees[index] = value;
    }
}
