@* ============================================================
   Block: checkout-social-login
   Title: CheckoutSocialLogin
   Description: A checkout block with social login options for React and Next.js featuring Google, Apple, and GitHub sign-in buttons for faster checkout, a guest checkout divider, autofill benefits, and a compact order form using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-social-login.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Checkout</span>
            <p class="mt-0.5 text-muted-foreground text-xs">Complete your purchase of $89.00</p>
        </div>

        @* Social login section *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Sign in for faster checkout</span>
            </div>

            <div class="space-y-2">
                @* Google *@
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-10 w-full justify-center gap-2.5 text-sm">
                    <svg aria-label="Google" class="size-4" viewBox="0 0 24 24">
                        <title>Google</title>
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="currentColor" fill-opacity="0.7" />
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="currentColor" fill-opacity="0.55" />
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="currentColor" fill-opacity="0.4" />
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="currentColor" fill-opacity="0.6" />
                    </svg>
                    Continue with Google
                </ButtonCn>

                @* Apple *@
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-10 w-full justify-center gap-2.5 text-sm">
                    <svg aria-label="Apple" class="size-4" viewBox="0 0 24 24" fill="currentColor">
                        <title>Apple</title>
                        <path d="M17.05 20.28c-.98.95-2.05.88-3.08.4-1.09-.5-2.08-.48-3.24 0-1.44.62-2.2.44-3.06-.4C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z" />
                    </svg>
                    Continue with Apple
                </ButtonCn>

                @* GitHub *@
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-10 w-full justify-center gap-2.5 text-sm">
                    <svg aria-label="GitHub" class="size-4" viewBox="0 0 24 24" fill="currentColor">
                        <title>GitHub</title>
                        <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.17 6.839 9.49.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0 1 12 6.836a9.59 9.59 0 0 1 2.504.337c1.909-1.294 2.747-1.025 2.747-1.025.546 1.377.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.167 22 16.418 22 12c0-5.523-4.477-10-10-10z" />
                    </svg>
                    Continue with GitHub
                </ButtonCn>
            </div>

            @* Benefits *@
            <div class="mt-3 space-y-1.5">
                @foreach (var benefit in _benefits)
                {
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        <span class="text-muted-foreground text-xs">@benefit</span>
                    </div>
                }
            </div>
        </div>

        @* Divider *@
        <div class="flex items-center gap-3 px-4 py-3">
            <div class="h-px flex-1 bg-border"></div>
            <span class="text-muted-foreground text-xs">Or continue as guest</span>
            <div class="h-px flex-1 bg-border"></div>
        </div>

        @* Guest checkout form *@
        @if (_mode == "choose")
        {
            <div class="px-4 pb-4">
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-10 w-full text-sm" OnClick="@(() => _mode = "guest")">
                    Checkout as Guest
                </ButtonCn>
            </div>
        }
        else
        {
            @* Contact *@
            <div class="border-b px-4 pb-4">
                <span class="mb-3 block font-medium text-sm">Contact</span>
                <div class="space-y-3">
                    <div class="space-y-1.5">
                        <LabelCn For="sl-email" Class="text-xs">Email address</LabelCn>
                        <InputCn Id="sl-email" Type="email" Placeholder="@("you@example.com")" @bind-Value="_email" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="sl-first" Class="text-xs">First name</LabelCn>
                            <InputCn Id="sl-first" Placeholder="Jane" @bind-Value="_firstName" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="sl-last" Class="text-xs">Last name</LabelCn>
                            <InputCn Id="sl-last" Placeholder="Smith" @bind-Value="_lastName" />
                        </div>
                    </div>
                </div>
            </div>

            @* Shipping *@
            <div class="border-b px-4 py-4">
                <span class="mb-3 block font-medium text-sm">Shipping</span>
                <div class="space-y-3">
                    <div class="space-y-1.5">
                        <LabelCn For="sl-address" Class="text-xs">Street address</LabelCn>
                        <InputCn Id="sl-address" Placeholder="742 Evergreen Terrace" @bind-Value="_address" />
                    </div>
                    <div class="grid grid-cols-3 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="sl-city" Class="text-xs">City</LabelCn>
                            <InputCn Id="sl-city" Placeholder="Portland" @bind-Value="_city" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="sl-state" Class="text-xs">State</LabelCn>
                            <InputCn Id="sl-state" Placeholder="OR" @bind-Value="_state" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="sl-zip" Class="text-xs">Zip</LabelCn>
                            <InputCn Id="sl-zip" Placeholder="97201" @bind-Value="_zip" />
                        </div>
                    </div>
                </div>
            </div>

            @* Payment *@
            <div class="border-b px-4 py-4">
                <div class="mb-3 flex items-center gap-2">
                    <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">Payment</span>
                </div>
                <div class="space-y-3">
                    <div class="space-y-1.5">
                        <LabelCn For="sl-card" Class="text-xs">Card number</LabelCn>
                        <InputCn Id="sl-card" Placeholder="4242 4242 4242 4242" @bind-Value="_cardNumber" />
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div class="space-y-1.5">
                            <LabelCn For="sl-expiry" Class="text-xs">Expiry</LabelCn>
                            <InputCn Id="sl-expiry" Placeholder="MM / YY" @bind-Value="_expiry" />
                        </div>
                        <div class="space-y-1.5">
                            <LabelCn For="sl-cvv" Class="text-xs">CVV</LabelCn>
                            <InputCn Id="sl-cvv" Placeholder="123" @bind-Value="_cvv" />
                        </div>
                    </div>
                </div>
            </div>

            @* Total + Submit *@
            <div class="px-4 py-3">
                <div class="mb-3 space-y-1">
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Subtotal</span>
                        <span class="tabular-nums">$74.00</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Shipping</span>
                        <span class="tabular-nums">$8.99</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Tax</span>
                        <span class="tabular-nums">$6.01</span>
                    </div>
                    <div class="flex justify-between border-t pt-1.5 font-medium text-sm">
                        <span>Total</span>
                        <span class="tabular-nums">$89.00</span>
                    </div>
                </div>
                <ButtonCn Class="h-10 w-full text-sm">
                    <LucideIconCn Name="lock" Size="14" Class="mr-1.5 size-3.5" />
                    Pay $89.00
                </ButtonCn>
                <p class="mt-2 text-center text-muted-foreground text-xs">
                    Secured by 256-bit SSL encryption
                </p>
            </div>
        }
    </div>
</section>

@code {
    private static readonly string[] _benefits =
    [
        "Autofill shipping and billing details",
        "Track your order and view history",
        "Faster checkout on future purchases",
    ];

    private string _mode = "choose";

    private string _email = "";
    private string _firstName = "";
    private string _lastName = "";
    private string _address = "";
    private string _city = "";
    private string _state = "";
    private string _zip = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";
}
