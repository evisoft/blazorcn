@* ============================================================
   Block: checkout-error-validation
   Title: CheckoutErrorValidation
   Description: A checkout form with inline validation error states for React and Next.js featuring red-bordered invalid fields, error messages below each input, an error summary banner with anchor links, and real-time blur validation using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-error-validation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Checkout</span>
            <p class="mt-0.5 text-muted-foreground text-xs">Complete your purchase of $127.00</p>
        </div>

        @* Error summary *@
        @if (_errorList.Count > 0)
        {
            <div class="border-b bg-red-500/5 px-4 py-3">
                <div class="flex items-start gap-2">
                    <LucideIconCn Name="alert-circle" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-red-500" />
                    <div>
                        <span class="font-medium text-red-600 text-xs dark:text-red-400">
                            @_errorList.Count @(_errorList.Count == 1 ? "error" : "errors") found
                        </span>
                        <ul class="mt-1 space-y-0.5">
                            @foreach (var err in _errorList)
                            {
                                var errItem = err;
                                <li>
                                    <button type="button"
                                            @onclick="@(() => FocusField(errItem.Field))"
                                            class="text-left text-red-600 text-xs underline underline-offset-2 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300">
                                        @errItem.Label: @errItem.Message
                                    </button>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        @* Contact *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-sm">Contact</span>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="ev-email" Class="text-xs">Email address</LabelCn>
                    <InputCn Id="ev-email"
                             Type="email"
                             Placeholder="@("you@example.com")"
                             Value="@_email"
                             ValueChanged="@((string v) => Update("email", v))"
                             Class="@(HasError("email") ? "border-red-500 focus-visible:ring-red-500/20" : "")"
                             aria-invalid="@(HasError("email") ? "true" : "false")"
                             aria-describedby="@(HasError("email") ? "ev-email-error" : null)"
                             @onblur="@(() => HandleBlur("email"))" />
                    @if (HasError("email"))
                    {
                        <p id="ev-email-error" class="text-red-500 text-xs">@_errors["email"]</p>
                    }
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="ev-name" Class="text-xs">Full name</LabelCn>
                    <InputCn Id="ev-name"
                             Placeholder="Jane Smith"
                             Value="@_name"
                             ValueChanged="@((string v) => Update("name", v))"
                             Class="@(HasError("name") ? "border-red-500 focus-visible:ring-red-500/20" : "")"
                             aria-invalid="@(HasError("name") ? "true" : "false")"
                             aria-describedby="@(HasError("name") ? "ev-name-error" : null)"
                             @onblur="@(() => HandleBlur("name"))" />
                    @if (HasError("name"))
                    {
                        <p id="ev-name-error" class="text-red-500 text-xs">@_errors["name"]</p>
                    }
                </div>
            </div>
        </div>

        @* Shipping *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-sm">Shipping</span>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="ev-address" Class="text-xs">Street address</LabelCn>
                    <InputCn Id="ev-address"
                             Placeholder="742 Evergreen Terrace"
                             Value="@_address"
                             ValueChanged="@((string v) => Update("address", v))"
                             Class="@(HasError("address") ? "border-red-500 focus-visible:ring-red-500/20" : "")"
                             aria-invalid="@(HasError("address") ? "true" : "false")"
                             aria-describedby="@(HasError("address") ? "ev-address-error" : null)"
                             @onblur="@(() => HandleBlur("address"))" />
                    @if (HasError("address"))
                    {
                        <p id="ev-address-error" class="text-red-500 text-xs">@_errors["address"]</p>
                    }
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="ev-city" Class="text-xs">City</LabelCn>
                        <InputCn Id="ev-city"
                                 Placeholder="Portland"
                                 Value="@_city"
                                 ValueChanged="@((string v) => Update("city", v))"
                                 Class="@(HasError("city") ? "border-red-500 focus-visible:ring-red-500/20" : "")"
                                 aria-invalid="@(HasError("city") ? "true" : "false")"
                                 aria-describedby="@(HasError("city") ? "ev-city-error" : null)"
                                 @onblur="@(() => HandleBlur("city"))" />
                        @if (HasError("city"))
                        {
                            <p id="ev-city-error" class="text-red-500 text-xs">@_errors["city"]</p>
                        }
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="ev-zip" Class="text-xs">Zip code</LabelCn>
                        <InputCn Id="ev-zip"
                                 Placeholder="97201"
                                 Value="@_zip"
                                 ValueChanged="@((string v) => Update("zip", v))"
                                 Class="@(HasError("zip") ? "border-red-500 focus-visible:ring-red-500/20" : "")"
                                 aria-invalid="@(HasError("zip") ? "true" : "false")"
                                 aria-describedby="@(HasError("zip") ? "ev-zip-error" : null)"
                                 @onblur="@(() => HandleBlur("zip"))" />
                        @if (HasError("zip"))
                        {
                            <p id="ev-zip-error" class="text-red-500 text-xs">@_errors["zip"]</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Payment *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Payment</span>
            </div>
            <div class="space-y-3">
                <div class="space-y-1.5">
                    <LabelCn For="ev-cardNumber" Class="text-xs">Card number</LabelCn>
                    <InputCn Id="ev-cardNumber"
                             Placeholder="4242 4242 4242 4242"
                             Value="@_cardNumber"
                             ValueChanged="@((string v) => Update("cardNumber", v))"
                             Class="@(HasError("cardNumber") ? "border-red-500 focus-visible:ring-red-500/20" : "")"
                             aria-invalid="@(HasError("cardNumber") ? "true" : "false")"
                             aria-describedby="@(HasError("cardNumber") ? "ev-cardNumber-error" : null)"
                             @onblur="@(() => HandleBlur("cardNumber"))" />
                    @if (HasError("cardNumber"))
                    {
                        <p id="ev-cardNumber-error" class="text-red-500 text-xs">@_errors["cardNumber"]</p>
                    }
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div class="space-y-1.5">
                        <LabelCn For="ev-expiry" Class="text-xs">Expiry date</LabelCn>
                        <InputCn Id="ev-expiry"
                                 Placeholder="MM / YY"
                                 Value="@_expiry"
                                 ValueChanged="@((string v) => Update("expiry", v))"
                                 Class="@(HasError("expiry") ? "border-red-500 focus-visible:ring-red-500/20" : "")"
                                 aria-invalid="@(HasError("expiry") ? "true" : "false")"
                                 aria-describedby="@(HasError("expiry") ? "ev-expiry-error" : null)"
                                 @onblur="@(() => HandleBlur("expiry"))" />
                        @if (HasError("expiry"))
                        {
                            <p id="ev-expiry-error" class="text-red-500 text-xs">@_errors["expiry"]</p>
                        }
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="ev-cvv" Class="text-xs">CVV</LabelCn>
                        <InputCn Id="ev-cvv"
                                 Placeholder="123"
                                 Value="@_cvv"
                                 ValueChanged="@((string v) => Update("cvv", v))"
                                 Class="@(HasError("cvv") ? "border-red-500 focus-visible:ring-red-500/20" : "")"
                                 aria-invalid="@(HasError("cvv") ? "true" : "false")"
                                 aria-describedby="@(HasError("cvv") ? "ev-cvv-error" : null)"
                                 @onblur="@(() => HandleBlur("cvv"))" />
                        @if (HasError("cvv"))
                        {
                            <p id="ev-cvv-error" class="text-red-500 text-xs">@_errors["cvv"]</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* Total + Submit *@
        <div class="px-4 py-3">
            <div class="mb-3 space-y-1">
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Subtotal</span>
                    <span class="tabular-nums">$112.00</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Shipping</span>
                    <span class="tabular-nums">$8.99</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Tax</span>
                    <span class="tabular-nums">$6.01</span>
                </div>
                <div class="flex justify-between border-t pt-1.5 font-medium text-sm">
                    <span>Total</span>
                    <span class="tabular-nums">$127.00</span>
                </div>
            </div>
            <ButtonCn Class="h-10 w-full text-sm" @onclick="HandleSubmit">
                <LucideIconCn Name="lock" Size="14" Class="mr-1.5 size-3.5" />
                Pay $127.00
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _email = "";
    private string _name = "";
    private string _address = "";
    private string _city = "";
    private string _zip = "";
    private string _cardNumber = "";
    private string _expiry = "";
    private string _cvv = "";

    private readonly Dictionary<string, bool> _touched = new();
    private readonly Dictionary<string, string> _errors = new();
    private bool _submitted = false;

    private record FieldError(string Field, string Label, string Message);

    private static readonly Dictionary<string, string> _fieldLabels = new()
    {
        ["email"]      = "Email address",
        ["name"]       = "Full name",
        ["address"]    = "Street address",
        ["city"]       = "City",
        ["zip"]        = "Zip code",
        ["cardNumber"] = "Card number",
        ["expiry"]     = "Expiry date",
        ["cvv"]        = "CVV",
    };

    private string? ValidateField(string field, string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return $"{_fieldLabels[field]} is required";

        if (field == "email" && !System.Text.RegularExpressions.Regex.IsMatch(value, @"^[^\s@]+@[^\s@]+\.[^\s@]+$"))
            return "Enter a valid email address";

        if (field == "zip" && !System.Text.RegularExpressions.Regex.IsMatch(value, @"^\d{5}(-\d{4})?$"))
            return "Enter a valid 5-digit zip code";

        if (field == "cardNumber" && value.Replace(" ", "").Length < 16)
            return "Card number must be 16 digits";

        if (field == "expiry" && !System.Text.RegularExpressions.Regex.IsMatch(value, @"^\d{2}\s*/\s*\d{2}$"))
            return "Use MM / YY format";

        if (field == "cvv" && !System.Text.RegularExpressions.Regex.IsMatch(value, @"^\d{3,4}$"))
            return "CVV must be 3 or 4 digits";

        return null;
    }

    private string GetFieldValue(string field) => field switch
    {
        "email"      => _email,
        "name"       => _name,
        "address"    => _address,
        "city"       => _city,
        "zip"        => _zip,
        "cardNumber" => _cardNumber,
        "expiry"     => _expiry,
        "cvv"        => _cvv,
        _            => "",
    };

    private void SetFieldValue(string field, string value)
    {
        switch (field)
        {
            case "email":      _email      = value; break;
            case "name":       _name       = value; break;
            case "address":    _address    = value; break;
            case "city":       _city       = value; break;
            case "zip":        _zip        = value; break;
            case "cardNumber": _cardNumber = value; break;
            case "expiry":     _expiry     = value; break;
            case "cvv":        _cvv        = value; break;
        }
    }

    private void Update(string field, string value)
    {
        SetFieldValue(field, value);
        if (_touched.ContainsKey(field) || _submitted)
        {
            var error = ValidateField(field, value);
            if (error != null)
                _errors[field] = error;
            else
                _errors.Remove(field);
        }
    }

    private void HandleBlur(string field)
    {
        _touched[field] = true;
        var error = ValidateField(field, GetFieldValue(field));
        if (error != null)
            _errors[field] = error;
        else
            _errors.Remove(field);
    }

    private void HandleSubmit()
    {
        _submitted = true;
        _errors.Clear();
        foreach (var key in _fieldLabels.Keys)
        {
            var error = ValidateField(key, GetFieldValue(key));
            if (error != null)
                _errors[key] = error;
        }
    }

    private bool HasError(string field) => _errors.ContainsKey(field);

    private List<FieldError> _errorList =>
        _errors.Select(kvp => new FieldError(kvp.Key, _fieldLabels[kvp.Key], kvp.Value)).ToList();

    private void FocusField(string field)
    {
        // JS focus is not wired in static demo; the error summary still links visually
    }
}
