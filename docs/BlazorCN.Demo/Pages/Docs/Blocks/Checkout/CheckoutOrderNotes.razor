@* ============================================================
   Block: checkout-order-notes
   Title: CheckoutOrderNotes
   Description: A checkout block for React and Next.js with order notes textarea, delivery instructions, preferred delivery time dropdown, leave at door checkbox, and contact preference radio buttons using shadcn/ui Textarea, Select, Checkbox, RadioGroup, Button, and Tailwind CSS
   Source: original/blocks/checkout/checkout-order-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="clipboard-list" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Order Details</span>
            <span class="ml-auto text-muted-foreground text-xs">@_orderItems.Length items</span>
        </div>

        @* Order items *@
        <div class="border-b">
            @for (var i = 0; i < _orderItems.Length; i++)
            {
                var item = _orderItems[i];
                var isLast = i == _orderItems.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <span class="text-sm">@item.Name</span>
                        <p class="text-muted-foreground text-xs">
                            @item.Variant · Qty @item.Quantity
                        </p>
                    </div>
                    <span class="shrink-0 font-medium text-sm tabular-nums">
                        $@((item.Price * item.Quantity).ToString("F2"))
                    </span>
                </div>
            }
        </div>

        @* Delivery instructions *@
        <div class="border-b px-4 py-4">
            <span class="font-medium text-sm">Delivery Instructions</span>
            <p class="mt-0.5 text-muted-foreground text-xs">Special requests for your delivery</p>
            <div class="mt-3 space-y-1.5">
                <LabelCn For="on-notes" Class="text-xs">
                    Order notes
                </LabelCn>
                <TextareaCn id="on-notes"
                            Placeholder="Gate code is #4521. Ring doorbell twice. Please avoid placing near sprinklers."
                            @bind-Value="_notes"
                            rows="3"
                            Class="resize-none text-sm" />
                <p class="text-muted-foreground text-xs">@_notes.Length/500 characters</p>
            </div>
        </div>

        @* Delivery time preference *@
        <div class="border-b px-4 py-4">
            <div class="space-y-1.5">
                <LabelCn For="on-delivery-time" Class="text-xs">
                    Preferred delivery time
                </LabelCn>
                <SelectCn @bind-Value="_deliveryTime">
                    <SelectTriggerCn id="on-delivery-time">
                        <SelectValueCn Placeholder="Select time window" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var w in _deliveryWindows)
                        {
                            var win = w;
                            <SelectItemCn Value="@win.Value">@win.Label</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Leave at door *@
        <div class="border-b px-4 py-3">
            <label for="on-leave-at-door" class="flex cursor-pointer items-center gap-3">
                <CheckboxCn Id="on-leave-at-door" aria-label="Leave at door" Checked="@_leaveAtDoor" CheckedChanged="@(v => _leaveAtDoor = v)" />
                <div>
                    <span class="font-medium text-sm">Leave at door</span>
                    <p class="text-muted-foreground text-xs">
                        Driver will leave the package at your door without knocking
                    </p>
                </div>
            </label>
        </div>

        @* Contact preference *@
        <div class="border-b px-4 py-4">
            <span class="font-medium text-sm">Contact preference</span>
            <p class="mt-0.5 mb-3 text-muted-foreground text-xs">
                How should the driver reach you?
            </p>
            <RadioGroupCn Value="@_contactPreference" ValueChanged="@(v => _contactPreference = v ?? _contactPreference)">
                <label for="on-contact-text" class="flex cursor-pointer items-center gap-3 rounded-md px-3 py-2 transition-colors hover:bg-muted/50">
                    <RadioGroupItemCn Id="on-contact-text" Value="text" aria-label="Contact by text message" />
                    <LucideIconCn Name="smartphone" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Text message</span>
                        <p class="text-muted-foreground text-xs">
                            Receive SMS updates and arrival alerts
                        </p>
                    </div>
                </label>
                <label for="on-contact-call" class="flex cursor-pointer items-center gap-3 rounded-md px-3 py-2 transition-colors hover:bg-muted/50">
                    <RadioGroupItemCn Id="on-contact-call" Value="call" aria-label="Contact by phone call" />
                    <LucideIconCn Name="phone-call" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Phone call</span>
                        <p class="text-muted-foreground text-xs">Driver will call on arrival</p>
                    </div>
                </label>
                <label for="on-contact-app" class="flex cursor-pointer items-center gap-3 rounded-md px-3 py-2 transition-colors hover:bg-muted/50">
                    <RadioGroupItemCn Id="on-contact-app" Value="app" aria-label="Contact by in-app notification" />
                    <LucideIconCn Name="message-square" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">In-app notification</span>
                        <p class="text-muted-foreground text-xs">Push notification through the app</p>
                    </div>
                </label>
            </RadioGroupCn>
        </div>

        @* Summary and checkout *@
        <div class="px-4 py-3">
            <div class="space-y-1.5">
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Subtotal</span>
                    <span class="tabular-nums">$@_subtotal.ToString("F2")</span>
                </div>
                <div class="flex justify-between text-sm">
                    <span class="text-muted-foreground">Shipping</span>
                    <span class="tabular-nums">$@_shipping.ToString("F2")</span>
                </div>
                <div class="flex justify-between border-t pt-1.5 text-sm font-medium">
                    <span>Total</span>
                    <span class="tabular-nums">$@_total.ToString("F2")</span>
                </div>
            </div>
            <ButtonCn Class="mt-3 w-full" Size="ButtonSize.Sm">Place Order</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record OrderItem(string Id, string Name, string Variant, double Price, int Quantity);

    private record DeliveryWindow(string Value, string Label);

    private static readonly OrderItem[] _orderItems =
    [
        new("1", "Artisan Sourdough Loaf", "Whole Wheat", 8.5, 2),
        new("2", "Organic Cold Brew", "Vanilla / 32oz", 12.0, 1),
        new("3", "Ceramic Pour-Over Set", "Matte White", 45.0, 1),
    ];

    private static readonly DeliveryWindow[] _deliveryWindows =
    [
        new("morning", "Morning (8am - 12pm)"),
        new("afternoon", "Afternoon (12pm - 5pm)"),
        new("evening", "Evening (5pm - 9pm)"),
        new("anytime", "Any time"),
    ];

    private static readonly double _shipping = 5.99;
    private double _subtotal => _orderItems.Sum(i => i.Price * i.Quantity);
    private double _total => _subtotal + _shipping;

    private string _notes = "";
    private string _deliveryTime = "anytime";
    private bool _leaveAtDoor = false;
    private string _contactPreference = "text";
}
