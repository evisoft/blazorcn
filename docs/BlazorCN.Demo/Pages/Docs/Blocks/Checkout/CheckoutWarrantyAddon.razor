@* ============================================================
   Block: checkout-warranty-addon
   Title: CheckoutWarrantyAddon
   Description: A warranty and protection plan add-on selector during checkout with tiered coverage options, expandable coverage details, auto-selected recommendation, and add-to-order button using shadcn/ui and Tailwind CSS
   Source: original/blocks/checkout/checkout-warranty-addon.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Protect Your Purchase</span>
        </div>

        @* Product context *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="min-w-0 flex-1">
                <span class="text-sm">@_productName</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Add a protection plan for peace of mind
                </p>
            </div>
            <span class="shrink-0 font-medium text-sm tabular-nums">
                $@_productPrice.ToString("F2")
            </span>
        </div>

        @* Warranty options *@
        <div class="border-b">
            @foreach (var plan in _warrantyPlans)
            {
                var p = plan;
                var isActive = _selected == p.Id;
                var isExpanded = _expanded == p.Id;
                var isLast = p.Id == _warrantyPlans[^1].Id;
                <div class="@Cn.Merge(isLast ? "" : "border-b")">
                    <div class="@Cn.Merge("relative flex cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isActive ? "bg-muted/50" : "")">
                        @* Stretched overlay carries the row action so the coverage button can stay a sibling *@
                        <button type="button"
                                aria-label="@($"Select {p.Label} warranty")"
                                @onclick="@(() => _selected = p.Id)"
                                class="absolute inset-0 z-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset"></button>
                        @* Radio indicator *@
                        <span class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border", isActive ? "border-primary" : "border-input")">
                            @if (isActive)
                            {
                                <span class="size-2 rounded-full bg-primary"></span>
                            }
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@p.Label</span>
                                @if (p.Recommended)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        Recommended
                                    </BadgeCn>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(p.Duration))
                            {
                                <p class="mt-0.5 text-muted-foreground text-xs">
                                    @p.Duration of coverage
                                </p>
                            }
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            <span class="font-medium text-sm tabular-nums">
                                @(p.Price == 0 ? "--" : $"${p.Price.ToString("F2")}")
                            </span>
                            @if (p.Coverage.Length > 0)
                            {
                                <button aria-label="Show coverage details"
                                    type="button"
                                    @onclick="@(() => _expanded = isExpanded ? null : p.Id)"
                                    class="relative z-10 rounded p-0.5 hover:bg-muted">
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                </button>
                            }
                        </div>
                    </div>

                    @if (isExpanded && p.Coverage.Length > 0)
                    {
                        <div class="px-4 pb-3 pl-11">
                            <div class="rounded-md bg-muted/50 p-3">
                                <span class="font-medium text-muted-foreground text-xs">
                                    Coverage includes
                                </span>
                                <ul class="mt-1.5 space-y-1">
                                    @foreach (var item in p.Coverage)
                                    {
                                        <li class="flex items-center gap-2 text-sm">
                                            <span class="size-1 shrink-0 rounded-full bg-foreground/40"></span>
                                            @item
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Total and action *@
        <div class="px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Product</span>
                <span class="text-xs tabular-nums">$@_productPrice.ToString("F2")</span>
            </div>
            @if (_selectedPlan != null && _selectedPlan.Price > 0)
            {
                <div class="mt-1.5 flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">@_selectedPlan.Label</span>
                    <span class="text-xs tabular-nums">$@_selectedPlan.Price.ToString("F2")</span>
                </div>
            }
            <div class="mt-2 flex items-center justify-between border-t pt-2">
                <span class="font-medium text-sm">Total</span>
                <span class="font-semibold text-sm tabular-nums">$@_total.ToString("F2")</span>
            </div>
            <ButtonCn Class="mt-3 w-full" Size="ButtonSize.Sm">
                Add to Order
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record WarrantyPlan(string Id, string Label, int Price, string Duration, bool Recommended, string[] Coverage);

    private const string _productName = "Sony WH-1000XM5 Headphones";
    private const double _productPrice = 349.99;

    private static readonly WarrantyPlan[] _warrantyPlans =
    [
        new("none", "No Protection", 0, "", false, []),
        new("1year", "1-Year Protection", 19, "12 months", false,
        [
            "Mechanical and electrical failures",
            "Manufacturer defect coverage",
            "Free repairs or replacement",
        ]),
        new("2year", "2-Year Protection", 29, "24 months", true,
        [
            "Mechanical and electrical failures",
            "Manufacturer defect coverage",
            "Accidental damage from handling",
            "Free repairs or replacement",
            "No deductibles on claims",
        ]),
        new("3year", "3-Year Protection", 39, "36 months", false,
        [
            "Mechanical and electrical failures",
            "Manufacturer defect coverage",
            "Accidental damage from handling",
            "Power surge protection",
            "Free repairs or replacement",
            "No deductibles on claims",
            "Transferable coverage",
        ]),
    ];

    private string _selected = "2year";
    private string? _expanded = "2year";

    private WarrantyPlan? _selectedPlan => Array.Find(_warrantyPlans, p => p.Id == _selected);
    private double _total => _productPrice + (_selectedPlan?.Price ?? 0);
}
