@* ============================================================
   Block: todo-list-travel
   Title: TodoListTravel
   Description: A travel itinerary block for React and Next.js with day-by-day sections, timed activities, location pins, booking status badges, and transportation indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-travel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="map-pin" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Tokyo Trip Itinerary</span>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span>@_days.Length days</span>
                <span class="text-muted-foreground/40">·</span>
                <span class="tabular-nums">@_completedActivities/@_totalActivities done</span>
            </div>
        </div>

        @* Status legend *@
        <div class="flex items-center gap-4 border-b px-4 py-2">
            @foreach (var statusEntry in _statusDots)
            {
                var statusLabel = statusEntry.Key;
                var dotClass = statusEntry.Value;
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", dotClass)"></span>
                    @statusLabel
                </span>
            }
            <span class="ml-auto flex items-center gap-1 text-muted-foreground text-xs">
                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                @_completedActivities completed
            </span>
        </div>

        @* Days *@
        @for (int di = 0; di < _days.Length; di++)
        {
            var dayIndex = di;
            var day = _days[dayIndex];
            var isExpanded = _expandedDays.Contains(day.Day);
            var dayCompleted = day.Activities.Count(a => a.Completed);

            <div>
                <button type="button"
                        @onclick="@(() => ToggleDay(day.Day))"
                        class="flex w-full items-center gap-2 border-b bg-muted/30 px-4 py-2 text-left transition-colors hover:bg-muted/50">
                    <LucideIconCn Name="chevron-right" Size="14"
                                  Class="@Cn.Merge("size-3.5 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    <span class="font-medium text-xs">Day @day.Day</span>
                    <span class="text-muted-foreground text-xs">— @day.Date</span>
                    <span class="ml-auto text-muted-foreground text-xs tabular-nums">@dayCompleted/@day.Activities.Length</span>
                </button>

                @if (isExpanded)
                {
                    @for (int ai = 0; ai < day.Activities.Length; ai++)
                    {
                        var actIndex = ai;
                        var activity = day.Activities[actIndex];
                        var isLastAct = actIndex == day.Activities.Length - 1;
                        var isLastDay = dayIndex == _days.Length - 1;
                        var showBorder = !(isLastAct && isLastDay);
                        var actId = activity.Id;

                        @if (activity.Transport != null && actIndex > 0)
                        {
                            <div class="flex items-center gap-2 px-4 py-1">
                                <div class="ml-1.5 h-4 w-px bg-muted-foreground/20"></div>
                                <span class="text-muted-foreground/60">
                                    @if (activity.Transport == "flight")
                                    {
                                        <LucideIconCn Name="plane" Size="12" Class="size-3" />
                                    }
                                    @if (activity.Transport == "train")
                                    {
                                        <LucideIconCn Name="train-front" Size="12" Class="size-3" />
                                    }
                                </span>
                            </div>
                        }
                        <div class="@Cn.Merge("group flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", showBorder ? "border-b" : "")">
                            <CheckboxCn Id="@($"travel-{activity.Id}")"
                                        Checked="@activity.Completed"
                                        CheckedChanged="@((bool _) => ToggleActivity(actId))" />
                            <span class="w-12 shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                                @activity.Time
                            </span>
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("font-medium text-sm", activity.Completed ? "text-muted-foreground line-through" : "")">
                                    @activity.Name
                                </span>
                                <p class="mt-0.5 flex items-center gap-1 text-muted-foreground text-xs">
                                    <LucideIconCn Name="map-pin" Size="12" Class="size-3 shrink-0" />
                                    <span class="truncate">@activity.Location</span>
                                </p>
                            </div>
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _statusDots[activity.Status])"></span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@activity.Status</BadgeCn>
                        </div>
                    }
                }
            </div>
        }
    </div>
</section>

@code {
    private record Activity(
        string Id,
        string Time,
        string Name,
        string Location,
        string Status,
        bool Completed,
        string? Transport = null
    );

    private record DayPlan(int Day, string Date, Activity[] Activities);

    private static readonly Dictionary<string, string> _statusDots = new()
    {
        ["Booked"] = "bg-emerald-500",
        ["Pending"] = "bg-amber-500",
        ["Flexible"] = "bg-blue-500",
    };

    private DayPlan[] _days =
    [
        new(1, "Apr 15",
        [
            new("a1", "06:30", "Flight SFO → NRT", "San Francisco Int'l Airport", "Booked", true, "flight"),
        ]),
        new(2, "Apr 16",
        [
            new("a2", "15:00", "Arrive Narita Airport", "Narita International", "Booked", false),
            new("a3", "16:30", "Narita Express to Shinjuku", "Narita Station", "Booked", false, "train"),
            new("a4", "18:00", "Hotel check-in", "Shinjuku Granbell Hotel", "Booked", false),
            new("a5", "19:30", "Dinner at Omoide Yokocho", "Shinjuku, Memory Lane", "Flexible", false),
        ]),
        new(3, "Apr 17",
        [
            new("a6", "08:00", "Tsukiji Outer Market", "Tsukiji, Chuo City", "Flexible", false),
            new("a7", "10:30", "teamLab Borderless", "Azabudai Hills", "Booked", false),
            new("a8", "13:00", "Lunch at Afuri Ramen", "Roppongi Hills", "Flexible", false),
            new("a9", "15:00", "Meiji Shrine", "Shibuya, Yoyogi", "Flexible", false),
            new("a10", "17:00", "Harajuku & Takeshita Street", "Harajuku", "Flexible", false),
            new("a11", "19:00", "Shibuya Crossing viewpoint", "Shibuya Sky", "Pending", false),
        ]),
        new(4, "Apr 18",
        [
            new("a12", "07:00", "Shinkansen to Hakone", "Shinjuku Station", "Booked", false, "train"),
            new("a13", "09:00", "Hakone Open-Air Museum", "Hakone, Kanagawa", "Booked", false),
            new("a14", "12:00", "Owakudani volcanic valley", "Hakone Ropeway", "Flexible", false),
            new("a15", "15:00", "Lake Ashi cruise", "Hakone Pier", "Pending", false),
            new("a16", "18:00", "Return to Shinjuku", "Hakone-Yumoto Station", "Booked", false, "train"),
        ]),
    ];

    private HashSet<int> _expandedDays = [2, 3];

    private int _totalActivities => _days.Sum(d => d.Activities.Length);
    private int _completedActivities => _days.Sum(d => d.Activities.Count(a => a.Completed));

    private void ToggleDay(int dayNum)
    {
        if (_expandedDays.Contains(dayNum))
            _expandedDays.Remove(dayNum);
        else
            _expandedDays.Add(dayNum);
    }

    private void ToggleActivity(string activityId)
    {
        for (int d = 0; d < _days.Length; d++)
        {
            var acts = _days[d].Activities;
            for (int a = 0; a < acts.Length; a++)
            {
                if (acts[a].Id == activityId)
                {
                    acts[a] = acts[a] with { Completed = !acts[a].Completed };
                    return;
                }
            }
        }
    }
}
