@* ============================================================
   Block: todo-list-collaborative
   Title: TodoListCollaborative
   Description: React todo list collaborative editing block for Next.js with real-time presence indicators, viewer counts, and last-edited-by info using shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-collaborative.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Collaborative Tasks</span>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_onlineCount online
                </span>
                <span>·</span>
                <span>@_completedCount/@_tasks.Count done</span>
            </div>
        </div>

        @* Tasks *@
        <div>
            @for (int i = 0; i < _tasks.Count; i++)
            {
                var task = _tasks[i];
                var isLast = i == _tasks.Count - 1;
                var visibleViewers = task.Viewers.Take(3).ToArray();
                var extraCount = task.Viewers.Length - 3;
                var editingUser = task.Viewers.FirstOrDefault(v => v.IsEditing);
                var taskId = task.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        @* Checkbox *@
                        <span class="flex shrink-0 pt-0.5">
                            <CheckboxCn Checked="@task.Completed"
                                        CheckedChanged="@((bool _) => ToggleTask(taskId))" />
                        </span>

                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", task.Completed ? "text-muted-foreground line-through" : "")">
                                    @task.Title
                                </span>
                                @if (editingUser != null)
                                {
                                    <span class="flex items-center gap-1 text-muted-foreground text-[10px]">
                                        <LucideIconCn Name="pencil" Size="10" Class="size-2.5" />
                                        @editingUser.Name editing
                                    </span>
                                }
                            </div>

                            <div class="mt-1.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>Edited by @task.EditedBy</span>
                                <span>·</span>
                                <span>@task.EditedAt</span>
                            </div>
                        </div>

                        @* Presence dots *@
                        @if (task.Viewers.Length > 0)
                        {
                            <div class="flex shrink-0 items-center gap-1">
                                <div class="flex -space-x-1.5">
                                    @foreach (var viewer in visibleViewers)
                                    {
                                        <div class="relative">
                                            <AvatarCn Class="size-5 ring-2 ring-card">
                                                <AvatarFallbackCn Class="text-[8px]">@viewer.Initials</AvatarFallbackCn>
                                            </AvatarCn>
                                            @if (viewer.Online)
                                            {
                                                <span class="absolute -right-0.5 -bottom-0.5 size-2 rounded-full border border-card bg-emerald-500"></span>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (extraCount > 0)
                                {
                                    <span class="text-muted-foreground text-[10px]">+@extraCount</span>
                                }
                                @if (task.Viewers.Length > 1)
                                {
                                    <span class="flex items-center gap-0.5 text-muted-foreground text-[10px]">
                                        <LucideIconCn Name="eye" Size="10" Class="size-2.5" />
                                        @task.Viewers.Length
                                    </span>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <LucideIconCn Name="check" Size="12" Class="size-3" />
                <span>Changes sync automatically across all connected users</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record ViewerItem(string Id, string Name, string Initials, bool Online, bool IsEditing);
    private record TodoTask(string Id, string Title, bool Completed, string EditedBy, string EditedAt, ViewerItem[] Viewers);

    private List<TodoTask> _tasks =
    [
        new("t1", "Finalize Q2 product roadmap", false, "Alex Chen", "2 min ago",
        [
            new("u1", "Alex Chen", "AC", true, true),
            new("u2", "Jordan Lee", "JL", true, false),
            new("u3", "Sam Rivera", "SR", true, false),
        ]),
        new("t2", "Review design system updates", false, "Jordan Lee", "15 min ago",
        [
            new("u2", "Jordan Lee", "JL", true, false),
            new("u4", "Taylor Kim", "TK", false, false),
        ]),
        new("t3", "Write migration script for user table", false, "Sam Rivera", "1 hour ago",
        [
            new("u3", "Sam Rivera", "SR", true, true),
            new("u1", "Alex Chen", "AC", true, false),
            new("u5", "Morgan Wu", "MW", true, false),
            new("u2", "Jordan Lee", "JL", false, false),
        ]),
        new("t4", "Configure CDN for static assets", true, "Taylor Kim", "3 hours ago",
        [
            new("u4", "Taylor Kim", "TK", false, false),
        ]),
        new("t5", "Audit third-party dependencies", false, "Morgan Wu", "30 min ago",
        [
            new("u5", "Morgan Wu", "MW", true, false),
        ]),
        new("t6", "Set up error tracking with Sentry", true, "Alex Chen", "Yesterday", []),
    ];

    private int _onlineCount => _tasks
        .SelectMany(t => t.Viewers.Where(v => v.Online).Select(v => v.Id))
        .Distinct()
        .Count();

    private int _completedCount => _tasks.Count(t => t.Completed);

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Completed = !_tasks[idx].Completed };
    }
}
