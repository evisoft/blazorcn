@* ============================================================
   Block: todo-list-bulk-actions
   Title: TodoListBulkActions
   Description: A todo list block with multi-select and bulk operations for React and Next.js featuring select-all checkbox, floating action bar, selection count, and batch complete/delete actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-bulk-actions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-lg border bg-card">
        @* Header with select all *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="shrink-0">
                <CheckboxCn Checked="@AllSelected" CheckedChanged="@((bool _) => ToggleSelectAll())" aria-label="Select all tasks" />
            </span>
            <div class="flex min-w-0 flex-1 items-center gap-2">
                <LucideIconCn Name="list-checks" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Bulk Actions</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">@_todos.Count tasks</span>
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < _todos.Count; i++)
            {
                var todo = _todos[i];
                var isSelected = _selectedIds.Contains(todo.Id);
                var isLast = i == _todos.Count - 1;
                var capturedId = todo.Id;
                <div class="@Cn.Merge(isLast ? "" : "border-b", isSelected ? "bg-muted/30" : "", "transition-colors hover:bg-muted/50")">
                    <div class="flex w-full items-center gap-3 px-4 py-3">
                        <span class="shrink-0">
                            <CheckboxCn Checked="@isSelected" CheckedChanged="@((bool _) => ToggleSelect(capturedId))" aria-label="@($"Select {todo.Text}")" />
                        </span>
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", PriorityDotClass(todo.Priority))"></span>
                        <span class="@Cn.Merge("min-w-0 flex-1 text-sm transition-all duration-200", todo.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                            @todo.Text
                        </span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs font-normal capitalize">
                            @todo.Priority
                        </BadgeCn>
                    </div>
                </div>
            }
        </div>

        @* Floating action bar *@
        @if (_selectedIds.Count > 0)
        {
            <div class="border-t bg-card px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-medium tabular-nums">
                        @_selectedIds.Count selected
                    </span>
                    <div class="ml-auto flex items-center gap-1.5">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" @onclick="BulkComplete">
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                            Complete
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs text-red-600 hover:text-red-600 dark:text-red-400 dark:hover:text-red-400" @onclick="BulkDelete">
                            <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                            Delete
                        </ButtonCn>
                        <ButtonCn aria-label="Clear selection" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 text-xs" @onclick="ClearSelection">
                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private class TodoItem
    {
        public string Id { get; set; } = "";
        public string Text { get; set; } = "";
        public bool Completed { get; set; }
        public string Priority { get; set; } = "low";
    }

    private List<TodoItem> _todos =
    [
        new() { Id = "1", Text = "Audit third-party API dependencies", Completed = false, Priority = "high" },
        new() { Id = "2", Text = "Migrate user sessions to Redis", Completed = false, Priority = "high" },
        new() { Id = "3", Text = "Add rate limiting to public endpoints", Completed = false, Priority = "medium" },
        new() { Id = "4", Text = "Refactor notification service", Completed = false, Priority = "medium" },
        new() { Id = "5", Text = "Update Tailwind to v4", Completed = false, Priority = "low" },
        new() { Id = "6", Text = "Set up Playwright E2E suite", Completed = true, Priority = "medium" },
        new() { Id = "7", Text = "Document GraphQL schema changes", Completed = false, Priority = "low" },
        new() { Id = "8", Text = "Fix memory leak in WebSocket handler", Completed = false, Priority = "high" },
    ];

    private HashSet<string> _selectedIds = new();

    private bool AllSelected => _todos.Count > 0 && _todos.All(t => _selectedIds.Contains(t.Id));

    private string PriorityDotClass(string priority) => priority switch
    {
        "high" => "bg-red-500",
        "medium" => "bg-amber-500",
        _ => "bg-blue-500",
    };

    private void ToggleSelectAll()
    {
        if (AllSelected)
            _selectedIds.Clear();
        else
            _selectedIds = _todos.Select(t => t.Id).ToHashSet();
    }

    private void ToggleSelect(string id)
    {
        if (_selectedIds.Contains(id))
            _selectedIds.Remove(id);
        else
            _selectedIds.Add(id);
    }

    private void BulkComplete()
    {
        foreach (var todo in _todos.Where(t => _selectedIds.Contains(t.Id)))
            todo.Completed = true;
        _selectedIds.Clear();
    }

    private void BulkDelete()
    {
        _todos = _todos.Where(t => !_selectedIds.Contains(t.Id)).ToList();
        _selectedIds.Clear();
    }

    private void ClearSelection()
    {
        _selectedIds.Clear();
    }
}
