@* ============================================================
   Block: todo-list-split-view
   Title: TodoListSplitView
   Description: A split-panel todo list block for React and Next.js with a task list and detail panel showing metadata, description, and actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-split-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Tasks</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @(_tasks.Count(t => t.Completed)) of @_tasks.Count done
            </span>
        </div>

        @* Split layout *@
        <div class="grid grid-cols-5">
            @* Task list *@
            <div class="col-span-2 border-r">
                @for (int i = 0; i < _tasks.Count; i++)
                {
                    var task = _tasks[i];
                    var isLast = i == _tasks.Count - 1;
                    var taskId = task.Id;
                    var isSelected = task.Id == _selectedId;
                    <div class="@(isLast ? "" : "border-b")">
                        <button type="button"
                                @onclick="@(() => _selectedId = taskId)"
                                class="@Cn.Merge("flex w-full items-center gap-2.5 px-4 py-3 text-left transition-colors", isSelected ? "bg-muted/50" : "hover:bg-muted/30")">
                            @if (task.Completed)
                            {
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideIconCn Name="circle" Size="16" Class="size-4 shrink-0 text-muted-foreground/40" />
                            }
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("block truncate text-sm", task.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                                    @task.Text
                                </span>
                                <span class="mt-0.5 flex items-center gap-1.5 text-muted-foreground text-xs">
                                    <span class="@Cn.Merge("size-1.5 rounded-full", PriorityDotClass(task.Priority))"></span>
                                    @task.DueDate
                                </span>
                            </div>
                        </button>
                    </div>
                }
            </div>

            @* Detail panel *@
            <div class="col-span-3">
                @if (_selected is { } sel)
                {
                    <div class="p-4">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0 flex-1">
                                <h3 class="@Cn.Merge("font-medium text-sm", sel.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                                    @sel.Text
                                </h3>
                            </div>
                            <CheckboxCn Id="@($"detail-{sel.Id}")"
                                        Checked="@sel.Completed"
                                        CheckedChanged="@((bool _) => ToggleTask(sel.Id))" />
                        </div>

                        <p class="mt-3 text-muted-foreground text-sm leading-relaxed">
                            @sel.Description
                        </p>

                        <div class="mt-4 space-y-2.5">
                            <div class="flex items-center gap-2">
                                <span class="text-muted-foreground text-xs">Priority</span>
                                <span class="flex items-center gap-1.5 text-xs">
                                    <span class="@Cn.Merge("size-1.5 rounded-full", PriorityDotClass(sel.Priority))"></span>
                                    @sel.Priority
                                </span>
                            </div>
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-xs">Due @sel.DueDate</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="tag" Size="12" Class="size-3 text-muted-foreground" />
                                <div class="flex items-center gap-1">
                                    @foreach (var tag in sel.Tags)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@tag</BadgeCn>
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 flex items-center gap-2">
                            <ButtonCn Variant="ButtonVariant.Outline"
                                      Size="ButtonSize.Sm"
                                      Class="h-7 text-xs"
                                      @onclick="@(() => ToggleTask(sel.Id))">
                                @(sel.Completed ? "Reopen" : "Complete")
                            </ButtonCn>
                        </div>
                    </div>
                }
                else
                {
                    <div class="flex h-full items-center justify-center p-8">
                        <span class="text-muted-foreground text-sm">Select a task to view details</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TodoTask(string Id, string Text, string Description, string Priority, string DueDate, string[] Tags, bool Completed);

    private static readonly TodoTask[] _initialTasks =
    [
        new("1", "Redesign settings page",
            "Overhaul the account settings page to match the new design system. Include profile editing, notification preferences, and security settings in a tabbed layout.",
            "high", "Apr 5", ["Design", "Frontend"], false),
        new("2", "Implement rate limiting",
            "Add rate limiting middleware to all public API endpoints. Use a sliding window algorithm with Redis for distributed rate counting. Set default limits to 100 requests per minute.",
            "high", "Apr 6", ["Backend", "Security"], false),
        new("3", "Write migration scripts",
            "Create database migration scripts for the new user preferences schema. Include rollback scripts and test against staging data. Coordinate with the DBA for production deployment window.",
            "medium", "Apr 7", ["Database"], false),
        new("4", "Update API documentation",
            "Bring the OpenAPI spec up to date with the latest endpoint changes. Add request and response examples for all new endpoints. Generate updated SDK clients.",
            "medium", "Apr 8", ["Docs"], true),
        new("5", "Fix mobile nav overflow",
            "The navigation menu overflows on screens narrower than 375px. Truncate long menu items and add a horizontal scroll indicator. Test on iOS Safari and Chrome Android.",
            "low", "Apr 9", ["Bug", "Mobile"], false),
        new("6", "Add dark mode toggle",
            "Implement system-aware dark mode with a manual toggle override. Persist the user preference in localStorage and sync across tabs. Ensure all components respect the theme tokens.",
            "low", "Apr 10", ["Frontend", "UX"], true),
    ];

    private List<TodoTask> _tasks = [.. _initialTasks];
    private string? _selectedId = "1";

    private TodoTask? _selected => _tasks.FirstOrDefault(t => t.Id == _selectedId);

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Completed = !_tasks[idx].Completed };
    }

    private static string PriorityDotClass(string priority) => priority switch
    {
        "high"   => "bg-red-500",
        "medium" => "bg-amber-500",
        _        => "bg-blue-500",
    };
}
