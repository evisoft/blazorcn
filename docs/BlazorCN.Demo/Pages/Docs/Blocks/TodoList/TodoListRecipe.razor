@* ============================================================
   Block: todo-list-recipe
   Title: TodoListRecipe
   Description: A recipe step checklist block for React and Next.js with ingredient checkboxes, expandable numbered steps, timer indicators, servings adjuster, and prep/cook time display built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-recipe.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="chef-hat" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Chicken Teriyaki</span>
            </div>
            <div class="mt-1.5 flex items-center gap-3">
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                    Prep 10 min
                </span>
                <span class="text-muted-foreground/40 text-xs">·</span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="timer" Size="12" Class="size-3" />
                    Cook 15 min
                </span>
                <span class="text-muted-foreground/40 text-xs">·</span>
                <div class="flex items-center gap-1">
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="h-6 w-6 p-0"
                              @onclick="@(() => { _servings = Math.Max(1, _servings - 1); })"
                              Disabled="@(_servings <= 1)"
                              aria-label="Decrease servings">
                        <LucideIconCn Name="minus" Size="12" Class="size-3" />
                    </ButtonCn>
                    <span class="text-muted-foreground text-xs tabular-nums">
                        @_servings servings
                    </span>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="h-6 w-6 p-0"
                              @onclick="@(() => { _servings++; })"
                              aria-label="Increase servings">
                        <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Ingredients header *@
        <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Ingredients</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_checkedIngredients/@_ingredients.Length
            </span>
        </div>

        @* Ingredients *@
        @foreach (var ing in _ingredients)
        {
            var ingId = ing.Id;
            <div class="flex items-center gap-3 border-b px-4 py-2 transition-colors hover:bg-muted/50">
                <CheckboxCn Id="@($"ing-{ing.Id}")"
                            Checked="@ing.Checked"
                            CheckedChanged="@((bool _) => ToggleIngredient(ingId))" />
                <span class="@Cn.Merge("min-w-0 flex-1 text-sm", ing.Checked ? "text-muted-foreground line-through" : "")">
                    @ing.Name
                </span>
                <span class="font-mono text-muted-foreground text-xs">@ing.Quantity</span>
            </div>
        }

        @* Steps header *@
        <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Steps</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_completedSteps/@_steps.Length
            </span>
        </div>

        @* Steps *@
        @for (int i = 0; i < _steps.Length; i++)
        {
            var step = _steps[i];
            var isExpanded = _expandedStep == step.Id;
            var isLast = i == _steps.Length - 1;
            var stepId = step.Id;
            var stepNum = i + 1;
            <div class="@(isLast ? "" : "border-b")">
                <div class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50 cursor-pointer"
                     @onclick="@(() => { _expandedStep = isExpanded ? null : stepId; })"
                     role="button"
                     tabindex="0">
                    <span @onclick:stopPropagation @onclick="@((MouseEventArgs e) => { })">
                        <CheckboxCn Id="@($"step-{step.Id}")"
                                    Checked="@step.Completed"
                                    CheckedChanged="@((bool _) => ToggleStep(stepId))" />
                    </span>
                    <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-muted-foreground text-xs tabular-nums">
                        @stepNum
                    </span>
                    <span class="@Cn.Merge("min-w-0 flex-1 font-medium text-sm", step.Completed ? "text-muted-foreground line-through" : "")">
                        @step.Title
                    </span>
                    @if (step.Timer != null)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 text-xs">
                            <LucideIconCn Name="timer" Size="12" Class="size-3" />
                            @step.Timer
                        </BadgeCn>
                    }
                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </div>

                @if (isExpanded)
                {
                    <div class="px-4 pb-3 pl-16">
                        <p class="text-muted-foreground text-sm leading-relaxed">@step.Detail</p>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record Ingredient(string Id, string Name, string Quantity, bool Checked);
    private record RecipeStep(string Id, string Title, string Detail, string? Timer, bool Completed);

    private Ingredient[] _ingredients =
    [
        new("i1", "Chicken thighs, boneless", "1.5 lbs", false),
        new("i2", "Soy sauce", "3 tbsp", false),
        new("i3", "Mirin", "2 tbsp", true),
        new("i4", "Sake", "2 tbsp", false),
        new("i5", "Sugar", "1 tbsp", true),
        new("i6", "Ginger, grated", "1 tsp", false),
        new("i7", "Garlic, minced", "2 cloves", false),
        new("i8", "Scallions", "3 stalks", false),
        new("i9", "Steamed rice", "2 cups", false),
        new("i10", "Sesame seeds", "1 tsp", true),
    ];

    private RecipeStep[] _steps =
    [
        new("s1", "Prepare the chicken", "Pat chicken thighs dry with paper towels. Cut into bite-sized pieces, roughly 1-inch cubes. Season lightly with salt and pepper.", null, true),
        new("s2", "Mix the teriyaki sauce", "In a small bowl, whisk together soy sauce, mirin, sake, and sugar until the sugar dissolves. Set aside.", null, true),
        new("s3", "Sear the chicken", "Heat a large skillet or wok over medium-high heat with a thin layer of neutral oil. Add chicken pieces in a single layer. Cook without moving for 3 minutes until golden on the bottom, then flip.", "3 min", false),
        new("s4", "Add aromatics", "Push chicken to one side of the pan. Add grated ginger and minced garlic to the empty side. Stir aromatics for 30 seconds until fragrant, then mix with the chicken.", null, false),
        new("s5", "Glaze with sauce", "Pour the teriyaki sauce over the chicken. Toss to coat evenly. Let the sauce simmer and reduce until it thickens into a glossy glaze that clings to the chicken.", "5 min", false),
        new("s6", "Serve", "Plate the glazed chicken over steamed rice. Garnish with sliced scallions and a sprinkle of sesame seeds. Serve immediately while hot.", null, false),
    ];

    private string? _expandedStep = "s3";
    private int _servings = 4;

    private int _checkedIngredients => _ingredients.Count(ing => ing.Checked);
    private int _completedSteps => _steps.Count(s => s.Completed);

    private void ToggleIngredient(string id)
    {
        for (int i = 0; i < _ingredients.Length; i++)
        {
            if (_ingredients[i].Id == id)
            {
                _ingredients[i] = _ingredients[i] with { Checked = !_ingredients[i].Checked };
                break;
            }
        }
    }

    private void ToggleStep(string id)
    {
        for (int i = 0; i < _steps.Length; i++)
        {
            if (_steps[i].Id == id)
            {
                _steps[i] = _steps[i] with { Completed = !_steps[i].Completed };
                break;
            }
        }
    }
}
