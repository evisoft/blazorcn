@* ============================================================
   Block: todo-list-progress-board
   Title: TodoListProgressBoard
   Description: A visual progress tracking todo list block for React and Next.js with progress sliders per task, grouped sections by progress range, and overall project progress built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-progress-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Progress Board</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @Complete.Length of @_tasks.Count complete
            </span>
        </div>

        @* Overall progress *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Overall progress</span>
                <span class="@Cn.Merge("font-semibold text-2xl tabular-nums", GetProgressColor(OverallProgress))">
                    @OverallProgress%
                </span>
            </div>
            <div class="mt-2 h-2 overflow-hidden rounded-full bg-muted">
                <div class="@Cn.Merge("h-full rounded-full transition-colors duration-300", GetProgressBarColor(OverallProgress))"
                     style="width: @(OverallProgress)%"></div>
            </div>
            <div class="mt-2 flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    @NotStarted.Length not started
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @InProgress.Length in progress
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @Complete.Length complete
                </span>
            </div>
        </div>

        @* Grouped tasks *@
        <div>
            @for (int gi = 0; gi < Groups.Length; gi++)
            {
                var grp = Groups[gi];
                var isLastGroup = gi == Groups.Length - 1;
                @* Group header *@
                <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2">
                    <span class="@Cn.Merge("size-1.5 rounded-full", grp.DotColor)"></span>
                    <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                        @grp.Name
                    </span>
                    <span class="text-muted-foreground/60 text-xs tabular-nums">
                        (@(grp.Tasks.Length))
                    </span>
                </div>
                @* Tasks in group *@
                @for (int ti = 0; ti < grp.Tasks.Length; ti++)
                {
                    var task = grp.Tasks[ti];
                    var isLastInGroup = ti == grp.Tasks.Length - 1;
                    var taskId = task.Id;
                    <div class="@((isLastInGroup && isLastGroup) ? "" : "border-b")">
                        <div class="flex w-full items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("block text-sm", task.Progress == 100 ? "text-muted-foreground line-through" : "text-foreground")">
                                    @task.Text
                                </span>
                                <div class="mt-1.5 flex items-center gap-2">
                                    <SliderCn aria-label="@($"Progress for {task.Text}")" Value="@((double)task.Progress)"
                                              ValueChanged="@((double v) => UpdateProgress(taskId, v))"
                                              Step="5"
                                              Class="flex-1" />
                                </div>
                            </div>
                            <span class="@Cn.Merge("shrink-0 font-medium text-xs tabular-nums", GetProgressColor(task.Progress))">
                                @task.Progress%
                            </span>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private record TaskItem(string Id, string Text, int Progress);
    private record GroupItem(string Name, TaskItem[] Tasks, string DotColor);

    private List<TaskItem> _tasks =
    [
        new("1", "User authentication module", 100),
        new("2", "Dashboard layout and navigation", 75),
        new("3", "Payment integration", 40),
        new("4", "Email notification service", 90),
        new("5", "Search and filtering system", 15),
        new("6", "Data export functionality", 0),
        new("7", "Admin panel CRUD operations", 60),
        new("8", "API rate limiting middleware", 100),
        new("9", "File upload and storage", 0),
        new("10", "Webhook event processing", 30),
    ];

    private int OverallProgress => _tasks.Count > 0
        ? (int)Math.Round(_tasks.Sum(t => (double)t.Progress) / _tasks.Count)
        : 0;

    private TaskItem[] NotStarted => _tasks.Where(t => t.Progress == 0).ToArray();
    private TaskItem[] InProgress => _tasks.Where(t => t.Progress > 0 && t.Progress < 100).ToArray();
    private TaskItem[] Complete => _tasks.Where(t => t.Progress == 100).ToArray();

    private GroupItem[] Groups => new GroupItem[]
    {
        new("Not Started", NotStarted, "bg-muted-foreground/40"),
        new("In Progress", InProgress, "bg-blue-500"),
        new("Complete", Complete, "bg-emerald-500"),
    }.Where(g => g.Tasks.Length > 0).ToArray();

    private void UpdateProgress(string id, double value)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
        {
            _tasks[idx] = _tasks[idx] with { Progress = (int)value };
        }
    }

    private static string GetProgressColor(int value)
    {
        if (value == 100) return "text-emerald-600 dark:text-emerald-400";
        if (value >= 50) return "text-amber-600 dark:text-amber-400";
        if (value > 0) return "text-blue-600 dark:text-blue-400";
        return "text-muted-foreground";
    }

    private static string GetProgressBarColor(int value)
    {
        if (value == 100) return "bg-emerald-500";
        if (value >= 50) return "bg-amber-500";
        if (value > 0) return "bg-blue-500";
        return "bg-muted";
    }
}
