@* ============================================================
   Block: todo-list-security-audit
   Title: TodoListSecurityAudit
   Description: A security audit checklist block for React and Next.js with severity-coded items, category grouping, compliance badges, and auditor tracking built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-security-audit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Security Audit</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"font-normal text-xs {_complianceColor}")">@_complianceStatus</BadgeCn>
        </div>

        @* Summary *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Auditor: James Rivera</span>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">Last audit: Mar 15, 2026</span>
            <span class="ml-auto text-muted-foreground text-xs tabular-nums">@_checked.Count/@_totalItems checked</span>
        </div>

        @* Categories *@
        <div>
            @for (int ci = 0; ci < _auditCategories.Length; ci++)
            {
                var cat = _auditCategories[ci];
                var isExpanded = _expandedCategories.Contains(cat.Id);
                var catCompleted = cat.Items.Count(i => _checked.Contains(i.Id));
                var isLastCategory = ci == _auditCategories.Length - 1;
                var catId = cat.Id;
                <div class="@((isLastCategory && !isExpanded) ? "" : "border-b")">
                    <button type="button" @onclick="@(() => ToggleCategory(catId))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right" Size="16"
                            Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                        <span class="font-medium text-sm">@cat.Title</span>
                        <span class="ml-auto text-muted-foreground text-xs tabular-nums">@catCompleted/@cat.Items.Length</span>
                    </button>

                    @if (isExpanded)
                    {
                        @for (int ii = 0; ii < cat.Items.Length; ii++)
                        {
                            var item = cat.Items[ii];
                            var isChecked = _checked.Contains(item.Id);
                            var isLastItem = ii == cat.Items.Length - 1;
                            var itemId = item.Id;
                            <div class="@((isLastItem && isLastCategory) ? "" : "border-b")">
                                <label for="@($"security-{itemId}")"
                                       class="flex w-full cursor-pointer items-center gap-3 px-4 py-2.5 pl-11 transition-colors hover:bg-muted/50">
                                    <CheckboxCn Id="@($"security-{itemId}")" Checked="@isChecked" CheckedChanged="@((bool _) => Toggle(itemId))" aria-label="@item.Title" />
                                    <span class="@($"size-1.5 shrink-0 rounded-full {GetSeverityDot(item.Severity)}")"></span>
                                    <span class="@($"min-w-0 flex-1 text-sm transition-all duration-200{(isChecked ? " text-muted-foreground line-through" : "")}")">@item.Title</span>
                                    <span class="shrink-0 text-muted-foreground text-xs">@GetSeverityLabel(item.Severity)</span>
                                </label>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum ItemSeverity { Critical, High, Medium, Low }

    private record AuditItem(string Id, string Title, ItemSeverity Severity);
    private record AuditCategory(string Id, string Title, AuditItem[] Items);

    private static readonly AuditCategory[] _auditCategories =
    [
        new("auth", "Authentication",
        [
            new("au1", "Passwords hashed with bcrypt/argon2", ItemSeverity.Critical),
            new("au2", "Multi-factor authentication available", ItemSeverity.High),
            new("au3", "Session tokens expire after inactivity", ItemSeverity.High),
            new("au4", "Brute force protection enabled", ItemSeverity.Medium),
        ]),
        new("authz", "Authorization",
        [
            new("az1", "Role-based access control enforced", ItemSeverity.Critical),
            new("az2", "API endpoints verify permissions", ItemSeverity.Critical),
            new("az3", "No privilege escalation paths", ItemSeverity.High),
        ]),
        new("data", "Data Protection",
        [
            new("d1", "Data encrypted at rest (AES-256)", ItemSeverity.Critical),
            new("d2", "TLS 1.3 enforced for transit", ItemSeverity.Critical),
            new("d3", "PII masked in logs", ItemSeverity.High),
            new("d4", "Backup encryption verified", ItemSeverity.Medium),
        ]),
        new("input", "Input Validation",
        [
            new("i1", "SQL injection prevented", ItemSeverity.Critical),
            new("i2", "XSS sanitization applied", ItemSeverity.Critical),
            new("i3", "CSRF tokens validated", ItemSeverity.High),
            new("i4", "File upload restrictions enforced", ItemSeverity.Medium),
        ]),
        new("api", "API Security",
        [
            new("ap1", "Rate limiting configured", ItemSeverity.High),
            new("ap2", "CORS policy restrictive", ItemSeverity.Medium),
            new("ap3", "API keys rotated regularly", ItemSeverity.Low),
        ]),
    ];

    private HashSet<string> _checked = ["au1", "d1", "d2", "i1"];
    private HashSet<string> _expandedCategories = ["auth", "authz", "data", "input", "api"];

    private int _totalItems => _auditCategories.Sum(c => c.Items.Length);
    private int _criticalCount => _auditCategories.SelectMany(c => c.Items).Count(i => i.Severity == ItemSeverity.Critical);
    private int _criticalCompleted => _auditCategories.SelectMany(c => c.Items).Where(i => i.Severity == ItemSeverity.Critical).Count(i => _checked.Contains(i.Id));
    private bool _allCriticalDone => _criticalCompleted == _criticalCount;

    private string _complianceStatus => _allCriticalDone
        ? (_checked.Count == _totalItems ? "Compliant" : "Partially Compliant")
        : "Non-Compliant";

    private string _complianceColor => _allCriticalDone
        ? (_checked.Count == _totalItems
            ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
            : "bg-amber-500/10 text-amber-600 dark:text-amber-400")
        : "bg-red-500/10 text-red-600 dark:text-red-400";

    private static string GetSeverityDot(ItemSeverity severity) => severity switch
    {
        ItemSeverity.Critical => "bg-red-500",
        ItemSeverity.High => "bg-amber-500",
        ItemSeverity.Medium => "bg-blue-500",
        ItemSeverity.Low => "bg-zinc-400",
        _ => "",
    };

    private static string GetSeverityLabel(ItemSeverity severity) => severity switch
    {
        ItemSeverity.Critical => "Critical",
        ItemSeverity.High => "High",
        ItemSeverity.Medium => "Medium",
        ItemSeverity.Low => "Low",
        _ => "",
    };

    private void Toggle(string id)
    {
        if (_checked.Contains(id))
            _checked.Remove(id);
        else
            _checked.Add(id);
    }

    private void ToggleCategory(string id)
    {
        if (_expandedCategories.Contains(id))
            _expandedCategories.Remove(id);
        else
            _expandedCategories.Add(id);
    }
}
