@* ============================================================
   Block: todo-list-dark-minimal
   Title: TodoListDarkMinimal
   Description: A dark-themed minimal todo list block for React and Next.js with zinc-950 background, subtle borders, glowing focus states, and ultra-clean aesthetic built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-dark-minimal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-zinc-800 bg-zinc-950">
        @* Header *@
        <div class="flex items-center justify-between border-b border-zinc-800 px-4 py-3">
            <span class="font-medium text-sm text-zinc-100">Tasks</span>
            <div class="flex items-center gap-2">
                <span class="flex items-center gap-1.5 text-xs text-zinc-400">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="tabular-nums">@_completedCount</span>
                </span>
                <span class="text-zinc-600">·</span>
                <span class="text-xs text-zinc-400 tabular-nums">@_tasks.Count total</span>
            </div>
        </div>

        @* Add task *@
        <div class="flex items-center gap-2 border-b border-zinc-800 px-4 py-2">
            <InputCn @bind-Value="_newTask"
                     @onkeydown="HandleInputKeyDown"
                     Placeholder="Add a task..."
                     Class="h-8 border-0 bg-transparent px-0 text-sm text-zinc-100 shadow-none placeholder:text-zinc-600 focus-visible:ring-0" />
            <button type="button"
                    @onclick="AddTask"
                    disabled="@(string.IsNullOrWhiteSpace(_newTask))"
                    class="flex size-7 shrink-0 items-center justify-center rounded-md text-zinc-400 transition-all hover:bg-zinc-800 hover:text-zinc-100 disabled:opacity-30 disabled:hover:bg-transparent disabled:hover:text-zinc-400"
                    aria-label="Add task">
                <LucideIconCn Name="plus" Size="16" Class="size-4" />
            </button>
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < _tasks.Count; i++)
            {
                var task = _tasks[i];
                var taskId = task.Id;
                var isLast = i == _tasks.Count - 1;
                var isFocused = _focusedId == task.Id;
                <div class="@(isLast ? "" : "border-b border-zinc-800/60")">
                    <div class="@Cn.Merge("group flex w-full items-center gap-3 px-4 py-3 transition-all", isFocused ? "ring-1 ring-inset ring-zinc-600 shadow-sm shadow-zinc-700/50" : "hover:bg-zinc-900/50")"
                         @onmouseenter="@(() => _focusedId = taskId)"
                         @onmouseleave="@(() => _focusedId = null)">
                        @* Custom dark checkbox *@
                        <button type="button"
                                @onclick="@(() => ToggleTask(taskId))"
                                class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded border transition-all", task.Completed ? "border-emerald-500 bg-emerald-500" : "border-zinc-700 hover:border-zinc-500")"
                                aria-label="@CheckboxAriaLabel(task.Text, task.Completed)">
                            @if (task.Completed)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-zinc-950" />
                            }
                        </button>

                        <span class="@Cn.Merge("min-w-0 flex-1 text-sm transition-all duration-200", task.Completed ? "text-zinc-600 line-through" : "text-zinc-100")">
                            @task.Text
                        </span>

                        <button type="button"
                                @onclick="@(() => DeleteTask(taskId))"
                                class="flex size-6 shrink-0 items-center justify-center rounded text-zinc-600 opacity-0 transition-all hover:bg-zinc-800 hover:text-zinc-400 group-hover:opacity-100"
                                aria-label="@($"Delete {task.Text}")">
                            <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                        </button>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t border-zinc-800 px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs text-zinc-500">
                    @_completedCount of @_tasks.Count completed
                </span>
                <div class="flex gap-px">
                    @foreach (var t in _tasks)
                    {
                        <div class="@Cn.Merge("size-1.5 rounded-full", t.Completed ? "bg-emerald-500" : "bg-zinc-800")"></div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record TaskItem(string Id, string Text, bool Completed);

    private int _nextId = 8;

    private List<TaskItem> _tasks =
    [
        new("1", "Deploy production build", false),
        new("2", "Run database migrations", true),
        new("3", "Update environment variables", false),
        new("4", "Verify SSL certificate renewal", false),
        new("5", "Check monitoring alerts", true),
        new("6", "Review error logs from last deploy", false),
        new("7", "Update DNS records for new domain", false),
    ];

    private string _newTask = "";
    private string? _focusedId = null;

    private int _completedCount => _tasks.Count(t => t.Completed);

    private void AddTask()
    {
        var trimmed = _newTask.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        _tasks.Add(new TaskItem(_nextId.ToString(), trimmed, false));
        _nextId++;
        _newTask = "";
    }

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Completed = !_tasks[idx].Completed };
    }

    private void DeleteTask(string id)
    {
        _tasks.RemoveAll(t => t.Id == id);
    }

    private void HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTask();
    }

    private static string CheckboxAriaLabel(string text, bool completed)
        => completed ? $"Mark \"{text}\" incomplete" : $"Mark \"{text}\" complete";
}
