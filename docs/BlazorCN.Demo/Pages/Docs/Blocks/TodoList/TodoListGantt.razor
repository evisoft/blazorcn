@* ============================================================
   Block: todo-list-gantt
   Title: TodoListGantt
   Description: A simplified Gantt-style timeline todo list block for React and Next.js with horizontal task bars, five-day grid, dependency arrows, and status coloring built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-gantt.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Project Timeline</span>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs tabular-nums">
                    @DoneCount of @TotalCount done
                </span>
                <div class="flex items-center gap-2">
                    @foreach (var entry in _statusLabels)
                    {
                        <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                            <span class="@Cn.Merge("size-1.5 rounded-full", StatusDotClass(entry.Status))"></span>
                            @entry.Label
                        </span>
                    }
                </div>
            </div>
        </div>

        @* Day headers *@
        <div class="flex border-b">
            <div class="w-48 shrink-0 border-r px-3 py-2">
                <span class="font-medium text-muted-foreground text-xs">Task</span>
            </div>
            <div class="relative flex flex-1">
                @for (int di = 0; di < _days.Length; di++)
                {
                    var day = _days[di];
                    var dayIdx = di;
                    <div class="@Cn.Merge("flex-1 px-2 py-2 text-center", dayIdx < _days.Length - 1 ? "border-r border-dashed" : "")">
                        <span class="@Cn.Merge("font-mono text-xs", dayIdx == TodayIndex ? "font-medium text-foreground" : "text-muted-foreground")">
                            @day
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Task rows *@
        <div>
            @for (int ti = 0; ti < _tasks.Length; ti++)
            {
                var task = _tasks[ti];
                var isLast = ti == _tasks.Length - 1;
                var barLeft = FormattableString.Invariant($"{(double)task.StartDay / _days.Length * 100:F2}%");
                var barWidth = FormattableString.Invariant($"{(double)task.Duration / _days.Length * 100:F2}%");
                <div class="@Cn.Merge("flex", isLast ? "" : "border-b")">

                    @* Task name *@
                    <div class="flex w-48 shrink-0 flex-col justify-center border-r px-3 py-3">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", StatusDotClass(task.Status))"></span>
                            <span class="@Cn.Merge("truncate text-sm", task.Status == TaskStatus.Done ? "text-muted-foreground line-through" : "font-medium")">
                                @task.Text
                            </span>
                        </div>
                        @if (task.DependsOn.Length > 0)
                        {
                            <span class="mt-0.5 truncate pl-3.5 text-muted-foreground text-[10px]">
                                depends on @GetDependsOnText(task.DependsOn)
                            </span>
                        }
                    </div>

                    @* Gantt bar area *@
                    <div class="relative flex flex-1 items-center">

                        @* Grid lines *@
                        @for (int gi = 0; gi < _days.Length; gi++)
                        {
                            var gIdx = gi;
                            <div class="@Cn.Merge("absolute top-0 bottom-0", gIdx < _days.Length - 1 ? "border-r border-dashed" : "")"
                                 style="@(FormattableString.Invariant($"left:{((double)(gIdx + 1) / _days.Length * 100):F2}%"))">
                            </div>
                        }

                        @* Today marker *@
                        <div class="absolute top-0 bottom-0 w-px bg-foreground/20"
                             style="@(FormattableString.Invariant($"left:{((TodayIndex + 0.5) / _days.Length * 100):F2}%"))">
                        </div>

                        @* Task bar *@
                        <div class="@Cn.Merge("absolute h-6 rounded", StatusBarClass(task.Status))"
                             style="@(FormattableString.Invariant($"left:{barLeft};width:{barWidth};transform-origin:left"))">
                            <span class="flex h-full items-center px-2 text-[10px] font-medium text-white">
                                @(task.Duration)d
                            </span>
                        </div>

                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">@TotalCount tasks across 5 days</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Today: @_days[TodayIndex]
            </BadgeCn>
        </div>

    </div>
</section>

@code {
    private enum TaskStatus { Done, InProgress, Todo, Blocked }

    private record GanttTask(string Id, string Text, int StartDay, int Duration, TaskStatus Status, string[] DependsOn);

    private static readonly (TaskStatus Status, string Label)[] _statusLabels =
    [
        (TaskStatus.Done,       "Done"),
        (TaskStatus.InProgress, "In Progress"),
        (TaskStatus.Todo,       "To Do"),
        (TaskStatus.Blocked,    "Blocked"),
    ];

    private static readonly string[] _days = ["Mon", "Tue", "Wed", "Thu", "Fri"];
    private const int TodayIndex = 3;

    private static readonly GanttTask[] _tasks =
    [
        new("1", "Design system audit",      0, 2, TaskStatus.Done,       []),
        new("2", "API schema design",        0, 3, TaskStatus.Done,       []),
        new("3", "Component library setup",  2, 2, TaskStatus.InProgress, ["1"]),
        new("4", "Database migrations",      3, 2, TaskStatus.InProgress, ["2"]),
        new("5", "Auth integration",         3, 2, TaskStatus.Todo,       ["2"]),
        new("6", "E2E test suite",           4, 1, TaskStatus.Blocked,    ["3", "5"]),
    ];

    private int DoneCount  => _tasks.Count(t => t.Status == TaskStatus.Done);
    private int TotalCount => _tasks.Length;

    private static string StatusDotClass(TaskStatus s) => s switch
    {
        TaskStatus.Done       => "bg-emerald-500",
        TaskStatus.InProgress => "bg-blue-500",
        TaskStatus.Todo       => "bg-muted-foreground/30",
        TaskStatus.Blocked    => "bg-red-500",
        _                     => "",
    };

    private static string StatusBarClass(TaskStatus s) => s switch
    {
        TaskStatus.Done       => "bg-emerald-500/80",
        TaskStatus.InProgress => "bg-blue-500/80",
        TaskStatus.Todo       => "bg-muted-foreground/30",
        TaskStatus.Blocked    => "bg-red-500/80",
        _                     => "",
    };

    private string GetDependsOnText(string[] ids) =>
        string.Join(", ", ids.Select(id => _tasks.FirstOrDefault(t => t.Id == id)?.Text ?? id));
}
