@* ============================================================
   Block: todo-list-workout
   Title: TodoListWorkout
   Description: A workout routine tracker block for React and Next.js with warm-up, main set, and cool-down sections, sets and reps, weight tracking, rest timers, and muscle group badges built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-workout.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="dumbbell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Push Day — Chest &amp; Triceps</span>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span class="flex items-center gap-1">
                    <LucideIconCn Name="clock" Size="12" Class="size-3" />~@((int)Math.Round(_estimatedMinutes)) min
                </span>
                <span class="tabular-nums">
                    @_completedCount/@_exercises.Count
                </span>
            </div>
        </div>

        @* Sections *@
        @foreach (var secName in _sections)
        {
            var sectionExercises = _exercises.Where(e => e.Section == secName).ToList();
            if (sectionExercises.Count == 0) continue;
            var sectionCompleted = sectionExercises.Count(e => e.Completed);

            <div>
                <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2">
                    <span class="font-medium text-xs">@secName</span>
                    <span class="text-muted-foreground text-xs tabular-nums">
                        @sectionCompleted/@sectionExercises.Count
                    </span>
                </div>

                @for (int ei = 0; ei < sectionExercises.Count; ei++)
                {
                    var exercise = sectionExercises[ei];
                    var exId = exercise.Id;
                    var isExpanded = _expanded == exercise.Id;
                    var isLastInSection = ei == sectionExercises.Count - 1;
                    var isLastSection = secName == _sections[_sections.Length - 1];
                    var showBorder = !(isLastInSection && isLastSection);

                    <div class="@(showBorder ? "border-b" : "")">
                        <div class="flex w-full items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50 cursor-pointer"
                             @onclick="@(() => ToggleExpanded(exId))"
                             role="button"
                             tabindex="0">
                            <span role="presentation" @onclick:stopPropagation>
                                <CheckboxCn Id="@($"workout-{exercise.Id}")"
                                            Checked="@exercise.Completed"
                                            CheckedChanged="@((bool _) => ToggleCompleted(exId))" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("font-medium text-sm", exercise.Completed ? "text-muted-foreground line-through" : "")">
                                    @exercise.Name
                                </span>
                                <div class="mt-0.5 flex items-center gap-2">
                                    <span class="font-mono text-muted-foreground text-xs">
                                        @(exercise.Sets)x@(exercise.Reps)
                                    </span>
                                    @if (exercise.Weight != "—")
                                    {
                                        <span class="text-muted-foreground/40 text-xs">·</span>
                                        <span class="font-mono text-muted-foreground text-xs">
                                            @exercise.Weight
                                        </span>
                                    }
                                </div>
                            </div>
                            @if (exercise.Rest != "—")
                            {
                                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                    <LucideIconCn Name="timer" Size="12" Class="size-3" />
                                    @exercise.Rest
                                </span>
                            }
                            <LucideIconCn Name="chevron-right"
                                          Size="16"
                                          Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </div>

                        @if (isExpanded)
                        {
                            <div class="flex flex-wrap gap-1.5 px-4 pb-3 pl-10">
                                @foreach (var muscle in exercise.Muscles)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">@muscle</BadgeCn>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record Exercise(
        string Id,
        string Name,
        string Section,
        int Sets,
        string Reps,
        string Weight,
        string Rest,
        string[] Muscles,
        bool Completed
    );

    private static readonly string[] _sections = ["Warm Up", "Main Set", "Cool Down"];

    private List<Exercise> _exercises =
    [
        new("1",  "Jump rope",                  "Warm Up",   1, "3 min",   "—",       "—",   ["Cardio"],              true),
        new("2",  "Arm circles",                "Warm Up",   2, "15",      "—",       "15s", ["Shoulders"],           true),
        new("3",  "Leg swings",                 "Warm Up",   2, "12",      "—",       "15s", ["Hips"],                true),
        new("4",  "Barbell bench press",        "Main Set",  4, "8",       "185 lbs", "90s", ["Chest", "Triceps"],    true),
        new("5",  "Incline dumbbell press",     "Main Set",  3, "10",      "65 lbs",  "75s", ["Upper Chest"],         false),
        new("6",  "Cable flyes",                "Main Set",  3, "12",      "30 lbs",  "60s", ["Chest"],               false),
        new("7",  "Overhead tricep extension",  "Main Set",  3, "12",      "45 lbs",  "60s", ["Triceps"],             false),
        new("8",  "Tricep pushdowns",           "Main Set",  3, "15",      "40 lbs",  "45s", ["Triceps"],             false),
        new("9",  "Dumbbell lateral raises",    "Main Set",  3, "15",      "20 lbs",  "45s", ["Shoulders"],           false),
        new("10", "Chest stretch",              "Cool Down", 1, "30s hold","—",       "—",   ["Chest"],               false),
        new("11", "Tricep stretch",             "Cool Down", 1, "30s hold","—",       "—",   ["Triceps"],             false),
        new("12", "Foam roll chest",            "Cool Down", 1, "2 min",   "—",       "—",   ["Chest"],               false),
    ];

    private string? _expanded = null;

    private int _completedCount => _exercises.Count(e => e.Completed);

    private double _estimatedMinutes => _exercises.Sum(ex =>
    {
        var setTime = ex.Sets * 0.75;
        var restTime = ex.Rest != "—" ? (int.Parse(ex.Rest.TrimEnd('s')) * (ex.Sets - 1)) / 60.0 : 0;
        return setTime + restTime;
    });

    private void ToggleCompleted(string id)
    {
        var idx = _exercises.FindIndex(e => e.Id == id);
        if (idx >= 0)
            _exercises[idx] = _exercises[idx] with { Completed = !_exercises[idx].Completed };
    }

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
