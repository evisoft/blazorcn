@* ============================================================
   Block: todo-list-legal-review
   Title: TodoListLegalReview
   Description: A legal document review todo list block for React and Next.js with document types, reviewer assignments, risk levels, deadline tracking, and section grouping built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-legal-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="scale" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Legal Review</span>
                <span class="text-muted-foreground text-xs tabular-nums">@PendingCount pending</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @(_items.Count(i => i.Risk == RiskLevel.High)) high risk
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @(_items.Count(i => i.Risk == RiskLevel.Medium)) medium
                </span>
            </div>
        </div>

        @* Sections *@
        @for (int si = 0; si < _sectionNames.Length; si++)
        {
            var grp = _sectionNames[si];
            var sectionDocs = _items.Where(i => i.DocSection == grp).ToArray();
            if (sectionDocs.Length == 0) continue;
            bool isCollapsed = _collapsedSections.Contains(grp);
            bool isLastSection = si == _sectionNames.Length - 1;
            var grpLabel = grp switch { DocSection.Urgent => "Urgent", DocSection.ThisWeek => "This Week", DocSection.Backlog => "Backlog", _ => "" };
            var grpCopy = grp;

            <div>
                <button type="button"
                        @onclick="@(() => ToggleSection(grpCopy))"
                        class="flex w-full items-center gap-2 border-b bg-muted/30 px-4 py-2 text-left transition-colors hover:bg-muted/50">
                    <LucideIconCn Name="chevron-right" Size="14"
                                  Class="@($"size-3.5 text-muted-foreground/60 transition-transform duration-200{(isCollapsed ? "" : " rotate-90")}")" />
                    <span class="font-medium text-xs">@grpLabel</span>
                    <span class="text-muted-foreground text-xs tabular-nums">@sectionDocs.Length</span>
                </button>

                @if (!isCollapsed)
                {
                    for (int di = 0; di < sectionDocs.Length; di++)
                    {
                        var doc = sectionDocs[di];
                        bool isExpanded = _expanded == doc.Id;
                        bool isLastInSection = di == sectionDocs.Length - 1;
                        bool showBorder = !(isLastInSection && isLastSection);
                        var docId = doc.Id;

                        <div class="@(showBorder ? "border-b" : "")">
                            <div class="flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                                <div class="mt-0.5">
                                    <CheckboxCn Value="@doc.Completed" ValueChanged="@((bool v) => Toggle(docId))" />
                                </div>
                                <button type="button"
                                        @onclick="@(() => SetExpanded(docId, isExpanded))"
                                        class="min-w-0 flex-1 text-left">
                                    <div class="flex items-center gap-2">
                                        <span class="@($"size-1.5 shrink-0 rounded-full {RiskDotClass(doc.Risk)}")"></span>
                                        <span class="@($"font-medium text-sm transition-all duration-200{(doc.Completed ? " text-muted-foreground line-through" : "")}")">
                                            @doc.Title
                                        </span>
                                    </div>
                                    <div class="mt-1 flex items-center gap-2 pl-3.5">
                                        <BadgeCn Variant="BadgeVariant.Secondary"
                                                 Class="@($"font-normal text-xs {DocTypeBadgeClass(doc.DocType)}")">
                                            @DocTypeLabel(doc.DocType)
                                        </BadgeCn>
                                        <span class="text-muted-foreground text-xs">@doc.Reviewer</span>
                                        <span class="text-muted-foreground text-xs">·</span>
                                        <span class="text-muted-foreground text-xs">Due @doc.Deadline</span>
                                        <span class="text-muted-foreground text-xs">·</span>
                                        <span class="font-mono text-muted-foreground text-xs tabular-nums">@doc.Pages pages</span>
                                    </div>
                                </button>
                                <div class="flex shrink-0 items-center gap-2 pt-0.5">
                                    <span class="@($"size-1.5 rounded-full {StatusDotClass(doc.Status)}")"></span>
                                    <LucideIconCn Name="chevron-right" Size="16"
                                                  Class="@($"size-4 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                                </div>
                            </div>

                            @if (isExpanded)
                            {
                                <div class="flex gap-2 px-4 pb-3 pl-10">
                                    @if (doc.Status == ReviewStatus.PendingReview)
                                    {
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                                            <LucideIconCn Name="file-text" Size="12" Class="size-3" />
                                            Start Review
                                        </ButtonCn>
                                    }
                                    @if (doc.Status == ReviewStatus.UnderReview)
                                    {
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                            Approve
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                            Request Revision
                                        </ButtonCn>
                                    }
                                    @if (doc.Status == ReviewStatus.NeedsRevision)
                                    {
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                            Resubmit
                                        </ButtonCn>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">@PendingCount documents pending review</span>
            <span class="font-mono text-muted-foreground text-xs tabular-nums">@TotalPages pages to review</span>
        </div>
    </div>
</section>

@code {
    private enum DocType { Contract, NDA, Terms, Patent }
    private enum ReviewStatus { PendingReview, UnderReview, Approved, NeedsRevision }
    private enum RiskLevel { High, Medium, Low }
    private enum DocSection { Urgent, ThisWeek, Backlog }

    private record LegalDoc(
        string Id,
        string Title,
        DocType DocType,
        string Reviewer,
        string Deadline,
        ReviewStatus Status,
        int Pages,
        RiskLevel Risk,
        DocSection DocSection,
        bool Completed);

    private static readonly DocSection[] _sectionNames = [DocSection.Urgent, DocSection.ThisWeek, DocSection.Backlog];

    private List<LegalDoc> _items =
    [
        new("l1", "Acme Corp Master Service Agreement",       DocType.Contract, "Jennifer Wu",  "Apr 4",  ReviewStatus.UnderReview,    42, RiskLevel.High,   DocSection.Urgent,   false),
        new("l2", "Vendor Non-Disclosure Agreement — DataSync", DocType.NDA,      "Michael Ross", "Apr 4",  ReviewStatus.PendingReview,  8,  RiskLevel.Medium, DocSection.Urgent,   false),
        new("l3", "Platform Terms of Service v3.2",           DocType.Terms,    "Jennifer Wu",  "Apr 7",  ReviewStatus.NeedsRevision,  24, RiskLevel.High,   DocSection.ThisWeek, false),
        new("l4", "AI Model Training Patent Application",     DocType.Patent,   "David Chen",   "Apr 9",  ReviewStatus.UnderReview,    67, RiskLevel.Medium, DocSection.ThisWeek, false),
        new("l5", "Employee Stock Option Plan Amendment",     DocType.Contract, "Michael Ross", "Apr 8",  ReviewStatus.PendingReview,  18, RiskLevel.Low,    DocSection.ThisWeek, false),
        new("l6", "CloudBase Partnership Agreement",          DocType.Contract, "Jennifer Wu",  "Apr 3",  ReviewStatus.Approved,       35, RiskLevel.High,   DocSection.Urgent,   true),
        new("l7", "Contractor NDA — International Team", DocType.NDA,      "David Chen",   "Apr 15", ReviewStatus.PendingReview,  6,  RiskLevel.Low,    DocSection.Backlog,  false),
        new("l8", "Data Processing Agreement — EU Clients", DocType.Terms, "Michael Ross", "Apr 18", ReviewStatus.PendingReview,  31, RiskLevel.Medium, DocSection.Backlog,  false),
        new("l9", "Edge Caching Method Patent Filing",        DocType.Patent,   "David Chen",   "Apr 20", ReviewStatus.PendingReview,  54, RiskLevel.Low,    DocSection.Backlog,  false),
    ];

    private string? _expanded = null;
    private HashSet<DocSection> _collapsedSections = [];

    private int PendingCount => _items.Count(i => i.Status != ReviewStatus.Approved);
    private int TotalPages => _items.Where(i => !i.Completed).Sum(d => d.Pages);

    private void Toggle(string id)
    {
        var idx = _items.FindIndex(i => i.Id == id);
        if (idx >= 0)
            _items[idx] = _items[idx] with { Completed = !_items[idx].Completed };
    }

    private void SetExpanded(string id, bool wasExpanded)
    {
        _expanded = wasExpanded ? null : id;
    }

    private void ToggleSection(DocSection grp)
    {
        if (_collapsedSections.Contains(grp))
            _collapsedSections.Remove(grp);
        else
            _collapsedSections.Add(grp);
    }

    private static string DocTypeBadgeClass(DocType dt) => dt switch
    {
        DocType.Contract => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        DocType.NDA      => "bg-purple-500/10 text-purple-700 dark:text-purple-400",
        DocType.Terms    => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        DocType.Patent   => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        _                => ""
    };

    private static string DocTypeLabel(DocType dt) => dt switch
    {
        DocType.Contract => "Contract",
        DocType.NDA      => "NDA",
        DocType.Terms    => "Terms",
        DocType.Patent   => "Patent",
        _                => ""
    };

    private static string RiskDotClass(RiskLevel r) => r switch
    {
        RiskLevel.High   => "bg-red-500",
        RiskLevel.Medium => "bg-amber-500",
        RiskLevel.Low    => "bg-blue-500",
        _                => ""
    };

    private static string StatusDotClass(ReviewStatus s) => s switch
    {
        ReviewStatus.PendingReview  => "bg-zinc-400",
        ReviewStatus.UnderReview    => "bg-blue-500",
        ReviewStatus.Approved       => "bg-emerald-500",
        ReviewStatus.NeedsRevision  => "bg-amber-500",
        _                           => ""
    };
}
