@* ============================================================
   Block: todo-list-design-review
   Title: TodoListDesignReview
   Description: A design review checklist block for React and Next.js with categorized visual, UX, and technical checks, reviewer notes, and completion tracking built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-design-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="eye" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Design Review</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs tabular-nums">@Progress%</span>
                <BadgeCn Variant="BadgeVariant.Secondary"
                         Class="@($"font-normal text-xs{(Progress == 100 ? " bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "")}")">
                    @CompletedCount/@TotalItems
                </BadgeCn>
            </div>
        </div>

        @* Sections *@
        <div>
            @for (int si = 0; si < _sections.Length; si++)
            {
                var sec = _sections[si];
                bool isLastSection = si == _sections.Length - 1;
                bool isExpanded = _expandedSections.Contains(sec.Id);
                int sectionCompleted = sec.Items.Count(i => _checked.Contains(i.Id));
                var sectionId = sec.Id;

                <div class="@(isLastSection ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => ToggleSection(sectionId))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right" Size="16"
                                      Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                        <span class="font-medium text-sm">@sec.Title</span>
                        <span class="ml-auto text-muted-foreground text-xs tabular-nums">
                            @sectionCompleted/@sec.Items.Length
                        </span>
                    </button>

                    @if (isExpanded)
                    {
                        for (int ii = 0; ii < sec.Items.Length; ii++)
                        {
                            var item = sec.Items[ii];
                            bool isChecked = _checked.Contains(item.Id);
                            var itemId = item.Id;

                            <div class="border-t">
                                <span class="flex w-full cursor-pointer items-start gap-3 px-4 py-2.5 pl-11 transition-colors hover:bg-muted/50"
                                      role="button"
                                      tabindex="0"
                                      @onclick="@(() => Toggle(itemId))">
                                    <div @onclick:stopPropagation class="mt-0.5">
                                        <CheckboxCn Value="@isChecked" ValueChanged="@((bool v) => Toggle(itemId))" />
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <span class="@($"font-medium text-sm transition-all duration-200{(isChecked ? " text-muted-foreground line-through" : "")}")">
                                            @item.Title
                                        </span>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                                    </div>
                                </span>
                            </div>
                        }
                    }
                </div>
            }
        </div>

        @* Notes toggle + area *@
        <div class="border-t">
            <button type="button"
                    @onclick="@(() => _showNotes = !_showNotes)"
                    class="flex w-full items-center gap-2 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <LucideIconCn Name="pen-line" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Reviewer notes</span>
                <LucideIconCn Name="chevron-right" Size="16"
                              Class="@($"ml-auto size-4 text-muted-foreground/60 transition-transform duration-200{(_showNotes ? " rotate-90" : "")}")" />
            </button>
            @if (_showNotes)
            {
                <div class="px-4 pb-3">
                    <TextareaCn @bind-Value="_notes"
                                Placeholder="Add notes about the design review..."
                                Class="min-h-[80px] resize-none border-0 bg-muted/50 text-sm shadow-none focus-visible:ring-0" />
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">Reviewer: Alex Kim</span>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Disabled="@(Progress < 100)" Class="h-7 text-xs">
                Approve Design
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ReviewItem(string Id, string Title, string Description);
    private record ReviewSection(string Id, string Title, ReviewItem[] Items);

    private static readonly ReviewSection[] _sections =
    [
        new("visual", "Visual",
        [
            new("v1", "Spacing consistent", "Padding and margins follow the 4px grid"),
            new("v2", "Typography hierarchy correct", "Heading sizes and weights follow the type scale"),
            new("v3", "Color contrast passes WCAG", "All text meets 4.5:1 contrast minimum"),
            new("v4", "Dark mode renders correctly", "All elements visible in both themes"),
        ]),
        new("ux", "UX",
        [
            new("u1", "Responsive breakpoints work", "Layout adapts at sm, md, lg, xl"),
            new("u2", "Animations smooth", "No jank, appropriate durations under 400ms"),
            new("u3", "Loading states designed", "Skeleton or spinner for async content"),
        ]),
        new("technical", "Technical",
        [
            new("t1", "No hydration mismatches", "Server and client render match"),
            new("t2", "Images optimized", "Using next/image with proper sizing"),
            new("t3", "No layout shift", "CLS score under 0.1"),
        ]),
    ];

    private HashSet<string> _checked = ["v1", "v2"];
    private HashSet<string> _expandedSections = ["visual", "ux", "technical"];
    private string _notes = "";
    private bool _showNotes = false;

    private int TotalItems => _sections.Sum(s => s.Items.Length);
    private int CompletedCount => _checked.Count;
    private int Progress => TotalItems == 0 ? 0 : (int)Math.Round((double)CompletedCount / TotalItems * 100);

    private void Toggle(string id)
    {
        if (_checked.Contains(id))
            _checked.Remove(id);
        else
            _checked.Add(id);
    }

    private void ToggleSection(string id)
    {
        if (_expandedSections.Contains(id))
            _expandedSections.Remove(id);
        else
            _expandedSections.Add(id);
    }
}
