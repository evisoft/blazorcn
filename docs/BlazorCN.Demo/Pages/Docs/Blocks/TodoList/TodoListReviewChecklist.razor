@* ============================================================
   Block: todo-list-review-checklist
   Title: TodoListReviewChecklist
   Description: React todo list code review checklist block for Next.js with section headers, checkable items, and overall review status using shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-review-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clipboard-list" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Code Review Checklist</span>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary"
                         Class="@($"text-[10px] {(IsReady ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-amber-500/10 text-amber-600 dark:text-amber-400")}")">
                    @(IsReady ? "Ready" : "Needs Work")
                </BadgeCn>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @CheckedCount/@TotalCount
                </span>
            </div>
        </div>

        @* Progress bar *@
        <div class="border-b px-4 py-2.5">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="@($"h-full rounded-full {(IsReady ? "bg-emerald-500" : "bg-amber-500")}")"
                     style="@(FormattableString.Invariant($"width:{(TotalCount > 0 ? (double)CheckedCount / TotalCount * 100 : 0):0.##}%"))">
                </div>
            </div>
        </div>

        @* Sections *@
        <div>
            @for (int si = 0; si < _sections.Count; si++)
            {
                var sec = _sections[si];
                int sectionChecked = sec.Items.Count(i => i.IsChecked);
                bool sectionComplete = sectionChecked == sec.Items.Count;
                bool isLastSection = si == _sections.Count - 1;

                <div class="@(isLastSection ? "" : "border-b")">
                    @* Section header *@
                    <div class="flex items-center justify-between px-4 py-2.5">
                        <div class="flex items-center gap-2">
                            @if (sectionComplete)
                            {
                                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="circle-dot" Size="14" Class="size-3.5 text-muted-foreground" />
                            }
                            <span class="font-medium text-muted-foreground text-xs">
                                @sec.Title
                            </span>
                        </div>
                        <span class="text-muted-foreground text-xs tabular-nums">
                            @sectionChecked/@sec.Items.Count
                        </span>
                    </div>

                    @* Items *@
                    @foreach (var it in sec.Items)
                    {
                        var item = it;
                        var secId = sec.Id;
                        <label for="@($"review-{item.Id}")"
                               class="flex cursor-pointer items-center gap-3 px-4 py-2 transition-colors hover:bg-muted/50">
                            <CheckboxCn Id="@($"review-{item.Id}")" Checked="@item.IsChecked" CheckedChanged="@((bool _) => ToggleItem(secId, item.Id))" aria-label="@item.Label" />
                            <span class="@($"text-sm {(item.IsChecked ? "text-muted-foreground line-through" : "")}")">
                                @item.Label
                            </span>
                        </label>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @(IsReady ? "All checks passed" : $"{Remaining} item{(Remaining == 1 ? "" : "s")} remaining")
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                      Class="@($"h-7 text-xs {(IsReady ? "text-emerald-600 dark:text-emerald-400" : "")}")"
                      Disabled="@(!IsReady)">
                @(IsReady ? "Submit Review" : "Complete all items")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private class CheckItemData
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public bool IsChecked { get; set; }
    }

    private class SectionData
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public List<CheckItemData> Items { get; set; } = new();
    }

    private List<SectionData> _sections = new()
    {
        new SectionData { Id = "s1", Title = "Code Quality", Items = new()
        {
            new CheckItemData { Id = "c1", Label = "No console.log statements left in code", IsChecked = true },
            new CheckItemData { Id = "c2", Label = "All functions have proper TypeScript types", IsChecked = true },
            new CheckItemData { Id = "c3", Label = "No hardcoded magic numbers or strings", IsChecked = false },
            new CheckItemData { Id = "c4", Label = "Error handling is implemented for async operations", IsChecked = true },
            new CheckItemData { Id = "c5", Label = "No unused imports or variables", IsChecked = true },
        }},
        new SectionData { Id = "s2", Title = "Testing", Items = new()
        {
            new CheckItemData { Id = "c6", Label = "All existing tests pass", IsChecked = true },
            new CheckItemData { Id = "c7", Label = "New unit tests added for changed functions", IsChecked = false },
            new CheckItemData { Id = "c8", Label = "Edge cases are covered in tests", IsChecked = false },
            new CheckItemData { Id = "c9", Label = "Integration tests updated if API changed", IsChecked = true },
        }},
        new SectionData { Id = "s3", Title = "Documentation", Items = new()
        {
            new CheckItemData { Id = "c10", Label = "README updated if public API changed", IsChecked = true },
            new CheckItemData { Id = "c11", Label = "JSDoc comments added for new exports", IsChecked = false },
            new CheckItemData { Id = "c12", Label = "Changelog entry added", IsChecked = true },
        }},
        new SectionData { Id = "s4", Title = "Security", Items = new()
        {
            new CheckItemData { Id = "c13", Label = "No secrets or credentials in code", IsChecked = true },
            new CheckItemData { Id = "c14", Label = "User input is validated and sanitized", IsChecked = true },
            new CheckItemData { Id = "c15", Label = "SQL queries use parameterized statements", IsChecked = true },
        }},
    };

    private int CheckedCount => _sections.SelectMany(s => s.Items).Count(i => i.IsChecked);
    private int TotalCount => _sections.SelectMany(s => s.Items).Count();
    private bool IsReady => CheckedCount == TotalCount;
    private int Remaining => TotalCount - CheckedCount;

    private void ToggleItem(string sectionId, string itemId)
    {
        var sec = _sections.FirstOrDefault(s => s.Id == sectionId);
        if (sec == null) return;
        var item = sec.Items.FirstOrDefault(i => i.Id == itemId);
        if (item == null) return;
        item.IsChecked = !item.IsChecked;
    }
}
