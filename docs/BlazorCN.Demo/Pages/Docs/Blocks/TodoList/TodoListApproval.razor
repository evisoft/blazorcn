@* ============================================================
   Block: todo-list-approval
   Title: TodoListApproval
   Description: React todo list approval workflow block for Next.js with draft, pending, approved, and rejected states, reviewer avatars, and action buttons using shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-approval.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clipboard-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Approval Queue</span>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_pendingCount pending
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_approvedCount
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_rejectedCount
                </span>
            </div>
        </div>

        @* Tasks *@
        <div>
            @for (int i = 0; i < _tasks.Count; i++)
            {
                var task = _tasks[i];
                var isLast = i == _tasks.Count - 1;
                var cfg = GetStatusConfig(task.Status);
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-start gap-3">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@task.Title</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"shrink-0 text-[10px] {cfg.ClassName}")">@cfg.Label</BadgeCn>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs">@task.Description</p>

                                <div class="mt-2 flex items-center gap-2 text-muted-foreground text-xs">
                                    <span>by @task.SubmittedBy</span>
                                    <span>·</span>
                                    <span>@task.SubmittedAt</span>
                                    @if (task.Reviewer != null)
                                    {
                                        <span>·</span>
                                        <span class="flex items-center gap-1">
                                            <AvatarCn Class="size-4">
                                                <AvatarFallbackCn Class="text-[8px]">@task.Reviewer.Initials</AvatarFallbackCn>
                                            </AvatarCn>
                                            @task.Reviewer.Name
                                        </span>
                                    }
                                    @if (task.ResolvedAt != null)
                                    {
                                        <span>·</span>
                                        <span>@task.ResolvedAt</span>
                                    }
                                </div>
                            </div>

                            @* Action buttons for pending items *@
                            @if (task.Status == ApprovalStatus.PendingReview)
                            {
                                var taskId = task.Id;
                                <div class="flex shrink-0 items-center gap-1.5">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs text-emerald-600 hover:bg-emerald-500/10 hover:text-emerald-600 dark:text-emerald-400 dark:hover:text-emerald-400" @onclick="@(() => UpdateStatus(taskId, ApprovalStatus.Approved))">
                                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                                        Approve
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs text-red-600 hover:bg-red-500/10 hover:text-red-600 dark:text-red-400 dark:hover:text-red-400" @onclick="@(() => UpdateStatus(taskId, ApprovalStatus.Rejected))">
                                        <LucideIconCn Name="x-circle" Size="12" Class="size-3" />
                                        Reject
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum ApprovalStatus { Draft, PendingReview, Approved, Rejected }

    private record ReviewerInfo(string Name, string Initials);

    private class TaskItem
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public ApprovalStatus Status { get; set; }
        public string SubmittedBy { get; set; } = "";
        public ReviewerInfo? Reviewer { get; set; }
        public string SubmittedAt { get; set; } = "";
        public string? ResolvedAt { get; set; }
    }

    private readonly List<TaskItem> _tasks =
    [
        new() { Id = "t1", Title = "Update privacy policy for GDPR compliance", Description = "Legal review required before publishing to production", Status = ApprovalStatus.Approved, SubmittedBy = "Alex Chen", Reviewer = new("Jordan Lee", "JL"), SubmittedAt = "2 days ago", ResolvedAt = "1 day ago" },
        new() { Id = "t2", Title = "Deploy v2.4 release to production", Description = "Contains breaking API changes, needs lead approval", Status = ApprovalStatus.PendingReview, SubmittedBy = "Sam Rivera", Reviewer = new("Taylor Kim", "TK"), SubmittedAt = "3 hours ago", ResolvedAt = null },
        new() { Id = "t3", Title = "Add Stripe webhook for subscription changes", Description = "New payment integration for team billing", Status = ApprovalStatus.PendingReview, SubmittedBy = "Morgan Wu", Reviewer = new("Alex Chen", "AC"), SubmittedAt = "1 hour ago", ResolvedAt = null },
        new() { Id = "t4", Title = "Refactor user permissions model", Description = "Simplify role-based access control logic", Status = ApprovalStatus.Rejected, SubmittedBy = "Taylor Kim", Reviewer = new("Sam Rivera", "SR"), SubmittedAt = "3 days ago", ResolvedAt = "2 days ago" },
        new() { Id = "t5", Title = "Create A/B test for signup flow", Description = "Test new onboarding copy against current version", Status = ApprovalStatus.Draft, SubmittedBy = "Jordan Lee", Reviewer = null, SubmittedAt = "5 hours ago", ResolvedAt = null },
        new() { Id = "t6", Title = "Migrate database to new cluster", Description = "Schedule downtime window for data migration", Status = ApprovalStatus.PendingReview, SubmittedBy = "Alex Chen", Reviewer = new("Morgan Wu", "MW"), SubmittedAt = "45 min ago", ResolvedAt = null },
    ];

    private int _pendingCount => _tasks.Count(t => t.Status == ApprovalStatus.PendingReview);
    private int _approvedCount => _tasks.Count(t => t.Status == ApprovalStatus.Approved);
    private int _rejectedCount => _tasks.Count(t => t.Status == ApprovalStatus.Rejected);

    private (string Label, string ClassName) GetStatusConfig(ApprovalStatus status) => status switch
    {
        ApprovalStatus.Draft => ("Draft", "bg-secondary text-secondary-foreground"),
        ApprovalStatus.PendingReview => ("Pending Review", "bg-amber-500/10 text-amber-600 dark:text-amber-400"),
        ApprovalStatus.Approved => ("Approved", "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"),
        ApprovalStatus.Rejected => ("Rejected", "bg-red-500/10 text-red-600 dark:text-red-400"),
        _ => ("", "")
    };

    private void UpdateStatus(string taskId, ApprovalStatus status)
    {
        var task = _tasks.FirstOrDefault(t => t.Id == taskId);
        if (task != null)
        {
            task.Status = status;
            task.ResolvedAt = "Just now";
        }
    }
}
