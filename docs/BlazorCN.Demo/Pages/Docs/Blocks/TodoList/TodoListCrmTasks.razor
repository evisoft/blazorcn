@* ============================================================
   Block: todo-list-crm-tasks
   Title: TodoListCrmTasks
   Description: A CRM follow-up tasks todo list block for React and Next.js with deal stages, contact details, follow-up types, and deal values built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-crm-tasks.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">CRM Follow-ups</span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_openDeals.Count open
                </span>
            </div>
            <div class="flex items-center gap-2">
                @foreach (var stage in _stages)
                {
                    var count = _stageCounts.GetValueOrDefault(stage);
                    if (count > 0)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"font-normal text-xs {GetStageColor(stage)}")">
                            @stage @count
                        </BadgeCn>
                    }
                }
            </div>
        </div>

        @* Tasks *@
        <div>
            @for (int i = 0; i < _items.Count; i++)
            {
                var task = _items[i];
                var isLast = i == _items.Count - 1;
                var isExpanded = _expanded == task.Id;
                var taskId = task.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <CheckboxCn Checked="@task.Completed"
                                    CheckedChanged="@((bool _) => Toggle(taskId))"
                                    Class="mt-0.5" aria-label="@task.ContactName" />
                        <button type="button"
                                @onclick="@(() => SetExpanded(taskId))"
                                class="min-w-0 flex-1 text-left">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm transition-all duration-200", task.Completed ? "text-muted-foreground line-through" : "")">
                                    @task.ContactName
                                </span>
                                <span class="text-muted-foreground text-xs">@task.Company</span>
                            </div>
                            <div class="mt-1 flex items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"font-normal text-xs {GetStageColor(task.DealStage)}")">
                                    @task.DealStage
                                </BadgeCn>
                                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                    <LucideIconCn Name="@GetFollowUpIconName(task.FollowUpType)" Size="12" Class="size-3" />
                                    @task.FollowUpType
                                </span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs">Due @task.DueDate</span>
                            </div>
                        </button>
                        <div class="flex shrink-0 items-center gap-3 pt-0.5">
                            <span class="font-semibold text-sm tabular-nums">@task.DealValue</span>
                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </div>
                    </div>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-10">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Last contact</span>
                                    <span class="text-xs">@task.LastContact</span>
                                </div>
                                <div class="mt-2 flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Deal value</span>
                                    <span class="font-mono text-xs tabular-nums">@task.DealValue</span>
                                </div>
                                <div class="mt-2 flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Next action</span>
                                    <span class="text-xs">@task.FollowUpType — @task.DueDate</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @_items.Count(i => !i.Completed) follow-ups remaining
            </span>
            <span class="font-medium text-sm tabular-nums">@_openDeals.Count active deals</span>
        </div>
    </div>
</section>

@code {
    private record CrmTask(
        string Id,
        string ContactName,
        string Company,
        string DealStage,
        string FollowUpType,
        string DueDate,
        string DealValue,
        string LastContact,
        bool Completed);

    private static readonly string[] _stages = ["Lead", "Qualified", "Proposal", "Negotiation", "Closed"];

    private List<CrmTask> _items =
    [
        new("t1", "Sarah Chen",      "TechFlow Inc",  "Negotiation", "Meeting", "Apr 4", "$48,000", "2 days ago",  false),
        new("t2", "Marcus Johnson",  "DataVault",      "Proposal",    "Email",   "Apr 5", "$32,500", "1 week ago",  false),
        new("t3", "Elena Rodriguez", "CloudBase",      "Qualified",   "Call",    "Apr 6", "$24,000", "3 days ago",  false),
        new("t4", "James Park",      "Nexus Labs",     "Negotiation", "Meeting", "Apr 4", "$67,500", "Yesterday",   false),
        new("t5", "Priya Patel",     "ScaleUp Co",     "Lead",        "Email",   "Apr 7", "$12,500", "5 days ago",  false),
        new("t6", "David Kim",       "QuantumCore",    "Closed",      "Email",   "Apr 3", "$55,000", "Today",       true),
        new("t7", "Lisa Zhang",      "BrightPath",     "Proposal",    "Call",    "Apr 8", "$19,800", "4 days ago",  false),
        new("t8", "Alex Thompson",   "Streamline AI",  "Qualified",   "Meeting", "Apr 5", "$41,200", "3 days ago",  false),
    ];

    private string? _expanded = null;

    private List<CrmTask> _openDeals => _items.Where(i => i.DealStage != "Closed").ToList();

    private Dictionary<string, int> _stageCounts
    {
        get
        {
            var counts = new Dictionary<string, int>();
            foreach (var item in _items)
                counts[item.DealStage] = counts.GetValueOrDefault(item.DealStage) + 1;
            return counts;
        }
    }

    private void Toggle(string id)
    {
        var idx = _items.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _items[idx] = _items[idx] with { Completed = !_items[idx].Completed };
    }

    private void SetExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetStageColor(string dealStage) => dealStage switch
    {
        "Lead"        => "bg-zinc-500/10 text-zinc-700 dark:text-zinc-400",
        "Qualified"   => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "Proposal"    => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "Negotiation" => "bg-purple-500/10 text-purple-700 dark:text-purple-400",
        "Closed"      => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        _             => ""
    };

    private static string GetFollowUpIconName(string followUpType) => followUpType switch
    {
        "Call"    => "phone",
        "Email"   => "mail",
        "Meeting" => "video",
        _         => "circle"
    };
}
