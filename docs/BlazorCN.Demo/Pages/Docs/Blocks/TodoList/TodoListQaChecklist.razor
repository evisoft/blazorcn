@* ============================================================
   Block: todo-list-qa-checklist
   Title: TodoListQaChecklist
   Description: A QA testing checklist block for React and Next.js with pass/fail/skip test results, category grouping, severity badges, and pass rate summary built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-qa-checklist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clipboard-list" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">QA Testing Checklist</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="download" Size="12" Class="size-3" />
                Export Report
            </ButtonCn>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="@($"font-semibold text-2xl tabular-nums {(EvaluatedCount > 0 ? RateColor : "text-muted-foreground")}")">
                    @(EvaluatedCount > 0 ? PassRate.ToString() : "--")
                </span>
                <span class="text-muted-foreground text-xs">% pass rate</span>
            </div>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @PassedCount
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @FailedCount
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-zinc-400"></span>
                    @SkippedCount
                </span>
            </div>
        </div>

        @* Categories *@
        <div>
            @for (int ci = 0; ci < _testCategories.Length; ci++)
            {
                var cat = _testCategories[ci];
                bool isLastCategory = ci == _testCategories.Length - 1;

                <div>
                    <div class="border-b bg-muted/30 px-4 py-2">
                        <span class="font-medium text-muted-foreground text-xs uppercase tracking-wide">
                            @cat.Title
                        </span>
                    </div>
                    @for (int ii = 0; ii < cat.Items.Length; ii++)
                    {
                        var item = cat.Items[ii];
                        bool isLastInCat = ii == cat.Items.Length - 1;
                        bool showBorder = !(isLastInCat && isLastCategory);
                        string? result = _results.TryGetValue(item.Id, out var rv) ? rv : null;
                        var itemId = item.Id;
                        string dotClass = SeverityDot.TryGetValue(item.Severity, out var sc) ? sc : "bg-zinc-400";

                        <div class="@($"flex items-center gap-3 px-4 py-2.5 {(showBorder ? "border-b" : "")}")">
                            <span class="@($"size-1.5 shrink-0 rounded-full {dotClass}")"></span>
                            <span class="min-w-0 flex-1 text-sm">@item.Title</span>
                            <div class="flex items-center gap-1">
                                <ButtonCn Variant="@(result == "pass" ? ButtonVariant.Default : ButtonVariant.Ghost)"
                                          Size="ButtonSize.Sm"
                                          Class="@($"h-6 w-6 p-0 {(result == "pass" ? "bg-emerald-600 text-white hover:bg-emerald-700" : "")}")"
                                          OnClick="@((MouseEventArgs _) => SetResult(itemId, result == "pass" ? null : "pass"))">
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                </ButtonCn>
                                <ButtonCn Variant="@(result == "fail" ? ButtonVariant.Default : ButtonVariant.Ghost)"
                                          Size="ButtonSize.Sm"
                                          Class="@($"h-6 w-6 p-0 {(result == "fail" ? "bg-red-600 text-white hover:bg-red-700" : "")}")"
                                          OnClick="@((MouseEventArgs _) => SetResult(itemId, result == "fail" ? null : "fail"))">
                                    <LucideIconCn Name="x" Size="12" Class="size-3" />
                                </ButtonCn>
                                <ButtonCn Variant="@(result == "skip" ? ButtonVariant.Default : ButtonVariant.Ghost)"
                                          Size="ButtonSize.Sm"
                                          Class="@($"h-6 w-6 p-0 {(result == "skip" ? "bg-zinc-600 text-white hover:bg-zinc-700" : "")}")"
                                          OnClick="@((MouseEventArgs _) => SetResult(itemId, result == "skip" ? null : "skip"))">
                                    <LucideIconCn Name="minus" Size="12" Class="size-3" />
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record QaTestItem(string Id, string Title, string Severity);
    private record QaTestCategory(string Id, string Title, QaTestItem[] Items);

    private static readonly Dictionary<string, string> SeverityDot = new()
    {
        ["critical"] = "bg-red-500",
        ["high"] = "bg-amber-500",
        ["medium"] = "bg-blue-500",
        ["low"] = "bg-zinc-400",
    };

    private static readonly QaTestCategory[] _testCategories =
    [
        new("functional", "Functional",
        [
            new("f1", "User login with valid credentials", "critical"),
            new("f2", "Form validation on required fields", "high"),
            new("f3", "Data persistence after page refresh", "high"),
            new("f4", "Error handling on network failure", "medium"),
        ]),
        new("visual", "Visual",
        [
            new("v1", "Layout renders correctly at 1280px", "high"),
            new("v2", "Mobile responsive at 375px", "high"),
            new("v3", "Dark mode color consistency", "medium"),
        ]),
        new("performance", "Performance",
        [
            new("p1", "Largest Contentful Paint under 2.5s", "critical"),
            new("p2", "No memory leaks on navigation", "high"),
            new("p3", "Bundle size under budget (250KB)", "medium"),
        ]),
        new("accessibility", "Accessibility",
        [
            new("a1", "All images have alt text", "critical"),
            new("a2", "Keyboard navigation works", "high"),
            new("a3", "Color contrast meets WCAG AA", "high"),
            new("a4", "Screen reader announces form errors", "medium"),
        ]),
    ];

    private Dictionary<string, string?> _results = new();

    private int EvaluatedCount => _testCategories.SelectMany(c => c.Items)
        .Count(i => _results.TryGetValue(i.Id, out var r) && (r == "pass" || r == "fail"));

    private int PassedCount => _testCategories.SelectMany(c => c.Items)
        .Count(i => _results.TryGetValue(i.Id, out var r) && r == "pass");

    private int FailedCount => _testCategories.SelectMany(c => c.Items)
        .Count(i => _results.TryGetValue(i.Id, out var r) && r == "fail");

    private int SkippedCount => _testCategories.SelectMany(c => c.Items)
        .Count(i => _results.TryGetValue(i.Id, out var r) && r == "skip");

    private int PassRate => EvaluatedCount > 0
        ? (int)Math.Round((double)PassedCount / EvaluatedCount * 100)
        : 0;

    private string RateColor => PassRate >= 90
        ? "text-emerald-600 dark:text-emerald-400"
        : PassRate >= 60
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";

    private void SetResult(string id, string? result)
    {
        _results[id] = result;
    }
}
