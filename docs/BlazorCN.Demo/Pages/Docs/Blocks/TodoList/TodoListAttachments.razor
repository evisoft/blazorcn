@* ============================================================
   Block: todo-list-attachments
   Title: TodoListAttachments
   Description: A todo list block with file attachment indicators for React and Next.js featuring expandable file lists, file type icons, and size badges built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-attachments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="paperclip" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Tasks with Attachments</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">@TotalAttachments files</span>
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < _todos.Count; i++)
            {
                var todo = _todos[i];
                var isLast = i == _todos.Count - 1;
                var isExpanded = _expanded == todo.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex w-full items-start gap-3 px-4 py-3">
                        <span class="mt-0.5 shrink-0">
                            <input type="checkbox"
                                   checked="@todo.Completed"
                                   @onchange="@((ChangeEventArgs _) => ToggleTodo(todo.Id))"
                                   class="size-4 cursor-pointer" aria-label="@todo.Text" />
                        </span>
                        <button type="button"
                                @onclick="@(() => SetExpanded(todo.Id, isExpanded))"
                                class="flex min-w-0 flex-1 items-center gap-2 text-left">
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("text-sm transition-all duration-200", todo.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                                    @todo.Text
                                </span>
                            </div>
                            @if (todo.Attachments.Length > 0)
                            {
                                <div class="flex shrink-0 items-center gap-1 text-muted-foreground">
                                    <LucideIconCn Name="paperclip" Size="14" Class="size-3.5" />
                                    <span class="text-xs tabular-nums">@todo.Attachments.Length</span>
                                </div>
                            }
                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>
                    </div>

                    @if (isExpanded && todo.Attachments.Length > 0)
                    {
                        <div class="overflow-hidden">
                            <div class="space-y-1 px-4 pb-3 pl-10">
                                @foreach (var att in todo.Attachments)
                                {
                                    <div class="flex items-center gap-2 rounded-md bg-muted/30 px-3 py-2">
                                        <LucideIconCn Name="@GetFileIconName(att.Type)" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                        <span class="min-w-0 flex-1 truncate font-mono text-xs">@att.Name</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">@att.Size</BadgeCn>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (isExpanded && todo.Attachments.Length == 0)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pl-10">
                                <p class="text-muted-foreground/50 text-xs italic">No attachments</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <span class="text-muted-foreground text-xs tabular-nums">@_todos.Count tasks</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="text-muted-foreground text-xs tabular-nums">@TotalAttachments attachments</span>
        </div>

    </div>
</section>

@code {
    private enum AttachmentType { Pdf, Image, Doc, Other }

    private record AttachmentItem(string Name, string Size, AttachmentType Type);
    private record TodoItem(string Id, string Text, bool Completed, AttachmentItem[] Attachments);

    private string? _expanded = "1";

    private List<TodoItem> _todos =
    [
        new("1", "Finalize brand guidelines document", false,
        [
            new("brand-guidelines-v3.pdf", "4.2 MB", AttachmentType.Pdf),
            new("logo-variations.png", "1.8 MB", AttachmentType.Image),
            new("color-palette.pdf", "320 KB", AttachmentType.Pdf),
        ]),
        new("2", "Review homepage redesign mockups", false,
        [
            new("homepage-desktop.png", "2.4 MB", AttachmentType.Image),
            new("homepage-mobile.png", "1.1 MB", AttachmentType.Image),
        ]),
        new("3", "Update API integration docs", true,
        [
            new("api-spec-v2.pdf", "890 KB", AttachmentType.Pdf),
        ]),
        new("4", "Prepare quarterly metrics report", false,
        [
            new("q1-metrics.pdf", "1.5 MB", AttachmentType.Pdf),
            new("revenue-chart.png", "420 KB", AttachmentType.Image),
            new("user-growth-data.csv", "56 KB", AttachmentType.Other),
            new("executive-summary.pdf", "2.1 MB", AttachmentType.Pdf),
        ]),
        new("5", "Set up staging environment", false, []),
        new("6", "Write onboarding email sequence", false,
        [
            new("email-templates.doc", "780 KB", AttachmentType.Doc),
        ]),
    ];

    private int TotalAttachments => _todos.Sum(t => t.Attachments.Length);

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _todos[idx] = _todos[idx] with { Completed = !_todos[idx].Completed };
    }

    private void SetExpanded(string id, bool currentlyExpanded)
    {
        _expanded = currentlyExpanded ? null : id;
    }

    private static string GetFileIconName(AttachmentType type) => type switch
    {
        AttachmentType.Pdf   => "file-text",
        AttachmentType.Image => "image",
        AttachmentType.Doc   => "file-text",
        _                    => "file",
    };
}
