@* ============================================================
   Block: todo-list-roadmap
   Title: TodoListRoadmap
   Description: React todo list roadmap block for Next.js with now, next, and later status lanes, priority indicators, and effort badges using shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-roadmap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="map" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Product Roadmap</span>
            </div>
            <span class="text-muted-foreground text-xs">@_items.Count items</span>
        </div>

        @* Lanes *@
        <div class="grid grid-cols-1 md:grid-cols-3">
            @for (int li = 0; li < _laneOrder.Length; li++)
            {
                var lane = _laneOrder[li];
                var laneIndex = li;
                var laneItems = _items.Where(i => i.Lane == lane).ToList();
                <div class="@(laneIndex < _laneOrder.Length - 1 ? "border-b md:border-r md:border-b-0" : "")">
                    @* Lane header *@
                    <div class="flex items-center gap-2 border-b px-4 py-2.5">
                        <span class="size-1.5 rounded-full @LaneDotClass(lane)"></span>
                        <span class="font-medium text-xs @LaneHeaderClass(lane)">
                            @LaneTitle(lane)
                        </span>
                        <span class="text-muted-foreground text-xs">(@laneItems.Count)</span>
                    </div>

                    @* Items *@
                    <div class="min-h-[200px]">
                        @foreach (var itm in laneItems)
                        {
                            var item = itm;
                            <div class="border-b px-4 py-3 last:border-b-0">
                                <div class="flex items-start gap-2">
                                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full @PriorityDotClass(item.Priority)"></span>
                                    <div class="min-w-0 flex-1">
                                        <span class="font-medium text-sm">@item.Title</span>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                                        <div class="mt-2 flex items-center gap-1.5">
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px]", EffortClass(item.Effort))">
                                                @EffortLabel(item.Effort)
                                            </BadgeCn>
                                            <span class="text-muted-foreground text-[10px]">
                                                @PriorityLabel(item.Priority)
                                            </span>
                                        </div>
                                    </div>
                                    <div class="flex shrink-0 items-center gap-0.5">
                                        @if (lane != RoadmapLane.Now)
                                        {
                                            <ButtonCn aria-label="@($"Move {item.Title} to earlier lane")" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0" @onclick="@(() => MoveItem(item.Id, true))">
                                                <LucideIconCn Name="arrow-left" Size="12" Class="size-3 text-muted-foreground" />
                                            </ButtonCn>
                                        }
                                        @if (lane != RoadmapLane.Later)
                                        {
                                            <ButtonCn aria-label="@($"Move {item.Title} to later lane")" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0" @onclick="@(() => MoveItem(item.Id, false))">
                                                <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground" />
                                            </ButtonCn>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        @if (laneItems.Count == 0)
                        {
                            <div class="flex items-center justify-center py-8 text-muted-foreground text-xs">
                                No items
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum RoadmapLane { Now, Next, Later }
    private enum RoadmapPriority { Urgent, High, Medium, Low }
    private enum RoadmapEffort { S, M, L, XL }

    private record RoadmapItem(string Id, string Title, string Description, RoadmapLane Lane, RoadmapPriority Priority, RoadmapEffort Effort);

    private static readonly RoadmapLane[] _laneOrder = [RoadmapLane.Now, RoadmapLane.Next, RoadmapLane.Later];

    private List<RoadmapItem> _items =
    [
        new("r1",  "Real-time collaboration",       "Multi-user editing with presence indicators",          RoadmapLane.Now,   RoadmapPriority.Urgent, RoadmapEffort.XL),
        new("r2",  "API rate limiting",              "Implement per-user rate limits with Redis",            RoadmapLane.Now,   RoadmapPriority.High,   RoadmapEffort.M),
        new("r3",  "Dark mode support",              "System-preference-aware theme switching",              RoadmapLane.Now,   RoadmapPriority.Medium, RoadmapEffort.S),
        new("r4",  "Webhook integrations",           "Send events to external services on task changes",     RoadmapLane.Next,  RoadmapPriority.High,   RoadmapEffort.L),
        new("r5",  "Mobile responsive redesign",     "Optimize all views for mobile and tablet",            RoadmapLane.Next,  RoadmapPriority.Medium, RoadmapEffort.L),
        new("r6",  "CSV export and import",          "Bulk data operations for task management",             RoadmapLane.Next,  RoadmapPriority.Low,    RoadmapEffort.M),
        new("r7",  "AI task suggestions",            "Auto-suggest next actions based on project context",   RoadmapLane.Later, RoadmapPriority.Medium, RoadmapEffort.XL),
        new("r8",  "Gantt chart view",               "Timeline visualization for project planning",          RoadmapLane.Later, RoadmapPriority.Low,    RoadmapEffort.XL),
        new("r9",  "Custom field types",             "User-defined fields for task metadata",                RoadmapLane.Later, RoadmapPriority.High,   RoadmapEffort.L),
        new("r10", "Audit log dashboard",            "Searchable activity log for compliance",               RoadmapLane.Later, RoadmapPriority.Low,    RoadmapEffort.M),
    ];

    private void MoveItem(string itemId, bool forward)
    {
        var idx = _items.FindIndex(i => i.Id == itemId);
        if (idx < 0) return;
        var item = _items[idx];
        var laneIdx = Array.IndexOf(_laneOrder, item.Lane);
        var newLaneIdx = forward ? laneIdx - 1 : laneIdx + 1;
        if (newLaneIdx < 0 || newLaneIdx >= _laneOrder.Length) return;
        _items[idx] = item with { Lane = _laneOrder[newLaneIdx] };
    }

    private static string LaneTitle(RoadmapLane lane) => lane switch
    {
        RoadmapLane.Now   => "Now",
        RoadmapLane.Next  => "Next",
        RoadmapLane.Later => "Later",
        _                 => "",
    };

    private static string LaneDotClass(RoadmapLane lane) => lane switch
    {
        RoadmapLane.Now   => "bg-emerald-500",
        RoadmapLane.Next  => "bg-blue-500",
        RoadmapLane.Later => "bg-zinc-400 dark:bg-zinc-500",
        _                 => "",
    };

    private static string LaneHeaderClass(RoadmapLane lane) => lane switch
    {
        RoadmapLane.Now   => "text-emerald-600 dark:text-emerald-400",
        RoadmapLane.Next  => "text-blue-600 dark:text-blue-400",
        RoadmapLane.Later => "text-muted-foreground",
        _                 => "",
    };

    private static string PriorityDotClass(RoadmapPriority priority) => priority switch
    {
        RoadmapPriority.Urgent => "bg-red-500",
        RoadmapPriority.High   => "bg-amber-500",
        RoadmapPriority.Medium => "bg-blue-500",
        RoadmapPriority.Low    => "bg-zinc-400 dark:bg-zinc-500",
        _                      => "",
    };

    private static string EffortClass(RoadmapEffort effort) => effort switch
    {
        RoadmapEffort.S  => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        RoadmapEffort.M  => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        RoadmapEffort.L  => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        RoadmapEffort.XL => "bg-red-500/10 text-red-600 dark:text-red-400",
        _                => "",
    };

    private static string EffortLabel(RoadmapEffort effort) => effort switch
    {
        RoadmapEffort.S  => "S",
        RoadmapEffort.M  => "M",
        RoadmapEffort.L  => "L",
        RoadmapEffort.XL => "XL",
        _                => "",
    };

    private static string PriorityLabel(RoadmapPriority priority) => priority switch
    {
        RoadmapPriority.Urgent => "urgent",
        RoadmapPriority.High   => "high",
        RoadmapPriority.Medium => "medium",
        RoadmapPriority.Low    => "low",
        _                      => "",
    };
}
