@* ============================================================
   Block: todo-list-calendar-view
   Title: TodoListCalendarView
   Description: A calendar-organized todo list block for React and Next.js with date-grouped tasks, due date indicators, and overdue highlighting built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-calendar-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Schedule</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs tabular-nums">@TotalCount tasks</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs tabular-nums">@TodayCount today</span>
                @if (OverdueCount > 0)
                {
                    <span class="text-muted-foreground text-xs">·</span>
                    <span class="flex items-center gap-1.5 text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        <span class="text-red-600 dark:text-red-400 tabular-nums">@OverdueCount overdue</span>
                    </span>
                }
            </div>
        </div>

        @* Date groups *@
        <div>
            @for (int gi = 0; gi < _groups.Count; gi++)
            {
                var grp = _groups[gi];
                var isLastGrp = gi == _groups.Count - 1;
                var grpDone = grp.Tasks.Count(t => t.Completed);
                <div>
                    @* Date group header *@
                    <div class="@Cn.Merge("flex items-center justify-between bg-muted/30 px-4 py-2", gi > 0 ? "border-t" : "")">
                        <span class="@Cn.Merge("font-medium text-xs", grp.IsOverdue ? "text-red-600 dark:text-red-400" : "text-muted-foreground")">
                            @grp.Label
                        </span>
                        <span class="@Cn.Merge("text-xs tabular-nums", grp.IsOverdue ? "text-red-600 dark:text-red-400" : "text-muted-foreground")">
                            @($"{grpDone}/{grp.Tasks.Count}")
                        </span>
                    </div>
                    @* Tasks within group *@
                    @for (int ti = 0; ti < grp.Tasks.Count; ti++)
                    {
                        var todo = grp.Tasks[ti];
                        var isLastTask = ti == grp.Tasks.Count - 1;
                        var capturedId = todo.Id;
                        var capturedIsOverdue = grp.IsOverdue;
                        <div class="@(!(isLastTask && isLastGrp) ? "border-b" : "")">
                            <label for="@($"cal-todo-{todo.Id}")" class="flex w-full cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                                <CheckboxCn Id="@($"cal-todo-{todo.Id}")" Checked="@todo.Completed" CheckedChanged="@((bool v) => ToggleTodo(capturedId))" />
                                <span class="@Cn.Merge("min-w-0 flex-1 text-sm transition-all duration-200", todo.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                                    @todo.Text
                                </span>
                                <span class="@Cn.Merge("shrink-0 text-xs tabular-nums", capturedIsOverdue && !todo.Completed ? "text-red-600 dark:text-red-400" : "text-muted-foreground")">
                                    @todo.DueDate
                                </span>
                            </label>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @CompletedCount of @TotalCount completed
            </span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @(TotalCount - CompletedCount) remaining
            </BadgeCn>
        </div>
    </div>
</section>

@code {
    private sealed class CalTodo
    {
        public string Id { get; init; } = "";
        public string Text { get; init; } = "";
        public bool Completed { get; set; }
        public string DueDate { get; init; } = "";
        public string DateGroup { get; init; } = "";
    }

    private sealed class CalGroup
    {
        public string Label { get; init; } = "";
        public bool IsOverdue { get; init; }
        public List<CalTodo> Tasks { get; init; } = [];
    }

    private readonly List<CalGroup> _groups =
    [
        new() { Label = "Overdue", IsOverdue = true, Tasks =
        [
            new() { Id = "1", Text = "Submit expense report", Completed = false, DueDate = "Apr 1", DateGroup = "Overdue" },
        ]},
        new() { Label = "Today — Apr 3", Tasks =
        [
            new() { Id = "2", Text = "Complete project documentation", Completed = false, DueDate = "Apr 3", DateGroup = "Today" },
            new() { Id = "3", Text = "Attend performance review", Completed = true, DueDate = "Apr 3", DateGroup = "Today" },
            new() { Id = "4", Text = "Purchase blocks from shadcnblocks.com", Completed = false, DueDate = "Apr 3", DateGroup = "Today" },
        ]},
        new() { Label = "Tomorrow — Apr 4", Tasks =
        [
            new() { Id = "5", Text = "Review pull request #42", Completed = false, DueDate = "Apr 4", DateGroup = "Tomorrow" },
            new() { Id = "6", Text = "Update project roadmap", Completed = false, DueDate = "Apr 4", DateGroup = "Tomorrow" },
        ]},
        new() { Label = "This Week", Tasks =
        [
            new() { Id = "7", Text = "Write weekly report", Completed = false, DueDate = "Apr 5", DateGroup = "This Week" },
            new() { Id = "8", Text = "Deploy staging environment", Completed = false, DueDate = "Apr 7", DateGroup = "This Week" },
        ]},
    ];

    private int TotalCount => _groups.Sum(g => g.Tasks.Count);
    private int TodayCount => _groups.FirstOrDefault(g => g.Label.StartsWith("Today"))?.Tasks.Count ?? 0;
    private int OverdueCount => _groups.FirstOrDefault(g => g.IsOverdue)?.Tasks.Count ?? 0;
    private int CompletedCount => _groups.Sum(g => g.Tasks.Count(t => t.Completed));

    private void ToggleTodo(string id)
    {
        foreach (var grp in _groups)
            foreach (var t in grp.Tasks)
                if (t.Id == id) { t.Completed = !t.Completed; return; }
    }
}
