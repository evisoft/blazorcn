@* ============================================================
   Block: todo-list-order-fulfillment
   Title: TodoListOrderFulfillment
   Description: An order processing checklist todo list block for React and Next.js with order IDs, mini status steppers, tracking numbers, and fulfillment actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-order-fulfillment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="truck" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Order Fulfillment</span>
                <span class="text-muted-foreground text-xs tabular-nums">@_items.Count orders</span>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                @foreach (var step in _stepOrder)
                {
                    var cnt = _stepCounts.GetValueOrDefault(step, 0);
                    if (cnt > 0)
                    {
                        <span class="tabular-nums">@step @cnt</span>
                    }
                }
            </div>
        </div>

        @* Orders *@
        <div>
            @for (int i = 0; i < _items.Count; i++)
            {
                var order = _items[i];
                var orderId = order.Id;
                var isExpanded = _expanded == order.Id;
                var isLast = i == _items.Count - 1;
                var currentStepIndex = Array.IndexOf(_stepOrder, order.CurrentStep);
                var nextStep = currentStepIndex < _stepOrder.Length - 1 ? _stepOrder[currentStepIndex + 1] : null;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <CheckboxCn Checked="@order.Completed" Class="mt-0.5" @onclick="@(() => Toggle(orderId))" />
                        <button type="button" @onclick="@(() => _expanded = isExpanded ? null : orderId)" class="min-w-0 flex-1 text-left">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs">@order.OrderId</span>
                                <span class="@($"font-medium text-sm transition-all duration-200 {(order.Completed ? "text-muted-foreground line-through" : "")}")">@order.Customer</span>
                                <span class="text-muted-foreground text-xs tabular-nums">@order.Items items</span>
                            </div>
                            @* Mini stepper *@
                            <div class="mt-2 flex items-center gap-1">
                                @for (int si = 0; si < _stepOrder.Length; si++)
                                {
                                    var stepCls = si < currentStepIndex
                                        ? "bg-emerald-500"
                                        : (si == currentStepIndex
                                            ? "ring-2 ring-emerald-500 ring-offset-1 ring-offset-card bg-emerald-500"
                                            : "bg-muted-foreground/20");
                                    var lineCls = si < currentStepIndex ? "bg-emerald-500" : "bg-muted-foreground/20";
                                    <div class="flex items-center gap-1">
                                        <span class="@($"size-2 rounded-full transition-colors {stepCls}")"></span>
                                        @if (si < _stepOrder.Length - 1)
                                        {
                                            <span class="@($"h-px w-4 {lineCls}")"></span>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="mt-1 flex items-center gap-2">
                                <span class="text-muted-foreground text-xs">@order.CurrentStep</span>
                                @if (order.Tracking != null)
                                {
                                    <span class="text-muted-foreground text-xs">·</span>
                                    <span class="font-mono text-muted-foreground text-xs">@order.Tracking</span>
                                }
                            </div>
                        </button>
                        <div class="flex shrink-0 items-center gap-2 pt-0.5">
                            <span class="font-semibold text-sm tabular-nums">@order.Total</span>
                            <LucideIconCn Name="chevron-right" Size="16" Class="@($"size-4 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" />
                        </div>
                    </div>
                    @if (isExpanded && nextStep != null)
                    {
                        <div class="flex gap-2 px-4 pb-3 pl-10">
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" @onclick="@(() => AdvanceStep(orderId))">
                                <LucideIconCn Name="package" Size="12" Class="size-3" />
                                Mark as @nextStep
                            </ButtonCn>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">@(_items.Count(i => i.CurrentStep != "Delivered")) orders pending</span>
            <span class="text-muted-foreground text-xs tabular-nums">@(_items.Count(i => i.CurrentStep == "Delivered")) delivered</span>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _stepOrder = ["Received", "Processing", "Packed", "Shipped", "Delivered"];

    private class Order
    {
        public string Id { get; set; } = "";
        public string OrderId { get; set; } = "";
        public string Customer { get; set; } = "";
        public int Items { get; set; }
        public string Total { get; set; } = "";
        public string CurrentStep { get; set; } = "";
        public string? Tracking { get; set; }
        public bool Completed { get; set; }
    }

    private readonly List<Order> _items =
    [
        new() { Id = "o1", OrderId = "ORD-4821", Customer = "Emma Wilson", Items = 3, Total = "$89.50", CurrentStep = "Processing", Tracking = null, Completed = false },
        new() { Id = "o2", OrderId = "ORD-4820", Customer = "Ryan Chen", Items = 1, Total = "$234.00", CurrentStep = "Packed", Tracking = null, Completed = false },
        new() { Id = "o3", OrderId = "ORD-4819", Customer = "Sofia Garcia", Items = 5, Total = "$156.75", CurrentStep = "Shipped", Tracking = "1Z999AA10123456784", Completed = false },
        new() { Id = "o4", OrderId = "ORD-4818", Customer = "James Miller", Items = 2, Total = "$67.98", CurrentStep = "Received", Tracking = null, Completed = false },
        new() { Id = "o5", OrderId = "ORD-4817", Customer = "Aisha Patel", Items = 4, Total = "$312.40", CurrentStep = "Shipped", Tracking = "1Z999AA10987654321", Completed = false },
        new() { Id = "o6", OrderId = "ORD-4816", Customer = "Lucas Brown", Items = 1, Total = "$45.00", CurrentStep = "Delivered", Tracking = "1Z999AA10456789012", Completed = true },
        new() { Id = "o7", OrderId = "ORD-4815", Customer = "Mia Thompson", Items = 7, Total = "$498.25", CurrentStep = "Processing", Tracking = null, Completed = false },
        new() { Id = "o8", OrderId = "ORD-4814", Customer = "Oliver Davis", Items = 2, Total = "$124.50", CurrentStep = "Received", Tracking = null, Completed = false },
    ];

    private string? _expanded;

    private Dictionary<string, int> _stepCounts =>
        _items.GroupBy(i => i.CurrentStep).ToDictionary(g => g.Key, g => g.Count());

    private void Toggle(string id)
    {
        var order = _items.FirstOrDefault(o => o.Id == id);
        if (order != null)
            order.Completed = !order.Completed;
    }

    private void AdvanceStep(string id)
    {
        var order = _items.FirstOrDefault(o => o.Id == id);
        if (order == null) return;
        var idx = Array.IndexOf(_stepOrder, order.CurrentStep);
        if (idx >= 0 && idx < _stepOrder.Length - 1)
            order.CurrentStep = _stepOrder[idx + 1];
    }
}
