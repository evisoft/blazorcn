@* ============================================================
   Block: todo-list-changelog
   Title: TodoListChangelog
   Description: React todo list activity changelog block for Next.js with expandable task histories, event type filters, user avatars, and timestamps using shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-changelog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="history" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Activity Log</span>
            </div>
            <span class="text-muted-foreground text-xs">@_totalEvents events</span>
        </div>

        @* Filters *@
        <div class="flex items-center gap-1.5 border-b px-4 py-2.5">
            <LucideIconCn Name="filter" Size="12" Class="size-3 text-muted-foreground" />
            <ButtonCn Variant="@(_activeFilter == null ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                      Size="ButtonSize.Sm"
                      Class="h-6 px-2 text-[10px]"
                      @onclick="@(() => { _activeFilter = null; })">
                All
            </ButtonCn>
            @foreach (var filterType in _filterTypes)
            {
                var ft = filterType;
                var cfg = _eventConfig[ft];
                <ButtonCn Variant="@(_activeFilter == ft ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-6 gap-1 px-2 text-[10px]"
                          @onclick="@(() => { _activeFilter = (_activeFilter == ft ? null : ft); })">
                    <span class="@($"size-1.5 rounded-full {cfg.DotClass}")"></span>
                    @cfg.Label
                </ButtonCn>
            }
        </div>

        @* Tasks *@
        <div>
            @for (int i = 0; i < _tasks.Length; i++)
            {
                var task = _tasks[i];
                var isExpanded = _expanded == task.Id;
                var isLast = i == _tasks.Length - 1;
                var filteredEvents = _activeFilter != null
                    ? task.Events.Where(e => e.Kind == _activeFilter).ToArray()
                    : task.Events;
                var latestKind = task.Events.Length > 0 ? task.Events[0].Kind : null;
                var latestCfg = latestKind != null ? _eventConfig[latestKind] : null;
                var taskId = task.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => { _expanded = isExpanded ? null : taskId; })"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @if (latestCfg != null)
                        {
                            <span class="@($"size-2 shrink-0 rounded-full {latestCfg.DotClass}")"></span>
                        }
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@task.Title</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">
                                @(task.Events.Length > 0 ? task.Events[0].Description : "") · @task.LatestEvent
                            </p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-[10px]">
                            @task.Events.Length events
                        </BadgeCn>
                        <LucideIconCn Name="chevron-right"
                                      Size="16"
                                      Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pl-9">
                                @if (filteredEvents.Length > 0)
                                {
                                    <div class="relative space-y-0">
                                        @* Timeline line *@
                                        <div class="absolute top-2 bottom-2 left-[7px] w-px bg-border"></div>

                                        @foreach (var evt in filteredEvents)
                                        {
                                            var evtCfg = _eventConfig[evt.Kind];
                                            <div class="relative flex items-start gap-3 py-1.5">
                                                <span class="@($"relative z-10 mt-1 size-[9px] shrink-0 rounded-full ring-2 ring-card {evtCfg.DotClass}")"></span>
                                                <div class="min-w-0 flex-1">
                                                    <span class="text-sm">@evt.Description</span>
                                                    <div class="mt-0.5 flex items-center gap-1.5 text-muted-foreground text-xs">
                                                        <AvatarCn Class="size-4">
                                                            <AvatarFallbackCn Class="text-[8px]">@evt.User.Initials</AvatarFallbackCn>
                                                        </AvatarCn>
                                                        <span>@evt.User.Name</span>
                                                        <span>·</span>
                                                        <span>@evt.Timestamp</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted-foreground text-xs">No matching events</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record UserInfo(string Name, string Initials);
    private record ActivityEventItem(string Id, string Kind, string Description, UserInfo User, string Timestamp);
    private record TaskItem(string Id, string Title, string LatestEvent, ActivityEventItem[] Events);
    private record EventConfigItem(string DotClass, string Label);

    private static readonly Dictionary<string, EventConfigItem> _eventConfig = new()
    {
        ["created"]   = new("bg-blue-500",    "Created"),
        ["updated"]   = new("bg-amber-500",   "Updated"),
        ["assigned"]  = new("bg-purple-500",  "Assigned"),
        ["completed"] = new("bg-emerald-500", "Completed"),
    };

    private static readonly string[] _filterTypes = ["created", "updated", "assigned", "completed"];

    private static readonly TaskItem[] _tasks =
    [
        new("t1", "Implement user authentication flow", "10 min ago",
        [
            new("e1",  "completed", "Marked as completed",             new("Alex Chen",   "AC"), "10 min ago"),
            new("e2",  "updated",   "Priority changed to High",        new("Jordan Lee",  "JL"), "2 hours ago"),
            new("e3",  "assigned",  "Assigned to Alex Chen",           new("Taylor Kim",  "TK"), "1 day ago"),
            new("e4",  "created",   "Task created",                    new("Taylor Kim",  "TK"), "3 days ago"),
        ]),
        new("t2", "Design settings page layout", "30 min ago",
        [
            new("e5",  "assigned",  "Reassigned to Sam Rivera",        new("Jordan Lee",  "JL"), "30 min ago"),
            new("e6",  "updated",   "Description updated",             new("Sam Rivera",  "SR"), "3 hours ago"),
            new("e7",  "assigned",  "Assigned to Jordan Lee",          new("Morgan Wu",   "MW"), "2 days ago"),
            new("e8",  "created",   "Task created",                    new("Morgan Wu",   "MW"), "4 days ago"),
        ]),
        new("t3", "Fix pagination bug in user list", "1 hour ago",
        [
            new("e9",  "updated",   "Status changed to In Progress",   new("Taylor Kim",  "TK"), "1 hour ago"),
            new("e10", "updated",   "Added to Sprint 14",              new("Alex Chen",   "AC"), "5 hours ago"),
            new("e11", "created",   "Task created from bug report",    new("Alex Chen",   "AC"), "1 day ago"),
        ]),
        new("t4", "Add email notification preferences", "Yesterday",
        [
            new("e12", "completed", "Marked as completed",             new("Morgan Wu",   "MW"), "Yesterday"),
            new("e13", "updated",   "Labels updated: backend, notifications", new("Morgan Wu", "MW"), "2 days ago"),
            new("e14", "assigned",  "Assigned to Morgan Wu",           new("Jordan Lee",  "JL"), "5 days ago"),
            new("e15", "created",   "Task created",                    new("Jordan Lee",  "JL"), "1 week ago"),
        ]),
        new("t5", "Optimize image upload pipeline", "3 hours ago",
        [
            new("e16", "assigned",  "Assigned to Taylor Kim",          new("Alex Chen",   "AC"), "3 hours ago"),
            new("e17", "created",   "Task created",                    new("Alex Chen",   "AC"), "6 hours ago"),
