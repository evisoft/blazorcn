@* ============================================================
   Block: todo-list-streak-counter
   Title: TodoListStreakCounter
   Description: A streak-based task tracking todo list block for React and Next.js with flame indicators, sparkline dots, best streak records, and active streak summary built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-streak-counter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="flame" Size="16" Class="size-4 text-amber-500" />
                <span class="font-medium text-sm">Streak Tracker</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @ActiveStreaks active
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    Longest: @(LongestActive)d
                </span>
            </div>
        </div>

        @* Day labels *@
        <div class="flex items-center border-b px-4 py-2">
            <div class="w-8 shrink-0"></div>
            <div class="min-w-0 flex-1"></div>
            <div class="flex shrink-0 items-center gap-0 pr-24">
                @foreach (var label in _dayLabels)
                {
                    <span class="flex w-5 items-center justify-center font-mono text-muted-foreground text-xs">@label</span>
                }
            </div>
        </div>

        @* Task rows *@
        <div>
            @for (int idx = 0; idx < _tasks.Count; idx++)
            {
                var task = _tasks[idx];
                var isLast = idx == _tasks.Count - 1;
                var hasStreak = task.CurrentStreak > 0 || task.TodayDone;
                var effectiveStreak = task.CurrentStreak;
                var taskId = task.Id;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    @* Checkbox *@
                    <span class="flex w-5 shrink-0 items-center justify-center">
                        <CheckboxCn Checked="@task.TodayDone"
                                    CheckedChanged="@((bool _) => ToggleToday(taskId))"
                                    aria-label="@GetAriaLabel(task.Text)" />
                    </span>

                    @* Task info *@
                    <div class="min-w-0 flex-1">
                        <span class="text-sm">@task.Text</span>
                        <div class="mt-0.5 flex items-center gap-2">
                            @if (hasStreak)
                            {
                                <span class="flex items-center gap-0.5 text-xs">
                                    <LucideIconCn Name="flame" Size="12" Class="size-3 text-amber-500" />
                                    <span class="font-medium tabular-nums">@(effectiveStreak)d</span>
                                </span>
                            }
                            <span class="flex items-center gap-0.5 text-muted-foreground text-xs">
                                <LucideIconCn Name="trophy" Size="12" Class="size-3" />
                                <span class="tabular-nums">@(task.BestStreak)d</span>
                            </span>
                        </div>
                    </div>

                    @* 7-day sparkline *@
                    <div class="flex shrink-0 items-center gap-0">
                        @foreach (var dayDone in task.Last7)
                        {
                            <span class="flex w-5 items-center justify-center">
                                <span class="@Cn.Merge("size-2 rounded-full", dayDone ? "bg-foreground" : "bg-muted-foreground/20")"></span>
                            </span>
                        }
                    </div>

                    @* Streak count *@
                    <div class="w-12 shrink-0 text-right">
                        <span class="@Cn.Merge("font-medium text-xs tabular-nums", hasStreak ? "text-foreground" : "text-muted-foreground")">
                            @(effectiveStreak > 0 ? $"{effectiveStreak}d" : "—")
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                Complete tasks daily to build streaks
            </span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @DoneToday of @_tasks.Count done today
            </span>
        </div>
    </div>
</section>

@code {
    private class StreakTask
    {
        public string Id { get; set; } = "";
        public string Text { get; set; } = "";
        public int CurrentStreak { get; set; }
        public int BestStreak { get; set; }
        public bool TodayDone { get; set; }
        public bool[] Last7 { get; set; } = [];
    }

    private static readonly string[] _dayLabels = ["M", "T", "W", "T", "F", "S", "S"];

    private List<StreakTask> _tasks =
    [
        new() { Id = "s1", Text = "Ship one feature",            CurrentStreak = 12, BestStreak = 18, TodayDone = false, Last7 = [true,  true,  true,  true,  true,  true,  false] },
        new() { Id = "s2", Text = "Write daily journal",         CurrentStreak =  7, BestStreak =  7, TodayDone = false, Last7 = [true,  true,  true,  true,  true,  true,  false] },
        new() { Id = "s3", Text = "Exercise for 30 minutes",     CurrentStreak =  4, BestStreak = 21, TodayDone = false, Last7 = [false, false, false, true,  true,  true,  false] },
        new() { Id = "s4", Text = "Read technical articles",     CurrentStreak =  0, BestStreak =  9, TodayDone = false, Last7 = [true,  true,  false, false, false, false, false] },
        new() { Id = "s5", Text = "Review one PR",               CurrentStreak = 23, BestStreak = 23, TodayDone = false, Last7 = [true,  true,  true,  true,  true,  true,  false] },
        new() { Id = "s6", Text = "Zero inbox before EOD",       CurrentStreak =  3, BestStreak = 15, TodayDone = false, Last7 = [true,  false, false, true,  true,  true,  false] },
        new() { Id = "s7", Text = "Practice typing for 10 minutes", CurrentStreak = 0, BestStreak = 5, TodayDone = false, Last7 = [false, false, true,  true,  false, false, false] },
    ];

    private int ActiveStreaks => _tasks.Count(t => t.CurrentStreak > 0 || t.TodayDone);
    private int LongestActive => _tasks.Count > 0
        ? _tasks.Max(t => t.CurrentStreak > 0 || t.TodayDone ? t.CurrentStreak : 0)
        : 0;
    private int DoneToday => _tasks.Count(t => t.TodayDone);

    private static string GetAriaLabel(string text) => $"Mark \"{text}\" as done today";

    private void ToggleToday(string id)
    {
        var task = _tasks.FirstOrDefault(t => t.Id == id);
        if (task == null) return;
        var newDone = !task.TodayDone;
        var newStreak = newDone ? task.CurrentStreak + 1 : task.CurrentStreak - 1;
        var newBest = Math.Max(task.BestStreak, newStreak);
        task.Last7[6] = newDone;
        task.TodayDone = newDone;
        task.CurrentStreak = Math.Max(0, newStreak);
        task.BestStreak = newBest;
    }
}
