@* ============================================================
   Block: todo-list-retro
   Title: TodoListRetro
   Description: React todo list sprint retrospective block for Next.js with three-column layout, voting, and action items using shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-retro.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Sprint Retrospective</span>
            <span class="text-muted-foreground text-xs">@_totalItems items</span>
        </div>

        @* Three columns *@
        <div class="grid grid-cols-1 md:grid-cols-3">
            @for (int i = 0; i < _columns.Count; i++)
            {
                var col = _columns[i];
                var colIndex = i;
                var colId = col.Id;
                <div class="@(colIndex < _columns.Count - 1 ? "border-b md:border-r md:border-b-0" : "")">
                    @* Column header *@
                    <div class="flex items-center gap-2 border-b px-4 py-2.5">
                        <span class="@($"size-1.5 rounded-full {col.DotClass}")" />
                        <span class="@($"font-medium text-xs {col.HeaderClass}")">@col.Title</span>
                        <span class="text-muted-foreground text-xs">(@col.Items.Count)</span>
                    </div>

                    @* Items *@
                    <div class="min-h-[200px]">
                        @for (int j = 0; j < col.Items.Count; j++)
                        {
                            var item = col.Items[j];
                            var itemId = item.Id;
                            var isLastItem = j == col.Items.Count - 1;
                            <div class="@Cn.Merge("flex items-start gap-2 border-b px-4 py-2.5", isLastItem ? "border-b-0" : "")">
                                <div class="min-w-0 flex-1">
                                    <span class="text-sm leading-relaxed">@item.Text</span>
                                </div>
                                <ButtonCn Variant="ButtonVariant.Ghost"
                                          Size="ButtonSize.Sm"
                                          Class="h-6 shrink-0 gap-1 px-1.5 text-muted-foreground text-xs"
                                          @onclick="@(() => Vote(colId, itemId))">
                                    <LucideIconCn Name="thumbs-up" Size="12" Class="size-3" />
                                    <span class="tabular-nums">@item.Votes</span>
                                </ButtonCn>
                            </div>
                        }
                    </div>

                    @* Add item *@
                    <div class="flex items-center gap-1.5 border-t px-3 py-2">
                        <InputCn Value="@_inputs[colId]"
                                 ValueChanged="@((string v) => _inputs[colId] = v)"
                                 @onkeydown="@((KeyboardEventArgs e) => HandleInputKeyDown(e, colId))"
                                 Placeholder="Add item..."
                                 Class="h-7 border-0 bg-transparent px-1 text-sm shadow-none focus-visible:ring-0" aria-label="Add item" />
                        <ButtonCn aria-label="@($"Add item to {col.Title}")" Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.Sm"
                                  Class="h-6 w-6 shrink-0 p-0"
                                  @onclick="@(() => AddItem(colId))">
                            <LucideIconCn Name="plus" Size="14" Class="size-3.5 text-muted-foreground" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class RetroItem
    {
        public string Id { get; set; } = "";
        public string Text { get; set; } = "";
        public int Votes { get; set; }
    }

    private class RetroColumn
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string HeaderClass { get; set; } = "";
        public string DotClass { get; set; } = "";
        public List<RetroItem> Items { get; set; } = new();
    }

    private int _nextId = 100;

    private List<RetroColumn> _columns =
    [
        new RetroColumn
        {
            Id = "well",
            Title = "What went well",
            HeaderClass = "text-emerald-600 dark:text-emerald-400",
            DotClass = "bg-emerald-500",
            Items =
            [
                new RetroItem { Id = "w1", Text = "Shipped the billing integration on schedule", Votes = 5 },
                new RetroItem { Id = "w2", Text = "Great cross-team collaboration on the migration", Votes = 3 },
                new RetroItem { Id = "w3", Text = "Zero production incidents this sprint", Votes = 7 },
                new RetroItem { Id = "w4", Text = "Onboarded two new engineers smoothly", Votes = 2 },
            ]
        },
        new RetroColumn
        {
            Id = "bad",
            Title = "What didn't go well",
            HeaderClass = "text-red-600 dark:text-red-400",
            DotClass = "bg-red-500",
            Items =
            [
                new RetroItem { Id = "b1", Text = "Flaky E2E tests blocked deployments twice", Votes = 6 },
                new RetroItem { Id = "b2", Text = "Requirements changed mid-sprint for the settings page", Votes = 4 },
                new RetroItem { Id = "b3", Text = "Code review turnaround was too slow", Votes = 3 },
                new RetroItem { Id = "b4", Text = "Documentation fell behind on new API endpoints", Votes = 1 },
            ]
        },
        new RetroColumn
        {
            Id = "action",
            Title = "Action items",
            HeaderClass = "text-blue-600 dark:text-blue-400",
            DotClass = "bg-blue-500",
            Items =
            [
                new RetroItem { Id = "a1", Text = "Set up test stability dashboard and alert on flaky tests", Votes = 5 },
                new RetroItem { Id = "a2", Text = "Add a 24-hour SLA for code reviews", Votes = 4 },
                new RetroItem { Id = "a3", Text = "Schedule docs sprint before next release", Votes = 2 },
            ]
        },
    ];

    private Dictionary<string, string> _inputs = new() { ["well"] = "", ["bad"] = "", ["action"] = "" };

    private int _totalItems => _columns.Sum(c => c.Items.Count);

    private void Vote(string columnId, string itemId)
    {
        var col = _columns.FirstOrDefault(c => c.Id == columnId);
        if (col == null) return;
        var item = col.Items.FirstOrDefault(it => it.Id == itemId);
        if (item == null) return;
        item.Votes++;
        col.Items.Sort((a, b) => b.Votes.CompareTo(a.Votes));
    }

    private void AddItem(string columnId)
    {
        if (!_inputs.TryGetValue(columnId, out var text) || string.IsNullOrWhiteSpace(text)) return;
        _nextId++;
        var col = _columns.FirstOrDefault(c => c.Id == columnId);
        if (col == null) return;
        col.Items.Add(new RetroItem { Id = $"retro-new-{_nextId}", Text = text.Trim(), Votes = 0 });
        _inputs[columnId] = "";
    }

    private void HandleInputKeyDown(KeyboardEventArgs e, string columnId)
    {
        if (e.Key == "Enter") AddItem(columnId);
    }
}
