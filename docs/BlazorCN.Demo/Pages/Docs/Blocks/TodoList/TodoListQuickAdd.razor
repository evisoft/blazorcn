@* ============================================================
   Block: todo-list-quick-add
   Title: TodoListQuickAdd
   Description: A todo list block with smart syntax parsing for React and Next.js featuring inline token detection for priority, assignee, tags, and due dates with live preview badges built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-quick-add.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Quick add input *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <input type="text"
                       value="@_input"
                       @oninput="@((ChangeEventArgs e) => _input = e.Value?.ToString() ?? "")"
                       @onkeydown="HandleKeyDown"
                       placeholder="Quick add: Buy milk !high @@alex #shopping >tomorrow"
                       class="h-8 flex-1 border-0 bg-transparent px-0 text-sm shadow-none outline-none placeholder:text-muted-foreground focus-visible:ring-0" aria-label="Quick add task" />
                <ButtonCn Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Sm"
                          Class="h-7 shrink-0 gap-1 text-xs"
                          @onclick="AddTodo"
                          Disabled="@(string.IsNullOrWhiteSpace(_parsed.Title))">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    Add
                </ButtonCn>
            </div>

            @* Parsed tokens preview *@
            @if (_hasTokens)
            {
                <div class="mt-2 flex flex-wrap items-center gap-1.5">
                    @if (_parsed.Priority != null)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-xs font-normal", GetPriorityClass(_parsed.Priority))">
                            !@_parsed.Priority
                        </BadgeCn>
                    }
                    @if (_parsed.Assignee != null)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-violet-500/10 text-xs font-normal text-violet-700 dark:text-violet-400">
                            @@@_parsed.Assignee
                        </BadgeCn>
                    }
                    @if (_parsed.Tag != null)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-emerald-500/10 text-xs font-normal text-emerald-700 dark:text-emerald-400">
                            #@_parsed.Tag
                        </BadgeCn>
                    }
                    @if (_parsed.DueDate != null)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-sky-500/10 text-xs font-normal text-sky-700 dark:text-sky-400">
                            @_parsed.DueDate
                        </BadgeCn>
                    }
                    @if (!string.IsNullOrWhiteSpace(_parsed.Title))
                    {
                        <span class="text-muted-foreground/40 text-xs">|</span>
                        <span class="text-muted-foreground text-xs">@_parsed.Title.Trim()</span>
                    }
                </div>
            }
        </div>

        @* Syntax hint *@
        <div class="flex flex-wrap items-center gap-3 border-b px-4 py-2">
            <span class="font-mono text-muted-foreground/60 text-xs">!priority</span>
            <span class="font-mono text-muted-foreground/60 text-xs">@@assignee</span>
            <span class="font-mono text-muted-foreground/60 text-xs">#tag</span>
            <span class="font-mono text-muted-foreground/60 text-xs">&gt;due</span>
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < _todos.Count; i++)
            {
                var todo = _todos[i];
                var isLast = i == _todos.Count - 1;
                var todoId = todo.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex w-full items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <span class="mt-0.5 shrink-0">
                            <CheckboxCn Id="@($"quick-add-todo-{todo.Id}")"
                                        Checked="@todo.Completed"
                                        CheckedChanged="@((bool _) => ToggleTodo(todoId))" aria-label="@todo.Text" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="@Cn.Merge("text-sm transition-all duration-200", todo.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                                @todo.Text
                            </span>
                            <div class="mt-1.5 flex flex-wrap items-center gap-1">
                                @if (todo.Priority != null)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-xs font-normal", GetPriorityClass(todo.Priority))">
                                        @todo.Priority
                                    </BadgeCn>
                                }
                                @if (todo.Assignee != null)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-violet-500/10 text-xs font-normal text-violet-700 dark:text-violet-400">
                                        @@@todo.Assignee
                                    </BadgeCn>
                                }
                                @if (todo.Tag != null)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-emerald-500/10 text-xs font-normal text-emerald-700 dark:text-emerald-400">
                                        #@todo.Tag
                                    </BadgeCn>
                                }
                                @if (todo.DueDate != null)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-sky-500/10 text-xs font-normal text-sky-700 dark:text-sky-400">
                                        @todo.DueDate
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                        <ButtonCn aria-label="@($"Remove {todo.Text}")" Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.Sm"
                                  Class="mt-0.5 h-6 shrink-0 px-1.5 text-muted-foreground/60 hover:text-foreground"
                                  @onclick="@(() => RemoveTodo(todoId))">
                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <span class="text-muted-foreground text-xs tabular-nums">@_todos.Count tasks</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="text-muted-foreground text-xs tabular-nums">@_todos.Count(t => t.Completed) completed</span>
        </div>

    </div>
</section>

@code {
    private record TodoItem(string Id, string Text, bool Completed, string? Priority, string? Assignee, string? Tag, string? DueDate);

    private record ParsedTokens(string Title, string? Priority, string? Assignee, string? Tag, string? DueDate);

    private List<TodoItem> _todos =
    [
        new("1", "Set up CI/CD pipeline",            false, "high",   "alex",   "devops",  "Tomorrow"),
        new("2", "Design landing page",               false, "medium", "sara",   "design",  null),
        new("3", "Write API documentation",           true,  "low",    null,     "docs",    null),
        new("4", "Fix authentication bug",            false, "high",   "jordan", "bug",     "Today"),
        new("5", "Code review for payments module",   false, "medium", "alex",   "review",  "Friday"),
    ];

    private string _input = "";

    private ParsedTokens _parsed => ParseInput(_input);

    private bool _hasTokens => _parsed.Priority != null || _parsed.Assignee != null || _parsed.Tag != null || _parsed.DueDate != null;

    private static ParsedTokens ParseInput(string input)
    {
        var tokens = input.Split(' ');
        string? priority = null;
        string? assignee = null;
        string? tag = null;
        string? dueDate = null;
        var titleParts = new List<string>();

        foreach (var token in tokens)
        {
            if (token.StartsWith("!") && token.Length > 1)
            {
                var val = token.Substring(1).ToLower();
                if (val == "high" || val == "medium" || val == "low")
                    priority = val;
                else
                    titleParts.Add(token);
            }
            else if (token.StartsWith("@") && token.Length > 1)
            {
                assignee = token.Substring(1);
            }
            else if (token.StartsWith("#") && token.Length > 1)
            {
                tag = token.Substring(1);
            }
            else if (token.StartsWith(">") && token.Length > 1)
            {
                var raw = token.Substring(1);
                dueDate = char.ToUpper(raw[0]) + raw.Substring(1);
            }
            else
            {
                titleParts.Add(token);
            }
        }

        return new ParsedTokens(string.Join(" ", titleParts), priority, assignee, tag, dueDate);
    }

    private static string GetPriorityClass(string? priority) => priority switch
    {
        "high"   => "bg-red-500/10 text-red-700 dark:text-red-400",
        "medium" => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "low"    => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        _        => ""
    };

    private void AddTodo()
    {
        var title = _parsed.Title.Trim();
        if (string.IsNullOrEmpty(title)) return;

        var newTodo = new TodoItem(
            $"quick-add-new-{_todos.Count + 1}",
            title,
            false,
            _parsed.Priority,
            _parsed.Assignee,
            _parsed.Tag,
            _parsed.DueDate
        );
        _todos.Insert(0, newTodo);
        _input = "";
    }

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _todos[idx] = _todos[idx] with { Completed = !_todos[idx].Completed };
    }

    private void RemoveTodo(string id)
    {
        _todos.RemoveAll(t => t.Id == id);
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTodo();
    }
}
