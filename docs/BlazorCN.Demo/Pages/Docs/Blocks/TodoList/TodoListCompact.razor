@* ============================================================
   Block: todo-list-compact
   Title: TodoListCompact
   Description: An ultra-dense compact todo list block for React and Next.js with tiny rows, minimal padding, and density toggle built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-compact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Tasks</span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_completedCount/@_tasks.Count
                </span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.Sm"
                      Class="h-7 gap-1.5 px-2 text-xs"
                      @onclick="ToggleCompact">
                @if (_compact)
                {
                    <LucideIconCn Name="layout-list" Size="14" Class="size-3.5" />
                    @:Comfortable
                }
                else
                {
                    <LucideIconCn Name="list" Size="14" Class="size-3.5" />
                    @:Compact
                }
            </ButtonCn>
        </div>

        @* Add task *@
        <div class="@Cn.Merge("flex items-center gap-2 border-b px-4", _compact ? "py-1.5" : "py-2")">
            <InputCn @bind-Value="_newTask"
                     @onkeydown="HandleAddKeyDown"
                     Placeholder="Add a task..."
                     Class="@(Cn.Merge("border-0 bg-transparent px-0 shadow-none focus-visible:ring-0", _compact ? "h-6 text-xs" : "h-8 text-sm"))" />
            <ButtonCn Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.IconXs"
                      @onclick="AddTask"
                      Disabled="@(string.IsNullOrWhiteSpace(_newTask))"
                      aria-label="Add task">
                <LucideIconCn Name="plus" Size="@(_compact ? 12 : 16)" Class="@(_compact ? "size-3" : "size-4")" />
            </ButtonCn>
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < _tasks.Count; i++)
            {
                var task = _tasks[i];
                var isLast = i == _tasks.Count - 1;
                var taskId = task.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="@Cn.Merge("group flex w-full items-center gap-2 transition-colors hover:bg-muted/50", _compact ? "px-3 py-1.5" : "px-4 py-3")">
                        <CheckboxCn Id="@($"compact-{task.Id}")"
                                    Checked="@task.Completed"
                                    CheckedChanged="@((bool _) => ToggleTask(taskId))"
                                    Class="@(_compact ? "size-3" : "")" />
                        <span class="@Cn.Merge("min-w-0 flex-1 cursor-pointer transition-all duration-200", _compact ? "text-xs" : "text-sm", task.Completed ? "text-muted-foreground line-through" : "text-foreground")"
                              @onclick="@(() => ToggleTask(taskId))"
                              @onkeydown="@((KeyboardEventArgs e) => HandleSpanKeyDown(e, taskId))"
                              role="button"
                              tabindex="0">
                            @task.Text
                        </span>
                        <ButtonCn Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.IconXs"
                                  @onclick="@(() => DeleteTask(taskId))"
                                  Class="shrink-0 opacity-0 transition-opacity group-hover:opacity-100"
                                  aria-label="@DeleteLabel(task.Text)">
                            <LucideIconCn Name="trash-2" Size="@(_compact ? 10 : 12)" Class="@(_compact ? "size-2.5 text-muted-foreground" : "size-3 text-muted-foreground")" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="@Cn.Merge("border-t", _compact ? "px-3 py-2" : "px-4 py-3")">
            <span class="text-muted-foreground text-xs">
                @(_tasks.Count - _completedCount) remaining · @(_compact ? "Compact" : "Comfortable") view
            </span>
        </div>
    </div>
</section>

@code {
    private record TaskItem(string Id, string Text, bool Completed);

    private int _nextId = 16;
    private bool _compact = true;
    private string _newTask = "";

    private List<TaskItem> _tasks =
    [
        new("1", "Review API endpoint documentation", false),
        new("2", "Fix pagination bug on search page", true),
        new("3", "Update TypeScript to v5.4", false),
        new("4", "Merge feature branch into staging", false),
        new("5", "Write unit tests for auth module", true),
        new("6", "Refactor database queries", false),
        new("7", "Deploy hotfix to production", true),
        new("8", "Set up CI/CD pipeline for new repo", false),
        new("9", "Review pull request #128", false),
        new("10", "Update dependency versions", true),
        new("11", "Add error tracking middleware", false),
        new("12", "Configure rate limiting on API", false),
        new("13", "Optimize image loading on dashboard", true),
        new("14", "Schedule team retrospective", false),
        new("15", "Draft RFC for new caching strategy", false),
    ];

    private int _completedCount => _tasks.Count(t => t.Completed);

    private void ToggleCompact() => _compact = !_compact;

    private void AddTask()
    {
        var trimmed = _newTask.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        _tasks.Add(new TaskItem(_nextId.ToString(), trimmed, false));
        _nextId++;
        _newTask = "";
    }

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Completed = !_tasks[idx].Completed };
    }

    private void DeleteTask(string id) => _tasks.RemoveAll(t => t.Id == id);

    private void HandleAddKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTask();
    }

    private void HandleSpanKeyDown(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter" || e.Key == " ") ToggleTask(id);
    }

    private static string DeleteLabel(string text) => $"Delete {text}";
}
