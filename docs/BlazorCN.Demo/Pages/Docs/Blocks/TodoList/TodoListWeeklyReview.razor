@* ============================================================
   Block: todo-list-weekly-review
   Title: TodoListWeeklyReview
   Description: A weekly review todo list block for React and Next.js with completed, carried-over, and new task sections, week navigation, and add input built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-weekly-review.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Weekly Review</span>
                <p class="text-muted-foreground text-xs">Mar 31 — Apr 6</p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_completedTasks.Length done
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @(_carriedOverTasks.Length - _completedIds.Count) carried
                </span>
            </div>
        </div>

        @* Completed This Week *@
        <div>
            <div class="flex items-center gap-2 border-b bg-muted/20 px-4 py-2">
                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                <span class="font-medium text-xs">Completed This Week</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs tabular-nums">
                    @_completedTasks.Length
                </BadgeCn>
            </div>
            <div>
                @foreach (var task in _completedTasks)
                {
                    <div class="flex items-center gap-3 border-b px-4 py-2.5">
                        <span class="flex shrink-0 items-center">
                            <CheckboxCn Checked="true" Disabled="true" aria-label="@($"{task.Text} completed")" />
                        </span>
                        <span class="min-w-0 flex-1 truncate text-muted-foreground text-sm line-through">
                            @task.Text
                        </span>
                        <span class="shrink-0 text-muted-foreground text-xs">@task.Context</span>
                    </div>
                }
            </div>
        </div>

        @* Carried Over *@
        <div>
            <div class="flex items-center gap-2 border-b bg-muted/20 px-4 py-2">
                <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5 text-amber-500" />
                <span class="font-medium text-xs">Carried Over</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs tabular-nums">
                    @_carriedOverTasks.Length
                </BadgeCn>
            </div>
            <div>
                @foreach (var task in _carriedOverTasks)
                {
                    var taskId = task.Id;
                    var isDone = _completedIds.Contains(taskId);
                    <div class="flex items-center gap-3 border-b px-4 py-2.5 transition-colors hover:bg-muted/50">
                        <span class="flex shrink-0 items-center">
                            <CheckboxCn Checked="@isDone"
                                        CheckedChanged="@((bool _) => ToggleCarriedOver(taskId))"
                                        aria-label="@($"Mark \"{task.Text}\" as completed")" />
                        </span>
                        @if (!isDone)
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-amber-500"></span>
                        }
                        <span class="@Cn.Merge("min-w-0 flex-1 truncate text-sm", isDone ? "text-muted-foreground line-through" : "")">
                            @task.Text
                        </span>
                        <span class="shrink-0 text-muted-foreground text-xs">@task.Context</span>
                    </div>
                }
            </div>
        </div>

        @* New for Next Week *@
        <div>
            <div class="flex items-center gap-2 border-b bg-muted/20 px-4 py-2">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5 text-blue-500" />
                <span class="font-medium text-xs">New for Next Week</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs tabular-nums">
                    @_newTasks.Count
                </BadgeCn>
            </div>
            <div>
                @foreach (var task in _newTasks)
                {
                    <div class="flex items-center gap-3 border-b px-4 py-2.5">
                        <span class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                        <span class="min-w-0 flex-1 truncate text-sm">@task.Text</span>
                        <span class="shrink-0 text-muted-foreground text-xs">@task.Context</span>
                    </div>
                }
            </div>
            <div class="flex items-center gap-2 px-4 py-2.5">
                <InputCn @bind-Value="_input"
                         @onkeydown="HandleInputKeyDown"
                         Placeholder="Add task for next week..."
                         Class="h-7 border-0 bg-transparent px-0 text-xs shadow-none focus-visible:ring-0" />
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Icon"
                          Class="h-6 w-6 shrink-0 p-0"
                          @onclick="AddTask"
                          aria-label="Add task">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Task(string Id, string Text, string Context);

    private static readonly Task[] _completedTasks =
    [
        new("c1", "Ship checkout redesign to production", "Frontend"),
        new("c2", "Migrate user data to new schema", "Backend"),
        new("c3", "Write test coverage for auth module", "QA"),
        new("c4", "Update API documentation for v2 endpoints", "Docs"),
        new("c5", "Fix timezone bug in scheduling service", "Backend"),
    ];

    private static readonly Task[] _carriedOverTasks =
    [
        new("o1", "Implement webhook retry mechanism", "Infrastructure"),
        new("o2", "Complete accessibility audit for settings page", "Frontend"),
        new("o3", "Set up monitoring alerts for edge functions", "DevOps"),
    ];

    private List<Task> _newTasks =
    [
        new("n1", "Design onboarding email sequence", "Marketing"),
    ];

    private string _input = "";
    private HashSet<string> _completedIds = new();

    private void ToggleCarriedOver(string id)
    {
        if (_completedIds.Contains(id))
            _completedIds.Remove(id);
        else
            _completedIds.Add(id);
    }

    private void AddTask()
    {
        var text = _input.Trim();
        if (string.IsNullOrEmpty(text)) return;
        _newTasks.Add(new Task($"new-{_newTasks.Count + 1}", text, "New"));
        _input = "";
    }

    private void HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTask();
    }
}
