@* ============================================================
   Block: todo-list-okr
   Title: TodoListOkr
   Description: React todo list OKR tracking block for Next.js with objectives, key results, progress percentages, and quarterly status indicators using shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-okr.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="target" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">OKR Tracking</span>
            </div>
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px]">
                    Q2 2026
                </BadgeCn>
                <span>@OnTrackCount/@_objectives.Length on track</span>
            </div>
        </div>

        @* Objectives *@
        <div>
            @for (int i = 0; i < _objectives.Length; i++)
            {
                var obj = _objectives[i];
                var isLast = i == _objectives.Length - 1;
                var isExpanded = _expanded == obj.Id;
                var progress = GetObjectiveProgress(obj);
                var config = GetStatusConfig(obj.Status);
                var objId = obj.Id;
                var borderClass = !isLast || isExpanded ? "border-b" : "";
                <div class="@borderClass">
                    @* Objective row *@
                    <button type="button"
                            @onclick="@(() => ToggleExpanded(objId))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right"
                                      Size="16"
                                      Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@obj.Title</span>
                            <div class="mt-1.5 flex items-center gap-2">
                                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="@Cn.Merge("h-full rounded-full transition-all", GetProgressColor(progress))"
                                         style="width: @(progress)%" />
                                </div>
                                <span class="shrink-0 text-muted-foreground text-xs tabular-nums">@progress%</span>
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("shrink-0 text-[10px]", config.ClassName)">
                            @config.Label
                        </BadgeCn>
                    </button>

                    @* Key Results *@
                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="pb-1">
                                @foreach (var kr in obj.KeyResults)
                                {
                                    <div class="flex items-center gap-3 px-4 py-2.5 pl-11">
                                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetProgressColor(kr.Progress))" />
                                        <div class="min-w-0 flex-1">
                                            <span class="text-sm">@kr.Title</span>
                                            <div class="mt-1 flex items-center gap-2">
                                                <div class="h-1 w-24 overflow-hidden rounded-full bg-muted">
                                                    <div class="@Cn.Merge("h-full rounded-full", GetProgressColor(kr.Progress))"
                                                         style="width: @(kr.Progress)%" />
                                                </div>
                                                <span class="text-muted-foreground text-xs tabular-nums">@kr.Progress%</span>
                                            </div>
                                        </div>
                                        <div class="shrink-0 text-right">
                                            <span class="text-muted-foreground text-xs">@kr.Current</span>
                                            <span class="text-muted-foreground text-xs"> / @kr.Target</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum OkrStatus { OnTrack, AtRisk, Behind }

    private record KeyResultItem(string Id, string Title, int Progress, string Target, string Current);
    private record ObjectiveItem(string Id, string Title, string Quarter, OkrStatus Status, KeyResultItem[] KeyResults);
    private record StatusConfig(string Label, string ClassName, string DotClass);

    private static readonly ObjectiveItem[] _objectives =
    [
        new("o1", "Improve platform reliability and performance", "Q2 2026", OkrStatus.OnTrack,
        [
            new("kr1", "Reduce p99 API latency", 85, "< 200ms", "215ms"),
            new("kr2", "Achieve 99.95% uptime", 92, "99.95%", "99.93%"),
            new("kr3", "Zero critical incidents per sprint", 75, "0", "1"),
        ]),
        new("o2", "Grow monthly active users to 50K", "Q2 2026", OkrStatus.AtRisk,
        [
            new("kr4", "Increase organic signups by 40%", 55, "40%", "22%"),
            new("kr5", "Improve onboarding completion rate", 70, "80%", "68%"),
            new("kr6", "Reduce churn to under 3%", 45, "< 3%", "4.2%"),
        ]),
        new("o3", "Launch self-serve enterprise tier", "Q2 2026", OkrStatus.Behind,
        [
            new("kr7", "Ship SSO and SCIM integration", 30, "Complete", "In progress"),
            new("kr8", "Build usage-based billing system", 20, "Complete", "Design phase"),
            new("kr9", "Onboard 5 pilot enterprise accounts", 10, "5", "0"),
        ]),
        new("o4", "Strengthen engineering culture and hiring", "Q2 2026", OkrStatus.OnTrack,
        [
            new("kr10", "Hire 3 senior engineers", 66, "3", "2"),
            new("kr11", "Launch internal tech talk series", 100, "Monthly", "Monthly"),
            new("kr12", "Reduce PR review time to under 4 hours", 80, "< 4h", "5.1h"),
        ]),
    ];

    private string? _expanded = "o1";

    private int OnTrackCount => _objectives.Count(o => o.Status == OkrStatus.OnTrack);

    private static int GetObjectiveProgress(ObjectiveItem obj)
    {
        if (obj.KeyResults.Length == 0) return 0;
        return (int)Math.Round(obj.KeyResults.Average(kr => (double)kr.Progress));
    }

    private static string GetProgressColor(int progress)
    {
        if (progress >= 70) return "bg-emerald-500";
        if (progress >= 40) return "bg-amber-500";
        return "bg-red-500";
    }

    private static StatusConfig GetStatusConfig(OkrStatus status) => status switch
    {
        OkrStatus.OnTrack => new("On Track", "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400", "bg-emerald-500"),
        OkrStatus.AtRisk  => new("At Risk",  "bg-amber-500/10 text-amber-600 dark:text-amber-400",   "bg-amber-500"),
        OkrStatus.Behind  => new("Behind",   "bg-red-500/10 text-red-600 dark:text-red-400",         "bg-red-500"),
        _                 => new("Unknown",  "", ""),
    };

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
