@* ============================================================
   Block: todo-list-feature-request
   Title: TodoListFeatureRequest
   Description: A feature request board block for React and Next.js with upvoting, status filtering, category badges, and submission input built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-feature-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="lightbulb" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Feature Requests</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_requests.Count requests
            </span>
        </div>

        @* Status filter *@
        <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-3">
            <button type="button" @onclick="@(() => _statusFilter = null)" aria-pressed="@(_statusFilter == null)">
                <BadgeCn Variant="@(_statusFilter == null ? BadgeVariant.Default : BadgeVariant.Secondary)"
                         Class="@FilterBadgeClass(_statusFilter == null)">
                    All
                </BadgeCn>
            </button>
            @foreach (var st in _allStatuses)
            {
                var status = st;
                var isActive = _statusFilter == status;
                var info = StatusInfo(status);
                <button type="button"
                        @onclick="@(() => _statusFilter = (_statusFilter == status ? (RequestStatus?)null : status))"
                        aria-pressed="@isActive">
                    <BadgeCn Variant="@(isActive ? BadgeVariant.Default : BadgeVariant.Secondary)"
                             Class="@FilterBadgeClass(isActive)">
                        @info.Label
                    </BadgeCn>
                </button>
            }
        </div>

        @* Request list *@
        <div>
            @for (int i = 0; i < FilteredRequests.Count; i++)
            {
                var req = FilteredRequests[i];
                var isLast = i == FilteredRequests.Count - 1;
                var statusInfo = StatusInfo(req.Status);
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <ButtonCn Variant="@(req.HasVoted ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-8 w-12 shrink-0 flex-col gap-0 p-0 text-xs", req.HasVoted ? "bg-foreground text-background hover:bg-foreground/90" : "")"
                              OnClick="@((MouseEventArgs _) => ToggleVote(req.Id))">
                        <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                        <span class="tabular-nums">@req.Votes</span>
                    </ButtonCn>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@req.Title</span>
                        <div class="mt-0.5 flex items-center gap-2">
                            <span class="text-muted-foreground text-xs">@req.Requester</span>
                            <span class="text-muted-foreground text-xs">·</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @req.Category
                            </BadgeCn>
                        </div>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary"
                             Class="@Cn.Merge("shrink-0 font-normal text-xs", statusInfo.ClassName)">
                        @statusInfo.Label
                    </BadgeCn>
                </div>
            }

            @if (FilteredRequests.Count == 0)
            {
                <div class="px-4 py-8 text-center text-muted-foreground text-sm">
                    No requests matching filter
                </div>
            }
        </div>

        @* Submit request *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <input type="text"
                   value="@_newRequest"
                   @oninput="@((ChangeEventArgs e) => _newRequest = e.Value?.ToString() ?? "")"
                   @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") SubmitRequest(); })"
                   placeholder="Submit a feature request..."
                   class="h-8 flex-1 border-0 bg-transparent px-0 text-sm outline-none shadow-none focus-visible:ring-0 min-w-0" aria-label="Submit a feature request" />
            <ButtonCn Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Sm"
                      Class="h-7 shrink-0 gap-1 text-xs"
                      OnClick="@((MouseEventArgs _) => SubmitRequest())"
                      Disabled="@(string.IsNullOrWhiteSpace(_newRequest))">
                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                Submit
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private enum RequestStatus { Planned, InProgress, Shipped, Declined }

    private record FeatureRequest(string Id, string Title, string Requester, int Votes, RequestStatus Status, string Category, bool HasVoted);

    private static readonly RequestStatus[] _allStatuses =
        [RequestStatus.Planned, RequestStatus.InProgress, RequestStatus.Shipped, RequestStatus.Declined];

    private List<FeatureRequest> _requests =
    [
        new("fr1", "Dark mode support for all components",   "Sarah Chen",   47, RequestStatus.InProgress, "UI",            false),
        new("fr2", "Export data as CSV and PDF",             "James Rivera",  34, RequestStatus.Planned,    "Data",          true),
        new("fr3", "Real-time collaboration with cursors",   "Maya Patel",   29, RequestStatus.Planned,    "Collaboration", false),
        new("fr4", "Keyboard shortcuts for common actions",  "Alex Kim",     22, RequestStatus.Shipped,    "UX",            true),
        new("fr5", "Two-factor authentication via TOTP",     "Sarah Chen",   18, RequestStatus.InProgress, "Security",      false),
        new("fr6", "Custom webhook integrations",            "James Rivera",  12, RequestStatus.Declined,   "API",           false),
        new("fr7", "Audit log for all user actions",         "Maya Patel",   15, RequestStatus.Planned,    "Security",      false),
    ];

    private RequestStatus? _statusFilter = null;
    private string _newRequest = "";

    private List<FeatureRequest> FilteredRequests =>
        (_statusFilter == null ? _requests : _requests.Where(r => r.Status == _statusFilter).ToList())
            .OrderByDescending(r => r.Votes)
            .ToList();

    private static (string Label, string ClassName) StatusInfo(RequestStatus s) => s switch
    {
        RequestStatus.Planned    => ("Planned",     "bg-blue-500/10 text-blue-600 dark:text-blue-400"),
        RequestStatus.InProgress => ("In Progress", "bg-amber-500/10 text-amber-600 dark:text-amber-400"),
        RequestStatus.Shipped    => ("Shipped",     "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"),
        RequestStatus.Declined   => ("Declined",    "bg-zinc-500/10 text-zinc-600 dark:text-zinc-400"),
        _                        => ("", ""),
    };

    private static string FilterBadgeClass(bool active) =>
        Cn.Merge("cursor-pointer text-xs font-normal", active ? "bg-foreground text-background hover:bg-foreground/90" : "");

    private void ToggleVote(string id)
    {
        var idx = _requests.FindIndex(r => r.Id == id);
        if (idx >= 0)
        {
            var r = _requests[idx];
            _requests[idx] = r.HasVoted
                ? r with { Votes = r.Votes - 1, HasVoted = false }
                : r with { Votes = r.Votes + 1, HasVoted = true };
        }
    }

    private void SubmitRequest()
    {
        if (string.IsNullOrWhiteSpace(_newRequest)) return;
        var id = $"fr{_requests.Count + 1}";
        _requests.Add(new FeatureRequest(id, _newRequest.Trim(), "You", 1, RequestStatus.Planned, "General", true));
        _newRequest = "";
    }
}
