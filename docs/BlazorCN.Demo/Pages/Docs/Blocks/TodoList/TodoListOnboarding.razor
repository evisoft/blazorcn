@* ============================================================
   Block: todo-list-onboarding
   Title: TodoListOnboarding
   Description: An employee onboarding checklist block for React and Next.js with sectioned phases, per-section progress, assignees, and due dates built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-onboarding.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Onboarding Checklist</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_totalCompleted/@_totalItems complete
                </BadgeCn>
            </div>
            <div class="mt-1 flex items-center gap-2">
                <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Sarah Chen — Software Engineer</span>
            </div>
        </div>

        @* Sections *@
        <div>
            @for (int si = 0; si < _sections.Length; si++)
            {
                var sec = _sections[si];
                var sIdx = si;
                var isExpanded = _expandedSections.Contains(sec.Id);
                var progress = GetSectionProgress(sec);
                var isLastSection = sIdx == _sections.Length - 1;
                <div class="@(isLastSection && !isExpanded ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => ToggleSection(sec.Id))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right" Size="16"
                                      Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        <span class="font-medium text-sm">@sec.Title</span>
                        <span class="ml-auto text-muted-foreground text-xs tabular-nums">@progress%</span>
                    </button>

                    @if (isExpanded)
                    {
                        <div>
                            @for (int ii = 0; ii < sec.Items.Length; ii++)
                            {
                                var item = sec.Items[ii];
                                var iIdx = ii;
                                var isChecked = _checked.Contains(item.Id);
                                var isLastItem = iIdx == sec.Items.Length - 1;
                                var itemId = item.Id;
                                <div class="@(isLastItem && isLastSection ? "" : "border-b")">
                                    <span class="flex w-full cursor-pointer items-center gap-3 px-4 py-2.5 pl-11 transition-colors hover:bg-muted/50"
                                          @onclick="@(() => Toggle(itemId))"
                                          @onkeydown="@((KeyboardEventArgs e) => HandleItemKeyDown(e, itemId))"
                                          role="button"
                                          tabindex="0">
                                        <CheckboxCn Checked="@isChecked"
                                                    CheckedChanged="@((bool _) => Toggle(itemId))" />
                                        <span class="@Cn.Merge("min-w-0 flex-1 text-sm transition-all duration-200", isChecked ? "text-muted-foreground line-through" : "")">
                                            @item.Title
                                        </span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                                            @(item.Assignee == "manager" ? "Manager" : "New hire")
                                        </BadgeCn>
                                        <span class="shrink-0 text-muted-foreground text-xs">@item.DueDate</span>
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record OnboardingItem(string Id, string Title, string Assignee, string DueDate);
    private record OnboardingSection(string Id, string Title, OnboardingItem[] Items);

    private static readonly OnboardingSection[] _sections =
    [
        new("day1", "Day 1",
        [
            new("d1", "Set up email and Slack accounts", "manager", "Day 1"),
            new("d2", "Configure development environment", "new-hire", "Day 1"),
            new("d3", "Complete security training", "new-hire", "Day 1"),
            new("d4", "Review company handbook", "new-hire", "Day 1"),
        ]),
        new("week1", "Week 1",
        [
            new("w1", "Meet with team leads", "manager", "Day 2"),
            new("w2", "Complete codebase walkthrough", "new-hire", "Day 3"),
            new("w3", "Read architecture documentation", "new-hire", "Day 4"),
            new("w4", "Set up local testing suite", "new-hire", "Day 5"),
            new("w5", "Attend sprint planning session", "new-hire", "Day 5"),
        ]),
        new("month1", "Month 1",
        [
            new("m1", "Complete first pull request", "new-hire", "Week 2"),
            new("m2", "Pair program with senior engineer", "new-hire", "Week 2"),
            new("m3", "Present work in team standup", "new-hire", "Week 3"),
            new("m4", "Complete 30-day feedback review", "manager", "Week 4"),
        ]),
    ];

    private HashSet<string> _checked = new HashSet<string> { "d1" };
    private HashSet<string> _expandedSections = new HashSet<string> { "day1", "week1", "month1" };

    private int _totalItems => _sections.Sum(s => s.Items.Length);
    private int _totalCompleted => _checked.Count;

    private int GetSectionProgress(OnboardingSection sec)
    {
        var completed = sec.Items.Count(i => _checked.Contains(i.Id));
        return (int)Math.Round((double)completed / sec.Items.Length * 100);
    }

    private void Toggle(string id)
    {
        if (!_checked.Remove(id))
            _checked.Add(id);
    }

    private void ToggleSection(string id)
    {
        if (!_expandedSections.Remove(id))
            _expandedSections.Add(id);
    }

    private void HandleItemKeyDown(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter" || e.Key == " ") Toggle(id);
    }
}
