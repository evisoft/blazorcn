@* ============================================================
   Block: todo-list-grouped
   Title: TodoListGrouped
   Description: A grouped todo list block for React and Next.js with collapsible category sections, task counts, and chevron expand animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-grouped.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Tasks</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_completedCount of @_tasks.Count done
            </span>
        </div>

        @* Groups *@
        <div>
            @foreach (var grp in _groups)
            {
                var groupName = grp.Name;
                var isExpanded = _expanded.Contains(grp.Name);
                var groupCompleted = grp.Tasks.Count(t => t.Completed);
                <div>
                    @* Group header *@
                    <button type="button"
                            @onclick="@(() => ToggleExpanded(groupName))"
                            aria-expanded="@isExpanded.ToString().ToLower()"
                            class="flex w-full items-center gap-3 border-b px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right"
                                      Size="16"
                                      Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        <span class="flex-1 font-medium text-muted-foreground text-xs uppercase tracking-wide">
                            @grp.Name
                        </span>
                        <span class="text-muted-foreground text-xs tabular-nums">
                            @groupCompleted/@grp.Tasks.Length
                        </span>
                    </button>

                    @* Group tasks *@
                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            @foreach (var task in grp.Tasks)
                            {
                                var taskId = task.Id;
                                <div class="flex w-full items-center gap-3 px-4 py-2.5 pl-11 transition-colors hover:bg-muted/50">
                                    <CheckboxCn Id="@($"grouped-{task.Id}")"
                                                Checked="@task.Completed"
                                                CheckedChanged="@((bool _) => ToggleTask(taskId))" />
                                    <span class="@Cn.Merge("min-w-0 flex-1 cursor-pointer text-sm transition-all duration-200", task.Completed ? "text-muted-foreground line-through" : "text-foreground")"
                                          @onclick="@(() => ToggleTask(taskId))"
                                          @onkeydown="@((KeyboardEventArgs e) => HandleSpanKeyDown(e, taskId))"
                                          role="button"
                                          tabindex="0">
                                        @task.Text
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @_groups.Length groups · @_tasks.Count tasks total
            </span>
        </div>
    </div>
</section>

@code {
    private record TaskItem(string Id, string Text, string Category, bool Completed);

    private record TaskGroup(string Name, TaskItem[] Tasks);

    private static readonly string[] _categoryOrder = ["Development", "Design", "Marketing", "Uncategorized"];

    private List<TaskItem> _tasks =
    [
        new("1", "Implement user authentication flow", "Development", false),
        new("2", "Set up database migrations", "Development", true),
        new("3", "Build REST API endpoints", "Development", false),
        new("4", "Add unit test coverage", "Development", false),
        new("5", "Create component library", "Design", true),
        new("6", "Design onboarding screens", "Design", false),
        new("7", "Update color palette tokens", "Design", false),
        new("8", "Write launch blog post", "Marketing", false),
        new("9", "Prepare social media assets", "Marketing", true),
        new("10", "Set up email drip campaign", "Marketing", false),
        new("11", "Schedule team retrospective", "Uncategorized", false),
        new("12", "Update project README", "Uncategorized", true),
    ];

    private HashSet<string> _expanded = ["Development", "Design"];

    private int _completedCount => _tasks.Count(t => t.Completed);

    private TaskGroup[] _groups => _categoryOrder
        .Select(cat => new TaskGroup(cat, _tasks.Where(t => t.Category == cat).ToArray()))
        .Where(g => g.Tasks.Length > 0)
        .ToArray();

    private void ToggleExpanded(string category)
    {
        if (_expanded.Contains(category))
            _expanded.Remove(category);
        else
            _expanded.Add(category);
    }

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Completed = !_tasks[idx].Completed };
    }

    private void HandleSpanKeyDown(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter" || e.Key == " ") ToggleTask(id);
    }
}
