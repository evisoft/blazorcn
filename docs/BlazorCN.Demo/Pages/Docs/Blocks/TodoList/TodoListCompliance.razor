@* ============================================================
   Block: todo-list-compliance
   Title: TodoListCompliance
   Description: A compliance checklist block for React and Next.js with regulatory framework sections, evidence status tracking, per-framework scores, and audit due dates built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-compliance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Compliance Checklist</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="download" Size="12" Class="size-3" />
                Export
            </ButtonCn>
        </div>

        @* Overall score *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="@($"font-semibold text-2xl tabular-nums {GetOverallColor()}")">@_overallPercent</span>
                <span class="text-muted-foreground text-xs">% overall</span>
            </div>
            <div class="flex flex-1 items-center gap-3">
                <ProgressCn Value="@_overallPercent" Class="h-1.5 flex-1" aria-label="Progress" />
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">@_completedCount/@_totalReqs</span>
        </div>

        @* Frameworks *@
        <div>
            @for (int fi = 0; fi < _frameworks.Length; fi++)
            {
                var fw = _frameworks[fi];
                var isExpanded = _expandedFrameworks.Contains(fw.Id);
                var score = GetFrameworkScore(fw);
                var isLastFramework = fi == _frameworks.Length - 1;
                var fwId = fw.Id;
                <div class="@((isLastFramework && !isExpanded) ? "" : "border-b")">
                    <button type="button" @onclick="@(() => ToggleFramework(fwId))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right" Size="16"
                            Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                        <span class="font-medium text-sm">@fw.Title</span>
                        <div class="ml-auto flex items-center gap-3">
                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                @fw.AuditDate
                            </span>
                            <span class="text-muted-foreground text-xs tabular-nums">@score%</span>
                        </div>
                    </button>

                    @if (isExpanded)
                    {
                        @for (int ri = 0; ri < fw.Requirements.Length; ri++)
                        {
                            var req = fw.Requirements[ri];
                            var isChecked = _checked.Contains(req.Id);
                            var evidence = GetEvidenceConfig(req.EvidenceStatus);
                            var isLastReq = ri == fw.Requirements.Length - 1;
                            var reqId = req.Id;
                            <div class="@((isLastReq && isLastFramework) ? "" : "border-b")">
                                <label for="@($"compliance-{reqId}")"
                                       class="flex w-full cursor-pointer items-center gap-3 px-4 py-2.5 pl-11 transition-colors hover:bg-muted/50">
                                    <CheckboxCn Id="@($"compliance-{reqId}")" Checked="@isChecked" CheckedChanged="@((bool _) => Toggle(reqId))" aria-label="@req.Title" />
                                    <span class="@($"size-1.5 shrink-0 rounded-full {evidence.DotColor}")"></span>
                                    <span class="@($"min-w-0 flex-1 text-sm transition-all duration-200{(isChecked ? " text-muted-foreground line-through" : "")}")">@req.Title</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"shrink-0 font-normal text-xs {evidence.ClassName}")">@evidence.Label</BadgeCn>
                                </label>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum EvidenceStatus { Documented, InProgress, Missing }

    private record ComplianceRequirement(string Id, string Title, EvidenceStatus EvidenceStatus, string DueDate);
    private record ComplianceFramework(string Id, string Title, string AuditDate, ComplianceRequirement[] Requirements);
    private record EvidenceConfig(string Label, string ClassName, string DotColor);

    private static readonly ComplianceFramework[] _frameworks =
    [
        new("gdpr", "GDPR", "Jun 15, 2026",
        [
            new("g1", "Data processing agreements in place", EvidenceStatus.Documented, "May 1, 2026"),
            new("g2", "Right to erasure procedure documented", EvidenceStatus.Documented, "May 1, 2026"),
            new("g3", "Data breach notification process defined", EvidenceStatus.InProgress, "May 15, 2026"),
            new("g4", "Privacy impact assessments completed", EvidenceStatus.InProgress, "May 15, 2026"),
            new("g5", "Consent management system verified", EvidenceStatus.Missing, "Jun 1, 2026"),
        ]),
        new("soc2", "SOC 2", "Jul 20, 2026",
        [
            new("s1", "Access control policies documented", EvidenceStatus.Documented, "Jun 1, 2026"),
            new("s2", "Change management process in place", EvidenceStatus.Documented, "Jun 1, 2026"),
            new("s3", "Incident response plan tested", EvidenceStatus.Documented, "Jun 15, 2026"),
            new("s4", "Vendor risk assessments completed", EvidenceStatus.InProgress, "Jun 15, 2026"),
            new("s5", "Employee security training records", EvidenceStatus.Missing, "Jul 1, 2026"),
            new("s6", "System monitoring alerts configured", EvidenceStatus.Missing, "Jul 1, 2026"),
        ]),
        new("hipaa", "HIPAA", "Sep 10, 2026",
        [
            new("h1", "PHI encryption at rest and in transit", EvidenceStatus.Documented, "Aug 1, 2026"),
            new("h2", "Business associate agreements signed", EvidenceStatus.Documented, "Aug 1, 2026"),
            new("h3", "Minimum necessary access enforced", EvidenceStatus.InProgress, "Aug 15, 2026"),
            new("h4", "Audit trail for PHI access", EvidenceStatus.InProgress, "Aug 15, 2026"),
            new("h5", "Disaster recovery plan for PHI systems", EvidenceStatus.Missing, "Sep 1, 2026"),
        ]),
    ];

    private HashSet<string> _checked = ["g1", "g2", "s1", "s2", "s3", "h1", "h2"];
    private HashSet<string> _expandedFrameworks = ["gdpr", "soc2", "hipaa"];

    private int _totalReqs => _frameworks.Sum(f => f.Requirements.Length);
    private int _completedCount => _checked.Count;
    private int _overallPercent => _totalReqs > 0 ? (int)Math.Round((double)_completedCount / _totalReqs * 100) : 0;

    private string GetOverallColor() => _overallPercent >= 80
        ? "text-emerald-600 dark:text-emerald-400"
        : _overallPercent >= 50
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";

    private int GetFrameworkScore(ComplianceFramework fw)
    {
        var completed = fw.Requirements.Count(r => _checked.Contains(r.Id));
        return fw.Requirements.Length > 0 ? (int)Math.Round((double)completed / fw.Requirements.Length * 100) : 0;
    }

    private EvidenceConfig GetEvidenceConfig(EvidenceStatus status) => status switch
    {
        EvidenceStatus.Documented => new("Documented", "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400", "bg-emerald-500"),
        EvidenceStatus.InProgress => new("In Progress", "bg-amber-500/10 text-amber-600 dark:text-amber-400", "bg-amber-500"),
        EvidenceStatus.Missing => new("Missing", "bg-red-500/10 text-red-600 dark:text-red-400", "bg-red-500"),
        _ => new("", "", ""),
    };

    private void Toggle(string id)
    {
        if (_checked.Contains(id))
            _checked.Remove(id);
        else
            _checked.Add(id);
    }

    private void ToggleFramework(string id)
    {
        if (_expandedFrameworks.Contains(id))
            _expandedFrameworks.Remove(id);
        else
            _expandedFrameworks.Add(id);
    }
}
