@* ============================================================
   Block: todo-list-learning-path
   Title: TodoListLearningPath
   Description: A course progress tracker block for React and Next.js with module sections, lesson checkboxes, duration labels, type badges for video, quiz, and exercise, module progress bars, and streak indicator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-learning-path.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="graduation-cap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Modern React Masterclass</span>
            </div>
            <div class="flex items-center gap-1.5 text-amber-500">
                <LucideIconCn Name="flame" Size="14" Class="size-3.5" />
                <span class="font-medium text-xs tabular-nums">@_streakDays day streak</span>
            </div>
        </div>

        @* Certificate progress *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="min-w-0 flex-1">
                <div class="mb-1.5 flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Certificate progress</span>
                    <span class="font-mono text-xs tabular-nums">@CompletedLessons/@TotalLessons lessons</span>
                </div>
                <ProgressCn Value="@CertificatePercent" Class="h-1.5" />
            </div>
            <span class="font-medium text-xs tabular-nums">@CertificatePercent%</span>
        </div>

        @* Modules *@
        @for (int mi = 0; mi < _modules.Count; mi++)
        {
            var mod = _modules[mi];
            var modIndex = mi;
            var isCollapsed = _collapsed.Contains(mod.Id);
            var modCompleted = mod.Lessons.Count(l => l.Completed);
            var modPercent = mod.Lessons.Length == 0 ? 0 : (int)Math.Round((double)modCompleted / mod.Lessons.Length * 100);
            var modId = mod.Id;
            <div>
                <button type="button"
                        @onclick="@(() => ToggleModule(modId))"
                        class="flex w-full items-center gap-2 border-b bg-muted/30 px-4 py-2 text-left transition-colors hover:bg-muted/50">
                    <LucideIconCn Name="chevron-right"
                                  Size="14"
                                  Class="@Cn.Merge("size-3.5 text-muted-foreground/60 transition-transform duration-200", isCollapsed ? "" : "rotate-90")" />
                    <span class="min-w-0 flex-1 font-medium text-xs">@mod.Title</span>
                    <span class="text-muted-foreground text-xs tabular-nums">@modCompleted/@mod.Lessons.Length</span>
                    <span class="text-muted-foreground text-xs tabular-nums">@modPercent%</span>
                </button>

                @if (!isCollapsed)
                {
                    @foreach (var lesson in mod.Lessons)
                    {
                        var lessonId = lesson.Id;
                        var isLastInMod = lesson.Id == mod.Lessons[^1].Id;
                        var isLastMod = modIndex == _modules.Count - 1;
                        var showBorder = !(isLastInMod && isLastMod);
                        <div class="@Cn.Merge("group flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", showBorder ? "border-b" : "")">
                            <CheckboxCn Id="@($"learn-{lesson.Id}")"
                                        Checked="@lesson.Completed"
                                        CheckedChanged="@((bool _) => ToggleLesson(lessonId))" />
                            @if (lesson.Type == "Video")
                            {
                                <LucideIconCn Name="play-circle" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideIconCn Name="book-open" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                            }
                            <span class="@Cn.Merge("min-w-0 flex-1 text-sm", lesson.Completed ? "text-muted-foreground line-through" : "")">
                                @lesson.Title
                            </span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"text-xs {GetBadgeStyle(lesson.Type)}")">
                                @lesson.Type
                            </BadgeCn>
                            <span class="font-mono text-muted-foreground text-xs tabular-nums">@lesson.Duration</span>
                        </div>
                    }
                }
            </div>
        }
    </div>
</section>

@code {
    private record LessonItem(string Id, string Title, string Duration, string Type, bool Completed);
    private record ModuleItem(string Id, string Title, LessonItem[] Lessons);

    private const int _streakDays = 12;

    private List<ModuleItem> _modules =
    [
        new("m1", "1. Foundations of React",
        [
            new("l1", "What is React?", "8 min", "Video", true),
            new("l2", "JSX and the Virtual DOM", "12 min", "Video", true),
            new("l3", "Components and Props", "15 min", "Video", true),
            new("l4", "Foundations quiz", "5 min", "Quiz", true),
            new("l5", "Build a counter component", "20 min", "Exercise", true),
        ]),
        new("m2", "2. State Management",
        [
            new("l6", "useState and useReducer", "14 min", "Video", true),
            new("l7", "Context API deep dive", "18 min", "Video", true),
            new("l8", "State patterns reading", "10 min", "Reading", true),
            new("l9", "State management quiz", "5 min", "Quiz", false),
            new("l10", "Build a shopping cart", "30 min", "Exercise", false),
        ]),
        new("m3", "3. Server Components & RSC",
        [
            new("l11", "Server vs Client components", "16 min", "Video", false),
            new("l12", "Data fetching patterns", "20 min", "Video", false),
            new("l13", "Streaming and Suspense", "14 min", "Video", false),
            new("l14", "Server Actions", "18 min", "Video", false),
            new("l15", "RSC quiz", "5 min", "Quiz", false),
            new("l16", "Build a data dashboard", "45 min", "Exercise", false),
        ]),
        new("m4", "4. Performance & Deployment",
        [
            new("l17", "React profiling tools", "12 min", "Video", false),
            new("l18", "Code splitting strategies", "10 min", "Reading", false),
            new("l19", "Image and font optimization", "14 min", "Video", false),
            new("l20", "Deploy to Vercel", "25 min", "Exercise", false),
            new("l21", "Final assessment", "15 min", "Quiz", false),
        ]),
    ];

    private HashSet<string> _collapsed = ["m1"];

    private int TotalLessons => _modules.Sum(m => m.Lessons.Length);
    private int CompletedLessons => _modules.Sum(m => m.Lessons.Count(l => l.Completed));
    private int CertificatePercent => TotalLessons == 0 ? 0 : (int)Math.Round((double)CompletedLessons / TotalLessons * 100);

    private static string GetBadgeStyle(string type) => type switch
    {
        "Video" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "Quiz" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "Exercise" => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        "Reading" => "bg-purple-500/10 text-purple-600 dark:text-purple-400",
        _ => ""
    };

    private void ToggleLesson(string lessonId)
    {
        for (int mi = 0; mi < _modules.Count; mi++)
        {
            var mod = _modules[mi];
            var li = Array.FindIndex(mod.Lessons, l => l.Id == lessonId);
            if (li >= 0)
            {
                var newLessons = (LessonItem[])mod.Lessons.Clone();
                newLessons[li] = newLessons[li] with { Completed = !newLessons[li].Completed };
                _modules[mi] = mod with { Lessons = newLessons };
                return;
            }
        }
    }

    private void ToggleModule(string modId)
    {
        if (!_collapsed.Add(modId))
            _collapsed.Remove(modId);
    }
}
