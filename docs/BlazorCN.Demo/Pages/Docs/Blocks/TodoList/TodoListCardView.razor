@* ============================================================
   Block: todo-list-card-view
   Title: TodoListCardView
   Description: A card-based todo list block for React and Next.js with responsive grid layout, priority indicators, and list/card toggle built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-card-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Tasks</span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_completedCount of @_tasks.Count done
                </span>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="@(_view == "list" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1 px-2 text-xs"
                          @onclick="SetListView">
                    <LucideIconCn Name="list" Size="14" Class="size-3.5" />
                    List
                </ButtonCn>
                <ButtonCn Variant="@(_view == "card" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1 px-2 text-xs"
                          @onclick="SetCardView">
                    <LucideIconCn Name="grid" Size="14" Class="size-3.5" />
                    Cards
                </ButtonCn>
            </div>
        </div>

        @* Content — Card view *@
        @if (_view == "card")
        {
            <div class="grid grid-cols-1 gap-3 p-4 sm:grid-cols-2">
                @foreach (var task in _tasks)
                {
                    var taskId = task.Id;
                    <div class="rounded-md border p-3 transition-colors hover:bg-muted/50">
                        <div class="flex items-start gap-2.5">
                            <CheckboxCn Id="@($"card-{task.Id}")"
                                        Checked="@task.Completed"
                                        CheckedChanged="@((bool _) => ToggleTask(taskId))"
                                        Class="mt-0.5" aria-label="@task.Text" />
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("font-medium text-sm transition-all duration-200", task.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                                    @task.Text
                                </span>
                                <div class="mt-2 flex items-center gap-2">
                                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", PriorityDot(task.Priority))"></span>
                                        @task.Priority
                                    </span>
                                    <span class="text-muted-foreground text-xs">·</span>
                                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                        @task.DueDate
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            @* Content — List view *@
            <div>
                @for (int i = 0; i < _tasks.Count; i++)
                {
                    var task = _tasks[i];
                    var isLast = i == _tasks.Count - 1;
                    var taskId = task.Id;
                    <div class="@(isLast ? "" : "border-b")">
                        <div class="flex w-full items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                            <CheckboxCn Id="@($"list-{task.Id}")"
                                        Checked="@task.Completed"
                                        CheckedChanged="@((bool _) => ToggleTask(taskId))" aria-label="@task.Text" />
                            <span class="@Cn.Merge("min-w-0 flex-1 text-sm transition-all duration-200", task.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                                @task.Text
                            </span>
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", PriorityDot(task.Priority))"></span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                                @StatusLabel(task.Status)
                            </BadgeCn>
                            <span class="shrink-0 text-muted-foreground text-xs">@task.DueDate</span>
                        </div>
                    </div>
                }
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_tasks.Count(t => t.Priority == "high") high
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_tasks.Count(t => t.Priority == "medium") medium
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_tasks.Count(t => t.Priority == "low") low
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record TaskItem(string Id, string Text, string Priority, string Status, string DueDate, bool Completed);

    private List<TaskItem> _tasks =
    [
        new("1", "Design landing page mockup",      "high",   "in-progress", "Apr 5", false),
        new("2", "Set up database schema",           "high",   "todo",        "Apr 6", false),
        new("3", "Write API integration tests",      "medium", "done",        "Apr 3", true),
        new("4", "Configure deployment pipeline",    "medium", "in-progress", "Apr 7", false),
        new("5", "Review accessibility audit",       "low",    "todo",        "Apr 8", false),
        new("6", "Update onboarding flow copy",      "high",   "todo",        "Apr 4", false),
        new("7", "Optimize bundle size",             "medium", "done",        "Apr 2", true),
        new("8", "Add analytics tracking events",    "low",    "todo",        "Apr 9", false),
    ];

    private string _view = "card";

    private int _completedCount => _tasks.Count(t => t.Completed);

    private void SetListView() => _view = "list";
    private void SetCardView() => _view = "card";

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
        {
            var t = _tasks[idx];
            _tasks[idx] = t with { Completed = !t.Completed, Status = t.Completed ? "todo" : "done" };
        }
    }

    private static string PriorityDot(string priority) => priority switch
    {
        "high"   => "bg-red-500",
        "medium" => "bg-amber-500",
        "low"    => "bg-blue-500",
        _        => ""
    };

    private static string StatusLabel(string status) => status switch
    {
        "todo"        => "To Do",
        "in-progress" => "In Progress",
        "done"        => "Done",
        _             => status
    };
}
