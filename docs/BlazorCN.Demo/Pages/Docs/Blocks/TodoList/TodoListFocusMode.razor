@* ============================================================
   Block: todo-list-focus-mode
   Title: TodoListFocusMode
   Description: A single-task focus mode todo list block for React and Next.js with prominent active task display, task queue, and progress tracking built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-focus-mode.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="target" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Focus Mode</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_completedCount of @_totalCount complete
            </span>
        </div>

        @* Progress bar *@
        <div class="border-b px-4 py-3">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-foreground transition-all duration-300 ease-out"
                     style="@_progressStyle">
                </div>
            </div>
        </div>

        @* Active task *@
        <div class="border-b px-4 py-8">
            @if (_allDone)
            {
                <div class="flex flex-col items-center gap-2 text-center">
                    <LucideIconCn Name="check-circle-2" Size="32" Class="size-8 text-emerald-500" />
                    <span class="font-medium text-sm">All tasks complete</span>
                    <span class="text-muted-foreground text-xs">@_totalCount tasks finished</span>
                </div>
            }
            else if (_activeTask != null)
            {
                <div class="flex flex-col items-center gap-3 text-center">
                    <span class="text-muted-foreground text-xs">@_activeTask.Context</span>
                    <span class="max-w-md font-medium text-lg">@_activeTask.Text</span>
                    <ButtonCn Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Sm"
                              Class="mt-2 h-8 gap-1.5 text-xs"
                              @onclick="CompleteAndNext">
                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                        Complete &amp; Next
                    </ButtonCn>
                </div>
            }
        </div>

        @* Task queue *@
        <div>
            @for (int i = 0; i < _tasks.Count; i++)
            {
                var task = _tasks[i];
                var capturedIdx = i;
                var isActive = capturedIdx == _activeIndex && !_allDone;
                var isLast = capturedIdx == _tasks.Count - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => JumpTo(capturedIdx))"
                            disabled="@task.Completed"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors", isActive ? "bg-muted/30" : "hover:bg-muted/50", task.Completed ? "opacity-50" : "")">
                        <span class="w-5 shrink-0 text-center font-mono text-muted-foreground text-xs tabular-nums">
                            @(capturedIdx + 1)
                        </span>
                        @if (task.Completed)
                        {
                            <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 shrink-0 text-emerald-500" />
                        }
                        else if (isActive)
                        {
                            <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 shrink-0 text-foreground" />
                        }
                        else
                        {
                            <span class="size-1.5 shrink-0 rounded-full bg-muted-foreground/30"></span>
                        }
                        <span class="@Cn.Merge("min-w-0 flex-1 truncate text-sm", task.Completed ? "text-muted-foreground line-through" : "")">
                            @task.Text
                        </span>
                        <span class="shrink-0 text-muted-foreground text-xs">@task.Context</span>
                    </button>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TaskItem(string Id, string Text, string Context, bool Completed);

    private List<TaskItem> _tasks =
    [
        new("1", "Write the migration script for user profiles", "Backend", false),
        new("2", "Review accessibility audit findings", "Frontend", false),
        new("3", "Update API rate limiting configuration", "Infrastructure", false),
        new("4", "Draft release notes for v2.4", "Documentation", false),
        new("5", "Fix timezone handling in scheduler", "Backend", false),
        new("6", "Implement dark mode for settings page", "Frontend", false),
        new("7", "Set up error tracking for edge functions", "DevOps", false),
        new("8", "Optimize image loading on gallery page", "Performance", false),
    ];

    private int _activeIndex = 0;

    private int _completedCount => _tasks.Count(t => t.Completed);
    private int _totalCount => _tasks.Count;
    private bool _allDone => _completedCount == _totalCount;
    private TaskItem? _activeTask => _activeIndex < _tasks.Count ? _tasks[_activeIndex] : null;
    private string _progressStyle => $"width:{(_totalCount > 0 ? (_completedCount * 100.0 / _totalCount) : 0).ToString("F0")}%";

    private void CompleteAndNext()
    {
        var idx = _activeIndex;
        if (idx < _tasks.Count)
            _tasks[idx] = _tasks[idx] with { Completed = true };

        var nextIncomplete = -1;
        for (int i = idx + 1; i < _tasks.Count; i++)
        {
            if (!_tasks[i].Completed) { nextIncomplete = i; break; }
        }

        if (nextIncomplete != -1)
        {
            _activeIndex = nextIncomplete;
        }
        else
        {
            var firstIncomplete = -1;
            for (int i = 0; i < _tasks.Count; i++)
            {
                if (i != idx && !_tasks[i].Completed) { firstIncomplete = i; break; }
            }
            if (firstIncomplete != -1)
                _activeIndex = firstIncomplete;
        }
    }

    private void JumpTo(int index)
    {
        if (index < _tasks.Count && !_tasks[index].Completed)
            _activeIndex = index;
    }
}
