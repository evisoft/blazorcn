@* ============================================================
   Block: todo-list-burndown
   Title: TodoListBurndown
   Description: A sprint burndown visualization todo list block for React and Next.js with task progress bars, daily breakdown, and point tracking built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-burndown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Sprint header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Sprint 14</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Mar 31 — Apr 4
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">Day 4 of 5</span>
        </div>

        @* Points summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums text-foreground">@RemainingPoints</span>
                <span class="text-muted-foreground text-xs">pts remaining</span>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs tabular-nums">@CompletedPoints of @TotalPoints completed</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="@ProgressBadgeClass">
                @ProgressPercent%
            </BadgeCn>
        </div>

        @* Overall progress bar *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Sprint progress</span>
                <span class="text-muted-foreground text-xs tabular-nums">@ProgressPercent%</span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-foreground" style="@($"width:{ProgressPercent}%")"></div>
            </div>
        </div>

        @* Daily burndown *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Daily burndown</span>
                <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                        Ideal
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-foreground"></span>
                        Actual
                    </span>
                </div>
            </div>
            <div class="space-y-2">
                @foreach (var entry in _dailyBreakdown)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-8 shrink-0 font-mono text-muted-foreground text-xs">@entry.Day</span>
                        <div class="flex-1 space-y-1">
                            <div class="flex items-center gap-2">
                                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-muted-foreground/30" style="@($"width:{(double)entry.IdealRemaining / TotalPoints * 100:F1}%")"></div>
                                </div>
                                <span class="w-6 text-right text-muted-foreground text-[10px] tabular-nums">@entry.IdealRemaining</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-foreground" style="@($"width:{(double)entry.ActualRemaining / TotalPoints * 100:F1}%")"></div>
                                </div>
                                <span class="w-6 text-right text-[10px] tabular-nums">@entry.ActualRemaining</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < _tasks.Count; i++)
            {
                var task = _tasks[i];
                var isLast = i == _tasks.Count - 1;
                var taskId = task.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex w-full items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs"
                                  aria-label="@(task.Completed ? "Mark incomplete" : "Mark complete")"
                                  @onclick="@(() => ToggleTask(taskId))">
                            @if (task.Completed)
                            {
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="circle" Size="16" Class="size-4 text-muted-foreground/40" />
                            }
                        </ButtonCn>
                        <span class="@Cn.Merge("min-w-0 flex-1 text-sm", task.Completed ? "text-muted-foreground line-through" : "font-medium")">
                            @task.Text
                        </span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono font-normal text-xs tabular-nums">
                            @task.Points pts
                        </BadgeCn>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @(_tasks.Count(t => t.Completed)) of @_tasks.Count tasks completed · @RemainingPoints points remaining
            </span>
        </div>
    </div>
</section>

@code {
    private record SprintTask(string Id, string Text, int Points, bool Completed);
    private record DailyProgress(string Day, int IdealRemaining, int ActualRemaining);

    private const int TotalPoints = 40; // 5+3+8+5+8+3+5+3

    private List<SprintTask> _tasks =
    [
        new("1", "Set up authentication middleware",  5, true),
        new("2", "Create user profile API endpoints", 3, true),
        new("3", "Build settings page UI",            8, true),
        new("4", "Implement file upload service",     5, false),
        new("5", "Add notification system",           8, false),
        new("6", "Write E2E tests for checkout",      3, false),
        new("7", "Optimize image loading pipeline",   5, false),
        new("8", "Deploy monitoring dashboards",      3, false),
    ];

    private static readonly DailyProgress[] _dailyBreakdown =
    [
        new("Mon", 33, 36),
        new("Tue", 25, 31),
        new("Wed", 17, 24),
        new("Thu",  8, 24),
        new("Fri",  0, 24),
    ];

    private int CompletedPoints => _tasks.Where(t => t.Completed).Sum(t => t.Points);
    private int RemainingPoints => TotalPoints - CompletedPoints;
    private int ProgressPercent => TotalPoints > 0
        ? (int)Math.Round((double)CompletedPoints / TotalPoints * 100)
        : 0;

    private string ProgressBadgeClass => ProgressPercent >= 80
        ? "ml-auto font-normal text-xs bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
        : ProgressPercent >= 50
            ? "ml-auto font-normal text-xs bg-amber-500/10 text-amber-600 dark:text-amber-400"
            : "ml-auto font-normal text-xs bg-red-500/10 text-red-600 dark:text-red-400";

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx < 0) return;
        var t = _tasks[idx];
        _tasks[idx] = t with { Completed = !t.Completed };
    }
}
