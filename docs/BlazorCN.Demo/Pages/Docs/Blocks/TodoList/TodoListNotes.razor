@* ============================================================
   Block: todo-list-notes
   Title: TodoListNotes
   Description: A todo list block with expandable inline notes for React and Next.js featuring collapsible note previews, editable text areas, and staggered animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sticky-note" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Tasks with Notes</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_completedCount/@_todos.Count done
            </span>
        </div>

        @* Task list *@
        <div>
            @foreach (var t in _todos)
            {
                var todo = t;
                var isExpanded = _expanded == todo.Id;
                var isLast = _todos.IndexOf(todo) == _todos.Count - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex w-full items-start gap-3 px-4 py-3">
                        <span class="mt-0.5 shrink-0">
                            <CheckboxCn Checked="@todo.Completed"
                                        CheckedChanged="@((bool _) => ToggleTodo(todo.Id))" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <button type="button"
                                    class="flex w-full items-center gap-2 text-left"
                                    @onclick="@(() => SetExpanded(todo.Id, isExpanded))">
                                <span class="@Cn.Merge("flex-1 text-sm transition-all duration-200", todo.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                                    @todo.Text
                                </span>
                                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                            </button>
                            @if (!isExpanded && todo.Note.Length > 0)
                            {
                                <p class="mt-1 truncate text-muted-foreground text-xs">@todo.Note</p>
                            }
                            @if (!isExpanded && todo.Note.Length == 0)
                            {
                                <p class="mt-1 truncate text-muted-foreground/50 text-xs italic">Add a note...</p>
                            }
                        </div>
                    </div>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pl-10">
                                <div class="rounded-md bg-muted/30 p-2">
                                    <TextareaCn Value="@todo.Note"
                                                ValueChanged="@((string? v) => UpdateNote(todo.Id, v))"
                                                Placeholder="Add a note..."
                                                Class="min-h-[72px] resize-none border-0 bg-transparent text-sm shadow-none focus-visible:ring-0" />
                                </div>
                                <span class="mt-1 block text-right text-muted-foreground/50 text-xs tabular-nums">
                                    @todo.Note.Length chars
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <span class="text-muted-foreground text-xs tabular-nums">@_todos.Count tasks</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_todos.Count(t => t.Note.Length > 0) with notes
            </span>
        </div>
    </div>
</section>

@code {
    private record TodoItem(string Id, string Text, bool Completed, string Note);

    private string? _expanded = "1";

    private List<TodoItem> _todos =
    [
        new("1", "Draft Q2 product roadmap", false, "Focus on mobile experience improvements and API v2 migration. Check competitor analysis doc for feature gaps."),
        new("2", "Review pull request #847", false, "Authentication refactor — verify session handling edge cases and rate limit middleware. Run load tests before approving."),
        new("3", "Update deployment scripts", true, "Switch from npm to bun for faster CI builds. Update Docker base image to Node 22."),
        new("4", "Prepare sprint retrospective", false, ""),
        new("5", "Fix responsive layout on settings page", false, "Sidebar collapses incorrectly on tablet breakpoint. Check CSS grid template columns at md viewport."),
        new("6", "Write integration tests for checkout flow", false, "Cover Stripe webhook handling, session expiration, and concurrent cart updates. Mock Stripe API responses."),
    ];

    private int _completedCount => _todos.Count(t => t.Completed);

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _todos[idx] = _todos[idx] with { Completed = !_todos[idx].Completed };
    }

    private void UpdateNote(string id, string? value)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _todos[idx] = _todos[idx] with { Note = value ?? string.Empty };
    }

    private void SetExpanded(string id, bool currentlyExpanded)
    {
        _expanded = currentlyExpanded ? null : id;
    }
}
