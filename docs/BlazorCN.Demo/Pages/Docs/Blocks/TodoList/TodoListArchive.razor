@* ============================================================
   Block: todo-list-archive
   Title: TodoListArchive
   Description: A todo list block with archive functionality for React and Next.js featuring active and archived sections, batch archive action, collapsible archive panel, and restore capability built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-archive.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="archive" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Active Tasks</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal tabular-nums">
                    @_active.Count
                </BadgeCn>
            </div>
            @if (CompletedCount > 0)
            {
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" @onclick="ArchiveCompleted">
                    <LucideIconCn Name="archive" Size="12" Class="size-3" />
                    Archive completed (@CompletedCount)
                </ButtonCn>
            }
        </div>

        @* Active task list *@
        <div>
            @for (int i = 0; i < _active.Count; i++)
            {
                var todo = _active[i];
                var isLast = i == _active.Count - 1 && _archived.Count == 0;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex w-full items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <span class="shrink-0">
                            <CheckboxCn Checked="@todo.Completed" CheckedChanged="@((bool v) => ToggleTodo(todo.Id))" aria-label="@todo.Text" />
                        </span>
                        <span class="@Cn.Merge("min-w-0 flex-1 text-sm transition-all duration-200", todo.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                            @todo.Text
                        </span>
                    </div>
                </div>
            }

            @if (_active.Count == 0)
            {
                <div class="px-4 py-8 text-center text-muted-foreground text-sm">
                    All tasks archived
                </div>
            }
        </div>

        @* Archive section *@
        @if (_archived.Count > 0)
        {
            <button type="button"
                    @onclick="@(() => _archiveOpen = !_archiveOpen)"
                    class="flex w-full items-center gap-2 border-t bg-muted/20 px-4 py-3 text-left transition-colors hover:bg-muted/40">
                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _archiveOpen ? "rotate-90" : "")" />
                <LucideIconCn Name="archive" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-sm">Archived</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal tabular-nums">
                    @_archived.Count
                </BadgeCn>
            </button>

            @if (_archiveOpen)
            {
                <div class="overflow-hidden">
                    @for (int i = 0; i < _archived.Count; i++)
                    {
                        var todo = _archived[i];
                        var isLast = i == _archived.Count - 1;
                        <div class="@Cn.Merge("flex w-full items-center gap-3 bg-muted/10 px-4 py-3 transition-colors hover:bg-muted/30", isLast ? "" : "border-b")">
                            <span class="shrink-0 opacity-50">
                                <CheckboxCn Checked="true" Disabled="true" aria-label="@todo.Text" />
                            </span>
                            <span class="min-w-0 flex-1 text-muted-foreground text-sm line-through">
                                @todo.Text
                            </span>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 shrink-0 gap-1 px-2 text-xs text-muted-foreground" @onclick="@(() => RestoreTask(todo.Id))">
                                <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                                Restore
                            </ButtonCn>
                        </div>
                    }
                </div>
            }
        }

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <span class="text-muted-foreground text-xs tabular-nums">@_active.Count active</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="text-muted-foreground text-xs tabular-nums">@_archived.Count archived</span>
        </div>
    </div>
</section>

@code {
    private class TodoItem
    {
        public string Id { get; set; } = "";
        public string Text { get; set; } = "";
        public bool Completed { get; set; }
    }

    private List<TodoItem> _active =
    [
        new() { Id = "1", Text = "Finalize pricing page copy", Completed = false },
        new() { Id = "2", Text = "Add Stripe webhook error handling", Completed = true },
        new() { Id = "3", Text = "Implement dark mode toggle", Completed = false },
        new() { Id = "4", Text = "Write migration scripts for v2 schema", Completed = true },
        new() { Id = "5", Text = "Update README with setup instructions", Completed = false },
        new() { Id = "6", Text = "Optimize image assets for production", Completed = true },
    ];

    private List<TodoItem> _archived =
    [
        new() { Id = "a1", Text = "Set up project repository", Completed = true },
        new() { Id = "a2", Text = "Configure ESLint and Prettier", Completed = true },
        new() { Id = "a3", Text = "Deploy staging environment", Completed = true },
    ];

    private bool _archiveOpen = false;

    private int CompletedCount => _active.Count(t => t.Completed);

    private void ToggleTodo(string id)
    {
        var todo = _active.FirstOrDefault(t => t.Id == id);
        if (todo != null) todo.Completed = !todo.Completed;
    }

    private void ArchiveCompleted()
    {
        var completed = _active.Where(t => t.Completed).ToList();
        _active = _active.Where(t => !t.Completed).ToList();
        _archived = [.. completed, .. _archived];
    }

    private void RestoreTask(string id)
    {
        var task = _archived.FirstOrDefault(t => t.Id == id);
        if (task == null) return;
        _archived = _archived.Where(t => t.Id != id).ToList();
        task.Completed = false;
        _active.Add(task);
    }
}
