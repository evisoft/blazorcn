@* ============================================================
   Block: todo-list-pomodoro
   Title: TodoListPomodoro
   Description: A pomodoro-integrated todo list block for React and Next.js with focus timer, session tracking, and per-task time logging built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-pomodoro.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Timer section *@
        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center gap-3">
                <span class="font-semibold text-4xl tabular-nums">25:00</span>
                <span class="text-muted-foreground text-xs">Focus Session</span>
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Sm"
                              Class="h-8 gap-1.5"
                              @onclick="@(() => _isRunning = !_isRunning)"
                              aria-label="@TimerButtonLabel">
                        @if (_isRunning)
                        {
                            <LucideIconCn Name="pause" Size="14" Class="size-3.5" />
                        }
                        else
                        {
                            <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                        }
                        @(_isRunning ? "Pause" : "Start")
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="h-8 gap-1.5"
                              @onclick="@(() => _isRunning = false)"
                              aria-label="Reset timer">
                        <LucideIconCn Name="rotate-ccw" Size="14" Class="size-3.5" />
                        Reset
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Xs"
                              Class="h-7 text-xs"
                              aria-label="Skip session">
                        <LucideIconCn Name="skip-forward" Size="12" Class="size-3" />
                        Skip
                    </ButtonCn>
                </div>
                @if (_activeTask is not null)
                {
                    <span class="text-muted-foreground text-xs">
                        Working on: <span class="text-foreground">@_activeTask.Text</span>
                    </span>
                }
            </div>
        </div>

        @* Task list *@
        <div>
            @for (int idx = 0; idx < _todos.Count; idx++)
            {
                var todo = _todos[idx];
                var isLast = idx == _todos.Count - 1;
                var isActive = todo.Id == _activeTaskId;
                var todoId = todo.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="@Cn.Merge("group flex w-full items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isActive ? "bg-muted/30" : "")">
                        <span class="flex shrink-0 items-center">
                            <CheckboxCn Checked="@todo.Completed"
                                        CheckedChanged="@((bool _) => ToggleTodo(todoId))" aria-label="@todo.Text" />
                        </span>
                        <div class="min-w-0 flex-1 cursor-pointer"
                             @onclick="@(() => SelectTask(todoId))"
                             @onkeydown="@((KeyboardEventArgs e) => HandleTaskKeyDown(e, todoId))"
                             role="button"
                             tabindex="0"
                             aria-current="@AriaCurrent(isActive)">
                            <span class="@Cn.Merge("text-sm transition-all duration-200", todo.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                                @todo.Text
                            </span>
                        </div>
                        <div class="flex shrink-0 items-center gap-1">
                            @for (int i = 0; i < todo.EstimatedPomodoros; i++)
                            {
                                var dotIdx = i;
                                <span class="@Cn.Merge("size-1.5 rounded-full", dotIdx < todo.Pomodoros ? "bg-foreground" : "bg-muted-foreground/25")"></span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs tabular-nums">
                @_completedPomodoros of @_totalPomodoros pomodoros completed
            </span>
            <span class="text-muted-foreground text-xs">4 sessions today</span>
        </div>
    </div>
</section>

@code {
    private record TodoItem(string Id, string Text, bool Completed, int Pomodoros, int EstimatedPomodoros);

    private List<TodoItem> _todos =
    [
        new("1", "Complete project documentation", false, 2, 4),
        new("2", "Purchase themed blocks from shadcnblocks.com", false, 0, 1),
        new("3", "Review pull request #42", true, 3, 3),
        new("4", "Write API integration tests", false, 1, 3),
        new("5", "Read React documentation", false, 0, 2),
    ];

    private string? _activeTaskId = null;
    private bool _isRunning = false;

    private int _totalPomodoros => _todos.Sum(t => t.EstimatedPomodoros);
    private int _completedPomodoros => _todos.Sum(t => t.Pomodoros);
    private TodoItem? _activeTask => _todos.FirstOrDefault(t => t.Id == _activeTaskId);
    private string TimerButtonLabel => _isRunning ? "Pause timer" : "Start timer";

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _todos[idx] = _todos[idx] with { Completed = !_todos[idx].Completed };
    }

    private void SelectTask(string id)
    {
        _activeTaskId = _activeTaskId == id ? null : id;
        _isRunning = false;
    }

    private void HandleTaskKeyDown(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter" || e.Key == " ") SelectTask(id);
    }

    private static string? AriaCurrent(bool isActive) => isActive ? "true" : null;
}
