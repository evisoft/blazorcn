@* ============================================================
   Block: todo-list-search-filter
   Title: TodoListSearchFilter
   Description: A filterable todo list block for React and Next.js with real-time search, status tabs, and bulk actions for efficient task management built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-search-filter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Search row *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <LucideIconCn Name="search" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <InputCn @bind-Value="_search"
                     Placeholder="Search tasks..."
                     aria-label="Search tasks"
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            @if (!string.IsNullOrEmpty(_search))
            {
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.IconXs"
                          @onclick="@(() => _search = "")"
                          aria-label="Clear search"
                          Class="shrink-0">
                    <LucideIconCn Name="x" Size="14" Class="size-3.5 text-muted-foreground" />
                </ButtonCn>
            }
        </div>

        @* Status filter tabs *@
        <div class="border-b px-4 py-3">
            <div class="inline-flex items-center gap-0.5 rounded-md bg-muted/50 p-0.5">
                @foreach (var filter in _statusFilters)
                {
                    var filterValue = filter.Value;
                    <button type="button"
                            @onclick="@(() => _status = filterValue)"
                            class="@Cn.Merge("inline-flex items-center gap-1.5 rounded-sm px-2.5 py-1 text-xs font-medium transition-all", _status == filter.Value ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                        @filter.Label
                        <span class="@Cn.Merge("tabular-nums", _status == filter.Value ? "text-foreground" : "text-muted-foreground/60")">
                            @StatusCount(filter.Value)
                        </span>
                    </button>
                }
            </div>
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < FilteredTodos.Count; i++)
            {
                var todo = FilteredTodos[i];
                var isLast = i == FilteredTodos.Count - 1;
                var todoId = todo.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <span class="flex w-full cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <CheckboxCn Checked="@todo.Completed"
                                    CheckedChanged="@((bool _) => ToggleTodo(todoId))" />
                        <span class="@Cn.Merge("min-w-0 flex-1 text-sm transition-all duration-200", todo.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                            @todo.Text
                        </span>
                    </span>
                </div>
            }

            @if (FilteredTodos.Count == 0)
            {
                <div class="px-4 py-8 text-center text-muted-foreground text-sm">
                    No tasks found
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs tabular-nums">
                @_activeCount @(_activeCount == 1 ? "item" : "items") left
            </span>
            @if (_completedCount > 0)
            {
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          @onclick="ClearCompleted"
                          Class="h-7 text-xs text-muted-foreground">
                    Clear completed
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record TodoItem(string Id, string Text, bool Completed);
    private record StatusFilter(string Value, string Label);

    private static readonly StatusFilter[] _statusFilters =
    [
        new("all", "All"),
        new("active", "Active"),
        new("completed", "Completed"),
    ];

    private List<TodoItem> _todos =
    [
        new("1", "Complete project documentation", false),
        new("2", "Purchase themed blocks from shadcnblocks.com", false),
        new("3", "Buy groceries for the weekend", true),
        new("4", "Review pull request #42", false),
        new("5", "Read React documentation", true),
        new("6", "Update CI/CD pipeline configuration", false),
        new("7", "Schedule team standup meeting", true),
    ];

    private string _search = "";
    private string _status = "all";

    private int _activeCount => _todos.Count(t => !t.Completed);
    private int _completedCount => _todos.Count(t => t.Completed);

    private List<TodoItem> FilteredTodos =>
        _todos.Where(todo =>
        {
            var matchesSearch = string.IsNullOrEmpty(_search) ||
                todo.Text.Contains(_search, StringComparison.OrdinalIgnoreCase);
            var matchesStatus = _status == "all" ||
                (_status == "active" && !todo.Completed) ||
                (_status == "completed" && todo.Completed);
            return matchesSearch && matchesStatus;
        }).ToList();

    private int StatusCount(string statusValue) => statusValue switch
    {
        "all" => _todos.Count,
        "active" => _activeCount,
        "completed" => _completedCount,
        _ => 0,
    };

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _todos[idx] = _todos[idx] with { Completed = !_todos[idx].Completed };
    }

    private void ClearCompleted()
    {
        _todos.RemoveAll(t => t.Completed);
    }
}
