@* ============================================================
   Block: todo-list-tags
   Title: TodoListTags
   Description: A tag-based todo list block for React and Next.js with filterable tag chips, real-time search, and multi-label task organization built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-tags.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Search header *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <LucideIconCn Name="search" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <InputCn @bind-Value="_search"
                     Placeholder="Search tasks..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" aria-label="Search tasks" />
        </div>

        @* Tag filter row *@
        <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-3">
            <button type="button" @onclick="@(() => _activeTag = null)" aria-pressed="@(_activeTag == null)">
                <BadgeCn Variant="@(_activeTag == null ? BadgeVariant.Default : BadgeVariant.Secondary)"
                         Class="@Cn.Merge("cursor-pointer text-xs font-normal", _activeTag == null ? "bg-foreground text-background hover:bg-foreground/90" : "")">
                    All
                </BadgeCn>
            </button>
            @foreach (var tag in _allTags)
            {
                var t = tag;
                <button type="button" @onclick="@(() => _activeTag = _activeTag == t ? null : t)" aria-pressed="@(_activeTag == t)">
                    <BadgeCn Variant="@(_activeTag == t ? BadgeVariant.Default : BadgeVariant.Secondary)"
                             Class="@Cn.Merge("cursor-pointer text-xs font-normal capitalize", _activeTag == t ? "bg-foreground text-background hover:bg-foreground/90" : "")">
                        @t
                    </BadgeCn>
                </button>
            }
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < FilteredTodos.Count; i++)
            {
                var todo = FilteredTodos[i];
                var isLast = i == FilteredTodos.Count - 1;
                var todoId = todo.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <span class="flex w-full cursor-pointer items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <CheckboxCn Id="@($"tags-todo-{todo.Id}")"
                                    Checked="@todo.Completed"
                                    CheckedChanged="@((bool _) => ToggleTodo(todoId))"
                                    Class="mt-0.5" aria-label="@todo.Text" />
                        <div class="min-w-0 flex-1">
                            <span class="@Cn.Merge("text-sm transition-all duration-200", todo.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                                @todo.Text
                            </span>
                            <div class="mt-1.5 flex flex-wrap items-center gap-1">
                                @foreach (var tag in todo.Tags)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal capitalize">
                                        @tag
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                    </span>
                </div>
            }

            @if (FilteredTodos.Count == 0)
            {
                <div class="px-4 py-8 text-center text-muted-foreground text-sm">
                    No tasks found
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <span class="text-muted-foreground text-xs tabular-nums">
                @FilteredTodos.Count @(FilteredTodos.Count == 1 ? "task" : "tasks")
            </span>
            @if (_activeTag != null)
            {
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span class="text-muted-foreground text-xs capitalize">@_activeTag</span>
            }
        </div>
    </div>
</section>

@code {
    private record TodoItem(string Id, string Text, bool Completed, string[] Tags);

    private static readonly string[] _allTags = ["work", "personal", "documentation", "review", "shopping", "learning"];

    private List<TodoItem> _todos =
    [
        new("1", "Complete project documentation", false, ["work", "documentation"]),
        new("2", "Purchase themed blocks from shadcnblocks.com", false, ["work", "shopping"]),
        new("3", "Buy groceries", true, ["personal", "shopping"]),
        new("4", "Attending performance review meeting", false, ["work", "review"]),
        new("5", "Read React documentation", true, ["learning", "documentation"]),
    ];

    private string? _activeTag = null;
    private string _search = "";

    private List<TodoItem> FilteredTodos =>
        _todos.Where(todo =>
        {
            var matchesTag = _activeTag == null || todo.Tags.Contains(_activeTag);
            var matchesSearch = string.IsNullOrEmpty(_search) || todo.Text.Contains(_search, StringComparison.OrdinalIgnoreCase);
            return matchesTag && matchesSearch;
        }).ToList();

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _todos[idx] = _todos[idx] with { Completed = !_todos[idx].Completed };
    }
}
