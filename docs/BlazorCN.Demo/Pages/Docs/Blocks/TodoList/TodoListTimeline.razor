@* ============================================================
   Block: todo-list-timeline
   Title: TodoListTimeline
   Description: A vertical timeline todo list block for React and Next.js with connected dots, completion tracking, and staggered animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Project Timeline</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_completedCount of @_tasks.Count milestones
            </span>
        </div>

        @* Timeline *@
        <div class="px-4 py-4">
            <div class="relative">
                @* Connecting line *@
                <div class="absolute top-2 bottom-2 left-[7px] w-px bg-border" />

                @* Progress line *@
                <div class="absolute top-2 left-[7px] w-px bg-foreground"
                     style="@($"height:{ProgressLineHeight()}")">
                </div>

                @for (int i = 0; i < _tasks.Count; i++)
                {
                    var task = _tasks[i];
                    var isLast = i == _tasks.Count - 1;
                    var taskId = task.Id;
                    <div class="@Cn.Merge("relative flex gap-3", isLast ? "" : "pb-5")">
                        @* Dot *@
                        <div class="relative z-10 mt-0.5 flex shrink-0 items-center justify-center">
                            @if (task.Completed)
                            {
                                <span class="flex size-[15px] items-center justify-center rounded-full bg-foreground">
                                    <LucideIconCn Name="check" Size="10" Class="size-2.5 text-background" />
                                </span>
                            }
                            else
                            {
                                <span class="size-[15px] rounded-full border-2 border-border bg-card" />
                            }
                        </div>

                        @* Content *@
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm", task.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                                    @task.Text
                                </span>
                                <span class="shrink-0 text-muted-foreground text-xs">@task.Date</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                                @task.Description
                            </p>
                            @if (!task.Completed)
                            {
                                <ButtonCn Variant="ButtonVariant.Ghost"
                                          Size="ButtonSize.Sm"
                                          Class="mt-1 h-6 px-2 text-xs"
                                          @onclick="@(() => ToggleTask(taskId))">
                                    Mark complete
                                </ButtonCn>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-foreground"
                         style="@($"width:{ProgressPercent()}%")">
                    </div>
                </div>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @ProgressPercent()%
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record TaskItem(string Id, string Text, string Description, string Date, bool Completed);

    private List<TaskItem> _tasks =
    [
        new("1", "Project kickoff meeting", "Align on scope, timeline, and team responsibilities", "Mar 28", true),
        new("2", "Finalize design specifications", "Complete wireframes and design tokens for all screens", "Mar 31", true),
        new("3", "Set up development environment", "Configure repositories, CI pipelines, and staging servers", "Apr 1", true),
        new("4", "Implement core API endpoints", "Build authentication, user, and data CRUD endpoints", "Apr 4", false),
        new("5", "Build frontend components", "Create all reusable UI components following the design system", "Apr 8", false),
        new("6", "Integration testing", "End-to-end testing across all critical user flows", "Apr 11", false),
        new("7", "Deploy to production", "Final QA, performance audit, and production deployment", "Apr 14", false),
    ];

    private int _completedCount => _tasks.Count(t => t.Completed);

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Completed = !_tasks[idx].Completed };
    }

    private int ProgressPercent()
    {
        if (_tasks.Count == 0) return 0;
        return (int)Math.Round((_completedCount / (double)_tasks.Count) * 100);
    }

    private string ProgressLineHeight()
    {
        if (_completedCount == 0) return "height:0%";
        var pct = (_completedCount - 1.0) / (_tasks.Count - 1.0) * 100.0;
        return $"height:calc({pct:F4}% + 4px)";
    }
}
