@* ============================================================
   Block: todo-list-full-task
   Title: TodoListFullTask
   Description: An advanced todo list block for React and Next.js with date, priority, reminders, and assignee fields for comprehensive task creation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-full-task.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <h2 class="text-sm font-medium">Tasks</h2>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px]">
                    @_todos.Count tasks
                </BadgeCn>
            </div>
            <div class="mt-2.5 flex items-center gap-1.5">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Xs" Class="h-7 gap-1 text-xs text-muted-foreground">
                    <LucideIconCn Name="funnel" Size="12" Class="size-3" />
                    Filter
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Xs" Class="h-7 gap-1 text-xs text-muted-foreground">
                    <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3" />
                    Sort
                </ButtonCn>
                <div class="ml-auto flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_countHigh
                    </span>
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        @_countMedium
                    </span>
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                        @_countLow
                    </span>
                </div>
            </div>
        </div>

        @* Add task row *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <InputCn @bind-Value="_newTask"
                     @onkeydown="HandleNewTaskKeyDown"
                     Placeholder="Add a new task..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            <div class="flex shrink-0 items-center gap-0.5">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="text-muted-foreground" @onclick="CyclePriority" title="@($"Priority: {PriorityLabel(_newPriority)}")">
                    <span class="@Cn.Merge("size-2 rounded-full", PriorityDotClass(_newPriority))"></span>
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="text-muted-foreground" @onclick="CycleAssignee" title="@($"Assignee: {_assignees[_newAssigneeIndex].Name}")">
                    <LucideIconCn Name="user" Size="12" Class="size-3" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="text-muted-foreground" title="Set due date">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="@Cn.Merge("text-muted-foreground", _newReminder ? "text-amber-500" : "")" @onclick="ToggleReminder" title="@(_newReminder ? "Reminder on" : "Set reminder")">
                    <LucideIconCn Name="bell" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 text-xs" @onclick="AddTodo">
                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                Add
            </ButtonCn>
        </div>

        @* Task list *@
        <div>
            @if (_todos.Count == 0)
            {
                <div class="flex flex-col items-center justify-center py-12 text-center">
                    <LucideIconCn Name="circle" Size="32" Class="size-8 text-muted-foreground/30" />
                    <p class="mt-3 text-sm font-medium">No tasks</p>
                    <p class="mt-1 text-xs text-muted-foreground">Add a task to get started</p>
                </div>
            }
            @for (int i = 0; i < _todos.Count; i++)
            {
                var todo = _todos[i];
                var isLast = i == _todos.Count - 1;
                var todoId = todo.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <span class="flex w-full cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <CheckboxCn Checked="@todo.Completed" CheckedChanged="@((bool _) => ToggleTodo(todoId))" />
                        <span class="@Cn.Merge("min-w-0 flex-1 text-sm", todo.Completed ? "text-muted-foreground line-through" : "")">
                            @todo.Text
                        </span>
                        <div class="flex shrink-0 items-center gap-2.5">
                            <span class="@Cn.Merge("size-1.5 rounded-full", PriorityDotClass(todo.Priority))"
                                  title="@($"{PriorityLabel(todo.Priority)} priority")"></span>
                            <span class="text-xs text-muted-foreground">@todo.DueDate</span>
                            <AvatarCn Class="size-5">
                                <AvatarFallbackCn Class="text-[10px]">@todo.AssigneeInitials</AvatarFallbackCn>
                            </AvatarCn>
                            @if (todo.HasReminder)
                            {
                                <LucideIconCn Name="bell" Size="12" Class="size-3 text-amber-500" />
                            }
                        </div>
                    </span>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t bg-muted/30 px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_activeCount active
                <span class="mx-1.5 text-muted-foreground/40">·</span>
                @_completedCount completed
            </span>
            <span class="text-xs text-muted-foreground">
                @_reminderCount reminders
            </span>
        </div>
    </div>
</section>

@code {
    private enum TodoPriority { High, Medium, Low }

    private record TodoItem(string Id, string Text, bool Completed, TodoPriority Priority, string Assignee, string AssigneeInitials, string DueDate, bool HasReminder);

    private record AssigneeItem(string Name, string Initials);

    private static readonly AssigneeItem[] _assignees =
    [
        new("Alex Morgan", "AM"),
        new("Jordan Lee", "JL"),
        new("Sam Chen", "SC"),
        new("Blake Torres", "BT"),
    ];

    private static readonly TodoPriority[] _priorities = [TodoPriority.High, TodoPriority.Medium, TodoPriority.Low];

    private List<TodoItem> _todos =
    [
        new("1", "Complete project documentation", false, TodoPriority.High, "Alex Morgan", "AM", "Apr 5", true),
        new("2", "Purchase themed blocks from shadcnblocks.com", false, TodoPriority.Medium, "Jordan Lee", "JL", "Apr 8", false),
        new("3", "Buy groceries", true, TodoPriority.Low, "Sam Chen", "SC", "Apr 3", false),
        new("4", "Attend performance review meeting", false, TodoPriority.High, "Alex Morgan", "AM", "Apr 4", true),
        new("5", "Read React documentation", true, TodoPriority.Medium, "Blake Torres", "BT", "Apr 10", false),
    ];

    private string _newTask = "";
    private TodoPriority _newPriority = TodoPriority.Medium;
    private int _newAssigneeIndex = 0;
    private bool _newReminder = false;
    private int _nextId = 6;

    private int _completedCount => _todos.Count(t => t.Completed);
    private int _activeCount => _todos.Count - _completedCount;
    private int _countHigh => _todos.Count(t => t.Priority == TodoPriority.High);
    private int _countMedium => _todos.Count(t => t.Priority == TodoPriority.Medium);
    private int _countLow => _todos.Count(t => t.Priority == TodoPriority.Low);
    private int _reminderCount => _todos.Count(t => t.HasReminder);

    private static string PriorityDotClass(TodoPriority p) => p switch
    {
        TodoPriority.High => "bg-red-500",
        TodoPriority.Medium => "bg-amber-500",
        TodoPriority.Low => "bg-blue-500",
        _ => ""
    };

    private static string PriorityLabel(TodoPriority p) => p switch
    {
        TodoPriority.High => "High",
        TodoPriority.Medium => "Medium",
        TodoPriority.Low => "Low",
        _ => ""
    };

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _todos[idx] = _todos[idx] with { Completed = !_todos[idx].Completed };
    }

    private void AddTodo()
    {
        var trimmed = _newTask.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        var assignee = _assignees[_newAssigneeIndex];
        _todos.Add(new TodoItem(
            _nextId.ToString(),
            trimmed,
            false,
            _newPriority,
            assignee.Name,
            assignee.Initials,
            "Apr 12",
            _newReminder
        ));
        _nextId++;
        _newTask = "";
        _newReminder = false;
    }

    private void CyclePriority()
    {
        var currentIndex = Array.IndexOf(_priorities, _newPriority);
        _newPriority = _priorities[(currentIndex + 1) % _priorities.Length];
    }

    private void CycleAssignee()
    {
        _newAssigneeIndex = (_newAssigneeIndex + 1) % _assignees.Length;
    }

    private void ToggleReminder()
    {
        _newReminder = !_newReminder;
    }

    private void HandleNewTaskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTodo();
    }
}
