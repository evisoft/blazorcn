@* ============================================================
   Block: todo-list-dependencies
   Title: TodoListDependencies
   Description: A todo list block with task dependency visualization for React and Next.js featuring blocked task indicators, lock icons, dependency chains, and auto-unlock behavior built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-dependencies.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="git-branch" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Task Dependencies</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @BlockedCount blocked
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @CompletedCount done
                </span>
            </div>
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < _todos.Count; i++)
            {
                var todo = _todos[i];
                var todoId = todo.Id;
                var blocked = IsBlocked(todo);
                var blockerName = GetBlockerName(todo.BlockedBy);
                var blockerDone = todo.BlockedBy != null && (_todos.FirstOrDefault(t => t.Id == todo.BlockedBy)?.Completed ?? false);
                var isLast = i == _todos.Count - 1;
                <div class="@Cn.Merge(isLast ? "" : "border-b", blocked ? "opacity-60" : "")">
                    <div class="flex w-full items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <span class="mt-0.5 shrink-0">
                            <CheckboxCn Checked="@todo.Completed" CheckedChanged="@((bool v) => ToggleTodo(todoId))" Disabled="@blocked" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("text-sm transition-all duration-200", todo.Completed ? "text-muted-foreground line-through" : blocked ? "text-muted-foreground" : "text-foreground")">
                                    @todo.Text
                                </span>
                            </div>
                            @if (todo.BlockedBy != null && blockerName != null)
                            {
                                <div class="mt-1 flex items-center gap-1.5">
                                    @if (blocked)
                                    {
                                        <LucideIconCn Name="lock" Size="12" Class="size-3 text-red-500" />
                                    }
                                    else if (blockerDone)
                                    {
                                        <LucideIconCn Name="unlock" Size="12" Class="size-3 text-emerald-500" />
                                    }
                                    <span class="@Cn.Merge("text-xs", blocked ? "text-red-500 dark:text-red-400" : "text-emerald-600 dark:text-emerald-400")">
                                        @(blocked ? "Blocked by:" : "Unblocked:")
                                    </span>
                                    <span class="@Cn.Merge("text-xs", blocked ? "text-red-500/80 dark:text-red-400/80" : "text-emerald-600/80 line-through dark:text-emerald-400/80")">
                                        @blockerName
                                    </span>
                                </div>
                            }
                        </div>
                        @if (todo.Completed)
                        {
                            <LucideIconCn Name="check-circle-2" Size="16" Class="mt-0.5 size-4 shrink-0 text-emerald-500" />
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <span class="text-muted-foreground text-xs tabular-nums">@_todos.Count tasks</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="text-muted-foreground text-xs">
                Complete blocking tasks to unlock dependents
            </span>
        </div>
    </div>
</section>

@code {
    private record TodoItem(string Id, string Text, bool Completed, string? BlockedBy);

    private List<TodoItem> _todos =
    [
        new("1", "Set up CI/CD pipeline",             false, null),
        new("2", "Configure staging environment",      false, "1"),
        new("3", "Write database migration scripts",   false, null),
        new("4", "Deploy schema to staging",           false, "3"),
        new("5", "Run integration test suite",         false, "2"),
        new("6", "Performance load testing",           false, "5"),
        new("7", "Update API documentation",           true,  null),
        new("8", "Security audit and pen testing",     false, "5"),
    ];

    private bool IsBlocked(TodoItem todo)
    {
        if (todo.BlockedBy == null) return false;
        var blocker = _todos.FirstOrDefault(t => t.Id == todo.BlockedBy);
        return blocker != null && !blocker.Completed;
    }

    private string? GetBlockerName(string? blockedBy)
    {
        if (blockedBy == null) return null;
        return _todos.FirstOrDefault(t => t.Id == blockedBy)?.Text;
    }

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx < 0) return;
        var todo = _todos[idx];
        if (IsBlocked(todo)) return;
        _todos[idx] = todo with { Completed = !todo.Completed };
    }

    private int BlockedCount => _todos.Count(t => IsBlocked(t));
    private int CompletedCount => _todos.Count(t => t.Completed);
}
