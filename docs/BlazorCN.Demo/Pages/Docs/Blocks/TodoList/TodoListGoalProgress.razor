@* ============================================================
   Block: todo-list-goal-progress
   Title: TodoListGoalProgress
   Description: A goal tracking todo list block for React and Next.js with milestone checkpoints, progress bars, target dates, and overall completion built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-goal-progress.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="flag" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Goal Progress</span>
            </div>
            <span class="text-muted-foreground text-xs">@_goals.Length goals</span>
        </div>

        @* Overall progress *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="font-semibold text-2xl tabular-nums">@OverallProgress%</span>
            <div class="min-w-0 flex-1">
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-foreground transition-all duration-500"
                         style="width: @(OverallProgress)%" />
                </div>
            </div>
            <span class="shrink-0 text-muted-foreground text-xs">Overall</span>
        </div>

        @* Goals list *@
        <div>
            @for (int i = 0; i < _goals.Length; i++)
            {
                var goal = _goals[i];
                var isLast = i == _goals.Length - 1;
                var isExpanded = _expanded == goal.Id;
                var completedMilestones = goal.Milestones.Count(m => m.Completed);
                var goalId = goal.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => ToggleExpanded(goalId))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@goal.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                                    @goal.TargetDate
                                </BadgeCn>
                            </div>
                            @* Progress bar with milestones *@
                            <div class="relative mt-2 h-1.5 w-full overflow-visible rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground transition-all duration-500"
                                     style="width: @(goal.Progress)%" />
                                @foreach (var ms in goal.Milestones)
                                {
                                    <div class="absolute top-1/2 -translate-x-1/2 -translate-y-1/2"
                                         style="left: @(ms.Position)%">
                                        <span class="@Cn.Merge("block size-2.5 rounded-full border-2", ms.Completed ? "border-foreground bg-foreground" : "border-muted-foreground/30 bg-card")"></span>
                                    </div>
                                }
                            </div>
                            <div class="mt-1.5 flex items-center gap-2">
                                <span class="text-muted-foreground text-xs tabular-nums">@goal.Progress%</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs tabular-nums">@completedMilestones of @goal.Milestones.Length milestones</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right"
                                      Size="16"
                                      Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4">
                            <p class="mb-3 text-muted-foreground text-xs">@goal.Description</p>
                            <div class="space-y-1.5">
                                @foreach (var ms in goal.Milestones)
                                {
                                    <div class="flex items-center gap-2">
                                        <span class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full", ms.Completed ? "bg-foreground text-background" : "border border-muted-foreground/30")">
                                            @if (ms.Completed)
                                            {
                                                <LucideIconCn Name="check" Size="10" Class="size-2.5" />
                                            }
                                        </span>
                                        <span class="@Cn.Merge("text-xs", ms.Completed ? "text-muted-foreground line-through" : "")">
                                            @ms.Label
                                        </span>
                                        <span class="text-muted-foreground text-xs tabular-nums">@ms.Position%</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MilestoneItem(string Id, string Label, int Position, bool Completed);
    private record GoalItem(string Id, string Title, string Description, string TargetDate, int Progress, MilestoneItem[] Milestones);

    private static readonly GoalItem[] _goals =
    [
        new("g1", "Launch v2.0 of the product", "Complete redesign, new features, and migration", "Jun 30", 62,
        [
            new("m1", "Design finalized", 20, true),
            new("m2", "Beta release", 50, true),
            new("m3", "Migration tested", 75, false),
            new("m4", "GA release", 100, false),
        ]),
        new("g2", "Grow monthly active users to 10K", "Marketing campaigns, referral program, content strategy", "Sep 15", 45,
        [
            new("m5", "2,500 users", 25, true),
            new("m6", "5,000 users", 50, false),
            new("m7", "7,500 users", 75, false),
            new("m8", "10,000 users", 100, false),
        ]),
        new("g3", "Complete AWS certification", "Study plan, practice exams, and final certification", "May 20", 80,
        [
            new("m9", "Core services", 25, true),
            new("m10", "Architecture patterns", 50, true),
            new("m11", "Practice exams", 75, true),
            new("m12", "Certification exam", 100, false),
        ]),
        new("g4", "Reduce API response time by 40%", "Database optimization, caching layer, CDN setup", "Apr 30", 33,
        [
            new("m13", "Profiling done", 20, true),
            new("m14", "DB optimized", 50, false),
            new("m15", "Cache layer", 80, false),
            new("m16", "Target met", 100, false),
        ]),
    ];

    private string? _expanded = "g1";

    private int OverallProgress => (int)Math.Round(_goals.Average(g => (double)g.Progress));

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
