@* ============================================================
   Block: todo-list-patient-care
   Title: TodoListPatientCare
   Description: A healthcare task list todo list block for React and Next.js with patient rooms, task types, shift indicators, priority levels, and HIPAA compliance notices built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-patient-care.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="heart-pulse" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Patient Tasks</span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_patientCount patients
                </span>
            </div>
            <div class="flex items-center gap-3">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                    <LucideIconCn Name="sun" Size="12" Class="size-3" />
                    Day Shift
                </BadgeCn>
                @if (_overdueCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_overdueCount overdue
                    </span>
                }
            </div>
        </div>

        @* Summary *@
        <div class="flex items-center gap-3 border-b px-4 py-2">
            @foreach (var tt in _taskTypes)
            {
                var ttCount = _items.Count(i => i.TaskType == tt);
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="@GetTaskIconName(tt)" Size="12" Class="size-3" />
                    @tt @ttCount
                </span>
            }
        </div>

        @* Tasks *@
        <div>
            @for (int i = 0; i < _sorted.Count; i++)
            {
                var task = _sorted[i];
                var isLast = i == _sorted.Count - 1;
                var taskId = task.Id;
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <CheckboxCn Checked="@task.Completed"
                                CheckedChanged="@((bool _) => Toggle(taskId))"
                                Class="mt-0.5" />
                    <LucideIconCn Name="@GetTaskIconName(task.TaskType)" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            @if (task.Overdue && !task.Completed)
                            {
                                <span class="size-1.5 shrink-0 rounded-full bg-red-500"></span>
                            }
                            <span class="@Cn.Merge("font-medium text-sm transition-all duration-200", task.Completed ? "text-muted-foreground line-through" : "")">
                                @task.PatientName
                            </span>
                            <span class="font-mono text-muted-foreground text-xs">Rm @task.Room</span>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@task.Description</p>
                        <div class="mt-1 flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Secondary"
                                     Class="@($"font-normal text-xs {GetPriorityStyle(task.Priority)}")">
                                @task.Priority
                            </BadgeCn>
                            <span class="@Cn.Merge("flex items-center gap-1 text-xs", task.Overdue && !task.Completed ? "text-red-600 dark:text-red-400" : "text-muted-foreground")">
                                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                @task.TimeDue
                            </span>
                            <span class="text-muted-foreground text-xs">@task.Nurse</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    @_completedCount/@_items.Count tasks completed
                </span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @(_items.Count - _completedCount) remaining
                </span>
            </div>
            <p class="mt-2 text-muted-foreground text-xs">
                Protected health information. Access restricted to authorized personnel per HIPAA
                regulations.
            </p>
        </div>
    </div>
</section>

@code {
    private enum TaskType { Medication, Vitals, Assessment, Discharge }
    private enum TaskPriority { Stat, Routine }

    private record PatientTask(
        string Id,
        string PatientName,
        string Room,
        TaskType TaskType,
        string Description,
        string TimeDue,
        TaskPriority Priority,
        string Nurse,
        bool Overdue,
        bool Completed
    );

    private static readonly TaskType[] _taskTypes =
    [
        TaskType.Medication, TaskType.Vitals, TaskType.Assessment, TaskType.Discharge,
    ];

    private List<PatientTask> _items =
    [
        new("pt1", "Margaret Wilson",  "204A", TaskType.Medication,  "Administer IV antibiotics — Ceftriaxone 1g",          "Overdue 30 min", TaskPriority.Stat,    "RN Garcia",   true,  false),
        new("pt2", "Robert Chen",      "208B", TaskType.Vitals,      "Q4H vital signs check",                               "Due now",        TaskPriority.Routine, "RN Garcia",   true,  false),
        new("pt3", "James Patterson",  "210A", TaskType.Assessment,  "Post-op wound assessment, check drain output",        "10:30 AM",       TaskPriority.Stat,    "RN Thompson", false, false),
        new("pt4", "Dorothy Martinez", "215B", TaskType.Medication,  "PO Metoprolol 25mg with breakfast",                  "8:00 AM",        TaskPriority.Routine, "RN Garcia",   false, true),
        new("pt5", "William Taylor",   "202A", TaskType.Discharge,   "Complete discharge paperwork, patient education",     "11:00 AM",       TaskPriority.Routine, "RN Thompson", false, false),
        new("pt6", "Helen Brooks",     "211A", TaskType.Vitals,      "Blood glucose monitoring — pre-lunch",                "11:30 AM",       TaskPriority.Routine, "RN Davis",    false, false),
        new("pt7", "Frank Nguyen",     "207B", TaskType.Medication,  "SC Heparin 5000 units prophylaxis",                  "12:00 PM",       TaskPriority.Routine, "RN Davis",    false, false),
        new("pt8", "Patricia Adams",   "203A", TaskType.Assessment,  "Fall risk reassessment — Morse scale",               "1:00 PM",        TaskPriority.Routine, "RN Thompson", false, false),
        new("pt9", "George Harris",    "209A", TaskType.Medication,  "IV Morphine 2mg PRN — pain level 7/10",              "Overdue 15 min", TaskPriority.Stat,    "RN Garcia",   true,  false),
    ];

    private List<PatientTask> _sorted = [];

    protected override void OnInitialized()
    {
        RefreshSort();
    }

    private int _overdueCount   => _items.Count(i => i.Overdue && !i.Completed);
    private int _patientCount   => _items.Select(i => i.PatientName).Distinct().Count();
    private int _completedCount => _items.Count(i => i.Completed);

    private void RefreshSort()
    {
        _sorted = _items
            .OrderBy(i => i.Completed)
            .ThenByDescending(i => i.Overdue)
            .ThenBy(i => i.Priority == TaskPriority.Stat ? 0 : 1)
            .ToList();
    }

    private void Toggle(string id)
    {
        var idx = _items.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _items[idx] = _items[idx] with { Completed = !_items[idx].Completed };
        RefreshSort();
    }

    private static string GetTaskIconName(TaskType taskType) => taskType switch
    {
        TaskType.Medication  => "pill",
        TaskType.Vitals      => "activity",
        TaskType.Assessment  => "clipboard",
        TaskType.Discharge   => "log-out",
        _                    => "circle",
    };

    private static string GetPriorityStyle(TaskPriority priority) =>
        priority == TaskPriority.Stat
            ? "bg-red-500/10 text-red-700 dark:text-red-400"
            : "bg-zinc-500/10 text-zinc-700 dark:text-zinc-400";
}
