@* ============================================================
   Block: todo-list-basic
   Title: TodoListBasic
   Description: A basic todo list block for React and Next.js with checkbox completion, add task input, and completion counter built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-basic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Tasks</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_completedCount of @_todos.Count done
            </span>
        </div>

        @* Add task input *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <InputCn @bind-Value="_newTask"
                     @onkeydown="HandleInputKeyDown"
                     Placeholder="Add a task..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" aria-label="Add a task" />
            <ButtonCn Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.IconXs"
                      @onclick="AddTask"
                      Disabled="@(string.IsNullOrWhiteSpace(_newTask))"
                      aria-label="Add task">
                <LucideIconCn Name="plus" Size="16" Class="size-4" />
            </ButtonCn>
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < _todos.Count; i++)
            {
                var todo = _todos[i];
                var isLast = i == _todos.Count - 1;
                var todoId = todo.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="group flex w-full items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <CheckboxCn Id="@($"basic-todo-{todo.Id}")"
                                    Checked="@todo.Completed"
                                    CheckedChanged="@((bool _) => ToggleTodo(todoId))" aria-label="@todo.Text" />
                        <span class="@Cn.Merge("min-w-0 flex-1 cursor-pointer text-sm transition-all duration-200", todo.Completed ? "text-muted-foreground line-through" : "text-foreground")"
                              @onclick="@(() => ToggleTodo(todoId))"
                              @onkeydown="@((KeyboardEventArgs e) => HandleSpanKeyDown(e, todoId))"
                              role="button"
                              tabindex="0">
                            @todo.Text
                        </span>
                        <ButtonCn Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.IconXs"
                                  @onclick="@(() => DeleteTodo(todoId))"
                                  Class="shrink-0 opacity-0 transition-opacity group-hover:opacity-100"
                                  aria-label="@DeleteLabel(todo.Text)">
                            <LucideIconCn Name="trash-2" Size="12" Class="size-3 text-muted-foreground" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @_todos.Count @(_todos.Count == 1 ? "task" : "tasks") total
            </span>
        </div>
    </div>
</section>

@code {
    private record TodoItem(string Id, string Text, bool Completed);

    private int _nextId = 6;

    private List<TodoItem> _todos =
    [
        new("1", "Complete project documentation", false),
        new("2", "Purchase themed blocks from shadcnblocks.com", false),
        new("3", "Buy groceries", true),
        new("4", "Review pull request #42", false),
        new("5", "Read React documentation", true),
    ];

    private string _newTask = "";

    private int _completedCount => _todos.Count(t => t.Completed);

    private void AddTask()
    {
        var trimmed = _newTask.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        _todos.Add(new TodoItem(_nextId.ToString(), trimmed, false));
        _nextId++;
        _newTask = "";
    }

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _todos[idx] = _todos[idx] with { Completed = !_todos[idx].Completed };
    }

    private void DeleteTodo(string id)
    {
        _todos.RemoveAll(t => t.Id == id);
    }

    private void HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTask();
    }

    private void HandleSpanKeyDown(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter" || e.Key == " ") ToggleTodo(id);
    }

    private static string DeleteLabel(string text) => $"Delete {text}";
}
