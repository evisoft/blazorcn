@* ============================================================
   Block: todo-list-accessibility-check
   Title: TodoListAccessibilityCheck
   Description: An accessibility compliance checklist block for React and Next.js with WCAG principles, conformance level badges, pass/fail tracking, and compliance percentage built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-accessibility-check.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="accessibility" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Accessibility Compliance</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="download" Size="12" Class="size-3" />
                Generate Report
            </ButtonCn>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="@($"font-semibold text-2xl tabular-nums {ComplianceColor}")">
                    @CompliancePercent
                </span>
                <span class="text-muted-foreground text-xs">% compliant</span>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @PassedCount/@TotalCriteria criteria passed
            </span>
            <div class="ml-auto flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"font-normal text-xs {LevelColor["A"]}")">
                    Level A
                </BadgeCn>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"font-normal text-xs {LevelColor["AA"]}")">
                    Level AA
                </BadgeCn>
            </div>
        </div>

        @* Principles *@
        <div>
            @for (int pi = 0; pi < _principles.Length; pi++)
            {
                var principle = _principles[pi];
                bool isLastPrinciple = pi == _principles.Length - 1;
                bool isExpanded = _expandedPrinciples.Contains(principle.Id);
                int pCompleted = principle.Criteria.Count(c => _checked.Contains(c.Id));
                var principleId = principle.Id;

                <div class="@(isLastPrinciple && !isExpanded ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => TogglePrinciple(principleId))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right" Size="16"
                                      Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                        <span class="font-medium text-sm">@principle.Title</span>
                        <span class="ml-auto text-muted-foreground text-xs tabular-nums">
                            @pCompleted/@principle.Criteria.Length
                        </span>
                    </button>

                    @if (isExpanded)
                    {
                        for (int ci = 0; ci < principle.Criteria.Length; ci++)
                        {
                            var criterion = principle.Criteria[ci];
                            bool isLastCriterion = ci == principle.Criteria.Length - 1;
                            bool isChecked = _checked.Contains(criterion.Id);
                            var criterionId = criterion.Id;

                            <div class="@(isLastCriterion && isLastPrinciple ? "" : "border-b")">
                                <span class="flex w-full cursor-pointer items-center gap-3 px-4 py-2.5 pl-11 transition-colors hover:bg-muted/50"
                                      role="button"
                                      tabindex="0"
                                      @onclick="@(() => Toggle(criterionId))">
                                    <div @onclick:stopPropagation>
                                        <CheckboxCn Value="@isChecked" ValueChanged="@((bool v) => Toggle(criterionId))" />
                                    </div>
                                    <span class="@($"min-w-0 flex-1 text-sm transition-all duration-200{(isChecked ? " text-muted-foreground line-through" : "")}")">
                                        @criterion.Title
                                    </span>
                                    <BadgeCn Variant="BadgeVariant.Secondary"
                                             Class="@($"shrink-0 font-normal text-xs {LevelColor[criterion.Level]}")">
                                        @criterion.Level
                                    </BadgeCn>
                                </span>
                            </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record WcagCriterion(string Id, string Title, string Level);
    private record WcagPrinciple(string Id, string Title, WcagCriterion[] Criteria);

    private static readonly Dictionary<string, string> LevelColor = new()
    {
        ["A"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        ["AA"] = "bg-violet-500/10 text-violet-600 dark:text-violet-400",
        ["AAA"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400",
    };

    private static readonly WcagPrinciple[] _principles =
    [
        new("perceivable", "Perceivable",
        [
            new("p1", "All images have meaningful alt text", "A"),
            new("p2", "Video content has captions", "A"),
            new("p3", "Color is not the only visual means of conveying info", "A"),
            new("p4", "Text color contrast meets 4.5:1 ratio", "AA"),
            new("p5", "Text can be resized to 200% without loss", "AA"),
        ]),
        new("operable", "Operable",
        [
            new("o1", "All functionality available via keyboard", "A"),
            new("o2", "No keyboard traps exist", "A"),
            new("o3", "Focus order is logical and intuitive", "A"),
            new("o4", "Focus indicators are visible", "AA"),
            new("o5", "Skip navigation link provided", "A"),
        ]),
        new("understandable", "Understandable",
        [
            new("u1", "Page language is specified", "A"),
            new("u2", "Form errors identified and described", "A"),
            new("u3", "Labels provided for all form inputs", "A"),
            new("u4", "Navigation is consistent across pages", "AA"),
        ]),
        new("robust", "Robust",
        [
            new("r1", "Valid HTML with no duplicate IDs", "A"),
            new("r2", "ARIA roles and properties used correctly", "A"),
            new("r3", "Status messages announced by screen readers", "AA"),
        ]),
    ];

    private HashSet<string> _checked = ["p1", "p3", "o1", "o2", "u1", "r1"];
    private HashSet<string> _expandedPrinciples = ["perceivable", "operable", "understandable", "robust"];

    private int TotalCriteria => _principles.Sum(p => p.Criteria.Length);
    private int PassedCount => _checked.Count;
    private int CompliancePercent => TotalCriteria == 0 ? 0 : (int)Math.Round((double)PassedCount / TotalCriteria * 100);

    private string ComplianceColor => CompliancePercent >= 90
        ? "text-emerald-600 dark:text-emerald-400"
        : CompliancePercent >= 60
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";

    private void Toggle(string id)
    {
        if (_checked.Contains(id))
            _checked.Remove(id);
        else
            _checked.Add(id);
    }

    private void TogglePrinciple(string id)
    {
        if (_expandedPrinciples.Contains(id))
            _expandedPrinciples.Remove(id);
        else
            _expandedPrinciples.Add(id);
    }
}
