@* ============================================================
   Block: todo-list-estimation
   Title: TodoListEstimation
   Description: A todo list block with Fibonacci story point estimation for React and Next.js featuring point selectors, velocity indicators, color-coded sizing, and total point summaries built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-estimation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Story Points</span>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5">
                    <span class="text-muted-foreground text-xs">Total</span>
                    <span class="font-semibold text-sm tabular-nums">@TotalPoints</span>
                </div>
                <span class="text-muted-foreground/40">|</span>
                <div class="flex items-center gap-1.5">
                    <span class="text-muted-foreground text-xs">Done</span>
                    <span class="font-semibold text-emerald-600 text-sm tabular-nums dark:text-emerald-400">
                        @CompletedPoints
                    </span>
                </div>
                <span class="text-muted-foreground/40">|</span>
                <div class="flex items-center gap-1.5">
                    <span class="text-muted-foreground text-xs">Left</span>
                    <span class="font-semibold text-sm tabular-nums">@RemainingPoints</span>
                </div>
            </div>
        </div>

        @* Progress bar *@
        <div class="border-b px-4 py-2">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-emerald-500" style="@($"width:{ProgressPercent:F1}%")"></div>
            </div>
        </div>

        @* Task list *@
        <div class="divide-y">
            @foreach (var todo in SortedTodos)
            {
                var item = todo;
                var todoId = item.Id;
                <div class="transition-colors hover:bg-muted/50">
                    <div class="flex w-full items-center gap-3 px-4 py-3">
                        <span class="shrink-0">
                            <CheckboxCn Checked="@item.Completed"
                                        CheckedChanged="@((bool _) => ToggleTodo(todoId))" aria-label="@item.Text" />
                        </span>
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", PointColor(item.Points))"></span>
                        <span class="@Cn.Merge("min-w-0 flex-1 text-sm transition-all duration-200", item.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                            @item.Text
                        </span>
                        <div class="flex shrink-0 items-center gap-0.5">
                            @foreach (var p in _pointOptions)
                            {
                                var pt = p;
                                <ButtonCn Variant="@(item.Points == pt ? ButtonVariant.Default : ButtonVariant.Ghost)"
                                          Size="ButtonSize.Sm"
                                          Class="@Cn.Merge("h-6 w-7 px-0 text-xs tabular-nums", item.Points == pt ? "bg-foreground text-background hover:bg-foreground/90" : "text-muted-foreground")"
                                          @onclick="@(() => SetPoints(todoId, pt))">
                                    @pt
                                </ButtonCn>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center gap-3 border-t px-4 py-3">
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                1-3 pts
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-amber-500"></span>5 pts
            </span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                8-13 pts
            </span>
        </div>
    </div>
</section>

@code {
    private record TodoItem(string Id, string Text, int Points, bool Completed);

    private static readonly int[] _pointOptions = [1, 2, 3, 5, 8, 13];

    private List<TodoItem> _todos =
    [
        new("1", "Migrate database to PostgreSQL 16",     13, false),
        new("2", "Implement WebSocket real-time sync",     8, false),
        new("3", "Add multi-tenancy to user model",        8, false),
        new("4", "Build CSV export for analytics",         5, true),
        new("5", "Create role-based access control",       5, false),
        new("6", "Add email notification preferences",     3, false),
        new("7", "Fix timezone handling in scheduler",     3, true),
        new("8", "Update error boundary components",       2, false),
        new("9", "Add loading skeletons to dashboard",     1, false),
    ];

    private IEnumerable<TodoItem> SortedTodos => _todos.OrderByDescending(t => t.Points);

    private int TotalPoints => _todos.Sum(t => t.Points);
    private int CompletedPoints => _todos.Where(t => t.Completed).Sum(t => t.Points);
    private int RemainingPoints => TotalPoints - CompletedPoints;
    private double ProgressPercent => TotalPoints > 0 ? (double)CompletedPoints / TotalPoints * 100 : 0;

    private static string PointColor(int p)
    {
        if (p <= 3) return "bg-emerald-500";
        if (p == 5) return "bg-amber-500";
        return "bg-red-500";
    }

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx < 0) return;
        var t = _todos[idx];
        _todos[idx] = t with { Completed = !t.Completed };
    }

    private void SetPoints(string id, int points)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx < 0) return;
        var t = _todos[idx];
        _todos[idx] = t with { Points = points };
    }
}
