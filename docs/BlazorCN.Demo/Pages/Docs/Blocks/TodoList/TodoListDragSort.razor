@* ============================================================
   Block: todo-list-drag-sort
   Title: TodoListDragSort
   Description: A reorderable todo list block for React and Next.js with manual sorting controls, completion tracking, and smooth layout animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-drag-sort.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Tasks</span>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs">Drag to reorder</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_todos.Count @(_todos.Count == 1 ? "task" : "tasks")
                </span>
            </div>
        </div>

        @* Add task input *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <InputCn @bind-Value="_newTask"
                     @onkeydown="HandleInputKeyDown"
                     Placeholder="Add a task..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" aria-label="Add a task" />
            <ButtonCn Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.IconXs"
                      @onclick="AddTask"
                      Disabled="@(string.IsNullOrWhiteSpace(_newTask))"
                      aria-label="Add task">
                <LucideIconCn Name="plus" Size="16" Class="size-4" />
            </ButtonCn>
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < _todos.Count; i++)
            {
                var todo = _todos[i];
                var idx = i;
                var isFirst = i == 0;
                var isLast = i == _todos.Count - 1;
                var todoId = todo.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="group flex w-full items-center gap-2 px-4 py-3 transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="grip-vertical" Size="16" Class="size-4 shrink-0 text-muted-foreground/40" aria-hidden="true" />
                        <label class="flex min-w-0 flex-1 cursor-pointer items-center gap-3" for="@($"drag-todo-{todo.Id}")">
                            <CheckboxCn Id="@($"drag-todo-{todo.Id}")"
                                        Checked="@todo.Completed"
                                        CheckedChanged="@((bool _) => ToggleTodo(todoId))" />
                            <span class="@Cn.Merge("min-w-0 flex-1 truncate text-sm transition-all duration-200", todo.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                                @todo.Text
                            </span>
                        </label>
                        <div class="flex shrink-0 items-center gap-0.5">
                            <ButtonCn Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.Icon"
                                      Class="h-6 w-6 p-0"
                                      @onclick="@(() => MoveUp(idx))"
                                      Disabled="@isFirst"
                                      aria-label="@MoveUpLabel(todo.Text)">
                                <LucideIconCn Name="arrow-up" Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground", isFirst ? "opacity-30" : "")" />
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.Icon"
                                      Class="h-6 w-6 p-0"
                                      @onclick="@(() => MoveDown(idx))"
                                      Disabled="@isLast"
                                      aria-label="@MoveDownLabel(todo.Text)">
                                <LucideIconCn Name="arrow-down" Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground", isLast ? "opacity-30" : "")" />
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @_todos.Count @(_todos.Count == 1 ? "task" : "tasks") · @_completedCount completed
            </span>
        </div>
    </div>
</section>

@code {
    private record TodoItem(string Id, string Text, bool Completed);

    private int _nextId = 6;

    private List<TodoItem> _todos =
    [
        new("1", "Complete project documentation", false),
        new("2", "Purchase themed blocks from shadcnblocks.com", false),
        new("3", "Buy groceries", true),
        new("4", "Review pull request #42", false),
        new("5", "Read React documentation", false),
    ];

    private string _newTask = "";

    private int _completedCount => _todos.Count(t => t.Completed);

    private void AddTask()
    {
        var trimmed = _newTask.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        _todos.Add(new TodoItem(_nextId.ToString(), trimmed, false));
        _nextId++;
        _newTask = "";
    }

    private void ToggleTodo(string id)
    {
        var i = _todos.FindIndex(t => t.Id == id);
        if (i >= 0)
            _todos[i] = _todos[i] with { Completed = !_todos[i].Completed };
    }

    private void MoveUp(int index)
    {
        if (index == 0) return;
        (_todos[index - 1], _todos[index]) = (_todos[index], _todos[index - 1]);
    }

    private void MoveDown(int index)
    {
        if (index >= _todos.Count - 1) return;
        (_todos[index + 1], _todos[index]) = (_todos[index], _todos[index + 1]);
    }

    private void HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTask();
    }

    private static string MoveUpLabel(string text) => $"Move {text} up";
    private static string MoveDownLabel(string text) => $"Move {text} down";
}
