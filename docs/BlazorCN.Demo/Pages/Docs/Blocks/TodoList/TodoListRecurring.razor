@* ============================================================
   Block: todo-list-recurring
   Title: TodoListRecurring
   Description: A recurring task todo list block for React and Next.js with repeat schedules, streak counters, and next-due indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-recurring.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="repeat" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Recurring Tasks</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_completedCount of @_todos.Count done today
            </span>
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < _todos.Count; i++)
            {
                var todo = _todos[i];
                var isLast = i == _todos.Count - 1;
                var todoId = todo.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="group flex w-full items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <label for="@($"recurring-{todo.Id}")" class="flex min-w-0 flex-1 cursor-pointer items-center gap-3">
                            <CheckboxCn Id="@($"recurring-{todo.Id}")"
                                        Checked="@todo.CompletedToday"
                                        CheckedChanged="@((bool _) => ToggleTodo(todoId))" />
                            <span class="@Cn.Merge("min-w-0 flex-1 text-sm transition-all duration-200", todo.CompletedToday ? "text-muted-foreground line-through" : "text-foreground")">
                                @todo.Text
                            </span>
                        </label>

                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                            @FrequencyLabel(todo.Freq)
                        </BadgeCn>

                        <span class="@Cn.Merge("flex shrink-0 items-center gap-1 text-xs tabular-nums", todo.Streak > 0 ? "text-amber-600 dark:text-amber-400" : "text-muted-foreground")">
                            <LucideIconCn Name="flame" Size="12" Class="size-3" />
                            @todo.Streak
                        </span>

                        <span class="w-16 shrink-0 text-right text-muted-foreground text-xs">
                            @todo.NextDue
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="flame" Size="12" Class="size-3" />
                    @_totalStreak total streak
                </span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_completedCount/@_todos.Count today
                </span>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-primary" style="@($"width:{_progressPercent:F1}%")"></div>
            </div>
        </div>
    </div>
</section>

@code {
    private enum Frequency { Daily, Weekly, Monthly }

    private record RecurringTodo(string Id, string Text, Frequency Freq, bool CompletedToday, int Streak, string NextDue);

    private List<RecurringTodo> _todos =
    [
        new("1", "Review pull requests",       Frequency.Daily,   true,  12, "Tomorrow"),
        new("2", "Team standup meeting",        Frequency.Daily,   false,  5, "Today"),
        new("3", "Write weekly report",         Frequency.Weekly,  false,  8, "Friday"),
        new("4", "Update project roadmap",      Frequency.Monthly, false,  3, "Apr 15"),
        new("5", "Backup database",             Frequency.Weekly,  true,  22, "Next Monday"),
        new("6", "Review analytics dashboard",  Frequency.Daily,   false,  0, "Today"),
    ];

    private int _completedCount => _todos.Count(t => t.CompletedToday);
    private int _totalStreak => _todos.Sum(t => t.Streak);
    private double _progressPercent => _todos.Count > 0 ? (_completedCount / (double)_todos.Count) * 100.0 : 0;

    private static string FrequencyLabel(Frequency freq) => freq switch
    {
        Frequency.Daily   => "Daily",
        Frequency.Weekly  => "Weekly",
        Frequency.Monthly => "Monthly",
        _                 => "",
    };

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _todos[idx] = _todos[idx] with { CompletedToday = !_todos[idx].CompletedToday };
    }
}
