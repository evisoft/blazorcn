@* ============================================================
   Block: todo-list-release-notes
   Title: TodoListReleaseNotes
   Description: A release preparation checklist block for React and Next.js with code, documentation, marketing, and operations sections, version tracking, and readiness indicator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-release-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Release Preparation</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-xs", _readinessColor)">
                @_readinessLabel
            </BadgeCn>
        </div>

        @* Version + Date *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="tag" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-mono text-sm">v3.2.0</span>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Target: Apr 10, 2026</span>
            </div>
            <span class="ml-auto text-muted-foreground text-xs tabular-nums">
                @_checked.Count/@_totalItems complete
            </span>
        </div>

        @* Sections *@
        <div>
            @for (int sIndex = 0; sIndex < _sections.Length; sIndex++)
            {
                var sec = _sections[sIndex];
                var isLastSec = sIndex == _sections.Length - 1;
                var isExpanded = _expandedSections.Contains(sec.Id);
                var sCompleted = sec.Items.Count(i => _checked.Contains(i.Id));
                var secId = sec.Id;
                <div class="@((isLastSec && !isExpanded) ? "" : "border-b last:border-b-0")">
                    <button type="button"
                            @onclick="@(() => ToggleSection(secId))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        <span class="font-medium text-sm">@sec.Title</span>
                        <span class="ml-auto text-muted-foreground text-xs tabular-nums">
                            @sCompleted/@sec.Items.Length
                        </span>
                    </button>

                    @if (isExpanded)
                    {
                        @for (int itemIndex = 0; itemIndex < sec.Items.Length; itemIndex++)
                        {
                            var item = sec.Items[itemIndex];
                            var isLastItem = itemIndex == sec.Items.Length - 1;
                            var isChecked = _checked.Contains(item.Id);
                            var itemId = item.Id;
                            <div class="@((isLastItem && isLastSec) ? "" : "border-b")">
                                <label for="@($"release-{itemId}")"
                                       class="flex w-full cursor-pointer items-center gap-3 px-4 py-2.5 pl-11 transition-colors hover:bg-muted/50">
                                    <CheckboxCn Id="@($"release-{itemId}")" Checked="@isChecked" CheckedChanged="@((bool _) => Toggle(itemId))" aria-label="@item.Title" />
                                    <span class="@Cn.Merge("min-w-0 flex-1 text-sm transition-all duration-200", isChecked ? "text-muted-foreground line-through" : "")">
                                        @item.Title
                                    </span>
                                </label>
                            </div>
                        }
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">@_progress% complete</span>
            <ButtonCn Size="ButtonSize.Sm" Disabled="@(_progress < 100)" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="package" Size="12" Class="size-3" />
                Create Release
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ReleaseItem(string Id, string Title);
    private record ReleaseSection(string Id, string Title, ReleaseItem[] Items);

    private static readonly ReleaseSection[] _sections =
    [
        new("code", "Code",
        [
            new("c1", "Merge feature branches"),
            new("c2", "Resolve all merge conflicts"),
            new("c3", "Run full test suite"),
            new("c4", "Fix critical and high bugs"),
            new("c5", "Code review approved"),
        ]),
        new("docs", "Documentation",
        [
            new("d1", "Update API documentation"),
            new("d2", "Write migration guide"),
            new("d3", "Update changelog"),
        ]),
        new("marketing", "Marketing",
        [
            new("m1", "Prepare blog post"),
            new("m2", "Schedule announcement"),
            new("m3", "Update landing page"),
        ]),
        new("ops", "Operations",
        [
            new("o1", "Backup production database"),
            new("o2", "Prepare rollback plan"),
            new("o3", "Notify on-call team"),
            new("o4", "Schedule maintenance window"),
        ]),
    ];

    private HashSet<string> _checked = ["c1", "c2", "c3", "d3"];
    private HashSet<string> _expandedSections = ["code", "docs", "marketing", "ops"];

    private int _totalItems => _sections.Sum(s => s.Items.Length);
    private int _progress => _totalItems == 0 ? 0 : (int)Math.Round((double)_checked.Count / _totalItems * 100);

    private string _readinessLabel => _progress == 100 ? "Ready" : _progress >= 80 ? "Almost Ready" : "Not Ready";

    private string _readinessColor => _progress == 100
        ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
        : _progress >= 80
            ? "bg-amber-500/10 text-amber-600 dark:text-amber-400"
            : "bg-red-500/10 text-red-600 dark:text-red-400";

    private void Toggle(string id)
    {
        if (!_checked.Remove(id))
            _checked.Add(id);
    }

    private void ToggleSection(string id)
    {
        if (!_expandedSections.Remove(id))
            _expandedSections.Add(id);
    }
}
