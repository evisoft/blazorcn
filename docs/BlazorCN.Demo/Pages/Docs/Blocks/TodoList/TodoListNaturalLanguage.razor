@* ============================================================
   Block: todo-list-natural-language
   Title: TodoListNaturalLanguage
   Description: A natural language task input block for React and Next.js with smart text parsing, token preview, date and priority detection built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-natural-language.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Smart Input</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">@_tasks.Count tasks</span>
        </div>

        @* Input area *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <InputCn @bind-Value="_input"
                         @onkeydown="HandleInputKeyDown"
                         Placeholder="@("Try \"Buy groceries tomorrow !high #personal\"")"
                         Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                          Class="h-7 shrink-0 gap-1 text-xs"
                          @onclick="AddTask"
                          Disabled="@(!_parsed.HasContent)">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    Add
                </ButtonCn>
            </div>

            @* Parsed preview *@
            @if (_input.Trim().Length > 0)
            {
                <div class="mt-3 rounded-md bg-muted/50 p-3">
                    <span class="mb-2 block font-medium text-muted-foreground text-xs">
                        Parsed as:
                    </span>
                    <div class="flex flex-wrap items-center gap-2">
                        @if (_parsed.HasContent)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @_parsed.Text
                            </BadgeCn>
                        }
                        @if (_parsed.Date != null)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                @_parsed.Date
                            </BadgeCn>
                        }
                        @if (_parsed.Priority != null)
                        {
                            <BadgeCn Class="@($"font-normal text-xs {_priorityColors[_parsed.Priority]} border-0")">
                                <span class="@($"mr-1 size-1.5 rounded-full {_priorityDots[_parsed.Priority]}")"></span>
                                @_parsed.Priority
                            </BadgeCn>
                        }
                        @foreach (var ptag in _parsed.Tags)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                                <LucideIconCn Name="tag" Size="12" Class="size-3" />
                                @ptag
                            </BadgeCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < _tasks.Count; i++)
            {
                var task = _tasks[i];
                var taskId = task.Id;
                var isLast = i == _tasks.Count - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => ToggleTask(taskId))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @if (task.Priority != null)
                        {
                            <span class="@($"size-2 shrink-0 rounded-full {_priorityDots[task.Priority]}")"></span>
                        }
                        else
                        {
                            <span class="size-2 shrink-0 rounded-full bg-muted-foreground/20"></span>
                        }
                        <div class="min-w-0 flex-1">
                            <span class="@Cn.Merge("text-sm", task.Completed ? "text-muted-foreground line-through" : "font-medium")">
                                @task.Text
                            </span>
                            <div class="mt-1 flex items-center gap-2">
                                @if (task.Date != null)
                                {
                                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                        @task.Date
                                    </span>
                                }
                                @foreach (var tag in task.Tags)
                                {
                                    <span class="text-muted-foreground text-xs">#@tag</span>
                                }
                            </div>
                        </div>
                    </button>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <span class="font-mono text-muted-foreground text-xs">
                Syntax: task text [date] !priority #tag
            </span>
        </div>
    </div>
</section>

@code {
    private record ParsedTask(string Text, string? Date, string? Priority, List<string> Tags)
    {
        public bool HasContent => !string.IsNullOrEmpty(Text);
    }

    private record TaskItem(string Id, string Text, string? Date, string? Priority, List<string> Tags, bool Completed);

    private static readonly Dictionary<string, string> _priorityColors = new()
    {
        ["high"] = "bg-red-500/10 text-red-600 dark:text-red-400",
        ["medium"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        ["low"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
    };

    private static readonly Dictionary<string, string> _priorityDots = new()
    {
        ["high"] = "bg-red-500",
        ["medium"] = "bg-amber-500",
        ["low"] = "bg-blue-500",
    };

    private static readonly Dictionary<string, string> _dateLabels = new()
    {
        ["today"] = "Today",
        ["tomorrow"] = "Tomorrow",
        ["monday"] = "Monday",
        ["tuesday"] = "Tuesday",
        ["wednesday"] = "Wednesday",
        ["thursday"] = "Thursday",
        ["friday"] = "Friday",
        ["next week"] = "Next week",
    };

    private int _nextId = 5;

    private List<TaskItem> _tasks =
    [
        new("1", "Complete project documentation", "Tomorrow", "high", ["work"], false),
        new("2", "Buy groceries", "Today", "medium", ["personal"], false),
        new("3", "Review pull request", "Monday", "high", ["work", "urgent"], true),
        new("4", "Schedule dentist appointment", null, "low", ["personal"], false),
    ];

    private string _input = "Buy milk tomorrow !high #personal";

    private ParsedTask _parsed => ParseInput(_input);

    private ParsedTask ParseInput(string input)
    {
        var text = input.Trim();
        string? date = null;
        string? priority = null;
        var tags = new List<string>();

        var priorityMatch = System.Text.RegularExpressions.Regex.Match(
            text, @"!(high|medium|low)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (priorityMatch.Success)
        {
            priority = priorityMatch.Groups[1].Value.ToLower();
            text = text.Replace(priorityMatch.Value, "").Trim();
        }

        var tagMatches = System.Text.RegularExpressions.Regex.Matches(text, @"#(\w+)");
        foreach (System.Text.RegularExpressions.Match m in tagMatches)
            tags.Add(m.Groups[1].Value);
        foreach (var t in tags)
            text = text.Replace($"#{t}", "").Trim();

        foreach (var kvp in _dateLabels)
        {
            var pattern = $@"\b{System.Text.RegularExpressions.Regex.Escape(kvp.Key)}\b";
            if (System.Text.RegularExpressions.Regex.IsMatch(
                    text, pattern, System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            {
                date = kvp.Value;
                text = System.Text.RegularExpressions.Regex.Replace(
                    text, pattern, "", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();
                break;
            }
        }

        return new ParsedTask(text, date, priority, tags);
    }

    private void AddTask()
    {
        if (!_parsed.HasContent) return;
        _tasks.Add(new TaskItem(
            _nextId.ToString(),
            _parsed.Text,
            _parsed.Date,
            _parsed.Priority,
            _parsed.Tags,
            false
        ));
        _nextId++;
        _input = "";
    }

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Completed = !_tasks[idx].Completed };
    }

    private void HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTask();
    }
}
