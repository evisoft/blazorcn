@* ============================================================
   Block: todo-list-assignee
   Title: TodoListAssignee
   Description: A team-based todo list block for React and Next.js with avatar assignees, member filtering, and per-person task counts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-assignee.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Team Tasks</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">@_todos.Count tasks</span>
        </div>

        @* Member filter row *@
        <div class="flex items-center gap-3 overflow-x-auto border-b px-4 py-3">
            <button type="button" @onclick="@(() => { _activeFilter = null; })"
                class="@Cn.Merge("flex shrink-0 flex-col items-center gap-1 transition-opacity", _activeFilter == null ? "opacity-100" : "opacity-50 hover:opacity-75")">
                <span class="@Cn.Merge("flex size-7 items-center justify-center rounded-full bg-muted text-muted-foreground text-xs", _activeFilter == null ? "ring-2 ring-foreground" : "")">
                    All
                </span>
                <span class="text-muted-foreground text-[10px] tabular-nums">@_todos.Count</span>
            </button>

            @foreach (var mem in _members)
            {
                var member = mem;
                var count = GetTaskCount(member.Id);
                var isActive = _activeFilter == member.Id;
                <button type="button"
                    @onclick="@(() => { _activeFilter = isActive ? null : member.Id; })"
                    class="@Cn.Merge("flex shrink-0 flex-col items-center gap-1 transition-opacity", isActive ? "opacity-100" : (_activeFilter == null ? "opacity-100" : "opacity-50 hover:opacity-75"))">
                    <span class="@Cn.Merge("flex size-7 items-center justify-center rounded-full bg-muted font-medium text-xs", isActive ? "ring-2 ring-foreground" : "")">
                        @member.Initials
                    </span>
                    <span class="text-muted-foreground text-[10px] tabular-nums">@count</span>
                </button>
            }
        </div>

        @* Task list *@
        <div>
            @for (var i = 0; i < FilteredTodos.Count; i++)
            {
                var todo = FilteredTodos[i];
                var isLast = i == FilteredTodos.Count - 1;
                var assignee = GetMember(todo.AssigneeId);
                <div class="@(isLast ? "" : "border-b")">
                    <label for="@($"assignee-todo-{todo.Id}")"
                        class="flex w-full cursor-pointer items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <CheckboxCn id="@($"assignee-todo-{todo.Id}")"
                            Checked="@todo.Completed"
                            CheckedChanged="@((bool v) => ToggleTodo(todo.Id))"
                            aria-label="@($"{todo.Text} assigned to {assignee?.Name}")" />
                        <span class="@Cn.Merge("min-w-0 flex-1 text-sm transition-all duration-200", todo.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                            @todo.Text
                        </span>
                        @if (assignee != null)
                        {
                            <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-[10px] text-muted-foreground"
                                title="@assignee.Name">
                                @assignee.Initials
                            </span>
                        }
                    </label>
                </div>
            }

            @if (!FilteredTodos.Any())
            {
                <div class="px-4 py-8 text-center text-muted-foreground text-xs">
                    No tasks found
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @CompletedCount of @FilteredTodos.Count done@(ActiveMember != null ? $" · {ActiveMember.Name}" : "")
            </span>
        </div>
    </div>
</section>

@code {
    private record TeamMemberItem(string Id, string Name, string Initials);
    private record TodoItem(string Id, string Text, bool Completed, string AssigneeId);

    private static readonly TeamMemberItem[] _members =
    [
        new("am", "Alex Morgan", "AM"),
        new("jl", "Jordan Lee", "JL"),
        new("sc", "Sam Chen", "SC"),
        new("bt", "Blake Torres", "BT"),
    ];

    private List<TodoItem> _todos =
    [
        new("1", "Complete project documentation", false, "am"),
        new("2", "Purchase themed blocks from shadcnblocks.com", false, "jl"),
        new("3", "Buy groceries", true, "sc"),
        new("4", "Review pull request #42", false, "am"),
        new("5", "Read React documentation", true, "bt"),
        new("6", "Deploy staging environment", false, "jl"),
        new("7", "Update CI/CD pipeline", false, "sc"),
    ];

    private string? _activeFilter;

    private List<TodoItem> FilteredTodos => _activeFilter != null
        ? _todos.Where(t => t.AssigneeId == _activeFilter).ToList()
        : _todos;

    private int CompletedCount => FilteredTodos.Count(t => t.Completed);

    private TeamMemberItem? ActiveMember => _activeFilter != null
        ? _members.FirstOrDefault(m => m.Id == _activeFilter)
        : null;

    private int GetTaskCount(string memberId) => _todos.Count(t => t.AssigneeId == memberId);

    private TeamMemberItem? GetMember(string memberId) => _members.FirstOrDefault(m => m.Id == memberId);

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
        {
            _todos[idx] = _todos[idx] with { Completed = !_todos[idx].Completed };
        }
    }
}
