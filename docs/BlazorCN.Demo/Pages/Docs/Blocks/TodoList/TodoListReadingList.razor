@* ============================================================
   Block: todo-list-reading-list
   Title: TodoListReadingList
   Description: A reading tracker block for React and Next.js with currently reading highlight, page progress bars, genre badges, star ratings, and want-to-read queue built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-reading-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Reading List</span>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span>@_currentlyReading.Length reading</span>
                <span class="text-muted-foreground/40">·</span>
                <span>@_wantToRead.Length queued</span>
                <span class="text-muted-foreground/40">·</span>
                <span>@_completed.Length finished</span>
            </div>
        </div>

        @* Currently Reading *@
        <div class="border-b bg-muted/30 px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Currently Reading</span>
        </div>

        @for (int i = 0; i < _currentlyReading.Length; i++)
        {
            var book = _currentlyReading[i];
            var progress = (int)Math.Round((double)book.CurrentPage / book.TotalPages * 100);
            <div class="border-b px-4 py-3">
                <div class="flex items-start justify-between gap-2">
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@book.Title</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@book.Author</p>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs">
                        @book.Genre
                    </BadgeCn>
                </div>
                <div class="mt-2 flex items-center gap-3">
                    <ProgressCn Value="@((double)progress)" Class="h-1.5 flex-1" />
                    <span class="font-mono text-muted-foreground text-xs tabular-nums">
                        @book.CurrentPage/@book.TotalPages
                    </span>
                    <span class="text-muted-foreground text-xs tabular-nums">@(progress)%</span>
                </div>
            </div>
        }

        @* Want to Read *@
        <div class="border-b bg-muted/30 px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Want to Read</span>
        </div>

        @for (int i = 0; i < _wantToRead.Length; i++)
        {
            var book = _wantToRead[i];
            var hasBorder = i < _wantToRead.Length - 1 || _completed.Length > 0;
            <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", hasBorder ? "border-b" : "")">
                <div class="min-w-0 flex-1">
                    <span class="text-sm">@book.Title</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@book.Author</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs">
                    @book.Genre
                </BadgeCn>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                    @(book.TotalPages)p
                </span>
            </div>
        }

        @* Completed *@
        <div class="border-b bg-muted/30 px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Completed</span>
        </div>

        @for (int i = 0; i < _completed.Length; i++)
        {
            var book = _completed[i];
            <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", i < _completed.Length - 1 ? "border-b" : "")">
                <div class="min-w-0 flex-1">
                    <span class="text-muted-foreground text-sm line-through">@book.Title</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@book.Author</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs">
                    @book.Genre
                </BadgeCn>
                @if (book.Rating.HasValue)
                {
                    <div class="flex items-center gap-0.5">
                        @for (int s = 0; s < 5; s++)
                        {
                            var starIdx = s;
                            <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIdx < book.Rating.Value ? "fill-amber-400 text-amber-400" : "text-muted-foreground/30")" />
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record Book(string Id, string Title, string Author, string Genre, int CurrentPage, int TotalPages, string Status, int? Rating = null);

    private static readonly Book[] _books =
    [
        new("1", "Designing Data-Intensive Applications", "Martin Kleppmann", "Engineering", 145, 562, "reading"),
        new("2", "The Pragmatic Programmer", "David Thomas & Andrew Hunt", "Engineering", 352, 352, "completed", 5),
        new("3", "Thinking, Fast and Slow", "Daniel Kahneman", "Psychology", 499, 499, "completed", 4),
        new("4", "Staff Engineer", "Will Larson", "Career", 0, 308, "want-to-read"),
        new("5", "System Design Interview Vol. 2", "Alex Xu", "Engineering", 0, 434, "want-to-read"),
        new("6", "Clean Code", "Robert C. Martin", "Engineering", 431, 431, "completed", 3),
        new("7", "The Manager's Path", "Camille Fournier", "Career", 0, 244, "want-to-read"),
        new("8", "Refactoring", "Martin Fowler", "Engineering", 0, 418, "want-to-read"),
    ];

    private static readonly Book[] _currentlyReading = [.. _books.Where(b => b.Status == "reading")];
    private static readonly Book[] _wantToRead = [.. _books.Where(b => b.Status == "want-to-read")];
    private static readonly Book[] _completed = [.. _books.Where(b => b.Status == "completed")];
}
