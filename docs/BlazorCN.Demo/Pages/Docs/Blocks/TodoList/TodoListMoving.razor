@* ============================================================
   Block: todo-list-moving
   Title: TodoListMoving
   Description: A moving checklist block for React and Next.js with timeline sections from 8 weeks before to after move day, progress per phase, important item alerts, and mover contact info built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-moving.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="truck" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Moving Checklist</span>
            </div>
            <span class="text-muted-foreground text-xs">Move date: May 15</span>
        </div>

        @* Overall progress *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <ProgressCn Value="@((double)_overallPercent)" Class="h-1.5 flex-1" aria-label="Progress" />
            <span class="font-medium text-xs tabular-nums">@_overallPercent%</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_totalCompleted/@_totalTasks done
            </span>
        </div>

        @* Phases *@
        @for (int phaseIndex = 0; phaseIndex < _phases.Count; phaseIndex++)
        {
            var phase = _phases[phaseIndex];
            var isCollapsed = _collapsed.Contains(phase.Name);
            var phaseCompleted = phase.Tasks.Count(t => t.Completed);
            var phasePercent = phase.Tasks.Count > 0 ? (int)Math.Round((double)phaseCompleted / phase.Tasks.Count * 100) : 0;
            var phaseName = phase.Name;
            <div>
                <button type="button"
                        @onclick="@(() => TogglePhase(phaseName))"
                        class="flex w-full items-center gap-2 border-b bg-muted/30 px-4 py-2 text-left transition-colors hover:bg-muted/50">
                    <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground/60 transition-transform duration-200", isCollapsed ? "" : "rotate-90")" />
                    <span class="font-medium text-xs">@phase.Name</span>
                    <span class="text-muted-foreground text-xs tabular-nums">
                        @phaseCompleted/@phase.Tasks.Count
                    </span>
                    <span class="ml-auto text-muted-foreground text-xs tabular-nums">
                        @phasePercent%
                    </span>
                </button>

                @if (!isCollapsed)
                {
                    @for (int taskIndex = 0; taskIndex < phase.Tasks.Count; taskIndex++)
                    {
                        var task = phase.Tasks[taskIndex];
                        var isLast = taskIndex == phase.Tasks.Count - 1;
                        var isLastPhase = phaseIndex == _phases.Count - 1;
                        var showBorder = !(isLast && isLastPhase);
                        var isExpanded = _expanded == task.Id;
                        var taskId = task.Id;
                        var taskNote = task.Note;
                        <div class="@(showBorder ? "border-b" : "")">
                            <div class="flex w-full items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50 cursor-pointer"
                                 @onclick="@(() => ToggleExpand(taskId, taskNote))">
                                <span @onclick:stopPropagation role="presentation">
                                    <CheckboxCn Id="@($"move-{task.Id}")"
                                                Checked="@task.Completed"
                                                CheckedChanged="@((bool _) => ToggleTask(taskId))" aria-label="@task.Name" />
                                </span>
                                <span class="@Cn.Merge("min-w-0 flex-1 text-sm", task.Completed ? "text-muted-foreground line-through" : "")">
                                    @task.Name
                                </span>
                                @if (task.Important)
                                {
                                    <LucideIconCn Name="triangle-alert" Size="14" Class="size-3.5 shrink-0 text-amber-500" />
                                }
                                @if (task.Note != null)
                                {
                                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                                }
                            </div>
                            @if (isExpanded && task.Note != null)
                            {
                                <div class="px-4 pb-3 pl-10">
                                    <p class="rounded-md bg-muted/50 p-2 text-muted-foreground text-xs">
                                        @task.Note
                                    </p>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }

        @* Footer: mover contact *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">Atlas Movers — confirmed</span>
            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                <LucideIconCn Name="phone" Size="12" Class="size-3" />
                (415) 555-0192
            </span>
        </div>
    </div>
</section>

@code {
    private class MovingTask
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public bool Important { get; set; }
        public bool Completed { get; set; }
        public string? Note { get; set; }
    }

    private class MovingPhase
    {
        public string Name { get; set; } = "";
        public List<MovingTask> Tasks { get; set; } = new();
    }

    private List<MovingPhase> _phases = new()
    {
        new() { Name = "8 Weeks Before", Tasks = new() {
            new() { Id = "1", Name = "Research moving companies", Important = false, Completed = true },
            new() { Id = "2", Name = "Get 3 moving quotes", Important = true, Completed = true },
            new() { Id = "3", Name = "Set moving budget", Important = false, Completed = true },
            new() { Id = "4", Name = "Start decluttering room by room", Important = false, Completed = true },
            new() { Id = "5", Name = "Notify landlord of move-out date", Important = true, Completed = true },
        }},
        new() { Name = "4 Weeks Before", Tasks = new() {
            new() { Id = "6", Name = "Book moving company", Important = true, Completed = true, Note = "Confirmed with Atlas Movers — May 15" },
            new() { Id = "7", Name = "Start packing non-essentials", Important = false, Completed = true },
            new() { Id = "8", Name = "File change of address with USPS", Important = true, Completed = false },
            new() { Id = "9", Name = "Transfer medical records", Important = false, Completed = false },
            new() { Id = "10", Name = "Update bank and insurance addresses", Important = true, Completed = false },
            new() { Id = "11", Name = "Arrange school transfers for kids", Important = false, Completed = false },
        }},
        new() { Name = "1 Week Before", Tasks = new() {
            new() { Id = "12", Name = "Confirm moving company details", Important = true, Completed = false, Note = "Call Atlas Movers to confirm time and crew size" },
            new() { Id = "13", Name = "Pack essentials box (meds, docs, chargers)", Important = true, Completed = false },
            new() { Id = "14", Name = "Defrost freezer", Important = false, Completed = false },
            new() { Id = "15", Name = "Disassemble large furniture", Important = false, Completed = false },
            new() { Id = "16", Name = "Schedule utility shutoff at old address", Important = true, Completed = false },
            new() { Id = "17", Name = "Schedule utility startup at new address", Important = true, Completed = false },
        }},
        new() { Name = "Moving Day", Tasks = new() {
            new() { Id = "18", Name = "Do final walkthrough of old place", Important = true, Completed = false },
            new() { Id = "19", Name = "Supervise movers during loading", Important = false, Completed = false },
            new() { Id = "20", Name = "Check all closets, cabinets, garage", Important = false, Completed = false },
            new() { Id = "21", Name = "Hand over keys to landlord/agent", Important = true, Completed = false },
            new() { Id = "22", Name = "Tip movers", Important = false, Completed = false },
        }},
        new() { Name = "After Move", Tasks = new() {
            new() { Id = "23", Name = "Unpack essentials box first", Important = false, Completed = false },
            new() { Id = "24", Name = "Set up internet and cable", Important = false, Completed = false },
            new() { Id = "25", Name = "Update driver's license address", Important = true, Completed = false },
            new() { Id = "26", Name = "Update vehicle registration", Important = true, Completed = false },
            new() { Id = "27", Name = "Register to vote at new address", Important = false, Completed = false },
            new() { Id = "28", Name = "Meet new neighbors", Important = false, Completed = false },
        }},
    };

    private HashSet<string> _collapsed = new();
    private string? _expanded = "6";

    private int _totalTasks => _phases.Sum(p => p.Tasks.Count);
    private int _totalCompleted => _phases.Sum(p => p.Tasks.Count(t => t.Completed));
    private int _overallPercent => _totalTasks > 0 ? (int)Math.Round((double)_totalCompleted / _totalTasks * 100) : 0;

    private void ToggleTask(string taskId)
    {
        foreach (var phase in _phases)
        {
            var task = phase.Tasks.FirstOrDefault(t => t.Id == taskId);
            if (task != null)
            {
                task.Completed = !task.Completed;
                return;
            }
        }
    }

    private void TogglePhase(string phaseName)
    {
        if (_collapsed.Contains(phaseName))
            _collapsed.Remove(phaseName);
        else
            _collapsed.Add(phaseName);
    }

    private void ToggleExpand(string taskId, string? note)
    {
        if (note == null) return;
        _expanded = _expanded == taskId ? null : taskId;
    }
}
