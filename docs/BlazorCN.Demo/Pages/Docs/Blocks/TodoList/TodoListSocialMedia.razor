@* ============================================================
   Block: todo-list-social-media
   Title: TodoListSocialMedia
   Description: A social media post scheduler todo list block for React and Next.js with platform badges, scheduled times, engagement placeholders, and queue management built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-social-media.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="send" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Post Queue</span>
            </div>
            <div class="flex items-center gap-3">
                @foreach (var s in _statusOrder)
                {
                    var sDot = StatusDotClass(s);
                    var sCount = _items.Count(p => p.Status == s);
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@($"size-1.5 rounded-full {sDot}")"></span>
                        @sCount
                    </span>
                }
            </div>
        </div>

        @* Posts *@
        <div>
            @for (int i = 0; i < _items.Count; i++)
            {
                var post = _items[i];
                var capturedId = post.Id;
                var isExpanded = _expanded == post.Id;
                var isLast = i == _items.Count - 1;
                var platformClass = PlatformColorClass(post.Platform);
                var preview = post.Content.Length > 60 ? post.Content.Substring(0, 60) : post.Content;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <CheckboxCn Checked="@post.Completed" CheckedChanged="@((bool _) => Toggle(capturedId))" Class="mt-0.5" aria-label="@preview" />
                        <button type="button" @onclick="@(() => { _expanded = isExpanded ? null : capturedId; })" class="min-w-0 flex-1 text-left">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("font-medium text-sm transition-all duration-200", post.Completed ? "text-muted-foreground line-through" : "")">
                                    @preview...
                                </span>
                            </div>
                            <div class="mt-1 flex items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"font-normal text-xs {platformClass}")">@post.Platform</BadgeCn>
                                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                    @post.ScheduledDate, @post.ScheduledTime
                                </span>
                                @if (post.Status == PostStatus.Published)
                                {
                                    <span class="text-muted-foreground text-xs">·</span>
                                    <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                        @post.Likes likes · @post.Shares shares
                                    </span>
                                }
                            </div>
                        </button>
                        <div class="flex shrink-0 items-center gap-2">
                            <span class="@($"size-1.5 rounded-full {StatusDotClass(post.Status)}")"></span>
                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </div>
                    </div>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-10">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="text-sm leading-relaxed">@post.Content</p>
                            </div>
                            @if (post.Status == PostStatus.Drafted)
                            {
                                <div class="mt-2 flex gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                        Schedule
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @(_items.Count(p => p.Status != PostStatus.Published)) posts pending
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="send" Size="12" Class="size-3" />
                New Post
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private enum Platform { Twitter, LinkedIn, Instagram }
    private enum PostStatus { Drafted, Scheduled, Published }

    private class SocialPost
    {
        public string Id { get; set; } = "";
        public string Content { get; set; } = "";
        public Platform Platform { get; set; }
        public string ScheduledDate { get; set; } = "";
        public string ScheduledTime { get; set; } = "";
        public PostStatus Status { get; set; }
        public int Likes { get; set; }
        public int Shares { get; set; }
        public bool Completed { get; set; }
    }

    // Display order for status header: Drafted, Scheduled, Published
    private static readonly PostStatus[] _statusOrder =
        [PostStatus.Drafted, PostStatus.Scheduled, PostStatus.Published];

    // Items pre-sorted: Scheduled first, then Drafted, then Published (matches TSX sort order)
    private List<SocialPost> _items =
    [
        new() { Id = "p1", Content = "Excited to announce our new API v2 with 3x faster response times and improved developer experience. Check out the migration guide...", Platform = Platform.Twitter,   ScheduledDate = "Apr 5", ScheduledTime = "9:00 AM",  Status = PostStatus.Scheduled, Likes = 0,   Shares = 0,   Completed = false },
        new() { Id = "p2", Content = "We're hiring! Looking for a Senior Frontend Engineer to join our growing team. Remote-friendly, competitive comp, great culture...",   Platform = Platform.LinkedIn,  ScheduledDate = "Apr 5", ScheduledTime = "10:30 AM", Status = PostStatus.Scheduled, Likes = 0,   Shares = 0,   Completed = false },
        new() { Id = "p3", Content = "Behind the scenes at our Q2 planning offsite. The team is fired up about what's coming next. Stay tuned for some big updates...",      Platform = Platform.Instagram, ScheduledDate = "Apr 6", ScheduledTime = "2:00 PM",  Status = PostStatus.Drafted,   Likes = 0,   Shares = 0,   Completed = false },
        new() { Id = "p4", Content = "Quick tip: Use our CLI tool to scaffold components in seconds. Just run `npx create-component` and follow the prompts...",             Platform = Platform.Twitter,   ScheduledDate = "Apr 7", ScheduledTime = "8:00 AM",  Status = PostStatus.Drafted,   Likes = 0,   Shares = 0,   Completed = false },
        new() { Id = "p5", Content = "Case study: How Acme Corp reduced their build times by 60% using our edge deployment infrastructure. Full breakdown inside...",         Platform = Platform.LinkedIn,  ScheduledDate = "Apr 8", ScheduledTime = "11:00 AM", Status = PostStatus.Drafted,   Likes = 0,   Shares = 0,   Completed = false },
        new() { Id = "p8", Content = "New integration alert: Connect your project to Slack, Discord, and Teams in one click. Notifications where your team already works...", Platform = Platform.Instagram, ScheduledDate = "Apr 9", ScheduledTime = "12:00 PM", Status = PostStatus.Drafted,   Likes = 0,   Shares = 0,   Completed = false },
        new() { Id = "p6", Content = "Our March changelog is live! 12 new features, 8 bug fixes, and a complete redesign of the dashboard. Read the full update...",          Platform = Platform.Twitter,   ScheduledDate = "Apr 3", ScheduledTime = "9:00 AM",  Status = PostStatus.Published, Likes = 234, Shares = 48,  Completed = true  },
        new() { Id = "p7", Content = "Proud to share that we've crossed 10,000 active teams on the platform. Thank you to every developer who chose us...",                  Platform = Platform.LinkedIn,  ScheduledDate = "Apr 2", ScheduledTime = "3:00 PM",  Status = PostStatus.Published, Likes = 892, Shares = 156, Completed = true  },
    ];

    private string? _expanded;

    private static string StatusDotClass(PostStatus status) => status switch
    {
        PostStatus.Drafted   => "bg-zinc-400",
        PostStatus.Scheduled => "bg-blue-500",
        PostStatus.Published => "bg-emerald-500",
        _                    => ""
    };

    private static string PlatformColorClass(Platform platform) => platform switch
    {
        Platform.Twitter   => "bg-sky-500/10 text-sky-700 dark:text-sky-400",
        Platform.LinkedIn  => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        Platform.Instagram => "bg-pink-500/10 text-pink-700 dark:text-pink-400",
        _                  => ""
    };

    private void Toggle(string id)
    {
        var item = _items.Find(p => p.Id == id);
        if (item != null) item.Completed = !item.Completed;
    }
}
