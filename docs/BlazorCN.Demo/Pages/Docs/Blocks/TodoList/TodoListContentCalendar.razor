@* ============================================================
   Block: todo-list-content-calendar
   Title: TodoListContentCalendar
   Description: A content planning calendar todo list block for React and Next.js with content type organization, pipeline progress, and publishing status built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-content-calendar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Content Calendar</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_publishedCount/@_items.Count published
            </span>
        </div>

        @* Pipeline Progress *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <ProgressCn Value="@((double)_progress)" Class="h-1.5 flex-1" />
            <div class="flex items-center gap-3">
                @foreach (var s in _statuses)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@($"size-1.5 rounded-full {StatusDotClass(s)}")"></span>
                        @_items.Count(i => i.Status == s)
                    </span>
                }
            </div>
        </div>

        @* Content by Type *@
        @foreach (var contentType in _contentTypes)
        {
            var typeItems = _items.Where(i => i.Type == contentType).ToList();
            @if (typeItems.Count > 0)
            {
                var isExpanded = _expandedType == contentType;
                var capturedType = contentType;
                <div>
                    <button type="button"
                        @onclick="@(() => ToggleType(capturedType))"
                        class="flex w-full items-center gap-2 border-b bg-muted/30 px-4 py-2 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="chevron-right" Size="14" Class="@Cn.Merge("size-3.5 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        <LucideIconCn Name="@TypeIconName(capturedType)" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="font-medium text-xs">@contentType</span>
                        <span class="text-muted-foreground text-xs tabular-nums">@typeItems.Count</span>
                    </button>

                    @if (isExpanded)
                    {
                        @foreach (var item in typeItems)
                        {
                            var capturedId = item.Id;
                            <div class="flex items-center gap-3 border-b px-4 py-2.5 transition-colors hover:bg-muted/50">
                                <CheckboxCn Checked="@item.Completed" CheckedChanged="@((bool v) => Toggle(capturedId))" />
                                <div class="min-w-0 flex-1">
                                    <span class="@Cn.Merge("font-medium text-sm transition-all duration-200", item.Completed ? "text-muted-foreground line-through" : "")">
                                        @item.Title
                                    </span>
                                    <div class="mt-0.5 flex items-center gap-2">
                                        <span class="text-muted-foreground text-xs">@item.PublishDate</span>
                                        <span class="text-muted-foreground text-xs">·</span>
                                        <span class="font-mono text-muted-foreground text-xs">@item.Estimate</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <span class="@($"size-1.5 shrink-0 rounded-full {StatusDotClass(item.Status)}")"></span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        @item.Status
                                    </BadgeCn>
                                </div>
                            </div>
                        }
                    }
                </div>
            }
        }

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @(_items.Count - _publishedCount) items in pipeline
            </span>
            <span class="font-medium text-muted-foreground text-xs tabular-nums">
                @_progress% published
            </span>
        </div>
    </div>
</section>

@code {
    private sealed class ContentItem
    {
        public string Id { get; init; } = "";
        public string Title { get; init; } = "";
        public string Type { get; init; } = "";
        public string PublishDate { get; init; } = "";
        public string Status { get; init; } = "";
        public string Estimate { get; init; } = "";
        public bool Completed { get; set; }
    }

    private static readonly string[] _contentTypes = ["Blog Post", "Social Media", "Newsletter", "Video"];
    private static readonly string[] _statuses = ["Draft", "Review", "Scheduled", "Published"];

    private readonly List<ContentItem> _items =
    [
        new() { Id = "c1",  Title = "2026 Q2 Product Roadmap Recap",        Type = "Blog Post",   PublishDate = "Apr 7",  Status = "Review",    Estimate = "1,800 words", Completed = false },
        new() { Id = "c2",  Title = "Feature launch announcement",           Type = "Social Media", PublishDate = "Apr 5",  Status = "Scheduled", Estimate = "280 chars",   Completed = false },
        new() { Id = "c3",  Title = "Weekly engineering digest #47",         Type = "Newsletter",   PublishDate = "Apr 8",  Status = "Draft",     Estimate = "1,200 words", Completed = false },
        new() { Id = "c4",  Title = "Getting Started tutorial v3",           Type = "Video",        PublishDate = "Apr 10", Status = "Draft",     Estimate = "8 min",       Completed = false },
        new() { Id = "c5",  Title = "Customer success story: Acme Corp",     Type = "Blog Post",   PublishDate = "Apr 3",  Status = "Published", Estimate = "2,400 words", Completed = true  },
        new() { Id = "c6",  Title = "Team culture behind the scenes",        Type = "Social Media", PublishDate = "Apr 4",  Status = "Scheduled", Estimate = "180 chars",   Completed = false },
        new() { Id = "c7",  Title = "March changelog summary",               Type = "Newsletter",   PublishDate = "Apr 1",  Status = "Published", Estimate = "950 words",   Completed = true  },
        new() { Id = "c8",  Title = "API v2 migration walkthrough",          Type = "Video",        PublishDate = "Apr 12", Status = "Draft",     Estimate = "12 min",      Completed = false },
        new() { Id = "c9",  Title = "Accessibility best practices guide",    Type = "Blog Post",   PublishDate = "Apr 14", Status = "Draft",     Estimate = "3,100 words", Completed = false },
        new() { Id = "c10", Title = "Product tip of the week",               Type = "Social Media", PublishDate = "Apr 6",  Status = "Review",    Estimate = "220 chars",   Completed = false },
    ];

    private string? _expandedType = "Blog Post";

    private int _publishedCount => _items.Count(i => i.Status == "Published");
    private int _progress => _items.Count > 0 ? (int)Math.Round((double)_publishedCount / _items.Count * 100) : 0;

    private static string StatusDotClass(string status) => status switch
    {
        "Draft"     => "bg-zinc-400",
        "Review"    => "bg-amber-500",
        "Scheduled" => "bg-blue-500",
        "Published" => "bg-emerald-500",
        _           => ""
    };

    private static string TypeIconName(string type) => type switch
    {
        "Blog Post"    => "book-open",
        "Social Media" => "share",
        "Newsletter"   => "mail",
        "Video"        => "video",
        _              => "file"
    };

    private void Toggle(string id)
    {
        var item = _items.FirstOrDefault(i => i.Id == id);
        if (item is not null) item.Completed = !item.Completed;
    }

    private void ToggleType(string type)
    {
        _expandedType = _expandedType == type ? null : type;
    }
}
