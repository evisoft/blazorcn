@* ============================================================
   Block: todo-list-minimal
   Title: TodoListMinimal
   Description: An ultra-minimal todo list block for React and Next.js with no borders between items, maximum whitespace, and a single bottom input built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-minimal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Tasks - no dividers *@
        <div class="px-4 pt-4 pb-2">
            @foreach (var task in _tasks)
            {
                var taskId = task.Id;
                <div class="rounded-md transition-colors hover:bg-muted/30">
                    <div class="flex items-center gap-3 px-2 py-2.5">
                        <CheckboxCn Id="@($"minimal-{task.Id}")"
                                    Checked="@task.Completed"
                                    CheckedChanged="@((bool _) => ToggleTask(taskId))" />
                        <span class="@Cn.Merge("min-w-0 flex-1 cursor-pointer text-sm transition-all duration-300", task.Completed ? "text-muted-foreground/60 line-through" : "text-foreground")"
                              @onclick="@(() => ToggleTask(taskId))"
                              @onkeydown="@((KeyboardEventArgs e) => HandleSpanKeyDown(e, taskId))"
                              role="button"
                              tabindex="0">
                            @task.Text
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Add task input at bottom *@
        <div class="px-6 pb-4">
            <InputCn @bind-Value="_newTask"
                     @onkeydown="HandleInputKeyDown"
                     Placeholder="Add a task..."
                     Class="h-9 border-0 border-b border-border/50 bg-transparent px-0 shadow-none rounded-none focus-visible:ring-0 focus-visible:border-foreground/30" />
        </div>

        @* Subtle footer *@
        <div class="px-6 pb-4">
            <span class="text-muted-foreground/50 text-xs">
                @_completedCount of @_tasks.Count
            </span>
        </div>
    </div>
</section>

@code {
    private record TaskItem(string Id, string Text, bool Completed);

    private int _nextId = 8;

    private List<TaskItem> _tasks =
    [
        new("1", "Morning meditation", true),
        new("2", "Write project proposal", false),
        new("3", "Review team submissions", false),
        new("4", "Lunch with Alex", false),
        new("5", "Update portfolio website", true),
        new("6", "Read design article", false),
        new("7", "Plan next sprint goals", false),
    ];

    private string _newTask = "";

    private int _completedCount => _tasks.Count(t => t.Completed);

    private void AddTask()
    {
        var trimmed = _newTask.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        _tasks.Add(new TaskItem(_nextId.ToString(), trimmed, false));
        _nextId++;
        _newTask = "";
    }

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Completed = !_tasks[idx].Completed };
    }

    private void HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTask();
    }

    private void HandleSpanKeyDown(KeyboardEventArgs e, string id)
    {
        if (e.Key == "Enter" || e.Key == " ") ToggleTask(id);
    }
}
