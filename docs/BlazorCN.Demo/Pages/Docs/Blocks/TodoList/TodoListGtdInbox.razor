@* ============================================================
   Block: todo-list-gtd-inbox
   Title: TodoListGtdInbox
   Description: A Getting Things Done inbox processing todo list block for React and Next.js with task classification, category counts, and animated card transitions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-gtd-inbox.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="inbox" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">GTD Inbox</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                    @_inbox.Count remaining
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_processed of @_total processed
            </span>
        </div>

        @* Progress bar *@
        <div class="border-b px-4 py-3">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-foreground" style="@ProgressStyle"></div>
            </div>
        </div>

        @* Current task card *@
        <div class="border-b px-4 py-6">
            <div class="flex min-h-[100px] items-center justify-center">
                @if (CurrentTask != null)
                {
                    <div class="w-full">
                        <div class="rounded-md bg-muted/50 p-4">
                            <span class="font-medium text-sm">@CurrentTask.Text</span>
                            <div class="mt-1.5 flex items-center gap-2">
                                <span class="text-muted-foreground text-xs">@CurrentTask.Context</span>
                                <span class="text-muted-foreground text-xs">·</span>
                                <span class="text-muted-foreground text-xs">@CurrentTask.AddedAgo</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center">
                        <span class="font-medium text-sm">Inbox zero</span>
                        <p class="mt-1 text-muted-foreground text-xs">All @_total tasks processed</p>
                    </div>
                }
            </div>
        </div>

        @* Action buttons *@
        @if (CurrentTask != null)
        {
            <div class="flex items-center justify-center gap-2 border-b px-4 py-3">
                @foreach (var cat in _categories)
                {
                    var catKey = cat.Key;
                    <ButtonCn Variant="ButtonVariant.Outline"
                              Size="ButtonSize.Sm"
                              Class="h-8 gap-1.5 text-xs"
                              @onclick="@(() => Classify(catKey))">
                        <LucideIconCn Name="@cat.Icon" Size="14" Class="size-3.5" />
                        @cat.Label
                    </ButtonCn>
                }
            </div>
        }

        @* Category counts *@
        <div class="flex items-center justify-between px-4 py-3">
            @foreach (var cat in _categories)
            {
                <div class="flex items-center gap-1.5">
                    <span class="@Cn.Merge("size-1.5 rounded-full", cat.Dot)"></span>
                    <span class="text-muted-foreground text-xs">@cat.Label</span>
                    <span class="font-medium text-xs tabular-nums">@_counts[cat.Key]</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TaskItem(string Id, string Text, string Context, string AddedAgo);
    private record CategoryConfig(string Key, string Label, string Icon, string Dot, string Description);

    private static readonly CategoryConfig[] _categories =
    [
        new("do-now",   "Do Now",   "zap",     "bg-emerald-500",         "< 2 min"),
        new("defer",    "Defer",    "calendar", "bg-blue-500",            "Schedule"),
        new("delegate", "Delegate", "users",    "bg-amber-500",           "Assign"),
        new("archive",  "Archive",  "archive",  "bg-muted-foreground/40", "Reference"),
    ];

    private static readonly int _total = 8;

    private List<TaskItem> _inbox =
    [
        new("1", "Reply to design review feedback",         "From: Sarah Chen",  "3 min ago"),
        new("2", "Update staging environment variables",    "DevOps channel",    "12 min ago"),
        new("3", "Book team offsite venue",                 "From: Manager",     "1 hr ago"),
        new("4", "Fix typo in landing page headline",       "Bug report #189",   "2 hr ago"),
        new("5", "Review expense report from Q1",           "Finance team",      "3 hr ago"),
        new("6", "Read article on React Server Components", "Saved bookmark",    "5 hr ago"),
        new("7", "Update password for monitoring dashboard","Security alert",    "1 day ago"),
        new("8", "Schedule dentist appointment",            "Personal",          "2 days ago"),
    ];

    private Dictionary<string, int> _counts = new()
    {
        { "do-now",   0 },
        { "defer",    0 },
        { "delegate", 0 },
        { "archive",  0 },
    };

    private int _processed = 0;

    private TaskItem? CurrentTask => _inbox.Count > 0 ? _inbox[0] : null;
    private double ProgressPercent => _total > 0 ? (_processed * 100.0 / _total) : 0;
    private string ProgressStyle => $"width:{ProgressPercent:F1}%";

    private void Classify(string category)
    {
        if (_inbox.Count == 0) return;
        _inbox.RemoveAt(0);
        _counts[category]++;
        _processed++;
    }
}
