@* ============================================================
   Block: todo-list-automation
   Title: TodoListAutomation
   Description: A task automation rules block for React and Next.js with trigger-action rules, active toggles, and rule builder display built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-automation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="zap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Automation Rules</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_activeCount of @_rules.Count active
                </span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    New Rule
                </ButtonCn>
            </div>
        </div>

        @* Rules list *@
        <div>
            @foreach (var (rule, idx) in _rules.Select((r, i) => (r, i)))
            {
                var isExpanded = _expanded == rule.Id;
                var isLast = idx == _rules.Count - 1;
                var ruleId = rule.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="relative flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Row-wide expand target: a stretched overlay button, so the switch stays a
                           sibling control instead of a button nested inside another button. *@
                        <button type="button"
                                class="absolute inset-0 z-0"
                                @onclick="@(() => SetExpanded(isExpanded ? null : ruleId))"
                                aria-expanded="@(isExpanded ? "true" : "false")"
                                aria-label="@($"Details for {TriggerLabels[rule.Trigger]}")"></button>
                        <LucideIconCn Name="bolt" Size="16" Class="@(Cn.Merge("size-4 shrink-0", rule.Active ? "text-foreground" : "text-muted-foreground/40"))" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@(Cn.Merge("font-medium text-sm", !rule.Active ? "text-muted-foreground" : ""))">
                                    @TriggerLabels[rule.Trigger]
                                </span>
                                <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-muted-foreground/40" />
                                <span class="@(Cn.Merge("text-sm", !rule.Active ? "text-muted-foreground" : ""))">
                                    @ActionLabels[rule.Action]
                                </span>
                            </div>
                        </div>
                        @if (!rule.Active)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-[10px]">Inactive</BadgeCn>
                        }
                        <SwitchCn Class="relative z-10" Checked="@rule.Active" CheckedChanged="@((bool v) => ToggleRule(ruleId))" aria-label="@TriggerLabels[rule.Trigger]" />
                        <LucideIconCn Name="chevron-right" Size="16" Class="@(Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                    </div>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-11">
                            <p class="mb-3 text-muted-foreground text-sm leading-relaxed">
                                @rule.Description
                            </p>
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-muted-foreground text-xs">Trigger</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">@TriggerLabels[rule.Trigger]</BadgeCn>
                                </div>
                                <div class="mt-2 flex items-center gap-2">
                                    <span class="font-medium text-muted-foreground text-xs">Action</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">@ActionLabels[rule.Action]</BadgeCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                Rules run automatically when trigger conditions are met
            </span>
        </div>
    </div>
</section>

@code {
    private record AutomationRule(string Id, string Trigger, string Action, bool Active, string Description);

    private static readonly Dictionary<string, string> TriggerLabels = new()
    {
        { "completed", "When task completed" },
        { "priority-high", "When priority is High" },
        { "overdue", "When task is overdue" },
        { "assigned", "When task is assigned" },
        { "tag-added", "When tag is added" },
    };

    private static readonly Dictionary<string, string> ActionLabels = new()
    {
        { "move-archive", "Move to Archive" },
        { "assign-alex", "Assign to Alex" },
        { "send-notification", "Send notification" },
        { "set-priority", "Set priority to High" },
        { "add-tag", "Add #follow-up tag" },
    };

    private List<AutomationRule> _rules =
    [
        new("1", "completed", "move-archive", true, "Automatically archive tasks when they are marked as done"),
        new("2", "priority-high", "assign-alex", true, "Route all high-priority tasks to Alex for immediate review"),
        new("3", "overdue", "send-notification", true, "Send a Slack notification when a task passes its due date"),
        new("4", "assigned", "set-priority", false, "Automatically set newly assigned tasks to high priority"),
        new("5", "tag-added", "add-tag", false, "Add follow-up tag when any new tag is applied to a task"),
    ];

    private string? _expanded = "1";

    private int _activeCount => _rules.Count(r => r.Active);

    private void SetExpanded(string? id) => _expanded = id;

    private void ToggleRule(string id)
    {
        _rules = _rules.Select(r => r.Id == id ? r with { Active = !r.Active } : r).ToList();
    }
}
