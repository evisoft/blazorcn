@* ============================================================
   Block: todo-list-inventory
   Title: TodoListInventory
   Description: An inventory checklist todo list block for React and Next.js with SKU codes, stock levels, reorder thresholds, and stock status indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-inventory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Inventory</span>
                <span class="text-muted-foreground text-xs tabular-nums">@_items.Count SKUs</span>
            </div>
            <div class="flex items-center gap-3">
                @if (_lowStockCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        @_lowStockCount low
                    </span>
                }
                @if (_outOfStockCount > 0)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_outOfStockCount out
                    </span>
                }
            </div>
        </div>

        @* Items *@
        <div>
            @for (int i = 0; i < _items.Count; i++)
            {
                var item = _items[i];
                var itemId = item.Id;
                var isLast = i == _items.Count - 1;
                var status = GetStockStatus(item.Stock, item.Threshold);
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <CheckboxCn Id="@($"inv-{item.Id}")"
                                Checked="@item.Checked"
                                CheckedChanged="@((bool _) => Toggle(itemId))" />
                    <span class="@($"size-1.5 shrink-0 rounded-full {GetStatusDotClass(status)}")"></span>
                    <div class="min-w-0 flex-1">
                        <span class="@Cn.Merge("font-medium text-sm transition-all duration-200", item.Checked ? "text-muted-foreground line-through" : "")">
                            @item.Name
                        </span>
                        <div class="mt-0.5 flex items-center gap-2">
                            <span class="font-mono text-muted-foreground text-xs">@item.Sku</span>
                            <span class="text-muted-foreground text-xs">·</span>
                            <span class="text-muted-foreground text-xs tabular-nums">@item.Stock in stock</span>
                            <span class="text-muted-foreground text-xs">·</span>
                            <span class="text-muted-foreground text-xs tabular-nums">reorder at @item.Threshold</span>
                        </div>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary"
                             Class="@($"shrink-0 font-normal text-xs {GetStatusBadgeClass(status)}")">
                        @GetStatusText(status)
                    </BadgeCn>
                    @if (status != StockStatus.InStock)
                    {
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 text-xs">
                            <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                            Reorder
                        </ButtonCn>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs tabular-nums">
                @_items.Count SKUs tracked
            </span>
            <div class="flex items-baseline gap-1">
                <span class="text-muted-foreground text-xs">Total value</span>
                <span class="font-semibold text-sm tabular-nums">
                    $@FormatCurrency(_totalValue)
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private enum StockStatus { InStock, LowStock, OutOfStock }

    private record InventoryItem(
        string Id, string Name, string Sku,
        int Stock, int Threshold, double UnitCost, bool Checked);

    private List<InventoryItem> _items =
    [
        new("i1", "Wireless Keyboard", "KB-2401", 142, 25, 34.99, false),
        new("i2", "USB-C Hub Adapter", "HB-1803", 8, 20, 24.5, false),
        new("i3", "27\" Monitor Stand", "MS-3102", 0, 10, 45.0, false),
        new("i4", "Ergonomic Mouse", "MO-1547", 67, 30, 29.99, false),
        new("i5", "Webcam 1080p", "WC-0892", 3, 15, 54.99, false),
        new("i6", "Desk Lamp LED", "DL-4210", 0, 12, 42.0, false),
        new("i7", "Laptop Sleeve 14\"", "LS-2789", 234, 50, 18.99, true),
        new("i8", "HDMI Cable 2m", "HC-0156", 12, 40, 9.99, false),
        new("i9", "Noise Cancelling Headphones", "HP-6341", 51, 20, 89.99, false),
        new("i10", "Portable Charger 20000mAh", "PC-7823", 5, 25, 32.5, false),
    ];

    private int _lowStockCount => _items.Count(i => GetStockStatus(i.Stock, i.Threshold) == StockStatus.LowStock);
    private int _outOfStockCount => _items.Count(i => GetStockStatus(i.Stock, i.Threshold) == StockStatus.OutOfStock);
    private double _totalValue => _items.Sum(i => i.Stock * i.UnitCost);

    private static StockStatus GetStockStatus(int stock, int threshold)
    {
        if (stock == 0) return StockStatus.OutOfStock;
        if (stock < threshold) return StockStatus.LowStock;
        return StockStatus.InStock;
    }

    private static string GetStatusDotClass(StockStatus status) => status switch
    {
        StockStatus.InStock => "bg-emerald-500",
        StockStatus.LowStock => "bg-amber-500",
        StockStatus.OutOfStock => "bg-red-500",
        _ => ""
    };

    private static string GetStatusBadgeClass(StockStatus status) => status switch
    {
        StockStatus.InStock => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        StockStatus.LowStock => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        StockStatus.OutOfStock => "bg-red-500/10 text-red-700 dark:text-red-400",
        _ => ""
    };

    private static string GetStatusText(StockStatus status) => status switch
    {
        StockStatus.InStock => "In Stock",
        StockStatus.LowStock => "Low Stock",
        StockStatus.OutOfStock => "Out of Stock",
        _ => ""
    };

    private static string FormatCurrency(double value) =>
        value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);

    private void Toggle(string id)
    {
        var idx = _items.FindIndex(i => i.Id == id);
        if (idx >= 0)
            _items[idx] = _items[idx] with { Checked = !_items[idx].Checked };
    }
}
