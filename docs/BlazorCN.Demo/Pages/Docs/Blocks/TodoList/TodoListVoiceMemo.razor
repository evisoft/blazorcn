@* ============================================================
   Block: todo-list-voice-memo
   Title: TodoListVoiceMemo
   Description: A voice memo attachment todo list block for React and Next.js with waveform visualization, duration badges, play controls, and recording indicator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-voice-memo.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mic" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Voice Tasks</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs tabular-nums">@_memoCount memos</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs tabular-nums">@_tasks.Count tasks</span>
            </div>
        </div>

        @* Add task with record *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <ButtonCn Variant="@(_isRecording ? ButtonVariant.Destructive : ButtonVariant.Ghost)"
                      Size="ButtonSize.IconXs"
                      @onclick="ToggleRecording"
                      aria-label="@(_isRecording ? "Stop recording" : "Start recording")"
                      Class="@(_isRecording ? "animate-pulse" : "")">
                <LucideIconCn Name="mic" Size="16" Class="size-4" />
            </ButtonCn>
            @if (_isRecording)
            {
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 animate-pulse rounded-full bg-red-500"></span>
                    <span class="font-mono text-red-500 text-xs">Recording...</span>
                </span>
            }
            @if (!_isRecording)
            {
                <InputCn @bind-Value="_newTask"
                         @onkeydown="HandleInputKeyDown"
                         Placeholder="Add a task..."
                         Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.IconXs"
                          @onclick="AddTask"
                          Disabled="@(string.IsNullOrWhiteSpace(_newTask))"
                          aria-label="Add task">
                    <LucideIconCn Name="plus" Size="16" Class="size-4" />
                </ButtonCn>
            }
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < _tasks.Count; i++)
            {
                var task = _tasks[i];
                var isLast = i == _tasks.Count - 1;
                var taskId = task.Id;
                var isPlaying = _playingId == task.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="group px-4 py-3 transition-colors hover:bg-muted/50">
                        <div class="flex w-full items-center gap-3">
                            <CheckboxCn Id="@($"vm-todo-{task.Id}")"
                                        Checked="@task.Completed"
                                        CheckedChanged="@((bool _) => ToggleTask(taskId))" />
                            <span class="@Cn.Merge("min-w-0 flex-1 text-sm transition-all duration-200", task.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                                @task.Text
                            </span>
                            @if (task.Memo != null)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary"
                                         Class="shrink-0 gap-1 font-mono font-normal text-[10px]">
                                    <LucideIconCn Name="mic" Size="10" Class="size-2.5" />
                                    @task.Memo.Duration
                                </BadgeCn>
                            }
                            <ButtonCn Variant="ButtonVariant.Ghost"
                                      Size="ButtonSize.IconXs"
                                      @onclick="@(() => DeleteTask(taskId))"
                                      Class="shrink-0 opacity-0 transition-opacity group-hover:opacity-100"
                                      aria-label="@DeleteLabel(task.Text)">
                                <LucideIconCn Name="trash-2" Size="12" Class="size-3 text-muted-foreground" />
                            </ButtonCn>
                        </div>

                        @* Voice memo waveform *@
                        @if (task.Memo != null)
                        {
                            var memo = task.Memo;
                            <div class="mt-2 flex items-center gap-2 pl-7">
                                <ButtonCn Variant="ButtonVariant.Ghost"
                                          Size="ButtonSize.IconXs"
                                          @onclick="@(() => TogglePlay(taskId))"
                                          aria-label="@(isPlaying ? "Pause memo" : "Play memo")"
                                          Class="shrink-0">
                                    @if (isPlaying)
                                    {
                                        <LucideIconCn Name="pause" Size="12" Class="size-3 text-foreground" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="play" Size="12" Class="size-3 text-muted-foreground" />
                                    }
                                </ButtonCn>
                                <div class="flex flex-1 items-end gap-px">
                                    @for (int b = 0; b < memo.Bars.Length; b++)
                                    {
                                        var barHeight = memo.Bars[b] * 2;
                                        <div class="@Cn.Merge("w-1 rounded-full transition-colors", isPlaying ? "bg-foreground" : "bg-muted-foreground/30")"
                                             style="@($"height:{barHeight}px")">
                                        </div>
                                    }
                                </div>
                                <span class="shrink-0 font-mono text-muted-foreground text-[10px]">
                                    @memo.Duration
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @_tasks.Count(t => t.Completed) of @_tasks.Count tasks completed · @_memoCount voice memos attached
            </span>
        </div>
    </div>
</section>

@code {
    private record VoiceMemo(string Duration, int[] Bars);
    private record TaskItem(string Id, string Text, bool Completed, VoiceMemo? Memo);

    private int _nextId = 7;
    private string _newTask = "";
    private bool _isRecording = false;
    private string? _playingId = null;

    private List<TaskItem> _tasks =
    [
        new("1", "Discuss API architecture with team", false, new("0:32", [3, 6, 8, 5, 9, 4, 7, 10, 6, 3, 8, 5, 7, 4, 9, 6])),
        new("2", "Review design feedback from client", false, new("0:15", [4, 7, 5, 8, 3, 6, 9, 5, 7, 4])),
        new("3", "Draft project timeline document", true, null),
        new("4", "Note about database migration strategy", false, new("1:03", [5, 8, 4, 9, 7, 3, 6, 10, 5, 8, 4, 7, 9, 3, 6, 5, 8, 4, 7, 10])),
        new("5", "Send weekly progress update", false, null),
        new("6", "Brainstorm new feature ideas", false, new("0:47", [6, 3, 8, 5, 9, 7, 4, 6, 10, 3, 8, 5, 7])),
    ];

    private int _memoCount => _tasks.Count(t => t.Memo != null);

    private void AddTask()
    {
        var trimmed = _newTask.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        _tasks.Add(new TaskItem(_nextId.ToString(), trimmed, false, null));
        _nextId++;
        _newTask = "";
    }

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Completed = !_tasks[idx].Completed };
    }

    private void DeleteTask(string id)
    {
        _tasks.RemoveAll(t => t.Id == id);
    }

    private void TogglePlay(string id)
    {
        _playingId = _playingId == id ? null : id;
    }

    private void ToggleRecording()
    {
        _isRecording = !_isRecording;
    }

    private void HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddTask();
    }

    private static string DeleteLabel(string text) => $"Delete {text}";
}
