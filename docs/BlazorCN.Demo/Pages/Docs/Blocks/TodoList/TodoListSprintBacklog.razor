@* ============================================================
   Block: todo-list-sprint-backlog
   Title: TodoListSprintBacklog
   Description: An agile sprint backlog todo list block for React and Next.js with story points, burndown progress, and status sections built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-sprint-backlog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-sm">Sprint 24</span>
                <p class="text-muted-foreground text-xs">Mar 31 — Apr 11 · Day 4 of 10</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_tasks.Count items
            </BadgeCn>
        </div>

        @* Points summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">@DonePoints</span>
                <span class="text-muted-foreground text-xs">/ @TotalPoints pts</span>
            </div>
            <div class="min-w-0 flex-1">
                <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-foreground" style="@($"width:{BurndownPercent}%")"></div>
                </div>
            </div>
            <div class="flex shrink-0 items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @InProgressPoints pts
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    @(RemainingPoints - InProgressPoints) pts
                </span>
            </div>
        </div>

        @* Status sections *@
        @for (int si = 0; si < _statusOrder.Length; si++)
        {
            var status = _statusOrder[si];
            var config = GetStatusConfig(status);
            var sectionTasks = _tasks.Where(t => t.Status == status).OrderByDescending(t => t.Points).ToList();
            var sectionPoints = sectionTasks.Sum(t => t.Points);
            var isLastSection = si == _statusOrder.Length - 1;

            <div>
                @* Section header *@
                <div class="flex items-center gap-2 border-b bg-muted/20 px-4 py-2">
                    <span class="@($"size-1.5 rounded-full {config.Dot}")"></span>
                    <span class="font-medium text-xs">@config.Label</span>
                    <span class="ml-auto text-muted-foreground text-xs tabular-nums">
                        @sectionTasks.Count items · @sectionPoints pts
                    </span>
                </div>

                @* Tasks *@
                @if (sectionTasks.Count > 0)
                {
                    @for (int ti = 0; ti < sectionTasks.Count; ti++)
                    {
                        var task = sectionTasks[ti];
                        var isLastTask = ti == sectionTasks.Count - 1;
                        var hasBorder = !isLastSection || !isLastTask;
                        var taskId = task.Id;
                        <div class="@Cn.Merge("group flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", hasBorder ? "border-b" : "")">
                            <span class="@($"size-1.5 shrink-0 rounded-full {config.Dot}")"></span>
                            <div class="min-w-0 flex-1">
                                <span class="@Cn.Merge("text-sm", status == SprintStatus.Done ? "text-muted-foreground line-through" : "")">
                                    @task.Title
                                </span>
                                <p class="text-muted-foreground text-xs">@task.Assignee</p>
                            </div>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono text-xs tabular-nums">
                                @task.Points pts
                            </BadgeCn>
                            @if (status != SprintStatus.Done)
                            {
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                          Class="h-6 w-6 shrink-0 p-0 opacity-0 transition-opacity group-hover:opacity-100"
                                          @onclick="@(() => Advance(taskId))"
                                          aria-label="@AdvanceLabel(task.Title)">
                                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                                </ButtonCn>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="border-b px-4 py-3 text-center text-muted-foreground text-xs">
                        No items
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private enum SprintStatus { Todo, InProgress, Done }

    private record SprintTask(string Id, string Title, string Assignee, int Points, SprintStatus Status);

    private record StatusConfig(string Label, string Dot);

    private static StatusConfig GetStatusConfig(SprintStatus status) => status switch
    {
        SprintStatus.InProgress => new StatusConfig("In Progress", "bg-blue-500"),
        SprintStatus.Done       => new StatusConfig("Done",        "bg-emerald-500"),
        _                       => new StatusConfig("To Do",       "bg-muted-foreground/40"),
    };

    private static string AdvanceLabel(string title) => $"Move \"{title}\" forward";

    private static readonly SprintStatus[] _statusOrder =
        [SprintStatus.Todo, SprintStatus.InProgress, SprintStatus.Done];

    private List<SprintTask> _tasks =
    [
        new("s1", "Implement user profile page",            "Sarah C.", 5, SprintStatus.Done),
        new("s2", "Add file upload to settings",            "James L.", 8, SprintStatus.Done),
        new("s3", "Fix pagination on search results",       "Sarah C.", 2, SprintStatus.Done),
        new("s4", "Build notification preferences UI",      "Alex M.",  5, SprintStatus.InProgress),
        new("s5", "Integrate Stripe billing portal",        "James L.", 8, SprintStatus.InProgress),
        new("s6", "Add dark mode toggle to header",         "Alex M.",  3, SprintStatus.Todo),
        new("s7", "Write E2E tests for checkout flow",      "Sarah C.", 5, SprintStatus.Todo),
        new("s8", "Migrate email templates to React Email", "James L.", 3, SprintStatus.Todo),
        new("s9", "Set up preview deployments for PRs",     "Alex M.",  2, SprintStatus.Todo),
    ];

    private int TotalPoints       => _tasks.Sum(t => t.Points);
    private int DonePoints        => _tasks.Where(t => t.Status == SprintStatus.Done).Sum(t => t.Points);
    private int InProgressPoints  => _tasks.Where(t => t.Status == SprintStatus.InProgress).Sum(t => t.Points);
    private int RemainingPoints   => TotalPoints - DonePoints;
    private int BurndownPercent   => TotalPoints > 0
        ? (int)Math.Round((double)DonePoints / TotalPoints * 100)
        : 0;

    private void Advance(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx < 0) return;
        var t = _tasks[idx];
        if (t.Status == SprintStatus.Todo)
            _tasks[idx] = t with { Status = SprintStatus.InProgress };
        else if (t.Status == SprintStatus.InProgress)
            _tasks[idx] = t with { Status = SprintStatus.Done };
    }
}
