@* ============================================================
   Block: todo-list-deployment
   Title: TodoListDeployment
   Description: A deployment checklist todo list block for React and Next.js with progress tracking, step-by-step verification, and deploy gating built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-deployment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Deployment Checklist</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">v2.4.0</span>
        </div>

        @* Progress *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <ProgressCn Value="@((double)_progress)" Class="h-1.5 flex-1" aria-label="Progress" />
            <span class="font-medium text-muted-foreground text-xs tabular-nums">
                @_checked.Count/@_steps.Length
            </span>
        </div>

        @* Steps *@
        <div>
            @for (int i = 0; i < _steps.Length; i++)
            {
                var step = _steps[i];
                var isLast = i == _steps.Length - 1;
                var stepId = step.Id;
                var isChecked = _checked.Contains(stepId);
                <div class="@(isLast ? "" : "border-b")">
                    <label for="@($"deploy-{stepId}")"
                           class="flex w-full cursor-pointer items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <CheckboxCn Id="@($"deploy-{stepId}")" Checked="@isChecked" CheckedChanged="@((bool _) => Toggle(stepId))" Class="mt-0.5" aria-label="@step.Title" />
                        <div class="min-w-0 flex-1">
                            <span class="@Cn.Merge("font-medium text-sm transition-all duration-200", isChecked ? "text-muted-foreground line-through" : "")">
                                @step.Title
                            </span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                        </div>
                        @if (isChecked)
                        {
                            <LucideIconCn Name="check-circle-2" Size="16" Class="mt-0.5 size-4 shrink-0 text-emerald-500" />
                        }
                    </label>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @(_allComplete ? "All checks passed" : $"{_steps.Length - _checked.Count} steps remaining")
            </span>
            <ButtonCn Size="ButtonSize.Sm" Disabled="@(!_allComplete)" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="rocket" Size="12" Class="size-3" />
                Deploy
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record DeployStep(string Id, string Title, string Description);

    private static readonly DeployStep[] _steps =
    [
        new("s1", "Run test suite", "Unit, integration, and e2e tests"),
        new("s2", "Update changelog", "Document changes since last release"),
        new("s3", "Bump version", "Increment semantic version number"),
        new("s4", "Build production bundle", "Compile and optimize assets"),
        new("s5", "Deploy to staging", "Push build to staging environment"),
        new("s6", "Smoke test staging", "Verify critical paths on staging"),
        new("s7", "Deploy to production", "Push build to production servers"),
        new("s8", "Verify production", "Confirm deployment health checks"),
        new("s9", "Update status page", "Mark deployment complete publicly"),
    ];

    private HashSet<string> _checked = [];

    private int _progress => _steps.Length == 0 ? 0 : (int)Math.Round((double)_checked.Count / _steps.Length * 100);

    private bool _allComplete => _checked.Count == _steps.Length;

    private void Toggle(string id)
    {
        if (!_checked.Remove(id))
            _checked.Add(id);
    }
}
