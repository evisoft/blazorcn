@* ============================================================
   Block: todo-list-shopping
   Title: TodoListShopping
   Description: A categorized shopping list block for React and Next.js with produce, dairy, pantry, and household sections, quantity badges, total cost, and clear purchased action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-shopping.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shopping-cart" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Shopping List</span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_purchasedCount/@_items.Count purchased
                </span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost"
                      Size="ButtonSize.Sm"
                      Class="h-7 gap-1 px-2 text-xs"
                      @onclick="ClearPurchased"
                      Disabled="@(_purchasedCount == 0)">
                <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                Clear purchased
            </ButtonCn>
        </div>

        @* Categories *@
        @for (int catIndex = 0; catIndex < _categories.Length; catIndex++)
        {
            var catName = _categories[catIndex];
            var catItems = _items.Where(i => i.Category == catName).ToList();
            if (catItems.Count == 0) continue;
            var isCollapsed = _collapsed.Contains(catName);
            var catPurchased = catItems.Count(i => i.Purchased);
            var catTotal = catItems.Where(i => !i.Purchased).Sum(i => i.Price * i.Quantity);
            var ci = catIndex;

            <div>
                @* Category header *@
                <button type="button"
                        @onclick="@(() => ToggleCategory(catName))"
                        class="flex w-full items-center gap-2 border-b bg-muted/30 px-4 py-2 text-left transition-colors hover:bg-muted/50">
                    <LucideIconCn Name="chevron-right"
                                  Size="14"
                                  Class="@Cn.Merge("size-3.5 text-muted-foreground/60 transition-transform duration-200", isCollapsed ? "" : "rotate-90")" />
                    <span class="font-medium text-xs">@catName</span>
                    <span class="text-muted-foreground text-xs tabular-nums">@catPurchased/@catItems.Count</span>
                    <span class="ml-auto font-mono text-muted-foreground text-xs tabular-nums">$@($"{catTotal:F2}")</span>
                </button>

                @* Items *@
                @if (!isCollapsed)
                {
                    @for (int itemIndex = 0; itemIndex < catItems.Count; itemIndex++)
                    {
                        var item = catItems[itemIndex];
                        var itemId = item.Id;
                        var isLastInCategory = itemIndex == catItems.Count - 1;
                        var isLastCat = ci == _categories.Length - 1;
                        var showBorder = !(isLastInCategory && isLastCat);
                        <div class="@Cn.Merge("group flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", showBorder ? "border-b" : "")">
                            <CheckboxCn Id="@($"shop-{item.Id}")"
                                        Checked="@item.Purchased"
                                        CheckedChanged="@((bool _) => TogglePurchased(itemId))" />
                            <span class="@Cn.Merge("min-w-0 flex-1 text-sm transition-all duration-200", item.Purchased ? "text-muted-foreground line-through" : "")">
                                @item.Name
                            </span>
                            @if (item.Quantity > 1)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-xs">x@(item.Quantity)</BadgeCn>
                            }
                            <span class="font-mono text-muted-foreground text-xs tabular-nums">$@($"{item.Price * item.Quantity:F2}")</span>
                        </div>
                    }
                }
            </div>
        }

        @* Footer: estimated total *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @(_items.Count - _purchasedCount) items remaining
            </span>
            <div class="flex items-baseline gap-1">
                <span class="text-muted-foreground text-xs">Estimated total</span>
                <span class="font-semibold text-sm tabular-nums">$@($"{_totalRemaining:F2}")</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record ShoppingItem(string Id, string Name, string Category, int Quantity, double Price, bool Purchased);

    private static readonly string[] _categories = ["Produce", "Dairy", "Pantry", "Household"];

    private List<ShoppingItem> _items =
    [
        new("1",  "Bananas",         "Produce",   1, 1.29, false),
        new("2",  "Avocados",        "Produce",   3, 1.50, false),
        new("3",  "Baby spinach",    "Produce",   1, 3.99, true),
        new("4",  "Roma tomatoes",   "Produce",   6, 0.50, false),
        new("5",  "Whole milk",      "Dairy",     1, 4.49, false),
        new("6",  "Greek yogurt",    "Dairy",     2, 5.99, false),
        new("7",  "Cheddar cheese",  "Dairy",     1, 6.49, true),
        new("8",  "Butter, unsalted","Dairy",     1, 4.99, false),
        new("9",  "Olive oil",       "Pantry",    1, 8.99, false),
        new("10", "Jasmine rice",    "Pantry",    1, 5.49, false),
        new("11", "Canned tomatoes", "Pantry",    3, 1.89, true),
        new("12", "Chicken broth",   "Pantry",    2, 2.99, false),
        new("13", "Paper towels",    "Household", 2, 7.99, false),
        new("14", "Dish soap",       "Household", 1, 3.49, false),
        new("15", "Trash bags",      "Household", 1, 9.99, false),
    ];

    private HashSet<string> _collapsed = [];

    private int _purchasedCount => _items.Count(i => i.Purchased);
    private double _totalRemaining => _items.Where(i => !i.Purchased).Sum(i => i.Price * i.Quantity);

    private void TogglePurchased(string id)
    {
        var idx = _items.FindIndex(i => i.Id == id);
        if (idx >= 0)
            _items[idx] = _items[idx] with { Purchased = !_items[idx].Purchased };
    }

    private void ClearPurchased()
    {
        _items.RemoveAll(i => i.Purchased);
    }

    private void ToggleCategory(string cat)
    {
        if (_collapsed.Contains(cat)) _collapsed.Remove(cat);
        else _collapsed.Add(cat);
    }
}
