        new(""8"", ""Update error boundary components"",       2, false),
        new(""9"", ""Add loading skeletons to dashboard"",     1, false),
    ];

    private IEnumerable<TodoItem> SortedTodos => _todos.OrderByDescending(t => t.Points);

    private int TotalPoints => _todos.Sum(t => t.Points);
    private int CompletedPoints => _todos.Where(t => t.Completed).Sum(t => t.Points);
    private int RemainingPoints => TotalPoints - CompletedPoints;
    private double ProgressPercent => TotalPoints > 0 ? (double)CompletedPoints / TotalPoints * 100 : 0;

    private static string PointColor(int p)
    {
        if (p <= 3) return ""bg-emerald-500"";
        if (p == 5) return ""bg-amber-500"";
        return ""bg-red-500"";
    }

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx < 0) return;
        var t = _todos[idx];
        _todos[idx] = t with { Completed = !t.Completed };
    }

    private void SetPoints(string id, int points)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx < 0) return;
        var t = _todos[idx];
        _todos[idx] = t with { Points = points };
    }
}";

