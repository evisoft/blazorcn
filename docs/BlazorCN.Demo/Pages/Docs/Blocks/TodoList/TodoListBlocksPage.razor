    private List<TaskItem> _tasks =
    [
        new(""1"", ""Implement user authentication flow"", ""Development"", false),
        new(""2"", ""Set up database migrations"", ""Development"", true),
        new(""3"", ""Build REST API endpoints"", ""Development"", false),
        new(""4"", ""Add unit test coverage"", ""Development"", false),
        new(""5"", ""Create component library"", ""Design"", true),
        new(""6"", ""Design onboarding screens"", ""Design"", false),
        new(""7"", ""Update color palette tokens"", ""Design"", false),
        new(""8"", ""Write launch blog post"", ""Marketing"", false),
        new(""9"", ""Prepare social media assets"", ""Marketing"", true),
        new(""10"", ""Set up email drip campaign"", ""Marketing"", false),
        new(""11"", ""Schedule team retrospective"", ""Uncategorized"", false),
        new(""12"", ""Update project README"", ""Uncategorized"", true),
    ];

    private HashSet<string> _expanded = [""Development"", ""Design""];

    private int _completedCount => _tasks.Count(t => t.Completed);

    private TaskGroup[] _groups => _categoryOrder
        .Select(cat => new TaskGroup(cat, _tasks.Where(t => t.Category == cat).ToArray()))
        .Where(g => g.Tasks.Length > 0)
        .ToArray();

    private void ToggleExpanded(string category)
    {
        if (_expanded.Contains(category))
            _expanded.Remove(category);
        else
            _expanded.Add(category);
    }

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Completed = !_tasks[idx].Completed };
    }

    private void HandleSpanKeyDown(KeyboardEventArgs e, string id)
    {
        if (e.Key == ""Enter"" || e.Key == "" "") ToggleTask(id);
    }
}";

