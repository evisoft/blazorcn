@code {
    private record GrandChildItem(string Id, string Text, bool Completed);
    private record ChildItem(string Id, string Text, bool Completed, GrandChildItem[] Children);
    private record TaskItem(string Id, string Text, ChildItem[] Children);

    private List<TaskItem> _tasks =
    [
        new(""1"", ""Launch new marketing website"", new ChildItem[]
        {
            new(""1a"", ""Design homepage layout"", true, new GrandChildItem[]
            {
                new(""1a1"", ""Create hero section mockup"", true),
                new(""1a2"", ""Design feature grid"", true),
                new(""1a3"", ""Build footer component"", false),
            }),
            new(""1b"", ""Implement frontend"", false, new GrandChildItem[]
            {
                new(""1b1"", ""Set up Next.js project"", true),
                new(""1b2"", ""Integrate CMS content"", false),
                new(""1b3"", ""Add analytics tracking"", false),
            }),
        }),
        new(""2"", ""Backend API migration"", new ChildItem[]
        {
            new(""2a"", ""Database schema redesign"", false, new GrandChildItem[]
            {
                new(""2a1"", ""Audit current schema"", true),
                new(""2a2"", ""Write migration scripts"", false),
            }),
            new(""2b"", ""API endpoint refactor"", false, new GrandChildItem[]
            {
                new(""2b1"", ""Update auth endpoints"", false),
                new(""2b2"", ""Migrate data endpoints"", false),
                new(""2b3"", ""Add versioning headers"", false),
            }),
        }),
        new(""3"", ""Mobile app improvements"", new ChildItem[]
        {
            new(""3a"", ""Performance optimization"", false, new GrandChildItem[]
            {
                new(""3a1"", ""Profile render cycles"", true),
                new(""3a2"", ""Implement lazy loading"", true),
            }),
        }),
    ];

    private HashSet<string> _expandedL1 = [""1""];
    private HashSet<string> _expandedL2 = [""1a""];

    private int _totalGrandchildren => _tasks.Sum(t => CountAll(t.Children).Total);
    private int _completedGrandchildren => _tasks.Sum(t => CountAll(t.Children).Completed);

    private static (int Total, int Completed) CountAll(ChildItem[] children)
    {
        int total = 0, completed = 0;
        foreach (var child in children)
            foreach (var gc in child.Children)
            {
                total++;
                if (gc.Completed) completed++;
            }
        return (total, completed);
    }

    private static (int Total, int Completed) CountChildGrandchildren(ChildItem child)
    {
        int total = 0, completed = 0;
        foreach (var gc in child.Children)
        {
            total++;
            if (gc.Completed) completed++;
        }
        return (total, completed);
    }

    private void ToggleExpandL1(string id)
    {
        if (_expandedL1.Contains(id)) _expandedL1.Remove(id);
        else _expandedL1.Add(id);
    }

    private void ToggleExpandL2(string id)
    {
        if (_expandedL2.Contains(id)) _expandedL2.Remove(id);
        else _expandedL2.Add(id);
    }

    private void ToggleGrandChild(string taskId, string childId, string gcId)
    {
        var taskIdx = _tasks.FindIndex(t => t.Id == taskId);
        if (taskIdx < 0) return;
        var task = _tasks[taskIdx];

        var childIdx = Array.FindIndex(task.Children, c => c.Id == childId);
        if (childIdx < 0) return;
        var child = task.Children[childIdx];

        var gcIdx = Array.FindIndex(child.Children, g => g.Id == gcId);
        if (gcIdx < 0) return;

        var newGcs = child.Children.ToArray();
        newGcs[gcIdx] = newGcs[gcIdx] with { Completed = !newGcs[gcIdx].Completed };

        var newChildren = task.Children.ToArray();
        newChildren[childIdx] = child with { Children = newGcs };

        _tasks[taskIdx] = task with { Children = newChildren };
    }

    private void HandleGcKeyDown(KeyboardEventArgs e, string taskId, string childId, string gcId)
    {
        if (e.Key == ""Enter"" || e.Key == "" "") ToggleGrandChild(taskId, childId, gcId);
    }
}";

