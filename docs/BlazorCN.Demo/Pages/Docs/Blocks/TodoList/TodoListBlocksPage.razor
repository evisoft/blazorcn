    private record TodoItem(string Id, string Text, bool Completed, string Priority);

    private static readonly string[] _priorityOptions = [""high"", ""medium"", ""low""];
    private static readonly string[] _filterOptions = [""all"", ""high"", ""medium"", ""low""];

    private List<TodoItem> _todos =
    [
        new(""1"", ""Complete project documentation"", false, ""high""),
        new(""2"", ""Purchase themed blocks from shadcnblocks.com"", false, ""medium""),
        new(""3"", ""Buy groceries"", true, ""low""),
        new(""4"", ""Attend performance review meeting"", false, ""high""),
        new(""5"", ""Read React documentation"", true, ""medium""),
    ];

    private string _filter = ""all"";
    private string _newTask = """";
    private string _newPriority = ""medium"";
    private int _nextId = 6;

    private List<TodoItem> _filteredTodos =>
        _filter == ""all"" ? _todos : _todos.Where(t => t.Priority == _filter).ToList();

    private int _completedCount => _todos.Count(t => t.Completed);
    private int _highCount => _todos.Count(t => t.Priority == ""high"");
    private int _mediumCount => _todos.Count(t => t.Priority == ""medium"");
    private int _lowCount => _todos.Count(t => t.Priority == ""low"");

    private static string DotClass(string priority) => priority switch
    {
        ""high"" => ""bg-red-500"",
        ""medium"" => ""bg-amber-500"",
        ""low"" => ""bg-blue-500"",
        _ => """"
    };

    private static string PriorityLabel(string priority) => priority switch
    {
        ""high"" => ""High"",
        ""medium"" => ""Medium"",
        ""low"" => ""Low"",
        _ => """"
    };

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _todos[idx] = _todos[idx] with { Completed = !_todos[idx].Completed };
    }

    private void AddTodo()
    {
        var trimmed = _newTask.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        _todos.Add(new TodoItem(_nextId.ToString(), trimmed, false, _newPriority));
        _nextId++;
        _newTask = """";
    }

    private void CyclePriority()
    {
        var idx = Array.IndexOf(_priorityOptions, _newPriority);
        _newPriority = _priorityOptions[(idx + 1) % _priorityOptions.Length];
    }

    private void HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == ""Enter"") AddTodo();
    }
}";

