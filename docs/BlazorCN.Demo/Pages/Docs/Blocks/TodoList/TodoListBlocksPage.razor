@code {
    private record ParsedTask(string Text, string? Date, string? Priority, List<string> Tags)
    {
        public bool HasContent => !string.IsNullOrEmpty(Text);
    }

    private record TaskItem(string Id, string Text, string? Date, string? Priority, List<string> Tags, bool Completed);

    private static readonly Dictionary<string, string> _priorityColors = new()
    {
        [""high""] = ""bg-red-500/10 text-red-600 dark:text-red-400"",
        [""medium""] = ""bg-amber-500/10 text-amber-600 dark:text-amber-400"",
        [""low""] = ""bg-blue-500/10 text-blue-600 dark:text-blue-400"",
    };

    private static readonly Dictionary<string, string> _priorityDots = new()
    {
        [""high""] = ""bg-red-500"",
        [""medium""] = ""bg-amber-500"",
        [""low""] = ""bg-blue-500"",
    };

    private static readonly Dictionary<string, string> _dateLabels = new()
    {
        [""today""] = ""Today"",
        [""tomorrow""] = ""Tomorrow"",
        [""monday""] = ""Monday"",
        [""tuesday""] = ""Tuesday"",
        [""wednesday""] = ""Wednesday"",
        [""thursday""] = ""Thursday"",
        [""friday""] = ""Friday"",
        [""next week""] = ""Next week"",
    };

    private int _nextId = 5;

    private List<TaskItem> _tasks =
    [
        new(""1"", ""Complete project documentation"", ""Tomorrow"", ""high"", [""work""], false),
        new(""2"", ""Buy groceries"", ""Today"", ""medium"", [""personal""], false),
        new(""3"", ""Review pull request"", ""Monday"", ""high"", [""work"", ""urgent""], true),
        new(""4"", ""Schedule dentist appointment"", null, ""low"", [""personal""], false),
    ];

    private string _input = ""Buy milk tomorrow !high #personal"";

    private ParsedTask _parsed => ParseInput(_input);

    private ParsedTask ParseInput(string input)
    {
        var text = input.Trim();
        string? date = null;
        string? priority = null;
        var tags = new List<string>();

        var priorityMatch = System.Text.RegularExpressions.Regex.Match(
            text, @""!(high|medium|low)"", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (priorityMatch.Success)
        {
            priority = priorityMatch.Groups[1].Value.ToLower();
            text = text.Replace(priorityMatch.Value, """").Trim();
        }

        var tagMatches = System.Text.RegularExpressions.Regex.Matches(text, @""#(\w+)"");
        foreach (System.Text.RegularExpressions.Match m in tagMatches)
            tags.Add(m.Groups[1].Value);
        foreach (var t in tags)
            text = text.Replace($""#{t}"", """").Trim();

        foreach (var kvp in _dateLabels)
        {
            var pattern = $@""\b{System.Text.RegularExpressions.Regex.Escape(kvp.Key)}\b"";
            if (System.Text.RegularExpressions.Regex.IsMatch(
                    text, pattern, System.Text.RegularExpressions.RegexOptions.IgnoreCase))
            {
                date = kvp.Value;
                text = System.Text.RegularExpressions.Regex.Replace(
                    text, pattern, """", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Trim();
                break;
            }
        }

        return new ParsedTask(text, date, priority, tags);
    }

    private void AddTask()
    {
        if (!_parsed.HasContent) return;
        _tasks.Add(new TaskItem(
            _nextId.ToString(),
            _parsed.Text,
            _parsed.Date,
            _parsed.Priority,
            _parsed.Tags,
            false
        ));
        _nextId++;
        _input = """";
    }

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Completed = !_tasks[idx].Completed };
    }

    private void HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == ""Enter"") AddTask();
    }
}";

