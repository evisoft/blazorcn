@code {
    private enum RequestStatus { Planned, InProgress, Shipped, Declined }

    private record FeatureRequest(string Id, string Title, string Requester, int Votes, RequestStatus Status, string Category, bool HasVoted);

    private static readonly RequestStatus[] _allStatuses =
        [RequestStatus.Planned, RequestStatus.InProgress, RequestStatus.Shipped, RequestStatus.Declined];

    private List<FeatureRequest> _requests =
    [
        new(""fr1"", ""Dark mode support for all components"",   ""Sarah Chen"",   47, RequestStatus.InProgress, ""UI"",            false),
        new(""fr2"", ""Export data as CSV and PDF"",             ""James Rivera"",  34, RequestStatus.Planned,    ""Data"",          true),
        new(""fr3"", ""Real-time collaboration with cursors"",   ""Maya Patel"",   29, RequestStatus.Planned,    ""Collaboration"", false),
        new(""fr4"", ""Keyboard shortcuts for common actions"",  ""Alex Kim"",     22, RequestStatus.Shipped,    ""UX"",            true),
        new(""fr5"", ""Two-factor authentication via TOTP"",     ""Sarah Chen"",   18, RequestStatus.InProgress, ""Security"",      false),
        new(""fr6"", ""Custom webhook integrations"",            ""James Rivera"",  12, RequestStatus.Declined,   ""API"",           false),
        new(""fr7"", ""Audit log for all user actions"",         ""Maya Patel"",   15, RequestStatus.Planned,    ""Security"",      false),
    ];

    private RequestStatus? _statusFilter = null;
    private string _newRequest = """";

    private List<FeatureRequest> FilteredRequests =>
        (_statusFilter == null ? _requests : _requests.Where(r => r.Status == _statusFilter).ToList())
            .OrderByDescending(r => r.Votes)
            .ToList();

    private static (string Label, string ClassName) StatusInfo(RequestStatus s) => s switch
    {
        RequestStatus.Planned    => (""Planned"",     ""bg-blue-500/10 text-blue-600 dark:text-blue-400""),
        RequestStatus.InProgress => (""In Progress"", ""bg-amber-500/10 text-amber-600 dark:text-amber-400""),
        RequestStatus.Shipped    => (""Shipped"",     ""bg-emerald-500/10 text-emerald-600 dark:text-emerald-400""),
        RequestStatus.Declined   => (""Declined"",    ""bg-zinc-500/10 text-zinc-600 dark:text-zinc-400""),
        _                        => ("""", """"),
    };

    private static string FilterBadgeClass(bool active) =>
        Cn.Merge(""cursor-pointer text-xs font-normal"", active ? ""bg-foreground text-background hover:bg-foreground/90"" : """");

    private void ToggleVote(string id)
    {
        var idx = _requests.FindIndex(r => r.Id == id);
        if (idx >= 0)
        {
            var r = _requests[idx];
            _requests[idx] = r.HasVoted
                ? r with { Votes = r.Votes - 1, HasVoted = false }
                : r with { Votes = r.Votes + 1, HasVoted = true };
        }
    }

    private void SubmitRequest()
    {
        if (string.IsNullOrWhiteSpace(_newRequest)) return;
        var id = $""fr{_requests.Count + 1}"";
        _requests.Add(new FeatureRequest(id, _newRequest.Trim(), ""You"", 1, RequestStatus.Planned, ""General"", true));
        _newRequest = """";
    }
}";

