@code {
    private record ColorCategory(string Id, string Label, string Dot, string Bg, string Text);
    private record TaskItem(string Id, string Text, string Color, bool Completed);

    private static readonly ColorCategory[] _colorCategories =
    [
        new(""red"",    ""Red"",    ""bg-red-500"",     ""bg-red-500/10"",     ""text-red-600 dark:text-red-400""),
        new(""orange"", ""Orange"", ""bg-orange-500"",  ""bg-orange-500/10"",  ""text-orange-600 dark:text-orange-400""),
        new(""yellow"", ""Yellow"", ""bg-yellow-500"",  ""bg-yellow-500/10"",  ""text-yellow-600 dark:text-yellow-400""),
        new(""green"",  ""Green"",  ""bg-emerald-500"", ""bg-emerald-500/10"", ""text-emerald-600 dark:text-emerald-400""),
        new(""blue"",   ""Blue"",   ""bg-blue-500"",    ""bg-blue-500/10"",    ""text-blue-600 dark:text-blue-400""),
        new(""purple"", ""Purple"", ""bg-purple-500"",  ""bg-purple-500/10"",  ""text-purple-600 dark:text-purple-400""),
    ];

    private static readonly Dictionary<string, ColorCategory> _colorMap =
        _colorCategories.ToDictionary(c => c.Id);

    private List<TaskItem> _tasks =
    [
        new(""1"", ""Fix critical production bug"",   ""red"",    false),
        new(""2"", ""Update user dashboard design"",  ""blue"",   false),
        new(""3"", ""Write quarterly report"",        ""orange"", false),
        new(""4"", ""Plan team offsite agenda"",      ""green"",  true),
        new(""5"", ""Review marketing campaign"",     ""purple"", false),
        new(""6"", ""Prepare launch checklist"",      ""yellow"", false),
        new(""7"", ""Merge feature branch"",          ""blue"",   true),
        new(""8"", ""Order new monitors"",            ""green"",  false),
    ];

    private string? _filter = null;
    private string _newTask = """";
    private string _selectedColor = ""blue"";
    private int _nextId = 9;

    private List<TaskItem> FilteredTasks =>
        _filter != null ? _tasks.Where(t => t.Color == _filter).ToList() : _tasks;

    private void ToggleFilter(string colorId)
    {
        _filter = _filter == colorId ? null : colorId;
    }

    private void AddTask()
    {
        var trimmed = _newTask.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        _tasks.Add(new TaskItem(_nextId.ToString(), trimmed, _selectedColor, false));
        _nextId++;
        _newTask = """";
    }

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Completed = !_tasks[idx].Completed };
    }

    private void DeleteTask(string id)
    {
        _tasks.RemoveAll(t => t.Id == id);
    }

    private void HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == ""Enter"") AddTask();
    }

    private void HandleSpanKeyDown(KeyboardEventArgs e, string id)
    {
        if (e.Key == ""Enter"" || e.Key == "" "") ToggleTask(id);
    }

    private string GetDotButtonClass(ColorCategory cat)
    {
        var ringColor = cat.Id == ""green"" ? ""emerald"" : cat.Id;
        return _selectedColor == cat.Id
            ? $""flex size-5 items-center justify-center rounded-full transition-all {cat.Dot} ring-2 ring-offset-1 ring-offset-background ring-{ringColor}-500/30""
            : $""flex size-5 items-center justify-center rounded-full transition-all {cat.Dot} opacity-30 hover:opacity-60"";
    }

    private string GetFilterSuffix() =>
        _filter != null ? $"" in {_colorMap[_filter].Label}"" : """";

    private static string DeleteLabel(string text) => $""Delete {text}"";
    private static string SelectCategoryLabel(string label) => $""Select {label} category"";
}";

