        @* Quadrant grid *@
        <div class=""grid grid-cols-1 sm:grid-cols-2"">
            @for (int qi = 0; qi < _quadrantOrder.Length; qi++)
            {
                var quadrant = _quadrantOrder[qi];
                var config = _quadrantConfig[quadrant];
                var quadrantTasks = _tasks.Where(t => t.Quadrant == quadrant).ToList();
                var otherQuadrants = _quadrantOrder.Where(q => q != quadrant).Take(2).ToArray();
                var showBorderRight = qi % 2 == 0;
                var showBorderBottom = qi < 2;
                var qLocal = quadrant;
                <div class=""@Cn.Merge(showBorderRight ? ""sm:border-r"" : """", showBorderBottom ? ""border-b"" : """")"">
                    @* Quadrant header *@
                    <div class=""flex items-center gap-2 border-b px-4 py-2.5"">
                        <span class=""@Cn.Merge(""size-1.5 rounded-full"", config.Dot)"" />
                        <span class=""font-medium text-sm"">@config.Label</span>
                        <span class=""text-muted-foreground text-xs"">@config.Subtitle</span>
                        <span class=""ml-auto text-muted-foreground text-xs tabular-nums"">
                            @quadrantTasks.Count
                        </span>
                    </div>

                    @* Tasks *@
                    <div class=""min-h-[120px]"">
                        @foreach (var task in quadrantTasks)
                        {
                            var taskId = task.Id;
                            var taskCompleted = task.Completed;
                            var taskText = task.Text;
                            <div class=""group flex items-center gap-2 border-b px-4 py-2 transition-colors last:border-b-0 hover:bg-muted/50"">
                                <span class=""flex shrink-0 items-center"">
                                    <CheckboxCn Checked=""@taskCompleted""
                                                CheckedChanged=""@((bool _) => ToggleTask(taskId))""
                                                aria-label=""@CheckboxLabel(taskText, taskCompleted)"" />
                                </span>
                                <span class=""@Cn.Merge(""min-w-0 flex-1 text-sm"", taskCompleted ? ""text-muted-foreground line-through"" : """")"">
                                    @taskText
                                </span>
                                <div class=""flex shrink-0 items-center gap-0.5 opacity-0 transition-opacity group-hover:opacity-100"">
                                    @foreach (var target in otherQuadrants)
                                    {
                                        var tgt = target;
                                        <ButtonCn Variant=""ButtonVariant.Ghost""
                                                  Size=""ButtonSize.Sm""
                                                  Class=""h-5 w-5 p-0""
                                                  @onclick=""@(() => MoveTask(taskId, tgt))""
                                                  aria-label=""@MoveLabel(tgt)"">
                                            <span class=""@Cn.Merge(""size-1.5 rounded-full"", _quadrantConfig[tgt].Dot)"" />
                                        </ButtonCn>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @* Add input *@
                    <div class=""flex items-center gap-1 border-t px-4 py-2"">
                        <InputCn Value=""@_inputs[qLocal]""
                                 ValueChanged=""@((string v) => { _inputs[qLocal] = v; })""
                                 @onkeydown=""@((KeyboardEventArgs e) => HandleKeyDown(e, qLocal))""
                                 Placeholder=""Add task...""
                                 Class=""h-7 border-0 bg-transparent px-0 text-xs shadow-none focus-visible:ring-0"" />
                        <ButtonCn Variant=""ButtonVariant.Ghost""
                                  Size=""ButtonSize.Sm""
                                  Class=""h-6 w-6 shrink-0 p-0""
                                  @onclick=""@(() => AddTask(qLocal))""
                                  aria-label=""@AddTaskLabel(qLocal)"">
                            <LucideIconCn Name=""plus"" Size=""12"" Class=""size-3"" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

