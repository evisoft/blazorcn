        new(""Overdue"",     OverdueCount,    ""text-red-600 dark:text-red-400""),
    ];

    private static string StatusDotClass(TaskStatus status) => status switch
    {
        TaskStatus.Completed  => ""bg-emerald-500"",
        TaskStatus.InProgress => ""bg-blue-500"",
        TaskStatus.Overdue    => ""bg-red-500"",
        _                     => """"
    };

    private void ToggleTask(string id)
    {
        var index = _tasks.FindIndex(t => t.Id == id);
        if (index < 0) return;
        var t = _tasks[index];
