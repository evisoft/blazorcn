@code {
    private record Habit(string Id, string Name, string Emoji);

    private static readonly string[] _days = [""Mon"", ""Tue"", ""Wed"", ""Thu"", ""Fri"", ""Sat"", ""Sun""];

    private static readonly Habit[] _habits =
    [
        new(""h1"", ""Morning run"", ""🏃""),
        new(""h2"", ""Read 30 min"", ""📖""),
        new(""h3"", ""Meditate"", ""🧘""),
        new(""h4"", ""No social media"", ""📵""),
        new(""h5"", ""Write journal"", ""✍️""),
        new(""h6"", ""Drink 2L water"", ""💧""),
    ];

    private Dictionary<string, bool> _completions = new()
    {
        [""h1-Mon""] = true,
        [""h1-Tue""] = true,
        [""h1-Wed""] = true,
        [""h2-Mon""] = true,
        [""h2-Tue""] = false,
        [""h2-Wed""] = true,
        [""h3-Mon""] = true,
        [""h3-Tue""] = true,
        [""h3-Wed""] = true,
        [""h4-Mon""] = false,
        [""h4-Tue""] = true,
        [""h4-Wed""] = true,
        [""h5-Mon""] = true,
        [""h5-Tue""] = true,
        [""h5-Wed""] = false,
        [""h6-Mon""] = true,
        [""h6-Tue""] = true,
        [""h6-Wed""] = true,
        [""h1-Thu""] = false,
        [""h2-Thu""] = false,
        [""h3-Thu""] = false,
        [""h4-Thu""] = false,
        [""h5-Thu""] = false,
        [""h6-Thu""] = false,
    };

    private int TotalCompleted => _completions.Values.Count(v => v);
    private int TotalCells => _habits.Length * _days.Length;

    private int GetStreak(string habitId)
    {
        int streak = 0;
        for (int i = _days.Length - 1; i >= 0; i--)
        {
            var key = $""{habitId}-{_days[i]}"";
            if (_completions.TryGetValue(key, out bool val) && val)
                streak++;
            else if (streak > 0)
                break;
        }
        return streak;
    }

    private int GetDayRate(string day)
    {
        int completed = _habits.Count(h => _completions.TryGetValue($""{h.Id}-{day}"", out bool v) && v);
        return _habits.Length > 0 ? (int)Math.Round((double)completed / _habits.Length * 100) : 0;
    }

    private void Toggle(string habitId, string day)
    {
        var key = $""{habitId}-{day}"";
        _completions[key] = !(_completions.TryGetValue(key, out bool v) && v);
    }
}";

