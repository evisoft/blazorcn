    private int CompletedCount => _active.Count(t => t.Completed);

    private void ToggleTodo(string id)
    {
        var todo = _active.FirstOrDefault(t => t.Id == id);
        if (todo != null) todo.Completed = !todo.Completed;
    }

    private void ArchiveCompleted()
    {
        var completed = _active.Where(t => t.Completed).ToList();
        _active = _active.Where(t => !t.Completed).ToList();
        _archived = [.. completed, .. _archived];
    }

    private void RestoreTask(string id)
    {
        var task = _archived.FirstOrDefault(t => t.Id == id);
        if (task == null) return;
