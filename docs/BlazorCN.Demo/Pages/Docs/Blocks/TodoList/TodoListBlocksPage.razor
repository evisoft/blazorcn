        new() { Id = ""o3"", OrderId = ""ORD-4819"", Customer = ""Sofia Garcia"", Items = 5, Total = ""$156.75"", CurrentStep = ""Shipped"", Tracking = ""1Z999AA10123456784"", Completed = false },
        new() { Id = ""o4"", OrderId = ""ORD-4818"", Customer = ""James Miller"", Items = 2, Total = ""$67.98"", CurrentStep = ""Received"", Tracking = null, Completed = false },
        new() { Id = ""o5"", OrderId = ""ORD-4817"", Customer = ""Aisha Patel"", Items = 4, Total = ""$312.40"", CurrentStep = ""Shipped"", Tracking = ""1Z999AA10987654321"", Completed = false },
        new() { Id = ""o6"", OrderId = ""ORD-4816"", Customer = ""Lucas Brown"", Items = 1, Total = ""$45.00"", CurrentStep = ""Delivered"", Tracking = ""1Z999AA10456789012"", Completed = true },
        new() { Id = ""o7"", OrderId = ""ORD-4815"", Customer = ""Mia Thompson"", Items = 7, Total = ""$498.25"", CurrentStep = ""Processing"", Tracking = null, Completed = false },
