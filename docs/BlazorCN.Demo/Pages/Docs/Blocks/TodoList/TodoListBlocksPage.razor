    private record SprintTask(string Id, string Text, int Points, bool Completed);
    private record DailyProgress(string Day, int IdealRemaining, int ActualRemaining);

    private const int TotalPoints = 40; // 5+3+8+5+8+3+5+3

    private List<SprintTask> _tasks =
    [
        new(""1"", ""Set up authentication middleware"",  5, true),
        new(""2"", ""Create user profile API endpoints"", 3, true),
        new(""3"", ""Build settings page UI"",            8, true),
        new(""4"", ""Implement file upload service"",     5, false),
        new(""5"", ""Add notification system"",           8, false),
        new(""6"", ""Write E2E tests for checkout"",      3, false),
        new(""7"", ""Optimize image loading pipeline"",   5, false),
        new(""8"", ""Deploy monitoring dashboards"",      3, false),
    ];

    private static readonly DailyProgress[] _dailyBreakdown =
    [
        new(""Mon"", 33, 36),
        new(""Tue"", 25, 31),
        new(""Wed"", 17, 24),
        new(""Thu"",  8, 24),
        new(""Fri"",  0, 24),
    ];

    private int CompletedPoints => _tasks.Where(t => t.Completed).Sum(t => t.Points);
    private int RemainingPoints => TotalPoints - CompletedPoints;
    private int ProgressPercent => TotalPoints > 0
        ? (int)Math.Round((double)CompletedPoints / TotalPoints * 100)
        : 0;

    private string ProgressBadgeClass => ProgressPercent >= 80
        ? ""ml-auto font-normal text-xs bg-emerald-500/10 text-emerald-600 dark:text-emerald-400""
        : ProgressPercent >= 50
            ? ""ml-auto font-normal text-xs bg-amber-500/10 text-amber-600 dark:text-amber-400""
            : ""ml-auto font-normal text-xs bg-red-500/10 text-red-600 dark:text-red-400"";

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx < 0) return;
        var t = _tasks[idx];
        _tasks[idx] = t with { Completed = !t.Completed };
    }
}";

