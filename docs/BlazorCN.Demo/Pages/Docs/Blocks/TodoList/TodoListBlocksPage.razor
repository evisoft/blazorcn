@code {
    private record TodoItem(string Id, string Text, bool Completed, int LoggedSeconds);

    private List<TodoItem> _todos =
    [
        new(""1"", ""Design component library architecture"", false, 8100),
        new(""2"", ""Implement authentication middleware"", false, 5400),
        new(""3"", ""Write unit tests for billing module"", true, 3600),
        new(""4"", ""Review and merge feature branch"", false, 1800),
        new(""5"", ""Update deployment documentation"", false, 0),
        new(""6"", ""Debug WebSocket reconnection issue"", false, 2700),
    ];

    private string? _activeTimerId = null;
    private System.Threading.Timer? _timer = null;

    private int _totalSeconds => _todos.Sum(t => t.LoggedSeconds);

    private static string FormatTime(int seconds)
    {
        var h = seconds / 3600;
        var m = (seconds % 3600) / 60;
        if (h > 0) return $""{h}h {m}m"";
        if (m > 0) return $""{m}m"";
        return ""0m"";
    }

    private void ToggleTodo(string id)
    {
        if (_activeTimerId == id)
        {
            StopTimer();
        }
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _todos[idx] = _todos[idx] with { Completed = !_todos[idx].Completed };
    }

    private void ToggleTimer(string id)
    {
        if (_activeTimerId == id)
        {
            StopTimer();
        }
        else
        {
            StopTimer();
            _activeTimerId = id;
            _timer = new System.Threading.Timer(_ =>
            {
                var activeId = _activeTimerId;
                if (activeId is null) return;
                var idx = _todos.FindIndex(t => t.Id == activeId);
                if (idx >= 0)
                    _todos[idx] = _todos[idx] with { LoggedSeconds = _todos[idx].LoggedSeconds + 1 };
                InvokeAsync(StateHasChanged);
            }, null, 1000, 1000);
        }
    }

    private void StopTimer()
    {
        _timer?.Dispose();
        _timer = null;
        _activeTimerId = null;
    }

    public void Dispose()
    {
        _timer?.Dispose();
        _timer = null;
    }
}";

