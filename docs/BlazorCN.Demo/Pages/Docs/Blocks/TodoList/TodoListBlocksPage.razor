    private static readonly Dictionary<QuadrantType, QuadrantInfo> _quadrantConfig = new()
    {
        [QuadrantType.DoFirst]   = new(""Do First"",   ""Urgent & Important"",           ""bg-emerald-500""),
        [QuadrantType.Schedule]  = new(""Schedule"",   ""Not Urgent & Important"",        ""bg-blue-500""),
        [QuadrantType.Delegate]  = new(""Delegate"",   ""Urgent & Not Important"",        ""bg-amber-500""),
        [QuadrantType.Eliminate] = new(""Eliminate"",  ""Not Urgent & Not Important"",    ""bg-muted-foreground/40""),
    };

    private List<TaskItem> _tasks =
    [
        new(""1"",  ""Fix production database outage"",   false, QuadrantType.DoFirst),
        new(""2"",  ""Respond to client escalation email"", false, QuadrantType.DoFirst),
        new(""3"",  ""Deploy hotfix for auth regression"",  true,  QuadrantType.DoFirst),
        new(""4"",  ""Plan Q3 product roadmap"",            false, QuadrantType.Schedule),
        new(""5"",  ""Refactor authentication module"",     false, QuadrantType.Schedule),
        new(""6"",  ""Write integration test suite"",       false, QuadrantType.Schedule),
        new(""7"",  ""Update team meeting notes"",          false, QuadrantType.Delegate),
        new(""8"",  ""Respond to vendor questionnaire"",    true,  QuadrantType.Delegate),
        new(""9"",  ""Archive old Jira tickets"",           false, QuadrantType.Eliminate),
        new(""10"", ""Reorganize shared drive folders"",    false, QuadrantType.Eliminate),
    ];

    private Dictionary<QuadrantType, string> _inputs = new()
    {
        [QuadrantType.DoFirst]   = """",
        [QuadrantType.Schedule]  = """",
        [QuadrantType.Delegate]  = """",
        [QuadrantType.Eliminate] = """",
    };

    private int _nextId = 11;

    private int _totalDone => _tasks.Count(t => t.Completed);

    private void ToggleTask(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Completed = !_tasks[idx].Completed };
    }

    private void MoveTask(string id, QuadrantType to)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Quadrant = to };
    }

    private void AddTask(QuadrantType quadrant)
    {
        var text = _inputs[quadrant].Trim();
        if (string.IsNullOrEmpty(text)) return;
        _tasks.Add(new TaskItem(_nextId.ToString(), text, false, quadrant));
        _nextId++;
        _inputs[quadrant] = """";
    }

    private void HandleKeyDown(KeyboardEventArgs e, QuadrantType quadrant)
    {
        if (e.Key == ""Enter"") AddTask(quadrant);
    }

    private static string CheckboxLabel(string text, bool completed) =>
        $""Mark \""{text}\"" as {(completed ? ""incomplete"" : ""complete"")}"";

    private string MoveLabel(QuadrantType target) =>
        $""Move to {_quadrantConfig[target].Label}"";

    private string AddTaskLabel(QuadrantType quadrant) =>
        $""Add task to {_quadrantConfig[quadrant].Label}"";
}";

