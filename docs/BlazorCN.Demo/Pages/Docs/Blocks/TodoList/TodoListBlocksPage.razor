        if (string.IsNullOrEmpty(trimmed)) return;
        var board = _boards.Find(b => b.Id == _activeBoard);
        if (board is null) return;
        board.Tasks.Add(new TaskItem(_nextId.ToString(), trimmed, false));
        _nextId++;
        _newTask = """";
