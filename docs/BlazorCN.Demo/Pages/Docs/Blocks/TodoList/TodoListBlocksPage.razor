        new(""9"",  ""Add rate limiting to search API"",  TaskStatus.Completed,  true),
        new(""10"", ""Update SSL certificates"",          TaskStatus.Completed,  true),
    ];

    private int CompletedCount => _tasks.Count(t => t.Status == TaskStatus.Completed);
    private int InProgressCount => _tasks.Count(t => t.Status == TaskStatus.InProgress);
    private int OverdueCount => _tasks.Count(t => t.Status == TaskStatus.Overdue);
    private int CompletionRate => _tasks.Count > 0
        ? (int)Math.Round((double)CompletedCount / _tasks.Count * 100)
        : 0;

    private StatItem[] GetStats() =>
    [
        new(""Total"",       _tasks.Count,    ""text-foreground""),
