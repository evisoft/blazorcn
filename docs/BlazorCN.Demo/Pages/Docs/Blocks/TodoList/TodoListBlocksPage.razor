@code {
    private record TodoItem(string Id, string Text, bool Completed);
    private record StatusFilter(string Value, string Label);

    private static readonly StatusFilter[] _statusFilters =
    [
        new(""all"", ""All""),
        new(""active"", ""Active""),
        new(""completed"", ""Completed""),
    ];

    private List<TodoItem> _todos =
    [
        new(""1"", ""Complete project documentation"", false),
        new(""2"", ""Purchase themed blocks from shadcnblocks.com"", false),
        new(""3"", ""Buy groceries for the weekend"", true),
        new(""4"", ""Review pull request #42"", false),
        new(""5"", ""Read React documentation"", true),
        new(""6"", ""Update CI/CD pipeline configuration"", false),
        new(""7"", ""Schedule team standup meeting"", true),
    ];

    private string _search = """";
    private string _status = ""all"";

    private int _activeCount => _todos.Count(t => !t.Completed);
    private int _completedCount => _todos.Count(t => t.Completed);

    private List<TodoItem> FilteredTodos =>
        _todos.Where(todo =>
        {
            var matchesSearch = string.IsNullOrEmpty(_search) ||
                todo.Text.Contains(_search, StringComparison.OrdinalIgnoreCase);
            var matchesStatus = _status == ""all"" ||
                (_status == ""active"" && !todo.Completed) ||
                (_status == ""completed"" && todo.Completed);
            return matchesSearch && matchesStatus;
        }).ToList();

    private int StatusCount(string statusValue) => statusValue switch
    {
        ""all"" => _todos.Count,
        ""active"" => _activeCount,
        ""completed"" => _completedCount,
        _ => 0,
    };

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _todos[idx] = _todos[idx] with { Completed = !_todos[idx].Completed };
    }

    private void ClearCompleted()
    {
        _todos.RemoveAll(t => t.Completed);
    }
}";

