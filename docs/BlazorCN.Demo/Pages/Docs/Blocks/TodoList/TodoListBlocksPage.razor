@code {
    private enum SprintStatus { Todo, InProgress, Done }

    private record SprintTask(string Id, string Title, string Assignee, int Points, SprintStatus Status);

    private record StatusConfig(string Label, string Dot);

    private static StatusConfig GetStatusConfig(SprintStatus status) => status switch
    {
        SprintStatus.InProgress => new StatusConfig(""In Progress"", ""bg-blue-500""),
        SprintStatus.Done       => new StatusConfig(""Done"",        ""bg-emerald-500""),
        _                       => new StatusConfig(""To Do"",       ""bg-muted-foreground/40""),
    };

    private static string AdvanceLabel(string title) => $""Move \""{title}\"" forward"";

    private static readonly SprintStatus[] _statusOrder =
        [SprintStatus.Todo, SprintStatus.InProgress, SprintStatus.Done];

    private List<SprintTask> _tasks =
    [
        new(""s1"", ""Implement user profile page"",            ""Sarah C."", 5, SprintStatus.Done),
        new(""s2"", ""Add file upload to settings"",            ""James L."", 8, SprintStatus.Done),
        new(""s3"", ""Fix pagination on search results"",       ""Sarah C."", 2, SprintStatus.Done),
        new(""s4"", ""Build notification preferences UI"",      ""Alex M."",  5, SprintStatus.InProgress),
        new(""s5"", ""Integrate Stripe billing portal"",        ""James L."", 8, SprintStatus.InProgress),
        new(""s6"", ""Add dark mode toggle to header"",         ""Alex M."",  3, SprintStatus.Todo),
        new(""s7"", ""Write E2E tests for checkout flow"",      ""Sarah C."", 5, SprintStatus.Todo),
        new(""s8"", ""Migrate email templates to React Email"", ""James L."", 3, SprintStatus.Todo),
        new(""s9"", ""Set up preview deployments for PRs"",     ""Alex M."",  2, SprintStatus.Todo),
    ];

    private int TotalPoints       => _tasks.Sum(t => t.Points);
    private int DonePoints        => _tasks.Where(t => t.Status == SprintStatus.Done).Sum(t => t.Points);
    private int InProgressPoints  => _tasks.Where(t => t.Status == SprintStatus.InProgress).Sum(t => t.Points);
    private int RemainingPoints   => TotalPoints - DonePoints;
    private int BurndownPercent   => TotalPoints > 0
        ? (int)Math.Round((double)DonePoints / TotalPoints * 100)
        : 0;

    private void Advance(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx < 0) return;
        var t = _tasks[idx];
        if (t.Status == SprintStatus.Todo)
            _tasks[idx] = t with { Status = SprintStatus.InProgress };
        else if (t.Status == SprintStatus.InProgress)
            _tasks[idx] = t with { Status = SprintStatus.Done };
    }
}";

