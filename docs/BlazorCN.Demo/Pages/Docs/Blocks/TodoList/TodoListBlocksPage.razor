@code {
    private enum BugSeverity { Critical, Major, Minor }
    private enum BugStatus { Open, InProgress, Fixed, Verified }

    private record BugItem(string Id, string Title, BugSeverity Severity, BugStatus Status, string Reporter, string Component, string[] StepsToReproduce);

    private static readonly BugSeverity[] _severities = [BugSeverity.Critical, BugSeverity.Major, BugSeverity.Minor];

    private List<BugItem> _bugs =
    [
        new(""b1"", ""Login form crashes on empty submit"", BugSeverity.Critical, BugStatus.Open, ""Maya Patel"", ""AuthForm"",
            [""Navigate to /login"", ""Leave all fields empty"", ""Click Submit button"", ""Application crashes with unhandled TypeError""]),
        new(""b2"", ""Dashboard chart renders incorrect data after timezone change"", BugSeverity.Major, BugStatus.InProgress, ""James Rivera"", ""AnalyticsChart"",
            [""Open dashboard with chart data"", ""Change system timezone to UTC+12"", ""Refresh the page"", ""Chart bars show previous day's data shifted by 12 hours""]),
        new(""b3"", ""File upload silently fails above 10MB"", BugSeverity.Major, BugStatus.Open, ""Sarah Chen"", ""FileUploader"",
            [""Navigate to file upload page"", ""Select a file larger than 10MB"", ""Click Upload"", ""Progress bar completes but file is not saved""]),
        new(""b4"", ""Tooltip clipped by overflow container"", BugSeverity.Minor, BugStatus.Fixed, ""Alex Kim"", ""DataTable"",
            [""Open data table with long cell values"", ""Hover over a truncated cell in the last column"", ""Tooltip is cut off by the table's overflow-hidden container""]),
        new(""b5"", ""Search results flash on slow connections"", BugSeverity.Minor, BugStatus.Verified, ""Maya Patel"", ""SearchBar"",
            [""Throttle network to Slow 3G"", ""Type a search query"", ""Previous results flash before new results load""]),
        new(""b6"", ""Session expires without warning during form edit"", BugSeverity.Critical, BugStatus.InProgress, ""James Rivera"", ""SessionManager"",
            [""Start editing a long form"", ""Wait for session to expire (30 min idle)"", ""Submit the form"", ""Data is lost with a redirect to login""]),
    ];

    private BugSeverity? _filter = null;
    private string? _expanded = null;

    private List<BugItem> FilteredBugs =>
        _filter == null ? _bugs : _bugs.Where(b => b.Severity == _filter).ToList();

    private int CriticalCount => _bugs.Count(b => b.Severity == BugSeverity.Critical);
    private int MajorCount => _bugs.Count(b => b.Severity == BugSeverity.Major);
    private int MinorCount => _bugs.Count(b => b.Severity == BugSeverity.Minor);

    private static string SeverityDotClass(BugSeverity s) => s switch
    {
        BugSeverity.Critical => ""bg-red-500"",
        BugSeverity.Major    => ""bg-amber-500"",
        BugSeverity.Minor    => ""bg-blue-500"",
        _                    => """",
    };

    private static (string Label, string ClassName) StatusBadgeInfo(BugStatus s) => s switch
    {
        BugStatus.Open        => (""Open"",        ""bg-red-500/10 text-red-600 dark:text-red-400""),
        BugStatus.InProgress  => (""In Progress"",  ""bg-amber-500/10 text-amber-600 dark:text-amber-400""),
        BugStatus.Fixed       => (""Fixed"",         ""bg-blue-500/10 text-blue-600 dark:text-blue-400""),
        BugStatus.Verified    => (""Verified"",      ""bg-emerald-500/10 text-emerald-600 dark:text-emerald-400""),
        _                     => ("""",             """"),
    };

    private static string FilterBadgeClass(bool active) =>
        Cn.Merge(""cursor-pointer text-xs font-normal"", active ? ""bg-foreground text-background hover:bg-foreground/90"" : """");

    private void CycleStatus(string id)
    {
        var order = new[] { BugStatus.Open, BugStatus.InProgress, BugStatus.Fixed, BugStatus.Verified };
        var idx = _bugs.FindIndex(b => b.Id == id);
        if (idx >= 0)
        {
            var current = _bugs[idx];
            var currentIndex = Array.IndexOf(order, current.Status);
            var nextStatus = order[(currentIndex + 1) % order.Length];
            _bugs[idx] = current with { Status = nextStatus };
        }
    }
}";

