    ];

    private string? _expanded;

    private Dictionary<string, int> _stepCounts =>
        _items.GroupBy(i => i.CurrentStep).ToDictionary(g => g.Key, g => g.Count());

    private void Toggle(string id)
    {
        var order = _items.FirstOrDefault(o => o.Id == id);
        if (order != null)
            order.Completed = !order.Completed;
    }

    private void AdvanceStep(string id)
    {
        var order = _items.FirstOrDefault(o => o.Id == id);
        if (order == null) return;
        var idx = Array.IndexOf(_stepOrder, order.CurrentStep);
        if (idx >= 0 && idx < _stepOrder.Length - 1)
            order.CurrentStep = _stepOrder[idx + 1];
    }
