@code {
    private record QuadrantInfo(string Id, string Title, string Effort, string Impact, string Description, string Dot);
    private record TaskItem(string Id, string Text, string Effort, string Impact);

    private static readonly QuadrantInfo[] _quadrants =
    [
        new(""quick-wins"", ""Quick Wins"", ""low"",  ""high"", ""Low effort, high impact"",  ""bg-emerald-500""),
        new(""big-bets"",   ""Big Bets"",   ""high"", ""high"", ""High effort, high impact"", ""bg-blue-500""),
        new(""fill-ins"",   ""Fill-ins"",   ""low"",  ""low"",  ""Low effort, low impact"",   ""bg-amber-500""),
        new(""avoid"",      ""Avoid"",      ""high"", ""low"",  ""High effort, low impact"",  ""bg-red-500""),
    ];

    private List<TaskItem> _tasks =
    [
        new(""1"", ""Add search to docs"",       ""low"",  ""high""),
        new(""2"", ""Fix mobile nav bug"",        ""low"",  ""high""),
        new(""3"", ""Rewrite auth system"",       ""high"", ""high""),
        new(""4"", ""Build analytics dashboard"", ""high"", ""high""),
        new(""5"", ""Update favicon"",            ""low"",  ""low""),
        new(""6"", ""Rename CSS variables"",      ""low"",  ""low""),
        new(""7"", ""Migrate to new ORM"",        ""high"", ""low""),
        new(""8"", ""Custom email templates"",    ""high"", ""low""),
    ];

    private Dictionary<string, string> _inputs = new()
    {
        [""quick-wins""] = """",
        [""big-bets""]   = """",
        [""fill-ins""]   = """",
        [""avoid""]      = """",
    };

    private int _nextId = 9;

    private List<TaskItem> GetTasksForQuadrant(string id) =>
        _tasks.Where(t => GetQuadrantId(t.Effort, t.Impact) == id).ToList();

    private static string GetQuadrantId(string effort, string impact)
    {
        if (effort == ""low""  && impact == ""high"") return ""quick-wins"";
        if (effort == ""high"" && impact == ""high"") return ""big-bets"";
        if (effort == ""low""  && impact == ""low"")  return ""fill-ins"";
        return ""avoid"";
    }

    private void MoveEffort(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Effort = _tasks[idx].Effort == ""low"" ? ""high"" : ""low"" };
    }

    private void MoveImpact(string id)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _tasks[idx] = _tasks[idx] with { Impact = _tasks[idx].Impact == ""low"" ? ""high"" : ""low"" };
    }

    private void AddTask(QuadrantInfo quadrant)
    {
        var text = _inputs[quadrant.Id].Trim();
        if (string.IsNullOrEmpty(text)) return;
        _tasks.Add(new TaskItem(_nextId.ToString(), text, quadrant.Effort, quadrant.Impact));
        _nextId++;
        _inputs[quadrant.Id] = """";
    }

    private void HandleKeyDown(KeyboardEventArgs e, QuadrantInfo quadrant)
    {
        if (e.Key == ""Enter"") AddTask(quadrant);
    }
}";

