    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (_isInputFocused) return;

        switch (e.Key.ToLower())
        {
            case ""j"":
                _focusedIndex = Math.Min(_focusedIndex + 1, _tasks.Count - 1);
                break;
            case ""k"":
                _focusedIndex = Math.Max(_focusedIndex - 1, 0);
                break;
            case ""x"":
                if (_focusedIndex >= 0 && _focusedIndex < _tasks.Count)
                    ToggleTask(_tasks[_focusedIndex].Id);
                break;
            case ""d"":
                if (_focusedIndex >= 0 && _focusedIndex < _tasks.Count)
                    DeleteTask(_focusedIndex);
                break;
            case ""?"":
                _showLegend = !_showLegend;
                break;
        }
    }

    private static string DeleteLabel(string text) => $""Delete {text}"";
}";

