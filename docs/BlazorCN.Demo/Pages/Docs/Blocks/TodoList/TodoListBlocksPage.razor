        new(""7"", ""Admin panel CRUD operations"", 60),
        new(""8"", ""API rate limiting middleware"", 100),
        new(""9"", ""File upload and storage"", 0),
        new(""10"", ""Webhook event processing"", 30),
    ];

    private int OverallProgress => _tasks.Count > 0
        ? (int)Math.Round(_tasks.Sum(t => (double)t.Progress) / _tasks.Count)
        : 0;

    private TaskItem[] NotStarted => _tasks.Where(t => t.Progress == 0).ToArray();
    private TaskItem[] InProgress => _tasks.Where(t => t.Progress > 0 && t.Progress < 100).ToArray();
    private TaskItem[] Complete => _tasks.Where(t => t.Progress == 100).ToArray();

    private GroupItem[] Groups => new GroupItem[]
    {
        new(""Not Started"", NotStarted, ""bg-muted-foreground/40""),
        new(""In Progress"", InProgress, ""bg-blue-500""),
        new(""Complete"", Complete, ""bg-emerald-500""),
    }.Where(g => g.Tasks.Length > 0).ToArray();

    private void UpdateProgress(string id, double value)
    {
        var idx = _tasks.FindIndex(t => t.Id == id);
        if (idx >= 0)
        {
            _tasks[idx] = _tasks[idx] with { Progress = (int)value };
        }
    }

    private static string GetProgressColor(int value)
    {
        if (value == 100) return ""text-emerald-600 dark:text-emerald-400"";
        if (value >= 50) return ""text-amber-600 dark:text-amber-400"";
        if (value > 0) return ""text-blue-600 dark:text-blue-400"";
        return ""text-muted-foreground"";
    }

    private static string GetProgressBarColor(int value)
    {
        if (value == 100) return ""bg-emerald-500"";
        if (value >= 50) return ""bg-amber-500"";
        if (value > 0) return ""bg-blue-500"";
        return ""bg-muted"";
    }
