@code {
    private record QaTestItem(string Id, string Title, string Severity);
    private record QaTestCategory(string Id, string Title, QaTestItem[] Items);

    private static readonly Dictionary<string, string> SeverityDot = new()
    {
        [""critical""] = ""bg-red-500"",
        [""high""] = ""bg-amber-500"",
        [""medium""] = ""bg-blue-500"",
        [""low""] = ""bg-zinc-400"",
    };

    private static readonly QaTestCategory[] _testCategories =
    [
        new(""functional"", ""Functional"",
        [
            new(""f1"", ""User login with valid credentials"", ""critical""),
            new(""f2"", ""Form validation on required fields"", ""high""),
            new(""f3"", ""Data persistence after page refresh"", ""high""),
            new(""f4"", ""Error handling on network failure"", ""medium""),
        ]),
        new(""visual"", ""Visual"",
        [
            new(""v1"", ""Layout renders correctly at 1280px"", ""high""),
            new(""v2"", ""Mobile responsive at 375px"", ""high""),
            new(""v3"", ""Dark mode color consistency"", ""medium""),
        ]),
        new(""performance"", ""Performance"",
        [
            new(""p1"", ""Largest Contentful Paint under 2.5s"", ""critical""),
            new(""p2"", ""No memory leaks on navigation"", ""high""),
            new(""p3"", ""Bundle size under budget (250KB)"", ""medium""),
        ]),
        new(""accessibility"", ""Accessibility"",
        [
            new(""a1"", ""All images have alt text"", ""critical""),
            new(""a2"", ""Keyboard navigation works"", ""high""),
            new(""a3"", ""Color contrast meets WCAG AA"", ""high""),
            new(""a4"", ""Screen reader announces form errors"", ""medium""),
        ]),
    ];

    private Dictionary<string, string?> _results = new();

    private int EvaluatedCount => _testCategories.SelectMany(c => c.Items)
        .Count(i => _results.TryGetValue(i.Id, out var r) && (r == ""pass"" || r == ""fail""));

    private int PassedCount => _testCategories.SelectMany(c => c.Items)
        .Count(i => _results.TryGetValue(i.Id, out var r) && r == ""pass"");

    private int FailedCount => _testCategories.SelectMany(c => c.Items)
        .Count(i => _results.TryGetValue(i.Id, out var r) && r == ""fail"");

    private int SkippedCount => _testCategories.SelectMany(c => c.Items)
        .Count(i => _results.TryGetValue(i.Id, out var r) && r == ""skip"");

    private int PassRate => EvaluatedCount > 0
        ? (int)Math.Round((double)PassedCount / EvaluatedCount * 100)
        : 0;

    private string RateColor => PassRate >= 90
        ? ""text-emerald-600 dark:text-emerald-400""
        : PassRate >= 60
            ? ""text-amber-600 dark:text-amber-400""
            : ""text-red-600 dark:text-red-400"";

    private void SetResult(string id, string? result)
    {
        _results[id] = result;
    }
}";

