@code {
    private record TaskItem(string Id, string Text, string Duration);
    private record TimeSlot(int Hour, string Label, string? TaskId);

    private static readonly TaskItem[] _allTasks =
    [
        new(""t1"", ""Write API documentation"", ""1h""),
        new(""t2"", ""Code review for PR #87"", ""30m""),
        new(""t3"", ""Update onboarding flow"", ""2h""),
        new(""t4"", ""Debug payment webhook"", ""1h""),
        new(""t5"", ""Team retrospective prep"", ""30m""),
        new(""t6"", ""Morning standup"", ""15m""),
        new(""t7"", ""Sprint planning meeting"", ""1h""),
        new(""t8"", ""Lunch break"", ""1h""),
    ];

    private List<TimeSlot> _slots =
    [
        new(9,  ""9:00 AM"",  ""t6""),
        new(10, ""10:00 AM"", ""t7""),
        new(11, ""11:00 AM"", null),
        new(12, ""12:00 PM"", ""t8""),
        new(13, ""1:00 PM"",  null),
        new(14, ""2:00 PM"",  null),
        new(15, ""3:00 PM"",  null),
        new(16, ""4:00 PM"",  null),
        new(17, ""5:00 PM"",  null),
    ];

    private List<TaskItem> _available =
    [
        new(""t1"", ""Write API documentation"", ""1h""),
        new(""t2"", ""Code review for PR #87"", ""30m""),
        new(""t3"", ""Update onboarding flow"", ""2h""),
        new(""t4"", ""Debug payment webhook"", ""1h""),
        new(""t5"", ""Team retrospective prep"", ""30m""),
    ];

    private int? _activeSlot = null;

    private int _scheduledCount => _slots.Count(s => s.TaskId != null);

    private TaskItem? GetTask(string taskId)
    {
        return Array.Find(_allTasks, t => t.Id == taskId)
            ?? _available.Find(t => t.Id == taskId);
    }

    private void AssignTask(int hour, string taskId)
    {
        var idx = _slots.FindIndex(s => s.Hour == hour);
        if (idx >= 0)
            _slots[idx] = _slots[idx] with { TaskId = taskId };
        _available.RemoveAll(t => t.Id == taskId);
        _activeSlot = null;
    }

    private void UnassignTask(int hour)
    {
        var idx = _slots.FindIndex(s => s.Hour == hour);
        if (idx < 0) return;
        var slot = _slots[idx];
        if (slot.TaskId == null) return;
        var task = GetTask(slot.TaskId);
        if (task != null && !_available.Exists(t => t.Id == task.Id))
            _available.Add(task);
        _slots[idx] = slot with { TaskId = null };
    }

    private void SetActiveSlot(int hour)
    {
        _activeSlot = _activeSlot == hour ? null : hour;
    }
}";

