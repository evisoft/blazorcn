@* ============================================================
   Block: todo-list-comments
   Title: TodoListComments
   Description: A todo list block with threaded comments for React and Next.js featuring comment counts, avatar initials, timestamps, and inline reply input built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-comments.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Tasks with Comments</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_totalComments comments
            </span>
        </div>

        @* Task list *@
        <div>
            @for (int i = 0; i < _todos.Count; i++)
            {
                var todo = _todos[i];
                var isLast = i == _todos.Count - 1;
                var isExpanded = _expanded == todo.Id;
                var todoId = todo.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex w-full items-start gap-3 px-4 py-3">
                        <span class="mt-0.5 shrink-0">
                            <CheckboxCn Checked="@todo.Completed"
                                        CheckedChanged="@((bool _) => ToggleTodo(todoId))" />
                        </span>
                        <button type="button"
                                @onclick="@(() => ToggleExpand(todoId))"
                                class="flex min-w-0 flex-1 items-center gap-2 text-left">
                            <span class="@Cn.Merge("flex-1 text-sm transition-all duration-200", todo.Completed ? "text-muted-foreground line-through" : "text-foreground")">
                                @todo.Text
                            </span>
                            @if (todo.Comments.Count > 0)
                            {
                                <div class="flex shrink-0 items-center gap-1 text-muted-foreground">
                                    <LucideIconCn Name="message-square" Size="14" Class="size-3.5" />
                                    <span class="text-xs tabular-nums">@todo.Comments.Count</span>
                                </div>
                            }
                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>
                    </div>

                    @if (isExpanded)
                    {
                        <div class="overflow-hidden">
                            <div class="px-4 pb-3 pl-10">
                                @if (todo.Comments.Count > 0)
                                {
                                    <div class="space-y-3">
                                        @foreach (var comment in todo.Comments)
                                        {
                                            <div class="flex gap-2.5">
                                                <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted font-medium text-muted-foreground text-xs">
                                                    @comment.Initials
                                                </div>
                                                <div class="min-w-0 flex-1">
                                                    <div class="flex items-center gap-2">
                                                        <span class="font-medium text-xs">@comment.Author</span>
                                                        <span class="text-muted-foreground/60 text-xs">@comment.Timestamp</span>
                                                    </div>
                                                    <p class="mt-0.5 text-muted-foreground text-sm leading-relaxed">@comment.Text</p>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="mb-2 text-muted-foreground/50 text-xs italic">No comments yet</p>
                                }

                                @* Reply input *@
                                <div class="mt-3 flex items-center gap-2">
                                    <InputCn @bind-Value="_replyText"
                                             Placeholder="Add a comment..."
                                             Class="h-8 text-sm"
                                             @onkeydown="@((KeyboardEventArgs e) => HandleInputKeyDown(e, todoId))" />
                                    <ButtonCn Variant="ButtonVariant.Ghost"
                                              Size="ButtonSize.Sm"
                                              Class="h-8 shrink-0 px-2"
                                              @onclick="@(() => AddComment(todoId))"
                                              Disabled="@(string.IsNullOrWhiteSpace(_replyText))">
                                        <LucideIconCn Name="send" Size="14" Class="size-3.5" />
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <span class="text-muted-foreground text-xs tabular-nums">@_todos.Count tasks</span>
            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
            <span class="text-muted-foreground text-xs tabular-nums">@_totalComments comments</span>
        </div>
    </div>
</section>

@code {
    private record CommentItem(string Id, string Author, string Initials, string Text, string Timestamp);
    private record TodoItem(string Id, string Text, bool Completed, List<CommentItem> Comments);

    private string? _expanded = "1";
    private string _replyText = "";

    private List<TodoItem> _todos =
    [
        new("1", "Implement user authentication flow", false, [
            new("c1", "Sarah Chen", "SC", "Should we use JWT or session-based auth? I lean toward sessions for better security.", "2h ago"),
            new("c2", "Alex Rivera", "AR", "Sessions with httpOnly cookies. I can set up the Redis store for session storage.", "1h ago"),
            new("c3", "Sarah Chen", "SC", "Sounds good. Let's also add rate limiting on the login endpoint.", "45m ago"),
        ]),
        new("2", "Design database schema for billing", false, [
            new("c4", "Jordan Park", "JP", "I added the ERD to the shared drive. Key question: do we need a separate invoices table or embed in subscriptions?", "4h ago"),
        ]),
        new("3", "Write E2E tests for onboarding", true, [
            new("c5", "Morgan Lee", "ML", "All 12 test cases passing. Covered email verification, profile setup, and first project creation.", "Yesterday"),
            new("c6", "Alex Rivera", "AR", "Nice work. Can you add a test for the skip-onboarding edge case?", "Yesterday"),
        ]),
        new("4", "Optimize image loading on landing page", false, []),
        new("5", "Set up error tracking with Sentry", false, [
            new("c7", "Jordan Park", "JP", "I have the Sentry project created. Need the DSN added to environment variables.", "3h ago"),
        ]),
    ];

    private int _totalComments => _todos.Sum(t => t.Comments.Count);

    private void ToggleTodo(string id)
    {
        var idx = _todos.FindIndex(t => t.Id == id);
        if (idx >= 0)
            _todos[idx] = _todos[idx] with { Completed = !_todos[idx].Completed };
    }

    private void ToggleExpand(string id)
    {
        _expanded = _expanded == id ? null : id;
        _replyText = "";
    }

    private void AddComment(string todoId)
    {
        var trimmed = _replyText.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        var todo = _todos.FirstOrDefault(t => t.Id == todoId);
        if (todo == null) return;
        todo.Comments.Add(new CommentItem($"c-new-{todo.Comments.Count}", "You", "YO", trimmed, "Just now"));
        _replyText = "";
    }

    private void HandleInputKeyDown(KeyboardEventArgs e, string todoId)
    {
        if (e.Key == "Enter") AddComment(todoId);
    }
}
