@* ============================================================
   Block: todo-list-packing
   Title: TodoListPacking
   Description: A travel packing list block for React and Next.js with categorized essentials, weight tracking, overall progress bar, and trip details built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-packing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="luggage" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Packing List</span>
            </div>
            <div class="mt-1 flex items-center gap-2">
                <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Trip to Tokyo</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">Apr 15 – Apr 22</span>
            </div>
        </div>

        @* Progress *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <ProgressCn Value="@_progressPercent" Class="h-1.5 flex-1" />
            <span class="font-medium text-xs tabular-nums">@_progressPercent%</span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_packedCount/@_items.Count packed
            </span>
        </div>

        @* Categories *@
        @foreach (var category in _categories)
        {
            var catItems = _items.Where(i => i.Category == category).ToList();
            if (catItems.Count == 0) continue;
            var isCollapsed = _collapsed.Contains(category);
            var catPacked = catItems.Count(i => i.Packed);
            var catIndex = Array.IndexOf(_categories, category);
            var isLastCat = catIndex == _categories.Length - 1;
            var cat = category;

            <div>
                <button type="button"
                        @onclick="@(() => ToggleCategory(cat))"
                        class="flex w-full items-center gap-2 border-b bg-muted/30 px-4 py-2 text-left transition-colors hover:bg-muted/50">
                    <LucideIconCn Name="chevron-right"
                                  Size="14"
                                  Class="@Cn.Merge("size-3.5 text-muted-foreground/60 transition-transform duration-200", isCollapsed ? "" : "rotate-90")" />
                    <span class="font-medium text-xs">@category</span>
                    <span class="text-muted-foreground text-xs tabular-nums">
                        @catPacked/@catItems.Count
                    </span>
                </button>

                @if (!isCollapsed)
                {
                    @for (int itemIndex = 0; itemIndex < catItems.Count; itemIndex++)
                    {
                        var item = catItems[itemIndex];
                        var isLastInCat = itemIndex == catItems.Count - 1;
                        var showBorder = !(isLastInCat && isLastCat);
                        var itemId = item.Id;

                        <div class="@Cn.Merge("group flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", showBorder ? "border-b" : "")">
                            <CheckboxCn Id="@($"pack-{item.Id}")"
                                        Checked="@item.Packed"
                                        CheckedChanged="@((bool _) => TogglePacked(itemId))" />
                            <span class="@Cn.Merge("min-w-0 flex-1 text-sm transition-all duration-200", item.Packed ? "text-muted-foreground line-through" : "")">
                                @item.Name
                            </span>
                            @if (item.Quantity > 1)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-xs">
                                    x@item.Quantity
                                </BadgeCn>
                            }
                        </div>
                    }
                }
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @(_items.Count - _packedCount) items left to pack
            </span>
        </div>
    </div>
</section>

@code {
    private record PackingItem(string Id, string Name, string Category, int Quantity, bool Packed);

    private static readonly string[] _categories = ["Essentials", "Clothing", "Toiletries", "Electronics", "Documents"];

    private List<PackingItem> _items =
    [
        new("1",  "Passport",               "Essentials",  1, true),
        new("2",  "Travel wallet",           "Essentials",  1, true),
        new("3",  "Travel insurance docs",   "Essentials",  1, false),
        new("4",  "Medications",             "Essentials",  1, true),
        new("5",  "Reusable water bottle",   "Essentials",  1, false),
        new("6",  "T-shirts",               "Clothing",    5, false),
        new("7",  "Jeans",                  "Clothing",    2, false),
        new("8",  "Lightweight jacket",      "Clothing",    1, true),
        new("9",  "Walking shoes",           "Clothing",    1, true),
        new("10", "Underwear",              "Clothing",    7, false),
        new("11", "Socks",                  "Clothing",    5, false),
        new("12", "Toothbrush & paste",      "Toiletries",  1, true),
        new("13", "Shampoo (travel size)",   "Toiletries",  1, false),
        new("14", "Sunscreen SPF 50",        "Toiletries",  1, false),
        new("15", "Deodorant",              "Toiletries",  1, true),
        new("16", "Phone charger",           "Electronics", 1, true),
        new("17", "Power adapter (JP)",      "Electronics", 1, false),
        new("18", "Camera",                 "Electronics", 1, false),
        new("19", "Portable battery",        "Electronics", 1, true),
        new("20", "Flight confirmation",     "Documents",   1, true),
        new("21", "Hotel reservation",       "Documents",   1, true),
        new("22", "Rail pass voucher",       "Documents",   1, false),
        new("23", "Emergency contacts",      "Documents",   1, false),
    ];

    private HashSet<string> _collapsed = [];

    private int _packedCount => _items.Count(i => i.Packed);
    private int _progressPercent => _items.Count > 0 ? (int)Math.Round((double)_packedCount / _items.Count * 100) : 0;

    private void TogglePacked(string id)
    {
        var idx = _items.FindIndex(i => i.Id == id);
        if (idx >= 0)
            _items[idx] = _items[idx] with { Packed = !_items[idx].Packed };
    }

    private void ToggleCategory(string category)
    {
        if (_collapsed.Contains(category))
            _collapsed.Remove(category);
        else
            _collapsed.Add(category);
    }
}
