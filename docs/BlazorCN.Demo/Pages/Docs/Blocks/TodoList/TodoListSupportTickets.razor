@* ============================================================
   Block: todo-list-support-tickets
   Title: TodoListSupportTickets
   Description: A support ticket queue todo list block for React and Next.js with ticket IDs, priority sorting, SLA timers, category badges, and agent assignment built with shadcn/ui and Tailwind CSS
   Source: original/blocks/todo-list/todo-list-support-tickets.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="headphones" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Support Tickets</span>
                <span class="text-muted-foreground text-xs tabular-nums">@_items.Count total</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    Open @_items.Count(t => t.Status == SupportTicketStatus.Open)
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    In Progress @_items.Count(t => t.Status == SupportTicketStatus.InProgress)
                </span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    Resolved @_items.Count(t => t.Status == SupportTicketStatus.Resolved)
                </span>
            </div>
        </div>

        @* Tickets *@
        <div>
            @for (int i = 0; i < _items.Count; i++)
            {
                var ticket = _items[i];
                var isLast = i == _items.Count - 1;
                var isExpanded = _expanded == ticket.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                        <CheckboxCn Checked="@ticket.Completed" CheckedChanged="@((bool v) => Toggle(ticket.Id))" Class="mt-0.5" aria-label="@ticket.Subject" />
                        <button type="button"
                                @onclick="@(() => _expanded = (isExpanded ? null : ticket.Id))"
                                class="min-w-0 flex-1 text-left">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", PriorityDotClass(ticket.Priority))"></span>
                                <span class="font-mono text-muted-foreground text-xs">@ticket.TicketId</span>
                                <span class="@Cn.Merge("font-medium text-sm transition-all duration-200", ticket.Completed ? "text-muted-foreground line-through" : "")">
                                    @ticket.Subject
                                </span>
                            </div>
                            <div class="mt-1 flex items-center gap-2 pl-3.5">
                                <span class="text-muted-foreground text-xs">@ticket.Customer</span>
                                <BadgeCn Variant="BadgeVariant.Secondary"
                                         Class="@Cn.Merge("font-normal text-xs", CategoryColorClass(ticket.Category))">
                                    @ticket.Category.ToString()
                                </BadgeCn>
                                <span class="text-muted-foreground text-xs">@ticket.Sla</span>
                            </div>
                        </button>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("mt-0.5 size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </div>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-10">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Assigned to</span>
                                    <span class="flex items-center gap-1 text-xs">
                                        <LucideIconCn Name="user" Size="12" Class="size-3 text-muted-foreground" />
                                        @ticket.Agent
                                    </span>
                                </div>
                                <div class="mt-2 flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Priority</span>
                                    <span class="flex items-center gap-1.5 text-xs">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", PriorityDotClass(ticket.Priority))"></span>
                                        @ticket.Priority.ToString()
                                    </span>
                                </div>
                                <div class="mt-2 flex items-center justify-between">
                                    <span class="text-muted-foreground text-xs">Status</span>
                                    <span class="text-xs">@StatusLabel(ticket.Status)</span>
                                </div>
                            </div>
                            @if (ticket.Status != SupportTicketStatus.Resolved)
                            {
                                <div class="mt-2 flex gap-2">
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Reply</ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Resolve</ButtonCn>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @_items.Count(t => t.Priority == SupportTicketPriority.Urgent && !t.Completed) urgent tickets need attention
            </span>
            <span class="text-muted-foreground text-xs tabular-nums">
                @_items.Count(t => !t.Completed) unresolved
            </span>
        </div>

    </div>
</section>

@code {
    private enum SupportTicketPriority { Urgent, High, Normal, Low }
    private enum SupportTicketStatus { Open, InProgress, Waiting, Resolved }
    private enum SupportTicketCategory { Bug, Feature, Question }

    private record SupportTicket(
        string Id,
        string TicketId,
        string Subject,
        string Customer,
        SupportTicketPriority Priority,
        SupportTicketStatus Status,
        SupportTicketCategory Category,
        string Sla,
        string Agent,
        bool Completed
    );

    private static readonly SupportTicket[] _seed =
    [
        new("t1",  "#1247", "Payment processing fails on checkout",  "Michael Torres", SupportTicketPriority.Urgent,  SupportTicketStatus.Open,       SupportTicketCategory.Bug,      "45 min left",   "Sarah K.",   false),
        new("t2",  "#1246", "Cannot export dashboard data to CSV",   "Emily Watson",   SupportTicketPriority.High,    SupportTicketStatus.InProgress, SupportTicketCategory.Bug,      "2h remaining",  "James L.",   false),
        new("t3",  "#1245", "Request for bulk user import feature",  "David Park",     SupportTicketPriority.Normal,  SupportTicketStatus.Open,       SupportTicketCategory.Feature,  "18h remaining", "Unassigned", false),
        new("t4",  "#1244", "How to set up SSO with Okta?",          "Rachel Green",   SupportTicketPriority.Normal,  SupportTicketStatus.Waiting,    SupportTicketCategory.Question, "12h remaining", "Sarah K.",   false),
        new("t5",  "#1243", "API rate limit errors on batch sync",   "Chris Anderson", SupportTicketPriority.High,    SupportTicketStatus.InProgress, SupportTicketCategory.Bug,      "3h remaining",  "Alex M.",    false),
        new("t6",  "#1242", "Mobile app crashes on iOS 18",          "Laura Martinez", SupportTicketPriority.Urgent,  SupportTicketStatus.Open,       SupportTicketCategory.Bug,      "20 min left",   "James L.",   false),
        new("t7",  "#1241", "Add dark mode to email templates",      "Kevin Zhou",     SupportTicketPriority.Low,     SupportTicketStatus.Open,       SupportTicketCategory.Feature,  "3 days left",   "Unassigned", false),
        new("t8",  "#1240", "Webhook delivery delays to Slack",      "Anna Bell",      SupportTicketPriority.High,    SupportTicketStatus.InProgress, SupportTicketCategory.Bug,      "1h remaining",  "Alex M.",    false),
        new("t9",  "#1239", "Billing FAQ and refund policy",         "Tom Hughes",     SupportTicketPriority.Low,     SupportTicketStatus.Resolved,   SupportTicketCategory.Question, "Resolved",      "Sarah K.",   true),
        new("t10", "#1238", "Two-factor auth not sending codes",     "Mia Johnson",    SupportTicketPriority.Urgent,  SupportTicketStatus.InProgress, SupportTicketCategory.Bug,      "15 min left",   "James L.",   false),
    ];

    private List<SupportTicket> _items = new List<SupportTicket>(_seed.OrderBy(t => (int)t.Priority));
    private string? _expanded = null;

    private void Toggle(string id)
    {
        var idx = _items.FindIndex(t => t.Id == id);
        if (idx >= 0) _items[idx] = _items[idx] with { Completed = !_items[idx].Completed };
    }

    private static string PriorityDotClass(SupportTicketPriority p) => p switch
    {
        SupportTicketPriority.Urgent => "bg-red-500",
        SupportTicketPriority.High   => "bg-amber-500",
        SupportTicketPriority.Normal => "bg-blue-500",
        SupportTicketPriority.Low    => "bg-zinc-400",
        _                            => "",
    };

    private static string CategoryColorClass(SupportTicketCategory c) => c switch
    {
        SupportTicketCategory.Bug      => "bg-red-500/10 text-red-700 dark:text-red-400",
        SupportTicketCategory.Feature  => "bg-purple-500/10 text-purple-700 dark:text-purple-400",
        SupportTicketCategory.Question => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        _                              => "",
    };

    private static string StatusLabel(SupportTicketStatus s) => s switch
    {
        SupportTicketStatus.Open       => "Open",
        SupportTicketStatus.InProgress => "In Progress",
        SupportTicketStatus.Waiting    => "Waiting",
        SupportTicketStatus.Resolved   => "Resolved",
        _                              => "",
    };
}
