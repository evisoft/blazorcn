@* ============================================================
   Block: billing-tax-id-verification
   Title: BillingTaxIdVerification
   Description: A real-time tax identification number (VAT, GST, EIN) verification block featuring international format validation and instant status feedback built with shadcn/ui.
   Source: original/blocks/billing/billing-tax-id-verification.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Tax Identification</span>
                </div>
                @if (_status == "verified")
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-emerald-500/10 text-emerald-600 border-emerald-500/20 text-[10px] uppercase font-bold">
                        Verified
                    </BadgeCn>
                }
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Enter your business tax ID for accurate invoicing and tax calculations.
            </p>
        </div>

        <div class="p-4 space-y-4">
            <div class="grid gap-4 sm:grid-cols-3">
                <div class="space-y-2">
                    <label class="text-xs font-medium uppercase text-muted-foreground tracking-tight">
                        Country
                    </label>
                    <SelectCn @bind-Value="_country">
                        <SelectTriggerCn aria-label="Country" Class="h-9">
                            <SelectValueCn Placeholder="Select" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="us">United States</SelectItemCn>
                            <SelectItemCn Value="de">Germany</SelectItemCn>
                            <SelectItemCn Value="gb">United Kingdom</SelectItemCn>
                            <SelectItemCn Value="fr">France</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="sm:col-span-2 space-y-2">
                    <label for="tax-id-verification-tax-id" class="text-xs font-medium uppercase text-muted-foreground tracking-tight">
                        VAT / Tax ID
                    </label>
                    <div class="relative">
                        <InputCn
                            id="tax-id-verification-tax-id"
                            @bind-Value="_taxId"
                            Placeholder="DE 123 456 789"
                            Class="@Cn.Merge("pr-8 font-mono", _status == "verified" ? "border-emerald-500/50 bg-emerald-50/30" : "")" />
                        <div class="absolute right-2.5 top-2.5">
                            @if (_status == "verifying")
                            {
                                <LucideIconCn Name="loader-2" Size="16" Class="size-4 animate-spin text-muted-foreground" />
                            }
                            @if (_status == "verified")
                            {
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                            }
                            @if (_status == "error")
                            {
                                <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-500" />
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (_status == "verified")
            {
                <div class="rounded-md border bg-muted/30 p-3">
                    <div class="flex items-start gap-3">
                        <div class="size-8 rounded border bg-background flex items-center justify-center shrink-0">
                            <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div>
                            <p class="text-xs font-bold text-foreground">ACME SOLUTIONS GMBH</p>
                            <p class="text-[11px] text-muted-foreground leading-relaxed mt-0.5">
                                Friedrichstra&#xDF;e 123, 10117 Berlin, Germany
                                <br />
                                Verified via VIES on @DateTime.Now.ToShortDateString()
                            </p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="rounded-md border border-dashed p-4 text-center">
                    <p class="text-xs text-muted-foreground italic">
                        @(_status == "error"
                            ? "We couldn't verify this ID. Please check the format and try again."
                            : "Verification ensures your invoices are correctly processed for VAT reverse-charge.")
                    </p>
                </div>
            }

            <div class="flex items-center justify-end gap-3 pt-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs" OnClick="@(() => _status = "idle")">
                    Cancel
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-4 text-xs" OnClick="HandleVerify" Disabled="@(_status == "verifying" || string.IsNullOrEmpty(_taxId))">
                    @(_status == "verifying" ? "Verifying..." : "Verify & Save")
                </ButtonCn>
            </div>
        </div>

        <div class="bg-muted/50 border-t px-4 py-2 text-center">
            <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
                Supports VAT, GST, EIN, and 40+ other regional tax IDs
            </p>
        </div>
    </div>
</section>

@code {
    private string _status = "idle";
    private string _country = "de";

    private string _taxId
    {
        get => _taxIdValue;
        set => _taxIdValue = value?.ToUpperInvariant() ?? "";
    }
    private string _taxIdValue = "";

    private async Task HandleVerify()
    {
        _status = "verifying";
        await Task.Delay(1500);
        _status = _taxIdValue.Length > 8 ? "verified" : "error";
    }
}
