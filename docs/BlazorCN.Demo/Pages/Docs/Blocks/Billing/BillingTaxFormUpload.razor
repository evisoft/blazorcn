@* ============================================================
   Block: billing-tax-form-upload
   Title: BillingTaxFormUpload
   Description: A secure tax form upload component for React and Next.js with file drag-and-drop, verification status, and tax year selection built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-tax-form-upload.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideFileTextCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Tax Documentation</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">
                2024 Fiscal Year
            </BadgeCn>
        </div>

        @* Form Selection *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-col gap-1">
                <h3 class="font-medium text-sm text-foreground">Form W-9 Request</h3>
                <p class="text-muted-foreground text-xs">
                    Please provide a signed W-9 form to verify your taxpayer identification number and
                    certification.
                </p>
            </div>
        </div>

        @* Upload Area *@
        <div class="border-b px-4 py-8">
            <div class="flex flex-col items-center justify-center rounded-md border border-dashed bg-muted/30 p-8 text-center">
                <div class="mb-3 flex size-10 items-center justify-center rounded-full bg-background border shadow-sm">
                    <LucideUploadCloudCn Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <div class="mb-1 text-sm">
                    <span class="font-medium text-foreground">Click to upload</span> or drag and drop
                </div>
                <p class="text-muted-foreground text-xs">PDF, JPG or PNG (max. 10MB)</p>
            </div>
        </div>

        @* Status *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="size-1.5 rounded-full bg-amber-500"></div>
                <span class="text-muted-foreground text-xs">Pending Upload</span>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Download Blank Form
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Save Document
                </ButtonCn>
            </div>
        </div>
    </div>
</section>
