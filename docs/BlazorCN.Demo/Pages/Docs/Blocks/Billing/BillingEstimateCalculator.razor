@* ============================================================
   Block: billing-estimate-calculator
   Title: BillingEstimateCalculator
   Description: A billing estimate and price calculator block for React and Next.js with interactive sliders and real-time cost projections built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-estimate-calculator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calculator" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Price Estimator</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Adjust the sliders below to estimate your monthly cost based on expected usage.
            </p>
        </div>

        <div class="p-6 space-y-8">
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <label for="users-slider" class="text-sm font-medium">
                            Active Users
                        </label>
                        <TooltipCn>
                            <TooltipTriggerCn>
                                <LucideIconCn Name="info" Size="14" Class="size-3.5 text-muted-foreground" />
                            </TooltipTriggerCn>
                            <TooltipContentCn Class="text-[10px]">
                                Billed at $12 per user / month
                            </TooltipContentCn>
                        </TooltipCn>
                    </div>
                    <span class="font-mono text-sm font-semibold">@((int)_users)</span>
                </div>
                <SliderCn id="users-slider"
                          @bind-Value="_users"
                          Max="200"
                          Step="5"
                          Class="py-2" />
            </div>

            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <label for="storage-slider" class="text-sm font-medium">
                            Storage (GB)
                        </label>
                        <TooltipCn>
                            <TooltipTriggerCn>
                                <LucideIconCn Name="info" Size="14" Class="size-3.5 text-muted-foreground" />
                            </TooltipTriggerCn>
                            <TooltipContentCn Class="text-[10px]">
                                Billed at $0.50 per GB / month
                            </TooltipContentCn>
                        </TooltipCn>
                    </div>
                    <span class="font-mono text-sm font-semibold">@((int)_storage) GB</span>
                </div>
                <SliderCn id="storage-slider"
                          @bind-Value="_storage"
                          Max="1000"
                          Step="10"
                          Class="py-2" />
            </div>
        </div>

        <div class="bg-muted/30 px-6 py-6 border-t">
            <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
                <div>
                    <p class="text-muted-foreground text-xs uppercase tracking-wider font-medium">
                        Estimated Monthly Total
                    </p>
                    <div class="mt-1 flex items-baseline gap-1 text-3xl font-bold tracking-tight">
                        <span>$</span>
                        <span>@Total.ToString("F2")</span>
                    </div>
                </div>
                <div class="flex flex-col gap-2 w-full sm:w-auto">
                    <ButtonCn Class="h-10 px-8">
                        Get Started
                    </ButtonCn>
                    <div class="flex items-center justify-center gap-1 text-emerald-600 dark:text-emerald-400 text-[10px] font-medium">
                        <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                        <span>Includes 20% Annual Discount</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private double _users = 20;
    private double _storage = 50;

    private double Total => (_users * 12) + (_storage * 0.5);
}
