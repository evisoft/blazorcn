@* ============================================================
   Block: billing-referral-dashboard-mini
   Title: BillingReferralDashboardMini
   Description: A condensed partner performance block for React and Next.js featuring referral conversion tracking, click-through rates, and earned commission previews built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-referral-dashboard-mini.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Partner Performance</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px] uppercase h-5">
                May 2026
            </BadgeCn>
        </div>

        @* Main Earnings *@
        <div class="px-4 py-6 border-b text-center bg-muted/5">
            <p class="text-muted-foreground text-[10px] uppercase font-bold tracking-widest mb-1">Earned This Month</p>
            <div class="flex items-baseline justify-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                <span class="text-2xl font-medium">$</span>
                <span class="text-5xl font-bold tracking-tighter">
                    @_earnings.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)
                </span>
            </div>
        </div>

        @* Stats Grid *@
        <div class="grid grid-cols-3 divide-x border-b">
            <div class="px-4 py-4 text-center">
                <div class="flex items-center justify-center gap-1 text-muted-foreground text-[10px] uppercase font-bold tracking-tight mb-1">
                    <LucideIconCn Name="mouse-pointer-click" Size="12" Class="size-3" />
                    <span>Clicks</span>
                </div>
                <div class="font-semibold text-lg">
                    @_clicks.ToString("N0", System.Globalization.CultureInfo.InvariantCulture)
                </div>
            </div>
            <div class="px-4 py-4 text-center">
                <div class="flex items-center justify-center gap-1 text-muted-foreground text-[10px] uppercase font-bold tracking-tight mb-1">
                    <LucideIconCn Name="users-2" Size="12" Class="size-3" />
                    <span>Signups</span>
                </div>
                <div class="font-semibold text-lg">
                    @_signups
                </div>
            </div>
            <div class="px-4 py-4 text-center">
                <div class="flex items-center justify-center gap-1 text-muted-foreground text-[10px] uppercase font-bold tracking-tight mb-1">
                    <LucideIconCn Name="share-2" Size="12" Class="size-3" />
                    <span>Conv.</span>
                </div>
                <div class="flex items-baseline justify-center gap-0.5">
                    <span class="font-semibold text-lg">
                        @_conversionRate.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)
                    </span>
                    <span class="text-[10px] text-muted-foreground">%</span>
                </div>
            </div>
        </div>

        @* Link Share *@
        <div class="px-4 py-4">
            <div class="flex items-center gap-2 p-2 rounded-md bg-muted/30 border border-dashed">
                <span class="text-[10px] font-mono text-muted-foreground truncate flex-1">
                    https://shadcn.io/ref/dov_cli_agent_882
                </span>
                <ButtonCn Variant="ButtonVariant.Secondary" Size="ButtonSize.Sm" Class="h-7 px-3 text-[10px] font-bold uppercase shrink-0">
                    <LucideIconCn Name="copy" Size="12" Class="size-3 mr-1.5" />
                    Copy
                </ButtonCn>
            </div>
            <p class="mt-3 text-center text-muted-foreground text-[10px]">
                Share your unique referral link to earn 15% commission on every new customer.
            </p>
        </div>

        @* Footer Actions *@
        <div class="flex items-center gap-2 px-4 py-3 border-t bg-muted/10">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs w-full sm:w-auto">
                Full Dashboard
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs w-full sm:w-auto">
                Payout Settings
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private const int _clicks = 1240;
    private const int _signups = 42;
    private const double _earnings = 840.50;
    private static readonly double _conversionRate = (double)_signups / _clicks * 100;
}
