@* ============================================================
   Block: billing-subscription-swap-preview
   Title: BillingSubscriptionSwapPreview
   Description: A pro-rated billing preview block for React and Next.js to show cost changes and immediate charges when switching plans built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-subscription-swap-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="zap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Review Plan Change</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Upgrade
            </BadgeCn>
        </div>

        @* Plan Comparison *@
        <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr] items-center gap-4 px-6 py-8 border-b">
            <div class="space-y-1 text-center md:text-left">
                <p class="text-[10px] uppercase font-bold text-muted-foreground tracking-widest">Current Plan</p>
                <h4 class="font-semibold text-lg">Starter</h4>
                <p class="text-muted-foreground text-xs">$29/mo</p>
            </div>

            <div class="flex justify-center">
                <div class="size-8 rounded-full border bg-muted/50 flex items-center justify-center rotate-90 md:rotate-0">
                    <LucideIconCn Name="arrow-right" Size="16" Class="size-4 text-muted-foreground" />
                </div>
            </div>

            <div class="space-y-1 text-center md:text-right">
                <p class="text-[10px] uppercase font-bold text-primary tracking-widest">New Plan</p>
                <h4 class="font-semibold text-lg">Pro Business</h4>
                <p class="text-muted-foreground text-xs">$79/mo</p>
            </div>
        </div>

        @* Financial Breakdown *@
        <div class="px-6 py-6 space-y-3">
            <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">New Plan (Pro-rated)</span>
                <span class="font-medium tabular-nums">$@(_proratedCharge.ToString("F2"))</span>
            </div>
            <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Unused Starter Credit</span>
                <span class="text-emerald-600 font-medium tabular-nums">@(_creditAmount.ToString("F2"))</span>
            </div>
            <div class="flex items-center justify-between text-sm">
                <span class="text-muted-foreground">Estimated Tax (8%)</span>
                <span class="font-medium tabular-nums">$@(_taxAmount.ToString("F2"))</span>
            </div>

            <div class="pt-3 mt-3 border-t flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="receipt" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-semibold text-sm">Total Due Today</span>
                </div>
                <div class="flex items-baseline gap-1">
                    <span class="text-sm font-medium">$</span>
                    <span class="text-2xl font-bold tracking-tight">@(_totalDueToday.ToString("F2"))</span>
                </div>
            </div>
        </div>

        @* Confirmation Note *@
        <div class="px-6 py-4 bg-muted/30 text-center">
            <p class="text-muted-foreground text-[11px] leading-relaxed">
                Your new features will be unlocked immediately. Your billing cycle remains the 24th of each month. Your next full invoice for <span class="text-foreground font-medium">$79.00</span> will be generated on June 24, 2026.
            </p>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3 border-t">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                <LucideIconCn Name="check" Size="12" Class="size-3" />
                Confirm Plan Swap
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs text-muted-foreground">
                Cancel
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private const decimal _proratedCharge = 42.80m;
    private const decimal _taxAmount = 3.42m;
    private const decimal _creditAmount = -12.45m;
    private decimal _totalDueToday => _proratedCharge + _taxAmount;
}
