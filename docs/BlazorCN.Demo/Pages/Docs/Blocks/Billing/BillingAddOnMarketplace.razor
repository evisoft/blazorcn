@* ============================================================
   Block: billing-add-on-marketplace
   Title: BillingAddOnMarketplace
   Description: A modular marketplace block for browsing and purchasing optional SaaS features, add-ons, or usage-based boosters.
   Source: original/blocks/billing/billing-add-on-marketplace.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="plus" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Feature Add-ons</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Customize your plan with extra features and boosters. Billed to your monthly invoice.
            </p>
        </div>

        <div class="divide-y">
            @foreach (var item in _addOns)
            {
                var isActive = _activeIds.Contains(item.Id);
                <div class="flex items-start gap-4 p-4 transition-colors hover:bg-muted/30">
                    <div class="size-9 rounded-lg border bg-muted/50 flex items-center justify-center shrink-0">
                        <div class="text-foreground">
                            <LucideIconCn Name="@item.IconName" Size="16" Class="size-4" />
                        </div>
                    </div>

                    <div class="flex-1 space-y-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@item.Name</span>
                            @if (item.Tag != null)
                            {
                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 px-1 text-[8px] font-bold uppercase">
                                    @item.Tag
                                </BadgeCn>
                            }
                        </div>
                        <p class="text-xs text-muted-foreground leading-relaxed">
                            @item.Description
                        </p>
                    </div>

                    <div class="flex flex-col items-end gap-2 shrink-0">
                        <span class="font-semibold text-sm">
                            $@item.Price
                            <span class="text-[10px] text-muted-foreground font-normal">/mo</span>
                        </span>
                        <ButtonCn Size="ButtonSize.Sm"
                                  Variant="@(isActive ? ButtonVariant.Secondary : ButtonVariant.Outline)"
                                  Class="@Cn.Merge("h-7 px-2.5 text-xs font-medium gap-1.5", isActive ? "bg-emerald-500/10 text-emerald-600 hover:bg-emerald-500/20 border-emerald-500/20" : "")"
                                  OnClick="@(() => ToggleAddOn(item.Id))">
                            @if (isActive)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                                <text>Added</text>
                            }
                            else
                            {
                                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                <text>Add</text>
                            }
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        <div class="bg-muted/50 border-t px-4 py-2.5 text-center">
            <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-semibold">
                All add-ons include a 7-day free trial
            </p>
        </div>
    </div>
</section>

@code {
    private record AddOn(string Id, string Name, string Description, int Price, string IconName, string? Tag = null);

    private static readonly AddOn[] _addOns =
    [
        new("extra-storage", "100GB Extra Storage", "Expand your storage capacity for media assets and databases.", 10, "layers", "Popular"),
        new("advanced-security", "Advanced Security", "SSO, Audit Logs, and IP Whitelisting for your team.", 29, "shield-check", "Enterprise"),
        new("priority-support", "Priority Support", "24/7 dedicated account manager and 1-hour response time.", 49, "zap"),
    ];

    private List<string> _activeIds = ["extra-storage"];

    private void ToggleAddOn(string id)
    {
        if (_activeIds.Contains(id))
            _activeIds.Remove(id);
        else
            _activeIds.Add(id);
    }
}
