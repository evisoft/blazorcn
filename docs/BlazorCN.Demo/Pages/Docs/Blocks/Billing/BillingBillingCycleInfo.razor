@* ============================================================
   Block: billing-billing-cycle-info
   Title: BillingBillingCycleInfo
   Description: A transparent billing information block that clarifies next billing dates, prorated charges, and cycle duration for active subscriptions.
   Source: original/blocks/billing/billing-billing-cycle-info.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        <div class="border-b px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="refresh-cw" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Billing Cycle</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-bold uppercase tracking-tight h-5">
                Monthly
            </BadgeCn>
        </div>

        <div class="p-4 space-y-6">
            <div class="flex items-center gap-6">
                <div class="flex-1 space-y-1">
                    <div class="flex items-center gap-2 text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                        Current Period
                    </div>
                    <p class="text-sm font-semibold">May 12, 2026 — June 12, 2026</p>
                    <div class="w-full h-1.5 bg-muted rounded-full overflow-hidden mt-2">
                        <div class="h-full bg-primary" style="width:65%"></div>
                    </div>
                    <p class="text-[10px] text-muted-foreground pt-1">
                        20 days remaining in this cycle
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="p-3 rounded-lg border bg-muted/20 space-y-2">
                    <div class="flex items-center gap-2 text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                        Next Charge
                    </div>
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-lg font-bold tracking-tight">$49.00</span>
                        <span class="text-[10px] text-muted-foreground font-medium uppercase">
                            on June 12
                        </span>
                    </div>
                </div>
                <div class="p-3 rounded-lg border bg-muted/20 space-y-2">
                    <div class="flex items-center gap-2 text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        <LucideIconCn Name="help-circle" Size="12" Class="size-3" />
                        Proration
                    </div>
                    <p class="text-xs text-muted-foreground leading-snug">
                        Changes made mid-cycle will be adjusted on your next invoice.
                    </p>
                </div>
            </div>

            <div class="rounded-lg border border-dashed p-3 bg-muted/10">
                <p class="text-[11px] text-muted-foreground leading-relaxed text-center">
                    <b>Switch to Annual Billing</b> and get 2 months free. All remaining time on your
                    monthly plan will be credited instantly.
                </p>
            </div>
        </div>

        <div class="bg-muted/50 border-t px-4 py-2.5 flex items-center justify-between text-[10px] font-semibold text-muted-foreground uppercase tracking-widest">
            <span>Started: Dec 12, 2025</span>
            <span class="text-primary hover:underline cursor-pointer">Change Cycle</span>
        </div>
    </div>
</section>
