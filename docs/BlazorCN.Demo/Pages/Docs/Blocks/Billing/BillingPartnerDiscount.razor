@* ============================================================
   Block: billing-partner-discount
   Title: BillingPartnerDiscount
   Description: A specialized UI for displaying and applying partner-specific discounts (e.g., startup credits, accelerator perks) for React and Next.js, built with shadcn/ui.
   Source: original/blocks/billing/billing-partner-discount.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rocket" Size="16" Class="size-4 text-blue-500" />
                <span class="font-medium text-sm">Partner Benefits</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                You have active partner discounts applied to your workspace balance.
            </p>
        </div>

        @* Discount List *@
        <div class="divide-y">
            @foreach (var discount in _activeDiscounts)
            {
                <div class="flex items-center justify-between px-4 py-4">
                    <div class="flex items-center gap-3">
                        <div class="flex size-9 items-center justify-center rounded-lg bg-muted/50">
                            @if (discount.Type == "credit")
                            {
                                <LucideIconCn Name="gift" Size="16" Class="size-4 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideIconCn Name="ticket" Size="16" Class="size-4 text-muted-foreground" />
                            }
                        </div>
                        <div class="space-y-0.5">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@discount.Partner</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[9px] uppercase tracking-wider">
                                    Active
                                </BadgeCn>
                            </div>
                            <p class="text-muted-foreground text-xs">@discount.Description</p>
                        </div>
                    </div>
                    <div class="text-right">
                        @if (discount.Type == "credit")
                        {
                            <div class="flex flex-col items-end">
                                <span class="font-semibold text-sm tabular-nums text-emerald-600">
                                    $@(discount.Remaining)
                                </span>
                                <span class="text-[10px] text-muted-foreground uppercase">Remaining</span>
                            </div>
                        }
                        else
                        {
                            <span class="font-semibold text-sm text-emerald-600">
                                -@(discount.Amount)%
                            </span>
                        }
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="bg-muted/30 p-4">
            <div class="flex gap-2">
                <input type="text" placeholder="Enter partner code"
                       class="h-9 flex-1 rounded-md border bg-background px-3 text-sm focus:outline-none focus:ring-1 focus:ring-ring" />
                <ButtonCn Size="ButtonSize.Sm" Class="h-9">Apply</ButtonCn>
            </div>
            <p class="mt-2 text-[10px] text-muted-foreground text-center">
                One discount per billing cycle. Credits are applied automatically.
            </p>
        </div>
    </div>
</section>

@code {
    private record Discount(string Id, string Partner, int Amount, string Type, string Description, int Remaining = 0);

    private static readonly Discount[] _activeDiscounts =
    [
        new("1", "AWS Activate", 5000, "credit", "Startup cloud credits applied to your bill.", 3240),
        new("2", "Product Hunt", 20, "percent", "20% off for the first 12 months."),
    ];
}
