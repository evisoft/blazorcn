@* ============================================================
   Block: billing-compliance-certificate-request
   Title: BillingComplianceCertificateRequest
   Description: A specialized component for requesting tax residency and compliance certificates in React and Next.js with multi-region support and automated fulfillment built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-compliance-certificate-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Compliance Certificates</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs uppercase tracking-wider">
                Enterprise
            </BadgeCn>
        </div>

        @* Content *@
        <div class="border-b px-4 py-4">
            <h3 class="font-medium text-sm text-foreground">Request Tax Residency</h3>
            <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                Need official documentation for your local tax authorities? Select a jurisdiction below to
                request a signed certificate of residency or tax compliance.
            </p>
        </div>

        @* Jurisdiction List *@
        <div class="border-b px-2 py-2">
            <div class="space-y-1">
                @foreach (var item in _jurisdictions)
                {
                    <button
                        disabled="@(!item.Available ? "disabled" : null)"
                        class="flex w-full items-center justify-between rounded-md px-3 py-2 text-left transition-colors hover:bg-muted/50 disabled:opacity-50 disabled:hover:bg-transparent">
                        <div class="flex items-center gap-3">
                            <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm">@item.Name</span>
                        </div>
                        @if (item.Available)
                        {
                            <LucideIconCn Name="chevron-right" Size="16" Class="size-4 text-muted-foreground" />
                        }
                        else
                        {
                            <span class="text-[10px] text-muted-foreground uppercase">On Request</span>
                        }
                    </button>
                }
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="info" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs underline underline-offset-4 cursor-help">
                    Processing times
                </span>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    History
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Request Certificate
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Jurisdiction(string Name, bool Available);

    private static readonly Jurisdiction[] _jurisdictions =
    [
        new("United States (W-9)", true),
        new("European Union (VAT)", true),
        new("United Kingdom", true),
        new("Singapore", false),
    ];
}
