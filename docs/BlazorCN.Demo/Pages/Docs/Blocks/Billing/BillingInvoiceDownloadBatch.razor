@* ============================================================
   Block: billing-invoice-download-batch
   Title: BillingInvoiceDownloadBatch
   Description: A billing invoice export and batch download block for React and Next.js with date range filters and ZIP generation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-invoice-download-batch.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-archive" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Batch Export</span>
            </div>
            <div class="flex items-center gap-2">
                <div class="relative">
                    <LucideIconCn Name="search" Size="14" Class="absolute left-2 top-2.5 size-3.5 text-muted-foreground" />
                    <InputCn Placeholder="Search..." Class="h-8 w-40 pl-8 text-xs" />
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="h-8 w-8">
                    <LucideIconCn Name="filter" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        <div class="divide-y">
            <div class="flex items-center justify-between px-4 py-2 bg-muted/30">
                <div class="flex items-center gap-3">
                    <CheckboxCn id="select-all"
                                Checked="@(_selected.Count == _invoices.Length)"
                                CheckedChanged="@((_) => ToggleAll())" />
                    <label for="select-all" class="text-xs font-medium cursor-pointer">
                        Select All Invoices
                    </label>
                </div>
                <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-semibold">
                    @_selected.Count Selected
                </p>
            </div>

            @foreach (var invoice in _invoices)
            {
                <div class="flex items-center justify-between px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex items-center gap-3">
                        <CheckboxCn Checked="@(_selected.Contains(invoice.Id))"
                                    CheckedChanged="@((_) => ToggleOne(invoice.Id))" />
                        <div class="min-w-0">
                            <p class="font-medium text-sm">@invoice.Id</p>
                            <p class="text-muted-foreground text-[11px]">@invoice.Date</p>
                        </div>
                    </div>
                    <span class="font-semibold text-xs tabular-nums">
                        $@invoice.Amount.ToString("F2")
                    </span>
                </div>
            }
        </div>

        <div class="bg-muted/30 px-4 py-3 border-t">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                <p class="text-muted-foreground text-[10px]">
                    Selected invoices will be bundled into a ZIP archive for easy download.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="h-9 gap-2 shadow-sm shrink-0" Disabled="@(_selected.Count == 0)">
                    <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                    Download @_selected.Count PDFs
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private readonly List<string> _selected = new();

    private record Invoice(string Id, string Date, double Amount);

    private static readonly Invoice[] _invoices =
    [
        new("INV-2026-003", "Mar 24, 2026", 49.0),
        new("INV-2026-002", "Feb 24, 2026", 49.0),
        new("INV-2026-001", "Jan 24, 2026", 49.0),
        new("INV-2025-012", "Dec 24, 2025", 129.0),
        new("INV-2025-011", "Nov 24, 2025", 49.0),
    ];

    private void ToggleAll()
    {
        if (_selected.Count == _invoices.Length)
        {
            _selected.Clear();
        }
        else
        {
            _selected.Clear();
            foreach (var inv in _invoices)
                _selected.Add(inv.Id);
        }
    }

    private void ToggleOne(string id)
    {
        if (_selected.Contains(id))
            _selected.Remove(id);
        else
            _selected.Add(id);
    }
}
