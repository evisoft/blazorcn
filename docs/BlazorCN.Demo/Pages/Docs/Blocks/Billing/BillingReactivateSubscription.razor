@* ============================================================
   Block: billing-reactivate-subscription
   Title: BillingReactivateSubscription
   Description: A win-back billing CTA for React and Next.js to help users resume cancelled subscriptions before their access expires built with shadcn/ui and Framer Motion.
   Source: original/blocks/billing/billing-reactivate-subscription.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-blue-500/20 bg-card">
        <div class="flex flex-col gap-4 p-4 sm:flex-row sm:items-start">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-blue-500/10 text-blue-600 dark:bg-blue-500/20 dark:text-blue-400">
                <LucideIconCn Name="refresh-ccw" Size="20" Class="size-5" />
            </div>

            <div class="flex-1 space-y-3">
                <div>
                    <h3 class="font-medium text-sm">Resume your subscription</h3>
                    <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                        Your <strong>@_planName</strong> plan is scheduled to end on @_expiryDate.
                        Reactivate now to keep your features, data, and API access without interruption.
                    </p>
                </div>

                <div class="grid gap-2 sm:grid-cols-2">
                    <div class="flex items-center gap-2 rounded-md border bg-muted/30 px-3 py-2">
                        <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">
                            <span class="font-semibold text-foreground">@_daysLeft days</span> of access
                            remaining
                        </span>
                    </div>
                    <div class="flex items-center gap-2 rounded-md border bg-muted/30 px-3 py-2">
                        <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">No extra fees to resume</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-col items-center justify-between gap-4 border-t bg-muted/20 px-4 py-3 sm:flex-row">
            <div class="flex items-baseline gap-1.5">
                <span class="text-xl font-semibold tabular-nums tracking-tight">
                    @_price.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-US"))
                </span>
                <span class="text-muted-foreground text-xs">/month after June 15</span>
            </div>

            <div class="flex w-full items-center gap-2 sm:w-auto">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="flex-1 sm:flex-none">
                    Keep Cancelled
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="flex-1 gap-2 sm:flex-none">
                    <LucideIconCn Name="sparkles" Size="14" Class="size-3.5" />
                    Reactivate Plan
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string _planName = "Pro Monthly";
    private decimal _price = 49.0m;
    private int _daysLeft = 14;
    private string _expiryDate = "June 15, 2026";
}
