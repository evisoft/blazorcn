@* ============================================================
   Block: billing-departmental-billing-split
   Title: BillingDepartmentalBillingSplit
   Description: A complex cost allocation component for React and Next.js that allows users to distribute the cost of shared resources across multiple departments by percentage built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-departmental-billing-split.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="pie-chart" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Billing Split: Global Cluster</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-[10px] uppercase tracking-wider">
                Consolidated
            </BadgeCn>
        </div>

        @* Visual Split Bar *@
        <div class="px-4 py-6 border-b">
            <div class="mb-3 flex items-center justify-between text-xs">
                <span class="font-medium text-muted-foreground uppercase tracking-widest">Distribution Overview</span>
                <span class="font-semibold">Total: 100%</span>
            </div>
            <div class="flex h-3 w-full overflow-hidden rounded-full">
                @foreach (var split in _splits)
                {
                    <div class="@split.Color" style="@($"width:{split.Percentage}%")"></div>
                }
            </div>
        </div>

        @* Allocation List *@
        <div class="divide-y">
            @foreach (var split in _splits)
            {
                <div class="flex items-center justify-between px-4 py-3">
                    <div class="flex items-center gap-3">
                        <div class="@Cn.Merge("size-2 rounded-full", split.Color)"></div>
                        <span class="text-sm font-medium">@split.Name</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <div class="flex items-center gap-1 rounded-md border bg-muted/20 px-2 py-1">
                            <span class="text-xs font-semibold">@split.Percentage</span>
                            <span class="text-[10px] text-muted-foreground">%</span>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0 text-muted-foreground hover:text-destructive">
                            <LucideIconCn Name="trash-2" Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Actions and Footer *@
        <div class="bg-muted/10 px-4 py-3">
            <div class="flex items-center justify-between mb-4">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                    Add Department
                </ButtonCn>
                <div class="flex items-center gap-1 text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
                    <LucideIconCn Name="info" Size="12" Class="size-3" />
                    Changes apply next month
                </div>
            </div>
            <div class="flex items-center gap-2 border-t pt-3">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs ml-auto">
                    Reset Split
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="save" Size="14" Class="size-3.5" />
                    Save Allocation
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Split(string Id, string Name, int Percentage, string Color);

    private static readonly Split[] _splits =
    [
        new("1", "Engineering", 60, "bg-foreground"),
        new("2", "Marketing",   25, "bg-muted-foreground"),
        new("3", "Research",    15, "bg-muted"),
    ];
}
