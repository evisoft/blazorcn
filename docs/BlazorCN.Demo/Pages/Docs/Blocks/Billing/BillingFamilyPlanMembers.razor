@* ============================================================
   Block: billing-family-plan-members
   Title: BillingFamilyPlanMembers
   Description: A user-facing subscription management block for React and Next.js to manage shared family or team seats within a single billing account built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-family-plan-members.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Family Members</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px] uppercase tracking-wide">
                @_occupiedSeats / @_maxSeats Seats Used
            </BadgeCn>
        </div>

        @* Member List *@
        <div class="divide-y">
            @foreach (var member in _members)
            {
                <div class="flex items-center justify-between px-4 py-4 hover:bg-muted/10 transition-colors">
                    <div class="flex items-center gap-3">
                        <AvatarCn Class="size-9 border">
                            @if (member.HasImage)
                            {
                                <AvatarImageCn Src="@member.Image" Alt="@member.Name" />
                            }
                            <AvatarFallbackCn Class="text-xs bg-muted">
                                @(member.Role == "Invited" ? "?" : GetInitials(member.Name))
                            </AvatarFallbackCn>
                        </AvatarCn>
                        <div class="space-y-0.5">
                            <div class="flex items-center gap-2">
                                <p class="@Cn.Merge("text-sm font-medium leading-none", member.Role == "Invited" ? "text-muted-foreground italic" : "")">@member.Name</p>
                                @if (member.Role == "Owner")
                                {
                                    <BadgeCn Class="h-4 px-1.5 text-[9px] uppercase font-bold bg-primary/10 text-primary border-none">You</BadgeCn>
                                }
                            </div>
                            <p class="text-muted-foreground text-[11px]">@member.Email</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-2">
                        @if (member.Role == "Invited")
                        {
                            <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 text-[9px] uppercase font-bold border-amber-200 text-amber-700 bg-amber-50">Pending</BadgeCn>
                        }
                        else
                        {
                            <span class="text-muted-foreground text-[10px] font-medium mr-2">@member.Role</span>
                        }
                        @if (member.Role != "Owner")
                        {
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7 rounded-full text-muted-foreground">
                                <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                            </ButtonCn>
                        }
                    </div>
                </div>
            }

            @* Empty Seat *@
            <div class="flex items-center justify-between px-4 py-6 border-dashed border-t bg-muted/5">
                <div class="flex items-center gap-3 opacity-40">
                    <div class="size-9 rounded-full border border-dashed flex items-center justify-center">
                        <LucideIconCn Name="plus" Size="16" Class="size-4" />
                    </div>
                    <div class="space-y-1">
                        <div class="h-3 w-24 bg-muted rounded-full animate-pulse"></div>
                        <div class="h-2 w-32 bg-muted rounded-full animate-pulse"></div>
                    </div>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs gap-1.5 border-dashed">
                    <LucideIconCn Name="mail-plus" Size="14" Class="size-3.5" />
                    Invite
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-4 bg-muted/20 border-t">
            <p class="text-muted-foreground text-[11px] leading-relaxed">
                Members of your family plan get full access to all <span class="text-foreground font-medium">Pro features</span>. You will be billed for the total number of occupied seats.
            </p>
        </div>
    </div>
</section>

@code {
    private record Member(string Id, string Name, string Email, string Role, bool HasImage, string Image = "");

    private static readonly Member[] _members =
    [
        new("m1", "Sarah Johnson", "sarah@example.com", "Owner", true, "/avatars/sarah.png"),
        new("m2", "Michael Chen", "m.chen@example.com", "Member", true, "/avatars/michael.png"),
        new("m3", "Emma Wilson", "emma.w@example.com", "Member", true, "/avatars/emma.png"),
        new("m4", "Pending Invite", "david.r@example.com", "Invited", false),
    ];

    private const int _maxSeats = 6;
    private int _occupiedSeats => _members.Length;

    private static string GetInitials(string name)
    {
        var sb = new System.Text.StringBuilder();
        foreach (var part in name.Split(' '))
        {
            if (part.Length > 0) sb.Append(part[0]);
        }
        return sb.ToString();
    }
}
