@* ============================================================
   Block: billing-base-fee-breakdown
   Title: BillingBaseFeeBreakdown
   Description: A detailed cost breakdown block that explains the components of a base subscription fee, including platform costs and included features.
   Source: original/blocks/billing/billing-base-fee-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        <div class="border-b px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layout-list" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Base Fee Breakdown</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-bold uppercase tracking-tight h-5">
                Pro Plan
            </BadgeCn>
        </div>

        <div class="divide-y divide-muted/50">
            @foreach (var item in _items)
            {
                <div class="flex items-center justify-between p-4">
                    <div class="space-y-0.5">
                        <div class="flex items-center gap-1.5">
                            <span class="text-sm font-medium">@item.Name</span>
                            <LucideIconCn Name="circle-help" Size="12" Class="size-3 text-muted-foreground/50 cursor-help" />
                        </div>
                        <p class="text-xs text-muted-foreground leading-relaxed">@item.Description</p>
                    </div>
                    <div class="text-right">
                        <span class="text-sm font-semibold tabular-nums">
                            @if (item.Price == 0)
                            {
                                <span class="text-emerald-500 uppercase text-[10px] font-bold tracking-tight">
                                    Included
                                </span>
                            }
                            else
                            {
                                @($"${item.Price:F2}")
                            }
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="bg-muted/30 p-4 border-t space-y-4">
            <div class="flex items-center justify-between">
                <span class="text-sm font-bold">Monthly Base Total</span>
                <div class="text-xl font-bold tracking-tight tabular-nums">
                    @($"${_total:F2}")
                </div>
            </div>

            <div class="flex items-start gap-3 p-3 rounded-lg border bg-background/50">
                <LucideIconCn Name="info" Size="16" Class="size-4 text-muted-foreground mt-0.5" />
                <p class="text-[11px] text-muted-foreground leading-relaxed">
                    Base fees are billed in advance at the start of each cycle. Usage-based costs (API
                    calls, storage overages) will be added to your next invoice.
                </p>
            </div>
        </div>

        <div class="bg-muted/50 border-t px-4 py-2.5">
            <p class="text-center text-[10px] text-muted-foreground uppercase tracking-widest font-semibold">
                Next billing date: June 12, 2026
            </p>
        </div>
    </div>
</section>

@code {
    private record BillingItem(string Name, string Description, double Price);

    private static readonly BillingItem[] _items =
    [
        new("Platform Access", "Core infrastructure & dashboard", 29.0),
        new("Included Seats (5)", "First 5 team members are free", 0.0),
        new("SLA Guarantee", "99.9% uptime commitment", 10.0),
        new("Priority Support", "Standard email support (24h)", 0.0),
    ];

    private static readonly double _total = 39.0;
}
