@* ============================================================
   Block: billing-cart-mini
   Title: BillingCartMini
   Description: A compact shopping cart preview block for React and Next.js with item counters, dynamic subtotals using NumberFlow, and quick checkout actions built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-cart-mini.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-lg">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shopping-cart" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Your Cart (@_items.Length)</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8">
                <LucideIconCn Name="x" Size="16" Class="size-4 text-muted-foreground" />
            </ButtonCn>
        </div>

        @* Item List *@
        <div class="max-h-[300px] overflow-y-auto divide-y bg-muted/5">
            @foreach (var item in _items)
            {
                <div class="flex items-center justify-between px-4 py-3">
                    <div class="min-w-0 flex-1">
                        <p class="font-medium text-sm truncate">@item.Name</p>
                        <p class="text-muted-foreground text-xs">
                            @item.Quantity × $@item.Price.ToString("F2")
                        </p>
                    </div>
                    <div class="flex items-center gap-3">
                        <span class="font-medium text-sm tabular-nums">
                            $@((item.Price * item.Quantity).ToString("F2"))
                        </span>
                        <button type="button" class="text-muted-foreground/50 transition-colors hover:text-red-500">
                            <LucideIconCn Name="trash-2" Size="14" Class="size-3.5" />
                        </button>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="space-y-4 border-t px-4 py-4">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-sm">Subtotal</span>
                <div class="flex items-baseline gap-1">
                    <span class="text-muted-foreground text-xs">$</span>
                    <span class="text-lg font-semibold tracking-tight tabular-nums">
                        @_subtotal.ToString("F2")
                    </span>
                </div>
            </div>
            <p class="text-center text-muted-foreground text-[10px]">
                Tax and shipping calculated at next step.
            </p>
            <ButtonCn Class="w-full h-9">
                Continue to Checkout
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record CartItem(string Id, string Name, decimal Price, int Quantity);

    private static readonly CartItem[] _items =
    [
        new("1", "Pro Plan (Monthly)", 49.0m, 1),
        new("2", "Extra Team Seats", 12.0m, 2),
        new("3", "Advanced Security Add-on", 29.0m, 1),
    ];

    private decimal _subtotal => _items.Sum(item => item.Price * item.Quantity);
}
