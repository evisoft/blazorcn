@* ============================================================
   Block: billing-metered-usage-forecast
   Title: BillingMeteredUsageForecast
   Description: A predictive usage analytics component for React and Next.js forecasting upcoming costs based on real-time consumption patterns built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-metered-usage-forecast.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="target" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Usage Forecast</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">
                @_daysRemaining days left
            </BadgeCn>
        </div>

        @* Cost Projection *@
        <div class="grid grid-cols-2 divide-x border-b">
            <div class="flex flex-col gap-1 px-4 py-5">
                <span class="text-xs font-medium text-muted-foreground">Current Spending</span>
                <div class="flex items-baseline gap-1">
                    <span class="text-2xl font-semibold">$</span>
                    <span class="text-2xl font-semibold">@_currentSpending.ToString("F2")</span>
                </div>
                <div class="flex items-center gap-1 text-[10px] text-muted-foreground uppercase tracking-tight">
                    <LucideIconCn Name="wallet" Size="12" Class="size-3" />
                    Accumulated cost
                </div>
            </div>

            <div class="flex flex-col gap-1 px-4 py-5 bg-muted/30">
                <span class="text-xs font-medium text-foreground">Projected Total</span>
                <div class="flex items-baseline gap-1 text-emerald-600">
                    <span class="text-2xl font-semibold">$</span>
                    <span class="text-2xl font-semibold">@_projectedSpending.ToString("F2")</span>
                </div>
                <div class="flex items-center gap-1 text-[10px] text-emerald-600 uppercase tracking-tight">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                    Estimated for May
                </div>
            </div>
        </div>

        @* Insight *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-xs leading-relaxed">
                Based on your usage of <strong>1,240 API requests</strong> over the last 18 days,
                we expect your total volume to reach <strong>2,158 requests</strong> by month-end.
            </p>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="info" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs underline underline-offset-4 cursor-help">
                    How we calculate this
                </span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                Set Budget Alert
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const double _currentSpending = 124.50;
    private const double _projectedSpending = 215.80;
    private const int _daysRemaining = 12;
}
