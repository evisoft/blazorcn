@* ============================================================
   Block: billing-gift-subscription
   Title: BillingGiftSubscription
   Description: A billing gift subscription and voucher block for React and Next.js with personalized messaging and redemption flows built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-gift-subscription.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">

        <div class="bg-primary/5 px-4 py-8 text-center border-b">
            <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-primary text-primary-foreground shadow-sm">
                <LucideIconCn Name="gift" Size="24" Class="size-6" />
            </div>
            <h2 class="mt-4 font-semibold text-xl tracking-tight">Gift a Pro Subscription</h2>
            <p class="mt-2 text-muted-foreground text-sm">
                Share the power of our tools with a colleague or friend. They'll receive an email with
                their access code instantly.
            </p>
        </div>

        <div class="p-6 space-y-6">
            <div class="space-y-3">
                <LabelCn Class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                    Select Duration
                </LabelCn>
                <div class="grid grid-cols-3 gap-3">
                    @foreach (var d in _durations)
                    {
                        <label for="@d.Id"
                               class="flex cursor-pointer flex-col items-center gap-1 rounded-md border p-3 text-center transition-colors hover:bg-muted/50 @(_selectedDuration == d.Id ? "border-primary/50 bg-primary/5" : "")">
                            <input type="radio" name="duration" value="@d.Id" id="@d.Id" class="sr-only"
                                   checked="@(_selectedDuration == d.Id)"
                                   @onclick="@(() => _selectedDuration = d.Id)" />
                            <span class="font-medium text-sm">@d.Label</span>
                            <span class="text-muted-foreground text-xs">$@d.Price</span>
                        </label>
                    }
                </div>
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-1.5">
                    <LabelCn For="recipient-email" Class="text-xs font-medium">
                        Recipient Email
                    </LabelCn>
                    <InputCn id="recipient-email" Placeholder="friend@example.com" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="sender-name" Class="text-xs font-medium">
                        Your Name
                    </LabelCn>
                    <InputCn id="sender-name" Placeholder="Alex Chen" />
                </div>
            </div>

            <div class="space-y-1.5">
                <LabelCn For="message" Class="text-xs font-medium">
                    Personal Message (Optional)
                </LabelCn>
                <TextareaCn id="message" Placeholder="Happy Birthday! Enjoy the Pro tools." Class="min-h-[80px] text-sm" />
            </div>

            <ButtonCn Class="w-full h-10 gap-2 font-medium">
                <LucideIconCn Name="send" Size="16" Class="size-4" />
                Purchase Gift Subscription
            </ButtonCn>
        </div>

        <div class="bg-muted/30 px-4 py-3 border-t">
            <div class="flex items-center justify-center gap-2 text-muted-foreground text-[10px]">
                <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-amber-500" />
                <span>Recipient gets full Pro access + 100GB extra storage.</span>
            </div>
        </div>

    </div>
</section>

@code {
    private string _selectedDuration = "3m";

    private record Duration(string Id, string Label, int Price);

    private static readonly Duration[] _durations =
    [
        new("1m", "1 Month", 19),
        new("3m", "3 Months", 49),
        new("1y", "1 Year", 159),
    ];
}
