@* ============================================================
   Block: billing-history-chart
   Title: BillingHistoryChart
   Description: A billing spending history and usage chart block for React and Next.js with interactive data points and trend analysis built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-history-chart.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="area-chart" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Spending History</span>
            </div>
            <div class="flex items-center gap-1.5 text-[10px] font-medium uppercase tracking-wider text-emerald-600 dark:text-emerald-400">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                <span>+12% vs LY</span>
            </div>
        </div>

        <div class="p-6">
            <div class="relative h-48 w-full">
                <svg class="h-full w-full overflow-visible" viewBox="0 0 100 100" preserveAspectRatio="none">
                    <title>Spending History Chart</title>
                    <polyline
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="text-primary"
                        points="@_points" />
                    <path
                        d="@_fillPath"
                        class="fill-primary/5" />
                </svg>

                <div class="absolute inset-0 flex items-end justify-between px-1">
                    @foreach (var d in _data)
                    {
                        <div class="flex flex-col items-center gap-2 translate-y-6">
                            <div
                                class="size-2 rounded-full border-2 border-background bg-primary shadow-sm"
                                style="@($"position:absolute;bottom:{(d.Amount / (double)_max) * 100:F1}%;left:50%;transform:translate(-50%, 50%)")" />
                            <span class="text-[10px] font-medium text-muted-foreground uppercase">
                                @d.Month
                            </span>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-12 grid grid-cols-3 gap-4 border-t pt-6">
                <div>
                    <p class="text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                        Current Month
                    </p>
                    <div class="mt-1 flex items-baseline gap-1 font-semibold text-lg tabular-nums">
                        <span>$</span>
                        <span>95</span>
                    </div>
                </div>
                <div>
                    <p class="text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                        Avg. Spending
                    </p>
                    <div class="mt-1 flex items-baseline gap-1 font-semibold text-lg tabular-nums">
                        <span>$</span>
                        <span>66.8</span>
                    </div>
                </div>
                <div>
                    <p class="text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                        Total YTD
                    </p>
                    <div class="mt-1 flex items-baseline gap-1 font-semibold text-lg tabular-nums">
                        <span>$</span>
                        <span>401</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-muted/30 px-4 py-2.5 text-center">
            <p class="text-muted-foreground text-[10px]">
                Visual projections are based on your current seat count and usage limits.
            </p>
        </div>
    </div>
</section>

@code {
    private record MonthData(string Month, int Amount);

    private static readonly MonthData[] _data =
    [
        new("Jan", 49), new("Feb", 52), new("Mar", 49),
        new("Apr", 84), new("May", 72), new("Jun", 95),
    ];

    private int _max => _data.Max(d => d.Amount);

    private string _points => string.Join(" ",
        _data.Select((d, i) =>
            $"{(i * 100.0) / (_data.Length - 1):F2},{100 - (d.Amount / (double)_max) * 100:F2}"));

    private string _fillPath => $"M0,100 L{_points} L100,100 Z";
}
