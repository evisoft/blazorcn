@* ============================================================
   Block: billing-grace-period-countdown
   Title: BillingGracePeriodCountdown
   Description: A high-urgency billing block for React and Next.js to display remaining access time during a payment grace period built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-grace-period-countdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-amber-50/50 dark:bg-amber-950/10">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-alert" Size="16" Class="size-4 text-amber-600 dark:text-amber-500" />
                <span class="font-medium text-sm text-amber-900 dark:text-amber-100">Temporary Access Active</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-[10px] uppercase border-amber-200 text-amber-700 bg-amber-100/50 dark:bg-amber-900/20 dark:text-amber-400 dark:border-amber-800">
                Grace Period
            </BadgeCn>
        </div>

        @* Countdown Section *@
        <div class="flex flex-col md:flex-row items-center gap-8 px-6 py-8">
            <div class="flex flex-col items-center justify-center shrink-0">
                <div class="relative flex items-center justify-center">
                    <svg class="size-24 -rotate-90">
                        <circle
                            cx="48"
                            cy="48"
                            r="44"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="4"
                            class="text-muted/30" />
                        <circle
                            cx="48"
                            cy="48"
                            r="44"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="4"
                            stroke-dasharray="276"
                            stroke-dashoffset="@_strokeDashoffset.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)"
                            class="text-amber-500" />
                    </svg>
                    <div class="absolute flex flex-col items-center">
                        <span class="text-3xl font-bold tracking-tighter leading-none">@_daysRemaining</span>
                        <span class="text-[10px] uppercase font-bold text-muted-foreground tracking-wider mt-0.5">Days</span>
                    </div>
                </div>
            </div>

            <div class="flex-1 space-y-4">
                <div>
                    <h3 class="font-semibold text-lg leading-snug">Resolve your payment issue</h3>
                    <p class="text-muted-foreground text-sm mt-1 leading-relaxed">
                        We were unable to process your recent renewal. Your Pro features remain active for <span class="text-foreground font-medium">@_daysRemaining more days</span> while you update your payment information.
                    </p>
                </div>

                <div class="space-y-2">
                    <div class="flex items-center justify-between text-xs text-muted-foreground">
                        <span>Grace Period Progress</span>
                        <span>Day @(_totalGraceDays - _daysRemaining) of @_totalGraceDays</span>
                    </div>
                    <ProgressCn Value="@((int)Math.Round(100 - _progress))" Class="h-1 bg-muted/50" aria-label="Progress" />
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex flex-col sm:flex-row items-center gap-3 px-4 py-4 border-t bg-muted/20">
            <ButtonCn Size="ButtonSize.Sm" Class="w-full sm:w-auto h-9 px-4 gap-1.5 text-xs font-semibold bg-amber-600 hover:bg-amber-700 text-white border-none">
                <LucideIconCn Name="credit-card" Size="14" Class="size-3.5" />
                Update Payment Method
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full sm:w-auto h-9 px-4 gap-1.5 text-xs">
                <LucideIconCn Name="clock" Size="14" Class="size-3.5" />
                View Last Invoice
            </ButtonCn>
            <p class="sm:ml-auto text-muted-foreground text-[10px] font-medium uppercase tracking-widest py-1">
                Ends June 12
            </p>
        </div>
    </div>
</section>

@code {
    private readonly int _daysRemaining = 4;
    private readonly int _totalGraceDays = 7;
    private double _progress => (_daysRemaining / (double)_totalGraceDays) * 100;
    private double _strokeDashoffset => 276 - (276 * _progress) / 100;
}
