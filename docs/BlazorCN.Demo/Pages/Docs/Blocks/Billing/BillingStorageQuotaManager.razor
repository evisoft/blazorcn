@* ============================================================
   Block: billing-storage-quota-manager
   Title: BillingStorageQuotaManager
   Description: A billing-integrated storage management block for SaaS platforms featuring usage visualization, dynamic quota upgrades, and cost calculation built with shadcn/ui.
   Source: original/blocks/billing/billing-storage-quota-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="hard-drive" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Storage Quota</span>
                </div>
                <BadgeCn Variant="@_badgeVariant" Class="text-[10px] uppercase font-bold tracking-tight px-1.5 py-0">
                    @_badgeLabel
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                You are using @(_currentUsage.ToString("F1"))GB of your @(_totalLimit.ToString("F1"))GB allocated storage. Upgrading
                expands your capacity instantly.
            </p>
        </div>

        <div class="p-4 space-y-6">
            <div class="space-y-3">
                <div class="flex items-end justify-between text-xs uppercase font-medium tracking-tight text-muted-foreground">
                    <span>Usage Overview</span>
                    <div class="flex items-center gap-1.5 text-foreground">
                        <span>@(_currentUsage.ToString("F1"))</span>
                        <span>/</span>
                        <span>@_totalLimit GB</span>
                    </div>
                </div>
                <ProgressCn Value="@_usagePercentage" Class="h-2" aria-label="Progress" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div class="rounded-md border border-dashed p-3">
                    <p class="text-[10px] uppercase font-bold text-muted-foreground tracking-widest mb-2">
                        Plan Details
                    </p>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-foreground">Pro Tier</span>
                        <span class="text-xs font-medium">$0.12 / GB</span>
                    </div>
                </div>
                <div class="rounded-md border border-dashed p-3">
                    <p class="text-[10px] uppercase font-bold text-muted-foreground tracking-widest mb-2">
                        Next Billing
                    </p>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-foreground">Apr 24, 2026</span>
                        <span class="text-xs font-medium">$9.88</span>
                    </div>
                </div>
            </div>

            <div class="rounded-lg border bg-muted/20 p-4">
                <div class="flex items-start justify-between">
                    <div class="space-y-1">
                        <h3 class="text-sm font-medium flex items-center gap-2">
                            <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-blue-500" />
                            Need more space?
                        </h3>
                        <p class="text-xs text-muted-foreground">
                            Add 100GB extra for just $10/month. No plan change required.
                        </p>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 gap-1.5 text-xs">
                        <LucideIconCn Name="plus" Size="12" Class="size-3" />
                        Add Storage
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="bg-muted/50 border-t px-4 py-2 text-center">
            <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
                Storage usage is calculated every 6 hours
            </p>
        </div>
    </div>
</section>

@code {
    private const double _currentUsage = 82.4;
    private const double _totalLimit = 100.0;
    private double _usagePercentage => (_currentUsage / _totalLimit) * 100;

    private BadgeVariant _badgeVariant => _usagePercentage > 90
        ? BadgeVariant.Destructive
        : BadgeVariant.Secondary;

    private string _badgeLabel => _usagePercentage > 90 ? "Critical"
        : _usagePercentage > 75 ? "Warning"
        : "Healthy";
}
