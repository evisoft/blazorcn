@* ============================================================
   Block: billing-subscription-summary
   Title: BillingSubscriptionSummary
   Description: A subscription summary block for React and Next.js with plan overview, usage bar, renewal date, and upgrade actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-subscription-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="zap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Current Plan</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Pro Monthly
            </BadgeCn>
        </div>

        @* Plan Info *@
        <div class="border-b px-4 py-3">
            <div class="flex items-baseline justify-between">
                <div>
                    <span class="font-semibold text-2xl tabular-nums">$49.00</span>
                    <span class="text-muted-foreground text-sm">/mo</span>
                </div>
                <p class="text-muted-foreground text-xs">Renews on Apr 24, 2026</p>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your plan includes advanced analytics, priority support, and 1,000 monthly reports.
            </p>
        </div>

        @* Usage *@
        <div class="border-b px-4 py-4">
            <div class="mb-2 flex items-center justify-between text-xs">
                <span class="font-medium text-muted-foreground">Monthly Reports</span>
                <span class="text-muted-foreground">
                    @_usage.ToString("N0") / @_limit.ToString("N0")
                </span>
            </div>
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-foreground" style="@($"width:{_percentage}%")"></div>
            </div>
            <p class="mt-2 text-muted-foreground text-xs">
                You have used 85% of your monthly report limit.
            </p>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                Upgrade Plan
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                Manage Subscription
            </ButtonCn>
            <div class="ml-auto flex items-center gap-2">
                <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Visa •••• 4242</span>
            </div>
        </div>

    </div>
</section>

@code {
    private const int _usage = 850;
    private const int _limit = 1000;
    private const double _percentage = 85.0;
}
