@* ============================================================
   Block: billing-revenue-analytics-mini
   Title: BillingRevenueAnalyticsMini
   Description: A condensed billing analytics block for React and Next.js showing spending trends, average costs, and monthly comparisons built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-revenue-analytics-mini.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="p-4 sm:p-6">
            <div class="flex items-center gap-2 mb-6">
                <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
                <h3 class="font-medium text-sm">Spending Summary</h3>
            </div>

            <div class="grid gap-6 sm:grid-cols-2">
                <div class="space-y-1">
                    <span class="text-muted-foreground text-xs uppercase tracking-wider font-medium">
                        This Month (est.)
                    </span>
                    <div class="flex items-baseline gap-2">
                        <span class="text-3xl font-bold tracking-tight tabular-nums">
                            @FormatUsd(_currentMonth)
                        </span>
                        <div class="flex items-center gap-1 text-xs font-medium @(_isUp ? "text-red-500" : "text-emerald-500")">
                            @if (_isUp)
                            {
                                <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideIconCn Name="trending-down" Size="12" Class="size-3" />
                            }
                            @(Math.Abs(_trend).ToString("F1"))%
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-4 border-l pl-6">
                    <div class="space-y-1">
                        <span class="text-muted-foreground text-[10px] uppercase tracking-wider">
                            Last Month
                        </span>
                        <p class="text-sm font-semibold tabular-nums">$@_lastMonth.ToString("N0", _usCulture)</p>
                    </div>
                    <div class="space-y-1">
                        <span class="text-muted-foreground text-[10px] uppercase tracking-wider">
                            Avg. Monthly
                        </span>
                        <p class="text-sm font-semibold tabular-nums">$1,150</p>
                    </div>
                </div>
            </div>

            <div class="mt-8 space-y-4">
                <h4 class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                    Top Categories
                </h4>
                <div class="space-y-3">
                    @foreach (var cat in _categories)
                    {
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <div class="size-1.5 rounded-full @cat.Color"></div>
                                <span class="text-sm text-muted-foreground">@cat.Name</span>
                            </div>
                            <span class="text-sm font-medium tabular-nums">$@cat.Amount.ToString("F2", _usCulture)</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="bg-muted/30 px-4 py-2.5 border-t">
            <p class="text-[10px] text-muted-foreground text-center">
                Data aggregates across all team workspaces · Updated 5m ago
            </p>
        </div>
    </div>
</section>

@code {
    private const double _currentMonth = 1240.5;
    private const double _lastMonth = 1100.0;
    private readonly double _trend = (_currentMonth - _lastMonth) / _lastMonth * 100.0;
    private readonly bool _isUp = ((_currentMonth - _lastMonth) / _lastMonth * 100.0) > 0;

    private static readonly System.Globalization.CultureInfo _usCulture =
        System.Globalization.CultureInfo.GetCultureInfo("en-US");

    private record Category(string Name, double Amount, string Color);

    private static readonly Category[] _categories =
    [
        new("Platform Fee", 499.0, "bg-blue-500"),
        new("API Usage", 641.5, "bg-emerald-500"),
        new("Support Add-on", 100.0, "bg-amber-500"),
    ];

    private static string FormatUsd(double amount) =>
        amount.ToString("C", _usCulture);
}
