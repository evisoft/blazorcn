@* ============================================================
   Block: billing-credit-expiry
   Title: BillingCreditExpiry
   Description: An alert-driven block for React and Next.js showing upcoming credit expiration dates with countdowns, urgency indicators, and usage suggestions built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-credit-expiry.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-start gap-4 p-4">
            <div class="mt-1 flex size-10 shrink-0 items-center justify-center rounded-full bg-amber-500/10">
                <LucideIconCn Name="clock" Size="20" Class="size-5 text-amber-600" />
            </div>
            <div class="flex-1 space-y-1">
                <h3 class="font-medium text-sm">Credits Expiring Soon</h3>
                <p class="text-muted-foreground text-sm leading-normal">
                    You have
                    <span class="font-semibold text-foreground">$@(_expiringAmount.ToString("F2"))</span>
                    in promotional credits that will expire on
                    <span class="font-medium text-foreground">March 28, 2026</span>.
                </p>
            </div>
            <div class="text-right">
                <span class="rounded-full bg-amber-500/10 px-2.5 py-1 text-[10px] font-bold text-amber-700 uppercase">
                    @_daysLeft Days Left
                </span>
            </div>
        </div>

        <div class="mx-4 mb-4 flex flex-col gap-3 rounded-md border bg-muted/10 p-4 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <LucideIconCn Name="calendar" Size="14" Class="size-3.5" />
                <span>Expires: Mar 28, 11:59 PM UTC</span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 gap-1.5 px-3">
                Use Credits Now
                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

        <div class="flex items-center gap-2 border-t bg-muted/30 px-4 py-2.5">
            <LucideIconCn Name="info" Size="12" Class="size-3 text-muted-foreground/50" />
            <p class="text-[10px] text-muted-foreground">
                Expiring credits are automatically applied to your next billable action.
            </p>
        </div>
    </div>
</section>

@code {
    private readonly double _expiringAmount = 150.0;
    private readonly int _daysLeft = 4;
}
