@* ============================================================
   Block: billing-feature-comparison-table
   Title: BillingFeatureComparisonTable
   Description: A billing feature comparison and plan matrix block for React and Next.js with semantic checkmarks and tier-based highlighting built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-feature-comparison-table.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="table" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Feature Comparison</span>
            </div>
        </div>

        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="hover:bg-transparent">
                    <TableHeadCn Class="w-[40%] text-xs uppercase tracking-wider">Feature</TableHeadCn>
                    <TableHeadCn Class="text-center text-xs uppercase tracking-wider">
                        Starter
                    </TableHeadCn>
                    <TableHeadCn Class="text-center text-xs uppercase tracking-wider text-primary font-semibold">
                        Pro
                    </TableHeadCn>
                    <TableHeadCn Class="text-center text-xs uppercase tracking-wider">
                        Enterprise
                    </TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var feature in _features)
                {
                    <TableRowCn Class="group transition-colors hover:bg-muted/50">
                        <TableCellCn Class="py-3 text-sm font-medium">@feature.Name</TableCellCn>
                        <TableCellCn Class="text-center">
                            @FeatureValue(feature.Starter, false)
                        </TableCellCn>
                        <TableCellCn Class="bg-primary/5 text-center">
                            @FeatureValue(feature.Pro, true)
                        </TableCellCn>
                        <TableCellCn Class="text-center">
                            @FeatureValue(feature.Enterprise, false)
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>

        <div class="bg-muted/30 px-4 py-2.5">
            <p class="text-center text-muted-foreground text-[10px]">
                All plans include basic security, automatic updates, and data encryption at rest.
            </p>
        </div>
    </div>
</section>

@code {
    private record Feature(string Name, string Starter, string Pro, string Enterprise);

    private static readonly Feature[] _features =
    [
        new("API Access", "true", "true", "true"),
        new("Custom Domains", "1 Domain", "5 Domains", "Unlimited"),
        new("Team Seats", "3 Seats", "15 Seats", "Unlimited"),
        new("Advanced Analytics", "false", "true", "true"),
        new("SLA Guarantees", "false", "false", "true"),
        new("Dedicated Support", "false", "Email", "24/7 Phone"),
    ];

    private RenderFragment FeatureValue(string value, bool isPrimary)
    {
        var iconClass = "size-4 " + (isPrimary ? "text-primary" : "text-emerald-500");
        var textClass = "text-xs font-medium " + (isPrimary ? "text-primary" : "text-muted-foreground");

        if (value == "true")
            return @<div class="flex justify-center">
                <LucideIconCn Name="check" Size="16" Class="@iconClass" />
                <span class="sr-only">Included</span>
            </div>;

        if (value == "false")
            return @<div class="flex justify-center">
                <LucideIconCn Name="minus" Size="16" Class="size-4 text-muted-foreground/30" />
                <span class="sr-only">Not Included</span>
            </div>;

        return @<span class="@textClass">@value</span>;
    }
}
