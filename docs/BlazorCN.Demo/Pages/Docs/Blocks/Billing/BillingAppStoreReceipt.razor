@* ============================================================
   Block: billing-app-store-receipt
   Title: BillingAppStoreReceipt
   Description: A clean, mobile-inspired receipt block for App Store or Google Play subscriptions, formatted for SaaS platform integration.
   Source: original/blocks/billing/billing-app-store-receipt.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        <div class="border-b px-4 py-5 flex flex-col items-center text-center space-y-3 bg-muted/10">
            <div class="size-14 rounded-2xl bg-black flex items-center justify-center text-white shadow-lg">
                <LucideIconCn Name="apple" Size="32" Class="size-8 fill-current" />
            </div>
            <div class="space-y-1">
                <h3 class="font-bold text-lg tracking-tight">App Store Subscription</h3>
                <p class="text-xs text-muted-foreground font-medium uppercase tracking-widest">
                    Order #MNL82910XL
                </p>
            </div>
        </div>

        <div class="p-5 space-y-6">
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm text-muted-foreground">Product</span>
                    <span class="text-sm font-semibold">Pro Plan (Annual)</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-muted-foreground">Purchased on</span>
                    <span class="text-sm font-medium">May 12, 2026</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-sm text-muted-foreground">Renews on</span>
                    <span class="text-sm font-medium">May 12, 2027</span>
                </div>
                <div class="border-t pt-4 flex items-center justify-between">
                    <span class="text-sm font-bold">Total Charged</span>
                    <span class="text-lg font-bold tabular-nums">$399.00</span>
                </div>
            </div>

            <div class="rounded-lg border bg-muted/30 p-4 space-y-3">
                <div class="flex items-start gap-3">
                    <LucideIconCn Name="info" Size="16" Class="size-4 text-muted-foreground mt-0.5" />
                    <p class="text-[11px] text-muted-foreground leading-relaxed">
                        This subscription is managed by Apple. To change your payment method, cancel, or
                        request a refund, please use the App Store settings on your device.
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full h-8 text-xs gap-2 font-medium bg-background">
                    Manage in App Store
                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        <div class="bg-muted/50 border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="smartphone" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        Platform Sync
                    </span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-emerald-500/10 text-emerald-600 border-emerald-500/20 text-[9px] font-bold uppercase">
                    Active on iOS
                </BadgeCn>
            </div>
        </div>
    </div>
</section>
