@* ============================================================
   Block: billing-credit-balance
   Title: BillingCreditBalance
   Description: A comprehensive credit balance summary block for React and Next.js with animated totals, transaction history previews, and low-balance alerts built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-credit-balance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="wallet" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Credit Balance</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] uppercase">
                Active
            </BadgeCn>
        </div>

        @* Balance Main *@
        <div class="px-4 py-8 text-center">
            <div class="flex items-baseline justify-center gap-1">
                <span class="text-muted-foreground text-sm">$</span>
                <span class="text-4xl font-semibold tracking-tight tabular-nums">
                    @(_balance.ToString("F2"))
                </span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">Total available funds</p>
        </div>

        @* Breakdown *@
        <div class="grid grid-cols-2 divide-x border-y bg-muted/5">
            <div class="px-4 py-3">
                <span class="text-muted-foreground text-[10px] uppercase tracking-wider">
                    Purchased
                </span>
                <p class="font-medium text-sm tabular-nums">
                    $@((_balance - _promoBalance).ToString("F2"))
                </p>
            </div>
            <div class="px-4 py-3">
                <span class="text-muted-foreground text-[10px] uppercase tracking-wider">
                    Promotional
                </span>
                <p class="font-medium text-sm text-emerald-600 tabular-nums">
                    +$@(_promoBalance.ToString("F2"))
                </p>
            </div>
        </div>

        @* Low Balance Warning *@
        @if (_balance < 100)
        {
            <div class="flex items-center gap-3 border-b bg-amber-50 px-4 py-3 text-amber-900">
                <LucideIconCn Name="alert-circle" Size="16" Class="size-4 shrink-0" />
                <p class="text-xs font-medium">
                    Your balance is low. Consider topping up to avoid service interruption.
                </p>
            </div>
        }

        @* Footer Links *@
        <div class="flex items-center justify-between px-4 py-2.5 bg-muted/30">
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <LucideIconCn Name="history" Size="12" Class="size-3" />
                <span>Last top-up: Mar 20, 2026</span>
            </div>
            <button type="button" class="text-xs font-medium hover:underline transition-all">
                Add Funds
            </button>
        </div>
    </div>
</section>

@code {
    private decimal _balance = 1250.75m;
    private decimal _promoBalance = 50.0m;
}
