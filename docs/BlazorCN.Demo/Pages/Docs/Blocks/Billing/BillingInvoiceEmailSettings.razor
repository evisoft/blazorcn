@* ============================================================
   Block: billing-invoice-email-settings
   Title: BillingInvoiceEmailSettings
   Description: A billing invoice notification and delivery settings block for React and Next.js with automated CC support and frequency controls built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-invoice-email-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        <div class="border-b px-4 py-3 flex items-center gap-2">
            <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Invoice Delivery</span>
        </div>

        <div class="p-4 space-y-6">
            <div class="space-y-4">
                <div class="flex items-start justify-between gap-4">
                    <div class="space-y-0.5">
                        <LabelCn Class="text-sm font-medium">Auto-Send Invoices</LabelCn>
                        <p class="text-muted-foreground text-xs leading-relaxed">
                            Automatically email a PDF copy of every invoice to the primary account email.
                        </p>
                    </div>
                    <SwitchCn Checked="true" />
                </div>

                <div class="flex items-start justify-between gap-4">
                    <div class="space-y-0.5">
                        <LabelCn Class="text-sm font-medium">Include PDF Attachments</LabelCn>
                        <p class="text-muted-foreground text-xs leading-relaxed">
                            Attach the raw PDF file directly to the email for easier bookkeeping.
                        </p>
                    </div>
                    <SwitchCn Checked="true" />
                </div>
            </div>

            <div class="pt-4 border-t space-y-3">
                <div class="flex items-center gap-2 text-muted-foreground">
                    <LucideIconCn Name="mail-plus" Size="14" Class="size-3.5" />
                    <span class="text-xs font-medium uppercase tracking-wider">Carbon Copy (CC)</span>
                </div>
                <div class="flex gap-2">
                    <div class="relative flex-1">
                        <InputCn Placeholder="accounting@company.com" Class="h-9 pl-9 text-sm" />
                        <LucideIconCn Name="file-text" Size="16" Class="absolute left-3 top-2.5 size-4 text-muted-foreground/50" />
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-9">
                        Add
                    </ButtonCn>
                </div>
                <p class="text-muted-foreground text-[11px]">
                    Tax receipts and renewal notices will also be sent to these addresses.
                </p>
            </div>
        </div>

        <div class="bg-muted/30 px-4 py-3 border-t flex items-center justify-between">
            <div class="flex items-center gap-2 text-emerald-600 dark:text-emerald-400">
                <LucideIconCn Name="shield-check" Size="14" Class="size-3.5" />
                <span class="text-[10px] font-medium uppercase tracking-wider">
                    Secure Transmission
                </span>
            </div>
            <p class="text-muted-foreground text-[10px]">Updated on May 24, 2026</p>
        </div>
    </div>
</section>
