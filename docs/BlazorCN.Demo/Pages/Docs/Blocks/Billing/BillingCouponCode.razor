@* ============================================================
   Block: billing-coupon-code
   Title: BillingCouponCode
   Description: A promotional code entry block for React and Next.js with real-time validation, discount previews, and success animations built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-coupon-code.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card p-4">
        <div class="flex items-center gap-2 mb-3">
            <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Promo Code</span>
        </div>

        <div class="flex gap-2">
            <div class="relative flex-1">
                <InputCn
                    Placeholder="Enter code (e.g. SAVE20)"
                    @bind-Value="_code"
                    Class="@Cn.Merge("pr-9 font-mono uppercase transition-colors", _status == "success" ? "border-emerald-500/50 bg-emerald-500/5 focus-visible:ring-emerald-500" : _status == "error" ? "border-red-500/50 bg-red-500/5 focus-visible:ring-red-500" : "")" />
                <div class="absolute right-3 top-1/2 -translate-y-1/2">
                    @if (_status == "success")
                    {
                        <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                    }
                    @if (_status == "error")
                    {
                        <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-500" />
                    }
                </div>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-9" OnClick="HandleApply" Disabled="@(_status == "loading" || string.IsNullOrEmpty(_code))">
                @(_status == "loading" ? "..." : "Apply")
            </ButtonCn>
        </div>

        @if (_status == "success")
        {
            <p class="mt-3 text-emerald-600 text-xs font-medium">
                Success! $10.00 discount applied to your order.
            </p>
        }

        @if (_status == "error")
        {
            <p class="mt-3 text-red-600 text-xs font-medium">
                Invalid or expired promotional code.
            </p>
        }

        <p class="mt-3 text-muted-foreground text-[10px]">
            Coupons cannot be combined with other offers. See our Terms of Service for details.
        </p>
    </div>
</section>

@code {
    private string _status = "idle";

    private string _code
    {
        get => _codeValue;
        set
        {
            _codeValue = value;
            if (_status != "idle") _status = "idle";
        }
    }
    private string _codeValue = "";

    private async Task HandleApply()
    {
        _status = "loading";
        await Task.Delay(1000);
        _status = _codeValue.ToUpper() == "SAVE20" ? "success" : "error";
    }
}
