@* ============================================================
   Block: billing-low-credit-warning
   Title: BillingLowCreditWarning
   Description: A billing low balance and automated recharge warning block for React and Next.js with threshold indicators and quick-top-up actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-low-credit-warning.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-amber-500/30 bg-amber-500/5 shadow-sm">
        <div class="p-5 flex flex-col gap-4 sm:flex-row sm:items-start">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-amber-500/10 text-amber-600">
                <div class="animate-pulse">
                    <LucideIconCn Name="alert-circle" Size="20" Class="size-5" />
                </div>
            </div>

            <div class="flex-1 space-y-1">
                <div class="flex items-center gap-2">
                    <h3 class="font-semibold text-sm text-amber-900 dark:text-amber-400">
                        Low Credit Balance
                    </h3>
                    <span class="rounded-full bg-amber-500/20 px-2 py-0.5 text-[10px] font-bold uppercase text-amber-600">
                        Action Required
                    </span>
                </div>
                <p class="text-amber-800/80 dark:text-amber-400/80 text-xs leading-relaxed">
                    Your remaining balance is <strong>$@_balance.ToString("F2")</strong>. Service will be paused once your credits reach $0.00.
                </p>

                <div class="mt-4 space-y-1.5">
                    <div class="flex items-center justify-between text-[10px] uppercase tracking-wider font-semibold text-amber-700 dark:text-amber-300">
                        <span>Usage until threshold</span>
                        <span>@($"{_percentage:F0}%")</span>
                    </div>
                    <ProgressCn Value="@_percentage" Class="h-1 bg-amber-500/20 [&>div]:bg-amber-500" aria-label="Progress" />
                </div>
            </div>

            <div class="flex flex-col gap-2 shrink-0 sm:w-32">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs font-medium bg-amber-600 hover:bg-amber-700 border-none">
                    <LucideIconCn Name="coins" Size="12" Class="mr-1.5 size-3" />
                    Top Up
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 text-xs font-medium border-amber-200 hover:bg-amber-100 dark:border-amber-900/50 dark:hover:bg-amber-950/30">
                    Manage
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center justify-between border-t border-amber-500/20 bg-amber-500/10 px-5 py-2.5">
            <div class="flex items-center gap-2.5">
                <SwitchCn Id="auto-topup" @bind-Checked="_autoRecharge" Class="data-[state=checked]:bg-amber-600" />
                <label for="auto-topup" class="text-amber-900 dark:text-amber-400 text-[10px] font-semibold uppercase tracking-wide cursor-pointer">
                    Enable Auto-Recharge
                </label>
            </div>
            <div class="flex items-center gap-1.5 text-amber-800/60 dark:text-amber-400/60 text-[10px]">
                <LucideIconCn Name="refresh-ccw" Size="12" Class="size-3" />
                <span>Adds $50 when below $10</span>
            </div>
        </div>
    </div>
</section>

@code {
    private decimal _balance = 8.42m;
    private decimal _threshold = 50.0m;
    private double _percentage => (double)((_balance / _threshold) * 100);
    private bool _autoRecharge = false;
}
