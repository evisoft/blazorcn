@* ============================================================
   Block: billing-update-card-modal
   Title: BillingUpdateCardModal
   Description: A focused, secure payment method update block for SaaS accounts featuring real-time card validation, secure input placeholders, and brand-specific formatting built with shadcn/ui.
   Source: original/blocks/billing/billing-update-card-modal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCreditCardCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Update Payment Method</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your current Visa ending in 4242 is expiring soon. Please provide a new payment method
                to avoid service interruption.
            </p>
        </div>

        <form @onsubmit="HandleUpdate" @onsubmit:preventDefault class="p-4 space-y-4">
            <div class="space-y-2">
                <LabelCn For="update-card-modal-card-number" Class="text-xs font-medium uppercase text-muted-foreground tracking-tight">
                    Card Number
                </LabelCn>
                <div class="relative">
                    <InputCn id="update-card-modal-card-number" Placeholder="0000 0000 0000 0000" Class="h-9 pr-10 font-mono" />
                    <div class="absolute right-3 top-2.5 flex items-center gap-1.5">
                        <div class="size-4 rounded-sm bg-zinc-100 border flex items-center justify-center text-[8px] font-bold text-zinc-400">
                            VISA
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="space-y-2">
                    <LabelCn For="update-card-modal-expiry" Class="text-xs font-medium uppercase text-muted-foreground tracking-tight">
                        Expiry Date
                    </LabelCn>
                    <InputCn id="update-card-modal-expiry" Placeholder="MM / YY" Class="h-9 font-mono" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="cvc" Class="text-xs font-medium uppercase text-muted-foreground tracking-tight">
                        CVC
                    </LabelCn>
                    <InputCn id="cvc" Placeholder="&bull;&bull;&bull;" Class="h-9 font-mono" />
                </div>
            </div>

            <div class="rounded-md bg-muted/30 p-3 border flex items-center gap-2.5">
                <LucideShieldCheckCn Size="14" Class="size-3.5 text-emerald-500 shrink-0" />
                <p class="text-[10px] text-muted-foreground leading-relaxed">
                    Your card data is encrypted and processed securely via Stripe. We never store your
                    full card details on our servers.
                </p>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Cancel
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-4 text-xs gap-1.5" Disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span>Processing...</span>
                    }
                    else
                    {
                        <LucideLockCn Size="12" Class="size-3" />
                        <span>Update Card</span>
                    }
                </ButtonCn>
            </div>
        </form>

        <div class="bg-muted/50 border-t px-4 py-2 text-center">
            <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
                PCI-DSS Level 1 Secure Payment Processing
            </p>
        </div>
    </div>
</section>

@code {
    private bool _isSubmitting;

    private async Task HandleUpdate()
    {
        _isSubmitting = true;
        await Task.Delay(2000);
        _isSubmitting = false;
    }
}
