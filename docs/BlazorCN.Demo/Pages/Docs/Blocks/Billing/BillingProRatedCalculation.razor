@* ============================================================
   Block: billing-pro-rated-calculation
   Title: BillingProRatedCalculation
   Description: A billing pro-ration calculation block for React and Next.js that shows credit adjustments and new plan costs for mid-cycle upgrades using shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-pro-rated-calculation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calculator" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Pro-rated Adjustment</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                You're upgrading to the Pro plan today. We've applied a credit for your unused time on
                the Basic plan.
            </p>
        </div>

        @* Calculation Details *@
        <div class="space-y-4 p-4">
            <div class="space-y-2.5">
                <div class="flex items-center justify-between text-sm">
                    <span class="text-muted-foreground">New Plan (Pro)</span>
                    <span class="font-medium tabular-nums">@_newPlanCost.ToString("C2")</span>
                </div>
                <div class="flex items-center justify-between text-sm">
                    <div class="flex items-center gap-1.5 text-emerald-500">
                        <LucideIconCn Name="trending-up" Size="14" Class="size-3.5" />
                        <span>Unused time credit</span>
                    </div>
                    <span class="font-medium text-emerald-500 tabular-nums">-@_unusedCredit.ToString("C2")</span>
                </div>
            </div>

            @* Total Due Today *@
            <div class="rounded-md bg-muted/50 p-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="font-medium text-sm">Total due today</p>
                        <p class="text-muted-foreground text-xs">Charged to your default card</p>
                    </div>
                    <span class="text-xl font-semibold tabular-nums tracking-tight">@_todayTotal.ToString("C2")</span>
                </div>
            </div>

            @* Future Preview *@
            <div class="flex items-start gap-2.5 rounded-md border border-blue-500/20 bg-blue-500/5 p-3">
                <LucideIconCn Name="calendar" Size="16" Class="mt-0.5 size-4 text-blue-500" />
                <div class="text-sm">
                    <p class="font-medium text-blue-900 dark:text-blue-400">Next billing cycle</p>
                    <p class="text-blue-700/80 dark:text-blue-400/80">
                        You will be charged <span class="font-semibold text-blue-900 dark:text-blue-400">$49.00</span> on @_nextBillingDate.
                    </p>
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between border-t bg-muted/30 px-4 py-3">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="info" Size="14" Class="size-3.5" />
                Tax may apply based on your location
            </div>
            <ButtonCn Size="ButtonSize.Sm">Confirm Upgrade</ButtonCn>
        </div>

    </div>
</section>

@code {
    private const double _unusedCredit = 12.5;
    private const double _newPlanCost = 49.0;
    private const double _todayTotal = _newPlanCost - _unusedCredit;
    private const string _nextBillingDate = "July 1, 2026";
}
