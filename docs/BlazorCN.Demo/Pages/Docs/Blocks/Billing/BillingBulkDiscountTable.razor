@* ============================================================
   Block: billing-bulk-discount-table
   Title: BillingBulkDiscountTable
   Description: A professional pricing table for volume-based discounts, showing tiered pricing structures and potential cost reductions for larger teams.
   Source: original/blocks/billing/billing-bulk-discount-table.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Volume Pricing</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        Billed Monthly
                    </span>
                </div>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Add more seats to your team and automatically unlock lower per-seat rates.
            </p>
        </div>

        <TableCn>
            <TableHeaderCn Class="bg-muted/30">
                <TableRowCn>
                    <TableHeadCn Class="h-9 text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                        Seats
                    </TableHeadCn>
                    <TableHeadCn Class="h-9 text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                        Price/Seat
                    </TableHeadCn>
                    <TableHeadCn Class="h-9 text-[10px] font-bold uppercase tracking-widest text-muted-foreground text-right">
                        Savings
                    </TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var tier in _tiers)
                {
                    <TableRowCn Class="@Cn.Merge("transition-colors", tier.Current ? "bg-primary/5" : "hover:bg-muted/30")">
                        <TableCellCn Class="py-3">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@tier.Range</span>
                                @if (tier.Current)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[8px] font-bold uppercase bg-primary/10 text-primary border-primary/20">
                                        Your Tier
                                    </BadgeCn>
                                }
                            </div>
                        </TableCellCn>
                        <TableCellCn Class="py-3">
                            <span class="text-sm font-semibold">$@tier.Price</span>
                            <span class="text-[10px] text-muted-foreground font-normal">/mo</span>
                        </TableCellCn>
                        <TableCellCn Class="py-3 text-right">
                            @if (tier.Discount > 0)
                            {
                                <span class="text-xs font-bold text-emerald-600">-@(tier.Discount)%</span>
                            }
                            else
                            {
                                <span class="text-[10px] text-muted-foreground font-medium uppercase">
                                    &#x2014;
                                </span>
                            }
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>

        <div class="p-4 bg-muted/20 border-t">
            <div class="flex items-start gap-3 p-3 rounded-lg border bg-background">
                <LucideIconCn Name="info" Size="16" Class="size-4 text-muted-foreground mt-0.5" />
                <p class="text-[11px] text-muted-foreground leading-relaxed">
                    Prices are per active seat. We automatically adjust your tier based on your current
                    team size. No manual plan changes required.
                </p>
            </div>
        </div>

        <div class="bg-muted/50 border-t px-4 py-2.5">
            <div class="flex items-center justify-center gap-2 text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                Automatic Volume Discount Applied
            </div>
        </div>
    </div>
</section>

@code {
    private record Tier(string Range, int Price, int Discount, bool Current);

    private static readonly Tier[] _tiers =
    [
        new("1-10", 20, 0, false),
        new("11-50", 15, 25, true),
        new("51-200", 12, 40, false),
        new("201+", 10, 50, false),
    ];
}
