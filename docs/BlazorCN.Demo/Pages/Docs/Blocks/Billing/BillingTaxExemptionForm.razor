@* ============================================================
   Block: billing-tax-exemption-form
   Title: BillingTaxExemptionForm
   Description: A specialized billing form for collecting and verifying tax-exempt status for non-profits and government entities built with shadcn/ui and framer-motion.
   Source: original/blocks/billing/billing-tax-exemption-form.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="landmark" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Tax Exemption</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Non-profits, government agencies, and educational institutions can apply for
                tax-exempt billing here.
            </p>
        </div>

        <div class="p-4 space-y-5">
            @if (_status != "success")
            {
                <div class="grid gap-4 md:grid-cols-2">
                    <div class="space-y-2">
                        <label for="org-name" class="text-xs font-medium uppercase text-muted-foreground tracking-tight">
                            Organization Name
                        </label>
                        <InputCn id="org-name" Placeholder="Acme Foundation" Class="h-9" />
                    </div>
                    <div class="space-y-2">
                        <label for="exemption-reason" class="text-xs font-medium uppercase text-muted-foreground tracking-tight">
                            Reason for Exemption
                        </label>
                        <SelectCn @bind-Value="_exemptionReason">
                            <SelectTriggerCn id="exemption-reason" Class="h-9">
                                <SelectValueCn Placeholder="Select reason" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="non-profit">Non-Profit / 501(c)(3)</SelectItemCn>
                                <SelectItemCn Value="government">Government Entity</SelectItemCn>
                                <SelectItemCn Value="educational">Educational Institution</SelectItemCn>
                                <SelectItemCn Value="resale">Resale Certificate</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                </div>

                <div class="space-y-2">
                    <label class="text-xs font-medium uppercase text-muted-foreground tracking-tight">
                        Proof of Exemption (PDF)
                    </label>
                    <div class="flex flex-col items-center justify-center rounded-lg border border-dashed p-6 transition-colors hover:bg-muted/30">
                        <LucideIconCn Name="file-up" Size="32" Class="size-8 text-muted-foreground/50 mb-2" />
                        <p class="text-xs font-medium">Click to upload or drag and drop</p>
                        <p class="text-[10px] text-muted-foreground mt-1">Maximum file size: 10MB</p>
                        <input type="file" class="sr-only" accept=".pdf" />
                    </div>
                </div>

                <div class="rounded-md bg-blue-50/50 p-3 border border-blue-100 dark:bg-blue-950/20 dark:border-blue-900/50 flex gap-3">
                    <LucideIconCn Name="info" Size="16" Class="size-4 text-blue-500 shrink-0 mt-0.5" />
                    <p class="text-[11px] text-blue-800/80 dark:text-blue-400 leading-relaxed">
                        Your tax status will be reviewed by our finance team. Once approved, all future
                        invoices will be tax-free. Past taxes cannot be refunded.
                    </p>
                </div>

                <div class="flex items-center justify-end gap-3 pt-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Cancel
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-4 text-xs" Disabled="@(_status == "uploading")" @onclick="HandleSubmit">
                        @(_status == "uploading" ? "Submitting..." : "Submit for Review")
                    </ButtonCn>
                </div>
            }
            else
            {
                <div class="py-6 text-center space-y-4">
                    <div class="mx-auto size-12 rounded-full bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center">
                        <LucideIconCn Name="shield-check" Size="24" Class="size-6 text-emerald-600" />
                    </div>
                    <div class="space-y-1">
                        <h4 class="text-sm font-medium">Application Received</h4>
                        <p class="text-xs text-muted-foreground max-w-[280px] mx-auto">
                            We've received your tax exemption documents. Our team will review them and
                            notify you within 2-3 business days.
                        </p>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 text-xs" @onclick="ResetStatus">
                        View Status
                    </ButtonCn>
                </div>
            }
        </div>

        <div class="bg-muted/50 border-t px-4 py-2 text-center">
            <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
                Standard review time: 48 business hours
            </p>
        </div>
    </div>
</section>

@code {
    private string _status = "idle";
    private string _exemptionReason = "";

    private async Task HandleSubmit()
    {
        _status = "uploading";
        await Task.Delay(2000);
        _status = "success";
    }

    private void ResetStatus()
    {
        _status = "idle";
    }
}
