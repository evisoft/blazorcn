@* ============================================================
   Block: billing-auto-recharge
   Title: BillingAutoRecharge
   Description: An auto-recharge and credit balance block for React and Next.js with threshold slider, status toggle, and low-balance alerts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-auto-recharge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="coins" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Credit Balance</span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1.5 px-2 text-xs">
                <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                Recharge Now
            </ButtonCn>
        </div>

        @* Balance Display *@
        <div class="border-b px-4 py-4 text-center">
            <span class="text-muted-foreground text-xs uppercase tracking-wider font-medium">
                Available Credits
            </span>
            <div class="mt-1 flex items-center justify-center gap-2">
                <span class="@Cn.Merge("font-semibold text-4xl tabular-nums", _isLowBalance ? "text-red-600 dark:text-red-400" : "")">
                    $@_balance.ToString("F2")
                </span>
            </div>
            @if (_isLowBalance)
            {
                <p class="mt-2 text-red-600 text-xs dark:text-red-400">
                    Low balance. Auto-recharge will trigger soon.
                </p>
            }
        </div>

        @* Auto-Recharge Toggle *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Auto-recharge</span>
            </div>
            <SwitchCn aria-label="Auto-recharge" @bind-Checked="_enabled" />
        </div>

        @* Threshold Slider *@
        <div class="@Cn.Merge("px-4 py-4 transition-opacity duration-300", _enabled ? "opacity-100" : "opacity-40 pointer-events-none")">
            <div class="mb-4 flex items-center justify-between text-xs">
                <span class="font-medium text-muted-foreground">Recharge Threshold</span>
                <span class="font-semibold text-sm tabular-nums">$@((int)_threshold)</span>
            </div>
            <SliderCn Value="@_threshold" ValueChanged="@((double v) => _threshold = v)" Max="100" Step="5" aria-label="Recharge threshold" Class="mb-4" />
            <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                <LucideIconCn Name="info" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                <p class="text-muted-foreground text-xs leading-relaxed">
                    When your balance falls below $@((int)_threshold), we will automatically recharge your
                    account with $50 using your default payment method.
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-[10px]">
                Recharge history available in the invoice section
            </p>
        </div>
    </div>
</section>

@code {
    private bool _enabled = true;
    private double _threshold = 20;
    private double _balance = 12.5;

    private bool _isLowBalance => _balance < _threshold;
}
