@* ============================================================
   Block: billing-currency-switcher
   Title: BillingCurrencySwitcher
   Description: A multi-currency pricing toggle block for React and Next.js with exchange rate estimates, local symbol support, and persistence built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-currency-switcher.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Currency & Localization</span>
        </div>

        <div class="p-4 space-y-6">
            <div class="space-y-2">
                <label for="currency-select" class="text-xs text-muted-foreground uppercase tracking-wider">
                    Preferred Currency
                </label>
                <SelectCn @bind-Value="_currencyId">
                    <SelectTriggerCn id="currency-select" Class="h-9">
                        <SelectValueCn Placeholder="Select currency" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var c in _currencies)
                        {
                            <SelectItemCn Value="@c.Id">@c.Label (@c.Name)</SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="rounded-md border bg-muted/10 p-4">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium">Monthly Plan Price</span>
                    <div class="flex items-baseline gap-1">
                        <span class="text-muted-foreground text-sm">@_currency.Symbol</span>
                        <span class="text-2xl font-bold tabular-nums tracking-tight">
                            @((_basePrice * _currency.Rate).ToString("F2"))
                        </span>
                    </div>
                </div>
                <p class="mt-1 text-muted-foreground text-[10px]">
                    Prices are estimated based on current market rates. Final total may vary slightly at
                    checkout.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-2 border-t bg-muted/30 px-4 py-2.5">
            <LucideIconCn Name="info" Size="12" Class="size-3 text-muted-foreground/50" />
            <p class="text-[10px] text-muted-foreground">
                Taxes and regional fees will be applied based on your billing address.
            </p>
        </div>
    </div>
</section>

@code {
    private record CurrencyOption(string Id, string Name, string Symbol, double Rate, string Label);

    private static readonly CurrencyOption[] _currencies =
    [
        new("usd", "USD", "$", 1.0, "US Dollar"),
        new("eur", "EUR", "€", 0.92, "Euro"),
        new("gbp", "GBP", "£", 0.79, "British Pound"),
        new("jpy", "JPY", "¥", 151.5, "Japanese Yen"),
    ];

    private const double _basePrice = 49.0;
    private string _currencyId = "usd";

    private CurrencyOption _currency => Array.Find(_currencies, c => c.Id == _currencyId) ?? _currencies[0];
}
