@* ============================================================
   Block: billing-notification-center
   Title: BillingNotificationCenter
   Description: A dedicated notification center for billing events, failed payments, and credit updates for React and Next.js, built with shadcn/ui and framer-motion.
   Source: original/blocks/billing/billing-notification-center.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Billing Alerts</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Mark all as read
            </ButtonCn>
        </div>

        @* List *@
        <div class="divide-y">
            @foreach (var notification in _notifications)
            {
                <div class="group flex gap-4 px-4 py-4 transition-colors hover:bg-muted/50">
                    <div class="mt-0.5 shrink-0">
                        <LucideIconCn Name="@GetIconName(notification.Type)" Size="16" Class="@($"size-4 {GetIconClass(notification.Type)}")" />
                    </div>
                    <div class="flex-1 space-y-1">
                        <div class="flex items-center justify-between gap-2">
                            <p class="font-medium text-sm leading-none">@notification.Title</p>
                            <span class="text-muted-foreground text-xs tabular-nums">
                                @notification.Date
                            </span>
                        </div>
                        <p class="text-muted-foreground text-sm leading-relaxed">
                            @notification.Description
                        </p>
                        @if (notification.ActionLabel != null)
                        {
                            <div class="pt-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 px-3 text-xs">
                                    <LucideIconCn Name="credit-card" Size="12" Class="size-3" />
                                    @notification.ActionLabel
                                </ButtonCn>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="bg-muted/30 px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Looking for older history?
                <span class="cursor-pointer font-medium text-foreground underline-offset-4 hover:underline">
                    View Audit Logs
                </span>
            </p>
        </div>
    </div>
</section>

@code {
    private record BillingNotification(string Id, string Title, string Description, string Date, string Type, string? ActionLabel = null);

    private static readonly BillingNotification[] _notifications =
    [
        new("1", "Payment Failed", "Your recent payment for the Pro plan was declined. Please update your card.", "2 hours ago", "error", "Fix Payment"),
        new("2", "Renewal Reminder", "Your subscription will automatically renew on July 1st for $149.00.", "1 day ago", "info"),
        new("3", "Credits Added", "Successfully added 5,000 API credits to your workspace balance.", "3 days ago", "success"),
    ];

    private static string GetIconName(string type) => type switch
    {
        "error"   => "alert-circle",
        "warning" => "alert-circle",
        "success" => "check-circle-2",
        "info"    => "info",
        _         => "info",
    };

    private static string GetIconClass(string type) => type switch
    {
        "error"   => "text-red-500",
        "warning" => "text-amber-500",
        "success" => "text-emerald-500",
        "info"    => "text-blue-500",
        _         => "text-blue-500",
    };
}
