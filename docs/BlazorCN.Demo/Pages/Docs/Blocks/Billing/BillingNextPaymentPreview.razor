@* ============================================================
   Block: billing-next-payment-preview
   Title: BillingNextPaymentPreview
   Description: A detailed preview of the upcoming billing charge for React and Next.js, featuring seat counts, line items, and tax calculations built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-next-payment-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Next Payment Preview</span>
                </div>
                <span class="rounded-full bg-muted px-2 py-0.5 font-medium text-[10px] uppercase tracking-wider text-muted-foreground">
                    Upcoming
                </span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your next scheduled payment will be processed on @_nextPaymentDate using your default
                payment method.
            </p>
        </div>

        @* Breakdown *@
        <div class="divide-y border-b">
            <div class="flex items-center justify-between px-4 py-3">
                <div class="flex items-center gap-2.5">
                    <div class="flex size-8 items-center justify-center rounded-md bg-muted/50">
                        <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div>
                        <p class="font-medium text-sm">Pro Plan · @_seats Seats</p>
                        <p class="text-muted-foreground text-xs">$@_pricePerSeat/seat per month</p>
                    </div>
                </div>
                <span class="font-medium text-sm tabular-nums">
                    $@_subtotal.ToString("F2")
                </span>
            </div>

            <div class="flex items-center justify-between px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="text-muted-foreground text-sm">Estimated Tax (10%)</span>
                    <TooltipProviderCn>
                        <TooltipCn>
                            <TooltipTriggerCn>
                                <LucideIconCn Name="info" Size="12" Class="size-3 text-muted-foreground/50" />
                            </TooltipTriggerCn>
                            <TooltipContentCn>Based on your billing address in California.</TooltipContentCn>
                        </TooltipCn>
                    </TooltipProviderCn>
                </div>
                <span class="font-medium text-sm tabular-nums">
                    $@_tax.ToString("F2")
                </span>
            </div>
        </div>

        @* Total *@
        <div class="bg-muted/30 px-4 py-4">
            <div class="flex items-end justify-between">
                <div>
                    <p class="font-medium text-sm">Total Due</p>
                    <div class="mt-1 flex items-center gap-1.5 text-muted-foreground text-xs">
                        <LucideIconCn Name="credit-card" Size="12" Class="size-3" />
                        <span>Charged to Visa ending in 4242</span>
                    </div>
                </div>
                <div class="text-right">
                    <span class="text-2xl font-semibold tracking-tight tabular-nums">
                        $@_total.ToString("F2")
                    </span>
                    <p class="text-muted-foreground text-[10px] uppercase tracking-wider">USD</p>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <p class="text-muted-foreground text-xs">Amounts may change if seats are added.</p>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Manage Subscription
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string _nextPaymentDate = "July 1, 2026";
    private const int _seats = 12;
    private const int _pricePerSeat = 15;
    private decimal _subtotal => _seats * _pricePerSeat;
    private decimal _tax => _subtotal * 0.1m;
    private decimal _total => _subtotal + _tax;
}
