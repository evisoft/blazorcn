@* ============================================================
   Block: billing-upcoming-invoice-preview
   Title: BillingUpcomingInvoicePreview
   Description: A forward-looking billing block for SaaS customers featuring itemized line items, estimated taxes, and proration summaries built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-upcoming-invoice-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Upcoming Invoice</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                A preview of your next scheduled charge on April 24, 2026. This amount may change if
                you update your plan or usage.
            </p>
        </div>

        @* Line items + total + notice *@
        <div class="p-4 space-y-4">
            <div class="space-y-3">
                @foreach (var item in _lineItems)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@item.Description</span>
                        <span class="font-medium tracking-tight">$@item.Amount.ToString("F2")</span>
                    </div>
                }
            </div>

            <div class="pt-3 border-t">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-semibold">Estimated Total</span>
                    <div class="flex items-baseline gap-1">
                        <span class="text-lg font-bold tracking-tight text-foreground">$</span>
                        <span class="text-2xl font-bold tracking-tight">@_subtotal.ToString("F2")</span>
                    </div>
                </div>
            </div>

            <div class="rounded-md border bg-muted/30 p-3 flex gap-3">
                <LucideIconCn Name="info" Size="14" Class="size-3.5 text-blue-500 shrink-0 mt-0.5" />
                <p class="text-[10px] text-muted-foreground leading-relaxed">
                    This is a live preview of your next bill. Final amounts, including applicable taxes,
                    will be calculated on the day of billing.
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="bg-muted/50 border-t px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-[10px] text-muted-foreground font-bold uppercase tracking-widest">
                    April 24, 2026
                </span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-[10px] uppercase font-bold tracking-widest">
                Update Plan
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record LineItem(string Id, string Description, decimal Amount);

    private static readonly LineItem[] _lineItems =
    [
        new("li_1", "Pro Plan Subscription (Monthly)", 49.00m),
        new("li_2", "Extra API Credits (1,000 calls)", 10.00m),
        new("li_3", "Tax (Estimated)", 4.72m),
    ];

    private decimal _subtotal => _lineItems.Sum(i => i.Amount);
}
