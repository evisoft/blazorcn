@* ============================================================
   Block: billing-renewal-alert-banner
   Title: BillingRenewalAlertBanner
   Description: A high-impact billing banner for React and Next.js to notify users of upcoming annual renewals and prevent surprise charges built with shadcn/ui and Framer Motion.
   Source: original/blocks/billing/billing-renewal-alert-banner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-blue-500/20 bg-blue-500/5 px-4 py-3">
        <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
            <div class="flex items-start gap-3">
                <div class="mt-1 flex size-8 shrink-0 items-center justify-center rounded-full bg-blue-500/10">
                    <LucideIconCn Name="calendar" Size="16" Class="size-4 text-blue-600 dark:text-blue-400" />
                </div>
                <div class="min-w-0">
                    <p class="font-medium text-sm text-blue-900 dark:text-blue-300">
                        Upcoming Annual Renewal
                    </p>
                    <p class="mt-0.5 text-blue-800/80 text-xs dark:text-blue-400/80">
                        Your Pro plan will renew on <strong>@_renewalDate</strong> (@_daysUntilRenewal days from now).
                        We'll charge your default card for the full year.
                    </p>
                </div>
            </div>

            <div class="flex flex-col items-end gap-2 shrink-0">
                <div class="flex items-baseline gap-1.5 text-blue-900 dark:text-blue-200">
                    <span class="text-xl font-bold tracking-tight tabular-nums">
                        @_formattedAmount
                    </span>
                    <span class="text-[10px] font-medium uppercase opacity-70">/ year</span>
                </div>
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 border-blue-500/20 bg-background/50 text-blue-600 hover:bg-blue-500/10 sm:h-7 sm:px-2.5 sm:text-[10px]">
                        Review Items
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 bg-blue-600 text-white hover:bg-blue-700 sm:h-7 sm:px-2.5 sm:text-[10px]">
                        Manage
                        <LucideIconCn Name="external-link" Size="12" Class="ml-1.5 size-3" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Info footer *@
        <div class="mt-3 flex items-center gap-1.5 text-[10px] text-blue-700/60 dark:text-blue-400/60">
            <LucideIconCn Name="alert-circle" Size="12" Class="size-3" />
            You can change your billing frequency or cancel at any time before renewal.
        </div>
    </div>
</section>

@code {
    private readonly string _renewalDate = "July 1, 2026";
    private readonly int _daysUntilRenewal = 12;
    private readonly string _formattedAmount = "$588.00";
}
