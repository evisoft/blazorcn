@* ============================================================
   Block: billing-purchase-approval-workflow
   Title: BillingPurchaseApprovalWorkflow
   Description: A multi-step procurement management component for React and Next.js that facilitates internal sign-offs for subscription upgrades or new license purchases built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-purchase-approval-workflow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clipboard-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Procurement Request #882</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px] uppercase tracking-wider bg-amber-500/10 text-amber-600 border-amber-200/50">
                Awaiting Sign-off
            </BadgeCn>
        </div>

        @* Request Overview *@
        <div class="px-4 py-5 border-b">
            <div class="flex items-start justify-between">
                <div>
                    <h3 class="text-base font-semibold">Pro Plan Upgrade + 10 Seats</h3>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Requested by <strong>James Wilson</strong> (Engineering)
                    </p>
                </div>
                <div class="text-right">
                    <div class="text-lg font-bold tabular-nums">$1,240.00</div>
                    <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-medium">Annual Total</p>
                </div>
            </div>
            <div class="mt-4 flex items-start gap-2 rounded-md border bg-muted/20 p-2.5">
                <LucideIconCn Name="message-square" Size="14" Class="size-3.5 text-muted-foreground mt-0.5" />
                <p class="text-[11px] text-muted-foreground leading-relaxed italic">
                    &ldquo;Adding 10 new engineers to the project next month.
                    Requires advanced analytics features only available on the Pro tier.&rdquo;
                </p>
            </div>
        </div>

        @* Approval Steps *@
        <div class="px-4 py-5 border-b">
            <h4 class="text-[10px] font-semibold text-muted-foreground uppercase tracking-widest mb-4">Approval Chain</h4>
            <div class="space-y-6">
                @for (var i = 0; i < _approvalSteps.Length; i++)
                {
                    var step = _approvalSteps[i];
                    var idx = i;
                    <div class="flex items-start gap-4">
                        <div class="relative flex h-8 w-8 items-center justify-center shrink-0">
                            <div class="flex size-8 items-center justify-center rounded-full border bg-background z-10">
                                @if (step.Status == "approved")
                                {
                                    <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                                }
                                else if (step.Status == "pending")
                                {
                                    <LucideIconCn Name="clock" Size="16" Class="size-4 text-amber-500 animate-pulse" />
                                }
                                else
                                {
                                    <LucideIconCn Name="user" Size="16" Class="size-4 text-muted-foreground/30" />
                                }
                            </div>
                            @if (idx != _approvalSteps.Length - 1)
                            {
                                <div class="absolute top-8 bottom-[-24px] w-px bg-muted"></div>
                            }
                        </div>
                        <div class="flex flex-1 flex-col">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-semibold">@step.Role</span>
                                <span class="text-[10px] text-muted-foreground font-medium uppercase tracking-wider">@step.Date</span>
                            </div>
                            <span class="text-xs text-muted-foreground">@step.Name</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Manager Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs text-destructive hover:bg-destructive/10 border-destructive/20">
                <LucideIconCn Name="x-circle" Size="14" Class="size-3.5" />
                Reject Request
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs bg-emerald-600 hover:bg-emerald-700 ml-auto">
                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5" />
                Approve Purchase
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ApprovalStep(string Role, string Name, string Status, string Date);

    private static readonly ApprovalStep[] _approvalSteps =
    [
        new("Direct Manager", "Alex Rivera", "approved", "May 14, 2024"),
        new("Department Head", "Sarah Chen", "pending", "--"),
        new("Finance Team", "Finance (General)", "upcoming", "--"),
    ];
}
