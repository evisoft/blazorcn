<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex flex-col items-center gap-6 rounded-lg border bg-muted/20 px-6 py-8 text-center">
        <div class="flex size-10 items-center justify-center rounded-full bg-background border shadow-sm">
            <LucideIconCn Name="shield-check" Size="20" Class="size-5 text-muted-foreground" />
        </div>

        <div class="space-y-2">
            <h3 class="text-sm font-semibold tracking-tight">Our Refund Policy</h3>
            <p class="text-muted-foreground text-sm leading-relaxed max-w-md mx-auto">
                We offer a 14-day money-back guarantee for all new subscriptions. If you&#39;re not
                satisfied, contact us for a full refund&#8212;no questions asked.
            </p>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-6 border-t pt-6 w-full max-w-sm">
            <a href="/support" class="flex items-center gap-2 text-xs font-medium text-muted-foreground hover:text-foreground transition-colors">
                <LucideIconCn Name="life-buoy" Size="14" Class="size-3.5" />
                Contact Support
            </a>
            <a href="/docs/refunds" class="flex items-center gap-2 text-xs font-medium text-muted-foreground hover:text-foreground transition-colors">
                <LucideIconCn Name="help-circle" Size="14" Class="size-3.5" />
