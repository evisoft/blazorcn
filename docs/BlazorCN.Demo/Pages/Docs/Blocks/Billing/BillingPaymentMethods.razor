@* ============================================================
   Block: billing-payment-methods
   Title: BillingPaymentMethods
   Description: A payment method management block for React and Next.js with saved card list, default indicators, expiration alerts, and 'Add New' actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-payment-methods.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideCreditCardCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Payment Methods</span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 px-2 text-xs">
                <LucidePlusCn Size="12" Class="size-3" />
                Add New
            </ButtonCn>
        </div>

        @* Info *@
        <div class="border-b px-4 py-3">
            <p class="text-muted-foreground text-sm">
                Your default payment method will be used for all recurring subscription charges and
                one-time purchases.
            </p>
        </div>

        @* Methods List *@
        <div class="divide-y">
            @foreach (var method in _methods)
            {
                <div class="flex items-center justify-between px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex items-center gap-4">
                        <div class="flex size-8 items-center justify-center rounded-md border bg-muted/50">
                            <LucideCreditCardCn Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">
                                    @method.Brand •••• @method.Last4
                                </span>
                                @if (method.IsDefault)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-emerald-500/10 font-normal text-emerald-600 text-[10px] hover:bg-emerald-500/10 dark:text-emerald-400">
                                        Default
                                    </BadgeCn>
                                }
                                @if (method.IsExpiring)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-red-500/10 font-normal text-red-600 text-[10px] hover:bg-red-500/10 dark:text-red-400">
                                        Near expiry
                                    </BadgeCn>
                                }
                            </div>
                            <p class="text-muted-foreground text-xs">
                                Expires @method.ExpMonth.ToString("D2")/@method.ExpYear
                            </p>
                        </div>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 text-muted-foreground" aria-label="More options">
                        <LucideEllipsisVerticalCn Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Encryption powered by Stripe · 128-bit SSL Secured
            </p>
        </div>
    </div>
</section>

@code {
    private record PaymentMethod(
        string Id,
        string Brand,
        string Last4,
        int ExpMonth,
        int ExpYear,
        bool IsDefault,
        bool IsExpiring = false
    );

    private static readonly PaymentMethod[] _methods =
    [
        new("pm_1", "Visa",       "4242", 12, 2026, IsDefault: true,  IsExpiring: false),
        new("pm_2", "Mastercard", "8888",  5, 2026, IsDefault: false, IsExpiring: true),
    ];
}
