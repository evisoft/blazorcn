@* ============================================================
   Block: billing-plan-selector
   Title: BillingPlanSelector
   Description: A plan selector block for React and Next.js with monthly/yearly toggle, animated price transitions using NumberFlow, and per-seat calculation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-plan-selector.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with Toggle *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="zap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Select a Plan</span>
            </div>
            <div class="flex items-center gap-1 rounded-md bg-muted/50 p-0.5">
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class='@Cn.Merge("h-7 px-3 text-xs transition-all", _interval == "month" ? "bg-background shadow-sm" : "text-muted-foreground")'
                          OnClick="SelectMonth">
                    Monthly
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class='@Cn.Merge("h-7 px-3 text-xs transition-all", _interval == "year" ? "bg-background shadow-sm" : "text-muted-foreground")'
                          OnClick="SelectYear">
                    Yearly
                </ButtonCn>
            </div>
        </div>

        @* Plan Cards *@
        <div class="divide-y">
            @foreach (var plan in _plans)
            {
                var isSelected = _selectedPlan == plan.Id;
                var price = _interval == "month" ? plan.MonthlyPrice : plan.YearlyPrice;
                <button type="button"
                        class='@Cn.Merge("flex w-full flex-col p-4 text-left transition-colors hover:bg-muted/30", isSelected ? "bg-muted/50" : "")'
                        @onclick="@(() => _selectedPlan = plan.Id)">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="font-semibold text-sm">@plan.Name</span>
                            @if (plan.IsPopular)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary"
                                         Class="bg-emerald-500/10 font-normal text-emerald-600 text-[10px] hover:bg-emerald-500/10 dark:text-emerald-400">
                                    Best Value
                                </BadgeCn>
                            }
                        </div>
                        <div class="flex items-baseline gap-1">
                            <span class="font-semibold text-lg tabular-nums">$@price</span>
                            <span class="text-muted-foreground text-xs">/mo</span>
                        </div>
                    </div>

                    <p class="mt-1 text-muted-foreground text-xs">@plan.Description</p>

                    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5">
                        @foreach (var feature in plan.Features)
                        {
                            <div class="flex items-center gap-1.5">
                                <div class="flex size-3.5 items-center justify-center rounded-full bg-emerald-500/10">
                                    <LucideIconCn Name="check" Size="10" Class="size-2.5 text-emerald-600 dark:text-emerald-400" />
                                </div>
                                <span class="text-muted-foreground text-xs">@feature</span>
                            </div>
                        }
                    </div>
                </button>
            }
        </div>

        @* Footer Action *@
        <div class="px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                Confirm Plan Selection
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-[10px]">
                @(_interval == "year" ? "You'll be billed $288 annually" : "You'll be billed $29 monthly")
                @(" · ")
                Prices exclude applicable taxes
            </p>
        </div>
    </div>
</section>

@code {
    private string _interval = "month";
    private string _selectedPlan = "pro";

    private void SelectMonth() => _interval = "month";
    private void SelectYear() => _interval = "year";

    private record Plan(string Id, string Name, int MonthlyPrice, int YearlyPrice, string Description, string[] Features, bool IsPopular = false);

    private static readonly Plan[] _plans =
    [
        new("pro", "Pro Plan", 29, 24, "Advanced features for growing teams and startups.",
            ["Unlimited projects", "Priority support", "Advanced analytics"], IsPopular: true),
        new("team", "Team Plan", 79, 65, "Scale your organization with collaboration tools.",
            ["Unlimited projects", "Dedicated support", "Team permissions"]),
    ];
}
