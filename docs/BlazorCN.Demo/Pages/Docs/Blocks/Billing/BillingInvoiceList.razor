@* ============================================================
   Block: billing-invoice-list
   Title: BillingInvoiceList
   Description: A billing invoice list block for React and Next.js with status indicators, download actions, and date-based sorting built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-invoice-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Invoice History</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                View and download your past invoices. For receipts older than 2025, please contact our
                support team.
            </p>
        </div>

        @* Invoice List *@
        <div class="divide-y">
            @foreach (var invoice in _invoices)
            {
                <div class="flex items-center justify-between px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex items-center gap-3">
                        <span class="@($"size-1.5 shrink-0 rounded-full {StatusColor(invoice.Status)}")" />
                        <div class="min-w-0">
                            <span class="font-mono text-muted-foreground text-xs">@invoice.Id</span>
                            <p class="font-medium text-sm">@invoice.Date</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-6">
                        <span class="font-semibold text-sm tabular-nums">
                            $@(invoice.Amount.ToString("F2"))
                        </span>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-xs">
                            <LucideIconCn Name="download" Size="12" Class="size-3 text-muted-foreground" />
                            PDF
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Export all as CSV · Generate Tax Summary
            </p>
        </div>

    </div>
</section>

@code {
    private record Invoice(string Id, string Date, decimal Amount, string Status);

    private static readonly Invoice[] _invoices =
    [
        new("INV-2026-001", "Mar 24, 2026", 49.0m, "paid"),
        new("INV-2026-002", "Feb 24, 2026", 49.0m, "paid"),
        new("INV-2026-003", "Jan 24, 2026", 49.0m, "paid"),
        new("INV-2025-012", "Dec 24, 2025", 129.0m, "paid"),
        new("INV-2025-011", "Nov 24, 2025", 49.0m, "failed"),
    ];

    private static string StatusColor(string status) => status switch
    {
        "paid" => "bg-emerald-500",
        "pending" => "bg-amber-500",
        "failed" => "bg-red-500",
        _ => ""
    };
}
