@* ============================================================
   Block: billing-tier-usage-limits
   Title: BillingTierUsageLimits
   Description: A multi-resource usage monitoring block for tiered SaaS plans featuring visual progress indicators, limit thresholds, and upgrade prompts built with shadcn/ui.
   Source: original/blocks/billing/billing-tier-usage-limits.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Plan Usage &amp; Limits</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] uppercase font-bold tracking-tight">
                    Pro Plan
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                You are currently using 85% of your total plan capacity. Limits will reset on April
                24, 2026.
            </p>
        </div>

        @* Resource rows *@
        <div class="divide-y">
            @foreach (var res in _resources)
            {
                var percentage = (double)res.Used / res.Limit * 100;
                var isWarning = percentage > 80;
                var isCritical = percentage > 95;
                <div class="p-4 space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2.5">
                            <div class="rounded-md border p-1.5 bg-muted/50">
                                <LucideIconCn Name="@res.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                            </div>
                            <span class="text-xs font-semibold">@res.Name</span>
                        </div>
                        <div class="flex items-baseline gap-1">
                            <span class="@Cn.Merge("text-sm font-bold tracking-tight", isCritical ? "text-red-500" : isWarning ? "text-amber-500" : "text-foreground")">
                                @res.Used
                            </span>
                            <span class="text-[10px] text-muted-foreground font-medium uppercase tracking-tighter">
                                / @res.Limit @res.Unit
                            </span>
                        </div>
                    </div>
                    <ProgressCn Value="@percentage" Class="h-1.5" aria-label="Progress" />
                    @if (isWarning)
                    {
                        <p class="@Cn.Merge("text-[10px] font-medium uppercase tracking-wider", isCritical ? "text-red-500" : "text-amber-600")">
                            @(isCritical ? "Limit reached. Actions may be restricted." : "Approaching limit. Consider upgrading soon.")
                        </p>
                    }
                </div>
            }
        </div>

        @* Upgrade CTA *@
        <div class="p-4 bg-muted/30">
            <div class="flex items-center justify-between gap-4">
                <div class="space-y-0.5">
                    <p class="text-xs font-semibold">Need higher limits?</p>
                    <p class="text-[10px] text-muted-foreground leading-relaxed">
                        Unlock unlimited API calls and 50+ seats with the Business plan.
                    </p>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs shrink-0">
                    Upgrade Plan
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="bg-muted/50 border-t px-4 py-2 text-center">
            <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
                Usage data updates approximately every 15 minutes
            </p>
        </div>

    </div>
</section>

@code {
    private record Resource(string Id, string Name, int Used, int Limit, string Icon, string Unit);

    private static readonly Resource[] _resources =
    [
        new("api-calls",   "API Calls",       42800, 50000, "zap",    "calls"),
        new("team-seats",  "Team Seats",       8,     10,    "users",  "seats"),
        new("projects",    "Active Projects",  12,    15,    "layers", "projects"),
    ];
}
