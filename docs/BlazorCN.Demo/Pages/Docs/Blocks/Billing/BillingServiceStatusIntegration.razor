@* ============================================================
   Block: billing-service-status-integration
   Title: BillingServiceStatusIntegration
   Description: A billing trust block for React and Next.js that shows the real-time status of payment providers (Stripe, PayPal) to prevent checkout errors built with shadcn/ui.
   Source: original/blocks/billing/billing-service-status-integration.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="@_outerClass">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Billing System Status</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="relative flex size-2">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
                </span>
                <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                    Live
                </span>
            </div>
        </div>

        @* Service List *@
        <div class="divide-y divide-border/50">
            @foreach (var service in _services)
            {
                var config = GetConfig(service.Status);
                <div class="flex items-center justify-between px-4 py-3">
                    <div class="flex flex-col">
                        <span class="text-sm font-medium">@service.Name</span>
                        <span class="text-[10px] text-muted-foreground uppercase tracking-tight">
                            Powered by @service.Provider
                        </span>
                    </div>
                    <div class="@($"flex items-center gap-1.5 text-xs font-medium {config.Text}")">
                        <LucideIconCn Name="@config.IconName" Size="14" Class="size-3.5" />
                        <span class="capitalize">@service.Status</span>
                    </div>
                </div>
            }
        </div>

        @* Footer Warning *@
        @if (_isSystemDown || _isDegraded)
        {
            <div class="border-t px-4 py-3">
                <p class="text-xs leading-relaxed text-muted-foreground">
                    @(_isSystemDown
                        ? "We're currently experiencing a major outage with our payment provider. Transactions are temporarily disabled."
                        : "Tax calculation is currently slow. You may experience brief delays during the final checkout step.")
                </p>
            </div>
        }

        <div class="bg-muted/20 px-4 py-2 border-t">
            <p class="text-[10px] text-center text-muted-foreground/60 uppercase tracking-widest font-bold">
                All Systems Operational · June 2026
            </p>
        </div>
    </div>
</section>

@code {
    private record ServiceItem(string Name, string Status, string Provider);
    private record StatusConfigItem(string Color, string Text, string IconName);

    private static readonly ServiceItem[] _services =
    [
        new("Payment Processing (Stripe)", "operational", "Stripe"),
        new("Invoice Generation", "operational", "Internal"),
        new("Tax Calculation", "degraded", "Stripe Tax"),
    ];

    private static readonly Dictionary<string, StatusConfigItem> _statusConfig = new()
    {
        ["operational"] = new("bg-emerald-500", "text-emerald-600 dark:text-emerald-400", "check-circle-2"),
        ["degraded"]    = new("bg-amber-500",   "text-amber-600 dark:text-amber-400",   "activity"),
        ["outage"]      = new("bg-red-500",      "text-red-600 dark:text-red-400",       "info"),
    };

    private bool _isSystemDown => _services.Any(s => s.Status == "outage");
    private bool _isDegraded   => _services.Any(s => s.Status == "degraded");

    private string _outerClass => Cn.Merge(
        "overflow-hidden rounded-lg border bg-card transition-colors",
        _isSystemDown ? "border-red-500/20 bg-red-500/5"
            : _isDegraded ? "border-amber-500/20 bg-amber-500/5"
            : "");

    private static StatusConfigItem GetConfig(string status) =>
        _statusConfig.TryGetValue(status, out var c) ? c : _statusConfig["operational"];
}
