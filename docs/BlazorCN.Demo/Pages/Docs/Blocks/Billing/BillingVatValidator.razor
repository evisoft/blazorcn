@* ============================================================
   Block: billing-vat-validator
   Title: BillingVatValidator
   Description: A professional VAT number validation block with real-time status checking, country selection, and tax exemption support built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-vat-validator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">EU VAT Validation</span>
                </div>
                @if (_status == "valid")
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-emerald-500/10 text-emerald-600 border-emerald-500/20 text-[10px] uppercase font-bold">
                        Valid Entity
                    </BadgeCn>
                }
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Enter your VAT number to enable tax-exempt B2B transactions within the EU.
            </p>
        </div>

        <div class="p-4 space-y-4">
            <div class="grid gap-4 sm:grid-cols-4">
                <div class="space-y-2">
                    <label class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        Prefix
                    </label>
                    <SelectCn @bind-Value="_prefix">
                        <SelectTriggerCn Class="h-9 font-mono">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="DE">DE</SelectItemCn>
                            <SelectItemCn Value="FR">FR</SelectItemCn>
                            <SelectItemCn Value="IT">IT</SelectItemCn>
                            <SelectItemCn Value="ES">ES</SelectItemCn>
                            <SelectItemCn Value="NL">NL</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
                <div class="sm:col-span-3 space-y-2">
                    <label for="vat-number" class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        Number
                    </label>
                    <div class="relative">
                        <InputCn
                            id="vat-number"
                            @bind-Value="_vatNumber"
                            Placeholder="123 456 789"
                            Class="@Cn.Merge("pr-8 font-mono transition-all", _status == "valid" ? "border-emerald-500/40 bg-emerald-50/20" : "", _status == "invalid" ? "border-red-500/40 bg-red-50/20" : "")" />
                        <div class="absolute right-2.5 top-2.5">
                            @if (_status == "verifying")
                            {
                                <LucideIconCn Name="loader-2" Size="16" Class="size-4 animate-spin text-muted-foreground" />
                            }
                            @if (_status == "valid")
                            {
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                            }
                            @if (_status == "invalid")
                            {
                                <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-500" />
                            }
                        </div>
                    </div>
                </div>
            </div>

            @if (_status == "valid")
            {
                <div class="rounded-md border bg-muted/30 p-3">
                    <div class="flex items-start gap-3">
                        <div class="size-8 rounded border bg-background flex items-center justify-center shrink-0">
                            <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="space-y-0.5">
                            <p class="text-xs font-bold text-foreground">
                                STRIPE TECHNOLOGY EUROPE, LTD.
                            </p>
                            <p class="text-[11px] text-muted-foreground leading-relaxed">
                                1 Grand Canal Street Lower, Dublin 2, Ireland
                                <br />
                                Verified via VIES System
                            </p>
                        </div>
                    </div>
                </div>
            }

            <div class="flex items-center justify-between pt-2">
                <p class="text-[11px] text-muted-foreground">
                    @if (_status == "invalid")
                    {
                        <span class="text-red-500 font-medium">Validation failed. Please check the number.</span>
                    }
                    else
                    {
                        @:Verified numbers are eligible for 0% tax rate.
                    }
                </p>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs px-3" OnClick="@(() => _status = "idle")">
                        Reset
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-4 text-xs font-medium" OnClick="HandleVerify" Disabled="@(_status == "verifying" || string.IsNullOrEmpty(_vatNumberValue))">
                        @(_status == "verifying" ? "Verifying..." : "Check Validity")
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="bg-muted/30 border-t px-4 py-2">
            <p class="text-[10px] text-center text-muted-foreground uppercase tracking-widest font-semibold">
                European Commission VIES Compliant
            </p>
        </div>
    </div>
</section>

@code {
    private string _status = "idle";
    private string _prefix = "DE";

    private string _vatNumber
    {
        get => _vatNumberValue;
        set
        {
            _vatNumberValue = System.Text.RegularExpressions.Regex.Replace(value ?? "", "[^0-9]", "");
            if (_status is "valid" or "invalid") _status = "idle";
        }
    }
    private string _vatNumberValue = "";

    private async Task HandleVerify()
    {
        if (string.IsNullOrEmpty(_vatNumberValue)) return;
        _status = "verifying";
        await Task.Delay(1200);
        _status = _vatNumberValue.Length > 7 ? "valid" : "invalid";
    }
}
