@* ============================================================
   Block: billing-free-tier-status
   Title: BillingFreeTierStatus
   Description: A billing free tier and usage limits block for React and Next.js with visual progress bars and upgrade incentives built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-free-tier-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layout-grid" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Free Plan Usage</span>
            </div>
            <span class="rounded-full bg-muted px-2 py-0.5 text-[10px] font-semibold uppercase text-muted-foreground">
                Current Tier
            </span>
        </div>

        <div class="p-4 space-y-6">
            @foreach (var limit in _limits)
            {
                var percentage = (limit.Current / limit.Limit) * 100;
                var isWarning = percentage >= 80;
                <div class="space-y-2">
                    <div class="flex items-center justify-between text-xs">
                        <span class="font-medium">@limit.Name</span>
                        <div class="flex items-center gap-1 font-mono text-muted-foreground">
                            <span>@limit.Current.ToString("0.##")</span>
                            <span>/</span>
                            <span>@limit.Limit.ToString("0.##") @limit.Unit</span>
                        </div>
                    </div>
                    <ProgressCn aria-label="@limit.Name" Value="@percentage" Class="@Cn.Merge("h-1.5", isWarning ? "[&>div]:bg-amber-500" : "")" />
                </div>
            }
        </div>

        <div class="bg-muted/30 px-4 py-4 border-t">
            <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
                <p class="text-muted-foreground text-xs text-center sm:text-left">
                    You've used <strong>84%</strong> of your free resources. Upgrade to Pro to unlock
                    unlimited usage and priority support.
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 shadow-sm shrink-0">
                    <LucideIconCn Name="zap" Size="14" Class="size-3.5 fill-current" />
                    Upgrade Now
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record LimitItem(string Id, string Name, double Current, double Limit, string Unit);

    private static readonly LimitItem[] _limits =
    [
        new("api", "API Requests", 840, 1000, "/mo"),
        new("storage", "Cloud Storage", 4.2, 5, "GB"),
        new("seats", "Team Members", 2, 3, "seats"),
    ];
}
