@* ============================================================
   Block: billing-churn-prevention-offer
   Title: BillingChurnPreventionOffer
   Description: A churn prevention block with limited-time discount offers, feature highlights, and retention incentives built with shadcn/ui and Framer Motion
   Source: original/blocks/billing/billing-churn-prevention-offer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        <CardCn Class="overflow-hidden border-primary/20 shadow-lg">
            <CardHeaderCn Class="bg-primary/5 pb-8 text-center">
                <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary">
                    <LucideIconCn Name="gift" Size="24" Class="size-6" />
                </div>
                <CardTitleCn Class="text-2xl sm:text-3xl">Wait! We have a special gift for you.</CardTitleCn>
                <CardDescriptionCn Class="mx-auto max-w-md text-base">
                    We'd hate to see you go. Stay with us today and get 50% off your next 3 months.
                </CardDescriptionCn>
            </CardHeaderCn>
            <CardContentCn Class="grid gap-6 p-6">
                <div class="flex items-center justify-center gap-4 py-4">
                    <div class="text-center">
                        <span class="text-muted-foreground line-through text-sm">$@_originalPrice</span>
                        <div class="flex items-baseline gap-1 text-primary">
                            <span class="font-bold text-4xl">$</span>
                            <span class="font-bold text-4xl">@_discountedPrice.ToString("F2")</span>
                            <span class="font-medium text-sm">/mo</span>
                        </div>
                    </div>
                    <div class="h-12 w-px bg-border"></div>
                    <div class="flex flex-col gap-1">
                        <div class="flex items-center gap-2 font-medium text-green-600 text-sm">
                            <LucideIconCn Name="sparkles" Size="16" Class="size-4" />
                            Save 50% instantly
                        </div>
                        <p class="text-muted-foreground text-xs text-pretty">
                            Applied to your next 3 billing cycles.
                        </p>
                    </div>
                </div>

                <div class="space-y-3">
                    <p class="font-medium text-sm">You'll keep access to everything:</p>
                    <ul class="grid gap-2 sm:grid-cols-2">
                        @foreach (var feature in _features)
                        {
                            <li class="flex items-center gap-2 text-muted-foreground text-sm">
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-primary" />
                                @feature
                            </li>
                        }
                    </ul>
                </div>
            </CardContentCn>
            <CardFooterCn Class="flex flex-col gap-3 p-6 pt-0">
                <ButtonCn Size="ButtonSize.Lg" Class="h-11 w-full text-base shadow-sm">
                    Claim 50% Off &amp; Stay Pro
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="w-full text-muted-foreground hover:text-destructive">
                    No thanks, I still want to cancel
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private const int _originalPrice = 49;
    private const decimal _discountedPrice = 24.5m;

    private static readonly string[] _features =
    [
        "Unlimited API requests",
        "Priority 24/7 support",
        "Advanced team analytics",
        "Custom branding & domains",
    ];
}
