@* ============================================================
   Block: billing-procurement-contact-details
   Title: BillingProcurementContactDetails
   Description: A specialized contact management component for React and Next.js designed for B2B platforms to store and display procurement and accounts payable information built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-procurement-contact-details.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users-2" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Procurement Contacts</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-[10px] font-medium uppercase tracking-wider">
                <LucideIconCn Name="user-plus" Size="12" Class="size-3" />
                Add New
            </ButtonCn>
        </div>

        @* Description *@
        <div class="px-4 py-4 border-b">
            <p class="text-xs text-muted-foreground leading-relaxed">
                Manage who receives invoice notifications and who handles procurement requests for your organization.
            </p>
        </div>

        @* Contact List *@
        <div class="divide-y">
            @foreach (var contact in _contacts)
            {
                <div class="group flex items-center justify-between px-4 py-4 transition-colors hover:bg-muted/50">
                    <div class="flex items-center gap-4">
                        <div class="flex size-10 items-center justify-center rounded-full border bg-muted/30 text-muted-foreground">
                            <span class="text-xs font-semibold">@Initials(contact.Name)</span>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h3 class="text-sm font-semibold text-foreground">@contact.Name</h3>
                                @if (contact.Primary)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[8px] font-medium uppercase bg-emerald-500/10 text-emerald-600 border-emerald-200/50">
                                        Primary
                                    </BadgeCn>
                                }
                            </div>
                            <div class="mt-1 flex flex-col gap-0.5">
                                <span class="text-[10px] font-medium text-muted-foreground uppercase tracking-wider">@contact.Role</span>
                                <div class="flex items-center gap-3 mt-1">
                                    <div class="flex items-center gap-1.5 text-[11px] text-muted-foreground">
                                        <LucideIconCn Name="mail" Size="12" Class="size-3" />
                                        @contact.Email
                                    </div>
                                    <div class="flex items-center gap-1.5 text-[11px] text-muted-foreground">
                                        <LucideIconCn Name="phone" Size="12" Class="size-3" />
                                        +1 (555) 000-0000
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-1">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 w-8 p-0 opacity-0 group-hover:opacity-100 transition-opacity" aria-label="@($"Edit {contact.Name}")">
                            <LucideIconCn Name="edit-2" Size="14" Class="size-3.5 text-muted-foreground" />
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 w-8 p-0 opacity-0 group-hover:opacity-100 transition-opacity" aria-label="@($"Verify email for {contact.Name}")">
                            <LucideIconCn Name="mail-check" Size="14" Class="size-3.5 text-muted-foreground" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3 border-t bg-muted/10">
            <span class="text-[10px] text-muted-foreground font-medium uppercase tracking-widest">
                Last updated 12 days ago
            </span>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                Save All Contacts
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Contact(string Role, string Name, string Email, bool Primary);

    private static readonly Contact[] _contacts =
    [
        new("Billing Admin", "David Miller", "david.m@acme.com", true),
        new("Accounts Payable", "Finance Team", "ap@acme.com", false),
        new("Procurement Lead", "Elena Rodriguez", "elena.r@acme.com", false),
    ];

    private static string Initials(string name) =>
        new string(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Select(n => n[0]).ToArray());
}
