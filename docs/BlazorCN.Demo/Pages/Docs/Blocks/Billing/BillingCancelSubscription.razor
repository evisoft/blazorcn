@* ============================================================
   Block: billing-cancel-subscription
   Title: BillingCancelSubscription
   Description: A subscription cancellation flow block for React and Next.js with retention offers, reason surveys, and impact warnings built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-cancel-subscription.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @if (_step == 1)
        {
            <div class="border-b px-4 py-3">
                <h3 class="font-medium text-sm">Cancel Subscription</h3>
                <p class="mt-1 text-muted-foreground text-sm">
                    We're sorry to see you go. Please let us know why you're leaving so we can
                    improve.
                </p>
            </div>
            <div class="px-4 py-6">
                <div class="rounded-md border border-amber-500/20 bg-amber-500/5 p-3">
                    <div class="flex gap-3">
                        <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 shrink-0 text-amber-600" />
                        <div class="space-y-1">
                            <p class="font-medium text-amber-900 text-xs">You will lose access to:</p>
                            <ul class="list-inside list-disc text-amber-800/80 text-[11px]">
                                <li>Unlimited API requests</li>
                                <li>Advanced analytics dashboard</li>
                                <li>Priority email support</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="mt-6 space-y-4">
                    <LabelCn Class="text-xs text-muted-foreground uppercase tracking-wider">
                        Reason for leaving
                    </LabelCn>
                    <RadioGroupCn @bind-Value="_reason">
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="expensive" />
                            <LabelCn Class="font-normal text-sm">Too expensive</LabelCn>
                        </div>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="missing-features" />
                            <LabelCn Class="font-normal text-sm">Missing key features</LabelCn>
                        </div>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="hard-to-use" />
                            <LabelCn Class="font-normal text-sm">Difficult to set up</LabelCn>
                        </div>
                        <div class="flex items-center space-x-2">
                            <RadioGroupItemCn Value="other" />
                            <LabelCn Class="font-normal text-sm">Other</LabelCn>
                        </div>
                    </RadioGroupCn>
                </div>
            </div>
            <div class="flex items-center justify-between border-t bg-muted/30 px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8">
                    Keep My Plan
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Destructive" Size="ButtonSize.Sm" Class="h-8" OnClick="@(() => _step = 2)">
                    Continue to Cancel
                </ButtonCn>
            </div>
        }
        else
        {
            <div class="px-4 py-8 text-center">
                <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="message-square" Size="24" Class="size-6 text-emerald-600" />
                </div>
                <h3 class="mt-4 font-medium">Wait! Before you go...</h3>
                <p class="mt-2 text-muted-foreground text-sm">
                    Would you stay if we gave you 50% off for the next 3 months? This is our best offer.
                </p>
                <div class="mt-8 flex flex-col gap-3">
                    <ButtonCn Class="w-full bg-emerald-600 hover:bg-emerald-700">
                        Accept 50% Discount
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="text-muted-foreground" OnClick="@(() => _step = 1)">
                        <LucideIconCn Name="arrow-left" Size="12" Class="mr-2 size-3" />
                        No thanks, finish cancellation
                    </ButtonCn>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private int _step = 1;
    private string _reason = "expensive";
}
