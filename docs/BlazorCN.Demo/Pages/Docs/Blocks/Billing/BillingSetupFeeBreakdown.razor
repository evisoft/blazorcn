@* ============================================================
   Block: billing-setup-fee-breakdown
   Title: BillingSetupFeeBreakdown
   Description: A billing summary block for React and Next.js that explicitly separates one-time setup fees from recurring subscription costs built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-setup-fee-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Enterprise Initial Investment</span>
            </div>
        </div>

        <div class="p-4 space-y-6">

            @* Setup Fee Section *@
            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div class="space-y-0.5">
                        <p class="text-sm font-semibold">One-time Setup Fee</p>
                        <p class="text-xs text-muted-foreground">Implementation &amp; Training</p>
                    </div>
                    <span class="text-lg font-bold tabular-nums">@($"{_setupFee:C}")</span>
                </div>
            </div>

            @* Recurring Fee Section *@
            <div class="space-y-3 border-t pt-6">
                <div class="flex items-center justify-between">
                    <div class="space-y-0.5">
                        <p class="text-sm font-semibold">Enterprise Subscription</p>
                        <p class="text-xs text-muted-foreground">Annual Recurring (Billed Today)</p>
                    </div>
                    <span class="text-lg font-bold tabular-nums">@($"{_recurringFee:C}")</span>
                </div>
                <div class="flex items-center gap-2 rounded-md bg-blue-500/5 px-3 py-2 text-[10px] text-blue-700 dark:text-blue-400">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                    Renews on @_nextRenewalDate at $@($"{_recurringFee:N0}")/year
                </div>
            </div>

            @* Total Summary *@
            <div class="rounded-lg bg-muted/50 p-4 border">
                <div class="flex items-center justify-between mb-4">
                    <span class="text-sm font-medium">Due Today</span>
                    <span class="text-3xl font-bold tracking-tight tabular-nums">@($"{_totalToday:C}")</span>
                </div>
                <ButtonCn Class="w-full h-10 gap-2 font-semibold">
                    <LucideIconCn Name="credit-card" Size="16" Class="size-4" />
                    Complete Payment
                </ButtonCn>
            </div>

        </div>

        @* Info Footer *@
        <div class="px-4 py-2.5 bg-muted/20 border-t">
            <div class="flex items-center gap-2 text-[10px] text-muted-foreground">
                <LucideIconCn Name="info" Size="12" Class="size-3" />
                <span>
                    By clicking &ldquo;Complete Payment&rdquo;, you agree to the Enterprise Service Agreement and the
                    billing terms outlined above.
                </span>
            </div>
        </div>

    </div>
</section>

@code {
    private const double _setupFee = 2500.0;
    private const double _recurringFee = 12000.0;
    private const double _totalToday = _setupFee + _recurringFee;
    private const string _nextRenewalDate = "June 1, 2027";
}
