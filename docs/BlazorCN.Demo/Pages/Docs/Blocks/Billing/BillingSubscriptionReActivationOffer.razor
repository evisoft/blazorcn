@* ============================================================
   Block: billing-subscription-re-activation-offer
   Title: BillingSubscriptionReActivationOffer
   Description: A high-conversion win-back component for React and Next.js designed to encourage churned users to return with limited-time discounts built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-subscription-re-activation-offer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-gradient-to-b from-card to-muted/30">

        @* Decorative Top Bar *@
        <div class="h-1 w-full bg-foreground"></div>

        @* Content *@
        <div class="px-6 py-8 text-center">
            <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-foreground text-background">
                <LucideIconCn Name="sparkles" Size="24" Class="size-6" />
            </div>

            <div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="mb-2 font-medium text-[10px] uppercase tracking-widest border-foreground/20">
                    Limited Time Offer
                </BadgeCn>
                <h2 class="text-xl font-semibold text-foreground tracking-tight">
                    We've missed you, Sarah!
                </h2>
                <p class="mt-2 text-muted-foreground text-sm">
                    Come back today and get <strong>@_discountPercent% off</strong> your next @_monthsRemaining months.
                    All your previous data and settings have been preserved.
                </p>
            </div>

            @* Pricing Comparison *@
            <div class="mt-8 flex items-center justify-center gap-8">
                <div class="text-left">
                    <span class="text-[10px] font-medium text-muted-foreground uppercase tracking-wider">Regular</span>
                    <div class="text-lg font-medium text-muted-foreground/50 line-through">$49/mo</div>
                </div>
                <LucideIconCn Name="arrow-right" Size="16" Class="size-4 text-muted-foreground" />
                <div class="text-left">
                    <span class="text-[10px] font-medium text-foreground uppercase tracking-wider">Your Price</span>
                    <div class="flex items-baseline gap-1">
                        <span class="text-3xl font-bold text-foreground">$</span>
                        <span class="text-3xl font-bold text-foreground">29</span>
                        <span class="text-foreground/70 text-sm font-medium">/mo</span>
                    </div>
                </div>
            </div>

            @* Actions *@
            <div class="mt-10 flex flex-col gap-3">
                <ButtonCn Size="ButtonSize.Lg" Class="h-11 w-full gap-2 font-medium">
                    Claim Your Discount
                    <LucideIconCn Name="gift" Size="16" Class="size-4" />
                </ButtonCn>
                <div class="flex items-center justify-center gap-4">
                    <button class="text-xs text-muted-foreground hover:text-foreground transition-colors flex items-center gap-1.5">
                        <LucideIconCn Name="history" Size="14" Class="size-3.5" />
                        View previous usage
                    </button>
                    <div class="h-3 w-px bg-muted"></div>
                    <button class="text-xs text-muted-foreground hover:text-foreground transition-colors">
                        Compare other plans
                    </button>
                </div>
            </div>
        </div>

        @* Footer Guarantee *@
        <div class="border-t bg-muted/50 px-6 py-3 text-center">
            <p class="text-[10px] text-muted-foreground font-medium uppercase tracking-widest">
                No long term commitment • Cancel anytime
            </p>
        </div>
    </div>
</section>

@code {
    private const int _discountPercent = 40;
    private const int _monthsRemaining = 6;
}
