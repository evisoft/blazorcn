@* ============================================================
   Block: billing-feature-usage-heat-map
   Title: BillingFeatureUsageHeatMap
   Description: A high-density data visualization component for React and Next.js that shows the distribution and intensity of feature usage across a time period built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-feature-usage-heat-map.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="grid-3x3" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Usage Heat Map</span>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                    <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-[10px] font-medium uppercase">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                    Last 7 Days
                </ButtonCn>
            </div>
        </div>

        @* Heat Map Grid *@
        <div class="px-4 py-6 border-b">
            <div class="flex flex-col gap-4">
                @for (int fIdx = 0; fIdx < _features.Length; fIdx++)
                {
                    var feature = _features[fIdx];
                    <div class="flex items-center gap-4">
                        <span class="w-24 text-[10px] font-medium text-muted-foreground uppercase truncate">
                            @feature
                        </span>
                        <div class="grid flex-1 grid-cols-7 gap-1.5">
                            @for (int dIdx = 0; dIdx < _days.Length; dIdx++)
                            {
                                var day = _days[dIdx];
                                var intensity = _intensities[fIdx, dIdx];
                                var bgValue = (intensity * 0.8 + 0.05).ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                                var eventCount = (int)Math.Round(intensity * 1000);
                                <div
                                    class="aspect-square rounded-sm border border-foreground/5"
                                    style="@($"background-color: rgba(0,0,0,{bgValue})")"
                                    title="@($"{feature} on {day}: {eventCount} events")"
                                ></div>
                            }
                        </div>
                    </div>
                }
            </div>

            @* Legend *@
            <div class="mt-6 flex items-center justify-end gap-3">
                <span class="text-[10px] text-muted-foreground uppercase tracking-widest">Low</span>
                <div class="flex gap-1">
                    @foreach (var op in _legendOps)
                    {
                        var opStr = op.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
                        <div class="size-2 rounded-sm" style="@($"background-color: rgba(0,0,0,{opStr})")"></div>
                    }
                </div>
                <span class="text-[10px] text-muted-foreground uppercase tracking-widest">High</span>
            </div>
        </div>

        @* Footer info *@
        <div class="flex items-center justify-between px-4 py-3 bg-muted/20">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="filter" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-[11px]">
                    Filtered by: All Production Clusters
                </span>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    View Insights
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="maximize-2" Size="14" Class="size-3.5" />
                    Full Report
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features = ["API Requests", "Storage Ops", "CDN Transfer", "Auth Events"];
    private static readonly string[] _days = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    private static readonly double[] _legendOps = [0.1, 0.3, 0.5, 0.7, 0.9];

    // Fixed deterministic intensity values replacing Math.random() (rows = features, cols = days)
    private static readonly double[,] _intensities =
    {
        { 0.72, 0.45, 0.88, 0.31, 0.67, 0.14, 0.55 },
        { 0.38, 0.91, 0.22, 0.76, 0.49, 0.83, 0.17 },
        { 0.61, 0.28, 0.54, 0.93, 0.35, 0.70, 0.42 },
        { 0.19, 0.65, 0.80, 0.47, 0.58, 0.26, 0.89 }
    };
}
