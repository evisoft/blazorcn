@* ============================================================
   Block: billing-add-on-usage-breakdown
   Title: BillingAddOnUsageBreakdown
   Description: A detailed usage analysis component for React and Next.js that visualizes the consumption and cost of individual plan add-ons built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-add-on-usage-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="plus-circle" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Add-on Usage</span>
            </div>
            <div class="flex items-center gap-1 text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
                <LucideIconCn Name="bar-chart-3" Size="12" Class="size-3" />
                Current Cycle
            </div>
        </div>

        @* Add-on List *@
        <div class="divide-y">
            @foreach (var addon in _addons)
            {
                <div class="px-4 py-4">
                    <div class="flex items-start justify-between mb-3">
                        <div class="flex items-center gap-2.5">
                            <div class="flex size-7 items-center justify-center rounded-md bg-muted/50 border">
                                <LucideIconCn Name="@addon.Icon" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                            <div>
                                <h4 class="text-xs font-semibold text-foreground leading-none">@addon.Name</h4>
                                <p class="mt-1 text-[10px] text-muted-foreground">
                                    @addon.Used.ToString("N0") of @addon.Total.ToString("N0") units
                                </p>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="flex items-baseline justify-end gap-0.5">
                                <span class="text-sm font-bold text-foreground">$</span>
                                <span class="text-sm font-bold text-foreground">@addon.Cost</span>
                            </div>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 px-1 text-[8px] font-medium uppercase border-muted-foreground/20">
                                Active
                            </BadgeCn>
                        </div>
                    </div>

                    @* Progress Bar *@
                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-foreground"
                             style="@($"width:{(double)addon.Used / addon.Total * 100:F1}%")">
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Summary Footer *@
        <div class="flex items-center justify-between px-4 py-3 bg-muted/20">
            <div class="flex flex-col gap-0.5">
                <span class="text-[10px] font-medium text-muted-foreground uppercase tracking-wider">Total Add-on Spend</span>
                <div class="flex items-baseline gap-1">
                    <span class="text-base font-semibold text-foreground">$</span>
                    <span class="text-base font-semibold text-foreground">@_addons.Sum(a => a.Cost)</span>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    View History
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Marketplace
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Addon(string Name, int Used, int Total, int Cost, string Icon);

    private static readonly Addon[] _addons =
    [
        new("Extra Storage (50GB)", 42, 50, 10, "hard-drive"),
        new("Priority Support", 3, 5, 25, "info"),
        new("API Rate Limit Boost", 12400, 20000, 15, "zap"),
    ];
}
