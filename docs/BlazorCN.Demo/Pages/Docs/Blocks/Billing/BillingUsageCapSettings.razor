@* ============================================================
   Block: billing-usage-cap-settings
   Title: BillingUsageCapSettings
   Description: A cost-control billing block for metered SaaS featuring custom spending limits, notification thresholds, and automatic service throttling options built with shadcn/ui.
   Source: original/blocks/billing/billing-usage-cap-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="settings-2" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Cost Controls</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <div class="size-1.5 rounded-full bg-emerald-500"></div>
                    <span class="text-[10px] text-muted-foreground font-bold uppercase tracking-widest">
                        Active
                    </span>
                </div>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Set spending limits to prevent unexpected overage charges. We&apos;ll notify you when
                you approach your limits.
            </p>
        </div>

        <div class="p-4 space-y-6">
            <div class="space-y-4">
                <div class="flex items-center justify-between">
                    <div class="space-y-0.5">
                        <label for="spending-cap" class="text-xs font-bold uppercase text-muted-foreground tracking-tight">
                            Monthly Spending Cap
                        </label>
                        <p class="text-[10px] text-muted-foreground leading-none">
                            Maximum monthly overage budget
                        </p>
                    </div>
                    <div class="flex items-baseline gap-1">
                        <span class="text-sm font-bold">$</span>
                        <span class="text-xl font-bold tracking-tight">@_cap</span>
                    </div>
                </div>
                <SliderCn Value="@((double)_cap)" ValueChanged="@((double v) => _cap = (int)v)" Max="2000" Step="50" Class="py-4" />
            </div>

            <div class="grid gap-3">
                <div class="flex items-center justify-between rounded-md border p-3 bg-muted/20">
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                        <div class="space-y-0.5">
                            <span class="text-xs font-medium">Smart Notifications</span>
                            <p class="text-[10px] text-muted-foreground">
                                Alert me at @(_notifyAt)% of my cap
                            </p>
                        </div>
                    </div>
                    <input type="number"
                           value="@_notifyAt"
                           @onchange="@((ChangeEventArgs e) => _notifyAt = int.TryParse(e.Value?.ToString(), out var n) ? n : _notifyAt)"
                           class="w-12 bg-transparent text-right text-xs font-bold font-mono focus:outline-none" />
                </div>

                <div class="flex items-center justify-between rounded-md border p-3 bg-muted/20">
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="triangle-alert" Size="16" Class="size-4 text-muted-foreground" />
                        <div class="space-y-0.5">
                            <span class="text-xs font-medium">Automatic Throttling</span>
                            <p class="text-[10px] text-muted-foreground">
                                Pause service when cap is reached
                            </p>
                        </div>
                    </div>
                    <SwitchCn @bind-Checked="_throttle" />
                </div>
            </div>

            <div class="rounded-lg border bg-zinc-950 p-4 text-white dark:bg-zinc-900">
                <div class="flex items-start justify-between">
                    <div class="space-y-1">
                        <h4 class="text-sm font-medium flex items-center gap-2">
                            <LucideIconCn Name="circle-dollar-sign" Size="16" Class="size-4 text-emerald-500" />
                            Estimated Max Bill
                        </h4>
                        <p class="text-xs text-zinc-400">Base Plan ($49) + Max Overage ($@_cap)</p>
                    </div>
                    <div class="text-right">
                        <div class="flex items-baseline justify-end gap-1">
                            <span class="text-lg font-bold">$</span>
                            <span class="text-2xl font-bold tracking-tight text-emerald-400">@(49 + _cap)</span>
                        </div>
                        <p class="text-[10px] text-zinc-500 uppercase font-bold tracking-wider">
                            Estimated Monthly
                        </p>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end pt-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-4 text-xs font-semibold">
                    Save Cap Settings
                </ButtonCn>
            </div>
        </div>

        <div class="bg-muted/50 border-t px-4 py-2.5 text-center">
            <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
                Settings are applied globally across all API keys
            </p>
        </div>
    </div>
</section>

@code {
    private int _cap = 500;
    private int _notifyAt = 80;
    private bool _throttle = true;
}
