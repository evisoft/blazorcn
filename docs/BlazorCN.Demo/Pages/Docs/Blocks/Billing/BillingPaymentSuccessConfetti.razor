@* ============================================================
   Block: billing-payment-success-confetti
   Title: BillingPaymentSuccessConfetti
   Description: A celebratory payment success screen with built-in confetti effects for React and Next.js, built with shadcn/ui and canvas-confetti.
   Source: original/blocks/billing/billing-payment-success-confetti.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-xl border bg-card p-8 text-center shadow-2xl shadow-emerald-500/10">

        @* Background Sparkles *@
        <div class="absolute top-0 left-0 h-full w-full opacity-10 pointer-events-none">
            <LucideIconCn Name="sparkles" Size="48" Class="absolute top-10 left-10 size-12 animate-pulse text-emerald-500" />
            <LucideIconCn Name="sparkles" Size="32" Class="absolute bottom-10 right-10 size-8 animate-pulse text-emerald-500" />
        </div>

        <div class="relative flex flex-col items-center">
            <div class="flex size-20 items-center justify-center rounded-full bg-emerald-500 text-white shadow-lg shadow-emerald-500/40">
                <LucideIconCn Name="check" Size="40" Class="size-10 stroke-[3]" />
            </div>

            <div class="mt-6">
                <h2 class="text-2xl font-bold tracking-tight">Payment Successful!</h2>
                <p class="mt-2 text-muted-foreground">
                    Welcome to the Pro Plan. Your features have been unlocked and are ready for use.
                </p>
            </div>

            <div class="mt-10 flex w-full flex-col gap-3">
                <ButtonCn Size="ButtonSize.Lg" Class="w-full gap-2 bg-emerald-600 hover:bg-emerald-700">
                    <LucideIconCn Name="party-popper" Size="16" Class="size-4" />
                    Get Started
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Class="text-muted-foreground">
                    View Receipt
                </ButtonCn>
            </div>
        </div>
    </div>
</section>
