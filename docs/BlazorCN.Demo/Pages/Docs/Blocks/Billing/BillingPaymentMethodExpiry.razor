@* ============================================================
   Block: billing-payment-method-expiry
   Title: BillingPaymentMethodExpiry
   Description: A proactive warning block for expiring credit cards in React and Next.js, featuring urgency indicators and quick update actions built with shadcn/ui.
   Source: original/blocks/billing/billing-payment-method-expiry.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-between rounded-lg border border-amber-200 bg-amber-50/30 p-4 dark:border-amber-900/50 dark:bg-amber-950/20">
        <div class="flex items-start gap-4">
            <div class="mt-0.5 rounded-full bg-amber-100 p-2 text-amber-600 dark:bg-amber-900/30 dark:text-amber-500">
                <LucideIconCn Name="alert-triangle" Size="20" Class="size-5" />
            </div>
            <div class="space-y-1">
                <h3 class="font-medium text-sm leading-none">Card Expiring Soon</h3>
                <p class="text-muted-foreground text-xs leading-relaxed">
                    Your @_cardBrand ending in @_lastFour expires on @_expiryDate. Update your payment
                    method to avoid service interruption.
                </p>
                <div class="flex items-center gap-2 pt-1">
                    <div class="flex h-5 w-8 items-center justify-center rounded border bg-card">
                        <LucideIconCn Name="credit-card" Size="12" Class="size-3 text-muted-foreground" />
                    </div>
                    <span class="font-mono text-[10px] text-muted-foreground">
                        •••• •••• •••• @_lastFour
                    </span>
                </div>
            </div>
        </div>
        <div class="shrink-0">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 px-3 text-xs bg-amber-600 hover:bg-amber-700 text-white border-none">
                Update
                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _cardBrand = "Mastercard";
    private string _lastFour = "8812";
    private string _expiryDate = "07/2026";
}
