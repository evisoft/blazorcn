@* ============================================================
   Block: billing-managed-services-pricing
   Title: BillingManagedServicesPricing
   Description: A billing managed services and concierge plan block for React and Next.js with human-support highlights and custom onboarding features built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-managed-services-pricing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-xl border bg-card shadow-lg">
        <div class="flex flex-col sm:flex-row">
            <div class="flex-1 p-6 sm:p-8">
                <div class="flex items-center gap-2 mb-4">
                    <BadgeCn Variant="BadgeVariant.Secondary"
                             Class="bg-primary/10 text-primary border-primary/20 gap-1.5 uppercase text-[10px] tracking-widest font-bold">
                        <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                        Concierge
                    </BadgeCn>
                </div>
                <h2 class="font-bold text-2xl tracking-tight">Managed Enterprise</h2>
                <p class="mt-2 text-muted-foreground text-sm leading-relaxed">
                    Focus on your core business while our experts handle the technical heavy lifting,
                    security compliance, and scale.
                </p>

                <ul class="mt-8 space-y-4">
                    @foreach (var service in _services)
                    {
                        <li class="flex items-center gap-3 text-sm font-medium">
                            <LucideIconCn Name="badge-check" Size="16" Class="size-4 text-primary shrink-0" />
                            <span>@service</span>
                        </li>
                    }
                </ul>
            </div>

            <div class="w-full sm:w-64 bg-muted/30 border-t sm:border-t-0 sm:border-l p-6 flex flex-col justify-between">
                <div class="space-y-6">
                    <div>
                        <p class="text-muted-foreground text-[10px] uppercase tracking-wider font-bold mb-3">
                            Your Team
                        </p>
                        <div class="flex items-center gap-3">
                            <div class="size-10 rounded-full bg-primary/10 border border-primary/20 flex items-center justify-center text-primary">
                                <LucideIconCn Name="user" Size="20" Class="size-5" />
                            </div>
                            <div>
                                <p class="text-sm font-semibold">Sarah Jenkins</p>
                                <p class="text-[10px] text-muted-foreground">Account Director</p>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-2">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Uptime SLA</span>
                            <span class="font-semibold">99.99%</span>
                        </div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Response Time</span>
                            <span class="font-semibold">&lt; 1 Hour</span>
                        </div>
                    </div>
                </div>

                <div class="mt-8 space-y-3">
                    <div class="text-center sm:text-left">
                        <span class="text-2xl font-bold">$2,499</span>
                        <span class="text-muted-foreground text-xs ml-1">/mo</span>
                    </div>
                    <ButtonCn Class="w-full h-10 gap-2 font-semibold shadow-sm">
                        <LucideIconCn Name="message-square" Size="16" Class="size-4" />
                        Contact Sales
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="bg-primary/5 px-6 py-3 border-t flex items-center justify-center gap-6">
            <div class="flex items-center gap-2 text-primary text-[10px] font-bold uppercase tracking-widest">
                <LucideIconCn Name="shield" Size="14" Class="size-3.5" />
                <span>SOC2 Type II</span>
            </div>
            <div class="flex items-center gap-2 text-primary text-[10px] font-bold uppercase tracking-widest">
                <LucideIconCn Name="headset" Size="14" Class="size-3.5" />
                <span>VIP Support</span>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _services =
    [
        "Dedicated Implementation Engineer",
        "Custom Security & Audit Reports",
        "Priority 24/7 Phone Support",
        "Quarterly Strategic Reviews",
        "White-glove Migration Service",
    ];
}
