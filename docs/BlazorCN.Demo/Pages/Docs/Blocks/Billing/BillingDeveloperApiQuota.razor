@* ============================================================
   Block: billing-developer-api-quota
   Title: BillingDeveloperApiQuota
   Description: A technical billing block for React and Next.js to monitor API rate limits, monthly quotas, and overage projections built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-developer-api-quota.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="code-2" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">API Usage &amp; Quota</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-[10px] uppercase tracking-wider h-5">
                Production
            </BadgeCn>
        </div>

        @* Main Stats *@
        <div class="px-4 py-8 border-b bg-muted/5">
            <div class="flex flex-col items-center text-center">
                <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] uppercase font-bold tracking-widest mb-2">
                    <LucideIconCn Name="cpu" Size="12" Class="size-3" />
                    <span>Requests This Month</span>
                </div>
                <div class="flex items-baseline gap-2">
                    <span class="font-bold text-5xl tracking-tighter">
                        @_currentUsage.ToString("N0")
                    </span>
                    <span class="text-muted-foreground font-medium text-lg">/ @(_monthlyLimit / 1000)k</span>
                </div>
                <p class="mt-4 text-muted-foreground text-sm max-w-[320px]">
                    You have utilized <span class="text-foreground font-semibold">@_progress.ToString("F1")%</span> of your monthly API request quota.
                </p>
            </div>
        </div>

        @* Progress & Projection *@
        <div class="px-4 py-6 border-b space-y-6">
            <div class="space-y-2">
                <div class="flex items-center justify-between text-xs mb-1">
                    <span class="font-medium text-muted-foreground">Monthly Limit</span>
                    <span class="text-muted-foreground tabular-nums">
                        @_currentUsage.ToString("N0") / @_monthlyLimit.ToString("N0")
                    </span>
                </div>
                <ProgressCn Value="@_progress" Class="h-1.5" />
            </div>

            <div class="grid grid-cols-2 gap-4">
                <div class="p-3 rounded-md border bg-muted/20">
                    <p class="text-[10px] uppercase font-bold text-muted-foreground tracking-wider mb-1">Projected Total</p>
                    <div class="flex items-baseline gap-1">
                        <span class="font-semibold text-lg">
                            @_projectedTotal.ToString("N0")
                        </span>
                        <span class="text-[10px] text-muted-foreground">reqs</span>
                    </div>
                </div>
                <div class="p-3 rounded-md border bg-muted/20">
                    <p class="text-[10px] uppercase font-bold text-muted-foreground tracking-wider mb-1">Rate Limit</p>
                    <div class="flex items-center gap-1.5">
                        <span class="font-semibold text-lg">1,200</span>
                        <span class="text-[10px] text-muted-foreground">req / min</span>
                    </div>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                <LucideIconCn Name="zap" Size="12" Class="size-3" />
                Scale Quota
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                Documentation
            </ButtonCn>
            <div class="ml-auto flex items-center gap-2 text-muted-foreground text-[10px] uppercase font-medium">
                <LucideIconCn Name="infinity" Size="12" Class="size-3" />
                Hard limit disabled
            </div>
        </div>
    </div>
</section>

@code {
    private readonly int _currentUsage = 842910;
    private readonly int _monthlyLimit = 1000000;
    private readonly int _projectedTotal = 950000;
    private readonly double _progress = (double)842910 / 1000000 * 100;
}
