@* ============================================================
   Block: billing-custom-billing-cycle
   Title: BillingCustomBillingCycle
   Description: A flexible billing cycle management component for React and Next.js allowing users to toggle between monthly, annual, and custom fiscal periods built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-custom-billing-cycle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="refresh-cw" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Billing Frequency</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs bg-emerald-500/10 text-emerald-600 border-emerald-200/50">
                20% Savings
            </BadgeCn>
        </div>

        @* Cycle Options *@
        <div class="grid grid-cols-2 divide-x border-b">
            <button class="flex flex-col gap-1 px-4 py-4 text-left transition-colors hover:bg-muted/30">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-muted-foreground">Monthly</span>
                    <div class="size-3 rounded-full border"></div>
                </div>
                <div class="flex items-baseline gap-1">
                    <span class="text-xl font-semibold">$</span>
                    <span class="text-xl font-semibold">@_currentPrice</span>
                    <span class="text-muted-foreground text-xs">/mo</span>
                </div>
            </button>

            <button class="flex flex-col gap-1 px-4 py-4 text-left transition-colors bg-muted/50">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-foreground">Annual</span>
                    <div class="flex size-3 items-center justify-center rounded-full border border-foreground">
                        <div class="size-1.5 rounded-full bg-foreground"></div>
                    </div>
                </div>
                <div class="flex items-baseline gap-1">
                    <span class="text-xl font-semibold">$</span>
                    <span class="text-xl font-semibold">@_annualPrice</span>
                    <span class="text-muted-foreground text-xs">/mo</span>
                </div>
            </button>
        </div>

        @* Custom Period Info *@
        <div class="border-b px-4 py-4">
            <div class="flex items-start gap-3">
                <div class="mt-0.5 flex size-8 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div class="flex-1">
                    <h4 class="text-xs font-medium">Next Renewal</h4>
                    <p class="text-muted-foreground text-[11px] leading-normal">
                        Your billing cycle will renew on <strong>January 1, 2025</strong>.
                        Switching to annual will extend your next payment date by 11 months.
                    </p>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="arrow-right-left" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs underline underline-offset-4 cursor-help">
                    Compare plans
                </span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                Confirm Change
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const int _currentPrice = 49;
    private const int _annualPrice = 39;
}
