@* ============================================================
   Block: billing-credit-history-log
   Title: BillingCreditHistoryLog
   Description: A detailed transactional billing block for React and Next.js to track account credit additions, subtractions, and expirations built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-credit-history-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="history" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Credit History</span>
            </div>
            <div class="relative">
                <LucideIconCn Name="search" Size="12" Class="absolute left-2 top-1/2 -translate-y-1/2 size-3 text-muted-foreground" />
                <InputCn aria-label="Search activity" Placeholder="Search activity..." Class="h-7 w-40 pl-7 text-[10px] bg-muted/50 border-none focus-visible:ring-1" />
            </div>
        </div>

        @* Transaction List *@
        <div class="divide-y">
            @foreach (var tx in _transactions)
            {
                var isNegative = tx.Amount < 0;
                <div class="flex items-center justify-between px-4 py-3.5 hover:bg-muted/30 transition-colors">
                    <div class="flex items-center gap-3">
                        <div class="@Cn.Merge("flex size-8 items-center justify-center rounded-full border", isNegative ? "bg-red-50 text-red-600 dark:bg-red-950/20 dark:text-red-400" : "bg-emerald-50 text-emerald-600 dark:bg-emerald-950/20 dark:text-emerald-400")">
                            @if (isNegative)
                            {
                                <LucideIconCn Name="arrow-up-right" Size="16" Class="size-4" />
                            }
                            else
                            {
                                <LucideIconCn Name="arrow-down-left" Size="16" Class="size-4" />
                            }
                        </div>
                        <div>
                            <p class="font-medium text-sm leading-tight">@tx.Name</p>
                            <p class="text-muted-foreground text-[10px] uppercase font-bold tracking-tight mt-0.5">@tx.Date</p>
                        </div>
                    </div>
                    <div class="flex flex-col items-end gap-1.5">
                        <span class="@Cn.Merge("font-mono font-bold text-sm tabular-nums", isNegative ? "text-foreground" : "text-emerald-600 dark:text-emerald-400")">
                            @(isNegative ? tx.Amount.ToString("C") : "+" + tx.Amount.ToString("C"))
                        </span>
                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-[9px] uppercase font-bold px-1 h-4 text-muted-foreground border-muted-foreground/20">
                            @tx.Type
                        </BadgeCn>
                    </div>
                </div>
            }
        </div>

        @* Footer Actions *@
        <div class="flex items-center gap-2 px-4 py-3 bg-muted/20">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs text-muted-foreground">
                Export CSV
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs text-muted-foreground">
                Print Log
            </ButtonCn>
            <p class="ml-auto text-muted-foreground text-[10px] italic">
                Showing last 5 of 128 transactions
            </p>
        </div>
    </div>
</section>

@code {
    private record Transaction(string Id, string Date, string Type, string Name, double Amount, string Status);

    private static readonly Transaction[] _transactions =
    [
        new("t1", "May 22, 2026", "usage", "AI Image Generation", -15.00, "completed"),
        new("t2", "May 20, 2026", "topup", "Manual Recharge", 100.00, "completed"),
        new("t3", "May 18, 2026", "bonus", "Referral Bonus", 25.00, "completed"),
        new("t4", "May 15, 2026", "usage", "Monthly API Storage", -8.50, "completed"),
        new("t5", "May 12, 2026", "usage", "Vector Database Quota", -24.00, "completed"),
    ];
}
