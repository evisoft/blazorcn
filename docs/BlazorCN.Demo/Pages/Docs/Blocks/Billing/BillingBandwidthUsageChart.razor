@* ============================================================
   Block: billing-bandwidth-usage-chart
   Title: BillingBandwidthUsageChart
   Description: A visual usage tracking block featuring an interactive chart for bandwidth consumption, storage limits, and overage projections.
   Source: original/blocks/billing/billing-bandwidth-usage-chart.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        <div class="border-b px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Bandwidth Usage</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="@($"size-1.5 rounded-full {(_isHigh ? "bg-amber-500" : "bg-emerald-500")}")"></span>
                <span class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                    @(_isHigh ? "Near Limit" : "Healthy")
                </span>
            </div>
        </div>

        <div class="p-5 space-y-6">
            <div class="flex items-end justify-between">
                <div class="space-y-1">
                    <p class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        Used this month
                    </p>
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-3xl font-bold tracking-tight tabular-nums">
                            @_used.ToString("F1")
                        </span>
                        <span class="text-muted-foreground font-semibold">GB</span>
                    </div>
                </div>
                <div class="text-right space-y-1">
                    <p class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        Total Limit
                    </p>
                    <p class="text-sm font-semibold">@_limit GB</p>
                </div>
            </div>

            <div class="space-y-2">
                <div class="flex items-center justify-between text-[11px] font-medium text-muted-foreground">
                    <span>Current Consumption</span>
                    <span class="tabular-nums">@((int)Math.Round(_percentage))%</span>
                </div>
                <ProgressCn Value="@(_percentage)" Class="@($"h-2 {(_isHigh ? "[&>div]:bg-amber-500" : "[&>div]:bg-primary")}")" />
            </div>

            <div class="grid grid-cols-2 gap-3">
                <div class="p-3 rounded-lg border bg-muted/20 space-y-1">
                    <div class="flex items-center gap-2 text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        <LucideIconCn Name="bar-chart-3" Size="12" Class="size-3" />
                        Peak Daily
                    </div>
                    <p class="text-sm font-semibold">4.8 GB</p>
                </div>
                <div class="p-3 rounded-lg border bg-muted/20 space-y-1">
                    <div class="flex items-center gap-2 text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        <LucideIconCn Name="zap" Size="12" Class="size-3" />
                        Requests
                    </div>
                    <p class="text-sm font-semibold">2.4M</p>
                </div>
            </div>

            @if (_isHigh)
            {
                <div class="flex items-start gap-3 p-3 rounded-lg border border-amber-500/20 bg-amber-500/5">
                    <LucideIconCn Name="info" Size="16" Class="size-4 text-amber-600 mt-0.5" />
                    <p class="text-xs text-amber-900 leading-relaxed">
                        You've used 84% of your monthly bandwidth. <b>Consider upgrading</b> to avoid
                        $0.05/GB overage charges.
                    </p>
                </div>
            }
        </div>

        <div class="bg-muted/50 border-t px-4 py-2.5">
            <p class="text-center text-[10px] text-muted-foreground uppercase tracking-widest font-semibold">
                Next reset in 8 days (June 1st)
            </p>
        </div>
    </div>
</section>

@code {
    private const double _used = 84.2;
    private const int _limit = 100;
    private double _percentage => (_used / _limit) * 100;
    private bool _isHigh => _percentage > 80;
}
