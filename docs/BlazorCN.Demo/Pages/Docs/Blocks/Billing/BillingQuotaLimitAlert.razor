@* ============================================================
   Block: billing-quota-limit-alert
   Title: BillingQuotaLimitAlert
   Description: A high-visibility billing alert for React and Next.js to notify users when they are nearing resource limits (API, storage, seats) built with shadcn/ui.
   Source: original/blocks/billing/billing-quota-limit-alert.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-amber-500/20 bg-amber-500/5">
        <div class="p-4">
            <div class="flex items-start justify-between gap-4">
                <div class="flex items-start gap-3">
                    <div class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-full bg-amber-500/10">
                        <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-amber-600 dark:text-amber-400" />
                    </div>
                    <div class="min-w-0">
                        <p class="font-medium text-sm text-amber-900 dark:text-amber-300">
                            You've used @_percentage% of your API quota
                        </p>
                        <p class="mt-1 text-amber-800/80 text-xs dark:text-amber-400/80">
                            Your current plan allows for @_limit.ToString("N0") requests per month. To
                            avoid service interruption, consider upgrading your plan.
                        </p>
                    </div>
                </div>
                <div class="hidden text-right sm:block">
                    <div class="font-mono text-lg font-bold text-amber-600 tabular-nums dark:text-amber-400">
                        @_remaining
                    </div>
                    <p class="text-[10px] uppercase tracking-wider text-amber-700/60 dark:text-amber-400/60">
                        Left this month
                    </p>
                </div>
            </div>

            <div class="mt-5 space-y-2">
                <div class="flex items-center justify-between text-[10px] font-medium uppercase tracking-wider text-amber-700/70 dark:text-amber-400/70">
                    <span>@_used.ToString("N0") Used</span>
                    <span>@_limit.ToString("N0") Limit</span>
                </div>
                <ProgressCn Value="@_percentage" Class="h-1.5 bg-amber-200 dark:bg-amber-900/40" aria-label="Progress" />
            </div>
        </div>

        <div class="flex flex-col items-center justify-between gap-3 border-t border-amber-500/10 bg-amber-500/10 px-4 py-2.5 sm:flex-row">
            <div class="flex items-center gap-2 text-amber-800 dark:text-amber-400">
                <LucideIconCn Name="zap" Size="14" Class="size-3.5 fill-current" />
                <span class="text-xs font-medium">Automatic overages are currently disabled</span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full bg-amber-600 text-white hover:bg-amber-700 sm:w-auto dark:bg-amber-500 dark:hover:bg-amber-600">
                Upgrade Plan
                <LucideIconCn Name="arrow-up-right" Size="12" Class="ml-1.5 size-3" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const int _used = 8500;
    private const int _limit = 10000;
    private const int _percentage = 85;
    private const int _remaining = 1500;
}
