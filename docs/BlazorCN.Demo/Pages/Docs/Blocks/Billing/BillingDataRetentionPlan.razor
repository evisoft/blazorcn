@* ============================================================
   Block: billing-data-retention-plan
   Title: BillingDataRetentionPlan
   Description: A billing data retention management block for React and Next.js with toggleable plans and capacity indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-data-retention-plan.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="database" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Data Retention Policy</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Choose how long we should store your historical data. Longer retention periods provide
                better insights but may increase storage costs.
            </p>
        </div>

        <div class="px-4 py-4">
            <div class="grid gap-3">
                @foreach (var plan in _retentionPlans)
                {
                    <label class="@Cn.Merge("relative flex cursor-pointer flex-col gap-1 rounded-md border p-3 transition-colors hover:bg-muted/50", _selectedPlan == plan.Id ? "border-primary/50 bg-primary/5" : "")"
                           @onclick="@(() => _selectedPlan = plan.Id)">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <input type="radio" name="retention-plan" value="@plan.Id" class="sr-only" />
                                <span class="font-medium text-sm">@plan.Label</span>
                                @if (plan.Price == 0)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4.5 px-1.5 text-[10px] uppercase">
                                        Included
                                    </BadgeCn>
                                }
                            </div>
                            <div class="flex items-baseline gap-1 text-sm tabular-nums">
                                <span class="font-medium">+$</span>
                                <span>@plan.Price</span>
                                <span class="text-muted-foreground text-xs">/mo</span>
                            </div>
                        </div>
                        <p class="text-muted-foreground text-xs">@plan.Description</p>
                    </label>
                }
            </div>
        </div>

        <div class="flex items-center justify-between border-t bg-muted/30 px-4 py-3">
            <div class="flex items-center gap-2.5">
                <SwitchCn @bind-Checked="_autoPurge" />
                <label class="cursor-pointer font-medium text-xs">
                    Enable automatic data purging
                </label>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8">
                Update Policy
            </ButtonCn>
        </div>

        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-emerald-500" />
                <span>Compliant with GDPR Article 17 (Right to Erasure)</span>
            </div>
        </div>
    </div>
</section>

@code {
    private string _selectedPlan = "30-days";
    private bool _autoPurge = false;

    private record RetentionPlan(string Id, string Label, int Price, string Description);

    private static readonly RetentionPlan[] _retentionPlans =
    [
        new("30-days", "30 Days", 0, "Standard audit logs and basic telemetry"),
        new("90-days", "90 Days", 29, "Extended performance metrics and user events"),
        new("1-year", "1 Year", 89, "Full compliance-ready historical data archive"),
    ];
}
