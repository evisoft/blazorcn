@* ============================================================
   Block: billing-priority-support-toggle
   Title: BillingPrioritySupportToggle
   Description: A premium add-on toggle for priority support services in React and Next.js, featuring real-time cost adjustments built with shadcn/ui.
   Source: original/blocks/billing/billing-priority-support-toggle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="@Cn.Merge("overflow-hidden rounded-lg border transition-colors", _enabled ? "border-foreground/20 bg-foreground/[0.02]" : "bg-card")">
        <div class="p-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-4">
                    <div class="@Cn.Merge("flex size-12 items-center justify-center rounded-xl", _enabled ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                        <LucideIconCn Name="headphones" Size="24" Class="size-6" />
                    </div>
                    <div class="space-y-0.5">
                        <div class="flex items-center gap-2">
                            <h3 class="font-bold text-base leading-none">Priority Support</h3>
                            @if (_enabled)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[9px] uppercase font-bold tracking-widest bg-foreground text-background">
                                    Active
                                </BadgeCn>
                            }
                        </div>
                        <p class="text-muted-foreground text-xs leading-relaxed max-w-[240px]">
                            Get <span class="text-foreground font-medium">sub-hour response times</span>
                            and dedicated support engineers.
                        </p>
                    </div>
                </div>
                <SwitchCn aria-label="Priority Support" @bind-Checked="_enabled" />
            </div>

            <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="rounded-lg border bg-background/50 p-4">
                    <div class="flex items-center gap-2 text-muted-foreground text-[10px] uppercase font-bold tracking-widest">
                        <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                        Standard Support
                    </div>
                    <p class="mt-1 text-sm font-medium">24h response time</p>
                    <p class="text-[10px] text-muted-foreground">Included in your plan</p>
                </div>
                <div class="@Cn.Merge("rounded-lg border p-4 transition-all", _enabled ? "border-foreground bg-foreground/5 shadow-sm" : "bg-muted/30 border-dashed")">
                    <div class="flex items-center gap-2 text-muted-foreground text-[10px] uppercase font-bold tracking-widest">
                        <LucideIconCn Name="zap" Size="12" Class="@Cn.Merge("size-3", _enabled ? "text-amber-500 fill-amber-500" : "")" />
                        Priority Add-on
                    </div>
                    <p class="mt-1 text-sm font-medium">1h response time</p>
                    <p class="text-[10px] text-muted-foreground">+$@_addOnPrice/month</p>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-between border-t bg-muted/30 px-6 py-4">
            <div class="space-y-0.5">
                <p class="text-[10px] text-muted-foreground uppercase font-bold tracking-widest">
                    New Monthly Total
                </p>
                <div class="flex items-baseline gap-1">
                    <span class="text-xl font-bold tabular-nums">
                        $@(_totalPrice.ToString("F2"))
                    </span>
                    <span class="text-muted-foreground text-xs">/mo</span>
                </div>
            </div>
            <p class="text-right text-[10px] text-muted-foreground max-w-[120px] leading-relaxed italic">
                * Changes take effect immediately. Pro-rated charges may apply.
            </p>
        </div>
    </div>
</section>

@code {
    private bool _enabled = false;
    private const double _basePrice = 49.0;
    private const double _addOnPrice = 15.0;
    private double _totalPrice => _enabled ? _basePrice + _addOnPrice : _basePrice;
}
