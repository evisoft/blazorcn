@* ============================================================
   Block: billing-usage-history
   Title: BillingUsageHistory
   Description: A resource usage history block for React and Next.js with mini sparklines, per-period consumption tracking, and limit alerts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-usage-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Usage History</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Monthly consumption of API requests. Warning indicators appear when usage exceeds 80%
                of your plan limit.
            </p>
        </div>

        @* Legend *@
        <div class="flex items-center gap-4 border-b bg-muted/30 px-4 py-2">
            <div class="flex items-center gap-1.5 text-[10px] text-muted-foreground uppercase tracking-wider font-medium">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                30-Day Trend
            </div>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-[10px] text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Normal
                </span>
                <span class="flex items-center gap-1.5 text-[10px] text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    Warning
                </span>
                <span class="flex items-center gap-1.5 text-[10px] text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    Critical
                </span>
            </div>
        </div>

        @* Usage List *@
        <div class="divide-y">
            @foreach (var data in _usageData)
            {
                <div class="flex items-center justify-between px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex items-center gap-3">
                        <span class="@($"size-1.5 shrink-0 rounded-full {StatusColor(data.Status)}")"></span>
                        <div class="min-w-0">
                            <p class="font-medium text-sm">@data.Period</p>
                            <span class="font-mono text-muted-foreground text-[10px] uppercase">
                                Total: @data.Total
                            </span>
                        </div>
                    </div>
                    <div class="h-8 w-24 shrink-0">
                        <svg viewBox="0 0 96 32" width="100%" height="100%" preserveAspectRatio="none">
                            <polyline
                                points="@GetSparklinePoints(data.Trend)"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="1.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                class="text-foreground/30" />
                        </svg>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Download full usage logs (JSON) · API Reference
            </p>
        </div>
    </div>
</section>

@code {
    private record UsagePeriod(string Period, string Total, string Status, int[] Trend);

    private static readonly UsagePeriod[] _usageData =
    [
        new("Mar 1 - Mar 31", "8,240 reqs", "normal", [10, 25, 15, 40, 35, 60, 45]),
        new("Feb 1 - Feb 28", "12,100 reqs", "warning", [30, 45, 80, 95, 85, 70, 60]),
        new("Jan 1 - Jan 31", "15,400 reqs", "critical", [40, 60, 90, 120, 110, 130, 140]),
    ];

    private static string StatusColor(string status) => status switch
    {
        "normal" => "bg-emerald-500",
        "warning" => "bg-amber-500",
        "critical" => "bg-red-500",
        _ => "bg-muted-foreground"
    };

    private static string GetSparklinePoints(int[] values)
    {
        if (values.Length < 2) return "";
        var min = values.Min();
        var max = values.Max();
        var range = max == min ? 1.0 : (double)(max - min);
        const double w = 96.0, h = 32.0, pad = 2.0;
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < values.Length; i++)
        {
            var x = pad + i * (w - 2 * pad) / (values.Length - 1);
            var y = h - pad - (values[i] - min) / range * (h - 2 * pad);
            if (i > 0) sb.Append(' ');
            sb.Append($"{x:F1},{y:F1}");
        }
        return sb.ToString();
    }
}
