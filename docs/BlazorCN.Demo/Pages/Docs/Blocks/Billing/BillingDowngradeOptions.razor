@* ============================================================
   Block: billing-downgrade-options
   Title: BillingDowngradeOptions
   Description: A billing downgrade and plan transition block for React and Next.js with feature impact analysis and retention prompts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-downgrade-options.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="arrow-down-circle" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Downgrade Options</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                We're sorry to see you go. Before you switch to the Free plan, consider these
                alternatives to keep your workflow uninterrupted.
            </p>
        </div>

        <div class="p-4">
            <div class="rounded-md border border-amber-500/20 bg-amber-500/5 p-3">
                <div class="flex items-center gap-2 text-amber-600 dark:text-amber-400">
                    <LucideIconCn Name="alert-circle" Size="16" Class="size-4" />
                    <span class="font-medium text-xs">You will lose access to:</span>
                </div>
                <ul class="mt-2 space-y-1.5">
                    @foreach (var item in _lossImpact)
                    {
                        <li class="flex items-center gap-2 text-muted-foreground text-xs">
                            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                            @item
                        </li>
                    }
                </ul>
            </div>

            <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div class="rounded-lg border p-4 transition-colors hover:bg-muted/50">
                    <LucideIconCn Name="pause-circle" Size="20" Class="size-5 text-blue-500" />
                    <h3 class="mt-2 font-medium text-sm">Pause Subscription</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Keep all your data and features, but pause billing for 1–3 months.
                    </p>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 w-full h-8 text-xs">
                        Pause Billing
                    </ButtonCn>
                </div>

                <div class="rounded-lg border p-4 transition-colors hover:bg-muted/50">
                    <LucideIconCn Name="arrow-down-circle" Size="20" Class="size-5 text-muted-foreground" />
                    <h3 class="mt-2 font-medium text-sm">Switch to Free</h3>
                    <p class="mt-1 text-muted-foreground text-xs">
                        Downgrade immediately. Features will be restricted at the end of the period.
                    </p>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 w-full h-8 text-xs">
                        Confirm Downgrade
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="bg-muted/30 px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="text-xs">
                    <span class="text-muted-foreground">Pro-rated credit:</span>
                    <span class="ml-1 font-medium">$12.40</span>
                </div>
                <p class="text-muted-foreground text-[10px]">
                    Credits will be applied to your next purchase.
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _lossImpact =
    [
        "Reduced API rate limits (1k vs 10k)",
        "Maximum 5 team members",
        "No priority email support",
        "14-day data retention",
    ];
}
