@* ============================================================
   Block: billing-enterprise-billing-portal
   Title: BillingEnterpriseBillingPortal
   Description: A comprehensive billing management dashboard for React and Next.js designed for large-scale enterprise organizations with multiple cost centers and complex hierarchies built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-enterprise-billing-portal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="building-2" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Acme Corp Global Portal</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-[10px] uppercase tracking-widest bg-background">
                Enterprise Admin
            </BadgeCn>
        </div>

        @* High Level Stats *@
        <div class="grid grid-cols-3 divide-x border-b">
            @foreach (var stat in _stats)
            {
                <div class="px-4 py-4">
                    <div class="flex items-center gap-1.5 mb-1 text-muted-foreground">
                        <LucideIconCn Name="@stat.Icon" Size="12" Class="size-3" />
                        <span class="text-[10px] font-medium uppercase tracking-wider">@stat.Label</span>
                    </div>
                    <div class="text-lg font-semibold tabular-nums">@stat.Value</div>
                </div>
            }
        </div>

        @* Department Overview *@
        <div class="px-4 py-4 border-b">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-xs font-semibold text-foreground uppercase tracking-wider">Top Departments</h3>
                <button class="text-[10px] text-muted-foreground hover:text-foreground underline underline-offset-4">
                    View all
                </button>
            </div>
            <div class="space-y-2">
                @foreach (var dept in _departments)
                {
                    <div class="flex items-center justify-between rounded-md border p-2 text-sm bg-muted/10">
                        <div class="flex items-center gap-2">
                            <div class="size-1.5 rounded-full @(dept.Status == "warning" ? "bg-amber-500" : "bg-emerald-500")"></div>
                            <span class="font-medium">@dept.Name</span>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="tabular-nums text-muted-foreground">@dept.Spend</span>
                            <LucideIconCn Name="external-link" Size="12" Class="size-3 text-muted-foreground/50" />
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Security and Compliance Footer *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-[11px]">
                    Compliance: SOC2 Type II • HIPAA Ready
                </span>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Audit Logs
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Entity Settings
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Stat(string Label, string Value, string Icon);
    private record Department(string Name, string Spend, string Status);

    private static readonly Stat[] _stats =
    [
        new("Active Seats", "1,240", "users"),
        new("Cost Centers", "12", "layout-dashboard"),
        new("Total MRR", "$45.2k", "file-text"),
    ];

    private static readonly Department[] _departments =
    [
        new("Engineering", "$12,450", "on-track"),
        new("Marketing", "$8,920", "warning"),
        new("Operations", "$4,100", "on-track"),
    ];
}
