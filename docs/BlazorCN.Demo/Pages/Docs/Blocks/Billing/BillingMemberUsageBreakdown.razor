@* ============================================================
   Block: billing-member-usage-breakdown
   Title: BillingMemberUsageBreakdown
   Description: A billing team member and individual resource usage block for React and Next.js with per-user cost tracking and seat management built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-member-usage-breakdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        <div class="border-b px-4 py-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Member Usage Breakdown</span>
            </div>
            <div class="relative">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-2.5 size-3.5 text-muted-foreground" />
                <InputCn aria-label="Filter members" Placeholder="Filter members..." Class="h-8 w-full sm:w-48 pl-8 text-xs" />
            </div>
        </div>

        <TableCn>
            <TableHeaderCn>
                <TableRowCn Class="hover:bg-transparent">
                    <TableHeadCn Class="text-[10px] uppercase tracking-wider">Member</TableHeadCn>
                    <TableHeadCn Class="text-right text-[10px] uppercase tracking-wider">Usage (GB)</TableHeadCn>
                    <TableHeadCn Class="text-right text-[10px] uppercase tracking-wider">Estimated Cost</TableHeadCn>
                    <TableHeadCn Class="w-10"><span class="sr-only">Actions</span></TableHeadCn>
                </TableRowCn>
            </TableHeaderCn>
            <TableBodyCn>
                @foreach (var member in _members)
                {
                    <TableRowCn Class="group transition-colors hover:bg-muted/50">
                        <TableCellCn Class="py-3">
                            <div class="flex flex-col">
                                <span class="text-sm font-medium">@member.Name</span>
                                <span class="text-[11px] text-muted-foreground">@member.Email</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn Class="text-right font-mono text-xs tabular-nums">
                            @member.Usage.ToString("N0")
                        </TableCellCn>
                        <TableCellCn Class="text-right">
                            <div class="flex items-baseline justify-end gap-1 font-semibold text-sm tabular-nums">
                                <span class="text-[10px] font-normal text-muted-foreground">$</span>
                                <span>@member.Cost.ToString("F2")</span>
                            </div>
                        </TableCellCn>
                        <TableCellCn>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                      Class="size-8 opacity-0 group-hover:opacity-100 transition-opacity" aria-label="More options">
                                <LucideIconCn Name="more-horizontal" Size="16" Class="size-4" />
                            </ButtonCn>
                        </TableCellCn>
                    </TableRowCn>
                }
            </TableBodyCn>
        </TableCn>

        <div class="bg-muted/30 px-4 py-3 border-t flex items-center justify-between">
            <div class="flex items-center gap-4">
                <div class="flex flex-col">
                    <span class="text-[10px] text-muted-foreground uppercase font-bold tracking-widest">
                        Total Active Seats
                    </span>
                    <span class="text-sm font-bold">5 / 20</span>
                </div>
                <div class="w-px h-6 bg-border"></div>
                <div class="flex flex-col">
                    <span class="text-[10px] text-muted-foreground uppercase font-bold tracking-widest">
                        Team Total Cost
                    </span>
                    <span class="text-sm font-bold">$172.50</span>
                </div>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 text-xs font-medium">
                Export CSV
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Member(string Id, string Name, string Email, int Usage, double Cost, string Role);

    private static readonly Member[] _members =
    [
        new("1", "Alex Chen", "alex@company.com", 840, 42.0, "Admin"),
        new("2", "Sarah Miller", "sarah@company.com", 320, 16.0, "Member"),
        new("3", "James Wilson", "james@company.com", 1240, 62.0, "Member"),
        new("4", "Emma Davis", "emma@company.com", 150, 7.5, "Member"),
        new("5", "Tom Harris", "tom@company.com", 900, 45.0, "Member"),
    ];
}
