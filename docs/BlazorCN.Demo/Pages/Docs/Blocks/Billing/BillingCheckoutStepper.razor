@* ============================================================
   Block: billing-checkout-stepper
   Title: BillingCheckoutStepper
   Description: A multi-step checkout progress indicator for React and Next.js with animated transitions, state tracking, and accessible labels built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-checkout-stepper.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card p-6">
        <div class="relative">
            @* Progress Bar Background *@
            <div class="absolute top-5 left-0 h-0.5 w-full bg-muted"></div>

            @* Active Progress Bar *@
            <div class="absolute top-5 left-0 h-0.5 bg-foreground transition-all duration-500 ease-in-out"
                 style="@($"width:{((_currentStep - 1.0) / (_steps.Length - 1)) * 100:F1}%")">
            </div>

            <div class="relative flex justify-between">
                @foreach (var step in _steps)
                {
                    var isCompleted = _currentStep > step.Id;
                    var isActive = _currentStep == step.Id;
                    var circleClass = "z-10 flex size-10 items-center justify-center rounded-full border-2 transition-colors " +
                        (isCompleted ? "border-foreground bg-foreground" :
                         isActive    ? "border-foreground bg-background" :
                                       "border-muted bg-background");
                    var iconClass = "size-5 " + (isActive ? "text-foreground" : "text-muted-foreground");
                    var labelClass = "text-[10px] font-medium uppercase tracking-wider " +
                        (isActive ? "text-foreground" : "text-muted-foreground");

                    <div class="flex flex-col items-center gap-2">
                        <div class="@circleClass">
                            @if (isCompleted)
                            {
                                <LucideIconCn Name="check" Size="20" Class="size-5 text-background" />
                            }
                            else
                            {
                                <LucideIconCn Name="@step.Icon" Size="20" Class="@iconClass" />
                            }
                        </div>
                        <span class="@labelClass">@step.Name</span>
                    </div>
                }
            </div>
        </div>

        <div class="mt-12 text-center">
            <h3 class="text-sm font-medium">
                Step @_currentStep: @(_steps.FirstOrDefault(s => s.Id == _currentStep)?.Name)
            </h3>
            <p class="mt-1 text-muted-foreground text-xs">
                Please provide your @(_steps.FirstOrDefault(s => s.Id == _currentStep)?.Name.ToLowerInvariant()) details
                to continue.
            </p>
        </div>

        <div class="mt-8 flex justify-between gap-4">
            <ButtonCn Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Sm"
                      Class="h-8"
                      Disabled="@(_currentStep == 1)"
                      OnClick="@(() => _currentStep--)">
                Back
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm"
                      Class="h-8"
                      Disabled="@(_currentStep == _steps.Length)"
                      OnClick="@(() => _currentStep++)">
                @(_currentStep == _steps.Length - 1 ? "Complete Review" : "Next Step")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private int _currentStep = 2;

    private record Step(int Id, string Name, string Icon);

    private static readonly Step[] _steps =
    [
        new(1, "Plan",    "shopping-bag"),
        new(2, "Billing", "map-pin"),
        new(3, "Payment", "credit-card"),
        new(4, "Review",  "rocket"),
    ];
}
