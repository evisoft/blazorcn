@* ============================================================
   Block: billing-stripe-connect-status
   Title: BillingStripeConnectStatus
   Description: A merchant onboarding and payout status block for Stripe Connect platforms featuring verification checklists, payout schedules, and account health monitoring built with shadcn/ui.
   Source: original/blocks/billing/billing-stripe-connect-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="landmark" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Payout Account</span>
                </div>
                <span class="inline-flex items-center rounded-full border px-2.5 py-0.5 text-[10px] uppercase font-bold tracking-tight @(_payoutsEnabled ? "bg-secondary text-secondary-foreground border-transparent" : "bg-amber-100 text-amber-800 border-amber-300 dark:bg-amber-900/30 dark:text-amber-400 dark:border-amber-700")">
                    @(_payoutsEnabled ? "Verified" : "Action Required")
                </span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                @(_payoutsEnabled
                    ? "Your account is fully verified. Payouts are scheduled for every Monday."
                    : "Complete your account verification to enable payouts to your bank account.")
            </p>
        </div>

        <div class="p-4 space-y-5">
            <div class="grid gap-3">
                <div class="flex items-center justify-between rounded-md border p-3 bg-muted/20">
                    <div class="flex items-center gap-3">
                        <div class="@($"size-2 rounded-full {(_chargesEnabled ? "bg-emerald-500" : "bg-zinc-300")}")"></div>
                        <span class="text-xs font-medium">Payments Processing</span>
                    </div>
                    <span class="text-[10px] text-muted-foreground font-medium uppercase tracking-wider">
                        Enabled
                    </span>
                </div>
                <div class="flex items-center justify-between rounded-md border p-3 bg-muted/20">
                    <div class="flex items-center gap-3">
                        <div class="@($"size-2 rounded-full {(_payoutsEnabled ? "bg-emerald-500" : "bg-amber-500")}")"></div>
                        <span class="text-xs font-medium">Payouts to Bank</span>
                    </div>
                    <span class="text-[10px] text-amber-500 font-medium uppercase tracking-wider">
                        Pending
                    </span>
                </div>
            </div>

            @if (!_payoutsEnabled)
            {
                <div class="rounded-lg border border-amber-200 bg-amber-50/50 p-4 dark:border-amber-900/50 dark:bg-amber-950/20">
                    <div class="flex gap-3">
                        <LucideIconCn Name="shield-alert" Size="16" Class="size-4 text-amber-600 dark:text-amber-500 shrink-0 mt-0.5" />
                        <div class="space-y-2">
                            <p class="text-xs font-medium text-amber-900 dark:text-amber-400">
                                Missing Information
                            </p>
                            <p class="text-xs text-amber-800/80 dark:text-amber-500/80 leading-relaxed">
                                Stripe requires your official business address and tax ID to enable payouts.
                                This process usually takes less than 2 minutes.
                            </p>
                            <button class="inline-flex items-center justify-center rounded-md h-8 px-3 text-xs font-medium bg-amber-600 hover:bg-amber-700 text-white transition-colors">
                                Complete Setup
                            </button>
                        </div>
                    </div>
                </div>
            }

            <div class="pt-2">
                <p class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest mb-3">
                    Available Balance
                </p>
                <div class="flex items-baseline justify-between">
                    <div class="flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tracking-tight">$</span>
                        <span class="text-2xl font-semibold tracking-tight">1,240.50</span>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs text-muted-foreground">
                        <LucideIconCn Name="layout-grid" Size="12" Class="size-3" />
                        Stripe Dashboard
                        <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="bg-muted/50 border-t px-4 py-2.5 flex items-center justify-center gap-4">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                <span class="text-[10px] text-muted-foreground font-medium uppercase tracking-wider">
                    Identity
                </span>
            </div>
            <div class="flex items-center gap-1.5 opacity-50">
                <div class="size-1.5 rounded-full bg-zinc-400"></div>
                <span class="text-[10px] text-muted-foreground font-medium uppercase tracking-wider">
                    Business
                </span>
            </div>
            <div class="flex items-center gap-1.5 opacity-50">
                <div class="size-1.5 rounded-full bg-zinc-400"></div>
                <span class="text-[10px] text-muted-foreground font-medium uppercase tracking-wider">
                    Bank
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private const bool _payoutsEnabled = false;
    private const bool _chargesEnabled = true;
}
