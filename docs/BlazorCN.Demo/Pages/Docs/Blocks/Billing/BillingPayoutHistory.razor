@* ============================================================
   Block: billing-payout-history
   Title: BillingPayoutHistory
   Description: A professional payout history list for platform sellers and affiliates in React and Next.js, featuring status tracking and export options built with shadcn/ui.
   Source: original/blocks/billing/billing-payout-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="banknote" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Payout History</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-[10px] text-muted-foreground uppercase font-semibold">
                        Total Earned:
                    </span>
                    <span class="text-sm font-semibold tabular-nums text-emerald-600">
                        $4,562.90
                    </span>
                </div>
            </div>
        </div>

        @* List *@
        <div class="divide-y">
            @foreach (var payout in _payouts)
            {
                <div class="flex items-center justify-between px-4 py-4 transition-colors hover:bg-muted/50">
                    <div class="flex items-center gap-4">
                        <div class="flex size-9 items-center justify-center rounded-full bg-muted/50">
                            <LucideIconCn Name="landmark" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="space-y-0.5">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm leading-none">@payout.Bank</span>
                                <span class="@($"size-1.5 rounded-full {StatusColor(payout.Status)}")"></span>
                                <span class="text-[10px] text-muted-foreground uppercase font-medium">
                                    @StatusLabel(payout.Status)
                                </span>
                            </div>
                            <p class="text-muted-foreground text-xs">
                                @payout.Date • @payout.Id
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center gap-4">
                        <span class="font-semibold text-sm tabular-nums">
                            $@payout.Amount.ToString("F2")
                        </span>
                        <LucideIconCn Name="arrow-up-right" Size="14" Class="size-3.5 text-muted-foreground/50" />
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 bg-muted/30 flex items-center justify-between">
            <p class="text-muted-foreground text-xs leading-relaxed">
                Payouts take 3-5 business days to settle in your account.
            </p>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-xs">
                <LucideIconCn Name="download" Size="12" Class="size-3" />
                Export CSV
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Payout(string Id, string Date, double Amount, string Status, string Bank);

    private static readonly Payout[] _payouts =
    [
        new("PO-99123", "May 28, 2026", 1240.5,  "paid",       "Chase •••• 1234"),
        new("PO-99122", "May 14, 2026", 842.0,   "paid",       "Chase •••• 1234"),
        new("PO-99121", "Apr 28, 2026", 1560.0,  "in_transit", "Chase •••• 1234"),
        new("PO-99120", "Apr 14, 2026", 920.4,   "paid",       "Chase •••• 1234"),
    ];

    private static string StatusLabel(string status) => status switch
    {
        "paid"       => "Paid",
        "pending"    => "Pending",
        "in_transit" => "In Transit",
        "failed"     => "Failed",
        _            => status,
    };

    private static string StatusColor(string status) => status switch
    {
        "paid"       => "bg-emerald-500",
        "pending"    => "bg-amber-500",
        "in_transit" => "bg-blue-500",
        "failed"     => "bg-red-500",
        _            => "",
    };
}
