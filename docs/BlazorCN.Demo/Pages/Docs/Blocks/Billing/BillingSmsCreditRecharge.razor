@* ============================================================
   Block: billing-sms-credit-recharge
   Title: BillingSmsCreditRecharge
   Description: A specialized billing block for React and Next.js to manage communication credits with auto-recharge and manual top-up built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-sms-credit-recharge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="p-6">
            <div class="flex items-center justify-between mb-8">
                <div class="flex items-center gap-3">
                    <div class="flex size-10 items-center justify-center rounded-xl bg-blue-500/10 text-blue-600 dark:text-blue-400">
                        <LucideIconCn Name="message-square" Size="20" Class="size-5" />
                    </div>
                    <div>
                        <h3 class="font-medium text-sm">SMS Message Credits</h3>
                        <p class="text-muted-foreground text-xs">
                            Used for marketing and notifications
                        </p>
                    </div>
                </div>
                <div class="text-right">
                    <div class="text-2xl font-bold tracking-tight tabular-nums">
                        @_currentBalance
                    </div>
                    <span class="text-[10px] font-bold uppercase tracking-widest text-muted-foreground">
                        Credits Remaining
                    </span>
                </div>
            </div>

            <div class="space-y-8">
                @* Auto Recharge Toggle *@
                <div class="flex items-center justify-between rounded-lg border bg-muted/30 p-4">
                    <div class="space-y-1">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="refresh-cw" Size="14" Class="@Cn.Merge("size-3.5", _isAutoEnabled ? "animate-spin-slow" : "")" />
                            <span class="text-sm font-semibold">Auto-Recharge</span>
                        </div>
                        <p class="text-xs text-muted-foreground">
                            Automatically buy credits when balance falls below 500
                        </p>
                    </div>
                    <SwitchCn @bind-Checked="_isAutoEnabled" />
                </div>

                @* Manual Top-up Slider *@
                <div class="space-y-4">
                    <div class="flex items-center justify-between text-xs font-medium uppercase tracking-wider text-muted-foreground">
                        <span>Quick Top-up</span>
                        <span class="text-foreground">
                            $@((_rechargeAmount * 0.01).ToString("F2")) USD
                        </span>
                    </div>
                    <SliderCn Value="@_rechargeAmount" ValueChanged="@((double v) => _rechargeAmount = v)" Max="10000" Min="500" Step="500" Class="py-2" />
                    <div class="flex items-baseline justify-center gap-2">
                        <span class="text-3xl font-bold tracking-tight tabular-nums">
                            @((int)_rechargeAmount)
                        </span>
                        <span class="text-muted-foreground text-sm">Credits</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-between border-t bg-muted/20 px-4 py-3">
            <div class="flex items-center gap-1.5 text-[10px] text-muted-foreground">
                <LucideIconCn Name="zap" Size="12" Class="size-3 text-amber-500" />
                <span>Credits never expire and are added instantly to your account.</span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-4 font-semibold">
                Buy Credits
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _isAutoEnabled = true;
    private double _rechargeAmount = 2500;
    private int _currentBalance = 1240;
}
