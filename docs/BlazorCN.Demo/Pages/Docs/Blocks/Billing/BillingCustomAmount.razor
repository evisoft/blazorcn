@* ============================================================
   Block: billing-custom-amount
   Title: BillingCustomAmount
   Description: A flexible manual payment entry block for React and Next.js with real-time validation, price-per-unit calculations, and animated totals built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-custom-amount.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="font-medium text-sm">Custom Top-up Amount</h3>
            <p class="mt-1 text-muted-foreground text-sm">
                Enter a specific amount to add to your balance. Minimum top-up is $5.00.
            </p>
        </div>

        <div class="p-4 space-y-6">
            <div class="space-y-3">
                <LabelCn For="custom-amount-custom-amount" Class="text-xs text-muted-foreground uppercase tracking-wider">
                    Amount to Add
                </LabelCn>
                <div class="relative">
                    <InputCn id="custom-amount-custom-amount" Type="number" Class="h-12 pl-10 text-lg font-semibold tabular-nums" Placeholder="0.00" @bind-Value="_amountStr" />
                    <div class="absolute left-3.5 top-1/2 -translate-y-1/2">
                        <LucideIconCn Name="dollar-sign" Size="20" Class="size-5 text-muted-foreground/50" />
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-4 gap-2">
                @foreach (var p in _presets)
                {
                    <ButtonCn Variant="@(_Amount == p ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-9" @onclick="@(() => SetAmount(p))">
                        $@p
                    </ButtonCn>
                }
            </div>

            <div class="rounded-md border bg-muted/10 p-4 text-center">
                <span class="text-muted-foreground text-xs uppercase tracking-wider">
                    You will receive
                </span>
                <div class="mt-1 flex items-baseline justify-center gap-1.5">
                    <span class="text-3xl font-bold tracking-tight tabular-nums">
                        @(_Amount * 100)
                    </span>
                    <span class="text-sm font-medium text-muted-foreground">credits</span>
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-3 border-t bg-muted/30 px-4 py-3 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-[10px] text-muted-foreground leading-normal">
                Credits are added instantly after successful payment confirmation.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-2">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Add Funds
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _presets = [10, 25, 50, 100];
    private string _amountStr = "25";

    private int _Amount => int.TryParse(_amountStr, out var v) ? v : 0;

    private void SetAmount(int p)
    {
        _amountStr = p.ToString();
    }
}
