@* ============================================================
   Block: billing-team-seats
   Title: BillingTeamSeats
   Description: A team seat management block for React and Next.js with member list, role indicators, animated seat counter, and total cost calculation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-team-seats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Team Seats</span>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-7" @onclick="@(() => DecrementSeats())">
                        <LucideIconCn Name="minus" Size="12" Class="size-3" />
                    </ButtonCn>
                    <span class="w-6 text-center font-semibold text-sm tabular-nums">@_seats</span>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="size-7" @onclick="@(() => IncrementSeats())">
                        <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Pricing Summary *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="flex items-baseline justify-between">
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-xl tabular-nums">$@(_seats * _pricePerSeat)</span>
                    <span class="text-muted-foreground text-xs">/mo total</span>
                </div>
                <span class="text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                    $@(_pricePerSeat) per seat
                </span>
            </div>
        </div>

        @* Member List *@
        <div class="divide-y">
            @foreach (var member in _members)
            {
                <div class="flex items-center justify-between px-4 py-3">
                    <div class="flex items-center gap-3">
                        <AvatarCn Class="size-8 border">
                            <AvatarImageCn Src="@member.Avatar" />
                            <AvatarFallbackCn Class="text-[10px]">
                                @(member.Name.Length >= 2 ? member.Name.Substring(0, 2).ToUpper() : member.Name.ToUpper())
                            </AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0">
                            <p class="font-medium text-sm leading-none">@member.Name</p>
                            <p class="mt-1 truncate text-muted-foreground text-xs">@member.Email</p>
                        </div>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-[10px] capitalize", member.Role == "pending" ? "bg-amber-500/10 text-amber-600 dark:text-amber-400" : "")">
                        @member.Role
                    </BadgeCn>
                </div>
            }
        </div>

        @* Footer Action *@
        <div class="px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 w-full gap-1.5 text-xs">
                <LucideIconCn Name="user-plus" Size="14" Class="size-3.5" />
                Invite Collaborator
            </ButtonCn>
            <p class="mt-2 text-center text-muted-foreground text-[10px]">
                You have @(_seats - _members.Length) unused seats available in your current plan.
            </p>
        </div>
    </div>
</section>

@code {
    private record Member(string Id, string Name, string Email, string Role, string Avatar = "");

    private static readonly Member[] _members =
    [
        new("1", "Alex Rivera", "alex@@acme.com", "admin"),
        new("2", "Sarah Chen", "sarah@@acme.com", "member"),
        new("3", "Jordan Smith", "jordan@@acme.com", "pending"),
    ];

    private const int _pricePerSeat = 12;
    private int _seats = 5;

    private void DecrementSeats()
    {
        if (_seats > 1) _seats--;
    }

    private void IncrementSeats()
    {
        if (_seats < 100) _seats++;
    }
}
