@* ============================================================
   Block: billing-lifetime-deal
   Title: BillingLifetimeDeal
   Description: A billing lifetime deal (LTD) and one-time purchase block for React and Next.js with exclusive tier highlights and stackable codes built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-lifetime-deal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-xl border bg-card shadow-lg">
        <div class="bg-primary px-6 py-8 text-primary-foreground text-center relative overflow-hidden">
            <div class="absolute -top-12 -left-12 size-40 bg-white/10 rounded-full blur-3xl"></div>
            <LucideIconCn Name="crown" Size="32" Class="mx-auto size-8 mb-4 opacity-90" />
            <h2 class="font-bold text-2xl tracking-tight uppercase italic">
                Founders Lifetime Access
            </h2>
            <p class="mt-2 text-primary-foreground/80 text-sm font-medium">
                One payment. No subscriptions. Future updates included forever.
            </p>
        </div>

        <div class="p-6">
            <div class="flex flex-wrap gap-2 justify-center mb-8">
                @foreach (var tier in _tiers)
                {
                    <ButtonCn Variant="@(_activeTier.Id == tier.Id ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              OnClick="@(() => _activeTier = tier)"
                              Class="h-8 text-xs rounded-full px-4">
                        @tier.Label
                    </ButtonCn>
                }
            </div>

            <div class="flex flex-col items-center justify-center gap-2 mb-8">
                <div class="flex items-baseline gap-1 text-5xl font-extrabold tracking-tight">
                    <span class="text-2xl font-bold">$</span>
                    <span>@_activeTier.Price</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary"
                         Class="bg-emerald-500/10 text-emerald-600 border-emerald-500/20 gap-1.5 uppercase text-[10px] tracking-widest font-bold">
                    <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                    Save 92% Lifetime
                </BadgeCn>
            </div>

            <ul class="space-y-4 max-w-xs mx-auto mb-8">
                <li class="flex items-center gap-3 text-sm font-medium">
                    <div class="flex size-5 items-center justify-center rounded-full bg-primary/10 text-primary">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                    </div>
                    <span>
                        @if (_activeTier.Seats == "Unlimited")
                        {
                            <LucideIconCn Name="infinity" Size="16" Class="size-4 inline mr-1" />
                        }
                        else
                        {
                            @(_activeTier.Seats + " ")
                        }
                        Team Members
                    </span>
                </li>
                <li class="flex items-center gap-3 text-sm font-medium">
                    <div class="flex size-5 items-center justify-center rounded-full bg-primary/10 text-primary">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                    </div>
                    <span>@_activeTier.Storage Cloud Storage</span>
                </li>
                <li class="flex items-center gap-3 text-sm font-medium">
                    <div class="flex size-5 items-center justify-center rounded-full bg-primary/10 text-primary">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                    </div>
                    <span>Lifetime Updates &amp; Support</span>
                </li>
            </ul>

            <ButtonCn Size="ButtonSize.Lg"
                      Class="w-full h-12 text-sm font-bold shadow-sm uppercase tracking-wider">
                Claim Lifetime Access
            </ButtonCn>
        </div>

        <div class="border-t bg-muted/30 px-6 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2 text-muted-foreground text-[10px] font-medium uppercase">
                <LucideIconCn Name="zap" Size="12" Class="size-3 text-amber-500" />
                <span>84 Licenses Remaining</span>
            </div>
            <p class="text-muted-foreground text-[10px]">60-day money back guarantee.</p>
        </div>
    </div>
</section>

@code {
    private record Tier(string Id, string Label, int Price, string Seats, string Storage);

    private static readonly Tier[] _tiers = [
        new("tier1", "License Tier 1", 49, "3", "10GB"),
        new("tier2", "License Tier 2", 99, "10", "50GB"),
        new("tier3", "License Tier 3", 199, "Unlimited", "500GB"),
    ];

    private Tier _activeTier = _tiers[1];
}
