@* ============================================================
   Block: billing-w9-verification-status
   Title: BillingW9VerificationStatus
   Description: A W-9 verification status tracker for React and Next.js showing validation progress, identity confirmation, and tax compliance level built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-w9-verification-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Compliance Status</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs bg-amber-500/10 text-amber-600 border-amber-200/50">
                Action Required
            </BadgeCn>
        </div>

        @* Status Overview *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-4">
                <div class="flex size-12 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="clock" Size="24" Class="size-6 text-muted-foreground" />
                </div>
                <div>
                    <h3 class="font-medium text-sm text-foreground">W-9 Verification in Progress</h3>
                    <p class="text-muted-foreground text-xs">
                        We are currently validating your taxpayer information with the IRS. This process
                        usually takes 1-3 business days.
                    </p>
                </div>
            </div>
        </div>

        @* Timeline *@
        <div class="border-b px-4 py-5">
            <div class="space-y-4">
                @for (int i = 0; i < _steps.Length; i++)
                {
                    var step = _steps[i];
                    var isLast = i == _steps.Length - 1;
                    <div class="flex items-start gap-3">
                        <div class="relative flex h-5 w-5 items-center justify-center">
                            @if (step.Status == "complete")
                            {
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                            }
                            else if (step.Status == "current")
                            {
                                <div class="size-2 rounded-full bg-amber-500"></div>
                            }
                            else
                            {
                                <div class="size-2 rounded-full bg-muted-foreground/30"></div>
                            }
                            @if (!isLast)
                            {
                                <div class="absolute top-5 bottom-[-16px] w-px bg-muted"></div>
                            }
                        </div>
                        <div class="flex flex-1 items-center justify-between">
                            <span class="@(step.Status == "upcoming" ? "text-xs text-muted-foreground" : "text-xs font-medium text-foreground")">
                                @step.Name
                            </span>
                            <span class="text-[10px] text-muted-foreground uppercase tracking-wider">
                                @step.Date
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs underline underline-offset-4 cursor-help">
                    Why is this taking long?
                </span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                View Submitted Form
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Step(string Name, string Status, string Date);

    private static readonly Step[] _steps =
    [
        new("Form Submitted",   "complete", "May 12, 2024"),
        new("Identity Verified","complete", "May 13, 2024"),
        new("IRS Matching",     "current",  "In progress"),
        new("Final Approval",   "upcoming", "--"),
    ];
}
