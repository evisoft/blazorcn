@* ============================================================
   Block: billing-payment-link-generator
   Title: BillingPaymentLinkGenerator
   Description: A merchant-facing utility for React and Next.js that allows quick generation of shareable payment links for custom amounts or specific products built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-payment-link-generator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="link" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Payment Link Generator</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">
                Admin Only
            </BadgeCn>
        </div>

        @* Configuration *@
        <div class="divide-y">
            <div class="px-4 py-4">
                <label for="payment-link-amount" class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider">Amount</label>
                <div class="mt-1 flex items-center gap-2">
                    <div class="relative flex-1">
                        <LucideIconCn Name="dollar-sign" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                        <input id="payment-link-amount"
                            type="text"
                            value="@_amount"
                            @oninput="@((e) => _amount = e.Value?.ToString() ?? "")"
                            class="w-full rounded-md border bg-muted/20 pl-8 pr-3 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-foreground/20" />
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-8 px-3 font-normal">USD</BadgeCn>
                </div>
            </div>

            <div class="px-4 py-4">
                <label for="payment-link-description" class="text-[10px] font-semibold text-muted-foreground uppercase tracking-wider">Description</label>
                <input id="payment-link-description"
                    type="text"
                    placeholder="Enterprise License Renewal - Q3 2024"
                    value="@_description"
                    @oninput="@((e) => _description = e.Value?.ToString() ?? "")"
                    class="mt-1 w-full rounded-md border bg-muted/20 px-3 py-1.5 text-sm focus:outline-none focus:ring-1 focus:ring-foreground/20" />
            </div>
        </div>

        @* Generated Link Area *@
        <div class="bg-muted/30 px-4 py-6 text-center">
            <p class="mb-3 text-xs text-muted-foreground">
                Your secure payment link is ready to share with the customer.
            </p>
            <div class="flex items-center gap-2 rounded-md border bg-background p-1.5 shadow-sm">
                <code class="flex-1 px-2 text-left text-xs text-foreground truncate">
                    @_generatedLink
                </code>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 w-7 p-0" aria-label="Copy payment link" OnClick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="14" Class="size-3.5 text-muted-foreground" />
                    }
                </ButtonCn>
            </div>
        </div>

        @* Footer Settings *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5 text-muted-foreground text-[11px]">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                    Expires in 7 days
                </div>
                <div class="flex items-center gap-1.5 text-muted-foreground text-[11px]">
                    <LucideIconCn Name="more-horizontal" Size="12" Class="size-3" />
                    Advanced
                </div>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                Create New Link
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private string _generatedLink = "https://pay.acme.com/checkout/cl_123456789";
    private string _amount = "499.00";
    private string _description = "";
    private bool _copied = false;

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
