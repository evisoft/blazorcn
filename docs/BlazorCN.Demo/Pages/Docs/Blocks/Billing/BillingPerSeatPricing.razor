@* ============================================================
   Block: billing-per-seat-pricing
   Title: BillingPerSeatPricing
   Description: An interactive pricing calculator for seat-based SaaS plans in React and Next.js, featuring real-time cost updates built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-per-seat-pricing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Team Size Pricing</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Adjust the slider to see how your cost scales with your team. Save 20% on annual
                billing.
            </p>
        </div>

        @* Seat Selector *@
        <div class="p-8 space-y-8">
            <div class="flex flex-col items-center gap-6">
                <div class="flex items-center gap-6">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                              Class="size-10 rounded-full"
                              OnClick="@(() => _seats = Math.Max(1, _seats - 1))" aria-label="Remove">
                        <LucideIconCn Name="minus" Size="16" Class="size-4" />
                    </ButtonCn>
                    <div class="text-center min-w-24">
                        <span class="text-5xl font-bold tracking-tighter tabular-nums">
                            @_seats
                        </span>
                        <p class="text-muted-foreground text-sm font-medium uppercase tracking-widest mt-1">
                            Seats
                        </p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                              Class="size-10 rounded-full"
                              OnClick="@(() => _seats = _seats + 1)" aria-label="Add">
                        <LucideIconCn Name="plus" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>

                <input aria-label="Number of seats" type="range" min="1" max="100"
                       value="@_seats"
                       @oninput="OnSeatsInput"
                       class="w-full h-1.5 bg-muted rounded-lg appearance-none cursor-pointer accent-foreground" />
            </div>

            @* Pricing Breakdown *@
            <div class="grid grid-cols-2 gap-4">
                <div class="rounded-lg border bg-muted/30 p-4 text-center">
                    <p class="text-muted-foreground text-xs font-semibold uppercase tracking-wider">
                        Monthly
                    </p>
                    <div class="mt-2 flex items-baseline justify-center gap-1">
                        <span class="text-2xl font-bold tabular-nums">
                            $@MonthlyTotal
                        </span>
                        <span class="text-muted-foreground text-xs">/mo</span>
                    </div>
                </div>
                <div class="relative rounded-lg border border-emerald-200 bg-emerald-50/20 p-4 text-center dark:border-emerald-900/50">
                    <div class="absolute -top-2.5 left-1/2 -translate-x-1/2 rounded-full bg-emerald-500 px-2 py-0.5 text-[9px] font-bold uppercase text-white tracking-widest">
                        Save 20%
                    </div>
                    <p class="text-muted-foreground text-xs font-semibold uppercase tracking-wider">
                        Annual
                    </p>
                    <div class="mt-2 flex items-baseline justify-center gap-1">
                        <span class="text-2xl font-bold tabular-nums text-emerald-600">
                            $@AnnualTotal
                        </span>
                        <span class="text-muted-foreground text-xs">/yr</span>
                    </div>
                </div>
            </div>
        </div>

        @* Action *@
        <div class="border-t px-4 py-4 bg-card">
            <ButtonCn Class="w-full h-10">Update Team Plan</ButtonCn>
            <p class="mt-3 text-center text-[10px] text-muted-foreground">
                Price per seat: $@(_pricePerSeat)/mo. Minimum 1 seat required.
            </p>
        </div>
    </div>
</section>

@code {
    private int _seats = 12;
    private const int _pricePerSeat = 15;

    private int MonthlyTotal => _seats * _pricePerSeat;
    private int AnnualTotal => (int)(MonthlyTotal * 12 * 0.8);

    private void OnSeatsInput(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var v))
            _seats = v;
    }
}
