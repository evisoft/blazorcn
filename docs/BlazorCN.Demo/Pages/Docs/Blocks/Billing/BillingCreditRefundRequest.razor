@* ============================================================
   Block: billing-credit-refund-request
   Title: BillingCreditRefundRequest
   Description: A user-friendly financial adjustment component for React and Next.js that allows customers to request refunds for unused credits or overcharged transactions built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-credit-refund-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="undo-2" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Refund Request</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-[10px] uppercase tracking-wider bg-background">
                Secure Request
            </BadgeCn>
        </div>

        @* Transaction Selector *@
        <div class="px-4 py-5 border-b">
            <label class="text-[10px] font-semibold text-muted-foreground uppercase tracking-widest">Selected Transaction</label>
            <div class="mt-2 flex items-center justify-between rounded-md border bg-muted/10 p-3">
                <div class="flex flex-col gap-0.5">
                    <span class="text-xs font-semibold">Invoice #2024-0512</span>
                    <span class="text-[10px] text-muted-foreground">Paid on May 12, 2024</span>
                </div>
                <div class="text-right">
                    <div class="flex items-baseline gap-0.5">
                        <span class="text-sm font-bold">$</span>
                        <span class="text-sm font-bold">@_transactionAmount.ToString("F2")</span>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-1.5 text-[9px] text-muted-foreground">
                        Change
                        <LucideIconCn Name="chevron-down" Size="12" Class="ml-1 size-3" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Refund Method *@
        <div class="grid grid-cols-2 divide-x border-b">
            <button type="button" class="flex flex-col gap-1 px-4 py-5 text-left transition-colors hover:bg-muted/30">
                <div class="flex items-center justify-between">
                    <div class="rounded-md border p-1 bg-background">
                        <LucideIconCn Name="wallet" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div class="size-3 rounded-full border-2 border-foreground bg-foreground flex items-center justify-center">
                        <div class="size-1 rounded-full bg-background"></div>
                    </div>
                </div>
                <span class="mt-2 text-xs font-semibold">Credit Balance</span>
                <p class="text-[10px] text-muted-foreground leading-tight">Instant refund to account credits.</p>
            </button>
            <button type="button" class="flex flex-col gap-1 px-4 py-5 text-left transition-colors hover:bg-muted/30">
                <div class="flex items-center justify-between">
                    <div class="rounded-md border p-1 bg-background">
                        <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div class="size-3 rounded-full border"></div>
                </div>
                <span class="mt-2 text-xs font-semibold">Original Method</span>
                <p class="text-[10px] text-muted-foreground leading-tight">Back to Visa ending in 4242 (5-10 days).</p>
            </button>
        </div>

        @* Reason *@
        <div class="px-4 py-5 border-b">
            <label class="text-[10px] font-semibold text-muted-foreground uppercase tracking-widest">Reason for refund</label>
            <textarea placeholder="Tell us why you are requesting a refund..."
                      class="mt-2 w-full min-h-[80px] rounded-md border bg-muted/20 p-3 text-xs focus:outline-none focus:ring-1 focus:ring-foreground/20 resize-none"></textarea>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3 bg-muted/10">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="help-circle" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-[10px] underline underline-offset-4 cursor-help">
                    Refund Policy
                </span>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Cancel
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="send" Size="14" Class="size-3.5" />
                    Submit Request
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private decimal _transactionAmount = 149.00m;
}
