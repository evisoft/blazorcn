@* ============================================================
   Block: billing-subscription-pause
   Title: BillingSubscriptionPause
   Description: A retention-focused subscription management block for SaaS platforms featuring flexible pause durations, benefit preservation summaries, and one-click reactivation built with shadcn/ui.
   Source: original/blocks/billing/billing-subscription-pause.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="pause-circle" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Subscription Management</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Taking a break? Pause your subscription to stop billing while keeping all your data
                and settings safe.
            </p>
        </div>

        <div class="p-4 space-y-6">
            @if (!_isPaused)
            {
                <div class="space-y-4">
                    <div class="space-y-2">
                        <label for="pause-duration" class="text-xs font-medium uppercase text-muted-foreground tracking-tight">
                            Pause Duration
                        </label>
                        <SelectCn @bind-Value="_duration">
                            <SelectTriggerCn Id="pause-duration" Class="h-9">
                                <SelectValueCn Placeholder="Select duration" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                <SelectItemCn Value="1">1 Month (Resumes May 24)</SelectItemCn>
                                <SelectItemCn Value="2">2 Months (Resumes Jun 24)</SelectItemCn>
                                <SelectItemCn Value="3">3 Months (Resumes Jul 24)</SelectItemCn>
                            </SelectContentCn>
                        </SelectCn>
                    </div>

                    <div class="rounded-md border bg-muted/30 p-3">
                        <p class="text-xs font-medium mb-2">What to expect:</p>
                        <ul class="space-y-2">
                            <li class="flex items-center gap-2 text-[11px] text-muted-foreground">
                                <div class="size-1 rounded-full bg-emerald-500"></div>
                                All your projects and data are preserved
                            </li>
                            <li class="flex items-center gap-2 text-[11px] text-muted-foreground">
                                <div class="size-1 rounded-full bg-emerald-500"></div>
                                Billing stops immediately after current cycle
                            </li>
                            <li class="flex items-center gap-2 text-[11px] text-muted-foreground">
                                <div class="size-1 rounded-full bg-amber-500"></div>
                                Access to Pro features will be limited
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="flex items-center justify-between pt-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs text-red-500 hover:text-red-600 hover:bg-red-50/50">
                        Cancel Subscription
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-4 text-xs" OnClick="@(() => _isPaused = true)">
                        Pause Subscription
                    </ButtonCn>
                </div>
            }
            else
            {
                <div class="py-4 text-center space-y-4">
                    <div class="mx-auto size-10 rounded-full bg-amber-100 dark:bg-amber-900/30 flex items-center justify-center">
                        <LucideIconCn Name="coffee" Size="20" Class="size-5 text-amber-600" />
                    </div>
                    <div class="space-y-1">
                        <h4 class="text-sm font-medium">Subscription is Paused</h4>
                        <p class="text-xs text-muted-foreground">
                            Your billing is suspended until
                            <span class="font-medium text-foreground">May 24, 2026</span>.
                        </p>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 gap-2 text-xs" OnClick="@(() => _isPaused = false)">
                        <LucideIconCn Name="play-circle" Size="14" Class="size-3.5" />
                        Resume Subscription Now
                    </ButtonCn>
                </div>
            }
        </div>

        <div class="bg-muted/50 border-t px-4 py-2 text-center">
            <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-medium flex items-center justify-center gap-2">
                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                Next cycle starts on April 24, 2026
            </p>
        </div>
    </div>
</section>

@code {
    private string _duration = "1";
    private bool _isPaused = false;
}
