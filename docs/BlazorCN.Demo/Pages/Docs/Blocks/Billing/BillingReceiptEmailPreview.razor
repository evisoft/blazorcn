@* ============================================================
   Block: billing-receipt-email-preview
   Title: BillingReceiptEmailPreview
   Description: A billing receipt preview block for React and Next.js that mimics an automated email layout with transaction details built with shadcn/ui and Framer Motion.
   Source: original/blocks/billing/billing-receipt-email-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        @* Email Header Placeholder *@
        <div class="bg-muted/30 px-4 py-2 text-[10px] font-medium text-muted-foreground uppercase tracking-widest border-b">
            Receipt Email Preview
        </div>

        <div class="p-8">
            @* Brand Logo *@
            <div class="flex flex-col items-center justify-center text-center space-y-2 mb-8">
                <div class="size-12 rounded-xl bg-foreground flex items-center justify-center text-background">
                    <LucideIconCn Name="receipt" Size="24" Class="size-6" />
                </div>
                <h2 class="text-sm font-semibold tracking-tight">Your SaaS Company</h2>
            </div>

            <div class="space-y-6">
                <div class="text-center">
                    <h3 class="text-xl font-semibold tracking-tight">Receipt for @_date</h3>
                    <p class="text-muted-foreground text-sm mt-1">Transaction ID: @_transactionId</p>
                </div>

                @* Line Items *@
                <div class="space-y-3 py-6 border-y border-dashed">
                    @foreach (var item in _items)
                    {
                        <div class="flex justify-between text-sm">
                            <span class="text-muted-foreground">@item.Name</span>
                            <span class="font-medium tabular-nums">$@item.Price.ToString("F2")</span>
                        </div>
                    }
                </div>

                @* Breakdown *@
                <div class="space-y-2">
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Subtotal</span>
                        <span class="tabular-nums">$@_subtotal.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-muted-foreground">Tax (8%)</span>
                        <span class="tabular-nums">$@_tax.ToString("F2")</span>
                    </div>
                    <div class="flex justify-between text-base font-semibold pt-2 border-t">
                        <span>Total Paid</span>
                        <span class="tabular-nums">$@_total.ToString("F2")</span>
                    </div>
                </div>

                <div class="bg-emerald-500/5 rounded-lg p-4 flex items-center gap-3">
                    <LucideIconCn Name="circle-check" Size="20" Class="size-5 text-emerald-500 shrink-0" />
                    <p class="text-xs text-emerald-800 dark:text-emerald-400">
                        This payment was successfully processed on your card ending in **4242.
                    </p>
                </div>
            </div>
        </div>

        @* Action Bar *@
        <div class="bg-muted/30 px-4 py-3 border-t flex items-center justify-between">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs font-medium">
                <LucideIconCn Name="mail" Size="14" Class="size-3.5" />
                Sent to billing@@company.com
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-2">
                    <LucideIconCn Name="share" Size="14" Class="size-3.5" />
                    Forward
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8">
                    Send Test
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private readonly string _transactionId = "TRX-9821-XJ";
    private readonly string _date = "May 24, 2026";
    private readonly LineItem[] _items =
    [
        new("Pro Plan (Monthly)", 49.0m),
        new("Additional Seats (x2)", 20.0m),
    ];
    private readonly decimal _subtotal = 69.0m;
    private readonly decimal _tax = 5.52m;
    private readonly decimal _total = 74.52m;

    private record LineItem(string Name, decimal Price);
}
