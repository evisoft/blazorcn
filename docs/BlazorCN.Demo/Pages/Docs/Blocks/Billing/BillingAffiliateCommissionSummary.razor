@* ============================================================
   Block: billing-affiliate-commission-summary
   Title: BillingAffiliateCommissionSummary
   Description: A dashboard block for affiliate partners to track their commissions, pending payouts, and referral performance metrics.
   Source: original/blocks/billing/billing-affiliate-commission-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="arrow-up-right" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Affiliate Overview</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-bold text-[10px] uppercase tracking-tight">
                    Pro Partner
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your referral performance and upcoming commission payouts.
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x border-b">
            @foreach (var stat in _stats)
            {
                <div class="p-5 space-y-2">
                    <div class="flex items-center gap-2 text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        <LucideIconCn Name="@stat.Icon" Size="16" Class="@("size-4 " + stat.Color)" />
                        @stat.Label
                    </div>
                    <div class="text-2xl font-semibold tracking-tight tabular-nums">
                        @(stat.Label != "Referrals" ? "$" : "")@stat.Value
                    </div>
                </div>
            }
        </div>

        <div class="p-4 bg-muted/20">
            <div class="flex items-center justify-between p-3 rounded-lg border bg-background">
                <div class="space-y-1">
                    <p class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        Next Payout
                    </p>
                    <p class="text-sm font-medium">June 15, 2026</p>
                </div>
                <div class="text-right space-y-1">
                    <p class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        Method
                    </p>
                    <p class="text-sm font-medium">PayPal (•••@@gmail.com)</p>
                </div>
            </div>
        </div>

        <div class="bg-muted/50 border-t px-4 py-2.5">
            <div class="flex items-center justify-center gap-6 text-[11px] text-muted-foreground font-medium">
                <span class="hover:text-primary cursor-pointer transition-colors">
                    View All Referrals
                </span>
                <span class="text-muted-foreground/30">•</span>
                <span class="hover:text-primary cursor-pointer transition-colors">
                    Payout History
                </span>
                <span class="text-muted-foreground/30">•</span>
                <span class="hover:text-primary cursor-pointer transition-colors">
                    Tax Forms (W-9)
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string Icon, string Color, string Value);

    private static readonly StatItem[] _stats =
    [
        new("Total Earned", "banknote", "text-emerald-500", "2,840.50"),
        new("Pending", "calendar", "text-amber-500", "450.00"),
        new("Referrals", "users", "text-blue-500", "124"),
    ];
}
