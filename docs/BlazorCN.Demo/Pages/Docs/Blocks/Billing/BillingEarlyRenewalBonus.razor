@* ============================================================
   Block: billing-early-renewal-bonus
   Title: BillingEarlyRenewalBonus
   Description: An incentive-driven billing component for React and Next.js that encourages users to renew their subscriptions ahead of schedule in exchange for exclusive bonuses built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-early-renewal-bonus.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="award" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Early Renewal Offer</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs bg-indigo-500/10 text-indigo-600 border-indigo-200/50">
                Exclusive Bonus
            </BadgeCn>
        </div>

        @* Offer Details *@
        <div class="px-4 py-6 border-b">
            <div class="flex flex-col items-center text-center max-w-md mx-auto">
                <div class="mb-4 flex size-14 items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-200">
                    <LucideIconCn Name="zap" Size="28" Class="size-7" />
                </div>
                <h3 class="text-lg font-semibold tracking-tight">Secure your price &amp; get a bonus</h3>
                <p class="mt-2 text-muted-foreground text-sm">
                    Renew your annual plan at least 10 days early and we'll add
                    <strong> @_creditsBonus bonus credits</strong> to your account for the next year.
                </p>
            </div>
        </div>

        @* Benefits Grid *@
        <div class="grid grid-cols-2 border-b">
            <div class="flex flex-col gap-1 px-4 py-4">
                <div class="flex items-center gap-2 text-xs font-medium text-foreground">
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                    Price Protection
                </div>
                <p class="text-[10px] text-muted-foreground leading-relaxed">
                    Locked in at $490/yr for the next 24 months.
                </p>
            </div>
            <div class="flex flex-col gap-1 px-4 py-4 border-l">
                <div class="flex items-center gap-2 text-xs font-medium text-foreground">
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                    Priority Queue
                </div>
                <p class="text-[10px] text-muted-foreground leading-relaxed">
                    Early access to all beta features and UI updates.
                </p>
            </div>
        </div>

        @* Status and Action *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">
                    Offer ends in <strong class="text-foreground">@_daysLeft days</strong>
                </span>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Details
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs bg-indigo-600 hover:bg-indigo-700">
                    Renew Early
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private const int _creditsBonus = 500;
    private const int _daysLeft = 14;
}
