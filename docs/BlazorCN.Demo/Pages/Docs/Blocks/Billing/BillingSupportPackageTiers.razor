@* ============================================================
   Block: billing-support-package-tiers
   Title: BillingSupportPackageTiers
   Description: A premium support add-on selection block for enterprise SaaS featuring response time SLAs, dedicated channel options, and dynamic pricing built with shadcn/ui.
   Source: original/blocks/billing/billing-support-package-tiers.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="headphones" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Support Packages</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] uppercase font-bold tracking-tight">
                    SLA Backed
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Choose a support level that matches your business needs. All paid tiers include faster
                response times and dedicated assistance.
            </p>
        </div>

        <div class="p-4 space-y-4">
            <div class="grid gap-3">
                @foreach (var it in _tiers) {
                    var tier = it;
                    <label class="@Cn.Merge("relative flex cursor-pointer items-start justify-between rounded-lg border p-3 transition-colors hover:bg-muted/50", _selectedTier == tier.Id ? "border-primary bg-primary/5 ring-1 ring-primary" : "bg-muted/20")"
                           @onclick="@(() => _selectedTier = tier.Id)">
                        <input type="radio" name="support-tier" value="@tier.Id"
                               checked="@(_selectedTier == tier.Id)"
                               class="sr-only" />
                        <div class="flex gap-3">
                            <div class="@Cn.Merge("mt-0.5 rounded-md p-1.5", _selectedTier == tier.Id ? "bg-primary text-primary-foreground" : "bg-background border text-muted-foreground")">
                                <LucideIconCn Name="@tier.Icon" Size="14" Class="size-3.5" />
                            </div>
                            <div>
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-semibold">@tier.Name</span>
                                    <span class="text-[10px] font-medium text-muted-foreground uppercase bg-muted px-1.5 rounded">
                                        @tier.Sla SLA
                                    </span>
                                </div>
                                <p class="text-xs text-muted-foreground mt-0.5">
                                    @string.Join(" · ", tier.Features)
                                </p>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="flex items-center justify-end gap-1">
                                <span class="text-xs font-semibold text-foreground">$</span>
                                <span class="text-sm font-bold tracking-tight">@tier.Price</span>
                            </div>
                            <span class="text-[10px] text-muted-foreground">/mo</span>
                        </div>
                    </label>
                }
            </div>

            <div class="rounded-lg border bg-zinc-950 p-4 text-white dark:bg-zinc-900">
                <div class="flex items-start justify-between">
                    <div class="space-y-1">
                        <p class="text-[10px] font-bold uppercase text-zinc-500 tracking-widest">
                            Selected Add-on
                        </p>
                        <h4 class="text-sm font-medium">
                            @SelectedTier?.Name Support
                        </h4>
                        <p class="text-xs text-zinc-400">
                            Includes @SelectedTier?.Sla response time guarantee.
                        </p>
                    </div>
                    <div class="text-right">
                        <div class="flex items-baseline justify-end gap-1">
                            <span class="text-lg font-bold">$</span>
                            <span class="text-2xl font-bold tracking-tight">@(SelectedTier?.Price ?? 0)</span>
                        </div>
                        <p class="text-[10px] text-zinc-500 uppercase font-bold tracking-wider">
                            billed monthly
                        </p>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="w-full mt-4 bg-white text-black hover:bg-zinc-200">
                    Confirm Upgrade
                </ButtonCn>
            </div>
        </div>

        <div class="bg-muted/50 border-t px-4 py-2.5 flex items-center justify-center gap-2">
            <LucideIconCn Name="phone" Size="12" Class="size-3 text-muted-foreground" />
            <p class="text-[10px] text-muted-foreground font-medium uppercase tracking-widest leading-none">
                24/7 Emergency Support line available for Enterprise
            </p>
        </div>
    </div>
</section>

@code {
    private record Tier(string Id, string Name, int Price, string Sla, string[] Features, string Icon);

    private static readonly Tier[] _tiers = [
        new("standard", "Standard", 0, "24-48h", ["Email support", "Help center access", "Community forum"], "message-square"),
        new("priority", "Priority", 49, "< 4h", ["Priority email", "Live chat (9-5)", "Screen sharing"], "zap"),
        new("enterprise", "Enterprise", 199, "< 1h", ["24/7 Phone support", "Dedicated Slack", "Monthly reviews"], "headphones"),
    ];

    private string _selectedTier = "priority";

    private Tier? SelectedTier => _tiers.FirstOrDefault(t => t.Id == _selectedTier);
}
