@* ============================================================
   Block: billing-abandoned-checkout-alert
   Title: BillingAbandonedCheckoutAlert
   Description: A conversion-focused alert block for abandoned checkouts, offering limited-time discounts or reminders to complete the purchase.
   Source: original/blocks/billing/billing-abandoned-checkout-alert.tsx
   ============================================================ *@

@implements IDisposable

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-amber-500/20 bg-amber-500/5 shadow-sm">
        <div class="flex flex-col sm:flex-row items-center gap-4 p-4">
            <div class="size-10 rounded-full bg-amber-500/10 flex items-center justify-center shrink-0">
                <LucideIconCn Name="alert-circle" Size="20" Class="size-5 text-amber-600" />
            </div>

            <div class="flex-1 text-center sm:text-left space-y-1">
                <h3 class="text-sm font-bold text-amber-900 tracking-tight">
                    Don't leave your upgrade behind!
                </h3>
                <p class="text-xs text-amber-800/80 leading-relaxed">
                    We noticed you didn't finish your checkout. Complete your purchase now and use code
                    <b>SAVE15</b> for an extra 15% off your first year.
                </p>
            </div>

            <div class="flex flex-col items-center sm:items-end gap-2 shrink-0">
                <div class="flex items-center gap-1.5 px-2 py-1 rounded bg-amber-500/10 border border-amber-500/20">
                    <LucideIconCn Name="timer" Size="12" Class="size-3 text-amber-600" />
                    <span class="text-[11px] font-bold text-amber-700 font-mono">
                        @FormatTime(_timeLeft)
                    </span>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 bg-amber-600 hover:bg-amber-700 text-white border-none text-xs gap-1.5">
                    Resume Checkout
                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        <div class="h-1 bg-amber-500/20 w-full overflow-hidden">
            <div class="h-full bg-amber-500" style="@($"width:{(_timeLeft / 599.0 * 100):F1}%")"></div>
        </div>
    </div>

    <div class="mt-4 text-center">
        <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
            Offer valid for new subscriptions only • Ends soon
        </p>
    </div>
</section>

@code {
    private int _timeLeft = 599;
    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            if (_timeLeft > 0)
            {
                _timeLeft--;
                InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    private static string FormatTime(int seconds)
    {
        var mins = seconds / 60;
        var secs = seconds % 60;
        return $"{mins}:{secs:D2}";
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
