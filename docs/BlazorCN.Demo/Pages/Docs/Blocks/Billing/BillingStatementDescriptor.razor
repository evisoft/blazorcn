@* ============================================================
   Block: billing-statement-descriptor
   Title: BillingStatementDescriptor
   Description: A configuration block for managing bank statement descriptors for SaaS payments featuring real-time character counting, validation, and preview built with shadcn/ui.
   Source: original/blocks/billing/billing-statement-descriptor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="credit-card" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Statement Descriptor</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Configure how your charges appear on your customers' bank statements to reduce
                confusion and chargebacks.
            </p>
        </div>

        <div class="p-4 space-y-6">
            <div class="space-y-4">
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <label for="descriptor" class="text-xs font-medium uppercase text-muted-foreground tracking-tight">
                            Public Descriptor
                        </label>
                        <span class="@(_descriptor.Length > _maxLength ? "text-[10px] font-medium uppercase tracking-wider text-red-500" : "text-[10px] font-medium uppercase tracking-wider text-muted-foreground")">
                            @_descriptor.Length / @_maxLength Characters
                        </span>
                    </div>
                    <input id="descriptor"
                           value="@_descriptor"
                           @oninput="HandleInput"
                           placeholder="ACME_CLOUD"
                           class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 font-mono tracking-wider" />
                </div>

                <div class="rounded-md border bg-muted/30 p-3">
                    <div class="flex items-start gap-2">
                        <LucideIconCn Name="info" Size="14" Class="size-3.5 text-blue-500 mt-0.5 shrink-0" />
                        <div class="space-y-2">
                            <p class="text-xs font-medium text-foreground">Live Preview</p>
                            <div class="bg-white dark:bg-zinc-950 border rounded p-2 flex items-center justify-between shadow-sm">
                                <div class="flex items-center gap-3">
                                    <div class="size-6 rounded bg-zinc-100 dark:bg-zinc-900 flex items-center justify-center border">
                                        <LucideIconCn Name="shield" Size="12" Class="size-3 text-zinc-500" />
                                    </div>
                                    <span class="font-mono text-[11px] font-bold text-foreground">
                                        @DescriptorPreview
                                    </span>
                                </div>
                                <span class="font-mono text-[11px] text-zinc-400">-$49.00</span>
                            </div>
                            <p class="text-[10px] text-muted-foreground italic leading-relaxed">
                                * This is an approximation. Actual bank displays vary by institution and device.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs" OnClick="Reset">
                    Reset
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 px-4 text-xs">
                    Save Changes
                </ButtonCn>
            </div>
        </div>

        <div class="bg-muted/50 border-t px-4 py-2 text-center">
            <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
                Changes will take effect for all future transactions
            </p>
        </div>
    </div>
</section>

@code {
    private const int _maxLength = 22;
    private string _descriptor = "ACME_SAAS_PRO";

    private string DescriptorPreview =>
        _descriptor.Length >= _maxLength
            ? _descriptor[.._maxLength]
            : _descriptor.PadRight(_maxLength);

    private void HandleInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        _descriptor = new string(raw.ToUpperInvariant()
            .Where(c => (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '*' || c == '.' || c == '-')
            .ToArray());
    }

    private void Reset()
    {
        _descriptor = "ACME_SAAS_PRO";
    }
}
