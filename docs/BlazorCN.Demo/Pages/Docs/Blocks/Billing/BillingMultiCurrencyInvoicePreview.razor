@* ============================================================
   Block: billing-multi-currency-invoice-preview
   Title: BillingMultiCurrencyInvoicePreview
   Description: A dynamic invoice preview component for React and Next.js allowing users to toggle between multiple currencies and view real-time exchange rate conversions built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-multi-currency-invoice-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">

        @* Header with Currency Selector *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/10">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Invoice #2024-0042</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-[10px] font-medium uppercase tracking-wider">
                <LucideIconCn Name="globe" Size="12" Class="size-3" />
                USD / EUR
                <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

        @* Amount Comparison *@
        <div class="grid grid-cols-2 divide-x border-b">
            <div class="px-4 py-6">
                <span class="text-[10px] font-medium text-muted-foreground uppercase tracking-widest">Base Amount</span>
                <div class="mt-1 flex items-baseline gap-1">
                    <span class="text-xl font-semibold">$</span>
                    <span class="text-xl font-semibold">@_baseAmount.ToString("F2")</span>
                </div>
                <p class="text-[10px] text-muted-foreground mt-1">Platform standard (USD)</p>
            </div>
            <div class="px-4 py-6 bg-muted/20">
                <span class="text-[10px] font-medium text-foreground uppercase tracking-widest">Local Estimate</span>
                <div class="mt-1 flex items-baseline gap-1">
                    <span class="text-xl font-semibold">€</span>
                    <span class="text-xl font-semibold">@_euroAmount.ToString("F2")</span>
                </div>
                <p class="text-[10px] text-muted-foreground mt-1">1 USD = 0.92 EUR</p>
            </div>
        </div>

        @* Line Items Preview *@
        <div class="px-4 py-4 border-b space-y-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Pro Plan (Monthly)</span>
                <span class="font-medium tabular-nums">€45.08</span>
            </div>
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Additional Seats (x2)</span>
                <span class="font-medium tabular-nums">€9.20</span>
            </div>
            <div class="flex items-center justify-between text-xs border-t pt-2 mt-2">
                <span class="font-semibold">Subtotal</span>
                <span class="font-semibold tabular-nums">€54.28</span>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="info" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-[11px] underline underline-offset-4 cursor-help">
                    Tax residency: Germany
                </span>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    View History
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                    Download PDF
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private const double _baseAmount = 49.00;
    private const double _rate = 0.92;
    private double _euroAmount => _baseAmount * _rate;
}
