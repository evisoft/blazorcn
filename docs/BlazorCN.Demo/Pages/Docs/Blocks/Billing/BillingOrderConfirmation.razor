<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card text-center">
        <div class="flex flex-col items-center px-4 py-8">
            <div class="flex size-12 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600">
                <LucideIconCn Name="check-circle-2" Size="24" Class="size-6" />
            </div>
            <h2 class="mt-4 font-semibold text-lg">
                Order Confirmed
            </h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Thank you for your purchase! We&apos;ve sent a confirmation email to your inbox.
            </p>
        </div>

        <div class="border-t border-b bg-muted/30 px-6 py-5 text-left">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <p class="text-muted-foreground text-[10px] uppercase font-bold tracking-wider">
                        Order ID
                    </p>
                    <p class="mt-0.5 font-mono text-xs">ORD-7729-XB12</p>
                </div>
                <div>
                    <p class="text-muted-foreground text-[10px] uppercase font-bold tracking-wider">
                        Date
                    </p>
                    <p class="mt-0.5 text-xs">June 1, 2026</p>
                </div>
                <div>
                    <p class="text-muted-foreground text-[10px] uppercase font-bold tracking-wider">
                        Total
                    </p>
                    <p class="mt-0.5 font-semibold text-sm">$149.00</p>
                </div>
                <div>
                    <p class="text-muted-foreground text-[10px] uppercase font-bold tracking-wider">
                        Payment
                    </p>
                    <p class="mt-0.5 text-xs">Visa ending in 4242</p>
                </div>
            </div>
        </div>

        <div class="flex flex-col gap-2 p-4">
            <ButtonCn Class="w-full gap-2">
                <LucideIconCn Name="home" Size="16" Class="size-4" />
                Go to Dashboard
            </ButtonCn>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-2 text-xs">
                    <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                    Download Receipt
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-2 text-xs">
                    <LucideIconCn Name="external-link" Size="14" Class="size-3.5 text-muted-foreground" />
                    Manage Billing
                </ButtonCn>
            </div>
        </div>

        <div class="px-4 py-3 border-t">
            <p class="text-muted-foreground text-xs">
                Need help?
                <span class="font-medium text-foreground underline-offset-4 hover:underline cursor-pointer">
                    Contact Support
                </span>
            </p>
        </div>
    </div>
</section>
