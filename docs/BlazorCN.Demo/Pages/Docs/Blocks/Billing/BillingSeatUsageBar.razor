@* ============================================================
   Block: billing-seat-usage-bar
   Title: BillingSeatUsageBar
   Description: A condensed team billing block for React and Next.js to track active versus total seats with animated progress indicators built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-seat-usage-bar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="p-4 sm:p-5">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                    <h3 class="font-medium text-sm">Team Seat Usage</h3>
                </div>
                <div class="flex items-baseline gap-1 text-sm">
                    <span class="font-bold tabular-nums">@(_activeSeats + _pendingInvites)</span>
                    <span class="text-muted-foreground text-xs">of @_totalSeats seats</span>
                </div>
            </div>

            <div class="space-y-3">
                <div class="relative h-2 w-full overflow-hidden rounded-full bg-muted">
                    <div class="absolute inset-y-0 left-0 bg-foreground" style="@(FormattableString.Invariant($"width:{_usedPercentage}%"))" />
                    <div class="absolute inset-y-0 bg-foreground/30" style="@(FormattableString.Invariant($"left:{_usedPercentage}%;width:{_pendingPercentage}%"))" />
                </div>

                <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
                    <div class="flex items-center gap-2">
                        <div class="size-2 rounded-full bg-foreground" />
                        <span class="text-xs text-muted-foreground">@_activeSeats Active</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="size-2 rounded-full bg-foreground/30" />
                        <span class="text-xs text-muted-foreground">@_pendingInvites Pending</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="size-2 rounded-full bg-muted border" />
                        <span class="text-xs text-muted-foreground">@(_totalSeats - (_activeSeats + _pendingInvites)) Available</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex items-center justify-between border-t bg-muted/20 px-4 py-3">
            <p class="text-[10px] text-muted-foreground">
                Pro plan allows for up to 50 seats. Add more at $12/seat.
            </p>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 px-2 text-xs font-medium">
                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                Add Seats
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private int _activeSeats = 14;
    private int _pendingInvites = 2;
    private int _totalSeats = 20;

    private double _usedPercentage => (double)_activeSeats / _totalSeats * 100;
    private double _pendingPercentage => (double)_pendingInvites / _totalSeats * 100;
}
