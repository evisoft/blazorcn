@* ============================================================
   Block: billing-pricing-cards-grid
   Title: BillingPricingCardsGrid
   Description: A classic three-tier pricing cards grid for SaaS products in React and Next.js, featuring plan highlights and CTAs built with shadcn/ui.
   Source: original/blocks/billing/billing-pricing-cards-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        @foreach (var plan in _plans)
        {
            <div class="@Cn.Merge("relative flex flex-col rounded-2xl border bg-card p-6", plan.Popular ? "border-foreground shadow-lg ring-1 ring-foreground/10" : "border-border")">
                @if (plan.Popular)
                {
                    <div class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-foreground px-3 py-1 text-[10px] font-bold uppercase text-background tracking-widest">
                        Most Popular
                    </div>
                }

                <div class="flex-1">
                    <h3 class="font-bold text-lg">@plan.Name</h3>
                    <div class="mt-4 flex items-baseline gap-1">
                        @if (plan.Price != "Custom")
                        {
                            <span class="text-4xl font-bold tracking-tight">$</span>
                        }
                        <span class="text-4xl font-bold tracking-tight">@plan.Price</span>
                        @if (plan.Price != "Custom")
                        {
                            <span class="text-muted-foreground text-sm">/mo</span>
                        }
                    </div>
                    <p class="mt-4 text-muted-foreground text-sm leading-relaxed">
                        @plan.Description
                    </p>

                    <div class="mt-8 space-y-4">
                        <p class="text-[10px] uppercase font-bold text-muted-foreground tracking-widest">
                            Includes:
                        </p>
                        <ul class="space-y-3">
                            @foreach (var feature in plan.Features)
                            {
                                <li class="flex items-center gap-3">
                                    <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-500 shrink-0" />
                                    <span class="text-sm">@feature</span>
                                </li>
                            }
                        </ul>
                    </div>
                </div>

                <div class="mt-10">
                    <ButtonCn Variant="@(plan.Variant == "outline" ? ButtonVariant.Outline : ButtonVariant.Default)"
                              Class="@Cn.Merge("w-full h-11 font-semibold uppercase tracking-wider", plan.Popular ? "bg-foreground text-background hover:bg-foreground/90" : "")">
                        @plan.Cta
                    </ButtonCn>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record Plan(string Name, string Price, string Description, string[] Features, string Cta, string Variant, bool Popular = false);

    private static readonly Plan[] _plans =
    [
        new("Free", "0", "For individuals just getting started.", ["3 Projects", "Basic Analytics", "Community Support"], "Start for Free", "outline"),
        new("Pro", "29", "For growing teams and professionals.", ["Unlimited Projects", "Advanced Analytics", "24/7 Priority Support", "Custom Domains"], "Get Started", "default", Popular: true),
        new("Enterprise", "Custom", "For large-scale organizations.", ["Dedicated Support", "Custom Contracts", "SLA Guarantees", "Audit Logs"], "Contact Sales", "outline"),
    ];
}
