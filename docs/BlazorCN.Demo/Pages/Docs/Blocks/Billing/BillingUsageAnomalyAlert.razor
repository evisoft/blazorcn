@* ============================================================
   Block: billing-usage-anomaly-alert
   Title: BillingUsageAnomalyAlert
   Description: A proactive billing alert component for React and Next.js that detects and notifies users of unusual spending spikes built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-usage-anomaly-alert.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-amber-200 bg-amber-50/50">

        @* Header *@
        <div class="flex items-center justify-between border-b border-amber-200 px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-amber-600" />
                <span class="font-medium text-sm text-amber-900">Unusual Usage Detected</span>
            </div>
            <button aria-label="Dismiss" class="rounded-full p-1 hover:bg-amber-100 transition-colors">
                <LucideIconCn Name="x" Size="14" Class="size-3.5 text-amber-600" />
            </button>
        </div>

        @* Anomaly Details *@
        <div class="px-4 py-4">
            <div class="flex items-baseline gap-2">
                <div class="flex items-baseline gap-1">
                    <span class="text-2xl font-bold text-amber-900">$</span>
                    <span class="text-2xl font-bold text-amber-900">@_spikeAmount.ToString("F2")</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 bg-amber-100 text-amber-700 border-amber-200 font-medium">
                    <LucideIconCn Name="arrow-up" Size="12" Class="mr-0.5 size-3" />
                    @(_percentageSpike)% spike
                </BadgeCn>
            </div>
            <p class="mt-1 text-amber-800 text-xs leading-relaxed">
                Your current daily spend is significantly higher than your 30-day average ($3.20).
                This spike is primarily driven by <strong>Compute Instance (us-east-1)</strong>.
            </p>
        </div>

        @* Footer Actions *@
        <div class="flex items-center gap-2 px-4 py-3 bg-amber-100/50">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs bg-amber-600 hover:bg-amber-700 text-white border-none">
                <LucideIconCn Name="search" Size="14" Class="size-3.5" />
                Investigate Source
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs border-amber-300 text-amber-800 hover:bg-amber-200/50">
                Dismiss for 24h
            </ButtonCn>
            <span class="ml-auto text-[10px] text-amber-700/70 font-medium uppercase tracking-wider">
                Detected 12m ago
            </span>
        </div>

    </div>
</section>

@code {
    private decimal _spikeAmount = 45.20m;
    private int _percentageSpike = 124;
}
