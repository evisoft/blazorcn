@* ============================================================
   Block: billing-settings-sidebar-nav
   Title: BillingSettingsSidebarNav
   Description: A specialized billing navigation block for React and Next.js that provides a vertical sidebar for plan, usage, and invoice settings built with shadcn/ui.
   Source: original/blocks/billing/billing-settings-sidebar-nav.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-[280px] p-4">
    <div class="space-y-1">
        <div class="px-3 py-2 mb-2">
            <h2 class="text-xs font-bold uppercase tracking-widest text-muted-foreground">
                Billing
            </h2>
        </div>

        <nav class="space-y-1">
            @foreach (var navItem in _navItems)
            {
                var item = navItem;
                var isActive = _activeTab == item.Id;
                <div>
                    <ButtonCn Variant="@(isActive ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("group relative w-full justify-start gap-3 h-9 px-3 text-sm font-medium transition-all", isActive ? "bg-secondary text-foreground" : "text-muted-foreground hover:bg-muted/50")"
                              OnClick="@(() => SetActiveTab(item.Id))">
                        <LucideIconCn Name="@item.Icon" Size="16"
                                      Class="@Cn.Merge("size-4 shrink-0 transition-colors", isActive ? "text-foreground" : "text-muted-foreground group-hover:text-foreground")" />
                        <span class="flex-1 text-left truncate">@item.Label</span>

                        @if (item.Badge is not null)
                        {
                            <span class="rounded bg-emerald-500/10 px-1.5 py-0.5 text-[10px] font-bold text-emerald-600 dark:text-emerald-400">
                                @item.Badge
                            </span>
                        }

                        @if (item.Alert)
                        {
                            <span class="absolute right-2 top-1/2 -translate-y-1/2 size-1.5 rounded-full bg-red-500"></span>
                        }

                        @if (isActive)
                        {
                            <div class="absolute left-0 top-1.5 bottom-1.5 w-1 rounded-r-full bg-foreground"></div>
                        }
                    </ButtonCn>
                </div>
            }
        </nav>

        @* Support Section *@
        <div class="pt-6 mt-6 border-t px-3">
            <p class="text-[10px] text-muted-foreground leading-relaxed">
                Need help with billing? <br />
                <a href="#" class="text-foreground font-medium hover:underline">
                    Contact our support team
                </a>
            </p>
        </div>
    </div>
</section>

@code {
    private string _activeTab = "overview";

    private static readonly NavItem[] _navItems =
    [
        new("overview", "Overview", "layout-grid", "#", null, false),
        new("plan", "Subscription Plan", "shield", "#", "Pro", false),
        new("usage", "Usage & Limits", "trending-up", "#", null, false),
        new("payments", "Payment Methods", "credit-card", "#", null, true),
        new("invoices", "Invoice History", "file-text", "#", null, false),
        new("address", "Billing Address", "map-pin", "#", null, false),
    ];

    private void SetActiveTab(string id) => _activeTab = id;

    private record NavItem(string Id, string Label, string Icon, string Href, string? Badge, bool Alert);
}
