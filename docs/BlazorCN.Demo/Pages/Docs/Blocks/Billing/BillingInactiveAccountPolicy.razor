@* ============================================================
   Block: billing-inactive-account-policy
   Title: BillingInactiveAccountPolicy
   Description: A clear and informative compliance component for React and Next.js that explains the terms, notification schedule, and data retention policies for dormant accounts built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-inactive-account-policy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-alert" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Inactive Account Policy</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-[10px] uppercase tracking-wider bg-background">
                Compliance
            </BadgeCn>
        </div>

        @* Policy Overview *@
        <div class="px-4 py-5 border-b">
            <h3 class="text-sm font-semibold mb-2">How we handle dormant accounts</h3>
            <p class="text-xs text-muted-foreground leading-relaxed">
                To ensure platform performance and security, accounts with no activity for more than 180 days
                are subject to our inactivity policy. This includes data retention and eventual account closure.
            </p>
        </div>

        @* Timeline Schedule *@
        <div class="px-4 py-5 border-b">
            <h4 class="text-[10px] font-semibold text-muted-foreground uppercase tracking-widest mb-4">Lifecycle Schedule</h4>
            <div class="space-y-4">
                @foreach (var (step, i) in _schedule.Select((s, idx) => (s, idx)))
                {
                    <div class="flex items-center gap-4">
                        <div class="flex items-center justify-center w-20 shrink-0">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-medium text-[10px]">@step.Period</BadgeCn>
                        </div>
                        <div class="flex items-center gap-3 flex-1">
                            <div class="h-px flex-1 bg-muted"></div>
                            <span class="text-xs text-muted-foreground">@step.Event</span>
                            @if (i == 2)
                            {
                                <LucideIconCn Name="trash-2" Size="14" Class="size-3.5 text-destructive/50" />
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Status Alert *@
        <div class="px-4 py-4 border-b bg-emerald-50/30">
            <div class="flex items-start gap-3">
                <div class="flex size-7 items-center justify-center rounded-full bg-emerald-100 text-emerald-600">
                    <LucideIconCn Name="shield-check" Size="16" Class="size-4" />
                </div>
                <div>
                    <p class="text-xs font-medium text-emerald-900">Your account is active</p>
                    <p class="mt-0.5 text-[11px] text-emerald-800/80">
                        Last activity recorded 2 hours ago. You are not at risk of deactivation.
                    </p>
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="info" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-[10px] underline underline-offset-4 cursor-help">
                    Read full policy
                </span>
            </div>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    <LucideIconCn Name="clock" Size="14" Class="mr-1.5 size-3.5" />
                    Activity Log
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                    Reset Timer
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record ScheduleStep(string Period, string Event);

    private static readonly ScheduleStep[] _schedule =
    [
        new("180 Days", "Account flagged as inactive"),
        new("210 Days", "Final email notification"),
        new("240 Days", "Data purged and account closed"),
    ];
}
