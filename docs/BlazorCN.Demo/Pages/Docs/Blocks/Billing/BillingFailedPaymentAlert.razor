@* ============================================================
   Block: billing-failed-payment-alert
   Title: BillingFailedPaymentAlert
   Description: A billing failed payment and account recovery block for React and Next.js with immediate action prompts and grace period indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-failed-payment-alert.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-red-500/30 bg-red-500/5 shadow-sm">
        <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-start">
            <div class="flex size-10 shrink-0 items-center justify-center rounded-full bg-red-500/10 text-red-600">
                <LucideIconCn Name="alert-triangle" Size="20" Class="size-5" />
            </div>

            <div class="flex-1 space-y-1">
                <div class="flex items-center gap-2">
                    <h3 class="font-semibold text-sm text-red-900 dark:text-red-400">
                        Payment Failed
                    </h3>
                    <span class="rounded-full bg-red-500/20 px-2 py-0.5 text-[10px] font-bold uppercase text-red-600">
                        Critical
                    </span>
                </div>
                <p class="text-red-800/80 dark:text-red-400/80 text-xs leading-relaxed">
                    We were unable to process your most recent payment of <strong>$49.00</strong> on May
                    24. Please update your payment method to avoid service interruption.
                </p>

                <div class="mt-3 flex items-center gap-3 rounded border border-red-500/10 bg-red-500/5 p-2 text-[11px] text-red-700 dark:text-red-300">
                    <LucideIconCn Name="shield-alert" Size="14" Class="size-3.5" />
                    <span>Reason: Insufficient funds or card expired.</span>
                </div>
            </div>

            <div class="flex flex-col gap-2 shrink-0 sm:w-32">
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Destructive" Class="h-8 text-xs font-medium">
                    Update Card
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 text-xs font-medium border-red-200 hover:bg-red-100 dark:border-red-900/50 dark:hover:bg-red-950/30">
                    <LucideIconCn Name="refresh-cw" Size="12" Class="mr-1.5 size-3" />
                    Retry Now
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center justify-between border-t border-red-500/20 bg-red-500/10 px-5 py-2.5">
            <div class="flex items-center gap-2 text-red-800 dark:text-red-400 text-[10px] font-medium">
                <LucideIconCn Name="credit-card" Size="12" Class="size-3" />
                <span>Ending in •••• 4242</span>
            </div>
            <p class="text-red-800/60 dark:text-red-400/60 text-[10px]">
                Final attempt in <strong>2 days</strong>.
            </p>
        </div>
    </div>
</section>
