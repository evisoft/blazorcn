@* ============================================================
   Block: billing-checkout-summary
   Title: BillingCheckoutSummary
   Description: A clean checkout summary panel for React and Next.js with itemized order breakdown, subtotal calculations, coupon input, and final 'Complete Purchase' actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-checkout-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shopping-cart" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Order Summary</span>
            </div>
            <span class="text-muted-foreground text-xs">@_orderItems.Length items</span>
        </div>

        @* Items *@
        <div class="border-b">
            @foreach (var item in _orderItems)
            {
                <div class="flex items-center justify-between px-4 py-3">
                    <div class="min-w-0 flex-1">
                        <p class="font-medium text-sm">@item.Name</p>
                        @if (item.Interval != null)
                        {
                            <span class="text-muted-foreground text-[10px] uppercase">
                                Billed per @item.Interval
                            </span>
                        }
                    </div>
                    <span class="font-medium text-sm tabular-nums">$@(item.Price.ToString("F2"))</span>
                </div>
            }
        </div>

        @* Coupon *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <InputCn @bind-Value="_coupon"
                         Placeholder="Coupon code"
                         Class="h-8 border-0 bg-muted/50 px-3 shadow-none focus-visible:ring-0 text-xs" />
                <ButtonCn Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Sm"
                          Class="h-8 px-3 text-xs"
                          OnClick="HandleApply"
                          Disabled="@(_applied || string.IsNullOrEmpty(_coupon))">
                    @(_applied ? "Applied" : "Apply")
                </ButtonCn>
            </div>
            @if (!_applied)
            {
                <p class="mt-2 flex items-center gap-1.5 text-muted-foreground text-[10px]">
                    <LucideIconCn Name="tag" Size="12" Class="size-3" />
                    <span>Try "SAVE10" for 10% off</span>
                </p>
            }
        </div>

        @* Totals *@
        <div class="px-4 py-4">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Subtotal</span>
                    <span class="tabular-nums">$@(_subtotal.ToString("F2"))</span>
                </div>
                @if (_applied)
                {
                    <div class="flex items-center justify-between text-xs text-emerald-600 dark:text-emerald-400">
                        <span>Discount (SAVE10)</span>
                        <span class="tabular-nums">-$@(_discount.ToString("F2"))</span>
                    </div>
                }
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Estimated Tax (10%)</span>
                    <span class="tabular-nums">$@(_tax.ToString("F2"))</span>
                </div>
                <div class="flex items-center justify-between pt-2 border-t font-semibold text-lg">
                    <span>Order Total</span>
                    <span class="tabular-nums">$@(_total.ToString("F2"))</span>
                </div>
            </div>

            <ButtonCn Size="ButtonSize.Sm"
                      Class="mt-4 h-9 w-full gap-2 text-xs"
                      OnClick="HandleCheckout"
                      Disabled="@_loading">
                @if (_loading)
                {
                    <span>Processing...</span>
                }
                else
                {
                    <LucideIconCn Name="shield-check" Size="16" Class="size-4" />
                    <span>Complete Purchase</span>
                }
            </ButtonCn>

            <p class="mt-3 text-center text-muted-foreground text-[10px]">
                By completing your purchase, you agree to our Terms of Service and Privacy Policy.
                Secure checkout powered by Stripe.
            </p>
        </div>

    </div>
</section>

@code {
    private record OrderItem(string Id, string Name, double Price, string? Interval = null);

    private static readonly OrderItem[] _orderItems =
    [
        new("1", "Pro Plan Subscription", 49.0, "mo"),
        new("2", "Priority Support Add-on", 10.0, "mo"),
    ];

    private string _coupon = "";
    private bool _applied = false;
    private bool _loading = false;

    private double _subtotal
    {
        get
        {
            double s = 0;
            foreach (var i in _orderItems) s += i.Price;
            return s;
        }
    }

    private double _discount => _applied ? 10.0 : 0.0;
    private double _tax => (_subtotal - _discount) * 0.1;
    private double _total => _subtotal - _discount + _tax;

    private void HandleApply()
    {
        if (_coupon.ToLowerInvariant() == "save10")
        {
            _applied = true;
        }
    }

    private async Task HandleCheckout()
    {
        _loading = true;
        await Task.Delay(2000);
        _loading = false;
    }
}
