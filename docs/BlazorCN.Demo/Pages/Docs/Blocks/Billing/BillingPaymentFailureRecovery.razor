@* ============================================================
   Block: billing-payment-failure-recovery
   Title: BillingPaymentFailureRecovery
   Description: A focused UI for resolving payment failures and updating cards for React and Next.js, built with shadcn/ui and framer-motion.
   Source: original/blocks/billing/billing-payment-failure-recovery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-red-200 bg-red-50/30 dark:border-red-900/50 dark:bg-red-950/20">
        <div class="p-6">
            <div class="flex flex-col items-center text-center">
                <div class="flex size-12 items-center justify-center rounded-full bg-red-100 text-red-600 dark:bg-red-900/30 dark:text-red-500">
                    <LucideIconCn Name="alert-circle" Size="24" Class="size-6" />
                </div>
                <h2 class="mt-4 font-semibold text-lg">Payment Failed</h2>
                <p class="mt-1 text-muted-foreground text-sm">
                    @_errorReason
                </p>
            </div>

            <div class="mt-8 rounded-lg border bg-card p-4">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                        <div class="flex h-8 w-12 items-center justify-center rounded border bg-muted/20">
                            <LucideIconCn Name="credit-card" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div>
                            <p class="font-medium text-sm">Visa ending in @_lastFour</p>
                            <p class="text-muted-foreground text-xs">Expires 12/26</p>
                        </div>
                    </div>
                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-red-500 border-red-200 dark:border-red-900">
                        Failed
                    </span>
                </div>
            </div>

            <div class="mt-6 flex flex-col gap-2">
                <ButtonCn Class="w-full gap-2 bg-red-600 hover:bg-red-700 text-white"
                          OnClick="HandleRetry"
                          Disabled="@_isRetrying">
                    <LucideIconCn Name="refresh-cw" Size="16" Class="@_refreshIconClass" />
                    @(_isRetrying ? "Retrying..." : "Retry Payment")
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="w-full">
                    Use a different payment method
                </ButtonCn>
            </div>
        </div>

        <div class="border-t border-red-200 bg-red-50/50 px-6 py-3 dark:border-red-900/50 dark:bg-red-950/40">
            <p class="text-center text-[11px] text-muted-foreground">
                Your subscription will remain active for 3 more days before service is interrupted.
            </p>
        </div>
    </div>
</section>

@code {
    private bool _isRetrying;
    private readonly string _lastFour = "4242";
    private readonly string _errorReason = "Your card was declined due to insufficient funds.";

    private string _refreshIconClass => Cn.Merge("size-4", _isRetrying ? "animate-spin" : "");

    private async Task HandleRetry()
    {
        _isRetrying = true;
        StateHasChanged();
        await Task.Delay(2000);
        _isRetrying = false;
    }
}
