@* ============================================================
   Block: billing-startup-discount-application
   Title: BillingStartupDiscountApplication
   Description: A professional startup discount application form for SaaS platforms featuring eligibility checks, company verification, and dynamic discount previews built with shadcn/ui and framer-motion.
   Source: original/blocks/billing/billing-startup-discount-application.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Startup Program</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-[10px] uppercase tracking-wider">
                    90% Off First Year
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Fuel your growth with our startup credits. Eligible companies get 90% off their first
                12 months of any Pro or Enterprise plan.
            </p>
        </div>

        <div class="p-4 space-y-6">
            <div class="grid gap-4 md:grid-cols-2">
                <div class="space-y-2">
                    <LabelCn For="company-name" Class="text-xs font-medium uppercase text-muted-foreground tracking-tight">
                        Company Name
                    </LabelCn>
                    <InputCn id="company-name" Placeholder="Acme Inc." Class="h-9" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="website" Class="text-xs font-medium uppercase text-muted-foreground tracking-tight">
                        Website URL
                    </LabelCn>
                    <InputCn id="website" Placeholder="https://acme.com" Class="h-9" />
                </div>
            </div>

            <div class="space-y-3 rounded-md bg-muted/30 p-3 border border-dashed">
                <h3 class="text-xs font-medium flex items-center gap-2">
                    <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-emerald-500" />
                    Eligibility Criteria
                </h3>
                <ul class="grid gap-2">
                    @foreach (var item in _eligibilityItems)
                    {
                        <li class="flex items-center gap-2 text-xs text-muted-foreground">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500 shrink-0" />
                            @item
                        </li>
                    }
                </ul>
            </div>

            <div class="flex items-center justify-between rounded-lg border bg-muted/20 p-4">
                <div>
                    <p class="text-xs font-medium text-muted-foreground uppercase tracking-tight">
                        Estimated Monthly Savings
                    </p>
                    <div class="flex items-baseline gap-1 mt-1">
                        <span class="text-2xl font-semibold tracking-tight text-foreground">$</span>
                        <span class="text-2xl font-semibold tracking-tight">441.00</span>
                    </div>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-9 px-4">
                    Apply Now
                </ButtonCn>
            </div>
        </div>

        <div class="bg-muted/50 border-t px-4 py-2.5 text-center">
            <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
                Applications are typically reviewed within 48 hours
            </p>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _eligibilityItems =
    [
        "Founded within the last 3 years",
        "Raised less than $5M in total funding",
        "Fewer than 20 employees total",
        "Not currently an enterprise customer",
    ];
}
