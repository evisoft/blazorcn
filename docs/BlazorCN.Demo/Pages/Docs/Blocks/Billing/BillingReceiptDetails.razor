@* ============================================================
   Block: billing-receipt-details
   Title: BillingReceiptDetails
   Description: A detailed receipt breakdown block for React and Next.js with line-item descriptions, tax calculations, payment method summary, and print actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-receipt-details.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="receipt" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Receipt Details</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 px-2 text-xs">
                <LucideIconCn Name="printer" Size="12" Class="size-3 text-muted-foreground" />
                Print
            </ButtonCn>
        </div>

        @* Transaction Summary *@
        <div class="border-b px-4 py-4">
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <span class="text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                        Receipt ID
                    </span>
                    <p class="font-mono text-sm">#REC-9283-X1</p>
                </div>
                <div>
                    <span class="text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                        Date
                    </span>
                    <p class="text-sm">Mar 24, 2026</p>
                </div>
            </div>
        </div>

        @* Line Items *@
        <div class="border-b">
            @foreach (var item in _lineItems)
            {
                <div class="flex items-center justify-between px-4 py-3">
                    <div class="min-w-0 flex-1">
                        <p class="font-medium text-sm">@item.Description</p>
                        <span class="text-muted-foreground text-xs">Qty: @item.Quantity</span>
                    </div>
                    <span class="font-medium text-sm tabular-nums">
                        $@((item.Price * item.Quantity).ToString("F2"))
                    </span>
                </div>
            }
        </div>

        @* Totals *@
        <div class="border-b px-4 py-4">
            <div class="space-y-1.5">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Subtotal</span>
                    <span class="tabular-nums">$@Subtotal.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Tax (10%)</span>
                    <span class="tabular-nums">$@Tax.ToString("F2")</span>
                </div>
                <div class="flex items-center justify-between pt-1.5 font-semibold text-sm">
                    <span>Total Paid</span>
                    <span class="tabular-nums">$@Total.ToString("F2")</span>
                </div>
            </div>
        </div>

        @* Payment & Address *@
        <div class="grid grid-cols-2 divide-x border-b">
            <div class="px-4 py-3">
                <span class="text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                    Payment Method
                </span>
                <div class="mt-1 flex items-center gap-2">
                    <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-sm">Visa •••• 4242</span>
                </div>
            </div>
            <div class="px-4 py-3">
                <span class="text-muted-foreground text-[10px] uppercase tracking-wider font-medium">
                    Billing To
                </span>
                <p class="mt-1 text-xs">
                    Acme Corp, 123 Tech Lane, San Francisco, CA 94105
                </p>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-[10px]">
                Thank you for choosing shadcn.io. For billing inquiries, email support@@shadcn.io.
            </p>
        </div>

    </div>
</section>

@code {
    private record LineItem(string Id, string Description, int Quantity, decimal Price);

    private static readonly LineItem[] _lineItems =
    [
        new("1", "Pro Plan - Monthly Subscription", 1, 49.0m),
        new("2", "Additional AI Credits (10k)", 2, 10.0m),
    ];

    private decimal Subtotal => _lineItems.Sum(i => i.Price * i.Quantity);
    private decimal Tax => Subtotal * 0.1m;
    private decimal Total => Subtotal + Tax;
}
