@* ============================================================
   Block: billing-enterprise-request
   Title: BillingEnterpriseRequest
   Description: A billing enterprise inquiry and custom plan request block for React and Next.js with specialized lead capture and feature requirements built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-enterprise-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col border-b p-6 text-center sm:p-8">
            <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-primary/10 text-primary">
                <LucideIconCn Name="building-2" Size="24" Class="size-6" />
            </div>
            <h2 class="mt-4 font-semibold text-xl tracking-tight">Enterprise Solutions</h2>
            <p class="mt-2 text-muted-foreground text-sm">
                Need more than our standard plans? We offer custom pricing and dedicated support for
                large-scale organizations.
            </p>
        </div>

        <div class="grid gap-0 sm:grid-cols-2">
            <div class="border-b p-6 sm:border-b-0 sm:border-r">
                <h3 class="font-medium text-sm">Enterprise Benefits</h3>
                <ul class="mt-4 space-y-3">
                    @foreach (var feature in _features)
                    {
                        <li class="flex items-center gap-2.5 text-muted-foreground text-xs">
                            <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                            @feature
                        </li>
                    }
                </ul>
                <div class="mt-8 space-y-4">
                    <div class="flex items-center gap-3 rounded-md border p-2.5">
                        <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                            Global Compliance
                        </span>
                    </div>
                    <div class="flex items-center gap-3 rounded-md border p-2.5">
                        <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="text-[11px] font-medium uppercase tracking-wider text-muted-foreground">
                            Security Audited
                        </span>
                    </div>
                </div>
            </div>

            <div class="p-6">
                <form class="space-y-4" @onsubmit:preventDefault>
                    <div class="space-y-1.5">
                        <label for="email" class="text-xs font-medium text-muted-foreground">
                            Work Email
                        </label>
                        <InputCn Id="email" Type="email" Placeholder="name@company.com" />
                    </div>
                    <div class="space-y-1.5">
                        <label for="seats" class="text-xs font-medium text-muted-foreground">
                            Expected Seats
                        </label>
                        <InputCn Id="seats" Type="number" Placeholder="500+" />
                    </div>
                    <div class="space-y-1.5">
                        <label for="message" class="text-xs font-medium text-muted-foreground">
                            Specific Requirements
                        </label>
                        <TextareaCn Id="message" Placeholder="Security needs, SSO, etc." Class="min-h-[80px]" />
                    </div>
                    <div class="flex items-center gap-2 pt-1">
                        <CheckboxCn Id="marketing" />
                        <label for="marketing" class="text-[10px] text-muted-foreground leading-tight">
                            I agree to receive communications about enterprise services.
                        </label>
                    </div>
                    <ButtonCn Class="w-full h-10 gap-2">
                        <LucideIconCn Name="message-square" Size="16" Class="size-4" />
                        Talk to Sales
                    </ButtonCn>
                </form>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _features =
    [
        "Custom SLA & Uptime Guarantees",
        "Dedicated Account Manager",
        "SSO & SAML Integration",
        "Unlimited Data Retention",
    ];
}
