@* ============================================================
   Block: billing-promotion-banner
   Title: BillingPromotionBanner
   Description: A high-conversion billing promotion banner for React and Next.js with countdown timers and discount code application built with shadcn/ui and Framer Motion.
   Source: original/blocks/billing/billing-promotion-banner.tsx
   ============================================================ *@

@inject IJSRuntime JS

@if (_isVisible)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="relative overflow-hidden rounded-lg border border-blue-500/20 bg-blue-500/5 px-4 py-3">
            <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
                <div class="flex items-center gap-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-blue-500/10">
                        <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-blue-600 dark:text-blue-400" />
                    </div>
                    <div class="min-w-0">
                        <p class="font-medium text-sm text-blue-900 dark:text-blue-300">
                            Summer Sale: 30% off for 6 months
                        </p>
                        <p class="text-blue-700/80 text-xs dark:text-blue-400/80">
                            Upgrade to any Pro plan and use the code below at checkout.
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-2">
                    <div class="flex items-center gap-1.5 rounded border border-blue-500/20 bg-background/50 px-2 py-1 font-mono text-blue-600 text-xs dark:text-blue-400">
                        <LucideIconCn Name="ticket" Size="12" Class="size-3" />
                        @_promoCode
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 border-blue-500/20 bg-background/50 text-blue-600 hover:bg-blue-500/10 hover:text-blue-700 dark:text-blue-400" OnClick="@CopyPromoCode">
                        <LucideIconCn Name="copy" Size="12" Class="mr-1.5 size-3" />
                        Copy
                    </ButtonCn>
                </div>
            </div>

            <button type="button"
                    @onclick="@(() => _isVisible = false)"
                    class="absolute top-1 right-1 rounded-full p-1 text-blue-400 hover:bg-blue-500/10 hover:text-blue-600 transition-colors"
                    aria-label="Close banner">
                <LucideIconCn Name="x" Size="16" Class="size-3.5" />
            </button>

            @* Decorative element *@
            <div class="absolute -right-4 -bottom-4 size-24 bg-blue-500/5 blur-3xl"></div>
        </div>
    </section>
}

@code {
    private bool _isVisible = true;
    private const string _promoCode = "SUMMER2026";

    private async Task CopyPromoCode()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _promoCode);
    }
}
