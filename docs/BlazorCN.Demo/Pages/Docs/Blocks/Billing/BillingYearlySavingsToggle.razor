@* ============================================================
   Block: billing-yearly-savings-toggle
   Title: BillingYearlySavingsToggle
   Description: An interactive billing toggle component that calculates and highlights potential savings when switching from monthly to annual plans.
   Source: original/blocks/billing/billing-yearly-savings-toggle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        <div class="flex flex-col items-center justify-center p-6 space-y-6">
            <div class="flex items-center gap-4 bg-muted/50 p-1.5 rounded-full border">
                <span class="@(!_isYearly ? "text-xs font-medium px-4 py-1.5 rounded-full transition-colors bg-background shadow-sm border" : "text-xs font-medium px-4 py-1.5 rounded-full transition-colors text-muted-foreground")">
                    Monthly
                </span>
                <SwitchCn @bind-Checked="_isYearly" Class="data-[state=checked]:bg-primary" />
                <span class="@(_isYearly ? "text-xs font-medium px-4 py-1.5 rounded-full transition-colors bg-background shadow-sm border" : "text-xs font-medium px-4 py-1.5 rounded-full transition-colors text-muted-foreground")">
                    Yearly
                </span>
            </div>

            <div class="text-center space-y-2">
                <div class="flex items-baseline justify-center gap-1.5">
                    <span class="text-3xl font-bold tracking-tight">$</span>
                    <span class="text-5xl font-bold tracking-tight tabular-nums">
                        @(_isYearly ? _yearlyPrice : _monthlyPrice)
                    </span>
                    <span class="text-muted-foreground font-medium">/mo</span>
                </div>
                <p class="text-sm text-muted-foreground">
                    @(_isYearly ? $"Billed ${_totalYearly} annually" : "Billed monthly, cancel anytime")
                </p>
            </div>

            @if (_isYearly)
            {
                <div class="flex items-center gap-2 bg-emerald-500/10 text-emerald-600 px-4 py-2 rounded-lg border border-emerald-500/20">
                    <LucideIconCn Name="sparkles" Size="16" Class="size-4" />
                    <span class="text-sm font-semibold">
                        You save $@_savings per year
                    </span>
                </div>
            }

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 w-full max-w-md pt-2">
                <div class="p-3 rounded-lg border bg-muted/20 flex flex-col gap-1">
                    <div class="flex items-center gap-2 text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        <LucideIconCn Name="zap" Size="12" Class="size-3" />
                        Plan Features
                    </div>
                    <p class="text-xs font-medium">Unlimited Projects</p>
                    <p class="text-xs font-medium">Priority Support</p>
                </div>
                <div class="p-3 rounded-lg border bg-muted/20 flex flex-col gap-1">
                    <div class="flex items-center gap-2 text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                        <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 px-1 text-[8px] font-bold bg-primary text-primary-foreground border-none uppercase">
                            Pro
                        </BadgeCn>
                        Included Credits
                    </div>
                    <p class="text-xs font-medium">5,000 AI tokens/mo</p>
                    <p class="text-xs font-medium">Advanced Analytics</p>
                </div>
            </div>

            <ButtonCn Class="w-full max-w-md h-11 font-semibold group" Size="ButtonSize.Lg">
                Upgrade Now
                <span class="ml-2">→</span>
            </ButtonCn>
        </div>

        <div class="bg-muted/30 border-t px-4 py-2.5 text-center">
            <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
                30-day money-back guarantee • No hidden fees
            </p>
        </div>
    </div>
</section>

@code {
    private bool _isYearly = true;
    private const int _monthlyPrice = 49;
    private const int _yearlyPrice = 39;
    private const int _totalYearly = _yearlyPrice * 12;
    private const int _savings = _monthlyPrice * 12 - _totalYearly;
}
