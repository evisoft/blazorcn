@* ============================================================
   Block: billing-api-credits
   Title: BillingApiCredits
   Description: A credit balance management block for React and Next.js with animated totals, usage tracking, and quick top-up actions built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-api-credits.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="coins" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">API Credits</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your credits are used to power AI inferences and data exports. Credits do not expire.
            </p>
        </div>

        @* Balance Display *@
        <div class="px-4 py-6">
            <div class="flex items-end justify-between">
                <div class="space-y-1">
                    <span class="text-muted-foreground text-xs uppercase tracking-wider">
                        Available Balance
                    </span>
                    <div class="flex items-center gap-2">
                        <span class="text-3xl font-semibold tracking-tight tabular-nums">
                            @_balance
                        </span>
                        <span class="text-muted-foreground text-sm font-medium">credits</span>
                    </div>
                </div>
                <div class="text-right">
                    <span class="text-muted-foreground text-xs">
                        @(((double)_balance / _maxCredits * 100).ToString("F0"))% remaining
                    </span>
                </div>
            </div>
            <ProgressCn Value="@((double)_balance / _maxCredits * 100)" Class="mt-4 h-1.5" aria-label="Progress" />
        </div>

        @* Quick Actions *@
        <div class="grid grid-cols-3 divide-x border-t bg-muted/10">
            <button type="button"
                    @onclick="@(() => TopUp(5000))"
                    class="flex flex-col items-center gap-1.5 py-4 transition-colors hover:bg-muted/50">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5 text-muted-foreground" />
                <div class="text-center">
                    <p class="font-medium text-xs">5,000</p>
                    <p class="text-muted-foreground text-[10px]">$5.00</p>
                </div>
            </button>
            <button type="button"
                    @onclick="@(() => TopUp(25000))"
                    class="flex flex-col items-center gap-1.5 py-4 transition-colors hover:bg-muted/50">
                <LucideIconCn Name="zap" Size="14" Class="size-3.5 text-amber-500" />
                <div class="text-center">
                    <p class="font-medium text-xs">25,000</p>
                    <p class="text-muted-foreground text-[10px]">$20.00</p>
                </div>
            </button>
            <button type="button"
                    @onclick="@(() => TopUp(100000))"
                    class="flex flex-col items-center gap-1.5 py-4 transition-colors hover:bg-muted/50">
                <LucideIconCn Name="coins" Size="14" Class="size-3.5 text-emerald-500" />
                <div class="text-center">
                    <p class="font-medium text-xs">100k</p>
                    <p class="text-muted-foreground text-[10px]">$75.00</p>
                </div>
            </button>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t bg-muted/30 px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Auto-top up is disabled</span>
            <ButtonCn Variant="ButtonVariant.Link" Class="h-auto p-0 text-xs">
                Manage auto-refill
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private int _balance = 12450;
    private const int _maxCredits = 50000;

    private void TopUp(int amount)
    {
        _balance += amount;
    }
}
