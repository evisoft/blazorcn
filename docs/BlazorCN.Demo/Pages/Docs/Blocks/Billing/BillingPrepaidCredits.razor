@* ============================================================
   Block: billing-prepaid-credits
   Title: BillingPrepaidCredits
   Description: A credit bundle purchase UI for token-based or credit-based SaaS in React and Next.js, featuring bulk savings built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-prepaid-credits.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-6 py-4 flex items-center justify-between bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="coins" Size="16" Class="size-4 text-amber-500" />
                <span class="font-medium text-sm">Prepaid Credits</span>
            </div>
            <div class="flex flex-col items-end">
                <span class="text-[10px] text-muted-foreground uppercase font-bold tracking-widest">
                    Balance
                </span>
                <span class="text-sm font-semibold tabular-nums">
                    @_currentBalance Credits
                </span>
            </div>
        </div>

        @* Bundles *@
        <div class="p-6 space-y-4">
            <p class="text-sm text-muted-foreground text-center">
                Choose a credit bundle to top up your workspace balance.
            </p>

            <div class="grid grid-cols-1 gap-3">
                @foreach (var bundle in _bundles)
                {
                    <div class="@Cn.Merge("relative flex items-center justify-between rounded-xl border p-4 cursor-pointer transition-all", _selected == bundle.Id ? "border-foreground bg-foreground/5 shadow-sm" : "hover:border-muted-foreground/30")"
                         @onclick="@(() => _selected = bundle.Id)">
                        @if (bundle.Popular)
                        {
                            <div class="absolute -top-2 right-4 rounded-full bg-foreground px-2 py-0.5 text-[8px] font-bold uppercase text-background tracking-widest">
                                Best Value
                            </div>
                        }
                        <div class="flex items-center gap-4">
                            <div class="@Cn.Merge("flex size-10 items-center justify-center rounded-lg", _selected == bundle.Id ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                                <LucideIconCn Name="zap" Size="20" Class="size-5" />
                            </div>
                            <div class="space-y-0.5">
                                <p class="font-bold text-sm">@bundle.Credits.ToString("N0") Credits</p>
                                <div class="flex items-center gap-2">
                                    <span class="text-xs text-muted-foreground">@bundle.Label</span>
                                    @if (bundle.Bonus > 0)
                                    {
                                        <div class="flex items-center gap-1 text-[10px] text-emerald-600 font-bold uppercase">
                                            <LucideIconCn Name="plus" Size="10" Class="size-2.5" />
                                            @bundle.Bonus Bonus
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="text-right">
                            <p class="font-bold text-lg">$@bundle.Price</p>
                            <p class="text-[10px] text-muted-foreground uppercase tracking-wider">
                                $@(((double)bundle.Price / bundle.Credits).ToString("F3")) / unit
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="p-6 bg-muted/10 border-t">
            <ButtonCn Class="w-full h-12 text-sm font-bold uppercase tracking-wider gap-2">
                Purchase @(_bundles.FirstOrDefault(b => b.Id == _selected)?.Credits.ToString("N0")) Credits
                <LucideIconCn Name="sparkles" Size="16" Class="size-4" />
            </ButtonCn>
            <p class="mt-4 text-center text-[10px] text-muted-foreground leading-relaxed">
                Credits never expire and are applied instantly to your workspace. Prices exclude
                applicable taxes.
            </p>
        </div>
    </div>
</section>

@code {
    private string _selected = "2";
    private readonly int _currentBalance = 420;

    private record Bundle(string Id, int Credits, int Price, int Bonus, string Label, bool Popular = false);

    private static readonly Bundle[] _bundles =
    [
        new("1", 500, 10, 0, "Starter"),
        new("2", 2500, 40, 500, "Growth", Popular: true),
        new("3", 10000, 120, 2500, "Scale"),
    ];
}
