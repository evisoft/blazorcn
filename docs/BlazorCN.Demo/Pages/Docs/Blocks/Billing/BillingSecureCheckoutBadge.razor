<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex flex-col items-center justify-center gap-6 py-4">
        <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
            <div class="flex items-center gap-2 grayscale transition-all hover:grayscale-0">
                <LucideIconCn Name="lock" Size="16" Class="size-4 text-muted-foreground" />
                <div class="flex flex-col leading-none">
                    <span class="text-[10px] font-bold uppercase tracking-widest">SSL Secure</span>
                    <span class="text-[8px] text-muted-foreground">256-bit encryption</span>
                </div>
            </div>

            <div class="flex items-center gap-2 grayscale transition-all hover:grayscale-0">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <div class="flex flex-col leading-none">
                    <span class="text-[10px] font-bold uppercase tracking-widest">PCI-DSS</span>
                    <span class="text-[8px] text-muted-foreground">Compliant provider</span>
                </div>
            </div>

            <div class="flex items-center gap-2 grayscale transition-all hover:grayscale-0">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <div class="flex flex-col leading-none">
                    <span class="text-[10px] font-bold uppercase tracking-widest">SOC2 Type II</span>
                    <span class="text-[8px] text-muted-foreground">Security certified</span>
                </div>
            </div>
        </div>

        <p class="text-[10px] text-muted-foreground text-center">
            Your payment information is processed securely by Stripe. We never store your full
            credit card details on our servers.
        </p>

        <div class="h-px w-24 bg-border"></div>
    </div>
</section>
