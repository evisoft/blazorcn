@* ============================================================
   Block: billing-referral-credit
   Title: BillingReferralCredit
   Description: A billing credit management block for React and Next.js to track and apply referral bonuses to subscriptions built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-referral-credit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="p-4 sm:p-6">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
                <div class="space-y-1">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="gift" Size="16" Class="size-4 text-emerald-500" />
                        <h3 class="font-medium text-sm">Referral Credits</h3>
                    </div>
                    <p class="text-muted-foreground text-sm leading-relaxed">
                        You've earned credits by inviting @_referralCount friends. These will be deducted
                        from your next bill.
                    </p>
                </div>

                <div class="flex flex-col items-start gap-1 sm:items-end">
                    <span class="text-3xl font-bold tracking-tight tabular-nums">
                        $@(_creditBalance.ToString("F2"))
                    </span>
                    <span class="text-[10px] font-medium uppercase tracking-wider text-muted-foreground">
                        Available Balance
                    </span>
                </div>
            </div>

            <div class="mt-6 grid gap-4 sm:grid-cols-2">
                <div class="rounded-lg border bg-muted/30 p-3">
                    <div class="flex items-center gap-2 text-muted-foreground mb-1">
                        <LucideIconCn Name="trending-up" Size="14" Class="size-3.5" />
                        <span class="text-xs font-medium">Pending Earnings</span>
                    </div>
                    <p class="text-sm font-semibold tabular-nums">
                        +$@(_nextPayoutEstimate.ToString("F2"))
                    </p>
                </div>
                <div class="rounded-lg border bg-muted/30 p-3">
                    <div class="flex items-center gap-2 text-muted-foreground mb-1">
                        <LucideIconCn Name="share-2" Size="14" Class="size-3.5" />
                        <span class="text-xs font-medium">Active Invites</span>
                    </div>
                    <p class="text-sm font-semibold tabular-nums">@_referralCount successful</p>
                </div>
            </div>
        </div>

        <div class="flex flex-col items-center justify-between gap-4 border-t bg-muted/10 px-4 py-3 sm:flex-row">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <SwitchCn id="auto-apply" @bind-Value="_autoApply" />
                    <label for="auto-apply" class="text-xs font-medium cursor-pointer">
                        Apply to next invoice
                    </label>
                </div>
                <div class="group relative">
                    <LucideIconCn Name="info" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block w-48 rounded bg-foreground p-2 text-[10px] text-background">
                        Credits are applied as a discount on your next recurring payment.
                    </div>
                </div>
            </div>

            <ButtonCn Size="ButtonSize.Sm" Class="w-full gap-2 sm:w-auto">
                <LucideIconCn Name="share-2" Size="14" Class="size-3.5" />
                Invite More Friends
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _autoApply = true;
    private decimal _creditBalance = 25.0m;
    private int _referralCount = 3;
    private decimal _nextPayoutEstimate = 10.0m;
}
