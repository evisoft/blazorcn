@* ============================================================
   Block: billing-overdue-account-warning
   Title: BillingOverdueAccountWarning
   Description: A high-urgency billing alert block for React and Next.js to notify users of failed payments and overdue balances built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-overdue-account-warning.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border-2 border-red-200 bg-red-50/30 dark:border-red-900/50 dark:bg-red-950/20">

        @* Header *@
        <div class="flex items-center justify-between border-b border-red-100 px-4 py-3 dark:border-red-900/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="alert-circle" Size="16" Class="size-4 text-red-600 dark:text-red-400" />
                <span class="font-semibold text-sm text-red-900 dark:text-red-100 text-sm">Action Required: Overdue Balance</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Destructive" Class="font-bold text-[10px] uppercase h-5 px-1.5">
                Urgent
            </BadgeCn>
        </div>

        @* Content *@
        <div class="px-4 py-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="space-y-2">
                    <h3 class="font-medium text-red-900 dark:text-red-100">Your account is @_daysOverdue days past due</h3>
                    <p class="text-red-700/80 dark:text-red-400/80 text-sm leading-relaxed">
                        Your last payment of $@_overdueAmount.ToString("F2") was declined by your bank. Please update your payment method to avoid service suspension on June 1st.
                    </p>
                </div>

                <div class="flex flex-col items-center md:items-end gap-1 shrink-0">
                    <span class="text-red-900/60 dark:text-red-100/40 text-[10px] uppercase font-bold tracking-wider">Total Owed</span>
                    <div class="flex items-baseline gap-1 text-red-600 dark:text-red-400">
                        <span class="text-xl font-medium">$</span>
                        <span class="text-4xl font-bold tracking-tighter">
                            @_overdueAmount.ToString("F2")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        @* Info Row *@
        <div class="bg-red-100/50 dark:bg-red-900/20 border-t border-red-100 dark:border-red-900/30 px-4 py-3 flex items-center gap-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-red-200/50 dark:bg-red-800/30">
                <LucideIconCn Name="credit-card" Size="16" Class="size-4 text-red-700 dark:text-red-300" />
            </div>
            <div class="flex-1">
                <p class="text-xs font-medium text-red-900 dark:text-red-100">Primary Card: Visa •••• 4242</p>
                <p class="text-red-700/60 dark:text-red-400/60 text-[10px]">Reason: Insufficient Funds</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-red-700 dark:text-red-300 hover:bg-red-200/50 dark:hover:bg-red-800/30 text-xs">
                Update Card
            </ButtonCn>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-4 border-t border-red-100 dark:border-red-900/30 bg-white/40 dark:bg-black/20">
            <ButtonCn Variant="ButtonVariant.Destructive" Size="ButtonSize.Sm" Class="h-9 px-4 gap-1.5 text-xs font-semibold">
                <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                Retry Payment
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-9 px-4 gap-1.5 text-xs border-red-200 dark:border-red-900 hover:bg-red-50 dark:hover:bg-red-950">
                View Invoice
                <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5" />
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private double _overdueAmount = 89.00;
    private int _daysOverdue = 12;
}
