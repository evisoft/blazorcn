@* ============================================================
   Block: billing-purchase-order-form
   Title: BillingPurchaseOrderForm
   Description: A professional enterprise billing form for React and Next.js to handle Purchase Orders (PO), tax IDs, and manual invoicing built with shadcn/ui.
   Source: original/blocks/billing/billing-purchase-order-form.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Purchase Order (PO) Details</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Enter your enterprise billing details to receive invoices with PO numbers and tax IDs.
            </p>
        </div>

        @* Form Fields *@
        <div class="space-y-4 p-4">
            <div class="grid gap-4 sm:grid-cols-2">
                <div class="space-y-2">
                    <label for="po-number" class="text-xs font-medium">
                        PO Number
                    </label>
                    <div class="relative">
                        <LucideIconCn Name="file-text" Size="16" Class="absolute top-2.5 left-2.5 size-4 text-muted-foreground" />
                        <InputCn id="po-number" Placeholder="e.g. PO-2026-1234" Class="pl-9 h-9 text-sm" />
                    </div>
                </div>
                <div class="space-y-2">
                    <label for="tax-id" class="text-xs font-medium">
                        Tax / VAT ID
                    </label>
                    <div class="relative">
                        <LucideIconCn Name="building" Size="16" Class="absolute top-2.5 left-2.5 size-4 text-muted-foreground" />
                        <InputCn id="tax-id" Placeholder="e.g. US123456789" Class="pl-9 h-9 text-sm" />
                    </div>
                </div>
            </div>

            <div class="space-y-2">
                <label for="billing-email" class="text-xs font-medium">
                    Billing Contact Email
                </label>
                <div class="relative">
                    <LucideIconCn Name="mail" Size="16" Class="absolute top-2.5 left-2.5 size-4 text-muted-foreground" />
                    <InputCn id="billing-email" type="email" Placeholder="@("accounting@company.com")" Class="pl-9 h-9 text-sm" />
                </div>
            </div>

            <div class="flex items-start gap-2.5 rounded-md bg-muted/50 p-3">
                <LucideIconCn Name="info" Size="16" Class="mt-0.5 size-4 text-muted-foreground" />
                <p class="text-muted-foreground text-xs leading-relaxed">
                    Purchase orders are processed manually. Once saved, these details will appear on all
                    future invoices. For immediate access to Pro features, please use a credit card.
                </p>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center justify-end border-t bg-muted/30 px-4 py-3">
            <div class="flex items-center gap-3">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm">
                    Cancel
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm">Save PO Details</ButtonCn>
            </div>
        </div>
    </div>
</section>
