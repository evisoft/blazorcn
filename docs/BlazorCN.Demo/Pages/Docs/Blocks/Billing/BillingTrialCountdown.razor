@* ============================================================
   Block: billing-trial-countdown
   Title: BillingTrialCountdown
   Description: A high-urgency trial status and conversion block featuring animated countdowns, benefit reminders, and seamless upgrade transitions built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-trial-countdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Trial Status</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-amber-500/10 text-amber-600 border-amber-500/20 text-[10px] uppercase font-bold tracking-tight px-1.5">
                    @_daysRemaining Days Left
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your Pro trial ends soon. Upgrade now to keep your premium features and custom domain
                active.
            </p>
        </div>

        @* Countdown + Usage *@
        <div class="p-4 space-y-6">
            <div class="flex items-center justify-center py-4">
                <div class="text-center">
                    <div class="flex items-baseline justify-center gap-1.5">
                        <span class="text-6xl font-bold tracking-tighter">@_daysRemaining</span>
                        <span class="text-xl font-medium text-muted-foreground uppercase tracking-widest">
                            Days
                        </span>
                    </div>
                    <p class="text-xs text-muted-foreground mt-2 uppercase font-bold tracking-widest">
                        Remaining in Trial
                    </p>
                </div>
            </div>

            <div class="space-y-3 rounded-lg bg-muted/30 p-4 border border-dashed">
                <div class="flex items-center justify-between text-[10px] uppercase font-bold tracking-widest text-muted-foreground">
                    <span class="flex items-center gap-1.5">
                        <LucideIconCn Name="zap" Size="12" Class="size-3" />
                        Trial Feature Usage
                    </span>
                    <span>@_trialUsage%</span>
                </div>
                <ProgressCn Value="@_trialUsage" Class="h-1.5" aria-label="Progress" />
                <p class="text-[11px] text-muted-foreground leading-relaxed">
                    You&apos;ve used most of your trial credits. Upgrading now ensures uninterrupted
                    service for your team.
                </p>
            </div>

            <div class="grid gap-3 pt-2">
                <ButtonCn Class="w-full h-10 gap-2 font-semibold">
                    <LucideIconCn Name="sparkles" Size="16" Class="size-4" />
                    Upgrade to Pro Plan
                </ButtonCn>
                <p class="text-center text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
                    No charges until your trial officially ends on April 27
                </p>
            </div>
        </div>

        @* Footer Features *@
        <div class="bg-muted/50 border-t px-4 py-2.5 flex items-center justify-center gap-6">
            @foreach (var feature in _features)
            {
                <div class="flex items-center gap-1.5">
                    <div class="size-1 rounded-full bg-emerald-500"></div>
                    <span class="text-[10px] text-muted-foreground font-medium uppercase tracking-wider">
                        @feature
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private readonly int _daysRemaining = 3;
    private readonly int _trialUsage = 65;
    private static readonly string[] _features = ["Custom Domains", "API Access", "SSO Login"];
}
