@* ============================================================
   Block: billing-contact-support
   Title: BillingContactSupport
   Description: A bespoke billing assistance block for React and Next.js with priority support indicators, common FAQ links, and direct contact actions built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-contact-support.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="life-buoy" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Need Help with Billing?</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] uppercase">
                Priority Support
            </BadgeCn>
        </div>

        @* Content *@
        <div class="px-4 py-6">
            <h3 class="font-medium text-sm">Have a question about your invoice or plan?</h3>
            <p class="mt-1 text-muted-foreground text-sm">
                Our dedicated billing team is available 24/7 to help you with refunds, tax exemptions,
                or custom enterprise quotes.
            </p>

            <div class="mt-8 grid grid-cols-1 gap-3 sm:grid-cols-2">
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-20 flex-col gap-1 items-start px-4">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="text-xs font-semibold">Email Support</span>
                    </div>
                    <p class="text-[10px] text-muted-foreground text-left leading-normal">
                        Typical response in <span class="text-foreground">under 2 hours</span>
                    </p>
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-20 flex-col gap-1 items-start px-4">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="text-xs font-semibold">Live Chat</span>
                    </div>
                    <p class="text-[10px] text-muted-foreground text-left leading-normal">
                        Available <span class="text-foreground">9am - 5pm EST</span>
                    </p>
                </ButtonCn>
            </div>
        </div>

        @* FAQ Links *@
        <div class="divide-y border-t bg-muted/10">
            <div class="flex items-center justify-between px-4 py-2.5 hover:bg-muted/30 transition-colors cursor-pointer group">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="help-circle" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs">How do I update my VAT ID?</span>
                </div>
                <LucideIconCn Name="external-link" Size="12" Class="size-3 text-muted-foreground/30 group-hover:text-muted-foreground transition-colors" />
            </div>
            <div class="flex items-center justify-between px-4 py-2.5 hover:bg-muted/30 transition-colors cursor-pointer group">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="help-circle" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs">Can I get a refund for unused seats?</span>
                </div>
                <LucideIconCn Name="external-link" Size="12" Class="size-3 text-muted-foreground/30 group-hover:text-muted-foreground transition-colors" />
            </div>
        </div>

        @* Footer *@
        <div class="bg-muted/30 px-4 py-2 text-center border-t">
            <p class="text-[10px] text-muted-foreground">
                View full Help Center · Billing Policy
            </p>
        </div>
    </div>
</section>
