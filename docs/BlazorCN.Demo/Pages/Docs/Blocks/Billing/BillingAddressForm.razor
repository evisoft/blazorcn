@* ============================================================
   Block: billing-address-form
   Title: BillingAddressForm
   Description: A clean billing address and tax ID form for React and Next.js with borderless inputs, country selection, and 'Save Changes' actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-address-form.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="building" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Billing Information</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Update your company details and tax ID. These details will appear on all future
                invoices and receipts.
            </p>
        </div>

        @* Form Sections *@
        <div class="divide-y">
            @* Company & Tax ID *@
            <div class="grid grid-cols-2 divide-x">
                <div class="px-4 py-3">
                    <label for="companyName" class="mb-1 block text-muted-foreground text-[10px] font-medium uppercase tracking-wider">
                        Company Name
                    </label>
                    <InputCn id="companyName" Placeholder="Acme Inc." Class="h-7 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0 text-sm" />
                </div>
                <div class="px-4 py-3">
                    <label for="taxId" class="mb-1 block text-muted-foreground text-[10px] font-medium uppercase tracking-wider">
                        Tax ID / VAT
                    </label>
                    <InputCn id="taxId" Placeholder="US123456789" Class="h-7 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0 text-sm" />
                </div>
            </div>

            @* Address Line 1 *@
            <div class="px-4 py-3">
                <label for="address1" class="mb-1 block text-muted-foreground text-[10px] font-medium uppercase tracking-wider">
                    Address Line 1
                </label>
                <InputCn id="address1" Placeholder="123 Tech Lane" Class="h-7 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0 text-sm" />
            </div>

            @* City & Country *@
            <div class="grid grid-cols-2 divide-x">
                <div class="px-4 py-3">
                    <label for="city" class="mb-1 block text-muted-foreground text-[10px] font-medium uppercase tracking-wider">
                        City
                    </label>
                    <InputCn id="city" Placeholder="San Francisco" Class="h-7 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0 text-sm" />
                </div>
                <div class="px-4 py-3">
                    <label for="country" class="mb-1 block text-muted-foreground text-[10px] font-medium uppercase tracking-wider">
                        Country
                    </label>
                    <SelectCn @bind-Value="_country">
                        <SelectTriggerCn id="country" Class="h-7 border-0 bg-transparent px-0 shadow-none focus:ring-0 text-sm font-normal">
                            <SelectValueCn Placeholder="Select country" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="us">United States</SelectItemCn>
                            <SelectItemCn Value="uk">United Kingdom</SelectItemCn>
                            <SelectItemCn Value="ca">Canada</SelectItemCn>
                            <SelectItemCn Value="de">Germany</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Footer Action *@
        <div class="flex items-center justify-between px-4 py-3">
            <div class="flex items-center gap-2 text-muted-foreground text-[10px]">
                <LucideIconCn Name="globe" Size="12" Class="size-3" />
                <span>Updates sync with your primary workspace</span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs" @onclick="HandleSave" Disabled="@_loading">
                @if (_loading)
                {
                    <span>Saving...</span>
                }
                else
                {
                    <LucideIconCn Name="save" Size="12" Class="size-3" />
                    <span>Save Changes</span>
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _loading = false;
    private string _country = "us";

    private async Task HandleSave()
    {
        _loading = true;
        await Task.Delay(1500);
        _loading = false;
    }
}
