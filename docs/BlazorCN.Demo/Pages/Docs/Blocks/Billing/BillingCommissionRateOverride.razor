@* ============================================================
   Block: billing-commission-rate-override
   Title: BillingCommissionRateOverride
   Description: A specialized admin billing block for React and Next.js to manage custom commission rates and partner-specific overrides built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-commission-rate-override.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Partner Rate Override</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs text-amber-600 border-amber-200 bg-amber-50">
                Admin Only
            </BadgeCn>
        </div>

        @* Partner Info *@
        <div class="flex items-center gap-3 border-b px-4 py-4 bg-muted/30">
            <div class="flex size-8 items-center justify-center rounded-full bg-background border">
                <LucideIconCn Name="user" Size="16" Class="size-4 text-muted-foreground" />
            </div>
            <div>
                <p class="font-medium text-sm leading-none">Alex Rivera</p>
                <p class="text-muted-foreground text-xs mt-1">ID: partner_88291 • Standard Tier (10%)</p>
            </div>
        </div>

        @* Rate Input *@
        <div class="border-b px-4 py-6">
            <div class="flex items-center justify-between gap-8">
                <div class="flex-1 space-y-1.5">
                    <LabelCn For="commission-rate" Class="text-sm">Override Commission Rate</LabelCn>
                    <p class="text-muted-foreground text-xs">
                        Enter the custom percentage for this partner. This will override the global default.
                    </p>
                </div>
                <div class="relative w-24">
                    <InputCn id="commission-rate" @bind-Value="@_rateStr" Class="pr-8 text-right font-mono" />
                    <span class="absolute right-3 top-1/2 -translate-y-1/2 text-muted-foreground text-sm">%</span>
                </div>
            </div>

            <div class="mt-6 flex items-center justify-between rounded-md border border-dashed p-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="info" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">New Effective Rate</span>
                </div>
                <div class="flex items-baseline gap-0.5">
                    <span class="font-semibold text-lg">@_rate</span>
                    <span class="text-muted-foreground text-xs">%</span>
                </div>
            </div>
        </div>

        @* Settings *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div class="space-y-0.5">
                    <LabelCn Class="text-sm">Permanent Override</LabelCn>
                    <p class="text-muted-foreground text-xs">If disabled, this rate will expire in 30 days.</p>
                </div>
                <SwitchCn aria-label="Permanent Override" @bind-Checked="@_isPermanent" />
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                <LucideIconCn Name="check" Size="12" Class="size-3" />
                Apply Override
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs text-muted-foreground">
                Cancel
            </ButtonCn>
            <p class="ml-auto text-muted-foreground text-[10px] uppercase tracking-wider">
                Last modified by Admin
            </p>
        </div>
    </div>
</section>

@code {
    private int _rate = 15;
    private bool _isPermanent = true;

    private string _rateStr
    {
        get => _rate.ToString();
        set { if (int.TryParse(value, out var n)) _rate = n; }
    }
}
