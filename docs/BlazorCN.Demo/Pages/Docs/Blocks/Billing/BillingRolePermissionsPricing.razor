@* ============================================================
   Block: billing-role-permissions-pricing
   Title: BillingRolePermissionsPricing
   Description: A billing security block for React and Next.js that visualizes feature access across different team roles built with shadcn/ui and Framer Motion.
   Source: original/blocks/billing/billing-role-permissions-pricing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Billing Roles &amp; Permissions</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Control who can view, manage, and pay for your subscription.
            </p>
        </div>

        @* Permissions Matrix *@
        <div class="overflow-x-auto">
            <table class="w-full border-collapse text-left">
                <thead>
                    <tr class="bg-muted/30">
                        <th class="px-4 py-2.5 text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                            Feature
                        </th>
                        @foreach (var role in _roles)
                        {
                            <th class="px-4 py-2.5 text-center text-xs font-semibold text-muted-foreground uppercase tracking-wider">
                                @role
                            </th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y">
                    @foreach (var feature in _features)
                    {
                        <tr class="transition-colors hover:bg-muted/50">
                            <td class="px-4 py-3 text-sm font-medium">@feature.Name</td>
                            @foreach (var hasAccess in feature.Access)
                            {
                                <td class="px-4 py-3 text-center">
                                    <div class="flex justify-center">
                                        @if (hasAccess)
                                        {
                                            <div class="rounded-full bg-emerald-500/10 p-0.5">
                                                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                                            </div>
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="minus" Size="14" Class="size-3.5 text-muted-foreground/30" />
                                        }
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Footer *@
        <div class="bg-muted/20 px-4 py-3 border-t">
            <div class="flex items-center gap-4 text-xs text-muted-foreground">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="users" Size="14" Class="size-3.5" />
                    <span>Need custom roles?</span>
                </div>
                <a href="/enterprise" class="text-foreground font-medium hover:underline">
                    Contact Enterprise Sales
                </a>
            </div>
        </div>
    </div>
</section>

@code {
    private record Feature(string Name, bool[] Access);

    private static readonly string[] _roles = ["Admin", "Billing", "Member"];

    private static readonly Feature[] _features =
    [
        new("View Invoices", [true, true, true]),
        new("Download Receipts", [true, true, true]),
        new("Manage Plan", [true, true, false]),
        new("Update Payment Method", [true, true, false]),
        new("Invite Team Members", [true, false, false]),
        new("Delete Workspace", [true, false, false]),
    ];
}
