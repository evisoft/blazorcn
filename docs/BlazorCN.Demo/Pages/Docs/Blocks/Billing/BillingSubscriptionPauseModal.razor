@* ============================================================
   Block: billing-subscription-pause-modal
   Title: BillingSubscriptionPauseModal
   Description: A subscription management modal for pausing services with duration selection and impact preview built with shadcn/ui and Framer Motion
   Source: original/blocks/billing/billing-subscription-pause-modal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div>
        <CardCn Class="border-2 border-primary/10 shadow-xl">
            <CardHeaderCn>
                <div class="flex items-center gap-3">
                    <div class="flex size-10 items-center justify-center rounded-full bg-primary/10 text-primary">
                        <LucideIconCn Name="coffee" Size="20" Class="size-5" />
                    </div>
                    <div>
                        <CardTitleCn Class="text-xl">Take a break?</CardTitleCn>
                        <CardDescriptionCn>Pause your subscription instead of cancelling.</CardDescriptionCn>
                    </div>
                </div>
            </CardHeaderCn>
            <CardContentCn Class="space-y-6">
                <div class="rounded-lg bg-muted/50 p-4 text-sm">
                    <div class="flex gap-3">
                        <LucideIconCn Name="info" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                        <p class="text-muted-foreground leading-relaxed">
                            Your data and settings will be saved. You won't be charged during the pause period,
                            and you can resume at any time.
                        </p>
                    </div>
                </div>

                <div class="space-y-4">
                    <LabelCn Class="text-base">How long should we pause?</LabelCn>
                    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                        @foreach (var option in _options)
                        {
                            var opt = option;
                            <label class="@Cn.Merge("flex cursor-pointer flex-col items-center justify-between rounded-lg border-2 bg-popover p-4 hover:bg-accent hover:text-accent-foreground", _months == opt.Value ? "border-primary" : "border-muted")"
                                   @onclick="@(() => _months = opt.Value)">
                                <LucideIconCn Name="calendar" Size="20" Class="mb-2 size-5" />
                                <span class="font-semibold">@opt.Label</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="flex items-center justify-between rounded-md border border-dashed p-3 text-sm">
                    <span class="text-muted-foreground">Auto-resumes on:</span>
                    <span class="font-medium">@GetResumeDate(_months)</span>
                </div>
            </CardContentCn>
            <CardFooterCn Class="flex flex-col gap-3 sm:flex-row">
                <ButtonCn Class="w-full gap-2 sm:flex-1">
                    <LucideIconCn Name="play-circle" Size="16" Class="size-4" />
                    Confirm Pause
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="w-full sm:w-auto">
                    Keep Active
                </ButtonCn>
            </CardFooterCn>
        </CardCn>
    </div>
</section>

@code {
    private string _months = "1";

    private record PauseOption(string Label, string Value);

    private static readonly PauseOption[] _options =
    [
        new("1 Month", "1"),
        new("2 Months", "2"),
        new("3 Months", "3"),
    ];

    private string GetResumeDate(string m)
    {
        var date = DateTime.Now.AddMonths(int.Parse(m));
        return date.ToString("MMMM d, yyyy");
    }
}
