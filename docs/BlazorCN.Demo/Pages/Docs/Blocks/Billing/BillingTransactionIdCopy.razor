@* ============================================================
   Block: billing-transaction-id-copy
   Title: BillingTransactionIdCopy
   Description: A utility-focused billing block for easily retrieving and copying complex transaction identifiers (Stripe IDs, Bank references) featuring toast notifications and security-first design built with shadcn/ui.
   Source: original/blocks/billing/billing-transaction-id-copy.tsx
   ============================================================ *@

@inject IJSRuntime JS

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="hash" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Reference Details</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Use this unique identifier if you need to contact support regarding this specific
                payment.
            </p>
        </div>

        <div class="p-4 space-y-4">
            <div class="space-y-2">
                <label for="transaction-id" class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                    Stripe Transaction ID
                </label>
                <div class="group relative flex items-center justify-between rounded-md border bg-muted/20 p-2.5 transition-colors hover:bg-muted/30">
                    <code id="transaction-id" class="font-mono text-xs text-foreground tracking-tight truncate mr-8">
                        @_transactionId
                    </code>
                    <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="absolute right-1 size-7 shrink-0 opacity-100 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity" OnClick="HandleCopy">
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="12" Class="size-3 text-muted-foreground" />
                        }
                        <span class="sr-only">Copy ID</span>
                    </ButtonCn>
                </div>
            </div>

            <div class="rounded-md bg-muted/50 p-3 border border-dashed flex gap-3">
                <LucideIconCn Name="info" Size="14" Class="size-3.5 text-blue-500 shrink-0 mt-0.5" />
                <div class="space-y-1">
                    <p class="text-[11px] font-medium">Reconciling your statement?</p>
                    <p class="text-[10px] text-muted-foreground leading-relaxed">
                        This ID will appear on your bank statement as <span class="font-mono text-foreground font-semibold">ACME*PI_3P4X2</span>.
                        Matching these ensures your records are accurate.
                    </p>
                </div>
            </div>
        </div>

        <div class="bg-muted/50 border-t px-4 py-2 text-center">
            <p class="text-[10px] text-muted-foreground uppercase tracking-widest font-medium">
                Generated on March 24, 2026 at 14:32 UTC
            </p>
        </div>
    </div>
</section>

@code {
    private readonly string _transactionId = "pi_3P4x2Z2eZvKYlo2C1A5bN9r7";
    private bool _copied = false;

    private async Task HandleCopy()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _transactionId);
        _copied = true;
        await Task.Delay(2000);
        _copied = false;
    }
}
