@* ============================================================
   Block: billing-subscription-tier-benefits
   Title: BillingSubscriptionTierBenefits
   Description: A clear and persuasive plan comparison component for React and Next.js highlighting the unique features and value of each subscription tier built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-subscription-tier-benefits.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="px-4 py-5 text-center border-b">
            <h2 class="text-lg font-semibold tracking-tight">Choose your growth path</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Transparent pricing for every stage of your company.
            </p>
        </div>

        @* Tiers Grid *@
        <div class="grid grid-cols-3 divide-x border-b">
            @foreach (var tier in _tiers)
            {
                <div class="@Cn.Merge("flex flex-col px-4 py-6", tier.Featured ? "bg-muted/30" : "")">
                    <div class="mb-4 flex items-center justify-between">
                        <div class="rounded-md border p-1.5 bg-background">
                            <LucideIconCn Name="@tier.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                        </div>
                        @if (tier.Featured)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 px-1.5 text-[9px] font-medium uppercase tracking-tight bg-foreground text-background border-none">
                                Best Value
                            </BadgeCn>
                        }
                    </div>
                    <h3 class="text-sm font-semibold">@tier.Name</h3>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="text-xl font-bold">@tier.Price</span>
                        @if (tier.Price != "Custom")
                        {
                            <span class="text-[10px] text-muted-foreground">/mo</span>
                        }
                    </div>

                    <ul class="mt-6 space-y-3 flex-1">
                        @foreach (var feature in tier.Features)
                        {
                            <li class="flex items-start gap-2 text-[11px] leading-tight text-muted-foreground">
                                <LucideIconCn Name="check" Size="12" Class="size-3 mt-0.5 text-foreground shrink-0" />
                                @feature
                            </li>
                        }
                    </ul>

                    <ButtonCn Variant="@(tier.Featured ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="mt-6 h-8 w-full text-xs">
                        @(tier.Price == "Custom" ? "Contact Sales" : "Select Plan")
                    </ButtonCn>
                </div>
            }
        </div>

        @* Footer info *@
        <div class="flex items-center justify-between px-4 py-3 bg-muted/10">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="info" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-[11px]">
                    Prices exclude local taxes (VAT/GST)
                </span>
            </div>
            <button class="text-[11px] font-medium text-foreground hover:underline underline-offset-4">
                Full Feature List
            </button>
        </div>
    </div>
</section>

@code {
    private record Tier(string Name, string Price, string Icon, bool Featured, string[] Features);

    private static readonly Tier[] _tiers =
    [
        new("Starter", "$0", "zap", false, ["Up to 3 projects", "Basic analytics", "Community support"]),
        new("Pro", "$49", "star", true, ["Unlimited projects", "Advanced analytics", "Priority email support", "Custom domains"]),
        new("Enterprise", "Custom", "shield", false, ["SAML SSO", "Audit logs", "Dedicated manager", "99.9% uptime SLA"])
    ];
}
