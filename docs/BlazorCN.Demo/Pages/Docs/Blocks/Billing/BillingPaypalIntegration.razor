@* ============================================================
   Block: billing-paypal-integration
   Title: BillingPaypalIntegration
   Description: A specialized setup and status block for PayPal payments in React and Next.js, featuring account linking and active state indicators built with shadcn/ui.
   Source: original/blocks/billing/billing-paypal-integration.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex h-5 w-8 items-center justify-center rounded bg-[#003087] text-white">
                    <span class="text-[10px] font-bold">PP</span>
                </div>
                <span class="font-medium text-sm">PayPal Integration</span>
            </div>
        </div>

        @* Content *@
        <div class="p-4">
            @if (!_isConnected)
            {
                <div class="flex flex-col items-center py-4 text-center">
                    <div class="flex size-12 items-center justify-center rounded-full bg-muted/50">
                        <LucideIconCn Name="wallet" Size="24" Class="size-6 text-muted-foreground" />
                    </div>
                    <h3 class="mt-4 font-semibold text-sm">Connect your PayPal account</h3>
                    <p class="mt-1 text-muted-foreground text-xs leading-relaxed max-w-[280px]">
                        Use PayPal to manage your subscriptions and pay for one-time purchases securely.
                    </p>
                    <ButtonCn Class="mt-6 w-full max-w-xs gap-2 bg-[#0070BA] hover:bg-[#005EA6] text-white" @onclick="@(() => _isConnected = true)">
                        Connect with PayPal
                        <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            }
            else
            {
                <div class="flex items-center justify-between rounded-lg border border-emerald-100 bg-emerald-50/30 p-4 dark:border-emerald-900/50 dark:bg-emerald-950/20">
                    <div class="flex items-center gap-4">
                        <div class="flex size-10 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 dark:bg-emerald-900/30 dark:text-emerald-500">
                            <LucideIconCn Name="check-circle-2" Size="20" Class="size-5" />
                        </div>
                        <div class="space-y-0.5">
                            <p class="font-medium text-sm">PayPal Connected</p>
                            <p class="text-muted-foreground text-xs">@_paypalEmail</p>
                        </div>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs text-red-500 hover:text-red-600 hover:bg-red-50 dark:hover:bg-red-950/40" @onclick="@(() => _isConnected = false)">
                        Disconnect
                    </ButtonCn>
                </div>
            }
        </div>

        @* Footer *@
        <div class="bg-muted/30 px-4 py-2.5 border-t">
            <p class="text-center text-[10px] text-muted-foreground">
                Payments are processed securely via PayPal. No billing data is stored on our servers.
            </p>
        </div>
    </div>
</section>

@code {
    private bool _isConnected = false;
    private const string _paypalEmail = "alex.user@example.com";
}
