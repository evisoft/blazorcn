@* ============================================================
   Block: billing-invoice-consolidation-settings
   Title: BillingInvoiceConsolidationSettings
   Description: A professional billing configuration block for React and Next.js to manage multi-resource invoice grouping and consolidation preferences built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-invoice-consolidation-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layers" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Invoice Consolidation</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Enterprise Feature
            </BadgeCn>
        </div>

        @* Toggle Section *@
        <div class="border-b px-4 py-5">
            <div class="flex items-center justify-between">
                <div class="space-y-1">
                    <LabelCn Class="text-sm">Consolidate Multiple Streams</LabelCn>
                    <p class="text-muted-foreground text-xs">
                        Merge charges from all projects into a single itemized monthly invoice.
                    </p>
                </div>
                <SwitchCn @bind-Checked="_isEnabled" />
            </div>
        </div>

        @* Grouping Settings *@
        <div class="@Cn.Merge("border-b px-4 py-5 transition-opacity duration-300", _isEnabled ? "opacity-100" : "opacity-40 pointer-events-none")">
            <div class="flex items-center justify-between gap-4">
                <div class="space-y-1">
                    <LabelCn Class="text-sm">Primary Grouping Logic</LabelCn>
                    <p class="text-muted-foreground text-xs">Determine how line items are organized on your statement.</p>
                </div>
                <SelectCn @bind-Value="_groupBy">
                    <SelectTriggerCn Class="w-[180px] h-9 text-xs">
                        <SelectValueCn Placeholder="Select grouping" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="project" Class="text-xs">By Project ID</SelectItemCn>
                        <SelectItemCn Value="department" Class="text-xs">By Department</SelectItemCn>
                        <SelectItemCn Value="region" Class="text-xs">By Geographic Region</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Preview Visualization *@
        <div class="border-b px-4 py-6 bg-muted/30">
            <div class="flex items-center justify-center gap-12 relative">
                <div class="flex flex-col items-center gap-2">
                    <div class="size-10 rounded-md border bg-background flex items-center justify-center">
                        <LucideIconCn Name="split" Size="20" Class="size-5 text-muted-foreground" />
                    </div>
                    <span class="text-[10px] text-muted-foreground uppercase font-medium">Multiple Flows</span>
                </div>

                <div class="h-px w-24 bg-border relative">
                    <div class="@Cn.Merge("absolute inset-0 bg-primary/20 transition-transform duration-1000 origin-left", _isEnabled ? "scale-x-100" : "scale-x-0")" />
                </div>

                <div class="flex flex-col items-center gap-2">
                    <div class="@Cn.Merge("size-10 rounded-md border flex items-center justify-center transition-colors duration-300", _isEnabled ? "bg-primary border-primary text-primary-foreground" : "bg-background text-muted-foreground")">
                        <LucideIconCn Name="file-text" Size="20" Class="size-5" />
                    </div>
                    <span class="@Cn.Merge("text-[10px] uppercase font-medium transition-colors duration-300", _isEnabled ? "text-foreground" : "text-muted-foreground")">One Invoice</span>
                </div>
            </div>
        </div>

        @* Footer Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                <LucideIconCn Name="settings-2" Size="12" Class="size-3" />
                Save Preferences
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs text-muted-foreground">
                Learn more about grouping
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _isEnabled = false;
    private string _groupBy = "project";
}
