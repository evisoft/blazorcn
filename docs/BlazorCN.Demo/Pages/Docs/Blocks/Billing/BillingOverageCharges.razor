@* ============================================================
   Block: billing-overage-charges
   Title: BillingOverageCharges
   Description: A clear breakdown of resource overages and additional charges for React and Next.js, featuring usage limits and cost calculators built with shadcn/ui.
   Source: original/blocks/billing/billing-overage-charges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 text-amber-500">
                <LucideIconCn Name="alert-triangle" Size="16" Class="size-4" />
                <span class="font-medium text-sm">Overage Alert</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                You've exceeded your plan's included storage. Additional usage is billed at $@_rate/GB.
            </p>
        </div>

        @* Usage Bar *@
        <div class="px-4 py-6">
            <div class="flex items-end justify-between mb-2">
                <div>
                    <p class="text-muted-foreground text-xs font-medium uppercase tracking-wider">
                        Storage Usage
                    </p>
                    <div class="mt-1 flex items-baseline gap-1">
                        <span class="text-2xl font-semibold tabular-nums">@_used</span>
                        <span class="text-muted-foreground text-sm">/ @_limit GB</span>
                    </div>
                </div>
                <div class="text-right">
                    <span class="text-xs font-medium text-amber-600 dark:text-amber-500">
                        +@_overage GB over limit
                    </span>
                </div>
            </div>
            <ProgressCn Value="@_percentage" Class="h-2" />
        </div>

        @* Calculation *@
        <div class="grid grid-cols-2 divide-x border-t border-b bg-muted/30">
            <div class="px-4 py-4">
                <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] uppercase font-bold tracking-wider">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                    Additional Units
                </div>
                <p class="mt-1 text-lg font-semibold tabular-nums">@_overage</p>
            </div>
            <div class="px-4 py-4">
                <div class="flex items-center gap-1.5 text-muted-foreground text-[10px] uppercase font-bold tracking-wider">
                    <LucideIconCn Name="bar-chart-3" Size="12" Class="size-3" />
                    Accrued Fee
                </div>
                <p class="mt-1 text-lg font-semibold tabular-nums">$@_cost.ToString("F2")</p>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 flex items-center justify-between">
            <p class="text-muted-foreground text-xs italic">Next bill: July 1, 2026</p>
            <span class="cursor-pointer text-xs font-medium text-foreground underline-offset-4 hover:underline">
                Upgrade Plan to Save
            </span>
        </div>
    </div>
</section>

@code {
    private const int _limit = 1000;
    private const int _used = 1250;
    private const int _overage = _used - _limit;
    private const double _rate = 0.15;
    private const double _cost = _overage * _rate;
    private const double _percentage = 100.0; // Math.Min((used / limit) * 100, 100) clamps to 100
}
