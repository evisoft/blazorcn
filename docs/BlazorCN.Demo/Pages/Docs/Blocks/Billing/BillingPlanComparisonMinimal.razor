@* ============================================================
   Block: billing-plan-comparison-minimal
   Title: BillingPlanComparisonMinimal
   Description: A condensed, high-density plan comparison table for React and Next.js, focusing on key differences and rapid decision making built with shadcn/ui.
   Source: original/blocks/billing/billing-plan-comparison-minimal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid grid-cols-[1fr_100px_100px] border-b bg-muted/30 px-4 py-3">
            <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                Features
            </span>
            <span class="text-center text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                Free
            </span>
            <span class="text-center text-xs font-semibold uppercase tracking-wider text-emerald-600">
                Pro
            </span>
        </div>

        <div class="divide-y">
            @foreach (var feature in _features)
            {
                <div class="grid grid-cols-[1fr_100px_100px] px-4 py-3 items-center">
                    <span class="text-sm font-medium">@feature.Name</span>
                    <div class="flex justify-center">
                        @FeatureValue(feature.Free, false)
                    </div>
                    <div class="flex justify-center">
                        @FeatureValue(feature.Pro, true)
                    </div>
                </div>
            }
        </div>

        <div class="grid grid-cols-[1fr_100px_100px] gap-2 p-4 border-t bg-muted/10">
            <div class="flex flex-col justify-center">
                <p class="text-xs text-muted-foreground font-medium">Ready to scale?</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-[11px] font-bold uppercase">
                Start
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-[11px] font-bold uppercase bg-emerald-600 hover:bg-emerald-700">
                Upgrade
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Feature(string Name, string Free, string Pro);

    private static readonly Feature[] _features =
    [
        new("Team Members", "1", "Unlimited"),
        new("Storage", "5GB", "500GB"),
        new("Analytics", "Basic", "Advanced"),
        new("API Access", "false", "true"),
        new("Support", "Email", "24/7 Priority"),
    ];

    private RenderFragment FeatureValue(string value, bool isPro)
    {
        if (value == "true")
            return @<div class="flex justify-center">
                <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-500" />
            </div>;

        if (value == "false")
            return @<div class="flex justify-center">
                <LucideIconCn Name="minus" Size="14" Class="size-3.5 text-muted-foreground/30" />
            </div>;

        var textClass = isPro ? "text-xs font-semibold" : "text-xs text-muted-foreground";
        return @<span class="@textClass">@value</span>;
    }
}
