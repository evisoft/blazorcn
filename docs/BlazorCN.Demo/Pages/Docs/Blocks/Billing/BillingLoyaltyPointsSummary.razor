@* ============================================================
   Block: billing-loyalty-points-summary
   Title: BillingLoyaltyPointsSummary
   Description: A user-facing billing block for React and Next.js to display loyalty program status, earned points, and redemption options built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-loyalty-points-summary.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="award" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Loyalty Rewards</span>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs bg-emerald-50 text-emerald-700 border-emerald-100">
                    <LucideIconCn Name="star" Size="12" Class="size-3 mr-1 fill-emerald-600" />
                    Gold Member
                </BadgeCn>
            </div>
        </div>

        @* Points Display *@
        <div class="flex flex-col items-center justify-center border-b px-4 py-8 text-center">
            <div class="flex items-center gap-1 text-muted-foreground text-xs uppercase tracking-widest mb-1">
                <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                <span>Available Points</span>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="font-bold text-5xl tracking-tighter">
                    @_points.ToString("N0")
                </span>
                <span class="text-muted-foreground font-medium">pts</span>
            </div>
            <p class="mt-4 text-muted-foreground text-sm max-w-[280px]">
                You're earning 5 points for every $1 spent on your Pro subscription.
            </p>
        </div>

        @* Progress Section *@
        <div class="border-b px-4 py-5">
            <div class="mb-3 flex items-center justify-between text-xs">
                <span class="font-medium text-muted-foreground">Next Tier: Platinum</span>
                <span class="text-muted-foreground">
                    @_points.ToString("N0") / @_nextTier.ToString("N0")
                </span>
            </div>
            <ProgressCn Value="@_progress" Class="h-1.5" />
            <p class="mt-3 text-muted-foreground text-xs">
                Earn <span class="text-foreground font-medium">1,550 more points</span> to unlock exclusive 24/7 priority support and beta feature access.
            </p>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                <LucideIconCn Name="gift" Size="12" Class="size-3" />
                Redeem Points
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                Rewards Catalog
            </ButtonCn>
            <p class="ml-auto text-muted-foreground text-[10px] uppercase tracking-wider">
                Points expire in 12 months
            </p>
        </div>
    </div>
</section>

@code {
    private const int _points = 8450;
    private const int _nextTier = 10000;
    private double _progress => (double)_points / _nextTier * 100;
}
