@* ============================================================
   Block: billing-early-access-pricing
   Title: BillingEarlyAccessPricing
   Description: A billing early access and introductory pricing block for React and Next.js with exclusive tier highlights and limited-time offer styling built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-early-access-pricing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-xl border bg-card shadow-lg">
        <div class="absolute top-0 right-0 p-4">
            <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-primary/5 text-primary border-primary/20 gap-1.5">
                <span class="relative flex h-1.5 w-1.5">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-primary opacity-75"></span>
                    <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-primary"></span>
                </span>
                Early Access
            </BadgeCn>
        </div>

        <div class="px-6 py-8">
            <div class="flex items-center gap-2.5">
                <div class="flex size-10 items-center justify-center rounded-lg bg-primary text-primary-foreground shadow-sm">
                    <LucideIconCn Name="rocket" Size="20" Class="size-5" />
                </div>
                <div>
                    <h2 class="font-semibold text-xl tracking-tight">Founders Edition</h2>
                    <p class="text-muted-foreground text-sm">
                        Exclusive introductory pricing for our first 500 users.
                    </p>
                </div>
            </div>

            <div class="mt-8 flex items-baseline gap-2">
                <span class="text-4xl font-bold tracking-tight">$19</span>
                <div class="flex flex-col">
                    <span class="text-muted-foreground line-through text-sm">$49</span>
                    <span class="text-muted-foreground text-xs font-medium">
                        per month / billed annually
                    </span>
                </div>
            </div>

            <div class="mt-8 grid gap-4 sm:grid-cols-2">
                <div class="flex items-start gap-3">
                    <div class="mt-0.5 rounded-full bg-emerald-500/10 p-1 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="lock" Size="14" Class="size-3.5" />
                    </div>
                    <div class="space-y-0.5">
                        <p class="font-medium text-xs">Price Locked Forever</p>
                        <p class="text-muted-foreground text-[11px]">
                            Your rate will never increase as we grow.
                        </p>
                    </div>
                </div>
                <div class="flex items-start gap-3">
                    <div class="mt-0.5 rounded-full bg-blue-500/10 p-1 text-blue-600 dark:text-blue-400">
                        <LucideIconCn Name="users" Size="14" Class="size-3.5" />
                    </div>
                    <div class="space-y-0.5">
                        <p class="font-medium text-xs">142 Spots Remaining</p>
                        <p class="text-muted-foreground text-[11px]">
                            Limited to the first 500 customers.
                        </p>
                    </div>
                </div>
            </div>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <ButtonCn Size="ButtonSize.Lg" Class="w-full sm:flex-1 h-11 text-sm font-medium">
                    Secure Early Access
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Lg" Variant="ButtonVariant.Outline" Class="w-full sm:flex-1 h-11 text-sm font-medium">
                    View Roadmap
                </ButtonCn>
            </div>
        </div>

        <div class="border-t bg-muted/30 px-6 py-3">
            <div class="flex items-center justify-center gap-4 text-muted-foreground text-xs">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="calendar" Size="14" Class="size-3.5" />
                    <span>Offer expires June 30</span>
                </div>
                <div class="h-3 w-px bg-border"></div>
                <span>No credit card required for beta</span>
            </div>
        </div>
    </div>
</section>
