@* ============================================================
   Block: billing-revenue-share-calculator
   Title: BillingRevenueShareCalculator
   Description: A professional revenue share and partner payout calculator for React and Next.js, featuring real-time estimation, tiered percentage visualization, and total earnings preview built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-revenue-share-calculator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calculator" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Revenue Share Estimator</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Affiliate Partner
            </BadgeCn>
        </div>

        @* Slider Section *@
        <div class="border-b px-4 py-6">
            <div class="mb-4 flex items-center justify-between">
                <span class="text-muted-foreground text-sm">Estimated Monthly Revenue</span>
                <span class="font-mono font-medium text-lg">$@(((int)_revenue).ToString("N0"))</span>
            </div>
            <SliderCn @bind-Value="_revenue"
                      Max="100000"
                      Step="1000"
                      aria-label="Estimated monthly revenue"
                      Class="py-4" />
            <p class="mt-2 text-muted-foreground text-xs italic">
                Adjust the slider to see how your earnings grow with higher monthly referral revenue.
            </p>
        </div>

        @* Tiers Preview *@
        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-4">
                <div class="mb-1 flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="percent" Size="12" Class="size-3" />
                    <span>Commission Rate</span>
                </div>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tracking-tight">@((Rate * 100).ToString("0"))</span>
                    <span class="text-muted-foreground text-sm">%</span>
                </div>
            </div>
            <div class="px-4 py-4">
                <div class="mb-1 flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                    <span>Monthly Payout</span>
                </div>
                <div class="flex items-baseline gap-1">
                    <span class="text-muted-foreground text-sm">$</span>
                    <span class="font-semibold text-2xl tracking-tight">@Payout.ToString("N0")</span>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                Apply to Program
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                View Tiers
            </ButtonCn>
            <p class="ml-auto text-muted-foreground text-[10px] uppercase tracking-wider">
                Estimates only
            </p>
        </div>

    </div>
</section>

@code {
    private double _revenue = 25000;

    private double Rate => CalculateCommission(_revenue);
    private double Payout => _revenue * Rate;

    private static double CalculateCommission(double val)
    {
        if (val <= 10000) return 0.1;
        if (val <= 50000) return 0.15;
        return 0.2;
    }
}
