@* ============================================================
   Block: billing-billing-incident-notice
   Title: BillingBillingIncidentNotice
   Description: A high-visibility status and alert block for React and Next.js to communicate billing system incidents and maintenance to users built with shadcn/ui and framer-motion.
   Source: original/blocks/billing/billing-billing-incident-notice.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border-2 border-amber-200 bg-amber-50/50 dark:border-amber-900/50 dark:bg-amber-950/20">
        @* Header *@
        <div class="flex items-center justify-between border-b border-amber-100 px-4 py-2.5 dark:border-amber-900/30">
            <div class="flex items-center gap-2">
                <div class="relative flex size-2 items-center justify-center">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber-400 opacity-75"></span>
                    <span class="relative inline-flex size-1.5 rounded-full bg-amber-500"></span>
                </div>
                <span class="font-semibold text-[11px] uppercase tracking-wider text-amber-900 dark:text-amber-100">System Notice</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-bold text-[10px] uppercase h-5 px-1.5 border-amber-200 text-amber-700 bg-amber-100 dark:bg-amber-900/30 dark:text-amber-400 dark:border-amber-800">
                @_incidentStatus
            </BadgeCn>
        </div>

        @* Content *@
        <div class="px-4 py-5 flex items-start gap-4">
            <div class="flex size-9 shrink-0 items-center justify-center rounded-full bg-amber-100 dark:bg-amber-900/40">
                <LucideIconCn Name="shield-alert" Size="20" Class="size-5 text-amber-700 dark:text-amber-400" />
            </div>
            <div class="space-y-1.5">
                <h3 class="font-semibold text-amber-900 dark:text-amber-100 leading-none">@_incidentTitle</h3>
                <p class="text-amber-800/80 dark:text-amber-400/80 text-xs leading-relaxed">
                    We are currently investigating reports of intermittent failures when adding new payment methods. Existing subscriptions and renewals are unaffected.
                </p>
                <div class="flex items-center gap-1.5 pt-1">
                    <LucideIconCn Name="info" Size="12" Class="size-3 text-amber-600/60" />
                    <span class="text-[10px] font-medium text-amber-700/60 dark:text-amber-500/60 uppercase">Last updated @_lastUpdate</span>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3 border-t border-amber-100 dark:border-amber-900/30 bg-amber-100/30 dark:bg-black/20">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-amber-800 dark:text-amber-300 hover:bg-amber-200/50 dark:hover:bg-amber-800/30 text-xs font-semibold px-2">
                View Status Page
                <LucideIconCn Name="external-link" Size="12" Class="size-3 ml-1.5" />
            </ButtonCn>
            <div class="ml-auto flex items-center gap-2">
                <span class="text-[10px] text-amber-700/60 dark:text-amber-500/60 font-medium italic">We appreciate your patience.</span>
            </div>
        </div>
    </div>

    @* Inline Help *@
    <div class="mt-3 px-4 py-3 rounded-lg border bg-muted/30 flex items-center justify-between">
        <div class="flex items-center gap-2 text-muted-foreground">
            <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5" />
            <span class="text-xs">Need to complete an urgent payment?</span>
        </div>
        <ButtonCn Variant="ButtonVariant.Link" Size="ButtonSize.Sm" Class="h-auto p-0 text-xs gap-1">
            Contact Support
            <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
        </ButtonCn>
    </div>
</section>

@code {
    private readonly string _incidentTitle = "Degraded Payment Processing";
    private readonly string _incidentStatus = "Investigating";
    private readonly string _lastUpdate = "14 minutes ago";
}
