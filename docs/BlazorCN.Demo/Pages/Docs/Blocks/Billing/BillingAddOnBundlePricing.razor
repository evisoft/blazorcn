@* ============================================================
   Block: billing-add-on-bundle-pricing
   Title: BillingAddOnBundlePricing
   Description: A multi-select add-on management block for React and Next.js featuring bundle discounts, itemized costs, and dynamic totals built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-add-on-bundle-pricing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Bundle Add-ons</span>
            </div>
            @if (DiscountRate > 0)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-semibold text-[10px] uppercase bg-emerald-50 text-emerald-700 border-emerald-200 animate-pulse">
                    <LucideIconCn Name="sparkles" Size="12" Class="size-3 mr-1" />
                    @((int)(DiscountRate * 100))% Bundle Discount Applied
                </BadgeCn>
            }
        </div>

        @* Add-on List *@
        <div class="p-4 space-y-3">
            @foreach (var addon in _addOns)
            {
                var isSelected = _selected.Contains(addon.Id);
                <div class="@Cn.Merge("group flex items-center justify-between p-4 rounded-md border transition-all cursor-pointer", isSelected ? "border-primary bg-primary/5 shadow-sm" : "hover:border-muted-foreground/20")"
                     @onclick="@(() => ToggleAddOn(addon.Id))">
                    <div class="flex-1 pr-4">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("font-semibold text-sm", isSelected ? "text-primary" : "text-foreground")">@addon.Name</span>
                            @if (isSelected)
                            {
                                <LucideIconCn Name="check" Size="14" Class="size-3.5 text-primary" />
                            }
                        </div>
                        <p class="text-muted-foreground text-xs mt-0.5">@addon.Description</p>
                    </div>
                    <div class="flex flex-col items-end gap-2 shrink-0">
                        <span class="font-mono text-sm font-medium">$@addon.Price/mo</span>
                        <ButtonCn Variant="@(isSelected ? ButtonVariant.Secondary : ButtonVariant.Outline)"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 w-20 text-[10px] uppercase font-bold tracking-wider">
                            @(isSelected ? "Remove" : "Add")
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Summary *@
        <div class="px-6 py-5 bg-muted/10 border-t space-y-2">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span>Subtotal (@_selected.Count items)</span>
                <span class="tabular-nums">$@Subtotal</span>
            </div>
            @if (Discount > 0)
            {
                <div class="flex items-center justify-between text-xs text-emerald-600 font-medium">
                    <span>Bundle Savings (@((int)(DiscountRate * 100))%)</span>
                    <span class="tabular-nums">- $@Discount</span>
                </div>
            }
            <div class="flex items-center justify-between pt-2 border-t mt-2">
                <span class="font-semibold text-sm">Monthly Add-on Total</span>
                <div class="flex items-baseline gap-1">
                    <span class="text-sm font-medium">$</span>
                    <span class="text-2xl font-bold tracking-tight">@Total.ToString("F2")</span>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3 border-t">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs w-full sm:w-auto" Disabled="@(_selected.Count == 0)">
                Update Bundle
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs text-muted-foreground ml-auto hidden sm:flex">
                Restore Defaults
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record AddOnItem(string Id, string Name, int Price, string Description);

    private static readonly AddOnItem[] _addOns =
    [
        new("ai", "AI Power-up", 25, "Unlimited AI generations and premium models."),
        new("sso", "Enterprise SSO", 49, "SAML and OIDC integration for your team."),
        new("audit", "Audit Logs", 15, "365-day history of all account activity."),
        new("support", "Priority Support", 30, "24/7 dedicated slack channel and 1h response."),
    ];

    private List<string> _selected = ["ai"];

    private int Subtotal => _addOns.Where(a => _selected.Contains(a.Id)).Sum(a => a.Price);
    private double DiscountRate => _selected.Count >= 3 ? 0.2 : _selected.Count >= 2 ? 0.1 : 0;
    private double Discount => Subtotal * DiscountRate;
    private double Total => Subtotal - Discount;

    private void ToggleAddOn(string id)
    {
        if (_selected.Contains(id))
            _selected.Remove(id);
        else
            _selected.Add(id);
    }
}
