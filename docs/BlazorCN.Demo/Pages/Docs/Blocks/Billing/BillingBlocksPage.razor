@code {
    private record UsagePeriod(string Period, string Total, string Status, int[] Trend);

    private static readonly UsagePeriod[] _usageData =
    [
        new(""Mar 1 - Mar 31"", ""8,240 reqs"", ""normal"", [10, 25, 15, 40, 35, 60, 45]),
        new(""Feb 1 - Feb 28"", ""12,100 reqs"", ""warning"", [30, 45, 80, 95, 85, 70, 60]),
        new(""Jan 1 - Jan 31"", ""15,400 reqs"", ""critical"", [40, 60, 90, 120, 110, 130, 140]),
    ];

    private static string StatusColor(string status) => status switch
    {
        ""normal"" => ""bg-emerald-500"",
        ""warning"" => ""bg-amber-500"",
        ""critical"" => ""bg-red-500"",
        _ => ""bg-muted-foreground""
    };

    private static string GetSparklinePoints(int[] values)
    {
        if (values.Length < 2) return """";
        var min = values.Min();
        var max = values.Max();
        var range = max == min ? 1.0 : (double)(max - min);
        const double w = 96.0, h = 32.0, pad = 2.0;
        var sb = new System.Text.StringBuilder();
        for (var i = 0; i < values.Length; i++)
        {
            var x = pad + i * (w - 2 * pad) / (values.Length - 1);
            var y = h - pad - (values[i] - min) / range * (h - 2 * pad);
            if (i > 0) sb.Append(' ');
            sb.Append(FormattableString.Invariant($""{x:F1},{y:F1}""));
        }
        return sb.ToString();
    }
}
";

