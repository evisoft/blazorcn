@code {
    private record AddOnItem(string Id, string Name, int Price, string Description);

    private static readonly AddOnItem[] _addOns =
    [
        new(""ai"", ""AI Power-up"", 25, ""Unlimited AI generations and premium models.""),
        new(""sso"", ""Enterprise SSO"", 49, ""SAML and OIDC integration for your team.""),
        new(""audit"", ""Audit Logs"", 15, ""365-day history of all account activity.""),
        new(""support"", ""Priority Support"", 30, ""24/7 dedicated slack channel and 1h response.""),
    ];

    private List<string> _selected = [""ai""];

    private int Subtotal => _addOns.Where(a => _selected.Contains(a.Id)).Sum(a => a.Price);
    private double DiscountRate => _selected.Count >= 3 ? 0.2 : _selected.Count >= 2 ? 0.1 : 0;
    private double Discount => Subtotal * DiscountRate;
    private double Total => Subtotal - Discount;

    private void ToggleAddOn(string id)
    {
        if (_selected.Contains(id))
            _selected.Remove(id);
        else
            _selected.Add(id);
    }
}";

