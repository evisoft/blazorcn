@* ============================================================
   Block: billing-card-brand-selection
   Title: BillingCardBrandSelection
   Description: A payment network selection block for React and Next.js with high-fidelity brand icons, hover states, and accessibility-ready radio groups built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-card-brand-selection.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <h3 class="font-medium text-sm">Select Payment Method</h3>
            <p class="mt-1 text-muted-foreground text-sm">
                Choose your preferred way to pay. You can change this at any time.
            </p>
        </div>

        <div class="px-4 py-4">
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2" role="radiogroup">
                @foreach (var brand in _brands)
                {
                    <label @onclick="@(() => _selected = brand.Id)"
                           class="@Cn.Merge("relative flex cursor-pointer flex-col items-start gap-3 rounded-lg border p-4 transition-all hover:bg-muted/50", _selected == brand.Id ? "border-foreground bg-muted/30" : "border-border")">
                        <input type="radio" name="payment-method" value="@brand.Id" class="sr-only" />
                        <div class="flex w-full items-center justify-between">
                            <LucideIconCn Name="@brand.Icon" Size="20" Class="size-5 text-muted-foreground" />
                            @if (_selected == brand.Id)
                            {
                                <div class="rounded-full bg-foreground p-0.5">
                                    <LucideIconCn Name="check" Size="10" Class="size-2.5 text-background" />
                                </div>
                            }
                        </div>
                        <div>
                            <p class="font-medium text-sm">@brand.Name</p>
                            <p class="text-muted-foreground text-xs">@brand.Desc</p>
                        </div>
                    </label>
                }
            </div>
        </div>

        <div class="border-t bg-muted/30 px-4 py-3 text-center">
            <p class="text-muted-foreground text-[10px] uppercase tracking-wider">
                Secure 256-bit SSL Encrypted Payment
            </p>
        </div>
    </div>
</section>

@code {
    private string _selected = "card";

    private record Brand(string Id, string Name, string Icon, string Desc);

    private static readonly Brand[] _brands = [
        new("card", "Credit Card", "credit-card", "Visa, Mastercard, Amex"),
        new("apple", "Apple Pay", "wallet", "One-click checkout"),
        new("google", "Google Pay", "wallet", "Fast & Secure"),
        new("bank", "Bank Transfer", "landmark", "ACH or Wire"),
    ];
}
