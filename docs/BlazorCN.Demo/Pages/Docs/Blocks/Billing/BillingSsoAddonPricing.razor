@* ============================================================
   Block: billing-sso-addon-pricing
   Title: BillingSsoAddonPricing
   Description: A targeted enterprise billing block for React and Next.js to upsell SSO (SAML/SCIM) security features built with shadcn/ui and Framer Motion.
   Source: original/blocks/billing/billing-sso-addon-pricing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-foreground/10 bg-card shadow-sm">
        <div class="bg-foreground p-6 text-background">
            <div class="flex items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-xl bg-background/20 backdrop-blur-sm">
                    <LucideIconCn Name="fingerprint" Size="20" Class="size-5 text-background" />
                </div>
                <div>
                    <h3 class="text-lg font-bold tracking-tight">Enterprise SSO Add-on</h3>
                    <p class="text-background/70 text-xs">Security &amp; Governance for Teams</p>
                </div>
            </div>
        </div>

        <div class="p-6 space-y-6">
            <div class="space-y-4">
                @foreach (var feature in _features)
                {
                    <div class="flex items-start gap-3">
                        <div class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                        </div>
                        <div class="space-y-0.5">
                            <p class="text-sm font-semibold">@feature.Name</p>
                            <p class="text-xs text-muted-foreground">@feature.Desc</p>
                        </div>
                    </div>
                }
            </div>

            <div class="rounded-lg border bg-muted/30 p-4">
                <div class="flex flex-col items-center justify-between gap-4 sm:flex-row">
                    <div class="flex items-baseline gap-1.5">
                        <span class="text-3xl font-bold tracking-tight">$99</span>
                        <span class="text-muted-foreground text-xs uppercase tracking-wider">
                            / month
                        </span>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="w-full sm:w-auto font-semibold px-6">
                        Enable SSO
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Trust signal footer *@
        <div class="flex items-center justify-center gap-6 border-t bg-muted/10 px-6 py-3">
            <div class="flex items-center gap-1.5 text-[10px] text-muted-foreground uppercase tracking-widest font-bold">
                <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                SOC2 Certified
            </div>
            <div class="flex items-center gap-1.5 text-[10px] text-muted-foreground uppercase tracking-widest font-bold">
                <LucideIconCn Name="users-2" Size="12" Class="size-3" />
                SCIM Ready
            </div>
        </div>
    </div>
</section>

@code {
    private record Feature(string Name, string Desc);

    private static readonly Feature[] _features = [
        new("SAML 2.0 / OIDC Support", "Integrate with Okta, Azure AD, and Google"),
        new("SCIM Provisioning", "Automated user sync with your IdP"),
        new("Advanced Audit Logs", "Track every login and security change"),
        new("Custom Session Policies", "Enforce IP restrictions and MFA"),
    ];
}
