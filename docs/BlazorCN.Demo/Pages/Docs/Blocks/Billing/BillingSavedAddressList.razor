@* ============================================================
   Block: billing-saved-address-list
   Title: BillingSavedAddressList
   Description: A billing address management block for React and Next.js that handles multiple saved locations for enterprise invoicing built with shadcn/ui.
   Source: original/blocks/billing/billing-saved-address-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="map-pin" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Billing Addresses</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 px-2.5">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Add New
            </ButtonCn>
        </div>

        @* Address Cards *@
        <div class="divide-y">
            @foreach (var addr in _addresses)
            {
                <div class="group relative flex items-start justify-between p-4 transition-colors hover:bg-muted/50">
                    <div class="space-y-1.5">
                        <div class="flex items-center gap-2">
                            <span class="text-sm font-semibold">@addr.Name</span>
                            @if (addr.IsDefault)
                            {
                                <span class="rounded bg-emerald-500/10 px-1.5 py-0.5 text-[10px] font-medium text-emerald-600 dark:text-emerald-400">
                                    Primary
                                </span>
                            }
                        </div>
                        <div class="text-muted-foreground text-xs leading-relaxed">
                            <p>@addr.Line1</p>
                            <p>@addr.City, @addr.State @addr.Zip</p>
                            <p class="font-medium text-[10px] uppercase tracking-wider mt-1">@addr.Country</p>
                        </div>
                    </div>

                    <div class="flex items-center gap-1">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8" aria-label="More options">
                            <LucideIconCn Name="more-vertical" Size="16" Class="size-4 text-muted-foreground" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Info Footer *@
        <div class="bg-muted/20 px-4 py-3 border-t">
            <p class="text-[10px] text-muted-foreground">
                Addresses are used for tax calculation and will appear on your PDF invoices. Tax rates
                are based on the primary address location.
            </p>
        </div>
    </div>
</section>

@code {
    private record Address(string Id, string Name, bool IsDefault, string Line1, string City, string State, string Zip, string Country);

    private static readonly Address[] _addresses =
    [
        new("addr_1", "Headquarters", true, "123 Innovation Drive", "San Francisco", "CA", "94103", "US"),
        new("addr_2", "London Office", false, "45 Canary Wharf", "London", "London", "E14 5AB", "GB"),
    ];
}
