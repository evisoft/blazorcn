@* ============================================================
   Block: billing-on-demand-billing
   Title: BillingOnDemandBilling
   Description: A configuration block for pay-as-you-go or on-demand resource billing for React and Next.js, featuring usage toggles and credit thresholds built with shadcn/ui.
   Source: original/blocks/billing/billing-on-demand-billing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="zap" Size="16" Class="size-4 text-amber-500" />
                    <span class="font-medium text-sm">On-Demand Resources</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 rounded-full px-2 text-[10px] uppercase font-semibold tracking-wide">
                    Active
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Pay only for the resources you consume. Charges are calculated at the end of each
                billing cycle.
            </p>
        </div>

        @* Config *@
        <div class="divide-y">
            <div class="flex items-center justify-between px-4 py-4">
                <div class="space-y-0.5">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">Metered Compute</span>
                        <TooltipCn>
                            <TooltipTriggerCn>
                                <LucideIconCn Name="info" Size="12" Class="size-3 text-muted-foreground/50" />
                            </TooltipTriggerCn>
                            <TooltipContentCn>Charged per CPU-hour of active processing.</TooltipContentCn>
                        </TooltipCn>
                    </div>
                    <p class="text-muted-foreground text-xs">Currently consuming 1.2k units</p>
                </div>
                <SwitchCn aria-label="Metered Compute" @bind-Checked="_computeEnabled" />
            </div>

            @* Usage Stats *@
            <div class="bg-muted/30 px-4 py-5">
                <div class="grid grid-cols-2 gap-8">
                    <div>
                        <div class="flex items-center gap-1.5 text-muted-foreground text-xs font-medium uppercase tracking-wider">
                            <LucideIconCn Name="cpu" Size="12" Class="size-3" />
                            Current Usage
                        </div>
                        <div class="mt-1 flex items-baseline gap-1">
                            <span class="text-2xl font-semibold tracking-tight tabular-nums">
                                @_currentUsage.ToString("N1")
                            </span>
                            <span class="text-muted-foreground text-sm">Units</span>
                        </div>
                    </div>

                    <div>
                        <div class="text-muted-foreground text-xs font-medium uppercase tracking-wider">
                            Accrued Cost
                        </div>
                        <div class="mt-1 flex items-baseline gap-1 text-emerald-600 dark:text-emerald-500">
                            <span class="text-2xl font-semibold tracking-tight tabular-nums">
                                $@_currentCost.ToString("F2")
                            </span>
                            <span class="text-sm">USD</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5 border-t bg-card">
            <p class="text-muted-foreground text-[11px] leading-relaxed italic">
                * Rate: $0.005 per unit. Metered usage resets at the beginning of each calendar month.
            </p>
        </div>
    </div>
</section>

@code {
    private bool _computeEnabled = true;
    private readonly double _currentUsage = 1240.5;
    private readonly double _currentCost = 1240.5 * 0.005;
}
