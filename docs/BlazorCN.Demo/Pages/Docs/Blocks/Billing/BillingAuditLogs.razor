@* ============================================================
   Block: billing-audit-logs
   Title: BillingAuditLogs
   Description: A billing-specific audit log block for React and Next.js with event filtering, user attribution, and semantic status indicators built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-audit-logs.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Billing Activity</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                A detailed log of all changes to your subscription, payment methods, and historical
                transactions.
            </p>
        </div>

        @* Log List *@
        <div class="divide-y">
            @foreach (var log in _logs)
            {
                <div class="group flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="mt-1 flex size-7 shrink-0 items-center justify-center rounded-full border bg-background">
                        @if (log.Category == "payment")
                        {
                            <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                        }
                        @if (log.Category == "subscription")
                        {
                            <LucideIconCn Name="arrow-right-left" Size="14" Class="size-3.5 text-muted-foreground" />
                        }
                        @if (log.Category == "refund")
                        {
                            <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                        }
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            <p class="font-medium text-sm truncate">@log.Event</p>
                            <span class="@($"size-1.5 rounded-full {StatusColor(log.Status)}")" />
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <LucideIconCn Name="user" Size="12" Class="size-3" />
                            <span>@log.User</span>
                            <span>•</span>
                            <span>@log.Date</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="bg-muted/30 px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs cursor-pointer hover:text-foreground transition-colors">
                View full 90-day history · Export as CSV
            </p>
        </div>

    </div>
</section>

@code {
    private record AuditLog(string Id, string Event, string User, string Date, string Status, string Category);

    private static readonly AuditLog[] _logs =
    [
        new("log-1", "Subscription upgraded to Pro", "sarah@example.com", "2 mins ago", "success", "subscription"),
        new("log-2", "Payment failed for INV-004", "System", "1 hour ago", "failure", "payment"),
        new("log-3", "Payment method updated", "mike@example.com", "3 hours ago", "success", "payment"),
        new("log-4", "Refund processed ($49.00)", "admin@example.com", "Yesterday", "success", "refund"),
        new("log-5", "New seat added (Engineering)", "sarah@example.com", "Mar 22", "success", "subscription"),
    ];

    private static string StatusColor(string status) => status switch
    {
        "success" => "bg-emerald-500",
        "failure" => "bg-red-500",
        "pending" => "bg-amber-500",
        _ => ""
    };
}
