@* ============================================================
   Block: billing-email-preferences
   Title: BillingEmailPreferences
   Description: A billing notifications and email preferences block for React and Next.js with toggleable alerts and recipient management built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-email-preferences.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Billing Notifications</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Control how and when you receive billing-related communications from us.
            </p>
        </div>

        <div class="divide-y px-4">
            <div class="py-5">
                <LabelCn For="email-preferences-billing-email" Class="text-xs font-medium text-muted-foreground uppercase tracking-wider">
                    Primary Billing Recipient
                </LabelCn>
                <div class="mt-2 flex gap-2">
                    <InputCn id="email-preferences-billing-email" Placeholder="accounting@company.com" />
                    <ButtonCn Size="ButtonSize.Sm" Class="h-9">
                        Update
                    </ButtonCn>
                </div>
                <p class="mt-2 text-muted-foreground text-[11px]">
                    Invoices and payment alerts will be sent to this address in addition to the account
                    owner.
                </p>
            </div>

            <div class="py-4 space-y-4">
                @foreach (var notif in _notifications)
                {
                    <div class="flex items-start justify-between gap-4">
                        <div class="space-y-0.5">
                            <h3 class="font-medium text-sm">@notif.Title</h3>
                            <p class="text-muted-foreground text-xs leading-relaxed">
                                @notif.Description
                            </p>
                        </div>
                        <SwitchCn aria-label="@notif.Title" Checked="@notif.Default" />
                    </div>
                }
            </div>
        </div>

        <div class="bg-muted/30 px-4 py-3">
            <div class="flex items-center gap-2 text-muted-foreground text-[10px]">
                <LucideIconCn Name="bell" Size="12" Class="size-3" />
                <span>Changes will take effect starting with your next billing cycle.</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Notification(string Id, string Title, string Description, bool Default);

    private static readonly Notification[] _notifications =
    [
        new("invoices", "Monthly Invoices", "Receive a PDF copy of your invoice every billing cycle.", true),
        new("usage", "Usage Alerts", "Get notified when you reach 80% and 100% of your plan limits.", true),
        new("payment", "Payment Reminders", "Alerts for upcoming charges or failed payment attempts.", true),
        new("reports", "Spending Reports", "A weekly summary of your organization's resource consumption.", false),
    ];
}
