@* ============================================================
   Block: billing-referral-payout-status
   Title: BillingReferralPayoutStatus
   Description: A partner-facing billing block for React and Next.js to track referral payout progress, estimated dates, and payment destination built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-referral-payout-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="wallet" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Payout Status</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs text-blue-600 border-blue-200 bg-blue-50">
                <LucideIconCn Name="clock" Size="12" Class="size-3 mr-1" />
                Pending Approval
            </BadgeCn>
        </div>

        @* Main Stats *@
        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-6">
                <p class="text-muted-foreground text-xs font-medium uppercase tracking-wider mb-1">Pending Payout</p>
                <div class="flex items-baseline gap-1">
                    <span class="text-muted-foreground text-sm">$</span>
                    <span class="font-bold text-3xl tracking-tight">450.00</span>
                </div>
                <div class="mt-4 flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                    <span>Est. June 15, 2026</span>
                </div>
            </div>
            <div class="px-4 py-6">
                <p class="text-muted-foreground text-xs font-medium uppercase tracking-wider mb-1">Total Paid Out</p>
                <div class="flex items-baseline gap-1 text-muted-foreground/60">
                    <span class="text-sm">$</span>
                    <span class="font-bold text-3xl tracking-tight text-foreground/80">2,840.50</span>
                </div>
                <div class="mt-4 flex items-center gap-1.5 text-xs text-emerald-600">
                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                    <span>All payments current</span>
                </div>
            </div>
        </div>

        @* Destination Info *@
        <div class="border-b px-4 py-4 bg-muted/20">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div class="flex size-8 items-center justify-center rounded-md bg-background border">
                        <LucideIconCn Name="banknote" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div>
                        <p class="text-xs font-medium">Payout Destination</p>
                        <p class="text-muted-foreground text-[10px]">Chase Bank •••• 1290</p>
                    </div>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-[10px] uppercase font-semibold tracking-wide">
                    Edit
                </ButtonCn>
            </div>
        </div>

        @* Info Note *@
        <div class="px-4 py-3">
            <p class="text-muted-foreground text-[11px] leading-relaxed">
                Payouts are automatically initiated when your pending balance reaches the $50 minimum threshold. Bank transfers typically take 3-5 business days to clear.
            </p>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3 border-t">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                View Commission Log
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                Download Tax Forms
            </ButtonCn>
        </div>

    </div>
</section>
