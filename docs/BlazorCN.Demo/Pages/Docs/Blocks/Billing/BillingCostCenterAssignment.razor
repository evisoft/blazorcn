@* ============================================================
   Block: billing-cost-center-assignment
   Title: BillingCostCenterAssignment
   Description: An enterprise resource management component for React and Next.js that allows administrators to map spending to specific internal departments or projects built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-cost-center-assignment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="tags" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Cost Center Assignment</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
            </ButtonCn>
        </div>

        @* Info Tip *@
        <div class="px-4 py-3 border-b bg-amber-50/50">
            <div class="flex items-start gap-3">
                <LucideIconCn Name="info" Size="16" Class="size-4 text-amber-600 mt-0.5" />
                <p class="text-[11px] text-amber-800 leading-relaxed">
                    You have <strong>1 unassigned resource</strong> that needs to be mapped to a cost center before
                    the July billing cycle closes in 4 days.
                </p>
            </div>
        </div>

        @* Assignment List *@
        <div class="divide-y">
            @foreach (var item in _assignments)
            {
                <div class="group flex items-center justify-between px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex items-center gap-3">
                        <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                            <LucideIconCn Name="building" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div>
                            <h4 class="text-xs font-semibold text-foreground">@item.Resource</h4>
                            <div class="mt-0.5 flex items-center gap-1.5 text-[10px] text-muted-foreground">
                                <span>GL: 4022-XX</span>
                                <span>•</span>
                                <span class="@(item.Status == "pending" ? "text-amber-600 font-medium" : "")">@item.Center</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        @if (item.Status == "pending")
                        {
                            <ButtonCn Size="ButtonSize.Sm" Class="h-7 px-3 text-[10px] bg-amber-600 hover:bg-amber-700">
                                Assign
                            </ButtonCn>
                        }
                        else
                        {
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0 opacity-0 group-hover:opacity-100 transition-opacity">
                                <LucideIconCn Name="more-horizontal" Size="14" Class="size-3.5 text-muted-foreground" />
                            </ButtonCn>
                        }
                        <LucideIconCn Name="chevron-right" Size="14" Class="size-3.5 text-muted-foreground/30" />
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3 border-t">
            <button class="text-[11px] font-medium text-muted-foreground hover:text-foreground underline underline-offset-4">
                Manage Cost Centers
            </button>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Bulk Edit
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Save Changes
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Assignment(string Resource, string Center, string Status);

    private static readonly Assignment[] _assignments =
    [
        new("Production Cluster A", "Engineering-01", "assigned"),
        new("Global CDN", "Marketing-Global", "assigned"),
        new("New Project X", "Unassigned", "pending"),
    ];
}
