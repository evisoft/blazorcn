@* ============================================================
   Block: billing-multi-currency-pricing
   Title: BillingMultiCurrencyPricing
   Description: A billing multi-currency and regional pricing block for React and Next.js with automatic currency detection and localized formatting built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-multi-currency-pricing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        <div class="border-b px-4 py-3 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Regional Pricing</span>
            </div>
            <div class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                <span class="text-[10px] font-bold uppercase tracking-widest">Localized</span>
            </div>
        </div>

        <div class="p-8 flex flex-col items-center text-center">
            <div class="mb-6">
                <BadgeCn Variant="BadgeVariant.Outline" Class="mb-2 h-5 text-[10px] uppercase tracking-wider font-semibold">
                    Pro Plan
                </BadgeCn>
                <h2 class="text-3xl font-bold tracking-tight">Simple Global Pricing</h2>
                <p class="mt-2 text-muted-foreground text-sm max-w-[320px]">
                    Transparent pricing in your local currency with no hidden conversion fees.
                </p>
            </div>

            <div class="flex flex-col items-center gap-6 w-full max-w-xs">
                <div class="flex items-baseline gap-1">
                    <span class="text-6xl font-extrabold tracking-tighter">@($"{_currency.Symbol}{_currency.Price:N0}")</span>
                    <span class="text-muted-foreground text-sm font-medium">/mo</span>
                </div>

                <div class="w-full space-y-2">
                    <label for="currency-select" class="text-[10px] uppercase tracking-widest font-bold text-muted-foreground">
                        Select Currency
                    </label>
                    <SelectCn @bind-Value="_currencyCode">
                        <SelectTriggerCn id="currency-select" Class="h-10 text-sm">
                            <SelectValueCn />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            @foreach (var c in _currencies)
                            {
                                <SelectItemCn Value="@c.Code">
                                    <div class="flex items-center gap-2">
                                        <span>@c.Code (@c.Symbol)</span>
                                        <span class="text-[10px] text-muted-foreground">— @c.Region</span>
                                    </div>
                                </SelectItemCn>
                            }
                        </SelectContentCn>
                    </SelectCn>
                </div>

                <ButtonCn Size="ButtonSize.Lg" Class="w-full h-12 text-sm font-bold shadow-sm">
                    <LucideIconCn Name="zap" Size="16" Class="mr-2 size-4 fill-current" />
                    Get Started Now
                </ButtonCn>
            </div>
        </div>

        <div class="bg-muted/30 px-4 py-3 border-t text-center">
            <p class="text-muted-foreground text-[10px]">
                * Prices are inclusive of regional VAT/GST where applicable.
            </p>
        </div>
    </div>
</section>

@code {
    private record CurrencyInfo(string Code, string Symbol, int Price, string Region);

    private static readonly CurrencyInfo[] _currencies =
    [
        new("USD", "$", 49, "United States"),
        new("EUR", "€", 45, "European Union"),
        new("GBP", "£", 39, "United Kingdom"),
        new("JPY", "¥", 7200, "Japan"),
    ];

    private string _currencyCode = "USD";

    private CurrencyInfo _currency => Array.Find(_currencies, c => c.Code == _currencyCode) ?? _currencies[0];
}
