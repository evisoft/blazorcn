   Block: billing-discount-badge
   Title: BillingDiscountBadge
   Description: A billing discount and promotional badge block for React and Next.js with interactive highlights and countdown indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/billing/billing-discount-badge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex items-center justify-between rounded-lg border bg-card px-4 py-3 shadow-sm">
        <div class="flex items-center gap-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-primary/10 text-primary">
                <LucideIconCn Name="tag" Size="16" Class="size-4" />
            </div>
            <div>
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Annual Plan Savings</span>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 border-emerald-500/30 bg-emerald-500/5 px-1.5 text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="sparkles" Size="12" Class="mr-1 size-3" />
                        Special Offer
                    </BadgeCn>
                </div>
                <p class="text-muted-foreground text-xs">
                    Switch to annual billing and save on your subscription costs.
                </p>
            </div>
        </div>

        <div class="flex items-center gap-4">
            <div class="text-right">
                <div class="flex items-center justify-end gap-1 font-semibold text-lg text-primary tabular-nums">
                    <LucideIconCn Name="trending-down" Size="16" Class="size-4 text-emerald-500" />
                    <span>20%</span>
                </div>
                <span class="text-[10px] text-muted-foreground uppercase tracking-wider">
                    Discount applied
                </span>
            </div>
        </div>
    </div>
</section>
