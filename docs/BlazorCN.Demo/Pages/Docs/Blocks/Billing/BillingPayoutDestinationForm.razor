@* ============================================================
   Block: billing-payout-destination-form
   Title: BillingPayoutDestinationForm
   Description: A secure partner billing configuration block for React and Next.js to manage bank accounts, PayPal, and tax identifiers built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-payout-destination-form.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="landmark" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Payout Settings</span>
            </div>
            <div class="flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400">
                <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                <span class="text-[10px] font-bold uppercase tracking-wider">Secure Transfer</span>
            </div>
        </div>

        @* Method Selection *@
        <div class="p-6 space-y-6">
            <div class="space-y-3">
                <label class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Select Payout Method</label>
                <div class="grid grid-cols-2 gap-3">
                    <ButtonCn Variant="@(_method == "bank" ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Class="h-12 gap-2 justify-start px-4"
                              @onclick="SelectBank">
                        <LucideIconCn Name="building-2" Size="16" Class="size-4" />
                        <span class="text-xs">Bank Account</span>
                    </ButtonCn>
                    <ButtonCn Variant="@(_method == "paypal" ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Class="h-12 gap-2 justify-start px-4"
                              @onclick="SelectPaypal">
                        <LucideIconCn Name="banknote" Size="16" Class="size-4" />
                        <span class="text-xs">PayPal</span>
                    </ButtonCn>
                </div>
            </div>

            @* Form Fields *@
            <div class="space-y-4">
                @if (_method == "bank")
                {
                    <div class="grid grid-cols-2 gap-4">
                        <div class="space-y-2">
                            <label for="routing" class="text-xs">Routing Number</label>
                            <InputCn id="routing" Placeholder="123456789" Class="h-9 text-sm font-mono" />
                        </div>
                        <div class="space-y-2">
                            <label for="account" class="text-xs">Account Number</label>
                            <InputCn id="account" Type="password" Placeholder="••••••••" Class="h-9 text-sm font-mono" />
                        </div>
                    </div>
                    <div class="space-y-2">
                        <label for="bank-name" class="text-xs">Bank Name</label>
                        <InputCn id="bank-name" Placeholder="e.g. Chase, Wells Fargo" Class="h-9 text-sm" />
                    </div>
                }
                else
                {
                    <div class="space-y-2">
                        <label for="paypal-email" class="text-xs">PayPal Email Address</label>
                        <InputCn id="paypal-email" Type="email" Placeholder="name@example.com" Class="h-9 text-sm" />
                    </div>
                }

                <div class="space-y-2">
                    <label for="payout-destination-form-country" class="text-xs">Tax Residency Country</label>
                    <SelectCn @bind-Value="_country">
                        <SelectTriggerCn id="payout-destination-form-country" Class="h-9 text-sm">
                            <SelectValueCn Placeholder="Select country" />
                        </SelectTriggerCn>
                        <SelectContentCn>
                            <SelectItemCn Value="us">United States</SelectItemCn>
                            <SelectItemCn Value="ca">Canada</SelectItemCn>
                            <SelectItemCn Value="uk">United Kingdom</SelectItemCn>
                            <SelectItemCn Value="de">Germany</SelectItemCn>
                        </SelectContentCn>
                    </SelectCn>
                </div>
            </div>
        </div>

        @* Security Note *@
        <div class="px-6 py-4 bg-muted/20 border-t">
            <p class="text-muted-foreground text-[11px] leading-relaxed">
                By providing your payout details, you authorize us to initiate transfers to the account listed above. Your information is encrypted and stored securely following PCI-DSS compliance standards.
            </p>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3 border-t">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                <LucideIconCn Name="check" Size="12" Class="size-3" />
                Save Destination
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs text-muted-foreground">
                Cancel
            </ButtonCn>
            <p class="ml-auto text-muted-foreground text-[10px] uppercase font-bold tracking-widest">
                ID: P_88291
            </p>
        </div>
    </div>
</section>

@code {
    private string _method = "bank";
    private string _country = "us";

    private void SelectBank() => _method = "bank";
    private void SelectPaypal() => _method = "paypal";
}
