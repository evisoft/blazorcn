@* ============================================================
   Block: billing-pending-verification
   Title: BillingPendingVerification
   Description: A status indicator for pending billing verifications (tax IDs, bank accounts, or manual audits) for React and Next.js, built with shadcn/ui.
   Source: original/blocks/billing/billing-pending-verification.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col items-center px-6 py-10 text-center">
            <div class="relative">
                <div class="flex size-16 items-center justify-center rounded-full bg-blue-50 text-blue-600 dark:bg-blue-900/20 dark:text-blue-500">
                    <LucideIconCn Name="file-search" Size="32" Class="size-8" />
                </div>
                <div class="absolute -bottom-1 -right-1 flex size-6 items-center justify-center rounded-full border-2 border-card bg-amber-500 text-white">
                    <LucideIconCn Name="clock" Size="14" Class="size-3.5" />
                </div>
            </div>

            <h2 class="mt-6 font-semibold text-lg">@_verificationType Pending</h2>
            <p class="mt-2 text-muted-foreground text-sm max-w-[320px]">
                We're currently reviewing your billing information to ensure compliance with local tax
                regulations.
            </p>
        </div>

        <div class="grid grid-cols-2 divide-x border-t border-b bg-muted/30">
            <div class="px-6 py-4">
                <p class="text-muted-foreground text-[10px] uppercase font-bold tracking-wider">
                    Submitted On
                </p>
                <p class="mt-1 font-medium text-sm">@_submissionDate</p>
            </div>
            <div class="px-6 py-4">
                <p class="text-muted-foreground text-[10px] uppercase font-bold tracking-wider">
                    Estimated Wait
                </p>
                <div class="mt-1 flex items-center gap-1.5 font-medium text-sm">
                    <span class="tabular-nums">@_estimatedDays</span>
                </div>
            </div>
        </div>

        <div class="p-4 space-y-4">
            <div class="flex items-center justify-between rounded-md border bg-background px-4 py-3">
                <div class="flex items-center gap-3">
                    <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-emerald-500" />
                    <span class="text-sm font-medium">Platform Access</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 text-[10px] font-semibold uppercase">
                    Unrestricted
                </BadgeCn>
            </div>

            <p class="text-center text-[11px] text-muted-foreground">
                You'll receive an email once the verification process is complete.
            </p>
        </div>
    </div>
</section>

@code {
    private readonly string _verificationType = "VAT ID Verification";
    private readonly string _submissionDate = "May 29, 2026";
    private readonly string _estimatedDays = "1-2 business days";
}
