@* ============================================================
   Block: billing-portal-link
   Title: BillingPortalLink
   Description: A dedicated link block for accessing the Stripe Customer Portal or internal billing management for React and Next.js, built with shadcn/ui.
   Source: original/blocks/billing/billing-portal-link.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col sm:flex-row items-center gap-6 p-6">
            <div class="flex size-14 shrink-0 items-center justify-center rounded-xl bg-muted/50">
                <LucideIconCn Name="receipt" Size="28" Class="size-7 text-muted-foreground" />
            </div>
            <div class="flex-1 text-center sm:text-left space-y-1">
                <h3 class="font-semibold text-base">Billing Management</h3>
                <p class="text-muted-foreground text-sm">
                    Update your payment method, download past invoices, and manage your subscription
                    preferences in our secure billing portal.
                </p>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x border-t">
            <div class="p-4 flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-full bg-muted/30">
                    <LucideIconCn Name="lock" Size="14" Class="size-3.5 text-muted-foreground" />
                </div>
                <span class="text-xs font-medium">Securely hosted by Stripe</span>
            </div>
            <div class="p-4 flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-full bg-muted/30">
                    <LucideIconCn Name="settings" Size="14" Class="size-3.5 text-muted-foreground" />
                </div>
                <span class="text-xs font-medium">Self-service management</span>
            </div>
        </div>

        <div class="p-4 bg-muted/10 border-t">
            <ButtonCn Class="w-full gap-2 h-10 shadow-sm" Size="ButtonSize.Lg">
                Open Billing Portal
                <LucideIconCn Name="external-link" Size="16" Class="size-4" />
            </ButtonCn>
            <p class="mt-3 text-center text-[10px] text-muted-foreground">
                You will be redirected to our secure billing provider.
            </p>
        </div>
    </div>
</section>
