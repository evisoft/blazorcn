@* ============================================================
   Block: billing-wallet-recharge
   Title: BillingWalletRecharge
   Description: A sleek wallet balance recharge block with preset amount buttons, custom input, and secure payment method selection for React and Next.js.
   Source: original/blocks/billing/billing-wallet-recharge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-sm">
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="wallet" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Wallet Balance</span>
                </div>
                <div class="text-xl font-semibold tracking-tight tabular-nums">
                    $@_balance.ToString("F2")
                </div>
            </div>
        </div>

        <div class="p-4 space-y-6">
            <div class="space-y-3">
                <LabelCn Class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                    Select Amount
                </LabelCn>
                <div class="grid grid-cols-4 gap-2">
                    @foreach (var val in _presetAmounts)
                    {
                        var presetVal = val;
                        <ButtonCn Variant="@(presetVal.ToString() == _amount ? ButtonVariant.Default : ButtonVariant.Outline)"
                                  Class="h-9 text-xs font-medium"
                                  @onclick="@(() => _amount = presetVal.ToString())">
                            $@presetVal
                        </ButtonCn>
                    }
                </div>
            </div>

            <div class="space-y-3">
                <LabelCn For="wallet-recharge-custom-amount" Class="text-[10px] font-bold uppercase text-muted-foreground tracking-widest">
                    Custom Amount
                </LabelCn>
                <div class="relative">
                    <span class="absolute left-3 top-1/2 -translate-y-1/2 text-muted-foreground text-sm">
                        $
                    </span>
                    <InputCn id="wallet-recharge-custom-amount" Type="number" @bind-Value="_amount" Placeholder="0.00" Class="h-10 pl-7 pr-4 font-mono text-sm" />
                </div>
            </div>

            <div class="rounded-md bg-muted/30 border border-dashed p-3">
                <div class="flex items-center justify-between text-xs text-muted-foreground">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="credit-card" Size="14" Class="size-3.5" />
                        <span>Paying with Visa •••• 4242</span>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Link" Class="h-auto p-0 text-[11px] text-primary">
                        Change
                    </ButtonCn>
                </div>
            </div>

            <ButtonCn Class="w-full h-10 gap-2 font-medium"
                      Disabled="@IsButtonDisabled()"
                      @onclick="HandleRecharge">
                <LucideIconCn Name="plus" Size="16" Class="@Cn.Merge("size-4", _isProcessing ? "animate-spin" : "")" />
                @(_isProcessing ? "Processing..." : $"Recharge ${(_amount?.Length > 0 ? _amount : "0.00")}")
            </ButtonCn>
        </div>

        <div class="bg-muted/50 border-t px-4 py-2.5">
            <p class="text-center text-[10px] text-muted-foreground leading-relaxed">
                Funds are available immediately upon successful payment. All transactions are secure
                and encrypted.
            </p>
        </div>
    </div>
</section>

@code {
    private static readonly int[] _presetAmounts = [10, 25, 50, 100];

    private double _balance = 42.5;
    private string _amount = "25";
    private bool _isProcessing = false;

    private bool IsButtonDisabled()
    {
        if (_isProcessing || string.IsNullOrEmpty(_amount)) return true;
        if (!double.TryParse(_amount, out var val)) return true;
        return val <= 0;
    }

    private async Task HandleRecharge()
    {
        if (!double.TryParse(_amount, out var val) || val <= 0) return;

        _isProcessing = true;
        StateHasChanged();
        await Task.Delay(1000);
        _balance += val;
        _isProcessing = false;
        _amount = "";
    }
}
