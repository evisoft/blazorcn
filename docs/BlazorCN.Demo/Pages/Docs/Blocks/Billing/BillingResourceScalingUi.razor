@* ============================================================
   Block: billing-resource-scaling-ui
   Title: BillingResourceScalingUi
   Description: A dynamic billing configuration block for React and Next.js to adjust resource quotas (seats, storage, etc.) with real-time price calculation built with shadcn/ui and NumberFlow.
   Source: original/blocks/billing/billing-resource-scaling-ui.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="p-6">
            <div class="flex items-center justify-between mb-8">
                <div class="flex items-center gap-3">
                    <div class="flex size-10 items-center justify-center rounded-xl bg-muted/50">
                        <LucideIconCn Name="database" Size="20" Class="size-5 text-muted-foreground" />
                    </div>
                    <div>
                        <h3 class="font-medium text-sm">Storage Capacity</h3>
                        <p class="text-muted-foreground text-xs">Scale your database as you grow</p>
                    </div>
                </div>
                <div class="text-right">
                    <div class="text-2xl font-bold tracking-tight tabular-nums">
                        @_storage
                        <span class="text-muted-foreground text-sm font-normal ml-1">GB</span>
                    </div>
                </div>
            </div>

            <div class="space-y-6">
                <SliderCn Value="@((double)_storage)"
                          ValueChanged="@(v => _storage = (int)v)"
                          Max="500"
                          Min="10"
                          Step="10"
                          Class="py-4" />

                <div class="grid grid-cols-3 gap-4">
                    <div class="space-y-1">
                        <span class="text-[10px] font-medium uppercase text-muted-foreground">
                            Current
                        </span>
                        <p class="text-sm font-semibold tabular-nums">20 GB</p>
                    </div>
                    <div class="space-y-1">
                        <span class="text-[10px] font-medium uppercase text-muted-foreground">New</span>
                        <p class="text-sm font-semibold tabular-nums text-blue-600 dark:text-blue-400">
                            @_storage GB
                        </p>
                    </div>
                    <div class="space-y-1">
                        <span class="text-[10px] font-medium uppercase text-muted-foreground">
                            Change
                        </span>
                        <p class="text-sm font-semibold tabular-nums text-emerald-500">
                            +@(_storage - 20) GB
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-col items-center justify-between gap-4 border-t bg-muted/20 px-4 py-3 sm:flex-row">
            <div class="flex items-baseline gap-1.5">
                <span class="text-muted-foreground text-xs">New Monthly Cost:</span>
                <span class="text-xl font-bold tracking-tight tabular-nums">
                    @($"${(_storage * _pricePerGb):F2}")
                </span>
            </div>

            <div class="flex w-full items-center gap-2 sm:w-auto">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="flex-1 sm:flex-none" @onclick="Reset">
                    Reset
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="flex-1 gap-2 sm:flex-none">
                    Apply Changes
                </ButtonCn>
            </div>
        </div>

        @* Info Tip *@
        <div class="px-4 py-2 bg-blue-500/5 flex items-center gap-2">
            <LucideIconCn Name="zap" Size="12" Class="size-3 text-blue-500" />
            <p class="text-[10px] text-blue-700/70 dark:text-blue-400/70">
                Changes are pro-rated and will be reflected on your next statement. No immediate
                charge required.
            </p>
        </div>
    </div>
</section>

@code {
    private int _storage = 50;
    private const double _pricePerGb = 0.2;

    private void Reset()
    {
        _storage = 50;
    }
}
