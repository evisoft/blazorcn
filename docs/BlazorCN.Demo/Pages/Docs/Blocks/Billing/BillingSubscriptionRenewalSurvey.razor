@* ============================================================
   Block: billing-subscription-renewal-survey
   Title: BillingSubscriptionRenewalSurvey
   Description: A strategic feedback component for React and Next.js presented during the renewal or cancellation window to understand customer satisfaction and retention drivers built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-subscription-renewal-survey.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm text-foreground">Renewal Feedback</span>
            </div>
            <button class="rounded-full p-1 hover:bg-muted transition-colors">
                <LucideIconCn Name="x" Size="14" Class="size-3.5 text-muted-foreground" />
            </button>
        </div>

        @* Survey Content *@
        <div class="px-6 py-8 text-center">
            <div class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="thumbs-up" Size="24" Class="size-6 text-muted-foreground" />
            </div>

            <div>
                <h3 class="text-lg font-semibold tracking-tight">How has your experience been?</h3>
                <p class="mt-1 text-xs text-muted-foreground">
                    Your feedback helps us improve the Pro plan for your upcoming renewal.
                </p>
            </div>

            @* Rating Scale *@
            <div class="mt-8 flex items-center justify-center gap-2">
                @foreach (var num in new[] { 1, 2, 3, 4, 5 })
                {
                    var n = num;
                    <button
                        @onclick="@(() => _rating = n)"
                        class="@Cn.Merge("flex size-10 items-center justify-center rounded-md border text-sm font-medium transition-all", _rating == n ? "bg-foreground text-background border-foreground scale-110 shadow-lg" : "bg-background text-foreground hover:bg-muted")">
                        @n
                    </button>
                }
            </div>
            <div class="mt-2 flex justify-between px-2 max-w-[240px] mx-auto text-[10px] text-muted-foreground font-medium uppercase tracking-widest">
                <span>Disappointing</span>
                <span>Amazing</span>
            </div>

            @* Text Feedback (Conditional) *@
            @if (_rating > 0)
            {
                <div class="mt-8">
                    <textarea
                        placeholder="What could we do better? (Optional)"
                        class="w-full min-h-[100px] rounded-md border bg-muted/20 p-3 text-sm focus:outline-none focus:ring-1 focus:ring-foreground/20 resize-none"></textarea>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between px-4 py-3 border-t bg-muted/10">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="star" Size="14" Class="size-3.5 text-amber-500 fill-amber-500" />
                <span class="text-muted-foreground text-[10px] font-medium uppercase tracking-wider">
                    1-minute completion
                </span>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Disabled="@(_rating == 0)" Class="h-8 gap-1.5 text-xs">
                <LucideIconCn Name="send" Size="14" Class="size-3.5" />
                Submit Survey
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private int _rating = 0;
}
