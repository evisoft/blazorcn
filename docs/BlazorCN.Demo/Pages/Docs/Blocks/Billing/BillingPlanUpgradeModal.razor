@* ============================================================
   Block: billing-plan-upgrade-modal
   Title: BillingPlanUpgradeModal
   Description: A high-conversion plan upgrade confirmation UI for React and Next.js, featuring pro-rated cost previews and feature highlights built with shadcn/ui.
   Source: original/blocks/billing/billing-plan-upgrade-modal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-xl border bg-card shadow-lg">
        @* Header *@
        <div class="bg-muted/30 px-6 py-8 text-center border-b">
            <div class="mx-auto flex size-12 items-center justify-center rounded-full bg-emerald-500/10 text-emerald-600">
                <LucideIconCn Name="rocket" Size="24" Class="size-6" />
            </div>
            <h2 class="mt-4 text-xl font-semibold tracking-tight">Upgrade to @_newPlan</h2>
            <p class="mt-1 text-muted-foreground text-sm">
                Unlock more power and scale your workspace without limits.
            </p>
        </div>

        @* Comparison *@
        <div class="px-6 py-6">
            <div class="flex items-center justify-center gap-8 py-4">
                <div class="text-center">
                    <p class="text-[10px] uppercase font-bold text-muted-foreground tracking-widest">
                        Current
                    </p>
                    <p class="mt-1 font-semibold text-sm">@_currentPlan</p>
                    <p class="text-muted-foreground text-xs">$0</p>
                </div>
                <LucideIconCn Name="arrow-right" Size="16" Class="size-4 text-muted-foreground/30" />
                <div class="text-center">
                    <p class="text-[10px] uppercase font-bold text-emerald-600 tracking-widest">
                        New
                    </p>
                    <p class="mt-1 font-semibold text-sm text-emerald-600">@_newPlan</p>
                    <p class="text-muted-foreground text-xs">$@_newPrice/mo</p>
                </div>
            </div>

            <div class="mt-6 space-y-3">
                <p class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">
                    What's Included:
                </p>
                <div class="grid grid-cols-2 gap-x-4 gap-y-2">
                    @foreach (var benefit in _benefits)
                    {
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                            <span class="text-sm">@benefit</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Footer / Action *@
        <div class="border-t bg-muted/30 px-6 py-6">
            <div class="flex items-center justify-between mb-6">
                <div class="space-y-0.5">
                    <p class="font-medium text-sm">Due Today (Pro-rated)</p>
                    <p class="text-muted-foreground text-xs">Based on 19 days remaining in cycle.</p>
                </div>
                <div class="text-right">
                    <span class="text-xl font-bold tabular-nums">
                        $@_proratedCharge.ToString("F2")
                    </span>
                </div>
            </div>
            <div class="flex flex-col gap-2">
                <ButtonCn Size="ButtonSize.Lg"
                          Class="w-full gap-2 bg-emerald-600 hover:bg-emerald-700 font-semibold uppercase tracking-wide h-12">
                    <LucideIconCn Name="zap" Size="16" Class="size-4 fill-current" />
                    Confirm Upgrade
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="text-muted-foreground">
                    Cancel and keep @_currentPlan plan
                </ButtonCn>
            </div>
            <p class="mt-4 text-center text-[10px] text-muted-foreground leading-relaxed">
                By clicking confirm, you agree to be charged immediately for the pro-rated amount. Your
                next billing cycle will be at the full price of $29.00/mo.
            </p>
        </div>
    </div>
</section>

@code {
    private const string _currentPlan = "Free";
    private const string _newPlan = "Pro";
    private const double _newPrice = 29.0;
    private const double _proratedCharge = 18.4;

    private static readonly string[] _benefits =
    [
        "Unlimited Team Projects",
        "Advanced Analytics Dashboard",
        "Priority 24/7 Support",
        "Custom Domain Integration",
    ];
}
