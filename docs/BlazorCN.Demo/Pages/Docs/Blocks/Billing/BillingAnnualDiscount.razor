@* ============================================================
   Block: billing-annual-discount
   Title: BillingAnnualDiscount
   Description: An annual billing promotion block for React and Next.js with animated price savings, period toggles, and conversion-focused CTA built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-annual-discount.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-emerald-500" />
                <span class="font-medium text-sm">Limited Time Offer</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="border-emerald-500/20 bg-emerald-500/10 text-emerald-600">
                20% OFF
            </BadgeCn>
        </div>

        <div class="px-4 py-6 text-center">
            <h3 class="font-medium text-sm">
                Switch to Annual Billing
            </h3>
            <div class="mt-2 flex items-baseline justify-center gap-1">
                <span class="text-muted-foreground text-sm">$</span>
                <span class="text-3xl font-semibold tracking-tight tabular-nums">
                    @(_isAnnual ? _annualPrice : _monthlyPrice)
                </span>
                <span class="text-muted-foreground text-sm">/mo</span>
            </div>
            <p class="mt-2 text-muted-foreground text-sm">
                Commit to a yearly plan and save
                <span class="text-foreground font-medium">$120</span> per year. Billed annually as
                $468.
            </p>

            <div class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center">
                <ButtonCn Variant="@(_isAnnual ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          OnClick="@(() => _isAnnual = true)"
                          Class="h-9 px-6">
                    Annual Billing
                </ButtonCn>
                <ButtonCn Variant="@(!_isAnnual ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          OnClick="@(() => _isAnnual = false)"
                          Class="h-9 px-6">
                    Monthly Billing
                </ButtonCn>
            </div>
        </div>

        <div class="flex items-center justify-center gap-2 border-t bg-muted/30 px-4 py-2.5 text-muted-foreground text-xs">
            <LucideIconCn Name="trending-down" Size="12" Class="size-3 text-emerald-500" />
            <span>Average savings of 2 months free per year</span>
        </div>
    </div>
</section>

@code {
    private bool _isAnnual = false;
    private const int _monthlyPrice = 49;
    private const int _annualPrice = 39;
}
