@* ============================================================
   Block: billing-education-discount-application
   Title: BillingEducationDiscountApplication
   Description: A specialized billing discount form for React and Next.js to handle student, teacher, and academic institution verification and applications built with shadcn/ui and Tailwind CSS.
   Source: original/blocks/billing/billing-education-discount-application.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3 bg-muted/30">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="graduation-cap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Academic Application</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-[10px] uppercase border-primary/20 text-primary bg-primary/5">
                50% Off
            </BadgeCn>
        </div>

        @* Application Form *@
        <div class="p-6 space-y-6">
            <div class="space-y-4">
                <LabelCn Class="text-sm">I am applying as a...</LabelCn>
                <div class="grid grid-cols-3 gap-4">
                    <div class="flex flex-col">
                        <input type="radio" name="role" value="student" id="student" class="peer sr-only"
                               checked="@(_role == "student")" @onchange="@(() => _role = "student")" />
                        <label for="student"
                               class="flex flex-col items-center justify-between rounded-md border-2 border-muted bg-popover p-4 hover:bg-accent hover:text-accent-foreground peer-checked:border-primary cursor-pointer">
                            <LucideIconCn Name="book-open" Size="20" Class="mb-3 size-5" />
                            <span class="text-[10px] uppercase font-bold tracking-wider">Student</span>
                        </label>
                    </div>
                    <div class="flex flex-col">
                        <input type="radio" name="role" value="teacher" id="teacher" class="peer sr-only"
                               checked="@(_role == "teacher")" @onchange="@(() => _role = "teacher")" />
                        <label for="teacher"
                               class="flex flex-col items-center justify-between rounded-md border-2 border-muted bg-popover p-4 hover:bg-accent hover:text-accent-foreground peer-checked:border-primary cursor-pointer">
                            <LucideIconCn Name="graduation-cap" Size="20" Class="mb-3 size-5" />
                            <span class="text-[10px] uppercase font-bold tracking-wider">Educator</span>
                        </label>
                    </div>
                    <div class="flex flex-col">
                        <input type="radio" name="role" value="institution" id="institution" class="peer sr-only"
                               checked="@(_role == "institution")" @onchange="@(() => _role = "institution")" />
                        <label for="institution"
                               class="flex flex-col items-center justify-between rounded-md border-2 border-muted bg-popover p-4 hover:bg-accent hover:text-accent-foreground peer-checked:border-primary cursor-pointer">
                            <LucideIconCn Name="book-open" Size="20" Class="mb-3 size-5" />
                            <span class="text-[10px] uppercase font-bold tracking-wider">School</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="grid gap-4">
                <div class="grid gap-2">
                    <LabelCn For="institution-name" Class="text-xs">Institution Name</LabelCn>
                    <InputCn id="institution-name" Placeholder="University or College" Class="h-9 text-sm" />
                </div>
                <div class="grid gap-2">
                    <LabelCn For="academic-email" Class="text-xs">Academic Email (.edu)</LabelCn>
                    <InputCn id="academic-email" Type="email" Placeholder="name@university.edu" Class="h-9 text-sm" />
                </div>
            </div>

            <div class="border-2 border-dashed rounded-lg p-8 flex flex-col items-center text-center space-y-2 bg-muted/5">
                <div class="size-10 rounded-full bg-muted flex items-center justify-center">
                    <LucideIconCn Name="upload" Size="20" Class="size-5 text-muted-foreground" />
                </div>
                <div class="space-y-1">
                    <p class="text-xs font-medium">Upload ID or Proof of Enrollment</p>
                    <p class="text-[10px] text-muted-foreground">PDF, PNG, or JPG (max 5MB)</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-[10px] uppercase font-bold tracking-wide mt-2">
                    Choose File
                </ButtonCn>
            </div>
        </div>

        @* Savings Preview *@
        <div class="px-6 py-4 bg-primary/5 border-t flex items-center justify-between">
            <div class="flex items-center gap-2 text-primary">
                <LucideIconCn Name="graduation-cap" Size="16" Class="size-4" />
                <span class="text-xs font-semibold">Estimated Monthly Savings</span>
            </div>
            <div class="flex items-baseline gap-1 text-primary">
                <span class="text-sm font-medium">$</span>
                <span class="text-2xl font-bold tracking-tight">@_discountAmount</span>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3 border-t">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                Submit Application
            </ButtonCn>
            <div class="ml-auto flex items-center gap-1 text-muted-foreground">
                <LucideIconCn Name="help-circle" Size="12" Class="size-3" />
                <span class="text-[10px] font-medium underline underline-offset-2">Eligibility Help</span>
            </div>
        </div>
    </div>
</section>

@code {
    private string _role = "student";
    private int _discountAmount => _role == "institution" ? 120 : 15;
}
