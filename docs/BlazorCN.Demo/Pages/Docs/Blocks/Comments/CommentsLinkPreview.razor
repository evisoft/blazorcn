@* ============================================================
   Block: comments-link-preview
   Title: CommentsLinkPreview
   Description: A link preview comment system for React and Next.js with automatic URL detection, rich metadata cards, og:image display, and favicon icons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-link-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Comments</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length @(_comments.Length == 1 ? "comment" : "comments")
            </p>
        </div>

        @* New comment input *@
        <div class="border-b p-4">
            <TextareaCn Value="@_newComment" ValueChanged="@((string v) => HandleCommentChange(v))" Placeholder="Add a comment or paste a link..." Class="min-h-[100px]" aria-label="Add a comment or paste a link..." />

            @if (!string.IsNullOrEmpty(_previewUrl))
            {
                <div class="mt-3 overflow-hidden">
                    <div class="rounded-md border bg-muted/30 p-3">
                        <div class="mb-2 flex items-center gap-1.5">
                            <LucideIconCn Name="link" Size="12" Class="size-3 text-muted-foreground" />
                            <span class="text-xs text-muted-foreground">Link preview loading...</span>
                        </div>
                        <div class="flex gap-3 rounded-md border bg-background p-3">
                            <div class="size-20 shrink-0 rounded bg-muted"></div>
                            <div class="min-w-0 flex-1">
                                <div class="h-4 w-3/4 rounded bg-muted"></div>
                                <div class="mt-2 h-3 w-full rounded bg-muted"></div>
                                <div class="mt-1 h-3 w-2/3 rounded bg-muted"></div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="mt-2 flex justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var comment in _comments)
            {
                var c = comment;
                var initials = GetInitials(c.Author);
                <div class="p-4">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@c.Author</span>
                                <span class="text-xs text-muted-foreground">@c.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed">@c.Content</p>

                            @if (c.Link != null)
                            {
                                var lnk = c.Link;
                                <a href="@lnk.Url" target="_blank" rel="noopener noreferrer"
                                   class="mt-3 block rounded-md border bg-muted/30 transition-colors hover:bg-muted/50">
                                    <div class="flex gap-3 p-3">
                                        @if (!string.IsNullOrEmpty(lnk.Image))
                                        {
                                            <img src="@lnk.Image" alt="@lnk.Title" class="size-20 shrink-0 rounded object-cover" />
                                        }
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-start justify-between gap-2">
                                                <h3 class="line-clamp-2 text-sm font-medium">@lnk.Title</h3>
                                                <LucideIconCn Name="external-link" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                                            </div>
                                            <p class="mt-1 line-clamp-2 text-xs text-muted-foreground">@lnk.Description</p>
                                            <div class="mt-2 flex items-center gap-1.5">
                                                @if (!string.IsNullOrEmpty(lnk.Favicon))
                                                {
                                                    <img src="@lnk.Favicon" alt="" class="size-4" />
                                                }
                                                <span class="text-xs text-muted-foreground">@lnk.Domain</span>
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record LinkPreview(string Url, string Title, string Description, string Domain, string Image = "", string Favicon = "");
    private record CommentData(string Id, string Author, string Content, string Timestamp, LinkPreview? Link = null);

    private static readonly CommentData[] _comments =
    [
        new("1", "Sarah Chen", "Found this great article on React Server Components:", "2 hours ago",
            new LinkPreview(
                "https://react.dev/blog/2023/03/22/react-labs-what-we-have-been-working-on-march-2023",
                "React Labs: What We've Been Working On – March 2023",
                "An update from the React team on new features in development including Server Components, Asset Loading, and more.",
                "react.dev",
                "https://placehold.co/600x315/3b82f6/ffffff?text=React+Labs",
                "https://placehold.co/16x16/3b82f6/ffffff?text=R"
            )),
        new("2", "Alex Morgan", "Excellent resource! Bookmarking this for the team.", "3 hours ago"),
    ];

    private string _newComment = "";
    private string _previewUrl = "";

    private static string? DetectUrl(string text)
    {
        var match = System.Text.RegularExpressions.Regex.Match(text, @"https?://\S+");
        return match.Success ? match.Value : null;
    }

    private void HandleCommentChange(string text)
    {
        _newComment = text;
        var url = DetectUrl(text);
        _previewUrl = url ?? "";
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var initials = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) initials += char.ToUpper(p[0]);
        }
        return initials;
    }
}
