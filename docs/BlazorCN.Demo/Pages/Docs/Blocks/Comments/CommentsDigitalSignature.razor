@* ============================================================
   Block: comments-digital-signature
   Title: CommentsDigitalSignature
   Description: A cryptographically signed comment section for React and Next.js with digital signatures, verification badges, and non-repudiation proof built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-digital-signature.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Digitally Signed Comments</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Cryptographically verified authenticity
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1.5 text-xs">
                    <LucideIconCn Name="key-round" Size="12" Class="size-3" />
                    Signed
                </BadgeCn>
            </div>
        </div>

        @* Info bar *@
        <div class="border-b bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                <span>All comments are cryptographically signed</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>Non-repudiation enforced</span>
            </div>
        </div>

        @* Comment list *@
        <div>
            @for (int i = 0; i < _comments.Length; i++)
            {
                var comment = _comments[i];
                var isLast = i == _comments.Length - 1;
                var isExpanded = _expandedSignature == comment.Id;
                var initials = GetInitials(comment.Author);
                <div class="@(isLast ? "p-4" : "border-b p-4")">
                    <div class="space-y-3">
                        <div class="flex gap-3">
                            <AvatarCn Class="size-8 shrink-0">
                                <AvatarImageCn Src="@comment.Avatar" Alt="@comment.Author" />
                                <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@comment.Author</span>
                                    @if (comment.Verified)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 bg-emerald-500/10 text-[10px] font-normal text-emerald-600 dark:text-emerald-400">
                                            <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                                            Verified
                                        </BadgeCn>
                                    }
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-[10px] font-normal">
                                        <LucideIconCn Name="key-round" Size="10" Class="size-2.5" />
                                        @comment.SignatureAlgorithm
                                    </BadgeCn>
                                    <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                                </div>
                                <p class="mt-1.5 text-sm leading-relaxed">@comment.Content</p>
                            </div>
                        </div>

                        <div class="rounded-md bg-muted/50 p-3">
                            <div class="mb-2 flex items-center justify-between">
                                <div class="flex items-center gap-1.5">
                                    <LucideIconCn Name="fingerprint" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="text-xs font-medium text-muted-foreground">
                                        Digital Signature
                                    </span>
                                </div>
                                @{ var cid = comment.Id; }
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs"
                                          @onclick="@(() => ToggleSignature(cid))">
                                    @(isExpanded ? "Hide" : "View")
                                </ButtonCn>
                            </div>

                            @if (isExpanded)
                            {
                                <div class="space-y-2">
                                    <div>
                                        <span class="text-[10px] text-muted-foreground">Signature:</span>
                                        <p class="mt-0.5 break-all font-mono text-[10px] leading-relaxed text-foreground">
                                            @comment.Signature
                                        </p>
                                    </div>
                                    <div>
                                        <span class="text-[10px] text-muted-foreground">
                                            Public Key Fingerprint:
                                        </span>
                                        <p class="mt-0.5 font-mono text-[10px] text-foreground">
                                            @comment.PublicKeyFingerprint
                                        </p>
                                    </div>
                                    <div>
                                        <span class="text-[10px] text-muted-foreground">Algorithm:</span>
                                        <p class="mt-0.5 font-mono text-[10px] text-foreground">
                                            @comment.SignatureAlgorithm
                                        </p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <p class="truncate font-mono text-xs text-muted-foreground">
                                    @comment.PublicKeyFingerprint
                                </p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t bg-muted/30 px-4 py-2.5">
            <p class="text-xs text-muted-foreground">
                Signatures are legally binding and tamper-evident. Any modification invalidates
                verification.
            </p>
        </div>

    </div>
</section>

@code {
    private record Comment(
        string Id,
        string Author,
        string Avatar,
        string Content,
        string Timestamp,
        string Signature,
        string PublicKeyFingerprint,
        bool Verified,
        string SignatureAlgorithm);

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen",   "", "I hereby approve the transfer of $2.5M to account #8472 for the infrastructure project as authorized by Board Resolution 2026-04-01.",
            "15 min ago",
            "3045022100d5f1a8c2b3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c60221...",
            "SHA256:7f8e9a2b3c4d5e6f", true, "RSA-SHA256"),
        new("2", "James Wilson", "", "Legal counsel confirms: contract terms are binding. I electronically sign this approval on behalf of Acme Corporation.",
            "1 hour ago",
            "304502210098a7b6c5d4e3f2a1b0c9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c10220...",
            "SHA256:a1b2c3d4e5f6a7b8", true, "ECDSA-P256"),
        new("3", "Maya Patel",   "", "Security audit complete. Zero critical vulnerabilities. I certify this system is approved for production deployment.",
            "2 hours ago",
            "ed25519:5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5...",
            "SHA256:9c8d7e6f5a4b3c2d", true, "EdDSA"),
    ];

    private string? _expandedSignature;

    private void ToggleSignature(string id)
    {
        _expandedSignature = _expandedSignature == id ? null : id;
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ');
        var sb = new System.Text.StringBuilder();
        foreach (var part in parts)
        {
            if (part.Length > 0)
                sb.Append(char.ToUpper(part[0]));
        }
        return sb.ToString();
    }
}
