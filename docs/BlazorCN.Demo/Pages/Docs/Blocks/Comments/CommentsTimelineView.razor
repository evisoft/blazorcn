@* ============================================================
   Block: comments-timeline-view
   Title: CommentsTimelineView
   Description: A chronological timeline comment view for React and Next.js with date markers, time grouping, and scroll navigation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-timeline-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Activity Timeline</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length comments across @_groupedComments.Length days
            </p>
        </div>

        @* Groups *@
        <div>
            @for (int gi = 0; gi < _groupedComments.Length; gi++)
            {
                var grp = _groupedComments[gi];
                var isLast = gi == _groupedComments.Length - 1;
                var isExpanded = _expandedDate == grp.Date;
                var capturedGrp = grp;
                var capturedExpanded = isExpanded;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => SetExpanded(capturedGrp.Date, capturedExpanded))"
                            class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="calendar" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <span class="text-sm font-medium">@grp.Date</span>
                        <span class="text-xs text-muted-foreground">
                            @grp.Comments.Length @(grp.Comments.Length == 1 ? "item" : "items")
                        </span>
                        <LucideIconCn Name="chevron-down" Size="16" Class="@Cn.Merge("ml-auto size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-180" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="relative pl-8">
                            <div class="absolute bottom-0 left-7 top-0 w-px bg-border"></div>
                            @for (int ci = 0; ci < grp.Comments.Length; ci++)
                            {
                                var comment = grp.Comments[ci];
                                var isLastComment = ci == grp.Comments.Length - 1;
                                var initials = GetInitials(comment.Author);
                                <div class="@(isLastComment ? "pb-3" : "")">
                                    <div class="flex gap-3 py-3 pr-4">
                                        <div class="relative">
                                            <AvatarCn Class="size-8 shrink-0 border-2 border-background">
                                                <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                                            </AvatarCn>
                                        </div>
                                        <div class="min-w-0 flex-1">
                                            <div class="flex items-baseline gap-2">
                                                <span class="text-sm font-medium">@comment.Author</span>
                                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                                            </div>
                                            <p class="mt-0.5 text-sm text-muted-foreground">@comment.Content</p>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5 text-center">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Load earlier activity
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private string? _expandedDate = "Today";

    private record Comment(string Id, string Author, string Content, string Timestamp, string Date);

    private record CommentGroup(string Date, Comment[] Comments);

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen",   "Initial design mockups uploaded for review",             "9:15 AM",  "Today"),
        new("2", "Alex Morgan",  "Added accessibility audit checklist to the project",     "11:30 AM", "Today"),
        new("3", "Maya Patel",   "Completed user testing session with 8 participants",     "2:45 PM",  "Today"),
        new("4", "James Wilson", "Approved color palette and typography system",           "10:20 AM", "Yesterday"),
        new("5", "Chris Taylor", "Started implementation of navigation component",         "3:00 PM",  "Yesterday"),
        new("6", "Sarah Chen",   "Finalized wireframes for mobile responsive layout",      "9:00 AM",  "Mar 28"),
        new("7", "Alex Morgan",  "Updated project roadmap with Q2 milestones",             "1:15 PM",  "Mar 28"),
    ];

    private static readonly CommentGroup[] _groupedComments =
    [
        new("Today",     _comments[0..3]),
        new("Yesterday", _comments[3..5]),
        new("Mar 28",    _comments[5..7]),
    ];

    private void SetExpanded(string date, bool currentlyExpanded)
    {
        _expandedDate = currentlyExpanded ? null : date;
    }

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();
}
