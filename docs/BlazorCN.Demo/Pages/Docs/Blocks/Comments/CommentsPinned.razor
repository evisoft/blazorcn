@* ============================================================
   Block: comments-pinned
   Title: CommentsPinned
   Description: A comment section with pinned comments and sorting for React and Next.js featuring sticky pins, sort controls, and moderator actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-pinned.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <h2 class="text-sm font-medium">Discussion</h2>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_comments.Count comments@(PinnedCount > 0 ? $" · {PinnedCount} pinned" : "")
                </p>
            </div>
            <SelectCn @bind-Value="_sortBy">
                <SelectTriggerCn Class="h-7 w-32 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="newest">Newest first</SelectItemCn>
                    <SelectItemCn Value="oldest">Oldest first</SelectItemCn>
                    <SelectItemCn Value="popular">Most popular</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
        </div>

        @* Comment list *@
        <div class="relative divide-y">
            @foreach (var comment in SortedComments)
            {
                var c = comment;
                var initials = GetInitials(c.Author);
                <div class="@Cn.Merge("flex gap-3 px-4 py-3 relative", c.Pinned ? "bg-blue-500/5" : null)">
                    @if (c.Pinned)
                    {
                        <div class="absolute left-0 top-0 h-full w-1 bg-blue-500"></div>
                    }

                    <AvatarCn Class="size-8 shrink-0">
                        <AvatarImageCn Src="@c.Avatar" Alt="@c.Author" />
                        <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                    </AvatarCn>

                    <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-2">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@c.Author</span>
                                @if (c.IsModerator)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px]">Mod</BadgeCn>
                                }
                                @if (c.Pinned)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 gap-1 bg-blue-500/10 px-1.5 text-[10px] text-blue-600 dark:text-blue-400">
                                        <LucideIconCn Name="pin" Size="10" Class="size-2.5" />
                                        Pinned
                                    </BadgeCn>
                                }
                                <span class="text-xs text-muted-foreground">@c.Timestamp</span>
                            </div>

                            @if (_isMod)
                            {
                                var cId = c.Id;
                                var isPinned = c.Pinned;
                                <DropdownMenuCn>
                                    <DropdownMenuTriggerCn AsChild="true">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-6 shrink-0 text-muted-foreground">
                                            <LucideIconCn Name="more-vertical" Size="14" Class="size-3.5" />
                                        </ButtonCn>
                                    </DropdownMenuTriggerCn>
                                    <DropdownMenuContentCn Align="FloatingAlign.End">
                                        <DropdownMenuItemCn OnClick="@(() => TogglePin(cId))">
                                            @if (isPinned)
                                            {
                                                <LucideIconCn Name="pin-off" Size="14" Class="mr-2 size-3.5" />
                                                <span>Unpin comment</span>
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="pin" Size="14" Class="mr-2 size-3.5" />
                                                <span>Pin comment</span>
                                            }
                                        </DropdownMenuItemCn>
                                        <DropdownMenuSeparatorCn />
                                        <DropdownMenuItemCn Class="text-red-600 dark:text-red-400" OnClick="@(() => DeleteComment(cId))">
                                            <LucideIconCn Name="trash" Size="14" Class="mr-2 size-3.5" />
                                            Delete comment
                                        </DropdownMenuItemCn>
                                    </DropdownMenuContentCn>
                                </DropdownMenuCn>
                            }
                        </div>

                        <p class="mt-1 text-sm leading-relaxed">@c.Content</p>

                        <div class="mt-2 flex items-center gap-3">
                            <span class="text-xs text-muted-foreground">@c.Score points</span>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">
                                Reply
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record CommentData(string Id, string Author, string Avatar, string Content, string Timestamp, bool Pinned, int Score, bool IsModerator);

    private List<CommentData> _comments =
    [
        new("1", "Community Mod", "", "Welcome to the discussion! Please keep comments respectful and on-topic. See our community guidelines for more details.", "1d ago", true, 45, true),
        new("2", "Tech Lead", "", "Important: The new API breaking changes will be released next week. Migration guide is available in the docs.", "12h ago", true, 89, true),
        new("3", "Sarah Johnson", "", "Just migrated our entire codebase to the new version. The performance improvements are real - seeing 2x faster load times!", "3h ago", false, 23, false),
        new("4", "Alex Chen", "", "Has anyone else experienced issues with SSR? Getting hydration errors on the user profile component.", "2h ago", false, 12, false),
        new("5", "Maya Rodriguez", "", "The TypeScript types are so much better now. Autocomplete works perfectly in VS Code.", "1h ago", false, 34, false),
    ];

    private string _sortBy = "newest";
    private readonly bool _isMod = true;

    private int PinnedCount => _comments.Count(c => c.Pinned);

    private IEnumerable<CommentData> SortedComments
    {
        get
        {
            var pinned = _comments.Where(c => c.Pinned);
            var unpinned = _comments.Where(c => !c.Pinned);
            IEnumerable<CommentData> sorted = _sortBy switch
            {
                "popular" => unpinned.OrderByDescending(c => c.Score),
                "oldest"  => unpinned,
                _         => unpinned.Reverse(),
            };
            return pinned.Concat(sorted);
        }
    }

    private void TogglePin(string id)
    {
        var idx = _comments.FindIndex(c => c.Id == id);
        if (idx >= 0)
        {
            var c = _comments[idx];
            _comments[idx] = c with { Pinned = !c.Pinned };
        }
    }

    private void DeleteComment(string id)
    {
        _comments.RemoveAll(c => c.Id == id);
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var initials = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) initials += char.ToUpper(p[0]);
        }
        return initials;
    }
}
