@* ============================================================
   Block: comments-screen-recording
   Title: CommentsScreenRecording
   Description: Attach screen recordings to comments for React and Next.js with recording capture, thumbnail preview, and playback modal built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-screen-recording.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Screen Recordings</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_comments.Length recordings · Show and tell with video
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="@(() => _showRecordingForm = !_showRecordingForm)">
                    <LucideIconCn Name="monitor" Size="12" Class="size-3" />
                    Record screen
                </ButtonCn>
            </div>
        </div>

        @* Recording form panel *@
        @if (_showRecordingForm)
        {
            <div class="border-b bg-muted/30 p-4">
                <div class="rounded-lg border bg-card p-4">
                    @if (!_isRecording)
                    {
                        <div class="mb-3 flex items-center gap-2">
                            <LucideIconCn Name="monitor" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm font-medium">Start screen recording</span>
                        </div>
                        <p class="mb-3 text-xs text-muted-foreground">
                            Choose which screen or window to record. System audio will be included.
                        </p>
                        <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs" OnClick="@(() => _isRecording = true)">
                            <LucideIconCn Name="video" Size="12" Class="size-3" />
                            Start recording
                        </ButtonCn>
                    }
                    else
                    {
                        <div class="mb-3 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="animate-pulse bg-red-500/10 text-xs font-normal text-red-600 dark:text-red-400">
                                    <span class="size-1.5 rounded-full bg-red-500"></span>
                                    <span class="ml-1.5">Recording</span>
                                </BadgeCn>
                                <span class="font-mono text-sm font-medium tabular-nums">
                                    0:@(_recordingTime.ToString().PadLeft(2, '0'))
                                </span>
                            </div>
                        </div>
                        <div class="mb-3 aspect-video rounded-md border bg-zinc-950"></div>
                        <div class="flex gap-2">
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 text-xs" OnClick="StopRecording">
                                Stop recording
                            </ButtonCn>
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-8 text-xs" OnClick="CancelRecording">
                                Cancel
                            </ButtonCn>
                        </div>
                    }
                </div>

                @if (!_isRecording)
                {
                    <div class="mt-3">
                        <TextareaCn @bind-Value="_newComment" Placeholder="Add a description for your recording..." Class="min-h-[80px] text-sm" />
                        <div class="mt-2 flex justify-end">
                            <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                                Post comment
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        }

        @* Comment list *@
        <div>
            @for (var i = 0; i < _comments.Length; i++)
            {
                var comment = _comments[i];
                var isLast = i == _comments.Length - 1;
                var initials = GetInitials(comment.Author);
                <div class="@(isLast ? "p-4" : "border-b p-4")">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed">@comment.Content</p>

                            <div class="mt-3 overflow-hidden rounded-lg border bg-muted/30">
                                <button type="button" class="group relative block w-full">
                                    <div class="aspect-video bg-zinc-950">
                                        <div class="flex size-full items-center justify-center">
                                            <div class="flex items-center gap-2 rounded-full bg-black/60 px-4 py-2 backdrop-blur-sm transition-transform group-hover:scale-105">
                                                <LucideIconCn Name="play" Size="16" Class="size-4 text-zinc-100" />
                                                <span class="text-sm text-zinc-100">Play recording</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="absolute bottom-2 left-2 rounded bg-black/80 px-2 py-0.5 font-mono text-xs text-zinc-100">
                                        @comment.Duration
                                    </div>
                                </button>
                                <div class="flex items-center justify-between border-t px-3 py-2">
                                    <span class="text-xs text-muted-foreground">@comment.FileSize</span>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                        <LucideIconCn Name="download" Size="12" Class="size-3" />
                                        Download
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                Recordings saved as WebM video files
            </span>
        </div>

    </div>
</section>

@code {
    private record RecordingComment(string Id, string Author, string Content, string Duration, string FileSize, string Timestamp);

    private static readonly RecordingComment[] _comments =
    [
        new("1", "Sarah Chen",  "Navigation menu animation stutters on Safari. See the recording for details.",          "0:24", "3.2 MB", "2 hours ago"),
        new("2", "Alex Morgan", "Form validation error messages don't appear in the correct position on mobile.",        "0:18", "2.1 MB", "1 hour ago"),
        new("3", "Maya Patel",  "Walkthrough of the complete checkout flow showing the new payment integration.",        "1:32", "8.4 MB", "30 min ago"),
    ];

    private bool _isRecording = false;
    private int _recordingTime = 0;
    private bool _showRecordingForm = false;
    private string _newComment = "";

    private void StopRecording()
    {
        _isRecording = false;
        _recordingTime = 0;
    }

    private void CancelRecording()
    {
        _isRecording = false;
        _recordingTime = 0;
        _showRecordingForm = false;
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var result = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) result += char.ToUpper(p[0]);
        }
        return result;
    }
}
