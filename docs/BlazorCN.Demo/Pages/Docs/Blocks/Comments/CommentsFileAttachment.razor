@* ============================================================
   Block: comments-file-attachment
   Title: CommentsFileAttachment
   Description: A file attachment comment system for React and Next.js with multi-file upload, file preview cards, size limits, and delete functionality built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-file-attachment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Comments</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length @(_comments.Length == 1 ? "comment" : "comments")
            </p>
        </div>

        @* New comment input area *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_newComment" Placeholder="Add a comment..." Class="min-h-[100px]" />

            @if (_attachments.Count > 0)
            {
                <div class="mt-3 space-y-2 overflow-hidden">
                    @foreach (var att in _attachments)
                    {
                        var a = att;
                        <div class="flex items-center gap-3 rounded-md border bg-muted/30 px-3 py-2">
                            <LucideIconCn Name="@GetFileIconName(a.Type)" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-sm font-medium">@a.Name</p>
                                <p class="text-xs text-muted-foreground">@FormatFileSize(a.Size)</p>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="size-6 shrink-0" OnClick="@(() => RemoveAttachment(a.Id))">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    }
                </div>
            }

            <div class="mt-2 flex items-center justify-between">
                <label for="file-upload">
                    <input id="file-upload" type="file" multiple class="sr-only" />
                    <span class="inline-flex h-7 cursor-pointer items-center gap-1 rounded-md px-2 text-xs text-muted-foreground hover:bg-accent hover:text-accent-foreground">
                        <LucideIconCn Name="paperclip" Size="12" Class="size-3" />
                        Attach files
                    </span>
                </label>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var comment in _comments)
            {
                var c = comment;
                var initials = GetInitials(c.Author);
                <div class="p-4">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@c.Author</span>
                                <span class="text-xs text-muted-foreground">@c.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed">@c.Content</p>

                            @if (c.Attachments.Length > 0)
                            {
                                <div class="mt-3 space-y-2">
                                    @foreach (var att in c.Attachments)
                                    {
                                        var f = att;
                                        <div class="flex items-center gap-3 rounded-md border bg-muted/30 px-3 py-2">
                                            <LucideIconCn Name="@GetFileIconName(f.Type)" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                                            <div class="min-w-0 flex-1">
                                                <p class="truncate text-sm font-medium">@f.Name</p>
                                                <p class="text-xs text-muted-foreground">@FormatFileSize(f.Size)</p>
                                            </div>
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                                <LucideIconCn Name="download" Size="12" Class="size-3" />
                                                Download
                                            </ButtonCn>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Attachment(string Id, string Name, long Size, string Type);
    private record CommentData(string Id, string Author, string Content, string Timestamp, Attachment[] Attachments);

    private static readonly CommentData[] _comments =
    [
        new("1", "Sarah Chen",
            "Here's the updated design spec. Let me know if you need any adjustments to the layout.",
            "2 hours ago",
            [
                new("a1", "design-spec-v2.pdf", 2400000, "application/pdf"),
                new("a2", "mockup-final.png", 1800000, "image/png"),
            ]),
        new("2", "Alex Morgan",
            "Added the error logs from production. This should help debug the issue.",
            "4 hours ago",
            [
                new("a3", "error-logs-2026-04-04.txt", 45000, "text/plain"),
            ]),
    ];

    private string _newComment = "";
    private readonly List<Attachment> _attachments = [];

    private void RemoveAttachment(string id)
    {
        _attachments.RemoveAll(a => a.Id == id);
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{(bytes / 1024.0):F1} KB";
        return $"{(bytes / (1024.0 * 1024.0)):F1} MB";
    }

    private static string GetFileIconName(string type)
    {
        if (type.StartsWith("image/")) return "image";
        return "file";
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var initials = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) initials += char.ToUpper(p[0]);
        }
        return initials;
    }
}
