@* ============================================================
   Block: comments-folder-organization
   Title: CommentsFolderOrganization
   Description: A comment folder manager for React and Next.js with drag-drop organization, nested folders, and move operations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-folder-organization.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Comment Folders</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_items.Count folders · @_comments.Length comments
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="@(() => _showNewFolder = !_showNewFolder)">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    New folder
                </ButtonCn>
            </div>
        </div>

        @* New folder input *@
        @if (_showNewFolder)
        {
            <div class="overflow-hidden border-b bg-muted/20 px-4 py-3">
                <div class="flex items-center gap-2">
                    <InputCn @bind-Value="_newFolderName" Placeholder="Folder name..." Class="h-8 text-sm" />
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" OnClick="AddFolder">
                        Create
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs" OnClick="CancelNewFolder">
                        Cancel
                    </ButtonCn>
                </div>
            </div>
        }

        @* Folder tree *@
        <div class="space-y-0.5 p-2">
            @RenderFolders(null, 0)
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5 text-xs text-muted-foreground">
            Drag and drop to reorganize
        </div>

    </div>
</section>

@code {
    private record FolderData(string Id, string Name, string? ParentId, bool Expanded);
    private record CommentData(string Id, string Author, string Content, string FolderId);

    private static readonly CommentData[] _comments =
    [
        new("1", "Sarah Chen",  "Add dark mode toggle to settings panel",       "3"),
        new("2", "James Wilson","Reduce bundle size by lazy loading components", "4"),
        new("3", "Maya Patel",  "Login fails with special characters in password","5"),
        new("4", "Alex Morgan", "Typo in dashboard header",                      "6"),
        new("5", "Chris Taylor","Great documentation, very helpful!",            "7"),
        new("6", "Jordan Lee",  "Support for custom themes would be amazing",    "3"),
    ];

    private List<FolderData> _items =
    [
        new("1", "Feature Requests", null,  true),
        new("2", "Bug Reports",      null,  true),
        new("3", "UI/UX",            "1",   false),
        new("4", "Performance",      "1",   false),
        new("5", "Critical",         "2",   true),
        new("6", "Minor",            "2",   false),
        new("7", "General",          null,  true),
    ];

    private string _newFolderName = "";
    private bool _showNewFolder = false;

    private void ToggleFolder(string id)
    {
        var idx = _items.FindIndex(f => f.Id == id);
        if (idx >= 0)
        {
            var f = _items[idx];
            _items[idx] = f with { Expanded = !f.Expanded };
        }
    }

    private void AddFolder()
    {
        if (string.IsNullOrWhiteSpace(_newFolderName)) return;
        var newFolder = new FolderData(
            Id: (_items.Count + 1).ToString(),
            Name: _newFolderName,
            ParentId: null,
            Expanded: true
        );
        _items.Add(newFolder);
        _newFolderName = "";
        _showNewFolder = false;
    }

    private void CancelNewFolder()
    {
        _showNewFolder = false;
        _newFolderName = "";
    }

    private RenderFragment RenderFolders(string? parentId, int depth) => __builder =>
    {
        foreach (var folder in _items.Where(f => f.ParentId == parentId))
        {
            var fld = folder;
            var childFolders = _items.Where(f => f.ParentId == fld.Id).ToList();
            var folderComments = _comments.Where(c => c.FolderId == fld.Id).ToList();
            var totalComments = folderComments.Count;
            var paddingLeft = depth * 12 + 8;
            var childPaddingLeft = (depth + 1) * 12 + 8;

            <div>
                <button type="button"
                        @onclick="@(() => ToggleFolder(fld.Id))"
                        class="flex w-full items-center gap-2 rounded-md px-2 py-1.5 text-left transition-colors hover:bg-muted/50"
                        style="@($"padding-left:{paddingLeft}px")">
                    @if (childFolders.Count > 0)
                    {
                        <LucideIconCn Name="chevron-right" Size="12" Class="@Cn.Merge("size-3 shrink-0 text-muted-foreground transition-transform", fld.Expanded ? "rotate-90" : "")" />
                    }
                    else
                    {
                        <span class="w-3 shrink-0"></span>
                    }
                    @if (fld.Expanded)
                    {
                        <LucideIconCn Name="folder-open" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    else
                    {
                        <LucideIconCn Name="folder" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    }
                    <span class="min-w-0 flex-1 truncate text-sm font-medium">@fld.Name</span>
                    @if (totalComments > 0)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px] font-normal tabular-nums">
                            @totalComments
                        </BadgeCn>
                    }
                </button>

                @if (fld.Expanded)
                {
                    <div class="overflow-hidden">
                        @RenderFolders(fld.Id, depth + 1)
                        @foreach (var comment in folderComments)
                        {
                            var cmt = comment;
                            <div class="flex items-start gap-2 rounded-md px-2 py-1.5 transition-colors hover:bg-muted/30"
                                 style="@($"padding-left:{childPaddingLeft}px")">
                                <LucideIconCn Name="message-circle" Size="12" Class="mt-0.5 size-3 shrink-0 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <span class="block text-xs font-medium">@cmt.Author</span>
                                    <p class="mt-0.5 truncate text-xs text-muted-foreground">@cmt.Content</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    };
}
