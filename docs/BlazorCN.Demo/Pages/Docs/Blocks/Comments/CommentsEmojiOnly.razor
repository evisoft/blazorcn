@* ============================================================
   Block: comments-emoji-only
   Title: CommentsEmojiOnly
   Description: An emoji-only quick feedback comment system for React and Next.js with emoji picker, reaction counts, and filter-by-emoji functionality built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-emoji-only.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Quick Feedback</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_reactions.Sum(r => r.Users.Length) reactions
            </p>
        </div>

        @* Reaction buttons + add picker *@
        <div class="p-4">
            <div class="flex flex-wrap items-center gap-2">
                @foreach (var reaction in SortedReactions)
                {
                    var r = reaction;
                    var hasReacted = _userReactions.Contains(r.Emoji);
                    <button type="button"
                            class="@Cn.Merge("flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-sm transition-all hover:bg-muted/50", hasReacted ? "border-blue-500/50 bg-blue-500/10" : "border-border bg-background")"
                            @onclick="@(() => ToggleReaction(r.Emoji))">
                        <span class="text-base">@r.Emoji</span>
                        <span class="text-xs font-medium text-muted-foreground">@r.Users.Length</span>
                    </button>
                }

                <div class="relative">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                              Class="h-8 gap-1 rounded-full px-3 text-xs"
                              OnClick="@(() => _showPicker = !_showPicker)">
                        <LucideIconCn Name="plus" Size="12" Class="size-3" />
                        Add reaction
                    </ButtonCn>

                    @if (_showPicker)
                    {
                        <div class="absolute left-0 top-full z-10 mt-2 rounded-lg border bg-popover p-3 shadow-lg">
                            <div class="grid grid-cols-4 gap-1">
                                @foreach (var emoji in _availableEmojis)
                                {
                                    var e = emoji;
                                    <button type="button"
                                            class="flex size-10 items-center justify-center rounded-md text-xl transition-colors hover:bg-muted"
                                            @onclick="@(() => PickEmoji(e))">
                                        @e
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Reaction detail rows (top 3) *@
        <div class="divide-y">
            @foreach (var reaction in SortedReactions.Take(3))
            {
                var r = reaction;
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <span class="text-2xl">@r.Emoji</span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">
                                    @r.Users.Length @(r.Users.Length == 1 ? "person" : "people")
                                </span>
                            </div>
                            <div class="mt-1 flex flex-wrap gap-1">
                                @foreach (var user in r.Users)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">@user</BadgeCn>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record EmojiReaction(string Emoji, string[] Users);

    private static readonly string[] _availableEmojis = ["👍", "❤️", "😂", "🎉", "🤔", "👀", "🔥", "🚀"];

    private static readonly EmojiReaction[] _reactions =
    [
        new("👍", ["Sarah Chen", "Alex Morgan", "Maya Patel"]),
        new("❤️", ["James Wilson", "Chris Taylor"]),
        new("🎉", ["Sarah Chen", "Maya Patel"]),
        new("🤔", ["Alex Morgan"]),
    ];

    private bool _showPicker = false;
    private readonly HashSet<string> _userReactions = ["👍"];

    private IEnumerable<EmojiReaction> SortedReactions =>
        _reactions.OrderByDescending(r => r.Users.Length);

    private void ToggleReaction(string emoji)
    {
        if (_userReactions.Contains(emoji))
            _userReactions.Remove(emoji);
        else
            _userReactions.Add(emoji);
    }

    private void PickEmoji(string emoji)
    {
        ToggleReaction(emoji);
        _showPicker = false;
    }
}
