@* ============================================================
   Block: comments-collaborative-editing
   Title: CommentsCollaborativeEditing
   Description: React comment block for Next.js with real-time co-editing, presence indicators, and conflict resolution built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-collaborative-editing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header: active editors + save status *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Collaborative comment</h2>
                    <div class="mt-1 flex items-center gap-2">
                        <div class="flex items-center -space-x-2">
                            @foreach (var editor in _activeEditors)
                            {
                                var ed = editor;
                                var initials = GetInitials(ed.Name);
                                <AvatarCn Class="size-5 border-2 border-background">
                                    <AvatarImageCn Src="@ed.Avatar" Alt="@ed.Name" />
                                    <AvatarFallbackCn Class="text-[8px]">@initials</AvatarFallbackCn>
                                </AvatarCn>
                            }
                        </div>
                        <span class="text-xs text-muted-foreground">
                            @_activeEditors.Length @(_activeEditors.Length == 1 ? "editor" : "editors") active
                        </span>
                    </div>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 text-[10px] font-normal">
                    @if (_saving)
                    {
                        <LucideIconCn Name="save" Size="10" Class="size-2.5 animate-pulse" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Saved @_lastSaved</span>
                    }
                </BadgeCn>
            </div>
        </div>

        @* Textarea *@
        <div class="border-b p-4">
            <TextareaCn Value="@_content" ValueChanged="@HandleContentChange" Placeholder="Write your comment..." Class="min-h-[120px]" />
        </div>

        @* Typing indicators *@
        @if (_typingEditors.Length > 0)
        {
            <div class="border-b px-4 py-2.5">
                <div class="flex items-center gap-2">
                    @foreach (var editor in _typingEditors)
                    {
                        var ed = editor;
                        <div class="flex items-center gap-1.5">
                            <span class="@($"size-1.5 animate-pulse rounded-full {ed.Color}")"></span>
                            <span class="text-xs text-muted-foreground">@ed.Name is typing...</span>
                        </div>
                    }
                </div>
            </div>
        }

        @* Active editors list *@
        <div class="border-b px-4 py-3">
            <div class="mb-2.5 text-xs font-medium text-muted-foreground">Active editors</div>
            <div class="space-y-2">
                @foreach (var editor in _activeEditors)
                {
                    var ed = editor;
                    var initials = GetInitials(ed.Name);
                    <div class="flex items-center gap-2.5">
                        <AvatarCn Class="size-6">
                            <AvatarImageCn Src="@ed.Avatar" Alt="@ed.Name" />
                            <AvatarFallbackCn Class="text-[10px]">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="flex items-center gap-2">
                            <span class="text-sm">@ed.Name</span>
                            @if (ed.Typing)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 text-[10px] font-normal">
                                    <span class="@($"size-1.5 animate-pulse rounded-full {ed.Color}")"></span>
                                    <span>Typing</span>
                                </BadgeCn>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-3">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="users" Size="12" Class="size-3" />
                <span>Changes are synced in real-time across all editors</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record ActiveEditor(string Id, string Name, string Avatar, string Color, bool Typing);

    private static readonly ActiveEditor[] _activeEditors =
    [
        new("1", "Alex Morgan", "", "bg-blue-500", false),
        new("2", "Maya Patel", "", "bg-purple-500", true),
    ];

    private string _content = "The new authentication flow should include OAuth providers for Google, GitHub, and Microsoft. We also need to implement 2FA support with authenticator apps.";
    private bool _saving = false;
    private string _lastSaved = "2 min ago";

    private ActiveEditor[] _typingEditors => [.. System.Linq.Enumerable.Where(_activeEditors, e => e.Typing)];

    private System.Threading.CancellationTokenSource? _saveCts;

    private async Task HandleContentChange(string value)
    {
        _content = value;
        _saving = true;
        _saveCts?.Cancel();
        _saveCts = new System.Threading.CancellationTokenSource();
        var token = _saveCts.Token;
        try
        {
            await Task.Delay(1000, token);
            _saving = false;
            _lastSaved = "Just now";
        }
        catch (TaskCanceledException)
        {
            // superseded by a newer keystroke
        }
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ');
        var result = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) result += char.ToUpper(p[0]);
        }
        return result;
    }
}
