@* ============================================================
   Block: comments-ai-translation
   Title: CommentsAiTranslation
   Description: An AI-powered translation comment system for React and Next.js with automatic language detection, one-click translation, language badges, and bilingual comment display built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-ai-translation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Comments</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_totalComments @(_totalComments == 1 ? "comment" : "comments")
                    </p>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="globe" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">@_translatedCount available</span>
                </div>
            </div>
        </div>

        @* New comment textarea *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_newComment" Placeholder="Add a comment in any language..." Class="min-h-[100px]" />
            <div class="mt-2 flex justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var comment in _comments)
            {
                var initials = GetInitials(comment.Author);
                var showTranslation = _showTranslations.ContainsKey(comment.Id) && _showTranslations[comment.Id];
                var hasTranslation = comment.Translation is not null;
                var isNonEnglish = comment.OriginalLanguage != "en";
                var cid = comment.Id;

                <div class="p-4">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto gap-1 text-xs font-normal">
                                    <LucideIconCn Name="languages" Size="12" Class="size-3" />
                                    @GetLanguageName(comment.OriginalLanguage)
                                </BadgeCn>
                            </div>

                            @if (showTranslation && hasTranslation)
                            {
                                <p class="mt-1 text-sm leading-relaxed">
                                    @comment.Translation!.Text
                                </p>
                                <div class="mt-2 rounded-md bg-muted/50 p-2.5">
                                    <div class="mb-1 flex items-center justify-between">
                                        <span class="text-[10px] font-medium uppercase text-muted-foreground">
                                            Original (@GetLanguageName(comment.OriginalLanguage))
                                        </span>
                                        <span class="text-[10px] text-muted-foreground">
                                            @comment.Translation.Confidence% confidence
                                        </span>
                                    </div>
                                    <p class="text-sm italic text-muted-foreground">
                                        @comment.Content
                                    </p>
                                </div>
                            }
                            else
                            {
                                <p class="mt-1 text-sm leading-relaxed">
                                    @comment.Content
                                </p>
                            }

                            @if (hasTranslation && isNonEnglish)
                            {
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="mt-2 h-6 gap-1 px-2 text-xs" OnClick="@(() => ToggleTranslation(cid))">
                                    <LucideIconCn Name="languages" Size="12" Class="size-3" />
                                    @(showTranslation ? "Show original" : "Translate")
                                </ButtonCn>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Translation(string Language, string Text, int Confidence);

    private record Comment(
        string Id,
        string Author,
        string Content,
        string Timestamp,
        string OriginalLanguage,
        Translation? Translation = null
    );

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen",   "This is an excellent tutorial! Very clear explanations.",             "2 hours ago", "en"),
        new("2", "Jean Dupont",  "Merci beaucoup pour ce guide détaillé. C'est très utile!",            "2 hours ago", "fr",
            new("en", "Thank you very much for this detailed guide. It's very useful!", 98)),
        new("3", "María García", "¿Hay una versión en español de esta documentación?",                   "1 hour ago",  "es",
            new("en", "Is there a Spanish version of this documentation?", 95)),
        new("4", "Yuki Tanaka",  "素晴らしいコンテンツです。もっと学びたいです。",                         "1 hour ago",  "ja",
            new("en", "This is wonderful content. I want to learn more.", 92)),
        new("5", "Hans Müller",  "Die Beispiele sind sehr praktisch und gut erklärt.",                   "45 min ago",  "de",
            new("en", "The examples are very practical and well explained.", 96)),
    ];

    private static readonly Dictionary<string, string> _languageNames = new()
    {
        ["en"] = "English",
        ["fr"] = "Français",
        ["es"] = "Español",
        ["ja"] = "日本語",
        ["de"] = "Deutsch",
        ["zh"] = "中文",
        ["ko"] = "한국어",
        ["pt"] = "Português",
        ["ru"] = "Русский",
        ["ar"] = "العربية",
    };

    private string _newComment = "";

    private Dictionary<string, bool> _showTranslations = new()
    {
        ["2"] = true,
        ["3"] = true,
        ["4"] = true,
        ["5"] = true,
    };

    private int _totalComments => _comments.Length;
    private int _translatedCount => _comments.Count(c => c.Translation is not null);

    private void ToggleTranslation(string commentId)
    {
        if (_showTranslations.ContainsKey(commentId))
            _showTranslations[commentId] = !_showTranslations[commentId];
        else
            _showTranslations[commentId] = true;
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        return string.Concat(parts.Select(p => p.Length > 0 ? char.ToUpper(p[0]).ToString() : ""));
    }

    private static string GetLanguageName(string code)
        => _languageNames.TryGetValue(code, out var name) ? name : code;
}
