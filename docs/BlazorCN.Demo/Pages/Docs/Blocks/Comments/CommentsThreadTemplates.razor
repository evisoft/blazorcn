@* ============================================================
   Block: comments-thread-templates
   Title: CommentsThreadTemplates
   Description: React comment block for Next.js with pre-filled forms, structured templates, and guided comment creation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-thread-templates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Create from template</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Use structured forms for better feedback
                    </p>
                </div>
                @if (_currentTemplate != null)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 text-[10px] font-normal">
                        <LucideIconCn Name="file-text" Size="10" Class="size-2.5" />
                        @_currentTemplate.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Template selection or form *@
        @if (_selectedTemplate == null)
        {
            <div class="p-4">
                <div class="mb-3 text-xs font-medium text-muted-foreground">
                    Select a template
                </div>
                <div class="space-y-2">
                    @foreach (var tmpl in _templates)
                    {
                        var t = tmpl;
                        <button type="button"
                                class="flex w-full items-start gap-3 rounded-md border p-3 text-left transition-colors hover:bg-muted/50"
                                @onclick="@(() => SelectTemplate(t.Id))">
                            <LucideIconCn Name="file-text" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="block text-sm font-medium">@t.Name</span>
                                <span class="mt-0.5 block text-xs text-muted-foreground">
                                    @t.Description
                                </span>
                                <div class="mt-1.5 flex items-center gap-1.5 text-[10px] text-muted-foreground">
                                    <span>@t.Fields.Length fields</span>
                                    <span>·</span>
                                    <span>@(t.Fields.Count(f => f.Required)) required</span>
                                </div>
                            </div>
                        </button>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="p-4">
                <div class="space-y-4">
                    @foreach (var fld in _currentTemplate!.Fields)
                    {
                        var field = fld;
                        <div>
                            <label class="block">
                                <div class="mb-1.5 flex items-center gap-1.5">
                                    <span class="text-xs font-medium">@field.Label</span>
                                    @if (field.Required)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                            Required
                                        </BadgeCn>
                                    }
                                </div>
                                @if (field.FieldType == "text")
                                {
                                    <InputCn Value="@GetFieldValue(field.Id)"
                                             ValueChanged="@((string v) => SetFieldValue(field.Id, v))"
                                             Placeholder="@field.Placeholder"
                                             Class="h-8 text-sm" />
                                }
                                @if (field.FieldType == "textarea")
                                {
                                    <TextareaCn Value="@GetFieldValue(field.Id)"
                                                ValueChanged="@((string v) => SetFieldValue(field.Id, v))"
                                                Placeholder="@field.Placeholder"
                                                Class="min-h-[80px] text-sm" />
                                }
                            </label>
                        </div>
                    }
                </div>
                <div class="mt-4 flex gap-2">
                    <ButtonCn Size="ButtonSize.Sm"
                              Class="h-8 flex-1 gap-1 text-xs"
                              OnClick="HandleSubmit"
                              Disabled="@(!IsFormValid() || _submitted)">
                        @if (_submitted)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                            <span>Submitted</span>
                        }
                        else
                        {
                            <span>Submit @_currentTemplate!.Name.ToLower()</span>
                        }
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="h-8 text-xs"
                              OnClick="CancelForm">
                        Cancel
                    </ButtonCn>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record TemplateField(string Id, string Label, string FieldType, bool Required, string Placeholder);
    private record Template(string Id, string Name, string Description, TemplateField[] Fields);

    private static readonly Template[] _templates =
    [
        new("bug-report", "Bug Report", "Report a software defect",
        [
            new("title",       "Bug title",           "text",     true,  "Concise description of the bug"),
            new("steps",       "Steps to reproduce",  "textarea", true,  "1. Go to...\n2. Click on...\n3. See error"),
            new("expected",    "Expected behavior",   "textarea", true,  "What should happen"),
            new("actual",      "Actual behavior",     "textarea", true,  "What actually happens"),
            new("environment", "Environment",         "text",     false, "Browser, OS, version"),
        ]),
        new("feature-request", "Feature Request", "Suggest a new feature",
        [
            new("title",        "Feature title",         "text",     true,  "Brief feature description"),
            new("problem",      "Problem statement",     "textarea", true,  "What problem does this solve?"),
            new("solution",     "Proposed solution",     "textarea", true,  "How should this work?"),
            new("alternatives", "Alternatives considered","textarea", false, "Other solutions you've thought about"),
        ]),
        new("support-ticket", "Support Ticket", "Get help with an issue",
        [
            new("subject",     "Subject",        "text",     true,  "Brief description of your issue"),
            new("description", "Description",    "textarea", true,  "Detailed explanation of your issue"),
            new("account",     "Account/User ID","text",     false, "Your account identifier"),
        ]),
    ];

    private string? _selectedTemplate = null;
    private readonly Dictionary<string, string> _formData = new();
    private bool _submitted = false;

    private Template? _currentTemplate => _selectedTemplate == null
        ? null
        : Array.Find(_templates, t => t.Id == _selectedTemplate);

    private void SelectTemplate(string id)
    {
        _selectedTemplate = id;
        _formData.Clear();
    }

    private string GetFieldValue(string fieldId) =>
        _formData.TryGetValue(fieldId, out var v) ? v : "";

    private void SetFieldValue(string fieldId, string value)
    {
        _formData[fieldId] = value;
    }

    private bool IsFormValid()
    {
        if (_currentTemplate == null) return false;
        foreach (var f in _currentTemplate.Fields)
        {
            if (f.Required && string.IsNullOrWhiteSpace(GetFieldValue(f.Id)))
                return false;
        }
        return true;
    }

    private async Task HandleSubmit()
    {
        _submitted = true;
        await Task.Delay(2000);
        _submitted = false;
        _selectedTemplate = null;
        _formData.Clear();
    }

    private void CancelForm()
    {
        _selectedTemplate = null;
        _formData.Clear();
    }
}
