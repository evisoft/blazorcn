@* ============================================================
   Block: comments-bookmark-collections
   Title: CommentsBookmarkCollections
   Description: A personal bookmark system for React and Next.js with custom collections, saved comments, and quick access built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-bookmark-collections.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Bookmark Collections</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_items.Count collections · @_bookmarkedComments.Count bookmarked
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                          @onclick="@(() => _showNewCollection = !_showNewCollection)">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    New collection
                </ButtonCn>
            </div>
        </div>

        @* New collection form *@
        @if (_showNewCollection)
        {
            <div class="overflow-hidden border-b bg-muted/20 px-4 py-3">
                <div class="flex items-center gap-2">
                    <InputCn @bind-Value="_newCollectionName"
                             Placeholder="Collection name..."
                             Class="h-8 text-sm" />
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" @onclick="CreateCollection">
                        Create
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs"
                              @onclick="@(() => { _showNewCollection = false; _newCollectionName = ""; })">
                        Cancel
                    </ButtonCn>
                </div>
            </div>
        }

        @* Collection tabs *@
        <div class="border-b p-2">
            <div class="flex flex-wrap gap-1">
                @foreach (var coll in _items)
                {
                    var collection = coll;
                    var isActive = _selectedCollection == collection.Id;
                    <div class="group relative">
                        <button type="button"
                                @onclick="@(() => _selectedCollection = collection.Id)"
                                class="@Cn.Merge("flex items-center gap-2 rounded-md border px-3 py-1.5 text-xs transition-all", isActive ? "border-foreground bg-foreground text-background" : "border-border bg-background hover:bg-muted/50")">
                            <LucideIconCn Name="folder" Size="12" Class="size-3" />
                            <span class="font-medium">@collection.Name</span>
                            <BadgeCn Variant="BadgeVariant.Secondary"
                                     Class="@Cn.Merge("h-4 px-1.5 text-[10px] font-normal tabular-nums", isActive ? "bg-background/20 text-background" : "")">
                                @collection.CommentIds.Count
                            </BadgeCn>
                        </button>
                        <button type="button"
                                @onclick="@(() => DeleteCollection(collection.Id))"
                                class="absolute -right-1.5 -top-1.5 flex size-4 items-center justify-center rounded-full bg-red-500 text-white opacity-0 transition-opacity group-hover:opacity-100">
                            <LucideIconCn Name="trash-2" Size="10" Class="size-2.5" />
                        </button>
                    </div>
                }
            </div>
        </div>

        @* Bookmarked comments *@
        <div class="divide-y">
            @foreach (var comment in _bookmarkedComments)
            {
                var cmt = comment;
                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="bookmark" Size="12" Class="size-3 shrink-0 fill-current text-muted-foreground" />
                                <span class="text-sm font-medium">@cmt.Author</span>
                                <span class="text-xs text-muted-foreground">@cmt.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm text-muted-foreground">@cmt.Content</p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 px-2 text-xs"
                                  @onclick="@(() => { if (_selectedCollection != null) RemoveFromCollection(_selectedCollection, cmt.Id); })">
                            Remove
                        </ButtonCn>
                    </div>
                </div>
            }
            @if (_bookmarkedComments.Count == 0)
            {
                <div class="px-4 py-8 text-center">
                    <p class="text-sm text-muted-foreground">No bookmarks in this collection</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Add comments to organize your saved items
                    </p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5 text-xs text-muted-foreground">
            @_items.Sum(c => c.CommentIds.Count) total bookmarks
        </div>

    </div>
</section>

@code {
    private record Collection(string Id, string Name, List<string> CommentIds);

    private record Comment(string Id, string Author, string Content, string Timestamp);

    private static readonly Comment[] _allComments =
    [
        new("1", "Sarah Chen",  "This component library is excellent for TypeScript projects", "2 hours ago"),
        new("2", "James Wilson", "How do I integrate the authentication module?",             "3 hours ago"),
        new("3", "Maya Patel",   "The dark mode implementation is flawless",                  "5 hours ago"),
        new("4", "Alex Morgan",  "TypeScript types are well-documented",                      "7 hours ago"),
        new("5", "Chris Taylor", "Found a useful pattern in the codebase",                   "1 day ago"),
    ];

    private List<Collection> _items =
    [
        new("1", "To Review",  ["1", "2"]),
        new("2", "Important",  ["3"]),
        new("3", "Research",   ["4", "5"]),
    ];

    private string? _selectedCollection = "1";
    private string _newCollectionName = "";
    private bool _showNewCollection = false;

    private List<Comment> _bookmarkedComments =>
        _items.FirstOrDefault(c => c.Id == _selectedCollection) is { } sel
            ? _allComments.Where(c => sel.CommentIds.Contains(c.Id)).ToList()
            : [];

    private void CreateCollection()
    {
        if (string.IsNullOrWhiteSpace(_newCollectionName)) return;
        var newColl = new Collection(
            Id: (_items.Count + 1).ToString(),
            Name: _newCollectionName,
            CommentIds: []
        );
        _items = [.. _items, newColl];
        _newCollectionName = "";
        _showNewCollection = false;
        _selectedCollection = newColl.Id;
    }

    private void DeleteCollection(string id)
    {
        _items = _items.Where(c => c.Id != id).ToList();
        if (_selectedCollection == id)
            _selectedCollection = _items.FirstOrDefault()?.Id;
    }

    private void RemoveFromCollection(string collectionId, string commentId)
    {
        _items = _items.Select(c =>
            c.Id == collectionId
                ? c with { CommentIds = c.CommentIds.Where(x => x != commentId).ToList() }
                : c
        ).ToList();
    }
}
