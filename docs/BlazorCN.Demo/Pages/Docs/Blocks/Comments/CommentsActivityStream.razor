@* ============================================================
   Block: comments-activity-stream
   Title: CommentsActivityStream
   Description: Real-time activity feed for comments in React and Next.js with live updates, action indicators, and auto-scroll to new content built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-activity-stream.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Activity Stream</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @if (_newCount > 0)
                        {
                            @($"{_newCount} new · ")
                        }
                        @(_filteredActivities.Length) activities
                    </p>
                </div>
                @if (_newCount > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-blue-500/10 text-xs font-normal text-blue-600 dark:text-blue-400">
                        @_newCount new
                    </BadgeCn>
                }
            </div>
        </div>

        @* Filter bar *@
        <div class="border-b bg-muted/30 px-4 py-2.5">
            <div class="flex flex-wrap items-center gap-1.5">
                <ButtonCn Variant="@(_filter == "all" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-7 px-2.5 text-xs"
                          OnClick="@(() => SetFilter("all"))">
                    All
                </ButtonCn>
                <ButtonCn Variant="@(_filter == "comment" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-7 px-2.5 text-xs"
                          OnClick="@(() => SetFilter("comment"))">
                    Comments
                </ButtonCn>
                <ButtonCn Variant="@(_filter == "reaction" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-7 px-2.5 text-xs"
                          OnClick="@(() => SetFilter("reaction"))">
                    Reactions
                </ButtonCn>
                <ButtonCn Variant="@(_filter == "mention" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-7 px-2.5 text-xs"
                          OnClick="@(() => SetFilter("mention"))">
                    Mentions
                </ButtonCn>
            </div>
        </div>

        @* Activity list *@
        <div>
            @{
                var activities = _filteredActivities;
            }
            @for (int i = 0; i < activities.Length; i++)
            {
                var activity = activities[i];
                var isLast = i == activities.Length - 1;
                var iconName = GetIconName(activity.Type);
                var iconColor = GetIconColor(activity.Type);
                var bgColor = GetBgColor(activity.Type);
                var textColor = GetTextColor(activity.Type);
                var initials = GetInitials(activity.User);
                <div class="@(isLast ? "" : "border-b")">
                    <div class="@Cn.Merge("flex gap-3 px-4 py-3 transition-colors hover:bg-muted/50", activity.IsNew ? "bg-blue-500/5" : "")">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@($"flex size-5 shrink-0 items-center justify-center rounded-full {bgColor}/10")">
                                    <LucideIconCn Name="@iconName" Size="12" Class="@($"size-3 {textColor}")" />
                                </span>
                                <p class="text-sm">
                                    <span class="font-medium">@activity.User</span>
                                    @(" ")
                                    <span class="text-muted-foreground">@activity.Action</span>
                                    @(" ")
                                    @if (!string.IsNullOrEmpty(activity.Target))
                                    {
                                        <span class="font-medium">@activity.Target</span>
                                    }
                                </p>
                            </div>
                            <span class="mt-0.5 block text-xs text-muted-foreground">
                                @activity.Timestamp
                            </span>
                        </div>
                        @if (activity.IsNew)
                        {
                            <span class="size-2 shrink-0 self-center rounded-full bg-blue-500"></span>
                        }
                    </div>
                </div>
            }

            @if (activities.Length == 0)
            {
                <div class="px-4 py-8 text-center text-sm text-muted-foreground">
                    No activities to show
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5 text-center">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Load earlier activity
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private string _filter = "all";

    private record Activity(string Id, string Type, string User, string Action, string Target, string Timestamp, bool IsNew);

    private static readonly Activity[] _allActivities =
    [
        new("1", "comment",  "Sarah Chen",   "commented on",        "Design System Updates",   "Just now",   true),
        new("2", "reaction", "Alex Morgan",  "reacted to",          "Sarah Chen's comment",    "2 min ago",  true),
        new("3", "reply",    "Maya Patel",   "replied to",          "James Wilson's comment",  "5 min ago",  false),
        new("4", "edit",     "Chris Taylor", "edited their comment on", "Q2 Roadmap",           "12 min ago", false),
        new("5", "resolve",  "Emma Davis",   "resolved",            "Discussion thread #42",   "18 min ago", false),
        new("6", "mention",  "James Wilson", "mentioned you in",    "Budget Review",           "25 min ago", false),
    ];

    private int _newCount => _allActivities.Count(a => a.IsNew);

    private Activity[] _filteredActivities =>
        _filter == "all"
            ? _allActivities
            : _allActivities.Where(a => a.Type == _filter).ToArray();

    private void SetFilter(string filter) => _filter = filter;

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();

    private static string GetIconName(string type) => type switch
    {
        "comment"  => "message-circle",
        "reply"    => "message-circle",
        "edit"     => "pencil",
        "reaction" => "thumbs-up",
        "mention"  => "user-plus",
        "resolve"  => "circle-check",
        _          => "message-circle",
    };

    private static string GetBgColor(string type) => type switch
    {
        "comment"  => "bg-blue-500",
        "reply"    => "bg-purple-500",
        "edit"     => "bg-amber-500",
        "reaction" => "bg-emerald-500",
        "mention"  => "bg-red-500",
        "resolve"  => "bg-green-500",
        _          => "bg-blue-500",
    };

    private static string GetTextColor(string type) => type switch
    {
        "comment"  => "text-blue-500",
        "reply"    => "text-purple-500",
        "edit"     => "text-amber-500",
        "reaction" => "text-emerald-500",
        "mention"  => "text-red-500",
        "resolve"  => "text-green-500",
        _          => "text-blue-500",
    };

    private static string GetIconColor(string type) => GetBgColor(type);
}
