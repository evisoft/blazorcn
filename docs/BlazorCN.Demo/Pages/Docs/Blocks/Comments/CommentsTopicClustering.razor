@* ============================================================
   Block: comments-topic-clustering
   Title: CommentsTopicClustering
   Description: A topic extraction and clustering dashboard for React and Next.js with word frequency analysis, topic tags, cluster visualization, and keyword trends built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-topic-clustering.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Topic Clustering</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_topics.Length topics · @_trendingCount trending
            </p>
        </div>

        @* Word cloud *@
        <div class="border-b px-4 py-6">
            <span class="mb-3 block text-xs font-medium text-muted-foreground">Word cloud</span>
            <div class="flex flex-wrap items-center justify-center gap-4">
                @foreach (var topic in _topics)
                {
                    var t = topic;
                    <button type="button"
                            class="@Cn.Merge("font-medium transition-colors hover:text-primary", GetWordSize(t.Weight), t.Trending ? "text-primary" : "text-muted-foreground")">
                        @t.Label
                    </button>
                }
            </div>
        </div>

        @* Trending topics *@
        <div class="border-b px-4 py-3">
            <span class="mb-3 block text-xs font-medium text-muted-foreground">
                Trending topics
            </span>
            <div class="space-y-2">
                @foreach (var topic in _topics.Where(t => t.Trending))
                {
                    var t = topic;
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="hash" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/60" />
                        <span class="text-sm font-medium">@t.Label</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto text-xs font-normal">
                            @t.Count
                        </BadgeCn>
                        <div class="flex items-center gap-1">
                            <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                            <span class="text-xs text-emerald-600 dark:text-emerald-400">
                                @t.Growth%
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Clusters *@
        <div>
            @foreach (var cluster in _clusters)
            {
                var cl = cluster;
                var isLast = cl.Id == _clusters[_clusters.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="mb-2 flex items-center justify-between">
                            <span class="text-sm font-medium">@cl.Theme</span>
                            <span class="text-xs text-muted-foreground">@cl.Count mentions</span>
                        </div>
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var topicName in cl.Topics)
                            {
                                var tn = topicName;
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("text-xs font-normal", cl.Color)">
                                    @tn
                                </BadgeCn>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>3 clusters</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>Updated 15 min ago</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record Topic(string Id, string Label, int Count, double Weight, bool Trending, int Growth = 0);
    private record Cluster(string Id, string Theme, string[] Topics, int Count, string Color);

    private static readonly Topic[] _topics =
    [
        new("1",  "pricing",       234, 1.0,  true,  24),
        new("2",  "features",      189, 0.81, false),
        new("3",  "support",       156, 0.67, false),
        new("4",  "performance",   142, 0.61, true,  18),
        new("5",  "bug",           127, 0.54, false),
        new("6",  "integration",    98, 0.42, false),
        new("7",  "mobile",         87, 0.37, true,  32),
        new("8",  "api",            76, 0.32, false),
        new("9",  "documentation",  65, 0.28, false),
        new("10", "security",       54, 0.23, false),
        new("11", "onboarding",     43, 0.18, false),
        new("12", "dashboard",      38, 0.16, false),
    ];

    private static readonly Cluster[] _clusters =
    [
        new("1", "Product",  ["features", "performance", "mobile", "dashboard"], 456, "bg-blue-500/10"),
        new("2", "Support",  ["support", "bug", "documentation"],                348, "bg-emerald-500/10"),
        new("3", "Business", ["pricing", "integration", "api", "security"],      462, "bg-amber-500/10"),
    ];

    private int _trendingCount => _topics.Count(t => t.Trending);

    private static string GetWordSize(double weight)
    {
        if (weight >= 0.8) return "text-2xl";
        if (weight >= 0.6) return "text-xl";
        if (weight >= 0.4) return "text-lg";
        if (weight >= 0.25) return "text-base";
        return "text-sm";
    }
}
