@* ============================================================
   Block: comments-cross-reference
   Title: CommentsCrossReference
   Description: React comment block for Next.js with related comment linking, reference detection, and conversation connection built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-cross-reference.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Comment with references</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_comment.References.Length outbound · @_comment.ReferencedBy.Length inbound
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 text-[10px] font-normal">
                    <LucideIconCn Name="link" Size="10" Class="size-2.5" />
                    Linked
                </BadgeCn>
            </div>
        </div>

        @* Comment body *@
        <div class="border-b p-4">
            <div class="flex items-baseline gap-2">
                <span class="text-sm font-medium">@_comment.Author</span>
                <span class="text-xs text-muted-foreground">@_comment.Timestamp</span>
            </div>
            <p class="mt-2 text-sm leading-relaxed">@_comment.Content</p>
        </div>

        @* References (outbound) *@
        @if (_comment.References.Length > 0)
        {
            <div class="border-b px-4 py-2.5">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="external-link" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">
                        References (@_comment.References.Length)
                    </span>
                </div>
            </div>

            <div>
                @foreach (var (refItem, idx) in _comment.References.Select((r, i) => (r, i)))
                {
                    var isLast = idx == _comment.References.Length - 1;
                    <div class="@(isLast ? "p-3" : "border-b p-3")">
                        <button type="button" class="flex w-full items-start gap-3 text-left transition-colors hover:bg-muted/50">
                            <span class="@($"mt-0.5 size-1.5 shrink-0 rounded-full {StatusDot(refItem.Status)}")"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-xs text-muted-foreground">#@refItem.Number</span>
                                    <span class="text-sm">@refItem.Title</span>
                                </div>
                                <div class="mt-1">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="@($"text-[10px] font-normal {StatusColor(refItem.Status)}")">
                                        @refItem.Status
                                    </BadgeCn>
                                </div>
                            </div>
                            <LucideIconCn Name="external-link" Size="12" Class="size-3 shrink-0 text-muted-foreground/60" />
                        </button>
                    </div>
                }
            </div>
        }

        @* Referenced by (inbound) *@
        @if (_comment.ReferencedBy.Length > 0)
        {
            <div class="border-b px-4 py-2.5">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="link" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-xs font-medium text-muted-foreground">
                        Referenced by (@_comment.ReferencedBy.Length)
                    </span>
                </div>
            </div>

            <div>
                @foreach (var (refItem, idx) in _comment.ReferencedBy.Select((r, i) => (r, i)))
                {
                    var isLast = idx == _comment.ReferencedBy.Length - 1;
                    <div class="@(isLast ? "p-3" : "border-b p-3")">
                        <button type="button" class="flex w-full items-start gap-3 text-left transition-colors hover:bg-muted/50">
                            <span class="@($"mt-0.5 size-1.5 shrink-0 rounded-full {StatusDot(refItem.Status)}")"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-mono text-xs text-muted-foreground">#@refItem.Number</span>
                                    <span class="text-sm">@refItem.Title</span>
                                </div>
                                <div class="mt-1">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="@($"text-[10px] font-normal {StatusColor(refItem.Status)}")">
                                        @refItem.Status
                                    </BadgeCn>
                                </div>
                            </div>
                            <LucideIconCn Name="external-link" Size="12" Class="size-3 shrink-0 text-muted-foreground/60" />
                        </button>
                    </div>
                }
            </div>
        }

        @* New comment input *@
        <div class="border-t p-4">
            <div class="mb-2 text-xs font-medium text-muted-foreground">Add a comment</div>
            <TextareaCn Value="@_newComment" ValueChanged="@((string v) => HandleCommentChange(v))" Placeholder="Write your comment... Use #123 to reference other issues." Class="min-h-[80px]" />
            @if (_detectedRefs.Count > 0)
            {
                <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="link" Size="12" Class="size-3" />
                    <span>
                        Detected @_detectedRefs.Count @(_detectedRefs.Count == 1 ? "reference" : "references"): @(string.Join(", ", _detectedRefs.Select(r => $"#{r}")))
                    </span>
                </div>
            }
            <div class="mt-2 flex justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Reference(string Id, int Number, string Title, string Status);
    private record CommentData(string Id, string Author, string Content, string Timestamp, Reference[] References, Reference[] ReferencedBy);

    private static readonly CommentData _comment = new(
        Id: "1",
        Author: "Sarah Chen",
        Content: "This is related to the authentication issues discussed in #142 and #156. The root cause appears to be the same token expiration problem mentioned in #89.",
        Timestamp: "1 hour ago",
        References:
        [
            new("142", 142, "OAuth token refresh fails after 24 hours", "open"),
            new("156", 156, "Session timeout not respecting custom duration", "open"),
            new("89",  89,  "JWT expiration causing API errors",           "closed"),
        ],
        ReferencedBy:
        [
            new("178", 178, "Add comprehensive token lifecycle tests",      "open"),
            new("201", 201, "Documentation: Token refresh best practices",  "merged"),
        ]
    );

    private string _newComment = "";
    private List<int> _detectedRefs = [142, 156];

    private void HandleCommentChange(string text)
    {
        _newComment = text;
        var matches = System.Text.RegularExpressions.Regex.Matches(text, @"#(\d+)");
        if (matches.Count > 0)
        {
            _detectedRefs = matches.Select(m => int.Parse(m.Groups[1].Value)).ToList();
        }
        else
        {
            _detectedRefs = [];
        }
    }

    private static string StatusColor(string status) => status switch
    {
        "open"   => "text-blue-600 dark:text-blue-400",
        "closed" => "text-red-600 dark:text-red-400",
        "merged" => "text-purple-600 dark:text-purple-400",
        _        => ""
    };

    private static string StatusDot(string status) => status switch
    {
        "open"   => "bg-blue-500",
        "closed" => "bg-red-500",
        "merged" => "bg-purple-500",
        _        => ""
    };
}
