@* ============================================================
   Block: comments-tag-taxonomy
   Title: CommentsTagTaxonomy
   Description: A hierarchical tag system for React and Next.js with nested categories, multi-select filtering, and tag counts built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-tag-taxonomy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Tag Taxonomy</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_items.Length tags · @_selected.Count selected
            </p>
        </div>

        @* Active filter bar *@
        @if (_selected.Count > 0)
        {
            var filtered = FilteredComments();
            <div class="overflow-hidden border-b bg-muted/20">
                <div class="flex items-center justify-between px-4 py-2.5">
                    <span class="text-xs font-medium">
                        @filtered.Length @(filtered.Length == 1 ? "comment" : "comments") match
                    </span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="ClearFilters">
                        Clear filters
                    </ButtonCn>
                </div>
            </div>
        }

        @* Tag tree *@
        <div class="space-y-0.5 p-2">
            @RenderTags(null, 0)
        </div>

        @* Matching comments *@
        <div class="border-t px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-medium">
                    Matching Comments (@FilteredComments().Length)
                </span>
            </div>
            <div class="space-y-2">
                @foreach (var comment in FilteredComments())
                {
                    var c = comment;
                    <div class="rounded-md bg-muted/30 p-2">
                        <span class="block text-xs font-medium">@c.Author</span>
                        <p class="mt-0.5 text-xs text-muted-foreground">@c.Content</p>
                        <div class="mt-1.5 flex flex-wrap gap-1">
                            @foreach (var tagId in c.Tags)
                            {
                                var tid = tagId;
                                var foundTag = System.Array.Find(_items, t => t.Id == tid);
                                @if (foundTag != null)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 gap-1 px-1.5 text-[10px]">
                                        <LucideIconCn Name="tag" Size="10" Class="size-2.5" />
                                        @foundTag.Name
                                    </BadgeCn>
                                }
                            }
                        </div>
                    </div>
                }
                @if (FilteredComments().Length == 0)
                {
                    <p class="py-4 text-center text-xs text-muted-foreground">
                        No comments match selected tags
                    </p>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record TagItem(string Id, string Name, string? ParentId, int Count, bool Expanded);
    private record CommentItem(string Id, string Author, string Content, string[] Tags);

    private TagItem[] _items =
    [
        new("1",  "Technical",     null,  8, true),
        new("2",  "Frontend",      "1",   5, false),
        new("3",  "Backend",       "1",   3, false),
        new("4",  "React",         "2",   3, false),
        new("5",  "TypeScript",    "2",   2, false),
        new("6",  "API",           "3",   2, false),
        new("7",  "Database",      "3",   1, false),
        new("8",  "Documentation", null,  4, true),
        new("9",  "Tutorial",      "8",   2, false),
        new("10", "Reference",     "8",   2, false),
        new("11", "Community",     null,  3, false),
    ];

    private static readonly CommentItem[] _comments =
    [
        new("1", "Sarah Chen",   "How to set up TypeScript with React?",   ["4", "5"]),
        new("2", "James Wilson", "Best practices for API design",           ["6"]),
        new("3", "Maya Patel",   "Tutorial on React hooks",                 ["4", "9"]),
        new("4", "Alex Morgan",  "Database migration guide needed",         ["7"]),
        new("5", "Chris Taylor", "Component reference docs",                ["10"]),
    ];

    private readonly HashSet<string> _selected = [];

    private CommentItem[] FilteredComments() =>
        _selected.Count == 0
            ? _comments
            : System.Array.FindAll(_comments, c => System.Array.Exists(c.Tags, t => _selected.Contains(t)));

    private void ToggleExpanded(string id)
    {
        _items = System.Array.ConvertAll(_items, t => t.Id == id ? t with { Expanded = !t.Expanded } : t);
    }

    private void ToggleSelect(string id)
    {
        if (_selected.Contains(id))
            _selected.Remove(id);
        else
            _selected.Add(id);
    }

    private void ClearFilters()
    {
        _selected.Clear();
    }

    private RenderFragment RenderTags(string? parentId, int depth) => __builder =>
    {
        foreach (var tag in _items)
        {
            if (tag.ParentId != parentId) continue;
            var t = tag;
            var hasChildren = System.Array.Exists(_items, x => x.ParentId == t.Id);
            var isSelected = _selected.Contains(t.Id);
            var paddingLeft = depth * 12 + 8;

            <div>
                <div class="flex items-center gap-2 rounded-md px-2 py-1.5 transition-colors hover:bg-muted/50"
                     style="@($"padding-left:{paddingLeft}px")">
                    @if (hasChildren)
                    {
                        var tid = t.Id;
                        <button type="button" @onclick="@(() => ToggleExpanded(tid))" class="inline-flex size-6 shrink-0 items-center justify-center" aria-label="@(t.Expanded ? $"Collapse {t.Name}" : $"Expand {t.Name}")">
                            <LucideIconCn Name="chevron-right" Size="12" Class="@Cn.Merge("size-3 text-muted-foreground transition-transform", t.Expanded ? "rotate-90" : "")" />
                        </button>
                    }
                    else
                    {
                        <span class="w-6 shrink-0"></span>
                    }
                    <label class="flex min-w-0 flex-1 cursor-pointer items-center gap-2">
                        <CheckboxCn Checked="@isSelected" CheckedChanged="@(() => ToggleSelect(t.Id))" aria-label="@t.Name" />
                        <LucideIconCn Name="tag" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        <span class="min-w-0 flex-1 truncate text-sm">@t.Name</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px] font-normal tabular-nums">
                            @t.Count
                        </BadgeCn>
                    </label>
                </div>
                @if (t.Expanded && hasChildren)
                {
                    <div class="overflow-hidden">
                        @RenderTags(t.Id, depth + 1)
                    </div>
                }
            </div>
        }
    };
}
