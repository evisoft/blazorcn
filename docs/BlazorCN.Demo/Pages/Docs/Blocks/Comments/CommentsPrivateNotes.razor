@* ============================================================
   Block: comments-private-notes
   Title: CommentsPrivateNotes
   Description: React comment block for Next.js with team-only visibility, internal notes, and role-based access control built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-private-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Comments &amp; internal notes</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_publicCount public · @_teamCount team · @_adminCount admin
                    </p>
                </div>
                <label class="flex cursor-pointer items-center gap-2">
                    <span class="text-xs text-muted-foreground">Show private</span>
                    <SwitchCn @bind-Value="_showPrivate" />
                </label>
            </div>
        </div>

        @* Compose *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_newComment"
                        Placeholder="@(_isPrivate ? "Add a private team note..." : "Add a public comment...")"
                        Class="min-h-[80px]" />
            <div class="mt-2 flex items-center justify-between">
                <label class="flex cursor-pointer items-center gap-2">
                    <SwitchCn @bind-Value="_isPrivate" />
                    <div class="flex items-center gap-1.5">
                        @if (_isPrivate)
                        {
                            <LucideIconCn Name="lock" Size="12" Class="size-3 text-amber-600 dark:text-amber-400" />
                            <span class="text-xs text-muted-foreground">Team only</span>
                        }
                        else
                        {
                            <LucideIconCn Name="message-circle" Size="12" Class="size-3 text-blue-600 dark:text-blue-400" />
                            <span class="text-xs text-muted-foreground">Public</span>
                        }
                    </div>
                </label>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post @(_isPrivate ? "note" : "comment")
                </ButtonCn>
            </div>
        </div>

        @* Comment List *@
        <div>
            @for (int i = 0; i < _visibleComments.Count; i++)
            {
                var comment = _visibleComments[i];
                var isLast = i == _visibleComments.Count - 1;
                var config = _visibilityConfig[comment.Visibility];

                <div class="@(isLast ? "p-4" : "border-b p-4")">
                    <div class="flex items-start gap-3">
                        @if (comment.Visibility == "public")
                        {
                            <LucideIconCn Name="message-circle" Size="16" Class="mt-0.5 size-4 shrink-0 text-blue-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="lock" Size="16" Class="mt-0.5 size-4 shrink-0 text-amber-500" />
                        }
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("text-[10px] font-normal", config.Color)">
                                    @config.Label
                                </BadgeCn>
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                            </div>
                            <p class="@Cn.Merge("mt-1.5 text-sm leading-relaxed", comment.Visibility != "public" ? "text-muted-foreground" : "")">
                                @comment.Content
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Show hidden notes banner *@
        @if (!_showPrivate && _teamCount + _adminCount > 0)
        {
            <div class="border-t px-4 py-3">
                <button type="button"
                        @onclick="@(() => _showPrivate = true)"
                        class="flex w-full items-center justify-center gap-2 text-xs text-muted-foreground transition-colors hover:text-foreground">
                    <LucideIconCn Name="eye" Size="12" Class="size-3" />
                    <span>Show @(_teamCount + _adminCount) hidden @(_teamCount + _adminCount == 1 ? "note" : "notes")</span>
                </button>
            </div>
        }

        @* Hide private notes banner *@
        @if (_showPrivate && _teamCount + _adminCount > 0)
        {
            <div class="border-t px-4 py-3">
                <button type="button"
                        @onclick="@(() => _showPrivate = false)"
                        class="flex w-full items-center justify-center gap-2 text-xs text-muted-foreground transition-colors hover:text-foreground">
                    <LucideIconCn Name="eye-off" Size="12" Class="size-3" />
                    <span>Hide private notes</span>
                </button>
            </div>
        }

    </div>
</section>

@code {
    private record CommentItem(string Id, string Author, string Content, string Timestamp, string Visibility);

    private record VisibilityConfig(string Label, string Color);

    private static readonly CommentItem[] _comments =
    [
        new("1", "Customer (Sarah Chen)", "I'm experiencing issues with the payment gateway. Transactions are failing randomly.", "1 hour ago", "public"),
        new("2", "Alex Morgan (Support)", "This looks like the Stripe API timeout issue we saw last week. Check the webhook logs for errors.", "45 min ago", "team"),
        new("3", "Maya Patel (Support)", "We're investigating this issue and will update you shortly. Thank you for your patience.", "40 min ago", "public"),
        new("4", "Chris Taylor (Admin)", "Escalating to engineering. This affects multiple customers. Priority: high.", "30 min ago", "admin"),
    ];

    private static readonly Dictionary<string, VisibilityConfig> _visibilityConfig = new()
    {
        ["public"] = new VisibilityConfig("Public", "text-blue-600 dark:text-blue-400"),
        ["team"]   = new VisibilityConfig("Team only", "text-amber-600 dark:text-amber-400"),
        ["admin"]  = new VisibilityConfig("Admin only", "text-red-600 dark:text-red-400"),
    };

    private const string _currentUserRole = "team";

    private string _newComment = "";
    private bool _isPrivate = false;
    private bool _showPrivate = true;

    private List<CommentItem> _visibleComments =>
        _comments.Where(c =>
        {
            if (!_showPrivate && c.Visibility != "public") return false;
            if (c.Visibility == "admin" && _currentUserRole != "admin") return false;
            if (c.Visibility == "team" && _currentUserRole == "public") return false;
            return true;
        }).ToList();

    private int _publicCount => _comments.Count(c => c.Visibility == "public");
    private int _teamCount   => _comments.Count(c => c.Visibility == "team");
    private int _adminCount  => _comments.Count(c => c.Visibility == "admin");
}
