@* ============================================================
   Block: comments-ai-toxicity-detection
   Title: CommentsAiToxicityDetection
   Description: An AI-powered toxicity detection comment system for React and Next.js with real-time content moderation, severity indicators, warning messages, and auto-flag functionality built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-ai-toxicity-detection.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Comments</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_comments.Length @(_comments.Length == 1 ? "comment" : "comments")
                    </p>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="shield-alert" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">Moderation enabled</span>
                </div>
            </div>
        </div>

        @* New comment form *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="NewComment" Placeholder="Add a comment..." Class="min-h-[100px]" />

            @if (_toxicityWarning != null)
            {
                <div class="mt-3 overflow-hidden">
                    <AlertCn Class="@(_toxicityWarning.Level == "severe" ? "border-red-500/50 bg-red-500/10" : "border-amber-500/50 bg-amber-500/10")">
                        <LucideIconCn Name="triangle-alert" Size="16" Class="@("size-4 " + (_toxicityWarning.Level == "severe" ? "text-red-600 dark:text-red-400" : "text-amber-600 dark:text-amber-400"))" />
                        <AlertDescriptionCn Class="text-sm">
                            @if (_toxicityWarning.Level == "severe")
                            {
                                <span>This comment contains language that may violate community guidelines. Please revise before posting.</span>
                            }
                            else
                            {
                                <span>This comment may contain negative language. Consider rephrasing to maintain a constructive tone.</span>
                            }
                            <div class="mt-1.5 flex flex-wrap gap-1">
                                @foreach (var category in _toxicityWarning.Categories)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">@category</BadgeCn>
                                }
                            </div>
                        </AlertDescriptionCn>
                    </AlertCn>
                </div>
            }

            <div class="mt-2 flex justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

        @* Stats bar *@
        <div class="border-b bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs text-muted-foreground">@_safeCount safe</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span class="text-xs text-muted-foreground">@_warningCount flagged</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span class="text-xs text-muted-foreground">@_severeCount blocked</span>
                </div>
            </div>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var comment in _comments)
            {
                var initials = GetInitials(comment.Author);
                var cfg = comment.Toxicity != null ? _toxicityConfig[comment.Toxicity.Level] : _toxicityConfig["safe"];
                <div class="p-4">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                                @if (comment.Toxicity != null && comment.Toxicity.Level != "safe")
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("ml-auto gap-1 text-xs font-normal", cfg.Bg)">
                                        <LucideIconCn Name="@cfg.IconName" Size="12" Class="@("size-3 " + cfg.Color)" />
                                        <span class="@cfg.Color">@cfg.Label</span>
                                    </BadgeCn>
                                }
                            </div>
                            @if (comment.Flagged)
                            {
                                <div class="mt-2 rounded-md border border-red-500/50 bg-red-500/10 p-3">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="shield-alert" Size="16" Class="size-4 text-red-600 dark:text-red-400" />
                                        <span class="text-sm font-medium text-red-600 dark:text-red-400">
                                            Content hidden
                                        </span>
                                    </div>
                                    <p class="mt-1 text-xs text-muted-foreground">
                                        This comment has been flagged for review by moderators due to potential
                                        policy violations.
                                    </p>
                                </div>
                            }
                            else
                            {
                                <p class="mt-1 text-sm leading-relaxed">@comment.Content</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ToxicityScore(string Level, double Score, string[] Categories);
    private record Comment(string Id, string Author, string Content, string Timestamp, ToxicityScore? Toxicity = null, bool Flagged = false);
    private record ToxicityInfo(string Color, string Bg, string Label, string IconName);

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen",  "This is a fantastic tutorial! Really helpful for beginners.",
            "2 hours ago", new("safe",    0.05, [])),
        new("2", "Alex Morgan", "I'm really frustrated with this feature. It doesn't work as expected.",
            "2 hours ago", new("warning", 0.42, ["negative sentiment"])),
        new("3", "Anonymous",   "This content has been flagged for review by moderators.",
            "1 hour ago",  new("severe",  0.89, ["insult", "threat"]), Flagged: true),
        new("4", "Maya Patel",  "Thanks for sharing this! Looking forward to trying it out.",
            "30 min ago",  new("safe",    0.03, [])),
    ];

    private static readonly Dictionary<string, ToxicityInfo> _toxicityConfig = new()
    {
        ["safe"]    = new("text-emerald-600 dark:text-emerald-400", "bg-emerald-500/10", "Safe",        "check-circle-2"),
        ["warning"] = new("text-amber-600 dark:text-amber-400",     "bg-amber-500/10",   "Needs review","triangle-alert"),
        ["severe"]  = new("text-red-600 dark:text-red-400",         "bg-red-500/10",     "Flagged",     "x-circle"),
    };

    private static int _safeCount    => _comments.Count(c => c.Toxicity?.Level == "safe");
    private static int _warningCount => _comments.Count(c => c.Toxicity?.Level == "warning");
    private static int _severeCount  => _comments.Count(c => c.Toxicity?.Level == "severe");

    private string _newCommentBacking = "";
    private ToxicityScore? _toxicityWarning;

    private string NewComment
    {
        get => _newCommentBacking;
        set
        {
            _newCommentBacking = value;
            if (value.Length > 10)
                CheckToxicity(value);
            else
                _toxicityWarning = null;
        }
    }

    private void CheckToxicity(string text)
    {
        var hasSevere   = System.Text.RegularExpressions.Regex.IsMatch(text, @"idiot|moron|kill|die",    System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        var hasNegative = System.Text.RegularExpressions.Regex.IsMatch(text, @"stupid|terrible|awful|hate", System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        if (hasSevere)
            _toxicityWarning = new("severe",  0.85, ["insult", "threat"]);
        else if (hasNegative)
            _toxicityWarning = new("warning", 0.65, ["negative sentiment", "potential insult"]);
        else
            _toxicityWarning = null;
    }

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => char.ToUpperInvariant(n[0])));
}
