@* ============================================================
   Block: comments-two-factor-posting
   Title: CommentsTwoFactorPosting
   Description: A 2FA-protected comment section for React and Next.js with verification prompts, TOTP codes, and critical action protection built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-two-factor-posting.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Verified Comments</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">2FA required for all approvals</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1.5 text-xs">
                    <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                    2FA Protected
                </BadgeCn>
            </div>
        </div>

        @* Comment form *@
        <div class="border-b p-4">
            <div class="space-y-3">
                <TextareaCn @bind-Value="_newComment" Placeholder="@("Post a comment (requires 2FA verification)...")" Class="min-h-[100px]" />

                @if (_showVerification)
                {
                    <div class="overflow-hidden rounded-md border bg-muted/30 p-3">
                        <div class="mb-2 flex items-center gap-2">
                            <LucideIconCn Name="lock" Size="16" Class="size-4 text-muted-foreground" />
                            <span class="text-sm font-medium">Verify your identity</span>
                        </div>
                        <p class="mb-3 text-xs text-muted-foreground">
                            Enter the 6-digit code from your authenticator app
                        </p>
                        <div class="flex gap-2">
                            <InputCn @bind-Value="_verificationCode" Placeholder="000000" MaxLength="6" Class="h-9 font-mono text-center text-lg tracking-widest" />
                            <ButtonCn Size="ButtonSize.Sm" Class="h-9 shrink-0"
                                      @onclick="HandleVerify"
                                      Disabled="@(_verificationCode.Length != 6 || _verifying)">
                                @(_verifying ? "Verifying..." : "Verify")
                            </ButtonCn>
                        </div>
                    </div>
                }

                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                        <span>2FA verification required</span>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs"
                              @onclick="HandleSubmit"
                              Disabled="@(string.IsNullOrWhiteSpace(_newComment))">
                        <LucideIconCn Name="lock" Size="12" Class="size-3" />
                        Post comment
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Comment list *@
        <div>
            @for (int i = 0; i < _comments.Length; i++)
            {
                var comment = _comments[i];
                var isLast = i == _comments.Length - 1;
                var initials = GetInitials(comment.Author);
                <div class="@(isLast ? "p-4" : "border-b p-4")">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarImageCn Src="@comment.Avatar" Alt="@comment.Author" />
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                @if (comment.Verified)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 bg-emerald-500/10 text-[10px] font-normal text-emerald-600 dark:text-emerald-400">
                                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                                        Verified
                                    </BadgeCn>
                                }
                                @if (comment.RequiresApproval)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-[10px] font-normal">
                                        @if (comment.VerificationMethod == "biometric")
                                        {
                                            <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="smartphone" Size="12" Class="size-3" />
                                        }
                                        2FA
                                    </BadgeCn>
                                }
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                            </div>
                            <p class="mt-1.5 text-sm leading-relaxed">@comment.Content</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span>All comments cryptographically verified</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>@(_comments.Length) verified approvals</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record Comment(
        string Id,
        string Author,
        string Avatar,
        string Content,
        string Timestamp,
        bool Verified,
        string VerificationMethod,
        bool RequiresApproval);

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen",   "", "I approve the $2.5M budget allocation for Q2 infrastructure upgrades. All compliance requirements have been met.",
            "15 min ago", true, "totp", true),
        new("2", "James Wilson", "", "Legal review complete. Contract terms are acceptable with the amendments discussed. Authorized to proceed with signing.",
            "1 hour ago", true, "biometric", true),
        new("3", "Maya Patel",   "", "Security audit passed all checkpoints. No critical vulnerabilities detected. Production deployment approved.",
            "2 hours ago", true, "totp", true),
    ];

    private string _newComment = "";
    private bool _showVerification;
    private string _verificationCode = "";
    private bool _verifying;

    private void HandleSubmit()
    {
        _showVerification = true;
    }

    private async Task HandleVerify()
    {
        _verifying = true;
        await Task.Delay(1500);
        _verifying = false;
        _showVerification = false;
        _newComment = "";
        _verificationCode = "";
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ');
        var sb = new System.Text.StringBuilder();
        foreach (var part in parts)
        {
            if (part.Length > 0)
                sb.Append(char.ToUpper(part[0]));
        }
        return sb.ToString();
    }
}
