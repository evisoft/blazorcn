@* ============================================================
   Block: comments-inline
   Title: CommentsInline
   Description: A Google Docs style inline comment system for React and Next.js with text selection, anchor positioning, and resolved states built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-inline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Document Comments</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_activeCount active, @_resolvedCount resolved
                    </p>
                </div>
                <span class="flex items-center gap-2">
                    <CheckboxCn Checked="@_showResolved" CheckedChanged="@((bool v) => _showResolved = v)" />
                    <span class="text-xs text-muted-foreground">Show resolved</span>
                </span>
            </div>
        </div>

        @* Two-column layout: document text | comments *@
        <div class="grid grid-cols-2 divide-x">

            @* Left: document text with highlighted anchors *@
            <div class="p-4">
                <div class="prose prose-sm dark:prose-invert">
                    <p class="leading-relaxed">
                        Our new component library represents a
                        <mark class="@Cn.Merge("cursor-pointer rounded bg-amber-200 px-1 dark:bg-amber-900/40", _activeComment == "1" ? "ring-2 ring-amber-500" : "")"
                              @onclick="@(() => _activeComment = "1")">
                            significant leap forward
                        </mark>
                        in developer experience. The carefully crafted design system ensures consistency
                        across all touchpoints, while the
                        <mark class="@Cn.Merge("cursor-pointer rounded bg-emerald-200 px-1 dark:bg-emerald-900/40", _activeComment == "2" ? "ring-2 ring-emerald-500" : "")"
                              @onclick="@(() => _activeComment = "2")">
                            TypeScript-first approach
                        </mark>
                        provides unparalleled type safety and autocomplete support. Performance
                        optimizations including code splitting and tree shaking reduce bundle sizes by
                        <mark class="@Cn.Merge("cursor-pointer rounded bg-blue-200 px-1 dark:bg-blue-900/40", _activeComment == "3" ? "ring-2 ring-blue-500" : "")"
                              @onclick="@(() => _activeComment = "3")">
                            up to 40%
                        </mark>
                        compared to previous versions.
                    </p>
                </div>
            </div>

            @* Right: comment threads *@
            <div class="p-4">
                <div class="space-y-3">
                    @foreach (var comment in VisibleComments)
                    {
                        var c = comment;
                        @RenderThread(c)
                    }

                    @if (!VisibleComments.Any())
                    {
                        <div class="py-8 text-center">
                            <LucideIconCn Name="message-square" Size="32" Class="mx-auto size-8 text-muted-foreground/40" />
                            <p class="mt-2 text-xs text-muted-foreground">No comments to show</p>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record InlineComment(
        string Id,
        string AnchorId,
        string Author,
        string Avatar,
        string Content,
        string Timestamp,
        bool Resolved,
        string SelectedText);

    private List<InlineComment> _comments =
    [
        new("1", "anchor-1", "Sarah Chen",  "", "Can we quantify 'significant leap'? Specific metrics would strengthen this claim.", "2h ago", false, "significant leap forward"),
        new("2", "anchor-2", "Alex Kim",    "", "Good point about type safety. Should we mention the ESLint config too?",           "1h ago", true,  "TypeScript-first approach"),
        new("3", "anchor-3", "Maya Patel",  "", "These numbers are from the beta testing phase. We should verify before publishing.", "30m ago", false, "up to 40%"),
    ];

    private bool _showResolved = true;
    private string? _activeComment = "1";

    private int _activeCount   => _comments.Count(c => !c.Resolved);
    private int _resolvedCount => _comments.Count(c =>  c.Resolved);

    private IEnumerable<InlineComment> VisibleComments =>
        _showResolved ? _comments : _comments.Where(c => !c.Resolved);

    private void ToggleResolve(string id)
    {
        var idx = _comments.FindIndex(c => c.Id == id);
        if (idx >= 0)
        {
            var c = _comments[idx];
            _comments[idx] = c with { Resolved = !c.Resolved };
        }
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var result = "";
        foreach (var p in parts)
            if (p.Length > 0) result += char.ToUpper(p[0]);
        return result;
    }

    private RenderFragment RenderThread(InlineComment comment) => __builder =>
    {
        var initials = GetInitials(comment.Author);
        var cId = comment.Id;

        <div class="rounded-md border bg-card p-3">
            <div class="mb-2 flex items-start justify-between gap-2">
                <div class="flex items-center gap-2">
                    <AvatarCn Class="size-6">
                        <AvatarImageCn Src="@comment.Avatar" Alt="@comment.Author" />
                        <AvatarFallbackCn Class="text-[10px]">@initials</AvatarFallbackCn>
                    </AvatarCn>
                    <div>
                        <span class="text-xs font-medium">@comment.Author</span>
                        <p class="text-xs text-muted-foreground">@comment.Timestamp</p>
                    </div>
                </div>
                @if (comment.Resolved)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 gap-1 text-[10px]">
                        <LucideIconCn Name="check" Size="10" Class="size-2.5" />
                        Resolved
                    </BadgeCn>
                }
            </div>

            <div class="mb-2 rounded bg-muted/50 px-2 py-1">
                <p class="text-xs italic text-muted-foreground">"@comment.SelectedText"</p>
            </div>

            <p class="text-sm leading-relaxed">@comment.Content</p>

            <div class="mt-2 flex gap-2">
                @if (!comment.Resolved)
                {
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 gap-1 text-xs" OnClick="@(() => ToggleResolve(cId))">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        Resolve
                    </ButtonCn>
                }
                else
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 text-xs" OnClick="@(() => ToggleResolve(cId))">
                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                        Reopen
                    </ButtonCn>
                }
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 text-xs">
                    Reply
                </ButtonCn>
            </div>
        </div>
    };
}
