@* ============================================================
   Block: comments-export-reporting
   Title: CommentsExportReporting
   Description: A comment export and reporting system for React and Next.js with multiple format options, date range filtering, field selection, and download management built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-export-reporting.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Export &amp; Reporting</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">@_completedCount exports completed</p>
        </div>

        @* Export format *@
        <div class="border-b px-4 py-3">
            <span class="mb-3 block text-xs font-medium text-muted-foreground">Export format</span>
            <div class="flex items-center gap-2">
                @foreach (var fmt in _formats)
                {
                    var format = fmt;
                    <button
                        type="button"
                        @onclick="@(() => _selectedFormat = format.Value)"
                        class="@Cn.Merge("flex flex-1 items-center justify-center gap-2 rounded-md border px-3 py-2 text-sm transition-all", _selectedFormat == format.Value ? "border-primary bg-primary/5 text-foreground" : "border-border bg-background text-muted-foreground hover:border-primary/50")"
                    >
                        <LucideIconCn Name="@format.Icon" Size="16" Class="size-4" />
                        @format.Label
                    </button>
                }
            </div>
        </div>

        @* Date range *@
        <div class="border-b px-4 py-3">
            <span class="mb-3 block text-xs font-medium text-muted-foreground">Date range</span>
            <div class="grid grid-cols-4 gap-2">
                @foreach (var opt in _dateOptions)
                {
                    var option = opt;
                    <button
                        type="button"
                        @onclick="@(() => _dateRange = option.Value)"
                        class="@Cn.Merge("rounded-md px-3 py-1.5 text-xs font-medium transition-all", _dateRange == option.Value ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")"
                    >
                        @option.Label
                    </button>
                }
            </div>
        </div>

        @* Include fields *@
        <div class="border-b px-4 py-3">
            <span class="mb-3 block text-xs font-medium text-muted-foreground">Include fields</span>
            <div class="grid grid-cols-2 gap-3">
                @foreach (var fld in _fields)
                {
                    <span class="flex cursor-pointer items-center gap-2">
                        <CheckboxCn Checked="@fld.Checked" />
                        <span class="text-sm">@fld.Label</span>
                    </span>
                }
            </div>
            <ButtonCn Class="mt-3 w-full gap-2 text-xs" Size="ButtonSize.Sm">
                <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                Generate export
            </ButtonCn>
        </div>

        @* Export history *@
        <div>
            <div class="border-b px-4 py-3">
                <span class="text-xs font-medium text-muted-foreground">Export history</span>
            </div>
            @for (var i = 0; i < _exportHistory.Length; i++)
            {
                var entry = _exportHistory[i];
                var isLast = i == _exportHistory.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-center gap-3">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted">
                                <LucideIconCn Name="@GetFormatIcon(entry.Format)" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@GetFormatLabel(entry.Format) export</span>
                                    <span class="@($"size-1.5 rounded-full {GetStatusColor(entry.Status)}")"></span>
                                </div>
                                <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                    <span>@entry.DateRange</span>
                                    <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                                    <span>@entry.Size</span>
                                    <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                                    <span>@entry.Timestamp</span>
                                </div>
                            </div>
                            @if (entry.Status == "completed")
                            {
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 px-2 text-xs">
                                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                                    Download
                                </ButtonCn>
                            }
                            @if (entry.Status == "processing")
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">Processing</BadgeCn>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>@_exportHistory.Length exports</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>Updated just now</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record FormatOption(string Value, string Label, string Icon);
    private record DateOption(string Value, string Label);
    private record FieldOption(string Id, string Label, bool Checked);
    private record ExportEntry(string Id, string Format, string DateRange, string Size, string Status, string Timestamp);

    private static readonly FormatOption[] _formats =
    [
        new("csv",  "CSV",  "file-text"),
        new("json", "JSON", "file-json"),
        new("pdf",  "PDF",  "file"),
    ];

    private static readonly DateOption[] _dateOptions =
    [
        new("last-7-days",  "7 days"),
        new("last-30-days", "30 days"),
        new("last-90-days", "90 days"),
        new("custom",       "Custom"),
    ];

    private static readonly FieldOption[] _fields =
    [
        new("author",    "Author",      true),
        new("content",   "Content",     true),
        new("timestamp", "Timestamp",   true),
        new("sentiment", "Sentiment",   false),
        new("upvotes",   "Upvotes",     true),
        new("replies",   "Reply count", false),
    ];

    private static readonly ExportEntry[] _exportHistory =
    [
        new("1", "csv",  "Last 30 days",  "2.4 MB", "completed",  "2 hours ago"),
        new("2", "pdf",  "Last 7 days",   "1.8 MB", "completed",  "1 day ago"),
        new("3", "json", "Custom range",  "3.1 MB", "completed",  "3 days ago"),
        new("4", "csv",  "Last 90 days",  "8.7 MB", "processing", "5 min ago"),
    ];

    private string _selectedFormat = "csv";
    private string _dateRange = "last-30-days";

    private int _completedCount => System.Linq.Enumerable.Count(_exportHistory, e => e.Status == "completed");

    private static string GetFormatIcon(string format) => format switch
    {
        "csv"  => "file-text",
        "json" => "file-json",
        "pdf"  => "file",
        _      => "file",
    };

    private static string GetFormatLabel(string format) => format switch
    {
        "csv"  => "CSV",
        "json" => "JSON",
        "pdf"  => "PDF",
        _      => format.ToUpper(),
    };

    private static string GetStatusColor(string status) => status switch
    {
        "completed"  => "bg-emerald-500",
        "processing" => "bg-amber-500",
        "failed"     => "bg-red-500",
        _            => "bg-muted-foreground",
    };
}
