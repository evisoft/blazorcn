@* ============================================================
   Block: comments-audio-note
   Title: CommentsAudioNote
   Description: Record audio comments with waveform visualization for React and Next.js with voice recording, playback controls, and duration tracking built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-audio-note.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Voice Feedback</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length audio comments · Record your thoughts
            </p>
        </div>

        @* Recording panel *@
        <div class="border-b p-4">
            <div class="rounded-lg border bg-muted/30 p-4">
                <div class="mb-3 flex items-center justify-between">
                    <span class="text-sm font-medium">
                        @(_isRecording ? "Recording..." : "Record audio comment")
                    </span>
                    @if (_isRecording)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="animate-pulse bg-red-500/10 text-xs font-normal text-red-600 dark:text-red-400">
                            <span class="size-1.5 rounded-full bg-red-500"></span>
                            <span class="ml-1.5">0:@(_recordingDuration.ToString().PadLeft(2, '0'))</span>
                        </BadgeCn>
                    }
                </div>

                @if (_isRecording)
                {
                    <div class="mb-3 flex h-16 items-center gap-1 rounded bg-background/50 px-3">
                        @foreach (var bar in _waveformBars)
                        {
                            <div
                                class="flex-1 rounded-full bg-blue-500 transition-all"
                                style="@($"height:{bar}%;opacity:0.6")"
                            ></div>
                        }
                    </div>
                }

                <div class="flex gap-2">
                    @if (!_isRecording)
                    {
                        <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs" OnClick="@(() => _isRecording = true)">
                            <LucideIconCn Name="mic" Size="12" Class="size-3" />
                            Start recording
                        </ButtonCn>
                    }
                    else
                    {
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 text-xs" OnClick="@(() => _isRecording = false)">
                            Stop
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-8 gap-1 text-xs text-red-600 hover:text-red-600 dark:text-red-400" OnClick="CancelRecording">
                            <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                            Cancel
                        </ButtonCn>
                    }
                </div>
            </div>
        </div>

        @* Comment list *@
        <div>
            @for (var i = 0; i < _comments.Length; i++)
            {
                var comment = _comments[i];
                var isLast = i == _comments.Length - 1;
                var isPlaying = _playingId == comment.Id;
                var initials = GetInitials(comment.Author);
                <div class="@(isLast ? "p-4" : "border-b p-4")">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                            </div>

                            <div class="mt-2 rounded-md border bg-muted/30 p-3">
                                <div class="mb-2 flex h-12 items-center gap-0.5">
                                    @foreach (var wh in comment.Waveform)
                                    {
                                        <div
                                            class="@Cn.Merge("flex-1 rounded-full transition-colors", isPlaying ? "bg-blue-500" : "bg-muted-foreground/40")"
                                            style="@($"height:{wh * 100}%")"
                                        ></div>
                                    }
                                </div>

                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        @{
                                            var capturedComment = comment;
                                        }
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" Class="size-7" OnClick="@(() => TogglePlay(capturedComment.Id))">
                                            @if (isPlaying)
                                            {
                                                <LucideIconCn Name="pause" Size="12" Class="size-3" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="play" Size="12" Class="size-3" />
                                            }
                                        </ButtonCn>
                                        <div class="text-xs text-muted-foreground">
                                            <span class="font-mono">@comment.Duration</span>
                                            <span class="mx-1">·</span>
                                            <span>@comment.FileSize</span>
                                        </div>
                                    </div>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm" Class="size-7">
                                        <LucideIconCn Name="download" Size="12" Class="size-3" />
                                    </ButtonCn>
                                </div>

                                @if (isPlaying)
                                {
                                    <SliderCn Value="33" Max="100" Class="mt-2" />
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">Audio files stored in WebM format</span>
        </div>

    </div>
</section>

@code {
    private record AudioComment(string Id, string Author, string Duration, string FileSize, string Timestamp, double[] Waveform);

    private static readonly AudioComment[] _comments =
    [
        new("1", "Sarah Chen",  "0:42", "856 KB",  "2 hours ago",  [0.3, 0.5, 0.7, 0.6, 0.8, 0.4, 0.5, 0.9, 0.7, 0.5, 0.3, 0.2]),
        new("2", "Alex Morgan", "1:15", "1.2 MB",  "1 hour ago",   [0.2, 0.4, 0.6, 0.8, 0.7, 0.9, 0.6, 0.5, 0.7, 0.4, 0.3, 0.2]),
        new("3", "Maya Patel",  "0:28", "512 KB",  "30 min ago",   [0.4, 0.6, 0.5, 0.7, 0.8, 0.6, 0.5, 0.4, 0.3, 0.5, 0.4, 0.2]),
    ];

    // Fixed waveform bars for recording visualization (avoids non-deterministic Math.Random in field init)
    private static readonly int[] _waveformBars =
    [
        30, 55, 70, 45, 80, 35, 60, 90, 50, 40, 75, 55, 65, 25, 85, 45, 70, 35, 60, 80,
        40, 55, 70, 30, 90, 50, 65, 45, 75, 35, 60, 80, 50, 40, 70, 55, 65, 30, 85, 45
    ];

    private bool _isRecording = false;
    private string? _playingId = null;
    private int _recordingDuration = 0;

    private void TogglePlay(string id)
    {
        _playingId = _playingId == id ? null : id;
    }

    private void CancelRecording()
    {
        _isRecording = false;
        _recordingDuration = 0;
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var result = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) result += char.ToUpper(p[0]);
        }
        return result;
    }
}
