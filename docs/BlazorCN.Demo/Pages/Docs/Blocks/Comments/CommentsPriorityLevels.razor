@* ============================================================
   Block: comments-priority-levels
   Title: CommentsPriorityLevels
   Description: React comment block for Next.js with priority badges, severity sorting, and urgency indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-priority-levels.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Comments by priority</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_sortedComments.Length total</p>
                </div>
                <div class="flex items-center gap-2">
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_countUrgent
                    </span>
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        @_countHigh
                    </span>
                    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                        @_countMedium
                    </span>
                </div>
            </div>
        </div>

        @* Filter bar *@
        <div class="border-b px-4 py-3">
            <div class="mb-2.5 flex items-center gap-2">
                <LucideIconCn Name="filter" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-xs font-medium text-muted-foreground">Filter by priority</span>
            </div>
            <div class="flex flex-wrap gap-2">
                <ButtonCn Variant="@(_filterPriority == null ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 text-xs"
                          OnClick="@(() => SetFilter(null))">
                    All
                </ButtonCn>
                @foreach (var prio in _priorities)
                {
                    var p = prio;
                    var cfg = _priorityConfig[p];
                    <ButtonCn Variant="@(_filterPriority == p ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="h-7 text-xs"
                              OnClick="@(() => SetFilter(p))">
                        @cfg.Label
                    </ButtonCn>
                }
            </div>
        </div>

        @* Comment list *@
        <div>
            @for (var i = 0; i < _sortedComments.Length; i++)
            {
                var comment = _sortedComments[i];
                var isLast = i == _sortedComments.Length - 1;
                var cfg = _priorityConfig[comment.Priority];
                <div class="@(isLast ? "p-4" : "border-b p-4")">
                    <div class="flex items-start gap-3">
                        <span class="@($"mt-1 size-2 shrink-0 rounded-full {cfg.Dot}")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="@($"text-[10px] font-normal {cfg.Color}")">
                                    @cfg.Label
                                </BadgeCn>
                                @if (comment.Escalated)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-0.5 text-[10px] font-normal">
                                        <LucideIconCn Name="arrow-up" Size="10" Class="size-2.5" />
                                        Escalated
                                    </BadgeCn>
                                }
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                            </div>
                            <p class="mt-1.5 text-sm leading-relaxed">@comment.Content</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Empty state *@
        @if (_sortedComments.Length == 0)
        {
            <div class="px-4 py-8 text-center">
                <p class="text-xs text-muted-foreground">
                    No comments with @_filterPriority priority
                </p>
            </div>
        }

    </div>
</section>

@code {
    private record PriorityConfig(string Label, string Color, string Dot, int Sort);
    private record CommentItem(string Id, string Author, string Content, string Timestamp, string Priority, bool Escalated = false);

    private static readonly string[] _priorities = ["urgent", "high", "medium", "low"];

    private static readonly Dictionary<string, PriorityConfig> _priorityConfig = new()
    {
        ["urgent"] = new("Urgent", "text-red-600 dark:text-red-400", "bg-red-500", 4),
        ["high"]   = new("High",   "text-amber-600 dark:text-amber-400", "bg-amber-500", 3),
        ["medium"] = new("Medium", "text-blue-600 dark:text-blue-400", "bg-blue-500", 2),
        ["low"]    = new("Low",    "text-muted-foreground", "bg-muted-foreground/40", 1),
    };

    private static readonly CommentItem[] _allComments =
    [
        new("1", "Sarah Chen",  "Production deployment failed. Rollback initiated but users are seeing 500 errors.",                      "5 min ago",  "urgent", Escalated: true),
        new("2", "Alex Morgan", "Payment gateway integration is blocking the Q2 release. Need immediate review.",                         "30 min ago", "high"),
        new("3", "Maya Patel",  "Dashboard loading time increased to 3 seconds. Should optimize queries before it gets worse.",           "1 hour ago", "high"),
        new("4", "Chris Taylor","Add dark mode toggle to user settings. Nice to have for next sprint.",                                   "2 hours ago","medium"),
        new("5", "Jordan Lee",  "Update documentation for the new API endpoints when time permits.",                                      "3 hours ago","low"),
    ];

    private string? _filterPriority = null;

    private int _countUrgent => _allComments.Count(c => c.Priority == "urgent");
    private int _countHigh   => _allComments.Count(c => c.Priority == "high");
    private int _countMedium => _allComments.Count(c => c.Priority == "medium");

    private CommentItem[] _sortedComments =>
        (_filterPriority is null ? _allComments : _allComments.Where(c => c.Priority == _filterPriority).ToArray())
            .OrderByDescending(c => _priorityConfig[c.Priority].Sort)
            .ToArray();

    private void SetFilter(string? priority)
    {
        _filterPriority = priority;
    }
}
