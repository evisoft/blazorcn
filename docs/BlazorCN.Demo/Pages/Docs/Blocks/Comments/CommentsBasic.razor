@* ============================================================
   Block: comments-basic
   Title: CommentsBasic
   Description: A basic threaded comment section for React and Next.js with nested replies, timestamps, and reply functionality built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-basic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Comments</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length @(_comments.Length == 1 ? "comment" : "comments")
            </p>
        </div>

        @* New comment input *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_newComment" Placeholder="Add a comment..." Class="min-h-[100px]" />
            <div class="mt-2 flex justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var comment in _comments)
            {
                var c = comment;
                <div class="p-4">
                    @RenderComment(c, 0)
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record CommentData(string Id, string Author, string Avatar, string Content, string Timestamp, CommentData[] Replies);

    private static readonly CommentData[] _comments =
    [
        new("1", "Sarah Chen", "", "This component library is exactly what I needed. The attention to detail in the animations and accessibility features is impressive.", "2 hours ago",
        [
            new("1-1", "Alex Morgan", "", "Agreed! The TypeScript support makes integration so much smoother.", "1 hour ago", []),
        ]),
        new("2", "James Wilson", "", "Has anyone tested this with Next.js 16? Looking to migrate our project.", "3 hours ago", []),
        new("3", "Maya Patel", "", "The dark mode support is flawless. Works perfectly with our existing Tailwind theme.", "5 hours ago",
        [
            new("3-1", "Chris Taylor", "", "Did you need to configure anything special for dark mode?", "4 hours ago", []),
            new("3-2", "Maya Patel", "", "No configuration needed! It uses CSS variables so it adapts automatically.", "3 hours ago", []),
        ]),
    ];

    private string _newComment = "";

    // Per-comment state keyed by comment id
    private readonly Dictionary<string, bool> _showReply = new();
    private readonly Dictionary<string, string> _replyText = new();
    private readonly Dictionary<string, bool> _collapsed = new();

    private bool GetShowReply(string id) => _showReply.TryGetValue(id, out var v) && v;
    private string GetReplyText(string id) => _replyText.TryGetValue(id, out var v) ? v : "";
    private bool GetCollapsed(string id) => _collapsed.TryGetValue(id, out var v) && v;

    private void ToggleReply(string id)
    {
        _showReply[id] = !GetShowReply(id);
    }

    private void ToggleCollapsed(string id)
    {
        _collapsed[id] = !GetCollapsed(id);
    }

    private void SetReplyText(string id, string value)
    {
        _replyText[id] = value;
    }

    private void CancelReply(string id)
    {
        _showReply[id] = false;
        _replyText[id] = "";
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var initials = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) initials += char.ToUpper(p[0]);
        }
        return initials;
    }

    private RenderFragment RenderComment(CommentData comment, int depth) => __builder =>
    {
        var initials = GetInitials(comment.Author);
        var showReply = GetShowReply(comment.Id);
        var collapsed = GetCollapsed(comment.Id);
        var replyText = GetReplyText(comment.Id);

        <div class="@(depth > 0 ? "pl-8 pt-3" : "")">
            <div class="flex gap-3">
                <AvatarCn Class="size-8 shrink-0">
                    <AvatarImageCn Src="@comment.Avatar" Alt="@comment.Author" />
                    <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <div class="flex items-baseline gap-2">
                        <span class="text-sm font-medium">@comment.Author</span>
                        <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                    </div>
                    <p class="mt-1 text-sm leading-relaxed text-foreground">@comment.Content</p>
                    <div class="mt-2 flex items-center gap-2">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="@(() => ToggleReply(comment.Id))">
                            <LucideIconCn Name="reply" Size="12" Class="size-3" />
                            Reply
                        </ButtonCn>
                        @if (comment.Replies.Length > 0)
                        {
                            var cId = comment.Id;
                            var isCollapsed = collapsed;
                            var replyCount = comment.Replies.Length;
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="@(() => ToggleCollapsed(cId))">
                                <LucideIconCn Name="message-circle" Size="12" Class="size-3" />
                                @(isCollapsed ? "Show" : "Hide") @replyCount @(replyCount == 1 ? "reply" : "replies")
                            </ButtonCn>
                        }
                    </div>

                    @if (showReply)
                    {
                        var cId = comment.Id;
                        var currentText = replyText;
                        <div class="mt-3 overflow-hidden">
                            <div class="flex gap-2">
                                <TextareaCn Value="@currentText" ValueChanged="@((string v) => SetReplyText(cId, v))" Placeholder="Write a reply..." Class="min-h-[80px] text-sm" />
                            </div>
                            <div class="mt-2 flex gap-2">
                                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                                    Post reply
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => CancelReply(cId))">
                                    Cancel
                                </ButtonCn>
                            </div>
                        </div>
                    }

                    @if (!collapsed && comment.Replies.Length > 0)
                    {
                        <div class="mt-3">
                            @foreach (var reply in comment.Replies)
                            {
                                var r = reply;
                                @RenderComment(r, depth + 1)
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    };
}
