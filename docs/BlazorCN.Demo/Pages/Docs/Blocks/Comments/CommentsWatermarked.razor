@* ============================================================
   Block: comments-watermarked
   Title: CommentsWatermarked
   Description: A watermarked comment section for React and Next.js with unique identifiers, leak prevention tracking, and screenshot protection built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-watermarked.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-lg border bg-card">

        @* Watermark overlay *@
        <div class="pointer-events-none absolute inset-0 z-10 overflow-hidden">
            <div class="absolute inset-0 select-none whitespace-nowrap font-mono text-xs text-muted-foreground opacity-[0.03]"
                 style="transform:rotate(-45deg);transform-origin:center;line-height:60px;">
                @foreach (var i in Enumerable.Range(0, 20))
                {
                    <div>@_userEmail • @_sessionId • @_userEmail • @_sessionId • @_userEmail • @_sessionId • @_userEmail • @_sessionId • @_userEmail • @_sessionId •</div>
                }
            </div>
        </div>

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Confidential Comments</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Watermarked for leak prevention
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1.5 text-xs">
                    <LucideIconCn Name="shield-alert" Size="12" Class="size-3" />
                    Protected
                </BadgeCn>
            </div>
        </div>

        @* Screenshot alert *@
        @if (_screenshotDetected)
        {
            <div class="border-b px-4 py-3">
                <div class="relative w-full rounded-lg border border-destructive/50 px-4 py-3 text-destructive [&>svg]:absolute [&>svg]:left-4 [&>svg]:top-4 [&>svg~*]:pl-7">
                    <LucideIconCn Name="alert-triangle" Size="16" Class="size-4" />
                    <p class="text-xs">
                        Screenshot activity detected. This session is watermarked with ID: @_sessionId. All captures are logged and traceable.
                    </p>
                </div>
            </div>
        }

        @* Session info bar *@
        <div class="border-b bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="eye" Size="12" Class="size-3" />
                <span>Viewing as: @_userEmail</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span class="font-mono">Session: @_sessionId</span>
            </div>
        </div>

        @* Comment list *@
        <div>
            @for (int idx = 0; idx < _comments.Length; idx++)
            {
                var comment = _comments[idx];
                var isLast = idx == _comments.Length - 1;
                var initials = GetInitials(comment.Author);
                var classificationClass = GetClassificationColor(comment.Classification);

                <div class="@(isLast ? "p-4" : "border-b p-4")">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarImageCn Src="@comment.Avatar" Alt="@comment.Author" />
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] font-normal", classificationClass)">
                                    @comment.Classification
                                </BadgeCn>
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                            </div>
                            <p class="mt-1.5 text-sm leading-relaxed">@comment.Content</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t bg-muted/30 px-4 py-2.5">
            <p class="text-xs text-muted-foreground">
                This content is watermarked and monitored. Unauthorized distribution is prohibited and traceable.
            </p>
        </div>

    </div>
</section>

@code {
    private record CommentItem(string Id, string Author, string Avatar, string Content, string Timestamp, string Classification);

    private const string _sessionId = "7f8e9a2b";
    private const string _userEmail = "viewer@@acme.com";

    private bool _screenshotDetected = false;

    private static readonly CommentItem[] _comments =
    [
        new("1", "Sarah Chen", "",
            "The Q4 revenue projections need adjustment based on the delayed product launch. We should revise down by 15-20% to maintain credibility with investors.",
            "12 min ago", "confidential"),
        new("2", "James Wilson", "",
            "Legal has approved the merger terms. All parties sign on Friday. Keep this strictly confidential until the press release.",
            "45 min ago", "restricted"),
        new("3", "Maya Patel", "",
            "The engineering team identified a critical security vulnerability in the authentication flow. Patch deploying tonight.",
            "2 hours ago", "internal"),
    ];

    private static string GetInitials(string author)
    {
        return string.Concat(author.Split(' ').Select(n => n.Length > 0 ? n[0].ToString().ToUpper() : ""));
    }

    private static string GetClassificationColor(string classification) => classification switch
    {
        "confidential" => "bg-red-500/10 text-red-600 dark:text-red-400",
        "internal"     => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "restricted"   => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        _              => "",
    };
}
