@* ============================================================
   Block: comments-push-notifications
   Title: CommentsPushNotifications
   Description: A browser push notification system for React and Next.js with permission prompts, real-time alerts, and notification preferences built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-push-notifications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Push Notifications</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_unreadCount unread • Real-time updates
                    </p>
                </div>
                <BadgeCn Variant="@(_permission == "granted" ? BadgeVariant.Default : BadgeVariant.Outline)" Class="gap-1.5 text-xs">
                    <LucideIconCn Name="bell" Size="12" Class="size-3" />
                    @(_permission == "granted" ? "Enabled" : "Disabled")
                </BadgeCn>
            </div>
        </div>

        @* Permission prompt *@
        @if (_permission == "default")
        {
            <div class="border-b px-4 py-3">
                <div class="relative w-full rounded-lg border bg-card p-4 [&>svg~*]:pl-7 [&>svg+div]:translate-y-[-3px] [&>svg]:absolute [&>svg]:left-4 [&>svg]:top-4 [&>svg]:text-foreground">
                    <LucideIconCn Name="bell" Size="16" Class="size-4" />
                    <div class="text-xs [&_p]:leading-relaxed">
                        Enable push notifications to get instant updates when someone comments. You can
                        change this anytime in settings.
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="mt-2 h-7 text-xs" OnClick="RequestPermission">
                        Enable notifications
                    </ButtonCn>
                </div>
            </div>
        }

        @* Sound settings (shown when granted) *@
        @if (_permission == "granted")
        {
            <div class="border-b bg-muted/30 px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        @if (_soundEnabled)
                        {
                            <LucideIconCn Name="volume-2" Size="14" Class="size-3.5 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideIconCn Name="volume-x" Size="14" Class="size-3.5 text-muted-foreground" />
                        }
                        <span class="text-xs text-muted-foreground">Notification sounds</span>
                    </div>
                    <SwitchCn @bind-Value="_soundEnabled" aria-label="Notification sounds" />
                </div>
            </div>
        }

        @* Notification list *@
        <div>
            @foreach (var notif in _notificationList)
            {
                var n = notif;
                var isLast = n.Id == _notificationList[_notificationList.Length - 1].Id;
                var initials = GetInitials(n.Author);
                <div class="@(isLast ? "p-4" : "border-b p-4")">
                    <button type="button" @onclick="@(() => MarkAsRead(n.Id))"
                            class="@Cn.Merge("flex w-full gap-3 text-left transition-opacity", n.Read ? "opacity-60" : "")">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarImageCn Src="@n.Avatar" Alt="@n.Author" />
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                @if (!n.Read)
                                {
                                    <span class="size-2 shrink-0 rounded-full bg-blue-500"></span>
                                }
                                <span class="text-sm font-medium">@n.Author</span>
                                <span class="text-xs text-muted-foreground">commented on</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                    @n.Thread
                                </BadgeCn>
                            </div>
                            <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
                                @n.Preview
                            </p>
                            <span class="mt-1 text-xs text-muted-foreground">
                                @n.Timestamp
                            </span>
                        </div>
                        @if (n.Read)
                        {
                            <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                        }
                    </button>
                </div>
            }
        </div>

        @* Footer actions *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs text-muted-foreground" OnClick="DisableNotifications">
                    <LucideIconCn Name="bell-off" Size="12" Class="size-3" />
                    Disable notifications
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="MarkAllRead" Disabled="@(_unreadCount == 0)">
                    <LucideIconCn Name="check-circle-2" Size="12" Class="size-3" />
                    Mark all read
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record NotificationItem(string Id, string Author, string Avatar, string Thread, string Preview, string Timestamp, bool Read);

    private static readonly NotificationItem[] _initialNotifications =
    [
        new("1", "Sarah Chen", "", "Product Roadmap Q2", "I think we should prioritize the mobile app redesign first. What do you think?", "2 min ago", false),
        new("2", "James Wilson", "", "Design System Updates", "The new color palette looks great! Can we get the Figma files by EOD?", "15 min ago", false),
        new("3", "Maya Patel", "", "API Documentation", "Found a typo in the authentication section. I'll open a PR to fix it.", "1 hour ago", true),
    ];

    private string _permission = "default";
    private bool _soundEnabled = true;
    private NotificationItem[] _notificationList = _initialNotifications;

    private int _unreadCount => _notificationList.Count(n => !n.Read);

    private void RequestPermission()
    {
        _permission = "granted";
    }

    private void DisableNotifications()
    {
        _permission = "denied";
    }

    private void MarkAsRead(string id)
    {
        _notificationList = _notificationList.Select(n => n.Id == id ? n with { Read = true } : n).ToArray();
    }

    private void MarkAllRead()
    {
        _notificationList = _notificationList.Select(n => n with { Read = true }).ToArray();
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var initials = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) initials += char.ToUpper(p[0]);
        }
        return initials;
    }
}
