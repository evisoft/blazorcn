@* ============================================================
   Block: comments-digest-email
   Title: CommentsDigestEmail
   Description: An email digest preview for React and Next.js with notification summaries, frequency controls, and unsubscribe options built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-digest-email.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Comment Digest Email</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_unreadCount new threads • @_totalComments total comments
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1.5 text-xs">
                    <LucideIconCn Name="mail" Size="12" Class="size-3" />
                    Preview
                </BadgeCn>
            </div>
        </div>

        @* Frequency selector *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Digest frequency:</span>
                <div class="flex gap-1">
                    @foreach (var freq in _frequencies)
                    {
                        var f = freq;
                        <button
                            type="button"
                            @onclick="@(() => _frequency = f)"
                            class="@Cn.Merge("rounded-sm px-2 py-1 text-xs font-medium transition-all", _frequency == f ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                            @f
                        </button>
                    }
                </div>
            </div>
        </div>

        @* Delivery info *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">Your @_frequency comment digest</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Delivered @GetDeliveryText(_frequency)
                    </p>
                </div>
            </div>
        </div>

        @* Thread list *@
        <div>
            @for (var i = 0; i < _threads.Length; i++)
            {
                var thread = _threads[i];
                var isLast = i == _threads.Length - 1;
                var avatarInitials = GetAvatarInitials(thread.Participants);
                <div class="@(isLast ? "p-4" : "border-b p-4")">
                    <div class="space-y-2">
                        <div class="flex items-start justify-between gap-3">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    @if (thread.Unread)
                                    {
                                        <span class="size-2 shrink-0 rounded-full bg-blue-500"></span>
                                    }
                                    <h3 class="text-sm font-medium">@thread.Title</h3>
                                </div>
                                <p class="mt-1 text-xs text-muted-foreground">
                                    @thread.CommentCount new @(thread.CommentCount == 1 ? "comment" : "comments")
                                </p>
                            </div>
                            <span class="shrink-0 text-xs text-muted-foreground">@thread.Timestamp</span>
                        </div>

                        <div class="flex items-center gap-2">
                            <div class="flex -space-x-2">
                                @foreach (var initials in avatarInitials)
                                {
                                    <AvatarCn Class="size-6 border-2 border-background">
                                        <AvatarFallbackCn Class="text-[10px]">@initials</AvatarFallbackCn>
                                    </AvatarCn>
                                }
                            </div>
                            <span class="text-xs text-muted-foreground">@string.Join(", ", thread.Participants)</span>
                        </div>

                        <p class="line-clamp-2 text-sm leading-relaxed text-muted-foreground">@thread.LastComment</p>

                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 w-full text-xs">
                            View thread
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground">
                    Unsubscribe from digest
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="circle-check-big" Size="12" Class="size-3" />
                    Mark all read
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record DigestThread(
        string Id,
        string Title,
        int CommentCount,
        string[] Participants,
        string LastComment,
        string Timestamp,
        bool Unread
    );

    private static readonly string[] _frequencies = ["instant", "hourly", "daily", "weekly"];

    private static readonly DigestThread[] _threads =
    [
        new("1", "Product Roadmap Q2 2026", 8,
            ["Sarah Chen", "James Wilson", "Maya Patel"],
            "Agreed on the timeline. Let's prioritize the mobile app redesign first.",
            "2 hours ago", true),
        new("2", "Design System Updates", 5,
            ["Alex Morgan", "Chris Taylor"],
            "The new color palette looks great. Can we get Figma files by EOD?",
            "4 hours ago", true),
        new("3", "API Documentation Review", 12,
            ["Maya Patel", "Sarah Chen", "Jordan Lee"],
            "Found a typo in the authentication section. Opening a PR to fix.",
            "6 hours ago", false),
    ];

    private string _frequency = "daily";

    private int _unreadCount => _threads.Count(t => t.Unread);
    private int _totalComments => _threads.Sum(t => t.CommentCount);

    private static string GetDeliveryText(string frequency) => frequency switch
    {
        "instant" => "in real-time",
        "hourly"  => "every hour",
        "daily"   => "every day at 8am",
        _         => "every Monday at 8am",
    };

    private static string[] GetAvatarInitials(string[] participants)
    {
        return participants
            .Take(2)
            .Select(p =>
            {
                var parts = p.Split(' ');
                var initials = "";
                foreach (var part in parts)
                    if (part.Length > 0) initials += part[0];
                return initials;
            })
            .ToArray();
    }
}
