@* ============================================================
   Block: comments-image-annotation
   Title: CommentsImageAnnotation
   Description: Image annotation with comment markers for React and Next.js with pin placement, coordinate tracking, and annotation overlay built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-image-annotation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Design Review</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_annotations.Length annotations on landing-page-v2.png
                    </p>
                </div>
                <ButtonCn Variant="@(_showAddMode ? ButtonVariant.Secondary : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-7 gap-1 text-xs"
                          OnClick="@(() => _showAddMode = !_showAddMode)">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    @(_showAddMode ? "Cancel" : "Add annotation")
                </ButtonCn>
            </div>
        </div>

        @* Image area with annotation pins *@
        <div class="relative aspect-video border-b bg-muted/30">
            <div class="absolute inset-0 flex items-center justify-center">
                <span class="text-sm text-muted-foreground">
                    [Image preview: landing-page-v2.png]
                </span>
            </div>

            @foreach (var annotation in _annotations)
            {
                var ann = annotation;
                <button type="button"
                        style="@($"position:absolute;left:{ann.X}%;top:{ann.Y}%;transform:translate(-50%,-50%)")"
                        @onclick="@(() => ToggleAnnotation(ann.Id))"
                        class="@Cn.Merge("flex size-7 items-center justify-center rounded-full border-2 bg-background text-xs font-medium shadow-lg transition-all hover:scale-110", _selectedAnnotation == ann.Id ? "border-blue-500 text-blue-600 dark:text-blue-400" : "border-foreground text-foreground")">
                    @ann.Number
                </button>
            }

            @if (_showAddMode)
            {
                <div class="absolute inset-0 cursor-crosshair bg-blue-500/5">
                    <div class="flex size-full items-center justify-center">
                        <span class="text-xs text-muted-foreground">Click to place annotation</span>
                    </div>
                </div>
            }
        </div>

        @* Annotation list *@
        <div>
            @for (int i = 0; i < _annotations.Length; i++)
            {
                var ann = _annotations[i];
                var isExpanded = _selectedAnnotation == ann.Id;
                var isLast = i == _annotations.Length - 1;
                var initials = GetInitials(ann.Author);

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => ToggleAnnotation(ann.Id))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="size-7 shrink-0 justify-center p-0 text-xs font-medium">
                            @ann.Number
                        </BadgeCn>
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@ann.Author</span>
                                <span class="text-xs text-muted-foreground">@ann.Timestamp</span>
                            </div>
                            <p class="mt-0.5 truncate text-sm text-muted-foreground">
                                @ann.Comment
                            </p>
                        </div>
                        @if (ann.Replies > 0)
                        {
                            <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                <LucideIconCn Name="message-circle" Size="12" Class="size-3" />
                                @ann.Replies
                            </div>
                        }
                    </button>

                    @if (isExpanded)
                    {
                        var annId = ann.Id;
                        var replyText = GetReplyText(annId);
                        <div class="border-t bg-muted/20 px-4 pb-4 pl-20 pt-3">
                            <p class="text-sm leading-relaxed">@ann.Comment</p>
                            <div class="mt-3">
                                <TextareaCn Value="@replyText"
                                            ValueChanged="@((string v) => SetReplyText(annId, v))"
                                            Placeholder="Reply to this annotation..."
                                            Class="min-h-[60px] text-sm" aria-label="Reply to this annotation..." />
                                <div class="mt-2 flex justify-end gap-2">
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                                        Reply
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span>Position coordinates stored as percentages</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Export annotations
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Annotation(string Id, int Number, int X, int Y, string Author, string Comment, string Timestamp, int Replies);

    private static readonly Annotation[] _annotations =
    [
        new("1", 1, 25, 30, "Sarah Chen", "Logo should be slightly larger for better visibility", "2 hours ago", 2),
        new("2", 2, 65, 45, "Alex Morgan", "CTA button color needs more contrast with background", "1 hour ago", 1),
        new("3", 3, 40, 70, "Maya Patel", "Footer text is too small on mobile devices", "30 min ago", 0),
    ];

    private string? _selectedAnnotation = null;
    private bool _showAddMode = false;

    private readonly Dictionary<string, string> _replyText = new();

    private string GetReplyText(string id) => _replyText.TryGetValue(id, out var v) ? v : "";

    private void SetReplyText(string id, string value)
    {
        _replyText[id] = value;
    }

    private void ToggleAnnotation(string id)
    {
        _selectedAnnotation = _selectedAnnotation == id ? null : id;
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var initials = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) initials += char.ToUpper(p[0]);
        }
        return initials;
    }
}
