@* ============================================================
   Block: comments-read-receipts
   Title: CommentsReadReceipts
   Description: Track who has read each comment in React and Next.js with read status indicators, viewer lists, and read timestamp tracking built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-read-receipts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Team Updates</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Count(c => !c.IsRead) unread · @_comments.Length total
            </p>
        </div>

        @* Comment list *@
        <div>
            @foreach (var comment in _comments)
            {
                var cm = comment;
                var isLast = Array.IndexOf(_comments, cm) == _comments.Length - 1;
                var showReaders = _expandedReaders == cm.Id;
                var initials = GetInitials(cm.Author);

                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex gap-3">
                            <AvatarCn Class="size-8 shrink-0">
                                <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-baseline gap-2">
                                    <span class="text-sm font-medium">@cm.Author</span>
                                    <span class="text-xs text-muted-foreground">@cm.Timestamp</span>
                                    @if (!cm.IsRead)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-blue-500/10 text-xs font-normal text-blue-600 dark:text-blue-400">
                                            New
                                        </BadgeCn>
                                    }
                                </div>
                                <p class="mt-1 text-sm leading-relaxed">@cm.Content</p>

                                <div class="mt-2 flex items-center gap-2">
                                    <button type="button" @onclick="@(() => ToggleReaders(cm.Id))"
                                        class="flex items-center gap-1.5 rounded-md px-2 py-1 text-xs text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground">
                                        <LucideIconCn Name="eye" Size="12" Class="size-3" />
                                        <span>@cm.Readers.Length read</span>
                                    </button>
                                    @if (!cm.IsRead)
                                    {
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                            <LucideIconCn Name="check-check" Size="12" Class="size-3" />
                                            Mark as read
                                        </ButtonCn>
                                    }
                                </div>

                                @if (showReaders)
                                {
                                    <div class="mt-3 overflow-hidden rounded-md border bg-muted/30 p-3">
                                        <span class="text-xs font-medium text-muted-foreground">
                                            Read by @cm.Readers.Length @(cm.Readers.Length == 1 ? "person" : "people")
                                        </span>
                                        <div class="mt-2 space-y-2">
                                            @foreach (var reader in cm.Readers)
                                            {
                                                var rd = reader;
                                                var readerInitials = GetInitials(rd.Name);
                                                <div class="flex items-center gap-2">
                                                    <AvatarCn Class="size-6 shrink-0">
                                                        <AvatarFallbackCn Class="text-[10px]">@readerInitials</AvatarFallbackCn>
                                                    </AvatarCn>
                                                    <span class="text-xs font-medium">@rd.Name</span>
                                                    <span class="ml-auto text-xs text-muted-foreground">@rd.ReadAt</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5 text-center">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Mark all as read
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record ReaderData(string Id, string Name, string ReadAt);
    private record CommentData(string Id, string Author, string Content, string Timestamp, bool IsRead, ReaderData[] Readers);

    private static readonly CommentData[] _comments =
    [
        new("1", "Sarah Chen",
            "Q2 roadmap has been finalized. All teams should review the priority list and provide feedback by Friday.",
            "2 hours ago", true,
            [
                new("1", "Alex Morgan", "1 hour ago"),
                new("2", "Maya Patel", "1 hour ago"),
                new("3", "Chris Taylor", "30 min ago"),
            ]),
        new("2", "James Wilson",
            "Security audit completed. Found 2 medium-priority issues that need attention this week.",
            "4 hours ago", false,
            [
                new("1", "Alex Morgan", "3 hours ago"),
                new("4", "Emma Davis", "2 hours ago"),
            ]),
        new("3", "Maya Patel",
            "User testing session scheduled for Thursday at 2pm. Looking for 3 volunteers to observe.",
            "6 hours ago", true,
            [
                new("1", "Alex Morgan", "5 hours ago"),
                new("2", "Sarah Chen", "4 hours ago"),
                new("3", "Chris Taylor", "3 hours ago"),
                new("4", "Emma Davis", "2 hours ago"),
                new("5", "James Wilson", "1 hour ago"),
            ]),
    ];

    private string? _expandedReaders = null;

    private void ToggleReaders(string commentId)
    {
        _expandedReaders = _expandedReaders == commentId ? null : commentId;
    }

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ');
        var initials = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) initials += char.ToUpper(p[0]);
        }
        return initials;
    }
}
