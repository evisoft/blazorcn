@* ============================================================
   Block: comments-notification-center
   Title: CommentsNotificationCenter
   Description: A unified notification inbox for React and Next.js with tabbed filtering, read/unread states, and bulk actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-notification-center.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Notification Center</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_unreadCount unread in @_activeTab
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1.5 text-xs">
                    <LucideIconCn Name="bell" Size="12" Class="size-3" />
                    @(_notifications.Count(n => !n.Read))
                </BadgeCn>
            </div>
        </div>

        @* Tab bar *@
        <div class="border-b bg-muted/30 px-4 py-2">
            <div class="flex items-center gap-1">
                @foreach (var tab in _tabs)
                {
                    var tabValue = tab.Value;
                    <button type="button"
                            @onclick="@(() => SetActiveTab(tabValue))"
                            class="@Cn.Merge("relative rounded-sm px-3 py-1.5 text-xs font-medium transition-all", _activeTab == tabValue ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                        @tab.Label
                        @if (tab.Count > 0)
                        {
                            <span class="ml-1.5 rounded-full bg-blue-500 px-1.5 py-0.5 text-[10px] text-white">
                                @tab.Count
                            </span>
                        }
                    </button>
                }
            </div>
        </div>

        @* Notification list *@
        <div>
            @{
                var filtered = _filteredNotifications;
            }
            @if (filtered.Length > 0)
            {
                @for (int i = 0; i < filtered.Length; i++)
                {
                    var notif = filtered[i];
                    var isLast = i == filtered.Length - 1;
                    var initials = GetInitials(notif.Author);
                    var iconName = GetTypeIconName(notif.Type);
                    <div class="@(isLast ? "p-4" : "border-b p-4")">
                        <button type="button"
                                @onclick="@(() => MarkAsRead(notif.Id))"
                                class="@Cn.Merge("flex w-full gap-3 text-left transition-opacity", notif.Read ? "opacity-60" : "")">
                            <AvatarCn Class="size-8 shrink-0">
                                <AvatarImageCn Src="@notif.Avatar" Alt="@notif.Author" />
                                <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    @if (!notif.Read)
                                    {
                                        <span class="size-2 shrink-0 rounded-full bg-blue-500"></span>
                                    }
                                    <span class="text-sm font-medium">@notif.Author</span>
                                    <span class="text-xs text-muted-foreground">@notif.Action</span>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-[10px] font-normal">
                                        <LucideIconCn Name="@iconName" Size="12" Class="size-3" />
                                        @notif.Type
                                    </BadgeCn>
                                </div>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="mt-1 text-[10px] font-normal">
                                    @notif.Thread
                                </BadgeCn>
                                <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-muted-foreground">
                                    @notif.Preview
                                </p>
                                <span class="mt-1 text-xs text-muted-foreground">
                                    @notif.Timestamp
                                </span>
                            </div>
                            @if (notif.Read)
                            {
                                <LucideIconCn Name="circle-check-2" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                            }
                        </button>
                    </div>
                }
            }
            else
            {
                <div class="px-4 py-8 text-center">
                    <LucideIconCn Name="bell" Size="32" Class="mx-auto size-8 text-muted-foreground/40" />
                    <p class="mt-2 text-sm text-muted-foreground">
                        No notifications in @_activeTab
                    </p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Sm"
                      Class="h-7 w-full gap-1.5 text-xs"
                      OnClick="MarkAllRead"
                      Disabled="@(_unreadCount == 0)">
                <LucideIconCn Name="circle-check-2" Size="12" Class="size-3" />
                Mark all as read
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private string _activeTab = "all";

    private sealed class Notification
    {
        public string Id { get; init; } = "";
        public string Type { get; init; } = "";
        public string Author { get; init; } = "";
        public string Avatar { get; init; } = "";
        public string Action { get; init; } = "";
        public string Thread { get; init; } = "";
        public string Preview { get; init; } = "";
        public string Timestamp { get; init; } = "";
        public bool Read { get; set; }
    }

    private List<Notification> _notifications =
    [
        new() { Id = "1", Type = "mention",  Author = "Sarah Chen",   Avatar = "", Action = "mentioned you in",            Thread = "Product Roadmap Q2",       Preview = "@alex what's your take on the timeline for the mobile app?", Timestamp = "5 min ago",   Read = false },
        new() { Id = "2", Type = "reply",    Author = "James Wilson", Avatar = "", Action = "replied to your comment in",  Thread = "Design System Updates",    Preview = "Great point about the spacing. I'll update the tokens.",     Timestamp = "15 min ago",  Read = false },
        new() { Id = "3", Type = "reaction", Author = "Maya Patel",   Avatar = "", Action = "reacted ❤️ to your comment in", Thread = "API Documentation",      Preview = "The new authentication flow is much clearer now.",           Timestamp = "1 hour ago",  Read = false },
        new() { Id = "4", Type = "mention",  Author = "Chris Taylor", Avatar = "", Action = "mentioned you in",            Thread = "Security Audit",           Preview = "@alex can you review the access control implementation?",    Timestamp = "2 hours ago", Read = true  },
        new() { Id = "5", Type = "reply",    Author = "Jordan Lee",   Avatar = "", Action = "replied to your comment in",  Thread = "Performance Optimization", Preview = "I implemented your suggestion. Load time is down 40%!",      Timestamp = "3 hours ago", Read = true  },
    ];

    private int _unreadCount => _filteredNotifications.Count(n => !n.Read);

    private Notification[] _filteredNotifications =>
        _activeTab == "all"
            ? _notifications.ToArray()
            : _notifications.Where(n => n.Type == _activeTab[..^1]).ToArray();

    private record TabItem(string Value, string Label, int Count);

    private TabItem[] _tabs =>
    [
        new("all",       "All",       _notifications.Count(n => !n.Read)),
        new("mentions",  "Mentions",  _notifications.Count(n => n.Type == "mention"  && !n.Read)),
        new("replies",   "Replies",   _notifications.Count(n => n.Type == "reply"    && !n.Read)),
        new("reactions", "Reactions", _notifications.Count(n => n.Type == "reaction" && !n.Read)),
    ];

    private void SetActiveTab(string tab) => _activeTab = tab;

    private void MarkAsRead(string id)
    {
        var notif = _notifications.FirstOrDefault(n => n.Id == id);
        if (notif is not null) notif.Read = true;
    }

    private void MarkAllRead()
    {
        foreach (var notif in _notifications)
        {
            if (_activeTab == "all" || notif.Type == _activeTab[..^1])
                notif.Read = true;
        }
    }

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();

    private static string GetTypeIconName(string type) => type switch
    {
        "mention"  => "at-sign",
        "reply"    => "message-circle",
        "reaction" => "heart",
        _          => "bell",
    };
}
