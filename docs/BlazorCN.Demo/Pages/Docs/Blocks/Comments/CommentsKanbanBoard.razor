@* ============================================================
   Block: comments-kanban-board
   Title: CommentsKanbanBoard
   Description: A kanban-style comment workflow board for React and Next.js with drag-drop columns, status tracking, and visual progress built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-kanban-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-6xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Kanban Board</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_items.Count total comments across @_columns.Length columns
            </p>
        </div>

        <div class="grid grid-cols-3 gap-4 p-4">
            @foreach (var col in _columns)
            {
                var column = col;
                var columnComments = GetColumnComments(column.Id);
                <div class="flex min-h-[400px] flex-col rounded-lg border bg-muted/20"
                     ondragover="event.preventDefault()"
                     @ondrop="@(() => HandleDrop(column.Id))">
                    <div class="flex items-center justify-between border-b bg-card px-3 py-2">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-2 rounded-full", column.Color)"></span>
                            <span class="text-sm font-medium">@column.Label</span>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 text-[10px] font-normal tabular-nums">
                            @columnComments.Count
                        </BadgeCn>
                    </div>
                    <div class="flex-1 space-y-2 p-2">
                        @foreach (var cmt in columnComments)
                        {
                            var comment = cmt;
                            var initials = GetInitials(comment.Author);
                            <div class="@Cn.Merge("cursor-move rounded-lg border bg-card p-3 transition-all hover:shadow-md", _draggedId == comment.Id ? "opacity-50" : "")"
                                 draggable="true"
                                 @ondragstart="@(() => HandleDragStart(comment.Id))">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="flex items-center gap-2">
                                        <AvatarCn Class="size-6">
                                            <AvatarFallbackCn Class="text-[10px]">@initials</AvatarFallbackCn>
                                        </AvatarCn>
                                        <span class="text-xs font-medium">@comment.Author</span>
                                    </div>
                                    <button type="button" class="text-muted-foreground/60 transition-colors hover:text-foreground" aria-label="More options">
                                        <LucideIconCn Name="more-vertical" Size="12" Class="size-3" />
                                    </button>
                                </div>
                                <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-muted-foreground">
                                    @comment.Content
                                </p>
                                <span class="mt-2 block text-[10px] text-muted-foreground">
                                    @comment.Timestamp
                                </span>
                            </div>
                        }
                        @if (columnComments.Count == 0)
                        {
                            <div class="flex h-full items-center justify-center rounded-lg border-2 border-dashed border-muted-foreground/20 py-8">
                                <p class="text-xs text-muted-foreground">Drop here</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-2.5 text-xs text-muted-foreground">
            Drag cards between columns to update status
        </div>

    </div>
</section>

@code {
    private record CommentItem(string Id, string Author, string Content, string Status, string Timestamp);
    private record ColumnDef(string Id, string Label, string Color);

    private static readonly ColumnDef[] _columns =
    [
        new("new", "New", "bg-blue-500"),
        new("reviewing", "Reviewing", "bg-amber-500"),
        new("resolved", "Resolved", "bg-emerald-500"),
    ];

    private List<CommentItem> _items =
    [
        new("1", "Sarah Chen", "This component library is excellent for TypeScript projects", "new", "2 hours ago"),
        new("2", "James Wilson", "How do I integrate the authentication module?", "new", "3 hours ago"),
        new("3", "Maya Patel", "The dark mode implementation is flawless", "reviewing", "5 hours ago"),
        new("4", "Alex Morgan", "TypeScript types are well-documented", "reviewing", "7 hours ago"),
        new("5", "Chris Taylor", "Found the solution in the documentation", "resolved", "1 day ago"),
        new("6", "Jordan Lee", "Great support, issue fixed quickly", "resolved", "2 days ago"),
    ];

    private string? _draggedId = null;

    private List<CommentItem> GetColumnComments(string status) =>
        _items.Where(i => i.Status == status).ToList();

    private void HandleDragStart(string id)
    {
        _draggedId = id;
    }

    private void HandleDrop(string status)
    {
        if (_draggedId is null) return;
        var draggedId = _draggedId;
        _items = _items.Select(item => item.Id == draggedId ? item with { Status = status } : item).ToList();
        _draggedId = null;
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var initials = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) initials += char.ToUpper(p[0]);
        }
        return initials;
    }
}
