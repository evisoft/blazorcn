@* ============================================================
   Block: comments-poll-embed
   Title: CommentsPollEmbed
   Description: An inline poll comment system for React and Next.js with multi-choice voting, real-time results, percentage bars, and vote count display built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-poll-embed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Comments</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length @(_comments.Length == 1 ? "comment" : "comments")
            </p>
        </div>

        @* New comment input *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_newComment" Placeholder="Add a comment..." Class="min-h-[100px]" aria-label="Add a comment..." />

            <div class="mt-2 flex items-center justify-between">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="@(() => _showPollCreator = !_showPollCreator)">
                    <LucideIconCn Name="pie-chart" Size="12" Class="size-3" />
                    @(_showPollCreator ? "Hide" : "Add") poll
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var comment in _comments)
            {
                var c = comment;
                var initials = GetInitials(c.Author);
                var userVote = GetUserVote(c.Id);
                var hasVoted = userVote != null;

                <div class="p-4">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@c.Author</span>
                                <span class="text-xs text-muted-foreground">@c.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed">@c.Content</p>

                            @if (c.Poll != null)
                            {
                                var poll = c.Poll;
                                var commentId = c.Id;
                                var voted = hasVoted;
                                var vote = userVote;

                                <div class="mt-3 rounded-md border bg-muted/30 p-3">
                                    <div class="mb-3 flex items-center justify-between">
                                        <span class="text-sm font-medium">@poll.Question</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                            @poll.TotalVotes votes
                                        </BadgeCn>
                                    </div>

                                    <div class="space-y-2">
                                        @foreach (var option in poll.Options)
                                        {
                                            var opt = option;
                                            var percentage = (int)Math.Round((double)opt.Votes / poll.TotalVotes * 100);
                                            var isSelected = vote == opt.Id;

                                            <button type="button"
                                                    @onclick="@(() => HandleVote(commentId, opt.Id))"
                                                    disabled="@(voted ? "disabled" : null)"
                                                    class="w-full text-left transition-all disabled:cursor-default">
                                                <div class="flex items-center gap-2">
                                                    <div class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border-2 transition-colors", isSelected ? "border-blue-500 bg-blue-500" : "border-muted-foreground/40")">
                                                        @if (isSelected)
                                                        {
                                                            <div class="size-1.5 rounded-full bg-white"></div>
                                                        }
                                                    </div>
                                                    <span class="min-w-0 flex-1 text-sm">@opt.Text</span>
                                                    @if (voted)
                                                    {
                                                        <span class="text-xs font-medium tabular-nums text-muted-foreground">@percentage%</span>
                                                    }
                                                </div>
                                                @if (voted)
                                                {
                                                    <ProgressCn Value="@percentage" Class="mt-1.5 h-1.5" aria-label="Progress" />
                                                }
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record PollOption(string Id, string Text, int Votes);
    private record PollData(string Question, PollOption[] Options, int TotalVotes);
    private record CommentData(string Id, string Author, string Content, string Timestamp, PollData? Poll);

    private static readonly CommentData[] _comments =
    [
        new("1", "Sarah Chen", "Which feature should we prioritize next sprint?", "2 hours ago",
            new PollData("Next sprint priority",
            [
                new("o1", "Dark mode improvements", 12),
                new("o2", "Mobile responsiveness", 8),
                new("o3", "Performance optimizations", 15),
                new("o4", "Accessibility fixes", 5),
            ],
            40)),
        new("2", "Alex Morgan", "Great discussion! Let's align on the roadmap.", "3 hours ago", null),
    ];

    private string _newComment = "";
    private bool _showPollCreator = false;
    private readonly Dictionary<string, string> _selectedVotes = new();

    private string? GetUserVote(string commentId) =>
        _selectedVotes.TryGetValue(commentId, out var v) ? v : null;

    private void HandleVote(string commentId, string optionId)
    {
        _selectedVotes[commentId] = optionId;
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var initials = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) initials += char.ToUpper(p[0]);
        }
        return initials;
    }
}
