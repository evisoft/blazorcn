@* ============================================================
   Block: comments-ai-suggested-replies
   Title: CommentsAiSuggestedReplies
   Description: An AI-powered suggested reply comment system for React and Next.js with context-aware suggestions, quick reply chips, tone selection, and one-click response built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-ai-suggested-replies.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Comments</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length @(_comments.Length == 1 ? "comment" : "comments")
            </p>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var comment in _comments)
            {
                var initials = GetInitials(comment.Author);
                var isReplying = _replyTo == comment.Id;
                var commentSuggestions = _suggestions.ContainsKey(comment.Id) ? _suggestions[comment.Id] : [];
                var cid = comment.Id;

                <div class="p-4">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed">@comment.Content</p>

                            @if (!isReplying)
                            {
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="mt-2 h-7 gap-1 px-2 text-xs"
                                          OnClick="@(() => StartReply(cid))">
                                    Reply
                                </ButtonCn>
                            }

                            @if (isReplying)
                            {
                                <div class="mt-3 overflow-hidden rounded-md border bg-muted/30 p-3">

                                    @if (_showSuggestions && commentSuggestions.Length > 0)
                                    {
                                        <div class="mb-3 overflow-hidden">
                                            <div class="mb-2 flex items-center justify-between">
                                                <div class="flex items-center gap-1.5">
                                                    <LucideIconCn Name="sparkles" Size="12" Class="size-3 text-blue-600 dark:text-blue-400" />
                                                    <span class="text-xs font-medium text-muted-foreground">
                                                        Suggested replies
                                                    </span>
                                                </div>
                                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                                                    Refresh
                                                </ButtonCn>
                                            </div>
                                            <div class="space-y-2">
                                                @foreach (var suggestion in commentSuggestions)
                                                {
                                                    var sug = suggestion;
                                                    <button type="button"
                                                            @onclick="@(() => HandleSelectSuggestion(sug.Text))"
                                                            class="@Cn.Merge("w-full rounded-md border p-2.5 text-left text-sm transition-all hover:bg-muted/50", ToneColor(sug.Tone))">
                                                        <div class="mb-1.5 flex items-center gap-1.5">
                                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                                                @sug.Tone
                                                            </BadgeCn>
                                                        </div>
                                                        <p class="leading-relaxed">@sug.Text</p>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <TextareaCn @bind-Value="_replyText" Placeholder="Write a reply..." Class="min-h-[80px] text-sm" aria-label="Write a reply..." />

                                    <div class="mt-2 flex items-center justify-between">
                                        @if (!_showSuggestions && commentSuggestions.Length > 0)
                                        {
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                                                      OnClick="@(() => _showSuggestions = true)">
                                                <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                                                Show suggestions
                                            </ButtonCn>
                                        }
                                        <div class="ml-auto flex gap-2">
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs"
                                                      OnClick="@(() => CancelReply())">
                                                Cancel
                                            </ButtonCn>
                                            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                                                Post reply
                                            </ButtonCn>
                                        </div>
                                    </div>

                                </div>
                            }

                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Comment(string Id, string Author, string Content, string Timestamp);
    private record Suggestion(string Id, string Text, string Tone);

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen",
            "I'm having trouble getting the new authentication flow to work. The callback URL keeps returning a 404 error.",
            "2 hours ago"),
        new("2", "Alex Morgan",
            "Great tutorial! This helped me solve the issue I was facing.",
            "3 hours ago"),
    ];

    private static readonly Dictionary<string, Suggestion[]> _suggestions = new()
    {
        ["1"] =
        [
            new("s1", "Thanks for reporting this. Could you share your callback URL configuration so we can debug the issue?", "professional"),
            new("s2", "Hey! That's a common issue. Mind sharing your setup so I can take a look?", "casual"),
            new("s3", "I understand how frustrating 404 errors can be. Let's get this sorted out together. Can you share your configuration?", "empathetic"),
        ],
        ["2"] =
        [
            new("s4", "Thank you for the positive feedback! I'm glad the tutorial was helpful.", "professional"),
            new("s5", "Awesome! Happy to hear it worked for you!", "casual"),
            new("s6", "So glad it helped! Feel free to reach out if you have any other questions.", "empathetic"),
        ],
    };

    private static readonly Dictionary<string, string> _toneColors = new()
    {
        ["professional"] = "border-blue-500/50 bg-blue-500/10",
        ["casual"]       = "border-emerald-500/50 bg-emerald-500/10",
        ["empathetic"]   = "border-amber-500/50 bg-amber-500/10",
    };

    private string? _replyTo;
    private string _replyText = "";
    private bool _showSuggestions = true;

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => char.ToUpper(n[0])));

    private static string ToneColor(string tone) =>
        _toneColors.TryGetValue(tone, out var cls) ? cls : "";

    private void StartReply(string commentId)
    {
        _replyTo = commentId;
        _showSuggestions = true;
        _replyText = "";
    }

    private void HandleSelectSuggestion(string text)
    {
        _replyText = text;
        _showSuggestions = false;
    }

    private void CancelReply()
    {
        _replyTo = null;
        _replyText = "";
    }
}
