@* ============================================================
   Block: comments-ai-compliance-check
   Title: CommentsAiComplianceCheck
   Description: React comment block for Next.js with AI-powered sensitive data detection, PII scanning, and compliance warnings built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-ai-compliance-check.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Add comment</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">AI compliance checking enabled</p>
                </div>
                @if (_issues.Count == 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 text-[10px] font-normal">
                        <LucideIconCn Name="shield-check" Size="10" Class="size-2.5 text-emerald-500" />
                        Compliant
                    </BadgeCn>
                }
                else
                {
                    <div class="flex items-center gap-2">
                        <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="size-1.5 rounded-full bg-red-500"></span>
                            @_counts.Critical
                        </span>
                        <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="size-1.5 rounded-full bg-amber-500"></span>
                            @_counts.High
                        </span>
                        <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <span class="size-1.5 rounded-full bg-blue-500"></span>
                            @_counts.Medium
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Textarea + actions *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_comment" Placeholder="Write your comment..." Class="min-h-[100px]" aria-label="Write your comment..." />
            <div class="mt-2 flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="shield-alert" Size="12" Class="size-3" />
                    <span>Scanning for sensitive data</span>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" Disabled="@_hasCritical">
                    @(_hasCritical ? "Compliance issues detected" : "Post comment")
                </ButtonCn>
            </div>
        </div>

        @* Issues list *@
        @if (_issues.Count > 0)
        {
            @* Warning banner *@
            <div class="border-b bg-red-500/5 px-4 py-2.5">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5 text-red-600 dark:text-red-400" />
                    <span class="text-xs font-medium text-red-600 dark:text-red-400">
                        @_issues.Count compliance @(_issues.Count == 1 ? "issue" : "issues") detected
                    </span>
                </div>
            </div>

            @* Individual issues *@
            <div>
                @for (var i = 0; i < _issues.Count; i++)
                {
                    var issue = _issues[i];
                    var isLast = i == _issues.Count - 1;
                    <div class="@(isLast ? "p-4" : "border-b p-4")">
                        <div class="flex items-start gap-3">
                            <span class="@($"mt-0.5 size-2 shrink-0 rounded-full {SeverityDot(issue.Severity)}")"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">
                                        @EntityTypeLabel(issue.Type) detected
                                    </span>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="@($"text-[10px] font-normal {SeverityColor(issue.Severity)}")">
                                        @issue.Severity
                                    </BadgeCn>
                                </div>
                                <p class="mt-0.5 text-xs text-muted-foreground">@issue.Rule</p>
                                <div class="mt-2.5 rounded-md bg-muted/50 p-3">
                                    <div class="mb-1.5 flex items-center justify-between">
                                        <span class="text-xs font-medium text-muted-foreground">
                                            Detected value
                                        </span>
                                    </div>
                                    <p class="font-mono text-sm text-red-600 dark:text-red-400">
                                        @issue.Text
                                    </p>
                                    <div class="mt-2 border-t pt-2">
                                        <span class="text-xs font-medium text-muted-foreground">
                                            Suggested redaction
                                        </span>
                                        <p class="mt-1 font-mono text-sm">@issue.Redacted</p>
                                    </div>
                                </div>
                                <div class="mt-2.5">
                                    @{ var capturedIssue = issue; }
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="@(() => ApplyRedaction(capturedIssue))">
                                        Apply redaction
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @* Apply all footer *@
            <div class="border-t px-4 py-3">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full gap-1 text-xs" OnClick="ApplyAllRedactions">
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    Apply all redactions (@_issues.Count)
                </ButtonCn>
            </div>
        }

        @* All clear panel *@
        @if (_issues.Count == 0)
        {
            <div class="bg-emerald-500/5 px-4 py-4">
                <div class="flex items-center gap-2 text-xs text-emerald-600 dark:text-emerald-400">
                    <LucideIconCn Name="shield-check" Size="14" Class="size-3.5" />
                    <span>No compliance issues detected</span>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record ComplianceIssue(
        string Id,
        string Type,
        string Severity,
        string Text,
        string Redacted,
        string Rule,
        int Start,
        int End
    );

    private record IssueCounts(int Critical, int High, int Medium);

    private string _comment = "Please contact me at john.doe@@acme.com or call 555-123-4567. My SSN is 123-45-6789 for verification.";

    private List<ComplianceIssue> _issues =
    [
        new("1", "email",  "medium",   "john.doe@acme.com", "[EMAIL REDACTED]",  "GDPR Article 6 - Personal Data", 21, 39),
        new("2", "phone",  "medium",   "555-123-4567",       "[PHONE REDACTED]",  "PII Protection Policy",          48, 60),
        new("3", "ssn",    "critical", "123-45-6789",        "***-**-****",        "HIPAA Privacy Rule - PHI",       73, 84),
    ];

    private bool _hasCritical => _issues.Any(i => i.Severity == "critical");

    private IssueCounts _counts => new(
        _issues.Count(i => i.Severity == "critical"),
        _issues.Count(i => i.Severity == "high"),
        _issues.Count(i => i.Severity == "medium")
    );

    private void ApplyRedaction(ComplianceIssue issue)
    {
        var newText = _comment[..issue.Start] + issue.Redacted + _comment[issue.End..];
        _comment = newText;
        _issues = _issues.Where(i => i.Id != issue.Id).ToList();
    }

    private void ApplyAllRedactions()
    {
        var sorted = _issues.OrderByDescending(i => i.Start).ToList();
        var text = _comment;
        foreach (var issue in sorted)
        {
            text = text[..issue.Start] + issue.Redacted + text[issue.End..];
        }
        _comment = text;
        _issues = [];
    }

    private static string SeverityColor(string severity) => severity switch
    {
        "critical" => "text-red-600 dark:text-red-400",
        "high"     => "text-amber-600 dark:text-amber-400",
        "medium"   => "text-blue-600 dark:text-blue-400",
        _          => ""
    };

    private static string SeverityDot(string severity) => severity switch
    {
        "critical" => "bg-red-500",
        "high"     => "bg-amber-500",
        "medium"   => "bg-blue-500",
        _          => ""
    };

    private static string EntityTypeLabel(string type) => type switch
    {
        "email"       => "Email Address",
        "ssn"         => "Social Security Number",
        "credit-card" => "Credit Card",
        "phone"       => "Phone Number",
        "address"     => "Physical Address",
        _             => type
    };
}
