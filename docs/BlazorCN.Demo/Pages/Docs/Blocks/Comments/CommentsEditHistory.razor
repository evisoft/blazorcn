@* ============================================================
   Block: comments-edit-history
   Title: CommentsEditHistory
   Description: Full revision history for comments in React and Next.js with diff view, version comparison, and rollback capability built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-edit-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Edit History</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_revisions.Length versions · Latest by @_revisions[0].EditedBy
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs"
                          @onclick="@(() => _compareMode = !_compareMode)">
                    <LucideIconCn Name="history" Size="12" Class="size-3" />
                    @(_compareMode ? "Hide" : "Compare")
                </ButtonCn>
            </div>
        </div>

        @* Current version banner *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Current Version (v@(_revisions[0].Version))</span>
            </div>
            <p class="mt-2 text-sm leading-relaxed">@_revisions[0].Content</p>
        </div>

        @* Revision list *@
        <div>
            @for (int i = 0; i < _revisions.Length; i++)
            {
                var rev = _revisions[i];
                var idx = i;
                var isExpanded = _expandedVersion == rev.Version;
                var isLast = idx == _revisions.Length - 1;
                var isCurrent = idx == 0;
                var initials = GetInitials(rev.EditedBy);
                var badgeCss = GetChangeTypeColor(rev.ChangeType);
                var badgeLabel = rev.ChangeType switch
                {
                    "created" => "Created",
                    "edited" => "Major edit",
                    "minor-edit" => "Minor edit",
                    _ => rev.ChangeType
                };
                var chevronCss = isExpanded
                    ? "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90"
                    : "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200";
                var rowCss = isLast ? "" : "border-b";

                <div class="@rowCss">
                    <button type="button"
                            @onclick="@(() => ToggleVersion(rev.Version))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">Version @rev.Version</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"text-xs font-normal {badgeCss}")">
                                    @badgeLabel
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @rev.EditedBy · @rev.EditedAt
                            </p>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronCss" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-16">
                            <SeparatorCn Class="mb-3" />
                            <p class="text-sm leading-relaxed text-muted-foreground">@rev.Content</p>
                            @if (_compareMode && idx > 0)
                            {
                                var prevRev = _revisions[idx + 1];
                                <div class="mt-3 rounded-md bg-muted/50 p-3">
                                    <span class="text-xs font-medium text-muted-foreground">
                                        Changes from v@(prevRev.Version)
                                    </span>
                                    <div class="mt-2 space-y-1 text-sm">
                                        <div class="text-red-600 dark:text-red-400">
                                            <span class="line-through">
                                                The new authentication flow is working great!
                                            </span>
                                        </div>
                                        <div class="text-emerald-600 dark:text-emerald-400">
                                            <span>
                                                The new authentication flow is working great. Minor issue with the
                                                password reset link.
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            }
                            @if (!isCurrent)
                            {
                                <div class="mt-3 flex gap-2">
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                        <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                                        Restore this version
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Revision(string Id, int Version, string Content, string EditedBy, string EditedAt, string ChangeType);

    private static readonly Revision[] _revisions =
    [
        new("3", 3, "The new authentication flow is working well after the recent updates. Minor issue with the password reset link has been resolved.", "Sarah Chen", "Just now",    "edited"),
        new("2", 2, "The new authentication flow is working great. Minor issue with the password reset link.",                                          "Sarah Chen", "5 min ago",   "minor-edit"),
        new("1", 1, "The new authentication flow is working great!",                                                                                   "Sarah Chen", "1 hour ago",  "created"),
    ];

    private int? _expandedVersion = 3;
    private bool _compareMode = false;

    private void ToggleVersion(int version)
    {
        _expandedVersion = _expandedVersion == version ? null : version;
    }

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();

    private static string GetChangeTypeColor(string changeType) => changeType switch
    {
        "created"    => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "edited"     => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        "minor-edit" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        _            => "",
    };
}
