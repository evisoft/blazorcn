@* ============================================================
   Block: comments-ai-topic-extraction
   Title: CommentsAiTopicExtraction
   Description: An AI-powered topic extraction comment system for React and Next.js with automatic tag generation, topic clustering, keyword badges, and filter-by-topic functionality built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-ai-topic-extraction.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Comments</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_filteredComments.Length of @_comments.Length @(_comments.Length == 1 ? "comment" : "comments")
            </p>
        </div>

        @* Topics filter panel *@
        <div class="border-b bg-muted/30 p-4">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Topics</span>
                @if (_selectedTopic != null)
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" OnClick="@(() => _selectedTopic = null)">
                        Clear filter
                    </ButtonCn>
                }
            </div>
            <div class="flex flex-wrap gap-2">
                @foreach (var topic in _allTopics)
                {
                    var t = topic;
                    <button type="button"
                            @onclick="@(() => _selectedTopic = (t == _selectedTopic ? null : t))"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-all", _selectedTopic == t ? "bg-blue-500/10 text-blue-600 ring-1 ring-blue-500/50 dark:text-blue-400" : "bg-muted text-muted-foreground hover:bg-muted/80")">
                        @topic <span class="ml-1 text-[10px] opacity-60">@_topicCounts[topic]</span>
                    </button>
                }
            </div>
        </div>

        @* New comment form *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_newComment" Placeholder="Add a comment..." Class="min-h-[100px]" />
            <div class="mt-2 flex justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var comment in _filteredComments)
            {
                var initials = GetInitials(comment.Author);
                <div class="p-4">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed">@comment.Content</p>
                            <div class="mt-2 flex flex-wrap gap-1.5">
                                @foreach (var topic in comment.Topics)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@topic</BadgeCn>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (_filteredComments.Length == 0)
            {
                <div class="px-4 py-8 text-center text-sm text-muted-foreground">
                    No comments found with this topic
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Comment(string Id, string Author, string Content, string Timestamp, string[] Topics);

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen",   "Having issues with authentication flow. The OAuth callback returns a 404 error after successful login.",               "2 hours ago", ["authentication", "oauth", "errors", "callbacks"]),
        new("2", "Alex Morgan",  "The new dashboard UI looks great! Performance has improved significantly with the latest update.",                     "2 hours ago", ["dashboard", "ui", "performance"]),
        new("3", "Maya Patel",   "Documentation for the authentication API needs more examples. Especially around refresh token handling.",              "1 hour ago",  ["documentation", "authentication", "api", "tokens"]),
        new("4", "James Wilson", "Mobile app crashes when uploading large files. This affects both iOS and Android versions.",                           "1 hour ago",  ["mobile", "crashes", "file-upload", "bugs"]),
    ];

    private static readonly string[] _allTopics =
        _comments.SelectMany(c => c.Topics).Distinct().OrderBy(t => t).ToArray();

    private static readonly Dictionary<string, int> _topicCounts =
        _allTopics.ToDictionary(t => t, t => _comments.Count(c => c.Topics.Contains(t)));

    private string? _selectedTopic;
    private string _newComment = "";

    private Comment[] _filteredComments =>
        _selectedTopic == null
            ? _comments
            : _comments.Where(c => c.Topics.Contains(_selectedTopic)).ToArray();

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => char.ToUpperInvariant(n[0])));
}
