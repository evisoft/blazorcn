@* ============================================================
   Block: comments-influence-score
   Title: CommentsInfluenceScore
   Description: A user influence ranking system for React and Next.js with reputation scores, engagement metrics, quality indicators, and leaderboard rankings built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-influence-score.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Influence Leaderboard</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Top contributors by reputation</p>
        </div>

        @* Summary stats *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-4 gap-4 text-center">
                <div>
                    <LucideIconCn Name="message-circle" Size="16" Class="mx-auto mb-1 size-4 text-muted-foreground/60" />
                    <div class="text-lg font-semibold tabular-nums">@_totalComments</div>
                    <span class="text-xs text-muted-foreground">Comments</span>
                </div>
                <div>
                    <LucideIconCn Name="thumbs-up" Size="16" Class="mx-auto mb-1 size-4 text-muted-foreground/60" />
                    <div class="text-lg font-semibold tabular-nums">@_totalUpvotes</div>
                    <span class="text-xs text-muted-foreground">Upvotes</span>
                </div>
                <div>
                    <LucideIconCn Name="award" Size="16" Class="mx-auto mb-1 size-4 text-muted-foreground/60" />
                    <div class="text-lg font-semibold tabular-nums">@_totalAccepted</div>
                    <span class="text-xs text-muted-foreground">Accepted</span>
                </div>
                <div>
                    <LucideIconCn Name="trending-up" Size="16" Class="mx-auto mb-1 size-4 text-muted-foreground/60" />
                    <div class="text-lg font-semibold tabular-nums">@_users.Length</div>
                    <span class="text-xs text-muted-foreground">Active users</span>
                </div>
            </div>
        </div>

        @* User list *@
        <div>
            @for (int i = 0; i < _users.Length; i++)
            {
                var user = _users[i];
                var isLast = i == _users.Length - 1;
                var initials = GetInitials(user.Name);
                <div class="@Cn.Merge("", !isLast ? "border-b" : "")">
                    <div class="px-4 py-3">
                        <div class="flex items-center gap-3">
                            <div class="flex w-8 shrink-0 items-center justify-center">
                                <span class="text-sm font-semibold tabular-nums text-muted-foreground">#@user.Rank</span>
                            </div>
                            <AvatarCn Class="size-10 shrink-0">
                                <AvatarImageCn Src="@user.Avatar" Alt="@user.Name" />
                                <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@user.Name</span>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("text-xs font-normal", TierColor(user.Tier))">
                                        @TierLabel(user.Tier)
                                    </BadgeCn>
                                </div>
                                <div class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                    <span>@user.Comments comments</span>
                                    <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                                    <span>@user.Upvotes upvotes</span>
                                    <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                                    <span>@user.AcceptedAnswers accepted</span>
                                </div>
                            </div>
                            <div class="flex shrink-0 items-center gap-3">
                                @if (user.RankChange != 0)
                                {
                                    <div class="flex items-center gap-1">
                                        @if (user.RankChange > 0)
                                        {
                                            <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                                            <span class="text-xs text-emerald-600 dark:text-emerald-400">+@user.RankChange</span>
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="trending-up" Size="12" Class="size-3 rotate-180 text-red-500" />
                                            <span class="text-xs text-red-600 dark:text-red-400">@user.RankChange</span>
                                        }
                                    </div>
                                }
                                <div class="text-right">
                                    <div class="text-lg font-semibold tabular-nums">@user.Score</div>
                                    <span class="text-[10px] text-muted-foreground">score</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>Top 5 users</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>Updated 1 hour ago</span>
            </div>
        </div>

    </div>
</section>

@code {
    private enum Tier { Leader, Expert, Contributor, Beginner }

    private record User(string Id, string Name, string Avatar, int Score, Tier Tier, int Rank, int RankChange, int Comments, int Upvotes, int AcceptedAnswers);

    private static readonly User[] _users =
    [
        new("1", "Sarah Chen",   "", 98, Tier.Leader,      1,  0, 342, 1247, 45),
        new("2", "Alex Morgan",  "", 87, Tier.Expert,      2,  1, 289,  892, 32),
        new("3", "James Wilson", "", 76, Tier.Expert,      3, -1, 256,  678, 28),
        new("4", "Maya Patel",   "", 64, Tier.Expert,      4,  2, 198,  534, 19),
        new("5", "Chris Taylor", "", 52, Tier.Contributor, 5,  0, 145,  412, 14),
    ];

    private static readonly int _totalComments  = _users.Sum(u => u.Comments);
    private static readonly int _totalUpvotes   = _users.Sum(u => u.Upvotes);
    private static readonly int _totalAccepted  = _users.Sum(u => u.AcceptedAnswers);

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Select(p => p[0])).ToUpper();
    }

    private static string TierColor(Tier tier) => tier switch
    {
        Tier.Leader      => "border-amber-500/20 bg-amber-500/10 text-amber-700 dark:text-amber-400",
        Tier.Expert      => "border-blue-500/20 bg-blue-500/10 text-blue-700 dark:text-blue-400",
        Tier.Contributor => "border-emerald-500/20 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        Tier.Beginner    => "border-muted-foreground/20 bg-muted/50 text-muted-foreground",
        _                => ""
    };

    private static string TierLabel(Tier tier) => tier switch
    {
        Tier.Leader      => "Leader",
        Tier.Expert      => "Expert",
        Tier.Contributor => "Contributor",
        Tier.Beginner    => "Beginner",
        _                => ""
    };
}
