@* ============================================================
   Block: comments-alpha-index
   Title: CommentsAlphaIndex
   Description: An alphabetical comment navigation for React and Next.js with A-Z jump links, author grouping, and quick scroll built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-alpha-index.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Alphabetical Index</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length comments from @_groupedComments.Count letters
            </p>
        </div>

        @* Alphabet jump nav *@
        <div class="border-b bg-muted/20 p-4">
            <div class="flex flex-wrap gap-1">
                @foreach (var letter in _alphabet)
                {
                    var hasComments = _groupedComments.ContainsKey(letter);
                    var isActive = _activeLetter == letter;
                    var btnClass = @Cn.Merge(
                        "flex size-8 items-center justify-center rounded-md text-xs font-medium transition-all",
                        hasComments
                            ? (isActive
                                ? "bg-foreground text-background"
                                : "bg-background hover:bg-muted/50")
                            : "cursor-not-allowed text-muted-foreground/30"
                    );
                    <button type="button"
                            class="@btnClass"
                            disabled="@(!hasComments)"
                            @onclick="@(() => ScrollToLetter(letter))">
                        @letter
                    </button>
                }
            </div>
        </div>

        @* Comment groups *@
        <div class="max-h-[500px] overflow-y-auto">
            @foreach (var grp in _groupedComments)
            {
                var letter = grp.Key;
                var letterComments = grp.Value;
                <div id="@($"letter-{letter}")" class="border-b last:border-b-0">
                    <div class="sticky top-0 z-10 border-b bg-muted/30 px-4 py-2">
                        <div class="flex items-center gap-2">
                            <span class="text-lg font-semibold">@letter</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                @letterComments.Count
                            </BadgeCn>
                        </div>
                    </div>
                    <div class="divide-y">
                        @foreach (var comment in letterComments)
                        {
                            <div class="px-4 py-3">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@comment.Author</span>
                                    <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                                </div>
                                <p class="mt-1 text-sm text-muted-foreground">@comment.Content</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Footer hint *@
        <div class="border-t px-4 py-2.5 text-xs text-muted-foreground">
            Click a letter to jump to that section
        </div>

    </div>
</section>

@code {
    private record Comment(string Id, string Author, string Content, string Timestamp);

    private static readonly Comment[] _comments =
    [
        new("1",  "Alex Morgan",    "TypeScript support is excellent",   "1 hour ago"),
        new("2",  "Alice Johnson",  "Great documentation",                "2 hours ago"),
        new("3",  "Chris Taylor",   "Found a useful pattern",             "3 hours ago"),
        new("4",  "Clara Davis",    "Dark mode works well",               "4 hours ago"),
        new("5",  "James Wilson",   "Authentication is smooth",           "5 hours ago"),
        new("6",  "Jordan Lee",     "Performance is great",               "6 hours ago"),
        new("7",  "Maya Patel",     "UI components are polished",         "7 hours ago"),
        new("8",  "Michael Brown",  "Accessibility features work",        "8 hours ago"),
        new("9",  "Sarah Chen",     "Component library is excellent",     "9 hours ago"),
        new("10", "Sam Wilson",     "API design is intuitive",            "10 hours ago"),
    ];

    private static readonly string[] _alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ".ToCharArray()
        .Select(c => c.ToString()).ToArray();

    private Dictionary<string, List<Comment>> _groupedComments = BuildGroups();

    private static Dictionary<string, List<Comment>> BuildGroups()
    {
        var result = new Dictionary<string, List<Comment>>();
        foreach (var letter in "ABCDEFGHIJKLMNOPQRSTUVWXYZ".ToCharArray().Select(c => c.ToString()))
        {
            var matches = _comments.Where(c => c.Author[0].ToString().ToUpper() == letter).ToList();
            if (matches.Count > 0)
                result[letter] = matches;
        }
        return result;
    }

    private string _activeLetter = "A";

    private void ScrollToLetter(string letter)
    {
        if (_groupedComments.ContainsKey(letter))
            _activeLetter = letter;
    }
}
