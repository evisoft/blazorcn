    private void HandleBulkSpam()
    {
        _items = _items.Select(c => _selected.Contains(c.Id) ? c with { Status = ""spam"" } : c).ToList();
        _selected = [];
    }

    private void HandleBulkDelete()
    {
        _items = _items.Where(c => !_selected.Contains(c.Id)).ToList();
