                            </div>
                        </div>
                    }

                    @if (!collapsed && comment.Replies.Length > 0)
                    {
                        <div class=""mt-3"">
                            @foreach (var reply in comment.Replies)
                            {
                                var r = reply;
                                @RenderComment(r, depth + 1)
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    };
}";

