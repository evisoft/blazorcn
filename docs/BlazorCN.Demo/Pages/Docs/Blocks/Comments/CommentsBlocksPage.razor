    private record GraphNode(string Id, string Name, string Avatar, int Comments, int Cluster, int X, int Y);
    private record GraphEdge(string From, string To, int Weight);

    private static readonly GraphNode[] _nodes =
    [
        new(""1"", ""Sarah Chen"",   """", 45, 1, 150, 100),
        new(""2"", ""Alex Morgan"",  """", 38, 1, 220, 120),
        new(""3"", ""James Wilson"", """", 32, 2, 100, 180),
        new(""4"", ""Maya Patel"",   """", 28, 1, 180, 160),
        new(""5"", ""Chris Taylor"", """", 24, 2, 140, 220),
        new(""6"", ""Emma Davis"",   """", 19, 2, 200, 200),
    ];

    private static readonly GraphEdge[] _edges =
    [
        new(""1"", ""2"", 12),
        new(""1"", ""4"",  8),
        new(""2"", ""4"", 10),
        new(""3"", ""5"", 15),
        new(""3"", ""6"",  9),
        new(""5"", ""6"", 11),
        new(""1"", ""3"",  5),
        new(""4"", ""6"",  6),
    ];

    private static readonly int _totalInteractions = _edges.Sum(e => e.Weight);
    private static readonly int _avgInteractions = (int)Math.Round((double)_totalInteractions / _edges.Length);

    private static readonly int _minComments = _nodes.Min(n => n.Comments);
    private static readonly int _maxComments = _nodes.Max(n => n.Comments);
    private static readonly int _minWeight   = _edges.Min(e => e.Weight);
    private static readonly int _maxWeight   = _edges.Max(e => e.Weight);

    private static double GetNodeSize(int comments)
    {
        var normalized = (_maxComments == _minComments) ? 0.0 : (double)(comments - _minComments) / (_maxComments - _minComments);
        return 24 + normalized * 16;
    }

    private static double GetEdgeWidth(int weight)
    {
        var normalized = (_maxWeight == _minWeight) ? 0.0 : (double)(weight - _minWeight) / (_maxWeight - _minWeight);
        return 1 + normalized * 2;
    }

    private static string GetInitials(string name)
        => string.Concat(name.Split(' ').Select(part => part.Length > 0 ? char.ToUpper(part[0]).ToString() : """"));

    private static string GetClusterFill(int cluster) => cluster == 1
        ? ""border-blue-500/30 bg-blue-500/10""
        : ""border-emerald-500/30 bg-emerald-500/10"";

    private static string GetClusterBadgeClass(int cluster) => cluster == 1
        ? ""border-blue-500/30 bg-blue-500/10""
        : ""border-emerald-500/30 bg-emerald-500/10"";
}
";

