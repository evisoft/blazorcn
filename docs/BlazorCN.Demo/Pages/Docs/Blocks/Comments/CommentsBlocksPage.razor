    private static string SeverityColor(string severity) => severity switch
    {
        ""error""      => ""text-red-600 dark:text-red-400"",
        ""warning""    => ""text-amber-600 dark:text-amber-400"",
        ""suggestion"" => ""text-blue-600 dark:text-blue-400"",
        _            => ""text-foreground"",
    };

    private void ApplySuggestion(string id)
    {
        var err = _errors.FirstOrDefault(e => e.Id == id);
        if (err is null) return;
        if (_comment.Length >= err.End)
            _comment = _comment[..err.Start] + err.Suggestion + _comment[err.End..];
        _errors = _errors.Where(e => e.Id != id).ToList();
        _applied = id;
        // Note: timeout reset not available in Blazor without a timer; applied badge stays until next action
    }

    private void IgnoreError(string id)
    {
        _errors = _errors.Where(e => e.Id != id).ToList();
    }
}";

