    private List<UserData> FilteredUsers()
    {
        return _teamMembers
            .Where(u => u.Name.ToLower().Contains(_mentionQuery) || u.Username.ToLower().Contains(_mentionQuery))
            .ToList();
    }

    private void SelectMention(UserData user)
    {
        var lastAtIndex = _newComment.LastIndexOf('@');
        var beforeAt = _newComment.Substring(0, lastAtIndex);
        var afterQuery = _newComment.Substring(lastAtIndex + _mentionQuery.Length + 1);
        _newComment = $""{beforeAt}@{user.Username} {afterQuery}"";
        _showMentions = false;
        _mentionQuery = """";
