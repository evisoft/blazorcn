@code {
    private const string CommentsABTestingCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">

        @* Header *@
        <div class=""border-b px-4 py-3"">
            <div class=""flex items-center justify-between"">
                <div>
                    <h2 class=""text-sm font-medium"">@_experiment.Name</h2>
                    <p class=""mt-0.5 text-xs text-muted-foreground"">Started @_experiment.StartDate</p>
                </div>
                <BadgeCn Variant=""BadgeVariant.Outline"" Class=""border-emerald-500/20 bg-emerald-500/10 text-xs font-normal text-emerald-700 dark:text-emerald-400"">
                    Running
                </BadgeCn>
            </div>
        </div>

        @* Stats row *@
        <div class=""grid grid-cols-3 border-b"">
            <div class=""border-r px-4 py-3"">
                <div class=""mb-1 flex items-center gap-1.5"">
                    <LucideIconCn Name=""users"" Size=""14"" Class=""size-3.5 text-muted-foreground/60"" />
                    <span class=""text-xs text-muted-foreground"">Total users</span>
                </div>
