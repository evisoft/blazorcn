    private record ToneOption(string Value, string Label, string Description);

    private static readonly ToneOption[] _toneOptions =
    [
        new(""professional"", ""Professional"", ""Polished and business-appropriate""),
        new(""friendly"",     ""Friendly"",     ""Warm and conversational""),
        new(""concise"",      ""Concise"",      ""Brief and to the point""),
        new(""formal"",       ""Formal"",       ""Respectful and traditional""),
    ];

    private static readonly Dictionary<string, string> _toneRewrites = new()
    {
        [""professional""] = ""I appreciate your feedback. The implementation approach you've outlined demonstrates strong technical understanding. I'd like to explore the performance implications further before proceeding."",
        [""friendly""]     = ""Thanks for sharing your thoughts! I really like your approach and it shows you've put a lot of thought into this. Let's chat more about how it might affect performance before we move forward."",
        [""concise""]      = ""Good feedback. Strong technical approach. Need to assess performance impact before implementation."",
        [""formal""]       = ""I would like to express my appreciation for your constructive feedback. The implementation methodology you have presented exhibits considerable technical merit. I propose we conduct a thorough performance analysis prior to proceeding with this approach."",
    };

    private string _comment      = ""Thanks for the feedback! Your implementation looks good but we need to check performance first."";
    private string? _selectedTone = null;
    private string? _preview      = null;
    private bool    _generating   = false;

    private readonly string _sentiment   = ""neutral"";
    private readonly string _currentTone = ""friendly"";

    private async Task GenerateTone(string tone)
    {
        _selectedTone = tone;
        _generating   = true;
        StateHasChanged();
        await Task.Delay(800);
        _preview    = _toneRewrites[tone];
        _generating = false;
    }

    private void ApplyRewrite()
    {
        if (_preview != null)
        {
            _comment      = _preview;
            _preview      = null;
            _selectedTone = null;
        }
    }

    private void CancelPreview()
    {
        _preview      = null;
        _selectedTone = null;
    }

    private string GetSelectedToneLabel()
    {
        if (_selectedTone == null) return """";
        var opt = Array.Find(_toneOptions, t => t.Value == _selectedTone);
        return opt?.Label ?? """";
    }
}";

