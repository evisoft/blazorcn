@code {
    private record TemplateField(string Id, string Label, string FieldType, bool Required, string Placeholder);
    private record Template(string Id, string Name, string Description, TemplateField[] Fields);

    private static readonly Template[] _templates =
    [
        new(""bug-report"", ""Bug Report"", ""Report a software defect"",
        [
            new(""title"",       ""Bug title"",           ""text"",     true,  ""Concise description of the bug""),
            new(""steps"",       ""Steps to reproduce"",  ""textarea"", true,  ""1. Go to...\n2. Click on...\n3. See error""),
            new(""expected"",    ""Expected behavior"",   ""textarea"", true,  ""What should happen""),
            new(""actual"",      ""Actual behavior"",     ""textarea"", true,  ""What actually happens""),
            new(""environment"", ""Environment"",         ""text"",     false, ""Browser, OS, version""),
        ]),
        new(""feature-request"", ""Feature Request"", ""Suggest a new feature"",
        [
            new(""title"",        ""Feature title"",         ""text"",     true,  ""Brief feature description""),
            new(""problem"",      ""Problem statement"",     ""textarea"", true,  ""What problem does this solve?""),
            new(""solution"",     ""Proposed solution"",     ""textarea"", true,  ""How should this work?""),
            new(""alternatives"", ""Alternatives considered"",""textarea"", false, ""Other solutions you've thought about""),
        ]),
        new(""support-ticket"", ""Support Ticket"", ""Get help with an issue"",
        [
            new(""subject"",     ""Subject"",        ""text"",     true,  ""Brief description of your issue""),
            new(""description"", ""Description"",    ""textarea"", true,  ""Detailed explanation of your issue""),
            new(""account"",     ""Account/User ID"",""text"",     false, ""Your account identifier""),
        ]),
    ];

    private string? _selectedTemplate = null;
    private readonly Dictionary<string, string> _formData = new();
    private bool _submitted = false;

    private Template? _currentTemplate => _selectedTemplate == null
        ? null
        : Array.Find(_templates, t => t.Id == _selectedTemplate);

    private void SelectTemplate(string id)
    {
        _selectedTemplate = id;
        _formData.Clear();
    }

    private string GetFieldValue(string fieldId) =>
        _formData.TryGetValue(fieldId, out var v) ? v : """";

    private void SetFieldValue(string fieldId, string value)
    {
        _formData[fieldId] = value;
    }

    private bool IsFormValid()
    {
        if (_currentTemplate == null) return false;
        foreach (var f in _currentTemplate.Fields)
        {
            if (f.Required && string.IsNullOrWhiteSpace(GetFieldValue(f.Id)))
                return false;
        }
        return true;
    }

    private async Task HandleSubmit()
    {
        _submitted = true;
        await Task.Delay(2000);
        _submitted = false;
        _selectedTemplate = null;
        _formData.Clear();
    }

    private void CancelForm()
    {
        _selectedTemplate = null;
        _formData.Clear();
    }
}";

