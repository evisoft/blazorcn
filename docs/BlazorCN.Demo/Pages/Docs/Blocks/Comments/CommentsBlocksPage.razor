    private void HandleInput(ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? """";
        _newComment = text;

        var lastAtIndex = text.LastIndexOf('@');
        if (lastAtIndex != -1)
        {
            var textAfterAt = text.Substring(lastAtIndex + 1);
            var hasSpace = textAfterAt.Contains(' ') || textAfterAt.Contains('\n');

