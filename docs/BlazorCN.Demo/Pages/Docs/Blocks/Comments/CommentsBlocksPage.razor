        new(""3"", ""suggestion"", ""style"",     ""Consider more concise phrasing"", ""requires"",       110, 124),
    ];

    private string _comment = ""This is a great implemetation but the component need to have better documentation that would be helpful for developers."";
    private List<GrammarError> _errors = [.. _mockErrors];
    private string? _applied = null;

    private ErrorCounts _counts => new(
        _errors.Count(e => e.Severity == ""error""),
        _errors.Count(e => e.Severity == ""warning""),
