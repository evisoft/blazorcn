                                <TextareaCn Value=""@currentText"" ValueChanged=""@((string v) => SetReplyText(cId, v))"" Placeholder=""Write a reply..."" Class=""min-h-[80px] text-sm"" aria-label=""Write a reply..."" />
                            </div>
                            <div class=""mt-2 flex gap-2"">
                                <ButtonCn Size=""ButtonSize.Sm"" Class=""h-7 text-xs"">
                                    Post reply
                                </ButtonCn>
