                        @if (comment.Replies.Length > 0)
                        {
                            var cId = comment.Id;
                            var isCollapsed = collapsed;
                            var replyCount = comment.Replies.Length;
                            <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm"" Class=""h-7 gap-1 px-2 text-xs"" OnClick=""@(() => ToggleCollapsed(cId))"">
                                <LucideIconCn Name=""message-circle"" Size=""12"" Class=""size-3"" />
                                @(isCollapsed ? ""Show"" : ""Hide"") @replyCount @(replyCount == 1 ? ""reply"" : ""replies"")
                            </ButtonCn>
                        }
                    </div>

                    @if (showReply)
                    {
                        var cId = comment.Id;
