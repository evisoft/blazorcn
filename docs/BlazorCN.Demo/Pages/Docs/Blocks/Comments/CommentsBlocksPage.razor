                <span class=""size-1 rounded-full bg-muted-foreground/40""></span>
                <span class=""font-mono"">Session: @_sessionId</span>
            </div>
        </div>

        @* Comment list *@
        <div>
            @for (int idx = 0; idx < _comments.Length; idx++)
            {
                var comment = _comments[idx];
                var isLast = idx == _comments.Length - 1;
                var initials = GetInitials(comment.Author);
                var classificationClass = GetClassificationColor(comment.Classification);

                <div class=""@(isLast ? ""p-4"" : ""border-b p-4"")"">
                    <div class=""flex gap-3"">
                        <AvatarCn Class=""size-8 shrink-0"">
                            <AvatarImageCn Src=""@comment.Avatar"" Alt=""@comment.Author"" />
                            <AvatarFallbackCn Class=""text-xs"">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class=""min-w-0 flex-1"">
                            <div class=""flex items-center gap-2"">
                                <span class=""text-sm font-medium"">@comment.Author</span>
                                <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""@Cn.Merge(""text-[10px] font-normal"", classificationClass)"">
                                    @comment.Classification
                                </BadgeCn>
                                <span class=""text-xs text-muted-foreground"">@comment.Timestamp</span>
                            </div>
                            <p class=""mt-1.5 text-sm leading-relaxed"">@comment.Content</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class=""border-t bg-muted/30 px-4 py-2.5"">
            <p class=""text-xs text-muted-foreground"">
                This content is watermarked and monitored. Unauthorized distribution is prohibited and traceable.
            </p>
        </div>

    </div>
</section>

