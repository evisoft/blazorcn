    private record CommentItem(
        string Id,
        string Author,
        string Avatar,
        string Content,
        string Timestamp,
        int ExpiresIn,
        bool ViewOnce,
        bool Viewed
    );

    private List<CommentItem> _comments =
    [
        new(""1"", ""Sarah Chen"", """", ""The API keys for the staging environment are in 1Password. This message will self-destruct in 5 minutes."", ""2 min ago"", 180, false, false),
        new(""2"", ""James Wilson"", """", ""Click to view confidential compensation details. Burns after reading."", ""5 min ago"", 0, true, false),
        new(""3"", ""Maya Patel"", """", ""Quick reminder: standup moved to 2pm today. Auto-deletes in 1 hour."", ""15 min ago"", 2700, false, false),
    ];

    private System.Threading.Timer? _timer;

    protected override void OnInitialized()
    {
        _timer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                _comments = _comments
                    .Select(c => c with { ExpiresIn = c.ExpiresIn > 0 ? c.ExpiresIn - 1 : 0 })
                    .Where(c => c.ExpiresIn > 0 || c.ViewOnce)
                    .ToList();
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }

    private void ViewOnceComment(string id)
    {
        _comments = _comments
            .Select(c => c.Id == id && c.ViewOnce ? c with { Viewed = true, ExpiresIn = 30 } : c)
            .ToList();
    }

    private static string FormatTime(int seconds)
    {
        if (seconds >= 3600)
        {
            var hours = seconds / 3600;
            var mins = (seconds % 3600) / 60;
            return $""{hours}h {mins}m"";
        }
        if (seconds >= 60)
        {
            var mins = seconds / 60;
            var secs = seconds % 60;
            return $""{mins}m {secs}s"";
        }
        return $""{seconds}s"";
    }

    private static int GetProgressValue(CommentItem comment)
    {
        if (comment.ViewOnce && !comment.Viewed) return 100;
        var original = comment.Id == ""1"" ? 300 : comment.Id == ""3"" ? 3600 : 30;
        return (int)((double)comment.ExpiresIn / original * 100);
    }

    private static string GetInitials(string author)
    {
        return string.Concat(author.Split(' ').Select(n => n[0])).ToUpper();
    }
}";

