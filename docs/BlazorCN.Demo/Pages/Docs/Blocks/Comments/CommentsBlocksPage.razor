    private record FilterData(string Id, string Name, string[]? Status, string? Author, int Count);
    private record CommentData(string Id, string Author, string Content, string Status, string Timestamp);

    private List<FilterData> _filters =
    [
        new(""1"", ""Pending Review"", [""pending""], null, 12),
        new(""2"", ""Spam Reports"", [""spam""], null, 3),
        new(""3"", ""My Comments"", null, ""Sarah Chen"", 8),
        new(""4"", ""Approved Today"", [""approved""], null, 24),
        new(""5"", ""Needs Attention"", [""pending"", ""spam""], null, 15),
    ];

    private static readonly CommentData[] _comments =
    [
        new(""1"", ""Sarah Chen"", ""This component is excellent"", ""approved"", ""2 hours ago""),
        new(""2"", ""James Wilson"", ""How do I integrate this?"", ""pending"", ""3 hours ago""),
        new(""3"", ""Spam Bot"", ""Click here for prizes!"", ""spam"", ""5 hours ago""),
        new(""4"", ""Maya Patel"", ""Great documentation"", ""approved"", ""6 hours ago""),
        new(""5"", ""Alex Morgan"", ""Found a bug in the tooltip"", ""pending"", ""7 hours ago""),
    ];

    private string? _activeFilter = null;
    private bool _showNewFilter = false;
    private string _newFilterName = """";

    private void ApplyFilter(string filterId)
    {
        _activeFilter = _activeFilter == filterId ? null : filterId;
    }

    private void DeleteFilter(string filterId)
    {
        _filters = _filters.Where(f => f.Id != filterId).ToList();
        if (_activeFilter == filterId)
            _activeFilter = null;
    }

    private void CreateFilter()
    {
        if (string.IsNullOrWhiteSpace(_newFilterName)) return;
        var newFilter = new FilterData(
            Id: (_filters.Count + 1).ToString(),
            Name: _newFilterName,
            Status: [""pending""],
            Author: null,
            Count: 0
        );
        _filters = [.._filters, newFilter];
        _newFilterName = """";
        _showNewFilter = false;
    }

    private List<CommentData> GetFilteredComments()
    {
        if (_activeFilter == null) return _comments.ToList();
        var filter = _filters.FirstOrDefault(f => f.Id == _activeFilter);
        if (filter == null) return _comments.ToList();

        return _comments.Where(comment =>
        {
            if (filter.Status != null && !filter.Status.Contains(comment.Status)) return false;
            if (filter.Author != null && comment.Author != filter.Author) return false;
            return true;
        }).ToList();
    }
}";

