    private void HandleInput(string value)
    {
        _content = value;

        // Find the last @ before end of the string (simple cursor-agnostic approach)
        var atIndex = value.LastIndexOf('@');
        if (atIndex >= 0)
        {
            var afterAt = value.Substring(atIndex + 1);
            // Only show suggestions if afterAt contains only word characters (no space after @)
            if (afterAt.Length == 0 || System.Text.RegularExpressions.Regex.IsMatch(afterAt, @""^\w*$""))
            {
                _mentionQuery = afterAt;
                _showSuggestions = true;
                _filteredUsers = _teamMembers
                    .Where(u => u.Name.Contains(_mentionQuery, StringComparison.OrdinalIgnoreCase)
                             || u.Username.Contains(_mentionQuery, StringComparison.OrdinalIgnoreCase))
                    .ToArray();
                return;
            }
        }

        _showSuggestions = false;
        _filteredUsers = [];
    }

    private void InsertMention(string username)
    {
        var atIndex = _content.LastIndexOf('@');
        if (atIndex >= 0)
        {
            var beforeAt = _content.Substring(0, atIndex);
            _content = $""{beforeAt}@{username} "";
        }
        else
        {
            _content += $""@{username} "";
        }
        _showSuggestions = false;
        _filteredUsers = [];
    }

