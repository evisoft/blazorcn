@code {
    private record Comment(string Id, string Author, string Content, string Status, string[] Tags);

    private record SearchHelp(string Operator, string Example, string Description);

    private static readonly Comment[] _comments =
    [
        new(""1"", ""Sarah Chen"",   ""This React component library is excellent for TypeScript projects"", ""approved"", [""react"", ""typescript""]),
        new(""2"", ""James Wilson"", ""How do I integrate the authentication module?"",                      ""pending"",  [""authentication"", ""help""]),
        new(""3"", ""Maya Patel"",   ""The dark mode implementation is flawless"",                          ""approved"", [""design"", ""darkmode""]),
        new(""4"", ""Spam Bot"",     ""Click here for free prizes and rewards!"",                           ""spam"",     []),
        new(""5"", ""Alex Morgan"",  ""TypeScript types are well-documented"",                              ""approved"", [""typescript"", ""documentation""]),
        new(""6"", ""Chris Taylor"", ""Found a bug in the authentication flow"",                            ""pending"",  [""bug"", ""authentication""]),
    ];

    private static readonly SearchHelp[] _searchHelp =
    [
        new(""author:"",   ""author:Sarah"",  ""Find by author name""),
        new(""status:"",   ""status:pending"",""Filter by status""),
        new(""tag:"",      ""tag:react"",     ""Filter by tag""),
        new(""\""phrase\"""",""\""dark mode\"""", ""Exact phrase match""),
    ];

    private string _query = """";

    private bool _hasQuery => _query.Trim().Length > 0;

    private List<Comment> _filteredComments
    {
        get
        {
            if (!_hasQuery) return _comments.ToList();

            var q = _query;
            string? authorFilter = null;
            string? statusFilter = null;
            string? tagFilter = null;
            string? textFilter = null;

            var remaining = q;

            var authorIdx = remaining.IndexOf(""author:"", StringComparison.OrdinalIgnoreCase);
            if (authorIdx >= 0)
            {
                var start = authorIdx + ""author:"".Length;
                var end = remaining.IndexOf(' ', start);
                authorFilter = end < 0 ? remaining[start..] : remaining[start..end];
                remaining = (remaining[..authorIdx] + (end < 0 ? """" : remaining[end..])).Trim();
            }

            var statusIdx = remaining.IndexOf(""status:"", StringComparison.OrdinalIgnoreCase);
            if (statusIdx >= 0)
            {
                var start = statusIdx + ""status:"".Length;
                var end = remaining.IndexOf(' ', start);
                statusFilter = end < 0 ? remaining[start..] : remaining[start..end];
                remaining = (remaining[..statusIdx] + (end < 0 ? """" : remaining[end..])).Trim();
            }

            var tagIdx = remaining.IndexOf(""tag:"", StringComparison.OrdinalIgnoreCase);
            if (tagIdx >= 0)
            {
                var start = tagIdx + ""tag:"".Length;
                var end = remaining.IndexOf(' ', start);
                tagFilter = end < 0 ? remaining[start..] : remaining[start..end];
                remaining = (remaining[..tagIdx] + (end < 0 ? """" : remaining[end..])).Trim();
            }

            if (!string.IsNullOrWhiteSpace(remaining))
                textFilter = remaining.Trim().ToLowerInvariant();

            return _comments.Where(c =>
            {
                if (authorFilter != null && !c.Author.Contains(authorFilter, StringComparison.OrdinalIgnoreCase))
                    return false;
                if (statusFilter != null && !c.Status.Equals(statusFilter, StringComparison.OrdinalIgnoreCase))
                    return false;
                if (tagFilter != null && !c.Tags.Any(t => t.Contains(tagFilter, StringComparison.OrdinalIgnoreCase)))
                    return false;
                if (textFilter != null && !c.Content.Contains(textFilter, StringComparison.OrdinalIgnoreCase))
                    return false;
                return true;
            }).ToList();
        }
    }
}";

