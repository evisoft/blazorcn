@* ============================================================
   Block: comments-table-view
   Title: CommentsTableView
   Description: A spreadsheet-style comment table for React and Next.js with sortable columns, inline editing, and bulk selection built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-table-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Table View</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_items.Length comments · @_selected.Count selected
            </p>
        </div>

        @* Table *@
        <div class="overflow-x-auto">
            <table class="w-full caption-bottom text-sm">
                <thead class="[&_tr]:border-b">
                    <tr class="border-b transition-colors hover:bg-transparent">
                        <th class="h-10 w-12 px-2 text-left align-middle font-medium text-muted-foreground">
                            <CheckboxCn Checked="@_allSelected" CheckedChanged="@ToggleAll" />
                        </th>
                        <th class="h-10 px-2 text-left align-middle font-medium text-muted-foreground">
                            @RenderSortButton("author", "Author")
                        </th>
                        <th class="h-10 px-2 text-left align-middle font-medium text-muted-foreground">Content</th>
                        <th class="h-10 px-2 text-left align-middle font-medium text-muted-foreground">
                            @RenderSortButton("status", "Status")
                        </th>
                        <th class="h-10 px-2 text-left align-middle font-medium text-muted-foreground">
                            @RenderSortButton("date", "Date")
                        </th>
                    </tr>
                </thead>
                <tbody class="[&_tr:last-child]:border-0">
                    @foreach (var comment in SortedItems())
                    {
                        var item = comment;
                        var isSelected = _selected.Contains(item.Id);
                        <tr class="@Cn.Merge("border-b transition-colors", isSelected ? "bg-muted/50" : "hover:bg-muted/30")">
                            <td class="p-2 align-middle">
                                <CheckboxCn Checked="@isSelected" CheckedChanged="@(() => ToggleItem(item.Id))" />
                            </td>
                            <td class="p-2 align-middle font-medium">@item.Author</td>
                            <td class="max-w-md p-2 align-middle">
                                <p class="truncate text-sm text-muted-foreground">@item.Content</p>
                            </td>
                            <td class="p-2 align-middle">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-[10px] font-normal", GetStatusClass(item.Status))">
                                    @item.Status
                                </BadgeCn>
                            </td>
                            <td class="p-2 align-middle text-xs text-muted-foreground">@item.Timestamp</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                Sorted by @_sortField (@_sortDirection)
            </span>
            @if (_selected.Count > 0)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@ClearSelection">
                    Clear selection
                </ButtonCn>
            }
        </div>

    </div>
</section>

@code {
    private record Comment(string Id, string Author, string Content, string Status, string Timestamp, DateTime Date);

    private static readonly Comment[] _items =
    [
        new("1", "Sarah Chen",  "This component library is excellent",  "approved", "2 hours ago", new DateTime(2026, 4, 4, 10, 0, 0)),
        new("2", "James Wilson","How do I integrate authentication?",    "pending",  "3 hours ago", new DateTime(2026, 4, 4, 9,  0, 0)),
        new("3", "Maya Patel",  "Dark mode works perfectly",            "approved", "5 hours ago", new DateTime(2026, 4, 4, 7,  0, 0)),
        new("4", "Spam Bot",    "Click here for prizes!",               "spam",     "6 hours ago", new DateTime(2026, 4, 4, 6,  0, 0)),
        new("5", "Alex Morgan", "TypeScript support is great",          "approved", "7 hours ago", new DateTime(2026, 4, 4, 5,  0, 0)),
    ];

    private readonly HashSet<string> _selected = new();
    private string _sortField = "date";
    private string _sortDirection = "desc";

    private bool _allSelected => _items.Length > 0 && _selected.Count == _items.Length;

    private IEnumerable<Comment> SortedItems()
    {
        var ordered = _sortDirection == "asc"
            ? _sortField switch
            {
                "author" => _items.OrderBy(c => c.Author),
                "status" => _items.OrderBy(c => c.Status),
                _        => _items.OrderBy(c => c.Date),
            }
            : _sortField switch
            {
                "author" => _items.OrderByDescending(c => c.Author),
                "status" => _items.OrderByDescending(c => c.Status),
                _        => _items.OrderByDescending(c => c.Date),
            };
        return ordered;
    }

    private void ToggleAll()
    {
        if (_allSelected)
            _selected.Clear();
        else
            foreach (var c in _items) _selected.Add(c.Id);
    }

    private void ToggleItem(string id)
    {
        if (!_selected.Remove(id))
            _selected.Add(id);
    }

    private void HandleSort(string field)
    {
        if (_sortField == field)
            _sortDirection = _sortDirection == "asc" ? "desc" : "asc";
        else
        {
            _sortField = field;
            _sortDirection = "asc";
        }
    }

    private void ClearSelection() => _selected.Clear();

    private static string GetStatusClass(string status) => status switch
    {
        "approved" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        "pending"  => "bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "spam"     => "bg-red-500/10 text-red-700 dark:text-red-400",
        _          => "",
    };

    private RenderFragment RenderSortButton(string field, string label) => __builder =>
    {
        var isActive = _sortField == field;
        var fld = field;
        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs font-medium" OnClick="@(() => HandleSort(fld))">
            @label
            @if (isActive)
            {
                if (_sortDirection == "asc")
                {
                    <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                }
                else
                {
                    <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                }
            }
            else
            {
                <LucideIconCn Name="chevrons-up-down" Size="12" Class="size-3 text-muted-foreground/40" />
            }
        </ButtonCn>
    };
}
