@* ============================================================
   Block: comments-code-snippet
   Title: CommentsCodeSnippet
   Description: A code snippet comment system for React and Next.js with syntax highlighting, language selection, line numbers, and copy-to-clipboard functionality built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-code-snippet.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Comments</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length @(_comments.Length == 1 ? "comment" : "comments")
            </p>
        </div>

        @* New comment input *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_newComment" Placeholder="Add a comment..." Class="min-h-[100px]" aria-label="Add a comment..." />

            @if (_showCodeEditor)
            {
                <div class="mt-3 overflow-hidden rounded-md border bg-zinc-950">
                    <div class="flex items-center justify-between border-b border-zinc-800 px-3 py-2">
                        <SelectCn @bind-Value="_language">
                            <SelectTriggerCn aria-label="Code language" Class="h-7 w-[140px] border-zinc-800 bg-zinc-900 text-xs">
                                <SelectValueCn />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                @foreach (var lang in _languages)
                                {
                                    var l = lang;
                                    <SelectItemCn Value="@l.Value" Class="text-xs">@l.Label</SelectItemCn>
                                }
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <TextareaCn @bind-Value="_code" Placeholder="Paste your code here..." Class="min-h-[200px] border-0 bg-zinc-950 font-mono text-sm text-zinc-100 focus-visible:ring-0" aria-label="Paste your code here..." />
                </div>
            }

            <div class="mt-2 flex items-center justify-between">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="@(() => _showCodeEditor = !_showCodeEditor)">
                    <LucideIconCn Name="code" Size="12" Class="size-3" />
                    @(_showCodeEditor ? "Hide" : "Add") code
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var comment in _comments)
            {
                var c = comment;
                var initials = GetInitials(c.Author);
                <div class="p-4">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarImageCn Src="@c.Avatar" Alt="@c.Author" />
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@c.Author</span>
                                <span class="text-xs text-muted-foreground">@c.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed">@c.Content</p>

                            @if (c.Snippet != null)
                            {
                                var snippet = c.Snippet;
                                var cId = c.Id;
                                var langLabel = GetLanguageLabel(snippet.Language);
                                <div class="mt-3 overflow-hidden rounded-md border border-zinc-800 bg-zinc-950">
                                    <div class="flex items-center justify-between border-b border-zinc-800 px-3 py-2">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">@langLabel</BadgeCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs text-zinc-400 hover:text-zinc-100" OnClick="@(() => HandleCopy(cId, snippet.Code))">
                                            @if (_copied == cId)
                                            {
                                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                                                <span>Copied</span>
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                                <span>Copy</span>
                                            }
                                        </ButtonCn>
                                    </div>
                                    <div class="relative overflow-x-auto">
                                        <pre class="p-3"><code class="font-mono text-sm text-zinc-100">@foreach (var lineEntry in GetLines(snippet.Code))
                                            {
                                                var lineNum = lineEntry.Number;
                                                var lineText = lineEntry.Text;
                                                <div class="flex">
                                                    <span class="mr-4 inline-block w-6 select-none text-right text-zinc-600">@lineNum</span>
                                                    <span>@(string.IsNullOrEmpty(lineText) ? " " : lineText)</span>
                                                </div>
                                            }</code></pre>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Language(string Value, string Label);
    private record CodeSnippet(string Code, string Language);
    private record CommentData(string Id, string Author, string Avatar, string Content, string Timestamp, CodeSnippet? Snippet);
    private record LineEntry(int Number, string Text);

    private static readonly Language[] _languages =
    [
        new("typescript", "TypeScript"),
        new("javascript", "JavaScript"),
        new("python", "Python"),
        new("rust", "Rust"),
        new("go", "Go"),
        new("sql", "SQL"),
    ];

    private static readonly CommentData[] _comments =
    [
        new("1", "Sarah Chen", "", "Here's the fix for the async issue:", "2 hours ago",
            new CodeSnippet(
                "async function fetchUser(id: string) {\n  const response = await fetch(`/api/users/${id}`)\n  if (!response.ok) {\n    throw new Error('Failed to fetch user')\n  }\n  return response.json()\n}",
                "typescript"
            )
        ),
        new("2", "Alex Morgan", "", "Perfect! That resolves the race condition.", "1 hour ago", null),
        new("3", "Jordan Lee", "", "Here's the Python equivalent for reference:", "30 min ago",
            new CodeSnippet(
                "async def fetch_user(user_id: str):\n    response = await client.get(f\"/api/users/{user_id}\")\n    response.raise_for_status()\n    return response.json()",
                "python"
            )
        ),
    ];

    private string _newComment = "";
    private bool _showCodeEditor = false;
    private string _code = "";
    private string _language = "typescript";
    private string? _copied = null;

    private void HandleCopy(string id, string text)
    {
        _copied = id;
        // In a real implementation, navigator.clipboard.writeText would be called via JS interop
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var initials = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) initials += char.ToUpper(p[0]);
        }
        return initials;
    }

    private static string GetLanguageLabel(string value)
    {
        foreach (var lang in _languages)
        {
            if (lang.Value == value) return lang.Label;
        }
        return value;
    }

    private static LineEntry[] GetLines(string codeText)
    {
        var lines = codeText.Split('\n');
        var result = new LineEntry[lines.Length];
        for (var i = 0; i < lines.Length; i++)
        {
            result[i] = new LineEntry(i + 1, lines[i]);
        }
        return result;
    }
}
