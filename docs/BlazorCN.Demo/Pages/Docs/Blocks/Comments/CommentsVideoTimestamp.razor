@* ============================================================
   Block: comments-video-timestamp
   Title: CommentsVideoTimestamp
   Description: Link comments to video timestamps for React and Next.js with time-coded feedback, playback controls, and chapter navigation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-video-timestamp.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Product Demo v2.mp4</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_comments.Length comments &middot; @FormatTime(_videoDuration) duration
                    </p>
                </div>
            </div>
        </div>

        @* Video placeholder *@
        <div class="relative aspect-video border-b bg-zinc-950">
            <div class="absolute inset-0 flex items-center justify-center">
                <LucideIconCn Name="play" Size="48" Class="size-12 text-zinc-100/80" />
            </div>
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-4">
                <div class="mb-2 font-mono text-xs text-zinc-100">
                    @FormatTime(_currentTime) / @FormatTime(_videoDuration)
                </div>
                <div class="relative">
                    <SliderCn Value="@_currentTime" Max="@_videoDuration" Step="1" ValueChanged="@((double v) => _currentTime = (int)v)" Class="w-full" aria-label="video position" />
                    @foreach (var comment in _comments)
                    {
                        var c = comment;
                        <button type="button"
                                @onclick="@(() => SeekToTimestamp(c.Timestamp))"
                                style="@(FormattableString.Invariant($"position:absolute;left:{(c.Timestamp * 100.0 / _videoDuration):F4}%;top:50%;transform:translate(-50%,-50%)"))"
                                class="size-3 rounded-full border-2 border-white bg-blue-500 shadow-lg transition-transform hover:scale-125"
                                title="@($"Comment at {c.TimestampLabel}")" aria-label="@($"Jump to comment at {FormatTime(c.Timestamp)}")"></button>
                    }
                </div>
            </div>
        </div>

        @* Comment at timestamp bar *@
        <div class="border-b bg-muted/30 px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => _newCommentTime = _currentTime)">
                Comment at @FormatTime(_currentTime)
            </ButtonCn>
        </div>

        @* New comment form *@
        @if (_newCommentTime != null)
        {
            <div class="border-b p-4">
                <div class="mb-2 flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-blue-500/10 text-xs font-normal text-blue-600 dark:text-blue-400">
                        @FormatTime(_newCommentTime.Value)
                    </BadgeCn>
                    <span class="text-xs text-muted-foreground">New comment</span>
                </div>
                <TextareaCn @bind-Value="_newCommentText" Placeholder="Add your feedback at this timestamp..." Class="min-h-[80px] text-sm" aria-label="Add your feedback at this timestamp..." />
                <div class="mt-2 flex justify-end gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => _newCommentTime = null)">
                        Cancel
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Post comment
                    </ButtonCn>
                </div>
            </div>
        }

        @* Comment list *@
        <div>
            @for (var i = 0; i < _comments.Length; i++)
            {
                var comment = _comments[i];
                var isLast = i == _comments.Length - 1;
                var initials = GetInitials(comment.Author);
                var isExpanded = _selectedComment == comment.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex gap-3">
                            <AvatarCn Class="size-8 shrink-0">
                                <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@comment.Author</span>
                                    <button type="button"
                                            @onclick="@(() => SeekToTimestamp(comment.Timestamp))"
                                            class="rounded bg-blue-500/10 px-1.5 py-0.5 font-mono text-xs font-medium text-blue-600 transition-colors hover:bg-blue-500/20 dark:text-blue-400">
                                        @comment.TimestampLabel
                                    </button>
                                    <span class="text-xs text-muted-foreground">@comment.PostedAt</span>
                                </div>
                                <p class="mt-1 text-sm leading-relaxed">@comment.Content</p>
                                <div class="mt-2 flex items-center gap-2">
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="@(() => _selectedComment = isExpanded ? null : comment.Id)">
                                        <LucideIconCn Name="message-circle" Size="12" Class="size-3" />
                                        @if (comment.Replies > 0)
                                        {
                                            @($"{comment.Replies} {(comment.Replies == 1 ? "reply" : "replies")}")
                                        }
                                        else
                                        {
                                            @("Reply")
                                        }
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer hint *@
        <div class="border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                Click timeline markers to jump to comments
            </span>
        </div>

    </div>
</section>

@code {
    private record TimestampComment(string Id, string Author, int Timestamp, string TimestampLabel, string Content, string PostedAt, int Replies);

    private static readonly TimestampComment[] _comments =
    [
        new("1", "Sarah Chen",  15,  "0:15", "Great intro hook! Consider adding text overlay here to reinforce the message.",           "2 hours ago", 1),
        new("2", "Alex Morgan", 45,  "0:45", "Audio levels seem a bit low during this section. Boost by 3-4dB.",                        "1 hour ago",  0),
        new("3", "Maya Patel",  92,  "1:32", "Transition to product demo feels abrupt. Add a 2-second fade or bridge shot.",             "30 min ago",  2),
        new("4", "Chris Taylor",135, "2:15", "Perfect call-to-action placement. Clear and compelling.",                                  "15 min ago",  0),
    ];

    private const int _videoDuration = 180;

    private int _currentTime = 0;
    private string? _selectedComment = null;
    private int? _newCommentTime = null;
    private string _newCommentText = "";

    private static string FormatTime(int seconds)
    {
        var mins = seconds / 60;
        var secs = seconds % 60;
        return $"{mins}:{secs:D2}";
    }

    private void SeekToTimestamp(int timestamp)
    {
        _currentTime = timestamp;
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var initials = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) initials += char.ToUpper(p[0]);
        }
        return initials;
    }
}
