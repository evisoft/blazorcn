@* ============================================================
   Block: comments-ai-sentiment-analysis
   Title: CommentsAiSentimentAnalysis
   Description: An AI-powered sentiment analysis comment system for React and Next.js with emotion detection, sentiment badges, mood indicators, and thread tone visualization built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-ai-sentiment-analysis.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Comments</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length @(_comments.Length == 1 ? "comment" : "comments")
            </p>
        </div>

        @* Thread Sentiment panel *@
        <div class="border-b bg-muted/30 p-4">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Thread Sentiment</span>
            </div>
            <div class="space-y-2">
                @foreach (var sentiment in _sentimentKeys)
                {
                    var cfg = _sentimentConfig[sentiment];
                    var pct = _sentimentPercentages[sentiment];
                    <div class="space-y-1">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-base">@cfg.Emoji</span>
                                <span class="text-xs text-muted-foreground">@cfg.Label</span>
                            </div>
                            <span class="text-xs font-medium tabular-nums text-muted-foreground">@pct%</span>
                        </div>
                        <ProgressCn Value="@pct" Class="h-1.5" />
                    </div>
                }
            </div>
        </div>

        @* New comment form *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_newComment" Placeholder="Add a comment..." Class="min-h-[100px]" />
            <div class="mt-2 flex justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var comment in _comments)
            {
                var initials = GetInitials(comment.Author);
                var cfg = _sentimentConfig[comment.Sentiment];
                <div class="p-4">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("ml-auto gap-1 text-xs font-normal", cfg.Bg)">
                                    <span class="text-base leading-none">@cfg.Emoji</span>
                                    <span class="@cfg.Color">@cfg.Label</span>
                                    <span class="text-muted-foreground">@comment.Confidence%</span>
                                </BadgeCn>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed">@comment.Content</p>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Comment(string Id, string Author, string Content, string Timestamp, string Sentiment, int Confidence);

    private record SentimentInfo(string Color, string Bg, string Label, string Emoji);

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen",  "This feature is absolutely fantastic! Great work team!",         "2 hours ago", "positive", 95),
        new("2", "Alex Morgan", "I'm having some issues with the new update. Can someone help?",  "2 hours ago", "negative", 78),
        new("3", "Maya Patel",  "The documentation has been updated with the latest changes.",    "1 hour ago",  "neutral",  92),
        new("4", "James Wilson","Really appreciate the quick response time on bug fixes!",        "1 hour ago",  "positive", 88),
    ];

    private static readonly Dictionary<string, SentimentInfo> _sentimentConfig = new()
    {
        ["positive"] = new("text-emerald-600 dark:text-emerald-400", "bg-emerald-500/10", "Positive", "😊"),
        ["neutral"]  = new("text-blue-600 dark:text-blue-400",       "bg-blue-500/10",    "Neutral",  "😐"),
        ["negative"] = new("text-amber-600 dark:text-amber-400",     "bg-amber-500/10",   "Negative", "😟"),
    };

    private static readonly string[] _sentimentKeys = ["positive", "neutral", "negative"];

    private string _newComment = "";

    private Dictionary<string, int> _sentimentPercentages => new()
    {
        ["positive"] = (int)Math.Round(_comments.Count(c => c.Sentiment == "positive") * 100.0 / _comments.Length),
        ["neutral"]  = (int)Math.Round(_comments.Count(c => c.Sentiment == "neutral")  * 100.0 / _comments.Length),
        ["negative"] = (int)Math.Round(_comments.Count(c => c.Sentiment == "negative") * 100.0 / _comments.Length),
    };

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => char.ToUpperInvariant(n[0])));
}
