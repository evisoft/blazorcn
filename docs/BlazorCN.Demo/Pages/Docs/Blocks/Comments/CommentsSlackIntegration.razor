@* ============================================================
   Block: comments-slack-integration
   Title: CommentsSlackIntegration
   Description: A comment Slack integration block for React and Next.js with webhook configuration, channel routing, notification formatting, and delivery status built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-slack-integration.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Slack Integration</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_sentCount sent · @_failedCount failed
            </p>
        </div>

        @* Webhook configs *@
        <div class="border-b px-4 py-3">
            <div class="space-y-3">
                @foreach (var webhook in _webhooks)
                {
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="hash" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">#@webhook.Channel</span>
                                <BadgeCn Variant="BadgeVariant.Outline"
                                         Class="@Cn.Merge("text-xs font-normal", webhook.Enabled
                                             ? "border-emerald-500/20 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400"
                                             : "border-muted-foreground/20 bg-muted/50 text-muted-foreground")">
                                    @(webhook.Enabled ? "Enabled" : "Disabled")
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@webhook.Trigger</p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 px-2 text-xs">
                            Configure
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        @* Test notification *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">
                Test notification
            </span>
            <div class="flex items-center gap-2">
                <InputCn @bind-Value="_testChannel"
                         Placeholder="Channel name..."
                         Class="h-8 flex-1 text-sm" aria-label="Channel name..." />
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs">
                    <LucideIconCn Name="send" Size="12" Class="size-3" />
                    Send test
                </ButtonCn>
            </div>
        </div>

        @* Notification list *@
        <div>
            @for (int i = 0; i < _notifications.Length; i++)
            {
                var notif = _notifications[i];
                var isLast = i == _notifications.Length - 1;
                var statusDot = GetStatusColor(notif.Status);
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-start gap-3">
                            <span class="@($"mt-1 size-2 shrink-0 rounded-full {statusDot}")" />
                            <div class="min-w-0 flex-1">
                                <div class="mb-1 flex items-center gap-2">
                                    <LucideIconCn Name="hash" Size="12" Class="size-3 text-muted-foreground/60" />
                                    <span class="text-xs font-medium text-muted-foreground">@notif.Channel</span>
                                    <span class="text-xs text-muted-foreground">·</span>
                                    <span class="text-xs text-muted-foreground">@notif.Author</span>
                                    <span class="text-xs text-muted-foreground">·</span>
                                    <span class="text-xs text-muted-foreground">@notif.Timestamp</span>
                                    @if (notif.Status == "sent")
                                    {
                                        <LucideIconCn Name="check" Size="16" Class="ml-auto size-4 text-emerald-500" />
                                    }
                                    @if (notif.Status == "failed")
                                    {
                                        <LucideIconCn Name="x" Size="16" Class="ml-auto size-4 text-red-500" />
                                    }
                                </div>
                                <p class="text-sm leading-relaxed">@notif.Message</p>
                                <div class="mt-2 flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs font-normal">
                                        @GetStatusLabel(notif.Status)
                                    </BadgeCn>
                                    @if (notif.Attempts > 1)
                                    {
                                        <span class="text-xs text-muted-foreground">@notif.Attempts attempts</span>
                                    }
                                    @if (notif.Status == "failed")
                                    {
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto h-7 gap-1 px-2 text-xs">
                                            <LucideIconCn Name="send" Size="12" Class="size-3" />
                                            Retry
                                        </ButtonCn>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>@(_webhooks.Count(w => w.Enabled)) active webhooks</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>@_notifications.Length notifications sent</span>
            </div>
        </div>

    </div>
</section>

@code {
    private string _testChannel = "support";

    private record WebhookConfig(string Id, string Channel, string WebhookUrl, bool Enabled, string Trigger);
    private record Notification(string Id, string Channel, string Message, string Author, string Status, string Timestamp, int Attempts);

    private static readonly WebhookConfig[] _webhooks =
    [
        new("1", "support",     "https://hooks.slack.com/services/T0000/B0000/abc123", true,  "Support mentions"),
        new("2", "engineering", "https://hooks.slack.com/services/T0000/B0001/def456", true,  "Bug reports"),
        new("3", "product",     "https://hooks.slack.com/services/T0000/B0002/ghi789", false, "Feature requests"),
    ];

    private static readonly Notification[] _notifications =
    [
        new("1", "support",     "Need help with billing issue - payment not processing",        "Sarah Chen",   "sent",    "2 min ago",   1),
        new("2", "engineering", "Critical bug: API returning 500 errors on /api/users endpoint", "Alex Morgan",  "sent",    "15 min ago",  1),
        new("3", "support",     "How do I export my data? Can't find the option in settings.",   "James Wilson", "failed",  "1 hour ago",  3),
        new("4", "product",     "Please add dark mode support to the mobile app",               "Maya Patel",   "pending", "2 hours ago", 0),
    ];

    private int _sentCount   => _notifications.Count(n => n.Status == "sent");
    private int _failedCount => _notifications.Count(n => n.Status == "failed");

    private static string GetStatusColor(string status) => status switch
    {
        "sent"    => "bg-emerald-500",
        "failed"  => "bg-red-500",
        "pending" => "bg-amber-500",
        _         => "bg-muted-foreground",
    };

    private static string GetStatusLabel(string status) => status switch
    {
        "sent"    => "Sent",
        "failed"  => "Failed",
        "pending" => "Pending",
        _         => status,
    };
}
