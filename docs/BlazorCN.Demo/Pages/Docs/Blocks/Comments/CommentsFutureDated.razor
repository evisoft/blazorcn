@* ============================================================
   Block: comments-future-dated
   Title: CommentsFutureDated
   Description: Scheduled visibility reveals for comments in React and Next.js with embargo dates, countdown timers, and automatic publishing built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-future-dated.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Announcements</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_comments.Count(c => c.Status == "scheduled") scheduled ·
                        @_comments.Count(c => c.Status == "published") published
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="@ToggleScheduled">
                    @if (_showScheduled)
                    {
                        <LucideIconCn Name="eye" Size="12" Class="size-3" />
                        <span>Hide scheduled</span>
                    }
                    else
                    {
                        <LucideIconCn Name="eye-off" Size="12" Class="size-3" />
                        <span>Show scheduled</span>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Comment list *@
        <div>
            @{
                var visibleComments = _showScheduled ? _comments : _comments.Where(c => c.Status == "published").ToArray();
                var count = visibleComments.Length;
            }
            @foreach (var (comment, index) in visibleComments.Select((c, i) => (c, i)))
            {
                var isLast = index == count - 1;
                var isScheduled = comment.Status == "scheduled";
                var initials = GetInitials(comment.Author);
                <div class="@(isLast ? "" : "border-b")">
                    <div class="@(Cn.Merge("px-4 py-3", (isScheduled && !comment.IsAuthor) ? "opacity-50" : ""))">
                        <div class="flex gap-3">
                            <AvatarCn Class="size-8 shrink-0">
                                <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@comment.Author</span>
                                    @if (isScheduled)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-amber-500/10 text-xs font-normal text-amber-600 dark:text-amber-400">
                                            <LucideIconCn Name="clock" Size="12" Class="mr-1 size-3" />
                                            Scheduled
                                        </BadgeCn>
                                    }
                                    @if (comment.IsAuthor && isScheduled)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                            Preview
                                        </BadgeCn>
                                    }
                                </div>
                                <p class="mt-1 text-sm leading-relaxed">@comment.Content</p>

                                @if (isScheduled)
                                {
                                    <div class="mt-2 rounded-md bg-amber-500/5 px-3 py-2">
                                        <div class="flex items-center gap-2 text-xs">
                                            <LucideIconCn Name="calendar" Size="12" Class="size-3 text-amber-600 dark:text-amber-400" />
                                            <span class="font-medium text-amber-600 dark:text-amber-400">
                                                Publishes @comment.TimeUntilPublish
                                            </span>
                                        </div>
                                        <p class="mt-1 text-xs text-muted-foreground">
                                            @comment.PublishAt@(comment.IsAuthor ? "" : " · Visible to you in preview mode")
                                        </p>
                                    </div>
                                }

                                @if (!isScheduled)
                                {
                                    <span class="mt-1 block text-xs text-muted-foreground">
                                        Published @comment.PublishAt
                                    </span>
                                }

                                @if (comment.IsAuthor && isScheduled)
                                {
                                    <div class="mt-2 flex gap-2">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 text-xs">
                                            Edit
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 text-xs">
                                            Publish now
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 text-xs text-red-600 hover:text-red-600 dark:text-red-400">
                                            Cancel
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @{
            var visible2 = _showScheduled ? _comments : _comments.Where(c => c.Status == "published").ToArray();
        }
        @if (visible2.Length == 0)
        {
            <div class="px-4 py-8 text-center text-sm text-muted-foreground">
                No announcements to show
            </div>
        }

    </div>
</section>

@code {
    private record CommentItem(string Id, string Author, string Content, string PublishAt, string TimeUntilPublish, string Status, bool IsAuthor);

    private static readonly CommentItem[] _comments =
    [
        new("1", "Sarah Chen", "Excited to announce our Q2 product roadmap! Major new features launching next month.", "Apr 5, 2026 at 9:00 AM", "Tomorrow at 9:00 AM", "scheduled", true),
        new("2", "Alex Morgan", "New pricing tiers will be available starting next week. Early bird discounts for existing customers.", "Apr 8, 2026 at 10:00 AM", "In 4 days", "scheduled", false),
        new("3", "Maya Patel", "Just wrapped up an amazing sprint! Great work everyone on the accessibility improvements.", "Apr 4, 2026 at 2:00 PM", "Published", "published", false),
        new("4", "Chris Taylor", "Design system v3 is live! Check out the new component documentation and examples.", "Apr 4, 2026 at 10:00 AM", "Published", "published", false),
    ];

    private bool _showScheduled = true;

    private void ToggleScheduled()
    {
        _showScheduled = !_showScheduled;
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var initials = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) initials += char.ToUpper(p[0]);
        }
        return initials;
    }
}
