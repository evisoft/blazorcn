@* ============================================================
   Block: comments-auto-archive
   Title: CommentsAutoArchive
   Description: Automatic comment archiving by age rules for React and Next.js with age indicators, archive preview, and manual override built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-auto-archive.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Discussion Archive</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Auto-archive after 90 days · @_expiringSoonCount expiring soon
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="@(_viewMode == "active" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                              Size="ButtonSize.Sm"
                              Class="h-7 px-2.5 text-xs"
                              OnClick="@(() => _viewMode = "active")">
                        Active
                    </ButtonCn>
                    <ButtonCn Variant="@(_viewMode == "archived" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                              Size="ButtonSize.Sm"
                              Class="h-7 gap-1 px-2.5 text-xs"
                              OnClick="@(() => _viewMode = "archived")">
                        <LucideIconCn Name="archive" Size="12" Class="size-3" />
                        Archived
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Expiring soon banner *@
        @if (_viewMode == "active" && _expiringSoonCount > 0)
        {
            <div class="border-b bg-amber-500/5 px-4 py-2.5">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="clock" Size="16" Class="size-4 text-amber-600 dark:text-amber-400" />
                    <span class="text-sm font-medium text-amber-600 dark:text-amber-400">
                        @_expiringSoonCount @(_expiringSoonCount == 1 ? "comment" : "comments") will be archived soon
                    </span>
                </div>
                <p class="mt-1 text-xs text-muted-foreground">
                    Comments older than 90 days are automatically archived
                </p>
            </div>
        }

        @* Comment list *@
        <div>
            @{
                var displayComments = _viewMode == "active" ? _activeComments : _archivedComments;
            }
            @for (var i = 0; i < displayComments.Length; i++)
            {
                var comment = displayComments[i];
                var isLast = i == displayComments.Length - 1;
                var initials = GetInitials(comment.Author);
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex gap-3">
                            <AvatarCn Class="@Cn.Merge("size-8 shrink-0", comment.Status == "archived" ? "opacity-60" : "")">
                                <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@comment.Author</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-xs font-normal", StatusColor(comment.Status))">
                                        @if (comment.Status == "active")
                                        {
                                            <text>Active</text>
                                        }
                                        @if (comment.Status == "expiring-soon")
                                        {
                                            <text>Expiring soon</text>
                                        }
                                        @if (comment.Status == "archived")
                                        {
                                            <text>Archived</text>
                                        }
                                    </BadgeCn>
                                </div>
                                <p class="@Cn.Merge("mt-1 text-sm leading-relaxed", comment.Status == "archived" ? "text-muted-foreground" : "")">
                                    @comment.Content
                                </p>
                                <div class="mt-2 flex items-center gap-2">
                                    <span class="text-xs text-muted-foreground">
                                        Posted @comment.CreatedAt · @comment.Age
                                    </span>
                                </div>
                                <div class="mt-2 flex gap-2">
                                    @if (comment.Status == "archived")
                                    {
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                            <LucideIconCn Name="archive-restore" Size="12" Class="size-3" />
                                            Restore
                                        </ButtonCn>
                                    }
                                    @if (comment.Status != "archived")
                                    {
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                            <LucideIconCn Name="archive" Size="12" Class="size-3" />
                                            Archive now
                                        </ButtonCn>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Empty state *@
        @{
            var emptyDisplayComments = _viewMode == "active" ? _activeComments : _archivedComments;
        }
        @if (emptyDisplayComments.Length == 0)
        {
            <div class="px-4 py-8 text-center text-sm text-muted-foreground">
                @(_viewMode == "active" ? "No active comments" : "No archived comments")
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span>
                    @_activeComments.Length active · @_archivedComments.Length archived
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Archive settings
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Comment(
        string Id,
        string Author,
        string Content,
        string CreatedAt,
        string Age,
        string Status
    );

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen", "Initial project kickoff meeting scheduled for next week.", "Jan 15, 2026", "80 days ago", "expiring-soon"),
        new("2", "Alex Morgan", "Updated design mockups based on stakeholder feedback.", "Feb 28, 2026", "36 days ago", "active"),
        new("3", "Maya Patel", "Q1 sprint planning completed. Ready to start development.", "Mar 15, 2026", "20 days ago", "active"),
        new("4", "Chris Taylor", "Final review of Q4 roadmap items before archiving.", "Dec 10, 2025", "115 days ago", "archived"),
    ];

    private static readonly Comment[] _activeComments = _comments.Where(c => c.Status != "archived").ToArray();
    private static readonly Comment[] _archivedComments = _comments.Where(c => c.Status == "archived").ToArray();
    private static readonly int _expiringSoonCount = _comments.Count(c => c.Status == "expiring-soon");

    private string _viewMode = "active";

    private static string GetInitials(string author)
    {
        return string.Concat(author.Split(' ').Select(n => n[0])).ToUpper();
    }

    private static string StatusColor(string status) => status switch
    {
        "active" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "expiring-soon" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "archived" => "bg-muted text-muted-foreground",
        _ => ""
    };
}
