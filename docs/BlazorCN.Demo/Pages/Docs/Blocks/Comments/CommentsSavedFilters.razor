@* ============================================================
   Block: comments-saved-filters
   Title: CommentsSavedFilters
   Description: A saved filter preset system for React and Next.js with custom filters, quick access, and filter sharing built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-saved-filters.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Saved Filters</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_filters.Count saved · @GetFilteredComments().Count results
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="@(() => _showNewFilter = !_showNewFilter)">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    New filter
                </ButtonCn>
            </div>
        </div>

        @* New filter input *@
        @if (_showNewFilter)
        {
            <div class="overflow-hidden border-b bg-muted/20 px-4 py-3">
                <div class="flex items-center gap-2">
                    <InputCn @bind-Value="_newFilterName" Placeholder="Filter name..." Class="h-8 text-sm" aria-label="Filter name..." />
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs" OnClick="CreateFilter">
                        Create
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs" OnClick="@(() => { _showNewFilter = false; _newFilterName = ""; })">
                        Cancel
                    </ButtonCn>
                </div>
            </div>
        }

        @* Filter chips *@
        <div class="border-b p-4">
            <div class="flex flex-wrap gap-2">
                @foreach (var filter in _filters)
                {
                    var f = filter;
                    var isActive = _activeFilter == f.Id;
                    <div class="group relative">
                        <button type="button"
                                @onclick="@(() => ApplyFilter(f.Id))"
                                class="@Cn.Merge("flex items-center gap-2 rounded-md border px-3 py-1.5 text-xs transition-all", isActive ? "border-foreground bg-foreground text-background" : "border-border bg-background hover:bg-muted/50")">
                            @if (isActive)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideIconCn Name="filter" Size="12" Class="size-3" />
                            }
                            <span class="font-medium">@f.Name</span>
                            <BadgeCn Variant="BadgeVariant.Secondary"
                                     Class="@Cn.Merge("h-4 px-1.5 text-[10px] font-normal tabular-nums", isActive ? "bg-background/20 text-background" : "")">
                                @f.Count
                            </BadgeCn>
                        </button>
                        <button type="button"
                                @onclick="@(() => DeleteFilter(f.Id))"
                                class="absolute -right-1.5 -top-1.5 flex size-4 items-center justify-center rounded-full bg-red-500 text-white opacity-0 transition-opacity group-hover:opacity-100" aria-label="@($"Delete {f.Name}")">
                            <LucideIconCn Name="x" Size="10" Class="size-2.5" />
                        </button>
                    </div>
                }
            </div>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @{
                var filteredComments = GetFilteredComments();
            }
            @foreach (var comment in filteredComments)
            {
                <div class="px-4 py-3">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                    @comment.Status
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-sm text-muted-foreground">@comment.Content</p>
                            <span class="mt-1 block text-xs text-muted-foreground">@comment.Timestamp</span>
                        </div>
                    </div>
                </div>
            }
            @if (filteredComments.Count == 0)
            {
                <div class="px-4 py-8 text-center text-sm text-muted-foreground">
                    No comments match this filter
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            @if (_activeFilter != null)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="@(() => _activeFilter = null)">
                    <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                    Clear active filter
                </ButtonCn>
            }
            else
            {
                <span class="text-xs text-muted-foreground">Select a filter to view results</span>
            }
        </div>

    </div>
</section>

@code {
    private record FilterData(string Id, string Name, string[]? Status, string? Author, int Count);
    private record CommentData(string Id, string Author, string Content, string Status, string Timestamp);

    private List<FilterData> _filters =
    [
        new("1", "Pending Review", ["pending"], null, 12),
        new("2", "Spam Reports", ["spam"], null, 3),
        new("3", "My Comments", null, "Sarah Chen", 8),
        new("4", "Approved Today", ["approved"], null, 24),
        new("5", "Needs Attention", ["pending", "spam"], null, 15),
    ];

    private static readonly CommentData[] _comments =
    [
        new("1", "Sarah Chen", "This component is excellent", "approved", "2 hours ago"),
        new("2", "James Wilson", "How do I integrate this?", "pending", "3 hours ago"),
        new("3", "Spam Bot", "Click here for prizes!", "spam", "5 hours ago"),
        new("4", "Maya Patel", "Great documentation", "approved", "6 hours ago"),
        new("5", "Alex Morgan", "Found a bug in the tooltip", "pending", "7 hours ago"),
    ];

    private string? _activeFilter = null;
    private bool _showNewFilter = false;
    private string _newFilterName = "";

    private void ApplyFilter(string filterId)
    {
        _activeFilter = _activeFilter == filterId ? null : filterId;
    }

    private void DeleteFilter(string filterId)
    {
        _filters = _filters.Where(f => f.Id != filterId).ToList();
        if (_activeFilter == filterId)
            _activeFilter = null;
    }

    private void CreateFilter()
    {
        if (string.IsNullOrWhiteSpace(_newFilterName)) return;
        var newFilter = new FilterData(
            Id: (_filters.Count + 1).ToString(),
            Name: _newFilterName,
            Status: ["pending"],
            Author: null,
            Count: 0
        );
        _filters = [.._filters, newFilter];
        _newFilterName = "";
        _showNewFilter = false;
    }

    private List<CommentData> GetFilteredComments()
    {
        if (_activeFilter == null) return _comments.ToList();
        var filter = _filters.FirstOrDefault(f => f.Id == _activeFilter);
        if (filter == null) return _comments.ToList();

        return _comments.Where(comment =>
        {
            if (filter.Status != null && !filter.Status.Contains(comment.Status)) return false;
            if (filter.Author != null && comment.Author != filter.Author) return false;
            return true;
        }).ToList();
    }
}
