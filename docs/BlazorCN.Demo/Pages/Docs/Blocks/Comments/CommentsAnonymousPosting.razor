@* ============================================================
   Block: comments-anonymous-posting
   Title: CommentsAnonymousPosting
   Description: An anonymous comment system for React and Next.js with privacy toggle, masked identities, and moderation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-anonymous-posting.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Comments</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length comments · Anonymous posting enabled
            </p>
        </div>

        @* Compose area *@
        <div class="border-b p-4">
            <div class="mb-3 flex items-center justify-between rounded-md border bg-muted/20 p-3">
                <div class="flex items-center gap-3">
                    <LucideIconCn Name="eye-off" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <div>
                        <span class="block text-sm font-medium">Post anonymously</span>
                        <span class="mt-0.5 block text-xs text-muted-foreground">
                            @(_isAnonymous ? $"Posting as {_randomName}" : "Your name will be visible")
                        </span>
                    </div>
                </div>
                <SwitchCn @bind-Value="_isAnonymous" />
            </div>

            @if (_isAnonymous)
            {
                <div class="mb-3 overflow-hidden rounded-md bg-blue-500/10 p-3">
                    <p class="text-xs leading-relaxed text-blue-700 dark:text-blue-400">
                        Your identity is hidden but your comment will be reviewed before appearing. Abuse
                        will result in suspension.
                    </p>
                </div>
            }

            <TextareaCn @bind-Value="_newComment" Placeholder="@(_isAnonymous ? "Share your thoughts anonymously..." : "Add a comment...")" Class="min-h-[100px]" />
            <div class="mt-2 flex justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs">
                    @if (_isAnonymous)
                    {
                        <LucideIconCn Name="eye-off" Size="12" Class="size-3" />
                    }
                    Post @(_isAnonymous ? "anonymously" : "comment")
                </ButtonCn>
            </div>
        </div>

        @* Comments list *@
        <div class="divide-y">
            @foreach (var comment in _comments)
            {
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted">
                            @if (comment.IsAnonymous)
                            {
                                <LucideIconCn Name="eye-off" Size="16" Class="size-4 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideIconCn Name="user" Size="16" Class="size-4 text-muted-foreground" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                @if (comment.IsVerified && !comment.IsAnonymous)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 gap-0.5 px-1.5 text-[10px] font-normal">
                                        <LucideIconCn Name="shield-check" Size="10" Class="size-2.5" />
                                        Verified
                                    </BadgeCn>
                                }
                                @if (comment.IsAnonymous)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 gap-0.5 px-1.5 text-[10px] font-normal">
                                        <LucideIconCn Name="eye-off" Size="10" Class="size-2.5" />
                                        Anonymous
                                    </BadgeCn>
                                }
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                @comment.Content
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5 text-xs text-muted-foreground">
            Anonymous comments are reviewed before appearing
        </div>

    </div>
</section>

@code {
    private record Comment(
        string Id,
        string Author,
        string Content,
        string Timestamp,
        bool IsAnonymous,
        bool IsVerified
    );

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen", "This component library is excellent", "2 hours ago", false, true),
        new("2", "Anonymous Panda", "I appreciate the anonymous feedback option", "3 hours ago", true, false),
        new("3", "James Wilson", "Great work on the documentation", "5 hours ago", false, true),
        new("4", "Anonymous Fox", "Some features could use improvement", "6 hours ago", true, false),
    ];

    private static readonly string[] _anonymousNames =
    [
        "Anonymous Panda",
        "Anonymous Fox",
        "Anonymous Owl",
        "Anonymous Bear",
        "Anonymous Wolf",
        "Anonymous Eagle",
    ];

    private bool _isAnonymous = false;
    private string _newComment = "";
    private readonly string _randomName = _anonymousNames[new Random().Next(_anonymousNames.Length)];
}
