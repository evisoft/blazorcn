@* ============================================================
   Block: comments-scheduled-publishing
   Title: CommentsScheduledPublishing
   Description: Schedule comments for future publishing in React and Next.js with datetime picker, scheduled queue display, and draft management built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-scheduled-publishing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Schedule Comment</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Post immediately or schedule for later
            </p>
        </div>

        @* Compose area *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_newComment" Placeholder="Write your comment..." Class="min-h-[100px]" />
            <div class="mt-3 flex items-center gap-2">
                <div class="flex flex-1 items-center gap-2">
                    <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                    <input type="datetime-local"
                           value="@_scheduledDate"
                           @oninput="@((e) => _scheduledDate = e.Value?.ToString() ?? "")"
                           placeholder="Schedule for..."
                           class="flex h-8 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm transition-colors file:border-0 file:bg-transparent file:text-sm file:font-medium placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50" />
                </div>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-8 gap-1 text-xs">
                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                    Schedule
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs">
                    <LucideIconCn Name="send" Size="12" Class="size-3" />
                    Post now
                </ButtonCn>
            </div>
        </div>

        @* Scheduled queue header *@
        <div class="border-b px-4 py-2.5">
            <span class="text-sm font-medium">Scheduled Queue</span>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_scheduledComments.Length comments pending
            </p>
        </div>

        @* Queue list *@
        <div>
            @foreach (var comment in _scheduledComments)
            {
                var item = comment;
                var isLast = item.Id == _scheduledComments[_scheduledComments.Length - 1].Id;
                var statusClass = GetStatusClass(item.Status);
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="mb-2 flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-xs font-normal", statusClass)">
                                @item.Status
                            </BadgeCn>
                            <span class="text-xs text-muted-foreground">@item.ScheduledFor</span>
                        </div>
                        <p class="text-sm leading-relaxed">@item.Content</p>
                        <div class="mt-2 flex items-center gap-2">
                            @if (item.Status == "scheduled")
                            {
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                    Publish now
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 text-xs">
                                    Edit
                                </ButtonCn>
                            }
                            @if (item.Status == "draft")
                            {
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 text-xs">
                                    Edit draft
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 text-xs">
                                    Set schedule
                                </ButtonCn>
                            }
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 text-xs text-red-600 hover:text-red-600 dark:text-red-400">
                                Cancel
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ScheduledComment(string Id, string Content, string ScheduledFor, string Status);

    private static readonly ScheduledComment[] _scheduledComments =
    [
        new("1", "Q2 product roadmap has been finalized and approved by leadership team.", "Apr 5, 2026 at 9:00 AM", "scheduled"),
        new("2", "Weekly team sync reminder: All hands meeting tomorrow at 2pm PT.", "Apr 6, 2026 at 8:00 AM", "scheduled"),
        new("3", "New feature release announcement draft - pending final review.", "Apr 8, 2026 at 10:00 AM", "draft"),
    ];

    private string _newComment = "";
    private string _scheduledDate = "";

    private static string GetStatusClass(string status) => status switch
    {
        "draft" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "scheduled" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "published" => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        _ => "",
    };
}
