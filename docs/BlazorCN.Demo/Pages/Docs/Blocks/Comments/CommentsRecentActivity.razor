@* ============================================================
   Block: comments-recent-activity
   Title: CommentsRecentActivity
   Description: A real-time activity feed for React and Next.js with new comments, replies, and updates stream built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-recent-activity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Recent Activity</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_activities.Length activities · @_newCount new
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Refresh
                </ButtonCn>
            </div>
        </div>

        @* New activity banner *@
        @if (_newCount > 0)
        {
            <div class="border-b bg-blue-500/10 px-4 py-2">
                <span class="text-xs font-medium text-blue-700 dark:text-blue-400">
                    @_newCount new @(_newCount == 1 ? "activity" : "activities") since your last visit
                </span>
            </div>
        }

        @* Activity list *@
        <div class="divide-y">
            @for (int i = 0; i < _activities.Length; i++)
            {
                var activity = _activities[i];
                var initials = GetInitials(activity.Author);
                var iconName = GetIconName(activity.Type);
                var iconColor = GetActivityColor(activity.Type);
                <div class="px-4 py-3 transition-colors hover:bg-muted/30">
                    <div class="flex gap-3">
                        <div class="relative">
                            <AvatarCn Class="size-8 shrink-0">
                                <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                            </AvatarCn>
                            <span class="@($"absolute -bottom-0.5 -right-0.5 flex size-4 items-center justify-center rounded-full border-2 border-card {iconColor}")">
                                <LucideIconCn Name="@iconName" Size="10" Class="size-2.5 text-white" />
                            </span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@activity.Author</span>
                                @if (activity.IsNew)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 bg-blue-500/20 px-1.5 text-[10px] font-normal text-blue-700 dark:text-blue-400">
                                        New
                                    </BadgeCn>
                                }
                                <span class="text-xs text-muted-foreground">@activity.Timestamp</span>
                            </div>
                            <p class="mt-0.5 text-sm text-muted-foreground">
                                @if (activity.Type == "reply" && !string.IsNullOrEmpty(activity.TargetComment))
                                {
                                    <span class="font-medium text-foreground">Replied to @activity.TargetComment: </span>
                                }
                                @if (activity.Type == "reaction")
                                {
                                    <span class="font-medium text-foreground">@activity.Content</span>
                                }
                                @if (activity.Type == "comment")
                                {
                                    @activity.Content
                                }
                                @if (activity.Type == "reply")
                                {
                                    @activity.Content
                                }
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5 text-xs text-muted-foreground">
            Last updated: Just now
        </div>

    </div>
</section>

@code {
    private record Activity(string Id, string Type, string Author, string Content, string Timestamp, bool IsNew, string TargetComment = "");

    private static readonly Activity[] _activities =
    [
        new("1", "comment",  "Sarah Chen",   "This component library is excellent for TypeScript projects", "2 min ago",  true),
        new("2", "reply",    "James Wilson", "Thanks for the feedback! We're glad you like it",             "5 min ago",  true,  "Sarah's comment"),
        new("3", "reaction", "Maya Patel",   "Liked your comment about dark mode",                          "10 min ago", false),
        new("4", "comment",  "Alex Morgan",  "The TypeScript types are well-documented",                    "15 min ago", false),
        new("5", "reply",    "Chris Taylor", "Can you share more details about this?",                      "1 hour ago", false, "Alex's comment"),
        new("6", "comment",  "Jordan Lee",   "Great documentation overall",                                 "2 hours ago", false),
    ];

    private int _newCount => _activities.Count(a => a.IsNew);

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();

    private static string GetIconName(string type) => type switch
    {
        "comment"  => "message-circle",
        "reply"    => "reply",
        "reaction" => "thumbs-up",
        _          => "message-circle",
    };

    private static string GetActivityColor(string type) => type switch
    {
        "comment"  => "bg-blue-500",
        "reply"    => "bg-emerald-500",
        "reaction" => "bg-amber-500",
        _          => "bg-blue-500",
    };
}
