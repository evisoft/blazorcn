@* ============================================================
   Block: comments-ip-geoblocking
   Title: CommentsIpGeoblocking
   Description: A geographic restriction comment section for React and Next.js with IP-based access control, country blocking, and location indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-ip-geoblocking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Geographically Restricted Comments</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        IP-based regional access control
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1.5 text-xs">
                    <LucideIconCn Name="globe" Size="12" Class="size-3" />
                    Geo-Protected
                </BadgeCn>
            </div>
        </div>

        @* Location / IP row *@
        <div class="@Cn.Merge("border-b px-4 py-3", _isBlocked ? "bg-red-500/10" : "bg-muted/30")">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="map-pin" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-xs text-muted-foreground">
                        Your location: <span class="font-medium text-foreground">@_currentUserCountry</span>
                    </span>
                    <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                    <span class="font-mono text-xs text-muted-foreground">IP: @_currentUserIP</span>
                </div>
                @if (_isBlocked)
                {
                    <BadgeCn Variant="BadgeVariant.Destructive" Class="gap-1 text-[10px]">
                        <LucideIconCn Name="x-circle" Size="12" Class="size-3" />
                        Blocked
                    </BadgeCn>
                }
                else
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 bg-emerald-500/10 text-[10px] text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="globe" Size="12" Class="size-3" />
                        Allowed
                    </BadgeCn>
                }
            </div>
        </div>

        @* Body: blocked or comment list *@
        @if (_isBlocked)
        {
            <div class="px-4 py-8 text-center">
                <LucideIconCn Name="shield-alert" Size="48" Class="mx-auto size-12 text-red-500/40" />
                <h3 class="mt-3 text-sm font-medium">Access Restricted</h3>
                <p class="mt-1 text-xs leading-relaxed text-muted-foreground">
                    Comments are not available in your region due to regulatory requirements.
                </p>
                <p class="mt-2 font-mono text-xs text-muted-foreground">
                    Country code: @_currentUserCountry
                </p>
            </div>
        }
        else
        {
            <div>
                @for (int i = 0; i < _comments.Length; i++)
                {
                    var comment = _comments[i];
                    var isLast = i == _comments.Length - 1;
                    var initials = GetInitials(comment.Author);

                    <div class="@(isLast ? "p-4" : "border-b p-4")">
                        <div class="flex gap-3">
                            <AvatarCn Class="size-8 shrink-0">
                                <AvatarImageCn Src="@comment.Avatar" Alt="@comment.Author" />
                                <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@comment.Author</span>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-[10px] font-normal">
                                        <LucideIconCn Name="map-pin" Size="10" Class="size-2.5" />
                                        @comment.CountryCode
                                    </BadgeCn>
                                    <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                                </div>
                                <p class="mt-1.5 text-sm leading-relaxed">@comment.Content</p>
                                <p class="mt-1 text-xs text-muted-foreground">@comment.Location</p>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="border-t bg-muted/30 px-4 py-2.5">
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <span>Blocked regions: @string.Join(", ", _blockedRegions)</span>
                    <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                    <span>GDPR compliant</span>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record CommentItem(string Id, string Author, string Avatar, string Content, string Timestamp, string Location, string CountryCode);

    private static readonly string[] _blockedRegions = ["CN", "RU", "KP", "IR"];
    private const string _currentUserCountry = "US";
    private const string _currentUserIP = "192.168.1.45";

    private bool _isBlocked => System.Array.IndexOf(_blockedRegions, _currentUserCountry) >= 0;

    private static readonly CommentItem[] _comments =
    [
        new("1", "Sarah Chen", "", "The new data processing agreement complies with GDPR requirements. All EU user data is now stored in Frankfurt datacenter.", "10 min ago", "United States", "US"),
        new("2", "James Wilson", "", "UK office confirmed: local data sovereignty requirements met. No cross-border transfers needed.", "25 min ago", "United Kingdom", "GB"),
        new("3", "Maya Patel", "", "Singapore entity established. Complies with PDPA and local hosting mandates for APAC customers.", "1 hour ago", "Singapore", "SG"),
    ];

    private static string GetInitials(string author)
    {
        return string.Concat(author.Split(' ').Select(n => n.Length > 0 ? n[0].ToString().ToUpper() : ""));
    }
}
