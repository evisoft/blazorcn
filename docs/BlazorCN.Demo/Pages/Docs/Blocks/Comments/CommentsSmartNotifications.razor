@* ============================================================
   Block: comments-smart-notifications
   Title: CommentsSmartNotifications
   Description: An AI-prioritized notification system for React and Next.js with importance scoring, smart batching, and adaptive delivery built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-smart-notifications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Smart Notifications</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">AI-prioritized by importance</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1.5 text-xs">
                    <LucideIconCn Name="brain-circuit" Size="12" Class="size-3" />
                    AI Powered
                </BadgeCn>
            </div>
        </div>

        @* Subheader *@
        <div class="border-b bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <LucideIconCn Name="zap" Size="12" Class="size-3" />
                <span>Sorted by ML importance score • Focus on what matters</span>
            </div>
        </div>

        @* Notification list *@
        <div>
            @for (int i = 0; i < _notifications.Length; i++)
            {
                var notif = _notifications[i];
                var isLast = i == _notifications.Length - 1;
                var cfg = GetConfig(notif.Priority);
                var initials = GetInitials(notif.Author);
                <div class="@(isLast ? "p-4" : "border-b p-4")">
                    <div class="space-y-3">
                        <div class="flex gap-3">
                            <AvatarCn Class="size-8 shrink-0">
                                <AvatarImageCn Src="@notif.Avatar" Alt="@notif.Author" />
                                <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@notif.Author</span>
                                    <span class="text-xs text-muted-foreground">@notif.Action</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                        @notif.Thread
                                    </BadgeCn>
                                </div>
                                <p class="mt-1.5 text-sm leading-relaxed">@notif.Preview</p>
                                <span class="mt-1 text-xs text-muted-foreground">
                                    @notif.Timestamp
                                </span>
                            </div>
                        </div>

                        <div class="rounded-md bg-muted/50 p-3">
                            <div class="mb-2 flex items-center justify-between">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm">@cfg.Icon</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary"
                                             Class="@($"text-[10px] font-medium {cfg.BgColor} {cfg.Color}")">
                                        @cfg.Label Priority
                                    </BadgeCn>
                                    <span class="font-mono text-xs tabular-nums text-muted-foreground">
                                        @notif.Score/100
                                    </span>
                                </div>
                            </div>

                            <ProgressCn Value="@notif.Score" Class="mb-2 h-1.5" aria-label="Progress" />

                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var factor in notif.Factors)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal">
                                        @factor
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t bg-muted/30 px-4 py-2.5">
            <p class="text-xs text-muted-foreground">
                ML model learns from your behavior • Low-priority updates batched hourly
            </p>
        </div>

    </div>
</section>

@code {
    private sealed class SmartNotification
    {
        public string Id { get; init; } = "";
        public string Author { get; init; } = "";
        public string Avatar { get; init; } = "";
        public string Action { get; init; } = "";
        public string Thread { get; init; } = "";
        public string Preview { get; init; } = "";
        public string Timestamp { get; init; } = "";
        public string Priority { get; init; } = "";
        public int Score { get; init; }
        public string[] Factors { get; init; } = [];
    }

    private sealed class PriorityConfig
    {
        public string Color { get; init; } = "";
        public string BgColor { get; init; } = "";
        public string Label { get; init; } = "";
        public string Icon { get; init; } = "";
    }

    private static readonly SmartNotification[] _notifications =
    [
        new()
        {
            Id = "1", Author = "CEO", Avatar = "",
            Action = "mentioned you in", Thread = "Q2 Board Review",
            Preview = "@alex I need your input on the revenue projections before the board call at 2pm.",
            Timestamp = "5 min ago", Priority = "urgent", Score = 98,
            Factors = ["Executive mention", "Time-sensitive", "Direct question"],
        },
        new()
        {
            Id = "2", Author = "Sarah Chen", Avatar = "",
            Action = "replied to your comment in", Thread = "Product Roadmap",
            Preview = "Great point about the mobile app timeline. Let's discuss in standup tomorrow.",
            Timestamp = "15 min ago", Priority = "high", Score = 85,
            Factors = ["Direct reply", "Active thread", "Recent activity"],
        },
        new()
        {
            Id = "3", Author = "James Wilson", Avatar = "",
            Action = "commented in", Thread = "Design System Updates",
            Preview = "Updated the color palette. Check it out when you have a chance.",
            Timestamp = "2 hours ago", Priority = "medium", Score = 62,
            Factors = ["Subscribed thread", "No urgency indicators"],
        },
        new()
        {
            Id = "4", Author = "Maya Patel", Avatar = "",
            Action = "reacted ❤️ to your comment in", Thread = "API Documentation",
            Preview = "Nice work on the authentication guide!",
            Timestamp = "5 hours ago", Priority = "low", Score = 28,
            Factors = ["Reaction only", "No action required"],
        },
    ];

    private static readonly Dictionary<string, PriorityConfig> _priorityConfig = new()
    {
        ["urgent"] = new() { Color = "text-red-600 dark:text-red-400",   BgColor = "bg-red-500/10",   Label = "Urgent", Icon = "🚨" },
        ["high"]   = new() { Color = "text-amber-600 dark:text-amber-400", BgColor = "bg-amber-500/10", Label = "High",   Icon = "⚡" },
        ["medium"] = new() { Color = "text-blue-600 dark:text-blue-400",  BgColor = "bg-blue-500/10",  Label = "Medium", Icon = "📌" },
        ["low"]    = new() { Color = "text-muted-foreground",             BgColor = "bg-muted/50",     Label = "Low",    Icon = "💬" },
    };

    private static PriorityConfig GetConfig(string priority) =>
        _priorityConfig.TryGetValue(priority, out var cfg) ? cfg : new();

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();
}
