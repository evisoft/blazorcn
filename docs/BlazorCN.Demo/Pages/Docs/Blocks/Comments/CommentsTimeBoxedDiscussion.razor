@* ============================================================
   Block: comments-time-boxed-discussion
   Title: CommentsTimeBoxedDiscussion
   Description: Phased discussion rounds with timers for React and Next.js with countdown displays, phase transitions, and locked previous rounds built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-time-boxed-discussion.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Design Critique Session</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                3 phases · 20 min total · Facilitator: Sarah Chen
            </p>
        </div>

        @* Active phase banner *@
        @if (_activePhase != null)
        {
            var ap = _activePhase;
            <div class="border-b bg-blue-500/5 px-4 py-3">
                <div class="mb-2 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="play" Size="16" Class="size-4 text-blue-600 dark:text-blue-400" />
                        <span class="text-sm font-medium">
                            Phase @ap.Number: @ap.Title
                        </span>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-blue-500/10 text-xs font-normal text-blue-600 dark:text-blue-400">
                        Active
                    </BadgeCn>
                </div>
                <p class="text-xs text-muted-foreground">@ap.Description</p>
                <div class="mt-3 flex items-center gap-3">
                    <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-mono text-sm font-medium tabular-nums">
                        @ap.TimeRemaining
                    </span>
                    <span class="text-xs text-muted-foreground">remaining</span>
                </div>
                <ProgressCn Value="@_progress" Class="mt-2 h-1.5" aria-label="Progress" />
            </div>
        }

        @* Phase list *@
        <div class="border-b">
            @foreach (var phase in _phases)
            {
                var ph = phase;
                var isLast = ph.Id == _phases[_phases.Length - 1].Id;
                var isCompleted = ph.Status == "completed";
                var isLocked = ph.Status == "completed";
                var statusClass = GetStatusClass(ph.Status);
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-center gap-3">
                            <span class="@($"flex size-6 shrink-0 items-center justify-center rounded-full text-xs font-medium {statusClass}")">
                                @if (isLocked)
                                {
                                    <LucideIconCn Name="lock" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    @ph.Number
                                }
                            </span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@ph.Title</span>
                                    @if (isCompleted)
                                    {
                                        <span class="text-xs text-muted-foreground">
                                            @ph.CommentCount comments
                                        </span>
                                    }
                                </div>
                                <p class="mt-0.5 text-xs text-muted-foreground">
                                    @ph.Duration · @ph.Description
                                </p>
                            </div>
                            @if (ph.Status == "upcoming")
                            {
                                <span class="shrink-0 text-xs text-muted-foreground">Upcoming</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Comment input for active phase *@
        @if (_activePhase != null)
        {
            var ap = _activePhase;
            <div class="p-4">
                <TextareaCn @bind-Value="_newComment" Placeholder="@($"Add your thoughts for {ap.Title}...")" Class="min-h-[100px]" aria-label="@($"Add your thoughts for {ap.Title}...")" />
                <div class="mt-2 flex items-center justify-between">
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="alert-circle" Size="12" Class="size-3" />
                        <span>Comments will be locked when this phase ends</span>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Post comment
                    </ButtonCn>
                </div>
            </div>
        }

        @* No active phase fallback *@
        @if (_activePhase == null)
        {
            <div class="px-4 py-8 text-center">
                <p class="text-sm text-muted-foreground">
                    Waiting for facilitator to start the session
                </p>
            </div>
        }

    </div>
</section>

@code {
    private record Phase(string Id, int Number, string Title, string Description, string Duration, string TimeRemaining, string Status, int CommentCount);

    private static readonly Phase[] _phases =
    [
        new("1", 1, "Individual Review", "Silent review — form your initial thoughts independently", "5 min", "2:34", "active", 0),
        new("2", 2, "Open Discussion", "Share feedback and discuss observations with the team", "10 min", "10:00", "upcoming", 0),
        new("3", 3, "Action Items", "Document decisions and next steps", "5 min", "5:00", "upcoming", 0),
    ];

    private Phase? _activePhase = null;
    private int _progress = 0;
    private string _newComment = "";

    protected override void OnInitialized()
    {
        foreach (var p in _phases)
        {
            if (p.Status == "active")
            {
                _activePhase = p;
                break;
            }
        }
        _progress = _activePhase != null ? 48 : 0;
    }

    private static string GetStatusClass(string status) => status switch
    {
        "upcoming" => "bg-muted/50 text-muted-foreground",
        "active" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "completed" => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        _ => ""
    };
}
