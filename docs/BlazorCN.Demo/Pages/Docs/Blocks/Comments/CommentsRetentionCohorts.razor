@* ============================================================
   Block: comments-retention-cohorts
   Title: CommentsRetentionCohorts
   Description: A user retention cohort analysis dashboard for React and Next.js with cohort tables, retention curves, churn indicators, and time-based segmentation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-retention-cohorts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Retention Cohorts</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">User retention by signup week</p>
        </div>

        @* Summary stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <div class="mb-1 flex items-center gap-1.5">
                    <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground/60" />
                    <span class="text-xs text-muted-foreground">Total users</span>
                </div>
                <div class="text-2xl font-semibold tabular-nums">@_totalUsers</div>
            </div>
            <div class="border-r px-4 py-3">
                <div class="mb-1 flex items-center gap-1.5">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground/60" />
                    <span class="text-xs text-muted-foreground">Week 1</span>
                </div>
                <div class="text-2xl font-semibold tabular-nums">@(Math.Round(_avgWeek1))%</div>
            </div>
            <div class="px-4 py-3">
                <div class="mb-1 flex items-center gap-1.5">
                    <LucideIconCn Name="trending-down" Size="14" Class="size-3.5 text-muted-foreground/60" />
                    <span class="text-xs text-muted-foreground">Week 4</span>
                </div>
                <div class="text-2xl font-semibold tabular-nums">@(Math.Round(_avgWeek4))%</div>
            </div>
        </div>

        @* Cohort table *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Cohort table</span>
                <div class="flex items-center gap-2">
                    <span class="text-[10px] text-muted-foreground">Low</span>
                    <div class="flex gap-1">
                        <div class="size-3 rounded-sm bg-red-500/20"></div>
                        <div class="size-3 rounded-sm bg-amber-500/20"></div>
                        <div class="size-3 rounded-sm bg-blue-500/20"></div>
                        <div class="size-3 rounded-sm bg-emerald-500/20"></div>
                    </div>
                    <span class="text-[10px] text-muted-foreground">High</span>
                </div>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead>
                        <tr>
                            <th class="pb-2 pr-4 text-left text-xs font-medium text-muted-foreground">Cohort</th>
                            <th class="pb-2 pr-2 text-right text-xs font-medium text-muted-foreground">Users</th>
                            <th class="pb-2 px-1 text-center text-xs font-medium text-muted-foreground">W0</th>
                            <th class="pb-2 px-1 text-center text-xs font-medium text-muted-foreground">W1</th>
                            <th class="pb-2 px-1 text-center text-xs font-medium text-muted-foreground">W2</th>
                            <th class="pb-2 px-1 text-center text-xs font-medium text-muted-foreground">W3</th>
                            <th class="pb-2 pl-1 text-center text-xs font-medium text-muted-foreground">W4</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cohort in _cohorts)
                        {
                            <tr>
                                <td class="py-1.5 pr-4 text-left text-xs font-medium">@cohort.Week</td>
                                <td class="py-1.5 pr-2 text-right text-xs text-muted-foreground">@cohort.Users</td>
                                <td class="py-1.5 px-1">
                                    <div class="@Cn.Merge("rounded px-2 py-1 text-center text-xs font-medium", GetRetentionColor(cohort.Week0))">
                                        @cohort.Week0%
                                    </div>
                                </td>
                                <td class="py-1.5 px-1">
                                    @if (cohort.Week1 > 0)
                                    {
                                        <div class="@Cn.Merge("rounded px-2 py-1 text-center text-xs font-medium", GetRetentionColor(cohort.Week1))">
                                            @cohort.Week1%
                                        </div>
                                    }
                                </td>
                                <td class="py-1.5 px-1">
                                    @if (cohort.Week2 > 0)
                                    {
                                        <div class="@Cn.Merge("rounded px-2 py-1 text-center text-xs font-medium", GetRetentionColor(cohort.Week2))">
                                            @cohort.Week2%
                                        </div>
                                    }
                                </td>
                                <td class="py-1.5 px-1">
                                    @if (cohort.Week3 > 0)
                                    {
                                        <div class="@Cn.Merge("rounded px-2 py-1 text-center text-xs font-medium", GetRetentionColor(cohort.Week3))">
                                            @cohort.Week3%
                                        </div>
                                    }
                                </td>
                                <td class="py-1.5 pl-1">
                                    @if (cohort.Week4 > 0)
                                    {
                                        <div class="@Cn.Merge("rounded px-2 py-1 text-center text-xs font-medium", GetRetentionColor(cohort.Week4))">
                                            @cohort.Week4%
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Key insights *@
        <div class="border-b px-4 py-3">
            <span class="mb-3 block text-xs font-medium text-muted-foreground">Key insights</span>
            <div class="space-y-1.5">
                <div class="flex items-start gap-2">
                    <span class="size-1.5 mt-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                    <p class="text-sm leading-relaxed">Week 3 cohort shows strongest retention at 75% in Week 1</p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="size-1.5 mt-1.5 shrink-0 rounded-full bg-amber-500"></span>
                    <p class="text-sm leading-relaxed">Average 4-week retention is 41%, indicating healthy engagement</p>
                </div>
                <div class="flex items-start gap-2">
                    <span class="size-1.5 mt-1.5 shrink-0 rounded-full bg-blue-500"></span>
                    <p class="text-sm leading-relaxed">Recent cohorts trending upward — improvements are working</p>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>5 week cohorts</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>Updated 1 hour ago</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record CohortWeek(string Week, int Users, int Week0, int Week1, int Week2, int Week3, int Week4);

    private static readonly CohortWeek[] _cohorts =
    [
        new("Week 1", 245, 100, 68, 52, 45, 41),
        new("Week 2", 289, 100, 72, 58, 51,  0),
        new("Week 3", 312, 100, 75, 62,  0,  0),
        new("Week 4", 276, 100, 71,  0,  0,  0),
        new("Week 5", 298, 100,  0,  0,  0,  0),
    ];

    private static readonly double _avgWeek1 =
        _cohorts.Where(c => c.Week1 > 0).Average(c => (double)c.Week1);

    private static readonly double _avgWeek4 =
        _cohorts.Where(c => c.Week4 > 0).Average(c => (double)c.Week4);

    private static readonly int _totalUsers = _cohorts.Sum(c => c.Users);

    private static string GetRetentionColor(int rate)
    {
        if (rate == 0)    return "bg-muted/30 text-muted-foreground/40";
        if (rate >= 70)   return "bg-emerald-500/20 text-emerald-700 dark:text-emerald-400";
        if (rate >= 50)   return "bg-blue-500/20 text-blue-700 dark:text-blue-400";
        if (rate >= 30)   return "bg-amber-500/20 text-amber-700 dark:text-amber-400";
        return "bg-red-500/20 text-red-700 dark:text-red-400";
    }
}
