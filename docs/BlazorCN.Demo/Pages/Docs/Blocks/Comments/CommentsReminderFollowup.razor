@* ============================================================
   Block: comments-reminder-followup
   Title: CommentsReminderFollowup
   Description: Set reminders on comments for React and Next.js with due date tracking, notification scheduling, and followup management built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-reminder-followup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Comment Reminders</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @if (_overdueCount > 0)
                        {
                            @($"{_overdueCount} overdue · ")
                        }
                        @if (_todayCount > 0)
                        {
                            @($"{_todayCount} due today · ")
                        }
                        @(_reminders.Length) total
                    </p>
                </div>
                @if (_overdueCount > 0 || _todayCount > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-red-500/10 text-red-600 dark:text-red-400">
                        @(_overdueCount + _todayCount) need attention
                    </BadgeCn>
                }
            </div>
        </div>

        @* Filter bar *@
        <div class="border-b bg-muted/30 px-4 py-2.5">
            <div class="flex flex-wrap items-center gap-1.5">
                <ButtonCn Variant="@(_filter == "all" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-7 px-2.5 text-xs"
                          OnClick="@(() => _filter = "all")">
                    All
                </ButtonCn>
                <ButtonCn Variant="@(_filter == "overdue" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-7 px-2.5 text-xs"
                          OnClick="@(() => _filter = "overdue")">
                    Overdue
                </ButtonCn>
                <ButtonCn Variant="@(_filter == "upcoming" ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-7 px-2.5 text-xs"
                          OnClick="@(() => _filter = "upcoming")">
                    Upcoming
                </ButtonCn>
            </div>
        </div>

        @* Reminder list *@
        <div>
            @{
                var filtered = FilteredReminders();
            }
            @foreach (var reminder in filtered)
            {
                var rem = reminder;
                var isLast = rem.Id == filtered[filtered.Length - 1].Id;
                var initials = GetInitials(rem.Author);
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex gap-3">
                            <AvatarCn Class="size-8 shrink-0">
                                <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@rem.Author</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary"
                                             Class="@Cn.Merge("text-xs font-normal", StatusColor(rem.Status))">
                                        @StatusLabel(rem.Status)
                                    </BadgeCn>
                                </div>
                                <p class="mt-1 text-sm leading-relaxed">@rem.Content</p>
                                <div class="mt-2 flex items-center gap-2">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="text-xs text-muted-foreground">Due @rem.DueDate</span>
                                </div>
                                <div class="mt-2 flex flex-wrap gap-2">
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                                        Complete
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                        <LucideIconCn Name="snowflake" Size="12" Class="size-3" />
                                        Snooze
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2 text-xs">
                                        View comment
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (FilteredReminders().Length == 0)
        {
            <div class="px-4 py-8 text-center text-sm text-muted-foreground">
                No reminders to show
            </div>
        }

        @* Add reminder footer *@
        <div class="border-t p-4">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <InputCn Type="date"
                         @bind-Value="_reminderDate"
                         Placeholder="Set new reminder..."
                         Class="h-8 text-sm" />
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 shrink-0 text-xs">
                    Add reminder
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _reminderDate = "";
    private string _filter = "all";

    private record Reminder(string Id, string CommentId, string Author, string Content, string DueDate, string Status);

    private static readonly Reminder[] _reminders =
    [
        new("1", "c1", "Sarah Chen",   "Follow up on design review feedback from stakeholders",         "Apr 3, 2026",  "overdue"),
        new("2", "c2", "Alex Morgan",  "Check if accessibility fixes have been deployed to production", "Apr 4, 2026",  "today"),
        new("3", "c3", "Maya Patel",   "Review updated wireframes and provide final approval",          "Apr 5, 2026",  "upcoming"),
        new("4", "c4", "Chris Taylor", "Schedule kickoff meeting for Q2 projects",                     "Apr 8, 2026",  "upcoming"),
    ];

    private int _overdueCount => _reminders.Count(r => r.Status == "overdue");
    private int _todayCount   => _reminders.Count(r => r.Status == "today");

    private Reminder[] FilteredReminders() => _filter switch
    {
        "overdue"  => _reminders.Where(r => r.Status == "overdue").ToArray(),
        "upcoming" => _reminders.Where(r => r.Status == "upcoming" || r.Status == "today").ToArray(),
        _          => _reminders,
    };

    private static string StatusColor(string status) => status switch
    {
        "upcoming"  => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "today"     => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "overdue"   => "bg-red-500/10 text-red-600 dark:text-red-400",
        "completed" => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        _           => "",
    };

    private static string StatusLabel(string status) => status switch
    {
        "overdue"   => "Overdue",
        "today"     => "Due today",
        "upcoming"  => "Upcoming",
        "completed" => "Completed",
        _           => status,
    };

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Select(p => p[0])).ToUpper();
    }
}
