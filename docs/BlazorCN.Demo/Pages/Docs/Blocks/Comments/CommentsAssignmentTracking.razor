@* ============================================================
   Block: comments-assignment-tracking
   Title: CommentsAssignmentTracking
   Description: React comment block for Next.js with team member assignment, workload tracking, and due date management built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-assignment-tracking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Team assignments</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_unassignedCount unassigned · @_activeCount active
                    </p>
                </div>
            </div>
        </div>

        @* Team workload *@
        <div class="border-b p-4">
            <div class="mb-2.5 text-xs font-medium text-muted-foreground">Team workload</div>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var member in _teamMembers)
                {
                    var mem = member;
                    var initials = GetInitials(mem.Name);
                    var isHeavy = mem.ActiveAssignments >= 5;
                    <button type="button"
                            @onclick="@(() => ToggleMember(mem.Id))"
                            class="@Cn.Merge("flex items-center gap-2 rounded-md border px-3 py-2 text-left transition-colors hover:bg-muted/50", _selectedMember == mem.Id ? "border-foreground bg-muted/50" : "")">
                        <AvatarCn Class="size-6 shrink-0">
                            <AvatarImageCn Src="@mem.Avatar" Alt="@mem.Name" />
                            <AvatarFallbackCn Class="text-[10px]">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <span class="block truncate text-xs font-medium">@mem.Name</span>
                            <span class="@(isHeavy ? "text-[10px] text-red-600 dark:text-red-400" : "text-[10px] text-muted-foreground")">
                                @mem.ActiveAssignments active
                            </span>
                        </div>
                    </button>
                }
            </div>
        </div>

        @* Comments *@
        <div>
            @for (var i = 0; i < _comments.Length; i++)
            {
                var comment = _comments[i];
                var isLast = i == _comments.Length - 1;
                var isFiltered = _selectedMember != null && (comment.Assignee == null || comment.Assignee.Id != _selectedMember);
                if (!isFiltered)
                {
                    <div class="@(isLast ? "p-4" : "border-b p-4")">
                        <div class="flex items-start gap-3">
                            <span class="@($"mt-1 size-1.5 shrink-0 rounded-full {GetPriorityDot(comment.Priority)}")"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-baseline gap-2">
                                    <span class="text-sm font-medium">@comment.Author</span>
                                    <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                                </div>
                                <p class="mt-1 text-sm leading-relaxed">@comment.Content</p>
                                <div class="mt-2.5 flex flex-wrap items-center gap-2">
                                    @if (comment.Assignee != null)
                                    {
                                        <div class="flex items-center gap-1.5">
                                            <AvatarCn Class="size-4">
                                                <AvatarImageCn Src="@comment.Assignee.Avatar" Alt="@comment.Assignee.Name" />
                                                <AvatarFallbackCn Class="text-[8px]">@GetInitials(comment.Assignee.Name)</AvatarFallbackCn>
                                            </AvatarCn>
                                            <span class="text-xs text-muted-foreground">@comment.Assignee.Name</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                            <LucideIconCn Name="user" Size="12" Class="size-3" />
                                            <span>Unassigned</span>
                                        </div>
                                    }
                                    @if (comment.DueDate != null)
                                    {
                                        <span class="text-xs text-muted-foreground">·</span>
                                        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                            <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                            <span>@comment.DueDate</span>
                                        </div>
                                    }
                                    <span class="text-xs text-muted-foreground">·</span>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="@($"text-[10px] font-normal {GetStatusColor(comment.Status)}")">
                                        @(comment.Status == "in-progress" ? "In progress" : comment.Status)
                                    </BadgeCn>
                                </div>
                                @if (comment.Status == "unassigned")
                                {
                                    <div class="mt-2.5">
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                            <LucideIconCn Name="user" Size="12" Class="size-3" />
                                            Assign
                                        </ButtonCn>
                                    </div>
                                }
                            </div>
                            @if (comment.Status == "in-progress")
                            {
                                <LucideIconCn Name="clock" Size="16" Class="size-4 shrink-0 text-amber-500" />
                            }
                            @if (comment.Status == "completed")
                            {
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                            }
                        </div>
                    </div>
                }
            }
        </div>

    </div>
</section>

@code {
    private record TeamMember(string Id, string Name, string Avatar, int ActiveAssignments);

    private record Comment(
        string Id,
        string Author,
        string Content,
        string Timestamp,
        string Status,
        string Priority,
        TeamMember? Assignee = null,
        string? DueDate = null
    );

    private static readonly TeamMember[] _teamMembers =
    [
        new("1", "Alex Morgan", "", 3),
        new("2", "Maya Patel", "", 5),
        new("3", "Chris Taylor", "", 2),
        new("4", "Jordan Lee", "", 4),
    ];

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen",
            "The mobile app crashes when uploading images larger than 5MB. This is affecting multiple users.",
            "30 min ago", "in-progress", "high",
            Assignee: new("1", "Alex Morgan", "", 3),
            DueDate: "Today"),
        new("2", "James Wilson",
            "Can we add dark mode support to the settings panel? Several users have requested this feature.",
            "1 hour ago", "assigned", "medium",
            Assignee: new("2", "Maya Patel", "", 5),
            DueDate: "Apr 10"),
        new("3", "Emma Davis",
            "The analytics dashboard shows incorrect data for last week. Need to investigate the aggregation logic.",
            "2 hours ago", "unassigned", "high"),
    ];

    private string? _selectedMember = null;

    private int _unassignedCount => _comments.Count(c => c.Status == "unassigned");
    private int _activeCount => _comments.Count(c => c.Status == "assigned" || c.Status == "in-progress");

    private void ToggleMember(string id)
    {
        _selectedMember = _selectedMember == id ? null : id;
    }

    private static string GetInitials(string name)
    {
        return string.Concat(name.Split(' ').Select(n => n[0])).ToUpper();
    }

    private static string GetStatusColor(string status) => status switch
    {
        "unassigned" => "text-muted-foreground",
        "assigned" => "text-blue-600 dark:text-blue-400",
        "in-progress" => "text-amber-600 dark:text-amber-400",
        "completed" => "text-emerald-600 dark:text-emerald-400",
        _ => ""
    };

    private static string GetPriorityDot(string priority) => priority switch
    {
        "high" => "bg-red-500",
        "medium" => "bg-amber-500",
        "low" => "bg-blue-500",
        _ => ""
    };
}
