@* ============================================================
   Block: comments-thread-splitting
   Title: CommentsThreadSplitting
   Description: React comment block for Next.js with thread splitting, conversation branching, and topic reorganization built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-thread-splitting.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Select comments to split</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_selectedComments.Count of @_allComments.Count selected
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 text-[10px] font-normal">
                    <LucideIconCn Name="scissors" Size="10" Class="size-2.5" />
                    Split mode
                </BadgeCn>
            </div>
        </div>

        @* Info banner + root comment *@
        <div class="border-b p-4">
            <div class="mb-3 flex items-center gap-2 rounded-md bg-blue-500/10 px-3 py-2">
                <LucideIconCn Name="git-branch" Size="14" Class="size-3.5 text-blue-600 dark:text-blue-400" />
                <span class="text-xs text-blue-600 dark:text-blue-400">
                    Split off-topic comments into a new thread
                </span>
            </div>
            <label class="flex cursor-pointer items-start gap-3 rounded-md border p-3 transition-colors hover:bg-muted/50">
                <CheckboxCn Checked="@_selectedComments.Contains(_thread.Id)" CheckedChanged="@((bool _) => ToggleComment(_thread.Id))" />
                <div class="min-w-0 flex-1">
                    <div class="flex items-baseline gap-2">
                        <span class="text-sm font-medium">@_thread.Author</span>
                        <span class="text-xs text-muted-foreground">@_thread.Timestamp</span>
                    </div>
                    <p class="mt-1 text-sm leading-relaxed">@_thread.Content</p>
                </div>
            </label>
        </div>

        @* Replies label *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Replies</span>
        </div>

        @* Reply list *@
        <div>
            @foreach (var reply in _thread.Replies)
            {
                var r = reply;
                var replyIndex = _thread.Replies.IndexOf(r);
                var isLast = replyIndex == _thread.Replies.Count - 1 && r.Replies.Count == 0;
                var isSelected = _selectedComments.Contains(r.Id);
                <div>
                    <div class="@(isLast ? "" : "border-b")">
                        <label class="@Cn.Merge("flex cursor-pointer items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isSelected ? "bg-muted/30" : "")">
                            <CheckboxCn Checked="@isSelected" CheckedChanged="@((bool _) => ToggleComment(r.Id))" />
                            <div class="min-w-0 flex-1">
                                <div class="flex items-baseline gap-2">
                                    <span class="text-sm font-medium">@r.Author</span>
                                    <span class="text-xs text-muted-foreground">@r.Timestamp</span>
                                </div>
                                <p class="mt-1 text-sm leading-relaxed">@r.Content</p>
                            </div>
                        </label>
                    </div>

                    @if (r.Replies.Count > 0)
                    {
                        <div class="border-b pl-12">
                            @foreach (var nestedReply in r.Replies)
                            {
                                var nr = nestedReply;
                                var nestedIndex = r.Replies.IndexOf(nr);
                                var isNestedLast = nestedIndex == r.Replies.Count - 1;
                                var isNestedSelected = _selectedComments.Contains(nr.Id);
                                <label class="@Cn.Merge("flex cursor-pointer items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isNestedSelected ? "bg-muted/30" : "", isNestedLast ? "" : "border-b")">
                                    <CheckboxCn Checked="@isNestedSelected" CheckedChanged="@((bool _) => ToggleComment(nr.Id))" />
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-baseline gap-2">
                                            <span class="text-sm font-medium">@nr.Author</span>
                                            <span class="text-xs text-muted-foreground">@nr.Timestamp</span>
                                        </div>
                                        <p class="mt-1 text-sm leading-relaxed">@nr.Content</p>
                                    </div>
                                </label>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer: split button or split form *@
        @if (!_showSplitForm)
        {
            <div class="border-t px-4 py-3">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full gap-1 text-xs" OnClick="@(() => _showSplitForm = true)" Disabled="@(_selectedComments.Count == 0)">
                    <LucideIconCn Name="scissors" Size="12" Class="size-3" />
                    Split selected comments into new thread
                </ButtonCn>
            </div>
        }
        else
        {
            <div class="border-t p-4">
                <div class="mb-2 text-xs font-medium text-muted-foreground">New thread title</div>
                <InputCn @bind-Value="_newThreadTitle" Placeholder="Enter a descriptive title..." Class="mb-3 h-8 text-sm" />
                <div class="flex gap-2">
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 gap-1 text-xs" OnClick="HandleSplit">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        Create thread
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs" OnClick="@(() => _showSplitForm = false)">
                        Cancel
                    </ButtonCn>
                </div>
            </div>
        }

    </div>
</section>

@code {
    private record CommentItem(string Id, string Author, string Content, string Timestamp, List<CommentItem> Replies);

    private static readonly CommentItem _thread = new(
        "1", "Sarah Chen",
        "We should migrate to TypeScript for better type safety across the codebase.",
        "2 hours ago",
        [
            new("1-1", "Alex Morgan",
                "Agreed! The migration could start with the API layer.",
                "1 hour ago", []),
            new("1-2", "Maya Patel",
                "Speaking of migrations, has anyone tested the new database schema on staging? I'm seeing performance issues.",
                "1 hour ago",
                [
                    new("1-2-1", "Chris Taylor",
                        "I noticed the same thing. Query times are 3x slower with the new indexes.",
                        "45 min ago", []),
                    new("1-2-2", "Jordan Lee",
                        "Should we roll back or optimize? The indexing strategy might need revision.",
                        "30 min ago", []),
                ]),
        ]
    );

    private List<string> _selectedComments = ["1-2", "1-2-1", "1-2-2"];
    private bool _showSplitForm = false;
    private string _newThreadTitle = "Database performance issues on staging";

    private static List<CommentItem> FlattenComments(CommentItem comment)
    {
        var result = new List<CommentItem> { comment };
        foreach (var reply in comment.Replies)
            result.AddRange(FlattenComments(reply));
        return result;
    }

    private static readonly List<CommentItem> _allComments = FlattenComments(_thread);

    private void ToggleComment(string id)
    {
        if (_selectedComments.Contains(id))
            _selectedComments.Remove(id);
        else
            _selectedComments.Add(id);
    }

    private void HandleSplit()
    {
        _showSplitForm = false;
    }
}
