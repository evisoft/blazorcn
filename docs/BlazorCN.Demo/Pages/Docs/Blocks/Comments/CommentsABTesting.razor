@* ============================================================
   Block: comments-a-b-testing
   Title: CommentsABTesting
   Description: A comment UI variant testing system for React and Next.js with experiment configuration, traffic allocation, performance metrics, and statistical significance built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-a-b-testing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">@_experiment.Name</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">Started @_experiment.StartDate</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Outline" Class="border-emerald-500/20 bg-emerald-500/10 text-xs font-normal text-emerald-700 dark:text-emerald-400">
                    Running
                </BadgeCn>
            </div>
        </div>

        @* Stats row *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <div class="mb-1 flex items-center gap-1.5">
                    <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground/60" />
                    <span class="text-xs text-muted-foreground">Total users</span>
                </div>
                <div class="text-2xl font-semibold tabular-nums">@_totalUsers</div>
            </div>
            <div class="border-r px-4 py-3">
                <div class="mb-1 flex items-center gap-1.5">
                    <LucideIconCn Name="beaker" Size="14" Class="size-3.5 text-muted-foreground/60" />
                    <span class="text-xs text-muted-foreground">Variants</span>
                </div>
                <div class="text-2xl font-semibold tabular-nums">@_experiment.Variants.Length</div>
            </div>
            <div class="px-4 py-3">
                <div class="mb-1 flex items-center gap-1.5">
                    <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground/60" />
                    <span class="text-xs text-muted-foreground">Leading</span>
                </div>
                <div class="text-lg font-semibold">@_winningVariant.Name</div>
            </div>
        </div>

        @* Variants *@
        <div>
            @for (var i = 0; i < _experiment.Variants.Length; i++)
            {
                var variant = _experiment.Variants[i];
                var isLast = i == _experiment.Variants.Length - 1;
                var isWinning = variant.Id == _winningVariant.Id && !variant.IsControl;
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="mb-2 flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@variant.Name</span>
                                @if (variant.IsControl)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs font-normal">
                                        Control
                                    </BadgeCn>
                                }
                                @if (isWinning)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="border-emerald-500/20 bg-emerald-500/10 text-xs font-normal text-emerald-700 dark:text-emerald-400">
                                        Winner
                                    </BadgeCn>
                                }
                            </div>
                            <span class="text-xs text-muted-foreground">
                                @variant.Traffic% traffic
                            </span>
                        </div>
                        <p class="mb-3 text-xs text-muted-foreground">@variant.Description</p>
                        <div class="grid grid-cols-3 gap-4">
                            <div>
                                <span class="text-xs text-muted-foreground">Engagement</span>
                                <div class="mt-0.5 text-sm font-semibold tabular-nums">@variant.EngagementRate%</div>
                            </div>
                            <div>
                                <span class="text-xs text-muted-foreground">Reply rate</span>
                                <div class="mt-0.5 text-sm font-semibold tabular-nums">@variant.ReplyRate%</div>
                            </div>
                            <div>
                                <span class="text-xs text-muted-foreground">Avg time</span>
                                <div class="mt-0.5 text-sm font-semibold tabular-nums">@variant.AvgTimeOnPage</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Statistical significance *@
        <div class="border-t px-4 py-3">
            <span class="mb-3 block text-xs font-medium text-muted-foreground">
                Statistical significance
            </span>
            <div class="space-y-2">
                @foreach (var metric in _metrics)
                {
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="bar-chart" Size="14" Class="size-3.5 text-muted-foreground/60" />
                            <span class="text-sm">@metric.Label</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <div class="flex items-center gap-1">
                                <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                                <span class="text-xs text-emerald-600 dark:text-emerald-400">
                                    +@metric.Improvement%
                                </span>
                            </div>
                            @if (metric.Significant)
                            {
                                <BadgeCn Variant="BadgeVariant.Outline" Class="border-emerald-500/20 bg-emerald-500/10 text-xs font-normal text-emerald-700 dark:text-emerald-400">
                                    95% conf.
                                </BadgeCn>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div class="border-t px-4 py-3">
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1 text-xs">
                    Pause test
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="flex-1 text-xs">
                    Declare winner
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>Running for 20 days</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>Updated 5 min ago</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record Variant(
        string Id,
        string Name,
        string Description,
        int Traffic,
        int Users,
        double EngagementRate,
        double ReplyRate,
        string AvgTimeOnPage,
        bool IsControl
    );

    private record Experiment(
        string Id,
        string Name,
        string Status,
        string StartDate,
        Variant[] Variants
    );

    private record Metric(string Label, double Control, double VariantValue, double Improvement, bool Significant);

    private static readonly Experiment _experiment = new(
        Id: "1",
        Name: "Reply UI Layout",
        Status: "running",
        StartDate: "Mar 15, 2026",
        Variants:
        [
            new Variant("control", "Control", "Inline reply form below comment", 50, 1247, 12.4, 8.2, "2m 34s", true),
            new Variant("variant-a", "Variant A", "Modal dialog reply form", 50, 1289, 14.8, 10.1, "2m 48s", false),
        ]
    );

    private static readonly Metric[] _metrics =
    [
        new("Engagement rate", 12.4, 14.8, 19.4, true),
        new("Reply rate", 8.2, 10.1, 23.2, true),
    ];

    private int _totalUsers = _experiment.Variants.Sum(v => v.Users);
    private Variant _winningVariant = _experiment.Variants.MaxBy(v => v.EngagementRate)!;
}
