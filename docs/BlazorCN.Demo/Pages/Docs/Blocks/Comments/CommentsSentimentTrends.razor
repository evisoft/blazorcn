@* ============================================================
   Block: comments-sentiment-trends
   Title: CommentsSentimentTrends
   Description: A sentiment analysis trend dashboard for React and Next.js with emotion distribution, time-series sentiment graphs, polarity scores, and mood indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-sentiment-trends.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Sentiment Analysis</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Last 7 days</p>
        </div>

        @* Overall sentiment score *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Overall sentiment</span>
                <BadgeCn Variant="BadgeVariant.Outline" Class="border-emerald-500/20 bg-emerald-500/10 text-xs font-normal text-emerald-700 dark:text-emerald-400">
                    Positive
                </BadgeCn>
            </div>
            <div class="flex items-baseline gap-2">
                <span class="text-2xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                    @_overallScore.ToString("F2")
                </span>
                <span class="text-xs text-muted-foreground">polarity score</span>
            </div>
            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted">
                <div class="h-full bg-emerald-500" style="@($"width:{((_overallScore + 1) / 2) * 100:F1}%")"></div>
            </div>
            <div class="mt-1 flex justify-between text-[10px] text-muted-foreground">
                <span>Negative</span>
                <span>Neutral</span>
                <span>Positive</span>
            </div>
        </div>

        @* Breakdown rows *@
        <div class="border-b">
            @foreach (var item in _breakdown)
            {
                var isLast = item == _breakdown[_breakdown.Length - 1];
                <div class="@(isLast ? "px-4 py-3" : "border-b px-4 py-3")">
                    <div class="flex items-center gap-3">
                        <div class="@Cn.Merge("rounded-lg p-2", item.BgColor)">
                            <LucideIconCn Name="@item.IconName" Size="16" Class="@Cn.Merge("size-4", item.Color)" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium capitalize">@item.Category</span>
                                <span class="text-xs text-muted-foreground">@item.Percentage%</span>
                            </div>
                            <p class="text-xs text-muted-foreground">@item.Count comments</p>
                        </div>
                        <div class="flex items-center gap-1">
                            @if (item.Change > 0)
                            {
                                <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                                <span class="text-xs text-emerald-600 dark:text-emerald-400">@item.Change%</span>
                            }
                            else
                            {
                                <LucideIconCn Name="trending-down" Size="12" Class="size-3 text-red-500" />
                                <span class="text-xs text-red-600 dark:text-red-400">@(Math.Abs(item.Change))%</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Sentiment trend chart *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Sentiment trend</span>
                <div class="flex items-center gap-2">
                    <div class="flex items-center gap-1">
                        <span class="size-2 rounded-full bg-emerald-500"></span>
                        <span class="text-[10px] text-muted-foreground">Positive</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <span class="size-2 rounded-full bg-blue-500"></span>
                        <span class="text-[10px] text-muted-foreground">Neutral</span>
                    </div>
                    <div class="flex items-center gap-1">
                        <span class="size-2 rounded-full bg-red-500"></span>
                        <span class="text-[10px] text-muted-foreground">Negative</span>
                    </div>
                </div>
            </div>
            <div class="flex items-end justify-between gap-2" style="height:100px">
                @foreach (var item in _trendData)
                {
                    <div class="flex flex-1 flex-col items-center gap-2">
                        <div class="relative flex w-full flex-col gap-0.5">
                            <div class="w-full rounded-t-sm bg-emerald-500" style="@($"height:{item.Positive}%;min-height:4px")"></div>
                            <div class="w-full bg-blue-500" style="@($"height:{item.Neutral}%;min-height:4px")"></div>
                            <div class="w-full bg-red-500" style="@($"height:{item.Negative}%;min-height:4px")"></div>
                        </div>
                        <span class="text-[10px] text-muted-foreground">@item.Day</span>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>1,247 analyzed</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>Updated 10 min ago</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record BreakdownItem(string Category, int Count, int Percentage, double Change, string IconName, string Color, string BgColor);

    private record TrendItem(string Day, int Positive, int Neutral, int Negative);

    private static readonly double _overallScore = 0.56;

    private static readonly BreakdownItem[] _breakdown =
    [
        new("positive", 847, 68,  5.2, "smile",  "text-emerald-600 dark:text-emerald-400", "bg-emerald-500/10"),
        new("neutral",  245, 20, -1.8, "meh",    "text-blue-600 dark:text-blue-400",       "bg-blue-500/10"),
        new("negative", 155, 12, -3.4, "frown",  "text-red-600 dark:text-red-400",         "bg-red-500/10"),
    ];

    private static readonly TrendItem[] _trendData =
    [
        new("Mon", 65, 22, 13),
        new("Tue", 70, 18, 12),
        new("Wed", 62, 25, 13),
        new("Thu", 68, 20, 12),
        new("Fri", 72, 16, 12),
        new("Sat", 67, 21, 12),
        new("Sun", 68, 20, 12),
    ];
}
