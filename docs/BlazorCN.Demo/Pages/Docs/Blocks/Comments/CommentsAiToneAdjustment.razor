@* ============================================================
   Block: comments-ai-tone-adjustment
   Title: CommentsAiToneAdjustment
   Description: React comment block for Next.js with AI-powered tone rewriting, sentiment analysis, and style transformations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-ai-tone-adjustment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Add comment</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">AI tone adjustment enabled</p>
                </div>
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                        Current: @_currentTone
                    </BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal">
                        @_sentiment
                    </BadgeCn>
                </div>
            </div>
        </div>

        @* Textarea section *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_comment" Placeholder="Write your comment..." Class="min-h-[100px]" />
            <div class="mt-2 flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                    <span>Analyzing tone and sentiment</span>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

        @* Tone selector *@
        <div class="border-b px-4 py-3">
            <div class="mb-2.5 flex items-center gap-2">
                <span class="text-xs font-medium text-muted-foreground">Adjust tone</span>
            </div>
            <div class="flex flex-wrap gap-2">
                @foreach (var opt in _toneOptions)
                {
                    var option = opt;
                    <ButtonCn Variant="@(_selectedTone == option.Value ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="h-7 text-xs"
                              OnClick="@(() => GenerateTone(option.Value))"
                              Disabled="@_generating">
                        @option.Label
                    </ButtonCn>
                }
            </div>
        </div>

        @* Generating indicator *@
        @if (_generating)
        {
            <div class="overflow-hidden border-b px-4 py-4">
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="refresh-cw" Size="12" Class="size-3 animate-spin" />
                    <span>Generating @_selectedTone version...</span>
                </div>
            </div>
        }

        @* Preview section *@
        @if (_preview != null && !_generating)
        {
            <div class="overflow-hidden border-b">
                <div class="px-4 py-3">
                    <div class="mb-2 flex items-center justify-between">
                        <span class="text-xs font-medium text-muted-foreground">
                            @GetSelectedToneLabel() version
                        </span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                            Preview
                        </BadgeCn>
                    </div>
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-sm leading-relaxed">@_preview</p>
                    </div>
                    <div class="mt-3 flex gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 gap-1 text-xs"
                                  OnClick="ApplyRewrite">
                            Apply rewrite
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 text-xs"
                                  OnClick="CancelPreview">
                            Cancel
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

        @* Footer hint *@
        @if (_preview == null && !_generating)
        {
            <div class="px-4 py-3">
                <p class="text-xs text-muted-foreground">
                    Select a tone style above to generate an AI-rewritten version of your comment.
                </p>
            </div>
        }

    </div>
</section>

@code {
    private record ToneOption(string Value, string Label, string Description);

    private static readonly ToneOption[] _toneOptions =
    [
        new("professional", "Professional", "Polished and business-appropriate"),
        new("friendly",     "Friendly",     "Warm and conversational"),
        new("concise",      "Concise",      "Brief and to the point"),
        new("formal",       "Formal",       "Respectful and traditional"),
    ];

    private static readonly Dictionary<string, string> _toneRewrites = new()
    {
        ["professional"] = "I appreciate your feedback. The implementation approach you've outlined demonstrates strong technical understanding. I'd like to explore the performance implications further before proceeding.",
        ["friendly"]     = "Thanks for sharing your thoughts! I really like your approach and it shows you've put a lot of thought into this. Let's chat more about how it might affect performance before we move forward.",
        ["concise"]      = "Good feedback. Strong technical approach. Need to assess performance impact before implementation.",
        ["formal"]       = "I would like to express my appreciation for your constructive feedback. The implementation methodology you have presented exhibits considerable technical merit. I propose we conduct a thorough performance analysis prior to proceeding with this approach.",
    };

    private string _comment      = "Thanks for the feedback! Your implementation looks good but we need to check performance first.";
    private string? _selectedTone = null;
    private string? _preview      = null;
    private bool    _generating   = false;

    private readonly string _sentiment   = "neutral";
    private readonly string _currentTone = "friendly";

    private async Task GenerateTone(string tone)
    {
        _selectedTone = tone;
        _generating   = true;
        StateHasChanged();
        await Task.Delay(800);
        _preview    = _toneRewrites[tone];
        _generating = false;
    }

    private void ApplyRewrite()
    {
        if (_preview != null)
        {
            _comment      = _preview;
            _preview      = null;
            _selectedTone = null;
        }
    }

    private void CancelPreview()
    {
        _preview      = null;
        _selectedTone = null;
    }

    private string GetSelectedToneLabel()
    {
        if (_selectedTone == null) return "";
        var opt = Array.Find(_toneOptions, t => t.Value == _selectedTone);
        return opt?.Label ?? "";
    }
}
