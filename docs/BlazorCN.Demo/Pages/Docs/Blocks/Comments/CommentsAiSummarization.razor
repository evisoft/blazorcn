@* ============================================================
   Block: comments-ai-summarization
   Title: CommentsAiSummarization
   Description: An AI-powered comment summarization system for React and Next.js with thread summaries, key points extraction, participant count, and topic highlights built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-ai-summarization.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Discussion Thread</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length @(_comments.Length == 1 ? "comment" : "comments")
            </p>
        </div>

        @* AI Summary panel *@
        @if (_showSummary)
        {
            <div class="overflow-hidden border-b bg-blue-500/5">
                <div class="p-4">
                    <div class="mb-3 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-blue-600 dark:text-blue-400" />
                            <span class="text-sm font-medium">AI Summary</span>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" OnClick="@(() => _showSummary = false)">
                            Hide
                        </ButtonCn>
                    </div>

                    <div class="mb-3 space-y-2">
                        @foreach (var point in _summary.KeyPoints)
                        {
                            <div class="flex gap-2">
                                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                                <p class="text-sm leading-relaxed">@point</p>
                            </div>
                        }
                    </div>

                    <div class="flex items-center gap-3">
                        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                            <LucideIconCn Name="users" Size="12" Class="size-3" />
                            @_summary.Participants participants
                        </div>
                        <div class="flex items-center gap-1.5">
                            @foreach (var topic in _summary.MainTopics)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                    @topic
                                </BadgeCn>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Thread toggle *@
        <div>
            <button type="button"
                    @onclick="@(() => _showFullThread = !_showFullThread)"
                    class="flex w-full items-center justify-between border-b px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                <span class="text-xs font-medium text-muted-foreground">
                    @(_showFullThread ? "Hide" : "Show") full discussion
                </span>
                <LucideIconCn Name="chevron-down" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground transition-transform", _showFullThread ? "rotate-180" : "")" />
            </button>

            @* Full thread *@
            @if (_showFullThread)
            {
                <div class="overflow-hidden">
                    <div class="divide-y">
                        @foreach (var comment in _comments)
                        {
                            var initials = GetInitials(comment.Author);
                            <div class="p-4">
                                <div class="flex gap-3">
                                    <AvatarCn Class="size-8 shrink-0">
                                        <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                                    </AvatarCn>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-baseline gap-2">
                                            <span class="text-sm font-medium">@comment.Author</span>
                                            <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                                        </div>
                                        <p class="mt-1 text-sm leading-relaxed">@comment.Content</p>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Show AI Summary button (when hidden) *@
        @if (!_showSummary)
        {
            <div class="border-t px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 w-full gap-1 text-xs" OnClick="@(() => _showSummary = true)">
                    <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                    Show AI summary
                </ButtonCn>
            </div>
        }

    </div>
</section>

@code {
    private record Comment(string Id, string Author, string Content, string Timestamp);

    private record ThreadSummary(string[] KeyPoints, int Participants, string[] MainTopics);

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen",
            "We should migrate to the new database schema before the Q2 launch. The performance improvements will be significant for our users.",
            "2 hours ago"),
        new("2", "Alex Morgan",
            "Agreed, but we need to ensure backward compatibility. I've seen similar migrations cause issues with older clients.",
            "2 hours ago"),
        new("3", "Maya Patel",
            "I can help with the migration script. We should also plan for a rollback strategy in case anything goes wrong.",
            "1 hour ago"),
        new("4", "James Wilson",
            "What's the timeline looking like? We have feature freeze in 3 weeks, so we need to start soon.",
            "1 hour ago"),
        new("5", "Sarah Chen",
            "I think 2 weeks is realistic if we start this sprint. Maya's rollback point is crucial.",
            "45 min ago"),
    ];

    private static readonly ThreadSummary _summary = new(
        KeyPoints:
        [
            "Team agrees to migrate database schema before Q2 launch for performance improvements",
            "Backward compatibility and rollback strategy identified as critical requirements",
            "Proposed timeline: 2 weeks starting this sprint, before feature freeze in 3 weeks",
            "Maya volunteered to help with migration script development",
        ],
        Participants: 4,
        MainTopics: ["Database Migration", "Q2 Launch", "Performance", "Rollback Strategy"]
    );

    private bool _showSummary = true;
    private bool _showFullThread = false;

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Select(p => p[0])).ToUpper();
    }
}
