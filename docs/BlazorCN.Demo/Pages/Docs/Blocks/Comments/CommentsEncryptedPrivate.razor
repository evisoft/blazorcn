@* ============================================================
   Block: comments-encrypted-private
   Title: CommentsEncryptedPrivate
   Description: An end-to-end encrypted comment system for React and Next.js with private messaging, encryption indicators, and secure sharing built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-encrypted-private.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <div class="flex items-center gap-2">
                        <h2 class="text-sm font-medium">Private Thread</h2>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 gap-0.5 px-1.5 text-[10px] font-normal">
                            <LucideIconCn Name="lock" Size="10" Class="size-2.5" />
                            Encrypted
                        </BadgeCn>
                    </div>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_comments.Length messages · @_allParticipants.Length participants
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="@(() => _showParticipants = !_showParticipants)">
                    <LucideIconCn Name="user-plus" Size="12" Class="size-3" />
                    Invite
                </ButtonCn>
            </div>
        </div>

        @* Encryption notice *@
        <div class="border-b bg-emerald-500/10 px-4 py-2.5">
            <div class="flex items-start gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="mt-0.5 size-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
                <div class="min-w-0 flex-1">
                    <p class="text-xs leading-relaxed text-emerald-700 dark:text-emerald-400">
                        End-to-end encrypted. Only participants can read these messages. Your encryption
                        keys are stored locally and never sent to the server.
                    </p>
                </div>
            </div>
        </div>

        @* Participants panel *@
        @if (_showParticipants)
        {
            <div class="overflow-hidden border-b bg-muted/20 p-4">
                <span class="mb-2 block text-xs font-medium text-muted-foreground">
                    Participants (@_allParticipants.Length)
                </span>
                <div class="space-y-1">
                    @foreach (var participant in _allParticipants)
                    {
                        var p = participant;
                        <div class="flex items-center gap-2 rounded-md bg-background px-3 py-2">
                            <div class="flex size-6 items-center justify-center rounded-full bg-muted">
                                <span class="text-xs font-medium">@GetInitials(p)</span>
                            </div>
                            <span class="text-sm">@p</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto h-4 gap-0.5 px-1.5 text-[10px] font-normal">
                                <LucideIconCn Name="lock" Size="10" Class="size-2.5" />
                                Key shared
                            </BadgeCn>
                        </div>
                    }
                </div>
            </div>
        }

        @* New message input *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_newComment" Placeholder="Write an encrypted message..." Class="min-h-[80px]" aria-label="Write an encrypted message..." />
            <div class="mt-2 flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <LucideIconCn Name="lock" Size="12" Class="size-3" />
                    Messages are encrypted
                </span>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 gap-1 text-xs">
                    <LucideIconCn Name="lock" Size="12" Class="size-3" />
                    Send encrypted
                </ButtonCn>
            </div>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var comment in _comments)
            {
                var c = comment;
                var isAuthor = c.Author == "Sarah Chen";
                <div class="@Cn.Merge("px-4 py-3", isAuthor ? "bg-muted/30" : "")">
                    <div class="flex items-start gap-3">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted">
                            <span class="text-xs font-medium">@GetInitials(c.Author)</span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@c.Author</span>
                                <LucideIconCn Name="lock" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                                <span class="text-xs text-muted-foreground">@c.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                @c.Content
                            </p>
                            <div class="mt-2 flex items-center gap-1">
                                <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                                <span class="text-xs text-emerald-700 dark:text-emerald-400">
                                    Encrypted and verified
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-4 py-2.5 text-xs text-muted-foreground">
            <LucideIconCn Name="lock" Size="12" Class="size-3" />
            <span>End-to-end encrypted · Keys stored locally</span>
        </div>

    </div>
</section>

@code {
    private record CommentData(string Id, string Author, string Content, string Timestamp, bool IsEncrypted, string[] Participants);

    private static readonly CommentData[] _comments =
    [
        new("1", "Sarah Chen", "This is a private encrypted discussion about the upcoming project", "2 hours ago", true, ["Sarah Chen", "James Wilson"]),
        new("2", "James Wilson", "Thanks for the update. I'll review the details securely.", "1 hour ago", true, ["Sarah Chen", "James Wilson"]),
        new("3", "Maya Patel", "Can we add Alex to this private thread?", "30 min ago", true, ["Sarah Chen", "James Wilson", "Maya Patel"]),
    ];

    private static readonly string[] _allParticipants = GetAllParticipants();

    private static string[] GetAllParticipants()
    {
        var seen = new System.Collections.Generic.HashSet<string>();
        var result = new System.Collections.Generic.List<string>();
        foreach (var c in _comments)
        {
            foreach (var p in c.Participants)
            {
                if (seen.Add(p)) result.Add(p);
            }
        }
        return result.ToArray();
    }

    private string _newComment = "";
    private bool _showParticipants = false;

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var initials = "";
        foreach (var part in parts)
        {
            if (part.Length > 0) initials += char.ToUpper(part[0]);
        }
        return initials;
    }
}
