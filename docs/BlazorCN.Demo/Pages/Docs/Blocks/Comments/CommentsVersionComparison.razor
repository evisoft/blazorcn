@* ============================================================
   Block: comments-version-comparison
   Title: CommentsVersionComparison
   Description: Compare comments across document versions in React and Next.js with side-by-side view, version selector, and change highlighting built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-version-comparison.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Version Comparison</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_filteredComments.Length comments · Compare feedback across versions
            </p>
        </div>

        @* Version selector toolbar *@
        <div class="border-b bg-muted/30 px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="flex flex-1 items-center gap-2">
                    <LucideIconCn Name="git-branch" Size="16" Class="size-4 text-muted-foreground" />
                    <button type="button"
                            @onclick="@(() => _showSelector = !_showSelector)"
                            class="flex flex-1 items-center justify-between rounded-md border bg-background px-3 py-1.5 text-sm transition-colors hover:bg-muted/50">
                        <span class="font-medium">@(Array.Find(_versions, v => v.Id == _selectedVersion)?.Number)</span>
                        <LucideIconCn Name="chevron-down" Size="16" Class="size-4 text-muted-foreground" />
                    </button>
                </div>
                @if (_compareVersion != null)
                {
                    <span class="text-xs text-muted-foreground">vs</span>
                    <div class="flex flex-1 items-center gap-2">
                        <button type="button"
                                class="flex flex-1 items-center justify-between rounded-md border bg-background px-3 py-1.5 text-sm transition-colors hover:bg-muted/50">
                            <span class="font-medium">@(Array.Find(_versions, v => v.Id == _compareVersion)?.Number)</span>
                            <LucideIconCn Name="chevron-down" Size="16" Class="size-4 text-muted-foreground" />
                        </button>
                    </div>
                }
            </div>
            <div class="mt-2 flex items-center gap-2">
                <ButtonCn Variant="@(_compareVersion != null ? ButtonVariant.Ghost : ButtonVariant.Secondary)"
                          Size="ButtonSize.Sm"
                          Class="h-7 text-xs"
                          OnClick="@(() => _compareVersion = null)">
                    Single version
                </ButtonCn>
                <ButtonCn Variant="@(_compareVersion != null ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-7 text-xs"
                          OnClick="@(() => _compareVersion = "v2")">
                    Compare versions
                </ButtonCn>
            </div>
        </div>

        @* Comment list *@
        <div>
            @for (var i = 0; i < _filteredComments.Length; i++)
            {
                var comment = _filteredComments[i];
                var isLast = i == _filteredComments.Length - 1;
                var initials = GetInitials(comment.Author);
                var appearsInCurrent = comment.Versions.Contains(_selectedVersion);
                var appearsInCompare = _compareVersion != null && comment.Versions.Contains(_compareVersion);
                var currentVersion = _selectedVersion;
                var compareVersion = _compareVersion;

                <div class="@(isLast ? "p-4" : "border-b p-4")">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"text-xs font-normal {GetStatusColor(comment.Status)}")">
                                    @if (comment.Status == "open")
                                    {
                                        <span>Open</span>
                                    }
                                    @if (comment.Status == "resolved")
                                    {
                                        <LucideIconCn Name="check-circle" Size="12" Class="mr-1 size-3" />
                                        <span>Resolved</span>
                                    }
                                    @if (comment.Status == "carried-over")
                                    {
                                        <span>Carried over</span>
                                    }
                                </BadgeCn>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed">@comment.Content</p>
                            @if (compareVersion != null)
                            {
                                var currentNum = appearsInCurrent ? Array.Find(_versions, v => v.Id == currentVersion)?.Number : null;
                                var compareNum = appearsInCompare ? Array.Find(_versions, v => v.Id == compareVersion)?.Number : null;
                                <div class="mt-2 flex items-center gap-2 text-xs text-muted-foreground">
                                    <span>
                                        Present in:
                                        @if (currentNum != null)
                                        {
                                            @currentNum
                                        }
                                        @if (currentNum != null && compareNum != null)
                                        {
                                            <span>, </span>
                                        }
                                        @if (compareNum != null)
                                        {
                                            @compareNum
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer stats *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-4 text-xs text-muted-foreground">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_comments.Count(c => c.Status == "resolved") resolved
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_comments.Count(c => c.Status == "open") open
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_comments.Count(c => c.Status == "carried-over") carried over
                </span>
            </div>
        </div>

    </div>
</section>

@code {
    private record VersionData(string Id, string Number, string Label, string Date);

    private record CommentData(string Id, string Author, string Content, string Timestamp, string Status, string[] Versions);

    private static readonly VersionData[] _versions =
    [
        new("v3", "v3.0", "Current", "Apr 4, 2026"),
        new("v2", "v2.1", "Previous", "Mar 28, 2026"),
        new("v1", "v2.0", "Initial", "Mar 15, 2026"),
    ];

    private static readonly CommentData[] _comments =
    [
        new("1", "Sarah Chen", "Navigation menu needs better mobile responsiveness", "Mar 15", "resolved", ["v1", "v2"]),
        new("2", "Alex Morgan", "Color contrast on CTA buttons should be increased for accessibility", "Mar 15", "resolved", ["v1", "v2"]),
        new("3", "Maya Patel", "Footer layout breaks on tablet viewport sizes", "Mar 28", "carried-over", ["v2", "v3"]),
        new("4", "Chris Taylor", "Hero section image quality could be improved", "Apr 4", "open", ["v3"]),
    ];

    private static readonly Dictionary<string, string> _statusColors = new()
    {
        ["open"] = "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        ["resolved"] = "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        ["carried-over"] = "bg-amber-500/10 text-amber-600 dark:text-amber-400",
    };

    private string _selectedVersion = "v3";
    private string? _compareVersion = "v2";
    private bool _showSelector = false;

    private CommentData[] _filteredComments =>
        _compareVersion != null
            ? _comments.Where(c => c.Versions.Contains(_selectedVersion) || c.Versions.Contains(_compareVersion)).ToArray()
            : _comments.Where(c => c.Versions.Contains(_selectedVersion)).ToArray();

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var result = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) result += char.ToUpper(p[0]);
        }
        return result;
    }

    private static string GetStatusColor(string status) =>
        _statusColors.TryGetValue(status, out var color) ? color : "";
}
