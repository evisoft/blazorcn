@* ============================================================
   Block: comments-audit-log
   Title: CommentsAuditLog
   Description: A compliance-focused comment audit log for React and Next.js with activity tracking, change history, and exportable reports built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-audit-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Comment Audit Log</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Compliance tracking • @_auditLog.Length events
                    </p>
                </div>
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1.5 text-xs">
                        <LucideIconCn Name="history" Size="12" Class="size-3" />
                        Immutable
                    </BadgeCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="download" Size="12" Class="size-3" />
                        Export
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Column headers *@
        <div class="border-b bg-muted/30 px-4 py-2">
            <div class="grid grid-cols-[1fr_100px_80px_120px] gap-2 text-xs font-medium text-muted-foreground">
                <span>Event</span>
                <span>User</span>
                <span>Action</span>
                <span class="text-right">Timestamp</span>
            </div>
        </div>

        @* Entries *@
        <div>
            @for (int i = 0; i < _auditLog.Length; i++)
            {
                var entry = _auditLog[i];
                var isLast = i == _auditLog.Length - 1;
                var actionCss = GetActionColor(entry.Action);
                var timePart = entry.Timestamp.Contains(' ') ? entry.Timestamp.Split(' ')[1] : entry.Timestamp;
                <div class="@(isLast ? "px-4 py-3" : "border-b px-4 py-3")">
                    <div class="grid grid-cols-[1fr_100px_80px_120px] gap-2">
                        <div class="min-w-0">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="file-text" Size="12" Class="size-3 shrink-0 text-muted-foreground/60" />
                                <span class="truncate font-mono text-xs text-muted-foreground">@entry.CommentId</span>
                            </div>
                            <p class="mt-1 truncate text-sm">@entry.CommentSnippet</p>
                            @if (!string.IsNullOrEmpty(entry.Changes))
                            {
                                <p class="mt-0.5 text-xs text-muted-foreground">@entry.Changes</p>
                            }
                            <p class="mt-0.5 font-mono text-[10px] text-muted-foreground/60">
                                IP: @entry.IpAddress
                            </p>
                        </div>
                        <div class="flex items-start">
                            <span class="truncate text-sm text-muted-foreground">@entry.User</span>
                        </div>
                        <div class="flex items-start">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"text-[10px] font-normal {actionCss}")">
                                @entry.Action
                            </BadgeCn>
                        </div>
                        <div class="flex items-start justify-end">
                            <span class="font-mono text-xs tabular-nums text-muted-foreground">@timePart</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-2 text-xs text-muted-foreground">
                <span>Retention: 7 years</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>Read-only archive</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>SOC2 compliant</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record AuditEntry(string Id, string Timestamp, string User, string Action,
        string CommentId, string CommentSnippet, string IpAddress, string Changes = "");

    private static readonly AuditEntry[] _auditLog =
    [
        new("1", "2026-04-04 14:23:15", "Sarah Chen",   "created",  "c-7f8e", "The Q4 projections look solid...",               "192.168.1.45"),
        new("2", "2026-04-04 14:28:42", "James Wilson", "edited",   "c-7f8e", "The Q4 projections need revision...",             "192.168.1.45", "Content updated"),
        new("3", "2026-04-04 14:35:08", "Maya Patel",   "flagged",  "c-9a2b", "This approach violates our security policy...",   "10.0.0.123",   "Flagged as policy violation"),
        new("4", "2026-04-04 14:42:19", "Admin",        "approved", "c-9a2b", "This approach violates our security policy...",   "10.0.0.100",   "Reviewed and approved"),
        new("5", "2026-04-04 14:55:33", "Chris Taylor", "deleted",  "c-3d4e", "Sharing credentials in plain text...",            "10.0.0.88",    "Security violation - permanently removed"),
        new("6", "2026-04-04 15:12:47", "Alex Morgan",  "created",  "c-5f6a", "Documentation needs updating for v2.0...",        "192.168.1.67"),
    ];

    private static string GetActionColor(string action) => action switch
    {
        "created"  => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        "edited"   => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "deleted"  => "bg-red-500/10 text-red-600 dark:text-red-400",
        "flagged"  => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "approved" => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        _          => "",
    };
}
