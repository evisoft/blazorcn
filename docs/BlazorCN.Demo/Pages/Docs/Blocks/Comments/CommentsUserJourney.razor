@* ============================================================
   Block: comments-user-journey
   Title: CommentsUserJourney
   Description: A user activity timeline block for React and Next.js with chronological comment history, engagement patterns, interaction types, and contribution metrics built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-user-journey.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header: user profile *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <AvatarCn Class="size-10 shrink-0">
                    <AvatarImageCn Src="" Alt="Sarah Chen" />
                    <AvatarFallbackCn>SC</AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">Sarah Chen</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">Member since Jan 2026</p>
                </div>
            </div>
        </div>

        @* Stats row *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <span class="text-xs text-muted-foreground">Comments</span>
                <div class="mt-1 text-lg font-semibold tabular-nums">@_totalComments</div>
            </div>
            <div class="border-r px-4 py-3">
                <span class="text-xs text-muted-foreground">Replies</span>
                <div class="mt-1 text-lg font-semibold tabular-nums">@_totalReplies</div>
            </div>
            <div class="px-4 py-3">
                <span class="text-xs text-muted-foreground">Reactions</span>
                <div class="mt-1 text-lg font-semibold tabular-nums">@_totalReactions</div>
            </div>
        </div>

        @* Activity timeline *@
        <div class="px-4 py-3">
            <span class="mb-3 block text-xs font-medium text-muted-foreground">
                Activity timeline
            </span>
            <div class="space-y-4">
                @for (int i = 0; i < _activities.Length; i++)
                {
                    var activity = _activities[i];
                    var isLast = i == _activities.Length - 1;
                    var iconName = GetIconName(activity.Type);
                    var colorClass = GetColorClass(activity.Type);
                    var label = GetLabel(activity.Type);
                    <div class="relative flex gap-3">
                        @if (!isLast)
                        {
                            <div class="absolute left-[11px] top-7 h-full w-px bg-border"></div>
                        }
                        <div class="@Cn.Merge("relative z-10 mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full", colorClass)">
                            <LucideIconCn Name="@iconName" Size="14" Class="size-3.5 text-white" />
                        </div>
                        <div class="min-w-0 flex-1 pb-1">
                            <div class="mb-1 flex items-center gap-2">
                                <span class="text-xs font-medium">@label</span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="text-xs text-muted-foreground">@activity.Timestamp</span>
                            </div>
                            <p class="mb-1 text-xs text-muted-foreground">@activity.PostTitle</p>
                            @if (!string.IsNullOrEmpty(activity.Content))
                            {
                                <p class="text-sm leading-relaxed">@activity.Content</p>
                            }
                            @if (!string.IsNullOrEmpty(activity.ReactionType))
                            {
                                <BadgeCn Variant="BadgeVariant.Outline" Class="mt-1 text-xs font-normal">
                                    @activity.ReactionType
                                </BadgeCn>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>@(_activities.Length) activities</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>Last 7 days</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record Activity(string Id, string Type, string? Content, string? PostTitle, string Timestamp, string? ReactionType);

    private static readonly Activity[] _activities =
    [
        new("1", "comment",  "This feature is exactly what we needed. The implementation is clean and the performance is great.", "New Dashboard Release",   "2 hours ago", null),
        new("2", "reply",    "Thanks for the feedback! We're planning to add more customization options in the next release.",    "Feature Request: Dark Mode", "5 hours ago", null),
        new("3", "reaction", null,                                                                                                "Documentation Update",    "1 day ago",   "heart"),
        new("4", "comment",  "Has anyone tested this with large datasets? Curious about performance at scale.",                  "API Optimization Guide",  "2 days ago",  null),
        new("5", "edit",     "Updated with benchmark results and comparison table.",                                             "Performance Analysis",    "3 days ago",  null),
        new("6", "reply",    "You can configure this in the settings panel under Advanced options.",                             "Setup Guide",             "3 days ago",  null),
    ];

    private int _totalComments  => _activities.Count(a => a.Type == "comment");
    private int _totalReplies   => _activities.Count(a => a.Type == "reply");
    private int _totalReactions => _activities.Count(a => a.Type == "reaction");

    private static string GetIconName(string type) => type switch
    {
        "comment"  => "message-circle",
        "reply"    => "reply",
        "reaction" => "heart",
        "edit"     => "edit",
        _          => "message-circle",
    };

    private static string GetColorClass(string type) => type switch
    {
        "comment"  => "bg-blue-500",
        "reply"    => "bg-emerald-500",
        "reaction" => "bg-red-500",
        "edit"     => "bg-amber-500",
        _          => "bg-blue-500",
    };

    private static string GetLabel(string type) => type switch
    {
        "comment"  => "Commented",
        "reply"    => "Replied",
        "reaction" => "Reacted",
        "edit"     => "Edited",
        _          => type,
    };
}
