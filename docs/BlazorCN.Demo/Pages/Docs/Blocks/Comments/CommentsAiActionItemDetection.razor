@* ============================================================
   Block: comments-ai-action-item-detection
   Title: CommentsAiActionItemDetection
   Description: React comment block for Next.js with AI-powered task extraction, deadline detection, and assignee suggestions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-ai-action-item-detection.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Add comment</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        AI action item detection enabled
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 text-[10px] font-normal">
                    <LucideIconCn Name="sparkles" Size="10" Class="size-2.5" />
                    @_actionItems.Length actions detected
                </BadgeCn>
            </div>
        </div>

        @* Comment textarea *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_comment" Placeholder="Write your comment..." Class="min-h-[100px]" aria-label="Write your comment..." />
            <div class="mt-2 flex items-center justify-between">
                <div class="flex items-center gap-2 text-xs text-muted-foreground">
                    <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                    <span>Detecting action items automatically</span>
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

        @if (_actionItems.Length > 0)
        {
            @* Action items header *@
            <div class="border-b px-4 py-2.5">
                <div class="flex items-center justify-between">
                    <span class="text-xs font-medium text-muted-foreground">
                        Detected action items
                    </span>
                    <span class="text-xs text-muted-foreground">
                        @_selectedCount of @_actionItems.Length selected
                    </span>
                </div>
            </div>

            @* Action item rows *@
            <div>
                @for (var i = 0; i < _actionItems.Length; i++)
                {
                    var item = _actionItems[i];
                    var isLast = i == _actionItems.Length - 1;
                    <div class="@(isLast ? "" : "border-b")">
                        <span class="flex cursor-pointer items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                            <CheckboxCn Checked="@item.Selected" CheckedChanged="@(() => ToggleItem(item.Id))" Class="mt-0.5" aria-label="@item.Task" />
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="@($"size-1.5 shrink-0 rounded-full {PriorityDot(item.Priority)}")"></span>
                                    <span class="text-sm font-medium">@item.Task</span>
                                </div>
                                <div class="mt-1.5 flex flex-wrap items-center gap-2">
                                    @if (item.Assignee is not null)
                                    {
                                        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                            <LucideIconCn Name="user" Size="12" Class="size-3" />
                                            <span>@item.Assignee</span>
                                        </div>
                                    }
                                    @if (item.Deadline is not null)
                                    {
                                        <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                            <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                            <span>@item.Deadline</span>
                                        </div>
                                    }
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="@($"text-[10px] font-normal {PriorityColor(item.Priority)}")">
                                        @item.Priority
                                    </BadgeCn>
                                </div>
                            </div>
                        </span>
                    </div>
                }
            </div>

            @* Create tasks footer *@
            <div class="border-t px-4 py-3">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full gap-1 text-xs" Disabled="@(_selectedCount == 0)" OnClick="CreateTasks">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    Create @_selectedCount @(_selectedCount == 1 ? "task" : "tasks")
                </ButtonCn>
            </div>
        }
        else
        {
            <div class="px-4 py-6 text-center">
                <p class="text-xs text-muted-foreground">
                    No action items detected in this comment
                </p>
            </div>
        }

    </div>
</section>

@code {
    private record ActionItem(
        string Id,
        string Task,
        string? Assignee,
        string? Deadline,
        string Priority,
        bool Selected
    );

    private string _comment =
        "We need to update the documentation by Friday and assign Sarah to review the API changes. Also, someone should create test cases for the new auth flow before next week's release.";

    private ActionItem[] _actionItems =
    [
        new("1", "Update documentation", null, "Friday, Apr 7", "high", true),
        new("2", "Assign Sarah to review API changes", "Sarah Chen", null, "medium", true),
        new("3", "Create test cases for auth flow", null, "Apr 11", "medium", false),
    ];

    private int _selectedCount => _actionItems.Count(x => x.Selected);

    private void ToggleItem(string id)
    {
        _actionItems = _actionItems
            .Select(item => item.Id == id ? item with { Selected = !item.Selected } : item)
            .ToArray();
    }

    private void CreateTasks()
    {
        // No-op: presentational demo
    }

    private static string PriorityColor(string priority) => priority switch
    {
        "high"   => "text-red-600 dark:text-red-400",
        "medium" => "text-amber-600 dark:text-amber-400",
        "low"    => "text-blue-600 dark:text-blue-400",
        _        => "",
    };

    private static string PriorityDot(string priority) => priority switch
    {
        "high"   => "bg-red-500",
        "medium" => "bg-amber-500",
        "low"    => "bg-blue-500",
        _        => "",
    };
}
