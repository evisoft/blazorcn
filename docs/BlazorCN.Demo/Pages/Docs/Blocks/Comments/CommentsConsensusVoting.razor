@* ============================================================
   Block: comments-consensus-voting
   Title: CommentsConsensusVoting
   Description: React comment block for Next.js with team decision tracking, consensus voting, and approval threshold indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-consensus-voting.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header: title + consensus badge *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">@_proposal.Title</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_proposal.Author · @_proposal.Timestamp
                    </p>
                </div>
                <BadgeCn
                    Variant="@(_consensusReached ? BadgeVariant.Default : BadgeVariant.Secondary)"
                    Class="@Cn.Merge("gap-1 text-[10px] font-normal", _consensusReached ? "bg-emerald-500 text-white dark:bg-emerald-600" : "")">
                    @if (_consensusReached)
                    {
                        <LucideIconCn Name="check" Size="10" Class="size-2.5" />
                        <span>Consensus</span>
                    }
                    else
                    {
                        <span>Voting</span>
                    }
                </BadgeCn>
            </div>
        </div>

        @* Proposal body *@
        <div class="border-b p-4">
            <p class="text-sm leading-relaxed">@_proposal.Content</p>
        </div>

        @* Consensus progress bar *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Consensus progress</span>
                <span class="text-xs font-medium tabular-nums">
                    @_approvePercentage% / @_proposal.Threshold% required
                </span>
            </div>
            <div class="relative h-2 overflow-hidden rounded-full bg-muted">
                <div class="@Cn.Merge("h-full rounded-full", _consensusReached ? "bg-emerald-500" : "bg-blue-500")"
                     style="@($"width:{_approvePercentage}%")">
                </div>
            </div>
            <div class="mt-2 flex items-center gap-3">
                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span>@_approveCount approve</span>
                </div>
                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    <span>@_neutralCount neutral</span>
                </div>
                <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span>@_rejectCount reject</span>
                </div>
            </div>
        </div>

        @* Cast your vote *@
        <div class="border-b px-4 py-3">
            <div class="mb-2.5 text-xs font-medium text-muted-foreground">Cast your vote</div>
            <div class="grid grid-cols-3 gap-2">
                @foreach (var voteType in _voteTypes)
                {
                    var vt = voteType;
                    var cfg = _voteConfig[vt];
                    var isSelected = _userVote == vt;
                    <ButtonCn
                        Variant="@(isSelected ? ButtonVariant.Default : ButtonVariant.Outline)"
                        Size="ButtonSize.Sm"
                        Class="h-auto w-full flex-col gap-1 py-2 text-xs"
                        OnClick="@(() => _userVote = vt)">
                        <LucideIconCn Name="@cfg.IconName" Size="16" Class="size-4" />
                        @cfg.Label
                    </ButtonCn>
                }
            </div>
        </div>

        @* Vote list *@
        <div>
            <div class="border-b px-4 py-2.5">
                <span class="text-xs font-medium text-muted-foreground">Votes (@_proposal.Votes.Length)</span>
            </div>

            @for (var i = 0; i < _proposal.Votes.Length; i++)
            {
                var vote = _proposal.Votes[i];
                var isLast = i == _proposal.Votes.Length - 1;
                var cfg = _voteConfig[vote.Vote];
                var initials = GetInitials(vote.User);
                <div class="@(isLast ? "p-4" : "border-b p-4")">
                    <div class="flex items-center gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarImageCn Src="@vote.Avatar" Alt="@vote.User" />
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="flex flex-1 items-center gap-2">
                            <span class="text-sm font-medium">@vote.User</span>
                            <BadgeCn
                                Variant="BadgeVariant.Outline"
                                Class="@Cn.Merge("gap-1 text-[10px] font-normal", cfg.Color)">
                                <LucideIconCn Name="@cfg.IconName" Size="10" Class="size-2.5" />
                                @cfg.Label
                            </BadgeCn>
                        </div>
                        <span class="text-xs text-muted-foreground">@vote.Timestamp</span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    // ---- Data types ----
    private record VoteData(string Id, string User, string Avatar, string Vote, string Timestamp);
    private record ProposalData(string Id, string Title, string Author, string Content, string Timestamp, int Threshold, VoteData[] Votes);
    private record VoteCfg(string Label, string IconName, string Color, string Dot);

    // ---- Static data ----
    private static readonly ProposalData _proposal = new(
        "1",
        "Proposal: Migrate to monorepo architecture",
        "Sarah Chen",
        "I propose we migrate our codebase to a monorepo structure using Turborepo. This will improve code sharing, simplify dependency management, and enable better CI/CD pipelines across our services.",
        "2 hours ago",
        75,
        [
            new("1", "Alex Morgan",  "", "approve",  "1 hour ago"),
            new("2", "Maya Patel",   "", "approve",  "1 hour ago"),
            new("3", "Chris Taylor", "", "neutral",  "45 min ago"),
            new("4", "Jordan Lee",   "", "reject",   "30 min ago"),
        ]
    );

    private static readonly string[] _voteTypes = ["approve", "neutral", "reject"];

    private static readonly Dictionary<string, VoteCfg> _voteConfig = new()
    {
        ["approve"] = new("Approve", "thumbs-up",   "text-emerald-600 dark:text-emerald-400", "bg-emerald-500"),
        ["neutral"] = new("Neutral", "minus",        "text-blue-600 dark:text-blue-400",      "bg-blue-500"),
        ["reject"]  = new("Reject",  "thumbs-down",  "text-red-600 dark:text-red-400",        "bg-red-500"),
    };

    // ---- Computed counts ----
    private int _approveCount  => Array.FindAll(_proposal.Votes, v => v.Vote == "approve").Length;
    private int _neutralCount  => Array.FindAll(_proposal.Votes, v => v.Vote == "neutral").Length;
    private int _rejectCount   => Array.FindAll(_proposal.Votes, v => v.Vote == "reject").Length;
    private int _approvePercentage => (int)Math.Round((double)_approveCount / _proposal.Votes.Length * 100);
    private bool _consensusReached => _approvePercentage >= _proposal.Threshold;

    // ---- State ----
    private string? _userVote = null;

    // ---- Helpers ----
    private static string GetInitials(string name)
    {
        var parts = name.Split(' ');
        var result = "";
        foreach (var p in parts)
            if (p.Length > 0) result += char.ToUpper(p[0]);
        return result;
    }
}
