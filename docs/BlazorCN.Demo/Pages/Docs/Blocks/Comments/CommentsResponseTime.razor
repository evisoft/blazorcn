@* ============================================================
   Block: comments-response-time
   Title: CommentsResponseTime
   Description: A comment response time SLA tracker for React and Next.js with average response metrics, SLA compliance rates, breach alerts, and team performance built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-response-time.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Response Time SLA</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_overallCompliance% compliance · @_totalBreaches breaches
            </p>
        </div>

        @* Stats row *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <div class="mb-1 flex items-center gap-1.5">
                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground/60" />
                    <span class="text-xs text-muted-foreground">Avg response</span>
                </div>
                <div class="text-2xl font-semibold tabular-nums">4h 12m</div>
            </div>
            <div class="border-r px-4 py-3">
                <div class="mb-1 flex items-center gap-1.5">
                    <LucideIconCn Name="check-circle" Size="14" Class="size-3.5 text-muted-foreground/60" />
                    <span class="text-xs text-muted-foreground">Median</span>
                </div>
                <div class="text-2xl font-semibold tabular-nums">2h 45m</div>
            </div>
            <div class="px-4 py-3">
                <div class="mb-1 flex items-center gap-1.5">
                    <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5 text-muted-foreground/60" />
                    <span class="text-xs text-muted-foreground">P90</span>
                </div>
                <div class="text-2xl font-semibold tabular-nums">9h 30m</div>
            </div>
        </div>

        @* SLA metrics list *@
        <div>
            @for (int i = 0; i < _slaMetrics.Length; i++)
            {
                var metric = _slaMetrics[i];
                var isLast = i == _slaMetrics.Length - 1;
                var isCompliant = metric.Compliance >= 90;
                var dotColor = GetPriorityDotColor(metric.Priority);
                var badgeClass = GetPriorityBadgeClass(metric.Priority);
                <div class="@(isLast ? "" : "border-b")">
                    <div class="px-4 py-3">
                        <div class="flex items-start gap-3">
                            <span class="@($"mt-1 size-2 shrink-0 rounded-full {dotColor}")" />
                            <div class="min-w-0 flex-1">
                                <div class="mb-1.5 flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("text-xs font-normal", badgeClass)">
                                        @metric.Priority
                                    </BadgeCn>
                                    <span class="text-xs text-muted-foreground">
                                        Target: @metric.Target
                                    </span>
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="flex items-baseline gap-1.5">
                                        <span class="text-sm font-medium">@metric.AvgResponse</span>
                                        <span class="text-xs text-muted-foreground">avg</span>
                                    </div>
                                    <span class="text-xs text-muted-foreground">·</span>
                                    <div class="flex items-center gap-1">
                                        <span class="@Cn.Merge("text-xs font-medium", isCompliant ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                            @metric.Compliance%
                                        </span>
                                        <span class="text-xs text-muted-foreground">SLA</span>
                                    </div>
                                    @if (metric.Breaches > 0)
                                    {
                                        <span class="text-xs text-muted-foreground">·</span>
                                        <span class="text-xs text-red-600 dark:text-red-400">
                                            @metric.Breaches breaches
                                        </span>
                                    }
                                </div>
                                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted">
                                    <div class="@Cn.Merge("h-full", isCompliant ? "bg-emerald-500" : "bg-red-500")"
                                         style="@($"width:{metric.Compliance}%")">
                                    </div>
                                </div>
                                <div class="mt-1.5 flex items-center gap-1">
                                    @if (metric.Trend == "up")
                                    {
                                        <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                                        <span class="text-xs text-emerald-600 dark:text-emerald-400">
                                            @metric.TrendValue% improvement
                                        </span>
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="trending-down" Size="12" Class="size-3 text-red-500" />
                                        <span class="text-xs text-red-600 dark:text-red-400">
                                            @metric.TrendValue% slower
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>Last 30 days</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>Updated 5 min ago</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record SlaMetric(
        string Priority,
        string Target,
        string AvgResponse,
        int Compliance,
        int Breaches,
        string Trend,
        double TrendValue
    );

    private static readonly SlaMetric[] _slaMetrics =
    [
        new("critical", "30m",  "24m",      95, 2, "up",   3.2),
        new("high",     "2h",   "1h 45m",   92, 5, "up",   1.8),
        new("medium",   "8h",   "6h 20m",   88, 8, "down", 2.5),
        new("low",      "24h",  "18h 15m",  94, 3, "up",   4.1),
    ];

    private static readonly int _overallCompliance = 92;
    private static readonly int _totalBreaches = _slaMetrics.Sum(m => m.Breaches);

    private static string GetPriorityDotColor(string priority) => priority switch
    {
        "critical" => "bg-red-500",
        "high"     => "bg-amber-500",
        "medium"   => "bg-blue-500",
        _          => "bg-muted-foreground/40",
    };

    private static string GetPriorityBadgeClass(string priority) => priority switch
    {
        "critical" => "border-red-500/20 bg-red-500/10 text-red-700 dark:text-red-400",
        "high"     => "border-amber-500/20 bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "medium"   => "border-blue-500/20 bg-blue-500/10 text-blue-700 dark:text-blue-400",
        _          => "border-muted-foreground/20 bg-muted/50 text-muted-foreground",
    };
}
