@* ============================================================
   Block: comments-drawing-canvas
   Title: CommentsDrawingCanvas
   Description: A freehand drawing comment system for React and Next.js with HTML5 canvas, color picker, brush sizes, undo/redo, and inline sketch display built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-drawing-canvas.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Comments</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length @(_comments.Length == 1 ? "comment" : "comments")
            </p>
        </div>

        @* New comment panel *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_newComment" Placeholder="Add a comment..." Class="min-h-[100px]" />

            @if (_showCanvas)
            {
                <div class="mt-3 overflow-hidden rounded-md border bg-muted/30 p-3">
                    <div class="mb-2 flex items-center gap-2">
                        @* Color picker *@
                        <div class="flex items-center gap-1">
                            @foreach (var c in _colors)
                            {
                                var col = c;
                                <button
                                    type="button"
                                    @onclick="@(() => _color = col.Value)"
                                    class="@Cn.Merge("size-6 rounded-full border-2 transition-all", _color == col.Value ? "ring-2 ring-ring ring-offset-2" : "border-border")"
                                    style="@($"background-color:{col.Value}")"
                                    aria-label="@($"Select {col.Name} color")"
                                ></button>
                            }
                        </div>

                        @* Brush sizes *@
                        <div class="ml-auto flex items-center gap-1">
                            @foreach (var sz in _brushSizes)
                            {
                                var size = sz;
                                <button
                                    type="button"
                                    @onclick="@(() => _brushSize = size)"
                                    class="@Cn.Merge("flex size-8 items-center justify-center rounded-md border transition-colors", _brushSize == size ? "border-ring bg-muted" : "border-border hover:bg-muted/50")"
                                >
                                    <span
                                        class="rounded-full bg-foreground"
                                        style="@($"width:{size}px;height:{size}px")"
                                    ></span>
                                </button>
                            }
                        </div>

                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="size-7">
                            <LucideIconCn Name="undo" Size="12" Class="size-3" />
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="size-7">
                            <LucideIconCn Name="redo" Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>

                    <canvas
                        class="w-full cursor-crosshair rounded-md border bg-white"
                    ></canvas>

                    <div class="mt-2 flex justify-end gap-2">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="ClearCanvas">
                            Clear
                        </ButtonCn>
                    </div>
                </div>
            }

            <div class="mt-2 flex items-center justify-between">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="@(() => _showCanvas = !_showCanvas)">
                    <LucideIconCn Name="palette" Size="12" Class="size-3" />
                    @(_showCanvas ? "Hide" : "Add") drawing
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var comment in _comments)
            {
                var initials = GetInitials(comment.Author);
                <div class="p-4">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed">@comment.Content</p>
                            @if (comment.HasDrawing)
                            {
                                <div class="mt-2 inline-block rounded-md border bg-muted/30 p-2">
                                    <div class="h-40 w-60 rounded bg-white"></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ColorOption(string Name, string Value);
    private record CommentItem(string Id, string Author, string Content, string Timestamp, bool HasDrawing);

    private static readonly ColorOption[] _colors =
    [
        new("black",  "#000000"),
        new("red",    "#ef4444"),
        new("blue",   "#3b82f6"),
        new("green",  "#22c55e"),
        new("yellow", "#eab308"),
        new("purple", "#a855f7"),
    ];

    private static readonly int[] _brushSizes = [2, 4, 6, 8];

    private static readonly CommentItem[] _comments =
    [
        new("1", "Sarah Chen",  "Here's a quick sketch of the layout idea", "2 hours ago", true),
        new("2", "Alex Morgan", "Love the visual explanation!",              "3 hours ago", false),
    ];

    private string _newComment = "";
    private bool _showCanvas = false;
    private string _color = "#000000";
    private int _brushSize = 4;

    private void ClearCanvas()
    {
        // Canvas clearing requires JS interop in a real implementation.
        // This is a presentational port.
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var result = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) result += char.ToUpper(p[0]);
        }
        return result;
    }
}
