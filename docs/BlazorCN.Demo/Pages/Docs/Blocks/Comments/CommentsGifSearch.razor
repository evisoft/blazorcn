@* ============================================================
   Block: comments-gif-search
   Title: CommentsGifSearch
   Description: A GIF-enabled comment system for React and Next.js with Giphy/Tenor search, trending GIFs, preview cards, and inline GIF display built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-gif-search.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Comments</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length @(_comments.Length == 1 ? "comment" : "comments")
            </p>
        </div>

        @* New comment input *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_newComment" Placeholder="Add a comment..." Class="min-h-[100px]" aria-label="Add a comment..." />

            @if (_selectedGif != null)
            {
                <div class="mt-3 overflow-hidden">
                    <div class="relative inline-block rounded-md border bg-muted/30">
                        <img src="@_selectedGif.Url" alt="@_selectedGif.Title" class="h-32 rounded-md object-cover" />
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconXs" Class="absolute right-1 top-1 size-6 bg-background/80 backdrop-blur-sm" OnClick="@(() => _selectedGif = null)" aria-label="Close">
                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                </div>
            }

            <div class="mt-2 flex items-center justify-between">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="@(() => _showGifPicker = !_showGifPicker)">
                    <LucideIconCn Name="image" Size="12" Class="size-3" />
                    Add GIF
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>

            @if (_showGifPicker)
            {
                <div class="mt-3 overflow-hidden rounded-md border bg-muted/30">
                    <div class="p-3">
                        <div class="mb-3 flex items-center gap-2 rounded-md border bg-background px-3 py-2">
                            <LucideIconCn Name="search" Size="16" Class="size-4 text-muted-foreground" />
                            <InputCn @bind-Value="_gifSearch" Placeholder="Search GIFs..." Class="h-6 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" aria-label="Search GIFs..." />
                        </div>

                        @if (string.IsNullOrEmpty(_gifSearch))
                        {
                            <div class="mb-2 flex items-center gap-1.5">
                                <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-xs font-medium text-muted-foreground">Trending</span>
                            </div>
                        }

                        <div class="grid grid-cols-3 gap-2">
                            @foreach (var gif in DisplayedGifs)
                            {
                                var g = gif;
                                <button type="button" @onclick="@(() => HandleSelectGif(g))" class="group relative aspect-video overflow-hidden rounded-md border bg-muted transition-all hover:ring-2 hover:ring-ring">
                                    <img src="@g.Url" alt="@g.Title" class="size-full object-cover" />
                                </button>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var comment in _comments)
            {
                var c = comment;
                var initials = GetInitials(c.Author);
                <div class="p-4">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@c.Author</span>
                                <span class="text-xs text-muted-foreground">@c.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed">@c.Content</p>
                            @if (c.Gif != null)
                            {
                                <div class="mt-2 inline-block rounded-md border bg-muted/30">
                                    <img src="@c.Gif.Url" alt="@c.Gif.Title" class="h-40 rounded-md object-cover" />
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record GifResult(string Id, string Url, string Title);
    private record CommentData(string Id, string Author, string Content, string Timestamp, GifResult? Gif);

    private static readonly GifResult[] _trendingGifs =
    [
        new("1", "https://placehold.co/200x150/e5e7eb/9ca3af?text=Thumbs+Up", "Thumbs up"),
        new("2", "https://placehold.co/200x150/e5e7eb/9ca3af?text=Dancing", "Dancing"),
        new("3", "https://placehold.co/200x150/e5e7eb/9ca3af?text=Clapping", "Clapping"),
        new("4", "https://placehold.co/200x150/e5e7eb/9ca3af?text=Mind+Blown", "Mind blown"),
        new("5", "https://placehold.co/200x150/e5e7eb/9ca3af?text=Laughing", "Laughing"),
        new("6", "https://placehold.co/200x150/e5e7eb/9ca3af?text=Excited", "Excited"),
    ];

    private static readonly CommentData[] _comments =
    [
        new("1", "Sarah Chen", "This is exactly what we needed!", "2 hours ago",
            new("g1", "https://placehold.co/300x200/e5e7eb/9ca3af?text=Perfect", "Perfect")),
        new("2", "Alex Morgan", "Great work on the implementation", "3 hours ago", null),
    ];

    private string _newComment = "";
    private bool _showGifPicker = false;
    private string _gifSearch = "";
    private GifResult? _selectedGif = null;

    private IEnumerable<GifResult> DisplayedGifs =>
        string.IsNullOrEmpty(_gifSearch)
            ? _trendingGifs
            : _trendingGifs.Where(g => g.Title.Contains(_gifSearch, StringComparison.OrdinalIgnoreCase));

    private void HandleSelectGif(GifResult gif)
    {
        _selectedGif = gif;
        _showGifPicker = false;
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var initials = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) initials += char.ToUpper(p[0]);
        }
        return initials;
    }
}
