@* ============================================================
   Block: comments-global-search
   Title: CommentsGlobalSearch
   Description: A cross-project comment search for React and Next.js with project filtering, full-text search, and result grouping built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-global-search.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Global Search</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Search across @_projects.Length projects
            </p>
        </div>

        @* Search input *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="search" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <InputCn @bind-Value="_query" Placeholder="Search all comments..." Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            </div>
        </div>

        @* Project filters *@
        <div class="border-b bg-muted/20 p-4">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Filter by project</span>
                <button type="button" @onclick="ToggleAll" class="text-xs text-muted-foreground hover:text-foreground">
                    @(_selectedProjects.Count == _projects.Length ? "Deselect all" : "Select all")
                </button>
            </div>
            <div class="flex flex-wrap gap-3">
                @foreach (var proj in _projects)
                {
                    var project = proj;
                    var count = _comments.Count(c => c.Project == project);
                    var isChecked = _selectedProjects.Contains(project);
                    <label class="flex cursor-pointer items-center gap-2 rounded-md border bg-background px-3 py-2 transition-colors hover:bg-muted/50">
                        <CheckboxCn Checked="@isChecked" CheckedChanged="@(() => ToggleProject(project))" />
                        <span class="text-sm font-medium">@project</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal tabular-nums">@count</BadgeCn>
                    </label>
                }
            </div>
        </div>

        @* Results summary (only when there is a query) *@
        @if (_hasQuery)
        {
            var resultCount = _filteredComments.Count;
            var projCount = _selectedProjects.Count;
            <div class="border-b bg-muted/20 px-4 py-2">
                <span class="text-xs font-medium">
                    @resultCount @(resultCount == 1 ? "result" : "results") in
                    @projCount @(projCount == 1 ? "project" : "projects")
                </span>
            </div>
        }

        @* Grouped results *@
        <div>
            @foreach (var proj in _projects)
            {
                var project = proj;
                var projectComments = _filteredComments.Where(c => c.Project == project).ToList();
                if (!_selectedProjects.Contains(project) || projectComments.Count == 0)
                {
                    continue;
                }
                <div class="border-b last:border-b-0">
                    <div class="bg-muted/30 px-4 py-2">
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-medium">@project</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">@projectComments.Count</BadgeCn>
                        </div>
                    </div>
                    <div class="divide-y">
                        @foreach (var cmt in projectComments)
                        {
                            var comment = cmt;
                            <div class="px-4 py-3">
                                <div class="flex items-center gap-2">
                                    <span class="text-sm font-medium">@comment.Author</span>
                                    <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                                </div>
                                <p class="mt-1 text-sm leading-relaxed text-muted-foreground">@comment.Content</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Empty state *@
        @if (_hasQuery && _filteredComments.Count == 0)
        {
            <div class="px-4 py-8 text-center">
                <p class="text-sm text-muted-foreground">No comments match your search</p>
                <p class="mt-1 text-xs text-muted-foreground">
                    Try different keywords or select more projects
                </p>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5 text-xs text-muted-foreground">
            @_comments.Length total comments across all projects
        </div>

    </div>
</section>

@code {
    private record Comment(string Id, string Author, string Content, string Project, string Timestamp);

    private static readonly string[] _projects = ["acme-app", "dashboard", "docs-site", "api-service"];

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen",  "This component library is excellent for TypeScript projects",  "acme-app",    "2 hours ago"),
        new("2", "James Wilson","How do I integrate the authentication module?",                 "dashboard",   "3 hours ago"),
        new("3", "Maya Patel",  "The dark mode implementation is flawless",                     "acme-app",    "5 hours ago"),
        new("4", "Alex Morgan", "TypeScript types are well-documented in the docs",              "docs-site",   "7 hours ago"),
        new("5", "Chris Taylor","Found a bug in the API authentication flow",                   "api-service", "1 day ago"),
        new("6", "Jordan Lee",  "Dashboard performance is excellent",                           "dashboard",   "2 days ago"),
    ];

    private string _query = "";
    private HashSet<string> _selectedProjects = new(["acme-app", "dashboard", "docs-site", "api-service"]);

    private bool _hasQuery => _query.Trim().Length > 0;

    private List<Comment> _filteredComments => _comments.Where(c =>
        _selectedProjects.Contains(c.Project) &&
        (!_hasQuery || c.Content.Contains(_query.Trim(), StringComparison.OrdinalIgnoreCase))
    ).ToList();

    private void ToggleProject(string project)
    {
        if (_selectedProjects.Contains(project))
            _selectedProjects.Remove(project);
        else
            _selectedProjects.Add(project);
    }

    private void ToggleAll()
    {
        if (_selectedProjects.Count == _projects.Length)
            _selectedProjects = [];
        else
            _selectedProjects = new(["acme-app", "dashboard", "docs-site", "api-service"]);
    }
}
