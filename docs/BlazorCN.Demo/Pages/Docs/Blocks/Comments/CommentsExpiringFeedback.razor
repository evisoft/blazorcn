@* ============================================================
   Block: comments-expiring-feedback
   Title: CommentsExpiringFeedback
   Description: Time-limited comment collection for React and Next.js with countdown timers, auto-archive on expiration, and urgency indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-expiring-feedback.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <h2 class="text-sm font-medium">@_thread.Title</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_thread.CommentCount comments · Expires @_thread.ExpiresAt
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("shrink-0 text-xs font-normal", StatusColor(_thread.Status))">
                    @if (_thread.Status == "active")
                    {
                        <text>Active</text>
                    }
                    @if (_thread.Status == "expiring-soon")
                    {
                        <text>Expiring soon</text>
                    }
                    @if (_thread.Status == "expired")
                    {
                        <text>Expired</text>
                    }
                </BadgeCn>
            </div>
        </div>

        @* Time remaining banner (non-expired) *@
        @if (_thread.Status != "expired")
        {
            <div class="border-b bg-muted/30 px-4 py-3">
                <div class="mb-2 flex items-center gap-2">
                    <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm font-medium">@_thread.TimeRemaining</span>
                    @if (_thread.Status == "expiring-soon")
                    {
                        <LucideIconCn Name="alert-circle" Size="16" Class="size-4 text-amber-500" />
                    }
                </div>
                <ProgressCn Value="@ProgressValue(_thread.Status)" Class="h-1.5" aria-label="Progress" />
                @if (_thread.Status == "expiring-soon")
                {
                    <p class="mt-2 text-xs text-muted-foreground">
                        This feedback window will close soon. Submit your comments now.
                    </p>
                }
            </div>
        }

        @* Expired banner *@
        @if (_isExpired)
        {
            <div class="border-b bg-red-500/5 px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="lock" Size="16" Class="size-4 text-red-600 dark:text-red-400" />
                    <span class="text-sm font-medium text-red-600 dark:text-red-400">
                        This discussion has expired and is now archived
                    </span>
                </div>
                <p class="mt-1 text-xs text-muted-foreground">
                    Comments are closed. Contact an admin to reopen if needed.
                </p>
            </div>
        }

        @* New comment form (non-expired only) *@
        @if (!_isExpired)
        {
            <div class="border-b p-4">
                <TextareaCn @bind-Value="_newComment" Placeholder="Add your feedback..." Class="min-h-[80px]" aria-label="Add your feedback..." />
                <div class="mt-2 flex justify-end">
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Submit feedback
                    </ButtonCn>
                </div>
            </div>
        }

        @* Comment list *@
        <div>
            @for (var i = 0; i < _comments.Length; i++)
            {
                var comment = _comments[i];
                var isLast = i == _comments.Length - 1;
                var initials = GetInitials(comment.Author);
                <div class="@(isLast ? "p-4" : "border-b p-4")">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed text-muted-foreground">
                                @comment.Content
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ExpiringThread(
        string Id,
        string Title,
        string ExpiresAt,
        string TimeRemaining,
        string Status,
        int CommentCount
    );

    private record Comment(
        string Id,
        string Author,
        string Content,
        string Timestamp
    );

    private static readonly ExpiringThread _thread = new(
        "1",
        "Sprint 24 Retrospective Feedback",
        "Apr 5, 2026 at 5:00 PM",
        "6 hours left",
        "expiring-soon",
        8
    );

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen", "Great progress on the accessibility improvements. Authentication flow still needs work.", "2 hours ago"),
        new("2", "Alex Morgan", "Documentation was excellent this sprint. Let's maintain this quality going forward.", "4 hours ago"),
        new("3", "Maya Patel", "Testing coverage improved significantly. Found the new component library very helpful.", "5 hours ago"),
    ];

    private bool _isExpired => _thread.Status == "expired";
    private string _newComment = "";

    private static string StatusColor(string status) => status switch
    {
        "active" => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "expiring-soon" => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "expired" => "bg-red-500/10 text-red-600 dark:text-red-400",
        _ => ""
    };

    private static int ProgressValue(string status) => status switch
    {
        "active" => 30,
        "expiring-soon" => 75,
        "expired" => 100,
        _ => 0
    };

    private static string GetInitials(string author)
    {
        return string.Concat(author.Split(' ').Select(n => n[0])).ToUpper();
    }
}
