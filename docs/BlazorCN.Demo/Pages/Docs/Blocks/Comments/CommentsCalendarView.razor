@* ============================================================
   Block: comments-calendar-view
   Title: CommentsCalendarView
   Description: A calendar-based comment organization for React and Next.js with month/week/day views, date filtering, and activity indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-calendar-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Calendar View</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_comments.Length comments in @_monthNames[_currentMonth] @_currentYear
                    </p>
                </div>
                <div class="flex items-center gap-1">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2" aria-label="Previous month">
                        <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                    </ButtonCn>
                    <span class="px-2 text-sm font-medium">
                        @_monthNames[_currentMonth] @_currentYear
                    </span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2" aria-label="Next month">
                        <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Calendar grid *@
        <div class="border-b p-4">
            <div class="grid grid-cols-7 gap-2">
                @foreach (var day in _daysOfWeek)
                {
                    <div class="text-center text-xs font-medium text-muted-foreground">
                        @day
                    </div>
                }
                @foreach (var item in _calendarDays)
                {
                    if (item == null)
                    {
                        <div class="aspect-square"></div>
                    }
                    else
                    {
                        var calItem = item;
                        var isSelected = _selectedDate == calItem.Date;
                        var hasComments = calItem.Comments.Length > 0;
                        <button type="button"
                                @onclick="@(() => _selectedDate = calItem.Date)"
                                class="@Cn.Merge("relative aspect-square rounded-md border text-center text-sm transition-all hover:bg-muted/50",
                                    isSelected ? "border-foreground bg-foreground text-background" : "",
                                    !isSelected && hasComments ? "border-blue-500/30 bg-blue-500/5" : "")">
                            <span class="block pt-1">@calItem.Day</span>
                            @if (hasComments)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary"
                                         Class="@Cn.Merge("absolute bottom-1 left-1/2 h-4 -translate-x-1/2 px-1.5 text-[10px] font-normal tabular-nums",
                                             isSelected ? "bg-background/20 text-background" : "")">
                                    @calItem.Comments.Length
                                </BadgeCn>
                            }
                        </button>
                    }
                }
            </div>
        </div>

        @* Selected date comments *@
        @if (_selectedDate != null)
        {
            var selectedComments = GetCommentsForDate(_selectedDate);
            <div class="overflow-hidden border-b">
                <div class="px-4 py-3">
                    <div class="mb-3 flex items-center justify-between">
                        <span class="text-sm font-medium">
                            @FormatSelectedDate(_selectedDate)
                        </span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                            @selectedComments.Length @(selectedComments.Length == 1 ? "comment" : "comments")
                        </BadgeCn>
                    </div>
                    <div class="space-y-2">
                        @foreach (var comment in selectedComments)
                        {
                            <div class="rounded-md bg-muted/30 p-3">
                                <span class="block text-xs font-medium">@comment.Author</span>
                                <p class="mt-1 text-sm text-muted-foreground">@comment.Content</p>
                            </div>
                        }
                        @if (selectedComments.Length == 0)
                        {
                            <p class="py-4 text-center text-xs text-muted-foreground">
                                No comments on this date
                            </p>
                        }
                    </div>
                </div>
            </div>
        }

        @* Legend *@
        <div class="flex items-center gap-2 px-4 py-2.5 text-xs text-muted-foreground">
            <span class="size-2 rounded-full bg-blue-500"></span>
            <span>Days with comments</span>
        </div>

    </div>
</section>

@code {
    private readonly int _currentMonth = 3; // April (0-indexed)
    private readonly int _currentYear = 2026;
    private string? _selectedDate = "2026-04-04";

    private record Comment(string Id, string Author, string Content, string Date);

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen",   "This component library is excellent",  "2026-04-01"),
        new("2", "James Wilson", "How do I integrate this?",             "2026-04-01"),
        new("3", "Maya Patel",   "Dark mode works perfectly",            "2026-04-03"),
        new("4", "Alex Morgan",  "TypeScript support is great",          "2026-04-03"),
        new("5", "Chris Taylor", "Found a bug in the tooltip",           "2026-04-04"),
        new("6", "Jordan Lee",   "Great documentation",                  "2026-04-04"),
        new("7", "Taylor Swift", "Love the animations",                  "2026-04-04"),
    ];

    private static readonly string[] _daysOfWeek = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    private static readonly string[] _monthNames =
    [
        "January", "February", "March", "April", "May", "June",
        "July", "August", "September", "October", "November", "December",
    ];

    private record CalendarDay(int Day, string Date, Comment[] Comments);

    private CalendarDay?[] _calendarDays => BuildCalendar(_currentMonth, _currentYear);

    private CalendarDay?[] BuildCalendar(int month, int year)
    {
        var daysInMonth = DateTime.DaysInMonth(year, month + 1);
        var firstDay = (int)new DateTime(year, month + 1, 1).DayOfWeek;
        var days = new CalendarDay?[42];
        for (int i = 0; i < 42; i++)
        {
            var dayNumber = i - firstDay + 1;
            if (dayNumber < 1 || dayNumber > daysInMonth)
            {
                days[i] = null;
            }
            else
            {
                var dateStr = $"{year}-{(month + 1).ToString().PadLeft(2, '0')}-{dayNumber.ToString().PadLeft(2, '0')}";
                days[i] = new CalendarDay(dayNumber, dateStr, GetCommentsForDate(dateStr));
            }
        }
        return days;
    }

    private static Comment[] GetCommentsForDate(string date) =>
        _comments.Where(c => c.Date == date).ToArray();

    private static string FormatSelectedDate(string date)
    {
        if (DateTime.TryParse(date, out var dt))
        {
            return dt.ToString("dddd, MMMM d");
        }
        return date;
    }
}
