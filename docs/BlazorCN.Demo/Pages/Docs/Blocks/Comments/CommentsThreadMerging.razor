@* ============================================================
   Block: comments-thread-merging
   Title: CommentsThreadMerging
   Description: React comment block for Next.js with duplicate thread detection, merge preview, and conversation consolidation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-thread-merging.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Duplicate threads detected</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_duplicateThreads.Length similar threads · @_totalReplies total replies
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 text-[10px] font-normal">
                    <LucideIconCn Name="git-merge" Size="10" Class="size-2.5" />
                    Merge mode
                </BadgeCn>
            </div>
        </div>

        @* Merge mode notice *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2 rounded-md bg-amber-500/10 px-3 py-2">
                <LucideIconCn Name="git-merge" Size="14" Class="size-3.5 text-amber-600 dark:text-amber-400" />
                <span class="text-xs text-amber-600 dark:text-amber-400">
                    Select primary thread to merge duplicates into
                </span>
            </div>
        </div>

        @* Thread list *@
        <div>
            @foreach (var thread in _duplicateThreads)
            {
                var t = thread;
                var isLast = t.Id == _duplicateThreads[_duplicateThreads.Length - 1].Id;
                var isSelected = _selectedPrimary == t.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _selectedPrimary = t.Id)"
                        class="@Cn.Merge("flex w-full items-start gap-3 px-4 py-4 text-left transition-colors hover:bg-muted/50", isSelected ? "bg-muted/30" : "")">
                        <div class="@Cn.Merge("mt-1 flex size-4 shrink-0 items-center justify-center rounded-full border-2 transition-colors", isSelected ? "border-foreground bg-foreground" : "border-muted-foreground/40")">
                            @if (isSelected)
                            {
                                <span class="size-2 rounded-full bg-background"></span>
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@t.Title</span>
                                @if (isSelected)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                        Primary
                                    </BadgeCn>
                                }
                            </div>
                            <div class="mt-1 flex items-center gap-2">
                                <span class="text-xs text-muted-foreground">@t.Author</span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="text-xs text-muted-foreground">@t.Timestamp</span>
                                <span class="text-xs text-muted-foreground">·</span>
                                <span class="text-xs text-muted-foreground">
                                    @t.ReplyCount replies
                                </span>
                            </div>
                            <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
                                @t.Content
                            </p>
                            <div class="mt-2 flex items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="text-[10px] font-normal">
                                    @t.Similarity% similar
                                </BadgeCn>
                            </div>
                        </div>
                    </button>
                </div>
            }
        </div>

        @* Merge preview + action *@
        <div class="border-t px-4 py-3">
            <div class="mb-3 rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 text-xs font-medium text-muted-foreground">Merge preview</div>
                <div class="space-y-1.5 text-xs text-muted-foreground">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Keep primary thread title and content</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Merge @_duplicates.Length duplicate threads</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Combine @_totalReplies replies in chronological order</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Add merge notice to primary thread</span>
                    </div>
                </div>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full gap-1 text-xs" OnClick="HandleMerge">
                @if (_mergeComplete)
                {
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    @:Merged successfully
                }
                else
                {
                    <LucideIconCn Name="git-merge" Size="12" Class="size-3" />
                    @:Merge @(_duplicates.Length) duplicate threads
                }
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record Thread(string Id, string Title, string Author, string Timestamp, int ReplyCount, string Content, int Similarity);

    private static readonly Thread[] _duplicateThreads =
    [
        new("1",
            "TypeScript migration breaking production builds",
            "Sarah Chen",
            "2 hours ago",
            8,
            "After migrating to TypeScript, our production builds are failing with type errors that don't appear in development.",
            92),
        new("2",
            "Production build fails after TS migration",
            "Alex Morgan",
            "1 hour ago",
            5,
            "The TypeScript migration is causing build failures in production. Development builds work fine but production throws type errors.",
            89),
        new("3",
            "TS type errors only in production",
            "Maya Patel",
            "45 min ago",
            3,
            "Has anyone else experienced TypeScript type errors that only show up in production builds?",
            85),
    ];

    private string _selectedPrimary = "1";
    private bool _mergeComplete = false;

    private Thread[] _duplicates => _duplicateThreads.Where(t => t.Id != _selectedPrimary).ToArray();
    private int _totalReplies => _duplicateThreads.Sum(t => t.ReplyCount);

    private void HandleMerge()
    {
        _mergeComplete = true;
        // Reset after 3 seconds is not straightforward without a timer — leave as toggled
    }
}
