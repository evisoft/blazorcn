@* ============================================================
   Block: comments-engagement-metrics
   Title: CommentsEngagementMetrics
   Description: A comment engagement analytics dashboard for React and Next.js with activity charts, trend visualization, engagement rates, and time-series graphs built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-engagement-metrics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Engagement Metrics</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Last 7 days</p>
        </div>

        @* Metrics grid *@
        <div class="grid grid-cols-3 border-b">
            @for (int i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                var isLast = i == _metrics.Length - 1;
                <div class="@Cn.Merge("px-4 py-3", !isLast ? "border-r" : "")">
                    <div class="mb-1 flex items-center gap-1.5">
                        <LucideIconCn Name="@metric.IconName" Size="14" Class="size-3.5 text-muted-foreground/60" />
                        <span class="text-xs text-muted-foreground">@metric.Label</span>
                    </div>
                    <div class="flex items-baseline gap-2">
                        <span class="text-2xl font-semibold tabular-nums">@metric.Value</span>
                        @if (metric.Label == "Reply rate")
                        {
                            <span class="text-xs text-muted-foreground">%</span>
                        }
                    </div>
                    <div class="mt-1 flex items-center gap-1">
                        @if (metric.Trend == "up")
                        {
                            <LucideIconCn Name="arrow-up" Size="12" Class="size-3 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="arrow-down" Size="12" Class="size-3 text-red-500" />
                        }
                        <span class="@Cn.Merge("text-xs", metric.Trend == "up" ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                            @(Math.Abs(metric.Change))%
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Daily activity chart *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Daily activity</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    Comments
                </BadgeCn>
            </div>
            <div class="flex items-end justify-between gap-2" style="height:120px">
                @foreach (var item in _chartData)
                {
                    var heightPct = (item.Value * 100.0 / _maxValue);
                    <div class="flex flex-1 flex-col items-center gap-2">
                        <div class="relative w-full flex items-end" style="height:96px">
                            <div class="w-full rounded-t-sm bg-primary" style="@(FormattableString.Invariant($"height:{heightPct:F1}%;min-height:8px"))"></div>
                        </div>
                        <span class="text-[10px] text-muted-foreground">@item.Day</span>
                    </div>
                }
            </div>
        </div>

        @* Avg / Peak summary *@
        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <span class="text-xs text-muted-foreground">Avg per day</span>
                <div class="mt-1 text-lg font-semibold tabular-nums">178</div>
            </div>
            <div class="px-4 py-3">
                <span class="text-xs text-muted-foreground">Peak day</span>
                <div class="mt-1 text-lg font-semibold tabular-nums">223</div>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>7 day trend</span>
                <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                <span>Updated 5 min ago</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record Metric(string Label, int Value, double Change, string Trend, string IconName);

    private record ChartPoint(string Day, int Value);

    private static readonly Metric[] _metrics =
    [
        new("Total comments", 1247, 12.5, "up",   "message-circle"),
        new("Active users",    342,  8.3, "up",   "users"),
        new("Reply rate",       68, -3.2, "down", "trending-up"),
    ];

    private static readonly ChartPoint[] _chartData =
    [
        new("Mon", 145),
        new("Tue", 178),
        new("Wed", 132),
        new("Thu", 195),
        new("Fri", 223),
        new("Sat", 187),
        new("Sun", 187),
    ];

    private static readonly int _maxValue = _chartData.Max(d => d.Value);
}
