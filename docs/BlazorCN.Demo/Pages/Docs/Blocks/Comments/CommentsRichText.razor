@* ============================================================
   Block: comments-rich-text
   Title: CommentsRichText
   Description: A rich text comment editor for React and Next.js with formatting toolbar, markdown preview, and styled output built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-rich-text.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Rich Text Comments</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">Markdown formatting supported</p>
        </div>

        @* Editor / toolbar *@
        <div class="border-b p-4">
            <div class="mb-2 flex items-center gap-1 rounded-md bg-muted/30 p-1">
                <button class="inline-flex h-7 w-8 items-center justify-center rounded hover:bg-accent" @onclick="@(() => InsertFormat("**", "**"))" aria-label="Bold">
                    <LucideIconCn Name="bold" Size="14" Class="size-3.5" />
                </button>
                <button class="inline-flex h-7 w-8 items-center justify-center rounded hover:bg-accent" @onclick="@(() => InsertFormat("*", "*"))" aria-label="Italic">
                    <LucideIconCn Name="italic" Size="14" Class="size-3.5" />
                </button>
                <button class="inline-flex h-7 w-8 items-center justify-center rounded hover:bg-accent" @onclick="@(() => InsertFormat("`", "`"))" aria-label="Code">
                    <LucideIconCn Name="code" Size="14" Class="size-3.5" />
                </button>
                <button class="inline-flex h-7 w-8 items-center justify-center rounded hover:bg-accent" @onclick="@(() => InsertFormat("[", "](url)"))" aria-label="Insert link">
                    <LucideIconCn Name="link" Size="14" Class="size-3.5" />
                </button>
                <button class="inline-flex h-7 w-8 items-center justify-center rounded hover:bg-accent" @onclick="@(() => InsertFormat("- ", ""))" aria-label="Bulleted list">
                    <LucideIconCn Name="list" Size="14" Class="size-3.5" />
                </button>
                <div class="mx-1 h-4 w-px bg-border"></div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => _showPreview = !_showPreview)">
                    @(_showPreview ? "Edit" : "Preview")
                </ButtonCn>
            </div>

            @if (_showPreview)
            {
                <div class="prose prose-sm dark:prose-invert min-h-[120px] rounded-md border bg-muted/20 p-3 text-sm">
                    @((MarkupString)RenderPreview(_content))
                </div>
            }
            else
            {
                <TextareaCn @bind-Value="_content" Placeholder="@("Write a comment... Use **bold**, *italic*, `code`, or [links](url)")" Class="min-h-[120px] font-mono text-sm" aria-label="@("Write a comment... Use **bold**, *italic*, `code`, or [links](url)")" />
            }

            <div class="mt-2 flex items-center justify-between">
                <span class="text-xs text-muted-foreground">Markdown supported</span>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var comment in _existingComments)
            {
                var c = comment;
                var initials = GetInitials(c.Author);
                <div class="p-4">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@c.Author</span>
                                <span class="text-xs text-muted-foreground">@c.Timestamp</span>
                            </div>
                            <div class="prose prose-sm mt-1 dark:prose-invert max-w-none text-sm leading-relaxed">
                                @((MarkupString)RenderContent(c.Content))
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record RichComment(string Id, string Author, string Avatar, string Content, string Timestamp);

    private static readonly RichComment[] _existingComments =
    [
        new("1", "Dev Lead", "",
            "The new **API endpoints** are working great, but we should add rate limiting before launch.\n\nHere's a quick example:\n```typescript\nconst limiter = rateLimit({\n  windowMs: 15 * 60 * 1000,\n  max: 100\n});\n```\n\nSee the [rate limiting docs](https://example.com/docs) for details.",
            "2h ago"),
        new("2", "QA Engineer", "",
            "Tested the authentication flow and found these issues:\n\n- Login with *invalid credentials* shows a generic error\n- Session timeout is too aggressive (5 min)\n- `refresh_token` endpoint returns 500 on edge cases\n\nOverall looking good though!",
            "1h ago"),
    ];

    private string _content = "";
    private bool _showPreview = false;

    private void InsertFormat(string before, string after)
    {
        _content = _content + before + after;
    }

    private static string GetInitials(string author)
    {
        var parts = author.Split(' ');
        var initials = "";
        foreach (var p in parts)
        {
            if (p.Length > 0) initials += char.ToUpper(p[0]);
        }
        return initials;
    }

    private static string RenderContent(string text)
    {
        var html = text;

        // fenced code blocks first
        html = System.Text.RegularExpressions.Regex.Replace(
            html,
            @"```(\w+)?\n([\s\S]*?)```",
            m => "<pre class=\"my-2 overflow-x-auto rounded-md bg-zinc-950 p-3 font-mono text-xs\"><code class=\"text-zinc-100\">" + m.Groups[2].Value.Trim() + "</code></pre>");

        // inline bold, italic, code
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*(.+?)\*", "<em>$1</em>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"`(.+?)`", "<code>$1</code>");
        // links
        html = System.Text.RegularExpressions.Regex.Replace(
            html,
            @"\[(.+?)\]\((.+?)\)",
            "<a href=\"$2\" class=\"text-blue-600 dark:text-blue-400 hover:underline\">$1</a>");

        // list items
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^- (.*)$", "<li class=\"ml-4\">$1</li>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"(<li.*</li>\n?)+", "<ul class=\"my-2 list-disc\">$0</ul>");

        // paragraphs
        html = html.Replace("\n\n", "</p><p class=\"mt-2\">");
        html = "<p>" + html + "</p>";

        return html;
    }

    private static string RenderPreview(string text)
    {
        if (string.IsNullOrEmpty(text))
            return "<p class='text-muted-foreground'>Nothing to preview</p>";

        var html = text;

        // fenced code blocks first
        html = System.Text.RegularExpressions.Regex.Replace(
            html,
            @"```(\w+)?\n([\s\S]*?)```",
            m => "<pre class=\"my-2 rounded-md bg-zinc-950 p-3 font-mono text-xs\"><code class=\"text-zinc-100\">" + m.Groups[2].Value.Trim() + "</code></pre>");

        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*(.+?)\*", "<em>$1</em>");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"`(.+?)`", "<code>$1</code>");
        html = System.Text.RegularExpressions.Regex.Replace(
            html,
            @"\[(.+?)\]\((.+?)\)",
            "<a href=\"$2\" class=\"text-blue-600 dark:text-blue-400\">$1</a>");

        html = html.Replace("\n\n", "</p><p class='mt-2'>");
        html = "<p>" + html + "</p>";

        return html;
    }
}
