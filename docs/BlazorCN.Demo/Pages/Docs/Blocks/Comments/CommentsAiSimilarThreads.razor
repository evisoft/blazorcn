@* ============================================================
   Block: comments-ai-similar-threads
   Title: CommentsAiSimilarThreads
   Description: An AI-powered similar threads comment system for React and Next.js with semantic search, related discussion suggestions, relevance scores, and thread navigation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-ai-similar-threads.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Discussion</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_comments.Length @(_comments.Length == 1 ? "comment" : "comments")
            </p>
        </div>

        @* Similar Threads *@
        <div class="border-b bg-muted/30 p-4">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-blue-600 dark:text-blue-400" />
                <span class="text-sm font-medium">Similar Threads</span>
            </div>
            <div class="space-y-3">
                @foreach (var thread in _similarThreads)
                {
                    var t = thread;
                    <button type="button" class="w-full rounded-md border bg-card p-3 text-left transition-all hover:bg-muted/50">
                        <div class="mb-2 flex items-start justify-between gap-2">
                            <span class="text-sm font-medium leading-tight">@t.Title</span>
                            <div class="flex shrink-0 items-center gap-1.5">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                    @t.Relevance% match
                                </BadgeCn>
                                <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground" />
                            </div>
                        </div>
                        <p class="mb-2 line-clamp-2 text-xs text-muted-foreground">@t.Preview</p>
                        <div class="flex items-center gap-3">
                            <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                <LucideIconCn Name="message-circle" Size="12" Class="size-3" />
                                @t.CommentCount
                            </div>
                            <div class="flex items-center gap-1.5">
                                @foreach (var topic in t.Topics)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                        @topic
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                    </button>
                }
            </div>
        </div>

        @* New comment form *@
        <div class="border-b p-4">
            <TextareaCn @bind-Value="_newComment" Placeholder="Add a comment..." Class="min-h-[100px]" />
            <div class="mt-2 flex justify-end">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Post comment
                </ButtonCn>
            </div>
        </div>

        @* Comments list *@
        <div class="divide-y">
            @foreach (var comment in _comments)
            {
                var c = comment;
                var initials = GetInitials(c.Author);
                <div class="p-4">
                    <div class="flex gap-3">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-baseline gap-2">
                                <span class="text-sm font-medium">@c.Author</span>
                                <span class="text-xs text-muted-foreground">@c.Timestamp</span>
                            </div>
                            <p class="mt-1 text-sm leading-relaxed">@c.Content</p>
                        </div>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Comment(string Id, string Author, string Content, string Timestamp);

    private record SimilarThread(string Id, string Title, string Preview, int CommentCount, int Relevance, string[] Topics);

    private static readonly Comment[] _comments =
    [
        new("1", "Sarah Chen",
            "Having issues with OAuth authentication redirects. The callback URL returns a 404 error after successful login with Google.",
            "2 hours ago"),
        new("2", "Alex Morgan",
            "Make sure your redirect URI is registered in the OAuth app settings.",
            "2 hours ago"),
        new("3", "Maya Patel",
            "I had the same issue. Check if your environment variables are configured correctly.",
            "1 hour ago"),
    ];

    private static readonly SimilarThread[] _similarThreads =
    [
        new("t1",
            "OAuth callback 404 error with Azure AD",
            "After implementing Azure AD authentication, the callback endpoint returns 404. Verified redirect URIs are correct in app registration...",
            12, 95,
            ["oauth", "authentication", "callbacks"]),
        new("t2",
            "Google OAuth redirect not working in production",
            "OAuth works fine in development but breaks in production environment. Getting 404 on redirect_uri. Environment variables are set...",
            8, 89,
            ["oauth", "google", "production"]),
        new("t3",
            "Fixing OAuth redirect URI mismatch errors",
            "Common OAuth redirect issues and solutions. Make sure your redirect_uri matches exactly between your code and OAuth provider settings...",
            15, 82,
            ["oauth", "troubleshooting", "configuration"]),
    ];

    private string _newComment = "";

    private static string GetInitials(string name) =>
        string.Concat(name.Split(' ').Select(n => char.ToUpper(n[0])));
}
