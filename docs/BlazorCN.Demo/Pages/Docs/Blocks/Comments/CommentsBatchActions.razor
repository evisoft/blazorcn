@* ============================================================
   Block: comments-batch-actions
   Title: CommentsBatchActions
   Description: A comment management block for React and Next.js with multi-select, bulk operations, and action confirmation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-batch-actions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Manage Comments</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @_items.Count total · @_selected.Count selected
            </p>
        </div>

        @* Bulk Action Bar (visible when items are selected) *@
        @if (_selected.Count > 0)
        {
            <div class="overflow-hidden border-b bg-muted/30">
                <div class="flex items-center justify-between px-4 py-2.5">
                    <span class="text-xs font-medium">@_selected.Count selected</span>
                    <div class="flex items-center gap-1">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="HandleBulkApprove">
                            <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                            Approve
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="HandleBulkSpam">
                            <LucideIconCn Name="shield-x" Size="12" Class="size-3" />
                            Spam
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs text-red-600 hover:text-red-700" OnClick="HandleBulkDelete">
                            <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                            Delete
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

        <div>
            @* Select All Row *@
            <div class="flex items-center gap-3 border-b bg-muted/20 px-4 py-2.5">
                <CheckboxCn Checked="@_allSelected" CheckedChanged="@((bool v) => ToggleAll())" Class="@Cn.Merge(_someSelected ? "data-[state=checked]:bg-muted-foreground" : "")" />
                <span class="text-xs font-medium text-muted-foreground">Select all</span>
            </div>

            @* Comment Items *@
            @for (int i = 0; i < _items.Count; i++)
            {
                var comment = _items[i];
                var isLast = i == _items.Count - 1;
                var isSelected = _selected.Contains(comment.Id);
                var initials = GetInitials(comment.Author);
                var statusDotClass = GetStatusColor(comment.Status);
                var capturedId = comment.Id;

                <div class="@(isLast ? "" : "border-b")">
                    <label class="@Cn.Merge("flex w-full cursor-pointer items-start gap-3 px-4 py-3 transition-colors", isSelected ? "bg-muted/50" : "hover:bg-muted/30")">
                        <CheckboxCn Checked="@isSelected" CheckedChanged="@((bool v) => ToggleItem(capturedId))" Class="mt-0.5" />
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@comment.Author</span>
                                <span class="@Cn.Merge("size-1.5 rounded-full", statusDotClass)"></span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px] font-normal">
                                    @comment.Status
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-sm leading-relaxed text-muted-foreground">
                                @comment.Content
                            </p>
                            <span class="mt-1 block text-xs text-muted-foreground">
                                @comment.Timestamp
                            </span>
                        </div>
                    </label>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                @_items.Count(c => c.Status == "approved") approved · @_items.Count(c => c.Status == "pending") pending
            </span>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="ClearSelection">
                Clear selection
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record CommentItem(string Id, string Author, string Content, string Timestamp, string Status);

    private static readonly CommentItem[] _initialComments =
    [
        new("1", "Sarah Chen",   "This component library is exactly what I needed. The attention to detail is impressive.",  "2 hours ago", "approved"),
        new("2", "James Wilson", "Has anyone tested this with Next.js 16? Looking to migrate our project.",                  "3 hours ago", "pending"),
        new("3", "Maya Patel",   "The dark mode support is flawless. Works perfectly with our existing theme.",              "5 hours ago", "approved"),
        new("4", "Anonymous User","Click here for free stuff! Limited time offer!!!",                                        "6 hours ago", "spam"),
        new("5", "Alex Morgan",  "Agreed! The TypeScript support makes integration so much smoother.",                      "7 hours ago", "pending"),
    ];

    private List<CommentItem> _items = _initialComments.ToList();
    private HashSet<string> _selected = [];

    private bool _allSelected => _items.Count > 0 && _selected.Count == _items.Count;
    private bool _someSelected => _selected.Count > 0 && _selected.Count < _items.Count;

    private void ToggleAll()
    {
        if (_allSelected)
            _selected = [];
        else
            _selected = _items.Select(c => c.Id).ToHashSet();
    }

    private void ToggleItem(string id)
    {
        if (_selected.Contains(id))
            _selected.Remove(id);
        else
            _selected.Add(id);
    }

    private void HandleBulkApprove()
    {
        _items = _items.Select(c => _selected.Contains(c.Id) ? c with { Status = "approved" } : c).ToList();
        _selected = [];
    }

    private void HandleBulkSpam()
    {
        _items = _items.Select(c => _selected.Contains(c.Id) ? c with { Status = "spam" } : c).ToList();
        _selected = [];
    }

    private void HandleBulkDelete()
    {
        _items = _items.Where(c => !_selected.Contains(c.Id)).ToList();
        _selected = [];
    }

    private void ClearSelection()
    {
        _selected = [];
    }

    private static string GetInitials(string author)
    {
        return string.Concat(author.Split(' ').Select(n => n.Length > 0 ? n[0].ToString().ToUpper() : ""));
    }

    private static string GetStatusColor(string status) => status switch
    {
        "pending"  => "bg-amber-500",
        "approved" => "bg-emerald-500",
        "spam"     => "bg-red-500",
        _          => "",
    };
}
