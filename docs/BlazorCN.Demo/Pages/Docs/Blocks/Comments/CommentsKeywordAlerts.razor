@* ============================================================
   Block: comments-keyword-alerts
   Title: CommentsKeywordAlerts
   Description: A comment keyword alert system for React and Next.js with pattern matching, priority levels, notification triggers, and alert history built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-keyword-alerts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">Keyword Alerts</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">@_pendingCount pending alerts</p>
        </div>

        @* Search and filter bar *@
        <div class="border-b px-4 py-3">
            <div class="mb-3 flex items-center gap-2">
                <LucideIconCn Name="search" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                <InputCn @bind-Value="_search" Placeholder="Search alerts..." Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" aria-label="Search alerts..." />
            </div>
            <div class="flex items-center gap-2">
                <button type="button" @onclick="@(() => _filter = "all")"
                    class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == "all" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                    All alerts
                </button>
                <button type="button" @onclick="@(() => _filter = "pending")"
                    class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == "pending" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                    Pending
                </button>
                <button type="button" @onclick="@(() => _filter = "resolved")"
                    class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == "resolved" ? "bg-background text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")">
                    Resolved
                </button>
            </div>
        </div>

        @* Alert list *@
        <div>
            @{
                var filteredAlerts = GetFilteredAlerts();
            }
            @if (filteredAlerts.Length > 0)
            {
                @foreach (var alertItem in filteredAlerts)
                {
                    var item = alertItem;
                    var isLast = item.Id == filteredAlerts[filteredAlerts.Length - 1].Id;
                    <div class="@(isLast ? "" : "border-b")">
                        <div class="px-4 py-3">
                            <div class="flex items-start gap-3">
                                <span class="@Cn.Merge("mt-1 size-2 shrink-0 rounded-full", PriorityColor(item.Priority))" />
                                <div class="min-w-0 flex-1">
                                    <div class="mb-1 flex items-center gap-2">
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("text-xs font-normal", PriorityBadge(item.Priority))">
                                            @item.Keyword
                                        </BadgeCn>
                                        <span class="text-xs text-muted-foreground">·</span>
                                        <span class="text-xs text-muted-foreground">@item.Author</span>
                                        <span class="text-xs text-muted-foreground">·</span>
                                        <span class="text-xs text-muted-foreground">@item.Timestamp</span>
                                        @if (item.Status == "resolved")
                                        {
                                            <LucideIconCn Name="check-circle" Size="16" Class="ml-auto size-4 text-emerald-500" />
                                        }
                                    </div>
                                    <p class="text-sm leading-relaxed">@item.Comment</p>
                                    @if (item.Status == "pending")
                                    {
                                        <div class="mt-2 flex items-center gap-2">
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                                <LucideIconCn Name="bell" Size="12" Class="size-3" />
                                                Notify team
                                            </ButtonCn>
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                                <LucideIconCn Name="check-circle" Size="12" Class="size-3" />
                                                Mark resolved
                                            </ButtonCn>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="px-4 py-8 text-center">
                    <LucideIconCn Name="alert-circle" Size="32" Class="mx-auto mb-2 size-8 text-muted-foreground/40" />
                    <p class="text-sm text-muted-foreground">No alerts found</p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-3 text-xs text-muted-foreground">
                <span>@_keywords.Length keywords tracked</span>
                <span class="size-1 rounded-full bg-muted-foreground/40" />
                <span>@_alerts.Length total alerts</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record Keyword(string Id, string Pattern, string Priority, bool Notify, int Matches);
    private record AlertItem(string Id, string Keyword, string Priority, string Comment, string Author, string Timestamp, string Status);

    private static readonly Keyword[] _keywords =
    [
        new("1", "refund", "high", true, 12),
        new("2", "bug", "medium", true, 34),
        new("3", "pricing", "medium", false, 8),
        new("4", "competitor", "low", false, 5),
    ];

    private static readonly AlertItem[] _alerts =
    [
        new("1", "refund", "high", "I need a refund for my subscription. The service isn't working as advertised.", "Sarah Chen", "5 min ago", "pending"),
        new("2", "bug", "medium", "Found a bug in the checkout flow that prevents payment submission.", "Alex Morgan", "1 hour ago", "pending"),
        new("3", "refund", "high", "Requested refund 3 days ago, no response yet. Very disappointed.", "James Wilson", "2 hours ago", "resolved"),
        new("4", "pricing", "medium", "Your pricing is higher than your competitor's basic plan.", "Maya Patel", "3 hours ago", "resolved"),
    ];

    private string _search = "";
    private string _filter = "all";

    private int _pendingCount => _alerts.Count(a => a.Status == "pending");

    private AlertItem[] GetFilteredAlerts()
    {
        var search = _search.ToLowerInvariant();
        return _alerts.Where(a =>
        {
            var matchesSearch = string.IsNullOrEmpty(search) ||
                a.Comment.ToLowerInvariant().Contains(search) ||
                a.Keyword.ToLowerInvariant().Contains(search);
            var matchesFilter = _filter == "all" || a.Status == _filter;
            return matchesSearch && matchesFilter;
        }).ToArray();
    }

    private static string PriorityColor(string priority) => priority switch
    {
        "high" => "bg-red-500",
        "medium" => "bg-amber-500",
        "low" => "bg-blue-500",
        _ => ""
    };

    private static string PriorityBadge(string priority) => priority switch
    {
        "high" => "border-red-500/20 bg-red-500/10 text-red-700 dark:text-red-400",
        "medium" => "border-amber-500/20 bg-amber-500/10 text-amber-700 dark:text-amber-400",
        "low" => "border-blue-500/20 bg-blue-500/10 text-blue-700 dark:text-blue-400",
        _ => ""
    };
}
