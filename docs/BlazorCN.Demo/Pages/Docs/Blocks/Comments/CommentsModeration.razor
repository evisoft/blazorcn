@* ============================================================
   Block: comments-moderation
   Title: CommentsModeration
   Description: An admin comment moderation interface for React and Next.js with flag review, bulk actions, and approval queue built with shadcn/ui and Tailwind CSS
   Source: original/blocks/comments/comments-moderation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-sm font-medium">Moderation Queue</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_comments.Count flagged comments pending review
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        <span class="text-xs text-muted-foreground">@_comments.Count(c => c.Severity == "high")</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        <span class="text-xs text-muted-foreground">@_comments.Count(c => c.Severity == "medium")</span>
                    </div>
                    <div class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-blue-500"></span>
                        <span class="text-xs text-muted-foreground">@_comments.Count(c => c.Severity == "low")</span>
                    </div>
                </div>
            </div>
        </div>

        @* Bulk action bar — visible when something is selected *@
        @if (_selected.Count > 0)
        {
            <div class="overflow-hidden border-b bg-muted/30">
                <div class="flex items-center justify-between px-4 py-2">
                    <span class="text-xs font-medium">@_selected.Count selected</span>
                    <div class="flex gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="BulkApprove">
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                            Approve all
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="BulkReject">
                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                            Reject all
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }

        @* Select-all row *@
        <div class="border-b px-4 py-2">
            <span class="flex items-center gap-2">
                <CheckboxCn Checked="@(_selected.Count == _comments.Count && _comments.Count > 0)" CheckedChanged="@(_ => ToggleAll())" />
                <span class="text-xs text-muted-foreground">Select all</span>
            </span>
        </div>

        @* Comment list *@
        <div class="divide-y">
            @foreach (var item in _comments.ToList())
            {
                var comment = item;
                var isSelected = _selected.Contains(comment.Id);
                var sev = SeverityConfig[comment.Severity];
                var initials = comment.Author.Length >= 2 ? comment.Author[..2].ToUpper() : comment.Author.ToUpper();

                <div class="@Cn.Merge("flex gap-3 px-4 py-3 transition-colors", isSelected ? "bg-muted/50" : "")">
                    <span class="flex shrink-0 items-start pt-0.5">
                        <CheckboxCn Checked="@isSelected" CheckedChanged="@(_ => ToggleSelect(comment.Id))" />
                    </span>

                    <div class="min-w-0 flex-1">
                        <div class="flex items-start justify-between gap-3">
                            <div class="flex items-center gap-2">
                                <AvatarCn Class="size-6">
                                    <AvatarImageCn Src="@comment.Avatar" Alt="@comment.Author" />
                                    <AvatarFallbackCn Class="text-[10px]">@initials</AvatarFallbackCn>
                                </AvatarCn>
                                <span class="text-xs font-medium">@comment.Author</span>
                                <span class="text-xs text-muted-foreground">@comment.Timestamp</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", sev.Bg)"></span>
                                <span class="@Cn.Merge("text-xs font-medium", sev.Color)">@sev.Label</span>
                            </div>
                        </div>

                        <p class="mt-2 text-sm leading-relaxed text-foreground">@comment.Content</p>

                        <div class="mt-2 flex items-center gap-3">
                            <div class="flex items-center gap-1.5">
                                <LucideIconCn Name="flag" Size="12" Class="size-3 text-muted-foreground" />
                                <span class="text-xs text-muted-foreground">@ReasonLabels[comment.FlagReason]</span>
                            </div>
                            <span class="size-1 rounded-full bg-muted-foreground/40"></span>
                            <span class="text-xs text-muted-foreground">Flagged by @comment.FlaggedBy @comment.FlaggedAt</span>
                        </div>

                        <div class="mt-3 flex gap-2">
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" OnClick="@(() => Approve(comment.Id))">
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                                Approve
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs text-red-600 hover:text-red-600 dark:text-red-400" OnClick="@(() => Reject(comment.Id))">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                                Reject
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }

            @if (_comments.Count == 0)
            {
                <div class="px-4 py-12 text-center">
                    <LucideIconCn Name="check" Size="32" Class="mx-auto size-8 text-muted-foreground/40" />
                    <p class="mt-2 text-sm font-medium">All clear!</p>
                    <p class="mt-1 text-xs text-muted-foreground">No flagged comments to review</p>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record FlaggedComment(
        string Id,
        string Author,
        string Avatar,
        string Content,
        string Timestamp,
        string FlagReason,
        string FlaggedBy,
        string FlaggedAt,
        string Severity);

    private record SeverityInfo(string Color, string Bg, string Label);

    private static readonly Dictionary<string, string> ReasonLabels = new()
    {
        ["spam"]          = "Spam",
        ["harassment"]    = "Harassment",
        ["misinformation"] = "Misinformation",
        ["off-topic"]     = "Off-topic",
    };

    private static readonly Dictionary<string, SeverityInfo> SeverityConfig = new()
    {
        ["high"]   = new("text-red-600 dark:text-red-400",   "bg-red-500",   "High"),
        ["medium"] = new("text-amber-600 dark:text-amber-400", "bg-amber-500", "Medium"),
        ["low"]    = new("text-blue-600 dark:text-blue-400",  "bg-blue-500",  "Low"),
    };

    private List<FlaggedComment> _comments =
    [
        new("1", "user_1829", "", "Check out this amazing deal! Click here to win a free iPhone! Limited time only! [suspicious-link.com]",
            "5m ago", "spam", "sarah_chen", "2m ago", "high"),
        new("2", "angry_commenter", "", "You're completely wrong and clearly have no idea what you're talking about. People like you shouldn't even be allowed to comment.",
            "15m ago", "harassment", "mod_alex", "8m ago", "medium"),
        new("3", "conspiracy_theorist", "", "The official documentation is hiding the truth. What they're not telling you is that this framework was designed to steal your data and sell it to corporations.",
            "1h ago", "misinformation", "emma_r", "45m ago", "high"),
        new("4", "random_user_42", "", "Anyone know a good recipe for chocolate chip cookies? My grandma used to make them but I lost the recipe.",
            "2h ago", "off-topic", "james_w", "1h ago", "low"),
    ];

    private readonly HashSet<string> _selected = [];

    private void ToggleSelect(string id)
    {
        if (!_selected.Add(id))
            _selected.Remove(id);
    }

    private void ToggleAll()
    {
        if (_selected.Count == _comments.Count)
            _selected.Clear();
        else
        {
            _selected.Clear();
            foreach (var c in _comments)
                _selected.Add(c.Id);
        }
    }

    private void Approve(string id)
    {
        _comments.RemoveAll(c => c.Id == id);
        _selected.Remove(id);
    }

    private void Reject(string id)
    {
        _comments.RemoveAll(c => c.Id == id);
        _selected.Remove(id);
    }

    private void BulkApprove()
    {
        _comments.RemoveAll(c => _selected.Contains(c.Id));
        _selected.Clear();
    }

    private void BulkReject()
    {
        _comments.RemoveAll(c => _selected.Contains(c.Id));
        _selected.Clear();
    }
}
