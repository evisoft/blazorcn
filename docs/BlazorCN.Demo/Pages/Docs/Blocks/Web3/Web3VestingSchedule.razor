@* ============================================================
   Block: web3-vesting-schedule
   Title: Web3VestingSchedule
   Description: A React and Next.js token vesting schedule block built with shadcn/ui Badge, Button and Tailwind CSS for tracking unlock milestones.
   Source: original/blocks/web3/web3-vesting-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Vesting Schedule</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                @_vestedPercent% vested
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-muted-foreground text-xs">Total Allocation</p>
                    <p class="mt-0.5 font-semibold text-lg tabular-nums">@_totalAllocation</p>
                </div>
                <div class="text-right">
                    <p class="text-muted-foreground text-xs">Vested</p>
                    <p class="mt-0.5 font-semibold text-lg tabular-nums">@_totalVested</p>
                </div>
            </div>
            <div class="mt-3 h-2 overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-blue-500" style="@($"width:{_vestedPercent}%")"></div>
            </div>
        </div>

        <div>
            @foreach (var m in _milestones)
            {
                var milestone = m;
                var isLast = milestone.Id == _milestones[_milestones.Length - 1].Id;
                var isClaimed = _claimedIds.Contains(milestone.Id);
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-2 shrink-0 rounded-full", StatusColor(milestone.Status))"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@milestone.Date</span>
                            <span class="text-muted-foreground text-xs tabular-nums">@milestone.Percentage%</span>
                        </div>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs tabular-nums">@milestone.Amount</p>
                    </div>
                    @if (milestone.Status == MilestoneStatus.Claimed || isClaimed)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            Claimed
                        </BadgeCn>
                    }
                    else if (milestone.Status == MilestoneStatus.Claimable)
                    {
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" @onclick="@(() => Claim(milestone.Id))">
                            Claim
                        </ButtonCn>
                    }
                    else
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs text-muted-foreground">
                            Locked
                        </BadgeCn>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private List<string> _claimedIds = ["1"];

    private const string _totalAllocation = "250,000 PROTO";
    private const string _totalVested = "87,500 PROTO";
    private const int _vestedPercent = 35;

    private enum MilestoneStatus { Claimed, Claimable, Locked }

    private record VestingMilestone(string Id, string Date, string Amount, int Percentage, MilestoneStatus Status);

    private static readonly VestingMilestone[] _milestones =
    [
        new("1", "Jan 15, 2026", "25,000 PROTO",  10, MilestoneStatus.Claimed),
        new("2", "Apr 15, 2026", "62,500 PROTO",  25, MilestoneStatus.Claimable),
        new("3", "Jul 15, 2026", "62,500 PROTO",  25, MilestoneStatus.Locked),
        new("4", "Oct 15, 2026", "50,000 PROTO",  20, MilestoneStatus.Locked),
        new("5", "Jan 15, 2027", "50,000 PROTO",  20, MilestoneStatus.Locked),
    ];

    private static string StatusColor(MilestoneStatus status) => status switch
    {
        MilestoneStatus.Claimed  => "bg-emerald-500",
        MilestoneStatus.Claimable => "bg-blue-500",
        _                        => "bg-muted-foreground/30",
    };

    private void Claim(string id)
    {
        if (!_claimedIds.Contains(id))
            _claimedIds = [.._claimedIds, id];
    }
}
