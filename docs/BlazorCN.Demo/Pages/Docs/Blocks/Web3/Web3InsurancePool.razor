@* ============================================================
   Block: web3-insurance-pool
   Title: Web3InsurancePool
   Description: A React and Next.js DeFi insurance pool block built with shadcn/ui and Tailwind CSS. Displays coverage and premium rates.
   Source: original/blocks/web3/web3-insurance-pool.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Insurance Pools</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_purchased.Count active policies
            </BadgeCn>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Coverage</p>
                <p class="mt-0.5 font-semibold tabular-nums">$37M</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Your Coverage</p>
                <p class="mt-0.5 font-semibold tabular-nums">$150K</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Annual Cost</p>
                <p class="mt-0.5 font-semibold tabular-nums">$3,225</p>
            </div>
        </div>

        <div>
            @foreach (var pool in _pools)
            {
                var isLast = pool.Id == _pools[_pools.Length - 1].Id;
                var isPurchased = _purchased.Contains(pool.Id);
                var item = pool;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", isPurchased ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                            <span class="font-medium text-sm">@pool.Protocol</span>
                            @if (isPurchased)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    Active
                                </BadgeCn>
                            }
                        </div>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" Disabled="@isPurchased" @onclick="@(() => BuyCoverage(item.Id))">
                            @(isPurchased ? "Covered" : "Buy Coverage")
                        </ButtonCn>
                    </div>
                    <div class="mt-2 flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@pool.Coverage</span>
                        <span class="tabular-nums">@pool.Premium</span>
                    </div>
                    <div class="mt-1.5 flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">
                            Capacity: <span class="tabular-nums">@pool.Capacity</span>
                        </span>
                        <span class="tabular-nums text-muted-foreground">
                            @pool.Utilized% utilized
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private List<string> _purchased = ["1", "3"];

    private record InsurancePool(string Id, string Protocol, string Coverage, string Premium, string Capacity, int Utilized, string Status);

    private static readonly InsurancePool[] _pools =
    [
        new("1", "Aave V3",    "Smart contract exploit", "2.5%/yr", "$12M",  68, "active"),
        new("2", "Uniswap V3", "Smart contract exploit", "3.1%/yr", "$8.5M", 45, "available"),
        new("3", "Lido",       "Slashing event",         "1.8%/yr", "$25M",  82, "active"),
        new("4", "Curve",      "Smart contract exploit", "2.2%/yr", "$6M",   55, "available"),
        new("5", "Compound",   "Oracle failure",         "1.5%/yr", "$10M",  32, "available"),
    ];

    private void BuyCoverage(string id)
    {
        if (!_purchased.Contains(id))
            _purchased = [.._purchased, id];
    }
}
