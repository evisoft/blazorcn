@* ============================================================
   Block: web3-rarity-checker
   Title: Web3RarityChecker
   Description: A React and Next.js NFT rarity checker block built with shadcn/ui and Tailwind CSS. Shows trait breakdown, scores, and collection rank.
   Source: original/blocks/web3/web3-rarity-checker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Rarity Checker</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
                <InputCn @bind-Value="_tokenId"
                         Class="h-7 border-0 bg-transparent px-0 text-sm shadow-none focus-visible:ring-0"
                         Placeholder="Enter token ID..." />
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-sm">Cosmic Ape #@_tokenId</p>
                    <p class="mt-0.5 text-muted-foreground text-xs">Cosmic Apes Collection</p>
                </div>
                <div class="text-right">
                    <div class="flex items-center gap-1.5">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                            Rank #@_rank
                        </BadgeCn>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">of @_totalSupply</p>
                </div>
            </div>
            <div class="mt-3 rounded-md bg-muted/50 p-3 text-center">
                <p class="text-muted-foreground text-xs">Rarity Score</p>
                <p class="mt-0.5 font-semibold text-2xl tabular-nums">@_totalScore</p>
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Traits</span>
            </div>
            @foreach (var trait in _traits)
            {
                var isLast = trait.Category == _traits[_traits.Length - 1].Category;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <span class="text-muted-foreground text-xs">@trait.Category</span>
                        <p class="font-medium text-sm">@trait.Value</p>
                    </div>
                    <div class="text-right">
                        <span class="font-mono text-xs tabular-nums">@trait.Occurrence</span>
                        <p class="text-muted-foreground text-xs tabular-nums">+@trait.Score.ToString("F2")</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _tokenId = "4217";
    private const string _totalScore = "280.48";
    private const string _rank = "142";
    private const string _totalSupply = "10,000";

    private record Trait(string Category, string Value, string Occurrence, double Score);

    private static readonly Trait[] _traits =
    [
        new("Background", "Cosmic Purple",  "3.2%",  31.25),
        new("Body",       "Gold Fur",       "5.1%",  19.61),
        new("Eyes",       "Laser Red",      "1.8%",  55.56),
        new("Head",       "Crown",          "0.9%", 111.11),
        new("Mouth",      "Diamond Grill",  "2.4%",  41.67),
        new("Clothing",   "Space Suit",     "4.7%",  21.28),
    ];
}
