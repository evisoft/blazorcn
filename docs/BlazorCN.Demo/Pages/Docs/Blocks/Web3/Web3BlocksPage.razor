                var iconColor = tx.Direction == ""exchange-in"" ? ""text-red-600 dark:text-red-400"" : tx.Direction == ""exchange-out"" ? ""text-emerald-600 dark:text-emerald-400"" : ""text-blue-600 dark:text-blue-400"";
