                </span>
            </div>
            <ProgressCn Value=""@_quorumPercent"" Class=""h-1.5"" aria-label=""Progress"" />
            <p class=""mt-1 text-muted-foreground text-xs tabular-nums"">
                @(_quorumPercent.ToString(""F0""))% of quorum reached
            </p>
        </div>

        <div class=""border-b px-4 py-3 space-y-3"">
            <div>
                <div class=""flex items-center justify-between text-xs mb-1"">
                    <span class=""flex items-center gap-1.5"">
                        <span class=""size-1.5 rounded-full bg-emerald-500""></span>
                        For
                    </span>
                    <span class=""tabular-nums"">
                        @FormatNum(_proposal.ForVotes) (@(_forPercent.ToString(""F1""))%)
                    </span>
                </div>
                <ProgressCn Value=""@_forPercent"" Class=""h-1.5 [&>div]:bg-emerald-500"" aria-label=""Progress"" />
            </div>
            <div>
                <div class=""flex items-center justify-between text-xs mb-1"">
                    <span class=""flex items-center gap-1.5"">
                        <span class=""size-1.5 rounded-full bg-red-500""></span>
                        Against
                    </span>
                    <span class=""tabular-nums"">
                        @FormatNum(_proposal.AgainstVotes) (@(_againstPercent.ToString(""F1""))%)
                    </span>
                </div>
                <ProgressCn Value=""@_againstPercent"" Class=""h-1.5 [&>div]:bg-red-500"" aria-label=""Progress"" />
            </div>
            <div>
                <div class=""flex items-center justify-between text-xs mb-1"">
                    <span class=""flex items-center gap-1.5"">
                        <span class=""size-1.5 rounded-full bg-zinc-400""></span>
                        Abstain
                    </span>
                    <span class=""tabular-nums"">
                        @FormatNum(_proposal.AbstainVotes) (@(_abstainPercent.ToString(""F1""))%)
                    </span>
                </div>
                <ProgressCn Value=""@_abstainPercent"" Class=""h-1.5 [&>div]:bg-zinc-400"" aria-label=""Progress"" />
            </div>
        </div>

        <div class=""px-4 py-3"">
            <p class=""mb-2 text-xs font-medium text-muted-foreground"">Cast your vote</p>
            <div class=""flex gap-2"">
                <ButtonCn Variant=""@(_voted == ""for"" ? ButtonVariant.Default : ButtonVariant.Outline)""
                          Size=""ButtonSize.Sm""
                          Class=""h-8 flex-1 gap-1 text-xs""
                          OnClick=""@(() => CastVote(""for""))""
                          Disabled=""@(_voted != null)"">
                    <LucideIconCn Name=""check"" Size=""12"" Class=""size-3"" />
                    For
                </ButtonCn>
                <ButtonCn Variant=""@(_voted == ""against"" ? ButtonVariant.Default : ButtonVariant.Outline)""
                          Size=""ButtonSize.Sm""
                          Class=""h-8 flex-1 gap-1 text-xs""
                          OnClick=""@(() => CastVote(""against""))""
                          Disabled=""@(_voted != null)"">
                    <LucideIconCn Name=""x"" Size=""12"" Class=""size-3"" />
                    Against
                </ButtonCn>
                <ButtonCn Variant=""@(_voted == ""abstain"" ? ButtonVariant.Default : ButtonVariant.Outline)""
                          Size=""ButtonSize.Sm""
                          Class=""h-8 flex-1 text-xs""
                          OnClick=""@(() => CastVote(""abstain""))""
                          Disabled=""@(_voted != null)"">
                    Abstain
                </ButtonCn>
            </div>
            @if (_voted != null)
