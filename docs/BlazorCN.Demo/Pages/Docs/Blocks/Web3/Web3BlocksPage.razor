@code {
    private string? _selected = null;
    private ConnectionState _connectionState = ConnectionState.Idle;

    private enum WalletStatus { Available, Popular, New }
    private enum ConnectionState { Idle, Connecting, Connected, Error }

    private record WalletOption(string Id, string Name, string Description, WalletStatus Status);

    private static readonly WalletOption[] _wallets =
    [
        new(""metamask"",      ""MetaMask"",        ""Browser extension & mobile"",    WalletStatus.Popular),
        new(""walletconnect"", ""WalletConnect"",   ""Scan with mobile wallet"",       WalletStatus.Popular),
        new(""coinbase"",      ""Coinbase Wallet"", ""Coinbase self-custody wallet"",  WalletStatus.Available),
        new(""phantom"",       ""Phantom"",         ""Multi-chain wallet"",            WalletStatus.New),
        new(""rabby"",         ""Rabby Wallet"",    ""Smooth multi-chain experience"", WalletStatus.Available),
        new(""trust"",         ""Trust Wallet"",    ""Binance official wallet"",       WalletStatus.Available),
    ];

    private string GetWalletName(string id)
    {
        foreach (var w in _wallets)
        {
            if (w.Id == id) return w.Name;
        }
        return id;
    }

    private async Task HandleConnect(string id)
    {
        _selected = id;
        _connectionState = ConnectionState.Connecting;
        await Task.Delay(1500);
        _connectionState = ConnectionState.Connected;
    }

    private void HandleDisconnect()
    {
        _selected = null;
        _connectionState = ConnectionState.Idle;
    }
}";

