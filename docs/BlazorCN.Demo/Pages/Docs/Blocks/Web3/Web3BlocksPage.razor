                var dirLabel = tx.Direction == ""exchange-in"" ? ""Exchange Inflow"" : tx.Direction == ""exchange-out"" ? ""Exchange Outflow"" : ""Wallet Transfer"";
                <div class=""@Cn.Merge(""flex items-center gap-3 px-4 py-3"", isLast ? """" : ""border-b"")"">
                    <div class=""flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50"">
