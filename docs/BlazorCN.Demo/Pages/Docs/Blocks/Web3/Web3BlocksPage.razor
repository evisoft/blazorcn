@code {
    private string _selectedToken = ""ETH"";
    private string _amount = ""10"";
    private string _duration = ""1 year"";

    private record TokenOption(string Symbol, double Apy, double Price);

    private static readonly TokenOption[] _tokens =
    [
        new(""ETH"",   4.2,  3601.25),
        new(""SOL"",   7.1,   147.0),
        new(""ATOM"", 18.2,     8.9),
        new(""MATIC"", 5.8,     0.89),
    ];

    private static readonly string[] _durations = [""30 days"", ""90 days"", ""1 year"", ""2 years""];

    private TokenOption CurrentToken =>
        Array.Find(_tokens, t => t.Symbol == _selectedToken) ?? _tokens[0];

    private double ParsedAmount =>
        double.TryParse(_amount, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;

    private double StakeValue => ParsedAmount * CurrentToken.Price;

    private int DurationDays => _duration switch
    {
        ""30 days""  => 30,
        ""90 days""  => 90,
        ""1 year""   => 365,
        _          => 730,
    };

    private double DailyRate => CurrentToken.Apy / 365.0 / 100.0;
    private double TotalReward => StakeValue * DailyRate * DurationDays;
    private double RewardTokens => ParsedAmount * DailyRate * DurationDays;
    private double DailyEarnings => DurationDays > 0 ? RewardTokens / DurationDays : 0;
    private double MonthlyEarnings => DailyEarnings * 30;
    private double TotalAfter => ParsedAmount + RewardTokens;
}";

