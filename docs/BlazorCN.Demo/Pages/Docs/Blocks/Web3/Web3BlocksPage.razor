                    }
                    @if (step.Status == StepStatus.Current)
                    {
                        <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs text-blue-600 dark:text-blue-400"">
                            In progress
                        </BadgeCn>
                    }
                </div>
            }
        </div>

        <div class=""border-t px-4 py-3"">
            <ButtonCn Class=""h-9 w-full text-sm"" @onclick=""HandleNext"" Disabled=""@(_currentStep >= 5)"">
                @(_currentStep >= 5 ? ""Deploy to Mainnet"" : ""Continue to Next Step"")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private int _currentStep = 3;

    private enum StepStatus { Completed, Current, Upcoming }

    private record LaunchStep(int Id, string Title, string Description, StepStatus Status);

    private static readonly LaunchStep[] _initialSteps =
    [
        new(1, ""Collection Details"", ""Name, symbol, and description"", StepStatus.Completed),
        new(2, ""Upload Artwork"", ""Upload 10,000 unique images"", StepStatus.Completed),
        new(3, ""Mint Configuration"", ""Price, supply, and phases"", StepStatus.Current),
        new(4, ""Reveal Settings"", ""Instant or delayed reveal"", StepStatus.Upcoming),
        new(5, ""Deploy Contract"", ""Deploy to mainnet"", StepStatus.Upcoming),
    ];

    private LaunchStep[] GetSteps() =>
        _initialSteps
            .Select(s => s with
            {
                Status = s.Id < _currentStep
                    ? StepStatus.Completed
                    : s.Id == _currentStep
                        ? StepStatus.Current
                        : StepStatus.Upcoming
            })
            .ToArray();

    private void HandleNext()
    {
        if (_currentStep < 5) _currentStep++;
    }
}";

