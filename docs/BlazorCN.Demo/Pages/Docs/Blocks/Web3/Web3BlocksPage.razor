        _quorumPercent = Math.Min(100.0, (_proposal.TotalVotes / (double)_proposal.QuorumRequired) * 100.0);
        _forPercent = (_proposal.ForVotes / (double)_proposal.TotalVotes) * 100.0;
        _againstPercent = (_proposal.AgainstVotes / (double)_proposal.TotalVotes) * 100.0;
        _abstainPercent = (_proposal.AbstainVotes / (double)_proposal.TotalVotes) * 100.0;
    }

    private static string FormatNum(int n) => $""{(n / 1_000_000.0):F2}M"";

    private void CastVote(string choice)
    {
        if (_voted == null)
            _voted = choice;
    }
}";

