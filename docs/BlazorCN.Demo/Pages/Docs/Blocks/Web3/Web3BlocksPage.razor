@code {
    private const string NftAuctionMarketplaceCode = @"<section class=""mx-auto w-full max-w-4xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Header *@
        <div class=""flex items-center justify-between border-b px-4 py-3"">
            <div class=""flex items-center gap-2"">
                <LucideIconCn Name=""gavel"" Size=""16"" Class=""size-4 text-muted-foreground"" />
                <div>
                    <h2 class=""text-sm font-medium"">Live Auctions</h2>
                    <p class=""mt-0.5 text-xs text-muted-foreground"">
                        @_auctions.Length active · @_auctions.Sum(a => a.BidCount) total bids
                    </p>
                </div>
            </div>
            <ButtonCn Variant=""ButtonVariant.Outline"" Size=""ButtonSize.Sm"" Class=""h-7 text-xs"">
                View All
            </ButtonCn>
        </div>

        @* Auction grid *@
        <div class=""grid grid-cols-1 gap-px bg-border sm:grid-cols-2"">
            @foreach (var auction in _auctions)
            {
                var auctionId = auction.Id;
                <div class=""bg-card"">
                    @* Image *@
                    <div class=""relative aspect-square overflow-hidden"">
                        <img
                            src=""@auction.Image""
                            alt=""@auction.Title""
                            class=""size-full object-cover transition-transform duration-300 hover:scale-105"" />
                        <div class=""absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-3"">
                            <div class=""flex items-end justify-between"">
                                <div>
                                    <p class=""text-xs text-white/70"">@auction.Collection</p>
                                    <p class=""text-sm font-medium text-white"">@auction.Title</p>
                                </div>
                                <button aria-label=""Toggle favorite for @auction.Title""
                                    type=""button""
                                    @onclick=""@(() => ToggleFavorite(auctionId))""
                                    class=""flex size-7 items-center justify-center rounded-full bg-white/20 backdrop-blur-sm transition-colors hover:bg-white/30"">
                                    <LucideIconCn Name=""heart"" Size=""14"" Class=""@Cn.Merge(""size-3.5"", _favorites.Contains(auctionId) ? ""fill-red-400 text-red-400"" : ""text-white"")"" />
                                </button>
                            </div>
                        </div>
                        @* Time badge *@
                        <div class=""absolute top-3 left-3"">
                            <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""gap-1 bg-black/50 text-[10px] text-white backdrop-blur-sm"">
