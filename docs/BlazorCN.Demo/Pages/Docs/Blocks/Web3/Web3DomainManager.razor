@* ============================================================
   Block: web3-domain-manager
   Title: Web3DomainManager
   Description: A React and Next.js domain manager built with shadcn/ui and Tailwind CSS for ENS, Unstoppable, and blockchain naming services.
   Source: original/blocks/web3/web3-domain-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">My Domains</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_domains.Length domains
            </BadgeCn>
        </div>

        @* Domain list *@
        <div>
            @for (int i = 0; i < _domains.Length; i++)
            {
                var d = _domains[i];
                var isLast = i == _domains.Length - 1;
                var statusDot = _statusColors.TryGetValue(d.Status, out var color) ? color : "bg-muted";
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", statusDot)"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@d.Name</span>
                            @if (d.Primary)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Primary</BadgeCn>
                            }
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@d.Service</BadgeCn>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @(d.Expires == "Never" ? "No expiration" : $"Expires: {d.Expires}")
                        </p>
                    </div>
                    <div class="flex items-center gap-1">
                        @if (d.Status == "expiring")
                        {
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">Renew</ButtonCn>
                        }
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">Manage</ButtonCn>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Domain(string Name, string Service, string Expires, bool Primary, string Status);

    private static readonly Dictionary<string, string> _statusColors = new()
    {
        ["active"]   = "bg-emerald-500",
        ["expiring"] = "bg-amber-500",
        ["expired"]  = "bg-red-500",
    };

    private static readonly Domain[] _domains =
    [
        new("alice.eth",      "ENS",         "Dec 15, 2027", true,  "active"),
        new("alice.crypto",   "Unstoppable", "Never",        false, "active"),
        new("aliceweb3.eth",  "ENS",         "Apr 2, 2026",  false, "expiring"),
        new("alice.lens",     "Lens",        "Never",        false, "active"),
    ];
}
