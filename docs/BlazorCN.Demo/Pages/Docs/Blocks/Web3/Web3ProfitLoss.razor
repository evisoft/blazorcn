@* ============================================================
   Block: web3-profit-loss
   Title: Web3ProfitLoss
   Description: A React and Next.js crypto P&L dashboard block built with shadcn/ui and Tailwind CSS. Shows realized and unrealized gains with asset breakdown.
   Source: original/blocks/web3/web3-profit-loss.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Profit &amp; Loss</span>
            </div>
        </div>

        @* Period selector *@
        <div class="flex items-center gap-1 border-b px-4 py-2">
            @foreach (var p in _periods)
            {
                var period = p;
                <ButtonCn Variant="@(_selectedPeriod == period ? ButtonVariant.Default : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-6 px-2 text-xs"
                          OnClick="@(() => _selectedPeriod = period)">
                    @period
                </ButtonCn>
            }
        </div>

        @* P&L summary grid *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total P&amp;L</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums text-emerald-600 dark:text-emerald-400">+$3,556</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Realized</p>
                <p class="mt-0.5 font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">+$1,842</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Unrealized</p>
                <p class="mt-0.5 font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">+$1,714</p>
            </div>
        </div>

        @* Invested / Current value grid *@
        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Invested</p>
                <p class="mt-0.5 font-semibold tabular-nums">$31,900</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Current Value</p>
                <p class="mt-0.5 font-semibold tabular-nums">$35,456</p>
            </div>
        </div>

        @* By asset breakdown *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">By Asset</span>
            </div>
            @for (int i = 0; i < _assets.Length; i++)
            {
                var asset = _assets[i];
                var isLast = i == _assets.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@asset.Token</span>
                            <span class="text-muted-foreground text-xs tabular-nums">Invested: @asset.Invested</span>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">Current: @asset.CurrentValue</p>
                    </div>
                    <div class="text-right">
                        <span class="@Cn.Merge("font-mono text-sm tabular-nums", asset.Positive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                            @asset.Pnl
                        </span>
                        <p class="@Cn.Merge("mt-0.5 font-mono text-xs tabular-nums", asset.Positive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                            @asset.PnlPercent
                        </p>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record AssetPnL(string Token, string Invested, string CurrentValue, string Pnl, string PnlPercent, bool Positive);

    private static readonly string[] _periods = ["24H", "7D", "30D", "YTD", "ALL"];

    private static readonly AssetPnL[] _assets =
    [
        new("ETH",   "$12,400", "$15,432", "+$3,032", "+24.5%", true),
        new("BTC",   "$14,200", "$16,317", "+$2,117", "+14.9%", true),
        new("SOL",   "$4,500",  "$3,307",  "-$1,193", "-26.5%", false),
        new("MATIC", "$800",    "$400",    "-$400",   "-50.0%", false),
    ];

    private string _selectedPeriod = "YTD";
}
