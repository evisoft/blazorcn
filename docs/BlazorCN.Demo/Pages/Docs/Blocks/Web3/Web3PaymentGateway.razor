@* ============================================================
   Block: web3-payment-gateway
   Title: Web3PaymentGateway
   Description: A React crypto payment gateway built with Next.js, shadcn/ui, and Tailwind CSS featuring token selection and status tracking.
   Source: original/blocks/web3/web3-payment-gateway.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="credit-card" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Payment</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Order #1042
            </BadgeCn>
        </div>

        @if (_status == PaymentStatus.Confirmed)
        {
            <div class="px-4 py-8">
                <div class="flex flex-col items-center gap-3">
                    <div class="flex size-12 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="circle-check" Size="24" Class="size-6 text-emerald-600 dark:text-emerald-400" />
                    </div>
                    <p class="font-medium text-sm">Payment Confirmed</p>
                    <p class="font-mono text-muted-foreground text-xs tabular-nums">$100.00 USD</p>
                    <p class="text-muted-foreground text-xs">Transaction hash: 0x8f2a...b4c1</p>
                </div>
            </div>
        }
        else
        {
            <div class="border-b px-4 py-4 text-center">
                <p class="text-muted-foreground text-xs">Amount Due</p>
                <p class="mt-1 font-semibold text-2xl tabular-nums">$100.00</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Pro Subscription - Monthly</p>
            </div>

            <div class="border-b px-4 py-3">
                <span class="text-muted-foreground text-xs">Pay with</span>
                <div class="mt-1.5 grid grid-cols-4 gap-1.5">
                    @foreach (var tok in _supportedTokens)
                    {
                        var token = tok;
                        <button type="button"
                                @onclick="@(() => _selectedToken = token.Symbol)"
                                class="@Cn.Merge("rounded-md border px-3 py-2 text-center transition-colors", _selectedToken == token.Symbol ? "border-foreground bg-muted/50" : "hover:bg-muted/50")">
                            <p class="font-medium text-xs">@token.Symbol</p>
                            <p class="mt-0.5 font-mono text-muted-foreground text-xs tabular-nums">@token.Amount</p>
                        </button>
                    }
                </div>
            </div>

            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Send to</span>
                    <span class="font-mono">0x1a2b...c3d4</span>
                </div>
                <div class="mt-1.5 flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Network</span>
                    <span>Ethereum</span>
                </div>
                <div class="mt-1.5 flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Network fee</span>
                    <span class="tabular-nums">~$2.14</span>
                </div>
            </div>

            <div class="px-4 py-3">
                <ButtonCn Class="h-9 w-full text-sm"
                          OnClick="HandlePay"
                          Disabled="@(_status == PaymentStatus.Processing)">
                    @if (_status == PaymentStatus.Processing)
                    {
                        <span class="flex items-center gap-2">
                            <LucideIconCn Name="loader-2" Size="14" Class="size-3.5 animate-spin" />
                            Confirming...
                        </span>
                    }
                    else
                    {
                        @GetPayLabel()
                    }
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private enum PaymentStatus { Pending, Processing, Confirmed }

    private record Token(string Symbol, string Amount);

    private static readonly Token[] _supportedTokens =
    [
        new("ETH",  "0.0278 ETH"),
        new("USDC", "100.00 USDC"),
        new("USDT", "100.00 USDT"),
        new("DAI",  "100.00 DAI"),
    ];

    private string _selectedToken = "USDC";
    private PaymentStatus _status = PaymentStatus.Pending;

    private async Task HandlePay()
    {
        _status = PaymentStatus.Processing;
        await Task.Delay(2000);
        _status = PaymentStatus.Confirmed;
    }

    private string GetPayLabel()
    {
        var found = System.Array.Find(_supportedTokens, t => t.Symbol == _selectedToken);
        return found is not null ? $"Pay {found.Amount}" : "Pay";
    }
}
