@* ============================================================
   Block: web3-validator-node
   Title: Web3ValidatorNode
   Description: A React and Next.js validator node dashboard block built with shadcn/ui Badge and Tailwind CSS for monitoring uptime and staking rewards.
   Source: original/blocks/web3/web3-validator-node.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="server" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Validator Node</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                <span class="mr-1.5 inline-block size-1.5 rounded-full bg-emerald-500"></span>
                Synced
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-muted-foreground text-xs">Total Earned</p>
                    <p class="mt-0.5 font-semibold text-2xl tabular-nums">1.8452 ETH</p>
                    <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">~$6,644.28</p>
                </div>
                <div class="text-right">
                    <p class="text-muted-foreground text-xs">Effective Balance</p>
                    <p class="mt-0.5 font-semibold text-lg tabular-nums">32.0 ETH</p>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-4 border-b">
            @foreach (var m in _metrics)
            {
                <div class="px-4 py-3 border-r last:border-r-0">
                    <div class="flex items-center gap-1.5">
                        @if (m.Status != null)
                        {
                            <span class="@Cn.Merge("size-1.5 rounded-full", _statusColor[m.Status])"></span>
                        }
                        <p class="text-muted-foreground text-xs">@m.Label</p>
                    </div>
                    <p class="mt-0.5 font-semibold tabular-nums text-sm">@m.Value</p>
                </div>
            }
        </div>

        <div class="px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">System</span>
            <div class="mt-2 space-y-2">
                @foreach (var m in _systemMetrics)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@m.Label</span>
                        <span class="font-mono tabular-nums">@m.Value</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record NodeMetric(string Label, string Value, string? Status = null);

    private static readonly NodeMetric[] _metrics =
    [
        new("Uptime",       "99.97%",    "good"),
        new("Attestations", "98.2%",     "good"),
        new("Proposals",    "12 / 12",   "good"),
        new("Missed Slots", "3",         "warning"),
    ];

    private static readonly NodeMetric[] _systemMetrics =
    [
        new("CPU Usage", "42%"),
        new("Memory",    "12.4 / 32 GB"),
        new("Disk",      "1.2 / 2 TB"),
        new("Peers",     "48 connected"),
    ];

    private static readonly System.Collections.Generic.Dictionary<string, string> _statusColor = new()
    {
        ["good"]     = "bg-emerald-500",
        ["warning"]  = "bg-amber-500",
        ["critical"] = "bg-red-500",
    };
}
