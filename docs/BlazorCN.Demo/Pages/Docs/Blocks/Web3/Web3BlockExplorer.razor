@* ============================================================
   Block: web3-block-explorer
   Title: Web3BlockExplorer
   Description: React blockchain block explorer block for Next.js with latest blocks, transactions, and search using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/web3-block-explorer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="box" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Block Explorer</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Ethereum
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-2">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
                <InputCn @bind-Value="_search" Class="h-7 border-0 bg-transparent px-0 text-sm shadow-none focus-visible:ring-0" Placeholder="Search by address, txn hash, or block..." />
            </div>
        </div>

        <div class="grid grid-cols-[auto_auto_auto_auto_auto] items-center gap-x-3 border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">Block</span>
            <span class="text-xs font-medium text-muted-foreground text-right">Age</span>
            <span class="text-xs font-medium text-muted-foreground text-right">Txns</span>
            <span class="text-xs font-medium text-muted-foreground text-right">Gas</span>
            <span class="text-xs font-medium text-muted-foreground text-right">Reward</span>
        </div>

        <div>
            @foreach (var blk in _blocks)
            {
                var isLast = blk.Number == _blocks[_blocks.Length - 1].Number;
                <div class="@Cn.Merge("grid grid-cols-[auto_auto_auto_auto_auto] items-center gap-x-3 px-4 py-2", isLast ? "" : "border-b")">
                    <span class="font-mono text-xs text-blue-600 dark:text-blue-400 tabular-nums">@blk.Number</span>
                    <span class="text-right text-muted-foreground text-xs tabular-nums">@blk.Time</span>
                    <span class="text-right font-mono text-xs tabular-nums">@blk.Txns</span>
                    <span class="text-right font-mono text-xs tabular-nums">@blk.GasUsed</span>
                    <span class="text-right font-mono text-xs tabular-nums text-muted-foreground">@blk.Reward</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _search = "";

    private record Block(string Number, string Time, int Txns, string GasUsed, string Reward);

    private static readonly Block[] _blocks =
    [
        new("19,425,812", "12s ago", 182, "78%", "0.0342 ETH"),
        new("19,425,811", "24s ago", 156, "65%", "0.0281 ETH"),
        new("19,425,810", "36s ago", 201, "92%", "0.0518 ETH"),
        new("19,425,809", "48s ago", 134, "58%", "0.0195 ETH"),
        new("19,425,808", "60s ago", 178, "85%", "0.0412 ETH"),
        new("19,425,807", "72s ago", 145, "62%", "0.0228 ETH"),
        new("19,425,806", "84s ago", 198, "89%", "0.0465 ETH"),
    ];
}
