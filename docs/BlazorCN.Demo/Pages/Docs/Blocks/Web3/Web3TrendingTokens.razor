@* ============================================================
   Block: web3-trending-tokens
   Title: Web3TrendingTokens
   Description: A React and Next.js trending tokens block built with shadcn/ui and Tailwind CSS featuring ranked tokens with volume and momentum.
   Source: original/blocks/web3/web3-trending-tokens.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="flame" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Trending</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                24H
            </BadgeCn>
        </div>

        <div class="grid grid-cols-[auto_1fr_auto_auto_auto] items-center gap-x-3 border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">#</span>
            <span class="text-xs font-medium text-muted-foreground">Token</span>
            <span class="text-xs font-medium text-muted-foreground text-right">Price</span>
            <span class="text-xs font-medium text-muted-foreground text-right">24h</span>
            <span class="text-xs font-medium text-muted-foreground text-right">Volume</span>
        </div>

        <div>
            @for (int i = 0; i < _tokens.Length; i++)
            {
                var token = _tokens[i];
                var isLast = i == _tokens.Length - 1;
                <div class="@Cn.Merge("grid grid-cols-[auto_1fr_auto_auto_auto] items-center gap-x-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <span class="w-5 font-mono text-muted-foreground text-xs tabular-nums">@token.Rank</span>
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">@token.Name</span>
                        <span class="font-mono text-muted-foreground text-xs">@token.Symbol</span>
                    </div>
                    <span class="font-mono text-xs tabular-nums text-right">@token.Price</span>
                    <span class="@Cn.Merge("text-right font-mono text-xs tabular-nums", token.Positive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                        @token.Change24h
                    </span>
                    <span class="text-right font-mono text-muted-foreground text-xs tabular-nums">@token.Volume</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TrendingToken(int Rank, string Name, string Symbol, string Price, string Change24h, bool Positive, string Volume, string Mentions);

    private static readonly TrendingToken[] _tokens =
    [
        new(1, "Pepe",      "PEPE", "$0.00001842", "+42.5%", true,  "$2.1B",  "48.2K"),
        new(2, "Arbitrum",  "ARB",  "$1.82",       "+18.3%", true,  "$1.8B",  "32.1K"),
        new(3, "Optimism",  "OP",   "$3.45",       "+12.7%", true,  "$890M",  "28.4K"),
        new(4, "Render",    "RNDR", "$7.82",       "+9.1%",  true,  "$542M",  "21.3K"),
        new(5, "Injective", "INJ",  "$24.30",      "+7.4%",  true,  "$385M",  "18.7K"),
        new(6, "Sui",       "SUI",  "$1.45",       "+5.8%",  true,  "$312M",  "15.2K"),
        new(7, "Starknet",  "STRK", "$0.92",       "-2.1%",  false, "$245M",  "14.8K"),
        new(8, "Jupiter",   "JUP",  "$0.68",       "+3.2%",  true,  "$198M",  "12.1K"),
    ];
}
