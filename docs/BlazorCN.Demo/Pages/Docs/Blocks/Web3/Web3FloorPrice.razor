@* ============================================================
   Block: web3-floor-price
   Title: Web3FloorPrice
   Description: A React and Next.js NFT floor price tracker block built with shadcn/ui and Tailwind CSS for monitoring collection prices.
   Source: original/blocks/web3/web3-floor-price.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Floor Price Tracker</span>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-muted-foreground text-xs">Live</span>
            </div>
        </div>

        <div class="grid grid-cols-[1fr_auto_auto_auto_auto] items-center gap-x-3 border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">Collection</span>
            <span class="text-xs font-medium text-muted-foreground text-right">Floor</span>
            <span class="text-xs font-medium text-muted-foreground text-right">24h</span>
            <span class="text-xs font-medium text-muted-foreground text-right">7d</span>
            <span class="text-xs font-medium text-muted-foreground text-right">Volume</span>
        </div>

        <div>
            @for (int i = 0; i < _collections.Length; i++)
            {
                var c = _collections[i];
                var isLast = i == _collections.Length - 1;
                <div class="@Cn.Merge("grid grid-cols-[1fr_auto_auto_auto_auto] items-center gap-x-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div>
                        <span class="font-medium text-sm">@c.Collection</span>
                    </div>
                    <div class="text-right">
                        <span class="font-mono text-xs tabular-nums">@c.Floor</span>
                    </div>
                    <span class="@Cn.Merge("flex items-center justify-end gap-0.5 text-xs tabular-nums", c.Positive24h ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                        @if (c.Positive24h)
                        {
                            <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                        }
                        else
                        {
                            <LucideIconCn Name="trending-down" Size="12" Class="size-3" />
                        }
                        @c.Change24h
                    </span>
                    <span class="@Cn.Merge("text-right text-xs tabular-nums", c.Positive7d ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                        @c.Change7d
                    </span>
                    <span class="text-right font-mono text-muted-foreground text-xs tabular-nums">
                        @c.Volume24h
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FloorData(string Collection, string Floor, string FloorUsd, string Change24h, string Change7d, string Volume24h, bool Positive24h, bool Positive7d);

    private static readonly FloorData[] _collections =
    [
        new("Cosmic Apes",    "2.40 ETH",  "$8,643",  "+12.5%", "+28.1%", "148 ETH", true,  true),
        new("Pixel Punks",    "8.10 ETH",  "$29,170", "-3.2%",  "+5.4%",  "312 ETH", false, true),
        new("Meta Realms",    "0.90 ETH",  "$3,241",  "+1.8%",  "-8.7%",  "52 ETH",  true,  false),
        new("Digital Dreams", "15.30 ETH", "$55,099", "+5.1%",  "+15.3%", "89 ETH",  true,  true),
        new("Cyber Cats",     "1.20 ETH",  "$4,322",  "-7.4%",  "-12.1%", "28 ETH",  false, false),
        new("Astro Bears",    "3.70 ETH",  "$13,325", "+0.8%",  "+2.3%",  "67 ETH",  true,  true),
    ];
}
