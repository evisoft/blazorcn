@* ============================================================
   Block: web3-function-call
   Title: Web3FunctionCall
   Description: A React and Next.js smart contract function caller built with shadcn/ui and Tailwind CSS for executing blockchain calls.
   Source: original/blocks/web3/web3-function-call.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="terminal" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Contract Call</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Contract</span>
            <p class="mt-1 font-mono text-xs">0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45</p>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Function</span>
            <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                @foreach (var fn in _functions)
                {
                    var fnItem = fn;
                    <ButtonCn Variant="@(_selectedFnIndex == fnItem.Index ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" @onclick="@(() => HandleSelect(fnItem.Index))">
                        <span class="font-mono">@fnItem.Name</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @fnItem.Type
                        </BadgeCn>
                    </ButtonCn>
                }
            </div>
        </div>

        @if (_params.Length > 0)
        {
            <div class="border-b px-4 py-3">
                <span class="text-xs font-medium text-muted-foreground">Parameters</span>
                <div class="mt-2 space-y-2">
                    @for (int i = 0; i < _params.Length; i++)
                    {
                        var idx = i;
                        var p = _params[idx];
                        <div class="flex items-center gap-2">
                            <span class="w-20 shrink-0 font-mono text-xs text-muted-foreground">
                                @p.Name
                            </span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono font-normal text-xs">
                                @p.ParamType
                            </BadgeCn>
                            <InputCn Value="@p.Value" ValueChanged="@((string v) => SetParamValue(idx, v))" Class="h-8 flex-1 font-mono text-xs" Placeholder="@($"Enter {p.ParamType}...")" />
                        </div>
                    }
                </div>
            </div>
        }

        @if (_functions[_selectedFnIndex].Type == "write")
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Est. Gas</span>
                    <span class="tabular-nums">~$4.50</span>
                </div>
            </div>
        }

        @if (_result != null)
        {
            <div class="border-b px-4 py-3">
                <span class="text-xs font-medium text-muted-foreground">Result</span>
                <div class="mt-1.5 rounded-md bg-muted/50 p-3">
                    <p class="font-mono text-xs break-all">@_result</p>
                </div>
            </div>
        }

        <div class="px-4 py-3">
            <ButtonCn Class="h-9 w-full gap-1 text-sm" @onclick="HandleCall">
                <LucideIconCn Name="play" Size="12" Class="size-3" />
                @(_functions[_selectedFnIndex].Type == "view" ? "Call" : "Execute")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private int _selectedFnIndex = 0;
    private string? _result = null;

    private record FunctionDef(int Index, string Name, string Type, ParamDef[] DefaultParams);
    private record ParamDef(string Name, string ParamType);

    private static readonly FunctionDef[] _functions =
    [
        new(0, "balanceOf",   "view",  [new("account", "address")]),
        new(1, "totalSupply", "view",  []),
        new(2, "transfer",    "write", [new("to", "address"), new("amount", "uint256")]),
        new(3, "approve",     "write", [new("spender", "address"), new("amount", "uint256")]),
    ];

    private record MutableParam(string Name, string ParamType, string Value);

    private MutableParam[] _params = _functions[0].DefaultParams
        .Select(p => new MutableParam(p.Name, p.ParamType, ""))
        .ToArray();

    private void HandleSelect(int index)
    {
        _selectedFnIndex = index;
        _params = _functions[index].DefaultParams
            .Select(p => new MutableParam(p.Name, p.ParamType, ""))
            .ToArray();
        _result = null;
    }

    private void SetParamValue(int index, string value)
    {
        var old = _params[index];
        _params[index] = new MutableParam(old.Name, old.ParamType, value);
    }

    private void HandleCall()
    {
        var fn = _functions[_selectedFnIndex];
        if (fn.Name == "balanceOf")
            _result = "1000000000000000000 (1.0 ETH)";
        else if (fn.Name == "totalSupply")
            _result = "1000000000000000000000000 (1,000,000 tokens)";
        else
            _result = "Transaction submitted: 0x8f2a...b4c1";
    }
}
