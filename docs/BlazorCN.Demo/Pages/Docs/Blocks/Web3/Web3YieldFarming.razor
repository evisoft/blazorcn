@* ============================================================
   Block: web3-yield-farming
   Title: Web3YieldFarming
   Description: A React and Next.js yield farming dashboard block built with shadcn/ui and Tailwind CSS for DeFi protocol management.
   Source: original/blocks/web3/web3-yield-farming.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sprout" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Yield Farming</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_farms.Length active farms
            </BadgeCn>
        </div>

        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Deposited</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums">@_totalDeposited</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Rewards Earned</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums text-emerald-600 dark:text-emerald-400">@_totalEarned</p>
            </div>
        </div>

        <div>
            @for (int i = 0; i < _farms.Length; i++)
            {
                var farm = _farms[i];
                var isLast = i == _farms.Length - 1;
                var isHarvested = _harvestedIds.Contains(farm.Id);
                var farmId = farm.Id;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@farm.Pair</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @farm.Protocol
                            </BadgeCn>
                            @if (farm.Multiplier != "1x")
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs text-emerald-600 dark:text-emerald-400">
                                    @farm.Multiplier
                                </BadgeCn>
                            }
                        </div>
                        <span class="font-medium text-sm tabular-nums text-emerald-600 dark:text-emerald-400">@farm.Apy</span>
                    </div>
                    <div class="mt-2 flex items-center justify-between text-xs text-muted-foreground">
                        <span>
                            TVL: <span class="tabular-nums">@farm.Tvl</span>
                        </span>
                        <span>Reward: @farm.RewardToken</span>
                    </div>
                    <div class="mt-2 flex items-center justify-between text-xs">
                        <div>
                            <span class="text-muted-foreground">Deposited: </span>
                            <span class="tabular-nums">@farm.DepositedUsd</span>
                        </div>
                        <div>
                            <span class="text-muted-foreground">Earned: </span>
                            <span class="tabular-nums text-emerald-600 dark:text-emerald-400">@farm.EarnedUsd</span>
                        </div>
                    </div>
                    <div class="mt-2 flex gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 flex-1 text-xs">
                            Deposit
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Outline"
                                  Size="ButtonSize.Sm"
                                  Class="h-7 flex-1 text-xs"
                                  OnClick="@(() => Harvest(farmId))"
                                  Disabled="@isHarvested">
                            @(isHarvested ? "Harvested" : "Harvest")
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Farm(string Id, string Pair, string Protocol, string Apy, string Tvl, string RewardToken, string Deposited, string DepositedUsd, string Earned, string EarnedUsd, string Multiplier);

    private static readonly Farm[] _farms =
    [
        new("1", "ETH-USDC",  "Uniswap",   "18.4%", "$124.5M", "UNI",   "2.5 LP",  "$4,200.00",  "12.5 UNI",    "$112.50", "2x"),
        new("2", "WBTC-ETH",  "SushiSwap", "12.7%", "$89.2M",  "SUSHI", "0.8 LP",  "$6,100.00",  "45.2 SUSHI",  "$67.80",  "1x"),
        new("3", "ARB-ETH",   "Camelot",   "42.3%", "$18.7M",  "GRAIL", "5.0 LP",  "$2,800.00",  "0.15 GRAIL",  "$210.00", "3x"),
        new("4", "stETH-ETH", "Curve",     "5.2%",  "$1.2B",   "CRV",   "10.0 LP", "$12,000.00", "85.0 CRV",    "$51.00",  "1x"),
    ];

    private static readonly string _totalDeposited = "$25,100.00";
    private static readonly string _totalEarned = "$441.30";

    private System.Collections.Generic.List<string> _harvestedIds = [];

    private void Harvest(string id)
    {
        if (!_harvestedIds.Contains(id))
            _harvestedIds.Add(id);
    }
}
