@* ============================================================
   Block: web3-royalty-settings
   Title: Web3RoyaltySettings
   Description: A React and Next.js NFT royalty settings block built with shadcn/ui and Tailwind CSS. Features percentage splits and recipient management.
   Source: original/blocks/web3/web3-royalty-settings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="percent" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Royalty Settings</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Total Royalty Percentage</span>
            <div class="mt-1.5 flex items-center gap-2">
                <InputCn aria-label="Total royalty percentage" @bind-Value="_totalRoyalty" Class="h-9 w-24 font-mono text-sm tabular-nums" />
                <span class="text-muted-foreground text-sm">%</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">Applied on every secondary sale</p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-medium text-muted-foreground">Recipients</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="AddRecipient">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    Add
                </ButtonCn>
            </div>
            <div class="space-y-2">
                @foreach (var r in _recipients)
                {
                    var recipient = r;
                    <div class="flex items-center gap-2">
                        <InputCn Value="@recipient.Label" Class="h-8 w-20 text-xs" Placeholder="Label" />
                        <InputCn Value="@recipient.Address" Class="h-8 flex-1 font-mono text-xs" Placeholder="0x..." />
                        <InputCn Value="@recipient.Share" Class="h-8 w-16 text-center font-mono text-xs tabular-nums" Placeholder="%" />
                        <span class="text-muted-foreground text-xs">%</span>
                        <ButtonCn aria-label="@($"Remove recipient {recipient.Label}")" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0" OnClick="@(() => RemoveRecipient(recipient.Id))">
                            <LucideIconCn Name="trash" Size="12" Class="size-3 text-muted-foreground" />
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Enforcement</span>
            <div class="mt-2 space-y-1.5">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">EIP-2981 (on-chain)</span>
                    <span class="text-emerald-600 dark:text-emerald-400">Enabled</span>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Operator filter</span>
                    <span class="text-emerald-600 dark:text-emerald-400">Enabled</span>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Marketplace support</span>
                    <span>OpenSea, Blur, LooksRare</span>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="h-9 w-full text-sm">Save Royalty Settings</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _totalRoyalty = "5.0";

    private record RoyaltyRecipient(string Id, string Address, string Share, string Label);

    private List<RoyaltyRecipient> _recipients =
    [
        new("1", "0x7a25...f3e8", "70", "Creator"),
        new("2", "0x3b91...a2c7", "20", "Artist"),
        new("3", "0x9e12...d4b6", "10", "Platform"),
    ];

    private void AddRecipient()
    {
        _recipients.Add(new((_recipients.Count + 1).ToString(), "", "0", ""));
    }

    private void RemoveRecipient(string id)
    {
        _recipients.RemoveAll(r => r.Id == id);
    }
}
