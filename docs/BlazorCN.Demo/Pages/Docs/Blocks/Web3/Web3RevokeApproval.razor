@* ============================================================
   Block: web3-revoke-approval
   Title: Web3RevokeApproval
   Description: A React and Next.js token approval revocation block built with shadcn/ui and Tailwind CSS. Features batch revoke with risk assessment.
   Source: original/blocks/web3/web3-revoke-approval.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-x" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Revoke Approvals</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @(_approvals.Where(a => a.Risk == "high").Count()) high risk
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Selected</span>
                <span class="tabular-nums">@_selected.Count of @_approvals.Length</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Estimated gas</span>
                <span class="tabular-nums">@TotalGas</span>
            </div>
        </div>

        <div>
            @foreach (var approval in _approvals)
            {
                var isLast = approval.Id == _approvals[_approvals.Length - 1].Id;
                var isSelected = _selected.Contains(approval.Id);
                var riskColor = _riskColor.ContainsKey(approval.Risk) ? _riskColor[approval.Risk] : "bg-gray-500";
                var amountClass = approval.Amount == "Unlimited" ? "tabular-nums text-amber-600 dark:text-amber-400" : "tabular-nums text-muted-foreground";
                var rowClass = Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b", _revoked ? "opacity-50" : "");
                var approvalId = approval.Id;
                <div class="@rowClass">
                    <span class="shrink-0">
                        <CheckboxCn Checked="@isSelected" CheckedChanged="@((bool _) => ToggleSelect(approvalId))" Disabled="@_revoked" />
                    </span>
                    <span class="@($"size-1.5 shrink-0 rounded-full {riskColor}")" />
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@approval.Token</span>
                            <span class="text-muted-foreground text-xs">@approval.Spender</span>
                        </div>
                        <p class="mt-0.5 text-xs">
                            <span class="@amountClass">@approval.Amount</span>
                        </p>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs capitalize">
                        @approval.Risk
                    </BadgeCn>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <ButtonCn Class="h-9 w-full text-sm" Disabled="@(_selected.Count == 0 || _revoked)" @onclick="@(() => _revoked = true)">
                @if (_revoked)
                {
                    @:Revoked Successfully
                }
                else
                {
                    @($"Revoke {_selected.Count} Approvals (~{TotalGas})")
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _revoked = false;

    private record Approval(string Id, string Token, string Spender, string Amount, string Risk, string GasCost);

    private static readonly Approval[] _approvals =
    [
        new("1", "USDC", "Unknown Contract",   "Unlimited", "high",   "$1.20"),
        new("2", "USDT", "Deprecated Router",  "Unlimited", "high",   "$1.20"),
        new("3", "LINK", "1inch v4 (old)",     "Unlimited", "medium", "$1.20"),
        new("4", "DAI",  "SushiSwap v1",       "50,000",    "medium", "$1.20"),
        new("5", "WETH", "Curve Finance",      "10.0",      "low",    "$1.20"),
    ];

    private static readonly Dictionary<string, string> _riskColor = new()
    {
        ["low"]    = "bg-emerald-500",
        ["medium"] = "bg-amber-500",
        ["high"]   = "bg-red-500",
    };

    private List<string> _selected = _approvals
        .Where(a => a.Risk == "high")
        .Select(a => a.Id)
        .ToList();

    private string TotalGas => $"${(_selected.Count * 1.2):F2}";

    private void ToggleSelect(string id)
    {
        if (_selected.Contains(id))
            _selected.Remove(id);
        else
            _selected.Add(id);
    }
}
