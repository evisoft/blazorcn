@* ============================================================
   Block: web3-gas-tracker
   Title: Web3GasTracker
   Description: A React and Next.js gas price tracker block built with shadcn/ui and Tailwind CSS showing speed tiers and cost estimates.
   Source: original/blocks/web3/web3-gas-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="fuel" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Gas Tracker</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-muted-foreground text-xs">Live</span>
            </div>
        </div>

        <div class="grid grid-cols-3 border-b">
            @foreach (var tier in _gasTiers)
            {
                var i = Array.IndexOf(_gasTiers, tier);
                var item = tier;
                <button
                    type="button"
                    @onclick="@(() => _selectedTier = i)"
                    class="@Cn.Merge("flex flex-col items-center gap-1 py-4 transition-colors hover:bg-muted/50", i < 2 ? "border-r" : "", _selectedTier == i ? "bg-muted/30" : "")">
                    <span class="text-muted-foreground text-xs">@item.Label</span>
                    <span class="@Cn.Merge("font-semibold text-xl tabular-nums", item.Color)">@item.Gwei</span>
                    <span class="text-muted-foreground text-xs">gwei</span>
                    <span class="text-muted-foreground text-xs">@item.Time</span>
                </button>
            }
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Base Fee</span>
                <span class="font-mono text-xs tabular-nums">10.2 gwei</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Priority Fee</span>
                <span class="font-mono text-xs tabular-nums">@(_gasTiers[_selectedTier].Gwei - 10) gwei</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">ETH Price</span>
                <span class="font-mono text-xs tabular-nums">$3,601.25</span>
            </div>
        </div>

        <div>
            <div class="grid grid-cols-[1fr_auto_auto_auto_auto] items-center gap-x-3 border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Transaction</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Gas</span>
                @foreach (var tier in _gasTiers)
                {
                    <span class="text-xs font-medium text-muted-foreground text-right">@tier.Label</span>
                }
            </div>
            @foreach (var est in _estimates)
            {
                var estItem = est;
                var isLast = Array.IndexOf(_estimates, est) == _estimates.Length - 1;
                <div class="@Cn.Merge("grid grid-cols-[1fr_auto_auto_auto_auto] items-center gap-x-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="text-sm">@estItem.TxType</span>
                    <span class="font-mono text-muted-foreground text-xs tabular-nums text-right">@estItem.GasUnits</span>
                    @for (var ci = 0; ci < estItem.Costs.Length; ci++)
                    {
                        var costIndex = ci;
                        <span class="@Cn.Merge("font-mono text-xs tabular-nums text-right", _selectedTier == costIndex ? "font-medium" : "text-muted-foreground")">@estItem.Costs[costIndex]</span>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private int _selectedTier = 1;

    private record GasTier(string Label, int Gwei, string Time, string Color);

    private static readonly GasTier[] _gasTiers =
    [
        new("Slow",     12, "~10 min", "text-blue-600 dark:text-blue-400"),
        new("Standard", 18, "~3 min",  "text-amber-600 dark:text-amber-400"),
        new("Fast",     28, "~30 sec", "text-red-600 dark:text-red-400"),
    ];

    private record TxEstimate(string TxType, string GasUnits, string[] Costs);

    private static readonly TxEstimate[] _estimates =
    [
        new("ETH Transfer",      "21,000",     ["$0.91",  "$1.36",  "$2.12"]),
        new("ERC-20 Transfer",   "65,000",     ["$2.81",  "$4.22",  "$6.56"]),
        new("Uniswap Swap",      "184,000",    ["$7.96",  "$11.93", "$18.56"]),
        new("NFT Mint",          "150,000",    ["$6.49",  "$9.73",  "$15.14"]),
        new("NFT Transfer",      "85,000",     ["$3.68",  "$5.51",  "$8.58"]),
        new("Contract Deploy",   "1,200,000",  ["$51.89", "$77.83", "$121.10"]),
    ];
}
