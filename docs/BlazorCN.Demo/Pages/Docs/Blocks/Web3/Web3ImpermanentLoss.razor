@* ============================================================
   Block: web3-impermanent-loss
   Title: Web3ImpermanentLoss
   Description: A React and Next.js impermanent loss calculator block built with shadcn/ui and Tailwind CSS. Simulates DeFi LP loss.
   Source: original/blocks/web3/web3-impermanent-loss.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calculator" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Impermanent Loss Calculator</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <span class="text-muted-foreground text-xs">Initial LP Value (USD)</span>
                    <InputCn @bind-Value="_initialValue" Class="mt-1.5 font-mono text-sm tabular-nums" Placeholder="10000" />
                </div>
                <div>
                    <span class="text-muted-foreground text-xs">Price Change (%)</span>
                    <InputCn @bind-Value="_priceChange" Class="mt-1.5 font-mono text-sm tabular-nums" Placeholder="100" />
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <div class="rounded-md bg-muted/50 p-4 text-center">
                <p class="text-muted-foreground text-xs">Impermanent Loss</p>
                <p class="mt-1 font-semibold text-2xl tabular-nums text-red-600 dark:text-red-400">
                    @Math.Abs(IlPercent).ToString("F2")%
                </p>
                <p class="mt-0.5 font-mono text-muted-foreground text-xs tabular-nums">
                    ~$@Math.Abs(IlDollar).ToString("F2") loss vs holding
                </p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Value if held</span>
                <span class="font-mono tabular-nums">$@HoldValue.ToString("F2")</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Value in LP</span>
                <span class="font-mono tabular-nums">$@LpValue.ToString("F2")</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Difference</span>
                <span class="font-mono tabular-nums text-red-600 dark:text-red-400">
                    -$@Math.Abs(IlDollar).ToString("F2")
                </span>
            </div>
        </div>

        <div class="px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">IL Reference Table</span>
            <div class="mt-2 grid grid-cols-3 gap-y-1">
                <span class="text-xs font-medium text-muted-foreground">Price Change</span>
                <span class="text-xs font-medium text-muted-foreground text-right col-span-2">IL %</span>
                @foreach (var p in _priceChanges)
                {
                    <span class="font-mono text-xs tabular-nums">@p.Change</span>
                    <span class="font-mono text-xs tabular-nums text-right text-red-600 dark:text-red-400 col-span-2">@p.Il</span>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private string _initialValue = "10000";
    private string _priceChange = "100";

    private double ChangeMultiplier =>
        1 + (double.TryParse(_priceChange, out var pc) ? pc : 0.0) / 100.0;

    private double IlPercent =>
        ChangeMultiplier > 0
            ? ((2.0 * Math.Sqrt(ChangeMultiplier)) / (1.0 + ChangeMultiplier) - 1.0) * 100.0
            : 0.0;

    private double HoldValue =>
        (double.TryParse(_initialValue, out var v) ? v : 0.0) * (1.0 + ChangeMultiplier) / 2.0;

    private double LpValue => HoldValue * (1.0 + IlPercent / 100.0);

    private double IlDollar => HoldValue - LpValue;

    private record PriceChangeRow(string Change, string Il);

    private static readonly PriceChangeRow[] _priceChanges =
    [
        new("-75%",  "20.0%"),
        new("-50%",  "5.7%"),
        new("-25%",  "0.6%"),
        new("0%",    "0.0%"),
        new("+25%",  "0.6%"),
        new("+50%",  "2.0%"),
        new("+100%", "5.7%"),
        new("+200%", "13.4%"),
        new("+400%", "25.5%"),
    ];
}
