@* ============================================================
   Block: web3-achievement-badges
   Title: Web3AchievementBadges
   Description: React achievement badges block for Next.js with progress tracking and rarity tiers using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/web3-achievement-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="award" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Achievements</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                @_earned/@_badges.Length earned
            </BadgeCn>
        </div>

        <div>
            @for (int i = 0; i < _badges.Length; i++)
            {
                var badge = _badges[i];
                var isLast = i == _badges.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b", !badge.Earned ? "opacity-60" : "")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted/50">
                        @if (badge.Earned)
                        {
                            <LucideIconCn Name="award" Size="16" Class="@($"size-4 {RarityColor(badge.Rarity)}")" />
                        }
                        else
                        {
                            <LucideIconCn Name="lock" Size="16" Class="size-4 text-muted-foreground" />
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@badge.Name</span>
                            <span class="@($"text-xs capitalize {RarityColor(badge.Rarity)}")">@badge.Rarity</span>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@badge.Description</p>
                        @if (!badge.Earned && badge.Progress.HasValue && badge.MaxProgress.HasValue)
                        {
                            <div class="mt-1.5">
                                <div class="h-1 overflow-hidden rounded-full bg-muted">
                                    <div class="h-full rounded-full bg-blue-500/60"
                                         style="@($"width:{(badge.Progress.Value * 100.0 / badge.MaxProgress.Value):F0}%")">
                                    </div>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">
                                    @badge.Progress/@badge.MaxProgress
                                </p>
                            </div>
                        }
                    </div>
                    @if (badge.Earned)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs shrink-0">
                            Earned
                        </BadgeCn>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record AchievementBadge(
        string Name,
        string Description,
        bool Earned,
        string Rarity,
        int? Progress = null,
        int? MaxProgress = null
    );

    private static readonly AchievementBadge[] _badges =
    [
        new("Early Adopter",    "Joined within the first month",       true,  "rare"),
        new("Governance Voter", "Voted on 10 proposals",               true,  "common"),
        new("DeFi Explorer",    "Used 5 different protocols",          true,  "uncommon"),
        new("Diamond Hands",    "Held tokens for 1 year",              false, "rare",      245, 365),
        new("Whale Watcher",    "Portfolio value exceeds $100K",       false, "legendary",  40, 100),
        new("Social Butterfly", "Connected with 50 wallets",           false, "uncommon",   32,  50),
    ];

    private int _earned = 0;

    protected override void OnInitialized()
    {
        _earned = 0;
        foreach (var b in _badges)
            if (b.Earned) _earned++;
    }

    private static string RarityColor(string rarity) => rarity switch
    {
        "common"    => "text-zinc-500",
        "uncommon"  => "text-emerald-600 dark:text-emerald-400",
        "rare"      => "text-blue-600 dark:text-blue-400",
        "legendary" => "text-amber-600 dark:text-amber-400",
        _           => ""
    };
}
