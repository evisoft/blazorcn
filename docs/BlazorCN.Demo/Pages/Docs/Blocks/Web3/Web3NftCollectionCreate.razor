@* ============================================================
   Block: web3-nft-collection-create
   Title: Web3NftCollectionCreate
   Description: A React and Next.js NFT collection launch wizard built with shadcn/ui Button, Badge and Tailwind CSS
   Source: original/blocks/web3/web3-nft-collection-create.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Launch Collection</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                Step @_currentStep of 5
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-1">
                @foreach (var s in GetSteps())
                {
                    var step = s;
                    <div class="flex items-center flex-1">
                        <div class="@($"h-1.5 w-full rounded-full {(step.Status == StepStatus.Completed ? "bg-emerald-500" : step.Status == StepStatus.Current ? "bg-blue-500" : "bg-muted")}")">
                        </div>
                    </div>
                }
            </div>
        </div>

        <div>
            @{
                var allSteps = GetSteps();
            }
            @for (int i = 0; i < allSteps.Length; i++)
            {
                var step = allSteps[i];
                var isLast = i == allSteps.Length - 1;
                <div class="@($"flex items-center gap-3 px-4 py-3 {(isLast ? "" : "border-b")}")">
                    <div class="@($"flex size-7 shrink-0 items-center justify-center rounded-full {(step.Status == StepStatus.Completed ? "bg-emerald-500/10" : step.Status == StepStatus.Current ? "bg-blue-500/10" : "bg-muted/50")}")">
                        @if (step.Status == StepStatus.Completed)
                        {
                            <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                        }
                        else
                        {
                            <span class="@($"font-mono text-xs tabular-nums {(step.Status == StepStatus.Current ? "text-blue-600 dark:text-blue-400" : "text-muted-foreground")}")">
                                @step.Id
                            </span>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="@($"text-sm {(step.Status == StepStatus.Current ? "font-medium" : step.Status == StepStatus.Upcoming ? "text-muted-foreground" : "")}")">
                            @step.Title
                        </span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@step.Description</p>
                    </div>
                    @if (step.Status == StepStatus.Completed)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            Done
                        </BadgeCn>
                    }
                    @if (step.Status == StepStatus.Current)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs text-blue-600 dark:text-blue-400">
                            In progress
                        </BadgeCn>
                    }
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <ButtonCn Class="h-9 w-full text-sm" @onclick="HandleNext" Disabled="@(_currentStep >= 5)">
                @(_currentStep >= 5 ? "Deploy to Mainnet" : "Continue to Next Step")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private int _currentStep = 3;

    private enum StepStatus { Completed, Current, Upcoming }

    private record LaunchStep(int Id, string Title, string Description, StepStatus Status);

    private static readonly LaunchStep[] _initialSteps =
    [
        new(1, "Collection Details", "Name, symbol, and description", StepStatus.Completed),
        new(2, "Upload Artwork", "Upload 10,000 unique images", StepStatus.Completed),
        new(3, "Mint Configuration", "Price, supply, and phases", StepStatus.Current),
        new(4, "Reveal Settings", "Instant or delayed reveal", StepStatus.Upcoming),
        new(5, "Deploy Contract", "Deploy to mainnet", StepStatus.Upcoming),
    ];

    private LaunchStep[] GetSteps() =>
        _initialSteps
            .Select(s => s with
            {
                Status = s.Id < _currentStep
                    ? StepStatus.Completed
                    : s.Id == _currentStep
                        ? StepStatus.Current
                        : StepStatus.Upcoming
            })
            .ToArray();

    private void HandleNext()
    {
        if (_currentStep < 5) _currentStep++;
    }
}
