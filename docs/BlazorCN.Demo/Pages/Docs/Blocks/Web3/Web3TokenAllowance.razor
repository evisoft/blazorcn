@* ============================================================
   Block: web3-token-allowance
   Title: Web3TokenAllowance
   Description: A React and Next.js token allowance manager block built with shadcn/ui and Tailwind CSS showing approved spenders and revocation controls.
   Source: original/blocks/web3/web3-token-allowance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-alert" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Token Allowances</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @(_allowances.Where(a => !_revokedIds.Contains(a.Id)).Count()) active
            </BadgeCn>
        </div>

        <div>
            @foreach (var allowance in _allowances)
            {
                var isLast = allowance.Id == _allowances[_allowances.Length - 1].Id;
                var isRevoked = _revokedIds.Contains(allowance.Id);
                var riskDotClass = isRevoked
                    ? "size-1.5 rounded-full bg-muted-foreground/30"
                    : Cn.Merge("size-1.5 rounded-full", _riskColor.ContainsKey(allowance.Risk) ? _riskColor[allowance.Risk] : "bg-gray-500");
                var rowClass = Cn.Merge("px-4 py-3", isLast ? "" : "border-b", isRevoked ? "opacity-50" : "");
                var amountClass = Cn.Merge("tabular-nums", allowance.Amount == "Unlimited" && !isRevoked ? "text-amber-600 dark:text-amber-400" : "");
                var aid = allowance.Id;
                <div class="@rowClass">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@riskDotClass" />
                            <span class="font-medium text-sm">@allowance.Token</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @allowance.SpenderLabel
                            </BadgeCn>
                        </div>
                        @if (isRevoked)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs text-muted-foreground">
                                Revoked
                            </BadgeCn>
                        }
                        else
                        {
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" @onclick="@(() => Revoke(aid))">
                                Revoke
                            </ButtonCn>
                        }
                    </div>
                    <div class="mt-1.5 flex items-center justify-between text-xs">
                        <span class="font-mono text-muted-foreground">@allowance.Spender</span>
                        <span class="@amountClass">@allowance.Amount</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Allowance(string Id, string Token, string Spender, string SpenderLabel, string Amount, string Risk);

    private static readonly Allowance[] _allowances =
    [
        new("1", "USDC", "0x68b3...a4f2", "Uniswap V3 Router", "Unlimited", "low"),
        new("2", "USDT", "0x7d2f...b1e3", "Aave V3 Pool",      "50,000",    "low"),
        new("3", "DAI",  "0x9c41...d5a8", "Unknown Contract",  "Unlimited", "high"),
        new("4", "WETH", "0x2b83...c7f1", "Curve Finance",     "10.0",      "low"),
        new("5", "LINK", "0x5e19...a2b4", "1inch Router",      "Unlimited", "medium"),
    ];

    private static readonly Dictionary<string, string> _riskColor = new()
    {
        ["low"]    = "bg-emerald-500",
        ["medium"] = "bg-amber-500",
        ["high"]   = "bg-red-500",
    };

    private List<string> _revokedIds = [];

    private void Revoke(string id)
    {
        if (!_revokedIds.Contains(id))
            _revokedIds.Add(id);
    }
}
