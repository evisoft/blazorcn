@* ============================================================
   Block: web3-ipfs-upload
   Title: Web3IpfsUpload
   Description: A React and Next.js IPFS file upload block built with shadcn/ui and Tailwind CSS. Features drag-and-drop, upload progress, and content hash display.
   Source: original/blocks/web3/web3-ipfs-upload.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="hard-drive" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">IPFS Upload</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_uploadedFiles.Length files
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-6">
            <div class="flex flex-col items-center justify-center rounded-md border-2 border-dashed bg-muted/30 px-4 py-8">
                <LucideIconCn Name="upload" Size="32" Class="size-8 text-muted-foreground/50" />
                <p class="mt-2 text-sm text-muted-foreground">Drag and drop files here</p>
                <p class="mt-0.5 text-xs text-muted-foreground/60">or click to browse</p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-7 text-xs">
                    Choose Files
                </ButtonCn>
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Uploaded Files</span>
            </div>
            @foreach (var (file, index) in _uploadedFiles.Select((f, i) => (f, i)))
            {
                var isLast = index == _uploadedFiles.Length - 1;
                <div class="@(isLast ? "px-4 py-3" : "px-4 py-3 border-b")">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@file.Name</span>
                            <span class="text-muted-foreground text-xs">@file.Size</span>
                            @if (file.Pinned)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    Pinned
                                </BadgeCn>
                            }
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" @onclick="@(() => HandleCopy(file.Cid))">
                            @if (_copiedId == file.Cid)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            }
                            CID
                        </ButtonCn>
                    </div>
                    <p class="mt-1 font-mono text-muted-foreground text-xs truncate">@file.Cid</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _copiedId = null;

    private record UploadedFile(string Name, string Size, string Cid, string Gateway, bool Pinned);

    private static readonly UploadedFile[] _uploadedFiles =
    [
        new("cosmic-ape-4217.png",    "2.4 MB", "QmXyZ...abc123", "https://ipfs.io/ipfs/QmXyZ...abc123", true),
        new("metadata.json",          "1.2 KB", "QmAbC...def456", "https://ipfs.io/ipfs/QmAbC...def456", true),
        new("collection-banner.jpg",  "5.1 MB", "QmDeF...ghi789", "https://ipfs.io/ipfs/QmDeF...ghi789", false),
    ];

    private async Task HandleCopy(string cid)
    {
        _copiedId = cid;
        await Task.Delay(1500);
        _copiedId = null;
    }
}
