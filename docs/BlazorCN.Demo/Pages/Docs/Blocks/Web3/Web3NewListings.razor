@* ============================================================
   Block: web3-new-listings
   Title: Web3NewListings
   Description: A React and Next.js new token listings component built with shadcn/ui Badge and Tailwind CSS for tracking launches
   Source: original/blocks/web3/web3-new-listings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">New Listings</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                This week
            </BadgeCn>
        </div>

        <div>
            @for (int i = 0; i < _listings.Length; i++)
            {
                var token = _listings[i];
                var isLast = i == _listings.Length - 1;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@token.Name</span>
                            <span class="font-mono text-muted-foreground text-xs">@token.Symbol</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @token.Chain
                            </BadgeCn>
                        </div>
                        <span class="text-muted-foreground text-xs">@token.Listed</span>
                    </div>
                    <div class="mt-2 flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">
                            Launch: <span class="tabular-nums">@token.InitialPrice</span>
                        </span>
                        <div class="flex items-center gap-2">
                            <span class="font-mono tabular-nums">@token.CurrentPrice</span>
                            <span class="@Cn.Merge("flex items-center gap-0.5 tabular-nums", token.Positive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                @if (token.Positive)
                                {
                                    <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideIconCn Name="trending-down" Size="12" Class="size-3" />
                                }
                                @token.Change
                            </span>
                        </div>
                    </div>
                    <div class="mt-1 flex items-center justify-between text-xs text-muted-foreground">
                        <span>
                            Market Cap: <span class="tabular-nums">@token.MarketCap</span>
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record NewListing(string Name, string Symbol, string Chain, string Listed, string InitialPrice, string CurrentPrice, string Change, bool Positive, string MarketCap);

    private static readonly NewListing[] _listings =
    [
        new("Protocol X",   "PROTX", "Ethereum", "2 hours ago",  "$0.12", "$0.28", "+133%",   true,  "$14M"),
        new("AeroSwap",     "AERO",  "Base",     "6 hours ago",  "$0.45", "$0.38", "-15.6%",  false, "$8.5M"),
        new("NeuralAI",     "NRAI",  "Arbitrum", "12 hours ago", "$1.20", "$2.85", "+137.5%", true,  "$42M"),
        new("StableYield",  "SYLD",  "Ethereum", "1 day ago",    "$0.08", "$0.11", "+37.5%",  true,  "$5.2M"),
        new("GameVerse",    "GVRSE", "Polygon",  "2 days ago",   "$0.55", "$0.42", "-23.6%",  false, "$18M"),
        new("ZK Bridge",    "ZKB",   "Ethereum", "3 days ago",   "$0.30", "$0.52", "+73.3%",  true,  "$28M"),
    ];
}
