@* ============================================================
   Block: web3-dao-proposal
   Title: Web3DaoProposal
   Description: A React DAO governance proposal block built with Next.js, shadcn/ui, and Tailwind CSS featuring voting progress and quorum tracking.
   Source: original/blocks/web3/web3-dao-proposal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">
                    @_proposal.Id
                </BadgeCn>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs capitalize">
                    @_proposal.Status
                </BadgeCn>
            </div>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                @_proposal.EndTime
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <h2 class="font-medium text-sm">@_proposal.Title</h2>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Proposed by <span class="font-mono">@_proposal.Author</span> · @_proposal.StartTime
            </p>
            <p class="mt-2 text-muted-foreground text-sm leading-relaxed">
                @_proposal.Description
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-medium text-muted-foreground">Quorum</span>
                <span class="text-xs tabular-nums">
                    @FormatNum(_proposal.TotalVotes) / @FormatNum(_proposal.QuorumRequired)
                </span>
            </div>
            <ProgressCn Value="@_quorumPercent" Class="h-1.5" />
            <p class="mt-1 text-muted-foreground text-xs tabular-nums">
                @(_quorumPercent.ToString("F0"))% of quorum reached
            </p>
        </div>

        <div class="border-b px-4 py-3 space-y-3">
            <div>
                <div class="flex items-center justify-between text-xs mb-1">
                    <span class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        For
                    </span>
                    <span class="tabular-nums">
                        @FormatNum(_proposal.ForVotes) (@(_forPercent.ToString("F1"))%)
                    </span>
                </div>
                <ProgressCn Value="@_forPercent" Class="h-1.5 [&>div]:bg-emerald-500" />
            </div>
            <div>
                <div class="flex items-center justify-between text-xs mb-1">
                    <span class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        Against
                    </span>
                    <span class="tabular-nums">
                        @FormatNum(_proposal.AgainstVotes) (@(_againstPercent.ToString("F1"))%)
                    </span>
                </div>
                <ProgressCn Value="@_againstPercent" Class="h-1.5 [&>div]:bg-red-500" />
            </div>
            <div>
                <div class="flex items-center justify-between text-xs mb-1">
                    <span class="flex items-center gap-1.5">
                        <span class="size-1.5 rounded-full bg-zinc-400"></span>
                        Abstain
                    </span>
                    <span class="tabular-nums">
                        @FormatNum(_proposal.AbstainVotes) (@(_abstainPercent.ToString("F1"))%)
                    </span>
                </div>
                <ProgressCn Value="@_abstainPercent" Class="h-1.5 [&>div]:bg-zinc-400" />
            </div>
        </div>

        <div class="px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Cast your vote</p>
            <div class="flex gap-2">
                <ButtonCn Variant="@(_voted == "for" ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-8 flex-1 gap-1 text-xs"
                          OnClick="@(() => CastVote("for"))"
                          Disabled="@(_voted != null)">
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    For
                </ButtonCn>
                <ButtonCn Variant="@(_voted == "against" ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-8 flex-1 gap-1 text-xs"
                          OnClick="@(() => CastVote("against"))"
                          Disabled="@(_voted != null)">
                    <LucideIconCn Name="x" Size="12" Class="size-3" />
                    Against
                </ButtonCn>
                <ButtonCn Variant="@(_voted == "abstain" ? ButtonVariant.Default : ButtonVariant.Outline)"
                          Size="ButtonSize.Sm"
                          Class="h-8 flex-1 text-xs"
                          OnClick="@(() => CastVote("abstain"))"
                          Disabled="@(_voted != null)">
                    Abstain
                </ButtonCn>
            </div>
            @if (_voted != null)
            {
                <p class="mt-2 text-center text-muted-foreground text-xs">
                    You voted <span class="font-medium capitalize">@_voted</span>
                </p>
            }
        </div>
    </div>
</section>

@code {
    private record ProposalData(
        string Id,
        string Title,
        string Author,
        string Status,
        string Description,
        int ForVotes,
        int AgainstVotes,
        int AbstainVotes,
        int QuorumRequired,
        int TotalVotes,
        string StartTime,
        string EndTime,
        string Snapshot
    );

    private static readonly ProposalData _proposal = new(
        Id: "PIP-42",
        Title: "Increase USDC Lending Pool Cap to $50M",
        Author: "0x7a25...f3e8",
        Status: "active",
        Description: "This proposal aims to increase the USDC lending pool cap from $25M to $50M to accommodate growing demand. The current pool utilization sits at 92%, limiting new deposits and increasing borrowing costs.",
        ForVotes: 1842500,
        AgainstVotes: 423100,
        AbstainVotes: 89200,
        QuorumRequired: 2000000,
        TotalVotes: 2354800,
        StartTime: "3 days ago",
        EndTime: "4 days left",
        Snapshot: "Block #19,234,567"
    );

    private double _quorumPercent;
    private double _forPercent;
    private double _againstPercent;
    private double _abstainPercent;

    private string? _voted = null;

    protected override void OnInitialized()
    {
        _quorumPercent = Math.Min(100.0, (_proposal.TotalVotes / (double)_proposal.QuorumRequired) * 100.0);
        _forPercent = (_proposal.ForVotes / (double)_proposal.TotalVotes) * 100.0;
        _againstPercent = (_proposal.AgainstVotes / (double)_proposal.TotalVotes) * 100.0;
        _abstainPercent = (_proposal.AbstainVotes / (double)_proposal.TotalVotes) * 100.0;
    }

    private static string FormatNum(int n) => $"{(n / 1_000_000.0):F2}M";

    private void CastVote(string choice)
    {
        if (_voted == null)
            _voted = choice;
    }
}
