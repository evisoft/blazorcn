@* ============================================================
   Block: web3-reputation-score
   Title: Web3ReputationScore
   Description: A React and Next.js on-chain reputation score block built with shadcn/ui and Tailwind CSS. Features category breakdowns and trust levels.
   Source: original/blocks/web3/web3-reputation-score.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Reputation Score</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_level
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-4 text-center">
            <p class="font-semibold text-4xl tabular-nums">@_totalScore</p>
            <p class="mt-0.5 text-muted-foreground text-xs">out of @_maxScore</p>
            <div class="mt-3 mx-auto h-2 max-w-xs overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-emerald-500"
                     style="@($"width:{(_totalScore * 100.0 / _maxScore):F0}%")">
                </div>
            </div>
        </div>

        <div>
            @for (int i = 0; i < _categories.Length; i++)
            {
                var cat = _categories[i];
                var isLast = i == _categories.Length - 1;
                var pct = cat.Score * 100.0 / cat.MaxScore;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-sm">@cat.Name</span>
                        <span class="font-mono text-xs tabular-nums">@cat.Score/@cat.MaxScore</span>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">@cat.Description</p>
                    <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-blue-500/60"
                             style="@($"width:{pct:F0}%")">
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ScoreCategory(string Name, int Score, int MaxScore, string Description);

    private const int _totalScore = 88;
    private const int _maxScore = 100;
    private const string _level = "Trusted";

    private static readonly ScoreCategory[] _categories =
    [
        new("DeFi Activity",        28, 30, "Lending, swapping, LP positions"),
        new("Governance",           18, 20, "Voting, proposals, delegation"),
        new("Transaction History",  22, 25, "Age, volume, frequency"),
        new("NFT Activity",          8, 10, "Collections, trading, creation"),
        new("Social",               12, 15, "ENS, Lens, POAP, attestations"),
    ];
}
