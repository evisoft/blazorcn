@* ============================================================
   Block: web3-chain-selector
   Title: Web3ChainSelector
   Description: React blockchain chain selector block for Next.js with gas prices and one-click network switching using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/web3-chain-selector.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="network" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Select Network</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_chains.Length networks
            </BadgeCn>
        </div>

        <div>
            @for (int i = 0; i < _chains.Length; i++)
            {
                var chain = _chains[i];
                var isLast = i == _chains.Length - 1;
                var isActive = _activeChain == chain.Id;
                <button type="button"
                        @onclick="@(() => { _activeChain = chain.Id; })"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isLast ? "" : "border-b", isActive ? "bg-muted/30" : "")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted/50">
                        <span class="font-mono font-medium text-xs">@(chain.ShortName.Length >= 2 ? chain.ShortName.Substring(0, 2) : chain.ShortName)</span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@chain.Name</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @chain.Type
                            </BadgeCn>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span class="tabular-nums">Gas: @chain.Gas</span>
                            <span>·</span>
                            <span class="tabular-nums">Block: @chain.BlockTime</span>
                            <span>·</span>
                            <span class="font-mono tabular-nums">ID: @chain.ChainId</span>
                        </div>
                    </div>
                    @if (isActive)
                    {
                        <div class="flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                        </div>
                    }
                </button>
            }
        </div>
    </div>
</section>

@code {
    private record Chain(
        string Id,
        string Name,
        string ShortName,
        int ChainId,
        string Gas,
        string BlockTime,
        string Type
    );

    private static readonly Chain[] _chains =
    [
        new("eth",     "Ethereum",     "ETH",  1,      "18 gwei",     "12s",    "mainnet"),
        new("arb",     "Arbitrum One", "ARB",  42161,  "0.1 gwei",    "0.25s",  "L2"),
        new("op",      "Optimism",     "OP",   10,     "0.05 gwei",   "2s",     "L2"),
        new("polygon", "Polygon",      "MATIC",137,    "32 gwei",     "2s",     "sidechain"),
        new("base",    "Base",         "BASE", 8453,   "0.02 gwei",   "2s",     "L2"),
        new("avax",    "Avalanche",    "AVAX", 43114,  "25 nAVAX",    "2s",     "mainnet"),
        new("bsc",     "BNB Chain",    "BNB",  56,     "3 gwei",      "3s",     "mainnet"),
    ];

    private string _activeChain = "eth";
}
