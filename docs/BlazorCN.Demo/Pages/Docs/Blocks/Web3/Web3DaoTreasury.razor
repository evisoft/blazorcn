@* ============================================================
   Block: web3-dao-treasury
   Title: Web3DaoTreasury
   Description: A React DAO treasury dashboard block built with Next.js, shadcn/ui, and Tailwind CSS featuring asset breakdown and transaction history.
   Source: original/blocks/web3/web3-dao-treasury.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="landmark" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Treasury</span>
            </div>
            <span class="font-mono text-muted-foreground text-xs">0x1a2b...c3d4</span>
        </div>

        @* Total Value *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-xs">Total Value</p>
            <p class="mt-0.5 font-semibold text-2xl tabular-nums">@_totalValue</p>
            <p class="mt-1 text-muted-foreground text-xs">
                Runway: ~18 months at current burn rate
            </p>
        </div>

        @* Assets *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Assets</p>
            <div class="flex h-2 overflow-hidden rounded-full mb-2">
                @for (int i = 0; i < _assets.Length; i++)
                {
                    var asset = _assets[i];
                    var barColor = _assetColors[i % _assetColors.Length];
                    <div class="@barColor" style="@($"width:{asset.Allocation}%")"></div>
                }
            </div>
            <div class="space-y-1.5">
                @for (int i = 0; i < _assets.Length; i++)
                {
                    var asset = _assets[i];
                    var dotColor = _assetColors[i % _assetColors.Length];
                    <div class="flex items-center justify-between text-xs">
                        <span class="flex items-center gap-1.5">
                            <span class="@Cn.Merge("size-1.5 rounded-full", dotColor)"></span>
                            <span class="font-mono">@asset.Token</span>
                            <span class="text-muted-foreground tabular-nums">@asset.Amount</span>
                        </span>
                        <div class="flex items-center gap-2">
                            <span class="tabular-nums">@asset.Value</span>
                            <span class="text-muted-foreground tabular-nums w-8 text-right">
                                @(asset.Allocation)%
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Recent Activity *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Recent Activity</span>
            </div>
            @for (int i = 0; i < _recentTx.Length; i++)
            {
                var tx = _recentTx[i];
                var isLast = i == _recentTx.Length - 1;
                var isInflow = tx.TxType == "inflow";
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="flex size-6 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        @if (isInflow)
                        {
                            <LucideIconCn Name="arrow-down-left" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                        }
                        else
                        {
                            <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-muted-foreground" />
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm">@tx.Description</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@tx.Time</p>
                    </div>
                    <span class="@Cn.Merge("font-mono text-xs tabular-nums", isInflow ? "text-emerald-600 dark:text-emerald-400" : "")">
                        @(isInflow ? "+" : "-")@tx.Amount @tx.Token
                    </span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record TreasuryAsset(string Token, string Amount, string Value, int Allocation);

    private record TreasuryTx(string TxType, string Description, string Amount, string Token, string Time);

    private static readonly string _totalValue = "$5,822,676";

    private static readonly string[] _assetColors =
    [
        "bg-blue-500",
        "bg-purple-500",
        "bg-amber-500",
        "bg-emerald-500",
        "bg-cyan-500",
    ];

    private static readonly TreasuryAsset[] _assets =
    [
        new("USDC",    "2,450,000", "$2,450,000", 42),
        new("ETH",     "520.50",    "$1,874,051", 32),
        new("WBTC",    "8.25",      "$548,625",    9),
        new("DAI",     "500,000",   "$500,000",    9),
        new("PROTO",   "5,000,000", "$450,000",    8),
    ];

    private static readonly TreasuryTx[] _recentTx =
    [
        new("outflow", "Developer grants Q1",            "150,000", "USDC", "2 days ago"),
        new("outflow", "Audit payment — Trail of Bits",   "85,000",  "USDC", "5 days ago"),
        new("inflow",  "Protocol fees collected",          "42.5",    "ETH",  "1 week ago"),
        new("outflow", "Marketing budget March",           "25,000",  "USDC", "2 weeks ago"),
    ];
}
