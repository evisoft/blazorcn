@* ============================================================
   Block: web3-network-stats
   Title: Web3NetworkStats
   Description: A React and Next.js blockchain network stats dashboard built with shadcn/ui and Tailwind CSS for monitoring TPS and gas
   Source: original/blocks/web3/web3-network-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Network Stats</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-muted-foreground text-xs">Live</span>
            </div>
        </div>

        <div class="grid grid-cols-3 border-b">
            @for (int i = 0; i < 3; i++)
            {
                var m = _ethMetrics[i];
                var idx = i;
                <div class="@Cn.Merge("px-4 py-3", idx < 2 ? "border-r" : "")">
                    <p class="text-muted-foreground text-xs">@m.Label</p>
                    <p class="mt-0.5 font-semibold tabular-nums">@m.Value</p>
                    @if (m.Subvalue != null)
                    {
                        <p class="mt-0.5 text-muted-foreground text-xs">@m.Subvalue</p>
                    }
                </div>
            }
        </div>

        <div class="grid grid-cols-3 border-b">
            @for (int i = 3; i < _ethMetrics.Length; i++)
            {
                var m = _ethMetrics[i];
                var idx = i - 3;
                <div class="@Cn.Merge("px-4 py-3", idx < 2 ? "border-r" : "")">
                    <p class="text-muted-foreground text-xs">@m.Label</p>
                    <p class="mt-0.5 font-semibold tabular-nums">@m.Value</p>
                    @if (m.Subvalue != null)
                    {
                        <p class="mt-0.5 text-muted-foreground text-xs">@m.Subvalue</p>
                    }
                </div>
            }
        </div>

        <div>
            <div class="grid grid-cols-[1fr_auto_auto_auto_auto] items-center gap-x-3 border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Chain</span>
                <span class="text-xs font-medium text-muted-foreground text-right">TPS</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Block</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Gas</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Status</span>
            </div>
            @for (int i = 0; i < _chains.Length; i++)
            {
                var c = _chains[i];
                var isLast = i == _chains.Length - 1;
                <div class="@Cn.Merge("grid grid-cols-[1fr_auto_auto_auto_auto] items-center gap-x-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="font-medium text-sm">@c.Chain</span>
                    <span class="text-right font-mono text-xs tabular-nums">@c.Tps</span>
                    <span class="text-right font-mono text-xs tabular-nums">@c.BlockTime</span>
                    <span class="text-right font-mono text-xs tabular-nums text-muted-foreground">@c.Gas</span>
                    <div class="flex items-center justify-end gap-1">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _statusColor[c.Status])"></span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record NetworkMetric(string Label, string Value, string? Subvalue);

    private record ChainComparison(string Chain, string Tps, string BlockTime, string Gas, string Status);

    private static readonly NetworkMetric[] _ethMetrics =
    [
        new("TPS",              "15.2",    "transactions/sec"),
        new("Block Time",       "12.1s",   "avg last 100 blocks"),
        new("Gas Price",        "18 gwei", "standard"),
        new("Active Addresses", "542K",    "24h unique"),
        new("Pending Txns",     "148,231", "in mempool"),
        new("Finality",         "~15 min", "2 epochs"),
    ];

    private static readonly ChainComparison[] _chains =
    [
        new("Ethereum", "15.2", "12.1s",  "18 gwei",   "operational"),
        new("Arbitrum", "42.8", "0.25s",  "0.1 gwei",  "operational"),
        new("Polygon",  "65.4", "2.1s",   "30 gwei",   "operational"),
        new("Base",     "28.1", "2.0s",   "0.01 gwei", "operational"),
        new("Optimism", "18.9", "2.0s",   "0.05 gwei", "degraded"),
    ];

    private static readonly Dictionary<string, string> _statusColor = new()
    {
        ["operational"] = "bg-emerald-500",
        ["degraded"]    = "bg-amber-500",
    };
}
