@* ============================================================
   Block: web3-smart-contract
   Title: Web3SmartContract
   Description: A React and Next.js smart contract interaction block built with shadcn/ui and Tailwind CSS featuring read/write function tabs.
   Source: original/blocks/web3/web3-smart-contract.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="code" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Contract</span>
            </div>
            <span class="font-mono text-muted-foreground text-xs">0xC02a...6Cc2</span>
        </div>

        <div class="flex border-b">
            @foreach (var t in _tabs)
            {
                var tabVal = t;
                <button type="button" @onclick="@(() => SetTab(tabVal))"
                    class="@Cn.Merge("flex-1 px-4 py-2.5 text-xs font-medium capitalize transition-colors", _tab == tabVal ? "border-b-2 border-foreground" : "text-muted-foreground hover:text-foreground")">
                    @tabVal (@(_functions.Count(f => f.Type == tabVal)))
                </button>
            }
        </div>

        <div>
            @{
                var filtered = _functions.Where(f => f.Type == _tab).ToArray();
            }
            @for (int i = 0; i < filtered.Length; i++)
            {
                var fn = filtered[i];
                var isLast = i == filtered.Length - 1;
                var fnName = fn.Name;
                var isExpanded = _expanded == fnName;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button" @onclick="@(() => ToggleExpanded(fnName))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono font-medium text-sm">@fn.Name</span>
                                @if (fn.Output != null)
                                {
                                    <span class="font-mono text-muted-foreground text-xs">→ @fn.Output</span>
                                }
                            </div>
                            @if (fn.Inputs.Length > 0)
                            {
                                <p class="mt-0.5 font-mono text-muted-foreground text-xs">
                                    (@(string.Join(", ", fn.Inputs.Select(inp => $"{inp.Name}: {inp.InputType}"))))
                                </p>
                            }
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 space-y-2">
                            @foreach (var input in fn.Inputs)
                            {
                                var inp = input;
                                <div>
                                    <span class="text-xs text-muted-foreground font-mono">
                                        @inp.Name (@inp.InputType)
                                    </span>
                                    <InputCn Class="mt-1 h-8 font-mono text-xs" Placeholder="@(inp.InputType == "address" ? "0x..." : "0")" />
                                </div>
                            }
                            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" @onclick="@(() => HandleExecute(fn.Name))">
                                <LucideIconCn Name="play" Size="12" Class="size-3" />
                                @(fn.Type == "read" ? "Query" : "Write")
                            </ButtonCn>
                            @if (_results.TryGetValue(fn.Name, out var res))
                            {
                                <div class="rounded-md bg-muted/50 p-2">
                                    <p class="font-mono text-xs break-all">@res</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _tab = "read";
    private string? _expanded = "balanceOf";
    private Dictionary<string, string> _results = new();

    private static readonly string[] _tabs = ["read", "write"];

    private record InputDef(string Name, string InputType);
    private record ContractFunction(string Name, string Type, InputDef[] Inputs, string? Output);

    private static readonly ContractFunction[] _functions =
    [
        new("balanceOf",   "read",  [new("account", "address")],                        "uint256"),
        new("totalSupply", "read",  [],                                                  "uint256"),
        new("name",        "read",  [],                                                  "string"),
        new("symbol",      "read",  [],                                                  "string"),
        new("allowance",   "read",  [new("owner", "address"), new("spender", "address")], "uint256"),
        new("transfer",    "write", [new("to", "address"), new("amount", "uint256")],    null),
        new("approve",     "write", [new("spender", "address"), new("amount", "uint256")], null),
        new("mint",        "write", [new("to", "address"), new("amount", "uint256")],    null),
    ];

    private void SetTab(string tab)
    {
        _tab = tab;
    }

    private void ToggleExpanded(string name)
    {
        _expanded = _expanded == name ? null : name;
    }

    private void HandleExecute(string name)
    {
        if (name == "totalSupply")
            _results[name] = "1000000000000000000000000";
        else if (name == "name")
            _results[name] = "Wrapped Ether";
        else if (name == "symbol")
            _results[name] = "WETH";
        else if (name == "balanceOf")
            _results[name] = "4285100000000000000";
        else
            _results[name] = "Transaction submitted";
    }
}
