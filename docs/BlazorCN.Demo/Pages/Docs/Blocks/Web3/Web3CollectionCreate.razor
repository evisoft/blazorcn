@* ============================================================
   Block: web3-collection-create
   Title: Web3CollectionCreate
   Description: A React and Next.js NFT collection creator block built with shadcn/ui and Tailwind CSS for supply and royalty config.
   Source: original/blocks/web3/web3-collection-create.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="folder-plus" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Create Collection</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <span class="text-muted-foreground text-xs">Collection Name</span>
                    <InputCn @bind-Value="_name" Class="mt-1.5 h-9 text-sm" Placeholder="My Collection" />
                </div>
                <div>
                    <span class="text-muted-foreground text-xs">Symbol</span>
                    <InputCn @bind-Value="_symbol" Class="mt-1.5 h-9 text-sm font-mono" Placeholder="MYCOL" />
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Description</span>
            <TextareaCn @bind-Value="_description" Class="mt-1.5 min-h-[60px] text-sm" Placeholder="Describe your collection..." />
        </div>

        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <span class="text-muted-foreground text-xs">Max Supply</span>
                    <InputCn @bind-Value="_maxSupply" Class="mt-1.5 h-9 text-sm font-mono tabular-nums" Placeholder="10000" />
                </div>
                <div>
                    <span class="text-muted-foreground text-xs">Royalty (%)</span>
                    <InputCn @bind-Value="_royalty" Class="mt-1.5 h-9 text-sm font-mono tabular-nums" Placeholder="5.0" />
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Chain</span>
            <div class="mt-1.5 flex items-center gap-1.5">
                @foreach (var c in _chains)
                {
                    var chain = c;
                    <ButtonCn Variant="@((_selectedChain == chain) ? ButtonVariant.Default : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="h-7 text-xs flex-1"
                              @onclick="@(() => _selectedChain = chain)">
                        @chain
                    </ButtonCn>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Standard</span>
                <span>ERC-721</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Est. Deployment</span>
                <span class="tabular-nums">~$45.00</span>
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="h-9 w-full text-sm" Disabled="@(string.IsNullOrEmpty(_name) || string.IsNullOrEmpty(_symbol))">
                Deploy Collection
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _name = "";
    private string _symbol = "";
    private string _description = "";
    private string _maxSupply = "10000";
    private string _selectedChain = "Ethereum";
    private string _royalty = "5.0";

    private static readonly string[] _chains = ["Ethereum", "Polygon", "Arbitrum", "Base", "Optimism"];
}
