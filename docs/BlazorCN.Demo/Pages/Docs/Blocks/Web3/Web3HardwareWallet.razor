@* ============================================================
   Block: web3-hardware-wallet
   Title: Web3HardwareWallet
   Description: A React and Next.js hardware wallet connection block built with shadcn/ui Badge and Tailwind CSS for device pairing.
   Source: original/blocks/web3/web3-hardware-wallet.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="usb" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Hardware Wallet</span>
            </div>
            @if (_state == ConnectionState.Connected)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    <span class="mr-1.5 inline-block size-1.5 rounded-full bg-emerald-500"></span>
                    Connected
                </BadgeCn>
            }
        </div>

        @if (_state == ConnectionState.Connected && _selected != null)
        {
            <div class="px-4 py-6">
                <div class="flex flex-col items-center gap-3">
                    <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="usb" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
                    </div>
                    <div class="text-center">
                        <p class="font-medium text-sm">@(Array.Find(_devices, d => d.Id == _selected)?.Name)</p>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">0x7a25...f3e8</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">m/44'/60'/0'/0/0</p>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div>
                @foreach (var device in _devices)
                {
                    var dev = device;
                    var isLast = dev.Id == _devices[_devices.Length - 1].Id;
                    var isConnecting = _state == ConnectionState.Connecting && _selected == dev.Id;
                    var isDisabled = dev.Status == "unavailable" || _state == ConnectionState.Connecting;
                    <button
                        type="button"
                        @onclick="@(() => { if (dev.Status != "unavailable") HandleConnect(dev.Id); })"
                        disabled="@(isDisabled ? "disabled" : null)"
                        class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50 disabled:opacity-50", isLast ? "" : "border-b")">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _statusDot.ContainsKey(dev.Status) ? _statusDot[dev.Status] : "")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@dev.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@dev.Type</p>
                        </div>
                        @if (isConnecting)
                        {
                            <LucideIconCn Name="loader-2" Size="16" Class="size-4 shrink-0 animate-spin text-muted-foreground" />
                        }
                        else if (dev.Status == "detected")
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                Detected
                            </BadgeCn>
                        }
                        else
                        {
                            <LucideIconCn Name="chevron-right" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                        }
                    </button>
                }
            </div>
        }
    </div>
</section>

@code {
    private enum ConnectionState { Idle, Connecting, Connected }

    private string? _selected = null;
    private ConnectionState _state = ConnectionState.Idle;

    private record HardwareDevice(string Id, string Name, string Type, string Status);

    private static readonly HardwareDevice[] _devices =
    [
        new("ledger",   "Ledger Nano X",     "USB / Bluetooth", "detected"),
        new("trezor",   "Trezor Model T",    "USB",             "available"),
        new("lattice",  "GridPlus Lattice1", "Network",         "available"),
        new("keystone", "Keystone Pro",      "QR Code",         "unavailable"),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["detected"]   = "bg-emerald-500",
        ["available"]  = "bg-blue-500",
        ["unavailable"] = "bg-muted-foreground/30",
    };

    private async Task HandleConnect(string id)
    {
        _selected = id;
        _state = ConnectionState.Connecting;
        await Task.Delay(2000);
        _state = ConnectionState.Connected;
    }
}
