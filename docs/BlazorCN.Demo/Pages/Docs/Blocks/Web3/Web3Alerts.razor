@* ============================================================
   Block: web3-alerts
   Title: Web3Alerts
   Description: React crypto alerts block for Next.js with price targets, whale movement, and gas threshold monitoring using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/web3-alerts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Alerts</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                New Alert
            </ButtonCn>
        </div>

        <div>
            @for (int i = 0; i < _activeAlerts.Length; i++)
            {
                var alert = _activeAlerts[i];
                var isLast = i == _activeAlerts.Length - 1;
                var dotColor = alert.Status == "active" ? "bg-emerald-500" : "bg-amber-500";
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dotColor)"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@alert.Condition</span>
                            <span class="font-mono text-xs tabular-nums">@alert.Value</span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @alert.Type
                            </BadgeCn>
                            @if (alert.LastTriggered != null)
                            {
                                <span class="text-muted-foreground text-xs">Triggered @alert.LastTriggered</span>
                            }
                        </div>
                    </div>
                    @{
                        var alertId = alert.Id;
                    }
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0"
                              OnClick="@(() => DeleteAlert(alertId))">
                        <LucideIconCn Name="trash" Size="12" Class="size-3 text-muted-foreground" />
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Alert(string Id, string Type, string Condition, string Value, string Status, string? LastTriggered = null);

    private static readonly Alert[] _alerts =
    [
        new("1", "Price", "ETH above",          "$4,000",    "active"),
        new("2", "Price", "BTC below",           "$60,000",   "active"),
        new("3", "Gas",   "Gas below",           "10 gwei",   "active"),
        new("4", "Whale", "ETH transfer above",  "10,000 ETH","triggered", "2 hours ago"),
        new("5", "Price", "SOL above",           "$200",      "active"),
    ];

    private List<string> _deletedIds = [];

    private Alert[] _activeAlerts => System.Array.FindAll(_alerts, a => !_deletedIds.Contains(a.Id));

    private void DeleteAlert(string id)
    {
        _deletedIds = [.._deletedIds, id];
    }
}
