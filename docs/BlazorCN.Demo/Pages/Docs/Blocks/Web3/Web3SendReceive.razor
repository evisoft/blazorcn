@* ============================================================
   Block: web3-send-receive
   Title: Web3SendReceive
   Description: A React and Next.js send and receive crypto block built with shadcn/ui and Tailwind CSS featuring address input and fee estimation.
   Source: original/blocks/web3/web3-send-receive.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid grid-cols-2 border-b">
            <button
                type="button"
                @onclick="@(() => _tab = "send")"
                class="@Cn.Merge("flex items-center justify-center gap-2 py-3 text-sm transition-colors", _tab == "send" ? "bg-muted/30 font-medium" : "text-muted-foreground hover:bg-muted/50")">
                <LucideIconCn Name="arrow-up-right" Size="14" Class="size-3.5" />
                Send
            </button>
            <button
                type="button"
                @onclick="@(() => _tab = "receive")"
                class="@Cn.Merge("flex items-center justify-center gap-2 border-l py-3 text-sm transition-colors", _tab == "receive" ? "bg-muted/30 font-medium" : "text-muted-foreground hover:bg-muted/50")">
                <LucideIconCn Name="arrow-down-left" Size="14" Class="size-3.5" />
                Receive
            </button>
        </div>

        @if (_tab == "send")
        {
            <div class="border-b px-4 py-3">
                <span class="text-muted-foreground text-xs">Recipient</span>
                <InputCn Class="mt-1.5 h-9 font-mono text-sm" Placeholder="0x... or ENS name" @bind-Value="_recipient" />
            </div>

            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Amount</span>
                    <span class="text-muted-foreground text-xs">Balance: 4.2851 ETH</span>
                </div>
                <div class="mt-1.5 flex items-center gap-2">
                    <InputCn Class="h-9 font-mono text-sm tabular-nums" Placeholder="0.0" @bind-Value="_amount" />
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-9 shrink-0 text-xs">
                        Max
                    </ButtonCn>
                </div>
            </div>

            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Network Fee</span>
                    <span class="tabular-nums">~$2.14</span>
                </div>
                <div class="mt-1.5 flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Est. Time</span>
                    <span>~30 seconds</span>
                </div>
                <div class="mt-1.5 flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Total</span>
                    <span class="font-medium tabular-nums">@(string.IsNullOrEmpty(_amount) ? "0.0" : _amount) ETH + gas</span>
                </div>
            </div>

            <div class="px-4 py-3">
                <ButtonCn Class="h-9 w-full text-sm" Disabled="@(string.IsNullOrEmpty(_amount) || string.IsNullOrEmpty(_recipient))">
                    Send ETH
                </ButtonCn>
            </div>
        }
        else
        {
            <div class="px-4 py-6">
                <div class="flex flex-col items-center gap-3">
                    <div class="flex size-16 items-center justify-center rounded-lg bg-muted/50">
                        <LucideIconCn Name="arrow-down-left" Size="24" Class="size-6 text-muted-foreground" />
                    </div>
                    <div class="text-center">
                        <p class="font-medium text-sm">Your Ethereum Address</p>
                        <p class="mt-1 font-mono text-muted-foreground text-xs">0x7a25...f3e8</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" @onclick="HandleCopy">
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        }
                        @(_copied ? "Copied" : "Copy Address")
                    </ButtonCn>
                    <p class="mt-2 max-w-xs text-center text-muted-foreground text-xs">
                        Only send Ethereum and ERC-20 tokens to this address. Sending other assets may
                        result in permanent loss.
                    </p>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private string _tab = "send";
    private string _amount = "";
    private string _recipient = "";
    private bool _copied = false;

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(1500);
        _copied = false;
    }
}
