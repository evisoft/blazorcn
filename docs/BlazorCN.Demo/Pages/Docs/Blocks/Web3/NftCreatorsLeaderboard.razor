@* ============================================================
   Block: nft-creators-leaderboard
   Title: NftCreatorsLeaderboard
   Description: React NFT creators leaderboard block for Next.js with time frame toggles and creator profiles using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/nft-creators-leaderboard.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <CardCn Class="border shadow-sm">
        <CardHeaderCn Class="flex flex-row flex-wrap items-start justify-between gap-6 p-6">
            <div>
                <h1 class="mb-1 text-2xl font-bold">Top Creators</h1>
                <p class="text-muted-foreground max-w-2xl text-lg">
                    The most sought-after collections across the entire ecosystem.
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm"
                          Variant="@(_timeFrame == "hour" ? ButtonVariant.Default : ButtonVariant.Outline)"
                          OnClick="@(() => _timeFrame = "hour")">
                    Last 24h
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm"
                          Variant="@(_timeFrame == "week" ? ButtonVariant.Default : ButtonVariant.Outline)"
                          OnClick="@(() => _timeFrame = "week")">
                    Last week
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm"
                          Variant="@(_timeFrame == "month" ? ButtonVariant.Default : ButtonVariant.Outline)"
                          OnClick="@(() => _timeFrame = "month")">
                    Last month
                </ButtonCn>
            </div>
        </CardHeaderCn>
        <CardContentCn Class="grid grid-cols-1 gap-6 px-6 pt-0 pb-6 md:grid-cols-2 lg:grid-cols-3">
            @foreach (var entry in _data)
            {
                <CardCn Class="flex flex-col justify-between py-4">
                    <CardHeaderCn Class="gap-0 px-4">
                        <p class="font-semibold">@entry.TokenId</p>
                        <div class="mt-4 flex flex-wrap items-start justify-between gap-4">
                            <div class="flex items-start gap-3">
                                <AvatarCn>
                                    <AvatarImageCn Alt="@entry.Name" Src="@entry.ProfileImg" />
                                    <AvatarFallbackCn>@entry.Name[0]</AvatarFallbackCn>
                                </AvatarCn>
                                <div>
                                    <p class="font-semibold">@entry.Name</p>
                                    <p class="text-muted-foreground text-sm">@entry.Desc</p>
                                </div>
                            </div>
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                                See Collection
                            </ButtonCn>
                        </div>
                    </CardHeaderCn>
                    <CardContentCn Class="grid grid-cols-3 gap-4 px-4">
                        @foreach (var img in entry.Imgs)
                        {
                            <img alt="nft"
                                 class="h-full min-h-24 w-full rounded-lg object-cover object-center"
                                 height="400"
                                 src="@img"
                                 width="400" />
                        }
                    </CardContentCn>
                </CardCn>
            }
        </CardContentCn>
    </CardCn>
</section>

@code {
    private string _timeFrame = "month";

    private record CreatorEntry(string TokenId, string ProfileImg, string Name, string Desc, string[] Imgs);

    private static readonly CreatorEntry[] _data =
    [
        new("#1",
            "https://images.unsplash.com/photo-1623853434105-8e7a72898180?auto=format&fit=crop&q=80&w=400&h=400",
            "Tina Andrew", "Creator",
            [
                "https://v3.material-tailwind.com/nft-1.svg",
                "https://v3.material-tailwind.com/nft-2.svg",
                "https://v3.material-tailwind.com/nft-4.svg",
            ]),
        new("#2",
            "https://images.unsplash.com/photo-1716662318479-a9c0f1cd1a0e?auto=format&fit=crop&q=80&w=400&h=400",
            "Linde Michael", "Creator",
            [
                "https://v3.material-tailwind.com/pixel-art-1.svg",
                "https://v3.material-tailwind.com/pixel-art-2.svg",
                "https://v3.material-tailwind.com/pixel-art-3.svg",
            ]),
        new("#3",
            "https://v3.material-tailwind.com/man-profile-2.jpg",
            "Misha Stam", "Creator",
            [
                "https://v3.material-tailwind.com/nft-3.svg",
                "https://v3.material-tailwind.com/nft-3.svg",
                "https://v3.material-tailwind.com/nft-3.svg",
            ]),
    ];
}
