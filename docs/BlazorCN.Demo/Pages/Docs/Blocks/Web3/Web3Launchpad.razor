@* ============================================================
   Block: web3-launchpad
   Title: Web3Launchpad
   Description: A React and Next.js token launchpad block built with shadcn/ui and Tailwind CSS. Displays IDOs, funding progress, and participant counts.
   Source: original/blocks/web3/web3-launchpad.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Launchpad</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @(_projects.Count(p => p.Status == LaunchStatus.Live)) live
            </BadgeCn>
        </div>

        <div>
            @foreach (var (proj, index) in _projects.Select((p, i) => (p, i)))
            {
                var isLast = index == _projects.Length - 1;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", _statusStyle[proj.Status])"></span>
                            <span class="font-medium text-sm">@proj.Name</span>
                            <span class="font-mono text-muted-foreground text-xs">@proj.Symbol</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @proj.Chain
                            </BadgeCn>
                        </div>
                        <span class="text-muted-foreground text-xs">@proj.Date</span>
                    </div>
                    @if (proj.Status != LaunchStatus.Upcoming)
                    {
                        <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-blue-500" style="@($"width:{proj.Progress}%")"></div>
                        </div>
                        <div class="mt-1.5 flex items-center justify-between text-xs">
                            <span class="tabular-nums">@proj.Raised / @proj.Goal</span>
                            <span class="text-muted-foreground tabular-nums">@proj.Participants participants</span>
                        </div>
                    }
                    <div class="mt-2 flex items-center justify-between">
                        <span class="text-muted-foreground text-xs">Allocation: @proj.Allocation</span>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" Disabled="@(proj.Status == LaunchStatus.Completed)">
                            @(proj.Status == LaunchStatus.Live ? "Participate" : proj.Status == LaunchStatus.Upcoming ? "Register" : "Completed")
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum LaunchStatus { Live, Upcoming, Completed }

    private record LaunchProject(
        string Id,
        string Name,
        string Symbol,
        string Chain,
        string Raised,
        string Goal,
        int Progress,
        string Participants,
        string Allocation,
        LaunchStatus Status,
        string Date
    );

    private static readonly LaunchProject[] _projects =
    [
        new("1", "NeuralAI",     "NRAI",  "Ethereum", "$2.4M",  "$3M",   80, "4,218", "$500 max",   LaunchStatus.Live,      "Ends in 2 days"),
        new("2", "ZK Bridge",    "ZKB",   "Ethereum", "$0",     "$5M",    0, "0",     "$1,000 max", LaunchStatus.Upcoming,  "Starts Mar 28"),
        new("3", "GameVerse",    "GVRSE", "Polygon",  "$1.8M",  "$2M",   90, "3,612", "$250 max",   LaunchStatus.Live,      "Ends in 12 hours"),
        new("4", "StableYield",  "SYLD",  "Arbitrum", "$800K",  "$1.5M", 53, "1,845", "$750 max",   LaunchStatus.Live,      "Ends in 5 days"),
    ];

    private static readonly Dictionary<LaunchStatus, string> _statusStyle = new()
    {
        [LaunchStatus.Live]      = "bg-emerald-500",
        [LaunchStatus.Upcoming]  = "bg-blue-500",
        [LaunchStatus.Completed] = "bg-muted-foreground/30",
    };
}
