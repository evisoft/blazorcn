@* ============================================================
   Block: web3-contributor-rewards
   Title: Web3ContributorRewards
   Description: A React and Next.js DAO contributor rewards tracker built with shadcn/ui and Tailwind CSS for token claims.
   Source: original/blocks/web3/web3-contributor-rewards.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="award" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Contributor Rewards</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_tier Tier
            </BadgeCn>
        </div>

        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Earned</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums">@_totalEarned</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Pending</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums">@_pendingRewards</p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-1.5 h-6 px-2 text-xs" @onclick="@(() => _claimed = true)" Disabled="@_claimed">
                    @(_claimed ? "Claimed" : "Claim All")
                </ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <p class="text-muted-foreground text-xs">Next tier: @_nextTier</p>
            <div class="mt-1.5 h-1.5 overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-amber-500" style="width:85%"></div>
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Recent Activity</span>
            </div>
            @foreach (var entry in _contributions)
            {
                var isLast = entry.Activity == _contributions[_contributions.Length - 1].Activity;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <span class="text-sm">@entry.Activity</span>
                        <div class="mt-0.5 flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @entry.Category
                            </BadgeCn>
                            <span class="text-muted-foreground text-xs">@entry.Date</span>
                        </div>
                    </div>
                    <span class="font-mono text-xs tabular-nums shrink-0 text-emerald-600 dark:text-emerald-400">
                        +@entry.Reward
                    </span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private bool _claimed = false;

    private const string _totalEarned = "4,250 PROTO";
    private const string _pendingRewards = "2,100 PROTO";
    private const string _tier = "Gold";
    private const string _nextTier = "5,000 PROTO to Platinum";

    private record ContributionEntry(string Activity, string Category, string Reward, string Date);

    private static readonly ContributionEntry[] _contributions =
    [
        new("Merged PR #142 — gas optimization",         "Development", "500 PROTO",   "2 days ago"),
        new("Reviewed governance proposal PIP-38",       "Governance",  "100 PROTO",   "5 days ago"),
        new("Created tutorial: Staking Guide",           "Content",     "300 PROTO",   "1 week ago"),
        new("Reported critical bug in bridge",           "Security",    "1,000 PROTO", "2 weeks ago"),
        new("Moderated Discord for March",               "Community",   "200 PROTO",   "2 weeks ago"),
    ];
}
