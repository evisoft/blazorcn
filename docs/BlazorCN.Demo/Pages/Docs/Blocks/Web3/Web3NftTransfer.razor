@* ============================================================
   Block: web3-nft-transfer
   Title: Web3NftTransfer
   Description: A React and Next.js NFT transfer block built with shadcn/ui and Tailwind CSS. Features recipient input, NFT selector, gas estimation, and confirmation.
   Source: original/blocks/web3/web3-nft-transfer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="send" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Transfer NFT</span>
            </div>
        </div>

        @if (_confirmed)
        {
            <div class="px-4 py-8 text-center">
                <p class="font-medium text-sm">Transfer Submitted</p>
                <p class="mt-1 text-muted-foreground text-xs">@(SelectedNft?.Name) is being transferred</p>
                <p class="mt-2 font-mono text-muted-foreground text-xs">Tx: 0x8f2a...b4c1</p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-4 h-7 text-xs" @onclick="@(() => _confirmed = false)">
                    Transfer Another
                </ButtonCn>
            </div>
        }
        else
        {
            <div class="border-b px-4 py-3">
                <span class="text-muted-foreground text-xs">Select NFT</span>
                <div class="mt-1.5 space-y-1.5">
                    @foreach (var n in _nfts)
                    {
                        var nft = n;
                        <button type="button"
                                class="@Cn.Merge("flex w-full items-center gap-3 rounded-md px-3 py-2 text-left transition-colors", _selectedNftId == nft.Id ? "bg-muted/50 ring-1 ring-foreground/10" : "hover:bg-muted/30")"
                                @onclick="@(() => _selectedNftId = nft.Id)">
                            <div class="size-8 shrink-0 rounded bg-muted/50"></div>
                            <div>
                                <span class="font-medium text-sm">@nft.Name</span>
                                <p class="text-muted-foreground text-xs">@nft.Collection</p>
                            </div>
                        </button>
                    }
                </div>
            </div>

            <div class="border-b px-4 py-3">
                <span class="text-muted-foreground text-xs">Recipient</span>
                <InputCn @bind-Value="_recipient" Class="mt-1.5 h-9 font-mono text-sm" Placeholder="0x... or ENS name" />
            </div>

            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Token Standard</span>
                    <span>ERC-721</span>
                </div>
                <div class="mt-1.5 flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Est. Gas</span>
                    <span class="tabular-nums">~$5.50</span>
                </div>
            </div>

            <div class="px-4 py-3">
                <ButtonCn Class="h-9 w-full text-sm" Disabled="@(string.IsNullOrEmpty(_recipient))" @onclick="@(() => _confirmed = true)">
                    Transfer @(SelectedNft?.Name)
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private record NftOption(string Id, string Name, string Collection, string TokenId);

    private static readonly NftOption[] _nfts =
    [
        new NftOption("1", "Cosmic Ape #4217", "Cosmic Apes", "4217"),
        new NftOption("2", "Pixel Punk #891", "Pixel Punks", "891"),
        new NftOption("3", "Digital Dream #77", "Digital Dreams", "77"),
    ];

    private string _selectedNftId = "1";
    private string _recipient = "";
    private bool _confirmed = false;

    private NftOption? SelectedNft => Array.Find(_nfts, n => n.Id == _selectedNftId);
}
