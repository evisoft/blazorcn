@* ============================================================
   Block: web3-nft-gallery
   Title: Web3NftGallery
   Description: A React and Next.js NFT gallery block built with shadcn/ui and Tailwind CSS. Features collection filtering, floor prices, and hover details.
   Source: original/blocks/web3/web3-nft-gallery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">My NFTs</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_nfts.Length
                </BadgeCn>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="@(_view == "grid" ? ButtonVariant.Default : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-7 w-7 p-0"
                          OnClick="@(() => _view = "grid")">
                    <LucideIconCn Name="grid" Size="14" Class="size-3.5" />
                </ButtonCn>
                <ButtonCn Variant="@(_view == "list" ? ButtonVariant.Default : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-7 w-7 p-0"
                          OnClick="@(() => _view = "list")">
                    <LucideIconCn Name="list" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        @if (_view == "grid")
        {
            <div class="grid grid-cols-2 gap-px bg-border sm:grid-cols-3">
                @foreach (var nft in _nfts)
                {
                    <div class="group relative bg-card">
                        <div class="aspect-square overflow-hidden">
                            <img src="@nft.Image"
                                 alt="@nft.Name"
                                 class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
                        </div>
                        <div class="px-3 py-2">
                            <p class="truncate font-medium text-sm">@nft.Name</p>
                            <div class="mt-1 flex items-center justify-between">
                                <span class="text-muted-foreground text-xs">Rank #@nft.Rarity</span>
                                <span class="font-mono text-xs tabular-nums">@nft.Price</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div>
                @foreach (var nft in _nfts)
                {
                    var isLast = nft.Id == _nfts[_nfts.Length - 1].Id;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                        <div class="size-10 shrink-0 overflow-hidden rounded-md">
                            <img src="@nft.Image" alt="@nft.Name" class="h-full w-full object-cover" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@nft.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@nft.Collection</p>
                        </div>
                        <div class="text-right">
                            <span class="font-mono text-sm tabular-nums">@nft.Price</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">Rank #@nft.Rarity</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private string _view = "grid";

    private record NftItem(string Id, string Name, string Collection, string TokenId, int Rarity, string Price, string Image);

    private static readonly NftItem[] _nfts =
    [
        new("1", "Cosmic Ape #4217", "Cosmic Apes", "4217", 142, "2.4 ETH", "https://picsum.photos/seed/nft1/400/400"),
        new("2", "Pixel Punk #891", "Pixel Punks", "891", 53, "8.1 ETH", "https://picsum.photos/seed/nft2/400/400"),
        new("3", "Meta Realm #2033", "Meta Realms", "2033", 312, "0.9 ETH", "https://picsum.photos/seed/nft3/400/400"),
        new("4", "Digital Dream #77", "Digital Dreams", "77", 18, "15.3 ETH", "https://picsum.photos/seed/nft4/400/400"),
        new("5", "Cyber Cat #1456", "Cyber Cats", "1456", 220, "1.2 ETH", "https://picsum.photos/seed/nft5/400/400"),
        new("6", "Astro Bear #609", "Astro Bears", "609", 87, "3.7 ETH", "https://picsum.photos/seed/nft6/400/400"),
    ];
}
