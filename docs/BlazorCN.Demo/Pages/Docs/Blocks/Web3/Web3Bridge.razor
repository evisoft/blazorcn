@* ============================================================
   Block: web3-bridge
   Title: Web3Bridge
   Description: React cross-chain bridge block for Next.js with token transfers, fee estimation, and route display using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/web3-bridge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="arrow-right-left" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Bridge</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Fast Route
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">From</span>
            <div class="mt-1.5 flex items-center gap-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1 shrink-0">
                    <span class="text-xs font-medium">@(_chains.Find(c => c.Id == _fromChain)?.Name)</span>
                    <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                </ButtonCn>
                <InputCn Class="h-8 font-mono text-sm tabular-nums" Placeholder="0.0" @bind-Value="_amount" />
                <span class="shrink-0 font-mono text-muted-foreground text-xs">ETH</span>
            </div>
            <p class="mt-1 text-muted-foreground text-xs tabular-nums">Balance: 4.2851 ETH</p>
        </div>

        <div class="relative flex items-center justify-center">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="absolute z-10 h-8 w-8 rounded-full p-0 bg-card" @onclick="HandleSwapChains">
                <LucideIconCn Name="arrow-down" Size="14" Class="size-3.5" />
            </ButtonCn>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">To</span>
            <div class="mt-1.5 flex items-center gap-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1 shrink-0">
                    <span class="text-xs font-medium">@(_chains.Find(c => c.Id == _toChain)?.Name)</span>
                    <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                </ButtonCn>
                <div class="h-8 flex items-center font-mono text-sm tabular-nums text-muted-foreground">
                    ~0.9985 ETH
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Route</span>
            <div class="rounded-md bg-muted/50 p-3">
                <div class="flex items-center justify-between text-xs">
                    <span>@(_chains.Find(c => c.Id == _fromChain)?.Name)</span>
                    <span class="text-muted-foreground">via Stargate</span>
                    <span>@(_chains.Find(c => c.Id == _toChain)?.Name)</span>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Bridge Fee</span>
                <span class="tabular-nums">0.0015 ETH (~$5.40)</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Gas Fee</span>
                <span class="tabular-nums">~$3.20</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Est. Time</span>
                <span>~2 minutes</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">You Receive</span>
                <span class="font-medium tabular-nums">~0.9985 ETH</span>
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="h-9 w-full text-sm">Bridge Tokens</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _fromChain = "ethereum";
    private string _toChain = "arbitrum";
    private string _amount = "1.0";

    private record Chain(string Id, string Name, string Symbol);

    private static readonly List<Chain> _chains =
    [
        new("ethereum", "Ethereum", "ETH"),
        new("arbitrum", "Arbitrum", "ARB"),
        new("polygon",  "Polygon",  "MATIC"),
        new("optimism", "Optimism", "OP"),
        new("base",     "Base",     "BASE"),
    ];

    private void HandleSwapChains()
    {
        var tmp = _fromChain;
        _fromChain = _toChain;
        _toChain = tmp;
    }
}
