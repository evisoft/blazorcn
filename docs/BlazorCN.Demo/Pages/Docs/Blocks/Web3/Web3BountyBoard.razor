@* ============================================================
   Block: web3-bounty-board
   Title: Web3BountyBoard
   Description: React crypto bounty board block for Next.js with task listings, rewards, and claim workflow using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/web3-bounty-board.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="target" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Bounty Board</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @(_openCount) open
            </BadgeCn>
        </div>

        <div>
            @foreach (var b in _bounties)
            {
                var isLast = b.Id == _bounties[_bounties.Length - 1].Id;
                var isClaimed = _claimedIds.Contains(b.Id);
                var bounty = b;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", StatusDotClass(b.Status))"></span>
                            <span class="font-medium text-sm">@b.Title</span>
                        </div>
                        <span class="font-mono text-sm tabular-nums shrink-0">@b.Reward</span>
                    </div>
                    <div class="mt-1.5 flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @b.Category
                        </BadgeCn>
                        <span class="@Cn.Merge("text-xs capitalize", DifficultyColorClass(b.Difficulty))">
                            @b.Difficulty
                        </span>
                        <span class="text-muted-foreground text-xs">@b.Deadline left</span>
                        @if (b.Submissions > 0)
                        {
                            <span class="text-muted-foreground text-xs tabular-nums">
                                @b.Submissions submissions
                            </span>
                        }
                    </div>
                    @if (b.Status == "open" && !isClaimed)
                    {
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-2 h-6 px-2 text-xs" @onclick="@(() => ClaimBounty(bounty.Id))">
                            Claim Bounty
                        </ButtonCn>
                    }
                    @if (isClaimed)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="mt-2 font-normal text-xs">
                            Claimed by you
                        </BadgeCn>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private List<string> _claimedIds = new();

    private record Bounty(string Id, string Title, string Reward, string Difficulty, string Category, string Deadline, int Submissions, string Status);

    private static readonly Bounty[] _bounties =
    [
        new("1", "Fix pagination bug in governance UI",   "500 USDC",   "easy",   "Bug Fix",     "3 days",  2, "open"),
        new("2", "Implement cross-chain bridge adapter",  "5,000 USDC", "hard",   "Development", "14 days", 0, "open"),
        new("3", "Design new token dashboard mockups",    "1,500 USDC", "medium", "Design",      "7 days",  3, "review"),
        new("4", "Write integration test suite for staking", "2,000 USDC", "medium", "Testing",  "10 days", 1, "in-progress"),
        new("5", "Translate docs to Spanish",             "800 USDC",   "easy",   "Content",     "5 days",  0, "open"),
    ];

    private int _openCount => System.Linq.Enumerable.Count(_bounties, b => b.Status == "open");

    private static string DifficultyColorClass(string difficulty) => difficulty switch
    {
        "easy"   => "text-emerald-600 dark:text-emerald-400",
        "medium" => "text-amber-600 dark:text-amber-400",
        "hard"   => "text-red-600 dark:text-red-400",
        _        => ""
    };

    private static string StatusDotClass(string status) => status switch
    {
        "open"        => "bg-emerald-500",
        "in-progress" => "bg-blue-500",
        "review"      => "bg-amber-500",
        _             => ""
    };

    private void ClaimBounty(string id)
    {
        if (!_claimedIds.Contains(id))
            _claimedIds.Add(id);
    }
}
