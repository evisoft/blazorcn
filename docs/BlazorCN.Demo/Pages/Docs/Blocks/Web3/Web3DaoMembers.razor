@* ============================================================
   Block: web3-dao-members
   Title: Web3DaoMembers
   Description: A React DAO member directory block built with Next.js, shadcn/ui, and Tailwind CSS featuring voting power, delegation, and role badges.
   Source: original/blocks/web3/web3-dao-members.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Members</span>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span class="tabular-nums">@_members.Length members</span>
                <span>·</span>
                <span class="tabular-nums">668,800 total power</span>
            </div>
        </div>

        <div>
            @for (int i = 0; i < _members.Length; i++)
            {
                var member = _members[i];
                var isLast = i == _members.Length - 1;
                var config = GetRoleConfig(member.Role);
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <AvatarCn Class="size-8 shrink-0">
                        <AvatarFallbackCn Class="text-xs">@member.Initials</AvatarFallbackCn>
                    </AvatarCn>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@member.Ens</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-xs", config.Color)">
                                @config.Label
                            </BadgeCn>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span class="font-mono">@member.Address</span>
                            @if (member.DelegatedFrom > 0)
                            {
                                <span>·</span>
                                <span class="tabular-nums">@member.DelegatedFrom delegators</span>
                            }
                        </div>
                    </div>
                    <div class="text-right shrink-0">
                        <span class="font-medium text-sm tabular-nums">@member.VotingPower</span>
                        <div class="mt-0.5 flex items-center justify-end gap-2 text-muted-foreground text-xs">
                            <span class="tabular-nums">@(member.Proposals)P</span>
                            <span class="tabular-nums">@(member.Votes)V</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Member(string Address, string Ens, string Initials, string Role, string VotingPower, int DelegatedFrom, int Proposals, int Votes);

    private record RoleConfig(string Label, string Color);

    private static readonly Member[] _members =
    [
        new("0x7a25...f3e8", "vitalik.eth",    "VB", "core",        "245,000", 142, 12, 38),
        new("0x3c4d...a1b2", "defi-whale.eth", "DW", "delegate",    "189,500",  89,  5, 42),
        new("0x9e8f...c3d4", "builder.eth",    "BU", "core",        "125,000",   0,  8, 35),
        new("0x5a6b...e5f6", "anon-dev.eth",   "AD", "contributor", "52,300",   23,  2, 28),
        new("0x1d2e...f7a8", "nft-lord.eth",   "NL", "delegate",    "41,200",   67,  0, 31),
        new("0x8b9c...d0e1", "—",         "0x", "member",      "15,800",    0,  0, 12),
    ];

    private static RoleConfig GetRoleConfig(string role) => role switch
    {
        "core"        => new("Core",        "text-amber-600 dark:text-amber-400"),
        "delegate"    => new("Delegate",    "text-blue-600 dark:text-blue-400"),
        "contributor" => new("Contributor", "text-emerald-600 dark:text-emerald-400"),
        _             => new("Member",      "text-muted-foreground"),
    };
}
