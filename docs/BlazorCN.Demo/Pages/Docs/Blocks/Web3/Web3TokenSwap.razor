@* ============================================================
   Block: web3-token-swap
   Title: Web3TokenSwap
   Description: A React and Next.js token swap block built with shadcn/ui and Tailwind CSS featuring exchange rates and slippage controls.
   Source: original/blocks/web3/web3-token-swap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Swap</span>
            <ButtonCn aria-label="Swap settings" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0" @onclick="@(() => _showSettings = !_showSettings)">
                <LucideIconCn Name="settings" Size="14" Class="size-3.5" />
            </ButtonCn>
        </div>

        @if (_showSettings)
        {
            <div class="border-b px-4 py-3">
                <p class="mb-2 text-muted-foreground text-xs font-medium">Slippage Tolerance</p>
                <div class="flex items-center gap-2">
                    @foreach (var val in _slippageOptions)
                    {
                        var v = val;
                        <ButtonCn Variant="@(_slippage == v ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => _slippage = v)">
                            @v%
                        </ButtonCn>
                    }
                    <div class="flex items-center gap-1">
                        <InputCn Class="h-7 w-16 text-center text-xs" @bind-Value="_slippage" />
                        <span class="text-muted-foreground text-xs">%</span>
                    </div>
                </div>
            </div>
        }

        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between mb-2">
                <span class="text-muted-foreground text-xs">From</span>
                <span class="text-muted-foreground text-xs">
                    Balance: @(GetBalance(_fromToken)) @_fromToken
                </span>
            </div>
            <div class="flex items-center gap-3">
                <InputCn Class="h-10 border-0 bg-transparent px-0 font-semibold text-xl shadow-none focus-visible:ring-0 tabular-nums" Placeholder="0.0" @bind-Value="_fromAmount" />
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1 shrink-0">
                    <span class="font-mono text-xs font-medium">@_fromToken</span>
                    <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        <div class="relative">
            <div class="absolute -top-4 left-1/2 z-10 -translate-x-1/2">
                <ButtonCn aria-label="Reverse swap direction" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 w-8 rounded-full p-0 bg-card" @onclick="HandleReverse">
                    <LucideIconCn Name="arrow-down-up" Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between mb-2">
                <span class="text-muted-foreground text-xs">To</span>
                <span class="text-muted-foreground text-xs">
                    Balance: @(GetBalance(_toToken)) @_toToken
                </span>
            </div>
            <div class="flex items-center gap-3">
                <div class="h-10 flex items-center font-semibold text-xl tabular-nums text-muted-foreground">
                    @_toAmount
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1 shrink-0 ml-auto">
                    <span class="font-mono text-xs font-medium">@_toToken</span>
                    <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Rate</span>
                <span class="tabular-nums">
                    1 @_fromToken = 3,601.25 @_toToken
                </span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Network Fee</span>
                <span class="tabular-nums text-muted-foreground">~$4.23</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Price Impact</span>
                <span class="tabular-nums text-emerald-600 dark:text-emerald-400">&lt;0.01%</span>
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full h-9 text-sm">Swap Tokens</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _fromAmount = "1.0";
    private string _toAmount = "3,601.25";
    private string _fromToken = "ETH";
    private string _toToken = "USDC";
    private string _slippage = "0.5";
    private bool _showSettings = false;

    private static readonly string[] _slippageOptions = ["0.1", "0.5", "1.0"];

    private record Token(string Symbol, string Name, string Balance);

    private static readonly Token[] _tokenList =
    [
        new("ETH",  "Ethereum",    "4.2851"),
        new("USDC", "USD Coin",    "5,230.00"),
        new("USDT", "Tether",      "2,100.00"),
        new("DAI",  "Dai",         "1,500.00"),
        new("WBTC", "Wrapped BTC", "0.0821"),
    ];

    private string GetBalance(string symbol)
    {
        foreach (var t in _tokenList)
        {
            if (t.Symbol == symbol) return t.Balance;
        }
        return "0";
    }

    private void HandleReverse()
    {
        var tmp = _fromToken;
        _fromToken = _toToken;
        _toToken = tmp;
    }
}
