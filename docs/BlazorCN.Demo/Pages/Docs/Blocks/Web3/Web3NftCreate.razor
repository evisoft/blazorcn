@* ============================================================
   Block: web3-nft-create
   Title: Web3NftCreate
   Description: A React and Next.js NFT creation form built with shadcn/ui Input, Textarea, Button, Badge and Tailwind CSS
   Source: original/blocks/web3/web3-nft-create.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="image-plus" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Create NFT</span>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <div class="flex aspect-video items-center justify-center rounded-md border-2 border-dashed bg-muted/30">
                <div class="text-center">
                    <LucideIconCn Name="image-plus" Size="32" Class="mx-auto size-8 text-muted-foreground/50" />
                    <p class="mt-2 text-muted-foreground text-xs">Drag and drop or click to upload</p>
                    <p class="mt-0.5 text-muted-foreground/60 text-xs">
                        PNG, JPG, GIF, SVG, MP4. Max 100MB.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Name</span>
            <InputCn @bind-Value="_name" Class="mt-1.5 h-9 text-sm" Placeholder="My NFT #1" />
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Description</span>
            <TextareaCn @bind-Value="_description" Class="mt-1.5 min-h-[80px] text-sm" Placeholder="Describe your NFT..." />
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-medium text-muted-foreground">Properties</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" @onclick="AddProperty">
                    <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    Add
                </ButtonCn>
            </div>
            <div class="space-y-2">
                @for (int i = 0; i < _properties.Count; i++)
                {
                    var idx = i;
                    <div class="grid grid-cols-2 gap-2">
                        <InputCn Value="@_properties[idx].Trait"
                                 ValueChanged="@((string v) => SetTrait(idx, v))"
                                 Class="h-8 text-xs"
                                 Placeholder="Trait name" />
                        <InputCn Value="@_properties[idx].Value"
                                 ValueChanged="@((string v) => SetValue(idx, v))"
                                 Class="h-8 text-xs"
                                 Placeholder="Value" />
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Chain</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Ethereum
                </BadgeCn>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Royalty</span>
                <span class="tabular-nums">5.0%</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Est. Gas</span>
                <span class="tabular-nums">~$8.50</span>
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="h-9 w-full text-sm" Disabled="@(string.IsNullOrEmpty(_name))">
                Mint NFT
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _name = "";
    private string _description = "";

    private record Property(string Trait, string Value);

    private List<Property> _properties =
    [
        new Property("Background", "Blue"),
        new Property("Rarity", "Legendary"),
    ];

    private void AddProperty()
    {
        _properties.Add(new Property("", ""));
    }

    private void SetTrait(int index, string value)
    {
        _properties[index] = new Property(value, _properties[index].Value);
    }

    private void SetValue(int index, string value)
    {
        _properties[index] = new Property(_properties[index].Trait, value);
    }
}
