@* ============================================================
   Block: web3-nft-marketplace
   Title: Web3NftMarketplace
   Description: A React and Next.js NFT marketplace block built with shadcn/ui and Tailwind CSS. Features filterable listings, sort options, and buy/offer actions.
   Source: original/blocks/web3/web3-nft-marketplace.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-medium text-sm">Marketplace</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_listings.Length listed
                </BadgeCn>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="filter" Size="12" Class="size-3" />
                    Filter
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                    <LucideIconCn Name="arrow-up-down" Size="12" Class="size-3" />
                    Sort
                </ButtonCn>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-px bg-border">
            @foreach (var listing in _listings)
            {
                var item = listing;
                <div class="bg-card">
                    <div class="aspect-square overflow-hidden">
                        <img src="@item.Image" alt="@item.Name" class="h-full w-full object-cover" />
                    </div>
                    <div class="p-3">
                        <p class="text-muted-foreground text-xs">@item.Collection</p>
                        <p class="mt-0.5 truncate font-medium text-sm">@item.Name</p>
                        <div class="mt-2 flex items-baseline justify-between">
                            <div>
                                <p class="font-mono font-medium text-sm tabular-nums">@item.Price</p>
                                <p class="text-muted-foreground text-xs tabular-nums">@item.UsdPrice</p>
                            </div>
                            <span class="text-muted-foreground text-xs">#@item.Rarity</span>
                        </div>
                        <div class="mt-2 flex gap-1.5">
                            <ButtonCn Size="ButtonSize.Sm" Class="h-7 flex-1 text-xs">
                                Buy
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 flex-1 text-xs">
                                Offer
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Listing(string Id, string Name, string Collection, string Price, string UsdPrice, string LastSale, int Rarity, string Image);

    private static readonly Listing[] _listings =
    [
        new("1", "Bored Ape #7821", "BAYC",            "28.5 ETH", "$102,635", "25.2 ETH", 1243, "https://picsum.photos/seed/mp1/400/400"),
        new("2", "Azuki #4501",     "Azuki",           "6.8 ETH",  "$24,488",  "5.9 ETH",   892, "https://picsum.photos/seed/mp2/400/400"),
        new("3", "Doodle #3127",    "Doodles",         "3.2 ETH",  "$11,524",  "3.5 ETH",   456, "https://picsum.photos/seed/mp3/400/400"),
        new("4", "Clone X #9012",   "CloneX",          "2.1 ETH",  "$7,562",   "1.8 ETH",  2104, "https://picsum.photos/seed/mp4/400/400"),
        new("5", "Moonbird #1087",  "Moonbirds",       "1.9 ETH",  "$6,842",   "2.3 ETH",   671, "https://picsum.photos/seed/mp5/400/400"),
        new("6", "Pudgy #5520",     "Pudgy Penguins",  "8.4 ETH",  "$30,250",  "7.1 ETH",   310, "https://picsum.photos/seed/mp6/400/400"),
