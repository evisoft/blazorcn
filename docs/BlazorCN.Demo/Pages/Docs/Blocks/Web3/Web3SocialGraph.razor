@* ============================================================
   Block: web3-social-graph
   Title: Web3SocialGraph
   Description: A React and Next.js on-chain social graph block built with shadcn/ui and Tailwind CSS featuring followers and mutual connections.
   Source: original/blocks/web3/web3-social-graph.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Social Graph</span>
            </div>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3 text-center">
                <p class="font-semibold text-lg tabular-nums">142</p>
                <p class="text-muted-foreground text-xs">Following</p>
            </div>
            <div class="border-r px-4 py-3 text-center">
                <p class="font-semibold text-lg tabular-nums">89</p>
                <p class="text-muted-foreground text-xs">Followers</p>
            </div>
            <div class="px-4 py-3 text-center">
                <p class="font-semibold text-lg tabular-nums">64</p>
                <p class="text-muted-foreground text-xs">Mutual</p>
            </div>
        </div>

        <div class="border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">Suggested Connections</span>
        </div>

        <div>
            @for (int i = 0; i < _connections.Length; i++)
            {
                var conn = _connections[i];
                var isLast = i == _connections.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted/50">
                        <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@conn.Ens</span>
                            <span class="text-muted-foreground text-xs">@conn.Mutuals mutuals</span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-1">
                            @foreach (var proto in conn.SharedProtocols)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@proto</BadgeCn>
                            }
                        </div>
                    </div>
                    <ButtonCn Variant="@(conn.Following ? ButtonVariant.Ghost : ButtonVariant.Outline)"
                              Size="ButtonSize.Sm"
                              Class="h-6 px-2 text-xs">
                        @(conn.Following ? "Following" : "Follow")
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Connection(string Address, string Ens, int Mutuals, string[] SharedProtocols, bool Following);

    private static readonly Connection[] _connections =
    [
        new("0x3b91...a2c7", "bob.eth",   12, ["Uniswap", "Aave"],      true),
        new("0x9e12...d4b6", "carol.eth",  8, ["Lido", "Curve"],         false),
        new("0x4f8c...e1a9", "dan.eth",   24, ["Uniswap", "ENS"],        true),
        new("0x6d03...b7f2", "eve.eth",    5, ["OpenSea", "Blur"],       false),
        new("0x8c54...f1b3", "frank.eth", 15, ["Aave", "Compound"],      true),
    ];
}
