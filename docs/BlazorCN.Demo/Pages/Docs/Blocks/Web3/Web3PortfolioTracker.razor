@* ============================================================
   Block: web3-portfolio-tracker
   Title: Web3PortfolioTracker
   Description: A React crypto portfolio tracker built with Next.js, shadcn/ui, and Tailwind CSS featuring multi-chain asset allocation.
   Source: original/blocks/web3/web3-portfolio-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="pie-chart" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Portfolio</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                5 assets
            </BadgeCn>
        </div>

        @* Total value *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-xs">Total Value</p>
            <p class="mt-0.5 font-semibold text-2xl tabular-nums">@_totalValue</p>
            <p class="mt-0.5 flex items-center gap-1 text-emerald-600 dark:text-emerald-400 text-sm tabular-nums">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                @_totalChange
            </p>
        </div>

        @* Allocation bar *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Allocation</span>
            <div class="mt-2 flex h-2 overflow-hidden rounded-full">
                @for (int i = 0; i < _holdings.Length; i++)
                {
                    var holding = _holdings[i];
                    var color = _allocationColors[i];
                    <div class="@color" style="@($"width:{holding.Allocation}%")"></div>
                }
            </div>
            <div class="mt-2 flex flex-wrap gap-3">
                @for (int i = 0; i < _holdings.Length; i++)
                {
                    var holding = _holdings[i];
                    var color = _allocationColors[i];
                    <span class="flex items-center gap-1 text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", color)"></span>
                        @holding.Token
                        <span class="text-muted-foreground tabular-nums">@holding.Allocation%</span>
                    </span>
                }
            </div>
        </div>

        @* Holdings list *@
        <div>
            @for (int i = 0; i < _holdings.Length; i++)
            {
                var holding = _holdings[i];
                var isLast = i == _holdings.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@holding.Token</span>
                            <span class="text-muted-foreground text-xs">@holding.Chain</span>
                        </div>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs tabular-nums">
                            @holding.Balance
                        </p>
                    </div>
                    <div class="text-right">
                        <span class="font-mono text-sm tabular-nums">@holding.Value</span>
                        <p class="@Cn.Merge("mt-0.5 font-mono text-xs tabular-nums", holding.Positive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                            @holding.Change24h
                        </p>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Holding(string Token, string Chain, string Balance, string Value, int Allocation, string Change24h, bool Positive);

    private static readonly Holding[] _holdings =
    [
        new("ETH",   "Ethereum", "4.2851",   "$15,432", 38, "+1.67%", true),
        new("BTC",   "Bitcoin",  "0.2450",   "$16,317", 40, "+0.82%", true),
        new("USDC",  "Ethereum", "5,230.00", "$5,230",  13, "0.00%",  true),
        new("SOL",   "Solana",   "22.50",    "$3,307",   8, "-2.41%", false),
        new("MATIC", "Polygon",  "450.00",   "$400",     1, "+3.12%", true),
    ];

    private static readonly string[] _allocationColors =
    [
        "bg-blue-500",
        "bg-amber-500",
        "bg-emerald-500",
        "bg-purple-500",
        "bg-cyan-500",
    ];

    private const string _totalValue = "$40,686";
    private const string _totalChange = "+$412.50 (+1.02%)";
}
