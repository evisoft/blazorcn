@* ============================================================
   Block: web3-wallet-connect
   Title: Web3WalletConnect
   Description: A React and Next.js wallet connection modal block built with shadcn/ui Badge, Button and Tailwind CSS for Web3 onboarding.
   Source: original/blocks/web3/web3-wallet-connect.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="wallet" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Connect Wallet</span>
            </div>
            @if (_connectionState == ConnectionState.Connected)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    <span class="mr-1.5 inline-block size-1.5 rounded-full bg-emerald-500"></span>
                    Connected
                </BadgeCn>
            }
        </div>

        @if (_connectionState == ConnectionState.Connected && _selected != null)
        {
            <div class="px-4 py-6">
                <div class="flex flex-col items-center gap-3">
                    <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="check" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
                    </div>
                    <div class="text-center">
                        <p class="font-medium text-sm">@(GetWalletName(_selected))</p>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">0x7a25...f3e8</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-2 h-7 text-xs" @onclick="HandleDisconnect">
                        Disconnect
                    </ButtonCn>
                </div>
            </div>
        }
        else if (_connectionState == ConnectionState.Error)
        {
            <div class="px-4 py-6">
                <div class="flex flex-col items-center gap-3">
                    <div class="flex size-10 items-center justify-center rounded-full bg-red-500/10">
                        <LucideIconCn Name="circle-alert" Size="20" Class="size-5 text-red-600 dark:text-red-400" />
                    </div>
                    <div class="text-center">
                        <p class="font-medium text-sm">Connection failed</p>
                        <p class="mt-0.5 text-muted-foreground text-xs">User rejected the request</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-2 h-7 text-xs" @onclick="HandleDisconnect">
                        Try again
                    </ButtonCn>
                </div>
            </div>
        }
        else
        {
            <div>
                @foreach (var wallet in _wallets)
                {
                    var w = wallet;
                    var isConnecting = _connectionState == ConnectionState.Connecting && _selected == w.Id;
                    var isLast = w.Id == _wallets[^1].Id;
                    <button type="button"
                            @onclick="@(() => HandleConnect(w.Id))"
                            disabled="@(_connectionState == ConnectionState.Connecting)"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50 disabled:opacity-50", isLast ? "" : "border-b")">
                        <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="wallet" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@w.Name</span>
                                @if (w.Status == WalletStatus.Popular)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Popular</BadgeCn>
                                }
                                @if (w.Status == WalletStatus.New)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">New</BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@w.Description</p>
                        </div>
                        @if (isConnecting)
                        {
                            <LucideIconCn Name="loader-2" Size="16" Class="size-4 shrink-0 animate-spin text-muted-foreground" />
                        }
                        else
                        {
                            <LucideIconCn Name="chevron-right" Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                        }
                    </button>
                }
            </div>
        }
    </div>
</section>

@code {
    private string? _selected = null;
    private ConnectionState _connectionState = ConnectionState.Idle;

    private enum WalletStatus { Available, Popular, New }
    private enum ConnectionState { Idle, Connecting, Connected, Error }

    private record WalletOption(string Id, string Name, string Description, WalletStatus Status);

    private static readonly WalletOption[] _wallets =
    [
        new("metamask",      "MetaMask",        "Browser extension & mobile",    WalletStatus.Popular),
        new("walletconnect", "WalletConnect",   "Scan with mobile wallet",       WalletStatus.Popular),
        new("coinbase",      "Coinbase Wallet", "Coinbase self-custody wallet",  WalletStatus.Available),
        new("phantom",       "Phantom",         "Multi-chain wallet",            WalletStatus.New),
        new("rabby",         "Rabby Wallet",    "Smooth multi-chain experience", WalletStatus.Available),
        new("trust",         "Trust Wallet",    "Binance official wallet",       WalletStatus.Available),
    ];

    private string GetWalletName(string id)
    {
        foreach (var w in _wallets)
        {
            if (w.Id == id) return w.Name;
        }
        return id;
    }

    private async Task HandleConnect(string id)
    {
        _selected = id;
        _connectionState = ConnectionState.Connecting;
        await Task.Delay(1500);
        _connectionState = ConnectionState.Connected;
    }

    private void HandleDisconnect()
    {
        _selected = null;
        _connectionState = ConnectionState.Idle;
    }
}
