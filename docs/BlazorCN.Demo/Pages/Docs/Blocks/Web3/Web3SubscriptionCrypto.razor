@* ============================================================
   Block: web3-subscription-crypto
   Title: Web3SubscriptionCrypto
   Description: A React and Next.js crypto subscription manager block built with shadcn/ui and Tailwind CSS for recurring plans, payment schedules, and cancellation controls.
   Source: original/blocks/web3/web3-subscription-crypto.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="refresh-cw" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Subscriptions</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_activeCount active
            </BadgeCn>
        </div>

        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Monthly Cost</p>
                <p class="mt-0.5 font-semibold tabular-nums">~$86.02</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Annual Cost</p>
                <p class="mt-0.5 font-semibold tabular-nums">~$1,232.24</p>
            </div>
        </div>

        <div>
            @for (int i = 0; i < _subscriptions.Length; i++)
            {
                var sub = _subscriptions[i];
                var isLast = i == _subscriptions.Length - 1;
                var isCancelled = _cancelledIds.Contains(sub.Id);
                var subId = sub.Id;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b", isCancelled ? "opacity-50" : "")">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", isCancelled ? "bg-muted-foreground/30" : "bg-emerald-500")"></span>
                            <span class="font-medium text-sm">@sub.Service</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @sub.Plan
                            </BadgeCn>
                        </div>
                        @if (isCancelled)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs text-muted-foreground">
                                Cancelled
                            </BadgeCn>
                        }
                        else
                        {
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs text-muted-foreground" OnClick="@(() => HandleCancel(subId))">
                                Cancel
                            </ButtonCn>
                        }
                    </div>
                    <div class="mt-1.5 flex items-center justify-between text-xs">
                        <span class="font-mono tabular-nums">@sub.Amount</span>
                        <span class="text-muted-foreground">
                            @(isCancelled ? "Cancelled" : $"Next: {sub.NextPayment}")
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Subscription(string Id, string Service, string Plan, string Amount, string Token, string NextPayment, string Status);

    private static readonly Subscription[] _subscriptions =
    [
        new("1", "Protocol Pro",  "Monthly", "50 USDC",   "USDC", "Apr 1, 2026",  "active"),
        new("2", "NFT Analytics", "Yearly",  "200 USDC",  "USDC", "Jan 15, 2027", "active"),
        new("3", "DeFi Alerts",   "Monthly", "0.01 ETH",  "ETH",  "Apr 5, 2026",  "active"),
        new("4", "DAO Toolkit",   "Monthly", "25 USDC",   "USDC", "Cancelled",    "cancelled"),
    ];

    private List<string> _cancelledIds = ["4"];

    private int _activeCount => _subscriptions.Length - _cancelledIds.Count;

    private void HandleCancel(string id)
    {
        if (!_cancelledIds.Contains(id))
            _cancelledIds.Add(id);
    }
}
