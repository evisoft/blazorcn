@* ============================================================
   Block: web3-wallet-balance
   Title: Web3WalletBalance
   Description: A React and Next.js wallet balance display block built with shadcn/ui Button and Tailwind CSS for showing token holdings.
   Source: original/blocks/web3/web3-wallet-balance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="wallet" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Wallet Balance</span>
            </div>
            <div class="flex items-center gap-2">
                <span class="font-mono text-muted-foreground text-xs">0x7a25...f3e8</span>
                <ButtonCn aria-label="Toggle balance visibility" Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="h-6 w-6 p-0"
                          OnClick="@(() => _hidden = !_hidden)">
                    @if (_hidden)
                    {
                        <LucideIconCn Name="eye-off" Size="14" Class="size-3.5" />
                    }
                    else
                    {
                        <LucideIconCn Name="eye" Size="14" Class="size-3.5" />
                    }
                </ButtonCn>
            </div>
        </div>

        @* Total balance *@
        <div class="border-b px-4 py-4">
            <p class="text-muted-foreground text-xs">Total Balance</p>
            <div class="mt-1 flex items-baseline gap-2">
                <span class="font-semibold text-2xl tabular-nums">
                    @(_hidden ? "••••••" : _totalValue)
                </span>
                <span class="@Cn.Merge("flex items-center gap-0.5 text-xs tabular-nums", _totalChange >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                    @if (_totalChange >= 0)
                    {
                        <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                    }
                    else
                    {
                        <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                    }
                    @(Math.Abs(_totalChange))%
                </span>
            </div>
        </div>

        @* Token list *@
        <div>
            @for (int i = 0; i < _tokens.Length; i++)
            {
                var token = _tokens[i];
                var isLast = i == _tokens.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted/50">
                        <span class="font-mono font-medium text-xs">@(token.Symbol.Length >= 2 ? token.Symbol.Substring(0, 2) : token.Symbol)</span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@token.Name</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @(_hidden ? "••••" : token.Balance) @token.Symbol
                        </p>
                    </div>
                    <div class="text-right">
                        <span class="font-medium text-sm tabular-nums">
                            @(_hidden ? "••••" : token.Value)
                        </span>
                        <p class="@Cn.Merge("mt-0.5 text-xs tabular-nums", token.Change >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                            @(token.Change >= 0 ? "+" : "")@(token.Change)%
                        </p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Token(string Symbol, string Name, string Balance, string Value, double Change);

    private static readonly Token[] _tokens =
    [
        new("ETH",  "Ethereum",  "4.2851",    "$15,426.36",  2.34),
        new("BTC",  "Bitcoin",   "0.1823",    "$12,108.42", -1.12),
        new("USDC", "USD Coin",  "5,230.00",  "$5,230.00",   0.01),
        new("ARB",  "Arbitrum",  "3,412.50",  "$4,081.13",   5.67),
        new("LINK", "Chainlink", "215.00",    "$3,225.00",  -0.45),
        new("UNI",  "Uniswap",   "180.25",    "$1,622.25",   3.21),
    ];

    private const string _totalValue = "$41,693.16";
    private const double _totalChange = 1.87;

    private bool _hidden = false;
}
