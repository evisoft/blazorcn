@* ============================================================
   Block: web3-mempool-viewer
   Title: Web3MempoolViewer
   Description: A React and Next.js blockchain mempool viewer built with shadcn/ui and Tailwind CSS showing pending transactions and gas prices.
   Source: original/blocks/web3/web3-mempool-viewer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layers" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Mempool</span>
            </div>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                    148,231 pending
                </BadgeCn>
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-muted-foreground text-xs">Live</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-[auto_auto_1fr_auto_auto_auto] items-center gap-x-3 border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">Hash</span>
            <span class="text-xs font-medium text-muted-foreground">Type</span>
            <span class="text-xs font-medium text-muted-foreground">From</span>
            <span class="text-xs font-medium text-muted-foreground text-right">Gas</span>
            <span class="text-xs font-medium text-muted-foreground text-right">Value</span>
            <span class="text-xs font-medium text-muted-foreground text-right">Age</span>
        </div>

        <div>
            @for (int i = 0; i < _pendingTxs.Length; i++)
            {
                var tx = _pendingTxs[i];
                var isLast = i == _pendingTxs.Length - 1;
                <div class="@Cn.Merge("grid grid-cols-[auto_auto_1fr_auto_auto_auto] items-center gap-x-3 px-4 py-2", isLast ? "" : "border-b")">
                    <span class="font-mono text-xs text-blue-600 dark:text-blue-400">@tx.Hash</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@tx.Type</BadgeCn>
                    <span class="font-mono text-muted-foreground text-xs">@tx.From</span>
                    <span class="text-right font-mono text-xs tabular-nums">@tx.GasPrice</span>
                    <span class="text-right font-mono text-xs tabular-nums">@tx.Value</span>
                    <span class="text-right text-muted-foreground text-xs tabular-nums">@tx.Age</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PendingTx(string Hash, string Type, string From, string GasPrice, string Value, string Age);

    private static readonly PendingTx[] _pendingTxs =
    [
        new("0x1a2b...c3d4", "Swap",     "0x7a25...f3e8", "32 gwei", "1.5 ETH",      "2s"),
        new("0x5e6f...7g8h", "Transfer", "0x3b91...a2c7", "28 gwei", "10,000 USDC",  "5s"),
        new("0x9i0j...k1l2", "Approve",  "0x9e12...d4b6", "25 gwei", "N/A",          "8s"),
        new("0x3m4n...o5p6", "Mint",     "0x4f8c...e1a9", "35 gwei", "0.08 ETH",     "1s"),
        new("0x7q8r...s9t0", "Swap",     "0x6d03...b7f2", "22 gwei", "5.0 ETH",      "12s"),
        new("0xab12...cd34", "Contract", "0x8c54...f1b3", "30 gwei", "0 ETH",        "3s"),
        new("0xef56...gh78", "Transfer", "0x2d41...e9a7", "18 gwei", "0.5 ETH",      "20s"),
    ];
}
