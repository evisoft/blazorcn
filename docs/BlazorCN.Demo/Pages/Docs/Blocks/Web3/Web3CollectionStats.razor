@* ============================================================
   Block: web3-collection-stats
   Title: Web3CollectionStats
   Description: A React and Next.js NFT collection stats block built with shadcn/ui and Tailwind CSS for floor price and volume.
   Source: original/blocks/web3/web3-collection-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Cosmic Apes</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                10,000 items
            </BadgeCn>
        </div>

        <div class="grid grid-cols-2 border-b">
            @for (int i = 0; i < _metrics.Length; i++)
            {
                var m = _metrics[i];
                var idx = i;
                <div class="@Cn.Merge("px-4 py-3", idx < 2 ? "border-b" : "", idx % 2 == 0 ? "border-r" : "")">
                    <p class="text-muted-foreground text-xs">@m.Label</p>
                    <div class="mt-0.5 flex items-center gap-2">
                        <span class="font-semibold text-lg tabular-nums">@m.Value</span>
                        <span class="@Cn.Merge("flex items-center gap-0.5 text-xs tabular-nums", m.Positive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                            @if (m.Positive)
                            {
                                <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideIconCn Name="trending-down" Size="12" Class="size-3" />
                            }
                            @m.Change
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Listing Distribution</span>
            <div class="mt-2 space-y-2">
                @foreach (var l in _listings)
                {
                    <div>
                        <div class="flex items-center justify-between text-xs mb-1">
                            <span class="font-mono tabular-nums">@l.Range</span>
                            <span class="text-muted-foreground tabular-nums">@l.Count listed</span>
                        </div>
                        <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-blue-500/60" style="@($"width:{l.Percentage}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record CollectionMetric(string Label, string Value, string Change, bool Positive);
    private record ListingBucket(string Range, int Count, int Percentage);

    private static readonly CollectionMetric[] _metrics =
    [
        new("Floor Price",      "2.4 ETH",       "+12.5%", true),
        new("24h Volume",       "148.2 ETH",     "+8.3%",  true),
        new("Unique Holders",   "3,412",         "-2.1%",  false),
        new("Listed",          "842 / 10,000",  "+5.6%",  true),
    ];

    private static readonly ListingBucket[] _listings =
    [
        new("2.4 - 3.0 ETH",   312, 37),
        new("3.0 - 5.0 ETH",   248, 29),
        new("5.0 - 10.0 ETH",  168, 20),
        new("10.0+ ETH",       114, 14),
    ];
}
