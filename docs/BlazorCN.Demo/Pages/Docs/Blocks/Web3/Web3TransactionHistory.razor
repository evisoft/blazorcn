@* ============================================================
   Block: web3-transaction-history
   Title: Web3TransactionHistory
   Description: A React and Next.js transaction history block built with shadcn/ui and Tailwind CSS featuring status indicators and expandable details.
   Source: original/blocks/web3/web3-transaction-history.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Transaction History</span>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Confirmed
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    Pending
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    Failed
                </span>
            </div>
        </div>

        <div>
            @for (int i = 0; i < _transactions.Length; i++)
            {
                var tx = _transactions[i];
                var isLast = i == _transactions.Length - 1;
                var isExpanded = _expanded == tx.Id;
                var iconName = GetIconName(tx.Type);
                var statusDot = GetStatusColor(tx.Status);
                var amountColor = tx.Type == "receive" ? "text-emerald-600 dark:text-emerald-400" : "";
                var chevronClass = isExpanded ? "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 rotate-90" : "size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200";
                var txId = tx.Id;
                <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = (_expanded == txId ? null : txId))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", statusDot)"></span>
                        <div class="flex size-7 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="@iconName" Size="14" Class="size-3.5 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm capitalize">@tx.Type</span>
                                <span class="font-mono text-muted-foreground text-xs">@tx.Token</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@tx.Timestamp</p>
                        </div>
                        <div class="text-right mr-2">
                            <span class="@Cn.Merge("font-medium text-sm tabular-nums", amountColor)">@tx.Amount</span>
                            <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">@tx.UsdValue</p>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@chevronClass" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-14">
                            <div class="rounded-md bg-muted/50 p-3 space-y-1.5">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Status</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs capitalize">@tx.Status</BadgeCn>
                                </div>
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">To/From</span>
                                    <span class="font-mono">@tx.Address</span>
                                </div>
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Tx Hash</span>
                                    <span class="font-mono">@tx.Hash</span>
                                </div>
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Gas Fee</span>
                                    <span class="tabular-nums">@tx.Gas</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Transaction(
        string Id,
        string Type,
        string Status,
        string Token,
        string Amount,
        string UsdValue,
        string Address,
        string Hash,
        string Gas,
        string Timestamp
    );

    private static readonly Transaction[] _transactions =
    [
        new("1", "send",    "confirmed", "ETH",         "-0.5000",    "$1,800.63", "0x3f4a...8b12", "0xabc1...def4", "$3.42", "2 min ago"),
        new("2", "receive", "confirmed", "USDC",        "+2,500.00",  "$2,500.00", "0x9e2c...4d71", "0xbcd2...ef85", "$1.15", "15 min ago"),
        new("3", "swap",    "pending",   "ETH → ARB", "0.2500",  "$900.31",   "Uniswap V3",    "0xcde3...f096", "$5.67", "23 min ago"),
        new("4", "send",    "failed",    "LINK",        "-50.00",     "$750.00",   "0x1a7b...c9e3", "0xdef4...a1b7", "$2.18", "1 hour ago"),
        new("5", "receive", "confirmed", "ETH",         "+1.2500",    "$4,501.56", "0x5c8d...2f94", "0xefa5...b2c8", "$2.91", "3 hours ago"),
        new("6", "swap",    "confirmed", "USDC → DAI", "1,000.00", "$1,000.00", "Curve Finance", "0xfab6...c3d9", "$1.85", "5 hours ago"),
    ];

    private string? _expanded = null;

    private static string GetIconName(string type) => type switch
    {
        "send"    => "arrow-up-right",
        "receive" => "arrow-down-left",
        "swap"    => "repeat",
        _         => "arrow-right-left",
    };

    private static string GetStatusColor(string status) => status switch
    {
        "confirmed" => "bg-emerald-500",
        "pending"   => "bg-amber-500",
        "failed"    => "bg-red-500",
        _           => "",
    };
}
