@* ============================================================
   Block: web3-address-book
   Title: Web3AddressBook
   Description: React wallet address book block for Next.js with labels, network tags, and copy functionality using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/web3-address-book.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="book-user" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Address Book</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_addresses.Length
                </BadgeCn>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                Add
            </ButtonCn>
        </div>

        <div class="border-b px-4 py-2">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground" />
                <InputCn
                    @bind-Value="_search"
                    Placeholder="Search by label or address..."
                    Class="h-7 border-0 bg-transparent px-0 text-sm shadow-none focus-visible:ring-0" />
            </div>
        </div>

        <div>
            @{
                var filtered = _addresses.Where(a =>
                    a.Label.ToLower().Contains(_search.ToLower()) ||
                    a.Address.Contains(_search)).ToArray();
            }
            @foreach (var addr in filtered)
            {
                var addrId = addr.Id;
                var isLast = addrId == filtered[filtered.Length - 1].Id;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@addr.Label</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @addr.Network
                            </BadgeCn>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2">
                            <span class="font-mono text-muted-foreground text-xs">@addr.Address</span>
                            <span class="text-muted-foreground text-xs">@addr.LastUsed</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-1">
                        <ButtonCn
                            Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Sm"
                            Class="h-6 w-6 p-0"
                            OnClick="@(() => HandleCopy(addrId))">
                            @if (_copiedId == addrId)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                            }
                            else
                            {
                                <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            }
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 w-6 p-0">
                            <LucideIconCn Name="trash" Size="12" Class="size-3 text-muted-foreground" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record SavedAddress(string Id, string Label, string Address, string Network, string LastUsed);

    private string _search = "";
    private string? _copiedId = null;

    private static readonly SavedAddress[] _addresses =
    [
        new("1", "Hardware Wallet", "0x7a25...f3e8", "Ethereum", "2 hours ago"),
        new("2", "Coinbase", "0x3b91...a2c7", "Ethereum", "1 day ago"),
        new("3", "Binance Hot", "0x9e12...d4b6", "BSC", "3 days ago"),
        new("4", "Arbitrum Bridge", "0x4f8c...e1a9", "Arbitrum", "1 week ago"),
        new("5", "Team Treasury", "0x6d03...b7f2", "Ethereum", "2 weeks ago"),
    ];

    private async Task HandleCopy(string id)
    {
        _copiedId = id;
        await Task.Delay(1500);
        _copiedId = null;
    }
}
