@* ============================================================
   Block: web3-leaderboard
   Title: Web3Leaderboard
   Description: A React and Next.js community leaderboard block built with shadcn/ui and Tailwind CSS. Ranks users by contribution points and trading volume.
   Source: original/blocks/web3/web3-leaderboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trophy" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Leaderboard</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Season 3
            </BadgeCn>
        </div>

        <div>
            @for (int i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var isLast = i == _entries.Length - 1;
                var rankClass = _rankStyles.TryGetValue(entry.Rank, out var rc) ? rc : "text-muted-foreground";
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("w-6 text-center font-mono text-sm tabular-nums", rankClass)">
                        @entry.Rank
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@entry.Ens</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @entry.Badge
                            </BadgeCn>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 shrink-0">
                        <span class="@Cn.Merge("font-mono text-xs tabular-nums", entry.Positive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                            @(entry.Positive ? "+" : "")@entry.Change
                        </span>
                        <span class="w-16 text-right font-mono text-sm tabular-nums">@entry.Score</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record LeaderboardEntry(int Rank, string Address, string Ens, string Score, string Change, bool Positive, string Badge);

    private static readonly LeaderboardEntry[] _entries =
    [
        new(1, "0x7a25...f3e8", "alice.eth", "12,450", "+340",  true,  "Champion"),
        new(2, "0x3b91...a2c7", "bob.eth",   "11,280", "+125",  true,  "Elite"),
        new(3, "0x9e12...d4b6", "carol.eth", "9,850",  "-80",   false, "Elite"),
        new(4, "0x4f8c...e1a9", "dan.eth",   "8,420",  "+210",  true,  "Pro"),
        new(5, "0x6d03...b7f2", "eve.eth",   "7,890",  "+95",   true,  "Pro"),
        new(6, "0x8c54...f1b3", "frank.eth", "6,540",  "-150",  false, "Pro"),
        new(7, "0x2d41...e9a7", "grace.eth", "5,230",  "+420",  true,  "Rising"),
        new(8, "0xa1b2...c3d4", "henry.eth", "4,870",  "+55",   true,  "Rising"),
    ];

    private static readonly Dictionary<int, string> _rankStyles = new()
    {
        { 1, "text-amber-500" },
        { 2, "text-zinc-400" },
        { 3, "text-amber-700 dark:text-amber-600" },
    };
}
