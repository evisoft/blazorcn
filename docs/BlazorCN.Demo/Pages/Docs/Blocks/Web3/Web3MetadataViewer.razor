@* ============================================================
   Block: web3-metadata-viewer
   Title: Web3MetadataViewer
   Description: A React and Next.js NFT metadata viewer built with shadcn/ui and Tailwind CSS showing attributes, JSON, and IPFS data.
   Source: original/blocks/web3/web3-metadata-viewer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="code" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Metadata Viewer</span>
            </div>
            <div class="flex items-center gap-1">
                <ButtonCn Variant="@(_view == "formatted" ? ButtonVariant.Default : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-6 px-2 text-xs"
                          @onclick="@(() => _view = "formatted")">
                    Formatted
                </ButtonCn>
                <ButtonCn Variant="@(_view == "raw" ? ButtonVariant.Default : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-6 px-2 text-xs"
                          @onclick="@(() => _view = "raw")">
                    Raw JSON
                </ButtonCn>
            </div>
        </div>

        @if (_view == "formatted")
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Name</span>
                    <span class="font-medium">@_metadata.Name</span>
                </div>
                <div class="mt-1.5 flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Token ID</span>
                    <span class="font-mono tabular-nums">4217</span>
                </div>
                <div class="mt-1.5 flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Standard</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        ERC-721
                    </BadgeCn>
                </div>
            </div>

            <div class="border-b px-4 py-3">
                <span class="text-xs font-medium text-muted-foreground">Description</span>
                <p class="mt-1 text-xs">@_metadata.Description</p>
            </div>

            <div class="border-b px-4 py-3">
                <span class="text-xs font-medium text-muted-foreground">URIs</span>
                <div class="mt-1.5 space-y-1.5">
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Image</span>
                        <span class="font-mono text-xs truncate ml-4">@_metadata.Image</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">External URL</span>
                        <span class="font-mono text-xs truncate ml-4">@_metadata.ExternalUrl</span>
                    </div>
                </div>
            </div>

            <div>
                <div class="border-b px-4 py-2">
                    <span class="text-xs font-medium text-muted-foreground">Attributes</span>
                </div>
                @for (var i = 0; i < _attributes.Length; i++)
                {
                    var attr = _attributes[i];
                    var isLast = i == _attributes.Length - 1;
                    <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b")">
                        <span class="text-muted-foreground text-xs">@attr.TraitType</span>
                        <span class="text-xs">@attr.Value</span>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="px-4 py-3">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-medium text-muted-foreground">JSON</span>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="h-6 gap-1 px-2 text-xs"
                              @onclick="HandleCopy">
                        @if (_copied)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                            <span>Copied</span>
                        }
                        else
                        {
                            <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            <span>Copy</span>
                        }
                    </ButtonCn>
                </div>
                <div class="rounded-md bg-zinc-950 p-3">
                    <pre class="font-mono text-xs text-zinc-300 overflow-x-auto">@_rawJson</pre>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private string _view = "formatted";
    private bool _copied = false;

    private record NftMetadata(string Name, string Description, string Image, string ExternalUrl);
    private record NftAttribute(string TraitType, string Value);

    private static readonly NftMetadata _metadata = new(
        Name: "Cosmic Ape #4217",
        Description: "A unique Cosmic Ape from the collection of 10,000 randomly generated apes exploring the universe.",
        Image: "ipfs://QmXyZ...abc123/4217.png",
        ExternalUrl: "https://cosmicapes.io/4217"
    );

    private static readonly NftAttribute[] _attributes =
    [
        new("Background", "Cosmic Purple"),
        new("Body",       "Gold Fur"),
        new("Eyes",       "Laser Red"),
        new("Head",       "Crown"),
        new("Mouth",      "Diamond Grill"),
        new("Clothing",   "Space Suit"),
    ];

    private static readonly string _rawJson =
        "{\n" +
        "  \"name\": \"Cosmic Ape #4217\",\n" +
        "  \"description\": \"A unique Cosmic Ape from the collection of 10,000 randomly generated apes exploring the universe.\",\n" +
        "  \"image\": \"ipfs://QmXyZ...abc123/4217.png\",\n" +
        "  \"external_url\": \"https://cosmicapes.io/4217\",\n" +
        "  \"attributes\": [\n" +
        "    { \"trait_type\": \"Background\", \"value\": \"Cosmic Purple\" },\n" +
        "    { \"trait_type\": \"Body\", \"value\": \"Gold Fur\" },\n" +
        "    { \"trait_type\": \"Eyes\", \"value\": \"Laser Red\" },\n" +
        "    { \"trait_type\": \"Head\", \"value\": \"Crown\" },\n" +
        "    { \"trait_type\": \"Mouth\", \"value\": \"Diamond Grill\" },\n" +
        "    { \"trait_type\": \"Clothing\", \"value\": \"Space Suit\" }\n" +
        "  ]\n" +
        "}";

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(1500);
        _copied = false;
    }
}
