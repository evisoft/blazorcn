@* ============================================================
   Block: web3-auction-house
   Title: Web3AuctionHouse
   Description: React NFT auction house block for Next.js with live bidding, countdown timer, and bid history using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/web3-auction-house.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="gavel" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Auction</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                <span class="mr-1.5 inline-block size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                Live
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-4">
            <p class="font-medium text-sm">Cosmic Ape #77</p>
            <p class="mt-0.5 text-muted-foreground text-xs">Cosmic Apes Collection</p>
        </div>

        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Current Bid</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums">8.5 ETH</p>
                <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">~$30,610</p>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center gap-1 mb-1">
                    <LucideIconCn Name="timer" Size="12" Class="size-3 text-muted-foreground" />
                    <p class="text-muted-foreground text-xs">Ends in</p>
                </div>
                <p class="font-semibold text-lg tabular-nums">02:14:37</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Reserve met</p>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Place Bid (min 9.0 ETH)</span>
            <div class="mt-1.5 flex items-center gap-2">
                <InputCn @bind-Value="_bidAmount" Class="h-9 font-mono text-sm tabular-nums" Placeholder="9.0" />
                <span class="shrink-0 text-muted-foreground text-xs">ETH</span>
                <ButtonCn Size="ButtonSize.Sm" Class="h-9 shrink-0 text-xs">
                    Place Bid
                </ButtonCn>
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Bid History</span>
            </div>
            @for (int i = 0; i < _bidHistory.Length; i++)
            {
                var bid = _bidHistory[i];
                var isLast = i == _bidHistory.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b")">
                    <div>
                        <span class="font-mono text-xs">@bid.Bidder</span>
                        @if (i == 0)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-2 font-normal text-xs">
                                Leading
                            </BadgeCn>
                        }
                    </div>
                    <div class="text-right">
                        <span class="font-mono text-xs tabular-nums">@bid.Amount</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@bid.Time</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _bidAmount = "";

    private record BidEntry(string Bidder, string Amount, string Time);

    private static readonly BidEntry[] _bidHistory =
    [
        new("0x7a25...f3e8", "8.5 ETH", "5 min ago"),
        new("0x3b91...a2c7", "7.2 ETH", "22 min ago"),
        new("0x9e12...d4b6", "6.0 ETH", "1 hour ago"),
        new("0x4f8c...e1a9", "5.0 ETH", "3 hours ago"),
    ];
}
