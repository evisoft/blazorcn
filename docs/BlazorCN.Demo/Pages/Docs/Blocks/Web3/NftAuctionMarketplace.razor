@* ============================================================
   Block: nft-auction-marketplace
   Title: NftAuctionMarketplace
   Description: React NFT auction marketplace block for Next.js with live bid tracking, countdown timers, creator profiles, and animated bid placement using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/nft-auction-marketplace.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="gavel" Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <h2 class="text-sm font-medium">Live Auctions</h2>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_auctions.Length active · @_auctions.Sum(a => a.BidCount) total bids
                    </p>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                View All
            </ButtonCn>
        </div>

        @* Auction grid *@
        <div class="grid grid-cols-1 gap-px bg-border sm:grid-cols-2">
            @foreach (var auction in _auctions)
            {
                var auctionId = auction.Id;
                <div class="bg-card">
                    @* Image *@
                    <div class="relative aspect-square overflow-hidden">
                        <img
                            src="@auction.Image"
                            alt="@auction.Title"
                            class="size-full object-cover transition-transform duration-300 hover:scale-105" />
                        <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/60 to-transparent p-3">
                            <div class="flex items-end justify-between">
                                <div>
                                    <p class="text-xs text-white/70">@auction.Collection</p>
                                    <p class="text-sm font-medium text-white">@auction.Title</p>
                                </div>
                                <button aria-label="Toggle favorite for @auction.Title"
                                    type="button"
                                    @onclick="@(() => ToggleFavorite(auctionId))"
                                    class="flex size-7 items-center justify-center rounded-full bg-white/20 backdrop-blur-sm transition-colors hover:bg-white/30">
                                    <LucideIconCn Name="heart" Size="14" Class="@Cn.Merge("size-3.5", _favorites.Contains(auctionId) ? "fill-red-400 text-red-400" : "text-white")" />
                                </button>
                            </div>
                        </div>
                        @* Time badge *@
                        <div class="absolute top-3 left-3">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 bg-black/50 text-[10px] text-white backdrop-blur-sm">
                                <LucideIconCn Name="timer" Size="12" Class="size-3" />
                                @auction.TimeLeft
                            </BadgeCn>
                        </div>
                    </div>

                    @* Details *@
                    <div class="px-3 py-2.5">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-1.5">
                                <AvatarCn Class="size-5">
                                    <AvatarImageCn Src="@auction.Creator.Avatar" Alt="@auction.Creator.Name" />
                                    <AvatarFallbackCn Class="text-[8px]">
                                        @auction.Creator.Name.Substring(0, Math.Min(2, auction.Creator.Name.Length)).ToUpper()
                                    </AvatarFallbackCn>
                                </AvatarCn>
                                <span class="text-xs text-muted-foreground">@auction.Creator.Name</span>
                                @if (auction.Creator.Verified)
                                {
                                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                                }
                            </div>
                            <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                <LucideIconCn Name="users" Size="12" Class="size-3" />
                                <span class="tabular-nums">@auction.BidCount</span>
                            </span>
                        </div>
                        <div class="mt-2 flex items-center justify-between">
                            <div>
                                <p class="text-[10px] text-muted-foreground">Current bid</p>
                                <p class="text-sm font-semibold tabular-nums">
                                    @auction.CurrentBid @auction.Currency
                                </p>
                            </div>
                            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Place Bid</ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CreatorInfo(string Name, string Avatar, bool Verified);
    private record AuctionItem(string Id, string Title, string Collection, string Image, CreatorInfo Creator, string CurrentBid, int BidCount, string TimeLeft, string Currency);

    private readonly HashSet<string> _favorites = [];

    private static readonly AuctionItem[] _auctions =
    [
        new("1", "Celestial Drift #412", "Celestial Drifters",
            "https://images.unsplash.com/photo-1634986666676-ec8fd927c23d?w=600&h=600&fit=crop",
            new CreatorInfo("stellarcraft.eth", "", true),
            "2.45", 18, "2h 14m", "ETH"),
        new("2", "Neon Specter #087", "Neon Specters",
            "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=600&h=600&fit=crop",
            new CreatorInfo("neonlabs.eth", "", true),
            "1.12", 9, "5h 42m", "ETH"),
        new("3", "Void Walker #204", "Void Walkers",
            "https://images.unsplash.com/photo-1635322966219-b75ed372eb01?w=600&h=600&fit=crop",
            new CreatorInfo("voidart.eth", "", false),
            "0.88", 5, "11h 08m", "ETH"),
        new("4", "Quantum Bloom #031", "Quantum Blooms",
            "https://images.unsplash.com/photo-1620641788421-7a1c342ea42e?w=600&h=600&fit=crop",
            new CreatorInfo("quantumai.eth", "", true),
            "3.20", 24, "47m", "ETH"),
    ];

    private void ToggleFavorite(string id)
    {
        if (_favorites.Contains(id))
            _favorites.Remove(id);
        else
            _favorites.Add(id);
    }
}
