@* ============================================================
   Block: web3-nft-detail
   Title: Web3NftDetail
   Description: A React and Next.js NFT detail page built with shadcn/ui Button, Badge and Tailwind CSS for traits and history
   Source: original/blocks/web3/web3-nft-detail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* NFT Image *@
        <div class="aspect-square overflow-hidden border-b">
            <img
                src="https://picsum.photos/seed/nftdetail/800/800"
                alt="Cosmic Ape #4217"
                class="h-full w-full object-cover" />
        </div>

        @* Title / actions row *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-muted-foreground text-xs">Cosmic Apes</p>
                    <h2 class="mt-0.5 font-medium text-sm">Cosmic Ape #4217</h2>
                </div>
                <div class="flex items-center gap-1">
                    <button
                        type="button"
                        @onclick="@(() => _liked = !_liked)"
                        class="inline-flex h-7 w-7 items-center justify-center rounded-md p-0 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none">
                        <LucideIconCn Name="heart" Size="14" Class="@Cn.Merge("size-3.5", _liked ? "fill-red-500 text-red-500" : "")" />
                    </button>
                    <button
                        type="button"
                        class="inline-flex h-7 w-7 items-center justify-center rounded-md p-0 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none">
                        <LucideIconCn Name="share" Size="14" Class="size-3.5" />
                    </button>
                    <button
                        type="button"
                        class="inline-flex h-7 w-7 items-center justify-center rounded-md p-0 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground focus-visible:outline-none">
                        <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
                    </button>
                </div>
            </div>
            <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                <span>
                    Owner: <span class="font-mono">0x7a25...f3e8</span>
                </span>
                <span>·</span>
                <span>Rank #142 / 10,000</span>
            </div>
        </div>

        @* Price / buy row *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-muted-foreground text-xs">Current Price</p>
                    <p class="mt-0.5 font-semibold text-xl tabular-nums">12.5 ETH</p>
                    <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">$45,015.63</p>
                </div>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Make Offer
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">
                        Buy Now
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Traits *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 font-medium text-xs text-muted-foreground">Traits</p>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
                @foreach (var trait in _traits)
                {
                    <div class="rounded-md bg-muted/50 p-2">
                        <p class="text-muted-foreground text-xs">@trait.Type</p>
                        <p class="mt-0.5 font-medium text-xs">@trait.Value</p>
                        <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">
                            @trait.Rarity have this
                        </p>
                    </div>
                }
            </div>
        </div>

        @* Activity accordion *@
        <div>
            <button
                type="button"
                @onclick="@(() => _showHistory = !_showHistory)"
                class="flex w-full items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <span class="font-medium text-xs text-muted-foreground">Activity</span>
                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _showHistory ? "rotate-90" : "")" />
            </button>
            @if (_showHistory)
            {
                <div class="border-t">
                    @foreach (var (entry, index) in _priceHistory.Select((e, i) => (e, i)))
                    {
                        var isLast = index == _priceHistory.Length - 1;
                        <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b")">
                            <div>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @entry.Event
                                </BadgeCn>
                                <p class="mt-1 font-mono text-muted-foreground text-xs">@entry.From</p>
                            </div>
                            <div class="text-right">
                                <span class="font-mono text-sm tabular-nums">@entry.Price</span>
                                <p class="mt-0.5 text-muted-foreground text-xs">@entry.Time</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record TraitItem(string Type, string Value, string Rarity);
    private record HistoryEntry(string Event, string Price, string From, string Time);

    private bool _liked = false;
    private bool _showHistory = false;

    private static readonly TraitItem[] _traits =
    [
        new("Background", "Midnight Blue", "8%"),
        new("Body", "Gold Metallic", "3%"),
        new("Eyes", "Laser Red", "2%"),
        new("Head", "Crown", "1%"),
        new("Mouth", "Diamond Grill", "4%"),
        new("Clothing", "Space Suit", "6%"),
    ];

    private static readonly HistoryEntry[] _priceHistory =
    [
        new("Listed", "12.5 ETH", "0x7a25...f3e8", "2 hours ago"),
        new("Transfer", "—", "0x3c4d...a1b2", "1 day ago"),
        new("Sale", "10.2 ETH", "0x9e8f...c3d4", "3 days ago"),
        new("Offer", "9.8 ETH", "0x5a6b...e5f6", "5 days ago"),
    ];
}
