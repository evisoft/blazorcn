@* ============================================================
   Block: nft-collection-gallery
   Title: NftCollectionGallery
   Description: React NFT collection gallery block for Next.js with pixel art cards, owner profiles, and trader roles using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/nft-collection-gallery.tsx
   ============================================================ *@

<section class="container mx-auto py-16">
    <CardCn Class="border shadow-sm">
        <CardHeaderCn Class="p-6">
            <AvatarCn Class="h-12 w-12">
                <AvatarImageCn Alt="pixel art collection" Src="https://v3.material-tailwind.com/pixel-art-1.svg" />
                <AvatarFallbackCn>PA</AvatarFallbackCn>
            </AvatarCn>
            <h1 class="mt-4 mb-1 text-2xl font-bold">Pixelated Art</h1>
            <p class="text-muted-foreground max-w-2xl text-lg">
                These NFTs capture the essence of imagination and innovation, offering a glimpse into
                the boundless potential of the digital world.
            </p>
        </CardHeaderCn>
        <CardContentCn Class="grid grid-cols-1 gap-6 p-6 sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var nft in _data)
            {
                <CardCn Class="py-4">
                    <CardHeaderCn Class="gap-0 px-4">
                        <img alt="@nft.Name"
                             class="h-64 w-full rounded-md object-cover object-center"
                             height="400"
                             src="@nft.Img"
                             width="400" />
                    </CardHeaderCn>
                    <CardContentCn Class="px-4">
                        <p class="text-muted-foreground mb-1 text-sm">Pixelated Art</p>
                        <h3 class="text-lg font-semibold">Picture #@nft.TokenId</h3>
                        <div class="mt-4 flex items-center justify-between">
                            <div class="flex items-center gap-4">
                                <AvatarCn Class="h-6 w-6">
                                    <AvatarImageCn Alt="@nft.Name" Src="@nft.ProfileImg" />
                                    <AvatarFallbackCn>@nft.Name[0]</AvatarFallbackCn>
                                </AvatarCn>
                                <p class="text-muted-foreground text-sm">@nft.Name</p>
                            </div>
                            <p class="text-primary text-sm capitalize">@nft.Profession</p>
                        </div>
                    </CardContentCn>
                </CardCn>
            }
        </CardContentCn>
    </CardCn>
</section>

@code {
    private record NftItem(string Img, string Name, string TokenId, string Profession, string ProfileImg);

    private static readonly NftItem[] _data =
    [
        new(
            "https://v3.material-tailwind.com/pixel-art-1.svg",
            "yqaw...09v",
            "475",
            "trader",
            "https://images.unsplash.com/photo-1623853434105-8e7a72898180?auto=format&fit=crop&q=80&w=400&h=400"
        ),
        new(
            "https://v3.material-tailwind.com/pixel-art-2.svg",
            "yqaw...09v",
            "476",
            "owner",
            "https://images.unsplash.com/photo-1716662318479-a9c0f1cd1a0e?auto=format&fit=crop&q=80&w=400&h=400"
        ),
        new(
            "https://v3.material-tailwind.com/pixel-art-3.svg",
            "yqaw...09v",
            "477",
            "trader",
            "https://images.unsplash.com/photo-1716662318479-a9c0f1cd1a0e?auto=format&fit=crop&q=80&w=400&h=400"
        ),
    ];
}
