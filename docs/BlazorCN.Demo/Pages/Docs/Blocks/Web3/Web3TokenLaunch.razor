@* ============================================================
   Block: web3-token-launch
   Title: Web3TokenLaunch
   Description: A React and Next.js token launch block built with shadcn/ui and Tailwind CSS featuring tokenomics, distribution, and milestones.
   Source: original/blocks/web3/web3-token-launch.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="coins" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">PROTO Token Launch</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                ERC-20
            </BadgeCn>
        </div>

        @* Token Metrics *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Token Metrics</span>
            <div class="mt-2 grid grid-cols-2 gap-y-2">
                @foreach (var m in _metrics)
                {
                    <div class="flex items-center justify-between text-xs pr-4">
                        <span class="text-muted-foreground">@m.Label</span>
                        <span class="font-mono tabular-nums">@m.Value</span>
                    </div>
                }
            </div>
        </div>

        @* Distribution *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Distribution</span>
            <div class="mt-2 flex h-2 overflow-hidden rounded-full">
                @foreach (var d in _distribution)
                {
                    <div class="@d.Color" style="@($"width:{d.Percentage}%")"></div>
                }
            </div>
            <div class="mt-2 space-y-1.5">
                @foreach (var d in _distribution)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="flex items-center gap-1.5">
                            <span class="@Cn.Merge("size-1.5 rounded-full", d.Color)"></span>
                            @d.Category
                        </span>
                        <span class="tabular-nums">@d.Percentage%</span>
                    </div>
                }
            </div>
        </div>

        @* Timeline *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Timeline</span>
            <div class="mt-2 space-y-2">
                @foreach (var m in _milestones)
                {
                    <div class="flex items-center gap-3 text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", m.Status == MilestoneStatus.Completed ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                        <span class="w-20 shrink-0 text-muted-foreground">@m.Date</span>
                        <span class="@(m.Status == MilestoneStatus.Completed ? "" : "text-muted-foreground")">@m.Event</span>
                    </div>
                }
            </div>
        </div>

        @* Footer buttons *@
        <div class="px-4 py-3 flex items-center gap-2">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                Whitepaper
                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                Audit Report
                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                Contract
                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TokenMetric(string Label, string Value);
    private record DistItem(string Category, int Percentage, string Color);
    private record Milestone(string Date, string Event, MilestoneStatus Status);

    private enum MilestoneStatus { Completed, Upcoming }

    private static readonly TokenMetric[] _metrics =
    [
        new("Token",                 "PROTO"),
        new("Network",               "Ethereum"),
        new("Total Supply",          "1,000,000,000"),
        new("Initial Price",         "$0.085"),
        new("Initial Market Cap",    "$8,500,000"),
        new("FDV",                   "$85,000,000"),
    ];

    private static readonly DistItem[] _distribution =
    [
        new("Community & Airdrops", 30, "bg-blue-500"),
        new("Team & Advisors",      18, "bg-purple-500"),
        new("Treasury",             20, "bg-amber-500"),
        new("Liquidity",            15, "bg-emerald-500"),
        new("Investors",            12, "bg-cyan-500"),
        new("Ecosystem Grants",      5, "bg-rose-500"),
    ];

    private static readonly Milestone[] _milestones =
    [
        new("Jan 2026", "Private sale",     MilestoneStatus.Completed),
        new("Feb 2026", "Public sale",      MilestoneStatus.Completed),
        new("Mar 2026", "TGE & DEX listing",MilestoneStatus.Upcoming),
        new("Apr 2026", "CEX listing",      MilestoneStatus.Upcoming),
    ];
}
