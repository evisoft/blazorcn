@* ============================================================
   Block: web3-lending-borrow
   Title: Web3LendingBorrow
   Description: A React and Next.js DeFi lending and borrowing block built with shadcn/ui and Tailwind CSS. Features supply/borrow markets and health factor.
   Source: original/blocks/web3/web3-lending-borrow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="landmark" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Lending &amp; Borrowing</span>
            </div>
        </div>

        <div class="grid grid-cols-4 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Supplied</p>
                <p class="mt-0.5 font-semibold tabular-nums">@_totalSupplied</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Borrowed</p>
                <p class="mt-0.5 font-semibold tabular-nums">@_totalBorrowed</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Net APY</p>
                <p class="mt-0.5 font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">@_netApy</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Health</p>
                <p class="mt-0.5 font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">@_healthFactor</p>
            </div>
        </div>

        <div class="grid grid-cols-2 border-b">
            <button type="button" @onclick="@(() => _tab = "supply")"
                class="@Cn.Merge("py-2.5 text-center text-sm transition-colors", _tab == "supply" ? "bg-muted/30 font-medium" : "text-muted-foreground hover:bg-muted/50")">
                Supply Markets
            </button>
            <button type="button" @onclick="@(() => _tab = "borrow")"
                class="@Cn.Merge("border-l py-2.5 text-center text-sm transition-colors", _tab == "borrow" ? "bg-muted/30 font-medium" : "text-muted-foreground hover:bg-muted/50")">
                Borrow Markets
            </button>
        </div>

        <div>
            @foreach (var mkt in _markets)
            {
                var market = mkt;
                var isLast = market == _markets[_markets.Length - 1];
                var apy = _tab == "supply" ? market.SupplyApy : market.BorrowApy;
                var position = _tab == "supply" ? market.Supplied : market.Borrowed;
                var hasPosition = position != "$0";
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@market.Token</span>
                            @if (hasPosition)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                                    @position
                                </BadgeCn>
                            }
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @(_tab == "supply" ? "Supply" : "Borrow") APY:
                            <span class="tabular-nums text-emerald-600 dark:text-emerald-400">@apy</span>
                        </p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        @(_tab == "supply"
                            ? (hasPosition ? "Withdraw" : "Supply")
                            : (hasPosition ? "Repay" : "Borrow"))
                    </ButtonCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _tab = "supply";

    private const string _healthFactor = "2.45";
    private const string _totalSupplied = "$172,440";
    private const string _totalBorrowed = "$22,000";
    private const string _netApy = "2.9%";

    private record Market(string Token, string SupplyApy, string BorrowApy, string Supplied, string Borrowed, string Available);

    private static readonly Market[] _markets =
    [
        new("ETH",  "2.1%", "3.8%", "$115,240", "$0",     "4.28 ETH"),
        new("USDC", "3.8%", "5.2%", "$45,200",  "$22,000","5,230 USDC"),
        new("WBTC", "0.4%", "2.1%", "$0",        "$0",    "0.082 WBTC"),
        new("DAI",  "3.2%", "4.8%", "$12,000",   "$0",    "1,500 DAI"),
    ];
}
