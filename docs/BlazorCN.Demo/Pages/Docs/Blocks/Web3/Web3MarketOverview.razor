@* ============================================================
   Block: web3-market-overview
   Title: Web3MarketOverview
   Description: A React and Next.js crypto market overview block built with shadcn/ui and Tailwind CSS showing market cap, dominance, and top movers.
   Source: original/blocks/web3/web3-market-overview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Market Overview</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Fear &amp; Greed: 68 (Greed)
            </BadgeCn>
        </div>

        @* Market metrics grid *@
        <div class="grid grid-cols-2 border-b">
            @for (int i = 0; i < _metrics.Length; i++)
            {
                var m = _metrics[i];
                var idx = i;
                <div class="@Cn.Merge("px-4 py-3", idx < 2 ? "border-b" : "", idx % 2 == 0 ? "border-r" : "")">
                    <p class="text-muted-foreground text-xs">@m.Label</p>
                    <div class="mt-0.5 flex items-center gap-2">
                        <span class="font-semibold tabular-nums">@m.Value</span>
                        <span class="@Cn.Merge("text-xs tabular-nums", m.Positive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                            @m.Change
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Top Gainers / Top Losers *@
        <div class="grid grid-cols-2 border-b">

            @* Gainers *@
            <div class="border-r">
                <div class="border-b px-4 py-2">
                    <span class="flex items-center gap-1 text-xs font-medium text-emerald-600 dark:text-emerald-400">
                        <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                        Top Gainers
                    </span>
                </div>
                @for (int i = 0; i < _gainers.Length; i++)
                {
                    var g = _gainers[i];
                    var isLast = i == _gainers.Length - 1;
                    <div class="@Cn.Merge("flex items-center justify-between px-4 py-2", isLast ? "" : "border-b")">
                        <div>
                            <span class="font-medium text-sm">@g.Token</span>
                            <p class="font-mono text-muted-foreground text-xs tabular-nums">@g.Price</p>
                        </div>
                        <span class="font-mono text-xs tabular-nums text-emerald-600 dark:text-emerald-400">@g.Change</span>
                    </div>
                }
            </div>

            @* Losers *@
            <div>
                <div class="border-b px-4 py-2">
                    <span class="flex items-center gap-1 text-xs font-medium text-red-600 dark:text-red-400">
                        <LucideIconCn Name="trending-down" Size="12" Class="size-3" />
                        Top Losers
                    </span>
                </div>
                @for (int i = 0; i < _losers.Length; i++)
                {
                    var l = _losers[i];
                    var isLast = i == _losers.Length - 1;
                    <div class="@Cn.Merge("flex items-center justify-between px-4 py-2", isLast ? "" : "border-b")">
                        <div>
                            <span class="font-medium text-sm">@l.Token</span>
                            <p class="font-mono text-muted-foreground text-xs tabular-nums">@l.Price</p>
                        </div>
                        <span class="font-mono text-xs tabular-nums text-red-600 dark:text-red-400">@l.Change</span>
                    </div>
                }
            </div>

        </div>

    </div>
</section>

@code {
    private record MarketMetric(string Label, string Value, string Change, bool Positive);
    private record Mover(string Token, string Price, string Change, bool Positive);

    private static readonly MarketMetric[] _metrics =
    [
        new("Total Market Cap", "$2.84T",  "+2.4%",  true),
        new("24H Volume",       "$98.2B",  "+15.1%", true),
        new("BTC Dominance",    "52.3%",   "-0.4%",  false),
        new("ETH Dominance",    "17.8%",   "+0.2%",  true),
    ];

    private static readonly Mover[] _gainers =
    [
        new("PEPE", "$0.00001842", "+42.5%", true),
        new("ARB",  "$1.82",       "+18.3%", true),
        new("OP",   "$3.45",       "+12.7%", true),
    ];

    private static readonly Mover[] _losers =
    [
        new("DOGE", "$0.0812",      "-8.4%", false),
        new("SHIB", "$0.00000912",  "-6.2%", false),
        new("AVAX", "$28.50",       "-4.1%", false),
    ];
}
