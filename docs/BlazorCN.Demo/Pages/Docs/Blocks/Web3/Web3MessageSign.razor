@* ============================================================
   Block: web3-message-sign
   Title: Web3MessageSign
   Description: A React and Next.js wallet message signing block built with shadcn/ui and Tailwind CSS for authentication and verification.
   Source: original/blocks/web3/web3-message-sign.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="pen-tool" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Sign Message</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Message</span>
            <TextareaCn @bind-Value="_message" Class="mt-1.5 min-h-[80px] text-sm" Placeholder="Enter message to sign..." />
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Signing with</span>
                <span class="font-mono">0x7a25...f3e8</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Method</span>
                <span>personal_sign</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Gas cost</span>
                <span class="text-emerald-600 dark:text-emerald-400">Free (off-chain)</span>
            </div>
        </div>

        @if (_signed)
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between mb-2">
                    <span class="text-xs font-medium text-muted-foreground">Signature</span>
                    <div class="flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            <span class="mr-1 inline-block size-1.5 rounded-full bg-emerald-500"></span>
                            Verified
                        </BadgeCn>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" @onclick="HandleCopy">
                            @if (_copied)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            }
                        </ButtonCn>
                    </div>
                </div>
                <div class="rounded-md bg-muted/50 p-3">
                    <p class="font-mono text-xs break-all">@_signature</p>
                </div>
            </div>
        }

        <div class="px-4 py-3">
            <ButtonCn Class="h-9 w-full text-sm" @onclick="@(() => _signed = true)" Disabled="@(string.IsNullOrEmpty(_message))">
                @(_signed ? "Sign Again" : "Sign Message")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _message = "I verify that I own this wallet address.";
    private bool _signed = false;
    private bool _copied = false;

    private const string _signature = "0x4f2e8a1b3c9d...7e6f5a4b3c2d1e0f";

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(1500);
        _copied = false;
    }
}
