@* ============================================================
   Block: web3-price-chart
   Title: Web3PriceChart
   Description: A React and Next.js token price chart block built with shadcn/ui and Tailwind CSS. Features OHLC data, timeframe selector, and volume summary.
   Source: original/blocks/web3/web3-price-chart.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Ethereum</span>
                <span class="font-mono text-muted-foreground text-xs">ETH</span>
            </div>
        </div>

        @* Price *@
        <div class="border-b px-4 py-4">
            <p class="font-semibold text-2xl tabular-nums">$3,601.25</p>
            <p class="mt-0.5 text-emerald-600 dark:text-emerald-400 text-sm tabular-nums">
                +$59.15 (+1.67%)
            </p>
        </div>

        @* Timeframe selector *@
        <div class="flex items-center gap-1 border-b px-4 py-2">
            @foreach (var tf in _timeframes)
            {
                var timeframe = tf;
                <ButtonCn Variant="@(_selected == timeframe ? ButtonVariant.Default : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-6 px-2 text-xs"
                          OnClick="@(() => _selected = timeframe)">
                    @timeframe
                </ButtonCn>
            }
        </div>

        @* Bar chart *@
        <div class="border-b px-4 py-4">
            <div class="flex h-24 items-end gap-0.5">
                @foreach (var h in _chartHeights)
                {
                    var height = h;
                    <div class="flex-1 rounded-sm bg-emerald-500/20"
                         style="@($"height:{height}%")"></div>
                }
            </div>
        </div>

        @* OHLC *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">OHLC (24H)</span>
            <div class="mt-2 grid grid-cols-4 gap-3">
                @foreach (var item in _ohlc)
                {
                    <div>
                        <p class="text-muted-foreground text-xs">@item.Label</p>
                        <p class="mt-0.5 font-mono text-sm tabular-nums">@item.Value</p>
                    </div>
                }
            </div>
        </div>

        @* Performance *@
        <div class="px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Performance</span>
            <div class="mt-2 flex items-center gap-4">
                @foreach (var c in _changes)
                {
                    <div class="text-center">
                        <p class="text-muted-foreground text-xs">@c.Period</p>
                        <p class="@Cn.Merge("mt-0.5 font-mono text-xs tabular-nums", c.Positive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                            @c.Change
                        </p>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record PriceLevel(string Label, string Value);
    private record TimeChange(string Period, string Change, bool Positive);

    private static readonly string[] _timeframes = ["1H", "24H", "7D", "30D", "1Y", "ALL"];

    private static readonly int[] _chartHeights =
    [
        38, 42, 35, 48, 52, 45, 58, 62, 55, 68, 72, 65, 78, 85, 72, 68, 75, 82, 88, 78, 72,
        68, 75, 80,
    ];

    private static readonly PriceLevel[] _ohlc =
    [
        new("Open",  "$3,542.10"),
        new("High",  "$3,648.90"),
        new("Low",   "$3,498.30"),
        new("Close", "$3,601.25"),
    ];

    private static readonly TimeChange[] _changes =
    [
        new("1H",  "+0.34%",  true),
        new("24H", "+1.67%",  true),
        new("7D",  "-2.41%",  false),
        new("30D", "+8.93%",  true),
        new("1Y",  "+142.5%", true),
    ];

    private string _selected = "24H";
}
