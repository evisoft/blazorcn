@* ============================================================
   Block: web3-staking-dashboard
   Title: Web3StakingDashboard
   Description: A React and Next.js staking dashboard block built with shadcn/ui and Tailwind CSS featuring APY display, pending rewards, and stake/unstake actions.
   Source: original/blocks/web3/web3-staking-dashboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="coins" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Staking Dashboard</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_positions.Length positions
            </BadgeCn>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Staked</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums">@_totalStaked</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Avg. APY</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums text-emerald-600 dark:text-emerald-400">@_avgApy</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Pending Rewards</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums">@_totalRewards</p>
            </div>
        </div>

        <div>
            @for (int i = 0; i < _positions.Length; i++)
            {
                var pos = _positions[i];
                var isLast = i == _positions.Length - 1;
                var isClaimed = _claimedIds.Contains(pos.Id);
                var posId = pos.Id;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", _statusColor[pos.Status])"></span>
                            <span class="font-medium text-sm">@pos.Token</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                                @pos.Apy APY
                            </BadgeCn>
                        </div>
                        <div class="flex items-center gap-1.5">
                            @if (pos.Status == "active")
                            {
                                <div class="flex items-center gap-1 text-muted-foreground text-xs">
                                    <LucideIconCn Name="lock" Size="12" Class="size-3" />
                                    @pos.LockEnd
                                </div>
                            }
                            @if (pos.Status == "unlocking")
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    Unlocking
                                </BadgeCn>
                            }
                            @if (pos.Status == "claimable")
                            {
                                <ButtonCn Variant="ButtonVariant.Outline"
                                          Size="ButtonSize.Sm"
                                          Class="h-6 px-2 text-xs"
                                          OnClick="@(() => Claim(posId))"
                                          Disabled="@isClaimed">
                                    @(isClaimed ? "Claimed" : "Claim")
                                </ButtonCn>
                            }
                        </div>
                    </div>
                    <div class="mt-2 flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">
                            Staked: <span class="tabular-nums">@pos.Staked @pos.Token</span>
                        </span>
                        <span class="tabular-nums">@pos.Value</span>
                    </div>
                    <div class="mt-1 flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">
                            Rewards: <span class="tabular-nums">@pos.Rewards</span>
                        </span>
                        <span class="tabular-nums text-emerald-600 dark:text-emerald-400">@pos.RewardsUsd</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StakePosition(string Id, string Token, string Staked, string Value, string Apy, string Rewards, string RewardsUsd, string LockEnd, string Status);

    private static readonly StakePosition[] _positions =
    [
        new("1", "ETH",  "32.0000",    "$115,240.00", "4.2%",  "0.4480 ETH",   "$1,613.36", "No lock",      "active"),
        new("2", "MATIC","25,000.00",  "$22,250.00",  "5.8%",  "482.50 MATIC", "$429.43",   "14 days left", "active"),
        new("3", "SOL",  "150.00",     "$22,050.00",  "7.1%",  "3.55 SOL",     "$521.85",   "Unlocking",    "unlocking"),
        new("4", "ATOM", "500.00",     "$4,450.00",   "18.2%", "30.33 ATOM",   "$269.94",   "Claimable",    "claimable"),
    ];

    private static readonly string _totalStaked  = "$163,990.00";
    private static readonly string _totalRewards = "$2,834.58";
    private static readonly string _avgApy       = "6.4%";

    private static readonly System.Collections.Generic.Dictionary<string, string> _statusColor = new()
    {
        ["active"]    = "bg-emerald-500",
        ["unlocking"] = "bg-amber-500",
        ["claimable"] = "bg-blue-500",
    };

    private System.Collections.Generic.List<string> _claimedIds = [];

    private void Claim(string id)
    {
        if (!_claimedIds.Contains(id))
            _claimedIds.Add(id);
    }
}
