@* ============================================================
   Block: web3-snapshot-vote
   Title: Web3SnapshotVote
   Description: A React and Next.js Snapshot governance voting block built with shadcn/ui and Tailwind CSS featuring proposal details and results.
   Source: original/blocks/web3/web3-snapshot-vote.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="vote" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Governance Vote</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                <span class="mr-1.5 inline-block size-1.5 rounded-full bg-emerald-500"></span>
                Active
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <p class="font-medium text-sm">PIP-42: Increase staking rewards to 5%</p>
            <p class="mt-1 text-muted-foreground text-xs">
                This proposal increases the base staking reward rate from 4.2% to 5.0% APY to
                incentivize long-term token holders and validators.
            </p>
            <div class="mt-2 flex items-center gap-3 text-xs text-muted-foreground">
                <span>Ends in 2 days</span>
                <span>Snapshot: Block 19,425,000</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Cast Your Vote</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Your voting power: <span class="tabular-nums">@_userVotingPower</span>
            </p>
            <div class="mt-2 space-y-2">
                @foreach (var opt in _options)
                {
                    var optId = opt.Id;
                    <button
                        type="button"
                        @onclick="@(() => _voted = optId)"
                        disabled="@(_voted != null)"
                        class="@Cn.Merge("flex w-full items-center justify-between rounded-md border px-3 py-2 text-left transition-colors", _voted == opt.Id ? "border-foreground bg-muted/50" : "hover:bg-muted/30", _voted != null && _voted != opt.Id ? "opacity-50" : "")">
                        <span class="text-sm">@opt.Label</span>
                        <div class="text-right">
                            <span class="font-mono text-xs tabular-nums">@opt.Percentage%</span>
                        </div>
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs mb-2">
                <span class="text-muted-foreground">Results</span>
                <span class="tabular-nums">@_totalVotes total</span>
            </div>
            @foreach (var opt in _options)
            {
                <div class="mt-1.5">
                    <div class="flex items-center justify-between text-xs mb-1">
                        <span>@opt.Label</span>
                        <span class="tabular-nums">@opt.Percentage%</span>
                    </div>
                    <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                        <div
                            class="@Cn.Merge("h-full rounded-full", opt.Id == "1" ? "bg-emerald-500" : opt.Id == "2" ? "bg-red-500" : "bg-muted-foreground/40")"
                            style="@($"width:{opt.Percentage}%")">
                        </div>
                    </div>
                </div>
            }
            <p class="mt-2 text-muted-foreground text-xs">
                Quorum: <span class="tabular-nums">@_quorum</span>
                <span class="text-emerald-600 dark:text-emerald-400">(met)</span>
            </p>
        </div>

        @if (_voted != null)
        {
            <div class="px-4 py-3 text-center">
                <p class="text-sm text-emerald-600 dark:text-emerald-400">
                    Vote cast: @(_options.FirstOrDefault(o => o.Id == _voted)?.Label)
                </p>
            </div>
        }
    </div>
</section>

@code {
    private record VoteOption(string Id, string Label, int Votes, int Percentage);

    private static readonly VoteOption[] _options =
    [
        new("1", "For",     1842000, 62),
        new("2", "Against",  845000, 28),
        new("3", "Abstain",  298000, 10),
    ];

    private static readonly string _totalVotes = "2,985,000 PROTO";
    private static readonly string _quorum = "2,000,000 PROTO";
    private static readonly string _userVotingPower = "12,500 PROTO";

    private string? _voted = null;
}
