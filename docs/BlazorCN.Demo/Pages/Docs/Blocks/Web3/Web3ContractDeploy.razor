@* ============================================================
   Block: web3-contract-deploy
   Title: Web3ContractDeploy
   Description: A React and Next.js smart contract deploy wizard built with shadcn/ui and Tailwind CSS for guided deployment.
   Source: original/blocks/web3/web3-contract-deploy.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Deploy Contract</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Ethereum Mainnet
            </BadgeCn>
        </div>

        <div class="flex items-center border-b px-4 py-3">
            @foreach (var s in _steps)
            {
                var stepItem = s;
                var i = Array.IndexOf(_steps, stepItem);
                var stepIndex = Array.FindIndex(_steps, x => x.Id == _step);
                <div class="flex items-center flex-1">
                    <div class="flex items-center gap-2">
                        <div class="@Cn.Merge("flex size-5 items-center justify-center rounded-full text-xs", i < stepIndex ? "bg-emerald-500/10 text-emerald-600" : i == stepIndex ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                            @if (i < stepIndex)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <span>@(i + 1)</span>
                            }
                        </div>
                        <span class="@Cn.Merge("text-xs", i <= stepIndex ? "font-medium" : "text-muted-foreground")">
                            @stepItem.Label
                        </span>
                    </div>
                    @if (i < _steps.Length - 1)
                    {
                        <div class="mx-3 h-px flex-1 bg-border"></div>
                    }
                </div>
            }
        </div>

        @if (_step == "config")
        {
            <div class="px-4 py-4 space-y-3">
                <div>
                    <span class="text-xs font-medium text-muted-foreground">Contract Name</span>
                    <InputCn Class="mt-1 h-8 text-xs" Placeholder="MyToken" Value="MyToken" />
                </div>
                <div>
                    <span class="text-xs font-medium text-muted-foreground">Compiler Version</span>
                    <InputCn aria-label="Compiler Version" Class="mt-1 h-8 font-mono text-xs" Value="0.8.24" />
                </div>
                <div>
                    <span class="text-xs font-medium text-muted-foreground">Optimization Runs</span>
                    <InputCn aria-label="Optimization Runs" Class="mt-1 h-8 text-xs" Value="200" />
                </div>
                <div>
                    <span class="text-xs font-medium text-muted-foreground">EVM Version</span>
                    <InputCn aria-label="EVM Version" Class="mt-1 h-8 text-xs" Value="cancun" />
                </div>
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs w-full" @onclick="@(() => _step = "params")">
                    Next: Constructor Arguments
                </ButtonCn>
            </div>
        }

        @if (_step == "params")
        {
            <div class="px-4 py-4 space-y-3">
                <div>
                    <span class="text-xs font-medium text-muted-foreground font-mono">
                        name (string)
                    </span>
                    <InputCn Class="mt-1 h-8 text-xs" Placeholder="Token name" Value="My Token" />
                </div>
                <div>
                    <span class="text-xs font-medium text-muted-foreground font-mono">
                        symbol (string)
                    </span>
                    <InputCn Class="mt-1 h-8 text-xs" Placeholder="Symbol" Value="MTK" />
                </div>
                <div>
                    <span class="text-xs font-medium text-muted-foreground font-mono">
                        initialSupply (uint256)
                    </span>
                    <InputCn Class="mt-1 h-8 font-mono text-xs" Placeholder="Total supply in wei" Value="1000000000000000000000000" />
                </div>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs flex-1" @onclick="@(() => _step = "config")">
                        Back
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs flex-1" @onclick="@(() => _step = "review")">
                        Next: Review
                    </ButtonCn>
                </div>
            </div>
        }

        @if (_step == "review")
        {
            <div class="px-4 py-4 space-y-3">
                <div class="rounded-md bg-muted/50 p-3 space-y-1.5">
                    <div class="flex justify-between text-xs">
                        <span class="text-muted-foreground">Contract</span>
                        <span class="font-mono">MyToken</span>
                    </div>
                    <div class="flex justify-between text-xs">
                        <span class="text-muted-foreground">Compiler</span>
                        <span class="font-mono">0.8.24</span>
                    </div>
                    <div class="flex justify-between text-xs">
                        <span class="text-muted-foreground">Network</span>
                        <span>Ethereum Mainnet</span>
                    </div>
                    <div class="flex justify-between text-xs">
                        <span class="text-muted-foreground">Est. Gas</span>
                        <span class="tabular-nums">~1,200,000 gas ($51.89)</span>
                    </div>
                </div>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs flex-1" @onclick="@(() => _step = "params")">
                        Back
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs flex-1" @onclick="@(() => _step = "deploying")">
                        Deploy
                    </ButtonCn>
                </div>
            </div>
        }

        @if (_step == "deploying")
        {
            <div class="px-4 py-8 flex flex-col items-center gap-3">
                <LucideIconCn Name="loader-2" Size="24" Class="size-6 animate-spin text-muted-foreground" />
                <p class="font-medium text-sm">Deploying contract...</p>
                <p class="text-muted-foreground text-xs">Waiting for transaction confirmation</p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-2 h-7 text-xs" @onclick="@(() => _step = "deployed")">
                    Simulate Success
                </ButtonCn>
            </div>
        }

        @if (_step == "deployed")
        {
            <div class="px-4 py-6 flex flex-col items-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="check" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
                </div>
                <p class="font-medium text-sm">Contract Deployed</p>
                <p class="font-mono text-muted-foreground text-xs">0x1a2b3c4d...e5f6a7b8</p>
                <div class="flex gap-2 mt-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        View on Explorer
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs" @onclick="@(() => _step = "config")">
                        Deploy Another
                    </ButtonCn>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private string _step = "config";

    private record StepItem(string Id, string Label);

    private static readonly StepItem[] _steps =
    [
        new("config", "Configuration"),
        new("params", "Constructor"),
        new("review", "Review"),
    ];
}
