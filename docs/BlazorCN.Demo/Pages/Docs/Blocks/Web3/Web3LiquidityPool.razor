@* ============================================================
   Block: web3-liquidity-pool
   Title: Web3LiquidityPool
   Description: A React and Next.js liquidity pool manager block built with shadcn/ui and Tailwind CSS. Displays pool positions, APR, and impermanent loss.
   Source: original/blocks/web3/web3-liquidity-pool.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="droplet" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Liquidity Positions</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="plus" Size="12" Class="size-3" />
                Add Liquidity
            </ButtonCn>
        </div>

        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Liquidity</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums">$36,750.50</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Fees Earned</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums text-emerald-600 dark:text-emerald-400">
                    $736.25
                </p>
            </div>
        </div>

        <div>
            @foreach (var pool in _pools)
            {
                var isExpanded = _expanded == pool.Id;
                var isLast = pool.Id == _pools[_pools.Length - 1].Id;
                var capturedPool = pool;
                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : capturedPool.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-1.5 shrink-0 rounded-full {(pool.Status == "in-range" ? "bg-emerald-500" : "bg-amber-500")}")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@pool.Pair</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @pool.Protocol
                                </BadgeCn>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="tabular-nums">@pool.MyLiquidity</span>
                                <span>·</span>
                                <span class="tabular-nums text-emerald-600 dark:text-emerald-400">
                                    @pool.Apr APR
                                </span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="rounded-md bg-muted/50 p-3 space-y-1.5">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">TVL</span>
                                    <span class="tabular-nums">@pool.Tvl</span>
                                </div>
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">My Share</span>
                                    <span class="tabular-nums">@pool.MyShare</span>
                                </div>
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Fees Earned</span>
                                    <span class="tabular-nums text-emerald-600 dark:text-emerald-400">
                                        @pool.FeesEarned
                                    </span>
                                </div>
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Impermanent Loss</span>
                                    <span class="tabular-nums text-red-600 dark:text-red-400">
                                        @pool.Il
                                    </span>
                                </div>
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-muted-foreground">Status</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs capitalize">
                                        @pool.Status.Replace("-", " ")
                                    </BadgeCn>
                                </div>
                            </div>
                            <div class="mt-2 flex gap-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 flex-1 text-xs">
                                    Remove
                                </ButtonCn>
                                <ButtonCn Size="ButtonSize.Sm" Class="h-7 flex-1 text-xs">
                                    Add More
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = null;

    private record Pool(
        string Id,
        string Pair,
        string Protocol,
        string Tvl,
        string Apr,
        string MyLiquidity,
        string MyShare,
        string FeesEarned,
        string Il,
        string Status
    );

    private static readonly Pool[] _pools =
    [
        new("1", "ETH / USDC",   "Uniswap V3", "$245.3M",  "12.4%", "$8,420.50",  "0.003%", "$142.30", "-$23.10", "in-range"),
        new("2", "WBTC / ETH",   "Uniswap V3", "$182.1M",  "8.7%",  "$15,230.00", "0.008%", "$310.55", "-$89.20", "in-range"),
        new("3", "ARB / ETH",    "Camelot",    "$34.5M",   "24.1%", "$3,100.00",  "0.009%", "$198.40", "-$45.60", "out-of-range"),
        new("4", "USDC / USDT",  "Curve",      "$890.2M",  "3.2%",  "$10,000.00", "0.001%", "$85.00",  "-$0.50",  "in-range"),
    ];
}
