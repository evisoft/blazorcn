@* ============================================================
   Block: web3-nft-mint
   Title: Web3NftMint
   Description: A React and Next.js NFT minting block built with shadcn/ui and Tailwind CSS. Features mint quantity selector, price calculation, and supply progress.
   Source: original/blocks/web3/web3-nft-mint.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="aspect-video overflow-hidden border-b">
            <img
                src="https://picsum.photos/seed/mintcol/600/600"
                alt="Cosmic Apes Genesis"
                class="h-full w-full object-cover" />
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <h2 class="font-medium text-sm">Cosmic Apes Genesis</h2>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Public Sale
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">A collection of 10,000 uniquely generated cosmic apes living on the Ethereum blockchain.</p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs mb-2">
                <span class="text-muted-foreground">Minted</span>
                <span class="tabular-nums">7,342 / 10,000</span>
            </div>
            <ProgressCn Value="@_progress" Class="h-1.5" />
            <p class="mt-1.5 text-muted-foreground text-xs tabular-nums">2,658 remaining</p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-muted-foreground text-xs">Price per NFT</p>
                    <p class="mt-0.5 font-semibold text-sm tabular-nums">0.08 ETH</p>
                </div>
                <div class="flex items-center gap-3">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 w-7 p-0"
                              @onclick="@(() => DecreaseQuantity())"
                              Disabled="@(_quantity <= 1)">
                        <LucideIconCn Name="minus" Size="12" Class="size-3" />
                    </ButtonCn>
                    <span class="font-medium text-sm tabular-nums w-6 text-center">@_quantity</span>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 w-7 p-0"
                              @onclick="@(() => IncreaseQuantity())"
                              Disabled="@(_quantity >= _maxPerWallet)">
                        <LucideIconCn Name="plus" Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">Max @_maxPerWallet per wallet</p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Subtotal (@_quantity NFT@(_quantity > 1 ? "s" : ""))</span>
                <span class="tabular-nums">@_totalPrice ETH</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Est. Gas Fee</span>
                <span class="tabular-nums text-muted-foreground">~0.005 ETH</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs font-medium">
                <span>Total</span>
                <div class="text-right">
                    <span class="tabular-nums">@_totalWithGas ETH</span>
                    <p class="text-muted-foreground font-normal tabular-nums">$@_totalUsd</p>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="w-full h-9 text-sm">
                Mint @_quantity NFT@(_quantity > 1 ? "s" : "")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private int _quantity = 1;
    private const int _maxPerWallet = 5;
    private const double _pricePerNft = 0.08;
    private const int _totalSupply = 10000;
    private const int _minted = 7342;

    private double _progress => (_minted / (double)_totalSupply) * 100;
    private string _totalPrice => (_pricePerNft * _quantity).ToString("0.00");
    private string _totalWithGas => (_pricePerNft * _quantity + 0.005).ToString("0.000");
    private string _totalUsd => (_pricePerNft * _quantity * 3601.25).ToString("0.00");

    private void DecreaseQuantity()
    {
        if (_quantity > 1) _quantity--;
    }

    private void IncreaseQuantity()
    {
        if (_quantity < _maxPerWallet) _quantity++;
    }
}
