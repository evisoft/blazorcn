@* ============================================================
   Block: web3-identity-badge
   Title: Web3IdentityBadge
   Description: A React and Next.js on-chain identity badge block built with shadcn/ui and Tailwind CSS. Shows ENS name and credentials.
   Source: original/blocks/web3/web3-identity-badge.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="badge-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Identity</span>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-4">
                <div class="flex size-14 items-center justify-center rounded-full bg-muted/50">
                    <LucideIconCn Name="user" Size="24" Class="size-6 text-muted-foreground" />
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">alice.eth</span>
                        <LucideIconCn Name="badge-check" Size="16" Class="size-4 text-blue-500" />
                    </div>
                    <div class="mt-0.5 flex items-center gap-2">
                        <span class="font-mono text-muted-foreground text-xs">0x7a25...f3e8</span>
                        <ButtonCn aria-label="Copy address" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 w-5 p-0" OnClick="HandleCopy">
                            @if (_copied)
                            {
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                            }
                            else
                            {
                                <LucideIconCn Name="copy" Size="12" Class="size-3" />
                            }
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Wallet Age</p>
                <p class="mt-0.5 font-semibold tabular-nums text-sm">2.5 years</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Transactions</p>
                <p class="mt-0.5 font-semibold tabular-nums text-sm">1,248</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Trust Score</p>
                <p class="mt-0.5 font-semibold tabular-nums text-sm text-emerald-600 dark:text-emerald-400">
                    92/100
                </p>
            </div>
        </div>

        <div>
            <div class="border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Credentials</span>
            </div>
            @for (int i = 0; i < _credentials.Length; i++)
            {
                var cred = _credentials[i];
                var isLast = i == _credentials.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="text-sm">@cred.Label</span>
                    @if (cred.Verified)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            <span class="mr-1 inline-block size-1.5 rounded-full bg-emerald-500"></span>
                            Verified
                        </BadgeCn>
                    }
                    else
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs text-muted-foreground">
                            Not verified
                        </BadgeCn>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Credential(string Label, bool Verified);

    private static readonly Credential[] _credentials =
    [
        new("ENS Owner",        true),
        new("Gitcoin Passport", true),
        new("POAP Holder",      true),
        new("Lens Profile",     false),
        new("World ID",         true),
    ];

    private bool _copied = false;

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(1500);
        _copied = false;
    }
}
