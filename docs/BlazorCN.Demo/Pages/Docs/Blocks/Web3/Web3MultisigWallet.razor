@* ============================================================
   Block: web3-multisig-wallet
   Title: Web3MultisigWallet
   Description: A React and Next.js multisig wallet manager built with shadcn/ui and Tailwind CSS for approvals and execution controls.
   Source: original/blocks/web3/web3-multisig-wallet.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Multi-Sig Wallet</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                3 of 4 threshold
            </BadgeCn>
        </div>

        @* Wallet balance row *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-muted-foreground text-xs">Wallet Balance</p>
                    <p class="mt-0.5 font-semibold text-lg tabular-nums">$2,450,000</p>
                </div>
                <div class="flex items-center gap-1">
                    @foreach (var addr in _signerAddrs)
                    {
                        <div class="flex size-7 items-center justify-center rounded-full bg-muted/50">
                            <LucideIconCn Name="key" Size="12" Class="size-3 text-muted-foreground" />
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Pending header *@
        <div class="border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">
                Pending Transactions (@PendingCount)
            </span>
        </div>

        @* Transaction list *@
        <div>
            @for (int i = 0; i < _pendingTxs.Length; i++)
            {
                var tx = _pendingTxs[i];
                var isLast = i == _pendingTxs.Length - 1;
                var isReady = tx.Approvals >= tx.Threshold;
                var isExecuted = _executedIds.Contains(tx.Id);
                var txId = tx.Id;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-sm">@tx.Description</span>
                        @if (isExecuted)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                Executed
                            </BadgeCn>
                        }
                        else if (isReady)
                        {
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs"
                                      OnClick="@(() => Execute(txId))">
                                Execute
                            </ButtonCn>
                        }
                        else
                        {
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">
                                Approve
                            </ButtonCn>
                        }
                    </div>
                    <div class="mt-1.5 flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">
                            To: <span class="font-mono">@tx.To</span>
                        </span>
                        <span class="font-mono tabular-nums">@tx.Value</span>
                    </div>
                    <div class="mt-1.5 flex items-center gap-1.5">
                        @foreach (var signer in tx.Signers)
                        {
                            var approved = tx.Approved.Contains(signer);
                            <div class="@Cn.Merge("h-1.5 flex-1 rounded-full", approved ? "bg-emerald-500" : "bg-muted")"></div>
                        }
                        <span class="text-muted-foreground text-xs tabular-nums ml-1">
                            @tx.Approvals/@tx.Threshold
                        </span>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record PendingTx(
        string Id,
        string Description,
        string Value,
        string To,
        int Approvals,
        int Threshold,
        string[] Signers,
        string[] Approved);

    private static readonly string[] _signerAddrs = ["0x7a25", "0x3b91", "0x9e12", "0x6d03"];

    private static readonly PendingTx[] _pendingTxs =
    [
        new("1", "Developer grant payment", "50,000 USDC", "0x4f8c...e1a9", 2, 3,
            ["0x7a25...f3e8", "0x3b91...a2c7", "0x9e12...d4b6", "0x6d03...b7f2"],
            ["0x7a25...f3e8", "0x3b91...a2c7"]),
        new("2", "Audit service payment",   "85,000 USDC", "0x1a2b...c3d4", 1, 3,
            ["0x7a25...f3e8", "0x3b91...a2c7", "0x9e12...d4b6", "0x6d03...b7f2"],
            ["0x7a25...f3e8"]),
        new("3", "Add new signer",          "N/A",         "0x8c54...f1b3", 3, 3,
            ["0x7a25...f3e8", "0x3b91...a2c7", "0x9e12...d4b6", "0x6d03...b7f2"],
            ["0x7a25...f3e8", "0x3b91...a2c7", "0x9e12...d4b6"]),
    ];

    private List<string> _executedIds = [];

    private int PendingCount => System.Array.FindAll(_pendingTxs, t => !_executedIds.Contains(t.Id)).Length;

    private void Execute(string id)
    {
        if (!_executedIds.Contains(id))
            _executedIds.Add(id);
    }
}
