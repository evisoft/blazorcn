@* ============================================================
   Block: web3-order-book
   Title: Web3OrderBook
   Description: A React order book block built with Next.js, shadcn/ui, and Tailwind CSS featuring bid/ask columns and depth visualization.
   Source: original/blocks/web3/web3-order-book.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Order Book</span>
            </div>
            <span class="font-mono text-muted-foreground text-xs">ETH/USDC</span>
        </div>

        <div class="grid grid-cols-3 border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">Price (USDC)</span>
            <span class="text-xs font-medium text-muted-foreground text-right">Size (ETH)</span>
            <span class="text-xs font-medium text-muted-foreground text-right">Total (ETH)</span>
        </div>

        <div>
            @foreach (var ask in _asksReversed)
            {
                <div class="relative grid grid-cols-3 px-4 py-1">
                    <div class="absolute inset-y-0 right-0 bg-red-500/5" style="@($"width:{ask.Depth}%")"></div>
                    <span class="relative font-mono text-xs tabular-nums text-red-600 dark:text-red-400">@ask.Price</span>
                    <span class="relative font-mono text-xs tabular-nums text-right">@ask.Size</span>
                    <span class="relative font-mono text-xs tabular-nums text-right text-muted-foreground">@ask.Total</span>
                </div>
            }
        </div>

        <div class="border-y px-4 py-2 text-center">
            <span class="font-semibold text-lg tabular-nums">3,601.25</span>
            <span class="ml-2 text-muted-foreground text-xs">Spread: 0.75 (0.02%)</span>
        </div>

        <div>
            @foreach (var bid in _bids)
            {
                <div class="relative grid grid-cols-3 px-4 py-1">
                    <div class="absolute inset-y-0 right-0 bg-emerald-500/5" style="@($"width:{bid.Depth}%")"></div>
                    <span class="relative font-mono text-xs tabular-nums text-emerald-600 dark:text-emerald-400">@bid.Price</span>
                    <span class="relative font-mono text-xs tabular-nums text-right">@bid.Size</span>
                    <span class="relative font-mono text-xs tabular-nums text-right text-muted-foreground">@bid.Total</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record OrderLevel(string Price, string Size, string Total, int Depth);

    private static readonly OrderLevel[] _asks =
    [
        new("3,608.50", "12.45", "62.18", 95),
        new("3,607.20", "8.32",  "49.73", 75),
        new("3,606.10", "15.21", "41.41", 63),
        new("3,605.00", "5.80",  "26.20", 40),
        new("3,604.30", "9.12",  "20.40", 31),
        new("3,603.50", "3.45",  "11.28", 17),
        new("3,602.10", "7.83",  "7.83",  12),
    ];

    private static readonly OrderLevel[] _asksReversed = [.. System.Linq.Enumerable.Reverse(_asks)];

    private static readonly OrderLevel[] _bids =
    [
        new("3,601.00", "10.50", "10.50",  16),
        new("3,600.20", "6.78",  "17.28",  26),
        new("3,599.50", "14.32", "31.60",  48),
        new("3,598.10", "8.91",  "40.51",  62),
        new("3,597.00", "4.22",  "44.73",  68),
        new("3,595.80", "11.65", "56.38",  86),
        new("3,594.50", "9.30",  "65.68", 100),
    ];
}
