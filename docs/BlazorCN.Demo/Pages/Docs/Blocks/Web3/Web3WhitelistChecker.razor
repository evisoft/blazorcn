@* ============================================================
   Block: web3-whitelist-checker
   Title: Web3WhitelistChecker
   Description: A React and Next.js whitelist checker block built with shadcn/ui and Tailwind CSS for verifying wallet eligibility.
   Source: original/blocks/web3/web3-whitelist-checker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Whitelist Checker</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                4,218 spots
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Enter wallet address</span>
            <div class="mt-1.5 flex items-center gap-2">
                <InputCn @bind-Value="_address" Placeholder="0x..." Class="font-mono text-sm" />
                <ButtonCn Size="ButtonSize.Sm"
                          Class="h-9 shrink-0 gap-1 text-xs"
                          @onclick="HandleCheck"
                          Disabled="@(string.IsNullOrEmpty(_address) || _status == CheckStatus.Checking)">
                    <LucideIconCn Name="search" Size="12" Class="size-3" />
                    Check
                </ButtonCn>
            </div>
        </div>

        @if (_status == CheckStatus.Found)
        {
            <div class="border-b px-4 py-4">
                <div class="flex flex-col items-center gap-2">
                    <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="check-circle" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
                    </div>
                    <p class="font-medium text-sm">You are whitelisted</p>
                    <p class="text-muted-foreground text-xs">Tier: Gold</p>
                </div>
            </div>

            <div class="px-4 py-3">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Max allocation</span>
                    <span class="font-mono tabular-nums">5.0 ETH</span>
                </div>
                <div class="mt-1.5 flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Token price</span>
                    <span class="font-mono tabular-nums">$0.085</span>
                </div>
                <div class="mt-1.5 flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Sale starts</span>
                    <span>In 4 days</span>
                </div>
            </div>
        }

        @if (_status == CheckStatus.NotFound)
        {
            <div class="px-4 py-6">
                <div class="flex flex-col items-center gap-2">
                    <div class="flex size-10 items-center justify-center rounded-full bg-red-500/10">
                        <LucideIconCn Name="x-circle" Size="20" Class="size-5 text-red-600 dark:text-red-400" />
                    </div>
                    <p class="font-medium text-sm">Not whitelisted</p>
                    <p class="text-center text-muted-foreground text-xs">
                        This wallet is not on the whitelist. Check back later or apply for the next round.
                    </p>
                </div>
            </div>
        }

        @if (_status == CheckStatus.Idle)
        {
            <div class="px-4 py-6">
                <p class="text-center text-muted-foreground text-xs">
                    Enter your wallet address above to check eligibility for the upcoming token sale.
                </p>
            </div>
        }
    </div>
</section>

@code {
    private string _address = "";
    private CheckStatus _status = CheckStatus.Idle;

    private enum CheckStatus { Idle, Checking, Found, NotFound }

    private async Task HandleCheck()
    {
        if (string.IsNullOrEmpty(_address)) return;
        _status = CheckStatus.Checking;
        await Task.Delay(1000);
        _status = _address.StartsWith("0x") ? CheckStatus.Found : CheckStatus.NotFound;
    }
}
