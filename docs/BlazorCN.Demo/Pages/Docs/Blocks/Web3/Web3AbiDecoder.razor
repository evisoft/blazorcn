@* ============================================================
   Block: web3-abi-decoder
   Title: Web3AbiDecoder
   Description: React ABI decoder block for Next.js with calldata parsing and parameter display using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/web3-abi-decoder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="code" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">ABI Decoder</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Calldata or Transaction Hash</span>
            <TextareaCn @bind-Value="_calldata" Class="mt-1.5 min-h-[60px] font-mono text-xs" Placeholder="0x..." />
            <ButtonCn Size="ButtonSize.Sm" Class="mt-2 h-7 text-xs" @onclick="@(() => _decoded = true)">
                Decode
            </ButtonCn>
        </div>

        @if (_decoded)
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="text-xs font-medium text-muted-foreground">Function</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">
                        @_decodedFunction
                    </BadgeCn>
                </div>
                <div class="mt-1.5 flex items-center gap-2 text-xs">
                    <span class="text-muted-foreground">Selector</span>
                    <span class="font-mono">0x38ed1739</span>
                </div>
            </div>

            <div>
                <div class="grid grid-cols-[auto_auto_1fr] items-center gap-x-3 border-b px-4 py-2">
                    <span class="text-xs font-medium text-muted-foreground">Name</span>
                    <span class="text-xs font-medium text-muted-foreground">Type</span>
                    <span class="text-xs font-medium text-muted-foreground">Value</span>
                </div>
                @foreach (var param in _decodedParams)
                {
                    var isLast = param.Name == _decodedParams[_decodedParams.Length - 1].Name;
                    <div class="@Cn.Merge("grid grid-cols-[auto_auto_1fr] items-center gap-x-3 px-4 py-2.5", isLast ? "" : "border-b")">
                        <span class="font-mono text-xs text-blue-600 dark:text-blue-400">@param.Name</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">
                            @param.ParamType
                        </BadgeCn>
                        <span class="font-mono text-xs tabular-nums truncate">@param.Value</span>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private string _calldata = "0x38ed1739000000000000000000000000000000000000000000000000de0b6b3a7640000...";
    private bool _decoded = true;

    private const string _decodedFunction = "swapExactTokensForTokens";

    private record DecodedParam(string Name, string ParamType, string Value);

    private static readonly DecodedParam[] _decodedParams =
    [
        new("amountIn",    "uint256",   "1000000000000000000"),
        new("amountOutMin","uint256",   "3500000000"),
        new("path",        "address[]", "[WETH, USDC]"),
        new("to",          "address",   "0x7a25d8f1...f3e8"),
        new("deadline",    "uint256",   "1711929600"),
    ];
}
