@* ============================================================
   Block: web3-testnet-faucet
   Title: Web3TestnetFaucet
   Description: A React and Next.js testnet faucet block built with shadcn/ui and Tailwind CSS with network selection, address input, and cooldown timer.
   Source: original/blocks/web3/web3-testnet-faucet.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="droplet" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Testnet Faucet</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Free
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Network</span>
            <div class="mt-1.5 grid grid-cols-4 gap-1.5">
                @foreach (var (t, i) in _testnets.Select((t, i) => (t, i)))
                {
                    var idx = i;
                    <button
                        type="button"
                        @onclick="@(() => { _selectedNet = idx; _status = FaucetStatus.Idle; })"
                        class="@Cn.Merge("rounded-md border px-2 py-2 text-center text-xs transition-colors", _selectedNet == idx ? "border-foreground bg-muted/50 font-medium" : "hover:bg-muted/50")">
                        @t.Name
                    </button>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Wallet Address</span>
            <InputCn @bind-Value="_address" Class="mt-1.5 h-9 font-mono text-sm" Placeholder="0x..." />
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Drip amount</span>
                <span class="font-mono tabular-nums">@_testnets[_selectedNet].Amount</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Cooldown</span>
                <span>@_testnets[_selectedNet].Cooldown</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Faucet balance</span>
                <span class="tabular-nums">42.5 ETH remaining</span>
            </div>
        </div>

        @if (_status == FaucetStatus.Success)
        {
            <div class="border-b px-4 py-4">
                <div class="flex flex-col items-center gap-2">
                    <LucideIconCn Name="check-circle" Size="24" Class="size-6 text-emerald-600 dark:text-emerald-400" />
                    <p class="font-medium text-sm">Tokens sent!</p>
                    <p class="font-mono text-muted-foreground text-xs">Tx: 0x8f2a...b4c1</p>
                </div>
            </div>
        }

        <div class="px-4 py-3">
            <ButtonCn Class="h-9 w-full text-sm"
                      @onclick="HandleDrip"
                      Disabled="@(string.IsNullOrEmpty(_address) || _status == FaucetStatus.Dripping || _status == FaucetStatus.Success)">
                @if (_status == FaucetStatus.Dripping)
                {
                    <span class="flex items-center gap-2">
                        <LucideIconCn Name="loader-2" Size="14" Class="size-3.5 animate-spin" />
                        Sending...
                    </span>
                }
                else if (_status == FaucetStatus.Success)
                {
                    <span>Sent!</span>
                }
                else
                {
                    <span>Request @_testnets[_selectedNet].Amount</span>
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private enum FaucetStatus { Idle, Dripping, Success }

    private record Testnet(string Name, string Amount, string Cooldown);

    private static readonly Testnet[] _testnets =
    [
        new("Sepolia",          "0.5 ETH",   "24 hours"),
        new("Goerli",           "0.1 ETH",   "24 hours"),
        new("Mumbai",           "1.0 MATIC", "12 hours"),
        new("Arbitrum Sepolia", "0.5 ETH",   "24 hours"),
    ];

    private int _selectedNet = 0;
    private string _address = "";
    private FaucetStatus _status = FaucetStatus.Idle;

    private async Task HandleDrip()
    {
        _status = FaucetStatus.Dripping;
        await Task.Delay(2000);
        _status = FaucetStatus.Success;
    }
}
