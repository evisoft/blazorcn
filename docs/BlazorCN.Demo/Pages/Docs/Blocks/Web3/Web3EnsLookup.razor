@* ============================================================
   Block: web3-ens-lookup
   Title: Web3EnsLookup
   Description: A React and Next.js ENS lookup tool built with shadcn/ui and Tailwind CSS for name resolution, records display, and availability checks.
   Source: original/blocks/web3/web3-ens-lookup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">ENS Lookup</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground shrink-0" />
                <InputCn @bind-Value="_query"
                         Class="h-8 border-0 bg-transparent px-0 text-sm shadow-none focus-visible:ring-0"
                         Placeholder="Search ENS name or address..." />
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 shrink-0 text-xs" @onclick="HandleSearch">
                    Lookup
                </ButtonCn>
            </div>
        </div>

        @if (_status == LookupStatus.Found)
        {
            <div class="border-b px-4 py-4">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_query</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <span class="mr-1.5 inline-block size-1.5 rounded-full bg-emerald-500"></span>
                        Registered
                    </BadgeCn>
                </div>
                <p class="mt-1 font-mono text-muted-foreground text-xs">Owner: 0x7a25...f3e8</p>
                <p class="mt-0.5 text-muted-foreground text-xs">Expires: Dec 15, 2027</p>
            </div>

            <div>
                <div class="border-b px-4 py-2">
                    <span class="text-xs font-medium text-muted-foreground">Records</span>
                </div>
                @foreach (var rec in _records)
                {
                    var isLast = rec.Key == _records[_records.Length - 1].Key;
                    <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b")">
                        <span class="text-muted-foreground text-xs">@rec.Key</span>
                        <span class="font-mono text-xs truncate ml-4 max-w-[60%] text-right">@rec.Value</span>
                    </div>
                }
            </div>
        }

        @if (_status == LookupStatus.Available)
        {
            <div class="px-4 py-6 text-center">
                <p class="font-medium text-sm">@_query</p>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="mt-2 font-normal text-xs">
                    Available
                </BadgeCn>
                <p class="mt-2 text-muted-foreground text-xs">
                    This name is available for registration
                </p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 h-7 text-xs">
                    Register Name
                </ButtonCn>
            </div>
        }

        @if (_status == LookupStatus.Idle)
        {
            <div class="px-4 py-6 text-center">
                <p class="text-muted-foreground text-xs">
                    Enter an ENS name or Ethereum address to look up
                </p>
            </div>
        }
    </div>
</section>

@code {
    private string _query = "alice.eth";
    private LookupStatus _status = LookupStatus.Found;

    private enum LookupStatus { Idle, Searching, Found, Available }

    private record EnsRecord(string Key, string Value);

    private static readonly EnsRecord[] _records =
    [
        new("Address",      "0x7a25d8f1b3c9e4a6...f3e8"),
        new("Avatar",       "eip155:1/erc721:0xbc4c...4217"),
        new("Email",        "alice@example.com"),
        new("URL",          "https://alice.xyz"),
        new("Twitter",      "@aliceweb3"),
        new("GitHub",       "aliceweb3"),
        new("Content Hash", "ipfs://QmXyZ...abc123"),
    ];

    private void HandleSearch()
    {
        _status = LookupStatus.Searching;
        _status = _query.Contains("alice") ? LookupStatus.Found : LookupStatus.Available;
    }
}
