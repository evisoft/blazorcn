@* ============================================================
   Block: web3-contract-events
   Title: Web3ContractEvents
   Description: A React and Next.js smart contract event log viewer built with shadcn/ui and Tailwind CSS for decoded events.
   Source: original/blocks/web3/web3-contract-events.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="radio" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Contract Events</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-muted-foreground text-xs">Live</span>
            </div>
        </div>

        @* Filter bar *@
        <div class="flex items-center gap-1 border-b px-4 py-2">
            @foreach (var t in _eventTypes)
            {
                var eventType = t;
                <ButtonCn Variant="@(_filter == eventType ? ButtonVariant.Default : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-6 px-2 text-xs"
                          OnClick="@(() => _filter = eventType)">
                    @eventType
                </ButtonCn>
            }
        </div>

        @* Event list *@
        <div>
            @{
                var filtered = _filter == "All" ? _events : System.Array.FindAll(_events, e => e.Name == _filter);
            }
            @for (int i = 0; i < filtered.Length; i++)
            {
                var evt = filtered[i];
                var isLast = i == filtered.Length - 1;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">
                                @evt.Name
                            </BadgeCn>
                            <span class="font-mono text-muted-foreground text-xs">
                                Block @evt.Block
                            </span>
                        </div>
                        <span class="text-muted-foreground text-xs">@evt.Time</span>
                    </div>
                    <div class="mt-1.5 rounded-md bg-muted/50 p-2 space-y-1">
                        @foreach (var param in evt.Params)
                        {
                            <div class="flex items-center justify-between text-xs">
                                <span class="text-muted-foreground">@param.Key</span>
                                <span class="font-mono tabular-nums">@param.Value</span>
                            </div>
                        }
                    </div>
                    <p class="mt-1 font-mono text-muted-foreground text-xs">Tx: @evt.TxHash</p>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ContractEvent(
        string Id,
        string Name,
        string Block,
        string TxHash,
        Dictionary<string, string> Params,
        string Time);

    private static readonly string[] _eventTypes = ["All", "Transfer", "Approval", "Swap"];

    private static readonly ContractEvent[] _events =
    [
        new("1", "Transfer", "19,425,812", "0x1a2b...c3d4",
            new Dictionary<string, string> { ["from"] = "0x7a25...f3e8", ["to"] = "0x3b91...a2c7", ["value"] = "1,500 USDC" },
            "12s ago"),
        new("2", "Approval", "19,425,810", "0x5e6f...7g8h",
            new Dictionary<string, string> { ["owner"] = "0x9e12...d4b6", ["spender"] = "0x68b3...a4f2", ["value"] = "Unlimited" },
            "38s ago"),
        new("3", "Swap", "19,425,808", "0x9i0j...k1l2",
            new Dictionary<string, string> { ["sender"] = "0x4f8c...e1a9", ["amount0In"] = "1.0 ETH", ["amount1Out"] = "3,601 USDC" },
            "1m ago"),
        new("4", "Transfer", "19,425,805", "0x3m4n...o5p6",
            new Dictionary<string, string> { ["from"] = "0x0000...0000", ["to"] = "0x6d03...b7f2", ["value"] = "500 PROTO" },
            "2m ago"),
        new("5", "OwnershipTransferred", "19,425,800", "0x7q8r...s9t0",
            new Dictionary<string, string> { ["previousOwner"] = "0x8c54...f1b3", ["newOwner"] = "0x2d41...e9a7" },
            "5m ago"),
    ];

    private string _filter = "All";
}
