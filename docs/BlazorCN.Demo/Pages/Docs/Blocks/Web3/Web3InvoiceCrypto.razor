@* ============================================================
   Block: web3-invoice-crypto
   Title: Web3InvoiceCrypto
   Description: A React and Next.js crypto invoice block built with shadcn/ui and Tailwind CSS. Tracks line items and payment status.
   Source: original/blocks/web3/web3-invoice-crypto.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Invoice #INV-2026-042</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                <span class="mr-1.5 inline-block size-1.5 rounded-full bg-amber-500"></span>
                Pending
            </BadgeCn>
        </div>

        @* Invoice metadata *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">From</span>
                <span>Acme Dev Studio</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">To</span>
                <span>Protocol Labs Inc.</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Issued</span>
                <span>March 15, 2026</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Due</span>
                <span>March 30, 2026</span>
            </div>
        </div>

        @* Line items *@
        <div class="border-b">
            <div class="grid grid-cols-[1fr_auto_auto_auto] items-center gap-x-3 border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Description</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Qty</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Rate</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Amount</span>
            </div>
            @for (int i = 0; i < _items.Length; i++)
            {
                var item = _items[i];
                var isLast = i == _items.Length - 1;
                <div class="@Cn.Merge("grid grid-cols-[1fr_auto_auto_auto] items-center gap-x-3 border-b px-4 py-2.5", isLast ? "last:border-b-0" : "")">
                    <span class="text-sm">@item.Description</span>
                    <span class="font-mono text-xs tabular-nums text-right">@item.Quantity</span>
                    <span class="font-mono text-xs tabular-nums text-right text-muted-foreground">@item.Rate</span>
                    <span class="font-mono text-xs tabular-nums text-right">@item.Amount</span>
                </div>
            }
        </div>

        @* Total *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">Total</span>
                <div class="text-right">
                    <span class="font-semibold text-lg tabular-nums">$9,700</span>
                    <p class="font-mono text-muted-foreground text-xs tabular-nums">2.6936 ETH</p>
                </div>
            </div>
        </div>

        @* Payment address *@
        <div class="px-4 py-3">
            <span class="text-muted-foreground text-xs">Payment Address</span>
            <div class="mt-1.5 flex items-center gap-2">
                <span class="flex-1 font-mono text-xs text-muted-foreground">
                    0x7a25d8f1b3c9e4a6...f3e8
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="h-6 gap-1 px-2 text-xs"
                          OnClick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record InvoiceItem(string Description, int Quantity, string Rate, string Amount);

    private static readonly InvoiceItem[] _items =
    [
        new("Smart Contract Development", 40, "$150/hr", "$6,000"),
        new("Security Audit Review",       1, "$2,500",  "$2,500"),
        new("Deployment & Testing",         8, "$150/hr", "$1,200"),
    ];

    private bool _copied = false;

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(1500);
        _copied = false;
    }
}
