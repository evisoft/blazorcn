@* ============================================================
   Block: web3-referral-program
   Title: Web3ReferralProgram
   Description: A React and Next.js crypto referral program block built with shadcn/ui and Tailwind CSS. Features referral links, tier rewards, and stats.
   Source: original/blocks/web3/web3-referral-program.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Referral Program</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Silver Tier
            </BadgeCn>
        </div>

        @* Stats row *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Referrals</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums">14</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Earned</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums">$842</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Pending</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums">$125</p>
            </div>
        </div>

        @* Referral link *@
        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Your Referral Link</span>
            <div class="mt-1.5 flex items-center gap-2">
                <div class="flex-1 rounded-md bg-muted/50 px-3 py-2">
                    <span class="font-mono text-xs">@_referralLink</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline"
                          Size="ButtonSize.Sm"
                          Class="h-8 gap-1 text-xs shrink-0"
                          OnClick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        @("Copied")
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        @("Copy")
                    }
                </ButtonCn>
            </div>
        </div>

        @* Reward tiers *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Reward Tiers</span>
            </div>
            @for (int i = 0; i < _tiers.Length; i++)
            {
                var tier = _tiers[i];
                var isLast = i == _tiers.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", tier.Active ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                        <span class="@Cn.Merge("text-sm", tier.Active ? "font-medium" : "")">@tier.Name</span>
                        <span class="text-muted-foreground text-xs tabular-nums">@tier.Referrals referrals</span>
                    </div>
                    <span class="text-xs tabular-nums">@tier.Reward</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ReferralTier(string Name, string Referrals, string Reward, bool Active);

    private const string _referralLink = "https://protocol.xyz/ref/alice";

    private static readonly ReferralTier[] _tiers =
    [
        new("Bronze",   "1-5",   "5% fees",  false),
        new("Silver",   "6-20",  "10% fees", true),
        new("Gold",     "21-50", "15% fees", false),
        new("Platinum", "50+",   "20% fees", false),
    ];

    private bool _copied = false;

    private async Task HandleCopy()
    {
        _copied = true;
        await Task.Delay(1500);
        _copied = false;
    }
}
