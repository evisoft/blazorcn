@* ============================================================
   Block: web3-offer-manager
   Title: Web3OfferManager
   Description: A React and Next.js NFT offer manager block built with shadcn/ui and Tailwind CSS. Features incoming/outgoing offers with expiration and accept/decline controls.
   Source: original/blocks/web3/web3-offer-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="inbox" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Offers</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @(_offers.Length == 0 ? 0 : System.Array.FindAll(_offers, o => o.Type == "incoming").Length) incoming
            </BadgeCn>
        </div>

        @* Tab switcher *@
        <div class="grid grid-cols-2 border-b">
            <button type="button"
                    @onclick="@(() => _tab = "incoming")"
                    class="@Cn.Merge("py-2.5 text-center text-sm transition-colors", _tab == "incoming" ? "bg-muted/30 font-medium" : "text-muted-foreground hover:bg-muted/50")">
                Incoming
            </button>
            <button type="button"
                    @onclick="@(() => _tab = "outgoing")"
                    class="@Cn.Merge("border-l py-2.5 text-center text-sm transition-colors", _tab == "outgoing" ? "bg-muted/30 font-medium" : "text-muted-foreground hover:bg-muted/50")">
                Outgoing
            </button>
        </div>

        @* Offer list *@
        <div>
            @{
                var filtered = System.Array.FindAll(_offers, o => o.Type == _tab && !_handledIds.Contains(o.Id));
            }
            @if (filtered.Length == 0)
            {
                <div class="px-4 py-8 text-center">
                    <p class="text-muted-foreground text-xs">No @_tab offers</p>
                </div>
            }
            else
            {
                @for (int i = 0; i < filtered.Length; i++)
                {
                    var offer = filtered[i];
                    var isLast = i == filtered.Length - 1;
                    <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                        <div class="flex items-center justify-between">
                            <div>
                                <span class="font-medium text-sm">@offer.Nft</span>
                                <p class="mt-0.5 font-mono text-muted-foreground text-xs">
                                    @(_tab == "incoming" ? $"From: {offer.From}" : $"To: {offer.Nft} owner")
                                </p>
                            </div>
                            <div class="text-right">
                                <span class="font-mono text-sm tabular-nums">@offer.Amount</span>
                                <p class="mt-0.5 text-muted-foreground text-xs">
                                    Expires in @offer.Expires
                                </p>
                            </div>
                        </div>
                        <div class="mt-2 flex items-center justify-end gap-2">
                            @if (_tab == "incoming")
                            {
                                var offerId = offer.Id;
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs"
                                          OnClick="@(() => HandleOffer(offerId))">
                                    Decline
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs"
                                          OnClick="@(() => HandleOffer(offerId))">
                                    Accept
                                </ButtonCn>
                            }
                            else
                            {
                                var offerId = offer.Id;
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs"
                                          OnClick="@(() => HandleOffer(offerId))">
                                    Cancel Offer
                                </ButtonCn>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private record Offer(string Id, string Nft, string From, string Amount, string Expires, string Type);

    private static readonly Offer[] _offers =
    [
        new("1", "Cosmic Ape #4217",  "0x3b91...a2c7", "3.5 ETH",  "2 days", "incoming"),
        new("2", "Cosmic Ape #4217",  "0x9e12...d4b6", "3.2 ETH",  "5 days", "incoming"),
        new("3", "Pixel Punk #891",   "You",           "7.5 ETH",  "1 day",  "outgoing"),
        new("4", "Digital Dream #77", "You",           "12.0 ETH", "3 days", "outgoing"),
    ];

    private string _tab = "incoming";
    private List<string> _handledIds = [];

    private void HandleOffer(string id)
    {
        _handledIds.Add(id);
    }
}
