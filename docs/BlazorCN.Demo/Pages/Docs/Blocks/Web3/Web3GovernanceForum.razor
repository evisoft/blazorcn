@* ============================================================
   Block: web3-governance-forum
   Title: Web3GovernanceForum
   Description: A React and Next.js DAO governance forum block built with shadcn/ui Badge and Tailwind CSS for proposal discussions.
   Source: original/blocks/web3/web3-governance-forum.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Governance Forum</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_threads.Length active
            </BadgeCn>
        </div>

        <div>
            @for (int i = 0; i < _threads.Length; i++)
            {
                var thread = _threads[i];
                var isLast = i == _threads.Length - 1;
                var isUpvoted = _upvoted.Contains(thread.Id);
                var threadId = thread.Id;
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => HandleUpvote(threadId))"
                            class="@Cn.Merge("flex flex-col items-center gap-0.5 pt-0.5", isUpvoted ? "text-blue-600 dark:text-blue-400" : "text-muted-foreground")">
                        <LucideIconCn Name="arrow-up" Size="14" Class="size-3.5" />
                        <span class="font-mono text-xs tabular-nums">
                            @(thread.Upvotes + (isUpvoted ? 1 : 0))
                        </span>
                    </button>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@thread.Title</span>
                        <div class="mt-1 flex items-center gap-2">
                            <span class="@Cn.Merge("font-mono text-xs", GetRoleColor(thread.AuthorRole))">
                                @thread.Author
                            </span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @thread.Category
                            </BadgeCn>
                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                @thread.Comments
                            </span>
                            <span class="text-muted-foreground text-xs">@thread.Time</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum AuthorRole { Core, Delegate, Member }

    private record ForumThread(string Id, string Title, string Author, AuthorRole AuthorRole, int Upvotes, int Comments, string Category, string Time);

    private static readonly ForumThread[] _threads =
    [
        new("1", "Proposal to increase staking rewards by 2%",  "0x7a25...f3e8", AuthorRole.Core,     142, 38, "Treasury",    "4 hours ago"),
        new("2", "Add support for Arbitrum deployment",          "0x3b91...a2c7", AuthorRole.Delegate,  89, 24, "Technical",   "12 hours ago"),
        new("3", "Community grants program Q2 budget",           "0x9e12...d4b6", AuthorRole.Core,      67, 15, "Grants",      "1 day ago"),
        new("4", "Reduce quorum threshold from 10% to 5%",       "0x4f8c...e1a9", AuthorRole.Member,   203, 56, "Governance",  "2 days ago"),
        new("5", "Partnership proposal with Chainlink oracles",  "0x6d03...b7f2", AuthorRole.Delegate,  45, 11, "Partnerships","3 days ago"),
    ];

    private List<string> _upvoted = [];

    private void HandleUpvote(string id)
    {
        if (_upvoted.Contains(id))
            _upvoted.Remove(id);
        else
            _upvoted.Add(id);
    }

    private static string GetRoleColor(AuthorRole role) => role switch
    {
        AuthorRole.Core     => "text-purple-600 dark:text-purple-400",
        AuthorRole.Delegate => "text-blue-600 dark:text-blue-400",
        AuthorRole.Member   => "text-muted-foreground",
        _                   => "text-muted-foreground",
    };
}
