@* ============================================================
   Block: web3-dao-voting
   Title: Web3DaoVoting
   Description: A React DAO voting interface block built with Next.js, shadcn/ui, and Tailwind CSS featuring proposals, vote counts, and status badges.
   Source: original/blocks/web3/web3-dao-voting.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="vote" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Governance</span>
            </div>
            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                <span>
                    Your voting power: <span class="font-medium text-foreground tabular-nums">24,500</span>
                </span>
            </div>
        </div>

        <div>
            @for (int i = 0; i < _proposals.Length; i++)
            {
                var proposal = _proposals[i];
                var isLast = i == _proposals.Length - 1;
                var isExpanded = _expanded == proposal.Id;
                var config = GetStatusConfig(proposal.Status);
                var proposalId = proposal.Id;
                <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = (_expanded == proposalId ? null : proposalId))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", config.Dot)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs">@proposal.Id</span>
                                <span class="truncate font-medium text-sm">@proposal.Title</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@config.Label</span>
                                <span>·</span>
                                <span class="tabular-nums">@proposal.TotalVotes votes</span>
                                <span>·</span>
                                <span>@proposal.TimeLeft</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right"
                                      Size="16"
                                      Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded && proposal.Status != ProposalStatus.Pending)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="rounded-md bg-muted/50 p-3 space-y-2">
                                <div>
                                    <div class="flex items-center justify-between text-xs mb-1">
                                        <span class="text-emerald-600 dark:text-emerald-400">For</span>
                                        <span class="tabular-nums">@proposal.ForPercent%</span>
                                    </div>
                                    <ProgressCn Value="@((double)proposal.ForPercent)" Class="h-1 [&>div]:bg-emerald-500" />
                                </div>
                                <div>
                                    <div class="flex items-center justify-between text-xs mb-1">
                                        <span class="text-red-600 dark:text-red-400">Against</span>
                                        <span class="tabular-nums">@proposal.AgainstPercent%</span>
                                    </div>
                                    <ProgressCn Value="@((double)proposal.AgainstPercent)" Class="h-1 [&>div]:bg-red-500" />
                                </div>
                                <div class="flex items-center justify-between text-xs pt-1">
                                    <span class="text-muted-foreground">Proposed by</span>
                                    <span class="font-mono">@proposal.Author</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private enum ProposalStatus { Active, Passed, Defeated, Pending }

    private record Proposal(string Id, string Title, ProposalStatus Status, int ForPercent, int AgainstPercent, string TotalVotes, string TimeLeft, string Author);

    private record StatusConfig(string Dot, string Label);

    private static readonly Proposal[] _proposals =
    [
        new("PIP-45", "Enable WBTC as collateral for lending",     ProposalStatus.Active,   78, 22, "2.1M", "2 days left",       "0x7a25...f3e8"),
        new("PIP-44", "Reduce protocol fees from 0.3% to 0.25%",   ProposalStatus.Active,   52, 48, "1.8M", "5 days left",       "0x3c4d...a1b2"),
        new("PIP-43", "Fund developer grants program Q2 2026",      ProposalStatus.Pending,   0,  0, "0",    "Starts in 1 day",   "0x9e8f...c3d4"),
        new("PIP-42", "Increase USDC lending pool cap to $50M",     ProposalStatus.Passed,   84, 16, "3.2M", "Ended",             "0x5a6b...e5f6"),
        new("PIP-41", "Migrate liquidity to V4 contracts",          ProposalStatus.Defeated, 35, 65, "2.5M", "Ended",             "0x1d2e...f7a8"),
    ];

    private string? _expanded = "PIP-45";

    private static StatusConfig GetStatusConfig(ProposalStatus status) => status switch
    {
        ProposalStatus.Active   => new("bg-emerald-500", "Active"),
        ProposalStatus.Passed   => new("bg-blue-500",    "Passed"),
        ProposalStatus.Defeated => new("bg-red-500",     "Defeated"),
        ProposalStatus.Pending  => new("bg-amber-500",   "Pending"),
        _                       => new("bg-muted",       "Unknown"),
    };
}
