@* ============================================================
   Block: web3-activity-feed
   Title: Web3ActivityFeed
   Description: React blockchain activity feed block for Next.js with transaction filtering and live updates using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/web3-activity-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="coins" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Activity</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-muted-foreground text-xs">Live</span>
            </div>
        </div>

        @* Filter bar *@
        <div class="flex items-center gap-1 border-b px-4 py-2">
            @foreach (var f in _filterTypes)
            {
                var filterVal = f;
                <ButtonCn Variant="@(_filter == filterVal ? ButtonVariant.Default : ButtonVariant.Ghost)"
                          Size="ButtonSize.Sm"
                          Class="h-6 px-2 text-xs capitalize"
                          OnClick="@(() => _filter = filterVal)">
                    @filterVal
                </ButtonCn>
            }
        </div>

        @* Activity list *@
        <div>
            @{
                var filtered = _filter == "all" ? _activities : System.Array.FindAll(_activities, a => a.Type == _filter);
            }
            @for (int i = 0; i < filtered.Length; i++)
            {
                var activity = filtered[i];
                var isLast = i == filtered.Length - 1;
                var iconName = GetIconName(activity.Type);
                var colorClass = GetTypeColor(activity.Type);
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucideIconCn Name="@iconName" Size="16" Class="@Cn.Merge("size-4", colorClass)" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@activity.Title</span>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">
                            @activity.From → @activity.To
                        </p>
                    </div>
                    <div class="text-right shrink-0">
                        <span class="font-mono text-xs tabular-nums">@activity.Amount</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@activity.Time</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Activity(string Id, string Type, string Title, string From, string To, string Amount, string Time);

    private static readonly string[] _filterTypes = ["all", "transfer", "swap", "mint", "receive"];

    private static readonly Activity[] _activities =
    [
        new("1", "swap",     "Swapped ETH for USDC",   "0x7a25...f3e8", "Uniswap V3",    "1.5 ETH",      "2 min ago"),
        new("2", "receive",  "Received USDC",           "0x3b91...a2c7", "0x7a25...f3e8", "5,000 USDC",   "15 min ago"),
        new("3", "mint",     "Minted Cosmic Ape #4217", "0x7a25...f3e8", "0x9e12...d4b6", "0.08 ETH",     "1 hour ago"),
        new("4", "transfer", "Sent ETH",                "0x7a25...f3e8", "0x4f8c...e1a9", "2.0 ETH",      "3 hours ago"),
        new("5", "swap",     "Swapped USDC for DAI",    "0x7a25...f3e8", "Curve",         "10,000 USDC",  "5 hours ago"),
        new("6", "receive",  "Received WBTC",           "0x6d03...b7f2", "0x7a25...f3e8", "0.15 WBTC",    "8 hours ago"),
    ];

    private string _filter = "all";

    private static string GetIconName(string type) => type switch
    {
        "transfer" => "arrow-up-right",
        "swap"     => "arrow-right-left",
        "mint"     => "image",
        "receive"  => "arrow-down-left",
        _          => "arrow-right-left",
    };

    private static string GetTypeColor(string type) => type switch
    {
        "swap"    => "text-blue-600 dark:text-blue-400",
        "mint"    => "text-purple-600 dark:text-purple-400",
        "receive" => "text-emerald-600 dark:text-emerald-400",
        _         => "",
    };
}
