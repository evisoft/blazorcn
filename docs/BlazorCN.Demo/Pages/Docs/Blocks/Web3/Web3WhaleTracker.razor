@* ============================================================
   Block: web3-whale-tracker
   Title: Web3WhaleTracker
   Description: A React and Next.js whale tracker block built with shadcn/ui and Tailwind CSS for monitoring large crypto wallet movements.
   Source: original/blocks/web3/web3-whale-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="fish" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Whale Tracker</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-muted-foreground text-xs">Live</span>
            </div>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Exchange Inflows</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums text-red-600 dark:text-red-400">$134.0M</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Exchange Outflows</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums text-emerald-600 dark:text-emerald-400">$196.0M</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Net Flow</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums text-emerald-600 dark:text-emerald-400">-$62.0M</p>
            </div>
        </div>

        <div>
            @for (int i = 0; i < _transactions.Length; i++)
            {
                var tx = _transactions[i];
                var isLast = i == _transactions.Length - 1;
                var iconName = tx.Direction == "exchange-in" ? "arrow-up-right" : tx.Direction == "exchange-out" ? "arrow-down-left" : "arrow-up-right";
                var iconColor = tx.Direction == "exchange-in" ? "text-red-600 dark:text-red-400" : tx.Direction == "exchange-out" ? "text-emerald-600 dark:text-emerald-400" : "text-blue-600 dark:text-blue-400";
                var dirColor = tx.Direction == "exchange-in" ? "text-red-600 dark:text-red-400" : tx.Direction == "exchange-out" ? "text-emerald-600 dark:text-emerald-400" : "text-blue-600 dark:text-blue-400";
                var dirLabel = tx.Direction == "exchange-in" ? "Exchange Inflow" : tx.Direction == "exchange-out" ? "Exchange Outflow" : "Wallet Transfer";
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucideIconCn Name="@iconName" Size="16" Class="@Cn.Merge("size-4", iconColor)" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm tabular-nums">@tx.Amount @tx.Token</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-xs", dirColor)">@dirLabel</BadgeCn>
                        </div>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">@tx.From → @tx.To</p>
                    </div>
                    <div class="text-right shrink-0">
                        <span class="font-mono text-xs tabular-nums">@tx.UsdValue</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@tx.Time</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record WhaleTransaction(string Id, string Token, string Amount, string UsdValue, string From, string To, string Direction, string Time);

    private static readonly WhaleTransaction[] _transactions =
    [
        new("1", "ETH",  "15,000",     "$54.0M",  "Unknown",        "Binance",  "exchange-in",  "3 min ago"),
        new("2", "BTC",  "2,500",      "$166.5M", "Coinbase",       "Unknown",  "exchange-out", "12 min ago"),
        new("3", "USDT", "80,000,000", "$80.0M",  "Tether Treasury","Bitfinex", "exchange-in",  "28 min ago"),
        new("4", "ETH",  "8,200",      "$29.5M",  "Kraken",         "Unknown",  "exchange-out", "45 min ago"),
        new("5", "SOL",  "450,000",    "$66.2M",  "Unknown",        "Unknown",  "wallet",       "1 hour ago"),
        new("6", "USDC", "50,000,000", "$50.0M",  "Circle",         "Unknown",  "wallet",       "2 hours ago"),
    ];
}
