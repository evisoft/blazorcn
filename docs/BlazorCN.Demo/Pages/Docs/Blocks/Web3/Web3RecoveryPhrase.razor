@* ============================================================
   Block: web3-recovery-phrase
   Title: Web3RecoveryPhrase
   Description: A React and Next.js recovery phrase backup block built with shadcn/ui and Tailwind CSS. Features word grid, verification, and security warnings.
   Source: original/blocks/web3/web3-recovery-phrase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-alert" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Recovery Phrase</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-2 rounded-md bg-amber-500/10 p-3">
                <LucideIconCn Name="triangle-alert" Size="16" Class="size-4 shrink-0 text-amber-600 dark:text-amber-400 mt-0.5" />
                <div>
                    <p class="font-medium text-xs text-amber-600 dark:text-amber-400">
                        Never share your recovery phrase
                    </p>
                    <p class="mt-0.5 text-xs text-amber-600/80 dark:text-amber-400/80">
                        Anyone with these words can access your wallet. Write them down and store in a safe
                        place.
                    </p>
                </div>
            </div>
        </div>

        <div class="border-b px-4 py-4">
            @if (_revealed)
            {
                <div class="grid grid-cols-3 gap-2">
                    @foreach (var entry in _indexedWords)
                    {
                        <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                            <span class="text-muted-foreground text-xs tabular-nums w-5">@(entry.Index + 1).</span>
                            <span class="font-mono text-sm">@entry.Word</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="flex flex-col items-center gap-3 py-4">
                    <div class="grid grid-cols-3 gap-2 w-full">
                        @foreach (var entry in _indexedWords)
                        {
                            <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                                <span class="text-muted-foreground text-xs tabular-nums w-5">@(entry.Index + 1).</span>
                                <span class="font-mono text-sm text-muted-foreground/30">* * * *</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="border-b px-4 py-3 flex items-center justify-between">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs" @onclick="@(() => _revealed = !_revealed)">
                @if (_revealed)
                {
                    <LucideIconCn Name="eye-off" Size="12" Class="size-3" />
                    <span>Hide</span>
                }
                else
                {
                    <LucideIconCn Name="eye" Size="12" Class="size-3" />
                    <span>Reveal</span>
                }
            </ButtonCn>
            <span class="text-muted-foreground text-xs">12 words</span>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="h-9 w-full text-sm" Disabled="@(!_revealed || _verified)" @onclick="@(() => _verified = true)">
                @(_verified ? "Backup Verified" : "I have saved my recovery phrase")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _revealed = false;
    private bool _verified = false;

    private record WordEntry(int Index, string Word);

    private static readonly string[] _seedPhrase =
    [
        "abandon", "ability", "able", "about", "above", "absent",
        "absorb", "abstract", "absurd", "abuse", "access", "accident",
    ];

    private static readonly WordEntry[] _indexedWords = BuildIndexed();

    private static WordEntry[] BuildIndexed()
    {
        var result = new WordEntry[_seedPhrase.Length];
        for (var i = 0; i < _seedPhrase.Length; i++)
            result[i] = new WordEntry(i, _seedPhrase[i]);
        return result;
    }
}
