@* ============================================================
   Block: web3-airdrop-checker
   Title: Web3AirdropChecker
   Description: React airdrop eligibility checker block for Next.js with multi-protocol scanning and estimated values using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/web3-airdrop-checker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="gift" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Airdrop Checker</span>
            </div>
            @if (_checked)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                    @(_eligibleCount)/@(_checks.Length) eligible
                </BadgeCn>
            }
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="search" Size="14" Class="size-3.5 text-muted-foreground shrink-0" />
                <InputCn @bind-Value="_address"
                         Class="h-8 border-0 bg-transparent px-0 font-mono text-sm shadow-none focus-visible:ring-0"
                         Placeholder="Enter wallet address..." />
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 shrink-0 text-xs" @onclick="@(() => _checked = true)">
                    Check
                </ButtonCn>
            </div>
        </div>

        @if (_checked)
        {
            <div>
                @foreach (var chk in _checks)
                {
                    var isLast = chk.Protocol == _checks[_checks.Length - 1].Protocol;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", chk.Eligible ? "bg-emerald-500" : "bg-red-500")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@chk.Protocol</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                    @chk.Chain
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@chk.Reason</p>
                        </div>
                        <div class="text-right shrink-0">
                            @if (chk.Eligible)
                            {
                                <span class="font-mono text-xs tabular-nums text-emerald-600 dark:text-emerald-400">@chk.EstimatedValue</span>
                            }
                            else
                            {
                                <span class="text-muted-foreground text-xs">Not eligible</span>
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private string _address = "0x7a25...f3e8";
    private bool _checked = true;

    private record AirdropCheck(string Protocol, string Chain, bool Eligible, string Reason, string EstimatedValue);

    private static readonly AirdropCheck[] _checks =
    [
        new("LayerZero", "Multi-chain",  true,  "Bridged 10+ times",       "$500-2,000"),
        new("zkSync",    "zkSync Era",   true,  "50+ transactions",        "$1,000-5,000"),
        new("Starknet",  "Starknet",     false, "No activity detected",    "N/A"),
        new("Scroll",    "Scroll",       true,  "15 transactions",         "$200-800"),
        new("Linea",     "Linea",        false, "Below min threshold",     "N/A"),
        new("Blast",     "Blast",        true,  "Points holder",           "$300-1,200"),
    ];

    private int _eligibleCount => _checks.Length > 0 ? System.Linq.Enumerable.Count(_checks, c => c.Eligible) : 0;
}
