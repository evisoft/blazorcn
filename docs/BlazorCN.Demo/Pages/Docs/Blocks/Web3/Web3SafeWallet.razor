@* ============================================================
   Block: web3-safe-wallet
   Title: Web3SafeWallet
   Description: A React and Next.js Safe wallet dashboard block built with shadcn/ui and Tailwind CSS featuring signer list and transaction queue.
   Source: original/blocks/web3/web3-safe-wallet.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Safe Wallet</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                2 of 4
            </BadgeCn>
        </div>

        @* Balance row *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-mono text-muted-foreground text-xs">eth:0x1a2b...c3d4</p>
                    <p class="mt-0.5 font-semibold text-2xl tabular-nums">$2,450,000</p>
                </div>
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Send
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                        Receive
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Info rows *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Threshold</span>
                <span>2 of 4 signers required</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Network</span>
                <span>Ethereum</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Nonce</span>
                <span class="font-mono tabular-nums">47</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Pending Transactions</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                    3 queued
                </BadgeCn>
            </div>
        </div>

        @* Signers list *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Signers</span>
            </div>
            @for (int i = 0; i < _signers.Length; i++)
            {
                var signer = _signers[i];
                var isLast = i == _signers.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="flex size-7 items-center justify-center rounded-full bg-muted/50">
                        <LucideIconCn Name="key" Size="12" Class="size-3 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@signer.Label</span>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">@signer.Address</p>
                    </div>
                    <span class="text-muted-foreground text-xs shrink-0">@signer.LastActive</span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Signer(string Address, string Label, string LastActive);

    private static readonly Signer[] _signers =
    [
        new("0x7a25...f3e8", "Alice (You)", "2 hours ago"),
        new("0x3b91...a2c7", "Bob",         "1 day ago"),
        new("0x9e12...d4b6", "Carol",       "3 days ago"),
        new("0x4f8c...e1a9", "Dan",         "1 week ago"),
    ];
}
