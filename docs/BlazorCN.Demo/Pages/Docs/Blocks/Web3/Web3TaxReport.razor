@* ============================================================
   Block: web3-tax-report
   Title: Web3TaxReport
   Description: A React and Next.js crypto tax report block built with shadcn/ui and Tailwind CSS with capital gains summary, taxable events, and export options.
   Source: original/blocks/web3/web3-tax-report.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file-spreadsheet" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Tax Report</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                2026 YTD
            </BadgeCn>
        </div>

        @* Gains / Losses / Net P&L summary *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Gains</p>
                <p class="mt-0.5 font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">+$7,102</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Losses</p>
                <p class="mt-0.5 font-semibold tabular-nums text-red-600 dark:text-red-400">-$1,500</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Net P&amp;L</p>
                <p class="mt-0.5 font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">+$5,602</p>
            </div>
        </div>

        @* Short-term / Long-term gains *@
        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Short-Term Gains</p>
                <p class="mt-0.5 font-semibold tabular-nums">$300</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Long-Term Gains</p>
                <p class="mt-0.5 font-semibold tabular-nums">$5,302</p>
            </div>
        </div>

        @* Taxable events table *@
        <div>
            <div class="grid grid-cols-[auto_auto_1fr_auto_auto] items-center gap-x-3 border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Date</span>
                <span class="text-xs font-medium text-muted-foreground">Type</span>
                <span class="text-xs font-medium text-muted-foreground">Asset</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Gain/Loss</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Term</span>
            </div>
            @for (int i = 0; i < _events.Length; i++)
            {
                var ev = _events[i];
                var isLast = i == _events.Length - 1;
                <div class="@Cn.Merge("grid grid-cols-[auto_auto_1fr_auto_auto] items-center gap-x-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="text-muted-foreground text-xs">@ev.Date</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@ev.Type</BadgeCn>
                    <span class="font-mono text-xs">@ev.Asset</span>
                    <span class="@Cn.Merge("text-right font-mono text-xs tabular-nums", ev.Positive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                        @ev.GainLoss
                    </span>
                    <span class="text-right text-xs text-muted-foreground capitalize">@ev.Term</span>
                </div>
            }
        </div>

        @* Export buttons *@
        <div class="border-t px-4 py-3 flex items-center gap-2">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="download" Size="12" Class="size-3" />
                Export CSV
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="download" Size="12" Class="size-3" />
                Export PDF
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record TaxEvent(string Date, string Type, string Asset, string Proceeds, string CostBasis, string GainLoss, bool Positive, string Term);

    private static readonly TaxEvent[] _events =
    [
        new("Mar 12", "Sell",     "1.5 ETH",         "$5,402",  "$4,800",  "+$602",    true,  "long"),
        new("Mar 8",  "Swap",     "0.5 BTC → ETH",   "$33,300", "$31,500", "+$1,800",  true,  "short"),
        new("Feb 28", "Sell",     "10,000 USDC",     "$10,000", "$10,000", "$0",        true,  "short"),
        new("Feb 15", "Sell",     "100 SOL",         "$14,700", "$16,200", "-$1,500",  false, "short"),
        new("Jan 20", "NFT Sale", "Cosmic Ape #42",  "$8,200",  "$3,500",  "+$4,700",  true,  "long"),
    ];
}
