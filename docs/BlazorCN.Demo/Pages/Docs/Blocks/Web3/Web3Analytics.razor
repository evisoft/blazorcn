@* ============================================================
   Block: web3-analytics
   Title: Web3Analytics
   Description: React wallet analytics block for Next.js with protocol usage, transaction stats, and volume breakdown using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/web3-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Wallet Analytics</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                All time
            </BadgeCn>
        </div>

        @* Stats grid *@
        <div class="grid grid-cols-4 border-b">
            @for (int i = 0; i < _stats.Length; i++)
            {
                var stat = _stats[i];
                var idx = i;
                <div class="@Cn.Merge("px-4 py-3", idx < 3 ? "border-r" : "")">
                    <p class="text-muted-foreground text-xs">@stat.Label</p>
                    <p class="mt-0.5 font-semibold tabular-nums text-sm">@stat.Value</p>
                </div>
            }
        </div>

        @* Protocol usage bar *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Protocol Usage</span>
            <div class="mt-2 flex h-3 overflow-hidden rounded-full">
                @for (int i = 0; i < _protocols.Length; i++)
                {
                    var proto = _protocols[i];
                    var colorClass = _protocolColors[i];
                    <div class="@colorClass" style="@($"width:{proto.Percentage}%")"></div>
                }
            </div>
        </div>

        @* Protocol rows *@
        <div>
            @for (int i = 0; i < _protocols.Length; i++)
            {
                var proto = _protocols[i];
                var isLast = i == _protocols.Length - 1;
                var dotColor = _protocolColors[i];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-2 shrink-0 rounded-full", dotColor)"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@proto.Protocol</span>
                    </div>
                    <span class="font-mono text-muted-foreground text-xs tabular-nums">@proto.Transactions txns</span>
                    <span class="font-mono text-xs tabular-nums w-16 text-right">@proto.Volume</span>
                    <span class="text-muted-foreground text-xs tabular-nums w-8 text-right">@proto.Percentage%</span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ProtocolUsage(string Protocol, int Transactions, string Volume, int Percentage);
    private record ActivityStat(string Label, string Value);

    private static readonly ProtocolUsage[] _protocols =
    [
        new("Uniswap",  142, "$284K", 35),
        new("Aave",      48, "$180K", 22),
        new("Lido",      12, "$115K", 14),
        new("OpenSea",   85,  "$98K", 12),
        new("Curve",     32,  "$72K",  9),
        new("Other",     67,  "$65K",  8),
    ];

    private static readonly string[] _protocolColors =
    [
        "bg-blue-500",
        "bg-purple-500",
        "bg-amber-500",
        "bg-emerald-500",
        "bg-cyan-500",
        "bg-rose-500",
    ];

    private static readonly ActivityStat[] _stats =
    [
        new("Total Transactions", "1,248"),
        new("Unique Protocols",   "18"),
        new("Active Days",        "342"),
        new("First Transaction",  "Sep 2023"),
    ];
}
