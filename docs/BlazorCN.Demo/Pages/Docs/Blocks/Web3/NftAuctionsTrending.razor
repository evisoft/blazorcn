@* ============================================================
   Block: nft-auctions-trending
   Title: NftAuctionsTrending
   Description: React NFT auctions grid block for Next.js with category filters, time period selectors, bid tracking, and creator badges using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/nft-auctions-trending.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="flame" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <h2 class="text-sm font-medium">Trending Auctions</h2>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            @_filtered.Length auctions · @_filtered.Sum(a => a.BidCount) bids
                        </p>
                    </div>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-[10px]">
                    Last 24h
                </BadgeCn>
            </div>
        </div>

        @* Filters *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <div class="relative flex-1">
                <LucideIconCn Name="search" Size="14" Class="absolute left-2.5 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Class="h-8 border-0 bg-transparent pl-8 text-xs shadow-none focus-visible:ring-0"
                         Placeholder="Search auctions..."
                         @bind-Value="_search" />
            </div>
            <div class="flex gap-1">
                @foreach (var cat in _categories)
                {
                    var category = cat;
                    <button type="button"
                            @onclick="@(() => _filter = category)"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs font-medium transition-colors", _filter == category ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @category
                    </button>
                }
            </div>
        </div>

        @* Grid *@
        <div class="grid grid-cols-1 gap-px bg-border sm:grid-cols-2 lg:grid-cols-3">
            @foreach (var auction in _filtered)
            {
                <div class="bg-card">
                    @* Image *@
                    <div class="relative aspect-square overflow-hidden">
                        <img src="@auction.Image" alt="@auction.Title" class="size-full object-cover" />
                        <div class="absolute top-2.5 left-2.5">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 bg-black/50 text-[10px] text-white backdrop-blur-sm">
                                <LucideIconCn Name="timer" Size="12" Class="size-3" />
                                @auction.TimeLeft
                            </BadgeCn>
                        </div>
                        <div class="absolute right-2.5 bottom-2.5">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="bg-black/50 text-[10px] text-white backdrop-blur-sm">
                                @auction.Category
                            </BadgeCn>
                        </div>
                    </div>

                    @* Info *@
                    <div class="px-3 py-2.5">
                        <div class="flex items-center justify-between">
                            <div class="min-w-0 flex-1">
                                <p class="truncate text-sm font-medium">@auction.Title</p>
                                <p class="text-[10px] text-muted-foreground">@auction.Collection</p>
                            </div>
                            <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                <LucideIconCn Name="users" Size="12" Class="size-3" />
                                <span class="tabular-nums">@auction.BidCount</span>
                            </span>
                        </div>

                        <div class="mt-2 flex items-center justify-between border-t pt-2">
                            <div class="flex items-center gap-1.5">
                                <AvatarCn Class="size-4">
                                    <AvatarImageCn Src="@auction.Creator.Avatar" Alt="@auction.Creator.Name" />
                                    <AvatarFallbackCn Class="text-[7px]">
                                        @auction.Creator.Name.Substring(0, Math.Min(2, auction.Creator.Name.Length)).ToUpper()
                                    </AvatarFallbackCn>
                                </AvatarCn>
                                <span class="text-[10px] text-muted-foreground">
                                    @auction.Creator.Name
                                </span>
                                @if (auction.Creator.Verified)
                                {
                                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                                }
                            </div>
                            <p class="text-xs font-semibold tabular-nums">@auction.CurrentBid ETH</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Empty state *@
        @if (_filtered.Length == 0)
        {
            <div class="px-4 py-8 text-center text-xs text-muted-foreground">
                No auctions found
            </div>
        }
    </div>
</section>

@code {
    private record AuctionCreator(string Name, string Avatar, bool Verified);
    private record AuctionItem(string Id, string Title, string Collection, string Image, AuctionCreator Creator, string CurrentBid, int BidCount, string TimeLeft, string Category);

    private static readonly string[] _categories = ["All", "Art", "Photography", "Generative", "PFP", "Music"];

    private static readonly AuctionItem[] _auctions =
    [
        new("1", "Solar Flare #218", "Solar Flares",
            "https://images.unsplash.com/photo-1634986666676-ec8fd927c23d?w=400&h=400&fit=crop",
            new AuctionCreator("solarcraft.eth", "", true),
            "4.12", 31, "1h 22m", "Art"),
        new("2", "Urban Lens #044", "Urban Lens",
            "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=400&h=400&fit=crop",
            new AuctionCreator("urbanshot.eth", "", true),
            "1.85", 12, "3h 47m", "Photography"),
        new("3", "Fractal Mind #901", "Fractal Minds",
            "https://images.unsplash.com/photo-1635322966219-b75ed372eb01?w=400&h=400&fit=crop",
            new AuctionCreator("fractalai.eth", "", false),
            "0.94", 7, "8h 15m", "Generative"),
        new("4", "Pixel Punk #3371", "Pixel Punks",
            "https://images.unsplash.com/photo-1620641788421-7a1c342ea42e?w=400&h=400&fit=crop",
            new AuctionCreator("pixelking.eth", "", true),
            "6.50", 44, "28m", "PFP"),
        new("5", "Ambient Wave #012", "Ambient Waves",
            "https://images.unsplash.com/photo-1633412802994-5c058f151b66?w=400&h=400&fit=crop",
            new AuctionCreator("soundscape.eth", "", true),
            "0.55", 3, "14h 02m", "Music"),
        new("6", "Ethereal Bloom #177", "Ethereal Blooms",
            "https://images.unsplash.com/photo-1614850523296-d8c1af93d400?w=400&h=400&fit=crop",
            new AuctionCreator("bloomart.eth", "", false),
            "1.30", 8, "6h 33m", "Art"),
    ];

    private string _filter = "All";
    private string _search = "";

    private AuctionItem[] _filtered => _auctions
        .Where(a => _filter == "All" || a.Category == _filter)
        .Where(a => a.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    a.Creator.Name.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToArray();
}
