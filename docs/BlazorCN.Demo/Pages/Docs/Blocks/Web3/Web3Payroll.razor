@* ============================================================
   Block: web3-payroll
   Title: Web3Payroll
   Description: A React crypto payroll block built with Next.js, shadcn/ui, and Tailwind CSS featuring batch payments and scheduling.
   Source: original/blocks/web3/web3-payroll.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="banknote" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Payroll</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                March 2026
            </BadgeCn>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total</p>
                <p class="mt-0.5 font-semibold tabular-nums">@_totalPayroll</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Recipients</p>
                <p class="mt-0.5 font-semibold tabular-nums">@_payroll.Length</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Pay Date</p>
                <p class="mt-0.5 font-medium text-sm">Apr 1, 2026</p>
            </div>
        </div>

        <div>
            @for (int i = 0; i < _payroll.Length; i++)
            {
                var entry = _payroll[i];
                var isLast = i == _payroll.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@entry.Name</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @entry.Role
                            </BadgeCn>
                        </div>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">@entry.Wallet</p>
                    </div>
                    <span class="font-mono text-sm tabular-nums shrink-0">
                        @entry.Amount @entry.Token
                    </span>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <ButtonCn Class="h-9 w-full text-sm"
                      OnClick="@(() => _executed = true)"
                      Disabled="@_executed">
                @(_executed ? "Payroll Executed" : $"Execute Payroll ({_totalPayroll})")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record PayrollEntry(string Id, string Name, string Role, string Wallet, string Amount, string Token);

    private const string _totalPayroll = "$29,500";

    private static readonly PayrollEntry[] _payroll =
    [
        new("1", "Alice Chen",  "Lead Developer",      "0x7a25...f3e8", "8,000", "USDC"),
        new("2", "Bob Smith",   "Smart Contract Dev",  "0x3b91...a2c7", "7,000", "USDC"),
        new("3", "Carol Wang",  "Designer",            "0x9e12...d4b6", "5,500", "USDC"),
        new("4", "Dan Park",    "Community Manager",   "0x4f8c...e1a9", "4,000", "USDC"),
        new("5", "Eve Torres",  "Marketing Lead",      "0x6d03...b7f2", "5,000", "USDC"),
    ];

    private bool _executed = false;
}
