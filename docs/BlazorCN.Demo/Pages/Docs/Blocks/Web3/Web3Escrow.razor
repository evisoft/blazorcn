@* ============================================================
   Block: web3-escrow
   Title: Web3Escrow
   Description: A React and Next.js crypto escrow block built with shadcn/ui and Tailwind CSS for milestone tracking and fund release controls.
   Source: original/blocks/web3/web3-escrow.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="lock" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Escrow</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                <span class="mr-1.5 inline-block size-1.5 rounded-full bg-amber-500"></span>
                In Progress
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Buyer</span>
                <span class="font-mono">0x7a25...f3e8</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Seller</span>
                <span class="font-mono">0x3b91...a2c7</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Arbiter</span>
                <span class="font-mono">0x9e12...d4b6</span>
            </div>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total</p>
                <p class="mt-0.5 font-semibold tabular-nums text-sm">10,000 USDC</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Released</p>
                <p class="mt-0.5 font-semibold tabular-nums text-sm text-emerald-600 dark:text-emerald-400">2,000 USDC</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">In Escrow</p>
                <p class="mt-0.5 font-semibold tabular-nums text-sm">8,000 USDC</p>
            </div>
        </div>

        <div class="border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">Milestones</span>
        </div>

        <div>
            @foreach (var m in _milestones)
            {
                var ms = m;
                var isLast = ms.Id == _milestones[_milestones.Length - 1].Id;
                var isReleased = _releasedIds.Contains(ms.Id);
                var dotClass = isReleased ? "bg-emerald-500" : StatusDotClass(ms.Status);
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-2 shrink-0 rounded-full", dotClass)"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@ms.Title</span>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs tabular-nums">@ms.Amount</p>
                    </div>
                    @if (isReleased)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            Released
                        </BadgeCn>
                    }
                    else if (ms.Status == "pending")
                    {
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" @onclick="@(() => HandleRelease(ms.Id))">
                            Release
                        </ButtonCn>
                    }
                    else
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs text-muted-foreground">
                            Locked
                        </BadgeCn>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private List<string> _releasedIds = new() { "1" };

    private record Milestone(string Id, string Title, string Amount, string Status);

    private static readonly Milestone[] _milestones =
    [
        new("1", "Project kickoff & architecture",  "2,000 USDC", "released"),
        new("2", "Smart contract development",       "5,000 USDC", "pending"),
        new("3", "Testing & security audit",         "2,000 USDC", "locked"),
        new("4", "Deployment & documentation",       "1,000 USDC", "locked"),
    ];

    private static string StatusDotClass(string status) => status switch
    {
        "released" => "bg-emerald-500",
        "pending"  => "bg-amber-500",
        "locked"   => "bg-muted-foreground/30",
        _          => ""
    };

    private void HandleRelease(string id)
    {
        if (!_releasedIds.Contains(id))
            _releasedIds.Add(id);
    }
}
