@* ============================================================
   Block: web3-ico-countdown
   Title: Web3IcoCountdown
   Description: A React and Next.js ICO countdown timer block built with shadcn/ui and Tailwind CSS. Displays funding progress and contribution tiers.
   Source: original/blocks/web3/web3-ico-countdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Token Sale</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                <span class="mr-1.5 inline-block size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                Live
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-center gap-1 mb-1">
                <LucideIconCn Name="timer" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Sale ends in</span>
            </div>
            <div class="grid grid-cols-4 gap-3">
                @foreach (var unit in _countdown)
                {
                    <div class="text-center">
                        <p class="font-semibold text-2xl tabular-nums">@unit.Value</p>
                        <p class="text-muted-foreground text-xs">@unit.Label</p>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs mb-2">
                <span class="text-muted-foreground">Raised</span>
                <span class="tabular-nums">$@_raised / $@_goal</span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-blue-500" style="@($"width:{_progress}%")"></div>
            </div>
            <div class="mt-2 flex items-center justify-between text-xs">
                <span class="text-muted-foreground tabular-nums">@_progress% funded</span>
                <span class="text-muted-foreground">Token price: $0.085</span>
            </div>
        </div>

        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Tiers</span>
            </div>
            @foreach (var (tier, index) in _tiers.Select((t, i) => (t, i)))
            {
                var isLast = index == _tiers.Length - 1;
                var soldOut = tier.Remaining == "Sold out";
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@tier.Name</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                                +@tier.Bonus
                            </BadgeCn>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">Min: @tier.Min</p>
                    </div>
                    <span class="@Cn.Merge("text-xs", soldOut ? "text-muted-foreground" : "tabular-nums")">
                        @tier.Remaining
                    </span>
                </div>
            }
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="h-9 w-full text-sm">Contribute</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record CountdownUnit(string Label, string Value);

    private static readonly CountdownUnit[] _countdown =
    [
        new("Days",    "04"),
        new("Hours",   "12"),
        new("Minutes", "37"),
        new("Seconds", "52"),
    ];

    private const string _raised = "1,840,000";
    private const string _goal   = "3,000,000";
    private const int _progress  = 61; // Math.Round((1_840_000 / 3_000_000.0) * 100)

    private record Tier(string Name, string Min, string Bonus, string Remaining);

    private static readonly Tier[] _tiers =
    [
        new("Early Bird", "0.1 ETH", "25%", "Sold out"),
        new("Standard",   "0.5 ETH", "15%", "412 slots"),
        new("Whale",      "5 ETH",   "10%", "89 slots"),
    ];
}
