@* ============================================================
   Block: web3-airdrop-claim
   Title: Web3AirdropClaim
   Description: React airdrop claim block for Next.js with eligibility status, allocation breakdown, and vesting details using shadcn/ui and Tailwind CSS
   Source: original/blocks/web3/web3-airdrop-claim.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="gift" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Airdrop Claim</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                <span class="mr-1.5 inline-block size-1.5 rounded-full bg-emerald-500"></span>
                Eligible
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-4 text-center">
            <p class="text-muted-foreground text-xs">Your Allocation</p>
            <p class="mt-1 font-semibold text-2xl tabular-nums">@_totalClaimable</p>
            <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">~@_estimatedValue</p>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Breakdown</span>
            <div class="mt-2 space-y-2">
                @foreach (var item in _allocations)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span>@item.Reason</span>
                        <span class="font-mono tabular-nums">@item.Amount</span>
                    </div>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Vesting</span>
                <span>25% at claim, 75% over 6 months</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Claim deadline</span>
                <span>90 days remaining</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Gas estimate</span>
                <span class="tabular-nums">~$3.50</span>
            </div>
        </div>

        <div class="px-4 py-3">
            @if (_claimed)
            {
                <div class="flex items-center justify-center gap-2 py-2">
                    <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                    <span class="text-sm font-medium text-emerald-600 dark:text-emerald-400">
                        Claimed successfully
                    </span>
                </div>
            }
            else
            {
                <ButtonCn Class="h-9 w-full text-sm" @onclick="@(() => _claimed = true)">
                    Claim @_totalClaimable
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private bool _claimed = false;

    private const string _totalClaimable = "5,000 PROTO";
    private const string _estimatedValue = "$4,250.00";

    private record AllocationItem(string Reason, string Amount);

    private static readonly AllocationItem[] _allocations =
    [
        new("Early adopter bonus",      "2,500 PROTO"),
        new("Governance participation", "1,200 PROTO"),
        new("Liquidity provision",      "800 PROTO"),
        new("Bug bounty reward",        "500 PROTO"),
    ];
}
