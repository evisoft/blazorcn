@* ============================================================
   Block: web3-defi-dashboard
   Title: Web3DefiDashboard
   Description: A React DeFi portfolio dashboard block built with Next.js, shadcn/ui, and Tailwind CSS showing TVL, positions, and yield summary.
   Source: original/blocks/web3/web3-defi-dashboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layout-dashboard" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">DeFi Dashboard</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_positions.Length positions
            </BadgeCn>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Value</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums">@_totalValue</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Avg. APY</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums text-emerald-600 dark:text-emerald-400">@_avgApy</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Monthly Yield</p>
                <p class="mt-0.5 font-semibold text-lg tabular-nums">@_totalYield</p>
            </div>
        </div>

        <div>
            <div class="grid grid-cols-[1fr_auto_auto_auto_auto] items-center gap-x-3 border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Protocol</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Type</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Value</span>
                <span class="text-xs font-medium text-muted-foreground text-right">APY</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Rewards</span>
            </div>
            @foreach (var pos in _positions)
            {
                var isLast = pos == _positions[_positions.Length - 1];
                <div class="@Cn.Merge("grid grid-cols-[1fr_auto_auto_auto_auto] items-center gap-x-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div>
                        <span class="font-medium text-sm">@pos.Protocol</span>
                        <p class="mt-0.5 font-mono text-muted-foreground text-xs">@pos.Asset</p>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @pos.Type
                    </BadgeCn>
                    <span class="text-right font-mono text-xs tabular-nums">@pos.Value</span>
                    <span class="text-right font-mono text-xs tabular-nums text-emerald-600 dark:text-emerald-400">@pos.Apy</span>
                    <span class="text-right font-mono text-xs tabular-nums text-muted-foreground">@pos.Rewards</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record DefiPosition(string Protocol, string Type, string Asset, string Value, string Apy, string Rewards);

    private static readonly DefiPosition[] _positions =
    [
        new("Aave",       "Lending",   "USDC",     "$45,200",  "3.8%", "$143/mo"),
        new("Lido",       "Staking",   "stETH",    "$115,240", "4.2%", "$403/mo"),
        new("Uniswap V3", "Liquidity", "ETH/USDC", "$28,500",  "12.4%","$294/mo"),
        new("Curve",      "Liquidity", "3pool",    "$18,600",  "5.1%", "$79/mo"),
        new("Compound",   "Lending",   "DAI",      "$12,000",  "3.2%", "$32/mo"),
    ];

    private const string _totalValue = "$219,540";
    private const string _totalYield = "$951/mo";
    private const string _avgApy    = "5.7%";
}
