@* ============================================================
   Block: web3-token-portfolio
   Title: Web3TokenPortfolio
   Description: A React and Next.js token portfolio block built with shadcn/ui and Tailwind CSS featuring allocation breakdown and P/L tracking.
   Source: original/blocks/web3/web3-token-portfolio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Portfolio</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_holdings.Length tokens
            </BadgeCn>
        </div>

        @* Total value / P/L summary *@
        <div class="border-b px-4 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-muted-foreground text-xs">Total Value</p>
                    <p class="mt-0.5 font-semibold text-2xl tabular-nums">@_totalValue</p>
                </div>
                <div class="text-right">
                    <p class="text-muted-foreground text-xs">All-time P/L</p>
                    <p class="mt-0.5 font-medium text-sm tabular-nums text-emerald-600 dark:text-emerald-400">
                        @_totalPnl
                    </p>
                </div>
            </div>
            <div class="mt-2 flex items-center gap-2">
                <span class="@Cn.Merge("flex items-center gap-0.5 text-xs tabular-nums", _totalChange >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                    @if (_totalChange >= 0)
                    {
                        <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                    }
                    else
                    {
                        <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                    }
                    @(Math.Abs(_totalChange))% today
                </span>
            </div>
        </div>

        @* Allocation bar *@
        <div class="border-b px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Allocation</p>
            <div class="flex h-2 overflow-hidden rounded-full">
                @for (int i = 0; i < _holdings.Length; i++)
                {
                    var token = _holdings[i];
                    var color = _allocationColors[i % _allocationColors.Length];
                    <div class="@color" style="@($"width:{token.Allocation}%")"></div>
                }
            </div>
            <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
                @for (int i = 0; i < _holdings.Length; i++)
                {
                    var token = _holdings[i];
                    var dotColor = _allocationColors[i % _allocationColors.Length];
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", dotColor)"></span>
                        @token.Symbol @token.Allocation%
                    </span>
                }
            </div>
        </div>

        @* Holdings list *@
        <div>
            @for (int i = 0; i < _holdings.Length; i++)
            {
                var token = _holdings[i];
                var isLast = i == _holdings.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted/50">
                        <span class="font-mono font-medium text-xs">@(token.Symbol.Length > 2 ? token.Symbol.Substring(0, 2) : token.Symbol)</span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@token.Name</span>
                        <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">
                            @token.Amount @token.Symbol
                        </p>
                    </div>
                    <div class="text-right">
                        <span class="font-medium text-sm tabular-nums">@token.Value</span>
                        <p class="@Cn.Merge("mt-0.5 text-xs tabular-nums", token.PnlPercent >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                            @token.Pnl (@(token.PnlPercent > 0 ? "+" : "")@(token.PnlPercent)%)
                        </p>
                    </div>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record TokenHolding(string Symbol, string Name, string Amount, string Value, int Allocation, double Change24h, string AvgBuy, string Pnl, double PnlPercent);

    private static readonly TokenHolding[] _holdings =
    [
        new("ETH",  "Ethereum", "4.2851",   "$15,426.36", 37,  2.34, "$3,200.00", "+$1,706.36",  12.4),
        new("BTC",  "Bitcoin",  "0.1823",   "$12,108.42", 29, -1.12, "$58,200.00", "+$1,518.42", 14.3),
        new("USDC", "USD Coin", "5,230.00", "$5,230.00",  13,  0.01, "$1.00",      "$0.00",        0.0),
        new("ARB",  "Arbitrum", "3,412.50", "$4,081.13",  10,  5.67, "$0.92",      "+$942.63",    30.1),
        new("LINK", "Chainlink","215.00",   "$3,225.00",   8, -0.45, "$18.20",     "-$688.00",   -17.6),
        new("UNI",  "Uniswap",  "180.25",   "$1,622.25",   3,  3.21, "$12.50",     "-$628.88",   -27.9),
    ];

    private static readonly string[] _allocationColors =
    [
        "bg-blue-500",
        "bg-amber-500",
        "bg-emerald-500",
        "bg-purple-500",
        "bg-red-500",
        "bg-cyan-500",
    ];

    private const string _totalValue = "$41,693.16";
    private const double _totalChange = 1.87;
    private const string _totalPnl = "+$2,850.53";
}
