@* ============================================================
   Block: web3-dex-aggregator
   Title: Web3DexAggregator
   Description: A React and Next.js DEX aggregator built with shadcn/ui and Tailwind CSS comparing swap rates across decentralized exchanges.
   Source: original/blocks/web3/web3-dex-aggregator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="arrow-right-left" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">DEX Aggregator</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                5 DEXs compared
            </BadgeCn>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Swapping</span>
                <span class="font-mono tabular-nums">1.0 ETH → USDC</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Best output</span>
                <span class="font-mono font-medium tabular-nums">3,608.42 USDC</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Savings vs worst</span>
                <span class="tabular-nums text-emerald-600 dark:text-emerald-400">+$9.52</span>
            </div>
        </div>

        <div>
            <div class="grid grid-cols-[1fr_auto_auto_auto] items-center gap-x-3 border-b px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">DEX</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Output</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Gas</span>
                <span class="text-xs font-medium text-muted-foreground text-right">Diff</span>
            </div>
            @foreach (var q in _quotes)
            {
                var isLast = q.Dex == _quotes[_quotes.Length - 1].Dex;
                <div class="@Cn.Merge("grid grid-cols-[1fr_auto_auto_auto] items-center gap-x-3 px-4 py-2.5", isLast ? "" : "border-b", q.Best ? "bg-emerald-500/5" : "")">
                    <div class="flex items-center gap-2">
                        @if (q.Best)
                        {
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                        }
                        <span class="@Cn.Merge("text-sm", q.Best ? "font-medium" : "")">@q.Dex</span>
                    </div>
                    <span class="font-mono text-xs tabular-nums text-right">@q.Output</span>
                    <span class="font-mono text-xs tabular-nums text-right text-muted-foreground">@q.Gas</span>
                    <span class="@Cn.Merge("text-right text-xs tabular-nums", q.Best ? "text-emerald-600 dark:text-emerald-400 font-medium" : "text-muted-foreground")">@q.Savings</span>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <ButtonCn Class="h-9 w-full text-sm">Swap via Uniswap V3</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record DexQuote(string Dex, string Output, string Gas, string Savings, bool Best);

    private static readonly DexQuote[] _quotes =
    [
        new("Uniswap V3", "3,608.42 USDC", "$4.23", "Best rate", true),
        new("Curve",      "3,604.18 USDC", "$3.85", "-$4.24",    false),
        new("SushiSwap",  "3,601.55 USDC", "$4.12", "-$6.87",    false),
        new("Balancer",   "3,598.90 USDC", "$5.10", "-$9.52",    false),
        new("1inch",      "3,607.80 USDC", "$4.45", "-$0.62",    false),
    ];
}
