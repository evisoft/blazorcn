@* ============================================================
   Block: web3-rewards-calculator
   Title: Web3RewardsCalculator
   Description: A React and Next.js staking rewards calculator block built with shadcn/ui and Tailwind CSS. Features token selection and earnings projection.
   Source: original/blocks/web3/web3-rewards-calculator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calculator" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Rewards Calculator</span>
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Token</span>
            <div class="mt-1.5 flex items-center gap-1.5">
                @foreach (var t in _tokens)
                {
                    var tok = t;
                    <ButtonCn Variant="@((_selectedToken == tok.Symbol) ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 text-xs flex-1" @onclick="@(() => _selectedToken = tok.Symbol)">
                        @tok.Symbol
                    </ButtonCn>
                }
            </div>
            <p class="mt-1.5 text-muted-foreground text-xs">
                APY: <span class="tabular-nums text-emerald-600 dark:text-emerald-400">@CurrentToken.Apy%</span>
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Amount (@_selectedToken)</span>
            <InputCn @bind-Value="_amount" Class="mt-1.5 h-9 font-mono text-sm tabular-nums" Placeholder="0.0" />
            <p class="mt-1 text-muted-foreground text-xs tabular-nums">~$@StakeValue.ToString("N2")</p>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Duration</span>
            <div class="mt-1.5 flex items-center gap-1.5">
                @foreach (var d in _durations)
                {
                    var dur = d;
                    <ButtonCn Variant="@((_duration == dur) ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 text-xs flex-1" @onclick="@(() => _duration = dur)">
                        @dur
                    </ButtonCn>
                }
            </div>
        </div>

        <div class="px-4 py-4">
            <span class="text-xs font-medium text-muted-foreground">Projected Rewards</span>
            <div class="mt-3 rounded-md bg-muted/50 p-4 text-center">
                <p class="font-semibold text-2xl tabular-nums">+@RewardTokens.ToString("F4") @_selectedToken</p>
                <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">~$@TotalReward.ToString("N2")</p>
            </div>
            <div class="mt-3 space-y-1.5">
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Daily earnings</span>
                    <span class="tabular-nums">@DailyEarnings.ToString("F6") @_selectedToken</span>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">Monthly earnings</span>
                    <span class="tabular-nums">@MonthlyEarnings.ToString("F4") @_selectedToken</span>
                </div>
                <div class="flex items-center justify-between text-xs">
                    <span class="text-muted-foreground">After @_duration</span>
                    <span class="font-medium tabular-nums">@TotalAfter.ToString("F4") @_selectedToken</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _selectedToken = "ETH";
    private string _amount = "10";
    private string _duration = "1 year";

    private record TokenOption(string Symbol, double Apy, double Price);

    private static readonly TokenOption[] _tokens =
    [
        new("ETH",   4.2,  3601.25),
        new("SOL",   7.1,   147.0),
        new("ATOM", 18.2,     8.9),
        new("MATIC", 5.8,     0.89),
    ];

    private static readonly string[] _durations = ["30 days", "90 days", "1 year", "2 years"];

    private TokenOption CurrentToken =>
        Array.Find(_tokens, t => t.Symbol == _selectedToken) ?? _tokens[0];

    private double ParsedAmount =>
        double.TryParse(_amount, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0;

    private double StakeValue => ParsedAmount * CurrentToken.Price;

    private int DurationDays => _duration switch
    {
        "30 days"  => 30,
        "90 days"  => 90,
        "1 year"   => 365,
        _          => 730,
    };

    private double DailyRate => CurrentToken.Apy / 365.0 / 100.0;
    private double TotalReward => StakeValue * DailyRate * DurationDays;
    private double RewardTokens => ParsedAmount * DailyRate * DurationDays;
    private double DailyEarnings => DurationDays > 0 ? RewardTokens / DurationDays : 0;
    private double MonthlyEarnings => DailyEarnings * 30;
    private double TotalAfter => ParsedAmount + RewardTokens;
}
