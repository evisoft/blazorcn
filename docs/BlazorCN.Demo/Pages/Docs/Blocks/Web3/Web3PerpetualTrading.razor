@* ============================================================
   Block: web3-perpetual-trading
   Title: Web3PerpetualTrading
   Description: A React perpetual trading block built with Next.js, shadcn/ui, and Tailwind CSS featuring leverage and margin controls.
   Source: original/blocks/web3/web3-perpetual-trading.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trending-up" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">ETH-PERP</span>
            </div>
            <span class="font-mono text-sm tabular-nums">$3,601.25</span>
        </div>

        <div class="grid grid-cols-2 border-b">
            <button type="button" @onclick="@(() => _side = "long")"
                class="@Cn.Merge("py-2.5 text-center text-sm transition-colors", _side == "long" ? "bg-emerald-500/10 font-medium text-emerald-600 dark:text-emerald-400" : "text-muted-foreground hover:bg-muted/50")">
                Long
            </button>
            <button type="button" @onclick="@(() => _side = "short")"
                class="@Cn.Merge("border-l py-2.5 text-center text-sm transition-colors", _side == "short" ? "bg-red-500/10 font-medium text-red-600 dark:text-red-400" : "text-muted-foreground hover:bg-muted/50")">
                Short
            </button>
        </div>

        <div class="border-b px-4 py-3">
            <span class="text-muted-foreground text-xs">Leverage</span>
            <div class="mt-1.5 flex items-center gap-1.5">
                @foreach (var lev in _leverageOptions)
                {
                    var l = lev;
                    <ButtonCn Variant="@(_leverage == l ? ButtonVariant.Default : ButtonVariant.Outline)" Size="ButtonSize.Sm" Class="h-7 text-xs flex-1" @onclick="@(() => _leverage = l)">
                        @l
                    </ButtonCn>
                }
            </div>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="text-muted-foreground text-xs">Margin (USDC)</span>
                <span class="text-muted-foreground text-xs tabular-nums">Available: 5,230.00</span>
            </div>
            <InputCn @bind-Value="_margin" Class="mt-1.5 font-mono text-sm tabular-nums" Placeholder="0.00" />
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Position Size</span>
                <span class="font-medium tabular-nums">@PositionSize</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Entry Price</span>
                <span class="tabular-nums">$3,601.25</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Liquidation Price</span>
                <span class="tabular-nums text-red-600 dark:text-red-400">@LiqPrice</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Funding Rate</span>
                <span class="tabular-nums text-emerald-600 dark:text-emerald-400">0.0042%/hr</span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-xs">
                <span class="text-muted-foreground">Trading Fee</span>
                <span class="tabular-nums">0.05%</span>
            </div>
        </div>

        <div class="px-4 py-3">
            <ButtonCn Class="@Cn.Merge("h-9 w-full text-sm", _side == "long" ? "bg-emerald-600 hover:bg-emerald-700 text-white" : "bg-red-600 hover:bg-red-700 text-white")">
                @(_side == "long" ? "Open Long" : "Open Short") @_leverage
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _side = "long";
    private string _leverage = "10x";
    private string _margin = "1000";

    private static readonly string[] _leverageOptions = ["2x", "5x", "10x", "20x", "50x"];

    private string PositionSize
    {
        get
        {
            if (!double.TryParse(_margin, out var m)) m = 0;
            if (!int.TryParse(_leverage.TrimEnd('x'), out var lev)) lev = 1;
            return $"${(m * lev):N0}";
        }
    }

    private string LiqPrice => _side == "long" ? "$3,241.12" : "$3,961.38";
}
