@* ============================================================
   Block: web3-watchlist
   Title: Web3Watchlist
   Description: A React and Next.js token watchlist block built with shadcn/ui components and Tailwind CSS for tracking crypto prices.
   Source: original/blocks/web3/web3-watchlist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="star" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Watchlist</span>
            </div>
            <span class="text-muted-foreground text-xs tabular-nums">@_tokens.Count tokens</span>
        </div>

        <div class="grid grid-cols-[1fr_auto_auto_auto_auto] items-center gap-x-3 border-b px-4 py-2">
            <span class="text-xs font-medium text-muted-foreground">Token</span>
            <span class="text-xs font-medium text-muted-foreground text-right">Price</span>
            <span class="text-xs font-medium text-muted-foreground text-right">24h</span>
            <span class="text-xs font-medium text-muted-foreground text-right">MCap</span>
            <span class="w-6"></span>
        </div>

        <div>
            @for (int i = 0; i < _tokens.Count; i++)
            {
                var token = _tokens[i];
                var isLast = i == _tokens.Count - 1;
                <div class="@Cn.Merge("grid grid-cols-[1fr_auto_auto_auto_auto] items-center gap-x-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">@token.Name</span>
                        <span class="font-mono text-muted-foreground text-xs">@token.Symbol</span>
                    </div>
                    <span class="text-right font-mono text-xs tabular-nums">@token.Price</span>
                    <span class="@Cn.Merge("text-right font-mono text-xs tabular-nums", token.Positive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                        @token.Change
                    </span>
                    <span class="text-right font-mono text-muted-foreground text-xs tabular-nums">@token.MarketCap</span>
                    <button aria-label="Remove @token.Name from watchlist" type="button" @onclick="@(() => RemoveToken(token.Id))"
                            class="flex size-6 items-center justify-center rounded-md text-muted-foreground hover:bg-muted/50 hover:text-foreground transition-colors">
                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                    </button>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record WatchlistToken(string Id, string Name, string Symbol, string Price, string Change, bool Positive, string MarketCap);

    private List<WatchlistToken> _tokens = new List<WatchlistToken>
    {
        new("1", "Ethereum",  "ETH",  "$3,601.25", "+1.67%",  true,  "$433B"),
        new("2", "Bitcoin",   "BTC",  "$66,600",   "+0.82%",  true,  "$1.31T"),
        new("3", "Solana",    "SOL",  "$147.00",   "-2.41%",  false, "$65B"),
        new("4", "Arbitrum",  "ARB",  "$1.82",     "+18.3%",  true,  "$6.8B"),
        new("5", "Chainlink", "LINK", "$18.42",    "+3.12%",  true,  "$10.8B"),
        new("6", "Uniswap",   "UNI",  "$11.50",    "-1.24%",  false, "$6.9B"),
    };

    private void RemoveToken(string id)
    {
        _tokens = _tokens.Where(t => t.Id != id).ToList();
    }
}
