@* ============================================================
   Block: web3-delegations
   Title: Web3Delegations
   Description: A React and Next.js staking delegation manager built with shadcn/ui and Tailwind CSS showing validators, rewards, and redelegate options.
   Source: original/blocks/web3/web3-delegations.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Delegations</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Sm"
                      Class="h-7 text-xs"
                      OnClick="@(() => _claimedAll = true)"
                      Disabled="@_claimedAll">
                @(_claimedAll ? "Claimed" : "Claim All Rewards")
            </ButtonCn>
        </div>

        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Total Staked</p>
                <p class="mt-0.5 font-semibold tabular-nums">@_totalStaked</p>
                <p class="mt-0.5 text-muted-foreground text-xs tabular-nums">@_totalValue</p>
            </div>
            <div class="border-r px-4 py-3">
                <p class="text-muted-foreground text-xs">Pending Rewards</p>
                <p class="mt-0.5 font-semibold tabular-nums">@_totalRewards</p>
            </div>
            <div class="px-4 py-3">
                <p class="text-muted-foreground text-xs">Validators</p>
                <p class="mt-0.5 font-semibold tabular-nums">@_delegations.Length</p>
            </div>
        </div>

        <div>
            @for (int i = 0; i < _delegations.Length; i++)
            {
                var d = _delegations[i];
                var isLast = i == _delegations.Length - 1;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 rounded-full", d.Status == "active" ? "bg-emerald-500" : "bg-amber-500")"></span>
                            <span class="font-medium text-sm">@d.Validator</span>
                            @if (d.Status == "unbonding")
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@d.UnbondTime</BadgeCn>
                            }
                        </div>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">
                            Redelegate
                        </ButtonCn>
                    </div>
                    <div class="mt-2 flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">
                            Staked: <span class="tabular-nums">@d.Staked</span>
                        </span>
                        <span class="tabular-nums">@d.Value</span>
                    </div>
                    <div class="mt-1 flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">
                            Commission: <span class="tabular-nums">@d.Commission</span>
                        </span>
                        <span class="tabular-nums text-emerald-600 dark:text-emerald-400">
                            +@d.Rewards
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Delegation(string Id, string Validator, string Staked, string Value, string Rewards, string Commission, string Status, string UnbondTime = "");

    private static readonly Delegation[] _delegations =
    [
        new("1", "Coinbase Cloud", "500 ATOM", "$4,450",  "12.5 ATOM", "5%", "active"),
        new("2", "Chorus One",     "300 ATOM", "$2,670",  "8.2 ATOM",  "7%", "active"),
        new("3", "Figment",        "200 ATOM", "$1,780",  "5.1 ATOM",  "8%", "active"),
        new("4", "Everstake",      "100 ATOM", "$890",    "0 ATOM",    "5%", "unbonding", "14 days left"),
    ];

    private const string _totalStaked  = "1,100 ATOM";
    private const string _totalRewards = "25.8 ATOM";
    private const string _totalValue   = "$9,790";

    private bool _claimedAll = false;
}
