@* ============================================================
   Block: login-avatar-preview
   Title: Login Avatar Preview
   Description: React login form block for Next.js with dynamic avatar that generates from email input showing first letter initial, email display below avatar, and scale-in animation using shadcn/ui Avatar, Input, Button, Label, Tailwind CSS, and framer-motion
   Long Description: Returning user with avatar greeting
   Dependencies: ButtonCn, InputCn, LabelCn, LucideUserCn
   Source: original/blocks/login/login-avatar-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col items-center px-4 pt-8 pb-4">
            @if (HasEmail)
            {
                <div class="flex flex-col items-center gap-2">
                    <div class="flex size-14 items-center justify-center rounded-full bg-primary text-xl font-semibold text-primary-foreground">
                        @Initial
                    </div>
                    <p class="font-mono text-xs text-muted-foreground">@_email.Trim()</p>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center">
                    <div class="flex size-14 items-center justify-center rounded-full border-2 border-dashed border-muted-foreground/20">
                        <LucideUserCn Size="20" Class="size-5 text-muted-foreground/30" />
                    </div>
                </div>
            }
        </div>

        <div class="border-b" />

        <div class="px-4 py-6">
            <div class="mx-auto max-w-xs space-y-4">
                <div class="space-y-2">
                    <LabelCn For="avatar-email" Class="text-xs text-muted-foreground">
                        Email address
                    </LabelCn>
                    <InputCn id="avatar-email" Type="email" Placeholder="@("you@@company.com")"
                             Class="h-8 text-sm" @bind-Value="_email" />
                </div>

                <div class="space-y-2">
                    <LabelCn For="avatar-password" Class="text-xs text-muted-foreground">
                        Password
                    </LabelCn>
                    <InputCn id="avatar-password" Type="password" Placeholder="Enter your password"
                             Class="h-8 text-sm" />
                </div>

                <ButtonCn Class="h-8 w-full text-xs">Sign in</ButtonCn>

                <div class="text-center">
                    <span class="text-xs text-muted-foreground">
                        No account?
                        <button type="button"
                                class="text-foreground underline-offset-2 hover:underline">
                            Create one
                        </button>
                    </span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _email = "";

    private bool HasEmail => _email.Trim().Length > 0;
    private string Initial => HasEmail ? _email.Trim()[0].ToString().ToUpper() : "";
}
