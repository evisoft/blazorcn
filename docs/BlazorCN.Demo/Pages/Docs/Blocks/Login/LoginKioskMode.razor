@* ============================================================
   Block: login-kiosk-mode
   Title: LoginKioskMode
   Description: Kiosk and shared device login React block for Next.js with session timer, auto-logout warning, quick PIN entry, and privacy mode indicator using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-kiosk-mode.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center gap-2 bg-muted/50 px-4 py-2">
            <LucideIconCn Name="monitor" Size="14" Class="size-3.5 text-muted-foreground" />
            <span class="text-xs font-medium text-muted-foreground">Kiosk Mode</span>
            <span class="ml-auto flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="eye-off" Size="12" Class="size-3" />
                Private session
            </span>
        </div>

        <div class="border-b px-4 py-3 text-center">
            <p class="text-sm font-medium">Enter your PIN to sign in</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Session will auto-expire after 15 minutes
            </p>
        </div>

        <div class="flex flex-col items-center px-4 py-6">
            @* PIN display *@
            <div class="mb-6 flex gap-3">
                @for (var i = 0; i < 4; i++)
                {
                    var idx = i;
                    <div class="@Cn.Merge("flex size-12 items-center justify-center rounded-lg border-2 transition-colors", idx < _pin.Length ? "border-foreground" : "border-muted")">
                        @if (idx < _pin.Length)
                        {
                            <span class="size-3 rounded-full bg-foreground" />
                        }
                    </div>
                }
            </div>

            @* Numpad *@
            <div class="grid w-full max-w-[220px] grid-cols-3 gap-2">
                @foreach (var digit in _digits)
                {
                    var d = digit;
                    <button type="button" @onclick="@(() => HandleDigit(d))"
                            class="flex size-14 items-center justify-center rounded-lg bg-muted/50 font-mono text-lg font-medium transition-colors hover:bg-muted active:scale-95">
                        @d
                    </button>
                }
                <button type="button" @onclick="HandleClear"
                        class="flex size-14 items-center justify-center rounded-lg text-xs text-muted-foreground transition-colors hover:bg-muted">
                    Clear
                </button>
                <button type="button" @onclick="@(() => HandleDigit("0"))"
                        class="flex size-14 items-center justify-center rounded-lg bg-muted/50 font-mono text-lg font-medium transition-colors hover:bg-muted active:scale-95">
                    0
                </button>
                <div class="size-14" />
            </div>

            @if (_pin.Length == 4)
            {
                <div class="mt-4">
                    <ButtonCn Size="ButtonSize.Sm">Sign in</ButtonCn>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="shield" Size="12" Class="size-3" />
                    <span>Data cleared after logout</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                    <span>15 min session limit</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _pin = "";

    private static readonly string[] _digits = ["1", "2", "3", "4", "5", "6", "7", "8", "9"];

    private void HandleDigit(string digit)
    {
        if (_pin.Length < 4)
            _pin += digit;
    }

    private void HandleClear()
    {
        _pin = "";
    }
}
