@code {
    private string _keyValue = """";
    private KeyStatus _keyStatus = KeyStatus.Empty;

    private void HandleKeyChange(string val)
    {
        _keyValue = val;
        var trimmed = val.Trim();
        if (string.IsNullOrEmpty(trimmed))
        {
            _keyStatus = KeyStatus.Empty;
        }
        else if (val.Contains(""BEGIN"") && val.Contains(""KEY""))
        {
            _keyStatus = KeyStatus.Valid;
        }
        else if (val.Length > 10)
        {
            _keyStatus = KeyStatus.Invalid;
        }
        else
        {
            _keyStatus = KeyStatus.Empty;
        }
    }

    private enum KeyStatus { Empty, Valid, Invalid }
}";

