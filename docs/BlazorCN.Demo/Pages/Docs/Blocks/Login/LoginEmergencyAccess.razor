@* ============================================================
   Block: login-emergency-access
   Title: LoginEmergencyAccess
   Description: Emergency break-glass access React authentication block for Next.js with warning banner, emergency code input, reason selection, audit trail notice, and confirmation dialog using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-emergency-access.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="flex items-center gap-2 bg-amber-500/10 px-4 py-2">
      <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-amber-600" />
      <p class="text-xs font-medium text-amber-700 dark:text-amber-500">
        Emergency access is logged and audited
      </p>
    </div>

    <div class="border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="shield-alert" Size="16" Class="size-4 text-muted-foreground" />
        <p class="text-sm font-medium">Emergency Access</p>
      </div>
      <p class="mt-0.5 text-xs text-muted-foreground">
        Use only when standard authentication is unavailable
      </p>
    </div>

    <div class="space-y-4 px-4 py-4">
      <div class="space-y-1.5">
        <LabelCn For="emergency-code" Class="text-xs font-medium text-muted-foreground">
          Emergency access code
        </LabelCn>
        <div class="relative">
          <LucideIconCn Name="key" Size="14" Class="absolute top-1/2 left-3 size-3.5 -translate-y-1/2 text-muted-foreground" />
          <InputCn id="emergency-code" type="password" Placeholder="Enter your break-glass code" Class="pl-9" @bind-Value="_code" />
        </div>
      </div>

      <div class="space-y-1.5">
        <LabelCn Class="text-xs font-medium text-muted-foreground">
          Reason for emergency access
        </LabelCn>
        <div class="space-y-1">
          @foreach (var reason in _reasons)
          {
            var r = reason;
            <label class="@Cn.Merge("flex cursor-pointer items-center gap-2 rounded-md px-3 py-2 text-xs transition-colors", _selectedReason == r ? "bg-muted text-foreground" : "text-muted-foreground hover:bg-muted/50")">
              <input type="radio" name="emergency-reason" class="sr-only" checked="@(_selectedReason == r)" @onchange="@(() => _selectedReason = r)" />
              <span class="@Cn.Merge("flex size-3.5 items-center justify-center rounded-full border", _selectedReason == r ? "border-foreground" : "border-muted-foreground/40")">
                @if (_selectedReason == r)
                {
                  <span class="size-2 rounded-full bg-foreground"></span>
                }
              </span>
              @r
            </label>
          }
        </div>
      </div>

      @if (!_confirmed)
      {
        <div class="rounded-md bg-muted/50 p-3">
          <label class="flex cursor-pointer items-start gap-2">
            <input type="checkbox" class="mt-0.5" checked="@_confirmed" @onchange="@((Microsoft.AspNetCore.Components.ChangeEventArgs e) => _confirmed = e.Value is bool b && b)" />
            <span class="text-xs text-muted-foreground">
              I confirm this is a genuine emergency and understand that this access will be
              audited and reported to administrators.
            </span>
          </label>
        </div>
      }
      else
      {
        <ButtonCn Class="w-full" Variant="ButtonVariant.Destructive" Size="ButtonSize.Sm" Disabled="@(string.IsNullOrEmpty(_code) || string.IsNullOrEmpty(_selectedReason))">
          Activate emergency access
        </ButtonCn>
      }
    </div>

    <div class="border-t px-4 py-3">
      <button type="button" class="text-xs text-muted-foreground transition-colors hover:text-foreground">
        Contact IT administrator instead
      </button>
    </div>
  </div>
</section>

@code {
    private static readonly string[] _reasons =
    [
        "System outage - critical fix required",
        "Account owner unavailable",
        "Security incident response",
        "Compliance audit requirement",
        "Patient/customer emergency",
    ];

    private string _code = "";
    private string _selectedReason = "";
    private bool _confirmed = false;
}
