@* ============================================================
   Block: login-enterprise-sso
   Title: Login Enterprise Sso
   Description: Enterprise single sign-on React login block for Next.js with company domain input, SSO provider discovery showing Okta, Azure AD, and Google Workspace badges, and staggered animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Organization picker before authentication
   Dependencies: ButtonCn, InputCn, LabelCn, LucideGlobeCn, LucideShieldCn
   Source: original/blocks/login/login-enterprise-sso.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Single Sign-On</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Enter your work email to find your company's SSO provider
            </p>
        </div>

        <div class="px-4 py-4">
            <div class="space-y-2">
                <LabelCn For="sso-work-email" Class="text-xs font-medium text-muted-foreground">
                    Work email
                </LabelCn>
                <div class="flex gap-2">
                    <InputCn id="sso-work-email" Type="email" Placeholder="@("you@@company.com")"
                             Value="jane@acme.com" Class="flex-1" />
                    <ButtonCn Size="ButtonSize.Sm">Continue</ButtonCn>
                </div>
            </div>
        </div>

        <div class="border-t">
            <div class="px-4 py-3">
                <p class="mb-3 text-xs font-medium text-muted-foreground">
                    Detected provider for acme.com
                </p>

                <div class="flex items-center gap-3 rounded-md bg-muted/50 p-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-background">
                        <LucideShieldCn Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">Okta SSO</p>
                        <p class="text-xs text-muted-foreground">Configured for acme.com</p>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="shrink-0">
                        Sign in with Okta
                    </ButtonCn>
                </div>

                <div class="mt-3 space-y-1">
                    @foreach (var provider in _altProviders)
                    {
                        <div class="flex items-center gap-3 rounded-md px-3 py-2 transition-colors hover:bg-muted/30">
                            <LucideGlobeCn Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="flex-1 text-sm">@provider.Name</span>
                            <button type="button"
                                    class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                                Configure
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <button type="button"
                    class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                Don't have SSO? Sign in with password
            </button>
        </div>
    </div>
</section>

@code {
    private record SsoProvider(string Name, string Description);

    private static readonly SsoProvider[] _altProviders =
    [
        new("Azure AD", "Available"),
        new("Google Workspace", "Available"),
    ];
}
