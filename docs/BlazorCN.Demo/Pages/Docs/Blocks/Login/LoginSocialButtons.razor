@* ============================================================
   Block: login-social-buttons
   Title: Login Social Buttons
   Description: Social-only React authentication block for Next.js with staggered animated provider buttons for Google, GitHub, Apple, and Microsoft OAuth sign-in using shadcn/ui Button, Tailwind CSS, and framer-motion
   Long Description: Social buttons plus email password form
   Dependencies: ButtonCn, InputCn, SeparatorCn
   Source: original/blocks/login/login-social-buttons.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-4 py-4 text-center">
            <h2 class="text-base font-semibold">Welcome back</h2>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Choose how you'd like to sign in
            </p>
        </div>

        <div class="border-t px-4 py-4">
            <div class="space-y-2">
                @foreach (var provider in _providers)
                {
                    <div>
                        <ButtonCn
                            Variant="ButtonVariant.Outline"
                            Class="h-10 w-full justify-start gap-3 text-sm hover:bg-muted/50">
                            <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", provider.DotColor))"></span>
                            Continue with @provider.Name
                        </ButtonCn>
                    </div>
                }
            </div>

            <div class="relative my-4 py-1">
                <SeparatorCn />
                <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-card px-3 text-xs text-muted-foreground">
                    or
                </span>
            </div>

            @if (!_showEmail)
            {
                <div class="text-center">
                    <button
                        type="button"
                        @onclick="() => _showEmail = true"
                        class="text-xs text-muted-foreground hover:text-foreground">
                        Sign in with email and password
                    </button>
                </div>
            }
            else
            {
                <div class="space-y-3 overflow-hidden">
                    <InputCn
                        type="email"
                        Placeholder="Email"
                        @bind-Value="_email" />
                    <InputCn
                        type="password"
                        Placeholder="Password"
                        @bind-Value="_password" />
                    <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                        Sign in
                    </ButtonCn>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3 text-center">
            <p class="text-xs text-muted-foreground">
                By continuing, you agree to our
                <span class="cursor-pointer font-medium text-foreground hover:underline">
                    Terms
                </span>
                and
                <span class="cursor-pointer font-medium text-foreground hover:underline">
                    Privacy Policy
                </span>
            </p>
        </div>
    </div>
</section>

@code {
    private bool _showEmail = false;
    private string _email = "";
    private string _password = "";

    private record ProviderItem(string Name, string DotColor);

    private static readonly ProviderItem[] _providers =
    [
        new("Google", "bg-red-500"),
        new("GitHub", "bg-zinc-800 dark:bg-zinc-200"),
        new("Apple", "bg-zinc-950 dark:bg-white"),
        new("Microsoft", "bg-blue-500"),
    ];
}
