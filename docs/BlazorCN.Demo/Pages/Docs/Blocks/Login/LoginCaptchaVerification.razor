@* ============================================================
   Block: login-captcha-verification
   Title: LoginCaptchaVerification
   Description: Login with CAPTCHA challenge React block for Next.js with email and password form, interactive image grid CAPTCHA, verify button, and accessibility toggle using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-captcha-verification.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Sign in</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Complete the verification to continue
            </p>
        </div>

        @if (!_showCaptcha)
        {
            <div class="space-y-3 px-4 py-4">
                <div class="space-y-1.5">
                    <LabelCn For="captcha-email" Class="text-xs font-medium text-muted-foreground">
                        Email
                    </LabelCn>
                    <InputCn id="captcha-email" type="email" Placeholder="@("you@example.com")" @bind-Value="_email" />
                </div>
                <div class="space-y-1.5">
                    <LabelCn For="captcha-pw" Class="text-xs font-medium text-muted-foreground">
                        Password
                    </LabelCn>
                    <InputCn id="captcha-pw" type="password" Placeholder="Enter password" @bind-Value="_password" />
                </div>
                <ButtonCn Class="w-full" Size="ButtonSize.Sm" @onclick="@(() => _showCaptcha = true)">
                    Continue
                </ButtonCn>
            </div>
        }
        else
        {
            <div class="px-4 py-4">
                <div class="rounded-md border bg-muted/30 p-3">
                    <div class="mb-3 flex items-center justify-between">
                        <div>
                            <p class="text-xs font-medium">Select all images with traffic lights</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">Click each matching image</p>
                        </div>
                        <button
                            type="button"
                            aria-label="Refresh challenge"
                            class="rounded-md p-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                        >
                            <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                        </button>
                    </div>

                    <div class="grid grid-cols-3 gap-1.5">
                        @foreach (var it in _gridItems)
                        {
                            var item = it;
                            var isSelected = _selected.Contains(item.Id);
                            <button
                                type="button"
                                aria-label="Select image @item.Label"
                                @onclick="@(() => ToggleSelect(item.Id))"
                                class="@Cn.Merge("relative flex aspect-square items-center justify-center rounded-md border transition-colors", isSelected ? "border-blue-500 bg-blue-500/10" : "border-border bg-background hover:bg-muted/50")"
                            >
                                <LucideIconCn Name="image" Size="20" Class="size-5 text-muted-foreground/40" />
                                @if (isSelected)
                                {
                                    <div class="absolute top-1 right-1 flex size-4 items-center justify-center rounded-full bg-blue-500">
                                        <LucideIconCn Name="check" Size="10" Class="size-2.5 text-white" />
                                    </div>
                                }
                            </button>
                        }
                    </div>
                </div>

                <div class="mt-3 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <button
                            type="button"
                            aria-label="Play audio alternative"
                            class="rounded-md p-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                        >
                            <LucideIconCn Name="volume-2" Size="14" Class="size-3.5" />
                        </button>
                        <span class="text-xs text-muted-foreground">Audio alternative</span>
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Disabled="@(_selected.Count == 0)">
                        Verify
                    </ButtonCn>
                </div>
            </div>
        }

        <div class="border-t px-4 py-3">
            <p class="text-center text-xs text-muted-foreground">
                Protected by CAPTCHA verification
            </p>
        </div>
    </div>
</section>

@code {
    private string _email = "";
    private string _password = "";
    private bool _showCaptcha = false;
    private HashSet<string> _selected = new();

    private static readonly GridItem[] _gridItems =
    [
        new("a1", "Traffic light", true),
        new("a2", "Street sign", false),
        new("a3", "Traffic light", true),
        new("a4", "Bicycle", false),
        new("a5", "Bus", false),
        new("a6", "Traffic light", true),
        new("a7", "Crosswalk", false),
        new("a8", "Car", false),
        new("a9", "Traffic light", true),
    ];

    private void ToggleSelect(string id)
    {
        if (!_selected.Remove(id))
            _selected.Add(id);
    }

    private record GridItem(string Id, string Label, bool Match);
}
