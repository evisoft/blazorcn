@* ============================================================
   Block: login-organization-select
   Title: Login Organization Select
   Description: Organization-scoped React authentication block for Next.js with company selector dropdown, sign-in form after selection, organization name in header, and step transitions using shadcn/ui Select, Input, Button, Tailwind CSS, and framer-motion AnimatePresence
   Long Description: React Login Multi Step Wizard Block
   Dependencies: BadgeCn, ButtonCn, InputCn, LabelCn, LucideArrowLeftCn, LucideBuildingCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn
   Source: original/blocks/login/login-organization-select.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @if (_step == "org")
        {
            <div>
                <div class="border-b px-4 py-3">
                    <p class="text-sm font-medium">Select organization</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Choose the workspace you want to sign into
                    </p>
                </div>

                <div class="space-y-4 border-b px-4 py-4">
                    <div class="space-y-1.5">
                        <LabelCn For="os-org" Class="text-xs">Organization</LabelCn>
                        <SelectCn Value="@_org" ValueChanged="@(v => _org = v)">
                            <SelectTriggerCn id="os-org" Class="w-full" aria-label="organization">
                                <SelectValueCn Placeholder="Select an organization" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                @foreach (var o in _organizations)
                                {
                                    <SelectItemCn Value="@o.Id">
                                        <div class="flex items-center gap-2">
                                            <LucideBuildingCn Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span>@o.Name</span>
                                        </div>
                                    </SelectItemCn>
                                }
                            </SelectContentCn>
                        </SelectCn>
                    </div>
                    <ButtonCn Class="w-full" Disabled="@(string.IsNullOrEmpty(_org))" OnClick="@(() => _step = "login")">
                        Continue
                    </ButtonCn>
                </div>

                <div class="flex items-center justify-center px-4 py-3">
                    <span class="text-xs text-muted-foreground">
                        Can't find your organization?
                        <span class="cursor-pointer text-foreground underline underline-offset-2">Request access</span>
                    </span>
                </div>
            </div>
        }
        else
        {
            <div>
                <div class="flex items-center gap-2 border-b px-4 py-3">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7"
                              OnClick="@(() => _step = "org")" aria-label="Back">
                        <LucideArrowLeftCn Size="14" Class="size-3.5" />
                    </ButtonCn>
                    <div class="flex items-center gap-2">
                        <p class="text-sm font-medium">Sign in</p>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                            @SelectedOrgName
                        </BadgeCn>
                    </div>
                </div>

                <div class="space-y-4 border-b px-4 py-4">
                    <div class="space-y-1.5">
                        <LabelCn For="os-email" Class="text-xs">Email</LabelCn>
                        <InputCn id="os-email" Type="email" Placeholder="@("you@@company.com")"
                                 @bind-Value="_email" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="os-password" Class="text-xs">Password</LabelCn>
                        <InputCn id="os-password" Type="password" Placeholder="Enter your password"
                                 @bind-Value="_password" />
                    </div>
                    <ButtonCn Class="w-full">Sign in</ButtonCn>
                </div>

                <div class="flex items-center justify-center px-4 py-3">
                    <span class="cursor-pointer text-xs text-muted-foreground underline underline-offset-2">
                        Forgot password?
                    </span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private string _step = "org";
    private string _org = "";
    private string _email = "";
    private string _password = "";

    private record OrgItem(string Id, string Name);

    private static readonly OrgItem[] _organizations =
    [
        new("acme", "Acme Inc"),
        new("globex", "Globex Corporation"),
        new("initech", "Initech Labs"),
    ];

    private string SelectedOrgName => _organizations.FirstOrDefault(o => o.Id == _org)?.Name ?? "";
}
