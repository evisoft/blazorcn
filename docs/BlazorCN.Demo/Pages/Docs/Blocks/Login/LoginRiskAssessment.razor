@* ============================================================
   Block: login-risk-assessment
   Title: LoginRiskAssessment
   Description: Risk-based authentication React block for Next.js with risk score indicator, risk factors list, adaptive challenge display, and risk level badge using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-risk-assessment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Security Assessment</p>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("ml-auto text-xs font-normal", _riskLevel == "medium" ? "text-amber-600" : "")">
                    @(_riskLevel == "medium" ? "Medium risk" : "Low risk")
                </BadgeCn>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                We&apos;re evaluating this sign-in attempt
            </p>
        </div>

        <div class="border-b px-4 py-4">
            <div class="flex items-center gap-4">
                <div class="relative flex size-16 items-center justify-center">
                    <svg class="size-16 -rotate-90" viewBox="0 0 64 64" aria-hidden="true">
                        <title>Risk score: @_riskScore</title>
                        <circle
                            cx="32"
                            cy="32"
                            r="28"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="4"
                            class="text-muted/50" />
                        <circle
                            cx="32"
                            cy="32"
                            r="28"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="4"
                            stroke-dasharray="@($"{(_riskScore / 100.0) * 176:F2} 176")"
                            stroke-linecap="round"
                            class="text-amber-500" />
                    </svg>
                    <span class="absolute font-mono text-lg font-semibold">@_riskScore</span>
                </div>
                <div>
                    <p class="text-sm font-medium">Risk Score</p>
                    <p class="text-xs text-muted-foreground">
                        Additional verification may be required
                    </p>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Risk factors</p>
            <div class="space-y-1.5">
                @foreach (var factor in _riskFactors)
                {
                    <div class="flex items-center gap-3 rounded-md px-3 py-2">
                        <LucideIconCn Name="@factor.IconName" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="flex-1 text-xs font-medium">@factor.Label</span>
                        <span class="text-xs text-muted-foreground">@factor.Detail</span>
                        @if (factor.Status == "pass")
                        {
                            <LucideIconCn Name="check-circle" Size="14" Class="size-3.5 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5 text-amber-500" />
                        }
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="mb-2 rounded-md bg-amber-500/10 p-2">
                <p class="text-xs text-amber-700 dark:text-amber-500">
                    Medium risk detected. Additional verification is recommended.
                </p>
            </div>
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">Continue with verification</ButtonCn>
        </div>
    </div>
</section>

@code {
    private const int _riskScore = 62;
    private const string _riskLevel = "medium";

    private record RiskFactor(string Id, string Label, string Status, string Detail, string IconName);

    private static readonly RiskFactor[] _riskFactors =
    [
        new("device",   "Device",   "pass",    "Recognized device",   "laptop"),
        new("location", "Location", "warning", "New city detected",   "map-pin"),
        new("network",  "Network",  "pass",    "Trusted ISP",         "globe"),
        new("behavior", "Behavior", "warning", "Unusual login time",  "shield"),
    ];
}
