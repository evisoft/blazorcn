@* ============================================================
   Block: login-voice-auth
   Title: LoginVoiceAuth
   Description: Voice recognition React authentication block for Next.js with voice recording prompt, waveform visualization, passphrase display, recording state management, and fallback to password using shadcn/ui, Tailwind CSS, and Lucide icons
   Source: original/blocks/login/login-voice-auth.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-4 py-3">
      <p class="text-sm font-medium">Voice Authentication</p>
      <p class="mt-0.5 text-xs text-muted-foreground">
        Speak the passphrase to verify your identity
      </p>
    </div>

    <div class="flex flex-col items-center px-4 py-6">
      @if (_state == "idle")
      {
        <div class="mb-4 flex size-16 items-center justify-center rounded-full bg-muted/50">
          <LucideIconCn Name="mic" Size="28" Class="size-7 text-muted-foreground" />
        </div>
        <p class="text-sm font-medium">Ready to record</p>
        <p class="mt-1 text-xs text-muted-foreground">
          Click the button below and speak the passphrase clearly
        </p>
      }

      @if (_state == "recording")
      {
        <div class="mb-4 flex size-16 items-center justify-center rounded-full bg-red-500/10">
          <LucideIconCn Name="mic" Size="28" Class="size-7 text-red-500" />
        </div>
        <p class="text-sm font-medium">Listening...</p>
        <p class="mt-1 text-xs text-muted-foreground">
          Speak clearly into your microphone
        </p>
        <div class="mt-4 flex items-end gap-0.5">
          @foreach (var bar in _waveformBars)
          {
            var h = bar;
            <div
              class="w-1.5 rounded-full bg-red-500/60"
              style="@($"height:{h * 2}px")"
            ></div>
          }
        </div>
      }

      @if (_state == "processing")
      {
        <div class="mb-4 flex size-16 items-center justify-center rounded-full bg-blue-500/10">
          <LucideIconCn Name="volume-2" Size="28" Class="size-7 text-blue-500" />
        </div>
        <p class="text-sm font-medium">Processing voice print...</p>
        <p class="mt-1 text-xs text-muted-foreground">
          Matching against your enrolled voice profile
        </p>
      }

      @if (_state == "success")
      {
        <div class="mb-4 flex size-16 items-center justify-center rounded-full bg-emerald-500/10">
          <LucideIconCn Name="check-circle-2" Size="28" Class="size-7 text-emerald-600" />
        </div>
        <p class="text-sm font-medium">Voice verified</p>
        <p class="mt-1 text-xs text-muted-foreground">
          Identity confirmed. Redirecting to your account.
        </p>
      }

      @if (_state == "failed")
      {
        <div class="mb-4 flex size-16 items-center justify-center rounded-full bg-red-500/10">
          <LucideIconCn Name="mic-off" Size="28" Class="size-7 text-red-500" />
        </div>
        <p class="text-sm font-medium">Voice not recognized</p>
        <p class="mt-1 text-xs text-muted-foreground">
          Please try again in a quieter environment
        </p>
      }
    </div>

    <hr class="border-border" />

    <div class="px-4 py-3">
      <p class="mb-1 text-xs font-medium text-muted-foreground">Passphrase</p>
      <div class="rounded-md bg-muted/50 p-3">
        <p class="text-center font-mono text-sm">&ldquo;@_passphrase&rdquo;</p>
      </div>
    </div>

    <hr class="border-border" />

    <div class="flex gap-2 px-4 py-3">
      @if (_state == "idle" || _state == "failed")
      {
        <ButtonCn Class="flex-1 gap-1.5" Size="ButtonSize.Sm" @onclick="HandleRecord">
          <LucideIconCn Name="mic" Size="14" Class="size-3.5" />
          @(_state == "failed" ? "Try again" : "Start recording")
        </ButtonCn>
      }
      @if (_state == "failed")
      {
        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1 gap-1.5 text-xs" @onclick="HandleRetry">
          <LucideIconCn Name="key-round" Size="14" Class="size-3.5" />
          Use password
        </ButtonCn>
      }
      @if (_state == "recording")
      {
        <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-1.5" Size="ButtonSize.Sm" @onclick="@(() => _state = "processing")">
          <LucideIconCn Name="mic-off" Size="14" Class="size-3.5" />
          Stop recording
        </ButtonCn>
      }
    </div>

    <div class="border-t px-4 py-3">
      <div class="flex items-center justify-between text-xs text-muted-foreground">
        <span class="flex items-center gap-1">
          <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
          Voice data processed locally
        </span>
        <span>Attempt @(_attempt + 1) of 3</span>
      </div>
    </div>
  </div>
</section>

@code {
    private string _state = "idle";
    private int _attempt = 0;
    private const string _passphrase = "The quick brown fox jumps over the lazy dog";

    private static readonly int[] _waveformBars = [3, 5, 8, 12, 7, 15, 10, 6, 13, 9, 4, 11, 14, 8, 5, 10, 7, 12, 6, 9];

    private async Task HandleRecord()
    {
        _state = "recording";
        await Task.Delay(3000);
        _state = "processing";
        await Task.Delay(1500);
        if (_attempt == 0)
        {
            _state = "success";
        }
        else
        {
            _state = "failed";
        }
    }

    private void HandleRetry()
    {
        _attempt++;
        _state = "idle";
    }
}
