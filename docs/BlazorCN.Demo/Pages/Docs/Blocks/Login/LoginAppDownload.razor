@* ============================================================
   Block: login-app-download
   Title: Login App Download
   Description: React login form block for Next.js with email password authentication and mobile app download call-to-action section with App Store and Google Play buttons and slide-up animation using shadcn/ui Input, Button, Label, Tailwind CSS, and framer-motion
   Long Description: React Login Avatar Preview Block
   Dependencies: ButtonCn, InputCn, LabelCn, LucideMonitorSmartphoneCn, LucideSmartphoneCn, LucideTabletSmartphoneCn
   Source: original/blocks/login/login-app-download.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Sign in</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Welcome back to your account</p>
        </div>

        <div class="space-y-4 px-4 py-4">
            <div class="space-y-1.5">
                <LabelCn For="ad-email" Class="text-xs">Email</LabelCn>
                <InputCn id="ad-email" Type="email" Placeholder="@("you@@company.com")"
                         @bind-Value="_email" />
            </div>
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <LabelCn For="ad-password" Class="text-xs">Password</LabelCn>
                    <span class="cursor-pointer text-xs text-muted-foreground underline underline-offset-2">
                        Forgot?
                    </span>
                </div>
                <InputCn id="ad-password" Type="password" Placeholder="Enter your password"
                         @bind-Value="_password" />
            </div>
            <ButtonCn Class="w-full">Sign in</ButtonCn>
            <p class="text-center text-xs text-muted-foreground">
                Don't have an account?
                <span class="cursor-pointer text-foreground underline underline-offset-2">Create one</span>
            </p>
        </div>

        <div class="border-t bg-muted/30 px-4 py-4">
            <div class="mb-3 flex items-center gap-2">
                <LucideSmartphoneCn Size="16" Class="size-4 text-muted-foreground" />
                <div>
                    <p class="text-sm font-medium">Get the mobile app</p>
                    <p class="text-xs text-muted-foreground">Available on iOS and Android</p>
                </div>
            </div>
            <div class="grid grid-cols-2 gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 flex-1 gap-1.5 text-xs">
                    <LucideMonitorSmartphoneCn Size="14" Class="size-3.5" />
                    App Store
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 flex-1 gap-1.5 text-xs">
                    <LucideTabletSmartphoneCn Size="14" Class="size-3.5" />
                    Google Play
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string _email = "";
    private string _password = "";
}
