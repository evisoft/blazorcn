@* ============================================================
   Block: login-quick-actions
   Title: LoginQuickActions
   Description: Login with quick action shortcuts React block for Next.js with recent activity feed, one-click resume buttons, quick access links, and session restore option using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-quick-actions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Welcome back, Alex</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @(_authenticated ? "Where would you like to go?" : "Enter your password to continue")
            </p>
        </div>

        @if (!_authenticated)
        {
            <div class="px-4 py-4">
                <div class="flex gap-2">
                    <InputCn Type="password" Placeholder="Enter password" Class="flex-1" @bind-Value="_password" />
                    <ButtonCn Size="ButtonSize.Sm" @onclick="@(() => _authenticated = true)">
                        Sign in
                    </ButtonCn>
                </div>
            </div>
        }
        else
        {
            <div class="px-4 py-2">
                <p class="mb-2 px-1 text-xs font-medium text-muted-foreground">Quick actions</p>
                <div class="space-y-0.5">
                    @foreach (var action in _quickActions)
                    {
                        <button type="button"
                                class="flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left transition-colors hover:bg-muted/50">
                            <div class="flex size-7 shrink-0 items-center justify-center rounded-md bg-muted/50">
                                <LucideIconCn Name="@action.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-medium">@action.Label</p>
                                <p class="text-xs text-muted-foreground">@action.Description</p>
                            </div>
                            <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5 text-muted-foreground" />
                        </button>
                    }
                </div>
            </div>
        }

        <div class="border-t px-4 py-3">
            <button type="button"
                    class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                @(_authenticated ? "Go to home" : "Not Alex? Use a different account")
            </button>
        </div>
    </div>
</section>

@code {
    private string _password = "";
    private bool _authenticated = false;

    private record QuickAction(string Id, string Label, string Description, string Icon);

    private static readonly QuickAction[] _quickActions =
    [
        new("qa1", "Resume editing", "Q4 Report - last edited 2h ago", "file-text"),
        new("qa2", "Open dashboard", "3 new notifications", "layout-dashboard"),
        new("qa3", "Check inbox", "12 unread messages", "inbox"),
        new("qa4", "Recent project", "Website Redesign", "folder"),
        new("qa5", "Account settings", "2FA setup pending", "settings"),
    ];
}
