@* ============================================================
   Block: login-biometric-auth
   Title: LoginBiometricAuth
   Description: Biometric fingerprint React authentication block for Next.js with animated fingerprint scanner, scan-now button, device compatibility check, and fallback to password using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-biometric-auth.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-4 py-3">
      <p class="text-sm font-medium">Biometric Authentication</p>
      <p class="mt-0.5 text-xs text-muted-foreground">
        Use your fingerprint or Face ID to sign in
      </p>
    </div>

    <div class="flex flex-col items-center px-4 py-10">
      <div class="relative mb-6">
        @* Pulse ring — visible and animating while scanning *@
        <div class="@Cn.Merge("absolute inset-0 rounded-full border-2 border-muted-foreground/30", _scanning ? "animate-ping" : "opacity-0")"></div>
        <div class="@Cn.Merge("flex size-20 items-center justify-center rounded-full transition-colors duration-300", _verified ? "bg-emerald-500/10" : _scanning ? "bg-blue-500/10" : "bg-muted/50")">
          @if (_verified)
          {
            <LucideIconCn Name="check" Size="40" Class="size-10 text-emerald-600" />
          }
          else
          {
            <LucideIconCn Name="fingerprint" Size="40" Class="@Cn.Merge("size-10 transition-colors duration-300", _scanning ? "text-blue-500" : "text-muted-foreground")" />
          }
        </div>
      </div>

      <p class="text-sm font-medium">
        @(_verified ? "Identity verified" : _scanning ? "Scanning..." : "Place your finger on the sensor")
      </p>
      <p class="mt-1 text-xs text-muted-foreground">
        @(_verified ? "Redirecting to your account" : _scanning ? "Hold still while we verify your identity" : "Quick and secure sign-in with biometrics")
      </p>

      @if (!_verified)
      {
        <div class="mt-6 w-full max-w-[280px]">
          <ButtonCn Class="w-full" @onclick="HandleScan" Disabled="@_scanning">
            @(_scanning ? "Verifying..." : "Scan fingerprint")
          </ButtonCn>
        </div>
      }
    </div>

    <div class="border-t px-4 py-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2 text-xs text-muted-foreground">
          <LucideIconCn Name="smartphone" Size="14" Class="size-3.5" />
          <span>Device supported</span>
          <span class="size-1.5 rounded-full bg-emerald-500"></span>
        </div>
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
            <LucideIconCn Name="shield-check" Size="14" Class="size-3.5" />
            <span>End-to-end encrypted</span>
          </div>
          <button
            type="button"
            class="text-xs text-muted-foreground transition-colors hover:text-foreground"
          >
            Use password
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

@code {
    private bool _scanning = false;
    private bool _verified = false;

    private async Task HandleScan()
    {
        _scanning = true;
        await Task.Delay(2500);
        _scanning = false;
        _verified = true;
    }
}
