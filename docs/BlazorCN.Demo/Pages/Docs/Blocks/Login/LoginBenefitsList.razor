@* ============================================================
   Block: login-benefits-list
   Title: Login Benefits List
   Description: Split-panel React login block for Next.js with sign-in form on left and product benefits checklist with animated green check icons on right using shadcn/ui Input, Checkbox, Separator, Tailwind CSS, and framer-motion stagger animations
   Long Description: React Login Avatar Preview Block
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn, LucideCheckCircle2Cn
   Source: original/blocks/login/login-benefits-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid md:grid-cols-2">
            <div class="border-b px-6 py-6 md:border-r md:border-b-0">
                <div class="mb-5">
                    <p class="text-sm font-medium">Sign in</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Enter your credentials to continue
                    </p>
                </div>
                <div class="space-y-4">
                    <div class="space-y-2">
                        <LabelCn For="bl-email" Class="text-xs">Email address</LabelCn>
                        <InputCn id="bl-email" Type="email" Placeholder="@("you@@company.com")" />
                    </div>
                    <div class="space-y-2">
                        <LabelCn For="bl-password" Class="text-xs">Password</LabelCn>
                        <InputCn id="bl-password" Type="password" Placeholder="********" />
                    </div>
                    <span class="flex items-center gap-2">
                        <CheckboxCn id="bl-remember" />
                        <span class="text-xs text-muted-foreground">Remember me</span>
                    </span>
                    <ButtonCn Class="w-full">Sign in</ButtonCn>
                </div>
                <p class="mt-4 text-xs text-muted-foreground">
                    No account?
                    <button type="button" class="text-foreground underline underline-offset-2">
                        Get started
                    </button>
                </p>
            </div>

            <div class="flex flex-col justify-center p-8">
                <p class="mb-6 text-sm font-medium">Why developers choose Acme</p>
                <div class="space-y-4">
                    @foreach (var benefit in _benefits)
                    {
                        <div class="flex items-start gap-3">
                            <LucideCheckCircle2Cn Size="16" Class="mt-0.5 size-4 shrink-0 text-emerald-500" />
                            <div>
                                <p class="text-sm font-medium">@benefit.Title</p>
                                <p class="mt-0.5 text-xs text-muted-foreground">@benefit.Description</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Benefit(string Title, string Description);

    private static readonly Benefit[] _benefits =
    [
        new("Free 14-day trial", "No credit card needed"),
        new("Ship 3x faster", "Pre-built components"),
        new("Enterprise ready", "SOC 2 & GDPR compliant"),
        new("24/7 support", "Average 2-min response"),
        new("Cancel anytime", "No lock-in contracts"),
    ];
}
