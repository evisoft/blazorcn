@* ============================================================
   Block: login-team-invite
   Title: Login Team Invite
   Description: Team invitation React acceptance block for Next.js with workspace details, invitee email display, name and password creation fields, and fade-in animation using shadcn/ui Avatar, Input, Button, Tailwind CSS, and framer-motion
   Long Description: Workspace selection before login
   Dependencies: ButtonCn, InputCn, LabelCn, LucideMailCn, LucideUsersCn
   Source: original/blocks/login/login-team-invite.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col items-center border-b px-4 py-6">
            <div class="flex size-12 items-center justify-center rounded-xl bg-primary text-lg font-semibold text-primary-foreground">
                A
            </div>
            <p class="mt-3 text-xs text-muted-foreground">You\u2019re invited to join</p>
            <p class="mt-0.5 text-base font-semibold">Acme Inc</p>
            <p class="mt-1 flex items-center gap-1 text-xs text-muted-foreground">
                <LucideUsersCn Size="12" Class="size-3" />
                12 members
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2.5 rounded-md bg-muted/50 p-3">
                <LucideMailCn Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                <span class="font-mono text-sm">alex@@example.com</span>
            </div>
            <p class="mt-4 text-xs text-muted-foreground">Create your password to join</p>
        </div>

        <div class="px-4 py-4">
            <div class="space-y-4">
                <div class="space-y-2">
                    <LabelCn For="ti-name" Class="text-xs">Full name</LabelCn>
                    <InputCn id="ti-name" Type="text" Placeholder="Alex Johnson" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="ti-password" Class="text-xs">Password</LabelCn>
                    <InputCn id="ti-password" Type="password" Placeholder="Min. 8 characters" />
                </div>
                <ButtonCn Class="w-full">Accept invitation</ButtonCn>
            </div>
        </div>

        <div class="border-t px-4 py-2">
            <p class="text-xs text-muted-foreground">
                Already have an account?
                <button type="button" class="text-foreground underline underline-offset-2">Sign in</button>
            </p>
        </div>
    </div>
</section>

