@* ============================================================
   Block: login-session-limit
   Title: LoginSessionLimit
   Description: Session limit reached React notification block for Next.js with active sessions list, device and location details, terminate session buttons, and upgrade prompt using shadcn/ui, Tailwind CSS, and Lucide icons
   Source: original/blocks/login/login-session-limit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">

    @* Header *@
    <div class="border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="triangle-alert" Size="16" Class="size-4 text-amber-500" />
        <p class="text-sm font-medium">Session Limit Reached</p>
      </div>
      <p class="mt-0.5 text-xs text-muted-foreground">
        Your plan allows @_maxSessions concurrent sessions. Terminate an existing session to
        continue.
      </p>
    </div>

    @* Session count row *@
    <div class="px-4 py-3">
      <div class="flex items-center justify-between">
        <p class="text-xs font-medium text-muted-foreground">
          Active sessions (@_activeSessions.Length/@_maxSessions)
        </p>
        @if (_terminated.Count > 0)
        {
          <span class="text-xs text-emerald-600">@_terminated.Count terminated</span>
        }
      </div>
    </div>

    <hr class="border-t" />

    @* Session list *@
    @foreach (var session in _activeSessions)
    {
      var sess = session;
      <div>
        <div class="flex items-start gap-3 px-4 py-3">
          <div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-muted/50">
            <LucideIconCn Name="@GetIconName(sess.Icon)" Size="16" Class="size-4 text-muted-foreground" />
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center gap-2">
              <p class="text-sm font-medium">@sess.Device</p>
              <span class="size-1.5 rounded-full bg-emerald-500"></span>
            </div>
            <p class="text-xs text-muted-foreground">@sess.Browser</p>
            <div class="mt-1 flex items-center gap-3 text-xs text-muted-foreground">
              <span class="flex items-center gap-1">
                <LucideIconCn Name="globe" Size="12" Class="size-3" />
                @sess.Location
              </span>
              <span class="font-mono">@sess.Ip</span>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">@sess.LastActive</p>
          </div>
          <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                    Class="h-7 gap-1.5 px-2 text-xs text-muted-foreground"
                    OnClick="@(() => Terminate(sess.Id))">
            <LucideIconCn Name="log-out" Size="12" Class="size-3" />
            End
          </ButtonCn>
        </div>
        @if (sess.Id != _activeSessions[_activeSessions.Length - 1].Id)
        {
          <hr class="border-t" />
        }
      </div>
    }

    @* Empty state *@
    @if (_activeSessions.Length == 0)
    {
      <div class="px-4 py-6 text-center">
        <p class="text-sm font-medium">All sessions terminated</p>
        <p class="mt-0.5 text-xs text-muted-foreground">
          You can now sign in on this device
        </p>
      </div>
    }

    @* Footer buttons *@
    <div class="flex gap-2 border-t px-4 py-3">
      <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1 text-xs">
        Upgrade plan
      </ButtonCn>
      <ButtonCn Size="ButtonSize.Sm" Class="flex-1 text-xs" Disabled="@(!_canLogin)">
        @(_canLogin ? "Continue to sign in" : "Terminate a session first")
      </ButtonCn>
    </div>

  </div>
</section>

@code {
    private record Session(string Id, string Device, string Browser, string Location, string Ip, string LastActive, string Icon, bool Current);

    private static readonly Session[] _allSessions =
    [
        new("s1", "MacBook Pro",       "Chrome 122 on macOS",   "San Francisco, CA", "192.168.1.***", "Active now",  "laptop",  false),
        new("s2", "Windows Desktop",   "Firefox 124 on Windows", "New York, NY",      "10.0.0.***",   "3 min ago",   "monitor", false),
        new("s3", "iPhone 15",         "Safari on iOS 17",       "San Francisco, CA", "172.16.0.***", "12 min ago",  "phone",   false),
    ];

    private const int _maxSessions = 2;

    private Session[] _activeSessions = _allSessions;
    private List<string> _terminated = [];

    private bool _canLogin => _activeSessions.Length < _maxSessions;

    private void Terminate(string id)
    {
        _terminated.Add(id);
        _activeSessions = [.. System.Linq.Enumerable.Where(_activeSessions, s => s.Id != id)];
    }

    private static string GetIconName(string icon) => icon switch
    {
        "laptop"  => "laptop",
        "monitor" => "monitor",
        "phone"   => "smartphone",
        _         => "monitor"
    };
}
