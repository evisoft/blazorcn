@* ============================================================
   Block: login-cookie-consent
   Title: LoginCookieConsent
   Description: Login with cookie consent notice React block for Next.js with email and password form, collapsible cookie preferences panel, essential and analytics toggles, and accept button using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-cookie-consent.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Sign in</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Enter your credentials to continue</p>
        </div>

        <div class="space-y-3 px-4 py-4">
            <div class="space-y-1.5">
                <LabelCn For="cookie-email" Class="text-xs font-medium text-muted-foreground">
                    Email
                </LabelCn>
                <InputCn id="cookie-email" Type="email" Placeholder="@("you@example.com")" />
            </div>
            <div class="space-y-1.5">
                <LabelCn For="cookie-pw" Class="text-xs font-medium text-muted-foreground">
                    Password
                </LabelCn>
                <InputCn id="cookie-pw" Type="password" Placeholder="Enter password" />
            </div>
            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                Sign in
            </ButtonCn>
        </div>

        <div class="border-t">
            <div class="flex items-center gap-3 px-4 py-3">
                <LucideIconCn Name="cookie" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <p class="flex-1 text-xs text-muted-foreground">
                    We use cookies to improve your experience.&nbsp;
                    <button type="button"
                            @onclick="@(() => _showPrefs = !_showPrefs)"
                            class="font-medium text-foreground hover:underline">
                        Manage preferences
                    </button>
                </p>
                <button type="button"
                        aria-label="Toggle cookie preferences"
                        @onclick="@(() => _showPrefs = !_showPrefs)"
                        class="rounded-md p-1 text-muted-foreground transition-colors hover:text-foreground">
                    <LucideIconCn Name="chevron-down" Size="16" Class="@Cn.Merge("size-4 transition-transform duration-200", _showPrefs ? "rotate-180" : "")" />
                </button>
            </div>

            @if (_showPrefs)
            {
                <div class="overflow-hidden border-t">
                    <div class="space-y-3 px-4 py-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="shield" Size="14" Class="size-3.5 text-muted-foreground" />
                                <div>
                                    <p class="text-xs font-medium">Essential</p>
                                    <p class="text-xs text-muted-foreground">Required for authentication</p>
                                </div>
                            </div>
                            <SwitchCn Checked="true" Disabled="true" aria-label="Essential cookies" />
                        </div>

                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-medium">Analytics</p>
                                <p class="text-xs text-muted-foreground">Help us improve the product</p>
                            </div>
                            <SwitchCn Checked="@_analytics"
                                      CheckedChanged="@((bool v) => _analytics = v)"
                                      aria-label="Analytics cookies" />
                        </div>

                        <div class="flex items-center justify-between">
                            <div>
                                <p class="text-xs font-medium">Marketing</p>
                                <p class="text-xs text-muted-foreground">Personalized recommendations</p>
                            </div>
                            <SwitchCn Checked="@_marketing"
                                      CheckedChanged="@((bool v) => _marketing = v)"
                                      aria-label="Marketing cookies" />
                        </div>

                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full"
                                  OnClick="@(() => _showPrefs = false)">
                            Save preferences
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private bool _showPrefs;
    private bool _analytics;
    private bool _marketing;
}
