@* ============================================================
   Block: login-jwt-debug
   Title: LoginJwtDebug
   Description: JWT token debug and inspect React block for Next.js with token input, decoded header and payload display, expiration check, and signature status using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-jwt-debug.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="key" Size="16" Class="text-muted-foreground" />
                <p class="text-sm font-medium">JWT Inspector</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Paste a token to decode and verify</p>
        </div>

        @* Token input *@
        <div class="border-b px-4 py-3">
            <textarea
                value="@_token"
                @oninput="@((e) => _token = e.Value?.ToString() ?? "")"
                placeholder="eyJhbGciOiJSUzI1NiIsInR5cCI6IkpXVCJ9..."
                rows="3"
                class="w-full resize-none rounded-md border bg-background p-2 font-mono text-xs placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring"></textarea>
            <ButtonCn Size="ButtonSize.Sm" Class="mt-2" @onclick="@(() => _decoded = true)" Disabled="@(string.IsNullOrWhiteSpace(_token))">
                Decode token
            </ButtonCn>
        </div>

        @* Decoded sections *@
        @if (_decoded)
        {
            @* Header *@
            <div class="border-b px-4 py-3">
                <div class="mb-2 flex items-center justify-between">
                    <span class="text-xs font-medium text-red-500">HEADER</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        Copy
                    </ButtonCn>
                </div>
                <pre class="rounded-md bg-zinc-950 p-3 font-mono text-xs text-zinc-300">@_sampleHeaderJson</pre>
            </div>

            @* Payload *@
            <div class="border-b px-4 py-3">
                <div class="mb-2 flex items-center justify-between">
                    <span class="text-xs font-medium text-violet-500">PAYLOAD</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        Copy
                    </ButtonCn>
                </div>
                <pre class="rounded-md bg-zinc-950 p-3 font-mono text-xs text-zinc-300">@_samplePayloadJson</pre>
            </div>

            @* Verification status *@
            <div class="px-4 py-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Verification</p>
                <div class="space-y-2">
                    <div class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="check-circle" Size="14" Class="size-3.5 text-emerald-500" />
                        <span>Signature valid (RS256)</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5 text-amber-500" />
                        <span>Token expired</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideIconCn Name="clock" Size="14" Class="size-3.5" />
                        <span>Issued: Mar 20, 2024 &middot; Expires: Mar 21, 2024</span>
                    </div>
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-3">
            <button
                type="button"
                class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                Sign in with this token
            </button>
        </div>
    </div>
</section>

@code {
    private string _token = "";
    private bool _decoded = false;

    private static readonly string _sampleHeaderJson =
        "{\n  \"alg\": \"RS256\",\n  \"typ\": \"JWT\",\n  \"kid\": \"abc-123\"\n}";

    private static readonly string _samplePayloadJson =
        "{\n  \"sub\": \"user_2fK9xL\",\n  \"email\": \"alex@acme.com\",\n  \"name\": \"Alex Johnson\",\n  \"role\": \"admin\",\n  \"iat\": 1710892800,\n  \"exp\": 1710979200,\n  \"iss\": \"https://auth.acme.com\"\n}";
}
