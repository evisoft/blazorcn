@* ============================================================
   Block: login-two-factor
   Title: Login Two Factor
   Description: Two-factor React authentication block for Next.js with animated shield icon, six-digit authenticator app code entry using InputOTP, verify button, and backup code fallback using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Email and SMS code verification
   Dependencies: ButtonCn, InputOtpCn, InputOtpGroupCn, InputOtpSeparatorCn, InputOtpSlotCn, LucideShieldCheckCn
   Source: original/blocks/login/login-two-factor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col items-center px-4 py-8">
          <div
            class="mb-3 flex size-10 items-center justify-center rounded-full bg-emerald-500/10"
          >
            <LucideShieldCheckCn Size="20" Class="text-emerald-600" />
          </div>
          <p class="text-sm font-medium">Two-factor authentication</p>
          <p class="mt-1 text-center text-xs text-muted-foreground">
            Enter the code from your authenticator app
          </p>
        </div>

        <div class="border-t px-4 py-6">
          <div
            class="space-y-4"
          >
            <div class="flex justify-center">
              <InputOtpCn maxlength="@(6)" @bind-Value="_code">
                <InputOtpGroupCn>
                  <InputOtpSlotCn index="@(0)" />
                  <InputOtpSlotCn index="@(1)" />
                  <InputOtpSlotCn index="@(2)" />
                </InputOtpGroupCn>
                <InputOtpSeparatorCn />
                <InputOtpGroupCn>
                  <InputOtpSlotCn index="@(3)" />
                  <InputOtpSlotCn index="@(4)" />
                  <InputOtpSlotCn index="@(5)" />
                </InputOtpGroupCn>
              </InputOtpCn>
            </div>

            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
              Verify
            </ButtonCn>
          </div>
        </div>

        <div class="flex items-center justify-between border-t px-4 py-3">
          <span class="text-xs text-muted-foreground">Having trouble?</span>
          <div class="flex items-center gap-3">
            <button
              type="button"
              class="text-xs text-muted-foreground transition-colors hover:text-foreground"
            >
              Use backup code
            </button>
            <button
              type="button"
              class="text-xs text-muted-foreground transition-colors hover:text-foreground"
            >
              Contact support
            </button>
          </div>
        </div>
      </div>
    </section>

@code {
    private string _code = "";
}
