@* ============================================================
   Block: login-session-expired
   Title: Login Session Expired
   Description: Session timeout React re-authentication block for Next.js with animated clock icon, expiry notification message, pre-filled read-only email, password input, and spring animation using shadcn/ui Input, Button, Label, Tailwind CSS, and framer-motion
   Long Description: React Login Security Badges Block
   Dependencies: ButtonCn, InputCn, LabelCn, LucideClockCn
   Source: original/blocks/login/login-session-expired.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        @* Icon + message *@
        <div class="flex flex-col items-center border-b px-4 py-8 text-center">
          <div
            class="mb-3 flex size-12 items-center justify-center rounded-full bg-amber-500/10"
          >
            <LucideClockCn Size="20" Class="text-amber-600" />
          </div>
          <p class="text-sm font-medium">Session expired</p>
          <p class="mx-auto mt-1 max-w-[280px] text-xs text-muted-foreground leading-relaxed">
            Your session timed out for security. Sign in again to continue where you left off.
          </p>
        </div>

        @* Pre-filled email *@
        <div
          class="space-y-4 border-b px-4 py-4"
        >
          <div class="space-y-1.5">
            <LabelCn Class="text-xs">Account</LabelCn>
            <div class="rounded-md bg-muted/50 px-3 py-2 text-sm text-muted-foreground">
              alex@@acme.com
            </div>
          </div>
          <div class="space-y-1.5">
            <LabelCn for="se-password" Class="text-xs">
              Password
            </LabelCn>
            <InputCn
              id="se-password"
              type="password"
              Placeholder="Enter your password"
              @bind-Value="_password"
            />
          </div>
          <ButtonCn Class="w-full">Sign in again</ButtonCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-center px-4 py-3">
          <span class="cursor-pointer text-xs text-muted-foreground underline underline-offset-2">
            Return to homepage
          </span>
        </div>
      </div>
    </section>

@code {
    private string _password = "";
}
