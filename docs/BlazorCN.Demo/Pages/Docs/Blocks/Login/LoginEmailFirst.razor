@* ============================================================
   Block: login-email-first
   Title: Login Email First
   Description: Progressive React email-first authentication block for Next.js with two-step flow showing email input first then password entry with email badge, back navigation, and slide transitions using shadcn/ui Input, Button, Badge, Tailwind CSS, and framer-motion AnimatePresence
   Long Description: Single-step email password form
   Dependencies: BadgeCn, ButtonCn, InputCn, LabelCn, LucideArrowLeftCn, LucideGithubCn, LucideMailCn, SeparatorCn
   Source: original/blocks/login/login-email-first.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @if (_step == 1)
        {
            <div class="px-4 py-8">
                <div class="mx-auto max-w-xs">
                    <div class="mb-6 text-center">
                        <h2 class="text-sm font-medium">Sign in</h2>
                        <p class="mt-1 text-xs text-muted-foreground">
                            Enter your email to get started
                        </p>
                    </div>

                    <div class="space-y-4">
                        <div class="space-y-2">
                            <LabelCn For="ef-email" Class="text-xs text-muted-foreground">
                                Email address
                            </LabelCn>
                            <InputCn id="ef-email" Type="email" @bind-Value="_email"
                                     Placeholder="@("you@@company.com")" Class="h-8 text-sm" />
                        </div>

                        <ButtonCn Class="h-8 w-full text-xs" OnClick="HandleContinue">
                            Continue
                        </ButtonCn>

                        <div class="flex items-center gap-3">
                            <SeparatorCn Class="flex-1" />
                            <span class="text-xs text-muted-foreground">or</span>
                            <SeparatorCn Class="flex-1" />
                        </div>

                        <div class="grid grid-cols-2 gap-2">
                            <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 gap-1.5 text-xs">
                                <svg class="size-3.5" viewBox="0 0 24 24" aria-label="Google logo">
                                    <title>Google</title>
                                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4" />
                                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                                </svg>
                                Google
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 gap-1.5 text-xs">
                                <LucideGithubCn Size="14" Class="size-3.5" />
                                GitHub
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div>
                <div class="flex items-center gap-2 border-b px-4 py-3">
                    <button type="button"
                            @onclick="@(() => _step = 1)"
                            class="text-muted-foreground transition-colors hover:text-foreground">
                        <LucideArrowLeftCn Size="16" Class="size-4" />
                    </button>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal">
                        <LucideMailCn Size="12" Class="size-3" />
                        @_email
                    </BadgeCn>
                </div>

                <div class="px-4 py-8">
                    <div class="mx-auto max-w-xs">
                        <p class="mb-4 text-xs text-muted-foreground">Enter your password</p>

                        <div class="space-y-4">
                            <div class="space-y-2">
                                <LabelCn For="ef-password" Class="text-xs text-muted-foreground">
                                    Password
                                </LabelCn>
                                <InputCn id="ef-password" Type="password"
                                         Placeholder="Enter your password" Class="h-8 text-sm" />
                            </div>

                            <ButtonCn Class="h-8 w-full text-xs">Sign in</ButtonCn>

                            <button type="button"
                                    class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                                Forgot password?
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private int _step = 1;
    private string _email = "";

    private void HandleContinue()
    {
        if (!string.IsNullOrWhiteSpace(_email))
            _step = 2;
    }
}
