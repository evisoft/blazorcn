@* ============================================================
   Block: login-security-questions
   Title: LoginSecurityQuestions
   Description: Security question challenge React block for Next.js with randomized question display, answer input field, attempt tracking, and hint option using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-security-questions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
        <p class="text-sm font-medium">Security Question</p>
      </div>
      <p class="mt-0.5 text-xs text-muted-foreground">
        Answer your security question to verify your identity
      </p>
    </div>

    <div class="border-b px-4 py-2">
      <div class="flex items-center gap-1">
        @foreach (var qi in _questionIndices)
        {
          var idx = qi;
          <div class="@Cn.Merge("h-1 flex-1 rounded-full transition-colors", idx <= _currentQ ? "bg-foreground" : "bg-muted")"></div>
        }
      </div>
      <p class="mt-1 text-xs text-muted-foreground">
        Question @(_currentQ + 1) of @(_questions.Length)
      </p>
    </div>

    <div class="px-4 py-6">
      <div class="mb-4 rounded-md bg-muted/50 p-4">
        <p class="text-sm font-medium">@(_questions[_currentQ].Text)</p>
      </div>

      <div class="space-y-3">
        <div class="space-y-1.5">
          <LabelCn For="sq-answer" Class="text-xs font-medium text-muted-foreground">
            Your answer
          </LabelCn>
          <InputCn id="sq-answer" type="text" Placeholder="Type your answer" @bind-Value="_answer" autocomplete="off" />
        </div>

        @if (_showHint)
        {
          <div class="rounded-md bg-blue-500/10 p-2">
            <p class="text-xs text-blue-700 dark:text-blue-400">
              Hint: @(_questions[_currentQ].Hint)
            </p>
          </div>
        }

        <ButtonCn Class="w-full" Size="ButtonSize.Sm" Disabled="@(string.IsNullOrWhiteSpace(_answer))" @onclick="HandleSubmit">
          @(_currentQ < _questions.Length - 1 ? "Next question" : "Verify")
        </ButtonCn>
      </div>
    </div>

    <div class="border-t px-4 py-3">
      <div class="flex items-center justify-between">
        <button
          type="button"
          @onclick="@(() => _showHint = true)"
          class="flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground"
        >
          <LucideIconCn Name="help-circle" Size="12" Class="size-3" />
          Show hint
        </button>
        <span class="text-xs text-muted-foreground">@(3 - _attempts) attempts remaining</span>
      </div>
    </div>
  </div>
</section>

@code {
    private record Question(int Id, string Text, string Hint);

    private static readonly Question[] _questions =
    [
        new(1, "What was the name of your first pet?", "Starts with 'B'"),
        new(2, "What city were you born in?", "East coast"),
        new(3, "What was your childhood nickname?", "4 letters"),
    ];

    private static readonly int[] _questionIndices = [0, 1, 2];

    private int _currentQ = 0;
    private string _answer = "";
    private bool _showHint = false;
    private int _attempts = 0;

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_answer))
        {
            _attempts++;
            if (_currentQ < _questions.Length - 1)
            {
                _currentQ++;
                _answer = "";
                _showHint = false;
            }
        }
    }
}
