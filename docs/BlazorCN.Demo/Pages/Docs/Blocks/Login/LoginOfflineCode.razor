@* ============================================================
   Block: login-offline-code
   Title: LoginOfflineCode
   Description: Offline access code entry React block for Next.js with code input field, offline mode indicator, sync status display, and connectivity check using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-offline-code.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Offline banner *@
        <div class="flex items-center gap-2 bg-amber-500/10 px-4 py-2">
            <LucideIconCn Name="wifi-off" Size="14" Class="size-3.5 text-amber-600" />
            <span class="text-xs font-medium text-amber-700 dark:text-amber-500">
                You appear to be offline
            </span>
        </div>

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="cloud-off" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Offline Access</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Enter your pre-generated offline access code
            </p>
        </div>

        @* Code input *@
        <div class="px-4 py-6">
            <div class="flex flex-col items-center">
                <div class="w-full max-w-[320px] space-y-4">
                    <div class="space-y-1.5">
                        <LabelCn for="offline-code" Class="text-xs font-medium text-muted-foreground">
                            Offline access code
                        </LabelCn>
                        <InputCn
                            id="offline-code"
                            Placeholder="XXXX-XXXX-XXXX"
                            @bind-Value="_code"
                            Class="text-center font-mono text-sm tracking-wider"
                            maxlength="14" />
                        <p class="text-center text-xs text-muted-foreground">
                            Find this code in your authenticator app or printed backup
                        </p>
                    </div>

                    <ButtonCn Class="w-full" Size="ButtonSize.Sm" Disabled="@(_code.Length < 14)">
                        Sign in offline
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Sync status *@
        <div class="border-t px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Sync status</p>
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Last synced</span>
                        <span>2 hours ago</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Cached data</span>
                        <span>Available</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Offline sessions</span>
                        <span>3 remaining</span>
                    </div>
                </div>
            </div>
        </div>

        @* Retry button *@
        <div class="border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full gap-1.5 text-xs">
                <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                Retry online connection
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private string _code = "";
}
