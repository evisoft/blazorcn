@* ============================================================
   Block: login-multi-step
   Title: Login Multi Step
   Description: Multi-step React sign-in wizard for Next.js with email, password, and two-factor authentication steps, numbered progress indicator, slide transitions, and back navigation using shadcn/ui, Tailwind CSS, and framer-motion AnimatePresence
   Long Description: Two-step email-first sign-in flow
   Dependencies: BadgeCn, ButtonCn, InputCn, InputOtpCn, InputOtpGroupCn, InputOtpSlotCn, LabelCn
   Source: original/blocks/login/login-multi-step.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-center gap-2">
                @for (var idx = 0; idx < _stepLabels.Length; idx++)
                {
                    var i = idx;
                    <div class="flex items-center gap-2">
                        <div class="flex flex-col items-center gap-1">
                            <span class="@Cn.Merge("flex size-2.5 rounded-full transition-colors", i <= _step ? "bg-primary" : "bg-muted")" />
                            <span class="text-xs text-muted-foreground">@_stepLabels[i]</span>
                        </div>
                        @if (i < _stepLabels.Length - 1)
                        {
                            <div class="@Cn.Merge("mb-4 h-px w-12 transition-colors", i < _step ? "bg-primary" : "bg-muted")" />
                        }
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-5">
            @if (_step == 0)
            {
                <div class="space-y-4">
                    <div class="space-y-1.5">
                        <LabelCn For="login-ms-email" Class="text-xs font-medium text-muted-foreground">
                            Email address
                        </LabelCn>
                        <InputCn id="login-ms-email" Type="email" Placeholder="@("you@@example.com")"
                                 @bind-Value="_email" />
                    </div>

                    <ButtonCn Class="w-full" Size="ButtonSize.Sm" OnClick="Next">
                        Continue
                    </ButtonCn>
                </div>
            }
            else if (_step == 1)
            {
                <div class="space-y-4">
                    <div class="flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                            @(string.IsNullOrEmpty(_email) ? "you@example.com" : _email)
                        </BadgeCn>
                    </div>

                    <div class="space-y-1.5">
                        <LabelCn For="login-ms-password" Class="text-xs font-medium text-muted-foreground">
                            Password
                        </LabelCn>
                        <InputCn id="login-ms-password" Type="password" Placeholder="Enter your password"
                                 @bind-Value="_password" />
                    </div>

                    <div class="flex gap-2">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="text-xs" OnClick="Prev">
                            Back
                        </ButtonCn>
                        <ButtonCn Class="flex-1" Size="ButtonSize.Sm" OnClick="Next">
                            Continue
                        </ButtonCn>
                    </div>
                </div>
            }
            else
            {
                <div class="space-y-4">
                    <div class="text-center">
                        <h3 class="text-sm font-medium">Enter verification code</h3>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            Check your authenticator app
                        </p>
                    </div>

                    <div class="flex justify-center">
                        <InputOtpCn MaxLength="6" @bind-Value="_otp">
                            <InputOtpGroupCn>
                                <InputOtpSlotCn Index="0" />
                                <InputOtpSlotCn Index="1" />
                                <InputOtpSlotCn Index="2" />
                                <InputOtpSlotCn Index="3" />
                                <InputOtpSlotCn Index="4" />
                                <InputOtpSlotCn Index="5" />
                            </InputOtpGroupCn>
                        </InputOtpCn>
                    </div>

                    <div class="flex gap-2">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="text-xs" OnClick="Prev">
                            Back
                        </ButtonCn>
                        <ButtonCn Class="flex-1" Size="ButtonSize.Sm" Disabled="@(_otp.Length < 6)">
                            Verify and sign in
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private int _step;
    private string _email = "";
    private string _password = "";
    private string _otp = "";

    private static readonly string[] _stepLabels = ["Email", "Password", "Verify"];

    private void Next() => _step = Math.Min(_step + 1, 2);
    private void Prev() => _step = Math.Max(_step - 1, 0);
}
