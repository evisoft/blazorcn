@* ============================================================
   Block: login-domain-routing
   Title: LoginDomainRouting
   Description: Email domain auto-routing React login block for Next.js with email input, automatic SSO provider detection based on domain, provider display with redirect button, and manual override using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-domain-routing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Sign in</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Enter your email and we'll route you to the right provider
            </p>
        </div>

        <div class="px-4 py-4">
            <div class="space-y-1.5">
                <LabelCn For="domain-email" Class="text-xs font-medium text-muted-foreground">
                    Work email
                </LabelCn>
                <InputCn id="domain-email" Type="email"
                         Placeholder="@("you@@company.com")"
                         @bind-Value="_email" />
            </div>

            @if (_matched != null)
            {
                <div class="mt-4">
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="flex items-center gap-3">
                            <div class="flex size-8 items-center justify-center rounded-md bg-background">
                                <LucideIconCn Name="building" Size="16" Class="size-4 text-muted-foreground" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">@_matched.Provider</p>
                                <p class="text-xs text-muted-foreground">
                                    @_matched.Type &middot; @_matched.Domain
                                </p>
                            </div>
                            @if (_matched.Enforced)
                            {
                                <div class="flex items-center gap-1 text-xs text-muted-foreground">
                                    <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                                    <span>Required</span>
                                </div>
                            }
                        </div>
                    </div>

                    <ButtonCn Class="mt-3 w-full gap-2" Size="ButtonSize.Sm">
                        Continue with @_matched.Provider
                        <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5" />
                    </ButtonCn>

                    @if (!_matched.Enforced)
                    {
                        <button type="button"
                                class="mt-2 block w-full text-center text-xs text-muted-foreground hover:text-foreground">
                            Use password instead
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="mt-4">
                    <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                        Continue with email
                    </ButtonCn>
                    <p class="mt-2 text-center text-xs text-muted-foreground">
                        We'll check if your organization uses SSO
                    </p>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Supported: Okta, Azure AD, Google Workspace, OneLogin
            </p>
        </div>
    </div>
</section>

@code {
    private string _email = "";

    private DomainConfig? _matched => _email.Contains('@')
        ? _domainMap.FirstOrDefault(d => _email.Split('@')[1] == d.Domain)
        : null;

    private static readonly DomainConfig[] _domainMap =
    [
        new DomainConfig("acme.com", "Okta SSO", "SAML 2.0", true),
        new DomainConfig("globex.io", "Azure AD", "OIDC", true),
        new DomainConfig("initech.co", "Google Workspace", "OAuth 2.0", false),
    ];

    private record DomainConfig(string Domain, string Provider, string Type, bool Enforced);
}
