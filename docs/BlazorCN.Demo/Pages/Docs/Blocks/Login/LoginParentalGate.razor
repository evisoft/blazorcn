@* ============================================================
   Block: login-parental-gate
   Title: LoginParentalGate
   Description: Parental verification gate React block for Next.js with age-appropriate challenge question, math problem, parent PIN entry, and kid-friendly visuals using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-parental-gate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
        <p class="text-sm font-medium">Parent Verification</p>
      </div>
      <p class="mt-0.5 text-xs text-muted-foreground">
        This area requires parental permission
      </p>
    </div>

    @if (_step == "challenge")
    {
      <div class="px-4 py-8">
        <div class="flex flex-col items-center">
          <div class="mb-4 flex size-12 items-center justify-center rounded-xl bg-muted/50">
            <LucideIconCn Name="lock" Size="24" Class="size-6 text-muted-foreground" />
          </div>
          <p class="text-sm font-medium">Are you a grown-up?</p>
          <p class="mt-1 text-xs text-muted-foreground">
            Solve this math problem to continue
          </p>

          <div class="mt-6 w-full max-w-[280px]">
            <div class="mb-4 rounded-md bg-muted/50 p-4 text-center">
              <p class="font-mono text-2xl font-semibold">15 + 27 = ?</p>
            </div>

            <div class="space-y-3">
              <InputCn
                type="text"
                inputmode="numeric"
                Placeholder="Enter your answer"
                @bind-Value="_answer"
                Class="text-center font-mono text-lg"
                maxlength="3" />
              <ButtonCn
                Class="w-full"
                Size="ButtonSize.Sm"
                @onclick="@(() => { if (_answer == _correctAnswer) _step = "pin"; })"
                Disabled="@(string.IsNullOrEmpty(_answer))">
                Check answer
              </ButtonCn>
            </div>

            @if (!string.IsNullOrEmpty(_answer) && _answer != _correctAnswer && _answer.Length >= 2)
            {
              <p class="mt-2 text-center text-xs text-red-500">
                That&apos;s not quite right. Try again!
              </p>
            }
          </div>
        </div>
      </div>
    }
    else
    {
      <div class="px-4 py-8">
        <div class="flex flex-col items-center">
          <div class="mb-4 flex size-12 items-center justify-center rounded-xl bg-emerald-500/10">
            <LucideIconCn Name="shield-check" Size="24" Class="size-6 text-emerald-600" />
          </div>
          <p class="text-sm font-medium">Enter parent PIN</p>
          <p class="mt-1 text-xs text-muted-foreground">
            Enter your 4-digit parental control PIN
          </p>

          <div class="mt-6 w-full max-w-[200px] space-y-3">
            <InputCn
              type="password"
              Placeholder="* * * *"
              @bind-Value="_pin"
              Class="text-center font-mono text-lg tracking-[0.5em]"
              maxlength="4" />
            <ButtonCn Class="w-full" Size="ButtonSize.Sm" Disabled="@(_pin.Length < 4)">
              Continue
            </ButtonCn>
          </div>
        </div>
      </div>
    }

    <div class="border-t px-4 py-3 text-center">
      <p class="text-xs text-muted-foreground">
        This verification helps keep children safe online
      </p>
    </div>
  </div>
</section>

@code {
    private string _answer = "";
    private string _step = "challenge";
    private string _pin = "";
    private const string _correctAnswer = "42";
}
