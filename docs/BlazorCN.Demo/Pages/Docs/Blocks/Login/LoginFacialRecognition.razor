@* ============================================================
   Block: login-facial-recognition
   Title: LoginFacialRecognition
   Description: Facial recognition scan React authentication block for Next.js with animated camera viewfinder, face scan overlay, progress indicator, and fallback options using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-facial-recognition.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="scan-face" Size="16" Class="size-4 text-muted-foreground" />
        <p class="text-sm font-medium">Face Verification</p>
      </div>
      <p class="mt-0.5 text-xs text-muted-foreground">
        Position your face in the frame to sign in
      </p>
    </div>

    <div class="flex flex-col items-center px-4 py-8">
      <div class="relative mb-6">
        @* Viewfinder frame *@
        <div class="relative flex size-40 items-center justify-center overflow-hidden rounded-2xl bg-zinc-950">
          @* Corner markers *@
          <div class="absolute top-2 left-2 size-6 rounded-tl-lg border-t-2 border-l-2 border-white/50"></div>
          <div class="absolute top-2 right-2 size-6 rounded-tr-lg border-t-2 border-r-2 border-white/50"></div>
          <div class="absolute bottom-2 left-2 size-6 rounded-bl-lg border-b-2 border-l-2 border-white/50"></div>
          <div class="absolute bottom-2 right-2 size-6 rounded-br-lg border-b-2 border-r-2 border-white/50"></div>

          @if (_scanning)
          {
            <div class="absolute inset-x-4 h-0.5 bg-blue-400/60 animate-[scanline_2s_ease-in-out_infinite]"></div>
          }

          @if (_verified)
          {
            <div class="flex size-12 items-center justify-center rounded-full bg-emerald-500/20">
              <LucideIconCn Name="check" Size="24" Class="size-6 text-emerald-500" />
            </div>
          }
          else
          {
            <LucideIconCn Name="user" Size="48" Class="size-12 text-zinc-600" />
          }
        </div>

        @if (_scanning)
        {
          <div class="absolute -top-1 -right-1 flex size-5 items-center justify-center rounded-full bg-red-500 animate-pulse">
            <LucideIconCn Name="camera" Size="12" Class="size-3 text-white" />
          </div>
        }
      </div>

      <p class="text-sm font-medium">
        @(_verified ? "Identity verified" : _scanning ? "Scanning your face..." : "Ready to scan")
      </p>
      <p class="mt-1 text-xs text-muted-foreground">
        @(_verified
          ? "Welcome back, Alex"
          : _scanning
            ? "Hold still and look directly at the camera"
            : "Make sure your face is well-lit and visible")
      </p>

      @if (_scanning)
      {
        <div class="mt-4 h-1 w-32 overflow-hidden rounded-full bg-muted">
          <div class="h-full rounded-full bg-blue-500 animate-[progress_3s_linear_forwards]"></div>
        </div>
      }

      @if (!_verified && !_scanning)
      {
        <ButtonCn Class="mt-6 gap-2" @onclick="HandleScan">
          <LucideIconCn Name="camera" Size="16" Class="size-4" />
          Start face scan
        </ButtonCn>
      }
    </div>

    <div class="border-t px-4 py-3">
      <div class="flex items-center justify-between">
        <p class="text-xs text-muted-foreground">Camera access required</p>
        <button
          type="button"
          class="text-xs text-muted-foreground transition-colors hover:text-foreground"
        >
          Use another method
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  @@keyframes scanline {
    0%, 100% { transform: translateY(-60px); }
    50% { transform: translateY(60px); }
  }
  @@keyframes progress {
    from { width: 0%; }
    to { width: 100%; }
  }
</style>

@code {
    private bool _scanning = false;
    private bool _verified = false;

    private async Task HandleScan()
    {
        _scanning = true;
        await Task.Delay(3000);
        _scanning = false;
        _verified = true;
    }
}
