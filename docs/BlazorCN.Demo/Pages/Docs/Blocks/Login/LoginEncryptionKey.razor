@* ============================================================
   Block: login-encryption-key
   Title: LoginEncryptionKey
   Description: Encryption key-based React authentication block for Next.js with key file upload zone, manual key paste textarea, key format validation indicator, and decrypt button using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-encryption-key.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="key" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Key Authentication</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Sign in using your encryption key</p>
        </div>

        <div class="px-4 py-4">
            @* Drop zone *@
            <div class="mb-4 flex flex-col items-center rounded-md border-2 border-dashed px-4 py-6 transition-colors hover:border-muted-foreground/30">
                <LucideIconCn Name="upload" Size="24" Class="mb-2 size-6 text-muted-foreground" />
                <p class="text-xs font-medium">Drop your key file here</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Supports .pem, .key, .p12 formats
                </p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 gap-1.5 text-xs">
                    <LucideIconCn Name="file-key" Size="14" Class="size-3.5" />
                    Browse files
                </ButtonCn>
            </div>

            @* Divider *@
            <div class="relative mb-1 py-2">
                <div class="absolute inset-0 flex items-center">
                    <div class="w-full border-t"></div>
                </div>
                <div class="relative flex justify-center">
                    <span class="bg-card px-3 text-xs text-muted-foreground">or paste your key</span>
                </div>
            </div>

            @* Textarea + status icon *@
            <div class="relative">
                <textarea
                    value="@_keyValue"
                    @oninput="@((ChangeEventArgs e) => HandleKeyChange(e.Value?.ToString() ?? ""))"
                    placeholder="@("-----BEGIN PRIVATE KEY-----\nPaste your key here...\n-----END PRIVATE KEY-----")"
                    rows="5"
                    class="w-full resize-none rounded-md border bg-zinc-950 p-3 font-mono text-xs text-zinc-300 placeholder:text-zinc-600 focus:outline-none focus:ring-1 focus:ring-ring">
                </textarea>
                @if (_keyStatus != KeyStatus.Empty)
                {
                    <div class="absolute top-2 right-2">
                        @if (_keyStatus == KeyStatus.Valid)
                        {
                            <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-500" />
                        }
                        else
                        {
                            <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-500" />
                        }
                    </div>
                }
            </div>

            @* Status message *@
            @if (_keyStatus == KeyStatus.Valid)
            {
                <p class="mt-1 text-xs text-emerald-600">
                    Valid key format detected
                </p>
            }
            @if (_keyStatus == KeyStatus.Invalid)
            {
                <p class="mt-1 text-xs text-red-500">
                    Invalid key format. Check the key and try again.
                </p>
            }

            <ButtonCn Class="mt-3 w-full" Size="ButtonSize.Sm" Disabled="@(_keyStatus != KeyStatus.Valid)">
                Decrypt and sign in
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Your key is processed locally and never sent to the server.
            </p>
        </div>
    </div>
</section>

@code {
    private string _keyValue = "";
    private KeyStatus _keyStatus = KeyStatus.Empty;

    private void HandleKeyChange(string val)
    {
        _keyValue = val;
        var trimmed = val.Trim();
        if (string.IsNullOrEmpty(trimmed))
        {
            _keyStatus = KeyStatus.Empty;
        }
        else if (val.Contains("BEGIN") && val.Contains("KEY"))
        {
            _keyStatus = KeyStatus.Valid;
        }
        else if (val.Length > 10)
        {
            _keyStatus = KeyStatus.Invalid;
        }
        else
        {
            _keyStatus = KeyStatus.Empty;
        }
    }

    private enum KeyStatus { Empty, Valid, Invalid }
}
