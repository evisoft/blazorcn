@* ============================================================
   Block: login-one-time-link
   Title: LoginOneTimeLink
   Description: One-time login link notification React block for Next.js with email confirmation, link expiry countdown, inbox check animation, and resend option using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-one-time-link.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">One-Time Sign-In Link</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @(_sent ? "Check your inbox for the login link" : "We'll send you a secure sign-in link")
            </p>
        </div>

        @if (!_sent)
        {
            <div class="px-4 py-6">
                <div class="flex flex-col items-center">
                    <div class="mb-4 flex size-10 items-center justify-center rounded-full bg-muted/50">
                        <LucideIconCn Name="mail" Size="20" Class="size-5 text-muted-foreground" />
                    </div>
                    <div class="w-full max-w-[300px] space-y-3">
                        <InputCn Type="email" Placeholder="@("you@@example.com")" @bind-Value="_email" />
                        <ButtonCn Class="w-full" Size="ButtonSize.Sm" OnClick="@(() => _sent = true)">
                            Send login link
                        </ButtonCn>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="px-4 py-8">
                <div class="flex flex-col items-center">
                    <div class="mb-4 flex size-12 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="inbox" Size="24" Class="size-6 text-emerald-600" />
                    </div>

                    <p class="text-sm font-medium">Link sent</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        We sent a one-time link to&#160;<span class="font-medium text-foreground">@(string.IsNullOrEmpty(_email) ? "you@@example.com" : _email)</span>
                    </p>

                    <div class="mt-4 flex items-center gap-1.5 rounded-md bg-muted/50 px-3 py-1.5">
                        <LucideIconCn Name="timer" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Expires in 10 minutes</span>
                    </div>

                    <div class="mt-5 flex gap-2">
                        @foreach (var client in _emailClients)
                        {
                            var item = client;
                            <button type="button"
                                    class="flex items-center gap-1 rounded-md bg-muted/50 px-2.5 py-1.5 text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                @item.Name
                            </button>
                        }
                    </div>

                    <div class="mt-5 flex flex-col items-center gap-2">
                        <button type="button"
                                class="text-xs font-medium text-foreground hover:underline">
                            Resend link
                        </button>
                        <button type="button"
                                @onclick="@(() => _sent = false)"
                                class="text-xs text-muted-foreground hover:text-foreground">
                            Use a different email
                        </button>
                    </div>
                </div>
            </div>
        }

        <div class="border-t px-4 py-3 text-center">
            <p class="text-xs text-muted-foreground">
                This link can only be used once and expires after 10 minutes
            </p>
        </div>
    </div>
</section>

@code {
    private string _email = "";
    private bool _sent;

    private static readonly EmailClient[] _emailClients =
    [
        new("Gmail", "https://mail.google.com"),
        new("Outlook", "https://outlook.live.com"),
        new("Yahoo", "https://mail.yahoo.com"),
    ];

    private record EmailClient(string Name, string Url);
}
