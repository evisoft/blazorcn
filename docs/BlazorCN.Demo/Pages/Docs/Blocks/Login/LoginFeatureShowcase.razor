@* ============================================================
   Block: login-feature-showcase
   Title: Login Feature Showcase
   Description: Split-panel React login block for Next.js with sign-in form and social buttons on left, product feature highlights with icons and descriptions on right, and staggered entrance animations using shadcn/ui Input, Button, Separator, Tailwind CSS, and framer-motion
   Long Description: Benefits checklist alongside form
   Dependencies: ButtonCn, InputCn, LabelCn, LucideBoltCn, LucideGlobeCn, LucideShieldCheckCn, LucideZapCn, SeparatorCn
   Source: original/blocks/login/login-feature-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid md:grid-cols-2">
            <div class="border-b md:border-b-0 md:border-r">
                <div class="border-b px-4 py-3">
                    <p class="text-sm font-medium">Sign in</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Enter your credentials to continue
                    </p>
                </div>
                <div class="space-y-4 px-4 py-4">
                    <div class="space-y-1.5">
                        <LabelCn For="fs-email" Class="text-xs">Email</LabelCn>
                        <InputCn id="fs-email" Type="email" Placeholder="@("you@@company.com")"
                                 @bind-Value="_email" />
                    </div>
                    <div class="space-y-1.5">
                        <div class="flex items-center justify-between">
                            <LabelCn For="fs-password" Class="text-xs">Password</LabelCn>
                            <span class="cursor-pointer text-xs text-muted-foreground underline underline-offset-2">
                                Forgot password?
                            </span>
                        </div>
                        <InputCn id="fs-password" Type="password" Placeholder="Enter your password"
                                 @bind-Value="_password" />
                    </div>
                    <ButtonCn Class="w-full">Sign in</ButtonCn>
                    <div class="flex items-center gap-3">
                        <SeparatorCn Class="flex-1" />
                        <span class="text-xs text-muted-foreground">or</span>
                        <SeparatorCn Class="flex-1" />
                    </div>
                    <div class="grid grid-cols-2 gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="text-xs">
                            Google
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="text-xs">
                            GitHub
                        </ButtonCn>
                    </div>
                </div>
            </div>

            <div class="flex flex-col justify-center p-6 lg:p-8">
                <p class="mb-4 text-xs font-medium text-muted-foreground">Why teams choose us</p>
                <div class="space-y-3">
                    @foreach (var feature in _features)
                    {
                        <div class="rounded-md bg-muted/50 p-3">
                            <div class="flex items-center gap-2">
                                @if (feature.Icon == "bolt")
                                {
                                    <LucideBoltCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else if (feature.Icon == "shield-check")
                                {
                                    <LucideShieldCheckCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else if (feature.Icon == "globe")
                                {
                                    <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideZapCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                <span class="text-sm font-medium">@feature.Title</span>
                            </div>
                            <p class="mt-1 text-xs text-muted-foreground">@feature.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _email = "";
    private string _password = "";

    private record Feature(string Icon, string Title, string Description);

    private static readonly Feature[] _features =
    [
        new("bolt", "Lightning fast", "Deploy in under 60 seconds"),
        new("shield-check", "Enterprise security", "SOC 2 and GDPR compliant"),
        new("globe", "Global edge network", "150+ points of presence"),
        new("zap", "99.9% uptime", "Guaranteed SLA with credits"),
    ];
}
