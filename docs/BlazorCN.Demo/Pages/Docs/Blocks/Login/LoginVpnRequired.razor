@* ============================================================
   Block: login-vpn-required
   Title: LoginVpnRequired
   Description: VPN required notification React login block for Next.js with network status check, VPN connection instructions, supported client list, connection troubleshooting, and retry mechanism using shadcn/ui, Tailwind CSS, and Lucide icons
   Source: original/blocks/login/login-vpn-required.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-4 py-3">
      <div class="flex items-center gap-2">
        @if (_status == "connected")
        {
          <LucideIconCn Name="shield" Size="16" Class="size-4 text-emerald-500" />
        }
        else
        {
          <LucideIconCn Name="shield-off" Size="16" Class="size-4 text-red-500" />
        }
        <p class="text-sm font-medium">VPN Connection Required</p>
      </div>
      <p class="mt-0.5 text-xs text-muted-foreground">
        You must be connected to the corporate VPN to sign in
      </p>
    </div>

    <div class="px-4 py-3">
      <div class="flex items-center gap-2">
        @if (_status == "disconnected")
        {
          <LucideIconCn Name="wifi-off" Size="14" Class="size-3.5 text-red-500" />
          <span class="text-xs font-medium text-red-600">VPN not detected</span>
          <span class="text-xs text-muted-foreground">
            &middot; Public network (74.125.xxx.xxx)
          </span>
        }
        @if (_status == "checking")
        {
          <LucideIconCn Name="wifi" Size="14" Class="size-3.5 text-amber-500" />
          <span class="text-xs font-medium text-amber-600">Checking connection...</span>
        }
        @if (_status == "connected")
        {
          <LucideIconCn Name="wifi" Size="14" Class="size-3.5 text-emerald-500" />
          <span class="text-xs font-medium text-emerald-600">VPN connected</span>
          <span class="text-xs text-muted-foreground">
            &middot; Corporate network (10.0.xxx.xxx)
          </span>
        }
      </div>
    </div>

    <hr class="shrink-0 bg-border h-[1px] w-full border-none" />

    @if (_status == "connected")
    {
      <div class="flex flex-col items-center px-4 py-6">
        <div class="mb-3 flex size-12 items-center justify-center rounded-full bg-emerald-500/10">
          <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-emerald-600" />
        </div>
        <p class="text-sm font-medium">VPN verified</p>
        <p class="mt-0.5 text-xs text-muted-foreground">You can now proceed to sign in</p>
        <ButtonCn Size="ButtonSize.Sm" Class="mt-4">
          Continue to sign in
        </ButtonCn>
      </div>
    }
    else
    {
      <div class="px-4 py-3">
        <p class="mb-2 text-xs font-medium text-muted-foreground">How to connect</p>
        <div class="space-y-2">
          <div class="flex items-start gap-2">
            <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-xs">
              1
            </span>
            <p class="text-xs text-muted-foreground">Open your VPN client application</p>
          </div>
          <div class="flex items-start gap-2">
            <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-xs">
              2
            </span>
            <p class="text-xs text-muted-foreground">
              Connect to <span class="font-mono">vpn.acme-corp.com</span>
            </p>
          </div>
          <div class="flex items-start gap-2">
            <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted text-xs">
              3
            </span>
            <p class="text-xs text-muted-foreground">Click retry below once connected</p>
          </div>
        </div>
      </div>

      <hr class="shrink-0 bg-border h-[1px] w-full border-none" />

      <div class="px-4 py-3">
        <p class="mb-2 text-xs font-medium text-muted-foreground">
          Supported VPN clients
        </p>
        <div class="space-y-1.5">
          @foreach (var client in _supportedClients)
          {
            <div class="flex items-center justify-between">
              <span class="text-xs">@client.Name</span>
              <span class="text-xs text-muted-foreground">@client.Platform</span>
            </div>
          }
        </div>
      </div>

      <hr class="shrink-0 bg-border h-[1px] w-full border-none" />

      <div class="px-4 py-3">
        <button
          type="button"
          class="text-xs text-muted-foreground transition-colors hover:text-foreground"
          @onclick="@(() => _showTroubleshooting = !_showTroubleshooting)"
        >
          @(_showTroubleshooting ? "Hide troubleshooting" : "Having trouble connecting?")
        </button>

        @if (_showTroubleshooting)
        {
          <div class="mt-2 rounded-md bg-muted/50 p-3">
            <ul class="space-y-1 text-xs text-muted-foreground">
              <li>Check that your VPN client is up to date</li>
              <li>Try disconnecting and reconnecting</li>
              <li>Ensure your network allows VPN traffic (port 443)</li>
              <li>Contact IT support if the issue persists</li>
            </ul>
          </div>
        }
      </div>

      <hr class="shrink-0 bg-border h-[1px] w-full border-none" />

      <div class="flex gap-2 px-4 py-3">
        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1 gap-1.5 text-xs">
          <LucideIconCn Name="external-link" Size="14" Class="size-3.5" />
          Download VPN client
        </ButtonCn>
        <ButtonCn
          Size="ButtonSize.Sm"
          Class="flex-1 gap-1.5 text-xs"
          OnClick="HandleRetry"
          Disabled="@(_status == "checking")"
        >
          <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
          @(_status == "checking" ? "Checking..." : "Retry connection")
        </ButtonCn>
      </div>
    }

    <div class="border-t px-4 py-3">
      <p class="text-xs text-muted-foreground">
        Contact IT support at support@@acme-corp.com for VPN access
      </p>
    </div>
  </div>
</section>

@code {
    private string _status = "disconnected";
    private bool _showTroubleshooting = false;

    private record VpnClient(string Name, string Platform);

    private static readonly VpnClient[] _supportedClients =
    [
        new("Cisco AnyConnect", "Windows, macOS, Linux"),
        new("GlobalProtect", "Windows, macOS"),
        new("WireGuard", "All platforms"),
    ];

    private async Task HandleRetry()
    {
        _status = "checking";
        await Task.Delay(2000);
        _status = "connected";
    }
}
