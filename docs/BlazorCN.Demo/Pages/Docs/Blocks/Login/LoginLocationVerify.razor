@* ============================================================
   Block: login-location-verify
   Title: LoginLocationVerify
   Description: Location verification React login block for Next.js with map placeholder, detected location display, distance from usual check, confirm and deny buttons using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-location-verify.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="map-pin" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Location Verification</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                We detected a sign-in from a new location
            </p>
        </div>

        @* Map + location details *@
        <div class="border-b px-4 py-4">
            @* Map placeholder *@
            <div class="relative mb-4 flex h-40 items-center justify-center overflow-hidden rounded-md bg-zinc-950">
                <div class="absolute inset-0 opacity-20">
                    <div class="absolute top-1/4 left-1/3 size-1 rounded-full bg-zinc-500"></div>
                    <div class="absolute top-1/2 left-1/2 size-1 rounded-full bg-zinc-500"></div>
                    <div class="absolute top-3/4 right-1/4 size-1 rounded-full bg-zinc-500"></div>
                    <div class="absolute top-1/3 right-1/3 size-1 rounded-full bg-zinc-500"></div>
                </div>
                <div class="relative">
                    <div class="flex size-8 items-center justify-center rounded-full bg-blue-500/20">
                        <div class="size-3 rounded-full bg-blue-500"></div>
                    </div>
                </div>
                <div class="absolute bottom-2 left-2 rounded bg-black/50 px-2 py-1 text-xs text-white">
                    San Francisco, CA
                </div>
            </div>

            <div class="space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium">Detected location</p>
                        <p class="text-xs text-muted-foreground">San Francisco, CA, United States</p>
                    </div>
                    <LucideIconCn Name="navigation" Size="16" Class="size-4 text-muted-foreground" />
                </div>

                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-xs font-medium">Usual location</p>
                        <p class="text-xs text-muted-foreground">New York, NY, United States</p>
                    </div>
                    <span class="rounded-md bg-amber-500/10 px-2 py-0.5 text-xs text-amber-600">
                        2,565 mi away
                    </span>
                </div>
            </div>
        </div>

        @* Warning banner *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 rounded-md bg-amber-500/10 p-3">
                <LucideIconCn Name="shield" Size="16" Class="size-4 shrink-0 text-amber-600" />
                <p class="text-xs text-amber-700 dark:text-amber-500">
                    This sign-in is from a location far from your usual area. Please confirm this is you.
                </p>
            </div>
        </div>

        @* Actions *@
        <div class="flex gap-2 px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1 gap-1.5">
                <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                Not me
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="flex-1 gap-1.5">
                <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                This is me
            </ButtonCn>
        </div>

    </div>
</section>

