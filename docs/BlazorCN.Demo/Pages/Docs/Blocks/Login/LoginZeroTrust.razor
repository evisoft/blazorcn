@* ============================================================
   Block: login-zero-trust
   Title: LoginZeroTrust
   Description: Zero-trust security verification React login block for Next.js with device posture check, network compliance validation, identity verification stages, policy enforcement display, and continuous assessment status using shadcn/ui, Tailwind CSS, and Lucide icons
   Source: original/blocks/login/login-zero-trust.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Zero-Trust Verification</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Every access request is verified before granting entry
            </p>
        </div>

        @if (_started)
        {
            <div class="border-b px-4 py-2">
                <div class="flex items-center justify-between">
                    <p class="text-xs text-muted-foreground">
                        @(_complete ? "Verification complete" : "Running security checks...")
                    </p>
                    <span class="font-mono text-xs text-muted-foreground">
                        @_passedCount/@_checks.Length passed
                    </span>
                </div>
                <div class="mt-1.5 h-1 w-full overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-emerald-500 transition-all duration-500"
                         style="@($"width:{(_checks.Length > 0 ? (_passedCount * 100 / _checks.Length) : 0)}%")">
                    </div>
                </div>
            </div>
        }

        <div>
            @for (var idx = 0; idx < _checks.Length; idx++)
            {
                var i = idx;
                var chk = _checks[i];
                <div>
                    <div class="flex items-start gap-3 px-4 py-3">
                        <div class="mt-0.5">
                            @if (chk.Status == CheckStatus.Pending)
                            {
                                <LucideIconCn Name="circle-dot" Size="16" Class="size-4 text-muted-foreground/40" />
                            }
                            else if (chk.Status == CheckStatus.Running)
                            {
                                <LucideIconCn Name="loader" Size="16" Class="size-4 animate-spin text-blue-500" />
                            }
                            else if (chk.Status == CheckStatus.Pass)
                            {
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                            }
                            else
                            {
                                <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-500" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="@chk.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                                <p class="text-sm font-medium">@chk.Label</p>
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">
                                @(string.IsNullOrEmpty(chk.Details) ? chk.Description : chk.Details)
                            </p>
                        </div>
                        @if (chk.Status == CheckStatus.Pass)
                        {
                            <span class="size-1.5 mt-2 rounded-full bg-emerald-500"></span>
                        }
                        @if (chk.Status == CheckStatus.Fail)
                        {
                            <span class="size-1.5 mt-2 rounded-full bg-red-500"></span>
                        }
                    </div>
                    @if (i < _checks.Length - 1)
                    {
                        <div class="h-px bg-border"></div>
                    }
                </div>
            }
        </div>

        <div class="h-px bg-border"></div>

        @if (!_started)
        {
            <div class="flex flex-col items-center px-4 py-4">
                <p class="mb-3 text-xs text-muted-foreground">
                    @_checks.Length security checks will be performed
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5" OnClick="StartVerification">
                    <LucideIconCn Name="shield-check" Size="14" Class="size-3.5" />
                    Begin verification
                </ButtonCn>
            </div>
        }
        else if (_complete)
        {
            <div class="flex flex-col items-center px-4 py-4">
                <div class="mb-3 flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="lock" Size="16" Class="size-4 text-emerald-600" />
                </div>
                <p class="text-sm font-medium">Access granted</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    All zero-trust checks passed successfully
                </p>
                <ButtonCn Size="ButtonSize.Sm" Class="mt-3">
                    Continue to application
                </ButtonCn>
            </div>
        }
        else
        {
            <div class="px-4 py-3 text-center">
                <p class="text-xs text-muted-foreground">
                    Verification in progress. Do not close this window.
                </p>
            </div>
        }

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span>Policy: zero-trust-prod-v2</span>
                <span class="flex items-center gap-1">
                    <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                    Continuous assessment enabled
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private enum CheckStatus { Pending, Running, Pass, Fail }

    private record SecurityCheck(string Id, string Label, string Description, string Icon)
    {
        public CheckStatus Status { get; set; } = CheckStatus.Pending;
        public string Details { get; set; } = "";
    }

    private SecurityCheck[] _checks =
    [
        new("device",   "Device posture",        "OS version, disk encryption, firewall",       "laptop"),
        new("network",  "Network compliance",     "Connection type, DNS, TLS version",           "network"),
        new("identity", "Identity verification",  "MFA, session freshness, credentials",         "user-check"),
        new("policy",   "Policy enforcement",     "Access rules, role mapping, permissions",     "shield-check"),
    ];

    private static readonly (string Id, CheckStatus Status, string Details)[] _results =
    [
        ("device",   CheckStatus.Pass, "macOS 15.2, FileVault enabled, Firewall active"),
        ("network",  CheckStatus.Pass, "Corporate WiFi, DoH enabled, TLS 1.3"),
        ("identity", CheckStatus.Pass, "MFA verified, session age 0m, credentials valid"),
        ("policy",   CheckStatus.Pass, "Role: admin, access level: full, geo: allowed"),
    ];

    private bool _started;
    private bool _complete;

    private int _passedCount => Array.FindAll(_checks, c => c.Status == CheckStatus.Pass).Length;

    private async Task StartVerification()
    {
        _started = true;
        StateHasChanged();

        for (var index = 0; index < _checks.Length; index++)
        {
            var i = index;
            await Task.Delay(i == 0 ? 0 : 1200);
            _checks[i].Status = CheckStatus.Running;
            StateHasChanged();

            await Task.Delay(800);
            var result = _results[i];
            _checks[i].Status = result.Status;
            _checks[i].Details = result.Details;
            StateHasChanged();
        }

        await Task.Delay(500);
        _complete = true;
        StateHasChanged();
    }
}
