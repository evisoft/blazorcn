@* ============================================================
   Block: login-terms-consent
   Title: Login Terms Consent
   Description: React login form block for Next.js with required terms of service and privacy policy consent checkboxes, optional marketing opt-in, conditional submit button, and slide-up animation using shadcn/ui Checkbox, Input, Button, Tailwind CSS, and framer-motion
   Long Description: Registration with password strength
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn
   Source: original/blocks/login/login-terms-consent.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Create your account</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Please review and accept our policies to continue
            </p>
        </div>

        <div class="px-4 py-4">
            <div class="space-y-4">
                <div class="space-y-2">
                    <LabelCn For="tc-email" Class="text-xs">Email address</LabelCn>
                    <InputCn id="tc-email" Type="email" Placeholder="@("you@@example.com")" />
                </div>
                <div class="space-y-2">
                    <LabelCn For="tc-password" Class="text-xs">Password</LabelCn>
                    <InputCn id="tc-password" Type="password" Placeholder="Min. 8 characters" />
                </div>
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <p class="mb-3 text-xs font-medium text-muted-foreground">Required agreements</p>
            <div class="space-y-3">
                <span class="flex items-start gap-2.5">
                    <CheckboxCn Checked="@_termsAccepted"
                                CheckedChanged="@((bool v) => _termsAccepted = v)"
                                Class="mt-0.5" />
                    <span class="text-xs leading-relaxed text-muted-foreground">
                        I agree to the
                        <span class="text-foreground underline underline-offset-2">Terms of Service</span>
                    </span>
                </span>
                <span class="flex items-start gap-2.5">
                    <CheckboxCn Checked="@_privacyAccepted"
                                CheckedChanged="@((bool v) => _privacyAccepted = v)"
                                Class="mt-0.5" />
                    <span class="text-xs leading-relaxed text-muted-foreground">
                        I agree to the
                        <span class="text-foreground underline underline-offset-2">Privacy Policy</span>
                    </span>
                </span>
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <span class="flex items-start gap-2.5">
                <CheckboxCn Checked="@_updatesOptIn"
                            CheckedChanged="@((bool v) => _updatesOptIn = v)"
                            Class="mt-0.5" />
                <span class="text-xs leading-relaxed text-muted-foreground">
                    Send me product updates and tips (optional)
                </span>
            </span>
        </div>

        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full" Disabled="@(!CanSubmit)">
                @(CanSubmit ? "Sign in" : "Accept terms to continue")
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _termsAccepted;
    private bool _privacyAccepted;
    private bool _updatesOptIn;

    private bool CanSubmit => _termsAccepted && _privacyAccepted;
}
