@* ============================================================
   Block: login-security-audit
   Title: LoginSecurityAudit
   Description: Security audit before login React block for Next.js with checklist of security items, pass and fail indicators, overall score, and remediation suggestions using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-security-audit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Security Check</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Verifying your environment before sign-in
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="font-mono text-2xl font-semibold tabular-nums">
                    @_passCount/@_total
                </span>
                <div>
                    <p class="text-xs font-medium">Checks passed</p>
                    <p class="text-xs text-muted-foreground">
                        @(_passCount == _total ? "All clear" : "Some issues need attention")
                    </p>
                </div>
            </div>
        </div>

        <div>
            @foreach (var item in _auditItems)
            {
                <div class="flex items-center gap-3 border-b px-4 py-2.5 last:border-b-0">
                    <LucideIconCn Name="@StatusIcon(item.Status)" Size="16" Class="@($"size-4 shrink-0 {StatusColor(item.Status)}")" />
                    <div class="min-w-0 flex-1">
                        <p class="text-xs font-medium">@item.Label</p>
                        <p class="text-xs text-muted-foreground">@item.Detail</p>
                    </div>
                    @if (item.Status == "fail")
                    {
                        <button type="button" class="text-xs text-muted-foreground hover:text-foreground">
                            Fix
                        </button>
                    }
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-1.5 text-xs">
                    <LucideIconCn Name="refresh-cw" Size="14" Class="size-3.5" />
                    Re-check
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="flex-1">
                    Continue to sign in
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record AuditItem(string Id, string Label, string Status, string Detail);

    private static readonly AuditItem[] _auditItems =
    [
        new("a1", "HTTPS connection",       "pass", "TLS 1.3 encrypted"),
        new("a2", "Browser version",        "pass", "Chrome 122 (up to date)"),
        new("a3", "JavaScript enabled",     "pass", "Required for authentication"),
        new("a4", "Cookies enabled",        "pass", "Session cookies allowed"),
        new("a5", "Screen lock",            "warn", "No screen lock detected"),
        new("a6", "Password manager",       "pass", "Detected and recommended"),
        new("a7", "Suspicious extensions",  "fail", "1 flagged extension found"),
    ];

    private static int _passCount => Array.FindAll(_auditItems, i => i.Status == "pass").Length;
    private static int _total => _auditItems.Length;

    private static string StatusIcon(string status) => status switch
    {
        "pass" => "check-circle",
        "warn" => "alert-triangle",
        "fail" => "x-circle",
        _      => "circle",
    };

    private static string StatusColor(string status) => status switch
    {
        "pass" => "text-emerald-500",
        "warn" => "text-amber-500",
        "fail" => "text-red-500",
        _      => "",
    };
}
