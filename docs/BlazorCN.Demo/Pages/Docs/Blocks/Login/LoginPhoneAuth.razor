@* ============================================================
   Block: login-phone-auth
   Title: Login Phone Auth
   Description: Phone number React sign-in block for Next.js with country code selector dropdown, phone input with international dial code, SMS verification note, and slide-up animation using shadcn/ui Select, Input, Button, Tailwind CSS, and framer-motion
   Long Description: Six-digit verification code entry
   Dependencies: ButtonCn, InputCn, LabelCn, LucideMailCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, SeparatorCn
   Source: original/blocks/login/login-phone-auth.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Sign in with phone</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                We'll text you a verification code
            </p>
        </div>

        <div class="space-y-4 px-4 py-4">
            <div class="space-y-2">
                <LabelCn For="phone-country" Class="text-xs font-medium text-muted-foreground">
                    Country
                </LabelCn>
                <SelectCn Value="@_country" ValueChanged="@(v => _country = v)">
                    <SelectTriggerCn id="phone-country" Class="w-full">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var c in _countries)
                        {
                            <SelectItemCn Value="@c.Code">
                                @c.Flag @c.Name (@c.Dial)
                            </SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>

            <div class="space-y-2">
                <LabelCn For="phone-number-input" Class="text-xs font-medium text-muted-foreground">
                    Phone number
                </LabelCn>
                <div class="flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Class="shrink-0 gap-1.5" Size="ButtonSize.Sm">
                        @SelectedCountry.Flag @SelectedCountry.Dial
                    </ButtonCn>
                    <InputCn id="phone-number-input" Type="tel" Placeholder="(555) 123-4567"
                             Class="flex-1" />
                </div>
            </div>

            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                Send verification code
            </ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                Standard SMS rates may apply
            </p>

            <div class="flex items-center gap-3">
                <SeparatorCn Class="flex-1" />
                <span class="text-xs text-muted-foreground">or</span>
                <SeparatorCn Class="flex-1" />
            </div>

            <ButtonCn Variant="ButtonVariant.Outline" Class="w-full gap-2" Size="ButtonSize.Sm">
                <LucideMailCn Size="14" Class="size-3.5" />
                Sign in with email
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _country = "US";

    private record Country(string Code, string Flag, string Dial, string Name);

    private static readonly Country[] _countries =
    [
        new("US", "\U0001F1FA\U0001F1F8", "+1", "United States"),
        new("GB", "\U0001F1EC\U0001F1E7", "+44", "United Kingdom"),
        new("DE", "\U0001F1E9\U0001F1EA", "+49", "Germany"),
        new("FR", "\U0001F1EB\U0001F1F7", "+33", "France"),
        new("JP", "\U0001F1EF\U0001F1F5", "+81", "Japan"),
    ];

    private Country SelectedCountry => _countries.FirstOrDefault(c => c.Code == _country) ?? _countries[0];
}
