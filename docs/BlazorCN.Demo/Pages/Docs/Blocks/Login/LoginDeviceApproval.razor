@* ============================================================
   Block: login-device-approval
   Title: LoginDeviceApproval
   Description: New device approval React authentication block for Next.js with device info display, location and browser details, approve and deny buttons, and notification to trusted device using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-device-approval.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <p class="text-sm font-medium">New Device Detected</p>
        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
          Approval needed
        </BadgeCn>
      </div>
      <p class="mt-0.5 text-xs text-muted-foreground">
        A sign-in attempt was made from an unrecognized device
      </p>
    </div>

    <div class="px-4 py-4">
      <div class="rounded-md bg-muted/50 p-4">
        <div class="mb-3 flex items-center gap-3">
          <div class="flex size-10 items-center justify-center rounded-lg bg-background">
            <LucideLaptopCn Size="20" Class="size-5 text-muted-foreground" />
          </div>
          <div>
            <p class="text-sm font-medium">MacBook Pro</p>
            <p class="text-xs text-muted-foreground">Chrome 122 on macOS</p>
          </div>
        </div>

        <div class="space-y-2">
          <div class="flex items-center gap-2 text-xs text-muted-foreground">
            <LucideMapPinCn Size="14" Class="size-3.5" />
            <span>San Francisco, CA, United States</span>
          </div>
          <div class="flex items-center gap-2 text-xs text-muted-foreground">
            <LucideGlobeCn Size="14" Class="size-3.5" />
            <span>IP: 192.168.1.***</span>
          </div>
          <div class="flex items-center gap-2 text-xs text-muted-foreground">
            <LucideMonitorCn Size="14" Class="size-3.5" />
            <span>First time sign-in from this device</span>
          </div>
        </div>
      </div>

      <p class="mt-3 text-xs text-muted-foreground">
        Requested 2 minutes ago by alex@@acme.com
      </p>
    </div>

    @if (_decision == "pending")
    {
      <div class="flex gap-2 border-t px-4 py-3">
        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1 gap-1.5" OnClick="@(() => _decision = "denied")">
          <LucideXCn Size="14" Class="size-3.5" />
          Deny
        </ButtonCn>
        <ButtonCn Size="ButtonSize.Sm" Class="flex-1 gap-1.5" OnClick="@(() => _decision = "approved")">
          <LucideCheckCn Size="14" Class="size-3.5" />
          Approve
        </ButtonCn>
      </div>
    }
    else
    {
      <div class="border-t px-4 py-3">
        <div class="flex items-center gap-2">
          <span class="@($"size-1.5 rounded-full {(_decision == "approved" ? "bg-emerald-500" : "bg-red-500")}")"></span>
          <p class="text-xs font-medium">
            @(_decision == "approved" ? "Device approved" : "Access denied")
          </p>
          <p class="text-xs text-muted-foreground">
            @(_decision == "approved" ? "This device is now trusted" : "The sign-in attempt was blocked")
          </p>
        </div>
      </div>
    }
  </div>
</section>

@code {
  private string _decision = "pending";
}
