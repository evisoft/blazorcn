@* ============================================================
   Block: login-device-management
   Title: LoginDeviceManagement
   Description: Login with device trust management React block for Next.js with trusted device list, current session indicator, revoke buttons, and remember-device toggle using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-device-management.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Trusted Devices</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Manage devices that can sign in without additional verification
            </p>
        </div>

        <div>
            @foreach (var dev in _devices)
            {
                var device = dev;
                <div class="flex items-center gap-3 border-b px-4 py-3 last:border-b-0">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucideIconCn Name="@DeviceIconName(device.Icon)" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <p class="text-sm font-medium">@device.Name</p>
                            @if (device.Current)
                            {
                                <span class="rounded bg-emerald-500/10 px-1.5 py-0.5 text-xs text-emerald-600">
                                    Current
                                </span>
                            }
                        </div>
                        <p class="text-xs text-muted-foreground">
                            @device.Browser &middot; @device.Location &middot; @device.LastActive
                        </p>
                    </div>
                    @if (!device.Current)
                    {
                        <button type="button"
                                aria-label="Revoke @device.Name"
                                @onclick="@(() => RevokeDevice(device.Id))"
                                class="rounded-md p-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                            <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                        </button>
                    }
                </div>
            }
        </div>

        <div class="flex items-center justify-between border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                @_devices.Length trusted @(_devices.Length == 1 ? "device" : "devices")
            </p>
            <ButtonCn Size="ButtonSize.Sm">Continue to sign in</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TrustedDevice(string Id, string Name, string Browser, string Location, string LastActive, string Icon, bool Current);

    private static readonly TrustedDevice[] _initialDevices =
    [
        new("d1", "MacBook Pro",      "Chrome 122", "San Francisco, CA", "Now",         "laptop",  true),
        new("d2", "iPhone 15",        "Safari 17",  "San Francisco, CA", "1 hour ago",  "phone",   false),
        new("d3", "Windows Desktop",  "Edge 121",   "New York, NY",      "3 days ago",  "desktop", false),
        new("d4", "iPad Air",         "Safari 17",  "San Francisco, CA", "1 week ago",  "phone",   false),
    ];

    private TrustedDevice[] _devices = _initialDevices;

    private void RevokeDevice(string id)
    {
        _devices = _devices.Where(d => d.Id != id).ToArray();
    }

    private static string DeviceIconName(string icon) => icon switch
    {
        "laptop"  => "laptop",
        "phone"   => "smartphone",
        "desktop" => "monitor",
        _         => "monitor",
    };
}
