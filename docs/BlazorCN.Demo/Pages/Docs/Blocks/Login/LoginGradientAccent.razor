@* ============================================================
   Block: login-gradient-accent
   Title: Login Gradient Accent
   Description: Clean React login form block for Next.js with animated gradient accent line at top of card, email and password fields, terms links, and width animation using shadcn/ui Input, Button, Label, Tailwind CSS, and framer-motion scaleX transition
   Long Description: Orchestrated entrance animations
   Dependencies: ButtonCn, InputCn, LabelCn
   Source: original/blocks/login/login-gradient-accent.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="h-1 bg-gradient-to-r from-violet-500 via-purple-500 to-fuchsia-500" />

        <div class="p-6">
            <div class="mb-6">
                <h2 class="text-sm font-medium">Sign in</h2>
                <p class="mt-1 text-xs text-muted-foreground">Enter your credentials to continue</p>
            </div>

            <div class="space-y-4">
                <div class="space-y-2">
                    <LabelCn For="grad-email" Class="text-xs text-muted-foreground">Email</LabelCn>
                    <InputCn id="grad-email" Type="email" Placeholder="@("name@@company.com")"
                             Class="h-8 text-sm" />
                </div>

                <div class="space-y-2">
                    <LabelCn For="grad-password" Class="text-xs text-muted-foreground">Password</LabelCn>
                    <InputCn id="grad-password" Type="password" Placeholder="Enter password"
                             Class="h-8 text-sm" />
                </div>

                <ButtonCn Class="h-8 w-full text-xs">Sign in</ButtonCn>

                <div class="flex items-center justify-between">
                    <button type="button"
                            class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                        Forgot password?
                    </button>
                    <button type="button"
                            class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                        Create account
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

