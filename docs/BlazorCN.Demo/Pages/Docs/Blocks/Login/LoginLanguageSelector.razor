@* ============================================================
   Block: login-language-selector
   Title: Login Language Selector
   Description: Internationalized React login form for Next.js with language locale selector supporting English Spanish French German and Japanese, translated form labels, and fade animation on language change using shadcn/ui Select, Input, Button, Tailwind CSS, and framer-motion
   Long Description: React Login Gradient Accent Block
   Dependencies: ButtonCn, InputCn, LabelCn, LucideGlobeCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn
   Source: original/blocks/login/login-language-selector.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex items-center justify-between border-b px-4 py-3">
            <p class="text-sm font-medium">Sign in</p>
            <div class="flex items-center gap-1.5">
                <LucideGlobeCn Size="14" Class="size-3.5 text-muted-foreground" />
                <SelectCn TValue="string" Value="@_locale" ValueChanged="@(v => _locale = v)">
                    <SelectTriggerCn Class="h-7 w-[120px] text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        @foreach (var lang in _languages)
                        {
                            <SelectItemCn Value="@lang.Value">
                                <span class="text-xs">@lang.NativeLabel</span>
                            </SelectItemCn>
                        }
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        <div class="px-4 py-4">
            <div class="space-y-4">
                <div class="space-y-2">
                    <LabelCn For="ls-email" Class="text-xs">@CurrentTranslation.EmailLabel</LabelCn>
                    <InputCn id="ls-email" Type="email" Placeholder="@("you@@example.com")" />
                </div>
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <LabelCn For="ls-password" Class="text-xs">@CurrentTranslation.PasswordLabel</LabelCn>
                        <button type="button"
                                class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                            @CurrentTranslation.ForgotPassword
                        </button>
                    </div>
                    <InputCn id="ls-password" Type="password" Placeholder="********" />
                </div>
                <ButtonCn Class="w-full">@CurrentTranslation.SignInButton</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string _locale = "en";

    private record Language(string Value, string NativeLabel);
    private record Translation(string EmailLabel, string PasswordLabel, string SignInButton, string ForgotPassword);

    private static readonly Language[] _languages =
    [
        new("en", "English"),
        new("es", "Espa\u00f1ol"),
        new("fr", "Fran\u00e7ais"),
        new("de", "Deutsch"),
        new("ja", "\u65e5\u672c\u8a9e"),
    ];

    private static readonly Dictionary<string, Translation> _translations = new()
    {
        ["en"] = new("Email address", "Password", "Sign in", "Forgot password?"),
        ["es"] = new("Correo electr\u00f3nico", "Contrase\u00f1a", "Iniciar sesi\u00f3n", "\u00bfOlvidaste tu contrase\u00f1a?"),
        ["fr"] = new("Adresse e-mail", "Mot de passe", "Se connecter", "Mot de passe oubli\u00e9 ?"),
        ["de"] = new("E-Mail-Adresse", "Passwort", "Anmelden", "Passwort vergessen?"),
        ["ja"] = new("\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9", "\u30d1\u30b9\u30ef\u30fc\u30c9", "\u30b5\u30a4\u30f3\u30a4\u30f3", "\u30d1\u30b9\u30ef\u30fc\u30c9\u3092\u304a\u5fd8\u308c\u3067\u3059\u304b\uff1f"),
    };

    private Translation CurrentTranslation => _translations.GetValueOrDefault(_locale, _translations["en"])!;
}
