@* ============================================================
   Block: login-split-brand
   Title: Login Split Brand
   Description: Split-panel React login block for Next.js with dark branding sidebar featuring company name, tagline, and feature bullets alongside an email password sign-in form with remember me checkbox using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Dark testimonial panel with login form
   Dependencies: ButtonCn, CheckboxCn, InputCn, LabelCn
   Source: original/blocks/login/login-split-brand.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid md:grid-cols-2">
            <div class="relative flex min-h-[400px] flex-col justify-between border-b bg-zinc-950 p-8 text-white md:border-b-0 md:border-r lg:p-12"
                 style="background-image: radial-gradient(circle, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 24px 24px;">
                <div>
                    <h2 class="text-2xl font-semibold tracking-tight">Acme</h2>
                    <p class="mt-2 text-sm text-zinc-400">Build something amazing.</p>
                </div>

                <div>
                    <p class="text-sm italic text-zinc-400">
                        &ldquo;The best developer experience I've used. It changed how our entire team ships product.&rdquo;
                    </p>
                    <p class="mt-2 text-xs text-zinc-500">&mdash; Sarah Chen, CTO at Linear</p>
                </div>
            </div>

            <div class="flex flex-col justify-center px-6 py-8 lg:px-10">
                <div class="mb-5">
                    <h3 class="text-sm font-medium">Sign in to your account</h3>
                    <p class="mt-0.5 text-xs text-muted-foreground">Enter your credentials below</p>
                </div>

                <div class="space-y-4">
                    <div class="space-y-1.5">
                        <LabelCn For="login-split-b-email" Class="text-xs font-medium text-muted-foreground">
                            Email
                        </LabelCn>
                        <InputCn id="login-split-b-email" Type="email" Placeholder="@("you@@company.com")"
                                 @bind-Value="_email" />
                    </div>

                    <div class="space-y-1.5">
                        <LabelCn For="login-split-b-password" Class="text-xs font-medium text-muted-foreground">
                            Password
                        </LabelCn>
                        <InputCn id="login-split-b-password" Type="password" Placeholder="Enter your password"
                                 @bind-Value="_password" />
                    </div>

                    <div class="flex items-center justify-between">
                        <span class="flex cursor-pointer items-center gap-2">
                            <CheckboxCn id="login-split-b-remember" aria-label="Remember me" />
                            <span class="text-xs text-muted-foreground">Remember me</span>
                        </span>
                        <span class="cursor-pointer text-xs text-muted-foreground hover:text-foreground">
                            Forgot password?
                        </span>
                    </div>

                    <ButtonCn Class="w-full" Size="ButtonSize.Sm">Sign in</ButtonCn>

                    <p class="text-center text-xs text-muted-foreground">
                        Need an account?
                        <span class="cursor-pointer font-medium text-foreground hover:underline">Contact sales</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _email = "";
    private string _password = "";
}
