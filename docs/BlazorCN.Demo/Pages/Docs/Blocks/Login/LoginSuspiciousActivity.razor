@* ============================================================
   Block: login-suspicious-activity
   Title: LoginSuspiciousActivity
   Description: Suspicious activity warning React authentication block for Next.js with threat details display, unusual location and device info, identity verification prompt, and account recovery options using shadcn/ui, Tailwind CSS, and Lucide icons
   Source: original/blocks/login/login-suspicious-activity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <LucideShieldAlertCn Size="16" Class="size-4 text-red-500" />
        <p class="text-sm font-medium">Suspicious Activity Detected</p>
      </div>
      <p class="mt-0.5 text-xs text-muted-foreground">
        We blocked an unusual sign-in attempt on your account
      </p>
    </div>

    @if (_step == "warning")
    {
      <div class="px-4 py-3">
        <div class="rounded-md bg-red-500/5 p-3">
          <div class="flex items-center gap-2">
            <LucideTriangleAlertCn Size="14" Class="size-3.5 text-red-500" />
            <p class="text-xs font-medium text-red-600">
              Login attempt blocked 14 minutes ago
            </p>
          </div>
          <p class="mt-1 text-xs text-muted-foreground">
            Someone tried to sign in to your account from an unrecognized location and device.
          </p>
        </div>
      </div>

      <div class="border-t"></div>

      <div class="px-4 py-3">
        <p class="mb-2 text-xs font-medium text-muted-foreground">Threat details</p>
        <div class="space-y-2">
          @foreach (var threat in _threats)
          {
            var t = threat;
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2 text-xs text-muted-foreground">
                @if (t.Icon == "map-pin")
                {
                  <LucideMapPinCn Size="14" Class="size-3.5" />
                }
                else if (t.Icon == "laptop")
                {
                  <LucideLaptopCn Size="14" Class="size-3.5" />
                }
                else
                {
                  <LucideGlobeCn Size="14" Class="size-3.5" />
                }
                <span>@t.Label</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="font-mono text-xs">@t.Value</span>
                <span class="@($"size-1.5 rounded-full {(t.Severity == "high" ? "bg-red-500" : "bg-amber-500")}")"></span>
              </div>
            </div>
          }
        </div>
      </div>

      <div class="border-t"></div>

      <div class="flex gap-2 px-4 py-3">
        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1 gap-1.5 text-xs" OnClick="@(() => _step = "verify")">
          <LucideKeyRoundCn Size="14" Class="size-3.5" />
          This was me
        </ButtonCn>
        <ButtonCn Size="ButtonSize.Sm" Class="flex-1 gap-1.5 text-xs" OnClick="@(() => _step = "verify")">
          <LucideLockCn Size="14" Class="size-3.5" />
          Secure my account
        </ButtonCn>
      </div>
    }

    @if (_step == "verify")
    {
      <div class="px-4 py-4">
        <div class="mb-3 rounded-md bg-muted/50 p-3">
          <p class="text-xs font-medium text-muted-foreground">
            Verify your identity to continue
          </p>
          <p class="mt-0.5 text-xs text-muted-foreground">
            Enter your current password to confirm it's you
          </p>
        </div>

        <div class="space-y-1.5">
          <LabelCn For="suspicious-pw" Class="text-xs font-medium text-muted-foreground">
            Current password
          </LabelCn>
          <InputCn id="suspicious-pw" type="password" Placeholder="Enter your password" @bind-Value="_password" />
        </div>

        <ButtonCn Class="mt-3 w-full" Size="ButtonSize.Sm" OnClick="@(() => _step = "secured")" Disabled="@(string.IsNullOrEmpty(_password))">
          Verify identity
        </ButtonCn>

        <button
          type="button"
          class="mt-2 block w-full text-center text-xs text-muted-foreground hover:text-foreground"
        >
          I can't access my password
        </button>
      </div>
    }

    @if (_step == "secured")
    {
      <div class="px-4 py-6">
        <div class="flex flex-col items-center text-center">
          <div class="mb-3 flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
            <LucideLockCn Size="16" Class="size-4 text-emerald-600" />
          </div>
          <p class="text-sm font-medium">Account secured</p>
          <p class="mt-0.5 max-w-[280px] text-xs text-muted-foreground">
            The suspicious session has been terminated and your account is safe.
          </p>
          <div class="mt-4 flex gap-2">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="text-xs">
              Review activity
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="text-xs">
              Change password
            </ButtonCn>
          </div>
        </div>
      </div>
    }

    <div class="border-t px-4 py-3">
      <p class="text-xs text-muted-foreground">
        If you don't recognize this activity, change your password immediately
      </p>
    </div>
  </div>
</section>

@code {
    private string _step = "warning";
    private string _password = "";

    private record ThreatDetail(string Icon, string Label, string Value, string Severity);

    private static readonly ThreatDetail[] _threats =
    [
        new("map-pin", "Location", "Moscow, Russia", "high"),
        new("laptop", "Device", "Unknown Linux device", "high"),
        new("globe", "IP address", "91.214.xxx.xxx", "medium"),
    ];
}
