@* ============================================================
   Block: login-developer-api
   Title: Login Developer Api
   Description: Developer-focused React authentication block for Next.js with tabbed interface switching between email password login and API key token authentication with code snippet hint using shadcn/ui Tabs, Input, Tailwind CSS, and framer-motion
   Long Description: JWT and API token authentication
   Dependencies: ButtonCn, InputCn, LabelCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/login/login-developer-api.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Developer Authentication</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Sign in with credentials or authenticate via API key
            </p>
        </div>

        <div class="px-4 py-4">
            <TabsCn DefaultValue="password">
                <TabsListCn Class="w-full">
                    <TabsTriggerCn Value="password" Class="flex-1">Password</TabsTriggerCn>
                    <TabsTriggerCn Value="api-key" Class="flex-1">API Key</TabsTriggerCn>
                </TabsListCn>

                <TabsContentCn Value="password">
                    <div class="mt-4 space-y-4">
                        <div class="space-y-2">
                            <LabelCn For="dev-email" Class="text-xs">Email</LabelCn>
                            <InputCn id="dev-email" Type="email" Placeholder="@("dev@@company.com")" />
                        </div>
                        <div class="space-y-2">
                            <LabelCn For="dev-password" Class="text-xs">Password</LabelCn>
                            <InputCn id="dev-password" Type="password" Placeholder="********" />
                        </div>
                        <ButtonCn Class="w-full">Sign in</ButtonCn>
                    </div>
                </TabsContentCn>

                <TabsContentCn Value="api-key">
                    <div class="mt-4 space-y-4">
                        <div class="space-y-2">
                            <LabelCn For="dev-apikey" Class="text-xs">Paste your API key</LabelCn>
                            <InputCn id="dev-apikey" Type="password" Placeholder="sk_live_..."
                                     Class="font-mono text-sm" />
                        </div>

                        <div class="rounded-md bg-zinc-950 p-3">
                            <code class="font-mono text-xs text-zinc-300">
                                <span class="text-zinc-500"># Include in request headers</span>
                                <br />
                                curl -H "Authorization: Bearer sk_live_..."
                                <br />
                                @("  ")https://api.acme.com/v1/resources
                            </code>
                        </div>

                        <ButtonCn Class="w-full">Authenticate</ButtonCn>

                        <p class="text-center text-xs text-muted-foreground">
                            <button type="button" class="text-foreground underline underline-offset-2">
                                Generate a new key
                            </button>
                            in your dashboard settings
                        </p>
                    </div>
                </TabsContentCn>
            </TabsCn>
        </div>
    </div>
</section>

