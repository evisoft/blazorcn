@* ============================================================
   Block: login-social-connect
   Title: LoginSocialConnect
   Description: Social account linking React authentication block for Next.js with connected accounts list, connect and disconnect toggles, primary account indicator, and email-password fallback using shadcn/ui, Tailwind CSS, and Lucide icons
   Source: original/blocks/login/login-social-connect.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Connect Accounts</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Link social accounts for faster sign-in
            </p>
        </div>

        @foreach (var prov in _providers)
        {
            var provider = prov;
            <div>
                <div class="flex items-center gap-3 px-4 py-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        @if (provider.Icon == "github")
                        {
                            <LucideIconCn Name="github" Size="16" Class="size-4 text-muted-foreground" />
                        }
                        @if (provider.Icon == "google")
                        {
                            <svg class="size-4" viewBox="0 0 24 24" aria-label="Google logo">
                                <title>Google</title>
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4" />
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                            </svg>
                        }
                        @if (provider.Icon == "x")
                        {
                            <svg class="size-4 text-muted-foreground" viewBox="0 0 24 24" fill="currentColor" aria-label="X logo">
                                <title>X</title>
                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                            </svg>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <p class="text-sm font-medium">@provider.Name</p>
                            @if (provider.Primary)
                            {
                                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">Primary</span>
                            }
                        </div>
                        @if (provider.Connected)
                        {
                            <p class="text-xs text-muted-foreground">@provider.Handle</p>
                        }
                        else
                        {
                            <p class="text-xs text-muted-foreground">Not connected</p>
                        }
                    </div>
                    <div class="flex items-center gap-1.5">
                        @if (provider.Connected && !provider.Primary)
                        {
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="h-7 gap-1 px-2 text-xs text-muted-foreground"
                                      OnClick="@(() => SetPrimary(provider.Id))">
                                <LucideIconCn Name="check" Size="12" Class="size-3" />
                                Set primary
                            </ButtonCn>
                        }
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="h-7 gap-1 px-2 text-xs text-muted-foreground"
                                  OnClick="@(() => ToggleConnection(provider.Id))">
                            @if (provider.Connected)
                            {
                                <LucideIconCn Name="unlink" Size="12" Class="size-3" />
                                @("Disconnect")
                            }
                            else
                            {
                                <LucideIconCn Name="link" Size="12" Class="size-3" />
                                @("Connect")
                            }
                        </ButtonCn>
                    </div>
                </div>
                @if (provider.Id != _providers[_providers.Length - 1].Id)
                {
                    <SeparatorCn />
                }
            </div>
        }

        <SeparatorCn />

        <div class="px-4 py-3">
            <button
                type="button"
                class="flex items-center gap-2 text-xs text-muted-foreground transition-colors hover:text-foreground"
                @onclick="@(() => _showEmail = !_showEmail)">
                <LucideIconCn Name="mail" Size="14" Class="size-3.5" />
                @(_showEmail ? "Hide email sign-in" : "Or sign in with email")
            </button>

            @if (_showEmail)
            {
                <div class="mt-3 space-y-3">
                    <div class="space-y-1.5">
                        <LabelCn For="social-connect-email" Class="text-xs font-medium text-muted-foreground">
                            Email
                        </LabelCn>
                        <InputCn id="social-connect-email" type="email" Placeholder="@("you@example.com")" @bind-Value="_email" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="social-connect-pw" Class="text-xs font-medium text-muted-foreground">
                            Password
                        </LabelCn>
                        <InputCn id="social-connect-pw" type="password" Placeholder="Enter password" @bind-Value="_password" />
                    </div>
                    <ButtonCn Size="ButtonSize.Sm" Class="w-full">
                        Sign in with email
                    </ButtonCn>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Connecting accounts lets you sign in with any linked provider
            </p>
        </div>
    </div>
</section>

@code {
    private bool _showEmail = false;
    private string _email = "";
    private string _password = "";

    private record SocialProvider(string Id, string Name, string Icon, bool Connected, string Handle, bool Primary);

    private SocialProvider[] _providers =
    [
        new("google", "Google", "google", true, "alex@gmail.com", true),
        new("github", "GitHub", "github", true, "@alexjohnson", false),
        new("x", "X (Twitter)", "x", false, "", false),
    ];

    private void ToggleConnection(string id)
    {
        _providers = _providers.Select(p =>
        {
            if (p.Id != id) return p;
            var nowConnected = !p.Connected;
            var newHandle = nowConnected ? (id == "x" ? "@alexj" : p.Handle) : "";
            var newPrimary = nowConnected ? false : p.Primary;
            return p with { Connected = nowConnected, Handle = newHandle, Primary = newPrimary };
        }).ToArray();
    }

    private void SetPrimary(string id)
    {
        _providers = _providers.Select(p => p with { Primary = p.Id == id }).ToArray();
    }
}
