@* ============================================================
   Block: login-command-palette
   Title: Login Command Palette
   Description: Command palette React authentication block for Next.js styled as a keyboard shortcut menu with search input, filterable sign-in method rows, keyboard shortcut hints, and sequential fade-in animations using shadcn/ui Input, Button, Kbd, Tailwind CSS, and framer-motion
   Long Description: React Login Carousel Testimonials Block
   Dependencies: InputCn, KbdCn, LucideSearchCn
   Source: original/blocks/login/login-command-palette.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative border-b">
            <LucideSearchCn Size="16" Class="absolute left-4 top-1/2 size-4 -translate-y-1/2 text-muted-foreground" />
            <InputCn @bind-Value="_query"
                     Placeholder="Type to filter sign-in methods..."
                     Class="border-0 bg-transparent pl-10 shadow-none focus-visible:ring-0" />
        </div>

        <div class="border-b px-4 py-2">
            <p class="text-xs font-medium text-muted-foreground">Sign in methods</p>
        </div>

        <div>
            @if (Filtered.Length == 0)
            {
                <div class="px-4 py-6 text-center">
                    <p class="text-sm text-muted-foreground">No matching methods</p>
                </div>
            }
            else
            {
                @for (var idx = 0; idx < Filtered.Length; idx++)
                {
                    var method = Filtered[idx];
                    var isLast = idx == Filtered.Length - 1;
                    <div class="@(isLast ? "" : "border-b")">
                        <button type="button"
                                class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                            @if (method.Icon == "mail")
                            {
                                <LucideMailCn Size="16" Class="size-4 text-muted-foreground" />
                            }
                            else if (method.Icon == "github")
                            {
                                <LucideGithubCn Size="16" Class="size-4 text-muted-foreground" />
                            }
                            else if (method.Icon == "globe")
                            {
                                <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
                            }
                            else if (method.Icon == "shield")
                            {
                                <LucideShieldCn Size="16" Class="size-4 text-muted-foreground" />
                            }
                            else
                            {
                                <LucideWandCn Size="16" Class="size-4 text-muted-foreground" />
                            }
                            <span class="flex-1 text-sm">@method.Label</span>
                            <KbdCn>@method.Shortcut</KbdCn>
                        </button>
                    </div>
                }
            }
        </div>

        <div class="border-t px-4 py-2">
            <p class="text-xs text-muted-foreground">
                Press <KbdCn>&#x23CE;</KbdCn> to select
            </p>
        </div>
    </div>
</section>

@code {
    private string _query = "";

    private record Method(string Icon, string Label, string Shortcut);

    private static readonly Method[] _methods =
    [
        new("mail", "Email & password", "\u23181"),
        new("github", "GitHub", "\u23182"),
        new("globe", "Google", "\u23183"),
        new("shield", "SSO", "\u23184"),
        new("wand", "Magic link", "\u23185"),
    ];

    private Method[] Filtered => string.IsNullOrEmpty(_query)
        ? _methods
        : _methods.Where(m => m.Label.Contains(_query, StringComparison.OrdinalIgnoreCase)).ToArray();
}
