@* ============================================================
   Block: login-helpdesk
   Title: LoginHelpdesk
   Description: IT helpdesk login recovery React block for Next.js with ticket submission form, employee ID input, issue category selector, and support queue status using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-helpdesk.tsx
   ============================================================ *@

@if (_submitted)
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex flex-col items-center px-4 py-10">
                <div class="mb-4 flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideTicketCn Size="20" Class="size-5 text-emerald-600" />
                </div>
                <p class="text-sm font-medium">Ticket submitted</p>
                <p class="mt-1 text-xs text-muted-foreground">Reference: HD-2024-4821</p>
                <div class="mt-4 rounded-md bg-muted/50 p-3 text-center">
                    <p class="text-xs text-muted-foreground">Estimated wait time</p>
                    <p class="mt-0.5 font-mono text-lg font-semibold">~15 min</p>
                    <p class="mt-1 text-xs text-muted-foreground">3 tickets ahead of you</p>
                </div>
                <button
                    type="button"
                    @onclick="@(() => _submitted = false)"
                    class="mt-4 text-xs text-muted-foreground hover:text-foreground">
                    Back to login
                </button>
            </div>
        </div>
    </section>
}
else
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideHeadphonesCn Size="16" Class="size-4 text-muted-foreground" />
                    <p class="text-sm font-medium">IT Helpdesk</p>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Can't sign in? Submit a support request.
                </p>
            </div>

            <div class="space-y-3 px-4 py-4">
                <div class="space-y-1.5">
                    <LabelCn For="helpdesk-id" Class="text-xs font-medium text-muted-foreground">
                        Employee ID
                    </LabelCn>
                    <InputCn Id="helpdesk-id" Placeholder="EMP-0000" @bind-Value="_employeeId" />
                </div>

                <div class="space-y-1.5">
                    <LabelCn Class="text-xs font-medium text-muted-foreground">Issue category</LabelCn>
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var cat in _categories)
                        {
                            var catItem = cat;
                            <button
                                type="button"
                                @onclick="@(() => _category = catItem)"
                                class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _category == catItem ? "bg-foreground text-background" : "bg-muted/50 text-muted-foreground hover:bg-muted")">
                                @catItem
                            </button>
                        }
                    </div>
                </div>

                <div class="space-y-1.5">
                    <LabelCn For="helpdesk-desc" Class="text-xs font-medium text-muted-foreground">
                        Description
                    </LabelCn>
                    <textarea
                        id="helpdesk-desc"
                        rows="3"
                        placeholder="Describe your issue..."
                        @bind="_description"
                        class="w-full resize-none rounded-md border bg-background px-3 py-2 text-sm placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring">
                    </textarea>
                </div>

                <ButtonCn Class="w-full gap-1.5" Size="ButtonSize.Sm" OnClick="@(() => _submitted = true)" Disabled="@(!HasRequiredFields)">
                    <LucideSendCn Size="14" Class="size-3.5" />
                    Submit ticket
                </ButtonCn>
            </div>

            <div class="border-t px-4 py-3">
                <div class="flex items-center justify-between text-xs text-muted-foreground">
                    <span>Queue: 3 active tickets</span>
                    <span>Avg response: 12 min</span>
                </div>
            </div>
        </div>
    </section>
}

@code {
    private string _employeeId = "";
    private string _category = "";
    private string _description = "";
    private bool _submitted = false;

    private bool HasRequiredFields => !string.IsNullOrEmpty(_employeeId) && !string.IsNullOrEmpty(_category);

    private static readonly string[] _categories =
    [
        "Forgot password",
        "Account locked",
        "MFA device lost",
        "SSO not working",
        "New account request",
        "Other",
    ];
}
