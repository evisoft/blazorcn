@* ============================================================
   Block: login-recovery-email
   Title: LoginRecoveryEmail
   Description: Recovery email verification React block for Next.js with masked email display, verification code input, resend option, and update recovery email link using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-recovery-email.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-4 py-3">
      <p class="text-sm font-medium">Recovery Email Verification</p>
      <p class="mt-0.5 text-xs text-muted-foreground">
        Verify your identity using your recovery email
      </p>
    </div>

    @if (_step == "send")
    {
      <div class="flex flex-col items-center px-4 py-8">
        <div class="mb-4 flex size-10 items-center justify-center rounded-full bg-muted/50">
          <LucideIconCn Name="mail" Size="20" Class="size-5 text-muted-foreground" />
        </div>
        <p class="text-sm font-medium">Send verification code</p>
        <p class="mt-1 text-xs text-muted-foreground">
          We'll send a code to your recovery email
        </p>

        <div class="mt-4 rounded-md bg-muted/50 px-4 py-2">
          <p class="font-mono text-sm">a***x@@g****.com</p>
        </div>

        <ButtonCn Class="mt-4" Size="ButtonSize.Sm" OnClick="@(() => _step = "verify")">
          Send code
        </ButtonCn>

        <button
          type="button"
          class="mt-3 text-xs text-muted-foreground hover:text-foreground"
        >
          I don't have access to this email
        </button>
      </div>
    }

    @if (_step == "verify")
    {
      <div class="flex flex-col items-center px-4 py-8">
        <p class="text-sm font-medium">Enter verification code</p>
        <p class="mt-1 text-xs text-muted-foreground">Code sent to a***x@@g****.com</p>

        <div class="mt-6 w-full max-w-[260px] space-y-3">
          <div class="space-y-1.5">
            <LabelCn For="recovery-code" Class="text-xs font-medium text-muted-foreground">
              6-digit code
            </LabelCn>
            <InputCn
              id="recovery-code"
              Placeholder="000000"
              @bind-Value="_code"
              Class="text-center font-mono text-lg tracking-widest"
              MaxLength="6"
            />
          </div>
          <ButtonCn
            Class="w-full"
            Size="ButtonSize.Sm"
            OnClick="@(() => _step = "done")"
            Disabled="@(_code.Length < 6)"
          >
            Verify
          </ButtonCn>
        </div>

        <div class="mt-4 flex gap-3">
          <button
            type="button"
            class="text-xs text-muted-foreground hover:text-foreground"
          >
            Resend code
          </button>
          <button
            type="button"
            class="text-xs text-muted-foreground hover:text-foreground"
            @onclick="@(() => _step = "send")"
          >
            Go back
          </button>
        </div>
      </div>
    }

    @if (_step == "done")
    {
      <div class="flex flex-col items-center px-4 py-8">
        <div class="mb-4 flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
          <LucideIconCn Name="check" Size="20" Class="size-5 text-emerald-600" />
        </div>
        <p class="text-sm font-medium">Email verified</p>
        <p class="mt-1 text-xs text-muted-foreground">You can now reset your password</p>
        <ButtonCn Class="mt-4" Size="ButtonSize.Sm">
          Continue to password reset
        </ButtonCn>
      </div>
    }

    <div class="border-t px-4 py-3">
      <button
        type="button"
        class="text-xs text-muted-foreground transition-colors hover:text-foreground"
      >
        Try a different recovery method
      </button>
    </div>
  </div>
</section>

@code {
    private string _step = "send";
    private string _code = "";
}
