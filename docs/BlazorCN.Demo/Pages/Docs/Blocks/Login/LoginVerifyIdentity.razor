@* ============================================================
   Block: login-verify-identity
   Title: Login Verify Identity
   Description: Identity verification method selector with radio group options for SMS, email, and authenticator app verification and send code button
   Long Description: React Login Two Factor Auth Block
   Dependencies: ButtonCn, LucideKeyRoundCn, LucideMailCn, LucideShieldCn, LucideSmartphoneCn
   Source: original/blocks/login/login-verify-identity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with icon *@
        <div class="flex flex-col items-center border-b px-4 py-6 text-center">
            <div class="mb-3 flex size-12 items-center justify-center rounded-full bg-muted">
                <LucideShieldCn Size="20" Class="size-5 text-muted-foreground" />
            </div>
            <p class="text-sm font-medium">Verify your identity</p>
            <p class="mt-1 text-xs text-muted-foreground">
                Choose how to receive your verification code
            </p>
        </div>

        @* Method cards *@
        <div class="space-y-2 border-b px-4 py-4">
            @foreach (var method in _methods)
            {
                <button
                    type="button"
                    @onclick="@(() => _selected = method.Id)"
                    class="@(Cn.Merge("flex w-full items-center gap-3 rounded-md border p-3 text-left transition-colors", _selected == method.Id ? "border-primary bg-primary/5" : "border-border hover:bg-muted/50"))">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        @if (method.Id == "sms")
                        {
                            <LucideSmartphoneCn Size="16" Class="size-4 text-muted-foreground" />
                        }
                        else if (method.Id == "email")
                        {
                            <LucideMailCn Size="16" Class="size-4 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideKeyRoundCn Size="16" Class="size-4 text-muted-foreground" />
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@method.Label</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">@method.Detail</p>
                    </div>
                    <div class="@(Cn.Merge("size-4 rounded-full border-2 transition-colors", _selected == method.Id ? "border-primary bg-primary" : "border-muted-foreground/30"))">
                        @if (_selected == method.Id)
                        {
                            <div class="flex size-full items-center justify-center">
                                <div class="size-1.5 rounded-full bg-white"></div>
                            </div>
                        }
                    </div>
                </button>
            }
        </div>

        @* Action *@
        <div class="px-4 py-3">
            <ButtonCn Class="w-full">Send code</ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _selected = "sms";

    private record VerificationMethod(string Id, string Label, string Detail);

    private static readonly VerificationMethod[] _methods =
    [
        new("sms", "Text message", "Send to \u2022\u2022\u20224521"),
        new("email", "Email", "Send to a***x@@acme.com"),
        new("authenticator", "Authenticator app", "Use your authenticator"),
    ];
}
