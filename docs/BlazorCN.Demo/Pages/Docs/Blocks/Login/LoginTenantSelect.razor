@* ============================================================
   Block: login-tenant-select
   Title: LoginTenantSelect
   Description: Multi-tenant selection React login block for Next.js with organization list, workspace search, role indicators, last-accessed timestamps, and create-workspace option using shadcn/ui, Tailwind CSS, and Lucide icons
   Source: original/blocks/login/login-tenant-select.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Choose a workspace</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Signed in as alex@@acme.com. Select a workspace to continue.
            </p>
        </div>

        <div class="border-b px-4 py-2">
            <div class="flex items-center gap-2">
                <LucideSearchCn Size="14" Class="size-3.5 text-muted-foreground" />
                <InputCn Type="text" Placeholder="Search workspaces..."
                         Class="border-0 bg-transparent px-0 shadow-none focus-visible:ring-0"
                         @bind-Value="_search" />
            </div>
        </div>

        <div>
            @if (Filtered.Length == 0)
            {
                <div class="px-4 py-6 text-center">
                    <p class="text-sm text-muted-foreground">No workspaces found</p>
                </div>
            }

            @foreach (var tenant in Filtered)
            {
                var t = tenant;
                var idx = System.Array.IndexOf(Filtered, t);
                <div>
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-muted/50 text-xs font-medium">
                            @t.Initials
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-sm font-medium">@t.Name</p>
                                <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                    @t.Role
                                </span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-xs text-muted-foreground">
                                <span class="flex items-center gap-1">
                                    <LucideUsersCn Size="12" Class="size-3" />
                                    @t.Members members
                                </span>
                                <span>@t.LastAccessed</span>
                            </div>
                        </div>
                        <LucideChevronRightCn Size="16" Class="size-4 text-muted-foreground/60" />
                    </button>
                    @if (idx < Filtered.Length - 1)
                    {
                        <hr class="border-border" />
                    }
                </div>
            }
        </div>

        <hr class="border-border" />

        <div class="px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full gap-1.5 text-xs">
                <LucidePlusCn Size="14" Class="size-3.5" />
                Create new workspace
            </ButtonCn>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span class="flex items-center gap-1.5">
                    <LucideBuildingCn Size="12" Class="size-3" />
                    @_tenants.Length workspaces available
                </span>
                <button type="button" class="transition-colors hover:text-foreground">
                    Sign out
                </button>
            </div>
        </div>
    </div>
</section>

@code {
    private string _search = "";

    private record Tenant(string Id, string Name, string Slug, string Role, int Members, string LastAccessed, string Initials);

    private static readonly Tenant[] _tenants =
    [
        new("t1", "Acme Corporation", "acme-corp", "Admin", 48, "Just now", "AC"),
        new("t2", "Globex Industries", "globex", "Member", 124, "2 days ago", "GI"),
        new("t3", "Initech Labs", "initech", "Viewer", 12, "Last week", "IL"),
        new("t4", "Stark Ventures", "stark-ventures", "Admin", 7, "3 weeks ago", "SV"),
    ];

    private Tenant[] Filtered =>
        string.IsNullOrEmpty(_search)
            ? _tenants
            : _tenants.Where(t => t.Name.Contains(_search, System.StringComparison.OrdinalIgnoreCase)).ToArray();
}
