@* ============================================================
   Block: login-recent-accounts
   Title: Login Recent Accounts
   Description: Account switcher React login block for Next.js with recent user list showing avatars names and emails, clickable account rows, and alternative sign-in form with staggered list animations using shadcn/ui Avatar, Input, Button, Tailwind CSS, and framer-motion
   Long Description: Workspace selection before login
   Dependencies: AvatarCn, AvatarFallbackCn, ButtonCn, InputCn, LabelCn, LucideArrowLeftCn, LucideChevronRightCn, LucidePlusCn
   Source: original/blocks/login/login-recent-accounts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Choose an account</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Select a recent account or sign in with another
            </p>
        </div>

        @if (!_showForm)
        {
            <div>
                @foreach (var account in _accounts)
                {
                    <button type="button"
                            class="flex w-full items-center gap-3 border-b px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <AvatarCn Class="size-9">
                            <AvatarFallbackCn Class="text-xs">@account.Initials</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-medium">@account.Name</p>
                            <p class="truncate text-xs text-muted-foreground">@account.Email</p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="ml-auto size-4 text-muted-foreground" />
                    </button>
                }
            </div>
            <div class="px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" Class="w-full gap-2"
                          OnClick="@(() => _showForm = true)">
                    <LucidePlusCn Size="14" Class="size-3.5" />
                    Use another account
                </ButtonCn>
            </div>
        }
        else
        {
            <div class="px-4 py-4">
                <div class="mb-4 flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSm"
                              Type="button"
                              OnClick="@(() => _showForm = false)">
                        <LucideArrowLeftCn Size="16" Class="size-4 text-muted-foreground" />
                    </ButtonCn>
                    <p class="text-sm font-medium">Sign in</p>
                </div>
                <div class="space-y-4">
                    <div class="space-y-2">
                        <LabelCn For="ra-email" Class="text-xs">Email address</LabelCn>
                        <InputCn id="ra-email" Type="email" Placeholder="@("you@@example.com")" />
                    </div>
                    <div class="space-y-2">
                        <LabelCn For="ra-password" Class="text-xs">Password</LabelCn>
                        <InputCn id="ra-password" Type="password" Placeholder="********" />
                    </div>
                    <ButtonCn Class="w-full">Sign in</ButtonCn>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private bool _showForm;

    private record Account(string Name, string Email, string Initials);

    private static readonly Account[] _accounts =
    [
        new("Alex Johnson", "alex@acmecorp.com", "AJ"),
        new("Sarah Chen", "sarah.chen@startup.io", "SC"),
        new("Marcus Webb", "m.webb@design.co", "MW"),
    ];
}
