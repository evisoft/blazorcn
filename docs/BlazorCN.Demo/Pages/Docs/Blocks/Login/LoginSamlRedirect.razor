@* ============================================================
   Block: login-saml-redirect
   Title: LoginSamlRedirect
   Description: SAML redirect authentication React block for Next.js with provider configuration display, redirect countdown, SAML request preview, and connection status using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-saml-redirect.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldCheckCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">SAML Authentication</p>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    SAML 2.0
                </BadgeCn>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Redirecting to your identity provider
            </p>
        </div>

        <div class="flex flex-col items-center px-4 py-8">
            <div class="mb-6 flex items-center gap-4">
                <div class="flex size-12 items-center justify-center rounded-lg bg-primary text-sm font-semibold text-primary-foreground">
                    A
                </div>
                <div class="flex items-center gap-1">
                    <LucideArrowRightCn Size="16" Class="size-4 text-muted-foreground" />
                    <LucideArrowRightCn Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div class="flex size-12 items-center justify-center rounded-lg bg-muted/50 text-sm font-semibold text-muted-foreground">
                    O
                </div>
            </div>

            <p class="text-sm font-medium">Redirecting to Okta</p>
            <p class="mt-1 text-xs text-muted-foreground">
                You will be redirected to your organization&apos;s login page
            </p>

            <div class="mt-4 h-1 w-48 overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-foreground" style="width:60%"></div>
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Connection details</p>
            <div class="rounded-md bg-muted/50 p-3">
                <div class="space-y-1.5">
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Provider</span>
                        <span>Okta SSO</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Entity ID</span>
                        <span class="font-mono">https://acme.okta.com</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Binding</span>
                        <span>HTTP-Redirect</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Encryption</span>
                        <div class="flex items-center gap-1">
                            <LucideLockCn Size="12" Class="size-3 text-emerald-500" />
                            <span>SHA-256</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <button type="button"
                        class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                    Cancel redirect
                </button>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-1.5 text-xs">
                    <LucideExternalLinkCn Size="12" Class="size-3" />
                    Open manually
                </ButtonCn>
            </div>
        </div>
    </div>
</section>
