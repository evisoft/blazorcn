@* ============================================================
   Block: login-pin-entry
   Title: Login Pin Entry
   Description: Four-digit PIN code React login block for Next.js with visual dot indicators, numeric keypad grid, shake animation on incorrect PIN, and scale feedback on keypress using shadcn/ui Button, Tailwind CSS, and framer-motion
   Long Description: Biometric fingerprint authentication
   Dependencies: ButtonCn, LucideDeleteCn
   Source: original/blocks/login/login-pin-entry.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Enter your PIN</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Use your 4-digit security code</p>
        </div>

        <div class="flex flex-col items-center px-4 py-8">
            <div class="mb-8 flex items-center gap-4">
                @for (var i = 0; i < 4; i++)
                {
                    var idx = i;
                    <div class="@Cn.Merge("size-4 rounded-full transition-colors", _error ? "bg-red-500" : idx < _pin.Count ? "bg-foreground" : "border-2 border-muted-foreground/30")" />
                }
            </div>

            <div class="grid w-full max-w-[240px] grid-cols-3 gap-2">
                @foreach (var key in _keys)
                {
                    if (key == "")
                    {
                        <div />
                    }
                    else if (key == "delete")
                    {
                        <ButtonCn Variant="ButtonVariant.Ghost" Class="h-12 w-full text-muted-foreground"
                                  aria-label="Delete digit"
                                  OnClick="@(() => HandleKey("delete"))">
                            <LucideDeleteCn Size="16" Class="size-4" />
                        </ButtonCn>
                    }
                    else
                    {
                        var k = key;
                        <ButtonCn Variant="ButtonVariant.Ghost" Class="h-12 w-full text-lg font-medium"
                                  OnClick="@(() => HandleKey(k))">
                            @k
                        </ButtonCn>
                    }
                }
            </div>

            @if (_error)
            {
                <p class="mt-4 text-xs text-red-500">Incorrect PIN. Please try again.</p>
            }
        </div>
    </div>
</section>

@code {
    private List<string> _pin = [];
    private bool _error;

    private static readonly string[] _keys = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "", "0", "delete"];

    private async Task HandleKey(string key)
    {
        _error = false;

        if (key == "delete")
        {
            if (_pin.Count > 0)
                _pin.RemoveAt(_pin.Count - 1);
            return;
        }

        if (_pin.Count >= 4) return;

        _pin.Add(key);

        if (_pin.Count == 4)
        {
            var entered = string.Join("", _pin);
            if (entered != "1234")
            {
                _error = true;
                StateHasChanged();
                await Task.Delay(800);
                _pin.Clear();
                _error = false;
            }
        }
    }
}
