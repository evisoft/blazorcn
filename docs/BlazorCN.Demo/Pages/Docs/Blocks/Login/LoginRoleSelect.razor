@* ============================================================
   Block: login-role-select
   Title: Login Role Select
   Description: React authentication block for Next.js with sign-in form followed by post-login role selection showing admin, developer, and viewer cards with icons, descriptions, and scale-in animations using shadcn/ui Input, Button, Tailwind CSS, and framer-motion
   Long Description: Organization picker before login
   Dependencies: ButtonCn, InputCn, LabelCn, LucideCodeCn, LucideEyeCn, LucideShieldCn
   Source: original/blocks/login/login-role-select.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @if (_step == "login")
        {
            <div>
                <div class="border-b px-4 py-3">
                    <p class="text-sm font-medium">Sign in</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Enter your credentials to continue
                    </p>
                </div>

                <div class="space-y-4 px-4 py-4">
                    <div class="space-y-1.5">
                        <LabelCn For="rs-email" Class="text-xs">Email</LabelCn>
                        <InputCn id="rs-email" Type="email" Placeholder="@("you@@company.com")"
                                 @bind-Value="_email" />
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="rs-password" Class="text-xs">Password</LabelCn>
                        <InputCn id="rs-password" Type="password" Placeholder="Enter your password"
                                 @bind-Value="_password" />
                    </div>
                    <ButtonCn Class="w-full" OnClick="@(() => _step = "role")">
                        Continue
                    </ButtonCn>
                </div>
            </div>
        }
        else
        {
            <div>
                <div class="border-b px-4 py-3">
                    <p class="text-sm font-medium">Choose your role</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Select how you'll use Acme
                    </p>
                </div>

                <div class="space-y-2 border-b px-4 py-4">
                    @foreach (var role in _roles)
                    {
                        <button type="button"
                                @onclick="@(() => _selectedRole = role.Id)"
                                class="@Cn.Merge("flex w-full items-center gap-3 rounded-md border p-4 text-left transition-colors hover:bg-muted/50", _selectedRole == role.Id ? "border-primary bg-primary/5" : "")">
                            <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                                @if (role.Id == "admin")
                                {
                                    <LucideShieldCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else if (role.Id == "developer")
                                {
                                    <LucideCodeCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                                else
                                {
                                    <LucideEyeCn Size="16" Class="size-4 text-muted-foreground" />
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-sm font-medium">@role.Title</p>
                                <p class="mt-0.5 text-xs text-muted-foreground">@role.Description</p>
                            </div>
                        </button>
                    }
                </div>

                <div class="px-4 py-3">
                    <ButtonCn Class="w-full" Disabled="@(_selectedRole == null)">
                        Continue as @(_selectedRole != null ? _roles.FirstOrDefault(r => r.Id == _selectedRole)?.Title : "...")
                    </ButtonCn>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private string _step = "login";
    private string _email = "";
    private string _password = "";
    private string? _selectedRole;

    private record RoleItem(string Id, string Title, string Description);

    private static readonly RoleItem[] _roles =
    [
        new("admin", "Admin", "Full access to settings and billing"),
        new("developer", "Developer", "API access, deployments, and logs"),
        new("viewer", "Viewer", "Read-only access to dashboards"),
    ];
}
