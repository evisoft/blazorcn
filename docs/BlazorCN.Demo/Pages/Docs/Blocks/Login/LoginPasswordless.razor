@* ============================================================
   Block: login-passwordless
   Title: Login Passwordless
   Description: Passwordless React authentication method selector for Next.js with magic link, passkey, phone SMS, and authenticator app options as selectable rows with icons and staggered entrance animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Let users choose their preferred passwordless sign-in method
   Dependencies: LucideChevronRightCn, LucideFingerprintCn, LucideKeyCn, LucideSmartphoneCn, LucideWandCn
   Source: original/blocks/login/login-passwordless.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Choose sign-in method</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Select how you'd like to verify your identity
            </p>
        </div>

        <div class="p-2">
            @foreach (var method in _methods)
            {
                <button type="button"
                        class="flex w-full items-center gap-3 rounded-md border p-3 text-left transition-colors hover:bg-muted/50 [&:not(:last-child)]:mb-2">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                        @if (method.Icon == "wand")
                        {
                            <LucideWandCn Size="16" Class="size-4 text-muted-foreground" />
                        }
                        else if (method.Icon == "fingerprint")
                        {
                            <LucideFingerprintPatternCn Size="16" Class="size-4 text-muted-foreground" />
                        }
                        else if (method.Icon == "smartphone")
                        {
                            <LucideSmartphoneCn Size="16" Class="size-4 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideKeyCn Size="16" Class="size-4 text-muted-foreground" />
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm font-medium">@method.Title</p>
                        <p class="text-xs text-muted-foreground">@method.Description</p>
                    </div>
                    <LucideChevronRightCn Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                </button>
            }
        </div>

        <div class="border-t px-4 py-3">
            <button type="button"
                    class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                Or sign in with password
            </button>
        </div>
    </div>
</section>

@code {
    private record AuthMethod(string Icon, string Title, string Description);

    private static readonly AuthMethod[] _methods =
    [
        new("wand", "Magic link", "We'll email you a sign-in link"),
        new("fingerprint", "Passkey", "Use biometrics or device PIN"),
        new("smartphone", "Phone", "Get a code via SMS"),
        new("key", "Authenticator", "Use your authenticator app"),
    ];
}
