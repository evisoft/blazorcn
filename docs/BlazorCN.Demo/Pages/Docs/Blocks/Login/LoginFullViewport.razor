@* ============================================================
   Block: login-full-viewport
   Title: Login Full Viewport
   Description: Full viewport React login page for Next.js with centered floating card, CSS dot grid background pattern, social authentication buttons, email password form, and scale-in entrance animation using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Centered card without background
   Dependencies: ButtonCn, InputCn, LabelCn, LucideGithubCn, SeparatorCn
   Source: original/blocks/login/login-full-viewport.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative flex min-h-[500px] items-center justify-center overflow-hidden rounded-lg border bg-card">
        <div class="absolute inset-0 opacity-[0.015]"
             style="background-image: radial-gradient(circle, currentColor 1px, transparent 1px); background-size: 20px 20px;" />

        <div class="relative w-full max-w-sm rounded-lg border bg-card p-6 shadow-sm">
            <div class="mb-6 flex flex-col items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-lg bg-foreground text-sm font-semibold text-background">
                    A
                </div>
                <div class="text-center">
                    <p class="text-sm font-medium">Sign in to Acme</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Welcome back. Enter your credentials below.
                    </p>
                </div>
            </div>

            <div class="space-y-4">
                <div class="space-y-2">
                    <LabelCn For="fv-email" Class="text-xs">Email</LabelCn>
                    <InputCn id="fv-email" Type="email" Placeholder="@("you@@example.com")" />
                </div>

                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <LabelCn For="fv-password" Class="text-xs">Password</LabelCn>
                        <button type="button"
                                class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                            Forgot?
                        </button>
                    </div>
                    <InputCn id="fv-password" Type="password" Placeholder="********" />
                </div>

                <ButtonCn Class="w-full">Sign in</ButtonCn>
            </div>

            <div class="my-4 flex items-center gap-3">
                <SeparatorCn Class="flex-1" />
                <span class="text-xs text-muted-foreground">or</span>
                <SeparatorCn Class="flex-1" />
            </div>

            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-2">
                    <svg class="size-3.5" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4" />
                        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                    </svg>
                    <span class="text-xs">Google</span>
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-2">
                    <LucideGithubCn Size="14" Class="size-3.5" />
                    <span class="text-xs">GitHub</span>
                </ButtonCn>
            </div>

            <p class="mt-4 text-center text-xs text-muted-foreground">
                No account?
                <button type="button" class="text-foreground underline underline-offset-2">
                    Get started
                </button>
            </p>
        </div>
    </div>
</section>

