@* ============================================================
   Block: login-time-restricted
   Title: LoginTimeRestricted
   Description: Time-restricted access React login block for Next.js with access window display, current status indicator, allowed hours schedule, timezone info, and request-access form for off-hours using shadcn/ui, Tailwind CSS, and Lucide icons
   Source: original/blocks/login/login-time-restricted.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideClockCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Time-Restricted Access</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                System access is limited to authorized hours
            </p>
        </div>

        <div class="px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="@(_isWithinHours ? "size-1.5 rounded-full bg-emerald-500" : "size-1.5 rounded-full bg-red-500")"></span>
                <span class="text-xs font-medium">
                    @(_isWithinHours ? "Access window open" : "Outside access hours")
                </span>
                <span class="text-xs text-muted-foreground">
                    &middot; Current time: 9:42 PM EST
                </span>
            </div>
        </div>

        <hr class="border-border" />

        <div class="px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Access schedule</p>
            <div class="space-y-2">
                @foreach (var win in _schedule)
                {
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2 text-xs">
                            <LucideCalendarCn Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-muted-foreground">@win.Day</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-xs">@win.Hours</span>
                            @if (win.Active)
                            {
                                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="mt-2 flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideGlobeCn Size="12" Class="size-3" />
                <span>All times shown in EST (UTC-5)</span>
            </div>
        </div>

        <hr class="border-border" />

        @if (!_isWithinHours && !_submitted)
        {
            <div class="px-4 py-3">
                @if (!_showRequest)
                {
                    <div class="flex flex-col items-center py-2">
                        <div class="mb-3 flex size-10 items-center justify-center rounded-full bg-muted/50">
                            <LucideLockCn Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <p class="text-sm font-medium">Access restricted</p>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            Next access window opens at 8:00 AM EST
                        </p>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-3 gap-1.5 text-xs" @onclick="@(() => _showRequest = true)">
                            <LucideSendCn Size="14" Class="size-3.5" />
                            Request off-hours access
                        </ButtonCn>
                    </div>
                }
                else
                {
                    <div class="space-y-3">
                        <p class="text-xs font-medium text-muted-foreground">
                            Request emergency access
                        </p>
                        <div class="space-y-1.5">
                            <LabelCn For="time-reason" Class="text-xs font-medium text-muted-foreground">
                                Reason for access
                            </LabelCn>
                            <InputCn
                                id="time-reason"
                                type="text"
                                Placeholder="e.g. Critical deployment, incident response"
                                @bind-Value="_reason"
                            />
                        </div>
                        <div class="flex gap-2">
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1 text-xs" @onclick="@(() => _showRequest = false)">
                                Cancel
                            </ButtonCn>
                            <ButtonCn Size="ButtonSize.Sm" Class="flex-1 text-xs" Disabled="@(string.IsNullOrEmpty(_reason))" @onclick="@(() => _submitted = true)">
                                Submit request
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        }

        @if (_submitted)
        {
            <div class="flex flex-col items-center px-4 py-6">
                <div class="mb-3 flex size-10 items-center justify-center rounded-full bg-blue-500/10">
                    <LucideSendCn Size="16" Class="size-4 text-blue-600" />
                </div>
                <p class="text-sm font-medium">Request submitted</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Your admin will review the request shortly
                </p>
            </div>
        }

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span class="flex items-center gap-1">
                    <LucideShieldCheckCn Size="12" Class="size-3" />
                    Policy: SOC 2 compliant access controls
                </span>
                <button type="button" class="transition-colors hover:text-foreground">
                    Contact admin
                </button>
            </div>
        </div>
    </div>
</section>

@code {
    private record AccessWindow(string Day, string Hours, bool Active);

    private static readonly AccessWindow[] _schedule =
    [
        new("Monday - Friday", "8:00 AM - 6:00 PM", true),
        new("Saturday", "10:00 AM - 2:00 PM", false),
        new("Sunday", "Closed", false),
    ];

    private bool _isWithinHours = false;
    private bool _showRequest = false;
    private string _reason = "";
    private bool _submitted = false;
}
