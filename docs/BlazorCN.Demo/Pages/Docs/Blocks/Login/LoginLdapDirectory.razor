@* ============================================================
   Block: login-ldap-directory
   Title: LoginLdapDirectory
   Description: LDAP directory authentication React block for Next.js with domain selector, username and password fields, directory server status, and connection security indicator using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-ldap-directory.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="database" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Directory Login</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Sign in with your network credentials
            </p>
        </div>

        <div class="space-y-3 px-4 py-4">
            <div class="space-y-1.5">
                <LabelCn Class="text-xs font-medium text-muted-foreground">Domain</LabelCn>
                <div class="flex gap-1.5">
                    @foreach (var dom in _domains)
                    {
                        var domain = dom;
                        <button type="button"
                                @onclick="@(() => _selectedDomain = domain.Id)"
                                class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-3 py-1.5 text-xs transition-colors", _selectedDomain == domain.Id ? "bg-foreground text-background" : domain.Status == "offline" ? "bg-muted/30 text-muted-foreground/50" : "bg-muted/50 text-muted-foreground hover:bg-muted")"
                                disabled="@(domain.Status == "offline")">
                            <span class="@Cn.Merge("size-1.5 rounded-full", domain.Status == "online" ? "bg-emerald-500" : "bg-red-500")"></span>
                            @domain.Name
                        </button>
                    }
                </div>
            </div>

            <div class="space-y-1.5">
                <LabelCn For="ldap-user" Class="text-xs font-medium text-muted-foreground">
                    Username
                </LabelCn>
                <div class="flex">
                    <span class="flex items-center rounded-l-md border border-r-0 bg-muted/50 px-3 font-mono text-xs text-muted-foreground">
                        @_activeDomain.Name
                    </span>
                    <InputCn id="ldap-user" Placeholder="jsmith" Class="rounded-l-none" @bind-Value="_username" />
                </div>
            </div>

            <div class="space-y-1.5">
                <LabelCn For="ldap-pw" Class="text-xs font-medium text-muted-foreground">
                    Password
                </LabelCn>
                <InputCn id="ldap-pw" Type="password" Placeholder="Enter network password" @bind-Value="_password" />
            </div>

            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                Sign in
            </ButtonCn>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="server" Size="12" Class="size-3" />
                    <span>@_activeDomain.Server</span>
                    <span class="@Cn.Merge("size-1.5 rounded-full", _activeDomain.Status == "online" ? "bg-emerald-500" : "bg-red-500")"></span>
                </div>
                <div class="flex items-center gap-1">
                    <LucideIconCn Name="lock" Size="12" Class="size-3" />
                    <span>LDAPS (TLS)</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string _selectedDomain = "d1";
    private string _username = "";
    private string _password = "";

    private DomainEntry _activeDomain => System.Array.Find(_domains, d => d.Id == _selectedDomain) ?? _domains[0];

    private static readonly DomainEntry[] _domains =
    [
        new DomainEntry("d1", "ACME\\", "ldap.acme.com", "online"),
        new DomainEntry("d2", "CORP\\", "ldap.corp.acme.com", "online"),
        new DomainEntry("d3", "DEV\\", "ldap.dev.acme.com", "offline"),
    ];

    private record DomainEntry(string Id, string Name, string Server, string Status);
}
