@* ============================================================
   Block: login-alert-banner
   Title: Login Alert Banner
   Description: React login form block for Next.js with dismissible amber maintenance alert notification banner, email password fields, and slide-down banner animation using shadcn/ui Input, Button, Label, Tailwind CSS, and framer-motion AnimatePresence
   Long Description: React Login Account Locked Block
   Dependencies: ButtonCn, InputCn, LabelCn, LucideAlertTriangleCn, LucideXCn
   Source: original/blocks/login/login-alert-banner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @if (_showBanner)
        {
            <div class="flex items-start gap-3 border-b bg-amber-500/10 px-4 py-3">
                <LucideAlertTriangleCn Size="16" Class="mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-400" />
                <div class="min-w-0 flex-1">
                    <p class="text-sm font-medium">Scheduled maintenance</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">March 20, 2-4 AM UTC</p>
                </div>
                <ButtonCn type="button"
                          Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.IconSm"
                          @onclick="@(() => _showBanner = false)"
                          Class="shrink-0">
                    <LucideXCn Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        }

        <div class="px-4 py-6">
            <div class="mb-6">
                <h2 class="text-sm font-medium">Sign in</h2>
                <p class="mt-1 text-xs text-muted-foreground">
                    Enter your email and password to continue
                </p>
            </div>

            <div class="space-y-4">
                <div class="space-y-2">
                    <LabelCn For="alert-email" Class="text-xs text-muted-foreground">
                        Email
                    </LabelCn>
                    <InputCn id="alert-email" Type="email" Placeholder="@("you@@company.com")"
                             Class="h-8 text-sm" />
                </div>

                <div class="space-y-2">
                    <LabelCn For="alert-password" Class="text-xs text-muted-foreground">
                        Password
                    </LabelCn>
                    <InputCn id="alert-password" Type="password" Placeholder="Enter your password"
                             Class="h-8 text-sm" />
                </div>

                <ButtonCn Class="h-8 w-full text-xs">Sign in</ButtonCn>

                <button type="button"
                        class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                    Forgot your password?
                </button>
            </div>
        </div>
    </div>
</section>

@code {
    private bool _showBanner = true;
}
