@* ============================================================
   Block: login-otp-verification
   Title: Login Otp Verification
   Description: Six-digit OTP React verification block for Next.js with animated code input slots, verify button, resend code countdown, and spring entrance animation using shadcn/ui InputOTP, Tailwind CSS, and framer-motion
   Long Description: Four-digit PIN with numeric keypad
   Dependencies: ButtonCn, InputOtpCn, InputOtpGroupCn, InputOtpSeparatorCn, InputOtpSlotCn, LucideLockCn
   Source: original/blocks/login/login-otp-verification.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-4 py-8">
            <div class="flex flex-col items-center">
                <div class="mb-4 flex size-8 items-center justify-center rounded-full bg-muted">
                    <LucideLockCn Size="16" Class="size-4 text-muted-foreground" />
                </div>

                <h2 class="text-sm font-medium">Verification code</h2>
                <p class="mt-1 text-xs text-muted-foreground">
                    Enter the 6-digit code sent to alex@@acme.com
                </p>

                <div class="mt-6">
                    <InputOtpCn MaxLength="6" @bind-Value="_code">
                        <InputOtpGroupCn>
                            <InputOtpSlotCn Index="0" />
                            <InputOtpSlotCn Index="1" />
                            <InputOtpSlotCn Index="2" />
                        </InputOtpGroupCn>
                        <InputOtpSeparatorCn />
                        <InputOtpGroupCn>
                            <InputOtpSlotCn Index="3" />
                            <InputOtpSlotCn Index="4" />
                            <InputOtpSlotCn Index="5" />
                        </InputOtpGroupCn>
                    </InputOtpCn>
                </div>

                <div class="mt-6 w-full max-w-[260px] space-y-3">
                    <ButtonCn Class="w-full" Size="ButtonSize.Sm" Disabled="@(_code.Length < 6)">
                        Verify
                    </ButtonCn>

                    <p class="text-center text-xs text-muted-foreground">
                        Didn't receive a code?
                        <span class="cursor-pointer font-medium text-foreground hover:underline">Resend</span>
                    </p>
                </div>

                <p class="mt-4 text-center font-mono text-xs text-muted-foreground">
                    Expires in 9:42
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private string _code = "";
}
