@* ============================================================
   Block: login-privacy-notice
   Title: LoginPrivacyNotice
   Description: Login with privacy policy notice React block for Next.js with email and password form, expandable privacy summary, data handling highlights, and consent checkbox using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-privacy-notice.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Sign in</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Your privacy is important to us</p>
        </div>

        <div class="space-y-3 px-4 py-4">
            <div class="space-y-1.5">
                <LabelCn For="privacy-email" Class="text-xs font-medium text-muted-foreground">
                    Email
                </LabelCn>
                <InputCn id="privacy-email" Type="email" Placeholder="@("you@example.com")" />
            </div>
            <div class="space-y-1.5">
                <LabelCn For="privacy-pw" Class="text-xs font-medium text-muted-foreground">
                    Password
                </LabelCn>
                <InputCn id="privacy-pw" Type="password" Placeholder="Enter password" />
            </div>

            <div class="flex items-start gap-2 rounded-md bg-muted/50 p-3">
                <CheckboxCn Checked="@_accepted"
                            CheckedChanged="@((bool v) => _accepted = v)"
                            Class="mt-0.5" />
                <label for="privacy-consent" class="cursor-pointer text-xs text-muted-foreground">
                    I have read and agree to the&#32;
                    <span class="font-medium text-foreground">Privacy Policy</span> and&#32;
                    <span class="font-medium text-foreground">Terms of Service</span>
                </label>
            </div>

            <ButtonCn Class="w-full" Size="ButtonSize.Sm" Disabled="@(!_accepted)">
                Sign in
            </ButtonCn>
        </div>

        <div class="border-t">
            <button type="button"
                    @onclick="@(() => _showPrivacy = !_showPrivacy)"
                    class="flex w-full items-center gap-2 px-4 py-3 text-left">
                <LucideIconCn Name="shield" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="flex-1 text-xs font-medium text-muted-foreground">
                    How we handle your data
                </span>
                <LucideIconCn Name="chevron-down" Size="16" Class="@Cn.Merge("size-4 text-muted-foreground transition-transform duration-200", _showPrivacy ? "rotate-180" : "")" />
            </button>

            @if (_showPrivacy)
            {
                <div class="overflow-hidden">
                    <div class="space-y-2 px-4 pb-3">
                        @foreach (var point in _privacyPoints)
                        {
                            <div class="flex items-center gap-3 rounded-md px-3 py-2">
                                <LucideIconCn Name="@point.Icon" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                <div>
                                    <p class="text-xs font-medium">@point.Title</p>
                                    <p class="text-xs text-muted-foreground">@point.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _email = "";
    private string _password = "";
    private bool _showPrivacy;
    private bool _accepted;

    private record PrivacyPoint(string Icon, string Title, string Description);

    private static readonly PrivacyPoint[] _privacyPoints =
    [
        new("lock", "Encrypted in transit", "All data encrypted with TLS 1.3"),
        new("server", "Data residency", "Stored in EU data centers"),
        new("eye", "No tracking", "We don't sell your data to third parties"),
    ];
}
