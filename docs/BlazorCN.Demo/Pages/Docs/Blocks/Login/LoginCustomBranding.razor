@* ============================================================
   Block: login-custom-branding
   Title: LoginCustomBranding
   Description: White-label customizable branded React login block for Next.js with configurable company logo, brand colors, custom welcome text, email and password form, and brand footer using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-custom-branding.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="@($"h-1 {_brandAccentColor}")"></div>

        <div class="px-6 pt-8 pb-2 text-center">
            <div class="@($"mx-auto mb-4 flex size-12 items-center justify-center rounded-xl {_brandAccentColor} text-lg font-semibold text-white")">
                @_brandLogoInitial
            </div>
            <h2 class="text-sm font-medium">@_brandTagline</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Sign in to your @_brandName account
            </p>
        </div>

        <div class="space-y-3 px-6 py-5">
            <div class="space-y-1.5">
                <LabelCn For="brand-email" Class="text-xs font-medium text-muted-foreground">
                    Email
                </LabelCn>
                <InputCn Id="brand-email" Type="email" Placeholder="@("you@acme.com")" @bind-Value="_email" />
            </div>
            <div class="space-y-1.5">
                <LabelCn For="brand-pw" Class="text-xs font-medium text-muted-foreground">
                    Password
                </LabelCn>
                <InputCn Id="brand-pw" Type="password" Placeholder="Enter password" @bind-Value="_password" />
            </div>

            <div class="flex items-center justify-between">
                <button type="button" class="text-xs text-muted-foreground hover:text-foreground">
                    Forgot password?
                </button>
            </div>

            <ButtonCn Class="w-full">Sign in</ButtonCn>

            <SeparatorCn />

            <ButtonCn Variant="ButtonVariant.Outline" Class="w-full gap-2">
                <LucideIconCn Name="building" Size="16" Class="size-4" />
                Sign in with SSO
            </ButtonCn>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="palette" Size="12" Class="size-3" />
                <span>Powered by Acme Platform</span>
            </div>
        </div>
    </div>
</section>

@code {
    private string _brandName = "Acme Corp";
    private string _brandTagline = "Welcome to the Acme platform";
    private string _brandAccentColor = "bg-violet-500";
    private string _brandLogoInitial = "A";

    private string _email = "";
    private string _password = "";
}
