@* ============================================================
   Block: login-floating-labels
   Title: Login Floating Labels
   Description: Animated floating label React sign-in form for Next.js with labels that animate upward on focus, email and password inputs, remember me checkbox, and forgot password link using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Orchestrated entrance animations
   Dependencies: ButtonCn, CheckboxCn
   Source: original/blocks/login/login-floating-labels.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-8 py-8">
            <div class="space-y-8">
                <div class="relative">
                    <label for="login-fl-email"
                           class="@Cn.Merge("pointer-events-none absolute left-0 origin-left transition-all duration-150 ease-out", string.IsNullOrEmpty(_email) ? "top-3.5 text-sm text-muted-foreground" : "top-0 text-[11px] text-foreground")">
                        Email
                    </label>
                    <input id="login-fl-email" type="email" aria-label="Email"
                           @bind="_email" @bind:event="oninput"
                           class="h-12 w-full border-0 border-b border-border bg-transparent px-0 pt-4 text-sm placeholder-transparent outline-none transition-colors focus:border-foreground" />
                </div>

                <div class="relative">
                    <label for="login-fl-password"
                           class="@Cn.Merge("pointer-events-none absolute left-0 origin-left transition-all duration-150 ease-out", string.IsNullOrEmpty(_password) ? "top-3.5 text-sm text-muted-foreground" : "top-0 text-[11px] text-foreground")">
                        Password
                    </label>
                    <input id="login-fl-password" type="password" aria-label="Password"
                           @bind="_password" @bind:event="oninput"
                           class="h-12 w-full border-0 border-b border-border bg-transparent px-0 pt-4 text-sm placeholder-transparent outline-none transition-colors focus:border-foreground" />
                </div>
            </div>

            <div class="mt-6 flex items-center justify-between">
                <span class="flex cursor-pointer items-center gap-2">
                    <CheckboxCn id="login-fl-remember" aria-label="Remember me" />
                    <span class="text-xs text-muted-foreground">Remember me</span>
                </span>
                <span class="cursor-pointer text-xs text-muted-foreground hover:text-foreground">
                    Forgot password?
                </span>
            </div>

            <ButtonCn Class="mt-6 w-full" Size="ButtonSize.Sm">
                Sign in
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _email = "";
    private string _password = "";
}
