@* ============================================================
   Block: login-federated-identity
   Title: LoginFederatedIdentity
   Description: Federated identity provider selection React block for Next.js with provider list showing SAML, OIDC, and OAuth options, provider status indicators, and direct redirect buttons using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-federated-identity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="globe" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Choose Identity Provider</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Select your organization's identity provider to sign in
            </p>
        </div>

        <div>
            @foreach (var prov in _providers)
            {
                var item = prov;
                <div class="@Cn.Merge("flex items-center gap-3 border-b px-4 py-3 transition-colors last:border-b-0", item.Status == "active" ? "hover:bg-muted/50" : "opacity-50")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <p class="text-sm font-medium">@item.Name</p>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                @item.Protocol
                            </BadgeCn>
                        </div>
                        <p class="text-xs text-muted-foreground">@item.Domain</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", item.Status == "active" ? "bg-emerald-500" : "bg-muted-foreground/30")"></span>
                        @if (item.Status == "active")
                        {
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                Connect
                                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                            </ButtonCn>
                        }
                        else
                        {
                            <span class="text-xs text-muted-foreground">Unavailable</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <p class="text-xs text-muted-foreground">
                    @(_providers.Count(p => p.Status == "active")) providers available
                </p>
                <button type="button"
                        class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                    Use email and password
                </button>
            </div>
        </div>
    </div>
</section>

@code {
    private record Provider(string Id, string Name, string Protocol, string Status, string Domain);

    private static readonly Provider[] _providers =
    [
        new("p1", "Okta", "SAML", "active", "acme.okta.com"),
        new("p2", "Azure Active Directory", "OIDC", "active", "login.microsoftonline.com"),
        new("p3", "Google Workspace", "OAuth", "active", "accounts.google.com"),
        new("p4", "OneLogin", "SAML", "inactive", "acme.onelogin.com"),
        new("p5", "Auth0", "OIDC", "active", "acme.auth0.com"),
    ];
}
