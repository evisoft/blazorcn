@* ============================================================
   Block: login-profile-switch
   Title: LoginProfileSwitch
   Description: Profile switcher React login block for Next.js with saved user profiles list, avatar and role display, add account button, and remove profile option using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-profile-switch.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Choose an account</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Select a profile to sign in</p>
        </div>

        <div>
            @foreach (var profile in _profiles)
            {
                var p = profile;
                <div class="flex items-center gap-3 border-b px-4 py-3 transition-colors last:border-b-0 hover:bg-muted/50">
                    <AvatarCn Class="size-9">
                        <AvatarFallbackCn Class="text-xs">@p.Initials</AvatarFallbackCn>
                    </AvatarCn>
                    <div class="min-w-0 flex-1 cursor-pointer">
                        <div class="flex items-center gap-2">
                            <p class="text-sm font-medium">@p.Name</p>
                            <span class="rounded bg-muted px-1.5 py-0.5 text-xs text-muted-foreground">
                                @p.Role
                            </span>
                        </div>
                        <p class="text-xs text-muted-foreground">
                            @p.Email &middot; @p.LastActive
                        </p>
                    </div>
                    <button type="button"
                            aria-label="Remove @p.Name"
                            @onclick="@(() => RemoveProfile(p.Id))"
                            class="rounded-md p-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </button>
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full gap-1.5">
                <LucideIconCn Name="plus" Size="14" Class="size-3.5" />
                Add another account
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record UserProfile(string Id, string Name, string Email, string Role, string Initials, string LastActive);

    private List<UserProfile> _profiles =
    [
        new("p1", "Alex Johnson", "alex@acme.com", "Admin", "AJ", "Just now"),
        new("p2", "Sam Rivera", "sam@acme.com", "Developer", "SR", "2 hours ago"),
        new("p3", "Jordan Lee", "jordan@startup.io", "Viewer", "JL", "Yesterday"),
    ];

    private void RemoveProfile(string id)
    {
        _profiles = _profiles.Where(p => p.Id != id).ToList();
    }
}
