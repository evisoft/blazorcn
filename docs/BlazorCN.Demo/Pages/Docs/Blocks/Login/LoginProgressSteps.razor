@* ============================================================
   Block: login-progress-steps
   Title: Login Progress Steps
   Description: Multi-step React login wizard for Next.js with visual progress bar, three authentication steps for credentials verification and completion, step icons, success animation, and slide transitions using shadcn/ui Progress, Input, Button, Tailwind CSS, and framer-motion
   Long Description:
   Dependencies: ButtonCn, InputCn, InputOtpCn, InputOtpGroupCn, InputOtpSlotCn, LabelCn, LucideCheckCn, LucideLockCn, LucideShieldCn, LucideUserCn, ProgressCn
   Source: original/blocks/login/login-progress-steps.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-4 pt-3">
            <ProgressCn Value="@ProgressValue" Class="h-1" aria-label="Progress" />
        </div>

        <div class="flex justify-between px-4 py-3">
            @for (var idx = 0; idx < _steps.Length; idx++)
            {
                var i = idx;
                var step = _steps[i];
                var isCompleted = i < _currentStep;
                var isActive = i == _currentStep;
                <div class="flex flex-col items-center gap-1">
                    <div class="@Cn.Merge("flex size-6 items-center justify-center rounded-full", isCompleted || isActive ? "bg-primary text-primary-foreground" : "bg-muted text-muted-foreground")">
                        @if (isCompleted)
                        {
                            <LucideCheckCn Size="12" Class="size-3" />
                        }
                        else if (step.Icon == "user")
                        {
                            <LucideUserCn Size="12" Class="size-3" />
                        }
                        else if (step.Icon == "lock")
                        {
                            <LucideLockCn Size="12" Class="size-3" />
                        }
                        else
                        {
                            <LucideShieldCn Size="12" Class="size-3" />
                        }
                    </div>
                    <span class="@Cn.Merge("text-[10px]", isActive || isCompleted ? "font-medium text-foreground" : "text-muted-foreground")">
                        @step.Label
                    </span>
                </div>
            }
        </div>

        <div class="border-t" />

        @if (_currentStep == 0)
        {
            <div class="px-4 py-6">
                <div class="mx-auto max-w-xs space-y-4">
                    <div class="space-y-2">
                        <LabelCn For="prog-email" Class="text-xs text-muted-foreground">Email</LabelCn>
                        <InputCn id="prog-email" Type="email" Placeholder="@("you@@company.com")"
                                 Class="h-8 text-sm" />
                    </div>
                    <ButtonCn Class="h-8 w-full text-xs" OnClick="@(() => _currentStep = 1)">
                        Continue
                    </ButtonCn>
                </div>
            </div>
        }
        else if (_currentStep == 1)
        {
            <div class="px-4 py-6">
                <div class="mx-auto max-w-xs space-y-4">
                    <div class="space-y-2">
                        <LabelCn For="prog-pass" Class="text-xs text-muted-foreground">Password</LabelCn>
                        <InputCn id="prog-pass" Type="password" Placeholder="Enter password"
                                 Class="h-8 text-sm" />
                    </div>
                    <ButtonCn Class="h-8 w-full text-xs" OnClick="@(() => _currentStep = 2)">
                        Continue
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="h-7 w-full text-xs text-muted-foreground"
                              OnClick="@(() => _currentStep = 0)">
                        Back
                    </ButtonCn>
                </div>
            </div>
        }
        else if (!_verified)
        {
            <div class="px-4 py-6">
                <div class="mx-auto flex max-w-xs flex-col items-center space-y-4">
                    <p class="text-center text-xs text-muted-foreground">
                        Enter the 6-digit code sent to your email
                    </p>
                    <InputOtpCn MaxLength="6" @bind-Value="_otp">
                        <InputOtpGroupCn>
                            <InputOtpSlotCn Index="0" />
                            <InputOtpSlotCn Index="1" />
                            <InputOtpSlotCn Index="2" />
                            <InputOtpSlotCn Index="3" />
                            <InputOtpSlotCn Index="4" />
                            <InputOtpSlotCn Index="5" />
                        </InputOtpGroupCn>
                    </InputOtpCn>
                    <ButtonCn Class="h-8 w-full text-xs" OnClick="@(() => _verified = true)">
                        Verify
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Class="h-7 w-full text-xs text-muted-foreground"
                              OnClick="@(() => _currentStep = 1)">
                        Back
                    </ButtonCn>
                </div>
            </div>
        }
        else
        {
            <div class="flex flex-col items-center px-4 py-8">
                <div class="flex size-10 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideCheckCn Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
                </div>
                <p class="mt-3 text-sm font-medium">Verified</p>
                <p class="mt-1 text-xs text-muted-foreground">Authentication successful</p>
            </div>
        }
    </div>
</section>

@code {
    private int _currentStep;
    private bool _verified;
    private string _otp = "";

    private record Step(string Label, string Icon);

    private static readonly Step[] _steps =
    [
        new("Account", "user"),
        new("Password", "lock"),
        new("Verify", "shield"),
    ];

    private int ProgressValue => _currentStep == 0 ? 33 : _currentStep == 1 ? 66 : 100;
}
