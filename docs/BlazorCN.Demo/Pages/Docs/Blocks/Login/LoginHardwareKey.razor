@* ============================================================
   Block: login-hardware-key
   Title: LoginHardwareKey
   Description: Hardware security key YubiKey React authentication block for Next.js with animated key icon, insert-key prompt, blinking status indicator, and USB and NFC method options using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-hardware-key.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-4 py-3">
      <p class="text-sm font-medium">Hardware Security Key</p>
      <p class="mt-0.5 text-xs text-muted-foreground">
        Use your FIDO2 security key to authenticate
      </p>
    </div>

    <div class="flex flex-col items-center px-4 py-10">
      <div class="relative mb-6">
        <div class="@(_waiting ? "absolute inset-0 rounded-2xl bg-muted-foreground/10 animate-ping" : "absolute inset-0 rounded-2xl bg-muted-foreground/10")"></div>
        <div class="relative flex size-20 items-center justify-center rounded-2xl bg-muted/50">
          <LucideIconCn Name="key" Size="36" Class="size-9 text-muted-foreground" />
        </div>
      </div>

      <p class="text-sm font-medium">
        @(_waiting ? "Waiting for your key..." : "Insert your security key")
      </p>
      <p class="mt-1 text-xs text-muted-foreground">
        @(_method == "usb"
          ? "Insert your key into a USB port and tap the button"
          : "Hold your key near the NFC reader")
      </p>

      @if (_waiting)
      {
        <div class="mt-4 flex items-center gap-2 animate-pulse">
          <span class="size-2 rounded-full bg-amber-500"></span>
          <span class="text-xs text-muted-foreground">Listening for key...</span>
        </div>
      }

      <div class="mt-6 flex gap-2">
        <ButtonCn Variant="@(_method == "usb" ? ButtonVariant.Default : ButtonVariant.Outline)"
                  Size="ButtonSize.Sm"
                  Class="gap-1.5"
                  OnClick="@(() => SelectMethod("usb"))">
          <LucideIconCn Name="usb" Size="14" Class="size-3.5" />
          USB
        </ButtonCn>
        <ButtonCn Variant="@(_method == "nfc" ? ButtonVariant.Default : ButtonVariant.Outline)"
                  Size="ButtonSize.Sm"
                  Class="gap-1.5"
                  OnClick="@(() => SelectMethod("nfc"))">
          <LucideIconCn Name="nfc" Size="14" Class="size-3.5" />
          NFC
        </ButtonCn>
      </div>

      @if (!_waiting)
      {
        <ButtonCn Class="mt-4" Size="ButtonSize.Sm" OnClick="@(() => _waiting = true)">
          Start authentication
        </ButtonCn>
      }
    </div>

    <div class="border-t px-4 py-3">
      <div class="flex items-center justify-between">
        <p class="text-xs text-muted-foreground">
          Compatible with YubiKey, Titan, SoloKeys
        </p>
        <button type="button" class="text-xs text-muted-foreground transition-colors hover:text-foreground">
          Use another method
        </button>
      </div>
    </div>
  </div>
</section>

@code {
  private string _method = "usb";
  private bool _waiting = false;

  private void SelectMethod(string method)
  {
    _method = method;
    _waiting = false;
  }
}
