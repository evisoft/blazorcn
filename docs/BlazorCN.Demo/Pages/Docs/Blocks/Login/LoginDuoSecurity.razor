@* ============================================================
   Block: login-duo-security
   Title: LoginDuoSecurity
   Description: Duo Security push notification React authentication block for Next.js with push sent animation, approve on phone prompt, method switcher for SMS and call, and timeout countdown using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-duo-security.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-4 py-3">
      <p class="text-sm font-medium">Two-Factor Authentication</p>
      <p class="mt-0.5 text-xs text-muted-foreground">
        Verify your identity with Duo Security
      </p>
    </div>

    <div class="flex flex-col items-center px-4 py-8">
      @if (_method == "push")
      {
        <div class="flex flex-col items-center">
          <div class="relative mb-6">
            <div class="absolute inset-0 rounded-full bg-blue-500/20"></div>
            <div class="relative flex size-16 items-center justify-center rounded-full bg-blue-500/10">
              <LucideIconCn Name="smartphone" Size="28" Class="size-7 text-blue-600" />
            </div>
          </div>

          <p class="text-sm font-medium">Push sent to your device</p>
          <p class="mt-1 text-xs text-muted-foreground">
            Approve the request on your Duo Mobile app
          </p>
          <p class="mt-1 font-mono text-xs text-muted-foreground">
            iPhone 15 &middot; +1 (***) ***-4821
          </p>

          <p class="mt-6 font-mono text-xs text-muted-foreground">Expires in 0:58</p>
        </div>
      }

      @if (_method == "sms")
      {
        <div class="flex flex-col items-center">
          <div class="mb-6 flex size-16 items-center justify-center rounded-full bg-muted/50">
            <LucideIconCn Name="message-square" Size="28" Class="size-7 text-muted-foreground" />
          </div>
          <p class="text-sm font-medium">SMS code sent</p>
          <p class="mt-1 text-xs text-muted-foreground">
            Enter the code sent to +1 (***) ***-4821
          </p>
          <div class="mt-4 flex gap-1">
            @foreach (var i in Enumerable.Range(0, 6))
            {
              <div class="flex size-10 items-center justify-center rounded-md border bg-background font-mono text-sm">
              </div>
            }
          </div>
          <ButtonCn Class="mt-4 w-full max-w-[260px]" Size="ButtonSize.Sm">
            Verify code
          </ButtonCn>
        </div>
      }

      @if (_method == "call")
      {
        <div class="flex flex-col items-center">
          <div class="mb-6 flex size-16 items-center justify-center rounded-full bg-muted/50">
            <LucideIconCn Name="phone" Size="28" Class="size-7 text-muted-foreground" />
          </div>
          <p class="text-sm font-medium">Calling your phone</p>
          <p class="mt-1 text-xs text-muted-foreground">
            Answer and press any key to approve
          </p>
          <p class="mt-1 font-mono text-xs text-muted-foreground">+1 (***) ***-4821</p>
          <div class="mt-4 text-xs text-muted-foreground">
            Ringing...
          </div>
        </div>
      }
    </div>

    <div class="border-t px-4 py-3">
      <p class="mb-2 text-xs font-medium text-muted-foreground">
        Other verification methods
      </p>
      <div class="flex gap-2">
        @if (_method != "push")
        {
          <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-1.5 text-xs" OnClick="@(() => _method = "push")">
            <LucideIconCn Name="smartphone" Size="14" Class="size-3.5" />
            Duo Push
          </ButtonCn>
        }
        @if (_method != "sms")
        {
          <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-1.5 text-xs" OnClick="@(() => _method = "sms")">
            <LucideIconCn Name="message-square" Size="14" Class="size-3.5" />
            SMS
          </ButtonCn>
        }
        @if (_method != "call")
        {
          <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-1.5 text-xs" OnClick="@(() => _method = "call")">
            <LucideIconCn Name="phone" Size="14" Class="size-3.5" />
            Phone call
          </ButtonCn>
        }
      </div>
    </div>
  </div>
</section>

@code {
    private string _method = "push";
}
