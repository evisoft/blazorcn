@* ============================================================
   Block: login-step-verification
   Title: LoginStepVerification
   Description: Step-by-step verification React login block for Next.js with multi-step progress indicator, email entry, password entry, and two-factor code stages, back navigation, and completion state using shadcn/ui, Tailwind CSS, and Lucide icons
   Source: original/blocks/login/login-step-verification.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Sign in to your account</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Complete each step to verify your identity
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                @for (var idx = 0; idx < _steps.Length; idx++)
                {
                    var i = idx;
                    var step = _steps[i];
                    var isCompleted = _currentStep > step.Id;
                    var isActive = _currentStep == step.Id;
                    var isFinal = _currentStep == 4;
                    <div class="flex items-center gap-2">
                        <div class="flex items-center gap-1.5">
                            <div class="@Cn.Merge("flex size-6 items-center justify-center rounded-full text-xs transition-colors", (isCompleted || isFinal) ? "bg-emerald-500/10 text-emerald-600" : isActive ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                                @if (isCompleted || isFinal)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideIconCn Name="@step.IconName" Size="12" Class="size-3" />
                                }
                            </div>
                            <span class="@Cn.Merge("text-xs", isActive ? "font-medium" : "text-muted-foreground")">
                                @step.Label
                            </span>
                        </div>
                        @if (i < _steps.Length - 1)
                        {
                            <div class="@Cn.Merge("h-px w-8", _currentStep > step.Id ? "bg-emerald-500/50" : "bg-border")" />
                        }
                    </div>
                }
            </div>
        </div>

        <div class="px-4 py-4">
            @if (_currentStep == 1)
            {
                <div class="space-y-3">
                    <div class="space-y-1.5">
                        <LabelCn For="step-email" Class="text-xs font-medium text-muted-foreground">
                            Email address
                        </LabelCn>
                        <InputCn id="step-email" Type="email" Placeholder="@("you@@example.com")"
                                 @bind-Value="_email" />
                    </div>
                    <p class="text-xs text-muted-foreground">
                        We'll check if your account exists and determine the sign-in method.
                    </p>
                </div>
            }

            @if (_currentStep == 2)
            {
                <div class="space-y-3">
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="flex items-center gap-2 text-xs text-muted-foreground">
                            <LucideIconCn Name="mail" Size="14" Class="size-3.5" />
                            <span>@(string.IsNullOrEmpty(_email) ? "alex@acme.com" : _email)</span>
                        </div>
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="step-password" Class="text-xs font-medium text-muted-foreground">
                            Password
                        </LabelCn>
                        <InputCn id="step-password" Type="password" Placeholder="Enter your password"
                                 @bind-Value="_password" />
                    </div>
                    <button type="button" class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                        Forgot password?
                    </button>
                </div>
            }

            @if (_currentStep == 3)
            {
                <div class="space-y-3">
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-xs font-medium text-muted-foreground">
                            Two-factor authentication
                        </p>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            Enter the 6-digit code from your authenticator app
                        </p>
                    </div>
                    <div class="space-y-1.5">
                        <LabelCn For="step-code" Class="text-xs font-medium text-muted-foreground">
                            Verification code
                        </LabelCn>
                        <InputCn id="step-code" Type="text" Placeholder="000000"
                                 MaxLength="6" Class="font-mono tracking-widest"
                                 @bind-Value="_code" />
                    </div>
                    <button type="button" class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                        Use backup code instead
                    </button>
                </div>
            }

            @if (_currentStep == 4)
            {
                <div class="flex flex-col items-center py-4">
                    <div class="mb-3 flex size-12 items-center justify-center rounded-full bg-emerald-500/10">
                        <LucideIconCn Name="shield-check" Size="20" Class="size-5 text-emerald-600" />
                    </div>
                    <p class="text-sm font-medium">Verification complete</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        All steps passed. Redirecting to your account.
                    </p>
                </div>
            }
        </div>

        <hr class="border-border" />

        <div class="flex items-center justify-between px-4 py-3">
            @if (_currentStep > 1 && _currentStep < 4)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="gap-1.5 text-xs" OnClick="GoBack">
                    <LucideIconCn Name="arrow-left" Size="12" Class="size-3" />
                    Back
                </ButtonCn>
            }
            else
            {
                <div />
            }
            @if (_currentStep < 4)
            {
                <ButtonCn Size="ButtonSize.Sm" Class="gap-1.5 text-xs" OnClick="GoNext">
                    @(_currentStep == 3 ? "Verify" : "Continue")
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private int _currentStep = 1;
    private string _email = "";
    private string _password = "";
    private string _code = "";

    private record StepInfo(int Id, string Label, string IconName);

    private static readonly StepInfo[] _steps =
    [
        new(1, "Email", "mail"),
        new(2, "Password", "lock"),
        new(3, "Verify", "key-round"),
    ];

    private void GoNext()
    {
        if (_currentStep < 4)
            _currentStep++;
    }

    private void GoBack()
    {
        if (_currentStep > 1)
            _currentStep--;
    }
}
