@* ============================================================
   Block: login-ip-restriction
   Title: LoginIpRestriction
   Description: IP-restricted login with location check React block for Next.js with current IP display, allowed network list, VPN detection warning, and request access button using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-ip-restriction.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideShieldAlertCn Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Network Access Check</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Your network is being verified against allowed IP ranges
            </p>
        </div>

        <div class="border-b px-4 py-4">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Your connection</p>
                <div class="space-y-1.5">
                    <div class="flex items-center gap-2 text-xs">
                        <LucideGlobeCn Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="font-mono">192.168.1.42</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                            IPv4
                        </BadgeCn>
                    </div>
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideMapPinCn Size="14" Class="size-3.5" />
                        <span>New York, NY, United States</span>
                    </div>
                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                        <LucideWifiCn Size="14" Class="size-3.5" />
                        <span>ISP: Acme Networks Inc.</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Allowed networks</p>
            <div class="space-y-1.5">
                @foreach (var network in _networks)
                {
                    <div class="flex items-center gap-3 rounded-md px-3 py-2 transition-colors hover:bg-muted/30">
                        <span class="@(network.Status == "match" ? "size-1.5 shrink-0 rounded-full bg-emerald-500" : "size-1.5 shrink-0 rounded-full bg-muted-foreground/30")"></span>
                        <div class="min-w-0 flex-1">
                            <p class="text-xs font-medium">@network.Name</p>
                            <p class="font-mono text-xs text-muted-foreground">@network.Range</p>
                        </div>
                        <span class="text-xs text-muted-foreground">
                            @(network.Status == "match" ? "Connected" : "Not connected")
                        </span>
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs font-medium text-emerald-600">Network verified</span>
                </div>
                <ButtonCn Size="ButtonSize.Sm">Continue to sign in</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record AllowedNetwork(string Name, string Range, string Status);

    private static readonly AllowedNetwork[] _networks =
    [
        new("Corporate HQ", "10.0.0.0/8", "no-match"),
        new("VPN Gateway", "172.16.0.0/12", "no-match"),
        new("Branch Office - NYC", "192.168.1.0/24", "match"),
    ];
}
