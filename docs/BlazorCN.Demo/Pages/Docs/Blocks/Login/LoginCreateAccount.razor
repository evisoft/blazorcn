@* ============================================================
   Block: login-create-account
   Title: Login Create Account
   Description: Account registration React form block for Next.js with name, email, password with visual strength indicator bars, confirm password, terms text, and slide-up field animations using shadcn/ui Input, Button, Label, Tailwind CSS, and framer-motion
   Long Description: Combined sign-in and registration tabs
   Dependencies: ButtonCn, InputCn, LabelCn
   Source: original/blocks/login/login-create-account.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Create your account</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Fill in your details to get started
            </p>
        </div>

        <div class="space-y-4 px-4 py-4">
            <div class="space-y-1.5">
                <LabelCn For="ca-name" Class="text-xs">Full name</LabelCn>
                <InputCn id="ca-name" Type="text" Placeholder="Jane Smith"
                         @bind-Value="_name" />
            </div>

            <div class="space-y-1.5">
                <LabelCn For="ca-email" Class="text-xs">Email</LabelCn>
                <InputCn id="ca-email" Type="email" Placeholder="@("jane@@company.com")"
                         @bind-Value="_email" />
            </div>

            <div class="space-y-1.5">
                <LabelCn For="ca-password" Class="text-xs">Password</LabelCn>
                <InputCn id="ca-password" Type="password" Placeholder="Create a password"
                         @bind-Value="_password" />
                @if (_password.Length > 0)
                {
                    <div class="space-y-1 pt-1">
                        <div class="flex gap-1">
                            @for (var i = 0; i < 4; i++)
                            {
                                <div class="@Cn.Merge("h-1 flex-1 rounded-full transition-colors", i < StrengthLevel ? StrengthColors[StrengthLevel] : "bg-muted")" />
                            }
                        </div>
                        <p class="text-xs text-muted-foreground">@StrengthLabels[StrengthLevel]</p>
                    </div>
                }
            </div>

            <div class="space-y-1.5">
                <LabelCn For="ca-confirm" Class="text-xs">Confirm password</LabelCn>
                <InputCn id="ca-confirm" Type="password" Placeholder="Confirm your password"
                         @bind-Value="_confirm" />
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <ButtonCn Class="w-full">Create account</ButtonCn>
            <p class="mt-3 text-center text-xs text-muted-foreground">
                Already have an account?
                <span class="cursor-pointer text-foreground underline underline-offset-2">Sign in</span>
            </p>
            <p class="mt-2 text-center text-xs leading-relaxed text-muted-foreground">
                By creating an account, you agree to our
                <span class="cursor-pointer underline underline-offset-2">Terms of Service</span>
                and <span class="cursor-pointer underline underline-offset-2">Privacy Policy</span>.
            </p>
        </div>
    </div>
</section>

@code {
    private string _name = "";
    private string _email = "";
    private string _password = "";
    private string _confirm = "";

    private static readonly string[] StrengthLabels = ["", "Weak", "Fair", "Good", "Strong"];
    private static readonly string[] StrengthColors = ["", "bg-red-500", "bg-amber-500", "bg-yellow-500", "bg-emerald-500"];

    private int StrengthLevel
    {
        get
        {
            if (_password.Length == 0) return 0;
            if (_password.Length < 4) return 1;
            if (_password.Length < 8) return 2;
            if (_password.Length < 12) return 3;
            return 4;
        }
    }
}
