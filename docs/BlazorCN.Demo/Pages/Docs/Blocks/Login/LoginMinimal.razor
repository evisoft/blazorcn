@* ============================================================
   Block: login-minimal
   Title: Login Minimal
   Description: Minimal React sign-in form block for Next.js with animated email and password inputs, submit button, and fade-in entrance using shadcn/ui Input, Button, Label components, Tailwind CSS, and framer-motion
   Long Description: Centered card layout with social auth buttons
   Dependencies: ButtonCn
   Source: original/blocks/login/login-minimal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div
        class="overflow-hidden rounded-lg border bg-card"
      >
        <div class="px-8 py-10">
          <p class="mb-8 text-center text-sm text-muted-foreground">Sign in</p>

          <div class="mx-auto max-w-[280px] space-y-5">
            <input
              type="email"
              placeholder="Email"
              @bind="_email"
              class="h-10 w-full border-0 border-b border-border bg-transparent px-0 text-sm outline-none transition-colors placeholder:text-muted-foreground/60 focus:border-foreground"
            />

            <input
              type="password"
              placeholder="Password"
              @bind="_password"
              class="h-10 w-full border-0 border-b border-border bg-transparent px-0 text-sm outline-none transition-colors placeholder:text-muted-foreground/60 focus:border-foreground"
            />

            <ButtonCn Class="h-9 w-full text-sm">Sign in</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
              <span class="cursor-pointer hover:text-foreground">Forgot password?</span>
            </p>
          </div>
        </div>
      </div>
    </section>

@code {
    private string _email = "";
    private string _password = "";
}
