@* ============================================================
   Block: login-lockout-recovery
   Title: LoginLockoutRecovery
   Description: Account lockout recovery React block for Next.js with lockout reason display, remaining attempts counter, recovery options list, and cooldown timer using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-lockout-recovery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="flex items-center gap-2 bg-red-500/10 px-4 py-2">
      <LucideLockCn Size="14" Class="text-red-600" />
      <span class="text-xs font-medium text-red-700 dark:text-red-400">
        Account temporarily locked
      </span>
    </div>

    <div class="border-b px-4 py-4 text-center">
      <div class="mx-auto mb-3 flex size-10 items-center justify-center rounded-full bg-red-500/10">
        <LucideLockCn Size="20" Class="text-red-500" />
      </div>
      <p class="text-sm font-medium">Too many failed attempts</p>
      <p class="mt-1 text-xs text-muted-foreground">
        5 incorrect password attempts for alex@@acme.com
      </p>
      <div class="mt-3 inline-flex items-center gap-1.5 rounded-md bg-muted/50 px-3 py-1.5">
        <span class="text-xs text-muted-foreground">Try again in</span>
        <span class="font-mono text-sm font-semibold">14:32</span>
      </div>
    </div>

    <div class="px-4 py-3">
      <p class="mb-2 text-xs font-medium text-muted-foreground">Recovery options</p>
      <div class="space-y-1">
        @foreach (var opt in _recoveryOptions)
        {
          <button type="button" class="flex w-full items-center gap-3 rounded-md px-3 py-2.5 text-left transition-colors hover:bg-muted/50">
            <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
              <LucideIconCn Name="@opt.Icon" Size="16" Class="text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
              <p class="text-xs font-medium">@opt.Label</p>
              <p class="text-xs text-muted-foreground">@opt.Description</p>
            </div>
          </button>
        }
      </div>
    </div>

    <div class="border-t px-4 py-3">
      <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full">
        Try a different account
      </ButtonCn>
    </div>
  </div>
</section>

@code {
  private record RecoveryOption(string Id, string Label, string Description, string Icon);

  private static readonly RecoveryOption[] _recoveryOptions =
  [
    new("email", "Reset via email", "Send a reset link to a***@@acme.com", "mail"),
    new("phone", "Verify by phone", "Send code to +1 (***) ***-4821", "smartphone"),
    new("backup", "Use backup code", "Enter a saved recovery code", "key"),
    new("helpdesk", "Contact IT helpdesk", "Avg response: 12 minutes", "headphones"),
  ];
}
