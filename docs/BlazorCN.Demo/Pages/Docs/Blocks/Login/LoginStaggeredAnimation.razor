@* ============================================================
   Block: login-staggered-animation
   Title: Login Staggered Animation
   Description: Orchestrated React sign-in form for Next.js with sequential staggered entrance animations on logo, title, form fields, and button using shadcn/ui Input, Button, Label, Tailwind CSS, and framer-motion variants with staggerChildren
   Long Description: React Login Split Diagonal Block
   Dependencies: ButtonCn, InputCn, LabelCn
   Source: original/blocks/login/login-staggered-animation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="p-8">
            <div class="mb-5 flex justify-center">
                <div class="flex size-8 items-center justify-center rounded-lg bg-foreground text-sm font-semibold text-background">
                    A
                </div>
            </div>

            <h2 class="text-center text-lg font-semibold">Welcome back</h2>
            <p class="mt-1 text-center text-xs text-muted-foreground">Sign in to your account</p>

            <div class="mx-auto mt-6 max-w-xs space-y-5">
                <div class="space-y-2">
                    <LabelCn For="stag-email" Class="text-xs text-muted-foreground">Email address</LabelCn>
                    <InputCn id="stag-email" Type="email" Placeholder="@("you@@company.com")"
                             Class="h-9 text-sm" />
                </div>

                <div class="space-y-2">
                    <LabelCn For="stag-password" Class="text-xs text-muted-foreground">Password</LabelCn>
                    <InputCn id="stag-password" Type="password" Placeholder="Enter your password"
                             Class="h-9 text-sm" />
                </div>

                <ButtonCn Class="h-9 w-full text-sm">Sign in</ButtonCn>

                <div class="text-center">
                    <button type="button"
                            class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                        Forgot password?
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

