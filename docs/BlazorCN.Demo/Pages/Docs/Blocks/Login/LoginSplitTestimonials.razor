@* ============================================================
   Block: login-split-testimonials
   Title: LoginSplitTestimonials
   Description: Split layout React login block for Next.js with testimonials carousel on left panel, email and password form on right, auto-rotating quotes with avatar and role, and social sign-in options using shadcn/ui, Tailwind CSS, and Lucide icons
   Source: original/blocks/login/login-split-testimonials.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card md:grid md:grid-cols-2">
        <div class="flex flex-col justify-between border-b bg-muted/30 px-6 py-8 md:border-b-0 md:border-r">
            <div>
                <LucideIconCn Name="quote" Size="24" Class="mb-4 size-6 text-muted-foreground/40" />
                <p class="text-sm leading-relaxed text-foreground">@_current.Quote</p>
            </div>

            <div class="mt-6">
                <div class="flex items-center gap-3">
                    <div class="flex size-9 items-center justify-center rounded-full bg-muted text-xs font-medium">
                        @_current.Initials
                    </div>
                    <div>
                        <p class="text-sm font-medium">@_current.Name</p>
                        <p class="text-xs text-muted-foreground">@_current.Role, @_current.Company</p>
                    </div>
                </div>

                <div class="mt-4 flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" @onclick="GoPrev">
                        <LucideIconCn Name="chevron-left" Size="16" Class="size-4" />
                    </ButtonCn>
                    <div class="flex gap-1.5">
                        @for (var i = 0; i < _testimonials.Length; i++)
                        {
                            var idx = i;
                            <span class="@($"size-1.5 rounded-full transition-colors {(idx == _currentIndex ? "bg-foreground" : "bg-muted-foreground/30")}")"></span>
                        }
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" @onclick="GoNext">
                        <LucideIconCn Name="chevron-right" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        <div class="px-6 py-8">
            <div class="mb-6">
                <p class="text-sm font-medium">Sign in to your account</p>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    Welcome back. Enter your credentials below.
                </p>
            </div>

            <div class="space-y-3">
                <ButtonCn Variant="ButtonVariant.Outline" Class="h-9 w-full gap-2.5 text-sm">
                    <svg class="size-4" viewBox="0 0 24 24" aria-label="Google logo">
                        <title>Google</title>
                        <path
                            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"
                            fill="#4285F4" />
                        <path
                            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                            fill="#34A853" />
                        <path
                            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
                            fill="#FBBC05" />
                        <path
                            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                            fill="#EA4335" />
                    </svg>
                    Continue with Google
                </ButtonCn>

                <ButtonCn Variant="ButtonVariant.Outline" Class="h-9 w-full gap-2.5 text-sm">
                    <LucideIconCn Name="github" Size="16" Class="size-4" />
                    Continue with GitHub
                </ButtonCn>

                <div class="relative py-1">
                    <SeparatorCn />
                    <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-card px-3 text-xs text-muted-foreground">
                        or
                    </span>
                </div>

                <div class="space-y-1.5">
                    <LabelCn for="split-test-email" Class="text-xs font-medium text-muted-foreground">
                        Email
                    </LabelCn>
                    <InputCn
                        id="split-test-email"
                        type="email"
                        Placeholder="@("you@example.com")"
                        @bind-Value="_email" />
                </div>

                <div class="space-y-1.5">
                    <LabelCn for="split-test-pw" Class="text-xs font-medium text-muted-foreground">
                        Password
                    </LabelCn>
                    <InputCn
                        id="split-test-pw"
                        type="password"
                        Placeholder="Enter your password"
                        @bind-Value="_password" />
                </div>

                <ButtonCn Class="h-9 w-full">Sign in</ButtonCn>

                <p class="text-center text-xs text-muted-foreground">
                    New here?@(" ")
                    <span class="cursor-pointer font-medium text-foreground hover:underline">
                        Create an account
                    </span>
                </p>
            </div>
        </div>
    </div>
</section>

@code {
    private int _currentIndex;
    private string _email = "";
    private string _password = "";

    private Testimonial _current => _testimonials[_currentIndex];

    private void GoNext()
    {
        _currentIndex = (_currentIndex + 1) % _testimonials.Length;
    }

    private void GoPrev()
    {
        _currentIndex = (_currentIndex - 1 + _testimonials.Length) % _testimonials.Length;
    }

    private record Testimonial(string Id, string Quote, string Name, string Role, string Company, string Initials);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Switching to this platform cut our onboarding time in half. The developer experience is unmatched.", "Sarah Chen", "CTO", "Streamline", "SC"),
        new("t2", "We shipped our entire dashboard in two weeks. The component library is exactly what we needed.", "Marcus Rivera", "Lead Engineer", "Baseform", "MR"),
        new("t3", "The best investment our team made this year. Support is fast and the docs are excellent.", "Emily Park", "VP of Product", "Helix Labs", "EP"),
    ];
}
