@* ============================================================
   Block: login-self-service-reset
   Title: LoginSelfServiceReset
   Description: Self-service password reset React block for Next.js with email input, new password fields with strength meter, requirements checklist, and success confirmation using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-self-service-reset.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Reset Your Password</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Create a new password for your account
            </p>
        </div>

        <div class="space-y-4 px-4 py-4">
            <div class="space-y-1.5">
                <LabelCn For="ssr-new-pw" Class="text-xs font-medium text-muted-foreground">
                    New password
                </LabelCn>
                <InputCn id="ssr-new-pw" Type="password" @bind-Value="_newPassword"
                         Placeholder="Enter new password" />
                @if (!string.IsNullOrEmpty(_newPassword))
                {
                    <div class="mt-1 flex gap-1">
                        @foreach (var i in _strengthIndices)
                        {
                            var idx = i;
                            var colorClass = idx < _passedCount
                                ? (_passedCount <= 2 ? "bg-red-500" : _passedCount <= 3 ? "bg-amber-500" : "bg-emerald-500")
                                : "bg-muted";
                            <div class="@Cn.Merge("h-1 flex-1 rounded-full transition-colors", colorClass)"></div>
                        }
                    </div>
                    <p class="mt-1 text-xs text-muted-foreground">
                        @(_strengthPercent <= 40 ? "Weak" : _strengthPercent <= 60 ? "Fair" : _strengthPercent <= 80 ? "Good" : "Strong")
                    </p>
                }
            </div>

            <div class="space-y-1.5">
                <LabelCn For="ssr-confirm-pw" Class="text-xs font-medium text-muted-foreground">
                    Confirm password
                </LabelCn>
                <InputCn id="ssr-confirm-pw" Type="password" @bind-Value="_confirmPassword"
                         Placeholder="Confirm new password" />
                @if (!string.IsNullOrEmpty(_confirmPassword))
                {
                    <p class="@Cn.Merge("text-xs", _passwordsMatch ? "text-emerald-600" : "text-red-500")">
                        @(_passwordsMatch ? "Passwords match" : "Passwords do not match")
                    </p>
                }
            </div>

            <div class="rounded-md bg-muted/50 p-3">
                <p class="mb-2 text-xs font-medium text-muted-foreground">Requirements</p>
                <div class="space-y-1">
                    @foreach (var req in _requirements)
                    {
                        var passed = req.Test(_newPassword);
                        <div class="flex items-center gap-2 text-xs">
                            @if (passed)
                            {
                                <LucideCheckCn Size="12" Class="size-3 text-emerald-500" />
                            }
                            else
                            {
                                <LucideXCn Size="12" Class="size-3 text-muted-foreground/40" />
                            }
                            <span class="@(passed ? "text-foreground" : "text-muted-foreground")">
                                @req.Label
                            </span>
                        </div>
                    }
                </div>
            </div>

            <ButtonCn Class="w-full" Size="ButtonSize.Sm"
                      Disabled="@(_passedCount < _requirements.Length || !_passwordsMatch)">
                Reset password
            </ButtonCn>
        </div>

        <div class="border-t px-4 py-3">
            <button type="button"
                    class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                Back to sign in
            </button>
        </div>
    </div>
</section>

@code {
    private string _newPassword = "";
    private string _confirmPassword = "";

    private static readonly int[] _strengthIndices = [0, 1, 2, 3, 4];

    private record Requirement(string Label, Func<string, bool> Test);

    private static readonly Requirement[] _requirements =
    [
        new("At least 8 characters", pw => pw.Length >= 8),
        new("One uppercase letter", pw => System.Text.RegularExpressions.Regex.IsMatch(pw, "[A-Z]")),
        new("One lowercase letter", pw => System.Text.RegularExpressions.Regex.IsMatch(pw, "[a-z]")),
        new("One number", pw => System.Text.RegularExpressions.Regex.IsMatch(pw, "[0-9]")),
        new("One special character", pw => System.Text.RegularExpressions.Regex.IsMatch(pw, "[^A-Za-z0-9]")),
    ];

    private int _passedCount => _requirements.Count(r => r.Test(_newPassword));
    private double _strengthPercent => (_passedCount / (double)_requirements.Length) * 100;
    private bool _passwordsMatch => _newPassword == _confirmPassword && _confirmPassword.Length > 0;
}
