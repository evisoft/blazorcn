@* ============================================================
   Block: login-oauth-consent
   Title: LoginOauthConsent
   Description: OAuth permission consent React screen block for Next.js with app identity, requested permissions list, scope explanations, and authorize or deny buttons using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-oauth-consent.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-4 text-center">
            <div class="mx-auto mb-3 flex items-center justify-center gap-3">
                <div class="flex size-10 items-center justify-center rounded-lg bg-muted/50">
                    <span class="text-sm font-semibold">D</span>
                </div>
                <div class="flex items-center gap-1 text-xs text-muted-foreground">
                    <span>&rarr;</span>
                </div>
                <div class="flex size-10 items-center justify-center rounded-lg bg-primary text-sm font-semibold text-primary-foreground">
                    A
                </div>
            </div>
            <p class="text-sm font-medium">DevTools wants to access your Acme account</p>
            <p class="mt-1 text-xs text-muted-foreground">
                devtools.example.com is requesting the following permissions
            </p>
        </div>

        <div class="px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Requested permissions</p>
            <div class="space-y-1">
                @foreach (var perm in _permissions)
                {
                    <div class="flex items-center gap-3 rounded-md px-3 py-2.5">
                        <div class="flex size-7 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="@perm.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <p class="text-xs font-medium">@perm.Label</p>
                                @if (perm.Required)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">Required</BadgeCn>
                                }
                            </div>
                            <p class="text-xs text-muted-foreground">@perm.Description</p>
                        </div>
                        <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                    </div>
                }
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="mb-3 flex items-center gap-2 rounded-md bg-muted/50 p-2">
                <LucideIconCn Name="shield" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                <p class="text-xs text-muted-foreground">
                    This app will not have access to your password. You can revoke access at any time.
                </p>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="flex-1">
                    Deny
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="flex-1">
                    Authorize
                </ButtonCn>
            </div>
        </div>

        <div class="border-t px-4 py-2 text-center">
            <p class="text-xs text-muted-foreground">Signed in as alex@("@")acme.com</p>
        </div>
    </div>
</section>

@code {
    private record Permission(string Id, string Label, string Description, string Icon, bool Required);

    private static readonly Permission[] _permissions =
    [
        new("profile", "View your profile", "Name, avatar, and account info", "user", true),
        new("email", "Access your email address", "Read your verified email", "mail", true),
        new("repos", "Read your repositories", "List and read repo contents", "book-open", false),
    ];
}
