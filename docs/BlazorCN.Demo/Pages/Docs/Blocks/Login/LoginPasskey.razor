@* ============================================================
   Block: login-passkey
   Title: Login Passkey
   Description: Passkey and biometric React authentication block for Next.js with animated fingerprint icon, use-passkey button, benefit highlights, and password fallback using shadcn/ui Button, Tailwind CSS, and framer-motion pulse animation
   Long Description: Multiple passwordless sign-in methods
   Dependencies: BadgeCn, ButtonCn, LucideFingerprintCn, SeparatorCn
   Source: original/blocks/login/login-passkey.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-4 py-8">
          <div class="flex flex-col items-center">
            <div
              class="mb-5 flex size-20 items-center justify-center rounded-2xl bg-muted/50"
            >
              <LucideFingerprintPatternCn Size="40" Class="text-muted-foreground" />
            </div>

            <h2 class="text-sm font-medium">Use your passkey</h2>
            <p class="mt-1 max-w-[260px] text-center text-xs text-muted-foreground">
              Sign in with Face ID, Touch ID, or your device PIN
            </p>

            <div class="mt-6 w-full max-w-[300px] space-y-3">
              <ButtonCn Class="h-10 w-full">Continue with passkey</ButtonCn>

              <div class="relative py-1">
                <SeparatorCn />
                <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-card px-3 text-xs text-muted-foreground">
                  or
                </span>
              </div>

              <ButtonCn Variant="ButtonVariant.Outline" Class="w-full">
                Sign in with password
              </ButtonCn>
            </div>
          </div>
        </div>

        <div class="border-t px-4 py-3">
          <div class="flex items-center justify-center gap-2">
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
              Phishing resistant
            </BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
              No passwords
            </BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
              Fast sign-in
            </BadgeCn>
          </div>
        </div>
      </div>
    </section>

