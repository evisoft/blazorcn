@* ============================================================
   Block: login-security-badges
   Title: Login Security Badges
   Description: Secure React login form block for Next.js with email password fields and compliance trust badges showing encryption SOC 2 GDPR and uptime indicators with sequential fade-in animations using shadcn/ui Badge, Input, Button, Tailwind CSS, and framer-motion
   Long Description: Biometric passkey authentication
   Dependencies: BadgeCn, ButtonCn, InputCn, LabelCn, LucideShieldCheckCn
   Source: original/blocks/login/login-security-badges.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Sign in</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Enter your credentials to continue</p>
        </div>

        <div class="px-4 py-4">
            <div class="space-y-4">
                <div class="space-y-2">
                    <LabelCn For="sb-email" Class="text-xs">Email address</LabelCn>
                    <InputCn id="sb-email" Type="email" Placeholder="@("you@@example.com")" />
                </div>
                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <LabelCn For="sb-password" Class="text-xs">Password</LabelCn>
                        <button type="button"
                                class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                            Forgot password?
                        </button>
                    </div>
                    <InputCn id="sb-password" Type="password" Placeholder="********" />
                </div>
                <ButtonCn Class="w-full">Sign in</ButtonCn>
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex flex-wrap justify-center gap-2">
                @foreach (var badge in _badges)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 text-xs font-normal">
                        <LucideShieldCheckCn Size="12" Class="size-3" />
                        @badge
                    </BadgeCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string[] _badges = ["256-bit SSL", "SOC 2", "GDPR", "99.9% uptime"];
}
