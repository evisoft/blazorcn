@* ============================================================
   Block: login-card-centered
   Title: Login Card Centered
   Description: Centered React login card block for Next.js with app logo, social authentication buttons for Google and GitHub, or-divider, email and password form, and scale-in animation using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Clean minimal email and password form
   Dependencies: ButtonCn, InputCn, LabelCn, LucideGithubCn, SeparatorCn
   Source: original/blocks/login/login-card-centered.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="mx-auto max-w-sm overflow-hidden rounded-2xl bg-card shadow-lg shadow-black/5">
        <div class="px-6 pt-8 pb-2 text-center">
            <div class="mx-auto mb-3 flex size-10 items-center justify-center rounded-xl bg-primary text-base font-semibold text-primary-foreground">
                A
            </div>
            <h2 class="text-base font-semibold">Sign in to Acme</h2>
            <p class="mt-1 text-xs text-muted-foreground">Welcome back. Pick a method below.</p>
        </div>

        <div class="space-y-3 px-6 py-5">
            <ButtonCn Variant="ButtonVariant.Outline" Class="h-9 w-full gap-2.5 text-sm">
                <svg class="size-4" viewBox="0 0 24 24" aria-label="Google logo">
                    <title>Google</title>
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4" />
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                </svg>
                Continue with Google
            </ButtonCn>

            <ButtonCn Variant="ButtonVariant.Outline" Class="h-9 w-full gap-2.5 text-sm">
                <LucideGithubCn Size="16" Class="size-4" />
                Continue with GitHub
            </ButtonCn>

            <div class="relative py-1">
                <SeparatorCn />
                <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 bg-card px-3 text-xs text-muted-foreground">
                    or
                </span>
            </div>

            <div class="space-y-1.5">
                <LabelCn For="login-card-c-email" Class="text-xs font-medium text-muted-foreground">
                    Email
                </LabelCn>
                <InputCn id="login-card-c-email" Type="email" Placeholder="@("you@@example.com")"
                         @bind-Value="_email" />
            </div>

            <div class="space-y-1.5">
                <LabelCn For="login-card-c-password" Class="text-xs font-medium text-muted-foreground">
                    Password
                </LabelCn>
                <InputCn id="login-card-c-password" Type="password" Placeholder="Enter your password"
                         @bind-Value="_password" />
            </div>

            <ButtonCn Class="h-9 w-full">Sign in</ButtonCn>

            <p class="text-center text-xs text-muted-foreground">
                New here?
                <span class="cursor-pointer font-medium text-foreground hover:underline">
                    Create an account
                </span>
            </p>
        </div>
    </div>
</section>

@code {
    private string _email = "";
    private string _password = "";
}
