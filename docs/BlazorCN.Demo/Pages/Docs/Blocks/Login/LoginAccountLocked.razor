@* ============================================================
   Block: login-account-locked
   Title: Login Account Locked
   Description: Account locked React security screen for Next.js with animated lock icon, cooldown timer display, account email identification, contact support button, and staggered fade-in sections using shadcn/ui Button, Tailwind CSS, and framer-motion spring animation
   Long Description: Session timeout re-authentication
   Dependencies: ButtonCn, LucideClockCn, LucideLockCn, LucideMailCn
   Source: original/blocks/login/login-account-locked.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
      <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col items-center px-4 py-8">
          <div
            class="flex size-12 items-center justify-center rounded-full bg-red-500/10"
          >
            <LucideLockCn Size="20" Class="text-red-600 dark:text-red-400" />
          </div>

          <div
            class="mt-4 text-center"
          >
            <h2 class="text-sm font-medium">Account locked</h2>
            <p class="mt-1 text-xs text-muted-foreground">Too many failed sign-in attempts</p>
          </div>

          <div
            class="mt-4 w-full max-w-xs space-y-2 rounded-md bg-muted/50 p-3"
          >
            <div class="flex items-center gap-2.5">
              <LucideMailCn Size="12" Class=".5 text-muted-foreground" />
              <span class="text-xs text-muted-foreground">alex@@acme.com</span>
            </div>
            <div class="flex items-center gap-2.5">
              <LucideClockCn Size="12" Class=".5 text-muted-foreground" />
              <span class="text-xs text-muted-foreground">Try again in 14 minutes</span>
            </div>
          </div>

          <div
            class="mt-6 flex w-full max-w-xs flex-col gap-2"
          >
            <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 w-full text-xs">
              Reset password
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Class="h-8 w-full text-xs text-muted-foreground">
              Contact support
            </ButtonCn>
          </div>
        </div>
      </div>
    </section>

