@* ============================================================
   Block: login-testimonial-sidebar
   Title: Login Testimonial Sidebar
   Description: Split-panel React login block for Next.js with sign-in form and social buttons on left, customer testimonial quote with avatar, name, role, and company on right using shadcn/ui Avatar, Input, Separator, Tailwind CSS, and framer-motion
   Long Description: React Login Terms Consent Block
   Dependencies: AvatarCn, AvatarFallbackCn, ButtonCn, InputCn, LabelCn, LucideGithubCn, LucideStarCn, SeparatorCn
   Source: original/blocks/login/login-testimonial-sidebar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid md:grid-cols-2">
            <div class="px-6 py-8">
                <div class="mb-6">
                    <p class="text-sm font-medium">Sign in to your account</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Enter your credentials to continue
                    </p>
                </div>

                <div class="space-y-4">
                    <div class="space-y-2">
                        <LabelCn For="test-email" Class="text-xs font-medium text-muted-foreground">
                            Email address
                        </LabelCn>
                        <InputCn id="test-email" Type="email" Placeholder="@("you@@company.com")" />
                    </div>

                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <LabelCn For="test-password" Class="text-xs font-medium text-muted-foreground">
                                Password
                            </LabelCn>
                            <button type="button"
                                    class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                                Forgot password?
                            </button>
                        </div>
                        <InputCn id="test-password" Type="password" Placeholder="Enter your password" />
                    </div>

                    <ButtonCn Class="w-full" Size="ButtonSize.Sm">Sign in</ButtonCn>

                    <div class="flex items-center gap-3">
                        <SeparatorCn Class="flex-1" />
                        <span class="text-xs text-muted-foreground">or</span>
                        <SeparatorCn Class="flex-1" />
                    </div>

                    <div class="flex gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-2" Size="ButtonSize.Sm">
                            <svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true">
                                <title>Google logo</title>
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4" />
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                            </svg>
                            Google
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-2" Size="ButtonSize.Sm">
                            <LucideGithubCn Size="14" Class="size-3.5" />
                            GitHub
                        </ButtonCn>
                    </div>
                </div>
            </div>

            <div class="flex flex-col justify-center border-l bg-muted/30 p-8 lg:p-10">
                <blockquote class="text-base leading-relaxed">
                    &ldquo;Acme transformed how our team collaborates. We shipped 3x faster in the first month.&rdquo;
                </blockquote>

                <div class="mt-6 flex items-center gap-3">
                    <AvatarCn Class="size-9">
                        <AvatarFallbackCn Class="text-xs">SC</AvatarFallbackCn>
                    </AvatarCn>
                    <div>
                        <p class="text-sm font-medium">Sarah Chen</p>
                        <p class="text-xs text-muted-foreground">VP Engineering, Vercel</p>
                    </div>
                </div>

                <div class="mt-4 flex items-center gap-0.5">
                    @for (var i = 0; i < 5; i++)
                    {
                        <LucideStarCn Size="14" Class="size-3.5 fill-amber-400 text-amber-400" />
                    }
                </div>
            </div>
        </div>
    </div>
</section>

