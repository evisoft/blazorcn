@* ============================================================
   Block: login-stats-sidebar
   Title: Login Stats Sidebar
   Description: Split-panel React login block for Next.js with sign-in form on left and company statistics grid showing users, uptime, countries, and ratings with staggered counter animations using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Customer testimonial quote panel
   Dependencies: ButtonCn, InputCn, LabelCn, LucideGithubCn, SeparatorCn
   Source: original/blocks/login/login-stats-sidebar.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid md:grid-cols-2">
            <div class="px-6 py-8">
                <div class="mb-6">
                    <p class="text-sm font-medium">Welcome back</p>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        Sign in to access your dashboard
                    </p>
                </div>

                <div class="space-y-4">
                    <div class="space-y-2">
                        <LabelCn For="stats-sb-email" Class="text-xs font-medium text-muted-foreground">
                            Email address
                        </LabelCn>
                        <InputCn id="stats-sb-email" Type="email" Placeholder="@("you@@company.com")" />
                    </div>

                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <LabelCn For="stats-sb-password" Class="text-xs font-medium text-muted-foreground">
                                Password
                            </LabelCn>
                            <button type="button"
                                    class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                                Forgot password?
                            </button>
                        </div>
                        <InputCn id="stats-sb-password" Type="password" Placeholder="Enter your password" />
                    </div>

                    <ButtonCn Class="w-full" Size="ButtonSize.Sm">Sign in</ButtonCn>

                    <div class="flex items-center gap-3">
                        <SeparatorCn Class="flex-1" />
                        <span class="text-xs text-muted-foreground">or</span>
                        <SeparatorCn Class="flex-1" />
                    </div>

                    <div class="flex gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-2" Size="ButtonSize.Sm">
                            <svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true">
                                <title>Google logo</title>
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4" />
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                            </svg>
                            Google
                        </ButtonCn>
                        <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-2" Size="ButtonSize.Sm">
                            <LucideGithubCn Size="14" Class="size-3.5" />
                            GitHub
                        </ButtonCn>
                    </div>
                </div>
            </div>

            <div class="flex flex-col justify-center border-l bg-muted/30 p-8">
                <p class="text-xs font-medium uppercase tracking-wider text-muted-foreground">
                    Trusted by thousands
                </p>

                <div class="mt-6 grid grid-cols-2 gap-6">
                    @foreach (var stat in _stats)
                    {
                        <div>
                            <p class="text-2xl font-semibold tabular-nums">@stat.Value</p>
                            <p class="mt-0.5 text-xs text-muted-foreground">@stat.Label</p>
                        </div>
                    }
                </div>

                <div class="mt-8">
                    <p class="text-xs text-muted-foreground/60">Stripe &middot; Vercel &middot; Linear &middot; Notion &middot; Figma</p>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Stat(string Value, string Label);

    private static readonly Stat[] _stats =
    [
        new("50K+", "Active users"),
        new("99.9%", "Uptime SLA"),
        new("150+", "Countries"),
        new("4.9/5", "User rating"),
    ];
}
