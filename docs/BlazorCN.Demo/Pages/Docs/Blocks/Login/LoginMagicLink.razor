@* ============================================================
   Block: login-magic-link
   Title: Login Magic Link
   Description: Passwordless React magic link sign-in block for Next.js with email input, send button, animated inbox confirmation state with envelope icon, and crossfade transitions using shadcn/ui, Tailwind CSS, and framer-motion AnimatePresence
   Long Description: Multiple passwordless authentication methods
   Dependencies: ButtonCn, InputCn, LucideCheckCn, LucideMailCn
   Source: original/blocks/login/login-magic-link.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="px-4 py-6">
            @if (!_sent)
            {
                <div class="flex flex-col items-center">
                    <LucideMailCn Size="32" Class="mb-3 size-8 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Sign in with email</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        We'll send you a magic link
                    </p>

                    <div class="mt-5 w-full max-w-[300px] space-y-3">
                        <InputCn Type="email" Placeholder="@("you@@example.com")" @bind-Value="_email" />
                        <ButtonCn Class="w-full" Size="ButtonSize.Sm" OnClick="@(() => _sent = true)">
                            Send magic link
                        </ButtonCn>
                    </div>

                    <button type="button"
                            class="mt-4 text-xs text-muted-foreground hover:text-foreground">
                        Use password instead
                    </button>
                </div>
            }
            else
            {
                <div class="flex flex-col items-center py-2">
                    <div class="relative mb-4">
                        <LucideMailCn Size="32" Class="size-8 text-muted-foreground" />
                        <div class="absolute -right-1 -bottom-1 flex size-4 items-center justify-center rounded-full bg-emerald-500">
                            <LucideCheckCn Size="10" Class="size-2.5 text-white" />
                        </div>
                    </div>

                    <h2 class="text-sm font-medium">Check your inbox</h2>
                    <p class="mt-1 text-xs text-muted-foreground">
                        We sent a link to
                        <span class="font-medium text-foreground">@(string.IsNullOrEmpty(_email) ? "alex@@acme.com" : _email)</span>
                    </p>

                    <div class="mt-4 flex items-center gap-1">
                        <span class="size-1.5 animate-pulse rounded-full bg-muted-foreground"></span>
                        <span class="size-1.5 animate-pulse rounded-full bg-muted-foreground" style="animation-delay: 0.2s"></span>
                        <span class="size-1.5 animate-pulse rounded-full bg-muted-foreground" style="animation-delay: 0.4s"></span>
                    </div>

                    <div class="mt-5 flex flex-col items-center gap-2">
                        <button type="button"
                                class="text-xs font-medium text-foreground hover:underline">
                            Resend email
                        </button>
                        <button type="button"
                                @onclick="@(() => _sent = false)"
                                class="text-xs text-muted-foreground hover:text-foreground">
                            Use a different email
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string _email = "";
    private bool _sent;
}
