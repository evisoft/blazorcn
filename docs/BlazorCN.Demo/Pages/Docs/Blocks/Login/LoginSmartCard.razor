@* ============================================================
   Block: login-smart-card
   Title: LoginSmartCard
   Description: Smart card reader React authentication block for Next.js with card reader status indicator, insert card prompt, certificate extraction display, and PIN entry form using shadcn/ui, Tailwind CSS, and Lucide icons
   Source: original/blocks/login/login-smart-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-4 py-3">
      <p class="text-sm font-medium">Smart Card Authentication</p>
      <p class="mt-0.5 text-xs text-muted-foreground">
        Insert your PIV or CAC card to sign in
      </p>
    </div>

    <div class="px-4 py-4">
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-2">
          <span class="@Cn.Merge("size-1.5 rounded-full", _status == "no-reader" ? "bg-red-500" : _status == "authenticated" ? "bg-emerald-500" : "bg-amber-500")"></span>
          <span class="text-xs text-muted-foreground">
            @if (_status == "no-reader") { <text>No reader detected</text> }
            @if (_status == "waiting") { <text>Reader connected, insert card</text> }
            @if (_status == "reading") { <text>Reading card...</text> }
            @if (_status == "pin-entry") { <text>Card recognized</text> }
            @if (_status == "authenticated") { <text>Authenticated</text> }
          </span>
        </div>
      </div>
    </div>

    <SeparatorCn />

    @if (_status == "no-reader")
    {
      <div class="flex flex-col items-center px-4 py-8">
        <div class="mb-4 flex size-14 items-center justify-center rounded-full bg-muted/50">
          <LucideIconCn Name="usb" Size="24" Class="size-6 text-muted-foreground" />
        </div>
        <p class="text-sm font-medium">Connect your card reader</p>
        <p class="mt-1 max-w-[280px] text-center text-xs text-muted-foreground">
          Plug in a USB smart card reader to get started
        </p>
        <ButtonCn Size="ButtonSize.Sm" Class="mt-4 gap-1.5" @onclick="HandleDetectReader">
          <LucideIconCn Name="monitor" Size="14" Class="size-3.5" />
          Detect reader
        </ButtonCn>
      </div>
    }

    @if (_status == "waiting")
    {
      <div class="flex flex-col items-center px-4 py-8">
        <div class="mb-4 flex size-14 items-center justify-center rounded-full bg-amber-500/10">
          <LucideIconCn Name="credit-card" Size="24" Class="size-6 text-amber-600" />
        </div>
        <p class="text-sm font-medium">Insert your smart card</p>
        <p class="mt-1 max-w-[280px] text-center text-xs text-muted-foreground">
          Place your PIV or CAC card into the reader
        </p>
        <ButtonCn Size="ButtonSize.Sm" Class="mt-4 gap-1.5" @onclick="HandleInsertCard">
          <LucideIconCn Name="credit-card" Size="14" Class="size-3.5" />
          Simulate card insert
        </ButtonCn>
      </div>
    }

    @if (_status == "reading")
    {
      <div class="flex flex-col items-center px-4 py-8">
        <div class="mb-4 flex size-14 items-center justify-center rounded-full bg-blue-500/10">
          <LucideIconCn Name="shield-check" Size="24" Class="size-6 text-blue-600" />
        </div>
        <p class="text-sm font-medium">Reading certificate...</p>
        <p class="mt-1 text-xs text-muted-foreground">Extracting identity from card</p>
      </div>
    }

    @if (_status == "pin-entry")
    {
      <div class="px-4 py-4">
        <div class="mb-4 rounded-md bg-muted/50 p-3">
          <p class="text-xs font-medium text-muted-foreground">Certificate detected</p>
          <div class="mt-2 space-y-1">
            <div class="flex justify-between text-xs">
              <span class="text-muted-foreground">Subject</span>
              <span class="font-mono">CN=Alex Johnson, O=Acme Corp</span>
            </div>
            <div class="flex justify-between text-xs">
              <span class="text-muted-foreground">Issuer</span>
              <span class="font-mono">Acme Root CA</span>
            </div>
            <div class="flex justify-between text-xs">
              <span class="text-muted-foreground">Serial</span>
              <span class="font-mono">4A:3B:2C:1D</span>
            </div>
          </div>
        </div>

        <div class="space-y-1.5">
          <LabelCn For="smart-card-pin" Class="text-xs font-medium text-muted-foreground">
            Card PIN
          </LabelCn>
          <InputCn id="smart-card-pin" type="password" Placeholder="Enter your card PIN" @bind-Value="_pin" maxlength="8" />
          <p class="text-xs text-muted-foreground">
            3 attempts remaining before card lockout
          </p>
        </div>

        <ButtonCn Class="mt-3 w-full gap-1.5" Size="ButtonSize.Sm" @onclick="HandleSubmitPin" Disabled="@(_pin.Length < 4)">
          <LucideIconCn Name="lock" Size="14" Class="size-3.5" />
          Verify PIN
        </ButtonCn>
      </div>
    }

    @if (_status == "authenticated")
    {
      <div class="flex flex-col items-center px-4 py-8">
        <div class="mb-4 flex size-14 items-center justify-center rounded-full bg-emerald-500/10">
          <LucideIconCn Name="check-circle-2" Size="24" Class="size-6 text-emerald-600" />
        </div>
        <p class="text-sm font-medium">Identity verified</p>
        <p class="mt-1 text-xs text-muted-foreground">
          Signed in as Alex Johnson (Acme Corp)
        </p>
      </div>
    }

    <div class="border-t px-4 py-3">
      <div class="flex items-center justify-between text-xs text-muted-foreground">
        <span>Supported: PIV, CAC, FIPS 201</span>
        <span class="flex items-center gap-1">
          <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
          FIPS 140-2 compliant
        </span>
      </div>
    </div>
  </div>
</section>

@code {
    private string _status = "no-reader";
    private string _pin = "";

    private void HandleDetectReader()
    {
        _status = "waiting";
    }

    private async Task HandleInsertCard()
    {
        _status = "reading";
        await Task.Delay(1500);
        _status = "pin-entry";
    }

    private void HandleSubmitPin()
    {
        if (_pin.Length >= 4)
        {
            _status = "authenticated";
        }
    }
}
