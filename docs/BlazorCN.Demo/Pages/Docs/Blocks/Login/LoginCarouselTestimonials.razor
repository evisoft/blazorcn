@* ============================================================
   Block: login-carousel-testimonials
   Title: Login Carousel Testimonials
   Description: Split-panel login block with sign-in form on left and customer testimonial carousel with avatars, quotes, and dot indicators on right
   Long Description: React Login Card Centered Block
   Dependencies: AvatarCn, AvatarFallbackCn, ButtonCn, InputCn, LabelCn, SeparatorCn
   Source: original/blocks/login/login-carousel-testimonials.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="grid md:grid-cols-2">
            <div class="px-6 py-8">
                <div>
                    <div class="mb-6">
                        <h2 class="text-sm font-medium">Sign in</h2>
                        <p class="mt-1 text-xs text-muted-foreground">
                            Welcome back. Enter your credentials.
                        </p>
                    </div>

                    <div class="space-y-4">
                        <div class="space-y-2">
                            <LabelCn for="ct-email" Class="text-xs text-muted-foreground">
                                Email
                            </LabelCn>
                            <InputCn
                                id="ct-email"
                                type="email"
                                Placeholder="@("you@company.com")"
                                Class="h-8 text-sm" />
                        </div>

                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <LabelCn for="ct-password" Class="text-xs text-muted-foreground">
                                    Password
                                </LabelCn>
                                <button
                                    type="button"
                                    class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                                    Forgot password?
                                </button>
                            </div>
                            <InputCn
                                id="ct-password"
                                type="password"
                                Placeholder="Enter your password"
                                Class="h-8 text-sm" />
                        </div>

                        <ButtonCn Class="h-8 w-full text-xs">Sign in</ButtonCn>

                        <div class="flex items-center gap-3">
                            <SeparatorCn Class="flex-1" />
                            <span class="text-xs text-muted-foreground">or</span>
                            <SeparatorCn Class="flex-1" />
                        </div>

                        <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 w-full text-xs">
                            Continue with SSO
                        </ButtonCn>
                    </div>
                </div>
            </div>

            <div class="flex min-h-[380px] flex-col justify-between border-l bg-muted/30 p-8">
                <div class="relative min-h-[180px]">
                    <div>
                        <blockquote class="mb-6 text-sm leading-relaxed text-muted-foreground">
                            @($"\u201C{_current.Quote}\u201D")
                        </blockquote>
                        <div class="flex items-center gap-3">
                            <AvatarCn>
                                <AvatarFallbackCn Class="text-xs">@_current.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div>
                                <p class="text-sm font-medium">@_current.Name</p>
                                <p class="text-xs text-muted-foreground">@_current.Role</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex items-center gap-1.5">
                    @for (var i = 0; i < _testimonials.Length; i++)
                    {
                        var index = i;
                        <button
                            type="button"
                            @onclick="() => _active = index"
                            class="@($"h-1.5 rounded-full transition-all duration-300 {(index == _active ? "w-4 bg-foreground" : "w-1.5 bg-muted-foreground/30")}")">
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private int _active;

    private Testimonial _current => _testimonials[_active];

    private record Testimonial(string Id, string Quote, string Name, string Role, string Initials);

    private static readonly Testimonial[] _testimonials =
    [
        new("t1", "Switching to this platform cut our onboarding time in half. The developer experience is outstanding and the documentation is first-class.", "Sarah Chen", "CTO at Vercel", "SC"),
        new("t2", "We ship 3x faster now. The component library and tooling are exactly what our engineering team needed to move quickly.", "Marcus Rivera", "Engineering Lead at Linear", "MR"),
        new("t3", "Best investment we made this year. Our frontend team went from struggling with consistency to thriving in weeks.", "Emily Nakamura", "VP of Engineering at Stripe", "EN"),
    ];
}
