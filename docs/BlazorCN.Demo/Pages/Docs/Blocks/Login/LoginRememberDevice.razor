@* ============================================================
   Block: login-remember-device
   Title: LoginRememberDevice
   Description: Remember this device checkbox React login block for Next.js with email and password form, device trust checkbox with tooltip explanation, trust duration selector, and security note using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-remember-device.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Sign in</p>
            <p class="mt-0.5 text-xs text-muted-foreground">Enter your credentials to continue</p>
        </div>

        <div class="space-y-3 px-4 py-4">
            <div class="space-y-1.5">
                <LabelCn For="remember-email" Class="text-xs font-medium text-muted-foreground">
                    Email
                </LabelCn>
                <InputCn id="remember-email" Type="email" Placeholder="@("you@example.com")" />
            </div>

            <div class="space-y-1.5">
                <LabelCn For="remember-pw" Class="text-xs font-medium text-muted-foreground">
                    Password
                </LabelCn>
                <InputCn id="remember-pw" Type="password" Placeholder="Enter password" />
            </div>

            <div class="rounded-md bg-muted/50 p-3">
                <div class="flex items-start gap-2">
                    <CheckboxCn Checked="@_remember"
                                CheckedChanged="@((bool v) => _remember = v)"
                                Class="mt-0.5" />
                    <div class="flex-1">
                        <div class="flex items-center gap-1.5">
                            <label for="remember-device" class="cursor-pointer text-xs font-medium">
                                Remember this device
                            </label>
                            <button type="button"
                                    @onclick="@(() => _showInfo = !_showInfo)"
                                    class="text-muted-foreground hover:text-foreground">
                                <LucideIconCn Name="info" Size="12" Class="size-3" />
                            </button>
                        </div>
                        <p class="mt-0.5 text-xs text-muted-foreground">
                            Skip verification on future sign-ins
                        </p>
                    </div>
                    <LucideIconCn Name="monitor" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                </div>

                @if (_showInfo)
                {
                    <p class="mt-2 rounded-md bg-background p-2 text-xs text-muted-foreground">
                        A secure token will be stored on this device. You won't need to enter a
                        verification code for future sign-ins. Don't use this on shared or public
                        computers.
                    </p>
                }

                @if (_remember)
                {
                    <div class="mt-2 flex gap-1.5">
                        @foreach (var d in _trustDurations)
                        {
                            var dur = d;
                            <button type="button"
                                    @onclick="@(() => _duration = dur.Id)"
                                    class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _duration == dur.Id ? "bg-foreground text-background" : "bg-background text-muted-foreground hover:text-foreground")">
                                @dur.Label
                            </button>
                        }
                    </div>
                }
            </div>

            <ButtonCn Class="w-full" Size="ButtonSize.Sm">
                Sign in
            </ButtonCn>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <LucideIconCn Name="shield" Size="12" Class="size-3" />
                <span>Your connection is encrypted and secure</span>
            </div>
        </div>
    </div>
</section>

@code {
    private string _email = "";
    private string _password = "";
    private bool _remember;
    private string _duration = "30d";
    private bool _showInfo;

    private record TrustDuration(string Id, string Label);

    private static readonly TrustDuration[] _trustDurations =
    [
        new("7d", "7 days"),
        new("30d", "30 days"),
        new("90d", "90 days"),
    ];
}
