@* ============================================================
   Block: login-identity-provider
   Title: LoginIdentityProvider
   Description: Identity provider chooser React block for Next.js with categorized provider list, search filter, provider icons, and direct connect buttons using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-identity-provider.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Choose Provider</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Select an identity provider to continue
            </p>
        </div>

        <div class="border-b px-4 py-3">
            <div class="relative">
                <LucideIconCn Name="search" Size="14" Class="absolute top-1/2 left-3 size-3.5 -translate-y-1/2 text-muted-foreground" />
                <InputCn Placeholder="Search providers..." @bind-Value="_search" Class="border-0 bg-transparent pl-9 shadow-none focus-visible:ring-0" />
            </div>
        </div>

        <div>
            @foreach (var grp in Grouped)
            {
                var group = grp;
                <div>
                    <div class="flex items-center gap-2 px-4 py-2">
                        <LucideIconCn Name="@group.CategoryIcon" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="text-xs font-medium text-muted-foreground">@group.CategoryLabel</span>
                    </div>
                    @foreach (var prov in group.Items)
                    {
                        var provider = prov;
                        <div class="flex cursor-pointer items-center gap-3 border-b px-4 py-2.5 transition-colors last:border-b-0 hover:bg-muted/50">
                            <div class="flex size-7 items-center justify-center rounded-md bg-muted/50">
                                <LucideIconCn Name="shield" Size="14" Class="size-3.5 text-muted-foreground" />
                            </div>
                            <span class="flex-1 text-sm">@provider.Name</span>
                            <div class="flex items-center gap-2">
                                @if (provider.Connected)
                                {
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                }
                                <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5 text-muted-foreground" />
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="border-t px-4 py-3">
            <button type="button" class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                Sign in with email and password instead
            </button>
        </div>
    </div>
</section>

@code {
    private string _search = "";

    private record IdentityProvider(string Id, string Name, string Category, bool Connected);

    private static readonly IdentityProvider[] _allProviders =
    [
        new("ip1", "Okta",             "enterprise", true),
        new("ip2", "Azure AD",         "enterprise", true),
        new("ip3", "Google Workspace", "enterprise", false),
        new("ip4", "OneLogin",         "enterprise", false),
        new("ip5", "GitHub",           "social",     true),
        new("ip6", "GitLab",           "social",     false),
        new("ip7", "Custom SAML",      "custom",     false),
    ];

    private record GroupedCategory(string CategoryLabel, string CategoryIcon, IdentityProvider[] Items);

    private GroupedCategory[] Grouped =>
        new[] { "enterprise", "social", "custom" }
            .Select(cat => new GroupedCategory(
                cat switch { "enterprise" => "Enterprise", "social" => "Social", _ => "Custom" },
                cat switch { "enterprise" => "building", "social" => "globe", _ => "shield" },
                _allProviders
                    .Where(p => p.Category == cat &&
                                p.Name.ToLowerInvariant().Contains(_search.ToLowerInvariant()))
                    .ToArray()
            ))
            .Where(g => g.Items.Length > 0)
            .ToArray();
}
