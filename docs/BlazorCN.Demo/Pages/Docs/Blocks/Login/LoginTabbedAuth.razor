@* ============================================================
   Block: login-tabbed-auth
   Title: Login Tabbed Auth
   Description: Tabbed React authentication block for Next.js switching between sign-in and account creation forms with animated tab transitions using shadcn/ui Tabs, Input, Button, Tailwind CSS, and framer-motion
   Long Description: Standalone registration with password strength
   Dependencies: ButtonCn, InputCn, LabelCn, LucideGithubCn, SeparatorCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/login/login-tabbed-auth.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col items-center border-b px-4 py-5">
            <div class="mb-2 flex size-8 items-center justify-center rounded-md bg-foreground">
                <span class="text-xs font-semibold text-background">A</span>
            </div>
            <p class="text-sm font-medium">Welcome</p>
        </div>

        <div class="px-4 py-4">
            <TabsCn DefaultValue="signin">
                <TabsListCn Class="w-full rounded-lg bg-muted p-1">
                    <TabsTriggerCn Value="signin" Class="flex-1">Sign in</TabsTriggerCn>
                    <TabsTriggerCn Value="create" Class="flex-1">Create account</TabsTriggerCn>
                </TabsListCn>

                <TabsContentCn Value="signin">
                    <div class="mt-4 space-y-4">
                        <div class="space-y-2">
                            <LabelCn For="tab-signin-email" Class="text-xs font-medium text-muted-foreground">
                                Email address
                            </LabelCn>
                            <InputCn id="tab-signin-email" Type="email" Placeholder="@("you@@company.com")" />
                        </div>
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <LabelCn For="tab-signin-password" Class="text-xs font-medium text-muted-foreground">
                                    Password
                                </LabelCn>
                                <button type="button"
                                        class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                                    Forgot password?
                                </button>
                            </div>
                            <InputCn id="tab-signin-password" Type="password" Placeholder="Enter your password" />
                        </div>
                        <ButtonCn Class="w-full" Size="ButtonSize.Sm">Sign in</ButtonCn>

                        <div class="flex items-center gap-3">
                            <SeparatorCn Class="flex-1" />
                            <span class="text-xs text-muted-foreground">or</span>
                            <SeparatorCn Class="flex-1" />
                        </div>

                        <div class="flex gap-2">
                            <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-2" Size="ButtonSize.Sm">
                                <svg viewBox="0 0 24 24" class="size-3.5" aria-hidden="true">
                                    <title>Google logo</title>
                                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4" />
                                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853" />
                                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05" />
                                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335" />
                                </svg>
                                Google
                            </ButtonCn>
                            <ButtonCn Variant="ButtonVariant.Outline" Class="flex-1 gap-2" Size="ButtonSize.Sm">
                                <LucideGithubCn Size="14" Class="size-3.5" />
                                GitHub
                            </ButtonCn>
                        </div>
                    </div>
                </TabsContentCn>

                <TabsContentCn Value="create">
                    <div class="mt-4 space-y-4">
                        <div class="space-y-2">
                            <LabelCn For="tab-create-name" Class="text-xs font-medium text-muted-foreground">
                                Full name
                            </LabelCn>
                            <InputCn id="tab-create-name" Type="text" Placeholder="Jane Smith" />
                        </div>
                        <div class="space-y-2">
                            <LabelCn For="tab-create-email" Class="text-xs font-medium text-muted-foreground">
                                Email address
                            </LabelCn>
                            <InputCn id="tab-create-email" Type="email" Placeholder="@("you@@company.com")" />
                        </div>
                        <div class="space-y-2">
                            <LabelCn For="tab-create-password" Class="text-xs font-medium text-muted-foreground">
                                Password
                            </LabelCn>
                            <InputCn id="tab-create-password" Type="password" Placeholder="At least 8 characters"
                                     @bind-Value="_password" />
                            <div class="flex gap-1">
                                @{
                                    int[] mins = [1, 4, 8, 12];
                                    string[] colors = ["bg-red-500", "bg-amber-500", "bg-yellow-500", "bg-emerald-500"];
                                }
                                @for (var i = 0; i < 4; i++)
                                {
                                    <div class="@Cn.Merge("h-1 flex-1 rounded-full transition-colors", _password.Length >= mins[i] ? colors[i] : "bg-muted")" />
                                }
                            </div>
                            <p class="text-xs text-muted-foreground">
                                @(PasswordStrengthLabel)
                            </p>
                        </div>
                        <ButtonCn Class="w-full" Size="ButtonSize.Sm">Create account</ButtonCn>
                    </div>
                </TabsContentCn>
            </TabsCn>
        </div>
    </div>
</section>

@code {
    private string _password = "";

    private string PasswordStrengthLabel => _password.Length == 0
        ? "Choose a strong password"
        : _password.Length < 4
            ? "Too weak"
            : _password.Length < 8
                ? "Could be stronger"
                : _password.Length < 12
                    ? "Good"
                    : "Strong";
}
