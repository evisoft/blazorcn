@* ============================================================
   Block: login-trust-score
   Title: LoginTrustScore
   Description: Trust score indicator React login block for Next.js with risk assessment display, trust factors breakdown, score calculation, adaptive authentication based on risk level, and additional verification prompt using shadcn/ui, Tailwind CSS, and Lucide icons
   Source: original/blocks/login/login-trust-score.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <p class="text-sm font-medium">Trust Score Assessment</p>
            <p class="mt-0.5 text-xs text-muted-foreground">
                Evaluating login risk for alex@@acme.com
            </p>
        </div>

        <div class="px-4 py-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="text-2xl font-semibold tabular-nums">@_scorePercent</p>
                    <p class="text-xs text-muted-foreground">out of 100</p>
                </div>
                <div class="flex items-center gap-2">
                    <span class="@($"size-1.5 rounded-full {_config.Dot}")" />
                    <span class="@($"text-xs font-medium {_config.Color}")">@_config.Label</span>
                </div>
            </div>

            <div class="mt-3 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div
                    class="@($"h-full rounded-full {_config.Bg} transition-all")"
                    style="@($"width:{_scorePercent}%")" />
            </div>
        </div>

        <hr class="border-border" />

        <div class="px-4 py-3">
            <p class="mb-2 text-xs font-medium text-muted-foreground">Trust factors</p>
            <div class="space-y-2">
                @foreach (var factor in _trustFactors)
                {
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="@factor.IconName" Size="14" Class="size-3.5 text-muted-foreground" />
                            <div>
                                <p class="text-xs font-medium">@factor.Label</p>
                                <p class="text-xs text-muted-foreground">@factor.Description</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-xs text-muted-foreground">@factor.Score/@factor.MaxScore</span>
                            <span class="@($"size-1.5 rounded-full {(factor.Status == "pass" ? "bg-emerald-500" : factor.Status == "warn" ? "bg-amber-500" : "bg-red-500")}")" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <hr class="border-border" />

        @if (!_verifying)
        {
            <div class="px-4 py-3">
                @if (_riskLevel == "low")
                {
                    <div class="flex items-center gap-3">
                        <div class="flex size-8 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-600" />
                        </div>
                        <div class="flex-1">
                            <p class="text-xs font-medium">No additional verification needed</p>
                            <p class="text-xs text-muted-foreground">Your trust score is high enough</p>
                        </div>
                        <ButtonCn Size="ButtonSize.Sm" Class="text-xs">Continue</ButtonCn>
                    </div>
                }
                else
                {
                    <div class="flex items-center gap-3">
                        <div class="flex size-8 items-center justify-center rounded-full bg-amber-500/10">
                            <LucideIconCn Name="triangle-alert" Size="16" Class="size-4 text-amber-600" />
                        </div>
                        <div class="flex-1">
                            <p class="text-xs font-medium">Additional verification required</p>
                            <p class="text-xs text-muted-foreground">Some risk factors need validation</p>
                        </div>
                        <ButtonCn Size="ButtonSize.Sm" Class="text-xs" OnClick="@(() => _verifying = true)">Verify</ButtonCn>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="px-4 py-3">
                <div class="space-y-3">
                    <div class="space-y-1.5">
                        <LabelCn For="trust-code" Class="text-xs font-medium text-muted-foreground">Verification code</LabelCn>
                        <InputCn Id="trust-code" Type="text" Placeholder="Enter 6-digit code" Class="font-mono tracking-widest" @bind-Value="_code" />
                        <p class="text-xs text-muted-foreground">A code was sent to your authenticator app</p>
                    </div>
                    <ButtonCn Class="w-full" Size="ButtonSize.Sm" Disabled="@(_code.Length < 6)">Verify and continue</ButtonCn>
                </div>
            </div>
        }

        <div class="border-t px-4 py-3">
            <p class="text-xs text-muted-foreground">
                Trust scores are recalculated on each login attempt
            </p>
        </div>
    </div>
</section>

@code {
    private bool _verifying = false;
    private string _code = "";

    private record TrustFactor(string Id, string Label, string Description, int Score, int MaxScore, string Status, string IconName);

    private static readonly TrustFactor[] _trustFactors =
    [
        new("device",   "Device recognition",    "Known MacBook Pro",          25, 25, "pass", "laptop"),
        new("location", "Location familiarity",  "San Francisco, CA (usual)",  20, 25, "pass", "map-pin"),
        new("network",  "Network trust",          "Corporate VPN detected",    25, 25, "pass", "globe"),
        new("behavior", "Login pattern",          "Unusual time of day",        5, 25, "warn", "shield-check"),
    ];

    // totalScore=75 (25+20+25+5), maxScore=100, scorePercent=75
    // riskLevel: 75>=80? no -> 75>=50? yes -> "medium"
    private static readonly int _scorePercent = 75;
    private static readonly string _riskLevel = "medium";

    private record RiskConfig(string Label, string Color, string Dot, string Bg);

    private static readonly RiskConfig _config = new("Medium risk", "text-amber-600", "bg-amber-500", "bg-amber-500");
}
