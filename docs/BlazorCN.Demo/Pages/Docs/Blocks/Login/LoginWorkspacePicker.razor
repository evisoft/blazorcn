@* ============================================================
   Block: login-workspace-picker
   Title: Login Workspace Picker
   Description: Workspace selection React authentication block for Next.js with team list showing avatars, names, and member counts, sign-in form after selection, and slide transitions using shadcn/ui Avatar, Input, Button, Tailwind CSS, and framer-motion AnimatePresence
   Long Description: Billing setup with payment method tabs, card input formatting, and secure form fields
   Dependencies: ButtonCn, InputCn, LabelCn, LucideArrowLeftCn, LucideChevronRightCn, LucidePlusCn
   Source: original/blocks/login/login-workspace-picker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @if (_selected == null)
        {
            <div>
                <div class="border-b px-4 py-3">
                    <span class="text-sm font-medium">Select workspace</span>
                </div>

                @for (var i = 0; i < _workspaces.Length; i++)
                {
                    var ws = _workspaces[i];
                    var isLast = i == _workspaces.Length - 1;
                    <button
                        type="button"
                        @onclick="@(() => _selected = ws)"
                        class="@(Cn.Merge("flex w-full items-center gap-3 px-4 py-3.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : ""))">
                        <div class="@(Cn.Merge("flex size-9 shrink-0 items-center justify-center rounded-lg text-sm font-semibold text-white", ws.Color))">
                            @ws.Initial
                        </div>
                        <div class="min-w-0 flex-1 text-left">
                            <span class="text-sm font-medium">@ws.Name</span>
                            <p class="text-xs text-muted-foreground">@ws.Members members</p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="text-muted-foreground/60" />
                    </button>
                }

                <div class="border-t px-4 py-3">
                    <ButtonCn
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Sm"
                        Class="h-7 gap-1.5 text-xs text-muted-foreground">
                        <LucidePlusCn Size="12" />
                        Create workspace
                    </ButtonCn>
                </div>
            </div>
        }
        else
        {
            <div>
                <div class="flex items-center gap-2 border-b px-4 py-3">
                    <ButtonCn
                        Type="button"
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.IconSm"
                        @onclick="@(() => _selected = null)">
                        <LucideArrowLeftCn Size="16" />
                    </ButtonCn>
                    <span class="text-sm font-medium">Sign in to</span>
                    <div class="@(Cn.Merge("flex size-5 items-center justify-center rounded text-[10px] font-semibold text-white", _selected.Color))">
                        @_selected.Initial
                    </div>
                    <span class="text-sm font-medium">@_selected.Name</span>
                </div>

                <div class="px-4 py-6">
                    <div class="space-y-4">
                        <div class="space-y-2">
                            <LabelCn for="ws-email" Class="text-xs text-muted-foreground">
                                Email
                            </LabelCn>
                            <InputCn
                                id="ws-email"
                                type="email"
                                Placeholder="@($"you@{_selected.Id}.com")"
                                Class="h-8 text-sm" />
                        </div>
                        <div class="space-y-2">
                            <LabelCn for="ws-password" Class="text-xs text-muted-foreground">
                                Password
                            </LabelCn>
                            <InputCn
                                id="ws-password"
                                type="password"
                                Placeholder="Enter your password"
                                Class="h-8 text-sm" />
                        </div>
                        <ButtonCn Class="h-8 w-full text-xs">Continue</ButtonCn>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private WorkspaceItem? _selected = null;

    private record WorkspaceItem(string Id, string Name, string Initial, int Members, string Color);

    private static readonly WorkspaceItem[] _workspaces =
    [
        new("acme", "Acme Corporation", "A", 8, "bg-violet-600"),
        new("startup", "Startup Labs", "S", 3, "bg-emerald-600"),
        new("workshop", "Workshop Studio", "W", 12, "bg-amber-600"),
    ];
}
