@* ============================================================
   Block: login-pattern-lock
   Title: LoginPatternLock
   Description: Pattern gesture lock screen React block for Next.js with 3x3 dot grid, pattern drawing visualization, clear and submit buttons, and attempt counter using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-pattern-lock.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="lock" Size="16" Class="size-4 text-muted-foreground" />
                <p class="text-sm font-medium">Pattern Unlock</p>
            </div>
            <p class="mt-0.5 text-xs text-muted-foreground">Draw your pattern to sign in</p>
        </div>

        <div class="flex flex-col items-center px-4 py-8">
            <div class="mb-2 grid grid-cols-3 gap-8">
                @for (var i = 0; i < 9; i++)
                {
                    var idx = i;
                    var isActive = _pattern.Contains(idx);
                    var order = _pattern.IndexOf(idx);
                    <button type="button"
                            class="relative flex size-14 items-center justify-center"
                            @onclick="@(() => ToggleDot(idx))">
                        <div class="@Cn.Merge("flex size-5 items-center justify-center rounded-full transition-colors", isActive ? "bg-foreground" : "bg-muted-foreground/20 hover:bg-muted-foreground/40")" />
                        @if (isActive)
                        {
                            <div class="absolute inset-0 rounded-full bg-foreground opacity-15" />
                            <span class="absolute -top-1 -right-1 flex size-4 items-center justify-center rounded-full bg-muted text-xs font-mono text-muted-foreground">
                                @(order + 1)
                            </span>
                        }
                    </button>
                }
            </div>

            <p class="mt-4 text-xs text-muted-foreground">
                @(_pattern.Count == 0
                    ? "Tap dots in sequence to draw your pattern"
                    : $"{_pattern.Count} dots selected (minimum 4)")
            </p>

            <div class="mt-4 flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                          OnClick="@(() => _pattern.Clear())"
                          Disabled="@(_pattern.Count == 0)">
                    Clear
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Disabled="@(_pattern.Count < 4)">
                    Unlock
                </ButtonCn>
            </div>
        </div>

        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between text-xs text-muted-foreground">
                <span>3 attempts remaining</span>
                <button type="button" class="transition-colors hover:text-foreground">
                    Forgot pattern?
                </button>
            </div>
        </div>
    </div>
</section>

@code {
    private List<int> _pattern = [];

    private void ToggleDot(int index)
    {
        if (_pattern.Contains(index)) return;
        _pattern.Add(index);
    }
}
