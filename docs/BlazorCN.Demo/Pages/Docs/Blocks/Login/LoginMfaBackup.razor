@* ============================================================
   Block: login-mfa-backup
   Title: LoginMfaBackup
   Description: MFA backup code entry React block for Next.js with backup code input, remaining codes counter, code format hint, and option to generate new codes using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/login/login-mfa-backup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
  <div class="overflow-hidden rounded-lg border bg-card">
    <div class="border-b px-4 py-3">
      <div class="flex items-center gap-2">
        <LucideIconCn Name="key" Size="16" Class="size-4 text-muted-foreground" />
        <p class="text-sm font-medium">Backup Code</p>
      </div>
      <p class="mt-0.5 text-xs text-muted-foreground">
        Enter one of your saved recovery codes
      </p>
    </div>

    <div class="px-4 py-6">
      <div class="flex flex-col items-center">
        <div class="mb-4 flex size-12 items-center justify-center rounded-xl bg-muted/50">
          <LucideIconCn Name="shield" Size="24" Class="size-6 text-muted-foreground" />
        </div>

        <p class="text-sm font-medium">Use a backup code</p>
        <p class="mt-1 text-center text-xs text-muted-foreground">
          Enter one of the 8-character codes you saved during setup
        </p>

        <div class="mt-6 w-full max-w-[300px] space-y-3">
          <div class="space-y-1.5">
            <LabelCn For="mfa-backup-code" Class="text-xs font-medium text-muted-foreground">
              Recovery code
            </LabelCn>
            <InputCn
              id="mfa-backup-code"
              Placeholder="xxxx-xxxx"
              @bind-Value="_code"
              Class="text-center font-mono tracking-widest"
              maxlength="9" />
            <p class="text-center text-xs text-muted-foreground">
              Format: 4 letters, dash, 4 letters
            </p>
          </div>

          <ButtonCn Class="w-full" Size="ButtonSize.Sm" Disabled="@(_code.Length < 9)">
            Verify backup code
          </ButtonCn>
        </div>
      </div>
    </div>

    <div class="border-t px-4 py-3">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-1.5">
          @if (_remainingCodes <= 3)
          {
            <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5 text-amber-500" />
          }
          <span class="text-xs text-muted-foreground">
            @_remainingCodes backup codes remaining
          </span>
        </div>
        <button
          type="button"
          class="text-xs text-muted-foreground transition-colors hover:text-foreground"
        >
          Generate new codes
        </button>
      </div>
    </div>

    <div class="border-t px-4 py-3">
      <div class="flex items-center justify-between">
        <button
          type="button"
          class="text-xs text-muted-foreground transition-colors hover:text-foreground"
        >
          Try authenticator app
        </button>
        <button
          type="button"
          class="text-xs text-muted-foreground transition-colors hover:text-foreground"
        >
          Contact support
        </button>
      </div>
    </div>
  </div>
</section>

@code {
    private string _code = "";
    private int _remainingCodes = 3;
}
