@* ============================================================
   Block: notification-priority-low
   Title: NotificationPriorityLow
   Description: A low priority notification digest block for React and Next.js with collapsible grouped notifications, muted styling, dismiss-all action, and staggered animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-priority-low.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="info" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Low Priority</span>
                @if (_notifications.Count > 0)
                {
                    <span class="text-muted-foreground text-xs">@_notifications.Count</span>
                }
            </div>
            @if (_notifications.Count > 0)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" OnClick="DismissAll">
                    <LucideIconCn Name="x" Size="12" Class="size-3" />
                    Dismiss All
                </ButtonCn>
            }
        </div>

        @* Description *@
        <div class="border-b px-4 py-2.5">
            <p class="text-muted-foreground text-xs">
                Informational updates and background activity. Review at your convenience.
            </p>
        </div>

        @* Notification list *@
        <div class="divide-y">
            @foreach (var notif in _visibleNotifications)
            {
                var n = notif;
                <div class="flex items-start gap-3 px-4 py-3">
                    <LucideIconCn Name="@n.IconName" Size="16" Class="mt-0.5 size-4 text-muted-foreground/60" />
                    <div class="min-w-0 flex-1">
                        <span class="text-muted-foreground text-sm">@n.Title</span>
                        <p class="mt-0.5 text-muted-foreground/70 text-xs">@n.Description</p>
                        <span class="mt-1 block text-muted-foreground/50 text-xs">@n.Timestamp</span>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 shrink-0 p-0 text-muted-foreground/50 hover:text-muted-foreground" OnClick="@(() => Dismiss(n.Id))" aria-label="@($"Dismiss {n.Title}")">
                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            }
            @if (_notifications.Count == 0)
            {
                <div class="px-4 py-6 text-center">
                    <p class="text-muted-foreground text-sm">All caught up</p>
                </div>
            }
        </div>

        @* Expand/Collapse toggle *@
        @if (_notifications.Count > CollapsedCount)
        {
            <div class="border-t px-4 py-2.5">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-full gap-1 text-xs" OnClick="ToggleExpanded">
                    <LucideIconCn Name="chevron-down" Size="12" Class="@Cn.Merge("size-3 transition-transform duration-200", _expanded ? "rotate-180" : "")" />
                    @(_expanded ? "Show less" : $"Show {_hiddenCount} more")
                </ButtonCn>
            </div>
        }

        @* Footer *@
        <div class="@Cn.Merge("px-4 py-2.5", _notifications.Count > CollapsedCount ? "" : "border-t")">
            <p class="text-center text-muted-foreground/60 text-xs">
                Low priority &middot; No action required
            </p>
        </div>

    </div>
</section>

@code {
    private const int CollapsedCount = 3;

    private record LowPriorityNotification(string Id, string IconName, string Title, string Description, string Timestamp);

    private static readonly LowPriorityNotification[] _initialNotifications =
    [
        new("lp1", "book-open",   "Documentation updated",          "The API reference for v2.4 has been published with new endpoint examples.",          "1h ago"),
        new("lp2", "refresh-cw",  "Dependency updates available",   "3 packages have minor version updates ready for review.",                            "3h ago"),
        new("lp3", "trending-up", "Weekly usage report ready",      "Your team used 12,400 API calls this week, up 8% from last week.",                   "5h ago"),
        new("lp4", "sparkles",    "New feature: Branch protection rules", "You can now configure branch protection directly from the dashboard.",          "1d ago"),
        new("lp5", "bell",        "Scheduled maintenance reminder",  "Planned maintenance window on Sunday, March 30 from 2:00 AM to 4:00 AM UTC.",        "2d ago"),
    ];

    private List<LowPriorityNotification> _notifications = new(_initialNotifications);
    private bool _expanded = false;

    private IEnumerable<LowPriorityNotification> _visibleNotifications =>
        _expanded ? _notifications : _notifications.Take(CollapsedCount);

    private int _hiddenCount => _notifications.Count - CollapsedCount;

    private void Dismiss(string id)
    {
        _notifications = _notifications.Where(n => n.Id != id).ToList();
    }

    private void DismissAll()
    {
        _notifications = [];
    }

    private void ToggleExpanded()
    {
        _expanded = !_expanded;
    }
}
