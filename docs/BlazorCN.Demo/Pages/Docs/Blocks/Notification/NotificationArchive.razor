@* ============================================================
   Block: notification-archive
   Title: NotificationArchive
   Description: A notification archive block for React and Next.js with archived items list, restore and clear actions, archive count badge, and fade-out animations on archive built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-archive.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="archive" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notifications</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @(_archivedItems.Count) archived
            </BadgeCn>
        </div>

        @* Active notifications with archive action *@
        @if (_activeItems.Count > 0)
        {
            <div class="border-b">
                <div class="flex items-center gap-1.5 px-4 pt-3 pb-1">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    <span class="font-medium text-muted-foreground text-xs">Active</span>
                </div>
                @foreach (var it in _activeItems)
                {
                    var item = it;
                    <div class="flex items-start gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="@item.IconName" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@item.Title</span>
                            <p class="mt-0.5 truncate text-muted-foreground text-xs">@item.Description</p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="h-6 gap-1 px-2 text-xs text-muted-foreground"
                                  OnClick="@(() => ArchiveItem(item.Id))"
                                  aria-label="@($"Archive {item.Title}")">
                            <LucideIconCn Name="archive" Size="12" Class="size-3" />
                            Archive
                        </ButtonCn>
                    </div>
                }
            </div>
        }

        @* Archived notifications *@
        <div>
            <div class="flex items-center justify-between px-4 pt-3 pb-1">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="archive" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Archived</span>
                </div>
                @if (_archivedItems.Count > 0)
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="h-6 gap-1 px-2 text-xs text-muted-foreground"
                              OnClick="ClearArchive">
                        <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                        Clear Archive
                    </ButtonCn>
                }
            </div>
            @foreach (var it in _archivedItems)
            {
                var item = it;
                <div class="flex items-start gap-3 border-b px-4 py-2.5 transition-colors hover:bg-muted/50 last:border-b-0">
                    <LucideIconCn Name="@item.IconName" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground/60" />
                    <div class="min-w-0 flex-1">
                        <span class="text-muted-foreground text-sm">@item.Title</span>
                        <p class="mt-0.5 truncate text-muted-foreground/60 text-xs">@item.Description</p>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        <span class="text-muted-foreground/40 text-xs">@item.ArchivedAt</span>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="h-6 gap-1 px-2 text-xs text-muted-foreground"
                                  OnClick="@(() => RestoreItem(item.Id))"
                                  aria-label="@($"Restore {item.Title}")">
                            <LucideIconCn Name="archive-restore" Size="12" Class="size-3" />
                            Restore
                        </ButtonCn>
                    </div>
                </div>
            }
            @if (_archivedItems.Count == 0)
            {
                <div class="px-4 py-4 text-center">
                    <p class="text-muted-foreground text-sm">Archive is empty. Archived notifications will appear here.</p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @(_activeItems.Count) active &middot; @(_archivedItems.Count) archived
            </p>
        </div>
    </div>
</section>

@code {
    private record NotificationItem(string Id, string IconName, string Title, string Description, string ArchivedAt, bool Archived);

    private List<NotificationItem> _notifications = new List<NotificationItem>
    {
        new("a1", "git-pull-request",  "PR #203 needs your review",          "Auth middleware refactor with rate limiting changes.",              "",       false),
        new("a2", "message-square",    "New mention in #engineering",         "Sarah tagged you in the API versioning discussion.",               "",       false),
        new("n1", "message-square",    "Comment on design review",            "Jordan left feedback on the navigation redesign.",                 "1h ago", true),
        new("n2", "zap",               "Deployment succeeded — production",   "Build v2.8.3 deployed to production environment.",                 "3h ago", true),
        new("n3", "user-plus",         "New team member joined",              "Casey accepted the invite to the Engineering workspace.",          "1d ago", true),
        new("n4", "file-text",         "Invoice #1042 generated",             "Monthly invoice for February 2026 is ready.",                     "2d ago", true),
        new("n5", "settings",          "Security patch applied",              "Dependency vulnerability in express@4.18 has been patched.",       "3d ago", true),
    };

    private List<NotificationItem> _activeItems => _notifications.FindAll(n => !n.Archived);
    private List<NotificationItem> _archivedItems => _notifications.FindAll(n => n.Archived);

    private void ArchiveItem(string id)
    {
        var idx = _notifications.FindIndex(n => n.Id == id);
        if (idx >= 0)
        {
            var n = _notifications[idx];
            _notifications[idx] = n with { Archived = true, ArchivedAt = "Just now" };
        }
    }

    private void RestoreItem(string id)
    {
        var idx = _notifications.FindIndex(n => n.Id == id);
        if (idx >= 0)
        {
            var n = _notifications[idx];
            _notifications[idx] = n with { Archived = false, ArchivedAt = "" };
        }
    }

    private void ClearArchive()
    {
        _notifications.RemoveAll(n => n.Archived);
    }
}
