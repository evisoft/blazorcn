@* ============================================================
   Block: notification-browser-tab
   Title: NotificationBrowserTab
   Description: A browser tab notification simulation block for React and Next.js with tab bar mockup, badge count indicator, notification list, title flashing description, and clear badge action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-browser-tab.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Tab bar mockup *@
        <div class="border-b bg-muted/30 px-4 py-2">
            <div class="flex items-center gap-2">
                <div class="flex items-center gap-2 rounded-t-md border border-b-0 bg-card px-3 py-1.5">
                    <div class="flex items-center gap-1.5">
                        <span class="size-3 rounded-sm bg-muted"></span>
                        <span class="max-w-[200px] truncate font-mono text-xs">@_tabTitle</span>
                    </div>
                    @if (_badgeCount > 0)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 min-w-4 justify-center px-1 font-normal text-xs">
                            @_badgeCount
                        </BadgeCn>
                    }
                </div>
                <div class="flex items-center gap-1.5 rounded-t-md border border-b-0 bg-muted/50 px-3 py-1.5">
                    <span class="size-3 rounded-sm bg-muted"></span>
                    <span class="font-mono text-muted-foreground text-xs">Settings</span>
                </div>
            </div>
        </div>

        @* Title behavior description *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Tab notifications</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                The page title shows unread count as a prefix. When the tab is inactive, the title
                alternates between the notification message and the page name to draw attention.
            </p>
        </div>

        @* Notification list *@
        <div>
            @foreach (var notif in _notifications)
            {
                var item = notif;
                var isLast = item.Id == _notifications[_notifications.Count - 1].Id;
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3", isLast ? "" : "border-b")">
                    <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-blue-500/10">
                        <LucideIconCn Name="@item.IconName" Size="14" Class="size-3.5 text-blue-600 dark:text-blue-400" />
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@item.Title</span>
                            <span class="shrink-0 text-muted-foreground text-xs">@item.Time</span>
                        </div>
                        <p class="mt-0.5 truncate text-muted-foreground text-xs">@item.Preview</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 shrink-0 p-0 text-muted-foreground" aria-label="Dismiss notification" OnClick="@(() => Dismiss(item.Id))">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            }
            @if (_notifications.Count == 0)
            {
                <div class="px-4 py-6 text-center">
                    <p class="text-muted-foreground text-sm">No unread notifications</p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <p class="text-muted-foreground text-xs">
                @(_badgeCount > 0
                    ? $"{_badgeCount} unread notification{(_badgeCount != 1 ? "s" : "")}"
                    : "Badge cleared")
            </p>
            @if (_badgeCount > 0)
            {
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="ClearAll">
                    Clear badge
                </ButtonCn>
            }
        </div>

    </div>
</section>

@code {
    private record TabNotification(string Id, string IconName, string Title, string Preview, string Time);

    private List<TabNotification> _notifications =
    [
        new("n1", "message-square", "New comment on PR #142", "Alex: Looks good, just one suggestion on the auth middleware...", "1 min ago"),
        new("n2", "user-plus", "Team invite accepted", "Jordan Lee joined the Engineering workspace", "3 min ago"),
        new("n3", "file-text", "Document shared with you", "Q1 Product Roadmap has been shared by Sarah", "8 min ago"),
    ];

    private int _badgeCount => _notifications.Count;

    private string _tabTitle => _badgeCount > 0
        ? $"({_badgeCount}) Acme · Dashboard"
        : "Acme · Dashboard";

    private void Dismiss(string id)
    {
        _notifications = _notifications.Where(n => n.Id != id).ToList();
    }

    private void ClearAll()
    {
        _notifications = [];
    }
}
