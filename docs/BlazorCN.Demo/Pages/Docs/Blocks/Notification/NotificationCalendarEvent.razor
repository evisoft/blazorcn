@* ============================================================
   Block: notification-calendar-event
   Title: NotificationCalendarEvent
   Description: A calendar event notification block for React and Next.js with meeting details, attendee avatars, agenda preview, join meeting CTA, and snooze option built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-calendar-event.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Meeting starting soon</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">In 10 min</BadgeCn>
            </div>
            <p class="mt-1.5 font-medium text-sm">@_event.Title</p>
            <p class="mt-0.5 text-muted-foreground text-sm">
                Organized by @_event.Organizer &middot; @_event.Attendees.Length attendees
            </p>
        </div>

        @* Time & Location *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-sm">@_event.Time</span>
                    <span class="text-muted-foreground text-xs">(@(_event.Duration))</span>
                </div>
                <div class="flex items-center gap-2">
                    @if (_event.LocationType == "virtual")
                    {
                        <LucideIconCn Name="video" Size="14" Class="size-3.5 text-muted-foreground" />
                    }
                    else
                    {
                        <LucideIconCn Name="map-pin" Size="14" Class="size-3.5 text-muted-foreground" />
                    }
                    <span class="text-sm">@_event.Location</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @(_event.LocationType == "virtual" ? "Virtual" : "In-person")
                    </BadgeCn>
                </div>
            </div>
        </div>

        @* Attendees *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Attendees</span>
            </div>
            <div class="mt-2 flex items-center gap-1.5">
                @foreach (var attendee in _event.Attendees)
                {
                    <span class="@($"flex size-7 items-center justify-center rounded-full text-white text-xs {attendee.Color}")"
                          role="img"
                          aria-label="@attendee.Name">
                        @attendee.Initials
                    </span>
                }
            </div>
        </div>

        @* Agenda *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Agenda</span>
            <ul class="mt-2 space-y-1.5">
                @foreach (var item in _event.Agenda)
                {
                    <li class="flex items-center justify-between text-sm">
                        <div class="flex items-center gap-2">
                            <span class="size-1.5 shrink-0 rounded-full bg-foreground/20"></span>
                            <span>@item.Label</span>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">@item.Duration</span>
                    </li>
                }
            </ul>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">
                    <LucideIconCn Name="video" Size="12" Class="size-3" />
                    Join Meeting
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                    Snooze 5 min
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Google Calendar &middot; Updated 2 min ago
            </p>
        </div>

    </div>
</section>

@code {
    private record AttendeeData(string Id, string Name, string Initials, string Color);
    private record AgendaItemData(string Id, string Label, string Duration);
    private record CalendarEventData(
        string Title,
        string Time,
        string Duration,
        string Location,
        string LocationType,
        string Organizer,
        AttendeeData[] Attendees,
        AgendaItemData[] Agenda
    );

    private static readonly CalendarEventData _event = new(
        Title: "Q2 Product Roadmap Review",
        Time: "2:00 PM - 3:00 PM",
        Duration: "60 min",
        Location: "Google Meet",
        LocationType: "virtual",
        Organizer: "Sarah Chen",
        Attendees:
        [
            new("1", "Sarah Chen", "SC", "bg-blue-500"),
            new("2", "Marcus Johnson", "MJ", "bg-emerald-500"),
            new("3", "Emily Park", "EP", "bg-amber-500"),
            new("4", "David Kim", "DK", "bg-purple-500"),
            new("5", "Lisa Thompson", "LT", "bg-rose-500"),
        ],
        Agenda:
        [
            new("a1", "Q1 retrospective and key metrics", "15 min"),
            new("a2", "Q2 feature priorities and timeline", "25 min"),
            new("a3", "Resource allocation and dependencies", "10 min"),
            new("a4", "Open discussion and next steps", "10 min"),
        ]
    );
}
