@* ============================================================
   Block: notification-trial-expiring
   Title: NotificationTrialExpiring
   Description: A trial expiration notification block for React and Next.js with countdown display, feature risk list, upgrade CTA, and extend trial option built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-trial-expiring.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clock" Size="16" Class="size-4 text-amber-600 dark:text-amber-400" />
                <span class="font-medium text-sm">Your trial expires in @_daysRemaining days</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Upgrade now to keep access to all premium features. Your data and settings will be
                preserved.
            </p>
        </div>

        @* Countdown *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="font-semibold text-2xl tabular-nums text-amber-600 dark:text-amber-400">
                    @_daysRemaining
                </span>
                <div>
                    <span class="font-medium text-sm">days remaining</span>
                    <p class="text-muted-foreground text-xs">Trial ends on Mar 27, 2026</p>
                </div>
            </div>
        </div>

        @* Features at risk *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Features you will lose</span>
            <div class="mt-2 space-y-2">
                @foreach (var feature in _featuresAtRisk)
                {
                    <div class="flex items-center gap-2.5">
                        <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-red-500/10">
                            <LucideIconCn Name="x" Size="12" Class="size-3 text-red-600 dark:text-red-400" />
                        </span>
                        <span class="text-sm">@feature</span>
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div class="border-b flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 gap-1.5 text-xs">
                <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                Upgrade Now
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                Extend Trial
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Plans start at $39/mo &middot; Cancel anytime
            </p>
        </div>
    </div>
</section>

@code {
    private const int _daysRemaining = 3;

    private static readonly string[] _featuresAtRisk =
    [
        "Unlimited API requests",
        "Advanced analytics dashboard",
        "Priority email support",
        "Custom integrations",
        "Team collaboration tools",
    ];
}
