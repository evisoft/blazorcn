@* ============================================================
   Block: notification-preference-panel
   Title: NotificationPreferencePanel
   Description: A notification preferences settings block for React and Next.js with category-based Switch toggles, sub-option controls, and save action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-preference-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notification Preferences</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Choose how and where you receive notifications. Toggle channels on or off, and
                fine-tune sub-options for each.
            </p>
        </div>

        @* Preference categories *@
        @foreach (var cat in _preferences)
        {
            var category = cat;
            <div class="border-b">
                @* Category row *@
                <div class="flex items-center gap-3 px-4 py-3">
                    <LucideIconCn Name="@category.Icon" Size="16" Class="size-4 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@category.Name</span>
                        <p class="text-muted-foreground text-xs">@category.Description</p>
                    </div>
                    <SwitchCn Checked="@category.Enabled"
                              CheckedChanged="@((bool _) => ToggleCategory(category.Id))"
                              aria-label="@($"Toggle {category.Name} notifications")" />
                </div>

                @* Sub-options *@
                @if (category.Enabled)
                {
                    <div class="pb-2">
                        @foreach (var so in category.SubOptions)
                        {
                            var sub = so;
                            <div class="flex items-center gap-3 py-1.5 pr-4 pl-11">
                                <span class="min-w-0 flex-1 text-muted-foreground text-sm">@sub.Label</span>
                                <SwitchCn Size="SwitchSize.Sm"
                                          Checked="@sub.Enabled"
                                          CheckedChanged="@((bool _) => ToggleSubOption(category.Id, sub.Id))"
                                          aria-label="@($"Toggle {sub.Label}")" />
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @* Save button *@
        <div class="px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">Save Preferences</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record SubOption(string Id, string Label, bool Enabled);
    private record PreferenceCategory(string Id, string Name, string Description, string Icon, bool Enabled, SubOption[] SubOptions);

    private List<PreferenceCategory> _preferences =
    [
        new("email", "Email", "Receive notifications via email", "mail", true,
        [
            new("email-mentions", "Mentions and replies", true),
            new("email-alerts", "System alerts", true),
            new("email-digest", "Weekly digest summary", false),
            new("email-marketing", "Product updates", false),
        ]),
        new("push", "Push", "Browser and mobile push notifications", "bell", true,
        [
            new("push-mentions", "Mentions and replies", true),
            new("push-alerts", "System alerts", true),
            new("push-activity", "Team activity", false),
        ]),
        new("in-app", "In-App", "Notifications inside the application", "message-square", true,
        [
            new("inapp-mentions", "Mentions and replies", true),
            new("inapp-alerts", "System alerts", true),
            new("inapp-updates", "Status updates", true),
        ]),
        new("sms", "SMS", "Text messages for critical alerts only", "smartphone", false,
        [
            new("sms-alerts", "Critical system alerts", false),
            new("sms-downtime", "Downtime notifications", false),
        ]),
    ];

    private void ToggleCategory(string categoryId)
    {
        _preferences = _preferences
            .Select(cat => cat.Id == categoryId
                ? cat with
                {
                    Enabled = !cat.Enabled,
                    SubOptions = cat.SubOptions.Select(sub => sub with { Enabled = !cat.Enabled }).ToArray()
                }
                : cat)
            .ToList();
    }

    private void ToggleSubOption(string categoryId, string subOptionId)
    {
        _preferences = _preferences
            .Select(cat => cat.Id == categoryId
                ? cat with
                {
                    SubOptions = cat.SubOptions
                        .Select(sub => sub.Id == subOptionId ? sub with { Enabled = !sub.Enabled } : sub)
                        .ToArray()
                }
                : cat)
            .ToList();
    }
}
