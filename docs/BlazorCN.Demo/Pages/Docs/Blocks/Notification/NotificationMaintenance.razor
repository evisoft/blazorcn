@* ============================================================
   Block: notification-maintenance
   Title: NotificationMaintenance
   Description: A scheduled maintenance notification block for React and Next.js with date and time window, affected services list, expected downtime, subscribe option, and amber warning accent built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-maintenance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="wrench" Size="16" Class="size-4 text-amber-600 dark:text-amber-400" />
                <span class="font-medium text-sm">Scheduled Maintenance</span>
            </div>
            <span class="size-1.5 rounded-full bg-amber-500"></span>
        </div>

        @* Description *@
        <div class="border-b px-4 py-3">
            <p class="text-sm">
                We will be performing scheduled maintenance to upgrade our database infrastructure and
                improve reliability.
            </p>
        </div>

        @* Time window *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Maintenance window</span>
            <div class="mt-2 rounded-md bg-amber-500/10 p-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-amber-600 dark:text-amber-400" />
                    <span class="font-medium text-sm">@_maintenanceWindow.Date</span>
                </div>
                <p class="mt-1 pl-5.5 text-muted-foreground text-xs">
                    @_maintenanceWindow.Start &ndash; @_maintenanceWindow.End &middot; Expected downtime: @_maintenanceWindow.Duration
                </p>
            </div>
        </div>

        @* Affected services *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Affected services</span>
            <div class="mt-2 space-y-2">
                @foreach (var svc in _services)
                {
                    <div class="flex items-center gap-2.5">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", svc.Affected ? "bg-amber-500" : "bg-emerald-500")"></span>
                        <span class="text-sm">@svc.Name</span>
                        @if (!svc.Affected)
                        {
                            <span class="text-emerald-600 text-xs dark:text-emerald-400">Not affected</span>
                        }
                    </div>
                }
            </div>
        </div>

        @* Subscribe toggle *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-sm">Subscribe to updates</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Get notified when maintenance starts and completes
                    </p>
                </div>
                <SwitchCn Checked="@_subscribed" CheckedChanged="@((bool v) => { _subscribed = v; })" aria-label="Subscribe to updates" />
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">View Status Page</ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private bool _subscribed = false;

    private record ServiceItem(string Id, string Name, bool Affected);

    private record MaintenanceWindow(string Date, string Start, string End, string Duration);

    private static readonly ServiceItem[] _services =
    [
        new("s1", "API Gateway", true),
        new("s2", "Database Cluster", true),
        new("s3", "Authentication", true),
        new("s4", "CDN & Static Assets", false),
        new("s5", "Webhook Delivery", false),
    ];

    private static readonly MaintenanceWindow _maintenanceWindow = new(
        "Saturday, March 29, 2026",
        "2:00 AM UTC",
        "4:00 AM UTC",
        "2 hours"
    );
}
