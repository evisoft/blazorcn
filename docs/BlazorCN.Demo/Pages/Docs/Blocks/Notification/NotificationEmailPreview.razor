@* ============================================================
   Block: notification-email-preview
   Title: NotificationEmailPreview
   Description: An email notification preview block for React and Next.js with unread indicators, sender info, subject lines, message snippets, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-email-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Inbox</span>
            </div>
            <span class="text-muted-foreground text-xs">
                @(_unreadCount > 0 ? $"{_unreadCount} unread" : "All caught up")
            </span>
        </div>

        @* Email list *@
        <div>
            @foreach (var email in _emails)
            {
                var isLast = _emails[_emails.Length - 1].Id == email.Id;
                var item = email;
                <button type="button"
                        class="@Cn.Merge("flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isLast ? "" : "border-b")"
                        @onclick="@(() => MarkAsRead(item.Id))">
                    <div class="mt-1.5 flex shrink-0">
                        @if (email.Unread)
                        {
                            <span class="size-2 rounded-full bg-blue-500"></span>
                        }
                        else
                        {
                            <span class="size-2 rounded-full bg-transparent"></span>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center justify-between gap-2">
                            <span class="@Cn.Merge("truncate text-sm", email.Unread ? "font-medium" : "text-muted-foreground")">
                                @email.Sender
                            </span>
                            <span class="shrink-0 text-muted-foreground text-xs">@email.Time</span>
                        </div>
                        <p class="@Cn.Merge("mt-0.5 truncate text-sm", email.Unread ? "font-medium" : "text-muted-foreground")">
                            @email.Subject
                        </p>
                        <p class="mt-0.5 truncate text-muted-foreground text-xs">@email.Preview</p>
                    </div>
                </button>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Click to mark as read &middot; 4 messages
            </p>
        </div>
    </div>
</section>

@code {
    private record Email(string Id, string Sender, string Subject, string Preview, string Time, bool Unread);

    private Email[] _emails =
    [
        new("e1", "Sarah Chen",   "Q1 Design Review — Updated Mockups",      "Hi team, I've uploaded the revised mockups for the dashboard redesign. The navigation changes address the feedback from last week's session.", "2 min ago",  true),
        new("e2", "GitHub",       "New release: shadcn/ui v4.2.0",           "This release includes new calendar components, improved accessibility for dialog, and fixes for the command palette keyboard navigation.",     "18 min ago", true),
        new("e3", "Alex Rivera",  "Invoice #4821 — Payment Received",        "Payment of $2,400.00 has been received for invoice #4821. The funds will be available in your account within 1-2 business days.",             "1 hr ago",   false),
        new("e4", "Vercel",       "Deployment successful — production",       "Your deployment to production completed in 34s. All checks passed. Preview URL: https://app-git-main-acme.vercel.app",                       "3 hr ago",   false),
    ];

    private int _unreadCount => _emails.Count(e => e.Unread);

    private void MarkAsRead(string id)
    {
        _emails = _emails.Select(e => e.Id == id ? e with { Unread = false } : e).ToArray();
    }
}
