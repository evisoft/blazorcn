@* ============================================================
   Block: notification-status-change
   Title: NotificationStatusChange
   Description: A status change notification block for React and Next.js with previous and new status badges, actor info, project context, and arrow transition indicator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-status-change.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="git-pull-request" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">@_change.IssueId moved to @_newConfig.Label</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                The status of this issue has been updated. Review the change details below.
            </p>
        </div>

        @* Status transition *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Status Change</span>
            <div class="mt-2 flex items-center gap-2.5">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"{_prevConfig.Bg} {_prevConfig.Text} border-0 font-normal text-xs")">
                    @_prevConfig.Label
                </BadgeCn>
                <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5 text-muted-foreground" />
                <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"{_newConfig.Bg} {_newConfig.Text} border-0 font-normal text-xs")">
                    @_newConfig.Label
                </BadgeCn>
            </div>
        </div>

        @* Issue title and project *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">@_change.Title</span>
            <div class="mt-1 flex items-center gap-2 text-muted-foreground text-xs">
                <span>@_change.Project</span>
                <span>&middot;</span>
                <span class="font-mono">@_change.IssueId</span>
            </div>
        </div>

        @* Actor info *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <div class="flex size-7 items-center justify-center rounded-full bg-muted">
                        <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div>
                        <span class="font-medium text-sm">@_change.ActorName</span>
                        <p class="text-muted-foreground text-xs">@_change.ActorRole</p>
                    </div>
                </div>
                <span class="text-muted-foreground text-xs">@_change.Timestamp</span>
            </div>
        </div>

        @* Actions *@
        <div class="px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 w-full text-xs">
                View Issue
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record StatusConfig(string Bg, string Text, string Label);

    private record ChangeData(
        string IssueId,
        string Title,
        string Project,
        string PreviousStatus,
        string NewStatus,
        string ActorName,
        string ActorRole,
        string Timestamp
    );

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["backlog"]     = new("bg-zinc-500/10",   "text-zinc-600 dark:text-zinc-400",   "Backlog"),
        ["todo"]        = new("bg-blue-500/10",    "text-blue-600 dark:text-blue-400",   "To Do"),
        ["in-progress"] = new("bg-amber-500/10",   "text-amber-600 dark:text-amber-400", "In Progress"),
        ["in-review"]   = new("bg-violet-500/10",  "text-violet-600 dark:text-violet-400", "In Review"),
        ["done"]        = new("bg-emerald-500/10", "text-emerald-600 dark:text-emerald-400", "Done"),
    };

    private static readonly ChangeData _change = new(
        IssueId: "FE-142",
        Title: "Refactor authentication middleware for session handling",
        Project: "Frontend Platform",
        PreviousStatus: "in-progress",
        NewStatus: "in-review",
        ActorName: "David Kim",
        ActorRole: "Senior Engineer",
        Timestamp: "5 min ago"
    );

    private StatusConfig _prevConfig => _statusConfig[_change.PreviousStatus];
    private StatusConfig _newConfig  => _statusConfig[_change.NewStatus];
}
