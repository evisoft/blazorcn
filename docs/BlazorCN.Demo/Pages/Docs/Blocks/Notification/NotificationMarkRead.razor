@* ============================================================
   Block: notification-mark-read
   Title: NotificationMarkRead
   Description: A mark all as read notification block for React and Next.js with unread count badge, blue dot indicators, animated bulk read action, and AnimatePresence transitions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-mark-read.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notifications</span>
                @if (_unreadCount > 0)
                {
                    <span class="flex h-5 items-center justify-center rounded-full bg-foreground px-1.5 text-[10px] font-medium text-background tabular-nums">
                        @_unreadCount unread
                    </span>
                }
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" @onclick="MarkAllRead" Disabled="@(_unreadCount == 0)">
                <LucideIconCn Name="check-check" Size="12" Class="size-3" />
                Mark all read
            </ButtonCn>
        </div>

        @* Notification list *@
        <div class="divide-y">
            @foreach (var notification in _notifications)
            {
                var notif = notification;
                <button type="button"
                        @onclick="@(() => MarkAsRead(notif.Id))"
                        class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="relative mt-0.5">
                        <LucideIconCn Name="@notif.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        @if (!notif.Read)
                        {
                            <span class="absolute -top-0.5 -right-0.5 size-2 rounded-full bg-blue-500"></span>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="@Cn.Merge("text-sm", notif.Read ? "text-muted-foreground" : "font-medium")">
                            @notif.Title
                        </span>
                        <p class="mt-0.5 truncate text-muted-foreground text-xs">@notif.Description</p>
                    </div>
                    <span class="shrink-0 text-muted-foreground text-xs">@notif.Timestamp</span>
                </button>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @if (_unreadCount == 0)
                {
                    @:All caught up — no unread notifications
                }
                else
                {
                    @($"{_unreadCount} of {_notifications.Length} notifications unread")
                }
            </p>
        </div>
    </div>
</section>

@code {
    private record NotificationItem(string Id, string IconName, string Title, string Description, string Timestamp, bool Read);

    private NotificationItem[] _notifications =
    [
        new("n1", "message-square", "New comment on Pull Request #142", "Sarah mentioned you in a review comment on the auth refactor.", "2 min ago", false),
        new("n2", "user-plus", "Alex Rivera joined your workspace", "Accepted the invitation to join the Engineering team.", "15 min ago", false),
        new("n3", "zap", "Deployment succeeded", "Production deploy v2.4.1 completed in 47 seconds.", "1 hour ago", true),
        new("n4", "git-pull-request", "PR #138 merged to main", "Your pull request for the dashboard redesign was merged.", "3 hours ago", false),
        new("n5", "shield-alert", "Unusual login attempt detected", "New device signed in from San Francisco, CA.", "5 hours ago", true),
        new("n6", "file-text", "Invoice generated for March 2026", "Monthly invoice is ready to download from billing.", "1 day ago", false),
        new("n7", "user-plus", "Team role updated", "You were promoted to Admin in the Design workspace.", "2 days ago", false),
    ];

    private int _unreadCount => _notifications.Count(n => !n.Read);

    private void MarkAllRead()
    {
        _notifications = _notifications
            .Select(n => n with { Read = true })
            .ToArray();
    }

    private void MarkAsRead(string id)
    {
        _notifications = _notifications
            .Select(n => n.Id == id ? n with { Read = true } : n)
            .ToArray();
    }
}
