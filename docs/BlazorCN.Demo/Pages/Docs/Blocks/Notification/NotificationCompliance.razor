@* ============================================================
   Block: notification-compliance
   Title: NotificationCompliance
   Description: A compliance action notification block for React and Next.js with GDPR data review prompt, compliance type badge, required actions checklist, deadline tracking, and regulatory context built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-compliance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Action Required</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_item.ComplianceType
                    </BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-xs", _statusConfig[_item.Status].ClassName)">
                        @_statusConfig[_item.Status].Label
                    </BadgeCn>
                </div>
            </div>
            <p class="mt-1.5 font-medium text-sm">@_item.Title</p>
            <p class="mt-0.5 text-muted-foreground text-sm">@_item.Description</p>
        </div>

        @* Deadline *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Deadline</span>
            <div class="flex items-center gap-2">
                <span class="text-sm">@_item.Deadline</span>
                @if (_item.DaysRemaining < 0)
                {
                    <span class="text-red-600 text-xs dark:text-red-400">
                        @Math.Abs(_item.DaysRemaining) days overdue
                    </span>
                }
            </div>
        </div>

        @* Progress summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Required Actions</span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_completedCount of @_item.Actions.Length complete
                </span>
            </div>
            <ul class="mt-2 space-y-1.5">
                @foreach (var action in _item.Actions)
                {
                    <li class="flex items-center gap-2 text-sm">
                        @if (action.Done)
                        {
                            <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 shrink-0 text-emerald-600 dark:text-emerald-400" />
                        }
                        else
                        {
                            <LucideIconCn Name="circle" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/50" />
                        }
                        <span class="@(action.Done ? "text-muted-foreground line-through" : "")">@action.Label</span>
                    </li>
                }
            </ul>
        </div>

        @* Regulatory context *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Regulatory Context</span>
            <div class="mt-2 rounded-md bg-muted/50 p-3">
                <p class="text-muted-foreground text-sm leading-relaxed">@_item.RegulatoryContext</p>
                <div class="mt-2 flex items-center gap-1 text-muted-foreground text-xs">
                    <span class="font-mono">@_item.Reference</span>
                    <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">Complete Review</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">Assign to Team</ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Compliance Manager &middot; Auto-generated from policy engine
            </p>
        </div>
    </div>
</section>

@code {
    private record RequiredAction(string Id, string Label, bool Done);

    private record ComplianceData(
        string Title,
        string ComplianceType,
        string Status,
        string Deadline,
        int DaysRemaining,
        string Description,
        string RegulatoryContext,
        RequiredAction[] Actions,
        string Reference
    );

    private record StatusConfig(string Label, string ClassName);

    private static readonly Dictionary<string, StatusConfig> _statusConfig = new()
    {
        ["pending"] = new StatusConfig("Pending", "border-amber-200 bg-amber-500/10 text-amber-600 dark:border-amber-800 dark:text-amber-400"),
        ["overdue"] = new StatusConfig("Overdue", "border-red-200 bg-red-500/10 text-red-600 dark:border-red-800 dark:text-red-400"),
        ["complete"] = new StatusConfig("Complete", "border-emerald-200 bg-emerald-500/10 text-emerald-600 dark:border-emerald-800 dark:text-emerald-400"),
    };

    private static readonly ComplianceData _item = new(
        Title: "Annual data processing review",
        ComplianceType: "GDPR",
        Status: "overdue",
        Deadline: "Mar 22, 2026",
        DaysRemaining: -2,
        Description: "Review and document all personal data processing activities under Article 30. Verify lawful basis for each processing operation and update the Record of Processing Activities (ROPA).",
        RegulatoryContext: "Under GDPR Article 30, controllers must maintain records of processing activities. Annual review ensures accuracy and identifies new processing operations that require Data Protection Impact Assessments.",
        Actions: [
            new("a1", "Audit current data processing inventory", true),
            new("a2", "Verify lawful basis for each processing activity", true),
            new("a3", "Update Record of Processing Activities (ROPA)", false),
            new("a4", "Review third-party data processor agreements", false),
            new("a5", "Sign-off from Data Protection Officer", false),
        ],
        Reference: "GDPR Article 30"
    );

    private static readonly int _completedCount = _item.Actions.Count(a => a.Done);
}
