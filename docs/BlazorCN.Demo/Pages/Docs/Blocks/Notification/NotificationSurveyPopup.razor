@* ============================================================
   Block: notification-survey-popup
   Title: NotificationSurveyPopup
   Description: A compact survey popup notification block for React and Next.js with single question display, four radio-style options, progress indicator, submit button, and step navigation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-survey-popup.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @if (_completed)
        {
            @* Completed state *@
            <div class="px-4 py-8 text-center">
                <span class="mx-auto flex size-8 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
                </span>
                <p class="mt-3 font-medium text-sm">Survey complete</p>
                <p class="mt-1 text-muted-foreground text-xs">
                    Thank you for sharing your thoughts with us.
                </p>
            </div>
        }
        else
        {
            @* Header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <LucideIconCn Name="clipboard" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="font-medium text-sm">Quick Survey</span>
                    </div>
                    <span class="text-muted-foreground text-xs">
                        Question @(_currentStep + 1) of @TotalQuestions
                    </span>
                </div>
            </div>

            @* Progress bar *@
            <div class="border-b px-4 py-2">
                <div class="h-1 w-full overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-foreground" style="@($"width:{_progressPercentage}%")"></div>
                </div>
            </div>

            @* Question *@
            <div class="border-b px-4 py-3">
                <p class="text-sm">@_currentQuestion.Text</p>
            </div>

            @* Options *@
            <div class="border-b px-4 py-3">
                <div class="space-y-2">
                    @foreach (var opt in _currentQuestion.Options)
                    {
                        var option = opt;
                        var isSelected = _selectedOption == option.Id;
                        <button type="button"
                                @onclick="@(() => HandleSelect(option.Id))"
                                class="@Cn.Merge("flex w-full items-center gap-2.5 rounded-md px-3 py-2 text-left text-sm transition-colors", isSelected ? "bg-muted/50 ring-2 ring-foreground" : "hover:bg-muted/50")">
                            <span class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border", isSelected ? "border-foreground bg-foreground" : "border-muted-foreground/30")">
                                @if (isSelected)
                                {
                                    <span class="size-1.5 rounded-full bg-background"></span>
                                }
                            </span>
                            <span>@option.Label</span>
                        </button>
                    }
                </div>
            </div>

            @* Submit *@
            <div class="px-4 py-3">
                <ButtonCn Size="ButtonSize.Sm"
                          Class="h-8 w-full text-xs"
                          Disabled="@(_selectedOption == null)"
                          OnClick="HandleSubmit">
                    @(_currentStep < TotalQuestions - 1 ? "Next" : "Submit")
                </ButtonCn>
            </div>
        }
    </div>
</section>

@code {
    private record QuestionOption(string Id, string Label);
    private record Question(string Id, string Text, QuestionOption[] Options);

    private static readonly Question[] _questions =
    [
        new("q1", "How often do you use our product?",
        [
            new("o1", "Daily"),
            new("o2", "A few times a week"),
            new("o3", "Weekly"),
            new("o4", "Less than weekly"),
        ]),
        new("q2", "Which feature do you find most valuable?",
        [
            new("o1", "Dashboard analytics"),
            new("o2", "Team collaboration"),
            new("o3", "API integrations"),
            new("o4", "Automated workflows"),
        ]),
        new("q3", "How likely are you to recommend us to a colleague?",
        [
            new("o1", "Very likely"),
            new("o2", "Somewhat likely"),
            new("o3", "Neutral"),
            new("o4", "Unlikely"),
        ]),
    ];

    private static readonly int TotalQuestions = _questions.Length;

    private int _currentStep = 0;
    private Dictionary<string, string> _answers = new();
    private bool _completed = false;

    private Question _currentQuestion => _questions[_currentStep];
    private string? _selectedOption => _answers.TryGetValue(_currentQuestion.Id, out var val) ? val : null;
    private double _progressPercentage => ((_currentStep + 1.0) / TotalQuestions) * 100;

    private void HandleSelect(string optionId)
    {
        _answers[_currentQuestion.Id] = optionId;
    }

    private void HandleSubmit()
    {
        if (_currentStep < TotalQuestions - 1)
        {
            _currentStep++;
        }
        else
        {
            _completed = true;
        }
    }
}
