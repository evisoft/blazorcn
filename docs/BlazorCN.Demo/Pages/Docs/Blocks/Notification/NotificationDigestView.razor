@* ============================================================
   Block: notification-digest-view
   Title: NotificationDigestView
   Description: A daily notification digest summary block for React and Next.js with grouped categories, summary stats, and staggered list animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-digest-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Your Daily Digest</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Monday, Mar 24 &mdash; here is what happened while you were away.
            </p>
        </div>

        @* Summary stats *@
        <div class="flex flex-wrap items-center gap-3 border-b px-4 py-3">
            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                <LucideIconCn Name="inbox" Size="12" Class="size-3" />
                @_totalNew new
            </BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                @_totalMentions mentions
            </BadgeCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                <LucideIconCn Name="triangle-alert" Size="12" Class="size-3" />
                @_totalAlerts alert
            </BadgeCn>
        </div>

        @* Grouped notification items *@
        @foreach (var cat in _categories)
        {
            var category = cat;
            <div class="border-b">
                @* Category header *@
                <div class="flex items-center gap-2 px-4 pt-3 pb-1.5">
                    <LucideIconCn Name="@category.IconName" Size="14" Class="@Cn.Merge("size-3.5", category.Color)" />
                    <span class="font-medium text-muted-foreground text-xs">@category.Name</span>
                    <span class="text-muted-foreground/60 text-xs">@category.Items.Length</span>
                </div>

                @* Items *@
                @foreach (var it in category.Items)
                {
                    var item = it;
                    <div class="flex items-start gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", category.DotColor)"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@item.Title</span>
                            <p class="mt-0.5 truncate text-muted-foreground text-xs">@item.Description</p>
                        </div>
                        <span class="shrink-0 text-muted-foreground/60 text-xs">@item.Timestamp</span>
                    </div>
                }
            </div>
        }

        @* Footer CTA *@
        <div class="px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                View Full Inbox
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record NotificationItem(string Id, string Title, string Description, string Timestamp);

    private record Category(string Name, string IconName, string Color, string DotColor, NotificationItem[] Items);

    private static readonly Category[] _categories =
    [
        new(
            "Mentions",
            "at-sign",
            "text-blue-600 dark:text-blue-400",
            "bg-blue-500",
            [
                new("m1", "Sarah mentioned you in a comment",    "Design review thread on the dashboard redesign",          "8:42 AM"),
                new("m2", "Alex tagged you in a pull request",   "feat: add notification digest API endpoint",              "9:15 AM"),
                new("m3", "Team standup notes mention your task","Sprint 14 planning — auth migration assigned",            "10:03 AM"),
            ]
        ),
        new(
            "Pull Requests",
            "git-pull-request",
            "text-emerald-600 dark:text-emerald-400",
            "bg-emerald-500",
            [
                new("pr1", "PR #342 approved by Jamie",      "fix: resolve webhook retry logic",          "7:30 AM"),
                new("pr2", "PR #339 has merge conflicts",    "refactor: migrate to new auth provider",    "11:20 AM"),
            ]
        ),
        new(
            "Alerts",
            "triangle-alert",
            "text-amber-600 dark:text-amber-400",
            "bg-amber-500",
            [
                new("a1", "API response time exceeded 2s threshold", "Endpoint /api/search — p95 latency at 2.4s", "6:18 AM"),
            ]
        ),
    ];

    private const int _totalNew = 5;
    private const int _totalMentions = 3;
    private const int _totalAlerts = 1;
}
