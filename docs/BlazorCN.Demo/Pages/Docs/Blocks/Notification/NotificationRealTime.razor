@* ============================================================
   Block: notification-real-time
   Title: NotificationRealTime
   Description: A real-time notification indicator block for React and Next.js with pulsing live dot, sliding banner, and recent items list built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-real-time.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header with live indicator *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Notifications</span>
            <div class="flex items-center gap-1.5">
                <span class="relative flex size-2">
                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-emerald-500"></span>
                </span>
                <span class="font-medium text-emerald-600 text-xs dark:text-emerald-400">Live</span>
            </div>
        </div>

        @* New notifications banner *@
        <div class="border-b px-4 py-2.5">
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_newCount new notifications
                </BadgeCn>
                <p class="text-muted-foreground text-xs">Activity from the last few minutes</p>
            </div>
        </div>

        @* Notification items *@
        <div>
            @for (int i = 0; i < _notifications.Length; i++)
            {
                var notif = _notifications[i];
                var isLast = i == _notifications.Length - 1;
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">

                    @* Unread dot *@
                    <div class="flex items-center pt-1">
                        @if (notif.IsNew)
                        {
                            <span class="size-1.5 rounded-full bg-blue-500"></span>
                        }
                        else
                        {
                            <span class="size-1.5"></span>
                        }
                    </div>

                    @* Icon *@
                    <LucideIconCn Name="@notif.IconName" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />

                    @* Content *@
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@notif.Title</span>
                        <p class="mt-0.5 truncate text-muted-foreground text-xs">@notif.Description</p>
                    </div>

                    @* Timestamp *@
                    <span class="@Cn.Merge("shrink-0 text-xs", notif.IsNew ? "font-medium text-foreground" : "text-muted-foreground/60")">
                        @notif.Timestamp
                    </span>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <p class="text-muted-foreground text-xs">Refreshes automatically</p>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 text-xs">
                    Mark All Read
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Notification(string Id, string IconName, string Title, string Description, string Timestamp, bool IsNew);

    private static readonly Notification[] _notifications =
    [
        new("n1", "at-sign",         "Sarah mentioned you",       "Can you review the API docs before we ship?",          "Just now", true),
        new("n2", "alert-triangle",  "Deploy failed on staging",  "Build error in api/webhooks/stripe.ts line 42",        "Just now", true),
        new("n3", "git-pull-request","PR #287 approved",          "Jamie approved your pull request: fix auth redirect",  "Just now", true),
        new("n4", "message-square",  "New comment on roadmap",    "Alex left a comment on the Q2 planning document",      "2 min ago", false),
        new("n5", "settings",        "Workspace settings updated","Default branch changed from master to main",            "5 min ago", false),
    ];

    private static readonly int _newCount = Array.FindAll(_notifications, n => n.IsNew).Length;
}
