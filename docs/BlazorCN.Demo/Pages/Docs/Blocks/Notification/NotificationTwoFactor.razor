@* ============================================================
   Block: notification-two-factor
   Title: NotificationTwoFactor
   Description: A two-factor authentication prompt notification block for React and Next.js with security benefits list, urgency indicator, enable 2FA CTA, and skip option built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-two-factor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Enable Two-Factor Authentication</span>
                <span class="size-1.5 rounded-full bg-amber-500"></span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Add an extra layer of security to your account. Two-factor authentication helps
                prevent unauthorized access even if your password is compromised.
            </p>
        </div>

        @* Urgency message *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-amber-500/10 px-3 py-2">
                <p class="text-amber-700 text-xs dark:text-amber-300">
                    Your account has elevated privileges. We strongly recommend enabling 2FA to protect
                    your administrative access.
                </p>
            </div>
        </div>

        @* Benefits *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Why enable 2FA</span>
            <div class="mt-2 space-y-2">
                @foreach (var benefit in _benefits)
                {
                    <div class="flex items-center gap-2.5">
                        <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                        </span>
                        <span class="text-sm">@benefit.Label</span>
                    </div>
                }
            </div>
        </div>

        @* CTA *@
        <div class="border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">Enable 2FA</ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-between">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-muted-foreground text-xs">Skip for now</ButtonCn>
                <span class="text-muted-foreground text-xs">Takes less than 2 minutes</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record Benefit(string Id, string Label);

    private static readonly Benefit[] _benefits =
    [
        new("b1", "Protect against unauthorized account access"),
        new("b2", "Secure sensitive data with a second verification step"),
        new("b3", "Meet compliance requirements for enterprise accounts"),
    ];
}
