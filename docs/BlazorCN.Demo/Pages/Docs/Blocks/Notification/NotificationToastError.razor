@* ============================================================
   Block: notification-toast-error
   Title: NotificationToastError
   Description: An error toast notification block for React and Next.js with red error icon, error codes, retry action button, and stacked dismiss controls built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-toast-error.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-600 dark:text-red-400" />
                <span class="font-medium text-sm">Error Notifications</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Error alerts with diagnostic codes and retry actions for failed operations.
            </p>
        </div>

        @* Toast stack *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-3">
                @foreach (var toast in _toasts)
                {
                    var toastItem = toast;
                    <div class="overflow-hidden rounded-md border border-red-500/20 bg-background"
                         role="alert"
                         aria-live="assertive">
                        <div class="flex items-start gap-3 px-3 py-2.5">
                            <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-red-500/10">
                                <LucideIconCn Name="x-circle" Size="14" Class="size-3.5 text-red-600 dark:text-red-400" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@toastItem.Title</span>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs">@toastItem.Detail</p>
                                <div class="mt-2 flex items-center gap-2">
                                    <span class="rounded bg-red-500/10 px-1.5 py-0.5 font-mono text-red-600 text-xs dark:text-red-400">
                                        @toastItem.Code
                                    </span>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                        <LucideIconCn Name="rotate-ccw" Size="12" Class="size-3" />
                                        Retry
                                    </ButtonCn>
                                </div>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 shrink-0 p-0 text-muted-foreground"
                                      OnClick="@(() => Dismiss(toastItem.Id))"
                                      aria-label="Dismiss error notification">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                }

                @if (_toasts.Length == 0)
                {
                    <div class="py-6 text-center">
                        <p class="text-muted-foreground text-sm">All errors dismissed</p>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-2 h-7 text-xs"
                                  OnClick="@Reset">
                            Reset
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <p class="text-muted-foreground text-xs">
                    @_toasts.Length error@(_toasts.Length != 1 ? "s" : "") requiring attention
                </p>
                @if (_toasts.Length > 0)
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs"
                              OnClick="@DismissAll">
                        Dismiss all
                    </ButtonCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ErrorToast(string Id, string Title, string Detail, string Code);

    private static readonly ErrorToast[] _initialToasts =
    [
        new("e1", "Payment processing failed",
            "Unable to charge the card ending in 4242. The issuing bank declined the transaction.",
            "ERR_PAYMENT_DECLINED"),
        new("e2", "File upload failed",
            "Connection timed out while uploading quarterly-report.pdf. Check your network connection.",
            "ERR_TIMEOUT_408"),
        new("e3", "Webhook delivery failed",
            "Endpoint https://api.acme.co/hooks returned HTTP 502 after 3 retry attempts.",
            "ERR_WEBHOOK_502"),
    ];

    private ErrorToast[] _toasts = _initialToasts;

    private void Dismiss(string id)
    {
        _toasts = _toasts.Where(t => t.Id != id).ToArray();
    }

    private void DismissAll()
    {
        _toasts = [];
    }

    private void Reset()
    {
        _toasts = _initialToasts;
    }
}
