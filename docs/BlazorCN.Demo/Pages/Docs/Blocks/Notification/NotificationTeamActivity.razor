@* ============================================================
   Block: notification-team-activity
   Title: NotificationTeamActivity
   Description: A team activity notification feed block for React and Next.js with member avatars, commit and deploy actions, staggered animations, and team dashboard link built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-team-activity.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Team Activity</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Recent activity from your team members across all projects.
            </p>
        </div>

        @* Summary bar *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">@_activities.Length updates</span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="text-muted-foreground text-xs">5 active members</span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="text-muted-foreground text-xs">Last 2 hours</span>
        </div>

        @* Activity list *@
        <div>
            @foreach (var activity in _activities)
            {
                var isLast = activity.Id == _activities[_activities.Length - 1].Id;
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("mt-1.5 size-2 shrink-0 rounded-full", activity.ActorColor)"></span>
                    <div class="min-w-0 flex-1">
                        <p class="text-sm">
                            <span class="font-medium">@activity.Actor</span>
                            @(" ")
                            <span class="text-muted-foreground">@activity.Action</span>
                            @(" ")
                            <span class="font-medium">@activity.Target</span>
                        </p>
                    </div>
                    <span class="shrink-0 text-muted-foreground text-xs">@activity.Timestamp</span>
                </div>
            }
        </div>

        @* Action *@
        <div class="border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 w-full gap-1.5 text-xs">
                View Team Dashboard
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Showing last 2 hours &middot; 5 of 18 activities
            </p>
        </div>

    </div>
</section>

@code {
    private record Activity(string Id, string Actor, string ActorColor, string Action, string Target, string Timestamp);

    private static readonly Activity[] _activities =
    [
        new("1", "Alex Kim",      "bg-blue-500",    "pushed 3 commits to",  "feature/auth-flow",                      "2 min ago"),
        new("2", "Maria Santos",  "bg-emerald-500", "approved review on",   "PR #247: Add user settings page",        "8 min ago"),
        new("3", "Jordan Lee",    "bg-amber-500",   "deployed to",          "production (v2.4.1)",                    "23 min ago"),
        new("4", "Priya Patel",   "bg-purple-500",  "commented on",         "Issue #182: Rate limiter edge case",     "1 hr ago"),
        new("5", "Sam Chen",      "bg-rose-500",    "merged",               "PR #243: Database migration scripts",    "2 hr ago"),
    ];
}
