@* ============================================================
   Block: notification-system-alert
   Title: NotificationSystemAlert
   Description: A system alert notification block for React and Next.js with severity-coded alerts for server outages, high CPU, and database failures, expandable details, and staggered Framer Motion animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-system-alert.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="alert-octagon" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">System Alerts</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Active infrastructure alerts requiring attention. Sorted by severity with the most
                critical issues first.
            </p>
        </div>

        @* Summary bar *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">@_alerts.Length alerts</span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_countCritical critical
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_countWarning warning
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_countInfo info
                </span>
            </div>
        </div>

        @* Alert list *@
        <div>
            @for (int i = 0; i < _alerts.Length; i++)
            {
                var alert = _alerts[i];
                var isExpanded = _expanded == alert.Id;
                var isLast = i == _alerts.Length - 1;
                var alertId = alert.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = (isExpanded ? null : alertId))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {SeverityDot(alert.Severity)}")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@alert.Title</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="truncate font-mono text-muted-foreground text-xs">@alert.Source</span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="shrink-0 text-muted-foreground text-xs">@alert.Timestamp</span>
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">@SeverityLabel(alert.Severity)</BadgeCn>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <p class="mb-3 text-muted-foreground text-sm leading-relaxed">@alert.Description</p>
                            <div class="flex items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@alert.Status</BadgeCn>
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View Details</ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Acknowledge</ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Auto-refreshes every 30 seconds &middot; Last checked 12 sec ago
            </p>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "1";

    private record SystemAlert(
        string Id,
        string Severity,
        string Title,
        string Source,
        string Timestamp,
        string Description,
        string Status
    );

    private static readonly SystemAlert[] _alerts =
    [
        new("1", "critical", "Primary database connection lost",
            "db-primary-us-east-1", "2 min ago",
            "PostgreSQL primary instance in us-east-1 is unreachable. Connection pool exhausted after 30s timeout. Failover to read replica initiated. 12 active queries terminated.",
            "Investigating"),
        new("2", "critical", "API gateway returning 503 errors",
            "api-gateway-prod", "5 min ago",
            "API gateway is returning 503 Service Unavailable for 38% of incoming requests. Upstream health checks failing on 3 of 5 backend instances. Auto-scaling triggered.",
            "Mitigating"),
        new("3", "warning", "CPU usage exceeds 90% threshold",
            "worker-node-04", "12 min ago",
            "Worker node 04 CPU utilization sustained at 94% for the past 8 minutes. Background job queue depth is 2,340 tasks. Consider scaling horizontally or deferring non-critical jobs.",
            "Monitoring"),
        new("4", "warning", "SSL certificate expiring soon",
            "*.acme.com", "1 hr ago",
            "Wildcard certificate for *.acme.com expires in 7 days. Auto-renewal via Let's Encrypt failed due to DNS validation timeout. Manual intervention required.",
            "Pending"),
        new("5", "info", "Scheduled maintenance window starting",
            "infra-scheduler", "3 hr ago",
            "Planned maintenance window begins at 02:00 UTC for database migration and index optimization. Expected downtime is 15 minutes. All stakeholders have been notified.",
            "Scheduled"),
    ];

    private static readonly int _countCritical = _alerts.Count(a => a.Severity == "critical");
    private static readonly int _countWarning = _alerts.Count(a => a.Severity == "warning");
    private static readonly int _countInfo = _alerts.Count(a => a.Severity == "info");

    private static string SeverityDot(string severity) => severity switch
    {
        "critical" => "bg-red-500",
        "warning" => "bg-amber-500",
        "info" => "bg-blue-500",
        _ => ""
    };

    private static string SeverityLabel(string severity) => severity switch
    {
        "critical" => "Critical",
        "warning" => "Warning",
        "info" => "Info",
        _ => severity
    };
}
