@* ============================================================
   Block: notification-cookie-consent
   Title: NotificationCookieConsent
   Description: A cookie consent notification block for React and Next.js with accept, reject, and customize options, privacy policy link, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-cookie-consent.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @if (_consented is null)
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="flex items-center gap-2 border-b px-4 py-3">
                <LucideIconCn Name="circle-dot" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Cookie Preferences</span>
            </div>

            @* Description *@
            <div class="border-b px-4 py-3">
                <p class="text-muted-foreground text-sm">
                    We use cookies to improve your experience, analyze site traffic, and personalize
                    content. You can choose which cookies to allow below.
                </p>
                <button type="button"
                        class="mt-1.5 text-muted-foreground text-xs underline underline-offset-2 transition-colors hover:text-foreground">
                    Read our Privacy Policy
                </button>
            </div>

            @* Customize panel *@
            @if (_showCustomize)
            {
                @foreach (var cat in _cookieCategories)
                {
                    var category = cat;
                    <div class="flex items-center justify-between border-b px-4 py-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@category.Name</span>
                                @if (category.Required)
                                {
                                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                        <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                                        Required
                                    </span>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@category.Description</p>
                        </div>
                        <SwitchCn Checked="@(category.Required || GetPreference(category.Id))"
                                  CheckedChanged="@((bool v) => { if (!category.Required) ToggleCategory(category.Id); })"
                                  Disabled="@category.Required"
                                  aria-label="@($"Toggle {category.Name} cookies")" />
                    </div>
                }
            }

            @* Actions *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs"
                              @onclick="@(() => _consented = "accepted")">
                        Accept All
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs"
                              @onclick="@(() => _consented = "rejected")">
                        Reject All
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs"
                              @onclick="HandleCustomizeOrSave">
                        @(_showCustomize ? "Save Preferences" : "Customize")
                    </ButtonCn>
                </div>
            </div>

            @* Footer *@
            <div class="px-4 py-2.5">
                <p class="text-center text-muted-foreground text-xs">
                    GDPR &middot; CCPA compliant
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex items-center justify-center gap-2 px-4 py-6">
                <LucideIconCn Name="shield-check" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                <p class="text-muted-foreground text-sm">
                    @(_consented == "accepted"
                        ? "All cookies accepted"
                        : _consented == "rejected"
                            ? "Non-essential cookies rejected"
                            : "Cookie preferences saved")
                </p>
            </div>
        </div>
    }
</section>

@code {
    private record CookieCategory(string Id, string Name, string Description, bool Required);

    private static readonly CookieCategory[] _cookieCategories =
    [
        new("necessary", "Strictly Necessary", "Required for the website to function. Cannot be disabled.", true),
        new("analytics", "Analytics", "Help us understand how visitors interact with our website.", false),
        new("marketing", "Marketing", "Used to deliver relevant advertisements and track campaigns.", false),
        new("preferences", "Preferences", "Remember your settings like language and display options.", false),
    ];

    private bool _showCustomize = false;
    private string? _consented = null;

    private Dictionary<string, bool> _preferences = new()
    {
        ["necessary"] = true,
        ["analytics"] = false,
        ["marketing"] = false,
        ["preferences"] = false,
    };

    private bool GetPreference(string id) =>
        _preferences.TryGetValue(id, out var val) && val;

    private void ToggleCategory(string id)
    {
        if (_preferences.ContainsKey(id))
            _preferences[id] = !_preferences[id];
    }

    private void HandleCustomizeOrSave()
    {
        if (_showCustomize)
            _consented = "custom";
        else
            _showCustomize = true;
    }
}
