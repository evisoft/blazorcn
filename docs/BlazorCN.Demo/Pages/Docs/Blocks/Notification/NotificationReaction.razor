@* ============================================================
   Block: notification-reaction
   Title: NotificationReaction
   Description: A reaction notification block for React and Next.js with grouped emoji reactions, reactor avatars, reaction counts, and original content preview built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-reaction.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="smile" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Reactions</span>
            </div>
            <span class="text-muted-foreground text-xs">@_originalContent.Timestamp</span>
        </div>

        @* Summary *@
        <div class="border-b px-4 py-3">
            <p class="text-sm">
                <span class="font-medium">@_totalReactions people</span>
                <span class="text-muted-foreground"> reacted to your post</span>
            </p>
        </div>

        @* Reaction groups *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap gap-2">
                @foreach (var grp in _reactionGroups)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 px-2.5 py-1 font-normal text-xs">
                        <LucideIconCn Name="@grp.IconName" Size="14" Class="@Cn.Merge("size-3.5", grp.Color)" />
                        <span class="font-medium tabular-nums">@grp.Count</span>
                    </BadgeCn>
                }
            </div>
        </div>

        @* Reactors by group *@
        <div class="divide-y">
            @foreach (var grp in _reactionGroups)
            {
                <div class="px-4 py-2.5">
                    <div class="flex items-center gap-2.5">
                        <LucideIconCn Name="@grp.IconName" Size="14" Class="@Cn.Merge("size-3.5", grp.Color)" />
                        <div class="flex items-center gap-1.5">
                            @foreach (var reactor in grp.Reactors)
                            {
                                <span class="flex size-5 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground"
                                      title="@reactor.Name">
                                    @reactor.Initials
                                </span>
                            }
                            @if (grp.Count > grp.Reactors.Length)
                            {
                                <span class="text-muted-foreground text-xs">+@(grp.Count - grp.Reactors.Length) more</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Original content preview *@
        <div class="border-t px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <span class="font-medium text-xs">@_originalContent.Title</span>
                <p class="mt-1 line-clamp-2 text-muted-foreground text-xs">
                    @_originalContent.Preview
                </p>
                <span class="mt-1.5 block font-mono text-muted-foreground/50 text-xs">
                    #@_originalContent.Context
                </span>
            </div>
        </div>

        @* Footer *@
        <div class="flex items-center justify-center px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs text-muted-foreground">
                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                View Post
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Reactor(string Name, string Initials);

    private record ReactionGroup(string Id, string Type, string IconName, string Color, int Count, Reactor[] Reactors);

    private record OriginalContent(string Title, string Preview, string Context, string Timestamp);

    private static readonly ReactionGroup[] _reactionGroups =
    [
        new("rg1", "thumbsup", "thumbs-up", "text-blue-500", 5,
        [
            new("Sarah Chen", "SC"),
            new("Alex Rivera", "AR"),
            new("Jordan Park", "JP"),
        ]),
        new("rg2", "heart", "heart", "text-red-500", 3,
        [
            new("Taylor Kim", "TK"),
            new("Morgan Lee", "ML"),
        ]),
        new("rg3", "celebrate", "party-popper", "text-amber-500", 2,
        [
            new("Casey Quinn", "CQ"),
            new("Riley Zhao", "RZ"),
        ]),
    ];

    private static readonly OriginalContent _originalContent = new(
        "Shipped v2.4: Auth refactor and session management",
        "Just merged the auth middleware rewrite. Token refresh now uses sliding window rate limiting, BroadcastChannel for cross-tab sync, and encrypted HttpOnly cookies. Response times dropped from 180ms to 12ms.",
        "engineering-updates",
        "1h ago"
    );

    private static readonly int _totalReactions = _reactionGroups.Sum(g => g.Count);
}
