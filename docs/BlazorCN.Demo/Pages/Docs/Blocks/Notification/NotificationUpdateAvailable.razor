@* ============================================================
   Block: notification-update-available
   Title: NotificationUpdateAvailable
   Description: An app update notification block for React and Next.js with version display, changelog highlights, update and dismiss actions, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-update-available.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="arrow-up-circle" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Update Available</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                v@(_newVersion)
            </BadgeCn>
        </div>

        @* Description *@
        <div class="border-b px-4 py-3">
            <p class="text-sm">
                A new version of Acme is available with performance improvements and new collaboration
                features.
            </p>
            <p class="mt-1 text-muted-foreground text-xs">Current version: v@(_currentVersion)</p>
        </div>

        @* Release notes *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">What&apos;s new</span>
            <div class="mt-2 space-y-2">
                @foreach (var item in _changelog)
                {
                    <div class="flex items-start gap-2.5">
                        <span class="mt-1 flex size-4 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                        </span>
                        <span class="text-sm">@item.Text</span>
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Update Now
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Later
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Updates are applied during a brief restart &middot; No data loss
            </p>
        </div>
    </div>
</section>

@code {
    private const string _currentVersion = "2.3.1";
    private const string _newVersion = "2.4.0";

    private record ChangelogItem(string Id, string Text);

    private static readonly ChangelogItem[] _changelog =
    [
        new("c1", "Real-time collaboration with live cursors and presence indicators"),
        new("c2", "Redesigned dashboard with customizable widget layouts"),
        new("c3", "50% faster page load times with optimized bundle splitting"),
        new("c4", "Fixed session timeout handling for long-running background tasks"),
    ];
}
