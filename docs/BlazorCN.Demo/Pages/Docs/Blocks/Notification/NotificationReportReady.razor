@* ============================================================
   Block: notification-report-ready
   Title: NotificationReportReady
   Description: A report generated notification block for React and Next.js with metric previews, report period, key highlights, and download actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-report-ready.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Monthly report is ready</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your @_reportData.Name for @_reportData.Period has been generated.
            </p>
        </div>

        @* Report info *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Report</span>
                    <p class="mt-0.5 text-sm">@_reportData.Name</p>
                </div>
                <div class="text-right">
                    <span class="font-medium text-muted-foreground text-xs">Period</span>
                    <p class="mt-0.5 text-sm">@_reportData.Period</p>
                </div>
            </div>
            <p class="mt-1 text-muted-foreground text-xs">Generated @_reportData.GeneratedAt</p>
        </div>

        @* Key highlights *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Key Highlights</span>
            <div class="mt-2 grid grid-cols-3 gap-3">
                @foreach (var highlight in _reportData.Highlights)
                {
                    <div class="rounded-md bg-muted/50 p-2.5">
                        <span class="text-muted-foreground text-xs">@highlight.Label</span>
                        <p class="mt-0.5 font-semibold text-sm tabular-nums">@highlight.Value</p>
                        <div class="mt-0.5 flex items-center gap-0.5">
                            @if (highlight.Trend == "up")
                            {
                                <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                            }
                            else
                            {
                                <LucideIconCn Name="arrow-down-right" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                            }
                            <span class="text-emerald-600 text-xs dark:text-emerald-400">@highlight.Change</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">View Report</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                    Download PDF
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Reports generated on the 1st of each month
            </p>
        </div>
    </div>
</section>

@code {
    private record ReportHighlight(string Id, string Label, string Value, string Change, string Trend);

    private record ReportData(string Name, string Period, string GeneratedAt, ReportHighlight[] Highlights);

    private static readonly ReportData _reportData = new(
        "Monthly Performance Report",
        "February 2026",
        "Mar 24, 2026 at 8:00 AM",
        [
            new("h1", "Revenue", "$142,580", "+12.4%", "up"),
            new("h2", "Active Users", "8,431", "+8.2%", "up"),
            new("h3", "Churn Rate", "2.1%", "-0.3%", "down"),
        ]
    );
}
