@* ============================================================
   Block: notification-slide-in
   Title: NotificationSlideIn
   Description: A slide-in notification panel block for React and Next.js with right-side panel animation, notification list, clear all action, and close button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-slide-in.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-lg border bg-card">
        @* Header bar *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Activity</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="@(() => { if (_open) ClosePanel(); else Reset(); })">
                @if (_open)
                {
                    <LucideIconCn Name="bell" Size="12" Class="size-3" />
                    @:Close panel
                }
                else
                {
                    <LucideIconCn Name="bell" Size="12" Class="size-3" />
                    @:Open panel
                }
            </ButtonCn>
        </div>

        @* Content area with slide-in panel *@
        <div class="relative" style="min-height:400px">
            @* Simulated page background *@
            <div class="px-4 py-3">
                <div class="space-y-3">
                    <div class="h-3 w-3/4 rounded bg-muted/40"></div>
                    <div class="h-3 w-full rounded bg-muted/40"></div>
                    <div class="h-3 w-5/6 rounded bg-muted/40"></div>
                    <div class="mt-4 h-16 w-full rounded-md bg-muted/20"></div>
                    <div class="h-3 w-2/3 rounded bg-muted/40"></div>
                    <div class="h-3 w-full rounded bg-muted/40"></div>
                    <div class="h-3 w-4/5 rounded bg-muted/40"></div>
                    <div class="mt-4 h-16 w-full rounded-md bg-muted/20"></div>
                    <div class="h-3 w-3/5 rounded bg-muted/40"></div>
                    <div class="h-3 w-full rounded bg-muted/40"></div>
                </div>
            </div>

            @* Overlay *@
            @if (_open)
            {
                <div class="absolute inset-0 bg-black/10" @onclick="ClosePanel"></div>
            }

            @* Slide-in panel *@
            @if (_open)
            {
                <div class="absolute top-0 right-0 h-full w-80 border-l bg-card">
                    @* Panel header *@
                    <div class="flex items-center justify-between border-b px-3 py-2.5">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">Notifications</span>
                            @if (_unreadCount > 0)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_unreadCount new</BadgeCn>
                            }
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" OnClick="ClosePanel" aria-label="Close notifications panel">
                            <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </div>

                    @* Notification list *@
                    <div class="overflow-y-auto" style="max-height:310px" tabindex="0" role="group" aria-label="Notification list">
                        @foreach (var notification in _notifications)
                        {
                            var item = notification;
                            <div class="@Cn.Merge("flex items-start gap-2.5 border-b px-3 py-2.5 transition-colors hover:bg-muted/50", !item.Read ? "bg-muted/20" : "")">
                                @if (!item.Read)
                                {
                                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                                }
                                else
                                {
                                    <span class="w-1.5 shrink-0"></span>
                                }
                                <LucideIconCn Name="@item.IconName" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <span class="font-medium text-sm leading-tight">@item.Title</span>
                                    <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">@item.Description</p>
                                    <span class="mt-1 block text-muted-foreground/60 text-xs">@item.Time</span>
                                </div>
                            </div>
                        }
                    </div>

                    @* Panel footer *@
                    @if (_unreadCount > 0)
                    {
                        <div class="border-t px-3 py-2.5">
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-full text-xs" OnClick="ClearAll">
                                Mark all as read
                            </ButtonCn>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Panel slides in from the right with backdrop overlay
            </p>
        </div>
    </div>
</section>

@code {
    private record PanelNotification(string Id, string IconName, string Title, string Description, string Time, bool Read);

    private static readonly PanelNotification[] _initialNotifications =
    [
        new("sn1", "git-pull-request", "PR #284 merged", "feat: add notification panel component to blocks library", "3 min ago", false),
        new("sn2", "message-square", "New comment on issue #91", "Alex: The responsive breakpoints need adjustment on the sidebar", "12 min ago", false),
        new("sn3", "credit-card", "Invoice paid", "Stripe payment of $149.00 received from Wavelength Inc.", "1 hr ago", false),
        new("sn4", "mail", "Team invite accepted", "Jordan Lee joined the Engineering workspace", "2 hr ago", true),
        new("sn5", "check-circle-2", "Deploy succeeded", "Production build #1,204 deployed to us-east-1", "5 hr ago", true),
    ];

    private bool _open = true;
    private PanelNotification[] _notifications = _initialNotifications;

    private int _unreadCount => _notifications.Count(n => !n.Read);

    private void ClosePanel() => _open = false;

    private void ClearAll()
    {
        _notifications = _notifications.Select(n => n with { Read = true }).ToArray();
    }

    private void Reset()
    {
        _notifications = _initialNotifications;
        _open = true;
    }
}
