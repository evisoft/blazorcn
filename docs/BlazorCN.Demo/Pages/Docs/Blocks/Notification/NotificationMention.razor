@* ============================================================
   Block: notification-mention
   Title: NotificationMention
   Description: An at-mention notification list block for React and Next.js with channel context, thread preview, view action buttons, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-mention.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="at-sign" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Mentions</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @(_mentions.Count(m => m.Unread)) new
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">@_mentions.Length total</span>
        </div>

        @* Mention list *@
        <div>
            @foreach (var mention in _mentions)
            {
                var isLast = mention.Id == _mentions[_mentions.Length - 1].Id;
                var sourceIconName = mention.SourceType == "channel" ? "hash" : "git-pull-request";
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", mention.Unread ? "bg-muted/20" : "")">
                    @if (mention.Unread)
                    {
                        <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                    }
                    else
                    {
                        <span class="w-1.5 shrink-0"></span>
                    }
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-1.5 text-sm">
                            <span class="font-medium">@mention.Author</span>
                            <span class="text-muted-foreground">@mention.Action</span>
                            <span class="inline-flex items-center gap-1 font-medium">
                                <LucideIconCn Name="@sourceIconName" Size="12" Class="size-3 text-muted-foreground" />
                                @mention.Source
                            </span>
                        </div>
                        <p class="mt-1 text-muted-foreground text-xs leading-relaxed">
                            @mention.Preview
                        </p>
                        <div class="mt-2 flex items-center justify-between">
                            <span class="text-muted-foreground/60 text-xs">@mention.Time</span>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                <LucideIconCn Name="eye" Size="12" Class="size-3" />
                                View
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Mentions from channels and pull requests
            </p>
        </div>
    </div>
</section>

@code {
    private record MentionNotification(string Id, string Author, string Action, string Source, string SourceType, string Preview, string Time, bool Unread);

    private static readonly MentionNotification[] _mentions =
    [
        new("m1", "Sarah Chen", "mentioned you in", "#design", "channel",
            "@you can you review the new dashboard wireframes? I updated the sidebar navigation based on last week's feedback.",
            "5 min ago", true),
        new("m2", "Marcus Rivera", "tagged you in", "PR #142", "pr",
            "@you I added the notification component. Can you check the animation timing and accessibility attributes?",
            "28 min ago", true),
        new("m3", "Elena Kowalski", "mentioned you in", "#engineering", "channel",
            "@you the deployment pipeline is green again. The flaky test was caused by a race condition in the auth module.",
            "1 hr ago", false),
        new("m4", "James Park", "tagged you in", "PR #138", "pr",
            "@you this refactors the payment webhook handler. I split the validation logic into a separate utility.",
            "3 hr ago", false),
    ];
}
