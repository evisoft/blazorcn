@* ============================================================
   Block: notification-reconnected
   Title: NotificationReconnected
   Description: A connection restored notification block for React and Next.js with emerald success indicator, missed notifications count, disconnection duration, auto-dismiss timer, and view missed action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-reconnected.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="wifi" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                <span class="font-medium text-sm">Connection restored</span>
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                You're back online. All pending changes have been synced to the server.
            </p>
        </div>

        @* Status details *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="flex size-5 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                </span>
                <div class="min-w-0 flex-1">
                    <span class="text-sm">All systems operational</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Disconnected for @_disconnectionDuration &middot; 3 changes synced
                    </p>
                </div>
            </div>
        </div>

        @* Missed notifications *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="flex size-5 items-center justify-center rounded-full bg-blue-500/10">
                <LucideIconCn Name="bell" Size="14" Class="size-3.5 text-blue-600 dark:text-blue-400" />
            </span>
            <div class="min-w-0 flex-1">
                <span class="text-sm">@_missedCount missed notifications</span>
                <p class="mt-0.5 text-muted-foreground text-xs">Received while you were offline</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                View missed (@_missedCount)
            </ButtonCn>
        </div>

        @* Auto-dismiss timer *@
        <div class="px-4 py-2.5">
            <div class="mb-2 flex items-center justify-between">
                <p class="text-muted-foreground text-xs">Auto-dismissing in @_dismissSeconds s</p>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">
                    Dismiss
                </ButtonCn>
            </div>
            <div class="h-1 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-emerald-500" style="@($"width:{_progressPercent}%")"></div>
            </div>
        </div>
    </div>
</section>

@code {
    private const int _missedCount = 3;
    private const string _disconnectionDuration = "2m 14s";
    private const int _dismissSeconds = 10;
    private const int _progressPercent = 100;
}
