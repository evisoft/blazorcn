@* ============================================================
   Block: notification-comment
   Title: NotificationComment
   Description: A comment notification list block for React and Next.js with commenter names, comment previews, file context, reply and view actions, and staggered animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-comment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="message-circle" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Comments</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @(_comments.Count(c => c.Unread)) new
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">@_comments.Length total</span>
        </div>

        @* Comment list *@
        <div>
            @foreach (var comment in _comments)
            {
                var isLast = comment.Id == _comments[_comments.Length - 1].Id;
                var contextIconName = comment.ContextType == "file" ? "file-text" : "git-branch";
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", comment.Unread ? "bg-muted/20" : "")">
                    <div class="flex items-start gap-3">
                        @if (comment.Unread)
                        {
                            <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                        }
                        else
                        {
                            <span class="w-1.5 shrink-0"></span>
                        }
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@comment.Author</span>
                                <span class="text-muted-foreground text-xs">commented</span>
                            </div>
                            <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                                @comment.Preview
                            </p>
                            <div class="mt-2 flex items-center gap-1.5 font-mono text-muted-foreground text-xs">
                                <LucideIconCn Name="@contextIconName" Size="12" Class="size-3" />
                                @comment.Context
                            </div>
                            <div class="mt-2 flex items-center justify-between">
                                <span class="text-muted-foreground/60 text-xs">@comment.Time</span>
                                <div class="flex items-center gap-1">
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                        <LucideIconCn Name="reply" Size="12" Class="size-3" />
                                        Reply
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                                        <LucideIconCn Name="eye" Size="12" Class="size-3" />
                                        View
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Comments from files and branch threads
            </p>
        </div>
    </div>
</section>

@code {
    private record CommentNotification(string Id, string Author, string Preview, string Context, string ContextType, string Time, bool Unread);

    private static readonly CommentNotification[] _comments =
    [
        new("c1", "Alex Turner",
            "The border radius on the card component should match the design system tokens. I suggest using rounded-lg instead of rounded-xl.",
            "components/ui/card.tsx", "file", "8 min ago", true),
        new("c2", "Priya Sharma",
            "Good catch on the accessibility issue. I added aria-label to the icon buttons and tested with VoiceOver.",
            "feat/notification-panel", "thread", "34 min ago", true),
        new("c3", "Daniel Kim",
            "The API response time improved by 40% after switching to edge functions. Latency is now under 50ms for the auth endpoint.",
            "app/api/auth/route.ts", "file", "2 hr ago", false),
        new("c4", "Maya Johnson",
            "I moved the validation logic into a shared utility so both the webhook and the checkout flow can reuse it.",
            "fix/payment-validation", "thread", "5 hr ago", false),
    ];
}
