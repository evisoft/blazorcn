@* ============================================================
   Block: notification-referral
   Title: NotificationReferral
   Description: A referral accepted notification block for React and Next.js with user avatar, credit reward display, referral link with copy button, invite CTA, and program stats built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-referral.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="user-plus" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">@_referral.Invitee accepted your invite!</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your referral has signed up and completed onboarding. You have earned a reward.
            </p>
        </div>

        @* Reward *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-emerald-500/10">
                    <LucideIconCn Name="gift" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
                </span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="font-semibold text-sm">$@_referral.Credit credit earned</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Applied</BadgeCn>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        Credit has been applied to your account balance
                    </p>
                </div>
            </div>
        </div>

        @* Referral link *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Your Referral Link</span>
            <div class="mt-1.5 flex items-center gap-2">
                <div class="min-w-0 flex-1 rounded-md bg-muted/50 px-3 py-1.5">
                    <span class="block truncate font-mono text-xs">@_referral.Link</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 px-2 text-xs" OnClick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Invite more CTA *@
        <div class="border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">Invite More Friends</ButtonCn>
        </div>

        @* Referral stats footer *@
        <div class="px-4 py-2.5">
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span>@_referral.TotalReferrals referrals</span>
                <span>&middot;</span>
                <span>$@_referral.TotalCredits earned</span>
                <span>&middot;</span>
                <span>$10 per referral</span>
            </div>
        </div>

    </div>
</section>

@code {
    private record ReferralInfo(string Invitee, int Credit, string Code, string Link, int TotalReferrals, int TotalCredits);

    private static readonly ReferralInfo _referral = new(
        Invitee: "Sarah Chen",
        Credit: 10,
        Code: "REF-7X2KM",
        Link: "app.acme.com/invite/7x2km",
        TotalReferrals: 4,
        TotalCredits: 40
    );

    private bool _copied = false;

    private void HandleCopy()
    {
        _copied = true;
    }
}
