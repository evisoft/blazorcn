@* ============================================================
   Block: notification-quota-exceeded
   Title: NotificationQuotaExceeded
   Description: A quota exceeded notification block for React and Next.js with usage meter, animated progress bar, overage charges breakdown, and upgrade storage action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-quota-exceeded.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="alert-octagon" Size="16" Class="size-4 text-red-600 dark:text-red-400" />
                <span class="font-medium text-sm">Storage quota exceeded</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                You have exceeded your storage limit. Overage charges will apply to your next invoice.
            </p>
        </div>

        @* Usage meter *@
        <div class="border-b px-4 py-3">
            <div class="flex items-baseline justify-between">
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums text-red-600 dark:text-red-400">
                        @_quota.UsedGB GB
                    </span>
                    <span class="text-muted-foreground text-sm">/ @_quota.MaxGB GB</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_percentage% used
                </BadgeCn>
            </div>
            <div class="mt-2.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-red-500" style="width:100%"></div>
            </div>
            <p class="mt-1.5 text-red-600 text-xs dark:text-red-400">
                @_quota.OverageGB GB over your @_quota.Plan plan limit
            </p>
        </div>

        @* Overage details *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Overage Charges</span>
            <div class="mt-2 space-y-1.5">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">Rate per extra GB</span>
                    <span class="font-mono text-sm tabular-nums">$@(_quota.OverageRate.ToString("0.00"))/GB</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-sm">Current overage</span>
                    <span class="font-mono text-sm tabular-nums">@_quota.OverageGB GB</span>
                </div>
                <div class="flex items-center justify-between border-t pt-1.5">
                    <span class="font-medium text-sm">Estimated charge</span>
                    <span class="font-semibold text-sm tabular-nums">$@(_quota.OverageCharge.ToString("0.00"))/mo</span>
                </div>
            </div>
        </div>

        @* Storage breakdown *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="hard-drive" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Largest items</span>
                </div>
                <div class="mt-2 space-y-1">
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Build artifacts</span>
                        <span class="font-mono tabular-nums">5.2 GB</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Docker images</span>
                        <span class="font-mono tabular-nums">4.1 GB</span>
                    </div>
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">Logs and backups</span>
                        <span class="font-mono tabular-nums">3.2 GB</span>
                    </div>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Upgrade Storage</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Delete Files</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Dismiss</ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Charges apply at the end of your billing cycle
            </p>
        </div>

    </div>
</section>

@code {
    private record QuotaInfo(
        double UsedGB,
        double MaxGB,
        double OverageGB,
        double OverageRate,
        double OverageCharge,
        string Plan
    );

    private static readonly QuotaInfo _quota = new(
        UsedGB: 12.5,
        MaxGB: 10,
        OverageGB: 2.5,
        OverageRate: 0.5,
        OverageCharge: 1.25,
        Plan: "Pro"
    );

    private static readonly int _percentage = (int)Math.Round((_quota.UsedGB / _quota.MaxGB) * 100);
}
