@* ============================================================
   Block: notification-error-log
   Title: NotificationErrorLog
   Description: An error log notification block for React and Next.js with severity indicators, error count badge, monospace stack traces, expandable error details, and view logs CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-error-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="alert-circle" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Error Log</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_totalErrors occurrences
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                @_errors.Length distinct errors detected in the last hour. Review critical issues
                first.
            </p>
        </div>

        @* Summary counts *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5">
            @foreach (var sev in _severities)
            {
                var count = 0;
                foreach (var e in _errors) { if (e.Severity == sev) count++; }
                var cfg = _severityConfig[sev];
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", cfg.Dot)"></span>
                    @count @cfg.Label
                </span>
            }
        </div>

        @* Error list *@
        @foreach (var error in _errors)
        {
            var isExpanded = _expanded == error.Id;
            var isLast = error.Id == _errors[_errors.Length - 1].Id;
            var item = error;
            <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                <button type="button"
                        @onclick="@(() => _expanded = (isExpanded ? null : item.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <span class="@Cn.Merge("size-2 shrink-0 rounded-full", _severityConfig[item.Severity].Dot)"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium font-mono text-sm">@item.Message</span>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span class="font-mono">@item.Timestamp</span>
                            <span>&middot;</span>
                            <span>@(item.Occurrences)x</span>
                        </div>
                    </div>
                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>

                @if (isExpanded)
                {
                    <div class="px-4 pb-3 pl-9">
                        <div class="rounded-md bg-zinc-950 p-3">
                            <p class="font-mono text-sm text-zinc-100">@item.StackPreview</p>
                        </div>
                        <div class="mt-2 flex items-center gap-2">
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @_severityConfig[item.Severity].Label
                            </BadgeCn>
                            <span class="text-muted-foreground text-xs">
                                @item.Occurrences occurrences in the last hour
                            </span>
                        </div>
                    </div>
                }
            </div>
        }

        @* Footer CTA *@
        <div class="border-t px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 w-full gap-1.5 text-xs">
                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                View Full Logs
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "1";

    private record ErrorEntry(string Id, string Severity, string Message, string Timestamp, string StackPreview, int Occurrences);
    private record SeverityConfig(string Dot, string Label);

    private static readonly string[] _severities = ["critical", "error", "warning"];

    private static readonly Dictionary<string, SeverityConfig> _severityConfig = new()
    {
        ["critical"] = new SeverityConfig("bg-red-500", "Critical"),
        ["error"]    = new SeverityConfig("bg-amber-500", "Error"),
        ["warning"]  = new SeverityConfig("bg-yellow-500", "Warning"),
    };

    private static readonly ErrorEntry[] _errors =
    [
        new("1", "critical",
            "Unhandled TypeError: Cannot read property 'id' of undefined",
            "14:32:07 UTC",
            "at UserService.getProfile (user-service.ts:47:12)",
            142),
        new("2", "critical",
            "FATAL: connection pool exhausted, max_connections=100",
            "14:28:51 UTC",
            "at PostgresPool.acquire (pool.ts:203:8)",
            89),
        new("3", "error",
            "PaymentProcessingError: Stripe API returned 402",
            "14:15:22 UTC",
            "at StripeClient.createCharge (stripe.ts:118:15)",
            23),
        new("4", "warning",
            "DeprecationWarning: Buffer() is deprecated, use Buffer.alloc()",
            "13:58:03 UTC",
            "at LegacyEncoder.encode (encoder.ts:34:20)",
            7),
    ];

    private static readonly int _totalErrors = _errors.Length > 0
        ? System.Linq.Enumerable.Sum(_errors, e => e.Occurrences)
        : 0;
}
