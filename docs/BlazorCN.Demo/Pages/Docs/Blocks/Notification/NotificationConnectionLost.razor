@* ============================================================
   Block: notification-connection-lost
   Title: NotificationConnectionLost
   Description: A connection lost warning notification block for React and Next.js with red status indicator, reconnection spinner, retry button, last connected timestamp, and troubleshooting tips built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-connection-lost.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="wifi-off" Size="16" Class="size-4 text-red-600 dark:text-red-400" />
                <span class="font-medium text-sm">Connection lost</span>
                <span class="size-1.5 rounded-full bg-red-500"></span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Unable to reach the server. Your changes will be saved locally and synced when the
                connection is restored.
            </p>
        </div>

        @* Reconnection status *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="loader-2" Size="14" Class="size-3.5 shrink-0 animate-spin text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <span class="text-sm">Attempting to reconnect...</span>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Retry attempt 3 of 10 &middot; Next retry in 8s
                </p>
            </div>
        </div>

        @* Connection details *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Last connected</span>
                <span class="text-muted-foreground text-xs">2 min ago</span>
            </div>
            <div class="mt-2 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Disconnected for</span>
                <span class="font-mono text-xs tabular-nums">2m 14s</span>
            </div>
            <div class="mt-2 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Pending changes</span>
                <span class="text-muted-foreground text-xs">3 unsaved</span>
            </div>
        </div>

        @* Troubleshooting tips toggle *@
        <div class="border-b">
            <button
                type="button"
                @onclick="@(() => _showTips = !_showTips)"
                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <span class="flex-1 font-medium text-sm">Troubleshooting tips</span>
                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _showTips ? "rotate-90" : "")" />
            </button>

            @if (_showTips)
            {
                <div class="px-4 pb-3">
                    @foreach (var tip in _tips)
                    {
                        <div class="flex items-center gap-2.5 py-1.5">
                            <span class="size-1 shrink-0 rounded-full bg-muted-foreground/60"></span>
                            <span class="text-muted-foreground text-sm">@tip.Text</span>
                        </div>
                    }
                </div>
            }
        </div>

        @* Actions *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <p class="text-muted-foreground text-xs">Auto-retry enabled</p>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                Retry Now
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private bool _showTips = false;

    private record TroubleshootingTip(string Id, string Text);

    private static readonly TroubleshootingTip[] _tips =
    [
        new("t1", "Check your Wi-Fi or Ethernet connection"),
        new("t2", "Try disabling your VPN or proxy"),
        new("t3", "Clear your browser cache and reload"),
        new("t4", "Contact your network administrator if the issue persists"),
    ];
}
