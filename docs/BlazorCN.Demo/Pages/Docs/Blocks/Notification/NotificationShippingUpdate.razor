@* ============================================================
   Block: notification-shipping-update
   Title: NotificationShippingUpdate
   Description: A shipping update notification block for React and Next.js with tracking number display, multi-step status timeline, estimated delivery date, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-shipping-update.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="package" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Your order has shipped</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your package is on its way and currently in transit to the delivery address.
            </p>
        </div>

        @* Tracking number *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="font-medium text-muted-foreground text-xs">Tracking Number</span>
                <p class="mt-0.5 font-mono text-sm">@_trackingNumber</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                In Transit
            </BadgeCn>
        </div>

        @* Status timeline *@
        <div class="border-b px-4 py-4">
            <div class="flex items-start justify-between">
                @foreach (var step in _steps)
                {
                    var index = Array.IndexOf(_steps, step);
                    var isCompleted = index < _activeStepIndex;
                    var isActive = index == _activeStepIndex;
                    var isFuture = index > _activeStepIndex;
                    <div class="flex flex-1 flex-col items-center gap-1.5">
                        <div class="flex w-full items-center">
                            @if (index > 0)
                            {
                                <div class="h-0.5 flex-1">
                                    <div class="@Cn.Merge("h-full rounded-full", isFuture ? "bg-muted" : "bg-foreground")"></div>
                                </div>
                            }
                            <div class="@Cn.Merge("flex size-6 shrink-0 items-center justify-center rounded-full", (isCompleted || isActive) ? "bg-foreground text-background" : "border bg-muted/50 text-muted-foreground")">
                                @if (isCompleted)
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                                }
                                else if (isActive)
                                {
                                    <span class="size-1.5 animate-pulse rounded-full bg-background"></span>
                                }
                                else
                                {
                                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                                }
                            </div>
                            @if (index < _steps.Length - 1)
                            {
                                <div class="h-0.5 flex-1">
                                    <div class="@Cn.Merge("h-full rounded-full", index < _activeStepIndex ? "bg-foreground" : "bg-muted")"></div>
                                </div>
                            }
                        </div>
                        <span class="@Cn.Merge("text-center text-xs", isActive ? "font-medium" : "text-muted-foreground")">
                            @step.Label
                        </span>
                        <span class="text-center text-muted-foreground text-xs">@step.Date</span>
                    </div>
                }
            </div>
        </div>

        @* Estimated delivery *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Estimated Delivery</span>
            <span class="font-medium text-sm">Tuesday, Mar 25</span>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 w-full text-xs">
                Track Package
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string _trackingNumber = "1Z9R7W046038652147";
    private const int _activeStepIndex = 2;

    private record StepData(string Id, string Label, string Date);

    private static readonly StepData[] _steps =
    [
        new("ordered", "Ordered", "Mar 18"),
        new("shipped", "Shipped", "Mar 20"),
        new("in-transit", "In Transit", "Mar 22"),
        new("delivered", "Delivered", "Mar 25"),
    ];
}
