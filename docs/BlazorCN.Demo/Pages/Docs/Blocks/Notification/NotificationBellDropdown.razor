@* ============================================================
   Block: notification-bell-dropdown
   Title: NotificationBellDropdown
   Description: A bell icon dropdown notification menu block for React and Next.js with unread badge count, notification items with timestamps, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-bell-dropdown.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Bell header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <div class="relative">
                    <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                    @if (_unreadCount > 0)
                    {
                        <span class="absolute -top-1 -right-1 flex size-3.5 items-center justify-center rounded-full bg-foreground text-[10px] text-background tabular-nums">
                            @_unreadCount
                        </span>
                    }
                </div>
                <span class="font-medium text-sm">Notifications</span>
            </div>
            <p class="text-muted-foreground text-xs">@_unreadCount unread</p>
        </div>

        @* Notification list *@
        @foreach (var notification in _notifications)
        {
            var notif = notification;
            var isLast = notif.Id == _notifications[_notifications.Length - 1].Id;
            <button type="button"
                    @onclick="@(() => MarkAsRead(notif.Id))"
                    class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", !isLast ? "border-b" : "")">
                <LucideIconCn Name="@notif.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                <div class="min-w-0 flex-1">
                    <span class="text-sm">@notif.Title</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@notif.Time</p>
                </div>
                @if (!notif.Read)
                {
                    <span class="size-2 shrink-0 rounded-full bg-blue-500"></span>
                }
            </button>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-full text-xs text-muted-foreground">
                See all notifications
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record NotificationItem(string Id, string IconName, string Title, string Time, bool Read);

    private NotificationItem[] _notifications =
    [
        new("1", "message-square", "Sarah Chen commented on your pull request", "2 min ago", false),
        new("2", "user-plus", "Alex Rivera joined your workspace", "15 min ago", false),
        new("3", "git-pull-request", "CI pipeline passed for feature/auth-flow", "1 hour ago", false),
        new("4", "shield-alert", "Unusual login attempt detected from new device", "3 hours ago", true),
        new("5", "star", "Your project reached 1,000 stars on GitHub", "Yesterday", true),
    ];

    private int _unreadCount => _notifications.Count(n => !n.Read);

    private void MarkAsRead(string id)
    {
        _notifications = _notifications
            .Select(n => n.Id == id ? n with { Read = true } : n)
            .ToArray();
    }
}
