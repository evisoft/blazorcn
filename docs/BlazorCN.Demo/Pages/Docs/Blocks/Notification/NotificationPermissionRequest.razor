@* ============================================================
   Block: notification-permission-request
   Title: NotificationPermissionRequest
   Description: A permission request notification block for React and Next.js with stacked permission prompts for camera, location, and microphone access, allow and deny actions, and staggered Framer Motion animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-permission-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Permission Requests</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                The following apps are requesting access to device features. Review each request and
                choose to allow or deny.
            </p>
        </div>

        @* Permission list *@
        <div class="divide-y">
            @foreach (var perm in _permissions)
            {
                var permId = perm.Id;
                var status = _statuses.TryGetValue(permId, out var s) ? s : "pending";
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <span class="mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg bg-muted/50">
                            <LucideIconCn Name="@perm.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@perm.Label access</span>
                                <span class="text-muted-foreground text-xs">
                                    requested by @perm.App
                                </span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@perm.Reason</p>
                            @if (status == "pending")
                            {
                                <div class="mt-2 flex items-center gap-2">
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="@(() => HandleAction(permId, "allowed"))">
                                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                                        Allow
                                    </ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="@(() => HandleAction(permId, "denied"))">
                                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                                        Deny
                                    </ButtonCn>
                                </div>
                            }
                            else
                            {
                                <div class="mt-2 flex items-center gap-1.5">
                                    <span class="@($"size-1.5 rounded-full {(status == "allowed" ? "bg-emerald-500" : "bg-red-500")}")"></span>
                                    <span class="@($"text-xs {(status == "allowed" ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")}")">
                                        @(status == "allowed" ? "Allowed" : "Denied")
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @_pendingCount pending &middot; Manage permissions in Settings
            </p>
        </div>

    </div>
</section>

@code {
    private record PermissionItem(string Id, string IconName, string Label, string App, string Reason);

    private static readonly PermissionItem[] _permissions =
    [
        new("camera",     "camera",    "Camera",    "Video Call",       "Required for video conferencing with your team"),
        new("location",   "map-pin",   "Location",  "Delivery Tracker", "Needed to show nearby pickup locations on the map"),
        new("microphone", "mic",       "Microphone","Voice Notes",      "Used to record audio memos and voice commands"),
    ];

    private Dictionary<string, string> _statuses = new()
    {
        ["camera"]     = "pending",
        ["location"]   = "pending",
        ["microphone"] = "pending",
    };

    private int _pendingCount => _statuses.Values.Count(s => s == "pending");

    private void HandleAction(string id, string action)
    {
        if (_statuses.ContainsKey(id))
            _statuses[id] = action;
    }
}
