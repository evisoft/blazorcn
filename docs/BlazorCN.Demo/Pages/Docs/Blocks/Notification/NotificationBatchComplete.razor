@* ============================================================
   Block: notification-batch-complete
   Title: NotificationBatchComplete
   Description: A batch operation complete notification block for React and Next.js with processed counts, success rate percentage, error summary, duration display, and download report action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-batch-complete.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="layers" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Batch import complete</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your user import has finished processing. Review the results below and download the
                full report.
            </p>
        </div>

        @* Success rate *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl text-emerald-600 tabular-nums dark:text-emerald-400">
                    @_successRate%
                </span>
                <span class="text-muted-foreground text-xs">success rate</span>
            </div>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="text-muted-foreground text-xs">Completed in @_duration</span>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="layers" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">@_totalProcessed.ToString("N0") total</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                <span class="text-muted-foreground text-xs">@_succeeded.ToString("N0") succeeded</span>
            </div>
            <div class="flex items-center gap-1.5">
                <LucideIconCn Name="x-circle" Size="14" Class="size-3.5 text-red-600 dark:text-red-400" />
                <span class="text-muted-foreground text-xs">@_failed failed</span>
            </div>
        </div>

        @* Progress bar *@
        <div class="border-b px-4 py-3">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-emerald-500" style="@($"width:{_successRate}%")"></div>
            </div>
        </div>

        @* Error summary toggle *@
        @if (_failed > 0)
        {
            <div class="border-b">
                <button type="button" @onclick="@(() => _showErrors = !_showErrors)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <span class="size-1.5 shrink-0 rounded-full bg-red-500"></span>
                    <span class="flex-1 font-medium text-sm">@_failed errors found</span>
                    <span class="text-muted-foreground text-xs">@_errors.Length shown</span>
                    <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _showErrors ? "rotate-90" : "")" />
                </button>

                @if (_showErrors)
                {
                    <div class="px-4 pb-3">
                        @foreach (var err in _errors)
                        {
                            <div class="flex items-start gap-2 rounded-md bg-muted/50 p-2.5 [&:not(:last-child)]:mb-2">
                                <span class="mt-1 size-1.5 shrink-0 rounded-full bg-red-500"></span>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="font-mono text-muted-foreground text-xs">Row @err.Row</span>
                                        <span class="text-muted-foreground text-xs">&middot;</span>
                                        <span class="font-mono text-muted-foreground text-xs">@err.Field</span>
                                    </div>
                                    <p class="mt-0.5 text-sm">@err.Message</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @* Actions *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <p class="text-muted-foreground text-xs">Completed at 2:14 PM</p>
            <div class="flex items-center gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="download" Size="12" Class="size-3" />
                    Download Report
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    View Results
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record BatchError(string Id, int Row, string Field, string Message);

    private const int _totalProcessed = 2847;
    private const int _succeeded = 2831;
    private const int _failed = 16;
    private const int _successRate = 99; // Math.Round(2831/2847*100)
    private const string _duration = "3m 42s";

    private bool _showErrors = false;

    private static readonly BatchError[] _errors =
    [
        new("e1", 142,  "email",      "Invalid email format: john@@"),
        new("e2", 587,  "phone",      "Phone number exceeds 15 characters"),
        new("e3", 1203, "email",      "Duplicate entry: sara@@acme.com"),
        new("e4", 1891, "department", "Unknown department: Engineering-V2"),
        new("e5", 2104, "start_date", "Date format invalid: 13/28/2026"),
    ];
}
