@* ============================================================
   Block: notification-stacked
   Title: NotificationStacked
   Description: A stacked notification cards block for React and Next.js with layered depth offset, dismissible front card, scale reduction effect, and stagger reveal built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-stacked.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notifications</span>
                @if (_notifications.Count > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_notifications.Count
                    </BadgeCn>
                }
            </div>
            @if (_notifications.Count == 0)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="Reset">
                    Reset
                </ButtonCn>
            }
        </div>

        @* Stacked cards area *@
        <div class="relative px-4 py-6" style="min-height:180px">
            @if (_notifications.Count == 0)
            {
                <div class="flex flex-col items-center justify-center py-8">
                    <LucideIconCn Name="bell" Size="20" Class="size-5 text-muted-foreground/40" />
                    <p class="mt-2 text-muted-foreground text-sm">All caught up</p>
                </div>
            }
            else
            {
                @foreach (var notification in _notifications)
                {
                    var index = _notifications.IndexOf(notification);
                    var zIndex = _notifications.Count - index;
                    var opacity = index > 2 ? 0.0 : 1.0 - index * 0.15;
                    var translateY = index * 8;
                    var scale = 1.0 - index * 0.04;
                    var cardStyle = $"z-index:{zIndex};opacity:{opacity.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)};transform:translateY({translateY}px) scale({scale.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)});transform-origin:top center;";
                    <div class="absolute inset-x-4 rounded-md border bg-card shadow-sm" style="@cardStyle">
                        <div class="flex items-start gap-3 p-3">
                            <span class="@Cn.Merge("mt-0.5 size-1.5 shrink-0 rounded-full", GetTypeDot(notification.Type))"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <LucideIconCn Name="@notification.IconName" Size="14" Class="size-3.5 text-muted-foreground" />
                                    <span class="font-medium text-sm">@notification.Title</span>
                                </div>
                                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                                    @notification.Message
                                </p>
                                <span class="mt-1.5 block text-muted-foreground/60 text-xs">
                                    @notification.Time
                                </span>
                            </div>
                            @if (index == 0)
                            {
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 shrink-0 p-0" OnClick="Dismiss" aria-label="Dismiss notification">
                                    <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                                </ButtonCn>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Click dismiss to reveal the next notification
            </p>
        </div>
    </div>
</section>

@code {
    private record NotificationItem(string Id, string IconName, string Title, string Message, string Time, string Type);

    private static readonly NotificationItem[] _initialNotifications =
    [
        new("n1", "credit-card",   "Payment received",    "Invoice #1042 for $2,400.00 has been paid by Acme Corp.",                         "2 min ago",  "success"),
        new("n2", "shield-alert",  "New login detected",  "A new sign-in from Chrome on macOS was detected in San Francisco.",                "18 min ago", "warning"),
        new("n3", "bell",          "Deployment complete", "Production deploy #847 finished successfully in 42 seconds.",                       "1 hr ago",   "info"),
    ];

    private List<NotificationItem> _notifications = [.. _initialNotifications];

    private static string GetTypeDot(string notifType) => notifType switch
    {
        "success" => "bg-emerald-500",
        "warning" => "bg-amber-500",
        "info"    => "bg-blue-500",
        _         => "",
    };

    private void Dismiss()
    {
        if (_notifications.Count > 0)
            _notifications.RemoveAt(0);
    }

    private void Reset()
    {
        _notifications = [.. _initialNotifications];
    }
}
