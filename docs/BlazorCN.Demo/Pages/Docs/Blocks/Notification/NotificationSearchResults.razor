@* ============================================================
   Block: notification-search-results
   Title: NotificationSearchResults
   Description: A notification search results block for React and Next.js with borderless search input, highlighted matching text, result count, and empty state built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-search-results.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Search input *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <LucideIconCn Name="search" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <InputCn type="text"
                     Placeholder="Search notifications..."
                     @bind-Value="_query"
                     @bind-Value:event="oninput"
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0"
                     aria-label="Search notifications" />
        </div>

        @* Result count *@
        @if (_hasQuery && _filtered.Length > 0)
        {
            <div class="border-b px-4 py-2">
                <span class="text-muted-foreground text-xs">
                    @_filtered.Length result@(_filtered.Length != 1 ? "s" : "") for &ldquo;@_query&rdquo;
                </span>
            </div>
        }

        @* Results list *@
        <div class="divide-y">
            @foreach (var notif in _filtered)
            {
                var n = notif;
                <div class="flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                    <LucideIconCn Name="@n.IconName" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="text-sm">@((MarkupString)HighlightMatch(n.Title, _query))</span>
                        <p class="mt-0.5 truncate text-muted-foreground text-xs">@((MarkupString)HighlightMatch(n.Description, _query))</p>
                    </div>
                    <span class="shrink-0 text-muted-foreground text-xs">@n.Timestamp</span>
                </div>
            }
        </div>

        @* Empty state *@
        @if (_hasQuery && _filtered.Length == 0)
        {
            <div class="px-4 py-8 text-center">
                <LucideIconCn Name="inbox" Size="20" Class="mx-auto size-5 text-muted-foreground/40" />
                <p class="mt-2 text-muted-foreground text-sm">
                    No notifications match &ldquo;@_query&rdquo;
                </p>
                <p class="mt-1 text-muted-foreground/60 text-xs">Try a different search term</p>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @_allNotifications.Length notifications total
            </p>
        </div>
    </div>
</section>

@code {
    private record Notification(string Id, string IconName, string Title, string Description, string Timestamp);

    private static readonly Notification[] _allNotifications =
    [
        new("n1", "zap",              "Production deploy v2.4.1 succeeded",    "Deployed to production cluster in 47 seconds.",            "2 min ago"),
        new("n2", "message-square",   "Sarah commented on deploy pipeline",      "Looks good, but can we add a rollback step?",              "15 min ago"),
        new("n3", "git-pull-request", "PR #142 ready for review",                "Auth refactor with deploy hooks integration.",              "1 hour ago"),
        new("n4", "shield-alert",     "Security scan completed",                 "No vulnerabilities found in latest deploy build.",          "3 hours ago"),
        new("n5", "user-plus",        "Alex Rivera joined the workspace",        "Accepted invitation to join the Engineering team.",         "5 hours ago"),
        new("n6", "file-text",        "Monthly invoice generated",               "March 2026 billing invoice is ready to download.",          "1 day ago"),
        new("n7", "zap",              "Staging deploy failed",                   "Build error in checkout-flow branch. Check logs.",          "2 days ago"),
    ];

    private string _query = "";

    private bool _hasQuery => _query.Trim().Length > 0;

    private Notification[] _filtered => _hasQuery
        ? _allNotifications.Where(n =>
            n.Title.Contains(_query, StringComparison.OrdinalIgnoreCase) ||
            n.Description.Contains(_query, StringComparison.OrdinalIgnoreCase)).ToArray()
        : _allNotifications;

    private static string HighlightMatch(string text, string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return System.Net.WebUtility.HtmlEncode(text);
        var lowerText = text.ToLowerInvariant();
        var lowerQuery = query.ToLowerInvariant();
        var index = lowerText.IndexOf(lowerQuery, StringComparison.Ordinal);
        if (index == -1) return System.Net.WebUtility.HtmlEncode(text);

        var before = System.Net.WebUtility.HtmlEncode(text[..index]);
        var match  = System.Net.WebUtility.HtmlEncode(text.Substring(index, query.Length));
        var after  = System.Net.WebUtility.HtmlEncode(text[(index + query.Length)..]);

        return $"{before}<span class=\"rounded-sm bg-foreground/10 font-medium\">{match}</span>{after}";
    }
}
