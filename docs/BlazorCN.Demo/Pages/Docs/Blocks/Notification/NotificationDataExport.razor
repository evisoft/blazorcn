@* ============================================================
   Block: notification-data-export
   Title: NotificationDataExport
   Description: A data export ready notification block for React and Next.js with file details, download button, export summary, and expiry countdown built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-data-export.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="download" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Your export is ready</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your data export has been generated and is available for download.
            </p>
        </div>

        @* File details *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="flex size-9 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucideIconCn Name="file-spreadsheet" Size="16" Class="size-4 text-muted-foreground" />
                </span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="truncate font-medium font-mono text-xs">
                            @($"{_export.FileName}.{_export.Format.ToLower()}")
                        </span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_export.Format</BadgeCn>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_export.FileSize &middot; Generated @_export.GeneratedAt
                    </p>
                </div>
            </div>
        </div>

        @* Export summary *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Export Summary</span>
            <div class="mt-1.5 flex items-center gap-4">
                <div>
                    <span class="font-semibold text-sm tabular-nums">@_export.Rows.ToString("N0")</span>
                    <span class="ml-1 text-muted-foreground text-xs">rows</span>
                </div>
                <span class="text-muted-foreground">&middot;</span>
                <div>
                    <span class="font-semibold text-sm tabular-nums">@_export.Columns</span>
                    <span class="ml-1 text-muted-foreground text-xs">columns</span>
                </div>
            </div>
        </div>

        @* Download action *@
        <div class="border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full gap-1.5 text-xs">
                <LucideIconCn Name="download" Size="12" Class="size-3" />
                Download Export
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Available for @_export.ExpiresIn &middot; Link expires automatically
            </p>
        </div>
    </div>
</section>

@code {
    private record ExportData(string FileName, string FileSize, string Format, int Rows, int Columns, string GeneratedAt, string ExpiresIn);

    private readonly ExportData _export = new(
        "contacts-export-2026-03-24",
        "4.2 MB",
        "CSV",
        24831,
        18,
        "Mar 24, 2026 at 3:42 PM",
        "7 days"
    );
}
