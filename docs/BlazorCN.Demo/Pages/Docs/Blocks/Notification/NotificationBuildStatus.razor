@* ============================================================
   Block: notification-build-status
   Title: NotificationBuildStatus
   Description: A build status notification block for React and Next.js with CI/CD pipeline tracking, branch names, commit messages, build duration, and status indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-build-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="git-branch" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Build Status</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Recent CI/CD pipeline runs. Monitor test results, build health, and pipeline
                performance.
            </p>
        </div>

        @* Summary bar *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">@_builds.Length builds</span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @(_builds.Count(b => b.Status == "success")) passed
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @(_builds.Count(b => b.Status == "failed")) failed
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @(_builds.Count(b => b.Status == "running")) running
                </span>
            </div>
        </div>

        @* Build list *@
        <div>
            @foreach (var build in _builds)
            {
                var item = build;
                var isExpanded = _expanded == item.Id;
                var isLast = item.Id == _builds[_builds.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = isExpanded ? null : item.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {StatusDotClass(item.Status)}")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="truncate font-medium text-sm">@item.CommitMessage</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs">@item.Branch</span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="font-mono text-muted-foreground text-xs">@item.CommitHash</span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="tabular-nums text-muted-foreground text-xs">@item.Duration</span>
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">@StatusLabel(item.Status)</BadgeCn>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <p class="mb-3 text-muted-foreground text-sm leading-relaxed">@item.Description</p>
                            <div class="mb-3 rounded-md bg-muted/50 p-3">
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">Pipeline</span>
                                        <p class="text-xs">@item.Pipeline</p>
                                    </div>
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">Author</span>
                                        <p class="font-mono text-xs">@item.Author</p>
                                    </div>
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">Duration</span>
                                        <p class="font-mono text-xs tabular-nums">@item.Duration</p>
                                    </div>
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">Triggered</span>
                                        <p class="text-xs">@item.Timestamp</p>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View Logs</ButtonCn>
                                @if (item.Status == "failed")
                                {
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Retry Build</ButtonCn>
                                }
                                @if (item.Status == "running")
                                {
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Cancel</ButtonCn>
                                }
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">View Commit</ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Showing last 24 hours &middot; 5 of 34 builds
            </p>
        </div>
    </div>
</section>

@code {
    private record Build(
        string Id,
        string Status,
        string Branch,
        string CommitHash,
        string CommitMessage,
        string Duration,
        string Timestamp,
        string Author,
        string Description,
        string Pipeline
    );

    private static readonly Build[] _builds =
    [
        new("1", "success", "main", "a3f8c2d",
            "fix: resolve cart total calculation rounding error",
            "3m 24s", "12 min ago", "sarah.chen",
            "All 847 tests passed. Linting clean with zero warnings. TypeScript compilation successful. Bundle size: 248 KB (gzipped), within budget. Coverage: 94.2%.",
            "CI / Build & Test"),
        new("2", "failed", "feature/billing-portal", "e7b1f09",
            "feat: add organization billing portal with usage charts",
            "2m 08s", "28 min ago", "alex.rivera",
            "Build failed at test step. 3 of 847 tests failed in billing.test.ts: createSubscription expected status 201 but received 400. Linting passed. TypeScript compilation passed.",
            "CI / Build & Test"),
        new("3", "running", "fix/auth-timeout", "c4d9b71",
            "fix: increase session token refresh timeout to 30s",
            "1m 42s", "2 min ago", "maria.garcia",
            "Build in progress. Step 3 of 5: running test suite. 612 of 847 tests completed. No failures so far. Estimated time remaining: 1m 30s.",
            "CI / Build & Test"),
        new("4", "success", "main", "f8e2a16",
            "chore: update dependencies and lock file",
            "4m 11s", "1 hr ago", "james.wilson",
            "All tests passed after dependency update. No breaking changes detected. Bundle size increased by 2.1 KB due to updated date-fns package. Security audit: 0 vulnerabilities.",
            "CI / Build & Test"),
        new("5", "cancelled", "refactor/auth-sa", "b2c7d84",
            "refactor: migrate authentication flow to server actions",
            "0m 45s", "2 hr ago", "maria.garcia",
            "Build cancelled by user after 45 seconds. A newer commit was pushed to the same branch, superseding this run. Resources released.",
            "CI / Build & Test"),
    ];

    private string? _expanded = "2";

    private static string StatusDotClass(string status) => status switch
    {
        "success" => "bg-emerald-500",
        "failed" => "bg-red-500",
        "running" => "bg-amber-500",
        _ => "bg-muted-foreground",
    };

    private static string StatusLabel(string status) => status switch
    {
        "success" => "Passed",
        "failed" => "Failed",
        "running" => "Running",
        _ => "Cancelled",
    };
}
