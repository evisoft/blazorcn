@* ============================================================
   Block: notification-onboarding-step
   Title: NotificationOnboardingStep
   Description: An onboarding step notification block for React and Next.js with progress dots, step description, complete and skip actions, and next step preview built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-onboarding-step.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">
                    Step @(_currentStep + 1) of @(_steps.Length): @(_stepDetail.Title)
                </span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Complete each step to finish setting up your workspace.
            </p>
        </div>

        @* Progress dots *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            @foreach (var step in _steps)
            {
                var idx = Array.IndexOf(_steps, step);
                <div class="flex items-center gap-2">
                    @if (step.Completed)
                    {
                        <span class="flex size-5 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check-circle" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                        </span>
                    }
                    else if (idx == _currentStep)
                    {
                        <span class="flex size-5 items-center justify-center rounded-full bg-foreground/10 ring-1 ring-foreground/20">
                            <LucideIconCn Name="circle" Size="12" Class="size-3 text-foreground" />
                        </span>
                    }
                    else
                    {
                        <span class="flex size-5 items-center justify-center rounded-full bg-muted">
                            <LucideIconCn Name="circle" Size="12" Class="size-3 text-muted-foreground/40" />
                        </span>
                    }
                    @if (idx < _steps.Length - 1)
                    {
                        <div class="@Cn.Merge("h-px w-4", step.Completed ? "bg-emerald-500/40" : "bg-muted")"></div>
                    }
                </div>
            }
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">
                @(_steps.Count(s => s.Completed)) of @(_steps.Length) done
            </BadgeCn>
        </div>

        @* Step description *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-muted/50">
                    <LucideIconCn Name="git-branch" Size="20" Class="size-5 text-muted-foreground" />
                </span>
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">@_stepDetail.Title</span>
                    <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                        @_stepDetail.Description
                    </p>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                Complete Step
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">
                Skip
            </ButtonCn>
        </div>

        @* Next step preview *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Up next</span>
            <div class="mt-1.5 flex items-center gap-2">
                <span class="size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                <span class="text-sm">@_nextStep.Title</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">@_nextStep.Description</span>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                You can complete these steps later from Settings
            </p>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Id, string Title, bool Completed);
    private record StepDetail(string Title, string Description);
    private record NextStepItem(string Title, string Description);

    private static readonly StepItem[] _steps =
    [
        new("1", "Create your workspace", true),
        new("2", "Connect your repository", false),
        new("3", "Invite team members", false),
        new("4", "Configure CI/CD pipeline", false),
        new("5", "Deploy your first project", false),
    ];

    private const int _currentStep = 1;

    private static readonly StepDetail _stepDetail = new(
        "Connect your repository",
        "Link a GitHub, GitLab, or Bitbucket repository to start building. We will detect your framework and configure build settings automatically."
    );

    private static readonly NextStepItem _nextStep = new(
        "Invite team members",
        "Add collaborators to your workspace"
    );
}
