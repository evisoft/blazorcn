@* ============================================================
   Block: notification-deadline
   Title: NotificationDeadline
   Description: A deadline approaching notification block for React and Next.js with countdown urgency, animated progress bar, task completion tracking, and assigned team members built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-deadline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="clock" Size="16" Class="size-4 text-amber-500" />
                    <span class="font-medium text-sm">Deadline in @_task.TimeLeft</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="border-amber-200 bg-amber-500/10 font-normal text-amber-600 text-xs dark:border-amber-800 dark:text-amber-400">
                    Urgent
                </BadgeCn>
            </div>
            <p class="mt-1.5 font-medium text-sm">@_task.Title</p>
            <p class="mt-0.5 text-muted-foreground text-sm">
                @_task.Project &middot; Due @_task.Deadline
            </p>
        </div>

        @* Progress *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Progress</span>
                <span class="font-semibold text-sm tabular-nums">@_task.Progress%</span>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-amber-500" style="@($"width:{_task.Progress}%")"></div>
            </div>
            <div class="mt-1.5 flex items-center gap-2 text-muted-foreground text-xs">
                <span>@_completedCount of @_task.Subtasks.Length subtasks complete</span>
            </div>
        </div>

        @* Subtasks *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Subtasks</span>
            <ul class="mt-2 space-y-1.5">
                @foreach (var subtask in _task.Subtasks)
                {
                    <li class="flex items-center gap-2 text-sm">
                        <span class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full", subtask.Done ? "bg-emerald-500/10" : "bg-muted")">
                            @if (subtask.Done)
                            {
                                <LucideIconCn Name="flag" Size="10" Class="size-2.5 text-emerald-600 dark:text-emerald-400" />
                            }
                        </span>
                        <span class="@(subtask.Done ? "text-muted-foreground line-through" : "")">@subtask.Label</span>
                    </li>
                }
            </ul>
        </div>

        @* Assigned team *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Assigned to</span>
            <div class="mt-2 flex items-center gap-2">
                @foreach (var member in _task.Assignees)
                {
                    <div class="flex items-center gap-1.5">
                        <span class="@Cn.Merge("flex size-6 items-center justify-center rounded-full text-white text-xs", member.Color)"
                              role="img"
                              aria-label="@member.Name">
                            @member.Initials
                        </span>
                        <span class="text-sm">@member.Name</span>
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">View Task</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 text-xs">Request Extension</ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Last updated 5 min ago &middot; Linear
            </p>
        </div>
    </div>
</section>

@code {
    private record SubtaskData(string Id, string Label, bool Done);
    private record TeamMemberData(string Id, string Name, string Initials, string Color);
    private record DeadlineTaskData(
        string Title,
        string Project,
        string Deadline,
        string TimeLeft,
        int Progress,
        SubtaskData[] Subtasks,
        TeamMemberData[] Assignees
    );

    private static readonly DeadlineTaskData _task = new(
        Title: "Finalize Q2 marketing campaign assets",
        Project: "Marketing / Q2 Launch",
        Deadline: "Mar 24, 2026 at 5:00 PM",
        TimeLeft: "2 hours",
        Progress: 65,
        Subtasks:
        [
            new("s1", "Banner creatives for paid channels", true),
            new("s2", "Email template HTML and copy", true),
            new("s3", "Social media post variations", true),
            new("s4", "Landing page hero section", false),
            new("s5", "Final stakeholder review and sign-off", false),
        ],
        Assignees:
        [
            new("1", "Alex Rivera", "AR", "bg-blue-500"),
            new("2", "Jordan Lee", "JL", "bg-emerald-500"),
            new("3", "Casey Morgan", "CM", "bg-purple-500"),
        ]
    );

    private static readonly int _completedCount = _task.Subtasks.Count(s => s.Done);
}
