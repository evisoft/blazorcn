@* ============================================================
   Block: notification-task-assigned
   Title: NotificationTaskAssigned
   Description: A task assignment notification block for React and Next.js with task title, priority badge, due date, assigner info, and accept actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-task-assigned.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="clipboard-check" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">New task assigned to you</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                You have been assigned a new task. Review the details and accept to start working on
                it.
            </p>
        </div>

        @* Task details *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start justify-between gap-3">
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">@_task.Title</span>
                    <p class="mt-1 line-clamp-2 text-muted-foreground text-xs">@_task.Description</p>
                </div>
                <div class="flex shrink-0 items-center gap-1.5">
                    <span class="@($"size-1.5 rounded-full {_priority.DotColor}")"></span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_priority.Label</BadgeCn>
                </div>
            </div>
        </div>

        @* Metadata *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="calendar-days" Size="14" Class="size-3.5" />
                    <span>Due @_task.DueDate</span>
                </div>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <span class="text-muted-foreground text-xs">@_task.Project</span>
            </div>
        </div>

        @* Assigner *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2.5">
                <div class="flex size-7 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                </div>
                <div>
                    <span class="font-medium text-sm">@_task.AssignerName</span>
                    <p class="text-muted-foreground text-xs">@_task.AssignerRole</p>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">Accept</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">View Task</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record TaskData(
        string Title,
        string Description,
        string Priority,
        string DueDate,
        string AssignerName,
        string AssignerRole,
        string Project
    );

    private record PriorityConfig(string DotColor, string Label);

    private static readonly TaskData _task = new(
        Title: "Implement user onboarding flow",
        Description: "Build the multi-step onboarding wizard with profile setup, team invitation, and workspace configuration screens. Include progress indicator and skip functionality.",
        Priority: "high",
        DueDate: "Mar 28, 2026",
        AssignerName: "Elena Martinez",
        AssignerRole: "Engineering Lead",
        Project: "Web Platform"
    );

    private static readonly Dictionary<string, PriorityConfig> _priorityConfigs = new()
    {
        ["high"]   = new PriorityConfig("bg-red-500",   "High"),
        ["medium"] = new PriorityConfig("bg-amber-500", "Medium"),
        ["low"]    = new PriorityConfig("bg-blue-500",  "Low"),
    };

    private PriorityConfig _priority => _priorityConfigs.TryGetValue(_task.Priority, out var cfg)
        ? cfg
        : new PriorityConfig("bg-muted-foreground", _task.Priority);
}
