@* ============================================================
   Block: notification-storage-warning
   Title: NotificationStorageWarning
   Description: A storage quota warning notification block for React and Next.js with animated progress bar, file type breakdown, usage meter, and manage storage and upgrade actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-storage-warning.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="hard-drive" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Storage almost full</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your workspace is running low on storage. Free up space or upgrade your plan to avoid
                upload failures.
            </p>
        </div>

        @* Usage meter *@
        <div class="border-b px-4 py-3">
            <div class="flex items-baseline justify-between">
                <span class="font-semibold text-2xl tabular-nums">@_storage.UsedGb GB</span>
                <span class="text-muted-foreground text-xs">of @_storage.TotalGb GB used</span>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-red-500" style="@($"width:{_percentage}%")"></div>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-red-600 text-xs dark:text-red-400">@_percentage% full</span>
                <span class="text-muted-foreground text-xs">
                    @((_storage.TotalGb - _storage.UsedGb).ToString("0.0")) GB remaining
                </span>
            </div>
        </div>

        @* File type breakdown *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Storage breakdown</span>
            <div class="mt-2 space-y-2">
                @foreach (var ft in _fileTypes)
                {
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@($"size-1.5 shrink-0 rounded-full {ft.Color}")"></span>
                            <LucideIconCn Name="@ft.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="text-sm">@ft.Label</span>
                        </div>
                        <span class="font-medium text-xs tabular-nums">@ft.Size</span>
                    </div>
                }
            </div>
        </div>

        @* Actions *@
        <div class="border-b flex items-center gap-2 px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">
                Manage Storage
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 gap-1.5 text-xs">
                Upgrade Plan
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Pro plans include 100 GB storage
            </p>
        </div>

    </div>
</section>

@code {
    private record FileTypeInfo(string Icon, string Label, string Size, string Color);

    private record StorageInfo(double UsedGb, double TotalGb);

    private static readonly StorageInfo _storage = new(UsedGb: 9.2, TotalGb: 10);

    private static readonly int _percentage = (int)Math.Round((_storage.UsedGb / _storage.TotalGb) * 100);

    private static readonly FileTypeInfo[] _fileTypes =
    [
        new("image", "Images", "4.1 GB", "bg-blue-500"),
        new("file-text", "Documents", "2.8 GB", "bg-emerald-500"),
        new("video", "Videos", "1.7 GB", "bg-amber-500"),
        new("file", "Other files", "0.6 GB", "bg-muted-foreground"),
    ];
}
