@* ============================================================
   Block: notification-toast-loading
   Title: NotificationToastLoading
   Description: A loading progress toast notification block for React and Next.js with spinner animation, progress percentage, animated progress bar, and multi-state transitions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-toast-loading.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="upload" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Progress Notifications</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Loading and progress states with spinners, percentage tracking, and completion
                transitions.
            </p>
        </div>

        @* Toast stack *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-3">
                @foreach (var toast in _toasts)
                {
                    <div class="overflow-hidden rounded-md border bg-background"
                         role="status"
                         aria-live="polite">
                        <div class="flex items-start gap-3 px-3 py-2.5">

                            @* State icon *@
                            @if (toast.State == "loading")
                            {
                                <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center">
                                    <LucideIconCn Name="loader" Size="16" Class="size-4 animate-spin text-muted-foreground" />
                                </span>
                            }
                            else if (toast.State == "progress")
                            {
                                <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center">
                                    <LucideIconCn Name="upload" Size="14" Class="size-3.5 text-blue-600 dark:text-blue-400" />
                                </span>
                            }
                            else
                            {
                                <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                    <LucideIconCn Name="check-circle" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                                </span>
                            }

                            <div class="min-w-0 flex-1">
                                <div class="flex items-center justify-between gap-2">
                                    <span class="font-medium text-sm">@toast.Title</span>
                                    @if (toast.State == "progress")
                                    {
                                        <span class="font-semibold text-sm tabular-nums">@(toast.Progress)%</span>
                                    }
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs">@toast.Detail</p>

                                @* Progress bar for loading and progress states *@
                                @if (toast.State != "complete")
                                {
                                    <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                        @if (toast.State == "loading")
                                        {
                                            <div class="h-full w-[40%] rounded-full bg-muted-foreground/40 animate-[slide-indeterminate_1.5s_ease-in-out_infinite]"
                                                 style="animation: slide-indeterminate 1.5s ease-in-out infinite; --tw-translate-x: -100%; transform: translateX(var(--progress-x, -100%))">
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="h-full rounded-full bg-blue-500"
                                                 style="@($"width:{toast.Progress}%")">
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span>1 loading</span>
                <span>&middot;</span>
                <span>1 in progress</span>
                <span>&middot;</span>
                <span>1 complete</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record LoadingToast(string Id, string Title, string Detail, string State, int Progress);

    private static readonly LoadingToast[] _toasts =
    [
        new("l1", "Analyzing repository", "Scanning dependencies and checking for vulnerabilities...", "loading", 0),
        new("l2", "Uploading quarterly-report.pdf", "14.2 MB of 18.6 MB uploaded", "progress", 76),
        new("l3", "Data import complete", "Successfully imported 2,847 records from contacts.csv", "complete", 100),
    ];
}
