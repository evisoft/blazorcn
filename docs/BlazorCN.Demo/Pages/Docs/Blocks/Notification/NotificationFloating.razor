@* ============================================================
   Block: notification-floating
   Title: NotificationFloating
   Description: A floating notification popup block for React and Next.js with bottom-right slide-in animation, icon badge, action button, and dismiss control built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-floating.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notification Preview</span>
            </div>
            @if (!_visible)
            {
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs" OnClick="@(() => _visible = true)">
                    Show again
                </ButtonCn>
            }
        </div>

        @* Simulated page content area *@
        <div class="relative px-4 py-3" style="min-height:280px">
            <div class="space-y-3">
                <div class="h-3 w-3/4 rounded bg-muted/50"></div>
                <div class="h-3 w-full rounded bg-muted/50"></div>
                <div class="h-3 w-5/6 rounded bg-muted/50"></div>
                <div class="h-3 w-2/3 rounded bg-muted/50"></div>
                <div class="mt-4 h-24 w-full rounded-md bg-muted/30"></div>
                <div class="h-3 w-4/5 rounded bg-muted/50"></div>
                <div class="h-3 w-full rounded bg-muted/50"></div>
            </div>

            @* Floating notification popup *@
            @if (_visible)
            {
                <div class="absolute right-4 bottom-4 w-72 rounded-md border bg-card shadow-lg" role="alert">
                    <div class="p-3">
                        <div class="flex items-start gap-2.5">
                            <div class="relative mt-0.5 shrink-0">
                                <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
                                <span class="-top-0.5 -right-0.5 absolute size-2 rounded-full bg-blue-500"></span>
                            </div>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-start justify-between gap-2">
                                    <span class="font-medium text-sm leading-tight">@_notification.Title</span>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 shrink-0 p-0" OnClick="@(() => _visible = false)" aria-label="Dismiss notification">
                                        <LucideIconCn Name="x" Size="12" Class="size-3" />
                                    </ButtonCn>
                                </div>
                                <p class="mt-1 text-muted-foreground text-xs leading-relaxed">@_notification.Message</p>
                                <div class="mt-2.5 flex items-center justify-between">
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">@_notification.Action</ButtonCn>
                                    <span class="text-muted-foreground/60 text-xs">@_notification.Time</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">Popup notification anchored to bottom-right corner</p>
        </div>

    </div>
</section>

@code {
    private record FloatingNotification(string Id, string Title, string Message, string Action, string Time);

    private static readonly FloatingNotification _notification = new(
        "fn1",
        "New message from Sarah Chen",
        "Hey, I just pushed the updated designs for the dashboard. Can you review the layout changes when you get a chance?",
        "View message",
        "Just now"
    );

    private bool _visible = true;
}
