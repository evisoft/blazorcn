@* ============================================================
   Block: notification-activity-feed
   Title: NotificationActivityFeed
   Description: A vertical timeline activity feed block for React and Next.js with colored dot indicators, actor names, timestamps, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-activity-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="activity" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Activity Feed</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Live
            </BadgeCn>
        </div>

        @* Timeline *@
        <div class="relative">
            @* Vertical line *@
            <div class="absolute top-0 bottom-0 left-[29px] w-px bg-border"></div>

            @foreach (var activity in _activities)
            {
                var cfg = GetConfig(activity.Type);
                <div class="relative flex items-start gap-3 px-4 py-3">
                    @* Timeline dot *@
                    <div class="relative z-10 flex size-4 shrink-0 items-center justify-center">
                        <span class="@Cn.Merge("size-2.5 rounded-full", cfg.DotColor)"></span>
                    </div>

                    @* Content *@
                    <div class="min-w-0 flex-1">
                        <div class="flex items-baseline gap-1.5">
                            <LucideIconCn Name="@cfg.IconName" Size="14" Class="@Cn.Merge("mt-0.5 size-3.5 shrink-0", cfg.IconColor)" />
                            <p class="text-sm">
                                <span class="font-medium">@activity.Actor</span>
                                <span class="text-muted-foreground"> @activity.Description</span>
                            </p>
                        </div>
                        <div class="ml-5 mt-1 flex items-center gap-2">
                            <span class="text-muted-foreground/60 text-xs">@activity.Timestamp</span>
                            @if (activity.Detail != null)
                            {
                                <span class="text-muted-foreground/40">&middot;</span>
                                <span class="font-mono text-muted-foreground text-xs">@activity.Detail</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Showing recent activity &middot; View full audit log
            </p>
        </div>
    </div>
</section>

@code {
    private record Activity(string Id, string Type, string Actor, string Description, string Timestamp, string? Detail = null);

    private record ActivityConfig(string IconName, string DotColor, string IconColor);

    private static readonly Activity[] _activities =
    [
        new("a1", "user_joined",      "Emma Chen",      "joined the Engineering workspace",                  "12m ago"),
        new("a2", "file_uploaded",    "Marcus Rivera",  "uploaded design-system-v3.fig to the Design folder","34m ago", "14.2 MB"),
        new("a3", "comment_added",    "Priya Sharma",   "commented on Pull Request #287",                    "1h ago",  "auth-refactor"),
        new("a4", "deployment",       "CI Pipeline",    "deployed v2.8.0 to production",                     "2h ago",  "47s build time"),
        new("a5", "payment",          "Billing System", "processed monthly subscription renewal",             "5h ago",  "$39.00"),
        new("a6", "settings_changed", "Jordan Lee",     "updated two-factor authentication settings",         "1d ago"),
    ];

    private static ActivityConfig GetConfig(string type) => type switch
    {
        "user_joined"      => new("user-plus",     "bg-emerald-500", "text-emerald-600 dark:text-emerald-400"),
        "file_uploaded"    => new("file-up",       "bg-blue-500",    "text-blue-600 dark:text-blue-400"),
        "comment_added"    => new("message-square","bg-amber-500",   "text-amber-600 dark:text-amber-400"),
        "deployment"       => new("rocket",        "bg-violet-500",  "text-violet-600 dark:text-violet-400"),
        "payment"          => new("credit-card",   "bg-emerald-500", "text-emerald-600 dark:text-emerald-400"),
        "settings_changed" => new("settings",      "bg-foreground/50","text-muted-foreground"),
        _                  => new("activity",      "bg-foreground/50","text-muted-foreground"),
    };
}
