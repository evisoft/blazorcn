@* ============================================================
   Block: notification-toast-stack
   Title: NotificationToastStack
   Description: A stacked toast notification block for React and Next.js with success, error, warning, and info variants, dismiss actions, and entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-toast-stack.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="font-medium text-sm">Notifications</span>
            </div>
            <span class="text-muted-foreground text-xs">@_toasts.Count active</span>
        </div>

        @* Toast list *@
        <div class="divide-y">
            @foreach (var t in _toasts)
            {
                var toast = t;
                <div class="flex items-start gap-3 px-4 py-3">
                    <span class="@Cn.Merge("mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full", GetBgClass(toast.Type))">
                        <LucideIconCn Name="@GetIconName(toast.Type)" Size="14" Class="@("size-3.5 " + GetIconColor(toast.Type))" />
                    </span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@toast.Title</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@toast.Message</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 shrink-0 p-0 text-muted-foreground" OnClick="@(() => Dismiss(toast.Id))" aria-label="Dismiss notification">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            }

            @if (_toasts.Count == 0)
            {
                <div class="px-4 py-6 text-center">
                    <p class="text-muted-foreground text-sm">No active notifications</p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Toasts auto-dismiss after 5 seconds
            </p>
        </div>

    </div>
</section>

@code {
    private enum ToastType { Success, Error, Warning, Info }

    private record Toast(string Id, ToastType Type, string Title, string Message);

    private static readonly Toast[] _initialToasts =
    [
        new("t1", ToastType.Success, "Deployment complete",        "Your application was deployed to production successfully."),
        new("t2", ToastType.Error,   "Build failed",               "Module not found: ./components/Header. Check your imports."),
        new("t3", ToastType.Warning, "API rate limit approaching",  "You have used 85% of your monthly API quota."),
        new("t4", ToastType.Info,    "Scheduled maintenance",       "Database maintenance is planned for Saturday 2:00 AM UTC."),
    ];

    private List<Toast> _toasts = [.. _initialToasts];

    private void Dismiss(string id)
    {
        _toasts = _toasts.Where(t => t.Id != id).ToList();
    }

    private static string GetIconName(ToastType type) => type switch
    {
        ToastType.Success => "check-circle-2",
        ToastType.Error   => "x-circle",
        ToastType.Warning => "alert-triangle",
        _                 => "info",
    };

    private static string GetIconColor(ToastType type) => type switch
    {
        ToastType.Success => "text-emerald-600 dark:text-emerald-400",
        ToastType.Error   => "text-red-600 dark:text-red-400",
        ToastType.Warning => "text-amber-600 dark:text-amber-400",
        _                 => "text-blue-600 dark:text-blue-400",
    };

    private static string GetBgClass(ToastType type) => type switch
    {
        ToastType.Success => "bg-emerald-500/10",
        ToastType.Error   => "bg-red-500/10",
        ToastType.Warning => "bg-amber-500/10",
        _                 => "bg-blue-500/10",
    };
}
