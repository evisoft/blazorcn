@* ============================================================
   Block: notification-security-alert
   Title: NotificationSecurityAlert
   Description: A security alert notification block for React and Next.js with suspicious login detection, device tracking, IP geolocation display, and actionable response buttons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-security-alert.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="shield-alert" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Security Alerts</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Recent security events across your organization. Review and take action on suspicious
                activity.
            </p>
        </div>

        @* Summary bar *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">@_alerts.Length events</span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_countCritical
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_countWarning
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_countInfo
                </span>
            </div>
        </div>

        @* Alert list *@
        <div>
            @for (int i = 0; i < _alerts.Length; i++)
            {
                var alert = _alerts[i];
                var isExpanded = _expanded == alert.Id;
                var isLast = i == _alerts.Length - 1;
                var alertId = alert.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = (isExpanded ? null : alertId))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {SeverityDot(alert.Severity)}")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@alert.Title</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="truncate font-mono text-muted-foreground text-xs">@alert.Ip</span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="truncate text-muted-foreground text-xs">@alert.Location</span>
                            </div>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">@alert.Timestamp</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <p class="mb-3 text-muted-foreground text-sm leading-relaxed">@alert.Description</p>
                            <div class="mb-3 rounded-md bg-muted/50 p-3">
                                <div class="flex items-center gap-4">
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">IP Address</span>
                                        <p class="font-mono text-xs">@alert.Ip</p>
                                    </div>
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">Location</span>
                                        <p class="text-xs">@alert.Location</p>
                                    </div>
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">Device</span>
                                        <p class="text-xs">@alert.Device</p>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Take Action</ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View Full Log</ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Dismiss</ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Showing last 24 hours &middot; 5 of 23 events
            </p>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "2";

    private record SecurityAlert(
        string Id,
        string Severity,
        string Title,
        string Ip,
        string Location,
        string Timestamp,
        string Description,
        string Device
    );

    private static readonly SecurityAlert[] _alerts =
    [
        new("1", "critical", "API key exposed in public repository",
            "—", "GitHub / acme-corp/frontend", "3 min ago",
            "Production API key sk_live_••••4f2a was detected in a public commit on GitHub. The key has read/write access to the payments API. Immediate rotation recommended.",
            "GitHub Secret Scanning"),
        new("2", "critical", "Suspicious login from unrecognized location",
            "185.243.115.42", "Moscow, Russia", "18 min ago",
            "Login attempt for admin@acme.com from an IP address not previously associated with this account. The location is 6,400 km from the last known login in San Francisco, CA. Login was blocked by geo-restriction policy.",
            "Chrome 124 on Windows 11"),
        new("3", "warning", "New device added to account",
            "72.134.89.201", "Austin, TX, US", "2 hr ago",
            "A new device was authenticated and added to the trusted devices list for sarah@acme.com. Two-factor authentication was verified via authenticator app.",
            "Safari 18 on macOS Sequoia"),
        new("4", "warning", "Password changed via account recovery",
            "98.45.67.123", "San Francisco, CA, US", "4 hr ago",
            "Password was reset using the account recovery flow for dev@acme.com. Recovery email was sent to d••@gmail.com. Previous sessions were invalidated.",
            "Firefox 130 on Ubuntu"),
        new("5", "info", "Two-factor authentication enabled",
            "10.0.1.45", "Office network / San Francisco", "6 hr ago",
            "TOTP-based two-factor authentication was enabled for mark@acme.com using an authenticator app. Backup codes were generated and downloaded.",
            "Chrome 124 on macOS Sequoia"),
    ];

    private static readonly int _countCritical = _alerts.Count(a => a.Severity == "critical");
    private static readonly int _countWarning = _alerts.Count(a => a.Severity == "warning");
    private static readonly int _countInfo = _alerts.Count(a => a.Severity == "info");

    private static string SeverityDot(string severity) => severity switch
    {
        "critical" => "bg-red-500",
        "warning" => "bg-amber-500",
        "info" => "bg-blue-500",
        _ => ""
    };
}
