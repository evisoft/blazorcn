@* ============================================================
   Block: notification-changelog
   Title: NotificationChangelog
   Description: A changelog notification block for React and Next.js with versioned entries, feature and fix badges, descriptions, and view full changelog link built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-changelog.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">What&apos;s New</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                v@(_version)
            </BadgeCn>
        </div>

        @* Description *@
        <div class="border-b px-4 py-3">
            <p class="text-muted-foreground text-sm">
                Here is a summary of the latest changes shipped in version @_version. Check the full
                changelog for detailed release notes.
            </p>
        </div>

        @* Changelog entries *@
        <div>
            @foreach (var entry in _entries)
            {
                var cfg = _badgeConfig[entry.Type];
                <div class="border-b px-4 py-3">
                    <div class="flex items-center gap-2">
                        <BadgeCn Variant="BadgeVariant.Outline" Class="@Cn.Merge("font-normal text-xs", cfg.ClassName)">
                            @cfg.Label
                        </BadgeCn>
                        <span class="font-medium text-sm">@entry.Title</span>
                    </div>
                    <p class="mt-1 text-muted-foreground text-sm">@entry.Description</p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-center">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    View full changelog
                    <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private const string _version = "2.4.0";

    private enum EntryType { New, Improved, Fixed }

    private record ChangelogEntry(string Id, EntryType Type, string Title, string Description);

    private record BadgeConfig(string Label, string ClassName);

    private static readonly ChangelogEntry[] _entries =
    [
        new("e1", EntryType.New, "Real-time collaboration",
            "Work together with live cursors, presence indicators, and instant sync across all connected users."),
        new("e2", EntryType.New, "Custom dashboard widgets",
            "Drag-and-drop widget builder with 12 prebuilt templates for analytics, charts, and activity feeds."),
        new("e3", EntryType.Improved, "Search performance",
            "Full-text search is now 3x faster with fuzzy matching and typo tolerance across all content types."),
        new("e4", EntryType.Fixed, "Session persistence",
            "Resolved an issue where long-running background tasks could cause unexpected session timeouts."),
    ];

    private static readonly Dictionary<EntryType, BadgeConfig> _badgeConfig = new()
    {
        [EntryType.New] = new BadgeConfig("New",
            "border-emerald-200 bg-emerald-500/10 text-emerald-700 dark:border-emerald-800 dark:text-emerald-400"),
        [EntryType.Improved] = new BadgeConfig("Improved",
            "border-blue-200 bg-blue-500/10 text-blue-700 dark:border-blue-800 dark:text-blue-400"),
        [EntryType.Fixed] = new BadgeConfig("Fixed",
            "border-amber-200 bg-amber-500/10 text-amber-700 dark:border-amber-800 dark:text-amber-400"),
    };
}
