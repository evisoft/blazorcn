@* ============================================================
   Block: notification-subscription-renewed
   Title: NotificationSubscriptionRenewed
   Description: A subscription renewal confirmation notification block for React and Next.js with payment details, plan summary, next renewal date, and view invoice and manage plan actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-subscription-renewed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                <span class="font-medium text-sm">Subscription renewed</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your subscription has been successfully renewed. Thank you for your continued support.
            </p>
        </div>

        @* Payment summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-baseline justify-between">
                <div>
                    <span class="font-medium text-sm">@_renewal.PlanName</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_renewal.BillingCycle billing</p>
                </div>
                <span class="font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">@_renewal.Amount</span>
            </div>
        </div>

        @* Details *@
        <div class="border-b px-4 py-3">
            <div class="space-y-2.5">
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Payment method</span>
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="credit-card" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="font-medium text-xs">@_renewal.PaymentMethod **** @_renewal.LastFour</span>
                    </div>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Next renewal</span>
                    <span class="font-medium text-xs">@_renewal.NextRenewal</span>
                </div>
                <div class="flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Invoice</span>
                    <span class="font-medium font-mono text-xs">@_renewal.InvoiceId</span>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="border-b flex items-center gap-2 px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 flex-1 gap-1.5 text-xs">
                <LucideIconCn Name="file-text" Size="12" Class="size-3" />
                View Invoice
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 flex-1 gap-1.5 text-xs">
                <LucideIconCn Name="settings" Size="12" Class="size-3" />
                Manage Plan
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                A receipt has been sent to your email
            </p>
        </div>

    </div>
</section>

@code {
    private record RenewalData(
        string PlanName,
        string Amount,
        string BillingCycle,
        string NextRenewal,
        string PaymentMethod,
        string LastFour,
        string InvoiceId
    );

    private static readonly RenewalData _renewal = new(
        PlanName: "Pro Individual",
        Amount: "$39.00",
        BillingCycle: "Monthly",
        NextRenewal: "Apr 24, 2026",
        PaymentMethod: "Visa",
        LastFour: "4242",
        InvoiceId: "INV-2026-0324"
    );
}
