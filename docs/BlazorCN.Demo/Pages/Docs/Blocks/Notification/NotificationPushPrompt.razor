@* ============================================================
   Block: notification-push-prompt
   Title: NotificationPushPrompt
   Description: A push notification permission prompt block for React and Next.js with benefits list, allow and dismiss actions, and AnimatePresence transitions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-push-prompt.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @if (!_dismissed)
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Enable Notifications</span>
                </div>
                <p class="mt-1 text-muted-foreground text-sm">
                    Stay in the loop with real-time updates about your projects, team activity, and
                    system alerts.
                </p>
            </div>

            @* Benefits list *@
            <div class="border-b px-4 py-3">
                <div class="space-y-2.5">
                    @foreach (var benefit in _benefits)
                    {
                        <div class="flex items-center gap-2.5">
                            <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                            </span>
                            <span class="text-sm">@benefit</span>
                        </div>
                    }
                </div>
            </div>

            @* Permission rationale *@
            <div class="border-b px-4 py-3">
                <p class="text-muted-foreground text-xs">
                    We only send notifications you care about. You can customize which alerts you
                    receive in your notification preferences at any time.
                </p>
            </div>

            @* Actions *@
            <div class="flex items-center gap-2 px-4 py-3">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">Allow Notifications</ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs" OnClick="@Dismiss">Not Now</ButtonCn>
            </div>
        </div>
    }
    else
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Notifications Skipped</span>
                </div>
                <p class="mt-1 text-muted-foreground text-sm">
                    No problem. You can enable notifications anytime from your account settings.
                </p>
            </div>
        </div>
    }
</section>

@code {
    private bool _dismissed = false;

    private static readonly string[] _benefits =
    [
        "Get notified when teammates mention you",
        "Receive alerts for critical system events",
        "Stay updated on deployment status changes",
    ];

    private void Dismiss()
    {
        _dismissed = true;
    }
}
