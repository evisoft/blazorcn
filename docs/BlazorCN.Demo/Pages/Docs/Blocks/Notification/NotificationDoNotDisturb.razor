@* ============================================================
   Block: notification-do-not-disturb
   Title: NotificationDoNotDisturb
   Description: A Do Not Disturb mode block for React and Next.js with DND toggle, schedule presets for 1 hour and until tomorrow, allowed exceptions list, and active status badge built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-do-not-disturb.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="moon" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Do Not Disturb</span>
                @if (_dndEnabled)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Active</BadgeCn>
                }
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Pause all notifications temporarily. Set a schedule and choose which exceptions are
                allowed through.
            </p>
        </div>

        @* DND toggle *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="@($"size-2 shrink-0 rounded-full {(_dndEnabled ? "bg-amber-500" : "bg-muted-foreground/30")}")"></span>
                <div>
                    <span class="font-medium text-sm">Enable DND</span>
                    <p class="text-muted-foreground text-xs">
                        @if (_dndEnabled)
                        {
                            @if (_selectedSchedule != null)
                            {
                                @($"Active — {_scheduleOptions.FirstOrDefault(s => s.Id == _selectedSchedule)?.Label}")
                            }
                            else
                            {
                                @("Active — No schedule set")
                            }
                        }
                        else
                        {
                            @("Notifications are flowing normally")
                        }
                    </p>
                </div>
            </div>
            <SwitchCn Checked="@_dndEnabled" CheckedChanged="@((bool _) => ToggleDnd())" aria-label="Toggle Do Not Disturb" />
        </div>

        @* Schedule options *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Schedule</span>
            <div class="mt-2 space-y-1">
                @foreach (var opt in _scheduleOptions)
                {
                    var option = opt;
                    var isSelected = _selectedSchedule == option.Id;
                    <button type="button"
                            class="@Cn.Merge("flex w-full items-center gap-3 rounded-md px-3 py-2 text-left transition-colors", isSelected ? "bg-muted/80" : "hover:bg-muted/50")"
                            @onclick="@(() => SelectSchedule(option.Id))">
                        <LucideIconCn Name="@option.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm">@option.Label</span>
                            <p class="text-muted-foreground text-xs">@option.Description</p>
                        </div>
                        @if (isSelected)
                        {
                            <LucideIconCn Name="check" Size="14" Class="size-3.5 text-foreground" />
                        }
                    </button>
                }
            </div>
        </div>

        @* Allowed exceptions *@
        <div class="border-b">
            <div class="flex items-center gap-2 px-4 pt-3 pb-1">
                <LucideIconCn Name="shield" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Allowed Exceptions</span>
            </div>
            @foreach (var exc in _exceptions)
            {
                var exception = exc;
                <div class="flex items-center justify-between px-4 py-2">
                    <div>
                        <span class="text-sm">@exception.Label</span>
                        <p class="text-muted-foreground text-xs">@exception.Description</p>
                    </div>
                    <SwitchCn Size="SwitchSize.Sm" Checked="@exception.Enabled" CheckedChanged="@((bool _) => ToggleException(exception.Id))" aria-label="@($"Toggle {exception.Label}")" />
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @_activeExceptions exception@(_activeExceptions != 1 ? "s" : "") allowed through DND
            </p>
        </div>

    </div>
</section>

@code {
    private record ScheduleOption(string Id, string Label, string Description, string Icon);
    private record ExceptionRule(string Id, string Label, string Description, bool Enabled);

    private static readonly ScheduleOption[] _scheduleOptions =
    [
        new("1h", "For 1 hour", "Until 3:30 PM", "clock"),
        new("tomorrow", "Until tomorrow", "Until 9:00 AM", "sunrise"),
        new("custom", "Custom", "Set your own schedule", "timer"),
    ];

    private bool _dndEnabled = false;
    private string? _selectedSchedule = null;

    private List<ExceptionRule> _exceptions =
    [
        new("urgent", "Urgent messages only", "Allow messages marked as urgent", true),
        new("contacts", "Starred contacts", "Allow messages from starred people", false),
        new("calls", "Repeated calls", "Allow if someone calls twice in 3 minutes", true),
    ];

    private int _activeExceptions => _exceptions.Count(e => e.Enabled);

    private void ToggleDnd()
    {
        _dndEnabled = !_dndEnabled;
        if (!_dndEnabled)
        {
            _selectedSchedule = null;
        }
    }

    private void SelectSchedule(string id)
    {
        _selectedSchedule = id;
        _dndEnabled = true;
    }

    private void ToggleException(string id)
    {
        _exceptions = _exceptions
            .Select(e => e.Id == id ? e with { Enabled = !e.Enabled } : e)
            .ToList();
    }
}
