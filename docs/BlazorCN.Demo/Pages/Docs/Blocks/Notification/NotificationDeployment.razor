@* ============================================================
   Block: notification-deployment
   Title: NotificationDeployment
   Description: A deployment status notification block for React and Next.js with environment badges, commit hash tracking, build time display, and rollback controls built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-deployment.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="rocket" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Deployments</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Recent deployments across all environments. Monitor build progress and deployment
                health.
            </p>
        </div>

        @* Summary bar *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">@_deployments.Length deploys</span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-red-500"></span>1 failed
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-amber-500"></span>1 building
            </span>
        </div>

        @* Deployment list *@
        <div>
            @foreach (var deploy in _deployments)
            {
                var item = deploy;
                var isExpanded = _expanded == item.Id;
                var isLast = item.Id == _deployments[_deployments.Length - 1].Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = isExpanded ? null : item.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {StatusDotClass(item.Status)}")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">@item.CommitMessage</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs">@item.CommitHash</span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="text-muted-foreground text-xs">@item.Branch</span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="text-muted-foreground text-xs">@item.BuildTime</span>
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">@EnvLabel(item.Environment)</BadgeCn>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <p class="mb-3 text-muted-foreground text-sm leading-relaxed">@item.Description</p>
                            <div class="mb-3 rounded-md bg-muted/50 p-3">
                                <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">Status</span>
                                        <p class="text-xs">@StatusLabel(item.Status)</p>
                                    </div>
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">Author</span>
                                        <p class="font-mono text-xs">@item.Author</p>
                                    </div>
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">Build Time</span>
                                        <p class="font-mono text-xs tabular-nums">@item.BuildTime</p>
                                    </div>
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">Time</span>
                                        <p class="text-xs">@item.Timestamp</p>
                                    </div>
                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View Logs</ButtonCn>
                                @if (item.Status == "deployed" && item.Environment == "production")
                                {
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Rollback</ButtonCn>
                                }
                                @if (item.Status == "failed")
                                {
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Retry Deploy</ButtonCn>
                                }
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">View Commit</ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Showing last 24 hours &middot; 5 of 18 deployments
            </p>
        </div>
    </div>
</section>

@code {
    private record Deployment(
        string Id,
        string Status,
        string Environment,
        string CommitHash,
        string CommitMessage,
        string Branch,
        string BuildTime,
        string Timestamp,
        string Author,
        string Description
    );

    private static readonly Deployment[] _deployments =
    [
        new("1", "deployed", "production", "a3f8c2d",
            "fix: resolve cart total calculation rounding error",
            "main", "1m 42s", "8 min ago", "sarah.chen",
            "Production deployment completed successfully. All health checks passed. 3 serverless functions updated. Edge network propagation completed in 12 seconds across 24 regions."),
        new("2", "building", "staging", "e7b1f09",
            "feat: add organization billing portal with usage charts",
            "feature/billing-portal", "0m 58s", "2 min ago", "alex.rivera",
            "Build in progress. Installing dependencies and compiling TypeScript. 847 modules transformed. Current step: generating static pages (34/120)."),
        new("3", "failed", "production", "9d4e6a1",
            "chore: upgrade database driver to v5.2",
            "main", "2m 15s", "45 min ago", "james.wilson",
            "Deployment failed during database migration step. Error: relation 'user_preferences' already exists. Automatic rollback triggered. Previous stable version restored in 8 seconds."),
        new("4", "deployed", "preview", "b2c7d84",
            "refactor: migrate authentication flow to server actions",
            "refactor/auth-sa", "1m 18s", "1 hr ago", "maria.garcia",
            "Preview deployment ready. Authentication flow migrated to Next.js server actions. Session handling moved from client-side cookies to server-side tokens. Preview URL generated."),
        new("5", "rolled-back", "production", "f1a9c3e",
            "perf: enable edge runtime for API routes",
            "main", "1m 31s", "3 hr ago", "sarah.chen",
            "Manual rollback initiated after edge runtime caused 502 errors on payment webhook endpoint. Reverted to previous deployment c8d2f1a. Incident reported in status page."),
    ];

    private string? _expanded = "3";

    private static string StatusDotClass(string status) => status switch
    {
        "deployed" => "bg-emerald-500",
        "building" => "bg-amber-500",
        "failed" => "bg-red-500",
        _ => "bg-muted-foreground",
    };

    private static string StatusLabel(string status) => status switch
    {
        "deployed" => "Deployed",
        "building" => "Building",
        "failed" => "Failed",
        _ => "Rolled back",
    };

    private static string EnvLabel(string env) => env switch
    {
        "production" => "Production",
        "staging" => "Staging",
        _ => "Preview",
    };
}
