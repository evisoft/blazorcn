@* ============================================================
   Block: notification-password-expiry
   Title: NotificationPasswordExpiry
   Description: A password expiry warning notification block for React and Next.js with countdown indicator, security recommendations, strength meter, and change password CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-password-expiry.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="key" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Password Expiring</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your password expires in @_daysRemaining days. Update it now to maintain access to
                your account.
            </p>
        </div>

        @* Strength indicator *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">
                    Current password strength
                </span>
                <span class="text-amber-600 text-xs dark:text-amber-400">Moderate</span>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-amber-500" style="@($"width:{_strengthPercentage}%")"></div>
            </div>
            <p class="mt-1.5 text-muted-foreground text-xs">Last changed: @_lastChanged</p>
        </div>

        @* Recommendations *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">
                Security recommendations
            </span>
            <div class="mt-2 space-y-2">
                @foreach (var rec in _recommendations)
                {
                    <div class="flex items-center gap-2.5">
                        <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                        </span>
                        <span class="text-sm">@rec.Label</span>
                    </div>
                }
            </div>
        </div>

        @* CTA *@
        <div class="px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">Change Password</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Recommendation(string Id, string Label);

    private const int _strengthPercentage = 62;
    private const int _daysRemaining = 7;
    private const string _lastChanged = "Jan 12, 2026";

    private static readonly Recommendation[] _recommendations =
    [
        new("r1", "Use at least 12 characters"),
        new("r2", "Include uppercase and lowercase letters"),
        new("r3", "Add numbers and special characters"),
    ];
}
