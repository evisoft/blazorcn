@* ============================================================
   Block: notification-api-error
   Title: NotificationApiError
   Description: An API error notification block for React and Next.js with monospace status code display, endpoint URL, request ID, occurrence count, and retry action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-api-error.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="alert-circle" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">API Errors</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_errors.Length endpoints affected
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Multiple API endpoints are returning errors. Review each error and retry or escalate
                as needed.
            </p>
        </div>

        @* Error entries *@
        @foreach (var error in _errors)
        {
            var isLast = error.Id == _errors[_errors.Length - 1].Id;
            <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                @* Status code and endpoint *@
                <div class="flex items-center gap-2">
                    <span class="@Cn.Merge("font-mono font-semibold text-sm tabular-nums", StatusColor(error.StatusCode))">
                        @error.StatusCode
                    </span>
                    <span class="truncate font-mono text-muted-foreground text-xs">
                        @error.Endpoint
                    </span>
                </div>

                @* Error message *@
                <p class="mt-1 font-mono text-sm">@error.Message</p>

                @* Metadata *@
                <div class="mt-1.5 flex flex-wrap items-center gap-2 text-muted-foreground text-xs">
                    <span class="font-mono">@error.RequestId</span>
                    <span>&middot;</span>
                    <span class="font-mono">@error.Timestamp</span>
                    <span>&middot;</span>
                    <span>@error.Occurrences@("x") in the last hour</span>
                </div>

                @* Actions *@
                <div class="mt-2 flex items-center gap-2">
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                        View Logs
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                        Retry
                    </ButtonCn>
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                182 total errors in the last hour &middot; 3 endpoints affected
            </p>
        </div>
    </div>
</section>

@code {
    private record ApiError(string Id, int StatusCode, string Endpoint, string RequestId, string Message, int Occurrences, string Timestamp);

    private static readonly ApiError[] _errors =
    [
        new("1", 500, "POST /api/v2/payments/charge", "req_8f2a4b1c9d3e",
            "Internal Server Error: database connection timeout after 30000ms", 47, "14:32:07 UTC"),
        new("2", 502, "GET /api/v2/users/profile", "req_3c7e9a2f1b8d",
            "Bad Gateway: upstream service returned invalid response", 23, "14:28:51 UTC"),
        new("3", 429, "POST /api/v2/webhooks/dispatch", "req_5d1f8e4a2c6b",
            "Too Many Requests: rate limit exceeded, retry after 60s", 112, "14:15:22 UTC"),
    ];

    private static string StatusColor(int code)
    {
        if (code >= 500) return "text-red-600 dark:text-red-400";
        if (code >= 400) return "text-amber-600 dark:text-amber-400";
        return "text-muted-foreground";
    }
}
