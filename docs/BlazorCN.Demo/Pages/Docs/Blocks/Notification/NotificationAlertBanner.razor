@* ============================================================
   Block: notification-alert-banner
   Title: NotificationAlertBanner
   Description: A dismissible alert banner notification block for React and Next.js with info, warning, error, and success variants, action buttons, and smooth exit animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-alert-banner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="triangle-alert" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">System Alerts</span>
            </div>
            <span class="text-muted-foreground text-xs">@_banners.Count active</span>
        </div>

        @* Banners *@
        <div class="divide-y">
            @foreach (var banner in _banners)
            {
                var cfg = GetConfig(banner.Variant);
                var bid = banner.Id;
                <div class="@Cn.Merge("flex items-start gap-3 border-l-2 px-4 py-3", cfg.BorderColor, cfg.BgColor)">
                    <LucideIconCn Name="@cfg.IconName" Size="16" Class="@Cn.Merge("mt-0.5 size-4 shrink-0", cfg.IconColor)" />
                    <div class="min-w-0 flex-1">
                        <p class="@Cn.Merge("text-sm", cfg.TextColor)">@banner.Message</p>
                        @if (banner.Action != null)
                        {
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="mt-1.5 h-7 px-2 text-xs">
                                @banner.Action
                            </ButtonCn>
                        }
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 shrink-0 p-0 text-muted-foreground" OnClick="@(() => Dismiss(bid))" aria-label="Dismiss alert">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            }
            @if (_banners.Count == 0)
            {
                <div class="px-4 py-6 text-center">
                    <p class="text-muted-foreground text-sm">No active alerts</p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Alerts persist until dismissed or resolved
            </p>
        </div>
    </div>
</section>

@code {
    private record Banner(string Id, string Variant, string Message, string? Action);

    private record VariantConfig(string IconName, string BorderColor, string BgColor, string IconColor, string TextColor);

    private List<Banner> _banners =
    [
        new("b1", "info",    "A new version of the CLI is available. Update to v3.2.0 for improved performance.", "Update now"),
        new("b2", "warning", "Your API key expires in 3 days. Rotate it to avoid service interruption.",          "Rotate key"),
        new("b3", "error",   "Payment failed for invoice #INV-2026-0342. Please update your billing method.",    "Update billing"),
        new("b4", "success", "Database migration completed successfully. All 14 tables updated without downtime.", null),
    ];

    private static VariantConfig GetConfig(string variant) => variant switch
    {
        "info"    => new("info",           "border-l-blue-500",    "bg-blue-500/5",    "text-blue-600 dark:text-blue-400",       "text-blue-900 dark:text-blue-100"),
        "warning" => new("triangle-alert", "border-l-amber-500",   "bg-amber-500/5",   "text-amber-600 dark:text-amber-400",     "text-amber-900 dark:text-amber-100"),
        "error"   => new("x-circle",       "border-l-red-500",     "bg-red-500/5",     "text-red-600 dark:text-red-400",         "text-red-900 dark:text-red-100"),
        "success" => new("check-circle-2", "border-l-emerald-500", "bg-emerald-500/5", "text-emerald-600 dark:text-emerald-400", "text-emerald-900 dark:text-emerald-100"),
        _         => new("info",           "border-l-blue-500",    "bg-blue-500/5",    "text-blue-600 dark:text-blue-400",       "text-blue-900 dark:text-blue-100"),
    };

    private void Dismiss(string id)
    {
        _banners = _banners.Where(b => b.Id != id).ToList();
    }
}
