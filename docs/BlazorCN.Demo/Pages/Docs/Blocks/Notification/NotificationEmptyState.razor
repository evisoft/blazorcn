@* ============================================================
   Block: notification-empty-state
   Title: NotificationEmptyState
   Description: An empty notifications state block for React and Next.js with caught-up message, muted illustration area, settings link, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-empty-state.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="bell-off" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Notifications</span>
        </div>

        @* Empty state content *@
        <div class="border-b px-4 py-10 text-center">
            @* Illustration area *@
            <div class="mx-auto flex size-16 items-center justify-center rounded-full bg-muted/50">
                <LucideIconCn Name="inbox" Size="28" Class="size-7 text-muted-foreground/50" />
            </div>

            @* Message *@
            <div>
                <h3 class="mt-4 font-medium text-sm">You're all caught up</h3>
                <p class="mx-auto mt-1.5 max-w-xs text-muted-foreground text-sm">
                    No new notifications. We'll let you know when something needs your attention.
                </p>
            </div>
        </div>

        @* Suggestion *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="settings" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">
                        Notification settings
                    </span>
                </div>
                <p class="mt-1 text-muted-foreground/80 text-xs">
                    Adjust which events trigger notifications and how they are delivered to your inbox.
                </p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-2 h-7 gap-1.5 text-xs">
                    <LucideIconCn Name="settings" Size="12" Class="size-3" />
                    Manage preferences
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                0 notifications &middot; All read
            </p>
        </div>
    </div>
</section>
