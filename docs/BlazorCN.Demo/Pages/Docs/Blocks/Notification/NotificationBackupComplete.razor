@* ============================================================
   Block: notification-backup-complete
   Title: NotificationBackupComplete
   Description: A backup complete notification block for React and Next.js with success indicator, backup size, duration, storage location, and next scheduled time built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-backup-complete.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="database" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Backup completed successfully</span>
                <span class="flex size-4 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="check-circle" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                </span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                A full database backup has been created and stored securely.
            </p>
        </div>

        @* Backup stats *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-6">
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Size</span>
                    <p class="mt-0.5 font-semibold text-sm tabular-nums">@_backup.Size</p>
                </div>
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Duration</span>
                    <p class="mt-0.5 font-semibold text-sm tabular-nums">@_backup.Duration</p>
                </div>
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Completed</span>
                    <p class="mt-0.5 text-sm">@_backup.CompletedAt</p>
                </div>
            </div>
        </div>

        @* Storage location *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Storage Location</span>
            <div class="mt-1.5 flex items-center gap-2">
                <LucideIconCn Name="hard-drive" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-mono text-xs">@_backup.StorageLocation</span>
            </div>
        </div>

        @* Next backup + actions *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-muted-foreground text-xs">
                        Next scheduled backup
                    </span>
                    <p class="mt-0.5 text-sm">@_backup.NextBackup</p>
                </div>
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View Backups</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Restore</ButtonCn>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Automated daily backups &middot; 30-day retention
            </p>
        </div>
    </div>
</section>

@code {
    private record BackupData(string Status, string Size, string Duration, string CompletedAt, string StorageLocation, string NextBackup);

    private readonly BackupData _backup = new(
        "complete",
        "2.8 GB",
        "4m 23s",
        "Mar 24, 2026 at 3:00 AM",
        "us-east-1 / prod-backups-v2",
        "Mar 25, 2026 at 3:00 AM"
    );
}
