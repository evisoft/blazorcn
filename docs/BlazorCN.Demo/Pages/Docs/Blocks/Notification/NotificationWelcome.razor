@* ============================================================
   Block: notification-welcome
   Title: NotificationWelcome
   Description: A welcome onboarding notification block for React and Next.js with getting started checklist, progress indicator, animated progress bar, and setup CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-welcome.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Welcome to Acme!</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Get started by completing these steps. You can finish them in any order at your own
                pace.
            </p>
        </div>

        @* Progress *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Setup progress</span>
                <span class="font-medium text-xs tabular-nums">
                    @_completed.Count/@_steps.Length complete
                </span>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-foreground transition-all duration-700"
                     style="@($"width:{Progress}%")"></div>
            </div>
        </div>

        @* Checklist *@
        <div class="border-b">
            @foreach (var step in _steps)
            {
                var item = step;
                var isLast = Array.IndexOf(_steps, item) == _steps.Length - 1;
                var isChecked = _completed.Contains(item.Id);
                <label for="@($"nw-step-{item.Id}")"
                       class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <CheckboxCn id="@($"nw-step-{item.Id}")" Checked="@isChecked"
                                CheckedChanged="@((bool _) => ToggleStep(item.Id))"
                                aria-label="@item.Label" Class="mt-0.5" />
                    <div class="min-w-0 flex-1">
                        <span class="@Cn.Merge("font-medium text-sm", isChecked ? "text-muted-foreground line-through" : "")">
                            @item.Label
                        </span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                    </div>
                </label>
            }
        </div>

        @* CTA *@
        <div class="border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">
                Complete Setup
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                You can always revisit this from Settings &middot; Onboarding
            </p>
        </div>
    </div>
</section>

@code {
    private record StepItem(string Id, string Label, string Description);

    private static readonly StepItem[] _steps =
    [
        new("profile", "Complete your profile", "Add your name, avatar, and job title"),
        new("team", "Create or join a team", "Set up your workspace and invite collaborators"),
        new("integration", "Connect an integration", "Link GitHub, Slack, or Figma to your account"),
        new("project", "Create your first project", "Start building with a template or from scratch"),
    ];

    private HashSet<string> _completed = ["profile"];

    private int Progress => (int)Math.Round((_completed.Count / (double)_steps.Length) * 100);

    private void ToggleStep(string id)
    {
        if (_completed.Contains(id))
            _completed.Remove(id);
        else
            _completed.Add(id);
    }
}
