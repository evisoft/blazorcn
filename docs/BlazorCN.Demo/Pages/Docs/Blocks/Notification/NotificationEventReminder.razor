@* ============================================================
   Block: notification-event-reminder
   Title: NotificationEventReminder
   Description: An event reminder notification block for React and Next.js with meeting details, participant avatars, join and snooze actions, and recurring indicator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-event-reminder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Event Reminder</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">In @_event.Countdown</BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your next meeting is starting soon. Join the call or snooze the reminder.
            </p>
        </div>

        @* Event details *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">@_event.Title</span>
                @if (_event.Recurring)
                {
                    <div class="flex items-center gap-1 text-muted-foreground">
                        <LucideIconCn Name="repeat" Size="12" Class="size-3" />
                        <span class="text-xs">Recurring</span>
                    </div>
                }
            </div>
            <div class="mt-1.5 flex items-center gap-2 text-muted-foreground text-xs">
                <span>@_event.Time</span>
                <span>&middot;</span>
                <span>@_event.Duration</span>
            </div>
        </div>

        @* Participants *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Participants</span>
            <div class="mt-2 flex items-center gap-3">
                <div class="flex -space-x-2">
                    @foreach (var participant in _participants)
                    {
                        <div class="@($"flex size-7 items-center justify-center rounded-full border-2 border-card text-xs font-medium text-white {participant.Color}")"
                             aria-label="@participant.Name">
                            @participant.Initials
                        </div>
                    }
                </div>
                <span class="text-muted-foreground text-xs">@_participants.Length attendees</span>
            </div>
        </div>

        @* Meeting link *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 rounded-md bg-muted/50 p-2.5">
                <LucideIconCn Name="link" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                <span class="truncate font-mono text-muted-foreground text-xs">@_event.MeetingLink</span>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 gap-1.5 text-xs">
                <LucideIconCn Name="video" Size="12" Class="size-3" />
                Join Now
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">
                Snooze
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record ParticipantData(string Id, string Name, string Initials, string Color);
    private record EventData(
        string Title,
        string Time,
        string Duration,
        string Countdown,
        string MeetingLink,
        bool Recurring
    );

    private static readonly EventData _event = new(
        Title: "Team Standup",
        Time: "10:00 AM",
        Duration: "30 min",
        Countdown: "15 minutes",
        MeetingLink: "https://meet.google.com/abc-defg-hij",
        Recurring: true
    );

    private static readonly ParticipantData[] _participants =
    [
        new("p1", "Sarah Chen", "SC", "bg-blue-500"),
        new("p2", "Marcus Rivera", "MR", "bg-emerald-500"),
        new("p3", "Aisha Patel", "AP", "bg-amber-500"),
        new("p4", "James Okonkwo", "JO", "bg-violet-500"),
    ];
}
