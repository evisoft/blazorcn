@* ============================================================
   Block: notification-toast-action
   Title: NotificationToastAction
   Description: An action toast notification block for React and Next.js with dual action buttons, primary and dismiss controls, and stacked notification layout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-toast-action.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="mail" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Actionable Notifications</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Notifications with dual action buttons for quick responses to messages, files, and
                invitations.
            </p>
        </div>

        @* Toast stack *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-3">

                @foreach (var t in _toasts)
                {
                    var toast = t;
                    <div class="overflow-hidden rounded-md border bg-background" role="status" aria-live="polite">
                        <div class="flex items-start gap-3 px-3 py-2.5">
                            <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-muted/50">
                                <LucideIconCn Name="@toast.IconName" Size="14" Class="@toast.IconClass" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-1.5">
                                    <span class="font-medium text-sm">@toast.Message</span>
                                    <span class="text-muted-foreground text-xs">from @toast.Sender</span>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs">@toast.Detail</p>
                                <div class="mt-2 flex items-center gap-2">
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-6 px-3 text-xs" OnClick="@(() => Dismiss(toast.Id))">@toast.PrimaryAction</ButtonCn>
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-3 text-xs" OnClick="@(() => Dismiss(toast.Id))">@toast.SecondaryAction</ButtonCn>
                                </div>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 shrink-0 p-0 text-muted-foreground" OnClick="@(() => Dismiss(toast.Id))" aria-label="Dismiss notification">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                }

                @if (_toasts.Count == 0)
                {
                    <div class="py-6 text-center">
                        <p class="text-muted-foreground text-sm">All notifications handled</p>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-2 h-7 text-xs" OnClick="Reset">Reset</ButtonCn>
                    </div>
                }

            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <p class="text-muted-foreground text-xs">
                    @_toasts.Count pending action@(_toasts.Count != 1 ? "s" : "")
                </p>
                @if (_toasts.Count > 0)
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" OnClick="DismissAll">Dismiss all</ButtonCn>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record ActionToast(
        string Id,
        string IconName,
        string IconClass,
        string Sender,
        string Message,
        string Detail,
        string PrimaryAction,
        string SecondaryAction
    );

    private static readonly ActionToast[] _initialToasts =
    [
        new("a1", "mail",      "size-3.5 text-blue-600 dark:text-blue-400",    "Sarah Chen",  "New message",     "Can you review the updated wireframes before the meeting tomorrow?",                              "Reply",  "Dismiss"),
        new("a2", "file",      "size-3.5 text-muted-foreground",               "Alex Rivera", "File shared",     "Q4-financial-report.xlsx has been shared with you in the Finance workspace.",                    "Open",   "Dismiss"),
        new("a3", "user-plus", "size-3.5 text-emerald-600 dark:text-emerald-400", "Jordan Lee", "Team invitation", "You have been invited to join the Design Systems team as a contributor.",                       "Accept", "Decline"),
    ];

    private List<ActionToast> _toasts = [.. _initialToasts];

    private void Dismiss(string id)
    {
        _toasts = _toasts.Where(t => t.Id != id).ToList();
    }

    private void DismissAll()
    {
        _toasts = [];
    }

    private void Reset()
    {
        _toasts = [.. _initialToasts];
    }
}
