@* ============================================================
   Block: notification-feedback-request
   Title: NotificationFeedbackRequest
   Description: A feedback request notification block for React and Next.js with clickable star rating, optional comment textarea, submit button, AnimatePresence thank-you state, and skip option built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-feedback-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @if (_submitted)
        {
            @* Thank-you state *@
            <div class="px-4 py-8 text-center">
                <span class="mx-auto flex size-8 items-center justify-center rounded-full bg-emerald-500/10">
                    <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-emerald-600 dark:text-emerald-400" />
                </span>
                <p class="mt-3 font-medium text-sm">Thank you for your feedback</p>
                <p class="mt-1 text-muted-foreground text-xs">
                    Your response helps us improve the product.
                </p>
            </div>
        }
        else
        {
            @* Header *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">How was your experience?</span>
                </div>
                <p class="mt-1 text-muted-foreground text-sm">
                    We would love to hear your thoughts. Rate your experience and leave an optional
                    comment.
                </p>
            </div>

            @* Star rating *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Rating</span>
                <div class="mt-2 flex items-center gap-1">
                    @for (int i = 1; i <= 5; i++)
                    {
                        var starValue = i;
                        var isFilled = starValue <= (_hoveredStar > 0 ? _hoveredStar : _rating);
                        <button type="button"
                                @onclick="@(() => SetRating(starValue))"
                                @onmouseenter="@(() => SetHoveredStar(starValue))"
                                @onmouseleave="@(() => SetHoveredStar(0))"
                                class="rounded p-0.5 transition-colors hover:bg-muted/50"
                                aria-label="@($"Rate {starValue} out of 5")">
                            <LucideIconCn Name="star" Size="20" Class="@Cn.Merge("size-5 transition-colors", isFilled ? "fill-amber-400 text-amber-400" : "text-muted-foreground/30")" />
                        </button>
                    }
                    @if (_rating > 0)
                    {
                        <span class="ml-2 text-muted-foreground text-xs">@_rating/5</span>
                    }
                </div>
            </div>

            @* Comment *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">
                    Comment (optional)
                </span>
                <TextareaCn @bind-Value="_comment"
                            Placeholder="Tell us what went well or what could be improved..."
                            Class="mt-2 min-h-[72px] resize-none border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            </div>

            @* Actions *@
            <div class="border-b px-4 py-3">
                <ButtonCn Size="ButtonSize.Sm"
                          Class="h-8 w-full text-xs"
                          Disabled="@(_rating == 0)"
                          OnClick="HandleSubmit">
                    Submit Feedback
                </ButtonCn>
            </div>

            @* Footer *@
            <div class="px-4 py-2.5">
                <div class="flex items-center justify-between">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-muted-foreground text-xs">
                        Maybe Later
                    </ButtonCn>
                    <span class="text-muted-foreground text-xs">Takes 30 seconds</span>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private int _rating = 0;
    private int _hoveredStar = 0;
    private string _comment = "";
    private bool _submitted = false;

    private void SetRating(int value) => _rating = value;
    private void SetHoveredStar(int value) => _hoveredStar = value;

    private void HandleSubmit()
    {
        _submitted = true;
    }
}
