@* ============================================================
   Block: notification-audit-log
   Title: NotificationAuditLog
   Description: An audit log notification block for React and Next.js with timestamped event trail, actor identification, IP and session tracking, monospace technical details, and expandable entries built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-audit-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Audit Log</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_entries.Length new events
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Recent activity across your organization. Review changes and access events.
            </p>
        </div>

        @* Summary *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Create
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    Update
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    Delete
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    Access
                </span>
            </div>
        </div>

        @* Entries *@
        <div>
            @for (int i = 0; i < _entries.Length; i++)
            {
                var entry = _entries[i];
                var isExpanded = _expanded == entry.Id;
                var isLast = i == _entries.Length - 1;
                var entryId = entry.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = (isExpanded ? null : entryId))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-2 shrink-0 rounded-full {ActionDot(entry.Action)}")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@entry.Actor</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"font-normal text-xs {ActionBadge(entry.Action)}")">
                                    @entry.ActionLabel
                                </BadgeCn>
                                <span class="text-sm">@entry.Resource</span>
                            </div>
                            <span class="mt-0.5 block truncate font-mono text-muted-foreground text-xs">@entry.ResourceId</span>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">@entry.Timestamp</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <p class="mb-3 text-muted-foreground text-sm leading-relaxed">@entry.Description</p>
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">Actor</span>
                                        <p class="font-mono text-xs">@entry.ActorEmail</p>
                                    </div>
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">IP Address</span>
                                        <p class="font-mono text-xs">@entry.Ip</p>
                                    </div>
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">Session</span>
                                        <p class="font-mono text-xs">@entry.SessionId</p>
                                    </div>
                                    <div>
                                        <span class="font-medium text-muted-foreground text-xs">Resource ID</span>
                                        <p class="font-mono text-xs">@entry.ResourceId</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <p class="text-muted-foreground text-xs">Showing last 4 of 156 events</p>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                    View Full Audit Log
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "evt_1";

    private record AuditEntry(
        string Id,
        string Actor,
        string ActorEmail,
        string Action,
        string ActionLabel,
        string Resource,
        string ResourceId,
        string Timestamp,
        string Ip,
        string SessionId,
        string Description
    );

    private static readonly AuditEntry[] _entries =
    [
        new("evt_1", "Sarah Chen", "sarah@acme.com", "delete", "Deleted", "API Key", "key_prod_4f2a8b", "12 min ago", "72.134.89.201", "sess_8x7k2m9p",
            "Production API key rotated and previous key revoked. New key issued with read-only permissions for the payments scope."),
        new("evt_2", "Marcus Johnson", "marcus@acme.com", "update", "Updated", "Billing Plan", "plan_team_monthly", "28 min ago", "98.45.67.123", "sess_3n5j8q2w",
            "Billing plan upgraded from Individual to Team tier. Seat count increased from 1 to 5. Next invoice prorated at $79/mo."),
        new("evt_3", "System", "system@acme.com", "create", "Created", "Backup", "bak_20260324_1400", "1 hr ago", "10.0.1.50", "sess_auto_backup",
            "Automated daily database backup completed. Snapshot stored in us-east-1 with 30-day retention. Size: 2.4 GB compressed."),
        new("evt_4", "Emily Park", "emily@acme.com", "access", "Accessed", "User Export", "export_users_q1", "2 hr ago", "185.243.115.42", "sess_7m4k9x1r",
            "Downloaded user data export containing 12,400 records. Export includes email, name, and subscription status. GDPR Article 20 data portability request."),
    ];

    private static string ActionDot(string action) => action switch
    {
        "create" => "bg-emerald-500",
        "update" => "bg-blue-500",
        "delete" => "bg-red-500",
        "access" => "bg-amber-500",
        _ => ""
    };

    private static string ActionBadge(string action) => action switch
    {
        "create" => "border-emerald-200 bg-emerald-500/10 text-emerald-600 dark:border-emerald-800 dark:text-emerald-400",
        "update" => "border-blue-200 bg-blue-500/10 text-blue-600 dark:border-blue-800 dark:text-blue-400",
        "delete" => "border-red-200 bg-red-500/10 text-red-600 dark:border-red-800 dark:text-red-400",
        "access" => "border-amber-200 bg-amber-500/10 text-amber-600 dark:border-amber-800 dark:text-amber-400",
        _ => ""
    };
}
