@* ============================================================
   Block: notification-reply
   Title: NotificationReply
   Description: A reply notification block for React and Next.js with original comment preview, reply content display, thread context, and reply-back action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-reply.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Reply</span>
            </div>
            <span class="text-muted-foreground text-xs">@_replyTimestamp</span>
        </div>

        @* Reply summary *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2.5">
                <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-foreground text-[10px] font-medium text-background">
                    @_replierInitials
                </span>
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">@_replierName</span>
                    <span class="text-muted-foreground text-sm"> replied to your comment</span>
                </div>
            </div>
        </div>

        @* Thread context *@
        <div class="border-b px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">@_contextType</span>
                <span class="text-muted-foreground/40">&middot;</span>
                <span class="font-mono text-muted-foreground text-xs">@_contextName</span>
            </div>
        </div>

        @* Original comment *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-muted-foreground text-xs">@_originalAuthor</span>
                    <span class="text-muted-foreground/50 text-xs">@_originalTimestamp</span>
                </div>
                <p class="mt-1 line-clamp-2 text-muted-foreground text-xs">
                    @_originalContent
                </p>
            </div>
        </div>

        @* Reply content *@
        <div class="border-b px-4 py-3">
            <p class="text-sm">@_replyContent</p>
            <p class="mt-1.5 font-mono text-muted-foreground/60 text-xs">@_contextPath</p>
        </div>

        @* Actions *@
        <div class="flex items-center justify-between px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs text-muted-foreground">
                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                View Thread
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                <LucideIconCn Name="reply" Size="12" Class="size-3" />
                Reply Back
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private const string _replierName = "Alex Rivera";
    private const string _replierInitials = "AR";
    private const string _replyTimestamp = "12m ago";
    private const string _contextType = "Pull Request";
    private const string _contextName = "PR #142: Refactor auth middleware";
    private const string _contextPath = "src/middleware/auth.ts";
    private const string _originalAuthor = "You";
    private const string _originalContent = "Should we add rate limiting to the token refresh endpoint? The current implementation allows unlimited refresh attempts which could be exploited in a token replay attack.";
    private const string _originalTimestamp = "2h ago";
    private const string _replyContent = "Great point. I have added a sliding window rate limiter scoped to the user session. Limits refresh to 10 attempts per minute. Also added a jitter to the retry interval on the client side to prevent thundering herd on reconnect.";
}
