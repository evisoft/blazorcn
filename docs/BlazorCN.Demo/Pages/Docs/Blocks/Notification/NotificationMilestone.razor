@* ============================================================
   Block: notification-milestone
   Title: NotificationMilestone
   Description: A milestone reached notification block for React and Next.js with party popper icon, animated CountUp number, community rank comparison, and share and stats actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-milestone.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="party-popper" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Milestone Reached!</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Congratulations on reaching an incredible milestone with your deployments.
            </p>
        </div>

        @* Milestone number *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-semibold text-2xl tabular-nums">@_milestone.Count.ToString("N0")</span>
                    <span class="ml-1.5 text-muted-foreground text-sm">@_milestone.Label</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_milestone.Rank of users
                </BadgeCn>
            </div>
        </div>

        @* Congratulations message *@
        <div class="border-b px-4 py-3">
            <p class="text-muted-foreground text-sm">
                @_milestone.Message
            </p>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 gap-1.5 text-xs">
                    <LucideIconCn Name="share" Size="12" Class="size-3" />
                    Share
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 flex-1 gap-1.5 text-xs">
                    <LucideIconCn Name="bar-chart-3" Size="12" Class="size-3" />
                    View Stats
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                <span>Next milestone: 5,000 deploys</span>
                <span>&middot;</span>
                <span>4,000 to go</span>
            </div>
        </div>
    </div>
</section>

@code {
    private record MilestoneData(int Count, string Label, string Rank, string Message);

    private static readonly MilestoneData _milestone = new(
        1000,
        "deploys",
        "Top 5%",
        "You just hit 1,000 successful deploys. That puts you ahead of 95% of users on the platform."
    );
}
