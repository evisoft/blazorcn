@* ============================================================
   Block: notification-sound-toggle
   Title: NotificationSoundToggle
   Description: A notification sound settings block for React and Next.js with master sound toggle, per-category Switch controls for messages, alerts, reminders, and mentions, and volume preview built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-sound-toggle.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="volume-2" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notification Sounds</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Control which notifications play audio alerts. Disable the master toggle to mute all
                sounds.
            </p>
        </div>

        @* Master toggle *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                @if (_masterEnabled)
                {
                    <LucideIconCn Name="volume-2" Size="16" Class="size-4 text-foreground" />
                }
                else
                {
                    <LucideIconCn Name="volume-off" Size="16" Class="size-4 text-muted-foreground" />
                }
                <div>
                    <span class="font-medium text-sm">Master Sound</span>
                    <p class="text-muted-foreground text-xs">
                        @(_masterEnabled ? "Sounds are enabled" : "All sounds muted")
                    </p>
                </div>
            </div>
            <SwitchCn Checked="@_masterEnabled" CheckedChanged="@((bool _) => ToggleMaster())" aria-label="Toggle master sound" />
        </div>

        @* Individual sound settings *@
        @foreach (var snd in _settings)
        {
            var setting = snd;
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div class="flex items-center gap-3">
                    <LucideIconCn Name="@setting.Icon" Size="16" Class="size-4 text-muted-foreground" />
                    <div>
                        <span class="text-sm">@setting.Label</span>
                        <p class="text-muted-foreground text-xs">@setting.Description</p>
                    </div>
                </div>
                <SwitchCn Checked="@setting.Enabled"
                          CheckedChanged="@((bool _) => ToggleSetting(setting.Id))"
                          Disabled="@(!_masterEnabled)"
                          aria-label="@($"Toggle {setting.Label} sound")" />
            </div>
        }

        @* Volume preview *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-sm">Preview Sound</span>
                <p class="text-muted-foreground text-xs">Test the notification tone</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs"
                      @onclick="HandlePreview" Disabled="@(!_masterEnabled)">
                @if (_previewing)
                {
                    <span class="flex items-center gap-1">
                        <span class="flex items-center gap-0.5">
                            <span class="inline-block w-0.5 rounded-full bg-foreground h-1"></span>
                            <span class="inline-block w-0.5 rounded-full bg-foreground h-1.5"></span>
                            <span class="inline-block w-0.5 rounded-full bg-foreground h-1"></span>
                        </span>
                        Playing
                    </span>
                }
                else
                {
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="play" Size="12" Class="size-3" />
                        Play
                    </span>
                }
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @_enabledCount of @_settings.Count sound categories enabled
            </p>
        </div>

    </div>
</section>

@code {
    private record SoundSetting(string Id, string Label, string Description, string Icon, bool Enabled);

    private bool _masterEnabled = true;
    private bool _previewing = false;

    private List<SoundSetting> _settings =
    [
        new("messages", "Messages", "Play sound for new messages", "message-circle", true),
        new("alerts", "Alerts", "Play sound for system alerts", "bell-ring", true),
        new("reminders", "Reminders", "Play sound for scheduled reminders", "clock", false),
        new("mentions", "Mentions", "Play sound when someone mentions you", "at-sign", true),
    ];

    private int _enabledCount => _settings.Count(s => s.Enabled);

    private void ToggleMaster()
    {
        _masterEnabled = !_masterEnabled;
        if (!_masterEnabled)
        {
            _settings = _settings.Select(s => s with { Enabled = false }).ToList();
        }
    }

    private void ToggleSetting(string id)
    {
        _settings = _settings.Select(s => s.Id == id ? s with { Enabled = !s.Enabled } : s).ToList();
    }

    private async Task HandlePreview()
    {
        _previewing = true;
        await Task.Delay(1500);
        _previewing = false;
    }
}
