@* ============================================================
   Block: notification-invite
   Title: NotificationInvite
   Description: A team invite notification block for React and Next.js with inviter details, role assignment, accept and decline actions, pending invites list, and staggered animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-invite.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Team Invitations</span>
            </div>
            <span class="text-muted-foreground text-xs">@_pendingInvites.Count pending</span>
        </div>

        @* Featured invite *@
        <div class="border-b px-4 py-3">
            <p class="text-sm">
                <span class="font-medium">Sarah Chen</span>
                <span class="text-muted-foreground"> invited you to join </span>
                <span class="font-medium">Design Team</span>
            </p>
            <div class="mt-2 flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Editor</BadgeCn>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <span class="text-muted-foreground text-xs">8 members</span>
            </div>
            <div class="mt-3 flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="@(() => HandleAction("inv-1"))">
                    <LucideIconCn Name="check" Size="12" Class="size-3" />
                    Accept
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs" OnClick="@(() => HandleAction("inv-1"))">
                    <LucideIconCn Name="x" Size="12" Class="size-3" />
                    Decline
                </ButtonCn>
            </div>
        </div>

        @* Pending invites list *@
        <div class="border-b">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Other invitations</span>
            </div>
            @foreach (var inv in _pendingInvites.Skip(1).ToList())
            {
                var invite = inv;
                var initials = string.Concat(invite.Inviter.Split(' ').Select(n => n[0]));
                <div class="flex items-center gap-3 border-t px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted">
                        <span class="font-medium text-muted-foreground text-xs">@initials</span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@invite.Team</span>
                        <p class="text-muted-foreground text-xs">@invite.Inviter &middot; @invite.Role &middot; @invite.Members members</p>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs" OnClick="@(() => HandleAction(invite.Id))">
                        View
                    </ButtonCn>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Invitations expire after 7 days
            </p>
        </div>

    </div>
</section>

@code {
    private record Invite(string Id, string Inviter, string Team, string Role, int Members);

    private static readonly Invite[] _allInvites =
    [
        new("inv-1", "Sarah Chen",    "Design Team", "Editor", 8),
        new("inv-2", "Marcus Rivera", "Engineering", "Viewer", 14),
        new("inv-3", "Priya Sharma",  "Marketing",   "Admin",  5),
    ];

    private List<Invite> _pendingInvites = _allInvites.ToList();

    private void HandleAction(string id)
    {
        _pendingInvites = _pendingInvites.Where(inv => inv.Id != id).ToList();
    }
}
