@* ============================================================
   Block: notification-toast-warning
   Title: NotificationToastWarning
   Description: A warning toast notification block for React and Next.js with amber alert icon, contextual warning messages, learn more action link, and stacked layout built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-toast-warning.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-amber-600 dark:text-amber-400" />
                <span class="font-medium text-sm">Warning Notifications</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Cautionary alerts with contextual details and links to relevant documentation.
            </p>
        </div>

        @* Toast stack *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-3">
                @foreach (var toast in _toasts)
                {
                    var toastItem = toast;
                    <div class="overflow-hidden rounded-md border border-amber-500/20 bg-background"
                         role="status"
                         aria-live="polite">
                        <div class="flex items-start gap-3 px-3 py-2.5">
                            <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-amber-500/10">
                                <LucideIconCn Name="alert-triangle" Size="14" Class="size-3.5 text-amber-600 dark:text-amber-400" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@toastItem.Title</span>
                                <p class="mt-0.5 text-muted-foreground text-xs">@toastItem.Detail</p>
                                <div class="mt-2">
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-amber-600 text-xs dark:text-amber-400">
                                        @toastItem.Link
                                        <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                    </ButtonCn>
                                </div>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 shrink-0 p-0 text-muted-foreground"
                                      OnClick="@(() => Dismiss(toastItem.Id))"
                                      aria-label="Dismiss warning notification">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                }

                @if (_toasts.Length == 0)
                {
                    <div class="py-6 text-center">
                        <p class="text-muted-foreground text-sm">All warnings acknowledged</p>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-2 h-7 text-xs"
                                  OnClick="@Reset">
                            Reset
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <p class="text-muted-foreground text-xs">
                    @_toasts.Length warning@(_toasts.Length != 1 ? "s" : "") pending review
                </p>
                @if (_toasts.Length > 0)
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs"
                              OnClick="@DismissAll">
                        Dismiss all
                    </ButtonCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record WarningToast(string Id, string Title, string Detail, string Link);

    private static readonly WarningToast[] _initialToasts =
    [
        new("w1", "API rate limit approaching",
            "You have used 8,400 of 10,000 monthly API calls. Usage resets on April 1.",
            "View usage dashboard"),
        new("w2", "SSL certificate expiring soon",
            "The certificate for api.acme.co expires in 12 days. Renew to avoid service interruption.",
            "Manage certificates"),
        new("w3", "Deprecated endpoint in use",
            "Your integration calls /v1/users which is deprecated. Migrate to /v2/users before June 30.",
            "Migration guide"),
    ];

    private WarningToast[] _toasts = _initialToasts;

    private void Dismiss(string id)
    {
        _toasts = _toasts.Where(t => t.Id != id).ToArray();
    }

    private void DismissAll()
    {
        _toasts = [];
    }

    private void Reset()
    {
        _toasts = _initialToasts;
    }
}
