@* ============================================================
   Block: notification-toast-promise
   Title: NotificationToastPromise
   Description: A promise-based toast notification block for React and Next.js with loading spinner, success check, and error states using AnimatePresence transitions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-toast-promise.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="cloud-upload" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Async Operations</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Promise-based toasts show real-time feedback for background tasks.
            </p>
        </div>

        @* Toast states *@
        @foreach (var toast in _toastStates)
        {
            var item = toast;
            var cfg = _statusConfig[item.Status];
            var isLast = item.Id == _toastStates[_toastStates.Length - 1].Id;
            <div class="@(isLast ? "" : "border-b")">
                <div class="flex items-start gap-3 px-4 py-3">
                    <span class="mt-0.5 shrink-0">
                        <LucideIconCn Name="@cfg.IconName" Size="16" Class="@cfg.IconClass" />
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@item.Title</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                <span class="@($"size-1.5 rounded-full {cfg.DotColor}")"></span>
                                @cfg.BadgeLabel
                            </BadgeCn>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">@item.Description</p>
                        @if (item.Status == "loading")
                        {
                            <div class="mt-2 h-1 w-full overflow-hidden rounded-full bg-muted">
                                <div class="h-full w-[65%] rounded-full bg-blue-500"></div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                3 operations &middot; 1 in progress &middot; 1 completed &middot; 1 failed
            </p>
        </div>
    </div>
</section>

@code {
    private record ToastState(string Id, string Status, string Title, string Description);

    private record StatusCfg(string IconName, string DotColor, string BadgeLabel, string IconClass);

    private static readonly ToastState[] _toastStates =
    [
        new("loading", "loading", "Uploading document", "Compressing and uploading report-q4.pdf..."),
        new("success", "success", "Invoice sent", "Invoice #1042 has been sent to billing@acme.com."),
        new("error", "error", "Sync failed", "Could not connect to the database. Retrying in 30s."),
    ];

    private static readonly Dictionary<string, StatusCfg> _statusConfig = new()
    {
        ["loading"] = new("loader", "bg-blue-500", "In progress", "size-4 animate-spin text-blue-500"),
        ["success"] = new("check-circle", "bg-emerald-500", "Completed", "size-4 text-emerald-600 dark:text-emerald-400"),
        ["error"]   = new("x-circle", "bg-red-500", "Failed", "size-4 text-red-600 dark:text-red-400"),
    };
}
