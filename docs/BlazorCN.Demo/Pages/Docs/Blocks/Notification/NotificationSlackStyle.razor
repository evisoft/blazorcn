@* ============================================================
   Block: notification-slack-style
   Title: NotificationSlackStyle
   Description: A Slack-style notification block for React and Next.js with channel mentions, message previews, thread indicators, emoji reactions, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-slack-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="font-medium text-sm">@_workspaceName</span>
            </div>
            <span class="text-muted-foreground text-xs">@_notifications.Length new</span>
        </div>

        @* Notification list *@
        <div>
            @foreach (var notif in _notifications)
            {
                var isLast = notif.Id == _notifications[_notifications.Length - 1].Id;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    @* Channel + time *@
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex items-center gap-1.5">
                            <LucideIconCn Name="hash" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="font-medium text-sm">@notif.Channel</span>
                            <span class="text-muted-foreground text-xs">&middot;</span>
                            <span class="text-muted-foreground text-xs">@notif.Author</span>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">@notif.Time</span>
                    </div>

                    @* Message preview *@
                    <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                        @notif.Message
                    </p>

                    @* Thread + reaction row *@
                    <div class="mt-2 flex items-center gap-3">
                        @if (notif.ThreadReplies > 0)
                        {
                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                @notif.ThreadReplies @(notif.ThreadReplies == 1 ? "reply" : "replies")
                            </span>
                        }
                        <span class="inline-flex items-center gap-1 rounded-md bg-muted/50 px-1.5 py-0.5 text-xs">
                            @GetEmoji(notif.Reaction)
                            <span class="text-muted-foreground">1</span>
                        </span>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="ml-auto h-6 gap-1 px-2 text-xs text-muted-foreground">
                            View in Slack
                            <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @_workspaceName workspace &middot; 4 channels with activity
            </p>
        </div>
    </div>
</section>

@code {
    private const string _workspaceName = "Acme Inc";

    private record SlackNotification(string Id, string Channel, string Author, string Message, int ThreadReplies, string Reaction, string Time);

    private static readonly SlackNotification[] _notifications =
    [
        new("s1", "general",     "Sarah Chen",     "Just pushed the new onboarding flow to staging. Can someone review the signup form validation before we merge?",                                               4,  "eyes",   "3 min ago"),
        new("s2", "engineering", "Marcus Johnson", "The API latency spike from this morning has been resolved. Root cause was a misconfigured connection pool limit on the read replica.",                         7,  "tada",   "22 min ago"),
        new("s3", "design",      "Aisha Patel",    "Shared the updated component library in Figma. New button variants and form field styles are ready for implementation.",                                       2,  "fire",   "1 hr ago"),
        new("s4", "shipping",    "Tom Wilson",     "v2.4.0 is live in production. Changelog has been posted to the docs site. No rollback needed so far.",                                                        12, "rocket", "2 hr ago"),
    ];

    private static string GetEmoji(string reaction) => reaction switch
    {
        "eyes"   => "\U0001F440",
        "tada"   => "\U0001F389",
        "fire"   => "\U0001F525",
        "rocket" => "\U0001F680",
        _        => reaction,
    };
}
