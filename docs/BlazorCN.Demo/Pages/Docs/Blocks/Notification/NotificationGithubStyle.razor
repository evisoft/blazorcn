@* ============================================================
   Block: notification-github-style
   Title: NotificationGithubStyle
   Description: A GitHub-style notification block for React and Next.js with pull request reviews, issue assignments, CI check statuses, and release events with monospace repo names and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-github-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notifications</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-purple-500"></span>1
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>1
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>1
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>1
                </span>
            </div>
        </div>

        @* Notification list *@
        <div>
            @foreach (var notif in _notifications)
            {
                var cfg = GetConfig(notif.Type);
                var isLast = notif.Id == _notifications[_notifications.Length - 1].Id;
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full", cfg.BgColor)">
                        <LucideIconCn Name="@cfg.IconName" Size="14" Class="@Cn.Merge("size-3.5", cfg.IconColor)" />
                    </span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-mono text-muted-foreground text-xs">@notif.Repo</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                @cfg.Label
                            </BadgeCn>
                            <span class="ml-auto shrink-0 text-muted-foreground text-xs">
                                @notif.Time
                            </span>
                        </div>
                        <p class="mt-0.5 font-medium text-sm">@notif.Title</p>
                        <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">
                            @notif.Description
                        </p>
                        <span class="mt-1 inline-block font-mono text-muted-foreground text-xs">
                            @@notif.Actor
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                4 notifications &middot; All repositories
            </p>
        </div>
    </div>
</section>

@code {
    private record GitHubNotification(string Id, string Type, string Repo, string Title, string Description, string Actor, string Time);

    private record NotifConfig(string IconName, string BgColor, string IconColor, string Label);

    private static readonly GitHubNotification[] _notifications =
    [
        new("g1", "review",    "acme/dashboard", "Review requested: Add chart tooltips",
            "Sarah Chen requested your review on pull request #482. Changes to 6 files with improved chart tooltip positioning and dark mode support.",
            "sarah-chen", "5 min ago"),
        new("g2", "issue",     "acme/api",       "Assigned: Rate limiter returns 500 on burst",
            "Marcus Johnson assigned you to issue #1204. The token bucket rate limiter throws an unhandled exception when burst limit is reached.",
            "marcus-j", "32 min ago"),
        new("g3", "ci-failed", "acme/web",       "CI check failed: e2e-tests",
            "End-to-end test suite failed on branch feat/onboarding. 3 tests failed in the signup flow due to a missing test fixture.",
            "github-actions", "1 hr ago"),
        new("g4", "release",   "acme/sdk",       "Release published: v3.2.0",
            "Aisha Patel published a new release with streaming response support, retry middleware, and TypeScript 5.4 compatibility.",
            "aisha-patel", "3 hr ago"),
    ];

    private static NotifConfig GetConfig(string type) => type switch
    {
        "review"    => new("git-pull-request", "bg-purple-500/10", "text-purple-600 dark:text-purple-400", "Review"),
        "issue"     => new("circle-dot",       "bg-emerald-500/10","text-emerald-600 dark:text-emerald-400","Issue"),
        "ci-failed" => new("x-circle",         "bg-red-500/10",    "text-red-600 dark:text-red-400",       "CI Failed"),
        "release"   => new("tag",              "bg-blue-500/10",   "text-blue-600 dark:text-blue-400",     "Release"),
        _           => new("bell",             "bg-muted",         "text-muted-foreground",                "Other"),
    };
}
