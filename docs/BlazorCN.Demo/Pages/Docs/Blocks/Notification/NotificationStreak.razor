@* ============================================================
   Block: notification-streak
   Title: NotificationStreak
   Description: A usage streak notification block for React and Next.js with flame icon, 7-day streak calendar visualization, current and best streak counters, and encouragement message built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-streak.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="flame" Size="16" Class="size-4 text-orange-600 dark:text-orange-400" />
                <span class="font-medium text-sm">7-Day Streak!</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Personal Best
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                You have been active every day this week. Keep the momentum going to unlock streak rewards.
            </p>
        </div>

        @* Streak calendar *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">This Week</span>
            <div class="mt-2.5 flex items-center justify-between">
                @foreach (var item in _streakDays)
                {
                    <div class="flex flex-col items-center gap-1.5">
                        <span class="@Cn.Merge("flex size-8 items-center justify-center rounded-full", item.Active ? "bg-orange-500/10" : "bg-muted/50")"
                              role="img"
                              aria-label="@($"{item.Day}: {(item.Active ? "active" : "inactive")}")">
                            @if (item.Active)
                            {
                                <LucideIconCn Name="flame" Size="14" Class="size-3.5 text-orange-600 dark:text-orange-400" />
                            }
                            else
                            {
                                <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                            }
                        </span>
                        <span class="text-muted-foreground text-xs">@item.Day</span>
                    </div>
                }
            </div>
        </div>

        @* Streak stats *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Current Streak</span>
                    <div class="mt-0.5 flex items-baseline gap-1">
                        <span class="font-semibold text-2xl tabular-nums">@_currentStreak</span>
                        <span class="text-muted-foreground text-sm">days</span>
                    </div>
                </div>
                <div class="text-right">
                    <span class="font-medium text-muted-foreground text-xs">Best Streak</span>
                    <div class="mt-0.5 flex items-center justify-end gap-1.5">
                        <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="font-semibold text-sm tabular-nums">@_bestStreak days</span>
                    </div>
                </div>
            </div>
        </div>

        @* Encouragement *@
        <div class="border-b px-4 py-3">
            <p class="text-muted-foreground text-sm">
                Keep it going! 7 more days to beat your personal best of 14 days and earn the Consistency Champion badge.
            </p>
        </div>

        @* Actions *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-between">
                <p class="text-muted-foreground text-xs">Next reward at 14 days</p>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    View Rewards
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record StreakDay(string Day, bool Active);

    private static readonly StreakDay[] _streakDays =
    [
        new("Mon", true),
        new("Tue", true),
        new("Wed", true),
        new("Thu", true),
        new("Fri", true),
        new("Sat", true),
        new("Sun", true),
    ];

    private const int _currentStreak = 7;
    private const int _bestStreak = 14;
}
