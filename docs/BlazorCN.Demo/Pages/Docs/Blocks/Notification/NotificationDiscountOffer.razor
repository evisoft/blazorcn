@* ============================================================
   Block: notification-discount-offer
   Title: NotificationDiscountOffer
   Description: A discount offer notification block for React and Next.js with tag icon, promo code display with copy button, expiry countdown, limited time badge, and claim offer CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-discount-offer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="tag" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Special Offer</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Limited Time
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                @_offer.Description. Upgrade now and save on your first year.
            </p>
        </div>

        @* Discount display *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">@_offer.Discount%</span>
                    <span class="text-muted-foreground text-sm">off</span>
                </div>
                <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                    <span>Expires @_offer.Expiry</span>
                </div>
            </div>
        </div>

        @* Promo code *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Promo Code</span>
            <div class="mt-1.5 flex items-center gap-2">
                <div class="min-w-0 flex-1 rounded-md bg-muted/50 px-3 py-1.5">
                    <span class="block font-mono text-sm tracking-wider">@_offer.Code</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 px-2 text-xs" OnClick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
        </div>

        @* CTA *@
        <div class="border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">Claim Offer</ButtonCn>
        </div>

        @* Terms footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">@_offer.Terms</p>
        </div>
    </div>
</section>

@code {
    private record OfferData(int Discount, string Description, string Code, string Expiry, string Terms);

    private static readonly OfferData _offer = new(
        30,
        "Get 30% off annual plans",
        "ANNUAL30",
        "Apr 15, 2026",
        "Valid for new annual subscriptions only. Cannot be combined with other offers."
    );

    private bool _copied = false;

    private void HandleCopy()
    {
        _copied = true;
    }
}
