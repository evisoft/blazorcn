@* ============================================================
   Block: notification-center
   Title: NotificationCenter
   Description: A full notification center block for React and Next.js with tabbed navigation, unread indicators, mark all read action, and scrollable notification list built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-center.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Notifications</span>
            @if (_unreadCount > 0)
            {
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_unreadCount unread
                </BadgeCn>
            }
            <div class="ml-auto">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 text-xs"
                          @onclick="MarkAllRead" disabled="@(_unreadCount == 0)">
                    Mark All Read
                </ButtonCn>
            </div>
        </div>

        @* Tabs *@
        <div class="border-b px-4 py-2">
            <TabsCn Value="@_activeTab" ValueChanged="@((string v) => SetTab(v))">
                <TabsListCn Class="h-7">
                    @foreach (var tab in _tabs)
                    {
                        var t = tab;
                        <TabsTriggerCn Value="@t.Value" Class="px-2.5 text-xs">@t.Label</TabsTriggerCn>
                    }
                </TabsListCn>
                @foreach (var tab in _tabs)
                {
                    var t = tab;
                    <TabsContentCn Value="@t.Value" Class="mt-0" />
                }
            </TabsCn>
        </div>

        @* Notification list *@
        <div>
            @{
                var filtered = _activeTab == "all"
                    ? _notifications
                    : _notifications.Where(n => n.Type == _activeTab).ToArray();
                var filteredCount = filtered.Length;
            }
            @foreach (var (notification, index) in filtered.Select((n, i) => (n, i)))
            {
                var isLast = index == filteredCount - 1;
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    @* Unread dot *@
                    <div class="flex items-center pt-1.5">
                        @if (!notification.IsRead)
                        {
                            <span class="size-1.5 rounded-full bg-blue-500"></span>
                        }
                        else
                        {
                            <span class="size-1.5"></span>
                        }
                    </div>

                    @* Icon *@
                    <LucideIconCn Name="@notification.IconName" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />

                    @* Content *@
                    <div class="min-w-0 flex-1">
                        <span class="@Cn.Merge("text-sm", !notification.IsRead ? "font-medium" : "font-normal text-muted-foreground")">
                            @notification.Title
                        </span>
                        <p class="mt-0.5 truncate text-muted-foreground text-xs">
                            @notification.Description
                        </p>
                    </div>

                    @* Timestamp *@
                    <span class="shrink-0 text-muted-foreground/60 text-xs">@notification.Timestamp</span>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            @{
                var footerFiltered = _activeTab == "all"
                    ? _notifications
                    : _notifications.Where(n => n.Type == _activeTab).ToArray();
            }
            <p class="text-center text-muted-foreground text-xs">
                Showing @footerFiltered.Length of @_notifications.Length notifications
            </p>
        </div>
    </div>
</section>

@code {
    private record NotificationItem(
        string Id,
        string IconName,
        string Title,
        string Description,
        string Timestamp,
        bool IsRead,
        string Type);

    private record TabItem(string Value, string Label);

    private static readonly TabItem[] _tabs =
    [
        new("all",     "All"),
        new("mention", "Mentions"),
        new("alert",   "Alerts"),
    ];

    private NotificationItem[] _notifications =
    [
        new("n1", "at-sign",        "Sarah mentioned you in design review",        "Can you take a look at the updated wireframes for the settings page?", "2 min ago",  false, "mention"),
        new("n2", "triangle-alert", "API latency exceeds threshold",               "Endpoint /api/search p95 response time is 3.2s (threshold: 2s)",      "8 min ago",  false, "alert"),
        new("n3", "git-pull-request","PR #412 merged to main",                     "feat: add notification preference panel with channel toggles",          "15 min ago", false, "info"),
        new("n4", "message-square", "Alex replied to your comment",                "Good point about the rate limiting — I updated the middleware",         "32 min ago", false, "mention"),
        new("n5", "user-plus",      "Jamie joined the workspace",                  "New team member added to the Engineering workspace",                   "1 hr ago",   true,  "info"),
        new("n6", "triangle-alert", "SSL certificate expires in 7 days",           "Certificate for api.acme.com needs renewal before Apr 1",              "2 hr ago",   true,  "alert"),
        new("n7", "circle-check",   "Deploy succeeded on production",              "v2.14.0 deployed — 3 features, 2 bug fixes",                           "3 hr ago",   true,  "info"),
        new("n8", "settings",       "Billing plan updated",                        "Team plan upgraded from 5 to 10 seats — next invoice reflects changes", "5 hr ago",   true,  "info"),
    ];

    private string _activeTab = "all";

    private int _unreadCount => _notifications.Count(n => !n.IsRead);

    private void MarkAllRead()
    {
        _notifications = _notifications.Select(n => n with { IsRead = true }).ToArray();
    }

    private void SetTab(string value)
    {
        _activeTab = value;
    }
}
