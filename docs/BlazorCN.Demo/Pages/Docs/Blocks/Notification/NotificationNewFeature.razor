@* ============================================================
   Block: notification-new-feature
   Title: NotificationNewFeature
   Description: A new feature announcement notification block for React and Next.js with feature description, screenshot placeholder, try-it CTA button, and learn-more link built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-new-feature.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">New: AI-Powered Search</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    New
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Search across your entire workspace using natural language. Ask questions, find
                documents, and get instant answers powered by AI.
            </p>
        </div>

        @* Screenshot placeholder *@
        <div class="border-b px-4 py-3">
            <div class="flex aspect-video items-center justify-center rounded-md bg-muted/50">
                <div class="text-center">
                    <LucideIconCn Name="sparkles" Size="20" Class="mx-auto size-5 text-muted-foreground/60" />
                    <p class="mt-1.5 text-muted-foreground/60 text-xs">Feature preview</p>
                </div>
            </div>
        </div>

        @* CTA *@
        <div class="border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">Try It</ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <div class="flex items-center justify-between">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-muted-foreground text-xs">
                    Learn More
                </ButtonCn>
                <span class="text-muted-foreground text-xs">Available on all plans</span>
            </div>
        </div>
    </div>
</section>
