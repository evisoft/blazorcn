@* ============================================================
   Block: notification-snooze
   Title: NotificationSnooze
   Description: A notification snooze block for React and Next.js with snooze duration buttons for 1 hour, 4 hours, tomorrow, and next week, snoozed items list with wake-up times, and unsnooze action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-snooze.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="alarm-clock" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Snooze</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Snoozed (@(_snoozedItems.Count))
            </BadgeCn>
        </div>

        @* Pending notification / confirmed snooze *@
        @if (!_isSnoozed)
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-start gap-3">
                    <div class="relative mt-0.5">
                        <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                        <span class="absolute -top-0.5 -right-0.5 size-2 rounded-full bg-blue-500"></span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">Sprint planning meeting notes shared</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            Marcus shared the Q2 sprint planning document with your team.
                        </p>
                        <span class="mt-1 text-muted-foreground/60 text-xs">
                            5 min ago
                        </span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-2 text-muted-foreground">
                    <LucideIconCn Name="alarm-clock" Size="14" Class="size-3.5" />
                    <span class="text-sm">
                        Snoozed for @(GetSelectedDurationLabel())
                    </span>
                </div>
                <p class="mt-0.5 pl-[22px] text-muted-foreground text-xs">
                    Will reappear at @(GetSelectedDurationDescription())
                </p>
            </div>
        }

        @* Snooze duration options *@
        @if (!_isSnoozed)
        {
            <div class="border-b px-4 py-3">
                <span class="font-medium text-muted-foreground text-xs">Snooze for</span>
                <div class="mt-2 flex flex-wrap gap-2">
                    @foreach (var dur in _snoozeDurations)
                    {
                        var duration = dur;
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                  Class="h-7 gap-1.5 text-xs"
                                  OnClick="@(() => HandleSnooze(duration.Id))">
                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                            @duration.Label
                        </ButtonCn>
                    }
                </div>
            </div>
        }

        @* Snoozed items list *@
        <div class="border-b">
            <div class="flex items-center gap-2 px-4 pt-3 pb-1">
                <LucideIconCn Name="bell" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Snoozed Notifications</span>
            </div>
            @foreach (var it in _snoozedItems)
            {
                var item = it;
                <div class="flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50">
                    <LucideIconCn Name="@item.IconName" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="truncate text-sm">@item.Title</span>
                        <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                            <LucideIconCn Name="alarm-clock" Size="12" Class="size-3" />
                            <span>@item.WakeUpTime</span>
                        </div>
                    </div>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="h-6 gap-1 px-2 text-xs"
                              OnClick="@(() => HandleUnsnooze(item.Id))">
                        <LucideIconCn Name="undo" Size="12" Class="size-3" />
                        Unsnooze
                    </ButtonCn>
                </div>
            }
            @if (_snoozedItems.Count == 0)
            {
                <div class="px-4 py-4 text-center">
                    <p class="text-muted-foreground text-sm">No snoozed notifications</p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @(_snoozedItems.Count) notification@(_snoozedItems.Count != 1 ? "s" : "") snoozed
            </p>
        </div>
    </div>
</section>

@code {
    private record SnoozeDuration(string Id, string Label, string Description);

    private record SnoozedNotification(string Id, string IconName, string Title, string WakeUpTime, string SnoozedAt);

    private static readonly SnoozeDuration[] _snoozeDurations =
    [
        new("1h",        "1 hour",    "3:30 PM"),
        new("4h",        "4 hours",   "6:30 PM"),
        new("tomorrow",  "Tomorrow",  "9:00 AM"),
        new("next-week", "Next Week", "Mon 9:00 AM"),
    ];

    private List<SnoozedNotification> _snoozedItems = new List<SnoozedNotification>
    {
        new("s1", "message-square", "Review comments on PR #203",          "Today at 4:00 PM",       "1h ago"),
        new("s2", "user-plus",      "Respond to team invite from Design",   "Tomorrow at 9:00 AM",    "3h ago"),
    };

    private bool _isSnoozed = false;
    private string? _selectedDurationId = null;

    private void HandleSnooze(string durationId)
    {
        var duration = System.Array.Find(_snoozeDurations, d => d.Id == durationId);
        if (duration is null) return;

        _selectedDurationId = durationId;
        _isSnoozed = true;

        string prefix = durationId == "1h" || durationId == "4h" ? "Today"
                      : durationId == "tomorrow" ? "Tomorrow"
                      : "Mon";

        var newItem = new SnoozedNotification(
            $"s-new-{durationId}",
            "calendar",
            "Sprint planning meeting notes shared",
            $"{prefix} at {duration.Description}",
            "Just now"
        );
        _snoozedItems = new List<SnoozedNotification>(_snoozedItems);
        _snoozedItems.Insert(0, newItem);
    }

    private void HandleUnsnooze(string id)
    {
        _snoozedItems = _snoozedItems.FindAll(item => item.Id != id);
    }

    private string GetSelectedDurationLabel()
    {
        if (_selectedDurationId is null) return "";
        var d = System.Array.Find(_snoozeDurations, x => x.Id == _selectedDurationId);
        return d?.Label ?? "";
    }

    private string GetSelectedDurationDescription()
    {
        if (_selectedDurationId is null) return "";
        var d = System.Array.Find(_snoozeDurations, x => x.Id == _selectedDurationId);
        return d?.Description ?? "";
    }
}
