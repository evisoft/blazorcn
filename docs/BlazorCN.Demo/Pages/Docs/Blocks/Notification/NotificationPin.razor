@* ============================================================
   Block: notification-pin
   Title: NotificationPin
   Description: A pinned notifications block for React and Next.js with pin and unpin toggle, pinned section at top, regular feed below, and visual distinction for pinned items built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-pin.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notifications</span>
            </div>
            <span class="text-muted-foreground text-xs">@_pinnedCount pinned</span>
        </div>

        @* Pinned section *@
        @if (_pinnedCount > 0)
        {
            <div class="border-b">
                <div class="flex items-center gap-1.5 px-4 pt-3 pb-1">
                    <LucideIconCn Name="pin" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Pinned</span>
                </div>
                @foreach (var it in _notifications)
                {
                    var item = it;
                    @if (item.Pinned)
                    {
                        <div class="flex items-start gap-3 bg-muted/30 px-4 py-2.5 transition-colors hover:bg-muted/50">
                            <LucideIconCn Name="@item.IconName" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@item.Title</span>
                                <p class="mt-0.5 truncate text-muted-foreground text-xs">@item.Description</p>
                            </div>
                            <div class="flex shrink-0 items-center gap-2">
                                <span class="text-muted-foreground/60 text-xs">@item.Timestamp</span>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-1.5 text-xs" OnClick="@(() => TogglePin(item.Id))" aria-label="@($"Unpin {item.Title}")">
                                    <LucideIconCn Name="pin-off" Size="12" Class="size-3" />
                                </ButtonCn>
                            </div>
                        </div>
                    }
                }
            </div>
        }

        @* Regular notifications *@
        <div>
            @if (_pinnedCount > 0 && _regularCount > 0)
            {
                <div class="flex items-center gap-1.5 px-4 pt-3 pb-1">
                    <LucideIconCn Name="bell" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-medium text-muted-foreground text-xs">Recent</span>
                </div>
            }
            @foreach (var it in _notifications)
            {
                var item = it;
                @if (!item.Pinned)
                {
                    <div class="flex items-start gap-3 border-b px-4 py-2.5 transition-colors hover:bg-muted/50">
                        <LucideIconCn Name="@item.IconName" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="text-sm">@item.Title</span>
                            <p class="mt-0.5 truncate text-muted-foreground text-xs">@item.Description</p>
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            <span class="text-muted-foreground/60 text-xs">@item.Timestamp</span>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-1.5 text-xs text-muted-foreground" OnClick="@(() => TogglePin(item.Id))" aria-label="@($"Pin {item.Title}")">
                                <LucideIconCn Name="pin" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                    </div>
                }
            }
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @_notifications.Length notifications &middot; @_pinnedCount pinned
            </p>
        </div>
    </div>
</section>

@code {
    private record NotificationItem(string Id, string IconName, string Title, string Description, string Timestamp, bool Pinned);

    private NotificationItem[] _notifications =
    [
        new("n1", "triangle-alert",  "Production incident — API latency spike",  "P95 response time exceeded 2s threshold on the payments service.", "25 min ago", true),
        new("n2", "file-text",       "Q2 roadmap document shared",               "Elena shared the product roadmap for review and comments.",         "1h ago",     true),
        new("n3", "message-square",  "New comment on design review",             "Jordan left feedback on the navigation redesign mockup.",           "2h ago",     false),
        new("n4", "git-pull-request","PR #187 ready for review",                 "Auth token refresh logic refactored to handle edge cases.",         "3h ago",     false),
        new("n5", "zap",             "Deployment succeeded — staging",           "Build v3.1.0-rc.2 deployed to staging environment.",               "5h ago",     false),
    ];

    private int _pinnedCount => _notifications.Count(n => n.Pinned);
    private int _regularCount => _notifications.Count(n => !n.Pinned);

    private void TogglePin(string id)
    {
        _notifications = _notifications
            .Select(n => n.Id == id ? n with { Pinned = !n.Pinned } : n)
            .ToArray();
    }
}
