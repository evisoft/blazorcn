@* ============================================================
   Block: notification-scheduled-task
   Title: NotificationScheduledTask
   Description: A scheduled task completion notification block for React and Next.js with task name, execution time, duration, cron expression, and next run display built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-scheduled-task.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="clock" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Scheduled task completed</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    <span class="@($"mr-1.5 inline-block size-1.5 rounded-full {_currentStatus.Dot}")"></span>
                    @_currentStatus.Label
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                @_task.Name has finished running on schedule.
            </p>
        </div>

        @* Execution details *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-6">
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Executed</span>
                    <p class="mt-0.5 text-sm">@_task.ExecutedAt</p>
                </div>
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Duration</span>
                    <p class="mt-0.5 font-semibold text-sm tabular-nums">@_task.Duration</p>
                </div>
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Exit Code</span>
                    <div class="mt-0.5 flex items-center gap-1">
                        <LucideIconCn Name="check-circle" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                        <span class="font-mono text-sm tabular-nums">@_task.ExitCode</span>
                    </div>
                </div>
            </div>
        </div>

        @* Cron schedule *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Schedule</span>
            <div class="mt-1.5 flex items-center gap-2">
                <LucideIconCn Name="terminal" Size="14" Class="size-3.5 text-muted-foreground" />
                <code class="rounded bg-muted/50 px-1.5 py-0.5 font-mono text-xs">
                    @_task.CronExpression
                </code>
                <span class="text-muted-foreground text-xs">@_task.CronDescription</span>
            </div>
        </div>

        @* Next run + actions *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Next run</span>
                    <p class="mt-0.5 text-sm">@_task.NextRun</p>
                </div>
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View Output</ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Edit Schedule</ButtonCn>
                </div>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Task logs retained for 14 days
            </p>
        </div>
    </div>
</section>

@code {
    private record TaskData(
        string Name,
        string Status,
        string ExecutedAt,
        string Duration,
        string CronExpression,
        string CronDescription,
        string NextRun,
        int ExitCode
    );

    private record StatusConfig(string Label, string Dot);

    private static readonly TaskData _task = new(
        Name: "Generate Daily Analytics Digest",
        Status: "success",
        ExecutedAt: "Mar 24, 2026 at 6:00 AM",
        Duration: "1m 47s",
        CronExpression: "0 6 * * *",
        CronDescription: "Every day at 6:00 AM",
        NextRun: "Mar 25, 2026 at 6:00 AM",
        ExitCode: 0
    );

    private static StatusConfig GetStatusConfig(string status) => status switch
    {
        "success" => new StatusConfig("Completed", "bg-emerald-500"),
        "failed"  => new StatusConfig("Failed", "bg-red-500"),
        _         => new StatusConfig("Unknown", "bg-muted-foreground"),
    };

    private StatusConfig _currentStatus => GetStatusConfig(_task.Status);
}
