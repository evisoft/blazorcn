@* ============================================================
   Block: notification-version-update
   Title: NotificationVersionUpdate
   Description: A version update notification block for React and Next.js with semantic versioning display, breaking changes warning, migration steps checklist, and changelog highlights built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-version-update.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="arrow-up" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Update Available</span>
                </div>
                @if (_release.HasBreaking)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="border-amber-200 bg-amber-500/10 font-normal text-amber-600 text-xs dark:border-amber-800 dark:text-amber-400">
                        Breaking Changes
                    </BadgeCn>
                }
            </div>
            <div class="mt-1.5 flex items-center gap-2">
                <span class="font-mono text-muted-foreground text-sm">@_release.From</span>
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-mono font-semibold text-sm">@_release.To</span>
            </div>
        </div>

        @* Breaking change warning *@
        @if (_release.HasBreaking)
        {
            <div class="border-b px-4 py-3">
                <div class="rounded-md bg-amber-500/10 p-3">
                    <div class="flex items-start gap-2">
                        <LucideIconCn Name="alert-triangle" Size="14" Class="mt-0.5 size-3.5 shrink-0 text-amber-600 dark:text-amber-400" />
                        <p class="text-sm">@_release.BreakingNote</p>
                    </div>
                </div>
            </div>
        }

        @* Changelog *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Changelog</span>
            <ul class="mt-2 space-y-1.5">
                @foreach (var entry in _release.Changelog)
                {
                    <li class="flex items-center gap-2 text-sm">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _typeDot[entry.Type])"></span>
                        <span class="@Cn.Merge("shrink-0 font-medium text-xs", _typeColor[entry.Type])">@entry.Type</span>
                        <span class="text-muted-foreground">@entry.Description</span>
                    </li>
                }
            </ul>
        </div>

        @* Migration steps *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Migration Steps</span>
            <ul class="mt-2 space-y-1.5">
                @foreach (var step in _release.MigrationSteps)
                {
                    <li class="flex items-center gap-2 text-sm">
                        @if (step.Done)
                        {
                            <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 shrink-0 text-emerald-600 dark:text-emerald-400" />
                        }
                        else
                        {
                            <LucideIconCn Name="circle" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/50" />
                        }
                        <span class="@(step.Done ? "text-muted-foreground line-through" : "")">@step.Label</span>
                    </li>
                }
            </ul>
        </div>

        @* Compatibility *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Compatibility</span>
            <p class="mt-1 text-muted-foreground text-sm">@_release.Compatibility</p>
        </div>

        @* Actions *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">
                    <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                    Update Now
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 gap-1.5 text-xs">
                    <LucideIconCn Name="file-text" Size="12" Class="size-3" />
                    Release Notes
                </ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Published 45 min ago &middot; npm registry
            </p>
        </div>
    </div>
</section>

@code {
    private record MigrationStep(string Id, string Label, bool Done);

    private record ChangelogEntry(string Id, string Type, string Description);

    private record ReleaseInfo(
        string From,
        string To,
        bool HasBreaking,
        string BreakingNote,
        string Compatibility,
        MigrationStep[] MigrationSteps,
        ChangelogEntry[] Changelog
    );

    private static readonly Dictionary<string, string> _typeColor = new()
    {
        ["added"]   = "text-emerald-600 dark:text-emerald-400",
        ["changed"] = "text-amber-600 dark:text-amber-400",
        ["fixed"]   = "text-blue-600 dark:text-blue-400",
    };

    private static readonly Dictionary<string, string> _typeDot = new()
    {
        ["added"]   = "bg-emerald-500",
        ["changed"] = "bg-amber-500",
        ["fixed"]   = "bg-blue-500",
    };

    private static readonly ReleaseInfo _release = new(
        From: "v3.2.0",
        To: "v3.3.0",
        HasBreaking: true,
        BreakingNote: "The useAuth hook now returns a session object instead of a flat user. Update all destructured references.",
        Compatibility: "Requires Node.js 20+ and React 19. Backwards compatible with v3.2.x data schemas.",
        MigrationSteps:
        [
            new("m1", "Update useAuth destructuring to use session.user", false),
            new("m2", "Run database migration: bun db:migrate", false),
            new("m3", "Update environment variables per .env.example", false),
            new("m4", "Test authentication flows in staging", false),
        ],
        Changelog:
        [
            new("c1", "added",   "Session-based auth with 7-day token rotation"),
            new("c2", "added",   "Magic link sign-in via email"),
            new("c3", "changed", "useAuth hook returns session object (breaking)"),
            new("c4", "fixed",   "Race condition in concurrent webhook processing"),
        ]
    );
}
