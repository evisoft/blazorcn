@* ============================================================
   Block: notification-thread
   Title: NotificationThread
   Description: A threaded notification block for React and Next.js with nested replies, left-border indentation, thread participant avatars, reply count, and reply action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-thread.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Thread</span>
                <span class="text-muted-foreground text-xs">@_thread.TotalReplies replies</span>
            </div>
            <div class="flex items-center gap-1">
                @foreach (var participantName in _participants)
                {
                    var pName = participantName;
                    var initials = string.Concat(pName.Split(' ').Select(w => w.Length > 0 ? w[0].ToString() : ""));
                    <span class="flex size-5 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground"
                          title="@pName">
                        @initials
                    </span>
                }
            </div>
        </div>

        @* Main notification *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <span class="flex size-7 shrink-0 items-center justify-center rounded-full bg-foreground text-[10px] font-medium text-background">
                    @_thread.Initials
                </span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">@_thread.Author</span>
                        <span class="text-muted-foreground text-xs">@_thread.Timestamp</span>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_thread.Title</p>
                    <p class="mt-2 text-sm">@_thread.Content</p>
                    <p class="mt-1.5 font-mono text-muted-foreground/60 text-xs">@_thread.Context</p>
                </div>
            </div>
        </div>

        @* Threaded replies *@
        <div class="divide-y">
            @foreach (var reply in _thread.Replies)
            {
                <div class="py-3 pr-4 pl-7">
                    <div class="flex items-start gap-3 border-l-2 border-muted pl-3">
                        <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-[9px] font-medium text-muted-foreground">
                            @reply.Initials
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@reply.Author</span>
                                <span class="text-muted-foreground text-xs">@reply.Timestamp</span>
                            </div>
                            <p class="mt-0.5 text-sm text-muted-foreground">@reply.Content</p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Actions *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs text-muted-foreground">
                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                View full thread
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                <LucideIconCn Name="reply" Size="12" Class="size-3" />
                Reply
            </ButtonCn>
        </div>

    </div>
</section>

@code {
    private record ThreadReply(string Id, string Author, string Initials, string Content, string Timestamp);

    private record ThreadNotification(
        string Id,
        string Author,
        string Initials,
        string Title,
        string Content,
        string Timestamp,
        string Context,
        int TotalReplies,
        ThreadReply[] Replies);

    private static readonly ThreadNotification _thread = new(
        Id: "t1",
        Author: "Sarah Chen",
        Initials: "SC",
        Title: "Commented on PR #142: Auth refactor",
        Content: "The session handling logic in useAuth looks good, but I think we should add a refresh token rotation check before merging. The current implementation might cause issues with concurrent tabs.",
        Timestamp: "45m ago",
        Context: "pull/142 — auth-refactor branch",
        TotalReplies: 5,
        Replies:
        [
            new("r1", "Alex Rivera", "AR",
                "Good catch. I will add a mutex lock for the refresh flow. Should prevent the race condition across tabs.",
                "32m ago"),
            new("r2", "Jordan Park", "JP",
                "We had a similar issue in the billing service. Using BroadcastChannel API worked well for us to sync auth state across tabs.",
                "18m ago"),
            new("r3", "Sarah Chen", "SC",
                "That is a great suggestion, Jordan. Alex, can you look into the BroadcastChannel approach? It would be cleaner than a mutex.",
                "8m ago"),
        ]);

    private static readonly string[] _participants = _thread.Replies
        .Select(r => r.Author)
        .Prepend(_thread.Author)
        .Distinct()
        .ToArray();
}
