@* ============================================================
   Block: notification-grouped
   Title: NotificationGrouped
   Description: A grouped notifications block for React and Next.js with collapsible type groups, badge counts, ChevronDown expand transitions, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-grouped.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notifications</span>
            </div>
            <p class="text-muted-foreground text-xs">
                @_totalCount notifications in @_groups.Length groups
            </p>
        </div>

        @* Groups *@
        @foreach (var grp in _groups)
        {
            var isExpanded = _expanded.ContainsKey(grp.Id) && _expanded[grp.Id];
            var groupIndex = Array.IndexOf(_groups, grp);
            var isLastGroup = groupIndex == _groups.Length - 1;
            <div class="@Cn.Merge(isLastGroup && !isExpanded ? "" : "border-b")">
                @* Group header *@
                <button type="button"
                        @onclick="@(() => ToggleGroup(grp.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        aria-expanded="@isExpanded.ToString().ToLowerInvariant()">
                    <LucideIconCn Name="@grp.IconName" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                    <span class="flex-1 font-medium text-sm">@grp.Label</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @grp.Items.Length
                    </BadgeCn>
                    <LucideIconCn Name="chevron-down" Size="16"
                        Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-180" : "")" />
                </button>

                @* Group items *@
                @if (isExpanded)
                {
                    @foreach (var entry in grp.Items)
                    {
                        var itemIndex = Array.IndexOf(grp.Items, entry);
                        var isLastItem = itemIndex == grp.Items.Length - 1;
                        var isLastGroupLastItem = isLastGroup && isLastItem;
                        <div class="@Cn.Merge("flex items-center gap-3 py-2.5 pr-4 pl-11 transition-colors hover:bg-muted/50", isLastGroupLastItem ? "" : "border-b")">
                            <LucideIconCn Name="@entry.IconName" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                            <div class="min-w-0 flex-1">
                                <span class="text-sm">@entry.Title</span>
                            </div>
                            <span class="shrink-0 text-muted-foreground text-xs">@entry.Time</span>
                        </div>
                    }
                }
            </div>
        }
    </div>
</section>

@code {
    private record NotificationEntry(string Id, string IconName, string Title, string Time);

    private record NotificationGroup(string Id, string Label, string IconName, NotificationEntry[] Items);

    private static readonly NotificationGroup[] _groups =
    [
        new("messages", "Messages", "message-square",
        [
            new("m1", "message-square", "Sarah Chen replied to your design review",       "5 min ago"),
            new("m2", "message-square", "Alex Rivera mentioned you in #engineering",       "20 min ago"),
            new("m3", "message-square", "Jordan Park sent you a direct message",           "1 hour ago"),
        ]),
        new("updates", "Updates", "refresh-cw",
        [
            new("u1", "git-pull-request", "PR #342 feat/auth-flow was merged to main",    "15 min ago"),
            new("u2", "user-plus",        "2 new members joined your workspace",          "2 hours ago"),
        ]),
        new("alerts", "Alerts", "triangle-alert",
        [
            new("a1", "shield-alert", "API rate limit at 90% for production environment", "30 min ago"),
        ]),
    ];

    private int _totalCount = _groups.Sum(g => g.Items.Length);

    private Dictionary<string, bool> _expanded = _groups.ToDictionary(g => g.Id, _ => true);

    private void ToggleGroup(string id)
    {
        if (_expanded.ContainsKey(id))
            _expanded[id] = !_expanded[id];
    }
}
