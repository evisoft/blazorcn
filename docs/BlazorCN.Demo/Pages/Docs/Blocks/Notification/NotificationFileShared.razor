@* ============================================================
   Block: notification-file-shared
   Title: NotificationFileShared
   Description: A file shared notification block for React and Next.js with sharer details, file metadata badges, download and open actions, and stacked file share entries built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-file-shared.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Files Shared With You</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                @_files.Length files have been shared with you recently. Open or download to access them.
            </p>
        </div>

        @* File list *@
        @foreach (var file in _files)
        {
            var isLast = file.Id == _files[_files.Length - 1].Id;
            <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                <div class="flex items-start gap-3">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                        <LucideIconCn Name="file" Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="truncate font-medium text-sm">@file.Filename</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">@file.Type</BadgeCn>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-xs">
                            @file.Sharer shared this &middot; @file.Size &middot; @file.Timestamp
                        </p>
                        <div class="mt-2 flex items-center gap-2">
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1.5 text-xs">
                                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                Open
                            </ButtonCn>
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 text-xs">
                                <LucideIconCn Name="download" Size="12" Class="size-3" />
                                Download
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                3 files shared &middot; View all in Files
            </p>
        </div>

    </div>
</section>

@code {
    private record SharedFile(string Id, string Filename, string Sharer, string Size, string Type, string Timestamp);

    private static readonly SharedFile[] _files =
    [
        new("1", "design-system-v2.fig",    "Sarah Chen",    "14.2 MB", "Figma", "2 min ago"),
        new("2", "Q4-revenue-forecast.xlsx", "Marcus Rivera", "3.8 MB",  "Excel", "18 min ago"),
        new("3", "api-docs-v3.pdf",          "Jenna Okafor",  "1.1 MB",  "PDF",   "1 hour ago"),
    ];
}
