@* ============================================================
   Block: notification-uptime-alert
   Title: NotificationUptimeAlert
   Description: An uptime and downtime alert notification block for React and Next.js with service status indicators, incident timeline, region and duration metadata, and status page link built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-uptime-alert.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="wifi-off" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">API Endpoint Down</span>
                <span class="size-1.5 rounded-full bg-red-500"></span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                The payments API is experiencing an outage. Transactions may fail until the issue is
                resolved.
            </p>
        </div>

        @* Service details *@
        <div class="flex flex-wrap items-center gap-3 border-b px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="font-medium text-muted-foreground text-xs">Service</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    payments-api
                </BadgeCn>
            </div>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <div class="flex items-center gap-2">
                <span class="font-medium text-muted-foreground text-xs">Region</span>
                <span class="text-xs">us-east-1</span>
            </div>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <div class="flex items-center gap-2">
                <span class="font-medium text-muted-foreground text-xs">Downtime</span>
                <span class="font-mono text-red-600 text-xs dark:text-red-400">21 min</span>
            </div>
        </div>

        @* Incident timeline header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Incident Timeline</span>
        </div>

        @* Timeline entries *@
        @foreach (var entry in _timeline)
        {
            var isLast = entry.Id == _timeline[_timeline.Length - 1].Id;
            <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                <div class="flex items-start gap-3">
                    <span class="@Cn.Merge("mt-1.5 size-2 shrink-0 rounded-full", StatusDot(entry.Status))"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@entry.Label</span>
                            <span class="font-mono text-muted-foreground text-xs">@entry.Timestamp</span>
                        </div>
                        <p class="mt-0.5 text-muted-foreground text-sm leading-relaxed">@entry.Description</p>
                    </div>
                </div>
            </div>
        }

        @* Footer CTA *@
        <div class="border-t px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 w-full gap-1.5 text-xs">
                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                View Status Page
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TimelineEntry(string Id, string Status, string Label, string Timestamp, string Description);

    private static readonly TimelineEntry[] _timeline =
    [
        new("1", "detected", "Incident Detected", "14:02 UTC",
            "Automated monitoring detected elevated error rates on the payments API endpoint."),
        new("2", "investigating", "Investigating", "14:08 UTC",
            "Engineering team engaged. Initial triage points to database connection pool exhaustion."),
        new("3", "identified", "Root Cause Identified", "14:23 UTC",
            "Identified a misconfigured connection limit after the 14:00 UTC deployment. Rolling back."),
    ];

    private static string StatusDot(string status) => status switch
    {
        "detected" => "bg-red-500",
        "investigating" => "bg-amber-500",
        "identified" => "bg-blue-500",
        _ => "bg-muted-foreground"
    };
}
