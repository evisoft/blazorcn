@* ============================================================
   Block: notification-badge-counter
   Title: NotificationBadgeCounter
   Description: A bell icon notification dropdown block for React and Next.js with unread badge counter, recent notification list, mark-as-read actions, and staggered animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-badge-counter.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with bell *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="relative">
                    <LucideIconCn Name="bell" Size="20" Class="size-5 text-foreground" />
                    @if (_unreadCount > 0)
                    {
                        <span class="absolute -top-1.5 -right-1.5 flex size-4 items-center justify-center rounded-full bg-red-500 text-[10px] font-medium text-white">
                            @_unreadCount
                        </span>
                    }
                </div>
                <span class="font-medium text-sm">Notifications</span>
            </div>
            <span class="text-muted-foreground text-xs">@_unreadCount unread</span>
        </div>

        @* Notification list *@
        <div class="divide-y">
            @foreach (var notif in _notifications)
            {
                var nid = notif.Id;
                <div class="flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="relative mt-0.5">
                        <LucideIconCn Name="@notif.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        @if (!notif.Read)
                        {
                            <span class="absolute -top-0.5 -right-0.5 size-2 rounded-full bg-blue-500"></span>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="@Cn.Merge("text-sm", notif.Read ? "text-muted-foreground" : "font-medium")">
                            @notif.Title
                        </span>
                        <p class="mt-0.5 truncate text-muted-foreground text-xs">
                            @notif.Description
                        </p>
                        <span class="mt-1 text-muted-foreground/60 text-xs">
                            @notif.Timestamp
                        </span>
                    </div>
                    @if (!notif.Read)
                    {
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 px-2 text-xs" OnClick="@(() => MarkAsRead(nid))">
                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                            Read
                        </ButtonCn>
                    }
                    @if (notif.Read)
                    {
                        <LucideIconCn Name="circle-dot" Size="14" Class="mt-1 size-3.5 shrink-0 text-muted-foreground/40" />
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                View all notifications &middot; Manage preferences
            </p>
        </div>
    </div>
</section>

@code {
    private record NotificationItem(string Id, string IconName, string Title, string Description, string Timestamp, bool Read);

    private List<NotificationItem> _notifications =
    [
        new("nb1", "message-circle", "New comment on your post",    "Jordan replied to your thread in #engineering.", "5m ago",  false),
        new("nb2", "git-branch",     "Branch merged successfully",  "feature/auth-flow was merged into main.",        "28m ago", false),
        new("nb3", "user",           "New team member added",       "Riley was added to the Design workspace.",       "1h ago",  false),
        new("nb4", "credit-card",    "Payment processed",           "Monthly subscription renewed for $39.00.",      "3h ago",  true),
        new("nb5", "shield-check",   "Security scan complete",      "No vulnerabilities found in 142 dependencies.", "6h ago",  true),
    ];

    private int _unreadCount => _notifications.Count(n => !n.Read);

    private void MarkAsRead(string id)
    {
        _notifications = _notifications
            .Select(n => n.Id == id ? n with { Read = true } : n)
            .ToList();
    }
}
