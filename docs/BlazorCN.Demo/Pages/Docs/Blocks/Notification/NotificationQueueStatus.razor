@* ============================================================
   Block: notification-queue-status
   Title: NotificationQueueStatus
   Description: A queue processing status notification block for React and Next.js with job counts, animated progress bar, individual job items with status icons, and processing speed metrics built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-queue-status.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="list-ordered" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Processing queue</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Background jobs are being processed. You can continue working while tasks complete.
            </p>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-muted-foreground"></span>
                <span class="text-muted-foreground text-xs">@_countQueued queued</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-blue-500"></span>
                <span class="text-muted-foreground text-xs">@_countProcessing processing</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">@_countCompleted completed</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-red-500"></span>
                <span class="text-muted-foreground text-xs">@_countFailed failed</span>
            </div>
        </div>

        @* Progress bar *@
        <div class="border-b px-4 py-3">
            <div class="mb-1.5 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Progress</span>
                <span class="font-medium text-xs tabular-nums">@_progressPercent%</span>
            </div>
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-foreground" style="@($"width:{_progressPercent}%")"></div>
            </div>
            <div class="mt-1.5 flex items-center gap-2 text-muted-foreground text-xs">
                <span>@(_countCompleted + _countFailed) of @_total jobs processed</span>
                <span>&middot;</span>
                <span>~142 jobs/min</span>
            </div>
        </div>

        @* Job list *@
        <div>
            @foreach (var job in _jobs)
            {
                var item = job;
                var isLast = item.Id == _jobs[_jobs.Length - 1].Id;
                var dotColor = DotColor(item.Status);
                var iconName = IconName(item.Status);
                var iconColor = IconColor(item.Status);
                var spinClass = item.Status == "processing" ? " animate-spin" : "";
                <div class="@($"flex items-center gap-3 px-4 py-2.5{(isLast ? "" : " border-b")}")">
                    <span class="@($"size-1.5 shrink-0 rounded-full {dotColor}")"></span>
                    <LucideIconCn Name="@iconName" Size="14" Class="@($"size-3.5 shrink-0 {iconColor}{spinClass}")" />
                    <span class="min-w-0 flex-1 truncate text-sm">@item.Name</span>
                    @if (item.Status == "completed")
                    {
                        <span class="shrink-0 font-mono text-muted-foreground text-xs">@item.Duration</span>
                    }
                    @if (item.Status == "failed")
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs text-red-600 dark:text-red-400">Failed</BadgeCn>
                    }
                    @if (item.Status == "processing")
                    {
                        <span class="shrink-0 text-muted-foreground text-xs">Running</span>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <p class="text-muted-foreground text-xs">Processing speed: 142 jobs/min</p>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View Queue</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Job(string Id, string Name, string Status, string Duration);

    private static readonly Job[] _jobs =
    [
        new("j1", "Import user records batch 1", "completed", "2.3s"),
        new("j2", "Generate invoice PDFs",        "completed", "4.1s"),
        new("j3", "Send welcome emails",           "completed", "1.8s"),
        new("j4", "Resize uploaded images",        "processing", "—"),
        new("j5", "Sync CRM contacts",             "processing", "—"),
        new("j6", "Rebuild search index",          "queued",     "—"),
        new("j7", "Export analytics report",       "queued",     "—"),
        new("j8", "Validate payment records",      "failed",     "0.4s"),
    ];

    private static readonly int _total = _jobs.Length;

    private static readonly int _countQueued     = _jobs.Count(j => j.Status == "queued");
    private static readonly int _countProcessing = _jobs.Count(j => j.Status == "processing");
    private static readonly int _countCompleted  = _jobs.Count(j => j.Status == "completed");
    private static readonly int _countFailed     = _jobs.Count(j => j.Status == "failed");

    private static readonly int _progressPercent =
        (int)Math.Round(((double)(_countCompleted + _countFailed) / _total) * 100);

    private static string DotColor(string status) => status switch
    {
        "queued"     => "bg-muted-foreground",
        "processing" => "bg-blue-500",
        "completed"  => "bg-emerald-500",
        "failed"     => "bg-red-500",
        _            => "bg-muted-foreground",
    };

    private static string IconName(string status) => status switch
    {
        "queued"     => "clock",
        "processing" => "loader-2",
        "completed"  => "check-circle-2",
        "failed"     => "x-circle",
        _            => "clock",
    };

    private static string IconColor(string status) => status switch
    {
        "queued"     => "text-muted-foreground",
        "processing" => "text-blue-600 dark:text-blue-400",
        "completed"  => "text-emerald-600 dark:text-emerald-400",
        "failed"     => "text-red-600 dark:text-red-400",
        _            => "text-muted-foreground",
    };
}
