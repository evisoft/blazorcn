@* ============================================================
   Block: notification-rate-limit
   Title: NotificationRateLimit
   Description: A rate limit warning notification block for React and Next.js with usage progress bar, request count breakdown, reset countdown, and upgrade CTA built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-rate-limit.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="alert-triangle" Size="16" Class="size-4 text-amber-600 dark:text-amber-400" />
                <span class="font-medium text-sm">API rate limit approaching</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your current usage is nearing the monthly request limit. Consider upgrading to avoid
                service interruptions.
            </p>
        </div>

        @* Usage bar *@
        <div class="border-b px-4 py-3">
            <div class="flex items-baseline justify-between">
                <span class="font-semibold text-2xl tabular-nums">
                    @_usageData.Used.ToString("N0")
                </span>
                <span class="text-muted-foreground text-xs">
                    of @_usageData.Total.ToString("N0") requests
                </span>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-amber-500" style="@($"width:{_percentage}%")"></div>
            </div>
            <div class="mt-1.5 flex items-center justify-between">
                <span class="text-amber-600 text-xs dark:text-amber-400">@_percentage% used</span>
                <span class="text-muted-foreground text-xs">Resets in @_usageData.ResetTime</span>
            </div>
        </div>

        @* Usage breakdown *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Usage breakdown</span>
            <div class="mt-2 space-y-2">
                @foreach (var endpoint in _usageData.Endpoints)
                {
                    <div class="flex items-center justify-between">
                        <span class="font-mono text-muted-foreground text-xs">@endpoint.Name</span>
                        <span class="font-medium text-xs tabular-nums">@endpoint.Requests.ToString("N0")</span>
                    </div>
                }
            </div>
        </div>

        @* CTA *@
        <div class="border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full gap-1.5 text-xs">
                <LucideIconCn Name="zap" Size="12" Class="size-3" />
                Upgrade Plan
                <LucideIconCn Name="arrow-right" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Pro plans include 50,000 requests/month
            </p>
        </div>

    </div>
</section>

@code {
    private record EndpointUsage(string Name, int Requests);

    private record UsageData(int Used, int Total, string ResetTime, EndpointUsage[] Endpoints);

    private static readonly UsageData _usageData = new(
        Used: 4500,
        Total: 5000,
        ResetTime: "2h 14m",
        Endpoints:
        [
            new("/api/v1/users", 1820),
            new("/api/v1/search", 1450),
            new("/api/v1/analytics", 890),
            new("Other endpoints", 340),
        ]
    );

    private static readonly int _percentage = (int)Math.Round((double)_usageData.Used / _usageData.Total * 100);
}
