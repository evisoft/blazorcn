@* ============================================================
   Block: notification-webhook-received
   Title: NotificationWebhookReceived
   Description: A webhook received notification block for React and Next.js with event type badge, monospace payload preview, source identifier, timestamp, and replay action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-webhook-received.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="webhook" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Webhooks Received</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_webhooks.Length events
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Recent webhook events from connected integrations. Review payloads or replay failed
                deliveries.
            </p>
        </div>

        @* Webhook entries *@
        @foreach (var (webhook, index) in _webhooks.Select((w, i) => (w, i)))
        {
            var isLast = index == _webhooks.Length - 1;
            <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                @* Source and event type *@
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@webhook.Source</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">
                        @webhook.EventType
                    </BadgeCn>
                </div>

                @* Payload preview *@
                <div class="mt-2 overflow-hidden rounded-md bg-zinc-950 p-3">
                    <pre class="font-mono text-xs text-zinc-100 leading-relaxed">@webhook.PayloadPreview</pre>
                </div>

                @* Metadata *@
                <div class="mt-1.5 flex items-center gap-2 text-muted-foreground text-xs">
                    <span class="font-mono">@webhook.DeliveryId</span>
                    <span>&middot;</span>
                    <span class="font-mono">@webhook.Timestamp</span>
                </div>

                @* Actions *@
                <div class="mt-2 flex items-center gap-2">
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                        View Payload
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 gap-1.5 text-xs">
                        <LucideIconCn Name="refresh-cw" Size="12" Class="size-3" />
                        Replay
                    </ButtonCn>
                </div>
            </div>
        }

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                3 events received &middot; All deliveries successful
            </p>
        </div>
    </div>
</section>

@code {
    private record WebhookEvent(string Id, string Source, string EventType, string PayloadPreview, string Timestamp, string DeliveryId);

    private static readonly WebhookEvent[] _webhooks =
    [
        new("1", "Stripe", "payment_intent.succeeded",
            "{\n  \"id\": \"pi_3N8f2aLk4e9Z1x\",\n  \"amount\": 4999,\n  \"currency\": \"usd\"\n}",
            "14:32:07 UTC", "dlv_8f2a4b1c"),
        new("2", "GitHub", "push",
            "{\n  \"ref\": \"refs/heads/main\",\n  \"commits\": [{ \"message\": \"fix: resolve auth token refresh\" }]\n}",
            "14:28:51 UTC", "dlv_3c7e9a2f"),
        new("3", "Resend", "email.delivered",
            "{\n  \"to\": \"user@@example.com\",\n  \"subject\": \"Invoice #1042\",\n  \"status\": \"delivered\"\n}",
            "14:15:22 UTC", "dlv_5d1f8e4a"),
    ];
}
