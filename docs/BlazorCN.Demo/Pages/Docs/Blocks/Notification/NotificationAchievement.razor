@* ============================================================
   Block: notification-achievement
   Title: NotificationAchievement
   Description: An achievement unlocked notification block for React and Next.js with trophy icon, badge display, progress summary, XP indicator, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-achievement.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="trophy" Size="16" Class="size-4 text-amber-600 dark:text-amber-400" />
                <span class="font-medium text-sm">Achievement Unlocked!</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                You have earned a new achievement for your dedication and hard work.
            </p>
        </div>

        @* Achievement detail *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-3">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-amber-500/10">
                    <LucideIconCn Name="star" Size="20" Class="size-5 text-amber-600 dark:text-amber-400" />
                </span>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">@_achievement.Name</span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            @_achievement.Badge
                        </BadgeCn>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">@_achievement.Description</p>
                </div>
            </div>
        </div>

        @* Progress & XP *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Progress</span>
                    <p class="mt-0.5 text-sm">@_achievement.Progress</p>
                </div>
                <div class="text-right">
                    <span class="font-medium text-muted-foreground text-xs">XP Earned</span>
                    <div class="mt-0.5 flex items-center gap-1">
                        <LucideIconCn Name="sparkles" Size="14" Class="size-3.5 text-amber-600 dark:text-amber-400" />
                        <span class="font-semibold text-sm tabular-nums">+@_achievement.Xp</span>
                    </div>
                </div>
            </div>
            <div class="mt-2.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full w-full rounded-full bg-amber-500"></div>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">View Achievements</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">Dismiss</ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">7 of 24 achievements unlocked</p>
        </div>
    </div>
</section>

@code {
    private record AchievementData(string Name, string Description, int Xp, string Badge, string Progress);

    private readonly AchievementData _achievement = new(
        "Project Pioneer",
        "Complete 10 projects from start to finish",
        500,
        "Gold",
        "10 / 10 projects completed"
    );
}
