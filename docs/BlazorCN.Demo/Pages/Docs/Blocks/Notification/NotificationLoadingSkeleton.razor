@* ============================================================
   Block: notification-loading-skeleton
   Title: NotificationLoadingSkeleton
   Description: A notification loading skeleton block for React and Next.js with animated pulse placeholder items, avatar circles, text lines, and timestamp skeletons built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-loading-skeleton.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card"
         aria-busy="true"
         aria-label="Loading notifications">

        @* Header skeleton *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notifications</span>
            </div>
            <SkeletonCn Class="h-5 w-16 rounded" />
        </div>

        @* Skeleton items *@
        <div class="divide-y">
            @foreach (var item in _skeletonItems)
            {
                <div class="flex items-start gap-3 px-4 py-3">
                    @* Avatar circle skeleton *@
                    <SkeletonCn Class="mt-0.5 size-8 shrink-0 rounded-full" />

                    @* Text content skeleton *@
                    <div class="min-w-0 flex-1 space-y-2">
                        <SkeletonCn Class="@($"h-4 rounded {item.TitleWidth}")" />
                        <SkeletonCn Class="@($"h-3 rounded {item.DescWidth}")" />
                    </div>

                    @* Timestamp skeleton *@
                    <SkeletonCn Class="h-3 w-12 shrink-0 rounded" />
                </div>
            }
        </div>

        @* Footer skeleton *@
        <div class="border-t px-4 py-2.5">
            <div class="flex justify-center">
                <SkeletonCn Class="h-3 w-32 rounded" />
            </div>
        </div>
    </div>
</section>

@code {
    private record SkeletonItem(string Id, string TitleWidth, string DescWidth);

    private static readonly SkeletonItem[] _skeletonItems =
    [
        new("s1", "w-3/4", "w-full"),
        new("s2", "w-1/2", "w-4/5"),
        new("s3", "w-2/3", "w-3/4"),
        new("s4", "w-3/5", "w-full"),
        new("s5", "w-1/2", "w-2/3"),
    ];
}
