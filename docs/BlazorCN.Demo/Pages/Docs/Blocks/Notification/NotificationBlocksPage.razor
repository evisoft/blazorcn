                @* Source and event type *@
                <div class=""flex items-center gap-2"">
                    <span class=""font-medium text-sm"">@webhook.Source</span>
                    <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-mono font-normal text-xs"">
                        @webhook.EventType
                    </BadgeCn>
                </div>

                @* Payload preview *@
                <div class=""mt-2 overflow-hidden rounded-md bg-zinc-950 p-3"">
                    <pre class=""font-mono text-xs text-zinc-100 leading-relaxed"">@webhook.PayloadPreview</pre>
                </div>

                @* Metadata *@
                <div class=""mt-1.5 flex items-center gap-2 text-muted-foreground text-xs"">
                    <span class=""font-mono"">@webhook.DeliveryId</span>
                    <span>&middot;</span>
                    <span class=""font-mono"">@webhook.Timestamp</span>
                </div>

                @* Actions *@
                <div class=""mt-2 flex items-center gap-2"">
                    <ButtonCn Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Outline"" Class=""h-7 gap-1.5 text-xs"">
                        <LucideIconCn Name=""external-link"" Size=""12"" Class=""size-3"" />
                        View Payload
                    </ButtonCn>
                    <ButtonCn Size=""ButtonSize.Sm"" Variant=""ButtonVariant.Ghost"" Class=""h-7 gap-1.5 text-xs"">
                        <LucideIconCn Name=""refresh-cw"" Size=""12"" Class=""size-3"" />
                        Replay
                    </ButtonCn>
                </div>
            </div>
        }

        @* Footer *@
        <div class=""border-t px-4 py-2.5"">
            <p class=""text-center text-muted-foreground text-xs"">
                3 events received &middot; All deliveries successful
            </p>
        </div>
    </div>
</section>

