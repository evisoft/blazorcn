    private const string NotificationSurveyPopupCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @if (_completed)
        {
            @* Completed state *@
            <div class=""px-4 py-8 text-center"">
