@code {
    private const int CountdownSeconds = 5;

    private record ToastItem(string Id, string IconName, string Label, string Description);

    private static readonly ToastItem[] _toastItems =
    [
        new(""delete"",  ""trash-2"", ""Item deleted"",           ""Invoice #1042 has been moved to trash.""),
        new(""archive"", ""archive"", ""Conversation archived"",  ""Support ticket #387 has been archived.""),
    ];

    private Dictionary<string, bool> _undone = new();
    private Dictionary<string, int>  _remaining = new();
    private Dictionary<string, System.Threading.Timer> _timers = new();

    protected override void OnInitialized()
    {
        foreach (var item in _toastItems)
        {
            _remaining[item.Id] = CountdownSeconds;
            var id = item.Id;
            _timers[id] = new System.Threading.Timer(async _ =>
            {
                var current = _remaining.ContainsKey(id) ? _remaining[id] : 0;
                if (current <= 0) return;
                var next = current - 1;
                _remaining[id] = next;
                if (next <= 0)
                {
                    _timers[id].Change(System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
                }
                await InvokeAsync(StateHasChanged);
            }, null, 1000, 1000);
        }
    }

    private void HandleUndo(string id)
    {
        if (_timers.ContainsKey(id))
        {
            _timers[id].Change(System.Threading.Timeout.Infinite, System.Threading.Timeout.Infinite);
        }
        _undone[id] = true;
    }

    public void Dispose()
    {
        foreach (var timer in _timers.Values)
        {
            timer.Dispose();
        }
    }
}";

