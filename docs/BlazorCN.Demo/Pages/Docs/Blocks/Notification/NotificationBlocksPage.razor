@code {
    private record NotificationItem(string Id, string IconName, string Title, string Description, string ArchivedAt, bool Archived);

    private List<NotificationItem> _notifications = new List<NotificationItem>
    {
        new(""a1"", ""git-pull-request"",  ""PR #203 needs your review"",          ""Auth middleware refactor with rate limiting changes."",              """",       false),
        new(""a2"", ""message-square"",    ""New mention in #engineering"",         ""Sarah tagged you in the API versioning discussion."",               """",       false),
        new(""n1"", ""message-square"",    ""Comment on design review"",            ""Jordan left feedback on the navigation redesign."",                 ""1h ago"", true),
        new(""n2"", ""zap"",               ""Deployment succeeded — production"",   ""Build v2.8.3 deployed to production environment."",                 ""3h ago"", true),
        new(""n3"", ""user-plus"",         ""New team member joined"",              ""Casey accepted the invite to the Engineering workspace."",          ""1d ago"", true),
        new(""n4"", ""file-text"",         ""Invoice #1042 generated"",             ""Monthly invoice for February 2026 is ready."",                     ""2d ago"", true),
        new(""n5"", ""settings"",          ""Security patch applied"",              ""Dependency vulnerability in express@4.18 has been patched."",       ""3d ago"", true),
    };

    private List<NotificationItem> _activeItems => _notifications.FindAll(n => !n.Archived);
    private List<NotificationItem> _archivedItems => _notifications.FindAll(n => n.Archived);

    private void ArchiveItem(string id)
    {
        var idx = _notifications.FindIndex(n => n.Id == id);
        if (idx >= 0)
        {
            var n = _notifications[idx];
            _notifications[idx] = n with { Archived = true, ArchivedAt = ""Just now"" };
        }
    }

    private void RestoreItem(string id)
    {
        var idx = _notifications.FindIndex(n => n.Id == id);
        if (idx >= 0)
        {
            var n = _notifications[idx];
            _notifications[idx] = n with { Archived = false, ArchivedAt = """" };
        }
    }

    private void ClearArchive()
    {
        _notifications.RemoveAll(n => n.Archived);
    }
}";

