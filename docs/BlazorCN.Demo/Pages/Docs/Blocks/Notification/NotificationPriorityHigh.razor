@* ============================================================
   Block: notification-priority-high
   Title: NotificationPriorityHigh
   Description: A high priority notification alert block for React and Next.js with urgent indicators, red dot severity markers, priority badges, and acknowledge actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-priority-high.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="triangle-alert" Size="16" Class="size-4 text-red-500" />
                <span class="font-medium text-sm">High Priority</span>
                @if (_pendingCount > 0)
                {
                    <span class="flex size-5 items-center justify-center rounded-full bg-red-500 text-[10px] font-medium text-white">@_pendingCount</span>
                }
            </div>
            <span class="text-muted-foreground text-xs">Requires immediate attention</span>
        </div>

        @* Notification list *@
        <div class="divide-y">
            @foreach (var notif in _notifications)
            {
                var n = notif;
                <div class="px-4 py-3">
                    <div class="flex items-start gap-3">
                        <div class="relative mt-0.5">
                            <LucideIconCn Name="@n.IconName" Size="16" Class="size-4 text-muted-foreground" />
                            @if (!n.Acknowledged)
                            {
                                <span class="absolute -top-0.5 -right-0.5 size-2 rounded-full bg-red-500"></span>
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@(n.Acknowledged ? "text-sm text-muted-foreground" : "text-sm font-medium")">@n.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"shrink-0 text-[10px] font-normal {(n.Priority == "urgent" ? "bg-red-500/10 text-red-600 dark:text-red-400" : "bg-amber-500/10 text-amber-600 dark:text-amber-400")}")">
                                    @(n.Priority == "urgent" ? "Urgent" : "High")
                                </BadgeCn>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@n.Description</p>
                            <div class="mt-2 flex items-center gap-3">
                                <span class="text-muted-foreground text-xs">@n.Timestamp</span>
                                @if (!n.Acknowledged)
                                {
                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs" OnClick="@(() => Acknowledge(n.Id))">Acknowledge</ButtonCn>
                                }
                                else
                                {
                                    <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                                        Acknowledged
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">@_pendingCount pending &middot; @(_notifications.Count - _pendingCount) acknowledged</p>
        </div>

    </div>
</section>

@code {
    private record HighPriorityNotification(
        string Id,
        string Title,
        string Description,
        string Timestamp,
        string Priority,
        string IconName,
        bool Acknowledged
    );

    private List<HighPriorityNotification> _notifications = new List<HighPriorityNotification>
    {
        new("hp1", "Production database connection pool exhausted",
            "Connection pool at 100% capacity. Active queries are being queued. Immediate scaling required.",
            "3m ago", "urgent", "server-crash", false),
        new("hp2", "Unauthorized access attempt detected",
            "Multiple failed login attempts from IP 203.0.113.42 on the admin endpoint. Account temporarily locked.",
            "12m ago", "urgent", "shield-alert", false),
        new("hp3", "Stripe payment webhook failures",
            "17 webhook deliveries failed in the last 30 minutes. Customer payment confirmations are delayed.",
            "28m ago", "high", "credit-card", false),
    };

    private int _pendingCount => _notifications.Count(n => !n.Acknowledged);

    private void Acknowledge(string id)
    {
        var idx = _notifications.FindIndex(n => n.Id == id);
        if (idx >= 0)
        {
            var n = _notifications[idx];
            _notifications[idx] = n with { Acknowledged = true };
        }
    }
}
