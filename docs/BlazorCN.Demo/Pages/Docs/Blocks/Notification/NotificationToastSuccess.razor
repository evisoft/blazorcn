@* ============================================================
   Block: notification-toast-success
   Title: NotificationToastSuccess
   Description: A success toast notification block for React and Next.js with green check icon, auto-dismiss progress bar, stacked toasts, and dismiss button built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-toast-success.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="check-circle" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                <span class="font-medium text-sm">Success Notifications</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Confirmations with auto-dismiss progress indicators and manual dismiss controls.
            </p>
        </div>

        @* Toast stack *@
        <div class="px-4 py-3">
            <div class="flex flex-col gap-3">
                @foreach (var toast in _toasts)
                {
                    var toastItem = toast;
                    <div class="overflow-hidden rounded-md border bg-background"
                         role="status"
                         aria-live="polite">
                        <div class="flex items-start gap-3 px-3 py-2.5">
                            <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                <LucideIconCn Name="check-circle" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@toastItem.Title</span>
                                <p class="mt-0.5 text-muted-foreground text-xs">@toastItem.Detail</p>
                            </div>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 shrink-0 p-0 text-muted-foreground"
                                      OnClick="@(() => Dismiss(toastItem.Id))"
                                      aria-label="Dismiss notification">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                            </ButtonCn>
                        </div>
                        @* Auto-dismiss progress bar *@
                        <div class="h-1 w-full bg-muted">
                            <div class="h-full w-1/3 rounded-r-full bg-emerald-500"></div>
                        </div>
                    </div>
                }

                @if (_toasts.Length == 0)
                {
                    <div class="py-6 text-center">
                        <p class="text-muted-foreground text-sm">All notifications dismissed</p>
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="mt-2 h-7 text-xs"
                                  OnClick="@Reset">
                            Reset
                        </ButtonCn>
                    </div>
                }
            </div>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <div class="flex items-center justify-between">
                <p class="text-muted-foreground text-xs">
                    @_toasts.Length active notification@(_toasts.Length != 1 ? "s" : "")
                </p>
                @if (_toasts.Length > 0)
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs"
                              OnClick="@DismissAll">
                        Dismiss all
                    </ButtonCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record SuccessToast(string Id, string Title, string Detail);

    private static readonly SuccessToast[] _initialToasts =
    [
        new("t1", "Changes saved successfully", "Your profile settings have been updated."),
        new("t2", "Invoice sent", "Invoice #INV-2024-0847 has been emailed to the client."),
        new("t3", "Deployment complete", "Production build v2.4.1 is now live."),
    ];

    private SuccessToast[] _toasts = _initialToasts;

    private void Dismiss(string id)
    {
        _toasts = _toasts.Where(t => t.Id != id).ToArray();
    }

    private void DismissAll()
    {
        _toasts = [];
    }

    private void Reset()
    {
        _toasts = _initialToasts;
    }
}
