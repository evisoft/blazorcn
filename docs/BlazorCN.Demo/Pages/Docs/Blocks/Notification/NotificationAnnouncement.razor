@* ============================================================
   Block: notification-announcement
   Title: NotificationAnnouncement
   Description: A product announcement notification block for React and Next.js with feature badge, dismissible banner, CTA button, and staggered entrance animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-announcement.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    @if (!_dismissed)
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="megaphone" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Product Update</span>
                </div>
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        New Feature
                    </BadgeCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0 text-muted-foreground" OnClick="@(() => _dismissed = true)" aria-label="Dismiss announcement">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            </div>

            @* Content *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-sm">Introducing AI Assistant</span>
                <p class="mt-1 text-muted-foreground text-sm">
                    Generate components, fix bugs, and refactor code with natural language. The AI
                    assistant integrates directly into your editor and understands your entire
                    codebase.
                </p>
            </div>

            @* Features list *@
            <div class="border-b px-4 py-3">
                <div class="flex flex-col gap-2">
                    @foreach (var feature in _features)
                    {
                        <div class="flex items-center gap-2.5">
                            <span class="size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                            <span class="text-sm">@feature</span>
                        </div>
                    }
                </div>
            </div>

            @* CTA *@
            <div class="border-b px-4 py-3">
                <ButtonCn Size="ButtonSize.Sm" Class="h-8 w-full text-xs">Try it now</ButtonCn>
            </div>

            @* Footer *@
            <div class="px-4 py-2.5">
                <p class="text-center text-muted-foreground text-xs">
                    Available on Pro plans &middot; No setup required
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="px-4 py-6 text-center">
                <p class="text-muted-foreground text-sm">Announcement dismissed</p>
            </div>
        </div>
    }
</section>

@code {
    private bool _dismissed = false;

    private static readonly string[] _features =
    [
        "Context-aware code generation",
        "Inline refactoring suggestions",
        "Natural language to component",
    ];
}
