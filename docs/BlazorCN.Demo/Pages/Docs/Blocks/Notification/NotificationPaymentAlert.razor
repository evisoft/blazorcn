@* ============================================================
   Block: notification-payment-alert
   Title: NotificationPaymentAlert
   Description: A payment alert notification block for React and Next.js with transaction status tracking, amount display, invoice links, and success/failure indicators built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-payment-alert.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="credit-card" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Payment Notifications</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Recent billing events and transaction updates for your account.
            </p>
        </div>

        @* Summary bar *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">@_transactions.Length transactions</span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-red-500"></span>1 requires attention
            </span>
        </div>

        @* Transaction list *@
        <div>
            @foreach (var tx in _transactions)
            {
                var isExpanded = _expanded == tx.Id;
                var isLast = tx.Id == _transactions[_transactions.Length - 1].Id;
                var dotColor = _statusDot.TryGetValue(tx.Status, out var dot) ? dot : "bg-muted-foreground";
                var badgeColor = _statusBadge.TryGetValue(tx.Status, out var badge) ? badge : "";
                var label = _statusLabel.TryGetValue(tx.Status, out var lbl) ? lbl : tx.Status;
                var txItem = tx;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : txItem.Id)">
                        <span class="@($"size-2 shrink-0 rounded-full {dotColor}")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@tx.Title</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-muted-foreground text-xs">@tx.Method</span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="text-muted-foreground text-xs">@tx.Timestamp</span>
                            </div>
                        </div>
                        <span class="@($"shrink-0 font-semibold text-sm tabular-nums {badgeColor}")">@tx.Amount</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200{(isExpanded ? " rotate-90" : "")}")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <p class="mb-3 text-muted-foreground text-sm leading-relaxed">@tx.Description</p>
                            <div class="mb-3 flex items-center gap-3">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@label</BadgeCn>
                                <span class="font-mono text-muted-foreground text-xs">@tx.InvoiceId</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View Invoice</ButtonCn>
                                @if (tx.Status == "failed")
                                {
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Update Payment Method</ButtonCn>
                                }
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Download PDF</ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Showing last 7 days &middot; View all billing history
            </p>
        </div>

    </div>
</section>

@code {
    private record Transaction(
        string Id,
        string Status,
        string Title,
        string Amount,
        string Method,
        string Timestamp,
        string Description,
        string InvoiceId
    );

    private static readonly Transaction[] _transactions =
    [
        new("1", "success", "Subscription renewed",             "$229.00",  "Visa ending in 4242",         "10 min ago",  "Annual Team Plan subscription renewed successfully. Next billing date is Mar 24, 2027. Invoice INV-2026-0342 has been generated and sent to billing@@acme.com.",  "INV-2026-0342"),
        new("2", "failed",  "Payment failed — card declined",   "$79.00",   "Mastercard ending in 8531",   "2 hr ago",    "Monthly Team Plan payment was declined by the issuing bank. Reason: insufficient funds. The system will retry in 3 days. Update your payment method to avoid service interruption.", "INV-2026-0341"),
        new("3", "success", "One-time purchase completed",       "$599.00",  "Visa ending in 4242",         "1 day ago",   "Lifetime Individual Plan purchase completed. Full access has been granted to all premium components, blocks, and future updates. No recurring charges will apply.", "INV-2026-0340"),
        new("4", "pending", "Invoice awaiting payment",          "$949.00",  "Bank transfer",               "2 days ago",  "Annual Organization Plan invoice has been sent to finance@@acme.com. Payment is due within 30 days. Wire transfer instructions are included in the invoice PDF.", "INV-2026-0339"),
        new("5", "success", "Refund processed",                  "-$39.00",  "Visa ending in 4242",         "3 days ago",  "Partial refund for unused portion of Monthly Individual Plan. Refund will appear on your statement within 5-10 business days. Credit memo CM-2026-0088 attached.",  "CM-2026-0088"),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["success"] = "bg-emerald-500",
        ["failed"]  = "bg-red-500",
        ["pending"] = "bg-amber-500",
    };

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["success"] = "Success",
        ["failed"]  = "Failed",
        ["pending"] = "Pending",
    };

    private static readonly Dictionary<string, string> _statusBadge = new()
    {
        ["success"] = "text-emerald-700 dark:text-emerald-400",
        ["failed"]  = "text-red-700 dark:text-red-400",
        ["pending"] = "text-amber-700 dark:text-amber-400",
    };

    private string? _expanded = "2";
}
