@* ============================================================
   Block: notification-unread-list
   Title: NotificationUnreadList
   Description: An unread notifications list block for React and Next.js with toggle filter, blue dot indicators, click-to-mark-as-read interactions, and staggered animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-unread-list.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Notifications</span>
                @if (_unreadCount > 0)
                {
                    <span class="flex size-5 items-center justify-center rounded-full bg-foreground text-[10px] text-background tabular-nums">
                        @_unreadCount
                    </span>
                }
            </div>
            <button type="button"
                    @onclick="MarkAllAsRead"
                    class="flex items-center gap-1.5 text-muted-foreground text-xs transition-colors hover:text-foreground">
                <LucideIconCn Name="check-check" Size="12" Class="size-3" />
                Mark all read
            </button>
        </div>

        @* Filter toggle *@
        <div class="flex items-center justify-between border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs">
                Showing @_filtered.Length of @_notifications.Length notifications
            </span>
            <span class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">Unread only</span>
                <SwitchCn Checked="@_unreadOnly" CheckedChanged="@((bool v) => { _unreadOnly = v; })" aria-label="Show unread only" />
            </span>
        </div>

        @* Notification items *@
        @if (_filtered.Length > 0)
        {
            @foreach (var notification in _filtered)
            {
                var notif = notification;
                var isLast = notif.Id == _filtered[_filtered.Length - 1].Id;
                <button type="button"
                        @onclick="@(() => MarkAsRead(notif.Id))"
                        class="@Cn.Merge("flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <LucideIconCn Name="@notif.IconName" Size="16" Class="mt-0.5 size-4 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@notif.Title</span>
                        <p class="mt-0.5 truncate text-muted-foreground text-xs">@notif.Description</p>
                    </div>
                    <div class="flex shrink-0 items-center gap-2">
                        <span class="text-muted-foreground text-xs">@notif.Time</span>
                        @if (!notif.Read)
                        {
                            <span class="size-2 rounded-full bg-blue-500"></span>
                        }
                    </div>
                </button>
            }
        }
        else
        {
            <div class="flex flex-col items-center gap-2 px-4 py-8">
                <LucideIconCn Name="inbox" Size="20" Class="size-5 text-muted-foreground" />
                <p class="text-muted-foreground text-sm">All caught up</p>
                <p class="text-muted-foreground text-xs">No unread notifications</p>
            </div>
        }

    </div>
</section>

@code {
    private record NotificationItem(string Id, string IconName, string Title, string Description, string Time, bool Read);

    private NotificationItem[] _notifications =
    [
        new("1", "message-square", "New comment on your post", "Sarah Chen replied to your design review thread.", "2 min ago", false),
        new("2", "user-plus", "New team member joined", "Alex Rivera accepted the invite to Engineering.", "10 min ago", false),
        new("3", "git-pull-request", "Pull request approved", "PR #342 feat/auth-flow was approved by 2 reviewers.", "30 min ago", false),
        new("4", "shield-alert", "Security alert", "New sign-in from Chrome on Windows in San Francisco.", "1 hour ago", false),
        new("5", "zap", "Usage limit approaching", "Your workspace has used 85% of the monthly API quota.", "3 hours ago", false),
        new("6", "star", "Milestone reached", "Your project crossed 5,000 downloads this month.", "Yesterday", false),
    ];

    private bool _unreadOnly = false;

    private int _unreadCount => _notifications.Count(n => !n.Read);

    private NotificationItem[] _filtered => _unreadOnly
        ? _notifications.Where(n => !n.Read).ToArray()
        : _notifications;

    private void MarkAsRead(string id)
    {
        _notifications = _notifications
            .Select(n => n.Id == id ? n with { Read = true } : n)
            .ToArray();
    }

    private void MarkAllAsRead()
    {
        _notifications = _notifications
            .Select(n => n with { Read = true })
            .ToArray();
    }
}
