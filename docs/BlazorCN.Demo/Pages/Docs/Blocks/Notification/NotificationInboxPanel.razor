@* ============================================================
   Block: notification-inbox-panel
   Title: NotificationInboxPanel
   Description: A full notification inbox panel block for React and Next.js with tab filtering, unread indicators, mark-as-read actions, and staggered list animations built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-inbox-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Inbox</span>
                @if (_unreadCount > 0)
                {
                    <span class="flex size-5 items-center justify-center rounded-full bg-foreground text-[10px] font-medium text-background">
                        @_unreadCount
                    </span>
                }
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs" @onclick="MarkAllRead">
                <LucideIconCn Name="check-check" Size="12" Class="size-3" />
                Mark all read
            </ButtonCn>
        </div>

        @* Tabs *@
        <div class="border-b px-4 py-2">
            <TabsCn Value="@_tab" ValueChanged="@((string? v) => SetTab(v))">
                <TabsListCn Variant="TabsListVariant.Line" Class="h-8 w-full justify-start">
                    <TabsTriggerCn Value="all" Class="text-xs">All</TabsTriggerCn>
                    <TabsTriggerCn Value="unread" Class="text-xs">Unread</TabsTriggerCn>
                    <TabsTriggerCn Value="archived" Class="text-xs">
                        <LucideIconCn Name="archive" Size="12" Class="size-3" />
                        Archived
                    </TabsTriggerCn>
                </TabsListCn>
                <TabsContentCn Value="@_tab" />
            </TabsCn>
        </div>

        @* Notification list *@
        <div class="divide-y">
            @foreach (var notif in _filteredNotifications)
            {
                var item = notif;
                <button type="button"
                        class="flex w-full items-start gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                        @onclick="@(() => MarkAsRead(item.Id))">
                    <div class="relative mt-0.5">
                        <LucideIconCn Name="@item.IconName" Size="16" Class="size-4 text-muted-foreground" />
                        @if (!item.Read)
                        {
                            <span class="absolute -top-0.5 -right-0.5 size-2 rounded-full bg-blue-500"></span>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="@Cn.Merge("text-sm", item.Read ? "text-muted-foreground" : "font-medium")">
                            @item.Title
                        </span>
                        <p class="mt-0.5 truncate text-muted-foreground text-xs">
                            @item.Description
                        </p>
                    </div>
                    <span class="shrink-0 text-muted-foreground text-xs">
                        @item.Timestamp
                    </span>
                </button>
            }
            @if (!_filteredNotifications.Any())
            {
                <div class="px-4 py-6 text-center">
                    <p class="text-muted-foreground text-sm">No notifications</p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                @_notifications.Length notifications total &middot; @_unreadCount unread
            </p>
        </div>
    </div>
</section>

@code {
    private record NotificationItem(
        string Id,
        string IconName,
        string Title,
        string Description,
        string Timestamp,
        bool Read,
        bool Archived);

    private static readonly NotificationItem[] _initialNotifications =
    [
        new("n1", "message-square", "New comment on Pull Request #142",   "Sarah mentioned you in a review comment on the auth refactor.",      "2h ago",  false, false),
        new("n2", "user-plus",      "Team invitation accepted",            "Alex joined the Engineering workspace.",                              "4h ago",  false, false),
        new("n3", "zap",            "Deployment succeeded",                "Production deploy v2.4.1 completed in 47 seconds.",                  "6h ago",  true,  false),
        new("n4", "git-pull-request","PR #138 merged",                    "Your pull request for the dashboard redesign was merged.",            "1d ago",  true,  false),
        new("n5", "file-text",      "Invoice generated",                   "Monthly invoice for March 2026 is ready to download.",               "2d ago",  false, false),
        new("n6", "settings",       "Security alert resolved",             "Dependency vulnerability in lodash@4.17.20 has been patched.",        "3d ago",  true,  true),
    ];

    private NotificationItem[] _notifications = _initialNotifications.ToArray();
    private string _tab = "all";

    private int _unreadCount => _notifications.Count(n => !n.Read);

    private NotificationItem[] _filteredNotifications => _tab switch
    {
        "unread"   => _notifications.Where(n => !n.Read).ToArray(),
        "archived" => _notifications.Where(n => n.Archived).ToArray(),
        _          => _notifications.Where(n => !n.Archived).ToArray(),
    };

    private void MarkAsRead(string id)
    {
        _notifications = _notifications
            .Select(n => n.Id == id ? n with { Read = true } : n)
            .ToArray();
    }

    private void MarkAllRead()
    {
        _notifications = _notifications
            .Select(n => n with { Read = true })
            .ToArray();
    }

    private void SetTab(string? value)
    {
        _tab = value ?? "all";
    }
}
