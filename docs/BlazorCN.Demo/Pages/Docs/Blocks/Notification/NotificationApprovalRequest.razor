@* ============================================================
   Block: notification-approval-request
   Title: NotificationApprovalRequest
   Description: An approval request notification block for React and Next.js with requester info, request type, priority indicator, deadline, and approve, reject, and view details actions built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-approval-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="check-square" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Approval Needed</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="@($"size-1.5 rounded-full {_priority.DotColor}")"></span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_priority.Label</BadgeCn>
                </div>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                A new approval request requires your review. Please evaluate and respond before the
                deadline.
            </p>
        </div>

        @* Requester *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                    <div class="flex size-7 items-center justify-center rounded-full bg-muted">
                        <LucideIconCn Name="user" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div>
                        <span class="font-medium text-sm">@_request.RequesterName</span>
                        <p class="text-muted-foreground text-xs">@_request.RequesterRole</p>
                    </div>
                </div>
                <span class="text-muted-foreground text-xs">@_request.SubmittedAt</span>
            </div>
        </div>

        @* Request details *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="file-text" Size="12" Class="size-3" />
                <span>@_request.Type</span>
                <span>&middot;</span>
                <span class="font-mono">@_request.Id</span>
            </div>
            <span class="mt-1.5 block font-medium text-sm">@_request.Title</span>
            <p class="mt-1 line-clamp-2 text-muted-foreground text-xs">@_request.Description</p>
        </div>

        @* Deadline *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2 rounded-md bg-muted/50 p-2.5">
                <LucideIconCn Name="clock" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                <span class="text-muted-foreground text-xs">Deadline: @_request.Deadline</span>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">Approve</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">Reject</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 flex-1 text-xs">View Details</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record RequestData(
        string Id,
        string Type,
        string Title,
        string Description,
        string Priority,
        string RequesterName,
        string RequesterRole,
        string Deadline,
        string SubmittedAt
    );

    private record PriorityConfig(string DotColor, string Label);

    private static readonly RequestData _request = new(
        Id: "APR-287",
        Type: "Expense Report",
        Title: "Q1 Marketing Budget Reallocation",
        Description: "Request to reallocate $12,500 from the paid advertising budget to content marketing initiatives for the remainder of Q1. Includes new contractor fees and tooling subscriptions.",
        Priority: "high",
        RequesterName: "Priya Sharma",
        RequesterRole: "Marketing Manager",
        Deadline: "2 days remaining",
        SubmittedAt: "3 hours ago"
    );

    private static readonly Dictionary<string, PriorityConfig> _priorityConfigs = new()
    {
        ["high"]   = new PriorityConfig("bg-red-500",   "High Priority"),
        ["medium"] = new PriorityConfig("bg-amber-500", "Medium Priority"),
        ["low"]    = new PriorityConfig("bg-blue-500",  "Low Priority"),
    };

    private PriorityConfig _priority => _priorityConfigs.TryGetValue(_request.Priority, out var cfg)
        ? cfg
        : new PriorityConfig("bg-muted-foreground", _request.Priority);
}
