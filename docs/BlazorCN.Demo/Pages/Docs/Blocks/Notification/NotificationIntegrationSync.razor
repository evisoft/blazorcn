@* ============================================================
   Block: notification-integration-sync
   Title: NotificationIntegrationSync
   Description: An integration sync status notification block for React and Next.js with progress bar, record counts, error tracking, and sync status indicator built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-integration-sync.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="refresh-cw" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-medium text-sm">Syncing with @_syncData.Integration</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    <span class="@Cn.Merge("mr-1.5 inline-block size-1.5 rounded-full", _currentStatus.Dot)"></span>
                    @_currentStatus.Label
                </BadgeCn>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Importing contacts, deals, and activities from your @_syncData.Integration instance.
            </p>
        </div>

        @* Progress *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Sync Progress</span>
                <span class="font-medium text-xs tabular-nums">@_percentage%</span>
            </div>
            <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-foreground" style="@($"width:{_percentage}%")"></div>
            </div>
        </div>

        @* Stats *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="check-circle" Size="14" Class="size-3.5 text-emerald-600 dark:text-emerald-400" />
                    <span class="text-sm tabular-nums">@_syncData.RecordsSynced.ToString("N0")</span>
                    <span class="text-muted-foreground text-xs">of @_syncData.TotalRecords.ToString("N0") records</span>
                </div>
                @if (_syncData.Errors > 0)
                {
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5 text-red-600 dark:text-red-400" />
                        <span class="text-red-600 text-xs dark:text-red-400">@_syncData.Errors error@(_syncData.Errors != 1 ? "s" : "")</span>
                    </div>
                }
            </div>
        </div>

        @* Last sync + action *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Last sync</span>
                    <p class="mt-0.5 text-sm">@_syncData.LastSync</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View Sync Details</ButtonCn>
            </div>
        </div>

        @* Footer *@
        <div class="px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">Auto-syncs every 15 minutes</p>
        </div>
    </div>
</section>

@code {
    private record SyncData(
        string Integration,
        string Status,
        int RecordsSynced,
        int TotalRecords,
        int Errors,
        string LastSync
    );

    private record StatusConfig(string Label, string Color, string Bg, string Dot);

    private static readonly SyncData _syncData = new(
        "Salesforce",
        "in_progress",
        8427,
        12350,
        3,
        "Mar 24, 2026 at 2:15 PM"
    );

    private static readonly StatusConfig _inProgressStatus = new(
        "In Progress",
        "text-blue-600 dark:text-blue-400",
        "bg-blue-500/10",
        "bg-blue-500"
    );

    private static readonly StatusConfig _completeStatus = new(
        "Complete",
        "text-emerald-600 dark:text-emerald-400",
        "bg-emerald-500/10",
        "bg-emerald-500"
    );

    private static readonly StatusConfig _failedStatus = new(
        "Failed",
        "text-red-600 dark:text-red-400",
        "bg-red-500/10",
        "bg-red-500"
    );

    private StatusConfig _currentStatus => _syncData.Status switch
    {
        "complete" => _completeStatus,
        "failed" => _failedStatus,
        _ => _inProgressStatus,
    };

    private int _percentage => (int)Math.Round((double)_syncData.RecordsSynced / _syncData.TotalRecords * 100);
}
