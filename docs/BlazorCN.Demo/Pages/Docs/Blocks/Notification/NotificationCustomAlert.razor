@* ============================================================
   Block: notification-custom-alert
   Title: NotificationCustomAlert
   Description: A custom alert rule triggered notification block for React and Next.js with trigger condition display, current value versus threshold comparison, metric chart area, and edit rule action built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-custom-alert.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="zap" Size="16" Class="size-4 text-red-600 dark:text-red-400" />
                <span class="font-medium text-sm">Custom alert triggered</span>
                <span class="size-1.5 rounded-full bg-red-500"></span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                An alert rule you configured has been triggered. Review the details and take action.
            </p>
        </div>

        @* Alert rule name *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Alert Rule</span>
            <div class="mt-1 flex items-center gap-2">
                <LucideIconCn Name="bell" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">@_alertRule.Name</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_alertRule.Severity
                </BadgeCn>
            </div>
            <p class="mt-1 font-mono text-muted-foreground text-xs">@_alertRule.Condition</p>
        </div>

        @* Current value vs threshold *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-6">
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Current Value</span>
                    <div class="mt-0.5 flex items-center gap-1">
                        <span class="font-semibold text-2xl tabular-nums text-red-600 dark:text-red-400">
                            @_alertRule.CurrentValue@_alertRule.Unit
                        </span>
                        <LucideIconCn Name="arrow-up" Size="14" Class="size-3.5 text-red-600 dark:text-red-400" />
                    </div>
                </div>
                <div>
                    <span class="font-medium text-muted-foreground text-xs">Threshold</span>
                    <p class="mt-0.5 font-semibold text-2xl tabular-nums">
                        @_alertRule.Threshold@_alertRule.Unit
                    </p>
                </div>
            </div>
        </div>

        @* Recent values *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="activity" Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Recent Values</span>
            </div>
            <div class="mt-2 space-y-1">
                @foreach (var entry in _recentValues)
                {
                    var exceeded = entry.Value > _alertRule.Threshold;
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@entry.Time</span>
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("font-mono tabular-nums", exceeded ? "text-red-600 dark:text-red-400" : "")">
                                @entry.Value@_alertRule.Unit
                            </span>
                            @if (exceeded)
                            {
                                <span class="size-1.5 rounded-full bg-red-500"></span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Server info *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4 text-xs">
                <div>
                    <span class="font-medium text-muted-foreground">Server</span>
                    <p class="mt-0.5 font-mono">@_alertRule.Server</p>
                </div>
                <div>
                    <span class="font-medium text-muted-foreground">Region</span>
                    <p class="mt-0.5">@_alertRule.Region</p>
                </div>
                <div>
                    <span class="font-medium text-muted-foreground">Triggered</span>
                    <p class="mt-0.5">@_alertRule.TriggeredCount times today</p>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">View Metrics</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Edit Rule</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Acknowledge</ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Last triggered @_alertRule.LastTriggered &middot; Alert history: @_alertRule.TriggeredCount events today
            </p>
        </div>
    </div>
</section>

@code {
    private record AlertRule(
        string Name,
        string Condition,
        double CurrentValue,
        double Threshold,
        string Unit,
        string Severity,
        int TriggeredCount,
        string LastTriggered,
        string Server,
        string Region
    );

    private record RecentValue(string Time, double Value);

    private static readonly AlertRule _alertRule = new(
        Name: "High CPU Usage - Production",
        Condition: "CPU utilization > 90% for 5 minutes",
        CurrentValue: 94.2,
        Threshold: 90,
        Unit: "%",
        Severity: "critical",
        TriggeredCount: 3,
        LastTriggered: "12 min ago",
        Server: "prod-web-03",
        Region: "us-east-1"
    );

    private static readonly RecentValue[] _recentValues =
    [
        new("15 min ago", 72),
        new("12 min ago", 85),
        new("10 min ago", 91),
        new("7 min ago", 93),
        new("5 min ago", 94.2),
    ];
}
