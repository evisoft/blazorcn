@* ============================================================
   Block: notification-role-change
   Title: NotificationRoleChange
   Description: A role change notification block for React and Next.js with old and new role transition display, permission list, admin attribution, and effective immediately badge built with shadcn/ui and Tailwind CSS
   Source: original/blocks/notification/notification-role-change.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="user-cog" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">Your role has been updated</span>
            </div>
            <p class="mt-1 text-muted-foreground text-sm">
                Your workspace role has changed. Review your updated permissions below.
            </p>
        </div>

        @* Role transition *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Role Change</span>
            <div class="mt-2 flex items-center gap-3">
                <div class="rounded-md bg-muted/50 px-3 py-1.5">
                    <span class="font-medium text-sm">@_roleChange.OldRole</span>
                </div>
                <LucideIconCn Name="arrow-right" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                <div class="rounded-md bg-foreground/5 px-3 py-1.5 ring-1 ring-foreground/10">
                    <span class="font-medium text-sm">@_roleChange.NewRole</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Effective immediately
                </BadgeCn>
            </div>
        </div>

        @* Permissions list *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Updated Permissions</span>
            <div class="mt-2 space-y-2">
                @foreach (var perm in _newPermissions)
                {
                    <div class="flex items-center gap-2.5">
                        @if (perm.Granted)
                        {
                            <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-emerald-500/10">
                                <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                            </span>
                        }
                        else
                        {
                            <span class="flex size-4 shrink-0 items-center justify-center rounded-full bg-muted">
                                <LucideIconCn Name="lock" Size="10" Class="size-2.5 text-muted-foreground" />
                            </span>
                        }
                        <span class="@(perm.Granted ? "text-sm" : "text-sm text-muted-foreground")">@perm.Label</span>
                    </div>
                }
            </div>
        </div>

        @* Changed by *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="text-muted-foreground text-xs">
                        Changed by <span class="font-medium text-foreground">@_roleChange.ChangedBy</span><span class="text-muted-foreground"> (@_roleChange.ChangedByRole)</span>
                    </span>
                </div>
                <span class="text-muted-foreground text-xs">@_roleChange.Timestamp</span>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">View Permissions</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs">Dismiss</ButtonCn>
        </div>

        @* Footer *@
        <div class="border-t px-4 py-2.5">
            <p class="text-center text-muted-foreground text-xs">
                Role changes are logged in the audit trail
            </p>
        </div>

    </div>
</section>

@code {
    private record RoleChangeData(
        string OldRole,
        string NewRole,
        string ChangedBy,
        string ChangedByRole,
        string Timestamp
    );

    private record PermissionItem(string Id, string Label, bool Granted);

    private static readonly RoleChangeData _roleChange = new(
        OldRole: "Viewer",
        NewRole: "Editor",
        ChangedBy: "Sarah Chen",
        ChangedByRole: "Admin",
        Timestamp: "5 min ago"
    );

    private static readonly PermissionItem[] _newPermissions =
    [
        new("1", "Edit and update documents", true),
        new("2", "Create new projects", true),
        new("3", "Comment on team threads", true),
        new("4", "Manage team members", false),
        new("5", "Access billing settings", false),
    ];
}
