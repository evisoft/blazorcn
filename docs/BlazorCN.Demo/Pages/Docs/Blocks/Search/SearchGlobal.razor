@* ============================================================
   Block: search-global
   Title: SearchGlobal
   Description: A global command search and navigation block for React and Next.js with category grouping, keyboard shortcuts, and interactive results built with shadcn/ui and Tailwind CSS
   Source: original/blocks/search/search-global.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card shadow-2xl shadow-black/5">
        @* Search Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="search" Size="16" Class="size-4 text-muted-foreground" />
            <input
                type="text"
                value="@_query"
                @oninput="@((e) => _query = e.Value?.ToString() ?? "")"
                placeholder="Search for pages, documentation, team..."
                class="h-8 flex-1 border-0 bg-transparent px-0 text-sm shadow-none outline-none focus-visible:ring-0 placeholder:text-muted-foreground" />
            <div class="flex items-center gap-1.5 sm:flex">
                <kbd class="inline-flex h-5 items-center rounded border bg-muted px-1.5 font-mono text-[10px] text-muted-foreground">ESC</kbd>
            </div>
        </div>

        @* Results *@
        <div class="max-h-[400px] overflow-y-auto">
            @foreach (var cat in _categories)
            {
                var catResults = _filteredResults.Where(r => r.Category == cat).ToList();
                if (catResults.Count == 0) continue;
                <div class="py-2">
                    <div class="px-4 py-1.5 text-[10px] font-medium uppercase tracking-wider text-muted-foreground/60">
                        @cat
                    </div>
                    @foreach (var result in catResults)
                    {
                        var item = result;
                        <button type="button"
                                class="group flex w-full items-center gap-3 px-4 py-2 text-left transition-colors hover:bg-muted/50">
                            <div class="flex size-7 items-center justify-center rounded-md border bg-muted/30 transition-colors group-hover:bg-background">
                                <LucideIconCn Name="@item.IconName" Size="14" Class="size-3.5 text-muted-foreground" />
                            </div>
                            <span class="flex-1 text-sm font-medium">@item.Title</span>
                            <div class="hidden items-center gap-1 opacity-0 transition-opacity group-hover:opacity-100 sm:flex">
                                <kbd class="inline-flex h-5 items-center rounded border bg-muted px-1.5 font-mono text-[10px] text-muted-foreground">
                                    <LucideIconCn Name="command" Size="10" Class="mr-0.5 size-2.5" />
                                    ENTER
                                </kbd>
                            </div>
                        </button>
                    }
                </div>
            }

            @if (_filteredResults.Count == 0)
            {
                <div class="flex flex-col items-center justify-center py-12 text-center">
                    <div class="flex size-10 items-center justify-center rounded-full bg-muted/50">
                        <LucideIconCn Name="search" Size="20" Class="size-5 text-muted-foreground/60" />
                    </div>
                    <p class="mt-4 text-sm font-medium">No results found</p>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Try searching for something else or check your spelling.
                    </p>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t bg-muted/30 px-4 py-2.5">
            <div class="flex items-center gap-4 text-xs text-muted-foreground">
                <div class="flex items-center gap-1.5">
                    <kbd class="inline-flex h-4 items-center rounded border bg-muted px-1 font-mono text-[9px] text-muted-foreground">↑↓</kbd>
                    <span>Navigate</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <kbd class="inline-flex h-4 items-center rounded border bg-muted px-1 font-mono text-[9px] text-muted-foreground">↵</kbd>
                    <span>Select</span>
                </div>
            </div>
            <span class="text-[10px] font-medium text-muted-foreground/60">
                @_filteredResults.Count @(_filteredResults.Count == 1 ? "result" : "results")
            </span>
        </div>
    </div>
</section>

@code {
    private record SearchResult(string Id, string Title, string Category, string IconName, string Href);

    private static readonly string[] _categories = ["Pages", "Documentation", "Team", "Settings"];

    private static readonly SearchResult[] _results =
    [
        new("1", "Dashboard Overview",       "Pages",         "layout",    "#"),
        new("2", "Project Analytics",        "Pages",         "file",      "#"),
        new("3", "API Documentation",        "Documentation", "book",      "#"),
        new("4", "Authentication Guide",     "Documentation", "book",      "#"),
        new("5", "Sarah Chen (Admin)",       "Team",          "user",      "#"),
        new("6", "Marcus Wright (Developer)","Team",          "user",      "#"),
        new("7", "Workspace Settings",       "Settings",      "settings",  "#"),
        new("8", "Billing & Invoices",       "Settings",      "settings",  "#"),
    ];

    private string _query = "";

    private List<SearchResult> _filteredResults =>
        _results.Where(r => r.Title.Contains(_query, StringComparison.OrdinalIgnoreCase)).ToList();
}
