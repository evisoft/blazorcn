@* ============================================================
   Block: profile-lawyer-practice
   Title: ProfileLawyerPractice
   Description: React lawyer practice profile block for Next.js with practice areas, case statistics, bar admissions, and client testimonial sections using shadcn/ui, Tailwind CSS, and framer-motion animations
   Source: original/blocks/profile/profile-lawyer-practice.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Attorney header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Catherine Rhodes, Esq." />
                <AvatarFallbackCn Class="text-lg">CR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Catherine Rhodes, Esq.</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="scale" Size="12" Class="mr-1 size-3" />
                        Senior Partner
                    </BadgeCn>
                </div>
                <p class="mt-0.5 text-muted-foreground text-xs">Rhodes &amp; Associates LLP</p>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">25+ years in complex commercial litigation and intellectual property law. Former federal clerk, Harvard Law School.</p>
                <div class="mt-2 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        New York, NY
                    </span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="phone" Size="12" Class="size-3" />
                        (212) 555-0142
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Consultation
            </ButtonCn>
        </div>

        @* Key metrics *@
        <div class="grid grid-cols-4 border-b">
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Experience</span>
                <div class="flex items-baseline gap-0.5">
                    <span class="font-semibold text-lg tabular-nums">26</span>
                    <span class="text-muted-foreground text-xs">years</span>
                </div>
            </div>
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Cases won</span>
                <span class="font-semibold text-lg tabular-nums">342</span>
            </div>
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Win rate</span>
                <span class="font-semibold text-lg text-emerald-600 tabular-nums dark:text-emerald-400">94%</span>
            </div>
            <div class="px-4 py-3">
                <span class="block text-muted-foreground text-xs">Rating</span>
                <div class="flex items-center gap-1">
                    <span class="font-semibold text-lg tabular-nums">4.9</span>
                    <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" />
                </div>
            </div>
        </div>

        @* Practice areas *@
        <div class="border-b">
            <div class="flex items-center gap-2 border-b px-4 py-2">
                <LucideIconCn Name="briefcase" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Practice areas</span>
            </div>
            @foreach (var area in _practiceAreas)
            {
                var isNotLast = area != _practiceAreas[_practiceAreas.Length - 1];
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isNotLast ? "border-b" : ""))">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-sm">@area.Name</span>
                        <div class="flex items-center gap-3 text-xs">
                            <span class="text-muted-foreground">
                                <span class="font-medium tabular-nums">@area.Cases</span> cases
                            </span>
                            <span class="font-medium text-emerald-600 tabular-nums dark:text-emerald-400">@area.WinRate% won</span>
                        </div>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">@area.Description</p>
                </div>
            }
        </div>

        @* Bar admissions *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                <LucideIconCn Name="gavel" Size="12" Class="size-3" />
                Bar admissions
            </span>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var bar in _barAdmissions)
                {
                    <div class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                        <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-emerald-500" />
                        <div>
                            <span class="font-medium text-xs">@bar.State</span>
                            <span class="ml-1.5 text-muted-foreground text-xs">@bar.Year</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Recognitions *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                <LucideIconCn Name="award" Size="12" Class="size-3" />
                Recognition
            </span>
            <div class="space-y-1">
                @foreach (var rec in _recognitions)
                {
                    <div class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="check" Size="12" Class="size-3 text-muted-foreground" />
                        <span>@rec</span>
                    </div>
                }
            </div>
        </div>

        @* Client testimonials *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                    <LucideIconCn Name="book-open" Size="12" Class="size-3" />
                    Client testimonials
                </span>
            </div>
            @foreach (var t in _testimonials)
            {
                var tIsNotLast = t != _testimonials[_testimonials.Length - 1];
                <div class="@(Cn.Merge("px-4 py-3", tIsNotLast ? "border-b" : ""))">
                    <p class="text-sm leading-relaxed italic">@("\"")@t.Text@("\"")</p>
                    <div class="mt-1.5 flex items-center gap-2 text-muted-foreground text-xs">
                        <span class="font-medium">@t.Initials</span>
                        <div class="w-px h-3 bg-border"></div>
                        <span>@t.CaseType</span>
                    </div>
                </div>
            }
            <div class="px-4 py-2">
                <p class="text-muted-foreground text-xs italic">
                    Prior results do not guarantee a similar outcome.
                </p>
            </div>
        </div>

    </div>
</section>

@code {
    private record PracticeArea(string Name, int Cases, int WinRate, string Description);
    private record BarAdmission(string State, string Year, string Status);
    private record Testimonial(string Id, string Initials, string Text, string CaseType);

    private static readonly PracticeArea[] _practiceAreas = [
        new("Intellectual Property", 128, 96, "Patent litigation, trademark disputes, trade secret protection"),
        new("Commercial Litigation", 94, 93, "Contract disputes, business torts, shareholder litigation"),
        new("Employment Law", 67, 91, "Wrongful termination, discrimination claims, non-compete enforcement"),
        new("Corporate M&A", 53, 97, "Due diligence, transaction structuring, regulatory compliance"),
    ];

    private static readonly BarAdmission[] _barAdmissions = [
        new("New York", "1999", "Active"),
        new("Connecticut", "2002", "Active"),
        new("New Jersey", "2004", "Active"),
        new("U.S. Supreme Court", "2008", "Active"),
    ];

    private static readonly Testimonial[] _testimonials = [
        new("t1", "R.M.", "Catherine's strategic approach to our patent case was exceptional. She secured a favorable settlement in half the expected timeline.", "Patent Litigation"),
        new("t2", "D.K.", "Thorough preparation and clear communication throughout a complex commercial dispute. Highly recommended for business litigation.", "Commercial Litigation"),
    ];

    private static readonly string[] _recognitions = [
        "Super Lawyers — Top 50 (2020-2025)",
        "Best Lawyers in America — IP Litigation",
        "Chambers USA — Band 1",
        "Martindale-Hubbell AV Preeminent",
    ];
}
