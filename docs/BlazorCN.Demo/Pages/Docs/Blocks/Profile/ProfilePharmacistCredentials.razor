@* ============================================================
   Block: profile-pharmacist-credentials
   Title: ProfilePharmacistCredentials
   Description: React pharmacist credentials profile block for Next.js with license verification, specialization badges, pharmacy affiliation, medication expertise areas, and patient consultation stats using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-pharmacist-credentials.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Dr. Angela Reyes, PharmD" />
                <AvatarFallbackCn Class="text-lg">AR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Dr. Angela Reyes, PharmD</span>
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-blue-500" />
                </div>
                <span class="text-muted-foreground text-xs">Clinical Pharmacist</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="pill" Size="12" Class="size-3" />
                        Summit Health Pharmacy
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Philadelphia, PA
                    </span>
                </div>
                <div class="mt-0.5 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="font-mono">PA RPH #042891</span>
                    <span>·</span>
                    <span>14 years</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Consult
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">6.2K</span>
                <span class="text-muted-foreground text-xs">Patients</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">320</span>
                <span class="text-muted-foreground text-xs">Monthly consults</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">4.8</span>
                <span class="text-muted-foreground text-xs">Rating</span>
            </div>
        </div>

        @* Specializations *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Specializations
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var spec in _specializations)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@($"size-1.5 rounded-full {spec.Color}")"></span>
                        @spec.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Credentials *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Board Certifications
            </span>
            <div class="space-y-2">
                @foreach (var cred in _credentials)
                {
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="shield-check" Size="16" Class="size-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@cred.Name</span>
                            <span class="ml-2 text-muted-foreground text-xs">@cred.Institution, @cred.Year</span>
                        </div>
                        @if (cred.Verified)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 gap-1 px-1.5 font-normal text-[10px]">
                                <LucideIconCn Name="check-circle-2" Size="10" Class="size-2.5" />
                                Verified
                            </BadgeCn>
                        }
                    </div>
                }
            </div>
        </div>

        @* Expertise Areas *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Expertise Areas</span>
            </div>
            @for (var i = 0; i < _expertiseAreas.Length; i++)
            {
                var idx = i;
                var item = _expertiseAreas[idx];
                <div class="@(Cn.Merge("flex items-center justify-between px-4 py-2.5", idx < _expertiseAreas.Length - 1 ? "border-b" : ""))">
                    <span class="font-medium text-sm">@item.Area</span>
                    <span class="flex items-center gap-1 text-muted-foreground text-xs tabular-nums">
                        <LucideIconCn Name="clipboard-list" Size="12" Class="size-3" />
                        @item.Consultations.ToString("N0")
                    </span>
                </div>
            }
        </div>

        @* Services *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Services Offered
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var svc in _services)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@svc</BadgeCn>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record SpecializationItem(string Name, string Color);
    private record CredentialItem(string Name, string Institution, string Year, bool Verified);
    private record ExpertiseItem(string Area, int Consultations);

    private static readonly SpecializationItem[] _specializations = [
        new("Oncology Pharmacy", "bg-purple-500"),
        new("Geriatric Care", "bg-blue-500"),
        new("Medication Therapy Management", "bg-emerald-500"),
        new("Immunization", "bg-amber-500"),
        new("Compounding", "bg-pink-500"),
    ];

    private static readonly CredentialItem[] _credentials = [
        new("Doctor of Pharmacy (PharmD)", "University of Pennsylvania", "2010", true),
        new("Board Certified Oncology Pharmacist (BCOP)", "BPS", "2015", true),
        new("Board Certified Geriatric Pharmacist (BCGP)", "BPS", "2018", true),
        new("Immunization Certification", "APhA", "2012", true),
    ];

    private static readonly ExpertiseItem[] _expertiseAreas = [
        new("Chemotherapy Protocols", 1240),
        new("Drug Interaction Review", 2180),
        new("Medicare Part D Optimization", 890),
        new("Chronic Disease Management", 1560),
        new("Pain Management", 720),
    ];

    private static readonly string[] _services = [
        "Medication Therapy Management",
        "Immunizations",
        "Health Screenings",
        "Compounding",
        "Medication Synchronization",
        "Diabetes Education",
    ];
}
