@* ============================================================
   Block: profile-team-member-detail
   Title: ProfileTeamMemberDetail
   Description: React detailed team member profile for Next.js with skills progress bars, current projects list, availability status indicator, and schedule meeting button using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-team-member-detail.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Profile header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <div class="relative">
                <AvatarCn Class="size-14">
                    <AvatarImageCn Src="@_member.Avatar" Alt="@_member.Name" />
                    <AvatarFallbackCn Class="text-lg">TG</AvatarFallbackCn>
                </AvatarCn>
                <span class="@Cn.Merge("absolute -bottom-0.5 -right-0.5 size-3.5 rounded-full border-2 border-card", _avail.Dot)"></span>
            </div>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_member.Name</span>
                    <span class="flex items-center gap-1 text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _avail.Dot)"></span>
                        <span class="text-muted-foreground">@_avail.Label</span>
                    </span>
                </div>
                <span class="mt-0.5 block text-muted-foreground text-sm">@_member.Title</span>
                <div class="mt-2 flex flex-wrap gap-1.5">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_member.Team
                    </BadgeCn>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">
                        @_member.Location
                    </BadgeCn>
                </div>
            </div>
            <div class="flex shrink-0 gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="mail" Size="12" Class="size-3" />
                    Email
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                    Schedule
                </ButtonCn>
            </div>
        </div>

        @* Working hours *@
        <div class="flex items-center gap-4 border-b px-4 py-2.5 text-xs text-muted-foreground">
            <span class="flex items-center gap-1.5">
                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                @_member.WorkingHours @_member.Timezone
            </span>
            <span class="text-muted-foreground">&middot;</span>
            <span>Reports to @_member.Manager</span>
        </div>

        @* Skills section *@
        <div class="border-b px-4 py-4">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">
                Skills &amp; proficiency
            </span>
            <div class="space-y-3">
                @foreach (var skill in _skills)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-28 shrink-0 text-sm">@skill.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/70" style="@($"width:{skill.Level}%")"></div>
                        </div>
                        <span class="w-8 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                            @skill.Level%
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Current projects *@
        <div>
            <div class="border-b px-4 py-2.5">
                <span class="font-medium text-muted-foreground text-xs">Current projects</span>
            </div>
            @for (var i = 0; i < _projects.Length; i++)
            {
                var project = _projects[i];
                var isLast = i == _projects.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _statusDot[project.Status])"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@project.Name</span>
                        <span class="ml-2 text-muted-foreground text-xs">@project.Role</span>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="font-mono font-normal text-xs">
                        @project.Allocation
                    </BadgeCn>
                    <LucideIconCn Name="external-link" Size="14" Class="size-3.5 text-muted-foreground/60" />
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MemberInfo(string Name, string Title, string Team, string Avatar, string Email,
        string Location, string Timezone, string WorkingHours, string Availability, string Manager);

    private record SkillItem(string Name, int Level);

    private record ProjectItem(string Id, string Name, string Role, string Status, string Allocation);

    private record AvailabilityInfo(string Dot, string Label);

    private static readonly MemberInfo _member = new(
        "Tomás García",
        "Senior Frontend Engineer",
        "Platform",
        "",
        "tomas.garcia@@acmecorp.com",
        "Madrid, Spain",
        "CET (UTC+1)",
        "9:00 AM – 6:00 PM",
        "available",
        "Lisa Chen"
    );

    private static readonly SkillItem[] _skills =
    [
        new("React", 95),
        new("TypeScript", 90),
        new("Next.js", 88),
        new("CSS / Tailwind", 85),
        new("Node.js", 72),
        new("PostgreSQL", 65),
    ];

    private static readonly ProjectItem[] _projects =
    [
        new("1", "Design System v3", "Tech Lead", "active", "60%"),
        new("2", "Dashboard Redesign", "IC Contributor", "active", "25%"),
        new("3", "API Migration", "Reviewer", "review", "10%"),
        new("4", "Mobile App Launch", "Advisor", "completed", "5%"),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        { "active", "bg-emerald-500" },
        { "review", "bg-amber-500" },
        { "completed", "bg-blue-500" },
    };

    private static readonly Dictionary<string, AvailabilityInfo> _availabilityConfig = new()
    {
        { "available", new("bg-emerald-500", "Available") },
        { "busy", new("bg-amber-500", "In a meeting") },
        { "unavailable", new("bg-red-500", "Out of office") },
    };

    private AvailabilityInfo _avail => _availabilityConfig[_member.Availability];
}
