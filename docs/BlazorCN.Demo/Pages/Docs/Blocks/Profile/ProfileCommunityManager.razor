@* ============================================================
   Block: profile-community-manager
   Title: ProfileCommunityManager
   Description: React community manager profile block for Next.js with engagement stats, community growth metrics, event calendar, and moderation activity using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-community-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="@_profile.Avatar" Alt="@_profile.Name" />
                <AvatarFallbackCn>PS</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_profile.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_profile.Company</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">@_profile.Title</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">@_profile.Bio</p>
            </div>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideUsersCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_profile.Members.ToString("N0")</span>
                <span class="text-muted-foreground">members</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideHeartCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_profile.Engagement</span>
                <span class="text-muted-foreground">engagement</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideCalendarCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_profile.Events</span>
                <span class="text-muted-foreground">events hosted</span>
            </span>
        </div>

        @* Channels *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Channels</span>
            <div class="space-y-2">
                @foreach (var ch in _channels)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span>@ch.Name</span>
                        <div class="flex items-center gap-3">
                            <span class="font-medium tabular-nums">@ch.Members</span>
                            <span class="flex items-center gap-1 text-emerald-500">
                                <LucideTrendingUpCn Size="12" Class="size-3" />
                                @ch.Growth
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Upcoming Events *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Upcoming Events</span>
            </div>
            @for (var i = 0; i < _upcomingEvents.Length; i++)
            {
                var evt = _upcomingEvents[i];
                var isLast = i == _upcomingEvents.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@evt.Title</span>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span>@evt.Date</span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@evt.Type</BadgeCn>
                        </div>
                    </div>
                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                        <LucideUsersCn Size="12" Class="size-3" />
                        @evt.Attendees
                    </span>
                </div>
            }
        </div>

        @* Top Contributors *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Top Contributors</span>
            </div>
            @for (var i = 0; i < _topContributors.Length; i++)
            {
                var c = _topContributors[i];
                var initials = GetInitials(c.Name);
                var isLast = i == _topContributors.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <AvatarCn Class="size-6">
                        <AvatarFallbackCn Class="text-xs">@initials</AvatarFallbackCn>
                    </AvatarCn>
                    <span class="font-medium text-sm">@c.Name</span>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@c.Role</BadgeCn>
                    <span class="ml-auto flex items-center gap-1 text-muted-foreground text-xs">
                        <LucideMessageSquareCn Size="12" Class="size-3" />
                        @c.Contributions
                    </span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record ProfileData(string Name, string Title, string Avatar, string Company, string Bio, int Members, string Engagement, int Events);
    private record ChannelItem(string Name, string Members, string Growth);
    private record EventItem(string Id, string Title, string Date, string Type, int Attendees);
    private record ContributorItem(string Name, int Contributions, string Role);

    private static readonly ProfileData _profile = new(
        Name: "Priya Sharma",
        Title: "Community Lead",
        Avatar: "",
        Company: "Vercel",
        Bio: "Building and nurturing developer communities. Previously led communities at Hashnode and Supabase. Passionate about inclusive spaces and meaningful connections.",
        Members: 48200,
        Engagement: "12.4%",
        Events: 86
    );

    private static readonly ChannelItem[] _channels =
    [
        new("Discord", "24.8K", "+12%"),
        new("GitHub Discussions", "15.2K", "+8%"),
        new("Twitter/X", "8.2K", "+22%"),
    ];

    private static readonly EventItem[] _upcomingEvents =
    [
        new("e1", "Next.js Community Meetup", "Apr 2, 2026", "Virtual", 320),
        new("e2", "Open Source Friday AMA", "Apr 4, 2026", "Discord", 150),
        new("e3", "Hackathon Kickoff", "Apr 12, 2026", "Hybrid", 500),
        new("e4", "Community Showcase", "Apr 18, 2026", "Virtual", 240),
    ];

    private static readonly ContributorItem[] _topContributors =
    [
        new("Alex Rivera", 142, "Moderator"),
        new("Sam Chen", 98, "Champion"),
        new("Jordan Lee", 87, "Champion"),
        new("Morgan Davis", 74, "Helper"),
    ];

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ');
        return string.Concat(parts.Select(p => p.Length > 0 ? p[0].ToString() : ""));
    }
}
