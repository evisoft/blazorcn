@* ============================================================
   Block: profile-investor-portfolio
   Title: ProfileInvestorPortfolio
   Description: React investor portfolio profile block for Next.js with asset allocation breakdown, holdings table, total returns display, and sector exposure using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-investor-portfolio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Investor header *@
        <div class="flex items-center gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="Marcus Chen" />
                <AvatarFallbackCn>MC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Marcus Chen</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Growth &amp; Value
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Member since 2019</span>
            </div>
        </div>

        @* Portfolio summary *@
        <div class="flex items-center gap-6 border-b px-4 py-4">
            <div>
                <span class="text-muted-foreground text-xs">Total Value</span>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">@FormatCurrency(284930)</span>
                </div>
            </div>
            <div class="flex flex-col items-start">
                <span class="text-muted-foreground text-xs">Total Return</span>
                <div class="flex items-center gap-1">
                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                    <span class="font-medium text-emerald-600 text-sm tabular-nums dark:text-emerald-400">
                        @FormatCurrency(47820) (20.2%)
                    </span>
                </div>
            </div>
            <div class="flex flex-col items-start">
                <span class="text-muted-foreground text-xs">YTD</span>
                <span class="flex items-center gap-1 font-medium text-emerald-600 text-sm tabular-nums dark:text-emerald-400">
                    <LucideIconCn Name="trending-up" Size="12" Class="size-3" />+8.7%
                </span>
            </div>
        </div>

        @* Allocation bars *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Allocation</span>
            <div class="mb-2 flex h-2 overflow-hidden rounded-full">
                @for (var i = 0; i < _allocation.Length; i++)
                {
                    var alloc = _allocation[i];
                    var isFirst = i == 0;
                    var isLast = i == _allocation.Length - 1;
                    <div class="@Cn.Merge("h-full", alloc.Color, isFirst ? "rounded-l-full" : "", isLast ? "rounded-r-full" : "")"
                         style="@($"width:{alloc.Pct}%")"></div>
                }
            </div>
            <div class="flex flex-wrap gap-3">
                @foreach (var alloc in _allocation)
                {
                    <span class="flex items-center gap-1.5 text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", alloc.Color)"></span>
                        <span class="text-muted-foreground">@alloc.Label</span>
                        <span class="tabular-nums">@(alloc.Pct)%</span>
                    </span>
                }
            </div>
        </div>

        @* Holdings *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Holdings</span>
            </div>
            @for (var idx = 0; idx < _holdings.Length; idx++)
            {
                var holding = _holdings[idx];
                var isLast = idx == _holdings.Length - 1;
                var isExpanded = _expanded == holding.Id;
                var isPositive = holding.ReturnPct >= 0;
                <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => { var hid = holding.Id; _expanded = _expanded == hid ? null : hid; })"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="flex size-8 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="wallet" Size="14" Class="size-3.5 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@holding.Ticker</span>
                                <span class="truncate text-muted-foreground text-xs">@holding.Name</span>
                            </div>
                            <span class="text-muted-foreground text-xs">@(holding.Shares) shares</span>
                        </div>
                        <div class="text-right">
                            <span class="block font-medium text-sm tabular-nums">@FormatCurrency(holding.Value)</span>
                            <span class="@Cn.Merge("flex items-center justify-end gap-0.5 text-xs tabular-nums", isPositive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                @if (isPositive)
                                {
                                    <LucideIconCn Name="arrow-up-right" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideIconCn Name="arrow-down-right" Size="12" Class="size-3" />
                                }
                                @(isPositive ? "+" : "")@(holding.ReturnPct)%
                            </span>
                        </div>
                        <LucideIconCn Name="chevron-right"
                                      Size="16"
                                      Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-14">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="grid grid-cols-3 gap-4 text-xs">
                                    <div>
                                        <span class="text-muted-foreground">Avg Cost</span>
                                        <span class="mt-0.5 block tabular-nums">$@(holding.AvgCost.ToString("F2"))</span>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Current</span>
                                        <span class="mt-0.5 block tabular-nums">$@(holding.CurrentPrice.ToString("F2"))</span>
                                    </div>
                                    <div>
                                        <span class="text-muted-foreground">Sector</span>
                                        <span class="mt-0.5 block">@holding.Sector</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>

@code {
    private string? _expanded = null;

    private record Holding(string Id, string Ticker, string Name, int Shares, double AvgCost, double CurrentPrice, int Value, double ReturnPct, string Sector);
    private record Allocation(string Label, int Pct, string Color);

    private static readonly Holding[] _holdings =
    [
        new("h1", "AAPL", "Apple Inc.",           150, 142.3,  189.84, 28476, 33.4,  "Technology"),
        new("h2", "NVDA", "NVIDIA Corp.",           45, 480.2,  878.36, 39526, 82.9,  "Technology"),
        new("h3", "MSFT", "Microsoft Corp.",        80, 312.5,  420.72, 33658, 34.6,  "Technology"),
        new("h4", "JPM",  "JPMorgan Chase",        100, 148.9,  198.47, 19847, 33.3,  "Financials"),
        new("h5", "JNJ",  "Johnson & Johnson",  60, 162.4,  155.18,  9311, -4.4,  "Healthcare"),
        new("h6", "VTI",  "Vanguard Total Stock",  200, 218.7,  262.34, 52468, 20.0,  "Index Fund"),
    ];

    private static readonly Allocation[] _allocation =
    [
        new("Technology",  42, "bg-blue-500"),
        new("Index Funds", 28, "bg-emerald-500"),
        new("Financials",  14, "bg-amber-500"),
        new("Healthcare",   9, "bg-purple-500"),
        new("Cash",         7, "bg-muted-foreground"),
    ];

    private static string FormatCurrency(int n) =>
        n.ToString("C0", new System.Globalization.CultureInfo("en-US"));
}
