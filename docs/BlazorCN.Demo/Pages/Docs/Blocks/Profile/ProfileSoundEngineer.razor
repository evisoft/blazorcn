@* ============================================================
   Block: profile-sound-engineer
   Title: ProfileSoundEngineer
   Description: React sound engineer profile block for Next.js with studio credits, equipment list, genre specialties, session rates, and client testimonials using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-sound-engineer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="@_engineer.Avatar" Alt="@_engineer.Name" />
                <AvatarFallbackCn Class="text-lg">AW</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_engineer.Name</span>
                    @if (_engineer.Grammy > 0)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                            <LucideIconCn Name="award" Size="12" Class="mr-1 size-3" />
                            @_engineer.Grammy@("x") Grammy
                        </BadgeCn>
                    }
                </div>
                <span class="text-muted-foreground text-xs">@_engineer.Title</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="headphones" Size="12" Class="size-3" />
                        @_engineer.Studio
                    </span>
                    <span>&middot;</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        @_engineer.Location
                    </span>
                </div>
                <div class="mt-0.5 flex items-center gap-3 text-muted-foreground text-xs">
                    <span>@_engineer.YearsExperience years</span>
                    <span>&middot;</span>
                    <span class="tabular-nums">@_engineer.ProjectsCompleted projects</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Book
            </ButtonCn>
        </div>

        @* Genres *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Genre Specialties
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var g in _genres)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@($"size-1.5 rounded-full {g.Color}")"></span>
                        @g.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Credits *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Studio Credits</span>
            </div>
            @for (var i = 0; i < _credits.Length; i++)
            {
                var credit = _credits[i];
                var isLast = i == _credits.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="music-2" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="font-medium text-sm">@credit.Artist</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@credit.Project</span>
                                <span>&middot;</span>
                                <span>@credit.Role</span>
                                <span>&middot;</span>
                                <span>@credit.Year</span>
                            </div>
                        </div>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                            @credit.Streams streams
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Rates *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Session Rates</span>
            </div>
            @for (var i = 0; i < _rates.Length; i++)
            {
                var rate = _rates[i];
                var isLast = i == _rates.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="font-medium text-sm">@rate.Service</span>
                    <span class="font-medium text-sm tabular-nums">@rate.Rate</span>
                </div>
            }
        </div>

        @* Equipment *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Key Equipment
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var equip in _equipment)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@equip</BadgeCn>
                }
            </div>
        </div>

        @* Testimonials *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Client Testimonials
            </span>
            <div class="space-y-2">
                @foreach (var t in _testimonials)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-sm leading-relaxed">"@t.Text"</p>
                        <span class="mt-2 block font-medium text-muted-foreground text-xs">
                            @t.Name
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record EngineerInfo(string Name, string Avatar, string Title, string Studio, string Location,
        int YearsExperience, int ProjectsCompleted, int Grammy, double Rating);

    private static readonly EngineerInfo _engineer = new(
        "Andre Williams", "", "Senior Mixing & Mastering Engineer",
        "Platinum Sound Studios", "Nashville, TN", 14, 520, 2, 4.9);

    private record GenreItem(string Name, string Color);

    private static readonly GenreItem[] _genres =
    [
        new("Hip-Hop", "bg-purple-500"),
        new("R&B", "bg-pink-500"),
        new("Pop", "bg-blue-500"),
        new("Country", "bg-amber-500"),
        new("Rock", "bg-red-500"),
        new("Electronic", "bg-cyan-500"),
    ];

    private record CreditItem(string Id, string Artist, string Project, string Role, string Year, string Streams);

    private static readonly CreditItem[] _credits =
    [
        new("c1", "Aria Johnson", "Midnight Frequency (Album)", "Mixing & Mastering", "2026", "248M"),
        new("c2", "The Midnight Sons", "Electric Revival (Album)", "Mixing", "2025", "186M"),
        new("c3", "Kendra Cole", "Wildflower (Single)", "Mastering", "2025", "142M"),
        new("c4", "Various Artists", "Nashville Sessions Vol. 3", "Recording & Mixing", "2025", "54M"),
        new("c5", "Leo Park", "Neon Dreams (EP)", "Mixing & Mastering", "2024", "89M"),
    ];

    private static readonly string[] _equipment =
    [
        "Pro Tools HDX", "SSL 4000G+", "Neve 1073", "Neumann U87",
        "ATC SCM150", "Manley Massive Passive", "Universal Audio Apollo",
    ];

    private record RateItem(string Service, string Rate);

    private static readonly RateItem[] _rates =
    [
        new("Mixing (per track)", "$500 - $1,200"),
        new("Mastering (per track)", "$150 - $300"),
        new("Recording Session (per hour)", "$200"),
        new("Full Album Package", "$8,000 - $15,000"),
    ];

    private record TestimonialItem(string Name, string Text);

    private static readonly TestimonialItem[] _testimonials =
    [
        new("Aria Johnson", "Andre brings tracks to life. His mixing on Midnight Frequency was flawless."),
        new("Leo Park", "Incredible ear for detail. Made my EP sound way beyond what I thought possible."),
    ];
}
