@* ============================================================
   Block: profile-web-developer
   Title: ProfileWebDeveloper
   Description: React web developer profile block for Next.js with technology stack visualization, project portfolio, GitHub stats, framework expertise bars, and deployment platform badges using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-web-developer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarFallbackCn Class="text-lg">RN</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Ryan Nakamura</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="code" Size="12" Class="mr-1 size-3" />
                        Full-Stack
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Full-Stack Web Developer</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span>Freelance</span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Seattle, WA
                    </span>
                    <span>·</span>
                    <span>7 years</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Hire
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="grid grid-cols-4 border-b">
            @foreach (var stat in _stats)
            {
                <div class="px-3 py-3 text-center">
                    <span class="block font-semibold text-sm tabular-nums">@stat.Value</span>
                    <span class="text-muted-foreground text-xs">@stat.Label</span>
                </div>
            }
        </div>

        @* Tech stack with proficiency *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Tech Stack</span>
            <div class="space-y-2.5">
                @foreach (var tech in _techStack)
                {
                    <div>
                        <div class="mb-1 flex items-center justify-between text-xs">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 rounded-full", tech.Color)"></span>
                                <span class="font-medium">@tech.Name</span>
                            </div>
                            <span class="text-muted-foreground tabular-nums">@(tech.Years)y · @(tech.Proficiency)%</span>
                        </div>
                        <ProgressCn Value="@tech.Proficiency" Class="h-1.5" aria-label="Progress" />
                    </div>
                }
            </div>
        </div>

        @* Deployment platforms *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Platforms</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var platform in _platforms)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@platform</BadgeCn>
                }
            </div>
        </div>

        @* Projects *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Featured Projects</span>
            </div>
            @for (var i = 0; i < _projects.Length; i++)
            {
                var project = _projects[i];
                var isLast = i == _projects.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="git-branch" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="font-medium text-sm text-blue-600 dark:text-blue-400">@project.Name</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@project.Description</p>
                            <div class="mt-1.5 flex flex-wrap gap-1">
                                @foreach (var tag in project.Stack)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">@tag</BadgeCn>
                                }
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                <LucideIconCn Name="star" Size="12" Class="size-3" />
                                <span class="tabular-nums">@project.Stars</span>
                            </span>
                            <LucideIconCn Name="external-link" Size="12" Class="size-3 text-muted-foreground" />
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StatItem(string Label, string Value);
    private record TechSkill(string Name, int Proficiency, int Years, string Color);
    private record ProjectItem(string Id, string Name, string Description, string[] Stack, int Stars, string Url);

    private static readonly StatItem[] _stats =
    [
        new("Contributions", "2.8K"),
        new("Projects", "64"),
        new("Stars earned", "1.4K"),
        new("NPM downloads", "340K"),
    ];

    private static readonly TechSkill[] _techStack =
    [
        new("TypeScript", 96, 5, "bg-blue-500"),
        new("React/Next.js", 98, 6, "bg-cyan-500"),
        new("Node.js", 90, 6, "bg-emerald-500"),
        new("PostgreSQL", 85, 4, "bg-blue-600"),
        new("Tailwind CSS", 95, 4, "bg-sky-500"),
        new("Python", 78, 3, "bg-amber-500"),
    ];

    private static readonly string[] _platforms = ["Vercel", "AWS", "Supabase", "Cloudflare", "Docker", "GitHub Actions"];

    private static readonly ProjectItem[] _projects =
    [
        new("p1", "FormKit Pro", "Type-safe form builder for React with validation", ["TypeScript", "React", "Zod"], 420, "#"),
        new("p2", "EdgeDB Client", "Next.js integration for EdgeDB with server actions", ["Next.js", "EdgeDB", "TypeScript"], 318, "#"),
        new("p3", "Pixel Motion", "Lightweight animation library for web components", ["TypeScript", "Web Components"], 246, "#"),
        new("p4", "API Gateway", "Rate-limited API gateway with caching layer", ["Node.js", "Redis", "Docker"], 189, "#"),
    ];
}
