@* ============================================================
   Block: profile-public-speaker
   Title: ProfilePublicSpeaker
   Description: React public speaker profile block for Next.js with talk archive, conference history, topic expertise, audience reach metrics, and booking availability using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-public-speaker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarFallbackCn Class="text-lg">CB</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_speaker.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="star" Size="12" Class="mr-1 size-3 fill-amber-500 text-amber-500" />
                        @_speaker.Rating
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">@_speaker.Title</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        @_speaker.Location
                    </span>
                    <span>&middot;</span>
                    <span class="font-medium text-foreground">@_speaker.Fee</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Book
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">@_speaker.TotalTalks</span>
                <span class="text-muted-foreground text-xs">Talks</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">@FormatAudience(_speaker.TotalAudience)</span>
                <span class="text-muted-foreground text-xs">Audience reach</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">@_speaker.Countries</span>
                <span class="text-muted-foreground text-xs">Countries</span>
            </div>
        </div>

        @* Topics *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Speaking Topics</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var t in _topics)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", t.Color)"></span>
                        @t.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Talk archive *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Talk Archive</span>
            </div>
            @for (var i = 0; i < _talks.Length; i++)
            {
                var talk = _talks[i];
                var isLast = i == _talks.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="mic" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="font-medium text-sm">@talk.Title</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-muted-foreground text-xs">
                                <span>@talk.Conference</span>
                                <span>&middot;</span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="globe" Size="12" Class="size-3" />
                                    @talk.Location
                                </span>
                                <span>&middot;</span>
                                <span>@talk.Date</span>
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-2">
                            <span class="flex items-center gap-1 text-muted-foreground text-xs tabular-nums">
                                <LucideIconCn Name="users" Size="12" Class="size-3" />
                                @FormatAudience(talk.Audience)
                            </span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                                @_typeLabel[talk.Type]
                            </BadgeCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Testimonials *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Testimonials</span>
            <div class="space-y-2">
                @foreach (var t in _testimonials)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-sm leading-relaxed">@("\"")@t.Text@("\"")</p>
                        <span class="mt-2 block text-muted-foreground text-xs">@t.Name</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private static string FormatAudience(int n)
    {
        if (n >= 1000) return $"{n / 1000.0:F1}K";
        return n.ToString();
    }

    private record SpeakerInfo(string Name, string Title, string Location, int TotalTalks, int TotalAudience, int Countries, double Rating, string Fee);

    private static readonly SpeakerInfo _speaker = new(
        "Camille Brooks",
        "Keynote Speaker & Leadership Consultant",
        "New York, NY",
        186,
        142000,
        24,
        4.9,
        "$15,000 - $25,000"
    );

    private record TopicItem(string Name, string Color);

    private static readonly TopicItem[] _topics =
    [
        new("Leadership", "bg-blue-500"),
        new("Innovation", "bg-purple-500"),
        new("DEI", "bg-emerald-500"),
        new("Future of Work", "bg-amber-500"),
        new("Organizational Culture", "bg-pink-500"),
        new("Team Performance", "bg-cyan-500"),
    ];

    private record TalkItem(string Id, string Title, string Conference, string Location, string Date, int Audience, string Type);

    private static readonly TalkItem[] _talks =
    [
        new("t1", "The Future of Distributed Leadership", "SXSW 2026", "Austin, TX", "Mar 2026", 3200, "keynote"),
        new("t2", "Building Anti-Fragile Teams", "Web Summit", "Lisbon, PT", "Nov 2025", 4800, "keynote"),
        new("t3", "Innovation Through Inclusive Design", "CES 2025", "Las Vegas, NV", "Jan 2025", 2100, "workshop"),
        new("t4", "Navigating Change in the AI Era", "Davos WEF", "Davos, CH", "Jan 2025", 800, "panel"),
    ];

    private static readonly Dictionary<string, string> _typeLabel = new()
    {
        ["keynote"] = "Keynote",
        ["workshop"] = "Workshop",
        ["panel"] = "Panel",
    };

    private record TestimonialItem(string Name, string Text);

    private static readonly TestimonialItem[] _testimonials =
    [
        new("Sarah Chen, VP People @ Stripe", "Camille's keynote was the highlight of our all-hands. Her framework for distributed leadership completely shifted our approach."),
        new("Alex Rivera, Events Director @ TechCrunch", "One of the highest-rated speakers we've ever hosted. Engaging, practical, and deeply insightful."),
    ];
}
