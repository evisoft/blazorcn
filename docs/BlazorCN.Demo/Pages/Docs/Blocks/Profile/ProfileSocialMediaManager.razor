@* ============================================================
   Block: profile-social-media-manager
   Title: ProfileSocialMediaManager
   Description: React social media manager profile block for Next.js with platform account stats, engagement metrics, content calendar overview, growth trends, and brand portfolio using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-social-media-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Taylor Kim" />
                <AvatarFallbackCn Class="text-lg">TK</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Taylor Kim</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideTrendingUpCn Size="12" Class="mr-1 size-3" />
                        4.8% avg ER
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Social Media Manager</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span>Hype Social Agency</span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideMapPinCn Size="12" Class="size-3" />
                        Los Angeles, CA
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Hire</ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideUsersCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">4.2M</span>
                <span class="text-muted-foreground">total followers</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">18</span>
                <span class="text-muted-foreground">brands managed</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-xs">
                <span class="font-medium tabular-nums">6</span>
                <span class="text-muted-foreground"> years</span>
            </span>
        </div>

        @* Platform accounts *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Platform Performance</span>
            </div>
            @for (var i = 0; i < _accounts.Length; i++)
            {
                var acct = _accounts[i];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", i < _accounts.Length - 1 ? "border-b" : "")">
                    <span class="@($"size-2 shrink-0 rounded-full {acct.Color}")"></span>
                    <span class="w-24 font-medium text-sm">@acct.Platform</span>
                    <span class="font-medium text-xs tabular-nums">@FormatFollowers(acct.Followers)</span>
                    <span class="text-muted-foreground text-xs">·</span>
                    <span class="text-muted-foreground text-xs tabular-nums">@(acct.Engagement)% ER</span>
                    <span class="text-muted-foreground text-xs">·</span>
                    <span class="text-muted-foreground text-xs tabular-nums">@(acct.PostsPerWeek)/wk</span>
                    <span class="ml-auto font-medium text-emerald-600 text-xs tabular-nums dark:text-emerald-400">@acct.Growth</span>
                </div>
            }
        </div>

        @* Content mix *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Content Mix</span>
            <div class="space-y-1.5">
                @foreach (var ct in _contentTypes)
                {
                    <div class="flex items-center gap-3 text-xs">
                        <span class="w-32 text-muted-foreground">@ct.Type</span>
                        <div class="flex-1">
                            <div class="h-1.5 rounded-full bg-foreground/20" style="@(FormattableString.Invariant($"width: {ct.Percentage * 2.5}%"))"></div>
                        </div>
                        <span class="w-8 text-right font-mono tabular-nums">@(ct.Percentage)%</span>
                    </div>
                }
            </div>
        </div>

        @* Brands *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Brand Portfolio</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var b in _brands)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@b</BadgeCn>
                }
            </div>
        </div>

        @* Skills *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Skills</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var s in _skills)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@s</BadgeCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record PlatformAccount(string Platform, string Color, int Followers, double Engagement, int PostsPerWeek, string Growth);
    private record ContentType(string Type, int Percentage);

    private static readonly PlatformAccount[] _accounts =
    [
        new("Instagram",  "bg-pink-500",    1840000, 5.2, 12, "+8.4%"),
        new("TikTok",     "bg-foreground",  1420000, 7.1,  8, "+14.2%"),
        new("LinkedIn",   "bg-blue-600",     520000, 3.8,  5, "+6.1%"),
        new("X (Twitter)","bg-sky-500",      380000, 2.4, 14, "+3.2%"),
        new("YouTube",    "bg-red-500",       40000, 4.6,  2, "+11.8%"),
    ];

    private static readonly ContentType[] _contentTypes =
    [
        new("Reels/Short-form", 38),
        new("Carousels",        24),
        new("Stories",          20),
        new("Static Posts",     12),
        new("Long-form Video",   6),
    ];

    private static readonly string[] _brands =
    [
        "Glossier", "Notion", "Athletic Greens", "Calm App",
        "Allbirds", "Figma", "Oatly", "Canva",
    ];

    private static readonly string[] _skills =
    [
        "Content Strategy", "Paid Social", "Community Management",
        "Influencer Partnerships", "Analytics & Reporting", "Copywriting",
    ];

    private static string FormatFollowers(int n)
    {
        if (n >= 1_000_000) return $"{(n / 1_000_000.0):F1}M";
        if (n >= 1_000) return $"{(n / 1_000):F0}K";
        return n.ToString();
    }
}
