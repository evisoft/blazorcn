@* ============================================================
   Block: profile-athlete-performance
   Title: ProfileAthletePerformance
   Description: React athlete performance profile block for Next.js with training stats, weekly workout chart, personal records, season goals progress, and injury log using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-athlete-performance.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Jordan Blake" />
                <AvatarFallbackCn Class="text-lg">JB</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Jordan Blake</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="trophy" Size="12" Class="mr-1 size-3" />
                        Ranked #28
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Track &amp; Field — 400m</span>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">Olympic hopeful. 2x national champion. Training under Coach Williams at the UCLA Athletics Program.</p>
            </div>
        </div>

        @* Key stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="timer" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-muted-foreground">PB</span>
                <span class="font-semibold tabular-nums">44.82s</span>
            </span>
            <span class="text-muted-foreground text-xs">&#183;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="text-muted-foreground">SB</span>
                <span class="font-medium tabular-nums">45.14s</span>
            </span>
            <span class="text-muted-foreground text-xs">&#183;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="activity" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">36</span>
                <span class="text-muted-foreground">weeks</span>
            </span>
        </div>

        @* Weekly training chart *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">This week</span>
            <div class="flex items-end gap-2">
                @foreach (var day in _weeklyTraining)
                {
                    var barHeight = day.Minutes == 0 ? 4 : (int)Math.Round((day.Minutes / (double)_maxMinutes) * 80);
                    var barColor = _typeColor.TryGetValue(day.Type, out var c) ? c : "bg-muted";
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <div class="@($"w-full rounded-sm {barColor}")" style="@($"height:{barHeight}px; min-height:4px")"></div>
                        <span class="text-muted-foreground text-xs">@day.Day</span>
                    </div>
                }
            </div>
            <div class="mt-2 flex items-center gap-3">
                @foreach (var legendType in _legendTypes)
                {
                    var legendColor = _typeColor.TryGetValue(legendType, out var lc) ? lc : "bg-muted";
                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                        <span class="@($"size-1.5 rounded-full {legendColor}")"></span>
                        @legendType
                    </span>
                }
            </div>
        </div>

        @* Personal records *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Personal records</span>
            </div>
            @for (var i = 0; i < _records.Length; i++)
            {
                var record = _records[i];
                <div class="@($"flex items-center gap-3 px-4 py-2.5 {(i < _records.Length - 1 ? "border-b" : "")}")">
                    <span class="w-12 font-medium text-xs">@record.Event</span>
                    <span class="font-semibold text-sm tabular-nums">@record.Time</span>
                    <span class="flex items-center gap-0.5 text-emerald-600 text-xs dark:text-emerald-400">
                        <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                        @record.Improvement
                    </span>
                    <span class="ml-auto text-muted-foreground text-xs">@record.Date</span>
                </div>
            }
        </div>

        @* Season goals *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Season goals</span>
            <div class="space-y-3">
                @foreach (var goal in _goals)
                {
                    var pct = (int)Math.Round((goal.Current / (double)goal.Target) * 100);
                    <div>
                        <div class="mb-1 flex items-center justify-between">
                            <span class="text-xs">@goal.Label</span>
                            <span class="font-mono text-muted-foreground text-xs tabular-nums">@goal.Current/@goal.Target @goal.Unit</span>
                        </div>
                        <ProgressCn Value="@pct" Class="h-1.5" aria-label="Progress" />
                    </div>
                }
            </div>
        </div>

        @* Body metrics *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Body metrics</span>
            <div class="grid grid-cols-4 gap-3">
                @foreach (var metric in _bodyMetrics)
                {
                    <div class="text-center">
                        <span class="block font-semibold text-sm tabular-nums">@metric.Value</span>
                        <span class="text-muted-foreground text-xs">@metric.Label</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record WeekDay(string Day, int Minutes, string Type);
    private record PersonalRecord(string Event, string Time, string Improvement, string Date);
    private record SeasonGoal(string Label, int Current, int Target, string Unit);
    private record BodyMetric(string Label, string Value, string Trend);

    private static readonly int _maxMinutes = 120;

    private static readonly Dictionary<string, string> _typeColor = new()
    {
        ["intense"] = "bg-red-500/70",
        ["moderate"] = "bg-amber-500/70",
        ["easy"] = "bg-emerald-500/70",
        ["rest"] = "bg-muted",
    };

    private static readonly string[] _legendTypes = ["intense", "moderate", "easy"];

    private static readonly WeekDay[] _weeklyTraining =
    [
        new("Mon", 90, "intense"),
        new("Tue", 60, "moderate"),
        new("Wed", 120, "intense"),
        new("Thu", 45, "easy"),
        new("Fri", 105, "intense"),
        new("Sat", 75, "moderate"),
        new("Sun", 0, "rest"),
    ];

    private static readonly PersonalRecord[] _records =
    [
        new("400m", "44.82s", "-0.31s", "Jun 2025"),
        new("200m", "20.48s", "-0.12s", "May 2025"),
        new("100m", "10.34s", "-0.05s", "Apr 2025"),
    ];

    private static readonly SeasonGoal[] _goals =
    [
        new("Sub-44.5 in 400m", 72, 100, "% training plan"),
        new("Olympic qualifying time", 89, 100, "% progress"),
        new("Strength benchmarks", 65, 100, "% achieved"),
        new("Competition starts", 8, 14, "races"),
    ];

    private static readonly BodyMetric[] _bodyMetrics =
    [
        new("Weight", "78.2 kg", "stable"),
        new("Body fat", "8.4%", "down"),
        new("VO2 max", "62.1", "up"),
        new("Resting HR", "48 bpm", "down"),
    ];
}
