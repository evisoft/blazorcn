@* ============================================================
   Block: profile-life-coach
   Title: ProfileLifeCoach
   Description: React life coach profile block for Next.js with client testimonials, coaching specialties, session packages, and success metrics using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-life-coach.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="Dr. Keisha Brown" />
                <AvatarFallbackCn>KB</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Dr. Keisha Brown</span>
                <p class="text-muted-foreground text-xs">Certified Life &amp; Executive Coach</p>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">ICF Master Certified Coach helping high-achievers overcome burnout, find clarity, and design fulfilling lives. 12 years coaching. 500+ clients transformed.</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Book Call</ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">520</span>
                <span class="text-muted-foreground">clients</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="star" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">4.9</span>
                <span class="text-muted-foreground">rating</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">6,800</span>
                <span class="text-muted-foreground">coaching hrs</span>
            </span>
        </div>

        @* Specialties *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Specialties</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var s in _specialties)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@s</BadgeCn>
                }
            </div>
        </div>

        @* Packages *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Packages</span>
            </div>
            @for (var i = 0; i < _packages.Length; i++)
            {
                var pkg = _packages[i];
                <div class="@(Cn.Merge("flex items-center justify-between px-4 py-2.5 transition-colors hover:bg-muted/50", i < _packages.Length - 1 ? "border-b" : ""))">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">@pkg.Name</span>
                        @if (pkg.Popular)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Popular</BadgeCn>
                        }
                    </div>
                    <div class="flex items-center gap-3 text-xs">
                        <span class="text-muted-foreground">@pkg.Sessions</span>
                        <span class="font-medium tabular-nums">@pkg.Price</span>
                    </div>
                </div>
            }
        </div>

        @* Client Stories *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Client Stories</span>
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-sm leading-relaxed italic">&ldquo;@_testimonials[_activeTestimonial].Quote&rdquo;</p>
                <div class="mt-2 flex items-center justify-between">
                    <div>
                        <span class="font-medium text-xs">@_testimonials[_activeTestimonial].Author</span>
                        <span class="ml-1.5 text-muted-foreground text-xs">@_testimonials[_activeTestimonial].Role</span>
                    </div>
                    <div class="flex">
                        @for (var idx = 0; idx < _testimonials.Length; idx++)
                        {
                            var capturedIdx = idx;
                            <button type="button" @onclick="@(() => _activeTestimonial = capturedIdx)" aria-label="@($"Go to testimonial {capturedIdx + 1}")" class="inline-flex size-6 items-center justify-center">
                                <span class="@(Cn.Merge("size-1.5 rounded-full transition-colors", capturedIdx == _activeTestimonial ? "bg-foreground" : "bg-foreground/20"))"></span>
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record PackageItem(string Name, string Sessions, string Price, bool Popular = false);
    private record TestimonialItem(string Id, string Quote, string Author, string Role, string Result);

    private int _activeTestimonial = 0;

    private static readonly string[] _specialties =
    [
        "Executive Burnout",
        "Career Transitions",
        "Relationship Coaching",
        "Goal Setting",
        "Mindfulness",
        "Leadership",
    ];

    private static readonly PackageItem[] _packages =
    [
        new("Discovery Call", "1 session", "Free"),
        new("Foundation", "4 sessions", "$480"),
        new("Transformation", "12 sessions", "$1,200", Popular: true),
        new("Executive Intensive", "24 sessions", "$3,600"),
    ];

    private static readonly TestimonialItem[] _testimonials =
    [
        new("t1", "Keisha helped me leave a toxic corporate job and build a business that aligns with my values. Revenue hit $400K in year one.", "Marcus Chen", "Founder, Mindful Tech", "Career pivot"),
        new("t2", "After 6 months of coaching, my team's engagement scores went from 42% to 78%. She changed how I lead.", "Diana Ross-Williams", "VP Engineering, Stripe", "Leadership growth"),
        new("t3", "I went from chronic burnout to running marathons and being present with my kids. The transformation is real.", "James Park", "Partner, McKinsey", "Work-life balance"),
    ];
}
