@* ============================================================
   Block: profile-book-reader
   Title: ProfileBookReader
   Description: React book reader profile block for Next.js with reading challenge progress, currently reading shelf, star ratings, genre distribution chart, and reading history timeline using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-book-reader.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="Anika Patel" />
                <AvatarFallbackCn>AP</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Anika Patel</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">Voracious reader. 100+ books a year. Sci-fi, philosophy, and technical nonfiction. Always carrying a Kindle.</p>
            </div>
        </div>

        @* Reading stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="book-open" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">847</span>
                <span class="text-muted-foreground">books read</span>
            </span>
            <span class="text-muted-foreground text-xs">&#183;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                <span class="font-medium tabular-nums">3.9</span>
                <span class="text-muted-foreground">avg rating</span>
            </span>
            <span class="text-muted-foreground text-xs">&#183;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">312</span>
                <span class="text-muted-foreground">reviews</span>
            </span>
        </div>

        @* Reading challenge *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="trophy" Size="14" Class="size-3.5 text-amber-500" />
                    <span class="font-medium text-sm">2026 Reading Challenge</span>
                </div>
                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                    23 / 100
                </span>
            </div>
            <div class="mt-2 flex items-center gap-2">
                <ProgressCn Value="@_challengeProgress" Class="h-2 flex-1" aria-label="Progress" />
                <span class="shrink-0 font-medium text-muted-foreground text-xs tabular-nums">
                    @_challengeProgress%
                </span>
            </div>
        </div>

        @* Currently reading *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Currently reading</span>
            </div>
            @for (var i = 0; i < _currentlyReading.Length; i++)
            {
                var book = _currentlyReading[i];
                var pct = (int)Math.Round((double)book.PagesRead / book.TotalPages * 100);
                <div class="@Cn.Merge("px-4 py-3", i < _currentlyReading.Length - 1 ? "border-b" : "")">
                    <div class="flex items-start gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded bg-muted/50">
                            <LucideIconCn Name="bookmark" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@book.Title</span>
                            <span class="block text-muted-foreground text-xs">@book.Author</span>
                            <div class="mt-1.5 flex items-center gap-2">
                                <ProgressCn Value="@pct" Class="h-1 flex-1" aria-label="Progress" />
                                <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                                    @book.PagesRead/@book.TotalPages
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Genre distribution *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">
                Genre distribution (this year)
            </span>
            <div class="space-y-2">
                @foreach (var genre in _genres)
                {
                    var barWidth = (int)Math.Round((double)genre.Count / _maxGenreCount * 100);
                    <div class="flex items-center gap-3">
                        <span class="w-16 shrink-0 text-xs">@genre.Name</span>
                        <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                            <div class="@($"h-full rounded-full {genre.Color}")" style="@($"width: {barWidth}%")"></div>
                        </div>
                        <span class="w-6 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                            @genre.Count
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Recently finished *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recently finished</span>
            </div>
            @for (var i = 0; i < _recentlyFinished.Length; i++)
            {
                var book = _recentlyFinished[i];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", i < _recentlyFinished.Length - 1 ? "border-b" : "")">
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@book.Title</span>
                        <span class="ml-2 text-muted-foreground text-xs">@book.Author</span>
                    </div>
                    <div class="flex items-center gap-0.5">
                        @for (var s = 0; s < 5; s++)
                        {
                            var starIndex = s;
                            <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starIndex < book.Rating ? "fill-amber-500 text-amber-500" : "text-muted-foreground/20")" />
                        }
                    </div>
                    <span class="shrink-0 text-muted-foreground text-xs">@book.FinishedDate</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CurrentBook(string Id, string Title, string Author, int PagesRead, int TotalPages);
    private record FinishedBook(string Id, string Title, string Author, int Rating, string FinishedDate);
    private record GenreItem(string Name, int Count, string Color);

    private readonly int _challengeProgress = (int)Math.Round(23.0 / 100.0 * 100);

    private readonly CurrentBook[] _currentlyReading = [
        new("b1", "The Alignment Problem", "Brian Christian", 234, 496),
        new("b2", "Project Hail Mary", "Andy Weir", 89, 476),
        new("b3", "Designing Data-Intensive Applications", "Martin Kleppmann", 312, 611),
    ];

    private readonly FinishedBook[] _recentlyFinished = [
        new("f1", "The Pragmatic Programmer", "David Thomas", 5, "1 week ago"),
        new("f2", "Dune Messiah", "Frank Herbert", 4, "2 weeks ago"),
        new("f3", "Thinking, Fast and Slow", "Daniel Kahneman", 4, "3 weeks ago"),
        new("f4", "The Staff Engineer's Path", "Tanya Reilly", 5, "1 month ago"),
    ];

    private readonly GenreItem[] _genres = [
        new("Sci-Fi", 28, "bg-blue-500"),
        new("Technical", 22, "bg-emerald-500"),
        new("Philosophy", 15, "bg-purple-500"),
        new("Biography", 10, "bg-amber-500"),
        new("Fantasy", 8, "bg-red-500"),
    ];

    private int _maxGenreCount => _genres.Length > 0 ? _genres.Max(g => g.Count) : 1;
}
