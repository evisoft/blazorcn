@* ============================================================
   Block: profile-freelancer-rates
   Title: ProfileFreelancerRates
   Description: React freelancer rates profile block for Next.js with skill-based pricing tiers, availability calendar indicator, project history, and client testimonial cards using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-freelancer-rates.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <div class="relative">
                <AvatarCn Class="size-14">
                    <AvatarFallbackCn Class="text-lg">PS</AvatarFallbackCn>
                </AvatarCn>
                <span class="@Cn.Merge("absolute bottom-0 right-0 size-3 rounded-full border-2 border-card", _available ? "bg-emerald-500" : "bg-muted-foreground")"></span>
            </div>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Priya Sharma</span>
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-blue-500" />
                </div>
                <span class="text-muted-foreground text-sm">Product Designer</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        London, UK
                    </span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="globe" Size="12" Class="size-3" />
                        GMT+0
                    </span>
                </div>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">@(_available ? "Available" : "Busy")</span>
                <SwitchCn @bind-Checked="_available" aria-label="Available for work" />
            </div>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1 text-xs">
                <LucideIconCn Name="star" Size="12" Class="size-3 text-amber-500" />
                <span class="font-medium tabular-nums">4.9</span>
                <span class="text-muted-foreground">(127)</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1 text-xs">
                <LucideIconCn Name="briefcase" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">89</span>
                <span class="text-muted-foreground">projects</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1 text-xs">
                <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-muted-foreground">&lt; 2 hours reply</span>
            </span>
        </div>

        @* Skills & Rates *@
        <div class="border-b px-4 py-3">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Skills &amp; Hourly Rates</span>
            <div class="space-y-3">
                @foreach (var skill in _skills)
                {
                    <div>
                        <div class="mb-1 flex items-center justify-between">
                            <span class="font-medium text-sm">@skill.Name</span>
                            <span class="font-medium text-sm tabular-nums">$@(skill.Rate)/hr</span>
                        </div>
                        <div class="h-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/60" style="@($"width:{skill.Level}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Packages *@
        <div class="border-b px-4 py-3">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Packages</span>
            <div class="space-y-2">
                @foreach (var pkg in _packages)
                {
                    <div class="flex items-center justify-between rounded-md bg-muted/50 p-3">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@pkg.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@pkg.Description</p>
                        </div>
                        <div class="ml-4 shrink-0 text-right">
                            <span class="block font-medium text-sm tabular-nums">$@(pkg.Price.ToString("N0"))</span>
                            <span class="text-muted-foreground text-xs">@pkg.Delivery</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Testimonials *@
        <div class="px-4 py-3">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Client Reviews</span>
            <div class="space-y-3">
                @foreach (var t in _testimonials)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-sm leading-relaxed">"@(t.Text)"</p>
                        <div class="mt-2 flex items-center gap-1 text-muted-foreground text-xs">
                            <span class="font-medium text-foreground">@t.Name</span>
                            <span>&middot;</span>
                            <span>@t.Company</span>
                        </div>
                    </div>
                }
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Class="mt-3 h-8 w-full text-xs">Hire Me</ButtonCn>
        </div>

    </div>
</section>

@code {
    private record SkillItem(string Name, int Rate, int Level);
    private record Package(string Id, string Name, string Description, int Price, string Delivery);
    private record Testimonial(string Name, string Company, string Text);

    private bool _available = true;

    private static readonly SkillItem[] _skills =
    [
        new("UI/UX Design", 120, 95),
        new("Design Systems", 135, 90),
        new("Prototyping", 110, 88),
        new("User Research", 100, 82),
        new("Brand Identity", 95, 78),
    ];

    private static readonly Package[] _packages =
    [
        new("pkg1", "Quick Audit", "UX review of a single page or flow with actionable recommendations", 500, "3 days"),
        new("pkg2", "Landing Page", "Complete design for a conversion-optimized landing page with responsive variants", 2400, "7 days"),
        new("pkg3", "Design System", "Full component library with tokens, patterns, and Figma documentation", 8500, "3 weeks"),
    ];

    private static readonly Testimonial[] _testimonials =
    [
        new("Sarah K.", "Luma AI", "Priya delivered exceptional work on our dashboard redesign. Clear communication and pixel-perfect execution."),
        new("David R.", "Notion", "One of the best designers I've worked with. Turned our vague brief into a beautiful, functional design system."),
    ];
}
