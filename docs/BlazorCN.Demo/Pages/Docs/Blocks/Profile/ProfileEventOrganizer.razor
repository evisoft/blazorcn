@* ============================================================
   Block: profile-event-organizer
   Title: Profile Event Organizer
   Description: Event organizer profile with upcoming/past event cards, ticket sales metrics, venue info, and speaker lineup
   Long Description: React Employee Badge Card Block
   Dependencies: AvatarCn, AvatarFallbackCn, BadgeCn, ButtonCn, ProgressCn, SwitchCn, LucideCalendarCn, LucideMapPinCn, LucideMicCn, LucideTicketCn, LucideTrendingUpCn, LucideUsersCn
   Source: original/blocks/profile/profile-event-organizer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarFallbackCn>AR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Alex Rivera</span>
                <span class="ml-2 text-muted-foreground text-xs">Conference Director</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                    Organizing developer conferences since 2017. Founded ReactConf LA and Next.js Summit.
                    50,000+ total attendees across all events.
                </p>
            </div>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideCalendarCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">34</span>
                <span class="text-muted-foreground">events</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideUsersCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">52.4K</span>
                <span class="text-muted-foreground">attendees</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideTrendingUpCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">4.8</span>
                <span class="text-muted-foreground">avg rating</span>
            </span>
        </div>

        @* Toggle *@
        <div class="flex items-center justify-between border-b px-4 py-2.5">
            <span class="font-medium text-muted-foreground text-xs">
                @(_showPast ? "Past events" : "Upcoming events")
            </span>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">Show past</span>
                <SwitchCn Checked="_showPast" CheckedChanged="v => _showPast = v" Class="scale-75" />
            </div>
        </div>

        @* Events list *@
        <div>
            @{
                var filtered = _events.Where(e => _showPast ? e.Type == "past" : e.Type == "upcoming").ToList();
            }
            @if (filtered.Count == 0)
            {
                <div class="px-4 py-8 text-center text-muted-foreground text-sm">
                    No @(_showPast ? "past" : "upcoming") events.
                </div>
            }
            else
            {
                @for (var i = 0; i < filtered.Count; i++)
                {
                    var evt = filtered[i];
                    var soldPct = (int)Math.Round((double)evt.TicketsSold / evt.Capacity * 100);
                    var isLast = i == filtered.Count - 1;
                    <div class="@Cn.Merge("px-4 py-4", isLast ? "" : "border-b")">
                        @* Event header *@
                        <div class="flex items-start justify-between gap-2">
                            <div>
                                <span class="font-medium text-sm">@evt.Name</span>
                                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                                    <span class="flex items-center gap-1">
                                        <LucideCalendarCn Size="12" Class="size-3" />
                                        @evt.Date
                                    </span>
                                    <span class="flex items-center gap-1">
                                        <LucideMapPinCn Size="12" Class="size-3" />
                                        @evt.Location
                                    </span>
                                </div>
                            </div>
                            @if (evt.Type == "upcoming")
                            {
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                                    <LucideTicketCn Size="12" Class="mr-1 size-3" />
                                    Tickets
                                </ButtonCn>
                            }
                        </div>

                        @* Ticket progress *@
                        <div class="mt-3 flex items-center gap-2">
                            <ProgressCn Value="soldPct" Class="h-1.5 flex-1" />
                            <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                                @evt.TicketsSold/@evt.Capacity
                            </span>
                        </div>
                        <span class="mt-0.5 block text-muted-foreground text-xs">
                            @(evt.Type == "upcoming"
                                ? $"{evt.Capacity - evt.TicketsSold} tickets remaining"
                                : $"{soldPct}% capacity")
                        </span>

                        @* Speakers *@
                        <div class="mt-3">
                            <span class="mb-1.5 block text-muted-foreground text-xs">
                                <LucideMicCn Size="12" Class="mr-1 inline size-3" />
                                Speakers
                            </span>
                            <div class="flex flex-wrap gap-1.5">
                                @foreach (var speaker in evt.Speakers)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        @speaker
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

@code {
    private bool _showPast;

    private record EventItem(string Name, string Date, string Location, int Capacity, int TicketsSold, string Type, string[] Speakers);

    private readonly List<EventItem> _events =
    [
        new("Next.js Summit 2026", "May 15-16, 2026", "San Francisco, CA", 2000, 1640, "upcoming",
            ["Guillermo Rauch", "Lee Robinson", "Delba de Oliveira"]),
        new("AI Dev Day", "Jul 8, 2026", "New York, NY", 800, 312, "upcoming",
            ["Andrej Karpathy", "Swyx"]),
        new("ReactConf LA 2025", "Oct 20-21, 2025", "Los Angeles, CA", 1500, 1500, "past",
            ["Dan Abramov", "Sophie Alpert"]),
        new("TypeScript Conf 2025", "Jun 12, 2025", "Austin, TX", 600, 580, "past",
            ["Matt Pocock"]),
    ];
}
