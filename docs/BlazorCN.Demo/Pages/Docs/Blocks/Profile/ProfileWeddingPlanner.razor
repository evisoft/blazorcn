@* ============================================================
   Block: profile-wedding-planner
   Title: ProfileWeddingPlanner
   Description: React wedding planner profile block for Next.js with event portfolio, service packages, vendor network, client testimonials, and availability calendar using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-wedding-planner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="@_planner.Avatar" Alt="@_planner.Name" />
                <AvatarFallbackCn Class="text-lg">IM</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_planner.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="star" Size="12" Class="mr-1 size-3 fill-amber-500 text-amber-500" />
                        @_planner.Rating
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">@_planner.Title</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                        @_planner.Company
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        @_planner.Location
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Inquire
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">@_planner.WeddingsPlanned</span>
                <span class="text-muted-foreground text-xs">Weddings</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">@_planner.YearsExperience</span>
                <span class="text-muted-foreground text-xs">Years</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">@_planner.VendorPartners</span>
                <span class="text-muted-foreground text-xs">Vendors</span>
            </div>
        </div>

        @* Styles *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Wedding Styles</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var s in _styles)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", s.Color)"></span>
                        @s.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Event portfolio *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent Weddings</span>
            </div>
            @for (var i = 0; i < _events.Length; i++)
            {
                var evt = _events[i];
                var isLast = i == _events.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="heart" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="font-medium text-sm">@evt.Couple</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@evt.Venue</span>
                                <span>·</span>
                                <span>@evt.Location</span>
                            </div>
                        </div>
                        <div class="flex shrink-0 items-center gap-2 text-muted-foreground text-xs">
                            <span class="flex items-center gap-1">
                                <LucideIconCn Name="users" Size="12" Class="size-3" />
                                <span class="tabular-nums">@evt.Guests</span>
                            </span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                                @evt.Season
                            </BadgeCn>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Service packages *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Service Packages</span>
            </div>
            @for (var i = 0; i < _packages.Length; i++)
            {
                var pkg = _packages[i];
                var isLast = i == _packages.Length - 1;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-sm">@pkg.Name</span>
                        <span class="font-medium text-sm tabular-nums">@pkg.Price</span>
                    </div>
                    <p class="mt-0.5 text-muted-foreground text-xs">@pkg.Description</p>
                    <div class="mt-1.5 flex flex-wrap gap-1">
                        @foreach (var f in pkg.Features)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                                @f
                            </BadgeCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Vendor network *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Vendor Network (@(_planner.VendorPartners) partners)
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var v in _vendorCategories)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @v
                    </BadgeCn>
                }
            </div>
        </div>

        @* Testimonials *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Client Love</span>
            <div class="space-y-2">
                @foreach (var t in _testimonials)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-sm leading-relaxed">"@t.Text"</p>
                        <span class="mt-2 block font-medium text-muted-foreground text-xs">@t.Name</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

