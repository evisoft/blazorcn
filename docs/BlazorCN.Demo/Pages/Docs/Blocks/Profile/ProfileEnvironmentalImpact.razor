@* ============================================================
   Block: profile-environmental-impact
   Title: ProfileEnvironmentalImpact
   Description: React environmental scientist profile block for Next.js with impact metrics, research projects, carbon offset tracking, and sustainability certifications using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-environmental-impact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarFallbackCn>AO</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Dr. Amara Osei</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Conservation International</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Environmental Scientist &amp; Sustainability Director</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                    Leading climate research and biodiversity conservation projects across 14 countries. PhD in Environmental Science from MIT. Published 42 peer-reviewed papers.
                </p>
            </div>
        </div>

        @* Impact metrics *@
        <div class="grid grid-cols-3 border-b">
            @foreach (var metric in _impactMetrics)
            {
                <div class="flex flex-col items-center gap-1 border-r px-4 py-3 last:border-r-0">
                    <LucideIconCn Name="@metric.Icon" Size="16" Class="size-4 text-muted-foreground" />
                    <span class="font-semibold text-lg tabular-nums">@metric.Value</span>
                    <span class="text-muted-foreground text-xs">@metric.Unit</span>
                </div>
            }
        </div>

        @* Research projects *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Research Projects</span>
            </div>
            @for (var i = 0; i < _projects.Length; i++)
            {
                var project = _projects[i];
                var isLast = i == _projects.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3">
                        <span class="@Cn.Merge("mt-1.5 size-1.5 shrink-0 rounded-full", _statusDot[project.Status])"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@project.Title</span>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                    @project.Location
                                </span>
                                <span>&middot;</span>
                                <span>@project.Impact</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Focus areas *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">
                Focus Areas
            </span>
            <div class="space-y-2">
                @foreach (var area in _focusAreas)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-28 text-xs">@area.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="@($"width:{area.Level}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Certifications *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Certifications
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var cert in _certifications)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@cert</BadgeCn>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record ImpactMetric(string Label, string Value, string Unit, string Icon);
    private record Project(string Id, string Title, string Location, string Status, string Impact);
    private record FocusArea(string Name, int Level);

    private static readonly ImpactMetric[] _impactMetrics =
    [
        new("Carbon Offset", "14,200", "tCO2e", "leaf"),
        new("Land Restored", "8,400", "hectares", "trees"),
        new("Water Saved", "2.1M", "gallons", "droplet"),
    ];

    private static readonly Project[] _projects =
    [
        new("p1", "Amazon Reforestation Initiative", "Brazil", "active", "3,200 hectares restored"),
        new("p2", "Coral Reef Monitoring System", "Great Barrier Reef", "active", "420 species tracked"),
        new("p3", "Urban Carbon Sink Study", "Singapore", "completed", "Policy adopted citywide"),
        new("p4", "Mangrove Restoration Program", "Indonesia", "active", "1,800 hectares planted"),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["active"] = "bg-emerald-500",
        ["completed"] = "bg-muted-foreground/40",
        ["planned"] = "bg-amber-500",
    };

    private static readonly string[] _certifications = ["LEED AP", "ISO 14001 Auditor", "GRI Certified", "Carbon Trust Standard"];

    private static readonly FocusArea[] _focusAreas =
    [
        new("Climate Science", 95),
        new("Biodiversity", 88),
        new("Water Systems", 80),
        new("Urban Ecology", 72),
        new("Policy & Advocacy", 68),
    ];
}
