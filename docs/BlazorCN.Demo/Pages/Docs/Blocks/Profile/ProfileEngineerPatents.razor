@* ============================================================
   Block: profile-engineer-patents
   Title: ProfileEngineerPatents
   Description: React engineer profile block for Next.js with patent portfolio, technical expertise, innovation metrics, and research areas using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-engineer-patents.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarFallbackCn>WZ</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Dr. Wei Zhang</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Applied Materials</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Principal Engineer &amp; Inventor</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">20+ years in semiconductor process engineering. Holder of 34 patents in thin film deposition, etch processes, and advanced packaging technologies.</p>
            </div>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="lightbulb" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">34</span>
                <span class="text-muted-foreground">patents</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="book-open" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">1,240</span>
                <span class="text-muted-foreground">citations</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">h-18</span>
                <span class="text-muted-foreground">index</span>
            </span>
        </div>

        @* Patent Portfolio *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Patent Portfolio</span>
            </div>
            @for (var i = 0; i < _patents.Length; i++)
            {
                var patent = _patents[i];
                var isLast = i == _patents.Length - 1;
                var patentId = patent.Id;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleExpanded(patentId))">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetStatusDot(patent.Status))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@patent.Title</span>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="font-mono">@patent.Number</span>
                                <span>&middot;</span>
                                <span>@patent.Year</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16"
                                      Class="@Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _expanded == patent.Id ? "rotate-90" : "")" />
                    </button>
                    @if (_expanded == patent.Id)
                    {
                        <div class="px-4 pb-3">
                            <div class="ml-4 flex items-center gap-4 rounded-md bg-muted/50 p-3 text-xs">
                                <span class="flex items-center gap-1.5">
                                    <LucideIconCn Name="shield-check" Size="12" Class="size-3 text-muted-foreground" />
                                    <span class="capitalize">@patent.Status</span>
                                </span>
                                <span class="flex items-center gap-1.5">
                                    <LucideIconCn Name="book-open" Size="12" Class="size-3 text-muted-foreground" />
                                    @patent.Citations citations
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Technical Domains *@
        <div class="px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Technical Domains</span>
            <div class="space-y-2">
                @foreach (var domain in _domains)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-36 text-xs">@domain.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="width: @(domain.Level)%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record PatentItem(string Id, string Title, string Number, string Year, string Status, int Citations);
    private record DomainItem(string Name, int Level);

    private static readonly PatentItem[] _patents =
    [
        new("p1", "Method for Atomic Layer Deposition of High-K Dielectrics", "US 11,234,567", "2025", "granted", 89),
        new("p2", "Plasma-Enhanced CVD Process for SiC Films", "US 11,345,678", "2024", "granted", 62),
        new("p3", "Self-Aligned Multi-Patterning Technique", "US App 18/123,456", "2026", "pending", 0),
        new("p4", "Selective Etch Process for 3D NAND Structures", "US 11,456,789", "2023", "granted", 124),
        new("p5", "Advanced Packaging Interconnect Method", "US App 18/234,567", "2026", "filed", 0),
    ];

    private static readonly DomainItem[] _domains =
    [
        new("Thin Film Deposition", 95),
        new("Etch & Patterning", 90),
        new("Advanced Packaging", 80),
        new("Metrology", 75),
        new("Process Integration", 85),
    ];

    private string? _expanded = null;

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static string GetStatusDot(string status) => status switch
    {
        "granted" => "bg-emerald-500",
        "pending" => "bg-amber-500",
        "filed" => "bg-blue-500",
        _ => ""
    };
}
