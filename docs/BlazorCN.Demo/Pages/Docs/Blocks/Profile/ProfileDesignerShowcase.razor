@* ============================================================
   Block: profile-designer-showcase
   Title: ProfileDesignerShowcase
   Description: React designer showcase profile block for Next.js with project gallery cards, design tool badges, client logos, testimonials, and availability status using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-designer-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <div class="relative">
                <AvatarCn Class="size-14">
                    <AvatarFallbackCn Class="text-lg">AN</AvatarFallbackCn>
                </AvatarCn>
                @if (_isAvailable)
                {
                    <span class="absolute bottom-0 right-0 size-3 rounded-full border-2 border-card bg-emerald-500"></span>
                }
            </div>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Aria Nakamura</span>
                    <span class="text-muted-foreground text-xs">Product Designer</span>
                </div>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">
                    Designing intuitive products for 8+ years. Previously at Stripe, Figma, and Linear. Specializing in design systems and complex workflows.
                </p>
            </div>
        </div>

        @* Availability + Stats *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-4 text-xs">
                <span class="flex items-center gap-1.5">
                    <LucideIconCn Name="palette" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-medium tabular-nums">142</span>
                    <span class="text-muted-foreground">projects</span>
                </span>
                <span class="text-muted-foreground">&middot;</span>
                <span class="flex items-center gap-1.5">
                    <LucideIconCn Name="briefcase" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-medium tabular-nums">38</span>
                    <span class="text-muted-foreground">clients</span>
                </span>
                <span class="text-muted-foreground">&middot;</span>
                <span class="flex items-center gap-1.5">
                    <span class="font-medium tabular-nums">7</span>
                    <span class="text-muted-foreground">awards</span>
                </span>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">Available</span>
                <SwitchCn @bind-Value="_isAvailable" />
            </div>
        </div>

        @* Project gallery *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Featured work</span>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var project in _projects)
                {
                    <div class="group cursor-pointer overflow-hidden rounded-md border transition-colors hover:border-foreground/20">
                        <div class="flex h-24 items-center justify-center bg-muted">
                            <LucideIconCn Name="palette" Size="20" Class="size-5 text-muted-foreground/30" />
                        </div>
                        <div class="p-2.5">
                            <span class="font-medium text-xs">@project.Title</span>
                            <div class="mt-1 flex items-center justify-between">
                                <span class="text-muted-foreground text-xs">@project.Client</span>
                                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                                    <span class="flex items-center gap-0.5">
                                        <LucideIconCn Name="eye" Size="12" Class="size-3" />
                                        @FormatCount(project.Views)
                                    </span>
                                    <span class="flex items-center gap-0.5">
                                        <LucideIconCn Name="heart" Size="12" Class="size-3" />
                                        @FormatCount(project.Likes)
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Skills *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Specialties</span>
            <div class="space-y-2">
                @foreach (var skill in _specialties)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-24 text-xs">@skill.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="@($"width:{skill.Level}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Tools *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Tools</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var tool in _tools)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@tool</BadgeCn>
                }
            </div>
        </div>

        @* Testimonials *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Testimonials</span>
            <div class="rounded-md bg-muted/50 p-3">
                <p class="text-sm leading-relaxed italic">
                    &ldquo;@_testimonials[_activeTestimonial].Quote&rdquo;
                </p>
                <div class="mt-2 flex items-center justify-between">
                    <div>
                        <span class="font-medium text-xs">@_testimonials[_activeTestimonial].Author</span>
                        <span class="ml-1.5 text-muted-foreground text-xs">@_testimonials[_activeTestimonial].Role</span>
                    </div>
                    <div class="flex gap-1">
                        @for (var idx = 0; idx < _testimonials.Length; idx++)
                        {
                            var capturedIdx = idx;
                            <button type="button"
                                    @onclick="@(() => _activeTestimonial = capturedIdx)"
                                    class="@Cn.Merge("size-1.5 rounded-full transition-colors", capturedIdx == _activeTestimonial ? "bg-foreground" : "bg-foreground/20")"></button>
                        }
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record ProjectItem(string Id, string Title, string Category, string Client, int Views, int Likes);
    private record TestimonialItem(string Quote, string Author, string Role);
    private record SpecialtyItem(string Name, int Level);

    private bool _isAvailable = true;
    private int _activeTestimonial = 0;

    private static readonly ProjectItem[] _projects =
    [
        new("1", "Banking Dashboard Redesign", "Product Design", "Mercury", 12400, 890),
        new("2", "Design System V3", "Design Systems", "Vercel", 28300, 2100),
        new("3", "Mobile Onboarding Flow", "Mobile", "Notion", 8700, 620),
        new("4", "Developer Portal UX", "Web App", "Stripe", 15200, 1340),
    ];

    private static readonly string[] _tools = ["Figma", "Framer", "Principle", "After Effects", "Blender", "Webflow"];

    private static readonly TestimonialItem[] _testimonials =
    [
        new("Aria transformed our entire product experience. The new onboarding flow increased activation by 40%.", "David Kim", "CPO at Mercury"),
        new("The design system she built has been the foundation of everything we ship. Incredibly thorough work.", "Emily Zhang", "VP Design at Vercel"),
    ];

    private static readonly SpecialtyItem[] _specialties =
    [
        new("Design Systems", 95),
        new("Product Design", 90),
        new("Prototyping", 85),
        new("User Research", 75),
        new("Motion Design", 70),
    ];

    private static string FormatCount(int n) =>
        n >= 1000 ? $"{(n / 1000.0):F1}k" : n.ToString();
}
