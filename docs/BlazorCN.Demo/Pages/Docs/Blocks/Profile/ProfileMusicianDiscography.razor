@* ============================================================
   Block: profile-musician-discography
   Title: ProfileMusicianDiscography
   Description: React musician discography profile block for Next.js with album tracklist, streaming stats, genre badges, and audio waveform-style progress bars using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-musician-discography.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Artist header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="@_artist.Avatar" Alt="@_artist.Name" />
                <AvatarFallbackCn Class="text-lg">KN</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_artist.Stage</span>
                    <span class="text-muted-foreground text-xs">@_artist.Name</span>
                </div>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">@_artist.Bio</p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                    @foreach (var genre in _artist.Genres)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@genre</BadgeCn>
                    }
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                <LucideHeadphonesCn Size="12" Class="mr-1 size-3" />
                Listen
            </ButtonCn>
        </div>

        @* Streaming stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Monthly listeners</span>
                <span class="font-semibold text-lg tabular-nums">@FormatStreams(_artist.MonthlyListeners)</span>
            </div>
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Total streams</span>
                <span class="font-semibold text-lg tabular-nums">@FormatStreams(_artist.TotalStreams)</span>
            </div>
            <div class="px-4 py-3">
                <span class="block text-muted-foreground text-xs">Instruments</span>
                <div class="mt-1 flex flex-wrap gap-1">
                    @foreach (var inst in _artist.Instruments.Take(3))
                    {
                        <span class="text-xs text-muted-foreground">@inst</span>
                    }
                    @if (_artist.Instruments.Length > 3)
                    {
                        <span class="text-xs text-muted-foreground">+@(_artist.Instruments.Length - 3)</span>
                    }
                </div>
            </div>
        </div>

        @* Discography header *@
        <div class="border-b px-4 py-2">
            <span class="flex items-center gap-2 font-medium text-muted-foreground text-xs">
                <LucideDiscCn Size="12" Class="size-3" />
                Discography
            </span>
        </div>

        @* Albums *@
        @for (var albumIndex = 0; albumIndex < _albums.Length; albumIndex++)
        {
            var album = _albums[albumIndex];
            var isExpanded = _expandedAlbum == album.Id;
            var isLastAlbum = albumIndex == _albums.Length - 1;
            <div class="@Cn.Merge(isLastAlbum && !isExpanded ? "" : "border-b")">
                <button type="button"
                        @onclick="@(() => ToggleAlbum(album.Id))"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded bg-muted/50">
                        <LucideMusicCn Size="16" Class="size-4 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@album.Title</span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@album.Type</BadgeCn>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span>@album.Year</span>
                            <span>·</span>
                            <span>@album.Tracks.Length tracks</span>
                            <span>·</span>
                            <span>@FormatStreams(album.TotalStreams) streams</span>
                        </div>
                    </div>
                    <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                </button>

                @if (isExpanded)
                {
                    <div class="pb-2">
                        @for (var trackIndex = 0; trackIndex < album.Tracks.Length; trackIndex++)
                        {
                            var track = album.Tracks[trackIndex];
                            var barWidth = (int)Math.Round((double)track.Streams / _maxTrackStreams * 100);
                            var trackNum = trackIndex + 1;
                            <div class="flex items-center gap-3 px-4 py-1.5 transition-colors hover:bg-muted/30">
                                <span class="w-4 text-right font-mono text-muted-foreground text-xs tabular-nums">@trackNum</span>
                                <LucidePlayCn Size="12" Class="size-3 text-muted-foreground" />
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-2">
                                        <span class="truncate text-sm">@track.Title</span>
                                        @if (!string.IsNullOrEmpty(track.Featured))
                                        {
                                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideMicCn Size="12" Class="size-3" />
                                                @track.Featured
                                            </span>
                                        }
                                    </div>
                                    <div class="mt-1 h-1 w-full overflow-hidden rounded-full bg-muted">
                                        <div class="h-full rounded-full bg-foreground/60" style="@($"width:{barWidth}%")"></div>
                                    </div>
                                </div>
                                <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">@track.Duration</span>
                                <span class="w-12 shrink-0 text-right text-muted-foreground text-xs tabular-nums">@FormatStreams(track.Streams)</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record ArtistInfo(string Name, string Stage, string Avatar, string Bio, int MonthlyListeners, int TotalStreams, string[] Genres, string[] Instruments);

    private record Track(string Title, string Duration, int Streams, string Featured = "");

    private record Album(string Id, string Title, string Year, Track[] Tracks, int TotalStreams, string Type);

    private static readonly ArtistInfo _artist = new(
        Name: "Kai Nomura",
        Stage: "KAINØ",
        Avatar: "",
        Bio: "Electronic producer and multi-instrumentalist. Blending ambient textures with driving rhythms. 3 studio albums, 180M+ streams.",
        MonthlyListeners: 2840000,
        TotalStreams: 184000000,
        Genres: ["Electronic", "Ambient", "Downtempo", "IDM"],
        Instruments: ["Synthesizer", "Guitar", "Piano", "Drum Machine"]
    );

    private static readonly Album[] _albums =
    [
        new("a1", "Meridian", "2025",
            [
                new("First Light", "4:32", 18200000),
                new("Meridian", "5:18", 24600000),
                new("Chromatic", "3:47", 12300000),
                new("Tessellate", "6:02", 9800000),
                new("Afterimage", "4:55", 7500000),
            ],
            72400000, "Album"),
        new("a2", "Substrate", "2023",
            [
                new("Substrate", "5:44", 22100000),
                new("Phase Shift", "4:11", 19400000, "Yuki Sato"),
                new("Deep Structure", "6:38", 14200000),
                new("Liminal", "3:56", 12500000),
            ],
            68200000, "Album"),
        new("a3", "Signal Path", "2021",
            [
                new("Signal Path", "4:28", 16800000),
                new("Voltage", "3:33", 11200000),
                new("Recursive", "5:17", 8900000),
                new("Envelope", "4:42", 6500000),
            ],
            43400000, "Album"),
    ];

    private static readonly int _maxTrackStreams = _albums
        .SelectMany(a => a.Tracks)
        .Max(t => t.Streams);

    private string? _expandedAlbum = "a1";

    private void ToggleAlbum(string id)
    {
        _expandedAlbum = _expandedAlbum == id ? null : id;
    }

    private static string FormatStreams(int n)
    {
        if (n >= 1_000_000) return $"{(n / 1_000_000.0):F1}M";
        if (n >= 1_000) return $"{(n / 1_000.0):F0}K";
        return n.ToString();
    }
}
