@* ============================================================
   Block: profile-social-feed
   Title: ProfileSocialFeed
   Description: React social media profile block for Next.js with cover banner, overlapping avatar, bio section, follower counts, and tabbed post feed using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-social-feed.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Cover banner *@
        <div class="h-28 bg-muted"></div>

        @* Avatar + actions *@
        <div class="flex items-end justify-between px-4">
            <AvatarCn Class="-mt-8 size-16 border-4 border-card">
                <AvatarImageCn Src="" Alt="Maya Chen" />
                <AvatarFallbackCn Class="text-lg">MC</AvatarFallbackCn>
            </AvatarCn>
            <div class="flex gap-2 pb-2 pt-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Message</ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs">Follow</ButtonCn>
            </div>
        </div>

        @* Profile info *@
        <div class="border-b px-4 pb-4 pt-2">
            <div>
                <span class="font-medium text-sm">Maya Chen</span>
                <span class="ml-2 text-muted-foreground text-xs">@@mayachen</span>
            </div>
            <p class="mt-1.5 text-sm leading-relaxed">Design engineer. Building interfaces that feel alive. Previously at Linear, Figma. Opinions are my own.</p>
            <div class="mt-2 flex flex-wrap items-center gap-3 text-muted-foreground text-xs">
                <span class="flex items-center gap-1">
                    <LucideIconCn Name="link" Size="12" Class="size-3" />
                    maya.design
                </span>
                <span class="flex items-center gap-1">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                    Joined March 2019
                </span>
            </div>
            <div class="mt-3 flex items-center gap-4 text-xs">
                <span>
                    <span class="font-medium tabular-nums">892</span>
                    <span class="text-muted-foreground"> following</span>
                </span>
                <span>
                    <span class="font-medium tabular-nums">28.4k</span>
                    <span class="text-muted-foreground"> followers</span>
                </span>
                <span>
                    <span class="font-medium tabular-nums">3.2k</span>
                    <span class="text-muted-foreground"> posts</span>
                </span>
            </div>
        </div>

        @* Tabbed feed *@
        <TabsCn Value="@_activeTab" ValueChanged="@((string v) => SetTab(v))" Class="w-full">
            <TabsListCn Class="w-full justify-start border-b px-4">
                <TabsTriggerCn Value="posts" Class="text-xs">Posts</TabsTriggerCn>
                <TabsTriggerCn Value="replies" Class="text-xs">Replies</TabsTriggerCn>
                <TabsTriggerCn Value="media" Class="text-xs">Media</TabsTriggerCn>
            </TabsListCn>

            <TabsContentCn Value="@_activeTab" Class="mt-0">
                @{
                    var filtered = _activeTab == "posts"
                        ? _posts.Where(p => p.Type == "post").ToArray()
                        : _activeTab == "replies"
                            ? _posts.Where(p => p.Type == "reply").ToArray()
                            : _posts.Where(p => p.Type == "media").ToArray();
                }
                @if (filtered.Length == 0)
                {
                    <div class="px-4 py-8 text-center text-muted-foreground text-sm">
                        No @_activeTab yet.
                    </div>
                }
                else
                {
                    @for (var i = 0; i < filtered.Length; i++)
                    {
                        var post = filtered[i];
                        var isLast = i == filtered.Length - 1;
                        <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                            <div class="flex items-start gap-3">
                                <AvatarCn Class="size-8">
                                    <AvatarFallbackCn Class="text-xs">MC</AvatarFallbackCn>
                                </AvatarCn>
                                <div class="min-w-0 flex-1">
                                    <div class="flex items-center gap-1.5">
                                        <span class="font-medium text-sm">Maya Chen</span>
                                        <span class="text-muted-foreground text-xs">@@mayachen</span>
                                        <span class="text-muted-foreground text-xs">·</span>
                                        <span class="text-muted-foreground text-xs">@post.Time</span>
                                    </div>
                                    <p class="mt-1 text-sm leading-relaxed">@post.Content</p>
                                    @if (post.Type == "media")
                                    {
                                        <div class="mt-2 h-32 rounded-md bg-muted/50"></div>
                                    }
                                    <div class="mt-2 flex items-center gap-6 text-muted-foreground">
                                        <span class="flex items-center gap-1 text-xs">
                                            <LucideIconCn Name="message-circle" Size="14" Class="size-3.5" />
                                            @post.Replies
                                        </span>
                                        <span class="flex items-center gap-1 text-xs">
                                            <LucideIconCn Name="repeat" Size="14" Class="size-3.5" />
                                            @post.Reposts
                                        </span>
                                        <span class="flex items-center gap-1 text-xs">
                                            <LucideIconCn Name="heart" Size="14" Class="size-3.5" />
                                            @FormatCount(post.Likes)
                                        </span>
                                        <LucideIconCn Name="share" Size="14" Class="size-3.5" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private string _activeTab = "posts";

    private void SetTab(string tab) => _activeTab = tab;

    private static string FormatCount(int n) =>
        n >= 1000 ? $"{(n / 1000.0):0.#}k" : n.ToString();

    private record PostItem(string Id, string Content, string Time, int Likes, int Replies, int Reposts, string Type);

    private static readonly PostItem[] _posts =
    [
        new("1", "Just shipped the new animation system. Every interaction now has a spring-based transition with configurable damping. Feels so much better than linear easing.", "2h", 342, 28, 47, "post"),
        new("2", "Hot take: most design systems over-engineer their token layer. You need 3-4 spacing values, 2-3 type scales, and a handful of colors. Everything else is noise.", "5h", 1204, 89, 213, "post"),
        new("3", "Replying to @danabramov — agree, RSC changes everything about how we think about data loading. The mental model shift is real but worth it.", "8h", 56, 4, 2, "reply"),
        new("4", "New case study up on my site: redesigning the onboarding flow for a fintech app. Conversion went from 23% to 61% with three changes.", "1d", 892, 67, 134, "post"),
        new("5", "Screenshot of the new dashboard layout I'm working on. Dark mode first, then adapted for light. The contrast ratios are much better this way.", "2d", 2100, 156, 301, "media"),
    ];
}
