@* ============================================================
   Block: profile-real-estate-agent
   Title: Profile Real Estate Agent
   Description: React real estate agent profile block for Next.js with active listings grid, sales volume metrics, neighborhood expertise, client testimonials, and license verification using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Investment holdings and returns
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, SelectCn, SelectContentCn, SelectItemCn, SelectTriggerCn, SelectValueCn, LucideBadgeCheckCn, LucideBathCn, LucideBedDoubleCn, LucideBuildingCn, LucideHomeCn, LucideMapPinCn, LucidePhoneCn, LucideRulerCn, LucideStarCn
   Source: original/blocks/profile/profile-real-estate-agent.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Rachel Thompson" />
                <AvatarFallbackCn Class="text-lg">RT</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Rachel Thompson</span>
                    <LucideBadgeCheckCn class="size-3.5 text-blue-500" />
                </div>
                <span class="text-muted-foreground text-xs">Senior Real Estate Agent</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1"><LucideBuildingCn class="size-3" />Compass Real Estate</span>
                    <span>·</span>
                    <span>12 years</span>
                </div>
                <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                    <span class="font-mono">CA DRE #02145678</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs"><LucidePhoneCn class="mr-1 size-3" />Call</ButtonCn>
        </div>

        @* Stats *@
        <div class="grid grid-cols-4 border-b">
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">284</span>
                <span class="text-muted-foreground text-xs">Sales</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">$142M</span>
                <span class="text-muted-foreground text-xs">Volume</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">18</span>
                <span class="text-muted-foreground text-xs">Avg Days</span>
            </div>
            <div class="px-3 py-3 text-center">
                <div class="flex items-center justify-center gap-1">
                    <LucideStarCn class="size-3 fill-amber-500 text-amber-500" />
                    <span class="font-semibold text-2xl tabular-nums">4.9</span>
                </div>
                <span class="text-muted-foreground text-xs">186 reviews</span>
            </div>
        </div>

        @* Neighborhoods *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Neighborhood Expertise</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var n in _neighborhoods)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs"><LucideMapPinCn class="size-2.5" />@n</BadgeCn>
                }
            </div>
        </div>

        @* Listings *@
        <div class="border-b">
            <div class="flex items-center justify-between border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Active Listings</span>
                <SelectCn Value="@_filter" ValueChanged="v => _filter = v">
                    <SelectTriggerCn aria-label="Filter listings by property type" Class="h-6 w-24 border-0 bg-transparent px-2 text-xs shadow-none focus:ring-0">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="all">All Types</SelectItemCn>
                        <SelectItemCn Value="house">Houses</SelectItemCn>
                        <SelectItemCn Value="condo">Condos</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
            @{
                var filtered = _filter == "all" ? _listings : _listings.Where(l => l.Type == _filter).ToArray();
            }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var listing = filtered[i];
                var dot = _statusDot[listing.Status];
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", i < filtered.Length - 1 ? "border-b" : ""))">
                    <div class="flex items-start gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideHouseCn class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@listing.Address</span>
                                <span class="@(Cn.Merge("size-1.5 rounded-full", dot))"></span>
                            </div>
                            <span class="text-muted-foreground text-xs">@listing.Neighborhood</span>
                            <div class="mt-1.5 flex items-center gap-3 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1"><LucideBedDoubleCn class="size-3" />@listing.Beds</span>
                                <span class="flex items-center gap-1"><LucideBathCn class="size-3" />@listing.Baths</span>
                                <span class="flex items-center gap-1"><LucideRulerCn class="size-3" />@listing.SqFt.ToString("N0") sqft</span>
                            </div>
                        </div>
                        <span class="font-medium text-sm tabular-nums">@FormatPrice(listing.Price)</span>
                    </div>
                </div>
            }
        </div>

        @* Testimonials *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Client Reviews</span>
            <div class="space-y-2">
                @foreach (var t in _testimonials)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-sm leading-relaxed">"@t.Text"</p>
                        <div class="mt-2 flex items-center gap-1 text-muted-foreground text-xs">
                            <span class="font-medium text-foreground">@t.Name</span>
                            <span>·</span>
                            <span>@t.Type</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ListingItem(string Id, string Address, string Neighborhood, int Price, int Beds, int Baths, int SqFt, string Type, string Status);
    private record TestimonialItem(string Name, string Text, string Type);

    private string _filter = "all";

    private static string FormatPrice(int n)
    {
        if (n >= 1_000_000) return $"${n / 1_000_000.0:F1}M";
        if (n >= 1_000) return $"${n / 1_000}K";
        return $"${n}";
    }

    private readonly Dictionary<string, string> _statusDot = new()
    {
        ["active"] = "bg-emerald-500",
        ["pending"] = "bg-amber-500",
        ["sold"] = "bg-muted-foreground",
    };

    private readonly string[] _neighborhoods = ["Pacific Heights", "Nob Hill", "Marina District", "Russian Hill", "SoMa", "Hayes Valley"];

    private readonly ListingItem[] _listings = [
        new("l1", "2840 Pacific Avenue", "Pacific Heights", 4250000, 4, 3, 3200, "house", "active"),
        new("l2", "1567 Clay Street, #8", "Nob Hill", 1890000, 2, 2, 1450, "condo", "active"),
        new("l3", "3421 Fillmore Street", "Marina District", 3150000, 3, 2, 2100, "house", "pending"),
        new("l4", "890 Lombard Street, #12", "Russian Hill", 1250000, 1, 1, 890, "condo", "active"),
    ];

    private readonly TestimonialItem[] _testimonials = [
        new("Michael & Lisa P.", "Rachel helped us find our dream home in Pacific Heights. Her market knowledge is unmatched.", "Buyer"),
        new("David S.", "Sold our condo in 11 days, $50K over asking. Incredible negotiator.", "Seller"),
    ];
}
