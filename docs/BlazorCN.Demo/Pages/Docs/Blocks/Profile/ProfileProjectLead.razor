@* ============================================================
   Block: profile-project-lead
   Title: ProfileProjectLead
   Description: React project lead profile block for Next.js with active project cards, team size metrics, delivery timeline progress, methodology badges, and stakeholder management overview using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-project-lead.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Michael Okafor" />
                <AvatarFallbackCn Class="text-lg">MO</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Michael Okafor</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="circle-check-2" Size="12" Class="mr-1 size-3" />
                        94% on-time
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Senior Project Lead</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="briefcase" Size="12" Class="size-3" />
                        Meridian Systems
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Chicago, IL
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Connect</ButtonCn>
        </div>

        @* Metrics *@
        <div class="grid grid-cols-4 border-b">
            @foreach (var m in _metrics)
            {
                <div class="px-3 py-3 text-center">
                    <span class="block font-semibold text-sm tabular-nums">@m.Value</span>
                    <span class="text-muted-foreground text-xs">@m.Label</span>
                </div>
            }
        </div>

        @* Skills + Methodologies *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Core Skills</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var s in _skills)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@($"size-1.5 rounded-full {s.Color}")"></span>
                        @s.Name
                    </BadgeCn>
                }
            </div>
            <span class="mb-2 mt-3 block font-medium text-muted-foreground text-xs">Methodologies</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var m in _methodologies)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@m</BadgeCn>
                }
            </div>
        </div>

        @* Active Projects *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Projects</span>
            </div>
            @for (var i = 0; i < _projects.Length; i++)
            {
                var project = _projects[i];
                var dotClass = _statusDot.TryGetValue(project.Status, out var dot) ? dot : "bg-muted-foreground";
                var statusText = _statusLabel.TryGetValue(project.Status, out var lbl) ? lbl : project.Status;
                var isLast = i == _projects.Length - 1;
                <div class="@($"px-4 py-3 transition-colors hover:bg-muted/50 {(isLast ? "" : "border-b")}")">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="folder" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="font-medium text-sm">@project.Name</span>
                                <span class="@($"size-1.5 rounded-full {dotClass}")"></span>
                                <span class="text-muted-foreground text-xs">@statusText</span>
                            </div>
                            <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                                    @project.Team
                                </span>
                                <span>·</span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                    @project.Deadline
                                </span>
                                <span>·</span>
                                <span class="font-medium tabular-nums">@project.Budget</span>
                            </div>
                        </div>
                        <span class="shrink-0 font-mono text-xs tabular-nums">@(project.Progress)%</span>
                    </div>
                    <ProgressCn Value="@project.Progress" Class="mt-2 h-1.5" />
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MetricItem(string Label, string Value);
    private record SkillItem(string Name, string Color);
    private record ProjectItem(string Id, string Name, string Status, int Progress, int Team, string Deadline, string Budget);

    private static readonly MetricItem[] _metrics =
    [
        new("Projects delivered", "48"),
        new("On-time delivery", "94%"),
        new("Team members", "32"),
        new("Avg satisfaction", "4.8"),
    ];

    private static readonly SkillItem[] _skills =
    [
        new("Stakeholder Management", "bg-blue-500"),
        new("Risk Assessment", "bg-red-500"),
        new("Budget Planning", "bg-emerald-500"),
        new("Team Building", "bg-purple-500"),
        new("Vendor Management", "bg-amber-500"),
    ];

    private static readonly string[] _methodologies = ["Agile/Scrum", "Kanban", "SAFe", "Waterfall", "Lean"];

    private static readonly ProjectItem[] _projects =
    [
        new("p1", "Platform Migration v3", "on-track", 72, 12, "Jun 2026", "$2.4M"),
        new("p2", "Mobile App Redesign", "on-track", 45, 8, "Aug 2026", "$860K"),
        new("p3", "Data Pipeline Overhaul", "at-risk", 38, 6, "May 2026", "$1.1M"),
        new("p4", "API Gateway Integration", "completed", 100, 4, "Feb 2026", "$420K"),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["on-track"] = "bg-emerald-500",
        ["at-risk"] = "bg-amber-500",
        ["completed"] = "bg-muted-foreground",
    };

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["on-track"] = "On Track",
        ["at-risk"] = "At Risk",
        ["completed"] = "Completed",
    };
}
