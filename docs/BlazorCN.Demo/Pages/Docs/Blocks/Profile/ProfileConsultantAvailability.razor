@* ============================================================
   Block: profile-consultant-availability
   Title: ProfileConsultantAvailability
   Description: React consultant profile block for Next.js with booking calendar, expertise areas, hourly rates, and availability schedule using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-consultant-availability.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <div class="relative">
                <AvatarCn Class="size-12">
                    <AvatarFallbackCn>DO</AvatarFallbackCn>
                </AvatarCn>
                <span class="absolute bottom-0 right-0 size-3 rounded-full border-2 border-card bg-emerald-500"></span>
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">David Okafor</span>
                <p class="text-muted-foreground text-xs">Strategy &amp; Operations Consultant</p>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">Ex-McKinsey. Helping startups scale from Series A to C with operational strategy, go-to-market planning, and organizational design.</p>
                <div class="mt-1.5 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        London, UK
                    </span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="globe" Size="12" Class="size-3" />
                        GMT+0
                    </span>
                </div>
            </div>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="briefcase" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">62</span>
                <span class="text-muted-foreground">clients</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">12</span>
                <span class="text-muted-foreground">years</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="dollar-sign" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">$350</span>
                <span class="text-muted-foreground">/hr</span>
            </span>
        </div>

        @* Weekly Availability *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Weekly Availability</span>
            <div class="flex gap-2">
                @foreach (var day in _weeklyAvailability)
                {
                    <div class="flex flex-1 flex-col items-center gap-1.5">
                        <span class="font-mono text-muted-foreground text-xs">@day.Day</span>
                        <div class="flex flex-col gap-1">
                            @for (var i = 0; i < 4; i++)
                            {
                                var slotIndex = i;
                                var slotClass = slotIndex < day.Slots ? "h-2 w-full rounded-sm bg-emerald-500/60" : "h-2 w-full rounded-sm bg-muted";
                                <span class="@slotClass"></span>
                            }
                        </div>
                        <span class="font-mono text-muted-foreground text-xs tabular-nums">@day.Slots</span>
                    </div>
                }
            </div>
        </div>

        @* Engagement Types *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Engagement Types</span>
            </div>
            @for (var i = 0; i < _engagements.Length; i++)
            {
                var eng = _engagements[i];
                var isLast = i == _engagements.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@eng.Type</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@eng.Description</p>
                            <span class="mt-1 flex items-center gap-1 text-muted-foreground text-xs">
                                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                @eng.Duration
                            </span>
                        </div>
                        <span class="shrink-0 font-medium text-sm tabular-nums">@eng.Rate</span>
                    </div>
                </div>
            }
        </div>

        @* Expertise *@
        <div class="px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Expertise</span>
            <div class="space-y-2">
                @foreach (var exp in _expertise)
                {
                    var widthPct = (exp.Years / 12.0) * 100;
                    <div class="flex items-center gap-3">
                        <span class="w-36 text-xs">@exp.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="@($"width:{widthPct:F1}%")"></div>
                        </div>
                        <span class="w-10 text-right font-mono text-muted-foreground text-xs tabular-nums">@(exp.Years)y</span>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record DayAvailability(string Day, int Slots);
    private record Engagement(string Type, string Description, string Rate, string Duration);
    private record ExpertiseItem(string Name, int Years);

    private static readonly DayAvailability[] _weeklyAvailability =
    [
        new("Mon", 3),
        new("Tue", 2),
        new("Wed", 4),
        new("Thu", 1),
        new("Fri", 3),
    ];

    private static readonly Engagement[] _engagements =
    [
        new("Advisory Call", "1-hour strategy consultation", "$350", "1 hour"),
        new("Sprint Engagement", "Focused 2-week deep dive", "$12,000", "2 weeks"),
        new("Fractional COO", "Part-time operational leadership", "$8,000/mo", "3-6 months"),
        new("Board Advisory", "Monthly board-level guidance", "$5,000/mo", "Ongoing"),
    ];

    private static readonly ExpertiseItem[] _expertise =
    [
        new("Go-to-Market Strategy", 12),
        new("Operational Excellence", 10),
        new("Org Design & Scaling", 8),
        new("Financial Modeling", 7),
        new("M&A Due Diligence", 5),
    ];
}
