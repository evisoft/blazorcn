@* ============================================================
   Block: profile-virtual-assistant
   Title: ProfileVirtualAssistant
   Description: React virtual assistant profile block for Next.js with service packages, skill badges, client testimonials, availability calendar, and response time metrics using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-virtual-assistant.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="@_assistant.Avatar" Alt="@_assistant.Name" />
                <AvatarFallbackCn Class="text-lg">MS</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_assistant.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="star" Size="12" Class="mr-1 size-3 fill-amber-500 text-amber-500" />
                        @_assistant.Rating (@_assistant.Reviews)
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">@_assistant.Title</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        @_assistant.Location
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="globe" Size="12" Class="size-3" />
                        @_assistant.Timezone
                    </span>
                    <span>·</span>
                    <span>@(_assistant.YearsExperience) years</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Hire</ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_assistant.ClientsServed</span>
                <span class="text-muted-foreground">clients</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="zap" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium">@_assistant.AvgResponseTime</span>
                <span class="text-muted-foreground">avg response</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@(_assistant.CompletionRate)%</span>
                <span class="text-muted-foreground">completion</span>
            </span>
        </div>

        @* Skills *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Skills</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var s in _skills)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", s.Color)"></span>
                        @s.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Service Packages *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Service Packages</span>
            </div>
            @foreach (var pkg in _packages)
            {
                var isLast = pkg == _packages[^1];
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between">
                        <div>
                            <span class="font-medium text-sm">@pkg.Name</span>
                            <span class="ml-2 text-muted-foreground text-xs">@pkg.Hours</span>
                        </div>
                        <span class="font-medium text-sm tabular-nums">@pkg.Price</span>
                    </div>
                    <div class="mt-1.5 flex flex-wrap gap-1">
                        @foreach (var item in pkg.Includes)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">@item</BadgeCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Tools *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Tools &amp; Platforms</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var t in _tools)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@t</BadgeCn>
                }
            </div>
        </div>

        @* Availability *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Working Hours</span>
            <div class="space-y-1">
                @foreach (var av in _availability)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@av.Day</span>
                        <span class="flex items-center gap-1 font-medium">
                            <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                            @av.Hours
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Testimonials *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Client Testimonials</span>
            <div class="space-y-2">
                @foreach (var t in _testimonials)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-sm leading-relaxed">"@(t.Text)"</p>
                        <span class="mt-2 block font-medium text-muted-foreground text-xs">@t.Name</span>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record AssistantInfo(
        string Name, string Avatar, string Title, string Location, string Timezone,
        int YearsExperience, int ClientsServed, string AvgResponseTime,
        double CompletionRate, double Rating, int Reviews);

    private record SkillItem(string Name, string Color);
    private record ServicePackage(string Name, string Hours, string Price, string[] Includes);
    private record AvailabilitySlot(string Day, string Hours);
    private record Testimonial(string Name, string Text);

    private static readonly AssistantInfo _assistant = new(
        "Maria Santos", "", "Executive Virtual Assistant",
        "Manila, PH", "UTC+8", 5, 38, "12 min", 99.2, 4.9, 92);

    private static readonly SkillItem[] _skills =
    [
        new("Email Management", "bg-blue-500"),
        new("Calendar Scheduling", "bg-emerald-500"),
        new("Data Entry", "bg-amber-500"),
        new("Social Media", "bg-pink-500"),
        new("Bookkeeping", "bg-purple-500"),
        new("Travel Planning", "bg-cyan-500"),
        new("CRM Management", "bg-red-500"),
    ];

    private static readonly string[] _tools =
    [
        "Google Workspace", "Microsoft 365", "Slack", "Notion",
        "QuickBooks", "HubSpot", "Asana", "Canva",
    ];

    private static readonly ServicePackage[] _packages =
    [
        new("Starter", "20 hrs/month", "$500/mo", ["Email management", "Calendar scheduling", "Basic data entry"]),
        new("Professional", "40 hrs/month", "$900/mo", ["Everything in Starter", "Social media posting", "Travel booking", "CRM updates"]),
        new("Executive", "80 hrs/month", "$1,600/mo", ["Everything in Professional", "Bookkeeping", "Report preparation", "Priority response"]),
    ];

    private static readonly AvailabilitySlot[] _availability =
    [
        new("Mon-Fri", "8:00 AM - 5:00 PM PHT"),
        new("Overlap", "8:00 PM - 5:00 AM EST"),
    ];

    private static readonly Testimonial[] _testimonials =
    [
        new("CEO, SaaS Startup", "Maria handles my entire inbox and calendar. I've reclaimed 15+ hours per week to focus on strategy."),
        new("Founder, E-commerce", "Incredibly organized and proactive. She anticipates needs before I even ask. Worth every penny."),
    ];
}
