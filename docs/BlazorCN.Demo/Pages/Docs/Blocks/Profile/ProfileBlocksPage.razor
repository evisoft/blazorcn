@page "/docs/blocks/profile"
@layout DocsLayout

<PageTitle>Profile Blocks — BlazorCN</PageTitle>

<div class="space-y-6">
    <div>
        <h1 class="text-3xl font-bold tracking-tight">Profile</h1>
        <p class="mt-2 text-lg text-muted-foreground">Profile blocks for activity timelines, AI engineers, architects, authors, content creators, event organizers, fitness trackers, podcast hosts, and real estate agents.</p>
    </div>

    <SeparatorCn />

    <ComponentPreview Title="Activity Timeline" Description="Profile activity timeline with recent actions, commit history, PR reviews, deployment events, and expandable detail rows." Code="@ProfileActivityTimelineCode">
        <ProfileActivityTimeline />
    </ComponentPreview>

    <ComponentPreview Title="AI Engineer" Description="AI engineer profile with model deployment status, benchmark scores, GPU utilization metrics, research paper list, and tech stack badges." Code="@ProfileAiEngineerCode">
        <ProfileAiEngineer />
    </ComponentPreview>

    <ComponentPreview Title="Architect Projects" Description="Architect projects profile with project gallery cards, award listings, building typology breakdown, and sustainability metrics." Code="@ProfileArchitectProjectsCode">
        <ProfileArchitectProjects />
    </ComponentPreview>

    <ComponentPreview Title="Author Page" Description="Author page profile with published books grid, bestseller badges, reading stats, genre tags, and awards section." Code="@ProfileAuthorPageCode">
        <ProfileAuthorPage />
    </ComponentPreview>

    <ComponentPreview Title="Content Creator" Description="Content creator profile with platform analytics, video performance grid, audience demographics bar chart, and brand collaboration section." Code="@ProfileContentCreatorCode">
        <ProfileContentCreator />
    </ComponentPreview>

    <ComponentPreview Title="Event Organizer" Description="Event organizer profile with upcoming and past event cards, ticket sales metrics, and speaker lineup section." Code="@ProfileEventOrganizerCode">
        <ProfileEventOrganizer />
    </ComponentPreview>

    <ComponentPreview Title="Fitness Tracker" Description="Fitness tracking profile with daily stats grid, weekly goal progress bars, workout history list, and activity metrics." Code="@ProfileFitnessTrackerCode">
        <ProfileFitnessTracker />
    </ComponentPreview>

    <ComponentPreview Title="Podcast Host" Description="Podcast host profile with episode list, listener stats, platform distribution, and audio waveform visualization." Code="@ProfilePodcastHostCode">
        <ProfilePodcastHost />
    </ComponentPreview>

    <ComponentPreview Title="Real Estate Agent" Description="Real estate agent profile with active listings grid, sales volume metrics, neighborhood expertise, client testimonials, and license verification." Code="@ProfileRealEstateAgentCode">
        <ProfileRealEstateAgent />
    </ComponentPreview>
</div>

@code {
    private const string ProfileActivityTimelineCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Profile header *@
        <div class=""flex items-center gap-3 border-b px-4 py-3"">
            <AvatarCn Class=""size-10"">
                <AvatarImageCn Src="""" Alt=""Alex Rivera"" />
                <AvatarFallbackCn>AR</AvatarFallbackCn>
            </AvatarCn>
            <div class=""min-w-0 flex-1"">
                <div class=""flex items-center gap-2"">
                    <span class=""font-medium text-sm"">Alex Rivera</span>
                    <span class=""font-mono text-muted-foreground text-xs"">@@arivera</span>
                </div>
                <span class=""text-muted-foreground text-xs"">Full-Stack Engineer</span>
            </div>
            <div class=""flex items-center gap-3 text-xs"">
                <span class=""text-muted-foreground"">
                    <span class=""font-medium tabular-nums text-foreground"">12</span> today
                </span>
                <span class=""text-muted-foreground"">
                    <span class=""font-medium tabular-nums text-foreground"">47</span> this week
                </span>
            </div>
        </div>

        @* Filter bar *@
        <div class=""flex items-center gap-2 border-b px-4 py-2"">
            <LucideFilterCn Size=""12"" Class=""text-muted-foreground"" />
            <span class=""font-medium text-muted-foreground text-xs"">Recent activity</span>
            <span class=""ml-auto text-muted-foreground text-xs tabular-nums"">@_activities.Length events</span>
        </div>

        @* Timeline *@
        <div>
            @for (var idx = 0; idx < _activities.Length; idx++)
            {
                var activity = _activities[idx];
                var isExpanded = _expanded == activity.Id;
                var isLast = idx == _activities.Length - 1;
                <div class=""@(isLast ? """" : ""border-b"")"">
                    <button type=""button"" @onclick=""() => _expanded = isExpanded ? null : activity.Id""
                            class=""flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"">
                        <div class=""relative flex size-7 shrink-0 items-center justify-center rounded-full bg-muted/50 text-muted-foreground"">
                            @if (activity.Type == ""commit"")
                            {
                                <LucideGitCommitHorizontalCn Size=""14"" />
                            }
                            else if (activity.Type == ""review"")
                            {
                                <LucideGitPullRequestCn Size=""14"" />
                            }
                            else if (activity.Type == ""deploy"")
                            {
                                <LucideRocketCn Size=""14"" />
                            }
                            else
                            {
                                <LucideMessageSquareCn Size=""14"" />
                            }
                            <span class=""@($""absolute -top-0.5 -right-0.5 size-2 rounded-full {activity.DotColor}"")""></span>
                        </div>
                        <div class=""min-w-0 flex-1"">
                            <div class=""flex items-center gap-2"">
                                <span class=""font-medium text-sm"">@activity.Title</span>
                                <span class=""text-muted-foreground text-xs"">@activity.Time</span>
                            </div>
                            <p class=""mt-0.5 truncate text-muted-foreground text-xs"">@activity.Description</p>
                        </div>
                        <BadgeCn Variant=""BadgeVariant.Outline"" Class=""hidden font-mono font-normal text-xs sm:inline-flex"">
                            @activity.Repo
                        </BadgeCn>
                        <LucideChevronRightCn Size=""16"" Class=""@Cn.Merge(""shrink-0 text-muted-foreground/60 transition-transform duration-200"", isExpanded ? ""rotate-90"" : """")"" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class=""px-4 pb-4 pl-14"">
                            <div class=""rounded-md bg-muted/50 p-3"">
                                @if (!string.IsNullOrEmpty(activity.Branch))
                                {
                                    <div class=""mb-2"">
                                        <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-mono font-normal text-xs"">@activity.Branch</BadgeCn>
                                    </div>
                                }
                                <p class=""whitespace-pre-line text-sm leading-relaxed"">@activity.Detail</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ActivityItem(string Id, string Type, string DotColor, string Title, string Description, string Detail, string Time, string Repo, string? Branch = null);

    private string? _expanded = ""1"";

    private readonly ActivityItem[] _activities =
    [
        new(""1"", ""deploy"", ""bg-amber-500"", ""Deployed to production"", ""v2.14.0 — 3 new features, 7 bug fixes"",
            ""Deployment completed in 2m 34s. All health checks passed. Zero-downtime rollout across 3 regions (us-east-1, eu-west-1, ap-southeast-1). 100% traffic shifted."",
            ""14 min ago"", ""acme/web-app""),
        new(""2"", ""commit"", ""bg-blue-500"", ""Pushed 3 commits"", ""fix: resolve race condition in auth flow"",
            ""fix: resolve race condition in auth flow\nrefactor: extract session validation to middleware\ntest: add integration tests for OAuth callback\n\n4 files changed, 127 insertions(+), 43 deletions(-)"",
            ""28 min ago"", ""acme/web-app"", ""fix/auth-race""),
        new(""3"", ""review"", ""bg-emerald-500"", ""Approved pull request"", ""#482 — Add rate limiting to API endpoints"",
            ""Reviewed 12 files across 4 commits. Left 2 comments on the sliding window implementation. Suggested using Redis sorted sets instead of in-memory counters for multi-instance deployments. Approved after changes."",
            ""1h ago"", ""acme/api-gateway""),
        new(""4"", ""comment"", ""bg-muted-foreground"", ""Commented on issue"", ""#219 — Memory leak in WebSocket handler"",
            ""Identified the root cause: event listeners were not being cleaned up on client disconnect. The connection pool was holding references to closed sockets. Proposed fix: add a cleanup hook in the disconnect handler and set a 30-second timeout for stale connections."",
            ""2h ago"", ""acme/realtime-engine""),
        new(""5"", ""commit"", ""bg-blue-500"", ""Pushed 1 commit"", ""feat: add search indexing for docs"",
            ""Implemented full-text search indexing using Postgres tsvector columns. Added a background job to re-index on content updates. Search results now include highlighted snippets.\n\n2 files changed, 89 insertions(+), 12 deletions(-)"",
            ""3h ago"", ""acme/docs"", ""feat/search""),
        new(""6"", ""deploy"", ""bg-amber-500"", ""Deployed to staging"", ""v2.14.0-rc.2 — pre-release validation"",
            ""Staging deployment for final QA validation. Ran 342 integration tests — all passed. Performance benchmarks show 12% improvement in API response time compared to v2.13.0."",
            ""4h ago"", ""acme/web-app""),
    ];
}";
    private const string ProfileAiEngineerCode = @"<section class=""mx-auto w-full max-w-2xl p-4"">
    <div class=""overflow-hidden rounded-lg border bg-card"">
        @* Header *@
        <div class=""flex items-start gap-4 border-b px-4 py-4"">
            <AvatarCn Class=""size-12"">
                <AvatarFallbackCn>SK</AvatarFallbackCn>
            </AvatarCn>
            <div class=""min-w-0 flex-1"">
                <div class=""flex items-center gap-2"">
                    <span class=""font-medium text-sm"">Dr. Sarah Kim</span>
                    <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">Anthropic</BadgeCn>
                </div>
                <span class=""text-muted-foreground text-xs"">Staff AI Engineer</span>
                <p class=""mt-1 text-muted-foreground text-sm leading-relaxed"">
                    Building safe and reliable AI systems. PhD in ML from MIT. Previously at DeepMind.
                    Focus areas: alignment, interpretability, and efficient inference.
                </p>
            </div>
        </div>

        @* Stats *@
        <div class=""flex items-center gap-4 border-b px-4 py-3"">
            <span class=""flex items-center gap-1.5 text-xs"">
                <LucideBrainCircuitCn Size=""12"" Class=""size-3 text-muted-foreground"" />
                <span class=""font-medium tabular-nums"">7</span>
                <span class=""text-muted-foreground"">models deployed</span>
            </span>
            <span class=""text-muted-foreground text-xs"">&middot;</span>
            <span class=""flex items-center gap-1.5 text-xs"">
                <LucideFileTextCn Size=""12"" Class=""size-3 text-muted-foreground"" />
                <span class=""font-medium tabular-nums"">18</span>
                <span class=""text-muted-foreground"">papers</span>
            </span>
            <span class=""text-muted-foreground text-xs"">&middot;</span>
            <span class=""flex items-center gap-1.5 text-xs"">
                <span class=""font-medium tabular-nums"">4.2K</span>
                <span class=""text-muted-foreground"">citations</span>
            </span>
        </div>

        @* Tabbed content *@
        <TabsCn Value=""models"" Class=""w-full"">
            <TabsListCn Class=""w-full justify-start border-b px-4"">
                <TabsTriggerCn Value=""models"" Class=""text-xs"">Models</TabsTriggerCn>
                <TabsTriggerCn Value=""papers"" Class=""text-xs"">Papers</TabsTriggerCn>
                <TabsTriggerCn Value=""infra"" Class=""text-xs"">Infrastructure</TabsTriggerCn>
            </TabsListCn>

            @* Models tab *@
            <TabsContentCn Value=""models"" Class=""mt-0"">
                @for (var i = 0; i < _models.Count; i++)
                {
                    var model = _models[i];
                    var isLast = i == _models.Count - 1;
                    <div class=""@Cn.Merge(""px-4 py-3 transition-colors hover:bg-muted/50"", isLast ? """" : ""border-b"")"">
                        <div class=""flex items-center gap-2"">
                            <span class=""@Cn.Merge(""size-1.5 shrink-0 rounded-full"", model.StatusColor)""></span>
                            <span class=""font-mono font-medium text-sm"">@model.Name</span>
                            <BadgeCn Variant=""BadgeVariant.Outline"" Class=""font-mono font-normal text-xs"">
                                v@model.Version
                            </BadgeCn>
                            <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""ml-auto font-normal text-xs capitalize"">
                                @model.Status
                            </BadgeCn>
                        </div>
                        <div class=""mt-1.5 flex items-center gap-4 pl-3.5 text-muted-foreground text-xs"">
                            <span class=""flex items-center gap-1 tabular-nums"">
                                <LucideGaugeCn Size=""12"" Class=""size-3"" />
                                @model.Latency
                            </span>
                            <span class=""flex items-center gap-1 tabular-nums"">
                                <LucideZapCn Size=""12"" Class=""size-3"" />
                                @model.Throughput
                            </span>
                            <span class=""ml-auto"">@model.LastDeployed</span>
                        </div>
                    </div>
                }
            </TabsContentCn>

            @* Papers tab *@
            <TabsContentCn Value=""papers"" Class=""mt-0"">
                @for (var i = 0; i < _papers.Count; i++)
                {
                    var paper = _papers[i];
                    var isLast = i == _papers.Count - 1;
                    <div class=""@Cn.Merge(""px-4 py-3 transition-colors hover:bg-muted/50"", isLast ? """" : ""border-b"")"">
                        <span class=""font-medium text-sm"">@paper.Title</span>
                        <div class=""mt-1 flex items-center gap-2 text-muted-foreground text-xs"">
                            <BadgeCn Variant=""BadgeVariant.Outline"" Class=""font-normal text-xs"">@paper.Venue</BadgeCn>
                            <span>@paper.Year</span>
                            <span>&middot;</span>
                            <span class=""tabular-nums"">@paper.Citations citations</span>
                        </div>
                    </div>
                }
            </TabsContentCn>

            @* Infrastructure tab *@
            <TabsContentCn Value=""infra"" Class=""mt-0"">
                <div class=""border-b px-4 py-2"">
                    <span class=""font-medium text-muted-foreground text-xs"">GPU cluster utilization</span>
                </div>
                @for (var i = 0; i < _gpus.Count; i++)
                {
                    var gpu = _gpus[i];
                    var isLast = i == _gpus.Count - 1;
                    var barColor = gpu.Utilization >= 90 ? ""bg-red-500"" : gpu.Utilization >= 70 ? ""bg-amber-500"" : ""bg-emerald-500"";
                    <div class=""@Cn.Merge(""px-4 py-3"", isLast ? """" : ""border-b"")"">
                        <div class=""flex items-center justify-between"">
                            <div class=""flex items-center gap-2"">
                                <LucideCpuCn Size=""14"" Class=""size-3.5 text-muted-foreground"" />
                                <span class=""font-mono text-sm"">@gpu.Name</span>
                            </div>
                            <span class=""font-mono text-muted-foreground text-xs tabular-nums"">@gpu.Memory</span>
                        </div>
                        <div class=""mt-1.5 flex items-center gap-2"">
                            <div class=""h-1.5 flex-1 overflow-hidden rounded-full bg-muted/50"">
                                <div class=""@Cn.Merge(""h-full rounded-full"", barColor)"" style=""width: @(gpu.Utilization)%""></div>
                            </div>
                            <span class=""w-8 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums"">
                                @(gpu.Utilization)%
                            </span>
                        </div>
                    </div>
                }
            </TabsContentCn>
        </TabsCn>

        @* Benchmark scores *@
        <div class=""border-t px-4 py-3"">
            <span class=""mb-2.5 block font-medium text-muted-foreground text-xs"">Latest benchmark scores</span>
            <div class=""space-y-2"">
                @foreach (var bench in _benchmarks)
                {
                    <div class=""flex items-center gap-3"">
                        <span class=""w-20 shrink-0 font-mono text-xs"">@bench.Name</span>
                        <div class=""h-1.5 flex-1 overflow-hidden rounded-full bg-muted/50"">
                            <div class=""h-full rounded-full bg-foreground/70"" style=""width: @(bench.Score / bench.Max * 100)%""></div>
                        </div>
                        <span class=""w-10 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums"">
                            @bench.Score
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Tech stack *@
        <div class=""border-t px-4 py-3"">
            <span class=""mb-2 block font-medium text-muted-foreground text-xs"">Tech stack</span>
            <div class=""flex flex-wrap gap-1.5"">
                @foreach (var tech in _techStack)
                {
                    <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">@tech</BadgeCn>
                }
            </div>
        </div>
    </div>
</section>

