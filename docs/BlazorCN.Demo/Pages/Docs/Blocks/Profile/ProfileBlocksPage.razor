                <p class=""mt-1.5 text-muted-foreground text-sm leading-relaxed"">15 years in engineering leadership. Helping ICs transition to management and senior engineers reach staff level. 400+ mentees across 12 countries.</p>
            </div>
        </div>

        @* Stats *@
        <div class=""flex items-center gap-4 border-b px-4 py-3"">
            <span class=""flex items-center gap-1 text-xs"">
                <LucideIconCn Name=""star"" Size=""12"" Class=""size-3 text-amber-500"" />
                <span class=""font-medium tabular-nums"">4.9</span>
                <span class=""text-muted-foreground"">(186)</span>
            </span>
            <span class=""text-muted-foreground text-xs"">&middot;</span>
            <span class=""flex items-center gap-1.5 text-xs"">
                <LucideIconCn Name=""users"" Size=""12"" Class=""size-3 text-muted-foreground"" />
                <span class=""font-medium tabular-nums"">412</span>
                <span class=""text-muted-foreground"">sessions</span>
            </span>
            <span class=""text-muted-foreground text-xs"">&middot;</span>
            <span class=""flex items-center gap-1.5 text-xs"">
                <LucideIconCn Name=""clock"" Size=""12"" Class=""size-3 text-muted-foreground"" />
                <span class=""text-muted-foreground"">&lt; 2 hours response</span>
            </span>
        </div>

        @* Expertise *@
        <div class=""border-b px-4 py-3"">
            <span class=""mb-2 block font-medium text-muted-foreground text-xs"">Expertise</span>
            <div class=""flex flex-wrap gap-1.5"">
                @foreach (var topic in _expertise)
                {
                    <BadgeCn Variant=""BadgeVariant.Secondary"" Class=""font-normal text-xs"">@topic</BadgeCn>
                }
            </div>
        </div>

        @* Session types *@
        <div class=""border-b px-4 py-3"">
            <span class=""mb-2.5 block font-medium text-muted-foreground text-xs"">Session types</span>
            <div class=""space-y-2"">
                @foreach (var session in _sessionTypes)
                {
                    var sess = session;
                    var isSelected = _selectedSession == sess.Id;
                    <div role=""button""
                         tabindex=""0""
                         @onclick=""@(() => _selectedSession = sess.Id)""
                         class=""@Cn.Merge(""cursor-pointer rounded-md border p-3 transition-colors"", isSelected ? ""border-foreground/20 bg-muted/50"" : ""hover:bg-muted/30"")"">
                        <div class=""flex items-center justify-between"">
                            <div class=""flex items-center gap-2"">
                                <LucideIconCn Name=""@GetSessionIcon(sess.Icon)"" Size=""14"" Class=""size-3.5 text-muted-foreground"" />
                                <span class=""font-medium text-sm"">@sess.Name</span>
                            </div>
                            <div class=""flex items-center gap-2 text-xs"">
                                <span class=""text-muted-foreground"">@sess.Duration</span>
                                <span class=""font-medium tabular-nums"">@sess.Price</span>
                            </div>
                        </div>
                        <p class=""mt-1 text-muted-foreground text-xs"">@sess.Description</p>
                    </div>
                }
            </div>
        </div>

        @* Weekly availability grid *@
        <div class=""border-b px-4 py-3"">
            <div class=""mb-2.5 flex items-center justify-between"">
                <span class=""font-medium text-muted-foreground text-xs"">
                    <LucideIconCn Name=""calendar"" Size=""12"" Class=""mr-1 inline size-3"" />
                    This week
                </span>
                <span class=""text-muted-foreground text-xs"">PST timezone</span>
            </div>
            <div class=""grid grid-cols-5 gap-1.5"">
                @foreach (var daySchedule in _weekSchedule)
                {
                    var day = daySchedule;
                    <div class=""space-y-1"">
                        <span class=""block text-center font-medium text-muted-foreground text-xs"">@day.Day</span>
                        @foreach (var timeSlot in day.Slots)
                        {
                            var slot = timeSlot;
                            var slotKey = $""{day.Day}-{slot.Time}"";
                            var slotIsSelected = _selectedSlot == slotKey;
                            <button type=""button""
                                    disabled=""@(!slot.Available)""
                                    @onclick=""@(() => _selectedSlot = slotIsSelected ? null : slotKey)""
                                    class=""@Cn.Merge(""w-full rounded-md px-1 py-1.5 text-center text-xs transition-colors"", !slot.Available ? ""cursor-not-allowed bg-muted/30 text-muted-foreground/40"" : slotIsSelected ? ""bg-foreground text-background ring-2 ring-foreground ring-offset-1 ring-offset-card"" : ""bg-emerald-500/10 text-emerald-700 hover:bg-emerald-500/20 dark:text-emerald-400"")"">
                                @slot.Time
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        @* Reviews *@
        <div>
            <div class=""border-b px-4 py-2"">
                <span class=""font-medium text-muted-foreground text-xs"">Recent reviews</span>
            </div>
            @for (var i = 0; i < _reviews.Length; i++)
            {
                var review = _reviews[i];
                var idx = i;
                <div class=""@Cn.Merge(""px-4 py-3"", idx < _reviews.Length - 1 ? ""border-b"" : """")"">
                    <div class=""flex items-center justify-between"">
                        <div class=""flex items-center gap-2"">
                            <span class=""font-medium text-xs"">@review.Name</span>
                            <span class=""text-muted-foreground text-xs"">@review.Role</span>
                        </div>
                        <div class=""flex items-center gap-0.5"">
                            @for (var s = 0; s < review.Rating; s++)
                            {
                                <LucideIconCn Name=""star"" Size=""12"" Class=""size-3 fill-amber-500 text-amber-500"" />
                            }
                        </div>
                    </div>
                    <p class=""mt-1 text-muted-foreground text-sm leading-relaxed"">@review.Text</p>
                    <span class=""mt-1 block text-muted-foreground/60 text-xs"">@review.Time</span>
                </div>
            }
        </div>

    </div>
</section>

