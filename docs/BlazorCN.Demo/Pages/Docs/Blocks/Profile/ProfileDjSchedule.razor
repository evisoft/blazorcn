@* ============================================================
   Block: profile-dj-schedule
   Title: ProfileDjSchedule
   Description: React DJ profile block for Next.js with event schedule, genre expertise, setlist archive, and venue history using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-dj-schedule.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Profile header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarFallbackCn>KL</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">DJ Kael</span>
                    <span class="text-muted-foreground text-xs">(Kai Lehmann)</span>
                </div>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                    Berlin-based DJ and producer. Resident at Berghain and Fabric. Playing deep techno, progressive house, and ambient electronica since 2014.
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Book
            </ButtonCn>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideHeadphonesCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">620</span>
                <span class="text-muted-foreground">gigs</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideMapPinCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">28</span>
                <span class="text-muted-foreground">countries</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideMusicCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">124</span>
                <span class="text-muted-foreground">avg BPM</span>
            </span>
        </div>

        @* Genres *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Genres</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var g in _genres)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@g</BadgeCn>
                }
            </div>
        </div>

        @* Upcoming Events *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Upcoming Events</span>
            </div>
            @for (var i = 0; i < _upcomingEvents.Length; i++)
            {
                var ev = _upcomingEvents[i];
                var isLast = i == _upcomingEvents.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@ev.Venue</span>
                                @if (ev.SoldOut)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Sold Out</BadgeCn>
                                }
                            </div>
                            <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideMapPinCn Size="12" Class="size-3" />
                                    @ev.City
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideCalendarCn Size="12" Class="size-3" />
                                    @ev.Date
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideClockCn Size="12" Class="size-3" />
                                    @ev.Time
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Recent Sets *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent Sets</span>
            </div>
            @for (var i = 0; i < _recentSets.Length; i++)
            {
                var set = _recentSets[i];
                var isLast = i == _recentSets.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted">
                        <LucideMusicCn Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@set.Title</span>
                    </div>
                    <div class="flex items-center gap-3 text-muted-foreground text-xs">
                        <span>@set.Duration</span>
                        <span class="flex items-center gap-1">
                            <LucideUsersCn Size="12" Class="size-3" />
                            @set.Plays
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private static readonly string[] _genres = ["Deep Techno", "Progressive House", "Ambient", "Minimal", "Acid", "Breaks"];

    private record EventItem(string Id, string Venue, string City, string Date, string Time, string[] Lineup, bool SoldOut);

    private static readonly EventItem[] _upcomingEvents =
    [
        new("e1", "Berghain", "Berlin", "Apr 5, 2026", "23:00 - 06:00", ["DJ Kael", "Amelie Lens", "I Hate Models"], false),
        new("e2", "Fabric", "London", "Apr 12, 2026", "22:00 - 05:00", ["DJ Kael", "Ben UFO", "Joy Orbison"], true),
        new("e3", "Output", "Brooklyn", "Apr 19, 2026", "22:00 - 04:00", ["DJ Kael", "Charlotte de Witte"], false),
        new("e4", "Womb", "Tokyo", "May 3, 2026", "23:00 - 06:00", ["DJ Kael", "Jeff Mills"], false),
    ];

    private record SetItem(string Title, string Duration, string Plays);

    private static readonly SetItem[] _recentSets =
    [
        new("Berghain Panorama Bar - 4hr Set", "4:02:18", "24.8K"),
        new("Fabric Room 1 - Live Recording", "2:45:30", "18.2K"),
        new("Sonar Festival 2025 - Main Stage", "1:30:00", "42.1K"),
    ];
}
