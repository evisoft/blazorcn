@* ============================================================
   Block: profile-professor-courses
   Title: ProfileProfessorCourses
   Description: React professor course catalog profile block for Next.js with teaching portfolio, course listings, student ratings, research interests, and office hours display using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-professor-courses.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="@_professor.Avatar" Alt="@_professor.Name" />
                <AvatarFallbackCn Class="text-lg">MS</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_professor.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="star" Size="12" Class="mr-1 size-3 fill-amber-500 text-amber-500" />
                        @_professor.Rating
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">@_professor.Title</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="graduation-cap" Size="12" Class="size-3" />
                        @_professor.University
                    </span>
                    <span>·</span>
                    <span>@(_professor.YearsTeaching) years</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Email</ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="book-open" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_professor.Publications</span>
                <span class="text-muted-foreground">publications</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_professor.Reviews</span>
                <span class="text-muted-foreground">reviews</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">@_courses.Length</span>
                <span class="text-muted-foreground">courses</span>
            </span>
        </div>

        @* Rating breakdown *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Student Ratings</span>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var item in _ratingBreakdown)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@item.Label</span>
                        <span class="font-medium tabular-nums">@(item.Score)/5</span>
                    </div>
                }
            </div>
        </div>

        @* Research interests *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Research Interests</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var r in _researchInterests)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", r.Color)"></span>
                        @r.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Courses *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Course Catalog</span>
            </div>
            @for (var i = 0; i < _courses.Length; i++)
            {
                var course = _courses[i];
                var isLast = i == _courses.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-mono font-medium text-sm">@course.Code</span>
                                <span class="font-medium text-sm">@course.Name</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-3 text-muted-foreground text-xs">
                                <span>@course.Semester</span>
                                <span>·</span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                                    @(course.Enrolled)/@(course.Capacity)
                                </span>
                            </div>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 shrink-0 px-1.5 font-normal text-[10px]">
                            @course.Level
                        </BadgeCn>
                    </div>
                </div>
            }
        </div>

        @* Office hours *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Office Hours</span>
            <div class="space-y-1.5">
                @foreach (var oh in _officeHours)
                {
                    <div class="flex items-center gap-3 text-xs">
                        <span class="w-20 font-medium">@oh.Day</span>
                        <span class="flex items-center gap-1 text-muted-foreground">
                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                            @oh.Time
                        </span>
                        <span class="flex items-center gap-1 text-muted-foreground">
                            <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                            @oh.Location
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ProfessorInfo(string Name, string Avatar, string Title, string Department,
        string University, string Location, double Rating, int Reviews, int Publications, int YearsTeaching);

    private record ResearchInterest(string Name, string Color);

    private record CourseItem(string Id, string Code, string Name, string Semester,
        int Enrolled, int Capacity, string Level);

    private record RatingItem(string Label, double Score);

    private record OfficeHour(string Day, string Time, string Location);

    private static readonly ProfessorInfo _professor = new(
        Name: "Dr. Margaret Sullivan",
        Avatar: "",
        Title: "Professor of Computer Science",
        Department: "Department of Computer Science",
        University: "Stanford University",
        Location: "Stanford, CA",
        Rating: 4.7,
        Reviews: 284,
        Publications: 89,
        YearsTeaching: 16
    );

    private static readonly ResearchInterest[] _researchInterests =
    [
        new("Machine Learning", "bg-blue-500"),
        new("Natural Language Processing", "bg-purple-500"),
        new("Computer Vision", "bg-emerald-500"),
        new("Distributed Systems", "bg-amber-500"),
        new("AI Ethics", "bg-pink-500"),
    ];

    private static readonly CourseItem[] _courses =
    [
        new("c1", "CS 229", "Machine Learning", "Spring 2026", 320, 350, "Graduate"),
        new("c2", "CS 231N", "Deep Learning for Computer Vision", "Spring 2026", 180, 200, "Graduate"),
        new("c3", "CS 106B", "Programming Abstractions", "Spring 2026", 450, 500, "Undergraduate"),
        new("c4", "CS 330", "Deep Multi-Task & Meta Learning", "Fall 2025", 145, 150, "Graduate"),
    ];

    private static readonly RatingItem[] _ratingBreakdown =
    [
        new("Clarity", 4.8),
        new("Engagement", 4.6),
        new("Helpfulness", 4.9),
        new("Difficulty", 3.8),
    ];

    private static readonly OfficeHour[] _officeHours =
    [
        new("Tuesday", "2:00 PM - 4:00 PM", "Gates 284"),
        new("Thursday", "10:00 AM - 12:00 PM", "Gates 284"),
        new("Friday", "By appointment", "Zoom"),
    ];
}
