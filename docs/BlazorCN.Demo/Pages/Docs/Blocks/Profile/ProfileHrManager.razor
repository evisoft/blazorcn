@* ============================================================
   Block: profile-hr-manager
   Title: ProfileHrManager
   Description: React HR manager profile block for Next.js with team statistics, hiring pipeline metrics, employee satisfaction scores, and department overview using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-hr-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="@_profile.Avatar" Alt="@_profile.Name" />
                <AvatarFallbackCn>RK</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_profile.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_profile.Company</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">@_profile.Title</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">@_profile.Bio</p>
            </div>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">1,200</span>
                <span class="text-muted-foreground">employees</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="user-plus" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_profile.OpenRoles</span>
                <span class="text-muted-foreground">open roles</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="smile" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_profile.ENps</span>
                <span class="text-muted-foreground">eNPS</span>
            </span>
        </div>

        @* Key Metrics *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Key Metrics</span>
            <div class="grid grid-cols-2 gap-3">
                @foreach (var metric in _teamMetrics)
                {
                    <div class="rounded-md bg-muted/50 p-2.5">
                        <span class="text-muted-foreground text-xs">@metric.Label</span>
                        <div class="mt-1 flex items-center gap-2">
                            <span class="font-semibold text-lg tabular-nums">@metric.Value</span>
                            <span class="text-emerald-600 text-xs dark:text-emerald-400">@metric.Trend</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Departments *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Departments</span>
            </div>
            @for (var i = 0; i < _departments.Length; i++)
            {
                var dept = _departments[i];
                var isLast = i == _departments.Length - 1;
                <div class="@Cn.Merge("px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-3">
                            <span class="font-medium text-sm">@dept.Name</span>
                            <span class="text-muted-foreground text-xs">@dept.Headcount people</span>
                            @if (dept.OpenRoles > 0)
                            {
                                <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@dept.OpenRoles open</BadgeCn>
                            }
                        </div>
                        <div class="flex items-center gap-2">
                            <ProgressCn Value="@dept.Satisfaction" Class="h-1.5 w-16" />
                            <span class="font-mono text-muted-foreground text-xs tabular-nums">@(dept.Satisfaction)%</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Active Initiatives *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Active Initiatives</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var init in _initiatives)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@init</BadgeCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ProfileInfo(string Name, string Title, string Avatar, string Company, string Bio, int TeamSize, int OpenRoles, int ENps);
    private record TeamMetric(string Label, string Value, string Trend);
    private record Department(string Name, int Headcount, int OpenRoles, int Satisfaction);

    private static readonly ProfileInfo _profile = new(
        "Rachel Kim",
        "VP of People & Culture",
        "",
        "Figma",
        "Leading people operations for a 1,200-person org. Building equitable hiring practices, high-performance culture, and employee development programs.",
        1200,
        34,
        72
    );

    private static readonly TeamMetric[] _teamMetrics =
    [
        new("Retention Rate", "94%", "+2%"),
        new("Time to Hire", "28 days", "-5 days"),
        new("Offer Acceptance", "88%", "+4%"),
        new("Diversity Index", "0.82", "+0.06"),
    ];

    private static readonly Department[] _departments =
    [
        new("Engineering", 480, 14, 78),
        new("Design", 120, 6, 82),
        new("Product", 85, 4, 76),
        new("Marketing", 95, 5, 80),
        new("Sales", 210, 8, 71),
    ];

    private static readonly string[] _initiatives =
    [
        "DEI Program",
        "Manager Training",
        "Career Ladders",
        "Wellness Benefits",
        "Remote Policy",
    ];
}
