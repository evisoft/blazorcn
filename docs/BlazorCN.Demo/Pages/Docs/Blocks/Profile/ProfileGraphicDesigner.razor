@* ============================================================
   Block: profile-graphic-designer
   Title: ProfileGraphicDesigner
   Description: React graphic designer profile block for Next.js with style gallery, brand identity projects, tool proficiency, and design philosophy using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-graphic-designer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="@_profile.Avatar" Alt="@_profile.Name" />
                <AvatarFallbackCn>MJ</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">@_profile.Name</span>
                <p class="text-muted-foreground text-xs">@_profile.Title</p>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">@_profile.Bio</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Portfolio
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="layers" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_profile.Projects</span>
                <span class="text-muted-foreground">projects</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="palette" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_profile.Brands</span>
                <span class="text-muted-foreground">brands</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">@_profile.Awards</span>
                <span class="text-muted-foreground">awards</span>
            </span>
        </div>

        @* Featured Work *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Featured Work</span>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var project in _featuredProjects)
                {
                    <div class="group cursor-pointer overflow-hidden rounded-md border transition-colors hover:border-foreground/20">
                        <div class="flex h-24 items-center justify-center bg-muted">
                            <LucideIconCn Name="pen-tool" Size="20" Class="size-5 text-muted-foreground/30" />
                        </div>
                        <div class="p-2.5">
                            <span class="font-medium text-xs">@project.Title</span>
                            <div class="mt-1 flex items-center justify-between">
                                <span class="text-muted-foreground text-xs">@project.Client</span>
                                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                                    <span class="flex items-center gap-0.5">
                                        <LucideIconCn Name="eye" Size="12" Class="size-3" />
                                        @FormatCount(project.Views)
                                    </span>
                                    <span class="flex items-center gap-0.5">
                                        <LucideIconCn Name="heart" Size="12" Class="size-3" />
                                        @FormatCount(project.Likes)
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Tools *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Tools</span>
            <div class="space-y-2">
                @foreach (var tool in _tools)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-24 text-xs">@tool.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="@($"width:{tool.Level}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Specialties *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Specialties</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var specialty in _specialties)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@specialty</BadgeCn>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record ProfileInfo(string Name, string Title, string Avatar, string Bio, int Projects, int Brands, int Awards);
    private record ProjectItem(string Id, string Title, string Client, string Category, int Views, int Likes);
    private record ToolItem(string Name, int Level);

    private static readonly ProfileInfo _profile = new(
        "Maya Johansson",
        "Senior Graphic Designer",
        "",
        "Brand identity and visual systems designer with 11 years of experience. Creating memorable visual languages for startups and Fortune 500 companies alike.",
        280, 45, 12
    );

    private static readonly ProjectItem[] _featuredProjects =
    [
        new("p1", "Visual Identity System", "Arc Browser", "Brand Identity", 14200, 890),
        new("p2", "Packaging Design Collection", "Blue Bottle Coffee", "Packaging", 11800, 720),
        new("p3", "Event Visual Language", "SXSW 2026", "Event Design", 22400, 1640),
        new("p4", "Mobile App Icon Suite", "Raycast", "Icon Design", 8900, 560),
    ];

    private static readonly ToolItem[] _tools =
    [
        new("Illustrator", 95),
        new("Photoshop", 92),
        new("Figma", 88),
        new("InDesign", 85),
        new("After Effects", 70),
    ];

    private static readonly string[] _specialties =
    [
        "Brand Identity",
        "Typography",
        "Packaging",
        "Print Design",
        "Icon Systems",
        "Motion Graphics",
    ];

    private static string FormatCount(int n) =>
        n >= 1000 ? $"{(n / 1000.0):F1}k" : n.ToString();
}
