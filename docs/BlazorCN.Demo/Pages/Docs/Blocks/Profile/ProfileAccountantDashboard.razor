@* ============================================================
   Block: profile-accountant-dashboard
   Title: ProfileAccountantDashboard
   Description: React accountant profile block for Next.js with client portfolio summary, revenue metrics, tax deadline tracker, and certification badges using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-accountant-dashboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="Margaret Chen" />
                <AvatarFallbackCn>MC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Margaret Chen</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Chen &amp; Associates</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Certified Public Accountant</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">15+ years specializing in small business accounting, tax planning, and financial advisory. Licensed CPA in California and New York.</p>
            </div>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">84</span>
                <span class="text-muted-foreground">clients</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="dollar-sign" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">$12.4M</span>
                <span class="text-muted-foreground">managed</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="file-text" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">312</span>
                <span class="text-muted-foreground">filings</span>
            </span>
        </div>

        @* Certifications *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Certifications</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var cert in _certifications)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                        <LucideIconCn Name="badge-check" Size="12" Class="size-3" />
                        @cert
                    </BadgeCn>
                }
            </div>
        </div>

        @* Service Breakdown *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Service Breakdown</span>
            <div class="space-y-2">
                @foreach (var spec in _specializations)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-28 text-xs">@spec.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="@($"width:{spec.Percentage}%")"></div>
                        </div>
                        <span class="w-8 text-right font-mono text-muted-foreground text-xs tabular-nums">@(spec.Percentage)%</span>
                    </div>
                }
            </div>
        </div>

        @* Upcoming Deadlines *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Upcoming Deadlines</span>
            </div>
            @for (var i = 0; i < _deadlines.Length; i++)
            {
                var deadline = _deadlines[i];
                var isLast = i == _deadlines.Length - 1;
                var isExpanded = _expanded == deadline.Id;
                var statusCss = _statusDot[deadline.Status];
                <button type="button" @onclick="@(() => ToggleExpanded(deadline.Id))"
                    class="@(Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-1.5 shrink-0 rounded-full", statusCss))"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@deadline.Client</span>
                        <p class="mt-0.5 text-muted-foreground text-xs">@deadline.Type</p>
                        @if (isExpanded)
                        {
                            <div class="mt-2 flex items-center gap-1.5 text-muted-foreground text-xs">
                                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                Due: @deadline.Due
                            </div>
                        }
                    </div>
                    <LucideIconCn Name="chevron-right" Size="16" Class="@(Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : ""))" />
                </button>
            }
        </div>

    </div>
</section>

@code {
    private record Specialization(string Name, int Percentage);
    private record DeadlineItem(string Id, string Client, string Type, string Due, string Status);

    private string? _expanded = null;

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }

    private static readonly string[] _certifications = ["CPA", "CMA", "CFE", "QuickBooks ProAdvisor"];

    private static readonly Specialization[] _specializations = [
        new("Tax Planning", 40),
        new("Bookkeeping", 25),
        new("Audit & Assurance", 20),
        new("Advisory", 15),
    ];

    private static readonly DeadlineItem[] _deadlines = [
        new("d1", "Apex Technologies", "Q1 Corporate Tax", "Apr 15, 2026", "on-track"),
        new("d2", "River Wellness", "Annual Audit", "Apr 18, 2026", "on-track"),
        new("d3", "Mason Construction", "Payroll Filing", "Apr 10, 2026", "at-risk"),
        new("d4", "Bloom Cafe", "Sales Tax Return", "Mar 31, 2026", "overdue"),
    ];

    private readonly Dictionary<string, string> _statusDot = new()
    {
        ["on-track"] = "bg-emerald-500",
        ["at-risk"] = "bg-amber-500",
        ["overdue"] = "bg-red-500",
    };
}
