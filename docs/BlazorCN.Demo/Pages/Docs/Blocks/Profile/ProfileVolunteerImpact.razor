@* ============================================================
   Block: profile-volunteer-impact
   Title: ProfileVolunteerImpact
   Description: React volunteer impact profile block for Next.js with hours tracker, cause categories, impact metrics, and organization list using shadcn/ui, Tailwind CSS, and framer-motion animations
   Source: original/blocks/profile/profile-volunteer-impact.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Volunteer header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarFallbackCn Class="text-lg">JO</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Jamie Okonkwo</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="heart" Size="12" Class="mr-1 size-3" />
                        Volunteer
                    </BadgeCn>
                </div>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">Passionate about community development and environmental justice. Volunteering since 2019.</p>
                <div class="mt-2 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Portland, OR
                    </span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                        Since 2019
                    </span>
                </div>
            </div>
            <div class="flex shrink-0 items-center gap-2">
                <span class="text-muted-foreground text-xs">Available</span>
                <SwitchCn Checked="@_available" CheckedChanged="@((bool v) => { _available = v; })" aria-label="Available to volunteer" />
            </div>
        </div>

        @* Yearly goal progress *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-xs">
                    <LucideIconCn Name="target" Size="12" Class="size-3 text-muted-foreground" />
                    <span class="font-medium">Yearly goal</span>
                </span>
                <span class="text-muted-foreground text-xs">
                    <span class="font-medium tabular-nums">342</span> / 500 hours
                </span>
            </div>
            <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-emerald-500" style="@($"width:{_progressPct}%")"></div>
            </div>
            <span class="mt-1 block text-right font-mono text-muted-foreground text-xs tabular-nums">@(_progressPct)%</span>
        </div>

        @* Impact metrics *@
        <div class="grid grid-cols-4 border-b">
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Total hours</span>
                <span class="font-semibold text-lg tabular-nums">1,840</span>
            </div>
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">People helped</span>
                <span class="font-semibold text-lg tabular-nums">2,300</span>
            </div>
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Organizations</span>
                <span class="font-semibold text-lg tabular-nums">8</span>
            </div>
            <div class="px-4 py-3">
                <span class="block text-muted-foreground text-xs">Funds raised</span>
                <span class="font-semibold text-lg tabular-nums">$24.5k</span>
            </div>
        </div>

        @* Cause area breakdown *@
        <div class="border-b px-4 py-3">
            <span class="mb-3 flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                Hours by cause
            </span>
            <div class="space-y-2.5">
                @foreach (var cause in _causeAreas)
                {
                    var pct = (int)Math.Round((double)cause.Hours / _maxCauseHours * 100);
                    <div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="flex items-center gap-1.5">
                                <span class="@Cn.Merge("size-1.5 rounded-full", cause.Color)"></span>
                                <span class="font-medium text-sm">@cause.Name</span>
                            </span>
                            <span class="font-mono text-muted-foreground tabular-nums">@(cause.Hours)h</span>
                        </div>
                        <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                            <div class="@Cn.Merge("h-full rounded-full", cause.Color)" style="@($"width:{pct}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Achievements *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                <LucideIconCn Name="award" Size="12" Class="size-3" />
                Achievements
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var ach in _achievements)
                {
                    <BadgeCn Variant="@(ach.Earned ? BadgeVariant.Secondary : BadgeVariant.Outline)" Class="@Cn.Merge("font-normal text-xs", !ach.Earned ? "opacity-40" : "")">
                        @if (ach.Earned)
                        {
                            <LucideIconCn Name="check-circle" Size="12" Class="mr-1 size-3 text-emerald-500" />
                        }
                        @ach.Label
                    </BadgeCn>
                }
            </div>
        </div>

        @* Organizations *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                    Organizations
                </span>
            </div>
            @for (var i = 0; i < _organizations.Length; i++)
            {
                var org = _organizations[i];
                var isLast = i == _organizations.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@org.Name</span>
                            @if (org.Verified)
                            {
                                <LucideIconCn Name="check-circle" Size="12" Class="size-3 text-emerald-500" />
                            }
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span>@org.Role</span>
                            <span>&middot;</span>
                            <span>Since @org.Since</span>
                        </div>
                    </div>
                    <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">@(org.Hours)h</span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record CauseArea(string Name, int Hours, string Color);
    private record Organization(string Name, string Role, string Since, int Hours, bool Verified);
    private record Achievement(string Label, bool Earned);

    private bool _available = true;

    private static readonly int _progressPct = (int)Math.Round(342.0 / 500.0 * 100);

    private static readonly CauseArea[] _causeAreas =
    [
        new("Environmental Cleanup", 128, "bg-emerald-500"),
        new("Food Distribution", 96, "bg-amber-500"),
        new("Youth Mentoring", 72, "bg-blue-500"),
        new("Housing Support", 34, "bg-purple-500"),
        new("Disaster Relief", 12, "bg-red-500"),
    ];

    private static readonly int _maxCauseHours = 128;

    private static readonly Organization[] _organizations =
    [
        new("Portland Community Garden Network", "Team Lead", "2019", 640, true),
        new("Oregon Food Bank", "Regular Volunteer", "2020", 420, true),
        new("Big Brothers Big Sisters", "Mentor", "2021", 380, true),
        new("Habitat for Humanity Portland", "Build Volunteer", "2022", 240, true),
        new("Red Cross Cascades Region", "Disaster Response", "2023", 160, false),
    ];

    private static readonly Achievement[] _achievements =
    [
        new("500 Hour Milestone", true),
        new("1,000 Hour Milestone", true),
        new("Team Lead Certified", true),
        new("5-Year Volunteer", true),
        new("2,000 Hour Milestone", false),
    ];
}
