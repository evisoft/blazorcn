@* ============================================================
   Block: profile-marketing-strategist
   Title: ProfileMarketingStrategist
   Description: React marketing strategist profile block for Next.js with campaign results, channel expertise, ROI metrics, client portfolio, and strategy framework badges using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-marketing-strategist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Olivia Chen" />
                <AvatarFallbackCn Class="text-lg">OC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_strategist.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideTargetCn Size="12" Class="mr-1 size-3" />
                        @_strategist.AvgRoi% avg ROI
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">@_strategist.Title</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideBriefcaseCn Size="12" Class="size-3" />
                        @_strategist.Agency
                    </span>
                    <span>·</span>
                    <span>@_strategist.YearsExperience years</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Hire</ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideMegaphoneCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_strategist.TotalCampaigns</span>
                <span class="text-muted-foreground">campaigns</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideUsersCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_strategist.ClientsServed</span>
                <span class="text-muted-foreground">clients</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideTrendingUpCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_strategist.AvgRoi%</span>
                <span class="text-muted-foreground">avg ROI</span>
            </span>
        </div>

        @* Channel expertise *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Channel Expertise</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var ch in _channels)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@($"size-1.5 rounded-full {ch.Color}")"></span>
                        @ch.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Campaigns *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent Campaigns</span>
            </div>
            @for (var i = 0; i < _campaigns.Length; i++)
            {
                var campaign = _campaigns[i];
                var statusDotClass = campaign.Status == "active" ? "bg-emerald-500" : "bg-muted-foreground";
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", i < _campaigns.Length - 1 ? "border-b" : "")">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@campaign.Name</span>
                                <span class="@($"size-1.5 rounded-full {statusDotClass}")"></span>
                            </div>
                            <span class="text-muted-foreground text-xs">
                                @campaign.Client · @campaign.Channel
                            </span>
                        </div>
                        <span class="flex items-center gap-1 font-medium text-emerald-600 text-xs tabular-nums dark:text-emerald-400">
                            <LucideTrendingUpCn Size="12" Class="size-3" />
                            @campaign.Roi%
                        </span>
                    </div>
                    <div class="mt-2 flex items-center gap-4 text-muted-foreground text-xs">
                        <span>
                            Spend: <span class="font-medium text-foreground tabular-nums">@FormatCurrency(campaign.Spend)</span>
                        </span>
                        <span>
                            Revenue: <span class="font-medium text-foreground tabular-nums">@FormatCurrency(campaign.Revenue)</span>
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Frameworks *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Strategy Frameworks</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var framework in _frameworks)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@framework</BadgeCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Strategist(string Name, string Title, string Agency, string Location, int YearsExperience, int TotalCampaigns, int AvgRoi, int ClientsServed);
    private record Channel(string Name, string Color);
    private record Campaign(string Id, string Name, string Client, string Channel, int Spend, int Revenue, int Roi, string Status);

    private static readonly Strategist _strategist = new(
        "Olivia Chen",
        "Senior Marketing Strategist",
        "Growth Engine Co.",
        "Austin, TX",
        9,
        142,
        340,
        56
    );

    private static readonly Channel[] _channels =
    [
        new("Paid Search", "bg-blue-500"),
        new("Social Ads", "bg-pink-500"),
        new("Email Marketing", "bg-amber-500"),
        new("Content Marketing", "bg-emerald-500"),
        new("SEO", "bg-purple-500"),
    ];

    private static readonly Campaign[] _campaigns =
    [
        new("c1", "Q1 Brand Awareness Push", "Fintech Startup", "Social Ads", 45000, 198000, 340, "completed"),
        new("c2", "Product Launch Campaign", "SaaS Platform", "Paid Search", 82000, 412000, 402, "active"),
        new("c3", "Retention Email Series", "E-commerce Brand", "Email Marketing", 12000, 67000, 458, "completed"),
        new("c4", "SEO Content Overhaul", "Healthcare App", "Content Marketing", 28000, 95000, 239, "active"),
    ];

    private static readonly string[] _frameworks =
    [
        "Growth Loops",
        "AARRR Pirate Metrics",
        "Jobs To Be Done",
        "Hook Model",
        "Blue Ocean Strategy",
    ];

    private static string FormatCurrency(int n)
    {
        if (n >= 1_000_000) return $"${(n / 1_000_000.0):F1}M";
        if (n >= 1_000) return $"${(n / 1_000)}K";
        return $"${n}";
    }
}
