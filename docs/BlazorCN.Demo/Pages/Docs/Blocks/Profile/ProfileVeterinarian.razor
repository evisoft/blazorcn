@* ============================================================
   Block: profile-veterinarian
   Title: ProfileVeterinarian
   Description: React veterinarian profile block for Next.js with medical specializations, species expertise, clinic affiliation, patient satisfaction ratings, and emergency availability using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-veterinarian.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Dr. Lisa Chen, DVM" />
                <AvatarFallbackCn Class="text-lg">LC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Dr. Lisa Chen, DVM</span>
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-blue-500" />
                </div>
                <span class="text-muted-foreground text-xs">Veterinarian — Internal Medicine</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="heart" Size="12" Class="size-3" />
                        Harmony Animal Hospital
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Boulder, CO
                    </span>
                </div>
                <div class="mt-0.5 flex items-center gap-3 text-xs">
                    <span class="text-muted-foreground">15 years</span>
                    <span class="text-muted-foreground">·</span>
                    <span class="flex items-center gap-1 text-red-600 dark:text-red-400">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        Emergency Available
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                <LucideIconCn Name="phone" Size="12" Class="mr-1 size-3" />
                Call
            </ButtonCn>
        </div>

        @* Rating *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">4.9</span>
                    <span class="text-muted-foreground text-xs">/5</span>
                </div>
                <div class="flex items-center gap-0.5">
                    @for (var i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <LucideIconCn Name="star" Size="14" Class="@(Cn.Merge("size-3.5", idx < 5 ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30"))" />
                    }
                </div>
                <span class="text-muted-foreground text-xs">(412 reviews)</span>
            </div>
            <div class="mt-2 grid grid-cols-2 gap-2">
                @foreach (var item in _ratingBreakdown)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@item.Label</span>
                        <span class="font-medium tabular-nums">@item.Score</span>
                    </div>
                }
            </div>
        </div>

        @* Species Expertise *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Species Expertise
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var sp in _species)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@(Cn.Merge("size-1.5 rounded-full", sp.Color))"></span>
                        @sp.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Board Certifications *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Board Certifications
            </span>
            <div class="space-y-2">
                @foreach (var spec in _specializations)
                {
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="shield-check" Size="16" Class="size-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@spec.Name</span>
                            <span class="ml-2 text-muted-foreground text-xs">@spec.Board, @spec.Year</span>
                        </div>
                        @if (spec.Verified)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 gap-1 px-1.5 font-normal text-[10px]">
                                <LucideIconCn Name="check-circle-2" Size="10" Class="size-2.5" />
                                Verified
                            </BadgeCn>
                        }
                    </div>
                }
            </div>
        </div>

        @* Services *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Services</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var svc in _services)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@svc</BadgeCn>
                }
            </div>
        </div>

        @* Hours + Insurance *@
        <div class="flex gap-0 divide-x">
            <div class="flex-1 px-4 py-3">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">Hours</span>
                <div class="space-y-1">
                    @foreach (var h in _hours)
                    {
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">@h.Day</span>
                            <span class="font-medium">@h.Time</span>
                        </div>
                    }
                </div>
            </div>
            <div class="flex-1 px-4 py-3">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">
                    Pet Insurance
                </span>
                <div class="flex flex-wrap gap-1">
                    @foreach (var ins in _insurance)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@ins</BadgeCn>
                    }
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record SpeciesItem(string Name, string Color);
    private record SpecItem(string Name, string Board, string Year, bool Verified);
    private record RatingItem(string Label, double Score);
    private record HourItem(string Day, string Time);

    private static readonly RatingItem[] _ratingBreakdown = [
        new("Bedside manner", 4.9),
        new("Medical knowledge", 5.0),
        new("Communication", 4.8),
        new("Wait time", 4.5),
    ];

    private static readonly SpeciesItem[] _species = [
        new("Dogs", "bg-amber-500"),
        new("Cats", "bg-purple-500"),
        new("Rabbits", "bg-pink-500"),
        new("Birds", "bg-blue-500"),
        new("Reptiles", "bg-emerald-500"),
        new("Small Mammals", "bg-cyan-500"),
    ];

    private static readonly SpecItem[] _specializations = [
        new("Internal Medicine", "ACVIM", "2014", true),
        new("Cardiology", "ACVIM", "2016", true),
        new("Oncology", "ACVIM", "2018", true),
    ];

    private static readonly string[] _services = [
        "Wellness Exams",
        "Dental Care",
        "Surgery",
        "Diagnostic Imaging",
        "Laboratory",
        "Vaccinations",
        "Microchipping",
        "Nutrition Counseling",
    ];

    private static readonly HourItem[] _hours = [
        new("Mon-Fri", "8:00 AM - 6:00 PM"),
        new("Saturday", "9:00 AM - 3:00 PM"),
        new("Sunday", "Emergency Only"),
    ];

    private static readonly string[] _insurance = [
        "Trupanion",
        "Petplan",
        "Nationwide",
        "ASPCA",
        "Embrace",
        "Figo",
    ];
}
