@* ============================================================
   Block: profile-radio-host
   Title: ProfileRadioHost
   Description: React radio host profile block for Next.js with show schedule, listener metrics, guest history, genre tags, and broadcast station affiliation using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-radio-host.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarFallbackCn Class="text-lg">MC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">DJ Marcus Cole</span>
                    <span class="flex items-center gap-1 text-emerald-600 text-xs dark:text-emerald-400">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        On Air
                    </span>
                </div>
                <span class="text-muted-foreground text-xs">Morning Drive Host</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="radio" Size="12" Class="size-3" />
                        WKRP 98.5 FM
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Atlanta, GA
                    </span>
                </div>
                <div class="mt-0.5 flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="headphones" Size="12" Class="size-3" />
                    <span class="font-medium text-foreground">The Morning Frequency</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                <LucideIconCn Name="mic" Size="12" Class="mr-1 size-3" />
                Listen
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="grid grid-cols-4 border-b">
            @foreach (var m in _metrics)
            {
                <div class="px-3 py-3 text-center">
                    <span class="block font-semibold text-sm tabular-nums">@m.Value</span>
                    <span class="text-muted-foreground text-xs">@m.Label</span>
                </div>
            }
        </div>

        @* Genres *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Genres &amp; Topics
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var g in _genres)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", g.Color)"></span>
                        @g.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Schedule *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Weekly Schedule</span>
            </div>
            @for (var i = 0; i < _schedule.Length; i++)
            {
                var slot = _schedule[i];
                var isLast = i == _schedule.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2", isLast ? "" : "border-b")">
                    <span class="w-20 font-medium text-xs">@slot.Day</span>
                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                        @slot.Time
                    </span>
                    <span class="ml-auto text-muted-foreground text-xs">@slot.Show</span>
                </div>
            }
        </div>

        @* Recent guests *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent Guests</span>
            </div>
            @for (var i = 0; i < _recentGuests.Length; i++)
            {
                var guest = _recentGuests[i];
                var isLast = i == _recentGuests.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@guest.Name</span>
                                <span class="text-muted-foreground text-xs">@guest.Title</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@guest.Topic</p>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">@guest.Date</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Genre(string Name, string Color);
    private record ShowSlot(string Day, string Time, string Show, bool Live);
    private record GuestAppearance(string Name, string Title, string Date, string Topic);
    private record Metric(string Label, string Value);

    private static readonly Genre[] _genres =
    [
        new("Hip-Hop", "bg-purple-500"),
        new("R&B", "bg-pink-500"),
        new("Neo-Soul", "bg-amber-500"),
        new("Jazz", "bg-blue-500"),
        new("Interviews", "bg-emerald-500"),
    ];

    private static readonly ShowSlot[] _schedule =
    [
        new("Monday", "6:00 AM - 10:00 AM", "The Morning Frequency", true),
        new("Tuesday", "6:00 AM - 10:00 AM", "The Morning Frequency", true),
        new("Wednesday", "6:00 AM - 10:00 AM", "The Morning Frequency", true),
        new("Thursday", "6:00 AM - 10:00 AM", "The Morning Frequency", true),
        new("Friday", "6:00 AM - 10:00 AM", "The Morning Frequency", true),
        new("Saturday", "10:00 AM - 12:00 PM", "Weekend Vibes", true),
    ];

    private static readonly GuestAppearance[] _recentGuests =
    [
        new("Kendrick Lamar", "Artist", "Mar 12", "New album & creative process"),
        new("Mayor Andre Dickens", "Mayor of Atlanta", "Mar 5", "City infrastructure plans"),
        new("Issa Rae", "Producer/Actress", "Feb 28", "New HBO series premiere"),
        new("Tyler Perry", "Studio Founder", "Feb 20", "Film industry in Atlanta"),
    ];

    private static readonly Metric[] _metrics =
    [
        new("Weekly listeners", "184K"),
        new("Total episodes", "2,840"),
        new("Years on air", "12"),
        new("Market rank", "#3"),
    ];
}
