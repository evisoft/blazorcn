@* ============================================================
   Block: profile-personal-trainer
   Title: ProfilePersonalTrainer
   Description: React personal trainer profile block for Next.js with client transformation results, training methodology, certification badges, session availability, and specialty tags using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-personal-trainer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Jake Torres" />
                <AvatarFallbackCn Class="text-lg">JT</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Jake Torres</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="star" Size="12" Class="mr-1 size-3 fill-amber-500 text-amber-500" />
                        4.9
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Certified Personal Trainer &amp; Strength Coach</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="dumbbell" Size="12" Class="size-3" />
                        Iron Athletics
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Miami, FL
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Book</ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">24</span>
                <span class="text-muted-foreground">active</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">380</span>
                <span class="text-muted-foreground">total clients</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="flame" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">8</span>
                <span class="text-muted-foreground">years</span>
            </span>
        </div>

        @* Specialties *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Specialties</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var spec in _specialties)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@($"size-1.5 rounded-full {spec.Color}")"></span>
                        @spec.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Client Results *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Client Results</span>
            </div>
            @for (var i = 0; i < _clientResults.Length; i++)
            {
                var result = _clientResults[i];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", i < _clientResults.Length - 1 ? "border-b" : "")">
                    <span class="w-16 font-medium text-xs">@result.Name</span>
                    <span class="text-muted-foreground text-xs">@result.Metric</span>
                    <span class="font-mono text-muted-foreground text-xs tabular-nums">@result.Before</span>
                    <span class="text-muted-foreground text-xs">&#8594;</span>
                    <span class="font-mono text-xs tabular-nums">@result.After</span>
                    <span class="ml-auto flex items-center gap-0.5 font-medium text-emerald-600 text-xs dark:text-emerald-400">
                        <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                        @result.Improvement
                    </span>
                </div>
            }
        </div>

        @* Session Types *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Session Types</span>
            </div>
            @for (var i = 0; i < _sessionTypes.Length; i++)
            {
                var session = _sessionTypes[i];
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", i < _sessionTypes.Length - 1 ? "border-b" : "")">
                    <div>
                        <span class="font-medium text-sm">@session.Name</span>
                        <span class="ml-2 text-muted-foreground text-xs">@session.Duration</span>
                    </div>
                    <span class="font-medium text-sm tabular-nums">@session.Price</span>
                </div>
            }
        </div>

        @* Availability + Certifications *@
        <div class="flex gap-0 divide-x">
            <div class="flex-1 px-4 py-3">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">Availability</span>
                <div class="space-y-1">
                    @foreach (var avail in _availability)
                    {
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">@avail.Day</span>
                            <span class="font-medium">@avail.Hours</span>
                        </div>
                    }
                </div>
            </div>
            <div class="flex-1 px-4 py-3">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">Certifications</span>
                <div class="space-y-1.5">
                    @foreach (var cert in _certifications)
                    {
                        <div class="flex items-center gap-1.5 text-xs">
                            <LucideIconCn Name="award" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                            <span class="truncate">@cert</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Specialty(string Name, string Color);
    private record ClientResult(string Name, string Duration, string Metric, string Before, string After, string Improvement);
    private record SessionType(string Name, string Duration, string Price);
    private record AvailabilitySlot(string Day, string Hours);

    private static readonly Specialty[] _specialties = [
        new("Strength Training", "bg-red-500"),
        new("Fat Loss", "bg-amber-500"),
        new("Sports Performance", "bg-blue-500"),
        new("Injury Rehab", "bg-purple-500"),
        new("Bodybuilding", "bg-pink-500"),
    ];

    private static readonly ClientResult[] _clientResults = [
        new("Alex M.", "16 weeks", "Body fat", "28%", "18%", "-10%"),
        new("Sarah K.", "12 weeks", "Deadlift", "135 lbs", "225 lbs", "+67%"),
        new("Chris W.", "20 weeks", "Weight", "245 lbs", "198 lbs", "-47 lbs"),
        new("Nina P.", "8 weeks", "5K time", "32:15", "26:40", "-5:35"),
    ];

    private static readonly SessionType[] _sessionTypes = [
        new("1-on-1 Training", "60 min", "$95"),
        new("Partner Session", "60 min", "$140"),
        new("Online Coaching", "Monthly", "$200/mo"),
    ];

    private static readonly AvailabilitySlot[] _availability = [
        new("Mon-Fri", "6:00 AM - 8:00 PM"),
        new("Saturday", "8:00 AM - 2:00 PM"),
        new("Sunday", "Closed"),
    ];

    private static readonly string[] _certifications = [
        "NASM Certified Personal Trainer",
        "CSCS (Strength & Conditioning)",
        "Precision Nutrition Level 1",
        "FMS Level 2 Movement Specialist",
    ];
}
