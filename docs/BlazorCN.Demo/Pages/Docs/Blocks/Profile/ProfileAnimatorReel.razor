@* ============================================================
   Block: profile-animator-reel
   Title: ProfileAnimatorReel
   Description: React animator profile block for Next.js with demo reel showcase, project cards, software proficiency bars, and client list using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-animator-reel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarFallbackCn>YT</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Yuki Tanaka</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Pixelforge Studios</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Senior 3D Animator</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                    10 years crafting character animations for film and games. Specializing in stylized 3D, motion capture cleanup, and creature animation.
                </p>
            </div>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="film" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">47</span>
                <span class="text-muted-foreground">projects</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="star" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">5</span>
                <span class="text-muted-foreground">awards</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">10</span>
                <span class="text-muted-foreground">years</span>
            </span>
        </div>

        @* Demo Reel *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Demo Reel</span>
            </div>
            @for (var i = 0; i < _projects.Length; i++)
            {
                var project = _projects[i];
                var isLast = i == _projects.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex size-9 shrink-0 items-center justify-center rounded-md bg-muted">
                        <LucideIconCn Name="play" Size="14" Class="size-3.5 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@project.Title</span>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span>@project.Client</span>
                            <span>&middot;</span>
                            <span>@project.Type</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 text-muted-foreground text-xs">
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                            @project.Duration
                        </span>
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="frame" Size="12" Class="size-3" />
                            @project.Frames
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Software *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Software</span>
            <div class="space-y-2">
                @foreach (var sw in _software)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-24 text-xs">@sw.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="@($"width:{sw.Level}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Specializations *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Specializations</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var style in _styles)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@style</BadgeCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ProjectItem(string Id, string Title, string Client, string Type, string Duration, string Frames);
    private record SoftwareItem(string Name, int Level);

    private static readonly ProjectItem[] _projects =
    [
        new("p1", "Stellar Odyssey", "Netflix", "Feature Film", "94 min", "135,360"),
        new("p2", "Neon Ronin", "Sony Interactive", "Video Game", "40+ hrs", "86,400"),
        new("p3", "Ember & Ash", "DreamWorks", "Short Film", "12 min", "17,280"),
        new("p4", "Quantum Break VR", "Meta", "VR Experience", "25 min", "54,000"),
    ];

    private static readonly SoftwareItem[] _software =
    [
        new("Maya", 95),
        new("Blender", 88),
        new("Houdini", 75),
        new("ZBrush", 82),
        new("After Effects", 70),
    ];

    private static readonly string[] _styles =
    [
        "Character Animation",
        "Creature FX",
        "Motion Capture",
        "Stylized 3D",
        "Rigging",
        "VFX",
    ];
}
