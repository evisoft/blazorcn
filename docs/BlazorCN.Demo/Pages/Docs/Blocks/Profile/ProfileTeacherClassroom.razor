@* ============================================================
   Block: profile-teacher-classroom
   Title: ProfileTeacherClassroom
   Description: React teacher classroom profile block for Next.js with class roster summary, subject expertise, student performance metrics, weekly schedule, and parent communication stats using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-teacher-classroom.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="@_teacher.Avatar" Alt="@_teacher.Name" />
                <AvatarFallbackCn Class="text-lg">RT</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_teacher.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="star" Size="12" Class="mr-1 size-3 fill-amber-500 text-amber-500" />
                        @_teacher.Rating
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">@_teacher.Title</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="graduation-cap" Size="12" Class="size-3" />
                        @_teacher.School
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        @_teacher.Location
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Message</ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_teacher.TotalStudents</span>
                <span class="text-muted-foreground">students</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="book-open" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_classes.Length</span>
                <span class="text-muted-foreground">classes</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">@(_teacher.AvgScore)%</span>
                <span class="text-muted-foreground">avg score</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-xs">
                <span class="font-medium tabular-nums">@_teacher.YearsTeaching</span>
                <span class="text-muted-foreground"> years</span>
            </span>
        </div>

        @* Subjects *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Subjects</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var subj in _subjects)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", subj.Color)"></span>
                        @subj.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Class sections *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Class Sections</span>
            </div>
            @for (var i = 0; i < _classes.Length; i++)
            {
                var cls = _classes[i];
                var isLast = i == _classes.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 w-8 justify-center px-0 font-mono text-[10px]">
                        @cls.Period
                    </BadgeCn>
                    <span class="flex-1 font-medium text-sm">@cls.Name</span>
                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                        <LucideIconCn Name="users" Size="12" Class="size-3" />
                        <span class="tabular-nums">@cls.Students</span>
                    </span>
                    <span class="font-medium text-xs tabular-nums">@(cls.AvgGrade)% avg</span>
                </div>
            }
        </div>

        @* Grade distribution *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Grade Distribution</span>
            <div class="flex items-end gap-2">
                @foreach (var item in _gradeDistribution)
                {
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <div class="w-full rounded-sm bg-foreground/20" style="@($"height:{item.Percentage * 1.5}px; min-height:4px")"></div>
                        <span class="font-mono text-muted-foreground text-xs tabular-nums">@(item.Percentage)%</span>
                        <span class="font-medium text-xs">@item.Grade</span>
                    </div>
                }
            </div>
        </div>

        @* Classroom metrics *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Classroom Metrics</span>
            <div class="space-y-2.5">
                @foreach (var m in _metrics)
                {
                    <div>
                        <div class="mb-1 flex items-center justify-between text-xs">
                            <span>@m.Label</span>
                            <span class="font-mono text-muted-foreground tabular-nums">@(m.Value)%</span>
                        </div>
                        <ProgressCn Value="@m.Value" Class="h-1.5" />
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TeacherInfo(string Name, string Avatar, string Title, string School, string Location,
        int YearsTeaching, int TotalStudents, int AvgScore, double Rating);

    private record SubjectItem(string Name, string Color);

    private record ClassSection(string Period, string Name, int Students, int AvgGrade);

    private record GradeItem(string Grade, int Percentage);

    private record MetricItem(string Label, int Value);

    private static readonly TeacherInfo _teacher = new(
        Name: "Ms. Rachel Torres",
        Avatar: "",
        Title: "7th Grade Mathematics Teacher",
        School: "Westlake Middle School",
        Location: "Austin, TX",
        YearsTeaching: 8,
        TotalStudents: 128,
        AvgScore: 86,
        Rating: 4.8
    );

    private static readonly SubjectItem[] _subjects =
    [
        new("Pre-Algebra", "bg-blue-500"),
        new("Geometry", "bg-purple-500"),
        new("Statistics", "bg-emerald-500"),
        new("Problem Solving", "bg-amber-500"),
    ];

    private static readonly ClassSection[] _classes =
    [
        new("1st", "Pre-Algebra", 28, 84),
        new("2nd", "Pre-Algebra", 32, 88),
        new("4th", "Geometry", 26, 82),
        new("5th", "Pre-Algebra", 30, 89),
        new("7th", "Statistics Elective", 12, 91),
    ];

    private static readonly GradeItem[] _gradeDistribution =
    [
        new("A", 32),
        new("B", 38),
        new("C", 22),
        new("D", 6),
        new("F", 2),
    ];

    private static readonly MetricItem[] _metrics =
    [
        new("Assignment completion", 94),
        new("Attendance rate", 97),
        new("Parent conference rate", 88),
        new("Standard mastery", 82),
    ];
}
