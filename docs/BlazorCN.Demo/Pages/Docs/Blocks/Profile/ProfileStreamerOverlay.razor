@* ============================================================
   Block: profile-streamer-overlay
   Title: ProfileStreamerOverlay
   Description: React streamer overlay profile block for Next.js with live status indicator, subscriber goals progress bar, recent donations feed, chat activity stats, and stream schedule using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-streamer-overlay.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <div class="relative">
                <AvatarCn Class="size-14">
                    <AvatarImageCn Src="" Alt="NightOwlGaming" />
                    <AvatarFallbackCn Class="text-lg">KN</AvatarFallbackCn>
                </AvatarCn>
                @if (_streamer.IsLive)
                {
                    <span class="absolute -top-0.5 -right-0.5 flex size-4 items-center justify-center rounded-full bg-red-500">
                        <span class="animate-ping absolute size-full rounded-full bg-red-400 opacity-75"></span>
                        <span class="relative size-2 rounded-full bg-red-600"></span>
                    </span>
                }
            </div>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_streamer.Name</span>
                    @if (_streamer.IsLive)
                    {
                        <BadgeCn Variant="BadgeVariant.Destructive" Class="h-4 gap-1 px-1.5 font-normal text-[10px]">
                            LIVE
                        </BadgeCn>
                    }
                </div>
                <span class="text-muted-foreground text-xs">@_streamer.DisplayName</span>
                <p class="mt-1 text-muted-foreground text-sm">@_streamer.Bio</p>
                @if (_streamer.IsLive)
                {
                    <div class="mt-1.5 flex items-center gap-2 text-xs">
                        <span class="flex items-center gap-1 text-muted-foreground">
                            <LucideIconCn Name="tv" Size="12" Class="size-3" />
                            @_streamer.CurrentGame
                        </span>
                        <span class="text-muted-foreground">·</span>
                        <span class="flex items-center gap-1 text-red-600 dark:text-red-400">
                            <LucideIconCn Name="users" Size="12" Class="size-3" />
                            @FormatNumber(_streamer.Viewers) watching
                        </span>
                    </div>
                }
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                <LucideIconCn Name="heart" Size="12" Class="mr-1 size-3" />
                Follow
            </ButtonCn>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="heart" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@FormatNumber(_streamer.Followers)</span>
                <span class="text-muted-foreground">followers</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="zap" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@FormatNumber(_streamer.Subscribers)</span>
                <span class="text-muted-foreground">subscribers</span>
            </span>
        </div>

        @* Sub goal *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Sub Goal</span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_subGoal.Current / @_subGoal.Target
                </span>
            </div>
            <div class="h-2 overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-purple-500" style="@($"width:{_goalPct}%")"></div>
            </div>
            <span class="mt-1 block text-right text-muted-foreground text-xs tabular-nums">
                @_goalPct%
            </span>
        </div>

        @* Chat stats *@
        <div class="grid grid-cols-4 border-b">
            <div class="px-3 py-2.5 text-center">
                <span class="block font-semibold tabular-nums">@_chatStats.MessagesPerMin</span>
                <span class="text-muted-foreground text-[10px]">msg/min</span>
            </div>
            <div class="px-3 py-2.5 text-center">
                <span class="block font-semibold tabular-nums">@_chatStats.UniqueChatters</span>
                <span class="text-muted-foreground text-[10px]">chatters</span>
            </div>
            <div class="px-3 py-2.5 text-center">
                <span class="block font-semibold tabular-nums">@_chatStats.EmoteUsage</span>
                <span class="text-muted-foreground text-[10px]">emotes</span>
            </div>
            <div class="px-3 py-2.5 text-center">
                <span class="block font-semibold tabular-nums">@_chatStats.AvgViewTime</span>
                <span class="text-muted-foreground text-[10px]">avg watch</span>
            </div>
        </div>

        @* Recent donations *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent Support</span>
            </div>
            @for (var i = 0; i < _recentDonations.Length; i++)
            {
                var d = _recentDonations[i];
                var dotColor = _tierDot.TryGetValue(d.Tier, out var tc) ? tc : "bg-muted-foreground";
                <div class="@Cn.Merge("flex items-start gap-3 px-4 py-2.5", i < _recentDonations.Length - 1 ? "border-b" : "")">
                    <span class="@($"mt-1.5 size-1.5 shrink-0 rounded-full {dotColor}")"></span>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@d.User</span>
                            <span class="font-medium text-sm tabular-nums text-emerald-600 dark:text-emerald-400">$@d.Amount</span>
                        </div>
                        @if (!string.IsNullOrEmpty(d.Message))
                        {
                            <p class="mt-0.5 text-muted-foreground text-xs">@d.Message</p>
                        }
                    </div>
                    <span class="shrink-0 text-muted-foreground text-xs">@d.Time</span>
                </div>
            }
        </div>

        @* Schedule *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                    Weekly Schedule
                </span>
            </div>
            @for (var i = 0; i < _schedule.Length; i++)
            {
                var s = _schedule[i];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2", i < _schedule.Length - 1 ? "border-b" : "")">
                    <span class="w-20 font-medium text-sm">@s.Day</span>
                    <span class="font-mono text-muted-foreground text-xs tabular-nums">@s.Time</span>
                    <span class="ml-auto text-muted-foreground text-xs">@s.Game</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StreamerInfo(string Name, string DisplayName, string Bio, bool IsLive, string CurrentGame, int Viewers, int Followers, int Subscribers);
    private record SubGoalInfo(int Current, int Target);
    private record DonationItem(string Id, string User, int Amount, string Message, string Tier, string Time);
    private record ScheduleItem(string Day, string Time, string Game);
    private record ChatStatsInfo(int MessagesPerMin, int UniqueChatters, string EmoteUsage, string AvgViewTime);

    private static readonly StreamerInfo _streamer = new(
        "NightOwlGaming",
        "Kai Nakamura",
        "Variety streamer and speedrunner. Community-first content. Partner since 2022.",
        true,
        "Elden Ring: Nightreign",
        3842,
        128400,
        2847
    );

    private static readonly SubGoalInfo _subGoal = new(2847, 3000);

    private static readonly DonationItem[] _recentDonations = [
        new("d1", "ShadowMage42", 50, "Love the streams, keep it up!", "gold", "12 min ago"),
        new("d2", "PixelQueen", 25, "GG on that boss fight!", "silver", "34 min ago"),
        new("d3", "ByteRunner", 10, "", "bronze", "1 hr ago"),
        new("d4", "CosmicDust99", 100, "You deserve it! Best community on the platform.", "gold", "2 hr ago"),
        new("d5", "NeonWolf", 5, "First time catching a stream live!", "bronze", "3 hr ago"),
    ];

    private static readonly ScheduleItem[] _schedule = [
        new("Monday",    "7:00 PM - 11:00 PM", "Variety"),
        new("Wednesday", "7:00 PM - 11:00 PM", "Speedruns"),
        new("Friday",    "8:00 PM - 12:00 AM", "New Releases"),
        new("Saturday",  "2:00 PM - 6:00 PM",  "Community Games"),
        new("Sunday",    "4:00 PM - 8:00 PM",  "Chill & Chat"),
    ];

    private static readonly ChatStatsInfo _chatStats = new(47, 892, "68%", "1h 42m");

    private static readonly Dictionary<string, string> _tierDot = new()
    {
        ["gold"]   = "bg-amber-500",
        ["silver"] = "bg-muted-foreground",
        ["bronze"] = "bg-amber-700",
    };

    private int _goalPct => (int)Math.Round((double)_subGoal.Current / _subGoal.Target * 100);

    private static string FormatNumber(int n)
    {
        if (n >= 1000) return $"{(n / 1000.0):F1}k";
        return n.ToString();
    }
}
