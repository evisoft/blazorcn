@* ============================================================
   Block: profile-system-admin
   Title: ProfileSystemAdmin
   Description: React system administrator profile block for Next.js with infrastructure overview, server status monitoring, uptime metrics, certification badges, and incident response history using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-system-admin.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Kevin O'Brien" />
                <AvatarFallbackCn Class="text-lg">KO</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Kevin O'Brien</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="shield" Size="12" Class="mr-1 size-3" />
                        99.97% uptime
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Senior Systems Administrator</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span>Atlas Cloud Services</span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Dublin, IE
                    </span>
                    <span>·</span>
                    <span>12 years</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Contact
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">840</span>
                <span class="text-muted-foreground text-xs">Servers</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">99.97%</span>
                <span class="text-muted-foreground text-xs">Uptime SLA</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">1.2K</span>
                <span class="text-muted-foreground text-xs">Incidents</span>
            </div>
        </div>

        @* Tech stack *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Technology Stack
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var s in _stack)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", s.Color)"></span>
                        @s.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Server status *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Infrastructure Status</span>
            </div>
            @for (var i = 0; i < _servers.Length; i++)
            {
                var server = _servers[i];
                var isLast = i == _servers.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _statusDot[server.Status])"></span>
                    <LucideIconCn Name="server" Size="14" Class="size-3.5 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="font-mono font-medium text-sm">@server.Name</span>
                        <span class="ml-2 text-muted-foreground text-xs">@server.Role</span>
                    </div>
                    <span class="font-mono text-muted-foreground text-xs tabular-nums">CPU @(server.Cpu)%</span>
                    <span class="font-mono text-muted-foreground text-xs tabular-nums">MEM @(server.Memory)%</span>
                </div>
            }
        </div>

        @* Incidents *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent Incidents</span>
            </div>
            @for (var i = 0; i < _incidents.Length; i++)
            {
                var inc = _incidents[i];
                var isLast = i == _incidents.Length - 1;
                <div class="@Cn.Merge("px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", _severityColor[inc.Severity])"></span>
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                            @inc.Severity
                        </BadgeCn>
                        <span class="font-medium text-sm">@inc.Title</span>
                    </div>
                    <div class="mt-0.5 flex items-center gap-2 pl-3.5 text-muted-foreground text-xs">
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                            Resolved in @inc.Resolution
                        </span>
                        <span>·</span>
                        <span>@inc.Date</span>
                    </div>
                </div>
            }
        </div>

        @* Certifications *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Certifications
            </span>
            <div class="space-y-1.5">
                @foreach (var cert in _certifications)
                {
                    <div class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="award" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        <span>@cert</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record StackItem(string Name, string Color);
    private record ServerItem(string Name, string Role, string Status, int Cpu, int Memory);
    private record IncidentItem(string Id, string Title, string Severity, string Resolution, string Date);

    private static readonly StackItem[] _stack =
    [
        new("Linux", "bg-amber-500"),
        new("AWS", "bg-orange-500"),
        new("Kubernetes", "bg-blue-500"),
        new("Terraform", "bg-purple-500"),
        new("Ansible", "bg-red-500"),
        new("Docker", "bg-cyan-500"),
        new("PostgreSQL", "bg-blue-600"),
        new("Prometheus", "bg-emerald-500"),
    ];

    private static readonly ServerItem[] _servers =
    [
        new("prod-api-01", "API Gateway", "healthy", 42, 68),
        new("prod-db-01", "Primary DB", "healthy", 58, 82),
        new("prod-worker-03", "Job Queue", "warning", 87, 74),
        new("prod-cache-01", "Redis Cache", "healthy", 22, 45),
        new("prod-search-01", "Elasticsearch", "healthy", 64, 91),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["healthy"] = "bg-emerald-500",
        ["warning"] = "bg-amber-500",
        ["critical"] = "bg-red-500",
    };

    private static readonly IncidentItem[] _incidents =
    [
        new("inc1", "Database connection pool exhaustion", "P1", "14 min", "Mar 18"),
        new("inc2", "CDN cache invalidation failure", "P2", "28 min", "Mar 12"),
        new("inc3", "Worker node OOM crash", "P2", "8 min", "Mar 5"),
        new("inc4", "SSL certificate expiration alert", "P3", "4 min", "Feb 28"),
    ];

    private static readonly Dictionary<string, string> _severityColor = new()
    {
        ["P1"] = "bg-red-500",
        ["P2"] = "bg-amber-500",
        ["P3"] = "bg-blue-500",
    };

    private static readonly string[] _certifications =
    [
        "AWS Solutions Architect Professional",
        "CKA (Certified Kubernetes Admin)",
        "Red Hat Certified Engineer",
        "HashiCorp Terraform Associate",
    ];
}
