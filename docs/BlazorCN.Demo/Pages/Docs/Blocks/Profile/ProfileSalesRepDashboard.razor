@* ============================================================
   Block: profile-sales-rep-dashboard
   Title: ProfileSalesRepDashboard
   Description: React sales representative dashboard profile block for Next.js with quota attainment gauge, deal pipeline, win rate trends, recent activity log, and commission tracker using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-sales-rep-dashboard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Marcus Chen" />
                <AvatarFallbackCn Class="text-lg">MC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Marcus Chen</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Enterprise West</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Account Executive</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">View CRM</ButtonCn>
        </div>

        @* Quota attainment *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Q1 Quota Attainment</span>
                <span class="text-muted-foreground text-xs">@FormatCurrency(412000) / @FormatCurrency(580000)</span>
            </div>
            <div class="mt-2 flex items-baseline gap-1">
                <span class="@(Cn.Merge("font-semibold text-2xl tabular-nums", _attainmentColor))">@(_attainment)%</span>
            </div>
            <ProgressCn Value="@_attainment" Class="mt-2 h-2" />
            <div class="mt-2 flex items-end gap-2">
                @foreach (var m in _quarterlyProgress)
                {
                    var barHeight = (int)Math.Round((m.Closed / 160000.0) * 32);
                    if (barHeight < 4) barHeight = 4;
                    <div class="flex flex-1 flex-col items-center gap-0.5">
                        <div class="w-full rounded-sm bg-foreground/10" style="@($"height:{barHeight}px")"></div>
                        <span class="text-muted-foreground text-xs">@m.Month</span>
                    </div>
                }
            </div>
        </div>

        @* Key metrics row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="target" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">34%</span>
                <span class="text-muted-foreground">win rate</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="dollar-sign" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@FormatCurrency(48000)</span>
                <span class="text-muted-foreground">avg deal</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@FormatCurrency(890000)</span>
                <span class="text-muted-foreground">pipeline</span>
            </span>
        </div>

        @* Tabs *@
        <TabsCn Value="@_activeTab" ValueChanged="@((string v) => _activeTab = v)" Class="w-full">
            <TabsListCn Class="w-full justify-start border-b px-4">
                <TabsTriggerCn Value="pipeline" Class="text-xs">Pipeline</TabsTriggerCn>
                <TabsTriggerCn Value="activity" Class="text-xs">Activity</TabsTriggerCn>
            </TabsListCn>

            <TabsContentCn Value="pipeline" Class="mt-0">
                @for (var i = 0; i < _deals.Length; i++)
                {
                    var deal = _deals[i];
                    var isLast = i == _deals.Length - 1;
                    var stageDot = _stageProbColor.TryGetValue(deal.Stage, out var dotColor) ? dotColor : "bg-muted-foreground";
                    <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                        <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", stageDot))"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@deal.Company</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@deal.Stage</BadgeCn>
                            </div>
                            <span class="text-muted-foreground text-xs">Close by @deal.CloseDate · @(deal.Probability)% probability</span>
                        </div>
                        <span class="shrink-0 font-medium text-sm tabular-nums">@FormatCurrency(deal.Value)</span>
                    </div>
                }
            </TabsContentCn>

            <TabsContentCn Value="activity" Class="mt-0">
                @for (var i = 0; i < _activities.Length; i++)
                {
                    var act = _activities[i];
                    var isLast = i == _activities.Length - 1;
                    var iconName = _activityIcons.TryGetValue(act.Type, out var ico) ? ico : "calendar";
                    var iconColor = _activityColors.TryGetValue(act.Type, out var col) ? col : "text-muted-foreground";
                    <div class="@(Cn.Merge("flex items-start gap-3 px-4 py-3", isLast ? "" : "border-b"))">
                        <LucideIconCn Name="@iconName" Size="14" Class="@(Cn.Merge("mt-0.5 size-3.5 shrink-0", iconColor))" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@act.Description</span>
                            <span class="ml-1.5 text-muted-foreground text-xs">@act.Company</span>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">@act.Time</span>
                    </div>
                }
            </TabsContentCn>
        </TabsCn>

    </div>
</section>

@code {
    private record Deal(string Id, string Company, int Value, string Stage, int Probability, string CloseDate);
    private record Activity(string Id, string Type, string Description, string Company, string Time);
    private record MonthProgress(string Month, int Closed);

    private string _activeTab = "pipeline";

    private static int _attainment = (int)Math.Round((412000.0 / 580000.0) * 100);

    private static string _attainmentColor =>
        _attainment >= 100
            ? "text-emerald-600 dark:text-emerald-400"
            : _attainment >= 50
                ? "text-amber-600 dark:text-amber-400"
                : "text-red-600 dark:text-red-400";

    private static readonly MonthProgress[] _quarterlyProgress = [
        new("Jan", 128000),
        new("Feb", 156000),
        new("Mar", 128000),
    ];

    private static readonly Deal[] _deals = [
        new("1", "Acme Corp",   120000, "Negotiation", 75, "Mar 28"),
        new("2", "TechFlow Inc",  85000, "Proposal",    50, "Apr 5"),
        new("3", "DataSync",      64000, "Discovery",   25, "Apr 20"),
        new("4", "CloudBase",    142000, "Negotiation", 80, "Mar 22"),
        new("5", "Nexus AI",      38000, "Proposal",    40, "Apr 12"),
    ];

    private static readonly Dictionary<string, string> _stageProbColor = new()
    {
        ["Discovery"]   = "bg-blue-500",
        ["Proposal"]    = "bg-amber-500",
        ["Negotiation"] = "bg-emerald-500",
    };

    private static readonly Activity[] _activities = [
        new("1", "closed-won",  "Deal closed",                "Meridian Systems", "1h ago"),
        new("2", "call",        "Discovery call — 28 min",    "DataSync",         "3h ago"),
        new("3", "email",       "Sent proposal follow-up",    "TechFlow Inc",     "4h ago"),
        new("4", "meeting",     "QBR presentation",           "Acme Corp",        "Yesterday"),
        new("5", "closed-lost", "Deal lost to competitor",    "NorthStar Labs",   "Yesterday"),
        new("6", "call",        "Negotiation call — 45 min",  "CloudBase",        "2 days ago"),
    ];

    private static readonly Dictionary<string, string> _activityIcons = new()
    {
        ["call"]        = "phone",
        ["email"]       = "mail",
        ["meeting"]     = "calendar",
        ["closed-won"]  = "check-circle",
        ["closed-lost"] = "x-circle",
    };

    private static readonly Dictionary<string, string> _activityColors = new()
    {
        ["call"]        = "text-blue-600 dark:text-blue-400",
        ["email"]       = "text-muted-foreground",
        ["meeting"]     = "text-purple-600 dark:text-purple-400",
        ["closed-won"]  = "text-emerald-600 dark:text-emerald-400",
        ["closed-lost"] = "text-red-600 dark:text-red-400",
    };

    private static string FormatCurrency(int n)
    {
        if (n >= 1_000_000) return $"${(n / 1_000_000.0):0.#}M";
        if (n >= 1_000)     return $"${(n / 1_000):0}k";
        return $"${n}";
    }
}
