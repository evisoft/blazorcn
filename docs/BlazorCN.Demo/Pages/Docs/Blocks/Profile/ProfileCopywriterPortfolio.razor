@* ============================================================
   Block: profile-copywriter-portfolio
   Title: ProfileCopywriterPortfolio
   Description: React copywriter profile block for Next.js with writing samples, industry expertise, conversion metrics, and client testimonials using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-copywriter-portfolio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="Claire Dubois" />
                <AvatarFallbackCn>CD</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Claire Dubois</span>
                <p class="text-muted-foreground text-xs">Senior Copywriter &amp; Content Strategist</p>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">Conversion-focused copywriter with 9 years of experience in SaaS, fintech, and DTC. My copy has generated $14M+ in attributed revenue for clients.</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Hire Me</ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="pen-tool" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">420</span>
                <span class="text-muted-foreground">projects</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">58</span>
                <span class="text-muted-foreground">clients</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                <span class="font-medium tabular-nums">+34%</span>
                <span class="text-muted-foreground">avg lift</span>
            </span>
        </div>

        @* Content Types *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Content Types</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var ctype in _contentTypes)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@ctype</BadgeCn>
                }
            </div>
        </div>

        @* Writing Samples *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Writing Samples</span>
            </div>
            @for (var i = 0; i < _samples.Length; i++)
            {
                var sample = _samples[i];
                <div class="@(i < _samples.Length - 1 ? "border-b" : "")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => ToggleSample(sample.Id))">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@sample.Title</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@sample.Type</BadgeCn>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@sample.Client</span>
                                <span>·</span>
                                <span class="text-emerald-600 dark:text-emerald-400">@sample.Result</span>
                            </div>
                        </div>
                    </button>
                    @if (_expandedSample == sample.Id)
                    {
                        <div class="px-4 pb-3">
                            <div class="rounded-md bg-muted/50 p-3">
                                <p class="text-sm leading-relaxed italic">&ldquo;@sample.Excerpt&rdquo;</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Industry Experience *@
        <div class="px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Industry Experience</span>
            <div class="space-y-2">
                @foreach (var ind in _industries)
                {
                    var pct = (int)Math.Round((double)ind.Projects / _industries[0].Projects * 100);
                    <div class="flex items-center gap-3">
                        <span class="w-32 text-xs">@ind.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="@($"width:{pct}%")"></div>
                        </div>
                        <span class="w-6 text-right font-mono text-muted-foreground text-xs tabular-nums">@ind.Projects</span>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record Sample(string Id, string Title, string Client, string Type, string Result, string Excerpt);
    private record Industry(string Name, int Projects);

    private string? _expandedSample = "s1";

    private static readonly string[] _contentTypes =
    [
        "Landing Pages",
        "Email Sequences",
        "Ad Copy",
        "Brand Voice",
        "Blog Posts",
        "Product Copy",
        "Case Studies",
    ];

    private static readonly Sample[] _samples =
    [
        new("s1", "SaaS Landing Page Rewrite", "Notion", "Web Copy", "+42% conversion", "Stop organizing. Start building. Notion adapts to how your team actually works."),
        new("s2", "Email Onboarding Sequence", "Linear", "Email", "+28% activation", "You joined Linear for speed. Here's how to move even faster in your first 5 minutes."),
        new("s3", "Product Launch Campaign", "Stripe", "Campaign", "$2.1M pipeline", "Revenue recognition shouldn't require a spreadsheet army. Introducing Stripe Revenue."),
        new("s4", "Brand Voice Guidelines", "Vercel", "Brand", "Company-wide adoption", "Clear. Precise. Developer-first. Every word earns its place."),
    ];

    private static readonly Industry[] _industries =
    [
        new("SaaS / B2B", 180),
        new("Fintech", 95),
        new("DTC / E-commerce", 72),
        new("Health Tech", 43),
        new("Developer Tools", 30),
    ];

    private void ToggleSample(string id)
    {
        _expandedSample = _expandedSample == id ? null : id;
    }
}
