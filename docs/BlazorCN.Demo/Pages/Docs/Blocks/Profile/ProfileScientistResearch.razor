        new("p2", "CRISPR-based Transcription Factors for Dynamic Gene Regulation",
            "Science", "2024", 518, "Nakamura J, Williams R, Gupta A"),
        new("p3", "Scalable Cell-Free Protein Synthesis Using Engineered Lysates",
            "Cell Systems", "2024", 189, "Park S, Nakamura J, Lee K"),
        new("p4", "Machine Learning for Predicting Gene Circuit Behavior",
            "Nature Methods", "2023", 276, "Chen L, Nakamura J, Torres M, et al."),
    ];

    private static readonly GrantItem[] _grants =
