@* ============================================================
   Block: profile-scientist-research
   Title: ProfileScientistResearch
   Description: React scientist research profile block for Next.js with publication list, citation metrics, h-index display, research field tags, and lab affiliation using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-scientist-research.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="@_scientist.Avatar" Alt="@_scientist.Name" />
                <AvatarFallbackCn Class="text-lg">JN</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">@_scientist.Name</span>
                <div class="text-muted-foreground text-xs">@_scientist.Title</div>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="graduation-cap" Size="12" Class="size-3" />
                        @_scientist.Institution
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        @_scientist.Location
                    </span>
                </div>
                <div class="mt-0.5 flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="flask-conical" Size="12" Class="size-3" />
                    @_scientist.Lab
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Contact
            </ButtonCn>
        </div>

        @* Metrics *@
        <div class="grid grid-cols-4 border-b">
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">@_scientist.HIndex</span>
                <span class="text-muted-foreground text-xs">h-index</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">@((_scientist.Citations / 1000.0).ToString("0.0"))K</span>
                <span class="text-muted-foreground text-xs">Citations</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">@_scientist.Publications</span>
                <span class="text-muted-foreground text-xs">Papers</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">@_scientist.Grants</span>
                <span class="text-muted-foreground text-xs">Grants</span>
            </div>
        </div>

        @* Research fields *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Research Fields
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var f in _fields)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", f.Color)"></span>
                        @f.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Publications *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Selected Publications</span>
            </div>
            @for (var i = 0; i < _papers.Length; i++)
            {
                var paper = _papers[i];
                var isLast = i == _papers.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <span class="font-medium text-sm leading-snug">@paper.Title</span>
                    <div class="mt-0.5 text-muted-foreground text-xs">@paper.Authors</div>
                    <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                        <span class="font-medium text-foreground">@paper.Journal</span>
                        <span>·</span>
                        <span>@paper.Year</span>
                        <span>·</span>
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="quote" Size="12" Class="size-3" />
                            <span class="tabular-nums">@paper.Citations</span>
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Grants *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Active Grants
            </span>
            <div class="space-y-2">
                @foreach (var g in _grants)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="flex items-center justify-between">
                            <span class="font-medium text-sm">@g.Title</span>
                            <span class="font-medium text-sm tabular-nums">@g.Amount</span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span>@g.Agency</span>
                            <span>·</span>
                            <span>@g.Period</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Lab members *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Lab Members</span>
            <div class="flex items-center gap-4">
                @foreach (var m in _labMembers)
                {
                    <span class="flex items-center gap-1.5 text-xs">
                        <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                        <span class="font-medium tabular-nums">@m.Count</span>
                        <span class="text-muted-foreground">@m.Role</span>
                    </span>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ScientistInfo(string Name, string Avatar, string Title, string Institution,
        string Department, string Lab, string Location, int HIndex, int Citations, int Publications, int Grants);

    private record FieldItem(string Name, string Color);

    private record PaperItem(string Id, string Title, string Journal, string Year, int Citations, string Authors);

    private record GrantItem(string Agency, string Title, string Amount, string Period);

    private record LabMember(string Role, int Count);

    private static readonly ScientistInfo _scientist = new(
        "Dr. James Nakamura", "", "Principal Investigator", "MIT",
        "Department of Biology", "Nakamura Lab — Synthetic Biology",
        "Cambridge, MA", 48, 12400, 94, 6
