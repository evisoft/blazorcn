@* ============================================================
   Block: profile-nonprofit-leader
   Title: ProfileNonprofitLeader
   Description: React nonprofit leader profile block for Next.js with fundraising progress bar, impact metrics grid, program list with beneficiary counts, and donor recognition section using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-nonprofit-leader.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarFallbackCn>MG</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_profile.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_profile.Organization</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">@_profile.Title</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">@_profile.Bio</p>
                <div class="mt-2 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="globe" Size="12" Class="size-3" />
                        @_profile.Countries countries
                    </span>
                    <span>&middot;</span>
                    <span>Founded @_profile.Founded</span>
                </div>
            </div>
        </div>

        @* Fundraising campaign *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <span class="font-medium text-sm">@_campaign.Title</span>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Donate
                </ButtonCn>
            </div>
            <div class="mt-2 flex items-center gap-2">
                <ProgressCn Value="@_campaignProgress" Class="h-2 flex-1" aria-label="Progress" />
                <span class="shrink-0 font-medium text-muted-foreground text-xs tabular-nums">
                    @_campaignProgress%
                </span>
            </div>
            <div class="mt-1.5 flex items-center justify-between text-muted-foreground text-xs">
                <span class="tabular-nums">$@((_campaign.Raised / 1000).ToString("0"))K raised</span>
                <span class="tabular-nums">$@((_campaign.Goal / 1000).ToString("0"))K goal</span>
            </div>
        </div>

        @* Impact metrics *@
        <div class="grid grid-cols-3 gap-px border-b bg-border">
            @foreach (var metric in _impactMetrics)
            {
                <div class="bg-card px-4 py-3 text-center">
                    <span class="block font-semibold text-xl tabular-nums">@metric.Value</span>
                    <span class="mt-0.5 block text-muted-foreground text-xs">@metric.Label</span>
                </div>
            }
        </div>

        @* Programs *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Programs</span>
            </div>
            @for (var i = 0; i < _programs.Length; i++)
            {
                var prog = _programs[i];
                var isLast = i == _programs.Length - 1;
                var dotColor = _statusDot.TryGetValue(prog.Status, out var dc) ? dc : "bg-muted-foreground/40";
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", dotColor)"></span>
                                <span class="font-medium text-sm">@prog.Name</span>
                            </div>
                            <p class="mt-0.5 pl-3.5 text-muted-foreground text-xs">@prog.Description</p>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="font-medium text-sm tabular-nums">@prog.Beneficiaries.ToString("N0")</span>
                            <span class="block text-muted-foreground text-xs">beneficiaries</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Top donors *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Top supporters</span>
            </div>
            @for (var i = 0; i < _topDonors.Length; i++)
            {
                var donor = _topDonors[i];
                var isLast = i == _topDonors.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <LucideIconCn Name="heart-handshake" Size="14" Class="size-3.5 text-muted-foreground" />
                    <span class="font-medium text-sm">@donor.Name</span>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@donor.Tier</BadgeCn>
                    <span class="ml-auto font-mono text-muted-foreground text-xs tabular-nums">@donor.Amount</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ProfileData(string Name, string Title, string Organization, string Bio, string Founded, int Countries);
    private record CampaignData(string Title, int Raised, int Goal);
    private record MetricItem(string Label, string Value);
    private record ProgramItem(string Id, string Name, string Description, int Beneficiaries, string Status);
    private record DonorItem(string Name, string Amount, string Tier);

    private static readonly ProfileData _profile = new(
        "Maria Gonzalez",
        "Executive Director",
        "Code for Tomorrow",
        "Leading a global nonprofit bringing tech education to underserved communities. 15 years in social impact. Former program director at Khan Academy.",
        "2018",
        12
    );

    private static readonly CampaignData _campaign = new("2026 Annual Fund", 847000, 1200000);

    private int _campaignProgress => (int)Math.Round((double)_campaign.Raised / _campaign.Goal * 100);

    private static readonly MetricItem[] _impactMetrics =
    [
        new("Students reached", "34,200"),
        new("Programs active", "28"),
        new("Volunteer hours", "156K"),
    ];

    private static readonly ProgramItem[] _programs =
    [
        new("p1", "Code Camp", "12-week intensive coding bootcamp for teens in rural areas", 4200, "active"),
        new("p2", "Teacher Training", "Certifying educators in CS fundamentals and pedagogy", 890, "active"),
        new("p3", "Laptop Initiative", "Refurbished devices distributed to qualifying families", 12400, "active"),
        new("p4", "Women in Tech", "Mentorship and scholarship program for women pursuing STEM", 3100, "active"),
        new("p5", "AI Literacy", "Community workshops on AI safety and practical applications", 1800, "launching"),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["active"] = "bg-emerald-500",
        ["completed"] = "bg-muted-foreground/40",
        ["launching"] = "bg-blue-500",
    };

    private static readonly DonorItem[] _topDonors =
    [
        new("Sarah M.", "$50,000", "Platinum"),
        new("David K.", "$25,000", "Gold"),
        new("Anonymous", "$20,000", "Gold"),
        new("Chen Family Foundation", "$15,000", "Silver"),
    ];
}
