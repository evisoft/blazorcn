@* ============================================================
   Block: profile-music-listener
   Title: ProfileMusicListener
   Description: React music listening profile block for Next.js with currently playing track, animated progress bar, top artists with play counts, and recently played list using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-music-listener.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Profile header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-9">
                <AvatarImageCn Src="" Alt="Kai Nakamura" />
                <AvatarFallbackCn>KN</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Kai Nakamura</span>
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span>@FormatMinutes(48320) listened</span>
                    <span>·</span>
                    <span>Top genre: Indie Rock</span>
                </div>
            </div>
        </div>

        @* Now playing *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500 inline-block"></span>
                <span class="font-medium text-muted-foreground text-xs">Now playing</span>
            </div>

            <div class="flex items-center gap-4">
                @* Album art placeholder *@
                <div class="flex size-14 shrink-0 items-center justify-center rounded-md bg-muted/50">
                    <LucideIconCn Name="music" Size="20" Class="size-5 text-muted-foreground/60" />
                </div>

                <div class="min-w-0 flex-1">
                    <span class="block font-medium text-sm">Dissolve</span>
                    <span class="text-muted-foreground text-xs">
                        Absofacto — Thousand Peaces
                    </span>

                    @* Progress bar *@
                    <div class="mt-2.5 flex items-center gap-2">
                        <span class="font-mono text-muted-foreground text-xs tabular-nums">
                            1:28
                        </span>
                        <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/70" style="width: 38%"></div>
                        </div>
                        <span class="font-mono text-muted-foreground text-xs tabular-nums">
                            3:42
                        </span>
                    </div>
                </div>

                @* Controls *@
                <div class="flex items-center gap-1">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0" @onclick="@(() => _isPlaying = !_isPlaying)">
                        @if (_isPlaying)
                        {
                            <LucideIconCn Name="pause" Size="14" Class="size-3.5" />
                        }
                        else
                        {
                            <LucideIconCn Name="play" Size="14" Class="size-3.5" />
                        }
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                        <LucideIconCn Name="skip-forward" Size="14" Class="size-3.5" />
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0">
                        <LucideIconCn Name="volume-2" Size="14" Class="size-3.5 text-muted-foreground" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Top artists *@
        <div class="border-b">
            <div class="flex items-center justify-between px-4 py-2.5">
                <span class="font-medium text-muted-foreground text-xs">Top artists</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    All time
                </BadgeCn>
            </div>
            @for (var i = 0; i < _topArtists.Length; i++)
            {
                var artist = _topArtists[i];
                var barPct = (int)Math.Round((double)artist.Plays / _maxPlays * 100);
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", i < _topArtists.Length - 1 ? "border-b" : "")">
                    <span class="w-4 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                        @(i + 1)
                    </span>
                    <div class="flex size-8 shrink-0 items-center justify-center rounded bg-muted/50">
                        <LucideIconCn Name="music" Size="14" Class="size-3.5 text-muted-foreground/60" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@artist.Name</span>
                        <span class="ml-2 text-muted-foreground text-xs">@artist.Genre</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="h-1 w-16 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/50" style="@($"width: {barPct}%")"></div>
                        </div>
                        <span class="w-12 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                            @artist.Plays.ToString("N0")
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Recently played *@
        <div>
            <div class="border-b px-4 py-2.5">
                <span class="font-medium text-muted-foreground text-xs">Recently played</span>
            </div>
            @for (var i = 0; i < _recentTracks.Length; i++)
            {
                var track = _recentTracks[i];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", i < _recentTracks.Length - 1 ? "border-b" : "")">
                    <div class="flex size-7 shrink-0 items-center justify-center rounded bg-muted/30">
                        <LucideIconCn Name="music" Size="12" Class="size-3 text-muted-foreground/40" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="text-sm">@track.Title</span>
                        <span class="ml-1.5 text-muted-foreground text-xs">@track.Artist</span>
                    </div>
                    <span class="shrink-0 text-muted-foreground text-xs">@track.PlayedAt</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TopArtist(string Id, string Name, int Plays, string Genre);
    private record RecentTrack(string Id, string Title, string Artist, string PlayedAt);

    private bool _isPlaying = true;

    private static readonly int _maxPlays = 2847;

    private static readonly TopArtist[] _topArtists = [
        new("1", "Radiohead", 2847, "Alt Rock"),
        new("2", "Tame Impala", 2103, "Psychedelic"),
        new("3", "Japanese Breakfast", 1856, "Indie Pop"),
        new("4", "Khruangbin", 1492, "Funk"),
        new("5", "Beach House", 1234, "Dream Pop"),
    ];

    private static readonly RecentTrack[] _recentTracks = [
        new("1", "Motion Sickness", "Phoebe Bridgers", "4 min ago"),
        new("2", "Redbone", "Childish Gambino", "8 min ago"),
        new("3", "Midnight City", "M83", "12 min ago"),
        new("4", "Electric Feel", "MGMT", "16 min ago"),
    ];

    private static string FormatMinutes(int mins)
    {
        var hours = mins / 60;
        if (hours >= 1000) return $"{(hours / 1000.0):F1}k hrs";
        return $"{hours} hrs";
    }
}
