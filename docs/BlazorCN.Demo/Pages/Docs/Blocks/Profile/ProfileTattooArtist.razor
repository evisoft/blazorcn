@* ============================================================
   Block: profile-tattoo-artist
   Title: ProfileTattooArtist
   Description: React tattoo artist profile block for Next.js with style gallery categories, booking rates, artist bio, client reviews, and studio affiliation using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-tattoo-artist.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Sasha Volkov" />
                <AvatarFallbackCn Class="text-lg">SV</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Sasha Volkov</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="star" Size="12" Class="mr-1 size-3 fill-amber-500 text-amber-500" />
                        4.9
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Custom Tattoo Artist</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="pen-tool" Size="12" Class="size-3" />
                        Iron &amp; Ink Collective
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Brooklyn, NY
                    </span>
                </div>
                <div class="mt-0.5 flex items-center gap-3 text-xs">
                    <span class="text-muted-foreground">10 years</span>
                    <span class="text-muted-foreground">·</span>
                    <span class="text-muted-foreground tabular-nums">3,200 pieces</span>
                    <span class="text-muted-foreground">·</span>
                    <span class="flex items-center gap-1 text-amber-600 dark:text-amber-400">
                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                        6-8 weeks wait
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Book</ButtonCn>
        </div>

        @* Style Gallery *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Style Gallery</span>
            <div class="grid grid-cols-3 gap-2">
                @foreach (var style in _styles)
                {
                    <div class="rounded-md bg-muted/50 p-3 text-center transition-colors hover:bg-muted/80">
                        <LucideIconCn Name="palette" Size="20" Class="mx-auto size-5 text-muted-foreground" />
                        <span class="mt-1.5 block font-medium text-xs">@style.Name</span>
                        <span class="text-muted-foreground text-xs tabular-nums">@style.Pieces pieces</span>
                    </div>
                }
            </div>
        </div>

        @* Rates *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Pricing</span>
            </div>
            @for (var i = 0; i < _rates.Length; i++)
            {
                var rate = _rates[i];
                var isLast = i == _rates.Length - 1;
                <div class="@(Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b"))">
                    <span class="font-medium text-sm">@rate.Service</span>
                    <span class="font-medium text-sm tabular-nums">@rate.Price</span>
                </div>
            }
        </div>

        @* Reviews *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Client Reviews (286)</span>
            <div class="space-y-2">
                @foreach (var rev in _reviews)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-sm leading-relaxed">@("\"")@rev.Text@("\"")</p>
                        <div class="mt-2 flex items-center gap-1 text-muted-foreground text-xs">
                            <span class="font-medium text-foreground">@rev.Name</span>
                            <span>·</span>
                            <div class="flex items-center gap-0.5">
                                @for (var j = 0; j < rev.Rating; j++)
                                {
                                    <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-amber-500 text-amber-500" />
                                }
                            </div>
                            <span>·</span>
                            <span>@rev.Date</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Availability *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Studio Hours</span>
            <div class="space-y-1">
                @foreach (var avail in _availability)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@avail.Day</span>
                        <span class="font-medium">@avail.Hours</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record StyleItem(string Name, string Color, int Pieces);
    private record RateItem(string Service, string Price);
    private record ReviewItem(string Name, int Rating, string Date, string Text);
    private record AvailabilityItem(string Day, string Hours);

    private static readonly StyleItem[] _styles =
    [
        new("Blackwork", "bg-foreground", 840),
        new("Fine Line", "bg-zinc-400", 620),
        new("Neo-Traditional", "bg-red-500", 480),
        new("Geometric", "bg-blue-500", 540),
        new("Realism", "bg-purple-500", 380),
        new("Japanese", "bg-amber-500", 340),
    ];

    private static readonly RateItem[] _rates =
    [
        new("Hourly Rate", "$200/hr"),
        new("Minimum Charge", "$150"),
        new("Small Piece (2-3 hrs)", "$400 - $600"),
        new("Half Sleeve", "$2,000 - $4,000"),
        new("Full Sleeve", "$5,000 - $8,000"),
    ];

    private static readonly ReviewItem[] _reviews =
    [
        new("Maya L.", 5, "2 weeks ago", "Sasha turned my concept into something better than I imagined. The linework is incredibly precise."),
        new("Derek P.", 5, "1 month ago", "Third piece with Sasha. Consistent quality, professional environment, and genuinely great to work with."),
        new("Lena K.", 5, "2 months ago", "Worth the wait. The blackwork sleeve is a masterpiece. Get on the waitlist now."),
    ];

    private static readonly AvailabilityItem[] _availability =
    [
        new("Tue-Sat", "11:00 AM - 7:00 PM"),
        new("Sun-Mon", "Closed"),
    ];
}
