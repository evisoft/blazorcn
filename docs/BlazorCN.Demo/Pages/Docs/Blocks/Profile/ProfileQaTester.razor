@* ============================================================
   Block: profile-qa-tester
   Title: ProfileQaTester
   Description: React QA tester profile block for Next.js with bug discovery stats, severity breakdown, test coverage metrics, testing tool proficiency, and sprint defect trends using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-qa-tester.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="@_tester.Avatar" Alt="@_tester.Name" />
                <AvatarFallbackCn Class="text-lg">AP</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_tester.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="shield" Size="12" Class="mr-1 size-3" />
                        @_tester.AutomationRate% automated
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">@_tester.Title</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span>@_tester.Company</span>
                    <span>&middot;</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        @_tester.Location
                    </span>
                    <span>&middot;</span>
                    <span>@_tester.YearsExperience years</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Profile
            </ButtonCn>
        </div>

        @* Bug stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="bug" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_tester.BugsFound.ToString("N0")</span>
                <span class="text-muted-foreground">bugs found</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="layers" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_tester.TestsWritten.ToString("N0")</span>
                <span class="text-muted-foreground">tests written</span>
            </span>
        </div>

        @* Severity breakdown *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Bug Severity Breakdown
            </span>
            <div class="space-y-1.5">
                @foreach (var item in _severityBreakdown)
                {
                    var widthPct = (double)item.Count / _tester.BugsFound * 100;
                    <div class="flex items-center gap-3 text-xs">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", item.Color)"></span>
                        <span class="w-16 text-muted-foreground">@item.Severity</span>
                        <div class="flex-1">
                            <div class="@Cn.Merge("h-1.5 rounded-full opacity-40", item.Color)" style="@($"width:{widthPct:F1}%")"></div>
                        </div>
                        <span class="w-10 text-right font-mono tabular-nums">@item.Count</span>
                    </div>
                }
            </div>
        </div>

        @* Sprint defect trend *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">
                Sprint Defect Trend
            </span>
            <div class="flex items-end gap-2">
                @foreach (var sprint in _sprintDefects)
                {
                    var barHeight = (double)sprint.Found / _maxDefects * 60;
                    var heightPx = barHeight < 4 ? 4 : barHeight;
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <div class="w-full rounded-sm bg-foreground/20" style="@($"height:{heightPx:F0}px;min-height:4px")"></div>
                        <span class="text-muted-foreground text-xs">@sprint.Sprint</span>
                    </div>
                }
            </div>
        </div>

        @* Test coverage *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Test Coverage
            </span>
            <div class="space-y-2.5">
                @foreach (var item in _coverage)
                {
                    <div>
                        <div class="mb-1 flex items-center justify-between text-xs">
                            <span>@item.Area</span>
                            <span class="font-mono text-muted-foreground tabular-nums">@item.Percentage%</span>
                        </div>
                        <ProgressCn Value="@item.Percentage" Class="h-1.5" aria-label="Progress" />
                    </div>
                }
            </div>
        </div>

        @* Tools *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Testing Tools
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var tool in _tools)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", tool.Color)"></span>
                        @tool.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Quality metrics *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Quality Metrics
            </span>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var m in _metrics)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@m.Label</span>
                        <span class="font-medium tabular-nums">@m.Value</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record TesterInfo(string Name, string Avatar, string Title, string Company, string Location, int YearsExperience, int BugsFound, int TestsWritten, int AutomationRate);
    private record SeverityItem(string Severity, int Count, string Color);
    private record ToolItem(string Name, string Color);
    private record SprintItem(string Sprint, int Found, int Resolved);
    private record CoverageItem(string Area, int Percentage);
    private record MetricItem(string Label, string Value);

    private static readonly TesterInfo _tester = new("Aisha Patel", "", "Senior QA Engineer", "CloudSync Inc.", "Toronto, ON", 7, 2840, 1420, 78);

    private static readonly SeverityItem[] _severityBreakdown =
    [
        new("Critical", 142, "bg-red-500"),
        new("High", 486, "bg-amber-500"),
        new("Medium", 1240, "bg-yellow-500"),
        new("Low", 972, "bg-blue-500"),
    ];

    private static readonly ToolItem[] _tools =
    [
        new("Cypress", "bg-emerald-500"),
        new("Playwright", "bg-purple-500"),
        new("Selenium", "bg-blue-500"),
        new("Jest", "bg-red-500"),
        new("Postman", "bg-amber-500"),
        new("JMeter", "bg-cyan-500"),
        new("Charles Proxy", "bg-pink-500"),
    ];

    private static readonly SprintItem[] _sprintDefects =
    [
        new("S18", 24, 22),
        new("S19", 18, 18),
        new("S20", 31, 28),
        new("S21", 15, 15),
        new("S22", 22, 20),
        new("S23", 19, 17),
    ];

    private const int _maxDefects = 35;

    private static readonly CoverageItem[] _coverage =
    [
        new("Unit Tests", 92),
        new("Integration Tests", 78),
        new("E2E Tests", 65),
        new("API Tests", 88),
    ];

    private static readonly MetricItem[] _metrics =
    [
        new("Defect escape rate", "2.1%"),
        new("Avg find-to-fix", "1.4 days"),
        new("Regression pass rate", "99.2%"),
        new("Test flake rate", "0.8%"),
    ];
}
