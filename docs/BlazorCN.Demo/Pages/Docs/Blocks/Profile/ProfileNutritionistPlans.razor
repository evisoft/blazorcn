@* ============================================================
   Block: profile-nutritionist-plans
   Title: ProfileNutritionistPlans
   Description: React nutritionist profile block for Next.js with meal plan templates, dietary specializations, client success metrics, certification badges, and consultation booking using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-nutritionist-plans.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Dr. Priya Sharma" />
                <AvatarFallbackCn Class="text-lg">PS</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Dr. Priya Sharma</span>
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-blue-500" />
                </div>
                <span class="text-muted-foreground text-xs">Registered Dietitian Nutritionist</span>
                <div class="mt-0.5 font-mono text-muted-foreground text-xs">
                    RDN, CSSD, LD
                </div>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span>Portland, OR</span>
                    <span>·</span>
                    <span>11 years</span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="users" Size="12" Class="size-3" />
                        820 clients
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Book
            </ButtonCn>
        </div>

        @* Metrics *@
        <div class="grid grid-cols-4 border-b">
            @foreach (var m in _metrics)
            {
                <div class="px-3 py-3 text-center">
                    <span class="block font-semibold text-sm tabular-nums">@m.Value</span>
                    <span class="text-muted-foreground text-xs">@m.Label</span>
                </div>
            }
        </div>

        @* Specializations *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Specializations
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var s in _specializations)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@($"size-1.5 rounded-full {s.Color}")"></span>
                        @s.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Meal Plans *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Meal Plan Templates</span>
            </div>
            @for (var i = 0; i < _mealPlans.Length; i++)
            {
                var plan = _mealPlans[i];
                var isLast = i == _mealPlans.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="utensils" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="font-medium text-sm">@plan.Name</span>
                                <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                    @plan.Calories cal
                                </span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@plan.Description</p>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs tabular-nums">
                            @plan.Clients clients
                        </span>
                    </div>
                    <div class="mt-1.5 flex flex-wrap gap-1">
                        @foreach (var tag in plan.Tags)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                                @tag
                            </BadgeCn>
                        }
                    </div>
                </div>
            }
        </div>

        @* Certifications *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Certifications
            </span>
            <div class="space-y-1.5">
                @foreach (var cert in _certifications)
                {
                    <div class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="award" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        <span>@cert</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Specialization(string Name, string Color);
    private record MealPlan(string Id, string Name, int Calories, string Description, string[] Tags, int Clients);
    private record Metric(string Label, string Value, string Period);

    private static readonly Specialization[] _specializations =
    [
        new("Weight Management", "bg-emerald-500"),
        new("Sports Nutrition", "bg-blue-500"),
        new("Gut Health", "bg-purple-500"),
        new("Plant-Based", "bg-green-500"),
        new("Diabetes Management", "bg-amber-500"),
        new("Eating Disorders", "bg-pink-500"),
    ];

    private static readonly MealPlan[] _mealPlans =
    [
        new("mp1", "Lean & Clean", 1800, "High-protein, moderate-carb plan for sustainable fat loss", ["Weight Loss", "High Protein"], 245),
        new("mp2", "Performance Fuel", 2800, "Athlete-optimized nutrition with periodized carb cycling", ["Sports", "Muscle Gain"], 128),
        new("mp3", "Plant Power", 2000, "Complete plant-based nutrition with B12 and iron optimization", ["Vegan", "Whole Foods"], 96),
        new("mp4", "Gut Reset Protocol", 2200, "Anti-inflammatory foods with prebiotic and probiotic focus", ["Gut Health", "Anti-Inflammatory"], 178),
    ];

    private static readonly Metric[] _metrics =
    [
        new("Avg weight loss", "18 lbs", "12 weeks"),
        new("Plan adherence", "87%", "avg"),
        new("Client retention", "92%", "annual"),
        new("Satisfaction", "4.9/5", "rating"),
    ];

    private static readonly string[] _certifications =
    [
        "Registered Dietitian (RDN)",
        "Sports Dietetics (CSSD)",
        "Certified Diabetes Educator",
        "Precision Nutrition Level 2",
    ];
}
