@* ============================================================
   Block: profile-technical-writer
   Title: ProfileTechnicalWriter
   Description: React technical writer profile block for Next.js with documentation portfolio, content metrics, writing tool proficiency, subject expertise, and client testimonials using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-technical-writer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Emma Richardson" />
                <AvatarFallbackCn Class="text-lg">ER</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Emma Richardson</span>
                <div class="text-muted-foreground text-xs">Senior Technical Writer</div>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="pen-line" Size="12" Class="size-3" />
                        Freelance
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Portland, OR
                    </span>
                    <span>·</span>
                    <span>9 years</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Hire</ButtonCn>
        </div>

        @* Stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">340</span>
                <span class="text-muted-foreground text-xs">Documents</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">@FormatWords(2800000)</span>
                <span class="text-muted-foreground text-xs">Words</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">42</span>
                <span class="text-muted-foreground text-xs">Clients</span>
            </div>
        </div>

        @* Expertise *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Subject Expertise</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var exp in _expertise)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@($"size-1.5 rounded-full {exp.Color}")"></span>
                        @exp.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Projects *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent Documentation</span>
            </div>
            @for (var i = 0; i < _projects.Length; i++)
            {
                var project = _projects[i];
                <div class="@(i < _projects.Length - 1 ? "border-b" : "") px-4 py-3 transition-colors hover:bg-muted/50">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="font-medium text-sm">@project.Title</span>
                                <span class="@($"size-1.5 rounded-full {_statusDot[project.Status]}")"></span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@project.Client</span>
                                <span>·</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">@project.Type</BadgeCn>
                            </div>
                        </div>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">@FormatWords(project.Words) words</span>
                    </div>
                </div>
            }
        </div>

        @* Tools *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Writing Tools</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var tool in _tools)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@tool</BadgeCn>
                }
            </div>
        </div>

        @* Testimonials *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Client Testimonials</span>
            <div class="space-y-2">
                @foreach (var testimonial in _testimonials)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-sm leading-relaxed">@("\"")@testimonial.Text@("\"")</p>
                        <span class="mt-2 block font-medium text-muted-foreground text-xs">@testimonial.Name</span>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record ExpertiseItem(string Name, string Color);
    private record DocProject(string Id, string Title, string Client, string Type, int Words, string Status);
    private record Testimonial(string Name, string Text);

    private static readonly ExpertiseItem[] _expertise =
    [
        new("API Documentation", "bg-blue-500"),
        new("Developer Guides", "bg-purple-500"),
        new("Cloud Infrastructure", "bg-cyan-500"),
        new("SDK References", "bg-emerald-500"),
        new("Release Notes", "bg-amber-500"),
        new("System Architecture", "bg-red-500"),
    ];

    private static readonly string[] _tools =
    [
        "Markdown/MDX",
        "Docusaurus",
        "ReadMe.io",
        "Swagger/OpenAPI",
        "GitBook",
        "Confluence",
        "Vale Linter",
        "Figma",
    ];

    private static readonly DocProject[] _projects =
    [
        new("d1", "REST API Reference v3", "FinTech Startup", "API Docs", 45000, "published"),
        new("d2", "Cloud Migration Guide", "Enterprise SaaS", "User Guide", 32000, "published"),
        new("d3", "SDK Quickstart Tutorials", "Dev Tools Co.", "Tutorial", 18000, "in-review"),
        new("d4", "Infrastructure Runbooks", "Cloud Platform", "Runbook", 24000, "drafting"),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["published"] = "bg-emerald-500",
        ["in-review"] = "bg-amber-500",
        ["drafting"] = "bg-blue-500",
    };

    private static readonly Testimonial[] _testimonials =
    [
        new("CTO, Dev Tools Co.", "Emma transformed our scattered docs into a cohesive developer experience. Onboarding time dropped 40%."),
        new("VP Eng, Cloud Platform", "Clear, concise, and technically accurate. Best documentation investment we've made."),
    ];

    private static string FormatWords(int n)
    {
        if (n >= 1000000) return $"{(n / 1000000.0):F1}M";
        if (n >= 1000) return $"{(n / 1000):F0}K";
        return n.ToString();
    }
}
