@* ============================================================
   Block: profile-editor-publications
   Title: ProfileEditorPublications
   Description: React editor profile block for Next.js with publication credits, editorial expertise, manuscript statistics, and genre specialization using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-editor-publications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header: avatar + bio *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarFallbackCn>HR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Hannah Rourke</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Penguin Random House
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Senior Editor</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                    Acquiring and developmental editor with 14 years in literary fiction, memoir, and narrative nonfiction. Three NYT bestsellers edited.
                </p>
            </div>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="book-open" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">128</span>
                <span class="text-muted-foreground">books</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="star" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">3</span>
                <span class="text-muted-foreground">bestsellers</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="file-text" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">340</span>
                <span class="text-muted-foreground">manuscripts reviewed</span>
            </span>
        </div>

        @* Notable Publications *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Notable Publications</span>
            </div>
            @for (var i = 0; i < _publications.Length; i++)
            {
                var pub = _publications[i];
                var isLast = i == _publications.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    @if (pub.Notable)
                    {
                        <LucideIconCn Name="star" Size="12" Class="size-3 shrink-0 text-amber-500" />
                    }
                    else
                    {
                        <LucideIconCn Name="book-open" Size="12" Class="size-3 shrink-0 text-muted-foreground/40" />
                    }
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@pub.Title</span>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span>@pub.Author</span>
                            <span>&middot;</span>
                            <span>@pub.Role</span>
                        </div>
                    </div>
                    <span class="shrink-0 font-mono text-muted-foreground text-xs">@pub.Year</span>
                </div>
            }
        </div>

        @* Editorial Skills *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">
                Editorial Skills
            </span>
            <div class="space-y-2">
                @foreach (var skill in _expertise)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-36 text-xs">@skill.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="@($"width:{skill.Level}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Genres *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Genres</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var g in _genres)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@g</BadgeCn>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record Publication(string Id, string Title, string Author, string Role, string Year, bool Notable = false);

    private static readonly Publication[] _publications =
    [
        new("p1", "The Quiet Country",           "Maria Chen",   "Acquiring Editor",     "2026", true),
        new("p2", "Letters from Nowhere",         "James Osei",   "Developmental Editor", "2025", true),
        new("p3", "A Thousand Small Repairs",     "Sarah Kim",    "Line Editor",          "2025"),
        new("p4", "The Architect's Garden",       "David Park",   "Acquiring Editor",     "2024", true),
        new("p5", "Mercury in Retrograde",        "Lila Santos",  "Developmental Editor", "2024"),
    ];

    private record Skill(string Name, int Level);

    private static readonly Skill[] _expertise =
    [
        new("Developmental Editing",  95),
        new("Line Editing",           90),
        new("Copyediting",            85),
        new("Manuscript Assessment",  88),
        new("Query Letters",          75),
    ];

    private static readonly string[] _genres =
    [
        "Literary Fiction",
        "Memoir",
        "Narrative Nonfiction",
        "Historical Fiction",
        "Essay Collections",
        "Debut Novels",
    ];
}
