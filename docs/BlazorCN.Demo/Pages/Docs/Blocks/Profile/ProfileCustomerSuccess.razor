@* ============================================================
   Block: profile-customer-success
   Title: ProfileCustomerSuccess
   Description: React customer success manager profile block for Next.js with health score dashboard, account portfolio, NPS trends, renewal pipeline, and risk alerts using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-customer-success.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Nina Johansson" />
                <AvatarFallbackCn Class="text-lg">NJ</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Nina Johansson</span>
                <div class="text-muted-foreground text-xs">Senior CS Manager</div>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">Managing 42 enterprise accounts totaling $8.2M ARR. 97% gross retention rate over the past 4 quarters.</p>
            </div>
        </div>

        @* Key metrics *@
        <div class="grid grid-cols-4 gap-px border-b bg-border">
            @foreach (var metric in _metrics)
            {
                <div class="bg-card px-3 py-3 text-center">
                    <span class="block font-semibold text-sm tabular-nums">@metric.Value</span>
                    <span class="text-muted-foreground text-xs">@metric.Label</span>
                </div>
            }
        </div>

        @* Portfolio health *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Portfolio health</span>
            <div class="mb-2 flex h-2 overflow-hidden rounded-full">
                <div class="bg-emerald-500" style="@(FormattableString.Invariant($"width:{(_healthyCt * 100 / 42.0):F1}%"))"></div>
                <div class="bg-amber-500" style="@(FormattableString.Invariant($"width:{(_monitorCt * 100 / 42.0):F1}%"))"></div>
                <div class="bg-red-500" style="@(FormattableString.Invariant($"width:{(_atRiskCt * 100 / 42.0):F1}%"))"></div>
            </div>
            <div class="flex items-center gap-4 text-xs">
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-medium tabular-nums">@_healthyCt</span>
                    <span class="text-muted-foreground">healthy</span>
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    <span class="font-medium tabular-nums">@_monitorCt</span>
                    <span class="text-muted-foreground">monitor</span>
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span class="font-medium tabular-nums">@_atRiskCt</span>
                    <span class="text-muted-foreground">at-risk</span>
                </span>
            </div>
        </div>

        @* NPS trend *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">NPS trend</span>
            <div class="flex items-end gap-2">
                @foreach (var item in _npsHistory)
                {
                    var barHeight = (int)Math.Round(item.Score / 80.0 * 40);
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <div class="w-full rounded-sm bg-foreground/15" style="@($"height:{(barHeight < 4 ? 4 : barHeight)}px")"></div>
                        <span class="text-muted-foreground text-xs">@item.Period</span>
                    </div>
                }
            </div>
        </div>

        @* Accounts *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Accounts</span>
            </div>
            @for (var i = 0; i < _accounts.Length; i++)
            {
                var account = _accounts[i];
                var isLast = i == _accounts.Length - 1;
                var statusDot = _statusColor[account.Status];
                var healthCss = HealthColor(account.HealthScore);
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", statusDot))"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@account.Name</span>
                        <span class="ml-2 text-muted-foreground text-xs">@account.LastActivity</span>
                    </div>
                    <span class="@(Cn.Merge("font-medium text-xs tabular-nums", healthCss))">@account.HealthScore</span>
                    <span class="w-16 text-right font-mono text-muted-foreground text-xs tabular-nums">@FormatCurrency(account.Arr)</span>
                </div>
            }
        </div>

        @* Upcoming renewals *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">
                    <LucideIconCn Name="refresh-cw" Size="12" Class="mr-1 inline size-3" />
                    Upcoming renewals
                </span>
            </div>
            @for (var i = 0; i < _renewals.Length; i++)
            {
                var renewal = _renewals[i];
                var isLast = i == _renewals.Length - 1;
                var likelihoodDot = _likelihoodColor[renewal.Likelihood];
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b"))">
                    <span class="@(Cn.Merge("size-2 shrink-0 rounded-full", likelihoodDot))"></span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@renewal.Company</span>
                        <span class="ml-2 text-muted-foreground text-xs">in @renewal.DueIn</span>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@renewal.Likelihood</BadgeCn>
                    <span class="shrink-0 font-medium text-xs tabular-nums">@FormatCurrency(renewal.Arr)</span>
                </div>
            }
        </div>

    </div>
</section>

@code {
    private record Metric(string Label, string Value);
    private record Account(string Id, string Name, int Arr, int HealthScore, string LastActivity, string Status);
    private record Renewal(string Company, int Arr, string DueIn, string Likelihood);
    private record NpsEntry(string Period, int Score);

    private static readonly Account[] _accounts = [
        new("1", "Stripe",   420000, 92, "Today",        "healthy"),
        new("2", "Notion",   280000, 85, "Yesterday",    "healthy"),
        new("3", "Linear",   190000, 68, "3 days ago",   "monitor"),
        new("4", "Vercel",   340000, 91, "Today",        "healthy"),
        new("5", "Supabase", 145000, 42, "1 week ago",   "at-risk"),
        new("6", "Resend",    95000, 38, "2 weeks ago",  "at-risk"),
    ];

    private static readonly Renewal[] _renewals = [
        new("Stripe",   420000, "28 days", "high"),
        new("Linear",   190000, "45 days", "medium"),
        new("Supabase", 145000, "60 days", "low"),
    ];

    private static readonly NpsEntry[] _npsHistory = [
        new("Q1 '25", 64),
        new("Q2 '25", 68),
        new("Q3 '25", 65),
        new("Q4 '25", 70),
        new("Q1 '26", 72),
    ];

    private static readonly Dictionary<string, string> _statusColor = new()
    {
        ["healthy"] = "bg-emerald-500",
        ["monitor"] = "bg-amber-500",
        ["at-risk"]  = "bg-red-500",
    };

    private static readonly Dictionary<string, string> _likelihoodColor = new()
    {
        ["high"]   = "bg-emerald-500",
        ["medium"] = "bg-amber-500",
        ["low"]    = "bg-red-500",
    };

    private int _healthyCt => _accounts.Count(a => a.Status == "healthy");
    private int _monitorCt => _accounts.Count(a => a.Status == "monitor");
    private int _atRiskCt  => _accounts.Count(a => a.Status == "at-risk");

    private static readonly Metric[] _metrics = [
        new("Total ARR",  "$8.2M"),
        new("NPS",        "72"),
        new("Gross Ret.", "97%"),
        new("Net Ret.",   "118%"),
    ];

    private static string FormatCurrency(int n)
    {
        if (n >= 1_000_000) return $"${(n / 1_000_000.0):F1}M";
        if (n >= 1_000)     return $"${(n / 1_000):F0}k";
        return $"${n}";
    }

    private static string HealthColor(int score) =>
        score >= 80 ? "text-emerald-600 dark:text-emerald-400"
        : score >= 50 ? "text-amber-600 dark:text-amber-400"
        : "text-red-600 dark:text-red-400";
}
