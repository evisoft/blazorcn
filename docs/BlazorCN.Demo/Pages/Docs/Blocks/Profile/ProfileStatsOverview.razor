@* ============================================================
   Block: profile-stats-overview
   Title: ProfileStatsOverview
   Description: React stats-heavy profile block for Next.js with 2x2 metrics grid, weekly activity bar chart, contribution streaks, and animated counters using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-stats-overview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Compact header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-9">
                <AvatarImageCn Src="" Alt="Jordan Park" />
                <AvatarFallbackCn>JP</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Jordan Park</span>
                    <span class="font-mono text-muted-foreground text-xs">@@jpark</span>
                </div>
                <span class="text-muted-foreground text-xs">Principal Engineer</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                <LucideIconCn Name="zap" Size="12" Class="size-3" />
                Top 5%
            </BadgeCn>
        </div>

        @* 2x2 metrics grid *@
        <div class="grid grid-cols-2 border-b">
            @for (var idx = 0; idx < _metrics.Length; idx++)
            {
                var metric = _metrics[idx];
                var borderB = idx < 2 ? "border-b" : "";
                var borderR = idx % 2 == 0 ? "border-r" : "";
                <div class="@($"px-4 py-4 {borderB} {borderR}")">
                    <span class="block font-medium text-muted-foreground text-xs">
                        @metric.Label
                    </span>
                    <div class="mt-1 flex items-baseline gap-1.5">
                        <span class="@($"font-semibold text-2xl tabular-nums {metric.Color}")">
                            @FormatNumber(metric.Value)
                        </span>
                        @if (!string.IsNullOrEmpty(metric.Suffix))
                        {
                            <span class="text-muted-foreground text-xs">@metric.Suffix</span>
                        }
                    </div>
                    <span class="mt-1 flex items-center gap-1 text-muted-foreground text-xs">
                        <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-emerald-500" />
                        @metric.Change
                    </span>
                </div>
            }
        </div>

        @* Weekly activity bar chart *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Weekly activity</span>
                <span class="text-muted-foreground text-xs tabular-nums">
                    @_weeklyTotal this week
                </span>
            </div>
            <div class="flex items-end gap-2">
                @foreach (var day in _weeklyActivity)
                {
                    var barHeight = (int)Math.Round((double)day.Value / MaxActivity * 80);
                    <div class="flex flex-1 flex-col items-center gap-1.5">
                        <div class="w-full rounded-sm bg-foreground/15" style="@($"height:{barHeight}px")">
                            <div class="h-full w-full rounded-sm bg-foreground/80"></div>
                        </div>
                        <span class="text-muted-foreground text-xs">@day.Day</span>
                    </div>
                }
            </div>
        </div>

        @* Recent weeks comparison *@
        <div>
            @for (var idx = 0; idx < _recentWeeks.Length; idx++)
            {
                var week = _recentWeeks[idx];
                var borderB = idx < _recentWeeks.Length - 1 ? "border-b" : "";
                var barWidth = (int)Math.Round((double)week.Contributions / 150.0 * 100);
                <div class="@($"flex items-center justify-between px-4 py-2.5 {borderB}")">
                    <span class="text-muted-foreground text-xs">@week.Week</span>
                    <div class="flex items-center gap-3">
                        <div class="h-1.5 w-24 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/60" style="@($"width:{barWidth}%")"></div>
                        </div>
                        <span class="w-8 text-right font-medium text-xs tabular-nums">
                            @week.Contributions
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MetricItem(string Label, int Value, string Suffix, string Color, string Change);
    private record DayActivity(string Day, int Value);
    private record WeekActivity(string Week, int Contributions);

    private const int MaxActivity = 31;

    private static readonly MetricItem[] _metrics =
    [
        new("Contributions", 2847, "",        "text-emerald-600 dark:text-emerald-400", "+12%"),
        new("Streak",           94, " days",  "text-amber-600 dark:text-amber-400",     "Active"),
        new("Projects",         23, "",        "text-blue-600 dark:text-blue-400",       "+3 new"),
        new("Stars earned",   8420, "",        "text-foreground",                        "+840"),
    ];

    private static readonly DayActivity[] _weeklyActivity =
    [
        new("Mon", 14),
        new("Tue", 23),
        new("Wed",  8),
        new("Thu", 31),
        new("Fri", 19),
        new("Sat",  5),
        new("Sun", 11),
    ];

    private static readonly WeekActivity[] _recentWeeks =
    [
        new("This week",    111),
        new("Last week",     97),
        new("2 weeks ago",  134),
        new("3 weeks ago",   82),
    ];

    private static readonly int _weeklyTotal = 111; // sum of _weeklyActivity values

    private static string FormatNumber(int n) =>
        n >= 1000 ? $"{(n / 1000.0):0.0}k" : n.ToString();
}
