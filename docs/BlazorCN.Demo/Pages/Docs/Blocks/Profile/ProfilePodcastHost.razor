@* ============================================================
   Block: profile-podcast-host
   Title: Profile Podcast Host
   Description: Podcast host profile with episode list, listener stats, platform distribution, and audio waveform visualization
   Long Description: React Photographer Portfolio Grid Profile Block
   Dependencies: AvatarCn, AvatarFallbackCn, BadgeCn, ButtonCn, ProgressCn, LucideClockCn, LucideHeadphonesCn, LucideMicCn, LucidePauseCn, LucidePlayCn, LucideUsersCn
   Source: original/blocks/profile/profile-podcast-host.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Host header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarFallbackCn Class="text-lg">MR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Marcus Rivera</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideMicCn Size="12" Class="mr-1 size-3" />
                        Host
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">The Build Phase</span>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">
                    Weekly conversations with founders, engineers, and designers building the future of software.
                    200+ episodes since 2021.
                </p>
            </div>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideHeadphonesCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">2.8M</span>
                <span class="text-muted-foreground">listens</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideUsersCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">48.2k</span>
                <span class="text-muted-foreground">subscribers</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">214</span>
                <span class="text-muted-foreground">episodes</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideClockCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-muted-foreground">52 min avg</span>
            </span>
        </div>

        @* Waveform *@
        <div class="flex items-end justify-center gap-0.5 border-b px-4 py-3">
            @foreach (var height in _waveformBars)
            {
                <div class="w-1.5 rounded-full bg-foreground/15" style="height: @(height * 2)px"></div>
            }
        </div>

        @* Episodes *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Latest episodes</span>
            </div>
            @for (var i = 0; i < _episodes.Count; i++)
            {
                var ep = _episodes[i];
                var isPlaying = _playing == ep.Id;
                var isLast = i == _episodes.Count - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="size-8 shrink-0 rounded-full p-0"
                              aria-label="@(isPlaying ? $"Pause {ep.Title}" : $"Play {ep.Title}")"
                              @onclick="() => _playing = isPlaying ? null : ep.Id">
                        @if (isPlaying)
                        {
                            <LucidePauseCn Size="14" Class="size-3.5" />
                        }
                        else
                        {
                            <LucidePlayCn Size="14" Class="size-3.5" />
                        }
                    </ButtonCn>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@ep.Title</span>
                        <p class="mt-0.5 truncate text-muted-foreground text-xs">@ep.Guest</p>
                    </div>
                    <div class="flex shrink-0 flex-col items-end gap-1">
                        <span class="font-mono text-muted-foreground text-xs">@ep.Duration</span>
                        <span class="text-muted-foreground text-xs">@FormatCount(ep.Listens) plays</span>
                    </div>
                </div>
            }
        </div>

        @* Platform distribution *@
        <div class="px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Listener platforms</span>
            <div class="space-y-2">
                @foreach (var p in _platforms)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-14 text-xs">@p.Name</span>
                        <ProgressCn Value="p.Share" Class="h-1.5 flex-1" aria-label="Progress" />
                        <span class="w-8 text-right font-mono text-muted-foreground text-xs tabular-nums">
                            @(p.Share)%
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private string? _playing;

    private static string FormatCount(int n)
    {
        if (n >= 1000000) return $"{n / 1000000.0:F1}M";
        if (n >= 1000) return $"{n / 1000.0:F1}k";
        return n.ToString();
    }

    private readonly int[] _waveformBars = [3, 8, 5, 12, 7, 15, 10, 6, 14, 9, 4, 11, 8, 13, 6, 10, 15, 7, 5, 12, 9, 3, 11, 8, 14, 6];

    private record EpisodeItem(string Id, string Title, string Guest, string Duration, int Listens, string Published);

    private readonly List<EpisodeItem> _episodes =
    [
        new("1", "Why We Rewrote Everything in Rust", "Sarah Chen, CTO at Turborepo", "58 min", 34200, "2 days ago"),
        new("2", "Designing for AI-First Products", "James Park, Head of Design at Anthropic", "47 min", 28900, "1 week ago"),
        new("3", "Scaling to 10M Users on a 3-Person Team", "Priya Sharma, Founder of Raycast", "62 min", 41200, "2 weeks ago"),
        new("4", "The Future of Developer Tooling", "Alex Karp, VP Eng at Vercel", "44 min", 22600, "3 weeks ago"),
    ];

    private record PlatformItem(string Name, int Share);

    private readonly PlatformItem[] _platforms =
    [
        new("Spotify", 42), new("Apple", 31), new("YouTube", 18), new("RSS", 9),
    ];
}
