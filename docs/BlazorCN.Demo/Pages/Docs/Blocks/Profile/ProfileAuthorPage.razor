@* ============================================================
   Block: profile-author-page
   Title: Profile Author Page
   Description: Author page profile with published books grid, bestseller badges, reading stats, genre tags, and awards section
   Long Description: Conference speaker profile card
   Dependencies: AvatarCn, AvatarFallbackCn, BadgeCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn, LucideAwardCn, LucideBookOpenCn, LucideStarCn
   Source: original/blocks/profile/profile-author-page.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Author header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-16">
                <AvatarFallbackCn Class="text-xl">IM</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Isabel Moreno</span>
                <span class="mt-0.5 block text-muted-foreground text-xs">Award-winning novelist and essayist</span>
                <p class="mt-2 text-muted-foreground text-sm leading-relaxed">
                    Author of six novels including the National Book Award-winning &ldquo;The Glass Garden.&rdquo;
                    Her work explores memory, migration, and the spaces between languages. Translated into 28 languages.
                </p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                    @foreach (var genre in _genres)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@genre</BadgeCn>
                    }
                </div>
            </div>
        </div>

        @* Stats row *@
        <div class="grid grid-cols-4 border-b">
            <div class="px-4 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">6</span>
                <span class="text-muted-foreground text-xs">Books</span>
            </div>
            <div class="px-4 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">2.4M</span>
                <span class="text-muted-foreground text-xs">Copies Sold</span>
            </div>
            <div class="px-4 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">4.3</span>
                <span class="text-muted-foreground text-xs">Avg Rating</span>
            </div>
            <div class="px-4 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">89K</span>
                <span class="text-muted-foreground text-xs">Followers</span>
            </div>
        </div>

        @* Tabs *@
        <TabsCn Value="books">
            <div class="border-b px-4">
                <TabsListCn Class="h-9 w-full justify-start gap-4 rounded-none border-none bg-transparent p-0">
                    <TabsTriggerCn Value="books"
                        Class="h-9 rounded-none border-transparent border-b-2 bg-transparent px-0 font-medium text-xs data-[state=active]:border-foreground data-[state=active]:shadow-none">
                        <LucideBookOpenCn Size="12" Class="mr-1.5 size-3" />
                        Books
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="awards"
                        Class="h-9 rounded-none border-transparent border-b-2 bg-transparent px-0 font-medium text-xs data-[state=active]:border-foreground data-[state=active]:shadow-none">
                        <LucideAwardCn Size="12" Class="mr-1.5 size-3" />
                        Awards
                    </TabsTriggerCn>
                </TabsListCn>
            </div>

            <TabsContentCn Value="books" Class="m-0">
                @for (var i = 0; i < _books.Count; i++)
                {
                    var book = _books[i];
                    var isLast = i == _books.Count - 1;
                    <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                        @* Book cover placeholder *@
                        <div class="flex h-16 w-11 shrink-0 items-center justify-center rounded bg-muted/80">
                            <LucideBookOpenCn Size="16" Class="size-4 text-muted-foreground/60" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@book.Title</span>
                                @if (book.Bestseller)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                                        Bestseller
                                    </BadgeCn>
                                }
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@book.Year</span>
                                <span>&middot;</span>
                                <span>@book.Pages pages</span>
                                @if (!string.IsNullOrEmpty(book.Award))
                                {
                                    <span>&middot;</span>
                                    <span class="flex items-center gap-1">
                                        <LucideAwardCn Size="12" Class="size-3 text-amber-500" />
                                        @book.Award
                                    </span>
                                }
                            </div>
                            <div class="mt-1 flex items-center gap-2">
                                <div class="flex items-center gap-0.5">
                                    @for (var s = 0; s < 5; s++)
                                    {
                                        var filled = s < (int)Math.Round(book.Rating);
                                        <LucideStarCn Size="12"
                                            Class="@Cn.Merge("size-3", filled ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30")" />
                                    }
                                </div>
                                <span class="text-muted-foreground text-xs tabular-nums">@book.Rating</span>
                                <span class="text-muted-foreground text-xs">(@book.Reviews)</span>
                            </div>
                        </div>
                    </div>
                }
            </TabsContentCn>

            <TabsContentCn Value="awards" Class="m-0">
                @for (var i = 0; i < _awards.Count; i++)
                {
                    var award = _awards[i];
                    var isLast = i == _awards.Count - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                        <div class="flex size-8 items-center justify-center rounded-md bg-muted/50">
                            <LucideAwardCn Size="16" Class="size-4 text-amber-500" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@award.Name</span>
                            <span class="mt-0.5 block text-muted-foreground text-xs">
                                For &ldquo;@award.Work&rdquo;
                            </span>
                        </div>
                        <span class="text-muted-foreground text-xs tabular-nums">@award.Year</span>
                    </div>
                }
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private readonly string[] _genres = ["Literary Fiction", "Magical Realism", "Historical Fiction", "Essays", "Short Stories"];

    private record BookItem(string Title, string Year, double Rating, string Reviews, int Pages, bool Bestseller, string? Award);

    private readonly List<BookItem> _books =
    [
        new("The Glass Garden", "2024", 4.6, "14.2K", 342, true, "National Book Award"),
        new("Salt and Distance", "2022", 4.4, "9.8K", 298, true, "PEN/Faulkner"),
        new("Where Rivers End", "2020", 4.2, "7.3K", 416, false, null),
        new("The Cartographer's Wife", "2018", 4.1, "5.1K", 384, true, null),
        new("Borrowed Light", "2016", 4.0, "3.9K", 264, false, "Pushcart Prize"),
        new("Ink and Ochre", "2014", 3.9, "2.7K", 312, false, null),
    ];

    private record AwardItem(string Name, string Year, string Work);

    private readonly List<AwardItem> _awards =
    [
        new("National Book Award", "2024", "The Glass Garden"),
        new("PEN/Faulkner Award", "2022", "Salt and Distance"),
        new("Pushcart Prize", "2016", "Borrowed Light"),
        new("Whiting Award", "2015", "Body of Work"),
    ];
}
