@* ============================================================
   Block: profile-settings-form
   Title: ProfileSettingsForm
   Description: React editable profile settings form for Next.js with avatar upload area, name and email inputs, bio textarea, timezone select, and save/cancel footer using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-settings-form.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-sm">Profile settings</span>
            <p class="mt-0.5 text-muted-foreground text-xs">
                Update your personal information and preferences
            </p>
        </div>

        @* Avatar section *@
        <div class="flex items-center gap-4 border-b px-4 py-4">
            <div class="group relative cursor-pointer">
                <AvatarCn Class="size-16">
                    <AvatarImageCn Src="" Alt="Profile" />
                    <AvatarFallbackCn Class="text-lg">SM</AvatarFallbackCn>
                </AvatarCn>
                <div class="absolute inset-0 flex items-center justify-center rounded-full bg-black/40 opacity-0 transition-opacity group-hover:opacity-100">
                    <LucideIconCn Name="camera" Size="16" Class="size-4 text-white" />
                </div>
            </div>
            <div>
                <span class="block font-medium text-sm">Profile photo</span>
                <span class="text-muted-foreground text-xs">JPG, PNG, or GIF. Max 2MB.</span>
                <div class="mt-2 flex gap-2">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">
                        Upload
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs text-muted-foreground">
                        Remove
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Form fields *@
        <div class="space-y-0">
            @* Name row — two columns *@
            <div class="grid grid-cols-2 gap-4 border-b px-4 py-4">
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        First name
                    </span>
                    <InputCn @bind-Value="_firstName" aria-label="First name" Class="h-8 text-sm" @oninput="@((e) => { _firstName = e.Value?.ToString() ?? ""; _hasChanges = true; _saved = false; })" />
                </div>
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        Last name
                    </span>
                    <InputCn @bind-Value="_lastName" aria-label="Last name" Class="h-8 text-sm" @oninput="@((e) => { _lastName = e.Value?.ToString() ?? ""; _hasChanges = true; _saved = false; })" />
                </div>
            </div>

            @* Email *@
            <div class="border-b px-4 py-4">
                <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                    Email address
                </span>
                <InputCn type="email" @bind-Value="_email" aria-label="Email address" Class="h-8 text-sm" @oninput="@((e) => { _email = e.Value?.ToString() ?? ""; _hasChanges = true; _saved = false; })" />
            </div>

            @* Bio *@
            <div class="border-b px-4 py-4">
                <div class="mb-1.5 flex items-center justify-between">
                    <span class="font-medium text-muted-foreground text-xs">Bio</span>
                    <span class="text-muted-foreground text-xs tabular-nums">
                        @_bio.Length/200
                    </span>
                </div>
                <textarea
                    value="@_bio"
                    aria-label="Bio"
                    maxlength="200"
                    rows="3"
                    class="w-full resize-none rounded-md border bg-transparent px-3 py-2 text-sm leading-relaxed shadow-sm placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                    @oninput="@((ChangeEventArgs e) => { _bio = e.Value?.ToString() ?? ""; _hasChanges = true; _saved = false; })">@_bio</textarea>
            </div>

            @* Timezone + notifications *@
            <div class="grid grid-cols-2 gap-4 border-b px-4 py-4">
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        Timezone
                    </span>
                    <select
                        value="@_timezone"
                        aria-label="Timezone"
                        class="h-8 w-full rounded-md border bg-transparent px-2 text-sm shadow-sm focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                        @onchange="@((ChangeEventArgs e) => { _timezone = e.Value?.ToString() ?? ""; _hasChanges = true; _saved = false; })">
                        @foreach (var tz in _timezones)
                        {
                            <option value="@tz.Value">@tz.Label</option>
                        }
                    </select>
                </div>
                <div>
                    <span class="mb-1.5 block font-medium text-muted-foreground text-xs">
                        Email notifications
                    </span>
                    <label class="mt-1 flex cursor-pointer items-center gap-2">
                        <input
                            type="checkbox"
                            checked="@_notifications"
                            class="size-4 rounded border accent-foreground"
                            @onchange="@((ChangeEventArgs e) => { _notifications = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var p) && p; _hasChanges = true; _saved = false; })" />
                        <span class="text-sm">@(_notifications ? "Enabled" : "Disabled")</span>
                    </label>
                </div>
            </div>
        </div>

        @* Footer actions *@
        <div class="flex items-center justify-between px-4 py-3">
            @if (_saved)
            {
                <div class="flex items-center gap-1.5 text-emerald-600 text-xs dark:text-emerald-400">
                    <LucideIconCn Name="check" Size="14" Class="size-3.5" />
                    Changes saved
                </div>
            }
            else
            {
                <div></div>
            }

            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs"
                    @onclick="HandleCancel"
                    Disabled="@(!_hasChanges || _saving)">
                    Cancel
                </ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 text-xs"
                    @onclick="HandleSave"
                    Disabled="@(!_hasChanges || _saving)">
                    @if (_saving)
                    {
                        <LucideIconCn Name="loader-2" Size="12" Class="mr-1 size-3 animate-spin" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save changes</span>
                    }
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record TimezoneOption(string Value, string Label);

    private string _firstName = "Sarah";
    private string _lastName = "Mitchell";
    private string _email = "sarah.mitchell@@acmecorp.com";
    private string _bio = "Product designer focused on developer tools and design systems. Previously at Stripe and Figma.";
    private string _timezone = "America/New_York";
    private bool _notifications = true;
    private bool _saving = false;
    private bool _saved = false;
    private bool _hasChanges = false;

    private static readonly TimezoneOption[] _timezones =
    [
        new("America/New_York", "Eastern Time (ET)"),
        new("America/Chicago", "Central Time (CT)"),
        new("America/Denver", "Mountain Time (MT)"),
        new("America/Los_Angeles", "Pacific Time (PT)"),
        new("Europe/London", "Greenwich Mean Time (GMT)"),
        new("Europe/Berlin", "Central European Time (CET)"),
        new("Asia/Tokyo", "Japan Standard Time (JST)"),
    ];

    private async Task HandleSave()
    {
        _saving = true;
        await Task.Delay(1200);
        _saving = false;
        _saved = true;
        _hasChanges = false;
        StateHasChanged();
        await Task.Delay(2500);
        _saved = false;
    }

    private void HandleCancel()
    {
        _firstName = "Sarah";
        _lastName = "Mitchell";
        _email = "sarah.mitchell@@acmecorp.com";
        _bio = "Product designer focused on developer tools and design systems. Previously at Stripe and Figma.";
        _timezone = "America/New_York";
        _notifications = true;
        _hasChanges = false;
        _saved = false;
    }
}
