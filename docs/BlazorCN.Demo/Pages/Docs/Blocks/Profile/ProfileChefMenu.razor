@* ============================================================
   Block: profile-chef-menu
   Title: ProfileChefMenu
   Description: React chef menu profile block for Next.js with signature dishes grid, cuisine expertise tags, restaurant history timeline, awards section, and dietary filter toggles using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-chef-menu.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Chef Marco DiStefano" />
                <AvatarFallbackCn Class="text-lg">MD</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Chef Marco DiStefano</span>
                    <span class="flex items-center gap-0.5">
                        @for (var i = 0; i < 2; i++)
                        {
                            <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                        }
                    </span>
                </div>
                <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                    <span>Executive Chef at Osteria Moderna</span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        New York, NY
                    </span>
                </div>
                <p class="mt-2 text-muted-foreground text-sm leading-relaxed">Third-generation Italian chef blending traditional techniques with modern molecular gastronomy. Trained at Le Cordon Bleu Paris. Two Michelin stars.</p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                    @foreach (var cuisine in _cuisines)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@cuisine</BadgeCn>
                    }
                </div>
            </div>
        </div>

        @* Awards bar *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            @foreach (var award in _awards)
            {
                <span class="flex items-center gap-1.5 text-xs">
                    <LucideIconCn Name="award" Size="12" Class="size-3 text-amber-500" />
                    <span class="font-medium">@award.Name</span>
                    <span class="text-muted-foreground">@award.Year</span>
                </span>
            }
        </div>

        @* Dietary filters *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <span class="text-muted-foreground text-xs">Filter:</span>
            @foreach (var tag in _dietaryTags)
            {
                var t = tag;
                var isActive = _filters.Contains(t);
                <button
                    class="@(Cn.Merge("inline-flex h-6 items-center rounded-sm px-2 text-xs font-medium transition-colors hover:bg-muted hover:text-muted-foreground focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring", isActive ? "bg-accent text-accent-foreground" : "bg-transparent"))"
                    @onclick="@(() => ToggleFilter(t))">
                    @if (t == "vegetarian") { <text>Vegetarian</text> }
                    @if (t == "vegan") { <text>Vegan</text> }
                    @if (t == "gluten-free") { <text>GF</text> }
                </button>
            }
        </div>

        @* Signature dishes *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">
                    Menu @if (_filters.Count > 0) { <text>(@(_filteredDishes.Length) items)</text> }
                </span>
            </div>
            @{
                var filtered = _filteredDishes;
            }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var dish = filtered[i];
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", i < filtered.Length - 1 ? "border-b" : ""))">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@dish.Name</span>
                                @if (dish.Signature)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                                        <LucideIconCn Name="chef-hat" Size="10" Class="mr-0.5 size-2.5" />
                                        Signature
                                    </BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs leading-relaxed">@dish.Description</p>
                            <div class="mt-1.5 flex items-center gap-2">
                                @foreach (var dtag in dish.Dietary)
                                {
                                    <span class="flex items-center gap-0.5 text-muted-foreground text-[10px]">
                                        <LucideIconCn Name="leaf" Size="10" Class="size-2.5" />
                                        @_dietaryLabels[dtag]
                                    </span>
                                }
                                @if (dish.PrepTime != "N/A")
                                {
                                    <span class="flex items-center gap-0.5 text-muted-foreground text-[10px]">
                                        <LucideIconCn Name="clock" Size="10" Class="size-2.5" />
                                        @dish.PrepTime
                                    </span>
                                }
                            </div>
                        </div>
                        <span class="shrink-0 font-medium text-sm tabular-nums">$@dish.Price</span>
                    </div>
                </div>
            }
        </div>

        @* Career timeline *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Career</span>
            </div>
            <div class="relative px-4 py-3">
                <div class="absolute top-0 bottom-0 left-[29px] w-px bg-border"></div>
                <div class="space-y-3">
                    @for (var i = 0; i < _careerTimeline.Length; i++)
                    {
                        var entry = _careerTimeline[i];
                        var dotClass = i == 0 ? "bg-foreground" : "bg-foreground/40";
                        <div class="relative pl-6">
                            <span class="@(Cn.Merge("absolute left-0 top-1.5 size-2 rounded-full", dotClass))"></span>
                            <div class="flex items-center justify-between">
                                <span class="font-medium text-sm">@entry.Restaurant</span>
                                <span class="text-muted-foreground text-xs">@entry.Years</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@entry.Role</span>
                                <span>·</span>
                                <span>@entry.Location</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record DishItem(string Id, string Name, string Description, int Price, string[] Dietary, string PrepTime, bool Signature);
    private record AwardItem(string Name, int Count, string Year);
    private record CareerEntry(string Restaurant, string Role, string Years, string Location);

    private readonly string[] _cuisines = ["Modern Italian", "French", "Mediterranean", "Farm-to-Table", "Molecular Gastronomy"];
    private readonly string[] _dietaryTags = ["vegetarian", "vegan", "gluten-free"];

    private readonly Dictionary<string, string> _dietaryLabels = new()
    {
        ["vegetarian"] = "Vegetarian",
        ["vegan"] = "Vegan",
        ["gluten-free"] = "GF",
    };

    private readonly AwardItem[] _awards = [
        new("Michelin Star", 2, "2021, 2023"),
        new("James Beard Semifinalist", 1, "2022"),
        new("Food & Wine Best New Chef", 1, "2020"),
    ];

    private readonly DishItem[] _dishes = [
        new("d1", "Burrata with Heirloom Tomatoes", "Hand-pulled burrata, aged balsamic reduction, micro basil, olive oil crumble", 24, ["vegetarian", "gluten-free"], "15 min", true),
        new("d2", "Truffle Risotto", "Carnaroli rice, black truffle shavings, Parmigiano-Reggiano foam, chive oil", 38, ["vegetarian", "gluten-free"], "25 min", true),
        new("d3", "Herb-Crusted Branzino", "Mediterranean sea bass, saffron fennel puree, citrus beurre blanc, capers", 42, ["gluten-free"], "20 min", false),
        new("d4", "Beet Carpaccio", "Roasted golden and chioggia beets, pistachio dust, vegan ricotta, arugula", 19, ["vegan", "gluten-free"], "10 min", false),
        new("d5", "Handmade Pappardelle", "Wild boar ragu, pecorino romano, fresh rosemary, san marzano tomatoes", 32, [], "30 min", true),
        new("d6", "Olive Oil Cake", "Sicilian olive oil, Meyer lemon curd, mascarpone gelato, candied pistachios", 16, ["vegetarian"], "N/A", false),
    ];

    private readonly CareerEntry[] _careerTimeline = [
        new("Osteria Moderna", "Executive Chef", "2019 - Present", "New York"),
        new("Le Bernardin", "Sous Chef", "2015 - 2019", "New York"),
        new("Noma", "Chef de Partie", "2012 - 2015", "Copenhagen"),
        new("Le Cordon Bleu", "Graduate", "2010 - 2012", "Paris"),
    ];

    private readonly HashSet<string> _filters = new();

    private DishItem[] _filteredDishes => _filters.Count == 0
        ? _dishes
        : _dishes.Where(d => _filters.All(f => d.Dietary.Contains(f))).ToArray();

    private void ToggleFilter(string tag)
    {
        if (_filters.Contains(tag))
            _filters.Remove(tag);
        else
            _filters.Add(tag);
    }
}
