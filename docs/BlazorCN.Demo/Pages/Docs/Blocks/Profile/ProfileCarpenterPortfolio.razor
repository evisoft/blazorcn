@* ============================================================
   Block: profile-carpenter-portfolio
   Title: ProfileCarpenterPortfolio
   Description: React carpenter profile block for Next.js with project gallery, woodworking specialties, material expertise, and client testimonials using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-carpenter-portfolio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="Thomas Eriksen" />
                <AvatarFallbackCn>TE</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Thomas Eriksen</span>
                </div>
                <span class="text-muted-foreground text-xs">Master Carpenter &amp; Woodworker</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">Third-generation carpenter specializing in custom furniture, built-ins, and restoration. Using sustainably sourced hardwoods for 20+ years.</p>
                <div class="mt-1.5 flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                    Portland, OR
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Get Quote</ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="hammer" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">340</span>
                <span class="text-muted-foreground">projects</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">22</span>
                <span class="text-muted-foreground">years</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="star" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">4.9</span>
            </span>
        </div>

        @* Services / Specialties *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Services</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var s in _specialties)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@s</BadgeCn>
                }
            </div>
        </div>

        @* Recent Projects *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent Projects</span>
            </div>
            @for (var i = 0; i < _projects.Length; i++)
            {
                var project = _projects[i];
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", i < _projects.Length - 1 ? "border-b" : ""))">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@project.Title</span>
                            <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@project.Type</BadgeCn>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="trees" Size="12" Class="size-3" />
                                    @project.Material
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                    @project.Duration
                                </span>
                            </div>
                        </div>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs">@project.Year</span>
                    </div>
                </div>
            }
        </div>

        @* Material Expertise *@
        <div class="px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Material Expertise</span>
            <div class="space-y-2">
                @foreach (var m in _materials)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-28 text-xs">@m.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="@($"width:{m.Level}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record ProjectItem(string Id, string Title, string Type, string Material, string Duration, string Year);
    private record MaterialItem(string Name, int Level);

    private static readonly string[] _specialties =
    [
        "Custom Furniture",
        "Built-In Cabinetry",
        "Restoration",
        "Outdoor Structures",
        "Finish Carpentry",
        "Wood Turning",
    ];

    private static readonly ProjectItem[] _projects =
    [
        new("p1", "Walnut Live-Edge Dining Table", "Custom Furniture", "Black Walnut", "6 weeks", "2026"),
        new("p2", "Kitchen Cabinet Restoration", "Restoration", "White Oak", "3 weeks", "2026"),
        new("p3", "Home Library Built-Ins", "Built-In", "Cherry", "8 weeks", "2025"),
        new("p4", "Cedar Deck & Pergola", "Outdoor", "Western Red Cedar", "4 weeks", "2025"),
    ];

    private static readonly MaterialItem[] _materials =
    [
        new("Hardwoods", 95),
        new("Reclaimed Wood", 85),
        new("Softwoods", 80),
        new("Exotic Species", 70),
        new("Engineered Wood", 65),
    ];
}
