@* ============================================================
   Block: profile-ai-engineer
   Title: Profile Ai Engineer
   Description: AI engineer profile with model deployment status, benchmark scores, GPU utilization metrics, research papers, and tech stack badges
   Long Description: React Activity Timeline Profile Block
   Dependencies: AvatarCn, AvatarFallbackCn, BadgeCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn, LucideBrainCircuitCn, LucideCpuCn, LucideFileTextCn, LucideGaugeCn, LucideZapCn
   Source: original/blocks/profile/profile-ai-engineer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarFallbackCn>SK</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Dr. Sarah Kim</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Anthropic</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Staff AI Engineer</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                    Building safe and reliable AI systems. PhD in ML from MIT. Previously at DeepMind.
                    Focus areas: alignment, interpretability, and efficient inference.
                </p>
            </div>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideBrainCircuitCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">7</span>
                <span class="text-muted-foreground">models deployed</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideFileTextCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">18</span>
                <span class="text-muted-foreground">papers</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">4.2K</span>
                <span class="text-muted-foreground">citations</span>
            </span>
        </div>

        @* Tabbed content *@
        <TabsCn Value="models" Class="w-full">
            <TabsListCn Class="w-full justify-start border-b px-4">
                <TabsTriggerCn Value="models" Class="text-xs">Models</TabsTriggerCn>
                <TabsTriggerCn Value="papers" Class="text-xs">Papers</TabsTriggerCn>
                <TabsTriggerCn Value="infra" Class="text-xs">Infrastructure</TabsTriggerCn>
            </TabsListCn>

            @* Models tab *@
            <TabsContentCn Value="models" Class="mt-0">
                @for (var i = 0; i < _models.Count; i++)
                {
                    var model = _models[i];
                    var isLast = i == _models.Count - 1;
                    <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                        <div class="flex items-center gap-2">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", model.StatusColor)"></span>
                            <span class="font-mono font-medium text-sm">@model.Name</span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="font-mono font-normal text-xs">
                                v@model.Version
                            </BadgeCn>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs capitalize">
                                @model.Status
                            </BadgeCn>
                        </div>
                        <div class="mt-1.5 flex items-center gap-4 pl-3.5 text-muted-foreground text-xs">
                            <span class="flex items-center gap-1 tabular-nums">
                                <LucideGaugeCn Size="12" Class="size-3" />
                                @model.Latency
                            </span>
                            <span class="flex items-center gap-1 tabular-nums">
                                <LucideZapCn Size="12" Class="size-3" />
                                @model.Throughput
                            </span>
                            <span class="ml-auto">@model.LastDeployed</span>
                        </div>
                    </div>
                }
            </TabsContentCn>

            @* Papers tab *@
            <TabsContentCn Value="papers" Class="mt-0">
                @for (var i = 0; i < _papers.Count; i++)
                {
                    var paper = _papers[i];
                    var isLast = i == _papers.Count - 1;
                    <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                        <span class="font-medium text-sm">@paper.Title</span>
                        <div class="mt-1 flex items-center gap-2 text-muted-foreground text-xs">
                            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@paper.Venue</BadgeCn>
                            <span>@paper.Year</span>
                            <span>&middot;</span>
                            <span class="tabular-nums">@paper.Citations citations</span>
                        </div>
                    </div>
                }
            </TabsContentCn>

            @* Infrastructure tab *@
            <TabsContentCn Value="infra" Class="mt-0">
                <div class="border-b px-4 py-2">
                    <span class="font-medium text-muted-foreground text-xs">GPU cluster utilization</span>
                </div>
                @for (var i = 0; i < _gpus.Count; i++)
                {
                    var gpu = _gpus[i];
                    var isLast = i == _gpus.Count - 1;
                    var barColor = gpu.Utilization >= 90 ? "bg-red-500" : gpu.Utilization >= 70 ? "bg-amber-500" : "bg-emerald-500";
                    <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2">
                                <LucideCpuCn Size="14" Class="size-3.5 text-muted-foreground" />
                                <span class="font-mono text-sm">@gpu.Name</span>
                            </div>
                            <span class="font-mono text-muted-foreground text-xs tabular-nums">@gpu.Memory</span>
                        </div>
                        <div class="mt-1.5 flex items-center gap-2">
                            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted/50">
                                <div class="@Cn.Merge("h-full rounded-full", barColor)" style="width: @(gpu.Utilization)%"></div>
                            </div>
                            <span class="w-8 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                                @(gpu.Utilization)%
                            </span>
                        </div>
                    </div>
                }
            </TabsContentCn>
        </TabsCn>

        @* Benchmark scores *@
        <div class="border-t px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Latest benchmark scores</span>
            <div class="space-y-2">
                @foreach (var bench in _benchmarks)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-20 shrink-0 font-mono text-xs">@bench.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted/50">
                            <div class="h-full rounded-full bg-foreground/70" style="width: @((bench.Score / bench.Max * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
                        </div>
                        <span class="w-10 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                            @bench.Score
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Tech stack *@
        <div class="border-t px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Tech stack</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var tech in _techStack)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@tech</BadgeCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ModelItem(string Name, string Version, string Status, string StatusColor, string Latency, string Throughput, string LastDeployed);
    private record PaperItem(string Title, string Venue, string Year, int Citations);
    private record GpuItem(string Name, int Utilization, string Memory);
    private record BenchmarkItem(string Name, double Score, double Max);

    private readonly List<ModelItem> _models =
    [
        new("safety-classifier-v3", "3.2.1", "active", "bg-emerald-500", "12ms", "8.4K req/s", "2 days ago"),
        new("intent-router", "2.0.0", "active", "bg-emerald-500", "8ms", "15K req/s", "1 week ago"),
        new("embedding-model", "4.1.0", "active", "bg-emerald-500", "24ms", "3.2K req/s", "2 weeks ago"),
        new("toxicity-detector", "1.8.3", "staging", "bg-amber-500", "18ms", "5.1K req/s", "3 days ago"),
    ];

    private readonly List<PaperItem> _papers =
    [
        new("Scalable Oversight for Language Model Alignment", "NeurIPS", "2025", 890),
        new("Mechanistic Interpretability of Transformer Circuits", "ICML", "2025", 1240),
        new("Efficient Fine-Tuning with Sparse Attention Adapters", "ICLR", "2024", 672),
        new("Constitutional AI: Harmlessness from AI Feedback", "arXiv", "2024", 1398),
    ];

    private readonly List<GpuItem> _gpus =
    [
        new("A100-80GB #1", 94, "72/80 GB"),
        new("A100-80GB #2", 87, "68/80 GB"),
        new("A100-80GB #3", 76, "58/80 GB"),
        new("H100-80GB #1", 42, "34/80 GB"),
    ];

    private readonly List<BenchmarkItem> _benchmarks =
    [
        new("MMLU", 89.2, 100),
        new("HumanEval", 82.4, 100),
        new("TruthfulQA", 74.8, 100),
        new("GSM8K", 91.3, 100),
    ];

    private readonly string[] _techStack = ["PyTorch", "JAX", "Triton", "CUDA", "vLLM", "Ray", "Kubernetes", "Rust", "Python", "TypeScript"];
}
