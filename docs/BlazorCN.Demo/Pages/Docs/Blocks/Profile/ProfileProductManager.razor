@* ============================================================
   Block: profile-product-manager
   Title: ProfileProductManager
   Description: React product manager profile block for Next.js with OKR tracking, roadmap timeline, sprint velocity metrics, and stakeholder alignment using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-product-manager.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarFallbackCn>RP</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Raj Patel</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Stripe</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Senior Product Manager</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                    Leading payments infrastructure products. Previously at Plaid and Square. MBA from Stanford GSB.
                </p>
            </div>
        </div>

        @* Quick stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">14</span>
                <span class="text-muted-foreground">reports</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="bar-chart-3" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">3</span>
                <span class="text-muted-foreground">products</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="target" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">2</span>
                <span class="text-muted-foreground">active OKRs</span>
            </span>
        </div>

        @* OKR section *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Objectives &amp; Key Results</span>
            </div>
            @for (var i = 0; i < _objectives.Length; i++)
            {
                var obj = _objectives[i];
                var isExpanded = _expandedObjective == obj.Id;
                var isLast = i == _objectives.Length - 1;
                var objCaptured = obj;
                <div class="@Cn.Merge(isLast && !isExpanded ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expandedObjective = isExpanded ? null : objCaptured.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@obj.Title</span>
                            <div class="mt-2 flex items-center gap-2">
                                <ProgressCn Value="@obj.Progress" Class="h-1.5 flex-1" />
                                <span class="shrink-0 font-medium text-muted-foreground text-xs tabular-nums">@(obj.Progress)%</span>
                            </div>
                        </div>
                    </button>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3">
                            @foreach (var kr in obj.KeyResults)
                            {
                                var pct = (int)Math.Min(100, Math.Round((double)kr.Current / kr.Target * 100));
                                <div class="flex items-center gap-3 py-1.5">
                                    @if (pct >= 100)
                                    {
                                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 shrink-0 text-emerald-500" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="circle" Size="14" Class="size-3.5 shrink-0 text-muted-foreground/40" />
                                    }
                                    <span class="min-w-0 flex-1 text-sm">@kr.Label</span>
                                    <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                                        @(kr.Current)@(kr.Unit) / @(kr.Target)@(kr.Unit)
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Roadmap timeline *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Roadmap</span>
            </div>
            <div class="px-4 py-3">
                @for (var i = 0; i < _roadmap.Length; i++)
                {
                    var item = _roadmap[i];
                    var isLast = i == _roadmap.Length - 1;
                    var dotColor = _statusDot.TryGetValue(item.Status, out var dc) ? dc : "bg-muted-foreground/40";
                    var statusLbl = _statusLabel.TryGetValue(item.Status, out var sl) ? sl : item.Status;
                    <div class="flex items-start gap-3 pb-3 @(isLast ? "pb-0" : "")">
                        <div class="flex flex-col items-center pt-1.5">
                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", dotColor)"></span>
                            @if (!isLast)
                            {
                                <div class="mt-1 h-6 w-px bg-border"></div>
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@item.Title</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs">@item.Quarter</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@statusLbl</BadgeCn>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Stakeholder alignment *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Stakeholder Alignment</span>
            </div>
            @for (var i = 0; i < _stakeholders.Length; i++)
            {
                var s = _stakeholders[i];
                var isLast = i == _stakeholders.Length - 1;
                var alignDot = _alignmentDot.TryGetValue(s.Alignment, out var ad) ? ad : "bg-muted-foreground/40";
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", alignDot)"></span>
                    <span class="font-medium text-sm">@s.Name</span>
                    <span class="text-muted-foreground text-xs">@s.Role</span>
                    <span class="ml-auto text-muted-foreground text-xs capitalize">@s.Alignment</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expandedObjective = "o1";

    private record KeyResult(string Id, string Label, double Current, double Target, string Unit);
    private record Objective(string Id, string Title, int Progress, KeyResult[] KeyResults);
    private record RoadmapItem(string Id, string Title, string Quarter, string Status);
    private record Stakeholder(string Name, string Role, string Alignment);

    private static readonly Objective[] _objectives =
    [
        new("o1", "Increase developer adoption of Payment Links API", 72,
        [
            new("kr1", "Monthly active integrations", 1840, 2500, ""),
            new("kr2", "API error rate", 0.3, 0.5, "%"),
            new("kr3", "Time to first transaction", 8, 5, "min"),
        ]),
        new("o2", "Launch multi-currency settlement in 12 new markets", 45,
        [
            new("kr4", "Markets launched", 5, 12, ""),
            new("kr5", "Settlement volume", 34, 100, "M"),
        ]),
    ];

    private static readonly RoadmapItem[] _roadmap =
    [
        new("r1", "Payment Links v2 GA", "Q1 2026", "shipped"),
        new("r2", "Multi-currency settlement", "Q2 2026", "in-progress"),
        new("r3", "Embedded checkout SDK", "Q3 2026", "planned"),
        new("r4", "Revenue recognition engine", "Q4 2026", "planned"),
    ];

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["shipped"] = "bg-emerald-500",
        ["in-progress"] = "bg-amber-500",
        ["planned"] = "bg-muted-foreground/40",
    };

    private static readonly Dictionary<string, string> _statusLabel = new()
    {
        ["shipped"] = "Shipped",
        ["in-progress"] = "In progress",
        ["planned"] = "Planned",
    };

    private static readonly Stakeholder[] _stakeholders =
    [
        new("Engineering", "Platform team", "aligned"),
        new("Design", "Product design", "aligned"),
        new("Legal", "Compliance", "partial"),
        new("Finance", "Revenue ops", "aligned"),
        new("Marketing", "Developer marketing", "partial"),
    ];

    private static readonly Dictionary<string, string> _alignmentDot = new()
    {
        ["aligned"] = "bg-emerald-500",
        ["partial"] = "bg-amber-500",
        ["blocked"] = "bg-red-500",
    };
}
