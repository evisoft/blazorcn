@* ============================================================
   Block: profile-therapist-booking
   Title: ProfileTherapistBooking
   Description: React therapist booking profile block for Next.js with availability calendar, specialization tags, session types, insurance list, and appointment scheduling using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-therapist-booking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Therapist header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Dr. Amara Osei" />
                <AvatarFallbackCn Class="text-lg">AO</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Dr. Amara Osei</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="check-circle" Size="12" Class="mr-1 size-3 text-emerald-500" />
                        Accepting patients
                    </BadgeCn>
                </div>
                <p class="mt-0.5 text-muted-foreground text-xs">Licensed Clinical Psychologist</p>
                <p class="font-mono text-muted-foreground text-xs">PsyD, Licensed #PSY-29481</p>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">Specializing in anxiety, trauma, and life transitions. Integrative approach combining CBT, EMDR, and mindfulness-based interventions. 12 years clinical experience.</p>
                <div class="mt-2 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Brooklyn, NY
                    </span>
                    <span>·</span>
                    <span>English, French, Twi</span>
                </div>
            </div>
        </div>

        @* Specializations *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                <LucideIconCn Name="heart" Size="12" Class="size-3" />
                Specializations
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var spec in _specializations)
                {
                    <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@spec</BadgeCn>
                }
            </div>
        </div>

        @* Session types *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                    Session types
                </span>
            </div>
            @for (var i = 0; i < _sessionTypes.Length; i++)
            {
                var session = _sessionTypes[i];
                var isLast = i == _sessionTypes.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div>
                        <span class="font-medium text-sm">@session.Name</span>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span>@session.Duration</span>
                            <span>·</span>
                            <span class="flex items-center gap-1">
                                <LucideIconCn Name="video" Size="12" Class="size-3" />
                                @session.Format
                            </span>
                        </div>
                    </div>
                    <span class="font-semibold text-sm tabular-nums">@session.Price</span>
                </div>
            }
        </div>

        @* Availability / booking *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                    Available this week
                </span>
            </div>

            @* Day selector *@
            <div class="flex border-b">
                @foreach (var day in _days)
                {
                    var d = day;
                    var isSelected = _selectedDay == d.Date;
                    <button type="button"
                            @onclick="@(() => { _selectedDay = d.Date; _selectedSlot = null; })"
                            class="@Cn.Merge("flex flex-1 flex-col items-center gap-0.5 py-2.5 text-xs transition-colors", isSelected ? "bg-foreground text-background" : "hover:bg-muted/50")">
                        <span class="font-medium">@d.Label</span>
                        <span class="@(isSelected ? "opacity-70" : "text-muted-foreground")">@d.Date.Split(' ')[1]</span>
                        <span class="@Cn.Merge("mt-0.5 text-xs tabular-nums", isSelected ? "opacity-70" : "text-muted-foreground")">@d.Slots slots</span>
                    </button>
                }
            </div>

            @* Time slots *@
            <div class="px-4 py-3">
                <div class="flex flex-wrap gap-2">
                    @foreach (var slot in GetCurrentSlots())
                    {
                        var s = slot;
                        <ButtonCn Variant="@(_selectedSlot == s ? ButtonVariant.Default : ButtonVariant.Outline)"
                                  Size="ButtonSize.Sm"
                                  Class="h-8 font-mono text-xs tabular-nums"
                                  OnClick="@(() => _selectedSlot = s)">@s</ButtonCn>
                    }
                </div>
                @if (_selectedSlot != null)
                {
                    <div class="mt-3 flex items-center gap-3">
                        <SelectCn Value="@_selectedSessionType" ValueChanged="@((string v) => _selectedSessionType = v)">
                            <SelectTriggerCn Class="h-8 flex-1 text-xs">
                                <SelectValueCn Placeholder="Select session type" />
                            </SelectTriggerCn>
                            <SelectContentCn>
                                @foreach (var st in _sessionTypes)
                                {
                                    <SelectItemCn Value="@st.Name" Class="text-xs">@st.Name — @st.Price</SelectItemCn>
                                }
                            </SelectContentCn>
                        </SelectCn>
                        <ButtonCn Size="ButtonSize.Sm" Class="h-8 text-xs">Book session</ButtonCn>
                    </div>
                }
            </div>
        </div>

        @* Insurance *@
        <div class="px-4 py-3">
            <span class="mb-2 flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                <LucideIconCn Name="shield-check" Size="12" Class="size-3" />
                Accepted insurance
            </span>
            <div class="grid grid-cols-2 gap-1.5">
                @foreach (var provider in _insuranceProviders)
                {
                    <div class="flex items-center gap-1.5 text-xs">
                        <LucideIconCn Name="check-circle" Size="12" Class="size-3 shrink-0 text-emerald-500" />
                        <span>@provider</span>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record SessionType(string Name, string Duration, string Price, string Format);
    private record DayItem(string Label, string Date, int Slots);

    private static readonly string[] _specializations =
    [
        "Anxiety & Panic Disorders",
        "PTSD & Trauma",
        "Life Transitions",
        "Depression",
        "Relationship Issues",
        "Grief & Loss",
        "Cultural Identity",
        "Burnout & Stress",
    ];

    private static readonly SessionType[] _sessionTypes =
    [
        new("Initial Consultation", "60 min", "$200", "Video or In-person"),
        new("Individual Therapy", "50 min", "$175", "Video or In-person"),
        new("Couples Therapy", "75 min", "$250", "In-person"),
        new("EMDR Session", "90 min", "$275", "In-person"),
    ];

    private static readonly DayItem[] _days =
    [
        new("Mon", "Mar 17", 3),
        new("Tue", "Mar 18", 5),
        new("Wed", "Mar 19", 2),
        new("Thu", "Mar 20", 4),
        new("Fri", "Mar 21", 1),
    ];

    private static readonly Dictionary<string, string[]> _timeSlots = new()
    {
        ["Mar 17"] = ["9:00 AM", "11:00 AM", "2:00 PM"],
        ["Mar 18"] = ["9:00 AM", "10:00 AM", "1:00 PM", "3:00 PM", "4:00 PM"],
        ["Mar 19"] = ["10:00 AM", "2:00 PM"],
        ["Mar 20"] = ["9:00 AM", "11:00 AM", "1:00 PM", "3:00 PM"],
        ["Mar 21"] = ["10:00 AM"],
    };

    private static readonly string[] _insuranceProviders =
    [
        "Aetna",
        "Blue Cross Blue Shield",
        "Cigna",
        "United Healthcare",
        "Oscar Health",
        "Out-of-network (superbill provided)",
    ];

    private string _selectedDay = "Mar 18";
    private string? _selectedSlot = null;
    private string _selectedSessionType = "";

    private string[] GetCurrentSlots() =>
        _timeSlots.TryGetValue(_selectedDay, out var slots) ? slots : [];
}
