@* ============================================================
   Block: profile-crypto-trader
   Title: ProfileCryptoTrader
   Description: React crypto trader profile block for Next.js with portfolio allocation chart, token holdings list, PnL display, trade history feed, and risk metrics using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-crypto-trader.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="Marcus Wei" />
                <AvatarFallbackCn>MW</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Marcus Wei</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">DeFi researcher and systematic trader. On-chain since 2017. Building quantitative strategies for crypto markets.</p>
            </div>
        </div>

        @* Portfolio summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">$342,180</span>
            </div>
            <div class="flex items-center gap-1.5">
                <span class="font-medium text-emerald-600 text-xs tabular-nums dark:text-emerald-400">+$87,420</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs text-emerald-600 dark:text-emerald-400">
                    +34.3%
                </BadgeCn>
            </div>
            <span class="ml-auto flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">62%</span>
                <span class="text-muted-foreground">win rate</span>
            </span>
        </div>

        @* Allocation bars *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Portfolio allocation</span>
            <div class="flex h-3 overflow-hidden rounded-full">
                @foreach (var h in _holdings)
                {
                    <div class="@Cn.Merge("h-full", h.Color, h.Id != "h1" ? "ml-px" : "")"
                         style="@($"width:{h.Allocation}%")"></div>
                }
            </div>
            <div class="mt-2 flex flex-wrap gap-3">
                @foreach (var h in _holdings)
                {
                    <span class="flex items-center gap-1.5 text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", h.Color)"></span>
                        <span class="text-muted-foreground">@h.Symbol</span>
                        <span class="font-mono tabular-nums">@(h.Allocation)%</span>
                    </span>
                }
            </div>
        </div>

        @* Tabbed content *@
        <TabsCn Value="@_activeTab" ValueChanged="@((string v) => _activeTab = v)" Class="w-full">
            <TabsListCn Class="w-full justify-start border-b px-4">
                <TabsTriggerCn Value="holdings" Class="text-xs">Holdings</TabsTriggerCn>
                <TabsTriggerCn Value="trades" Class="text-xs">Trades</TabsTriggerCn>
            </TabsListCn>

            <TabsContentCn Value="holdings" Class="mt-0">
                @for (var idx = 0; idx < _holdings.Length; idx++)
                {
                    var holding = _holdings[idx];
                    var isLast = idx == _holdings.Length - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                        <span class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50 font-mono font-medium text-xs">@holding.Symbol</span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@holding.Name</span>
                            <span class="block text-muted-foreground text-xs">@holding.Amount @holding.Symbol</span>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="block font-mono text-sm tabular-nums">@holding.Price</span>
                            <span class="@Cn.Merge("flex items-center justify-end gap-0.5 text-xs tabular-nums", holding.Change24h >= 0 ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                @if (holding.Change24h >= 0)
                                {
                                    <LucideIconCn Name="arrow-up" Size="12" Class="size-3" />
                                }
                                else
                                {
                                    <LucideIconCn Name="arrow-down" Size="12" Class="size-3" />
                                }
                                @(Math.Abs(holding.Change24h))%
                            </span>
                        </div>
                    </div>
                }
            </TabsContentCn>

            <TabsContentCn Value="trades" Class="mt-0">
                @for (var idx = 0; idx < _recentTrades.Length; idx++)
                {
                    var trade = _recentTrades[idx];
                    var isLast = idx == _recentTrades.Length - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                        <BadgeCn Variant="@(trade.Type == "buy" ? BadgeVariant.Secondary : BadgeVariant.Outline)"
                                 Class="w-10 justify-center font-mono font-normal text-xs uppercase">
                            @trade.Type
                        </BadgeCn>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@trade.Pair</span>
                            <span class="block text-muted-foreground text-xs">@trade.Amount</span>
                        </div>
                        <div class="shrink-0 text-right">
                            <span class="block font-mono text-xs tabular-nums">@trade.Price</span>
                            @if (!string.IsNullOrEmpty(trade.Pnl))
                            {
                                <span class="font-mono text-emerald-600 text-xs tabular-nums dark:text-emerald-400">@trade.Pnl</span>
                            }
                            else
                            {
                                <span class="text-muted-foreground text-xs">@trade.Time</span>
                            }
                        </div>
                    </div>
                }
            </TabsContentCn>
        </TabsCn>

        @* Risk metrics *@
        <div class="border-t">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Risk metrics</span>
            </div>
            <div class="grid grid-cols-2 gap-px bg-border">
                @foreach (var metric in _riskMetrics)
                {
                    <div class="flex items-center gap-2 bg-card px-4 py-2.5">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", RiskDotColor(metric.Status))"></span>
                        <span class="text-muted-foreground text-xs">@metric.Label</span>
                        <span class="ml-auto font-mono font-medium text-sm tabular-nums">@metric.Value</span>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private string _activeTab = "holdings";

    private record Holding(string Id, string Symbol, string Name, string Amount, string Price, double Change24h, int Allocation, string Color);
    private record Trade(string Id, string Type, string Pair, string Amount, string Price, string Pnl, string Time);
    private record RiskMetric(string Label, string Value, string Status);

    private static readonly Holding[] _holdings =
    [
        new("h1", "BTC",  "Bitcoin",   "1.45",  "$98,420", 2.4,  42, "bg-amber-500"),
        new("h2", "ETH",  "Ethereum",  "24.8",  "$3,840",  -1.2, 28, "bg-blue-500"),
        new("h3", "SOL",  "Solana",    "312",   "$189",    5.7,  17, "bg-purple-500"),
        new("h4", "LINK", "Chainlink", "1,450", "$18.90",  3.1,   8, "bg-blue-400"),
        new("h5", "AAVE", "Aave",      "85",    "$204",    -0.8,  5, "bg-pink-500"),
    ];

    private static readonly Trade[] _recentTrades =
    [
        new("t1", "buy",  "SOL/USDT",  "50 SOL",    "$184.20", "",       "3 hours ago"),
        new("t2", "sell", "ETH/USDT",  "5 ETH",     "$3,920",  "+$1,240","8 hours ago"),
        new("t3", "buy",  "LINK/USDT", "200 LINK",  "$17.40",  "",       "Yesterday"),
        new("t4", "sell", "BTC/USDT",  "0.25 BTC",  "$96,800", "+$3,100","2 days ago"),
        new("t5", "buy",  "AAVE/USDT", "30 AAVE",   "$198",    "",       "3 days ago"),
    ];

    private static readonly RiskMetric[] _riskMetrics =
    [
        new("Sharpe Ratio", "1.84",   "low"),
        new("Max Drawdown", "-18.4%", "medium"),
        new("Volatility",   "32.1%",  "medium"),
        new("Leverage",     "1.0x",   "low"),
    ];

    private static string RiskDotColor(string status) => status switch
    {
        "low"    => "bg-emerald-500",
        "medium" => "bg-amber-500",
        "high"   => "bg-red-500",
        _        => "bg-muted-foreground",
    };
}
