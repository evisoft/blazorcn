@* ============================================================
   Block: profile-photographer-grid
   Title: ProfilePhotographerGrid
   Description: React photographer profile block for Next.js with masonry-style photo grid, camera gear list, booking availability, and shooting stats using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-photographer-grid.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Profile header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="@_profile.Avatar" Alt="@_profile.Name" />
                <AvatarFallbackCn Class="text-lg">LH</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_profile.Name</span>
                    <span class="font-mono text-muted-foreground text-xs">@_profile.Handle</span>
                </div>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">@_profile.Bio</p>
                <div class="mt-2 flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                    @_profile.Location
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Book Session
            </ButtonCn>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="image" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@FormatCount(_profile.TotalShots)</span>
                <span class="text-muted-foreground">photos</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="star" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_profile.Featured</span>
                <span class="text-muted-foreground">featured</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">@FormatCount(_profile.Followers)</span>
                <span class="text-muted-foreground">followers</span>
            </span>
        </div>

        @* Photo grid *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">
                Recent work
            </span>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var photo in _photos)
                {
                    var photoId = photo.Id;
                    <div class="@Cn.Merge("group relative cursor-pointer overflow-hidden rounded-md bg-muted", photo.Tall ? "row-span-2 h-56" : "h-28")"
                         @onmouseenter="@(() => _hoveredPhoto = photoId)"
                         @onmouseleave="@(() => _hoveredPhoto = null)">
                        <div class="flex size-full items-center justify-center text-muted-foreground/30">
                            <LucideIconCn Name="camera" Size="24" Class="size-6" />
                        </div>
                        @if (_hoveredPhoto == photo.Id)
                        {
                            <div class="absolute inset-0 flex flex-col justify-end bg-black/50 p-2.5">
                                <span class="font-medium text-white text-xs">@photo.Title</span>
                                <div class="mt-1 flex items-center gap-2 text-white/70 text-xs">
                                    <span>@photo.Category</span>
                                    <span class="flex items-center gap-0.5">
                                        <LucideIconCn Name="heart" Size="12" Class="size-3" />
                                        @FormatCount(photo.Likes)
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Category breakdown *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Categories</span>
            <div class="space-y-2">
                @foreach (var cat in _categories)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-20 text-xs">@cat.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="@($"width:{cat.Percent}%")"></div>
                        </div>
                        <span class="w-8 text-right font-mono text-muted-foreground text-xs tabular-nums">
                            @(cat.Percent)%
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Gear *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Gear</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var gearItem in _gear)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <LucideIconCn Name="aperture" Size="12" Class="size-3" />
                        @gearItem.Name
                    </BadgeCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ProfileData(string Name, string Handle, string Avatar, string Bio, string Location, int TotalShots, int Featured, int Followers);
    private record PhotoItem(string Id, string Title, string Category, int Likes, bool Tall);
    private record GearItem(string Name, string Type);
    private record CategoryItem(string Name, int Count, int Percent);

    private static readonly ProfileData _profile = new(
        "Lena Hartmann",
        "@lenahartmann",
        "",
        "Documentary & portrait photographer. National Geographic contributor. Available for editorial and commercial work worldwide.",
        "Berlin, Germany",
        14200,
        38,
        92400
    );

    private static readonly PhotoItem[] _photos =
    [
        new("1", "Morning Fog, Dolomites", "Landscape", 2840, true),
        new("2", "Street Market, Marrakech", "Street", 1920, false),
        new("3", "Ballet Rehearsal", "Portrait", 3100, false),
        new("4", "Kyoto Bamboo Grove", "Travel", 4500, true),
        new("5", "Industrial Symmetry", "Architecture", 1340, false),
        new("6", "Monsoon Season, Kerala", "Documentary", 2680, true),
    ];

    private static readonly GearItem[] _gear =
    [
        new("Sony A7R V", "Body"),
        new("24-70mm f/2.8 GM", "Lens"),
        new("85mm f/1.4 GM", "Lens"),
        new("14mm f/1.8 GM", "Lens"),
    ];

    private static readonly CategoryItem[] _categories =
    [
        new("Portrait", 3420, 24),
        new("Landscape", 2840, 20),
        new("Documentary", 2560, 18),
        new("Street", 2130, 15),
        new("Travel", 1988, 14),
        new("Architecture", 1262, 9),
    ];

    private string? _hoveredPhoto;

    private static string FormatCount(int n)
    {
        if (n >= 1000) return $"{(n / 1000.0):0.0}k";
        return n.ToString();
    }
}
