@* ============================================================
   Block: profile-tutor-subjects
   Title: ProfileTutorSubjects
   Description: React tutor profile block for Next.js with subject expertise levels, session availability, student success metrics, teaching methodology, and hourly rates using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-tutor-subjects.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Daniel Park" />
                <AvatarFallbackCn Class="text-lg">DP</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Daniel Park</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="star" Size="12" Class="mr-1 size-3 fill-amber-500 text-amber-500" />
                        4.9 (148)
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Math &amp; Science Tutor</span>
                <div class="mt-0.5 flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="graduation-cap" Size="12" Class="size-3" />
                    M.S. Applied Mathematics, UCLA
                </div>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        San Diego, CA
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                        96% success rate
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Book
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">320</span>
                <span class="text-muted-foreground">students helped</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="book-open" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">5</span>
                <span class="text-muted-foreground">subjects</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-xs">
                <span class="font-medium tabular-nums">6</span>
                <span class="text-muted-foreground"> years</span>
            </span>
        </div>

        @* Subject expertise *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Subject Expertise</span>
            </div>
            @for (var i = 0; i < _subjects.Length; i++)
            {
                var subject = _subjects[i];
                var isLast = i == _subjects.Length - 1;
                <div class="@(isLast ? "px-4 py-3" : "border-b px-4 py-3")">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <span class="@($"size-1.5 rounded-full {subject.Color}")"></span>
                            <span class="font-medium text-sm">@subject.Name</span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                                @subject.Level
                            </BadgeCn>
                        </div>
                        <span class="font-medium text-sm tabular-nums">$@(subject.Rate)/hr</span>
                    </div>
                    <div class="mt-1.5 flex items-center gap-2">
                        <ProgressCn Value="@subject.Proficiency" Class="h-1.5 flex-1" aria-label="Progress" />
                        <span class="font-mono text-muted-foreground text-xs tabular-nums">@(subject.Proficiency)%</span>
                    </div>
                </div>
            }
        </div>

        @* Success metrics *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Student Outcomes</span>
            <div class="grid grid-cols-2 gap-2">
                @foreach (var metric in _successMetrics)
                {
                    <div class="rounded-md bg-muted/50 p-2 text-center">
                        <span class="block font-semibold text-sm">@metric.Value</span>
                        <span class="text-muted-foreground text-xs">@metric.Label</span>
                    </div>
                }
            </div>
        </div>

        @* Availability + Methodology *@
        <div class="flex gap-0 divide-x border-b">
            <div class="flex-1 px-4 py-3">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">Availability</span>
                <div class="space-y-1">
                    @foreach (var avail in _availability)
                    {
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">@avail.Day</span>
                            <span class="font-medium">@avail.Hours</span>
                        </div>
                    }
                </div>
            </div>
            <div class="flex-1 px-4 py-3">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">Methodology</span>
                <div class="flex flex-wrap gap-1">
                    @foreach (var method in _methodology)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@method</BadgeCn>
                    }
                </div>
            </div>
        </div>

        @* Reviews *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Reviews</span>
            <div class="space-y-2">
                @foreach (var review in _reviews)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-sm leading-relaxed">"@review.Text"</p>
                        <span class="mt-2 block font-medium text-muted-foreground text-xs">@review.Name</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Subject(string Name, string Level, int Proficiency, int Rate, string Color);
    private record AvailabilitySlot(string Day, string Hours);
    private record SuccessMetric(string Label, string Value);
    private record Review(string Name, int Rating, string Text);

    private static readonly Subject[] _subjects =
    [
        new("Calculus", "AP/College", 98, 75, "bg-blue-500"),
        new("Physics", "AP/College", 95, 75, "bg-purple-500"),
        new("Statistics", "AP/College", 92, 70, "bg-emerald-500"),
        new("Algebra", "Middle/High School", 99, 60, "bg-amber-500"),
        new("Chemistry", "High School", 85, 65, "bg-red-500"),
    ];

    private static readonly AvailabilitySlot[] _availability =
    [
        new("Mon-Fri", "3:00 PM - 9:00 PM"),
        new("Saturday", "10:00 AM - 6:00 PM"),
        new("Sunday", "12:00 PM - 5:00 PM"),
    ];

    private static readonly string[] _methodology =
    [
        "Socratic Method",
        "Visual Learning",
        "Practice-Based",
        "Spaced Repetition",
        "Growth Mindset",
    ];

    private static readonly SuccessMetric[] _successMetrics =
    [
        new("Grade improvement", "+1.4 GPA avg"),
        new("Test score improvement", "+180 SAT avg"),
        new("Student retention", "92%"),
        new("Parent satisfaction", "4.9/5"),
    ];

    private static readonly Review[] _reviews =
    [
        new("Parent of Ethan K.", 5, "Daniel helped my son go from a C to an A in AP Calculus in just two months."),
        new("College Student, Amy L.", 5, "Finally understood organic chemistry. Daniel explains concepts in a way that actually makes sense."),
    ];
}
