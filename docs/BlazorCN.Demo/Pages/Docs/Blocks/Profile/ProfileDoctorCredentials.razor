@* ============================================================
   Block: profile-doctor-credentials
   Title: ProfileDoctorCredentials
   Description: React doctor credentials profile block for Next.js with medical specialties, board certifications, education timeline, hospital affiliations, and patient rating display using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-doctor-credentials.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Dr. Sarah Kim, MD, FACC" />
                <AvatarFallbackCn Class="text-lg">SK</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Dr. Sarah Kim, MD, FACC</span>
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-blue-500" />
                </div>
                <span class="text-muted-foreground text-sm">Interventional Cardiology</span>
                <div class="mt-1.5 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="building" Size="12" Class="size-3" />
                        Northwestern Memorial Hospital
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Chicago, IL
                    </span>
                </div>
                <div class="mt-1 flex items-center gap-3 text-xs">
                    <span class="flex items-center gap-1 text-muted-foreground">
                        <LucideIconCn Name="clock" Size="12" Class="size-3" />
                        18 years experience
                    </span>
                    <span class="text-muted-foreground">·</span>
                    <span class="flex items-center gap-1 text-emerald-600 dark:text-emerald-400">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        Accepting patients
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                <LucideIconCn Name="phone" Size="12" Class="mr-1 size-3" />
                Contact
            </ButtonCn>
        </div>

        @* Rating *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">4.8</span>
                    <span class="text-muted-foreground text-xs">/5</span>
                </div>
                <div class="flex items-center gap-0.5">
                    @for (var i = 0; i < 5; i++)
                    {
                        var idx = i;
                        <LucideIconCn Name="star" Size="14" Class="@(Cn.Merge("size-3.5", idx < 5 ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30"))" />
                    }
                </div>
                <span class="text-muted-foreground text-xs">(342 reviews)</span>
            </div>
            <div class="mt-2 grid grid-cols-2 gap-2">
                @foreach (var item in _ratingBreakdown)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@item.Label</span>
                        <span class="font-medium tabular-nums">@item.Score</span>
                    </div>
                }
            </div>
        </div>

        @* Board Certifications *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Board Certifications
            </span>
            <div class="space-y-2">
                @foreach (var cert in _certifications)
                {
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="shield-check" Size="16" Class="size-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@cert.Name</span>
                            <span class="ml-2 text-muted-foreground text-xs">@cert.Board, @cert.Year</span>
                        </div>
                        @if (cert.Verified)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 gap-1 px-1.5 font-normal text-[10px]">
                                <LucideIconCn Name="check-circle-2" Size="10" Class="size-2.5" />
                                Verified
                            </BadgeCn>
                        }
                    </div>
                }
            </div>
        </div>

        @* Education - expandable *@
        <div class="border-b">
            <button type="button" @onclick="@(() => _showEducation = !_showEducation)"
                class="flex w-full items-center gap-2 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <LucideIconCn Name="graduation-cap" Size="16" Class="size-4 text-muted-foreground" />
                <span class="flex-1 font-medium text-sm">Education &amp; Training</span>
                <span class="text-muted-foreground text-xs">@(_education.Length) entries</span>
                <LucideIconCn Name="chevron-right" Size="16" Class="@(Cn.Merge("size-4 text-muted-foreground/60 transition-transform duration-200", _showEducation ? "rotate-90" : ""))" />
            </button>
            @if (_showEducation)
            {
                <div class="relative border-t px-4 py-3">
                    <div class="absolute top-0 bottom-0 left-[29px] w-px bg-border"></div>
                    <div class="space-y-4">
                        @foreach (var edu in _education)
                        {
                            <div class="relative pl-6">
                                <span class="absolute left-0 top-1.5 size-2 rounded-full bg-foreground/40"></span>
                                <span class="font-medium text-sm">@edu.Institution</span>
                                <div class="mt-0.5 text-muted-foreground text-xs">@edu.Degree</div>
                                <span class="text-muted-foreground text-xs">@edu.Years</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Affiliations *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Hospital Affiliations
            </span>
            <div class="space-y-2">
                @foreach (var aff in _affiliations)
                {
                    <div class="flex items-center gap-3 rounded-md bg-muted/50 p-3">
                        <LucideIconCn Name="building" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@aff.Hospital</span>
                            <span class="mt-0.5 block text-muted-foreground text-xs">@aff.Role — @aff.Department</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Insurance *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Accepted Insurance
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var ins in _insurance)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@ins</BadgeCn>
                }
            </div>
            <div class="mt-2 text-muted-foreground text-xs">NPI: 1234567890</div>
        </div>

    </div>
</section>

@code {
    private record CertItem(string Name, string Board, string Year, bool Verified);
    private record EducationItem(string Institution, string Degree, string Years);
    private record AffiliationItem(string Hospital, string Role, string Department);
    private record RatingItem(string Label, double Score);

    private bool _showEducation = false;

    private static readonly RatingItem[] _ratingBreakdown = [
        new("Bedside manner", 4.9),
        new("Wait time", 4.5),
        new("Explains conditions", 4.8),
        new("Staff friendliness", 4.7),
    ];

    private static readonly CertItem[] _certifications = [
        new("Internal Medicine", "ABIM", "2008", true),
        new("Cardiovascular Disease", "ABIM", "2011", true),
        new("Interventional Cardiology", "ABIM", "2013", true),
    ];

    private static readonly EducationItem[] _education = [
        new("Johns Hopkins School of Medicine", "MD", "2002 - 2006"),
        new("Massachusetts General Hospital", "Residency, Internal Medicine", "2006 - 2009"),
        new("Cleveland Clinic", "Fellowship, Cardiology", "2009 - 2012"),
        new("Cedars-Sinai Medical Center", "Fellowship, Interventional", "2012 - 2013"),
    ];

    private static readonly AffiliationItem[] _affiliations = [
        new("Northwestern Memorial Hospital", "Attending Physician", "Cardiology"),
        new("Ann & Robert H. Lurie Children's", "Consulting Physician", "Pediatric Cardiology"),
    ];

    private static readonly string[] _insurance = [
        "Blue Cross Blue Shield",
        "Aetna",
        "UnitedHealthcare",
        "Cigna",
        "Medicare",
        "Humana",
    ];
}
