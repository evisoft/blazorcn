@* ============================================================
   Block: profile-portfolio-showcase
   Title: ProfilePortfolioShowcase
   Description: React creative portfolio profile block for Next.js with two-panel layout, skills tags, project grid cards, and category filters using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-portfolio-showcase.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-col md:flex-row">

            @* Left sidebar *@
            <div class="w-full border-b px-5 py-5 md:w-64 md:shrink-0 md:border-r md:border-b-0">
                <div class="flex flex-col items-center text-center md:items-start md:text-left">
                    <AvatarCn Class="size-16">
                        <AvatarImageCn Src="" Alt="Priya Sharma" />
                        <AvatarFallbackCn Class="text-lg">PS</AvatarFallbackCn>
                    </AvatarCn>
                    <span class="mt-3 font-medium text-sm">Priya Sharma</span>
                    <span class="text-muted-foreground text-xs">Product Designer</span>
                    <p class="mt-2 text-muted-foreground text-xs leading-relaxed">Crafting digital experiences for startups and enterprises. 8 years shipping products users love.</p>

                    <div class="mt-3 flex items-center gap-3 text-muted-foreground text-xs">
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="globe" Size="12" Class="size-3" />
                            priyasharma.design
                        </span>
                    </div>

                    <div class="mt-4 flex flex-wrap gap-1.5">
                        @foreach (var skill in _skills)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@skill</BadgeCn>
                        }
                    </div>

                    <div class="mt-4 flex w-full gap-2">
                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 flex-1 gap-1 text-xs">
                            <LucideIconCn Name="mail" Size="12" Class="size-3" />
                            Contact
                        </ButtonCn>
                    </div>
                </div>
            </div>

            @* Right panel — projects *@
            <div class="min-w-0 flex-1">
                @* Category filter *@
                <div class="flex items-center gap-1 border-b px-4 py-2.5">
                    @foreach (var cat in _categories)
                    {
                        var catItem = cat;
                        <ButtonCn
                            Variant="@(_activeCategory == catItem ? ButtonVariant.Secondary : ButtonVariant.Ghost)"
                            Size="ButtonSize.Sm"
                            Class="h-6 px-2.5 text-xs"
                            OnClick="@(() => _activeCategory = catItem)">
                            @catItem
                        </ButtonCn>
                    }
                    <span class="ml-auto text-muted-foreground text-xs tabular-nums">
                        @FilteredProjects().Count projects
                    </span>
                </div>

                @* Project grid *@
                <div class="grid grid-cols-1 gap-px bg-border sm:grid-cols-2">
                    @foreach (var project in FilteredProjects())
                    {
                        <div class="group bg-card p-4 transition-colors hover:bg-muted/50">
                            @* Image placeholder *@
                            <div class="mb-3 h-24 rounded-md bg-muted/50"></div>
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0 flex-1">
                                    <span class="font-medium text-sm">@project.Title</span>
                                    <p class="mt-0.5 text-muted-foreground text-xs">@project.Description</p>
                                </div>
                                <LucideIconCn Name="arrow-up-right" Size="14" Class="size-3.5 shrink-0 text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100" />
                            </div>
                            <div class="mt-2 flex items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@project.Category</BadgeCn>
                                <span class="text-muted-foreground text-xs">@project.Year</span>
                            </div>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</section>

@code {
    private record ProjectItem(string Id, string Title, string Category, string Description, string Year);

    private string _activeCategory = "All";

    private static readonly string[] _skills =
    [
        "UI Design",
        "Design Systems",
        "Prototyping",
        "User Research",
        "Figma",
        "Framer",
        "React",
        "Motion Design",
    ];

    private static readonly string[] _categories = ["All", "Web", "Mobile", "Branding"];

    private static readonly ProjectItem[] _projects =
    [
        new("1", "Finley Banking App", "Mobile", "Personal finance dashboard with investment tracking", "2025"),
        new("2", "Notion Redesign", "Web", "Concept redesign of the workspace navigation", "2025"),
        new("3", "Meridian Brand", "Branding", "Full identity system for a wellness startup", "2024"),
        new("4", "DevFlow CLI", "Web", "Documentation site for a developer CLI tool", "2024"),
        new("5", "Pulse Health", "Mobile", "Health monitoring app with wearable integration", "2024"),
        new("6", "Atlas Maps", "Web", "Interactive mapping platform for logistics", "2023"),
    ];

    private List<ProjectItem> FilteredProjects() =>
        _activeCategory == "All"
            ? [.. _projects]
            : [.. _projects.Where(p => p.Category == _activeCategory)];
}
