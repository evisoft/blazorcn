@* ============================================================
   Block: profile-scrum-master
   Title: ProfileScrumMaster
   Description: React scrum master profile block for Next.js with team velocity chart, sprint metrics, ceremony facilitation stats, impediment resolution tracking, and certification badges using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-scrum-master.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarFallbackCn Class="text-lg">SA</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_scrumMaster.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="target" Size="12" Class="mr-1 size-3" />
                        @_scrumMaster.AvgVelocity avg velocity
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">@_scrumMaster.Title</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span>@_scrumMaster.Company</span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        @_scrumMaster.Location
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Connect
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_scrumMaster.Teams</span>
                <span class="text-muted-foreground">teams</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="zap" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_scrumMaster.SprintsCompleted</span>
                <span class="text-muted-foreground">sprints</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_scrumMaster.ImpedimentResolution%</span>
                <span class="text-muted-foreground">resolved</span>
            </span>
        </div>

        @* Velocity chart *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">
                Team Velocity (Story Points)
            </span>
            <div class="flex items-end gap-2">
                @foreach (var sprint in _velocity)
                {
                    var heightPx = (int)Math.Round((sprint.Completed / (double)_maxPoints) * 60);
                    if (heightPx < 4) heightPx = 4;
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <div class="w-full rounded-sm bg-foreground/20" style="height: @(heightPx)px; min-height: 4px;"></div>
                        <span class="font-mono text-muted-foreground text-xs tabular-nums">@sprint.Completed</span>
                        <span class="text-muted-foreground text-xs">@sprint.Sprint</span>
                    </div>
                }
            </div>
        </div>

        @* Ceremonies *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Ceremony Facilitation</span>
            </div>
            @for (var i = 0; i < _ceremonies.Length; i++)
            {
                var ceremony = _ceremonies[i];
                var isLast = i == _ceremonies.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="font-medium text-sm">@ceremony.Name</span>
                    <div class="flex items-center gap-3 text-muted-foreground text-xs">
                        <span>@ceremony.AvgDuration</span>
                        <span>·</span>
                        <span class="tabular-nums">@ceremony.Attendance% attendance</span>
                    </div>
                </div>
            }
        </div>

        @* Impediments *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Current Impediments</span>
            </div>
            @for (var i = 0; i < _impediments.Length; i++)
            {
                var imp = _impediments[i];
                var isLast = i == _impediments.Length - 1;
                var dotColor = imp.Status == "resolved" ? "bg-emerald-500" : "bg-amber-500";
                var statusLabel = imp.Status == "resolved" ? "Resolved" : $"Open {imp.DaysOpen}d";
                <div class="@Cn.Merge("px-4 py-2.5", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-2">
                        <span class="@Cn.Merge("size-1.5 rounded-full", dotColor)"></span>
                        <span class="font-medium text-sm">@imp.Description</span>
                    </div>
                    <div class="mt-0.5 flex items-center gap-2 pl-3.5 text-muted-foreground text-xs">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                            @imp.Category
                        </BadgeCn>
                        <span>@statusLabel</span>
                    </div>
                </div>
            }
        </div>

        @* Certifications *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Certifications
            </span>
            <div class="space-y-1.5">
                @foreach (var cert in _certifications)
                {
                    <div class="flex items-center gap-2 text-xs">
                        <LucideIconCn Name="award" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        <span>@cert</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ScrumMasterInfo(string Name, string Title, string Company, string Location, int Teams, int SprintsCompleted, int AvgVelocity, int ImpedimentResolution);
    private record SprintVelocity(string Sprint, int Planned, int Completed);
    private record CeremonyItem(string Name, string AvgDuration, int Attendance);
    private record ImpedimentItem(string Id, string Description, string Category, int DaysOpen, string Status);

    private static readonly ScrumMasterInfo _scrumMaster = new(
        "Sofia Andersen",
        "Certified Scrum Master",
        "Nexus Digital",
        "Copenhagen, DK",
        3,
        124,
        42,
        96
    );

    private static readonly string[] _certifications =
    [
        "CSM (Certified Scrum Master)",
        "SAFe 6 Scrum Master",
        "PSM II (Professional Scrum Master)",
        "ICAgile Certified Professional",
    ];

    private static readonly SprintVelocity[] _velocity =
    [
        new("S18", 40, 38),
        new("S19", 42, 42),
        new("S20", 45, 40),
        new("S21", 42, 44),
        new("S22", 44, 42),
        new("S23", 43, 41),
    ];

    private const int _maxPoints = 50;

    private static readonly CeremonyItem[] _ceremonies =
    [
        new("Sprint Planning", "1.5 hrs", 98),
        new("Daily Standup", "12 min", 96),
        new("Sprint Review", "1 hr", 94),
        new("Retrospective", "45 min", 97),
    ];

    private static readonly ImpedimentItem[] _impediments =
    [
        new("i1", "CI/CD pipeline instability causing deployment delays", "Infrastructure", 0, "resolved"),
        new("i2", "API team dependency blocking frontend stories", "Cross-team", 2, "open"),
        new("i3", "Missing design specs for settings module", "Design", 0, "resolved"),
        new("i4", "Third-party vendor SDK update breaking tests", "External", 1, "open"),
    ];
}
