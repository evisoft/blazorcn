@* ============================================================
   Block: profile-videographer-portfolio
   Title: ProfileVideographerPortfolio
   Description: React videographer portfolio profile block for Next.js with video project cards, equipment list, genre specialties, client testimonials, and booking rates using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-videographer-portfolio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Marco Reyes" />
                <AvatarFallbackCn Class="text-lg">MR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Marco Reyes</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="star" Size="12" Class="mr-1 size-3 fill-amber-500 text-amber-500" />
                        4.9
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Cinematographer &amp; Director of Photography</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Miami, FL
                    </span>
                    <span>&middot;</span>
                    <span>11 years</span>
                    <span>&middot;</span>
                    <span class="tabular-nums">280 projects</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Hire
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="film" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">280</span>
                <span class="text-muted-foreground">projects</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="eye" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">45M</span>
                <span class="text-muted-foreground">total views</span>
            </span>
        </div>

        @* Genres *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Genre Specialties</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var g in _genres)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", g.Color)"></span>
                        @g.Name
                    </BadgeCn>
                }
            </div>
        </div>

        @* Projects *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Featured Projects</span>
            </div>
            @for (var i = 0; i < _projects.Length; i++)
            {
                var project = _projects[i];
                var isLast = i == _projects.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="play" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@project.Title</span>
                            </div>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@project.Client</span>
                                <span>&middot;</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                                    @project.Category
                                </BadgeCn>
                                <span>&middot;</span>
                                <span>@project.Duration</span>
                            </div>
                        </div>
                        <span class="shrink-0 flex items-center gap-1 text-muted-foreground text-xs tabular-nums">
                            <LucideIconCn Name="eye" Size="12" Class="size-3" />
                            @FormatViews(project.Views)
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Rates *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Rates</span>
            </div>
            @for (var i = 0; i < _rates.Length; i++)
            {
                var rate = _rates[i];
                var isLast = i == _rates.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b")">
                    <span class="font-medium text-sm">@rate.Service</span>
                    <span class="font-medium text-sm tabular-nums">@rate.Rate</span>
                </div>
            }
        </div>

        @* Equipment *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Equipment</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var eq in _equipment)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@eq</BadgeCn>
                }
            </div>
        </div>

        @* Testimonials *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Client Testimonials</span>
            <div class="space-y-2">
                @foreach (var t in _testimonials)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-sm leading-relaxed">@("\"")@t.Text@("\"")</p>
                        <span class="mt-2 block font-medium text-muted-foreground text-xs">@t.Name</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record GenreItem(string Name, string Color);
    private record VideoProject(string Id, string Title, string Client, string Category, long Views, string Duration, string Year);
    private record RateItem(string Service, string Rate);
    private record Testimonial(string Name, string Text);

    private static readonly GenreItem[] _genres =
    [
        new("Commercial", "bg-blue-500"),
        new("Music Video", "bg-pink-500"),
        new("Documentary", "bg-emerald-500"),
        new("Wedding", "bg-amber-500"),
        new("Corporate", "bg-purple-500"),
        new("Real Estate", "bg-cyan-500"),
    ];

    private static readonly VideoProject[] _projects =
    [
        new("v1", "Summer Campaign Launch", "Nike", "Commercial", 8400000, "1:30", "2026"),
        new("v2", "Echoes (Official Music Video)", "Luna Sol", "Music Video", 12200000, "4:22", "2025"),
        new("v3", "Taste of Miami", "Tourism Board", "Documentary", 2800000, "28:00", "2025"),
        new("v4", "Brand Story Series", "Tech Startup", "Corporate", 640000, "3:15", "2025"),
    ];

    private static readonly RateItem[] _rates =
    [
        new("Half-day shoot (4 hrs)", "$2,500"),
        new("Full-day shoot (8 hrs)", "$4,500"),
        new("Music video package", "$8,000 - $15,000"),
        new("Commercial production", "$12,000 - $35,000"),
    ];

    private static readonly string[] _equipment =
    [
        "RED V-Raptor",
        "Sony FX6",
        "DJI Ronin 4D",
        "Aputure 600d Pro",
        "Sigma Cine Lenses",
        "DJI Inspire 3",
        "Sennheiser MKH 416",
    ];

    private static readonly Testimonial[] _testimonials =
    [
        new("Creative Director, Nike", "Marco's eye for cinematic storytelling elevated our campaign beyond expectations. Every frame was intentional."),
        new("Luna Sol, Artist", "The music video Marco shot has been our most successful release ever. His creative vision is extraordinary."),
    ];

    private static string FormatViews(long n)
    {
        if (n >= 1_000_000) return $"{(n / 1_000_000.0):F1}M";
        if (n >= 1_000) return $"{(n / 1_000.0):F0}K";
        return n.ToString();
    }
}
