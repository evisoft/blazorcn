@* ============================================================
   Block: profile-travel-blogger
   Title: ProfileTravelBlogger
   Description: React travel blogger profile block for Next.js with destination grid, country count map, trip timeline, and travel stats using shadcn/ui, Tailwind CSS, and framer-motion entrance animations
   Source: original/blocks/profile/profile-travel-blogger.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Blogger header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Lina Torres" />
                <AvatarFallbackCn Class="text-lg">LT</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Lina Torres</span>
                    <span class="text-muted-foreground text-xs">@@linaexplores</span>
                </div>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">Full-time traveler and storyteller. 47 countries and counting. Slow travel advocate. Currently in Lisbon.</p>
                <div class="mt-2 flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideMapPinCn Size="12" Class="size-3" />
                    Lisbon, Portugal
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                <LucideHeartCn Size="12" Class="mr-1 size-3" />
                Follow
            </ButtonCn>
        </div>

        @* Stats bar *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideGlobeCn Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-semibold tabular-nums">47</span>
                <span class="text-muted-foreground">countries</span>
            </span>
            <span class="text-muted-foreground text-xs">&#183;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">128.4k</span>
                <span class="text-muted-foreground">followers</span>
            </span>
            <span class="text-muted-foreground text-xs">&#183;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">842</span>
                <span class="text-muted-foreground">posts</span>
            </span>
            <div class="ml-auto flex items-center gap-2">
                @foreach (var cat in _categoryColors)
                {
                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", cat.Color)"></span>
                        <span class="capitalize">@cat.Name</span>
                    </span>
                }
            </div>
        </div>

        @* Destinations / Continent tabs *@
        <TabsCn DefaultValue="destinations" Class="w-full">
            <div class="border-b px-4 py-1">
                <TabsListCn Class="h-8 bg-transparent p-0">
                    <TabsTriggerCn Value="destinations" Class="h-7 text-xs">
                        <LucideCompassCn Size="12" Class="mr-1 size-3" />
                        Recent trips
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="continents" Class="h-7 text-xs">
                        <LucidePlaneCn Size="12" Class="mr-1 size-3" />
                        By continent
                    </TabsTriggerCn>
                </TabsListCn>
            </div>

            <TabsContentCn Value="destinations" Class="mt-0">
                @for (var i = 0; i < _destinations.Length; i++)
                {
                    var dest = _destinations[i];
                    var dotColor = _categoryColorMap.TryGetValue(dest.Category, out var dc) ? dc : "bg-gray-500";
                    <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", i < _destinations.Length - 1 ? "border-b" : "")">
                        <span class="@Cn.Merge("mt-1 size-1.5 shrink-0 rounded-full", dotColor)"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@dest.City, @dest.Country</span>
                                <span class="font-mono text-muted-foreground text-xs">@dest.Flag</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@dest.Highlight</p>
                            <div class="mt-1 flex items-center gap-2 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideCalendarCn Size="12" Class="size-3" />
                                    @dest.Visited
                                </span>
                                <span>&#183;</span>
                                <span>@dest.Duration</span>
                            </div>
                        </div>
                    </div>
                }
            </TabsContentCn>

            <TabsContentCn Value="continents" Class="mt-0 px-4 py-3">
                <div class="space-y-3">
                    @foreach (var continent in _continentStats)
                    {
                        var pct = (int)Math.Round((continent.Visited / (double)continent.Total) * 100);
                        <div>
                            <div class="flex items-center justify-between text-xs">
                                <span class="font-medium text-sm">@continent.Name</span>
                                <span class="text-muted-foreground">
                                    <span class="font-medium tabular-nums">@continent.Visited</span>
                                    <span> / @continent.Total countries</span>
                                </span>
                            </div>
                            <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground/70" style="@($"width:{pct}%")"></div>
                            </div>
                        </div>
                    }
                </div>
                <div class="mt-4 flex items-center gap-2 rounded-md bg-muted/50 p-3">
                    <LucideGlobeCn Size="16" Class="size-4 text-muted-foreground" />
                    <span class="text-sm">
                        <span class="font-semibold tabular-nums">47</span>
                        <span class="text-muted-foreground"> of 195 countries visited</span>
                    </span>
                    <span class="ml-auto font-mono text-muted-foreground text-xs tabular-nums">@(Math.Round((47.0 / 195.0) * 100))%</span>
                </div>
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private record Destination(string Id, string Country, string City, string Flag, string Visited, string Duration, string Highlight, string Category);
    private record ContinentStat(string Name, int Visited, int Total);
    private record CategoryColor(string Name, string Color);

    private static readonly Destination[] _destinations =
    [
        new("d1", "Japan", "Kyoto", "JP", "Oct 2025", "3 weeks", "Fushimi Inari at dawn, zero crowds", "culture"),
        new("d2", "Peru", "Cusco", "PE", "Jul 2025", "2 weeks", "Inca Trail to Machu Picchu", "adventure"),
        new("d3", "Morocco", "Marrakech", "MA", "Apr 2025", "10 days", "Lost in the medina, best tagine ever", "food"),
        new("d4", "New Zealand", "Queenstown", "NZ", "Jan 2025", "4 weeks", "Milford Sound kayaking in rain", "nature"),
        new("d5", "Portugal", "Lisbon", "PT", "Dec 2024", "Ongoing", "Pasteis de Belem every Sunday morning", "food"),
        new("d6", "Iceland", "Reykjavik", "IS", "Aug 2024", "12 days", "Northern lights from a hot spring", "nature"),
    ];

    private static readonly ContinentStat[] _continentStats =
    [
        new("Europe", 18, 44),
        new("Asia", 12, 48),
        new("South America", 7, 12),
        new("Africa", 5, 54),
        new("North America", 3, 23),
        new("Oceania", 2, 14),
    ];

    private static readonly CategoryColor[] _categoryColors =
    [
        new("adventure", "bg-amber-500"),
        new("culture", "bg-purple-500"),
        new("food", "bg-emerald-500"),
        new("nature", "bg-blue-500"),
    ];

    private static readonly Dictionary<string, string> _categoryColorMap = new()
    {
        ["adventure"] = "bg-amber-500",
        ["culture"] = "bg-purple-500",
        ["food"] = "bg-emerald-500",
        ["nature"] = "bg-blue-500",
    };
}
