@* ============================================================
   Block: profile-electrician-services
   Title: ProfileElectricianServices
   Description: React electrician profile block for Next.js with service menu, certification badges, job history, and availability calendar using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-electrician-services.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="Mike Rodriguez" />
                <AvatarFallbackCn>MR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Mike Rodriguez</span>
                    <span class="size-3 rounded-full border-2 border-card bg-emerald-500"></span>
                </div>
                <span class="text-muted-foreground text-xs">Licensed Master Electrician</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">NEC-certified master electrician with 18 years of residential and commercial experience. Specializing in smart home installations, EV charger setups, and panel upgrades.</p>
                <div class="mt-1.5 flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                    Austin, TX
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 gap-1 text-xs">
                <LucideIconCn Name="phone" Size="12" Class="size-3" />
                Call
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="wrench" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">2,840</span>
                <span class="text-muted-foreground">jobs</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="star" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">4.9</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">&lt; 2 hrs</span>
                <span class="text-muted-foreground">response</span>
            </span>
        </div>

        @* Certifications *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Certifications</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var cert in _certifications)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                        <LucideIconCn Name="badge-check" Size="12" Class="size-3" />
                        @cert
                    </BadgeCn>
                }
            </div>
        </div>

        @* Services & Pricing *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Services &amp; Pricing</span>
            </div>
            @for (var i = 0; i < _services.Length; i++)
            {
                var svc = _services[i];
                var isLast = i == _services.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@svc.Name</span>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@svc.Category</BadgeCn>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                    @svc.TimeEstimate
                                </span>
                            </div>
                        </div>
                        <span class="shrink-0 font-medium text-sm tabular-nums">@svc.PriceRange</span>
                    </div>
                </div>
            }
        </div>

        @* Recent Jobs *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent Jobs</span>
            </div>
            @for (var i = 0; i < _recentJobs.Length; i++)
            {
                var job = _recentJobs[i];
                var isLast = i == _recentJobs.Length - 1;
                <div class="@(Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b"))">
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 shrink-0 text-emerald-500" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@job.Client</span>
                        <p class="text-muted-foreground text-xs">@job.Service</p>
                    </div>
                    <div class="flex items-center gap-0.5">
                        @for (var s = 0; s < job.Rating; s++)
                        {
                            <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ServiceItem(string Id, string Name, string Category, string PriceRange, string TimeEstimate);
    private record RecentJob(string Client, string Service, int Rating);

    private static readonly string[] _certifications = ["Master Electrician", "NEC Certified", "OSHA 30", "EV Charger Installer", "Smart Home Pro"];

    private static readonly ServiceItem[] _services =
    [
        new("s1", "Panel Upgrade (100A to 200A)", "Electrical Panel", "$1,800 - $3,200", "4-6 hours"),
        new("s2", "EV Charger Installation", "EV", "$800 - $1,500", "2-4 hours"),
        new("s3", "Whole-Home Smart Wiring", "Smart Home", "$3,000 - $8,000", "2-3 days"),
        new("s4", "Outlet & Switch Replacement", "General", "$85 - $150/ea", "30-60 min"),
        new("s5", "Ceiling Fan Installation", "General", "$150 - $350", "1-2 hours"),
    ];

    private static readonly RecentJob[] _recentJobs =
    [
        new("Johnson Residence", "200A Panel Upgrade", 5),
        new("Cedar Park Office", "Commercial Rewiring", 5),
        new("Tesla Charger Install", "Level 2 EV Charger", 5),
    ];
}
