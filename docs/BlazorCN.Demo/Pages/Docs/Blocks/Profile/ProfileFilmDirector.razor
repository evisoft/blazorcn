@* ============================================================
   Block: profile-film-director
   Title: ProfileFilmDirector
   Description: React film director profile block for Next.js with filmography list, award nominations, box office stats, and genre specialization using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-film-director.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="Sofia Laurent" />
                <AvatarFallbackCn>SL</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Sofia Laurent</span>
                <p class="text-muted-foreground text-xs">Film Director &amp; Screenwriter</p>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">Two-time Cannes Palme d'Or nominee. Known for atmospheric character-driven dramas. Films distributed in 40+ countries with $180M+ combined worldwide gross.</p>
            </div>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="film" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">8</span>
                <span class="text-muted-foreground">films</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="trophy" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">14</span>
                <span class="text-muted-foreground">wins</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="award" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">32</span>
                <span class="text-muted-foreground">nominations</span>
            </span>
        </div>

        @* Filmography *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Filmography</span>
            </div>
            @for (var i = 0; i < _filmography.Length; i++)
            {
                var film = _filmography[i];
                var isLast = i == _filmography.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@film.Title</span>
                                <span class="font-mono text-muted-foreground text-xs">@film.Year</span>
                            </div>
                            <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@film.Genre</BadgeCn>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="dollar-sign" Size="12" Class="size-3" />
                                    @film.BoxOffice
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="star" Size="12" Class="size-3" />
                                    @film.Rating
                                </span>
                                @if (film.Awards > 0)
                                {
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="trophy" Size="12" Class="size-3" />
                                        @film.Awards
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Awards *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Awards</span>
            </div>
            @for (var i = 0; i < _awardHighlights.Length; i++)
            {
                var award = _awardHighlights[i];
                var isLast = i == _awardHighlights.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <LucideIconCn Name="trophy" Size="14" Class="size-3.5 shrink-0 text-amber-500" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@award.Award</span>
                        <p class="text-muted-foreground text-xs">@award.Result</p>
                    </div>
                    @if (award.Count > 1)
                    {
                        <span class="shrink-0 font-mono text-muted-foreground text-xs">x@(award.Count)</span>
                    }
                </div>
            }
        </div>

        @* Genres *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Genres</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var g in _genres)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@g</BadgeCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record FilmItem(string Id, string Title, string Year, string Genre, string BoxOffice, string Rating, int Awards);
    private record AwardHighlight(string Award, string Result, int Count);

    private static readonly FilmItem[] _filmography =
    [
        new("f1", "The Silence Between Us", "2026", "Drama", "$42M", "8.4", 5),
        new("f2", "Ghost Meridian", "2024", "Thriller", "$68M", "8.1", 3),
        new("f3", "Letters to Autumn", "2022", "Romance", "$35M", "7.9", 2),
        new("f4", "The Cartographer", "2020", "Drama", "$28M", "8.6", 4),
        new("f5", "Before the Flood", "2018", "Documentary", "$12M", "8.2", 0),
    ];

    private static readonly AwardHighlight[] _awardHighlights =
    [
        new("Cannes Film Festival", "Palme d'Or Nominee", 2),
        new("Academy Awards", "Best Director Nominee", 1),
        new("Venice Film Festival", "Golden Lion Winner", 1),
        new("BAFTA", "Best Film Winner", 1),
    ];

    private static readonly string[] _genres =
    [
        "Drama",
        "Thriller",
        "Romance",
        "Documentary",
        "Period Piece",
    ];
}
