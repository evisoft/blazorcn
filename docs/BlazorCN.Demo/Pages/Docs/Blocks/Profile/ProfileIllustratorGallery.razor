@* ============================================================
   Block: profile-illustrator-gallery
   Title: ProfileIllustratorGallery
   Description: React illustrator profile block for Next.js with art gallery grid, style categories, commission pricing, and medium expertise using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-illustrator-gallery.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarFallbackCn>IR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Isla Reeves</span>
                <p class="text-muted-foreground text-xs">Freelance Illustrator</p>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                    Award-winning illustrator creating editorial, children's book, and concept art. Clients include The New York Times, Penguin, and Apple. Commissions open.
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Commission
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="brush" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">520</span>
                <span class="text-muted-foreground">artworks</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">68</span>
                <span class="text-muted-foreground">clients</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">240</span>
                <span class="text-muted-foreground">commissions</span>
            </span>
        </div>

        @* Gallery *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Gallery</span>
            <div class="grid grid-cols-3 gap-2">
                @foreach (var art in _gallery)
                {
                    <div class="group cursor-pointer overflow-hidden rounded-md border transition-colors hover:border-foreground/20">
                        <div class="flex h-20 items-center justify-center bg-muted">
                            <LucideIconCn Name="palette" Size="16" Class="size-4 text-muted-foreground/30" />
                        </div>
                        <div class="p-2">
                            <span class="font-medium text-xs">@art.Title</span>
                            <div class="mt-0.5 flex items-center justify-between text-muted-foreground text-xs">
                                <span>@art.Style</span>
                                <span class="flex items-center gap-0.5">
                                    <LucideIconCn Name="heart" Size="12" Class="size-3" />
                                    @FormatCount(art.Likes)
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Commission Rates *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Commission Rates</span>
            </div>
            @for (var i = 0; i < _commissionTiers.Length; i++)
            {
                var tier = _commissionTiers[i];
                var isLast = i == _commissionTiers.Length - 1;
                <div class="@Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b")">
                    <div>
                        <span class="font-medium text-sm">@tier.Name</span>
                        <p class="text-muted-foreground text-xs">@tier.Turnaround</p>
                    </div>
                    <span class="font-medium text-sm tabular-nums">@tier.Price</span>
                </div>
            }
        </div>

        @* Styles *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Styles</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var style in _styles)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@style</BadgeCn>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record ArtworkItem(string Id, string Title, string Style, string Medium, int Likes);
    private record CommissionTier(string Name, string Price, string Turnaround);

    private static readonly ArtworkItem[] _gallery =
    [
        new("a1", "Forest Spirits",  "Fantasy",     "Digital",     2400),
        new("a2", "City at Dusk",    "Editorial",   "Watercolor",  1800),
        new("a3", "The Reading Fox", "Children's",  "Gouache",     3200),
        new("a4", "Neon Botanicals", "Concept Art", "Digital",     1560),
        new("a5", "Storm Watcher",   "Fantasy",     "Mixed Media", 2100),
        new("a6", "Morning Ritual",  "Editorial",   "Ink & Wash",  980),
    ];

    private static readonly CommissionTier[] _commissionTiers =
    [
        new("Spot Illustration",      "$300 - $600",    "3-5 days"),
        new("Editorial Full Page",    "$800 - $1,500",  "1-2 weeks"),
        new("Book Cover",             "$2,000 - $4,000","2-3 weeks"),
        new("Character Design Sheet", "$500 - $1,200",  "1 week"),
    ];

    private static readonly string[] _styles =
    [
        "Fantasy",
        "Editorial",
        "Children's Book",
        "Concept Art",
        "Botanical",
        "Character Design",
    ];

    private static string FormatCount(int n) =>
        n >= 1000 ? $"{(n / 1000.0):F1}k" : n.ToString();
}
