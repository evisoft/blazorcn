@* ============================================================
   Block: profile-speaker-bio
   Title: ProfileSpeakerBio
   Description: React speaker bio profile block for Next.js with upcoming talks timeline, past conference history, topic expertise tags, and speaking engagement request form using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-speaker-bio.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="@_speaker.Avatar" Alt="@_speaker.Name" />
                <AvatarFallbackCn Class="text-lg">AP</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">@_speaker.Name</span>
                <span class="mt-0.5 block text-muted-foreground text-xs">@_speaker.Title</span>
                <p class="mt-2 text-muted-foreground text-sm leading-relaxed">@_speaker.Bio</p>
            </div>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="mic" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_speaker.TotalTalks</span>
                <span class="text-muted-foreground">talks</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="map-pin" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_speaker.Countries</span>
                <span class="text-muted-foreground">countries</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">@_speaker.AvgRating</span>
                <span class="text-muted-foreground">avg rating</span>
            </span>
        </div>

        @* Topics *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Topics</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var topic in _topics)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@topic</BadgeCn>
                }
            </div>
        </div>

        @* Upcoming talks timeline *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Upcoming</span>
            </div>
            <div class="relative px-4 py-3">
                <div class="absolute top-0 bottom-0 left-[29px] w-px bg-border"></div>
                <div class="space-y-4">
                    @foreach (var talk in _upcomingTalks)
                    {
                        var dotColor = _typeColor.TryGetValue(talk.Type, out var c) ? c : "bg-muted-foreground";
                        <div class="relative flex gap-3 pl-6">
                            <span class="@Cn.Merge("absolute left-0 top-1.5 size-2 rounded-full", dotColor)"></span>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@talk.Title</span>
                                <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                    <span>@talk.Conference</span>
                                    <span>&middot;</span>
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                        @talk.Date
                                    </span>
                                </div>
                                <div class="mt-1 flex items-center gap-2 text-muted-foreground text-xs">
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                        @talk.Location
                                    </span>
                                    <span>&middot;</span>
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="users" Size="12" Class="size-3" />
                                        @talk.AudienceSize
                                    </span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-1 h-4 px-1.5 font-normal text-[10px]">@talk.Type</BadgeCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* Past talks *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Past Talks</span>
            </div>
            @for (var i = 0; i < _pastTalks.Length; i++)
            {
                var talk = _pastTalks[i];
                var isLast = i == _pastTalks.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <LucideIconCn Name="video" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@talk.Title</span>
                        <span class="ml-2 text-muted-foreground text-xs">@talk.Conference, @talk.Year</span>
                    </div>
                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                        @talk.Views views
                        <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                    </span>
                </div>
            }
        </div>

        @* CTA *@
        <div class="border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Outline" Class="h-8 w-full text-xs">Book Speaker</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record SpeakerInfo(string Name, string Title, string Avatar, string Bio, int TotalTalks, int Countries, double AvgRating);

    private readonly SpeakerInfo _speaker = new(
        "Dr. Aisha Patel",
        "VP of Engineering, Vercel",
        "",
        "Building developer tools for the next billion developers. Previously led platform engineering at Stripe. PhD in Distributed Systems from MIT. 150+ talks across 30 countries.",
        156,
        32,
        4.8
    );

    private readonly string[] _topics =
    [
        "Edge Computing", "Developer Experience", "Distributed Systems",
        "Platform Engineering", "Web Performance", "Engineering Leadership"
    ];

    private record UpcomingTalk(string Id, string Title, string Conference, string Location, string Date, string Type, string AudienceSize);

    private readonly UpcomingTalk[] _upcomingTalks =
    [
        new("t1", "The Future of Edge-First Architecture", "React Summit", "Amsterdam, NL", "Jun 14, 2026", "Keynote", "2,500+"),
        new("t2", "Building Resilient Developer Platforms", "QCon London", "London, UK", "Apr 7, 2026", "Talk", "800"),
        new("t3", "From Monolith to Edge: A Migration Story", "Next.js Conf", "San Francisco, CA", "May 22, 2026", "Workshop", "400"),
    ];

    private record PastTalk(string Title, string Conference, string Year, string Views);

    private readonly PastTalk[] _pastTalks =
    [
        new("Rethinking Server Components", "JSConf EU", "2025", "42K"),
        new("Zero-Downtime Deployments at Scale", "KubeCon", "2025", "38K"),
        new("The Cost of Abstraction", "Strange Loop", "2024", "95K"),
        new("Why DX Matters More Than You Think", "React Conf", "2024", "120K"),
    ];

    private readonly Dictionary<string, string> _typeColor = new()
    {
        ["Keynote"] = "bg-amber-500",
        ["Talk"] = "bg-blue-500",
        ["Workshop"] = "bg-emerald-500",
    };
}
