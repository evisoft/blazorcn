@* ============================================================
   Block: profile-content-creator
   Title: Profile Content Creator
   Description: Content creator profile with platform analytics, video performance grid, audience demographics bar chart, and brand collaboration section
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, LucideEyeCn, LucideHeartCn, LucidePlayCircleCn, LucideTrendingUpCn
   Source: original/blocks/profile/profile-content-creator.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12"><AvatarImageCn Src="" Alt="Jordan Blake" /><AvatarFallbackCn>JB</AvatarFallbackCn></AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Jordan Blake</span>
                <span class="ml-2 text-muted-foreground text-xs">Tech Content Creator</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">Making complex tech simple. 2M+ followers across platforms. Videos on web dev, AI, and developer tools.</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Media Kit</ButtonCn>
        </div>

        @* Platform stats *@
        <div class="grid grid-cols-4 gap-px border-b bg-border">
            @foreach (var p in _platforms)
            {
                <div class="bg-card px-3 py-3 text-center">
                    <div class="flex items-center justify-center gap-1.5">
                        <span class="@($"size-1.5 rounded-full {p.Color}")"></span>
                        <span class="text-muted-foreground text-xs">@p.Name</span>
                    </div>
                    <span class="mt-1 block font-semibold text-sm tabular-nums">@p.Followers</span>
                </div>
            }
        </div>

        @* Aggregate stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs"><LucideEyeCn Size="12" Class="text-muted-foreground" /><span class="font-medium tabular-nums">142M</span><span class="text-muted-foreground">total views</span></span>
            <span class="text-muted-foreground text-xs">&#183;</span>
            <span class="flex items-center gap-1.5 text-xs"><LucideTrendingUpCn Size="12" Class="text-muted-foreground" /><span class="font-medium tabular-nums text-emerald-600 dark:text-emerald-400">6.2%</span><span class="text-muted-foreground">avg engagement</span></span>
        </div>

        @* Top videos *@
        <div class="border-b">
            <div class="border-b px-4 py-2"><span class="font-medium text-muted-foreground text-xs">Top performing content</span></div>
            @for (var i = 0; i < _videos.Length; i++)
            {
                var video = _videos[i];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", i < _videos.Length - 1 ? "border-b" : "")">
                    <LucidePlayCircleCn Size="16" Class="shrink-0 text-muted-foreground" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@video.Title</span>
                        <span class="ml-2 text-muted-foreground text-xs">@video.Published</span>
                    </div>
                    <div class="flex items-center gap-3 text-muted-foreground text-xs">
                        <span class="flex items-center gap-1 tabular-nums"><LucideEyeCn Size="12" />@video.Views</span>
                        <span class="flex items-center gap-1 tabular-nums"><LucideHeartCn Size="12" />@video.Likes</span>
                    </div>
                </div>
            }
        </div>

        @* Audience demographics *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Audience age distribution</span>
            <div class="space-y-2">
                @foreach (var demo in _demographics)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-10 shrink-0 text-right font-mono text-muted-foreground text-xs">@demo.Label</span>
                        <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                            <div class="h-full rounded-full bg-blue-500" style="@($"width: {demo.Percentage}%")"></div>
                        </div>
                        <span class="w-8 shrink-0 font-mono text-muted-foreground text-xs tabular-nums">@(demo.Percentage)%</span>
                    </div>
                }
            </div>
        </div>

        @* Brand collaborations *@
        <div>
            <div class="border-b px-4 py-2"><span class="font-medium text-muted-foreground text-xs">Brand collaborations</span></div>
            @for (var i = 0; i < _brands.Length; i++)
            {
                var brand = _brands[i];
                var dot = brand.Status switch { "active" => "bg-emerald-500", "upcoming" => "bg-blue-500", _ => "bg-muted-foreground/40" };
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", i < _brands.Length - 1 ? "border-b" : "")">
                    <span class="@($"size-1.5 shrink-0 rounded-full {dot}")"></span>
                    <span class="font-medium text-sm">@brand.Name</span>
                    <span class="text-muted-foreground text-xs">@brand.Type</span>
                    <BadgeCn Variant="BadgeVariant.Outline" Class="ml-auto font-normal text-xs capitalize">@brand.Status</BadgeCn>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PlatformItem(string Name, string Followers, string Color);
    private record VideoItem(string Title, string Views, string Likes, string Published);
    private record DemoItem(string Label, int Percentage);
    private record BrandItem(string Name, string Type, string Status);

    private readonly PlatformItem[] _platforms = [new("YouTube", "1.2M", "bg-red-500"), new("TikTok", "680K", "bg-foreground"), new("Twitter/X", "245K", "bg-blue-500"), new("Instagram", "89K", "bg-pink-500")];
    private readonly VideoItem[] _videos = [
        new("I Built an AI Agent in 10 Minutes", "2.4M", "98K", "2 weeks ago"),
        new("React Server Components Explained", "1.8M", "72K", "1 month ago"),
        new("Why I Switched to Bun", "1.1M", "45K", "6 weeks ago"),
        new("The Future of CSS is Here", "890K", "34K", "2 months ago"),
        new("Building a SaaS in a Weekend", "3.2M", "124K", "3 months ago"),
        new("Tailwind vs CSS Modules in 2026", "670K", "28K", "3 months ago"),
    ];
    private readonly DemoItem[] _demographics = [new("18-24", 32), new("25-34", 41), new("35-44", 18), new("45+", 9)];
    private readonly BrandItem[] _brands = [new("Vercel", "Sponsored series", "active"), new("Supabase", "Tutorial collab", "active"), new("Linear", "Brand ambassador", "completed"), new("Raycast", "Product review", "upcoming")];
}
