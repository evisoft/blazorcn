@* ============================================================
   Block: profile-mechanic-certifications
   Title: ProfileMechanicCertifications
   Description: React mechanic certifications profile block for Next.js with ASE certifications, service specialties, customer reviews, shop affiliation, and hourly rate display using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-mechanic-certifications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Marcus Rivera" />
                <AvatarFallbackCn Class="text-lg">MR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Marcus Rivera</span>
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-blue-500" />
                </div>
                <span class="text-muted-foreground text-xs">ASE Master Technician</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="wrench" Size="12" Class="size-3" />
                        Precision Auto Care
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Denver, CO
                    </span>
                </div>
                <div class="mt-0.5 flex items-center gap-3 text-xs">
                    <span class="text-muted-foreground">16 years experience</span>
                    <span class="text-muted-foreground">·</span>
                    <span class="font-medium tabular-nums">$125/hr</span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                <LucideIconCn Name="phone" Size="12" Class="mr-1 size-3" />
                Call
            </ButtonCn>
        </div>

        @* Stats *@
        <div class="grid grid-cols-3 border-b">
            <div class="px-3 py-3 text-center">
                <div class="flex items-center justify-center gap-1">
                    <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-500 text-amber-500" />
                    <span class="font-semibold text-2xl tabular-nums">4.9</span>
                </div>
                <span class="text-muted-foreground text-xs">218 reviews</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">@_certifications.Length</span>
                <span class="text-muted-foreground text-xs">ASE Certs</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">4.8K</span>
                <span class="text-muted-foreground text-xs">Vehicles</span>
            </div>
        </div>

        @* Certifications *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">ASE Certifications</span>
            <div class="space-y-2">
                @foreach (var cert in _certifications)
                {
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="shield-check" Size="16" Class="size-4 shrink-0 text-emerald-600 dark:text-emerald-400" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@cert.Name</span>
                            <span class="ml-2 text-muted-foreground text-xs">@cert.Board, @cert.Year</span>
                        </div>
                        @if (cert.Verified)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 gap-1 px-1.5 font-normal text-[10px]">
                                <LucideIconCn Name="check-circle-2" Size="10" Class="size-2.5" />
                                Verified
                            </BadgeCn>
                        }
                    </div>
                }
            </div>
        </div>

        @* Specialties *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Specialties</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var s in _specialties)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@s</BadgeCn>
                }
            </div>
        </div>

        @* Services *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Common Services</span>
            </div>
            @for (var i = 0; i < _services.Length; i++)
            {
                var svc = _services[i];
                var isLast = i == _services.Length - 1;
                <div class="@(Cn.Merge("flex items-center justify-between px-4 py-2.5", isLast ? "" : "border-b"))">
                    <div>
                        <span class="font-medium text-sm">@svc.Name</span>
                        <span class="ml-2 text-muted-foreground text-xs">@svc.Time</span>
                    </div>
                    <span class="font-medium text-sm tabular-nums">@svc.Price</span>
                </div>
            }
        </div>

        @* Reviews *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Customer Reviews</span>
            <div class="space-y-2">
                @foreach (var rev in _reviews)
                {
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="text-sm leading-relaxed">@("\"")@rev.Text@("\"")</p>
                        <div class="mt-2 flex items-center gap-1 text-muted-foreground text-xs">
                            <span class="font-medium text-foreground">@rev.Name</span>
                            <span>·</span>
                            <div class="flex items-center gap-0.5">
                                @for (var s = 0; s < rev.Rating; s++)
                                {
                                    <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-amber-500 text-amber-500" />
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Certification(string Name, string Board, string Year, bool Verified);
    private record ServiceItem(string Name, string Time, string Price);
    private record ReviewItem(string Name, string Text, int Rating);

    private static readonly Certification[] _certifications =
    [
        new("Engine Repair (A1)", "ASE", "2022", true),
        new("Automatic Transmission (A2)", "ASE", "2022", true),
        new("Electrical Systems (A6)", "ASE", "2023", true),
        new("Heating & AC (A7)", "ASE", "2023", true),
        new("Engine Performance (A8)", "ASE", "2022", true),
    ];

    private static readonly string[] _specialties =
    [
        "European Vehicles",
        "Diesel Engines",
        "Hybrid/EV Systems",
        "Turbo & Supercharger",
        "Diagnostics",
        "Brake Systems",
        "Suspension",
    ];

    private static readonly ServiceItem[] _services =
    [
        new("Full Engine Diagnostic", "1-2 hrs", "$125-$250"),
        new("Brake Pad Replacement", "1 hr", "$180-$350"),
        new("Transmission Service", "2-3 hrs", "$250-$500"),
        new("AC System Recharge", "1 hr", "$150-$280"),
    ];

    private static readonly ReviewItem[] _reviews =
    [
        new("Tom K.", "Marcus diagnosed a problem three other shops missed. Fixed it same day.", 5),
        new("Sarah M.", "Fair pricing, thorough explanations. Won't go anywhere else for my BMW.", 5),
    ];
}
