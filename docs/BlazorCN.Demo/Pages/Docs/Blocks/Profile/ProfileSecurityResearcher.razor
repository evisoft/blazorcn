@* ============================================================
   Block: profile-security-researcher
   Title: ProfileSecurityResearcher
   Description: React cybersecurity researcher profile block for Next.js with CVE disclosures, vulnerability severity breakdown, bug bounty stats, and certification badges using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-security-researcher.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarFallbackCn>KN</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Katarina Novak</span>
                    <span class="font-mono text-muted-foreground text-xs">@@katnovak</span>
                </div>
                <span class="text-muted-foreground text-xs">Security Researcher</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                    Independent vulnerability researcher. Top 50 on HackerOne. OSCP, OSCE certified. Specializing in web application security and cloud misconfigurations.
                </p>
            </div>
        </div>

        @* Bug bounty stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="bug" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">23</span>
                <span class="text-muted-foreground">CVEs</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="dollar-sign" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">$284k</span>
                <span class="text-muted-foreground">earned</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="award" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">7</span>
                <span class="text-muted-foreground">hall of fame</span>
            </span>
        </div>

        @* Severity breakdown *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">
                Vulnerability breakdown
            </span>
            <div class="space-y-2">
                @foreach (var item in _breakdown)
                {
                    var pct = (double)item.Count / _totalFindings * 100;
                    <div class="flex items-center gap-3">
                        <span class="w-14 shrink-0 text-xs">@item.Severity</span>
                        <div class="h-2 flex-1 overflow-hidden rounded-full bg-muted/50">
                            <div class="@Cn.Merge("h-full rounded-full", item.Color)" style="width: @($"{pct:F1}")%"></div>
                        </div>
                        <span class="w-6 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                            @item.Count
                        </span>
                    </div>
                }
            </div>
        </div>

        @* CVE disclosures *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent disclosures</span>
            </div>
            @for (var i = 0; i < _cves.Length; i++)
            {
                var cve = _cves[i];
                var isExpanded = _expanded == cve.Id;
                var isLast = i == _cves.Length - 1;
                <div class="@Cn.Merge("", (isLast && !isExpanded) ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => ToggleExpanded(cve.Id))"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", _severityDot[cve.Severity])"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@cve.Title</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="font-mono text-muted-foreground text-xs">@cve.Cve</span>
                                <span class="text-muted-foreground text-xs">&middot;</span>
                                <span class="text-muted-foreground text-xs">@cve.Vendor</span>
                            </div>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">Details</span>
                                    <span class="text-muted-foreground text-xs">@cve.Date</span>
                                </div>
                                <p class="mt-1.5 text-sm leading-relaxed">
                                    Discovered a @cve.Severity-severity vulnerability in @cve.Vendor&apos;s
                                    infrastructure allowing @cve.Title.ToLower(). Responsibly disclosed and
                                    patched within 72 hours.
                                </p>
                                <div class="mt-2 flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs capitalize">
                                        @cve.Severity
                                    </BadgeCn>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        Patched
                                    </BadgeCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Certifications *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Certifications</span>
            </div>
            <div class="grid grid-cols-2 gap-px bg-border">
                @foreach (var cert in _certifications)
                {
                    <div class="bg-card px-4 py-3">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 text-muted-foreground" />
                            <span class="font-medium text-sm">@cert.Name</span>
                        </div>
                        <span class="mt-0.5 block text-muted-foreground text-xs">@cert.Issuer</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record CveItem(string Id, string Cve, string Title, string Vendor, string Severity, string Date);
    private record BreakdownItem(string Severity, int Count, string Color);
    private record CertItem(string Name, string Issuer);

    private string? _expanded = "1";

    private static readonly CveItem[] _cves =
    [
        new("1", "CVE-2025-41023", "Remote code execution via deserialization", "Cloudflare", "critical", "Jan 2026"),
        new("2", "CVE-2025-38912", "Authentication bypass in OAuth flow", "Okta", "critical", "Nov 2025"),
        new("3", "CVE-2025-35201", "SSRF via PDF generation endpoint", "Notion", "high", "Sep 2025"),
        new("4", "CVE-2025-29877", "Privilege escalation in IAM role chaining", "AWS", "high", "Jul 2025"),
        new("5", "CVE-2025-22145", "Stored XSS in markdown renderer", "GitLab", "medium", "Apr 2025"),
    ];

    private static readonly BreakdownItem[] _breakdown =
    [
        new("Critical", 6, "bg-red-500"),
        new("High", 9, "bg-amber-500"),
        new("Medium", 5, "bg-blue-500"),
        new("Low", 3, "bg-muted-foreground/40"),
    ];

    private static readonly int _totalFindings = 23;

    private static readonly Dictionary<string, string> _severityDot = new()
    {
        ["critical"] = "bg-red-500",
        ["high"] = "bg-amber-500",
        ["medium"] = "bg-blue-500",
        ["low"] = "bg-muted-foreground/40",
    };

    private static readonly CertItem[] _certifications =
    [
        new("OSCP", "Offensive Security"),
        new("OSCE", "Offensive Security"),
        new("CISSP", "ISC2"),
        new("GPEN", "SANS/GIAC"),
    ];

    private void ToggleExpanded(string id)
    {
        _expanded = _expanded == id ? null : id;
    }
}
