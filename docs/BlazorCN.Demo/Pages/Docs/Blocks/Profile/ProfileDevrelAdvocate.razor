@* ============================================================
   Block: profile-devrel-advocate
   Title: ProfileDevrelAdvocate
   Description: React developer relations advocate profile block for Next.js with talk history, content metrics, community stats, event schedule, and platform reach using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-devrel-advocate.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="@_advocate.Avatar" Alt="@_advocate.Name" />
                <AvatarFallbackCn Class="text-lg">KN</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_advocate.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@_advocate.Company</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">@_advocate.Title</span>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">@_advocate.Bio</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Invite to Speak</ButtonCn>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@FormatCount(_advocate.Followers)</span>
                <span class="text-muted-foreground">followers</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="mic" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_advocate.Talks</span>
                <span class="text-muted-foreground">talks</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="book-open" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_advocate.BlogPosts</span>
                <span class="text-muted-foreground">posts</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="video" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_advocate.Videos</span>
                <span class="text-muted-foreground">videos</span>
            </span>
        </div>

        @* Community stats *@
        <div class="grid grid-cols-4 gap-px border-b bg-border">
            @foreach (var stat in _communityStats)
            {
                <div class="bg-card px-3 py-3 text-center">
                    <LucideIconCn Name="@stat.Icon" Size="14" Class="mx-auto mb-1 size-3.5 text-muted-foreground" />
                    <span class="block font-semibold text-sm tabular-nums">@stat.Value</span>
                    <span class="text-muted-foreground text-xs">@stat.Label</span>
                </div>
            }
        </div>

        @* Content metrics *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Content output</span>
            <div class="space-y-2">
                @foreach (var metric in _contentMetrics)
                {
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="@metric.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="w-24 text-xs">@metric.Platform</span>
                        <span class="font-medium text-xs tabular-nums">@metric.Count</span>
                        <span class="flex-1 text-muted-foreground text-xs">@metric.Engagement</span>
                        <LucideIconCn Name="trending-up" Size="12" Class="@Cn.Merge("size-3", TrendColor(metric.Trend), metric.Trend == "down" ? "rotate-180" : "")" />
                    </div>
                }
            </div>
        </div>

        @* Tabs: Talks / Upcoming *@
        <TabsCn Value="@_activeTab" ValueChanged="@((string v) => { _activeTab = v; })" Class="w-full">
            <TabsListCn Class="w-full justify-start border-b px-4">
                <TabsTriggerCn Value="talks" Class="text-xs">Recent Talks</TabsTriggerCn>
                <TabsTriggerCn Value="upcoming" Class="text-xs">Upcoming</TabsTriggerCn>
            </TabsListCn>

            <TabsContentCn Value="talks" Class="mt-0">
                @for (var i = 0; i < _recentTalks.Length; i++)
                {
                    var talk = _recentTalks[i];
                    var isLast = i == _recentTalks.Length - 1;
                    <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@talk.Title</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@TalkTypeBadge(talk.Type)</BadgeCn>
                                </div>
                                <div class="mt-1 flex items-center gap-2 text-muted-foreground text-xs">
                                    <span>@talk.Event</span>
                                    <span>&middot;</span>
                                    <span class="flex items-center gap-0.5">
                                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                        @talk.Location
                                    </span>
                                </div>
                            </div>
                            <div class="flex shrink-0 flex-col items-end gap-0.5">
                                <span class="text-muted-foreground text-xs">@talk.Date</span>
                                <span class="flex items-center gap-0.5 text-muted-foreground text-xs">
                                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                                    @FormatCount(talk.Attendees)
                                </span>
                            </div>
                        </div>
                    </div>
                }
            </TabsContentCn>

            <TabsContentCn Value="upcoming" Class="mt-0">
                @for (var i = 0; i < _upcomingEvents.Length; i++)
                {
                    var evt = _upcomingEvents[i];
                    var isLast = i == _upcomingEvents.Length - 1;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", isLast ? "" : "border-b")">
                        <LucideIconCn Name="calendar" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@evt.Event</span>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@evt.Date</span>
                                <span>&middot;</span>
                                <span>@evt.Location</span>
                                <span>&middot;</span>
                                <span>@evt.Format</span>
                            </div>
                        </div>
                    </div>
                }
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private record AdvocateInfo(string Name, string Title, string Company, string Avatar, string Bio, int Followers, int Talks, int BlogPosts, int Videos);
    private record TalkItem(string Id, string Title, string Event, string Location, int Attendees, string Date, string Type);
    private record ContentMetricItem(string Platform, string Icon, int Count, string Engagement, string Trend);
    private record UpcomingEventItem(string Id, string Event, string Date, string Location, string Format);
    private record CommunityStatItem(string Label, string Value, string Icon);

    private static readonly AdvocateInfo _advocate = new(
        "Kai Nakamura",
        "Senior Developer Advocate",
        "Vercel",
        "",
        "Teaching developers to build faster. 120+ conference talks, 500k+ YouTube views, and maintainer of 3 open-source projects. Previously at AWS and Netlify.",
        45200,
        124,
        89,
        67
    );

    private static readonly TalkItem[] _recentTalks =
    [
        new("1", "The Future of Server Components", "React Conf", "Henderson, NV", 1200, "Mar 2026", "keynote"),
        new("2", "Edge-First Architecture Patterns", "Next.js Conf", "San Francisco, CA", 2800, "Feb 2026", "talk"),
        new("3", "Building AI-Powered Dev Tools", "DevWorld", "Amsterdam, NL", 450, "Jan 2026", "workshop"),
        new("4", "Zero-Config Deployments Deep Dive", "JSConf", "Berlin, DE", 800, "Dec 2025", "talk"),
    ];

    private static readonly ContentMetricItem[] _contentMetrics =
    [
        new("Blog posts", "book-open", 89, "340k reads", "up"),
        new("YouTube videos", "video", 67, "520k views", "up"),
        new("Livestreams", "play-circle", 34, "12k avg viewers", "stable"),
        new("Podcasts", "mic", 28, "180k listens", "up"),
    ];

    private static readonly UpcomingEventItem[] _upcomingEvents =
    [
        new("1", "ViteConf 2026", "Apr 14-15", "Online", "Talk"),
        new("2", "GraphQL Summit", "May 8-10", "Austin, TX", "Workshop"),
        new("3", "React Summit", "Jun 12-14", "Amsterdam, NL", "Keynote"),
    ];

    private static readonly CommunityStatItem[] _communityStats =
    [
        new("Discord members", "18.4k", "message-circle"),
        new("GitHub followers", "12.1k", "users"),
        new("Newsletter subs", "24.6k", "book-open"),
        new("Countries reached", "92", "globe"),
    ];

    private string _activeTab = "talks";

    private static string FormatCount(int n) =>
        n >= 1000 ? $"{(n / 1000.0):F1}k" : n.ToString();

    private static string TalkTypeBadge(string type) => type switch
    {
        "keynote" => "Keynote",
        "talk" => "Talk",
        "workshop" => "Workshop",
        _ => type
    };

    private static string TrendColor(string trend) => trend switch
    {
        "up" => "text-emerald-600 dark:text-emerald-400",
        "down" => "text-red-600 dark:text-red-400",
        _ => "text-muted-foreground"
    };
}
