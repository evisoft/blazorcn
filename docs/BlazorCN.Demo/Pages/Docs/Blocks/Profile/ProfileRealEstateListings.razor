@* ============================================================
   Block: profile-real-estate-listings
   Title: ProfileRealEstateListings
   Description: React real estate property listings profile block for Next.js with active property cards, price range filter, neighborhood tags, sales metrics, and listing status indicators using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-real-estate-listings.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Lauren Mitchell" />
                <AvatarFallbackCn Class="text-lg">LM</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Lauren Mitchell</span>
                <div class="text-muted-foreground text-xs">Licensed Broker</div>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideBuildingCn class="size-3" />
                        Pinnacle Realty Group
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideMapPinCn class="size-3" />
                        Los Angeles, CA
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Contact</ButtonCn>
        </div>

        @* Stats *@
        <div class="grid grid-cols-4 border-b">
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">18</span>
                <span class="text-muted-foreground text-xs">Active</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">$47.5M</span>
                <span class="text-muted-foreground text-xs">Portfolio</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">22</span>
                <span class="text-muted-foreground text-xs">Avg Days</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">34</span>
                <span class="text-muted-foreground text-xs">Closed YTD</span>
            </div>
        </div>

        @* Tabs filter *@
        <div class="border-b px-4 py-2">
            <TabsCn Value="@_tab" ValueChanged="@((string v) => _tab = v)">
                <TabsListCn Class="h-7 p-0.5">
                    <TabsTriggerCn Value="all" Class="h-6 px-2.5 text-xs">All</TabsTriggerCn>
                    <TabsTriggerCn Value="active" Class="h-6 px-2.5 text-xs">Active</TabsTriggerCn>
                    <TabsTriggerCn Value="pending" Class="h-6 px-2.5 text-xs">Pending</TabsTriggerCn>
                </TabsListCn>
            </TabsCn>
        </div>

        @* Listings *@
        <div>
            @{
                var filtered = _tab == "all" ? _properties : _properties.Where(p => p.Status == _tab).ToArray();
            }
            @for (var i = 0; i < filtered.Length; i++)
            {
                var prop = filtered[i];
                var dotClass = _statusDot.TryGetValue(prop.Status, out var d) ? d : "";
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", i < filtered.Length - 1 ? "border-b" : ""))">
                    <div class="flex items-start gap-3">
                        <div class="flex size-10 shrink-0 items-center justify-center rounded-md bg-muted/50">
                            <LucideHouseCn class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@prop.Address</span>
                                <span class="@(Cn.Merge("size-1.5 rounded-full", dotClass))"></span>
                            </div>
                            <span class="text-muted-foreground text-xs">@prop.Neighborhood · @prop.Type</span>
                            <div class="mt-1.5 flex items-center gap-3 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideBedDoubleCn class="size-3" />
                                    @prop.Beds
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideBathCn class="size-3" />
                                    @prop.Baths
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideRulerCn class="size-3" />
                                    @prop.Sqft.ToString("N0") sqft
                                </span>
                                <span class="text-muted-foreground">@prop.DaysOnMarket d on market</span>
                            </div>
                        </div>
                        <span class="shrink-0 font-medium text-sm tabular-nums">@FormatPrice(prop.Price)</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record PropertyItem(string Id, string Address, string Neighborhood, int Price, int Beds, int Baths, int Sqft, string Type, string Status, int DaysOnMarket);

    private string _tab = "all";

    private static string FormatPrice(int n)
    {
        if (n >= 1_000_000) return $"${n / 1_000_000.0:F2}M";
        if (n >= 1_000) return $"${n / 1_000}K";
        return $"${n}";
    }

    private readonly Dictionary<string, string> _statusDot = new()
    {
        ["active"] = "bg-emerald-500",
        ["pending"] = "bg-amber-500",
        ["sold"] = "bg-muted-foreground",
    };

    private readonly PropertyItem[] _properties = [
        new("p1", "1245 Sunset Blvd", "Hollywood Hills", 4850000, 5, 4, 4200, "house", "active", 8),
        new("p2", "920 Ocean Ave, #1502", "Santa Monica", 2190000, 2, 2, 1650, "condo", "active", 14),
        new("p3", "3821 Los Feliz Blvd", "Los Feliz", 3250000, 4, 3, 2800, "house", "pending", 21),
        new("p4", "718 Rose Ave", "Venice", 1890000, 3, 2, 1900, "townhouse", "active", 5),
        new("p5", "456 Maple Dr", "Beverly Hills", 8750000, 6, 7, 6400, "house", "active", 32),
    ];
}
