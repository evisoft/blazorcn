@* ============================================================
   Block: profile-ux-researcher
   Title: ProfileUxResearcher
   Description: React UX researcher profile block for Next.js with study portfolio, methodology tags, participant metrics, insight cards, and research timeline using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-ux-researcher.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="Dr. Amara Osei" />
                <AvatarFallbackCn>AO</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Dr. Amara Osei</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Spotify</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Lead UX Researcher</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">Mixed-methods researcher with 9 years of experience. PhD in HCI from Carnegie Mellon. Passionate about inclusive design and accessibility.</p>
            </div>
        </div>

        @* Research metrics *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="clipboard-list" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">47</span>
                <span class="text-muted-foreground">studies</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">1,240</span>
                <span class="text-muted-foreground">participants</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="lightbulb" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">312</span>
                <span class="text-muted-foreground">insights</span>
            </span>
        </div>

        @* Methods expertise *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Methodologies</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var method in _methods)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@method</BadgeCn>
                }
            </div>
        </div>

        @* Study portfolio *@
        <TabsCn Value="@_activeTab" OnValueChange="@((string v) => _activeTab = v)" Class="w-full">
            <TabsListCn Class="w-full justify-start border-b px-4">
                <TabsTriggerCn Value="all" Class="text-xs">All studies</TabsTriggerCn>
                <TabsTriggerCn Value="qualitative" Class="text-xs">Qualitative</TabsTriggerCn>
                <TabsTriggerCn Value="quantitative" Class="text-xs">Quantitative</TabsTriggerCn>
            </TabsListCn>

            <TabsContentCn Value="all" Class="mt-0">
                @for (var i = 0; i < _studies.Length; i++)
                {
                    var study = _studies[i];
                    var isLast = i == _studies.Length - 1;
                    var isExpanded = _expandedStudy == study.Id;
                    var capturedId = study.Id;
                    <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                        <button type="button" @onclick="@(() => ToggleStudy(capturedId))" class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetImpactDot(study.Impact))"></span>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@study.Title</span>
                                <div class="mt-0.5 flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@study.Method</BadgeCn>
                                    <span class="text-muted-foreground text-xs">@study.Participants.ToString("N0") participants</span>
                                    <span class="text-muted-foreground text-xs">&middot;</span>
                                    <span class="text-muted-foreground text-xs">@study.Date</span>
                                </div>
                            </div>
                        </button>
                        @if (isExpanded)
                        {
                            <div class="px-4 pb-3 pl-9">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="mb-1.5 flex items-center gap-2">
                                        <LucideIconCn Name="lightbulb" Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="font-medium text-muted-foreground text-xs">Key insight</span>
                                        <span class="ml-auto flex items-center gap-1 text-muted-foreground text-xs">
                                            <span class="@Cn.Merge("size-1.5 rounded-full", GetImpactDot(study.Impact))"></span>
                                            @study.Impact impact
                                        </span>
                                    </div>
                                    <p class="text-sm leading-relaxed">@study.Insight</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </TabsContentCn>

            <TabsContentCn Value="qualitative" Class="mt-0">
                @{
                    var qualStudies = _studies.Where(s => s.Type == "qualitative").ToArray();
                }
                @if (qualStudies.Length == 0)
                {
                    <div class="px-4 py-8 text-center text-muted-foreground text-sm">No studies found.</div>
                }
                @for (var i = 0; i < qualStudies.Length; i++)
                {
                    var study = qualStudies[i];
                    var isLast = i == qualStudies.Length - 1;
                    var isExpanded = _expandedStudy == study.Id;
                    var capturedId = study.Id;
                    <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                        <button type="button" @onclick="@(() => ToggleStudy(capturedId))" class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetImpactDot(study.Impact))"></span>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@study.Title</span>
                                <div class="mt-0.5 flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@study.Method</BadgeCn>
                                    <span class="text-muted-foreground text-xs">@study.Participants.ToString("N0") participants</span>
                                    <span class="text-muted-foreground text-xs">&middot;</span>
                                    <span class="text-muted-foreground text-xs">@study.Date</span>
                                </div>
                            </div>
                        </button>
                        @if (isExpanded)
                        {
                            <div class="px-4 pb-3 pl-9">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="mb-1.5 flex items-center gap-2">
                                        <LucideIconCn Name="lightbulb" Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="font-medium text-muted-foreground text-xs">Key insight</span>
                                        <span class="ml-auto flex items-center gap-1 text-muted-foreground text-xs">
                                            <span class="@Cn.Merge("size-1.5 rounded-full", GetImpactDot(study.Impact))"></span>
                                            @study.Impact impact
                                        </span>
                                    </div>
                                    <p class="text-sm leading-relaxed">@study.Insight</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </TabsContentCn>

            <TabsContentCn Value="quantitative" Class="mt-0">
                @{
                    var quantStudies = _studies.Where(s => s.Type == "quantitative").ToArray();
                }
                @if (quantStudies.Length == 0)
                {
                    <div class="px-4 py-8 text-center text-muted-foreground text-sm">No studies found.</div>
                }
                @for (var i = 0; i < quantStudies.Length; i++)
                {
                    var study = quantStudies[i];
                    var isLast = i == quantStudies.Length - 1;
                    var isExpanded = _expandedStudy == study.Id;
                    var capturedId = study.Id;
                    <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                        <button type="button" @onclick="@(() => ToggleStudy(capturedId))" class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                            <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetImpactDot(study.Impact))"></span>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@study.Title</span>
                                <div class="mt-0.5 flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@study.Method</BadgeCn>
                                    <span class="text-muted-foreground text-xs">@study.Participants.ToString("N0") participants</span>
                                    <span class="text-muted-foreground text-xs">&middot;</span>
                                    <span class="text-muted-foreground text-xs">@study.Date</span>
                                </div>
                            </div>
                        </button>
                        @if (isExpanded)
                        {
                            <div class="px-4 pb-3 pl-9">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="mb-1.5 flex items-center gap-2">
                                        <LucideIconCn Name="lightbulb" Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="font-medium text-muted-foreground text-xs">Key insight</span>
                                        <span class="ml-auto flex items-center gap-1 text-muted-foreground text-xs">
                                            <span class="@Cn.Merge("size-1.5 rounded-full", GetImpactDot(study.Impact))"></span>
                                            @study.Impact impact
                                        </span>
                                    </div>
                                    <p class="text-sm leading-relaxed">@study.Insight</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private record StudyItem(string Id, string Title, string Type, string Method, int Participants, string Insight, string Impact, string Date);

    private static readonly string[] _methods = ["Usability Testing", "Contextual Inquiry", "Card Sorting", "Diary Studies", "A/B Testing", "Surveys", "Eye Tracking", "Tree Testing"];

    private static readonly StudyItem[] _studies =
    [
        new("s1", "Playlist creation mental models", "qualitative", "Contextual Inquiry", 18, "Users think of playlists as moods, not genres. Reorganized creation flow around emotional contexts, increasing playlist creation by 34%.", "high", "Feb 2026"),
        new("s2", "Search result relevance evaluation", "quantitative", "A/B Testing", 50000, "Showing artist context in search results reduced bounce rate by 12%. Users needed less than 2 seconds to identify the correct result.", "high", "Jan 2026"),
        new("s3", "Accessibility audit of player controls", "qualitative", "Usability Testing", 24, "Screen reader users struggled with volume slider — replaced with step buttons. VoiceOver task completion improved from 40% to 92%.", "high", "Dec 2025"),
        new("s4", "New user onboarding flow", "quantitative", "Surveys", 3200, "Users who selected 5+ artists in onboarding had 2.4x higher retention at 30 days. Reduced minimum selection from 3 to incentivize deeper engagement.", "medium", "Nov 2025"),
        new("s5", "Podcast discovery patterns", "qualitative", "Diary Studies", 15, "Listeners discovered podcasts through social recommendations, not algorithmic. Added share-with-context feature to episode pages.", "medium", "Oct 2025"),
    ];

    private string _activeTab = "all";
    private string? _expandedStudy = "s1";

    private void ToggleStudy(string id)
    {
        _expandedStudy = _expandedStudy == id ? null : id;
    }

    private static string GetImpactDot(string impact) => impact switch
    {
        "high" => "bg-emerald-500",
        "medium" => "bg-amber-500",
        _ => "bg-muted-foreground/40",
    };
}
