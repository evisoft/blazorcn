@* ============================================================
   Block: profile-student-academic
   Title: ProfileStudentAcademic
   Description: React student academic profile block for Next.js with GPA display, course grades table, semester progress bars, extracurricular activities, and honors list using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-student-academic.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Jordan Rivera" />
                <AvatarFallbackCn Class="text-lg">JR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Jordan Rivera</span>
                <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                    <span>Computer Science, B.S.</span>
                    <span>·</span>
                    <span>Minor: Mathematics</span>
                </div>
                <div class="mt-1 flex items-center gap-2 text-muted-foreground text-xs">
                    <LucideIconCn Name="graduation-cap" Size="12" Class="size-3" />
                    <span>Stanford University</span>
                    <span>·</span>
                    <span>Junior</span>
                    <span>·</span>
                    <span>Exp. June 2027</span>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                <LucideIconCn Name="star" Size="12" Class="size-3 text-amber-500" />
                Dean's List
            </BadgeCn>
        </div>

        @* GPA + Credits *@
        <div class="flex items-center gap-6 border-b px-4 py-4">
            <div>
                <span class="text-muted-foreground text-xs">Cumulative GPA</span>
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">3.87</span>
                    <span class="text-muted-foreground text-xs">/4.00</span>
                </div>
            </div>
            <div class="flex-1">
                <div class="mb-1 flex items-center justify-between">
                    <span class="text-muted-foreground text-xs">Degree Progress</span>
                    <span class="text-muted-foreground text-xs tabular-nums">98/180 credits</span>
                </div>
                <div class="h-2 overflow-hidden rounded-full bg-muted">
                    <div class="h-full rounded-full bg-foreground/60" style="@($"width:{_progressPct}%")"></div>
                </div>
                <span class="mt-0.5 block text-right text-muted-foreground text-xs tabular-nums">@_progressPct%</span>
            </div>
        </div>

        @* Semester GPA trend *@
        <div class="border-b px-4 py-3">
            <span class="mb-3 block font-medium text-muted-foreground text-xs">Semester GPA Trend</span>
            <div class="flex items-end gap-2">
                @foreach (var sem in _semesterGPAs)
                {
                    var heightPx = (int)Math.Round((sem.Gpa / 4.0) * 100 * 0.6);
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <span class="font-medium text-xs tabular-nums">@sem.Gpa</span>
                        <div class="w-full rounded-t bg-foreground/60" style="@($"height:{heightPx}px")"></div>
                        <span class="text-muted-foreground text-[10px]">@sem.Semester</span>
                    </div>
                }
            </div>
        </div>

        @* Current courses *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Current Semester</span>
            </div>
            @for (var i = 0; i < _currentCourses.Length; i++)
            {
                var course = _currentCourses[i];
                var gradeClass = _gradeColor.TryGetValue(course.Grade, out var gc) ? gc : "";
                <div class="@($"flex items-center gap-3 px-4 py-2.5 {(i < _currentCourses.Length - 1 ? "border-b" : "")}")">
                    <span class="w-16 shrink-0 font-mono text-muted-foreground text-xs">@course.Code</span>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@course.Name</span>
                    </div>
                    <span class="text-muted-foreground text-xs">@course.Credits cr</span>
                    <span class="@($"w-6 text-right font-medium text-sm tabular-nums {gradeClass}")">@course.Grade</span>
                </div>
            }
        </div>

        @* Activities *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Activities &amp; Leadership</span>
            <div class="space-y-2">
                @foreach (var act in _activities)
                {
                    <div class="flex items-center gap-3">
                        <div class="flex size-7 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="@act.Icon" Size="14" Class="size-3.5 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@act.Name</span>
                        </div>
                        <span class="text-muted-foreground text-xs">@act.Role</span>
                    </div>
                }
            </div>
        </div>

        @* Honors *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Honors &amp; Awards</span>
            <div class="space-y-1.5">
                @foreach (var honor in _honors)
                {
                    <div class="flex items-center gap-2 text-sm">
                        <LucideIconCn Name="award" Size="12" Class="size-3 shrink-0 text-amber-500" />
                        <span>@honor</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record Course(string Code, string Name, int Credits, string Grade, string Status);
    private record SemesterGpa(string Semester, double Gpa);
    private record Activity(string Name, string Role, string Icon);

    private static readonly int _creditsCompleted = 98;
    private static readonly int _creditsRequired = 180;
    private int _progressPct => (int)Math.Round((_creditsCompleted / (double)_creditsRequired) * 100);

    private static readonly Course[] _currentCourses =
    [
        new("CS 229", "Machine Learning", 4, "A", "enrolled"),
        new("CS 161", "Design & Analysis of Algorithms", 4, "A-", "enrolled"),
        new("MATH 171", "Fundamental Concepts of Analysis", 3, "B+", "enrolled"),
        new("CS 248", "Interactive Computer Graphics", 3, "A", "enrolled"),
        new("PHIL 151", "Metalogic", 3, "A-", "enrolled"),
    ];

    private static readonly SemesterGpa[] _semesterGPAs =
    [
        new("Fall '24", 3.72),
        new("Spr '25", 3.85),
        new("Fall '25", 3.91),
        new("Spr '26", 3.94),
        new("Fall '26", 3.87),
    ];

    private static readonly Activity[] _activities =
    [
        new("ACM Student Chapter", "Vice President", "users"),
        new("Stanford AI Lab (SAIL)", "Research Assistant", "book-open"),
        new("Hackathon Club", "Lead Organizer", "trophy"),
        new("Math Olympiad Team", "Member", "award"),
    ];

    private static readonly string[] _honors =
    [
        "Dean's List — 4 consecutive semesters",
        "Phi Beta Kappa Society",
        "NSF Undergraduate Research Fellowship",
        "Stanford Humanities & Sciences Prize",
    ];

    private static readonly Dictionary<string, string> _gradeColor = new()
    {
        ["A"] = "text-emerald-600 dark:text-emerald-400",
        ["A-"] = "text-emerald-600 dark:text-emerald-400",
        ["B+"] = "text-blue-600 dark:text-blue-400",
        ["B"] = "text-blue-600 dark:text-blue-400",
    };
}
