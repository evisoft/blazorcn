@* ============================================================
   Block: profile-activity-timeline
   Title: Profile Activity Timeline
   Description: Profile activity timeline with recent actions, commit history, PR reviews, deployment events, and expandable detail rows
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, LucideChevronRightCn, LucideFilterCn, LucideGitCommitHorizontalCn, LucideGitPullRequestCn, LucideMessageSquareCn, LucideRocketCn
   Source: original/blocks/profile/profile-activity-timeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Profile header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-10">
                <AvatarImageCn Src="" Alt="Alex Rivera" />
                <AvatarFallbackCn>AR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Alex Rivera</span>
                    <span class="font-mono text-muted-foreground text-xs">@@arivera</span>
                </div>
                <span class="text-muted-foreground text-xs">Full-Stack Engineer</span>
            </div>
            <div class="flex items-center gap-3 text-xs">
                <span class="text-muted-foreground">
                    <span class="font-medium tabular-nums text-foreground">12</span> today
                </span>
                <span class="text-muted-foreground">
                    <span class="font-medium tabular-nums text-foreground">47</span> this week
                </span>
            </div>
        </div>

        @* Filter bar *@
        <div class="flex items-center gap-2 border-b px-4 py-2">
            <LucideFunnelCn Size="12" Class="text-muted-foreground" />
            <span class="font-medium text-muted-foreground text-xs">Recent activity</span>
            <span class="ml-auto text-muted-foreground text-xs tabular-nums">@_activities.Length events</span>
        </div>

        @* Timeline *@
        <div>
            @for (var idx = 0; idx < _activities.Length; idx++)
            {
                var activity = _activities[idx];
                var isExpanded = _expanded == activity.Id;
                var isLast = idx == _activities.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button" @onclick="() => _expanded = isExpanded ? null : activity.Id"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <div class="relative flex size-7 shrink-0 items-center justify-center rounded-full bg-muted/50 text-muted-foreground">
                            @if (activity.Type == "commit")
                            {
                                <LucideGitCommitHorizontalCn Size="14" />
                            }
                            else if (activity.Type == "review")
                            {
                                <LucideGitPullRequestCn Size="14" />
                            }
                            else if (activity.Type == "deploy")
                            {
                                <LucideRocketCn Size="14" />
                            }
                            else
                            {
                                <LucideMessageSquareCn Size="14" />
                            }
                            <span class="@($"absolute -top-0.5 -right-0.5 size-2 rounded-full {activity.DotColor}")"></span>
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@activity.Title</span>
                                <span class="text-muted-foreground text-xs">@activity.Time</span>
                            </div>
                            <p class="mt-0.5 truncate text-muted-foreground text-xs">@activity.Description</p>
                        </div>
                        <BadgeCn Variant="BadgeVariant.Outline" Class="hidden font-mono font-normal text-xs sm:inline-flex">
                            @activity.Repo
                        </BadgeCn>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-14">
                            <div class="rounded-md bg-muted/50 p-3">
                                @if (!string.IsNullOrEmpty(activity.Branch))
                                {
                                    <div class="mb-2">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono font-normal text-xs">@activity.Branch</BadgeCn>
                                    </div>
                                }
                                <p class="whitespace-pre-line text-sm leading-relaxed">@activity.Detail</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ActivityItem(string Id, string Type, string DotColor, string Title, string Description, string Detail, string Time, string Repo, string? Branch = null);

    private string? _expanded = "1";

    private readonly ActivityItem[] _activities =
    [
        new("1", "deploy", "bg-amber-500", "Deployed to production", "v2.14.0 — 3 new features, 7 bug fixes",
            "Deployment completed in 2m 34s. All health checks passed. Zero-downtime rollout across 3 regions (us-east-1, eu-west-1, ap-southeast-1). 100% traffic shifted.",
            "14 min ago", "acme/web-app"),
        new("2", "commit", "bg-blue-500", "Pushed 3 commits", "fix: resolve race condition in auth flow",
            "fix: resolve race condition in auth flow\nrefactor: extract session validation to middleware\ntest: add integration tests for OAuth callback\n\n4 files changed, 127 insertions(+), 43 deletions(-)",
            "28 min ago", "acme/web-app", "fix/auth-race"),
        new("3", "review", "bg-emerald-500", "Approved pull request", "#482 — Add rate limiting to API endpoints",
            "Reviewed 12 files across 4 commits. Left 2 comments on the sliding window implementation. Suggested using Redis sorted sets instead of in-memory counters for multi-instance deployments. Approved after changes.",
            "1h ago", "acme/api-gateway"),
        new("4", "comment", "bg-muted-foreground", "Commented on issue", "#219 — Memory leak in WebSocket handler",
            "Identified the root cause: event listeners were not being cleaned up on client disconnect. The connection pool was holding references to closed sockets. Proposed fix: add a cleanup hook in the disconnect handler and set a 30-second timeout for stale connections.",
            "2h ago", "acme/realtime-engine"),
        new("5", "commit", "bg-blue-500", "Pushed 1 commit", "feat: add search indexing for docs",
            "Implemented full-text search indexing using Postgres tsvector columns. Added a background job to re-index on content updates. Search results now include highlighted snippets.\n\n2 files changed, 89 insertions(+), 12 deletions(-)",
            "3h ago", "acme/docs", "feat/search"),
        new("6", "deploy", "bg-amber-500", "Deployed to staging", "v2.14.0-rc.2 — pre-release validation",
            "Staging deployment for final QA validation. Ran 342 integration tests — all passed. Performance benchmarks show 12% improvement in API response time compared to v2.13.0.",
            "4h ago", "acme/web-app"),
    ];
}
