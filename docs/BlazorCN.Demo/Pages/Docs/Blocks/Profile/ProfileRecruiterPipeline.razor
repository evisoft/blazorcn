@* ============================================================
   Block: profile-recruiter-pipeline
   Title: ProfileRecruiterPipeline
   Description: React recruiter pipeline profile block for Next.js with candidate funnel stages, placement stats, role openings list, and hiring velocity metrics using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-recruiter-pipeline.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarFallbackCn Class="text-lg">SR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Samantha Rios</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Stripe</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Senior Technical Recruiter</span>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">
                    Placing top-tier engineers at high-growth startups and FAANG companies. 6 years in tech recruiting with a 94% offer acceptance rate.
                </p>
            </div>
        </div>

        @* Key metrics *@
        <div class="grid grid-cols-4 gap-px border-b bg-border">
            @foreach (var metric in _metrics)
            {
                <div class="bg-card px-3 py-3 text-center">
                    <LucideIconCn Name="@metric.Icon" Size="14" Class="mx-auto mb-1 size-3.5 text-muted-foreground" />
                    <span class="block font-semibold text-sm tabular-nums">@metric.Value</span>
                    <span class="text-muted-foreground text-xs">@metric.Label</span>
                </div>
            }
        </div>

        @* Pipeline funnel *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Active pipeline</span>
            <div class="flex gap-1">
                @foreach (var stage in _funnel)
                {
                    <div class="@Cn.Merge(stage.Color, "rounded-sm px-2 py-2")" style="width: @($"{(double)stage.Count / 342 * 100:F1}%"); min-width: fit-content;">
                        <span class="block font-medium text-xs">@stage.Count</span>
                    </div>
                }
            </div>
            <div class="mt-1.5 flex gap-3">
                @foreach (var stage in _funnel)
                {
                    <span class="flex items-center gap-1 text-muted-foreground text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", stage.Color)"></span>
                        @stage.Name
                    </span>
                }
            </div>
        </div>

        @* Monthly placement chart *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Monthly placements</span>
            <div class="flex items-end gap-2">
                @foreach (var m in _monthlyMetrics)
                {
                    var barHeight = (int)((double)m.Placements / 9 * 48);
                    <div class="flex flex-1 flex-col items-center gap-1">
                        <div class="w-full rounded-sm bg-foreground/15" style="height: @(barHeight < 4 ? 4 : barHeight)px;"></div>
                        <span class="text-muted-foreground text-xs">@m.Month</span>
                    </div>
                }
            </div>
        </div>

        @* Open roles *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Open roles</span>
            </div>
            @for (var i = 0; i < _openRoles.Length; i++)
            {
                var role = _openRoles[i];
                var roleId = role.Id;
                var isLast = i == _openRoles.Length - 1;
                var isExpanded = _expandedRole == role.Id;
                <div class="@Cn.Merge(isLast ? "" : "border-b")">
                    <div role="button"
                         tabindex="0"
                         class="flex w-full cursor-pointer items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50"
                         @onclick="@(() => ToggleRole(roleId))">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", _priorityDot[role.Priority])"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@role.Title</span>
                            <span class="ml-2 text-muted-foreground text-xs">@role.Team</span>
                        </div>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </div>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="flex items-center gap-3 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="users" Size="12" Class="size-3" />
                                    @role.Candidates candidates
                                </span>
                                <span>·</span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                    @(role.DaysOpen)d open
                                </span>
                                <span>·</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@role.Priority</BadgeCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Recent placements *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent placements</span>
            </div>
            @for (var i = 0; i < _recentPlacements.Length; i++)
            {
                var p = _recentPlacements[i];
                var isLast = i == _recentPlacements.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <LucideIconCn Name="user-check" Size="14" Class="size-3.5 text-emerald-500" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@p.Name</span>
                        <span class="ml-1.5 text-muted-foreground text-xs">@p.Role at @p.Company</span>
                    </div>
                    <div class="flex shrink-0 flex-col items-end">
                        <span class="font-mono text-xs tabular-nums">@(p.TimeToHire)d</span>
                        <span class="text-muted-foreground text-xs">@p.Time</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expandedRole = "1";

    private record MetricItem(string Label, string Value, string Icon);
    private record FunnelStage(string Name, int Count, string Color);
    private record MonthMetric(string Month, int Placements);
    private record OpenRole(string Id, string Title, string Team, int Candidates, int DaysOpen, string Priority);
    private record PlacementItem(string Name, string Role, string Company, int TimeToHire, string Time);

    private static readonly MetricItem[] _metrics =
    [
        new("Placements", "187", "user-check"),
        new("Active roles", "8", "briefcase"),
        new("Avg days", "23", "clock"),
        new("Accept rate", "94%", "zap"),
    ];

    private static readonly FunnelStage[] _funnel =
    [
        new("Sourced", 342, "bg-blue-500/70"),
        new("Screened", 156, "bg-cyan-500/70"),
        new("Interviewing", 48, "bg-amber-500/70"),
        new("Offer", 12, "bg-emerald-500/70"),
        new("Hired", 8, "bg-emerald-600/70"),
    ];

    private static readonly MonthMetric[] _monthlyMetrics =
    [
        new("Oct", 6),
        new("Nov", 8),
        new("Dec", 4),
        new("Jan", 9),
        new("Feb", 7),
        new("Mar", 5),
    ];

    private static readonly OpenRole[] _openRoles =
    [
        new("1", "Staff Frontend Engineer", "Payments", 24, 12, "high"),
        new("2", "Senior Backend Engineer", "Infrastructure", 18, 28, "high"),
        new("3", "Engineering Manager", "Developer Tools", 9, 35, "medium"),
        new("4", "ML Engineer", "Fraud Detection", 14, 8, "medium"),
        new("5", "DevOps Engineer", "Platform", 6, 45, "low"),
    ];

    private static readonly Dictionary<string, string> _priorityDot = new()
    {
        ["high"] = "bg-red-500",
        ["medium"] = "bg-amber-500",
        ["low"] = "bg-blue-500",
    };

    private static readonly PlacementItem[] _recentPlacements =
    [
        new("James Wu", "Staff Engineer", "Vercel", 18, "1 week ago"),
        new("Anika Patel", "Senior SRE", "Datadog", 22, "2 weeks ago"),
        new("Carlos Mendez", "Tech Lead", "Linear", 31, "3 weeks ago"),
    ];

    private void ToggleRole(string id)
    {
        _expandedRole = _expandedRole == id ? null : id;
    }
}
