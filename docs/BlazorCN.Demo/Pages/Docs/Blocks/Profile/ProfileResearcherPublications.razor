@* ============================================================
   Block: profile-researcher-publications
   Title: ProfileResearcherPublications
   Description: React academic researcher profile block for Next.js with publication list, citation metrics, h-index display, research areas, and co-author network using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-researcher-publications.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Researcher header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Dr. Priya Ramanathan" />
                <AvatarFallbackCn Class="text-lg">PR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Dr. Priya Ramanathan</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="graduation-cap" Size="12" Class="mr-1 size-3" />
                        Faculty
                    </BadgeCn>
                </div>
                <p class="mt-0.5 text-muted-foreground text-xs">Associate Professor of Computer Science</p>
                <p class="text-muted-foreground text-xs">MIT CSAIL</p>
                <div class="mt-2 flex flex-wrap gap-1.5">
                    @foreach (var area in _researchAreas)
                    {
                        <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@area</BadgeCn>
                    }
                </div>
            </div>
        </div>

        @* Citation metrics *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">h-index</span>
                <span class="font-semibold text-2xl tabular-nums">42</span>
            </div>
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Citations</span>
                <span class="font-semibold text-2xl tabular-nums">8.7k</span>
            </div>
            <div class="px-4 py-3">
                <span class="block text-muted-foreground text-xs">Publications</span>
                <span class="font-semibold text-2xl tabular-nums">67</span>
            </div>
        </div>

        @* Co-authors *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
            <span class="font-medium text-muted-foreground text-xs">Frequent co-authors</span>
            <div class="flex flex-1 flex-wrap gap-2">
                @foreach (var author in _coauthors)
                {
                    <span class="text-xs">
                        <span class="font-medium">@author.Name</span>
                        <span class="text-muted-foreground"> (@author.Affiliation)</span>
                    </span>
                }
            </div>
        </div>

        @* Publications with tabs *@
        <TabsCn Value="recent" Class="w-full">
            <div class="border-b px-4 py-1">
                <TabsListCn Class="h-8 bg-transparent p-0">
                    <TabsTriggerCn Value="recent" Class="h-7 text-xs">
                        <LucideIconCn Name="book-open" Size="12" Class="mr-1 size-3" />
                        Recent (@_recentPubs.Length)
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="all" Class="h-7 text-xs">
                        All (@_publications.Length)
                    </TabsTriggerCn>
                </TabsListCn>
            </div>
            <TabsContentCn Value="recent" Class="mt-0">
                @for (var i = 0; i < _recentPubs.Length; i++)
                {
                    var pub = _recentPubs[i];
                    var isLast = i == _recentPubs.Length - 1;
                    RenderPublication(pub, isLast);
                }
            </TabsContentCn>
            <TabsContentCn Value="all" Class="mt-0">
                @for (var i = 0; i < _publications.Length; i++)
                {
                    var pub = _publications[i];
                    var isLast = i == _publications.Length - 1;
                    RenderPublication(pub, isLast);
                }
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private record Publication(string Id, string Title, string Venue, string Year, int Citations, string[] Authors, string Abstract, string Doi);
    private record Coauthor(string Name, string Affiliation);

    private string? _expanded = "p3";

    private readonly string[] _researchAreas =
    [
        "Machine Learning",
        "Natural Language Processing",
        "Information Retrieval",
        "Computational Linguistics",
    ];

    private readonly Publication[] _publications =
    [
        new("p1", "Efficient Attention Mechanisms for Long-Context Language Models", "NeurIPS 2025", "2025", 287,
            ["P. Ramanathan", "J. Liu", "K. Zhang", "M. Patel"],
            "We propose a novel sparse attention mechanism that reduces the quadratic complexity of transformer models to near-linear while maintaining performance on long-context benchmarks. Our approach uses learned routing to select relevant key-value pairs dynamically.",
            "10.1234/neurips.2025.1842"),
        new("p2", "Cross-Lingual Transfer Learning with Minimal Parallel Data", "ACL 2024", "2024", 412,
            ["P. Ramanathan", "S. Kim", "A. Okafor"],
            "This paper presents a cross-lingual transfer framework that achieves state-of-the-art performance on low-resource language tasks using fewer than 1,000 parallel sentences. We leverage shared subword representations and alignment-free training objectives.",
            "10.1234/acl.2024.3291"),
        new("p3", "Retrieval-Augmented Generation for Factual Consistency", "ICML 2024", "2024", 634,
            ["P. Ramanathan", "T. Nakamura", "L. Dubois"],
            "We introduce a retrieval-augmented generation pipeline that significantly reduces hallucination rates in large language models. Our method combines dense passage retrieval with a learned verification module that cross-references generated claims against retrieved evidence.",
            "10.1234/icml.2024.0892"),
        new("p4", "Scaling Laws for Domain-Specific Language Models", "EMNLP 2023", "2023", 891,
            ["P. Ramanathan", "C. Wang", "R. Gupta", "H. Lee"],
            "We establish scaling laws for training language models on domain-specific corpora including biomedical, legal, and scientific text. Our findings show that domain-specific models achieve comparable performance to general models at 3-5x fewer parameters.",
            "10.1234/emnlp.2023.4521"),
        new("p5", "Benchmark Suite for Multilingual Reasoning", "NAACL 2023", "2023", 356,
            ["P. Ramanathan", "M. Garcia", "O. Petrov"],
            "We present a comprehensive benchmark suite for evaluating multilingual reasoning capabilities across 40 languages. The benchmark includes logical reasoning, mathematical problem solving, and commonsense inference tasks with culturally adapted examples.",
            "10.1234/naacl.2023.7823"),
    ];

    private Publication[] _recentPubs => _publications.Where(p => p.Year == "2025" || p.Year == "2024").ToArray();

    private readonly Coauthor[] _coauthors =
    [
        new("J. Liu", "Stanford"),
        new("T. Nakamura", "Google DeepMind"),
        new("S. Kim", "KAIST"),
        new("C. Wang", "Tsinghua University"),
    ];

    private RenderFragment RenderPublication(Publication pub, bool isLast) => __builder =>
    {
        var isExpanded = _expanded == pub.Id;
        <div class="@(isLast ? "" : "border-b")">
            <button type="button"
                    @onclick="@(() => { _expanded = isExpanded ? null : pub.Id; })"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm leading-snug">@pub.Title</span>
                    <div class="mt-1 flex items-center gap-2 text-muted-foreground text-xs">
                        <span>@pub.Venue</span>
                        <span>&middot;</span>
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="quote" Size="12" Class="size-3" />
                            <span class="tabular-nums">@pub.Citations</span>
                        </span>
                    </div>
                </div>
                <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
            </button>
            @if (isExpanded)
            {
                <div class="px-4 pb-4">
                    <div class="rounded-md bg-muted/50 p-3">
                        <p class="mb-2 text-muted-foreground text-xs">@string.Join(", ", pub.Authors)</p>
                        <p class="mb-3 text-sm leading-relaxed">@pub.Abstract</p>
                        <div class="flex items-center justify-between">
                            <span class="font-mono text-muted-foreground text-xs">DOI: @pub.Doi</span>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                                <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                View paper
                            </ButtonCn>
                        </div>
                    </div>
                </div>
            }
        </div>
    };
}
