@* ============================================================
   Block: profile-financial-advisor
   Title: ProfileFinancialAdvisor
   Description: React financial advisor profile block for Next.js with certification badges, AUM metrics, service offerings, and client demographics using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-financial-advisor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="Richard Hahn" />
                <AvatarFallbackCn>RH</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Richard Hahn</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Hahn Wealth Management</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Certified Financial Planner</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">Fee-only fiduciary advisor with 16 years of experience. Specializing in retirement planning, tax optimization, and estate planning for high-net-worth individuals.</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Consult</ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="dollar-sign" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">$240M</span>
                <span class="text-muted-foreground">AUM</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">142</span>
                <span class="text-muted-foreground">clients</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">98%</span>
                <span class="text-muted-foreground">retention</span>
            </span>
        </div>

        @* Credentials *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Credentials</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var cert in _certifications)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                        <LucideIconCn Name="badge-check" Size="12" Class="size-3" />
                        @cert
                    </BadgeCn>
                }
            </div>
        </div>

        @* Services *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Services</span>
            </div>
            @for (var i = 0; i < _services.Length; i++)
            {
                var svc = _services[i];
                var isLast = i == _services.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@svc.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@svc.Description</p>
                        </div>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs">@(svc.MinInvestment)+</span>
                    </div>
                </div>
            }
        </div>

        @* Client Demographics *@
        <div class="px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Client Demographics</span>
            <div class="space-y-2">
                @foreach (var seg in _clientBreakdown)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-32 text-xs">@seg.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="@($"width:{seg.Percentage}%")"></div>
                        </div>
                        <span class="w-8 text-right font-mono text-muted-foreground text-xs tabular-nums">@(seg.Percentage)%</span>
                    </div>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record Service(string Name, string Description, string MinInvestment);
    private record ClientSegment(string Name, int Percentage);

    private static readonly string[] _certifications = ["CFP", "CFA", "ChFC", "Series 65", "Series 7"];

    private static readonly Service[] _services = [
        new("Comprehensive Financial Planning", "Full financial plan with tax, estate, and retirement strategies", "$500K"),
        new("Investment Management", "Active portfolio management with quarterly rebalancing", "$250K"),
        new("Retirement Income Strategy", "Social Security optimization and withdrawal sequencing", "$1M"),
        new("Estate Planning Coordination", "Trust strategies and wealth transfer planning", "$2M"),
    ];

    private static readonly ClientSegment[] _clientBreakdown = [
        new("Retirees", 35),
        new("Executives", 28),
        new("Business Owners", 22),
        new("Medical Professionals", 15),
    ];
}
