@* ============================================================
   Block: profile-open-source-contributor
   Title: ProfileOpenSourceContributor
   Description: React open source contributor profile block for Next.js with repository list, PR stats, review activity, language breakdown, and maintainer badges using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-open-source-contributor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Tomás Andersson" />
                <AvatarFallbackCn Class="text-lg">TA</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Tomás Andersson</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Core contributor</BadgeCn>
                </div>
                <span class="font-mono text-muted-foreground text-xs">@@tomas-dev</span>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">
                    Core contributor to Vite and Vitest. Maintaining 12 open source projects. Passionate about build tooling and DX.
                </p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Sponsor</ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="git-pull-request" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@FormatCount(1847)</span>
                <span class="text-muted-foreground">PRs</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="check-circle" Size="12" Class="size-3 text-emerald-500" />
                <span class="font-medium tabular-nums">@_mergeRate%</span>
                <span class="text-muted-foreground">merged</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="message-square" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@FormatCount(3210)</span>
                <span class="text-muted-foreground">reviews</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="star" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@FormatCount(28400)</span>
            </span>
        </div>

        @* Language breakdown *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex h-2 overflow-hidden rounded-full">
                @foreach (var lang in _languages)
                {
                    <div class="@lang.Color" style="width: @(lang.Percent)%"></div>
                }
            </div>
            <div class="flex flex-wrap gap-3">
                @foreach (var lang in _languages)
                {
                    <span class="flex items-center gap-1.5 text-xs">
                        <span class="@Cn.Merge("size-1.5 rounded-full", lang.Color)"></span>
                        <span class="text-muted-foreground">@lang.Name</span>
                        <span class="font-mono text-muted-foreground text-xs tabular-nums">@(lang.Percent)%</span>
                    </span>
                }
            </div>
        </div>

        @* Tabs: Activity / Repos *@
        <TabsCn Value="activity" Class="w-full">
            <TabsListCn Class="w-full justify-start border-b px-4">
                <TabsTriggerCn Value="activity" Class="text-xs">Activity</TabsTriggerCn>
                <TabsTriggerCn Value="repos" Class="text-xs">Maintained</TabsTriggerCn>
            </TabsListCn>

            @* Activity tab *@
            <TabsContentCn Value="activity" Class="mt-0">
                @for (var i = 0; i < _activities.Length; i++)
                {
                    var act = _activities[i];
                    var isLast = i == _activities.Length - 1;
                    var iconName = act.Type == "pr-merged" ? "git-merge" : act.Type == "review" ? "message-square" : "circle-dot";
                    var iconClass = act.Type == "pr-merged" ? "size-3 text-emerald-600 dark:text-emerald-400"
                                  : act.Type == "review" ? "size-3 text-purple-600 dark:text-purple-400"
                                  : "size-3 text-blue-600 dark:text-blue-400";
                    var dotBg = act.Type == "pr-merged" ? "bg-emerald-500/10"
                               : act.Type == "review" ? "bg-purple-500/10"
                               : "bg-blue-500/10";
                    <div class="@Cn.Merge("flex items-start gap-3 px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                        <span class="@Cn.Merge("mt-1 flex size-5 shrink-0 items-center justify-center rounded-full", dotBg)">
                            <LucideIconCn Name="@iconName" Size="12" Class="@iconClass" />
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@act.Title</span>
                            <div class="mt-0.5 flex items-center gap-1.5 text-muted-foreground text-xs">
                                <span class="font-mono">@act.Repo</span>
                                <span>&middot;</span>
                                <span>@act.Time</span>
                            </div>
                        </div>
                    </div>
                }
            </TabsContentCn>

            @* Repos tab *@
            <TabsContentCn Value="repos" Class="mt-0">
                @for (var i = 0; i < _repos.Length; i++)
                {
                    var repo = _repos[i];
                    var isLast = i == _repos.Length - 1;
                    var isExpanded = _expandedRepo == repo.Name;
                    <div class="@Cn.Merge("", isLast ? "" : "border-b")">
                        <div role="button"
                             tabindex="0"
                             class="flex w-full cursor-pointer items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                             @onclick="@(() => ToggleRepo(repo.Name))">
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@repo.Name</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@repo.Role</BadgeCn>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs">@repo.Description</p>
                            </div>
                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </div>
                        @if (isExpanded)
                        {
                            <div class="px-4 pb-3">
                                <div class="flex items-center gap-4 text-muted-foreground text-xs">
                                    <span class="flex items-center gap-1">
                                        <span class="@Cn.Merge("size-1.5 rounded-full", repo.LanguageColor)"></span>
                                        @repo.Language
                                    </span>
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="star" Size="12" Class="size-3" />
                                        @FormatCount(repo.Stars)
                                    </span>
                                    <span class="flex items-center gap-1">
                                        <LucideIconCn Name="git-fork" Size="12" Class="size-3" />
                                        @repo.Forks
                                    </span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private record ActivityItem(string Id, string Type, string Repo, string Title, string Time);
    private record RepoItem(string Name, string Description, int Stars, int Forks, string Language, string LanguageColor, string Role);
    private record LanguageItem(string Name, int Percent, string Color);

    private static readonly ActivityItem[] _activities =
    [
        new("1", "pr-merged", "vitejs/vite", "fix: resolve CSS modules in monorepo setups", "3h ago"),
        new("2", "review", "vitest-dev/vitest", "feat: add snapshot serializer API", "5h ago"),
        new("3", "pr-merged", "vitejs/vite", "perf: lazy-load plugin containers", "8h ago"),
        new("4", "issue", "tomas-dev/vite-plugin-ssr", "Support for React Server Components", "1d ago"),
        new("5", "review", "unjs/nitro", "fix: WebSocket upgrade handling in dev", "1d ago"),
        new("6", "pr-merged", "tomas-dev/unplugin-auto", "feat: glob pattern support for auto-imports", "2d ago"),
    ];

    private static readonly RepoItem[] _repos =
    [
        new("vite-plugin-ssr", "Like Next.js but as a Vite plugin", 4200, 310, "TypeScript", "bg-blue-500", "owner"),
        new("unplugin-auto", "Auto-import utilities for bundlers", 3100, 180, "TypeScript", "bg-blue-500", "owner"),
        new("vitest", "Next generation testing framework", 12800, 1140, "TypeScript", "bg-blue-500", "maintainer"),
        new("vite", "Next generation frontend tooling", 68200, 6100, "TypeScript", "bg-blue-500", "maintainer"),
    ];

    private static readonly LanguageItem[] _languages =
    [
        new("TypeScript", 72, "bg-blue-500"),
        new("Rust", 14, "bg-amber-600"),
        new("JavaScript", 8, "bg-yellow-400"),
        new("Shell", 6, "bg-emerald-500"),
    ];

    private readonly int _mergeRate = (int)Math.Round(1623.0 / 1847.0 * 100);

    private string? _expandedRepo = null;

    private void ToggleRepo(string name)
    {
        _expandedRepo = _expandedRepo == name ? null : name;
    }

    private static string FormatCount(int n)
    {
        if (n >= 1000) return $"{(n / 1000.0):0.0}k";
        return n.ToString();
    }
}
