@* ============================================================
   Block: profile-data-analyst-reports
   Title: ProfileDataAnalystReports
   Description: React data analyst profile block for Next.js with report gallery, tool proficiency, analysis methodology breakdown, and key findings showcase using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-data-analyst-reports.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarFallbackCn>LK</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Lena Kowalski</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Shopify</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Senior Data Analyst</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                    Translating complex data into actionable business insights. 6 years of experience in e-commerce analytics, A/B testing, and predictive modeling.
                </p>
            </div>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="file-bar-chart" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">156</span>
                <span class="text-muted-foreground">reports</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="database" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">42</span>
                <span class="text-muted-foreground">datasets</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="lightbulb" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">890</span>
                <span class="text-muted-foreground">insights</span>
            </span>
        </div>

        @* Featured Reports *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Featured Reports</span>
            </div>
            @for (var i = 0; i < _reports.Length; i++)
            {
                var report = _reports[i];
                var isLast = i == _reports.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@report.Title</span>
                            <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                                <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@report.Type</BadgeCn>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="table" Size="12" Class="size-3" />
                                    @report.DataPoints
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="lightbulb" Size="12" Class="size-3" />
                                    @report.Findings findings
                                </span>
                            </div>
                        </div>
                        <span class="shrink-0 text-emerald-600 text-xs dark:text-emerald-400">@report.Impact</span>
                    </div>
                </div>
            }
        </div>

        @* Tools / proficiency bars *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Tools</span>
            <div class="space-y-2">
                @foreach (var tool in _tools)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-16 text-xs">@tool.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="width: @(tool.Level)%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Methodologies *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Methodologies</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var m in _methodologies)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@m</BadgeCn>
                }
            </div>
        </div>

    </div>
</section>

@code {
    private record ReportItem(string Id, string Title, string Type, string DataPoints, int Findings, string Impact);
    private record ToolItem(string Name, int Level);

    private static readonly ReportItem[] _reports =
    [
        new("r1", "Q4 Merchant Churn Analysis",    "Predictive",  "2.4M rows",       8,  "Reduced churn by 12%"),
        new("r2", "Checkout Funnel Optimization",  "A/B Testing", "850K sessions",   5,  "+18% completion rate"),
        new("r3", "Marketing Attribution Model",   "Attribution", "1.2M events",     12, "Reallocated $2M budget"),
        new("r4", "Pricing Elasticity Study",      "Statistical", "340K transactions", 6, "+8% revenue per merchant"),
    ];

    private static readonly ToolItem[] _tools =
    [
        new("SQL",     95),
        new("Python",  90),
        new("Tableau", 85),
        new("dbt",     80),
        new("Looker",  75),
    ];

    private static readonly string[] _methodologies =
    [
        "A/B Testing",
        "Regression Analysis",
        "Cohort Analysis",
        "Time Series",
        "Clustering",
        "Attribution Modeling",
    ];
}
