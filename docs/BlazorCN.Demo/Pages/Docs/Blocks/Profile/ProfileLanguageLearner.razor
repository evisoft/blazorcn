@* ============================================================
   Block: profile-language-learner
   Title: ProfileLanguageLearner
   Description: React language learner profile block for Next.js with proficiency level indicators, daily streak counter, vocabulary stats, skill breakdown radar-style bars, and recent lesson history using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-language-learner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="Liam Tanaka" />
                <AvatarFallbackCn>LT</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Liam Tanaka</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">Polyglot in training. Software engineer by day, language nerd by night. Currently focusing on Korean and Mandarin.</p>
            </div>
        </div>

        @* Streak and XP *@
        <div class="grid grid-cols-3 gap-px border-b bg-border">
            <div class="flex items-center justify-center gap-2 bg-card px-4 py-3">
                <LucideIconCn Name="flame" Size="16" Class="size-4 text-amber-500" />
                <div class="text-center">
                    <span class="block font-semibold text-xl tabular-nums">147</span>
                    <span class="text-muted-foreground text-xs">day streak</span>
                </div>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <span class="block font-semibold text-xl tabular-nums">42.8K</span>
                <span class="text-muted-foreground text-xs">total XP</span>
            </div>
            <div class="bg-card px-4 py-3 text-center">
                <span class="block font-semibold text-xl tabular-nums">3.4K</span>
                <span class="text-muted-foreground text-xs">words learned</span>
            </div>
        </div>

        @* Language proficiency *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Languages</span>
            </div>
            @for (var i = 0; i < _languages.Length; i++)
            {
                var lang = _languages[i];
                <div class="@Cn.Merge("px-4 py-3", i < _languages.Length - 1 ? "border-b" : "")">
                    <div class="flex items-center gap-3">
                        <span class="flex size-7 shrink-0 items-center justify-center rounded-md bg-muted/50 font-mono text-xs">
                            @lang.Flag
                        </span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between">
                                <span class="font-medium text-sm">@lang.Name</span>
                                <div class="flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="font-mono font-normal text-xs">@lang.Level</BadgeCn>
                                </div>
                            </div>
                            <div class="mt-1.5 flex items-center gap-2">
                                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted/50">
                                    <div class="@($"h-full rounded-full {lang.Color}")" style="@($"width: {lang.Progress}%")"></div>
                                </div>
                                <span class="shrink-0 font-mono text-muted-foreground text-xs tabular-nums">
                                    @lang.Progress%
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Skill breakdown *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">
                Overall skills
            </span>
            <div class="space-y-2">
                @foreach (var skill in _skills)
                {
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="@skill.Icon" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                        <span class="w-16 shrink-0 text-xs">@skill.Label</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted/50">
                            <div class="h-full rounded-full bg-foreground/70" style="@($"width: {skill.Score}%")"></div>
                        </div>
                        <span class="w-6 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
                            @skill.Score
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Recent lessons *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent lessons</span>
            </div>
            @for (var i = 0; i < _recentLessons.Length; i++)
            {
                var lesson = _recentLessons[i];
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", i < _recentLessons.Length - 1 ? "border-b" : "")">
                    <LucideIconCn Name="zap" Size="14" Class="size-3.5 shrink-0 text-amber-500" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@lesson.Title</span>
                        <div class="mt-0.5 flex items-center gap-2">
                            <span class="text-muted-foreground text-xs">@lesson.Language</span>
                            <span class="text-muted-foreground text-xs">·</span>
                            <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@_typeLabel[lesson.Type]</BadgeCn>
                        </div>
                    </div>
                    <div class="shrink-0 text-right">
                        <span class="font-mono text-xs tabular-nums">+@lesson.Xp XP</span>
                        <span class="block text-muted-foreground text-xs">@lesson.Time</span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record LanguageItem(string Name, string Flag, string Level, int Progress, string Color);
    private record SkillItem(string Label, int Score, string Icon);
    private record LessonItem(string Id, string Title, string Language, int Xp, string Time, string Type);

    private static readonly LanguageItem[] _languages = [
        new("Japanese", "JP", "B2", 72, "bg-red-500"),
        new("Korean",   "KR", "B1", 45, "bg-blue-500"),
        new("Mandarin", "CN", "A2", 83, "bg-amber-500"),
        new("Spanish",  "ES", "C1", 30, "bg-emerald-500"),
    ];

    private static readonly SkillItem[] _skills = [
        new("Reading",   78, "book-open"),
        new("Writing",   62, "pen-tool"),
        new("Listening", 85, "headphones"),
        new("Speaking",  54, "message-circle"),
    ];

    private static readonly LessonItem[] _recentLessons = [
        new("l1", "Restaurant ordering phrases", "Korean",   45, "2 hours ago", "conversation"),
        new("l2", "Kanji radical recognition",   "Japanese", 60, "5 hours ago", "reading"),
        new("l3", "Tone pairs practice",          "Mandarin", 35, "Yesterday",   "vocabulary"),
        new("l4", "Particle usage patterns",      "Japanese", 50, "Yesterday",   "grammar"),
        new("l5", "Subjunctive mood review",      "Spanish",  40, "2 days ago",  "grammar"),
    ];

    private static readonly Dictionary<string, string> _typeLabel = new()
    {
        ["vocabulary"]   = "Vocab",
        ["grammar"]      = "Grammar",
        ["conversation"] = "Convo",
        ["reading"]      = "Reading",
    };
}
