@* ============================================================
   Block: profile-gaming-stats
   Title: ProfileGamingStats
   Description: React gaming stats profile block for Next.js with rank badge, match history, KDA ratio, win rate progress bars, and weapon loadout display using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-gaming-stats.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Player header *@
        <div class="flex items-center gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="PhantomStrike" />
                <AvatarFallbackCn Class="text-lg">PS</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">PhantomStrike</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                        <span class="size-1.5 rounded-full bg-purple-500"></span>
                        Diamond II
                    </BadgeCn>
                </div>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span>Level 247</span>
                    <span class="text-muted-foreground">&#183;</span>
                    <span>1,842h played</span>
                    <span class="text-muted-foreground">&#183;</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="flame" Size="12" Class="size-3 text-amber-500" />
                        5 win streak
                    </span>
                </div>
            </div>
        </div>

        @* KDA Stats row *@
        <div class="grid grid-cols-4 border-b">
            <div class="px-4 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">2.32</span>
                <span class="text-muted-foreground text-xs">KDA</span>
            </div>
            <div class="px-4 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">58.4%</span>
                <span class="text-muted-foreground text-xs">Win Rate</span>
            </div>
            <div class="px-4 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">42.1%</span>
                <span class="text-muted-foreground text-xs">HS %</span>
            </div>
            <div class="px-4 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">1.2k</span>
                <span class="text-muted-foreground text-xs">Matches</span>
            </div>
        </div>

        @* Tabs *@
        <TabsCn Value="@_tab" ValueChanged="@((string v) => { _tab = v; })">
            <div class="border-b px-4">
                <TabsListCn Class="h-9 w-full justify-start gap-4 rounded-none border-none bg-transparent p-0">
                    <TabsTriggerCn Value="overview" Class="h-9 rounded-none border-transparent border-b-2 bg-transparent px-0 font-medium text-xs data-[state=active]:border-foreground data-[state=active]:shadow-none">
                        Matches
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="weapons" Class="h-9 rounded-none border-transparent border-b-2 bg-transparent px-0 font-medium text-xs data-[state=active]:border-foreground data-[state=active]:shadow-none">
                        Weapons
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="achievements" Class="h-9 rounded-none border-transparent border-b-2 bg-transparent px-0 font-medium text-xs data-[state=active]:border-foreground data-[state=active]:shadow-none">
                        Achievements
                    </TabsTriggerCn>
                </TabsListCn>
            </div>

            <TabsContentCn Value="overview" Class="m-0">
                @for (var i = 0; i < _matches.Length; i++)
                {
                    var match = _matches[i];
                    var dotColor = match.Result == "win" ? "bg-emerald-500" : "bg-red-500";
                    var scoreColor = match.Result == "win" ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400";
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", i < _matches.Length - 1 ? "border-b" : "")">
                        <span class="@($"size-1.5 shrink-0 rounded-full {dotColor}")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@match.Map</span>
                                <span class="text-muted-foreground text-xs">@match.Agent</span>
                            </div>
                            <span class="text-muted-foreground text-xs">@match.Mode</span>
                        </div>
                        <div class="flex items-center gap-4 text-xs">
                            <span class="flex items-center gap-1 text-muted-foreground">
                                <LucideIconCn Name="crosshair" Size="12" Class="size-3" />
                                @match.Kills/@match.Deaths
                            </span>
                            <span class="@($"font-medium tabular-nums {scoreColor}")">@match.Score</span>
                        </div>
                    </div>
                }
            </TabsContentCn>

            <TabsContentCn Value="weapons" Class="m-0 px-4 py-3">
                <div class="space-y-3">
                    @foreach (var weapon in _weapons)
                    {
                        <div>
                            <div class="mb-1 flex items-center justify-between">
                                <span class="flex items-center gap-2 font-medium text-sm">
                                    <LucideIconCn Name="sword" Size="12" Class="size-3 text-muted-foreground" />
                                    @weapon.Name
                                </span>
                                <span class="text-muted-foreground text-xs">@FormatNumber(weapon.Kills) kills</span>
                            </div>
                            <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground/70" style="@($"width: {weapon.Pct}%")"></div>
                            </div>
                        </div>
                    }
                </div>
            </TabsContentCn>

            <TabsContentCn Value="achievements" Class="m-0">
                @for (var i = 0; i < _achievements.Length; i++)
                {
                    var ach = _achievements[i];
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", i < _achievements.Length - 1 ? "border-b" : "")">
                        <div class="flex size-8 items-center justify-center rounded-md bg-muted/50">
                            <LucideIconCn Name="@ach.Icon" Size="16" Class="size-4 text-muted-foreground" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@ach.Label</span>
                        </div>
                        <span class="text-muted-foreground text-xs">@ach.Date</span>
                    </div>
                }
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private string _tab = "overview";

    private record MatchItem(string Id, string Map, string Mode, string Result, string Score, int Kills, int Deaths, string Agent);
    private record WeaponItem(string Name, int Kills, int Pct);
    private record AchievementItem(string Icon, string Label, string Date);

    private static readonly MatchItem[] _matches = [
        new("m1", "Ascent", "Competitive", "win", "13-7", 24, 12, "Jett"),
        new("m2", "Haven", "Competitive", "win", "13-11", 19, 17, "Reyna"),
        new("m3", "Bind", "Competitive", "loss", "8-13", 14, 18, "Jett"),
        new("m4", "Icebox", "Competitive", "win", "13-5", 28, 9, "Raze"),
        new("m5", "Split", "Competitive", "loss", "11-13", 21, 16, "Jett"),
    ];

    private static readonly WeaponItem[] _weapons = [
        new("Vandal", 5841, 41),
        new("Phantom", 3987, 28),
        new("Operator", 1994, 14),
        new("Sheriff", 1139, 8),
        new("Spectre", 854, 6),
    ];

    private static readonly AchievementItem[] _achievements = [
        new("flame", "50 Kill Game", "Mar 2"),
        new("trophy", "Diamond Rank", "Feb 18"),
        new("zap", "Ace Clutch", "Feb 10"),
        new("shield", "1000 Wins", "Jan 28"),
    ];

    private static string FormatNumber(int n)
    {
        if (n >= 1000) return $"{(n / 1000.0):F1}k";
        return n.ToString();
    }
}
