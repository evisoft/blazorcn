@* ============================================================
   Block: profile-developer-card
   Title: ProfileDeveloperCard
   Description: React developer profile card block for Next.js with GitHub-style contribution grid, language badges, pinned repositories, and follower stats using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-developer-card.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Profile header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="@_profile.Avatar" Alt="@_profile.Name" />
                <AvatarFallbackCn Class="text-lg">EV</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_profile.Name</span>
                    <span class="font-mono text-muted-foreground text-xs">@@evasquez</span>
                </div>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">@_profile.Bio</p>
                <div class="mt-2 flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                    @_profile.Location
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Follow
            </ButtonCn>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@FormatCount(_profile.Followers)</span>
                <span class="text-muted-foreground">followers</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <span class="font-medium tabular-nums">@_profile.Following</span>
                <span class="text-muted-foreground">following</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="book-open" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_profile.Repos</span>
                <span class="text-muted-foreground">repos</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="star" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@FormatCount(_profile.Stars)</span>
            </span>
        </div>

        @* Contributions + Languages *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div>
                <span class="mb-2 block font-medium text-muted-foreground text-xs">
                    Contributions
                </span>
                <div class="flex gap-1">
                    @for (var colIdx = 0; colIdx < _contributions[0].Length; colIdx++)
                    {
                        var col = colIdx;
                        <div class="flex flex-col gap-1">
                            @for (var rowIdx = 0; rowIdx < _contributions.Length; rowIdx++)
                            {
                                var row = rowIdx;
                                var level = _contributions[row][col];
                                var opacity = _opacityMap[level];
                                <span class="@Cn.Merge("size-2.5 rounded-sm bg-emerald-500", opacity)"></span>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="flex-1">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">Languages</span>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var lang in _languages)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                            <span class="@Cn.Merge("size-1.5 rounded-full", lang.Color)"></span>
                            @lang.Name
                        </BadgeCn>
                    }
                </div>
            </div>
        </div>

        @* Pinned repos *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Pinned repositories</span>
            </div>
            @for (var i = 0; i < _pinnedRepos.Length; i++)
            {
                var repo = _pinnedRepos[i];
                var isLast = i == _pinnedRepos.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm text-blue-600 dark:text-blue-400">
                                @repo.Name
                            </span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@repo.Description</p>
                        </div>
                    </div>
                    <div class="mt-2 flex items-center gap-3 text-muted-foreground text-xs">
                        <span class="flex items-center gap-1">
                            <span class="@Cn.Merge("size-1.5 rounded-full", repo.LanguageColor)"></span>
                            @repo.Language
                        </span>
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="star" Size="12" Class="size-3" />
                            @FormatCount(repo.Stars)
                        </span>
                        <span class="flex items-center gap-1">
                            <LucideIconCn Name="git-fork" Size="12" Class="size-3" />
                            @repo.Forks
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ProfileInfo(string Name, string Username, string Avatar, string Bio, string Location,
        int Followers, int Following, int Repos, int Stars);

    private record LanguageItem(string Name, string Color);

    private record PinnedRepo(string Name, string Description, string Language, string LanguageColor,
        int Stars, int Forks);

    private static readonly ProfileInfo _profile = new(
        "Elena Vasquez", "evasquez", "",
        "Staff Engineer at Vercel. Building developer tools and open-source libraries. Rust enthusiast.",
        "San Francisco, CA",
        4218, 312, 87, 12400
    );

    private static readonly LanguageItem[] _languages =
    [
        new("TypeScript", "bg-blue-500"),
        new("Rust", "bg-amber-600"),
        new("Go", "bg-cyan-500"),
        new("Python", "bg-emerald-500"),
    ];

    // 7 rows x 4 columns, values 0-4 representing activity levels
    private static readonly int[][] _contributions =
    [
        [0, 1, 2, 3],
        [1, 0, 4, 2],
        [2, 3, 1, 0],
        [4, 2, 0, 1],
        [1, 4, 3, 2],
        [0, 1, 2, 4],
        [3, 0, 1, 2],
    ];

    private static readonly Dictionary<int, string> _opacityMap = new()
    {
        { 0, "opacity-10" },
        { 1, "opacity-25" },
        { 2, "opacity-50" },
        { 3, "opacity-75" },
        { 4, "opacity-100" },
    };

    private static readonly PinnedRepo[] _pinnedRepos =
    [
        new("fast-bundler", "A zero-config bundler for modern web apps", "Rust", "bg-amber-600", 3420, 218),
        new("react-signals", "Fine-grained reactivity primitives for React", "TypeScript", "bg-blue-500", 1890, 142),
        new("edge-cache", "Distributed caching layer for edge runtimes", "Go", "bg-cyan-500", 956, 73),
    ];

    private static string FormatCount(int n)
    {
        if (n >= 1000) return $"{(n / 1000.0):0.0}k";
        return n.ToString();
    }
}
