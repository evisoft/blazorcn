@* ============================================================
   Block: profile-journalist-bylines
   Title: ProfileJournalistBylines
   Description: React journalist profile block for Next.js with article bylines, beat coverage areas, publication history, and award nominations using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-journalist-bylines.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header: avatar + bio *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarFallbackCn>ST</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">@_profile.Name</span>
                <p class="text-muted-foreground text-xs">@_profile.Title</p>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">@_profile.Bio</p>
            </div>
        </div>

        @* Stats row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="pen-tool" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_profile.Articles</span>
                <span class="text-muted-foreground">articles</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="newspaper" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_profile.Publications</span>
                <span class="text-muted-foreground">publications</span>
            </span>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="award" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">@_profile.Awards</span>
                <span class="text-muted-foreground">awards</span>
            </span>
        </div>

        @* Beats *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Beats</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var beat in _beats)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@beat</BadgeCn>
                }
            </div>
        </div>

        @* Recent Bylines *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent Bylines</span>
            </div>
            @for (var i = 0; i < _recentArticles.Length; i++)
            {
                var article = _recentArticles[i];
                var isLast = i == _recentArticles.Length - 1;
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                    <div class="flex items-start gap-2">
                        @if (article.Featured)
                        {
                            <LucideIconCn Name="trending-up" Size="12" Class="mt-0.5 size-3 shrink-0 text-amber-500" />
                        }
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@article.ArticleTitle</span>
                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@article.Publication</span>
                                <span>&middot;</span>
                                <span class="flex items-center gap-1">
                                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                    @article.Date
                                </span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@article.Beat</BadgeCn>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Awards *@
        <div>
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Awards</span>
            </div>
            @for (var i = 0; i < _awardHighlights.Length; i++)
            {
                var award = _awardHighlights[i];
                var isLast = i == _awardHighlights.Length - 1;
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5", isLast ? "" : "border-b")">
                    <LucideIconCn Name="award" Size="14" Class="size-3.5 shrink-0 text-amber-500" />
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@award.AwardName</span>
                        <span class="ml-2 text-muted-foreground text-xs">@award.Status</span>
                    </div>
                    <span class="font-mono text-muted-foreground text-xs">@award.Year</span>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ProfileData(string Name, string Title, string Bio, int Articles, int Publications, int Awards);

    private static readonly ProfileData _profile = new(
        Name: "Sarah Thornton",
        Title: "Investigative Journalist",
        Bio: "Covering technology, surveillance, and civil liberties for The Washington Post. Previously at The Atlantic and ProPublica. Pulitzer finalist 2024.",
        Articles: 380,
        Publications: 12,
        Awards: 8
    );

    private static readonly string[] _beats =
    [
        "Privacy & Surveillance",
        "Tech Policy",
        "Civil Liberties",
        "AI Ethics",
        "Cybersecurity",
    ];

    private record ArticleItem(string Id, string ArticleTitle, string Publication, string Date, string Beat, bool Featured = false);

    private static readonly ArticleItem[] _recentArticles =
    [
        new("a1", "The Hidden Cost of Smart City Surveillance", "The Washington Post", "Mar 18, 2026", "Privacy", true),
        new("a2", "Inside the AI Lobbying Machine", "The Washington Post", "Mar 4, 2026", "Tech Policy", true),
        new("a3", "How Schools Are Fighting the Deepfake Crisis", "The Atlantic", "Feb 22, 2026", "Education"),
        new("a4", "The Encryption Wars, Round Three", "The Washington Post", "Feb 10, 2026", "Security"),
        new("a5", "Who Owns Your Biometric Data?", "ProPublica", "Jan 28, 2026", "Privacy"),
    ];

    private record AwardItem(string AwardName, string Status, string Year);

    private static readonly AwardItem[] _awardHighlights =
    [
        new("Pulitzer Prize", "Finalist", "2024"),
        new("George Polk Award", "Winner", "2023"),
        new("IRE Medal", "Winner", "2022"),
    ];
}
