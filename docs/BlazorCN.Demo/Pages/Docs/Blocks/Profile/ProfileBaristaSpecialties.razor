@* ============================================================
   Block: profile-barista-specialties
   Title: ProfileBaristaSpecialties
   Description: React barista profile block for Next.js with specialty drink menu, brewing methods, certification badges, and tasting notes using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-barista-specialties.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="Sofia Martinez" />
                <AvatarFallbackCn>SM</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Sofia Martinez</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Origin Roasters</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Head Barista &amp; Coffee Specialist</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">SCA-certified barista with 7 years of experience. Latte art champion 2024. Passionate about single-origin pour-overs and sustainable sourcing.</p>
            </div>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="coffee" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">24</span>
                <span class="text-muted-foreground">drinks</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="award" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">8</span>
                <span class="text-muted-foreground">competitions</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideIconCn Name="star" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium tabular-nums">4.9</span>
                <span class="text-muted-foreground">rating</span>
            </span>
        </div>

        @* Certifications *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Certifications</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var cert in _certifications)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                        <LucideIconCn Name="leaf" Size="12" Class="size-3" />
                        @cert
                    </BadgeCn>
                }
            </div>
        </div>

        @* Specialty Menu *@
        <div class="border-b">
            <div class="flex items-center gap-2 border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Specialty Menu</span>
                <div class="ml-auto flex gap-1">
                    @foreach (var cat in _categories)
                    {
                        var catCapture = cat;
                        <ButtonCn Variant="@(_activeCategory == catCapture ? ButtonVariant.Secondary : ButtonVariant.Ghost)" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs" OnClick="@(() => _activeCategory = catCapture)">@catCapture</ButtonCn>
                    }
                </div>
            </div>
            @for (var i = 0; i < _specialtyDrinks.Length; i++)
            {
                var drink = _specialtyDrinks[i];
                var isLast = i == _specialtyDrinks.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b"))">
                    <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@drink.Name</span>
                                @if (drink.Popular)
                                {
                                    <LucideIconCn Name="flame" Size="12" Class="size-3 text-amber-500" />
                                }
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@drink.Description</p>
                            <div class="mt-1.5 flex gap-1">
                                @foreach (var tag in drink.Tags)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@tag</BadgeCn>
                                }
                            </div>
                        </div>
                        <span class="shrink-0 font-medium text-sm tabular-nums">@drink.Price</span>
                    </div>
                </div>
            }
        </div>

        @* Brewing Expertise *@
        <div class="px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Brewing Expertise</span>
            <div class="space-y-2">
                @foreach (var method in _brewingMethods)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-20 text-xs">@method.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="@($"width:{method.Level}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record DrinkItem(string Id, string Name, string Description, string Price, string[] Tags, bool Popular = false);
    private record BrewingMethod(string Name, int Level);

    private string _activeCategory = "All";

    private static readonly string[] _certifications = ["SCA Barista Skills", "Q Grader", "Latte Art Champion", "Roasting Fundamentals"];

    private static readonly string[] _categories = ["All", "Espresso", "Pour-Over", "Cold", "Signature"];

    private static readonly DrinkItem[] _specialtyDrinks =
    [
        new("d1", "Ethiopian Yirgacheffe Pour-Over", "Floral, bergamot, and stone fruit notes", "$6.50", ["Single Origin", "Light Roast"], Popular: true),
        new("d2", "Oat Milk Lavender Latte", "House-made lavender syrup with oat milk", "$7.00", ["Signature", "Plant-Based"]),
        new("d3", "Japanese Iced Coffee", "Flash-brewed over ice for a clean finish", "$5.50", ["Cold", "Seasonal"]),
        new("d4", "Cortado con Miel", "Double ristretto with honey and steamed milk", "$5.00", ["Espresso", "Sweet"], Popular: true),
    ];

    private static readonly BrewingMethod[] _brewingMethods =
    [
        new("Espresso", 95),
        new("Pour-Over", 90),
        new("Aeropress", 85),
        new("Siphon", 75),
        new("Cold Brew", 80),
    ];
}
