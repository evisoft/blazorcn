@* ============================================================
   Block: profile-startup-founder
   Title: ProfileStartupFounder
   Description: React startup founder profile block for Next.js with funding timeline, team size metrics, product milestones, and investor highlights using shadcn/ui, Tailwind CSS, and framer-motion animations
   Source: original/blocks/profile/profile-startup-founder.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Founder header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarFallbackCn Class="text-lg">MC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Marcus Chen</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="rocket" Size="12" Class="mr-1 size-3" />
                        Founder
                    </BadgeCn>
                </div>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    Co-founder &amp; CEO at Synthwave AI
                </p>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">Former ML lead at Stripe. Building the next generation of AI-powered developer tools. YC W23.</p>
                <div class="mt-2 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Austin, TX
                    </span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                        Founded 2023
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                <LucideIconCn Name="external-link" Size="12" Class="mr-1 size-3" />
                Website
            </ButtonCn>
        </div>

        @* Key metrics *@
        <div class="grid grid-cols-4 border-b">
            @for (var i = 0; i < _metrics.Length; i++)
            {
                var metric = _metrics[i];
                var isLast = i == _metrics.Length - 1;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-r")">
                    <span class="block text-muted-foreground text-xs">@metric.Label</span>
                    <div class="mt-0.5 flex items-baseline gap-1.5">
                        <span class="font-semibold text-lg tabular-nums">@metric.Value</span>
                        <span class="flex items-center text-emerald-600 text-xs dark:text-emerald-400">
                            <LucideIconCn Name="trending-up" Size="12" Class="mr-0.5 size-3" />
                            @metric.Trend
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Funding timeline *@
        <div class="border-b">
            <div class="flex items-center gap-2 px-4 py-2">
                <LucideIconCn Name="briefcase" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Funding rounds</span>
            </div>
            <div class="relative px-4 pb-3">
                @* Timeline line *@
                <div class="absolute top-0 bottom-3 left-[29px] w-px bg-border"></div>
                @foreach (var round in _fundingRounds)
                {
                    <div class="relative flex items-center gap-3 py-2 pl-4">
                        <span class="@Cn.Merge("relative z-10 size-2 shrink-0 rounded-full", round.Status == "completed" ? "bg-emerald-500" : "bg-amber-500")"></span>
                        <div class="flex flex-1 items-center justify-between">
                            <div>
                                <span class="font-medium text-sm">@round.Round</span>
                                <span class="ml-2 font-semibold text-sm tabular-nums">@round.Amount</span>
                            </div>
                            <div class="flex items-center gap-2 text-muted-foreground text-xs">
                                <span>@round.Lead</span>
                                <span>&middot;</span>
                                <span>@round.Date</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Milestones *@
        <div>
            <div class="flex items-center gap-2 border-b px-4 py-2">
                <LucideIconCn Name="users" Size="12" Class="size-3 text-muted-foreground" />
                <span class="font-medium text-muted-foreground text-xs">Product milestones</span>
            </div>
            @for (var i = 0; i < _milestones.Length; i++)
            {
                var milestone = _milestones[i];
                var idx = i;
                var isExpanded = _expandedMilestone == idx;
                var isLast = idx == _milestones.Length - 1;
                <div class="@(isLast ? "" : "border-b")">
                    <button type="button" @onclick="@(() => SetExpanded(idx))" class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _statusStyles[milestone.Status])"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@milestone.Title</span>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">@milestone.Date</span>
                        <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="flex items-center gap-2">
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs capitalize">
                                        @milestone.Status.Replace("-", " ")
                                    </BadgeCn>
                                    <span class="text-muted-foreground text-xs">
                                        Target: @milestone.Date
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record MetricItem(string Label, string Value, string Trend);
    private record FundingRound(string Round, string Amount, string Date, string Lead, string Status);
    private record Milestone(string Title, string Date, string Status);

    private static readonly MetricItem[] _metrics =
    [
        new("ARR", "$4.2M", "+127%"),
        new("Team", "38", "+12"),
        new("Customers", "820", "+45%"),
        new("NPS", "72", "+8"),
    ];

    private static readonly FundingRound[] _fundingRounds =
    [
        new("Pre-seed", "$500K", "Jan 2023", "Y Combinator", "completed"),
        new("Seed", "$3.8M", "Aug 2023", "Sequoia Capital", "completed"),
        new("Series A", "$18M", "Mar 2024", "Andreessen Horowitz", "completed"),
        new("Series B", "$45M", "Nov 2025", "In progress", "in-progress"),
    ];

    private static readonly Milestone[] _milestones =
    [
        new("Public launch on Product Hunt (#1)", "Mar 2023", "completed"),
        new("Enterprise tier with SOC 2 compliance", "Sep 2023", "completed"),
        new("Series A close and team expansion", "Mar 2024", "completed"),
        new("API v2 with streaming support", "Jan 2025", "completed"),
        new("International expansion (EU, APAC)", "Q2 2026", "in-progress"),
        new("IPO readiness assessment", "Q4 2026", "upcoming"),
    ];

    private static readonly Dictionary<string, string> _statusStyles = new()
    {
        ["completed"] = "bg-emerald-500",
        ["in-progress"] = "bg-amber-500",
        ["upcoming"] = "bg-muted-foreground/30",
    };

    private int? _expandedMilestone = null;

    private void SetExpanded(int idx)
    {
        _expandedMilestone = _expandedMilestone == idx ? null : idx;
    }
}
