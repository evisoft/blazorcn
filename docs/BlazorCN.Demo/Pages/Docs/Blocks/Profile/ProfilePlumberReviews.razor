@* ============================================================
   Block: profile-plumber-reviews
   Title: ProfilePlumberReviews
   Description: React plumber reviews profile block for Next.js with service reviews, rating breakdown, license verification, service area coverage, and emergency availability using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-plumber-reviews.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Robert Mitchell" />
                <AvatarFallbackCn Class="text-lg">RM</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Robert Mitchell</span>
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-blue-500" />
                </div>
                <span class="text-muted-foreground text-xs">
                    Master Plumber — Mitchell Plumbing &amp; Drain
                </span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Seattle, WA
                    </span>
                    <span>·</span>
                    <span class="font-mono">WA #PL-045821</span>
                </div>
                <div class="mt-0.5 flex items-center gap-3 text-xs">
                    <span class="text-muted-foreground">22 years</span>
                    <span class="text-muted-foreground">·</span>
                    <span class="flex items-center gap-1 text-red-600 dark:text-red-400">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        24/7 Emergency
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                <LucideIconCn Name="phone" Size="12" Class="mr-1 size-3" />
                Call
            </ButtonCn>
        </div>

        @* Rating overview *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-4">
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums">4.8</span>
                    <span class="text-muted-foreground text-xs">/5</span>
                </div>
                <div class="flex items-center gap-0.5">
                    @for (var i = 0; i < 5; i++)
                    {
                        var filled = i < (int)Math.Round(4.8);
                        <LucideIconCn Name="star" Size="14" Class="@(Cn.Merge("size-3.5", filled ? "fill-amber-500 text-amber-500" : "text-muted-foreground/30"))" />
                    }
                </div>
                <span class="text-muted-foreground text-xs">(347 reviews)</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="text-muted-foreground text-xs">5,200 jobs</span>
            </div>
            <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-3">
                @foreach (var item in _ratingBreakdown)
                {
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted-foreground">@item.Label</span>
                        <span class="font-medium tabular-nums">@item.Score</span>
                    </div>
                }
            </div>
        </div>

        @* Response time + services *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center gap-2 text-xs">
                <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-muted-foreground">Avg response time:</span>
                <span class="font-medium">&lt; 2 hours</span>
            </div>
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Services</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var svc in _services)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@svc</BadgeCn>
                }
            </div>
        </div>

        @* Reviews *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent Reviews</span>
            </div>
            @for (var i = 0; i < _reviews.Length; i++)
            {
                var review = _reviews[i];
                var isLast = i == _reviews.Length - 1;
                <div class="@(Cn.Merge("px-4 py-3", isLast ? "" : "border-b"))">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">@review.Name</span>
                        <div class="flex items-center gap-0.5">
                            @for (var j = 0; j < review.Rating; j++)
                            {
                                <LucideIconCn Name="star" Size="10" Class="size-2.5 fill-amber-500 text-amber-500" />
                            }
                        </div>
                        <span class="ml-auto text-muted-foreground text-xs">@review.Date</span>
                    </div>
                    <span class="text-muted-foreground text-xs">@review.Service</span>
                    <p class="mt-1 text-sm leading-relaxed">@review.Text</p>
                </div>
            }
        </div>

        @* Service areas *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">
                Service Areas
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var area in _serviceAreas)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                        <LucideIconCn Name="map-pin" Size="10" Class="size-2.5" />
                        @area
                    </BadgeCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record RatingItem(string Label, double Score);
    private record Review(string Name, string Date, int Rating, string Service, string Text);

    private static readonly RatingItem[] _ratingBreakdown =
    [
        new("Quality of work", 4.9),
        new("Punctuality", 4.7),
        new("Communication", 4.8),
        new("Value for money", 4.6),
        new("Cleanliness", 4.9),
    ];

    private static readonly string[] _services =
    [
        "Drain Cleaning",
        "Pipe Repair",
        "Water Heater",
        "Sewer Line",
        "Leak Detection",
        "Bathroom Remodel",
        "Gas Line",
        "Sump Pump",
    ];

    private static readonly string[] _serviceAreas =
    [
        "Seattle",
        "Bellevue",
        "Kirkland",
        "Redmond",
        "Renton",
        "Bothell",
        "Lynnwood",
        "Shoreline",
    ];

    private static readonly Review[] _reviews =
    [
        new("Jennifer W.", "2 weeks ago", 5, "Water Heater Replacement",
            "Robert replaced our water heater same day. Explained all our options, fair pricing, and cleaned up perfectly."),
        new("Mark T.", "1 month ago", 5, "Emergency Drain Clearing",
            "Called at 10pm on a Sunday for a backed up kitchen drain. Robert was here in 90 minutes. Life saver."),
        new("Lisa K.", "1 month ago", 4, "Bathroom Remodel",
            "Great work on the full bathroom renovation. Took slightly longer than estimated but the quality is excellent."),
    ];
}
