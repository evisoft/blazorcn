@* ============================================================
   Block: profile-fitness-tracker
   Title: Profile Fitness Tracker
   Description: Fitness tracking profile with daily stats grid, weekly goal progress bars, workout history list, and activity metrics
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, LucideActivityCn, LucideBikeCn, LucideFlameCn, LucideFootprintsCn, LucideHeartPulseCn, LucideMountainCn, LucideTargetCn, LucideTimerCn, LucideTrendingUpCn
   Source: original/blocks/profile/profile-fitness-tracker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-9">
                <AvatarImageCn Src="" Alt="Ava Thompson" />
                <AvatarFallbackCn>AT</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Ava Thompson</span>
                <div class="flex items-center gap-2 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1"><LucideFlameCn Size="12" Class="text-amber-500" />14-day streak</span>
                    <span>&#183;</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Advanced</BadgeCn>
                </div>
            </div>
            <span class="text-muted-foreground text-xs">Today</span>
        </div>

        @* 4-column stats grid *@
        <div class="grid grid-cols-4 border-b">
            @for (var i = 0; i < _todayStats.Length; i++)
            {
                var stat = _todayStats[i];
                <div class="@($"px-3 py-3 text-center {(i < 3 ? "border-r" : "")}")">
                    @if (stat.IconType == "footprints")
                    {
                        <LucideFootprintsCn Size="16" Class="mx-auto mb-1 text-muted-foreground" />
                    }
                    else if (stat.IconType == "flame")
                    {
                        <LucideFlameCn Size="16" Class="mx-auto mb-1 text-muted-foreground" />
                    }
                    else if (stat.IconType == "activity")
                    {
                        <LucideActivityCn Size="16" Class="mx-auto mb-1 text-muted-foreground" />
                    }
                    else if (stat.IconType == "timer")
                    {
                        <LucideTimerCn Size="16" Class="mx-auto mb-1 text-muted-foreground" />
                    }
                    <span class="block font-semibold text-lg tabular-nums">@stat.Value</span>
                    @if (!string.IsNullOrEmpty(stat.Unit))
                    {
                        <span class="text-muted-foreground text-xs">@stat.Unit</span>
                    }
                    <span class="mt-0.5 block text-muted-foreground text-xs">@stat.Label</span>
                    @* Mini progress *@
                    <div class="mx-auto mt-1.5 h-1 w-12 overflow-hidden rounded-full bg-muted">
                        <div class="h-full rounded-full bg-foreground/60" style="@($"width: {stat.Progress}%")"></div>
                    </div>
                </div>
            }
        </div>

        @* Weekly goals *@
        <div class="border-b px-4 py-4">
            <div class="mb-3 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Weekly goals</span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideTargetCn Size="12" />
                    @(_weeklyGoals.Count(g => g.Current >= g.Target))/@_weeklyGoals.Length met
                </span>
            </div>
            <div class="space-y-3">
                @foreach (var goal in _weeklyGoals)
                {
                    var pct = Math.Min((int)Math.Round(goal.Current / goal.Target * 100), 100);
                    <div>
                        <div class="mb-1 flex items-center justify-between text-xs">
                            <span>@goal.Label</span>
                            <span class="text-muted-foreground tabular-nums">@goal.CurrentDisplay / @goal.TargetDisplay @goal.Unit</span>
                        </div>
                        <div class="h-2 overflow-hidden rounded-full bg-muted">
                            <div class="@($"h-full rounded-full {(pct >= 100 ? "bg-emerald-500" : "bg-foreground/60")}")" style="@($"width: {pct}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Workout history *@
        <div>
            <div class="flex items-center justify-between border-b px-4 py-2.5">
                <span class="font-medium text-muted-foreground text-xs">Recent workouts</span>
                <span class="flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideTrendingUpCn Size="12" Class="text-emerald-500" />
                    @_workouts.Length this week
                </span>
            </div>
            @for (var i = 0; i < _workouts.Length; i++)
            {
                var workout = _workouts[i];
                var dotColor = workout.Type switch { "run" => "bg-blue-500", "cycle" => "bg-emerald-500", "strength" => "bg-amber-500", "hike" => "bg-cyan-500", "hiit" => "bg-red-500", _ => "bg-muted-foreground" };
                <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50", i < _workouts.Length - 1 ? "border-b" : "")">
                    <div class="relative flex size-8 shrink-0 items-center justify-center rounded-full bg-muted/50 text-muted-foreground">
                        @if (workout.Type == "run")
                        {
                            <LucideFootprintsCn Size="14" />
                        }
                        else if (workout.Type == "cycle")
                        {
                            <LucideBikeCn Size="14" />
                        }
                        else if (workout.Type == "strength")
                        {
                            <LucideActivityCn Size="14" />
                        }
                        else if (workout.Type == "hike")
                        {
                            <LucideMountainCn Size="14" />
                        }
                        else if (workout.Type == "hiit")
                        {
                            <LucideHeartPulseCn Size="14" />
                        }
                        <span class="@($"absolute -top-0.5 -right-0.5 size-2 rounded-full {dotColor}")"></span>
                    </div>
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-sm">@workout.Name</span>
                            <span class="text-muted-foreground text-xs">@workout.Date</span>
                        </div>
                        <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                            <span>@workout.Duration</span>
                            <span>&#183;</span>
                            <span>@workout.Calories cal</span>
                            @if (!string.IsNullOrEmpty(workout.Distance))
                            {
                                <span>&#183;</span>
                                <span>@workout.Distance</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record StatItem(string IconType, string Value, string? Unit, string Label, int Progress);
    private record GoalItem(string Label, double Current, double Target, string CurrentDisplay, string TargetDisplay, string Unit);
    private record WorkoutItem(string Id, string Type, string Name, string Duration, int Calories, string Date, string? Distance);

    private readonly StatItem[] _todayStats = [
        new("footprints", "8,432", null, "Steps", 84),
        new("flame", "1,847", null, "Calories", 84),
        new("activity", "5.2", "mi", "Distance", 87),
        new("timer", "47", "min", "Active min", 78),
    ];

    private readonly GoalItem[] _weeklyGoals = [
        new("Workouts completed", 4, 5, "4", "5", "sessions"),
        new("Total distance", 28.4, 35, "28.4", "35", "mi"),
        new("Calories burned", 9240, 12000, "9,240", "12,000", "cal"),
    ];

    private readonly WorkoutItem[] _workouts = [
        new("1", "run", "Morning Run", "32 min", 380, "Today", "3.8 mi"),
        new("2", "strength", "Upper Body", "45 min", 290, "Today", null),
        new("3", "cycle", "Evening Ride", "55 min", 520, "Yesterday", "14.2 mi"),
        new("4", "hiit", "Interval Training", "25 min", 340, "Yesterday", null),
        new("5", "hike", "Trail Hike", "1h 20min", 610, "2 days ago", "5.6 mi"),
    ];
}
