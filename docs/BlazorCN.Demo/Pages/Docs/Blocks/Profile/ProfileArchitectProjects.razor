@* ============================================================
   Block: profile-architect-projects
   Title: Profile Architect Projects
   Description: React architect projects profile block for Next.js with project gallery cards, award listings, building typology breakdown, and sustainability metrics using shadcn/ui, Tailwind CSS, and framer-motion
   Long Description: Freelancer services and pricing
   Dependencies: AvatarCn, AvatarFallbackCn, AvatarImageCn, BadgeCn, ButtonCn, TabsCn, TabsContentCn, TabsListCn, TabsTriggerCn
   Source: original/blocks/profile/profile-architect-projects.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Architect header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Daniel Sorensen" />
                <AvatarFallbackCn Class="text-lg">DS</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Daniel Sorensen</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideBuildingCn Class="mr-1 size-3" Size="12" />
                        AIA
                    </BadgeCn>
                </div>
                <p class="mt-0.5 text-muted-foreground text-xs">Principal Architect, AIA LEED AP</p>
                <p class="text-muted-foreground text-xs">Sorensen + Park Studio</p>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">Award-winning architect focused on sustainable urban design. 18 years shaping public spaces and mixed-use developments across North America.</p>
                <div class="mt-2 flex items-center gap-1 text-muted-foreground text-xs">
                    <LucideMapPinCn Class="size-3" Size="12" />
                    Chicago, IL
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Contact</ButtonCn>
        </div>

        @* Career metrics *@
        <div class="grid grid-cols-3 border-b">
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Projects</span>
                <span class="font-semibold text-2xl tabular-nums">42</span>
            </div>
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Total sq ft</span>
                <span class="font-semibold text-2xl tabular-nums">3.2M</span>
            </div>
            <div class="px-4 py-3">
                <span class="block text-muted-foreground text-xs">Awards</span>
                <span class="font-semibold text-2xl tabular-nums">14</span>
            </div>
        </div>

        @* Tabs *@
        <TabsCn DefaultValue="projects">
            <div class="border-b px-4 py-1">
                <TabsListCn Class="h-8 bg-transparent p-0">
                    <TabsTriggerCn Value="projects" Class="h-7 text-xs">
                        <LucideRulerCn Class="mr-1 size-3" Size="12" />
                        Projects
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="typology" Class="h-7 text-xs">
                        <LucideBuildingCn Class="mr-1 size-3" Size="12" />
                        Typology
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="awards" Class="h-7 text-xs">
                        <LucideAwardCn Class="mr-1 size-3" Size="12" />
                        Awards
                    </TabsTriggerCn>
                </TabsListCn>
            </div>

            <TabsContentCn Value="projects" Class="mt-0">
                @for (var idx = 0; idx < _projects.Length; idx++)
                {
                    var project = _projects[idx];
                    var isExpanded = _expandedProject == project.Id;
                    var isLast = idx == _projects.Length - 1;
                    var style = _statusStyles[project.Status];
                    <div class="@(isLast ? "" : "border-b")">
                        <button type="button" @onclick="@(() => ToggleProject(project.Id))"
                                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                            <span class="@($"size-1.5 shrink-0 rounded-full {style.Dot}")"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium text-sm">@project.Name</span>
                                    @if (!string.IsNullOrEmpty(project.Certification))
                                    {
                                        var certColor = GetCertColor(project.Certification);
                                        <span class="flex items-center gap-0.5 text-xs">
                                            <LucideLeafCn Class="@($"size-3 {certColor}")" Size="12" />
                                            <span class="@($"font-medium {certColor}")">@project.Certification</span>
                                        </span>
                                    }
                                </div>
                                <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                    <span>@project.Type</span>
                                    <span>&#xB7;</span>
                                    <span>@project.Location</span>
                                    <span>&#xB7;</span>
                                    <span>@project.SqFt sq ft</span>
                                </div>
                            </div>
                            <span class="shrink-0 text-muted-foreground text-xs">@project.Year</span>
                            <LucideChevronRightCn Class="@($"size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200 {(isExpanded ? "rotate-90" : "")}")" Size="16" />
                        </button>
                        @if (isExpanded)
                        {
                            <div class="px-4 pb-3 pl-9">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <p class="mb-2 text-sm leading-relaxed">@project.Description</p>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                        <span class="@($"mr-1.5 size-1.5 rounded-full {style.Dot}")"></span>
                                        @style.Label
                                    </BadgeCn>
                                </div>
                            </div>
                        }
                    </div>
                }
            </TabsContentCn>

            <TabsContentCn Value="typology" Class="mt-0 px-4 py-3">
                <div class="space-y-3">
                    @foreach (var typ in _typologies)
                    {
                        <div>
                            <div class="flex items-center justify-between text-xs">
                                <span class="font-medium text-sm">@typ.Name</span>
                                <span class="text-muted-foreground">
                                    <span class="font-medium tabular-nums">@typ.Count</span> projects &#xB7; @(typ.Pct)%
                                </span>
                            </div>
                            <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground/60" style="@($"width: {typ.Pct}%")"></div>
                            </div>
                        </div>
                    }
                </div>
                <div class="mt-4 flex items-center gap-3 rounded-md bg-muted/50 p-3">
                    <LucideLeafCn Class="size-4 text-emerald-500" Size="16" />
                    <div>
                        <span class="font-medium text-xs">Sustainability focus</span>
                        <p class="text-muted-foreground text-xs">78% of projects achieve LEED Gold or higher certification</p>
                    </div>
                </div>
            </TabsContentCn>

            <TabsContentCn Value="awards" Class="mt-0">
                @for (var i = 0; i < _awards.Length; i++)
                {
                    var award = _awards[i];
                    <div class="@($"flex items-center gap-3 px-4 py-3 transition-colors hover:bg-muted/50 {(i < _awards.Length - 1 ? "border-b" : "")}")">
                        <LucideAwardCn Class="size-4 shrink-0 text-amber-500" Size="16" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@award.Name</span>
                            <p class="mt-0.5 text-muted-foreground text-xs">@award.Project</p>
                        </div>
                        <span class="shrink-0 text-muted-foreground text-xs">@award.Year</span>
                    </div>
                }
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private record ProjectItem(string Id, string Name, string Type, string Location, string SqFt, string Year, string Status, string? Certification, string Description);
    private record TypologyItem(string Name, int Count, int Pct);
    private record AwardItem(string Name, string Project, string Year);
    private record StatusStyle(string Dot, string Label);

    private string? _expandedProject = "p1";

    private void ToggleProject(string id)
    {
        _expandedProject = _expandedProject == id ? null : id;
    }

    private static string GetCertColor(string cert) => cert switch
    {
        "LEED Platinum" => "text-emerald-700 dark:text-emerald-400",
        "LEED Gold" => "text-amber-700 dark:text-amber-400",
        _ => "text-muted-foreground",
    };

    private readonly Dictionary<string, StatusStyle> _statusStyles = new()
    {
        ["completed"] = new("bg-emerald-500", "Completed"),
        ["in-progress"] = new("bg-amber-500", "In progress"),
        ["design"] = new("bg-blue-500", "Design phase"),
    };

    private readonly ProjectItem[] _projects =
    [
        new("p1", "Lakeshore Cultural Center", "Cultural", "Chicago, IL", "145,000", "2025", "in-progress", "LEED Platinum", "A 145,000 sq ft cultural center on Lake Michigan with performance venues, gallery spaces, and community workshop areas. Targeting net-zero energy."),
        new("p2", "Union Quarter Mixed-Use", "Mixed-Use", "Denver, CO", "320,000", "2024", "completed", "LEED Gold", "Transit-oriented development with 180 residential units, ground-floor retail, and a public courtyard. Mass timber structural system."),
        new("p3", "Greenway Office Campus", "Commercial", "Austin, TX", "210,000", "2023", "completed", "LEED Platinum", "Three-building office campus connected by a landscaped greenway. Features operable facades, rainwater harvesting, and on-site solar."),
        new("p4", "Harbor View Residences", "Residential", "Portland, OR", "88,000", "2023", "completed", null, "32-unit affordable housing development with shared rooftop gardens and community spaces. Passive House certified."),
        new("p5", "Civic Library Renovation", "Institutional", "Milwaukee, WI", "62,000", "2026", "design", "LEED Gold", "Adaptive reuse of a 1920s civic building into a modern public library. Preserving the original limestone facade while adding a glass atrium."),
    ];

    private readonly TypologyItem[] _typologies =
    [
        new("Mixed-Use", 14, 33),
        new("Commercial", 10, 24),
        new("Residential", 8, 19),
        new("Cultural", 6, 14),
        new("Institutional", 4, 10),
    ];

    private readonly AwardItem[] _awards =
    [
        new("AIA National Honor Award", "Union Quarter Mixed-Use", "2025"),
        new("Progressive Architecture Award", "Lakeshore Cultural Center", "2024"),
        new("AICP Excellence Award", "Greenway Office Campus", "2024"),
        new("Chicago Architecture Biennial Selection", "Harbor View Residences", "2023"),
    ];
}
