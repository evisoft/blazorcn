@* ============================================================
   Block: profile-instructor-courses
   Title: ProfileInstructorCourses
   Description: React online instructor profile block for Next.js with course catalog, student ratings, enrollment stats, and curriculum progress bars using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-instructor-courses.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Instructor header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="@_instructor.Avatar" Alt="@_instructor.Name" />
                <AvatarFallbackCn Class="text-lg">SM</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_instructor.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Top Instructor</BadgeCn>
                </div>
                <p class="mt-0.5 text-muted-foreground text-xs">@_instructor.Specialty</p>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">@_instructor.Bio</p>
            </div>
        </div>

        @* Teaching stats *@
        <div class="grid grid-cols-4 border-b">
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Students</span>
                <span class="font-semibold text-lg tabular-nums">@FormatStudents(_instructor.TotalStudents)</span>
            </div>
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Rating</span>
                <div class="flex items-center gap-1.5">
                    <span class="font-semibold text-lg tabular-nums">@_instructor.AvgRating</span>
                    <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" />
                </div>
            </div>
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Courses</span>
                <span class="font-semibold text-lg tabular-nums">@_instructor.TotalCourses</span>
            </div>
            <div class="px-4 py-3">
                <span class="block text-muted-foreground text-xs">Hours</span>
                <span class="font-semibold text-lg tabular-nums">@_instructor.TotalHours</span>
            </div>
        </div>

        @* Course catalog *@
        <div class="border-b px-4 py-2">
            <span class="font-medium text-muted-foreground text-xs">Popular courses</span>
        </div>
        @for (var i = 0; i < _courses.Length; i++)
        {
            var course = _courses[i];
            var isLast = i == _courses.Length - 1;
            var levelCss = GetLevelStyle(course.Level);
            <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0 flex-1">
                        <div class="flex items-center gap-2">
                            <LucideIconCn Name="play-circle" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                            <span class="font-medium text-sm">@course.Title</span>
                        </div>
                        <div class="mt-1.5 flex items-center gap-3 text-muted-foreground text-xs">
                            <span class="flex items-center gap-1">
                                <LucideIconCn Name="users" Size="12" Class="size-3" />
                                @FormatStudents(course.Students)
                            </span>
                            <span class="flex items-center gap-0.5">
                                @for (var s = 0; s < 5; s++)
                                {
                                    var starIdx = s;
                                    var starCss = starIdx < (int)Math.Round(course.Rating) ? "size-3 fill-amber-500 text-amber-500" : "size-3 text-muted-foreground/30";
                                    <LucideIconCn Name="star" Size="12" Class="@starCss" />
                                }
                                <span class="ml-1 tabular-nums">@course.Rating</span>
                                <span>(@(FormatStudents(course.Reviews)))</span>
                            </span>
                        </div>
                        <div class="mt-1.5 flex items-center gap-3 text-muted-foreground text-xs">
                            <span class="flex items-center gap-1">
                                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                @(course.Hours)h
                            </span>
                            <span class="flex items-center gap-1">
                                <LucideIconCn Name="book-open" Size="12" Class="size-3" />
                                @(course.Lessons) lessons
                            </span>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("font-normal text-xs", levelCss)">
                                @course.Level
                            </BadgeCn>
                        </div>
                    </div>
                    <div class="w-24 shrink-0">
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">Completion</span>
                            <span class="font-medium tabular-nums">@(course.CompletionRate)%</span>
                        </div>
                        <ProgressCn Value="@course.CompletionRate" Class="mt-1 h-1.5" aria-label="Progress" />
                    </div>
                </div>
            </div>
        }

        @* Student reviews *@
        <div class="border-t">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Student reviews</span>
            </div>
            @for (var i = 0; i < _reviews.Length; i++)
            {
                var review = _reviews[i];
                var isLast = i == _reviews.Length - 1;
                <div class="@Cn.Merge("px-4 py-3", isLast ? "" : "border-b")">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-xs">@review.Author</span>
                        <span class="text-muted-foreground text-xs">on @review.Course</span>
                        <div class="ml-auto flex gap-0.5">
                            @for (var s = 0; s < 5; s++)
                            {
                                var starIdx = s;
                                var starCss = starIdx < (int)Math.Round((double)review.Rating) ? "size-3 fill-amber-500 text-amber-500" : "size-3 text-muted-foreground/30";
                                <LucideIconCn Name="star" Size="12" Class="@starCss" />
                            }
                        </div>
                    </div>
                    <p class="mt-1 text-muted-foreground text-sm leading-relaxed">@review.Text</p>
                </div>
            }
        </div>

        @* CTA *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                Top 1% instructor globally
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View all courses</ButtonCn>
        </div>
    </div>
</section>

@code {
    private record InstructorInfo(string Name, string Title, string Specialty, string Avatar, string Bio,
        int TotalStudents, double AvgRating, int TotalCourses, int TotalHours);

    private record CourseItem(string Id, string Title, string Category, int Students, double Rating,
        int Reviews, int Hours, int Lessons, int CompletionRate, string Level);

    private record ReviewItem(string Id, string Author, string Course, string Text, int Rating);

    private static readonly InstructorInfo _instructor = new(
        Name: "Sarah Mitchell",
        Title: "Senior Instructor",
        Specialty: "Full-Stack Development & System Design",
        Avatar: "",
        Bio: "15 years in software engineering. Former tech lead at Netflix. Teaching 200K+ students worldwide.",
        TotalStudents: 214580,
        AvgRating: 4.8,
        TotalCourses: 12,
        TotalHours: 186
    );

    private static readonly CourseItem[] _courses =
    [
        new("c1", "System Design for Production", "Architecture", 48200, 4.9, 6720, 24, 142, 67, "Advanced"),
        new("c2", "React & Next.js Masterclass", "Frontend", 72400, 4.8, 9340, 36, 218, 58, "Intermediate"),
        new("c3", "Node.js Microservices", "Backend", 31800, 4.7, 4210, 28, 164, 72, "Advanced"),
        new("c4", "TypeScript From Zero to Hero", "Language", 62180, 4.9, 8450, 18, 96, 81, "Beginner"),
    ];

    private static readonly ReviewItem[] _reviews =
    [
        new("r1", "Alex P.", "System Design for Production",
            "Best system design course I've taken. Real-world examples from Netflix, Uber, and Stripe.", 5),
        new("r2", "Maria L.", "React & Next.js Masterclass",
            "Sarah explains complex concepts with incredible clarity. The project-based approach is excellent.", 5),
    ];

    private static string FormatStudents(int n) =>
        n >= 1000 ? $"{(n / 1000.0):F1}k" : n.ToString();

    private static string GetLevelStyle(string level) => level switch
    {
        "Beginner" => "bg-emerald-500/10 text-emerald-700 dark:text-emerald-400",
        "Intermediate" => "bg-blue-500/10 text-blue-700 dark:text-blue-400",
        "Advanced" => "bg-purple-500/10 text-purple-700 dark:text-purple-400",
        _ => ""
    };
}
