@* ============================================================
   Block: profile-sports-coach
   Title: ProfileSportsCoach
   Description: React sports coach profile block for Next.js with team win/loss record, season schedule, player roster overview, coaching philosophy, and achievement badges using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-sports-coach.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Coach Marcus Jefferson" />
                <AvatarFallbackCn Class="text-lg">MJ</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Coach Marcus Jefferson</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="trophy" Size="12" Class="mr-1 size-3" />
                        4x Champ
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Head Basketball Coach — Lincoln Eagles</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span>Lincoln Preparatory Academy</span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Atlanta, GA
                    </span>
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Contact</ButtonCn>
        </div>

        @* Record *@
        <div class="grid grid-cols-4 border-b">
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">412</span>
                <span class="text-muted-foreground text-xs">Wins</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">124</span>
                <span class="text-muted-foreground text-xs">Losses</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">76.9%</span>
                <span class="text-muted-foreground text-xs">Win %</span>
            </div>
            <div class="px-3 py-3 text-center">
                <span class="block font-semibold text-2xl tabular-nums">18</span>
                <span class="text-muted-foreground text-xs">Years</span>
            </div>
        </div>

        @* Achievements *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Achievements</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var achievement in _achievements)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 font-normal text-xs">
                        <LucideIconCn Name="award" Size="10" Class="size-2.5" />
                        @achievement
                    </BadgeCn>
                }
            </div>
        </div>

        @* Recent games *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Schedule &amp; Results</span>
            </div>
            @for (var i = 0; i < _recentGames.Length; i++)
            {
                var game = _recentGames[i];
                var resultCss = _resultColor.TryGetValue(game.Result, out var rc) ? rc : "";
                var resultLabel = game.Result == "upcoming" ? "—" : game.Result;
                var scoreClass = game.Result == "upcoming" ? "text-muted-foreground" : "";
                <div class="@($"flex items-center gap-3 px-4 py-2.5 {(i < _recentGames.Length - 1 ? "border-b" : "")}")">
                    <span class="w-14 text-muted-foreground text-xs">@game.Date</span>
                    <span class="@($"w-5 font-medium text-xs {resultCss}")">@resultLabel</span>
                    <span class="flex-1 font-medium text-sm">@game.Opponent</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                        @(game.Location == "home" ? "Home" : "Away")
                    </BadgeCn>
                    <span class="@($"w-16 text-right font-mono text-xs tabular-nums {scoreClass}")">@game.Score</span>
                </div>
            }
        </div>

        @* Roster + Philosophy *@
        <div class="flex gap-0 divide-x">
            <div class="flex-1 px-4 py-3">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">Roster (@_totalPlayers players)</span>
                <div class="space-y-1">
                    @foreach (var r in _roster)
                    {
                        <div class="flex items-center justify-between text-xs">
                            <span class="text-muted-foreground">@r.Position</span>
                            <span class="font-medium tabular-nums">@r.Count</span>
                        </div>
                    }
                </div>
            </div>
            <div class="flex-1 px-4 py-3">
                <span class="mb-2 block font-medium text-muted-foreground text-xs">Philosophy</span>
                <div class="space-y-1">
                    @foreach (var p in _philosophy)
                    {
                        <div class="flex items-center gap-1.5 text-xs">
                            <span class="size-1 shrink-0 rounded-full bg-foreground/40"></span>
                            <span class="text-muted-foreground">@p</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Game(string Id, string Opponent, string Date, string Result, string Score, string Location);
    private record RosterEntry(string Position, int Count);

    private static readonly string[] _achievements =
    [
        "4x State Champion",
        "6x Conference Champion",
        "Coach of the Year 2024",
        "14 Playoff Appearances",
        "42 D1 College Commits",
    ];

    private static readonly Dictionary<string, string> _resultColor = new()
    {
        ["W"] = "text-emerald-600 dark:text-emerald-400",
        ["L"] = "text-red-600 dark:text-red-400",
        ["upcoming"] = "text-muted-foreground",
    };

    private static readonly Game[] _recentGames =
    [
        new("g1", "Westfield Lions", "Mar 22", "W", "78-64", "home"),
        new("g2", "East Ridge Hawks", "Mar 18", "W", "82-71", "away"),
        new("g3", "North Valley Bears", "Mar 14", "L", "68-72", "away"),
        new("g4", "Southside Panthers", "Mar 10", "W", "91-58", "home"),
        new("g5", "Central Tigers", "Mar 28", "upcoming", "7:00 PM", "home"),
    ];

    private static readonly RosterEntry[] _roster =
    [
        new("Guards", 6),
        new("Forwards", 5),
        new("Centers", 3),
    ];

    private static readonly string[] _philosophy =
    [
        "Defense-first mentality",
        "High-tempo transition offense",
        "Player development over wins",
        "Academic excellence required",
    ];

    private int _totalPlayers => _roster.Sum(r => r.Count);
}
