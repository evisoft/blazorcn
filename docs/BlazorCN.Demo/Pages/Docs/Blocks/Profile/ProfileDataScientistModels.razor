@* ============================================================
   Block: profile-data-scientist-models
   Title: ProfileDataScientistModels
   Description: React data scientist profile block for Next.js with ML model registry, performance metrics, dataset badges, experiment history, and accuracy benchmarks using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-data-scientist-models.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Scientist header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarFallbackCn Class="text-lg">YT</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">@_scientist.Name</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        <LucideIconCn Name="brain" Size="12" Class="mr-1 size-3" />
                        ML Engineer
                    </BadgeCn>
                </div>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @_scientist.Title at @_scientist.Org
                </p>
                <p class="mt-1.5 text-muted-foreground text-sm leading-relaxed">@_scientist.Bio</p>
            </div>
        </div>

        @* Key metrics *@
        <div class="grid grid-cols-4 border-b">
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Models</span>
                <span class="font-semibold text-lg tabular-nums">@_scientist.TotalModels</span>
            </div>
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Deployed</span>
                <span class="font-semibold text-lg text-emerald-600 tabular-nums dark:text-emerald-400">@_scientist.DeployedModels</span>
            </div>
            <div class="border-r px-4 py-3">
                <span class="block text-muted-foreground text-xs">Experiments</span>
                <span class="font-semibold text-lg tabular-nums">@_scientist.Experiments.ToString("N0")</span>
            </div>
            <div class="px-4 py-3">
                <span class="block text-muted-foreground text-xs">Papers</span>
                <span class="font-semibold text-lg tabular-nums">@_scientist.Papers</span>
            </div>
        </div>

        @* Skills *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                <LucideIconCn Name="cpu" Size="12" Class="size-3" />
                Technical skills
            </span>
            <div class="grid grid-cols-2 gap-x-6 gap-y-2">
                @foreach (var skill in _skills)
                {
                    <div>
                        <div class="flex items-center justify-between text-xs">
                            <span class="font-medium">@skill.Name</span>
                            <span class="font-mono text-muted-foreground tabular-nums">@(skill.Level)%</span>
                        </div>
                        <div class="mt-1 h-1 w-full overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/60" style="@($"width:{skill.Level}%")"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Datasets *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 flex items-center gap-1.5 font-medium text-muted-foreground text-xs">
                <LucideIconCn Name="database" Size="12" Class="size-3" />
                Datasets used
            </span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var ds in _datasets)
                {
                    <BadgeCn Variant="BadgeVariant.Outline" Class="font-mono font-normal text-xs">@ds</BadgeCn>
                }
            </div>
        </div>

        @* Tabs: Models / Experiments *@
        <TabsCn Value="models" Class="w-full">
            <div class="border-b px-4 py-1">
                <TabsListCn Class="h-8 bg-transparent p-0">
                    <TabsTriggerCn Value="models" Class="h-7 text-xs">
                        <LucideIconCn Name="server" Size="12" Class="mr-1 size-3" />
                        Models (@_models.Length)
                    </TabsTriggerCn>
                    <TabsTriggerCn Value="experiments" Class="h-7 text-xs">
                        <LucideIconCn Name="flask-conical" Size="12" Class="mr-1 size-3" />
                        Experiments
                    </TabsTriggerCn>
                </TabsListCn>
            </div>

            <TabsContentCn Value="models" Class="mt-0">
                @for (var i = 0; i < _models.Length; i++)
                {
                    var model = _models[i];
                    var isLast = i == _models.Length - 1;
                    var isExpanded = _expandedModel == model.Id;
                    var statusDot = _statusDots[model.Status];
                    var statusLabel = _statusLabels[model.Status];
                    var capturedModel = model;
                    <div class="@(isLast ? "" : "border-b")">
                        <button type="button"
                                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                                @onclick="@(() => ToggleModel(capturedModel.Id))">
                            <span class="@($"size-1.5 shrink-0 rounded-full {statusDot}")"></span>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-mono font-medium text-sm">@model.Name</span>
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@model.Params</BadgeCn>
                                </div>
                                <p class="mt-0.5 text-muted-foreground text-xs">@model.Task</p>
                            </div>
                            <div class="shrink-0 text-right">
                                <span class="font-semibold text-sm tabular-nums">@(model.Score)%</span>
                                <p class="text-muted-foreground text-xs">@model.Metric</p>
                            </div>
                            <LucideIconCn Name="chevron-right" Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>
                        @if (isExpanded)
                        {
                            var perfBarColor = model.Status == "production" ? "bg-emerald-500" : "bg-amber-500";
                            <div class="px-4 pb-3 pl-9">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="mb-2 flex items-center gap-3 text-xs">
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                            <span class="@($"mr-1.5 size-1.5 rounded-full {statusDot}")"></span>
                                            @statusLabel
                                        </BadgeCn>
                                        <span class="text-muted-foreground">
                                            <LucideIconCn Name="rocket" Size="12" Class="mr-1 inline size-3" />
                                            Trained @model.LastTrained
                                        </span>
                                    </div>
                                    <div class="mb-2">
                                        <span class="text-muted-foreground text-xs">Performance</span>
                                        <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-muted">
                                            <div class="@($"h-full rounded-full {perfBarColor}")" style="@($"width:{model.Score}%")"></div>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                        <LucideIconCn Name="database" Size="12" Class="size-3" />
                                        <span>Trained on @model.Dataset</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </TabsContentCn>

            <TabsContentCn Value="experiments" Class="mt-0">
                @for (var i = 0; i < _experiments.Length; i++)
                {
                    var exp = _experiments[i];
                    var isLast = i == _experiments.Length - 1;
                    var deltaColor = exp.Positive
                        ? "text-emerald-600 dark:text-emerald-400"
                        : "text-red-600 dark:text-red-400";
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                        <LucideIconCn Name="git-branch" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-mono font-medium text-xs">@exp.Name</span>
                            </div>
                            <p class="mt-0.5 text-muted-foreground text-xs">@exp.Change</p>
                        </div>
                        <div class="shrink-0 text-right">
                            <div class="flex items-center gap-1.5">
                                <span class="font-mono text-xs tabular-nums">@exp.Result</span>
                                <span class="@($"flex items-center font-mono text-xs tabular-nums {deltaColor}")">
                                    <LucideIconCn Name="activity" Size="12" Class="mr-0.5 size-3" />
                                    @exp.Delta
                                </span>
                            </div>
                            <span class="text-muted-foreground text-xs">@exp.Date</span>
                        </div>
                    </div>
                }
            </TabsContentCn>
        </TabsCn>
    </div>
</section>

@code {
    private record ScientistInfo(string Name, string Title, string Org, string Bio, int TotalModels, int DeployedModels, int Experiments, int Papers);
    private record SkillItem(string Name, int Level);
    private record ModelItem(string Id, string Name, string Task, string Metric, double Score, string Params, string Status, string LastTrained, string Dataset);
    private record ExperimentItem(string Id, string Name, string Model, string Change, string Result, string Delta, bool Positive, string Date);

    private static readonly ScientistInfo _scientist = new(
        "Dr. Yuki Tanaka",
        "Senior ML Engineer",
        "Anthropic",
        "Building large language models and reasoning systems. PhD in Machine Learning from Stanford. Previously at Google Brain.",
        23, 8, 1420, 16
    );

    private static readonly SkillItem[] _skills =
    [
        new("PyTorch", 95),
        new("Transformers", 92),
        new("JAX", 85),
        new("MLOps / Kubeflow", 78),
        new("Distributed Training", 88),
        new("RLHF", 82),
    ];

    private static readonly ModelItem[] _models =
    [
        new("m1", "reasoning-v3", "Chain-of-Thought Reasoning", "Accuracy", 94.2, "70B", "production", "2 weeks ago", "GSM8K + MATH"),
        new("m2", "retrieval-qa-v2", "Retrieval-Augmented QA", "F1", 91.8, "13B", "production", "1 month ago", "Natural Questions"),
        new("m3", "code-review-v1", "Code Review Classification", "F1", 89.4, "7B", "staging", "3 days ago", "CodeReview-50K"),
        new("m4", "sentiment-multi-v2", "Multilingual Sentiment", "Accuracy", 87.6, "3B", "production", "3 months ago", "MultiSent-120K"),
        new("m5", "summarizer-long", "Long Document Summarization", "ROUGE-L", 82.3, "13B", "archived", "6 months ago", "BookSum + arXiv"),
    ];

    private static readonly ExperimentItem[] _experiments =
    [
        new("e1", "reasoning-v3-lr-sweep", "reasoning-v3", "Learning rate 3e-5 → 1e-5", "94.2%", "+1.3%", true, "2 weeks ago"),
        new("e2", "reasoning-v3-data-aug", "reasoning-v3", "Added MATH dataset", "92.9%", "+2.1%", true, "3 weeks ago"),
        new("e3", "code-review-v1-lora", "code-review-v1", "LoRA rank 16 → 64", "89.4%", "+0.8%", true, "3 days ago"),
        new("e4", "retrieval-qa-chunk-size", "retrieval-qa-v2", "Chunk size 512 → 1024", "91.2%", "-0.6%", false, "1 month ago"),
        new("e5", "summarizer-long-rope", "summarizer-long", "RoPE scaling 4x context", "82.3%", "+1.1%", true, "6 months ago"),
    ];

    private static readonly string[] _datasets =
    [
        "GSM8K", "MATH", "Natural Questions", "CodeReview-50K",
        "MultiSent-120K", "BookSum", "arXiv Abstracts", "HumanEval",
    ];

    private static readonly Dictionary<string, string> _statusDots = new()
    {
        ["production"] = "bg-emerald-500",
        ["staging"] = "bg-amber-500",
        ["archived"] = "bg-muted-foreground/40",
    };

    private static readonly Dictionary<string, string> _statusLabels = new()
    {
        ["production"] = "Production",
        ["staging"] = "Staging",
        ["archived"] = "Archived",
    };

    private string? _expandedModel = "m1";

    private void ToggleModel(string id)
    {
        _expandedModel = _expandedModel == id ? null : id;
    }
}
