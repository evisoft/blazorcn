@* ============================================================
   Block: profile-pilot-flight-log
   Title: ProfilePilotFlightLog
   Description: React pilot flight log profile block for Next.js with total flight hours, aircraft type ratings, recent flights, certificate details, and flight hour breakdown chart using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-pilot-flight-log.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-14">
                <AvatarImageCn Src="" Alt="Captain David Chen" />
                <AvatarFallbackCn Class="text-lg">DC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Captain David Chen</span>
                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-blue-500" />
                </div>
                <span class="text-muted-foreground text-xs">Airline Transport Pilot</span>
                <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="plane" Size="12" Class="size-3" />
                        Pacific Airways
                    </span>
                    <span>·</span>
                    <span class="flex items-center gap-1">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        San Francisco, CA
                    </span>
                </div>
                <div class="mt-0.5 font-mono text-muted-foreground text-xs">
                    ATP — AMEL/ASES
                </div>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Contact
            </ButtonCn>
        </div>

        @* Total hours *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold text-2xl tabular-nums">12,480</span>
                <span class="text-muted-foreground text-xs">total hours</span>
            </div>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-xs">
                <span class="font-medium tabular-nums">18</span>
                <span class="text-muted-foreground"> years</span>
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="flex items-center gap-1 text-xs">
                <LucideIconCn Name="gauge" Size="12" Class="size-3 text-muted-foreground" />
                <span class="text-muted-foreground">First Class Medical</span>
            </span>
        </div>

        @* Hour breakdown bars *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Flight Hours by Category</span>
            <div class="space-y-2">
                @foreach (var item in _hourBreakdown)
                {
                    var widthPct = (int)Math.Round((item.Hours / (double)_maxHours) * 100);
                    <div class="flex items-center gap-3">
                        <span class="w-24 text-muted-foreground text-xs">@item.Category</span>
                        <div class="flex-1">
                            <div class="h-2 rounded-full bg-foreground/20" style="@($"width:{widthPct}%")"></div>
                        </div>
                        <span class="w-14 text-right font-mono text-xs tabular-nums">@item.Hours.ToString("N0")</span>
                    </div>
                }
            </div>
        </div>

        @* Type ratings *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Type Ratings</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var tr in _typeRatings)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 font-normal text-xs">
                        <LucideIconCn Name="plane" Size="10" Class="size-2.5" />
                        @tr.Aircraft
                        <span class="font-mono text-muted-foreground tabular-nums">@((tr.Hours / 1000.0).ToString("F1"))K hrs</span>
                    </BadgeCn>
                }
            </div>
        </div>

        @* Recent flights *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent Flights</span>
            </div>
            @for (var i = 0; i < _recentFlights.Length; i++)
            {
                var flight = _recentFlights[i];
                <div class="@($"flex items-center gap-3 px-4 py-2.5 {(i < _recentFlights.Length - 1 ? "border-b" : "")}")">
                    <span class="w-14 text-muted-foreground text-xs">@flight.Date</span>
                    <span class="font-medium text-sm">@flight.Route</span>
                    <span class="text-muted-foreground text-xs">@flight.Aircraft</span>
                    <span class="ml-auto font-mono text-xs tabular-nums">@flight.Hours.ToString("F1")h</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                        @flight.Role
                    </BadgeCn>
                </div>
            }
        </div>

        @* Certificates *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Certificates</span>
            <div class="space-y-2">
                @foreach (var cert in _certificates)
                {
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="award" Size="16" Class="size-4 shrink-0 text-muted-foreground" />
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@cert.Name</span>
                            <span class="ml-2 font-mono text-muted-foreground text-xs">@cert.Number</span>
                        </div>
                        @if (cert.Verified)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 gap-1 px-1.5 font-normal text-[10px]">
                                <LucideIconCn Name="check-circle-2" Size="10" Class="size-2.5" />
                                Verified
                            </BadgeCn>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record HourBreakdownItem(string Category, int Hours);
    private record TypeRating(string Aircraft, int Hours);
    private record FlightEntry(string Id, string Date, string Route, string Aircraft, double Hours, string Role);
    private record Certificate(string Name, string Issuer, string Number, bool Verified);

    private const int _maxHours = 12000;

    private static readonly HourBreakdownItem[] _hourBreakdown =
    [
        new("PIC", 8400),
        new("SIC", 2840),
        new("Instrument", 2100),
        new("Night", 1860),
        new("Cross-Country", 9200),
        new("Multi-Engine", 11740),
    ];

    private static readonly TypeRating[] _typeRatings =
    [
        new("B737", 4200),
        new("A320", 3100),
        new("B757/767", 2800),
        new("CRJ-900", 1640),
        new("C172/182", 740),
    ];

    private static readonly FlightEntry[] _recentFlights =
    [
        new("f1", "Mar 18", "SFO → NRT", "B737-900", 10.4, "PIC"),
        new("f2", "Mar 15", "NRT → SFO", "B737-900", 9.8, "PIC"),
        new("f3", "Mar 10", "SFO → LAX", "A320neo", 1.2, "PIC"),
        new("f4", "Mar 8", "LAX → JFK", "B757-200", 5.1, "PIC"),
    ];

    private static readonly Certificate[] _certificates =
    [
        new("Airline Transport Pilot", "FAA", "ATP-2894512", true),
        new("First Class Medical", "FAA AME", "MC-1547823", true),
        new("Ground Instructor — Advanced", "FAA", "AGI-3821456", true),
    ];
}
