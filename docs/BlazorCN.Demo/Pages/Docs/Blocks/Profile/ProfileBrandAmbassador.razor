@* ============================================================
   Block: profile-brand-ambassador
   Title: ProfileBrandAmbassador
   Description: React brand ambassador profile block for Next.js with campaign showcase, reach metrics, brand partnerships, and engagement analytics using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-brand-ambassador.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="Nia Washington" />
                <AvatarFallbackCn>NW</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Nia Washington</span>
                <p class="text-muted-foreground text-xs">Brand Ambassador &amp; Content Creator</p>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">Lifestyle and tech content creator with 280K+ combined reach. Partnering with brands that align with sustainable living and innovation.</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">Media Kit</ButtonCn>
        </div>

        @* Stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideUsersCn Size="12" Class="text-muted-foreground" />
                <span class="font-medium tabular-nums">284K</span>
                <span class="text-muted-foreground">reach</span>
            </span>
            <span class="text-muted-foreground text-xs">&#183;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideMegaphoneCn Size="12" Class="text-muted-foreground" />
                <span class="font-medium tabular-nums">34</span>
                <span class="text-muted-foreground">campaigns</span>
            </span>
            <span class="text-muted-foreground text-xs">&#183;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideHeartCn Size="12" Class="text-muted-foreground" />
                <span class="font-medium tabular-nums">4.8%</span>
                <span class="text-muted-foreground">engagement</span>
            </span>
        </div>

        @* Platforms *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Platforms</span>
            <div class="flex gap-4">
                @foreach (var p in _platforms)
                {
                    <div class="flex items-center gap-2 text-xs">
                        <span class="text-muted-foreground">@p.Name</span>
                        <span class="font-medium tabular-nums">@p.Followers</span>
                    </div>
                }
            </div>
        </div>

        @* Campaigns *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Campaigns</span>
            </div>
            @for (var i = 0; i < _campaigns.Length; i++)
            {
                var campaign = _campaigns[i];
                var dotClass = campaign.Status switch
                {
                    "active" => "bg-emerald-500",
                    "upcoming" => "bg-amber-500",
                    _ => "bg-muted-foreground/40"
                };
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", i < _campaigns.Length - 1 ? "border-b" : "")">
                    <div class="flex items-start gap-3">
                        <span class="@($"mt-1.5 size-1.5 shrink-0 rounded-full {dotClass}")"></span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@campaign.Title</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@campaign.Brand</BadgeCn>
                            </div>
                            <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideUsersCn Size="12" />
                                    @campaign.Reach reach
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideTargetCn Size="12" />
                                    @campaign.Conversions conversions
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Content Categories *@
        <div class="px-4 py-3">
            <span class="mb-2 block font-medium text-muted-foreground text-xs">Content Categories</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var cat in _categories)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@cat</BadgeCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record PlatformItem(string Name, string Followers);
    private record CampaignItem(string Id, string Brand, string Title, string Reach, string Conversions, string Status);

    private static readonly PlatformItem[] _platforms =
    [
        new("Instagram", "142K"),
        new("TikTok", "98K"),
        new("YouTube", "44K"),
    ];

    private static readonly CampaignItem[] _campaigns =
    [
        new("c1", "Patagonia", "Sustainable Gear Spring Launch", "82K", "2.4K", "active"),
        new("c2", "Notion", "Creator Workflow Series", "124K", "5.1K", "active"),
        new("c3", "Allbirds", "Earth Day Collection", "67K", "1.8K", "completed"),
        new("c4", "Oura Ring", "Wellness Tech Review", "95K", "3.2K", "completed"),
    ];

    private static readonly string[] _categories =
    [
        "Sustainable Living", "Tech", "Wellness", "Lifestyle", "Travel"
    ];
}
