@* ============================================================
   Block: profile-blogger-analytics
   Title: ProfileBloggerAnalytics
   Description: React blogger profile block for Next.js with post analytics, traffic metrics, top articles list, and category breakdown using shadcn/ui, Tailwind CSS, and framer-motion
   Source: original/blocks/profile/profile-blogger-analytics.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Profile header *@
        <div class="flex items-start gap-4 border-b px-4 py-4">
            <AvatarCn Class="size-12">
                <AvatarImageCn Src="" Alt="James Calloway" />
                <AvatarFallbackCn>JC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">James Calloway</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">The Build Log</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Tech &amp; Startup Blogger</span>
                <p class="mt-1 text-muted-foreground text-sm leading-relaxed">Writing about startups, developer tools, and the future of work. 50k+ monthly readers. Featured in Hacker News, TechCrunch, and The Verge.</p>
            </div>
        </div>

        @* Stats bar *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs">
                <LucideBookOpenCn Size="12" Class="text-muted-foreground" />
                <span class="font-medium tabular-nums">248</span>
                <span class="text-muted-foreground">posts</span>
            </span>
            <span class="text-muted-foreground text-xs">&#183;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideUsersCn Size="12" Class="text-muted-foreground" />
                <span class="font-medium tabular-nums">12,400</span>
                <span class="text-muted-foreground">subscribers</span>
            </span>
            <span class="text-muted-foreground text-xs">&#183;</span>
            <span class="flex items-center gap-1.5 text-xs">
                <LucideEyeCn Size="12" Class="text-muted-foreground" />
                <span class="font-medium tabular-nums">52.3K</span>
                <span class="text-muted-foreground">/mo</span>
            </span>
        </div>

        @* Top Articles *@
        <div class="border-b">
            <div class="border-b px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Top Articles</span>
            </div>
            @for (var i = 0; i < _topArticles.Length; i++)
            {
                var article = _topArticles[i];
                <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", i < _topArticles.Length - 1 ? "border-b" : "")">
                    <div class="flex items-start gap-3">
                        <span class="mt-0.5 font-mono text-muted-foreground/50 text-xs tabular-nums">@(i + 1)</span>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@article.Title</span>
                                @if (article.Trend == "up")
                                {
                                    <LucideArrowUpRightCn Size="12" Class="text-emerald-500" />
                                }
                            </div>
                            <div class="mt-1 flex items-center gap-3 text-muted-foreground text-xs">
                                <span class="flex items-center gap-1">
                                    <LucideEyeCn Size="12" />
                                    @article.Views
                                </span>
                                <span class="flex items-center gap-1">
                                    <LucideMessageSquareCn Size="12" />
                                    @article.Comments
                                </span>
                                <span>@article.ReadTime read</span>
                                <BadgeCn Variant="BadgeVariant.Outline" Class="font-normal text-xs">@article.Category</BadgeCn>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Categories *@
        <div class="px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">Categories</span>
            <div class="space-y-2">
                @foreach (var cat in _categories)
                {
                    var pct = (int)Math.Round((cat.Count / (double)_categories[0].Count) * 100);
                    <div class="flex items-center gap-3">
                        <span class="w-24 text-xs">@cat.Name</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20" style="@($"width:{pct}%")"></div>
                        </div>
                        <span class="w-6 text-right font-mono text-muted-foreground text-xs tabular-nums">@cat.Count</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ArticleItem(string Id, string Title, string Views, int Comments, string ReadTime, string Category, string Trend);
    private record CategoryItem(string Name, int Count);

    private static readonly ArticleItem[] _topArticles =
    [
        new("a1", "Why Every Startup Should Use a Monorepo", "18.2K", 142, "8 min", "Engineering", "up"),
        new("a2", "The Death of Microservices (and What Comes Next)", "14.7K", 98, "12 min", "Architecture", "up"),
        new("a3", "I Built a SaaS in 30 Days With AI — Here's What Happened", "11.3K", 67, "10 min", "AI", "stable"),
        new("a4", "Bootstrapping vs Fundraising: A 5-Year Retrospective", "9.8K", 54, "15 min", "Startups", "stable"),
        new("a5", "The Best Developer Tools of 2026", "8.4K", 89, "6 min", "Tools", "up"),
    ];

    private static readonly CategoryItem[] _categories =
    [
        new("Engineering", 72),
        new("Startups", 58),
        new("AI", 45),
        new("Tools", 38),
        new("Architecture", 35),
    ];
}
