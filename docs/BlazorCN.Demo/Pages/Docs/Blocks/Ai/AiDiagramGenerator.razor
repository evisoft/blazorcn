@* ===========================================================
   Block: ai-diagram-generator
   Title: Ai Diagram Generator
   Description: AI diagram generator with diagram type selection, visual flowchart preview, and code view with mermaid syntax
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideCheckCn, LucideCopyCn, LucideDownloadCn, SelectCn
   Source: original/blocks/ai/ai-diagram-generator.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Description input *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <InputCn @bind-Value="_description"
                     Placeholder="Describe the diagram you want to generate..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" aria-label="Describe the diagram you want to generate..." />
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 shrink-0 text-xs">
                Generate
            </ButtonCn>
        </div>

        @* Config bar *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <SelectCn Value="@_diagramType" ValueChanged="v => _diagramType = v">
                <SelectTriggerCn aria-label="Diagram type" Class="h-7 w-[140px] border-0 bg-muted/50 text-xs shadow-none">
                    <SelectValueCn Placeholder="Type" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="@("flowchart")">Flowchart</SelectItemCn>
                    <SelectItemCn Value="@("sequence")">Sequence</SelectItemCn>
                    <SelectItemCn Value="@("erd")">ERD</SelectItemCn>
                    <SelectItemCn Value="@("mindmap")">Mindmap</SelectItemCn>
                </SelectContentCn>
            </SelectCn>

            <span class="text-xs text-muted-foreground">&middot;</span>
            <span class="text-xs text-muted-foreground">@_flowNodes.Length nodes</span>

            <div class="ml-auto flex items-center gap-1">
                <button type="button"
                        class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _tab == "preview" ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _tab = "preview")">
                    Preview
                </button>
                <button type="button"
                        class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _tab == "code" ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _tab = "code")">
                    Code
                </button>
            </div>
        </div>

        @* Content area *@
        @if (_tab == "preview")
        {
            <div class="px-4 py-6">
                <div class="flex flex-col items-center gap-1">
                    @* Start node *@
                    <div class="rounded-md border bg-muted/50 px-4 py-1.5 text-xs font-medium">
                        @_flowNodes[0].Label
                    </div>
                    <div class="h-4 w-px bg-border"></div>
                    <span class="text-[10px] text-muted-foreground">validate</span>
                    <div class="h-2 w-px bg-border"></div>

                    @* Auth node *@
                    <div class="rounded-md border bg-muted/50 px-4 py-1.5 text-xs font-medium">
                        @_flowNodes[1].Label
                    </div>
                    <div class="h-4 w-px bg-border"></div>
                    <span class="text-[10px] text-muted-foreground">authorized</span>
                    <div class="h-2 w-px bg-border"></div>

                    @* Cache node *@
                    <div class="rounded-md border bg-muted/50 px-4 py-1.5 text-xs font-medium">
                        @_flowNodes[2].Label
                    </div>

                    @* Branches *@
                    <div class="flex items-start gap-16 pt-1">
                        <div class="flex flex-col items-center gap-1">
                            <div class="h-4 w-px bg-border"></div>
                            <span class="text-[10px] text-muted-foreground">miss</span>
                            <div class="h-2 w-px bg-border"></div>
                            <div class="rounded-md border bg-muted/50 px-4 py-1.5 text-xs font-medium">
                                @_flowNodes[3].Label
                            </div>
                            <div class="h-4 w-px bg-border"></div>
                        </div>
                        <div class="flex flex-col items-center gap-1">
                            <div class="h-4 w-px bg-border"></div>
                            <span class="text-[10px] text-muted-foreground">hit</span>
                            <div class="h-16"></div>
                        </div>
                    </div>

                    @* Response node *@
                    <div class="rounded-md border bg-muted/50 px-4 py-1.5 text-xs font-medium">
                        @_flowNodes[4].Label
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="rounded-b-lg bg-zinc-950 p-3">
                <pre class="overflow-x-auto font-mono text-sm leading-relaxed text-zinc-300">@MermaidCode</pre>
            </div>
        }

        @* Actions *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs text-muted-foreground"
                      @onclick="HandleCopy">
                @if (_copied)
                {
                    <LucideCheckCn Size="16" Class="size-3" />
                    <text>Copied</text>
                }
                else
                {
                    <LucideCopyCn Size="16" Class="size-3" />
                    <text>Copy code</text>
                }
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs text-muted-foreground">
                <LucideDownloadCn Size="16" Class="size-3" />
                Export SVG
            </ButtonCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto text-xs font-normal">
                Flowchart
            </BadgeCn>
        </div>
    </div>
</section>

@code {
    private record FlowNode(string Id, string Label);

    private static readonly FlowNode[] _flowNodes =
    {
        new("start", "User Request"),
        new("auth", "Auth Check"),
        new("cache", "Cache Lookup"),
        new("process", "Process Data"),
        new("response", "Send Response")
    };

    private const string MermaidCode = @"graph TD
    A[User Request] -->|validate| B{Auth Check}
    B -->|authorized| C[Cache Lookup]
    C -->|miss| D[Process Data]
    D -->|complete| E[Send Response]
    C -->|hit| E[Send Response]
    B -->|unauthorized| F[401 Error]

    style A fill:#dbeafe,stroke:#3b82f6
    style B fill:#fef3c7,stroke:#f59e0b
    style C fill:#cffafe,stroke:#06b6d4
    style D fill:#ede9fe,stroke:#8b5cf6
    style E fill:#d1fae5,stroke:#10b981
    style F fill:#fee2e2,stroke:#ef4444";

    private string _description = "Create a flowchart showing an API request lifecycle: user sends request, authentication check, cache lookup, data processing if cache miss, then response";
    private string _diagramType = "flowchart";
    private string _tab = "preview";
    private bool _copied;

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
