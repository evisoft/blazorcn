@* ===========================================================
   Block: ai-message-image-generation
   Title: Ai Message Image Generation
   Description: AI message with image generation grid, hover overlays, download buttons, and resolution badges
   Dependencies: ButtonCn, LucideCheckCn, LucideCopyCn, LucideDownloadCn, LucideMaximizeCn, LucideRefreshCcwCn
   Source: original/blocks/ai/ai-message-image-generation.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* User message *@
        <div class="border-b px-4 py-3">
            <div class="ml-auto max-w-[80%] rounded-lg bg-primary px-3 py-2 text-primary-foreground">
                <p class="text-sm">Generate 4 variations of a serene mountain landscape at sunset with a reflective lake in the foreground.</p>
            </div>
        </div>

        @* AI intro *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted">
                <span class="text-[10px] font-medium text-muted-foreground">AI</span>
            </div>
            <span class="text-sm">4 variations generated</span>
            <span class="text-xs text-muted-foreground">&middot;</span>
            <span class="font-mono text-xs text-muted-foreground">1024x1024</span>
            @if (_selectedImages.Count > 0)
            {
                <span class="text-xs text-muted-foreground">&middot;</span>
                <span class="text-xs text-muted-foreground">@_selectedImages.Count selected</span>
            }
        </div>

        @* Image grid *@
        <div class="grid grid-cols-2 border-b">
            @for (var i = 0; i < _images.Length; i++)
            {
                var image = _images[i];
                var isSelected = _selectedImages.Contains(image.Id);
                var showBorderRight = i % 2 == 0;
                var showBorderBottom = i < 2;
                var imgId = image.Id;
                <div class="@Cn.Merge("group relative cursor-pointer", showBorderRight ? "border-r" : "", showBorderBottom ? "border-b" : "")"
                     @onclick="@(() => ToggleSelect(imgId))">
                    @* Image placeholder *@
                    <div class="@Cn.Merge("aspect-square w-full bg-gradient-to-br", image.Gradient)">
                        <div class="relative flex size-full items-end overflow-hidden">
                            <svg viewBox="0 0 200 60" class="absolute inset-x-0 bottom-[40%] w-full opacity-30" role="img" aria-label="Mountain silhouette">
                                <title>Mountain silhouette</title>
                                <polygon points="0,60 30,20 60,45 90,10 130,35 160,15 200,60" fill="currentColor" class="text-black" />
                            </svg>
                            <div class="h-[35%] w-full bg-gradient-to-b from-white/10 to-white/5 backdrop-blur-[1px]"></div>
                        </div>
                    </div>

                    @* Hover overlay *@
                    <div class="absolute inset-0 flex flex-col items-center justify-center gap-2 bg-black/50 opacity-0 backdrop-blur-sm transition-opacity group-hover:opacity-100">
                        <div class="flex gap-2">
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Secondary" Class="h-7 gap-1 text-xs">
                                <LucideDownloadCn Size="16" Class="size-3" />
                                Download
                            </ButtonCn>
                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Secondary" Class="h-7 gap-1 text-xs">
                                <LucideMaximizeCn Size="16" Class="size-3" />
                                Upscale
                            </ButtonCn>
                        </div>
                    </div>

                    @* Seed label *@
                    <div class="absolute bottom-2 left-2">
                        <span class="rounded bg-black/40 px-1.5 py-0.5 font-mono text-[9px] text-white/70 backdrop-blur-sm">
                            seed: @image.Seed
                        </span>
                    </div>

                    @* Selection indicator *@
                    @if (isSelected)
                    {
                        <div class="absolute left-2 top-2 flex size-5 items-center justify-center rounded-full bg-white">
                            <LucideCheckCn Size="16" Class="size-3 text-black" />
                        </div>
                    }
                </div>
            }
        </div>

        @* Selection actions *@
        @if (_selectedImages.Count > 0)
        {
            <div class="flex items-center justify-between border-b px-4 py-2.5">
                <span class="text-xs text-muted-foreground">
                    @_selectedImages.Count image@(_selectedImages.Count > 1 ? "s" : "") selected
                </span>
                <div class="flex gap-1.5">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                        <LucideDownloadCn Size="16" Class="size-3" />
                        Download
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                        <LucideMaximizeCn Size="16" Class="size-3" />
                        Upscale
                    </ButtonCn>
                </div>
            </div>
        }

        @* Actions *@
        <div class="px-4 py-3">
            <div class="flex items-center gap-1">
                <button type="button" class="rounded p-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                    <LucideCopyCn Size="16" Class="size-3.5" />
                </button>
                <button type="button" class="rounded p-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                    <LucideRefreshCcwCn Size="16" Class="size-3.5" />
                </button>
            </div>
        </div>
    </div>
</section>

@code {
    private record GeneratedImage(string Id, string Gradient, int Seed);

    private static readonly GeneratedImage[] _images =
    {
        new("img-1", "from-rose-400 via-fuchsia-500 to-indigo-500", 42891),
        new("img-2", "from-amber-400 via-orange-500 to-rose-500", 71034),
        new("img-3", "from-emerald-400 via-teal-500 to-cyan-500", 38276),
        new("img-4", "from-violet-400 via-purple-500 to-blue-500", 95142)
    };

    private readonly HashSet<string> _selectedImages = new();

    private void ToggleSelect(string id)
    {
        if (!_selectedImages.Remove(id))
            _selectedImages.Add(id);
    }
}
