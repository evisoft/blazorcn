@* ===========================================================
   Block: ai-group-chat
   Title: Ai Group Chat
   Description: React AI group chat block for Next.js with multi-agent personalities, colored avatars, agent labels, and collaborative AI responses using shadcn/ui and Tailwind CSS
   Long Description:
   Dependencies: BadgeCn, ButtonCn, InputCn
   Source: original/blocks/ai/ai-group-chat.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="font-medium text-sm">AI Team</span>
            <span class="text-muted-foreground text-xs">3 agents collaborating</span>
            <div class="ml-auto flex items-center gap-2">
                @foreach (var agent in _agents.Values)
                {
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="@($"size-1.5 rounded-full {agent.Dot}")"></span>
                        @agent.Name
                    </span>
                }
            </div>
        </div>

        @* Messages *@
        <div class="max-h-[500px] overflow-y-auto">
            @foreach (var msg in _messages)
            {
                if (msg.Role == "user")
                {
                    <div class="border-b bg-muted/30 px-4 py-3">
                        <p class="text-sm">@msg.Content</p>
                    </div>
                }
                else if (msg.AgentId is not null && _agents.TryGetValue(msg.AgentId, out var agent))
                {
                    <div class="border-b">
                        <div class="px-4 py-3">
                            <div class="mb-2 flex items-center gap-2">
                                <span class="@($"size-2 rounded-full {agent.Dot}")"></span>
                                <span class="font-medium text-xs">@agent.Name</span>
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1.5 font-normal text-[10px]">
                                    @agent.AgentRole
                                </BadgeCn>
                                <ButtonCn Variant="ButtonVariant.Ghost"
                                          Size="ButtonSize.Sm"
                                          Class="ml-auto h-5 gap-1 px-1.5 text-muted-foreground text-xs"
                                          @onclick="@(() => _copied = msg.Id)">
                                    @if (_copied == msg.Id)
                                    {
                                        <LucideCheckCn Size="10" Class="size-2.5" />
                                    }
                                    else
                                    {
                                        <LucideCopyCn Size="10" Class="size-2.5" />
                                    }
                                </ButtonCn>
                            </div>
                            <p class="pl-4 text-muted-foreground text-sm leading-relaxed">
                                @msg.Content
                            </p>
                        </div>
                    </div>
                }
            }
        </div>

        @* Input *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <InputCn @bind-Value="_input"
                     Placeholder="Ask the team..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            <ButtonCn Size="ButtonSize.Sm"
                      Variant="ButtonVariant.Ghost"
                      Disabled="@(string.IsNullOrWhiteSpace(_input))"
                      Class="h-7 shrink-0 px-2">
                <LucideSendCn Size="14" Class="size-3.5" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Agent(string Id, string Name, string AgentRole, string Dot);
    private record ChatMessage(string Id, string Role, string Content, string? AgentId = null);

    private static readonly Dictionary<string, Agent> _agents = new()
    {
        ["researcher"] = new("researcher", "Researcher", "Data & Analysis", "bg-blue-500"),
        ["coder"] = new("coder", "Coder", "Implementation", "bg-emerald-500"),
        ["designer"] = new("designer", "Designer", "UX & Visual", "bg-amber-500")
    };

    private static readonly ChatMessage[] _messages =
    {
        new("1", "user", "I need to build a real-time dashboard for monitoring API health. Where should I start?"),
        new("2", "assistant",
            "Based on industry patterns, track these core health indicators: uptime percentage (target 99.9%), P50/P95/P99 latency, error rate as percentage of total requests, and throughput with trend analysis. Use OpenTelemetry for instrumentation — it's vendor-neutral with excellent Next.js support. Push metrics to a time-series database like TimescaleDB or InfluxDB. I'd recommend 10-second polling intervals with 1-minute aggregation windows for trend charts.",
            "researcher"),
        new("3", "assistant",
            "Building on that, here's the stack: Next.js with React Server Components for initial load and client components for real-time updates. Use Server-Sent Events (SSE) over WebSockets — simpler, HTTP/2 compatible, auto-reconnect. Recharts or Tremor for visualization. Zustand for client-side metric buffering. Key detail: use a ring buffer on the client to hold the last 100 data points per metric to prevent memory leaks during long sessions.",
            "coder"),
        new("4", "assistant",
            "For the visual design: use a 12-column grid with 3-4 KPI cards at top (large numbers, sparkline trends) and 2 full-width charts below. Color system — green for healthy, amber for warning, red for critical — sparingly, only for status indicators. Use tabular-nums for all metrics so digits don't jump. Fade transitions for value changes, never bounce or scale. Smooth line chart animations at 200ms. Users watch these screens for hours — subtle motion only.",
            "designer")
    };

    private string _input = "";
    private string? _copied;
}
