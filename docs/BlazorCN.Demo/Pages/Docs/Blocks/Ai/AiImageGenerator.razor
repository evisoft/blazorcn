@* ===========================================================
   Block: ai-image-generator
   Title: Ai Image Generator
   Description: AI image generation with prompt input, style selector, size and quality controls, and a 4-image grid with hover actions
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideArrowUpCn, LucideDownloadCn, LucideShuffleCn, SelectCn
   Source: original/blocks/ai/ai-image-generator.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Prompt input *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <InputCn @bind-Value="_prompt"
                     Placeholder="Describe the image you want to generate..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 shrink-0 text-xs">
                Generate
            </ButtonCn>
        </div>

        @* Controls *@
        <div class="flex flex-wrap items-center gap-2 border-b px-4 py-3">
            @* Style toggles *@
            <div class="flex gap-1">
                @foreach (var style in _styles)
                {
                    var s = style;
                    <button type="button"
                            class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _activeStyle == s.Value ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:text-foreground")"
                            @onclick="@(() => _activeStyle = s.Value)">
                        @s.Label
                    </button>
                }
            </div>

            <div class="ml-auto flex items-center gap-2">
                <SelectCn TValue="string" Value="@_size" ValueChanged="v => _size = v">
                    <SelectTriggerCn Class="h-7 w-[120px] border-0 bg-muted/50 text-xs shadow-none">
                        <SelectValueCn Placeholder="Size" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="@("512x512")">512 x 512</SelectItemCn>
                        <SelectItemCn Value="@("1024x1024")">1024 x 1024</SelectItemCn>
                        <SelectItemCn Value="@("1024x1792")">1024 x 1792</SelectItemCn>
                        <SelectItemCn Value="@("1792x1024")">1792 x 1024</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>

                <SelectCn TValue="string" Value="@_quality" ValueChanged="v => _quality = v">
                    <SelectTriggerCn Class="h-7 w-[90px] border-0 bg-muted/50 text-xs shadow-none">
                        <SelectValueCn Placeholder="Quality" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="@("standard")">Standard</SelectItemCn>
                        <SelectItemCn Value="@("hd")">HD</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Image grid *@
        <div class="grid grid-cols-2">
            @for (var i = 0; i < _generatedImages.Length; i++)
            {
                var image = _generatedImages[i];
                var isTop = i < 2;
                var isLeft = i % 2 == 0;
                var borderClasses = Cn.Merge(isTop ? "border-b" : "", isLeft ? "border-r" : "");
                <div class="@Cn.Merge("group relative", borderClasses)">
                    <div class="flex aspect-square items-center justify-center bg-muted/30">
                        <span class="text-xs text-muted-foreground/30">@image.Label</span>
                    </div>
                    @* Hover overlay *@
                    <div class="absolute inset-0 flex items-end bg-black/0 p-2 opacity-0 transition-all duration-200 group-hover:bg-black/40 group-hover:opacity-100">
                        <div class="flex w-full items-center justify-between">
                            <span class="text-xs font-medium text-white">@image.Label</span>
                            <div class="flex gap-1">
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-6 text-white hover:bg-white/20">
                                    <LucideDownloadCn Size="16" Class="size-3" />
                                </ButtonCn>
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-6 text-white hover:bg-white/20">
                                    <LucideArrowUpCn Size="16" Class="size-3" />
                                </ButtonCn>
                                <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-6 text-white hover:bg-white/20">
                                    <LucideShuffleCn Size="16" Class="size-3" />
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-xs text-muted-foreground">4 images generated</span>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    @(_styles.FirstOrDefault(s => s.Value == _activeStyle)?.Label ?? _activeStyle)
                </BadgeCn>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-xs font-normal">
                    @_size
                </BadgeCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record StyleOption(string Label, string Value);
    private record GeneratedImage(string Id, string Label);

    private static readonly StyleOption[] _styles =
    {
        new("Photorealistic", "photorealistic"),
        new("Illustration", "illustration"),
        new("3D Render", "3d"),
        new("Anime", "anime")
    };

    private static readonly GeneratedImage[] _generatedImages =
    {
        new("1", "Variation 1"),
        new("2", "Variation 2"),
        new("3", "Variation 3"),
        new("4", "Variation 4")
    };

    private string _prompt = "A serene Japanese garden at golden hour with cherry blossoms falling gently onto a koi pond";
    private string _activeStyle = "photorealistic";
    private string _size = "1024x1024";
    private string _quality = "hd";
}
