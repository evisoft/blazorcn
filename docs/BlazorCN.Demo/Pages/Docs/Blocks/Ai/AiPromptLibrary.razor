@* ===========================================================
   Block: ai-prompt-library
   Title: Ai Prompt Library
   Description: AI prompt template library with search, category tabs, expandable prompt cards, and copy functionality
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideCheckCn, LucideChevronRightCn, LucideCopyCn
   Source: original/blocks/ai/ai-prompt-library.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Search input *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <InputCn @bind-Value="_search"
                     Placeholder="Search prompts..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" aria-label="Search prompts..." />
            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs font-normal">
                @Filtered.Length prompts
            </BadgeCn>
        </div>

        @* Category tabs *@
        <div class="flex gap-1 border-b px-4 py-2.5">
            @foreach (var cat in _categories)
            {
                var c = cat;
                <button type="button"
                        class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _activeCategory == c ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50")"
                        @onclick="@(() => _activeCategory = c)">
                    @c
                </button>
            }
        </div>

        @* Prompt list *@
        @if (Filtered.Length == 0)
        {
            <div class="px-4 py-8 text-center">
                <p class="text-sm text-muted-foreground">No prompts match your search.</p>
            </div>
        }
        else
        {
            <div>
                @for (var i = 0; i < Filtered.Length; i++)
                {
                    var p = Filtered[i];
                    var isExpanded = _expanded == p.Id;
                    var isLast = i == Filtered.Length - 1;
                    var promptId = p.Id;
                    <div class="@(!isLast ? "border-b" : "")">
                        <button type="button"
                                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                                @onclick="@(() => _expanded = isExpanded ? null : promptId)">
                            <span class="size-2 shrink-0 rounded-full bg-foreground/20"></span>
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">@p.Title</span>
                                <p class="mt-0.5 truncate text-xs text-muted-foreground">
                                    @p.Description
                                </p>
                            </div>
                            <span class="shrink-0 text-xs text-muted-foreground">@p.Category</span>
                            <span class="text-xs text-muted-foreground">&middot;</span>
                            <span class="shrink-0 font-mono text-xs tabular-nums text-muted-foreground">
                                @p.Uses
                            </span>
                            <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>

                        @if (isExpanded)
                        {
                            <div class="px-4 pb-4 pl-9">
                                <p class="mb-3 text-sm leading-relaxed text-muted-foreground">
                                    @p.Description
                                </p>
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="mb-1.5 flex items-center justify-between">
                                        <span class="text-xs font-medium text-muted-foreground">
                                            Prompt template
                                        </span>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                                  Class="h-6 gap-1 px-2 text-xs"
                                                  @onclick="@(() => HandleCopy(promptId))">
                                            @if (_copied == promptId)
                                            {
                                                <LucideCheckCn Size="16" Class="size-3" />
                                                <text>Copied</text>
                                            }
                                            else
                                            {
                                                <LucideCopyCn Size="16" Class="size-3" />
                                                <text>Copy</text>
                                            }
                                        </ButtonCn>
                                    </div>
                                    <p class="text-sm leading-relaxed">@p.Prompt</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record PromptTemplate(string Id, string Title, string Description, string Category, int Uses, string Prompt);

    private static readonly string[] _categories = { "All", "Code", "Writing", "Analysis", "Creative" };

    private static readonly PromptTemplate[] _prompts =
    {
        new("1", "Code Review Assistant", "Analyze code for bugs, performance issues, and suggest improvements following best practices.", "Code", 342, "Review this code for bugs, performance issues, and best practice violations..."),
        new("2", "Blog Post Writer", "Generate SEO-optimized blog posts with engaging introductions and clear structure.", "Writing", 287, "Write a blog post about the following topic..."),
        new("3", "Data Insights Extractor", "Analyze datasets and surface key trends, outliers, and actionable insights.", "Analysis", 198, "Analyze this dataset and provide key insights, trends, and recommendations..."),
        new("4", "Story Generator", "Create compelling short stories with rich characters and unexpected plot twists.", "Creative", 456, "Write a short story based on the following premise..."),
        new("5", "API Documentation", "Generate comprehensive API docs from endpoint definitions with examples.", "Code", 215, "Generate API documentation for the following endpoints..."),
        new("6", "Competitor Analysis", "Break down competitor products by features, pricing, and market positioning.", "Analysis", 178, "Analyze these competitors and compare their strengths, weaknesses..."),
        new("7", "Email Copywriter", "Draft high-converting email sequences for onboarding, sales, or re-engagement.", "Writing", 312, "Write an email sequence for the following campaign goal..."),
        new("8", "UI Component Ideas", "Brainstorm creative UI component concepts with interaction descriptions.", "Creative", 143, "Suggest creative UI component ideas for the following use case...")
    };

    private string _search = "";
    private string _activeCategory = "All";
    private string? _expanded;
    private string? _copied;

    private PromptTemplate[] Filtered => _prompts.Where(p =>
    {
        var matchesSearch = string.IsNullOrEmpty(_search) ||
            p.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
            p.Description.Contains(_search, StringComparison.OrdinalIgnoreCase);
        var matchesCategory = _activeCategory == "All" || p.Category == _activeCategory;
        return matchesSearch && matchesCategory;
    }).ToArray();

    private async Task HandleCopy(string id)
    {
        _copied = id;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = null;
    }
}
