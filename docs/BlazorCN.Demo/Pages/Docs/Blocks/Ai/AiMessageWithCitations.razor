@* ===========================================================
   Block: ai-message-with-citations
   Title: Ai Message With Citations
   Description: AI message with inline numbered citations, clickable source references, and collapsible source list
   Dependencies: BadgeCn, LucideChevronRightCn, LucideExternalLinkCn
   Source: original/blocks/ai/ai-message-with-citations.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="text-sm font-medium">Climate change analysis</span>
            <p class="mt-0.5 text-xs text-muted-foreground">5 sources referenced</p>
        </div>

        @* Response with inline citations *@
        <div class="space-y-3 px-4 py-3 text-sm leading-relaxed">
            <p>
                Global CO2 emissions reached 37.4 billion tonnes in 2024, marking another record high
                despite growing climate commitments.
                @RenderCitation(1)
                The scientific consensus is clear: human activities have already warmed the planet by
                approximately 1.1 degrees Celsius above pre-industrial levels.
                @RenderCitation(2)
            </p>
            <p>
                The past decade (2015-2025) has been the warmest on record, with 2024 being the hottest
                single year ever measured.
                @RenderCitation(3)
                Ocean temperatures, sea levels, and extreme weather events continue to intensify at
                rates that often exceed model predictions.
            </p>
            <p>
                On the mitigation front, the International Energy Agency has outlined a pathway to
                net-zero emissions by 2050, requiring an unprecedented transformation of the global
                energy system.
                @RenderCitation(4)
                Renewable energy capacity additions hit a new high in 2024, with solar and wind
                accounting for over 90% of new power generation globally.
                @RenderCitation(5)
            </p>
            <p>
                While the transition is accelerating, current policies still put the world on track for
                roughly 2.5-2.9 degrees Celsius of warming by 2100
                @RenderCitation(2)
                &mdash; significantly above the 1.5 degree Celsius Paris Agreement target.
            </p>
        </div>

        @* Sources *@
        <div class="border-t">
            <button type="button"
                    class="flex w-full items-center gap-2 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    @onclick="@(() => _sourcesOpen = !_sourcesOpen)">
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _sourcesOpen ? "rotate-90" : "")" />
                <span class="text-sm font-medium">@_sources.Length sources</span>
            </button>

            @if (_sourcesOpen)
            {
                <div class="border-t">
                    @for (var i = 0; i < _sources.Length; i++)
                    {
                        var source = _sources[i];
                        var isLast = i == _sources.Length - 1;
                        <a href="@source.Href"
                           target="_blank"
                           rel="noreferrer"
                           class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", _activeCitation == source.Id ? "bg-muted/50" : "")">
                            <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted font-mono text-[10px] text-muted-foreground">
                                @source.Id
                            </span>
                            <div class="min-w-0 flex-1">
                                <span class="truncate text-xs font-medium">@source.Title</span>
                                <p class="text-[11px] text-muted-foreground">@source.Publisher</p>
                            </div>
                            <LucideExternalLinkCn Size="16" Class="size-3 shrink-0 text-muted-foreground/60" />
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record CitationSource(int Id, string Title, string Href, string Publisher);

    private static readonly CitationSource[] _sources =
    {
        new(1, "Global Carbon Budget 2025", "https://globalcarbonproject.org/carbonbudget", "Global Carbon Project"),
        new(2, "IPCC Sixth Assessment Report: Climate Change 2023", "https://www.ipcc.ch/assessment-report/ar6", "Intergovernmental Panel on Climate Change"),
        new(3, "State of the Climate 2025", "https://www.climate.gov/news-features/understanding-climate/state-climate", "NOAA Climate.gov"),
        new(4, "Net Zero by 2050: A Roadmap for the Global Energy Sector", "https://www.iea.org/reports/net-zero-by-2050", "International Energy Agency"),
        new(5, "Renewable Energy Statistics 2025", "https://www.irena.org/publications/2025/renewable-energy-statistics", "IRENA")
    };

    private int? _activeCitation;
    private bool _sourcesOpen;

    private void HandleCitationClick(int id)
    {
        _activeCitation = _activeCitation == id ? null : id;
        if (!_sourcesOpen) _sourcesOpen = true;
    }

    private RenderFragment RenderCitation(int id) => builder =>
    {
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "type", "button");
        builder.AddAttribute(2, "onclick", EventCallback.Factory.Create(this, () => HandleCitationClick(id)));
        builder.AddAttribute(3, "class", "inline-flex");
        builder.OpenComponent<BadgeCn>(4);
        builder.AddAttribute(5, "Variant", _activeCitation == id ? BadgeVariant.Default : BadgeVariant.Secondary);
        builder.AddAttribute(6, "Class", "mx-0.5 size-5 cursor-pointer rounded-full p-0 font-mono text-[10px] transition-all hover:scale-110");
        builder.AddAttribute(7, "ChildContent", (RenderFragment)(b => b.AddContent(0, id)));
        builder.CloseComponent();
        builder.CloseElement();
    };
}
