@* ===========================================================
   Block: ai-knowledge-base
   Title: Ai Knowledge Base
   Description: AI knowledge base search with category filters, relevance scoring, and highlighted matches
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideChevronRightCn, LucideSearchCn, SelectCn
   Source: original/blocks/ai/ai-knowledge-base.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Search bar *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideSearchCn Size="16" Class="size-4 shrink-0 text-muted-foreground" />
            <InputCn @bind-Value="_query"
                     Placeholder="Search articles, guides, and tutorials..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" aria-label="Search articles, guides, and tutorials..." />
            <SelectCn Value="@_category" ValueChanged="v => _category = v">
                <SelectTriggerCn aria-label="Category" Class="h-7 w-[130px] shrink-0 text-xs">
                    <SelectValueCn Placeholder="Category" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="@("all")">All</SelectItemCn>
                    <SelectItemCn Value="@("auth")">Authentication</SelectItemCn>
                    <SelectItemCn Value="@("database")">Database</SelectItemCn>
                    <SelectItemCn Value="@("api")">API</SelectItemCn>
                    <SelectItemCn Value="@("deploy")">Deployment</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 shrink-0 text-xs">
                Search
            </ButtonCn>
        </div>

        @* Results summary *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-xs text-muted-foreground">
                <span class="font-medium text-foreground">@_results.Length results</span> for "@_query"
            </span>
            <div class="flex items-center gap-3">
                @foreach (var topic in _popularTopics.Take(3))
                {
                    <button type="button" class="text-xs text-muted-foreground transition-colors hover:text-foreground">
                        @topic.Label
                        <span class="ml-1 font-mono text-muted-foreground/60">@topic.Count</span>
                    </button>
                }
            </div>
        </div>

        @* Results list *@
        <div>
            @for (var i = 0; i < _results.Length; i++)
            {
                var result = _results[i];
                var isExpanded = _expanded == result.Id;
                var isLast = i == _results.Length - 1;
                var resultId = result.Id;
                <div class="@(!isLast ? "border-b" : "")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : resultId)">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetRelevanceDot(result.Relevance))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@result.Title</span>
                            <div class="mt-0.5 flex items-center gap-2">
                                <span class="text-xs text-muted-foreground">@result.Category</span>
                                <span class="text-xs text-muted-foreground">&middot;</span>
                                <span class="text-xs text-muted-foreground">Updated @result.UpdatedAt</span>
                            </div>
                        </div>
                        <span class="shrink-0 font-mono text-xs text-muted-foreground">
                            @(result.Relevance)%
                        </span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <p class="text-sm leading-relaxed text-muted-foreground">@result.Excerpt</p>
                            <div class="mt-2 flex items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                    @result.Category
                                </BadgeCn>
                                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                    <span class="@Cn.Merge("size-1.5 rounded-full", GetRelevanceDot(result.Relevance))"></span>
                                    @(result.Relevance)% match
                                </span>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Popular topics footer *@
        <div class="border-t px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Popular topics</span>
            <div class="flex flex-wrap gap-1.5">
                @foreach (var topic in _popularTopics)
                {
                    <button type="button"
                            class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2.5 py-1 text-xs transition-colors hover:bg-muted">
                        @topic.Label
                        <span class="font-mono text-muted-foreground/60">@topic.Count</span>
                    </button>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record SearchResult(string Id, string Title, string Excerpt, string Category, int Relevance, string UpdatedAt);
    private record PopularTopic(string Label, int Count);

    private static readonly SearchResult[] _results =
    {
        new("1", "Getting Started with Authentication",
            "Learn how to set up OAuth 2.0 providers including Google, GitHub, and email magic links. This guide covers session management, token refresh, and role-based access control.",
            "Authentication", 96, "2 days ago"),
        new("2", "Database Schema Migration Guide",
            "Step-by-step instructions for running Prisma migrations in production. Covers zero-downtime deployments, rollback strategies, and data seeding best practices.",
            "Database", 89, "1 week ago"),
        new("3", "API Rate Limiting Configuration",
            "Configure rate limiting for your API routes using middleware. Includes examples for token bucket, sliding window, and fixed window algorithms with Redis backing.",
            "API", 82, "3 days ago"),
        new("4", "Deploying to Edge Functions",
            "Deploy your Next.js application to edge runtime for sub-50ms response times globally. Covers middleware, streaming, and edge-compatible database connections.",
            "Deployment", 74, "5 days ago")
    };

    private static readonly PopularTopic[] _popularTopics =
    {
        new("Authentication", 24),
        new("Database", 18),
        new("API Design", 15),
        new("Deployment", 12),
        new("Performance", 9)
    };

    private string _query = "OAuth authentication setup";
    private string _category = "all";
    private string? _expanded = "1";

    private static string GetRelevanceDot(int score) =>
        score >= 90 ? "bg-emerald-500" :
        score >= 80 ? "bg-blue-500" :
        "bg-amber-500";
}
