@* ===========================================================
   Block: ai-tool-database-query
   Title: Ai Tool Database Query
   Description: React AI tool database query block for Next.js with SQL syntax display, execution timing, result table, and export controls using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/ai/ai-tool-database-query.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="font-medium text-sm">Database Query</span>
            <span class="text-muted-foreground text-xs">PostgreSQL</span>
            <div class="ml-auto flex items-center gap-3">
                <span class="font-mono text-muted-foreground text-xs">23ms</span>
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
            </div>
        </div>

        @* SQL query *@
        <div class="border-b">
            <div class="flex items-center justify-between px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">SQL</span>
                <ButtonCn
                    Variant="ButtonVariant.Ghost"
                    Size="ButtonSize.Sm"
                    class="h-6 gap-1 px-2 text-xs">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideCopyCn Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
            <div class="bg-zinc-950 px-4 py-3">
                <pre class="overflow-x-auto font-mono text-xs leading-relaxed text-zinc-300">@_sqlQuery</pre>
            </div>
        </div>

        @* Results header *@
        <div class="flex items-center justify-between border-b px-4 py-2">
            <span class="text-muted-foreground text-xs">
                Showing @_rows.Length of @_totalRows rows
            </span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideDownloadCn Size="12" Class="size-3" />
                Export CSV
            </ButtonCn>
        </div>

        @* Results table *@
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="border-b bg-muted/50">
                        @foreach (var col in _columns)
                        {
                            <th class="whitespace-nowrap px-4 py-2 text-left font-medium text-muted-foreground text-xs">
                                @col
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _rows.Length; i++)
                    {
                        var idx = i;
                        var row = _rows[idx];
                        var isLast = idx == _rows.Length - 1;
                        <tr class="@Cn.Merge("transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                            <td class="whitespace-nowrap px-4 py-2">
                                <span class="font-mono text-muted-foreground text-xs">@row.Id</span>
                            </td>
                            <td class="whitespace-nowrap px-4 py-2">
                                <span class="text-xs">@row.Name</span>
                            </td>
                            <td class="whitespace-nowrap px-4 py-2">
                                <span class="text-xs">@row.Email</span>
                            </td>
                            <td class="whitespace-nowrap px-4 py-2">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 px-1.5 font-normal text-xs">
                                    @row.Role
                                </BadgeCn>
                            </td>
                            <td class="whitespace-nowrap px-4 py-2">
                                <span class="flex items-center gap-1.5 text-xs">
                                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                    @row.Status
                                </span>
                            </td>
                            <td class="whitespace-nowrap px-4 py-2">
                                <span class="font-mono text-muted-foreground text-xs">@row.LastLogin</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@code {
    private record UserRow(int Id, string Name, string Email, string Role, string Status, string LastLogin);

    private static readonly string[] _columns = ["id", "name", "email", "role", "status", "last_login"];
    private static readonly int _totalRows = 284;

    private static readonly string _sqlQuery = @"SELECT u.id, u.name, u.email, u.role, u.status, u.last_login
FROM users u
WHERE u.status = 'active'
  AND u.last_login > NOW() - INTERVAL '30 days'
ORDER BY u.last_login DESC
LIMIT 6;";

    private static readonly UserRow[] _rows =
    [
        new(1, "Sarah Chen", "sarah.chen@acme.co", "admin", "active", "2026-03-14 09:23"),
        new(2, "Marcus Johnson", "m.johnson@acme.co", "editor", "active", "2026-03-14 08:45"),
        new(3, "Priya Patel", "p.patel@acme.co", "viewer", "active", "2026-03-13 16:12"),
        new(4, "James Wilson", "j.wilson@acme.co", "editor", "active", "2026-03-13 11:30"),
        new(5, "Elena Rodriguez", "e.rodriguez@acme.co", "admin", "active", "2026-03-12 14:55"),
        new(6, "David Kim", "d.kim@acme.co", "viewer", "active", "2026-03-11 10:08"),
    ];

    private bool _copied = false;
}
