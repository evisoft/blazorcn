@* ===========================================================
   Block: ai-chat-empty-state
   Title: Ai Chat Empty State
   Description: AI chat empty state with welcome heading, suggestion cards in 2x2 grid, and conversation starter prompts
   Dependencies: ButtonCn, InputCn, LucideArrowUpCn
   Source: original/blocks/ai/ai-chat-empty-state.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        <div class="flex flex-1 flex-col items-center justify-center px-6">
            @* Heading *@
            <div class="mb-8 text-center">
                <h2 class="mb-1.5 text-sm font-medium">How can I help you today?</h2>
                <p class="max-w-sm text-xs text-muted-foreground">
                    I can write code, answer questions, brainstorm ideas, draft content, and much more.
                </p>
            </div>

            @* Suggestion cards *@
            <div class="mb-6 grid w-full max-w-md grid-cols-2 gap-2">
                @foreach (var s in _suggestions)
                {
                    <button type="button"
                            class="rounded-md bg-muted/50 p-3 text-left transition-colors hover:bg-muted"
                            @onclick="@(() => _input = s.Prompt)">
                        <span class="block text-sm font-medium">@s.Title</span>
                        <span class="mt-0.5 block text-xs leading-relaxed text-muted-foreground">
                            @s.Description
                        </span>
                    </button>
                }
            </div>

            @* Quick prompt pills *@
            <div class="mb-6 flex flex-wrap items-center justify-center gap-1.5">
                @foreach (var prompt in _quickPrompts)
                {
                    <button type="button"
                            class="rounded-full border px-3 py-1 text-xs text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground"
                            @onclick="@(() => _input = prompt)">
                        @prompt
                    </button>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <InputCn Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0"
                         Placeholder="Ask me anything..."
                         @bind-Value="_input" aria-label="Ask me anything..." />
                <ButtonCn aria-label="Send message" Class="size-7 shrink-0 p-0"
                          Size="ButtonSize.Sm"
                          Variant="ButtonVariant.Outline"
                          Disabled="@(string.IsNullOrWhiteSpace(_input))">
                    <LucideArrowUpCn Size="16" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record SuggestionItem(string Id, string Title, string Description, string Prompt);

    private static readonly SuggestionItem[] _suggestions =
    {
        new("s1", "Write Code", "Generate, debug, or refactor code in any language",
            "Help me write a TypeScript function that validates email addresses with proper error handling"),
        new("s2", "Draft Content", "Blog posts, emails, documentation, and more",
            "Write a professional email announcing a new product feature to our customers"),
        new("s3", "Brainstorm Ideas", "Explore concepts, strategies, and creative solutions",
            "Help me brainstorm 10 unique feature ideas for a project management SaaS app"),
        new("s4", "Explain Concepts", "Break down complex topics into clear explanations",
            "Explain how database indexing works and when I should add indexes to my PostgreSQL tables")
    };

    private static readonly string[] _quickPrompts =
    {
        "Summarize a document",
        "Create a study plan",
        "Compare two technologies",
        "Review my resume"
    };

    private string _input = "";
}
