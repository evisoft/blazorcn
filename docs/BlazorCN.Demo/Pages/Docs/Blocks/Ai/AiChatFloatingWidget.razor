@* ===========================================================
   Block: ai-chat-floating-widget
   Title: Ai Chat Floating Widget
   Description: React AI floating chat widget block for Next.js with collapsible bubble, compact chat panel, toggle animation, and embedded message input using shadcn/ui and Tailwind CSS
   Long Description: React AI Chat Empty State Block
   Dependencies: ButtonCn, InputCn
   Source: original/blocks/ai/ai-chat-floating-widget.tsx
   =========================================================== *@

<div class="flex h-[520px] w-full items-end justify-end p-4">
    @if (_isOpen)
    {
        <div class="flex h-[460px] w-[380px] flex-col overflow-hidden rounded-lg border bg-card shadow-lg">
            @* Header *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="flex-1">
                    <span class="font-medium text-sm">AI Assistant</span>
                    <p class="text-muted-foreground text-xs">Always here to help</p>
                </div>
                <div class="flex items-center gap-1">
                    <ButtonCn aria-label="Minimize chat" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0"
                              @onclick="@(() => _isOpen = false)">
                        <LucideMinusCn Size="14" Class="size-3.5" />
                    </ButtonCn>
                    <ButtonCn aria-label="Close chat" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0"
                              @onclick="@(() => _isOpen = false)">
                        <LucideXCn Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            </div>

            @* Messages *@
            <div class="flex-1 overflow-y-auto" tabindex="0" role="group" aria-label="Chat messages">
                <div class="flex flex-col gap-4 p-4">
                    @foreach (var msg in _messages)
                    {
                        <div class="flex flex-col gap-1">
                            @if (msg.Role == "assistant")
                            {
                                <div class="min-w-0 space-y-1">
                                    <div class="rounded-lg bg-muted/50 px-3 py-2">
                                        <p class="text-xs leading-relaxed">@msg.Content</p>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <ButtonCn aria-label="Copy message" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-1">
                                            <LucideCopyCn Size="12" Class="size-3" />
                                        </ButtonCn>
                                        <ButtonCn aria-label="Helpful" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-6 p-1">
                                            <LucideThumbsUpCn Size="12" Class="size-3" />
                                        </ButtonCn>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="rounded-lg bg-primary px-3 py-2 text-primary-foreground self-end">
                                    <p class="text-xs">@msg.Content</p>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Input *@
            <div class="border-t px-3 py-3">
                <div class="flex items-center gap-2">
                    <InputCn @bind-Value="_input"
                             Placeholder="Type a message..."
                             Class="h-7 border-0 bg-transparent px-0 text-xs shadow-none focus-visible:ring-0" aria-label="Type a message..." />
                    <ButtonCn aria-label="Send message" Type="submit"
                              Size="ButtonSize.Sm"
                              Variant="ButtonVariant.Outline"
                              Disabled="@(string.IsNullOrWhiteSpace(_input))"
                              Class="size-7 shrink-0 p-0">
                        <LucideSendCn Size="12" Class="size-3" />
                    </ButtonCn>
                </div>
            </div>

            @* Footer *@
            <div class="border-t px-4 py-2">
                <p class="text-center text-muted-foreground text-[10px]">
                    Powered by AI — responses may not always be accurate
                </p>
            </div>
        </div>
    }
    else
    {
        <button type="button"
                @onclick="@(() => _isOpen = true)"
                class="relative flex size-12 items-center justify-center rounded-full border bg-card shadow-lg transition-colors hover:bg-muted/50">
            <LucideMessageSquareCn Size="20" Class="size-5 text-foreground" />
            <span class="absolute -top-0.5 -right-0.5 flex size-4 items-center justify-center rounded-full bg-foreground text-[9px] font-medium text-background">
                1
            </span>
        </button>
    }
</div>

@code {
    private record ChatMessage(string Id, string Role, string Content);

    private static readonly ChatMessage[] _messages =
    {
        new("1", "assistant", "Hey! I'm your AI assistant. Ask me anything about our product, pricing, or features."),
        new("2", "user", "Do you offer a free trial?"),
        new("3", "assistant", "Yes! We offer a 14-day free trial with full access to all features. No credit card required to start. You can upgrade anytime during or after the trial.\n\nWould you like me to help you get started?")
    };

    private bool _isOpen = true;
    private string _input = "";
}
