@* ===========================================================
   Block: ai-data-analyst
   Title: Ai Data Analyst
   Description: AI data analysis assistant with upload area, key insights cards, anomaly detection, and visualization recommendations
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideCheckCn, LucideChevronRightCn, LucideCopyCn
   Source: original/blocks/ai/ai-data-analyst.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Upload / file input *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <InputCn ReadOnly="true"
                     Value="sales_data_q3_2025.csv"
                     Class="h-8 border-0 bg-transparent px-0 font-mono shadow-none focus-visible:ring-0" aria-label="Uploaded file" />
            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs font-normal">
                12,847 rows
            </BadgeCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs">
                Upload
            </ButtonCn>
        </div>

        @* Key Insights *@
        <div class="border-b">
            <div class="px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Key insights</span>
            </div>
            @for (var i = 0; i < _insights.Length; i++)
            {
                var insight = _insights[i];
                var isLast = i == _insights.Length - 1;
                <div class="@(!isLast ? "border-b" : "")">
                    <div class="flex items-center gap-3 px-4 py-3">
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@insight.Title</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">@insight.Description</p>
                        </div>
                        <div class="text-right">
                            <span class="font-semibold tabular-nums">@insight.Metric</span>
                            <p class="@Cn.Merge("font-mono text-xs", insight.Positive ? "text-emerald-600 dark:text-emerald-400" : "text-red-600 dark:text-red-400")">
                                @insight.Change
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* Anomalies *@
        <div class="border-b">
            <div class="px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Anomalies</span>
            </div>
            @for (var i = 0; i < _anomalies.Length; i++)
            {
                var anomaly = _anomalies[i];
                var expandKey = $"a-{anomaly.Id}";
                var isExpanded = _expanded == expandKey;
                var isLast = i == _anomalies.Length - 1;
                var key = expandKey;
                <div class="@(!isLast ? "border-b" : "")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : key)">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetSeverityDot(anomaly.Severity))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@anomaly.Title</span>
                            <p class="mt-0.5 font-mono text-xs text-muted-foreground">@anomaly.Metric</p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-1.5 flex items-center justify-between">
                                    <span class="text-xs font-medium text-muted-foreground">Details</span>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs"
                                              @onclick="@(() => HandleCopy(key))">
                                        @if (_copied == key)
                                        {
                                            <LucideCheckCn Size="16" Class="size-3" />
                                            <text>Copied</text>
                                        }
                                        else
                                        {
                                            <LucideCopyCn Size="16" Class="size-3" />
                                            <text>Copy</text>
                                        }
                                    </ButtonCn>
                                </div>
                                <p class="text-sm leading-relaxed">@anomaly.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Suggested Visualizations *@
        <div>
            <div class="px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Suggested visualizations</span>
            </div>
            @for (var i = 0; i < _chartSuggestions.Length; i++)
            {
                var chart = _chartSuggestions[i];
                var isLast = i == _chartSuggestions.Length - 1;
                <div class="@(!isLast ? "border-b" : "")">
                    <div class="flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50">
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@chart.Title</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">@chart.Description</p>
                            <div class="mt-1.5 flex flex-wrap gap-1">
                                @foreach (var col in chart.Columns)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px]">
                                        @col
                                    </BadgeCn>
                                }
                            </div>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 shrink-0 text-xs text-muted-foreground">
                            Generate
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Insight(string Id, string Title, string Description, string Metric, string Change, bool Positive);
    private record Anomaly(string Id, string Title, string Description, string Severity, string Metric);
    private record ChartSuggestion(string Id, string Title, string Description, string Type, string[] Columns);

    private static readonly Insight[] _insights =
    {
        new("1", "Revenue Trend",
            "Monthly recurring revenue has grown consistently over the past 6 months with a compound monthly growth rate of 8.3%.",
            "$2.4M MRR", "+8.3%", true),
        new("2", "Customer Retention",
            "Net revenue retention is 124%, indicating strong expansion revenue from existing customers outpacing churn.",
            "124% NRR", "+6pts", true),
        new("3", "Acquisition Cost",
            "Customer acquisition cost has decreased by 12% due to improved organic traffic and referral program performance.",
            "$342 CAC", "-12%", true)
    };

    private static readonly Anomaly[] _anomalies =
    {
        new("1", "Churn Spike Detected",
            "Enterprise segment churn rate jumped from 2.1% to 5.8% in the last 30 days, 2.7x above the trailing average.",
            "high", "5.8% churn"),
        new("2", "Unusual Traffic Pattern",
            "API request volume dropped 34% on March 8-9, correlating with a deployment window. Investigate potential downtime impact.",
            "medium", "-34% requests")
    };

    private static readonly ChartSuggestion[] _chartSuggestions =
    {
        new("1", "Revenue Over Time", "Visualize monthly revenue trend with growth trajectory", "line", new[] { "month", "revenue", "target" }),
        new("2", "Segment Distribution", "Break down revenue by customer segment", "pie", new[] { "segment", "revenue_share" }),
        new("3", "CAC vs LTV", "Compare acquisition cost against lifetime value per cohort", "scatter", new[] { "cohort", "cac", "ltv" }),
        new("4", "Feature Adoption", "Track feature usage across pricing tiers", "bar", new[] { "feature", "free", "pro", "enterprise" })
    };

    private string? _expanded = "a-1";
    private string? _copied;

    private static string GetSeverityDot(string severity) => severity switch
    {
        "high" => "bg-red-500",
        "medium" => "bg-amber-500",
        "low" => "bg-blue-500",
        _ => "bg-gray-500"
    };

    private async Task HandleCopy(string id)
    {
        _copied = id;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = null;
    }
}
