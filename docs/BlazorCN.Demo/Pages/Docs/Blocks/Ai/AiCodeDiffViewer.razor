@* ===========================================================
   Block: ai-code-diff-viewer
   Title: Ai Code Diff Viewer
   Description: AI side-by-side code diff viewer with highlighted changes, file header, and apply button
   Dependencies: BadgeCn, ButtonCn, LucideCheckCn, LucideCopyCn
   Source: original/blocks/ai/ai-code-diff-viewer.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex flex-col gap-3 border-b px-4 py-3 sm:flex-row sm:items-center">
            <div class="flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-mono text-sm font-medium">server.ts</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-xs font-normal">
                        TypeScript
                    </BadgeCn>
                </div>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    AI refactored: added validation, error handling, parameterized queries
                </p>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="font-mono tabular-nums text-emerald-600 dark:text-emerald-400">+@Additions</span>
                </span>
                <span class="flex items-center gap-1.5 text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    <span class="font-mono tabular-nums text-red-600 dark:text-red-400">-@Deletions</span>
                </span>
            </div>
        </div>

        @* Diff Panels *@
        <div class="grid grid-cols-1 md:grid-cols-2">
            @* Before *@
            <div class="border-r">
                <div class="border-b px-4 py-2">
                    <span class="text-xs font-medium text-muted-foreground">Before</span>
                </div>
                <div class="max-h-[420px] overflow-y-auto" tabindex="0" role="group" aria-label="Code before changes">
                    <pre class="p-0 font-mono text-xs leading-[22px]"><code>@foreach (var line in _beforeLines)
{<div class="@GetBeforeLineBg(line.Type) flex"><span class="flex w-10 shrink-0 select-none items-center justify-end border-r pr-2 text-muted-foreground/40">@line.Number</span><span class="w-5 shrink-0 select-none text-center text-red-500/60">@GetBeforeMarker(line.Type)</span><span class="@GetBeforeTextClass(line.Type) flex-1 pr-4">@(string.IsNullOrEmpty(line.Content) ? "\u00A0" : line.Content)</span></div>}</code></pre>
                </div>
            </div>

            @* After *@
            <div>
                <div class="border-b px-4 py-2">
                    <span class="text-xs font-medium text-muted-foreground">After</span>
                </div>
                <div class="max-h-[420px] overflow-y-auto" tabindex="0" role="group" aria-label="Code after changes">
                    <pre class="p-0 font-mono text-xs leading-[22px]"><code>@foreach (var line in _afterLines)
{<div class="@GetAfterLineBg(line.Type) flex"><span class="flex w-10 shrink-0 select-none items-center justify-end border-r pr-2 text-muted-foreground/40">@line.Number</span><span class="w-5 shrink-0 select-none text-center text-emerald-500/60">@GetAfterMarker(line.Type)</span><span class="@GetAfterTextClass(line.Type) flex-1 pr-4">@(string.IsNullOrEmpty(line.Content) ? "\u00A0" : line.Content)</span></div>}</code></pre>
                </div>
            </div>
        </div>

        @* Actions *@
        <div class="flex items-center justify-end gap-2 border-t px-4 py-3">
            <ButtonCn Class="h-7 gap-1.5 text-xs" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="HandleCopy">
                @if (_copied)
                {
                    <LucideCheckCn Size="16" Class="size-3" />
                    <text>Copied</text>
                }
                else
                {
                    <LucideCopyCn Size="16" Class="size-3" />
                    <text>Copy improved code</text>
                }
            </ButtonCn>
            <ButtonCn Class="h-7 gap-1.5 text-xs"
                      Variant="ButtonVariant.Outline"
                      Size="ButtonSize.Sm"
                      Disabled="@_applied"
                      @onclick="@(() => _applied = true)">
                @if (_applied)
                {
                    <LucideCheckCn Size="16" Class="size-3" />
                    <text>Applied</text>
                }
                else
                {
                    <text>Apply Changes</text>
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record DiffLine(int Number, string Content, string Type);

    private static readonly DiffLine[] _beforeLines =
    {
        new(1, "import express from \"express\"", "unchanged"),
        new(2, "", "unchanged"),
        new(3, "const app = express()", "unchanged"),
        new(4, "", "unchanged"),
        new(5, "app.get(\"/users\", (req, res) => {", "modified"),
        new(6, "  const users = db.query(", "modified"),
        new(7, "    \"SELECT * FROM users\"", "modified"),
        new(8, "  )", "modified"),
        new(9, "  res.json(users)", "modified"),
        new(10, "})", "unchanged"),
        new(11, "", "unchanged"),
        new(12, "app.post(\"/users\", (req, res) => {", "modified"),
        new(13, "  const { name, email } = req.body", "unchanged"),
        new(14, "  db.query(", "modified"),
        new(15, "    `INSERT INTO users (name, email)", "removed"),
        new(16, "     VALUES ('${name}', '${email}')`", "removed"),
        new(17, "  )", "modified"),
        new(18, "  res.json({ success: true })", "modified"),
        new(19, "})", "unchanged"),
        new(20, "", "unchanged"),
        new(21, "app.listen(3000)", "modified")
    };

    private static readonly DiffLine[] _afterLines =
    {
        new(1, "import express from \"express\"", "unchanged"),
        new(2, "import { z } from \"zod\"", "added"),
        new(3, "", "unchanged"),
        new(4, "const app = express()", "unchanged"),
        new(5, "", "unchanged"),
        new(6, "app.get(\"/users\", async (req, res) => {", "modified"),
        new(7, "  try {", "added"),
        new(8, "    const users = await db.query(", "modified"),
        new(9, "      \"SELECT id, name, email FROM users\"", "modified"),
        new(10, "    )", "modified"),
        new(11, "    res.json(users.rows)", "modified"),
        new(12, "  } catch (err) {", "added"),
        new(13, "    res.status(500).json({ error: \"Internal error\" })", "added"),
        new(14, "  }", "added"),
        new(15, "})", "unchanged"),
        new(16, "", "unchanged"),
        new(17, "app.post(\"/users\", async (req, res) => {", "modified"),
        new(18, "  const { name, email } = req.body", "unchanged"),
        new(19, "  await db.query(", "modified"),
        new(20, "    \"INSERT INTO users (name, email) VALUES ($1, $2)\",", "modified"),
        new(21, "    [name, email]", "added"),
        new(22, "  )", "modified"),
        new(23, "  res.status(201).json({ success: true })", "modified"),
        new(24, "})", "unchanged"),
        new(25, "", "unchanged"),
        new(26, "app.listen(3000, () => {", "modified"),
        new(27, "  console.log(\"Server running on port 3000\")", "added"),
        new(28, "})", "added")
    };

    private bool _applied;
    private bool _copied;

    private int Additions => _afterLines.Count(l => l.Type is "added" or "modified");
    private int Deletions => _beforeLines.Count(l => l.Type is "removed" or "modified");

    private static string GetBeforeLineBg(string type) => type switch
    {
        "removed" => "bg-red-500/5",
        "modified" => "bg-amber-500/5",
        _ => ""
    };

    private static string GetBeforeMarker(string type) => type switch
    {
        "removed" => "-",
        "modified" => "~",
        _ => ""
    };

    private static string GetBeforeTextClass(string type) => type switch
    {
        "removed" => "text-red-600 line-through decoration-red-300/30 dark:text-red-400",
        "modified" => "text-amber-700 dark:text-amber-400",
        _ => "text-muted-foreground"
    };

    private static string GetAfterLineBg(string type) => type switch
    {
        "added" => "bg-emerald-500/5",
        "modified" => "bg-blue-500/5",
        _ => ""
    };

    private static string GetAfterMarker(string type) => type switch
    {
        "added" => "+",
        "modified" => "~",
        _ => ""
    };

    private static string GetAfterTextClass(string type) => type switch
    {
        "added" => "text-emerald-600 dark:text-emerald-400",
        "modified" => "text-blue-700 dark:text-blue-400",
        _ => "text-muted-foreground"
    };

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
