@* ===========================================================
   Block: ai-chat-branching
   Title: Ai Chat Branching
   Description: AI chat branching block with response versioning, branch navigation, and alternative AI responses
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideCopyCn, LucideRefreshCcwCn, LucideSendCn, LucideThumbsDownCn, LucideThumbsUpCn
   Source: original/blocks/ai/ai-chat-branching.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="flex-1 text-sm font-medium">Branching Chat</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                Branching enabled
            </BadgeCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto">
            <div class="flex flex-col gap-6 p-4">
                @foreach (var group in _branchGroups)
                {
                    <div class="flex flex-col gap-4">
                        @* User question *@
                        <div class="flex justify-end">
                            <div class="max-w-[80%] rounded-lg bg-primary px-3 py-2 text-sm text-primary-foreground">
                                <p>@group.Question.Content</p>
                            </div>
                        </div>

                        @* Branched responses *@
                        <div class="min-w-0 space-y-2">
                            @{
                                var groupId = group.Id;
                                var branchIndex = GetBranchIndex(groupId);
                                var alt = group.Alternatives[branchIndex];
                            }
                            <div class="rounded-lg bg-muted/50 px-3 py-2">
                                <div class="whitespace-pre-wrap text-sm">@alt.Content</div>
                            </div>

                            @* Branch navigation *@
                            <div class="flex items-center gap-2">
                                <ButtonCn Class="size-6 p-0"
                                          Size="ButtonSize.Icon"
                                          Variant="ButtonVariant.Ghost"
                                          Disabled="@(branchIndex == 0)"
                                          @onclick="@(() => SetBranchIndex(groupId, branchIndex - 1))">
                                    <span class="text-xs">&lsaquo;</span>
                                </ButtonCn>
                                <span class="text-xs text-muted-foreground">
                                    @(branchIndex + 1) / @group.Alternatives.Length
                                </span>
                                <ButtonCn Class="size-6 p-0"
                                          Size="ButtonSize.Icon"
                                          Variant="ButtonVariant.Ghost"
                                          Disabled="@(branchIndex >= group.Alternatives.Length - 1)"
                                          @onclick="@(() => SetBranchIndex(groupId, branchIndex + 1))">
                                    <span class="text-xs">&rsaquo;</span>
                                </ButtonCn>
                            </div>

                            @* Actions *@
                            <div class="flex items-center gap-1">
                                <ButtonCn Class="size-7 text-muted-foreground" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                                    <LucideCopyCn Size="16" Class="size-3.5" />
                                </ButtonCn>
                                <ButtonCn Class="size-7 text-muted-foreground" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                                    <LucideRefreshCcwCn Size="16" Class="size-3.5" />
                                </ButtonCn>
                                <ButtonCn Class="size-7 text-muted-foreground" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                                    <LucideThumbsUpCn Size="16" Class="size-3.5" />
                                </ButtonCn>
                                <ButtonCn Class="size-7 text-muted-foreground" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost">
                                    <LucideThumbsDownCn Size="16" Class="size-3.5" />
                                </ButtonCn>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <InputCn Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0"
                         Placeholder="Ask a question to get multiple perspectives..."
                         @bind-Value="_input" />
                <ButtonCn Class="h-7 shrink-0 gap-1.5 text-xs"
                          Size="ButtonSize.Sm"
                          Variant="ButtonVariant.Outline"
                          Disabled="@(string.IsNullOrWhiteSpace(_input))">
                    <LucideSendCn Size="16" Class="size-3" />
                    Send
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Role, string Content);
    private record BranchGroup(string Id, ChatMessage Question, ChatMessage[] Alternatives);

    private static readonly BranchGroup[] _branchGroups =
    {
        new("bg-1",
            new("q1", "user", "Explain the event loop in JavaScript. Keep it concise."),
            new ChatMessage[]
            {
                new("a1-v1", "assistant", "The event loop is JavaScript's mechanism for handling async operations in a single-threaded environment.\n\nHow it works:\n1. Call Stack \u2014 Executes synchronous code, one frame at a time\n2. Web APIs \u2014 Browser handles async tasks (setTimeout, fetch, DOM events) outside the main thread\n3. Callback Queue \u2014 Completed async callbacks wait here\n4. Event Loop \u2014 Checks: is the call stack empty? If yes, push the next callback from the queue onto the stack\n\nKey insight: JavaScript never runs two things simultaneously. The event loop just decides when each piece of code gets its turn.\n\nEven with a 0ms delay, the callback waits for the stack to clear."),
                new("a1-v2", "assistant", "Think of JavaScript as a restaurant with one chef (single thread).\n\nThe kitchen analogy:\n- The call stack is the chef's current task \u2014 chop onions, boil water, plate food\n- Web APIs are the ovens and timers \u2014 they run on their own\n- The callback queue is the order rail \u2014 finished items waiting to be plated\n- The event loop is the chef glancing at the rail: \"Am I free? Let me grab the next thing.\"\n\nThe chef can only do one thing at a time, but the ovens keep cooking in the background. That's why fetch() doesn't freeze your UI.\n\nMicrotasks vs Macrotasks: Promises (microtasks) cut the line. They're processed before the next setTimeout/setInterval (macrotasks)."),
                new("a1-v3", "assistant", "The event loop in 4 sentences:\n\nJavaScript has one thread. It runs synchronous code first (call stack). Async callbacks (timers, network, events) queue up and wait. The event loop moves queued callbacks onto the stack once it's empty.\n\nPriority: Microtask queue (Promises) > Macrotask queue (setTimeout). Always.")
            }),
        new("bg-2",
            new("q2", "user", "What's the best state management solution for React in 2026?"),
            new ChatMessage[]
            {
                new("a2-v1", "assistant", "It depends on your scale. Here's the honest breakdown:\n\nSmall apps (1-5 devs): Just use React's built-in tools.\n- useState + useContext covers 90% of cases\n- Server Components eliminate most client state entirely\n\nMedium apps (5-20 devs): Pick ONE external store.\n- Zustand \u2014 Minimal API, no boilerplate, great TypeScript support. The winner for most teams.\n- Jotai \u2014 Atomic model, great for complex derived state\n\nLarge apps (20+ devs): Consider more structure.\n- TanStack Query for server state (not a choice \u2014 just use it)\n- Zustand or Jotai for client state\n\nThe real answer: Use server components to eliminate state where possible. Then Zustand for what's left."),
                new("a2-v2", "assistant", "Hot take: you probably don't need one.\n\nReact Server Components changed the game. Most \"state\" in traditional React apps is actually server data that shouldn't live on the client at all.\n\nThe modern stack:\n1. Server Components for anything fetched from a database -> no state needed\n2. TanStack Query for client-side data fetching -> handles caching, refetching, optimistic updates\n3. useState for UI state (modals, forms, toggles)\n4. URL state for filters, pagination, tabs\n\nThat covers 95% of real-world apps. No Redux, no Zustand, no context providers wrapping your entire tree.\n\nWhen you DO need a global store: Zustand. It's 1kb, works with Server Components, no providers needed. But reach for it last, not first.")
            })
    };

    private string _input = "";
    private readonly Dictionary<string, int> _branchIndices = new();

    private int GetBranchIndex(string groupId) =>
        _branchIndices.GetValueOrDefault(groupId, 0);

    private void SetBranchIndex(string groupId, int index)
    {
        _branchIndices[groupId] = index;
    }
}
