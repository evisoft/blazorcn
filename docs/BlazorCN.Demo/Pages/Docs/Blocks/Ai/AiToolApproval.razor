@* ===========================================================
   Block: ai-tool-approval
   Title: Ai Tool Approval
   Description: React AI tool approval block for Next.js with human-in-the-loop confirmation, risk assessment badges, and parameter review using shadcn/ui and Tailwind CSS
   Long Description: React AI Tool Database Query Block
   Dependencies: BadgeCn, ButtonCn, LucideCheckCn, LucideChevronRightCn, LucideXCn
   Source: original/blocks/ai/ai-tool-approval.tsx
   =========================================================== *@

@if (_status != "pending")
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="flex flex-col items-center gap-3 px-4 py-8 text-center">
                <span class="@Cn.Merge("flex size-8 items-center justify-center rounded-full", _status == "approved" ? "bg-emerald-500/10" : "bg-muted")">
                    @if (_status == "approved")
                    {
                        <LucideCheckCn Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                    }
                    else
                    {
                        <LucideXCn Size="16" Class="size-4 text-muted-foreground" />
                    }
                </span>
                <div>
                    <p class="text-sm font-medium">
                        @(_status == "approved" ? "Action Approved" : "Action Rejected")
                    </p>
                    <p class="text-xs text-muted-foreground">
                        @(_status == "approved"
                            ? "The tool execution has been authorized."
                            : "The tool execution has been denied.")
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                          Class="h-7 text-xs"
                          OnClick="@(() => _status = "pending")">
                    Reset
                </ButtonCn>
            </div>
        </div>
    </section>
}
else
{
    <section class="mx-auto w-full max-w-2xl p-4">
        <div class="overflow-hidden rounded-lg border bg-card">
            @* Header *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <span class="@($"size-2 shrink-0 rounded-full {_riskDot[_request.RiskLevel]}")"></span>
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@_request.ToolName</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">@_request.Description</p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs font-normal">
                    @_riskLabel[_request.RiskLevel]
                </BadgeCn>
            </div>

            @* Warning *@
            <div class="border-b px-4 py-3">
                <div class="rounded-md bg-muted/50 p-3">
                    <span class="text-xs font-medium text-muted-foreground">Impact</span>
                    <p class="mt-1 text-sm leading-relaxed">@_request.EstimatedImpact</p>
                </div>
            </div>

            @* Parameters *@
            <div class="border-b">
                <button type="button"
                        @onclick="@(() => _showParams = !_showParams)"
                        class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                    <span class="text-sm font-medium">Parameters</span>
                    <span class="text-xs text-muted-foreground">@_request.Parameters.Length</span>
                    <LucideChevronRightCn Size="16" Class="@Cn.Merge("ml-auto size-4 text-muted-foreground/60 transition-transform duration-200", _showParams ? "rotate-90" : "")" />
                </button>
                @if (_showParams)
                {
                    <div class="border-t">
                        @for (var i = 0; i < _request.Parameters.Length; i++)
                        {
                            var param = _request.Parameters[i];
                            var isLast = i == _request.Parameters.Length - 1;
                            <div class="@($"flex items-center justify-between px-4 py-2 {(isLast ? "" : "border-b")}")">
                                <span class="text-xs text-muted-foreground">@param.Label</span>
                                <span class="font-mono text-xs">@param.Value</span>
                            </div>
                        }
                    </div>
                }
            </div>

            @* Target resource *@
            <div class="flex items-center justify-between border-b px-4 py-2.5">
                <span class="text-xs text-muted-foreground">Target</span>
                <span class="font-mono text-xs">@_request.AffectedResources</span>
            </div>

            @* Actions *@
            <div class="flex justify-end gap-2 px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                          Class="h-7 gap-1 text-xs"
                          OnClick="@(() => _status = "rejected")">
                    <LucideXCn Size="12" Class="size-3" />
                    Reject
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Destructive" Size="ButtonSize.Sm"
                          Class="h-7 gap-1 text-xs"
                          OnClick="@(() => _status = "approved")">
                    <LucideCheckCn Size="12" Class="size-3" />
                    Approve
                </ButtonCn>
            </div>
        </div>
    </section>
}

@code {
    private record ParamData(string Label, string Value);
    private record ApprovalRequest(string ToolName, string Description, string RiskLevel, ParamData[] Parameters, string AffectedResources, string EstimatedImpact);

    private string _status = "pending";
    private bool _showParams = true;

    private static readonly Dictionary<string, string> _riskDot = new()
    {
        ["low"] = "bg-emerald-500",
        ["medium"] = "bg-amber-500",
        ["high"] = "bg-orange-500",
        ["destructive"] = "bg-red-500",
    };

    private static readonly Dictionary<string, string> _riskLabel = new()
    {
        ["low"] = "Low Risk",
        ["medium"] = "Medium Risk",
        ["high"] = "High Risk",
        ["destructive"] = "Destructive",
    };

    private static readonly ApprovalRequest _request = new(
        "Database Mutation",
        "Delete 47 records from users table where last_login < '2024-01-01'",
        "destructive",
        [
            new("Table", "users"),
            new("Operation", "DELETE"),
            new("Condition", "last_login < '2024-01-01'"),
            new("Affected Rows", "47"),
        ],
        "Production Database (us-east-1)",
        "Permanent deletion of 47 user accounts and associated data"
    );
}
