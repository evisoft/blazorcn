@* ===========================================================
   Block: ai-terminal-output
   Title: Ai Terminal Output
   Description: React AI terminal output block for Next.js with colorized console output, command input, and scrollable log display using shadcn/ui and Tailwind CSS
   Long Description:
   Dependencies: ButtonCn, LucideCheckCn, LucideCopyCn, LucidePlayCn, LucideTrashCn
   Source: original/blocks/ai/ai-terminal-output.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-zinc-800 bg-zinc-950">
        @* Title Bar *@
        <div class="flex items-center gap-3 border-b border-zinc-800 px-4 py-2.5">
            <div class="flex items-center gap-1.5">
                <span class="size-2.5 rounded-full bg-zinc-700"></span>
                <span class="size-2.5 rounded-full bg-zinc-700"></span>
                <span class="size-2.5 rounded-full bg-zinc-700"></span>
            </div>
            <span class="flex-1 font-mono text-xs text-zinc-500">ai-sandbox</span>
            <div class="flex items-center gap-3 text-zinc-500">
                @if (_errorCount > 0)
                {
                    <span class="flex items-center gap-1.5 font-mono text-[10px] text-red-400">
                        <span class="size-1.5 rounded-full bg-red-500"></span>
                        @_errorCount
                    </span>
                }
                @if (_warningCount > 0)
                {
                    <span class="flex items-center gap-1.5 font-mono text-[10px] text-amber-400">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        @_warningCount
                    </span>
                }
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          OnClick="HandleClear"
                          Class="h-6 gap-1 px-2 text-[10px] text-zinc-600 hover:bg-zinc-800 hover:text-zinc-300">
                    <LucideTrashCn Size="12" Class="size-3" />
                    Clear
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                          Class="h-6 gap-1 px-2 text-[10px] text-zinc-600 hover:bg-zinc-800 hover:text-zinc-300"
                          OnClick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="12" Class="size-3" />
                        <text>Copied</text>
                    }
                    else
                    {
                        <LucideCopyCn Size="12" Class="size-3" />
                        <text>Copy</text>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Output *@
        <div class="max-h-[480px] overflow-y-auto p-4 font-mono text-[13px] leading-[22px]">
            @foreach (var log in _logs)
            {
                <div class="@($"flex gap-3 {_levelStyles[log.Level]}")">
                    @if (log.Timestamp != null)
                    {
                        <span class="shrink-0 select-none text-zinc-700">@log.Timestamp</span>
                    }
                    <span class="min-w-0 break-all">@(string.IsNullOrEmpty(log.Content) ? "\u00A0" : log.Content)</span>
                </div>
            }
        </div>

        @* Command Input *@
        <div class="border-t border-zinc-800 px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="font-mono text-sm text-emerald-400">$</span>
                <input type="text"
                       @bind="_command"
                       @bind:event="oninput"
                       placeholder="Enter command..."
                       class="flex-1 bg-transparent font-mono text-sm text-zinc-200 outline-none placeholder:text-zinc-700" />
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                          Disabled="@string.IsNullOrWhiteSpace(_command)"
                          Class="h-7 gap-1 text-xs"
                          OnClick="HandleSubmit">
                    <LucidePlayCn Size="12" Class="size-3" />
                    Run
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private class LogLine
    {
        public string Id { get; set; } = "";
        public string Level { get; set; } = "";
        public string Content { get; set; } = "";
        public string? Timestamp { get; set; }
    }

    private string _command = "";
    private bool _copied;
    private int _nextId = 40;
    private List<LogLine> _logs = new(InitialLogs);

    private int _errorCount => _logs.Count(l => l.Level == "error");
    private int _warningCount => _logs.Count(l => l.Level == "warning");

    private static readonly Dictionary<string, string> _levelStyles = new()
    {
        ["command"] = "text-cyan-400 font-semibold",
        ["output"] = "text-zinc-400",
