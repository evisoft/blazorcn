    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_command)) return;
        _logs.Add(new LogLine
        {
            Id = _nextId.ToString(),
            Level = "command",
            Content = $"$ {_command}",
            Timestamp = "09:43:00",
        });
        _nextId++;
        _command = "";
    }

    private void HandleClear()
    {
        _logs.Clear();
        _logs.Add(new LogLine
        {
            Id = _nextId.ToString(),
            Level = "system",
            Content = "Terminal cleared.",
            Timestamp = "09:43:00",
        });
        _nextId++;
    }

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
