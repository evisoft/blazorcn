@* ===========================================================
   Block: ai-contract-reviewer
   Title: Ai Contract Reviewer
   Description: AI contract review with clause analysis, risk highlighting, summary statistics, confidence scoring, and actionable recommendations
   Dependencies: BadgeCn, ButtonCn, LucideCheckCn, LucideChevronRightCn, LucideCopyCn
   Source: original/blocks/ai/ai-contract-reviewer.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="@Cn.Merge("text-2xl font-semibold tabular-nums", ScoreColor)">
                    @Confidence
                </span>
                <span class="text-xs text-muted-foreground">/100</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                @(Confidence >= 90 ? "Low risk" : Confidence >= 70 ? "Moderate risk" : "High risk")
            </BadgeCn>
            <span class="text-xs text-muted-foreground">&middot;</span>
            <span class="text-xs text-muted-foreground">@_clauses.Length clauses</span>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @RiskCount
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @ReviewCount
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @StandardCount
                </span>
            </div>
        </div>

        @* Clauses *@
        <div class="border-b">
            @for (var i = 0; i < _clauses.Length; i++)
            {
                var clause = _clauses[i];
                var isExpanded = _expanded == clause.Id;
                var isLast = i == _clauses.Length - 1;
                var clauseId = clause.Id;
                <div class="@(!isLast ? "border-b" : "")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : clauseId)">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetStatusDot(clause.Status))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@clause.Title</span>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="space-y-3 px-4 pb-4 pl-9">
                            @* Clause text *@
                            <div class="rounded-md bg-zinc-950 p-3 font-mono text-sm text-zinc-300">
                                @clause.Text
                            </div>

                            @* AI Note *@
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-1.5 flex items-center justify-between">
                                    <span class="text-xs font-medium text-muted-foreground">Analysis</span>
                                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs"
                                              @onclick="@(() => HandleCopy(clauseId))">
                                        @if (_copied == clauseId)
                                        {
                                            <LucideCheckCn Size="16" Class="size-3" />
                                            <text>Copied</text>
                                        }
                                        else
                                        {
                                            <LucideCopyCn Size="16" Class="size-3" />
                                            <text>Copy</text>
                                        }
                                    </ButtonCn>
                                </div>
                                <p class="text-sm leading-relaxed">@clause.Note</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Recommendations *@
        <div class="px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Recommendations</span>
            <div class="mt-2 space-y-2">
                @for (var i = 0; i < _recommendations.Length; i++)
                {
                    var rec = _recommendations[i];
                    <div class="flex items-start gap-3">
                        <span class="mt-0.5 flex size-4 shrink-0 items-center justify-center rounded-full bg-muted font-mono text-[10px] text-muted-foreground">
                            @(i + 1)
                        </span>
                        <p class="text-sm leading-relaxed">@rec</p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record ContractClause(string Id, string Title, string Text, string Status, string Note);

    private const int Confidence = 91;

    private static readonly ContractClause[] _clauses =
    {
        new("c1", "Non-Compete Clause",
            "The Employee agrees not to engage in any competing business activity within a 200-mile radius for a period of 36 months following the termination of employment, regardless of the reason for termination.",
            "risk",
            "36-month duration and 200-mile radius are unusually restrictive. Most jurisdictions enforce 12-month / 50-mile maximum. This clause may be unenforceable and could be challenged in court."),
        new("c2", "Intellectual Property Assignment",
            "All work product, inventions, and intellectual property created by the Employee during the term of employment shall be the exclusive property of the Company, including work created outside of business hours.",
            "review",
            "The 'outside business hours' clause is broad. Consider adding exceptions for pre-existing IP and personal projects unrelated to company business."),
        new("c3", "Compensation & Benefits",
            "The Employee shall receive an annual base salary of $145,000, paid bi-weekly. The Employee is eligible for the standard benefits package including health insurance, 401(k) matching up to 4%, and 20 days paid time off.",
            "standard",
            "Compensation terms are clear and consistent with market rates for the role. Benefits package is within standard range."),
        new("c4", "Termination Without Cause",
            "The Company may terminate this agreement at any time without cause by providing 14 days written notice. Upon termination without cause, the Employee shall receive accrued wages only. No severance shall be provided.",
            "risk",
            "No severance on termination without cause is a significant risk. Industry standard is 2-4 weeks per year of service. The 14-day notice period is also shorter than the typical 30 days."),
        new("c5", "Confidentiality Agreement",
            "The Employee agrees to maintain the confidentiality of all proprietary information during and after employment. This obligation survives termination and has no expiration date.",
            "review",
            "Perpetual confidentiality obligations are common but consider requesting a reasonable time limit (3-5 years post-employment) for non-trade-secret information."),
        new("c6", "Dispute Resolution",
            "Any disputes arising from this agreement shall be resolved through binding arbitration in accordance with the rules of the American Arbitration Association, with proceedings held in the Company's home jurisdiction.",
            "standard",
            "Binding arbitration with AAA rules is standard. The venue is in the Company's jurisdiction, which is typical but worth noting.")
    };

    private static readonly string[] _recommendations =
    {
        "Negotiate the non-compete clause down to 12 months and 50-mile radius",
        "Request severance terms of at least 4 weeks per year of service",
        "Add carve-outs for personal IP in the intellectual property clause",
        "Set a 5-year expiration on confidentiality for non-trade-secret info",
        "Consider requesting a mutual arbitration clause instead of one-sided"
    };

    private string? _expanded = "c1";
    private string? _copied;

    private static int RiskCount => _clauses.Count(c => c.Status == "risk");
    private static int ReviewCount => _clauses.Count(c => c.Status == "review");
    private static int StandardCount => _clauses.Count(c => c.Status == "standard");

    private static string ScoreColor => Confidence >= 90
        ? "text-emerald-600 dark:text-emerald-400"
        : Confidence >= 70
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";

    private static string GetStatusDot(string status) => status switch
    {
        "risk" => "bg-red-500",
        "review" => "bg-amber-500",
        "standard" => "bg-emerald-500",
        _ => "bg-gray-500"
    };

    private async Task HandleCopy(string id)
    {
        _copied = id;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = null;
    }
}
