@* ===========================================================
   Block: ai-message-chain-of-thought
   Title: Ai Message Chain Of Thought
   Description: AI message with detailed chain-of-thought reasoning, multiple collapsible reasoning steps, and final answer
   Dependencies: BadgeCn, LucideChevronRightCn, LucideCopyCn, LucideThumbsUpCn
   Source: original/blocks/ai/ai-message-chain-of-thought.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* User message *@
        <div class="border-b px-4 py-3">
            <div class="ml-auto max-w-[80%] rounded-lg bg-primary px-3 py-2 text-primary-foreground">
                <p class="text-sm">My React app is really slow. What are the best ways to optimize rendering performance?</p>
            </div>
        </div>

        @* Reasoning header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted">
                <span class="text-[10px] font-medium text-muted-foreground">AI</span>
            </div>
            <span class="text-sm font-medium">Deep reasoning</span>
            <span class="text-xs text-muted-foreground">@_thinkingSteps.Length steps</span>
            <span class="text-xs text-muted-foreground">&middot;</span>
            <span class="font-mono text-xs text-muted-foreground">@(TotalDuration)s</span>
        </div>

        @* Reasoning steps *@
        <div>
            @for (var i = 0; i < _thinkingSteps.Length; i++)
            {
                var step = _thinkingSteps[i];
                var isExpanded = _expanded == step.Id;
                var stepId = step.Id;
                var idx = i;
                <div class="border-b">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : stepId)">
                        <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-muted">
                            <span class="font-mono text-[10px] text-muted-foreground">@(idx + 1)</span>
                        </span>
                        <span class="flex-1 text-sm font-medium">@step.Label</span>
                        <span class="font-mono text-xs text-muted-foreground">@(step.Duration)s</span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-12">
                            <div class="rounded-md bg-muted/30 p-3">
                                <p class="whitespace-pre-wrap text-sm leading-relaxed text-muted-foreground">@step.Content</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Final answer *@
        <div class="px-4 py-4">
            <div class="mb-2 flex items-center gap-2">
                <span class="text-xs font-medium text-muted-foreground">Final answer</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px]">
                    @(TotalDuration)s total
                </BadgeCn>
            </div>
            <div class="rounded-lg bg-muted/50 px-3 py-2">
                <p class="whitespace-pre-wrap text-sm leading-relaxed">@FinalAnswer</p>
            </div>

            <div class="mt-3 flex items-center gap-1">
                <button type="button" class="rounded p-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                    <LucideCopyCn Size="16" Class="size-3.5" />
                </button>
                <button type="button" class="rounded p-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                    <LucideThumbsUpCn Size="16" Class="size-3.5" />
                </button>
            </div>
        </div>
    </div>
</section>

@code {
    private record ThinkingStep(string Id, string Label, int Duration, string Content);

    private static readonly ThinkingStep[] _thinkingSteps =
    {
        new("step-1", "Understanding the problem", 3,
            "The user is asking about optimizing a React application that's experiencing slow renders. I need to identify the most impactful optimization strategies.\n\nKey areas to consider:\n- Component re-render frequency\n- State management patterns\n- Memoization opportunities\n- Bundle size impact\n- Data fetching strategies\n\nLet me think about what's most likely causing their issues based on common patterns I've seen..."),
        new("step-2", "Analyzing solutions", 7,
            "Evaluating optimization strategies by impact and effort:\n\n1. React.memo + useMemo + useCallback \u2014 High impact if they have prop drilling or expensive computations. But over-memoizing is a common pitfall that actually hurts performance.\n\n2. Code splitting with dynamic imports \u2014 Medium-high impact. Reduces initial bundle size. Worth it for route-level splitting at minimum.\n\n3. Virtualization for long lists \u2014 Critical if they're rendering 100+ items. React-window or TanStack Virtual are the go-to solutions.\n\n4. Moving state closer to where it's used \u2014 Often the simplest fix. If a parent re-renders, all children re-render. Colocating state prevents cascading re-renders.\n\n5. Server Components (if Next.js) \u2014 Zero JS shipped for non-interactive UI. This is the biggest win for Next.js apps.\n\nI should prioritize by what typically gives the biggest wins with the least effort..."),
        new("step-3", "Synthesizing the answer", 4,
            "Structuring the response around practical, high-impact recommendations:\n\n1. Start with the React DevTools Profiler \u2014 they need to measure before optimizing\n2. Server Components first (if applicable) \u2014 biggest single win\n3. State colocation \u2014 simple, often overlooked\n4. Memoization with caveats \u2014 useful but don't overdo it\n5. Virtualization for lists \u2014 specific but very impactful\n6. Code splitting \u2014 easy wins with dynamic imports\n\nI'll include code examples for each recommendation and mention the common mistake of over-optimizing. The \"measure first\" principle is important to emphasize.")
    };

    private const string FinalAnswer = "Here are the 6 most impactful React performance optimizations, ordered by typical ROI:\n\n1. Measure first with React DevTools Profiler\nDon't guess \u2014 profile your app to find the actual bottlenecks. The Profiler shows exactly which components re-render and how long each render takes.\n\n2. Use Server Components (Next.js)\nIf you're on Next.js, this is your biggest win. Server Components send zero JavaScript to the client. Default to server components and only add \"use client\" when you need interactivity.\n\n3. Colocate state\nMove state as close to where it's used as possible. If only a search bar needs query state, don't put it in a top-level context that re-renders the entire page.\n\n4. Memoize strategically\nUse React.memo, useMemo, and useCallback for expensive computations and components that receive complex props. But don't wrap everything \u2014 memoization has its own cost.\n\n5. Virtualize long lists\nIf you're rendering 100+ items, use react-window or @@tanstack/react-virtual. Only the visible items get rendered, reducing DOM nodes dramatically.\n\n6. Code-split with dynamic imports\nSplit heavy components and routes with next/dynamic or React.lazy. Users only download the JavaScript they actually need.\n\nStart with steps 1-3 \u2014 they're the easiest wins and usually solve 80% of performance issues.";

    private string? _expanded = "step-3";
    private static int TotalDuration => _thinkingSteps.Sum(s => s.Duration);
}
