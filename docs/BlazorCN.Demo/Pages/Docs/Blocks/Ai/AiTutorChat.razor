@* ===========================================================
   Block: ai-tutor-chat
   Title: Ai Tutor Chat
   Description: React AI educational tutor chat block for Next.js with step-by-step reasoning, progress tracking, and interactive suggestions using shadcn/ui and Tailwind CSS
   Long Description: React AI Translation Panel Block
   Dependencies: AvatarCn, BadgeCn, ButtonCn, TextareaCn, LucideSendCn
   Source: original/blocks/ai/ai-tutor-chat.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="text-sm font-medium">Math Tutor</span>
            <span class="text-xs text-muted-foreground">Calculus \u2014 Derivatives</span>
            <div class="ml-auto flex items-center gap-3">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    Level 2
                </BadgeCn>
                <span class="text-xs text-muted-foreground">
                    @_completedTopics/@_totalTopics
                </span>
                <div class="flex gap-0.5">
                    @for (var i = 0; i < _totalTopics; i++)
                    {
                        <div class="@Cn.Merge("size-1.5 rounded-full", i < _completedTopics ? "bg-foreground" : "bg-muted")"></div>
                    }
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto" tabindex="0" role="group" aria-label="Chat messages">
            <div class="flex flex-col gap-6 p-6">
                @foreach (var msg in _messages)
                {
                    <div class="flex flex-col gap-1">
                        @if (msg.Role == "user")
                        {
                            <div class="flex justify-end">
                                <div class="max-w-[85%] rounded-2xl rounded-br-sm bg-primary px-4 py-2.5 text-sm text-primary-foreground">
                                    <p>@msg.Content</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="flex gap-3">
                                <AvatarCn Class="mt-0.5 size-7 shrink-0 border">
                                    <AvatarFallbackCn Class="bg-muted text-[10px] text-muted-foreground">
                                        AI
                                    </AvatarFallbackCn>
                                </AvatarCn>
                                <div class="min-w-0 flex-1 space-y-3">
                                    @if (msg.Reasoning != null)
                                    {
                                        <div class="rounded-md border px-3 py-2">
                                            <button type="button"
                                                    class="flex w-full items-center gap-2 text-left text-xs text-muted-foreground"
                                                    @onclick="@(() => _reasoningOpen = !_reasoningOpen)">
                                                <span class="@Cn.Merge("transition-transform duration-200", _reasoningOpen ? "rotate-90" : "")">&#9654;</span>
                                                <span>Reasoning</span>
                                                @if (msg.ReasoningDuration.HasValue)
                                                {
                                                    <span class="font-mono tabular-nums">@(msg.ReasoningDuration)s</span>
                                                }
                                            </button>
                                            @if (_reasoningOpen)
                                            {
                                                <div class="mt-2 whitespace-pre-wrap text-xs leading-relaxed text-muted-foreground">@msg.Reasoning</div>
                                            }
                                        </div>
                                    }
                                    <div class="prose prose-sm max-w-none dark:prose-invert">
                                        @((MarkupString)FormatMarkdown(msg.Content))
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Suggestions *@
        <div class="px-6 pb-3">
            <div class="flex flex-wrap gap-1.5">
                @foreach (var s in _suggestions)
                {
                    var suggestion = s;
                    <button type="button"
                            class="rounded-full border px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground"
                            @onclick="@(() => _input = suggestion)">
                        @s
                    </button>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="flex items-end gap-3">
                <TextareaCn @bind-Value="_input"
                            Placeholder="Ask your tutor or try answering..."
                            Rows="1"
                            Class="min-h-0 max-h-32 resize-none border-0 bg-transparent px-0 text-sm shadow-none focus-visible:ring-0" aria-label="Ask your tutor or try answering..." />
                <ButtonCn aria-label="Send message" Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="h-7 shrink-0 text-xs"
                          OnClick="HandleSubmit">
                    <LucideSendCn Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Role, string Content, string? Reasoning = null, int? ReasoningDuration = null);

    private string _input = "";
    private bool _reasoningOpen;
    private const int _completedTopics = 3;
    private const int _totalTopics = 7;

    private static readonly string[] _suggestions =
    [
        "Give me a practice problem",
        "Show me another example",
        "When do I use chain vs product rule?",
        "Explain it differently",
    ];

    private static readonly ChatMessage[] _messages =
    [
        new("1", "user", "Can you help me understand derivatives in calculus? I'm struggling with the chain rule."),
        new("2", "assistant",
            "Great question! The chain rule is one of the most important differentiation techniques. Let me break it down step by step.\n\n## The Chain Rule\n\nThe chain rule is used when you need to differentiate a **composite function** \u2014 a function inside another function.\n\n**Formula:** If y = f(g(x)), then dy/dx = f'(g(x)) * g'(x)\n\nThink of it as **\"derivative of the outside times derivative of the inside.\"**\n\n## Example 1: Simple Case\n\nFind the derivative of y = (3x + 2)^5\n\n**Step 1:** Identify the outer function: u^5 (where u = 3x + 2)\n**Step 2:** Derivative of the outer: 5u^4 = 5(3x + 2)^4\n**Step 3:** Derivative of the inner: d/dx(3x + 2) = 3\n**Step 4:** Multiply them: dy/dx = 5(3x + 2)^4 * 3 = **15(3x + 2)^4**\n\n## Example 2: Trigonometric\n\nFind the derivative of y = sin(x^2)\n\n**Step 1:** Outer function: sin(u), derivative: cos(u) = cos(x^2)\n**Step 2:** Inner function: x^2, derivative: 2x\n**Step 3:** Chain rule: dy/dx = cos(x^2) * 2x = **2x cos(x^2)**\n\nWant to try one yourself? I'll guide you through it!",
            "Student is struggling with the chain rule. I should:\n1. Start with the intuitive explanation (\"outside times inside\")\n2. Give the formal formula but don't lead with it\n3. Work through two examples of increasing complexity\n4. Simple polynomial composition first, then trig\n5. Show each step explicitly \u2014 don't skip anything\n6. End by inviting them to try a practice problem\n\nKeep the tone encouraging. Use bold for key terms and answers. The student seems comfortable with basic derivatives since they specifically asked about chain rule, so I don't need to review power rule basics.",
            6),
    ];

    private static string FormatMarkdown(string text)
    {
        var html = System.Net.WebUtility.HtmlEncode(text);
        // Headers
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^## (.+)$", "<h3 class=\"text-sm font-semibold mt-4 mb-2\">$1</h3>", System.Text.RegularExpressions.RegexOptions.Multiline);
        // Bold
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");
        // Line breaks
        html = html.Replace("\n\n", "</p><p class=\"mt-2\">");
        html = html.Replace("\n", "<br />");
        return $"<p>{html}</p>";
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
