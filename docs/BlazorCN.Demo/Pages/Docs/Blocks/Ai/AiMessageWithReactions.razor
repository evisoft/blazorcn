@* ===========================================================
   Block: ai-message-with-reactions
   Title: Ai Message With Reactions
   Description: AI message with emoji reactions, popover picker, reaction counts, and action toolbar
   Dependencies: ButtonCn, LucideCopyCn, LucidePlusCn, LucideSmileCn, PopoverCn
   Source: original/blocks/ai/ai-message-with-reactions.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm font-medium">Engineering culture principles</span>
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span>@TotalReactions reactions</span>
            </div>
        </div>

        @* Response content *@
        <div class="space-y-3 px-4 py-3 text-sm leading-relaxed">
            <p>Great engineering culture comes down to a few core principles:</p>
            <p>
                <span class="font-medium">Psychological safety first</span> &mdash; People need to
                feel safe to ask questions, admit mistakes, and challenge ideas. Google's Project
                Aristotle found this is the single biggest predictor of team effectiveness.
            </p>
            <p>
                <span class="font-medium">Ownership over tasks</span> &mdash; Give engineers real
                ownership of projects, not just tickets. When someone owns a feature end-to-end, they
                build better software and grow faster.
            </p>
            <p>
                <span class="font-medium">Ship fast, learn faster</span> &mdash; Optimize for
                learning speed. Short cycle times, feature flags, incremental rollouts. The team that
                ships 50 small changes a week learns more than the team that ships 1 big release a
                month.
            </p>
            <p>
                <span class="font-medium">Hire for curiosity</span> &mdash; Skills can be taught,
                curiosity can't. Look for people who ask "why" and "what if."
            </p>
        </div>

        @* Reactions bar *@
        <div class="flex flex-wrap items-center gap-1.5 border-t px-4 py-3">
            @foreach (var reaction in _reactions)
            {
                var r = reaction;
                <button type="button"
                        class="@Cn.Merge("flex items-center gap-1 rounded-md border px-2 py-1 text-xs transition-colors", r.Reacted ? "border-foreground/20 bg-muted/50" : "border-transparent hover:bg-muted/50")"
                        @onclick="@(() => ToggleReaction(r.Emoji))">
                    <span class="text-sm">@r.Emoji</span>
                    <span class="font-mono text-[11px] text-muted-foreground">@r.Count</span>
                </button>
            }

            <PopoverCn @bind-Open="_popoverOpen">
                <PopoverTriggerCn Class="cn-button group/button inline-flex shrink-0 items-center justify-center whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0 cn-button-variant-ghost cn-button-size-sm size-7 rounded-md p-0" data-variant="ghost" data-size="sm" aria-label="Add">
                        <LucidePlusCn Size="16" Class="size-3.5" />
                    </PopoverTriggerCn>
                <PopoverContentCn Class="w-64 p-2" Align="FloatingAlign.Start">
                    <div class="mb-2 flex items-center gap-2 px-1">
                        <LucideSmileCn Size="16" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs font-medium">Add a reaction</span>
                    </div>
                    <div class="grid grid-cols-6 gap-0.5">
                        @foreach (var emoji in _emojiOptions)
                        {
                            var e = emoji;
                            var isUsed = _reactions.Any(r => r.Emoji == e && r.Reacted);
                            <button type="button"
                                    class="@Cn.Merge("flex size-9 items-center justify-center rounded-md text-lg transition-colors", isUsed ? "bg-muted/50" : "hover:bg-muted/50")"
                                    @onclick="@(() => AddReaction(e))">
                                @e
                            </button>
                        }
                    </div>
                </PopoverContentCn>
            </PopoverCn>

            <div class="ml-auto">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideCopyCn Size="16" Class="size-3" />
                    Copy
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private class ReactionItem
    {
        public string Emoji { get; set; } = "";
        public int Count { get; set; }
        public bool Reacted { get; set; }
    }

    private static readonly string[] _emojiOptions =
    {
        "\ud83d\udc4d", "\ud83d\udc4e", "\u2764\ufe0f", "\ud83c\udfaf", "\ud83d\udca1", "\ud83d\udd25",
        "\ud83d\udc4f", "\ud83d\ude80", "\ud83d\udc8e", "\u2728", "\ud83e\udd14", "\ud83d\ude02",
        "\ud83d\ude0d", "\ud83d\ude4c", "\ud83d\udcaa", "\ud83c\udf89", "\u2b50", "\ud83d\udcaf"
    };

    private readonly List<ReactionItem> _reactions = new()
    {
        new() { Emoji = "\ud83d\udc4d", Count = 12, Reacted = false },
        new() { Emoji = "\ud83c\udfaf", Count = 5, Reacted = true },
        new() { Emoji = "\ud83d\udca1", Count = 3, Reacted = false },
        new() { Emoji = "\u2764\ufe0f", Count = 8, Reacted = false }
    };

    private bool _popoverOpen;

    private int TotalReactions => _reactions.Sum(r => r.Count);

    private void ToggleReaction(string emoji)
    {
        var existing = _reactions.FirstOrDefault(r => r.Emoji == emoji);
        if (existing != null)
        {
            if (existing.Reacted)
            {
                existing.Count--;
                existing.Reacted = false;
                if (existing.Count <= 0)
                    _reactions.Remove(existing);
            }
            else
            {
                existing.Count++;
                existing.Reacted = true;
            }
        }
        else
        {
            _reactions.Add(new ReactionItem { Emoji = emoji, Count = 1, Reacted = true });
        }
    }

    private void AddReaction(string emoji)
    {
        _popoverOpen = false;
        var existing = _reactions.FirstOrDefault(r => r.Emoji == emoji);
        if (existing != null)
        {
            if (!existing.Reacted)
                ToggleReaction(emoji);
            return;
        }
        _reactions.Add(new ReactionItem { Emoji = emoji, Count = 1, Reacted = true });
    }
}
