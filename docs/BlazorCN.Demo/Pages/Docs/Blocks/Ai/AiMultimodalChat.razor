@* ===========================================================
   Block: ai-multimodal-chat
   Title: Ai Multimodal Chat
   Description: React AI multimodal chat block for Next.js with image attachments, vision analysis, and rich message content using shadcn/ui and Tailwind CSS
   Long Description: React AI Model Selector Panel Block
   Dependencies: ButtonCn, InputCn
   Source: original/blocks/ai/ai-multimodal-chat.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="font-medium text-sm">Vision analysis</span>
            <span class="text-muted-foreground text-xs">@_messages.Length messages</span>
        </div>

        @* Messages *@
        <div>
            @for (int i = 0; i < _messages.Length; i++)
            {
                var msg = _messages[i];
                var isExpanded = _expanded == msg.Id;
                var isLast = i == _messages.Length - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = isExpanded ? null : msg.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"size-1.5 shrink-0 rounded-full {(msg.Role == "user" ? "bg-blue-500" : "bg-muted-foreground/40")}")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">
                                @(msg.Role == "user" ? "You" : "Assistant")
                            </span>
                            @if (!isExpanded)
                            {
                                <p class="mt-0.5 truncate text-muted-foreground text-xs">@msg.Content</p>
                            }
                        </div>
                        @if (msg.Images is { Length: > 0 })
                        {
                            <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                <LucideImageCn Size="12" Class="size-3" />
                                @msg.Images.Length
                            </span>
                        }
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            @if (msg.Images is { Length: > 0 })
                            {
                                <div class="mb-3 flex gap-2">
                                    @foreach (var img in msg.Images)
                                    {
                                        <div class="flex size-16 items-center justify-center rounded-md bg-muted/50">
                                            <LucideImageCn Size="20" Class="size-5 text-muted-foreground/40" />
                                        </div>
                                    }
                                </div>
                            }
                            <p class="text-sm leading-relaxed">@msg.Content</p>
                        </div>
                    }
                </div>
            }
        </div>

        @* Input *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 shrink-0 p-0">
                <LucidePaperclipCn Size="14" Class="size-3.5 text-muted-foreground" />
            </ButtonCn>
            <div class="flex min-w-0 flex-1 items-center gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Describe or attach an image..."
                         Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
                <ButtonCn Variant="ButtonVariant.Ghost"
                          Size="ButtonSize.Sm"
                          Class="size-7 shrink-0 p-0"
                          Disabled="@(string.IsNullOrWhiteSpace(_input))">
                    <LucideSendCn Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ImageAttachment(string Id, string Alt);
    private record ChatMessage(string Id, string Role, string Content, ImageAttachment[]? Images = null);

    private static readonly ChatMessage[] _messages =
    {
        new("1", "user", "Can you analyze this UI design and suggest improvements?",
            new ImageAttachment[] { new("img-1", "Dashboard design mockup") }),
        new("2", "assistant", "I can see a dashboard design with a sidebar navigation and a main content area. The layout has clear visual hierarchy and consistent icon styling. Key improvements: increase contrast ratio for sidebar text to meet WCAG AA, add 16-24px gap between metric cards, use a more distinct typography scale, and add skeleton loaders for chart empty states."),
        new("3", "user", "Here's another screen — the settings page. Same feedback style please.",
            new ImageAttachment[] { new("img-2", "Settings page design"), new("img-3", "Settings form detail") }),
        new("4", "assistant", "The settings page has clean tab navigation and properly grouped form sections. Improvements: add inline validation states with success checkmarks, implement auto-save or a sticky save bar, and give the Delete Account section more visual separation with a confirmation dialog to prevent accidental clicks.")
    };

    private string? _expanded = "2";
    private string _input = "";
}
