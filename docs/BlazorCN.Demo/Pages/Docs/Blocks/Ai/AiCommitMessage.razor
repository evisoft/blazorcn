@* ===========================================================
   Block: ai-commit-message
   Title: Ai Commit Message
   Description: React AI git commit message generator block for Next.js with staged files list, conventional commit format, and customization controls using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn, SelectCn, TextareaCn
   Source: original/blocks/ai/ai-commit-message.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Commit Message</span>
                <p class="mt-0.5 font-mono text-muted-foreground text-xs">feature/rate-limiting</p>
            </div>
            <span class="text-muted-foreground text-xs">@_stagedFiles.Length files</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="font-mono text-emerald-600 text-xs dark:text-emerald-400">
                +@_totalAdditions
            </span>
            <span class="font-mono text-red-600 text-xs dark:text-red-400">
                -@_totalDeletions
            </span>
        </div>

        @* Staged Files *@
        <div class="border-b">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Staged changes</span>
            </div>
            <div>
                @for (var i = 0; i < _stagedFiles.Length; i++)
                {
                    var idx = i;
                    var file = _stagedFiles[idx];
                    var isExpanded = _expanded == file.Path;
                    var isLast = idx == _stagedFiles.Length - 1;

                    <div class="@(isLast ? "" : "border-b")">
                        <button
                            type="button"
                            @onclick="@(() => _expanded = isExpanded ? null : file.Path)"
                            class="flex w-full items-center gap-3 px-4 py-2 text-left transition-colors hover:bg-muted/50">
                            <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", _statusDot[file.Status])"></span>
                            <span class="font-mono text-muted-foreground text-xs">
                                @_statusLabels[file.Status]
                            </span>
                            <span class="min-w-0 flex-1 truncate font-mono text-xs">@file.Path</span>
                            <span class="font-mono text-emerald-600 text-xs dark:text-emerald-400">
                                +@file.Additions
                            </span>
                            @if (file.Deletions > 0)
                            {
                                <span class="font-mono text-red-600 text-xs dark:text-red-400">
                                    -@file.Deletions
                                </span>
                            }
                            <LucideChevronRightCn Size="14" Class="@Cn.Merge("size-3.5 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>
                    </div>
                }
            </div>
        </div>

        @* Type & Scope *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">Type</span>
                <SelectCn @bind-Value="_commitType">
                    <SelectTriggerCn Class="h-7 w-[100px] border-0 bg-muted/50 font-mono text-xs shadow-none focus:ring-0">
                        <SelectValueCn Placeholder="Type" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="feat">feat</SelectItemCn>
                        <SelectItemCn Value="fix">fix</SelectItemCn>
                        <SelectItemCn Value="refactor">refactor</SelectItemCn>
                        <SelectItemCn Value="docs">docs</SelectItemCn>
                        <SelectItemCn Value="test">test</SelectItemCn>
                        <SelectItemCn Value="chore">chore</SelectItemCn>
                        <SelectItemCn Value="perf">perf</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">Scope</span>
                <SelectCn @bind-Value="_scope">
                    <SelectTriggerCn Class="h-7 w-[100px] border-0 bg-muted/50 font-mono text-xs shadow-none focus:ring-0">
                        <SelectValueCn Placeholder="Scope" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="auth">auth</SelectItemCn>
                        <SelectItemCn Value="api">api</SelectItemCn>
                        <SelectItemCn Value="ui">ui</SelectItemCn>
                        <SelectItemCn Value="db">db</SelectItemCn>
                        <SelectItemCn Value="config">config</SelectItemCn>
                        <SelectItemCn Value="core">core</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
            <ButtonCn
                Variant="ButtonVariant.Ghost"
                Size="ButtonSize.Sm"
                class="ml-auto h-7 gap-1 text-xs text-muted-foreground">
                <LucideRefreshCwCn Size="12" Class="size-3" />
                Regenerate
            </ButtonCn>
        </div>

        @* Generated Message *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 rounded-md bg-muted/50 px-3 py-1.5">
                <code class="font-mono text-xs">
                    <span class="text-foreground">@_commitType</span><span class="text-muted-foreground">(</span><span class="text-foreground">@_scope</span><span class="text-muted-foreground">):</span><span class="text-foreground"> @(_message.Split('\n')[0].ToLower())</span>
                </code>
            </div>

            @if (_isEditing)
            {
                <TextareaCn @bind-Value="_message"
                    Class="min-h-[180px] resize-none font-mono" />
            }
            else
            {
                <div class="space-y-1 font-mono text-muted-foreground text-sm leading-relaxed">
                    @foreach (var line in _messageLines)
                    {
                        @if (line.StartsWith("- "))
                        {
                            <div class="flex gap-2">
                                <span class="text-muted-foreground/50">-</span>
                                <span>@line.Substring(2)</span>
                            </div>
                        }
                        else if (line.EndsWith(":"))
                        {
                            <p class="mt-2 font-medium text-foreground">@line</p>
                        }
                        else
                        {
                            <p>@line</p>
                        }
                    }
                </div>
            }
        </div>

        @* Actions *@
        <div class="flex items-center gap-2 px-4 py-3">
            <ButtonCn
                Variant="ButtonVariant.Ghost"
                Size="ButtonSize.Sm"
                class="h-7 text-xs text-muted-foreground"
                @onclick="@(() => _isEditing = !_isEditing)">
                @(_isEditing ? "Preview" : "Edit")
            </ButtonCn>
            <ButtonCn
                Variant="ButtonVariant.Ghost"
                Size="ButtonSize.Sm"
                class="h-7 gap-1 text-xs text-muted-foreground">
                @if (_copied)
                {
                    <LucideCheckCn Size="12" Class="size-3" />
                    <span>Copied</span>
                }
                else
                {
                    <LucideCopyCn Size="12" Class="size-3" />
                    <span>Copy</span>
                }
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="ml-auto h-7 text-xs">
                Commit
            </ButtonCn>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-xs">
                @_stagedFiles.Length files
            </BadgeCn>
        </div>
    </div>
</section>

@code {
    private record StagedFile(string Path, int Additions, int Deletions, string Status);

    private static readonly Dictionary<string, string> _statusLabels = new()
    {
        ["modified"] = "M",
        ["added"] = "A",
        ["deleted"] = "D",
        ["renamed"] = "R",
    };

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["modified"] = "bg-amber-500",
        ["added"] = "bg-emerald-500",
        ["deleted"] = "bg-red-500",
        ["renamed"] = "bg-blue-500",
    };

    private static readonly StagedFile[] _stagedFiles =
    [
        new("src/lib/auth/session.ts", 24, 8, "modified"),
        new("src/lib/auth/rate-limiter.ts", 47, 3, "modified"),
        new("src/lib/auth/rate-limiter.test.ts", 62, 0, "added"),
        new("src/middleware.ts", 12, 5, "modified"),
        new("prisma/migrations/20260315_rate_limit/migration.sql", 18, 0, "added"),
        new("prisma/schema.prisma", 8, 1, "modified"),
        new(".env.example", 2, 0, "modified"),
    ];

    private static readonly string _defaultMessage = @"Add Redis-backed rate limiting for authentication endpoints

Implement a sliding window rate limiter using Redis to prevent brute force
attacks on login and signup routes. After 5 failed attempts within 15 minutes,
subsequent requests receive a 429 status code.

Changes:
- Add RateLimiter class with Redis adapter in rate-limiter.ts
- Update session handler to check rate limits before authentication
- Add rate_limit_entries table via Prisma migration
- Add comprehensive test coverage for rate limiting logic
- Update middleware to inject rate limiter instance";

    private int _totalAdditions => _stagedFiles.Sum(f => f.Additions);
    private int _totalDeletions => _stagedFiles.Sum(f => f.Deletions);

    private string[] _messageLines => _message.Split('\n').Skip(1).Where(l => l.Trim().Length > 0).ToArray();

    private string _commitType = "feat";
    private string _scope = "auth";
    private string _message = _defaultMessage;
    private bool _isEditing = false;
    private bool _copied = false;
    private string? _expanded = null;
}
