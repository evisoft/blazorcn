@* ===========================================================
   Block: ai-presentation-builder
   Title: Ai Presentation Builder
   Description: AI presentation builder with slide navigator, live preview, AI editing controls, and speaker notes
   Dependencies: BadgeCn, ButtonCn, LucideChevronRightCn, LucideImageCn, LucideLayoutCn, LucideMessageSquareCn, LucidePlusCn, LucideTrash2Cn, LucideWandCn
   Source: original/blocks/ai/ai-presentation-builder.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm font-medium">Presentation Builder</span>
            <div class="flex items-center gap-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    @_slides.Count slides
                </BadgeCn>
                <span class="text-xs text-muted-foreground">&middot;</span>
                <span class="text-xs text-muted-foreground capitalize">@Current.Type slide</span>
            </div>
        </div>

        @* Slide navigator *@
        <div class="flex gap-1.5 overflow-x-auto border-b px-4 py-2.5">
            @for (var i = 0; i < _slides.Count; i++)
            {
                var slide = _slides[i];
                var idx = i;
                <button type="button"
                        class="@Cn.Merge("flex shrink-0 items-center gap-1.5 rounded-md px-2.5 py-1.5 text-left transition-colors", idx == _activeSlide ? "bg-muted text-foreground" : "text-muted-foreground hover:bg-muted/50")"
                        @onclick="@(() => _activeSlide = idx)">
                    <span class="font-mono text-[10px] tabular-nums">
                        @((idx + 1).ToString("D2"))
                    </span>
                    <span class="max-w-24 truncate text-xs">@slide.Title</span>
                </button>
            }
        </div>

        @* Slide preview *@
        <div class="border-b px-4 py-4">
            <div class="@Cn.Merge("rounded-md p-6", Current.Type is "title" or "closing" ? "bg-zinc-950 text-center text-white dark:bg-zinc-900" : "bg-muted/30")">
                @if (Current.Type is "title" or "closing")
                {
                    <h3 class="mb-1 text-base font-semibold">@Current.Title</h3>
                    @if (Current.Subtitle != null)
                    {
                        <p class="text-sm text-white/60">@Current.Subtitle</p>
                    }
                    @if (Current.Bullets.Length > 0)
                    {
                        <ul class="mt-4 space-y-1.5 text-left">
                            @foreach (var b in Current.Bullets)
                            {
                                <li class="flex items-start gap-2 text-sm text-white/70">
                                    <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-white/40"></span>
                                    @b
                                </li>
                            }
                        </ul>
                    }
                }
                else
                {
                    <h3 class="mb-4 border-b border-foreground/10 pb-2 text-sm font-medium">
                        @Current.Title
                    </h3>
                    <ul class="space-y-2">
                        @foreach (var b in Current.Bullets)
                        {
                            <li class="flex items-start gap-2 text-sm">
                                <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-foreground/20"></span>
                                <span class="leading-relaxed">@b</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        @* AI controls *@
        <div class="flex flex-wrap gap-1.5 border-b px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs"
                      @onclick="AddSlide">
                <LucidePlusCn Size="16" Class="size-3" />
                Add Slide
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideWandCn Size="16" Class="size-3" />
                Improve Copy
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideImageCn Size="16" Class="size-3" />
                Add Visual
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideMessageSquareCn Size="16" Class="size-3" />
                Generate Notes
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideLayoutCn Size="16" Class="size-3" />
                Change Layout
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                      Class="ml-auto h-7 gap-1.5 text-xs text-red-600 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300"
                      Disabled="@(_slides.Count <= 1)"
                      @onclick="DeleteSlide">
                <LucideTrash2Cn Size="16" Class="size-3" />
                Delete
            </ButtonCn>
        </div>

        @* Speaker notes *@
        <div>
            <button type="button"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    @onclick="@(() => _expandedNotes = !_expandedNotes)">
                <span class="size-2 shrink-0 rounded-full bg-blue-500"></span>
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">Speaker Notes</span>
                    <p class="mt-0.5 truncate text-xs text-muted-foreground">
                        @(string.IsNullOrEmpty(Current.Notes) ? "No notes for this slide" : Current.Notes)
                    </p>
                </div>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _expandedNotes ? "rotate-90" : "")" />
            </button>

            @if (_expandedNotes)
            {
                <div class="px-4 pb-4 pl-9">
                    <textarea @bind="Current.Notes"
                              placeholder="Add speaker notes for this slide..."
                              rows="3"
                              class="w-full resize-none rounded-md border-0 bg-muted/50 p-3 text-sm shadow-none focus-visible:outline-none focus-visible:ring-0"></textarea>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private class SlideData
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public string? Subtitle { get; set; }
        public string[] Bullets { get; set; } = Array.Empty<string>();
        public string Notes { get; set; } = "";
        public string Type { get; set; } = "content";
    }

    private readonly List<SlideData> _slides = new()
    {
        new() { Id = "s1", Title = "AI-First Product Strategy", Subtitle = "Q3 2026 Planning Kickoff", Bullets = Array.Empty<string>(), Notes = "Welcome everyone to the Q3 planning session. Today we'll cover our AI product roadmap, key metrics from Q2, and alignment on priorities for the next quarter.", Type = "title" },
        new() { Id = "s2", Title = "Q2 Performance Highlights", Bullets = new[] { "Revenue grew 47% YoY to $12.3M ARR", "Net revenue retention at 128%", "AI feature adoption reached 73% of active users", "Customer satisfaction score improved to 4.7/5.0", "Reduced churn from 4.2% to 2.8% monthly" }, Notes = "Emphasize the AI adoption metric \u2014 this validates our strategy from Q1. The churn reduction is directly correlated with users who engage with AI features.", Type = "content" },
        new() { Id = "s3", Title = "Product Roadmap: Q3 Priorities", Bullets = new[] { "Launch AI copilot for automated workflow creation", "Expand real-time collaboration to mobile apps", "Introduce predictive analytics dashboard", "Build enterprise SSO and SCIM provisioning", "Redesign onboarding flow with interactive tutorials" }, Notes = "The copilot feature is our biggest bet this quarter. Engineering estimates 8 weeks for MVP. We should discuss resource allocation between this and mobile expansion.", Type = "content" },
        new() { Id = "s4", Title = "Competitive Landscape Shift", Bullets = new[] { "StreamFlow acquired DataSync for $240M \u2014 expect feature parity in 6 months", "NexaHub raised Series C at $800M valuation \u2014 accelerating AI roadmap", "Our advantage: deepest AI integration with enterprise reliability", "Key differentiator: custom model fine-tuning per workspace" }, Notes = "Don't position this as alarming \u2014 frame it as validation that the market is moving toward AI. We have a 12-month head start on enterprise AI features.", Type = "content" },
        new() { Id = "s5", Title = "Resource Allocation", Bullets = new[] { "AI Copilot Team: 6 engineers, 2 ML researchers", "Mobile Expansion: 4 engineers, 1 designer", "Enterprise Features: 3 engineers, 1 security engineer", "Platform Reliability: 2 SREs, infrastructure upgrades", "Total headcount increase: 5 new hires budgeted" }, Notes = "We have budget for 5 new hires. Prioritize ML engineers for the copilot team \u2014 the market for this talent is competitive, so let's start recruiting immediately.", Type = "content" },
        new() { Id = "s6", Title = "Next Steps & Timeline", Subtitle = "Let's build the future together", Bullets = new[] { "Week 1-2: Finalize technical specifications", "Week 3: Kick off copilot MVP development", "Week 6: Beta launch to 50 pilot customers", "Week 10: Public launch with marketing campaign", "Week 12: Q3 retrospective and Q4 planning" }, Notes = "Close by asking each team lead to confirm their commitment to the timeline. Schedule follow-up 1:1s for the first week.", Type = "closing" }
    };

    private int _activeSlide;
    private bool _expandedNotes;
    private int _slideCounter = 7;

    private SlideData Current => _slides[_activeSlide];

    private void AddSlide()
    {
        var newSlide = new SlideData
        {
            Id = $"s{_slideCounter++}",
            Title = "New Slide",
            Bullets = new[] { "Add your content here" },
            Notes = "",
            Type = "content"
        };
        _slides.Insert(_activeSlide + 1, newSlide);
        _activeSlide++;
    }

    private void DeleteSlide()
    {
        if (_slides.Count <= 1) return;
        _slides.RemoveAt(_activeSlide);
        _activeSlide = Math.Min(_activeSlide, _slides.Count - 1);
    }
}
