@* ===========================================================
   Block: ai-chat-with-history
   Title: Ai Chat With History
   Description: React AI chat with history block for Next.js with sidebar conversation list, active highlighting, and relative timestamps using shadcn/ui and Tailwind CSS
   Long Description: Build a ChatGPT-style interface with a conversation history sidebar in React and Next.js. This TypeScript block shows past conversations with title previews and relative timestamps, with the active chat highlighted. Perfect for AI products that need session management alongside real-time chat.
   Dependencies: ButtonCn, TextareaCn
   Source: original/blocks/ai/ai-chat-with-history.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex h-[700px] overflow-hidden rounded-lg border bg-card">
        @* History sidebar *@
        <div class="hidden w-64 shrink-0 flex-col border-r lg:flex">
            <div class="flex items-center justify-between border-b px-4 py-3">
                <span class="font-medium text-sm">History</span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7" aria-label="Add">
                    <LucidePlusCn Size="16" Class="size-4" />
                </ButtonCn>
            </div>

            <div class="flex-1 overflow-y-auto" tabindex="0" role="group" aria-label="Conversation history">
                @for (int i = 0; i < _conversations.Length; i++)
                {
                    var conv = _conversations[i];
                    var isLast = i == _conversations.Length - 1;
                    <button type="button"
                            @onclick="@(() => _activeId = conv.Id)"
                            class="@Cn.Merge("flex w-full flex-col gap-0.5 px-4 py-3 text-left transition-colors hover:bg-muted/50", _activeId == conv.Id ? "bg-muted/50" : "", !isLast ? "border-b" : "")">
                        <span class="truncate font-medium text-sm">@conv.Title</span>
                        <span class="truncate text-muted-foreground text-xs">@conv.Preview</span>
                        <span class="text-muted-foreground/60 text-xs">@conv.Timestamp</span>
                    </button>
                }
            </div>
        </div>

        @* Chat area *@
        <div class="flex flex-1 flex-col">
            <div class="flex items-center gap-2 border-b px-4 py-3">
                <span class="font-medium text-sm">AI Assistant</span>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <span class="text-muted-foreground text-xs">React Server Components</span>
            </div>

            <div class="flex-1 overflow-y-auto" tabindex="0" role="group" aria-label="Chat messages">
                <div class="flex flex-col">
                    @for (int i = 0; i < _chatMessages.Length; i++)
                    {
                        var msg = _chatMessages[i];
                        var isLast = i == _chatMessages.Length - 1;
                        <div class="@(isLast ? "" : "border-b")">
                            <div class="px-4 py-3">
                                <span class="mb-1 block font-medium text-muted-foreground text-xs">
                                    @(msg.Role == "user" ? "You" : "AI")
                                </span>
                                <p class="whitespace-pre-wrap text-sm leading-relaxed">@msg.Content</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Suggestions *@
            <div class="flex flex-wrap gap-1.5 px-4 pb-2">
                @foreach (var s in _suggestions)
                {
                    <button type="button"
                            @onclick="@(() => _input = s)"
                            class="rounded-md bg-muted/50 px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                        @s
                    </button>
                }
            </div>

            <div class="border-t px-4 py-3">
                <div class="relative">
                    <TextareaCn @bind-Value="_input"
                                Placeholder="Ask a follow-up..."
                                Rows="1"
                                Class="min-h-0 max-h-32 resize-none border-0 bg-transparent pr-10 text-sm shadow-none focus-visible:ring-0" aria-label="Ask a follow-up..." />
                    <ButtonCn Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost"
                              Disabled="@(string.IsNullOrWhiteSpace(_input))"
                              Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground" aria-label="Send message">
                        <LucideArrowUpCn Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Conversation(string Id, string Title, string Preview, string Timestamp);
    private record ChatMessage(string Id, string Role, string Content);

    private static readonly Conversation[] _conversations =
    {
        new("1", "React Server Components", "Explain the benefits of RSC...", "2 hours ago"),
        new("2", "Database indexing strategies", "When should I use composite indexes...", "5 hours ago"),
        new("3", "Auth implementation", "How do I set up OAuth with...", "Yesterday"),
        new("4", "TypeScript generics", "Can you explain conditional types...", "2 days ago"),
        new("5", "API rate limiting", "What are the best approaches for...", "3 days ago"),
        new("6", "CSS Grid layouts", "Help me build a responsive dashboard...", "1 week ago")
    };

    private static readonly ChatMessage[] _chatMessages =
    {
        new("m1", "user", "Can you explain the benefits of React Server Components and when I should use them?"),
        new("m2", "assistant",
            "React Server Components (RSC) offer several key benefits:\n\nZero client-side JavaScript — Server Components render entirely on the server, so their code never ships to the browser. This dramatically reduces bundle size for data-heavy pages.\n\nDirect backend access — You can query databases, read files, and call internal APIs directly in your component without building API routes. This simplifies your data fetching architecture.\n\nAutomatic code splitting — Each Client Component imported by a Server Component becomes a natural split point. No need for manual dynamic imports in most cases.\n\nStreaming — Server Components support streaming, so the browser can start rendering parts of the page before the entire response is ready.\n\nUse them when your component primarily displays data without interactivity. Keep Client Components for forms, event handlers, and browser API usage.")
    };

    private static readonly string[] _suggestions =
    {
        "How do I mix Server and Client Components?",
        "What about data mutations with Server Actions?",
        "Show me a streaming example"
    };

    private string _activeId = "1";
    private string _input = "";
}
