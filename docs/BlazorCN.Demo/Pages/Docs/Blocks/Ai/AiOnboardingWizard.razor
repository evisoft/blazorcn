@* ===========================================================
   Block: ai-onboarding-wizard
   Title: Ai Onboarding Wizard
   Description: AI onboarding wizard with step indicator, project presets, toggleable AI capabilities, and review summary
   Dependencies: BadgeCn, ButtonCn, LucideCheckCn, LucideChevronLeftCn, LucideChevronRightCn, SwitchCn
   Source: original/blocks/ai/ai-onboarding-wizard.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with step indicator *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="text-sm font-medium">Set up your AI</span>
                <div class="flex items-center gap-1">
                    @for (var si = 0; si < _stepLabels.Length; si++)
                    {
                        var stepIdx = si;
                        var label = _stepLabels[si];
                        @if (si > 0)
                        {
                            <span class="mx-1 text-muted-foreground/30">&middot;</span>
                        }
                        <span class="@Cn.Merge("text-xs", stepIdx == _currentStep ? "font-medium text-foreground" : stepIdx < _currentStep ? "text-muted-foreground" : "text-muted-foreground/50")">
                            @if (stepIdx < _currentStep)
                            {
                                <span class="flex items-center gap-0.5">
                                    <LucideCheckCn Size="16" Class="size-3" />
                                    @label
                                </span>
                            }
                            else
                            {
                                @label
                            }
                        </span>
                    }
                </div>
            </div>
            <span class="font-mono text-xs text-muted-foreground">
                @(_currentStep + 1)/@_stepLabels.Length
            </span>
        </div>

        @* Step 1: Project Type *@
        @if (_currentStep == 0)
        {
            <div>
                @for (var i = 0; i < _projectTypes.Length; i++)
                {
                    var project = _projectTypes[i];
                    var isSelected = _selectedProject == project.Id;
                    var isLast = i == _projectTypes.Length - 1;
                    var projId = project.Id;
                    <button type="button"
                            class="@Cn.Merge("flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50", !isLast ? "border-b" : "", isSelected ? "bg-muted/50" : "")"
                            @onclick="@(() => _selectedProject = projId)">
                        <div class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border transition-colors", isSelected ? "border-foreground bg-foreground" : "border-muted-foreground/30")">
                            @if (isSelected)
                            {
                                <LucideCheckCn Size="16" Class="size-2.5 text-background" />
                            }
                        </div>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@project.Label</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">@project.Description</p>
                        </div>
                    </button>
                }
            </div>
        }

        @* Step 2: AI Capabilities *@
        @if (_currentStep == 1)
        {
            <div>
                @for (var i = 0; i < _capabilities.Length; i++)
                {
                    var cap = _capabilities[i];
                    var isLast = i == _capabilities.Length - 1;
                    var capId = cap.Id;
                    <div class="@Cn.Merge("flex items-center gap-3 px-4 py-3", !isLast ? "border-b" : "")">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@cap.Label</span>
                                @if (cap.Recommended)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="px-1.5 py-0 text-[10px] font-normal">
                                        Recommended
                                    </BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@cap.Description</p>
                        </div>
                        <SwitchCn Checked="@_enabledCapabilities[capId]"
                                  CheckedChanged="@(v => _enabledCapabilities[capId] = v)" />
                    </div>
                }
            </div>
        }

        @* Step 3: Review *@
        @if (_currentStep == 2)
        {
            <div>
                @* Project type *@
                <div class="border-b px-4 py-3">
                    <span class="text-xs text-muted-foreground">Project type</span>
                    <p class="mt-0.5 text-sm font-medium">
                        @(SelectedProjectData?.Label ?? "Not selected")
                    </p>
                </div>

                @* Capabilities *@
                <div class="border-b px-4 py-3">
                    <span class="text-xs text-muted-foreground">
                        Enabled capabilities (@EnabledCount)
                    </span>
                    <div class="mt-1.5 flex flex-wrap gap-1">
                        @foreach (var cap in _capabilities.Where(c => _enabledCapabilities[c.Id]))
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                @cap.Label
                            </BadgeCn>
                        }
                        @if (EnabledCount == 0)
                        {
                            <span class="text-xs text-muted-foreground">No capabilities selected</span>
                        }
                    </div>
                </div>

                @* Status *@
                <div class="flex items-center gap-2 px-4 py-3">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    <span class="text-xs text-muted-foreground">
                        Ready to deploy with @EnabledCount capabilities. Settings can be changed later.
                    </span>
                </div>
            </div>
        }

        @* Navigation *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                      Disabled="@(_currentStep == 0)"
                      @onclick="@(() => _currentStep--)">
                <LucideChevronLeftCn Size="16" Class="size-3" />
                Back
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs"
                      Disabled="@(_currentStep == _stepLabels.Length - 1 || (_currentStep == 0 && _selectedProject == null))"
                      @onclick="@(() => _currentStep = Math.Min(_currentStep + 1, _stepLabels.Length - 1))">
                @(_currentStep == _stepLabels.Length - 1 ? "Deploy" : "Continue")
                @if (_currentStep < _stepLabels.Length - 1)
                {
                    <LucideChevronRightCn Size="16" Class="size-3" />
                }
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record ProjectType(string Id, string Label, string Description);
    private record Capability(string Id, string Label, string Description, bool Recommended = false);

    private static readonly string[] _stepLabels = { "Project type", "Capabilities", "Review" };

    private static readonly ProjectType[] _projectTypes =
    {
        new("saas", "SaaS Application", "Web app with user accounts and subscriptions"),
        new("ecommerce", "E-Commerce Store", "Online shop with product catalog and checkout"),
        new("docs", "Documentation Site", "Knowledge base or developer documentation"),
        new("portfolio", "Portfolio / Agency", "Showcase work, services, and case studies")
    };

    private static readonly Capability[] _capabilities =
    {
        new("chatbot", "AI Chatbot", "Conversational assistant for your users", true),
        new("search", "Semantic Search", "Natural language search across your content", true),
        new("content", "Content Generation", "Auto-generate descriptions, summaries, and copy"),
        new("moderation", "Content Moderation", "AI-powered review of user-generated content"),
        new("analytics", "Smart Analytics", "AI insights and anomaly detection on your data"),
        new("personalization", "Personalization", "Tailored recommendations and dynamic content")
    };

    private int _currentStep;
    private string? _selectedProject = "saas";
    private readonly Dictionary<string, bool> _enabledCapabilities = new()
    {
        ["chatbot"] = true,
        ["search"] = true,
        ["content"] = false,
        ["moderation"] = false,
        ["analytics"] = false,
        ["personalization"] = false
    };

    private int EnabledCount => _enabledCapabilities.Count(kv => kv.Value);
    private ProjectType? SelectedProjectData => _projectTypes.FirstOrDefault(p => p.Id == _selectedProject);
}
