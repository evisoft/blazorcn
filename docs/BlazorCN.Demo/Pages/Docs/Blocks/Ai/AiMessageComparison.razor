@* ===========================================================
   Block: ai-message-comparison
   Title: Ai Message Comparison
   Description: AI message with side-by-side comparison table, feature grids, rating badges, and check/x icons
   Dependencies: LucideCopyCn, LucideThumbsUpCn
   Source: original/blocks/ai/ai-message-comparison.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* User message *@
        <div class="border-b px-4 py-3">
            <div class="ml-auto max-w-[80%] rounded-lg bg-primary px-3 py-2 text-primary-foreground">
                <p class="text-sm">Compare PostgreSQL vs MongoDB for my new SaaS project. Which should I choose?</p>
            </div>
        </div>

        @* AI intro *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted">
                <span class="text-[10px] font-medium text-muted-foreground">AI</span>
            </div>
            <p class="text-sm">Here's a detailed comparison of <span class="font-medium">PostgreSQL</span> and <span class="font-medium">MongoDB</span> for a SaaS project:</p>
        </div>

        @* Summary row *@
        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium">PostgreSQL</span>
                    <span class="font-mono text-xs text-muted-foreground">4.7/5.0</span>
                </div>
                <p class="mt-1 text-xs leading-relaxed text-muted-foreground">Complex queries, relational data, strict consistency</p>
            </div>
            <div class="px-4 py-3">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium">MongoDB</span>
                    <span class="font-mono text-xs text-muted-foreground">4.5/5.0</span>
                </div>
                <p class="mt-1 text-xs leading-relaxed text-muted-foreground">Flexible schemas, rapid prototyping, horizontal scale</p>
            </div>
        </div>

        @* Comparison table *@
        <div>
            @* Header *@
            <div class="grid grid-cols-[1fr_1fr_1fr] border-b bg-muted/30 text-xs">
                <div class="px-4 py-2 font-medium text-muted-foreground">Feature</div>
                <div class="border-l px-4 py-2 font-medium text-muted-foreground">PostgreSQL</div>
                <div class="border-l px-4 py-2 font-medium text-muted-foreground">MongoDB</div>
            </div>

            @* Rows *@
            @for (var i = 0; i < _comparisonData.Length; i++)
            {
                var row = _comparisonData[i];
                var isLast = i == _comparisonData.Length - 1;
                <div class="@Cn.Merge("grid grid-cols-[1fr_1fr_1fr] text-xs", !isLast ? "border-b" : "")">
                    <div class="flex items-center px-4 py-2.5 font-medium text-muted-foreground">@row.Category</div>
                    <div class="flex items-center border-l px-4 py-2.5">
                        @RenderValue(row.Postgres)
                    </div>
                    <div class="flex items-center border-l px-4 py-2.5">
                        @RenderValue(row.Mongo)
                    </div>
                </div>
            }
        </div>

        @* Recommendation *@
        <div class="border-t px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <span class="mb-1.5 block text-xs font-medium text-muted-foreground">Recommendation</span>
                <p class="text-sm leading-relaxed">
                    For a SaaS project, <span class="font-medium">PostgreSQL</span> is usually the
                    safer choice. It gives you strict data integrity, powerful SQL queries, and excellent
                    tooling. Choose MongoDB if your data is highly variable in structure or you need to
                    scale writes horizontally from day one.
                </p>
            </div>

            <div class="mt-3 flex items-center gap-1">
                <button type="button" class="rounded p-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                    <LucideCopyCn Size="16" Class="size-3.5" />
                </button>
                <button type="button" class="rounded p-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                    <LucideThumbsUpCn Size="16" Class="size-3.5" />
                </button>
            </div>
        </div>
    </div>
</section>

@code {
    private record ComparisonRow(string Category, string Postgres, string Mongo);

    private static readonly ComparisonRow[] _comparisonData =
    {
        new("Data Model", "Relational (tables)", "Document (JSON)"),
        new("Schema", "Strict schema", "Flexible schema"),
        new("Query Language", "SQL", "MQL (MongoDB Query)"),
        new("ACID Transactions", "true", "Multi-doc since 4.0"),
        new("Horizontal Scaling", "Limited (Citus)", "true"),
        new("Full-text Search", "true", "true"),
        new("JSON Support", "JSONB column type", "Native"),
        new("Joins", "true", "Limited ($lookup)"),
        new("Geospatial", "PostGIS extension", "Built-in"),
        new("Change Streams", "Logical replication", "true")
    };

    private static RenderFragment RenderValue(string value) => builder =>
    {
        if (value == "true")
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "flex items-center gap-1.5 text-xs");
            builder.OpenElement(2, "span");
            builder.AddAttribute(3, "class", "size-1.5 rounded-full bg-emerald-500");
            builder.CloseElement();
            builder.AddContent(4, "Yes");
            builder.CloseElement();
        }
        else if (value == "false")
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "flex items-center gap-1.5 text-xs text-muted-foreground");
            builder.OpenElement(2, "span");
            builder.AddAttribute(3, "class", "size-1.5 rounded-full bg-red-500");
            builder.CloseElement();
            builder.AddContent(4, "No");
            builder.CloseElement();
        }
        else
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "text-xs text-foreground");
            builder.AddContent(2, value);
            builder.CloseElement();
        }
    };
}
