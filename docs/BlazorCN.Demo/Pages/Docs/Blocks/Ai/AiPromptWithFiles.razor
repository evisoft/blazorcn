@* ===========================================================
   Block: ai-prompt-with-files
   Title: Ai Prompt With Files
   Description: AI prompt with drag-drop file uploads, attachment badges, settings toggles, and quick action buttons
   Dependencies: ButtonCn, DropdownMenuCn, LucideArrowUpCn, LucideCameraCn, LucideClipboardCn, LucideFileUpCn, LucideLayoutDashboardCn, LucideLinkCn, LucidePaperclipCn, LucidePlusCn, LucideSettingsCn, LucideXCn, SwitchCn
   Source: original/blocks/ai/ai-prompt-with-files.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        <div class="relative">
            @* Attached files *@
            @if (_attachedFiles.Count > 0)
            {
                <div class="flex flex-wrap items-center gap-1.5 border-b px-4 py-3">
                    @foreach (var file in _attachedFiles.ToList())
                    {
                        var f = file;
                        <span class="group relative flex h-6 max-w-32 items-center gap-1.5 overflow-hidden rounded border bg-muted/50 pl-1.5 pr-5 text-xs">
                            <span class="flex size-4 shrink-0 items-center justify-center">
                                <LucidePaperclipCn Size="16" Class="size-3 text-muted-foreground" />
                            </span>
                            <span class="truncate text-muted-foreground">@f.Name</span>
                            <button type="button"
                                    class="absolute right-1 rounded-sm p-0.5 text-muted-foreground opacity-0 transition-opacity hover:text-foreground group-hover:opacity-100"
                                    @onclick="@(() => _attachedFiles.Remove(f))">
                                <LucideXCn Size="16" Class="size-3" />
                            </button>
                        </span>
                    }
                </div>
            }

            @* Textarea *@
            <div class="px-4 py-3">
                <textarea @bind="_prompt" @bind:event="oninput"
                          placeholder="Ask anything..."
                          rows="3"
                          class="min-h-[72px] max-h-40 w-full resize-none border-0 bg-transparent p-0 text-sm shadow-none outline-none focus-visible:ring-0"></textarea>
            </div>

            @* Toolbar *@
            <div class="flex items-center gap-1 border-t px-4 py-3">
                <DropdownMenuCn>
                    <DropdownMenuTriggerCn>
                        <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7">
                            <LucidePlusCn Size="16" Class="size-4" />
                        </ButtonCn>
                    </DropdownMenuTriggerCn>
                    <DropdownMenuContentCn Align="FloatingAlign.Start" Class="w-48">
                        <DropdownMenuGroupCn>
                            <DropdownMenuItemCn Class="text-xs"
                                                @onclick="@(() => _attachedFiles.Add(new("f" + (++_fileCounter), "uploaded-file.png")))">
                                <LucidePaperclipCn Size="16" Class="mr-2 size-3.5 text-muted-foreground" />
                                Attach Files
                            </DropdownMenuItemCn>
                            <DropdownMenuItemCn Class="text-xs">
                                <LucideLinkCn Size="16" Class="mr-2 size-3.5 text-muted-foreground" />
                                Import from URL
                            </DropdownMenuItemCn>
                            <DropdownMenuItemCn Class="text-xs">
                                <LucideClipboardCn Size="16" Class="mr-2 size-3.5 text-muted-foreground" />
                                Paste from Clipboard
                            </DropdownMenuItemCn>
                        </DropdownMenuGroupCn>
                    </DropdownMenuContentCn>
                </DropdownMenuCn>

                <DropdownMenuCn>
                    <DropdownMenuTriggerCn>
                        <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-7">
                            <LucideSettingsCn Size="16" Class="size-4" />
                        </ButtonCn>
                    </DropdownMenuTriggerCn>
                    <DropdownMenuContentCn Align="FloatingAlign.Start" Class="w-48 p-3">
                        <DropdownMenuGroupCn Class="space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="text-xs">Auto-complete</span>
                                <SwitchCn @bind-Checked="_autoComplete" Class="scale-75" />
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-xs">Streaming</span>
                                <SwitchCn @bind-Checked="_streaming" Class="scale-75" />
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-xs">Show History</span>
                                <SwitchCn @bind-Checked="_showHistory" Class="scale-75" />
                            </div>
                        </DropdownMenuGroupCn>
                    </DropdownMenuContentCn>
                </DropdownMenuCn>

                <div class="ml-auto">
                    <ButtonCn Size="ButtonSize.Icon" Variant="ButtonVariant.Default" Class="size-7"
                              Disabled="@(string.IsNullOrWhiteSpace(_prompt))"
                              @onclick="HandleSubmit">
                        <LucideArrowUpCn Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Quick actions *@
        <div class="flex flex-wrap items-center justify-center gap-2 border-t px-4 py-3">
            @foreach (var action in _actions)
            {
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1.5 rounded-full text-xs">
                    @action.Icon
                    @action.Label
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record AttachedFile(string Id, string Name);

    private record ActionItem(RenderFragment Icon, string Label);

    private readonly List<AttachedFile> _attachedFiles = new();
    private string _prompt = "";
    private bool _autoComplete = true;
    private bool _streaming;
    private bool _showHistory;
    private int _fileCounter;

    private ActionItem[] _actions => new ActionItem[]
    {
        new((RenderFragment)(b => { b.OpenComponent<LucideCameraCn>(0); b.AddAttribute(1, "Size", 16); b.AddAttribute(2, "Class", "size-3"); b.CloseComponent(); }), "Clone a Screenshot"),
        new((RenderFragment)(b => { b.OpenComponent<LucideFileUpCn>(0); b.AddAttribute(1, "Size", 16); b.AddAttribute(2, "Class", "size-3"); b.CloseComponent(); }), "Upload a Project"),
        new((RenderFragment)(b => { b.OpenComponent<LucideLayoutDashboardCn>(0); b.AddAttribute(1, "Size", 16); b.AddAttribute(2, "Class", "size-3"); b.CloseComponent(); }), "Landing Page"),
    };

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_prompt))
            _prompt = "";
    }
}
