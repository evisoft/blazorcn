@* ===========================================================
   Block: ai-tool-execution
   Title: Ai Tool Execution
   Description: React AI tool execution block for Next.js with animated progress, status badges, parameter display, and structured output using shadcn/ui and Tailwind CSS
   Long Description: React AI Tool Database Query Block
   Dependencies: ButtonCn
   Source: original/blocks/ai/ai-tool-execution.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="font-medium text-sm">Web Search</span>
            <span class="font-mono text-muted-foreground text-xs">1.2s</span>
            <div class="ml-auto flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">Completed</span>
            </div>
        </div>

        @* Parameters *@
        <div class="border-b">
            <button
                type="button"
                @onclick="() => _paramsExpanded = !_paramsExpanded"
                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _paramsExpanded ? "rotate-90" : "")" />
                <span class="font-medium text-sm">Input Parameters</span>
                <span class="text-muted-foreground text-xs">4 fields</span>
            </button>
            @if (_paramsExpanded)
            {
                <div class="border-t bg-muted/30 px-4 py-3 pl-11">
                    <pre class="space-y-1 font-mono text-xs">
                        <div><span class="text-muted-foreground">query: </span><span class="text-emerald-600 dark:text-emerald-400">"latest React 19 server components features"</span></div>
                        <div><span class="text-muted-foreground">maxResults: </span><span class="text-blue-600 dark:text-blue-400">5</span></div>
                        <div><span class="text-muted-foreground">language: </span><span class="text-emerald-600 dark:text-emerald-400">"en"</span></div>
                        <div><span class="text-muted-foreground">safeSearch: </span><span class="text-amber-600 dark:text-amber-400">true</span></div>
                    </pre>
                </div>
            }
        </div>

        @* Result *@
        <div>
            <button
                type="button"
                @onclick="() => _resultExpanded = !_resultExpanded"
                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _resultExpanded ? "rotate-90" : "")" />
                <span class="font-medium text-sm">Output Result</span>
            </button>
            @if (_resultExpanded)
            {
                <div class="border-t">
                    <div class="bg-zinc-950 px-4 py-3">
                        <pre class="overflow-x-auto font-mono text-xs leading-relaxed text-zinc-300">@_resultJson</pre>
                    </div>
                    <div class="flex justify-end border-t px-4 py-2">
                        <ButtonCn
                            Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Sm"
                            Class="h-6 gap-1 px-2 text-xs">
                            @if (_copied)
                            {
                                <LucideCheckCn Size="12" Class="size-3" />
                                <span>Copied</span>
                            }
                            else
                            {
                                <LucideCopyCn Size="12" Class="size-3" />
                                <span>Copy</span>
                            }
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private bool _paramsExpanded = true;
    private bool _resultExpanded = true;
    private bool _copied = false;

    private const string _resultJson = @"{
  ""totalResults"": 4280,
  ""results"": [
    {
      ""title"": ""React 19 Server Components Deep Dive"",
      ""url"": ""https://react.dev/blog/server-components"",
      ""snippet"": ""Server Components let you render components on the server...""
    },
    {
      ""title"": ""What's New in React 19"",
      ""url"": ""https://react.dev/blog/react-19"",
      ""snippet"": ""React 19 introduces Actions, use() hook, and improved...""
    }
  ]
}";
}
