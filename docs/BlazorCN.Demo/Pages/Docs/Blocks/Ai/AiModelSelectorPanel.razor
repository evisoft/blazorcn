@* ===========================================================
   Block: ai-model-selector-panel
   Title: Ai Model Selector Panel
   Description: AI model selector panel with grouped provider list, capability badges, speed dots, and radio selection
   Dependencies: BadgeCn, LucideCheckCn
   Source: original/blocks/ai/ai-model-selector-panel.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <span class="text-sm font-medium">Select model</span>
            <p class="mt-0.5 text-xs text-muted-foreground">
                @TotalModels models across @_providers.Length providers
            </p>
        </div>

        @* Provider groups *@
        @for (var gi = 0; gi < _providers.Length; gi++)
        {
            var group = _providers[gi];
            var groupIndex = gi;
            <div>
                @* Provider label *@
                <div class="@Cn.Merge("flex items-center gap-2 px-4 py-2.5", groupIndex > 0 ? "border-t" : "")">
                    <span class="size-1.5 rounded-full bg-muted-foreground/40"></span>
                    <span class="text-xs font-medium text-muted-foreground">@group.Provider</span>
                    <span class="text-xs text-muted-foreground">&middot;</span>
                    <span class="text-xs text-muted-foreground">@group.Models.Length models</span>
                </div>

                @* Model rows *@
                @foreach (var model in group.Models)
                {
                    var m = model;
                    var isSelected = _selected == m.Id;
                    <button type="button"
                            class="@Cn.Merge("flex w-full items-center gap-3 border-t px-4 py-3 text-left transition-colors hover:bg-muted/50", isSelected ? "bg-muted/50" : "")"
                            @onclick="@(() => _selected = m.Id)">
                        @* Radio indicator *@
                        <div class="@Cn.Merge("flex size-4 shrink-0 items-center justify-center rounded-full border transition-colors", isSelected ? "border-foreground bg-foreground" : "border-muted-foreground/30")">
                            @if (isSelected)
                            {
                                <LucideCheckCn Size="16" Class="size-2.5 text-background" />
                            }
                        </div>

                        @* Model info *@
                        <div class="min-w-0 flex-1">
                            <div class="flex flex-wrap items-center gap-1.5">
                                <span class="text-sm font-medium">@m.Name</span>
                                @foreach (var cap in m.Capabilities)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="px-1.5 py-0 text-[10px] font-normal">
                                        @cap
                                    </BadgeCn>
                                }
                            </div>
                        </div>

                        @* Speed dots *@
                        <div class="flex items-center gap-0.5" title="@($"Speed: {m.Speed}/5")">
                            @for (var d = 0; d < 5; d++)
                            {
                                var dotIndex = d;
                                <span class="@Cn.Merge("size-1.5 rounded-full", dotIndex < m.Speed ? "bg-emerald-500" : "bg-muted")"></span>
                            }
                        </div>

                        @* Price *@
                        <span class="shrink-0 font-mono text-xs text-muted-foreground">
                            @m.Price
                        </span>
                    </button>
                }
            </div>
        }
    </div>
</section>

@code {
    private record ModelData(string Id, string Name, string[] Capabilities, string Price, int Speed);
    private record ProviderGroup(string Provider, ModelData[] Models);

    private static readonly ProviderGroup[] _providers =
    {
        new("OpenAI", new[]
        {
            new ModelData("gpt-4o", "GPT-4o", new[] { "Vision", "Code", "Reasoning" }, "$5.00 / 1M", 4),
            new ModelData("gpt-4o-mini", "GPT-4o Mini", new[] { "Vision", "Code", "Fast" }, "$0.15 / 1M", 5),
            new ModelData("o1", "o1", new[] { "Reasoning", "Code" }, "$15.00 / 1M", 2),
            new ModelData("o3-mini", "o3-mini", new[] { "Reasoning", "Code", "Fast" }, "$1.10 / 1M", 4)
        }),
        new("Anthropic", new[]
        {
            new ModelData("claude-4-opus", "Claude Opus 4", new[] { "Vision", "Code", "Long context", "Reasoning" }, "$15.00 / 1M", 3),
            new ModelData("claude-4-sonnet", "Claude Sonnet 4", new[] { "Vision", "Code", "Long context", "Fast" }, "$3.00 / 1M", 4),
            new ModelData("claude-3.5-haiku", "Claude 3.5 Haiku", new[] { "Code", "Fast" }, "$0.80 / 1M", 5)
        }),
        new("Google", new[]
        {
            new ModelData("gemini-2.5-pro", "Gemini 2.5 Pro", new[] { "Vision", "Code", "Long context", "Reasoning" }, "$1.25 / 1M", 4),
            new ModelData("gemini-2.0-flash", "Gemini 2.0 Flash", new[] { "Vision", "Fast" }, "$0.10 / 1M", 5)
        })
    };

    private string _selected = "claude-4-sonnet";
    private int TotalModels => _providers.Sum(p => p.Models.Length);
}
