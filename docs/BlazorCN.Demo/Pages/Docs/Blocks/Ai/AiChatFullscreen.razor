@* ===========================================================
   Block: ai-chat-fullscreen
   Title: Ai Chat Fullscreen
   Description: AI fullscreen chat with immersive layout, large centered messages, and floating suggestion pills
   Dependencies: ButtonCn, InputCn, LucideSendCn
   Source: original/blocks/ai/ai-chat-fullscreen.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="text-sm font-medium">Creative Writing</span>
            <span class="text-xs text-muted-foreground">@_messages.Length messages</span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto">
            <div class="mx-auto flex max-w-xl flex-col gap-6 px-4 py-6">
                @foreach (var msg in _messages)
                {
                    @if (msg.Role == "user")
                    {
                        <div class="flex justify-end">
                            <div class="max-w-[80%] rounded-lg bg-primary px-3 py-2 text-sm text-primary-foreground">
                                <p class="leading-relaxed">@msg.Content</p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="rounded-lg bg-muted/50 px-3 py-2">
                            <div class="whitespace-pre-wrap text-sm leading-relaxed">@msg.Content</div>
                        </div>
                    }
                }
            </div>
        </div>

        @* Suggestions *@
        <div class="mx-auto w-full max-w-xl px-4 pb-2">
            <div class="flex flex-wrap gap-1.5">
                @foreach (var s in _suggestions)
                {
                    <button type="button"
                            class="rounded-full border px-3 py-1 text-xs text-muted-foreground transition-colors hover:bg-muted/50 hover:text-foreground"
                            @onclick="@(() => _input = s)">
                        @s
                    </button>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="mx-auto flex max-w-xl items-center gap-2">
                <InputCn Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0"
                         Placeholder="Say something..."
                         @bind-Value="_input" />
                <ButtonCn Class="h-7 shrink-0 gap-1.5 text-xs"
                          Size="ButtonSize.Sm"
                          Variant="ButtonVariant.Outline"
                          Disabled="@(string.IsNullOrWhiteSpace(_input))">
                    <LucideSendCn Size="16" Class="size-3" />
                    Send
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Role, string Content);

    private static readonly ChatMessage[] _messages =
    {
        new("1", "user", "Write me a short poem about the ocean at dawn."),
        new("2", "assistant", "The tide arrives in silver sheets,\na hush before the morning heats.\nGulls trace arcs on salted air,\nwhile light spills gold through clouds laid bare.\n\nBeneath the surface, currents hum\na song of all the depths they've come\u2014\nand on the shore, the foam recedes,\nleaving shells like scattered seeds."),
        new("3", "user", "That's beautiful. Can you write another about a forest at night?"),
        new("4", "assistant", "The canopy draws shut its veil,\neach branch a stroke in moonlit braille.\nOwl calls thread through bark and moss,\nwhere shadows count no gain or loss.\n\nA creek confides in polished stone,\nits whisper soft, its path its own.\nThe ferns bow low to passing deer\u2014\nthe forest breathes, and night is here.")
    };

    private static readonly string[] _suggestions =
    {
        "Write one about a city at midnight",
        "Make it longer with rhyming couplets",
        "Turn the ocean poem into a haiku",
        "Write a poem about solitude"
    };

    private string _input = "";
}
