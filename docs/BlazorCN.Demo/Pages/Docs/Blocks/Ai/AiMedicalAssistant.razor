@* ===========================================================
   Block: ai-medical-assistant
   Title: Ai Medical Assistant
   Description: React AI medical symptom checker chat block for Next.js with severity assessment cards, clarifying questions, and safety disclaimers using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn, TextareaCn
   Source: original/blocks/ai/ai-medical-assistant.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="font-medium text-sm">Health Assistant</span>
                <span class="text-muted-foreground text-xs">Symptom analysis and guidance</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                Active
            </BadgeCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto">
            <div class="flex flex-col gap-6 p-6">
                @for (var i = 0; i < _messages.Length; i++)
                {
                    var idx = i;
                    var msg = _messages[idx];

                    <div class="flex flex-col gap-2">
                        @if (msg.Role == "user")
                        {
                            <div class="flex justify-end">
                                <div class="rounded-lg bg-muted px-3 py-2 text-sm">
                                    <p>@msg.Content</p>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="flex gap-3">
                                <div class="mt-1 flex size-6 shrink-0 items-center justify-center rounded-full bg-muted">
                                    <span class="font-medium text-muted-foreground text-[10px]">AI</span>
                                </div>
                                <div class="min-w-0 flex-1 space-y-3">
                                    <p class="whitespace-pre-wrap text-sm leading-relaxed">@msg.Content</p>

                                    @if (!string.IsNullOrEmpty(msg.AssessmentLabel))
                                    {
                                        <div class="rounded-md bg-muted/50 p-3">
                                            <div class="mb-1 flex items-center gap-2">
                                                <span class="@Cn.Merge("size-2 rounded-full", _severityDot[msg.AssessmentSeverity!])"></span>
                                                <span class="font-medium text-sm">@msg.AssessmentLabel</span>
                                            </div>
                                            <p class="pl-4 text-muted-foreground text-xs">
                                                @msg.AssessmentRecommendation
                                            </p>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Follow-up suggestions *@
        <div class="flex flex-wrap gap-1.5 px-4 pb-2">
            @foreach (var q in _followUpQuestions)
            {
                <button
                    type="button"
                    class="rounded-full border px-3 py-1 text-xs transition-colors hover:bg-muted/50">
                    @q
                </button>
            }
        </div>

        @* Disclaimer *@
        <div class="mx-4 mb-3 rounded-md bg-muted/50 px-3 py-2">
            <div class="flex items-start gap-2">
                <LucideTriangleAlertCn Size="14" Class="mt-0.5 size-3.5 shrink-0 text-amber-600 dark:text-amber-400" />
                <p class="text-muted-foreground text-[11px] leading-relaxed">
                    This tool provides general health information only. It is not a substitute for
                    professional medical advice, diagnosis, or treatment. Always consult a healthcare
                    provider for medical concerns.
                </p>
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form class="flex items-end gap-3">
                <TextareaCn @bind-Value="_input"
                    Placeholder="Describe your symptoms..."
                    rows="1"
                    Class="min-h-0 max-h-32 resize-none" />
                <ButtonCn
                    type="submit"
                    Size="ButtonSize.Sm"
                    Variant="ButtonVariant.Outline"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    class="h-7 shrink-0 text-xs">
                    <LucideSendCn Size="12" Class="size-3" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Role, string Content, string? AssessmentSeverity = null, string? AssessmentLabel = null, string? AssessmentRecommendation = null);

    private static readonly Dictionary<string, string> _severityDot = new()
    {
        ["low"] = "bg-emerald-500",
        ["moderate"] = "bg-amber-500",
        ["high"] = "bg-red-500",
        ["emergency"] = "bg-red-500",
    };

    private static readonly string _msg2Content = @"Thank you for sharing those details. Let me ask a few clarifying questions to better understand your symptoms.

**About the headache:**
- How would you describe the pain? (throbbing, pressure, sharp, dull)
- On a scale of 1-10, how severe is it?
- Does it come and go, or is it constant?

**Associated symptoms:**
- Any visual disturbances (blurry vision, spots, light sensitivity)?
- Nausea or vomiting?
- Neck stiffness?

**Context:**
- Have you had any recent changes to your sleep schedule?
- How many hours per day are you spending on screens?
- Are you staying hydrated?";

    private static readonly string _msg4Content = @"Based on the symptoms you've described, this presentation is consistent with a **tension-type headache** with features that suggest a possible **screen-related strain component**.

**Key factors:**
- Unilateral throbbing pain (right side) with photophobia
- Correlation with extended screen time (12+ hours)
- Likely dehydration as a contributing factor
- Absence of nausea, neck stiffness, or visual aura

**Recommended steps:**
1. **Hydration** — Aim for at least 8 glasses of water per day
2. **Screen breaks** — Follow the 20-20-20 rule: every 20 minutes, look at something 20 feet away for 20 seconds
3. **Ergonomics** — Ensure your monitor is at eye level, 20-26 inches from your eyes
4. **Rest** — Reduce screen time where possible over the next 48 hours
5. **Over-the-counter relief** — Ibuprofen or acetaminophen as directed on the label

If the headache persists beyond 7 days, significantly worsens, or you develop new symptoms (fever, vision changes, neck stiffness), seek medical attention promptly.";

    private static readonly ChatMessage[] _messages =
    [
        new("1", "user", "I've had a persistent headache for the past three days, mainly on the right side. It gets worse when I look at screens."),
        new("2", "assistant", _msg2Content),
        new("3", "user", "It's a throbbing pain, about a 6/10. It comes and goes. I have some light sensitivity but no nausea. I've been working 12-hour days on the computer and probably not drinking enough water."),
        new("4", "assistant", _msg4Content, "moderate", "Moderate — Monitor at Home", "Self-care measures recommended. Seek medical attention if symptoms persist beyond 7 days or worsen."),
    ];

    private static readonly string[] _followUpQuestions =
    [
        "What if the headache gets worse?",
        "Should I see a neurologist?",
        "Can you suggest ergonomic setups?",
        "Are there warning signs I should watch for?",
    ];

    private string _input = "";
}
