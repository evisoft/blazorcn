@* ===========================================================
   Block: ai-prompt-with-templates
   Title: Ai Prompt With Templates
   Description: React AI prompt with templates block for Next.js with a 3x2 template card gallery and auto-fill textarea using shadcn/ui and Tailwind CSS
   Long Description: React AI Prompt with System Role Block
   Dependencies: ButtonCn, TextareaCn
   Source: original/blocks/ai/ai-prompt-with-templates.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Templates *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">
                Choose a template
            </span>
            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2 md:grid-cols-3">
                @foreach (var template in _templates)
                {
                    var isSelected = _selectedTemplate == template.Title;
                    <button type="button"
                            class="@Cn.Merge("group flex items-start gap-2.5 rounded-md border p-2.5 text-left transition-colors", isSelected ? "border-foreground/20 bg-muted/50" : "border-transparent hover:bg-muted/50")"
                            @onclick="@(() => HandleTemplateClick(template))">
                        @template.IconFragment
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">@template.Title</span>
                            <p class="mt-0.5 text-muted-foreground text-[11px] leading-snug">
                                @template.Description
                            </p>
                        </div>
                        <LucideChevronRightCn Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground/40 transition-colors group-hover:text-muted-foreground" />
                    </button>
                }
            </div>
        </div>

        @* Input *@
        <div class="px-4 py-3">
            <TextareaCn @bind-Value="_input"
                        Placeholder="Describe what you need..."
                        Rows="3"
                        Class="min-h-[72px] max-h-40 resize-none border-0 bg-transparent p-0 text-sm shadow-none focus-visible:ring-0" />
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-muted-foreground text-xs">
                @if (_input.Length > 0)
                {
                    @($"{_input.Length} characters")
                }
                else
                {
                    <text>Select a template or type freely</text>
                }
            </span>
            <ButtonCn Type="submit"
                      Size="ButtonSize.Sm"
                      Variant="ButtonVariant.Default"
                      Disabled="@(string.IsNullOrWhiteSpace(_input))"
                      Class="h-7 gap-1.5 text-xs">
                <LucideArrowUpCn Size="14" Class="size-3.5" />
                Send
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record TemplateItem(string Title, string Description, string Prompt, RenderFragment IconFragment);

    private TemplateItem[] _templates = null!;

    protected override void OnInitialized()
    {
        _templates = new TemplateItem[]
        {
            new("Write a blog post", "Draft a structured article with intro, body, and conclusion",
                "Write a 1,200-word blog post about the future of AI in software development. Include an engaging introduction, three main sections with subheadings, practical examples, and a compelling conclusion with a call to action.",
                @<LucideBookOpenCn Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />),
            new("Analyze data", "Extract insights and trends from datasets",
                "Analyze the following dataset and provide key insights. Identify trends, outliers, and correlations. Present your findings in a structured format with bullet points and suggest three actionable recommendations based on the data.",
                @<LucideTrendingUpCn Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />),
            new("Generate code", "Create clean, typed, production-ready code",
                "Write a TypeScript React component that implements a sortable, filterable data table with pagination. Use shadcn/ui components, include proper TypeScript interfaces, handle loading and empty states, and add inline comments explaining key logic.",
                @<LucideCodeCn Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />),
            new("Summarize text", "Condense long documents into key takeaways",
                "Summarize the following text into a concise overview. Start with a one-sentence TL;DR, then provide 5-7 bullet points covering the main arguments, key data points, and conclusions. Maintain the original tone and highlight any action items.",
                @<LucideBrainCn Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />),
            new("Translate content", "Translate with cultural context and natural phrasing",
                "Translate the following content into Spanish, maintaining the original tone, cultural nuances, and formatting. Provide alternative translations for idiomatic expressions and flag any phrases that may not translate directly.",
                @<LucideLanguagesCn Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />),
            new("Brainstorm ideas", "Generate creative concepts and innovative solutions",
                "Brainstorm 10 creative ideas for a SaaS product that helps remote teams collaborate more effectively. For each idea, provide a catchy name, one-line description, target audience, key differentiator, and potential monetization strategy.",
                @<LucideLightbulbCn Size="14" Class="mt-0.5 size-3.5 shrink-0 text-muted-foreground" />)
        };
    }

    private string _input = "";
    private string? _selectedTemplate;

    private void HandleTemplateClick(TemplateItem template)
    {
        _input = template.Prompt;
        _selectedTemplate = template.Title;
    }
}
