@* ===========================================================
   Block: ai-voice-assistant
   Title: Ai Voice Assistant
   Description: React AI voice assistant block for Next.js with animated waveform visualization, transcript display, voice controls, and conversation history using shadcn/ui and Tailwind CSS
   Dependencies: ButtonCn
   Source: original/blocks/ai/ai-voice-assistant.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="font-medium text-sm">Voice Assistant</span>
            <div class="ml-auto flex items-center gap-1.5">
                <span class="size-1.5 animate-pulse rounded-full bg-emerald-500"></span>
                <span class="text-muted-foreground text-xs">
                    @(_isListening ? "Active" : "Paused")
                </span>
            </div>
        </div>

        @* Waveform visualization *@
        <div class="flex flex-col items-center justify-center gap-4 border-b px-4 py-8">
            <div class="flex h-24 items-center gap-1">
                @foreach (var bar in _waveformBars)
                {
                    <div
                        class="@Cn.Merge(bar.Height, "w-1.5 rounded-full", _isListening ? "bg-foreground" : "bg-muted")"
                        style="@(_isListening ? $"animation: pulse @bar.Duration ease-in-out @bar.Delay infinite alternate" : "animation: none")">
                    </div>
                }
            </div>
            <div class="text-center">
                <p class="font-medium text-sm">@(_isListening ? "Listening..." : "Paused")</p>
                <p class="mt-0.5 text-muted-foreground text-xs">
                    @(_isListening ? "\"Set a timer for twenty minutes\"" : "Tap the mic to start")
                </p>
            </div>
        </div>

        @* Controls *@
        <div class="flex items-center justify-center gap-3 border-b px-4 py-4">
            <ButtonCn
                Variant="ButtonVariant.Outline"
                Size="ButtonSize.Sm"
                class="h-8 gap-1.5 text-xs"
                @onclick="@(() => _isMuted = !_isMuted)">
                @if (_isMuted)
                {
                    <LucideMicOffCn Size="14" Class="size-3.5 text-red-500" />
                }
                else
                {
                    <LucideMicCn Size="14" Class="size-3.5" />
                }
                @(_isMuted ? "Unmute" : "Mute")
            </ButtonCn>
            <ButtonCn
                Variant="ButtonVariant.Outline"
                Size="ButtonSize.Sm"
                class="h-8 gap-1.5 text-xs"
                @onclick="@(() => _isListening = !_isListening)">
                @if (_isListening)
                {
                    <LucideSquareCn Size="12" Class="size-3 fill-current" />
                    <span>Stop</span>
                }
                else
                {
                    <LucideMicCn Size="14" Class="size-3.5" />
                    <span>Start</span>
                }
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-8 text-xs">
                <LucideSettingsCn Size="14" Class="size-3.5" />
            </ButtonCn>
        </div>

        @* History *@
        <div class="flex-1 overflow-y-auto">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Recent conversations</span>
            </div>
            <div>
                @for (var i = 0; i < _history.Length; i++)
                {
                    var idx = i;
                    var entry = _history[idx];
                    var isLast = idx == _history.Length - 1;

                    <div class="@Cn.Merge("px-4 py-3 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                        <div class="flex items-center gap-2">
                            <span class="font-medium text-xs">
                                @(entry.Role == "user" ? "You" : "Assistant")
                            </span>
                            <span class="text-muted-foreground text-xs">@entry.Timestamp</span>
                        </div>
                        <p class="mt-1 text-muted-foreground text-sm leading-relaxed">
                            @entry.Content
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record VoiceEntry(string Id, string Role, string Content, string Timestamp);
    private record WaveformBar(string Height, string Delay, string Duration);

    private static readonly VoiceEntry[] _history =
    [
        new("1", "user", "What's the weather forecast for San Francisco this weekend?", "2:31 PM"),
        new("2", "assistant", "This weekend in San Francisco: Saturday will be partly cloudy with highs around 62\u00b0F. Sunday looks clearer with temperatures reaching 65\u00b0F. Light winds from the west both days.", "2:31 PM"),
        new("3", "user", "Remind me to pack a jacket before I leave on Friday.", "2:32 PM"),
        new("4", "assistant", "Done! I've set a reminder for Friday at 5:00 PM to pack a jacket before your trip to San Francisco.", "2:32 PM"),
    ];

    private static readonly WaveformBar[] _waveformBars =
    [
        new("h-4", "0s", "0.8s"),
        new("h-8", "0.1s", "0.6s"),
        new("h-12", "0.05s", "0.9s"),
        new("h-16", "0.15s", "0.5s"),
        new("h-20", "0.08s", "0.7s"),
        new("h-24", "0.2s", "0.55s"),
        new("h-20", "0.12s", "0.85s"),
        new("h-16", "0.03s", "0.65s"),
        new("h-24", "0.18s", "0.5s"),
        new("h-12", "0.06s", "0.75s"),
        new("h-20", "0.13s", "0.6s"),
        new("h-8", "0.09s", "0.8s"),
        new("h-16", "0.22s", "0.55s"),
        new("h-12", "0.07s", "0.7s"),
        new("h-4", "0.16s", "0.9s"),
    ];

    private bool _isMuted = false;
    private bool _isListening = true;
}
