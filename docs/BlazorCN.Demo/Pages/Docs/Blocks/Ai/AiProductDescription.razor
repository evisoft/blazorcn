@* ===========================================================
   Block: ai-product-description
   Title: Ai Product Description
   Description: AI product description generator with product info form, multi-length output tabs, SEO scoring, and keyword suggestions
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideCheckCn, LucideChevronRightCn, LucideCopyCn, LucideXCn, SelectCn
   Source: original/blocks/ai/ai-product-description.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm font-medium">Product Description Generator</span>
            <div class="flex items-center gap-2">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    SEO 87/100
                </span>
            </div>
        </div>

        @* Product input *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <InputCn @bind-Value="_productName"
                         Placeholder="Product name..."
                         Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" aria-label="Product name..." />
                <SelectCn Value="@_category" ValueChanged="v => _category = v">
                    <SelectTriggerCn aria-label="Product category" Class="h-7 w-36 shrink-0 text-xs">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="@("electronics")">Electronics</SelectItemCn>
                        <SelectItemCn Value="@("fashion")">Fashion</SelectItemCn>
                        <SelectItemCn Value="@("home")">Home &amp; Garden</SelectItemCn>
                        <SelectItemCn Value="@("sports")">Sports</SelectItemCn>
                        <SelectItemCn Value="@("beauty")">Beauty</SelectItemCn>
                        <SelectItemCn Value="@("software")">Software</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Feature tags *@
        <div class="border-b px-4 py-3">
            <div class="flex flex-wrap items-center gap-1.5">
                @foreach (var f in _features.ToList())
                {
                    var feature = f;
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 pl-2 pr-1 text-xs font-normal">
                        @feature
                        <button type="button"
                                class="ml-0.5 rounded-full p-0.5 hover:bg-muted-foreground/20"
                                @onclick="@(() => _features.Remove(feature))" aria-label="@($"Remove {feature}")">
                            <LucideXCn Size="16" Class="size-2.5" />
                        </button>
                    </BadgeCn>
                }
                <input type="text" @bind="_featureInput" @bind:event="oninput"
                       @onkeydown="HandleFeatureKeyDown"
                       placeholder="Add feature..."
                       class="h-6 min-w-20 flex-1 border-0 bg-transparent px-0 text-xs shadow-none outline-none focus-visible:ring-0" aria-label="Add feature..." />
            </div>
        </div>

        @* Length selector *@
        <div class="flex items-center gap-1 border-b px-4 py-2.5">
            @foreach (var dl in _descriptionLengths)
            {
                var key = dl.Key;
                <button type="button"
                        class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _activeLength == key ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50")"
                        @onclick="@(() => _activeLength = key)">
                    @dl.Label
                </button>
            }
            <div class="ml-auto flex items-center gap-2">
                <span class="font-mono text-xs text-muted-foreground">
                    @WordCount(_descriptions[_activeLength]) words
                </span>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs"
                          @onclick="HandleCopy">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="16" Class="size-3" />
                        <text>Copied</text>
                    }
                    else
                    {
                        <LucideCopyCn Size="16" Class="size-3" />
                        <text>Copy</text>
                    }
                </ButtonCn>
            </div>
        </div>

        @* Description output *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <p class="whitespace-pre-line text-sm leading-relaxed">
                    @_descriptions[_activeLength]
                </p>
            </div>
        </div>

        @* Keyword suggestions *@
        <div>
            <button type="button"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    @onclick="@(() => _expandedKeywords = !_expandedKeywords)">
                <span class="size-2 shrink-0 rounded-full bg-blue-500"></span>
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">Suggested Keywords</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_suggestedKeywords.Length keywords based on product category
                    </p>
                </div>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _expandedKeywords ? "rotate-90" : "")" />
            </button>

            @if (_expandedKeywords)
            {
                <div class="px-4 pb-4 pl-9">
                    <div class="flex flex-wrap gap-1.5">
                        @foreach (var kw in _suggestedKeywords)
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="cursor-pointer text-xs font-normal transition-colors hover:bg-muted">
                                @kw
                            </BadgeCn>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record DescLength(string Key, string Label);

    private static readonly DescLength[] _descriptionLengths =
    {
        new("short", "Short"),
        new("medium", "Medium"),
        new("detailed", "Detailed")
    };

    private static readonly string[] _suggestedKeywords =
    {
        "wireless earbuds", "noise cancellation", "spatial audio", "bluetooth 5.3",
        "IPX5 waterproof", "long battery life", "premium audio", "adaptive EQ"
    };

    private static readonly Dictionary<string, string> _descriptions = new()
    {
        ["short"] = "Premium wireless earbuds with active noise cancellation, 36-hour battery life, and spatial audio. IPX5 water-resistant with adaptive EQ that automatically tunes music to your ears. The perfect companion for commutes, workouts, and focused work sessions.",
        ["medium"] = "Experience audio like never before with the SoundPro X1 wireless earbuds. Featuring advanced hybrid active noise cancellation that blocks up to 40dB of ambient noise, these earbuds create your own personal sound sanctuary wherever you go.\n\nThe adaptive EQ technology analyzes your ear shape in real-time and automatically tunes the audio output for a personalized listening experience. With 36 hours of total battery life (8 hours per charge + 28 hours from the wireless charging case), you'll never be caught without your music.\n\nBuilt with IPX5 water resistance, six microphones for crystal-clear calls, and seamless multipoint connection to switch between your laptop and phone effortlessly. Available in Midnight Black, Arctic White, and Ocean Blue.",
        ["detailed"] = "Introducing the SoundPro X1 \u2014 a new benchmark in wireless audio technology designed for the discerning listener who refuses to compromise on sound quality, comfort, or convenience.\n\nImmersive Sound, Tailored to You\nThe SoundPro X1 features custom-designed 11mm dynamic drivers with a titanium-coated diaphragm that delivers rich bass, crystal-clear mids, and detailed highs across a wide 20Hz-40kHz frequency range. The adaptive EQ system uses built-in microphones to analyze your unique ear geometry and automatically optimizes the sound profile.\n\nIndustry-Leading Noise Cancellation\nWith hybrid ANC powered by three external and three internal microphones per earbud, the X1 reduces ambient noise by up to 40dB. Choose from three modes: Full ANC for flights and offices, Transparency Mode to stay aware of your surroundings, and Adaptive Mode that adjusts in real-time based on your environment.\n\nAll-Day Battery & Fast Charging\nGet 8 hours of continuous playback with ANC enabled (12 hours with ANC off), plus 28 additional hours from the compact wireless charging case. A quick 10-minute charge provides 2 hours of listening.\n\nBuilt for Life on the Move\nIPX5 water and sweat resistance means these earbuds can handle intense workouts and unexpected rain. The ergonomic design with three sizes of silicone and memory foam ear tips ensures a secure, comfortable fit. At just 5.4g per earbud, you'll forget you're wearing them.\n\nSeamless Connectivity\nBluetooth 5.3 with multipoint connection lets you switch between devices instantly. Low-latency mode for gaming, spatial audio for immersive entertainment, and Google Fast Pair / Apple Find My support.\n\nAvailable in Midnight Black, Arctic White, and Ocean Blue. Includes charging case, USB-C cable, three sizes of silicone tips, two sizes of memory foam tips, and a premium carrying pouch."
    };

    private string _productName = "SoundPro X1 Wireless Earbuds";
    private string _category = "electronics";
    private readonly List<string> _features = new() { "Active noise cancellation", "36-hour battery", "Spatial audio", "IPX5 water resistant" };
    private string _featureInput = "";
    private string _activeLength = "short";
    private bool _copied;
    private bool _expandedKeywords;

    private static int WordCount(string text) => text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;

    private void HandleFeatureKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or ",")
        {
            var trimmed = _featureInput.Trim().TrimEnd(',');
            if (!string.IsNullOrEmpty(trimmed) && !_features.Contains(trimmed))
                _features.Add(trimmed);
            _featureInput = "";
        }
    }

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
