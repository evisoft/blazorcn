@* ===========================================================
   Block: ai-code-refactor
   Title: Ai Code Refactor
   Description: React AI code refactoring suggestions block for Next.js with original code display, suggestion cards, affected lines badges, and apply/dismiss actions using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/ai/ai-code-refactor.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Refactoring Suggestions</span>
                <p class="mt-0.5 font-mono text-muted-foreground text-xs">
                    src/pages/ProductCatalog.tsx — 48 lines analyzed
                </p>
            </div>
            <div class="flex items-center gap-3">
                @if (_appliedIds.Count > 0)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_appliedIds.Count applied
                    </BadgeCn>
                }
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_suggestions.Count(s => s.Priority == "high")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_suggestions.Count(s => s.Priority == "medium")
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_suggestions.Count(s => s.Priority == "low")
                </span>
            </div>
        </div>

        @* Original Code *@
        <div class="border-b">
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Original code</span>
            </div>
            <div class="max-h-[180px] overflow-auto" tabindex="0" role="group" aria-label="Refactored code">
                <pre class="bg-zinc-950 p-3 font-mono text-sm"><code class="text-zinc-300">@_originalCode</code></pre>
            </div>
        </div>

        @* Suggestions *@
        <div>
            @for (var i = 0; i < _suggestions.Length; i++)
            {
                var idx = i;
                var suggestion = _suggestions[idx];
                var isExpanded = _expanded == suggestion.Id;
                var isApplied = _appliedIds.Contains(suggestion.Id);
                var isLast = idx == _suggestions.Length - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expanded = isExpanded ? null : suggestion.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", isApplied ? "bg-emerald-500" : _priorityDot[suggestion.Priority])"></span>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm">
                                @if (isApplied)
                                {
                                    <LucideCheckCn Size="12" Class="mr-1 inline size-3 text-emerald-500" />
                                }
                                @suggestion.Title
                            </span>
                            <p class="mt-0.5 font-mono text-muted-foreground text-xs">
                                Lines @suggestion.LinesStart-@suggestion.LinesEnd
                            </p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="space-y-3 px-4 pb-4 pl-9">
                            @* Rationale *@
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-1.5 flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">Rationale</span>
                                    <ButtonCn
                                        Variant="ButtonVariant.Ghost"
                                        Size="ButtonSize.Sm"
                                        class="h-6 gap-1 px-2 text-xs">
                                        @if (_copied == suggestion.Id)
                                        {
                                            <LucideCheckCn Size="12" Class="size-3" />
                                            <span>Copied</span>
                                        }
                                        else
                                        {
                                            <LucideCopyCn Size="12" Class="size-3" />
                                            <span>Copy</span>
                                        }
                                    </ButtonCn>
                                </div>
                                <p class="text-sm leading-relaxed">@suggestion.Rationale</p>
                            </div>

                            @* Before / After *@
                            <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
                                <div>
                                    <span class="mb-1 block font-medium text-muted-foreground text-xs">
                                        Before
                                    </span>
                                    <pre class="overflow-x-auto rounded-md bg-zinc-950 p-3 font-mono text-sm text-zinc-300">@suggestion.Before</pre>
                                </div>
                                <div>
                                    <span class="mb-1 block font-medium text-muted-foreground text-xs">
                                        After
                                    </span>
                                    <pre tabindex="0" role="group" aria-label="Refactored code for @suggestion.Title" class="overflow-x-auto rounded-md bg-zinc-950 p-3 font-mono text-sm text-zinc-300">@suggestion.After</pre>
                                </div>
                            </div>

                            @* Actions *@
                            @if (!isApplied)
                            {
                                <div class="flex gap-2">
                                    <ButtonCn
                                        Variant="ButtonVariant.Outline"
                                        Size="ButtonSize.Sm"
                                        class="h-7 text-xs"
                                        @onclick="@(() => _appliedIds.Add(suggestion.Id))">
                                        Apply
                                    </ButtonCn>
                                    <ButtonCn
                                        Variant="ButtonVariant.Ghost"
                                        Size="ButtonSize.Sm"
                                        class="h-7 text-xs text-muted-foreground">
                                        Dismiss
                                    </ButtonCn>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record RefactorSuggestion(string Id, string Title, string Description, string Priority, int LinesStart, int LinesEnd, string Before, string After, string Rationale);

    private static readonly Dictionary<string, string> _priorityDot = new()
    {
        ["high"] = "bg-red-500",
        ["medium"] = "bg-amber-500",
        ["low"] = "bg-blue-500",
    };

    private static readonly string _beforeCode1 = @"useEffect(() => {
  setLoading(true)
  fetch(""/api/products"")
    .then(res => res.json())
    .then(data => {
      setProducts(data)
      setLoading(false)
    })
    .catch(err => {
      setError(err.message)
      setLoading(false)
    })
}, [])";

    private static readonly string _afterCode1 = @"const { data: products, loading, error } = useApi<Product[]>(
  ""/api/products""
)";

    private static readonly string _beforeCode2 = @"if (order.status === ""pending"") {
  // ...
} else if (order.status === ""shipped"") {
  // ...
} else if (order.status === ""delivered"") {
  // ...
}";

    private static readonly string _afterCode2 = @"enum OrderStatus {
  Pending = ""pending"",
  Shipped = ""shipped"",
  Delivered = ""delivered"",
}

switch (order.status) {
  case OrderStatus.Pending: // ...
  case OrderStatus.Shipped: // ...
  case OrderStatus.Delivered: // ...
}";

    private static readonly string _beforeCode3 = @"return (
  <div className=""grid grid-cols-3 gap-4"">
  </div>
)";

    private static readonly string _afterCode3 = @"return (
  <ErrorBoundary fallback={<ProductGridError onRetry={refetch} />}>
    <div className=""grid grid-cols-3 gap-4"">
    </div>
  </ErrorBoundary>
)";

    private static readonly string _beforeCode4 = @"const filtered = products.filter(
  p => p.category === activeCategory && p.price <= maxPrice
)";

    private static readonly string _afterCode4 = @"const filtered = useMemo(
  () => products.filter(
    p => p.category === activeCategory && p.price <= maxPrice
  ),
  [products, activeCategory, maxPrice]
)";

    private static readonly string _originalCode = @"import { useState, useEffect } from ""react""
import { ProductCard } from ""./ProductCard""

export function ProductCatalog() {

  useEffect(() => {
    setLoading(true)
    fetch(""/api/products"")
      .then(res => res.json())
      .then(data => {
        setProducts(data)
        setLoading(false)
      .catch(err => {
        setError(err.message)
        setLoading(false)
  }, [])

  const filtered = products.filter(
    p => p.category === activeCategory && p.price <= maxPrice
  )

  if (loading) return <Spinner />
  if (error) return <p>Error: {error}</p>

  return (
    <div className=""grid grid-cols-3 gap-4"">
    </div>
  )
}";

    private static readonly RefactorSuggestion[] _suggestions =
    [
        new("1", "Extract fetch logic into custom hook",
            "Move the data fetching pattern into a reusable useApi hook",
            "high", 8, 22, _beforeCode1, _afterCode1,
            "This fetch pattern is duplicated in 4 other components. Extracting it into a hook eliminates ~60 lines of repeated code and centralizes error handling."),
        new("2", "Replace string comparison with enum",
            "Use TypeScript enum for status values instead of raw strings",
            "medium", 28, 35, _beforeCode2, _afterCode2,
            "String literals are error-prone and lack autocomplete. An enum provides compile-time safety and makes refactoring status values safer. The switch statement also enables exhaustive checking."),
        new("3", "Add error boundary wrapper",
            "Wrap the product grid with an error boundary for graceful failure",
            "high", 42, 42, _beforeCode3, _afterCode3,
            "If a single ProductCard throws during rendering, the entire page crashes. An error boundary catches the error and shows a retry button instead, keeping the rest of the page functional."),
        new("4", "Memoize filtered results",
            "Wrap the filter computation in useMemo to prevent recalculation",
            "low", 25, 27, _beforeCode4, _afterCode4,
            "The filter runs on every render, even when neither products, activeCategory, nor maxPrice has changed. With 500+ products, this causes noticeable lag when typing in unrelated input fields."),
    ];

    private string? _expanded = "1";
    private HashSet<string> _appliedIds = new();
    private string? _copied = null;
}
