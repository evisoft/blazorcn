@* ===========================================================
   Block: ai-chat-with-canvas
   Title: Ai Chat With Canvas
   Description: AI chat with canvas split-panel layout, inline editing toolbar, and AI-generated rich content
   Dependencies: ButtonCn, LucideArrowUpCn, LucideBoldCn, LucideCodeCn, LucideGripVerticalCn, LucideItalicCn, LucidePlusCn, SeparatorCn
   Source: original/blocks/ai/ai-chat-with-canvas.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex h-[700px] overflow-hidden rounded-lg border bg-card">
        @* Chat panel *@
        <div class="flex w-[340px] shrink-0 flex-col border-r">
            <div class="flex items-center gap-2 border-b px-4 py-3">
                <span class="text-sm font-medium">AI Writer</span>
                <span class="text-xs text-muted-foreground">&middot;</span>
                <span class="text-xs text-muted-foreground">Editing canvas</span>
            </div>

            @* Messages *@
            <div class="flex-1 overflow-y-auto">
                <div class="flex flex-col">
                    @for (var i = 0; i < _messages.Length; i++)
                    {
                        var msg = _messages[i];
                        var isLast = i == _messages.Length - 1;
                        <div class="@(!isLast ? "border-b" : "")">
                            <div class="px-4 py-3">
                                <span class="mb-1 block text-xs font-medium text-muted-foreground">
                                    @(msg.Role == "user" ? "You" : "AI")
                                </span>
                                <p class="text-[13px] leading-relaxed">@msg.Content</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Chat input *@
            <div class="border-t px-4 py-3">
                <div class="relative">
                    <textarea class="min-h-0 max-h-24 w-full resize-none border-0 bg-transparent pr-10 text-[13px] shadow-none focus:outline-none focus-visible:ring-0"
                              rows="1"
                              placeholder="Ask AI to edit..."
                              @bind="_input"></textarea>
                    <ButtonCn Class="absolute right-1 top-1/2 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                              Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost"
                              Disabled="@(string.IsNullOrWhiteSpace(_input))">
                        <LucideArrowUpCn Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Resize handle *@
        <div class="flex w-3 shrink-0 cursor-col-resize items-center justify-center bg-muted/30 transition-colors hover:bg-muted/60">
            <LucideGripVerticalCn Size="16" Class="size-4 text-muted-foreground/50" />
        </div>

        @* Canvas panel *@
        <div class="flex min-w-0 flex-1 flex-col">
            @* Toolbar *@
            <div class="flex items-center gap-1 border-b px-4 py-3">
                <ButtonCn Class="size-7 p-0 text-muted-foreground hover:text-foreground" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm">
                    <LucideBoldCn Size="16" Class="size-3.5" />
                </ButtonCn>
                <ButtonCn Class="size-7 p-0 text-muted-foreground hover:text-foreground" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm">
                    <LucideItalicCn Size="16" Class="size-3.5" />
                </ButtonCn>
                <ButtonCn Class="size-7 p-0 text-muted-foreground hover:text-foreground" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm">
                    <LucideCodeCn Size="16" Class="size-3.5" />
                </ButtonCn>
                <ButtonCn Class="size-7 p-0 text-muted-foreground hover:text-foreground" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm">
                    <LucidePlusCn Size="16" Class="size-3.5" />
                </ButtonCn>
                <SeparatorCn Orientation="Orientation.Vertical" Class="mx-1 h-4" />
                <ButtonCn Class="h-7 gap-1.5 text-xs text-muted-foreground hover:text-foreground" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm">
                    AI Edit
                </ButtonCn>
            </div>

            @* Canvas content *@
            <div class="flex-1 overflow-y-auto">
                <div class="mx-auto max-w-2xl px-6 py-6">
                    <p class="mb-1 text-sm font-semibold">@_canvas.Title</p>
                    <p class="mb-6 text-xs text-muted-foreground">@_canvas.Subtitle</p>

                    @foreach (var sec in _canvas.Sections)
                    {
                        <div class="mb-5">
                            <p class="mb-1.5 text-sm font-medium">@sec.Heading</p>
                            @if (!string.IsNullOrEmpty(sec.Body))
                            {
                                <p class="text-sm leading-relaxed text-muted-foreground">@sec.Body</p>
                            }
                            @if (sec.Items != null)
                            {
                                <ul class="space-y-1 pl-0">
                                    @foreach (var item in sec.Items)
                                    {
                                        <li class="flex items-start gap-2 text-sm leading-relaxed text-muted-foreground">
                                            <span class="mt-2 size-1.5 shrink-0 rounded-full bg-foreground/20"></span>
                                            @item
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    }

                    @* CTA *@
                    <div class="mt-6 rounded-md bg-muted/50 p-4 text-center">
                        <p class="mb-2 text-sm font-medium">Ready to see what your data is hiding?</p>
                        <ButtonCn Class="h-7 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                            Start free trial
                        </ButtonCn>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Role, string Content);
    private record CanvasSection(string Heading, string? Body = null, string[]? Items = null);
    private record CanvasContent(string Title, string Subtitle, CanvasSection[] Sections);

    private static readonly ChatMessage[] _messages =
    {
        new("1", "user", "Write a product launch announcement for our new AI analytics dashboard."),
        new("2", "assistant", "I've drafted a product launch announcement on the canvas. It includes a headline, key features section, social proof quote, and a clear call-to-action. Want me to adjust the tone or add more details?"),
        new("3", "user", "Make the headline more exciting and add a section about pricing."),
        new("4", "assistant", "Updated! The headline now has more energy, and I've added a pricing section with your three tiers. The canvas reflects the latest version.")
    };

    private static readonly CanvasContent _canvas = new(
        "Introducing Meridian AI: Your Data Just Got Superpowers",
        "The analytics dashboard that thinks for you",
        new CanvasSection[]
        {
            new("See what you've been missing",
                Body: "Meridian AI analyzes your business data in real time, surfacing insights you'd never find manually. From revenue anomalies to customer behavior patterns, get answers in seconds \u2014 not spreadsheets."),
            new("Key Features",
                Items: new[]
                {
                    "Natural language queries \u2014 ask questions in plain English",
                    "Predictive analytics \u2014 forecast trends before they happen",
                    "Automated reports \u2014 daily, weekly, and monthly insights delivered to your inbox",
                    "200+ integrations \u2014 connect every data source in your stack"
                }),
            new("Simple, transparent pricing",
                Items: new[]
                {
                    "Starter \u2014 $49/mo for up to 10K events",
                    "Growth \u2014 $149/mo for up to 100K events",
                    "Enterprise \u2014 Custom pricing with dedicated support"
                }),
            new("What our beta users say",
                Body: "\u201cMeridian AI cut our reporting time from 4 hours to 4 minutes. It's not just faster \u2014 it finds patterns we never would have spotted ourselves.\u201d \u2014 Sarah Chen, VP of Data at Lattice")
        });

    private string _input = "";
}
