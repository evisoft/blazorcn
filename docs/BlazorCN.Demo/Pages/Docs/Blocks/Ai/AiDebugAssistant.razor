@* ===========================================================
   Block: ai-debug-assistant
   Title: Ai Debug Assistant
   Description: React AI debug assistant block for Next.js with error input, root cause analysis, suggested fix with code, severity badge, and confidence meter using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn, TextareaCn
   Source: original/blocks/ai/ai-debug-assistant.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Error input *@
        <div class="border-b px-4 py-3">
            <textarea @bind="_errorInput"
                placeholder="Paste your error message or stack trace..."
                rows="5"
                class="w-full resize-none border-0 bg-transparent p-0 font-mono text-xs shadow-none focus-visible:ring-0"></textarea>
        </div>

        @* Action bar *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 shrink-0 text-xs">
                Analyze
            </ButtonCn>
            <span class="text-muted-foreground text-xs">
                Paste a stack trace or error message
            </span>
        </div>

        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="@Cn.Merge("font-semibold text-2xl tabular-nums", _confidenceColor)">
                    @(_analysis.Confidence)%
                </span>
                <span class="text-muted-foreground text-xs">confidence</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_severityLabel[_analysis.Severity]
            </BadgeCn>
            <div class="ml-auto flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="@Cn.Merge("size-1.5 rounded-full", _severityDot[_analysis.Severity])"></span>
                @_analysis.Severity
            </div>
        </div>

        @* Root cause *@
        <div class="@(_expanded == "root-cause" ? "" : "border-b")">
            <button
                type="button"
                @onclick="@(() => _expanded = _expanded == "root-cause" ? null : "root-cause")"
                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">Root cause</span>
                    <p class="mt-0.5 truncate text-muted-foreground text-xs">
                        @_analysis.RootCause
                    </p>
                </div>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _expanded == "root-cause" ? "rotate-90" : "")" />
            </button>
            @if (_expanded == "root-cause")
            {
                <div class="border-b px-4 pb-4 pl-9">
                    <p class="mb-3 text-muted-foreground text-sm leading-relaxed">
                        @_analysis.Explanation
                    </p>
                </div>
            }
        </div>

        @* Suggested fix *@
        <div class="@(_expanded == "fix" ? "" : "border-b")">
            <button
                type="button"
                @onclick="@(() => _expanded = _expanded == "fix" ? null : "fix")"
                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <span class="size-2 shrink-0 rounded-full bg-emerald-500"></span>
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">Suggested fix</span>
                    <p class="mt-0.5 truncate text-muted-foreground text-xs">
                        @_analysis.SuggestedFix
                    </p>
                </div>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _expanded == "fix" ? "rotate-90" : "")" />
            </button>
            @if (_expanded == "fix")
            {
                <div class="border-b px-4 pb-4 pl-9">
                    <p class="mb-3 text-muted-foreground text-sm leading-relaxed">
                        @_analysis.SuggestedFix
                    </p>
                    <div class="relative rounded-md bg-zinc-950 p-3">
                        <pre class="overflow-x-auto font-mono text-xs leading-relaxed text-zinc-300"><code>@_codeSnippet</code></pre>
                        <ButtonCn
                            Variant="ButtonVariant.Ghost"
                            Size="ButtonSize.Sm"
                            class="absolute top-2 right-2 h-6 gap-1 px-2 text-xs text-zinc-500 hover:text-zinc-300">
                            @if (_copied == "code")
                            {
                                <LucideCheckCn Size="12" Class="size-3" />
                                <span>Copied</span>
                            }
                            else
                            {
                                <LucideCopyCn Size="12" Class="size-3" />
                                <span>Copy</span>
                            }
                        </ButtonCn>
                    </div>
                </div>
            }
        </div>

        @* Prevention tips *@
        <div class="@(_expanded == "prevention" ? "" : "border-b")">
            <button
                type="button"
                @onclick="@(() => _expanded = _expanded == "prevention" ? null : "prevention")"
                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <span class="size-2 shrink-0 rounded-full bg-blue-500"></span>
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">Prevention tips</span>
                    <p class="mt-0.5 text-muted-foreground text-xs">
                        @_analysis.PreventionTips.Length recommendations
                    </p>
                </div>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _expanded == "prevention" ? "rotate-90" : "")" />
            </button>
            @if (_expanded == "prevention")
            {
                <div class="border-b px-4 pb-4 pl-9">
                    <ul class="space-y-2">
                        @foreach (var tip in _analysis.PreventionTips)
                        {
                            <li class="flex items-start gap-2.5 text-sm leading-relaxed">
                                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                <span class="text-muted-foreground">@tip</span>
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Similar issues *@
        <div class="px-4 py-3">
            <span class="font-medium text-muted-foreground text-xs">Similar issues</span>
            <div class="mt-2 space-y-1.5">
                @foreach (var issue in _analysis.SimilarIssues)
                {
                    <a
                        href="@issue.Href"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="flex items-center gap-2 rounded-md p-1.5 text-sm transition-colors hover:bg-muted/50">
                        <LucideExternalLinkCn Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        <span class="truncate">@issue.Title</span>
                    </a>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record SimilarIssue(string Title, string Href);
    private record DebugAnalysis(string Severity, int Confidence, string RootCause, string Explanation, string SuggestedFix, string[] PreventionTips, SimilarIssue[] SimilarIssues);

    private static readonly Dictionary<string, string> _severityDot = new()
    {
        ["critical"] = "bg-red-500",
        ["high"] = "bg-amber-500",
        ["medium"] = "bg-blue-500",
        ["low"] = "bg-emerald-500",
    };

    private static readonly Dictionary<string, string> _severityLabel = new()
    {
        ["critical"] = "Critical",
        ["high"] = "High",
        ["medium"] = "Medium",
        ["low"] = "Low",
    };

    private static readonly string _sampleError = @"TypeError: Cannot read properties of undefined (reading 'map')
    at ProductList (webpack-internal:///./src/components/ProductList.tsx:18:24)
    at renderWithHooks (webpack-internal:///./node_modules/react-dom/cjs/react-dom.development.js:16305:18)
    at mountIndeterminateComponent (webpack-internal:///./node_modules/react-dom/cjs/react-dom.development.js:20074:13)
    at beginWork (webpack-internal:///./node_modules/react-dom/cjs/react-dom.development.js:21587:16)
    at HTMLUnknownElement.callCallback (webpack-internal:///./node_modules/react-dom/cjs/react-dom.development.js:4164:14)";

    private static readonly string _codeSnippet = @"// Before (broken)
function ProductList({ products }) {
  return products.map(p => <ProductCard key={p.id} {...p} />)
}

// After (fixed)
function ProductList({ products }) {
  if (!products) return <LoadingSkeleton />
  return products.map(p => <ProductCard key={p.id} {...p} />)
}

// Alternative: Default parameter
function ProductList({ products = [] }) {
  return products.map(p => <ProductCard key={p.id} {...p} />)
}";

    private static readonly DebugAnalysis _analysis = new(
        "high", 94,
        "Undefined data access before async fetch completes",
        "The component is trying to call .map() on a variable that is undefined. This typically happens when a component renders before its data has been fetched from an API. The ProductList component at line 18 is accessing a property that hasn't been initialized yet, likely the result of a useEffect or data fetching hook that hasn't resolved.",
        "Add a null check or provide a default empty array for the data before calling .map(). Use optional chaining or a loading state to prevent rendering before data is available.",
        [
            "Always initialize state with a sensible default value",
            "Use TypeScript to enforce non-nullable types",
            "Add loading and error states to async data flows",
            "Consider using React Suspense for data fetching",
        ],
        [
            new("React: Cannot read property 'map' of undefined", "https://stackoverflow.com/questions/24706267"),
            new("Handling undefined state in React components", "https://react.dev/learn/managing-state"),
            new("TypeScript strict null checks guide", "https://www.typescriptlang.org/docs/handbook/2/narrowing.html"),
        ]
    );

    private string _confidenceColor => _analysis.Confidence >= 90
        ? "text-emerald-600 dark:text-emerald-400"
        : _analysis.Confidence >= 70
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";

    private string _errorInput = _sampleError;
    private string? _expanded = "root-cause";
    private string? _copied = null;
}
