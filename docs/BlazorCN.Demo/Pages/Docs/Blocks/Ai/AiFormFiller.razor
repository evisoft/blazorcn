@* ===========================================================
   Block: ai-form-filler
   Title: Ai Form Filler
   Description: AI form auto-fill with AI-generated field values, regenerate controls, and visual indicators
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideRefreshCcwCn, SelectCn
   Source: original/blocks/ai/ai-form-filler.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-sm font-medium">Company information</span>
                <p class="text-xs text-muted-foreground">Fill in your company details</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs"
                      Disabled="@_isAutoFilling"
                      @onclick="SimulateAutoFill">
                @if (_isAutoFilling)
                {
                    <LucideRefreshCcwCn Size="16" Class="mr-1.5 size-3 animate-spin" />
                    <text>Filling...</text>
                }
                else
                {
                    <text>Auto-fill with AI</text>
                }
            </ButtonCn>
        </div>

        @if (_aiFilledFields.Count > 0)
        {
            <div class="border-b px-4 py-2">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 text-xs font-normal">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @_aiFilledFields.Count fields auto-filled
                </BadgeCn>
            </div>
        }

        @* Company name *@
        <div class="border-b px-4 py-3">
            <div class="mb-1.5 flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    Company name
                    @if (_aiFilledFields.Contains("companyName"))
                    {
                        <span class="size-1 rounded-full bg-blue-500"></span>
                    }
                </span>
                @if (_aiFilledFields.Contains("companyName"))
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 gap-1 px-1 text-xs text-muted-foreground hover:text-foreground"
                              @onclick="@(() => RegenerateField("companyName"))">
                        <LucideRefreshCcwCn Size="16" Class="size-2.5" />
                    </ButtonCn>
                }
            </div>
            <InputCn @bind-Value="_companyName"
                     Placeholder="Enter company name"
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
        </div>

        @* Industry + Size *@
        <div class="grid grid-cols-2 border-b">
            <div class="border-r px-4 py-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    Industry
                    @if (_aiFilledFields.Contains("industry"))
                    {
                        <span class="size-1 rounded-full bg-blue-500"></span>
                    }
                </span>
                <SelectCn TValue="string" Value="@_industry" ValueChanged="v => _industry = v">
                    <SelectTriggerCn Class="mt-1.5 h-8 border-0 bg-transparent px-0 shadow-none">
                        <SelectValueCn Placeholder="Select industry" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="@("saas")">SaaS / Software</SelectItemCn>
                        <SelectItemCn Value="@("data-analytics")">Data and Analytics</SelectItemCn>
                        <SelectItemCn Value="@("fintech")">Fintech</SelectItemCn>
                        <SelectItemCn Value="@("healthcare")">Healthcare</SelectItemCn>
                        <SelectItemCn Value="@("ecommerce")">E-Commerce</SelectItemCn>
                        <SelectItemCn Value="@("education")">Education</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
            <div class="px-4 py-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    Company size
                    @if (_aiFilledFields.Contains("companySize"))
                    {
                        <span class="size-1 rounded-full bg-blue-500"></span>
                    }
                </span>
                <SelectCn TValue="string" Value="@_companySize" ValueChanged="v => _companySize = v">
                    <SelectTriggerCn Class="mt-1.5 h-8 border-0 bg-transparent px-0 shadow-none">
                        <SelectValueCn Placeholder="Select size" />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="@("1-10")">1-10 employees</SelectItemCn>
                        <SelectItemCn Value="@("11-50")">11-50 employees</SelectItemCn>
                        <SelectItemCn Value="@("51-200")">51-200 employees</SelectItemCn>
                        <SelectItemCn Value="@("201-1000")">201-1,000 employees</SelectItemCn>
                        <SelectItemCn Value="@("1000+")">1,000+ employees</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
            </div>
        </div>

        @* Website *@
        <div class="border-b px-4 py-3">
            <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                Website
                @if (_aiFilledFields.Contains("website"))
                {
                    <span class="size-1 rounded-full bg-blue-500"></span>
                }
            </span>
            <InputCn @bind-Value="_website"
                     Placeholder="https://example.com"
                     Class="mt-1.5 h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
        </div>

        @* Tagline *@
        <div class="border-b px-4 py-3">
            <div class="mb-1.5 flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    Tagline
                    @if (_aiFilledFields.Contains("tagline"))
                    {
                        <span class="size-1 rounded-full bg-blue-500"></span>
                    }
                </span>
                @if (_aiFilledFields.Contains("tagline"))
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 gap-1 px-1 text-xs text-muted-foreground hover:text-foreground"
                              @onclick="@(() => RegenerateField("tagline"))">
                        <LucideRefreshCcwCn Size="16" Class="size-2.5" />
                    </ButtonCn>
                }
            </div>
            <InputCn @bind-Value="_tagline"
                     Placeholder="A short tagline for your company"
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
        </div>

        @* Description *@
        <div class="border-b px-4 py-3">
            <div class="mb-1.5 flex items-center justify-between">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    Description
                    @if (_aiFilledFields.Contains("description"))
                    {
                        <span class="size-1 rounded-full bg-blue-500"></span>
                    }
                </span>
                @if (_aiFilledFields.Contains("description"))
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-5 gap-1 px-1 text-xs text-muted-foreground hover:text-foreground"
                              @onclick="@(() => RegenerateField("description"))">
                        <LucideRefreshCcwCn Size="16" Class="size-2.5" />
                    </ButtonCn>
                }
            </div>
            <textarea class="w-full resize-none border-0 bg-transparent p-0 text-sm shadow-none focus:outline-none focus-visible:ring-0"
                      rows="4"
                      placeholder="Describe what your company does..."
                      @bind="_description"></textarea>
        </div>

        @* Actions *@
        <div class="flex items-center justify-end gap-2 px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground"
                      @onclick="HandleClear">
                Clear
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                Save
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private string _companyName = "";
    private string _industry = "";
    private string _companySize = "";
    private string _website = "";
    private string _tagline = "";
    private string _description = "";
    private bool _isAutoFilling;
    private readonly HashSet<string> _aiFilledFields = new();

    private static readonly Dictionary<string, string[]> _alternatives = new()
    {
        ["companyName"] = new[] { "Meridian Analytics", "DataPulse AI", "Northstar Insights" },
        ["tagline"] = new[] { "Turn data into decisions. Automatically.", "Intelligent analytics for modern teams.", "Your data, amplified by AI." },
        ["description"] = new[]
        {
            "Meridian Analytics is a B2B SaaS platform that transforms raw business data into actionable intelligence. Our AI-powered dashboard provides real-time insights, predictive analytics, and automated reporting for mid-market companies. Founded in 2023, we serve 400+ customers across financial services, healthcare, and retail sectors.",
            "We build AI-first analytics tools that help growing companies make smarter, faster decisions. Our platform integrates with 200+ data sources and delivers insights in natural language, no SQL required.",
            "Meridian Analytics empowers product, marketing, and finance teams with self-serve analytics powered by large language models. Ask questions in plain English and get charts, reports, and recommendations instantly."
        }
    };

    private async Task SimulateAutoFill()
    {
        _isAutoFilling = true;
        StateHasChanged();
        await Task.Delay(800);
        _companyName = "Meridian Analytics";
        _industry = "data-analytics";
        _companySize = "51-200";
        _website = "https://meridiananalytics.com";
        _tagline = "Turn data into decisions. Automatically.";
        _description = "Meridian Analytics is a B2B SaaS platform that transforms raw business data into actionable intelligence. Our AI-powered dashboard provides real-time insights, predictive analytics, and automated reporting for mid-market companies. Founded in 2023, we serve 400+ customers across financial services, healthcare, and retail sectors.";
        _aiFilledFields.UnionWith(new[] { "companyName", "industry", "companySize", "website", "tagline", "description" });
        _isAutoFilling = false;
    }

    private void RegenerateField(string field)
    {
        if (!_alternatives.TryGetValue(field, out var options)) return;
        var current = field switch
        {
            "companyName" => _companyName,
            "tagline" => _tagline,
            "description" => _description,
            _ => ""
        };
        var currentIndex = Array.IndexOf(options, current);
        var nextIndex = (currentIndex + 1) % options.Length;
        switch (field)
        {
            case "companyName": _companyName = options[nextIndex]; break;
            case "tagline": _tagline = options[nextIndex]; break;
            case "description": _description = options[nextIndex]; break;
        }
    }

    private void HandleClear()
    {
        _companyName = "";
        _industry = "";
        _companySize = "";
        _website = "";
        _tagline = "";
        _description = "";
        _aiFilledFields.Clear();
    }
}
