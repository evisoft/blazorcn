@* ===========================================================
   Block: ai-email-composer
   Title: Ai Email Composer
   Description: AI email composition with recipient fields, tone selector, AI-generated body, refinement buttons, and preview toggle
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideSendCn, SelectCn
   Source: original/blocks/ai/ai-email-composer.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* To field *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <span class="text-xs text-muted-foreground">To</span>
            <InputCn @bind-Value="_to"
                     Placeholder="@RecipientPlaceholder"
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" aria-label="@RecipientPlaceholder" />
        </div>

        @* Subject field *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <span class="text-xs text-muted-foreground">Subject</span>
            <InputCn @bind-Value="_subject"
                     Placeholder="Email subject line"
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" aria-label="Email subject line" />
        </div>

        @* Controls bar *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <SelectCn Value="@_tone" ValueChanged="v => _tone = v">
                <SelectTriggerCn aria-label="Tone" Class="h-7 w-[130px] border-0 bg-muted/50 text-xs shadow-none">
                    <SelectValueCn Placeholder="Tone" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="@("professional")">Professional</SelectItemCn>
                    <SelectItemCn Value="@("friendly")">Friendly</SelectItemCn>
                    <SelectItemCn Value="@("urgent")">Urgent</SelectItemCn>
                    <SelectItemCn Value="@("persuasive")">Persuasive</SelectItemCn>
                </SelectContentCn>
            </SelectCn>

            <div class="ml-auto flex items-center gap-1">
                <button type="button"
                        class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _tab == "compose" ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _tab = "compose")">
                    Compose
                </button>
                <button type="button"
                        class="@Cn.Merge("rounded-md px-2.5 py-1 text-xs transition-colors", _tab == "preview" ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:text-foreground")"
                        @onclick="@(() => _tab = "preview")">
                    Preview
                </button>
            </div>
        </div>

        @* Body *@
        @if (_tab == "compose")
        {
            <div class="px-4 py-3">
                <TextareaCn @bind-Value="_body"
                            rows="16"
                            Class="resize-none leading-relaxed" aria-label="Email body" />
            </div>
        }
        else
        {
            <div class="px-4 py-4">
                <div class="space-y-1 text-xs text-muted-foreground">
                    <p><span class="font-medium">To:</span> @_to</p>
                    <p><span class="font-medium">Subject:</span> @_subject</p>
                </div>
                <div class="mt-3 border-t pt-3">
                    <div class="whitespace-pre-wrap text-sm leading-relaxed">@_body</div>
                </div>
            </div>
        }

        @* Refinement chips *@
        <div class="flex flex-wrap items-center gap-2 border-t px-4 py-3">
            <span class="text-xs text-muted-foreground">Refine:</span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Make shorter</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">More formal</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Add CTA</ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Fix grammar</ButtonCn>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-xs text-muted-foreground">@WordCount words</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 text-xs font-normal">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Draft saved
                </BadgeCn>
            </div>
            <div class="flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">Save draft</ButtonCn>
                <ButtonCn Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                    <LucideSendCn Size="16" Class="size-3" />
                    Send
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private const string RecipientPlaceholder = "recipient@@example.com";

    private string _to = "sarah.chen@@acmecorp.com";
    private string _subject = "Follow-up: Engineering Platform Demo \u2014 Next Steps";
    private string _tone = "professional";
    private string _tab = "compose";

    private string _body = @"Hi Sarah,

Thank you for taking the time to meet with our team last Thursday. It was great discussing how our platform can help streamline your engineering workflow.

As promised, I wanted to follow up with a summary of the key points we covered:

1. Automated CI/CD pipelines — Our platform can reduce your deployment time from 45 minutes to under 5 minutes, based on similar implementations we've done for teams your size.

2. Real-time monitoring — The built-in observability suite includes error tracking, performance metrics, and custom dashboards without additional tooling costs.

3. Team collaboration — Shared environments and preview deployments for every pull request, enabling faster code reviews.

I've attached a case study from a company similar to yours that saw a 60% reduction in developer toil after adopting our platform.

Would you be available for a 30-minute follow-up call next week to discuss next steps? I have availability on Tuesday or Wednesday afternoon.

Looking forward to hearing from you.

Best regards,
Alex Thompson
Senior Account Executive";

    private int WordCount => _body.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;
}
