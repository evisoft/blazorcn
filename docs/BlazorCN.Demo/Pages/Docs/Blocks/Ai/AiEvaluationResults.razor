@* ===========================================================
   Block: ai-evaluation-results
   Title: Ai Evaluation Results
   Description: AI model evaluation results with score table, pass rate summary, and capability breakdown
   Dependencies: BadgeCn, LucideChevronRightCn
   Source: original/blocks/ai/ai-evaluation-results.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="@Cn.Merge("text-2xl font-semibold tabular-nums", GetScoreColor(AvgScore))">
                    @(AvgScore)%
                </span>
                <span class="text-xs text-muted-foreground">avg</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                Claude Sonnet 4
            </BadgeCn>
            <span class="text-xs text-muted-foreground">&middot;</span>
            <span class="text-xs text-muted-foreground">@_evalTasks.Length tasks</span>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @PassCount pass
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @(_evalTasks.Length - PassCount) fail
                </span>
            </div>
        </div>

        @* Pass rate bar *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="text-xs text-muted-foreground">Pass rate</span>
            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                <div class="h-full rounded-full bg-emerald-500 transition-all"
                     style="@($"width: {PassRate}%")"></div>
            </div>
            <span class="font-mono text-xs text-muted-foreground">@(PassRate)%</span>
        </div>

        @* Tasks *@
        <div>
            @for (var i = 0; i < _evalTasks.Length; i++)
            {
                var task = _evalTasks[i];
                var isExpanded = _expanded == task.Id;
                var isLast = i == _evalTasks.Length - 1;
                var taskId = task.Id;
                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : taskId)">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", task.Pass ? "bg-emerald-500" : "bg-red-500")"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@task.Task</span>
                        </div>
                        <span class="font-mono text-xs text-muted-foreground">
                            @((int)Math.Round(task.Score * 100))%
                        </span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <span class="text-xs font-medium text-muted-foreground">Expected</span>
                                        <p class="mt-1 font-mono text-xs">@task.Expected</p>
                                    </div>
                                    <div>
                                        <span class="text-xs font-medium text-muted-foreground">Actual</span>
                                        <p class="mt-1 font-mono text-xs">@task.Actual</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Capabilities *@
        <div class="border-t px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Capabilities</span>
            <div class="mt-2 grid grid-cols-3 gap-x-4 gap-y-2">
                @foreach (var cap in _capabilities)
                {
                    <div class="flex items-baseline justify-between">
                        <span class="text-xs text-muted-foreground">@cap.Name</span>
                        <span class="@Cn.Merge("text-sm font-semibold tabular-nums", GetScoreColor(cap.Score))">
                            @cap.Score
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record EvalTask(string Id, string Task, double Score, bool Pass, string Expected, string Actual);
    private record Capability(string Name, int Score);

    private static readonly EvalTask[] _evalTasks =
    {
        new("1", "Arithmetic Reasoning", 0.92, true, "42", "42"),
        new("2", "Code Generation (Python)", 0.88, true, "def factorial(n)...", "def factorial(n)..."),
        new("3", "Summarization", 0.76, true, "Key points extracted", "Key points extracted"),
        new("4", "Translation (EN to FR)", 0.81, true, "Bonjour le monde", "Bonjour le monde"),
        new("5", "Sentiment Analysis", 0.95, true, "Negative", "Negative"),
        new("6", "Entity Extraction", 0.62, false, "3 entities found", "2 entities found"),
        new("7", "Logical Deduction", 0.58, false, "Conclusion B", "Conclusion A"),
        new("8", "Creative Writing", 0.84, true, "Coherent narrative", "Coherent narrative")
    };

    private static readonly Capability[] _capabilities =
    {
        new("Reasoning", 82),
        new("Coding", 88),
        new("Language", 79),
        new("Math", 92),
        new("Creativity", 84),
        new("Accuracy", 76)
    };

    private string? _expanded = "6";

    private static int PassCount => _evalTasks.Count(t => t.Pass);
    private static int PassRate => (int)Math.Round((double)PassCount / _evalTasks.Length * 100);
    private static int AvgScore => (int)Math.Round(_evalTasks.Average(t => t.Score) * 100);

    private static string GetScoreColor(int score) => score >= 80
        ? "text-emerald-600 dark:text-emerald-400"
        : score >= 60
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";
}
