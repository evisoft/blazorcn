@* ===========================================================
   Block: ai-message-with-steps
   Title: Ai Message With Steps
   Description: AI message with numbered step-by-step guide, connected timeline, code snippets, and step cards
   Dependencies: ButtonCn, LucideCheckCn, LucideChevronRightCn, LucideCopyCn
   Source: original/blocks/ai/ai-message-with-steps.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm font-medium">SaaS setup guide</span>
            <span class="text-xs text-muted-foreground">@_steps.Length steps</span>
        </div>

        @* Steps *@
        <div>
            @for (var i = 0; i < _steps.Length; i++)
            {
                var step = _steps[i];
                var isExpanded = _expanded == step.Number;
                var isLast = i == _steps.Length - 1;
                var stepNum = step.Number;
                <div class="@(!isLast ? "border-b" : "")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : stepNum)">
                        <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted font-mono text-[11px] text-muted-foreground">
                            @step.Number
                        </span>
                        <span class="min-w-0 flex-1 text-sm font-medium">@step.Title</span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-13">
                            <p class="mb-3 text-sm leading-relaxed text-muted-foreground">
                                @step.Description
                            </p>
                            @if (step.Code != null)
                            {
                                <div class="overflow-hidden rounded-md bg-zinc-950">
                                    <div class="flex items-center justify-between px-3 py-1.5">
                                        <span class="font-mono text-[10px] text-zinc-500">code</span>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                                  Class="h-6 gap-1 px-2 text-xs text-zinc-400 hover:text-zinc-200"
                                                  @onclick="@(() => HandleCopy(stepNum))">
                                            @if (_copied == stepNum)
                                            {
                                                <LucideCheckCn Size="16" Class="size-3" />
                                                <text>Copied</text>
                                            }
                                            else
                                            {
                                                <LucideCopyCn Size="16" Class="size-3" />
                                                <text>Copy</text>
                                            }
                                        </ButtonCn>
                                    </div>
                                    <pre class="overflow-x-auto px-3 pb-3 font-mono text-[11px] leading-5 text-zinc-300"><code>@step.Code</code></pre>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <span class="size-1.5 rounded-full bg-emerald-500"></span>
            <span class="text-xs text-muted-foreground">
                All 5 steps complete. Run <code class="font-mono text-foreground">npm run dev</code> to start building.
            </span>
        </div>
    </div>
</section>

@code {
    private record StepData(int Number, string Title, string Description, string? Code);

    private static readonly StepData[] _steps =
    {
        new(1, "Initialize your Next.js project",
            "Start by creating a new Next.js application with the App Router and TypeScript enabled.",
            "npx create-next-app@@latest my-saas \\\n  --typescript --tailwind --eslint \\\n  --app --src-dir --import-alias \"~/*\""),
        new(2, "Install your database and ORM",
            "Add Prisma as your ORM and configure it with PostgreSQL for type-safe database queries.",
            "npm install prisma @@prisma/client\nnpx prisma init --datasource-provider postgresql"),
        new(3, "Define your data model",
            "Create your Prisma schema with User, Subscription, and Product models for SaaS foundations.",
            "model User {\n  id        String   @@id @@default(cuid())\n  email     String   @@unique\n  name      String?\n  plan      Plan     @@default(FREE)\n  createdAt DateTime @@default(now())\n}\n\nenum Plan {\n  FREE\n  PRO\n  ENTERPRISE\n}"),
        new(4, "Set up authentication",
            "Add NextAuth.js for secure authentication with Google and GitHub OAuth providers.",
            "import NextAuth from \"next-auth\"\nimport Google from \"next-auth/providers/google\"\nimport GitHub from \"next-auth/providers/github\"\n\nexport const { handlers, auth } = NextAuth({\n  providers: [Google, GitHub],\n})"),
        new(5, "Add Stripe for payments",
            "Integrate Stripe Checkout for subscription billing with webhook sync for instant access.",
            "const session = await stripe.checkout.sessions.create({\n  mode: \"subscription\",\n  line_items: [{\n    price: process.env.STRIPE_PRICE_ID,\n    quantity: 1,\n  }],\n  success_url: `${baseUrl}/dashboard`,\n  cancel_url: `${baseUrl}/pricing`,\n})")
    };

    private int? _expanded = 1;
    private int? _copied;

    private async Task HandleCopy(int stepNum)
    {
        _copied = stepNum;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = null;
    }
}
