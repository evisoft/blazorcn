@* ===========================================================
   Block: ai-interview-coach
   Title: Ai Interview Coach
   Description: React AI interview coach block for Next.js with mock interview questions, response textarea, AI feedback with strengths and improvements, and scoring using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn, TextareaCn
   Source: original/blocks/ai/ai-interview-coach.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="font-medium text-sm">Interview Coach</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    @_question.Category
                </BadgeCn>
            </div>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", _difficultyDot[_question.Difficulty])"></span>
                    @_question.Difficulty
                </span>
                <span class="text-muted-foreground text-xs">
                    @(_currentQuestion + 1)/@_questions.Length
                </span>
            </div>
        </div>

        @* Question *@
        <div class="border-b px-4 py-3">
            <span class="mb-1 block font-medium text-muted-foreground text-xs">Question</span>
            <p class="text-sm leading-relaxed">@_question.Question</p>
        </div>

        @* Response area *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="font-medium text-muted-foreground text-xs">Your response</span>
                <span class="text-muted-foreground text-xs">
                    @if (_response.Length > 0)
                    {
                        @($"{_response.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length} words")
                    }
                    else
                    {
                        <text>Start typing</text>
                    }
                </span>
            </div>
            <TextareaCn @bind-Value="_response"
                Placeholder="Type your answer here... Use the STAR method (Situation, Task, Action, Result) for behavioral questions."
                rows="4"
                Class="resize-none px-0" aria-label="Type your answer here... Use the STAR method (Situation, Task, Action, Result) for behavioral questions." />
            <div class="mt-2 flex items-center justify-end gap-2">
                <ButtonCn
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.Sm"
                    class="h-7 gap-1 text-xs">
                    Skip
                    <LucideArrowRightCn Size="12" Class="size-3" />
                </ButtonCn>
                <ButtonCn
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.Sm"
                    class="h-7 gap-1 text-xs"
                    Disabled="@(string.IsNullOrWhiteSpace(_response))">
                    <LucideSendCn Size="12" Class="size-3" />
                    Submit
                </ButtonCn>
            </div>
        </div>

        @* Score row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="@Cn.Merge("font-semibold text-2xl tabular-nums", _scoreColor)">
                    @_feedback.Score
                </span>
                <span class="text-muted-foreground text-xs">/10</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_assessment
            </BadgeCn>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">
                @_feedback.Strengths.Length strengths
            </span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">
                @_feedback.Improvements.Length to improve
            </span>
        </div>

        @* Strengths *@
        <div class="border-b">
            <button
                type="button"
                @onclick="@(() => _expanded = _expanded == "strengths" ? null : "strengths")"
                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <span class="size-2 shrink-0 rounded-full bg-emerald-500"></span>
                <span class="flex-1 font-medium text-sm">Strengths</span>
                <span class="text-muted-foreground text-xs">@_feedback.Strengths.Length</span>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _expanded == "strengths" ? "rotate-90" : "")" />
            </button>
            @if (_expanded == "strengths")
            {
                <div class="px-4 pb-3 pl-9">
                    <ul class="space-y-1.5">
                        @foreach (var s in _feedback.Strengths)
                        {
                            <li class="flex items-start gap-2 text-sm text-muted-foreground">
                                <span class="mt-2 size-1 shrink-0 rounded-full bg-emerald-500"></span>
                                @s
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Improvements *@
        <div class="border-b">
            <button
                type="button"
                @onclick="@(() => _expanded = _expanded == "improvements" ? null : "improvements")"
                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                <span class="flex-1 font-medium text-sm">Improvements</span>
                <span class="text-muted-foreground text-xs">
                    @_feedback.Improvements.Length
                </span>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _expanded == "improvements" ? "rotate-90" : "")" />
            </button>
            @if (_expanded == "improvements")
            {
                <div class="px-4 pb-3 pl-9">
                    <ul class="space-y-1.5">
                        @foreach (var imp in _feedback.Improvements)
                        {
                            <li class="flex items-start gap-2 text-sm text-muted-foreground">
                                <span class="mt-2 size-1 shrink-0 rounded-full bg-amber-500"></span>
                                @imp
                            </li>
                        }
                    </ul>
                </div>
            }
        </div>

        @* Model answer *@
        <div class="px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center justify-between">
                    <span class="font-medium text-muted-foreground text-xs">Model answer</span>
                    <ButtonCn
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Sm"
                        class="h-6 gap-1 px-2 text-xs">
                        @if (_copied)
                        {
                            <LucideCheckCn Size="12" Class="size-3" />
                            <span>Copied</span>
                        }
                        else
                        {
                            <LucideCopyCn Size="12" Class="size-3" />
                            <span>Copy</span>
                        }
                    </ButtonCn>
                </div>
                <p class="text-sm leading-relaxed">@_feedback.ModelAnswer</p>
            </div>
            <div class="mt-3 flex justify-end">
                <ButtonCn
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.Sm"
                    class="h-7 gap-1 text-xs">
                    Next question
                    <LucideArrowRightCn Size="12" Class="size-3" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record InterviewQuestion(string Category, string Question, string Difficulty);
    private record FeedbackData(string[] Strengths, string[] Improvements, int Score, string ModelAnswer);

    private static readonly Dictionary<string, string> _difficultyDot = new()
    {
        ["Easy"] = "bg-emerald-500",
        ["Medium"] = "bg-amber-500",
        ["Hard"] = "bg-red-500",
    };

    private static readonly InterviewQuestion[] _questions =
    [
        new("Behavioral",
            "Tell me about a time when you had to deal with a difficult team member. How did you handle the situation and what was the outcome?",
            "Medium"),
        new("Technical",
            "Explain how you would design a caching strategy for a high-traffic e-commerce platform. What trade-offs would you consider?",
            "Hard"),
        new("Situational",
            "If you were given a project with an impossible deadline, how would you approach it?",
            "Easy"),
    ];

    private static readonly FeedbackData _feedback = new(
        ["Used STAR method effectively", "Specific example provided", "Showed empathy and leadership", "Mentioned measurable outcome"],
        ["Could elaborate on lessons learned", "Add more context about team dynamics", "Quantify the business impact"],
        7,
        "In my previous role as a tech lead at a SaaS startup, I worked with a senior developer who consistently missed sprint deadlines and was dismissive during code reviews. Rather than escalating immediately, I scheduled a private one-on-one to understand their perspective. I discovered they were overwhelmed by unclear requirements from product. I proposed we implement a requirements clarification step before sprint planning and paired with them on their most complex ticket. Within two sprints, their on-time delivery improved from 40% to 85%, and they became one of our most reliable contributors. The experience taught me that most 'difficult' behaviors stem from systemic issues, not personal ones."
    );

    private InterviewQuestion _question => _questions[_currentQuestion];

    private string _scoreColor => _feedback.Score >= 8
        ? "text-emerald-600 dark:text-emerald-400"
        : _feedback.Score >= 5
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";

    private string _assessment => _feedback.Score >= 8 ? "Excellent" : _feedback.Score >= 5 ? "Good foundation" : "Keep practicing";

    private int _currentQuestion = 0;
    private string _response = "In my last role, there was a developer who often pushed back on code review feedback. I scheduled a 1:1 coffee chat to understand their perspective. Turns out they felt their experience wasn't being valued. We agreed on a mutual review process, and within a month our team's PR turnaround time dropped by 40%.";
    private string? _expanded = "strengths";
    private bool _copied = false;
}
