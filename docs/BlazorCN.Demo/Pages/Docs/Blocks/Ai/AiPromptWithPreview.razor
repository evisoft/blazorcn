@* ===========================================================
   Block: ai-prompt-with-preview
   Title: Ai Prompt With Preview
   Description: React AI prompt with preview block for Next.js with split-pane layout showing live formatted preview of the prompt payload using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/ai/ai-prompt-with-preview.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid gap-4 md:grid-cols-2">
        @* Input side *@
        <div class="flex flex-col overflow-hidden rounded-lg border bg-card">
            <div class="flex items-center gap-2 border-b px-4 py-3">
                <LucidePenLineCn Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Compose</span>
                <span class="ml-auto text-muted-foreground text-xs">@_wordCount words</span>
            </div>

            <div class="flex flex-1 flex-col">
                <div class="flex-1 px-4 py-3">
                    <textarea
                        @bind="_input"
                        @bind:event="oninput"
                        placeholder="Write your prompt..."
                        class="h-full min-h-[300px] w-full resize-none border-0 bg-transparent p-0 font-mono text-xs shadow-none outline-none focus:ring-0" />
                </div>

                <div class="flex items-center justify-end border-t px-4 py-3">
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Default" Disabled="@(string.IsNullOrWhiteSpace(_input))" Class="h-7 gap-1.5 text-xs">
                        <LucideArrowUpCn Size="14" Class="size-3.5" />
                        Send
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Preview side *@
        <div class="flex flex-col overflow-hidden rounded-lg border bg-card">
            <div class="flex items-center gap-2 border-b px-4 py-3">
                <LucideEyeCn Size="14" Class="size-3.5 text-muted-foreground" />
                <span class="font-medium text-sm">Preview</span>
            </div>

            <div class="flex-1 overflow-y-auto px-4 py-3">
                @if (string.IsNullOrWhiteSpace(_input))
                {
                    <div class="flex h-full items-center justify-center">
                        <span class="text-muted-foreground text-xs">Start typing to see a preview</span>
                    </div>
                }
                else
                {
                    var inCodeBlock = false;
                    var lines = _input.Split('\n');
                    <div class="space-y-1.5">
                        @for (int i = 0; i < lines.Length; i++)
                        {
                            var line = lines[i];
                            @if (line.StartsWith("```"))
                            {
                                inCodeBlock = !inCodeBlock;
                                @if (inCodeBlock)
                                {
                                    var lang = line.Replace("```", "").Trim();
                                    if (string.IsNullOrEmpty(lang)) lang = "code";
                                    <div class="mt-2 rounded-t-md bg-zinc-950 px-3 py-1.5">
                                        <span class="font-mono text-[10px] text-zinc-500">@lang</span>
                                    </div>
                                }
                                else
                                {
                                    <div class="mb-2 rounded-b-md bg-zinc-950 px-3 py-1"></div>
                                }
                            }
                            else if (inCodeBlock)
                            {
                                <div class="bg-zinc-950 px-3">
                                    <code class="font-mono text-xs text-emerald-400">@line</code>
                                </div>
                            }
                            else if (System.Text.RegularExpressions.Regex.IsMatch(line, @"^#{1,3}\s"))
                            {
                                var match = System.Text.RegularExpressions.Regex.Match(line, @"^(#{1,3})\s");
                                var level = match.Groups[1].Value.Length;
                                var text = System.Text.RegularExpressions.Regex.Replace(line, @"^#{1,3}\s", "");
                                <p class="@Cn.Merge("font-medium", level <= 2 ? "text-sm" : "text-xs text-muted-foreground")">@text</p>
                            }
                            else if (System.Text.RegularExpressions.Regex.IsMatch(line, @"^\s*(\d+\.|-|\*)\s"))
                            {
                                <p class="pl-4 text-sm text-foreground">@line</p>
                            }
                            else if (!string.IsNullOrWhiteSpace(line))
                            {
                                <p class="text-sm text-foreground">@line</p>
                            }
                            else
                            {
                                <div class="h-2"></div>
                            }
                        }
                    </div>
                }
            </div>

            @if (_features.Length > 0)
            {
                <div class="flex flex-wrap items-center gap-1.5 border-t px-4 py-3">
                    <span class="mr-1 text-muted-foreground text-xs">Detected:</span>
                    @foreach (var feature in _features)
                    {
                        @if (feature.Type == "code")
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 font-mono font-normal text-[10px]">
                                @feature.Language
                            </BadgeCn>
                        }
                        else if (feature.Type == "heading")
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 font-normal text-[10px]">
                                @feature.Count heading@(feature.Count > 1 ? "s" : "")
                            </BadgeCn>
                        }
                        else if (feature.Type == "list")
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 font-normal text-[10px]">
                                @feature.Count items
                            </BadgeCn>
                        }
                        else
                        {
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="h-5 font-normal text-[10px]">
                                @feature.Count lines
                            </BadgeCn>
                        }
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record DetectedFeature(string Type, string? Language = null, int Count = 0);

    private static readonly string _sampleInput = @"# API Integration Guide

Build a REST API endpoint in Next.js that:

1. Accepts POST requests with JSON body
2. Validates input using Zod schema
3. Queries PostgreSQL via Prisma
4. Returns paginated results

```typescript
import { z } from ""zod""

const schema = z.object({
  query: z.string().min(1),
  page: z.number().default(1),
})
```

Make sure to handle errors gracefully and return proper HTTP status codes.";

    private string _input = _sampleInput;

    private int _wordCount => string.IsNullOrWhiteSpace(_input) ? 0 :
        _input.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;

    private DetectedFeature[] _features
    {
        get
        {
            var features = new List<DetectedFeature>();
            var lines = _input.Split('\n');

            var codeBlockMatches = System.Text.RegularExpressions.Regex.Matches(_input, @"```(\w*)");
            if (codeBlockMatches.Count > 0)
            {
                var languages = codeBlockMatches
                    .Select(m => m.Groups[1].Value.Trim())
                    .Where(l => !string.IsNullOrEmpty(l))
                    .Distinct()
                    .ToList();
                foreach (var lang in languages)
                {
                    features.Add(new DetectedFeature("code", Language: lang));
                }
                if (languages.Count == 0)
                {
                    features.Add(new DetectedFeature("code", Language: "plain"));
                }
            }

            var headingCount = lines.Count(l => System.Text.RegularExpressions.Regex.IsMatch(l, @"^#{1,6}\s"));
            if (headingCount > 0)
            {
                features.Add(new DetectedFeature("heading", Count: headingCount));
            }

            var listCount = lines.Count(l => System.Text.RegularExpressions.Regex.IsMatch(l, @"^\s*(\d+\.|-|\*)\s"));
            if (listCount > 0)
            {
                features.Add(new DetectedFeature("list", Count: listCount));
            }

            var plainCount = lines.Count(l =>
                !string.IsNullOrWhiteSpace(l) &&
                !System.Text.RegularExpressions.Regex.IsMatch(l, @"^#{1,6}\s") &&
                !System.Text.RegularExpressions.Regex.IsMatch(l, @"^\s*(\d+\.|-|\*)\s") &&
                !l.StartsWith("```"));
            if (plainCount > 0)
            {
                features.Add(new DetectedFeature("text", Count: plainCount));
            }

            return features.ToArray();
        }
    }
}
