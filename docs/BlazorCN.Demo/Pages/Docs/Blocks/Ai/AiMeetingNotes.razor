@* ===========================================================
   Block: ai-meeting-notes
   Title: Ai Meeting Notes
   Description: AI meeting notes with speaker-labeled transcript, action items checklist, and auto-generated summary
   Dependencies: BadgeCn, ButtonCn, CheckboxCn, LucideCheckCn, LucideChevronRightCn, LucideCopyCn
   Source: original/blocks/ai/ai-meeting-notes.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <span class="text-sm font-medium">Sprint Planning Meeting</span>
                <span class="text-xs text-muted-foreground">Mar 15, 2026</span>
            </div>
            <div class="flex items-center gap-3">
                <span class="text-xs text-muted-foreground">4 min</span>
                <span class="text-xs text-muted-foreground">&middot;</span>
                <span class="text-xs text-muted-foreground">2 participants</span>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                    Processed
                </BadgeCn>
            </div>
        </div>

        @* Summary *@
        <div class="border-b px-4 py-3">
            <div class="rounded-md bg-muted/50 p-3">
                <div class="mb-1.5 flex items-center justify-between">
                    <span class="text-xs font-medium text-muted-foreground">AI Summary</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs"
                              @onclick="HandleCopy">
                        @if (_copied)
                        {
                            <LucideCheckCn Size="16" Class="size-3" />
                            <text>Copied</text>
                        }
                        else
                        {
                            <LucideCopyCn Size="16" Class="size-3" />
                            <text>Copy</text>
                        }
                    </ButtonCn>
                </div>
                <p class="text-sm leading-relaxed">@SummaryText</p>
            </div>
        </div>

        @* Key decisions *@
        <div class="border-b px-4 py-3">
            <span class="mb-2 block text-xs font-medium text-muted-foreground">Key decisions</span>
            <ul class="space-y-1.5">
                @foreach (var decision in _keyDecisions)
                {
                    <li class="flex items-start gap-2 text-sm text-muted-foreground">
                        <span class="mt-2 size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                        @decision
                    </li>
                }
            </ul>
        </div>

        @* Action items *@
        <div class="border-b">
            <button type="button"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    @onclick="@(() => _expandedSection = _expandedSection == "actions" ? null : "actions")">
                <span class="size-2 shrink-0 rounded-full bg-blue-500"></span>
                <span class="flex-1 text-sm font-medium">Action items</span>
                <span class="font-mono text-xs text-muted-foreground">
                    @CompletedCount/@_actionItems.Count
                </span>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _expandedSection == "actions" ? "rotate-90" : "")" />
            </button>

            @if (_expandedSection == "actions")
            {
                <div class="space-y-2 px-4 pb-3 pl-9">
                    @foreach (var item in _actionItems)
                    {
                        var ai = item;
                        <div class="@Cn.Merge("flex items-start gap-2.5 rounded-md bg-muted/50 px-3 py-2", ai.Completed ? "opacity-60" : "")">
                            <CheckboxCn @bind-Checked="ai.Completed" Class="mt-0.5" />
                            <div class="min-w-0 flex-1">
                                <p class="@Cn.Merge("text-xs font-medium leading-snug", ai.Completed ? "line-through" : "")">
                                    @ai.Task
                                </p>
                                <div class="flex items-center gap-2">
                                    <span class="text-[10px] text-muted-foreground">@ai.Assignee</span>
                                    <span class="text-[10px] text-muted-foreground">&middot;</span>
                                    <span class="text-[10px] text-muted-foreground">@ai.DueDate</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Transcript *@
        <div>
            <button type="button"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    @onclick="@(() => _expandedSection = _expandedSection == "transcript" ? null : "transcript")">
                <span class="size-2 shrink-0 rounded-full bg-muted-foreground/40"></span>
                <span class="flex-1 text-sm font-medium">Transcript</span>
                <span class="text-xs text-muted-foreground">@_transcript.Length entries</span>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _expandedSection == "transcript" ? "rotate-90" : "")" />
            </button>

            @if (_expandedSection == "transcript")
            {
                <div class="max-h-[400px] overflow-y-auto px-4 pb-3 pl-9">
                    <div class="space-y-1">
                        @foreach (var entry in _transcript)
                        {
                            <div class="rounded-md px-3 py-2 transition-colors hover:bg-muted/50">
                                <div class="flex items-center gap-2">
                                    <span class="text-xs font-medium">@entry.Speaker</span>
                                    <span class="font-mono text-[10px] tabular-nums text-muted-foreground">@entry.Timestamp</span>
                                </div>
                                <p class="mt-0.5 text-sm leading-relaxed text-foreground/90">@entry.Text</p>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TranscriptEntry(string Id, string Speaker, string Initials, string Timestamp, string Text);

    private class ActionItem
    {
        public string Id { get; set; } = "";
        public string Task { get; set; } = "";
        public string Assignee { get; set; } = "";
        public string DueDate { get; set; } = "";
        public bool Completed { get; set; }
    }

    private static readonly TranscriptEntry[] _transcript =
    {
        new("t1", "Sarah Chen", "SC", "0:00", "Let's kick off the sprint planning. We have the Q2 roadmap to finalize and I want to make sure we align on priorities for the next two weeks."),
        new("t2", "Mike Johnson", "MJ", "0:32", "I've looked at the backlog. The authentication overhaul should be our top priority. We're blocking three other teams on this."),
        new("t3", "Sarah Chen", "SC", "1:05", "Agreed. What's the scope? Can we ship the OAuth providers in one sprint or should we break it down?"),
        new("t4", "Mike Johnson", "MJ", "1:28", "I'd break it into two. First sprint: Google and GitHub OAuth. Second sprint: email magic link and session management improvements. Each is about 13 story points."),
        new("t5", "Sarah Chen", "SC", "2:10", "That works. What about the dashboard analytics feature? Product has been asking about that for weeks."),
        new("t6", "Mike Johnson", "MJ", "2:35", "We can start the data layer this sprint if we parallelize. I'll take the API endpoints, and we'll need someone on the chart components."),
        new("t7", "Sarah Chen", "SC", "3:02", "I can pull in Lisa for the frontend charts. Let's timebox the analytics to 8 points this sprint and see where we land."),
        new("t8", "Mike Johnson", "MJ", "3:25", "Sounds good. One more thing \u2014 we need to address the memory leak in the WebSocket connection. It's causing crashes for users who leave the app open overnight."),
        new("t9", "Sarah Chen", "SC", "3:48", "That's critical. Let's mark it as a P0 bug fix, no more than 3 points.")
    };

    private readonly List<ActionItem> _actionItems = new()
    {
        new() { Id = "a1", Task = "Implement Google and GitHub OAuth providers", Assignee = "Mike Johnson", DueDate = "Mar 29" },
        new() { Id = "a2", Task = "Set up analytics API endpoints for dashboard", Assignee = "Mike Johnson", DueDate = "Mar 28" },
        new() { Id = "a3", Task = "Build chart components for analytics dashboard", Assignee = "Lisa Park", DueDate = "Mar 29" },
        new() { Id = "a4", Task = "Fix WebSocket memory leak (P0)", Assignee = "Unassigned", DueDate = "Mar 22" },
        new() { Id = "a5", Task = "Create sprint tickets in Linear for auth overhaul", Assignee = "Sarah Chen", DueDate = "Mar 18" }
    };

    private const string SummaryText = "Sprint planning focused on three priorities: (1) Authentication overhaul with OAuth providers split across two sprints, (2) Dashboard analytics with parallel frontend/backend work, and (3) a P0 WebSocket memory leak fix. Total sprint commitment: ~24 story points.";

    private static readonly string[] _keyDecisions =
    {
        "Auth overhaul split into two sprints (13 pts each)",
        "Analytics work starts this sprint (8 pts)",
        "WebSocket leak marked P0 (3 pts)"
    };

    private string? _expandedSection = "transcript";
    private bool _copied;

    private int CompletedCount => _actionItems.Count(a => a.Completed);

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
