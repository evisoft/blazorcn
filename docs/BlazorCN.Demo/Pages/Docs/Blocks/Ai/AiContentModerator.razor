@* ===========================================================
   Block: ai-content-moderator
   Title: Ai Content Moderator
   Description: AI content moderation dashboard with review queue, AI assessment badges, confidence scores, category tags, and bulk action buttons
   Dependencies: BadgeCn, ButtonCn, LucideChevronRightCn
   Source: original/blocks/ai/ai-content-moderator.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header with stats *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="text-sm font-medium">Content Moderation</span>
            <div class="ml-auto flex items-center gap-4 text-xs text-muted-foreground">
                <span class="tabular-nums">@_stats.Pending pending</span>
                <span class="text-muted-foreground/30">&middot;</span>
                <span class="tabular-nums">@_stats.Reviewed.ToString("N0") reviewed</span>
                <span class="text-muted-foreground/30">&middot;</span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_stats.Flagged
                </span>
                <span class="flex items-center gap-1.5">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_stats.Blocked
                </span>
            </div>
        </div>

        @* Queue *@
        <div>
            @for (var i = 0; i < _items.Length; i++)
            {
                var item = _items[i];
                var isExpanded = _expanded == item.Id;
                var isReviewed = _reviewedIds.Contains(item.Id);
                var isLast = i == _items.Length - 1;
                var itemId = item.Id;
                <div class="@Cn.Merge(!isLast ? "border-b" : "", isReviewed ? "opacity-40" : "")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : itemId)">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetAssessmentDot(item.Assessment))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@item.Author</span>
                            <p class="mt-0.5 truncate text-xs text-muted-foreground">@item.Content</p>
                        </div>
                        <span class="shrink-0 font-mono text-xs tabular-nums text-muted-foreground">
                            @(item.Confidence)%
                        </span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded && !isReviewed)
                    {
                        <div class="space-y-3 px-4 pb-4 pl-9">
                            @* Content *@
                            <p class="text-sm leading-relaxed">@item.Content</p>

                            @* Meta *@
                            <div class="flex flex-wrap items-center gap-2">
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                    @item.Type
                                </BadgeCn>
                                <span class="text-xs text-muted-foreground">@item.Timestamp</span>
                                @if (item.Categories.Length > 0)
                                {
                                    <span class="text-muted-foreground/30">&middot;</span>
                                    @foreach (var cat in item.Categories)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs font-normal">
                                            @cat
                                        </BadgeCn>
                                    }
                                }
                            </div>

                            @* Confidence *@
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-1.5 flex items-center justify-between">
                                    <span class="text-xs font-medium text-muted-foreground">AI confidence</span>
                                    <span class="font-mono text-xs tabular-nums">@(item.Confidence)%</span>
                                </div>
                                <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted">
                                    <div class="@Cn.Merge("h-full rounded-full", GetAssessmentDot(item.Assessment))"
                                         style="@($"width: {item.Confidence}%")"></div>
                                </div>
                            </div>

                            @* Actions *@
                            <div class="flex gap-2">
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs"
                                          @onclick="@(() => HandleAction(itemId))">
                                    Approve
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs"
                                          @onclick="@(() => HandleAction(itemId))">
                                    Flag
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs"
                                          @onclick="@(() => HandleAction(itemId))">
                                    Block
                                </ButtonCn>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ModerationStats(int Pending, int Reviewed, int Flagged, int Blocked);
    private record ModerationItem(string Id, string Content, string Author, string Timestamp, string Assessment, int Confidence, string[] Categories, string Type);

    private static readonly ModerationStats _stats = new(23, 1847, 42, 8);

    private static readonly ModerationItem[] _items =
    {
        new("1", "This product is absolutely terrible. I want a full refund immediately or I'll file a complaint with the BBB. Your company is a scam.",
            "user_28491", "2 min ago", "warning", 76, new[] { "Harassment", "Threat" }, "comment"),
        new("2", "Hey everyone! Just wanted to share that I had a great experience with customer support today. They resolved my issue in under 5 minutes. Highly recommend!",
            "user_10284", "5 min ago", "safe", 98, Array.Empty<string>(), "comment"),
        new("3", "URGENT: Make $5000/day from home! Click here now for this limited time offer. No experience needed. DM me for the secret method.",
            "user_99201", "8 min ago", "blocked", 97, new[] { "Spam", "Scam" }, "post"),
        new("4", "I disagree with the article's premise. The data clearly shows a different trend if you look at the 2024 figures. Here's my analysis of why the methodology is flawed.",
            "user_44782", "12 min ago", "safe", 94, Array.Empty<string>(), "comment"),
        new("5", "You people are all idiots if you believe this. Wake up sheeple! The government doesn't want you to know the truth. Share before they delete this!!!",
            "user_67103", "15 min ago", "warning", 82, new[] { "Misinformation", "Hate Speech" }, "post")
    };

    private string? _expanded = "1";
    private readonly HashSet<string> _reviewedIds = new();

    private static string GetAssessmentDot(string assessment) => assessment switch
    {
        "safe" => "bg-emerald-500",
        "warning" => "bg-amber-500",
        "blocked" => "bg-red-500",
        _ => "bg-gray-500"
    };

    private void HandleAction(string id)
    {
        _reviewedIds.Add(id);
    }
}
