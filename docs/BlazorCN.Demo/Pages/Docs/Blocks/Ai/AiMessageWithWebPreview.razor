@* ===========================================================
   Block: ai-message-with-web-preview
   Title: Ai Message With Web Preview
   Description: AI message with URL preview cards, site favicons, expandable details, and link metadata
   Dependencies: ButtonCn, LucideChevronRightCn, LucideCopyCn, LucideExternalLinkCn
   Source: original/blocks/ai/ai-message-with-web-preview.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm font-medium">TypeScript ORMs for Node.js</span>
            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                <span>@_previews.Length web results</span>
            </div>
        </div>

        @* Response *@
        <div class="space-y-2 border-b px-4 py-3 text-sm leading-relaxed">
            <p>Here are the top 3 TypeScript ORMs worth considering for a new project in 2026:</p>
            <p>
                <span class="font-medium">Prisma</span> remains the most popular choice with its
                declarative schema, auto-generated client, and excellent migration tooling.
                <span class="font-medium">Drizzle</span> has gained massive traction for its
                SQL-first approach with full type safety. <span class="font-medium">Kysely</span> is
                the purist's choice &mdash; a type-safe query builder with no schema files and no code
                generation.
            </p>
        </div>

        @* Web preview list *@
        <div>
            @for (var i = 0; i < _previews.Length; i++)
            {
                var preview = _previews[i];
                var isExpanded = _expanded == preview.Url;
                var isLast = i == _previews.Length - 1;
                var url = preview.Url;
                <div class="@(!isLast ? "border-b" : "")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : url)">
                        <span class="flex size-7 shrink-0 items-center justify-center rounded-md bg-muted font-mono text-xs text-muted-foreground">
                            @preview.Initial
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@preview.Title</span>
                            <p class="mt-0.5 truncate font-mono text-xs text-muted-foreground">
                                @preview.Domain
                            </p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-14">
                            <p class="mb-2 text-sm leading-relaxed text-muted-foreground">
                                @preview.Description
                            </p>
                            <a href="@preview.Url"
                               target="_blank"
                               rel="noreferrer"
                               class="inline-flex items-center gap-1 text-xs text-muted-foreground hover:text-foreground">
                                <LucideExternalLinkCn Size="16" Class="size-3" />
                                Visit site
                            </a>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-xs text-muted-foreground">
                Start with Drizzle for SQL-first, Prisma for higher-level abstraction.
            </span>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideCopyCn Size="16" Class="size-3" />
                Copy
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record WebPreviewData(string Title, string Description, string Url, string Domain, string Initial);

    private static readonly WebPreviewData[] _previews =
    {
        new("Prisma ORM - Next-generation Node.js and TypeScript ORM",
            "Open-source ORM for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB, and CockroachDB.",
            "https://www.prisma.io/orm", "prisma.io", "P"),
        new("Drizzle ORM - TypeScript ORM for SQL Databases",
            "Lightweight TypeScript ORM that lets you write SQL in TypeScript. Zero dependencies, serverless-ready.",
            "https://orm.drizzle.team", "orm.drizzle.team", "D"),
        new("Kysely - The Type-Safe SQL Query Builder for TypeScript",
            "Type-safe and autocompletion-friendly TypeScript SQL query builder. No code generation.",
            "https://kysely.dev", "kysely.dev", "K")
    };

    private string? _expanded;
}
