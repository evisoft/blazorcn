@* ===========================================================
   Block: ai-tool-api-caller
   Title: Ai Tool Api Caller
   Description: React AI tool API caller block for Next.js with HTTP method badges, request/response display, collapsible headers, and response timing using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/ai/ai-tool-api-caller.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Method + URL *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="@Cn.Merge("font-mono font-semibold text-xs", _methodColor)">
                @_method
            </span>
            <span class="min-w-0 flex-1 truncate font-mono text-xs">@_url</span>
            <div class="flex items-center gap-2">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="@Cn.Merge("size-1.5 rounded-full", _statusDot)"></span>
                    @_responseStatus
                </span>
                <span class="font-mono text-muted-foreground text-xs">@_responseTime</span>
            </div>
        </div>

        @* Request headers *@
        <div class="border-b">
            <button
                type="button"
                @onclick="@(() => _showReqHeaders = !_showReqHeaders)"
                class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                <span class="font-medium text-sm">Request Headers</span>
                <span class="text-muted-foreground text-xs">@_requestHeaders.Length</span>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("ml-auto size-4 text-muted-foreground/60 transition-transform duration-200", _showReqHeaders ? "rotate-90" : "")" />
            </button>
            @if (_showReqHeaders)
            {
                <div class="border-t px-4 py-2.5">
                    @foreach (var header in _requestHeaders)
                    {
                        <div class="flex items-start gap-2 py-0.5 font-mono text-[11px]">
                            <span class="shrink-0 text-muted-foreground">@(header.Key):</span>
                            <span class="break-all">@header.Value</span>
                        </div>
                    }
                </div>
            }
        </div>

        @* Request body *@
        <div class="border-b">
            <div class="flex items-center justify-between px-4 py-2.5">
                <span class="font-medium text-xs text-muted-foreground">Request Body</span>
                <ButtonCn
                    Variant="ButtonVariant.Ghost"
                    Size="ButtonSize.Sm"
                    class="h-6 gap-1 px-2 text-xs">
                    @if (_copiedSection == "req")
                    {
                        <LucideCheckCn Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideCopyCn Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
            <pre class="overflow-x-auto bg-zinc-950 p-3 font-mono text-xs leading-relaxed text-zinc-100">@_requestBodyJson</pre>
        </div>

        @* Response status *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <span class="font-medium text-xs text-muted-foreground">Response</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-xs">
                @_responseStatus @_responseStatusText
            </BadgeCn>
            <span class="font-mono text-muted-foreground text-xs">@_responseTime</span>
        </div>

        @* Response headers *@
        <div class="border-b">
            <button
                type="button"
                @onclick="@(() => _showResHeaders = !_showResHeaders)"
                class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50">
                <span class="font-medium text-sm">Response Headers</span>
                <span class="text-muted-foreground text-xs">@_responseHeaders.Length</span>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("ml-auto size-4 text-muted-foreground/60 transition-transform duration-200", _showResHeaders ? "rotate-90" : "")" />
            </button>
            @if (_showResHeaders)
            {
                <div class="border-t px-4 py-2.5">
                    @foreach (var header in _responseHeaders)
                    {
                        <div class="flex items-start gap-2 py-0.5 font-mono text-[11px]">
                            <span class="shrink-0 text-muted-foreground">@(header.Key):</span>
                            <span class="break-all">@header.Value</span>
                        </div>
                    }
                </div>
            }
        </div>

        @* Response body *@
        <div>
            <div class="flex items-center justify-between px-4 py-2.5">
                <span class="font-medium text-xs text-muted-foreground">Response Body</span>
                <ButtonCn
                    Variant="ButtonVariant.Ghost"
                    Size="ButtonSize.Sm"
                    class="h-6 gap-1 px-2 text-xs">
                    @if (_copiedSection == "res")
                    {
                        <LucideCheckCn Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideCopyCn Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
            <pre class="overflow-x-auto bg-zinc-950 p-3 font-mono text-xs leading-relaxed text-zinc-100">@_responseBodyJson</pre>
        </div>
    </div>
</section>

@code {
    private record HeaderEntry(string Key, string Value);

    private static readonly string _method = "POST";
    private static readonly string _url = "https://api.stripe.com/v1/customers";
    private static readonly int _responseStatus = 200;
    private static readonly string _responseStatusText = "OK";
    private static readonly string _responseTime = "342ms";

    private static readonly HeaderEntry[] _requestHeaders =
    [
        new("Authorization", "Bearer sk_live_\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u2022\u20224242"),
        new("Content-Type", "application/x-www-form-urlencoded"),
        new("Stripe-Version", "2024-12-18"),
        new("Idempotency-Key", "cust_create_8f3a2b1c"),
    ];

    private static readonly HeaderEntry[] _responseHeaders =
    [
        new("Content-Type", "application/json"),
        new("Request-Id", "req_a1b2c3d4e5f6"),
        new("Stripe-Version", "2024-12-18"),
    ];

    private static readonly string _requestBodyJson = @"{
  ""email"": ""sarah.chen@acme.co"",
  ""name"": ""Sarah Chen"",
  ""metadata"": {
    ""plan"": ""pro"",
    ""source"": ""ai-onboarding""
  }
}";

    private static readonly string _responseBodyJson = @"{
  ""id"": ""cus_RkL9xN7mP2qY"",
  ""object"": ""customer"",
  ""email"": ""sarah.chen@acme.co"",
  ""name"": ""Sarah Chen"",
  ""created"": 1710489600,
  ""livemode"": true,
  ""metadata"": {
    ""plan"": ""pro"",
    ""source"": ""ai-onboarding""
  }
}";

    private string _statusDot => _responseStatus >= 200 && _responseStatus < 300 ? "bg-emerald-500" :
        _responseStatus >= 300 && _responseStatus < 400 ? "bg-blue-500" :
        _responseStatus >= 400 && _responseStatus < 500 ? "bg-amber-500" : "bg-red-500";

    private string _methodColor => _method switch
    {
        "GET" => "text-blue-600 dark:text-blue-400",
        "POST" => "text-emerald-600 dark:text-emerald-400",
        "PUT" => "text-amber-600 dark:text-amber-400",
        "PATCH" => "text-orange-600 dark:text-orange-400",
        "DELETE" => "text-red-600 dark:text-red-400",
        _ => "text-foreground",
    };

    private bool _showReqHeaders = false;
    private bool _showResHeaders = false;
    private string? _copiedSection = null;
}
