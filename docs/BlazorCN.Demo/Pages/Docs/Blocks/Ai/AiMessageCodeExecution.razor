@* ===========================================================
   Block: ai-message-code-execution
   Title: Ai Message Code Execution
   Description: React AI message with code generation and execution result block for Next.js with syntax-highlighted code, terminal output, and status badges using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/ai/ai-message-code-execution.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* User message *@
        <div class="border-b px-4 py-3">
            <div class="flex justify-end">
                <div class="rounded-lg bg-muted px-3 py-2 text-sm">
                    <p>
                        Write a Python script that analyzes a dataset of sales data and shows the top 5
                        products by revenue.
                    </p>
                </div>
            </div>
        </div>

        @* AI intro *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted">
                <span class="font-medium text-muted-foreground text-[10px]">AI</span>
            </div>
            <p class="text-sm">
                Here's a script that reads your sales CSV, calculates revenue per product, and
                displays the top 5:
            </p>
        </div>

        @* Code block *@
        <div class="border-b">
            <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2">
                <div class="flex items-center gap-2">
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-mono text-[10px]">
                        Python
                    </BadgeCn>
                    <span class="text-muted-foreground text-xs">analysis.py</span>
                </div>
                <ButtonCn
                    Variant="ButtonVariant.Ghost"
                    Size="ButtonSize.Sm"
                    class="h-6 gap-1 px-2 text-xs">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideCopyCn Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>
            <pre class="overflow-x-auto bg-zinc-950 p-3 font-mono text-[13px] leading-6 text-zinc-100"><code>@_pythonCode</code></pre>
        </div>

        @* Execution result *@
        <div class="border-b">
            <div class="flex items-center justify-between border-b bg-muted/30 px-4 py-2">
                <div class="flex items-center gap-2">
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        Executed
                    </span>
                    <span class="text-muted-foreground text-xs">·</span>
                    <span class="font-mono text-muted-foreground text-xs">0.34s</span>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-2 text-xs">
                    <LucidePlayCn Size="12" Class="size-3" />
                    Re-run
                </ButtonCn>
            </div>
            <div class="bg-zinc-950 p-3 font-mono text-[13px] leading-6 text-zinc-300">
                <p class="text-zinc-100">Top 5 Products by Revenue:</p>
                <p class="mt-1 text-zinc-300">  1.  Wireless Pro Headphones            $    847,293.50</p>
                <p class="text-zinc-300">  2.  Ultra-Slim Laptop 15"             $    723,841.00</p>
                <p class="text-zinc-300">  3.  Smart Home Hub                     $    612,457.75</p>
                <p class="text-zinc-300">  4.  4K Action Camera                   $    498,126.25</p>
                <p class="text-zinc-300">  5.  Ergonomic Mesh Chair               $    391,044.80</p>
            </div>
        </div>

        @* Follow-up *@
        <div class="px-4 py-3">
            <div class="flex gap-3">
                <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted">
                    <span class="font-medium text-muted-foreground text-[10px]">AI</span>
                </div>
                <p class="text-sm leading-relaxed">
                    The analysis shows <strong>Wireless Pro Headphones</strong> leading with $847K in total revenue,
                    followed by the <strong>Ultra-Slim Laptop</strong> at $723K. The top 5 products account for
                    roughly 60% of all revenue in the dataset.
                </p>
            </div>
            <div class="mt-3 flex items-center gap-1 pl-9">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7 text-muted-foreground">
                    <LucideCopyCn Size="14" Class="size-3.5" />
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7 text-muted-foreground">
                    <LucidePlayCn Size="14" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly string _pythonCode = @"import pandas as pd

# Load the sales dataset
df = pd.read_csv(""sales_data.csv"")

# Calculate revenue: quantity * unit_price
df[""revenue""] = df[""quantity""] * df[""unit_price""]

# Group by product and sum revenue
top_products = (
    df.groupby(""product_name"")[""revenue""]
    .sum()
    .sort_values(ascending=False)
    .head(5)
)

print(""Top 5 Products by Revenue:\n"")
for i, (name, rev) in enumerate(top_products.items(), 1):
    print(f""  {i}.  {name:<30} ${rev:>12,.2f}"")";

    private bool _copied = false;
}
