@* ===========================================================
   Block: ai-learning-path
   Title: Ai Learning Path
   Description: AI learning path generator with topic input, skill level selector, vertical timeline modules, progress tracking, and resource links
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideCheckCn, LucideChevronRightCn, LucideExternalLinkCn, SelectCn
   Source: original/blocks/ai/ai-learning-path.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Topic input *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <InputCn @bind-Value="_topic"
                     Placeholder="Enter a topic to learn..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" aria-label="Enter a topic to learn..." />
            <SelectCn Value="@_level" ValueChanged="v => _level = v">
                <SelectTriggerCn aria-label="Level" Class="h-7 w-[130px] shrink-0 text-xs">
                    <SelectValueCn Placeholder="Level" />
                </SelectTriggerCn>
                <SelectContentCn>
                    <SelectItemCn Value="@("beginner")">Beginner</SelectItemCn>
                    <SelectItemCn Value="@("intermediate")">Intermediate</SelectItemCn>
                    <SelectItemCn Value="@("advanced")">Advanced</SelectItemCn>
                </SelectContentCn>
            </SelectCn>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 shrink-0 text-xs">
                Generate
            </ButtonCn>
        </div>

        @* Progress summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="text-2xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                    @ProgressPercent
                </span>
                <span class="text-xs text-muted-foreground">%</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                @_completed.Count/@_modules.Length modules
            </BadgeCn>
            <span class="text-xs text-muted-foreground">&middot;</span>
            <span class="text-xs text-muted-foreground">~@(TotalDuration)h total</span>
            <span class="text-xs text-muted-foreground">&middot;</span>
            <span class="text-xs text-muted-foreground">@_topic</span>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_modules.Count(m => m.Difficulty == "Beginner")
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @_modules.Count(m => m.Difficulty == "Intermediate")
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @_modules.Count(m => m.Difficulty == "Advanced")
                </span>
            </div>
        </div>

        @* Modules list *@
        <div>
            @for (var i = 0; i < _modules.Length; i++)
            {
                var mod = _modules[i];
                var isExpanded = _expanded == mod.Id;
                var isComplete = _completed.Contains(mod.Id);
                var isLast = i == _modules.Length - 1;
                var modId = mod.Id;
                <div class="@(!isLast ? "border-b" : "")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : modId)">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetDifficultyDot(mod.Difficulty))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="@Cn.Merge("text-sm font-medium", isComplete ? "text-muted-foreground line-through" : "")">
                                @mod.Title
                            </span>
                            <p class="mt-0.5 flex items-center gap-2 text-xs text-muted-foreground">
                                <span>@mod.Difficulty</span>
                                <span>&middot;</span>
                                <span>@mod.Duration</span>
                            </p>
                        </div>
                        @if (isComplete)
                        {
                            <span class="flex size-5 items-center justify-center rounded-full bg-emerald-500/10">
                                <LucideCheckCn Size="16" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                            </span>
                        }
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <p class="mb-3 text-sm leading-relaxed text-muted-foreground">@mod.Description</p>

                            @* Resources *@
                            <div class="mb-3 space-y-1">
                                @foreach (var res in mod.Resources)
                                {
                                    <a href="#"
                                       class="flex items-center gap-2 rounded-md bg-muted/50 px-3 py-2 text-xs transition-colors hover:bg-muted">
                                        <span class="font-medium text-muted-foreground">@res.Type</span>
                                        <span class="flex-1">@res.Title</span>
                                        <LucideExternalLinkCn Size="16" Class="size-3 text-muted-foreground" />
                                    </a>
                                }
                            </div>

                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs"
                                      @onclick="@(() => ToggleCompleted(modId))">
                                @(isComplete ? "Mark incomplete" : "Mark complete")
                            </ButtonCn>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Resource(string Type, string Title, string Url);
    private record LearningModule(string Id, string Title, string Description, string Duration, string Difficulty, Resource[] Resources);

    private static readonly LearningModule[] _modules =
    {
        new("m1", "Foundations of Machine Learning",
            "Understand supervised vs unsupervised learning, key terminology, and the ML pipeline from data collection to model deployment.",
            "2 hours", "Beginner", new[] { new Resource("video", "ML Crash Course by Google", "#"), new Resource("article", "A Visual Introduction to ML", "#") }),
        new("m2", "Python for Data Science",
            "Master NumPy, Pandas, and Matplotlib for data manipulation, analysis, and visualization. Includes hands-on exercises with real datasets.",
            "4 hours", "Beginner", new[] { new Resource("exercise", "Pandas Practice Problems", "#"), new Resource("video", "NumPy in 30 Minutes", "#") }),
        new("m3", "Linear Regression & Gradient Descent",
            "Implement linear regression from scratch, understand cost functions, and learn how gradient descent optimizes model parameters.",
            "3 hours", "Intermediate", new[] { new Resource("article", "The Math Behind Gradient Descent", "#"), new Resource("exercise", "Build a Regression Model", "#") }),
        new("m4", "Classification Algorithms",
            "Explore logistic regression, decision trees, random forests, and SVMs. Learn when to use each algorithm and how to evaluate classifiers.",
            "4 hours", "Intermediate", new[] { new Resource("video", "Decision Trees Explained", "#"), new Resource("exercise", "Classify Iris Species", "#") }),
        new("m5", "Neural Networks & Deep Learning",
            "Build your first neural network with TensorFlow/Keras. Understand layers, activation functions, backpropagation, and training loops.",
            "5 hours", "Advanced", new[] { new Resource("video", "3Blue1Brown Neural Networks", "#"), new Resource("exercise", "MNIST Digit Classifier", "#"), new Resource("article", "Backpropagation Intuition", "#") }),
        new("m6", "Natural Language Processing",
            "Learn text preprocessing, word embeddings, transformers, and how GPT models work. Build a sentiment analysis pipeline.",
            "4 hours", "Advanced", new[] { new Resource("video", "Attention Is All You Need Explained", "#"), new Resource("exercise", "Build a Sentiment Classifier", "#") }),
        new("m7", "Model Evaluation & Tuning",
            "Master cross-validation, hyperparameter tuning, bias-variance tradeoff, and techniques to prevent overfitting in production models.",
            "3 hours", "Intermediate", new[] { new Resource("article", "The Bias-Variance Tradeoff", "#"), new Resource("exercise", "Hyperparameter Grid Search", "#") }),
        new("m8", "Deploying ML Models to Production",
            "Package models with Docker, serve predictions via REST APIs, monitor model drift, and implement CI/CD for ML pipelines.",
            "3 hours", "Advanced", new[] { new Resource("video", "MLOps Best Practices", "#"), new Resource("article", "Model Serving with FastAPI", "#") })
    };

    private string _topic = "Machine Learning";
    private string _level = "intermediate";
    private readonly HashSet<string> _completed = new() { "m1", "m2" };
    private string? _expanded = "m3";

    private int ProgressPercent => _modules.Length > 0 ? (int)Math.Round((double)_completed.Count / _modules.Length * 100) : 0;
    private int TotalDuration => _modules.Sum(m => int.Parse(m.Duration.Split(' ')[0]));

    private static string GetDifficultyDot(string difficulty) => difficulty switch
    {
        "Beginner" => "bg-emerald-500",
        "Intermediate" => "bg-amber-500",
        "Advanced" => "bg-red-500",
        _ => "bg-gray-500"
    };

    private void ToggleCompleted(string id)
    {
        if (!_completed.Remove(id))
            _completed.Add(id);
    }
}
