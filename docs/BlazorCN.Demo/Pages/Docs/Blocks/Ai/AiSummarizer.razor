    private string _input = _sampleInput;
    private string _length = "short";
    private string _format = "bullets";
    private bool _hasSummarized = true;
    private bool _copied = false;

    private string _output => _summaryOutputs[_length][_format];

    private int _inputWords => string.IsNullOrWhiteSpace(_input) ? 0 :
        _input.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;

    private int _outputWords => _output.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;

    private int _reductionPercent => _inputWords > 0 ? (int)Math.Round((1.0 - (double)_outputWords / _inputWords) * 100) : 0;
}
