@* ===========================================================
   Block: ai-summarizer
   Title: Ai Summarizer
   Description: React AI text summarization block for Next.js with length controls, format toggles, word count reduction, and copy actions using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/ai/ai-summarizer.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Input *@
        <div class="border-b px-4 py-3">
            <textarea @bind="_input"
                placeholder="Paste your article, report, or document here..."
                rows="6"
                class="w-full resize-none border-0 bg-transparent p-0 shadow-none text-sm leading-relaxed focus-visible:ring-0 outline-none"></textarea>
            <div class="mt-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">@_inputWords words</span>
                <ButtonCn
                    Size="ButtonSize.Sm"
                    Variant="ButtonVariant.Outline"
                    class="h-7 text-xs"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    @onclick="@(() => _hasSummarized = true)">
                    Summarize
                </ButtonCn>
            </div>
        </div>

        @* Controls *@
        <div class="flex flex-wrap items-center gap-2 border-b px-4 py-2.5">
            <div class="flex items-center gap-0.5 rounded-md border p-0.5">
                @foreach (var l in _lengths)
                {
                    <button
                        type="button"
                        @onclick="@(() => _length = l.Value)"
                        class="@Cn.Merge("rounded px-2.5 py-1 text-xs font-medium transition-colors", _length == l.Value ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @l.Label
                    </button>
                }
            </div>
            <div class="flex items-center gap-0.5 rounded-md border p-0.5">
                @foreach (var f in _formats)
                {
                    <button
                        type="button"
                        @onclick="@(() => _format = f.Value)"
                        class="@Cn.Merge("rounded px-2.5 py-1 text-xs font-medium transition-colors", _format == f.Value ? "bg-foreground text-background" : "text-muted-foreground hover:text-foreground")">
                        @f.Label
                    </button>
                }
            </div>
        </div>

        @* Output *@
        @if (_hasSummarized && !string.IsNullOrWhiteSpace(_input))
        {
            @* Stats *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <span class="font-medium text-sm">Summary</span>
                <span class="text-muted-foreground text-xs">·</span>
                <span class="font-mono text-muted-foreground text-xs">@_outputWords words</span>
                <BadgeCn
                    Variant="BadgeVariant.Secondary"
                    class="font-mono text-xs text-emerald-700 dark:text-emerald-400">
                    @_reductionPercent% shorter
                </BadgeCn>
                <ButtonCn
                    Variant="ButtonVariant.Ghost"
                    Size="ButtonSize.Sm"
                    class="ml-auto h-6 gap-1 px-2 text-xs">
                    @if (_copied)
                    {
                        <LucideCheckCn Size="12" Class="size-3" />
                        <span>Copied</span>
                    }
                    else
                    {
                        <LucideCopyCn Size="12" Class="size-3" />
                        <span>Copy</span>
                    }
                </ButtonCn>
            </div>

            @* Content *@
            <div class="px-4 py-3">
                @if (_format == "bullets")
                {
                    <ul class="space-y-2">
                        @foreach (var line in _output.Split('\n').Where(l => !string.IsNullOrWhiteSpace(l)))
                        {
                            <li class="flex gap-2 text-sm leading-relaxed">
                                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-foreground/20"></span>
                                <span>@System.Text.RegularExpressions.Regex.Replace(line, @"^-\s*", "")</span>
                            </li>
                        }
                    </ul>
                }
                else if (_format == "paragraph")
                {
                    <p class="text-sm leading-relaxed text-muted-foreground">@_output</p>
                }
                else if (_format == "keypoints")
                {
                    <div class="space-y-2">
                        @foreach (var line in _output.Split('\n').Where(l => !string.IsNullOrWhiteSpace(l)))
                        {
                            var match = System.Text.RegularExpressions.Regex.Match(line, @"^\*\*(.+?):\*\*\s*(.+)$");
                            @if (match.Success)
                            {
                                <div class="text-sm">
                                    <span class="font-medium">@(match.Groups[1].Value):</span>
                                    @(" ")
                                    <span class="text-muted-foreground">@match.Groups[2].Value</span>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record LengthOption(string Value, string Label);
    private record FormatOption(string Value, string Label);

    private static readonly LengthOption[] _lengths =
    [
        new("short", "Short"),
        new("medium", "Medium"),
        new("long", "Long"),
    ];

    private static readonly FormatOption[] _formats =
    [
        new("bullets", "Bullets"),
        new("paragraph", "Paragraph"),
        new("keypoints", "Key Points"),
    ];

    private static readonly string _sampleInput = "Artificial intelligence has transformed the software industry in ways that were barely imaginable a decade ago. Machine learning models, particularly large language models (LLMs), have moved from research labs to production applications serving millions of users daily. Companies like OpenAI, Anthropic, Google, and Meta have invested billions in developing increasingly capable models that can understand and generate human language with remarkable fluency.\n\nThe impact on software development itself has been equally profound. AI-powered code assistants now help developers write, debug, and refactor code in real time. Tools like GitHub Copilot, Cursor, and Claude Code have become standard parts of many development workflows, reportedly boosting productivity by 30-55% on certain tasks. Code review, documentation generation, and test writing are increasingly augmented by AI.\n\nHowever, the technology is not without challenges. Hallucination\u2014where models generate plausible but incorrect information\u2014remains a significant concern, particularly in high-stakes domains like healthcare and legal applications. Energy consumption for training and running large models raises environmental questions. And the rapid pace of change has left many organizations struggling to develop governance frameworks that balance innovation with responsible use.\n\nLooking ahead, the trend toward smaller, more efficient models that can run on edge devices suggests AI capabilities will become even more ubiquitous. Multi-modal models that process text, images, audio, and video simultaneously are enabling entirely new application categories. The integration of AI with robotics, autonomous systems, and scientific research promises further transformative advances in the coming years.";

