@* ===========================================================
   Block: ai-model-comparison
   Title: Ai Model Comparison
   Description: AI model comparison with side-by-side cards, rating bars, capability badges, and recommendation badges
   Dependencies: BadgeCn, ButtonCn, LucideCheckCn, LucideChevronRightCn
   Source: original/blocks/ai/ai-model-comparison.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm font-medium">Model comparison</span>
            <span class="text-xs text-muted-foreground">@_models.Length models</span>
        </div>

        @* Model rows *@
        <div>
            @for (var i = 0; i < _models.Length; i++)
            {
                var model = _models[i];
                var isExpanded = _expanded == model.Id;
                var isSelected = _selected == model.Id;
                var isLast = i == _models.Length - 1;
                var modelId = model.Id;
                <div class="@(!isLast ? "border-b" : "")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : modelId)">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="text-sm font-medium">@model.Name</span>
                                @if (model.IsRecommended)
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                        Recommended
                                    </BadgeCn>
                                }
                            </div>
                            <p class="mt-0.5 text-xs text-muted-foreground">@model.Provider</p>
                        </div>

                        @* Inline stats *@
                        <div class="flex items-center gap-4">
                            <div class="text-right">
                                <span class="@Cn.Merge("text-sm font-semibold tabular-nums", GetQualityColor(model.Quality))">
                                    @model.Quality
                                </span>
                                <span class="text-xs text-muted-foreground"> quality</span>
                            </div>
                            <div class="text-right">
                                <span class="@Cn.Merge("text-sm font-semibold tabular-nums", GetSpeedColor(model.Speed))">
                                    @model.Speed
                                </span>
                                <span class="text-xs text-muted-foreground"> speed</span>
                            </div>
                        </div>

                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="flex items-center gap-4 text-xs">
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-muted-foreground">Cost</span>
                                        <span class="font-mono font-medium">@model.CostPer1M/1M</span>
                                    </div>
                                    <span class="text-muted-foreground">&middot;</span>
                                    <div class="flex items-center gap-1.5">
                                        <span class="text-muted-foreground">Context</span>
                                        <span class="font-mono font-medium">@model.ContextWindow</span>
                                    </div>
                                </div>
                                <div class="mt-2 flex flex-wrap gap-1">
                                    @foreach (var tag in model.BestFor)
                                    {
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                                            @tag
                                        </BadgeCn>
                                    }
                                </div>
                                <div class="mt-3">
                                    <ButtonCn Variant="@(isSelected ? ButtonVariant.Default : ButtonVariant.Outline)"
                                              Size="ButtonSize.Sm" Class="h-7 text-xs"
                                              @onclick="@(() => _selected = modelId)">
                                        @if (isSelected)
                                        {
                                            <LucideCheckCn Size="16" Class="mr-1 size-3" />
                                            <text>Selected</text>
                                        }
                                        else
                                        {
                                            <text>Select model</text>
                                        }
                                    </ButtonCn>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record ModelSpec(string Id, string Name, string Provider, int Speed, int Quality, string CostPer1M, string ContextWindow, string[] BestFor, bool IsRecommended);

    private static readonly ModelSpec[] _models =
    {
        new("gpt-4o", "GPT-4o", "OpenAI", 72, 90, "$5.00", "128K", new[] { "General purpose", "Code generation", "Multimodal" }, false),
        new("claude-3.5-sonnet", "Claude 3.5 Sonnet", "Anthropic", 78, 94, "$3.00", "200K", new[] { "Long documents", "Analysis", "Coding", "Reasoning" }, true),
        new("gemini-1.5-pro", "Gemini 1.5 Pro", "Google", 85, 86, "$3.50", "1M", new[] { "Multimodal", "Long context", "Search" }, false)
    };

    private string _selected = "claude-3.5-sonnet";
    private string? _expanded = "claude-3.5-sonnet";

    private static string GetQualityColor(int v) => v >= 90
        ? "text-emerald-600 dark:text-emerald-400"
        : v >= 80
            ? "text-amber-600 dark:text-amber-400"
            : "text-muted-foreground";

    private static string GetSpeedColor(int v) => v >= 80
        ? "text-emerald-600 dark:text-emerald-400"
        : v >= 70
            ? "text-amber-600 dark:text-amber-400"
            : "text-muted-foreground";
}
