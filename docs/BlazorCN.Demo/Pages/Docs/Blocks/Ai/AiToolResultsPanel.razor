@* ===========================================================
   Block: ai-tool-results-panel
   Title: Ai Tool Results Panel
   Description: React AI tool results panel block for Next.js with tabbed interface for results, logs, and errors, structured data display, and timestamped entries using shadcn/ui and Tailwind CSS
   Long Description: React AI Tool File Search Block
   Dependencies: BadgeCn, ButtonCn, TabsCn, LucideCheckCn, LucideCopyCn
   Source: original/blocks/ai/ai-tool-results-panel.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <span class="text-sm font-medium">Execution Results</span>
            <span class="text-xs text-muted-foreground">Customer data sync</span>
            <div class="ml-auto flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="text-xs text-muted-foreground">Completed</span>
            </div>
        </div>

        @* Tabs *@
        <div class="px-4 pt-3">
            <TabsCn DefaultValue="results">
                <TabsListCn Class="w-full">
                    <TabsTriggerCn Value="results" Class="flex-1 text-xs">Results</TabsTriggerCn>
                    <TabsTriggerCn Value="logs" Class="flex-1 text-xs">Logs</TabsTriggerCn>
                    <TabsTriggerCn Value="errors" Class="flex-1 text-xs">Errors</TabsTriggerCn>
                </TabsListCn>

                @* Results tab *@
                <TabsContentCn Value="results" Class="mt-3 pb-3">
                    <div>
                        @for (var i = 0; i < _resultItems.Length; i++)
                        {
                            var item = _resultItems[i];
                            var isLast = i == _resultItems.Length - 1;
                            <div class="@($"flex items-center justify-between px-1 py-2 {(isLast ? "" : "border-b")}")">
                                <span class="text-xs text-muted-foreground">@item.Label</span>
                                <span class="@Cn.Merge("font-mono text-xs", item.Type == "number" ? "font-semibold tabular-nums" : "")">
                                    @item.Value
                                </span>
                            </div>
                        }
                    </div>
                </TabsContentCn>

                @* Logs tab *@
                <TabsContentCn Value="logs" Class="mt-3 pb-3">
                    <div>
                        @foreach (var entry in _logEntries)
                        {
                            <div class="flex items-start gap-2 rounded-md px-1 py-1.5 font-mono text-xs transition-colors hover:bg-muted/50">
                                <span class="shrink-0 pt-1 text-muted-foreground/60">
                                    @entry.Timestamp
                                </span>
                                <span class="@($"mt-1.5 size-1.5 shrink-0 rounded-full {_severityDot[entry.Severity]}")"></span>
                                @if (entry.Source != null)
                                {
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="h-4 shrink-0 px-1 text-[9px]">
                                        @entry.Source
                                    </BadgeCn>
                                }
                                <span class="flex-1 text-muted-foreground">@entry.Message</span>
                            </div>
                        }
                    </div>
                </TabsContentCn>

                @* Errors tab *@
                <TabsContentCn Value="errors" Class="mt-3 space-y-3 pb-3">
                    @* Error detail *@
                    <div class="px-1">
                        <div class="flex items-center gap-2">
                            <span class="size-1.5 rounded-full bg-red-500"></span>
                            <span class="text-sm font-medium">@_errorInfo.Name</span>
                            <span class="font-mono text-xs text-muted-foreground">
                                @_errorInfo.Timestamp
                            </span>
                        </div>
                        <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">
                            @_errorInfo.Message
                        </p>
                    </div>

                    @* Stack trace *@
                    <div class="rounded-md bg-zinc-950 p-3">
                        <pre class="space-y-0.5 font-mono text-xs leading-relaxed">@for (var i = 0; i < _errorInfo.StackTrace.Length; i++)
{<div class="text-zinc-400"><span class="mr-2 select-none text-zinc-600">@(i + 1)</span>@_errorInfo.StackTrace[i]</div>}</pre>
                    </div>

                    @* Suggested fix *@
                    <div class="rounded-md bg-muted/50 p-3">
                        <div class="mb-1.5 flex items-center justify-between">
                            <span class="text-xs font-medium text-muted-foreground">Suggested fix</span>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="h-6 gap-1 px-2 text-xs"
                                      OnClick="HandleCopyFix">
                                @if (_copied)
                                {
                                    <LucideCheckCn Size="12" Class="size-3" />
                                    <text>Copied</text>
                                }
                                else
                                {
                                    <LucideCopyCn Size="12" Class="size-3" />
                                    <text>Copy</text>
                                }
                            </ButtonCn>
                        </div>
                        <p class="text-sm leading-relaxed">@_errorInfo.Fix</p>
                    </div>
                </TabsContentCn>
            </TabsCn>
        </div>
    </div>
</section>

@code {
    private record ResultItem(string Label, string Value, string Type);
    private record LogEntry(string Id, string Timestamp, string Severity, string Message, string? Source = null);
    private record ErrorInfo(string Name, string Message, string Timestamp, string Fix, string[] StackTrace);

    private bool _copied;

    private static readonly Dictionary<string, string> _severityDot = new()
    {
        ["info"] = "bg-blue-500",
        ["warn"] = "bg-amber-500",
        ["error"] = "bg-red-500",
        ["debug"] = "bg-muted-foreground",
    };

    private static readonly ResultItem[] _resultItems =
    [
        new("Operation", "Customer data sync", "string"),
        new("Records Processed", "1,847", "number"),
        new("New Records", "234", "number"),
        new("Updated Records", "1,613", "number"),
        new("Skipped (Duplicates)", "42", "number"),
        new("Avg Processing Time", "3.2ms / record", "string"),
        new("Total Duration", "5.91s", "string"),
        new("Cache Hit Rate", "87.3%", "string"),
    ];

    private static readonly LogEntry[] _logEntries =
    [
        new("l1", "14:23:01.234", "info", "Starting customer data sync operation", "SyncEngine"),
        new("l2", "14:23:01.456", "debug", "Connected to PostgreSQL (pool: 5 connections)", "Database"),
        new("l3", "14:23:02.112", "info", "Fetched 1,889 records from source API", "APIClient"),
        new("l4", "14:23:02.890", "warn", "42 duplicate records detected, skipping", "Deduplicator"),
        new("l5", "14:23:04.567", "info", "Batch 1/4 completed (500 records)", "SyncEngine"),
        new("l6", "14:23:05.234", "info", "Batch 2/4 completed (500 records)", "SyncEngine"),
        new("l7", "14:23:06.012", "warn", "Rate limit approaching (85% of quota)", "APIClient"),
        new("l8", "14:23:06.789", "info", "Batch 3/4 completed (500 records)", "SyncEngine"),
        new("l9", "14:23:07.123", "info", "Batch 4/4 completed (347 records)", "SyncEngine"),
        new("l10", "14:23:07.145", "info", "Sync completed successfully", "SyncEngine"),
    ];

    private static readonly ErrorInfo _errorInfo = new(
        "ConnectionTimeoutError",
        "Failed to connect to Redis cache at redis://cache.internal:6379 after 3 retries",
        "14:23:01.890",
        "The Redis cache connection timed out but the sync continued with direct database reads. Consider increasing the connection timeout or checking the Redis instance health at redis://cache.internal:6379.",
        [
            "at RedisClient.connect (src/lib/redis.ts:45:11)",
            "at CacheLayer.initialize (src/cache/layer.ts:23:5)",
            "at SyncEngine.warmCache (src/sync/engine.ts:89:12)",
            "at SyncEngine.run (src/sync/engine.ts:34:8)",
            "at processTask (src/worker/handler.ts:12:3)",
        ]
    );

    private async Task HandleCopyFix()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
