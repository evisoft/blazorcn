@* ===========================================================
   Block: ai-chat-with-sidebar
   Title: Ai Chat With Sidebar
   Description: AI chat with sidebar, conversation history list, timestamps, search, and two-column grid layout
   Dependencies: ButtonCn, InputCn, LucideArrowUpCn, LucideCheckCn, LucideCopyCn, LucideMessageSquarePlusCn, LucideMoreHorizontalCn, LucideSearchCn
   Source: original/blocks/ai/ai-chat-with-sidebar.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="grid h-[700px] grid-cols-[280px_1fr] overflow-hidden rounded-lg border bg-card">
        @* Sidebar *@
        <div class="flex flex-col border-r">
            <div class="flex items-center justify-between border-b px-4 py-3">
                <span class="text-sm font-medium">Conversations</span>
                <ButtonCn Class="size-7" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon">
                    <LucideMessageSquarePlusCn Size="16" Class="size-4" />
                </ButtonCn>
            </div>

            @* Search *@
            <div class="border-b px-4 py-3">
                <div class="relative">
                    <LucideSearchCn Size="16" Class="absolute left-3 top-1/2 size-3.5 -translate-y-1/2 text-muted-foreground" />
                    <InputCn Class="h-8 border-0 bg-muted/50 pl-9 text-xs shadow-none focus-visible:ring-0"
                             Placeholder="Search conversations..."
                             @bind-Value="_search" />
                </div>
            </div>

            @* Conversation List *@
            <div class="flex-1 overflow-y-auto">
                @{ var filtered = FilteredConversations; }
                @for (var i = 0; i < filtered.Length; i++)
                {
                    var conv = filtered[i];
                    var isLast = i == filtered.Length - 1;
                    var convId = conv.Id;
                    <button type="button"
                            class="@Cn.Merge("flex w-full flex-col gap-0.5 px-4 py-3 text-left transition-colors", _activeConversation == convId ? "bg-muted/50" : "hover:bg-muted/50", !isLast ? "border-b" : "")"
                            @onclick="@(() => _activeConversation = convId)">
                        <div class="flex items-center justify-between gap-2">
                            <span class="truncate text-xs font-medium">@conv.Title</span>
                            @if (conv.Unread)
                            {
                                <span class="size-1.5 shrink-0 rounded-full bg-blue-500"></span>
                            }
                        </div>
                        <div class="flex items-center justify-between gap-2">
                            <span class="truncate text-[11px] text-muted-foreground">@conv.Preview</span>
                            <span class="shrink-0 text-[10px] text-muted-foreground">@conv.Timestamp</span>
                        </div>
                    </button>
                }
            </div>
        </div>

        @* Main Chat *@
        <div class="flex flex-col">
            <div class="flex items-center justify-between border-b px-4 py-3">
                <div class="flex items-center gap-2">
                    <span class="text-sm font-medium">Database migration strategy</span>
                    <span class="text-xs text-muted-foreground">&middot;</span>
                    <span class="text-xs text-muted-foreground">Started 2 minutes ago</span>
                </div>
                <ButtonCn Class="size-7" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon">
                    <LucideMoreHorizontalCn Size="16" Class="size-4" />
                </ButtonCn>
            </div>

            @* Messages *@
            <div class="flex-1 overflow-y-auto">
                <div class="flex flex-col">
                    @for (var i = 0; i < _activeMessages.Length; i++)
                    {
                        var msg = _activeMessages[i];
                        var isLast = i == _activeMessages.Length - 1;
                        var msgId = msg.Id;
                        <div class="@(!isLast ? "border-b" : "")">
                            <div class="px-4 py-3">
                                <div class="flex items-center justify-between">
                                    <span class="mb-1 block text-xs font-medium text-muted-foreground">
                                        @(msg.Role == "user" ? "You" : "AI")
                                    </span>
                                    @if (msg.Role == "assistant")
                                    {
                                        <ButtonCn Class="h-6 gap-1 px-2 text-xs text-muted-foreground"
                                                  Variant="ButtonVariant.Ghost"
                                                  Size="ButtonSize.Sm"
                                                  @onclick="@(() => HandleCopy(msgId))">
                                            @if (_copied == msgId)
                                            {
                                                <LucideCheckCn Size="16" Class="size-3" />
                                                <text>Copied</text>
                                            }
                                            else
                                            {
                                                <LucideCopyCn Size="16" Class="size-3" />
                                                <text>Copy</text>
                                            }
                                        </ButtonCn>
                                    }
                                </div>
                                <p class="whitespace-pre-wrap text-sm leading-relaxed">@msg.Content</p>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Suggestions *@
            <div class="flex flex-wrap gap-1.5 px-4 pb-2">
                @foreach (var s in _suggestions)
                {
                    <button type="button"
                            class="rounded-md bg-muted/50 px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                            @onclick="@(() => _input = s)">
                        @s
                    </button>
                }
            </div>

            @* Input *@
            <div class="border-t px-4 py-3">
                <div class="relative">
                    <TextareaCn Class="min-h-0 max-h-28 resize-none pr-10"
                                rows="1"
                                Placeholder="Ask a follow-up..."
                                @bind-Value="_input" />
                    <ButtonCn Class="absolute right-1 top-1/2 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                              Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost"
                              Disabled="@(string.IsNullOrWhiteSpace(_input))">
                        <LucideArrowUpCn Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record ConversationItem(string Id, string Title, string Preview, string Timestamp, bool Unread = false);
    private record ChatMessage(string Id, string Role, string Content);

    private static readonly ConversationItem[] _conversations =
    {
        new("c1", "Database migration strategy", "Let me outline the best approach for migrating from MySQL to...", "2 min ago", true),
        new("c2", "React performance audit", "I've identified three main bottlenecks in your rendering pipeline...", "1 hr ago"),
        new("c3", "API rate limiting design", "A token bucket algorithm would work well for your use case...", "3 hrs ago"),
        new("c4", "CI/CD pipeline setup", "Here's a GitHub Actions workflow for your monorepo...", "Yesterday"),
        new("c5", "TypeScript strict mode migration", "Start by enabling strictNullChecks first, then gradually...", "Yesterday"),
        new("c6", "Caching strategy for API", "Use a layered approach with in-memory, Redis, and CDN cache...", "Mar 12"),
        new("c7", "Error handling patterns", "The Result type pattern from Rust works great in TypeScript...", "Mar 10")
    };

    private static readonly ChatMessage[] _activeMessages =
    {
        new("m1", "user", "What's the best strategy for migrating a production MySQL database to PostgreSQL with zero downtime?"),
        new("m2", "assistant", "Here's a proven zero-downtime migration strategy using a dual-write approach:\n\nPhase 1: Shadow Writing (Week 1-2)\n- Set up PostgreSQL alongside MySQL\n- Modify your application to write to both databases simultaneously\n- Only read from MySQL during this phase\n- Validate data consistency between both DBs daily\n\nPhase 2: Read Migration (Week 3)\n- Gradually shift read traffic to PostgreSQL (10% then 50% then 100%)\n- Monitor query performance and error rates at each step\n- Keep MySQL as fallback \u2014 instant rollback by redirecting reads\n\nPhase 3: Cutover (Week 4)\n- Stop writes to MySQL\n- Verify final data consistency\n- Update connection strings to point exclusively to PostgreSQL\n- Keep MySQL running for 2 weeks as safety net\n\nKey tools: pgLoader for initial bulk migration, Debezium for change data capture during dual-write phase.\n\nWould you like me to detail the Debezium CDC setup or the data validation scripts?")
    };

    private static readonly string[] _suggestions =
    {
        "Show me the Debezium config",
        "What about schema differences?",
        "How do I handle stored procedures?"
    };

    private string _activeConversation = "c1";
    private string _search = "";
    private string _input = "";
    private string? _copied;

    private ConversationItem[] FilteredConversations =>
        string.IsNullOrWhiteSpace(_search)
            ? _conversations
            : _conversations.Where(c =>
                c.Title.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                c.Preview.Contains(_search, StringComparison.OrdinalIgnoreCase)).ToArray();

    private async Task HandleCopy(string id)
    {
        _copied = id;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = null;
    }
}
