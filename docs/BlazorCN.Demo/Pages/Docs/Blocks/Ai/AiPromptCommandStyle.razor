@* ===========================================================
   Block: ai-prompt-command-style
   Title: Ai Prompt Command Style
   Description: React AI command-style prompt block for Next.js with terminal aesthetic, command autocomplete, and history navigation using shadcn/ui and Tailwind CSS
   Long Description: React AI Product Description Block
   Dependencies: None
   Source: original/blocks/ai/ai-prompt-command-style.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border border-zinc-800 bg-zinc-950">
        @* Title bar *@
        <div class="flex items-center gap-2 border-b border-zinc-800 px-4 py-2.5">
            <div class="flex gap-1.5">
                <span class="size-2.5 rounded-full bg-zinc-700"></span>
                <span class="size-2.5 rounded-full bg-zinc-700"></span>
                <span class="size-2.5 rounded-full bg-zinc-700"></span>
            </div>
            <span class="flex-1 text-center font-mono text-xs text-zinc-500">ai-assistant</span>
            <div class="w-[46px]"></div>
        </div>

        @* History output *@
        <div class="max-h-48 overflow-y-auto">
            <div class="space-y-1 p-4 font-mono text-sm">
                @foreach (var cmd in _history)
                {
                    <div class="flex items-start gap-2">
                        <LucideChevronRightCn Class="mt-0.5 size-3 shrink-0 text-zinc-600" />
                        <span class="text-zinc-500">@cmd</span>
                    </div>
                }
            </div>
        </div>

        @* Input area *@
        <div class="relative border-t border-zinc-800">
            <div class="flex items-center gap-2 px-4 py-3">
                <LucideChevronRightCn Class="size-3.5 shrink-0 text-zinc-600" />
                <InputCn
                    @bind-Value="_input"
                    Placeholder="Type a command or ask a question..."
                    Class="flex-1 font-mono text-zinc-200 placeholder:text-zinc-700"
                    spellcheck="false"
                    autocomplete="off" />
            </div>

            @* Hints *@
            <div class="flex items-center gap-4 border-t border-zinc-800/50 px-4 py-1.5">
                <span class="font-mono text-[10px] text-zinc-700">
                    <kbd class="rounded bg-zinc-800/50 px-1">Tab</kbd> autocomplete
                </span>
                <span class="font-mono text-[10px] text-zinc-700">
                    <kbd class="rounded bg-zinc-800/50 px-1">&uarr;&darr;</kbd> history
                </span>
                <span class="font-mono text-[10px] text-zinc-700">
                    <kbd class="rounded bg-zinc-800/50 px-1">Enter</kbd> send
                </span>
            </div>
        </div>
    </div>
</section>

@code {
    private string _input = "";

    private static readonly List<string> _history = new()
    {
        "/ask What is the best way to handle auth in Next.js?",
        "/code Create a React hook for debounced search",
        "/search find all uses of useEffect in the project",
    };
}
