@* ===========================================================
   Block: ai-prompt-input
   Title: Ai Prompt Input
   Description: AI chat input with expandable textarea, voice recording, file attachments, and contextual action menu
   Dependencies: ButtonCn, DropdownMenuCn, LucideArrowUpCn, LucideMicCn, LucidePaperclipCn, LucidePlusCn, LucideSearchCn, LucideSparklesCn
   Source: original/blocks/ai/ai-prompt-input.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Textarea *@
        <div class="px-4 pb-2 pt-3">
            <textarea @bind="_message" @bind:event="oninput"
                      placeholder="Ask anything..."
                      rows="1"
                      class="w-full min-h-[24px] max-h-52 resize-none bg-transparent text-sm leading-relaxed outline-none placeholder:text-muted-foreground"></textarea>
        </div>

        @* Footer *@
        <div class="flex items-center gap-1.5 px-3 py-2">
            <DropdownMenuCn>
                <DropdownMenuTriggerCn>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                        <LucidePlusCn Size="16" Class="size-4 text-muted-foreground" />
                    </ButtonCn>
                </DropdownMenuTriggerCn>
                <DropdownMenuContentCn Align="FloatingAlign.Start" Class="w-48">
                    <DropdownMenuGroupCn>
                        <DropdownMenuItemCn>
                            <LucidePaperclipCn Size="16" Class="mr-2 size-4 text-muted-foreground" />
                            Add files
                        </DropdownMenuItemCn>
                        <DropdownMenuItemCn>
                            <LucideSparklesCn Size="16" Class="mr-2 size-4 text-muted-foreground" />
                            Agent mode
                        </DropdownMenuItemCn>
                        <DropdownMenuItemCn>
                            <LucideSearchCn Size="16" Class="mr-2 size-4 text-muted-foreground" />
                            Deep Research
                        </DropdownMenuItemCn>
                    </DropdownMenuGroupCn>
                </DropdownMenuContentCn>
            </DropdownMenuCn>

            <div class="ml-auto flex items-center gap-1">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 w-7 p-0">
                    <LucideMicCn Size="16" Class="size-4 text-muted-foreground" />
                </ButtonCn>

                @if (!string.IsNullOrWhiteSpace(_message))
                {
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 w-7 rounded-full p-0"
                              @onclick="HandleSubmit">
                        <LucideArrowUpCn Size="16" Class="size-4" />
                    </ButtonCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private string _message = "";

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_message))
            _message = "";
    }
}
