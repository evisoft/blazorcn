@* ===========================================================
   Block: ai-agent-workflow
   Title: Ai Agent Workflow
   Description: React AI agent workflow block for Next.js with vertical timeline, step status indicators, duration tracking, and animated progress using shadcn/ui and Tailwind CSS
   Long Description: React AI Agent Task Queue Block
   Dependencies: ButtonCn
   Source: original/blocks/ai/ai-agent-workflow.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex-1">
                <span class="font-medium text-sm">Agent Workflow</span>
                <p class="text-muted-foreground text-xs">Refactoring authentication module</p>
            </div>
            <span class="font-mono text-muted-foreground text-xs">
                @_completedCount/@_workflowSteps.Count
            </span>
            <div class="flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @_completedCount
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @(_workflowSteps.Count(s => s.Status == "running"))
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-muted-foreground/30"></span>
                    @(_workflowSteps.Count(s => s.Status == "pending"))
                </span>
            </div>
        </div>

        @* Steps *@
        <div>
            @for (var i = 0; i < _workflowSteps.Count; i++)
            {
                var step = _workflowSteps[i];
                var isExpanded = _expanded == step.Id;
                var isLast = i == _workflowSteps.Count - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="() => _expanded = isExpanded ? null : step.Id"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", _statusDot[step.Status])"></span>
                        <div class="min-w-0 flex-1">
                            <span class="@Cn.Merge("font-medium text-sm", step.Status == "pending" ? "text-muted-foreground" : "")">
                                @step.Title
                            </span>
                            <p class="mt-0.5 truncate text-muted-foreground text-xs">
                                @step.Description
                            </p>
                        </div>
                        @if (step.Duration != null)
                        {
                            <span class="shrink-0 font-mono text-muted-foreground text-xs">
                                @step.Duration
                            </span>
                        }
                        @if (step.Status == "running" && step.Duration == null)
                        {
                            <span class="flex items-center gap-1.5 shrink-0 text-muted-foreground text-xs">
                                <span class="size-1.5 animate-pulse rounded-full bg-blue-500"></span>
                                Running
                            </span>
                        }
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded && step.Output != null)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-1.5 flex items-center justify-between">
                                    <span class="font-medium text-muted-foreground text-xs">Output</span>
                                    <ButtonCn
                                        Variant="ButtonVariant.Ghost"
                                        Size="ButtonSize.Sm"
                                        Class="h-6 gap-1 px-2 text-xs">
                                        @if (_copied == step.Id)
                                        {
                                            <LucideCheckCn Size="12" Class="size-3" />
                                            <span>Copied</span>
                                        }
                                        else
                                        {
                                            <LucideCopyCn Size="12" Class="size-3" />
                                            <span>Copy</span>
                                        }
                                    </ButtonCn>
                                </div>
                                <p class="font-mono text-sm leading-relaxed">@step.Output</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private string? _expanded = "s3";
    private string? _copied = null;

    private record WorkflowStep(string Id, string Title, string Description, string Status, string? Duration = null, string? Output = null);

    private static readonly Dictionary<string, string> _statusDot = new()
    {
        ["completed"] = "bg-emerald-500",
        ["running"] = "bg-blue-500",
        ["pending"] = "bg-muted-foreground/30",
    };

    private List<WorkflowStep> _workflowSteps = new()
    {
        new("s1", "Understanding request", "Parsing user intent and extracting key requirements", "completed", "0.8s", "Identified: refactor authentication module to use JWT tokens"),
        new("s2", "Searching codebase", "Finding relevant files and dependencies across the project", "completed", "2.1s", "Found 12 files across auth/, middleware/, and utils/ directories"),
        new("s3", "Analyzing results", "Evaluating code patterns and identifying change requirements", "completed", "1.5s", "3 breaking changes detected, 2 deprecated API calls to update"),
        new("s4", "Generating solution", "Writing code changes and creating migration plan", "running"),
        new("s5", "Running tests", "Executing test suite to validate changes", "pending"),
    };

    private int _completedCount => _workflowSteps.Count(s => s.Status == "completed");
}
