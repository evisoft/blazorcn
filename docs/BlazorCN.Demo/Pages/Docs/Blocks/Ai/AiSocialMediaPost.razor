@* ===========================================================
   Block: ai-social-media-post
   Title: Ai Social Media Post
   Description: React AI social media post generator block for Next.js with platform tabs, character count progress, post preview cards, and hashtag suggestions using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/ai/ai-social-media-post.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Platform tabs *@
        <div class="flex items-center border-b">
            @foreach (var key in _platformKeys)
            {
                <button
                    type="button"
                    @onclick="@(() => _activePlatform = key)"
                    class="@Cn.Merge("flex-1 px-4 py-2.5 text-xs font-medium transition-colors", _activePlatform == key ? "border-b-2 border-foreground text-foreground" : "text-muted-foreground hover:text-foreground")">
                    @_platforms[key].Label
                </button>
            }
        </div>

        @* Editor *@
        <div class="border-b px-4 py-3">
            <TextareaCn @bind-Value="_posts[_activePlatform]"
                Placeholder="@($"Write your {_platforms[_activePlatform].Label} post...")"
                rows="6"
                Class="resize-none p-0 text-sm leading-relaxed" />
            <div class="mt-2 flex items-center justify-between">
                <span class="@Cn.Merge("font-mono text-xs", _isOverLimit ? "text-red-600 dark:text-red-400" : "text-muted-foreground")">
                    @_charUsed
                    <span class="text-muted-foreground"> / @_platforms[_activePlatform].CharLimit</span>
                    @if (_isOverLimit)
                    {
                        <span class="ml-2 text-red-600 dark:text-red-400">
                            +@(_charUsed - _platforms[_activePlatform].CharLimit)
                        </span>
                    }
                </span>
                <div class="flex items-center gap-2">
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                        @if (_copied)
                        {
                            <LucideCheckCn Size="12" Class="size-3" />
                            <span>Copied</span>
                        }
                        else
                        {
                            <LucideCopyCn Size="12" Class="size-3" />
                            <span>Copy</span>
                        }
                    </ButtonCn>
                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                        Regenerate
                    </ButtonCn>
                </div>
            </div>
        </div>

        @* Preview *@
        <div class="border-b px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">Preview</span>
            <div class="mt-2 flex gap-3">
                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium text-muted-foreground">
                    A
                </div>
                <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2">
                        <span class="font-medium text-sm">Acme Inc.</span>
                        <span class="text-muted-foreground text-xs">@@acmeinc</span>
                        <span class="text-muted-foreground text-xs">· 2m</span>
                    </div>
                    <p class="mt-1 whitespace-pre-line text-sm leading-relaxed">
                        @_posts[_activePlatform]
                    </p>
                </div>
            </div>
        </div>

        @* Hashtags *@
        <div class="px-4 py-3">
            <span class="font-medium text-xs text-muted-foreground">Suggested hashtags</span>
            <div class="mt-2 flex flex-wrap gap-1.5">
                @foreach (var tag in _platforms[_activePlatform].Hashtags)
                {
                    <BadgeCn
                        Variant="@(_posts[_activePlatform].Contains(tag) ? BadgeVariant.Default : BadgeVariant.Outline)"
                        class="cursor-pointer font-normal text-xs transition-colors"
                        @onclick="@(() => AddHashtag(tag))">
                        @tag
                    </BadgeCn>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private record PlatformConfig(string Label, int CharLimit, string Content, string[] Hashtags);

    private static readonly Dictionary<string, PlatformConfig> _platforms = new()
    {
        ["twitter"] = new("Twitter / X", 280,
            "Just shipped our new AI-powered analytics dashboard. Real-time insights, predictive models, and zero config required.\n\nWent from idea to production in 2 weeks using @nextjs and @vercel.\n\nThe future of data-driven decisions is here.",
            ["#buildinpublic", "#nextjs", "#ai", "#saas", "#startup", "#webdev", "#typescript", "#analytics"]),
        ["linkedin"] = new("LinkedIn", 3000,
            "Excited to announce that we just launched our AI-powered analytics dashboard!\n\nAfter months of development, here's what makes it special:\n\n1. Real-time data processing with sub-second latency\n2. Predictive analytics powered by GPT-4 Turbo\n3. Zero-config setup \u2014 connect your data source and go\n4. Enterprise-grade security with SOC 2 compliance\n\nThe response from our beta users has been incredible:\n\u2022 73% reduction in time-to-insight\n\u2022 4.8/5 average satisfaction score\n\u2022 12 enterprise contracts signed in week one\n\nBuilding this taught me that the best developer tools are the ones that get out of your way. We obsessed over reducing configuration to zero while keeping the power users happy.\n\nIf you're interested in trying it out, drop a comment or DM me. We're offering 30-day free trials for the next 100 sign-ups.\n\nWhat's the biggest analytics challenge your team faces?",
            ["#analytics", "#ai", "#startup", "#product", "#leadership", "#technology", "#data", "#saas"]),
        ["instagram"] = new("Instagram", 2200,
            "From whiteboard sketch to production in 14 days. Our new AI analytics dashboard is live and it's beautiful.\n\nSwipe to see the before & after of our data visualization journey.\n\nEvery pixel was crafted to make complex data feel simple. Because good design isn't about making things pretty \u2014 it's about making things clear.\n\nLink in bio for early access.",
            ["#uidesign", "#ai", "#analytics", "#startup", "#techstartup", "#design", "#react", "#webdesign"]),
    };

    private static readonly string[] _platformKeys = ["twitter", "linkedin", "instagram"];

    private string _activePlatform = "twitter";
    private Dictionary<string, string> _posts = new()
    {
        ["twitter"] = _platforms["twitter"].Content,
        ["linkedin"] = _platforms["linkedin"].Content,
        ["instagram"] = _platforms["instagram"].Content,
    };
    private bool _copied = false;

    private int _charUsed => _posts[_activePlatform].Length;
    private bool _isOverLimit => _charUsed > _platforms[_activePlatform].CharLimit;

    private void AddHashtag(string tag)
    {
        if (!_posts[_activePlatform].Contains(tag))
        {
            _posts[_activePlatform] = $"{_posts[_activePlatform]} {tag}";
        }
    }
}
