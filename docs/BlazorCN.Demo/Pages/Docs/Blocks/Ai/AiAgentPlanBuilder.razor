@* ===========================================================
   Block: ai-agent-plan-builder
   Title: Ai Agent Plan Builder
   Description: React AI agent plan builder block for Next.js with editable steps, progress tracking, estimated durations, and step completion using shadcn/ui and Tailwind CSS
   Long Description: React AI Agent Multi-Step Block
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/ai/ai-agent-plan-builder.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex-1">
                <span class="font-medium text-sm">Execution Plan</span>
                <p class="text-muted-foreground text-xs">Migrate authentication to JWT</p>
            </div>
            <span class="font-mono text-muted-foreground text-xs">
                @_completedCount/@_steps.Count
            </span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_progressPercent%
            </BadgeCn>
        </div>

        @* Progress bar *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <div class="h-1 flex-1 overflow-hidden rounded-full bg-muted">
                <div
                    class="h-full rounded-full bg-foreground transition-all duration-300"
                    style="width: @(_progressPercent)%">
                </div>
            </div>
            <span class="shrink-0 text-muted-foreground text-xs">~@_remainingTime min left</span>
        </div>

        @* Steps *@
        <div>
            @for (var i = 0; i < _steps.Count; i++)
            {
                var step = _steps[i];
                var isExpanded = _expanded == step.Id;
                var isLast = i == _steps.Count - 1;
                var index = i;

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="() => _expanded = isExpanded ? null : step.Id"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        @* Step number / check *@
                        <span class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded-full text-[10px] font-medium", step.Completed ? "bg-emerald-500 text-white" : "border border-border text-muted-foreground")">
                            @if (step.Completed)
                            {
                                <LucideCheckCn Size="12" Class="size-3" />
                            }
                            else
                            {
                                @(index + 1)
                            }
                        </span>

                        <div class="min-w-0 flex-1">
                            <span class="@Cn.Merge("font-medium text-sm", step.Completed ? "text-muted-foreground line-through" : "")">
                                @step.Title
                            </span>
                        </div>

                        <span class="shrink-0 font-mono text-muted-foreground text-xs">
                            @step.EstimatedTime
                        </span>

                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-12">
                            <p class="mb-3 text-muted-foreground text-sm leading-relaxed">
                                @step.Description
                            </p>
                            <button
                                type="button"
                                @onclick="() => ToggleStep(step.Id)"
                                class="@Cn.Merge("inline-flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs transition-colors", step.Completed ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-muted/50 text-muted-foreground hover:bg-muted")">
                                @if (step.Completed)
                                {
                                    <LucideCheckCn Size="12" Class="size-3" />
                                    <span>Completed</span>
                                }
                                else
                                {
                                    <span>Mark complete</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <span class="text-muted-foreground text-xs">Total: ~@_totalTime min</span>
            <div class="flex gap-2">
                <ButtonCn
                    Variant="ButtonVariant.Outline"
                    Size="ButtonSize.Sm"
                    Class="h-7 text-xs">
                    Reset
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Execute Plan
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private string? _expanded = "p3";

    private record PlanStep(string Id, string Title, string Description, string EstimatedTime, bool Completed);

    private List<PlanStep> _steps = new()
    {
        new("p1", "Audit existing authentication flow",
            "Review current session-based auth implementation, identify all login/logout/refresh touchpoints, and document the token lifecycle.",
            "2 min", true),
        new("p2", "Create JWT utility module",
            "Implement token generation with RS256 signing, verification middleware, and refresh token rotation logic with configurable expiry.",
            "5 min", true),
        new("p3", "Migrate user sessions to JWT",
            "Replace express-session with JWT-based stateless auth. Update login endpoint to return access and refresh tokens instead of setting session cookies.",
            "8 min", false),
        new("p4", "Update protected route middleware",
            "Refactor authorization middleware to validate JWT from Authorization header. Add role-based access control claims parsing.",
            "4 min", false),
        new("p5", "Write tests and validate migration",
            "Add unit tests for token generation and verification, integration tests for the full auth flow, and run the existing e2e suite to confirm no regressions.",
            "6 min", false),
    };

    private int _completedCount => _steps.Count(s => s.Completed);
    private int _progressPercent => _steps.Count > 0 ? (int)Math.Round((double)_completedCount / _steps.Count * 100) : 0;
    private int _totalTime => _steps.Sum(s => int.TryParse(s.EstimatedTime.Replace(" min", ""), out var t) ? t : 0);
    private int _remainingTime => _steps.Where(s => !s.Completed).Sum(s => int.TryParse(s.EstimatedTime.Replace(" min", ""), out var t) ? t : 0);

    private void ToggleStep(string id)
    {
        var idx = _steps.FindIndex(s => s.Id == id);
        if (idx >= 0)
        {
            var step = _steps[idx];
            _steps[idx] = step with { Completed = !step.Completed };
        }
    }
}
