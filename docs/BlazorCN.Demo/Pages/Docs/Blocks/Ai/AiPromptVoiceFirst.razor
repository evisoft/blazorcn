@* ===========================================================
   Block: ai-prompt-voice-first
   Title: Ai Prompt Voice First
   Description: AI voice-first prompt with large microphone button, waveform visualization, and transcript display
   Dependencies: ButtonCn, LucideArrowUpCn, LucideKeyboardCn, LucideMicCn, LucideSquareCn
   Source: original/blocks/ai/ai-prompt-voice-first.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-lg p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Mode selector *@
        <div class="flex items-center gap-1 border-b px-4 py-2.5">
            <button type="button"
                    class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs transition-colors", _activeMode == "voice" ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50")"
                    @onclick="@(() => _activeMode = "voice")">
                <LucideMicCn Size="16" Class="size-3" />
                Voice
            </button>
            <button type="button"
                    class="@Cn.Merge("flex items-center gap-1.5 rounded-md px-2.5 py-1 text-xs transition-colors", _activeMode == "text" ? "bg-muted font-medium text-foreground" : "text-muted-foreground hover:bg-muted/50")"
                    @onclick="@(() => _activeMode = "text")">
                <LucideKeyboardCn Size="16" Class="size-3" />
                Text
            </button>
        </div>

        @if (_activeMode == "voice")
        {
            @* Voice recording area *@
            <div class="flex flex-col items-center gap-4 px-4 py-6">
                @* Microphone button *@
                <div class="relative">
                    @if (_isRecording)
                    {
                        <span class="absolute inset-0 animate-ping rounded-full bg-red-500/20"></span>
                    }
                    <ButtonCn Size="ButtonSize.Icon"
                              Variant="@(_isRecording ? ButtonVariant.Destructive : ButtonVariant.Outline)"
                              Class="@Cn.Merge("relative z-10 size-16 rounded-full transition-all duration-300", _isRecording ? "scale-110" : "")"
                              @onclick="ToggleRecording">
                        @if (_isRecording)
                        {
                            <LucideSquareCn Size="16" Class="size-5 fill-current" />
                        }
                        else
                        {
                            <LucideMicCn Size="16" Class="size-6" />
                        }
                    </ButtonCn>
                </div>

                <span class="text-xs text-muted-foreground">
                    @(_isRecording ? "Listening... tap to stop" : "Tap to start speaking")
                </span>

                @* Waveform *@
                <div class="flex h-10 w-full items-center justify-center gap-[3px]">
                    @for (var i = 0; i < _waveformHeights.Length; i++)
                    {
                        <div class="@Cn.Merge("w-1 rounded-full transition-all", _isRecording ? "bg-foreground/30" : "bg-muted-foreground/20")"
                             style="@($"height: {_waveformHeights[i]}px; transition-duration: 100ms;")"></div>
                    }
                </div>
            </div>

            @* Transcript *@
            @if (!string.IsNullOrEmpty(_transcript))
            {
                <div class="border-t px-4 py-3">
                    <div class="rounded-md bg-muted/50 p-3">
                        <span class="mb-1 block text-xs font-medium text-muted-foreground">
                            Transcript
                        </span>
                        <p class="text-sm leading-relaxed">@_transcript</p>
                    </div>
                    <div class="mt-2 flex items-center justify-between">
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs"
                                  @onclick="@(() => _transcript = "")">
                            Clear
                        </ButtonCn>
                        <ButtonCn Size="ButtonSize.Sm" Class="h-7 w-7 rounded-full p-0"
                                  @onclick="HandleSubmit">
                            <LucideArrowUpCn Size="16" Class="size-4" />
                        </ButtonCn>
                    </div>
                </div>
            }
        }
        else
        {
            @* Text input area *@
            <div class="px-4 pb-2 pt-3">
                <TextareaCn @bind-Value="_textInput"
                            Placeholder="Type your question here..."
                            rows="4"
                            Class="min-h-[100px] max-h-48 resize-none leading-relaxed" />
            </div>
            <div class="flex items-center justify-between border-t px-4 py-2.5">
                <span class="text-xs text-muted-foreground">
                    Enter to send, Shift+Enter for new line
                </span>
                @if (!string.IsNullOrWhiteSpace(_textInput))
                {
                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 w-7 rounded-full p-0"
                              @onclick="HandleSubmit">
                        <LucideArrowUpCn Size="16" Class="size-4" />
                    </ButtonCn>
                }
            </div>
        }
    </div>
</section>

@code {
    private const string SampleTranscript = "How do I implement authentication with Next.js and Better Auth?";

    private bool _isRecording;
    private string _transcript = "";
    private string _textInput = "";
    private string _activeMode = "voice";
    private int[] _waveformHeights = Enumerable.Repeat(4, 24).ToArray();

    private void ToggleRecording()
    {
        if (_isRecording)
        {
            _isRecording = false;
            _transcript = SampleTranscript;
            _waveformHeights = Enumerable.Repeat(4, 24).ToArray();
        }
        else
        {
            _isRecording = true;
            _transcript = "";
        }
    }

    private void HandleSubmit()
    {
        var content = _activeMode == "voice" ? _transcript : _textInput;
        if (string.IsNullOrWhiteSpace(content)) return;
        _transcript = "";
        _textInput = "";
        _isRecording = false;
    }
}
