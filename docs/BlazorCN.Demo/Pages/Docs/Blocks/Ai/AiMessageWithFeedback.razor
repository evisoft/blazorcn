@* ===========================================================
   Block: ai-message-with-feedback
   Title: Ai Message With Feedback
   Description: AI message with detailed feedback mechanism, star rating, category tags, and text input
   Dependencies: BadgeCn, ButtonCn, LucideCheckCn, LucideMessageSquareCn, LucideSendCn, LucideStarCn, LucideXCn
   Source: original/blocks/ai/ai-message-with-feedback.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideMessageSquareCn Size="16" Class="size-4 text-muted-foreground" />
                <span class="text-sm font-medium">Rate this response</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="size-7 p-0"
                      @onclick="@(() => _submitted = false)">
                <LucideXCn Size="16" Class="size-3.5" />
            </ButtonCn>
        </div>

        @if (_submitted)
        {
            <div class="flex flex-col items-center gap-1.5 px-4 py-8">
                <div class="flex size-8 items-center justify-center rounded-full bg-muted/50">
                    <LucideCheckCn Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                </div>
                <span class="text-sm font-medium">Thank you for your feedback</span>
                <span class="text-xs text-muted-foreground">
                    Your input helps us improve response quality.
                </span>
            </div>
        }
        else
        {
            @* Star rating *@
            <div class="border-b px-4 py-3">
                <div class="flex items-center gap-1">
                    @for (var s = 1; s <= 5; s++)
                    {
                        var star = s;
                        <button type="button"
                                class="rounded p-0.5 transition-transform hover:scale-110"
                                @onclick="@(() => _rating = star)"
                                @onmouseenter="@(() => _hoveredStar = star)"
                                @onmouseleave="@(() => _hoveredStar = 0)">
                            <LucideStarCn Size="16" Class="@Cn.Merge("size-5 transition-colors", star <= ActiveStars ? "fill-amber-400 text-amber-400" : "text-muted-foreground/25")" />
                        </button>
                    }
                    @if (_rating > 0)
                    {
                        <span class="ml-2 text-xs text-muted-foreground">@GetRatingLabel(_rating)</span>
                    }
                </div>
            </div>

            @* Category tags *@
            <div class="border-b px-4 py-3">
                <span class="mb-2 block text-xs text-muted-foreground">
                    What describes this response?
                </span>
                <div class="flex flex-wrap gap-1.5">
                    @foreach (var category in _categories)
                    {
                        var cat = category;
                        var isSelected = _selectedCategories.Contains(cat);
                        <button type="button" @onclick="@(() => ToggleCategory(cat))">
                            <BadgeCn Variant="@(isSelected ? BadgeVariant.Default : BadgeVariant.Outline)"
                                     Class="cursor-pointer text-xs transition-colors">
                                @cat
                            </BadgeCn>
                        </button>
                    }
                </div>
            </div>

            @* Comment + Submit *@
            <div class="px-4 py-3">
                <textarea @bind="_comment"
                          placeholder="Additional comments (optional)..."
                          rows="2"
                          class="mb-3 w-full resize-none border-0 bg-transparent px-0 text-sm shadow-none focus-visible:outline-none focus-visible:ring-0"></textarea>
                <div class="flex justify-end">
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                              Class="h-7 gap-1.5 text-xs"
                              Disabled="@(_rating == 0)"
                              @onclick="@(() => _submitted = true)">
                        <LucideSendCn Size="16" Class="size-3" />
                        Submit
                    </ButtonCn>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private static readonly string[] _categories =
    {
        "Accurate", "Helpful", "Clear", "Well-structured",
        "Creative", "Too long", "Incomplete", "Incorrect"
    };

    private int _rating;
    private int _hoveredStar;
    private readonly HashSet<string> _selectedCategories = new();
    private string _comment = "";
    private bool _submitted;

    private int ActiveStars => _hoveredStar > 0 ? _hoveredStar : _rating;

    private void ToggleCategory(string category)
    {
        if (!_selectedCategories.Remove(category))
            _selectedCategories.Add(category);
    }

    private static string GetRatingLabel(int rating) => rating switch
    {
        1 => "Poor",
        2 => "Fair",
        3 => "Good",
        4 => "Very good",
        5 => "Excellent",
        _ => ""
    };
}
