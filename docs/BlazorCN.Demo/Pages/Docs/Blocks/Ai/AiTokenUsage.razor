@* ===========================================================
   Block: ai-token-usage
   Title: Ai Token Usage
   Description: React AI token usage breakdown block for Next.js with circular progress, stacked bars, and conversation history using shadcn/ui and Tailwind CSS
   Long Description:
   Dependencies: BadgeCn
   Source: original/blocks/ai/ai-token-usage.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Usage summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="@Cn.Merge("font-semibold text-2xl tabular-nums", _pctColor)">@_pct%</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                @_assessment
            </BadgeCn>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="font-mono text-muted-foreground text-xs">
                @FormatTokens(_usedTokens) / @FormatTokens(_totalTokens)
            </span>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-foreground/40"></span>
                    Prompt
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-foreground/20"></span>
                    Completion
                </span>
                <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-foreground/10"></span>
                    System
                </span>
            </div>
        </div>

        @* Stacked bar *@
        <div class="border-b px-4 py-3">
            <div class="flex h-2 w-full overflow-hidden rounded-full bg-muted">
                <div class="bg-foreground/40 transition-all" style="width: @($"{(double)_promptTokens / _totalTokens * 100:F1}")%"></div>
                <div class="bg-foreground/20 transition-all" style="width: @($"{(double)_completionTokens / _totalTokens * 100:F1}")%"></div>
                <div class="bg-foreground/10 transition-all" style="width: @($"{(double)_systemTokens / _totalTokens * 100:F1}")%"></div>
            </div>
            <div class="mt-2 flex items-center gap-4">
                <span class="font-mono text-muted-foreground text-xs">
                    Prompt: @FormatTokens(_promptTokens)
                </span>
                <span class="font-mono text-muted-foreground text-xs">
                    Completion: @FormatTokens(_completionTokens)
                </span>
                <span class="font-mono text-muted-foreground text-xs">
                    System: @FormatTokens(_systemTokens)
                </span>
            </div>
        </div>

        @* Alert *@
        @if (_pct >= 75)
        {
            <div class="border-b px-4 py-3">
                <div class="rounded-md bg-muted/50 p-3">
                    <span class="font-medium text-muted-foreground text-xs">Usage warning</span>
                    <p class="mt-1 text-sm leading-relaxed">
                        You have used @(_pct)% of your monthly token limit. Consider upgrading your plan or
                        optimizing prompt lengths.
                    </p>
                </div>
            </div>
        }

        @* Recent conversations *@
        <div>
            <button
                type="button"
                @onclick="() => _showConversations = !_showConversations"
                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                <span class="font-medium text-sm">Recent Conversations</span>
                <span class="text-muted-foreground text-xs">@_conversations.Count</span>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("ml-auto size-4 text-muted-foreground/60 transition-transform duration-200", _showConversations ? "rotate-90" : "")" />
            </button>
            @if (_showConversations)
            {
                <div>
                    @for (var i = 0; i < _conversations.Count; i++)
                    {
                        var conv = _conversations[i];
                        var isLast = i == _conversations.Count - 1;

                        <div class="@Cn.Merge("flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50", isLast ? "" : "border-b")">
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-sm">@conv.Title</span>
                                <p class="text-muted-foreground text-xs">@conv.Timestamp</p>
                            </div>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-mono text-xs">
                                @FormatTokens(conv.Tokens)
                            </BadgeCn>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private bool _showConversations = false;

    private const int _totalTokens = 5000000;
    private const int _usedTokens = 3750000;
    private const int _promptTokens = 1800000;
    private const int _completionTokens = 1500000;
    private const int _systemTokens = 450000;
    private int _pct => (int)Math.Round((double)_usedTokens / _totalTokens * 100);

    private record ConversationEntry(string Title, int Tokens, string Timestamp);

    private static readonly List<ConversationEntry> _conversations = new()
    {
        new("Quarterly report analysis", 48200, "Today, 2:34 PM"),
        new("Marketing copy generation", 32100, "Today, 11:15 AM"),
        new("Code review assistant", 27800, "Yesterday, 4:52 PM"),
        new("Customer email drafts", 15600, "Yesterday, 10:30 AM"),
        new("API documentation writer", 41300, "Mar 12, 3:20 PM"),
    };

    private string _pctColor => _pct >= 90
        ? "text-red-600 dark:text-red-400"
        : _pct >= 75
            ? "text-amber-600 dark:text-amber-400"
            : "text-emerald-600 dark:text-emerald-400";

    private string _assessment => _pct >= 90 ? "Critical" : _pct >= 75 ? "Warning" : "Normal";

    private static string FormatTokens(int n)
    {
        if (n >= 1000000) return $"{n / 1000000.0:F1}M";
        if (n >= 1000) return $"{n / 1000}K";
        return n.ToString();
    }
}
