@* ===========================================================
   Block: ai-resume-builder
   Title: Ai Resume Builder
   Description: AI resume builder with form sections, live preview, and floating AI improvement suggestions
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideCheckCn, LucideChevronRightCn, LucideCopyCn, LucideDownloadCn, LucideXCn
   Source: original/blocks/ai/ai-resume-builder.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div>
                <span class="text-sm font-medium">Resume Builder</span>
                <p class="text-xs text-muted-foreground">
                    Edit sections and preview with AI suggestions
                </p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 text-xs">
                <LucideDownloadCn Size="16" Class="size-3" />
                Export
            </ButtonCn>
        </div>

        @* Personal Info *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Personal Information</span>
            <div class="mt-2 grid gap-2 sm:grid-cols-2">
                <InputCn @bind-Value="_name" Placeholder="Full name" Class="h-8 text-sm" />
                <InputCn @bind-Value="_title" Placeholder="Job title" Class="h-8 text-sm" />
            </div>
            <div class="mt-2 grid gap-2 sm:grid-cols-3">
                <InputCn @bind-Value="_email" Placeholder="Email" Class="h-8 text-sm" />
                <InputCn @bind-Value="_phone" Placeholder="Phone" Class="h-8 text-sm" />
                <InputCn @bind-Value="_location" Placeholder="Location" Class="h-8 text-sm" />
            </div>
            <textarea @bind="_summary"
                      rows="2"
                      placeholder="Professional summary..."
                      class="mt-2 w-full resize-none rounded-md border bg-background px-3 py-2 text-sm"></textarea>
        </div>

        @* Experience *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Experience</span>
            @for (var i = 0; i < _experiences.Count; i++)
            {
                var exp = _experiences[i];
                var isLast = i == _experiences.Count - 1;
                <div class="@($"mt-2 {(isLast ? "" : "border-b pb-3")}")">
                    <div class="grid gap-2 sm:grid-cols-2">
                        <InputCn Value="@exp.Company" ValueChanged="@(v => exp.Company = v)" Placeholder="Company" Class="h-8 text-sm" />
                        <InputCn Value="@exp.Role" ValueChanged="@(v => exp.Role = v)" Placeholder="Role" Class="h-8 text-sm" />
                    </div>
                    <InputCn Value="@exp.Period" ValueChanged="@(v => exp.Period = v)" Placeholder="Period" Class="mt-2 h-8 text-sm" />
                    <textarea @bind="exp.Description"
                              rows="2"
                              placeholder="Description..."
                              class="mt-2 w-full resize-none rounded-md border bg-background px-3 py-2 text-sm"></textarea>
                </div>
            }
        </div>

        @* Skills *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Skills</span>
            <div class="mt-2 flex flex-wrap gap-1">
                @foreach (var skill in _skills)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                        @skill
                    </BadgeCn>
                }
            </div>
        </div>

        @* Preview *@
        <div class="border-b">
            <div class="bg-zinc-950 px-4 py-4">
                <p class="text-sm font-semibold text-white">@_name</p>
                <p class="text-xs text-zinc-400">@_title</p>
                <div class="mt-1.5 flex flex-wrap gap-x-3 text-[11px] text-zinc-500">
                    <span>@_email</span>
                    <span>@_phone</span>
                    <span>@_location</span>
                </div>
            </div>
            <div class="px-4 py-3">
                <p class="mb-1 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Summary
                </p>
                <p class="text-xs leading-relaxed text-muted-foreground">@_summary</p>

                <p class="mb-1 mt-3 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Experience
                </p>
                @foreach (var exp in _experiences)
                {
                    <div class="mb-2 last:mb-0">
                        <div class="flex items-baseline justify-between">
                            <span class="text-xs font-medium">@exp.Role</span>
                            <span class="text-[10px] text-muted-foreground">@exp.Period</span>
                        </div>
                        <p class="text-[11px] text-muted-foreground">@exp.Company</p>
                        <p class="mt-0.5 text-[11px] leading-relaxed text-muted-foreground">
                            @exp.Description
                        </p>
                    </div>
                }

                <p class="mb-1 mt-3 text-[10px] font-medium uppercase tracking-widest text-muted-foreground">
                    Skills
                </p>
                <div class="flex flex-wrap gap-1">
                    @foreach (var skill in _skills)
                    {
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="px-2 py-0.5 text-[10px] font-normal">
                            @skill
                        </BadgeCn>
                    }
                </div>
            </div>
        </div>

        @* AI Suggestions *@
        @if (VisibleSuggestions.Length > 0)
        {
            <div>
                <div class="border-b px-4 py-2">
                    <span class="text-xs font-medium text-muted-foreground">Suggestions</span>
                    <span class="text-xs text-muted-foreground"> &middot; @VisibleSuggestions.Length</span>
                </div>
                @for (var i = 0; i < VisibleSuggestions.Length; i++)
                {
                    var suggestion = VisibleSuggestions[i];
                    var isExpanded = _expandedSuggestion == suggestion.Id;
                    var isLast = i == VisibleSuggestions.Length - 1;
                    var suggestionId = suggestion.Id;

                    <div class="@(isLast ? "" : "border-b")">
                        <div class="flex items-center gap-3 px-4 py-3">
                            <button type="button"
                                    class="flex min-w-0 flex-1 items-center gap-3 text-left transition-colors hover:bg-muted/50"
                                    @onclick="@(() => _expandedSuggestion = isExpanded ? null : suggestionId)">
                                <span class="@($"size-2 shrink-0 rounded-full {_suggestionDot[suggestion.Type]}")"></span>
                                <span class="min-w-0 flex-1">
                                    <span class="text-sm font-medium">@suggestion.Title</span>
                                    @if (suggestion.Field != null)
                                    {
                                        <span class="ml-2 text-xs text-muted-foreground">@suggestion.Field</span>
                                    }
                                </span>
                                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                            </button>
                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                      Class="size-6 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                                      @onclick="@(() => _dismissedSuggestions.Add(suggestionId))">
                                <LucideXCn Size="16" Class="size-3" />
                            </ButtonCn>
                        </div>

                        @if (isExpanded)
                        {
                            <div class="px-4 pb-4 pl-9">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="mb-1.5 flex items-center justify-between">
                                        <span class="text-xs font-medium text-muted-foreground">
                                            Suggested improvement
                                        </span>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                                  Class="h-6 gap-1 px-2 text-xs"
                                                  @onclick="@(() => HandleCopy(suggestionId))">
                                            @if (_copied == suggestionId)
                                            {
                                                <LucideCheckCn Size="16" Class="size-3" />
                                                <text>Copied</text>
                                            }
                                            else
                                            {
                                                <LucideCopyCn Size="16" Class="size-3" />
                                                <text>Copy</text>
                                            }
                                        </ButtonCn>
                                    </div>
                                    <p class="text-sm leading-relaxed">@suggestion.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private class Experience
    {
        public string Id { get; set; } = "";
        public string Company { get; set; } = "";
        public string Role { get; set; } = "";
        public string Period { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private record AiSuggestion(string Id, string Type, string Title, string Description, string? Field = null);

    private string _name = "Alex Rivera";
    private string _title = "Senior Frontend Engineer";
    private string _email = "alex@@example.com";
    private string _phone = "+1 (555) 234-5678";
    private string _location = "San Francisco, CA";
    private string _summary = "Frontend engineer with 6 years of experience building high-performance web applications. Specialized in React, TypeScript, and design systems. Passionate about accessibility and user experience.";

    private List<Experience> _experiences = new()
    {
        new()
        {
            Id = "1", Company = "Stripe", Role = "Senior Frontend Engineer", Period = "2022 - Present",
            Description = "Led the redesign of the merchant dashboard, improving load time by 40%. Built a component library used by 12 teams across the organization. Mentored 3 junior engineers.",
        },
        new()
        {
            Id = "2", Company = "Figma", Role = "Frontend Engineer", Period = "2019 - 2022",
            Description = "Developed real-time collaboration features for the design editor. Implemented WebSocket-based state synchronization handling 10,000+ concurrent users. Reduced bundle size by 35%.",
        },
    };

    private static readonly string[] _skills =
    [
        "React", "TypeScript", "Next.js", "Tailwind CSS", "GraphQL", "Node.js", "Figma", "Accessibility",
    ];

    private static readonly AiSuggestion[] _aiSuggestions =
    [
        new("s1", "improvement", "Add metrics to your summary",
            "Your summary is solid, but quantifying impact makes it stronger. Try: \"...building high-performance web apps used by 2M+ users.\"",
            "summary"),
        new("s2", "idea", "Highlight leadership experience",
            "Your mentorship at Stripe is great. Consider adding \"Led a team of 5 engineers\" if applicable to strengthen your senior-level positioning.",
            "experience"),
        new("s3", "warning", "Skills section could be stronger",
            "Consider adding testing frameworks (Jest, Playwright) and CI/CD tools. These are frequently mentioned in senior frontend job descriptions.",
            "skills"),
    ];

    private static readonly Dictionary<string, string> _suggestionDot = new()
    {
        ["improvement"] = "bg-blue-500",
        ["warning"] = "bg-amber-500",
        ["idea"] = "bg-emerald-500",
    };

    private HashSet<string> _dismissedSuggestions = new();
    private string? _expandedSuggestion = "s1";
    private string? _copied;

    private AiSuggestion[] VisibleSuggestions => _aiSuggestions
        .Where(s => !_dismissedSuggestions.Contains(s.Id))
        .ToArray();

    private async Task HandleCopy(string id)
    {
        _copied = id;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = null;
    }
}
