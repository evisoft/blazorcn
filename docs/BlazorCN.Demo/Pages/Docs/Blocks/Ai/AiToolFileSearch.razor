@* ===========================================================
   Block: ai-tool-file-search
   Title: Ai Tool File Search
   Description: React AI tool file search block for Next.js with relevance scoring, file path display, snippet preview with highlighted matches, and scroll area using shadcn/ui and Tailwind CSS
   Long Description: React AI Tool Results Panel Block
   Dependencies: BadgeCn, InputCn
   Source: original/blocks/ai/ai-tool-file-search.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Search input *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <InputCn Value="@_searchQuery"
                     ReadOnly="true"
                     Class="h-8 border-0 bg-transparent px-0 font-mono shadow-none focus-visible:ring-0" aria-label="Search query" />
            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                @_searchResults.Length files
            </BadgeCn>
            <span class="text-muted-foreground text-xs">&middot;</span>
            <span class="shrink-0 font-mono text-muted-foreground text-xs">0.34s</span>
        </div>

        @* Results *@
        <div>
            @for (int i = 0; i < _searchResults.Length; i++)
            {
                var result = _searchResults[i];
                var isExpanded = _expanded == result.Id;
                var isLast = i == _searchResults.Length - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <button type="button"
                            @onclick="@(() => _expanded = isExpanded ? null : result.Id)"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <span class="@($"shrink-0 font-mono text-xs font-semibold tabular-nums {RelevanceColor(result.Relevance)}")">
                            @(result.Relevance)%
                        </span>
                        <div class="min-w-0 flex-1">
                            <span class="truncate font-mono text-sm">@result.Path</span>
                        </div>
                        <span class="shrink-0 font-mono text-muted-foreground text-xs">
                            L@(result.LineNumber)
                        </span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="border-t bg-zinc-950 px-4 py-3">
                            <pre class="overflow-x-auto font-mono text-xs leading-relaxed text-zinc-300">@(RenderHighlightedText(result.Snippet, result.HighlightText))</pre>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record FileSearchResult(string Id, string Path, int Relevance, string Snippet, string HighlightText, string Language, int LineNumber);

    private static readonly string _searchQuery = "useAuth authentication hook";

    private static readonly FileSearchResult[] _searchResults =
    {
        new("f1", "src/hooks/use-auth.ts", 98,
            "export function useAuth() {\n  const session = useSession()\n  const { user, isPro } = session\n  return { user, isPro, isLoading: !session }",
            "useAuth", "typescript", 14),
        new("f2", "src/contexts/auth-context.tsx", 87,
            "const AuthContext = createContext<AuthState>(null)\n\nexport function AuthProvider({ children }: Props) {\n  const auth = useAuth()\n  return <AuthContext.Provider value={auth}>",
            "useAuth", "tsx", 8),
        new("f3", "src/middleware.ts", 72,
            "export async function middleware(req: NextRequest) {\n  const token = req.cookies.get('auth-token')\n  if (!token) return redirectToLogin(req)\n  const session = await verifyAuth(token)",
            "auth", "typescript", 22),
        new("f4", "src/app/api/auth/[...all]/route.ts", 65,
            "import { auth } from '~/lib/auth'\n\nexport const { GET, POST } = auth.handlers\n// Better Auth handles all authentication routes",
            "auth", "typescript", 1),
        new("f5", "src/components/auth-guard.tsx", 58,
            "export function AuthGuard({ children }: { children: ReactNode }) {\n  const { user, isLoading } = useAuth()\n  if (isLoading) return <Skeleton />\n  if (!user) return <RedirectToLogin />",
            "useAuth", "tsx", 5),
        new("f6", "docs/authentication.md", 41,
            "## Authentication Hook\n\nUse the `useAuth` hook to access the current user session\nand subscription status in any client component.",
            "useAuth", "markdown", 45)
    };

    private string? _expanded = "f1";

    private static string RelevanceColor(int score)
    {
        if (score >= 80) return "text-emerald-600 dark:text-emerald-400";
        if (score >= 50) return "text-amber-600 dark:text-amber-400";
        return "text-muted-foreground";
    }

    private static MarkupString RenderHighlightedText(string text, string highlight)
    {
        if (string.IsNullOrEmpty(highlight))
            return new MarkupString(System.Net.WebUtility.HtmlEncode(text));

        var escaped = System.Text.RegularExpressions.Regex.Escape(highlight);
        var result = System.Text.RegularExpressions.Regex.Replace(
            System.Net.WebUtility.HtmlEncode(text),
            $"({escaped})",
            @"<mark class=""rounded-sm bg-amber-200 px-0.5 text-amber-900 dark:bg-amber-500/30 dark:text-amber-200"">$1</mark>",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        return new MarkupString(result);
    }
}
