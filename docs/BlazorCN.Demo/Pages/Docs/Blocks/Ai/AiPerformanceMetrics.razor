@* ===========================================================
   Block: ai-performance-metrics
   Title: Ai Performance Metrics
   Description: AI performance monitoring with latency percentiles, throughput, error rate, and response distribution
   Dependencies: BadgeCn, LucideChevronRightCn
   Source: original/blocks/ai/ai-performance-metrics.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <span class="text-sm font-medium">Performance Metrics</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                Real-time
            </BadgeCn>
        </div>

        @* Key metrics row *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="text-2xl font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">
                    142
                </span>
                <span class="text-xs text-muted-foreground">req/min</span>
            </div>
            <span class="text-xs text-muted-foreground">&middot;</span>
            <span class="text-xs text-muted-foreground">Throughput</span>
            <div class="ml-auto flex items-center gap-4">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    0.3% errors
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    99.97% uptime
                </span>
            </div>
        </div>

        @* Latency percentiles *@
        <div class="@(_expanded == "latency" ? "" : "border-b")">
            <button type="button"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    @onclick="@(() => _expanded = _expanded == "latency" ? null : "latency")">
                <span class="size-2 shrink-0 rounded-full bg-amber-500"></span>
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">Latency Percentiles</span>
                    <p class="mt-0.5 font-mono text-xs text-muted-foreground">
                        p50: 245ms &middot; p95: 890ms &middot; p99: 2.1s
                    </p>
                </div>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _expanded == "latency" ? "rotate-90" : "")" />
            </button>

            @if (_expanded == "latency")
            {
                <div class="border-b px-4 pb-4 pl-9">
                    <div class="space-y-3">
                        @foreach (var p in _latencyPercentiles)
                        {
                            <div class="flex items-center gap-3">
                                <span class="w-8 font-mono text-xs text-muted-foreground">@p.Label</span>
                                <span class="@Cn.Merge("text-sm font-semibold tabular-nums", GetLatencyColor(p.Ms))">
                                    @p.Value
                                </span>
                                <div class="flex-1">
                                    <div class="h-1.5 w-full overflow-hidden rounded-full bg-muted/40">
                                        <div class="@Cn.Merge("h-full rounded-full", GetLatencyDot(p.Ms))"
                                             style="@($"width: {Math.Min(p.Ms * 100.0 / 3000, 100):F0}%")"></div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                    <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
                        Median latency is within SLA. p99 tail latency at 2.1s may indicate cold starts or
                        complex queries requiring optimization.
                    </p>
                </div>
            }
        </div>

        @* Response time distribution *@
        <div>
            <button type="button"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                    @onclick="@(() => _expanded = _expanded == "distribution" ? null : "distribution")">
                <span class="size-2 shrink-0 rounded-full bg-blue-500"></span>
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">Response Time Distribution</span>
                    <p class="mt-0.5 font-mono text-xs text-muted-foreground">
                        12,220 total requests
                    </p>
                </div>
                <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", _expanded == "distribution" ? "rotate-90" : "")" />
            </button>

            @if (_expanded == "distribution")
            {
                <div class="px-4 pb-4 pl-9">
                    <div class="space-y-2">
                        @foreach (var bucket in _distribution)
                        {
                            <div class="flex items-center gap-3">
                                <span class="w-16 shrink-0 text-right font-mono text-xs text-muted-foreground">@bucket.Range</span>
                                <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted/40">
                                    <div class="h-full rounded-full bg-foreground/20" style="@($"width: {bucket.Pct}%")"></div>
                                </div>
                                <span class="w-8 shrink-0 text-right font-mono text-xs text-muted-foreground">@bucket.Pct%</span>
                                <span class="w-12 shrink-0 text-right font-mono text-xs text-muted-foreground">@bucket.Count.ToString("N0")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record LatencyPercentile(string Label, string Value, int Ms);
    private record DistBucket(string Range, int Count, int Pct);

    private static readonly LatencyPercentile[] _latencyPercentiles =
    {
        new("p50", "245ms", 245),
        new("p95", "890ms", 890),
        new("p99", "2.1s", 2100)
    };

    private static readonly DistBucket[] _distribution =
    {
        new("< 200ms", 4280, 35),
        new("200-500ms", 4890, 40),
        new("500ms-1s", 1830, 15),
        new("1-2s", 850, 7),
        new("> 2s", 370, 3)
    };

    private string? _expanded = "distribution";

    private static string GetLatencyColor(int ms) => ms < 500
        ? "text-emerald-600 dark:text-emerald-400"
        : ms < 1500
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";

    private static string GetLatencyDot(int ms) => ms < 500
        ? "bg-emerald-500"
        : ms < 1500
            ? "bg-amber-500"
            : "bg-red-500";
}
