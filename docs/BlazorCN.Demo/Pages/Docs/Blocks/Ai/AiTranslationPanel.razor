@* ===========================================================
   Block: ai-translation-panel
   Title: Ai Translation Panel
   Description: React AI translation panel block for Next.js with dual-column layout, language selectors, swap button, alternative translations, and quality confidence bar using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn, SelectCn
   Source: original/blocks/ai/ai-translation-panel.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Language selectors *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <SelectCn @bind-Value="_sourceLang">
                <SelectTriggerCn aria-label="Source language" Class="h-8 w-36 border-0 bg-transparent shadow-none focus:ring-0 text-sm">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var lang in _languages)
                    {
                        <SelectItemCn Value="@lang.Value">@lang.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
            <ButtonCn aria-label="Swap languages" Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 px-2"
                @onclick="HandleSwapLanguages">
                <LucideArrowRightLeftCn Size="14" Class="size-3.5" />
            </ButtonCn>
            <SelectCn @bind-Value="_targetLang">
                <SelectTriggerCn aria-label="Target language" Class="h-8 w-36 border-0 bg-transparent shadow-none focus:ring-0 text-sm">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var lang in _languages)
                    {
                        <SelectItemCn Value="@lang.Value">@lang.Label</SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
            <div class="ml-auto flex items-center gap-3">
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Context-aware
                </BadgeCn>
                <span class="flex items-center gap-1.5 text-xs">
                    <span class="font-semibold tabular-nums text-emerald-600 dark:text-emerald-400">92%</span>
                    <span class="text-muted-foreground">confidence</span>
                </span>
            </div>
        </div>

        @* Source text *@
        <div class="border-b">
            <div class="flex items-center justify-between px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Source</span>
                <span class="text-muted-foreground text-xs">@_sourceWordCount words</span>
            </div>
            <div class="px-4 pb-3">
                <TextareaCn @bind-Value="_source"
                    rows="5"
                    Placeholder="Enter text to translate..."
                    Class="resize-none leading-relaxed" aria-label="Enter text to translate..." />
            </div>
        </div>

        @* Translated text *@
        <div class="border-b">
            <div class="flex items-center justify-between px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Translation</span>
                <div class="flex items-center gap-2">
                    <span class="text-muted-foreground text-xs">@_targetWordCount words</span>
                    <ButtonCn
                        Variant="ButtonVariant.Ghost"
                        Size="ButtonSize.Sm"
                        class="h-6 gap-1 px-2 text-xs">
                        @if (_copied)
                        {
                            <LucideCheckCn Size="12" Class="size-3" />
                            <span>Copied</span>
                        }
                        else
                        {
                            <LucideCopyCn Size="12" Class="size-3" />
                            <span>Copy</span>
                        }
                    </ButtonCn>
                </div>
            </div>
            <div class="px-4 pb-3">
                <p class="text-sm leading-relaxed">@_translatedText</p>
            </div>
        </div>

        @* Alternative translations *@
        <div>
            <div class="px-4 py-2">
                <span class="font-medium text-muted-foreground text-xs">Alternatives</span>
            </div>
            @for (var i = 0; i < _alternatives.Length; i++)
            {
                var idx = i;
                var alt = _alternatives[idx];
                var isExpanded = _expandedAlt == alt.Id;
                var isLast = idx == _alternatives.Length - 1;

                <div class="@(isLast ? "" : "border-b")">
                    <button
                        type="button"
                        @onclick="@(() => _expandedAlt = isExpanded ? null : alt.Id)"
                        class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 font-normal text-xs">
                            @alt.Style
                        </BadgeCn>
                        <span class="min-w-0 flex-1 truncate text-muted-foreground text-sm">
                            @alt.Text
                        </span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <p class="text-sm leading-relaxed">@alt.Text</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record Language(string Label, string Value);
    private record AlternativeTranslation(string Id, string Text, string Style);

    private static readonly Language[] _languages =
    [
        new("English", "en"),
        new("Spanish", "es"),
        new("French", "fr"),
        new("German", "de"),
        new("Japanese", "ja"),
        new("Chinese (Simplified)", "zh"),
        new("Portuguese", "pt"),
        new("Korean", "ko"),
        new("Arabic", "ar"),
        new("Italian", "it"),
    ];

    private static readonly string _sourceText = "Our platform leverages cutting-edge machine learning models to deliver real-time insights across your entire data pipeline. With automated anomaly detection and predictive analytics, your team can focus on strategic decisions rather than manual data monitoring.\n\nThe new dashboard features customizable widgets, collaborative annotations, and export capabilities that integrate seamlessly with your existing workflow tools.";

    private static readonly string _translatedText = "Nuestra plataforma aprovecha modelos de aprendizaje autom\u00e1tico de \u00faltima generaci\u00f3n para ofrecer informaci\u00f3n en tiempo real en todo su canal de datos. Con detecci\u00f3n autom\u00e1tica de anomal\u00edas y an\u00e1lisis predictivo, su equipo puede concentrarse en decisiones estrat\u00e9gicas en lugar de la supervisi\u00f3n manual de datos.\n\nEl nuevo panel presenta widgets personalizables, anotaciones colaborativas y capacidades de exportaci\u00f3n que se integran perfectamente con sus herramientas de flujo de trabajo existentes.";

    private static readonly AlternativeTranslation[] _alternatives =
    [
        new("1", "Nuestra plataforma utiliza modelos avanzados de inteligencia artificial para proporcionar an\u00e1lisis en tiempo real...", "Formal"),
        new("2", "Nuestra plataforma usa machine learning de punta para darte insights al instante en todo tu pipeline de datos...", "Casual"),
        new("3", "La plataforma emplea t\u00e9cnicas de aprendizaje profundo de vanguardia para generar perspectivas inmediatas...", "Technical"),
    ];

    private string _sourceLang = "en";
    private string _targetLang = "es";
    private string _source = _sourceText;
    private string? _expandedAlt = null;
    private bool _copied = false;

    private int _sourceWordCount => _source.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;
    private int _targetWordCount => _translatedText.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;

    private void HandleSwapLanguages()
    {
        (_sourceLang, _targetLang) = (_targetLang, _sourceLang);
    }
}
