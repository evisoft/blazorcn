@* ===========================================================
   Block: ai-writing-assistant
   Title: Ai Writing Assistant
   Description: React AI writing assistant block for Next.js with inline suggestions, tone selector, readability metrics, and word count using shadcn/ui and Tailwind CSS
   Long Description: Expandable award rows revealing description, criteria, and organization details on click
   Dependencies: BadgeCn, ButtonCn, SelectCn, TextareaCn, LucideCheckCn, LucideChevronRightCn, LucideXCn
   Source: original/blocks/ai/ai-writing-assistant.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <span class="text-sm font-medium">Writing Assistant</span>
            <div class="ml-auto flex items-center gap-3">
                <SelectCn TValue="string" Value="@_tone" ValueChanged="@(v => _tone = v)">
                    <SelectTriggerCn Class="h-7 w-32 border-0 bg-transparent text-xs shadow-none focus:ring-0">
                        <SelectValueCn />
                    </SelectTriggerCn>
                    <SelectContentCn>
                        <SelectItemCn Value="professional">Professional</SelectItemCn>
                        <SelectItemCn Value="casual">Casual</SelectItemCn>
                        <SelectItemCn Value="academic">Academic</SelectItemCn>
                        <SelectItemCn Value="creative">Creative</SelectItemCn>
                        <SelectItemCn Value="persuasive">Persuasive</SelectItemCn>
                    </SelectContentCn>
                </SelectCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                    Analyze
                </ButtonCn>
            </div>
        </div>

        @* Editor *@
        <div class="border-b">
            <TextareaCn @bind-Value="_text"
                        Rows="10"
                        Placeholder="Start writing..."
                        Class="resize-none rounded-none border-0 bg-transparent px-4 py-3 text-sm leading-relaxed shadow-none focus-visible:ring-0" />
        </div>

        @* Stats bar *@
        <div class="flex items-center gap-4 border-b px-4 py-2">
            <span class="font-mono text-xs tabular-nums text-muted-foreground">
                @WordCount words
            </span>
            <span class="text-xs text-muted-foreground">&middot;</span>
            <span class="font-mono text-xs tabular-nums text-muted-foreground">
                @_text.Length chars
            </span>
            <span class="text-xs text-muted-foreground">&middot;</span>
            <span class="font-mono text-xs tabular-nums text-muted-foreground">
                @SentenceCount sentences
            </span>
            <div class="ml-auto flex items-center gap-3">
                <span class="text-xs text-muted-foreground">Readability</span>
                <span class="text-xs font-semibold tabular-nums">62</span>
                <span class="text-xs text-muted-foreground">&middot;</span>
                <span class="text-xs text-muted-foreground">Clarity</span>
                <span class="text-xs font-semibold tabular-nums">74</span>
            </div>
        </div>

        @* Suggestions *@
        @if (ActiveSuggestionList.Length > 0)
        {
            <div>
                <div class="px-4 py-2">
                    <span class="text-xs font-medium text-muted-foreground">
                        @ActiveSuggestionList.Length suggestions
                    </span>
                </div>
                @for (var i = 0; i < ActiveSuggestionList.Length; i++)
                {
                    var s = ActiveSuggestionList[i];
                    var isExpanded = _expanded == s.Id;
                    var isLast = i == ActiveSuggestionList.Length - 1;
                    var suggestionId = s.Id;

                    <div class="@(isLast ? "" : "border-b")">
                        <button type="button"
                                @onclick="@(() => _expanded = isExpanded ? null : suggestionId)"
                                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                            <span class="@($"size-1.5 shrink-0 rounded-full {_typeDot[s.Type]}")"></span>
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">
                                    @(s.Original.Length > 40 ? $"{s.Original[..40]}..." : s.Original)
                                </span>
                                <p class="mt-0.5 text-xs text-muted-foreground">@s.Reason</p>
                            </div>
                            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 text-xs font-normal capitalize">
                                @s.Type
                            </BadgeCn>
                            <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>

                        @if (isExpanded)
                        {
                            <div class="px-4 pb-3 pl-9">
                                <div class="rounded-md bg-muted/50 p-3">
                                    <div class="space-y-1.5">
                                        <p class="text-xs">
                                            <span class="text-red-500 line-through">@s.Original</span>
                                        </p>
                                        <p class="text-xs">
                                            <span class="text-emerald-600 dark:text-emerald-400">
                                                @s.Replacement
                                            </span>
                                        </p>
                                    </div>
                                    <div class="mt-3 flex gap-2">
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline"
                                                  Class="h-7 gap-1 text-xs"
                                                  OnClick="@(() => AcceptSuggestion(suggestionId))">
                                            <LucideCheckCn Size="12" Class="size-3" />
                                            Accept
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                                                  Class="h-7 gap-1 text-xs"
                                                  OnClick="@(() => DismissSuggestion(suggestionId))">
                                            <LucideXCn Size="12" Class="size-3" />
                                            Dismiss
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private record AiSuggestion(string Id, string Original, string Replacement, string Reason, string Type);

    private string _tone = "professional";
    private string _text = "Our platform leverages cutting-edge artificial intelligence to provide users with actionable insights derived from their data. By utilizing our comprehensive suite of tools, organizations can effectively streamline their workflows and achieve optimal operational efficiency across all departments.\n\nThe implementation process is straightforward and can be completed in a matter of days. Our dedicated team of experts will guide you through every step, ensuring a seamless transition from your existing systems. We believe in making technology accessible to everyone, regardless of their technical background.\n\nContact our sales team today to schedule a personalized demonstration and discover how our solutions can transform your business operations.";
    private HashSet<string> _activeSuggestions;
    private string? _expanded;

    private static readonly Dictionary<string, string> _typeDot = new()
    {
        ["clarity"] = "bg-blue-500",
        ["conciseness"] = "bg-emerald-500",
        ["tone"] = "bg-amber-500",
        ["grammar"] = "bg-red-500",
    };

    private static readonly AiSuggestion[] _suggestions =
    [
        new("s1", "leverages cutting-edge", "uses advanced", "Simpler, less jargon", "clarity"),
        new("s2", "actionable insights derived from", "clear insights from", "More concise", "conciseness"),
        new("s3", "effectively streamline their workflows and achieve optimal operational efficiency across all departments", "work faster across teams", "Remove filler words", "conciseness"),
        new("s4", "in a matter of days", "within days", "Tighter phrasing", "clarity"),
        new("s5", "dedicated team of experts", "team", "Avoid overused qualifiers", "tone"),
    ];

    public AiWritingAssistant()
    {
        _activeSuggestions = new HashSet<string>(_suggestions.Select(s => s.Id));
    }

    private int WordCount => _text.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length;
    private int SentenceCount => _text.Split(['.', '!', '?'], StringSplitOptions.RemoveEmptyEntries).Length;

    private AiSuggestion[] ActiveSuggestionList =>
        _suggestions.Where(s => _activeSuggestions.Contains(s.Id)).ToArray();

    private void AcceptSuggestion(string id)
    {
        _activeSuggestions.Remove(id);
        _expanded = null;
    }

    private void DismissSuggestion(string id)
    {
        _activeSuggestions.Remove(id);
        _expanded = null;
    }
}
