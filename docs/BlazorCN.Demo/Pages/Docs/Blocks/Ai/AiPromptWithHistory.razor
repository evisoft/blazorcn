@* ===========================================================
   Block: ai-prompt-with-history
   Title: Ai Prompt With History
   Description: React AI prompt with history block for Next.js with recent prompts dropdown, timestamps, and reuse functionality using shadcn/ui and Tailwind CSS
   Dependencies: ButtonCn, TextareaCn, LucideArrowUpCn, LucideChevronRightCn, LucideClockCn, LucideHistoryCn, LucideTrash2Cn
   Source: original/blocks/ai/ai-prompt-with-history.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* History panel *@
        @if (_showHistory)
        {
            <div>
                <div class="flex items-center justify-between border-b px-4 py-3">
                    <div class="flex items-center gap-1.5">
                        <LucideClockCn Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs font-medium">Recent prompts</span>
                    </div>
                    @if (_history.Count > 0)
                    {
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                                  Class="h-6 gap-1 px-2 text-xs text-muted-foreground"
                                  OnClick="ClearHistory">
                            <LucideTrash2Cn Size="12" Class="size-3" />
                            Clear
                        </ButtonCn>
                    }
                </div>

                @if (_history.Count == 0)
                {
                    <div class="border-b px-4 py-6 text-center">
                        <p class="text-xs text-muted-foreground">No recent prompts</p>
                    </div>
                }
                else
                {
                    <div>
                        @foreach (var item in _history)
                        {
                            var text = item.Text;
                            <button type="button"
                                    class="flex w-full items-center gap-3 border-b px-4 py-3 text-left transition-colors hover:bg-muted/50"
                                    @onclick="@(() => HandleHistoryClick(text))">
                                <div class="min-w-0 flex-1">
                                    <p class="truncate text-sm font-medium">@item.Text</p>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@item.TimeAgo</p>
                                </div>
                                <LucideChevronRightCn Size="16" Class="size-4 shrink-0 text-muted-foreground/60" />
                            </button>
                        }
                    </div>
                }
            </div>
        }

        @* Input area *@
        <div class="px-4 py-3">
            <TextareaCn @bind-Value="_input"
                        Placeholder="Ask anything..."
                        Rows="3"
                        Class="min-h-[72px] max-h-40 resize-none border-0 bg-transparent p-0 text-sm shadow-none focus-visible:ring-0" />
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                      Class="h-7 gap-1.5 text-xs text-muted-foreground"
                      OnClick="@(() => _showHistory = !_showHistory)">
                <LucideHistoryCn Size="14" Class="size-3.5" />
                Recent (@_history.Count)
            </ButtonCn>
            <ButtonCn Size="ButtonSize.Sm"
                      Class="h-7 gap-1.5 text-xs"
                      Disabled="@string.IsNullOrWhiteSpace(_input)"
                      OnClick="HandleSubmit">
                <LucideArrowUpCn Size="14" Class="size-3.5" />
                Send
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private class HistoryItem
    {
        public string Id { get; set; } = "";
        public string Text { get; set; } = "";
        public string TimeAgo { get; set; } = "";
    }

    private string _input = "";
    private bool _showHistory;
    private List<HistoryItem> _history = new(InitialHistory);

    private static readonly HistoryItem[] InitialHistory =
    [
        new() { Id = "1", Text = "Explain the differences between React Server Components and Client Components with examples", TimeAgo = "2 min ago" },
        new() { Id = "2", Text = "Write a TypeScript utility type that extracts all optional keys from an interface", TimeAgo = "15 min ago" },
        new() { Id = "3", Text = "How do I set up Stripe webhooks with Next.js App Router and handle checkout.session.completed?", TimeAgo = "45 min ago" },
        new() { Id = "4", Text = "Create a Prisma schema for a multi-tenant SaaS with workspaces, roles, and permissions", TimeAgo = "2 hours ago" },
        new() { Id = "5", Text = "What are the best practices for caching data in Next.js 15 with the new cache directive?", TimeAgo = "5 hours ago" },
        new() { Id = "6", Text = "Generate a responsive pricing page component with monthly/yearly toggle using shadcn/ui", TimeAgo = "12 hours ago" },
        new() { Id = "7", Text = "Help me debug why my middleware.ts is not matching the correct routes in Next.js", TimeAgo = "Yesterday" },
        new() { Id = "8", Text = "Compare Drizzle ORM vs Prisma for a new Next.js project, pros and cons of each", TimeAgo = "2 days ago" },
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        var newItem = new HistoryItem
        {
            Id = Guid.NewGuid().ToString(),
            Text = _input.Trim(),
            TimeAgo = "Just now",
        };
        _history.Insert(0, newItem);
        if (_history.Count > 8) _history.RemoveAt(_history.Count - 1);
        _input = "";
    }

    private void HandleHistoryClick(string text)
    {
        _input = text;
        _showHistory = false;
    }

    private void ClearHistory()
    {
        _history.Clear();
    }
}
