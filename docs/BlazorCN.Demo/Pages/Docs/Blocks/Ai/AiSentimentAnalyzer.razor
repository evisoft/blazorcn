@* ===========================================================
   Block: ai-sentiment-analyzer
   Title: Ai Sentiment Analyzer
   Description: React AI sentiment analysis block for Next.js with text input, overall sentiment display, emotion breakdown bars, key phrase extraction, and confidence scoring using shadcn/ui and Tailwind CSS
   Long Description: React AI Social Media Post Block
   Dependencies: BadgeCn, ButtonCn, TextareaCn
   Source: original/blocks/ai/ai-sentiment-analyzer.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Input *@
        <div class="border-b px-4 py-3">
            <TextareaCn
                Value="@_text"
                rows="4"
                Placeholder="Paste text to analyze sentiment..."
                Class="resize-none border-0 bg-transparent p-0 shadow-none text-sm leading-relaxed focus-visible:ring-0" aria-label="Paste text to analyze sentiment..." />
            <div class="mt-2 flex items-center justify-between">
                <span class="text-muted-foreground text-xs">
                    @_text.Split(' ', StringSplitOptions.RemoveEmptyEntries).Length words
                </span>
                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 text-xs">
                    Analyze
                </ButtonCn>
            </div>
        </div>

        @if (_hasAnalyzed)
        {
            @* Overall sentiment *@
            <div class="flex items-center gap-4 border-b px-4 py-3">
                <div class="flex items-baseline gap-1">
                    <span class="font-semibold text-2xl tabular-nums text-emerald-600 dark:text-emerald-400">
                        87
                    </span>
                    <span class="text-muted-foreground text-xs">%</span>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                    Positive
                </BadgeCn>
                <span class="text-muted-foreground text-xs">&middot;</span>
                <span class="text-muted-foreground text-xs">
                    @_keyPhrases.Count phrases
                </span>
                <div class="ml-auto flex items-center gap-3">
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        4
                    </span>
                    <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-amber-500"></span>
                        1
                    </span>
                </div>
            </div>

            @* Emotion breakdown *@
            <div class="border-b px-4 py-3">
                <span class="font-medium text-xs text-muted-foreground">Emotions</span>
                <div class="mt-2 space-y-2">
                    @foreach (var emotion in _emotions)
                    {
                        <div class="flex items-center gap-3">
                            <span class="w-20 truncate text-sm">@emotion.Name</span>
                            <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                                <div class="h-full rounded-full bg-foreground/20" style="width: @(emotion.Value)%"></div>
                            </div>
                            <span class="w-8 text-right font-mono text-muted-foreground text-xs tabular-nums">
                                @(emotion.Value)%
                            </span>
                        </div>
                    }
                </div>
            </div>

            @* Key phrases *@
            <div>
                <button
                    type="button"
                    @onclick="() => _showPhrases = !_showPhrases"
                    class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <span class="font-medium text-sm">Key Phrases</span>
                    <span class="text-muted-foreground text-xs">@_keyPhrases.Count</span>
                    <LucideChevronRightCn Size="16" Class="@Cn.Merge("ml-auto size-4 text-muted-foreground/60 transition-transform duration-200", _showPhrases ? "rotate-90" : "")" />
                </button>
                @if (_showPhrases)
                {
                    <div class="px-4 pb-4">
                        <div class="flex flex-wrap gap-1.5">
                            @foreach (var phrase in _keyPhrases)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("text-xs", phrase.Sentiment == "positive" ? "border-emerald-500/20 bg-emerald-500/10" : "border-amber-500/20 bg-amber-500/10")">
                                    @phrase.Text
                                </BadgeCn>
                            }
                        </div>
                        <div class="mt-3 rounded-md bg-muted/50 p-3">
                            <span class="font-medium text-muted-foreground text-xs">Summary</span>
                            <p class="mt-1 text-sm leading-relaxed">
                                The text is overwhelmingly positive with enthusiastic language. One minor
                                concern about dark mode contrast is noted but framed constructively.
                            </p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@code {
    private string _text = "The new dashboard redesign is absolutely incredible! The team did an amazing job with the UI. The loading times have improved dramatically and the new filtering system is intuitive. One small concern - the dark mode contrast could be slightly better on the sidebar, but overall this is a massive improvement.";
    private bool _hasAnalyzed = true;
    private bool _showPhrases = false;

    private record EmotionData(string Name, int Value);
    private record PhraseData(string Text, string Sentiment);

    private static readonly List<EmotionData> _emotions = new()
    {
        new("Joy", 72),
        new("Admiration", 65),
        new("Excitement", 58),
        new("Concern", 15),
        new("Neutral", 8),
    };

    private static readonly List<PhraseData> _keyPhrases = new()
    {
        new("absolutely incredible", "positive"),
        new("amazing job", "positive"),
        new("improved dramatically", "positive"),
        new("massive improvement", "positive"),
        new("contrast could be better", "concern"),
    };
}
