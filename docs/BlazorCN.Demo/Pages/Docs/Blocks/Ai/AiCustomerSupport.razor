@* ===========================================================
   Block: ai-customer-support
   Title: Ai Customer Support
   Description: AI customer support chat with bot avatar, quick-reply suggestions, satisfaction rating, and order tracking
   Dependencies: BadgeCn, ButtonCn, LucideCopyCn, LucideSendCn, LucideThumbsUpCn
   Source: original/blocks/ai/ai-customer-support.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-7 items-center justify-center rounded-full bg-muted">
                <span class="text-xs font-medium">A</span>
            </div>
            <div class="flex-1">
                <span class="text-sm font-medium">Ava</span>
                <span class="ml-1.5 text-xs text-muted-foreground">Support</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 text-xs font-normal">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Online
            </BadgeCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto">
            <div class="flex flex-col gap-5 p-4">
                @foreach (var msg in _messages)
                {
                    <div class="flex flex-col gap-1.5">
                        @if (msg.Role == "assistant")
                        {
                            <div class="flex gap-3">
                                <div class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-muted">
                                    <span class="text-[10px] font-medium">A</span>
                                </div>
                                <div class="min-w-0 flex-1 space-y-2">
                                    <div class="rounded-lg bg-muted/50 px-3 py-2">
                                        <p class="whitespace-pre-wrap text-sm leading-relaxed">@msg.Content</p>
                                    </div>

                                    <div class="flex items-center gap-1">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-1.5 text-xs text-muted-foreground">
                                            <LucideCopyCn Size="16" Class="size-3.5" />
                                        </ButtonCn>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 px-1.5 text-xs text-muted-foreground">
                                            <LucideThumbsUpCn Size="16" Class="size-3.5" />
                                        </ButtonCn>
                                    </div>

                                    @* Satisfaction Rating *@
                                    @if (msg.ShowRating)
                                    {
                                        <div class="rounded-md bg-muted/50 p-3">
                                            <span class="text-xs font-medium text-muted-foreground">Was this helpful?</span>
                                            <div class="mt-2 flex items-center gap-1">
                                                @for (var s = 1; s <= 5; s++)
                                                {
                                                    var star = s;
                                                    <button type="button"
                                                            class="rounded p-0.5 transition-colors hover:bg-muted"
                                                            @onclick="@(() => _rating = star)"
                                                            @onmouseenter="@(() => _hoveredStar = star)"
                                                            @onmouseleave="@(() => _hoveredStar = 0)">
                                                        <span class="@Cn.Merge("block size-2 rounded-full transition-colors", star <= (_hoveredStar > 0 ? _hoveredStar : _rating) ? "bg-foreground" : "bg-muted-foreground/30")"></span>
                                                    </button>
                                                }
                                                @if (_rating > 0)
                                                {
                                                    <span class="ml-2 text-xs text-muted-foreground">
                                                        @(_rating == 5 ? "Excellent!" : _rating >= 3 ? "Thank you!" : "We'll do better")
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="ml-auto max-w-[80%] rounded-lg bg-primary px-3 py-2 text-primary-foreground">
                                <p class="text-sm">@msg.Content</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @* Quick-reply Suggestions *@
        <div class="border-t px-4 pt-3">
            <div class="flex flex-wrap gap-1.5">
                @foreach (var reply in _quickReplies)
                {
                    var r = reply;
                    <button type="button"
                            class="rounded-md bg-muted/50 px-3 py-1.5 text-xs text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
                            @onclick="@(() => _input = r)">
                        @r
                    </button>
                }
            </div>
        </div>

        @* Input *@
        <div class="px-4 py-3">
            <div class="flex items-end gap-2">
                <textarea class="min-h-0 max-h-28 flex-1 resize-none border-0 bg-muted/50 rounded-md px-3 py-2 text-sm shadow-none focus:outline-none focus-visible:ring-0"
                          rows="1"
                          placeholder="Type your message..."
                          @bind="_input"></textarea>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-8 shrink-0"
                          Disabled="@(string.IsNullOrWhiteSpace(_input))">
                    <LucideSendCn Size="16" Class="size-3.5" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Role, string Content, bool ShowRating = false);

    private static readonly ChatMessage[] _messages =
    {
        new("1", "assistant", "Hi there! I'm Ava, your support assistant. How can I help you today?"),
        new("2", "user", "I placed an order 3 days ago and haven't received any shipping updates. Order #WX-48291."),
        new("3", "assistant", "I found your order! Here's the latest status:\n\nOrder #WX-48291 \u2014 Wireless Noise-Cancelling Headphones\n\nStatus: In Transit\nCarrier: FedEx\nTracking: 7749 2810 3345\nEstimated Delivery: March 18, 2026\n\nYour package left the distribution center in Memphis, TN yesterday and is currently on its way. The tracking number should start showing movement within the next 12 hours.\n\nWould you like me to send you a tracking link or help with anything else?", true)
    };

    private static readonly string[] _quickReplies =
    {
        "Send me the tracking link",
        "I want to change my delivery address",
        "When does your return policy expire?",
        "Connect me with a human agent"
    };

    private string _input = "";
    private int _rating;
    private int _hoveredStar;
}
