@* ===========================================================
   Block: ai-file-analyzer
   Title: Ai File Analyzer
   Description: AI file analysis with drag-and-drop upload, AI summary, key findings, and recommendations
   Dependencies: BadgeCn, ButtonCn, LucideChevronRightCn, LucideUploadCloudCn, ProgressCn
   Source: original/blocks/ai/ai-file-analyzer.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    @if (_viewState == "idle")
    {
        @* Upload zone *@
        <button type="button"
                class="flex w-full flex-col items-center gap-3 rounded-lg border-2 border-dashed border-muted-foreground/25 bg-card p-10 transition-colors hover:border-muted-foreground/40 hover:bg-muted/30"
                @onclick="SimulateUpload">
            <LucideUploadCloudCn Size="24" Class="size-6 text-muted-foreground" />
            <div class="text-center">
                <p class="text-sm font-medium">Drop your file here or click to browse</p>
                <p class="mt-1 text-xs text-muted-foreground">PDF, DOCX, CSV, JSON up to 50MB</p>
            </div>
        </button>
    }
    else if (_viewState == "uploading")
    {
        @* Uploading state *@
        <div class="overflow-hidden rounded-lg border bg-card">
            <div class="px-4 py-3">
                <div class="mb-3 flex items-center justify-between">
                    <div>
                        <span class="text-sm font-medium">@_fileInfo.Name</span>
                        <p class="text-xs text-muted-foreground">Analyzing with AI...</p>
                    </div>
                    <span class="font-mono text-xs text-muted-foreground">@(Math.Min(_uploadProgress, 100))%</span>
                </div>
                <ProgressCn Value="@Math.Min(_uploadProgress, 100)" Class="h-1.5" />
            </div>
        </div>
    }
    else
    {
        @* Analyzed state *@
        <div class="overflow-hidden rounded-lg border bg-card">
            @* File info *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <div class="min-w-0 flex-1">
                    <span class="text-sm font-medium">@_fileInfo.Name</span>
                    <p class="mt-0.5 text-xs text-muted-foreground">
                        @_fileInfo.Type &middot; @_fileInfo.Size &middot; Modified @_fileInfo.LastModified
                    </p>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 gap-1.5 text-xs font-normal">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Analyzed
                </BadgeCn>
            </div>

            @* Analysis sections *@
            @for (var i = 0; i < _sections.Length; i++)
            {
                var sec = _sections[i];
                var isExpanded = _expanded == sec.Id;
                var isLast = i == _sections.Length - 1;
                var secId = sec.Id;
                <div class="@(isLast && !isExpanded ? "" : "border-b")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : secId)">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetSectionDot(sec.Id))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@sec.Title</span>
                            <p class="mt-0.5 text-xs text-muted-foreground">@sec.Content.Length items</p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>
                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <ul class="space-y-2.5">
                                @foreach (var item in sec.Content)
                                {
                                    <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted-foreground">
                                        <span class="mt-2 size-1.5 shrink-0 rounded-full bg-muted-foreground/40"></span>
                                        @item
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }

            @* Actions *@
            <div class="flex items-center gap-2 border-t px-4 py-3">
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 text-xs text-muted-foreground"
                          @onclick="@(() => _viewState = "idle")">
                    Analyze another
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="ml-auto h-7 text-xs">
                    Ask follow-up
                </ButtonCn>
            </div>
        </div>
    }
</section>

@code {
    private record FileInfo(string Name, string Size, string Type, string LastModified);
    private record AnalysisSection(string Id, string Title, string[] Content);

    private static readonly FileInfo _fileInfo = new("Q4-2025-Revenue-Report.pdf", "2.4 MB", "PDF Document", "March 12, 2026");

    private static readonly AnalysisSection[] _sections =
    {
        new("summary", "Summary", new[]
        {
            "This 42-page quarterly revenue report covers Q4 2025 financial performance across three business units: SaaS Platform ($12.8M), Professional Services ($4.2M), and Enterprise Licensing ($8.6M).",
            "Total revenue reached $25.6M, representing a 23% year-over-year increase. The report includes 14 data tables, 8 charts, and an executive summary with forward-looking guidance."
        }),
        new("findings", "Key findings", new[]
        {
            "SaaS net revenue retention hit 134%, up from 118% in Q3, driven by upselling to existing enterprise accounts.",
            "Customer acquisition cost (CAC) decreased 15% due to organic traffic growth from content marketing initiatives.",
            "Churn rate increased slightly from 2.1% to 2.4%, concentrated in the SMB segment with contracts under $10K ARR.",
            "Gross margin improved to 78.3% from 74.1% as infrastructure costs were optimized through edge caching."
        }),
        new("recommendations", "Recommendations", new[]
        {
            "Prioritize SMB retention by introducing a mid-tier plan between Starter and Pro to reduce the price gap driving churn.",
            "Accelerate the enterprise pipeline by allocating 20% more resources to the solutions engineering team, which has a 3.2x ROI.",
            "Consider expanding the content marketing team\u2014organic acquisition is now 40% of new revenue at one-fifth the CAC of paid channels."
        })
    };

    private string _viewState = "analyzed";
    private int _uploadProgress = 100;
    private string? _expanded = "summary";

    private static string GetSectionDot(string id) => id switch
    {
        "summary" => "bg-blue-500",
        "findings" => "bg-amber-500",
        "recommendations" => "bg-emerald-500",
        _ => "bg-muted-foreground"
    };

    private async Task SimulateUpload()
    {
        _viewState = "uploading";
        _uploadProgress = 0;
        StateHasChanged();
        while (_uploadProgress < 100)
        {
            await Task.Delay(200);
            _uploadProgress = Math.Min(_uploadProgress + 12, 100);
            StateHasChanged();
        }
        _viewState = "analyzed";
    }
}
