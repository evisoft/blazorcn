@* ===========================================================
   Block: ai-prompt-with-system-role
   Title: Ai Prompt With System Role
   Description: AI prompt with system role selector, editable system prompts, and context display
   Dependencies: ButtonCn, LucideArrowUpCn, SelectCn
   Source: original/blocks/ai/ai-prompt-with-system-role.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Role selector *@
        <div class="flex items-center justify-between gap-4 border-b px-4 py-3">
            <span class="text-sm font-medium">AI Persona</span>
            <SelectCn TValue="string" Value="@_selectedRoleId" ValueChanged="v => _selectedRoleId = v">
                <SelectTriggerCn Class="h-7 w-44 text-xs">
                    <SelectValueCn />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var role in _roles)
                    {
                        <SelectItemCn Value="@role.Id">
                            @role.Name
                        </SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>
        </div>

        @* System prompt *@
        <div class="border-b px-4 py-3">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">System prompt</span>
                @if (_customPrompts[_selectedRoleId] != SelectedRole.SystemPrompt)
                {
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm"
                              Class="h-6 px-2 text-[11px] text-muted-foreground"
                              @onclick="@(() => _customPrompts[_selectedRoleId] = SelectedRole.SystemPrompt)">
                        Reset
                    </ButtonCn>
                }
            </div>
            <textarea @bind="CurrentSystemPrompt"
                      rows="3"
                      class="min-h-[68px] w-full resize-none rounded-md border-0 bg-muted/50 p-3 text-xs leading-relaxed text-muted-foreground shadow-none outline-none focus-visible:ring-0"></textarea>
        </div>

        @* User input *@
        <div class="px-4 py-3">
            <textarea @bind="_input" @bind:event="oninput"
                      placeholder="@($"Ask the {SelectedRole.Name}...")"
                      rows="3"
                      class="min-h-[72px] max-h-40 w-full resize-none border-0 bg-transparent p-0 text-sm shadow-none outline-none focus-visible:ring-0"></textarea>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <span class="text-xs text-muted-foreground">
                Responding as <span class="font-medium text-foreground">@SelectedRole.Name</span>
            </span>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Default"
                      Disabled="@(string.IsNullOrWhiteSpace(_input))"
                      Class="h-7 gap-1.5 text-xs"
                      @onclick="HandleSubmit">
                <LucideArrowUpCn Size="16" Class="size-3.5" />
                Send
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Role(string Id, string Name, string Description, string SystemPrompt);

    private static readonly Role[] _roles =
    {
        new("default", "Default", "General-purpose assistant",
            "You are a helpful, friendly AI assistant. Provide clear, accurate, and well-structured responses. When unsure, acknowledge uncertainty. Use markdown formatting for readability."),
        new("code-expert", "Code Expert", "Senior software engineer",
            "You are a senior software engineer with deep expertise in TypeScript, React, Next.js, and system design. Write clean, well-typed, production-ready code. Explain architectural decisions. Follow SOLID principles. Include error handling and edge cases. Prefer composition over inheritance."),
        new("creative-writer", "Creative Writer", "Compelling storyteller and copywriter",
            "You are a creative writer and copywriter with expertise in storytelling, persuasion, and brand voice. Write engaging, emotionally resonant content. Use vivid language, varied sentence structure, and strong hooks. Adapt tone to the audience and medium. Avoid cliches and corporate jargon."),
        new("data-analyst", "Data Analyst", "Quantitative researcher and analyst",
            "You are a quantitative data analyst with expertise in statistics, SQL, Python, and data visualization. Provide data-driven insights with statistical rigor. Mention confidence levels and potential biases. Suggest appropriate chart types for visualization. Use precise numerical language.")
    };

    private string _selectedRoleId = "default";
    private readonly Dictionary<string, string> _customPrompts;
    private string _input = "";

    public AiPromptWithSystemRole()
    {
        _customPrompts = _roles.ToDictionary(r => r.Id, r => r.SystemPrompt);
    }

    private Role SelectedRole => _roles.FirstOrDefault(r => r.Id == _selectedRoleId) ?? _roles[0];

    private string CurrentSystemPrompt
    {
        get => _customPrompts.GetValueOrDefault(_selectedRoleId, SelectedRole.SystemPrompt);
        set => _customPrompts[_selectedRoleId] = value;
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
