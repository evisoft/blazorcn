@* ===========================================================
   Block: ai-accessibility-checker
   Title: Ai Accessibility Checker
   Description: AI accessibility audit block with score display, severity-sorted issues, affected selectors, and AI fix suggestions
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideCheckCn, LucideChevronRightCn, LucideCopyCn
   Source: original/blocks/ai/ai-accessibility-checker.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* URL input *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <InputCn Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0"
                     Placeholder="Enter URL to audit..."
                     @bind-Value="_url" aria-label="Enter URL to audit..." />
            <ButtonCn Class="h-7 shrink-0 text-xs" Size="ButtonSize.Sm" Variant="ButtonVariant.Outline">
                Audit
            </ButtonCn>
        </div>

        @* Score summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="@Cn.Merge("text-2xl font-semibold tabular-nums", ScoreColor)">@Score</span>
                <span class="text-xs text-muted-foreground">/100</span>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal">
                @Assessment
            </BadgeCn>
            <span class="text-xs text-muted-foreground">&middot;</span>
            <span class="text-xs text-muted-foreground">@_issues.Length issues</span>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @CriticalCount
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-amber-500"></span>
                    @WarningCount
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-blue-500"></span>
                    @InfoCount
                </span>
            </div>
        </div>

        @* Issues *@
        <div>
            @for (var i = 0; i < _issues.Length; i++)
            {
                var issue = _issues[i];
                var isExpanded = _expanded == issue.Id;
                var isLast = i == _issues.Length - 1;
                <div class="@(!isLast ? "border-b" : "")">
                    @{
                        var issueId = issue.Id;
                    }
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : issueId)">
                        <span class="@Cn.Merge("size-2 shrink-0 rounded-full", GetSeverityDot(issue.Severity))"></span>
                        <div class="min-w-0 flex-1">
                            <span class="text-sm font-medium">@issue.Title</span>
                            <p class="mt-0.5 truncate font-mono text-xs text-muted-foreground">
                                @issue.Element
                            </p>
                        </div>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-4 pl-9">
                            <p class="mb-3 text-sm leading-relaxed text-muted-foreground">
                                @issue.Description
                            </p>
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="mb-1.5 flex items-center justify-between">
                                    <span class="text-xs font-medium text-muted-foreground">
                                        Suggested fix
                                    </span>
                                    <ButtonCn Class="h-6 gap-1 px-2 text-xs"
                                              Variant="ButtonVariant.Ghost"
                                              Size="ButtonSize.Sm"
                                              @onclick="@(() => HandleCopyFix(issueId))">
                                        @if (_copied == issueId)
                                        {
                                            <LucideCheckCn Size="16" Class="size-3" />
                                            <text>Copied</text>
                                        }
                                        else
                                        {
                                            <LucideCopyCn Size="16" Class="size-3" />
                                            <text>Copy</text>
                                        }
                                    </ButtonCn>
                                </div>
                                <p class="text-sm leading-relaxed">@issue.Fix</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record IssueInfo(string Id, string Severity, string Title, string Element, string Description, string Fix);

    private const int Score = 72;

    private static readonly IssueInfo[] _issues =
    {
        new("1", "critical", "Images missing alt text", "img.hero-image, img.product-thumb",
            "3 images lack alternative text, failing WCAG 2.1 SC 1.1.1. Screen reader users cannot perceive these images.",
            "Add descriptive alt attributes. For decorative images, use alt=\"\" with role=\"presentation\"."),
        new("2", "critical", "Insufficient color contrast", "p.subtitle, span.helper-text",
            "Text color #9CA3AF on #FFFFFF has a 2.9:1 contrast ratio, below the 4.5:1 WCAG AA minimum for normal text.",
            "Change text color to #6B7280 for 5.0:1 contrast ratio. Alternatively, increase font size above 18px to qualify for the 3:1 large-text threshold."),
        new("3", "warning", "Missing form labels", "input#email, input#search",
            "2 form inputs have no associated label element. Screen readers cannot announce the purpose of these fields.",
            "Add a label element before each input, or use aria-label for visually hidden labels."),
        new("4", "warning", "Focus order is not logical", "nav.main-nav > a",
            "Tab order skips primary navigation due to tabindex manipulation. Keyboard users encounter an unexpected flow.",
            "Remove custom tabindex values from navigation links. Use natural DOM order for focus sequence. Use CSS flexbox order for visual reordering."),
        new("5", "info", "Missing skip navigation link", "body > header",
            "No skip-to-content link provided. Keyboard users must tab through the entire navigation on every page load.",
            "Add a visually hidden skip link as the first focusable element."),
        new("6", "info", "Missing landmark regions", "div.content-wrapper",
            "Main content uses a generic div instead of semantic main. Screen readers cannot identify the primary content region.",
            "Replace the generic div with a main element. Use header, nav, and footer for other regions.")
    };

    private string _url = "https://acme.com/dashboard";
    private string? _expanded = "2";
    private string? _copied;

    private int CriticalCount => _issues.Count(i => i.Severity == "critical");
    private int WarningCount => _issues.Count(i => i.Severity == "warning");
    private int InfoCount => _issues.Count(i => i.Severity == "info");

    private string ScoreColor => Score >= 90
        ? "text-emerald-600 dark:text-emerald-400"
        : Score >= 50
            ? "text-amber-600 dark:text-amber-400"
            : "text-red-600 dark:text-red-400";

    private string Assessment => Score >= 90 ? "Passing" : Score >= 50 ? "Needs work" : "Failing";

    private static string GetSeverityDot(string severity) => severity switch
    {
        "critical" => "bg-red-500",
        "warning" => "bg-amber-500",
        "info" => "bg-blue-500",
        _ => "bg-gray-500"
    };

    private async Task HandleCopyFix(string id)
    {
        _copied = id;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = null;
    }
}
