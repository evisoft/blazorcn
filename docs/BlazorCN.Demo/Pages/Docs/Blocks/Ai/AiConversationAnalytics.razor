@* ===========================================================
   Block: ai-conversation-analytics
   Title: Ai Conversation Analytics
   Description: AI conversation analytics with stats, topic distribution, sentiment breakdown, and conversation table
   Dependencies: BadgeCn, LucideChevronRightCn
   Source: original/blocks/ai/ai-conversation-analytics.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Stats summary *@
        <div class="flex items-center gap-4 border-b px-4 py-3">
            <span class="text-sm font-medium">Conversation Analytics</span>
            <span class="text-xs text-muted-foreground">Last 30 days</span>
            <div class="ml-auto flex items-center gap-4">
                <div class="text-right">
                    <span class="text-2xl font-semibold tabular-nums">
                        @TotalConversations.ToString("N0")
                    </span>
                    <span class="ml-1.5 text-xs text-muted-foreground">total</span>
                </div>
            </div>
        </div>

        @* Key metrics *@
        <div class="flex items-center gap-6 border-b px-4 py-3">
            <div class="flex items-baseline gap-1">
                <span class="font-semibold tabular-nums">@AvgLength</span>
                <span class="text-xs text-muted-foreground">avg msgs</span>
            </div>
            <div class="flex items-baseline gap-1">
                <span class="font-semibold tabular-nums">@SatisfactionRating</span>
                <span class="text-xs text-muted-foreground">/5 satisfaction</span>
            </div>
            <div class="ml-auto flex items-center gap-3">
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    @(SentimentPositive)%
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-muted-foreground"></span>
                    @(SentimentNeutral)%
                </span>
                <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
                    <span class="size-1.5 rounded-full bg-red-500"></span>
                    @(SentimentNegative)%
                </span>
            </div>
        </div>

        @* Topic distribution *@
        <div class="border-b px-4 py-3">
            <span class="text-xs font-medium text-muted-foreground">Topics</span>
            <div class="mt-2 space-y-2">
                @foreach (var t in _topics)
                {
                    <div class="flex items-center gap-3">
                        <span class="w-28 truncate text-sm">@t.Topic</span>
                        <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
                            <div class="h-full rounded-full bg-foreground/20"
                                 style="@($"width: {t.Pct}%")"></div>
                        </div>
                        <span class="w-8 text-right font-mono text-xs tabular-nums text-muted-foreground">
                            @(t.Pct)%
                        </span>
                        <span class="w-10 text-right font-mono text-xs tabular-nums text-muted-foreground">
                            @t.Count
                        </span>
                    </div>
                }
            </div>
        </div>

        @* Recent conversations *@
        <div>
            <div class="px-4 py-2">
                <span class="text-xs font-medium text-muted-foreground">Recent conversations</span>
            </div>
            @for (var i = 0; i < _conversations.Length; i++)
            {
                var conv = _conversations[i];
                var isExpanded = _expanded == conv.Id;
                var isLast = i == _conversations.Length - 1;
                var convId = conv.Id;
                <div class="@(!isLast ? "border-b" : "")">
                    <button type="button"
                            class="flex w-full items-center gap-3 px-4 py-2.5 text-left transition-colors hover:bg-muted/50"
                            @onclick="@(() => _expanded = isExpanded ? null : convId)">
                        <span class="@Cn.Merge("size-1.5 shrink-0 rounded-full", GetSentimentDot(conv.Sentiment))"></span>
                        <span class="w-28 truncate text-sm font-medium">@conv.User</span>
                        <span class="min-w-0 flex-1 truncate text-xs text-muted-foreground">@conv.Topic</span>
                        <span class="font-mono text-xs tabular-nums text-muted-foreground">
                            @conv.Messages msgs
                        </span>
                        <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                    </button>

                    @if (isExpanded)
                    {
                        <div class="px-4 pb-3 pl-9">
                            <div class="rounded-md bg-muted/50 p-3">
                                <div class="flex items-center gap-4 text-xs">
                                    <span class="text-muted-foreground">Sentiment</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs font-normal capitalize">
                                        @conv.Sentiment
                                    </BadgeCn>
                                    <span class="text-muted-foreground">Rating</span>
                                    <span class="flex items-center gap-0.5">
                                        @for (var j = 0; j < 5; j++)
                                        {
                                            <span class="@Cn.Merge("size-1.5 rounded-full", j < conv.Satisfaction ? "bg-foreground" : "bg-muted")"></span>
                                        }
                                    </span>
                                    <span class="ml-auto text-muted-foreground">@conv.Timestamp</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>

@code {
    private record TopicData(string Topic, int Count, int Pct);
    private record RecentConversation(string Id, string User, string Topic, int Messages, int Satisfaction, string Sentiment, string Timestamp);

    private const int TotalConversations = 2847;
    private const double AvgLength = 8.3;
    private const double SatisfactionRating = 4.2;
    private const int SentimentPositive = 68;
    private const int SentimentNeutral = 24;
    private const int SentimentNegative = 8;

    private static readonly TopicData[] _topics =
    {
        new("Technical Support", 892, 31),
        new("Product Questions", 684, 24),
        new("Code Assistance", 541, 19),
        new("Content Writing", 398, 14),
        new("Data Analysis", 332, 12)
    };

    private static readonly RecentConversation[] _conversations =
    {
        new("1", "Sarah Chen", "Technical Support", 12, 5, "positive", "5 min ago"),
        new("2", "James Wilson", "Code Assistance", 8, 4, "positive", "18 min ago"),
        new("3", "Maria Garcia", "Product Questions", 5, 3, "neutral", "32 min ago"),
        new("4", "Alex Turner", "Data Analysis", 15, 5, "positive", "1 hr ago"),
        new("5", "Priya Patel", "Technical Support", 6, 2, "negative", "2 hr ago")
    };

    private string? _expanded;

    private static string GetSentimentDot(string sentiment) => sentiment switch
    {
        "positive" => "bg-emerald-500",
        "neutral" => "bg-muted-foreground",
        "negative" => "bg-red-500",
        _ => "bg-gray-500"
    };
}
