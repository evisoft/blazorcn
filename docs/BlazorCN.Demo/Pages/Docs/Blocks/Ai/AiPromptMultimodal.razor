@* ===========================================================
   Block: ai-prompt-multimodal
   Title: Ai Prompt Multimodal
   Description: React AI multimodal prompt block for Next.js with image, audio, document, and URL attachment support using shadcn/ui and Tailwind CSS
   Dependencies: BadgeCn, ButtonCn
   Source: original/blocks/ai/ai-prompt-multimodal.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Attachment type selector *@
        <div class="flex items-center gap-1 border-b px-4 py-2.5">
            <span class="mr-1.5 text-muted-foreground text-xs">Attach</span>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideImageCn Size="12" Class="size-3" />
                Image
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideMicCn Size="12" Class="size-3" />
                Audio
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideFileTextCn Size="12" Class="size-3" />
                Doc
            </ButtonCn>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1.5 text-xs">
                <LucideGlobeCn Size="12" Class="size-3" />
                URL
            </ButtonCn>
        </div>

        @* Attached items *@
        @if (_attachments.Count > 0)
        {
            <div class="flex flex-wrap gap-1.5 border-b px-4 py-2.5">
                @foreach (var attachment in _attachments)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5 pl-2 pr-1 font-normal text-xs">
                        @if (attachment.Type == "image")
                        {
                            <LucideImageCn Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        }
                        else if (attachment.Type == "audio")
                        {
                            <LucideMicCn Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        }
                        else if (attachment.Type == "document")
                        {
                            <LucideFileTextCn Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        }
                        else
                        {
                            <LucideGlobeCn Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                        }
                        <span class="max-w-28 truncate">@attachment.Name</span>
                        @if (!string.IsNullOrEmpty(attachment.Meta))
                        {
                            <span class="text-muted-foreground text-[10px]">@attachment.Meta</span>
                        }
                        <button
                            type="button"
                            @onclick="@(() => _attachments.Remove(attachment))"
                            class="ml-0.5 rounded-full p-0.5 transition-colors hover:bg-muted-foreground/20" aria-label="@($"Remove {attachment.Name}")">
                            <LucideXCn Size="10" Class="size-2.5" />
                        </button>
                    </BadgeCn>
                }
            </div>
        }

        @* Textarea *@
        <div class="px-4 pt-3 pb-2">
            <textarea @bind="_input"
                placeholder="Describe what you want to do with these files..."
                rows="3"
                class="w-full min-h-[72px] max-h-40 resize-none bg-transparent text-sm leading-relaxed placeholder:text-muted-foreground outline-none" aria-label="Describe what you want to do with these files..."></textarea>
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-2.5">
            <div class="flex items-center gap-2">
                <span class="text-muted-foreground text-xs">
                    @if (_attachments.Count > 0)
                    {
                        @($"{_attachments.Count} file{(_attachments.Count != 1 ? "s" : "")}")
                    }
                    else
                    {
                        <text>No files</text>
                    }
                </span>
                @if (_attachments.Count > 0)
                {
                    <button
                        type="button"
                        @onclick="@(() => _attachments.Clear())"
                        class="text-muted-foreground text-xs underline-offset-4 transition-colors hover:text-foreground hover:underline">
                        Clear all
                    </button>
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(_input) || _attachments.Count > 0)
            {
                <ButtonCn aria-label="Send prompt" Size="ButtonSize.Sm" Class="h-7 w-7 rounded-full p-0">
                    <LucideArrowUpCn Size="16" Class="size-4" />
                </ButtonCn>
            }
        </div>
    </div>
</section>

@code {
    private record Attachment(string Id, string Type, string Name, string? Meta = null);

    private List<Attachment> _attachments = new()
    {
        new("a1", "image", "dashboard-screenshot.png", "1.2 MB"),
        new("a2", "document", "requirements.pdf", "340 KB"),
        new("a3", "url", "https://docs.example.com/api", "Web page"),
    };

    private string _input = "";
}
