    private string _userMessage = ""Explain React Server Components in 2-3 sentences."";
    private ResponseData? _response;
    private bool _loading;
    private string _activeTab = ""request"";
    private bool _copied;

    private string RequestJson => @$""{{
  """"model"""": """"{_model}"""",
  """"temperature"""": {_temperature:F1},
  """"max_tokens"""": {(int)_maxTokens},
  """"messages"""": [
    {{ """"role"""": """"system"""", """"content"""": """"{_systemPrompt}"""" }},
    {{ """"role"""": """"user"""", """"content"""": """"{_userMessage}"""" }}
  ]
}}"";

    private string ResponseJson => _response == null ? """" : @$""{{
  """"id"""": """"{_response.Id}"""",
  """"object"""": """"chat.completion"""",
  """"model"""": """"{_response.Model}"""",
  """"choices"""": [
    {{
      """"index"""": 0,
      """"message"""": {{
        """"role"""": """"assistant"""",
        """"content"""": """"{_response.Content}""""
      }},
      """"finish_reason"""": """"stop""""
    }}
  ],
  """"usage"""": {{ """"prompt_tokens"""": {_response.PromptTokens}, """"completion_tokens"""": {_response.CompletionTokens}, """"total_tokens"""": {_response.TotalTokens} }}
}}"";

    private async Task HandleSend()
    {
        _loading = true;
        _activeTab = ""response"";
        StateHasChanged();
        await Task.Delay(1500);
        _response = new(""chatcmpl-9k2x4fR3mN"", _model, 42, 58, 100,
            ""React Server Components render on the server and send HTML to the client. They reduce bundle size by keeping server-only code out of the client bundle, enable direct database access, and improve initial page load performance."");
        _loading = false;
    }

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
