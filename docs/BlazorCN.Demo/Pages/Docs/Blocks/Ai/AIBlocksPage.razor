    private record ResultRow(int Id, string Name, string Email, string CreatedAt, int OrderCount, string TotalSpent);
    private record SqlLine(int Number, string Html);

    private string _query = ""Show me all users who signed up last month with their order counts"";
    private string _activeTab = ""sql"";
    private bool _copied;

    private static readonly string[] _suggestions =
    [
        ""Show top 10 customers by revenue"",
        ""Count active users per month"",
        ""Find orders without payments"",
        ""Average order value by category"",
    ];

    private const string _generatedSql = @""SELECT
  u.id,
  u.name,
  u.email,
  u.created_at,
  COUNT(o.id) AS order_count,
  SUM(o.total) AS total_spent
FROM users u
LEFT JOIN orders o ON o.user_id = u.id
WHERE u.created_at >= DATE_TRUNC('month', CURRENT_DATE - INTERVAL '1 month')
  AND u.created_at < DATE_TRUNC('month', CURRENT_DATE)
GROUP BY u.id, u.name, u.email, u.created_at
ORDER BY u.created_at DESC
LIMIT 50;"";

    private static readonly HashSet<string> _sqlKeywords = new(StringComparer.Ordinal)
    {
        ""SELECT"", ""FROM"", ""LEFT JOIN"", ""WHERE"", ""AND"", ""GROUP BY"", ""ORDER BY"", ""LIMIT"",
        ""ON"", ""AS"", ""COUNT"", ""SUM"", ""DATE_TRUNC"", ""CURRENT_DATE"", ""INTERVAL"", ""DESC"",
    };

    private static readonly SqlLine[] _sqlLines = BuildSqlLines();

    private static SqlLine[] BuildSqlLines()
    {
        var lines = _generatedSql.Split('\n');
        var result = new SqlLine[lines.Length];
        for (var i = 0; i < lines.Length; i++)
        {
            var parts = System.Text.RegularExpressions.Regex.Split(lines[i],
                @""(\b(?:SELECT|FROM|LEFT JOIN|WHERE|AND|GROUP BY|ORDER BY|LIMIT|ON|AS|COUNT|SUM|DATE_TRUNC|CURRENT_DATE|INTERVAL|DESC)\b)"");
            var sb = new System.Text.StringBuilder();
            foreach (var part in parts)
            {
                if (_sqlKeywords.Contains(part))
                    sb.Append($""<span class=\""text-blue-400\"">{System.Net.WebUtility.HtmlEncode(part)}</span>"");
                else
                    sb.Append(System.Net.WebUtility.HtmlEncode(part));
            }
            result[i] = new SqlLine(i + 1, sb.ToString());
        }
        return result;
    }

