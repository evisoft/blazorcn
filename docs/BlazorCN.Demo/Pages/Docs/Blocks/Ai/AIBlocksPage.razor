    private void AddIngredient(string value)
    {
        var trimmed = value.Trim().ToLowerInvariant();
        if (!string.IsNullOrEmpty(trimmed) && !_ingredients.Contains(trimmed))
            _ingredients.Add(trimmed);
        _inputValue = """";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is ""Enter"" or "","")
        {
            AddIngredient(_inputValue);
        }
        else if (e.Key == ""Backspace"" && string.IsNullOrEmpty(_inputValue) && _ingredients.Count > 0)
        {
            _ingredients.RemoveAt(_ingredients.Count - 1);
        }
    }

    private void ToggleDietary(string id)
    {
        if (_dietaryRestrictions.Contains(id))
            _dietaryRestrictions.Remove(id);
        else
            _dietaryRestrictions.Add(id);
    }

    private void ToggleIngredientCheck(int index)
    {
        if (!_checkedIngredients.Add(index))
            _checkedIngredients.Remove(index);
    }

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
