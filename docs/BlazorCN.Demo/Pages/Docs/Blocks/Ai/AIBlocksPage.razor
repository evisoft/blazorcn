@code {
    private record DetectedFeature(string Type, string? Language = null, int Count = 0);

    private static readonly string _sampleInput = @""# API Integration Guide

Build a REST API endpoint in Next.js that:

1. Accepts POST requests with JSON body
2. Validates input using Zod schema
3. Queries PostgreSQL via Prisma
4. Returns paginated results

```typescript
import { z } from """"zod""""

const schema = z.object({
  query: z.string().min(1),
  page: z.number().default(1),
})
```

Make sure to handle errors gracefully and return proper HTTP status codes."";

    private string _input = _sampleInput;

    private int _wordCount => string.IsNullOrWhiteSpace(_input) ? 0 :
        _input.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;

    private DetectedFeature[] _features
    {
        get
        {
            var features = new List<DetectedFeature>();
            var lines = _input.Split('\n');

            var codeBlockMatches = System.Text.RegularExpressions.Regex.Matches(_input, @""```(\w*)"");
            if (codeBlockMatches.Count > 0)
            {
                var languages = codeBlockMatches
                    .Select(m => m.Groups[1].Value.Trim())
                    .Where(l => !string.IsNullOrEmpty(l))
                    .Distinct()
                    .ToList();
                foreach (var lang in languages)
                {
                    features.Add(new DetectedFeature(""code"", Language: lang));
                }
                if (languages.Count == 0)
                {
                    features.Add(new DetectedFeature(""code"", Language: ""plain""));
                }
            }

            var headingCount = lines.Count(l => System.Text.RegularExpressions.Regex.IsMatch(l, @""^#{1,6}\s""));
            if (headingCount > 0)
            {
                features.Add(new DetectedFeature(""heading"", Count: headingCount));
            }

            var listCount = lines.Count(l => System.Text.RegularExpressions.Regex.IsMatch(l, @""^\s*(\d+\.|-|\*)\s""));
            if (listCount > 0)
            {
                features.Add(new DetectedFeature(""list"", Count: listCount));
            }

            var plainCount = lines.Count(l =>
                !string.IsNullOrWhiteSpace(l) &&
                !System.Text.RegularExpressions.Regex.IsMatch(l, @""^#{1,6}\s"") &&
                !System.Text.RegularExpressions.Regex.IsMatch(l, @""^\s*(\d+\.|-|\*)\s"") &&
                !l.StartsWith(""```""));
            if (plainCount > 0)
            {
                features.Add(new DetectedFeature(""text"", Count: plainCount));
            }

            return features.ToArray();
        }
    }
}";

