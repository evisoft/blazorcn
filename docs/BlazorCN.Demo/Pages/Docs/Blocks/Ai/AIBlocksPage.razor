useEffect(() => {
  setLoading(true)
  fetchUser(userId).then(data => {
    setUser(data)
    setLoading(false)
  })
}, [userId])  // <- add dependency array"";

    private const string CodeBlock4 = @""function UserProfile({ userId }: { userId: string }) {
  const [user, setUser] = useState<User | null>(null)
  const [loading, setLoading] = useState(true)

  useEffect(() => {
    setLoading(true)
    fetchUser(userId).then(data => {
      setUser(data)
      setLoading(false)
    })
  }, [userId])

  if (loading) return <Spinner />
  if (!user) return <div>User not found</div>
  return <div>{user.name}</div>
}"";

    private static readonly ChatMessage[] _messages =
    {
        new(""1"", ""user"", ""I'm getting an infinite re-render loop in this React component. Can you find the bug?"",
            CodeBlocks: new[] { new CodeBlock(""UserProfile.tsx"", CodeBlock1) }),
        new(""2"", ""assistant"",
            ""Found it! Your useEffect is missing a dependency array, so it runs after every render \u2014 causing an infinite fetch loop."",
            Reasoning: ""Looking at this component, the issue is in the useEffect hook.\n\nThe useEffect has no dependency array at all. This means it runs after every single render:\n\n1. Component mounts \u2014 useEffect fires \u2014 fetches data\n2. setUser(data) triggers re-render\n3. Re-render \u2014 useEffect fires again (no deps = runs every render)\n4. setUser(data) triggers another re-render\n5. Infinite loop\n\nThe fix is adding [userId] as the dependency array so it only refetches when userId changes.\n\nAlso, there's a potential null reference bug \u2014 if setLoading(false) runs before setUser, the component would try to access null.name. But since both setState calls are in the same .then(), React batches them, so this is actually fine in React 18+. Still, adding a null check is safer."",
            ReasoningDuration: 5,
            CodeBlocks: new[] { new CodeBlock(""Bug"", CodeBlock2), new CodeBlock(""Fix"", CodeBlock3), new CodeBlock(""Full corrected component"", CodeBlock4) })
    };

