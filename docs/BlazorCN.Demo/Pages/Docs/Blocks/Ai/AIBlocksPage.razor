@code {
    private class ReactionItem
    {
        public string Emoji { get; set; } = """";
        public int Count { get; set; }
        public bool Reacted { get; set; }
    }

    private static readonly string[] _emojiOptions =
    {
        ""\ud83d\udc4d"", ""\ud83d\udc4e"", ""\u2764\ufe0f"", ""\ud83c\udfaf"", ""\ud83d\udca1"", ""\ud83d\udd25"",
        ""\ud83d\udc4f"", ""\ud83d\ude80"", ""\ud83d\udc8e"", ""\u2728"", ""\ud83e\udd14"", ""\ud83d\ude02"",
        ""\ud83d\ude0d"", ""\ud83d\ude4c"", ""\ud83d\udcaa"", ""\ud83c\udf89"", ""\u2b50"", ""\ud83d\udcaf""
    };

    private readonly List<ReactionItem> _reactions = new()
    {
        new() { Emoji = ""\ud83d\udc4d"", Count = 12, Reacted = false },
        new() { Emoji = ""\ud83c\udfaf"", Count = 5, Reacted = true },
        new() { Emoji = ""\ud83d\udca1"", Count = 3, Reacted = false },
        new() { Emoji = ""\u2764\ufe0f"", Count = 8, Reacted = false }
    };

    private bool _popoverOpen;

    private int TotalReactions => _reactions.Sum(r => r.Count);

    private void ToggleReaction(string emoji)
    {
        var existing = _reactions.FirstOrDefault(r => r.Emoji == emoji);
        if (existing != null)
        {
            if (existing.Reacted)
            {
                existing.Count--;
                existing.Reacted = false;
                if (existing.Count <= 0)
                    _reactions.Remove(existing);
            }
            else
            {
                existing.Count++;
                existing.Reacted = true;
            }
        }
        else
        {
            _reactions.Add(new ReactionItem { Emoji = emoji, Count = 1, Reacted = true });
        }
    }

    private void AddReaction(string emoji)
    {
        _popoverOpen = false;
        var existing = _reactions.FirstOrDefault(r => r.Emoji == emoji);
        if (existing != null)
        {
            if (!existing.Reacted)
                ToggleReaction(emoji);
            return;
        }
        _reactions.Add(new ReactionItem { Emoji = emoji, Count = 1, Reacted = true });
    }
}";

