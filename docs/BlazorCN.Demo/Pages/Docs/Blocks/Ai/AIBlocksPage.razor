                                <LucideChevronRightCn Size=""16"" Class=""@Cn.Merge(""size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200"", isExpanded ? ""rotate-90"" : """")"" />
                            </button>
                            <ButtonCn aria-label=""Dismiss suggestion"" Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm""
                                      Class=""size-6 shrink-0 p-0 text-muted-foreground hover:text-foreground""
                                      @onclick=""@(() => _dismissedSuggestions.Add(suggestionId))"">
                                <LucideXCn Size=""16"" Class=""size-3"" />
                            </ButtonCn>
                        </div>

                        @if (isExpanded)
                        {
                            <div class=""px-4 pb-4 pl-9"">
                                <div class=""rounded-md bg-muted/50 p-3"">
                                    <div class=""mb-1.5 flex items-center justify-between"">
                                        <span class=""text-xs font-medium text-muted-foreground"">
                                            Suggested improvement
                                        </span>
                                        <ButtonCn Variant=""ButtonVariant.Ghost"" Size=""ButtonSize.Sm""
                                                  Class=""h-6 gap-1 px-2 text-xs""
                                                  @onclick=""@(() => HandleCopy(suggestionId))"">
                                            @if (_copied == suggestionId)
                                            {
                                                <LucideCheckCn Size=""16"" Class=""size-3"" />
                                                <text>Copied</text>
                                            }
                                            else
                                            {
                                                <LucideCopyCn Size=""16"" Class=""size-3"" />
                                                <text>Copy</text>
                                            }
                                        </ButtonCn>
                                    </div>
                                    <p class=""text-sm leading-relaxed"">@suggestion.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</section>

