@code {
    private record DocumentChunk(string Id, string Title, string Content, int Relevance, int Page, string Highlight);

    private static readonly DocumentChunk[] _chunks =
    {
        new(""1"", ""React Server Components RFC"",
            ""Server Components allow developers to build apps that span the server and client, combining the rich interactivity of client-side apps with the improved performance of traditional server rendering."",
            96, 12, ""Server Components""),
        new(""2"", ""Next.js App Router Documentation"",
            ""The App Router uses React Server Components by default, enabling you to easily render components on the server and reduce the amount of JavaScript sent to the client."",
            91, 3, ""React Server Components by default""),
        new(""3"", ""Vercel AI SDK Guide"",
            ""When building AI applications with Server Components, you can stream responses from the server directly to the client without needing client-side JavaScript for the initial render."",
            84, 27, ""stream responses from the server""),
        new(""4"", ""React 19 Release Notes"",
            ""React 19 stabilizes Server Components and introduces the use() hook for reading resources like promises and context during render, simplifying data fetching patterns."",
            78, 1, ""stabilizes Server Components"")
    };

    private static readonly string[] _answerParagraphs =
    {
        ""React Server Components (RSC) fundamentally change how React applications handle rendering by allowing components to execute on the server [1]."",
        ""Unlike traditional SSR, Server Components never ship JavaScript to the client \u2014 they render on the server and send only the resulting UI. This reduces bundle size significantly and improves initial load performance [2]."",
        ""Key benefits include: direct database access from components without API routes, zero client-side JavaScript for static content, streaming support for progressive rendering [3], and automatic code splitting at the component boundary."",
        ""React 19 officially stabilized the Server Components API and introduced complementary features like the use() hook for resource reading [4].""
    };

    private string _query = ""How do React Server Components work?"";
