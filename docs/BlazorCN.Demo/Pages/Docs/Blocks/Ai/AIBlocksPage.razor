        [""report""] = new(""Q4 2025 Engineering Productivity Report"",
            ""Executive Summary\n\nThis report analyzes engineering team productivity metrics for Q4 2025, covering deployment frequency, incident response times, and code quality indicators across all product teams.\n\nKey Findings\n\nDeployment Frequency: Teams averaged 47 deployments per week, a 23% increase from Q3. The platform team led with 12 daily deployments following their migration to trunk-based development.\n\nMean Time to Recovery (MTTR): Average MTTR decreased from 42 minutes to 28 minutes, attributed to improved observability tooling and automated rollback procedures implemented in October.\n\nCode Review Turnaround: PR review times averaged 3.2 hours, down from 5.1 hours in Q3. The introduction of AI-assisted code review reduced initial review overhead by approximately 40%.\n\nIncident Volume: Total P1 incidents decreased by 31% compared to Q3. The most significant improvement came from the payments team, which eliminated an entire class of race conditions through database-level constraints.\n\nRecommendations\n\n1. Expand trunk-based development practices to remaining teams\n2. Invest in automated testing coverage for critical paths (currently at 78%, target 90%)\n3. Standardize on the new incident response playbook across all teams\n4. Continue AI-assisted code review rollout to the mobile team\n\nNext Steps\n\nSchedule Q1 planning reviews with engineering managers by January 15th to align on targets and resource allocation."",
            298, ""Technical Report""),
        [""email""] = new(""Partnership Proposal: DevTools Integration"",
            ""Hi Sarah,\n\nI hope this message finds you well. I wanted to follow up on our conversation at React Summit about a potential integration between our platforms.\n\nAfter discussing with our engineering team, we believe there's a strong opportunity to integrate your analytics SDK directly into our component library. This would give your users instant access to performance metrics for every component they ship.\n\nHere's what we're proposing:\n\n- A lightweight wrapper component that automatically instruments renders\n- Dashboard integration showing component-level performance data\n- Shared documentation and co-marketing for the launch\n\nBased on our estimates, this integration could reach approximately 45,000 developers in the first quarter alone. We've seen similar partnerships drive 3-4x increases in SDK adoption.\n\nI'd love to schedule a 30-minute call next week to walk through the technical details and discuss timelines. Would Tuesday or Wednesday afternoon work for your team?\n\nLooking forward to exploring this together.\n\nBest regards,\nAlex Chen\nHead of Partnerships"",
            187, ""Professional Email"")
    };

    private string _docType = ""blog"";
    private string _tone = ""professional"";
    private double _length = 500;
    private bool _copied;

    private GeneratedDocument CurrentDoc => _documents[_docType];
    private string LengthLabel => _length < 300 ? ""Short"" : _length < 800 ? ""Medium"" : ""Long"";

    private DocParagraph[] GetParagraphs()
    {
        var result = new List<DocParagraph>();
        var parts = CurrentDoc.Content.Split(""\n\n"");
        foreach (var part in parts)
        {
            var trimmed = part.Trim();
            if (string.IsNullOrEmpty(trimmed)) continue;

            if (trimmed.Length < 50 && !trimmed.Contains('.') && !trimmed.StartsWith(""- ""))
            {
                result.Add(new DocParagraph(""heading"", trimmed));
            }
            else if (trimmed.StartsWith(""- "") || trimmed.Contains(""\n- ""))
            {
                var items = trimmed.Split('\n')
                    .Where(l => l.StartsWith(""- ""))
                    .Select(l => l[2..])
                    .ToArray();
                result.Add(new DocParagraph(""bullets"", Items: items));
            }
            else if (System.Text.RegularExpressions.Regex.IsMatch(trimmed, @""^\d+\.""))
            {
                var items = trimmed.Split('\n')
                    .Where(l => System.Text.RegularExpressions.Regex.IsMatch(l, @""^\d+\.""))
                    .ToArray();
                result.Add(new DocParagraph(""numbered"", Items: items));
            }
            else
            {
                result.Add(new DocParagraph(""body"", trimmed));
            }
        }
        return result.ToArray();
    }

    private async Task HandleCopy()
    {
        _copied = true;
        StateHasChanged();
        await Task.Delay(2000);
        _copied = false;
    }
}
";

