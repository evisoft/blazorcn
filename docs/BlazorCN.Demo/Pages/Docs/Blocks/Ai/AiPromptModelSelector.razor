@* ===========================================================
   Block: ai-prompt-model-selector
   Title: Ai Prompt Model Selector
   Description: AI prompt input with model selector dropdown and quick prompt suggestion buttons for common tasks
   Dependencies: BadgeCn, ButtonCn, SelectCn
   Source: original/blocks/ai/ai-prompt-model-selector.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Textarea *@
        <div class="px-4 pt-3 pb-2">
            <textarea @bind="_inputValue"
                placeholder="Ask anything..."
                rows="3"
                class="w-full min-h-[72px] max-h-52 resize-none bg-transparent text-sm leading-relaxed placeholder:text-muted-foreground outline-none"></textarea>
        </div>

        @* Footer *@
        <div class="flex items-center gap-2 border-t px-3 py-2">
            <SelectCn @bind-Value="_selectedModel">
                <SelectTriggerCn Class="h-7 w-auto gap-1.5 border-0 bg-transparent px-2 text-xs text-muted-foreground shadow-none focus:ring-0">
                    <SelectValueCn Placeholder="Model" />
                </SelectTriggerCn>
                <SelectContentCn>
                    @foreach (var model in _models)
                    {
                        <SelectItemCn Value="@model.Value">
                            <span class="text-sm">@model.Name</span>
                            <span class="ml-2 text-muted-foreground text-xs">@model.Description</span>
                        </SelectItemCn>
                    }
                </SelectContentCn>
            </SelectCn>

            <div class="ml-auto flex items-center gap-1.5">
                @if (!string.IsNullOrWhiteSpace(_inputValue))
                {
                    <ButtonCn
                        Size="ButtonSize.Sm"
                        class="h-7 w-7 rounded-full p-0">
                        <LucideArrowUpCn Size="16" Class="size-4" />
                    </ButtonCn>
                }
                else
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Enter to send
                    </BadgeCn>
                }
            </div>
        </div>
    </div>

    @* Quick prompts *@
    <div class="mt-2 flex flex-wrap justify-center gap-1.5">
        @foreach (var prompt in _quickPrompts)
        {
            <ButtonCn
                Variant="ButtonVariant.Outline"
                Size="ButtonSize.Sm"
                class="h-7 gap-1.5 text-xs"
                @onclick="@(() => _inputValue = prompt.Prompt)">
                @if (prompt.Icon == "FileText")
                {
                    <LucideFileTextCn Size="12" Class="size-3 text-muted-foreground" />
                }
                else if (prompt.Icon == "Gauge")
                {
                    <LucideGaugeCn Size="12" Class="size-3 text-muted-foreground" />
                }
                else
                {
                    <LucideTriangleAlertCn Size="12" Class="size-3 text-muted-foreground" />
                }
                @prompt.Text
            </ButtonCn>
        }
    </div>
</section>

@code {
    private record ModelOption(string Value, string Name, string Description);
    private record QuickPrompt(string Icon, string Text, string Prompt);

    private static readonly ModelOption[] _models =
    [
        new("gpt-5", "GPT-5", "Most advanced model"),
        new("gpt-4o", "GPT-4o", "Fast and capable"),
        new("gpt-4", "GPT-4", "Reliable and accurate"),
        new("claude-3.5", "Claude 3.5 Sonnet", "Great for coding tasks"),
    ];

    private static readonly QuickPrompt[] _quickPrompts =
    [
        new("FileText", "Write documentation", "Write comprehensive documentation for this codebase, including setup instructions, API references, and usage examples."),
        new("Gauge", "Optimize performance", "Analyze the codebase for performance bottlenecks and suggest optimizations to improve loading times and runtime efficiency."),
        new("Alert", "Find and fix 3 bugs", "Scan through the codebase to identify and fix 3 critical bugs, providing detailed explanations for each fix."),
    ];

    private string _inputValue = "";
    private string _selectedModel = "gpt-5";
}
