@* ===========================================================
   Block: ai-prompt-with-persona
   Title: Ai Prompt With Persona
   Description: React AI prompt with persona block for Next.js with selectable AI persona cards featuring avatars, traits, and personality badges using shadcn/ui and Tailwind CSS
   Long Description: React AI Prompt with Mentions Block
   Dependencies: BadgeCn, ButtonCn, TextareaCn
   Source: original/blocks/ai/ai-prompt-with-persona.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Persona selector *@
        <div class="border-b px-4 py-3">
            <span class="mb-2.5 block font-medium text-muted-foreground text-xs">
                Choose a persona
            </span>
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
                @foreach (var persona in _personas)
                {
                    var isSelected = _selectedPersonaId == persona.Id;
                    <button type="button"
                            class="@Cn.Merge("rounded-md border p-2.5 text-left transition-colors", isSelected ? "border-foreground/20 bg-muted/50" : "border-transparent hover:bg-muted/50")"
                            @onclick="@(() => _selectedPersonaId = persona.Id)">
                        <div class="flex items-center gap-1.5">
                            @persona.IconFragment
                            <span class="font-medium text-sm">@persona.Name</span>
                        </div>
                        <p class="mt-1 text-muted-foreground text-[11px] leading-snug line-clamp-2">
                            @persona.Description
                        </p>
                        <div class="mt-2 flex flex-wrap gap-1">
                            @foreach (var trait in persona.Traits)
                            {
                                <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 px-1 font-normal text-[9px]">
                                    @trait
                                </BadgeCn>
                            }
                        </div>
                    </button>
                }
            </div>
        </div>

        @* Input area *@
        <div class="px-4 py-3">
            <TextareaCn @bind-Value="_input"
                        Placeholder="@($"Ask {SelectedPersona.Name}...")"
                        Rows="3"
                        Class="min-h-[72px] max-h-40 resize-none border-0 bg-transparent p-0 text-sm shadow-none focus-visible:ring-0" aria-label="@($"Ask {SelectedPersona.Name}...")" />
        </div>

        @* Footer *@
        <div class="flex items-center justify-between border-t px-4 py-3">
            <div class="flex items-center gap-1.5">
                <span class="flex size-5 items-center justify-center rounded bg-muted font-mono text-[9px] text-muted-foreground">
                    @SelectedPersona.Initials
                </span>
                <span class="text-muted-foreground text-xs">
                    Chatting with
                    <span class="font-medium text-foreground">@SelectedPersona.Name</span>
                </span>
            </div>
            <ButtonCn Type="submit"
                      Size="ButtonSize.Sm"
                      Variant="ButtonVariant.Default"
                      Disabled="@(string.IsNullOrWhiteSpace(_input))"
                      Class="h-7 gap-1.5 text-xs">
                <LucideArrowUpCn Size="14" Class="size-3.5" />
                Send
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record Persona(string Id, string Name, string Initials, string Description, string[] Traits, RenderFragment IconFragment);

    private Persona[] _personas = null!;

    private static readonly string[] _scholarTraits = { "Thorough", "Cited", "Analytical", "Objective" };
    private static readonly string[] _creativeTraits = { "Expressive", "Playful", "Original", "Vivid" };
    private static readonly string[] _conciseTraits = { "Brief", "Direct", "Focused", "Efficient" };
    private static readonly string[] _technicalTraits = { "Typed", "Precise", "Practical", "Testable" };

    protected override void OnInitialized()
    {
        _personas = new Persona[]
        {
            new("scholar", "Scholar", "SC", "Deep, well-researched answers with citations and nuanced analysis", _scholarTraits,
                @<LucideBookOpenCn Size="14" Class="size-3.5 text-muted-foreground" />),
            new("creative", "Creative", "CR", "Imaginative responses with metaphors, stories, and fresh perspectives", _creativeTraits,
                @<LucideSparklesCn Size="14" Class="size-3.5 text-muted-foreground" />),
            new("concise", "Concise", "CN", "Brief, direct answers that get straight to the point without filler", _conciseTraits,
                @<LucideZapCn Size="14" Class="size-3.5 text-muted-foreground" />),
            new("technical", "Technical", "TC", "Precise code-focused answers with examples, types, and best practices", _technicalTraits,
                @<LucideTerminalCn Size="14" Class="size-3.5 text-muted-foreground" />)
        };
        _selectedPersonaId = _personas[0].Id;
    }

    private string _selectedPersonaId = "scholar";
    private string _input = "";

    private Persona SelectedPersona => _personas?.FirstOrDefault(p => p.Id == _selectedPersonaId) ?? _personas?[0]!;
}
