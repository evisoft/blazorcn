@* ===========================================================
   Block: ai-document-qa
   Title: Ai Document Qa
   Description: AI document question-and-answer with uploaded document card, chat-style Q&A, page references, and source citations
   Dependencies: BadgeCn, ButtonCn, InputCn, LucideChevronRightCn, LucideSendCn
   Source: original/blocks/ai/ai-document-qa.tsx
   =========================================================== *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="overflow-hidden rounded-lg border bg-card">
        @* Document info *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="min-w-0 flex-1">
                <span class="text-sm font-medium">@_docInfo.Name</span>
                <p class="mt-0.5 text-xs text-muted-foreground">
                    @_docInfo.Size &middot; @_docInfo.Pages pages &middot; Uploaded @_docInfo.UploadedAt
                </p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="shrink-0 gap-1.5 text-xs font-normal">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Indexed
            </BadgeCn>
        </div>

        @* Q&A thread *@
        <div>
            @for (var i = 0; i < _messages.Length; i++)
            {
                var msg = _messages[i];
                var isLast = i == _messages.Length - 1;

                if (msg.Role == "user")
                {
                    <div class="border-b bg-muted/30 px-4 py-3">
                        <p class="text-sm">@msg.Content</p>
                    </div>
                }
                else
                {
                    var isExpanded = _expanded == msg.Id;
                    var msgId = msg.Id;
                    <div class="@(!isLast ? "border-b" : "")">
                        <button type="button"
                                class="flex w-full items-center gap-3 px-4 py-3 text-left transition-colors hover:bg-muted/50"
                                @onclick="@(() => _expanded = isExpanded ? null : msgId)">
                            <span class="size-2 shrink-0 rounded-full bg-blue-500"></span>
                            <div class="min-w-0 flex-1">
                                <span class="text-sm font-medium">Answer</span>
                                @if (msg.Pages != null)
                                {
                                    <span class="ml-2 text-xs text-muted-foreground">
                                        p. @string.Join(", ", msg.Pages)
                                    </span>
                                }
                            </div>
                            <LucideChevronRightCn Size="16" Class="@Cn.Merge("size-4 shrink-0 text-muted-foreground/60 transition-transform duration-200", isExpanded ? "rotate-90" : "")" />
                        </button>

                        @if (isExpanded)
                        {
                            <div class="px-4 pb-4 pl-9">
                                <p class="text-sm leading-relaxed text-muted-foreground">@msg.Content</p>
                                @if (msg.Pages != null)
                                {
                                    <div class="mt-3 flex items-center gap-1.5">
                                        <span class="text-xs text-muted-foreground">Sources:</span>
                                        @foreach (var page in msg.Pages)
                                        {
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="cursor-pointer font-mono text-xs hover:bg-muted">
                                                p. @(page)
                                            </BadgeCn>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            }
        </div>

        @* Input *@
        <div class="flex items-center gap-2 border-t px-4 py-3">
            <InputCn @bind-Value="_input"
                     Placeholder="Ask a question about the document..."
                     Class="h-8 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0" />
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 shrink-0 px-2"
                      Disabled="@(string.IsNullOrWhiteSpace(_input))">
                <LucideSendCn Size="16" Class="size-3.5" />
            </ButtonCn>
        </div>
    </div>
</section>

@code {
    private record DocumentInfo(string Name, string Size, int Pages, string UploadedAt);
    private record QAMessage(string Id, string Role, string Content, int[]? Pages = null);

    private static readonly DocumentInfo _docInfo = new("Q3-2025-Financial-Report.pdf", "4.2 MB", 48, "Mar 14, 2026");

    private static readonly QAMessage[] _messages =
    {
        new("1", "user", "What was the total revenue for Q3 2025?"),
        new("2", "assistant",
            "Total revenue for Q3 2025 was $12.4 billion, representing a 14% year-over-year increase from Q3 2024's $10.9 billion. The growth was primarily driven by the cloud services division, which saw a 28% increase, and the enterprise software segment, which grew 11%. The company also reported a gross margin improvement to 68.2%, up from 65.7% in the prior year quarter.",
            new[] { 4, 7, 12 }),
        new("3", "user", "Which business segment had the highest growth?"),
        new("4", "assistant",
            "The Cloud Services segment had the highest growth at 28% year-over-year, generating $4.8 billion in revenue. Key drivers included Infrastructure-as-a-Service (IaaS) at 35% growth from enterprise cloud migrations, Platform-as-a-Service (PaaS) at 24% growth driven by developer tooling adoption, and AI Cloud Services launched in Q2 already contributing $340 million. The next highest growth segment was Data Analytics at 19%.",
            new[] { 7, 8, 15 })
    };

    private string _input = "";
    private string? _expanded = "2";
}
