@* ============================================================
   Block: chat-legal-assistant
   Title: ChatLegalAssistant
   Description: React legal document review chat block for Next.js with clause analysis cards, risk severity indicators, contract summary, and amendment suggestions using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-legal-assistant.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8">
                <AvatarFallbackCn Class="bg-muted text-xs">
                    <LucideIconCn Name="scale" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Legal Assistant</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        Contract Review
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">
                    Document analysis and risk assessment
                </span>
            </div>
        </div>

        @* Disclaimer *@
        <div class="flex items-center gap-2 border-b bg-muted/30 px-4 py-2">
            <LucideIconCn Name="shield-check" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
            <p class="text-muted-foreground text-xs">
                AI-assisted review. Not a substitute for licensed legal counsel.
            </p>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-4">
                @foreach (var m in _messages)
                {
                    var msg = m;
                    var isUser = msg.Role == "user";
                    <div class="@Cn.Merge("flex", isUser ? "justify-end" : "justify-start")">
                        <div class="@Cn.Merge("max-w-[85%]", isUser ? "rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground" : "rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">
                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }
                            @if (msg.Clauses != null)
                            {
                                var clauses = msg.Clauses;
                                @* Clause card *@
                                <div class="mt-2 rounded-md border bg-card">
                                    @for (int ci = 0; ci < clauses.Length; ci++)
                                    {
                                        var clause = clauses[ci];
                                        var isLast = ci == clauses.Length - 1;
                                        var clauseSection = clause.Section;
                                        var isExpanded = _expandedClause == clauseSection;
                                        <div class="@(isLast ? "" : "border-b")">
                                            <button type="button"
                                                    @onclick="@(() => ToggleClause(clauseSection))"
                                                    class="flex w-full items-center gap-3 px-3 py-2.5 text-left transition-colors hover:bg-muted/50">
                                                <span class="@Cn.Merge("size-2 shrink-0 rounded-full", _riskDot[clause.Risk])"></span>
                                                <div class="min-w-0 flex-1">
                                                    <span class="font-medium text-sm">@clause.Title</span>
                                                    <p class="mt-0.5 font-mono text-muted-foreground text-xs">@clause.Section</p>
                                                </div>
                                                <span class="shrink-0 text-muted-foreground text-xs">
                                                    @_riskLabel[clause.Risk]
                                                </span>
                                            </button>
                                            @if (isExpanded)
                                            {
                                                <div class="px-3 pb-3 pl-8">
                                                    <p class="mb-2 text-muted-foreground text-sm leading-relaxed">
                                                        @clause.Explanation
                                                    </p>
                                                    @if (!string.IsNullOrEmpty(clause.Amendment))
                                                    {
                                                        var sec = clause.Section;
                                                        var amendment = clause.Amendment;
                                                        <div class="rounded-md bg-muted/50 p-3">
                                                            <div class="mb-1.5 flex items-center justify-between">
                                                                <span class="font-medium text-muted-foreground text-xs">
                                                                    Suggested amendment
                                                                </span>
                                                                <ButtonCn Variant="ButtonVariant.Ghost"
                                                                          Size="ButtonSize.Sm"
                                                                          Class="h-6 gap-1 px-2 text-xs"
                                                                          OnClick="@(() => CopyAmendment(sec, amendment))">
                                                                    @if (_copiedSection == sec)
                                                                    {
                                                                        <LucideIconCn Name="check" Size="12" Class="size-3" />
                                                                        <span>Copied</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                                                        <span>Copy</span>
                                                                    }
                                                                </ButtonCn>
                                                            </div>
                                                            <p class="text-sm leading-relaxed">@amendment</p>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            @if (msg.Summary != null)
                            {
                                var summary = msg.Summary;
                                @* Summary card *@
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2.5 flex items-center gap-1.5">
                                        <LucideIconCn Name="file-text" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="font-medium text-sm">@summary.Title</span>
                                    </div>
                                    <div class="space-y-2">
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Parties</span>
                                            <span class="text-right text-sm">@string.Join(" & ", summary.Parties)</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Effective date</span>
                                            <span class="text-sm">@summary.EffectiveDate</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Term</span>
                                            <span class="text-sm">@summary.TermLength</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Governing law</span>
                                            <span class="text-sm">@summary.GoverningLaw</span>
                                        </div>
                                        <div class="flex items-center justify-between border-t pt-2">
                                            <span class="text-muted-foreground text-xs">Annual value</span>
                                            <span class="font-semibold text-sm tabular-nums">@summary.TotalValue</span>
                                        </div>
                                    </div>
                                </div>
                            }
                            <span class="@Cn.Merge("mt-1 block text-right text-xs", isUser ? "text-primary-foreground/60" : "text-muted-foreground")">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form class="relative" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <TextareaCn @bind-Value="_input"
                            Placeholder="Ask about clauses, risks, or amendments..."
                            Rows="1"
                            Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record ClauseAnalysis(string Title, string Section, string Risk, string Explanation, string? Amendment);
    private record ContractSummary(string Title, string[] Parties, string EffectiveDate, string TermLength, string GoverningLaw, string TotalValue);
    private record Message(string Id, string Role, string Content, string Timestamp, ClauseAnalysis[]? Clauses, ContractSummary? Summary);

    private string _input = "";
    private string? _expandedClause = "Section 9.2";
    private string? _copiedSection = null;

    private static readonly Dictionary<string, string> _riskDot = new()
    {
        ["high"] = "bg-red-500",
        ["medium"] = "bg-amber-500",
        ["low"] = "bg-emerald-500",
    };

    private static readonly Dictionary<string, string> _riskLabel = new()
    {
        ["high"] = "High risk",
        ["medium"] = "Medium risk",
        ["low"] = "Low risk",
    };

    private static readonly Message[] _messages =
    [
        new("1", "user",
            "I just received a SaaS vendor agreement from Acme Corp. Can you review the key clauses and flag any risks?",
            "10:15 AM", null, null),
        new("2", "assistant",
            "I've analyzed the Acme Corp SaaS Agreement. I found 4 clauses that need your attention, sorted by risk level:",
            "10:16 AM", null, null),
        new("3", "assistant", "", "10:16 AM",
            [
                new ClauseAnalysis(
                    "Unlimited Liability Clause",
                    "Section 9.2",
                    "high",
                    "The agreement contains no cap on your liability for data breaches. Industry standard is to cap liability at 12 months of fees paid. This exposes you to potentially unlimited financial risk.",
                    "Neither party's aggregate liability shall exceed the total fees paid in the 12-month period preceding the claim, except for willful misconduct or gross negligence."),
                new ClauseAnalysis(
                    "Auto-Renewal with 90-Day Notice",
                    "Section 3.4",
                    "high",
                    "The contract auto-renews for successive 2-year terms with a 90-day cancellation notice window. Missing the notice deadline locks you in for another 2 years at the then-current rate, which may include price increases.",
                    "This Agreement shall auto-renew for successive 1-year terms. Either party may terminate by providing 30 days' written notice prior to the renewal date."),
                new ClauseAnalysis(
                    "Broad IP Assignment Clause",
                    "Section 7.1",
                    "medium",
                    "The clause assigns ownership of any custom integrations or configurations you build on their platform to Acme Corp. This includes API connectors and workflow automations your team develops.",
                    null),
                new ClauseAnalysis(
                    "Data Retention on Termination",
                    "Section 12.3",
                    "low",
                    "Acme will retain your data for 30 days post-termination and provide export in CSV format. This is reasonable, though you may want to negotiate for a longer retention period and additional export formats like JSON.",
                    null),
            ],
            null),
        new("4", "user",
            "The liability clause is concerning. Can you also give me a quick summary of the overall contract terms?",
            "10:18 AM", null, null),
        new("5", "assistant",
            "Absolutely. Here are the key terms at a glance:",
            "10:19 AM", null, null),
        new("6", "assistant", "", "10:19 AM", null,
            new ContractSummary(
                "Acme Corp SaaS Agreement",
                ["Your Company, Inc.", "Acme Corp"],
                "Apr 1, 2026",
                "2 years (auto-renewing)",
                "State of Delaware",
                "$148,000 / year")),
        new("7", "assistant",
            "I recommend pushing back on the liability cap and auto-renewal terms before signing. The amendment language I provided above for Section 9.2 and Section 3.4 follows market-standard SaaS terms. Want me to draft a full redline document?",
            "10:20 AM", null, null),
    ];

    private void ToggleClause(string section)
    {
        _expandedClause = _expandedClause == section ? null : section;
    }

    private void CopyAmendment(string section, string text)
    {
        _copiedSection = section;
        // In a real app: await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
