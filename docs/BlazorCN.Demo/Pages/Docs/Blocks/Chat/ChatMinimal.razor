@* ============================================================
   Block: chat-minimal
   Title: ChatMinimal
   Description: React ultra-minimal anonymous chat interface for Next.js with no header, no avatars, floating messages, and a single-line input using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-minimal.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* No header -- the point is absolute minimum *@

        @* Messages *@
        <div class="flex flex-1 flex-col justify-end overflow-y-auto px-4 py-2" tabindex="0" role="group" aria-label="Messages">
            <div class="flex flex-col gap-1">
                @foreach (var m in _messages)
                {
                    var msg = m;
                    var isMe = msg.Sender == "me";
                    <div class="@Cn.Merge("group flex gap-2 px-2", isMe ? "flex-row-reverse" : "flex-row")">
                        <div class="flex w-10 shrink-0 items-center justify-center">
                            <span class="invisible text-right text-[10px] text-muted-foreground group-hover:visible">
                                @msg.Timestamp
                            </span>
                        </div>
                        <div class="@Cn.Merge("flex max-w-[70%] flex-col", isMe ? "items-end" : "items-start")">
                            <div class="text-sm">@msg.Content</div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Ultra-minimal toolbar *@
        <div class="sticky bottom-0 bg-card p-2 pt-0">
            <div class="flex flex-wrap items-start gap-x-2 rounded-md border px-3 py-2">
                <div class="order-2 grid min-w-0 flex-1">
                    <input value="@_input"
                           @oninput="@((e) => _input = e.Value?.ToString() ?? "")"
                           placeholder="Say something..."
                           class="h-10 min-h-10 resize-none border-none bg-transparent px-1 text-sm shadow-none outline-none placeholder:text-muted-foreground" aria-label="Say something..." />
                </div>
                <div class="order-3 flex h-10 items-center gap-1.5">
                    <button type="button"
                            disabled="@(string.IsNullOrWhiteSpace(_input) ? "disabled" : null)"
                            @onclick="HandleSubmit"
                            class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full transition-all", _input.Trim().Length > 0 ? "bg-foreground text-background" : "bg-muted text-muted-foreground/40")" aria-label="Send message">
                        <LucideIconCn Name="arrow-up" Size="14" Class="size-3.5" />
                    </button>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record Message(string Id, string Content, string Sender, string Timestamp);

    private static readonly Message[] _messages =
    [
        new("1", "Are you free to review the PR this afternoon?",                                                         "them", "2:14 PM"),
        new("2", "Sure, which repo?",                                                                                     "me",   "2:15 PM"),
        new("3", "The auth service. I refactored the session middleware and added rate limiting.",                         "them", "2:16 PM"),
        new("4", "Nice. Did you update the integration tests too?",                                                       "me",   "2:17 PM"),
        new("5", "Yeah, full coverage on the new endpoints. Also added a stress test for the rate limiter.",              "them", "2:18 PM"),
        new("6", "That sounds solid. I'll start on it after standup.",                                                    "me",   "2:20 PM"),
        new("7", "Perfect. Let me know if the Redis config looks off, I changed some TTL values.",                        "them", "2:21 PM"),
        new("8", "Will do.",                                                                                              "me",   "2:22 PM"),
    ];

    private string _input = "";

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
