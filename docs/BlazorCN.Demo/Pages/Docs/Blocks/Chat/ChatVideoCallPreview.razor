@* ============================================================
   Block: chat-video-call-preview
   Title: ChatVideoCallPreview
   Description: React chat block with video call integration for Next.js featuring call status messages, participant avatars, join and leave buttons, and duration display using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-video-call-preview.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="text-xs">SC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Sarah Chen</span>
                <span class="ml-2 text-muted-foreground text-xs">Engineering</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 text-muted-foreground hover:text-foreground">
                <LucideIconCn Name="video" Size="16" Class="size-4" />
            </ButtonCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto py-2">
            @foreach (var msg in _messages)
            {
                var msgItem = msg;
                @if (msgItem.Role == "system" && msgItem.Call != null)
                {
                    var call = msgItem.Call;
                    var isOngoing = call.Status == "ongoing";
                    <div class="mx-auto my-2 max-w-sm px-2">
                        <div class="rounded-md border p-3">
                            <div class="mb-2.5 flex items-center gap-2">
                                @if (isOngoing)
                                {
                                    <LucideIconCn Name="video" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                                }
                                else
                                {
                                    <LucideIconCn Name="phone-off" Size="16" Class="size-4 text-muted-foreground" />
                                }
                                <div class="min-w-0 flex-1">
                                    <span class="font-medium text-sm">
                                        @(isOngoing ? "Video call in progress" : "Video call ended")
                                    </span>
                                    <div class="flex items-center gap-1.5">
                                        @if (isOngoing)
                                        {
                                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                        }
                                        <span class="text-muted-foreground text-xs">
                                            @(isOngoing ? $"Started at {msgItem.Time}" : $"Duration: {call.Duration}")
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3 flex items-center gap-1.5">
                                <div class="flex -space-x-1.5">
                                    @foreach (var p in call.Participants)
                                    {
                                        <AvatarCn Class="size-6 border-2 border-card">
                                            <AvatarFallbackCn Class="text-[9px]">@p.Initials</AvatarFallbackCn>
                                        </AvatarCn>
                                    }
                                </div>
                                <span class="ml-1 text-muted-foreground text-xs">
                                    @call.Participants.Length @(call.Participants.Length == 1 ? "participant" : "participants")
                                </span>
                            </div>

                            @if (isOngoing)
                            {
                                <div class="flex gap-2">
                                    <ButtonCn Size="ButtonSize.Sm" Class="h-7 flex-1 gap-1.5 bg-emerald-600 text-xs text-white hover:bg-emerald-700">
                                        <LucideIconCn Name="phone" Size="12" Class="size-3" />
                                        Join call
                                    </ButtonCn>
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 flex-1 gap-1.5 text-xs">
                                        <LucideIconCn Name="phone-off" Size="12" Class="size-3" />
                                        Decline
                                    </ButtonCn>
                                </div>
                            }
                            else
                            {
                                <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 w-full gap-1.5 text-xs">
                                    <LucideIconCn Name="video" Size="12" Class="size-3" />
                                    Call again
                                </ButtonCn>
                            }
                        </div>
                    </div>
                }
                else
                {
                    var showHeader = IsFirstInGroup(_messages, _messages.IndexOf(msgItem));
                    <div class="flex gap-2 px-2 transition-colors hover:bg-accent">
                        <div class="w-10 shrink-0 pt-1">
                            @if (showHeader)
                            {
                                <AvatarCn Class="size-8">
                                    <AvatarFallbackCn Class="text-xs">@msgItem.Initials</AvatarFallbackCn>
                                </AvatarCn>
                            }
                        </div>
                        <div class="min-w-0 flex-1 py-1">
                            @if (showHeader)
                            {
                                <div class="mb-0.5 flex items-center gap-2">
                                    <span class="font-medium text-sm">@msgItem.Sender</span>
                                    <span class="text-muted-foreground text-xs">@msgItem.Time</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(msgItem.Content))
                            {
                                <p class="text-sm">@msgItem.Content</p>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative flex items-end gap-2">
                <ButtonCn Type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="video" Size="16" Class="size-4" />
                </ButtonCn>
                <div class="relative flex-1">
                    <TextareaCn @bind-Value="_input"
                                Placeholder="Type a message..."
                                Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-10 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                    <ButtonCn Type="submit"
                              Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost"
                              Disabled="@string.IsNullOrWhiteSpace(_input)"
                              OnClick="HandleSubmit"
                              Class="absolute top-1/2 right-0 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground">
                        <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record Participant(string Initials, string Name);

    private record CallEvent(string Status, string? Duration, Participant[] Participants);

    private record ChatMessage(string Id, string Role, string Sender, string Initials, string? Content, CallEvent? Call, string Time);

    private string _input = "";

    private static readonly List<ChatMessage> _messages =
    [
        new("1", "other",  "Sarah Chen", "SC", "Hey, are you free for a quick sync on the API design?", null,                                                                                                                                          "10:02 AM"),
        new("2", "user",   "You",        "YO", "Sure, let me hop on a call.",                            null,                                                                                                                                          "10:03 AM"),
        new("3", "system", "System",     "",   null,                                                     new("ended", "12:34", [new("YO","You"), new("SC","Sarah Chen")]),                                                                              "10:03 AM"),
        new("4", "other",  "Sarah Chen", "SC", "That was productive. I'll update the OpenAPI spec with the changes we discussed.", null,                                                                                                                "10:16 AM"),
        new("5", "user",   "You",        "YO", "Sounds good. Let me pull in Marcus for the database schema review.",               null,                                                                                                                "10:18 AM"),
        new("6", "system", "System",     "",   null,                                                     new("ongoing", null, [new("YO","You"), new("SC","Sarah Chen"), new("MW","Marcus Wright")]),                                                    "10:20 AM"),
        new("7", "other",  "Sarah Chen", "SC", "Marcus just joined. We can start the schema walkthrough.", null,                                                                                                                                        "10:21 AM"),
    ];

    private static bool IsFirstInGroup(List<ChatMessage> msgs, int index)
    {
        if (index <= 0) return true;
        var prev = msgs[index - 1];
        var curr = msgs[index];
        return prev.Sender != curr.Sender || prev.Role != curr.Role;
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
