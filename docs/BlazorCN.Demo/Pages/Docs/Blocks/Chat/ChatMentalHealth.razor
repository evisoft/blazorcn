@* ============================================================
   Block: chat-mental-health
   Title: ChatMentalHealth
   Description: A mental wellness chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring mood check-ins, guided breathing exercises, and curated resource links
   Source: original/blocks/chat/chat-mental-health.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-pink-500/10">
                <LucideIconCn Name="heart" Size="16" Class="size-4 text-pink-600" />
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-medium">Wellness Support</h3>
                <p class="text-xs text-muted-foreground">Private &amp; confidential</p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="phone" Size="12" Class="size-3" />
                Crisis Line
            </ButtonCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto p-4">
            @foreach (var message in _messages)
            {
                var msg = message;
                <div class="@Cn.Merge("mb-4 flex gap-3", msg.Sender == "user" ? "flex-row-reverse" : "")">
                    <AvatarCn Class="size-8 shrink-0">
                        <AvatarFallbackCn Class="@Cn.Merge(msg.Sender == "ai" ? "bg-pink-500/10 text-pink-600" : "bg-muted")">
                            @(msg.Sender == "ai" ? "AI" : "ME")
                        </AvatarFallbackCn>
                    </AvatarCn>

                    <div class="@Cn.Merge("flex-1 space-y-2", msg.Sender == "user" ? "flex flex-col items-end" : "")">
                        <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2", msg.Sender == "ai" ? "bg-muted" : "bg-pink-500/10 text-pink-900 dark:text-pink-100")">
                            <p class="text-sm">@msg.Content</p>
                        </div>

                        @* Mood Check *@
                        @if (msg.MoodCheck != null)
                        {
                            <div class="mt-2 w-full max-w-sm rounded-lg border bg-card p-3">
                                <p class="mb-3 text-xs font-medium text-muted-foreground">
                                    How are you feeling?
                                </p>
                                <div class="flex justify-between gap-2">
                                    @foreach (var mood in msg.MoodCheck)
                                    {
                                        var m = mood;
                                        <button type="button"
                                                @onclick="@(() => HandleMoodSelect(m))"
                                                class="flex flex-col items-center gap-1 rounded-md p-2 transition-colors hover:bg-muted/50">
                                            <span class="text-2xl">@m.Emoji</span>
                                            <span class="text-xs text-muted-foreground">@m.Label</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        @* Breathing Exercise *@
                        @if (msg.Breathing != null)
                        {
                            var breathing = msg.Breathing;
                            <div class="mt-2 w-full max-w-sm overflow-hidden rounded-lg border bg-card">
                                <div class="border-b bg-muted/50 px-3 py-2">
                                    <div class="flex items-center gap-2">
                                        <LucideIconCn Name="wind" Size="16" Class="size-4 text-blue-500" />
                                        <h4 class="font-medium text-sm">@breathing.Name</h4>
                                    </div>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@breathing.Duration</p>
                                </div>
                                <div class="p-3">
                                    <ul class="mb-3 space-y-1.5">
                                        @for (var idx = 0; idx < breathing.Steps.Length; idx++)
                                        {
                                            var step = breathing.Steps[idx];
                                            var num = idx + 1;
                                            <li class="flex items-start gap-2 text-xs">
                                                <BadgeCn Variant="BadgeVariant.Outline" Class="mt-0.5 h-4 w-4 items-center justify-center p-0 text-xs">
                                                    @num
                                                </BadgeCn>
                                                <span class="text-muted-foreground">@step</span>
                                            </li>
                                        }
                                    </ul>
                                    <div class="space-y-2">
                                        <ProgressCn Value="@_breathProgress" Class="h-1.5" />
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 w-full gap-1 text-xs"
                                                  OnClick="@(() => _isBreathing = !_isBreathing)">
                                            @if (_isBreathing)
                                            {
                                                <LucideIconCn Name="pause" Size="12" Class="size-3" />
                                                @("Pause")
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="play" Size="12" Class="size-3" />
                                                @("Start Exercise")
                                            }
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        }

                        @* Resources *@
                        @if (msg.Resources != null)
                        {
                            <div class="mt-2 w-full max-w-sm space-y-2">
                                @foreach (var resource in msg.Resources)
                                {
                                    <a href="@resource.Link"
                                       class="flex items-start gap-2 rounded-lg border bg-card p-3 transition-colors hover:bg-muted/50">
                                        <div class="flex-1">
                                            <div class="flex items-center gap-2">
                                                <h5 class="font-medium text-sm">@resource.Title</h5>
                                                <LucideIconCn Name="external-link" Size="12" Class="size-3 text-muted-foreground" />
                                            </div>
                                            <p class="mt-0.5 text-xs text-muted-foreground">@resource.Description</p>
                                        </div>
                                    </a>
                                }
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@msg.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form class="flex gap-2" @onsubmit="HandleSend" @onsubmit:preventDefault="true">
                <InputCn @bind-Value="_input"
                         Placeholder="Share what's on your mind..."
                         Class="flex-1" />
                <ButtonCn type="submit" Size="ButtonSize.Sm" Class="shrink-0">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
            <p class="mt-2 text-xs text-muted-foreground">
                Your conversations are private. Crisis support: 988
            </p>
        </div>
    </div>
</section>

@code {
    private record MoodOption(string Emoji, string Label, int Value);
    private record BreathingExercise(string Name, string Duration, string[] Steps);
    private record Resource(string Title, string Description, string Link);
    private record Message(string Id, string Sender, string Content, string Timestamp,
        MoodOption[]? MoodCheck = null, BreathingExercise? Breathing = null, Resource[]? Resources = null);

    private string _input = "";
    private bool _isBreathing = false;
    private int _breathProgress = 0;

    private static readonly MoodOption[] _moodOptions =
    [
        new("😊", "Great", 5),
        new("🙂", "Good", 4),
        new("😐", "Okay", 3),
        new("😔", "Low", 2),
        new("😢", "Struggling", 1),
    ];

    private List<Message> _messages =
    [
        new("1", "ai",
            "Hello, I'm here to support you. How are you feeling today? Let's start with a quick mood check-in.",
            "9:00 AM",
            MoodCheck: _moodOptions),
        new("2", "user",
            "I'm feeling a bit anxious about work deadlines",
            "9:02 AM"),
        new("3", "ai",
            "I hear you. Work stress can feel overwhelming. Would you like to try a quick breathing exercise to help calm your mind?",
            "9:02 AM",
            Breathing: new("4-7-8 Breathing", "5 minutes", [
                "Inhale quietly through your nose for 4 seconds",
                "Hold your breath for 7 seconds",
                "Exhale completely through your mouth for 8 seconds",
                "Repeat the cycle 4 times",
            ])),
        new("4", "user",
            "That helped a bit. Thanks.",
            "9:10 AM"),
        new("5", "ai",
            "I'm glad it helped. Remember, it's okay to take breaks. Here are some resources that might support you:",
            "9:11 AM",
            Resources:
            [
                new("National Crisis Hotline", "24/7 confidential support - Call 988", "tel:988"),
                new("Anxiety Management Guide", "Evidence-based techniques for managing stress", "#"),
            ]),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new($"msg-{_messages.Count}", "user", _input, "Just now"));
        _input = "";
    }

    private void HandleMoodSelect(MoodOption mood)
    {
        _messages.Add(new($"msg-{_messages.Count}", "user",
            $"I'm feeling {mood.Label.ToLower()} {mood.Emoji}", "Just now"));
    }
}
