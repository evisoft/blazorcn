@* ============================================================
   Block: chat-quick-replies
   Title: ChatQuickReplies
   Description: React chat interface with quick reply suggestion chips for Next.js featuring tappable pill buttons that send predefined responses and update the conversation using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-quick-replies.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8">
                <AvatarFallbackCn Class="text-xs">SC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Sam Chen</span>
                <p class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Online
                </p>
            </div>
        </div>

        @* Messages — flat layout with sender grouping *@
        <div class="flex-1 overflow-y-auto py-2">
            @for (int i = 0; i < _messages.Count; i++)
            {
                var msg = _messages[i];
                var msgId = msg.Id;
                var prevMsg = i > 0 ? _messages[i - 1] : null;
                var isFirstInGroup = prevMsg == null || prevMsg.SenderId != msg.SenderId;

                @if (isFirstInGroup)
                {
                    <div class="flex gap-2 px-2 hover:bg-accent">
                        <div class="flex w-10 shrink-0 justify-center pt-1">
                            <AvatarCn Class="size-8 rounded-full">
                                <AvatarFallbackCn Class="text-xs">@msg.SenderInitials</AvatarFallbackCn>
                            </AvatarCn>
                        </div>
                        <div class="flex flex-1 flex-col">
                            <div class="flex items-center gap-2 text-sm">
                                <span class="font-medium">@msg.SenderName</span>
                                <span class="text-xs text-muted-foreground">@msg.Timestamp</span>
                            </div>
                            <div class="text-sm">@msg.Content</div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="group flex gap-2 px-2 hover:bg-accent">
                        <div class="flex w-10 shrink-0 justify-center pt-1">
                            <span class="invisible text-right text-[10px] text-muted-foreground group-hover:visible">
                                @msg.Timestamp
                            </span>
                        </div>
                        <div class="flex flex-1 flex-col">
                            <div class="text-sm">@msg.Content</div>
                        </div>
                    </div>
                }
            }
        </div>

        @* Suggestion chips — between messages and toolbar *@
        @if (_showSuggestions)
        {
            <div class="flex flex-wrap gap-2 border-t px-4 py-2">
                @foreach (var chip in _currentSuggestions)
                {
                    var chipLabel = chip.Label;
                    <button type="button"
                            @onclick="@(() => SendMessage(chipLabel))"
                            class="flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-xs text-foreground transition-colors hover:bg-accent">
                        <LucideIconCn Name="@chip.IconName" Size="12" Class="size-3 text-muted-foreground" />
                        @chip.Label
                    </button>
                }
            </div>
        }

        @* Toolbar — sticky bottom, bordered rounded container *@
        <div class="sticky bottom-0 bg-card p-2 pt-0">
            <form @onsubmit="HandleSubmit" class="flex flex-wrap items-start gap-x-2 rounded-md border px-3 py-2">
                <div class="order-2 grid min-w-0 flex-1">
                    <textarea @bind="_input" @bind:event="oninput"
                              placeholder="Type a message..."
                              class="h-fit min-h-10 resize-none border-none bg-transparent px-1 text-sm shadow-none outline-none placeholder:text-muted-foreground"
                              rows="1"></textarea>
                </div>
                <div class="order-3 flex h-10 items-center gap-1.5">
                    <button type="submit"
                            disabled="@(string.IsNullOrWhiteSpace(_input))"
                            class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full transition-all", !string.IsNullOrWhiteSpace(_input) ? "bg-foreground text-background" : "bg-muted text-muted-foreground/40")">
                        <LucideIconCn Name="arrow-up" Size="14" Class="size-3.5" />
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private record Sender(string Id, string Name, string Initials);

    private record Message(string Id, string SenderId, string SenderName, string SenderInitials, string Content, string Timestamp);

    private record SuggestionChip(string Label, string IconName);

    private static readonly Sender _sam = new("sam", "Sam Chen", "SC");
    private static readonly Sender _me = new("me", "You", "YO");

    private static readonly SuggestionChip[][] _suggestionSets =
    [
        [
            new("Enable for internal testers only", "sparkles"),
            new("Keep them off until QA approves", "thumbs-up"),
            new("Let's discuss in standup", "calendar"),
            new("Enable all flags", "sparkles"),
        ],
        [
            new("Sounds good", "thumbs-up"),
            new("Let me check and get back", "message-square"),
            new("Can you send the config?", "sparkles"),
        ],
        [
            new("Thanks, that's all", "thumbs-up"),
            new("One more question", "message-square"),
            new("Let's sync later today", "calendar"),
        ],
    ];

    private List<Message> _messages =
    [
        new("m1", "sam", "Sam Chen", "SC", "Hi! I'm setting up the new staging environment. Which region should I deploy to?", "11:30 AM"),
        new("m2", "me", "You", "YO", "US East is usually the best for staging since most of our test users are there.", "11:31 AM"),
        new("m3", "sam", "Sam Chen", "SC", "Got it. Should I use the same database tier as production or a smaller one?", "11:32 AM"),
        new("m4", "me", "You", "YO", "Go with the smaller tier. We don't need production scale for staging.", "11:33 AM"),
        new("m5", "sam", "Sam Chen", "SC", "Makes sense. One more thing — should I enable the feature flags from the sprint, or keep them off until QA signs off?", "11:34 AM"),
    ];

    private int _suggestionIndex = 0;
    private string _input = "";

    private SuggestionChip[] _currentSuggestions =>
        _suggestionIndex < _suggestionSets.Length ? _suggestionSets[_suggestionIndex] : [];

    private bool _showSuggestions =>
        _messages.Count > 0 && _messages[^1].SenderId == "sam" && _currentSuggestions.Length > 0;

    private void SendMessage(string content)
    {
        var newMsg = new Message(
            $"m{_messages.Count + 1}",
            _me.Id,
            _me.Name,
            _me.Initials,
            content,
            "Now"
        );
        _messages = [.. _messages, newMsg];
        _suggestionIndex = Math.Min(_suggestionIndex + 1, _suggestionSets.Length);
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
        {
            SendMessage(_input);
            _input = "";
        }
    }
}
