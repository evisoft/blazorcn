@* ============================================================
   Block: chat-attachment-menu
   Title: ChatAttachmentMenu
   Description: React chat interface with attachment type selector for Next.js featuring a grid menu with photo, file, location, contact, poll, and audio options with placeholder previews using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-attachment-menu.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8">
                <AvatarFallbackCn Class="text-xs">RJ</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Riley Jordan</span>
                <p class="flex items-center gap-1.5 text-muted-foreground text-xs">
                    <span class="size-1.5 rounded-full bg-emerald-500"></span>
                    Online
                </p>
            </div>
        </div>

        @* Messages — flat layout with sender grouping *@
        <div class="flex-1 overflow-y-auto py-2">
            @for (var idx = 0; idx < _messages.Count; idx++)
            {
                var msg = _messages[idx];
                var prevMsg = idx > 0 ? _messages[idx - 1] : null;
                var isFirstInGroup = prevMsg == null || prevMsg.SenderId != msg.SenderId;
                var attachConfig = msg.AttachmentType != null ? GetAttachmentConfig(msg.AttachmentType) : null;

                if (isFirstInGroup)
                {
                    <div class="flex gap-2 px-2 hover:bg-accent">
                        <div class="flex w-10 shrink-0 justify-center pt-1">
                            <AvatarCn Class="size-8 rounded-full">
                                <AvatarFallbackCn Class="text-xs">@msg.SenderInitials</AvatarFallbackCn>
                            </AvatarCn>
                        </div>
                        <div class="flex flex-1 flex-col">
                            <div class="flex items-center gap-2 text-sm">
                                <span class="font-medium">@msg.SenderName</span>
                                <span class="text-xs text-muted-foreground">@msg.Timestamp</span>
                            </div>
                            <div class="text-sm">@msg.Content</div>
                            @if (attachConfig != null && msg.AttachmentLabel != null)
                            {
                                <div class="mt-1 flex items-center gap-2 rounded-md bg-muted/50 px-2 py-1.5">
                                    <LucideIconCn Name="@attachConfig.IconName" Size="14" Class="@Cn.Merge("size-3.5 shrink-0", attachConfig.Color)" />
                                    <span class="truncate text-xs">@msg.AttachmentLabel</span>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="group flex gap-2 px-2 hover:bg-accent">
                        <div class="flex w-10 shrink-0 justify-center pt-1">
                            <span class="invisible text-right text-[10px] text-muted-foreground group-hover:visible">
                                @msg.Timestamp
                            </span>
                        </div>
                        <div class="flex flex-1 flex-col">
                            <div class="text-sm">@msg.Content</div>
                            @if (attachConfig != null && msg.AttachmentLabel != null)
                            {
                                <div class="mt-1 flex items-center gap-2 rounded-md bg-muted/50 px-2 py-1.5">
                                    <LucideIconCn Name="@attachConfig.IconName" Size="14" Class="@Cn.Merge("size-3.5 shrink-0", attachConfig.Color)" />
                                    <span class="truncate text-xs">@msg.AttachmentLabel</span>
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        @* Attachment preview bar *@
        @if (_selectedAttachment != null)
        {
            var previewConfig = GetAttachmentConfig(_selectedAttachment);
            <div class="overflow-hidden border-t">
                <div class="flex items-center gap-2 px-4 py-2">
                    @if (previewConfig != null)
                    {
                        <div class="flex flex-1 items-center gap-2 rounded-md bg-muted/50 px-3 py-2">
                            <div class="@Cn.Merge("flex size-8 items-center justify-center rounded-md", previewConfig.BgColor, previewConfig.Color)">
                                <LucideIconCn Name="@previewConfig.IconName" Size="16" Class="size-4" />
                            </div>
                            <div class="min-w-0 flex-1">
                                <span class="font-medium text-xs">
                                    @(GetAttachmentPlaceholder(_selectedAttachment))
                                </span>
                                <p class="text-muted-foreground text-[10px] capitalize">
                                    @_selectedAttachment attachment
                                </p>
                            </div>
                        </div>
                    }
                    <ButtonCn Type="button"
                              Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="size-7 shrink-0 p-0 text-muted-foreground hover:text-foreground"
                              OnClick="HandleClearAttachment">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>
            </div>
        }

        @* Toolbar — sticky bottom, bordered rounded container *@
        <div class="sticky bottom-0 bg-card p-2 pt-0">
            <div class="flex flex-wrap items-start gap-x-2 rounded-md border px-3 py-2">
                <div class="order-1 flex h-10 items-center gap-1.5">
                    <PopoverCn Open="@_menuOpen" OpenChanged="@(v => _menuOpen = v)">
                        <PopoverTriggerCn Class="size-8 text-muted-foreground inline-flex items-center justify-center rounded-md hover:bg-accent hover:text-accent-foreground">
                            <LucideIconCn Name="plus" Size="16" Class="size-4" />
                        </PopoverTriggerCn>
                        <PopoverContentCn Side="FloatingSide.Top" Align="FloatingAlign.Start" Class="w-64 p-2">
                            <div class="grid grid-cols-3 gap-1">
                                @foreach (var at in _attachmentTypes)
                                {
                                    var attachType = at;
                                    <button type="button"
                                            @onclick="@(() => HandleSelectAttachment(attachType.Id))"
                                            class="flex flex-col items-center gap-1.5 rounded-md px-2 py-3 transition-colors hover:bg-muted/50">
                                        <div class="@Cn.Merge("flex size-10 items-center justify-center rounded-lg", attachType.BgColor, attachType.Color)">
                                            <LucideIconCn Name="@attachType.IconName" Size="20" Class="size-5" />
                                        </div>
                                        <span class="text-xs">@attachType.Label</span>
                                    </button>
                                }
                            </div>
                        </PopoverContentCn>
                    </PopoverCn>
                </div>
                <div class="order-2 grid min-w-0 flex-1">
                    <textarea @bind="_input"
                              @bind:event="oninput"
                              placeholder="Type a message..."
                              rows="1"
                              class="h-fit min-h-10 resize-none border-none bg-transparent px-1 text-sm shadow-none outline-none placeholder:text-muted-foreground"></textarea>
                </div>
                <div class="order-3 flex h-10 items-center gap-1.5">
                    <button type="button"
                            @onclick="HandleSubmit"
                            disabled="@(!CanSubmit)"
                            class="@Cn.Merge("flex size-7 shrink-0 items-center justify-center rounded-full transition-all", CanSubmit ? "bg-foreground text-background" : "bg-muted text-muted-foreground/40")">
                        <LucideIconCn Name="arrow-up" Size="14" Class="size-3.5" />
                    </button>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private record AttachmentTypeConfig(string Id, string Label, string IconName, string Color, string BgColor);

    private record ChatMessage(
        string Id,
        string SenderId,
        string SenderName,
        string SenderInitials,
        string Content,
        string Timestamp,
        string? AttachmentType = null,
        string? AttachmentLabel = null
    );

    private static readonly AttachmentTypeConfig[] _attachmentTypes =
    [
        new("photo",    "Photo",    "image",       "text-blue-500",    "bg-blue-500/10"),
        new("file",     "File",     "file",        "text-amber-500",   "bg-amber-500/10"),
        new("location", "Location", "map-pin",     "text-emerald-500", "bg-emerald-500/10"),
        new("contact",  "Contact",  "contact",     "text-purple-500",  "bg-purple-500/10"),
        new("poll",     "Poll",     "bar-chart-3", "text-rose-500",    "bg-rose-500/10"),
        new("audio",    "Audio",    "headphones",  "text-cyan-500",    "bg-cyan-500/10"),
    ];

    private List<ChatMessage> _messages =
    [
        new("m1", "riley", "Riley Jordan", "RJ", "Can you share the wireframes from yesterday's session?",       "4:15 PM"),
        new("m2", "me",    "You",          "YO", "Sure, here they are.",                                         "4:16 PM", "file",     "wireframes-v3.fig"),
        new("m3", "riley", "Riley Jordan", "RJ", "Thanks! The layout looks great. Where are we meeting for the review tomorrow?", "4:18 PM"),
        new("m4", "me",    "You",          "YO", "Conference room B on the 3rd floor. Here's the location.",    "4:19 PM", "location", "Acme HQ, Floor 3, Room B"),
        new("m5", "riley", "Riley Jordan", "RJ", "Perfect. Also, can you send me that comparison photo of the two color palettes?", "4:21 PM"),
    ];

    private string _input = "";
    private string? _selectedAttachment = null;
    private bool _menuOpen = false;

    private bool CanSubmit => !string.IsNullOrWhiteSpace(_input) || _selectedAttachment != null;

    private AttachmentTypeConfig? GetAttachmentConfig(string typeId) =>
        Array.Find(_attachmentTypes, a => a.Id == typeId);

    private static string GetAttachmentPlaceholder(string typeId) => typeId switch
    {
        "photo"    => "screenshot-2026-03-28.png",
        "file"     => "document.pdf",
        "location" => "Current location",
        "contact"  => "Alex Rivera — alex@@acme.com",
        "poll"     => "Quick poll: Which design?",
        "audio"    => "recording-01.m4a",
        _          => "Attachment",
    };

    private void HandleSelectAttachment(string typeId)
    {
        _selectedAttachment = typeId;
        _menuOpen = false;
    }

    private void HandleClearAttachment()
    {
        _selectedAttachment = null;
    }

    private void HandleSubmit()
    {
        if (!CanSubmit) return;
        var content = _input.Trim();
        if (string.IsNullOrEmpty(content) && _selectedAttachment != null)
            content = "Sent an attachment.";
        var newMsg = new ChatMessage(
            Id: $"m{_messages.Count + 1}",
            SenderId: "me",
            SenderName: "You",
            SenderInitials: "YO",
            Content: content,
            Timestamp: "Now",
            AttachmentType: _selectedAttachment,
            AttachmentLabel: _selectedAttachment != null ? GetAttachmentPlaceholder(_selectedAttachment) : null
        );
        _messages.Add(newMsg);
        _input = "";
        _selectedAttachment = null;
    }
}
