@* ============================================================
   Block: chat-ai-assistant
   Title: ChatAiAssistant
   Description: An AI assistant chat block for React and Next.js with streaming message bubbles, model selector, suggested prompts, and typing animation built with shadcn/ui and Tailwind CSS
   Source: original/blocks/chat/chat-ai-assistant.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <LucideIconCn Name="sparkles" Size="16" Class="size-4 text-muted-foreground" />
                <span class="font-medium text-sm">AI Assistant</span>
            </div>
            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                GPT-4o
                <LucideIconCn Name="chevron-down" Size="12" Class="size-3" />
            </ButtonCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4">
                @foreach (var msg in _messages)
                {
                    <div class="@Cn.Merge("flex gap-3", msg.Role == "user" ? "flex-row-reverse" : "")">
                        <AvatarCn Class="mt-0.5 size-7 shrink-0">
                            <AvatarFallbackCn Class="@Cn.Merge(msg.Role == "assistant" ? "bg-foreground text-background" : "bg-muted text-muted-foreground")">
                                @if (msg.Role == "assistant")
                                {
                                    <LucideIconCn Name="bot" Size="14" Class="size-3.5" />
                                }
                                else
                                {
                                    <LucideIconCn Name="user" Size="14" Class="size-3.5" />
                                }
                            </AvatarFallbackCn>
                        </AvatarCn>
                        <div class="@Cn.Merge("max-w-[80%] rounded-lg px-3 py-2 text-sm leading-relaxed", msg.Role == "user" ? "bg-foreground text-background" : "bg-muted/50")">
                            @msg.Content
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Suggested prompts *@
        <div class="border-t px-4 py-2">
            <div class="flex flex-wrap gap-1.5">
                @foreach (var p in _suggestedPrompts)
                {
                    var prompt = p;
                    <button type="button"
                            class="rounded-md border bg-muted/30 px-2.5 py-1 text-muted-foreground text-xs transition-colors hover:bg-muted/60 hover:text-foreground"
                            @onclick="@(() => _input = prompt)">
                        @p
                    </button>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form class="flex items-center gap-2" @onsubmit="HandleSubmit">
                <InputCn @bind-Value="_input"
                         Placeholder="Ask anything..."
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" aria-label="Ask anything..." />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-8 shrink-0 text-muted-foreground hover:text-foreground" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Role, string Content);

    private string _input = "";

    private static readonly string[] _suggestedPrompts =
    [
        "Explain RSC in Next.js",
        "How do I add auth?",
        "Compare Prisma vs Drizzle",
        "Write a cron job handler",
    ];

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "assistant",
            "Hi! I'm your AI development assistant. I can help with React, Next.js, databases, deployment, and more. What are you working on?"),
        new("m2", "user",
            "How do I set up server actions in Next.js 16?"),
        new("m3", "assistant",
            "Server actions in Next.js 16 are defined by adding \"use server\" at the top of an async function. You can define them inline within a server component or in a separate file. They run on the server and can be called from client components via form actions or direct invocation. The framework handles serialization and network transport automatically."),
        new("m4", "user",
            "Can I use them with form validation?"),
        new("m5", "assistant",
            "Yes. Pair server actions with Zod for schema validation. Define your schema, then validate the FormData inside the action. Return validation errors as a typed response that the client component can display inline. This gives you end-to-end type safety from form to database."),
    ];

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
