@* ============================================================
   Block: chat-quiz-game
   Title: ChatQuizGame
   Description: A gamified quiz assistant built with React, Next.js, shadcn/ui, and Tailwind CSS featuring question cards, multiple choice answers, score tracking, and progress indicators
   Source: original/blocks/chat/chat-quiz-game.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-md bg-muted">
                    <LucideIconCn Name="trophy" Size="16" Class="size-4 text-foreground" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">React Quiz Challenge</h2>
                    <p class="text-xs text-muted-foreground">Test your knowledge</p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="target" Size="14" Class="size-3.5 text-blue-500" />
                    <span class="text-xs font-medium">@_questionsAnswered/5</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <LucideIconCn Name="zap" Size="14" Class="size-3.5 text-amber-500" />
                    <span class="text-xs font-medium">@_score pts</span>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4">
            @foreach (var message in _messages)
            {
                var msg = message;
                <div class="@Cn.Merge("flex", msg.Type == "user" ? "justify-end" : "justify-start")">
                    <div class="@Cn.Merge("max-w-[85%] space-y-2", msg.Type == "user" ? "items-end" : "items-start")">
                        <div class="@Cn.Merge("rounded-lg px-3 py-2", msg.Type == "user" ? "bg-foreground text-background" : "bg-muted")">
                            <p class="text-sm">@msg.Content</p>
                        </div>

                        @if (msg.Question != null)
                        {
                            <div class="w-full space-y-3 rounded-lg border bg-card p-3">
                                <p class="text-sm font-medium">@msg.Question.Text</p>
                                <div class="space-y-2">
                                    @foreach (var opt in msg.Question.Options)
                                    {
                                        var option = opt;
                                        var isCorrect = msg.Question.CorrectAnswer == option.Id;
                                        var isUserAnswer = msg.Question.UserAnswer == option.Id;
                                        var showResult = msg.Question.UserAnswer != null;
                                        <button type="button"
                                                disabled="@(showResult ? "disabled" : null)"
                                                class="@Cn.Merge("flex w-full items-center gap-3 rounded-md border px-3 py-2 text-left text-sm transition-colors",
                                                    !showResult ? "hover:bg-muted/50" : "",
                                                    showResult && isCorrect ? "border-emerald-500 bg-emerald-500/10" : "",
                                                    showResult && isUserAnswer && !isCorrect ? "border-red-500 bg-red-500/10" : "")">
                                            <span class="flex size-5 shrink-0 items-center justify-center rounded-full border bg-background text-xs font-medium">
                                                @option.Id.ToUpper()
                                            </span>
                                            <span class="flex-1">@option.Text</span>
                                            @if (showResult && isCorrect)
                                            {
                                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                                            }
                                            @if (showResult && isUserAnswer && !isCorrect)
                                            {
                                                <LucideIconCn Name="x-circle" Size="16" Class="size-4 shrink-0 text-red-500" />
                                            }
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        @if (msg.Result != null)
                        {
                            <div class="@Cn.Merge("w-full space-y-2 rounded-lg border p-3", msg.Result.Correct ? "border-emerald-500 bg-emerald-500/10" : "border-red-500 bg-red-500/10")">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        @if (msg.Result.Correct)
                                        {
                                            <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-500" />
                                        }
                                        else
                                        {
                                            <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-500" />
                                        }
                                        <span class="@Cn.Merge("text-sm font-medium", msg.Result.Correct ? "text-emerald-600" : "text-red-600")">
                                            @(msg.Result.Correct ? "Correct!" : "Incorrect")
                                        </span>
                                    </div>
                                    <div class="flex items-center gap-1">
                                        <LucideIconCn Name="zap" Size="12" Class="size-3 text-amber-500" />
                                        <span class="text-sm font-medium">+@msg.Result.Points pts</span>
                                    </div>
                                </div>
                                <p class="text-sm text-muted-foreground">@msg.Result.Explanation</p>
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@msg.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-3">
            <form class="flex items-center gap-2" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0">
                    <LucideIconCn Name="trophy" Size="16" Class="size-4" />
                </ButtonCn>
                <InputCn @bind-Value="_input"
                         Placeholder="Select an answer or type a message..."
                         Class="border-0 bg-transparent shadow-none focus-visible:ring-0" />
                <ButtonCn type="submit" Size="ButtonSize.Icon" Class="h-8 w-8 shrink-0" Disabled="@(string.IsNullOrWhiteSpace(_input))">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record QuizOption(string Id, string Text);

    private record QuizQuestion(
        string Text,
        QuizOption[] Options,
        string? CorrectAnswer = null,
        string? UserAnswer = null);

    private record QuizResult(bool Correct, string Explanation, int Points);

    private record QuizMessage(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        QuizQuestion? Question = null,
        QuizResult? Result = null);

    private static readonly QuizMessage[] _sampleMessages =
    [
        new("1", "assistant",
            "Welcome to the React Quiz Challenge! Test your knowledge and earn points. Ready to start?",
            "3:00 PM"),
        new("2", "user",
            "Let's begin!",
            "3:00 PM"),
        new("3", "assistant",
            "Question 1 of 5:",
            "3:00 PM",
            Question: new QuizQuestion(
                "Which hook would you use to perform side effects in a React component?",
                [
                    new("a", "useState"),
                    new("b", "useEffect"),
                    new("c", "useContext"),
                    new("d", "useReducer"),
                ])),
        new("4", "user",
            "B - useEffect",
            "3:01 PM"),
        new("5", "assistant",
            "Correct! Well done!",
            "3:01 PM",
            Result: new QuizResult(
                true,
                "useEffect is the correct hook for handling side effects like data fetching, subscriptions, or manually changing the DOM.",
                10)),
        new("6", "assistant",
            "Question 2 of 5:",
            "3:01 PM",
            Question: new QuizQuestion(
                "What does the 'key' prop help React identify in lists?",
                [
                    new("a", "The styling of elements"),
                    new("b", "Which items have changed, been added, or removed"),
                    new("c", "The order of rendering"),
                    new("d", "The component hierarchy"),
                ],
                CorrectAnswer: "b",
                UserAnswer: "c")),
    ];

    private List<QuizMessage> _messages = new(_sampleMessages);
    private string _input = "";
    private int _score = 10;
    private int _questionsAnswered = 1;

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
