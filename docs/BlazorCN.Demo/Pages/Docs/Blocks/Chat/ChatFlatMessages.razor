        new("4", "alex", "Alex Rivera", "AR", "Check the request timeout on the payment service. We bumped it to 30s but the gateway might be cutting at 10s.", "9:14 AM"),
        new("5", "casey", "Casey Nguyen", "CN", "I can confirm the timeout issue. The gateway has a hard 10-second limit. We need to add a retry mechanism or reduce the processing time.", "9:18 AM"),
        new("6", "dana", "Dana Lin", "DL", "Found it. The session validation was making a redundant DB call on every webhook. Removed it and response times are under 2s now.", "9:31 AM", 2),
        new("7", "sam", "Sam Park", "SP", "Confirmed. Webhook success rate back to 100%. Good catch Dana.", "9:34 AM"),
        new("8", "alex", "Alex Rivera", "AR", "Let's add a webhook latency alert in Datadog so we catch these earlier. I'll create the monitor after lunch.", "9:40 AM"),
