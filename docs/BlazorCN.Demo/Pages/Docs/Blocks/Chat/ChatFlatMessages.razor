@* ============================================================
   Block: chat-flat-messages
   Title: ChatFlatMessages
   Description: React Slack-style flat chat interface for Next.js with avatars, usernames, timestamps, thread replies, and hover reactions using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-flat-messages.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="sticky top-0 z-10 flex items-center gap-2 border-b bg-card p-2">
            <div class="flex h-8 w-8 shrink-0 items-center justify-center">
                <LucideIconCn Name="hash" Size="16" Class="size-4 text-muted-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">engineering</span>
                <p class="text-xs text-muted-foreground">4 members</p>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto py-2" tabindex="0" role="group" aria-label="Messages">
            @* Date separator *@
            <div class="my-4 flex items-center gap-2 px-2">
                <div class="h-px flex-1 bg-border"></div>
                <span class="min-w-max text-xs font-semibold text-muted-foreground">Today</span>
                <div class="h-px flex-1 bg-border"></div>
            </div>

            @for (int i = 0; i < _messages.Length; i++)
            {
                var msg = _messages[i];
                var msgId = msg.Id;
                var prevMsg = i > 0 ? _messages[i - 1] : null;
                var isFirstInGroup = prevMsg == null || prevMsg.SenderId != msg.SenderId;

                @if (isFirstInGroup)
                {
                    <div class="relative flex gap-2 px-2 hover:bg-accent"
                         @onmouseenter="@(() => _hoveredId = msgId)"
                         @onmouseleave="@(() => _hoveredId = null)">
                        <div class="flex w-10 shrink-0 justify-center pt-1">
                            <AvatarCn Class="size-8 rounded-full">
                                <AvatarFallbackCn Class="text-xs">@msg.SenderInitials</AvatarFallbackCn>
                            </AvatarCn>
                        </div>
                        <div class="flex flex-1 flex-col">
                            <div class="flex items-center gap-2 text-sm">
                                <span class="font-medium">@msg.SenderName</span>
                                <span class="text-xs text-muted-foreground">@msg.Timestamp</span>
                            </div>
                            <div class="text-sm">@msg.Content</div>
                            @if (msg.ThreadCount.HasValue)
                            {
                                <button type="button"
                                        class="mt-1 flex items-center gap-1 text-xs text-blue-600 hover:underline dark:text-blue-400">
                                    <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                    @msg.ThreadCount @(msg.ThreadCount == 1 ? "reply" : "replies")
                                </button>
                            }
                        </div>

                        @* Hover react button *@
                        @if (_hoveredId == msg.Id)
                        {
                            <div class="absolute top-1 right-4">
                                <ButtonCn type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                                          Class="size-6 rounded-md border-border/50 bg-card" aria-label="Emoji">
                                    <LucideIconCn Name="smile" Size="12" Class="size-3 text-muted-foreground" />
                                </ButtonCn>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="group relative flex gap-2 px-2 hover:bg-accent"
                         @onmouseenter="@(() => _hoveredId = msgId)"
                         @onmouseleave="@(() => _hoveredId = null)">
                        <div class="flex w-10 shrink-0 justify-center pt-1">
                            <span class="invisible text-right text-[10px] text-muted-foreground group-hover:visible">
                                @msg.Timestamp
                            </span>
                        </div>
                        <div class="flex flex-1 flex-col">
                            <div class="text-sm">@msg.Content</div>
                            @if (msg.ThreadCount.HasValue)
                            {
                                <button type="button"
                                        class="mt-1 flex items-center gap-1 text-xs text-blue-600 hover:underline dark:text-blue-400">
                                    <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                    @msg.ThreadCount @(msg.ThreadCount == 1 ? "reply" : "replies")
                                </button>
                            }
                        </div>

                        @* Hover react button *@
                        @if (_hoveredId == msg.Id)
                        {
                            <div class="absolute top-1 right-4">
                                <ButtonCn type="button" Variant="ButtonVariant.Outline" Size="ButtonSize.Icon"
                                          Class="size-6 rounded-md border-border/50 bg-card" aria-label="Emoji">
                                    <LucideIconCn Name="smile" Size="12" Class="size-3 text-muted-foreground" />
                                </ButtonCn>
                            </div>
                        }
                    </div>
                }
            }
        </div>

        @* Toolbar *@
        <div class="sticky bottom-0 bg-card p-2 pt-0">
            <form @onsubmit="HandleSubmit" class="flex flex-wrap items-start gap-x-2 rounded-md border px-3 py-2">
                <div class="order-1 flex h-10 items-center gap-1.5">
                    <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                              Class="size-8 text-muted-foreground" aria-label="Add">
                        <LucideIconCn Name="plus" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
                <div class="order-2 grid min-w-0 flex-1">
                    <textarea @bind="_input" @bind:event="oninput"
                              placeholder="Message #engineering"
                              class="h-fit min-h-10 resize-none border-none bg-transparent px-1 text-sm shadow-none outline-none placeholder:text-muted-foreground"
                              rows="1" aria-label="Message #engineering"></textarea>
                </div>
                <div class="order-3 flex h-10 items-center gap-1.5">
                    <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                              Disabled="@string.IsNullOrWhiteSpace(_input)"
                              Class="size-8 text-muted-foreground" aria-label="Send">
                        <LucideIconCn Name="send" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private record Sender(string Id, string Name, string Initials);

    private record Message(string Id, string SenderId, string SenderName, string SenderInitials, string Content, string Timestamp, int? ThreadCount = null);

    private static readonly Sender[] _senders =
    [
        new("alex", "Alex Rivera", "AR"),
        new("sam", "Sam Park", "SP"),
        new("dana", "Dana Lin", "DL"),
        new("casey", "Casey Nguyen", "CN"),
    ];

    private static readonly Message[] _messages =
    [
        new("1", "alex", "Alex Rivera", "AR", "Deployed v2.4.0 to production. All health checks passing.", "9:02 AM", 3),
        new("2", "sam", "Sam Park", "SP", "Nice. Saw the latency drop to 120ms on the dashboard. The new caching layer is working.", "9:05 AM"),
