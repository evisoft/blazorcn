@* ============================================================
   Block: chat-immigration-guide
   Title: ChatImmigrationGuide
   Description: An immigration guidance chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring visa type cards, document checklists, and process timelines
   Source: original/blocks/chat/chat-immigration-guide.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-9 items-center justify-center rounded-full bg-blue-500/10">
                <LucideIconCn Name="plane" Size="20" Class="size-5 text-blue-600" />
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-medium">Immigration Guide</h3>
                <p class="text-xs text-muted-foreground">Visa &amp; documentation help</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                Expert guidance
            </BadgeCn>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var message in _messages)
            {
                <div class="@Cn.Merge("flex gap-3", message.Role == "user" ? "flex-row-reverse" : "")">
                    <AvatarCn Class="size-8">
                        @if (message.Role == "assistant")
                        {
                            <AvatarFallbackCn Class="bg-blue-500/10">
                                <LucideIconCn Name="plane" Size="16" Class="size-4 text-blue-600" />
                            </AvatarFallbackCn>
                        }
                        else
                        {
                            <AvatarImageCn Src="/placeholder.svg" Alt="" />
                            <AvatarFallbackCn>You</AvatarFallbackCn>
                        }
                    </AvatarCn>

                    <div class="@Cn.Merge("flex-1 space-y-2", message.Role == "user" ? "flex flex-col items-end" : "")">
                        <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", message.Role == "assistant" ? "bg-muted" : "bg-primary text-primary-foreground")">
                            @message.Content
                        </div>

                        @if (message.VisaInfo != null)
                        {
                            <div class="rounded-lg border bg-card p-4">
                                <div class="space-y-4">
                                    @* Visa Header *@
                                    <div>
                                        <h4 class="font-medium text-sm">@message.VisaInfo.Type</h4>
                                        <div class="mt-2 flex flex-wrap gap-2">
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="gap-1 text-xs">
                                                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                                @message.VisaInfo.Duration
                                            </BadgeCn>
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                                                Processing: @message.VisaInfo.ProcessingTime
                                            </BadgeCn>
                                            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                                                Fee: @message.VisaInfo.Fee
                                            </BadgeCn>
                                        </div>
                                    </div>

                                    @* Document Checklist *@
                                    <div>
                                        <div class="mb-2 flex items-center gap-2">
                                            <LucideIconCn Name="file-text" Size="16" Class="size-4 text-muted-foreground" />
                                            <span class="text-sm font-medium">Required Documents</span>
                                        </div>
                                        <div class="space-y-2">
                                            @foreach (var doc in message.VisaInfo.Documents)
                                            {
                                                <div class="flex items-center gap-2 text-sm">
                                                    <div class="@Cn.Merge("size-4 rounded-sm border", doc.Completed ? "bg-blue-500 border-blue-500" : "")">
                                                        @if (doc.Completed)
                                                        {
                                                            <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-white" />
                                                        }
                                                    </div>
                                                    <span class="@Cn.Merge("", !doc.Required ? "text-muted-foreground" : "")">
                                                        @doc.Name@(!doc.Required ? " (optional)" : "")
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    </div>

                                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="w-full text-xs">
                                        View Full Requirements
                                    </ButtonCn>
                                </div>
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-4">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Ask about visa requirements..." Class="flex-1" aria-label="Ask about visa requirements..." />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record Document(string Name, bool Required, bool Completed);
    private record VisaInfo(string Type, string Duration, string ProcessingTime, string Fee, Document[] Documents);
    private record Message(string Id, string Role, string Content, string Timestamp, VisaInfo? VisaInfo = null);

    private List<Message> _messages =
    [
        new("1", "assistant",
            "Welcome! I'm your immigration guide. Tell me about your situation, and I'll help you understand your visa options and requirements.",
            "9:00 AM"),
        new("2", "user",
            "I'm a software engineer from India wanting to work in the US",
            "9:02 AM"),
        new("3", "assistant",
            "Based on your profile, here's the most suitable visa option for you:",
            "9:02 AM",
            new VisaInfo(
                "H-1B Work Visa",
                "3 years (renewable)",
                "3-6 months",
                "$460 + $500",
                [
                    new("Valid passport", true, false),
                    new("Job offer letter", true, false),
                    new("Educational certificates", true, false),
                    new("Resume/CV", true, false),
                    new("Labor Condition Application (LCA)", true, false),
                    new("Previous visa copies", false, false),
                ]
            )),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new($"immigration-guide-msg-{_messages.Count + 1}", "user", _input, "Just now"));
        _input = "";
    }
}
