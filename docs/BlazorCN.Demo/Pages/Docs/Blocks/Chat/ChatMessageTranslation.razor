@* ============================================================
   Block: chat-message-translation
   Title: ChatMessageTranslation
   Description: React chat block with inline message translation for Next.js featuring translate toggle, language labels, original and translated views, and GlobeIcon indicators using TypeScript, shadcn/ui, Framer Motion, and Tailwind CSS
   Source: original/blocks/chat/chat-message-translation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8">
                <AvatarFallbackCn Class="text-xs">CM</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Carlos Mendez</span>
                <span class="ml-2 text-muted-foreground text-xs">Regional Sales</span>
            </div>
            <div class="flex items-center gap-1.5 rounded-md bg-muted/50 px-2 py-1 text-muted-foreground text-xs">
                <LucideIconCn Name="globe" Size="12" Class="size-3" />
                <span>ES / EN</span>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto py-2">
            @for (int i = 0; i < _messages.Count; i++)
            {
                var idx = i;
                var msg = _messages[idx];
                var showAvatar = idx == 0 || _messages[idx - 1].Sender != msg.Sender;
                var hasTranslation = msg.Translation != null;
                var showTranslation = _showTranslations.Contains(msg.Id);

                <div class="group flex gap-2 px-3 py-1 hover:bg-accent/50">
                    <div class="w-8 shrink-0 pt-0.5">
                        @if (showAvatar)
                        {
                            <AvatarCn Class="size-8">
                                <AvatarFallbackCn Class="text-[10px]">@msg.Initials</AvatarFallbackCn>
                            </AvatarCn>
                        }
                        else
                        {
                            <span class="hidden text-[10px] text-muted-foreground group-hover:flex items-center justify-center h-full">
                                @msg.Time.Replace(" PM", "").Replace(" AM", "")
                            </span>
                        }
                    </div>
                    <div class="min-w-0 flex-1">
                        @if (showAvatar)
                        {
                            <div class="flex items-center gap-2">
                                <span class="font-medium text-sm">@msg.Sender</span>
                                <span class="text-[10px] text-muted-foreground">@msg.Time</span>
                            </div>
                        }
                        <p class="text-sm leading-relaxed">@msg.Content</p>

                        @if (hasTranslation)
                        {
                            var msgId = msg.Id;
                            <div class="mt-1">
                                <button type="button"
                                        @onclick="@(() => ToggleTranslation(msgId))"
                                        class="flex items-center gap-1.5 text-[11px] text-muted-foreground transition-colors hover:text-foreground">
                                    <LucideIconCn Name="globe" Size="12" Class="size-3" />
                                    <span>@(showTranslation ? "Show original" : "Translate")</span>
                                </button>

                                @if (showTranslation && msg.Translation != null)
                                {
                                    var translation = msg.Translation;
                                    <div class="overflow-hidden">
                                        <div class="mt-1.5 rounded-md bg-muted/30 p-2">
                                            <div class="mb-1 flex items-center gap-1.5">
                                                <LucideIconCn Name="languages" Size="12" Class="size-3 text-muted-foreground" />
                                                <span class="text-[10px] text-muted-foreground">
                                                    Translated from @translation.SourceLanguage
                                                </span>
                                            </div>
                                            <p class="text-sm leading-relaxed">@translation.Text</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Toolbar *@
        <div class="border-t px-3 py-3">
            <form class="flex items-end gap-2 rounded-lg border bg-background px-3 py-2" @onsubmit="HandleSubmit">
                <TextareaCn @bind-Value="_input"
                            Placeholder="Type a message..."
                            Class="min-h-0 max-h-32 resize-none border-0 bg-transparent p-0 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@(string.IsNullOrWhiteSpace(_input))"
                          Class="size-7 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>

    </div>
</section>

@code {
    private record Translation(string Text, string SourceLanguage);

    private record ChatMessage(string Id, string Sender, string Initials, string Content, string Time, Translation? Translation = null);

    private string _input = "";
    private HashSet<string> _showTranslations = [];

    private static readonly List<ChatMessage> _messages =
    [
        new("m1", "Carlos Mendez", "CM",
            "Hola! Acabo de revisar el informe trimestral. Los numeros se ven muy bien este mes.",
            "2:30 PM",
            new Translation("Hi! I just reviewed the quarterly report. The numbers look really good this month.", "Spanish")),
        new("m2", "You", "YO",
            "Thanks Carlos! Glad the numbers are trending up. Can you share your regional breakdown?",
            "2:33 PM"),
        new("m3", "Carlos Mendez", "CM",
            "Claro que si. La region norte crecio un 15% y la region sur un 22%. El mercado latinoamericano esta superando las expectativas.",
            "2:35 PM",
            new Translation("Of course. The northern region grew by 15% and the southern region by 22%. The Latin American market is exceeding expectations.", "Spanish")),
        new("m4", "You", "YO",
            "That is impressive growth in the south. Should we allocate more marketing budget to that region next quarter?",
            "2:38 PM"),
        new("m5", "Carlos Mendez", "CM",
            "Definitivamente. Tambien sugiero que contratemos dos representantes de ventas mas para cubrir la demanda creciente. Ya tengo candidatos preseleccionados.",
            "2:41 PM",
            new Translation("Definitely. I also suggest we hire two more sales representatives to cover the growing demand. I already have pre-selected candidates.", "Spanish")),
        new("m6", "You", "YO",
            "Great thinking. Send me the candidate profiles and I will review them before our Friday meeting.",
            "2:44 PM"),
        new("m7", "Carlos Mendez", "CM",
            "Perfecto. Te los envio esta tarde. Una ultima cosa: el cliente de Bogota quiere adelantar la reunion al miercoles. Puedes confirmar tu disponibilidad?",
            "2:47 PM",
            new Translation("Perfect. I will send them this afternoon. One last thing: the Bogota client wants to move the meeting to Wednesday. Can you confirm your availability?", "Spanish")),
    ];

    private void ToggleTranslation(string messageId)
    {
        if (!_showTranslations.Add(messageId))
            _showTranslations.Remove(messageId);
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
