@* ============================================================
   Block: chat-empty-state
   Title: ChatEmptyState
   Description: React empty chat state block for Next.js with centered MessageSquare icon, heading, description text, suggestion chips, and functional input bar using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-empty-state.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                <span class="font-medium text-muted-foreground text-xs">AL</span>
            </div>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Alex Lee</span>
                <p class="text-muted-foreground text-xs">Online</p>
            </div>
        </div>

        @* Messages or Empty State *@
        <div class="flex flex-1 flex-col overflow-y-auto px-4 py-3">
            @if (_messages.Count == 0)
            {
                <div class="flex flex-1 flex-col items-center justify-center gap-3">
                    <div class="flex size-12 items-center justify-center rounded-full bg-muted/50">
                        <LucideIconCn Name="message-square" Size="24" Class="size-6 text-muted-foreground/60" />
                    </div>
                    <div class="text-center">
                        <p class="font-medium text-sm">No messages yet</p>
                        <p class="mt-1 max-w-[240px] text-muted-foreground text-xs">
                            Start the conversation by sending a message or try one of the suggestions below
                        </p>
                    </div>
                    <div class="mt-2 flex flex-wrap justify-center gap-2">
                        @foreach (var suggestion in _suggestions)
                        {
                            var s = suggestion;
                            <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm"
                                      Class="h-7 gap-1.5 text-xs"
                                      OnClick="@(() => SendMessage(s.Label))">
                                <LucideIconCn Name="@s.Icon" Size="12" Class="size-3" />
                                @s.Label
                            </ButtonCn>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-1">
                    @foreach (var msg in _messages)
                    {
                        var alignClass = msg.Sender == "me" ? "items-end" : "items-start";
                        var bubbleClass = msg.Sender == "me"
                            ? "max-w-[75%] rounded-2xl px-3 py-2 text-sm leading-relaxed bg-foreground text-background"
                            : "max-w-[75%] rounded-2xl px-3 py-2 text-sm leading-relaxed bg-muted text-foreground";
                        <div class="@($"flex flex-col {alignClass}")">
                            <div class="@bubbleClass">
                                @msg.Content
                            </div>
                            <span class="mt-0.5 px-1 text-[10px] text-muted-foreground">
                                @msg.Timestamp
                            </span>
                        </div>
                    }
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2">
                <input @bind="_input" @bind:event="oninput"
                       placeholder="Type a message..."
                       class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0 rounded-md px-3 text-sm outline-none placeholder:text-muted-foreground" />
                <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-9 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record Suggestion(string Label, string Icon);

    private record Message(string Id, string Content, string Sender, string Timestamp);

    private static readonly Suggestion[] _suggestions =
    [
        new("Say hello",       "message-square"),
        new("Share a file",    "file"),
        new("Ask a question",  "message-circle-question"),
    ];

    private List<Message> _messages = [];
    private string _input = "";

    private void SendMessage(string text)
    {
        var trimmed = text.Trim();
        if (string.IsNullOrEmpty(trimmed)) return;
        _messages.Add(new Message($"m{_messages.Count + 1}", trimmed, "me", "Just now"));
        _input = "";
    }

    private void HandleSubmit()
    {
        SendMessage(_input);
    }
}
