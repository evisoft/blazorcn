@* ============================================================
   Block: chat-sidebar-panel
   Title: ChatSidebarPanel
   Description: React narrow sidebar chat panel block for Next.js with compact messages, small avatars, condensed input, and content-adjacent layout using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-sidebar-panel.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-4xl p-4">
    <div class="flex h-[700px] overflow-hidden rounded-lg border bg-card">
        @* Left panel — full chat *@
        <div class="flex min-w-0 flex-1 flex-col">
            @* Chat header *@
            <div class="flex items-center gap-3 border-b px-4 py-3">
                <AvatarCn Class="size-7">
                    <AvatarFallbackCn Class="text-[10px]">SC</AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <span class="font-medium text-sm">Sarah Chen</span>
                    <p class="flex items-center gap-1.5 text-muted-foreground text-xs">
                        <span class="size-1.5 rounded-full bg-emerald-500"></span>
                        Active now
                    </p>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                          Class="size-8 text-muted-foreground hover:text-foreground"
                          OnClick="@(() => _detailsOpen = !_detailsOpen)">
                    <LucideIconCn Name="panel-right" Size="16" Class="size-4" />
                </ButtonCn>
            </div>

            @* Messages — flat layout *@
            <div class="flex flex-1 flex-col overflow-y-auto py-2">
                @for (int i = 0; i < _messages.Length; i++)
                {
                    var msg = _messages[i];
                    var prev = i > 0 ? _messages[i - 1] : null;
                    var isFirstInGroup = prev == null || prev.Name != msg.Name;

                    <div class="@Cn.Merge("group flex gap-2 px-4 py-0.5 hover:bg-accent/50", isFirstInGroup ? "mt-3" : "")">
                        @* Avatar column *@
                        <div class="flex w-8 shrink-0 items-start justify-center pt-0.5">
                            @if (isFirstInGroup)
                            {
                                <AvatarCn Class="size-6">
                                    <AvatarFallbackCn Class="text-[8px]">@msg.Initials</AvatarFallbackCn>
                                </AvatarCn>
                            }
                            else
                            {
                                <span class="invisible text-muted-foreground text-[9px] group-hover:visible">
                                    @msg.Timestamp
                                </span>
                            }
                        </div>

                        @* Body *@
                        <div class="min-w-0 flex-1">
                            @if (isFirstInGroup)
                            {
                                <div class="mb-0.5 flex items-center gap-2">
                                    <span class="font-medium text-sm">@msg.Name</span>
                                    <span class="text-muted-foreground text-[10px]">@msg.Timestamp</span>
                                </div>
                            }
                            <p class="text-sm leading-relaxed">@msg.Content</p>
                        </div>
                    </div>
                }
            </div>

            @* Toolbar *@
            <div class="border-t px-4 py-3">
                <form @onsubmit="HandleSubmit"
                      class="flex items-center gap-2 rounded-lg border bg-muted/30 px-3 py-1.5">
                    <input @bind="_input" @bind:event="oninput"
                           placeholder="Message Sarah..."
                           class="h-8 min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground" />
                    <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                              Disabled="@string.IsNullOrWhiteSpace(_input)"
                              Class="size-7 shrink-0 text-muted-foreground hover:text-foreground">
                        <LucideIconCn Name="send" Size="16" Class="size-4" />
                    </ButtonCn>
                </form>
            </div>
        </div>

        @* Right panel — conversation details *@
        @if (_detailsOpen)
        {
            <div class="flex w-72 shrink-0 flex-col border-l">
                @* Details header *@
                <div class="flex items-center justify-between border-b px-4 py-3">
                    <span class="font-medium text-sm">Details</span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                              Class="size-7 text-muted-foreground hover:text-foreground"
                              OnClick="@(() => _detailsOpen = false)">
                        <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                    </ButtonCn>
                </div>

                <div class="flex-1 overflow-y-auto">
                    @* Members *@
                    <div class="border-b px-4 py-3">
                        <div class="mb-2 flex items-center gap-2 text-muted-foreground">
                            <LucideIconCn Name="users" Size="14" Class="size-3.5" />
                            <span class="text-xs font-medium">Members (@_members.Length)</span>
                        </div>
                        <div class="flex flex-col gap-2">
                            @foreach (var member in _members)
                            {
                                <div class="flex items-center gap-2.5">
                                    <div class="relative">
                                        <AvatarCn Class="size-7">
                                            <AvatarFallbackCn Class="text-[9px]">@member.Initials</AvatarFallbackCn>
                                        </AvatarCn>
                                        <span class="@Cn.Merge("absolute right-0 bottom-0 size-2 rounded-full border-[1.5px] border-card", member.Online ? "bg-emerald-500" : "bg-zinc-400")"></span>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <span class="text-xs font-medium">@member.Name</span>
                                        <p class="text-muted-foreground text-[10px]">@member.Role</p>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @* Shared media *@
                    <div class="border-b px-4 py-3">
                        <div class="mb-2 flex items-center gap-2 text-muted-foreground">
                            <LucideIconCn Name="image" Size="14" Class="size-3.5" />
                            <span class="text-xs font-medium">Shared media</span>
                        </div>
                        <div class="grid grid-cols-3 gap-1.5">
                            @foreach (var i in Enumerable.Range(1, 6))
                            {
                                <div class="aspect-square rounded-md bg-muted/50"></div>
                            }
                        </div>
                    </div>

                    @* Shared files *@
                    <div class="border-b px-4 py-3">
                        <div class="mb-2 flex items-center gap-2 text-muted-foreground">
                            <LucideIconCn Name="file" Size="14" Class="size-3.5" />
                            <span class="text-xs font-medium">Shared files</span>
                        </div>
                        <div class="flex flex-col gap-2">
                            @foreach (var file in _sharedFiles)
                            {
                                <div class="flex items-center gap-2.5 rounded-md p-1.5 transition-colors hover:bg-muted/50">
                                    <div class="flex size-8 shrink-0 items-center justify-center rounded-md bg-muted/50">
                                        <LucideIconCn Name="file" Size="14" Class="size-3.5 text-muted-foreground" />
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <span class="block truncate text-xs font-medium">@file.Name</span>
                                        <span class="text-muted-foreground text-[10px]">@file.Size</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @* Notifications toggle *@
                    <div class="px-4 py-3">
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-2 text-muted-foreground">
                                <LucideIconCn Name="bell" Size="14" Class="size-3.5" />
                                <span class="text-xs font-medium">Notifications</span>
                            </div>
                            <SwitchCn @bind-Value="_notificationsOn" />
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Role, string Name, string Initials, string Content, string Timestamp);
    private record Member(string Name, string Initials, bool Online, string Role);
    private record SharedFile(string Name, string Size, string Type);

    private static readonly Member[] _members =
    [
        new("Sarah Chen", "SC", true, "Engineer"),
        new("You", "YO", true, "Engineer"),
        new("Alex Rivera", "AR", false, "Designer"),
    ];

    private static readonly SharedFile[] _sharedFiles =
    [
        new("api-spec.yaml", "24 KB", "file"),
        new("schema-v2.sql", "8 KB", "file"),
        new("architecture.md", "12 KB", "file"),
    ];

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "teammate", "Sarah", "SC", "Hey, did you see the latest deploy?", "9:14 AM"),
        new("m2", "user", "You", "YO", "Yeah, looks good. The latency dropped by 40ms.", "9:15 AM"),
        new("m3", "teammate", "Sarah", "SC", "Nice! The caching layer is paying off.", "9:15 AM"),
        new("m4", "user", "You", "YO", "We should monitor it for the next hour to make sure it stays stable.", "9:16 AM"),
        new("m5", "teammate", "Sarah", "SC", "Agreed. I set up a Grafana alert for p99 spikes.", "9:17 AM"),
        new("m6", "user", "You", "YO", "Perfect. Also, can you review my PR for the auth middleware?", "9:18 AM"),
        new("m7", "teammate", "Sarah", "SC", "Sure, I'll take a look after standup.", "9:18 AM"),
        new("m8", "user", "You", "YO", "Thanks! It's PR #247.", "9:19 AM"),
        new("m9", "teammate", "Sarah", "SC", "Got it. Quick question — did you add rate limiting to the token refresh endpoint?", "9:20 AM"),
        new("m10", "user", "You", "YO", "Yes, 10 requests per minute per user. Used the sliding window algorithm.", "9:21 AM"),
    ];

    private string _input = "";
    private bool _detailsOpen = true;
    private bool _notificationsOn = true;

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
