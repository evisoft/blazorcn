@* ============================================================
   Block: chat-floating-widget
   Title: ChatFloatingWidget
   Description: React floating chat widget block for Next.js with expandable bubble button, compact message panel, open/close toggle animation, and bottom-anchored input using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-floating-widget.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="relative h-[700px] overflow-hidden rounded-lg border bg-card">
        @* Background placeholder content *@
        <div class="flex h-full flex-col items-center justify-center gap-2 p-8 text-center">
            <span class="text-muted-foreground text-sm">Your application content</span>
            <span class="text-muted-foreground/60 text-xs">
                The chat widget floats over this area
            </span>
        </div>

        @* Floating widget -- positioned bottom-right within container *@
        <div class="absolute right-4 bottom-4">
            @if (_isOpen)
            {
                <div class="flex h-[460px] w-[340px] flex-col overflow-hidden rounded-lg border shadow-lg">
                    @* Branded header *@
                    <div class="flex items-center gap-3 bg-gradient-to-r from-blue-600 to-indigo-600 px-4 py-3">
                        <AvatarCn Class="size-7 border border-white/20">
                            <AvatarFallbackCn Class="bg-white/20 text-white text-xs">A</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <span class="font-medium text-sm text-white">Acme Support</span>
                            <p class="flex items-center gap-1.5 text-white/70 text-xs">
                                <span class="size-1.5 rounded-full bg-emerald-400"></span>
                                Online
                            </p>
                        </div>
                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                                  Class="size-7 text-white/70 hover:bg-white/10 hover:text-white"
                                  OnClick="@(() => _isOpen = false)">
                            <LucideIconCn Name="x" Size="14" Class="size-3.5" />
                        </ButtonCn>
                    </div>

                    @* Messages -- flat layout *@
                    <div class="flex flex-1 flex-col overflow-y-auto bg-card py-2">
                        @for (int i = 0; i < _messages.Length; i++)
                        {
                            var msg = _messages[i];
                            var idx = i;
                            var prev = idx > 0 ? _messages[idx - 1] : null;
                            var isFirstInGroup = prev == null || prev.Role != msg.Role;

                            var rowClass = Cn.Merge(
                                "group flex gap-2 px-3 py-0.5 hover:bg-accent/50",
                                isFirstInGroup ? "mt-2" : ""
                            );

                            <div class="@rowClass">
                                @* Avatar column *@
                                <div class="flex w-7 shrink-0 items-start justify-center pt-0.5">
                                    @if (isFirstInGroup)
                                    {
                                        <AvatarCn Class="size-6">
                                            <AvatarFallbackCn Class="text-[8px]">
                                                @(msg.Role == "agent" ? "A" : "You")
                                            </AvatarFallbackCn>
                                        </AvatarCn>
                                    }
                                    else
                                    {
                                        <span class="invisible text-muted-foreground text-[9px] group-hover:visible">
                                            @msg.Timestamp
                                        </span>
                                    }
                                </div>

                                @* Body *@
                                <div class="min-w-0 flex-1">
                                    @if (isFirstInGroup)
                                    {
                                        <div class="mb-0.5 flex items-center gap-2">
                                            <span class="font-medium text-xs">
                                                @(msg.Role == "agent" ? "Acme Support" : "You")
                                            </span>
                                            <span class="text-muted-foreground text-[9px]">
                                                @msg.Timestamp
                                            </span>
                                        </div>
                                    }
                                    <p class="text-xs leading-relaxed">@msg.Content</p>
                                </div>
                            </div>
                        }
                    </div>

                    @* Toolbar *@
                    <div class="border-t bg-card px-3 py-2.5">
                        <form @onsubmit="HandleSubmit" class="flex items-center gap-2 rounded-md border bg-muted/30 px-2.5 py-1">
                            <input @bind="_input"
                                   @bind:event="oninput"
                                   placeholder="Type a message..."
                                   class="h-7 min-w-0 flex-1 bg-transparent text-xs outline-none placeholder:text-muted-foreground" />
                            <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                                      Disabled="@string.IsNullOrWhiteSpace(_input)"
                                      Class="size-6 shrink-0 text-muted-foreground hover:text-foreground">
                                <LucideIconCn Name="send" Size="12" Class="size-3" />
                            </ButtonCn>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <button type="button"
                        @onclick="@(() => _isOpen = true)"
                        class="relative flex size-12 items-center justify-center rounded-full bg-gradient-to-r from-blue-600 to-indigo-600 shadow-lg transition-transform hover:scale-105">
                    <LucideIconCn Name="message-circle" Size="20" Class="size-5 text-white" />
                    <span class="absolute -top-0.5 -right-0.5 flex size-4 items-center justify-center rounded-full bg-red-500 text-[9px] font-medium text-white">
                        1
                    </span>
                </button>
            }
        </div>
    </div>
</section>

@code {
    private record ChatMessage(string Id, string Role, string Content, string Timestamp);

    private bool _isOpen = true;
    private string _input = "";

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "agent", "Hi there! Welcome to Acme Support. How can I help you today?", "2:30 PM"),
        new("m2", "user", "I'm having trouble connecting my API key to the dashboard.", "2:31 PM"),
        new("m3", "agent", "I can help with that. First, make sure you're using the key from the Production tab, not the Development tab. The production keys start with pk_live_ prefix.", "2:31 PM"),
        new("m4", "user", "Oh, I was using the development key. Let me switch that.", "2:32 PM"),
        new("m5", "agent", "That should fix it. After updating the key, restart your dev server to pick up the new environment variable. Let me know if it works!", "2:33 PM"),
    ];

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
