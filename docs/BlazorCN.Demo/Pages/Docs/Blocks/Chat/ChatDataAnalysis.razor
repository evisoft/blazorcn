@* ============================================================
   Block: chat-data-analysis
   Title: ChatDataAnalysis
   Description: Data analysis chat interface with inline chart responses and query suggestions built with React, Next.js, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-data-analysis.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-lg bg-muted">
                    <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4 text-foreground" />
                </div>
                <div class="flex-1">
                    <h3 class="text-sm font-medium">Data Analysis Assistant</h3>
                    <p class="text-xs text-muted-foreground">Ask questions about your data</p>
                </div>
                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 text-xs">
                    <LucideIconCn Name="download" Size="14" Class="size-3.5" />
                    Export
                </ButtonCn>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 space-y-4 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var message in _messages)
            {
                var msg = message;
                <div class="@Cn.Merge("flex gap-3", msg.Type == "user" ? "flex-row-reverse" : "")">
                    @* Avatar *@
                    <AvatarCn Class="size-8 shrink-0">
                        <AvatarFallbackCn Class="@Cn.Merge(msg.Type == "user" ? "bg-blue-500 text-white" : "bg-muted")">
                            @if (msg.Type == "user")
                            {
                                <span class="text-xs">You</span>
                            }
                            else
                            {
                                <LucideIconCn Name="bar-chart-3" Size="16" Class="size-4" />
                            }
                        </AvatarFallbackCn>
                    </AvatarCn>

                    @* Message Content *@
                    <div class="@Cn.Merge("flex-1 space-y-2", msg.Type == "user" ? "flex flex-col items-end" : "")">
                        @if (msg.Type == "chart" && msg.ChartData != null)
                        {
                            <div class="max-w-md space-y-3">
                                <div class="rounded-lg border bg-muted/50 p-4">
                                    <div class="mb-3 flex items-center justify-between">
                                        <h4 class="text-sm font-medium">@msg.ChartData.Title</h4>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 gap-1 text-xs">
                                            <LucideIconCn Name="download" Size="12" Class="size-3" />
                                            Export
                                        </ButtonCn>
                                    </div>

                                    @* Simple Bar Chart *@
                                    <div class="space-y-2">
                                        @foreach (var item in msg.ChartData.Data)
                                        {
                                            var chartItem = item;
                                            var maxValue = msg.ChartData.Data.Max(d => d.Value);
                                            var percentage = maxValue > 0 ? (chartItem.Value / (double)maxValue) * 100 : 0;
                                            <div class="space-y-1">
                                                <div class="flex items-center justify-between text-xs">
                                                    <span class="text-muted-foreground">@chartItem.Label</span>
                                                    <span class="font-medium tabular-nums">$@chartItem.Value.ToString("N0")</span>
                                                </div>
                                                <div class="h-2 overflow-hidden rounded-full bg-muted">
                                                    <div class="h-full bg-blue-500 transition-all" style="@(FormattableString.Invariant($"width:{percentage:F1}%"))"></div>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    @* Insight *@
                                    <div class="mt-3 flex gap-2 rounded-md bg-muted p-2">
                                        <LucideIconCn Name="lightbulb" Size="16" Class="size-4 shrink-0 text-amber-500" />
                                        <p class="text-xs text-muted-foreground">@msg.ChartData.Insight</p>
                                    </div>
                                </div>
                                <span class="block text-xs text-muted-foreground">@msg.Timestamp</span>
                            </div>
                        }
                        else
                        {
                            <div class="@Cn.Merge("max-w-sm rounded-lg px-3 py-2", msg.Type == "user" ? "bg-blue-500 text-white" : "bg-muted")">
                                <p class="text-sm">@msg.Content</p>
                                <span class="@Cn.Merge("mt-1 block text-xs", msg.Type == "user" ? "text-blue-100" : "text-muted-foreground")">
                                    @msg.Timestamp
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Suggestions *@
        <div class="border-t px-4 py-2">
            <div class="flex items-center gap-2 overflow-x-auto">
                <LucideIconCn Name="sparkles" Size="12" Class="size-3 shrink-0 text-muted-foreground" />
                <span class="shrink-0 text-xs text-muted-foreground">Try asking:</span>
                @foreach (var suggestion in _suggestions)
                {
                    var sugg = suggestion;
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-6 shrink-0 text-xs" OnClick="@(() => HandleSuggestion(sugg))">
                        @sugg
                    </ButtonCn>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-4">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Ask a question about your data..."
                         Class="flex-1" aria-label="Ask a question about your data..." />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@string.IsNullOrWhiteSpace(_input)" OnClick="HandleSend" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ChartDataPoint(string Label, int Value);

    private record ChartInfo(string Title, ChartDataPoint[] Data, string Insight);

    private record Message(string Id, string Type, string Content, string Timestamp, ChartInfo? ChartData = null);

    private string _input = "";

    private List<Message> _messages =
    [
        new("1", "assistant", "Hi! I'm your data analysis assistant. Ask me anything about your data.", "10 min ago"),
        new("2", "user", "Show me monthly revenue for Q1", "9 min ago"),
        new("3", "chart", "Here's the monthly revenue breakdown for Q1", "9 min ago",
            new ChartInfo(
                "Q1 Monthly Revenue",
                [
                    new("January", 45000),
                    new("February", 52000),
                    new("March", 61000),
                ],
                "Revenue grew 35.6% from January to March, with strongest growth in March."
            )),
        new("4", "user", "What about customer acquisition?", "5 min ago"),
        new("5", "chart", "Customer acquisition data for Q1", "5 min ago",
            new ChartInfo(
                "New Customers by Month",
                [
                    new("January", 320),
                    new("February", 285),
                    new("March", 410),
                ],
                "Customer acquisition increased 28% overall, with a 43.9% jump in March."
            )),
    ];

    private static readonly string[] _suggestions =
    [
        "Compare Q1 vs Q4 revenue",
        "Show top performing products",
        "Analyze churn rate trends",
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var userMessage = new Message(
            DateTime.Now.Ticks.ToString(),
            "user",
            _input,
            "Just now"
        );

        _messages = [.. _messages, userMessage];
        _input = "";
    }

    private void HandleSuggestion(string suggestion)
    {
        _input = suggestion;
    }
}
