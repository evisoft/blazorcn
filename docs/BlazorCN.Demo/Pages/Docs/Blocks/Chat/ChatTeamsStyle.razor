@* ============================================================
   Block: chat-teams-style
   Title: ChatTeamsStyle
   Description: React Microsoft Teams-inspired chat interface for Next.js with left-border accent on own messages, emoji reactions bar, thread replies, and compose box with formatting hints using TypeScript, shadcn/ui, Tailwind CSS, and Framer Motion
   Source: original/blocks/chat/chat-teams-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <LucideIconCn Name="message-square" Size="16" Class="size-4 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Product Team</span>
                <p class="text-muted-foreground text-xs">3 members</p>
            </div>
        </div>

        @* Messages *@
        <div class="flex flex-1 flex-col gap-1 overflow-y-auto px-4 py-3">
            @foreach (var msg in _messages)
            {
                var msgId = msg.Id;
                var isThreadExpanded = _expandedThreads.Contains(msgId);
                var hasReplies = msg.Replies != null && msg.Replies.Length > 0;
                var isHovered = _hoveredMsg == msgId;
                var rowClass = Cn.Merge(
                    "relative rounded-md px-3 py-2 transition-colors hover:bg-muted/30",
                    msg.IsMe ? "border-l-2 border-blue-500" : ""
                );

                <div class="group">
                    @* Message row *@
                    <div class="@rowClass"
                         @onmouseenter="@(() => _hoveredMsg = msgId)"
                         @onmouseleave="@(() => _hoveredMsg = null)">

                        @* Reaction bar on hover *@
                        @if (isHovered)
                        {
                            <div class="absolute -top-8 right-0 flex items-center gap-0.5 rounded-md border bg-card p-0.5 shadow-sm">
                                @foreach (var emoji in _reactionEmojis)
                                {
                                    var emojiCapture = emoji;
                                    var msgCapture = msgId;
                                    <button type="button"
                                            @onclick="@(() => HandleReaction(msgCapture, emojiCapture))"
                                            class="flex size-7 items-center justify-center rounded transition-colors hover:bg-muted">
                                        <span class="text-sm">@emojiCapture</span>
                                    </button>
                                }
                            </div>
                        }

                        <div class="flex items-start gap-2.5">
                            <AvatarCn Class="mt-0.5 size-8 shrink-0">
                                <AvatarFallbackCn Class="text-[10px]">@msg.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-baseline gap-2">
                                    <span class="font-medium text-sm">@msg.SenderName</span>
                                    <span class="text-muted-foreground text-[10px]">@msg.Timestamp</span>
                                </div>
                                <p class="mt-0.5 text-sm leading-relaxed">@msg.Content</p>

                                @* Reactions *@
                                @if (msg.Reactions.Length > 0)
                                {
                                    <div class="mt-1.5 flex items-center gap-1">
                                        @foreach (var reaction in msg.Reactions)
                                        {
                                            var reactionEmoji = reaction.Emoji;
                                            var reactionMsgId = msgId;
                                            var reactionClass = Cn.Merge(
                                                "flex items-center gap-1 rounded-full border px-1.5 py-0.5 text-xs transition-colors",
                                                reaction.Reacted
                                                    ? "border-blue-200 bg-blue-50 dark:border-blue-800 dark:bg-blue-500/10"
                                                    : "border-transparent bg-muted/50 hover:bg-muted"
                                            );
                                            <button type="button"
                                                    @onclick="@(() => HandleReaction(reactionMsgId, reactionEmoji))"
                                                    class="@reactionClass">
                                                <span>@reaction.Emoji</span>
                                                <span class="text-muted-foreground text-[10px] tabular-nums">@reaction.Count</span>
                                            </button>
                                        }
                                    </div>
                                }

                                @* Thread replies indicator *@
                                @if (hasReplies)
                                {
                                    var threadMsgId = msgId;
                                    var replyCount = msg.Replies!.Length;
                                    <button type="button"
                                            @onclick="@(() => ToggleThread(threadMsgId))"
                                            class="mt-1.5 flex items-center gap-1.5 text-blue-600 text-xs transition-colors hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300">
                                        <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                        <span>@replyCount @(replyCount == 1 ? "reply" : "replies")</span>
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    @* Expanded thread *@
                    @if (isThreadExpanded && msg.Replies != null)
                    {
                        <div class="ml-10 overflow-hidden border-l-2 border-muted pl-4">
                            @foreach (var reply in msg.Replies)
                            {
                                <div class="flex items-start gap-2 px-3 py-1.5">
                                    <AvatarCn Class="mt-0.5 size-6 shrink-0">
                                        <AvatarFallbackCn Class="text-[8px]">@reply.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                    <div class="min-w-0 flex-1">
                                        <div class="flex items-baseline gap-2">
                                            <span class="font-medium text-xs">@reply.SenderName</span>
                                            <span class="text-muted-foreground text-[10px]">@reply.Timestamp</span>
                                        </div>
                                        <p class="mt-0.5 text-sm leading-relaxed">@reply.Content</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @* Compose box *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Type a new message"
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Class="size-8 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="at-sign" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Class="size-8 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="smile" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Class="size-8 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="paperclip" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-8 shrink-0 text-blue-600 hover:text-blue-700 disabled:text-muted-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>

            @* Formatting hints *@
            <div class="mt-1.5 flex items-center gap-3">
                <div class="flex items-center gap-0.5 text-muted-foreground/50">
                    <LucideIconCn Name="bold" Size="12" Class="size-3" />
                    <span class="text-[10px]">Bold</span>
                </div>
                <div class="flex items-center gap-0.5 text-muted-foreground/50">
                    <LucideIconCn Name="italic" Size="12" Class="size-3" />
                    <span class="text-[10px]">Italic</span>
                </div>
                <div class="flex items-center gap-0.5 text-muted-foreground/50">
                    <LucideIconCn Name="code" Size="12" Class="size-3" />
                    <span class="text-[10px]">Code</span>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private record Reaction(string Emoji, int Count, bool Reacted);

    private record ThreadReply(string Id, string SenderName, string Initials, string Content, string Timestamp);

    private record Message(string Id, string Content, string SenderName, string Initials, string Timestamp, bool IsMe, Reaction[] Reactions, ThreadReply[]? Replies = null);

    private static readonly string[] _reactionEmojis = ["👍", "❤️", "😂", "😮", "😢"];

    private string _input = "";
    private string? _hoveredMsg = null;
    private readonly HashSet<string> _expandedThreads = [];

    private Message[] _messages =
    [
        new("1", "Good morning everyone. Sprint planning starts in 10 minutes. Please have your estimates ready.",
            "Dana Kim", "DK", "9:00 AM", false,
            [new("👍", 4, false)]),
        new("2", "Ready. I've updated the story points for the auth module tickets.",
            "You", "YO", "9:02 AM", true,
            []),
        new("3", "Quick question — are we counting the API migration in this sprint or pushing it to next?",
            "Raj Patel", "RP", "9:03 AM", false,
            [],
            [
                new("3r1", "Dana Kim", "DK", "Let's discuss in planning. I think we can fit the first phase in.", "9:04 AM"),
                new("3r2", "You", "YO", "Agreed. Phase 1 is mostly schema changes, not too heavy.", "9:05 AM"),
            ]),
        new("4", "Also, the design team shared updated mocks for the settings page. Take a look before the meeting.",
            "Dana Kim", "DK", "9:06 AM", false,
            [new("👍", 2, true), new("❤️", 1, false)]),
        new("5", "Reviewed the mocks. The sidebar navigation change looks good but we might need an extra day for the responsive breakpoints.",
            "You", "YO", "9:08 AM", true,
            []),
        new("6", "I can help with the responsive work. I've already done similar patterns on the dashboard.",
            "Raj Patel", "RP", "9:09 AM", false,
            [new("👍", 1, true)]),
        new("7", "Great teamwork. Let's finalize assignments in the meeting. Joining now.",
            "Dana Kim", "DK", "9:10 AM", false,
            []),
    ];

    private void ToggleThread(string msgId)
    {
        if (_expandedThreads.Contains(msgId))
            _expandedThreads.Remove(msgId);
        else
            _expandedThreads.Add(msgId);
    }

    private void HandleReaction(string msgId, string emoji)
    {
        _messages = _messages.Select(msg =>
        {
            if (msg.Id != msgId) return msg;
            var existing = msg.Reactions.FirstOrDefault(r => r.Emoji == emoji);
            if (existing != null)
            {
                Reaction[] newReactions;
                if (existing.Reacted)
                {
                    newReactions = msg.Reactions
                        .Select(r => r.Emoji == emoji ? new Reaction(r.Emoji, r.Count - 1, false) : r)
                        .Where(r => r.Count > 0)
                        .ToArray();
                }
                else
                {
                    newReactions = msg.Reactions
                        .Select(r => r.Emoji == emoji ? new Reaction(r.Emoji, r.Count + 1, true) : r)
                        .ToArray();
                }
                return msg with { Reactions = newReactions };
            }
            return msg with { Reactions = [..msg.Reactions, new Reaction(emoji, 1, true)] };
        }).ToArray();
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
