@* ============================================================
   Block: chat-networking-event
   Title: ChatNetworkingEvent
   Description: A networking event chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring attendee cards, topic tags, and meeting request functionality
   Source: original/blocks/chat/chat-networking-event.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-blue-500/10">
                <LucideIconCn Name="briefcase" Size="16" Class="size-4 text-blue-600" />
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-medium">TechConf 2026 Networking</h3>
                <p class="text-xs text-muted-foreground">248 attendees online</p>
            </div>
            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1 text-xs">
                <LucideIconCn Name="user-plus" Size="12" Class="size-3" />
                Browse
            </ButtonCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto p-4" tabindex="0" role="group" aria-label="Messages">
            @foreach (var msg in _messages)
            {
                var message = msg;
                <div class="@Cn.Merge("mb-4 flex gap-3", message.Sender == "user" ? "flex-row-reverse" : "")">
                    <AvatarCn Class="size-8 shrink-0">
                        <AvatarFallbackCn Class="@Cn.Merge(message.Sender == "other" ? "bg-blue-500/10 text-blue-600" : "bg-muted")">
                            @message.SenderName.Substring(0, 2).ToUpper()
                        </AvatarFallbackCn>
                    </AvatarCn>

                    <div class="@Cn.Merge("flex-1 space-y-2", message.Sender == "user" ? "flex flex-col items-end" : "")">
                        <div class="flex items-baseline gap-2">
                            <span class="text-xs font-medium">@message.SenderName</span>
                            <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                        </div>

                        <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2", message.Sender == "other" ? "bg-muted" : "bg-blue-500/10 text-blue-900 dark:text-blue-100")">
                            <p class="text-sm">@message.Content</p>
                        </div>

                        @* Attendee Card *@
                        @if (message.Attendee != null)
                        {
                            var attendee = message.Attendee;
                            <div class="mt-2 w-full max-w-sm overflow-hidden rounded-lg border bg-card">
                                <div class="border-b bg-muted/50 px-3 py-2">
                                    <h4 class="font-medium text-sm">@attendee.Name</h4>
                                    <p class="mt-0.5 text-xs text-muted-foreground">@attendee.Title</p>
                                </div>

                                <div class="space-y-2 p-3">
                                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                        <LucideIconCn Name="building-2" Size="12" Class="size-3" />
                                        @attendee.Company
                                    </div>
                                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                        @attendee.Location
                                    </div>

                                    <div class="pt-2">
                                        <p class="mb-2 text-xs font-medium text-muted-foreground">Interests:</p>
                                        <div class="flex flex-wrap gap-1.5">
                                            @foreach (var topic in attendee.Topics)
                                            {
                                                <BadgeCn Variant="BadgeVariant.Outline" Class="h-5 text-xs">@topic</BadgeCn>
                                            }
                                        </div>
                                    </div>

                                    <div class="flex gap-2 pt-2">
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 flex-1 gap-1 text-xs">
                                            <LucideIconCn Name="user-plus" Size="12" Class="size-3" />
                                            Connect
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 flex-1 gap-1 text-xs">
                                            <LucideIconCn Name="external-link" Size="12" Class="size-3" />
                                            Profile
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        }

                        @* Meeting Request *@
                        @if (message.MeetingRequest != null)
                        {
                            var req = message.MeetingRequest;
                            <div class="mt-2 w-full max-w-sm overflow-hidden rounded-lg border border-blue-500/20 bg-blue-500/5">
                                <div class="flex items-center gap-2 border-b border-blue-500/20 bg-blue-500/10 px-3 py-2">
                                    <LucideIconCn Name="calendar" Size="16" Class="size-4 text-blue-600" />
                                    <p class="text-xs font-medium text-blue-900 dark:text-blue-100">Meeting Request</p>
                                </div>
                                <div class="space-y-2 p-3">
                                    <div>
                                        <h5 class="font-medium text-sm">@req.Title</h5>
                                        <p class="mt-0.5 text-xs text-muted-foreground">@req.Duration with @req.From</p>
                                    </div>

                                    <div>
                                        <p class="mb-2 text-xs font-medium text-muted-foreground">Proposed times:</p>
                                        <div class="space-y-1.5">
                                            @foreach (var time in req.Proposed)
                                            {
                                                <button type="button" class="flex w-full items-center justify-between rounded-md border px-3 py-1.5 text-left text-xs transition-colors hover:bg-muted/50">
                                                    <span>@time</span>
                                                </button>
                                            }
                                        </div>
                                    </div>

                                    <div class="flex gap-2 pt-1">
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 flex-1 text-xs">
                                            Decline
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Sm" Class="h-7 flex-1 text-xs">
                                            Accept
                                        </ButtonCn>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form @onsubmit="HandleSend" @onsubmit:preventDefault="true" class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Start a conversation..." Class="flex-1" aria-label="Start a conversation..." />
                <ButtonCn aria-label="Send message" type="submit" Size="ButtonSize.Sm" Class="shrink-0">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
            <p class="mt-2 text-xs text-muted-foreground">
                Use @@name to mention attendees @("•") Share your profile with /card
            </p>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record AttendeeInfo(string Name, string Title, string Company, string Location, string[] Topics);
    private record MeetingRequestInfo(string From, string Title, string Duration, string[] Proposed);
    private record ChatMessage(string Id, string Sender, string SenderName, string Content, string Timestamp, AttendeeInfo? Attendee = null, MeetingRequestInfo? MeetingRequest = null);

    private List<ChatMessage> _messages =
    [
        new("1", "other", "Alex Chen",
            "Hi! Saw you're interested in AI startups. I'm working on something in that space. Would love to connect!",
            "2:15 PM",
            Attendee: new AttendeeInfo("Alex Chen", "Co-Founder & CTO", "VectorAI", "San Francisco, CA",
                ["Machine Learning", "Startups", "Developer Tools"])),
        new("2", "user", "You",
            "Hey Alex! Yes, definitely interested. What's your focus area in AI?",
            "2:17 PM"),
        new("3", "other", "Alex Chen",
            "We're building AI-powered code review tools for engineering teams. Happy to chat more if you have time?",
            "2:18 PM",
            MeetingRequest: new MeetingRequestInfo("Alex Chen", "1:1 Chat - AI in Developer Tools", "30 min",
                ["Today 4:00 PM", "Tomorrow 10:00 AM", "Tomorrow 2:00 PM"])),
        new("4", "user", "You",
            "Sounds great! Tomorrow at 10 AM works for me.",
            "2:20 PM"),
        new("5", "other", "Sarah Kim",
            "Hi! I noticed you're both talking about AI tools. Mind if I join the conversation? Working on similar stuff at TechCorp.",
            "2:22 PM"),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        _messages.Add(new ChatMessage(
            Id: $"networking-event-msg-{_messages.Count + 1}",
            Sender: "user",
            SenderName: "You",
            Content: _input,
            Timestamp: "Just now"
        ));
        _input = "";
    }
}
