@* ============================================================
   Block: chat-emergency-dispatch
   Title: ChatEmergencyDispatch
   Description: An emergency dispatch coordination chat interface with location cards, priority codes, unit assignments, real-time status tracking, and incident management built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/chat/chat-emergency-dispatch.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b bg-red-500/5 px-4 py-3">
            <div class="flex items-center gap-3">
                <AvatarCn Class="size-8">
                    <AvatarImageCn Src="" Alt="" />
                    <AvatarFallbackCn Class="bg-red-500/10 text-red-600 text-xs">911</AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <h2 class="font-medium text-sm">Emergency Dispatch</h2>
                    <div class="flex items-center gap-2">
                        <span class="size-1.5 animate-pulse rounded-full bg-red-500"></span>
                        <p class="text-muted-foreground text-xs">Active</p>
                    </div>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4 py-4">
                @foreach (var message in _messages)
                {
                    <div class="@Cn.Merge("flex gap-3", message.Type == "user" ? "flex-row-reverse" : "")">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarImageCn Src="" Alt="" />
                            <AvatarFallbackCn Class="@Cn.Merge("text-xs", message.Type == "assistant" ? "bg-red-500/10 text-red-600" : "bg-muted")">
                                @(message.Type == "assistant" ? "911" : "D")
                            </AvatarFallbackCn>
                        </AvatarCn>
                        <div class="@Cn.Merge("min-w-0 flex-1 space-y-1", message.Type == "user" ? "flex flex-col items-end" : "")">
                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", message.Type == "assistant" ? "bg-muted" : "bg-primary text-primary-foreground")">
                                @message.Content
                            </div>
                            <span class="font-mono text-muted-foreground text-xs tabular-nums">
                                @message.Timestamp
                            </span>

                            @* Incident Card *@
                            @if (message.Incident != null)
                            {
                                var inc = message.Incident;
                                <div class="mt-3 overflow-hidden rounded-lg border border-red-500/20 bg-card">
                                    <div class="space-y-3 p-3">

                                        @* Incident Header *@
                                        <div class="flex items-start justify-between gap-3">
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-center gap-2">
                                                    <LucideIconCn Name="alert-circle" Size="16" Class="size-4 shrink-0 text-red-600" />
                                                    <h3 class="font-medium text-sm">@inc.Type</h3>
                                                </div>
                                                <p class="mt-0.5 font-mono text-muted-foreground text-xs">@inc.Id</p>
                                            </div>
                                            <BadgeCn Variant="BadgeVariant.Secondary"
                                                     Class="@Cn.Merge("shrink-0 text-xs font-medium uppercase", GetPriorityColor(inc.Priority))">
                                                @inc.Priority
                                            </BadgeCn>
                                        </div>

                                        @* Location *@
                                        <div class="space-y-1.5 rounded-md bg-muted/50 p-2.5">
                                            <div class="flex items-start gap-2">
                                                <LucideIconCn Name="map-pin" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                                <div class="min-w-0 flex-1 space-y-0.5 text-xs">
                                                    <p class="font-medium">@inc.Location.Address</p>
                                                    <p class="font-mono text-muted-foreground text-xs">@inc.Location.Coordinates</p>
                                                    <p class="text-muted-foreground">@inc.Location.Landmarks</p>
                                                </div>
                                            </div>
                                        </div>

                                        @* Caller Info *@
                                        <div class="flex items-center gap-3 rounded-md bg-muted/50 px-2.5 py-2">
                                            <LucideIconCn Name="user" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-baseline gap-2">
                                                    <span class="text-sm">@inc.Caller.Name</span>
                                                    <span class="text-muted-foreground text-xs">(@inc.Caller.Relation)</span>
                                                </div>
                                                <div class="mt-0.5 flex items-center gap-1.5">
                                                    <LucideIconCn Name="phone" Size="12" Class="size-3 text-muted-foreground" />
                                                    <span class="font-mono text-muted-foreground text-xs">@inc.Caller.Phone</span>
                                                </div>
                                            </div>
                                            <div class="flex items-center gap-1 text-muted-foreground text-xs">
                                                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                                <span class="font-mono tabular-nums">@inc.ReportedTime</span>
                                            </div>
                                        </div>

                                        @* Dispatched Units *@
                                        @if (inc.Units != null && inc.Units.Length > 0)
                                        {
                                            <div class="space-y-1.5">
                                                <div class="flex items-center gap-1.5">
                                                    <LucideIconCn Name="radio" Size="14" Class="size-3.5 text-muted-foreground" />
                                                    <span class="font-medium text-xs">Dispatched Units</span>
                                                </div>
                                                <div class="space-y-1.5">
                                                    @foreach (var unit in inc.Units)
                                                    {
                                                        <div class="flex items-center justify-between gap-2 rounded-md border bg-card px-2.5 py-2">
                                                            <div class="flex items-center gap-2">
                                                                <span class="font-mono font-medium text-sm">@unit.CallSign</span>
                                                                <span class="text-muted-foreground text-xs">@unit.Type</span>
                                                            </div>
                                                            <div class="flex items-center gap-2">
                                                                <span class="font-mono text-muted-foreground text-xs tabular-nums">ETA @unit.Eta</span>
                                                                <BadgeCn Variant="BadgeVariant.Secondary"
                                                                         Class="@Cn.Merge("text-xs capitalize", GetStatusColor(unit.Status))">
                                                                    @unit.Status.Replace("-", " ")
                                                                </BadgeCn>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <form class="border-t bg-muted/50 p-4" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Enter dispatch message..."
                         Class="flex-1 font-mono" aria-label="Enter dispatch message..." />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Disabled="@string.IsNullOrWhiteSpace(_input)" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </form>

    </div>
</section>

@code {
    private record IncidentLocation(string Address, string Coordinates, string Landmarks);
    private record CallerInfo(string Name, string Phone, string Relation);
    private record UnitAssignment(string Id, string CallSign, string Type, string Eta, string Status);
    private record Incident(string Id, string Type, string Priority, IncidentLocation Location, CallerInfo Caller, string ReportedTime, UnitAssignment[]? Units = null);
    private record Message(string Id, string Type, string Content, string Timestamp, Incident? Incident = null);

    private string _input = "";

    private List<Message> _messages = new List<Message>
    {
        new("1", "assistant", "Emergency dispatch center online. Ready to receive and coordinate emergency calls.", "14:22:18"),
        new("2", "user", "New incident: Structure fire reported at 1450 Maple Street", "14:22:45"),
        new("3", "assistant", "Incident logged. Dispatching units to structure fire:", "14:22:46",
            new Incident(
                "INC-2026-0842",
                "Structure Fire",
                "critical",
                new IncidentLocation("1450 Maple Street", "40.7128° N, 74.0060° W", "Near Riverside Elementary School, corner of Maple & 4th Ave"),
                new CallerInfo("Sarah Johnson", "(555) 234-5678", "Neighbor"),
                "14:22:30",
                new UnitAssignment[]
                {
                    new("u1", "Engine 5", "Fire Engine", "4 min", "en-route"),
                    new("u2", "Ladder 2", "Ladder Truck", "5 min", "en-route"),
                    new("u3", "Rescue 1", "Rescue Squad", "6 min", "dispatched"),
                    new("u4", "Battalion 3", "Battalion Chief", "7 min", "dispatched"),
                }
            )
        ),
        new("4", "user", "Engine 5 reports on scene, working fire visible from street", "14:26:35"),
        new("5", "assistant", "Acknowledged. Engine 5 on scene confirmed. Requesting additional units and medical standby.", "14:26:36"),
    };

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var now = DateTime.Now;
        var timestamp = $"{now.Hour:D2}:{now.Minute:D2}:{now.Second:D2}";
        _messages.Add(new Message($"emergency-dispatch-msg-{now.Ticks}", "user", _input, timestamp));
        _input = "";
    }

    private static string GetPriorityColor(string priority) => priority switch
    {
        "critical" => "bg-red-500/10 text-red-600",
        "high"     => "bg-orange-500/10 text-orange-600",
        "medium"   => "bg-amber-500/10 text-amber-600",
        "low"      => "bg-blue-500/10 text-blue-600",
        _          => "bg-muted",
    };

    private static string GetStatusColor(string status) => status switch
    {
        "on-scene"   => "bg-emerald-500/10 text-emerald-600",
        "en-route"   => "bg-blue-500/10 text-blue-600",
        "dispatched" => "bg-amber-500/10 text-amber-600",
        _            => "bg-muted",
    };
}
