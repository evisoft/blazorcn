@* ============================================================
   Block: chat-message-actions
   Title: ChatMessageActions
   Description: React chat interface with hover-to-reveal action toolbars for Next.js including reply, react, pin, edit, delete, and forward using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-message-actions.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8 shrink-0">
                <AvatarFallbackCn Class="text-[10px]">SC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Sarah Chen</span>
                <p class="text-muted-foreground text-xs">Online</p>
            </div>
        </div>

        @* Messages *@
        <div class="flex flex-1 flex-col overflow-y-auto py-2">
            <div class="flex flex-1 flex-col justify-end">
                @for (int i = 0; i < _messages.Length; i++)
                {
                    var msg = _messages[i];
                    var idx = i;
                    var prevMsg = idx > 0 ? _messages[idx - 1] : null;
                    var isConsecutive = prevMsg?.Sender == msg.Sender;
                    var msgId = msg.Id;
                    var isHovered = _hoveredId == msgId;
                    var rowClass = Cn.Merge(
                        "group relative flex gap-2 px-4 transition-colors hover:bg-accent",
                        isConsecutive ? "pt-0.5" : "pt-3"
                    );

                    <div class="@rowClass"
                         @onmouseenter="@(() => _hoveredId = msgId)"
                         @onmouseleave="@(() => _hoveredId = null)">
                        @* Hover action toolbar *@
                        @if (isHovered)
                        {
                            <div class="absolute -top-3 right-2 z-10 flex items-center gap-0.5 rounded-md border bg-card p-0.5 shadow-sm">
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-6">
                                    <LucideIconCn Name="smile" Size="12" Class="size-3" />
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-6">
                                    <LucideIconCn Name="reply" Size="12" Class="size-3" />
                                </ButtonCn>
                                <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-6">
                                    <LucideIconCn Name="pin" Size="12" Class="size-3" />
                                </ButtonCn>
                                <DropdownMenuCn>
                                    <DropdownMenuTriggerCn AsChild="true">
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-6">
                                            <LucideIconCn Name="more-horizontal" Size="12" Class="size-3" />
                                        </ButtonCn>
                                    </DropdownMenuTriggerCn>
                                    <DropdownMenuContentCn Align="FloatingAlign.End" Class="w-36">
                                        @if (msg.IsMe)
                                        {
                                            <DropdownMenuItemCn Class="gap-2 text-xs">
                                                <LucideIconCn Name="pen-line" Size="12" Class="size-3" />
                                                Edit
                                            </DropdownMenuItemCn>
                                        }
                                        <DropdownMenuItemCn Class="gap-2 text-xs">
                                            <LucideIconCn Name="forward" Size="12" Class="size-3" />
                                            Forward
                                        </DropdownMenuItemCn>
                                        <DropdownMenuItemCn Class="gap-2 text-xs">
                                            <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                            Copy text
                                        </DropdownMenuItemCn>
                                        @if (msg.IsMe)
                                        {
                                            <DropdownMenuSeparatorCn />
                                            <DropdownMenuItemCn Class="gap-2 text-xs text-red-600 focus:text-red-600">
                                                <LucideIconCn Name="trash-2" Size="12" Class="size-3" />
                                                Delete
                                            </DropdownMenuItemCn>
                                        }
                                    </DropdownMenuContentCn>
                                </DropdownMenuCn>
                            </div>
                        }

                        @* Avatar column *@
                        @if (!isConsecutive)
                        {
                            <AvatarCn Class="mt-0.5 size-8 shrink-0">
                                <AvatarFallbackCn Class="text-[10px]">@msg.Initials</AvatarFallbackCn>
                            </AvatarCn>
                        }
                        else
                        {
                            <div class="size-8 shrink-0"></div>
                        }

                        @* Body *@
                        <div class="min-w-0 flex-1">
                            @if (!isConsecutive)
                            {
                                <div class="flex items-baseline gap-2">
                                    <span class="font-medium text-sm">@msg.Sender</span>
                                    <span class="text-muted-foreground text-xs">@msg.Time</span>
                                </div>
                            }
                            <p class="text-sm leading-relaxed">@msg.Content</p>
                        </div>
                    </div>
                }
                <div class="h-2"></div>
            </div>
        </div>

        @* Toolbar *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2">
                <div class="flex flex-1 items-center rounded-md border bg-muted/50">
                    <input @bind="_input" @bind:event="oninput"
                           placeholder="Type a message..."
                           class="h-9 flex-1 border-0 bg-transparent px-3 text-sm outline-none shadow-none placeholder:text-muted-foreground focus-visible:ring-0" />
                    <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                              Disabled="@string.IsNullOrWhiteSpace(_input)"
                              Class="mr-1 size-7 shrink-0 text-muted-foreground hover:text-foreground">
                        <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private record Message(
        string Id,
        string Content,
        string Sender,
        string Initials,
        string Time,
        bool IsMe
    );

    private static readonly Message[] _messages =
    [
        new("1", "I just finished the API integration for the billing module. Ready for review.", "Sarah Chen", "SC", "2:10 PM", false),
        new("2", "Nice, I'll pull it down now. Which branch?", "You", "YO", "2:12 PM", true),
        new("3", "feature/billing-api — it's based off the latest main. All tests passing locally.", "Sarah Chen", "SC", "2:13 PM", false),
        new("4", "Found one issue: the webhook signature verification is using the test key instead of the env variable.", "You", "YO", "2:30 PM", true),
        new("5", "Oh good catch — I hardcoded it while debugging and forgot to revert. Fixing now.", "Sarah Chen", "SC", "2:31 PM", false),
        new("6", "Updated and force-pushed. Also added a .env.example so this doesn't happen again.", "Sarah Chen", "SC", "2:40 PM", false),
        new("7", "Looks clean now. Approved the PR. Let's ship it after the smoke test.", "You", "YO", "2:45 PM", true),
        new("8", "Smoke test passed. Merging to main and deploying to staging.", "Sarah Chen", "SC", "3:00 PM", false),
    ];

    private string? _hoveredId;
    private string _input = "";

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
