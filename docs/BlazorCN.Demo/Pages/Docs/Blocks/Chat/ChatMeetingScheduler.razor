@* ============================================================
   Block: chat-meeting-scheduler
   Title: ChatMeetingScheduler
   Description: A meeting scheduling chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring time slot proposals, availability grids, and instant confirmations
   Source: original/blocks/chat/chat-meeting-scheduler.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-8 items-center justify-center rounded-full bg-violet-500/10">
                <LucideIconCn Name="calendar" Size="16" Class="size-4 text-violet-600" />
            </div>
            <div class="flex-1">
                <h3 class="text-sm font-medium">Meeting Scheduler</h3>
                <p class="text-xs text-muted-foreground">AI-powered scheduling assistant</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="text-xs">
                PST
            </BadgeCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto p-4">
            @foreach (var msg in _messages)
            {
                var message = msg;
                <div class="@Cn.Merge("mb-4 flex gap-3", message.Sender == "user" ? "flex-row-reverse" : "")">
                    <AvatarCn Class="size-8 shrink-0">
                        <AvatarFallbackCn Class="@Cn.Merge(message.Sender == "ai" ? "bg-violet-500/10 text-violet-600" : "bg-muted")">
                            @(message.Sender == "ai" ? "AI" : "ME")
                        </AvatarFallbackCn>
                    </AvatarCn>

                    <div class="@Cn.Merge("flex-1 space-y-2", message.Sender == "user" ? "flex flex-col items-end" : "")">
                        <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2", message.Sender == "ai" ? "bg-muted" : "bg-violet-500/10 text-violet-900 dark:text-violet-100")">
                            <p class="text-sm">@message.Content</p>
                        </div>

                        @* Meeting Proposal *@
                        @if (message.Proposal != null)
                        {
                            var proposal = message.Proposal;
                            <div class="mt-2 w-full max-w-sm overflow-hidden rounded-lg border bg-card">
                                <div class="border-b bg-muted/50 px-3 py-2">
                                    <h4 class="font-medium text-sm">@proposal.Title</h4>
                                    <div class="mt-1 flex items-center gap-3 text-xs text-muted-foreground">
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                            @proposal.Duration
                                        </span>
                                        <span class="flex items-center gap-1">
                                            <LucideIconCn Name="users" Size="12" Class="size-3" />
                                            @proposal.Attendees attendees
                                        </span>
                                    </div>
                                </div>

                                <div class="border-b px-3 py-2">
                                    <div class="flex items-center gap-2 text-xs text-muted-foreground">
                                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                        @proposal.Location
                                    </div>
                                </div>

                                <div class="p-3">
                                    <p class="mb-2 text-xs font-medium text-muted-foreground">
                                        Available Times:
                                    </p>
                                    <div class="space-y-1.5">
                                        @foreach (var slotItem in proposal.Slots)
                                        {
                                            var slot = slotItem;
                                            <button type="button"
                                                    disabled="@(!slot.Available)"
                                                    class="@Cn.Merge("flex w-full items-center justify-between rounded-md border px-3 py-2 text-left text-sm transition-colors", slot.Available ? "hover:bg-muted/50" : "cursor-not-allowed opacity-50")">
                                                <span>@slot.Time</span>
                                                @if (slot.Available)
                                                {
                                                    <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-600" />
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="x" Size="16" Class="size-4 text-red-600" />
                                                }
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }

                        @* Confirmation *@
                        @if (message.Confirmation != null)
                        {
                            var conf = message.Confirmation;
                            <div class="mt-2 w-full max-w-sm overflow-hidden rounded-lg border border-emerald-500/20 bg-emerald-500/5">
                                <div class="flex items-center gap-2 border-b border-emerald-500/20 bg-emerald-500/10 px-3 py-2">
                                    <LucideIconCn Name="check" Size="16" Class="size-4 text-emerald-600" />
                                    <p class="text-xs font-medium text-emerald-900 dark:text-emerald-100">
                                        Meeting Confirmed
                                    </p>
                                </div>
                                <div class="space-y-2 p-3">
                                    <h4 class="font-medium text-sm">@conf.Title</h4>
                                    <div class="space-y-1.5 text-xs text-muted-foreground">
                                        <div class="flex items-center gap-2">
                                            <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                            @conf.Date
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                            @conf.Time
                                        </div>
                                        <div class="flex items-center gap-2">
                                            <LucideIconCn Name="video" Size="12" Class="size-3" />
                                            @conf.Location
                                        </div>
                                    </div>
                                    <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="mt-2 h-7 w-full text-xs">
                                        Add to Calendar
                                    </ButtonCn>
                                </div>
                            </div>
                        }

                        <span class="text-xs text-muted-foreground">@message.Timestamp</span>
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t p-4">
            <form class="flex gap-2" @onsubmit="HandleSend">
                <InputCn @bind-Value="_input"
                         Placeholder="Describe your meeting needs..."
                         Class="flex-1" />
                <ButtonCn type="submit" Size="ButtonSize.Sm" Class="shrink-0">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
            <p class="mt-2 text-xs text-muted-foreground">
                Try: "Schedule 1:1 with John" or "Find time next week"
            </p>
        </div>
    </div>
</section>

@code {
    private record TimeSlot(string Time, bool Available);

    private record MeetingProposal(
        string Title,
        string Duration,
        int Attendees,
        string Location,
        TimeSlot[] Slots);

    private record MeetingConfirmation(
        string Title,
        string Date,
        string Time,
        string Location);

    private record Message(
        string Id,
        string Sender,
        string Content,
        string Timestamp,
        MeetingProposal? Proposal = null,
        MeetingConfirmation? Confirmation = null);

    private string _input = "";

    private List<Message> _messages =
    [
        new("1", "ai",
            "Hello! I can help you schedule meetings. What would you like to set up?",
            "2:00 PM"),
        new("2", "user",
            "I need to schedule a product review meeting with the design team",
            "2:01 PM"),
        new("3", "ai",
            "Great! I found availability for a 60-minute meeting with 4 attendees. Here are the available time slots this week:",
            "2:01 PM",
            Proposal: new MeetingProposal(
                "Product Review Meeting",
                "60 min",
                4,
                "Conference Room A",
                [
                    new("Tomorrow, 10:00 AM", true),
                    new("Tomorrow, 2:00 PM", false),
                    new("Wed, Mar 31, 9:00 AM", true),
                    new("Wed, Mar 31, 3:00 PM", true),
                    new("Thu, Apr 1, 11:00 AM", true),
                ])),
        new("4", "user",
            "Let's go with tomorrow at 10 AM",
            "2:02 PM"),
        new("5", "ai",
            "Perfect! I've scheduled your meeting. Calendar invites sent to all attendees.",
            "2:02 PM",
            Confirmation: new MeetingConfirmation(
                "Product Review Meeting",
                "Tomorrow, Mar 31",
                "10:00 AM - 11:00 AM",
                "Conference Room A • Google Meet")),
    ];

    private void HandleSend()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        var newMessage = new Message(
            $"msg-{_messages.Count + 1}",
            "user",
            _input,
            "Just now");

        _messages.Add(newMessage);
        _input = "";
    }
}
