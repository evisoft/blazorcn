@* ============================================================
   Block: chat-onboarding-wizard
   Title: ChatOnboardingWizard
   Description: React step-by-step onboarding wizard chat block for Next.js with progress indicator, option cards, checklist items, profile setup, and welcome screen using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-onboarding-wizard.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="bg-muted text-xs">
                    <LucideIconCn Name="sparkles" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Setup Assistant</span>
                <p class="text-muted-foreground text-xs">Workspace onboarding</p>
            </div>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs tabular-nums">
                Step @_stepCurrent/@_stepTotal
            </BadgeCn>
        </div>

        @* Progress bar *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <ProgressCn Value="@_stepProgress" Class="h-1.5 flex-1" />
            <span class="text-muted-foreground text-xs tabular-nums">@_stepProgress%</span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    <div class="@Cn.Merge("flex", msg.Role == "user" ? "justify-end" : "justify-start")">
                        <div class="@Cn.Merge("max-w-[85%]", msg.Role == "user" ? "rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground" : "rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">
                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }
                            @if (msg.Options != null)
                            {
                                @* OptionCards *@
                                <div class="mt-2 grid grid-cols-2 gap-2">
                                    @foreach (var opt in msg.Options)
                                    {
                                        <div class="@Cn.Merge("rounded-md border p-3 transition-colors", opt.Selected ? "border-primary bg-primary/5" : "border-border bg-card hover:bg-muted/50")">
                                            <div class="mb-1.5 flex items-center gap-2">
                                                <span class="text-muted-foreground">
                                                    <LucideIconCn Name="@opt.Icon" Size="16" Class="size-4" />
                                                </span>
                                                <span class="font-medium text-sm">@opt.Title</span>
                                                @if (opt.Selected)
                                                {
                                                    <LucideIconCn Name="check-circle-2" Size="16" Class="ml-auto size-4 text-primary" />
                                                }
                                            </div>
                                            <p class="text-muted-foreground text-xs">@opt.Description</p>
                                        </div>
                                    }
                                </div>
                            }
                            @if (msg.Checklist != null)
                            {
                                @* Checklist *@
                                var completedCount = msg.Checklist.Count(i => i.Completed);
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2.5 flex items-center justify-between">
                                        <span class="font-medium text-sm">Integrations</span>
                                        <span class="text-muted-foreground text-xs tabular-nums">@completedCount/@msg.Checklist.Length complete</span>
                                    </div>
                                    <div class="space-y-0">
                                        @for (int ci = 0; ci < msg.Checklist.Length; ci++)
                                        {
                                            var checkItem = msg.Checklist[ci];
                                            var isLast = ci == msg.Checklist.Length - 1;
                                            <div class="@Cn.Merge("flex items-center gap-2.5 py-2", isLast ? "" : "border-b")">
                                                @if (checkItem.Completed)
                                                {
                                                    <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 shrink-0 text-emerald-500" />
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="circle" Size="16" Class="size-4 shrink-0 text-muted-foreground/30" />
                                                }
                                                <span class="@Cn.Merge("text-sm", checkItem.Completed ? "text-foreground" : "text-muted-foreground")">@checkItem.Label</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            @if (msg.Summary != null)
                            {
                                @* SummaryCard *@
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2.5 flex items-center gap-1.5">
                                        <LucideIconCn Name="check" Size="14" Class="size-3.5 text-emerald-500" />
                                        <span class="font-medium text-sm">Workspace Summary</span>
                                    </div>
                                    <div class="space-y-2">
                                        @foreach (var sumItem in msg.Summary)
                                        {
                                            <div class="flex items-center justify-between">
                                                <span class="text-muted-foreground text-xs">@sumItem.Label</span>
                                                <span class="text-sm">@sumItem.Value</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                            <span class="@Cn.Merge("mt-1 block text-right text-xs", msg.Role == "user" ? "text-primary-foreground/60" : "text-muted-foreground")">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form class="relative" @onsubmit="HandleSubmit">
                <TextareaCn @bind-Value="_input"
                            Placeholder="@("Type your answer or ask a question...")"
                            Rows="1"
                            Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record OptionCard(string Id, string Title, string Description, string Icon, bool Selected);
    private record ChecklistItem(string Id, string Label, bool Completed);
    private record SummaryItem(string Label, string Value);
    private record ChatMessage(
        string Id,
        string Role,
        string Content,
        string Timestamp,
        OptionCard[]? Options = null,
        ChecklistItem[]? Checklist = null,
        SummaryItem[]? Summary = null);

    private string _input = "";
    private readonly int _stepCurrent = 3;
    private readonly int _stepTotal = 4;
    private readonly int _stepProgress = 75;

    private static readonly ChatMessage[] _messages =
    [
        new("1", "assistant",
            "Welcome to Acme! I'll help you set up your workspace in a few quick steps. First, what best describes your role?",
            "9:00 AM"),
        new("2", "assistant", "", "9:00 AM",
            Options:
            [
                new("dev",    "Developer",       "Building features and integrations",      "code",     true),
                new("design", "Designer",         "Creating layouts and visual systems",     "palette",  false),
                new("pm",     "Product Manager",  "Planning roadmaps and tracking metrics",  "bar-chart-3", false),
                new("lead",   "Team Lead",        "Managing team and reviewing work",        "users",    false),
            ]),
        new("3", "user", "Developer", "9:01 AM"),
        new("4", "assistant",
            "Great choice! I've set up developer-focused defaults. Next, let's configure your workspace. Check off the integrations you want to enable:",
            "9:01 AM"),
        new("5", "assistant", "", "9:02 AM",
            Checklist:
            [
                new("github",    "Connect GitHub repository",        true),
                new("slack",     "Enable Slack notifications",       true),
                new("ci",        "Set up CI/CD pipeline",            true),
                new("sentry",    "Connect error tracking (Sentry)",  false),
                new("analytics", "Enable usage analytics",           false),
            ]),
        new("6", "user",
            "I've connected GitHub, Slack, and CI/CD. I'll set up Sentry and analytics later.",
            "9:04 AM"),
        new("7", "assistant",
            "Perfect — 3 of 5 integrations enabled. You can always add the rest from Settings. Here's a summary of your workspace so far:",
            "9:05 AM"),
        new("8", "assistant", "", "9:05 AM",
            Summary:
            [
                new("Role",           "Developer"),
                new("Workspace",      "Acme Engineering"),
                new("Integrations",   "3 of 5 enabled"),
                new("Default view",   "Code & PRs"),
                new("Notifications",  "Slack + Email"),
            ]),
        new("9", "assistant",
            "One last step — would you like to invite your team? You can share a link or enter email addresses. Or skip this for now and invite them later.",
            "9:06 AM"),
        new("10", "user",
            "I'll invite them later. Let me explore the dashboard first.",
            "9:07 AM"),
        new("11", "assistant",
            "You're all set! Your workspace is ready with developer defaults, 3 integrations active, and Slack notifications enabled. Head to the dashboard to start building.",
            "9:07 AM"),
    ];

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
