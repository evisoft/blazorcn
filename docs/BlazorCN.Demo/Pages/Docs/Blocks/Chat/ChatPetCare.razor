@* ============================================================
   Block: chat-pet-care
   Title: ChatPetCare
   Description: React pet care advice chat block for Next.js with pet profile cards, vet recommendation listings, symptom checker prompts, medication reminders, and care tip messages using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-pet-care.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Pet profile header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="bg-muted text-xs">
                    <LucideIconCn Name="paw-print" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Pet Care Advisor</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                        @_pet.Name
                    </BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">
                    @_pet.Breed · @_pet.Age · @_pet.Weight
                </span>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    <div class="@(msg.Role == "owner" ? "flex justify-end" : "flex justify-start")">
                        <div class="@(msg.Role == "owner"
                            ? "max-w-[85%] rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground"
                            : "max-w-[85%] rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">
                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }
                            @if (msg.VetClinic != null)
                            {
                                var clinic = msg.VetClinic;
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-1.5 flex items-center justify-between">
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="heart-pulse" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span class="font-medium text-sm">@clinic.Name</span>
                                        </div>
                                        <div class="flex items-center gap-1">
                                            <LucideIconCn Name="star" Size="12" Class="size-3 fill-amber-400 text-amber-400" />
                                            <span class="font-medium text-xs tabular-nums">@clinic.Rating</span>
                                            <span class="text-muted-foreground text-xs">(@clinic.Reviews)</span>
                                        </div>
                                    </div>
                                    <div class="mb-2 flex items-center gap-1.5 text-muted-foreground text-xs">
                                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                        @clinic.Distance away
                                    </div>
                                    <div class="mb-2.5 flex flex-wrap gap-1">
                                        @foreach (var spec in clinic.Specialties)
                                        {
                                            <span class="rounded-full bg-muted/50 px-2 py-0.5 text-muted-foreground text-xs">@spec</span>
                                        }
                                    </div>
                                    <div class="flex items-center justify-between border-t pt-2.5">
                                        <div>
                                            <span class="text-muted-foreground text-xs">Next available</span>
                                            <p class="font-medium text-sm">@clinic.NextAvailable</p>
                                        </div>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                            Book visit
                                        </ButtonCn>
                                    </div>
                                </div>
                            }
                            @if (msg.CareTip != null)
                            {
                                var tip = msg.CareTip;
                                var tipId = msg.Id;
                                var saved = _savedTips.Contains(tipId);
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2 flex items-center justify-between">
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="paw-print" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span class="font-medium text-sm">@tip.Title</span>
                                        </div>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">
                                            @tip.Category
                                        </BadgeCn>
                                    </div>
                                    <p class="mb-2.5 text-muted-foreground text-sm leading-relaxed">@tip.Description</p>
                                    <div class="flex justify-end border-t pt-2.5">
                                        <ButtonCn
                                            Variant="ButtonVariant.Ghost"
                                            Size="ButtonSize.Sm"
                                            Class="h-7 gap-1.5 text-xs"
                                            OnClick="@(() => ToggleSaved(tipId))">
                                            <LucideIconCn Name="bookmark" Size="12" Class="@($"size-3{(saved ? " fill-current" : "")}")" />
                                            @(saved ? "Saved" : "Save tip")
                                        </ButtonCn>
                                    </div>
                                </div>
                            }
                            <span class="@(msg.Role == "owner"
                                ? "mt-1 block text-right text-xs text-primary-foreground/60"
                                : "mt-1 block text-right text-xs text-muted-foreground")">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative">
                <TextareaCn
                    @bind-Value="_input"
                    Placeholder="Ask about your pet..."
                    Rows="1"
                    Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn
                    type="submit"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                    OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private readonly HashSet<string> _savedTips = [];

    private record PetProfile(string Name, string Species, string Breed, string Age, string Weight);

    private record VetClinic(
        string Name,
        double Rating,
        int Reviews,
        string Distance,
        string[] Specialties,
        string NextAvailable);

    private record CareTip(string Title, string Category, string Description);

    private record Message(
        string Id,
        string Role,
        string Content,
        string Timestamp,
        VetClinic? VetClinic = null,
        CareTip? CareTip = null);

    private readonly PetProfile _pet = new("Luna", "Dog", "Golden Retriever", "4 years", "65 lbs");

    private readonly Message[] _messages =
    [
        new("1", "owner",
            "Luna has been scratching her ears a lot this week and shaking her head. I checked and the inside of her ears look a bit red. Should I be concerned?",
            "2:00 PM"),
        new("2", "advisor",
            "Ear scratching and redness in Golden Retrievers is common and often points to an ear infection or allergies. Since Luna's ears look red inside, I'd recommend a vet visit within the next few days. In the meantime, here's what you can do.",
            "2:01 PM"),
        new("3", "advisor", "", "2:02 PM",
            CareTip: new(
                "Ear Care for Floppy-Eared Breeds",
                "Preventive Care",
                "Clean ears weekly with a vet-approved solution. After baths or swimming, dry ears thoroughly with a soft cloth. Avoid inserting cotton swabs into the ear canal. If you notice a brown or yellowish discharge, or a yeasty smell, schedule a vet appointment promptly.")),
        new("4", "owner",
            "That's helpful. I think she went swimming at the lake last weekend which might have caused it. Can you recommend a vet nearby that's good with ear issues?",
            "2:04 PM"),
        new("5", "advisor",
            "Swimming is a very common trigger for ear infections in retrievers. Here's a highly-rated clinic near you with a dermatology specialty.",
            "2:05 PM"),
        new("6", "advisor", "", "2:05 PM",
            VetClinic: new(
                "Riverside Animal Hospital",
                4.8,
                412,
                "2.3 mi",
                ["Dermatology", "Internal Medicine", "Surgery"],
                "Tomorrow, 10:30 AM")),
        new("7", "owner",
            "Great rating. Is there anything I should tell the vet when I go in?",
            "2:07 PM"),
        new("8", "advisor",
            "Mention the lake swimming last weekend, when the scratching started, and that you noticed redness. Also note if there's any discharge or odor. The vet will likely do an otoscopic exam and possibly a cytology swab to identify the type of infection.",
            "2:08 PM"),
        new("9", "advisor", "", "2:09 PM",
            CareTip: new(
                "Post-Swimming Ear Prevention",
                "Activity Care",
                "After every swim, gently dry Luna's ears with a towel and apply a vet-recommended drying solution. Consider using a snood or ear cover during water activities. If Luna swims frequently, schedule ear checks every 2-3 months to catch infections early.")),
    ];

    private void ToggleSaved(string tipId)
    {
        if (!_savedTips.Add(tipId))
            _savedTips.Remove(tipId);
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
