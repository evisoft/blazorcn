@* ============================================================
   Block: chat-bubble-style
   Title: ChatBubbleStyle
   Description: React classic bubble chat interface for Next.js with rounded bubble tails, message grouping, inline timestamps, delivery status, and avatar collapse using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-bubble-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="sticky top-0 z-10 flex items-center gap-2 border-b bg-card p-2">
            <AvatarCn Class="size-8 rounded-full">
                <AvatarFallbackCn Class="text-xs">MC</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Mia Chen</span>
                <p class="text-xs text-muted-foreground">Online</p>
            </div>
        </div>

        @* Messages -- bubble layout *@
        <div class="flex flex-1 flex-col overflow-y-auto py-2">
            @* Date separator *@
            <div class="my-4 flex items-center gap-2 px-2">
                <div class="h-px flex-1 bg-border"></div>
                <span class="min-w-max text-xs font-semibold text-muted-foreground">Today</span>
                <div class="h-px flex-1 bg-border"></div>
            </div>

            @for (int i = 0; i < _messages.Length; i++)
            {
                var msg = _messages[i];
                var idx = i;
                var isMe = msg.Sender == "me";
                var prevMsg = idx > 0 ? _messages[idx - 1] : null;
                var nextMsg = idx < _messages.Length - 1 ? _messages[idx + 1] : null;
                var isFirstInGroup = prevMsg == null || prevMsg.Sender != msg.Sender;
                var isLastInGroup = nextMsg == null || nextMsg.Sender != msg.Sender;

                var rowClass = Cn.Merge(
                    "flex items-end gap-2 px-2",
                    isMe ? "flex-row-reverse" : "flex-row",
                    isFirstInGroup ? "mt-3" : "mt-0.5"
                );

                var bubbleClass = Cn.Merge(
                    "relative max-w-[75%] px-3 py-2 text-sm leading-relaxed",
                    isMe ? "bg-foreground text-background" : "bg-muted text-foreground",
                    isMe
                        ? (isLastInGroup ? "rounded-2xl rounded-br-sm" : "rounded-2xl")
                        : (isLastInGroup ? "rounded-2xl rounded-bl-sm" : "rounded-2xl")
                );

                var timestampClass = Cn.Merge(
                    "ml-3 inline-flex items-center gap-1 align-bottom text-[10px] leading-none",
                    isMe
                        ? "float-right mt-1 text-background/50"
                        : "float-right mt-1 text-muted-foreground/60"
                );

                <div class="@rowClass">
                    @* Avatar -- only on last message of received group *@
                    <div class="w-10 shrink-0 flex justify-center">
                        @if (!isMe && isLastInGroup)
                        {
                            <AvatarCn Class="size-8 rounded-full">
                                <AvatarFallbackCn Class="text-xs">@GetInitials(msg.SenderName)</AvatarFallbackCn>
                            </AvatarCn>
                        }
                    </div>

                    @* Bubble with inline timestamp *@
                    <div class="@bubbleClass">
                        <span>@msg.Content</span>
                        <span class="@timestampClass">
                            @msg.Timestamp
                            @if (isMe)
                            {
                                @if (msg.Status == "sent")
                                {
                                    <LucideIconCn Name="check" Size="12" Class="size-3 text-muted-foreground/50" />
                                }
                                else if (msg.Status == "delivered")
                                {
                                    <LucideIconCn Name="check-check" Size="12" Class="size-3 text-muted-foreground/50" />
                                }
                                else if (msg.Status == "read")
                                {
                                    <LucideIconCn Name="check-check" Size="12" Class="size-3 text-blue-500" />
                                }
                            }
                        </span>
                    </div>
                </div>
            }
        </div>

        @* Toolbar *@
        <div class="sticky bottom-0 bg-card p-2 pt-0">
            <form @onsubmit="HandleSubmit" class="flex flex-wrap items-start gap-x-2 rounded-md border px-3 py-2">
                <div class="order-1 flex h-10 items-center gap-1.5">
                    <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 text-muted-foreground">
                        <LucideIconCn Name="paperclip" Size="16" Class="size-4" />
                    </ButtonCn>
                    <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 text-muted-foreground">
                        <LucideIconCn Name="smile" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
                <div class="order-2 grid min-w-0 flex-1">
                    <textarea @bind="_input"
                              @bind:event="oninput"
                              placeholder="Type a message..."
                              rows="1"
                              class="h-fit min-h-10 resize-none border-none bg-transparent px-1 text-sm shadow-none outline-none placeholder:text-muted-foreground"></textarea>
                </div>
                <div class="order-3 flex h-10 items-center gap-1.5">
                    <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                              Disabled="@string.IsNullOrWhiteSpace(_input)"
                              Class="size-8 text-muted-foreground">
                        <LucideIconCn Name="send" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </form>
        </div>
    </div>
</section>

@code {
    private record Message(string Id, string Content, string Sender, string SenderName, string Timestamp, string? Status = null);

    private string _input = "";

    private static readonly Message[] _messages =
    [
        new("1", "Hi! I just pushed the new landing page design to staging.", "them", "Mia Chen", "10:32 AM"),
        new("2", "The hero section is using the new motion primitives we discussed.", "them", "Mia Chen", "10:32 AM"),
        new("3", "Looking now. The hero section looks great.", "me", "You", "10:33 AM", "read"),
        new("4", "Can you check the pricing cards on mobile? I'm worried about the overflow on smaller screens.", "them", "Mia Chen", "10:34 AM"),
        new("5", "Yeah, the third card overflows on iPhone SE. Maybe switch to a vertical stack below 640px?", "me", "You", "10:36 AM", "read"),
        new("6", "Good catch. I'll fix that.", "me", "You", "10:36 AM", "read"),
        new("7", "I'll wrap them in flex-col for small screens. Should have that fixed in 20 minutes.", "them", "Mia Chen", "10:37 AM"),
        new("8", "Also, the CTA button color doesn't match Figma. Should be primary blue, not indigo.", "them", "Mia Chen", "10:37 AM"),
        new("9", "Ah right, I was using old design tokens. Updating now.", "them", "Mia Chen", "10:39 AM"),
        new("10", "Perfect. Ping me once staging is updated and I'll do a final pass.", "me", "You", "10:40 AM", "delivered"),
    ];

    private static string GetInitials(string name)
    {
        var parts = name.Split(' ');
        var initials = string.Concat(parts.Select(p => p.Length > 0 ? p[0].ToString() : ""));
        return initials.ToUpperInvariant()[..Math.Min(2, initials.Length)];
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
