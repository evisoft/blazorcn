@* ============================================================
   Block: chat-trivia-night
   Title: ChatTriviaNight
   Description: A trivia night chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring question rounds, team scores, and real-time leaderboard
   Source: original/blocks/chat/chat-trivia-night.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center justify-between border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-8 items-center justify-center rounded-full bg-purple-500/10">
                    <LucideIconCn Name="trophy" Size="16" Class="size-4 text-purple-600" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Trivia Night</h2>
                    <p class="text-xs text-muted-foreground">Question 1 of 10 • Science Round</p>
                </div>
            </div>
            <BadgeCn Variant="BadgeVariant.Outline" Class="h-6 gap-1 text-xs">
                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                2:45
            </BadgeCn>
        </div>

        @* Leaderboard *@
        <div class="border-b p-4">
            <div class="mb-2 flex items-center justify-between">
                <span class="text-xs font-medium text-muted-foreground">Leaderboard</span>
                <span class="text-xs text-muted-foreground">@_teams.Length teams</span>
            </div>
            <div class="space-y-2">
                @foreach (var team in _sortedTeams.Take(3))
                {
                    var t = team;
                    var rank = System.Array.IndexOf(_sortedTeams, t) + 1;
                    <div class="flex items-center gap-3">
                        <div class="flex size-6 shrink-0 items-center justify-center rounded-full bg-muted text-xs font-medium">
                            @rank
                        </div>
                        <AvatarCn Class="size-6">
                            <AvatarImageCn Src="@t.Avatar" />
                            <AvatarFallbackCn Class="@Cn.Merge("text-white text-xs", t.Color)">@t.Name.Substring(0, 2)</AvatarFallbackCn>
                        </AvatarCn>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-xs font-medium">@t.Name</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <ProgressCn Value="@((t.Score / 300.0) * 100)" Class="h-1.5 w-16" />
                            <span class="w-12 text-right font-semibold tabular-nums text-sm">@t.Score</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto p-4">
            <div class="space-y-4">
                @foreach (var message in _messages)
                {
                    var msg = message;
                    if (msg.Type == "question" && msg.Question != null)
                    {
                        var q = msg.Question;
                        <CardCn Class="border-purple-200 bg-purple-500/5 p-4">
                            <div class="mb-3 flex items-start justify-between gap-2">
                                <div class="flex-1">
                                    <BadgeCn Variant="BadgeVariant.Outline" Class="mb-2 h-5 text-[10px]">@q.Category</BadgeCn>
                                    <p class="text-sm font-medium leading-relaxed">@q.Question</p>
                                </div>
                                <LucideIconCn Name="sparkles" Size="16" Class="size-4 shrink-0 text-purple-600" />
                            </div>
                            <div class="space-y-2">
                                @for (var i = 0; i < q.Options.Length; i++)
                                {
                                    var idx = i;
                                    var option = q.Options[idx];
                                    var letter = ((char)('A' + idx)).ToString();
                                    <button
                                        type="button"
                                        @onclick="@(() => HandleSelectOption(idx))"
                                        disabled="@_hasAnswered"
                                        class="@Cn.Merge("flex w-full items-center gap-3 rounded-lg border px-3 py-2.5 text-left text-sm transition-all", _selectedOption == idx ? "border-purple-500 bg-purple-500/10" : "border-border hover:border-purple-200 hover:bg-muted/50", _hasAnswered ? "cursor-not-allowed opacity-60" : "")">
                                        <div class="@Cn.Merge("flex size-5 shrink-0 items-center justify-center rounded-full border text-[10px] font-medium", _selectedOption == idx ? "border-purple-500 bg-purple-500 text-white" : "border-muted-foreground/30")">
                                            @letter
                                        </div>
                                        <span class="flex-1">@option</span>
                                        @if (_hasAnswered && idx == q.CorrectAnswer)
                                        {
                                            <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-600" />
                                        }
                                        @if (_hasAnswered && _selectedOption == idx && idx != q.CorrectAnswer)
                                        {
                                            <LucideIconCn Name="x-circle" Size="16" Class="size-4 text-red-600" />
                                        }
                                    </button>
                                }
                            </div>
                            <p class="mt-2 text-xs text-muted-foreground">@msg.Timestamp</p>
                        </CardCn>
                    }
                    else if (msg.Type == "result")
                    {
                        <div class="@Cn.Merge("rounded-lg border px-3 py-2", msg.IsCorrect == true ? "border-emerald-200 bg-emerald-500/10" : "border-red-200 bg-red-500/10")">
                            <div class="flex items-start gap-2">
                                @if (msg.IsCorrect == true)
                                {
                                    <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 shrink-0 text-emerald-600" />
                                }
                                else
                                {
                                    <LucideIconCn Name="x-circle" Size="16" Class="size-4 shrink-0 text-red-600" />
                                }
                                <div class="flex-1">
                                    <p class="@Cn.Merge("text-sm", msg.IsCorrect == true ? "text-emerald-900" : "text-red-900")">@msg.Content</p>
                                    <p class="mt-1 text-[10px] text-muted-foreground">@msg.Timestamp</p>
                                </div>
                            </div>
                        </div>
                    }
                    else if (msg.Type == "chat")
                    {
                        <div class="flex justify-center">
                            <div class="rounded-full bg-muted/50 px-3 py-1">
                                <p class="text-xs text-muted-foreground">@msg.Content</p>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* Submit Answer *@
        <div class="border-t p-4">
            <div class="flex items-center gap-2">
                <div class="flex size-8 items-center justify-center rounded-full bg-muted">
                    <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                </div>
                <div class="flex-1">
                    <p class="text-xs font-medium">Your Team</p>
                    <p class="text-[10px] text-muted-foreground">
                        @(_selectedOption != null
                            ? $"Selected: Option {(char)('A' + _selectedOption.Value)}"
                            : "Select your answer")
                    </p>
                </div>
                <ButtonCn @onclick="HandleSubmitAnswer" Disabled="@(_selectedOption == null || _hasAnswered)" Size="ButtonSize.Sm" Class="gap-1.5">
                    @(_hasAnswered ? "Submitted" : "Submit Answer")
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private record Team(string Name, int Score, string Color, string Avatar);

    private record TriviaQuestion(int Id, string Question, string[] Options, int CorrectAnswer, string Category);

    private record Message(
        string Id,
        string Type,
        string Timestamp,
        string? Content = null,
        TriviaQuestion? Question = null,
        int? SelectedOption = null,
        bool? IsCorrect = null,
        string? Team = null);

    private static readonly Team[] _teams =
    [
        new("Brain Busters", 250, "bg-blue-500", "/avatars/team1.jpg"),
        new("Quiz Wizards", 200, "bg-purple-500", "/avatars/team2.jpg"),
        new("Trivia Titans", 180, "bg-emerald-500", "/avatars/team3.jpg"),
        new("Know-It-Alls", 150, "bg-amber-500", "/avatars/team4.jpg"),
    ];

    private static readonly TriviaQuestion[] _triviaQuestions =
    [
        new(1, "What is the largest planet in our solar system?",
            ["Mars", "Jupiter", "Saturn", "Neptune"], 1, "Science"),
        new(2, "In which year did World War II end?",
            ["1943", "1944", "1945", "1946"], 2, "History"),
        new(3, "Who painted the Mona Lisa?",
            ["Vincent van Gogh", "Pablo Picasso", "Leonardo da Vinci", "Michelangelo"], 2, "Art"),
    ];

    private Team[] _sortedTeams = _teams.OrderByDescending(t => t.Score).ToArray();

    private List<Message> _messages =
    [
        new("1", "chat", "8:00 PM", Content: "Welcome to Trivia Night! Get ready for Round 1."),
        new("2", "question", "8:01 PM",
            Question: new TriviaQuestion(1, "What is the largest planet in our solar system?",
                ["Mars", "Jupiter", "Saturn", "Neptune"], 1, "Science")),
    ];

    private int? _selectedOption = null;
    private bool _hasAnswered = false;

    private void HandleSelectOption(int index)
    {
        if (_hasAnswered) return;
        _selectedOption = index;
    }

    private void HandleSubmitAnswer()
    {
        if (_selectedOption == null || _hasAnswered) return;

        var currentQuestion = _triviaQuestions[0];
        var isCorrect = _selectedOption.Value == currentQuestion.CorrectAnswer;
        _hasAnswered = true;

        var answerMessage = new Message(
            $"{System.DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}",
            "answer",
            "Just now",
            Team: "Your Team",
            SelectedOption: _selectedOption.Value);

        var resultMessage = new Message(
            $"{System.DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() + 1}",
            "result",
            "Just now",
            IsCorrect: isCorrect,
            Content: isCorrect
                ? $"Correct! The answer is: {currentQuestion.Options[currentQuestion.CorrectAnswer]}"
                : $"Incorrect. The correct answer was: {currentQuestion.Options[currentQuestion.CorrectAnswer]}");

        _messages.Add(answerMessage);
        _messages.Add(resultMessage);
    }
}
