            Content = "Just deployed the new notification system to production!",
            Timestamp = "2:10 PM",
            Reactions =
            [
                new Reaction { Emoji = "\U0001F680", Count = 3, Reacted = false },
                new Reaction { Emoji = "\U0001F525", Count = 2, Reacted = true },
