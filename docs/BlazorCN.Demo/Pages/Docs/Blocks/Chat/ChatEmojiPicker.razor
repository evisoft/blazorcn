    ];

    private string _input = "";
    private bool _emojiOpen = false;
    private string _activeCategory = "smileys";
    private string _emojiSearch = "";
    private int _skinTone = 0;
    private EmojiItem? _hoveredEmoji = null;
    private List<EmojiItem> _recentEmojis =
    [
        new("\U0001F44D", "Thumbs Up", ":thumbsup:"),
        new("\U0001F602", "Joy", ":joy:"),
        new("❤️", "Red Heart", ":heart:"),
        new("\U0001F525", "Fire", ":fire:"),
        new("\U0001F680", "Rocket", ":rocket:"),
    ];
    private string? _reactionPopoverId = null;
    private FloatingReactionState? _floatingReaction = null;

    private bool CanSubmit => !string.IsNullOrWhiteSpace(_input);

    private bool IsNewGroup(int idx)
    {
        if (idx == 0) return true;
        return _messages[idx].Sender != _messages[idx - 1].Sender;
    }

    private EmojiCategory GetCurrentCategory()
    {
        foreach (var c in _emojiCategories)
            if (c.Id == _activeCategory) return c;
        return _emojiCategories[0];
    }

    private EmojiItem[] GetSearchResults()
    {
        var term = _emojiSearch.Trim().ToLowerInvariant();
        var results = new System.Collections.Generic.List<EmojiItem>();
        foreach (var cat in _emojiCategories)
            foreach (var e in cat.Emojis)
                if (e.Name.ToLowerInvariant().Contains(term))
                    results.Add(e);
        return results.ToArray();
    }

    private void InsertEmoji(EmojiItem emoji)
    {
        _input += emoji.Char;
        var filtered = _recentEmojis.FindAll(e => e.Char != emoji.Char);
        filtered.Insert(0, emoji);
        _recentEmojis = filtered.Count > 8 ? filtered.GetRange(0, 8) : filtered;
    }

    private void ToggleReaction(string messageId, string emoji)
    {
        var msg = _messages.Find(m => m.Id == messageId);
        if (msg == null) return;

        var existing = msg.Reactions.Find(r => r.Emoji == emoji);
        if (existing != null)
        {
            var newReacted = !existing.Reacted;
            var newCount = newReacted ? existing.Count + 1 : existing.Count - 1;
            if (newCount <= 0)
                msg.Reactions.Remove(existing);
            else
            {
                existing.Reacted = newReacted;
                existing.Count = newCount;
            }
        }
        else
        {
            msg.Reactions.Add(new Reaction { Emoji = emoji, Count = 1, Reacted = true });
        }

        _floatingReaction = new FloatingReactionState { Id = messageId, Emoji = emoji };
        _reactionPopoverId = null;
    }

    private void HandleSubmit()
    {
        if (!CanSubmit) return;
        _input = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            HandleSubmit();
        }
    }
}
