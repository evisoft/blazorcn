        },
        new() {
            Id = "m2", Sender = "Mia Chang", Initials = "MC",
            Content = "Nice work Jake! Did you test the email fallback? Last time it silently failed.",
            Timestamp = "2:12 PM",
            Reactions = [ new Reaction { Emoji = "\U0001F44D", Count = 1, Reacted = false } ]
        },
        new() {
            Id = "m3", Sender = "Jake Wilson", Initials = "JW",
            Content = "Yes, learned my lesson. Email, SMS, and push all verified. Even added retry logic with exponential backoff this time.",
            Timestamp = "2:14 PM",
            Reactions = []
        },
        new() {
            Id = "m4", Sender = "Priya Patel", Initials = "PP",
            Content = "The retry logic is clutch. We had a similar issue last quarter where transient failures caused missed notifications for 2 hours.",
            Timestamp = "2:18 PM",
            Reactions = [ new Reaction { Emoji = "\U0001F4AF", Count = 2, Reacted = true } ]
        },
        new() {
            Id = "m5", Sender = "Mia Chang", Initials = "MC",
            Content = "Can we get a quick rundown of the retry intervals? Want to make sure it matches our SLA requirements.",
            Timestamp = "2:20 PM",
            Reactions = []
        },
        new() {
            Id = "m6", Sender = "Jake Wilson", Initials = "JW",
            Content = "Sure. First retry at 1s, then 5s, 30s, 2min, 10min. Max 5 attempts. After that it hits the dead letter queue and alerts on-call.",
