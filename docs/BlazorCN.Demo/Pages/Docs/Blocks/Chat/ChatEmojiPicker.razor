@* ============================================================
   Block: chat-emoji-picker
   Title: ChatEmojiPicker
   Description: React chat block with a rich emoji picker panel for Next.js featuring categorized emoji grid with icon tabs, search filtering, recently used row, skin tone selector, emoji preview with name and shortcode, and floating emoji reactions using TypeScript, shadcn/ui, Tailwind CSS, and Framer Motion
   Source: original/blocks/chat/chat-emoji-picker.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="smile" Size="16" Class="size-4 text-muted-foreground" />
            <span class="font-medium text-sm">Team Chat</span>
            <span class="text-muted-foreground text-xs">Notifications</span>
            <span class="ml-auto text-muted-foreground text-xs tabular-nums">
                @_messages.Count messages
            </span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto py-2" tabindex="0" role="group" aria-label="Messages">
            @for (var idx = 0; idx < _messages.Count; idx++)
            {
                var msg = _messages[idx];
                var grouped = !IsNewGroup(idx);
                var msgId = msg.Id;

                <div class="@Cn.Merge("group relative flex gap-2 px-4 transition-colors hover:bg-accent", grouped ? "py-0.5" : "mt-3 first:mt-0")">

                    @* Avatar column *@
                    <div class="w-8 shrink-0 pt-0.5">
                        @if (!grouped)
                        {
                            <AvatarCn Class="size-8">
                                <AvatarFallbackCn Class="text-xs font-medium">@msg.Initials</AvatarFallbackCn>
                            </AvatarCn>
                        }
                        @if (grouped)
                        {
                            <span class="hidden text-[10px] text-muted-foreground group-hover:inline">
                                @msg.Timestamp
                            </span>
                        }
                    </div>

                    @* Body *@
                    <div class="min-w-0 flex-1">
                        @if (!grouped)
                        {
                            <div class="flex items-baseline gap-2">
                                <span class="font-medium text-sm">@msg.Sender</span>
                                <span class="text-muted-foreground text-xs">@msg.Timestamp</span>

                                @* Quick reaction on hover *@
                                <div class="ml-auto opacity-0 transition-opacity group-hover:opacity-100">
                                    <PopoverCn Open="@(_reactionPopoverId == msgId)" OpenChanged="@(open => _reactionPopoverId = open ? msgId : null)">
                                        <PopoverTriggerCn aria-label="Add reaction" Class="size-6 text-muted-foreground inline-flex items-center justify-center rounded-md hover:text-foreground">
                                            <LucideIconCn Name="smile" Size="14" Class="size-3.5" />
                                        </PopoverTriggerCn>
                                        <PopoverContentCn Side="FloatingSide.Top" Align="FloatingAlign.End" Class="w-auto p-1">
                                            <div class="flex items-center gap-0.5">
                                                @foreach (var qr in _quickReactions)
                                                {
                                                    var emoji = qr;
                                                    var capturedId = msgId;
                                                    <button type="button"
                                                            @onclick="@(() => ToggleReaction(capturedId, emoji))"
                                                            class="flex size-8 items-center justify-center rounded-md text-lg transition-colors hover:bg-muted/50">
                                                        @emoji
                                                    </button>
                                                }
                                            </div>
                                        </PopoverContentCn>
                                    </PopoverCn>
                                </div>
                            </div>
                        }
                        <div class="text-sm leading-relaxed">@msg.Content</div>

                        @* Reactions *@
                        @if (msg.Reactions.Count > 0)
                        {
                            <div class="mt-1.5 flex flex-wrap items-center gap-1">
                                @foreach (var reaction in msg.Reactions)
                                {
                                    var r = reaction;
                                    var capturedId2 = msgId;
                                    <button type="button"
                                            @onclick="@(() => ToggleReaction(capturedId2, r.Emoji))"
                                            class="@Cn.Merge("flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs transition-colors hover:bg-muted/50", r.Reacted ? "border-blue-500/30 bg-blue-500/10" : "")">
                                        <span>@r.Emoji</span>
                                        <span class="tabular-nums text-muted-foreground">@r.Count</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    @* Floating reaction animation (CSS-only, no Framer Motion) *@
                    @if (_floatingReaction != null && _floatingReaction.Id == msgId)
                    {
                        <span class="pointer-events-none absolute right-8 bottom-4 text-xl animate-float-up">
                            @_floatingReaction.Emoji
                        </span>
                    }

                </div>
            }
        </div>

        @* Toolbar *@
        <div class="border-t px-4 py-3">
            <div class="flex items-end gap-2">
                @* Emoji picker popover *@
                <PopoverCn Open="@_emojiOpen" OpenChanged="@(v => _emojiOpen = v)">
                    <PopoverTriggerCn aria-label="Insert emoji" Class="size-7 shrink-0 text-muted-foreground inline-flex items-center justify-center rounded-md hover:text-foreground">
                        <LucideIconCn Name="smile" Size="16" Class="size-4" />
                    </PopoverTriggerCn>
                    <PopoverContentCn Side="FloatingSide.Top" Align="FloatingAlign.Start" Class="w-80 p-0">

                        @* Picker header: search + skin tones *@
                        <div class="flex items-center gap-2 border-b px-3 py-2">
                            <LucideIconCn Name="search" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
                            <input value="@_emojiSearch"
                                   @oninput="@((e) => _emojiSearch = e.Value?.ToString() ?? "")"
                                   placeholder="Search emoji..."
                                   class="h-6 flex-1 border-0 bg-transparent px-0 text-xs shadow-none outline-none focus-visible:ring-0 placeholder:text-muted-foreground/70" aria-label="Search emoji..." />
                            <div class="flex items-center gap-0.5">
                                @for (var ti = 0; ti < _skinTones.Length; ti++)
                                {
                                    var toneIdx = ti;
                                    var tone = _skinTones[ti];
                                    <button type="button"
                                            @onclick="@(() => _skinTone = toneIdx)"
                                            aria-label="@($"Skin tone {tone.Id}")"
                                            class="@Cn.Merge("size-4 rounded-full transition-all", tone.Color, _skinTone == toneIdx ? "ring-2 ring-foreground ring-offset-1 ring-offset-background" : "opacity-60 hover:opacity-100")">
                                    </button>
                                }
                            </div>
                        </div>

                        @* Recently used *@
                        @if (string.IsNullOrWhiteSpace(_emojiSearch) && _recentEmojis.Count > 0)
                        {
                            <div class="border-b px-3 py-2">
                                <span class="mb-1 block font-medium text-[10px] text-muted-foreground uppercase tracking-wider">
                                    Recently Used
                                </span>
                                <div class="flex gap-0.5">
                                    @foreach (var emoji in _recentEmojis)
                                    {
                                        var e = emoji;
                                        <button type="button"
                                                @onclick="@(() => InsertEmoji(e))"
                                                @onmouseenter="@(() => _hoveredEmoji = e)"
                                                @onmouseleave="@(() => _hoveredEmoji = null)"
                                                class="flex size-7 items-center justify-center rounded-md text-base transition-colors hover:bg-muted/50">
                                            @e.Char
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        @* Emoji grid *@
                        <div class="h-48 overflow-y-auto px-3 py-2" tabindex="0" role="group" aria-label="Emoji list">
                            @if (!string.IsNullOrWhiteSpace(_emojiSearch))
                            {
                                var searchResults = GetSearchResults();
                                <span class="mb-1 block font-medium text-[10px] text-muted-foreground uppercase tracking-wider">
                                    Search Results
                                </span>
                                @if (searchResults.Length == 0)
                                {
                                    <p class="py-4 text-center text-muted-foreground text-xs">No emoji found</p>
                                }
                                else
                                {
                                    <div class="grid grid-cols-8 gap-0.5">
                                        @foreach (var emoji in searchResults)
                                        {
                                            var e = emoji;
                                            <button type="button"
                                                    @onclick="@(() => InsertEmoji(e))"
                                                    @onmouseenter="@(() => _hoveredEmoji = e)"
                                                    @onmouseleave="@(() => _hoveredEmoji = null)"
                                                    class="flex size-7 items-center justify-center rounded-md text-base transition-colors hover:bg-muted/50">
                                                @e.Char
                                            </button>
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                var currentCategory = GetCurrentCategory();
                                <span class="mb-1 block font-medium text-[10px] text-muted-foreground uppercase tracking-wider">
                                    @currentCategory.Label
                                </span>
                                <div class="grid grid-cols-8 gap-0.5">
                                    @foreach (var emoji in currentCategory.Emojis)
                                    {
                                        var e = emoji;
                                        <button type="button"
                                                @onclick="@(() => InsertEmoji(e))"
                                                @onmouseenter="@(() => _hoveredEmoji = e)"
                                                @onmouseleave="@(() => _hoveredEmoji = null)"
                                                class="flex size-7 items-center justify-center rounded-md text-base transition-colors hover:bg-muted/50">
                                            @e.Char
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        @* Preview bar *@
                        <div class="flex items-center gap-2 border-t px-3 py-2">
                            @if (_hoveredEmoji != null)
                            {
                                <span class="text-xl">@_hoveredEmoji.Char</span>
                                <div class="min-w-0 flex-1">
                                    <span class="block truncate font-medium text-xs">@_hoveredEmoji.Name</span>
                                    <span class="block truncate font-mono text-[10px] text-muted-foreground">@_hoveredEmoji.Shortcode</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted-foreground text-xs">Hover over an emoji to preview</span>
                            }
                        </div>

                        @* Category tabs at bottom *@
                        <div class="flex items-center justify-between border-t px-2 py-1">
                            @foreach (var cat in _emojiCategories)
                            {
                                var c = cat;
                                <button type="button"
                                        @onclick="@(() => { _activeCategory = c.Id; _emojiSearch = ""; })"
                                        aria-label="@c.Label"
                                        class="@Cn.Merge("flex size-7 items-center justify-center rounded-md transition-colors", _activeCategory == c.Id && string.IsNullOrWhiteSpace(_emojiSearch) ? "bg-muted text-foreground" : "text-muted-foreground hover:text-foreground")">
                                    <LucideIconCn Name="@c.IconName" Size="14" Class="size-3.5" />
                                </button>
                            }
                        </div>

                    </PopoverContentCn>
                </PopoverCn>

                @* Message input *@
                <div class="relative min-w-0 flex-1 rounded-md border bg-background">
                    <textarea @bind="_input"
                              @bind:event="oninput"
                              @onkeydown="HandleKeyDown"
                              placeholder="Type a message..."
                              rows="1"
                              class="max-h-32 min-h-0 w-full resize-none border-0 bg-transparent pr-10 text-sm shadow-none outline-none placeholder:text-muted-foreground/50 focus-visible:ring-0" aria-label="Type a message..."></textarea>
                    <button type="button"
                            @onclick="HandleSubmit"
                            disabled="@(!CanSubmit)"
                            class="absolute top-1/2 right-1 size-7 -translate-y-1/2 inline-flex items-center justify-center rounded-md text-muted-foreground hover:text-foreground" aria-label="Send message">
                        <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                    </button>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
