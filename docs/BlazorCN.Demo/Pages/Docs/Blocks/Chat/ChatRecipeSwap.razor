@* ============================================================
   Block: chat-recipe-swap
   Title: ChatRecipeSwap
   Description: A recipe sharing community chat built with React, Next.js, shadcn/ui, and Tailwind CSS featuring recipe cards, ingredient lists, ratings, and cooking time estimates
   Source: original/blocks/chat/chat-recipe-swap.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <div class="flex size-9 items-center justify-center rounded-lg bg-primary/10">
                    <LucideIconCn Name="chef-hat" Size="20" Class="size-5 text-primary" />
                </div>
                <div>
                    <h2 class="text-sm font-medium">Recipe Swap</h2>
                    <p class="text-xs text-muted-foreground">Share &amp; discover recipes</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4 p-4">
                @foreach (var message in _messages)
                {
                    @if (message.Type == "recipes" && message.Recipes != null)
                    {
                        <div class="space-y-3">
                            @foreach (var recipe in message.Recipes)
                            {
                                <div class="overflow-hidden rounded-lg border bg-muted/30">
                                    <div class="border-b bg-card px-3 py-2.5">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="min-w-0 flex-1">
                                                <h3 class="text-sm font-medium">@recipe.Title</h3>
                                                <div class="mt-1 flex items-center gap-2">
                                                    <AvatarCn Class="size-5">
                                                        <AvatarFallbackCn Class="text-[10px]">@recipe.AuthorInitials</AvatarFallbackCn>
                                                    </AvatarCn>
                                                    <span class="text-xs text-muted-foreground">@recipe.Author</span>
                                                </div>
                                            </div>
                                            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7 shrink-0" OnClick="@(() => HandleSave(recipe.Id))" aria-label="Bookmark">
                                                <LucideIconCn Name="bookmark" Size="14" Class="size-3.5" />
                                            </ButtonCn>
                                        </div>
                                    </div>

                                    <div class="p-3">
                                        <div class="mb-3 flex items-center gap-3 text-sm">
                                            <div class="flex items-center gap-1">
                                                <LucideIconCn Name="clock" Size="14" Class="size-3.5 text-muted-foreground" />
                                                <span class="text-muted-foreground">@recipe.CookTime</span>
                                            </div>
                                            <div class="flex items-center gap-1">
                                                <LucideIconCn Name="users" Size="14" Class="size-3.5 text-muted-foreground" />
                                                <span class="text-muted-foreground">@recipe.Servings servings</span>
                                            </div>
                                            <div class="flex items-center gap-1">
                                                <LucideIconCn Name="flame" Size="14" Class="size-3.5 text-muted-foreground" />
                                                <span class="@Cn.Merge("font-medium", DifficultyColor(recipe.Difficulty))">@recipe.Difficulty</span>
                                            </div>
                                            <div class="ml-auto flex items-center gap-1">
                                                <LucideIconCn Name="star" Size="14" Class="size-3.5 fill-amber-500 text-amber-500" />
                                                <span class="font-medium">@recipe.Rating</span>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <h4 class="mb-1.5 text-xs font-medium text-muted-foreground">Ingredients:</h4>
                                            <div class="space-y-0.5">
                                                @foreach (var ingredient in recipe.Ingredients.Take(4))
                                                {
                                                    <div class="flex items-start gap-1.5">
                                                        <LucideIconCn Name="leaf" Size="12" Class="mt-0.5 size-3 shrink-0 text-muted-foreground" />
                                                        <span class="text-xs text-muted-foreground">@ingredient</span>
                                                    </div>
                                                }
                                                @if (recipe.Ingredients.Length > 4)
                                                {
                                                    <span class="text-xs text-muted-foreground">+@(recipe.Ingredients.Length - 4) more ingredients</span>
                                                }
                                            </div>
                                        </div>

                                        <div class="flex flex-wrap gap-1.5">
                                            @foreach (var tag in recipe.Tags)
                                            {
                                                <span class="@Cn.Merge("rounded-md px-2 py-0.5 text-xs font-medium", DietaryColor(tag))">@tag</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="@Cn.Merge("flex gap-3", message.Type == "user" ? "justify-end" : "justify-start")">
                            @if (message.Type == "assistant")
                            {
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="bg-primary/10 text-xs">
                                        <LucideIconCn Name="chef-hat" Size="16" Class="size-4" />
                                    </AvatarFallbackCn>
                                </AvatarCn>
                            }
                            <div class="@Cn.Merge("max-w-[80%] rounded-lg px-3 py-2", message.Type == "user" ? "bg-primary text-primary-foreground" : "bg-muted")">
                                <p class="text-sm">@message.Content</p>
                                <span class="@Cn.Merge("mt-1 block text-xs", message.Type == "user" ? "text-primary-foreground/70" : "text-muted-foreground")">
                                    @message.Timestamp
                                </span>
                            </div>
                            @if (message.Type == "user")
                            {
                                <AvatarCn Class="size-7">
                                    <AvatarFallbackCn Class="bg-muted text-xs">U</AvatarFallbackCn>
                                </AvatarCn>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t p-3">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Ask for recipes or share your own..." Class="flex-1" aria-label="Ask for recipes or share your own..." />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record Recipe(
        string Id,
        string Title,
        string Author,
        string AuthorInitials,
        string CookTime,
        string Difficulty,
        int Servings,
        double Rating,
        string[] Ingredients,
        string[] Tags);

    private record Message(string Id, string Type, string Content, string Timestamp, Recipe[]? Recipes = null);

    private static string DifficultyColor(string difficulty) => difficulty switch
    {
        "Easy" => "text-emerald-500",
        "Medium" => "text-amber-500",
        "Hard" => "text-red-500",
        _ => ""
    };

    private static string DietaryColor(string tag) => tag switch
    {
        "Vegetarian" => "bg-emerald-500/10 text-emerald-700",
        "Gluten-Free" => "bg-amber-500/10 text-amber-700",
        "High-Protein" => "bg-blue-500/10 text-blue-700",
        "Low-Carb" => "bg-purple-500/10 text-purple-700",
        _ => "bg-muted text-muted-foreground"
    };

    private static readonly Recipe[] _recipes =
    [
        new("r1", "Mediterranean Quinoa Bowl", "Sarah Chen", "SC", "25 min", "Easy", 4, 4.8,
            ["1 cup quinoa", "2 cups vegetable broth", "1 cucumber, diced", "2 tomatoes, chopped", "1/2 red onion, sliced", "1/4 cup feta cheese", "3 tbsp olive oil", "Fresh lemon juice"],
            ["Vegetarian", "Gluten-Free", "High-Protein"]),
        new("r2", "Spicy Thai Basil Chicken", "Mike Rodriguez", "MR", "15 min", "Medium", 2, 4.6,
            ["500g chicken breast, sliced", "2 cups fresh basil", "4 Thai chilies, minced", "3 cloves garlic", "2 tbsp fish sauce", "1 tbsp oyster sauce", "1 tsp sugar"],
            ["High-Protein", "Low-Carb"]),
    ];

    private List<Message> _messages =
    [
        new("m1", "assistant",
            "Welcome to Recipe Swap! Share your favorite recipes or discover new ones from our community. What are you looking to cook today?",
            "2:15 PM"),
        new("m2", "user",
            "I'm looking for healthy dinner ideas under 30 minutes",
            "2:16 PM"),
        new("m3", "assistant",
            "Great! Here are some popular quick and healthy recipes from our community:",
            "2:16 PM"),
        new("m4", "recipes", "", "2:16 PM", _recipes),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new($"m{_messages.Count + 1}", "user", _input, "2:17 PM"));
        _input = "";
    }

    private void HandleSave(string recipeId)
    {
        // Save recipe action - no-op in demo
    }
}
