@* ============================================================
   Block: chat-api-playground
   Title: ChatApiPlayground
   Description: An interactive API testing playground built with React, Next.js, shadcn/ui, and Tailwind CSS featuring request/response cards, curl snippets, and endpoint testing
   Source: original/blocks/chat/chat-api-playground.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-9 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="terminal" Size="20" Class="size-5 text-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <h2 class="font-medium text-sm">API Playground</h2>
                <p class="text-muted-foreground text-xs">Test and debug endpoints</p>
            </div>
            <span class="rounded-md bg-blue-500/10 px-2 py-1 font-medium text-blue-600 text-xs dark:text-blue-400">
                Ready
            </span>
        </div>

        @* Messages area *@
        <div class="flex-1 overflow-y-auto px-4 py-3">
            <div class="space-y-4">
                @foreach (var message in _messages)
                {
                    var isUser = message.Role == "user";
                    <div class="@Cn.Merge("flex gap-3", isUser ? "flex-row-reverse" : "")">
                        <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full", message.Role == "assistant" ? "bg-muted" : "bg-foreground text-background")">
                            @if (message.Role == "assistant")
                            {
                                <LucideIconCn Name="terminal" Size="16" Class="size-4" />
                            }
                            else
                            {
                                <span class="font-medium text-xs">You</span>
                            }
                        </div>
                        <div class="@Cn.Merge("min-w-0 flex-1 space-y-1", isUser ? "flex flex-col items-end" : "")">
                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", message.Role == "assistant" ? "bg-muted" : "bg-foreground text-background")">
                                @message.Content
                            </div>
                            @if (message.Request != null)
                            {
                                @* Request Card *@
                                <div class="mt-3 overflow-hidden rounded-md border bg-muted/50">
                                    <div class="border-b bg-card px-3 py-2">
                                        <div class="flex items-center gap-2">
                                            <span class="@Cn.Merge("rounded-md px-2 py-0.5 font-mono text-xs", GetMethodColor(message.Request.Method))">
                                                @message.Request.Method
                                            </span>
                                            <span class="font-mono text-sm">@message.Request.Endpoint</span>
                                        </div>
                                    </div>
                                    @if (message.Request.Headers != null && message.Request.Headers.Count > 0)
                                    {
                                        <div class="border-b px-3 py-2">
                                            <span class="font-medium text-muted-foreground text-xs">Headers</span>
                                            <div class="mt-1 space-y-1 font-mono text-xs">
                                                @foreach (var header in message.Request.Headers)
                                                {
                                                    <div class="flex gap-2">
                                                        <span class="text-muted-foreground">@header.Key:</span>
                                                        <span>@header.Value</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                    @if (!string.IsNullOrEmpty(message.Request.Body))
                                    {
                                        <div class="px-3 py-2">
                                            <span class="font-medium text-muted-foreground text-xs">Body</span>
                                            <pre class="mt-1 overflow-x-auto rounded-md bg-zinc-950 p-2 font-mono text-xs text-zinc-100">@message.Request.Body</pre>
                                        </div>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(message.CurlCommand))
                            {
                                @* cURL Command Card *@
                                <div class="mt-3 overflow-hidden rounded-md border bg-muted/50">
                                    <div class="flex items-center justify-between border-b bg-card px-3 py-2">
                                        <div class="flex items-center gap-2">
                                            <LucideIconCn Name="code-2" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span class="font-medium text-xs">cURL Command</span>
                                        </div>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-6" @onclick="@(() => CopyCurl(message.Id))">
                                            @if (_copiedId == message.Id)
                                            {
                                                <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-500" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="copy" Size="12" Class="size-3" />
                                            }
                                        </ButtonCn>
                                    </div>
                                    <div class="px-3 py-2">
                                        <pre class="overflow-x-auto font-mono text-xs">@message.CurlCommand</pre>
                                    </div>
                                </div>
                            }
                            @if (message.Response != null)
                            {
                                var resp = message.Response;
                                var isSuccess = resp.Status >= 200 && resp.Status < 300;
                                @* Response Card *@
                                <div class="mt-3 overflow-hidden rounded-md border bg-muted/50">
                                    <div class="border-b bg-card px-3 py-2">
                                        <div class="flex items-center justify-between gap-2">
                                            <div class="flex items-center gap-2">
                                                @if (isSuccess)
                                                {
                                                    <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="alert-circle" Size="14" Class="size-3.5 text-red-500" />
                                                }
                                                <span class="font-medium text-sm">Response</span>
                                            </div>
                                            <div class="flex items-center gap-2">
                                                <span class="@Cn.Merge("rounded-md px-2 py-0.5 font-mono text-xs", isSuccess ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-red-500/10 text-red-600 dark:text-red-400")">
                                                    @resp.Status @resp.StatusText
                                                </span>
                                                <span class="text-muted-foreground text-xs">@resp.Duration</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="border-b px-3 py-2">
                                        <span class="font-medium text-muted-foreground text-xs">Headers</span>
                                        <div class="mt-1 space-y-1 font-mono text-xs">
                                            @foreach (var header in resp.Headers)
                                            {
                                                <div class="flex gap-2">
                                                    <span class="text-muted-foreground">@header.Key:</span>
                                                    <span>@header.Value</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="px-3 py-2">
                                        <span class="font-medium text-muted-foreground text-xs">Body</span>
                                        <pre class="mt-1 overflow-x-auto rounded-md bg-zinc-950 p-2 font-mono text-xs text-zinc-100">@resp.Body</pre>
                                    </div>
                                </div>
                            }
                            <span class="text-muted-foreground text-xs">@message.Timestamp</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input form *@
        <div class="border-t p-3">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Describe your API request..." Class="flex-1" />
                <ButtonCn Size="ButtonSize.Icon" disabled="@(string.IsNullOrWhiteSpace(_input))" @onclick="HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record ApiRequest(
        string Method,
        string Endpoint,
        Dictionary<string, string>? Headers = null,
        string? Body = null
    );

    private record ApiResponse(
        int Status,
        string StatusText,
        Dictionary<string, string> Headers,
        string Body,
        string Duration
    );

    private record Message(
        string Id,
        string Role,
        string Content,
        string Timestamp,
        ApiRequest? Request = null,
        ApiResponse? Response = null,
        string? CurlCommand = null
    );

    private List<Message> _messages =
    [
        new(
            Id: "1",
            Role: "assistant",
            Content: "Welcome to the API Playground! Describe the API request you want to test, and I'll help you build and execute it.",
            Timestamp: "2:00 PM"
        ),
        new(
            Id: "2",
            Role: "user",
            Content: "I want to test a GET request to fetch user data from /api/users/123",
            Timestamp: "2:02 PM"
        ),
        new(
            Id: "3",
            Role: "assistant",
            Content: "I've prepared your GET request. Here's the configuration and equivalent curl command:",
            Timestamp: "2:02 PM",
            Request: new ApiRequest(
                Method: "GET",
                Endpoint: "https://api.example.com/users/123",
                Headers: new Dictionary<string, string>
                {
                    ["Content-Type"] = "application/json",
                    ["Authorization"] = "Bearer token_xyz",
                }
            ),
            Response: new ApiResponse(
                Status: 200,
                StatusText: "OK",
                Headers: new Dictionary<string, string>
                {
                    ["content-type"] = "application/json",
                    ["cache-control"] = "no-cache",
                },
                Body: "{\n  \"id\": 123,\n  \"name\": \"Sarah Chen\",\n  \"email\": \"sarah@@example.com\",\n  \"role\": \"developer\"\n}",
                Duration: "142ms"
            ),
            CurlCommand: "curl -X GET \"https://api.example.com/users/123\" \\\n  -H \"Content-Type: application/json\" \\\n  -H \"Authorization: Bearer token_xyz\""
        ),
    ];

    private string _input = "";
    private string? _copiedId = null;

    private static string GetMethodColor(string method) => method switch
    {
        "GET"    => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        "POST"   => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        "PUT"    => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        "DELETE" => "bg-red-500/10 text-red-600 dark:text-red-400",
        _        => "",
    };

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;

        _messages.Add(new Message(
            Id: $"{_messages.Count + 1}",
            Role: "user",
            Content: _input,
            Timestamp: "2:05 PM"
        ));
        _input = "";
    }

    private void CopyCurl(string messageId)
    {
        _copiedId = messageId;
        // Reset after a tick — in a static/SSR demo, a simple state toggle is sufficient
        _ = Task.Delay(2000).ContinueWith(_ =>
        {
            _copiedId = null;
            InvokeAsync(StateHasChanged);
        });
    }
}
