@* ============================================================
   Block: chat-yoga-instructor
   Title: ChatYogaInstructor
   Description: A personalized yoga instructor chat built with React, Next.js, shadcn/ui, and Tailwind CSS featuring pose cards, sequence builder, and practice timer
   Source: original/blocks/chat/chat-yoga-instructor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-9 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="user" Size="20" Class="size-5 text-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <h2 class="font-medium text-sm">Yoga Instructor</h2>
                <p class="text-muted-foreground text-xs">Personalized practice guidance</p>
            </div>
            <LucideIconCn Name="check-circle-2" Size="20" Class="size-5 text-emerald-500" />
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4">
                @foreach (var msg in _messages)
                {
                    <div class="@(msg.Role == "user" ? "flex gap-3 flex-row-reverse" : "flex gap-3")">
                        @* Avatar *@
                        <div class="@(msg.Role == "assistant" ? "flex size-8 shrink-0 items-center justify-center rounded-full bg-muted" : "flex size-8 shrink-0 items-center justify-center rounded-full bg-foreground text-background")">
                            @if (msg.Role == "assistant")
                            {
                                <LucideIconCn Name="user" Size="16" Class="size-4" />
                            }
                            else
                            {
                                <span class="font-medium text-xs">You</span>
                            }
                        </div>

                        @* Content *@
                        <div class="@(msg.Role == "user" ? "min-w-0 flex-1 space-y-1 flex flex-col items-end" : "min-w-0 flex-1 space-y-1")">
                            <div class="@(msg.Role == "assistant" ? "inline-block rounded-lg px-3 py-2 text-sm bg-muted" : "inline-block rounded-lg px-3 py-2 text-sm bg-foreground text-background")">
                                @msg.Content
                            </div>

                            @* Sequence card *@
                            @if (msg.Sequence != null)
                            {
                                var seq = msg.Sequence;
                                <div class="mt-3 overflow-hidden rounded-md border bg-muted/50">
                                    <div class="flex items-center justify-between bg-card px-3 py-2">
                                        <div class="flex items-center gap-2">
                                            <LucideIconCn Name="play" Size="16" Class="size-4 text-foreground" />
                                            <div>
                                                <h3 class="font-medium text-sm">@seq.Name</h3>
                                                <p class="text-muted-foreground text-xs">@seq.Duration • @seq.Level</p>
                                            </div>
                                        </div>
                                        <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-7 gap-1 px-2 text-xs">
                                            <LucideIconCn Name="play" Size="12" Class="size-3" />
                                            Start
                                        </ButtonCn>
                                    </div>
                                </div>
                            }

                            @* Pose cards *@
                            @if (msg.Poses != null && msg.Poses.Length > 0)
                            {
                                <div class="mt-2 space-y-2">
                                    @foreach (var pose in msg.Poses)
                                    {
                                        var difficultyClass = pose.Difficulty == "beginner"
                                            ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400"
                                            : pose.Difficulty == "intermediate"
                                                ? "bg-amber-500/10 text-amber-600 dark:text-amber-400"
                                                : "bg-red-500/10 text-red-600 dark:text-red-400";
                                        <div class="overflow-hidden rounded-md border bg-muted/50">
                                            <div class="border-b bg-card px-3 py-2">
                                                <div class="flex items-start justify-between gap-2">
                                                    <div class="min-w-0 flex-1">
                                                        <h3 class="font-medium text-sm">@pose.Name</h3>
                                                        <p class="mt-0.5 text-muted-foreground text-xs">@pose.SanskritName</p>
                                                    </div>
                                                    <span class="@Cn.Merge("shrink-0 rounded-md px-2 py-0.5 text-xs", difficultyClass)">
                                                        @pose.Difficulty
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="space-y-3 px-3 py-2">
                                                <div class="flex items-center gap-2">
                                                    <LucideIconCn Name="timer" Size="14" Class="size-3.5 text-muted-foreground" />
                                                    <span class="text-sm">@pose.Duration</span>
                                                </div>
                                                <div>
                                                    <span class="font-medium text-muted-foreground text-xs">Benefits</span>
                                                    <div class="mt-1 flex flex-wrap gap-1">
                                                        @foreach (var benefit in pose.Benefits)
                                                        {
                                                            <span class="rounded-md bg-muted px-2 py-0.5 text-xs">@benefit</span>
                                                        }
                                                    </div>
                                                </div>
                                                <div>
                                                    <span class="font-medium text-muted-foreground text-xs">Instructions</span>
                                                    <ul class="mt-1 space-y-1">
                                                        @foreach (var step in pose.Instructions)
                                                        {
                                                            <li class="flex items-start gap-2 text-sm">
                                                                <span class="mt-0.5 size-1.5 shrink-0 rounded-full bg-foreground"></span>
                                                                <span>@step</span>
                                                            </li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            <span class="text-muted-foreground text-xs">@msg.Timestamp</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <form class="border-t p-3" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Ask about poses, sequences, or goals..."
                         Class="flex-1" aria-label="Ask about poses, sequences, or goals..." />
                <ButtonCn type="submit" Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </form>

    </div>
</section>

@code {
    private string _input = "";

    private record Pose(string Id, string Name, string SanskritName, string Difficulty, string Duration, string[] Benefits, string[] Instructions);

    private record SequenceInfo(string Name, string Duration, string Level);

    private record Message(string Id, string Role, string Content, string Timestamp, SequenceInfo? Sequence = null, Pose[]? Poses = null);

    private static readonly Pose[] _samplePoses =
    [
        new("1", "Downward-Facing Dog", "Adho Mukha Svanasana", "beginner", "1-3 min",
            ["Strengthens arms and legs", "Stretches hamstrings", "Calms the mind"],
            ["Start on hands and knees", "Lift hips up and back", "Press heels toward floor", "Relax neck and head"]),
        new("2", "Warrior II", "Virabhadrasana II", "beginner", "30-60 sec each side",
            ["Builds stamina", "Strengthens legs", "Opens hips and chest"],
            ["Step feet wide apart", "Turn right foot out 90 degrees", "Bend right knee over ankle", "Extend arms parallel to floor"]),
    ];

    private Message[] _messages =
    [
        new("1", "assistant",
            "Namaste! I'm your personal yoga instructor. Tell me about your experience level and what you'd like to focus on today.",
            "7:00 AM"),
        new("2", "user",
            "I'm a beginner and want to work on flexibility and stress relief. Can you suggest a short morning routine?",
            "7:02 AM"),
        new("3", "assistant",
            "Perfect! I've created a gentle morning flow for you. This 15-minute sequence focuses on stretching and calming the nervous system.",
            "7:02 AM",
            Sequence: new("Morning Flexibility Flow", "15 minutes", "Beginner"),
            Poses: _samplePoses),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        var newMsg = new Message(
            $"{_messages.Length + 1}",
            "user",
            _input,
            "7:05 AM");
        _messages = [.. _messages, newMsg];
        _input = "";
    }
}
