@* ============================================================
   Block: chat-event-invitation
   Title: ChatEventInvitation
   Description: React chat block with calendar event invitation cards for Next.js featuring RSVP buttons, attendee counts, date and location display, and response status using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-event-invitation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="text-xs">PS</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Priya Sharma</span>
                <span class="ml-2 text-muted-foreground text-xs">Design Lead</span>
            </div>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                <span>2 events</span>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto py-2">
            @foreach (var msg in _chatMessages)
            {
                var showHeader = IsFirstInGroup(msg.Id);
                <div class="flex gap-2 px-2 transition-colors hover:bg-accent">
                    <div class="w-10 shrink-0 pt-1">
                        @if (showHeader)
                        {
                            <AvatarCn Class="size-8">
                                <AvatarFallbackCn Class="text-xs">@msg.Initials</AvatarFallbackCn>
                            </AvatarCn>
                        }
                    </div>
                    <div class="min-w-0 flex-1 py-1">
                        @if (showHeader)
                        {
                            <div class="mb-0.5 flex items-center gap-2">
                                <span class="font-medium text-sm">@msg.Sender</span>
                                <span class="text-muted-foreground text-xs">@msg.Time</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(msg.Content))
                        {
                            <p class="text-sm">@msg.Content</p>
                        }
                        @if (msg.Event != null)
                        {
                            var evt = msg.Event;
                            var msgId = msg.Id;
                            var isPending = evt.RsvpStatus == RsvpStatus.Pending;
                            <div class="mt-1.5 rounded-md border p-3">
                                <div class="mb-2.5 flex items-center gap-2">
                                    <LucideIconCn Name="calendar" Size="16" Class="size-4 text-muted-foreground" />
                                    <span class="font-medium text-sm">@evt.Title</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="@($"ml-auto font-normal text-[10px] {GetRsvpBadgeStyle(evt.RsvpStatus)}")">
                                        @GetRsvpLabel(evt.RsvpStatus)
                                    </BadgeCn>
                                </div>

                                <div class="mb-3 space-y-1.5">
                                    <div class="flex items-center gap-2 text-muted-foreground text-xs">
                                        <LucideIconCn Name="calendar" Size="12" Class="size-3 shrink-0" />
                                        <span>@evt.Date</span>
                                    </div>
                                    <div class="flex items-center gap-2 text-muted-foreground text-xs">
                                        <LucideIconCn Name="clock" Size="12" Class="size-3 shrink-0" />
                                        <span>@evt.Time</span>
                                    </div>
                                    <div class="flex items-center gap-2 text-muted-foreground text-xs">
                                        <LucideIconCn Name="map-pin" Size="12" Class="size-3 shrink-0" />
                                        <span>@evt.Location</span>
                                    </div>
                                    <div class="flex items-center gap-2 text-muted-foreground text-xs">
                                        <LucideIconCn Name="users" Size="12" Class="size-3 shrink-0" />
                                        <span>@evt.Attendees attendees</span>
                                    </div>
                                </div>

                                @if (isPending)
                                {
                                    <div class="flex gap-2">
                                        <ButtonCn Size="ButtonSize.Sm" Class="h-7 flex-1 gap-1 bg-emerald-600 text-xs text-white hover:bg-emerald-700" OnClick="@(() => HandleRsvp(msgId, RsvpStatus.Accepted))">
                                            <LucideIconCn Name="check" Size="12" Class="size-3" />
                                            Accept
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 flex-1 gap-1 text-xs" OnClick="@(() => HandleRsvp(msgId, RsvpStatus.Declined))">
                                            <LucideIconCn Name="x" Size="12" Class="size-3" />
                                            Decline
                                        </ButtonCn>
                                        <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost" Class="h-7 px-3 text-xs text-muted-foreground" OnClick="@(() => HandleRsvp(msgId, RsvpStatus.Maybe))">
                                            Maybe
                                        </ButtonCn>
                                    </div>
                                }
                                else
                                {
                                    <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                        @if (evt.RsvpStatus == RsvpStatus.Accepted)
                                        {
                                            <LucideIconCn Name="check" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                                        }
                                        @if (evt.RsvpStatus == RsvpStatus.Declined)
                                        {
                                            <LucideIconCn Name="x" Size="12" Class="size-3 text-red-600 dark:text-red-400" />
                                        }
                                        <span>You @(GetRsvpLabel(evt.RsvpStatus).ToLower()) this event</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form class="relative flex items-end gap-2">
                <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="calendar" Size="16" Class="size-4" />
                </ButtonCn>
                <div class="relative flex-1">
                    <TextareaCn
                        @bind-Value="_input"
                        Placeholder="Type a message..."
                        Rows="1"
                        Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-10 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                    <ButtonCn
                        type="submit"
                        Size="ButtonSize.Icon"
                        Variant="ButtonVariant.Ghost"
                        Disabled="@(string.IsNullOrWhiteSpace(_input))"
                        Class="absolute top-1/2 right-0 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                        OnClick="@HandleSubmit">
                        <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </form>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private enum RsvpStatus { Pending, Accepted, Declined, Maybe }

    private record EventInvite(
        string Title,
        string Date,
        string Time,
        string Location,
        int Attendees,
        RsvpStatus RsvpStatus);

    private record ChatMessage(
        string Id,
        string Role,
        string Sender,
        string Initials,
        string Time,
        string? Content = null,
        EventInvite? Event = null);

    private List<ChatMessage> _chatMessages =
    [
        new("1", "other", "Priya Sharma", "PS", "9:30 AM",
            Content: "Hey team! I set up the quarterly design review. Here's the invite."),
        new("2", "other", "Priya Sharma", "PS", "9:30 AM",
            Event: new EventInvite(
                "Q2 Design Review",
                "Thursday, April 3",
                "2:00 PM - 3:30 PM EST",
                "Zoom — Meeting Room A",
                8,
                RsvpStatus.Accepted)),
        new("3", "user", "You", "YO", "9:35 AM",
            Content: "Accepted! I'll prepare the component library slides."),
        new("4", "other", "Priya Sharma", "PS", "9:38 AM",
            Content: "Also, don't forget the offsite next week. Sending the invite in case you missed it."),
        new("5", "other", "Priya Sharma", "PS", "9:38 AM",
            Event: new EventInvite(
                "Team Offsite — Product Strategy",
                "Monday, April 7",
                "10:00 AM - 4:00 PM EST",
                "WeWork, 5th Floor, Conference Room B",
                14,
                RsvpStatus.Pending)),
        new("6", "user", "You", "YO", "9:42 AM",
            Content: "I'll check my calendar. The morning might conflict with a client call."),
        new("7", "other", "Priya Sharma", "PS", "9:44 AM",
            Content: "No worries, RSVP when you can. We need headcount by Friday for catering."),
    ];

    private bool IsFirstInGroup(string messageId)
    {
        var index = _chatMessages.FindIndex(m => m.Id == messageId);
        if (index == 0) return true;
        var prev = _chatMessages[index - 1];
        var curr = _chatMessages[index];
        return prev.Sender != curr.Sender || prev.Role != curr.Role;
    }

    private void HandleRsvp(string messageId, RsvpStatus status)
    {
        var index = _chatMessages.FindIndex(m => m.Id == messageId);
        if (index < 0) return;
        var msg = _chatMessages[index];
        if (msg.Event == null) return;
        var updatedEvent = msg.Event with { RsvpStatus = status };
        _chatMessages[index] = msg with { Event = updatedEvent };
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }

    private static string GetRsvpBadgeStyle(RsvpStatus status) => status switch
    {
        RsvpStatus.Pending  => "bg-amber-500/10 text-amber-600 dark:text-amber-400",
        RsvpStatus.Accepted => "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400",
        RsvpStatus.Declined => "bg-red-500/10 text-red-600 dark:text-red-400",
        RsvpStatus.Maybe    => "bg-blue-500/10 text-blue-600 dark:text-blue-400",
        _                   => "",
    };

    private static string GetRsvpLabel(RsvpStatus status) => status switch
    {
        RsvpStatus.Pending  => "Awaiting response",
        RsvpStatus.Accepted => "Accepted",
        RsvpStatus.Declined => "Declined",
        RsvpStatus.Maybe    => "Maybe",
        _                   => "",
    };
}
