@* ============================================================
   Block: chat-flight-booking
   Title: ChatFlightBooking
   Description: React flight booking assistant chat block for Next.js with flight comparison cards, seat class selection, itinerary summary, fare breakdown, and booking confirmation using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-flight-booking.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-8">
                <AvatarImageCn Src="" Alt="" />
                <AvatarFallbackCn Class="bg-muted text-xs">
                    <LucideIconCn Name="plane" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <div class="flex items-center gap-2">
                    <span class="font-medium text-sm">Flight Booking</span>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">Flights</BadgeCn>
                </div>
                <span class="text-muted-foreground text-xs">Search, compare, and book flights</span>
            </div>
        </div>

        @* Route bar *@
        <div class="flex items-center gap-3 border-b bg-muted/30 px-4 py-2">
            <LucideIconCn Name="clock" Size="14" Class="size-3.5 shrink-0 text-muted-foreground" />
            <span class="text-muted-foreground text-xs">JFK to LHR · Round trip · May 15 - 22 · 1 passenger</span>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4" tabindex="0" role="group" aria-label="Messages">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    <div class="@Cn.Merge("flex", msg.Role == "user" ? "justify-end" : "justify-start")">
                        <div class="@Cn.Merge("max-w-[85%]", msg.Role == "user" ? "rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground" : "rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">
                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }
                            @if (msg.Flights != null)
                            {
                                @* Flight Cards *@
                                <div class="mt-2 space-y-2">
                                    @foreach (var flight in msg.Flights)
                                    {
                                        var flightId = flight.Id;
                                        var classIdx = _selectedClass.ContainsKey(flightId) ? _selectedClass[flightId] : 0;
                                        <div class="rounded-md border bg-card p-3">
                                            <div class="mb-2.5 flex items-center justify-between">
                                                <div class="flex items-center gap-1.5">
                                                    <LucideIconCn Name="plane" Size="14" Class="size-3.5 text-muted-foreground" />
                                                    <span class="font-medium text-sm">@flight.Airline</span>
                                                    <span class="font-mono text-muted-foreground text-xs">@flight.FlightNo</span>
                                                </div>
                                                <span class="font-semibold text-sm tabular-nums">
                                                    @(classIdx < flight.Classes.Length ? flight.Classes[classIdx].Price : "")
                                                </span>
                                            </div>
                                            <div class="flex items-center gap-3">
                                                <div class="text-center">
                                                    <p class="font-semibold text-lg tabular-nums">@flight.Departure.Code</p>
                                                    <p class="text-muted-foreground text-xs">@flight.Departure.Time</p>
                                                </div>
                                                <div class="flex flex-1 flex-col items-center gap-0.5">
                                                    <span class="text-muted-foreground text-xs">@flight.Duration</span>
                                                    <div class="flex w-full items-center gap-1">
                                                        <div class="size-1.5 rounded-full bg-muted-foreground/40"></div>
                                                        <div class="h-px flex-1 border-t border-dashed border-muted-foreground/30"></div>
                                                        <div class="size-1.5 rounded-full bg-muted-foreground/40"></div>
                                                    </div>
                                                    <span class="text-muted-foreground text-xs">
                                                        @(flight.Stops == 0 ? "Direct" : $"{flight.Stops} stop")
                                                    </span>
                                                </div>
                                                <div class="text-center">
                                                    <p class="font-semibold text-lg tabular-nums">@flight.Arrival.Code</p>
                                                    <p class="text-muted-foreground text-xs">@flight.Arrival.Time</p>
                                                </div>
                                            </div>
                                            <div class="mt-2.5 flex items-center gap-1.5 border-t pt-2.5">
                                                @for (int ci = 0; ci < flight.Classes.Length; ci++)
                                                {
                                                    var capturedFlight = flight;
                                                    var capturedIdx = ci;
                                                    var cls = flight.Classes[ci];
                                                    <button type="button"
                                                            class="@Cn.Merge("rounded-full px-2.5 py-0.5 text-xs transition-colors", classIdx == capturedIdx ? "bg-primary text-primary-foreground" : "bg-muted/50 text-muted-foreground hover:bg-muted")"
                                                            @onclick="@(() => SelectClass(capturedFlight.Id, capturedIdx))">
                                                        @cls.Name
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            @if (msg.Fare != null)
                            {
                                @* Fare Card *@
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2.5 flex items-center gap-1.5">
                                        <LucideIconCn Name="ticket" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="font-medium text-sm">Fare Breakdown</span>
                                    </div>
                                    <div class="space-y-0">
                                        <div class="flex items-center justify-between py-1.5">
                                            <span class="text-muted-foreground text-xs">Base fare (@msg.Fare.Passengers passenger)</span>
                                            <span class="font-mono text-sm tabular-nums">@msg.Fare.BaseFare</span>
                                        </div>
                                        <div class="flex items-center justify-between py-1.5 border-t">
                                            <span class="text-muted-foreground text-xs">Taxes &amp; government fees</span>
                                            <span class="font-mono text-sm tabular-nums">@msg.Fare.Taxes</span>
                                        </div>
                                        <div class="flex items-center justify-between py-1.5 border-t">
                                            <span class="text-muted-foreground text-xs">Carrier surcharge</span>
                                            <span class="font-mono text-sm tabular-nums">@msg.Fare.CarrierSurcharge</span>
                                        </div>
                                        <div class="flex items-center justify-between py-1.5 border-t">
                                            <span class="text-muted-foreground text-xs">Booking fee</span>
                                            <span class="font-mono text-sm tabular-nums">@msg.Fare.BookingFee</span>
                                        </div>
                                    </div>
                                    <div class="mt-2 flex items-center justify-between border-t pt-2.5">
                                        <span class="font-medium text-sm">Total</span>
                                        <span class="font-semibold text-lg tabular-nums">@msg.Fare.Total</span>
                                    </div>
                                </div>
                            }
                            @if (msg.Itinerary != null)
                            {
                                @* Itinerary Card *@
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2.5 flex items-center gap-1.5">
                                        <LucideIconCn Name="plane" Size="14" Class="size-3.5 text-muted-foreground" />
                                        <span class="font-medium text-sm">Trip Summary</span>
                                    </div>
                                    <div class="space-y-2.5">
                                        <div>
                                            <div class="mb-1 flex items-center gap-1.5">
                                                <span class="text-muted-foreground text-xs">Outbound</span>
                                                <span class="text-muted-foreground text-xs">·</span>
                                                <span class="text-xs">@msg.Itinerary.Outbound.Date</span>
                                            </div>
                                            <div class="flex items-center justify-between">
                                                <span class="text-sm">@msg.Itinerary.Outbound.Airline @msg.Itinerary.Outbound.FlightNo</span>
                                                <span class="font-mono text-muted-foreground text-xs">@msg.Itinerary.Outbound.Route</span>
                                            </div>
                                            <p class="text-muted-foreground text-xs">@msg.Itinerary.Outbound.Time</p>
                                        </div>
                                        <div class="border-t pt-2.5">
                                            <div class="mb-1 flex items-center gap-1.5">
                                                <span class="text-muted-foreground text-xs">Return</span>
                                                <span class="text-muted-foreground text-xs">·</span>
                                                <span class="text-xs">@msg.Itinerary.ReturnFlight.Date</span>
                                            </div>
                                            <div class="flex items-center justify-between">
                                                <span class="text-sm">@msg.Itinerary.ReturnFlight.Airline @msg.Itinerary.ReturnFlight.FlightNo</span>
                                                <span class="font-mono text-muted-foreground text-xs">@msg.Itinerary.ReturnFlight.Route</span>
                                            </div>
                                            <p class="text-muted-foreground text-xs">@msg.Itinerary.ReturnFlight.Time</p>
                                        </div>
                                    </div>
                                    <div class="mt-2.5 flex items-center justify-between border-t pt-2.5">
                                        <div class="flex items-center gap-2">
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="font-normal text-xs">@msg.Itinerary.SeatClass</BadgeCn>
                                        </div>
                                        <span class="font-semibold text-lg tabular-nums">@msg.Itinerary.Total</span>
                                    </div>
                                </div>
                            }
                            @if (msg.Confirmation != null)
                            {
                                @* Confirmation Card *@
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-2.5 flex items-center gap-1.5">
                                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-emerald-500" />
                                        <span class="font-medium text-sm">Booking Confirmed</span>
                                    </div>
                                    <div class="space-y-2">
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Confirmation</span>
                                            <span class="font-mono font-semibold text-sm">@msg.Confirmation.ConfirmationNo</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">E-ticket</span>
                                            <span class="font-mono text-sm">@msg.Confirmation.ETicket</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Passenger</span>
                                            <span class="text-sm">@msg.Confirmation.Passenger</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Route</span>
                                            <span class="text-sm">@msg.Confirmation.Route</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Dates</span>
                                            <span class="text-sm">@msg.Confirmation.Date</span>
                                        </div>
                                        <div class="flex items-center justify-between">
                                            <span class="text-muted-foreground text-xs">Class</span>
                                            <span class="text-sm">@msg.Confirmation.SeatClass</span>
                                        </div>
                                    </div>
                                    <div class="mt-2.5 flex items-center justify-between border-t pt-2.5">
                                        <div class="flex items-center gap-1.5">
                                            <span class="size-1.5 rounded-full bg-emerald-500"></span>
                                            <span class="text-xs">@msg.Confirmation.Status</span>
                                        </div>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">View e-ticket</ButtonCn>
                                    </div>
                                </div>
                            }
                            <span class="@Cn.Merge("mt-1 block text-right text-xs", msg.Role == "user" ? "text-primary-foreground/60" : "text-muted-foreground")">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative">
                <TextareaCn @bind-Value="_input"
                            Placeholder="Search flights or ask about options..."
                            Rows="1"
                            Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" aria-label="Search flights or ask about options..." />
                <ButtonCn Size="ButtonSize.Icon"
                          Variant="ButtonVariant.Ghost"
                          Disabled="@(string.IsNullOrWhiteSpace(_input))"
                          OnClick="@HandleSubmit"
                          Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private Dictionary<string, int> _selectedClass = new();

    private void SelectClass(string flightId, int idx)
    {
        _selectedClass[flightId] = idx;
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }

    private record FlightEndpoint(string Code, string City, string Time);
    private record SeatClass(string Name, string Price);
    private record FlightOption(
        string Id,
        string Airline,
        string FlightNo,
        FlightEndpoint Departure,
        FlightEndpoint Arrival,
        string Duration,
        int Stops,
        SeatClass[] Classes);

    private record FareBreakdown(
        string BaseFare,
        string Taxes,
        string CarrierSurcharge,
        string BookingFee,
        string Total,
        int Passengers);

    private record FlightLeg(string Airline, string FlightNo, string Route, string Time, string Date);
    private record Itinerary(FlightLeg Outbound, FlightLeg ReturnFlight, string SeatClass, string Total);

    private record BookingConfirmation(
        string ConfirmationNo,
        string ETicket,
        string Passenger,
        string Route,
        string Date,
        string SeatClass,
        string Status);

    private record Message(
        string Id,
        string Role,
        string Content,
        string Timestamp,
        FlightOption[]? Flights = null,
        FareBreakdown? Fare = null,
        Itinerary? Itinerary = null,
        BookingConfirmation? Confirmation = null);

    private static readonly Message[] _messages =
    [
        new("1", "user",
            "I need a round-trip flight from New York JFK to London Heathrow. Departing May 15, returning May 22. Just one passenger.",
            "9:40 AM"),
        new("2", "assistant",
            "I found 3 great options for your JFK to LHR round trip. Here are the outbound flights on May 15:",
            "9:41 AM"),
        new("3", "assistant", "", "9:41 AM",
            Flights:
            [
                new("f1", "British Airways", "BA 178",
                    new("JFK", "New York", "7:30 PM"),
                    new("LHR", "London", "7:20 AM +1"),
                    "6h 50m", 0,
                    [
                        new("Economy", "$486"),
                        new("Premium", "$1,240"),
                        new("Business", "$3,680"),
                    ]),
                new("f2", "Delta", "DL 1",
                    new("JFK", "New York", "9:00 PM"),
                    new("LHR", "London", "9:05 AM +1"),
                    "7h 05m", 0,
                    [
                        new("Economy", "$452"),
                        new("Premium", "$1,180"),
                        new("Business", "$3,420"),
                    ]),
                new("f3", "Norse Atlantic", "NO 102",
                    new("JFK", "New York", "10:45 PM"),
                    new("LGW", "London Gatwick", "11:00 AM +1"),
                    "7h 15m", 0,
                    [
                        new("Economy", "$318"),
                        new("Premium", "$648"),
                    ]),
            ]),
        new("4", "user",
            "I'll go with the British Airways flight in Premium Economy. Can you show me the full fare breakdown?",
            "9:43 AM"),
        new("5", "assistant",
            "Great choice. Here's the fare breakdown for your round-trip BA 178 in Premium Economy:",
            "9:44 AM"),
        new("6", "assistant", "", "9:44 AM",
            Fare: new("$2,280", "$198", "$86", "$0", "$2,564", 1)),
        new("7", "user",
            "Looks good, let's book it.",
            "9:45 AM"),
        new("8", "assistant",
            "Here's your trip summary before I confirm:",
            "9:46 AM"),
        new("9", "assistant", "", "9:46 AM",
            Itinerary: new(
                new("British Airways", "BA 178", "JFK to LHR", "7:30 PM - 7:20 AM +1", "May 15, 2026"),
                new("British Airways", "BA 177", "LHR to JFK", "11:15 AM - 2:30 PM", "May 22, 2026"),
                "Premium Economy",
                "$2,564")),
        new("10", "assistant",
            "Booking confirmed. Here are your details:",
            "9:47 AM"),
        new("11", "assistant", "", "9:47 AM",
            Confirmation: new(
                "BAXK72M",
                "125-4892761048",
                "Alex Johnson",
                "JFK - LHR - JFK",
                "May 15 - May 22, 2026",
                "Premium Economy",
                "Confirmed")),
    ];
}
