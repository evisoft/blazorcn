@* ============================================================
   Block: chat-mobile-view
   Title: ChatMobileView
   Description: React mobile-optimized full-screen chat block for Next.js with large touch targets, profile header, back navigation, safe-area input padding, and swipe-friendly layout using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-mobile-view.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-sm p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-2xl border bg-card">

        @* Mock status bar *@
        <div class="flex items-center justify-between px-5 py-1.5">
            <span class="font-medium text-[10px]">9:41</span>
            <div class="flex items-center gap-1">
                <div class="flex items-end gap-px">
                    <span class="h-1.5 w-0.5 rounded-sm bg-foreground"></span>
                    <span class="h-2 w-0.5 rounded-sm bg-foreground"></span>
                    <span class="h-2.5 w-0.5 rounded-sm bg-foreground"></span>
                    <span class="h-3 w-0.5 rounded-sm bg-foreground"></span>
                </div>
                <span class="font-medium text-[9px]">5G</span>
                <div class="flex h-2.5 w-5 items-center rounded-sm border border-foreground p-px">
                    <div class="h-full w-3/4 rounded-[1px] bg-foreground"></div>
                </div>
            </div>
        </div>

        @* Profile header with back arrow *@
        <div class="flex items-center gap-2 border-b px-2 py-2">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 shrink-0 text-muted-foreground">
                <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
            </ButtonCn>
            <AvatarCn Class="size-8">
                <AvatarFallbackCn Class="text-[10px]">@_contact.Initials</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-xs">@_contact.Name</span>
                <p class="text-muted-foreground text-[10px]">@_contact.Status</p>
            </div>
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 shrink-0 text-muted-foreground">
                <LucideIconCn Name="phone" Size="14" Class="size-3.5" />
            </ButtonCn>
        </div>

        @* Messages — flat layout *@
        <div class="flex flex-1 flex-col overflow-y-auto py-2">
            @for (int i = 0; i < _messages.Length; i++)
            {
                var msg = _messages[i];
                var prev = i > 0 ? _messages[i - 1] : null;
                var isFirstInGroup = prev == null || prev.Role != msg.Role;
                var isUser = msg.Role == "user";

                <div class="@Cn.Merge("group flex gap-2 px-3 py-0.5 hover:bg-accent/50", isFirstInGroup ? "mt-2" : "")">
                    @* Avatar column *@
                    <div class="flex w-7 shrink-0 items-start justify-center pt-0.5">
                        @if (isFirstInGroup)
                        {
                            <AvatarCn Class="size-6">
                                <AvatarFallbackCn Class="text-[8px]">@(isUser ? "You" : _contact.Initials)</AvatarFallbackCn>
                            </AvatarCn>
                        }
                        else
                        {
                            <span class="invisible text-muted-foreground text-[9px] group-hover:visible">
                                @msg.Timestamp
                            </span>
                        }
                    </div>

                    @* Body *@
                    <div class="min-w-0 flex-1">
                        @if (isFirstInGroup)
                        {
                            <div class="mb-0.5 flex items-center gap-2">
                                <span class="font-medium text-xs">@(isUser ? "You" : _contact.Name)</span>
                                <span class="text-muted-foreground text-[9px]">@msg.Timestamp</span>
                            </div>
                        }
                        <p class="text-xs leading-relaxed">@msg.Content</p>
                        @* Delivery status *@
                        @if (isUser && msg.Status != null)
                        {
                            <div class="mt-0.5 flex items-center gap-0.5">
                                <LucideIconCn Name="check-check" Size="10"
                                              Class="@Cn.Merge("size-2.5", msg.Status == "read" ? "text-blue-500" : "text-muted-foreground/60")" />
                            </div>
                        }
                    </div>

                    @* Swipe hint *@
                    <div class="flex w-4 shrink-0 items-center justify-center">
                        <LucideIconCn Name="chevron-right" Size="12" Class="size-3 text-muted-foreground/0 transition-colors group-hover:text-muted-foreground/40" />
                    </div>
                </div>
            }
        </div>

        @* Input area with safe-area padding *@
        <div class="border-t px-3 pt-2 pb-1">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-1.5 rounded-full border bg-muted/30 px-3 py-1">
                <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                          Class="size-7 shrink-0 p-0 text-muted-foreground">
                    <LucideIconCn Name="camera" Size="14" Class="size-3.5" />
                </ButtonCn>
                <input @bind="_input" @bind:event="oninput"
                       placeholder="Message..."
                       class="h-7 min-w-0 flex-1 bg-transparent text-xs outline-none placeholder:text-muted-foreground" />
                <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon"
                          Class="size-7 shrink-0 p-0 text-muted-foreground">
                    <LucideIconCn Name="smile" Size="14" Class="size-3.5" />
                </ButtonCn>
                <ButtonCn type="submit" Size="ButtonSize.Icon"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-7 shrink-0 rounded-full p-0">
                    <LucideIconCn Name="send" Size="12" Class="size-3" />
                </ButtonCn>
            </form>
        </div>

        @* Bottom tab navigation *@
        <div class="flex items-center justify-around border-t px-2 pb-3 pt-2">
            @foreach (var tab in _bottomTabs)
            {
                <button type="button"
                        class="@Cn.Merge("flex flex-col items-center gap-0.5", tab.Active ? "text-foreground" : "text-muted-foreground/60")">
                    <LucideIconCn Name="@tab.Icon" Size="16" Class="size-4" />
                    <span class="text-[9px] font-medium">@tab.Label</span>
                    @if (tab.Active)
                    {
                        <span class="size-1 rounded-full bg-foreground"></span>
                    }
                </button>
            }
        </div>

    </div>
</section>

@code {
    private record ContactInfo(string Name, string Initials, string Status);

    private record ChatMessage(string Id, string Role, string Content, string Timestamp, string? Status = null);

    private record BottomTab(string Icon, string Label, bool Active);

    private static readonly ContactInfo _contact = new("Maya Johnson", "MJ", "Last seen 5 min ago");

    private static readonly ChatMessage[] _messages =
    [
        new("m1", "contact", "Are we still on for the design review at 3?", "2:41 PM"),
        new("m2", "user", "Yes! I just pushed the latest Figma updates.", "2:42 PM", "read"),
        new("m3", "contact", "Great, I saw the new onboarding flow. The step indicator is much cleaner now.", "2:43 PM"),
        new("m4", "user", "Thanks! I simplified it from 5 steps to 3. Users were dropping off at step 4.", "2:44 PM", "read"),
        new("m5", "contact", "Smart move. The analytics backed that up. I think we can cut the company size question entirely.", "2:45 PM"),
        new("m6", "user", "Agreed. I moved it to the settings page instead.", "2:46 PM", "delivered"),
        new("m7", "contact", "Perfect. One more thing — can you update the color tokens for the dark mode variant? The contrast on the secondary buttons is too low.", "2:47 PM"),
        new("m8", "user", "On it. I'll bump the foreground from zinc-400 to zinc-300.", "2:48 PM", "sent"),
    ];

    private static readonly BottomTab[] _bottomTabs =
    [
        new("message-circle", "Chats", true),
        new("phone", "Calls", false),
        new("user", "Contacts", false),
        new("settings", "Settings", false),
    ];

    private string _input = "";

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
