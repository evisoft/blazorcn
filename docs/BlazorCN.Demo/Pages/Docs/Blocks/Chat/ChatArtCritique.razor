@* ============================================================
   Block: chat-art-critique
   Title: ChatArtCritique
   Description: A professional art critique chat built with React, Next.js, shadcn/ui, and Tailwind CSS featuring artwork cards, style analysis, and detailed rating system
   Source: original/blocks/chat/chat-art-critique.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-9 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="palette" Size="20" Class="size-5 text-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <h2 class="font-medium text-sm">Art Critique</h2>
                <p class="text-muted-foreground text-xs">Professional artwork analysis</p>
            </div>
            <LucideIconCn Name="star" Size="20" Class="size-5 text-amber-500" />
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4">
                @foreach (var message in _messages)
                {
                    <div class="@Cn.Merge("flex gap-3", message.Role == "user" ? "flex-row-reverse" : "")">
                        <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full", message.Role == "assistant" ? "bg-muted" : "bg-foreground text-background")">
                            @if (message.Role == "assistant")
                            {
                                <LucideIconCn Name="palette" Size="16" Class="size-4" />
                            }
                            else
                            {
                                <span class="font-medium text-xs">You</span>
                            }
                        </div>
                        <div class="@Cn.Merge("min-w-0 flex-1 space-y-1", message.Role == "user" ? "flex flex-col items-end" : "")">
                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", message.Role == "assistant" ? "bg-muted" : "bg-foreground text-background")">
                                @message.Content
                            </div>
                            @if (message.Critique != null)
                            {
                                var critique = message.Critique;
                                <div class="mt-3 overflow-hidden rounded-md border bg-muted/50">
                                    <div class="border-b bg-card px-3 py-2">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="min-w-0 flex-1">
                                                <h3 class="font-medium text-sm">@critique.Title</h3>
                                                <p class="mt-0.5 text-muted-foreground text-xs">@critique.Medium • @critique.Style</p>
                                            </div>
                                            <div class="flex shrink-0 items-center gap-1">
                                                <LucideIconCn Name="star" Size="16" Class="size-4 fill-amber-500 text-amber-500" />
                                                <span class="font-semibold text-sm">@critique.OverallScore.ToString("F1")</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="space-y-3 px-3 py-2">
                                        @* Ratings *@
                                        <div>
                                            <div class="mb-2 flex items-center gap-1.5">
                                                <LucideIconCn Name="trending-up" Size="14" Class="size-3.5 text-muted-foreground" />
                                                <span class="font-medium text-muted-foreground text-xs">Ratings</span>
                                            </div>
                                            <div class="space-y-2">
                                                <div class="space-y-1">
                                                    <div class="flex items-center justify-between">
                                                        <span class="text-muted-foreground text-xs">Composition</span>
                                                        <span class="font-medium text-xs">@critique.Ratings.Composition.ToString("F1")/5</span>
                                                    </div>
                                                    <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                                        <div class="h-full bg-foreground transition-all" style="@($"width:{(critique.Ratings.Composition / 5.0 * 100):F1}%")"></div>
                                                    </div>
                                                </div>
                                                <div class="space-y-1">
                                                    <div class="flex items-center justify-between">
                                                        <span class="text-muted-foreground text-xs">Color Theory</span>
                                                        <span class="font-medium text-xs">@critique.Ratings.ColorTheory.ToString("F1")/5</span>
                                                    </div>
                                                    <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                                        <div class="h-full bg-foreground transition-all" style="@($"width:{(critique.Ratings.ColorTheory / 5.0 * 100):F1}%")"></div>
                                                    </div>
                                                </div>
                                                <div class="space-y-1">
                                                    <div class="flex items-center justify-between">
                                                        <span class="text-muted-foreground text-xs">Technique</span>
                                                        <span class="font-medium text-xs">@critique.Ratings.Technique.ToString("F1")/5</span>
                                                    </div>
                                                    <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                                        <div class="h-full bg-foreground transition-all" style="@($"width:{(critique.Ratings.Technique / 5.0 * 100):F1}%")"></div>
                                                    </div>
                                                </div>
                                                <div class="space-y-1">
                                                    <div class="flex items-center justify-between">
                                                        <span class="text-muted-foreground text-xs">Originality</span>
                                                        <span class="font-medium text-xs">@critique.Ratings.Originality.ToString("F1")/5</span>
                                                    </div>
                                                    <div class="h-1.5 overflow-hidden rounded-full bg-muted">
                                                        <div class="h-full bg-foreground transition-all" style="@($"width:{(critique.Ratings.Originality / 5.0 * 100):F1}%")"></div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        @* Strengths *@
                                        <div>
                                            <div class="mb-1.5 flex items-center gap-1.5">
                                                <LucideIconCn Name="eye" Size="14" Class="size-3.5 text-emerald-500" />
                                                <span class="font-medium text-muted-foreground text-xs">Strengths</span>
                                            </div>
                                            <div class="space-y-1">
                                                @foreach (var strength in critique.Strengths)
                                                {
                                                    <div class="flex items-start gap-2 text-sm">
                                                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-emerald-500"></span>
                                                        <span>@strength</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>

                                        @* Areas for Growth *@
                                        <div>
                                            <div class="mb-1.5 flex items-center gap-1.5">
                                                <LucideIconCn Name="lightbulb" Size="14" Class="size-3.5 text-amber-500" />
                                                <span class="font-medium text-muted-foreground text-xs">Areas for Growth</span>
                                            </div>
                                            <div class="space-y-1">
                                                @foreach (var improvement in critique.Improvements)
                                                {
                                                    <div class="flex items-start gap-2 text-sm">
                                                        <span class="mt-1 size-1.5 shrink-0 rounded-full bg-amber-500"></span>
                                                        <span>@improvement</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            <span class="text-muted-foreground text-xs">@message.Timestamp</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <form class="border-t p-3" @onsubmit="HandleSubmit">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Describe your artwork for critique..." Class="flex-1" aria-label="Describe your artwork for critique..." />
                <ButtonCn type="submit" Size="ButtonSize.Icon" Disabled="@string.IsNullOrWhiteSpace(_input)" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </form>
    </div>
</section>

@code {
    private record ArtRatings(double Composition, double ColorTheory, double Technique, double Originality);

    private record ArtworkCritique(
        string Id,
        string Title,
        string Medium,
        string Style,
        ArtRatings Ratings,
        string[] Strengths,
        string[] Improvements,
        double OverallScore);

    private record ChatMessage(string Id, string Role, string Content, string Timestamp, ArtworkCritique? Critique = null);

    private string _input = "";

    private readonly List<ChatMessage> _messages =
    [
        new("1", "assistant",
            "Hello! I'm here to provide thoughtful art critiques. Share details about your artwork, and I'll analyze composition, technique, color theory, and overall impact.",
            "3:00 PM"),
        new("2", "user",
            "I'd like feedback on my oil painting of a sunset over mountains. It's a landscape piece with warm oranges and purples.",
            "3:05 PM"),
        new("3", "assistant",
            "I've analyzed your landscape painting. Here's my detailed critique with ratings and specific recommendations:",
            "3:05 PM",
            new ArtworkCritique(
                "1",
                "Mountain Sunset",
                "Oil on Canvas",
                "Impressionist Landscape",
                new ArtRatings(4.5, 5.0, 4.0, 3.5),
                ["Exceptional use of warm color palette", "Strong atmospheric perspective", "Confident brushwork in sky areas"],
                ["Add more depth to foreground elements", "Vary edge quality for visual interest", "Strengthen value contrast in focal area"],
                4.3)),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input))
            return;

        _messages.Add(new ChatMessage(
            $"{_messages.Count + 1}",
            "user",
            _input,
            "3:10 PM"));

        _input = "";
    }
}
