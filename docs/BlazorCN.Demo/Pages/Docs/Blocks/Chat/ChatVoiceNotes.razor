@* ============================================================
   Block: chat-voice-notes
   Title: ChatVoiceNotes
   Description: React chat block with voice message UI for Next.js featuring waveform visualizations, play controls, duration display, and microphone recording using shadcn/ui, TypeScript, and Tailwind CSS
   Source: original/blocks/chat/chat-voice-notes.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="text-xs">JL</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <p class="font-medium text-sm">Jordan Lee</p>
                <p class="text-muted-foreground text-xs">Engineering</p>
            </div>
            <span class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                Online
            </span>
        </div>

        @* Messages - flat layout *@
        <div class="flex-1 overflow-y-auto py-2" tabindex="0" role="group" aria-label="Messages">
            @foreach (var grp in _grouped)
            {
                var group = grp;
                <div class="mb-1">
                    @for (int i = 0; i < group.Length; i++)
                    {
                        var msg = group[i];
                        var isFirst = i == 0;
                        <div class="flex gap-2 px-4 py-0.5 hover:bg-accent">
                            <div class="flex w-8 shrink-0 items-start justify-center pt-0.5">
                                @if (isFirst)
                                {
                                    <AvatarCn Class="size-7">
                                        <AvatarFallbackCn Class="text-[10px]">@msg.Initials</AvatarFallbackCn>
                                    </AvatarCn>
                                }
                                else
                                {
                                    <span class="pt-1 text-muted-foreground text-[10px] opacity-0 group-hover:opacity-100">
                                        @msg.Time
                                    </span>
                                }
                            </div>
                            <div class="min-w-0 flex-1">
                                @if (isFirst)
                                {
                                    <div class="flex items-center gap-2">
                                        <span class="font-medium text-sm">@msg.Sender</span>
                                        <span class="text-muted-foreground text-[10px]">@msg.Time</span>
                                    </div>
                                }
                                @if (msg.Content != null)
                                {
                                    <p class="text-sm leading-relaxed">@msg.Content</p>
                                }
                                @if (msg.Voice != null)
                                {
                                    var voice = msg.Voice;
                                    var isPlaying = _playingId == msg.Id;
                                    <div class="mt-1 flex items-center gap-2.5 rounded-md bg-muted/50 px-3 py-2">
                                        <button type="button" aria-label="Play voice note from @msg.Sender"
                                                @onclick="@(() => TogglePlaying(msg.Id))"
                                                class="flex size-7 shrink-0 items-center justify-center rounded-full bg-foreground text-background transition-colors hover:bg-foreground/80">
                                            @if (isPlaying)
                                            {
                                                <LucideIconCn Name="pause" Size="12" Class="size-3" />
                                            }
                                            else
                                            {
                                                <LucideIconCn Name="play" Size="12" Class="size-3" />
                                            }
                                        </button>
                                        <div class="flex h-8 items-center gap-px">
                                            @foreach (var bar in voice.Bars)
                                            {
                                                var barHeight = bar;
                                                <div class="w-1 rounded-full bg-foreground/30"
                                                     style="@($"height:{barHeight * 2.5}px")"></div>
                                            }
                                        </div>
                                        <span class="ml-1 shrink-0 font-mono text-muted-foreground text-xs">
                                            @voice.Duration
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        @* Toolbar *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2 rounded-md border px-3 py-1.5">
                <InputCn @bind-Value="_input"
                         Placeholder="Type a message..."
                         Class="h-7 border-0 bg-transparent px-0 text-sm shadow-none focus-visible:ring-0" aria-label="Type a message..." />
                @if (!string.IsNullOrWhiteSpace(_input))
                {
                    <ButtonCn aria-label="Send message" type="submit" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                              Class="size-7 shrink-0 p-0 text-foreground">
                        <LucideIconCn Name="send" Size="14" Class="size-3.5" />
                    </ButtonCn>
                }
                else
                {
                    <ButtonCn aria-label="Record voice note" type="button" Size="ButtonSize.Sm" Variant="ButtonVariant.Ghost"
                              Class="size-7 shrink-0 p-0 text-muted-foreground">
                        <LucideIconCn Name="mic" Size="16" Class="size-4" />
                    </ButtonCn>
                }
            </form>
        </div>
    </div>
</section>

@code {
    private record VoiceNote(string Duration, int[] Bars);

    private record ChatMessage(string Id, string Sender, string Initials, string? Content, VoiceNote? Voice, string Time);

    private static readonly ChatMessage[] _messages =
    [
        new("1", "Jordan Lee", "JL", "Hey, I just left a voice note about the project timeline. Take a listen when you can.", null, "9:05 AM"),
        new("2", "Jordan Lee", "JL", null, new VoiceNote("0:42", [3, 5, 8, 6, 9, 4, 7, 10, 6, 8, 5, 3, 7, 9, 11, 8, 6, 4, 7, 5, 9, 6, 3, 8, 10, 7, 5, 4]), "9:05 AM"),
        new("3", "You", "YO", "Got it. The sprint deadline makes sense. Here's my thoughts on the API scope.", null, "9:12 AM"),
        new("4", "You", "YO", null, new VoiceNote("1:15", [4, 6, 3, 8, 11, 9, 7, 5, 8, 10, 6, 4, 7, 9, 5, 8, 11, 7, 6, 3, 9, 5, 8, 10, 7, 4, 6, 8, 5, 3]), "9:13 AM"),
        new("5", "Jordan Lee", "JL", "Makes sense. Let me send a quick follow-up.", null, "9:18 AM"),
        new("6", "Jordan Lee", "JL", null, new VoiceNote("0:23", [5, 8, 6, 10, 7, 4, 9, 6, 8, 5, 11, 7, 4, 8, 6, 9, 5, 7, 10, 6]), "9:19 AM"),
        new("7", "You", "YO", "Perfect, I agree with all of that. I'll draft the technical spec and share it by end of day.", null, "9:24 AM"),
        new("8", "Jordan Lee", "JL", null, new VoiceNote("0:08", [6, 9, 5, 7, 10, 8, 4, 6, 9, 7, 5, 8]), "9:26 AM"),
    ];

    private static readonly ChatMessage[][] _grouped = GroupMessages(_messages);

    private static ChatMessage[][] GroupMessages(ChatMessage[] msgs)
    {
        var groups = new System.Collections.Generic.List<System.Collections.Generic.List<ChatMessage>>();
        foreach (var msg in msgs)
        {
            if (groups.Count > 0 && groups[^1][0].Sender == msg.Sender)
                groups[^1].Add(msg);
            else
                groups.Add([msg]);
        }
        return groups.Select(g => g.ToArray()).ToArray();
    }

    private string? _playingId;
    private string _input = "";

    private void TogglePlaying(string id)
    {
        _playingId = _playingId == id ? null : id;
    }

    private void HandleSubmit()
    {
        if (!string.IsNullOrWhiteSpace(_input))
            _input = "";
    }
}
