@* ============================================================
   Block: chat-slack-style
   Title: ChatSlackStyle
   Description: React Slack-inspired workspace chat for Next.js with flat messages, bold sender names, thread reply counts, emoji reactions, and channel header using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-slack-style.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Channel header *@
        <div class="flex items-center gap-2 border-b px-4 py-3">
            <LucideIconCn Name="hash" Size="16" Class="size-4 text-muted-foreground" />
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">@_channel.Name</span>
                <p class="truncate text-muted-foreground text-xs">@_channel.Topic</p>
            </div>
            <div class="flex items-center gap-1 text-muted-foreground text-xs">
                <LucideIconCn Name="users" Size="14" Class="size-3.5" />
                <span class="tabular-nums">@_channel.MemberCount</span>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto">
            @foreach (var msg in _messages)
            {
                var msgId = msg.Id;

                @if (msg.IsUnreadDivider)
                {
                    <div class="flex items-center gap-3 px-4 py-2">
                        <div class="h-px flex-1 bg-red-400/60"></div>
                        <span class="shrink-0 font-medium text-red-500 text-[11px]">New</span>
                        <div class="h-px flex-1 bg-red-400/60"></div>
                    </div>
                }
                else
                {
                    <div class="relative px-4 py-2 transition-colors hover:bg-muted/30"
                         @onmouseenter="@(() => _hoveredMsg = msgId)"
                         @onmouseleave="@(() => _hoveredMsg = null)">

                        @* Hover toolbar *@
                        @if (_hoveredMsg == msg.Id)
                        {
                            <div class="absolute top-1 right-4 flex items-center gap-0.5 rounded-md border bg-card p-0.5 shadow-sm">
                                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-6 text-muted-foreground hover:text-foreground">
                                    <LucideIconCn Name="smile" Size="14" Class="size-3.5" />
                                </ButtonCn>
                                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-6 text-muted-foreground hover:text-foreground">
                                    <LucideIconCn Name="message-square" Size="14" Class="size-3.5" />
                                </ButtonCn>
                                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-6 text-muted-foreground hover:text-foreground">
                                    <LucideIconCn Name="more-horizontal" Size="14" Class="size-3.5" />
                                </ButtonCn>
                            </div>
                        }

                        @* Flat message row: avatar + name + timestamp + content *@
                        <div class="flex gap-3">
                            <AvatarCn Class="mt-0.5 size-8 shrink-0">
                                <AvatarFallbackCn Class="@Cn.Merge("text-[10px]", msg.Color)">@msg.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            <div class="min-w-0 flex-1">
                                <div class="flex items-baseline gap-2">
                                    <span class="font-bold text-sm">@msg.Sender</span>
                                    <span class="text-muted-foreground text-[10px]">@msg.Timestamp</span>
                                </div>
                                <p class="mt-0.5 text-sm leading-relaxed">@msg.Content</p>

                                @* Emoji reaction pills *@
                                @if (msg.Reactions != null && msg.Reactions.Length > 0)
                                {
                                    <div class="mt-1.5 flex flex-wrap items-center gap-1">
                                        @foreach (var reaction in msg.Reactions)
                                        {
                                            var r = reaction;
                                            <button type="button"
                                                    class="@Cn.Merge("flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs transition-colors hover:bg-muted/50", r.Reacted ? "border-blue-200 bg-blue-50 dark:border-blue-800 dark:bg-blue-950/30" : "border-transparent bg-muted/50")">
                                                <span>@r.Emoji</span>
                                                <span class="tabular-nums text-[10px]">@r.Count</span>
                                            </button>
                                        }
                                        <button type="button"
                                                class="flex size-6 items-center justify-center rounded-full border border-dashed text-muted-foreground transition-colors hover:border-foreground/30 hover:text-foreground">
                                            <LucideIconCn Name="plus" Size="12" Class="size-3" />
                                        </button>
                                    </div>
                                }

                                @* Thread reply count *@
                                @if (msg.ThreadCount.HasValue)
                                {
                                    <button type="button"
                                            class="mt-1.5 flex items-center gap-1.5 text-blue-600 text-xs transition-colors hover:underline dark:text-blue-400">
                                        <LucideIconCn Name="message-square" Size="12" Class="size-3" />
                                        @msg.ThreadCount replies
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" class="flex items-center gap-2">
                <LucideIconCn Name="plus" Size="20" Class="size-5 shrink-0 text-muted-foreground" />
                <InputCn @bind-Value="_input"
                         Placeholder="@($"Message #{ _channel.Name}")"
                         Class="h-9 flex-1 border-0 bg-muted/50 shadow-none focus-visible:ring-0" />
                <ButtonCn type="button" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Class="size-8 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="smile" Size="16" Class="size-4" />
                </ButtonCn>
                <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost"
                          Disabled="@string.IsNullOrWhiteSpace(_input)"
                          Class="size-8 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>
    </div>
</section>

@code {
    private record ChannelInfo(string Name, string Topic, int MemberCount);

    private record Reaction(string Emoji, int Count, bool Reacted);

    private record Message(
        string Id,
        string Sender,
        string Initials,
        string Color,
        string Content,
        string Timestamp,
        int? ThreadCount = null,
        Reaction[]? Reactions = null,
        bool IsUnreadDivider = false
    );

    private static readonly ChannelInfo _channel = new(
        "engineering",
        "Ship fast, break nothing. CI/CD, infra, and code reviews.",
        24
    );

    private string? _hoveredMsg;
    private string _input = "";

    private static readonly Message[] _messages =
    [
        new("1", "Mia Chen", "MC",
            "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300",
            "I just published the new color tokens to the design system package. v2.4.0 is live on npm.",
            "10:15 AM",
            ThreadCount: 5,
            Reactions: [new("\U0001F389", 4, true), new("\U0001F680", 2, false)]),
        new("2", "Leo Park", "LP",
            "bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300",
            "Nice! I noticed the spacing scale changed from 4px base to 4px with half-step support. Was that intentional?",
            "10:18 AM"),
        new("3", "Mia Chen", "MC",
            "bg-emerald-100 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300",
            "Yes, we needed finer control for the compact data table variants. The base grid is still 4px but you can now use 2px increments for specific cases.",
            "10:19 AM",
            Reactions: [new("\U0001F44D", 3, false)]),
        new("divider", "", "", "", "", "", IsUnreadDivider: true),
        new("4", "Sara Ahmed", "SA",
            "bg-violet-100 text-violet-700 dark:bg-violet-900/40 dark:text-violet-300",
            "Quick heads up — I'm updating the Button component today. Adding a `loading` prop that shows a spinner and disables interaction. PR should be ready for review by EOD.",
            "10:24 AM",
            ThreadCount: 3,
            Reactions: [new("\U0001F440", 5, true)]),
        new("5", "James Liu", "JL",
            "bg-amber-100 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300",
            "Can we also add a `loadingText` prop so the button label can change during loading? Like \"Saving...\" instead of just a spinner.",
            "10:26 AM"),
        new("6", "Sara Ahmed", "SA",
