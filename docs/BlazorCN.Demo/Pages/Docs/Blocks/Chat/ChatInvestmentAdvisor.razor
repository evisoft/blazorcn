@* ============================================================
   Block: chat-investment-advisor
   Title: ChatInvestmentAdvisor
   Description: Investment advisory chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS. Features portfolio analysis, risk indicators, asset allocations, and personalized recommendations.
   Source: original/blocks/chat/chat-investment-advisor.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="pie-chart" Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Investment Advisor</h2>
                </div>
                <BadgeCn Variant="BadgeVariant.Secondary"
                         Class="@Cn.Merge("gap-1.5", _portfolioData.TotalReturn >= 0 ? "text-emerald-500" : "text-red-500")">
                    @if (_portfolioData.TotalReturn >= 0)
                    {
                        <LucideIconCn Name="trending-up" Size="12" Class="size-3" />
                    }
                    else
                    {
                        <LucideIconCn Name="trending-down" Size="12" Class="size-3" />
                    }
                    @(_portfolioData.TotalReturn > 0 ? "+" : "")@(_portfolioData.TotalReturn)%
                </BadgeCn>
            </div>
        </div>

        @* Portfolio Summary *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-3">
                <div class="rounded-md bg-muted/50 p-2">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="dollar-sign" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Total Value</span>
                    </div>
                    <p class="mt-1 text-lg font-semibold tabular-nums">
                        $@((_portfolioData.TotalValue / 1000.0).ToString("F0"))K
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 p-2">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="shield" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Risk Score</span>
                    </div>
                    <p class="mt-1 text-lg font-semibold tabular-nums">
                        @_portfolioData.RiskScore/100
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 p-2">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="target" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Holdings</span>
                    </div>
                    <p class="mt-1 text-lg font-semibold tabular-nums">
                        @_portfolioData.Holdings.Length
                    </p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4">
                @foreach (var message in _messages)
                {
                    @if (message.Type == "user")
                    {
                        <div class="flex justify-end">
                            <div class="flex max-w-[85%] items-start gap-2">
                                <div class="rounded-lg bg-primary px-3 py-2 text-primary-foreground">
                                    <p class="text-sm">@message.Content</p>
                                    <span class="mt-1 block text-xs opacity-70">@message.Timestamp</span>
                                </div>
                                <AvatarCn Class="size-8 shrink-0">
                                    <div class="flex size-full items-center justify-center bg-primary text-xs text-primary-foreground">
                                        U
                                    </div>
                                </AvatarCn>
                            </div>
                        </div>
                    }
                    else
                    {
                        var avatarClass = Cn.Merge(
                            "flex size-full items-center justify-center text-xs",
                            message.Type == "analysis" ? "bg-blue-500 text-white" : "",
                            message.Type == "recommendation" ? "bg-amber-500 text-white" : "",
                            message.Type == "system" ? "bg-muted" : "");
                        var bubbleClass = Cn.Merge(
                            "rounded-lg px-3 py-2",
                            message.Type == "analysis" ? "bg-blue-500/10" : "",
                            message.Type == "recommendation" ? "bg-amber-500/10" : "",
                            message.Type == "system" ? "bg-muted" : "");
                        <div class="flex items-start gap-2">
                            <AvatarCn Class="size-8 shrink-0">
                                <div class="@avatarClass">
                                    @if (message.Type == "analysis")
                                    {
                                        <LucideIconCn Name="pie-chart" Size="16" Class="size-4" />
                                    }
                                    else if (message.Type == "recommendation")
                                    {
                                        <LucideIconCn Name="alert-triangle" Size="16" Class="size-4" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="trending-up" Size="16" Class="size-4" />
                                    }
                                </div>
                            </AvatarCn>
                            <div class="max-w-[85%]">
                                <div class="@bubbleClass">
                                    <p class="text-sm">@message.Content</p>
                                    @if (message.PortfolioData != null)
                                    {
                                        var pd = message.PortfolioData;
                                        <div class="mt-3 space-y-2">
                                            @foreach (var holding in pd.Holdings)
                                            {
                                                var riskColor = GetRiskColor(holding.Risk);
                                                var returnColor = holding.Return >= 0 ? "text-emerald-500" : "text-red-500";
                                                <div class="rounded-md border bg-card p-2">
                                                    <div class="flex items-start justify-between">
                                                        <div class="flex-1">
                                                            <div class="flex items-center gap-2">
                                                                <span class="font-mono text-xs font-medium">@holding.Symbol</span>
                                                                <BadgeCn Variant="BadgeVariant.Secondary"
                                                                         Class="@Cn.Merge("text-xs", riskColor)">
                                                                    @holding.Risk risk
                                                                </BadgeCn>
                                                            </div>
                                                            <p class="mt-0.5 text-xs text-muted-foreground">@holding.Name</p>
                                                        </div>
                                                        <div class="text-right">
                                                            <p class="font-mono text-xs font-medium">$@((holding.Value / 1000.0).ToString("F1"))K</p>
                                                            <p class="@returnColor text-xs">
                                                                @(holding.Return > 0 ? "+" : "")@(holding.Return)%
                                                            </p>
                                                        </div>
                                                    </div>
                                                    <div class="mt-2">
                                                        <div class="flex items-center justify-between text-xs text-muted-foreground">
                                                            <span>Allocation</span>
                                                            <span>@holding.Allocation%</span>
                                                        </div>
                                                        <ProgressCn Value="@holding.Allocation" Class="mt-1 h-1.5" aria-label="Progress" />
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                    <span class="mt-1 block text-xs text-muted-foreground">@message.Timestamp</span>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="mb-2 flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="text-xs"
                          OnClick="@(() => ProcessCommand("analyze portfolio"))">
                    Portfolio
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="text-xs"
                          OnClick="@(() => ProcessCommand("risk analysis"))">
                    Risk
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="text-xs"
                          OnClick="@(() => ProcessCommand("rebalance"))">
                    Rebalance
                </ButtonCn>
            </div>
            <div class="flex gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Ask about your investments..."
                         Class="flex-1"
                         @onkeydown="@HandleKeyDown" aria-label="Ask about your investments..." />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record Holding(string Symbol, string Name, int Allocation, int Value, double Return, string Risk);
    private record PortfolioAnalysis(int TotalValue, double TotalReturn, int RiskScore, Holding[] Holdings);
    private record Message(string Id, string Type, string Content, string Timestamp, PortfolioAnalysis? PortfolioData = null);

    private static readonly PortfolioAnalysis _portfolioData = new(
        TotalValue: 125000,
        TotalReturn: 8.4,
        RiskScore: 65,
        Holdings:
        [
            new("VTI", "Total Stock Market ETF",  40, 50000, 12.3, "medium"),
            new("BND", "Total Bond Market ETF",   30, 37500,  3.2, "low"),
            new("VEA", "International Stock ETF", 20, 25000,  6.8, "medium"),
            new("VNQ", "Real Estate ETF",         10, 12500, 15.2, "high"),
        ]
    );

    private List<Message> _messages =
    [
        new("1", "system",
            "Welcome to your investment advisor. Ask about your portfolio, risk analysis, or rebalancing recommendations.",
            "9:00 AM"),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        AddMessage("user", _input);
        ProcessCommand(_input.ToLowerInvariant());
        _input = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") HandleSubmit();
    }

    private void AddMessage(string type, string content, PortfolioAnalysis? portfolioData = null)
    {
        var msg = new Message(
            Id: DateTime.UtcNow.Ticks.ToString(),
            Type: type,
            Content: content,
            Timestamp: DateTime.Now.ToString("h:mm tt"),
            PortfolioData: portfolioData);
        _messages = [.._messages, msg];
    }

    private void ProcessCommand(string command)
    {
        if (command.Contains("portfolio") || command.Contains("holdings") || command.Contains("analyze"))
            AnalyzePortfolio();
        else if (command.Contains("risk") || command.Contains("exposure"))
            AnalyzeRisk();
        else if (command.Contains("rebalance") || command.Contains("allocation"))
            SuggestRebalance();
        else if (command.Contains("performance") || command.Contains("return"))
            ShowPerformance();
        else
            AddMessage("system", "I can analyze your portfolio, assess risk, suggest rebalancing, or show performance metrics. What would you like to know?");
    }

    private void AnalyzePortfolio()
    {
        AddMessage("analysis", "Here's your current portfolio breakdown:", _portfolioData);
        AddMessage("system",
            $"Your portfolio of ${_portfolioData.TotalValue.ToString("N0")} is diversified across {_portfolioData.Holdings.Length} holdings with a moderate risk profile.");
    }

    private void AnalyzeRisk()
    {
        var highRisk = _portfolioData.Holdings.Where(h => h.Risk == "high").ToArray();
        var riskLevel = _portfolioData.RiskScore < 40 ? "conservative"
            : _portfolioData.RiskScore < 70 ? "moderate"
            : "aggressive";

        AddMessage("analysis",
            $"Your portfolio has a {riskLevel} risk profile (score: {_portfolioData.RiskScore}/100).");

        if (highRisk.Length > 0)
        {
            var totalHighRiskAlloc = highRisk.Sum(h => h.Allocation);
            AddMessage("recommendation",
                $"{highRisk.Length} high-risk positions account for {totalHighRiskAlloc}% of your portfolio. Consider your risk tolerance.");
        }
    }

    private void SuggestRebalance()
    {
        const int targetStocks = 60;
        var currentStocks = _portfolioData.Holdings
            .Where(h => h.Symbol == "VTI" || h.Symbol == "VEA")
            .Sum(h => h.Allocation);
        var drift = currentStocks - targetStocks;

        AddMessage("recommendation", "Target allocation: 60% stocks, 30% bonds, 10% alternatives");

        if (Math.Abs(drift) > 5)
            AddMessage("recommendation",
                $"Your stock allocation is {(drift > 0 ? "over" : "under")}weight by {Math.Abs(drift).ToString("F1")}%. Consider rebalancing.");
        else
            AddMessage("system", "Your portfolio is well-balanced. No action needed.");
    }

    private void ShowPerformance()
    {
        var top = _portfolioData.Holdings.OrderByDescending(h => h.Return).First();
        var bottom = _portfolioData.Holdings.OrderBy(h => h.Return).First();

        AddMessage("analysis",
            $"Overall portfolio return: {(_portfolioData.TotalReturn > 0 ? "+" : "")}{_portfolioData.TotalReturn}%");
        AddMessage("system",
            $"Top performer: {top.Symbol} (+{top.Return}%) | Lagging: {bottom.Symbol} (+{bottom.Return}%)");
    }

    private static string GetRiskColor(string risk) => risk switch
    {
        "low"    => "text-emerald-500",
        "medium" => "text-amber-500",
        "high"   => "text-red-500",
        _        => "text-muted-foreground",
    };
}
