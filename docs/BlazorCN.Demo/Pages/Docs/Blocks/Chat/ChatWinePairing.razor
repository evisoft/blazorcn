@* ============================================================
   Block: chat-wine-pairing
   Title: ChatWinePairing
   Description: A wine sommelier chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS featuring wine cards, food pairing suggestions, and tasting notes
   Source: original/blocks/chat/chat-wine-pairing.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <div class="flex size-9 items-center justify-center rounded-full bg-muted">
                <LucideIconCn Name="glass-water" Size="20" Class="size-5 text-foreground" />
            </div>
            <div class="min-w-0 flex-1">
                <h2 class="font-medium text-sm">Wine Sommelier</h2>
                <p class="text-muted-foreground text-xs">Expert pairing recommendations</p>
            </div>
            <LucideIconCn Name="grape" Size="20" Class="size-5 text-muted-foreground/60" />
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3">
            <div class="space-y-4">
                @foreach (var message in _messages)
                {
                    <div class="@Cn.Merge("flex gap-3", message.Role == "user" ? "flex-row-reverse" : "")">
                        <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full", message.Role == "assistant" ? "bg-muted" : "bg-foreground text-background")">
                            @if (message.Role == "assistant")
                            {
                                <LucideIconCn Name="glass-water" Size="16" Class="size-4" />
                            }
                            else
                            {
                                <span class="font-medium text-xs">You</span>
                            }
                        </div>
                        <div class="@Cn.Merge("min-w-0 flex-1 space-y-1", message.Role == "user" ? "flex flex-col items-end" : "")">
                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", message.Role == "assistant" ? "bg-muted" : "bg-foreground text-background")">
                                @message.Content
                            </div>
                            @if (message.Wine != null)
                            {
                                @* Wine Card *@
                                <div class="mt-3 overflow-hidden rounded-md border bg-muted/50">
                                    <div class="border-b bg-card px-3 py-2">
                                        <div class="flex items-start justify-between gap-2">
                                            <div class="min-w-0 flex-1">
                                                <h3 class="font-medium text-sm">@message.Wine.Name</h3>
                                                <div class="mt-1 flex flex-wrap items-center gap-2 text-muted-foreground text-xs">
                                                    <span class="flex items-center gap-1">
                                                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                                        @message.Wine.Region
                                                    </span>
                                                    <span class="flex items-center gap-1">
                                                        <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                                        @message.Wine.Vintage
                                                    </span>
                                                </div>
                                            </div>
                                            <span class="shrink-0 font-semibold text-sm">@message.Wine.Price</span>
                                        </div>
                                    </div>
                                    <div class="space-y-3 px-3 py-2">
                                        <div>
                                            <span class="font-medium text-muted-foreground text-xs">Varietal</span>
                                            <p class="mt-0.5 text-sm">@message.Wine.Varietal</p>
                                        </div>
                                        <div>
                                            <span class="font-medium text-muted-foreground text-xs">Tasting Notes</span>
                                            <div class="mt-1 flex flex-wrap gap-1">
                                                @foreach (var note in message.Wine.TastingNotes)
                                                {
                                                    <span class="rounded-md bg-muted px-2 py-0.5 text-xs">@note</span>
                                                }
                                            </div>
                                        </div>
                                        <div>
                                            <span class="font-medium text-muted-foreground text-xs">Food Pairings</span>
                                            <div class="mt-1 flex flex-wrap gap-1">
                                                @foreach (var pairing in message.Wine.FoodPairings)
                                                {
                                                    <span class="flex items-center gap-1 rounded-md bg-emerald-500/10 px-2 py-0.5 text-emerald-600 text-xs dark:text-emerald-400">
                                                        <LucideIconCn Name="sparkles" Size="12" Class="size-3" />
                                                        @pairing
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            <span class="text-muted-foreground text-xs">@message.Timestamp</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <form class="border-t p-3" @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
            <div class="flex gap-2">
                <InputCn @bind-Value="_input" Placeholder="Describe your meal or preferences..." Class="flex-1" />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </form>

    </div>
</section>

@code {
    private string _input = "";

    private record Wine(
        string Id,
        string Name,
        string Region,
        string Varietal,
        string Vintage,
        string[] TastingNotes,
        string[] FoodPairings,
        string Price);

    private record Message(string Id, string Role, string Content, string Timestamp, Wine? Wine = null);

    private static readonly Wine _chateau = new(
        "1",
        "Château Margaux",
        "Bordeaux, France",
        "Cabernet Sauvignon Blend",
        "2015",
        ["Blackcurrant", "Cedar", "Tobacco", "Velvet tannins"],
        ["Grilled lamb chops", "Beef tenderloin", "Aged cheeses"],
        "$450");

    private static readonly Wine _cloudyBay = new(
        "2",
        "Cloudy Bay Sauvignon Blanc",
        "Marlborough, New Zealand",
        "Sauvignon Blanc",
        "2022",
        ["Citrus", "Passionfruit", "Fresh herbs", "Crisp acidity"],
        ["Oysters", "Goat cheese salad", "Grilled fish"],
        "$32");

    private List<Message> _messages =
    [
        new("1", "assistant",
            "Hello! I'm your personal wine sommelier. Tell me about your meal or flavor preferences, and I'll recommend the perfect wine pairing.",
            "10:00 AM"),
        new("2", "user",
            "I'm planning to grill lamb chops tonight. What wine would you recommend?",
            "10:02 AM"),
        new("3", "assistant",
            "Excellent choice! For grilled lamb chops, I highly recommend a Bordeaux blend. The robust tannins and dark fruit notes complement the rich, savory flavors beautifully.",
            "10:02 AM",
            _chateau),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _messages.Add(new($"{_messages.Count + 1}", "user", _input, "Just now"));
        _input = "";
    }
}
