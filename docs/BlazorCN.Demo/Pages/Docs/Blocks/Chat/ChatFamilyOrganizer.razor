@* ============================================================
   Block: chat-family-organizer
   Title: ChatFamilyOrganizer
   Description: Family organization chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS. Features chore assignments, calendar events, shared shopping lists, and member avatars.
   Source: original/blocks/chat/chat-family-organizer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="users" Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Family Organizer</h2>
                </div>
                <div class="flex items-center gap-2">
                    @foreach (var member in _familyMembers)
                    {
                        var m = member;
                        <div class="@Cn.Merge("size-2 rounded-full", m.Color)" title="@m.Name"></div>
                    }
                </div>
            </div>
        </div>

        @* Summary Cards *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-3">
                <div class="rounded-md bg-muted/50 p-2">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="check-circle-2" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Tasks</span>
                    </div>
                    <p class="mt-1 text-lg font-semibold tabular-nums">
                        @(_tasks.Count(t => !t.Completed))/@_tasks.Count
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 p-2">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Events</span>
                    </div>
                    <p class="mt-1 text-lg font-semibold tabular-nums">@_events.Count</p>
                </div>
                <div class="rounded-md bg-muted/50 p-2">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="shopping-cart" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Shopping</span>
                    </div>
                    <p class="mt-1 text-lg font-semibold tabular-nums">
                        @_shopping.Count(s => !s.Purchased)
                    </p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4">

                @foreach (var message in _messages)
                {
                    var msg = message;
                    @if (msg.Type == "user")
                    {
                        <div class="flex justify-end">
                            <div class="flex max-w-[85%] items-start gap-2">
                                <div class="rounded-lg bg-primary px-3 py-2 text-primary-foreground">
                                    <p class="text-sm">@msg.Content</p>
                                    <span class="mt-1 block text-xs opacity-70">@msg.Timestamp</span>
                                </div>
                                <AvatarCn Class="size-8 shrink-0">
                                    <AvatarFallbackCn Class="bg-primary text-xs text-primary-foreground">U</AvatarFallbackCn>
                                </AvatarCn>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-start gap-2">
                            <AvatarCn Class="size-8 shrink-0">
                                <AvatarFallbackCn Class="bg-muted text-xs">
                                    @if (msg.Type == "task")
                                    {
                                        <LucideIconCn Name="check-circle-2" Size="16" Class="size-4" />
                                    }
                                    else if (msg.Type == "event")
                                    {
                                        <LucideIconCn Name="calendar" Size="16" Class="size-4" />
                                    }
                                    else if (msg.Type == "list")
                                    {
                                        <LucideIconCn Name="shopping-cart" Size="16" Class="size-4" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="users" Size="16" Class="size-4" />
                                    }
                                </AvatarFallbackCn>
                            </AvatarCn>
                            <div class="max-w-[85%]">
                                <div class="rounded-lg bg-muted px-3 py-2">
                                    <p class="text-sm">@msg.Content</p>
                                    <span class="mt-1 block text-xs text-muted-foreground">@msg.Timestamp</span>
                                </div>
                            </div>
                        </div>
                    }
                }

                @* Pending Tasks Display *@
                @if (_tasks.Any(t => !t.Completed))
                {
                    <div class="rounded-md border bg-muted/50 p-3">
                        <h3 class="mb-2 text-xs font-medium text-muted-foreground">Pending Tasks</h3>
                        <div class="space-y-2">
                            @foreach (var task in _tasks.Where(t => !t.Completed))
                            {
                                var t = task;
                                <div class="flex items-center gap-2 text-sm">
                                    <LucideIconCn Name="circle" Size="12" Class="size-3 text-muted-foreground" />
                                    <span>@t.Title</span>
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto text-xs">@t.Assignee</BadgeCn>
                                </div>
                            }
                        </div>
                    </div>
                }

                @* Upcoming Events *@
                @if (_events.Count > 0)
                {
                    <div class="rounded-md border bg-muted/50 p-3">
                        <h3 class="mb-2 text-xs font-medium text-muted-foreground">Upcoming Events</h3>
                        <div class="space-y-2">
                            @foreach (var ev in _events)
                            {
                                var e = ev;
                                <div class="flex items-center gap-2 text-sm">
                                    <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                                    <span>@e.Title</span>
                                    <span class="ml-auto text-xs text-muted-foreground">@e.Date</span>
                                </div>
                            }
                        </div>
                    </div>
                }

            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="mb-2 flex gap-2">
                @foreach (var member in _familyMembers)
                {
                    var m = member;
                    <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="gap-1.5" OnClick="@(() => QuickAssign(m.Name))">
                        <div class="@Cn.Merge("size-2 rounded-full", m.Color)"></div>
                        <span class="text-xs">@m.Name</span>
                    </ButtonCn>
                }
            </div>
            <div class="flex gap-2">
                <InputCn
                    @bind-Value="_input"
                    Placeholder="Type a command..."
                    Class="flex-1"
                    @onkeydown="@HandleKeyDown" aria-label="Type a command..." />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record FamilyMember(string Name, string Color);
    private record Message(string Id, string Type, string Content, string Timestamp, string? Member = null);
    private record TaskItem(string Id, string Title, string Assignee, bool Completed);
    private record CalendarEvent(string Id, string Title, string Date);
    private record ShoppingItem(string Id, string Item, bool Purchased);

    private static readonly FamilyMember[] _familyMembers =
    [
        new("Sarah", "bg-blue-500"),
        new("Mike",  "bg-green-500"),
        new("Emma",  "bg-purple-500"),
        new("Jack",  "bg-orange-500"),
    ];

    private List<Message> _messages =
    [
        new("1", "system", "Family organizer active. Type 'help' to see available commands or use quick actions below.", "9:00 AM"),
    ];

    private List<TaskItem> _tasks =
    [
        new("1", "Do the dishes", "Sarah", false),
        new("2", "Walk the dog",  "Mike",  true),
        new("3", "Homework",      "Emma",  false),
    ];

    private List<CalendarEvent> _events =
    [
        new("1", "Soccer practice",    "Tomorrow 4:00 PM"),
        new("2", "Dentist appointment","Friday 2:00 PM"),
    ];

    private List<ShoppingItem> _shopping =
    [
        new("1", "Milk",  false),
        new("2", "Bread", false),
        new("3", "Eggs",  true),
    ];

    private void AddMessage(string type, string content, string? member = null)
    {
        var newMessage = new Message(
            Id: DateTime.UtcNow.Ticks.ToString(),
            Type: type,
            Content: content,
            Timestamp: DateTime.Now.ToString("h:mm tt"),
            Member: member
        );
        _messages = [.._messages, newMessage];
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        AddMessage("user", _input);
        ProcessCommand(_input.ToLowerInvariant());
        _input = "";
    }

    private void ProcessCommand(string command)
    {
        if (command.Contains("assign") && command.Contains(" to "))
        {
            var match = System.Text.RegularExpressions.Regex.Match(command, @"assign (.+) to (\w+)");
            if (match.Success)
            {
                var taskTitle = match.Groups[1].Value.Trim();
                var assigneeLower = match.Groups[2].Value;
                var assignee = char.ToUpper(assigneeLower[0]) + assigneeLower.Substring(1);
                var newTask = new TaskItem(DateTime.UtcNow.Ticks.ToString(), taskTitle, assignee, false);
                _tasks = [.._tasks, newTask];
                AddMessage("task", $"Assigned \"{taskTitle}\" to {assignee}");
            }
        }
        else if (command.Contains("complete"))
        {
            var taskName = command.Replace("complete", "").Trim();
            _tasks = _tasks.Select(t => t.Title.ToLowerInvariant().Contains(taskName) ? t with { Completed = true } : t).ToList();
            AddMessage("task", "Marked task as complete");
        }
        else if (command.Contains("add") && command.Contains("event"))
        {
            var match = System.Text.RegularExpressions.Regex.Match(command, @"add event (.+) on (.+)");
            if (match.Success)
            {
                var title = match.Groups[1].Value.Trim();
                var date = match.Groups[2].Value.Trim();
                var newEvent = new CalendarEvent(DateTime.UtcNow.Ticks.ToString(), title, date);
                _events = [.._events, newEvent];
                AddMessage("event", $"Added event: {title} on {date}");
            }
        }
        else if (command.Contains("add") && command.Contains("shopping"))
        {
            var match = System.Text.RegularExpressions.Regex.Match(command, @"add (.+) to shopping");
            if (match.Success)
            {
                var item = match.Groups[1].Value.Trim();
                var newItem = new ShoppingItem(DateTime.UtcNow.Ticks.ToString(), item, false);
                _shopping = [.._shopping, newItem];
                AddMessage("list", $"Added {item} to shopping list");
            }
        }
        else if (command == "help")
        {
            AddMessage("system", "Commands: assign [task] to [name], complete [task], add event [name] on [date], add [item] to shopping list");
        }
        else
        {
            AddMessage("system", "Command not recognized. Type 'help' for options.");
        }
    }

    private void QuickAssign(string assignee)
    {
        var newTask = new TaskItem(DateTime.UtcNow.Ticks.ToString(), "New task", assignee, false);
        _tasks = [.._tasks, newTask];
        AddMessage("task", $"Quick assigned task to {assignee}");
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") HandleSubmit();
    }
}
