@* ============================================================
   Block: chat-apartment-hunt
   Title: ChatApartmentHunt
   Description: React apartment hunting chat block for Next.js with property listing cards, price comparisons, amenity tags, neighborhood info, and schedule viewing buttons using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-apartment-hunt.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="bg-muted text-xs">
                    <LucideIconCn Name="building" Size="14" Class="size-3.5" />
                </AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Apartment Finder</span>
                <p class="text-muted-foreground text-xs">AI rental assistant</p>
            </div>
        </div>

        @* Search criteria bar *@
        <div class="flex items-center gap-3 border-b px-4 py-2.5">
            <span class="text-muted-foreground text-xs">@_searchCriteria.Budget</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">@_searchCriteria.Area</span>
            <span class="text-muted-foreground text-xs">·</span>
            <span class="text-muted-foreground text-xs">@_searchCriteria.Beds</span>
            <BadgeCn Variant="BadgeVariant.Secondary" Class="ml-auto font-normal text-xs">
                12 matches
            </BadgeCn>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-4">
            <div class="flex flex-col gap-4">
                @foreach (var msg in _messages)
                {
                    <div class="@(msg.Role == "renter" ? "flex justify-end" : "flex justify-start")">
                        <div class="@(msg.Role == "renter"
                            ? "max-w-[85%] rounded-2xl rounded-br-sm bg-primary px-3.5 py-2.5 text-primary-foreground"
                            : "max-w-[85%] rounded-2xl rounded-bl-sm bg-muted/50 px-3.5 py-2.5")">
                            @if (!string.IsNullOrEmpty(msg.Content))
                            {
                                <p class="text-sm leading-relaxed">@msg.Content</p>
                            }
                            @if (msg.Listing != null)
                            {
                                var listing = msg.Listing;
                                var walkScoreColor = listing.WalkScore >= 90
                                    ? "text-emerald-600 dark:text-emerald-400"
                                    : listing.WalkScore >= 70
                                        ? "text-amber-600 dark:text-amber-400"
                                        : "text-red-600 dark:text-red-400";
                                <div class="mt-2 rounded-md border bg-card p-3">
                                    <div class="mb-1 flex items-center justify-between">
                                        <div class="flex items-center gap-1.5">
                                            <LucideIconCn Name="building" Size="14" Class="size-3.5 text-muted-foreground" />
                                            <span class="font-medium text-sm">@listing.Address</span>
                                        </div>
                                        <span class="font-semibold text-sm tabular-nums">
                                            @listing.Rent
                                            <span class="font-normal text-muted-foreground text-xs">/mo</span>
                                        </span>
                                    </div>
                                    <p class="mb-2.5 text-muted-foreground text-xs">
                                        @listing.Neighborhood · @listing.Transit
                                    </p>

                                    <div class="mb-2.5 flex items-center gap-3">
                                        <span class="flex items-center gap-1 text-xs">
                                            <LucideIconCn Name="bed-double" Size="12" Class="size-3 text-muted-foreground" />
                                            @listing.Bedrooms BR
                                        </span>
                                        <span class="flex items-center gap-1 text-xs">
                                            <LucideIconCn Name="bath" Size="12" Class="size-3 text-muted-foreground" />
                                            @listing.Bathrooms BA
                                        </span>
                                        <span class="flex items-center gap-1 text-xs">
                                            <LucideIconCn Name="ruler" Size="12" Class="size-3 text-muted-foreground" />
                                            @listing.Sqft sqft
                                        </span>
                                        <span class="flex items-center gap-1 text-xs">
                                            <LucideIconCn Name="footprints" Size="12" Class="size-3 text-muted-foreground" />
                                            <span class="@($"font-medium tabular-nums {walkScoreColor}")">@listing.WalkScore</span>
                                        </span>
                                        @if (listing.PetFriendly)
                                        {
                                            <span class="flex items-center gap-1 text-xs text-muted-foreground">
                                                <LucideIconCn Name="dog" Size="12" Class="size-3" />
                                                Pets OK
                                            </span>
                                        }
                                    </div>

                                    <div class="mb-2.5 flex flex-wrap gap-1">
                                        @foreach (var amenity in listing.Amenities)
                                        {
                                            <span class="rounded-full bg-muted/50 px-2 py-0.5 text-muted-foreground text-xs">
                                                @amenity
                                            </span>
                                        }
                                    </div>

                                    <div class="flex items-center justify-between border-t pt-2.5">
                                        <span class="flex items-center gap-1 text-muted-foreground text-xs">
                                            <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                            Available @listing.AvailableDate
                                        </span>
                                        <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="h-7 text-xs">
                                            Schedule viewing
                                        </ButtonCn>
                                    </div>
                                </div>
                            }
                            <span class="@(msg.Role == "renter"
                                ? "mt-1 block text-right text-xs text-primary-foreground/60"
                                : "mt-1 block text-right text-xs text-muted-foreground")">
                                @msg.Timestamp
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative">
                <TextareaCn
                    @bind-Value="_input"
                    Placeholder="Describe your ideal apartment..."
                    Rows="1"
                    Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-12 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                <ButtonCn
                    type="submit"
                    Size="ButtonSize.Icon"
                    Variant="ButtonVariant.Ghost"
                    Disabled="@(string.IsNullOrWhiteSpace(_input))"
                    Class="absolute top-1/2 right-1 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                    OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record SearchCriteria(string Budget, string Area, string Beds, string MoveIn);

    private record Listing(
        string Address,
        string Neighborhood,
        string Rent,
        int Sqft,
        int Bedrooms,
        int Bathrooms,
        string AvailableDate,
        int WalkScore,
        bool PetFriendly,
        string[] Amenities,
        string Transit);

    private record Message(string Id, string Role, string Content, string Timestamp, Listing? Listing = null);

    private readonly SearchCriteria _searchCriteria = new("$2,000 - $2,800", "Brooklyn, NY", "1-2 BR", "May 2026");

    private readonly Message[] _messages =
    [
        new("1", "agent",
            "Hi! I found 12 apartments matching your criteria in Brooklyn. Let me show you the top picks based on your priorities — walkability, in-unit laundry, and proximity to the F train.",
            "10:00 AM"),
        new("2", "renter",
            "Great! I'd love to see options in Park Slope or Prospect Heights. Preferably with natural light and no ground-floor units.",
            "10:01 AM"),
        new("3", "agent",
            "Here's the best match in Park Slope — 3rd floor corner unit with lots of light:",
            "10:02 AM"),
        new("4", "agent", "", "10:02 AM",
            new Listing(
                "342 5th Ave, Apt 3R", "Park Slope", "$2,450", 780, 1, 1, "May 1", 94, true,
                ["In-unit laundry", "Dishwasher", "Hardwood floors", "Roof deck"],
                "2 min to F/G at 4th Ave")),
        new("5", "agent",
            "And here's a larger option in Prospect Heights with a second bedroom you could use as an office:",
            "10:03 AM"),
        new("6", "agent", "", "10:03 AM",
            new Listing(
                "189 Sterling Pl, Apt 4A", "Prospect Heights", "$2,750", 950, 2, 1, "May 15", 97, true,
                ["In-unit laundry", "Central AC", "Exposed brick", "Walk-in closet"],
                "4 min to 2/3 at Bergen St")),
        new("7", "renter",
            "The Sterling Place one looks amazing. Is the second bedroom big enough for a desk and bookshelf? Also, what's the pet deposit?",
            "10:05 AM"),
        new("8", "agent",
            "The second bedroom is 10x11 — plenty of room for a desk setup. Pet deposit is $500 with no monthly pet rent. The landlord allows cats and dogs under 40 lbs. Want me to schedule a viewing?",
            "10:06 AM"),
        new("9", "renter",
            "Yes, can you book something for this Saturday morning?",
            "10:07 AM"),
        new("10", "agent",
            "Done — I've requested a viewing for Saturday at 10:30 AM. You'll get a confirmation shortly. I also have a third option nearby if you want to compare while you're in the area.",
            "10:08 AM"),
    ];

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
