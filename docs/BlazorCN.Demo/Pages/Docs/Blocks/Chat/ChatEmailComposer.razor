@* ============================================================
   Block: chat-email-composer
   Title: ChatEmailComposer
   Description: Interactive email composition interface built with React, Next.js, shadcn/ui, and Tailwind CSS. Features recipient chips, subject line, rich text formatting toolbar, and send functionality.
   Source: original/blocks/chat/chat-email-composer.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="border-b px-4 py-3">
            <h2 class="text-sm font-medium">New Message</h2>
        </div>

        @* Recipients Field *@
        <div class="border-b px-4 py-3">
            <div class="flex items-start gap-2">
                <span class="pt-1.5 text-xs font-medium text-muted-foreground">To:</span>
                <div class="flex min-w-0 flex-1 flex-wrap gap-2">
                    @foreach (var rec in _recipients)
                    {
                        var recipient = rec;
                        <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1 pl-2 pr-1">
                            <span class="text-xs">@recipient.Email</span>
                            <button type="button"
                                    @onclick="@(() => HandleRemoveRecipient(recipient.Id))"
                                    class="rounded-sm hover:bg-muted"
                                    aria-label="Remove recipient">
                                <LucideIconCn Name="x" Size="12" Class="size-3" />
                            </button>
                        </BadgeCn>
                    }
                    <input type="email"
                           placeholder="Add recipient..."
                           value="@_recipientInput"
                           @oninput="@((e) => _recipientInput = e.Value?.ToString() ?? "")"
                           @onkeydown="HandleRecipientKeyDown"
                           @onblur="HandleAddRecipient"
                           class="h-7 min-w-[200px] flex-1 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0 outline-none text-sm" aria-label="Add recipient..." />
                </div>
            </div>
        </div>

        @* Subject Field *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-2">
                <span class="text-xs font-medium text-muted-foreground">Subject:</span>
                <input type="text"
                       placeholder="Email subject..."
                       value="@_subject"
                       @oninput="@((e) => _subject = e.Value?.ToString() ?? "")"
                       class="flex-1 border-0 bg-transparent px-0 shadow-none focus-visible:ring-0 outline-none text-sm" aria-label="Email subject..." />
            </div>
        </div>

        @* Message Body *@
        <div class="flex-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            <TextareaCn @bind-Value="_message"
                        Placeholder="Compose your message..."
                        Class="min-h-full resize-none border-0 bg-transparent shadow-none focus-visible:ring-0" aria-label="Compose your message..." />
        </div>

        @* Formatting Toolbar & Send *@
        <div class="border-t px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-1">
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-8 w-8 p-0", _activeFormats.Contains("bold") ? "bg-muted" : "")"
                              @onclick="@(() => ToggleFormat("bold"))"
                              aria-label="Bold">
                        <LucideIconCn Name="bold" Size="16" Class="size-4" />
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-8 w-8 p-0", _activeFormats.Contains("italic") ? "bg-muted" : "")"
                              @onclick="@(() => ToggleFormat("italic"))"
                              aria-label="Italic">
                        <LucideIconCn Name="italic" Size="16" Class="size-4" />
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-8 w-8 p-0", _activeFormats.Contains("underline") ? "bg-muted" : "")"
                              @onclick="@(() => ToggleFormat("underline"))"
                              aria-label="Underline">
                        <LucideIconCn Name="underline" Size="16" Class="size-4" />
                    </ButtonCn>
                    <div class="mx-1 h-4 w-px bg-border"></div>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-8 w-8 p-0", _activeFormats.Contains("list") ? "bg-muted" : "")"
                              @onclick="@(() => ToggleFormat("list"))"
                              aria-label="Bullet list">
                        <LucideIconCn Name="list" Size="16" Class="size-4" />
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-8 w-8 p-0", _activeFormats.Contains("ordered") ? "bg-muted" : "")"
                              @onclick="@(() => ToggleFormat("ordered"))"
                              aria-label="Numbered list">
                        <LucideIconCn Name="list-ordered" Size="16" Class="size-4" />
                    </ButtonCn>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="@Cn.Merge("h-8 w-8 p-0", _activeFormats.Contains("link") ? "bg-muted" : "")"
                              @onclick="@(() => ToggleFormat("link"))"
                              aria-label="Insert link">
                        <LucideIconCn Name="link-2" Size="16" Class="size-4" />
                    </ButtonCn>
                    <div class="mx-1 h-4 w-px bg-border"></div>
                    <ButtonCn Variant="ButtonVariant.Ghost"
                              Size="ButtonSize.Sm"
                              Class="h-8 w-8 p-0"
                              aria-label="Attach file">
                        <LucideIconCn Name="paperclip" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
                <ButtonCn @onclick="HandleSend"
                          Size="ButtonSize.Sm"
                          Disabled="@(_recipients.Count == 0 || string.IsNullOrWhiteSpace(_subject) || string.IsNullOrWhiteSpace(_message))"
                          Class="gap-2">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                    Send
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record Recipient(string Id, string Email);

    private List<Recipient> _recipients =
    [
        new("1", "sarah.chen@@company.com"),
    ];

    private string _recipientInput = "";
    private string _subject = "Q1 Project Review Meeting";
    private string _message = "Hi Sarah,\n\nI wanted to schedule our quarterly project review for next week. Do you have availability on Thursday afternoon?\n\nLooking forward to discussing the progress we've made.\n\nBest regards";
    private HashSet<string> _activeFormats = [];

    private void HandleAddRecipient()
    {
        var trimmed = _recipientInput.Trim();
        if (!string.IsNullOrEmpty(trimmed) && trimmed.Contains("@@"))
        {
            _recipients.Add(new(DateTime.Now.Ticks.ToString(), trimmed));
            _recipientInput = "";
        }
    }

    private void HandleRemoveRecipient(string id)
    {
        _recipients.RemoveAll(r => r.Id == id);
    }

    private void ToggleFormat(string format)
    {
        if (!_activeFormats.Add(format))
            _activeFormats.Remove(format);
    }

    private void HandleSend()
    {
        if (_recipients.Count > 0 && !string.IsNullOrWhiteSpace(_subject) && !string.IsNullOrWhiteSpace(_message))
        {
            // Handle send action
        }
    }

    private void HandleRecipientKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            HandleAddRecipient();
    }
}
