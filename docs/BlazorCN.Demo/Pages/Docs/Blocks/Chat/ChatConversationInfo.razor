@* ============================================================
   Block: chat-conversation-info
   Title: ChatConversationInfo
   Description: React chat conversation info side panel for Next.js with group details, member list with roles, shared media preview, notification settings, and leave action using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-conversation-info.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">
        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-7 shrink-0 text-muted-foreground hover:text-foreground">
                <LucideIconCn Name="arrow-left" Size="16" Class="size-4" />
            </ButtonCn>
            <span class="font-medium text-sm">Details</span>
        </div>

        @* Scrollable content *@
        <div class="flex-1 overflow-y-auto">
            @* Group info *@
            <div class="border-b px-4 py-4">
                <div class="flex items-center gap-3">
                    <div class="flex size-12 items-center justify-center rounded-full bg-muted">
                        <LucideIconCn Name="users" Size="20" Class="size-5 text-muted-foreground" />
                    </div>
                    <div class="min-w-0 flex-1">
                        <span class="font-medium text-sm">@_groupInfo.Name</span>
                        <p class="text-muted-foreground text-xs">
                            @_groupInfo.MemberCount members &middot; Created @_groupInfo.Created
                        </p>
                    </div>
                </div>
                <p class="mt-3 text-muted-foreground text-sm leading-relaxed">
                    @_groupInfo.Description
                </p>
            </div>

            @* Members *@
            <div class="border-b">
                <div class="flex items-center justify-between px-4 py-3">
                    <span class="font-medium text-muted-foreground text-xs">
                        Members &middot; @_members.Length
                    </span>
                    <ButtonCn Variant="ButtonVariant.Ghost" Size="ButtonSize.Sm" Class="h-6 px-2 text-xs">
                        Add
                    </ButtonCn>
                </div>
                @foreach (var member in _members)
                {
                    var m = member;
                    <div class="flex items-center gap-3 px-4 py-2.5 transition-colors hover:bg-muted/50">
                        <div class="relative">
                            <AvatarCn Class="size-8">
                                <AvatarFallbackCn Class="text-xs">@m.Initials</AvatarFallbackCn>
                            </AvatarCn>
                            <span class="@Cn.Merge("absolute right-0 bottom-0 size-2 rounded-full border-2 border-card", StatusDotClass(m.Status))" />
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2">
                                <span class="truncate font-medium text-sm">@m.Name</span>
                                @if (m.Role == "admin")
                                {
                                    <BadgeCn Variant="BadgeVariant.Secondary" Class="h-4 gap-0.5 px-1 font-normal text-[10px]">
                                        <LucideIconCn Name="shield" Size="10" Class="size-2.5" />
                                        Admin
                                    </BadgeCn>
                                }
                            </div>
                            <p class="text-muted-foreground text-xs">
                                @(m.Status == "online" ? "Online" : m.LastSeen)
                            </p>
                        </div>
                    </div>
                }
            </div>

            @* Shared media preview *@
            <div class="border-b">
                <button type="button"
                        class="flex w-full items-center justify-between px-4 py-3 text-left transition-colors hover:bg-muted/50">
                    <span class="font-medium text-muted-foreground text-xs">Shared Media &middot; 24</span>
                    <LucideIconCn Name="chevron-right" Size="16" Class="size-4 text-muted-foreground/60" />
                </button>
                <div class="grid grid-cols-4 gap-1.5 px-4 pb-3">
                    @foreach (var preview in _mediaPreviews)
                    {
                        var p = preview;
                        <div class="@Cn.Merge("flex aspect-square items-center justify-center rounded-md", p.Color)">
                            <LucideIconCn Name="image" Size="16" Class="size-4 text-muted-foreground/40" />
                        </div>
                    }
                </div>
            </div>

            @* Settings *@
            <div class="border-b">
                <div class="px-4 py-3">
                    <span class="font-medium text-muted-foreground text-xs">Settings</span>
                </div>
                <div class="flex items-center justify-between px-4 py-3">
                    <div class="flex items-center gap-3">
                        <LucideIconCn Name="bell" Size="16" Class="size-4 text-muted-foreground" />
                        <div>
                            <span class="font-medium text-sm">Notifications</span>
                            <p class="text-muted-foreground text-xs">
                                @(_notifications ? "All messages" : "Muted")
                            </p>
                        </div>
                    </div>
                    <SwitchCn Checked="@_notifications" CheckedChanged="@((bool v) => _notifications = v)" />
                </div>
            </div>

            @* Danger zone *@
            <div class="px-4 py-4">
                <ButtonCn Variant="ButtonVariant.Ghost" Class="h-9 w-full justify-start gap-2 text-red-600 text-sm hover:bg-red-500/10 hover:text-red-600 dark:text-red-400 dark:hover:text-red-400">
                    <LucideIconCn Name="log-out" Size="16" Class="size-4" />
                    Leave conversation
                </ButtonCn>
            </div>
        </div>
    </div>
</section>

@code {
    private record GroupInfo(string Name, string Description, string Created, int MemberCount);
    private record Member(string Id, string Name, string Initials, string Role, string Status, string LastSeen);
    private record MediaPreview(string Id, string Color);

    private bool _notifications = true;

    private static readonly GroupInfo _groupInfo = new(
        "Design Team",
        "Product design discussions, reviews, and handoffs.",
        "Jan 12, 2026",
        6
    );

    private static readonly Member[] _members =
    [
        new("m1", "You",        "YO", "admin",  "online",  "Now"),
        new("m2", "Mia Chen",   "MC", "admin",  "online",  "Now"),
        new("m3", "Leo Park",   "LP", "member", "online",  "Now"),
        new("m4", "Sara Ahmed", "SA", "member", "away",    "15 min ago"),
        new("m5", "James Liu",  "JL", "member", "offline", "2 hours ago"),
        new("m6", "Priya Nair", "PN", "member", "offline", "Yesterday"),
    ];

    private static readonly MediaPreview[] _mediaPreviews =
    [
        new("mp1", "bg-zinc-200 dark:bg-zinc-700"),
        new("mp2", "bg-zinc-300 dark:bg-zinc-600"),
        new("mp3", "bg-zinc-200 dark:bg-zinc-700"),
        new("mp4", "bg-zinc-300 dark:bg-zinc-600"),
    ];

    private static string StatusDotClass(string status) => status switch
    {
        "online"  => "bg-emerald-500",
        "away"    => "bg-amber-500",
        _         => "bg-zinc-400",
    };
}
