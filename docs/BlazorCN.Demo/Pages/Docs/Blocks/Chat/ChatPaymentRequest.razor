@* ============================================================
   Block: chat-payment-request
   Title: ChatPaymentRequest
   Description: React chat block with inline payment request cards for Next.js featuring amount display, pay now buttons, receipt confirmations, and status indicators using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-payment-request.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="text-xs">AR</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Alex Rivera</span>
                <span class="ml-2 text-muted-foreground text-xs">Designer</span>
            </div>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="receipt" Size="12" Class="size-3" />
                <span>2 invoices</span>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto py-2">
            @foreach (var msg in _messages)
            {
                var message = msg;
                var msgIndex = System.Array.IndexOf(_messages, message);

                @if (message.Role == "system" && message.Receipt != null)
                {
                    @* Receipt card *@
                    <div class="mx-auto my-2 max-w-sm px-2">
                        <div class="rounded-md border border-emerald-500/20 bg-emerald-500/5 p-3">
                            <div class="flex items-center gap-2">
                                <LucideIconCn Name="check-circle-2" Size="16" Class="size-4 text-emerald-600 dark:text-emerald-400" />
                                <div class="min-w-0 flex-1">
                                    <span class="font-medium text-sm">Payment received</span>
                                    <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                        <span class="font-semibold tabular-nums text-foreground">@message.Receipt.Amount</span>
                                        <span>·</span>
                                        <span class="font-mono">@message.Receipt.TransactionId</span>
                                    </div>
                                </div>
                                <span class="text-muted-foreground text-[10px]">@message.Time</span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    var showHeader = IsFirstInGroup(msgIndex);

                    <div class="flex gap-2 px-2 transition-colors hover:bg-accent">
                        <div class="w-10 shrink-0 pt-1">
                            @if (showHeader)
                            {
                                <AvatarCn Class="size-8">
                                    <AvatarFallbackCn Class="text-xs">@message.Initials</AvatarFallbackCn>
                                </AvatarCn>
                            }
                        </div>
                        <div class="min-w-0 flex-1 py-1">
                            @if (showHeader)
                            {
                                <div class="mb-0.5 flex items-center gap-2">
                                    <span class="font-medium text-sm">@message.Sender</span>
                                    <span class="text-muted-foreground text-xs">@message.Time</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(message.Content))
                            {
                                <p class="text-sm">@message.Content</p>
                            }
                            @if (message.Payment != null)
                            {
                                var payment = message.Payment;
                                var isPaid = payment.Status == "paid";

                                @* Payment card *@
                                <div class="mt-1.5 rounded-md border p-3">
                                    <div class="mb-2.5 flex items-center gap-2">
                                        <LucideIconCn Name="circle-dollar-sign" Size="16" Class="size-4 text-muted-foreground" />
                                        <span class="font-medium text-sm">Payment request</span>
                                        <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("ml-auto font-normal text-[10px]", isPaid ? "bg-emerald-500/10 text-emerald-600 dark:text-emerald-400" : "bg-amber-500/10 text-amber-600 dark:text-amber-400")">
                                            @(isPaid ? "Paid" : "Pending")
                                        </BadgeCn>
                                    </div>

                                    <div class="mb-3">
                                        <span class="font-semibold text-xl tabular-nums">@payment.Amount</span>
                                        <p class="mt-0.5 text-muted-foreground text-xs">@payment.Description</p>
                                    </div>

                                    @if (isPaid)
                                    {
                                        <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                                            <LucideIconCn Name="check-circle-2" Size="12" Class="size-3 text-emerald-600 dark:text-emerald-400" />
                                            <span>Paid</span>
                                            @if (!string.IsNullOrEmpty(payment.TransactionId))
                                            {
                                                <span>·</span>
                                                <span class="font-mono">@payment.TransactionId</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="flex gap-2">
                                            <ButtonCn Size="ButtonSize.Sm" Class="h-7 flex-1 gap-1.5 text-xs">
                                                <LucideIconCn Name="circle-dollar-sign" Size="12" Class="size-3" />
                                                Pay now
                                            </ButtonCn>
                                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 gap-1.5 text-xs">
                                                <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                                Remind later
                                            </ButtonCn>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true" class="relative flex items-end gap-2">
                <ButtonCn type="button" Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" Class="size-8 shrink-0 text-muted-foreground hover:text-foreground">
                    <LucideIconCn Name="circle-dollar-sign" Size="16" Class="size-4" />
                </ButtonCn>
                <div class="relative flex-1">
                    <TextareaCn @bind-Value="_input" Placeholder="Type a message..." Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-10 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                    <ButtonCn type="submit" Size="ButtonSize.Icon" Variant="ButtonVariant.Ghost" Disabled="@(string.IsNullOrWhiteSpace(_input))" Class="absolute top-1/2 right-0 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground">
                        <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </form>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record PaymentRequest(string Amount, string Description, string Status, string? TransactionId = null);

    private record ReceiptInfo(string Amount, string TransactionId);

    private record ChatMessage(string Id, string Role, string Sender, string Initials, string Time, string? Content = null, PaymentRequest? Payment = null, ReceiptInfo? Receipt = null);

    private readonly ChatMessage[] _messages =
    [
        new("1", "other", "Alex Rivera", "AR", "3:14 PM", Content: "Hey, here's the invoice for the logo design work. Let me know if the amount looks right."),
        new("2", "other", "Alex Rivera", "AR", "3:14 PM", Payment: new PaymentRequest("$450.00", "Logo design — brand refresh v2", "paid", "TXN-8294-XKPL")),
        new("3", "system", "System", "", "3:18 PM", Receipt: new ReceiptInfo("$450.00", "TXN-8294-XKPL")),
        new("4", "user", "You", "YO", "3:19 PM", Content: "Done! Payment sent. The logo looks great by the way. Can you also send the invoice for the icon set?"),
        new("5", "other", "Alex Rivera", "AR", "3:22 PM", Content: "Thanks for the quick payment! Here's the icon set invoice."),
        new("6", "other", "Alex Rivera", "AR", "3:22 PM", Payment: new PaymentRequest("$280.00", "Custom icon set — 24 icons, SVG + PNG", "pending")),
        new("7", "user", "You", "YO", "3:25 PM", Content: "Got it. I'll process this one after the team reviews the icons tomorrow."),
        new("8", "other", "Alex Rivera", "AR", "3:26 PM", Content: "No rush. The net-30 terms apply so you have plenty of time."),
    ];

    private bool IsFirstInGroup(int index)
    {
        if (index == 0) return true;
        var prev = _messages[index - 1];
        var curr = _messages[index];
        return prev.Sender != curr.Sender || prev.Role != curr.Role;
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
