@* ============================================================
   Block: chat-garden-planner
   Title: ChatGardenPlanner
   Description: Garden planning chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS. Features plant recommendations, watering schedules, growing zones, and seasonal planting guides.
   Source: original/blocks/chat/chat-garden-planner.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="leaf" Size="16" Class="size-4 text-emerald-500" />
                    <h2 class="text-sm font-medium">Garden Planner</h2>
                </div>
                @if (_userZone != null)
                {
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="gap-1.5">
                        <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                        Zone @_userZone
                    </BadgeCn>
                }
            </div>
        </div>

        @* Garden Stats *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-3">
                <div class="rounded-md bg-muted/50 p-2">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="sprout" Size="14" Class="size-3.5 text-emerald-500" />
                        <span class="text-xs text-muted-foreground">Planted</span>
                    </div>
                    <p class="mt-1 text-lg font-semibold tabular-nums">@_plantedItems.Count</p>
                </div>
                <div class="rounded-md bg-muted/50 p-2">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="droplet" Size="14" Class="size-3.5 text-blue-500" />
                        <span class="text-xs text-muted-foreground">Water Today</span>
                    </div>
                    <p class="mt-1 text-lg font-semibold tabular-nums">
                        @_plantedItems.Count(p => p.NextWatering == "Today")
                    </p>
                </div>
                <div class="rounded-md bg-muted/50 p-2">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="sun" Size="14" Class="size-3.5 text-amber-500" />
                        <span class="text-xs text-muted-foreground">Season</span>
                    </div>
                    <p class="mt-1 text-sm font-medium">Spring</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3">
            <div class="space-y-4">
                @foreach (var message in _messages)
                {
                    @if (message.Type == "user")
                    {
                        <div class="flex justify-end">
                            <div class="flex max-w-[85%] items-start gap-2">
                                <div class="rounded-lg bg-primary px-3 py-2 text-primary-foreground">
                                    <p class="text-sm">@message.Content</p>
                                    <span class="mt-1 block text-xs opacity-70">@message.Timestamp</span>
                                </div>
                                <AvatarCn Class="size-8 shrink-0">
                                    <div class="flex size-full items-center justify-center bg-primary text-xs text-primary-foreground">
                                        U
                                    </div>
                                </AvatarCn>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-start gap-2">
                            <AvatarCn Class="size-8 shrink-0">
                                <div class="flex size-full items-center justify-center bg-emerald-500 text-xs text-white">
                                    @if (message.Type == "plant")
                                    {
                                        <LucideIconCn Name="leaf" Size="16" Class="size-4" />
                                    }
                                    else if (message.Type == "schedule")
                                    {
                                        <LucideIconCn Name="calendar" Size="16" Class="size-4" />
                                    }
                                    else
                                    {
                                        <LucideIconCn Name="sprout" Size="16" Class="size-4" />
                                    }
                                </div>
                            </AvatarCn>
                            <div class="max-w-[85%]">
                                <div class="rounded-lg bg-muted px-3 py-2">
                                    <p class="text-sm">@message.Content</p>
                                    @if (message.PlantData != null)
                                    {
                                        var plant = message.PlantData;
                                        <div class="mt-2 space-y-1.5 rounded-md border bg-card p-2">
                                            <div class="flex items-center justify-between">
                                                <span class="text-xs font-medium">@plant.Name</span>
                                                <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                                                    @plant.Type
                                                </BadgeCn>
                                            </div>
                                            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                                <LucideIconCn Name="droplet" Size="12" Class="size-3" />
                                                @plant.WaterFrequency
                                            </div>
                                            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                                <LucideIconCn Name="sun" Size="12" Class="size-3" />
                                                @plant.Sunlight
                                            </div>
                                            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                                <LucideIconCn Name="map-pin" Size="12" Class="size-3" />
                                                Zone @plant.Zone
                                            </div>
                                            <div class="flex items-center gap-1.5 text-xs text-muted-foreground">
                                                <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                                                @plant.Season
                                            </div>
                                        </div>
                                    }
                                    <span class="mt-1 block text-xs text-muted-foreground">@message.Timestamp</span>
                                </div>
                            </div>
                        </div>
                    }
                }

                @* Current Garden *@
                @if (_plantedItems.Count > 0)
                {
                    <div class="rounded-md border bg-muted/50 p-3">
                        <h3 class="mb-2 text-xs font-medium text-muted-foreground">Your Garden</h3>
                        <div class="space-y-2">
                            @foreach (var plant in _plantedItems)
                            {
                                <div class="flex items-center justify-between rounded-md bg-card p-2">
                                    <div>
                                        <p class="text-sm font-medium">@plant.Name</p>
                                        <p class="text-xs text-muted-foreground">Planted @plant.PlantedDate</p>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <LucideIconCn Name="clock" Size="12" Class="size-3 text-muted-foreground" />
                                        <span class="text-xs text-muted-foreground">@plant.NextWatering</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="mb-2 flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="text-xs"
                          OnClick="@(() => ProcessCommand(_userZone != null ? "recommend plants" : "zone 7"))">
                    @(_userZone != null ? "Get recommendations" : "Set zone 7")
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" Class="text-xs"
                          OnClick="@(() => ProcessCommand("watering schedule"))">
                    Watering schedule
                </ButtonCn>
            </div>
            <div class="flex gap-2">
                <InputCn
                    @bind-Value="_input"
                    Placeholder="Ask about plants or your garden..."
                    Class="flex-1"
                    @onkeydown="@HandleKeyDown" />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private string? _userZone = null;

    private record PlantRecommendation(
        string Name,
        string Type,
        string WaterFrequency,
        string Sunlight,
        string Zone,
        string Season
    );

    private record ChatMessage(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        PlantRecommendation? PlantData = null
    );

    private record PlantedItem(
        string Id,
        string Name,
        string PlantedDate,
        string NextWatering
    );

    private static readonly PlantRecommendation[] _plantDatabase =
    [
        new("Cherry Tomatoes", "Vegetable", "Daily",         "Full sun (6-8 hours)",     "3-11",  "Spring-Summer"),
        new("Basil",           "Herb",      "Every 2 days",  "Full sun (6-8 hours)",     "4-11",  "Spring-Summer"),
        new("Lavender",        "Flower",    "Weekly",        "Full sun (6-8 hours)",     "5-9",   "Spring"),
        new("Lettuce",         "Vegetable", "Every 2 days",  "Partial shade (4-6 hours)","2-11",  "Spring-Fall"),
        new("Marigolds",       "Flower",    "Every 3 days",  "Full sun (6-8 hours)",     "2-11",  "Spring-Summer"),
    ];

    private List<ChatMessage> _messages =
    [
        new("1", "system",
            "Welcome to your garden planner! Tell me your hardiness zone to get started, or ask about specific plants.",
            "8:00 AM"),
    ];

    private List<PlantedItem> _plantedItems =
    [
        new("1", "Cherry Tomatoes", "March 15", "Today"),
        new("2", "Basil",           "March 20", "Tomorrow"),
    ];

    private void AddMessage(string type, string content, PlantRecommendation? plantData = null)
    {
        var newMessage = new ChatMessage(
            Id: DateTime.UtcNow.Ticks.ToString(),
            Type: type,
            Content: content,
            Timestamp: DateTime.Now.ToString("h:mm tt"),
            PlantData: plantData
        );
        _messages = [.._messages, newMessage];
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        AddMessage("user", _input);
        ProcessCommand(_input.ToLowerInvariant());
        _input = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") HandleSubmit();
    }

    private void ProcessCommand(string command)
    {
        // Zone detection: matches "zone 7", "zone 7a", etc.
        var zoneMatch = System.Text.RegularExpressions.Regex.Match(command, @"zone (\d+[ab]?)", System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (zoneMatch.Success)
        {
            var zone = zoneMatch.Groups[1].Value;
            _userZone = zone;
            AddMessage("system", $"Great! You're in zone {zone}. I'll recommend plants suitable for your area.");
            RecommendPlantsForZone(zone);
            return;
        }

        if (command.Contains("recommend") || command.Contains("suggest"))
        {
            if (_userZone != null)
                RecommendPlantsForZone(_userZone);
            else
                AddMessage("system", "Please tell me your hardiness zone first (e.g., 'I'm in zone 7')");
            return;
        }

        if (command.Contains("plant") && command.Contains(" on "))
        {
            var match = System.Text.RegularExpressions.Regex.Match(command, @"plant (.+) on (.+)");
            if (match.Success)
            {
                var plantName = match.Groups[1].Value.Trim();
                var date = match.Groups[2].Value.Trim();
                var newPlant = new PlantedItem(
                    Id: DateTime.UtcNow.Ticks.ToString(),
                    Name: plantName,
                    PlantedDate: date,
                    NextWatering: "Tomorrow"
                );
                _plantedItems = [.._plantedItems, newPlant];
                AddMessage("schedule", $"Added {plantName} to your garden planner!");
            }
            return;
        }

        if (command.Contains("watering") || command.Contains("schedule"))
        {
            ShowWateringSchedule();
            return;
        }

        var plantMatch = System.Array.Find(_plantDatabase, p => command.Contains(p.Name.ToLowerInvariant()));
        if (plantMatch != null)
        {
            AddMessage("plant", $"Here's what I know about {plantMatch.Name}:", plantMatch);
            return;
        }

        AddMessage("system", "I can help you with plant recommendations, watering schedules, and planting dates. Try asking about a specific plant or your zone!");
    }

    private void RecommendPlantsForZone(string zone)
    {
        if (!int.TryParse(new string(zone.TakeWhile(char.IsDigit).ToArray()), out var zoneNum))
            return;

        var suitable = System.Array.FindAll(_plantDatabase, plant =>
        {
            var parts = plant.Zone.Split('-');
            if (parts.Length == 2 &&
                int.TryParse(parts[0], out var min) &&
                int.TryParse(parts[1], out var max))
                return zoneNum >= min && zoneNum <= max;
            return false;
        });

        if (suitable.Length > 0)
        {
            AddMessage("system", $"Found {suitable.Length} plants perfect for zone {zone}:");
            foreach (var plant in suitable.Take(3))
                AddMessage("plant", $"{plant.Name} - {plant.Type}", plant);
        }
        else
        {
            AddMessage("system", "No plants found for your zone. Try a different zone!");
        }
    }

    private void ShowWateringSchedule()
    {
        AddMessage("schedule", $"Your watering schedule for {_plantedItems.Count} plants:");
        foreach (var plant in _plantedItems)
            AddMessage("schedule", $"{plant.Name}: Next watering {plant.NextWatering}");
    }
}
