@* ============================================================
   Block: chat-product-recommendation
   Title: ChatProductRecommendation
   Description: React chat block with product recommendation cards for Next.js featuring horizontal scroll carousels, star ratings, pricing, add-to-cart buttons, and image placeholders using TypeScript, shadcn/ui, and Tailwind CSS
   Source: original/blocks/chat/chat-product-recommendation.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="flex items-center gap-3 border-b px-4 py-3">
            <AvatarCn Class="size-7">
                <AvatarFallbackCn Class="text-xs">SA</AvatarFallbackCn>
            </AvatarCn>
            <div class="min-w-0 flex-1">
                <span class="font-medium text-sm">Shop Assistant</span>
                <span class="ml-2 text-muted-foreground text-xs">Online</span>
            </div>
            <div class="flex items-center gap-1.5 text-muted-foreground text-xs">
                <LucideIconCn Name="shopping-cart" Size="12" Class="size-3" />
                <span>0 items</span>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto py-2">
            @foreach (var msg in _messages)
            {
                var showHeader = IsFirstInGroup(msg.Id);
                <div class="flex gap-2 px-2 transition-colors hover:bg-accent">
                    <div class="w-10 shrink-0 pt-1">
                        @if (showHeader)
                        {
                            <AvatarCn Class="size-8">
                                <AvatarFallbackCn Class="text-xs">@msg.Initials</AvatarFallbackCn>
                            </AvatarCn>
                        }
                    </div>
                    <div class="min-w-0 flex-1 py-1">
                        @if (showHeader)
                        {
                            <div class="mb-0.5 flex items-center gap-2">
                                <span class="font-medium text-sm">@msg.Sender</span>
                                <span class="text-muted-foreground text-xs">@msg.Time</span>
                            </div>
                        }
                        @if (msg.Content != null)
                        {
                            <p class="text-sm">@msg.Content</p>
                        }
                        @if (msg.Products != null)
                        {
                            @* Product Carousel *@
                            <div class="mt-1.5 -mr-2 w-[calc(100%+8px)]">
                                <div class="flex gap-2 overflow-x-auto pb-2 pr-2 scrollbar-none">
                                    @foreach (var product in msg.Products)
                                    {
                                        var prod = product;
                                        <div class="w-[180px] shrink-0 rounded-md border bg-background p-2.5">
                                            <div class="mb-2 flex aspect-square items-center justify-center rounded-md bg-muted/50">
                                                <LucideIconCn Name="image" Size="32" Class="size-8 text-muted-foreground/40" />
                                            </div>

                                            @if (prod.Tag != null)
                                            {
                                                <BadgeCn Variant="BadgeVariant.Secondary" Class="mb-1.5 font-normal text-[10px]">@prod.Tag</BadgeCn>
                                            }

                                            <span class="line-clamp-1 font-medium text-sm">@prod.Name</span>

                                            <div class="mt-1 flex items-center gap-1.5">
                                                @* Star Rating *@
                                                <div class="flex items-center gap-0.5">
                                                    @for (int i = 0; i < 5; i++)
                                                    {
                                                        var idx = i;
                                                        var starClass = idx < (int)Math.Floor(prod.Rating)
                                                            ? "fill-amber-400 text-amber-400"
                                                            : (idx < prod.Rating
                                                                ? "fill-amber-400/50 text-amber-400"
                                                                : "fill-muted text-muted");
                                                        <LucideIconCn Name="star" Size="12" Class="@Cn.Merge("size-3", starClass)" />
                                                    }
                                                </div>
                                                <span class="text-muted-foreground text-[10px]">(@prod.Reviews.ToString("N0"))</span>
                                            </div>

                                            <div class="mt-1.5 flex items-center gap-1.5">
                                                <span class="font-semibold text-sm tabular-nums">@prod.Price</span>
                                                @if (prod.OriginalPrice != null)
                                                {
                                                    <span class="text-muted-foreground text-xs line-through tabular-nums">@prod.OriginalPrice</span>
                                                }
                                            </div>

                                            <ButtonCn Size="ButtonSize.Sm"
                                                      Variant="@(_addedProducts.Contains(prod.Id) ? ButtonVariant.Secondary : ButtonVariant.Outline)"
                                                      Class="mt-2 h-7 w-full gap-1 text-xs"
                                                      OnClick="@(() => AddToCart(prod.Id))">
                                                @if (_addedProducts.Contains(prod.Id))
                                                {
                                                    <span>Added</span>
                                                }
                                                else
                                                {
                                                    <LucideIconCn Name="shopping-cart" Size="12" Class="size-3" />
                                                    <span>Add to cart</span>
                                                }
                                            </ButtonCn>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="relative flex items-end gap-2">
                <div class="relative flex-1">
                    <TextareaCn @bind-Value="_input"
                                Placeholder="Ask about products..."
                                Class="max-h-32 min-h-0 resize-none border-0 bg-transparent pr-10 text-sm shadow-none placeholder:text-muted-foreground/50 focus-visible:ring-0" />
                    <ButtonCn Size="ButtonSize.Icon"
                              Variant="ButtonVariant.Ghost"
                              Disabled="@(string.IsNullOrWhiteSpace(_input))"
                              Class="absolute top-1/2 right-0 size-7 -translate-y-1/2 text-muted-foreground hover:text-foreground"
                              OnClick="@HandleSubmit">
                        <LucideIconCn Name="arrow-up" Size="16" Class="size-4" />
                    </ButtonCn>
                </div>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";
    private HashSet<string> _addedProducts = [];

    private record Product(
        string Id,
        string Name,
        string Price,
        double Rating,
        int Reviews,
        string? OriginalPrice = null,
        string? Tag = null);

    private record ChatMessage(
        string Id,
        string Role,
        string Sender,
        string Initials,
        string Time,
        string? Content = null,
        Product[]? Products = null);

    private static readonly ChatMessage[] _messages =
    [
        new("1", "user", "You", "YO", "2:05 PM",
            Content: "I'm looking for a good pair of noise-canceling headphones for the office. Budget is around $300."),
        new("2", "other", "Shop Assistant", "SA", "2:06 PM",
            Content: "Great choice! Here are our top picks for noise-canceling headphones in that range. All have excellent reviews from remote workers."),
        new("3", "other", "Shop Assistant", "SA", "2:06 PM",
            Products:
            [
                new("p1", "QuietComfort Ultra", "$279.00", 4.8, 2341, OriginalPrice: "$349.00", Tag: "Best seller"),
                new("p2", "Studio Pro Max", "$299.00", 4.6, 1872),
                new("p3", "Focus ANC 700", "$249.00", 4.5, 943, Tag: "Value pick"),
                new("p4", "SilentWave Elite", "$319.00", 4.7, 1205, OriginalPrice: "$379.00"),
            ]),
        new("4", "user", "You", "YO", "2:10 PM",
            Content: "The QuietComfort Ultra looks great. What's the battery life like? And do you have any desk accessories that pair well?"),
        new("5", "other", "Shop Assistant", "SA", "2:11 PM",
            Content: "The QuietComfort Ultra has 24-hour battery life with ANC on. Here are some popular desk accessories our customers buy together."),
        new("6", "other", "Shop Assistant", "SA", "2:11 PM",
            Products:
            [
                new("p5", "Walnut Headphone Stand", "$45.00", 4.9, 567, Tag: "Top rated"),
                new("p6", "USB-C Audio DAC", "$89.00", 4.4, 312),
                new("p7", "Memory Foam Ear Cushions", "$29.00", 4.7, 891, OriginalPrice: "$39.00"),
            ]),
        new("7", "user", "You", "YO", "2:14 PM",
            Content: "Perfect. I'll take the headphones and the walnut stand. Can you add both to my cart?"),
    ];

    private bool IsFirstInGroup(string msgId)
    {
        var idx = Array.FindIndex(_messages, m => m.Id == msgId);
        if (idx == 0) return true;
        var prev = _messages[idx - 1];
        var curr = _messages[idx];
        return prev.Sender != curr.Sender || prev.Role != curr.Role;
    }

    private void AddToCart(string productId)
    {
        _addedProducts.Add(productId);
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        _input = "";
    }
}
