@* ============================================================
   Block: chat-journal-prompts
   Title: ChatJournalPrompts
   Description: Journaling chat interface built with React, Next.js, shadcn/ui, and Tailwind CSS. Features daily writing prompts, mood tracking, entry summaries, and reflection analytics.
   Source: original/blocks/chat/chat-journal-prompts.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <LucideIconCn Name="book-open" Size="16" Class="size-4 text-muted-foreground" />
                    <h2 class="text-sm font-medium">Journal Prompts</h2>
                </div>
                <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="flame" Size="14" Class="size-3.5 text-orange-500" />
                        <span class="text-xs text-muted-foreground">@_streak day streak</span>
                    </div>
                    <BadgeCn Variant="BadgeVariant.Secondary" Class="text-xs">
                        @_entries.Count entries
                    </BadgeCn>
                </div>
            </div>
        </div>

        @* Stats *@
        <div class="border-b px-4 py-3">
            <div class="grid grid-cols-3 gap-3">
                <div class="rounded-md bg-muted/50 p-2">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="calendar" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">This Week</span>
                    </div>
                    <p class="mt-1 text-lg font-semibold tabular-nums">@_entries.Count</p>
                </div>
                <div class="rounded-md bg-muted/50 p-2">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="smile" Size="14" Class="size-3.5 text-emerald-500" />
                        <span class="text-xs text-muted-foreground">Happy Days</span>
                    </div>
                    <p class="mt-1 text-lg font-semibold tabular-nums">@_entries.Count(e => e.Mood == "happy")</p>
                </div>
                <div class="rounded-md bg-muted/50 p-2">
                    <div class="flex items-center gap-1.5">
                        <LucideIconCn Name="heart" Size="14" Class="size-3.5 text-muted-foreground" />
                        <span class="text-xs text-muted-foreground">Avg Words</span>
                    </div>
                    <p class="mt-1 text-lg font-semibold tabular-nums">
                        @(_entries.Count > 0 ? (int)Math.Round(_entries.Average(e => (double)e.WordCount)) : 0)
                    </p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4 py-3" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4">
                @foreach (var message in _messages)
                {
                    var msg = message;
                    @if (msg.Type == "user")
                    {
                        <div class="flex justify-end">
                            <div class="flex max-w-[85%] items-start gap-2">
                                <div class="rounded-lg bg-primary px-3 py-2 text-primary-foreground">
                                    <p class="text-sm">@msg.Content</p>
                                    <span class="mt-1 block text-xs opacity-70">@msg.Timestamp</span>
                                </div>
                                <div class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary text-xs text-primary-foreground">
                                    U
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="flex items-start gap-2">
                            <div class="@Cn.Merge("flex size-8 shrink-0 items-center justify-center rounded-full text-xs", msg.Type == "prompt" ? "bg-purple-500 text-white" : msg.Type == "entry" && msg.Mood == "happy" ? "bg-emerald-500 text-white" : msg.Type == "entry" && msg.Mood == "neutral" ? "bg-amber-500 text-white" : msg.Type == "entry" && msg.Mood == "sad" ? "bg-blue-500 text-white" : "bg-muted")">
                                @if (msg.Type == "prompt")
                                {
                                    <LucideIconCn Name="lightbulb" Size="16" Class="size-4" />
                                }
                                else if (msg.Type == "entry" && msg.Mood == "happy")
                                {
                                    <LucideIconCn Name="smile" Size="16" Class="size-4 text-emerald-500" />
                                }
                                else if (msg.Type == "entry" && msg.Mood == "neutral")
                                {
                                    <LucideIconCn Name="meh" Size="16" Class="size-4 text-amber-500" />
                                }
                                else if (msg.Type == "entry" && msg.Mood == "sad")
                                {
                                    <LucideIconCn Name="frown" Size="16" Class="size-4 text-blue-500" />
                                }
                                else
                                {
                                    <LucideIconCn Name="book-open" Size="16" Class="size-4" />
                                }
                            </div>
                            <div class="max-w-[85%]">
                                <div class="@Cn.Merge("rounded-lg px-3 py-2", msg.Type == "prompt" ? "bg-purple-500/10" : msg.Type == "entry" && msg.Mood == "happy" ? "bg-emerald-500/10" : msg.Type == "entry" && msg.Mood == "neutral" ? "bg-amber-500/10" : msg.Type == "entry" && msg.Mood == "sad" ? "bg-blue-500/10" : "bg-muted")">
                                    <p class="text-sm">@msg.Content</p>
                                    <span class="mt-1 block text-xs text-muted-foreground">@msg.Timestamp</span>
                                </div>
                            </div>
                        </div>
                    }
                }

                @* Writing Area *@
                @if (_isWriting)
                {
                    <div class="rounded-md border bg-muted/50 p-3">
                        <h3 class="mb-2 text-xs font-medium text-muted-foreground">Your Entry</h3>
                        <TextareaCn @bind-Value="_currentEntry"
                                    Placeholder="Start writing..."
                                    Class="min-h-[120px] resize-none border-0 bg-transparent text-sm shadow-none focus-visible:ring-0" aria-label="Start writing..." />
                        <div class="mt-2 flex items-center justify-between">
                            <div class="flex gap-2">
                                <button type="button"
                                        @onclick="@(() => SetMood("happy"))"
                                        class="@Cn.Merge("rounded-full p-1.5 transition-colors", _currentMood == "happy" ? "bg-emerald-500/20" : "hover:bg-muted")"
                                        aria-label="Happy mood">
                                    <LucideIconCn Name="smile" Size="16" Class="@Cn.Merge("size-4", _currentMood == "happy" ? "text-emerald-500" : "text-muted-foreground")" />
                                </button>
                                <button type="button"
                                        @onclick="@(() => SetMood("neutral"))"
                                        class="@Cn.Merge("rounded-full p-1.5 transition-colors", _currentMood == "neutral" ? "bg-amber-500/20" : "hover:bg-muted")"
                                        aria-label="Neutral mood">
                                    <LucideIconCn Name="meh" Size="16" Class="@Cn.Merge("size-4", _currentMood == "neutral" ? "text-amber-500" : "text-muted-foreground")" />
                                </button>
                                <button type="button"
                                        @onclick="@(() => SetMood("sad"))"
                                        class="@Cn.Merge("rounded-full p-1.5 transition-colors", _currentMood == "sad" ? "bg-blue-500/20" : "hover:bg-muted")"
                                        aria-label="Sad mood">
                                    <LucideIconCn Name="frown" Size="16" Class="@Cn.Merge("size-4", _currentMood == "sad" ? "text-blue-500" : "text-muted-foreground")" />
                                </button>
                            </div>
                            <ButtonCn Size="ButtonSize.Sm"
                                      @onclick="SaveEntry"
                                      Disabled="@string.IsNullOrWhiteSpace(_currentEntry)">
                                Save Entry
                            </ButtonCn>
                        </div>
                    </div>
                }
            </div>
        </div>

        @* Input *@
        <div class="border-t px-4 py-3">
            <div class="mb-2 flex gap-2">
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="DeliverPrompt" Class="gap-1.5 text-xs">
                    <LucideIconCn Name="lightbulb" Size="12" Class="size-3" />
                    New Prompt
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="ShowEntries" Class="gap-1.5 text-xs">
                    <LucideIconCn Name="calendar" Size="12" Class="size-3" />
                    Past Entries
                </ButtonCn>
                <ButtonCn Variant="ButtonVariant.Outline" Size="ButtonSize.Sm" @onclick="ShowStats" Class="gap-1.5 text-xs">
                    <LucideIconCn Name="flame" Size="12" Class="size-3" />
                    Stats
                </ButtonCn>
            </div>
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true" class="flex gap-2">
                <InputCn @bind-Value="_input"
                         Placeholder="Type a command..."
                         Class="flex-1" aria-label="Type a command..." />
                <ButtonCn type="submit"
                          Size="ButtonSize.Icon"
                          Disabled="@string.IsNullOrWhiteSpace(_input)" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </form>
        </div>

    </div>
</section>

@code {
    private record JournalMessage(string Id, string Type, string Content, string Timestamp, string? Mood = null);

    private record JournalEntry(string Id, string Date, string Prompt, string Content, string Mood, int WordCount);

    private static readonly string[] _prompts =
    [
        "What are three things you're grateful for today?",
        "Describe a challenge you overcame this week and what you learned.",
        "What would you tell your younger self about today's experiences?",
        "Write about someone who positively impacted your life recently.",
        "What's one thing you want to improve about yourself?",
        "Describe your ideal day from start to finish.",
        "What fears are holding you back and why?",
        "List five things that made you smile today.",
    ];

    private readonly List<JournalMessage> _messages =
    [
        new("1", "system",
            "Welcome to your journaling space. I'll guide you through daily reflections. Ready for today's prompt?",
            "7:00 AM"),
    ];

    private readonly List<JournalEntry> _entries =
    [
        new("1", "Yesterday",
            "What are three things you're grateful for?",
            "I'm grateful for my supportive family, good health, and the opportunity to learn new things every day.",
            "happy",
            19),
    ];

    private string _input = "";
    private string _currentEntry = "";
    private string _currentMood = "neutral";
    private int _streak = 7;
    private bool _isWriting = false;
    private readonly Random _random = new();

    private string NowTime() => DateTime.Now.ToString("h:mm tt");

    private void AddMessage(string type, string content, string? mood = null)
    {
        _messages.Add(new JournalMessage(
            $"{_messages.Count + 1}",
            type,
            content,
            NowTime(),
            mood));
    }

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input))
            return;

        AddMessage("user", _input);
        ProcessCommand(_input.ToLowerInvariant());
        _input = "";
    }

    private void ProcessCommand(string command)
    {
        if (command.Contains("prompt") || command.Contains("start"))
        {
            DeliverPrompt();
        }
        else if (command.Contains("entries") || command.Contains("history"))
        {
            ShowEntries();
        }
        else if (command.Contains("streak") || command.Contains("stats"))
        {
            ShowStats();
        }
        else
        {
            AddMessage("system",
                "I can give you a writing prompt, show past entries, or display your journaling stats. What would you like?");
        }
    }

    private void DeliverPrompt()
    {
        var randomPrompt = _prompts[_random.Next(_prompts.Length)];
        AddMessage("prompt", randomPrompt);
        _isWriting = true;
        AddMessage("system", "Take your time. When you're done, select your mood and save your entry below.");
    }

    private void ShowEntries()
    {
        AddMessage("system", $"You have {_entries.Count} journal entries.");
        foreach (var entry in _entries.Take(3))
        {
            var preview = entry.Content.Length > 80 ? entry.Content[..80] : entry.Content;
            AddMessage("entry", $"{entry.Date}: \"{preview}...\" ({entry.WordCount} words)", entry.Mood);
        }
    }

    private void ShowStats()
    {
        var totalWords = _entries.Sum(e => e.WordCount);
        var avgWords = _entries.Count > 0 ? (int)Math.Round(totalWords / (double)_entries.Count) : 0;
        AddMessage("system", $"{_streak} day streak | {_entries.Count} entries | {avgWords} avg words per entry");
    }

    private void SaveEntry()
    {
        if (string.IsNullOrWhiteSpace(_currentEntry))
            return;

        var lastPrompt = _messages.LastOrDefault(m => m.Type == "prompt")?.Content;
        var wordCount = _currentEntry.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).Length;

        _entries.Insert(0, new JournalEntry(
            $"{_entries.Count + 1}",
            "Today",
            lastPrompt ?? "Free writing",
            _currentEntry,
            _currentMood,
            wordCount));

        AddMessage("entry", $"Entry saved! You wrote {wordCount} words. Keep up the great work!", _currentMood);

        _currentEntry = "";
        _isWriting = false;
        _streak++;
    }

    private void SetMood(string mood)
    {
        _currentMood = mood;
    }
}
