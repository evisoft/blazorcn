@* ============================================================
   Block: chat-freelancer-invoice
   Title: ChatFreelancerInvoice
   Description: A freelancer invoicing chat interface with time entry tracking, invoice generation cards, payment status monitoring, client management, and expense tracking built with React, Next.js, shadcn/ui, and Tailwind CSS.
   Source: original/blocks/chat/chat-freelancer-invoice.tsx
   ============================================================ *@

<section class="mx-auto w-full max-w-2xl p-4">
    <div class="flex h-[700px] flex-col overflow-hidden rounded-lg border bg-card">

        @* Header *@
        <div class="border-b px-4 py-3">
            <div class="flex items-center gap-3">
                <AvatarCn Class="size-8">
                    <AvatarImageCn Src="" Alt="" />
                    <AvatarFallbackCn Class="bg-indigo-500/10 text-indigo-600 text-xs">FI</AvatarFallbackCn>
                </AvatarCn>
                <div class="min-w-0 flex-1">
                    <h2 class="font-medium text-sm">Freelancer Invoice</h2>
                    <p class="text-muted-foreground text-xs">Time tracking and billing assistant</p>
                </div>
            </div>
        </div>

        @* Messages *@
        <div class="flex-1 overflow-y-auto px-4" tabindex="0" role="group" aria-label="Messages">
            <div class="space-y-4 py-4">

                @foreach (var message in _messages)
                {
                    var msg = message;
                    <div class="@Cn.Merge("flex gap-3", msg.Type == "user" ? "flex-row-reverse" : "")">
                        <AvatarCn Class="size-8 shrink-0">
                            <AvatarImageCn Src="" Alt="" />
                            <AvatarFallbackCn Class="@Cn.Merge("text-xs", msg.Type == "assistant" ? "bg-indigo-500/10 text-indigo-600" : "bg-muted")">
                                @(msg.Type == "assistant" ? "FI" : "You")
                            </AvatarFallbackCn>
                        </AvatarCn>
                        <div class="@Cn.Merge("min-w-0 flex-1 space-y-1", msg.Type == "user" ? "flex flex-col items-end" : "")">
                            <div class="@Cn.Merge("inline-block rounded-lg px-3 py-2 text-sm", msg.Type == "assistant" ? "bg-muted" : "bg-primary text-primary-foreground")">
                                @msg.Content
                            </div>
                            <span class="text-muted-foreground text-xs">@msg.Timestamp</span>

                            @* Invoice Card *@
                            @if (msg.Invoice != null)
                            {
                                var inv = msg.Invoice;
                                <div class="mt-3 overflow-hidden rounded-lg border bg-card">
                                    <div class="space-y-3 p-3">

                                        @* Invoice Header *@
                                        <div class="flex items-start justify-between gap-3">
                                            <div class="min-w-0 flex-1">
                                                <div class="flex items-center gap-2">
                                                    <LucideIconCn Name="file-text" Size="16" Class="size-4 text-indigo-600" />
                                                    <h3 class="font-medium text-sm">@inv.Client</h3>
                                                </div>
                                                <p class="mt-0.5 font-mono text-muted-foreground text-xs">@inv.Id</p>
                                            </div>
                                            <BadgeCn Variant="BadgeVariant.Secondary" Class="@Cn.Merge("shrink-0 text-xs capitalize", GetStatusColor(inv.Status))">
                                                @inv.Status
                                            </BadgeCn>
                                        </div>

                                        @* Dates *@
                                        <div class="flex items-center gap-4 text-xs">
                                            <div class="flex items-center gap-1.5">
                                                <LucideIconCn Name="calendar" Size="12" Class="size-3 text-muted-foreground" />
                                                <span class="text-muted-foreground">Issued: @inv.IssueDate</span>
                                            </div>
                                            <div class="flex items-center gap-1.5">
                                                <span class="text-muted-foreground">Due: @inv.DueDate</span>
                                            </div>
                                        </div>

                                        <hr class="border-border" />

                                        @* Time Entries *@
                                        <div class="space-y-1.5">
                                            @foreach (var entry in inv.Entries)
                                            {
                                                var ent = entry;
                                                <div class="rounded-md bg-muted/50 px-3 py-2">
                                                    <div class="flex items-start justify-between gap-2">
                                                        <div class="min-w-0 flex-1">
                                                            <p class="text-sm">@ent.Task</p>
                                                            <div class="mt-0.5 flex items-center gap-2 text-muted-foreground text-xs">
                                                                <div class="flex items-center gap-1">
                                                                    <LucideIconCn Name="clock" Size="12" Class="size-3" />
                                                                    <span class="tabular-nums">@ent.Hours hrs</span>
                                                                </div>
                                                                <span>@@</span>
                                                                <span class="tabular-nums">$@ent.Rate/hr</span>
                                                                <span class="ml-auto">@ent.Date</span>
                                                            </div>
                                                        </div>
                                                        <span class="shrink-0 font-medium text-sm tabular-nums">$@((ent.Hours * ent.Rate).ToString("F2"))</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <hr class="border-border" />

                                        @* Totals *@
                                        <div class="space-y-1.5">
                                            <div class="flex items-center justify-between text-sm">
                                                <span class="text-muted-foreground">Subtotal</span>
                                                <span class="font-medium tabular-nums">$@inv.Subtotal.ToString("N0")</span>
                                            </div>
                                            <div class="flex items-center justify-between text-sm">
                                                <span class="text-muted-foreground">Tax (8%)</span>
                                                <span class="font-medium tabular-nums">$@inv.Tax.ToString("N0")</span>
                                            </div>
                                            <hr class="border-border" />
                                            <div class="flex items-center justify-between">
                                                <span class="font-medium text-sm">Total</span>
                                                <div class="flex items-baseline gap-1">
                                                    <LucideIconCn Name="dollar-sign" Size="16" Class="size-4 text-indigo-600" />
                                                    <span class="font-semibold text-2xl tabular-nums">@inv.Total.ToString("N0")</span>
                                                </div>
                                            </div>
                                        </div>

                                        @* Actions *@
                                        <div class="flex gap-2">
                                            <ButtonCn Size="ButtonSize.Sm" Variant="ButtonVariant.Outline" Class="h-7 flex-1 gap-1.5 px-3">
                                                <LucideIconCn Name="copy" Size="14" Class="size-3.5" />
                                                <span class="text-xs">Copy Link</span>
                                            </ButtonCn>
                                            <ButtonCn Size="ButtonSize.Sm" Class="h-7 flex-1 px-3">
                                                <span class="text-xs">Send Invoice</span>
                                            </ButtonCn>
                                        </div>

                                    </div>
                                </div>
                            }

                            @* Time Entries List *@
                            @if (msg.TimeEntries != null && msg.TimeEntries.Length > 0)
                            {
                                <div class="mt-3 space-y-1.5">
                                    @foreach (var entry in msg.TimeEntries)
                                    {
                                        var ent = entry;
                                        <div class="flex items-center justify-between gap-2 rounded-lg border bg-card px-3 py-2">
                                            <div class="min-w-0 flex-1">
                                                <p class="text-sm">@ent.Task</p>
                                                <p class="mt-0.5 text-muted-foreground text-xs">@ent.Date</p>
                                            </div>
                                            <div class="flex items-center gap-2 text-xs">
                                                <span class="text-muted-foreground tabular-nums">@ent.Hours hrs</span>
                                                <span class="font-medium tabular-nums">$@((ent.Hours * ent.Rate).ToString("F2"))</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                        </div>
                    </div>
                }

            </div>
        </div>

        @* Input *@
        <div class="border-t bg-muted/50 p-4">
            <div class="flex gap-2">
                <InputCn
                    @bind-Value="_input"
                    Placeholder="Track time, create invoice, check status..."
                    Class="flex-1"
                    @onkeydown="@HandleKeyDown" aria-label="Track time, create invoice, check status..." />
                <ButtonCn Size="ButtonSize.Icon" Disabled="@(string.IsNullOrWhiteSpace(_input))" OnClick="@HandleSubmit" aria-label="Send">
                    <LucideIconCn Name="send" Size="16" Class="size-4" />
                </ButtonCn>
            </div>
        </div>

    </div>
</section>

@code {
    private string _input = "";

    private record TimeEntry(string Id, string Task, double Hours, double Rate, string Date);

    private record InvoiceDetails(
        string Id,
        string Client,
        string IssueDate,
        string DueDate,
        string Status,
        TimeEntry[] Entries,
        double Subtotal,
        double Tax,
        double Total
    );

    private record Message(
        string Id,
        string Type,
        string Content,
        string Timestamp,
        InvoiceDetails? Invoice = null,
        TimeEntry[]? TimeEntries = null
    );

    private List<Message> _messages =
    [
        new(
            Id: "1",
            Type: "assistant",
            Content: "Welcome to your freelance invoice assistant! I'll help you track time, create invoices, and manage payments. What would you like to do?",
            Timestamp: "9:30 AM"
        ),
        new(
            Id: "2",
            Type: "user",
            Content: "Create an invoice for Acme Corp for this week's work",
            Timestamp: "9:31 AM"
        ),
        new(
            Id: "3",
            Type: "assistant",
            Content: "I've compiled your time entries for Acme Corp this week. Here's your invoice:",
            Timestamp: "9:31 AM",
            Invoice: new InvoiceDetails(
                Id: "INV-2026-0142",
                Client: "Acme Corporation",
                IssueDate: "March 30, 2026",
                DueDate: "April 13, 2026",
                Status: "draft",
                Entries:
                [
                    new("e1", "Frontend development - Dashboard UI",  12.5, 125, "Mar 24-25"),
                    new("e2", "API integration - Payment system",      8.0, 125, "Mar 26"),
                    new("e3", "Code review and optimization",          4.5, 125, "Mar 27"),
                    new("e4", "Client meeting and planning",           2.0, 125, "Mar 28"),
                ],
                Subtotal: 3375,
                Tax: 270,
                Total: 3645
            )
        ),
        new(
            Id: "4",
            Type: "user",
            Content: "Looks good, send it to the client",
            Timestamp: "9:33 AM"
        ),
        new(
            Id: "5",
            Type: "assistant",
            Content: "Invoice INV-2026-0142 has been sent to Acme Corporation. Payment link included. I'll notify you when payment is received.",
            Timestamp: "9:33 AM"
        ),
    ];

    private string GetStatusColor(string status) => status switch
    {
        "paid"    => "bg-emerald-500/10 text-emerald-600",
        "sent"    => "bg-blue-500/10 text-blue-600",
        "overdue" => "bg-red-500/10 text-red-600",
        "draft"   => "bg-muted text-muted-foreground",
        _         => "bg-muted",
    };

    private void HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(_input)) return;
        var newMessage = new Message(
            Id: $"freelancer-invoice-msg-{DateTime.UtcNow.Ticks}",
            Type: "user",
            Content: _input,
            Timestamp: "Just now"
        );
        _messages = [.._messages, newMessage];
        _input = "";
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") HandleSubmit();
    }
}
